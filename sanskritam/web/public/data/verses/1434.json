[{"id": 2020710, "chapter_id": 1434, "verse_number": "३-७२-०x", "content_sanskrit": "दमयन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020711, "chapter_id": 1434, "verse_number": "३-७२-१", "content_sanskrit": "गच्छ केशिनि जानीहि क एष रथवाहकः।\nउपविष्टो रथोपस्थे विकृतो ह्रस्वबाहुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020712, "chapter_id": 1434, "verse_number": "३-७२-२", "content_sanskrit": "अभ्येत्य कुशलं भद्रे मृदुपूर्वंसमाहिता।\nपृच्छेथाः पुरुषे ह्येनं यथातत्त्वमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020713, "chapter_id": 1434, "verse_number": "३-७२-३", "content_sanskrit": "अत्र मे महती शङ्का भवेदेष नलो नृपः।\nयथाच मनसस्तुष्टिर्हृदयस्य च निर्वृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020714, "chapter_id": 1434, "verse_number": "३-७२-४", "content_sanskrit": "ब्रूयाश्चैनं कथान्ते त्वं पर्णादवचनं यथा।\nप्रतिवाक्यं च सुश्रोणि बुद्ध्येथास्त्वमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020715, "chapter_id": 1434, "verse_number": "३-७२-५", "content_sanskrit": "एवं समाहिता गत्वा दूती बाहुकमब्रवीत्।\nदमयन्त्यपि कल्याणी प्रासादस्थाऽनव्वैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020716, "chapter_id": 1434, "verse_number": "३-७२-६x", "content_sanskrit": "केशिन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020717, "chapter_id": 1434, "verse_number": "३-७२-६", "content_sanskrit": "स्वागतं ते मनुष्येन्द्र कुशलं ते ब्रवीम्यहम्।\nदमयन्त्या वचः साधु निबोध पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020718, "chapter_id": 1434, "verse_number": "३-७२-७", "content_sanskrit": "कदा वै प्रस्थिता यूयं किमर्थमिह चागताः।\nतत्त्वं ब्रूहि यथान्यायं वैदर्भी श्रोतुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020719, "chapter_id": 1434, "verse_number": "३-७२-८x", "content_sanskrit": "बाहुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020720, "chapter_id": 1434, "verse_number": "३-७२-८", "content_sanskrit": "श्रुतः स्वयंवरो राज्ञा कोसलेन महात्मना।\nद्वितीयो दमयन्त्या वै भविता श्व इति द्विजात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020721, "chapter_id": 1434, "verse_number": "३-७२-९", "content_sanskrit": "श्रुत्वैतत्प्रस्थितो राजा शतयोजनयायिभिः।\nहयैर्वातजवैर्मुख्यैरहमस्य च सारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020722, "chapter_id": 1434, "verse_number": "३-७२-१०x", "content_sanskrit": "केशिन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020723, "chapter_id": 1434, "verse_number": "३-७२-१०", "content_sanskrit": "अथ योसौ तृतीयो वः स कुतः कस्य वा पुनः।\nत्वं च कस्य कथं चेदंत्वयि कर्म समाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020724, "chapter_id": 1434, "verse_number": "३-७२-११x", "content_sanskrit": "बाहुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020725, "chapter_id": 1434, "verse_number": "३-७२-११", "content_sanskrit": "पुण्यश्लोकस्य वै सूतो वार्ष्णेय इति विश्रतः।\nस नले विद्रुते भद्रेभागस्वरिमुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020726, "chapter_id": 1434, "verse_number": "३-७२-१२", "content_sanskrit": "अहमप्यश्वकुशलः सूतत्वे च प्रतिष्ठितः।\nऋतुपर्णेन सारथ्ये भोजने च वृतः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020727, "chapter_id": 1434, "verse_number": "३-७२-१३x", "content_sanskrit": "केशिन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020728, "chapter_id": 1434, "verse_number": "३-७२-१३", "content_sanskrit": "अथ जानाति वार्ष्णेयः क्वनु राजा नलो गतः।\nकथं च त्वयि वा तेन कथितं स्यात्तु बाहुक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020729, "chapter_id": 1434, "verse_number": "३-७२-१४x", "content_sanskrit": "बाहुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020730, "chapter_id": 1434, "verse_number": "३-७२-१४", "content_sanskrit": "इहैव पुत्रौ निक्षिप्य नलस्य प्रियदर्शनौ।\nगतस्ततो यथाकामं नैष जानाति नैषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020731, "chapter_id": 1434, "verse_number": "३-७२-१५", "content_sanskrit": "न चान्यः पुरुषः कश्चिन्नलं वेत्ति यशस्विनि।\nगूढश्चरति लोकेऽस्मिन्नष्टरूपो महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020732, "chapter_id": 1434, "verse_number": "३-७२-१६", "content_sanskrit": "आत्मैव तु नलं वेद या चास्य तदनन्तरा।\nन हि वै स्वानि लिङ्गानि नलं शंसन्ति कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020733, "chapter_id": 1434, "verse_number": "३-७२-१७x", "content_sanskrit": "केशिन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020734, "chapter_id": 1434, "verse_number": "३-७२-१७", "content_sanskrit": "योसावयोध्यां प्रथमं गतोसौ ब्राह्मणस्तदा।\nइमानि नारीवाक्यानि कथयानः पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020735, "chapter_id": 1434, "verse_number": "३-७२-१८", "content_sanskrit": "क्वनु त्वं कितव च्छित्त्वा वस्त्रार्धं प्रस्थितो मम।\nउत्सृज्य विपिने सुप्तामनुरक्तां प्रियां प्रिय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020736, "chapter_id": 1434, "verse_number": "३-७२-१९", "content_sanskrit": "सा वै यथा समादिष्टा तथाऽऽस्ते त्वत्प्रतीक्षिणी।\nदह्यमाना दिवारात्रौ वस्त्रार्धेनाभिसंवृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020737, "chapter_id": 1434, "verse_number": "३-७२-२०", "content_sanskrit": "तस्या रुदनत्याः सततं तेन दुःखेन पार्थिव।\nप्रसादं कुरु मे वीर प्रतिवाक्यं वदस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020738, "chapter_id": 1434, "verse_number": "३-७२-२१", "content_sanskrit": "तस्यास्तत्प्रियमाख्यानं प्रवदस्व महामते।\nतदेव वाक्यं वैदर्भी श्रोतुमिच्छन्त्यनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020739, "chapter_id": 1434, "verse_number": "३-७२-२२", "content_sanskrit": "एतच्छ्रुत्वा प्रतिवचस्तस्य दत्तं त्वया किल।\nयत्पुरा तत्पुनस्त्वत्तो वैदर्भी श्रोतुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020740, "chapter_id": 1434, "verse_number": "३-७२-२३x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020741, "chapter_id": 1434, "verse_number": "३-७२-२३", "content_sanskrit": "एवमुक्तस्य केशिन्या नलस्य कुरुनन्दन।\nहृदयं व्यथितं चासीदश्रुपूर्णे च लोचने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020742, "chapter_id": 1434, "verse_number": "३-७२-२४", "content_sanskrit": "स निग्राह्यात्मनो दुःखं दह्यमानो महीपतिः।\nबाष्पसंदिग्धया वाचा पुनरेवेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020743, "chapter_id": 1434, "verse_number": "३-७२-२५", "content_sanskrit": "वैषम्यमपि संप्राप्ता गोपायन्ति कुलस्त्रियः।\nआत्मानमात्मना सत्यो जितः स्वर्गो न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020744, "chapter_id": 1434, "verse_number": "३-७२-२६", "content_sanskrit": "रहिता भर्तृभिश्चापि न क्रुध्यन्ति कदाचन।\nप्राणांश्चारित्रकवचान्धारयन्ति वरस्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020745, "chapter_id": 1434, "verse_number": "३-७२-२७", "content_sanskrit": "विषमस्थेन मूढेन परिभ्रष्टसुखेन च।\nयत्सा तेन परित्यक्ता तत्रन क्रोद्धुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020746, "chapter_id": 1434, "verse_number": "३-७२-२८", "content_sanskrit": "प्राणयात्रां परिप्रेप्सोः शकुनैर्हतवाससः।\nआधिभिर्दह्यमानस्य श्यामा न क्रोद्धुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020747, "chapter_id": 1434, "verse_number": "३-७२-२९", "content_sanskrit": "सत्कृताऽसत्कृता वाऽपि पतिं दृष्ट्वा तथाविधम्।\nराज्यभ्रष्टं श्रिया हीनं क्षिधितं व्यसनाप्लुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020748, "chapter_id": 1434, "verse_number": "३-७२-३०", "content_sanskrit": "एवं ब्रुवाणस्तद्वाक्यं नलः परमदुर्मनाः।\nन बाष्पमशकत्सोढुं प्ररुरोद च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020749, "chapter_id": 1434, "verse_number": "३-७२-३१", "content_sanskrit": "ततः सा केशिनी गत्वा दमयन्त्यै न्यवेदयत्।\nतत्सर्वं कथितं चैव विकारं तस्य चैव तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020750, "chapter_id": 1434, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि द्विसप्ततितमोऽध्यायः ॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]