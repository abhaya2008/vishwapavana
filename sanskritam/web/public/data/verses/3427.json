[{"id": 2112554, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112555, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "एवमुक्त्वा तदा भीष्मं तन्माता प्रत्यभाषत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112556, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "सत्यवती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112557, "chapter_id": 3427, "verse_number": "१", "content_sanskrit": "रोचते मे वचस्तुभ्यं ममापि वचनं शृणु \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112558, "chapter_id": 3427, "verse_number": "२", "content_sanskrit": "विश्वासात् ते प्रवक्ष्यामि सन्तानाय कुरुष्व नः ।\nन च शक्यमनाख्यातुमापद्धीयं तथाविधा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112559, "chapter_id": 3427, "verse_number": "३", "content_sanskrit": "त्वमेव नः कुले धर्मस्त्वं सत्यं त्वं परा गतिः ।\nयत् त्वं वक्ष्यसि तत् कार्यमस्माभिरिति मे मतिः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112560, "chapter_id": 3427, "verse_number": "४", "content_sanskrit": "तस्मान्निशम्य वाक्यं मे कुरुष्व यदनन्तरम् ।\nशृणु भीष्म वचो मह्यं धर्मार्थसहितं हितम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112561, "chapter_id": 3427, "verse_number": "५", "content_sanskrit": "न च विस्रम्भकथितं भवान् सूचितुमर्हति ।\nयस्तु राजा वसुर्नाम श्रुतस्ते भरतर्षभ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112562, "chapter_id": 3427, "verse_number": "६", "content_sanskrit": "तस्य शुक्लादहं मत्स्या धृता कुक्षौ पुरा किल ।\nभ्रातरं मे जलाद् हृत्वा दाशः परमधर्मवित् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112563, "chapter_id": 3427, "verse_number": "७", "content_sanskrit": "मां तु स्वगृहमानीय दुहितृत्वे ह्यकल्पयत् ।\nधर्मयुक्तः स धर्मेण पिता चासीत् ततो मम \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112564, "chapter_id": 3427, "verse_number": "८", "content_sanskrit": "सा कदाचिदहं तत्र गताऽस्मि यमुनातटम् ।\nअथ धर्मभृतां श्रेष्ठः परमर्षिः पराशरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112565, "chapter_id": 3427, "verse_number": "९", "content_sanskrit": "आजगाम तरीं तात तरिष्यन् यमुनां नदीम् ।\nस तार्यमाणो यमुनां मामुपेत्याब्रवीन्मुनिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112566, "chapter_id": 3427, "verse_number": "१०", "content_sanskrit": "सान्त्वपूर्वं महाभागः कामार्तो मधुरं वचः ।\nउक्त्वा जन्म कुले मह्यं नासि दाशसुता इति \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112567, "chapter_id": 3427, "verse_number": "११", "content_sanskrit": "तमहं शापभीता च पितुर्भीता च भारत ।\nवरैरसुलभैश्चाहं प्रत्याख्यातुं प्रचक्रमे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112568, "chapter_id": 3427, "verse_number": "१२", "content_sanskrit": "प्रेक्ष्य तांस्तु महाभागान् परे पारे ऋषीन् स्थितान् ।\nयमुनातीरविन्यस्तान् प्रदीप्तानिव पावकान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112569, "chapter_id": 3427, "verse_number": "१३", "content_sanskrit": "पुरस्तादरुणश्चैव तरुणः सम्प्रकाशते ।\nयेनैषा ताम्रवस्त्रेव द्यौः कृता प्रतिजृम्भिता \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112570, "chapter_id": 3427, "verse_number": "१४", "content_sanskrit": "उक्तमात्रे मया तत्र नीहारमसृजत् प्रभुः ।\nपराशरः सत्यधृतिर्द्वीपं च यमुनाम्भसि \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112571, "chapter_id": 3427, "verse_number": "१५", "content_sanskrit": "अभिभूय स मां बालां तेजसा वशमानयत् ।\nतमसा लोकमावृत्य नौगतामेव भारत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112572, "chapter_id": 3427, "verse_number": "१६", "content_sanskrit": "मत्स्यगन्धो महानासीत् पुरा मम जुगुप्सितः ।\nतमपास्य शुभं गन्धमिमं प्रादात्स मे मुनिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112573, "chapter_id": 3427, "verse_number": "१७", "content_sanskrit": "कन्यात्वं च ददौ प्रीतः पुनः विद्वांस्तपोधनः ।\nततः पिता वसुश्चैव पितरश्च तपोधनाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112574, "chapter_id": 3427, "verse_number": "१८", "content_sanskrit": "वसिष्ठेन समानीता याज्ञवल्क्यादयो द्विजाः ।\nकृत्वा विवाहं मे सर्वे प्रतिजग्मुर्यथागतम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112575, "chapter_id": 3427, "verse_number": "१९", "content_sanskrit": "तस्य वीर्यमहं दृष्ट्वा तथायुक्तं महात्मनः ।\nविस्मिता व्यथिता चैव प्रादामात्मानमेव च \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112576, "chapter_id": 3427, "verse_number": "२०", "content_sanskrit": "ततस्तदा महात्मा स कन्यायां मयि भारत ।\nप्रहृष्टोऽजनयत् पुत्रं द्वीप एव पराशरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112577, "chapter_id": 3427, "verse_number": "२१", "content_sanskrit": "ततो मामाह स मुनिर्गर्भ उत्सृज्यतामयम् ।\nद्वीपेऽस्या एव सरितः कन्यैव त्वं भविष्यसि \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112578, "chapter_id": 3427, "verse_number": "२२", "content_sanskrit": "पाराशर्यो महायोगी स बभूव महायशाः ।\nसद्योत्पन्नः स ह महान् स तु पित्रायतो गतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112579, "chapter_id": 3427, "verse_number": "२३", "content_sanskrit": "कन्यापुत्रो मम पुरा द्वैपायन इति स्मृतः ।\nयो व्यस्य वेदांश्चतुरः तपसा भगवानृषिः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112580, "chapter_id": 3427, "verse_number": "२४", "content_sanskrit": "लोके व्यासत्वमापेदे कार्ष्ण्यात् कृष्णत्वमागतः ।\nसत्यवादी शमपरस्तपसा दग्धकिल्बिषः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112581, "chapter_id": 3427, "verse_number": "२५", "content_sanskrit": "स नियुक्तो मया व्यक्तं त्वया चाप्यमितद्युते ।\nभ्रातुः क्षेत्रे तु कल्याणमपत्यं जनयिष्यति \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112582, "chapter_id": 3427, "verse_number": "२६", "content_sanskrit": "स हि मामुक्त्वांस्तत्र स्मर कार्येषु मामिति ।\nस्मरिष्यामि महाबाहो यदि भीष्म त्वमिच्छसि \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112583, "chapter_id": 3427, "verse_number": "२७", "content_sanskrit": "तव ह्यनुमते भीष्म नियतं स महातपाः ।\nविचित्रवीर्यक्षेत्रे तु पुत्रानुत्पादयिष्यति \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112584, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112585, "chapter_id": 3427, "verse_number": "२८", "content_sanskrit": "इत्युक्तमात्रे भीष्मस्तु कृताञ्जलिपुटोऽहृषत् ।\nमहर्षेः कीर्तनात् तस्य वन्द्य मातुस्तदाऽब्रवीत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112586, "chapter_id": 3427, "verse_number": "२९", "content_sanskrit": "देशकालौ च जानासि क्रियतामर्थसिद्धये ।\nधर्ममर्थं च कामं च त्रीनेतान् योऽनुपश्यति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112587, "chapter_id": 3427, "verse_number": "३०", "content_sanskrit": "अर्थमर्थानुबन्धं च धर्मं धर्मानुबन्धनम् ।\nकामं कामानुबन्धं च विपरीतान् पृथक्पृथक्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112588, "chapter_id": 3427, "verse_number": "३१", "content_sanskrit": "शुभं शुभानुबन्धं च तांश्चैव त्रिविधान् पुनः ।\nयो विचिन्त्य धिया सम्यग् व्यवस्यति स बुद्धिमान्\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112589, "chapter_id": 3427, "verse_number": "३२", "content_sanskrit": "सर्ववित् सर्वकर्ता स यद्येवं तत् करोति च ।\nतदिदं धर्मयुक्तं च हितं चैव कुलस्य नः ।\nउक्तं भवत्या यच्छ्रेयः परमं रोचते मम\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112590, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112591, "chapter_id": 3427, "verse_number": "३३", "content_sanskrit": "ततस्तस्मिन् प्रतिज्ञाते भीष्मेण कुरुनन्दन ।\nचिन्तयामास वै काळी कृष्णद्वैपायनं मुनिम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112592, "chapter_id": 3427, "verse_number": "३४", "content_sanskrit": "तस्याः सं चिन्तितं ज्ञात्वा सत्यवत्या महातपाः ।\nस वेदान् प्रब्रुवन् धीमान् कृष्णद्वैपायनः प्रभुः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112593, "chapter_id": 3427, "verse_number": "३५", "content_sanskrit": "प्रादुर्बभूव विदितः क्षणेन कुरुसंसदि ।\nतस्मै पूजां ततो दत्वा सुताय विधिपूर्वकम् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112594, "chapter_id": 3427, "verse_number": "३६", "content_sanskrit": "परिष्वज्य च बाहुभ्यां प्रस्रवैरभिषिच्य च ।\nमुमोच बाष्पं दाशेयी पुत्रं दृष्ट्वा चिरस्य तम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112595, "chapter_id": 3427, "verse_number": "३७", "content_sanskrit": "तामद्भिरभिषिञ्च्यार्तां महर्षिरभिवाद्य च ।\nमातरं पूर्वजः पुत्रः व्यासो वचनमब्रवीत् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112596, "chapter_id": 3427, "verse_number": "३८", "content_sanskrit": "भवत्या यदभिप्रेतं तदहं कर्तुमागतः ।\nशाधि मां धर्मतत्वज्ञे करवाणि प्रियं तव \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112597, "chapter_id": 3427, "verse_number": "३९", "content_sanskrit": "तस्मै पूजां ततोऽकार्षीत् पुरोधाः परमर्षये ।\nस च तां प्रतिजग्राह विधिवन्मन्त्रपूर्वकम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112598, "chapter_id": 3427, "verse_number": "४०", "content_sanskrit": "पूजितं मन्त्रपूर्वेण विधिना प्रीतमानसम् ।\nतमाश्रमगतं माता पृष्ट्वा कुशलमव्ययम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112599, "chapter_id": 3427, "verse_number": "४१", "content_sanskrit": "सत्यवत्यभिवीक्ष्यैनमुवाचेदमनन्तरम् ।\nमातापित्रोः प्रजायन्ते पुत्राः साधारणाः कुले \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112600, "chapter_id": 3427, "verse_number": "४२", "content_sanskrit": "तेषां पिता यथा स्वामी तथा माता यशस्विनी ।\nविधात्रा विहितः स त्वं यथा मे प्रथमः सुतः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112601, "chapter_id": 3427, "verse_number": "४३", "content_sanskrit": "विचित्रवीर्यो ब्रह्मर्षे तथा मेऽवरजः सुतः ।\nयथैव पितृतो भीष्मः तथा त्वमपि मातृतः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112602, "chapter_id": 3427, "verse_number": "४४", "content_sanskrit": "भ्राता विचित्रवीर्यस्य यथा वा पुत्र मन्यसे ।\nअयं शान्तनवः सत्यं पालयन् सत्यविक्रमः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112603, "chapter_id": 3427, "verse_number": "४५", "content_sanskrit": "बुद्धि न कुरुतेऽपत्ये तथा राज्यानुशासने ।\nस त्वं ह्मपेक्षया भ्रातुः सन्तानाय कुलस्य तु \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112604, "chapter_id": 3427, "verse_number": "४६", "content_sanskrit": "भीष्मस्य चास्य वचनान्नियोगाच्च ममानघ ।\nअनुक्रोशाच्च भ्रातॄणां सर्वेषां रक्षणाय च \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112605, "chapter_id": 3427, "verse_number": "४७", "content_sanskrit": "आनृशंस्येन यद् ब्रूयां तच्छ्रुत्वा कर्तुमर्हसि ।\nयवीयसस्तव भ्रातुर्भार्ये परमसम्मते \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2112606, "chapter_id": 3427, "verse_number": "४८", "content_sanskrit": "रूपयौवनसम्पन्ने पुत्रकामे च धर्मतः ।\nतयोः प्रयच्छ पुत्रांस्त्वं समर्थो ह्यसि पुत्रक ।\nअनुरूपान् कुलस्यास्य तेजःप्रशमसंयुतान् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2112607, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2112608, "chapter_id": 3427, "verse_number": "४९", "content_sanskrit": "वेत्थ धर्मं त्वमेवेह परं चापरमेव च ।\nतथा तव महाप्राज्ञे धर्मे प्रणिहिता मतिः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2112609, "chapter_id": 3427, "verse_number": "५०", "content_sanskrit": "नियोगात् तव चैवाहमेतैरपि च कारणैः ।\nईप्सितं ते करिष्यामि दृष्टं ह्येतत् पुरा मया \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2112610, "chapter_id": 3427, "verse_number": "५१", "content_sanskrit": "भवत्या यदभिप्रेतं तदहं कर्तुमागतः ।\nभ्रातुः पुत्रान् प्रदास्यामि मित्रावरुणयोः समान्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2112611, "chapter_id": 3427, "verse_number": "५२", "content_sanskrit": "व्रतं च चरितव्यं तु निर्दिष्टमिह यन्मया ।\nसंवत्सरं यथान्यायं ततः शुद्धे भविष्यतः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2112612, "chapter_id": 3427, "verse_number": "५३", "content_sanskrit": "नहि मामव्रतोपेता स्पृशते काचिदङ्गना ।\nन च मामर्हतः प्राप्तुमशुद्धे कोसलात्मजे ।\nएवं सत्यवती धर्मं परमाज्ञातुमर्हसि \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2112613, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "सत्यवती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2112614, "chapter_id": 3427, "verse_number": "५४", "content_sanskrit": "यथा सद्यः प्रपद्येतां देव्यौ गर्भं तथा कुरु ।\nअराजकेषु राष्ट्रेषु प्रजाऽनाथा विनश्यति\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2112615, "chapter_id": 3427, "verse_number": "५५", "content_sanskrit": "कथं चाराजकं राज्यं शक्यं धारयितुं प्रभो ।\nतस्माद् गर्भं निषिञ्चस्व भीष्मस्तं वर्धयिष्यति \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2112616, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2112617, "chapter_id": 3427, "verse_number": "५६", "content_sanskrit": "यदि पुत्रः प्रदातव्यो मया क्षिप्रमकालिकम् ।\nविरूपतां मे सहतामेतत् स्यात् परमं व्रतम् \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2112618, "chapter_id": 3427, "verse_number": "५७", "content_sanskrit": "यदि मे सहते वेषं रूपं गन्धं तथा वपुः ।\nअद्यैव गर्भं कौसल्या विशिष्टं प्रतिपत्स्यते \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2112619, "chapter_id": 3427, "verse_number": "५८", "content_sanskrit": "तस्य चापि शतं पुत्रा भवितारो न संशयः ।\nगोप्तारः कुरुवंशस्य भवत्याः शोकनाशनाः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2112620, "chapter_id": 3427, "verse_number": "५९", "content_sanskrit": "शयने त्वेव कौसल्या शुचिवस्त्रा स्वलङ्कृता ।\nममागमनमाकाङ्क्षेदित्युक्त्वाऽन्तरधीयत \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2112621, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2112622, "chapter_id": 3427, "verse_number": "६०", "content_sanskrit": "अभिगम्य तु सा देवी स्नुषां रहसि सङ्गता ।\nधर्ममर्थसमायुक्तमुवाच वचनं हितम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2112623, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "सत्यवती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2112624, "chapter_id": 3427, "verse_number": "६१", "content_sanskrit": "कौसल्ये धर्मतन्त्रं यद् ब्रवीमि त्वां निबोध मे ।\nभरतानां समुच्छेदो व्यक्तं मद्भाग्यसङ्क्षयात् \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2112625, "chapter_id": 3427, "verse_number": "६२", "content_sanskrit": "व्यथितां मां च सम्प्रेक्ष्य पितुर्वंशं च पीडितम् ।\nभीष्मो बुद्धिमतां श्रेष्ठो कुरुते बुद्धिमुत्तमाम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2112626, "chapter_id": 3427, "verse_number": "६३", "content_sanskrit": "सा च बुद्धिस्त्वय्यधीना पुत्रं प्राप्तुं मतिं कुरु ।\nनष्टं च भारतं वंशं पुनरेव समुद्धर \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2112627, "chapter_id": 3427, "verse_number": "६४", "content_sanskrit": "पुत्रं जनय कल्याणि देवराजसमद्युतिम् ।\nगर्भं धारय कल्याणि देवराजसमप्रभम् ।\nस ते पुत्रो धुरं गुर्वीं धारयिष्यति भारतीम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2112628, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2112629, "chapter_id": 3427, "verse_number": "६५", "content_sanskrit": "सा धर्मतोऽनुनीयैनां कथञ्चिद् धर्मचारिणीम् ।\nभोजयामास विप्रांश्च देवर्षीनतिथींस्तथा \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2112630, "chapter_id": 3427, "verse_number": "१०६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषडधिकशततमोऽध्यायः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2112631, "chapter_id": 3427, "verse_number": "५४", "content_sanskrit": "॥ इति सम्भवपर्वणि चतुःपञ्चाशोऽध्यायः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2112632, "chapter_id": 3427, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]