[{"id": 2010112, "chapter_id": 1202, "verse_number": "१-२०३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010113, "chapter_id": 1202, "verse_number": "१-२०३-१", "content_sanskrit": "यदा निवृत्ता राजानो धनुषः सज्यकर्मणः।\nअथोदतिष्ठद्विप्राणां मध्याज्जिष्णुरुदारधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010114, "chapter_id": 1202, "verse_number": "१-२०३-२", "content_sanskrit": "उदक्रोशन्विप्रमुख्या विधुन्वन्तोऽजिनानि च।\nदृष्ट्वा संप्रस्थितं पार्थमिन्द्रकेतुसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010115, "chapter_id": 1202, "verse_number": "१-२०३-३", "content_sanskrit": "केचिदासन्विमनसः केचिदासन्मुदान्विताः।\nआहुः परस्परं केचिन्निपुणा बुद्धिजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010116, "chapter_id": 1202, "verse_number": "१-२०३-४", "content_sanskrit": "यत्कर्णशल्यप्रमुखैः क्षत्रियैर्लोकविश्रुतैः।\nनानतं बलवद्भिर्हि धनुर्वेदपरायणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010117, "chapter_id": 1202, "verse_number": "१-२०३-५", "content_sanskrit": "तत्कथं त्वकृतास्त्रेण प्राणतो दुर्बलीयसा।\nवटुमात्रेण शक्यं हि सज्यं कर्तुं धनुर्द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010118, "chapter_id": 1202, "verse_number": "१-२०३-६", "content_sanskrit": "अवहास्या भविष्यन्ति ब्राह्मणाः सर्वराजसु।\nकर्मण्यस्मिन्नसंसिद्धे चापलादपरीक्षिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010119, "chapter_id": 1202, "verse_number": "१-२०३-७", "content_sanskrit": "यद्येष दर्पाद्धर्षाद्वाप्यथ ब्राह्मणचापलात्।\nप्रस्थितो धनुरायन्तुं वार्यतां साधु मा गमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010120, "chapter_id": 1202, "verse_number": "१-२०३-८", "content_sanskrit": "नावहास्या भविष्यामो न च लाघवमास्थिताः।\nन च विद्विष्टतां लोके गमिष्यामो महीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010121, "chapter_id": 1202, "verse_number": "१-२०३-९", "content_sanskrit": "केचिदाहुर्युवा श्रीमान्नागराजकरोपमः।\nपीनस्कन्धोरुबाहुश्च धैर्येण हिमवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010122, "chapter_id": 1202, "verse_number": "१-२०३-१०", "content_sanskrit": "सिंहखेलगतिः श्रीमान्मत्तनागेन्द्रविक्रमः।\nसंभाव्यमस्मिन्कर्मेदमुत्साहाच्चानुमीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010123, "chapter_id": 1202, "verse_number": "१-२०३-११", "content_sanskrit": "शक्तिरस्य महोत्साहा न ह्यशक्तः स्वयं व्रजेत्।\nन च तद्विद्यते किंचित्कर्म लोकेषु यद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010124, "chapter_id": 1202, "verse_number": "१-२०३-१२", "content_sanskrit": "ब्राह्मणानामसाध्यं च नृषु संस्थानचारिषु।\nअब्भक्षा वायुभक्षाश्च फलाहारा दृढव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010125, "chapter_id": 1202, "verse_number": "१-२०३-१३", "content_sanskrit": "दुर्बला अपि विप्रा हि बलीयांसः स्वेतजसा।\nब्राह्मणो नावमन्तव्यः सदसद्वा समाचरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010126, "chapter_id": 1202, "verse_number": "१-२०३-१४", "content_sanskrit": "सुखं दुःखं महद्ध्रस्वं कर्म यत्समुपागतम्।\nजामदग्न्येन रामेण निर्जिताः क्षत्रिया युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010127, "chapter_id": 1202, "verse_number": "१-२०३-१५", "content_sanskrit": "पीतः समुद्रोऽगस्त्येन अगाधो ब्रह्मतेजसा।\nतस्माद्ब्रुवन्तु सर्वेऽत्र वटुरेष धनुर्महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010128, "chapter_id": 1202, "verse_number": "१-२०३-१६", "content_sanskrit": "आरोपयतु शीघ्रं वै तथेत्यूचुर्द्विजर्षभाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010129, "chapter_id": 1202, "verse_number": "१-२०३-१६x", "content_sanskrit": "वैशम्पायन उवाच।\nएवं तेषां विलपतां विप्राणां विविधा गिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010130, "chapter_id": 1202, "verse_number": "१-२०३-१७", "content_sanskrit": "अर्जुनो धनुषोऽभ्याशे तस्थौ गिरिरिवाचलः।\nअर्जुनः पाण्डवश्रेष्ठो धृष्टद्युम्नमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010131, "chapter_id": 1202, "verse_number": "१-२०३-१८", "content_sanskrit": "एतद्धनुर्ब्राह्मणानां सज्यं कर्तुमलं तु किम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010132, "chapter_id": 1202, "verse_number": "१-२०३-१८x", "content_sanskrit": "वैशम्पायन उवाच।\nतस्य तद्वचनं श्रुत्वा धृष्टद्युम्नोऽब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010133, "chapter_id": 1202, "verse_number": "१-२०३-१९", "content_sanskrit": "ब्राह्मणो वाथ राजन्यो वैश्यो वा शूद्र एव वा।\nएतेषां यो धनुःश्रेष्ठं सज्यं कुर्याद्द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010134, "chapter_id": 1202, "verse_number": "१-२०३-२०", "content_sanskrit": "तस्मै प्रदेया भगिनी सत्यमुक्तं मया वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010135, "chapter_id": 1202, "verse_number": "१-२०३-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010136, "chapter_id": 1202, "verse_number": "१-२०३-२१", "content_sanskrit": "ततः पश्चान्महातेजाः पाण्डवो रणदुर्जयः।\nस तद्धनुः परिक्रम्य प्रदक्षिणमथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010137, "chapter_id": 1202, "verse_number": "१-२०३-२२", "content_sanskrit": "प्रणम्य शिरसा देवमीनं वरदं प्रभुम्।\nकृष्णं च मनसा कृत्वा जगृहे चार्जुनो धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010138, "chapter_id": 1202, "verse_number": "१-२०३-२३", "content_sanskrit": "यत्पार्थिवै रुक्मसुनीथवक्रै\nराधेयदुर्योधनशल्यसाल्वैः।\nतदा धनुर्वेदपरैर्नृसिंहैः\nकृतं न सज्यं महतोऽपि यत्नात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010139, "chapter_id": 1202, "verse_number": "१-२०३-२४", "content_sanskrit": "तदर्जुनो वीर्यवतां सदर्प-\nस्तदैन्द्रिरिन्द्रावरजप्रभावः।\nसज्यं च चक्रे निमिषान्तरेण\nशरांश्च जग्राह दशार्दसङ्ख्यान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010140, "chapter_id": 1202, "verse_number": "१-२०३-२५", "content_sanskrit": "विव्याध लक्ष्यं निपपात तच्च\nछिद्रेण भूमौ सहसातिविद्धम्।\nततोऽन्तरिक्षे च बभूव नादः\nसमाजमध्ये च महान्निनादः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010141, "chapter_id": 1202, "verse_number": "१-२०३-२६", "content_sanskrit": "पुष्पाणि दिव्यानि ववर्ष देवः\nपार्थस्य मूर्ध्नि द्विषतां निहन्तुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010142, "chapter_id": 1202, "verse_number": "१-२०३-२७", "content_sanskrit": "चेलानि विव्यधुस्तत्र ब्राह्मणाश्च सहस्रशः।\nविलक्षितास्ततश्चक्रुर्हाहाकारांश्च सर्वशः।\nन्यपतंश्चात्र नभसः समन्तात्पुष्पवृष्टयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010143, "chapter_id": 1202, "verse_number": "१-२०३-२८", "content_sanskrit": "शताङ्गानि च तूर्याणि वादकाः समवादयन्।\nसूतमागधसङ्घाश्चाप्यस्तुवंस्तत्र सुस्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010144, "chapter_id": 1202, "verse_number": "१-२०३-२९", "content_sanskrit": "तं दृष्ट्वा द्रुपदः प्रीतो बभूव रिपुसूदनः।\nसह सैन्यैश्च पार्थस्य साहाय्यार्थमियेष सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2010145, "chapter_id": 1202, "verse_number": "१-२०३-३०", "content_sanskrit": "तस्मिंस्तु शब्दे महति प्रवृद्धे\nयुधिष्ठिरो धर्मभृतां वरिष्ठः।\nआवासमेवोपजगाम शीघ्रं\nसार्धं यमाभ्यां पुरुषोत्तमाभ्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2010146, "chapter_id": 1202, "verse_number": "१-२०३-३१", "content_sanskrit": "विद्धं तु लक्ष्यं प्रसमीक्ष्य कृष्णा\nपार्थं च शक्रप्रतिमं निरीक्ष्य।\nस्वभ्यस्तरूपापि नवेव नित्यं\nविनापि हासं हसतीव कन्या॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2010147, "chapter_id": 1202, "verse_number": "१-२०३-३२", "content_sanskrit": "मदादृतेऽपि स्खलतीव भावै-\nर्वाचा विना व्याहरतीव दृष्ट्या।\nआदाय शुक्लं वरमाल्यदाम\nजगाम कुन्तीसुतमुत्स्मयन्ती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2010148, "chapter_id": 1202, "verse_number": "१-२०३-३३", "content_sanskrit": "गत्वा च पश्चात्प्रसमीक्ष्य कृष्णा\nपार्थस्य वक्षस्यविशङ्कमाना।\nक्षिप्त्वा स्रजं पार्थिववीरमध्ये\nवराय वव्रे द्विजसङ्घमध्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2010149, "chapter_id": 1202, "verse_number": "१-२०३-३४", "content_sanskrit": "शचीव देवेन्द्रमथाग्निदेवं\nस्वाहेव लक्ष्मीश्च यथा मुकुन्दम्।\nउषेव सूर्यं मदनं रतीव\nमहेश्वरं पर्वतराजपुत्री॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2010150, "chapter_id": 1202, "verse_number": "१-२०३-३५", "content_sanskrit": "स तामुपादाय विजित्य रङ्गे\nद्विजातिभिस्तैरभिपूज्यमानः।\nरङ्गान्निरक्रामदचिन्त्यकर्मा\nपत्न्या तया चाप्यनुगम्यमानः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2010151, "chapter_id": 1202, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि स्वयंवरपर्वणि त्र्यधिकद्विशततमोऽध्यायः॥ २०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]