[{"id": 5000327000, "chapter_id": 9327, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000327001, "chapter_id": 9327, "verse_number": "४-५५-१", "content_sanskrit": "श्रुत्वा हनुमतो वाक्यं प्रश्रितं धर्मसंहितम्।\nस्वामिसत्कारसंयुक्तमङ्गदो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000327002, "chapter_id": 9327, "verse_number": "४-५५-२", "content_sanskrit": "स्थैर्यमात्ममनःशौचमानृशंस्यमथार्जवम्।\nविक्रमश्चैव धैर्यं च सुग्रीवे नोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000327003, "chapter_id": 9327, "verse_number": "४-५५-३", "content_sanskrit": "भ्रातुर्ज्येष्ठस्य यो भार्यां जीवतो महिषीं प्रियाम्।\nधर्मेण मातरं यस्तु स्वीकरोति जुगुप्सितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000327004, "chapter_id": 9327, "verse_number": "४-५५-४", "content_sanskrit": "कथं स धर्मं जानीते येन भ्रात्रा दुरात्मना।\nयुद्धायाभिनियुक्तेन बिलस्य पिहितं मुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000327005, "chapter_id": 9327, "verse_number": "४-५५-५", "content_sanskrit": "सत्यात् पाणिगृहीतश्च कृतकर्मा महायशाः।\nविस्मृतो राघवो येन स कस्य सुकृतं स्मरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000327006, "chapter_id": 9327, "verse_number": "४-५५-६", "content_sanskrit": "लक्ष्मणस्य भयेनेह नाधर्मभयभीरुणा।\nआदिष्टा मार्गितुं सीता धर्मस्तस्मिन् कथं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000327007, "chapter_id": 9327, "verse_number": "४-५५-७", "content_sanskrit": "तस्मिन् पापे कृतघ्ने तु स्मृतिभिन्ने चलात्मनि।\nआर्यः को विश्वसेज्जातु तत्कुलीनो विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000327008, "chapter_id": 9327, "verse_number": "४-५५-८", "content_sanskrit": "राज्ये पुत्रः प्रतिष्ठाप्यः सगुणो निर्गुणोऽपि वा।\nकथं शत्रुकुलीनं मां सुग्रीवो जीवयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000327009, "chapter_id": 9327, "verse_number": "४-५५-९", "content_sanskrit": "भिन्नमन्त्रोऽपराद्धश्च भिन्नशक्तिः कथं ह्यहम्।\nकिष्किन्धां प्राप्य जीवेयमनाथ इव दुर्बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000327010, "chapter_id": 9327, "verse_number": "४-५५-१०", "content_sanskrit": "उपांशुदण्डेन हि मां बन्धनेनोपपादयेत्।\nशठः क्रूरो नृशंसश्च सुग्रीवो राज्यकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000327011, "chapter_id": 9327, "verse_number": "४-५५-११", "content_sanskrit": "बन्धनाच्चावसादान्मे श्रेयः प्रायोपवेशनम्।\nअनुजानन्तु मां सर्वे गृहं गच्छन्तु वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000327012, "chapter_id": 9327, "verse_number": "४-५५-१२", "content_sanskrit": "अहं वः प्रतिजानामि न गमिष्याम्यहं पुरीम्।\nइहैव प्रायमासिष्ये श्रेयो मरणमेव मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000327013, "chapter_id": 9327, "verse_number": "४-५५-१३", "content_sanskrit": "अभिवादनपूर्वं तु राजा कुशलमेव च।\nअभिवादनपूर्वं तु राघवौ बलशालिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000327014, "chapter_id": 9327, "verse_number": "४-५५-१४", "content_sanskrit": "वाच्यस्तातो यवीयान् मे सुग्रीवो वानरेश्वरः।\nआरोग्यपूर्वं कुशलं वाच्या माता रुमा च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000327015, "chapter_id": 9327, "verse_number": "४-५५-१५", "content_sanskrit": "मातरं चैव मे तारामाश्वासयितुमर्हथ।\nप्रकृत्या प्रियपुत्रा सा सानुक्रोशा तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000327016, "chapter_id": 9327, "verse_number": "४-५५-१६", "content_sanskrit": "विनष्टमिह मां श्रुत्वा व्यक्तं हास्यति जीवितम्।\nएतावदुक्त्वा वचनं वृद्धांस्तानभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000327017, "chapter_id": 9327, "verse_number": "४-५५-१७", "content_sanskrit": "विवेश चाङ्गदो भूमौ रुदन् दर्भेषु दुर्मनाः।\nतस्य संविशतस्तत्र रुदन्तो वानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000327018, "chapter_id": 9327, "verse_number": "४-५५-१८", "content_sanskrit": "नयनेभ्यः प्रमुमुचुरुष्णं वै वारि दुःखिताः।\nसुग्रीवं चैव निन्दन्तः प्रशंसन्तश्च वालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000327019, "chapter_id": 9327, "verse_number": "४-५५-१९", "content_sanskrit": "परिवार्याङ्गदं सर्वे व्यवसन् प्रायमासितुम्।\nतद् वाक्यं वालिपुत्रस्य विज्ञाय प्लवगर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000327020, "chapter_id": 9327, "verse_number": "४-५५-२०", "content_sanskrit": "उपस्पृश्योदकं सर्वे प्राङ्मुखाः समुपाविशन्।\nदक्षिणाग्रेषु दर्भेषु उदक्तीरं समाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000327021, "chapter_id": 9327, "verse_number": "४-५५-२१", "content_sanskrit": "मुमूर्षवो हरिश्रेष्ठा एतत् क्षममिति स्म ह।\nरामस्य वनवासं च क्षयं दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000327022, "chapter_id": 9327, "verse_number": "४-५५-२२", "content_sanskrit": "जनस्थानवधं चैव वधं चैव जटायुषः।\nहरणं चैव वैदेह्या वालिनश्च वधं तथा।\nरामकोपं च वदतां हरीणां भयमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000327023, "chapter_id": 9327, "verse_number": "४-५५-२३", "content_sanskrit": "स संविशद्भिर्बहुभिर्महीधरो\nमहाद्रिकूटप्रतिमैः प्लवंगमैः।\nबभूव संनादितनिर्दरान्तरो\nभृशं नदद्भिर्जलदैरिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000327024, "chapter_id": 9327, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे पञ्चपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]