[{"id": 40020143, "chapter_id": 9327, "verse_number": "1", "content_sanskrit": "हन्यमाने बले तस्मिन्पद्मनाभेन पृष्ठतः । माल्वान्सन्निवृत्तो ऽथ वेलामेत्य इवार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020144, "chapter_id": 9327, "verse_number": "2", "content_sanskrit": "संरक्तनयनः कोपाच्चलन्मौलिर्निशाचरः । पद्मनाभमिदं प्राह वचनं पुरुषोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020145, "chapter_id": 9327, "verse_number": "3", "content_sanskrit": "नारायण न जानीषे क्षात्रधर्मं पुरातनम् । अयुद्धमनसो भीतानस्मान्हंसि यथेतरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020146, "chapter_id": 9327, "verse_number": "4", "content_sanskrit": "पराङ्मुखवधं पापं यः करोत्यसुरेतरः । स हन्ता न गतः स्वर्गं लभते पुण्यकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020147, "chapter_id": 9327, "verse_number": "5", "content_sanskrit": "युद्धश्रद्धा ऽथवा ते ऽस्ति शङ्खचक्रगदाधर । 4अहं स्थितो ऽस्मि पश्यामि बलं दर्शय यत्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020148, "chapter_id": 9327, "verse_number": "6", "content_sanskrit": "माल्यवन्तं स्थितं दृष्ट्वा माल्यवन्तमिवाचलम् । उवाच राक्षसेन्द्रं तं देवराजानुजो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020149, "chapter_id": 9327, "verse_number": "7", "content_sanskrit": "युष्मत्तो भयभीतानां देवानां वै मया ऽभयम् । राक्षसोत्सादनं दत्तं तदेतदनुपाल्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020150, "chapter_id": 9327, "verse_number": "8", "content_sanskrit": "प्राणैरपि प्रियं कार्यं देवानां हि सदा मया । सो ऽहं वो निहनिष्यामि रसातलगतानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020151, "chapter_id": 9327, "verse_number": "9", "content_sanskrit": "देवदेवं ब्रुवाणं तं रक्ताम्बुरुहलोचनम् । शक्त्या बिभेद सङ्क्रुद्धो राक्षसेन्द्रो भुजान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020152, "chapter_id": 9327, "verse_number": "10", "content_sanskrit": "माल्यवद्भुजनिर्मुक्ता शक्तिर्घण्टाकृतस्वना । हरेरुरसि बभ्राज मेघस्थेव शतह्रदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020153, "chapter_id": 9327, "verse_number": "11", "content_sanskrit": "ततस्तामेव चोत्कृष्य शक्तिं शक्तिधरप्रियः । माल्यवन्तं समुद्दिश्य चिक्षेपाम्बुरुहेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020154, "chapter_id": 9327, "verse_number": "12", "content_sanskrit": "स्कन्दोत्सृष्टेव सा शक्तिर्गोविन्दकरनिस्सृता । काङ्क्षन्ती राक्षसं प्रायान्माहेन्द्रीवाञ्जनाचलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020155, "chapter_id": 9327, "verse_number": "13", "content_sanskrit": "सा तस्योरसि विस्तीर्णे हारभारा ऽवभासिते । अपतद्राक्षसेन्द्रस्य गिरिकूट इवाशनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020156, "chapter_id": 9327, "verse_number": "14", "content_sanskrit": "तया भिन्नतनुत्राणः प्राविशद्विपुलं तमः । माल्यवान्पुनराश्वस्तस्तस्थौ गिरिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020157, "chapter_id": 9327, "verse_number": "15", "content_sanskrit": "ततः कार्ष्णायसं शूलं कण्टकैर्बहुभिर्वतम् । प्रगृह्याभ्यहनद्देवं स्तनयोरन्तरे दृढम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020158, "chapter_id": 9327, "verse_number": "16", "content_sanskrit": "तथैव रणरक्तस्तु मुष्टिना वासवानुजम् । ताडयित्वा धनुर्मात्रमपक्रान्तो निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020159, "chapter_id": 9327, "verse_number": "17", "content_sanskrit": "ततो ऽम्बरे महाञ्छब्दः साधुसाध्विति चोदितः । आहत्य राक्षसो विष्णुं गरुडं चाप्यताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020160, "chapter_id": 9327, "verse_number": "18", "content_sanskrit": "वैनतेयस्ततः क्रुद्धः पक्षवातेन राक्षसम् । व्यपोहद्बलवान्वायुः शुष्कपर्णचयं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020161, "chapter_id": 9327, "verse_number": "19", "content_sanskrit": "द्विजेन्द्रपक्षवातेन द्रावितं दृश्य पूर्वजम् । सुमाली स्वबलैः सार्धं लङ्कामभिमुखो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020162, "chapter_id": 9327, "verse_number": "20", "content_sanskrit": "पक्षवातबलोद्धूतो माल्यवानपि राक्षसः । स्वबलेन समागम्य ययौ लङ्कां ह्रिया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020163, "chapter_id": 9327, "verse_number": "21", "content_sanskrit": "एवं ते राक्षसा तेन हरिणा कमलेक्षण । बहुशः संयुगे भग्ना हतप्रवरनायकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020164, "chapter_id": 9327, "verse_number": "22", "content_sanskrit": "अशक्नुवन्तस्ते विष्णुं प्रतियोद्धुं भयार्दिताः । त्यक्त्वा लङ्कां गता वस्तुं पातालं सहपत्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020165, "chapter_id": 9327, "verse_number": "23", "content_sanskrit": "सुमालिनं समासाद्य राक्षसं रघुसत्तम । स्थिताः प्रख्यातवीर्यास्ते वंशे सालकटङ्कटे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020166, "chapter_id": 9327, "verse_number": "24", "content_sanskrit": "ये त्वया निहतास्ते तु पौलस्त्या नाम राक्षसाः । सुमाली माल्यवान्माली ये च तेषां पुरःसराः ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020167, "chapter_id": 9327, "verse_number": "25", "content_sanskrit": "सर्वे तेभ्यो महाभागा रावणाद्बलवत्तराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020168, "chapter_id": 9327, "verse_number": "26", "content_sanskrit": "न चान्यो राक्षसान्हन्ता सुरारीन्देवकण्टकान् । ऋते नारायणं देवं शङ्खचक्रगदाधरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020169, "chapter_id": 9327, "verse_number": "27", "content_sanskrit": "भवान्नारायणो देवश्चतुर्बाहुः सनातनः । राक्षसान्हन्तुमुत्पन्नो ह्यजेयः प्रभुरव्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020170, "chapter_id": 9327, "verse_number": "28", "content_sanskrit": "नष्टधर्मव्यवस्थाता काले काले प्रजाकरः । उत्पद्यते दस्युवधे शरणागतवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020171, "chapter_id": 9327, "verse_number": "29", "content_sanskrit": "एषा मया तव नराधिप राक्षसानामुत्पत्तिरद्य कथिता सकला यथावत् । भूयो निबोध रघुसत्तम रावणस्य जन्मप्रभावमतुलं ससुतस्य सर्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020172, "chapter_id": 9327, "verse_number": "30", "content_sanskrit": "चिरात्सुमाली व्यचरद्रसातलं स राक्षसो विष्णुभयार्दितस्तदा । पुत्रैश्च पौत्रैश्च समन्वितो बली ततस्तु लङ्कामवसद्धनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]