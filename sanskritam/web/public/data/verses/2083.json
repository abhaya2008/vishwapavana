[{"id": 2049288, "chapter_id": 2083, "verse_number": "७-१०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049289, "chapter_id": 2083, "verse_number": "७-१०-१", "content_sanskrit": "एवं पृष्ट्वा सूतपुत्रं हृच्छोकेनार्दितो भृशम्।\nजये निराशः पुत्राणां धृतराष्ट्रोऽपतत्क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049290, "chapter_id": 2083, "verse_number": "७-१०-२", "content_sanskrit": "तं विसंज्ञं निपतिन्त सिषिचुः परिचारिकाः।\nजलेनात्यर्थशीतेन जीवन्त्यः पुण्यगन्धिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049291, "chapter_id": 2083, "verse_number": "७-१०-३", "content_sanskrit": "पतितं चैनमालोक्य समस्ता भरतस्त्रियः।\nपरिवव्रुर्महाराजमस्पृशंश्चैव पाणिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049292, "chapter_id": 2083, "verse_number": "७-१०-४", "content_sanskrit": "उत्थाप्य चैनं शनकै राजानं पृथिवीतलात्।\nआसनं प्रापयामासुर्बाष्पकण्ठ्यो वराननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049293, "chapter_id": 2083, "verse_number": "७-१०-५", "content_sanskrit": "आसनं प्राप्य राजा तु मूर्च्छयाऽभिपरिप्लुतः।\nनिश्चेष्टोऽतिष्ठत तदा वीज्यमानः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049294, "chapter_id": 2083, "verse_number": "७-१०-६", "content_sanskrit": "स लब्ध्वा शनकैः संज्ञां वेपमानो महीपतिः।\nपुनर्गावल्गणिं सूतं पर्यपृच्छद्यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049295, "chapter_id": 2083, "verse_number": "७-१०-७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049296, "chapter_id": 2083, "verse_number": "७-१०-७", "content_sanskrit": "यः स उद्यन्निवादित्यो ज्योतिषा प्रणुदंस्तमः।\nअजातशत्रुमायान्तं कस्तं द्रोणादवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049297, "chapter_id": 2083, "verse_number": "७-१०-८", "content_sanskrit": "प्रभिन्नमिव मातङ्गं यथा क्रुद्धं तरस्विनम्।\nप्रसन्नवदनं दृष्ट्वा प्रतिद्विरदगामिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049298, "chapter_id": 2083, "verse_number": "७-१०-९", "content_sanskrit": "वासितासङ्गमे यद्वदजय्यं प्रतियूथपैः।\nनिजघान रणे वीरान्वीरः पुरुषसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049299, "chapter_id": 2083, "verse_number": "७-१०-१०", "content_sanskrit": "यो ह्येको हि महावीर्यो निर्दहेद्धोरचक्षुषा।\nकृत्स्नं दुर्योधनबलं धृतिमान्सत्यसङ्गरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049300, "chapter_id": 2083, "verse_number": "७-१०-११", "content_sanskrit": "चक्षुर्हणं जये सक्तमिष्वासधरमच्युतम्।\nदान्तं बहुमतं लोके के शूराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049301, "chapter_id": 2083, "verse_number": "७-१०-१२", "content_sanskrit": "के दुष्प्रधर्षं राजानमिष्वासधरमच्युतम्।\nसमासेदुर्नरव्याघ्रं कौन्तेयं तत्र मामकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049302, "chapter_id": 2083, "verse_number": "७-१०-१३", "content_sanskrit": "तरसैवाभिपद्याथ यो वै द्रोणमुपाद्रवत्।\nयः करोति महत्कर्म शत्रूणां वै महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049303, "chapter_id": 2083, "verse_number": "७-१०-१४", "content_sanskrit": "महाकायो महोत्साहो नागायुतसमो बले।\nतं भीमसेनमायान्तं के शूराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049304, "chapter_id": 2083, "verse_number": "७-१०-१५", "content_sanskrit": "यदायाज्जलदप्रख्यो रथः परमवीर्यवान्।\nपर्जन्य इव बीभत्सुस्तुमुलामशनीं सृजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049305, "chapter_id": 2083, "verse_number": "७-१०-१६", "content_sanskrit": "विसृजञ्छरजालानि वर्षाणि मघवानिव।\nअवस्फूर्जन्दिशः सर्वास्तलनेमिस्वनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049306, "chapter_id": 2083, "verse_number": "७-१०-१७", "content_sanskrit": "चापविद्युत्प्रभो घोरो रथगुल्मवलाहकः।\nसनेमिघोषस्तनितः शरशब्दातिबन्धुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049307, "chapter_id": 2083, "verse_number": "७-१०-१८", "content_sanskrit": "रोषनिर्जितजीमूतो मनोभिप्रायशीघ्रगः।\nमर्मातिगो बाणधरस्तुमुलः शोणितोदकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049308, "chapter_id": 2083, "verse_number": "७-१०-१९", "content_sanskrit": "सम्प्लावयन्दिशः सर्वा मानवैरास्तरन्महीम्।\nभीमनिःस्वनितो रौद्रो दुर्योधनपुरोगमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049309, "chapter_id": 2083, "verse_number": "७-१०-२०", "content_sanskrit": "युद्धेऽभ्यषिञ्चद्विजयो गार्ध्रपत्रैः शिलाशितैः।\nगाण्डीवं धारयन्धीमान्कीदृशं वो मनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049310, "chapter_id": 2083, "verse_number": "७-१०-२१", "content_sanskrit": "इषुसम्बाधमाकाशं कुर्वन्कपिवरध्वजः।\nयदायात्कथमासीत्तु तदा पार्थं समीक्षताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049311, "chapter_id": 2083, "verse_number": "७-१०-२२", "content_sanskrit": "कच्चिद्गाण्डीवशब्देन न प्रणश्यति वै बलम्।\nयद्वः सभैरवं कुर्वन्नर्जुनो भृशमन्वयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049312, "chapter_id": 2083, "verse_number": "७-१०-२३", "content_sanskrit": "कच्चिन्नापानुदत्प्रामानिषुभिर्वो धनञ्जयः।\nवातो वेगादिवाविध्यन्मेघाञ्शरगणैर्नृपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049313, "chapter_id": 2083, "verse_number": "७-१०-२४", "content_sanskrit": "को हि गाण्डीवधन्वानं रणे सोढुं नरोऽर्हति।\nयमुषश्चुत्य सेनाग्रे जनः सर्वो विदीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049314, "chapter_id": 2083, "verse_number": "७-१०-२५", "content_sanskrit": "यत्सेनाः समकम्पन्त यद्वीरानस्पृशद्भयम्।\nके तत्र नाजहुर्द्रोणं के क्षुद्राः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049315, "chapter_id": 2083, "verse_number": "७-१०-२६", "content_sanskrit": "के वा तत्र तनूस्त्यक्त्वा प्रतीपं मृत्युमाव्रजन्।\nअमानुषाणां जेतारं युद्धेष्वपि धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049316, "chapter_id": 2083, "verse_number": "७-१०-२७", "content_sanskrit": "न च वेगं सिताश्वस्य विसहिष्यन्ति मामकाः।\nगाण्डीवस्य च निर्घोषं प्रावृड्जलदनिःस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049317, "chapter_id": 2083, "verse_number": "७-१०-२८", "content_sanskrit": "विष्वक्सेनो यस्य यन्ता यस्य योद्धा धनञ्चयः।\nअशक्यः स रथो जेतुं मन्ये देवासुरैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049318, "chapter_id": 2083, "verse_number": "७-१०-२९", "content_sanskrit": "सुकुमारो युवा शूरो दर्शनीयश्च पाण्डवः।\nमेधावी निपुणो धीमान्युधि सत्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049319, "chapter_id": 2083, "verse_number": "७-१०-३०", "content_sanskrit": "आरावं विपुलं कुर्वन्व्यथयन्सर्वसैनिकान्।\nयदायान्नकुलो द्रोणं के शूराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049320, "chapter_id": 2083, "verse_number": "७-१०-३१", "content_sanskrit": "आशीविष इव क्रुद्धः सहदेवो यदाऽभ्ययात्।\nकदनं करिष्यञ्शत्रूणां तेजसा दुर्जयो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049321, "chapter_id": 2083, "verse_number": "७-१०-३२", "content_sanskrit": "आर्यव्रतममोघेषुं हीमन्तमपराजितम्।\nसहदेवं तमायान्तं के शूराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049322, "chapter_id": 2083, "verse_number": "७-१०-३३", "content_sanskrit": "यस्तु सौवीरराजस्य प्रमथ्य महतीं चमूम्।\nआदत्त महिषीं भोजां काम्यां सर्वाङ्गशोभनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049323, "chapter_id": 2083, "verse_number": "७-१०-३४", "content_sanskrit": "सत्यं धृतिश्च शौर्यं च ब्रह्मचर्यं च केवलम्।\nसर्वाणि युयुधानेऽस्मिन्नित्यानि पुरुषर्षभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049324, "chapter_id": 2083, "verse_number": "७-१०-३५", "content_sanskrit": "बलिनं सत्यकर्माणमदीनमपराजितम्।\nवासुदेवसमं युद्धे वासुदेवादनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049325, "chapter_id": 2083, "verse_number": "७-१०-३६", "content_sanskrit": "धनञ्जयोपदेशेन श्रेष्ठमिष्वस्त्रकर्मणि।\nपार्थेन सममस्त्रेषु कस्तं द्रोणादवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049326, "chapter_id": 2083, "verse_number": "७-१०-३७", "content_sanskrit": "वृष्णीनां प्रवरं वीरं शूरं सर्वधनुष्मताम्।\nरामेण सममस्त्रेषु यशसा विक्रमेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049327, "chapter_id": 2083, "verse_number": "७-१०-३८", "content_sanskrit": "सत्यं धृतिर्मतिः शौर्यं ब्राह्मं चास्त्रमनुत्तमम्।\nसात्वते तानि सर्वाणि त्रैलोक्यमिव केशवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049328, "chapter_id": 2083, "verse_number": "७-१०-३९", "content_sanskrit": "तमेवङ्गुणसम्पन्नं दुर्वारमपि दैवतैः।\nसमासाद्य महेष्वासं के शूराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049329, "chapter_id": 2083, "verse_number": "७-१०-४०", "content_sanskrit": "पाञ्चालेषूत्तमं वीरमुत्तमाभिजनप्रियम्।\nनित्यमुत्तमकर्माणमुत्तमौजसमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049330, "chapter_id": 2083, "verse_number": "७-१०-४१", "content_sanskrit": "युक्तं धनञ्जयहिते ममानर्थार्थमुत्थितम्।\nयमवैश्रवणादित्यमहेन्द्रवरुणोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2049331, "chapter_id": 2083, "verse_number": "७-१०-४२", "content_sanskrit": "महारथं समाख्यातं द्रोणायोद्यतमाहवे।\nत्यजन्तं तुमुले प्राणान्के शूराः समवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2049332, "chapter_id": 2083, "verse_number": "७-१०-४३", "content_sanskrit": "एकोपसृत्य चेदिभ्यः पाण्डवान्यः समाश्रितः।\nधृष्टकेतुं समायान्तं द्रोणं कस्तं न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2049333, "chapter_id": 2083, "verse_number": "७-१०-४४", "content_sanskrit": "योऽवधीत्केतुमान्वीरो राजपुत्रं दुरासदम्।\nअपरान्तगिरिद्वारे द्रोणात्कस्तं न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2049334, "chapter_id": 2083, "verse_number": "७-१०-४५", "content_sanskrit": "स्त्रीम्पुसयोर्नरव्याघ्रो यः स वेद गुणागुणान्।\nशिखण्डिनं याज्ञसेनिमम्लानमनसं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2049335, "chapter_id": 2083, "verse_number": "७-१०-४६", "content_sanskrit": "देवव्रतस्य समरे हेतुं मृत्योर्महात्मनः।\nद्रोणायाभिमुखं यान्तं के शूराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2049336, "chapter_id": 2083, "verse_number": "७-१०-४७", "content_sanskrit": "यस्मिन्नभ्यधिका वीरे गुणाः सर्वे धनञ्जयात्।\nयस्मिन्नस्त्राणि सत्यं च ब्रह्मचर्यं च सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2049337, "chapter_id": 2083, "verse_number": "७-१०-४८", "content_sanskrit": "वासुदेवसमं वीर्ये धनञ्जयसमं बले।\nतेजसाऽऽदित्यसदृशं बृहस्पतिसमं मतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2049338, "chapter_id": 2083, "verse_number": "७-१०-४९", "content_sanskrit": "अभिमन्युं महात्मानं व्यात्ताननमिवान्तकम्।\nद्रोणायाभिमुखं यान्तं के शूराः समवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2049339, "chapter_id": 2083, "verse_number": "७-१०-५०", "content_sanskrit": "तरुणस्तरुणप्रज्ञः सौभद्रः परवीरहा।\nयदाभ्यधावद्वै द्रोणं तदाऽऽसीद्वो मनः कथं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2049340, "chapter_id": 2083, "verse_number": "७-१०-५१", "content_sanskrit": "द्रौपदेया नरव्याघ्राः समुद्रमिव सिन्धवः।\nयद्रोणमाद्रवन्सङ्ख्ये के शूरास्तान्न्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2049341, "chapter_id": 2083, "verse_number": "७-१०-५२", "content_sanskrit": "एते द्वादश वर्षाणि क्रीडामुत्सृज्य बालकाः।\nअस्त्रार्थमवसन्भीष्मे बिभ्रतो व्रतमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2049342, "chapter_id": 2083, "verse_number": "७-१०-५३", "content_sanskrit": "क्षत्रञ्जयः क्षत्रदेवः क्षत्रवर्मा च मानदः।\nधृष्टद्युम्नात्मजा वीराः के तान्द्रोणादवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2049343, "chapter_id": 2083, "verse_number": "७-१०-५४", "content_sanskrit": "शताद्विशिष्टं यं युद्धे सममन्यन्त वृष्णयः।\nचेकितानं महेष्वासं कस्तं द्रोणादवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2049344, "chapter_id": 2083, "verse_number": "७-१०-५५", "content_sanskrit": "वार्धक्षेमिः कलिङ्गानां यः कन्यामाहरद्युधि।\nअनाधृष्टिरदीनात्मा कस्तं द्रोणादवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2049345, "chapter_id": 2083, "verse_number": "७-१०-५६", "content_sanskrit": "भ्रातरः पञ्च कैकेया धार्मिकाः सत्यविक्रमाः।\nइन्द्रगोपकसङ्काशा रक्तवर्मायुधध्वजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2049346, "chapter_id": 2083, "verse_number": "७-१०-५७", "content_sanskrit": "मातृष्वसुः सुता वीराः पाण्डवानां जयार्थिनः।\nतान्द्रोणं हन्तुमायातान्के वीराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2049347, "chapter_id": 2083, "verse_number": "७-१०-५८", "content_sanskrit": "यं योधयन्तो राजानो नाजयन्वारणावते।\nषण्मासानपि संरब्धा जिघांसन्तो युधां पतिं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2049348, "chapter_id": 2083, "verse_number": "७-१०-५९", "content_sanskrit": "धनुष्मतां वरं शूरं सत्यसन्धं महाबलम्।\nद्रोणात्कस्तं नरव्याघ्रं युयुत्सुं पर्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2049349, "chapter_id": 2083, "verse_number": "७-१०-६०", "content_sanskrit": "यः पुत्रं काशिराजस्य वाराणस्यां महारथम्।\nसमरे स्त्रीषु गृध्यन्तं भल्लेनापाहरद्रथात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2049350, "chapter_id": 2083, "verse_number": "७-१०-६१", "content_sanskrit": "धृष्टद्युम्नं महेष्वासं पार्थानां मन्त्रधारिणम्।\nयुक्तं दुर्योधनानर्थे सृष्टं द्रोणवधाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2049351, "chapter_id": 2083, "verse_number": "७-१०-६२", "content_sanskrit": "निर्दहन्तं रणे योधान्दारयन्तं च सर्वतः।\nद्रोणाभिमुखमायान्तं के शूराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2049352, "chapter_id": 2083, "verse_number": "७-१०-६३", "content_sanskrit": "उत्सङ्ग इव सम्वृद्धं द्रुपदस्यास्त्रवित्तमम्।\nशैखण्डिनं शस्त्रगुप्तं के द्रोणादवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2049353, "chapter_id": 2083, "verse_number": "७-१०-६४", "content_sanskrit": "य इमां पृथिवीं कृत्स्नां चर्मवत्समवेष्टयत्।\nमहता रथघोषेण मुख्यारिघ्नो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2049354, "chapter_id": 2083, "verse_number": "७-१०-६५", "content_sanskrit": "दशाश्वमेधानाजहे स्वन्नपानाप्तदक्षिणान्।\nनिरर्गलान्सर्वमेधान्पुत्रवत्पालयन्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2049355, "chapter_id": 2083, "verse_number": "७-१०-६६", "content_sanskrit": "विसृष्टा दक्षिणा यस्य गङ्गाजलमवारयत्।\nगङ्गास्रोतसि यावत्यः सिकता अप्यशेषतः।\nतावतीर्गा ददौ वीर उशीनरसुतोऽध्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2049356, "chapter_id": 2083, "verse_number": "७-१०-६७", "content_sanskrit": "न पूर्वे नापरे चक्रुरिदं केचन मानवाः।\nइतीदं चुक्रुशुर्देवाः कृते कर्मणि दुष्करे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2049357, "chapter_id": 2083, "verse_number": "७-१०-६८", "content_sanskrit": "पश्यामस्त्रिषु लोकेषु न तं संस्थास्नुचारिषु।\nजातं चापि जनिष्यन्तं द्वितीयं चापि साम्प्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2049358, "chapter_id": 2083, "verse_number": "७-१०-६९", "content_sanskrit": "अन्यमौशीनराच्छेब्याद्धुरो वोढारमित्युत।\nगतिं यस्य न यास्यन्ति मानुषा लोकवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2049359, "chapter_id": 2083, "verse_number": "७-१०-७०", "content_sanskrit": "तस्य नप्तारमायान्तं शैब्यं कः समवारयत्।\nद्रोणायाभिमुखं यत्तं व्यात्ताननमिवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2049360, "chapter_id": 2083, "verse_number": "७-१०-७१", "content_sanskrit": "विराटस्य रथानीकं मत्स्यस्यामित्रघातिनः।\nप्रेप्सन्तं समरे द्रोणं के वीराः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2049361, "chapter_id": 2083, "verse_number": "७-१०-७२", "content_sanskrit": "सद्यो वृकोदराज्जातो महाबलपराक्रमः।\nमायावी राक्षसो वीरो यस्मान्मम महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2049362, "chapter_id": 2083, "verse_number": "७-१०-७३", "content_sanskrit": "पार्थानां जयकामं तं तं पुत्राणां मम कण्टकम्।\nघटोत्कचं महात्मानं कस्तं द्रोणादवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2049363, "chapter_id": 2083, "verse_number": "७-१०-७४", "content_sanskrit": "एते चान्ये च बहवो येषामजितं युधि।\nत्यक्तारः संयुगे प्राणान्किं तेषामजितं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2049364, "chapter_id": 2083, "verse_number": "७-१०-७५", "content_sanskrit": "येषां च पुरुषव्याघ्रः शार्ङ्गधन्वा व्यपाश्रयः॥\nलोकानां गुरुरत्यर्थं लोकनाथः सनातनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2049365, "chapter_id": 2083, "verse_number": "७-१०-७६", "content_sanskrit": "नारायणोरणे नाथो दिव्यो दिव्यात्मकः प्रभुः॥\nयस्य दिव्यानि कर्माणि प्रवदन्ति मनीषिणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2049366, "chapter_id": 2083, "verse_number": "७-१०-७७", "content_sanskrit": "तान्यहं कीर्तयिष्यामि भक्त्या स्थैर्यार्थमात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2049367, "chapter_id": 2083, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि दशमोऽध्यायः॥ १० ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१०-८ सः प्रसिद्धः। तमजातशत्रुम् आयान्तं दृष्ट्वा द्रोणात्कः अवारयदित्यन्वयः॥ ५-१०-१५ यदा अयात् यदा च दुर्योधनपुरोगमान्गार्ध्रपत्रैरभ्यषिञ्चत्तदा वो मनः क्रीदृशमभूदिति षष्ठेनान्वयः॥ ५-१०-३४ युयुधाने सात्यकौ॥ ५-१०-३८ सात्वते सात्यकौ॥ ५-१०-६८ स्थास्रुचारिषु स्थावरजङ्गमात्मकेषु। स्नमित्यस्य व्यवहितेन पश्याम इत्यनेन सम्बन्धः॥ ५-१०-१० दशमोऽध्यायः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]