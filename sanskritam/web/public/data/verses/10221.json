[{"id": 6000221000, "chapter_id": 10221, "verse_number": null, "content_sanskrit": "अथ पञ्चविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000221001, "chapter_id": 10221, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.001.m4a", "display_order": 2}, {"id": 6000221002, "chapter_id": 10221, "verse_number": "१०-२५-१", "content_sanskrit": "गोवर्धने धृते शैले आसाराद् रक्षिते व्रजे।\nगोलोकादाव्रजत् कृष्णं सुरभिः शक्र एव च॥ १०/२५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.002.m4a", "display_order": 3, "topics": [{"text": "इन्द्रेण कृतं श्रीकृष्णस्तवनम्", "range": "१–१३"}]}, {"id": 6000221003, "chapter_id": 10221, "verse_number": "१०-२५-२", "content_sanskrit": "विविक्त उपसङ्गम्य व्रीडितः कृतहेलनः।\nपस्पर्श पादयोरेनं किरीटेनार्कवर्चसा॥ १०/२५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.003.m4a", "display_order": 4}, {"id": 6000221004, "chapter_id": 10221, "verse_number": "१०-२५-३", "content_sanskrit": "दृष्टश्रुतानुभावोऽस्य कृष्णस्यामिततेजसः।\nनष्टत्रिलोकेशमद इदमाह कृताञ्जलिः॥ १०/२५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.004.m4a", "display_order": 5}, {"id": 6000221005, "chapter_id": 10221, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.005.m4a", "display_order": 6}, {"id": 6000221006, "chapter_id": 10221, "verse_number": "१०-२५-४", "content_sanskrit": "विशुद्धसत्त्वं तव धाम शान्तं तपोमयं ध्वस्तरजस्तमस्कम्।\nमायामयोऽयं गुणसम्प्रवाहो न विद्यते तेऽग्रहणानुबन्धः॥ १०/२५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.006.m4a", "display_order": 7}, {"id": 6000221007, "chapter_id": 10221, "verse_number": "१०-२५-५", "content_sanskrit": "कुतो नु तद्धेतव ईश मन्युलोभादयो येऽबुधलिङ्गभावाः।\nअथापि दण्डं भगवान् बिभर्ति धर्मस्य गुप्त्यै खलनिग्रहाय॥ १०/२५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.007.m4a", "display_order": 8}, {"id": 6000221008, "chapter_id": 10221, "verse_number": "१०-२५-६", "content_sanskrit": "पिता गुरुस्त्वं जगतामधीशो दुरत्ययः काल उपात्तदण्डः।\nहिताय स्वेच्छातनुभिः समीहसे मानं विधुन्वन् जगदीशमानिनाम्॥ १०/२५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.008.m4a", "display_order": 9}, {"id": 6000221009, "chapter_id": 10221, "verse_number": "१०-२५-७", "content_sanskrit": "येऽस्मद्विधाः स्युर्जगदीश मानिनस्त्वां वीक्ष्य कालेऽभयमाशु तं मदम्।\nहित्वाऽऽर्यमार्गं प्रभजन्त्यपस्मया ईहा खलानामपि तेऽनुशासनम्॥ १०/२५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.009.m4a", "display_order": 10}, {"id": 6000221010, "chapter_id": 10221, "verse_number": "१०-२५-८", "content_sanskrit": "स त्वं ममैश्वर्यमदप्लुतस्य कृतागसस्तेऽविदुषः प्रभावम्।\nक्षन्तुं प्रभोऽथार्हसि मूढचेतसो मैवं पुनर्भून्मतिरीश मेऽसती॥ १०/२५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.010.m4a", "display_order": 11}, {"id": 6000221011, "chapter_id": 10221, "verse_number": "१०-२५-९", "content_sanskrit": "तवावतारोऽयमधोक्षजेह भुवो भराणामुरुभारजन्मनाम्।\nचमूपतीनामभवाय देव भवाय युष्मच्चरणानुवर्तिनाम्॥ १०/२५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.011.m4a", "display_order": 12}, {"id": 6000221012, "chapter_id": 10221, "verse_number": "१०-२५-१०", "content_sanskrit": "नमस्तुभ्यं भगवते पुरुषाय महात्मने।\nवासुदेवाय कृष्णाय सात्वतां पतये नमः॥ १०/२५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.012.m4a", "display_order": 13}, {"id": 6000221013, "chapter_id": 10221, "verse_number": "१०-२५-११", "content_sanskrit": "स्वच्छन्देनात्तदेहाय विशुद्धज्ञानमूर्तये।\nसर्वस्मै सर्वबीजाय सर्वभूतात्मने नमः॥ १०/२५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.013.m4a", "display_order": 14}, {"id": 6000221014, "chapter_id": 10221, "verse_number": "१०-२५-१२", "content_sanskrit": "मयेदं भगवान् गोष्ठनाशायासारवायुभिः।\nचेष्टितं विहते यज्ञे मानिना तीव्रमन्युना॥ १०/२५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.014.m4a", "display_order": 15}, {"id": 6000221015, "chapter_id": 10221, "verse_number": "१०-२५-१३", "content_sanskrit": "त्वयेशानुगृहीतोऽस्मि ध्वस्तस्तम्भो वृथोद्यमः।\nईश्वरं गुरुमात्मानं त्वामहं शरणं गतः॥ १०/२५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.015.m4a", "display_order": 16}, {"id": 6000221016, "chapter_id": 10221, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.016.m4a", "display_order": 17}, {"id": 6000221017, "chapter_id": 10221, "verse_number": "१०-२५-१४", "content_sanskrit": "एवं सङ्कीर्तितः कृष्णो मघोना भगवानमुम्।\nमेघगम्भीरया वाचा प्रहसन्निदमब्रवीत्॥ १०/२५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.017.m4a", "display_order": 18, "topics": [{"text": "सुरभ्या सह श्रीकृष्णस्याभिषेकः", "range": "१४–२८"}]}, {"id": 6000221018, "chapter_id": 10221, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.018.m4a", "display_order": 19}, {"id": 6000221019, "chapter_id": 10221, "verse_number": "१०-२५-१५", "content_sanskrit": "मया तेऽकारि मघवन् मखभङ्गोऽनुगृह्णता।\nमदनुस्मृतये नित्यं मत्तस्येन्द्रश्रिया भृशम्॥ १०/२५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.019.m4a", "display_order": 20}, {"id": 6000221020, "chapter_id": 10221, "verse_number": "१०-२५-१६", "content_sanskrit": "मामैश्वर्यश्रीमदान्धो दण्डपाणिं न पश्यति।\nतं भ्रंशयामि सम्पद्भ्यो यस्य चेच्छाम्यनुग्रहम्॥ १०/२५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.020.m4a", "display_order": 21}, {"id": 6000221021, "chapter_id": 10221, "verse_number": "१०-२५-१७", "content_sanskrit": "गम्यतां शक्र भद्रं ते क्रियतां मेऽनुशासनम्।\nस्थीयतां स्वाधिकारेषु युक्तैर्विस्रम्भवर्जितैः॥ १०/२५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.021.m4a", "display_order": 22}, {"id": 6000221022, "chapter_id": 10221, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.022.m4a", "display_order": 23}, {"id": 6000221023, "chapter_id": 10221, "verse_number": "१०-२५-१८", "content_sanskrit": "अथाह सुरभिः कृष्णमभिवन्द्य मनस्विनी।\nस्वसन्तानैरुपामन्त्र्य गोपरूपिणमीश्वरम्॥ १०/२५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.023.m4a", "display_order": 24}, {"id": 6000221024, "chapter_id": 10221, "verse_number": null, "content_sanskrit": "सुरभिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.024.m4a", "display_order": 25}, {"id": 6000221025, "chapter_id": 10221, "verse_number": "१०-२५-१९", "content_sanskrit": "कृष्ण कृष्ण महायोगिन् विश्वात्मन् विश्वसम्भव।\nभवता लोकनाथेन सनाथा वयमच्युत॥ १०/२५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.025.m4a", "display_order": 26}, {"id": 6000221026, "chapter_id": 10221, "verse_number": "१०-२५-२०", "content_sanskrit": "त्वं नः परमकं दैवं त्वं न इन्द्रो जगत्पते।\nभवाय भव गोविप्रदेवानां ये च साधवः॥ १०/२५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.026.m4a", "display_order": 27}, {"id": 6000221027, "chapter_id": 10221, "verse_number": "१०-२५-२१", "content_sanskrit": "इन्द्रं नस्त्वाभिषेक्ष्यामो ब्रह्मणा चोदिता वयम्।\nअवतीर्णोऽसि विश्वात्मन् भूमेर्भारापनुत्तये॥ १०/२५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.027.m4a", "display_order": 28}, {"id": 6000221028, "chapter_id": 10221, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.028.m4a", "display_order": 29}, {"id": 6000221029, "chapter_id": 10221, "verse_number": "१०-२५-२२", "content_sanskrit": "एवं कृष्णमुपामन्त्र्य सुरभिः पयसाऽऽत्मनः।\nजलैश्चाकाशगङ्गाया ऐरावतकरोद्धृतैः॥ १०/२५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.029.m4a", "display_order": 30}, {"id": 6000221030, "chapter_id": 10221, "verse_number": "१०-२५-२३", "content_sanskrit": "इन्द्रः सुरर्षिभिः साकं चोदितो देवमातृभिः।\nअभ्यषिञ्चत दाशार्हं गोविन्द इति चाभ्यधात्॥ १०/२५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.030.m4a", "display_order": 31}, {"id": 6000221031, "chapter_id": 10221, "verse_number": "१०-२५-२४", "content_sanskrit": "तत्रागतास्तुम्बुरुनारदादयो गन्धर्वविद्याधरसिद्धचारणाः।\nजगुर्यशो लोकमलापहं हरेः सुराङ्गनाः सन्ननृतुर्मुदाऽन्विताः॥ १०/२५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.031.m4a", "display_order": 32}, {"id": 6000221032, "chapter_id": 10221, "verse_number": "१०-२५-२५", "content_sanskrit": "तं तुष्टुवुर्देवनिकायकेतवो व्यवाकिरंश्चाद्भुतपुष्पवृष्टिभिः।\nलोकाः परां निर्वृतिमाप्नुवंस्‍त्रयो गावस्तदा गामनयन् पयोद्रुताम्॥ १०/२५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.032.m4a", "display_order": 33}, {"id": 6000221033, "chapter_id": 10221, "verse_number": "१०-२५-२६", "content_sanskrit": "नानारसौघाः सरितो वृक्षा आसन् मधुस्रवाः।\nअकृष्टपच्यौषधयो गिरयोऽबिभ्रदुन्मणीन्॥ १०/२५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.033.m4a", "display_order": 34}, {"id": 6000221034, "chapter_id": 10221, "verse_number": "१०-२५-२७", "content_sanskrit": "कृष्णेऽभिषिक्त एतानि सर्वाणि कुरुनन्दन।\nनिर्वैराण्यभवंस्तात क्रूराण्यपि निसर्गतः॥ १०/२५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.034.m4a", "display_order": 35}, {"id": 6000221035, "chapter_id": 10221, "verse_number": "१०-२५-२८", "content_sanskrit": "इति गोगोकुलपतिं गोविन्दमभिषिच्य सः।\nअनुज्ञातो ययौ शक्रो वृतो देवादिभिर्दिवम्॥ १०/२५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_025/BhP_10.025.035.m4a", "display_order": 36}, {"id": 6000221036, "chapter_id": 10221, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे पञ्चविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]