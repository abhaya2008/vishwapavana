[{"id": 2141023, "chapter_id": 4043, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141024, "chapter_id": 4043, "verse_number": "१", "content_sanskrit": "कलाश्च तत युज्यन्ते मुहूर्ताश्च दिनानि च ।\nअर्धमासाश्च मासाश्च नक्षत्राणि ग्रहास्तथा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141025, "chapter_id": 4043, "verse_number": "२", "content_sanskrit": "ऋतवश्चापि दृश्यन्ते तथा संवत्सरा अपि ।\nएवं कालविभागेन कालचक्रं प्रवर्तते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141026, "chapter_id": 4043, "verse_number": "३", "content_sanskrit": "तेषां कालातिरेकेण ज्योतिषां च व्यतिक्रमात् ।\nपञ्चमे पञ्चमे वर्षे द्वौ मासावधिमासकौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141027, "chapter_id": 4043, "verse_number": "४", "content_sanskrit": "तेषामप्यधिका मासाः पञ्च द्वादश च क्षपाः ।\nत्रयोदशानां वर्षाणामिति मे निश्चिता मतिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141028, "chapter_id": 4043, "verse_number": "५", "content_sanskrit": "पूर्वेद्युरेव निर्वृत्तस्ततो बीभत्सुरागतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141029, "chapter_id": 4043, "verse_number": "६", "content_sanskrit": "सर्वं यथावच्चरितं यद्यदेभिः प्रतिश्रुतम् ।\nएवमेतद् ध्रुवं ज्ञात्वा ततो बीभत्सुरागतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141030, "chapter_id": 4043, "verse_number": "७", "content_sanskrit": "सर्वे पञ्च महात्मानः सर्वे धर्मार्थकोविदाः ।\nयेषां युधिष्ठिरो राजा कस्माद् धर्मे पराययुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141031, "chapter_id": 4043, "verse_number": "८", "content_sanskrit": "अलुब्धाश्चैव कौन्तेयाः कृतवन्तश्च दुष्करम् ।\nन चापि केवलं राज्यमिच्छेयुस्तेऽनुपायतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141032, "chapter_id": 4043, "verse_number": "९", "content_sanskrit": "तदैव ते हि विक्रान्तुमीशुः पाण्डवनन्दनाः ।\nधर्मपाशनिबद्धास्तु न चेलुः क्षत्रियव्रतात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141033, "chapter_id": 4043, "verse_number": "१०", "content_sanskrit": "यश्चानृत इति ख्यायेद् यश्च गच्छेत् परां गतिम् ।\nवृणीयुर्मरणं पार्था नानृतत्वं कथञ्चन\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141034, "chapter_id": 4043, "verse_number": "११", "content_sanskrit": "प्राप्ते तु काले स्वानर्थान् नोत्सृजेयुर्नरर्षभाः ।\nअपि वज्रभृता गुप्तान् तथावीर्या हि पाण्डवाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141035, "chapter_id": 4043, "verse_number": "१२", "content_sanskrit": "प्रतियुद्ध्येम समरे सर्वशस्त्रभृतां वरम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141036, "chapter_id": 4043, "verse_number": "१३", "content_sanskrit": "तस्माद् यदत्र कल्याणं लोके सद्भिरनुष्ठितम् ।\nतत् संविधीयतां क्षिप्रं मा नो ह्यर्थोऽतिगात् परान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141037, "chapter_id": 4043, "verse_number": "१४", "content_sanskrit": "न हि पश्यामि सङ्ग्रामे कदाचिदपि कौरव ।\nएकान्तसिद्धिं राजेन्द्र सम्प्राप्तश्च धनञ्जयः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141038, "chapter_id": 4043, "verse_number": "१५", "content_sanskrit": "सम्प्रवृत्ते च सङ्ग्रामे भावाभावौ जयाजयौ ।\nअवश्यमेकं स्पृशतो दृष्टमेतदसंशयम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141039, "chapter_id": 4043, "verse_number": "१६", "content_sanskrit": "तस्माद् यद् दानचरितं कर्म वा धर्मसंहितम् ।\nक्रियतामाशु राजेन्द्र सम्प्राप्तश्च धनञ्जयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141040, "chapter_id": 4043, "verse_number": "१७", "content_sanskrit": "एकोऽपि समरे पार्थः पृथिवीं निर्दहेत् शरैः ।\nभ्रातृभिः सहितो वीरैः किं पुनः कौरवान् रणे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141041, "chapter_id": 4043, "verse_number": "१८", "content_sanskrit": "तस्मात् सन्धिं कुरुश्रेष्ठ कुरुष्व यदि मन्यसे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141042, "chapter_id": 4043, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141043, "chapter_id": 4043, "verse_number": "१९", "content_sanskrit": "नाहं राज्यं प्रदास्यामि पाण्डवानां पितामह ।\nग्रामं सेनां च दासीश्च द्रव्यं स्वल्पमपि प्रभो\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141044, "chapter_id": 4043, "verse_number": "२०", "content_sanskrit": "युद्धोपचारिकं यत्तु तत् शीघ्रं संविधीयताम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141045, "chapter_id": 4043, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141046, "chapter_id": 4043, "verse_number": "२१", "content_sanskrit": "तातात्र मामिका बुद्धिः श्रूयतां यदि रोचते ।\nसर्वथा हि मया श्रेयो वक्तव्यं कुरुनन्दन\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141047, "chapter_id": 4043, "verse_number": "२२", "content_sanskrit": "क्षिप्रं बलं चतुर्भागं गृह्यागच्छ पुरं प्रति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141048, "chapter_id": 4043, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141049, "chapter_id": 4043, "verse_number": "२३", "content_sanskrit": "भीष्मस्योपरते वाक्ये तथा दुर्योधनस्य च ।\nप्राप्तमर्थ्यं च यद् वाक्यं द्रोणश्चाह द्विजोत्तमः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141050, "chapter_id": 4043, "verse_number": "२४", "content_sanskrit": "यत्तु युद्धायाचरितं भवेद्वा धर्मसंहितम् ।\nकस्त्वया सदृशो लोके यदि तत् कर्तुमर्हति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141051, "chapter_id": 4043, "verse_number": "२५", "content_sanskrit": "इयं च मामिका प्रज्ञा श्रूयतां यदि रोचते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141052, "chapter_id": 4043, "verse_number": "२६", "content_sanskrit": "राजा बलचतुर्भागं क्षिप्रमादाय गच्छतु ।\nततोऽपरश्चतुर्भागो गाः समादाय गच्छतु\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141053, "chapter_id": 4043, "verse_number": "२७", "content_sanskrit": "वयमर्धेन सैन्यस्य प्रतियोत्स्यामहेऽर्जुनम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141054, "chapter_id": 4043, "verse_number": "२८", "content_sanskrit": "अहं द्रोणश्च कर्णश्च अश्वत्थामा कृपस्तथा ।\nप्रतियोत्स्याम बीभत्सुमागतं कृतनिश्चयम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141055, "chapter_id": 4043, "verse_number": "२९", "content_sanskrit": "एवं राजा सुगुप्तः स्यान्न क्लैब्यं गन्तुमर्हति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2141056, "chapter_id": 4043, "verse_number": "३०", "content_sanskrit": "मात्स्यं वा पुनरायान्तमथवाऽपि शतक्रतुम् ।\nअहमावारयिष्यामि वेलेव मकरालयम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2141057, "chapter_id": 4043, "verse_number": "३१", "content_sanskrit": "योत्स्यामः सह संहत्य पाकशासनिमागतम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2141058, "chapter_id": 4043, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2141059, "chapter_id": 4043, "verse_number": "३२", "content_sanskrit": "तद्वाक्यं न कृतं तेन द्रोणेनोक्तं महात्मना ।\nतथा हि कृतवान् राजा कौरवाणामनन्तरम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2141060, "chapter_id": 4043, "verse_number": "३३", "content_sanskrit": "भीष्मः प्रस्थाप्य राजानं गोधनं तदनन्तरम् ।\nसेनामुख्यान् व्यवस्थाप्य व्यूहितुं सम्प्रचक्रमे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2141061, "chapter_id": 4043, "verse_number": "३४", "content_sanskrit": "द्रोणस्योपरते वाक्ये भीष्मः प्रोवाच बुद्धिमान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2141062, "chapter_id": 4043, "verse_number": "३५", "content_sanskrit": "आचार्यो मध्यतस्तिष्ठेत् अश्वत्थामा तु सव्यतः ।\nकृपः शारद्वतो धीमान् पार्श्वं रक्षतु दक्षिणम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2141063, "chapter_id": 4043, "verse_number": "३६", "content_sanskrit": "विकर्णश्च महावीर्यो दुर्मुखश्च परन्तपः ।\nशकुनिः सौबलश्चैव दुःसहश्च महाबलः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2141064, "chapter_id": 4043, "verse_number": "३७", "content_sanskrit": "द्रोणस्य पार्श्वमजिताः पालयन्तु महाबलाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2141065, "chapter_id": 4043, "verse_number": "३८", "content_sanskrit": "अग्रतः सूतपुत्रस्तु कर्णस्तिष्ठतु दंसितः ।\nअहं सर्वस्य सैन्यस्य पश्चात् स्थास्यामि पालयन्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2141066, "chapter_id": 4043, "verse_number": "३९", "content_sanskrit": "सर्वे महारथाः शूरा महेष्वासा महाबलाः ।\nयुद्ध्यन्तु पाण्डवश्रेष्ठमागतं यत्नतो युधि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2141067, "chapter_id": 4043, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2141068, "chapter_id": 4043, "verse_number": "४०", "content_sanskrit": "अभेद्यं सर्वसैन्यानां व्यूह्य व्यूहं कुरूत्तमः ।\nवज्रगर्भं व्रीहिमुखं अर्धचक्रान्तमण्डलम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2141069, "chapter_id": 4043, "verse_number": "४१", "content_sanskrit": "तस्य व्यूहस्य पश्चार्धे भीष्मश्चाथोद्यतायुधः ।\nसौवर्णं ताळमुच्छ्रित्य रथे तिष्ठन्नशोभत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2141070, "chapter_id": 4043, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि एकपञ्चाशोऽध्यायः ॥५१॥ गोग्रहणपर्वणि चतुर्विंशोऽध्यायः ॥२४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]