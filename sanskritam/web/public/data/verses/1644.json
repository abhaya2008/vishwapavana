[{"id": 2029527, "chapter_id": 1644, "verse_number": "३-२८२-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029528, "chapter_id": 1644, "verse_number": "३-२८२-१", "content_sanskrit": "ततस्तां भर्तृशोकार्तां दीनां मलिनवाससम्।\nमणिशेषाभ्यलंकारां रुदतीं च पतिव्रताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029529, "chapter_id": 1644, "verse_number": "३-२८२-२", "content_sanskrit": "राक्षसीभिरुपास्यन्तीं समासीनां शिलातले।\nरावणःकामबाणार्तो ददर्शोपससर्प च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029530, "chapter_id": 1644, "verse_number": "३-२८२-३", "content_sanskrit": "देवदानवगन्धर्वयक्षकिंपुरुषैर्युधि।\nअजितोशोकवनिकां ययौ कन्दर्पपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029531, "chapter_id": 1644, "verse_number": "३-२८२-४", "content_sanskrit": "दिव्याम्बरधरः श्रीमन्सुमृष्टमणिकुण्डलः।\nविचित्रमाल्यमुकुटो वसन्त इव मूर्तिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029532, "chapter_id": 1644, "verse_number": "३-२८२-५", "content_sanskrit": "न कल्पवृक्षसदृशोयत्नादपि विभूषितः।\nश्मशानचैत्यद्रुमवद्भूषितोऽपि भयंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029533, "chapter_id": 1644, "verse_number": "३-२८२-६", "content_sanskrit": "स तस्यास्तनुमध्यायाः समीपे रजनीचरः।\nददृशे रोहिणीमेत्य शनैश्चर इव ग्रैहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029534, "chapter_id": 1644, "verse_number": "३-२८२-७", "content_sanskrit": "स तामामन्त्र्य सुश्रोणीं पुष्पकेतुशराहतः।\nइदमित्यब्रवीद्वाक्यं त्रस्तां रौहीमिवाबलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029535, "chapter_id": 1644, "verse_number": "३-२८२-८", "content_sanskrit": "सीते पर्याप्तमेतावत्कृतोभर्तुरनुग्रहः।\nप्रसादं कुरु तन्वङ्गि क्रियतां परिकर्म ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029536, "chapter_id": 1644, "verse_number": "३-२८२-९", "content_sanskrit": "भजस्वमां वरारोहे महार्हाभरणाम्बरा।\nभवमे सर्वनारीणामुत्तमा वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029537, "chapter_id": 1644, "verse_number": "३-२८२-१०", "content_sanskrit": "सन्ति मे देवक्न्याश्च गन्धर्वाणआं च योषितः।\nसन्ति दानवन्याश् दैत्यानां चापि योषितः।\n`तासामद्यविशालाक्षि सर्वासां मे भवोत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029538, "chapter_id": 1644, "verse_number": "३-२८२-११", "content_sanskrit": "चतुर्दश पिशाचीनां कोट्यो मे वचने स्थिताः।\nद्विस्तावत्पुरुषादानां रक्षसां भीमकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029539, "chapter_id": 1644, "verse_number": "३-२८२-१२", "content_sanskrit": "ततो मे त्रिगुणा यक्षा ये मद्वचनकारिणः।\nकेचिदेव धनाध्यक्षं भ्रातरं मे समाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029540, "chapter_id": 1644, "verse_number": "३-२८२-१३", "content_sanskrit": "गन्दर्वाप्सरसो भद्रे मामापानगतं सदा।\nउपतिष्ठन्ति वामोरु यथैव भ्रातरं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029541, "chapter_id": 1644, "verse_number": "३-२८२-१४", "content_sanskrit": "पुत्रोऽहमपि विप्रर्षेः साक्षाद्विश्रवसो मुनेः।\nपञ्चमो लोकपालानामिति मे प्रथितं यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029542, "chapter_id": 1644, "verse_number": "३-२८२-१५", "content_sanskrit": "दिव्यानि भक्ष्यभोज्यानि पानानि विविधानि च।\nयथैव त्रिदशेशस्यतथैव मम भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029543, "chapter_id": 1644, "verse_number": "३-२८२-१६", "content_sanskrit": "क्षीयतां दुष्कृतं कर्म वनवासकृतं तव।\nभार्या मे भवसुश्रोणि यथा मण्डोदरीतथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029544, "chapter_id": 1644, "verse_number": "३-२८२-१७", "content_sanskrit": "इत्युक्ता तेन वैदेही परिवृत्य सुभानना।\nतृणमनतरतः कृत्वातमुवाच निशाचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029545, "chapter_id": 1644, "verse_number": "३-२८२-१८", "content_sanskrit": "अशिवेनातिवामोरूरजस्रं नेत्रवारिणा।\nस्तनावपतितौ बाला संहतावभिवर्षती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029546, "chapter_id": 1644, "verse_number": "३-२८२-१९", "content_sanskrit": "`व्यवस्थाप्यकथंचित्सा विषादादतिमोहिता।\nउवाच वाक्यं तं क्षुद्रं वैदेही पतिदेवता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029547, "chapter_id": 1644, "verse_number": "३-२८२-२०", "content_sanskrit": "असकृद्वदतो वाक्यमीदृशं राक्षसेश्वर।\nविषादयुक्तमेतत्ते मया श्रुतमभाग्यया।\nतद्भद्रमुख भद्रं ते मानसं विनिवर्त्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029548, "chapter_id": 1644, "verse_number": "३-२८२-२१", "content_sanskrit": "परदाराऽस्म्यलभ्या च सततं च पतिव्रता।\nन चैवौपयिकी भार्य मानुषी तव राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029549, "chapter_id": 1644, "verse_number": "३-२८२-२२", "content_sanskrit": "विवशां धर्षयित्वच कां त्वं प्रीतिमवाप्स्यसि।\nन च पालयसे धर्मं लोकपालसमः कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029550, "chapter_id": 1644, "verse_number": "३-२८२-२३", "content_sanskrit": "भ्रातरं राजराजं तं महेश्वरसस्वं प्रभुम्।\nधनेश्वरं व्यपदिशन्कथं त्विह न लज्जसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029551, "chapter_id": 1644, "verse_number": "३-२८२-२४", "content_sanskrit": "इत्युक्त्वा प्रारुदत्सीता कम्पयन्ती पयोधरौ।\nशिरोधरां च तन्वङ्गी मुस्वं प्रच्छाद्यवाससा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029552, "chapter_id": 1644, "verse_number": "३-२८२-२५", "content_sanskrit": "तस्य रुदत्या भामित्या दीर्घा वेणी सुसयता।\nददृशे स्वसिता स्निग्धा काली व्यालीव मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029553, "chapter_id": 1644, "verse_number": "३-२८२-२६", "content_sanskrit": "श्रुत्वा तद्रावणो वाक्यं सीतयोक्तं सुनिषुरम्।\nप्रत्याख्यातोऽपिदुर्मेधाः पुनरेवाब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029554, "chapter_id": 1644, "verse_number": "३-२८२-२७", "content_sanskrit": "काममङ्गनि मे सीते दुनोतु मकरध्वजः।\nनत्वामकामां सुश्रोणीं समेप्ये चारुहासिनीं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029555, "chapter_id": 1644, "verse_number": "३-२८२-२८", "content_sanskrit": "किंनु शक्यं मया कर्तुं यत्त्वमद्यापिमानुषम्।\nआहारभूतमस्माकं राममेवानुरुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029556, "chapter_id": 1644, "verse_number": "३-२८२-२९", "content_sanskrit": "इत्युक्त्वा तामनिन्द्याङ्गीं स राक्षसमहेश्वरः।\nतत्रैवान्तर्हितो भूत्वा जगामाभिमतां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029557, "chapter_id": 1644, "verse_number": "३-२८२-३०", "content_sanskrit": "राक्षसीभिः परिवृतावैदेही शोककशिंता।\nसेव्यमाना त्रिजटया तत्रैव न्यवसत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029558, "chapter_id": 1644, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि द्व्यशीत्यधिकद्विशततमोऽध्यायः ॥ २८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]