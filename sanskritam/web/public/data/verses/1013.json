[{"id": 2001181, "chapter_id": 1013, "verse_number": "१-१४-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001182, "chapter_id": 1013, "verse_number": "१-१४-१", "content_sanskrit": "ततो निवेशाय तदा स विप्रः संशितव्रतः।\nमहीं चचार दारार्थी न च दारानविन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001183, "chapter_id": 1013, "verse_number": "१-१४-२", "content_sanskrit": "स कदाचिद्वनं गत्वा विप्रः पितृवचः स्मरन्।\nचुक्रोश कन्याभिक्षार्थी तिस्रो वाचः शनैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001184, "chapter_id": 1013, "verse_number": "१-१४-३", "content_sanskrit": "तं वासुकिः प्रत्यगृह्णादुद्यम्य भगिनीं तदा।\nन स तां प्रतिजग्राह न सनाम्नीति चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001185, "chapter_id": 1013, "verse_number": "१-१४-४", "content_sanskrit": "सनाम्नीं चोद्यतां भार्यां गृह्णीयामिति तस्य हि।\nमनो निविष्टमभवज्जरत्कारोर्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001186, "chapter_id": 1013, "verse_number": "१-१४-५", "content_sanskrit": "तमुवाच महाप्राज्ञो जरत्कारुर्महातपाः।\nकिंनाम्नी भगिनीयं ते ब्रूहि सत्यं भुजंगम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001187, "chapter_id": 1013, "verse_number": "१-१४-६x", "content_sanskrit": "वासुकिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001188, "chapter_id": 1013, "verse_number": "१-१४-६", "content_sanskrit": "जरत्कारो जरत्कारुः स्वसेयमनुजा मम।\nप्रतिगृह्णीष्व भार्यार्थे मया दत्तां सुमध्यमाम्।\nत्वदर्थं रक्षिता पूर्वं प्रतीच्छेमां द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001189, "chapter_id": 1013, "verse_number": "१-१४-७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001190, "chapter_id": 1013, "verse_number": "१-१४-७", "content_sanskrit": "एवमुक्त्वा ततः प्रादाद्भार्यार्थे वरवर्णिनीम्।\nस च तां प्रतिजग्राह विधिदृष्टेन कर्मणा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001191, "chapter_id": 1013, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि चतुर्दशोऽध्यायः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]