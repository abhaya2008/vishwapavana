[{"id": 50003323, "chapter_id": 10693, "verse_number": "1", "content_sanskrit": "ये यथा मां प्रपद्यन्ते तांस्तथैव भजाम्यहम्। मम वर्त्मानुवर्तन्ते मनुष्याः पार्थ सर्वशः॥ ४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50003324, "chapter_id": 10693, "verse_number": "2", "content_sanskrit": "काङ्क्षन्तः कर्मणां सिद्धिं यजन्त इह देवताः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50003325, "chapter_id": 10693, "verse_number": "3", "content_sanskrit": "क्षिप्रं हि मानुषे लोके सिद्धिर्भवति कर्मजा॥ ४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]