[{"id": 5000617000, "chapter_id": 9617, "verse_number": "७-८२-१", "content_sanskrit": "ऋषेर्वचनमाज्ञाय रामः सन्ध्यामुपासितुम् ।\nउपाक्रमत्सरः पुण्यमप्सरोगणसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000617001, "chapter_id": 9617, "verse_number": "७-८२-२", "content_sanskrit": "तत्रोदकमुपस्पृश्य सन्ध्यामन्वास्य पश्चिमाम् ।\nआश्रमं प्राविशद्रामः कुम्भयोनेर्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000617002, "chapter_id": 9617, "verse_number": "७-८२-३", "content_sanskrit": "तस्यागस्त्यो बहुगुणं कन्दमूलं तथौषधिम् ।\nशाल्यादीनि पवित्राणि भोजनार्थमकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000617003, "chapter_id": 9617, "verse_number": "७-८२-४", "content_sanskrit": "स भुक्तवान्नरश्रेष्ठस्तदन्नममृतोपमम् ।\nप्रीतश्च परितुष्टश्च तां रात्रिं समुपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000617004, "chapter_id": 9617, "verse_number": "७-८२-५", "content_sanskrit": "प्रभाते काल्यमुत्थाय कृत्वा ऽ ऽह्निकमरिन्दमः ।\nऋषिं समुपचक्राम गमनाय रघूत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000617005, "chapter_id": 9617, "verse_number": "७-८२-६", "content_sanskrit": "अभिवाद्याब्रवीद्रामो महर्षिं कुम्भसम्भवम् ।\nआपृच्छे स्वां पुरीं गन्तुं मामनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000617006, "chapter_id": 9617, "verse_number": "७-८२-७", "content_sanskrit": "धन्यो ऽस्म्यनुगृहीतो ऽस्मि दर्शनेन महात्मनः ।\nद्रष्टुं चैवागमिष्यामि पावनार्थमिहात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000617007, "chapter_id": 9617, "verse_number": "७-८२-८", "content_sanskrit": "तथा वदति काकुत्स्थे वाक्यमद्भुतदर्शनम् ।\nउवाच परमप्रीतो धर्मनेत्रस्तपोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000617008, "chapter_id": 9617, "verse_number": "७-८२-९", "content_sanskrit": "अत्यद्भुतमिदं वाक्यं तव राम शुभाक्षरम् ।\nपावनः सर्वभूतानां त्वमेव रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000617009, "chapter_id": 9617, "verse_number": "७-८२-१०", "content_sanskrit": "मुहूर्तमपि राम त्वां ये च पश्यन्ति केचन ।\nपाविताः स्वर्गभूताश्च पूज्यास्ते सर्वदैवतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000617010, "chapter_id": 9617, "verse_number": "७-८२-११", "content_sanskrit": "ये च त्वां घोरचक्षुर्भिः पश्यन्ति प्राणिनो भुवि ।\nहतास्ते यमदण्डेन सद्यो निरयगामिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000617011, "chapter_id": 9617, "verse_number": "७-८२-१२", "content_sanskrit": "ईदृशस्त्वं रघुश्रेष्ठ पावनः सर्वदेहिनाम् ।\nभुवि त्वां कथयन्तो ऽपि सिद्धिमेष्यन्ति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000617012, "chapter_id": 9617, "verse_number": "७-८२-१३", "content_sanskrit": "गच्छ चारिष्टमव्याग्रः पन्थानमकुतोभयम् ।\nप्रशाधि राज्यं धर्मेण गतिर्हि जगतो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000617013, "chapter_id": 9617, "verse_number": "७-८२-१४", "content_sanskrit": "एवमुक्तस्तु मुनिना प्राञ्जलिः प्रग्रहो नृपः ।\nअभ्यवादयत प्राज्ञस्तमृषिं पुण्यशालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000617014, "chapter_id": 9617, "verse_number": "७-८२-१५", "content_sanskrit": "अभिवाद्य मुनिश्रेष्ठं तांश्च सर्वांस्तपोधनान् ।\nअध्यारोहत्तदव्यग्रः पुष्पकं हेमभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000617015, "chapter_id": 9617, "verse_number": "७-८२-१६", "content_sanskrit": "तं प्रयान्तं मुनिगणा ह्याशीर्वादैः समन्ततः ।\nअपूजयन्महेन्द्राभं सहस्राक्षमिवामराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000617016, "chapter_id": 9617, "verse_number": "७-८२-१७", "content_sanskrit": "स्वस्थः स ददृशे रामः पुष्पके हेमभूषिते ।\nशशी मेघसमीपस्थो यथा जलधरागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000617017, "chapter_id": 9617, "verse_number": "७-८२-१८", "content_sanskrit": "ततो ऽर्धदिवसे प्राप्ते पूज्यमानस्ततस्ततः ।\nअयोध्यां प्राप्य काकुत्स्थो मध्यकक्ष्यामवारुहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000617018, "chapter_id": 9617, "verse_number": "७-८२-१९", "content_sanskrit": "ततो विसृज्य रुचिरं पुष्पकं कामगामि तत् ।\nविसर्जयित्वा गच्छेति स्वस्ति ते ऽस्त्विति च प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000617019, "chapter_id": 9617, "verse_number": "७-८२-२०", "content_sanskrit": "कक्षान्तरविनिक्षिप्तं द्वास्स्थं रामो ऽब्रवीद्वचः ।\nलक्ष्मणं भरतं चैव गत्वा तौ लघुविक्रमौ ॥\nममागमनमाख्याय शब्दापयत मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000617020, "chapter_id": 9617, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे व्द्यशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]