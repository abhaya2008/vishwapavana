[{"id": 2197017, "chapter_id": 5189, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197018, "chapter_id": 5189, "verse_number": "१", "content_sanskrit": "एवं दत्ताभयस्तेन ततोऽहमृषिसत्तमाः ।\nनष्टखेदश्रमभयः क्षणेन ह्यभवं तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197019, "chapter_id": 5189, "verse_number": "२", "content_sanskrit": "स शनैर्याति भगवान् गत्या लघुपराक्रमः ।\nअहं तु सुमहावेगमास्थायानुव्रजामि तम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197020, "chapter_id": 5189, "verse_number": "३", "content_sanskrit": "स गत्वा दीर्घमध्वानमाकाशममितद्युतिः ।\nमनसाऽप्यगमं देशमाससादात्मतत्त्ववित्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197021, "chapter_id": 5189, "verse_number": "४", "content_sanskrit": "अथ देवः समासाद्य मनसः सदृशं जवम् ।\nमोहयित्वा च मां तत्र क्षणेनान्तरधीयत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197022, "chapter_id": 5189, "verse_number": "५", "content_sanskrit": "तत्राम्बुधरधीरेण भोशब्देनानुनादिना ।\nअयं भोऽहमिति प्राह वाक्यं वाक्यविशारदः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197023, "chapter_id": 5189, "verse_number": "६", "content_sanskrit": "शब्दानुसारी तु ततस्तं देशमहमाव्रजम् ।\nतत्रापश्यं ततश्चाहं श्रीमद्धंसयुतं सरः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197024, "chapter_id": 5189, "verse_number": "७", "content_sanskrit": "स तत् सरः समासाद्य भगवानात्मवित्तमः ।\nभोशब्दप्रतिसृष्टेन स्वरेणाप्रतिवादिना\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197025, "chapter_id": 5189, "verse_number": "८", "content_sanskrit": "विवेश देवः स्वां योनिं मामिदं चाभ्यभाषत ।\nविशस्व सलिलं सौम्य सुखमत्र वसामहे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197026, "chapter_id": 5189, "verse_number": "९", "content_sanskrit": "ततश्च प्राविशं तत्र सह तेन महात्मना ।\nदृष्टवानद्भुततरं तस्मिन् सरसि भास्वताम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197027, "chapter_id": 5189, "verse_number": "१०", "content_sanskrit": "अग्नीनामप्रणीतानामिद्धानामिन्धनैर्विना ।\nदीप्तानामाज्यसिक्तानां प्राप्ताज्यानामिवाभवत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197028, "chapter_id": 5189, "verse_number": "११", "content_sanskrit": "दीप्तिस्तेषामनाज्यानां प्राप्ताज्यानामिवाभवत् ।\nअनिद्धानामिव सतामिद्धानामिव भास्वताम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197029, "chapter_id": 5189, "verse_number": "१२", "content_sanskrit": "अथाहं वरदं देवं नापश्यं तत्र सङ्गतम् ।\nततः सम्मोहमापन्नो विषादमगमं परम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197030, "chapter_id": 5189, "verse_number": "१३", "content_sanskrit": "अपश्यं चाग्निहोत्राणि शतशोऽथ सहस्रशः ।\nविधिना सम्प्रणीतानि धिष्ण्येष्वाज्यवतां तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197031, "chapter_id": 5189, "verse_number": "१४", "content_sanskrit": "असम्मृष्टतळांश्चैव वेदीः कुसुमसंस्तृताः ।\nकुशपद्मोत्पलासङ्गान् कलशांश्च हिरण्मयान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2197032, "chapter_id": 5189, "verse_number": "१५", "content_sanskrit": "अग्निहोत्राणि चित्राणि शतशोऽथ सहस्रशः ।\nअग्निहोत्रोपयुक्तानि यानि द्रव्याणि कानिचित् ।\nतानि चात्र समृद्धानि दृष्टवानस्म्यनेकशः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2197033, "chapter_id": 5189, "verse_number": "१६", "content_sanskrit": "मनोहृद्यतमश्चात्र सुरभिः पुण्यलक्षणः ।\nआज्यगन्धो मनोग्राही घ्राणचक्षुः सुखावहः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2197034, "chapter_id": 5189, "verse_number": "१७", "content_sanskrit": "तेषां तत्राग्निहोत्राणामीडितानां सहस्रशः ।\nसमीपे त्वद्भुततममपश्यमहमव्ययम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2197035, "chapter_id": 5189, "verse_number": "१८", "content_sanskrit": "चन्द्रांशुकाशशुभ्राणां तुषारोद्भेदवर्चसाम् ।\nविमलादित्यभासानां स्थण्डिलानि सहस्रशः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2197036, "chapter_id": 5189, "verse_number": "१९", "content_sanskrit": "दृष्टान्यग्निसमीपे तु द्युतिमन्ति महान्ति च ।\nएषु चाग्निसमीपेषु शुश्राव सुपदाक्षराः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2197037, "chapter_id": 5189, "verse_number": "२०", "content_sanskrit": "प्रभावान्तरितानां तु प्रस्पष्टाक्षरभाषिणाम् ।\nऋग्यजुःसामगानां च मधुराः सुस्वरा गिरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2197038, "chapter_id": 5189, "verse_number": "२१", "content_sanskrit": "सुसम्मृष्टतळैस्तैस्तु बृहद्भिर्दीप्ततेजसैः ।\nपावकैः पावितात्माऽहमभवं लघुविक्रमः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2197039, "chapter_id": 5189, "verse_number": "२२", "content_sanskrit": "ततोऽहं तेषु धिष्ण्येषु ज्वलमानेषु यज्वनाम् ।\nतं देशं प्रणमित्वाऽथ अन्वेष्टुमुपचक्रमे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2197040, "chapter_id": 5189, "verse_number": "२३", "content_sanskrit": "तान्यनेकसहस्राणि परीयंस्तु महाजवात् ।\nअपश्यमानस्तं देवं ततोऽहं व्यथितोऽभवम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2197041, "chapter_id": 5189, "verse_number": "२४", "content_sanskrit": "ततस्तेष्वग्निहोत्रेषु ज्वलत्सु विमलार्चिषु ।\nभानुमत्सु न पश्यामि देवदेवं सनातनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2197042, "chapter_id": 5189, "verse_number": "२५", "content_sanskrit": "ततोऽहं तानि दीप्तानि परीय व्यथितेन्द्रियः ।\nनान्तं तेषां प्रपश्यामि खेदश्च सहसाभवत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2197043, "chapter_id": 5189, "verse_number": "२६", "content_sanskrit": "विहृत्य सर्वतो दृष्टिं भयमोहसमन्वितः ।\nश्रमं परममापन्नश्चिन्तयामि विचेतनः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2197044, "chapter_id": 5189, "verse_number": "२७", "content_sanskrit": "तस्मिन्नु खलु वर्तामि लोके किं चैतदीदृशम् ।\nऋग्यजुःसामनिर्घोषः श्रूयते न च दृश्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2197045, "chapter_id": 5189, "verse_number": "२८", "content_sanskrit": "न च पश्यामि तं देवं येनाहमिह चोदितः ।\nएवं चिन्तासमापन्नः प्रध्यातुमुपचक्रमे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2197046, "chapter_id": 5189, "verse_number": "२९", "content_sanskrit": "ततश्चिन्तयतो मह्यं मोहेनाविष्टचेतसः ।\nमहान् शब्दः प्रादुरासीत् सुभृशं मेऽव्यथाकरः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2197047, "chapter_id": 5189, "verse_number": "३०", "content_sanskrit": "तथाऽहं सहसा तत्र शृणोमि विपुलध्वनिम् ।\nअपश्यं च सुपर्णानां सहस्राण्ययुतानि च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2197048, "chapter_id": 5189, "verse_number": "३१", "content_sanskrit": "अभ्यद्रवन्त मामेव विपुलद्युतिरंहसः ।\nतेषामहं प्रभावेण सर्वथैवावरोऽभवम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2197049, "chapter_id": 5189, "verse_number": "३२", "content_sanskrit": "सोऽहं समन्तात् तैः सर्वैः सुपर्णैरतितेजसैः ।\nदृष्ट्वाऽऽत्मानं परिगतं सम्भ्रमं परमं गतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2197050, "chapter_id": 5189, "verse_number": "३२", "content_sanskrit": "विनयावनतो भूत्वा नमश्चक्रे महात्मने ।\nअनादिनिधनायैभिर्नामभिः परमात्मने\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2197051, "chapter_id": 5189, "verse_number": "३३", "content_sanskrit": "नारायणाय शुद्धाय शाश्वताय ध्रुवाय च ।\nभूतभव्यभवेशाय शिवाय शिवमूर्तये\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2197052, "chapter_id": 5189, "verse_number": "३४", "content_sanskrit": "शिवयोनेः शिवाद्याय शिवपूज्यतमाय च ।\nघोररूपाय महते युगान्तकरणाय च\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2197053, "chapter_id": 5189, "verse_number": "३५", "content_sanskrit": "विश्वाय विश्वदेवाय विश्वेशाय महात्मने ।\nसहस्रोदरपादाय सहस्रनयनाय च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2197054, "chapter_id": 5189, "verse_number": "३६", "content_sanskrit": "सहस्रबाहवे चैव सहस्रवदनाय च ।\nशुचिश्रवाय महते ऋतुसंवत्सराय च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2197055, "chapter_id": 5189, "verse_number": "३७", "content_sanskrit": "ऋग्यजुस्सामवक्त्राय अथर्वशिरसे नमः।\nहृषीकेशाय कृष्णाय द्रुहिणोरुक्रमाय च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2197056, "chapter_id": 5189, "verse_number": "३८", "content_sanskrit": "ब्रह्मोद्रेकाय तार्क्ष्याय वराहायैकशृङ्गिणे ।\nशिपिविष्टाय सत्याय हरयेऽथ शिखण्डिने\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2197057, "chapter_id": 5189, "verse_number": "३९", "content_sanskrit": "हुतायोर्ध्वाय वक्त्राय रौद्रानीकाय साधवे ।\nसिन्धवे सिन्धवर्षघ्ने देवानां सिन्धवे नमः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2197058, "chapter_id": 5189, "verse_number": "४०", "content_sanskrit": "गरुत्मते त्रिनेत्राय सुधामाय वृषावृषे ।\nसम्राडुग्रे सङ्कृतये विरजे सम्भवे भवे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2197059, "chapter_id": 5189, "verse_number": "४१", "content_sanskrit": "वृषाय वृषरूपाय विभवे भूर्भुवाय च ।\nदीप्तसृष्टाय यज्ञाय स्थिराय स्थविराय च\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2197060, "chapter_id": 5189, "verse_number": "४२", "content_sanskrit": "अच्युताय तुषाराय वीराय च समाय च ।\nजिष्णवे पुरुहूताय वसिष्ठाय वराय च\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2197061, "chapter_id": 5189, "verse_number": "४३", "content_sanskrit": "सत्येशाय सुरेशाय हरयेऽथ शिखण्डिने ।\nबर्हिषाय वरेण्याय वसवे विश्ववेधसे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2197062, "chapter_id": 5189, "verse_number": "४४", "content_sanskrit": "किरीटिने सुकेशाय वासुदेवाय शुष्मिणे ।\nबृहदुग्ध्रे सुषेणाय युग्ये दुन्दुभये तथा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2197063, "chapter_id": 5189, "verse_number": "४५", "content_sanskrit": "भवे सखाय विभवे भरद्वाजाभयाय च ।\nभास्कराय च चन्द्राय पद्मनाभाय भूरिणे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2197064, "chapter_id": 5189, "verse_number": "४६", "content_sanskrit": "पुनर्वसुभृतत्वाय जीवप्रभविषयाय च ।\nवषट्काराय स्वाहायै स्वधाय निधनाय च\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2197065, "chapter_id": 5189, "verse_number": "४७", "content_sanskrit": "ऋचे च यजुषे साम्ने त्रैलोक्यपतये नमः ।\nश्रीपद्मायाजसदृशे धरणे धारणे परे\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2197066, "chapter_id": 5189, "verse_number": "४८", "content_sanskrit": "सौम्याय सौम्यरूपाय सौम्ये सुमनसे नमः ।\nविश्वाय च सुविश्वाय विश्वरूपधराय च\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2197067, "chapter_id": 5189, "verse_number": "४९", "content_sanskrit": "केशवाय सुकेशाय रश्मिकेशाय भूरिणे ।\nहिरण्यगर्भाय नमः सौम्याय वृषरूपिणे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2197068, "chapter_id": 5189, "verse_number": "५०", "content_sanskrit": "नारायणाग्रवपुषे पुरुहूताय वज्रिणे ।\nधर्मिणे वृषसेनाय धर्मसेनाय रोधसे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2197069, "chapter_id": 5189, "verse_number": "५१", "content_sanskrit": "मुनये ज्वरमुक्ताय ज्वराधिपतये नमः ।\nअनेत्राय त्रिनेत्राय पिङ्गलाय विधर्मिणे\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2197070, "chapter_id": 5189, "verse_number": "५२", "content_sanskrit": "तपोब्रह्मनिधानाय युगपर्यायिणे नमः ।\nशरणाय शरण्याय शक्तेष्टशरणाय च\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2197071, "chapter_id": 5189, "verse_number": "५३", "content_sanskrit": "नमः सर्वभवेशाय भूतभव्यभवाय च ।\nपाहि मां देवदेवेश कोऽप्यजोऽसि सनातन ।\nएवं गतोऽस्मि शरणं शरण्यं ब्रह्मयोनिनाम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2197072, "chapter_id": 5189, "verse_number": "५४", "content_sanskrit": "स्तव्यं स्तवं स्तुतवतः तत्तमो मे प्रणश्यत ।\nभयं च मे व्यपगतं पक्षिणोऽन्तर्हिता भवन् ।\nशृणोमि च गिरं दिव्यामन्तर्धानगतां शिवाम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2197073, "chapter_id": 5189, "verse_number": "", "content_sanskrit": "भगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2197074, "chapter_id": 5189, "verse_number": "५५", "content_sanskrit": "मा भैर्गरुत्मन् दान्तोऽसि पुनः सेन्द्रा दिवौकसः ।\nस्वं चैव भवनं गत्वा द्रक्ष्यसे पुत्रबान्धवान्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2197075, "chapter_id": 5189, "verse_number": "", "content_sanskrit": "सुपर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2197076, "chapter_id": 5189, "verse_number": "५६", "content_sanskrit": "ततस्तस्मिन् क्षणेनैव सहसैव महाद्युतिः ।\nप्रत्यदृश्यत तेजस्वी पुरस्तात् स ममान्तिके\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2197077, "chapter_id": 5189, "verse_number": "५७", "content_sanskrit": "समागम्य ततस्तेन शिवेन परमात्मना ।\nअपश्यं चाहमायान्तं नरनारायणाश्रमे ।\nचतुर्द्विगुणविन्यासं तं च देवं सनातनम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2197078, "chapter_id": 5189, "verse_number": "५८", "content_sanskrit": "यजतस्तानृषीन् देवान् वदतो ध्यायतो मुनीन् ।\nयुक्तान् सिद्धान् नैष्ठिकांश्च जपतो यजतो गृहीन्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2197079, "chapter_id": 5189, "verse_number": "५९", "content_sanskrit": "पुष्पपूरपरिक्षिप्तं धूपितं दीपितं हुतम् ।\nवन्दितं सिक्तसम्मृष्टं नरनारायणाश्रमम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2197080, "chapter_id": 5189, "verse_number": "६०", "content_sanskrit": "तदद्भुतमहं दृष्ट्वा विस्मितोऽस्मि तदाऽनघाः ।\nजगाम शिरसा देवं प्रयतेनान्तरात्मना\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2197081, "chapter_id": 5189, "verse_number": "६१", "content_sanskrit": "तदत्यद्भुतसङ्काशं किमेतदिति चिन्तयन् ।\nनाध्यगच्छं परं दिव्यं तस्य सर्वभवात्मनः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2197082, "chapter_id": 5189, "verse_number": "६२", "content_sanskrit": "प्रणिपत्य सुदुर्धर्षं पुनः पुनरुदीक्ष्य च ।\nशिरस्यञ्जलिमाधाय विस्मयोत्फुल्ललोचनः ।\nअवोचं तमदीनार्थं श्रेष्ठानां श्रेष्ठमुत्तमम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2197083, "chapter_id": 5189, "verse_number": "६३", "content_sanskrit": "नमस्ते भगवन् देव भूतभव्यभवत्प्रभो ।\nयदेतदद्भुतं देव मया दृष्टं त्वदाश्रयम् ।\nअनादिमध्यपर्यन्तं किं तच्छंसितुमर्हसि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2197084, "chapter_id": 5189, "verse_number": "६४", "content_sanskrit": "यदि जानासि मां भक्तं यदि वाऽनुग्रहो मयि ।\nशंस सर्वमशेषेण श्रोतव्यं यदि चेन्मया\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2197085, "chapter_id": 5189, "verse_number": "६५", "content_sanskrit": "स्वभावस्तव दुर्ज्ञेयः प्रादुर्भावो भवस्य च ।\nभवद्भूतभविष्येश सर्वथा गहनं भवान्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2197086, "chapter_id": 5189, "verse_number": "६६", "content_sanskrit": "ब्रूहि सर्वमशेषेण तदाश्चर्यं महामुने ।\nकिं तदत्यद्भुतं वृत्तं तेष्वग्निषु समन्ततः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2197087, "chapter_id": 5189, "verse_number": "६७", "content_sanskrit": "कानि तान्यग्निहोत्राणि केषां शब्दः श्रुतो मया ।\nशृण्वतां ब्रह्म सततमदृश्यानां महात्मनाम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2197088, "chapter_id": 5189, "verse_number": "६८", "content_sanskrit": "एतन्मे भगवन् कृष्ण ब्रूहि सर्वमशेषतः ।\nगृणन्त्यग्निसमीपेषु के च ते ब्रह्मराशयः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2197089, "chapter_id": 5189, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे श्रीनारायणस्तुतिर्नाम चत्वारिंशोऽध्यायः ॥४०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]