[{"id": 2067869, "chapter_id": 2427, "verse_number": "९-४५-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067870, "chapter_id": 2427, "verse_number": "९-४५-१", "content_sanskrit": "सरस्वत्याः प्रभावोऽयमुक्तस्ते द्विजसत्तम।\nकुमारस्याभिषेकं तु ब्रह्मन्नाख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067871, "chapter_id": 2427, "verse_number": "९-४५-२", "content_sanskrit": "यस्मिन्देशे च काले च यथा च वदतां वर।\nयैश्चाभिषिक्तो भगवान्विधिना येन च प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067872, "chapter_id": 2427, "verse_number": "९-४५-३", "content_sanskrit": "स्कन्दो यथा च दैत्यानामकरोत्कदनं महत्।\nतथा मे सर्वमाचक्ष्व परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067873, "chapter_id": 2427, "verse_number": "९-४५-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067874, "chapter_id": 2427, "verse_number": "९-४५-४", "content_sanskrit": "कुरुवंशस्य सदृशं कौतूहलमिदं तव।\nहर्षमुत्पादयत्वेव वचो मे जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067875, "chapter_id": 2427, "verse_number": "९-४५-५", "content_sanskrit": "हन्त ते कथयिष्यामि शृण्वानस्य नराधिप।\nअभिषेकं कुमारस्य प्रभावं च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067876, "chapter_id": 2427, "verse_number": "९-४५-६", "content_sanskrit": "तेजो माहेश्वरं स्कन्नमग्नौ प्रपतितं पुरा।\nतत्सर्वं भगवानग्निर्नाशकद्धर्तुमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067877, "chapter_id": 2427, "verse_number": "९-४५-७", "content_sanskrit": "तेन सीदति तेजस्वी दीप्तिमान्हव्यवाहनः।\nन चैवं धारयामास ब्रह्मणे उक्तवान्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067878, "chapter_id": 2427, "verse_number": "९-४५-८", "content_sanskrit": "स गङ्गामुपसगम्य नियोगाद्ब्रह्मणः प्रभुः।\nगर्भमाहितवान्दिव्यं भास्करोपमतेजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067879, "chapter_id": 2427, "verse_number": "९-४५-९", "content_sanskrit": "अथ गङ्गापि तं गर्भमसहन्ती विधारणे\nउत्ससर्ज गिरौ रम्ये हिमवत्यमरार्चिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067880, "chapter_id": 2427, "verse_number": "९-४५-१०", "content_sanskrit": "स तत्र ववृधे लोकानावृत्य ज्वलनात्मजः।\nददृशुर्ज्वलनाकारं तं गर्भमथ कृत्तिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067881, "chapter_id": 2427, "verse_number": "९-४५-११", "content_sanskrit": "शरस्तम्बे महात्मानमनलात्मजमीश्वरम्।\nममायमिति ताः सर्वाः पुत्रार्थिन्योऽभिचुक्रुशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067882, "chapter_id": 2427, "verse_number": "९-४५-१२", "content_sanskrit": "तासां विदित्वा भावं तं मातॄणां भगवान्प्रभुः।\nप्रस्नुतानां पयः षड्भिर्वदनैरपिबत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067883, "chapter_id": 2427, "verse_number": "९-४५-१३", "content_sanskrit": "तं प्रभावं समालक्ष्य तस्य बालस्य कृत्तिकाः।\nपरं विस्मयमापन्ना देव्यो दिव्यवपुर्धराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067884, "chapter_id": 2427, "verse_number": "९-४५-१४", "content_sanskrit": "यत्रोत्सृष्टश्च गर्भः स गङ्गया निरिमूर्धनि।\nस शैलः काञ्चनः सर्वः सम्बभौ मेरुवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067885, "chapter_id": 2427, "verse_number": "९-४५-१५", "content_sanskrit": "वर्धता चैव गर्भेण पृथिवी तेन रञ्जिता।\nअतश्च सर्वे संवृत्ता गिरयः काञ्चनात्मकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067886, "chapter_id": 2427, "verse_number": "९-४५-१६", "content_sanskrit": "कुमारः सुमहावीर्यः कार्तिकेय इति स्मृतः।\nगाङ्गेयः पूर्वमभवन्महाकायो बलान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067887, "chapter_id": 2427, "verse_number": "९-४५-१७", "content_sanskrit": "शमेन तपसा चैव वीर्येण च समन्वितः।\nववृधेऽतीव राजेन्द्र चन्द्रवत्प्रियदर्शनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067888, "chapter_id": 2427, "verse_number": "९-४५-१८", "content_sanskrit": "स तस्मिन्काञ्चने दिव्ये शरस्तम्बे श्रिया वृतः।\nस्तयमानः सदा शेते गन्धर्वैर्मुनिभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067889, "chapter_id": 2427, "verse_number": "९-४५-१९", "content_sanskrit": "तथैनमन्वनृत्यन्त देवकन्याः सहस्रशः।\nदिव्यवादित्रनृत्यज्ञाः स्तुवन्त्यश्चारुदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067890, "chapter_id": 2427, "verse_number": "९-४५-२०", "content_sanskrit": "अन्वयुश्चाग्नयः सर्वे गङ्गा च सरितां वरा।\nदधार पृथिवी चैनं बिभ्रती रूपमुत्तमम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067891, "chapter_id": 2427, "verse_number": "९-४५-२१", "content_sanskrit": "जातकर्मादिकास्तस्य क्रियाश्चक्रे बृहस्पतिः।\nवेदश्चैनं चतुर्मूर्तिरपतस्थे कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067892, "chapter_id": 2427, "verse_number": "९-४५-२२", "content_sanskrit": "धनुर्वेदश्चतुष्पादः सास्त्रग्रामः ससङ्ग्रहः।\nतत्रैनं समुपातिष्ठत्साक्षाद्वाणी च केवला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067893, "chapter_id": 2427, "verse_number": "९-४५-२३", "content_sanskrit": "स ददर्श महात्मानं देवदेवमुमापतिः।\nशैलपुत्र्या समागम्यभूतसङ्घशतैर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067894, "chapter_id": 2427, "verse_number": "९-४५-२४", "content_sanskrit": "निकाया भूतसङ्घानां परमाद्भुतदर्शनाः।\nविकृता विकृताकारा विकृताभरणध्वजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067895, "chapter_id": 2427, "verse_number": "९-४५-२५", "content_sanskrit": "व्याघ्रसिंहर्क्षवदना बिडालमकराननाः।\nवृषदंशमुखाश्चान्ये गजोष्ट्रवदनास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067896, "chapter_id": 2427, "verse_number": "९-४५-२६", "content_sanskrit": "उलूकवदनाः केचिद्गृध्रगोमायुदर्शनाः।\nक्रौञ्चपारावतनिभैर्वदनै राङ्कवैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067897, "chapter_id": 2427, "verse_number": "९-४५-२७", "content_sanskrit": "श्वाविच्छल्यकगोधानामजैडकगवां तथा।\nसदृशानि वपूंष्यन्ये तत्रतत्र व्यधारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067898, "chapter_id": 2427, "verse_number": "९-४५-२८", "content_sanskrit": "केचिच्छेलाम्बुदप्रख्याश्चक्रालातगदायुधाः।\nकेचिदञ्जनपुञ्जाभाः केचिच्छ्वेताचलप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067899, "chapter_id": 2427, "verse_number": "९-४५-२९", "content_sanskrit": "सप्तमातृगणाश्चैव समाजग्मुर्विशाम्पते।\nसाध्या विश्वेऽथ मरुतो वसवः पितरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067900, "chapter_id": 2427, "verse_number": "९-४५-३०", "content_sanskrit": "रुद्रादित्यास्तथा सिद्धा भुजगा दानवाः खगाः।\nब्रह्मा स्वयम्भूर्भगवान्सपुत्रः सहविष्णुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067901, "chapter_id": 2427, "verse_number": "९-४५-३१", "content_sanskrit": "शक्रस्तथाऽभ्ययाद्द्रष्टुं कुमारममितप्रभम्।\nनारदप्रमुखाश्चापि देवगन्धर्वसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067902, "chapter_id": 2427, "verse_number": "९-४५-३२", "content_sanskrit": "देवर्षयश्च सिद्धाश्च बृहस्पतिपुरोगमाः।\nपितरो जगतः श्रेष्ठा देवानामपि देवताः।\nतेऽपि तत्र समाजग्मुर्यामा धामाश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067903, "chapter_id": 2427, "verse_number": "९-४५-३३", "content_sanskrit": "स तु बालोऽपि बलवान्महायोगबलान्वितः।\nअभ्याजगाम देवेशं शूलहस्तं पिनाकिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067904, "chapter_id": 2427, "verse_number": "९-४५-३४", "content_sanskrit": "तमाव्रजन्तमालक्ष्य शिवस्यासीन्मनोगतम्।\nयुगपच्छैलपुत्र्याश्च गङ्गायाः पावकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067905, "chapter_id": 2427, "verse_number": "९-४५-३५", "content_sanskrit": "कं नु पूर्वमयं बालो गौरवादभ्युपैष्यति।\nअपि मामिति सर्वेषां तेषामासीन्मनोगतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067906, "chapter_id": 2427, "verse_number": "९-४५-३६", "content_sanskrit": "तेषामेतमभिप्रायं चतुर्णामुपलक्ष्य सः।\nयुगपद्योगमास्थाय ससर्ज विविधास्तनूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067907, "chapter_id": 2427, "verse_number": "९-४५-३७", "content_sanskrit": "ततोऽभवच्चतुर्मूर्तिः क्षणेन भगवान्प्रभुः।\nतस्य शाखो विशाखश्च नैगमेयश्च पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067908, "chapter_id": 2427, "verse_number": "९-४५-३८", "content_sanskrit": "एवं स कृत्वा ह्यात्मानं चतुर्धा भगवान्प्रभुः।\nयतो रुद्रस्ततः स्कन्दो जगामाद्भुतदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067909, "chapter_id": 2427, "verse_number": "९-४५-३९", "content_sanskrit": "विशाखस्तु ययौ देवीं ततो गिरिवरात्मजाम्।\nशाखो ययौ स भगवान्दिव्यमूर्तिर्विभावसुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067910, "chapter_id": 2427, "verse_number": "९-४५-४०", "content_sanskrit": "नैगमेयोऽगमद्गङ्गां कुमारः पावकप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067911, "chapter_id": 2427, "verse_number": "९-४५-४१", "content_sanskrit": "सर्वे भासुरदेहास्ते चत्वारः समरूपिणः।\nतान्समभ्ययुरव्यग्रास्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067912, "chapter_id": 2427, "verse_number": "९-४५-४२", "content_sanskrit": "हाहाकारो महानासीद्देवदानवरक्षसाम्।\nतद्दृष्ट्वा महदाश्चर्यमद्भुतं रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067913, "chapter_id": 2427, "verse_number": "९-४५-४३", "content_sanskrit": "ततो रुद्रश्च देवी च पावकश्च पितामहम्।\nगङ्गया सहिताः सर्वे प्रणिपेतुर्जगत्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067914, "chapter_id": 2427, "verse_number": "९-४५-४४", "content_sanskrit": "प्रणिपत्य ततस्ते तु विधिवद्राजपुङ्गव।\nइदमूचुर्वचो राजन्कार्तिकेयप्रियेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067915, "chapter_id": 2427, "verse_number": "९-४५-४५", "content_sanskrit": "अस्य बालस्य भगवन्नाधिपत्य यथेप्सितम्।\nअस्मत्प्रियार्थं देवेश सदृशं दातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067916, "chapter_id": 2427, "verse_number": "९-४५-४६", "content_sanskrit": "ततः स भगवान्धीमान्सर्वलोकपितामहः।\nमनसा चिन्तयामास किमयं लभतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2067917, "chapter_id": 2427, "verse_number": "९-४५-४७", "content_sanskrit": "ऐश्वर्याणि च सर्वाणि देवगन्धर्वरक्षसाम्।\nभूतयक्षविहङ्गानां पन्नगानां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2067918, "chapter_id": 2427, "verse_number": "९-४५-४८", "content_sanskrit": "सर्वमेवादिदेशासौ कौरवेय महात्मनः।\nसमर्थं च तमैश्वर्ये महामतिरमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2067919, "chapter_id": 2427, "verse_number": "९-४५-४९", "content_sanskrit": "ततो मुहूर्तं स ध्यात्वा देवानां स्रेयसि स्थितः।\nसैनापत्यं ददौ तस्मै सर्व भूतेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2067920, "chapter_id": 2427, "verse_number": "९-४५-५०", "content_sanskrit": "सर्वदेवनिकायानां ये राजानः परिश्रुताः।\nतान्सर्वान्व्यादिदेशास्मै सर्वभूतपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2067921, "chapter_id": 2427, "verse_number": "९-४५-५१", "content_sanskrit": "ततः कुमारमादाय देवा ब्रह्मपुरोगमाः।\nअभिषेकार्थमाजग्मुः शैलेन्द्रं सहितास्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2067922, "chapter_id": 2427, "verse_number": "९-४५-५२", "content_sanskrit": "पुण्यां हैमवतीं देवीं सरिच्छ्रेष्ठां सरस्वतीम्।\nसमन्तपञ्चके या वै त्रिषु लोकेषु विश्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2067923, "chapter_id": 2427, "verse_number": "९-४५-५३", "content_sanskrit": "तत्र तीरे सरस्वत्याः पुण्ये सर्वगुणान्विते।\nनिषेदुर्देवगन्धर्वाः सर्वे सम्पूर्णमानसाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2067924, "chapter_id": 2427, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि पञ्चचत्वारिंशोऽध्यायः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]