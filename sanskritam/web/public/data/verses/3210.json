[{"id": 2102273, "chapter_id": 3210, "verse_number": "१४-६६-१", "content_sanskrit": "वैशम्पायन उवाच।\nएतस्मिन्नेव काले तु वासुदेवोऽपि वीर्यवान्।\nउपायाद्वृष्णिभिः सार्दं पुरं वारणसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102274, "chapter_id": 3210, "verse_number": "१४-६६-२", "content_sanskrit": "समयं वाजिमेधस्य विदित्वा पुरुषर्षभः।\nयथोक्तो धर्मपुत्रेण प्रव्रजन्स्वपुरीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102275, "chapter_id": 3210, "verse_number": "१४-६६-३", "content_sanskrit": "रौक्मिणेयेन सहितो युयुधानेन चैव ह।\nचारुदेष्णेन सांबेनि गदेन कृतवर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102276, "chapter_id": 3210, "verse_number": "१४-६६-४", "content_sanskrit": "सारणेन च वीरेण निशठेनोन्मुखेन च।\nबलदेवं पुरस्कृत्य सुभद्रासहितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102277, "chapter_id": 3210, "verse_number": "१४-६६-५", "content_sanskrit": "द्रौपदीमुत्तरां चैव पृथां चाप्यवलोककः।\nसमाश्वासयितुं चापि क्षत्रिया निहतेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102278, "chapter_id": 3210, "verse_number": "१४-६६-६", "content_sanskrit": "तानागतान्समीक्ष्यैव धृतराष्ट्रो महीपतिः।\nप्रत्यगृह्णाद्यथान्यायं विदुरश्च महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102279, "chapter_id": 3210, "verse_number": "१४-६६-७", "content_sanskrit": "तत्रैव न्यवसत्कृष्णः स्वर्चितः पुरुषोत्तमः।\nविदुरेणि महातेजास्तथैव च युयुत्सुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102280, "chapter_id": 3210, "verse_number": "१४-६६-८", "content_sanskrit": "वसत्सु वृष्णिवीरेषु तत्राथ जनमेजय।\nजज्ञे तव पिता राजन्परिक्षित्परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102281, "chapter_id": 3210, "verse_number": "१४-६६-९", "content_sanskrit": "स तु राजा महाराज ब्रह्मास्त्रेणावपीडितः।\nशवो बभूव निश्चेष्टो हर्षशोकविवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102282, "chapter_id": 3210, "verse_number": "१४-६६-१०", "content_sanskrit": "हृष्टानां सिंहनादेन जनानां तत्र निःस्वनः।\nआविवश दिशःसर्वाः पुनरेवाभ्युपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102283, "chapter_id": 3210, "verse_number": "१४-६६-११", "content_sanskrit": "ततः सोतित्वरः कृष्णो विवेशान्तःपुरं तदा।\nयुयुधानद्वितीयो वै व्यथितेन्द्रियमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102284, "chapter_id": 3210, "verse_number": "१४-६६-१२", "content_sanskrit": "ततस्त्वरितमायान्तीं ददर्शं स्वां पितृष्वसाम्।\nक्रोशन्तीमभिधावेति वासुदेवं पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102285, "chapter_id": 3210, "verse_number": "१४-६६-१३", "content_sanskrit": "पृष्ठतो द्रौपदीं चैव सुभद्रां च यशस्विनीम्।\nविक्रोशन्त्यश्च करुणं पाण्डवानां स्त्रियो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102286, "chapter_id": 3210, "verse_number": "१४-६६-१४", "content_sanskrit": "ततः कृष्णं समासाद्य कुन्ती भोजसुता तदा।\nप्रोवाच राजशार्दूल बाष्पगद्गदया गिरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102287, "chapter_id": 3210, "verse_number": "१४-६६-१५", "content_sanskrit": "वासुदेव महाबाहो सुप्रजा देवकी त्वया।\nत्वं नो गतिः प्रतिष्ठा च त्वदायत्तमिदं कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102288, "chapter_id": 3210, "verse_number": "१४-६६-१६", "content_sanskrit": "यदुप्रवीर योऽयं ते स्वस्त्रीयस्यात्मजः प्रभो।\nअश्वत्थाम्ना हतो जातस्तमुज्जीवय केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102289, "chapter_id": 3210, "verse_number": "१४-६६-१७", "content_sanskrit": "त्वया ह्येतत्प्रतिज्ञातमैषीके यदुनन्दन।\nअहं संजीवयिष्यामि मृतं जातमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102290, "chapter_id": 3210, "verse_number": "१४-६६-१८", "content_sanskrit": "सोयं जातो मृतस्तात पश्यैनं पुरुषर्षभ।\nउत्तरां च सुभद्रां च द्रौपदीं मां च माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102291, "chapter_id": 3210, "verse_number": "१४-६६-१९", "content_sanskrit": "धर्मपुत्रं च भीमं च फल्गुनं नकुलं तथा।\nसहदेवं च दुर्धर्षं सर्वान्नस्त्रातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102292, "chapter_id": 3210, "verse_number": "१४-६६-२०", "content_sanskrit": "अस्मिन्प्राणाः समायत्ताः पाण्डवानां ममैव च।\nपाण्डोश्च पिण्डो दाशार्ह तथैव श्वशुरस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102293, "chapter_id": 3210, "verse_number": "१४-६६-२१", "content_sanskrit": "अभिमन्योश्च भद्रं ते प्रियस्य सदृशस्य च।\nप्रियमुत्पादयाद्य त्वं प्रेतस्यापि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102294, "chapter_id": 3210, "verse_number": "१४-६६-२२", "content_sanskrit": "उत्तरा हि पुरोक्तं वै कथयत्यरिसूदन।\nअभिमन्योर्वचः कृष्ण प्रियत्वात्तन्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102295, "chapter_id": 3210, "verse_number": "१४-६६-२३", "content_sanskrit": "अब्रवीत्किल दाशार्ह वैराटीमार्जुनिस्तदा।\nमातुलस्य कुलं भद्रे तव पुत्रो गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102296, "chapter_id": 3210, "verse_number": "१४-६६-२४", "content_sanskrit": "गत्वा वृष्णयन्धककुलं धनुर्वेदं ग्रहीष्यति।\nअस्त्राणि च विचित्राणि नितीशास्त्रं च केवलं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102297, "chapter_id": 3210, "verse_number": "१४-६६-२५", "content_sanskrit": "इत्येतत्प्रणयात्तात सौभद्रः परवीरहा।\nकथयामास दुर्धर्षस्तथा चैतन्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102298, "chapter_id": 3210, "verse_number": "१४-६६-२६", "content_sanskrit": "तास्त्वां वयं प्रणम्येह याचामो मधुसूदन।\nकुलस्यास्य हितार्तं च कुरु कल्याणमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102299, "chapter_id": 3210, "verse_number": "१४-६६-२७", "content_sanskrit": "एवमुक्त्वा तु वार्ष्णेयं पृथा पृथुललोचना।\nउद्धृत्य बाहू दुःखार्ता ताश्चान्याः प्रापतन्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102300, "chapter_id": 3210, "verse_number": "१४-६६-२८", "content_sanskrit": "अब्रुवंश्च महाराज सर्वाः सास्राविलेक्षणाः।\nस्वस्त्रीयो वासुदेवस्य मृतो जात इति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102301, "chapter_id": 3210, "verse_number": "१४-६६-२९", "content_sanskrit": "एवं गते ततः कुन्तीं पर्यगृह्णाज्जनार्दनः।\nभूमौ निपतितां चैनां सान्त्वयामास भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102302, "chapter_id": 3210, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि षट्षष्टितमोऽध्यायः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]