[{"id": 2071609, "chapter_id": 2510, "verse_number": "१२-१५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071610, "chapter_id": 2510, "verse_number": "१२-१५-१", "content_sanskrit": "याज्ञसेन्या वचः श्रुत्वा पुनरेवार्जुनोऽब्रवीत्।\nअनुमान्य महाबाहुं ज्येष्ठं भ्रातरमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071611, "chapter_id": 2510, "verse_number": "१२-१५-२x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071612, "chapter_id": 2510, "verse_number": "१२-१५-२", "content_sanskrit": "दण्डः शास्ति प्रजाः सर्वा दण्ड एवाभिरक्षति।\nदण़्डः सुप्तेषु जागर्ति दण्डं धर्मं विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071613, "chapter_id": 2510, "verse_number": "१२-१५-३", "content_sanskrit": "दण्डः संरक्षते धर्मं तथैवार्यं जनाधिप।\nकामं संरक्षते दण्डस्त्रिवर्गो दण्ड उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071614, "chapter_id": 2510, "verse_number": "१२-१५-४", "content_sanskrit": "दण्डेन रक्ष्यते धान्यं धनं दण्डेन रक्ष्यते।\nएतद्विद्वानुपादाय स्वभावं पश्य लौकिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071615, "chapter_id": 2510, "verse_number": "१२-१५-५", "content_sanskrit": "राजदण्डभयादेके नराः पापं न कुर्वते।\nयमदण्डभयादेके परलोकभयादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071616, "chapter_id": 2510, "verse_number": "१२-१५-६", "content_sanskrit": "परस्परभयादेके पापाः पापं न कुर्वते।\nएवं सांसिद्धिके लोके सर्वं दण्डे प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071617, "chapter_id": 2510, "verse_number": "१२-१५-७", "content_sanskrit": "दण्डस्यैव भयादेके न खादन्ति परस्परम्।\nअन्धेतमसि मज्जेयुर्यदि दण्डो न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071618, "chapter_id": 2510, "verse_number": "१२-१५-८", "content_sanskrit": "यस्माददान्तान्दमयत्यशिष्टान्दण्डयत्यपि।\nदमनाद्दण्डनाच्चैव तस्माद्दण्डं विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071619, "chapter_id": 2510, "verse_number": "१२-१५-९", "content_sanskrit": "वाचि दण्डो ब्राह्मणानां क्षत्रियाणां भुजार्पणम्।\nधनदण्डाः स्मृता वैश्या निर्दण्डः शूद्र उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071620, "chapter_id": 2510, "verse_number": "१२-१५-१०", "content_sanskrit": "असंमोहाय मर्त्यानामर्थसंरक्षणाय च।\nमर्यादा स्थापिता लोके दण्डसंज्ञा विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071621, "chapter_id": 2510, "verse_number": "१२-१५-११", "content_sanskrit": "यत्र श्यामो लोहिताक्षो दण्डश्चरति सूद्यतः।\nप्रजास्तत्र न मुह्यन्ति नेता चेत्साधु पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071622, "chapter_id": 2510, "verse_number": "१२-१५-१२", "content_sanskrit": "ब्रह्मचारी गृहस्थश्च वानप्रस्थस्च भिक्षुकः।\nदण्डस्यैव भयादेते मनुष्या वर्त्मनि स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071623, "chapter_id": 2510, "verse_number": "१२-१५-१३", "content_sanskrit": "नाभीतो यजते राजन्नाभीतो दातुमिच्छति।\nनाभीतः पुरुषः कश्चित्समये स्थातुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071624, "chapter_id": 2510, "verse_number": "१२-१५-१४", "content_sanskrit": "नाच्छित्त्वा परमर्माणि नाकृत्वा कर्म दुष्करम्।\nनाहत्वा मत्स्यघातीव प्राप्नोति महतीं श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071625, "chapter_id": 2510, "verse_number": "१२-१५-१५", "content_sanskrit": "नाघ्नतः कीर्तिरस्तीह न वित्तं न पुनः प्रजाः।\nइन्द्रो वृत्रवधेनैव महेन्द्रः समपद्यत।\n`माहेन्द्रं च गृहं लेभे लोकानां चेश्वरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071626, "chapter_id": 2510, "verse_number": "१२-१५-१६", "content_sanskrit": "य एव देवा हन्तारस्ताँल्लोकोऽर्चयते भृशम्।\nहन्तारुद्रस्तथास्कन्दः शक्रोऽग्निर्वरुणो यमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071627, "chapter_id": 2510, "verse_number": "१२-१५-१७", "content_sanskrit": "हन्ता कालस्तथा वायुर्मृत्युर्वैश्रवणो रविः।\nवसवो मरुतः साध्या विश्वेदेवाश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071628, "chapter_id": 2510, "verse_number": "१२-१५-१८", "content_sanskrit": "एतान्देवान्नमस्यन्ति प्रतापप्रणता जनाः।\nन ब्रह्माणं न धातारं न पूषाणं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071629, "chapter_id": 2510, "verse_number": "१२-१५-१९", "content_sanskrit": "मध्यस्थान्सर्वभूतेषु दान्ताञ्शमपरायणान्।\nयजन्ते मानवाः केचित्प्रशान्तान्सर्वकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071630, "chapter_id": 2510, "verse_number": "१२-१५-२०", "content_sanskrit": "न हि पश्यामि जीवन्तं लोके कंचिदर्हिसया।\nसत्वैः सत्वा हि जीवन्ति दुर्बलैर्बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071631, "chapter_id": 2510, "verse_number": "१२-१५-२१", "content_sanskrit": "नकुलो मूषिकानत्ति बिडालो नकुलं तथा।\nबिडालमत्ति श्वा राजञ्श्वानं व्यालमृगस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071632, "chapter_id": 2510, "verse_number": "१२-१५-२२", "content_sanskrit": "तानत्ति पुरुषः सर्वान्पश्य धर्मो यथा गतः।\nप्राणस्यान्नमिदं सर्वं जङ्गमं स्थावरं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071633, "chapter_id": 2510, "verse_number": "१२-१५-२३", "content_sanskrit": "विधानं दैवविहितं तत्र विद्वान्न मुह्यति।\nयथा सृष्टोऽसि राजेन्द्र तथा भवितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071634, "chapter_id": 2510, "verse_number": "१२-१५-२४", "content_sanskrit": "विनीतक्रोधहर्षा हि मन्दा वनमुपाश्रिताः।\nविना वधं न कुर्वन्ति तापसाः प्राणयापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071635, "chapter_id": 2510, "verse_number": "१२-१५-२५", "content_sanskrit": "उदके बहवः प्राणाः पृथिव्यां च फलेषु च।\nन च कश्चिन्न तान्हन्ति किमन्यत्प्राणयापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071636, "chapter_id": 2510, "verse_number": "१२-१५-२६", "content_sanskrit": "सूक्ष्मयोनीनि भूतानि तर्कगम्यानि कानिचित्।\nपक्ष्मणोऽपि निपातेन येषां स्यात्स्कन्धपर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071637, "chapter_id": 2510, "verse_number": "१२-१५-२७", "content_sanskrit": "ग्रामान्निष्क्रम्य मुनयो विगतक्रोधमत्सराः।\nवने कुटुम्बधर्माणो दृश्यन्ते परिमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071638, "chapter_id": 2510, "verse_number": "१२-१५-२८", "content_sanskrit": "भूमिं भित्त्वौषधीश्छित्त्वा वृक्षादीनण्डजान्पशून्।\nमनुष्यास्तन्वये यज्ञांस्ते स्वर्गं प्राप्नुवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2071639, "chapter_id": 2510, "verse_number": "१२-१५-२९", "content_sanskrit": "दण्डनीत्यां प्रणीतायां सर्वे सिध्यन्त्युपक्रमाः।\nकौन्तेय सर्वभूतानां तत्र मे नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2071640, "chapter_id": 2510, "verse_number": "१२-१५-३०", "content_sanskrit": "दण्डश्चेन्न भवेल्लोके विनश्येयुरिमाः प्रजाः।\nजले मत्स्यानिवाभक्ष्यन्दुर्बलान्बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2071641, "chapter_id": 2510, "verse_number": "१२-१५-३१", "content_sanskrit": "सत्यं बतेदं ब्रह्मणा पूर्वमुक्तं दण्डः प्रजा रक्षति साधुनीतः।\nपश्याग्नयः पूतिमांसस्य भीताः सन्तर्जिता दण्डभयाज्ज्वलन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2071642, "chapter_id": 2510, "verse_number": "१२-१५-३२", "content_sanskrit": "अन्धंतम इवेदं स्यान्न प्रज्ञायेत किंचन।\nदण्डश्चेन्न भवेल्लोके विभजन्साध्वसाधुनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2071643, "chapter_id": 2510, "verse_number": "१२-१५-३३", "content_sanskrit": "येऽपि संभिन्नमर्यादा नास्तिका वेदनिन्दकाः।\nतेऽपि भोगाय कल्पन्ते दण्डेनाशु निपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2071644, "chapter_id": 2510, "verse_number": "१२-१५-३४", "content_sanskrit": "सर्वो दण्डजितो लोको दुर्लभो हि शुचिर्जनः।\nदण्डस्य हि भयाद्भीतो भोगायैव प्रकल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2071645, "chapter_id": 2510, "verse_number": "१२-१५-३५", "content_sanskrit": "चातुर्वर्ण्यप्रमोदाय सुनीतिकरणाय च।\nदण्डो विधात्रा विहितो धर्मार्थौं भुवि रक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2071646, "chapter_id": 2510, "verse_number": "१२-१५-३६", "content_sanskrit": "यदि दण्डान्न विभ्येयुर्वयांसि श्वापदानि च।\nअद्युः पशून्मनुष्यांश्च यज्ञार्थानि हवींषि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2071647, "chapter_id": 2510, "verse_number": "१२-१५-३७", "content_sanskrit": "न ब्रह्मचार्यधीयीत न काल्यं दुहते च गौः।\nन कन्योद्वहनं गच्छेद्यदि दण्डो न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2071648, "chapter_id": 2510, "verse_number": "१२-१५-३८", "content_sanskrit": "विष्वग्लोपः प्रवर्तेत भिद्येरन्सर्वसेतवः।\nममत्वं न प्रजानीयुर्यदि दण्डो न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2071649, "chapter_id": 2510, "verse_number": "१२-१५-३९", "content_sanskrit": "न संवत्सरसत्राणि तिष्ठेयुरकुतोभयाः।\nविधिवद्दक्षिणावन्ति यदि दण्डो न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2071650, "chapter_id": 2510, "verse_number": "१२-१५-४०", "content_sanskrit": "चरेयुर्नाश्रमे धर्मं यथोक्तं विधिमाश्रिताः।\nन विद्यां प्राप्नुयात्कश्चिद्यदि दण्डो न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2071651, "chapter_id": 2510, "verse_number": "१२-१५-४१", "content_sanskrit": "न चोष्ट्रा न बलीवर्दा नाश्वाश्वतरगर्दभाः।\nन विद्यां प्राप्नुर्यानानि यदि दण्डो न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2071652, "chapter_id": 2510, "verse_number": "१२-१५-४२", "content_sanskrit": "न प्रेष्या वचनं कुर्युर्न बालो जातु कर्हिचित्।\nतिष्ठेत्पितुर्मते धर्मे यदि दण्डो न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2071653, "chapter_id": 2510, "verse_number": "१२-१५-४३", "content_sanskrit": "दण्डे स्थिताः प्रजाः सर्वा भयं दण्डे विदुर्बुधाः।\nदण्डे स्वर्गो मनुष्याणां लोकोऽयं च प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2071654, "chapter_id": 2510, "verse_number": "१२-१५-४४", "content_sanskrit": "न तत्र कूटं पापं वा वञ्चना वाऽपि दृश्यते।\nयत्र दण्डः सुविहितश्चरत्यरिविनाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2071655, "chapter_id": 2510, "verse_number": "१२-१५-४५", "content_sanskrit": "हविः श्वा प्रलिहेद्दृष्ट्वा दण्डश्चेन्नोद्यतो भवेत्।\nहरेत्काकः पुरोडाशं यदि दण्डो न पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2071656, "chapter_id": 2510, "verse_number": "१२-१५-४६", "content_sanskrit": "यदीदं धर्मतो राज्यं विहितं यद्यधर्मतः।\nकार्यस्तत्र न शोको वै भुङ्क्ष्व भोगान्यजस्व च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2071657, "chapter_id": 2510, "verse_number": "१२-१५-४७", "content_sanskrit": "सुखेन धर्मं श्रीमन्तश्चरन्ति शुचिवाससः।\nसंवसन्तः प्रियैर्दारैर्भुञ्जानाश्चान्नमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2071658, "chapter_id": 2510, "verse_number": "१२-१५-४८", "content_sanskrit": "अर्थे सर्वे समारम्भाः समायत्ता न संशयः।\nस च दण्डे समायत्तः पश्य दण्डस्य गौस्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2071659, "chapter_id": 2510, "verse_number": "१२-१५-४९", "content_sanskrit": "लोकयात्रार्थमेवेह धर्मप्रवचनं कृतम्।\nअहिंसाऽसाधुहिंसेति श्रेयान्धर्मपरिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2071660, "chapter_id": 2510, "verse_number": "१२-१५-५०", "content_sanskrit": "नात्यन्तं गुणवत्किंचिन्न चाप्यत्यन्तनिर्गुणम्।\nउभयं सर्वकार्येषु दृश्यते साध्वसाधु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2071661, "chapter_id": 2510, "verse_number": "१२-१५-५१", "content_sanskrit": "पशूनां वृषणं छित्त्वा ततो भिन्दन्ति नस्सु तान्।\nवहन्ति बहवो भारान्बध्नन्ति दमयन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2071662, "chapter_id": 2510, "verse_number": "१२-१५-५२", "content_sanskrit": "एवं पर्याकुले लोके वितथैर्जर्झरीकृते।\nतैस्तैर्न्यायैर्महाराज पुराणं धर्ममाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2071663, "chapter_id": 2510, "verse_number": "१२-१५-५३", "content_sanskrit": "यज देहि प्रजा रक्ष धर्मं समनुपालय।\nअमित्राञ्जहि कौन्तेय मित्राणि परिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2071664, "chapter_id": 2510, "verse_number": "१२-१५-५४", "content_sanskrit": "मा च ते निघ्नतः शत्रून्मन्युर्भवतु पार्थिव।\nन तत्र किल्विषं किंचिद्धन्तुर्भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2071665, "chapter_id": 2510, "verse_number": "१२-१५-५५", "content_sanskrit": "आततायी हि यो हन्यादाततायिनमागतम्।\nन तेन भ्रूणहा स स्यान्मन्युस्तं मन्युमार्च्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2071666, "chapter_id": 2510, "verse_number": "१२-१५-५६", "content_sanskrit": "अवध्यः सर्वभूतानामन्तरात्मा न संशयः।\nअवध्ये चात्मनि कथं वध्यो भवति कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2071667, "chapter_id": 2510, "verse_number": "१२-१५-५७", "content_sanskrit": "यथा हि पुरुषः शालां पुनः संप्रविशेन्नवाम्।\nएव जीवः शरीराणि तानितानि प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2071668, "chapter_id": 2510, "verse_number": "१२-१५-५८", "content_sanskrit": "देहान्पुराणानुत्सृज्य नवान्संप्रतिपद्यते।\nएवं मृत्युमुखं प्राहुर्जना ये तत्त्वदर्शिनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2071669, "chapter_id": 2510, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चदशोऽध्यायः॥ १५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]