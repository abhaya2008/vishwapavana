[{"id": 7003777000, "chapter_id": 23777, "verse_number": "२-२-२१-१", "content_sanskrit": "जैमिनिरुवाच ।\nइति ब्रुवाणं राजर्षिं कश्चिदृग्वेदपारगः ।\nवेदांतविज्ज्ञानशीलो द्विजो वाक्यं मुदा जगौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003777001, "chapter_id": 23777, "verse_number": "२-२-२१-२", "content_sanskrit": "अहो तवायं खलु भाग्यराशिर्येनाविरासीद्भुवि दारुमूर्तिः ।\nयस्यात्युपास्तिं श्रुतिराह मुक्तिप्रदामनात्मज्ञविमोहितानाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003777002, "chapter_id": 23777, "verse_number": "२-२-२१-३", "content_sanskrit": "य एष प्लवते दारुः सिंधोः पारे ह्यपौरुषम् ।\nतमुपास्य दुराराध्यं मुक्तिं यांति सुदुर्लभाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003777003, "chapter_id": 23777, "verse_number": "२-२-२१-४", "content_sanskrit": "ब्रह्मज्ञाननिधिः साक्षान्नारदः प्रत्युवाच यत् ।\nन हि वेदांतवचसोऽपरस्माज्ज्ञानमस्य वै ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003777004, "chapter_id": 23777, "verse_number": "२-२-२१-५", "content_sanskrit": "न हि प्रवृत्तिर्विष्णोस्तु विना वेदं प्रवर्तते ।\nपरेषां स्वस्य वा सृष्टौ श्रुतिप्रामाण्यवान्प्रभुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003777005, "chapter_id": 23777, "verse_number": "२-२-२१-६", "content_sanskrit": "विना श्रुतिं प्रवर्तेच्चेत्कस्तत्प्रामाण्यमृच्छति ।\nतस्माच्छ्रुतिप्रसिद्धोऽयमवतारोऽत्र भूपते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003777006, "chapter_id": 23777, "verse_number": "२-२-२१-७", "content_sanskrit": "वेदांतवेद्यं पुरुषं गीतं तं सामगीतिषु ।\nप्रतिमां न तु जानीहि निःश्रेयसकरं नृणाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003777007, "chapter_id": 23777, "verse_number": "२-२-२१-८", "content_sanskrit": "दर्शनादेव नः शांतं सुदृढं तम उत्तमम् ।\nसंत्येव श्रुतयः पूर्वमेतदर्चाप्रकाशिकाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003777008, "chapter_id": 23777, "verse_number": "२-२-२१-९", "content_sanskrit": "एतदर्चा प्रशस्ता वै सदर्थे विनियोजिता ।\nअहो भारतवर्षस्था मनुष्याः क्षीणकल्मषाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003777009, "chapter_id": 23777, "verse_number": "२-२-२१-१०", "content_sanskrit": "अपवर्गप्रदो येषामाविरासीज्जनार्दनः ।\nतत्राप्ययं चोढ्रदेशः सर्वेषामुत्तमोत्तमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003777010, "chapter_id": 23777, "verse_number": "२-२-२१-११", "content_sanskrit": "यत्रस्थाश्चर्मनेत्रेण पश्यंति ब्रह्मरूपिणम् ।\nश्रुतिस्मृतीनां गहनः पंथा कर्मभिराकुलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003777011, "chapter_id": 23777, "verse_number": "२-२-२१-१२", "content_sanskrit": "येन याता भ्रमंतीह घटीयंत्रवदाकुलाः ।\nनिर्व्यलीकपदप्राप्तिहेतुरेष स चिन्मयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003777012, "chapter_id": 23777, "verse_number": "२-२-२१-१३", "content_sanskrit": "श्रुत्यादिभिर्विनोपायैः परमानंदमुक्तिदः ।\nनिरंतरगतायातदुःस्थितानां दुरात्मनाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003777013, "chapter_id": 23777, "verse_number": "२-२-२१-१४", "content_sanskrit": "एष दारुवपुर्विष्णुः सुखदाता सुबांधवः ।\nश्रुतिस्मृत्युक्तनियमा वर्तंते नेह पार्थिव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003777014, "chapter_id": 23777, "verse_number": "२-२-२१-१५", "content_sanskrit": "यथा तथा दृष्टिपथमाचांडालाद्विमुक्तिदः ।\nअभक्तश्चेदमुं पश्येद्गतानुगतिको नरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003777015, "chapter_id": 23777, "verse_number": "२-२-२१-१६", "content_sanskrit": "अश्वमेधसहस्राणां फलं ह्यविकलं लभेत् ।\nभजेच्चेन्नियमस्थो हि भक्तिमान्दृढमानसः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003777016, "chapter_id": 23777, "verse_number": "२-२-२१-१७", "content_sanskrit": "असंशयं स सायुज्यं ब्रह्मणा लभते नरः ।\nक्व दुःखायासबहुलमनायासविनश्वरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003777017, "chapter_id": 23777, "verse_number": "२-२-२१-१८", "content_sanskrit": "अचिरस्थं क्षुद्रफलं पुनरावृत्तिलक्षणम् ।\nक्वेदं दारुमयं ब्रह्म पापराशिदवानलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003777018, "chapter_id": 23777, "verse_number": "२-२-२१-१९", "content_sanskrit": "सच्चिदानंदकैवल्यमुक्तिदं दर्शनादपि ।\nवेदानुवचनादीनि दुष्कराणि दुरात्मनाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003777019, "chapter_id": 23777, "verse_number": "२-२-२१-२०", "content_sanskrit": "महात्मभिस्तैर्यत्प्राप्यं तदव्यग्रमयं ददेत् ।\nअन्यक्षेत्रेषु भगवान्सुदूरो मर्त्यवासिनाम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003777020, "chapter_id": 23777, "verse_number": "२-२-२१-२१", "content_sanskrit": "स्वक्षेत्रेऽस्मिन्निवसति नित्यं मुक्तिप्रदो विभुः ।\nअस्मादत्र महाभाग तिष्ठ स्वबलपौरुषः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003777021, "chapter_id": 23777, "verse_number": "२-२-२१-२२", "content_sanskrit": "विद्वत्तमोऽसि भक्तश्च सांगोपांगममुं भज ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003777022, "chapter_id": 23777, "verse_number": "२-२-२१-२३", "content_sanskrit": "जैमिनिरुवाच ।\nद्विजस्य तद्वचः श्रुत्वा नारदो हृष्टमानसः ।\nसाधूक्तं द्विजवर्येण श्रौतमार्गानुसारिणा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003777023, "chapter_id": 23777, "verse_number": "२-२-२१-२४", "content_sanskrit": "सृष्ट्यादौ ब्रह्मनिश्वासैरभवद्वेदसंहतिः ।\nतत्रोपनिषदर्थोऽयं सांप्रतं व्यक्तिमागतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003777024, "chapter_id": 23777, "verse_number": "२-२-२१-२५", "content_sanskrit": "वेत्त्येतदर्थं भगवान्पद्मयोनिः प्रजापतिः ।\nअज्ञासिषं च भूपाल सांप्रतं तन्मुखादहम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003777025, "chapter_id": 23777, "verse_number": "२-२-२१-२६", "content_sanskrit": "तस्याज्ञया कृतं सर्वं यथाभिलषितं तव ।\nएनमाराध्य तिष्ठात्र याम्यहं ब्रह्मणोंऽतिकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003777026, "chapter_id": 23777, "verse_number": "२-२-२१-२७", "content_sanskrit": "कृतं निवेदयिष्यामि प्रकाशं च मुरद्विषः ।\nप्रासादं कुरु भूपाल धनेन महता तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003777027, "chapter_id": 23777, "verse_number": "२-२-२१-२८", "content_sanskrit": "प्रासादे नरसिंहं तु प्रतिष्ठाप्य विमुच्यसे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003777028, "chapter_id": 23777, "verse_number": "२-२-२१-२९", "content_sanskrit": "जैमिनिरुवाच ।\nतच्छ्रुत्वा स तु भूमींद्रः प्रत्युवाच मुनिं तदा ।\nमहर्षेऽहं त्वया सार्द्धं यियासुर्ब्रह्मणोंऽतिकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003777029, "chapter_id": 23777, "verse_number": "२-२-२१-३०", "content_sanskrit": "यत्प्रसादाज्जगन्नाथश्चकेऽयं लोचनातिथिः ।\nनिवेद्य तं च प्रासादं प्रतिष्ठार्थं मुरद्विषः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003777030, "chapter_id": 23777, "verse_number": "२-२-२१-३१", "content_sanskrit": "विज्ञापयिष्ये सान्निध्ये प्रासादस्थापनोत्सवम् ।\nयथा स्वयं समागम्य ब्रह्मलोकात्पितामहः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003777031, "chapter_id": 23777, "verse_number": "२-२-२१-३२", "content_sanskrit": "महोत्सवं भगवतः प्रासादेऽत्र करिष्यति ।\nतन्मुने मामपि विधेः संनिधिं प्रापयस्व च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003777032, "chapter_id": 23777, "verse_number": "२-२-२१-३३", "content_sanskrit": "गर्भप्रतिष्ठां प्रासादे समाप्येह स्थितो मुने ।\nपश्चादावां गमिष्यावः कंचित्कालं प्रतीक्ष मे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003777033, "chapter_id": 23777, "verse_number": "२-२-२१-३४", "content_sanskrit": "ततः स नृपतिः सर्वाञ्छिल्पशास्त्रविशारदान् ।\nपाषाणखंडघटनाकर्मण्येकैकयोगतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003777034, "chapter_id": 23777, "verse_number": "२-२-२१-३५", "content_sanskrit": "सत्कारैर्दानमानैश्च योजयामास सादरम् ।\nदिने दिने सुघटितः प्रासादो ववृधे द्विजाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003777035, "chapter_id": 23777, "verse_number": "२-२-२१-३६", "content_sanskrit": "परितः पूर्यमाणस्तु शुक्लपक्षे यथा शशी ।\nएवं संवर्ध्यमानोऽपि प्रासादः परिवर्द्धितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003777036, "chapter_id": 23777, "verse_number": "२-२-२१-३७", "content_sanskrit": "महोच्छ्रयत्वादल्पेन न कालेनाभिलक्ष्यते ।\nपाषाणसंख्या शक्या वा कथंचिद्घटनाक्रमात् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003777037, "chapter_id": 23777, "verse_number": "२-२-२१-३८", "content_sanskrit": "वित्तव्ययस्तु कोटीनां न संख्यातुं च शक्यते ।\nयावन्तो भारते वर्षे लोकाः समयवर्तिनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003777038, "chapter_id": 23777, "verse_number": "२-२-२१-३९", "content_sanskrit": "इन्द्रद्युम्नस्य नृपतेर्नियुक्तास्ते महीभृतः ।\nएकैकशो नियुक्ता ये परस्परसमन्विताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003777039, "chapter_id": 23777, "verse_number": "२-२-२१-४०", "content_sanskrit": "तेऽपि चान्यैर्नियुक्तास्ते सर्वे तत्र प्रवर्तिताः ।\nअजस्रं तन्नियुक्तानां यो हर्षोत्थो महारवः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003777040, "chapter_id": 23777, "verse_number": "२-२-२१-४१", "content_sanskrit": "आकाशमश्नुवानोऽसौ दिशां भागानपूरयत् ।\nनृपतेः श्रद्धया भक्त्या सात्त्विकेन प्रसादिता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003777041, "chapter_id": 23777, "verse_number": "२-२-२१-४२", "content_sanskrit": "श्रीः समृद्धाभवद्विप्राः कीर्त्या सह महीपतेः ।\nक्वचित्कांचनविन्यस्तनानारत्नमहोज्ज्वलः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003777042, "chapter_id": 23777, "verse_number": "२-२-२१-४३", "content_sanskrit": "क्वचित्स्फटिकभागांतशारदाभ्रनिभच्छविः ।\nक्वचिन्नीलाश्मघटिता भित्तिः कालाभ्रमेदुरा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003777043, "chapter_id": 23777, "verse_number": "२-२-२१-४४", "content_sanskrit": "एवं सुघटिते विष्णोः प्रासादे सुमनोहरे ।\nगर्भप्रतिष्ठां विधिवत्कृत्वा स नृपसत्तमः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003777044, "chapter_id": 23777, "verse_number": "२-२-२१-४५", "content_sanskrit": "वज्रपातादिभंगादिवारणार्थं यथोचितम् ।\nशिल्पशास्त्रेषु मण्यादि विन्यस्य पौरुषाहृतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003777045, "chapter_id": 23777, "verse_number": "२-२-२१-४६", "content_sanskrit": "पुनः प्रासादघटनासंभारोचितमेव वै ।\nबहुमूल्यं वस्तुजातं यत्नात्तत्र न्यवेशयत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003777046, "chapter_id": 23777, "verse_number": "२-२-२१-४७", "content_sanskrit": "ततो विरच्यमानेऽस्मिन्प्रासादे कीर्तिवर्द्धने ।\nमनसापि न संभाव्ये त्रिषु लोकेषु भूभुजाम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003777047, "chapter_id": 23777, "verse_number": "२-२-२१-४८", "content_sanskrit": "देवानामपि नो लक्ष्ये द्विजाः कल्पांतवासिनाम् ।\nप्रासाद ईदृशो भूमौ क्वचिच्च घटितो न हि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003777048, "chapter_id": 23777, "verse_number": "२-२-२१-४९", "content_sanskrit": "स्वर्गे वा इत्थमादित्या आलपंति परस्परम् ।\nअहो सुबुद्धिरस्योच्चैर्येयमीदृक्परीणता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003777049, "chapter_id": 23777, "verse_number": "२-२-२१-५०", "content_sanskrit": "श्रद्धया भगवत्पादपद्मयोः साभिलाषिणी ।\nअलौकिकानि कर्माणि पश्यंति हि रचंत्यपि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003777050, "chapter_id": 23777, "verse_number": "२-२-२१-५१", "content_sanskrit": "के वात्र भूमौ राजानो बभूवुर्नीतिशालिनः॥  ।\nसार्वभौमास्तु साम्राज्यजेतारः सर्वविद्विषाम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003777051, "chapter_id": 23777, "verse_number": "२-२-२१-५२", "content_sanskrit": "वित्तानि यैः संचितानि सुबहूनि च कोटिशः ।\nअश्वमेधसहस्रं तु यत्कृतं त्रिदिवेशितुः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003777052, "chapter_id": 23777, "verse_number": "२-२-२१-५३", "content_sanskrit": "शक्यं वा स्याद्भूभुजां तु नातः पूर्वमनुष्ठितम् ।\nन दृष्टं न श्रुतं वापि वाजिमेधसहस्रकम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003777053, "chapter_id": 23777, "verse_number": "२-२-२१-५४", "content_sanskrit": "महीक्षितानुष्ठितं वै यत्र त्रैलोक्य वासिनः ।\nपृथिव्यामस्य नृपतेः सहस्था भोगभोगिनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003777054, "chapter_id": 23777, "verse_number": "२-२-२१-५५", "content_sanskrit": "ब्रह्मलोक इवाभाति सभ यस्य च यज्विनः ।\nमूर्तिमंतस्त्रयो वेदाश्चतुष्पादो वृषस्तथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003777055, "chapter_id": 23777, "verse_number": "२-२-२१-५६", "content_sanskrit": "सुराः संकल्पकामास्तु यत्राद्भुतधियोऽभवन् ।\nअयं प्रासादवर्यो वै बुद्धेर्विषयतां गतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003777056, "chapter_id": 23777, "verse_number": "२-२-२१-५७", "content_sanskrit": "मनोऽपि यत्र भवति न वा त्रैलोक्यवासिनाम् ।\nभूपतेर्दुर्लभं किं स्यात्सहायो यस्य नारदः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003777057, "chapter_id": 23777, "verse_number": "२-२-२१-५८", "content_sanskrit": "पितामहश्च जगतां स्रष्टा सर्वामरेश्वरः ।\nअथवा विष्णुभक्तस्य नातिदूरं चिकीर्षितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003777058, "chapter_id": 23777, "verse_number": "२-२-२१-५९", "content_sanskrit": "विष्णोस्तद्भक्तलोकस्य नांतरं विद्यते द्विजः ।\nततः स नारदं प्राह प्रासादांते मुनीश्वरम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003777059, "chapter_id": 23777, "verse_number": "२-२-२१-६०", "content_sanskrit": "सर्वं सपन्नमासीन्मे यदशक्यं सुरासुरैः ।\nसाक्षाद्भगवतो विष्णोरद्वैतोपासनारतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003777060, "chapter_id": 23777, "verse_number": "२-२-२१-६१", "content_sanskrit": "भगवद्वपुराभाषि प्रासादस्तु चिरं मयि ।\nइत्युक्त्वा पादयोर्मूर्ध्ना प्रणनाम स नारदम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003777061, "chapter_id": 23777, "verse_number": "२-२-२१-६२", "content_sanskrit": "नारदोऽपि तमुत्थाप्य परिपूज्य नृपोत्तमम् ।\nत्वत्तो न भेदो नृपते ममास्ति खलु तत्त्वतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003777062, "chapter_id": 23777, "verse_number": "२-२-२१-६३", "content_sanskrit": "यस्तु साक्षाज्जगन्नाथ आविर्भूतः कृतेन वा ।\nअवश्यमर्चयस्वैनं जीवन्मुक्तोऽसि सांप्रतम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003777063, "chapter_id": 23777, "verse_number": "२-२-२१-६४", "content_sanskrit": "तत्पादपद्मे यादृक्ते चेतः प्र प्रवणतान्वितम् ।\nभक्त्या ह्यनन्यया पुंसः किमतः परमस्ति वै ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003777064, "chapter_id": 23777, "verse_number": "२-२-२१-६५", "content_sanskrit": "तीर्थैर्मंत्रैर्जपैर्दानैः क्रतुभिर्भूरिदक्षिणैः ।\nव्रतैरध्ययनैर्भूप तपोभिश्च यदर्जितुम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003777065, "chapter_id": 23777, "verse_number": "२-२-२१-६६", "content_sanskrit": "न शक्यं तव राजेन्द्र भक्त्या तत्करमागतम् ।\nअतः परं न शोचस्व भक्तियोगे नमोऽस्तु ते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003777066, "chapter_id": 23777, "verse_number": "२-२-२१-६७", "content_sanskrit": "प्रकर्षं बहुराजेंद्र स्थित्वा चास्मिंश्चिरं भुवि ।\nआराधय जगन्नाथमुपचारैर्महोत्सवैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003777067, "chapter_id": 23777, "verse_number": "२-२-२१-६८", "content_sanskrit": "पितामहं द्रष्टुकामो गंता चेदंतिकं विभोः ।\nउपदेक्ष्यति सोऽप्यस्य यात्रास्तास्ता महोत्सवाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003777068, "chapter_id": 23777, "verse_number": "२-२-२१-६९", "content_sanskrit": "स्वयं च भगवानेव वरं तुभ्यं प्रदास्यति ।\nप्रतिष्ठापिते प्रासादे तस्मिन्काले स्वयंभुवा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003777069, "chapter_id": 23777, "verse_number": "२-२-२१-७०", "content_sanskrit": "अहमप्यागमिष्यामि तदा सप्तर्षिभिः सह ।\nतदावां तत्र गच्छावो ब्रह्मलोकमकल्मषम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003777070, "chapter_id": 23777, "verse_number": "२-२-२१-७१", "content_sanskrit": "त्वां विना भुवि कः शक्तो ब्रह्मलोकगतिं प्रति ।\nइत्युक्त्वा नारदो भूपं समुत्तस्थौ नभस्तलम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003777071, "chapter_id": 23777, "verse_number": "२-२-२१-७२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवाद एकविंशोऽध्यायः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]