[{"id": 5000048000, "chapter_id": 9048, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे अष्टचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000048001, "chapter_id": 9048, "verse_number": "१-४८-१", "content_sanskrit": "पृष्ट्वा तु कुशलं तत्र परस्परसमागमे।\nकथान्ते सुमतिर्वाक्यं व्याजहार महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000048002, "chapter_id": 9048, "verse_number": "१-४८-२", "content_sanskrit": "इमौ कुमारौ भद्रं ते देवतुल्यपराक्रमौ।\nगजसिंहगती वीरौ शार्दूलवृषभोपमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000048003, "chapter_id": 9048, "verse_number": "१-४८-३", "content_sanskrit": "पद्मपत्रविशालाक्षौ खड्गतूणिधनुर्धरौ।\nअश्विनाविव रूपेण समुपस्थितयौवनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000048004, "chapter_id": 9048, "verse_number": "१-४८-४", "content_sanskrit": "यदृच्छयैव गां प्राप्तौ देवलोकादिवामरौ।\nकथं पद‍्भ्यामिह प्राप्तौ किमर्थं कस्य वा मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000048005, "chapter_id": 9048, "verse_number": "१-४८-५", "content_sanskrit": "भूषयन्ताविमं देशं चन्द्रसूर्याविवाम्बरम्।\nपरस्परेण सदृशौ प्रमाणेङ्गितचेष्टितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000048006, "chapter_id": 9048, "verse_number": "१-४८-६", "content_sanskrit": "किमर्थं च नरश्रेष्ठौ सम्प्राप्तौ दुर्गमे पथि।\nवरायुधधरौ वीरौ श्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000048007, "chapter_id": 9048, "verse_number": "१-४८-७", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा यथावृत्तं न्यवेदयत्।\nसिद्धाश्रमनिवासं च राक्षसानां वधं यथा।\nविश्वामित्रवचः श्रुत्वा राजा परमविस्मितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000048008, "chapter_id": 9048, "verse_number": "१-४८-८", "content_sanskrit": "अतिथी परमं प्राप्तौ पुत्रौ दशरथस्य तौ।\nपूजयामास विधिवत् सत्कारार्हौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000048009, "chapter_id": 9048, "verse_number": "१-४८-९", "content_sanskrit": "ततः परमसत्कारं सुमतेः प्राप्य राघवौ।\nउष्य तत्र निशामेकां जग्मतुर्मिथिलां ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000048010, "chapter_id": 9048, "verse_number": "१-४८-१०", "content_sanskrit": "तां दृष्ट्वा मुनयः सर्वे जनकस्य पुरीं शुभाम्।\nसाधु साध्विति शंसन्तो मिथिलां समपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000048011, "chapter_id": 9048, "verse_number": "१-४८-११", "content_sanskrit": "मिथिलोपवने तत्र आश्रमं दृश्य राघवः।\nपुराणं निर्जनं रम्यं पप्रच्छ मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000048012, "chapter_id": 9048, "verse_number": "१-४८-१२", "content_sanskrit": "इदमाश्रमसंकाशं किं न्विदं मुनिवर्जितम्।\nश्रोतुमिच्छामि भगवन् कस्यायं पूर्व आश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000048013, "chapter_id": 9048, "verse_number": "१-४८-१३", "content_sanskrit": "तच्छ्रुत्वा राघवेणोक्तं वाक्यं वाक्यविशारदः।\nप्रत्युवाच महातेजा विश्वामित्रो महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000048014, "chapter_id": 9048, "verse_number": "१-४८-१४", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु तत्त्वेन राघव।\nयस्यैतदाश्रमपदं शप्तं कोपान्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000048015, "chapter_id": 9048, "verse_number": "१-४८-१५", "content_sanskrit": "गौतमस्य नरश्रेष्ठ पूर्वमासीन्महात्मनः।\nआश्रमो दिव्यसंकाशः सुरैरपि सुपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000048016, "chapter_id": 9048, "verse_number": "१-४८-१६", "content_sanskrit": "स चात्र तप आतिष्ठदहल्यासहितः पुरा।\nवर्षपूगान्यनेकानि राजपुत्र महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000048017, "chapter_id": 9048, "verse_number": "१-४८-१७", "content_sanskrit": "तस्यान्तरं विदित्वा च सहस्राक्षः शचीपतिः।\nमुनिवेषधरो भूत्वा अहल्यामिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000048018, "chapter_id": 9048, "verse_number": "१-४८-१८", "content_sanskrit": "ऋतुकालं प्रतीक्षन्ते नार्थिनः सुसमाहिते।\nसंगमं त्वहमिच्छामि त्वया सह सुमध्यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000048019, "chapter_id": 9048, "verse_number": "१-४८-१९", "content_sanskrit": "मुनिवेषं सहस्राक्षं विज्ञाय रघुनन्दन।\nमतिं चकार दुर्मेधा देवराजकुतूहलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000048020, "chapter_id": 9048, "verse_number": "१-४८-२०", "content_sanskrit": "अथाब्रवीत् सुरश्रेष्ठं कृतार्थेनान्तरात्मना।\nकृतार्थास्मि सुरश्रेष्ठ गच्छ शीघ्रमितः प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000048021, "chapter_id": 9048, "verse_number": "१-४८-२१", "content_sanskrit": "आत्मानं मां च देवेश सर्वथा रक्ष गौतमात्।\nइन्द्रस्तु प्रहसन् वाक्यमहल्यामिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000048022, "chapter_id": 9048, "verse_number": "१-४८-२२", "content_sanskrit": "सुश्रोणि परितुष्टोऽस्मि गमिष्यामि यथागतम्।\nएवं संगम्य तु तदा निश्चक्रामोटजात् ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000048023, "chapter_id": 9048, "verse_number": "१-४८-२३", "content_sanskrit": "स सम्भ्रमात् त्वरन् राम शङ्कितो गौतमं प्रति।\nगौतमं स ददर्शाथ प्रविशन्तं महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000048024, "chapter_id": 9048, "verse_number": "१-४८-२४", "content_sanskrit": "देवदानवदुर्धर्षं तपोबलसमन्वितम्।\nतीर्थोदकपरिक्लिन्नं दीप्यमानमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000048025, "chapter_id": 9048, "verse_number": "१-४८-२५", "content_sanskrit": "गृहीतसमिधं तत्र सकुशं मुनिपुंगवम्।\nदृष्ट्वा सुरपतिस्त्रस्तो विषण्णवदनोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000048026, "chapter_id": 9048, "verse_number": "१-४८-२६", "content_sanskrit": "अथ दृष्ट्वा सहस्राक्षं मुनिवेषधरं मुनिः।\nदुर्वृत्तं वृत्तसम्पन्नो रोषाद् वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000048027, "chapter_id": 9048, "verse_number": "१-४८-२७", "content_sanskrit": "मम रूपं समास्थाय कृतवानसि दुर्मते।\nअकर्तव्यमिदं यस्माद् विफलस्त्वं भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000048028, "chapter_id": 9048, "verse_number": "१-४८-२८", "content_sanskrit": "गौतमेनैवमुक्तस्य सुरोषेण महात्मना।\nपेततुर्वृषणौ भूमौ सहस्राक्षस्य तत्क्षणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000048029, "chapter_id": 9048, "verse_number": "१-४८-२९", "content_sanskrit": "तथा शप्त्वा च वै शक्रं भार्यामपि च शप्तवान्।\nइह वर्षसहस्राणि बहूनि निवसिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000048030, "chapter_id": 9048, "verse_number": "१-४८-३०", "content_sanskrit": "वातभक्षा निराहारा तप्यन्ती भस्मशायिनी।\nअदृश्या सर्वभूतानामाश्रमेऽस्मिन् वसिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000048031, "chapter_id": 9048, "verse_number": "१-४८-३१", "content_sanskrit": "यदा त्वेतद् वनं घोरं रामो दशरथात्मजः।\nआगमिष्यति दुर्धर्षस्तदा पूता भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000048032, "chapter_id": 9048, "verse_number": "१-४८-३२", "content_sanskrit": "तस्यातिथ्येन दुर्वृत्ते लोभमोहविवर्जिता।\nमत्सकाशं मुदा युक्ता स्वं वपुर्धारयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000048033, "chapter_id": 9048, "verse_number": "१-४८-३३", "content_sanskrit": "एवमुक्त्वा महातेजा गौतमो दुष्टचारिणीम्।\nइममाश्रममुत्सृज्य सिद्धचारणसेविते।\nहिमवच्छिखरे रम्ये तपस्तेपे महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000048034, "chapter_id": 9048, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे अष्टचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]