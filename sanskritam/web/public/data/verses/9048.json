[{"id": 40008730, "chapter_id": 9048, "verse_number": "1", "content_sanskrit": "तौ तु तत्र स्थितौ दृष्ट्वा भ्रातरौ रामलक्ष्मणौ। बाहुपाशपरिक्षिप्तौ कबन्धो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40008731, "chapter_id": 9048, "verse_number": "2", "content_sanskrit": "तिष्ठतः किं नु मां दृष्ट्वा क्षुधार्तं क्षत्रियर्षभौ। आहारार्थं तु सन्दिष्टौ दैवेन गतचेतसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40008732, "chapter_id": 9048, "verse_number": "3", "content_sanskrit": "तच्छ्रुत्वा लक्ष्मणो वाक्यं प्राप्तकालं हितं तदा। उवाचाऽर्तिं समापन्नो विक्रमे कृतलक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40008733, "chapter_id": 9048, "verse_number": "4", "content_sanskrit": "त्वां च मां च पुरा तूर्णमादत्ते राक्षसाधमः। तस्मादसिभ्यामस्याशु बाहू छिन्दावहै गुरू ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40008734, "chapter_id": 9048, "verse_number": "5", "content_sanskrit": "भीषणोऽयं महाकायो राक्षसो भुजविक्रमः। लोकं ह्यतिजितं कृत्वा ह्यावां हन्तुमिहेच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40008735, "chapter_id": 9048, "verse_number": "6", "content_sanskrit": "निश्चेष्टानां वधो राजन्कुत्सितो जगतीपतेः। क्रतुमध्योपनीतानां पशूनामिव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40008736, "chapter_id": 9048, "verse_number": "7", "content_sanskrit": "एतत्सञ्जल्पितं श्रुत्वा तयोः क्रुद्धस्तु राक्षसः। विदार्याऽस्यं तदा रौद्रस्तौ भक्षयितुमारभत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40008737, "chapter_id": 9048, "verse_number": "8", "content_sanskrit": "ततस्तौ देशकालज्ञौ खड्गाभ्यामेव राघवौ। अच्छिन्दतां सुसंविग्नौ बाहू तस्यांसदेशतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40008738, "chapter_id": 9048, "verse_number": "9", "content_sanskrit": "दक्षिणो दक्षिणं बाहुमसक्तमसिना ततः। चिच्छेद रामो वेगेन सव्यं वीरस्तु लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40008739, "chapter_id": 9048, "verse_number": "10", "content_sanskrit": "स पपात महाबाहुश्छिन्नबाहुर्महास्वनः। खं च गां च दिशश्चैव नादयञ्जलदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40008740, "chapter_id": 9048, "verse_number": "11", "content_sanskrit": "स निकृत्तौ भुजौ दृष्ट्वा शोणितौघपरिप्लुतः। दीनः पप्रच्छ तौ वीरौ कौ युवामिति दानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40008741, "chapter_id": 9048, "verse_number": "12", "content_sanskrit": "इति तस्य ब्रुवाणस्य लक्ष्मणश्शुभलक्षणः। शशंस राघवं तस्य कबन्धस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40008742, "chapter_id": 9048, "verse_number": "13", "content_sanskrit": "अयमिक्ष्वाकुदायादो रामो नाम जनैश्श्रुतः। अस्यैवावरजं विद्दि भ्रातरं मां च लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40008743, "chapter_id": 9048, "verse_number": "14", "content_sanskrit": "अस्य देवप्रभावस्य वसतो विजने वने। रक्षसाऽपहृता पत्नी यामिच्छन्ताविहागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40008744, "chapter_id": 9048, "verse_number": "15", "content_sanskrit": "त्वं तु को वा किमर्थं वा कबन्धसदृशो वने। आस्येनोरसि दीप्तेन भग्नजङ्घो विचेष्टसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40008745, "chapter_id": 9048, "verse_number": "16", "content_sanskrit": "एवमुक्तः कबन्धस्तु लक्ष्मणेनोत्तरं वचः। उवाच परमप्रीत स्तदिन्द्रवचनं स्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40008746, "chapter_id": 9048, "verse_number": "17", "content_sanskrit": "स्वागतं वां नरव्याघ्रौ दिष्ट्या पश्यामि चाप्यहम्। दिष्ट्या चेमौ निकृत्तौ मे युवाभ्यां बाहुबन्धनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40008747, "chapter_id": 9048, "verse_number": "18", "content_sanskrit": "विरूपं यच्च मे रूपं प्राप्तं ह्यविनयाद्यथा। तन्मे शृणु नरव्याघ्र तत्त्वतश्शंसतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]