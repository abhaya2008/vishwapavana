[{"id": 5000095000, "chapter_id": 9095, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000095001, "chapter_id": 9095, "verse_number": "२-१८-१", "content_sanskrit": "स ददर्शासने रामो विषण्णं पितरं शुभे।\nकैकेय्या सहितं दीनं मुखेन परिशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000095002, "chapter_id": 9095, "verse_number": "२-१८-२", "content_sanskrit": "स पितुश्चरणौ पूर्वमभिवाद्य विनीतवत्।\nततो ववन्दे चरणौ कैकेय्याः सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000095003, "chapter_id": 9095, "verse_number": "२-१८-३", "content_sanskrit": "रामेत्युक्त्वा तु वचनं बाष्पपर्याकुलेक्षणः।\nशशाक नृपतिर्दीनो नेक्षितुं नाभिभाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000095004, "chapter_id": 9095, "verse_number": "२-१८-४", "content_sanskrit": "तदपूर्वं नरपतेर्दृष्ट्वा रूपं भयावहम्।\nरामोऽपि भयमापन्नः पदा स्पृष्ट्वेव पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000095005, "chapter_id": 9095, "verse_number": "२-१८-५", "content_sanskrit": "इन्द्रियैरप्रहृष्टैस्तं शोकसंतापकर्शितम्।\nनिःश्वसन्तं महाराजं व्यथिताकुलचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000095006, "chapter_id": 9095, "verse_number": "२-१८-६", "content_sanskrit": "ऊर्मिमालिनमक्षोभ्यं क्षुभ्यन्तमिव सागरम्।\nउपप्लुतमिवादित्यमुक्तानृतमृषिं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000095007, "chapter_id": 9095, "verse_number": "२-१८-७", "content_sanskrit": "अचिन्त्यकल्पं नृपतेस्तं शोकमुपधारयन्।\nबभूव संरब्धतरः समुद्र इव पर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000095008, "chapter_id": 9095, "verse_number": "२-१८-८", "content_sanskrit": "चिन्तयामास चतुरो रामः पितृहिते रतः।\nकिंस्विदद्यैव नृपतिर्न मां प्रत्यभिनन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000095009, "chapter_id": 9095, "verse_number": "२-१८-९", "content_sanskrit": "अन्यदा मां पिता दृष्ट्वा कुपितोऽपि प्रसीदति।\nतस्य मामद्य सम्प्रेक्ष्य किमायासः प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000095010, "chapter_id": 9095, "verse_number": "२-१८-१०", "content_sanskrit": "स दीन इव शोकार्तो विषण्णवदनद्युतिः।\nकैकेयीमभिवाद्यैव रामो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000095011, "chapter_id": 9095, "verse_number": "२-१८-११", "content_sanskrit": "कच्चिन्मया नापराद्धमज्ञानाद् येन मे पिता।\nकुपितस्तन्ममाचक्ष्व त्वमेवैनं प्रसादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000095012, "chapter_id": 9095, "verse_number": "२-१८-१२", "content_sanskrit": "अप्रसन्नमनाः किं नु सदा मां प्रति वत्सलः।\nविषण्णवदनो दीनः नहि मां प्रति भाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000095013, "chapter_id": 9095, "verse_number": "२-१८-१३", "content_sanskrit": "शारीरो मानसो वापि कच्चिदेनं न बाधते।\nसंतापो वाभितापो वा दुर्लभं हि सदा सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000095014, "chapter_id": 9095, "verse_number": "२-१८-१४", "content_sanskrit": "कच्चिन्न किंचिद् भरते कुमारे प्रियदर्शने।\nशत्रुघ्ने वा महासत्त्वे मातॄणां वा ममाशुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000095015, "chapter_id": 9095, "verse_number": "२-१८-१५", "content_sanskrit": "अतोषयन् महाराजमकुर्वन् वा पितुर्वचः।\nमुहूर्तमपि नेच्छेयं जीवितुं कुपिते नृपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000095016, "chapter_id": 9095, "verse_number": "२-१८-१६", "content_sanskrit": "यतोमूलं नरः पश्येत् प्रादुर्भावमिहात्मनः।\nकथं तस्मिन् न वर्तेत प्रत्यक्षे सति दैवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000095017, "chapter_id": 9095, "verse_number": "२-१८-१७", "content_sanskrit": "कच्चित्ते परुषं किंचिदभिमानात् पिता मम।\nउक्तो भवत्या रोषेण येनास्य लुलितं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000095018, "chapter_id": 9095, "verse_number": "२-१८-१८", "content_sanskrit": "एतदाचक्ष्व मे देवि तत्त्वेन परिपृच्छतः।\nकिंनिमित्तमपूर्वोऽयं विकारो मनुजाधिपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000095019, "chapter_id": 9095, "verse_number": "२-१८-१९", "content_sanskrit": "एवमुक्ता तु कैकेयी राघवेण महात्मना।\nउवाचेदं सुनिर्लज्जा धृष्टमात्महितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000095020, "chapter_id": 9095, "verse_number": "२-१८-२०", "content_sanskrit": "न राजा कुपितो राम व्यसनं नास्य किंचन।\nकिंचिन्मनोगतं त्वस्य त्वद्भयान्नानुभाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000095021, "chapter_id": 9095, "verse_number": "२-१८-२१", "content_sanskrit": "प्रियं त्वामप्रियं वक्तुं वाणी नास्य प्रवर्तते।\nतदवश्यं त्वया कार्यं यदनेनाश्रुतं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000095022, "chapter_id": 9095, "verse_number": "२-१८-२२", "content_sanskrit": "एष मह्यं वरं दत्त्वा पुरा मामभिपूज्य च।\nस पश्चात् तप्यते राजा यथान्यः प्राकृतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000095023, "chapter_id": 9095, "verse_number": "२-१८-२३", "content_sanskrit": "अतिसृज्य ददानीति वरं मम विशाम्पतिः।\nस निरर्थं गतजले सेतुं बन्धितुमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000095024, "chapter_id": 9095, "verse_number": "२-१८-२४", "content_sanskrit": "धर्ममूलमिदं राम विदितं च सतामपि।\nतत् सत्यं न त्यजेद् राजा कुपितस्त्वत्कृते यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000095025, "chapter_id": 9095, "verse_number": "२-१८-२५", "content_sanskrit": "यदि तद् वक्ष्यते राजा शुभं वा यदि वाशुभम्।\nकरिष्यसि ततः सर्वमाख्यास्यामि पुनस्त्वहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000095026, "chapter_id": 9095, "verse_number": "२-१८-२६", "content_sanskrit": "यदि त्वभिहितं राज्ञा त्वयि तन्न विपत्स्यते।\nततोऽहमभिधास्यामि न ह्येष त्वयि वक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000095027, "chapter_id": 9095, "verse_number": "२-१८-२७", "content_sanskrit": "एतत् तु वचनं श्रुत्वा कैकेय्या समुदाहृतम्।\nउवाच व्यथितो रामस्तां देवीं नृपसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000095028, "chapter_id": 9095, "verse_number": "२-१८-२८", "content_sanskrit": "अहो धिङ् नार्हसे देवि वक्तुं मामीदृशं वचः।\nअहं हि वचनाद् राज्ञः पतेयमपि पावके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000095029, "chapter_id": 9095, "verse_number": "२-१८-२९", "content_sanskrit": "भक्षयेयं विषं तीक्ष्णं पतेयमपि चार्णवे।\nनियुक्तो गुरुणा पित्रा नृपेण च हितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000095030, "chapter_id": 9095, "verse_number": "२-१८-३०", "content_sanskrit": "तद् ब्रूहि वचनं देवि राज्ञो यदभिकांक्षितम्।\nकरिष्ये प्रतिजाने च रामो द्विर्नाभिभाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000095031, "chapter_id": 9095, "verse_number": "२-१८-३१", "content_sanskrit": "तमार्जवसमायुक्तमनार्या सत्यवादिनम्।\nउवाच रामं कैकेयी वचनं भृशदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000095032, "chapter_id": 9095, "verse_number": "२-१८-३२", "content_sanskrit": "पुरा देवासुरे युद्धे पित्रा ते मम राघव।\nरक्षितेन वरौ दत्तौ सशल्येन महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000095033, "chapter_id": 9095, "verse_number": "२-१८-३३", "content_sanskrit": "तत्र मे याचितो राजा भरतस्याभिषेचनम्।\nगमनं दण्डकारण्ये तव चाद्यैव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000095034, "chapter_id": 9095, "verse_number": "२-१८-३४", "content_sanskrit": "यदि सत्यप्रतिज्ञं त्वं पितरं कर्तुमिच्छसि।\nआत्मानं च नरश्रेष्ठ मम वाक्यमिदं शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000095035, "chapter_id": 9095, "verse_number": "२-१८-३५", "content_sanskrit": "संनिदेशे पितुस्तिष्ठ यथानेन प्रतिश्रुतम्।\nत्वयारण्यं प्रवेष्टव्यं नव वर्षाणि पञ्च च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000095036, "chapter_id": 9095, "verse_number": "२-१८-३६", "content_sanskrit": "भरतश्चाभिषिच्येत यदेतदभिषेचनम्।\nत्वदर्थे विहितं राज्ञा तेन सर्वेण राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000095037, "chapter_id": 9095, "verse_number": "२-१८-३७", "content_sanskrit": "सप्त सप्त च वर्षाणि दण्डकारण्यमाश्रितः।\nअभिषेकमिदं त्यक्त्वा जटाचीरधरो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000095038, "chapter_id": 9095, "verse_number": "२-१८-३८", "content_sanskrit": "भरतः कोसलपतेः प्रशास्तु वसुधामिमाम्।\nनानारत्नसमाकीर्णां सवाजिरथसंकुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000095039, "chapter_id": 9095, "verse_number": "२-१८-३९", "content_sanskrit": "एतेन त्वां नरेन्द्रोऽयं कारुण्येन समाप्लुतः।\nशोकैः संक्लिष्टवदनो न शक्नोति निरीक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000095040, "chapter_id": 9095, "verse_number": "२-१८-४०", "content_sanskrit": "एतत् कुरु नरेन्द्रस्य वचनं रघुनन्दन।\nसत्येन महता राम तारयस्व नरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000095041, "chapter_id": 9095, "verse_number": "२-१८-४१", "content_sanskrit": "इतीव तस्यां परुषं वदन्त्यां\nन चैव रामः प्रविवेश शोकम्।\nप्रविव्यथे चापि महानुभावो\nराजा च पुत्रव्यसनाभितप्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000095042, "chapter_id": 9095, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]