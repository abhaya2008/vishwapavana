[{"id": 7001661000, "chapter_id": 21661, "verse_number": "१-४७-१", "content_sanskrit": "सनन्दन उवाच- ।\nएतदध्यात्ममानाढ्यं वचः केशिध्वजस्य सः  ।\nखाडिक्योऽमृतवच्छ्रुत्वा पुनराह तमीरयन् 1.47.॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001661001, "chapter_id": 21661, "verse_number": "१-४७-२", "content_sanskrit": "खाण्डिक्य उवाच-  ।\nतद् ब्रूहि त्वं महाभाग योगं योगविदुत्तम  ।\nविज्ञातयोगशास्त्रार्थस्त्वमस्यां निमिसन्ततौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001661002, "chapter_id": 21661, "verse_number": "१-४७-३", "content_sanskrit": "केशिध्वज उवाच-  ।\nयोगस्वरूपं खाण्डिक्य श्रूयतां गदतो मम  ।\nयत्र स्थितो न च्यवते प्राप्य ब्रह्मलयं मुनिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001661003, "chapter_id": 21661, "verse_number": "१-४७-४", "content_sanskrit": "मन एव मनुष्याणां कारणं बन्धमोक्षयोः  ।\nबंधस्य विषयासङ्गि मुक्तेर्निर्विषयं तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001661004, "chapter_id": 21661, "verse_number": "१-४७-५", "content_sanskrit": "विषयेभ्यः समाहृत्य विज्ञानात्मा बुधो मनः  ।\nचिन्तयेन्मुक्तये तेन ब्रह्मभूतं परेश्वरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001661005, "chapter_id": 21661, "verse_number": "१-४७-६", "content_sanskrit": "आत्मभावं नयेत्तेन तद्ब्रह्माध्यापनं मनः  ।\nविकार्यमात्मनः शक्त्या लोहमाकर्षको यथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001661006, "chapter_id": 21661, "verse_number": "१-४७-७", "content_sanskrit": "आत्मप्रयत्नसापेक्षा विशिष्टा या मनोगतिः  ।\nतस्या ब्रह्मणि संयोगो योग इत्यभिधीते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001661007, "chapter_id": 21661, "verse_number": "१-४७-८", "content_sanskrit": "एवमत्यन्तवैशिष्ट्ययुक्तधर्मोपलक्षणम्  ।\nयस्य योगः स वै योगी मुमुक्षुरमिधीयते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001661008, "chapter_id": 21661, "verse_number": "१-४७-९", "content_sanskrit": "योगयुक् प्रथमं योगी युञ्जमानोऽभिधीयते  ।\nविनिष्पन्नसमाधिस्तु परब्रह्मोपलब्धिमान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001661009, "chapter_id": 21661, "verse_number": "१-४७-१०", "content_sanskrit": "यद्यन्तरायदोषेण दूष्यते नास्य मानसम्  ।\nजन्मान्तरैरभ्यसनान्मुक्तिः पूर्वस्य जायते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001661010, "chapter_id": 21661, "verse_number": "१-४७-११", "content_sanskrit": "विनिष्पन्नसमाधिस्तु मुक्तिस्तत्रैव जन्मनि  ।\nप्राप्नोति योगी योगाग्निदग्धकर्मचयोऽचिरात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001661011, "chapter_id": 21661, "verse_number": "१-४७-१२", "content_sanskrit": "ब्रह्मचर्यमहिंसां च सत्यास्तेयापरिग्रहान्  ।\nसेवेतयोगी निष्कामो योगितां स्वमनो नयन् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001661012, "chapter_id": 21661, "verse_number": "१-४७-१३", "content_sanskrit": "स्वाध्यायशौचसन्तोषतपांसि नियमान्यमान्  ।\nकुर्व्वीत ब्रह्मणि तथा परस्मिन्प्रवणं मनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001661013, "chapter_id": 21661, "verse_number": "१-४७-१४", "content_sanskrit": "एते यमाश्च नियमाः पञ्च पञ्चप्रकीर्तिताः  ।\nविशिष्टफलदाः काम्या निष्कामानां विमुक्तिदाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001661014, "chapter_id": 21661, "verse_number": "१-४७-१५", "content_sanskrit": "एवं भद्रा सनादीनां समास्थाय गुणैर्युतः  ।\nयमाख्यैर्नियमाख्यैश्च युञ्जीत नियतो यतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001661015, "chapter_id": 21661, "verse_number": "१-४७-१६", "content_sanskrit": "प्राणाख्यमवलंबस्थमभ्यासात्कुरुते तु यत्  ।\nप्राणायामः स विज्ञेयः सबीजोऽबीज एव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001661016, "chapter_id": 21661, "verse_number": "१-४७-१७", "content_sanskrit": "परस्परेणाभिभवं प्राणापानौ यदानिलौ  ।\nकुरुतः सद्विधानेन तृतीयः संयमात्तयोः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001661017, "chapter_id": 21661, "verse_number": "१-४७-१८", "content_sanskrit": "तस्य चालंबनवत्स्थूलं रूपं द्विषत्पते  ।\nआलंबनमनन्तस्य योगिनोऽभ्यसतः स्मृतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001661018, "chapter_id": 21661, "verse_number": "१-४७-१९", "content_sanskrit": "शब्दादिष्वनुरक्तानि निगृह्याक्षाणि योगवित्  ।\nकुर्य्याच्चित्तानुकारीणि प्रत्याहारपरायणः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001661019, "chapter_id": 21661, "verse_number": "१-४७-२०", "content_sanskrit": "वश्यता परमा तेन जायते निश्चलात्मनाम्  ।\nइन्द्रि याणामवश्यैस्तैर्न योगी योगसाधकः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001661020, "chapter_id": 21661, "verse_number": "१-४७-२१", "content_sanskrit": "प्राणायामेन पवनैः प्रत्याहरेण चेन्द्रि यैः  ।\nवशीकृतैस्ततः कुर्यात्स्थिरं चेतः शुभाश्रये ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001661021, "chapter_id": 21661, "verse_number": "१-४७-२२", "content_sanskrit": "खाण्डिक्य उवाच-  ।\nकथ्यतां मे महाभाग चेतसो यः शुभाश्रयः  ।\nयदाधारमशेषं तु हन्ति दोषसमुद्भवम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001661022, "chapter_id": 21661, "verse_number": "१-४७-२३", "content_sanskrit": "केशिध्वज उवाच-  ।\nआश्रयश्चेतसो ज्ञानिन् द्विधा तच्च स्वरूपतः  ।\nरूपं मूर्तममूर्तं च परं चापरमेव च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001661023, "chapter_id": 21661, "verse_number": "१-४७-२४", "content_sanskrit": "त्रिविधा भावना रूपं विश्वमेतत्त्रिधोच्यते  ।\nब्रह्माख्या कर्मसंज्ञा च तथा चैवोभयात्मिका ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001661024, "chapter_id": 21661, "verse_number": "१-४७-२५", "content_sanskrit": "कर्मभावात्मिका ह्येका ब्रह्मभावात्मिका परा  ।\nउभयात्मिका तथैवान्या त्रिविधा भावभावना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001661025, "chapter_id": 21661, "verse_number": "१-४७-२६", "content_sanskrit": "सनकाद्यासदा ज्ञानिन् ब्रह्मभावनया युताः  ।\nकर्मभावनया चान्ये देवाद्याः स्थावराश्चराः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001661026, "chapter_id": 21661, "verse_number": "१-४७-२७", "content_sanskrit": "हिरण्यगर्भादिषु च ब्रह्मकर्मात्मिका द्विधा  ।\nअधिकारबोधयुक्तेषु विद्यते भावभावना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001661027, "chapter_id": 21661, "verse_number": "१-४७-२८", "content_sanskrit": "अक्षीणेषु समस्तेषु विशेषज्ञानकर्मसु  ।\nविश्वमेतत्परं चान्यद्भेदभिन्नदृशां नृप ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001661028, "chapter_id": 21661, "verse_number": "१-४७-२९", "content_sanskrit": "प्रत्यस्तमितभेदं यत्सत्तामात्रमगोचरम्  ।\nवचसामात्मसन्तोद्यं तज्ज्ञानं ब्रह्मसंज्ञितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001661029, "chapter_id": 21661, "verse_number": "१-४७-३०", "content_sanskrit": "तच्च विष्णोः परं रूपमरूपस्याजनस्य च  ।\nविश्वस्वरूपवैरूप्यलक्षणं परमात्मनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001661030, "chapter_id": 21661, "verse_number": "१-४७-३१", "content_sanskrit": "न तद्योगयुजा शक्यं नृप चिन्तयितुं यतः  ।\nततः स्थूलं हरे रूपं चिन्त्यं यच्चक्षुगोचरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001661031, "chapter_id": 21661, "verse_number": "१-४७-३२", "content_sanskrit": "हिरण्यगर्भो भगवान्वासवोऽथ प्रजापतिः  ।\nमरुतो वसवो रुद्रा भास्करास्तारका ग्रहाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001661032, "chapter_id": 21661, "verse_number": "१-४७-३३", "content_sanskrit": "गन्धार्वा यक्षदैत्याश्च सकला देवयोनयः  ।\nमनुष्याः पशवः शैला समुद्रा ः! सरितो द्रुमाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001661033, "chapter_id": 21661, "verse_number": "१-४७-३४", "content_sanskrit": "भूप भूतान्यशेषाणि भूतानां ये च हेतवः  ।\nप्रधानादिविशेषान्ताश्चेतनाचेतनात्मकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001661034, "chapter_id": 21661, "verse_number": "१-४७-३५", "content_sanskrit": "एकपादं द्विपादं च बहुपादमपादकम्  ।\nमूर्त्तमेतद्धरे रूपं भावनात्रितयात्मकम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001661035, "chapter_id": 21661, "verse_number": "१-४७-३६", "content_sanskrit": "एतत्सर्वमिदं विश्वं जगदेतच्चराचरम्  ।\nपरब्रह्मस्वरूपस्य विष्णोः शक्तिसमन्वितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001661036, "chapter_id": 21661, "verse_number": "१-४७-३७", "content_sanskrit": "विष्णुशक्तिः परा प्रोक्ता क्षेत्रज्ञाख्या तथापरा  ।\nअविद्याकर्मसंज्ञान्या तृतीया शक्तिरिष्यते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001661037, "chapter_id": 21661, "verse_number": "१-४७-३८", "content_sanskrit": "येयं क्षेत्रज्ञशक्तिः सा चेष्टिता नृप कर्मजा  ।\nअसारभूते संसारे प्रोक्ता तत्र महामते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001661038, "chapter_id": 21661, "verse_number": "१-४७-३९", "content_sanskrit": "संसारतापानखिलानवाप्नोत्यनुसंज्ञितान्  ।\nतया तिरोहितत्वात्तु शक्तिः क्षेत्रज्ञसंज्ञिता ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001661039, "chapter_id": 21661, "verse_number": "१-४७-४०", "content_sanskrit": "सर्वभूतेषु भूपाल तारतम्येन लक्ष्यते  ।\nअप्राणवत्सु खल्वल्पा स्थावरेषु ततोऽधिका ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001661040, "chapter_id": 21661, "verse_number": "१-४७-४१", "content_sanskrit": "सरीसृपेषु तेभ्योऽन्याप्यतिशक्त्या पतत्त्रिषु  ।\nपतत्त्रिभ्यो मृगास्तेभ्यः स्वशक्त्या पशवोऽधिकाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001661041, "chapter_id": 21661, "verse_number": "१-४७-४२", "content_sanskrit": "पशुभ्यो मनुजाश्चातिशक्त्या पुंसः प्रभाविताः  ।\nतेभ्योऽपि नागगन्धर्वयक्षाद्या देवता नृप ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001661042, "chapter_id": 21661, "verse_number": "१-४७-४३", "content_sanskrit": "शक्रः समस्तदेवेभ्यस्ततश्चातिप्रजापतिः  ।\nहिरण्यगर्भोऽपि ततः पुंसः शक्त्युपलक्षितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001661043, "chapter_id": 21661, "verse_number": "१-४७-४४", "content_sanskrit": "एतान्यशेषरूपाणि तस्य रूपाणि पार्थिव  ।\nयतस्तच्छक्तियोगेन युक्तानि नभसा यथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001661044, "chapter_id": 21661, "verse_number": "१-४७-४५", "content_sanskrit": "द्वितीयं विष्णुसंज्ञस्य योगिध्येयं महामते  ।\nअमूर्तं ब्रह्मणो रूपं यत्सदित्युच्यते बुधैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001661045, "chapter_id": 21661, "verse_number": "१-४७-४६", "content_sanskrit": "समस्ताः शक्तयश्चैता नृप यत्र प्रतिष्ठिताः  ।\nनहि स्वरूपरूपं वै रूपमन्यद्धरेर्महत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001661046, "chapter_id": 21661, "verse_number": "१-४७-४७", "content_sanskrit": "समस्तशक्तिरूपाणि तत्करोति जनेश्वर  ।\nदेवतिर्यङ्मनुष्यादिचेष्टावन्ति स्वलीलया ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001661047, "chapter_id": 21661, "verse_number": "१-४७-४८", "content_sanskrit": "जगतामुपकाराय तस्य कर्मनिमित्तजा  ।\nचेष्टा तस्याप्रमेयस्य व्यापिन्यविहितात्मिका ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001661048, "chapter_id": 21661, "verse_number": "१-४७-४९", "content_sanskrit": "तद्रू पं विश्वरूपस्य चिन्त्यं योगयुजा नृप  ।\nतस्य ह्यात्मविशुर्द्ध्य्थं सर्वकिल्बिषनाशनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001661049, "chapter_id": 21661, "verse_number": "१-४७-५०", "content_sanskrit": "यथाग्निरुद्धतशिखः कक्षं दहति सानिलः  ।\nतथा चित्तस्थितो विष्णुर्योगिनां सर्वकिल्बिषम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001661050, "chapter_id": 21661, "verse_number": "१-४७-५१", "content_sanskrit": "तस्मात्समस्तशक्तीनामाद्यान्ते तत्र चेतसः  ।\nकुर्वीत संस्थितं साधु विज्ञेया शुद्धलक्षणा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001661051, "chapter_id": 21661, "verse_number": "१-४७-५२", "content_sanskrit": "शुभाश्रयः सचित्तस्य सर्वगस्य तथात्मनः  ।\nत्रिभावभावनातीतो मुक्तये योगिनां नृप ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001661052, "chapter_id": 21661, "verse_number": "१-४७-५३", "content_sanskrit": "अन्ये तु पुरुषव्याघ्र चेतसो ये व्यपाश्रयाः  ।\nअशुद्धास्ते समस्तास्तु देवाद्याः कर्मयोनयः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001661053, "chapter_id": 21661, "verse_number": "१-४७-५४", "content_sanskrit": "मूर्त्तं भगवतो रूपं सर्वापाश्रयनिस्पृहः  ।\nएषा वै धारणा ज्ञेया यच्चित्तं तत्र धार्यते ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001661054, "chapter_id": 21661, "verse_number": "१-४७-५५", "content_sanskrit": "तत्र मूर्त्तं हरे रूपं यादृक् चिन्त्यं नराधिप  ।\nतच्छ्रूयतामनाधारे धारणा नोपपद्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001661055, "chapter_id": 21661, "verse_number": "१-४७-५६", "content_sanskrit": "प्रसन्नचारुवदनं पद्मपत्रायतेक्षणम्  ।\nसुकपोलं सुविस्तीर्णं ललाटफलकोज्ज्वलम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001661056, "chapter_id": 21661, "verse_number": "१-४७-५७", "content_sanskrit": "समकर्णांसविन्यस्तचारुकर्णोपभूषणम्  ।\nकम्बुग्रीवं सुविस्तीर्णश्रीवत्साङ्कितवक्षसम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001661057, "chapter_id": 21661, "verse_number": "१-४७-५८", "content_sanskrit": "बलित्रिभङ्गिना भुग्ननाभिना चोदरेण वै  ।\nप्रलम्बाष्टभुजं विष्णुमथवापि चतुर्भुजम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001661058, "chapter_id": 21661, "verse_number": "१-४७-५९", "content_sanskrit": "समस्थितोरुजघनं सुस्थिराङिघ्रकराम्बुजम्  ।\nचिन्तयेद्ब्रह्मभूतं तं पीतनिर्मलवाससम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001661059, "chapter_id": 21661, "verse_number": "१-४७-६०", "content_sanskrit": "किरीटचारुकेयूरकटकादिविभूषितम्  ।\nशार्ङ्गशङ्खगदाखड्गप्रकाशवलयाञ्चितम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001661060, "chapter_id": 21661, "verse_number": "१-४७-६१", "content_sanskrit": "चिन्तयेत्तन्मयो योगी समाधायात्ममानसम्  ।\nतावद्यावद् दृढीभूता तत्रैव नृप धारणा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001661061, "chapter_id": 21661, "verse_number": "१-४७-६२", "content_sanskrit": "वदतस्तिष्ठतो यद्वा स्वेच्छया कर्म कुर्वतः  ।\nनापयाति यदा चित्तात्सिद्धां मन्येत तां तदा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001661062, "chapter_id": 21661, "verse_number": "१-४७-६३", "content_sanskrit": "ततः शङ्खगदाचक्रशार्ङ्गादिरहितं बुधः  ।\nचिन्तयेद्भगवद्रू पं प्रशान्तं साक्षसूत्रकम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001661063, "chapter_id": 21661, "verse_number": "१-४७-६४", "content_sanskrit": "सा यदा धारणा तद्वदवस्थानवती ततः  ।\nकिरीटकेयूरमुखैर्भूषणैः रहितं स्मरेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001661064, "chapter_id": 21661, "verse_number": "१-४७-६५", "content_sanskrit": "तदेकावयवं चैवं चेतसा हि पुनर्बुधः  ।\nकुर्यात्ततोऽवयविनि प्रणिधानपरो भवेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001661065, "chapter_id": 21661, "verse_number": "१-४७-६६", "content_sanskrit": "तद्रू पप्रत्यये चैकसंनतिश्चान्यनिःस्पृहा  ।\nतद्ध्य्नां प्रथमैरङ्गैः षड्भिर्निष्पाद्यते नृप ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001661066, "chapter_id": 21661, "verse_number": "१-४७-६७", "content_sanskrit": "तस्यैवं कल्पनाहीनं स्वरूपग्रहणं हि यत्  ।\nमनसा ध्याननिष्पाद्यं समाधिः सोऽभिधीयते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001661067, "chapter_id": 21661, "verse_number": "१-४७-६८", "content_sanskrit": "विज्ञानं प्रापकं प्राप्ये परे ब्रह्मणि पार्थिव  ।\nप्रापणीयस्तथैवात्मा प्रक्षीणाशेषभावनः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001661068, "chapter_id": 21661, "verse_number": "१-४७-६९", "content_sanskrit": "क्षेत्रज्ञकरणीज्ञानं करणं तेन तस्य तत्  ।\nनिष्पाद्य मुक्तिकार्यं वै कृतकृत्यो निवर्तते ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001661069, "chapter_id": 21661, "verse_number": "१-४७-७०", "content_sanskrit": "तद्भावभावनापन्नस्ततोऽसौ परमात्मनः  ।\nभवत्यभेदी भेदश्च तस्याज्ञानकृतो भवेत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001661070, "chapter_id": 21661, "verse_number": "१-४७-७१", "content_sanskrit": "विभेदजनके ज्ञाने नाशमात्यन्तिकं गते  ।\nआत्मनो ब्रह्मणाभेदं संमतं कः करिष्यति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001661071, "chapter_id": 21661, "verse_number": "१-४७-७२", "content_sanskrit": "इत्युक्तस्ते मया योगः खाण्डिक्य परिपृच्छतः  ।\nसंक्षेपविस्तराभ्यां तु किमन्यत्क्रियतां तव ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001661072, "chapter_id": 21661, "verse_number": "१-४७-७३", "content_sanskrit": "खाण्डिक्य उवाच  ।\nकथितो योगसद्भावः सर्वमेव कृतं मम  ।\nतवोपदेशात्सकलो नष्टश्चित्तमलो मम ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001661073, "chapter_id": 21661, "verse_number": "१-४७-७४", "content_sanskrit": "ममेति यन्मया प्रोक्तमसदेतन्न चान्यथा  ।\nनरेन्द्र गदितुं शक्यमपि विज्ञेयवेदिभिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001661074, "chapter_id": 21661, "verse_number": "१-४७-७५", "content_sanskrit": "अहं ममेत्यविद्येयं व्यवहारस्तथानयोः  ।\nपरमार्थस्त्वसंलाप्यो वचसां गोचरो न यः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001661075, "chapter_id": 21661, "verse_number": "१-४७-७६", "content_sanskrit": "तद्गच्छ श्रेयसे सर्वं ममैतद्भवता कृतम्  ।\nयद्विमुक्तिपरो योगः प्रोक्तः केशिध्वजाव्ययः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001661076, "chapter_id": 21661, "verse_number": "१-४७-७७", "content_sanskrit": "सनन्दन उवाच-  ।\nयथार्हपूजया तेन खाण्डिक्येन स पूजितः  ।\nआजगाम पुरं ब्रह्मंस्ततः केशिध्वजो नृपः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001661077, "chapter_id": 21661, "verse_number": "१-४७-७८", "content_sanskrit": "खाण्डिक्योऽपि सुतं कृत्वा राजानं योगसिद्धये  ।\nविशालामगमत्कृष्णे समावेशितमानसः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001661078, "chapter_id": 21661, "verse_number": "१-४७-७९", "content_sanskrit": "स तत्रैकान्तिको भूत्वा यमादिगुणसंयुतः  ।\nविष्ण्वाख्ये निर्मले ब्रह्मण्यवाप नृपतिर्लयम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001661079, "chapter_id": 21661, "verse_number": "१-४७-८०", "content_sanskrit": "केशिध्वजोऽपि मुक्त्यर्थं स्वकर्मक्षपणोन्मुखः  ।\nबुभुजे विषयान्कर्म चक्रे चानभिसन्धितम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001661080, "chapter_id": 21661, "verse_number": "१-४७-८१", "content_sanskrit": "स कल्याणोपभोगैश्च क्षीणपापोऽमलस्ततः  ।\nअवाप सिद्धिमत्यन्तत्रितापक्षपणीं मुने ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001661081, "chapter_id": 21661, "verse_number": "१-४७-८२", "content_sanskrit": "एतत्ते कथितं सर्वं यन्मां त्वं परिपृष्टवान्  ।\nतापत्रयचिकित्सार्थं किमन्यत्कथयामि ते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]