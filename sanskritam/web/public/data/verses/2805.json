[{"id": 2084890, "chapter_id": 2805, "verse_number": "१२-३१०-०x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084891, "chapter_id": 2805, "verse_number": "१२-३१०-१", "content_sanskrit": "एवमप्रतिबुद्धत्वादबुद्धजनसेवनात्।\nसर्गकोटिसहस्राणि मरणान्तानि गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084892, "chapter_id": 2805, "verse_number": "१२-३१०-२", "content_sanskrit": "धाम्ना धामसहस्राणि पतनान्तानि गच्छति।\nतिर्यग्योनौ मनुष्यत्वे देवलोके तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084893, "chapter_id": 2805, "verse_number": "१२-३१०-३", "content_sanskrit": "चन्द्रमा इव भूतानां पुनस्तत्र सहस्रशः।\nलीयतेऽप्रतिबुद्धत्वादेवमेष ह्यबुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084894, "chapter_id": 2805, "verse_number": "१२-३१०-४", "content_sanskrit": "कला पञ्चदशी योनिस्तद्धाम इति मन्यते।\nनित्यमेतं विजानीहि सोमं वै षौडशीं कलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084895, "chapter_id": 2805, "verse_number": "१२-३१०-५", "content_sanskrit": "कलया जायते जन्तुः पुनः पुनरबुद्धिमान्।\nधाम तस्योपयुञ्जन्ति भूय एवोपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084896, "chapter_id": 2805, "verse_number": "१२-३१०-६", "content_sanskrit": "षोडशी तु कला सूक्ष्मा स सोम उपधार्यताम्।\nन तूपयुज्यते देवैर्देवानुपयुनक्ति सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084897, "chapter_id": 2805, "verse_number": "१२-३१०-७", "content_sanskrit": "एतामक्षपयित्वा हि जायते नृपसत्तम।\nसा ह्यस्य प्रकृतिर्दृष्टा तत्क्षयान्मोक्ष उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084898, "chapter_id": 2805, "verse_number": "१२-३१०-८", "content_sanskrit": "तदेवं षोडशकलं देहमव्यक्तसंज्ञिकम्।\nममायमिति मन्वानस्तत्रैव परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084899, "chapter_id": 2805, "verse_number": "१२-३१०-९", "content_sanskrit": "पञ्चविंशस्तथैवात्मा तस्यैवाप्रतिबोधनात्।\nविमलश्च विशुद्धश्च शुद्धामलनिषेवणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084900, "chapter_id": 2805, "verse_number": "१२-३१०-१०", "content_sanskrit": "अशुद्ध एव शुद्धात्मा तादृग्भवति पार्थिव।\nअबुद्धसेवनाच्चापि बुद्धोऽप्यबुद्धतां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084901, "chapter_id": 2805, "verse_number": "१२-३१०-११", "content_sanskrit": "तथैवाप्रतिबुद्धोऽपि विज्ञेयो नृपसत्तम।\nप्रकृतेस्त्रिगुणायास्तु सेवनात्प्राकृतो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084902, "chapter_id": 2805, "verse_number": "१२-३१०-१२x", "content_sanskrit": "करालजनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084903, "chapter_id": 2805, "verse_number": "१२-३१०-१२", "content_sanskrit": "अक्षरक्षरयोरेषु द्वयोः संबन्ध उच्यते।\nस्त्रीपुंसोश्चापि भगवन्संबन्धस्तद्वदुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084904, "chapter_id": 2805, "verse_number": "१२-३१०-१३", "content_sanskrit": "ऋते तु पुरुषं नेह स्त्री गर्भं धारयत्युत।\nऋते स्त्रियं न पुरुषो रूपं निर्वर्तयेत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084905, "chapter_id": 2805, "verse_number": "१२-३१०-१४", "content_sanskrit": "अन्योन्यस्याभिसंबन्धादन्योन्यगुणसंश्रयात्।\nरूपं निर्वर्तयत्येतदेवं सर्वासु योनिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084906, "chapter_id": 2805, "verse_number": "१२-३१०-१५", "content_sanskrit": "स्त्रीपुंसोरभिसंबन्धादन्योन्यगुणसंश्रयात्।\nऋतौ निर्वर्त्यते रूपं तद्वक्ष्यामि निदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084907, "chapter_id": 2805, "verse_number": "१२-३१०-१६", "content_sanskrit": "ये गुणाः पुरुषस्येह ये च मातृगुणास्तथा।\nअस्थि स्नायु च मज्जानं जानीमः पैतृकान्द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084908, "chapter_id": 2805, "verse_number": "१२-३१०-१७", "content_sanskrit": "त्वङ्भांसं शोणितं चेति मातृजान्यपि शुश्रुम।\nएवमेताद्द्विजश्रेष्ठ वेदे शास्त्रे च पठ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084909, "chapter_id": 2805, "verse_number": "१२-३१०-१८", "content_sanskrit": "प्रमाणं यच्च वेदोक्तं शास्त्रोक्तं यच्च पठ्यते।\nवेदशास्त्रप्रमाणानां प्रमाणं तत्सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084910, "chapter_id": 2805, "verse_number": "१२-३१०-१९", "content_sanskrit": "[अन्योन्यगुणसंरोधादन्योन्यगुणसंश्रयात्।]\nएवमेवाभिसंबद्धौ नित्यं प्रकृतिपूरुषौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084911, "chapter_id": 2805, "verse_number": "१२-३१०-२०", "content_sanskrit": "पश्यामि भगवंस्तस्मान्मोक्षधर्मो न विद्यते।\nअथवाऽनन्तरकृतं किंचिदेव निदर्शनम्।\nतन्ममाचक्ष्व तत्त्वेन प्रत्यक्षो ह्यसि सर्वथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084912, "chapter_id": 2805, "verse_number": "१२-३१०-२१", "content_sanskrit": "मोक्षकामा वयं चापि काङ्क्षामो यदनामयम्।\nअदेहमजरं नित्यमतीन्द्रियमनीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084913, "chapter_id": 2805, "verse_number": "१२-३१०-२२x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084914, "chapter_id": 2805, "verse_number": "१२-३१०-२२", "content_sanskrit": "यदेतदुक्तं भवता देवशास्त्रनिदर्शनम्।\nएवमेतद्यथा चैतन्न गृह्णाति तथा भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084915, "chapter_id": 2805, "verse_number": "१२-३१०-२३", "content_sanskrit": "धार्यते हि त्वया ग्रन्थ उभयोर्वेदशास्त्रयोः।\nन च ग्रन्थस्य तत्त्वज्ञो यथावत्त्वं नरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084916, "chapter_id": 2805, "verse_number": "१२-३१०-२४", "content_sanskrit": "यो हि वेदे च शास्त्रे च ग्रन्थधारणतत्परः।\nन च ग्रन्थार्थतत्त्वज्ञस्तस्य तद्वारणं वृथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084917, "chapter_id": 2805, "verse_number": "१२-३१०-२५", "content_sanskrit": "मारं स वहते तस्य ग्रन्थस्यार्थं न वेत्ति यः।\nयस्तु ग्रन्थार्थतत्त्वज्ञो नास्य ग्रन्थगुणो वृथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084918, "chapter_id": 2805, "verse_number": "१२-३१०-२६", "content_sanskrit": "ग्रन्थस्यार्थस्य पृष्टः संस्तादृशो वक्तुमर्हति।\nयथातत्त्वाभिगमनादर्थं तस्य स विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084919, "chapter_id": 2805, "verse_number": "१२-३१०-२७", "content_sanskrit": "वस्तु संसत्सु कथयेद्ग्रन्थार्थस्थूलबुद्धिमान्।\nस कथं मन्दविज्ञानो ग्रन्थं वक्ष्यति निर्णयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084920, "chapter_id": 2805, "verse_number": "१२-३१०-२८", "content_sanskrit": "निर्णयं चापि छिद्रात्मा न तं वक्ष्यति तत्त्वतः।\nसोपहास्यात्मतामेति यस्माच्चावाप्तवानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084921, "chapter_id": 2805, "verse_number": "१२-३१०-२९", "content_sanskrit": "तस्मात्त्वं शृणु राजेन्द्र यथैतदनुदृश्यते।\nयाथातथ्येन साङ्ख्येषु योगेषउ च महात्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084922, "chapter_id": 2805, "verse_number": "१२-३१०-३०", "content_sanskrit": "यदेव योगाः पश्यन्ति साङ्ख्यैस्तदवगम्यते।\nएकं साङ्ख्यं च योगं च यः पश्यति स बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084923, "chapter_id": 2805, "verse_number": "१२-३१०-३१", "content_sanskrit": "त्वङ्भांसं रुघिरं मेदः पित्तं मज्जा च स्नायु च।\nएतदैन्द्रियकं तात तद्भवानिदमाह माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084924, "chapter_id": 2805, "verse_number": "१२-३१०-३२", "content_sanskrit": "द्रव्याद्द्रव्यस्य निर्वृत्तिरिन्द्रियादिन्द्रियं तथा।\nदेहाद्देहमवाप्नोति बीजाद्वीजं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084925, "chapter_id": 2805, "verse_number": "१२-३१०-३३", "content_sanskrit": "निरिन्द्रियस्याबीजस्य निर्द्रव्यस्याप्यदेहिनः।\nकथं गुणा भविष्यन्ति निर्गुणत्वान्महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084926, "chapter_id": 2805, "verse_number": "१२-३१०-३४", "content_sanskrit": "गुणा गुणेषु जायन्ते तत्रैव निविशन्ति च।\nएवं गुणाः प्रकृतितो जायन्ते निविशन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084927, "chapter_id": 2805, "verse_number": "१२-३१०-३५", "content_sanskrit": "त्वङ्भांसं रुधिरं मेदः पित्तं मज्जाऽस्थि स्नायु च।\nअष्टौ तान्यथ शुक्रेण जानीहि प्राकृतानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084928, "chapter_id": 2805, "verse_number": "१२-३१०-३६", "content_sanskrit": "पुमांश्चैवापुमांश्चैव त्रैलिङ्ग्यं प्राकृतं स्मृतम्।\nन वा पुमान्पुमांश्चैव स लिङ्गीत्यभिधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084929, "chapter_id": 2805, "verse_number": "१२-३१०-३७", "content_sanskrit": "अलिङ्गात्प्रकृतिर्लिङ्गैरुपालभ्यति सात्मजैः।\nयथा पुष्पफलैर्नित्यमृतवो मूर्तयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084930, "chapter_id": 2805, "verse_number": "१२-३१०-३८", "content_sanskrit": "एवमप्यनुमानेन ह्यलिङ्गमुपलभ्यते।\nपञ्चविंशतिमस्तात लिङ्गेषु नियतात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084931, "chapter_id": 2805, "verse_number": "१२-३१०-३९", "content_sanskrit": "अनादिनिधनोऽनन्तः सर्वदर्शी निरामयः।\nकेवलं त्वभिमानित्वादगुणेष्वगुणा उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084932, "chapter_id": 2805, "verse_number": "१२-३१०-४०", "content_sanskrit": "गुणा गुणवतः सन्ति निर्गुणस्य कुतो गुणाः।\nतस्मादेवं विजानन्ति ये जना गुणदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084933, "chapter_id": 2805, "verse_number": "१२-३१०-४१", "content_sanskrit": "यदा त्वेष गुणनिव प्रकृतावनुमन्यते।\nतदा स गुणवानेव परमं नानुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084934, "chapter_id": 2805, "verse_number": "१२-३१०-४२", "content_sanskrit": "यत्तं बुद्धेः परं प्राहुः साङ्ख्ययोगाश्च सर्वशः।\nबुध्यमानं महाप्राज्ञमबुद्धपरिवर्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084935, "chapter_id": 2805, "verse_number": "१२-३१०-४३", "content_sanskrit": "अप्रबुद्धमथाव्यक्तं गुणं प्राहुरनीश्वरम्।\nनिर्गुणं चेश्वरं नित्यमधिष्ठातारमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084936, "chapter_id": 2805, "verse_number": "१२-३१०-४४", "content_sanskrit": "प्रकृतेश्च गुणानां च पञ्चविंशतिकं बुधाः।\nसाङ्ख्ययोगे च कुशला बुध्यन्ते परमैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084937, "chapter_id": 2805, "verse_number": "१२-३१०-४५", "content_sanskrit": "यदा प्रबुद्धास्त्वव्यक्तमवस्थाजन्मभीरवः।\nबुध्यमानं प्रबुद्धेन गमयन्ति समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084938, "chapter_id": 2805, "verse_number": "१२-३१०-४६", "content_sanskrit": "एतन्निदर्शनं सम्यगसम्यक्चार्थदर्शनम्।\nबुध्यमानाप्रबुद्धाना पृथग्पृथगरिंदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084939, "chapter_id": 2805, "verse_number": "१२-३१०-४७", "content_sanskrit": "परस्परेणैतदुक्तं क्षराक्षरनिदर्शनम्।\nएकत्वमक्षरं प्राहुर्नानात्वं क्षरमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084940, "chapter_id": 2805, "verse_number": "१२-३१०-४८", "content_sanskrit": "पञ्चविंशतिनिष्ठोऽयं यदा सम्यक्प्रचक्षते।\nएकत्वं दर्शनं चास्य नानात्वं चाप्यदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084941, "chapter_id": 2805, "verse_number": "१२-३१०-४९", "content_sanskrit": "तत्त्वनिस्तत्त्वयोरेतत्पृथग्नेव निदर्शनम्।\nपञ्चविंशतितत्वं तु तत्त्वमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2084942, "chapter_id": 2805, "verse_number": "१२-३१०-५०", "content_sanskrit": "निस्तत्त्वं पञ्चविंशस्य परमाहुर्निदर्शनम्।\nवर्गस्य वर्गमाचारं तत्त्वं तत्त्वात्सनातनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2084943, "chapter_id": 2805, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि दशाधिकत्रिशततमोऽध्यायः॥ ३१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]