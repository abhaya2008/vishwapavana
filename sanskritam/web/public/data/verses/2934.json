[{"id": 2090961, "chapter_id": 2934, "verse_number": "१३-६४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nतीर्थानां दर्शनं श्रेयः स्नानं च भरतर्षभ।\nश्रवणं च महाप्राज्ञ श्रोतुमिच्छामि तत्त्वतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090962, "chapter_id": 2934, "verse_number": "१३-६४-२", "content_sanskrit": "पृथिव्यां यानि तीर्थानि पुण्यानि भरतर्षभ।\nवक्तुमर्हसि मे तानि श्रोताऽस्मि नियतं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090963, "chapter_id": 2934, "verse_number": "१३-६४-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090964, "chapter_id": 2934, "verse_number": "१३-६४-३", "content_sanskrit": "इममङ्गिरसा प्रोक्तं तीर्थवंशं महाद्युते।\nश्रोतुमर्हसि भद्रं ते प्राप्स्यसे धर्ममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090965, "chapter_id": 2934, "verse_number": "१३-६४-४", "content_sanskrit": "तपोवनगतं विप्रमभिगम्य महामुनिम्।\nपप्रच्छाङ्गिरसं धीरं गौतमः संशितव्रतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090966, "chapter_id": 2934, "verse_number": "१३-६४-५", "content_sanskrit": "अस्ति मे भगवन्कश्चित्तीर्थेभ्यो धर्मसंशयः।\nतत्सर्वं श्रोतुमिच्छामि तन्मे शंस महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090967, "chapter_id": 2934, "verse_number": "१३-६४-६", "content_sanskrit": "उपस्पृश्य फलं किं स्यात्तेषु तीर्थेषु वै मुने।\nप्रेत्यभावे महाप्राज्ञ तद्यथाऽस्ति तथा वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090968, "chapter_id": 2934, "verse_number": "१३-६४-७x", "content_sanskrit": "अङ्गिरा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090969, "chapter_id": 2934, "verse_number": "१३-६४-७", "content_sanskrit": "सप्ताहं चन्द्रभागां वै वितस्तामूर्मिमालिनीम्।\nविगाह्य वै निराहारो निर्मलो मुनिवद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090970, "chapter_id": 2934, "verse_number": "१३-६४-८", "content_sanskrit": "काश्मीरमण्डले नद्यो याः पतन्ति महास्वनम्।\nता नदीः सिन्धुमासाद्य शीलवान्स्वर्गमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090971, "chapter_id": 2934, "verse_number": "१३-६४-९", "content_sanskrit": "पुष्करं च प्रभासं च नैमिषं सागरोदकम्।\nदेविकामिन्द्रमार्गं च स्वर्णबिन्दुं विगाह्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090972, "chapter_id": 2934, "verse_number": "१३-६४-१०", "content_sanskrit": "विबोध्यते विमानस्थः सोऽप्सरोभिरभिष्टुतः।\nहिरण्यबिन्दुमालक्ष्य प्रयतश्चाभिवाद्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090973, "chapter_id": 2934, "verse_number": "१३-६४-११", "content_sanskrit": "कुशेशये च देवत्वं धूयते तस्य किल्बिषम्।\nइन्द्रतोयां समासाद्य गन्धमादनसन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090974, "chapter_id": 2934, "verse_number": "१३-६४-१२", "content_sanskrit": "करतोयां कुरुङ्गे च त्रिरात्रोपोषितो नरः।\nअश्वमेधमवाप्नोति विगाह्य प्रयतः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090975, "chapter_id": 2934, "verse_number": "१३-६४-१३", "content_sanskrit": "गङ्गाद्वारे कुशावर्ते बिल्वके नीलपर्वते।\nतथा कनखले स्नात्वा धूतपाप्मा दिवं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090976, "chapter_id": 2934, "verse_number": "१३-६४-१४", "content_sanskrit": "अपां ह्रद उपस्पृश्य वाजिमेधफलं लभेत्।\nब्रह्मचारी जितक्रोधः सत्यसन्धस्त्वहिंसकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090977, "chapter_id": 2934, "verse_number": "१३-६४-१५", "content_sanskrit": "यत्र भागीरथी गङ्गा वहते दिशमुत्तरम्।\nमहेश्वरस्य त्रिस्थाने यो नरस्त्वभिषिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090978, "chapter_id": 2934, "verse_number": "१३-६४-१६", "content_sanskrit": "एकमासं निराहारः स पश्यति हि देवताः।\nसप्तगङ्गे त्रिगङ्गे च इन्द्रमार्गे च तर्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090979, "chapter_id": 2934, "verse_number": "१३-६४-१७", "content_sanskrit": "अर्थान्वै लभते भोक्तुं यो नरो जायते पुनः।\nमहाश्रम उपस्पृश्य योऽग्निहोत्रपरः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090980, "chapter_id": 2934, "verse_number": "१३-६४-१८", "content_sanskrit": "एकमासं निराहारः सिद्धिं मासेन स व्रजेत्।\nमहाह्रद उपस्पृश्य भृगुतुङ्गे त्वलोलुपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090981, "chapter_id": 2934, "verse_number": "१३-६४-१९", "content_sanskrit": "त्रिरात्रोपोषितो भूत्वा मुच्यते ब्रह्महत्यया।\nकन्याकूप उपस्पृश्य बलाकायां कृतोदकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090982, "chapter_id": 2934, "verse_number": "१३-६४-२०", "content_sanskrit": "देवेषु लभते कीर्तिं यशसा च विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090983, "chapter_id": 2934, "verse_number": "१३-६४-२१", "content_sanskrit": "देविकायामुपस्पृश्य तथा सुन्दरिकाह्रदे।\nअश्विन्यां रूपवर्चस्कं प्रेत्य वै लभते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090984, "chapter_id": 2934, "verse_number": "१३-६४-२२", "content_sanskrit": "महागङ्गामुपस्पृश्य कृत्तिकाङ्गारके तथा।\nपक्षमेकं निराहारः स्वर्गमाप्नोति निर्मलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090985, "chapter_id": 2934, "verse_number": "१३-६४-२३", "content_sanskrit": "वैमानिक उपस्पृश्य किङ्किणीकाश्रमे तथा।\nनिवासेऽप्सरसां दिव्ये कामचारी महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090986, "chapter_id": 2934, "verse_number": "१३-६४-२४", "content_sanskrit": "कालिकाश्रममासाद्य विपाशायां कृतोदकः।\nब्रह्मचारी जितक्रोधस्त्रिरात्रं मुच्यते भवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090987, "chapter_id": 2934, "verse_number": "१३-६४-२५", "content_sanskrit": "आश्रमे कृत्तिकानां तु स्नात्वा यस्तर्पयेत्पितॄन्।\nतोषयित्वा महादेवं निर्मलः स्वर्गमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090988, "chapter_id": 2934, "verse_number": "१३-६४-२६", "content_sanskrit": "महाकूपमुपस्पृश्य त्रिरात्रोपोषितः शुचिः।\nत्रसानां स्थावराणां च द्विपदानां भयं त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090989, "chapter_id": 2934, "verse_number": "१३-६४-२७", "content_sanskrit": "देवदारुवने स्नात्वा धूतपाप्मा कृतोदकः।\nदेवशब्दमवाप्नोति सप्तरात्रोषितः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090990, "chapter_id": 2934, "verse_number": "१३-६४-२८", "content_sanskrit": "शरस्तम्बे कुशस्तम्बे द्रोणशर्मपदे तथा।\nअपांप्रपतनासेवी सेव्यते सोप्सरोगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090991, "chapter_id": 2934, "verse_number": "१३-६४-२९", "content_sanskrit": "चित्रकूटे जनस्थाने तथा मन्दाकिनीजले।\nविगाह्य वै निराहारो राजलक्ष्म्या निषेव्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090992, "chapter_id": 2934, "verse_number": "१३-६४-३०", "content_sanskrit": "श्यामायास्त्वाश्रमं गत्वा उषित्वा चाभिषिच्य च।\nएकपक्षं निराहारस्त्वन्तर्धानफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090993, "chapter_id": 2934, "verse_number": "१३-६४-३१", "content_sanskrit": "कौशिकीं तु समासाद्य वायुभक्षस्त्वलोलुपः।\nएकविंशतिरात्रेण स्वर्गमारोहते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090994, "chapter_id": 2934, "verse_number": "१३-६४-३२", "content_sanskrit": "मतङ्गवाप्यां यः स्नायादेकरात्रेण सिध्यति।\nविगाहति ह्यनालम्बमन्धकं वै सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090995, "chapter_id": 2934, "verse_number": "१३-६४-३३", "content_sanskrit": "नैमिषे स्वर्गतीर्थे च उपस्पृश्य जितेन्द्रियः।\nफलं पुरुषमेधस्य लभेन्मासं कृतोदकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090996, "chapter_id": 2934, "verse_number": "१३-६४-३४", "content_sanskrit": "गङ्गाह्रद उपस्पृस्य तथा चैवोत्पलावने।\nअश्वमेघमवाप्नोति तत्र मासं कृतोदकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090997, "chapter_id": 2934, "verse_number": "१३-६४-३५", "content_sanskrit": "गङ्गायमुनयोस्तीर्थे तथा कालञ्जरे गिरौ।\nदशाश्वमेधानाप्नोति तत्र मासं कृतोदकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090998, "chapter_id": 2934, "verse_number": "१३-६४-३६", "content_sanskrit": "यष्टिह्रद उपस्पृश्य चान्नदानाद्विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090999, "chapter_id": 2934, "verse_number": "१३-६४-३७", "content_sanskrit": "दशतीर्थसहस्राणि तिस्रः कोट्यस्तथाऽपराः।\nसमागच्छन्ति माघ्यां तु प्रयागे भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2091000, "chapter_id": 2934, "verse_number": "१३-६४-३८", "content_sanskrit": "माघमासं प्रयागे तु नियतः संशितव्रतः।\nस्नात्वा तु भरतश्रेष्ठ निर्मलः स्वर्गमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2091001, "chapter_id": 2934, "verse_number": "१३-६४-३९", "content_sanskrit": "मरुद्गण उपस्पृश्य पितॄणामाश्रमे शुचिः।\nवैवस्वतस्य तीर्थे च तीर्थभूतो भवेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2091002, "chapter_id": 2934, "verse_number": "१३-६४-४०", "content_sanskrit": "तथा ब्रह्मसरो गत्वा भागीरथ्यां कृतोदकः।\nएकमासं निराहारः सोमलोकमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2091003, "chapter_id": 2934, "verse_number": "१३-६४-४१", "content_sanskrit": "उत्पातके नरः स्नात्वा अष्टावक्रे कृतोदकः।\nद्वादशाहं निराहारो नरमेधफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2091004, "chapter_id": 2934, "verse_number": "१३-६४-४२", "content_sanskrit": "अश्मपृष्ठे गयायां च निरविन्दे च पर्वते।\nतृतीयां क्रौञ्चपद्यां च ब्रह्महत्यां विशुध्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2091005, "chapter_id": 2934, "verse_number": "१३-६४-४३", "content_sanskrit": "कलविङ्क उपस्पृश्य विद्याच्च बहुशो जलम्।\nअग्नेः पुरे नरः स्नात्वा अग्निकन्यापुरे वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2091006, "chapter_id": 2934, "verse_number": "१३-६४-४४", "content_sanskrit": "करवीरपुरे स्नात्वा विशालायां कृतोदकः।\nदेवह्रद उपस्पृश्य ब्रह्मभूतो विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2091007, "chapter_id": 2934, "verse_number": "१३-६४-४५", "content_sanskrit": "पुनरावर्तनन्दां च महानन्दां च सेव्य वै।\nनन्दने सेव्यते दान्तस्त्वप्सरोभिरहिंसकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2091008, "chapter_id": 2934, "verse_number": "१३-६४-४६", "content_sanskrit": "उर्वशीं कृत्तिकायोगे गत्वा चैव समाहितः।\nलौहित्ये विधिवत्स्नात्वा पुण्डरीकफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2091009, "chapter_id": 2934, "verse_number": "१३-६४-४७", "content_sanskrit": "रामह्रद उपस्पृश्य विपाशायां कृतोदकः।\nद्वादशाहं निराहारः कल्मषाद्विप्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2091010, "chapter_id": 2934, "verse_number": "१३-६४-४८", "content_sanskrit": "महाह्रद उपस्पृश्य शुद्धेन मनसा नरः।\nएकमासं निराहारो जमदग्निगतिं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2091011, "chapter_id": 2934, "verse_number": "१३-६४-४९", "content_sanskrit": "विन्ध्ये संताप्य चात्मानं सत्यसन्धस्त्वहिंसकः।\nविनयात्तप आस्थाय मासेनैकेन सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2091012, "chapter_id": 2934, "verse_number": "१३-६४-५०", "content_sanskrit": "`मुण्डे ब्रह्मगवा चैव निरिचिं देवपर्वतम्।\nदेवह्रदमुपस्पृश्य ब्रह्मभूतो विराजते।\nकुमारपदमास्थाय मासेनैकेन शुध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2091013, "chapter_id": 2934, "verse_number": "१३-६४-५१", "content_sanskrit": "नर्मदायामुपस्पृश्य तता शूर्पारकोदके।\nएकपक्षं निराहारो राजपुत्रो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2091014, "chapter_id": 2934, "verse_number": "१३-६४-५२", "content_sanskrit": "जम्बूमार्गे त्रिभिर्मासैः संयतः सुसमाहितः।\nअहोरात्रेण चैकेन सिद्धिं समधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2091015, "chapter_id": 2934, "verse_number": "१३-६४-५३", "content_sanskrit": "कोकामुखे विगाह्याथ गत्वा चाञ्जलिकाश्रमम्।\nशाकभक्षश्चीरवासाः कुमारीर्विन्दते दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2091016, "chapter_id": 2934, "verse_number": "१३-६४-५४", "content_sanskrit": "वैवस्वतस्य सदनं न स गच्छेत्कदाचन।\nयस्य कन्याह्रद वासो देवलोकं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2091017, "chapter_id": 2934, "verse_number": "१३-६४-५५", "content_sanskrit": "प्रभासे त्वेकरात्रेण अमावास्यां ममाहितः।\nसिद्ध्यते तु महाबाहो यो नरो जायतेऽमरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2091018, "chapter_id": 2934, "verse_number": "१३-६४-५६", "content_sanskrit": "उज्जानक उपस्पृस्य आर्ष्टिषेणस्य चाश्रमे।\nपिङ्गायाश्चाश्रमे स्नात्वा सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2091019, "chapter_id": 2934, "verse_number": "१३-६४-५७", "content_sanskrit": "कुल्यायां समुपस्पृश्य जप्त्वा चैवाघमर्षणम्।\nअश्वमेधमवाप्नोति त्रिरात्रोपोषितो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2091020, "chapter_id": 2934, "verse_number": "१३-६४-५८", "content_sanskrit": "पिण्डारक उपस्पृश्य एकरात्रोषितो नरः।\nअग्निष्टोममवाप्नोति प्रभातां शर्वरीं शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2091021, "chapter_id": 2934, "verse_number": "१३-६४-५९", "content_sanskrit": "तथा ब्रह्मसरो गत्वा धर्मारण्योपशोभितम्।\nपुण्डरीकमवाप्नोति उपस्पृश्य नरः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2091022, "chapter_id": 2934, "verse_number": "१३-६४-६०", "content_sanskrit": "मैनाके पर्वते स्नात्वा तथा सन्ध्यामुपास्य च।\nकामं जित्वा च वै मासं सर्वयज्ञफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2091023, "chapter_id": 2934, "verse_number": "१३-६४-६१", "content_sanskrit": "कालोदकं नन्दिकुण्डं तथा चोत्तरमानसम्।\nअभ्येत्य योजनशताद्भूणहा विप्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2091024, "chapter_id": 2934, "verse_number": "१३-६४-६२", "content_sanskrit": "नन्दीश्वरस्य मूर्ति तु दृष्ट्वा मुच्येत किल्बिषैः।\nस्वर्गमार्गे नरः स्नात्वा ब्रह्मलोकं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2091025, "chapter_id": 2934, "verse_number": "१३-६४-६३", "content_sanskrit": "विख्यातो हिमवान्पुण्यः शंकरश्वशुरो गिरिः।\nआकरः सर्वरत्नानां सिद्धचारणसेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2091026, "chapter_id": 2934, "verse_number": "१३-६४-६४", "content_sanskrit": "`दर्शनाद्गमनात्पूतो भवेदनशनादपि।\nशरीरमुत्सृजेत्तत्र विधिपूर्वमनाशके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2091027, "chapter_id": 2934, "verse_number": "१३-६४-६५", "content_sanskrit": "अध्रुवं जीवितं ज्ञात्वा यो वै वेदान्तगो द्विजः।\nअभ्यर्च्य देवतास्तत्र नमस्कृत्य मुनींस्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2091028, "chapter_id": 2934, "verse_number": "१३-६४-६६", "content_sanskrit": "ततः क्रोधं च लोभं च यो जित्वा तीर्थमावसेत्।\nन तेन किञ्चिन्न प्राप्तं तीर्थाभिगमनाद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2091029, "chapter_id": 2934, "verse_number": "१३-६४-६७", "content_sanskrit": "यान्यगम्यानि तीर्थानि दुर्गाणि विषमाणि च।\nमनसा तानि गम्यानि सर्वतीर्थसमीक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2091030, "chapter_id": 2934, "verse_number": "१३-६४-६८", "content_sanskrit": "इदं मेध्यमिदं पुण्यमिदं स्वर्ग्यमनुत्तमम्।\nइदं रहस्यं वेदानामाप्लाव्यं पावनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2091031, "chapter_id": 2934, "verse_number": "१३-६४-६९", "content_sanskrit": "इदं दद्याद्द्विजातीनां साधोरात्महितस्य च।\nसुहृदां च जपेत्कर्णे शिष्यस्यानुगतस्य च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2091032, "chapter_id": 2934, "verse_number": "१३-६४-७०", "content_sanskrit": "दत्तवान्गौतमस्यैतदङ्गिरा वै महातपाः।\nअङ्गिराः समनुज्ञातः काश्यपेन च धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2091033, "chapter_id": 2934, "verse_number": "१३-६४-७१", "content_sanskrit": "महर्षीणामिदं जप्यं पावनानां तथोत्तमम्।\nजपंश्चाभ्युत्थितः शश्वन्निर्मलः स्वर्गमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2091034, "chapter_id": 2934, "verse_number": "१३-६४-७२", "content_sanskrit": "इदं यश्चापि शृणुयाद्रहस्यं त्वङ्गिरोमतम्।\nउत्तमे च कुले जन्म लभेञ्जातीश्च संस्मरेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2091035, "chapter_id": 2934, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुसासनपर्वणि दानधर्मपर्वणि चतुःषष्टितमोऽध्यायः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]