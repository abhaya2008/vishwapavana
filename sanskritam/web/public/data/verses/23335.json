[{"id": 7003335000, "chapter_id": 23335, "verse_number": "२-३०-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nअधुना संप्रवक्ष्यामि तिलपर्वतमुत्तमम् ।\nपूर्वोक्तस्थानकाले तु कृत्वा संपूज्य यत्नतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003335001, "chapter_id": 23335, "verse_number": "२-३०-२", "content_sanskrit": "सुसमे भूतले रम्ये वेदिना च विवर्जिते ।\nदशतालप्रमाणएन दंडं संस्थाप्य वै मुने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003335002, "chapter_id": 23335, "verse_number": "२-३०-३", "content_sanskrit": "अद्भिः संप्रोक्ष्य पश्चाद्धि तिलांस्त्वस्मिन्विनिक्षिपेत् ।\nपंचगव्येन तं देशं प्रोक्षयेद्ब्राह्मणोत्तमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003335003, "chapter_id": 23335, "verse_number": "२-३०-४", "content_sanskrit": "मंडलं कल्पयेद्विद्वान्पूर्ववत्सुसमंततः ।\nनववस्त्रैश्च संस्थाप्य रम्यपुष्पैर्विकीर्य च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003335004, "chapter_id": 23335, "verse_number": "२-३०-५", "content_sanskrit": "तस्मिन्संचयनं कार्यं तिलभारैर्विशेषतः ।\nदंडप्रादेशमुत्सेधमुत्तमं परिकीर्तितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003335005, "chapter_id": 23335, "verse_number": "२-३०-६", "content_sanskrit": "चतुरंगुलहीनं तु मध्यमं मुनिपुंगवाः ।\nदंडतुल्यं कनिष्ठं स्याद्दंडहीनं न कारयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003335006, "chapter_id": 23335, "verse_number": "२-३०-७", "content_sanskrit": "वेष्टयित्वा नवैर्वस्त्रैः परितः पूजयेत्क्रमात् ।\nसद्यादीनि प्रविन्यस्य पूजयेद्विधिपूर्वकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003335007, "chapter_id": 23335, "verse_number": "२-३०-८", "content_sanskrit": "अष्टदिक्षु च कर्तव्याः पूर्वोक्ता मूर्तयः क्रमात् ।\nत्रिनिष्केन सुवर्णेन प्रत्येकं कारयेत्क्रमात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003335008, "chapter_id": 23335, "verse_number": "२-३०-९", "content_sanskrit": "दक्षिणा विधिना कार्या तुलाभारवदेव तु ।\nहोमश्चपूर्ववत्प्रोक्तो यथावन्मुनिसत्तमाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003335009, "chapter_id": 23335, "verse_number": "२-३०-१०", "content_sanskrit": "अर्चयेद्देवदेवेशं लोकपालसमावृतम् ।\nतिलपर्वतमध्यस्थं तिलपर्वतरूपिणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003335010, "chapter_id": 23335, "verse_number": "२-३०-११", "content_sanskrit": "शिवार्चना च कर्तव्या सहस्रकलशादिभिः ।\nदर्शयेत्तिलमध्यस्थं देवदेवमुमापतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003335011, "chapter_id": 23335, "verse_number": "२-३०-१२", "content_sanskrit": "पूजयित्वा विधानेन क्रमेण च विसर्जयेत् ।\nश्रोत्रियाय दरिद्राय दापयेत्तिलपर्वतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003335012, "chapter_id": 23335, "verse_number": "२-३०-१३", "content_sanskrit": "एवं तिलनगः प्रोक्तः सर्वस्मादधिकः परः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]