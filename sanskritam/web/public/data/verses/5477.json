[{"id": 2209456, "chapter_id": 5477, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209457, "chapter_id": 5477, "verse_number": "१", "content_sanskrit": "तान् समीपगतान् श्रुत्वा पाण्डवान् शत्रुकर्शनः ।\nवासुदेवः सहामात्यः प्रत्युद्यातो दिदृक्षया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209458, "chapter_id": 5477, "verse_number": "२", "content_sanskrit": "ते समेत्य यथान्यायं पाण्डवा वृष्णिभिः सह ।\nविविशुः सहिता राजन् पुरं वारणसाह्वयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209459, "chapter_id": 5477, "verse_number": "३", "content_sanskrit": "महतस्तस्य सैन्यस्य रथनेमिस्वनेन च ।\nद्यावापृथिव्यौ खं चैव शब्देनासीत् समावृतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209460, "chapter_id": 5477, "verse_number": "४", "content_sanskrit": "ते कोशमग्रतः कृत्वा विविशुः स्वपुरं तदा ।\nपाण्डवाः प्रीतमनसः सामात्याः ससुहृद्गणाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209461, "chapter_id": 5477, "verse_number": "५", "content_sanskrit": "ते समेत्य यथान्यायं धृतराष्ट्रं जनेश्वरम् ।\nकीर्तयन्तः स्वनामानि तस्य पादौ ववन्दिरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209462, "chapter_id": 5477, "verse_number": "६", "content_sanskrit": "धृतराष्ट्रस्यानुमते गान्धारीं सुबलात्मजाम् ।\nकुन्तीं च राजशार्दूल तदा भरतसत्तमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209463, "chapter_id": 5477, "verse_number": "७", "content_sanskrit": "विदुरं पूजयित्वा च वैश्यापुत्रं समेत्य च ।\nपूज्यमानास्तु ते वीरा व्यराजन्त विशाम्पते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209464, "chapter_id": 5477, "verse_number": "८", "content_sanskrit": "ततस्तत् परमाश्चर्यं विचित्रं महदद्भुतम् ।\nशुश्रुवुस्ते महावीराः पितुस्ते जन्म भारत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209465, "chapter_id": 5477, "verse_number": "९", "content_sanskrit": "तदुपश्रुत्य ते कर्म वासुदेवस्य धीमतः ।\nपूजार्हं पूजयामासुः कृष्णं देवकिनन्दनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209466, "chapter_id": 5477, "verse_number": "१०", "content_sanskrit": "ततः कतिपयाहस्सु व्यासः सत्यवतीसुतः ।\nआजगाम महातेजा नगरं नागसाह्वयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209467, "chapter_id": 5477, "verse_number": "११", "content_sanskrit": "तस्य सर्वे यथान्यायं पूजां चक्रुः कुरूद्वहाः ।\nसह वृष्ण्यन्धकव्याघ्रैः उपासाञ्चक्रिरे तदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209468, "chapter_id": 5477, "verse_number": "१२", "content_sanskrit": "तत्र नानाविधाकाराः कथाः समनुकीर्त्य वै ।\nयुधिष्ठिरो धर्मसुतो व्यासं वचनमब्रवीत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209469, "chapter_id": 5477, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209470, "chapter_id": 5477, "verse_number": "१३", "content_sanskrit": "भवत्प्रसादाद् भगवन् यदिदं रत्नमाहृतम् ।\nउपयोक्तुं तदिच्छामि वाजिमेधे महाक्रतौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209471, "chapter_id": 5477, "verse_number": "१४", "content_sanskrit": "तदनुज्ञातुमिच्छामि भवता मुनिसत्तम ।\nत्वदधीना वयं सर्वे कृष्णेन च महात्मना ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209472, "chapter_id": 5477, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209473, "chapter_id": 5477, "verse_number": "१५", "content_sanskrit": "अनुजानामि राजंस्त्वं क्रियतां यदनन्तरम् ।\nयजस्व वाजिमेधेन विधिवद् दक्षिणावता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209474, "chapter_id": 5477, "verse_number": "१६", "content_sanskrit": "अश्वमेधो हि राजेन्द्र पावनः सर्वपाप्मनाम् ।\nतेनेष्ट्वा त्वं विपाप्मा वै भविता नात्र संशयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209475, "chapter_id": 5477, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209476, "chapter_id": 5477, "verse_number": "१७", "content_sanskrit": "इत्युक्तः स तु धर्मात्मा कुरुराजो युधिष्ठिरः ।\nअश्वमेधस्य कौरव्य चकाराहरणे मतिम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209477, "chapter_id": 5477, "verse_number": "१८", "content_sanskrit": "समनुज्ञाप्य तु स तं कृष्णद्वैपायनं नृप ।\nवासुदेवमथामन्त्र्य वाग्मी वचनमब्रवीत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209478, "chapter_id": 5477, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209479, "chapter_id": 5477, "verse_number": "१९", "content_sanskrit": "देवकी सुप्रजा देव त्वया पुरुषसत्तम ।\nयद् ब्रूयास्त्वं महाबाहो तत् कुर्यामहमच्युत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209480, "chapter_id": 5477, "verse_number": "२०", "content_sanskrit": "त्वं गतिः सर्वभूतानामिति मे निश्चिता मतिः ।\nत्वत्प्रभावार्जितान् भोगानश्नीमो यदुनन्दन ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209481, "chapter_id": 5477, "verse_number": "२१", "content_sanskrit": "पराक्रमेण बुद्ध्या च तवेयं निर्जिता मही ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209482, "chapter_id": 5477, "verse_number": "२२", "content_sanskrit": "दीक्षयस्व त्वमात्मानं त्वं हि नः परमो गुरुः ।\nत्वयीष्टवति धर्मज्ञ विपाप्मा स्यामहं विभो ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209483, "chapter_id": 5477, "verse_number": "२३", "content_sanskrit": "त्वं हि यज्ञोऽक्षरःशब्दो धर्मज्ञस्त्वं प्रजापतिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209484, "chapter_id": 5477, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209485, "chapter_id": 5477, "verse_number": "२४", "content_sanskrit": "त्वमेवैतन्महाबाहो वक्तुमर्हस्यरिन्दम ।\nत्वं गतिः सर्वभूतानामिति मे निश्चिता मतिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209486, "chapter_id": 5477, "verse_number": "२५", "content_sanskrit": "त्वं चाद्य कुरुवीराणां धर्मेणाति विराजसे ।\nगुरुभूतस्तु मे राजन् त्वं नो राजा मतो गुरुः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209487, "chapter_id": 5477, "verse_number": "२६", "content_sanskrit": "यजस्व वाजिमेधेन प्राप्त एष क्रतुस्त्वया ।\nयुनक्तु नो भवान् कार्ये यत्र वाञ्छति भारत ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209488, "chapter_id": 5477, "verse_number": "२७", "content_sanskrit": "सत्यं ते प्रतिजानामि सर्वं कर्तास्मि तेऽनघ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209489, "chapter_id": 5477, "verse_number": "२८", "content_sanskrit": "भीमसेनार्जुनौ चैव तथा माद्रवतीसुतौ ।\nइष्टवन्तो भविष्यन्ति त्वयीष्टवति पार्थिव ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209490, "chapter_id": 5477, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि दीक्षां कुर्वति कृष्णवचनं नाम एकसप्ततितमोऽध्यायः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]