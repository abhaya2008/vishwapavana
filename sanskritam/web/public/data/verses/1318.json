[{"id": 2015226, "chapter_id": 1318, "verse_number": "२-५९-१", "content_sanskrit": "भीष्म उवाच॥\nततः सर्वदशार्हाणामाहुकस्य च याः स्त्रियः।\nनन्दगोपस्य महिषी यशोदा लोकविश्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015227, "chapter_id": 1318, "verse_number": "२-५९-२", "content_sanskrit": "रेवती च महाभागा रुक्मिणी च पत्रिव्रता।\nसत्या जाम्बवती चोभे गान्धारी शिंशुमापि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015228, "chapter_id": 1318, "verse_number": "२-५९-३", "content_sanskrit": "विशोका लक्षणा चापि सुमित्रा केतुमा तथा।\nवासुदेवमहिष्योऽन्याः श्रिया सार्धं ययुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015229, "chapter_id": 1318, "verse_number": "२-५९-४", "content_sanskrit": "विभूतिं द्रष्टुमनसः केशवस्य महात्मनः।\nप्रीयमाणाः सभां जग्मुरालोकयितुमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015230, "chapter_id": 1318, "verse_number": "२-५९-५", "content_sanskrit": "देवकी सर्वदेवीनां रोहिणी च पुरस्कृता।\nददृशुर्देवमासीनं कृष्णं हलभृता सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015231, "chapter_id": 1318, "verse_number": "२-५९-६", "content_sanskrit": "तौ तु पूर्वमतिक्रम्य रोहिणीमभिवाद्य च।\nअभ्यवादयतां देवौ देवकीं रामकेशवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015232, "chapter_id": 1318, "verse_number": "२-५९-७", "content_sanskrit": "सा ताभ्यामृषभाक्षाभ्यां पुत्राभ्यां शुशुभेऽधिकम्।\nदेवकी देवमातेव मित्रेण वरुणेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015233, "chapter_id": 1318, "verse_number": "२-५९-८", "content_sanskrit": "ततः प्राप्ता यशोदाया दुहिता वै क्षणेन हि।\nजाज्वल्यमाना वपुषा प्रभयाऽतीव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015234, "chapter_id": 1318, "verse_number": "२-५९-९", "content_sanskrit": "एकानङ्गेति यामाहुः कन्यां वै कामरूपिणीम्।\nयत्कृते सगणं कंसं जघान पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015235, "chapter_id": 1318, "verse_number": "२-५९-१०", "content_sanskrit": "ततः स भगवान्रामस्तामुपाक्रम्य भामिनाम्।\nमूर्ध्न्युपाघ्राय सव्येन परिजग्राह पाणिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015236, "chapter_id": 1318, "verse_number": "२-५९-११", "content_sanskrit": "तां च तत्रोपसम्प्राप्य प्रियामिव सखीमिमाम्।\nदक्षिणेन कराग्रेण पिरजग्राह माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015237, "chapter_id": 1318, "verse_number": "२-५९-१२", "content_sanskrit": "ददृशुस्तां सभामध्ये भगिनीं रामकृष्णयोः।\nरुक्मपद्मशां पद्मश्रीमिवोत्तमनाभयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015238, "chapter_id": 1318, "verse_number": "२-५९-१३", "content_sanskrit": "अथाक्षतमहावष्ट्या लाजपुष्पघृतैरपि।\nवृष्णयोऽवाकिरन्प्रीताः सङ्कर्षणजनार्दनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015239, "chapter_id": 1318, "verse_number": "२-५९-१४", "content_sanskrit": "सबालाः सहवृद्धाश्च ये ज्ञातिकुलबान्धवाः।\nउपोपविविशुः प्रीता वृष्णयो मधुसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015240, "chapter_id": 1318, "verse_number": "२-५९-१५", "content_sanskrit": "पूज्यमानो महाबाहुः पौराणां रतिवर्धनः।\nविवेश पुरुषव्याघ्रः स्ववेश्म मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015241, "chapter_id": 1318, "verse_number": "२-५९-१६", "content_sanskrit": "रुक्मिण्या सहितो देव्या प्रमुमोद सुखी सुखम्।\nअनन्तरं च सत्याया जाम्बवत्याश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015242, "chapter_id": 1318, "verse_number": "२-५९-१७", "content_sanskrit": "सर्वासां च यदुश्रेष्ठो गेहे गेहे विहारवान्।\nजगाम च हृषीकेशो रुक्मिण्याः सदनं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015243, "chapter_id": 1318, "verse_number": "२-५९-१८", "content_sanskrit": "एष तात महाबाहो विजयः शार्ङ्गधन्वनः।\nएतदर्थं च जन्माहुर्मानुषेषु महात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015244, "chapter_id": 1318, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि एकोनषष्टितमोऽध्यायः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]