[{"id": 2030183, "chapter_id": 1660, "verse_number": "३-२९८-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030184, "chapter_id": 1660, "verse_number": "३-२९८-१", "content_sanskrit": "अथ भार्यासहायः स फलान्यादाय वीर्यवान्।\nकठिनं पूरयामास ततः काण्ठान्यपाटयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030185, "chapter_id": 1660, "verse_number": "३-२९८-२", "content_sanskrit": "तस्य पाटयतः काष्ठं स्वेदो वै समजायत।\nव्यायामेन च तेनास्य जज्ञे शिरसि वेदना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030186, "chapter_id": 1660, "verse_number": "३-२९८-३", "content_sanskrit": "सोऽभिगम्य प्रियां भार्यामुवाच श्रमपीडितः।\nव्यायामेन ममानेन जाता शिरसि वेदना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030187, "chapter_id": 1660, "verse_number": "३-२९८-४", "content_sanskrit": "अङ्गानि चैव सावित्रि हृदयं दूयतीव च।\nअस्वस्थमिव चात्मानं लक्षये मितभाषिणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030188, "chapter_id": 1660, "verse_number": "३-२९८-५", "content_sanskrit": "शूलैरिव शिरो विद्धमिदं संलक्षयाम्यहम्।\n`भ्रमन्तीव दिशः सर्वाश्चक्रारूढं मनो मम।\nतत्स्वप्तुमिच्छे कल्याणि न स्तातुं शक्तिरस्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030189, "chapter_id": 1660, "verse_number": "३-२९८-६", "content_sanskrit": "सा समासाद्य सावित्री भर्तारमुपगम्य च।\nउत्सङ्गेऽस्य शिर कृत्वा निषसाद महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030190, "chapter_id": 1660, "verse_number": "३-२९८-७", "content_sanskrit": "ततः सा नारदवचो विमृशन्ती तपस्विनी।\nतं मुहूर्तं क्षणं वेलां दिवसं च युयोज ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030191, "chapter_id": 1660, "verse_number": "३-२९८-८", "content_sanskrit": "`हन्त प्राप्तः स कालोऽयमिति चिन्तापरा सती।\nमुहूर्तादेव चापश्य्पुरुषं रक्तवाससम्।\nवद्धमौलिं वपुष्मन्तमादित्यसमतेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030192, "chapter_id": 1660, "verse_number": "३-२९८-९", "content_sanskrit": "श्यामावदातं रक्ताक्षं पाशहस्तं भयावहम्।\nस्थितं सत्यवतः पार्श्वे निरीक्षन्तं तमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030193, "chapter_id": 1660, "verse_number": "३-२९८-१०", "content_sanskrit": "तं दृष्ट्वासहसोत्थाय भर्तुन्यस्य शनैः शिरः।\nकृताञ्जलिरुवाचार्ता हृदयेन प्रवेपती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030194, "chapter_id": 1660, "verse_number": "३-२९८-११", "content_sanskrit": "दैवतंत्वाभिजानामि वपुरेतद्ध्यमानुषम्।\nकामया ब्रूहि देवेश कस्त्वं किंच चिकीर्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030195, "chapter_id": 1660, "verse_number": "३-२९८-१२x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030196, "chapter_id": 1660, "verse_number": "३-२९८-१२", "content_sanskrit": "पतिव्रताऽसि सावित्रि तथैव च तपोन्विता।\nअस्त्वामभिभाषामि विद्धि मां त्वं शुभे यमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030197, "chapter_id": 1660, "verse_number": "३-२९८-१३", "content_sanskrit": "अयं ते रसत्यवान्भर्ता क्षीणायुः पार्थिवात्मजः।\nनेष्यामि तमहं बद्ध्वा विद्ध्येतन्मे चीकिर्षितं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030198, "chapter_id": 1660, "verse_number": "३-२९८-१३x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030199, "chapter_id": 1660, "verse_number": "३-२९८-१४", "content_sanskrit": "श्रूयते भगवन्दूतास्तवागच्छन्ति मानवान्।\nनेतुं किल भवान्कस्मादागतोसि स्वयं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030200, "chapter_id": 1660, "verse_number": "३-२९८-१५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030201, "chapter_id": 1660, "verse_number": "३-२९८-१५", "content_sanskrit": "इत्युक्तः पितृराजस्तां भगवान्स्वचिकीर्षितम्।\nयथावत्सर्वमाख्यातुं तत्प्रियार्थं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030202, "chapter_id": 1660, "verse_number": "३-२९८-१६", "content_sanskrit": "अयं च धर्मसंयुक्तो रूपवान्गुणसागरः।\nनार्हो मत्पुरुषैर्नेतुमतोस्मि स्वयमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030203, "chapter_id": 1660, "verse_number": "३-२९८-१७", "content_sanskrit": "ततः सत्यवतः कायात्पाशबद्धं वशंगतम्।\nअङ्गुष्ठमात्रं पुरुषं निश्चकर्ष यमो बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030204, "chapter_id": 1660, "verse_number": "३-२९८-१८", "content_sanskrit": "ततः समुद्धृतप्राणं गतश्वासं हतप्रभम्।\nनिरविचेष्टंशरीरं तद्बभूवाप्रियदर्सनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030205, "chapter_id": 1660, "verse_number": "३-२९८-१९", "content_sanskrit": "यमस्तु तं ततो बद्ध्वा प्रयातो दक्षिणामुखः।\nसावित्री चैव दुःखार्ता यममेवान्वगच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030206, "chapter_id": 1660, "verse_number": "३-२९८-२०", "content_sanskrit": "`भर्तुः शरीररां च विधाय हि तपस्विनी।\nभर्तारमनुगच्छन्ती तथावस्थं सुमध्यमा।\nनियमव्रतसंसिद्धा महाभागा पतिव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030207, "chapter_id": 1660, "verse_number": "३-२९८-२१x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030208, "chapter_id": 1660, "verse_number": "३-२९८-२१", "content_sanskrit": "निवर्त गच्छ सावित्रि कुरुष्वास्यौर्ध्वदैहिकम्।\nकृतंभर्तुस्त्वयाऽऽनृण्यं यावद्गम्यं गतं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030209, "chapter_id": 1660, "verse_number": "३-२९८-२२x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030210, "chapter_id": 1660, "verse_number": "३-२९८-२२", "content_sanskrit": "यत्र मे नीयते भर्ता स्वयं वा यत्र गच्छति।\nमया च तत्र गन्तव्यमेष धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030211, "chapter_id": 1660, "verse_number": "३-२९८-२३", "content_sanskrit": "तपसा गुरुभक्त्या च भर्तुः स्नेहाद्व्रतेन च।\nतव चैव प्रसादेन न मे प्रतिहता गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030212, "chapter_id": 1660, "verse_number": "३-२९८-२४", "content_sanskrit": "प्राहुः साप्तपदं मैत्रं बुधास्तत्त्वार्थदर्शिनः।\nमित्रतां च पुरस्कृत्य किंचिद्वक्ष्यामि तच्छृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030213, "chapter_id": 1660, "verse_number": "३-२९८-२५", "content_sanskrit": "नानात्मवन्तस्तु वने चरन्ति\nधर्मं च वासं च परिश्रमं च।\nविज्ञानतो धर्ममुदाहरन्ति\nतस्मात्सन्तो धर्ममाहुः प्रधानम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030214, "chapter_id": 1660, "verse_number": "३-२९८-२६", "content_sanskrit": "एकस्य धर्मेण सतां मतेन\nसर्वेस्म तं मार्गमनुप्रपन्नाः।\nमा वै द्वितीयं मा तृतीयं च वाञ्छे\nतस्मात्सन्तो धर्ममाहुः प्रधानम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030215, "chapter_id": 1660, "verse_number": "३-२९८-३७x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2030216, "chapter_id": 1660, "verse_number": "३-२९८-२७", "content_sanskrit": "निवर्त तुष्टोस्मि तवानया गिरा\nस्वराक्षरव्यञ्जनहेतुयुक्तया।\nवरं वृणीष्वेहविनाऽस्य जीवितं\nददानि ते सर्वमनिन्दिते वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2030217, "chapter_id": 1660, "verse_number": "३-२९८-२८x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2030218, "chapter_id": 1660, "verse_number": "३-२९८-२८", "content_sanskrit": "च्युतः स्वराज्याद्वनवासमाश्रितो\nविनष्टचक्षुः श्वशुरो ममाश्रमे।\nस लब्धचक्षुर्बलवान्भवेन्नृप-\nस्तव प्रसादाज्ज्वलनार्कसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2030219, "chapter_id": 1660, "verse_number": "३-२९८-२९x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2030220, "chapter_id": 1660, "verse_number": "३-२९८-२९", "content_sanskrit": "ददानि तेऽहं तमनिन्दिते वरं\nयथा त्वयोक्तं भविता च तत्तथा।\nतवाध्वना ग्लानिमिवोपलक्षये\nनिवर्त गच्छस्व न ते श्रमो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2030221, "chapter_id": 1660, "verse_number": "३-२९८-३०x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2030222, "chapter_id": 1660, "verse_number": "३-२९८-३०", "content_sanskrit": "श्रमः कुतो भर्तृसमीपतो हिमे\nयतो हि भर्ता मम सा गतिर्ध्रुवा।\nयतः पतिं नमेष्यसि तत्र मे गतिः\nसुरेश भूयश्च वचो निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2030223, "chapter_id": 1660, "verse_number": "३-२९८-३१", "content_sanskrit": "सतां सकृत्संगतमीप्सितं परं\nततः परं मित्रमिति प्रचक्षते।\nन चाफलं सत्पुरुषेण संगतं\nततः सतां संनिवसेत्समागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2030224, "chapter_id": 1660, "verse_number": "३-२९८-३२x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2030225, "chapter_id": 1660, "verse_number": "३-२९८-३२", "content_sanskrit": "मनोनुकूलं बुधबुद्धिवर्धनं\nत्वया यदुक्तं वचनं हिताश्रयम्।\nविना पुनः सत्यवतोस्य जीवितं\nवरं द्वितीयं वरयस्व भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2030226, "chapter_id": 1660, "verse_number": "३-२९८-३३x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2030227, "chapter_id": 1660, "verse_number": "३-२९८-३३", "content_sanskrit": "हृतंपुरा मे श्वशुरस्य धीमतः\nस्वमेव राज्यंलभतां स पार्थिवः।\nकजह्यात्स्वधर्मान्न च मे गुरुर्यथा\nद्वितीयमेतद्वरयामि ते वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2030228, "chapter_id": 1660, "verse_number": "३-२९८-३४x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2030229, "chapter_id": 1660, "verse_number": "३-२९८-३४", "content_sanskrit": "स्वमेवं राज्यं प्रतिपत्स्यतेऽचिरा-\nन्न च स्वधर्मात्परिहीयते नृपः।\nकृतेन कामेन मया नृपात्मजे\nनिवर्त गच्छस्व न ते श्रमो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2030230, "chapter_id": 1660, "verse_number": "३-२९८-३५x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2030231, "chapter_id": 1660, "verse_number": "३-२९८-३५", "content_sanskrit": "प्रजास्त्वयैता नियमेन संयता\nनियम्य चैता नयसे निकामया।\nततो यमत्वं तव देव विश्रुतं\nनिबोध चेमां गिरमीरितां मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2030232, "chapter_id": 1660, "verse_number": "३-२९८-३६", "content_sanskrit": "अद्रोहः सर्वभूतेषु कर्मणा मनसा गिरा।\nअनुग्रहश्च दानं च सतां धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2030233, "chapter_id": 1660, "verse_number": "३-२९८-३७", "content_sanskrit": "एवंप्रायश्च लोकोऽयं मनुष्याः शक्तिपेशलाः।\nसन्तस्त्वेवाप्यमित्रेषु दयां प्राप्तेषु कुर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2030234, "chapter_id": 1660, "verse_number": "३-२९८-३८x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2030235, "chapter_id": 1660, "verse_number": "३-२९८-३८", "content_sanskrit": "पिपासितस्येव भवेद्यथा पय-\nस्तथा त्वया वाक्यमिदं समीरितम्।\nविना पुनः सत्यवतोऽस्य जीवितं\nवरं वृणीष्वेह शुभे यदिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2030236, "chapter_id": 1660, "verse_number": "३-२९८-३९x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2030237, "chapter_id": 1660, "verse_number": "३-२९८-३९", "content_sanskrit": "ममानपत्यः पृथिवीपतिः पिता\nभवत्पितुः पुत्रशतं तथौरसम्।\nकुलस्य संतानकरं च यद्भवे-\nत्तृतीयमेतद्वरयामि ते वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2030238, "chapter_id": 1660, "verse_number": "३-२९८-४०x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2030239, "chapter_id": 1660, "verse_number": "३-२९८-४०", "content_sanskrit": "कुलस्य संतानकरं सुवर्चसं\nशतं सुतानां पितुरस्तु ते शुभे।\nकृतेन कामेन नराधिपात्मजे\nनिवर्त दूरं हि पथस्त्वमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2030240, "chapter_id": 1660, "verse_number": "३-२९८-४१x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2030241, "chapter_id": 1660, "verse_number": "३-२९८-४१", "content_sanskrit": "न दूरमेतन्मम भर्तृसन्निधौ\nमनो हि मे दूरतरं प्रधावति।\nअथ व्रजन्नेव गिरं समुद्यतां\nमयोच्यमानां शृणु भूय एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2030242, "chapter_id": 1660, "verse_number": "३-२९८-४२", "content_sanskrit": "विवस्वतस्त्वं तनयऋ प्रतापवां-\nस्ततो हि वैवस्वत उच्यसे बुधैः।\nसमेन धर्मेण चरन्ति ताः प्रजा-\nस्ततस्तवेहेवर धर्मराजता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2030243, "chapter_id": 1660, "verse_number": "३-२९८-४३", "content_sanskrit": "आत्मन्यपि न विश्वासस्तथा भवति सत्सु यः।\nतस्मात्सत्सु विशेपेण सर्वः प्रणयमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2030244, "chapter_id": 1660, "verse_number": "३-२९८-४४", "content_sanskrit": "सौहदात्सर्वभूतानां विश्वासो नाम जायते।\nतस्मात्सत्सु विशेपेण विश्वासं कुरुते जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2030245, "chapter_id": 1660, "verse_number": "३-२९८-४५x", "content_sanskrit": "यव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2030246, "chapter_id": 1660, "verse_number": "३-२९८-४५", "content_sanskrit": "उदाहृतंते वचनं यदङ्गने\nशुभे न तादृक् त्वदृते श्रुतं मया।\nअनेन तुष्टोस्मि विनाऽस्य जीवितं\nवरं चतुर्थं वरयस्व गच्छ च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2030247, "chapter_id": 1660, "verse_number": "३-२९८-४६x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2030248, "chapter_id": 1660, "verse_number": "३-२९८-४६", "content_sanskrit": "ममात्मजं सत्यवतस्तथौरसं\nभवेदुभाभ्यामिह यत्कुलोद्वहम्।\nशतं सुतानां बलवीर्यशालिना-\nमिदंचतुर्थं वरयामि ते वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2030249, "chapter_id": 1660, "verse_number": "३-२९८-४७x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2030250, "chapter_id": 1660, "verse_number": "३-२९८-४७", "content_sanskrit": "शतं सुतानां बलवीरय्शालिनां\nभविष्यति प्रीतिकरं तवाबले।\nपरिश्रमस्ते न भवेन्नृपात्मजे\nनिवर्त दूरं हि पथस्त्वमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2030251, "chapter_id": 1660, "verse_number": "३-२९८-४८x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2030252, "chapter_id": 1660, "verse_number": "३-२९८-४८", "content_sanskrit": "सतां सदा शाश्वतधर्मवृत्तिः\nसन्तो न सीदन्ति न च व्यथन्ति।\nसतां सद्भिर्नाफलः संगमोस्ति\nसद्भ्यो भयंनानुवर्तन्ति सन्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2030253, "chapter_id": 1660, "verse_number": "३-२९८-४९", "content_sanskrit": "सन्तो हि सत्येन नयन्ति सूर्यं\nसन्तो भूमिं तपसा धारयन्ति।\nसन्तो गतिर्भूतभव्यस् राज-\nन्सतां मध्ये नावसीदन्ति सन्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2030254, "chapter_id": 1660, "verse_number": "३-२९८-५०", "content_sanskrit": "आर्यजुष्टमिदं वृत्तमिति विज्ञाय शाश्वतम्।\nसन्तः परार्थं कुर्वाणा नावेक्षन्ति प्रतिक्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2030255, "chapter_id": 1660, "verse_number": "३-२९८-५१", "content_sanskrit": "न च प्रसादः सत्पुरुषेषु मोघो\nन चाप्यर्थो नश्यति नापि मानः।\nयस्मादेतन्नियतं सत्सु नित्यं\nतस्मात्सन्तो रक्षितारो भवन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2030256, "chapter_id": 1660, "verse_number": "३-२९८-५२x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2030257, "chapter_id": 1660, "verse_number": "३-२९८-५२", "content_sanskrit": "यथायथा भाषसि धर्मसंहितं\nमनोनुकूलं सुपदं महार्थवत्।\nतथातथा मे त्वयि भक्तिरुत्तमा\nवरं वृणीष्वाप्रतिमं पतिव्रते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2030258, "chapter_id": 1660, "verse_number": "३-२९८-५३x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2030259, "chapter_id": 1660, "verse_number": "३-२९८-५३", "content_sanskrit": "न तेऽपवर्गः सुकृताद्विना कृत-\nस्तथा यथाऽन्येषु वरेषु मानद।\nवरं वृणे जीवतु सत्यवानयं\nयथा मृता ह्येवमहं पतिं विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2030260, "chapter_id": 1660, "verse_number": "३-२९८-५४", "content_sanskrit": "न कामये भर्तविनाकृता सुखं\nन कामये भर्तृविनाकृता दिवम्।\nनकामये भर्तविनाकृता श्रियं\nन भर्तृहीना व्यवसामि जीबितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2030261, "chapter_id": 1660, "verse_number": "३-२९८-५५", "content_sanskrit": "वरातिसर्गः शतपुत्रता मम\nत्वयैव दत्तो ह्रियते च मे पतिः।\nवरं वृणे जीवतु सत्यवानयं\nतवैव सत्यं वचनं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2030262, "chapter_id": 1660, "verse_number": "३-२९८-५६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2030263, "chapter_id": 1660, "verse_number": "३-२९८-५६", "content_sanskrit": "तथेत्युक्त्वा तु तं पाशं मुक्त्वा वैवस्वतो यमः।\nधर्मराजः प्रहृष्टात्मा सावित्रीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2030264, "chapter_id": 1660, "verse_number": "३-२९८-५७", "content_sanskrit": "एष भद्रे मया मुक्तो भर्ता ते कुलनन्दिनि।\n`तोषितोऽहं त्वया साध्वि वाक्यैर्धर्मार्तसंहितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2030265, "chapter_id": 1660, "verse_number": "३-२९८-५८", "content_sanskrit": "अरोगस्व नेयश्च सिद्धार्थः स भविष्यि।\nचतुर्वर्षशतायुश्च त्वया सार्धमवाप्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2030266, "chapter_id": 1660, "verse_number": "३-२९८-५९", "content_sanskrit": "इष्ट्वा यज्ञैश्च धर्मेण ख्यातिं लोके गमिष्यति।\nत्वयि पुत्रशतं चैव सत्यवाञ्जनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2030267, "chapter_id": 1660, "verse_number": "३-२९८-६०", "content_sanskrit": "ते चापि सर्वे राजानः क्षत्रियाः पुत्रपौत्रिणः।\nख्यातास्त्वन्नामधेयाश्चभविष्यन्तीह शाश्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2030268, "chapter_id": 1660, "verse_number": "३-२९८-६१", "content_sanskrit": "पितुश्च ते पुत्रशतं भविता तव मातरि।\nमालव्यां मालवा नाम शाश्वताः पुत्रपौत्रिणः।\nभ्रातरस्ते भविष्यन्ति क्षत्रियास्त्रिदशोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2030269, "chapter_id": 1660, "verse_number": "३-२९८-६२", "content_sanskrit": "एवं तस्यै वरं दत्त्वा धर्मराजः प्रतापवान्।\nनिवर्तयित्वा सावित्रीं स्वमेव भवनं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2030270, "chapter_id": 1660, "verse_number": "३-२९८-६३", "content_sanskrit": "सावित्र्यपि यमे याते भर्तारं प्रतिलभ्य च।\nजगाम तत्र यत्रास्या भर्तुः शावं कलेवरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2030271, "chapter_id": 1660, "verse_number": "३-२९८-६४", "content_sanskrit": "सा भूमौ प्रेक्ष्यभर्तारमुपसृत्योपगृह्य च।\nउत्सङ्गे शिर आरोप्य भूमावुपविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2030272, "chapter_id": 1660, "verse_number": "३-२९८-६५", "content_sanskrit": "संज्ञां चस पुनर्लब्ध्वा सावित्रीमभ्यभाषत।\nप्रोष्यागत इव प्रेम्णा पुनःपुनरुदीक्ष्यवै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2030273, "chapter_id": 1660, "verse_number": "३-२९८-६६", "content_sanskrit": "सुचिरं बत सुप्तोस्मि किमर्थं नावबोधितः।\nक्व चासौ पुरुषः श्यामो योसौ मां संचकर्षह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2030274, "chapter_id": 1660, "verse_number": "३-२९८-६७x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2030275, "chapter_id": 1660, "verse_number": "३-२९८-६७", "content_sanskrit": "सुचिरं त्वंप्रसुप्तोसि ममाह्के पुरुषर्षभ।\nगतः स भगवान्देवः प्रजासंयमनो यमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2030276, "chapter_id": 1660, "verse_number": "३-२९८-६८", "content_sanskrit": "विश्रान्तोसि महाभाग विनिद्रश्च नृपात्मज।\nयदि शक्यं समुत्तिष्ठ विगाढां पश्य शर्वरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2030277, "chapter_id": 1660, "verse_number": "३-२९८-६९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2030278, "chapter_id": 1660, "verse_number": "३-२९८-६९", "content_sanskrit": "उपलभ्यततः संज्ञां सुखसुप्त इवोत्थितः।\nदिशः सर्वा वनान्तांश्च निरीक्ष्योवाच सत्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2030279, "chapter_id": 1660, "verse_number": "३-२९८-७०", "content_sanskrit": "फलाहारोस्मि निष्क्रान्तस्वया सह सुमध्यमे।\nततः पाटयतः काष्ठं शरिसो मे रुजाऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2030280, "chapter_id": 1660, "verse_number": "३-२९८-७१", "content_sanskrit": "शिरोभितापसंतप्तः स्थातुं चिरमशक्नुवन्।\nतवोत्सङ्गे प्रसुप्तोस्मि इति सर्वं स्मरे शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2030281, "chapter_id": 1660, "verse_number": "३-२९८-७२", "content_sanskrit": "त्वयोपगूढस्य च मे निद्रयाऽपहृतं मनः।\nततोऽपश्यं तमो घोरं पुरुषं च महौजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2030282, "chapter_id": 1660, "verse_number": "३-२९८-७३", "content_sanskrit": "तद्यदि त्वं विजानासि किं तद्ब्रूहि सुमध्यमे।\nस्वप्नो मे यदिवा दृष्टो यदि वा सत्यमेव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2030283, "chapter_id": 1660, "verse_number": "३-२९८-७४", "content_sanskrit": "तमुवाचाथ सावित्री रजनी व्यवगाहते।\nश्वस्ते सर्वंयथावृत्तमाख्यास्यामि नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2030284, "chapter_id": 1660, "verse_number": "३-२९८-७५", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ भद्रं ते पितरौ पश्य सुव्रत।\nविगाढा रजनी चेयं निवृत्तश्च दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2030285, "chapter_id": 1660, "verse_number": "३-२९८-७६", "content_sanskrit": "नक्तंचराश्चरन्त्येते हृष्टाः क्रूराभिभाषिणः।\nश्रूयन्ते पर्णशब्दाश्च मृगाणां चरतां वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2030286, "chapter_id": 1660, "verse_number": "३-२९८-७७", "content_sanskrit": "एता घोरं शिवा नादान्दिशं दक्षिणपश्चिमाम्।\nआस्थाय विरुवन्त्युग्राः कम्पयन्त्यो मनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2030287, "chapter_id": 1660, "verse_number": "३-२९८-७८x", "content_sanskrit": "सत्यवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2030288, "chapter_id": 1660, "verse_number": "३-२९८-७८", "content_sanskrit": "वनं प्रतिभयाकारं घनेन तमसा वृतम्।\nन विज्ञास्यसि पन्थानं गन्तुं चैव न शक्ष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2030289, "chapter_id": 1660, "verse_number": "३-२९८-७९x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2030290, "chapter_id": 1660, "verse_number": "३-२९८-७९", "content_sanskrit": "अस्मिन्न वने दग्धे शुष्कवृक्षः स्थितो ज्वलन्।\nवायुना धम्यमानोत्र दृश्यतेऽग्निः क्वचित्क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2030291, "chapter_id": 1660, "verse_number": "३-२९८-८०", "content_sanskrit": "ततोऽग्निमानयित्वेह ज्वालयिप्यामि सर्वतः।\nकाष्ठानीमानि सन्तीह जहि संतापमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2030292, "chapter_id": 1660, "verse_number": "३-२९८-८१", "content_sanskrit": "यदि नोत्सहसे गन्तुं सरुजं त्वां हि लक्षये।\nन च ज्ञास्यसि पन्थानं तमसा संवृते वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2030293, "chapter_id": 1660, "verse_number": "३-२९८-८२", "content_sanskrit": "श्वः प्रभाते वने दृश्ये यास्यावोऽनुमते तव।\nवसावेह क्षपामेकां रुचितं यदि तेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2030294, "chapter_id": 1660, "verse_number": "३-२९८-८३x", "content_sanskrit": "सत्यवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2030295, "chapter_id": 1660, "verse_number": "३-२९८-८३", "content_sanskrit": "शिरोरुजा निवृत्ता मे स्वस्थान्यङ्गानि लक्षये।\nमातापितृभ्यामिच्छामि संयोगं त्वत्प्रसादजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2030296, "chapter_id": 1660, "verse_number": "३-२९८-८४", "content_sanskrit": "न कदाचिद्विकाले हि गतपूर्वोहमाश्रमात्।\nअनागतायां सन्ध्यायां माता मे प्ररुणद्धि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2030297, "chapter_id": 1660, "verse_number": "३-२९८-८५", "content_sanskrit": "दिवाऽपिमयि निष्क्रान्ते सन्तप्येते गुरू मम।\nविचिनोति हि मां तातः सहैवाश्रमवासिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2030298, "chapter_id": 1660, "verse_number": "३-२९८-८६", "content_sanskrit": "मात्रा पित्रा च सुभृशं दुःखिताभ्यामहं पुरा।\nउपालब्धश्च बहुशश्चिरेणागच्छसीति हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2030299, "chapter_id": 1660, "verse_number": "३-२९८-८७", "content_sanskrit": "कात्ववस्था तयोरद्य मदर्थमिति चिन्तये।\nतयोरदृश्ये मयि च महद्दुःखं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2030300, "chapter_id": 1660, "verse_number": "३-२९८-८८", "content_sanskrit": "पुरा मामूचतुश्चैव रात्रावस्रायमाणकौ।\nभृशं सुदुःखितौ वृद्धौ बहुशः प्रीतिसंयुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2030301, "chapter_id": 1660, "verse_number": "३-२९८-८९", "content_sanskrit": "त्वया हीनौ न जीवाव मुहूर्तमपि पुत्रक।\nयावद्धरिष्यसे पुत्र तावन्नौ जीवितं ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2030302, "chapter_id": 1660, "verse_number": "३-२९८-९०", "content_sanskrit": "वृद्धयोरन्धयोर्दृष्टिस्त्वयि वंशः प्रतिष्ठिः।\nत्वयि पिण्डश्च कीर्तिश्च सन्तानश्चावयोरिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2030303, "chapter_id": 1660, "verse_number": "३-२९८-९१", "content_sanskrit": "माता वृद्धा पिता वृद्धस्तयोर्यष्टिरहं किल।\nतौ रात्रौ मामपश्यन्तौ कामवस्थां गमिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2030304, "chapter_id": 1660, "verse_number": "३-२९८-९२", "content_sanskrit": "निद्रायाश्चाभ्यसूयामि यस्या हेतोः पिता मम।\nमाता च संशयं प्राप्ता मत्कृतेऽनपकारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2030305, "chapter_id": 1660, "verse_number": "३-२९८-९३", "content_sanskrit": "अहं च संशयं प्राप्तः कृच्छ्रामापदमास्थितः।\nमातापितृभ्यां हि विना नाहं जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2030306, "chapter_id": 1660, "verse_number": "३-२९८-९४", "content_sanskrit": "व्यक्तमाकुलया बुद्ध्या प्रज्ञाचक्षुः पिता मम।\nएकैकमस्यां वेलायां पृच्छत्याश्रमवासिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2030307, "chapter_id": 1660, "verse_number": "३-२९८-९५", "content_sanskrit": "नात्मानमनुशोचामि यथाऽहंपितरं शुभे।\nभर्तारं चाप्यनुगतां मातरं भृशदुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2030308, "chapter_id": 1660, "verse_number": "३-२९८-९६", "content_sanskrit": "मत्कृते न हि तावद्य सन्तापं परमेष्यतः।\nजीवन्तावनुजीवामि भर्तव्यौ तौ मयेति ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2030309, "chapter_id": 1660, "verse_number": "३-२९८-९७", "content_sanskrit": "तयोः प्रियं मे कर्व्यमिति जीवामि चाप्यहम्।\n`परमं दैवतं तौ मे पूजनीयौ सदा मया।\nतयोस्तु मे सदाऽस्त्येवं व्रतमेतत्पुरातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2030310, "chapter_id": 1660, "verse_number": "३-२९८-९८x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2030311, "chapter_id": 1660, "verse_number": "३-२९८-९८", "content_sanskrit": "एवमुक्त्वा स धर्मात्मा गुरुभक्तो गुरुप्रियः।\nउच्छ्रित्य बाहू दुःखार्तः सुस्वरं प्ररुरोद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2030312, "chapter_id": 1660, "verse_number": "३-२९८-९९", "content_sanskrit": "ततोऽब्रवीत्तथा दृष्ट्वाभर्तारं शोककर्शितम्।\nप्रमृज्याश्रूणि पाणिभ्यां सावित्री धर्मचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2030313, "chapter_id": 1660, "verse_number": "३-२९८-१००", "content_sanskrit": "यदि मेऽस्ति तपस्तप्तं यदि दत्तं हुतं यदि।\nश्वश्रूश्वशुरभर्तॄणां मम पुण्याऽस्तु शर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2030314, "chapter_id": 1660, "verse_number": "३-२९८-१०१", "content_sanskrit": "न स्मराम्युक्तपूर्वं वै स्वैरेष्वप्यनृतां गिरम्।\nतेन सत्येन तावद्य ध्रियेतां श्वशुरौ मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2030315, "chapter_id": 1660, "verse_number": "३-२९८-१०२x", "content_sanskrit": "सत्यवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2030316, "chapter_id": 1660, "verse_number": "३-२९८-१०२", "content_sanskrit": "कामये दर्शनं पित्रोर्याहि सावित्रि माचिरम्।\n`अपिनाम गुरू तौ हि पश्येयं ध्रियमाणकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2030317, "chapter_id": 1660, "verse_number": "३-२९८-१०३", "content_sanskrit": "पुरा मातुः पितुर्वाऽपियदि पश्यामि विप्रियम्।\nन जीविष्ये वरारोहे सत्येनात्मानमालभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2030318, "chapter_id": 1660, "verse_number": "३-२९८-१०४", "content_sanskrit": "यदि धर्मे च ते बुद्धिर्मां चेज्जीवन्तमिच्छसि।\nमम प्रियं वा कर्तव्यं गच्छावाश्रममन्तिकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2030319, "chapter_id": 1660, "verse_number": "३-२९८-१०५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2030320, "chapter_id": 1660, "verse_number": "३-२९८-१०५", "content_sanskrit": "सावित्री तत उत्थाय केशान्संम्य भामिनी।\nपतिमुत्थापयामास बाहुभ्यां परिगृह्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2030321, "chapter_id": 1660, "verse_number": "३-२९८-१०६", "content_sanskrit": "उत्ताय सत्यवांश्चापि प्रमृज्याङ्गानि पाणिना।\nसर्वा दिशः समालोक्य कठिने दृष्टिमादधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2030322, "chapter_id": 1660, "verse_number": "३-२९८-१०७", "content_sanskrit": "तमुवाचाथसावित्री श्वः फलानि हरिष्यसि।\nयोगक्षेमार्थमेतं ते नेष्यामि परशुं त्वहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2030323, "chapter_id": 1660, "verse_number": "३-२९८-१०८", "content_sanskrit": "कृत्त्वा कठिनभारं सा वृक्षशाखावलम्बिनम्।\nगृहीत्वा परशुं भर्तुः सकाशे पुनरागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2030324, "chapter_id": 1660, "verse_number": "३-२९८-१०९", "content_sanskrit": "वामे स्कन्धे तु वामोरूर्भर्तुर्बाहुं निवेश्य च।\nदक्षिणएन परिष्वज्य जगाम गजगामिनी ॥ सत्यवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2030325, "chapter_id": 1660, "verse_number": "३-२९८-११०", "content_sanskrit": "अभ्यासगमनाद्भीरु पन्थानो विदिता मम।\nवृक्षान्तरालोकितया ज्योत्स्नया चापि लक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2030326, "chapter_id": 1660, "verse_number": "३-२९८-१११", "content_sanskrit": "आगतौ स्वः पथा येन फलान्यवचितानि च।\nयथागतं शुभे गच्छ पन्थानं मा विचारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2030327, "chapter_id": 1660, "verse_number": "३-२९८-११२", "content_sanskrit": "पलाशखण्डे चैतस्मिन्पन्था व्यावर्तते द्विधा।\nतस्योत्तरेण यः पन्थास्तेन गच्छ त्वरस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2030328, "chapter_id": 1660, "verse_number": "३-२९८-११३", "content_sanskrit": "स्वस्थोस्मि बलवानस्मि दिदृक्षुः पितरावुभौ।\nब्रुवन्नेव त्वरायुक्तः सम्प्रायादाश्रमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2030329, "chapter_id": 1660, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि पतिव्रतामाहात्म्यपर्वणि अष्टनवत्यधिकद्विशततमोऽध्यायः ॥ २९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}]