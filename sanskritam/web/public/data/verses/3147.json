[{"id": 2100191, "chapter_id": 3147, "verse_number": "१४-३-१", "content_sanskrit": "व्यास उवाच।\nयुधिष्ठिर तव प्रज्ञा न सम्यगिति मे मतिः।\nन हि कश्चित्स्वयं मर्त्यः स्ववशः कुरुते क्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100192, "chapter_id": 3147, "verse_number": "१४-३-२", "content_sanskrit": "ईश्वरेण च युक्तोऽयं साध्वसाधु च मानवः।\nकरोत्यसुकरं कर्म तत्रका परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100193, "chapter_id": 3147, "verse_number": "१४-३-३", "content_sanskrit": "आत्मानं मन्यसे चाथ पापकर्माणमन्ततः।\nशृणु तत्र यथा पापमपकृत्येत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100194, "chapter_id": 3147, "verse_number": "१४-३-४", "content_sanskrit": "तपोभिः क्रतुभिश्चैव दानेन च युधिष्ठिर।\nतरन्ति नित्यं पुरुषा ये स्म पापानि कुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100195, "chapter_id": 3147, "verse_number": "१४-३-५", "content_sanskrit": "यज्ञेन तपसा चैव दानेन च नराधिप।\nपूयन्ते नरशार्दूल नरा दुष्कृतकारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100196, "chapter_id": 3147, "verse_number": "१४-३-६", "content_sanskrit": "असुराश्च सुराश्चैव पुण्यहेतोर्मखक्रियाम्।\nप्रवर्तन्ते महात्मानस्तस्माद्यज्ञः परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100197, "chapter_id": 3147, "verse_number": "१४-३-७", "content_sanskrit": "यज्ञैरेव महात्मानो बभूवुरधिकाः सुराः।\nततो देवाः क्रियावन्तो दानवानभ्यधर्षयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100198, "chapter_id": 3147, "verse_number": "१४-३-८", "content_sanskrit": "राजसूयाश्वमेधौ च सर्वमेधं च भारत।\nनरमेधं च नृपते त्वमाहर युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100199, "chapter_id": 3147, "verse_number": "१४-३-९", "content_sanskrit": "यजस्व वाजिमेधेन विधिवद्दक्षिणावता।\nबहुकामान्नवित्तेन रामो दाशरथिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100200, "chapter_id": 3147, "verse_number": "१४-३-१०", "content_sanskrit": "यथा च भरतो राजा दौष्यन्तिः पृथिवीपतिः।\nशाकुन्तलो महावीर्यस्तव पूर्वपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100201, "chapter_id": 3147, "verse_number": "१४-३-११x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100202, "chapter_id": 3147, "verse_number": "१४-३-११", "content_sanskrit": "असंशयं वाजिमेधः पारयेत्पृथिवीमपि।\nअभिप्रायस्तु मे कश्चित्तं त्वं श्रोतुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100203, "chapter_id": 3147, "verse_number": "१४-३-१२", "content_sanskrit": "इमं ज्ञातिवधं कृत्वा सुमहान्तं द्विजोत्तम।\n`अहमाराधयिष्यामि कथं शोकपरायणः।\nदानमल्पं न शक्नोमि दातुं वित्तं च नास्ति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100204, "chapter_id": 3147, "verse_number": "१४-३-१३", "content_sanskrit": "न तु बालानिमान्दीनानुत्सहे वसु याचितुम्।\nतथैवाद्रविणान्कृच्छ्रे वर्तमानान्नृपात्मजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100205, "chapter_id": 3147, "verse_number": "१४-३-१४", "content_sanskrit": "स्वयं विनाश्य पृथिवीं यज्ञार्थं द्विजसत्तम।\nकरमाहारयिष्यामि कथं शोकपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100206, "chapter_id": 3147, "verse_number": "१४-३-१५", "content_sanskrit": "दुर्योधनापराधेनि वसुधायां नराधिपाः।\nप्रनष्टा योजयित्वाऽस्मानकीर्त्या मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100207, "chapter_id": 3147, "verse_number": "१४-३-१६", "content_sanskrit": "दुर्योधनेन पृथिवी क्षपिता जयकारणात्।\nकोशश्चापि विशीर्णोसौ धार्तराष्ट्रस्य दुर्मतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100208, "chapter_id": 3147, "verse_number": "१४-३-१७", "content_sanskrit": "पृथिवी दक्षिणा चात्र वाजिमेधे महाक्रतौ।\nविद्वद्भिः परिदृष्टोऽयं शिष्टो विधिविपर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100209, "chapter_id": 3147, "verse_number": "१४-३-१८", "content_sanskrit": "न च प्रतिनिधिं कर्तुं चिकीर्षामि तपोधन।\nअत्र मे भगवन्सम्यक्साचिव्यं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100210, "chapter_id": 3147, "verse_number": "१४-३-१९", "content_sanskrit": "एवमुक्तस्तु पार्थेन कृष्णद्वैपायनस्तदा।\nमुहूर्तमनुसञ्चिन्त्य धर्मराजानमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100211, "chapter_id": 3147, "verse_number": "१४-३-२०", "content_sanskrit": "कोशश्चापि विशीर्णोऽयं परिपूर्णो भविष्यति।\nविद्यते द्रविणं पार्थ गिरौ हिमवति स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100212, "chapter_id": 3147, "verse_number": "१४-३-२१", "content_sanskrit": "उत्सृष्टं ब्राह्मणैर्यज्ञे मरुत्तस्य महीपते।\nतदानयस्व कौन्तेय पर्याप्तं तद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100213, "chapter_id": 3147, "verse_number": "१४-३-२२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100214, "chapter_id": 3147, "verse_number": "१४-३-२२", "content_sanskrit": "कथं यज्ञे मरुत्तस्य द्रविणं तत्समाचितम्।\nकस्मिंश्च काले स नृपो बभूव ददतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100215, "chapter_id": 3147, "verse_number": "१४-३-२३x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100216, "chapter_id": 3147, "verse_number": "१४-३-२३", "content_sanskrit": "यदि शुश्रूषसे पार्थ शृणु कारंधमं नृपम्।\nयस्मिन्काले महावीर्यः स राजाऽऽसीन्महाधनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100217, "chapter_id": 3147, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि तृतीयोऽध्यायः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]