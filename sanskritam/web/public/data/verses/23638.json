[{"id": 7003638000, "chapter_id": 23638, "verse_number": "१-२-२५-१", "content_sanskrit": "अर्जुन उवाच ।\nदेवर्षे वर्ण्यते चेयं कथा पीयूषसोदरा ।\nपुनरेतन्मुने ब्रूहि यदा वेत्ति महेश्वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003638001, "chapter_id": 23638, "verse_number": "१-२-२५-२", "content_sanskrit": "भगवान्स्वां सतीं भार्यां वधार्थं चापि तारकम् ।\nसत्याश्च विरहात्तप्यन्ददाह किमसौ स्मरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003638002, "chapter_id": 23638, "verse_number": "१-२-२५-३", "content_sanskrit": "त्वयैवोक्तं स विरहात्सत्यास्तप्यति वै तपः ।\nहिमाद्रिमास्थितो देवस्तस्याः संगमवांछया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003638003, "chapter_id": 23638, "verse_number": "१-२-२५-४", "content_sanskrit": "नारद उवाच ।\nसत्यमेतत्पुरा पार्थ भवस्येदं मनीषितम् ।\nअतप्ततपसा योगो न कर्तव्यो मयाऽनया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003638004, "chapter_id": 23638, "verse_number": "१-२-२५-५", "content_sanskrit": "तपो विना शुद्धदेहो न कथंचन जायते ।\nअसुद्धदेहेन समं संयोगो नैव दैहिकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003638005, "chapter_id": 23638, "verse_number": "१-२-२५-६", "content_sanskrit": "महत्कर्माणि यानीह तेषां मूलं सदा तपः ।\nनातप्ततपसां सिद्धिर्महत्कर्माणि यांति वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003638006, "chapter_id": 23638, "verse_number": "१-२-२५-७", "content_sanskrit": "एतस्मात्कारणाद्देवो दर्पितं तं ददाह तु ।\nततो दग्धे स्मरे चापि पार्वतीमपि व्रीतिताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003638007, "chapter_id": 23638, "verse_number": "१-२-२५-८", "content_sanskrit": "विहाय सगणो देवः कैलासं समपद्यत ।\nदेवी च परमोद्विग्ना प्रस्खलंती पदेपदे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003638008, "chapter_id": 23638, "verse_number": "१-२-२५-९", "content_sanskrit": "जीवितं स्वं विनिंदंती बभ्रामेतस्ततश्चसा ।\nहिमाद्रिरपि स्वे श्रृंगे रुदतीं पृष्टवान्रतिम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003638009, "chapter_id": 23638, "verse_number": "१-२-२५-१०", "content_sanskrit": "कासि कस्यासि कल्याणि किमर्थं चापि रोदिषि ।\nपृष्टा सा च रतिः सर्वं यथावृत्तं न्यवेदयत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003638010, "chapter_id": 23638, "verse_number": "१-२-२५-११", "content_sanskrit": "निवेदिते तथा रत्या शैलः संभ्रांतमानसः ।\nप्राप्य स्वां तनयां पाणावादायागात्स्वकं पुरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003638011, "chapter_id": 23638, "verse_number": "१-२-२५-१२", "content_sanskrit": "सा तत्र पितरौ प्राह सखीनां वदनेन च ।\nदुर्भगेन शरीरेण किमनेन हि कारणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003638012, "chapter_id": 23638, "verse_number": "१-२-२५-१३", "content_sanskrit": "देहवासं परित्यक्ष्ये प्राप्स्ये वाभिमतं पतिम् ।\nअसाध्यं चाप्यभीष्टं च कथं प्राप्यं तपो विना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003638013, "chapter_id": 23638, "verse_number": "१-२-२५-१४", "content_sanskrit": "नियमैर्विविधैस्तस्माच्छोषयिष्ये कलेवरम् ।\nअनुजानीत मां तत्र यदि वः करुणा मयि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003638014, "chapter_id": 23638, "verse_number": "१-२-२५-१५", "content_sanskrit": "श्रुत्वेति वचनं माता पिता च प्राह तां शुभाम् ।\nउ मेति चपले पुत्रि न क्षमं तावकं वपुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003638015, "chapter_id": 23638, "verse_number": "१-२-२५-१६", "content_sanskrit": "सोढुं क्लेशात्मरूपस्य तपसः सौम्यदर्शने ।\nभावीन्यप्यनि वार्याणि वस्तूनि च सदैव तु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003638016, "chapter_id": 23638, "verse_number": "१-२-२५-१७", "content_sanskrit": "भाविनोर्था भवंत्येव नरस्यानिच्छतोपि हि ।\nतस्मान्न तपसा तेऽस्ति बाले किंचित्प्रयोजनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003638017, "chapter_id": 23638, "verse_number": "१-२-२५-१८", "content_sanskrit": "श्रीदेव्युवाच ।\nयदिदं भवतो वाक्यं न सम्यगिति मे मतिः ।\nकेवलं न हि दैवेन प्राप्तुमर्थो हि शक्यते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003638018, "chapter_id": 23638, "verse_number": "१-२-२५-१९", "content_sanskrit": "त्किंचिद्दैवाद्धठात्किंचित्किंचिदेव स्वभावतः ।\nपुरुषः फलमाप्नोति चतुर्थं नात्र कारणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003638019, "chapter_id": 23638, "verse_number": "१-२-२५-२०", "content_sanskrit": "ब्रह्मणा चापि ब्रह्मत्वं प्राप्तं किलतपोबलात् ।\nअन्यैरपि च यल्लब्धं तन्नसंख्यातुमुत्सहे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003638020, "chapter_id": 23638, "verse_number": "१-२-२५-२१", "content_sanskrit": "अध्रुवेण शरीरेण यद्यभीष्टं न साध्यते ।\nपश्चात्स शोच्यते मंदः पतितेऽस्मिञ्छरीरके ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003638021, "chapter_id": 23638, "verse_number": "१-२-२५-२२", "content_sanskrit": "यस्य देहस्य धर्मोऽयं क्वचिज्जायेत्क्वचिन्म्रियेत् ।\nक्वचिद्गर्भगतं नश्येज्जातमात्रं क्वचित्तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003638022, "chapter_id": 23638, "verse_number": "१-२-२५-२३", "content_sanskrit": "बाल्ये च यौवने चापि वार्धक्येपि विनश्यति ।\nतेन चंचलदेहेन कोऽर्थः स्वार्थो न चेद्भवेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003638023, "chapter_id": 23638, "verse_number": "१-२-२५-२४", "content_sanskrit": "इत्युक्त्वा स्वसखीयुक्ता पितृभ्यां साश्रु वीक्षिता ।\nश्रृंगं हिमवतः पुण्यं नानाश्चर्यं जगाम सा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003638024, "chapter_id": 23638, "verse_number": "१-२-२५-२५", "content_sanskrit": "तत्रां बराणि संत्यज्य भूषणानि च शैलजा ।\nसंवीता वल्कलैर्दिव्यैस्तपोऽतप्यत संयता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003638025, "chapter_id": 23638, "verse_number": "१-२-२५-२६", "content_sanskrit": "ईश्वरं हृदि संस्थाप्य प्रणवाभ्यसनादृता ।\nमुनीनामप्य भून्मान्या तदानीं पार्थ पार्वती ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003638026, "chapter_id": 23638, "verse_number": "१-२-२५-२७", "content_sanskrit": "त्रिस्नाता पाटलापत्रभक्षकाभूच्छतं समाः ।\nशंत च बिल्वपत्रेण शीर्णोन कृतभोजना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003638027, "chapter_id": 23638, "verse_number": "१-२-२५-२८", "content_sanskrit": "जलभक्षा शतं चाभूच्छतं वै वायुभोजना ।\nततो नियममादाय पादांगुष्ठस्थिताभवत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003638028, "chapter_id": 23638, "verse_number": "१-२-२५-२९", "content_sanskrit": "निराहारा ततस्तापं प्रापुस्तत्तपसो जनाः ।\nततो जगत्समालोक्य तदीयतपसोर्जितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003638029, "chapter_id": 23638, "verse_number": "१-२-२५-३०", "content_sanskrit": "हरस्तत्राययौ साक्षाद्ब्रह्मचारिवपुर्द्धरः ।\nवसानो वल्कलं दिव्यं रौरवाजिनसंवृतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003638030, "chapter_id": 23638, "verse_number": "१-२-२५-३१", "content_sanskrit": "सुलक्षणाषाढधरः सद्वृत्तः प्रति भानवान् ।\nततस्तं पूजयामासुस्तत्सख्यो बहुमानतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003638031, "chapter_id": 23638, "verse_number": "१-२-२५-३२", "content_sanskrit": "वक्तुमिच्छुः शैलपुत्रीं सखीभिरिति चोदितः ।\nब्रह्मन्नियं महाभागा गृहीतनियमा शुभा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003638032, "chapter_id": 23638, "verse_number": "१-२-२५-३३", "content_sanskrit": "मुहूर्तपंचमात्रेण नियमोऽस्याः समाप्यते ।\nतत्प्रतीक्षस्व तं कालं पश्चादस्मत्सखीसमम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003638033, "chapter_id": 23638, "verse_number": "१-२-२५-३४", "content_sanskrit": "नानाविदा धर्मवार्ताः प्रकरिष्यसि ब्राह्मण ।\nइत्युक्त्वा विजयाद्यास्ता देवीचरितवर्णनैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003638034, "chapter_id": 23638, "verse_number": "१-२-२५-३५", "content_sanskrit": "अश्रुमुख्यो द्विजस्याग्रे निन्युः कालं च तं तदा ।\nततः काले किंचिदूने ब्रह्मचारी महामतिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003638035, "chapter_id": 23638, "verse_number": "१-२-२५-३६", "content_sanskrit": "विलोकनमिषेणागादाश्रमोपस्थितं ह्रदम् ।\nनिपपात च तत्रासौ चुक्रोशातितरां ततः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003638036, "chapter_id": 23638, "verse_number": "१-२-२५-३७", "content_sanskrit": "अहमत्र निमज्जामि कोऽपि मामुद्धरेत भोः ।\nइति तारेण क्रोशंतं श्रुत्वा तं विजयादिकाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003638037, "chapter_id": 23638, "verse_number": "१-२-२५-३८", "content_sanskrit": "आजग्मुस्त्वरया युक्ता ददुस्तस्मै करं च ताः ।\nस चुक्रोश ततो गाढं दूरेदूरे पुनःपुनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003638038, "chapter_id": 23638, "verse_number": "१-२-२५-३९", "content_sanskrit": "नाहं स्पृशाम्यसंसिद्धां म्रिये वा नानृतं त्विदम् ।\nततः समाप्तनियमा पार्वती स्वयमाययौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003638039, "chapter_id": 23638, "verse_number": "१-२-२५-४०", "content_sanskrit": "सव्यं करं ददावस्य तं चासौ नाभ्यनन्दत ।\nभद्रे यच्छुचि नैव स्याद्यच्चैवावज्ञया कृतम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003638040, "chapter_id": 23638, "verse_number": "१-२-२५-४१", "content_sanskrit": "सदोषेण कृतं यच्च तदादद्यान्न कर्हिचित् ।\nसव्यं चाशुचि ते हस्तं नावलंबामि कर्हिचित् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003638041, "chapter_id": 23638, "verse_number": "१-२-२५-४२", "content_sanskrit": "इत्युक्ता पार्वती प्राह नाहं दत्तं च दक्षिणम् ।\nददामि कस्यचिद्विप्र देवदेवाय कल्पितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003638042, "chapter_id": 23638, "verse_number": "१-२-२५-४३", "content_sanskrit": "दक्षिणं मे करं देवो ग्रहीता भव एव च ।\nशीर्यते चोग्रतपसा सत्यमेतन्मयोदितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003638043, "chapter_id": 23638, "verse_number": "१-२-२५-४४", "content_sanskrit": "विप्र उवाच ।\nयद्येवमवलेपस्ते गमनं केन वार्यते ।\nयथा तव प्रतिज्ञेयं ममापीयं तथाचला ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003638044, "chapter_id": 23638, "verse_number": "१-२-२५-४५", "content_sanskrit": "रुद्रस्यापि वयं मान्याः कीदृशं ते तपो वद ।\nविषमस्थं यत्र विप्रं म्रियमाणमुपेक्षसि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003638045, "chapter_id": 23638, "verse_number": "१-२-२५-४६", "content_sanskrit": "अवजा नासि विप्रांस्त्वं तच्छीघ्रं व्रज दर्शनात् ।\nयदि वा मन्यसे पूज्यांस्ततोऽभ्युद्धर नान्यथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003638046, "chapter_id": 23638, "verse_number": "१-२-२५-४७", "content_sanskrit": "ततो विचार्य बहुधा इति चेति च सा शुभा ।\nविप्रस्योद्धरणं सर्वधर्मेभ्योऽमन्यताधिकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003638047, "chapter_id": 23638, "verse_number": "१-२-२५-४८", "content_sanskrit": "ततः सा दक्षिणं दत्त्वा करं तं प्रोज्जहार च ।\nनरं नारी प्रोद्धरति सज्जन्तं भववारिधौ ।\nएतत्सन्दर्शनार्थाय तथा चक्रे भवोद्भवः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003638048, "chapter_id": 23638, "verse_number": "१-२-२५-४९", "content_sanskrit": "प्रोद्धृत्य च ततः स्नात्वा बद्ध्व योगासनं स्थिता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003638049, "chapter_id": 23638, "verse_number": "१-२-२५-५०", "content_sanskrit": "ब्रह्मचारी ततः प्राह प्रहसन्किमिदं शुभे ।\nकर्तुकामासि तन्वंगि दृढयोगासनस्थिता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003638050, "chapter_id": 23638, "verse_number": "१-२-२५-५१", "content_sanskrit": "देवी प्राह ज्वालयिष्ये शरीरं योगवह्निना ।\nमहादेवकृतमतिरुच्छिष्टाहं यतोऽभवम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003638051, "chapter_id": 23638, "verse_number": "१-२-२५-५२", "content_sanskrit": "ब्रह्मचारी ततः प्राह काश्चिद्ब्राह्मणकाम्यया ।\nकृत्वा वार्तास्ततः स्वीयमभीष्टं कुरु पार्वति ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003638052, "chapter_id": 23638, "verse_number": "१-२-२५-५३", "content_sanskrit": "नोपहन्यां कदाचिद्वि साधुभिर्विप्रकामना ।\nधर्ममेनं मन्यसे चेन्मुहूर्तं ब्रूहि पार्वति ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003638053, "chapter_id": 23638, "verse_number": "१-२-२५-५४", "content_sanskrit": "देवी प्राह ब्रूहि विप्र मुहूर्तं संस्थिता त्वहम् ।\nततः स्वयं व्रती प्राह देवीं तां स्वसखीयुताम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003638054, "chapter_id": 23638, "verse_number": "१-२-२५-५५", "content_sanskrit": "किमर्थमिति रम्भोरु नवे वयसि दुश्चरम् ।\nतपस्त्वया समारब्धं नानुरूपं विभाति मे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003638055, "chapter_id": 23638, "verse_number": "१-२-२५-५६", "content_sanskrit": "दुर्लभं प्राप्य मानुष्यं गिरिराजगृहेऽधुना ।\nभोगांश्च दुर्लभान्देवि त्यक्त्वा किं क्लिश्यते वपुः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003638056, "chapter_id": 23638, "verse_number": "१-२-२५-५७", "content_sanskrit": "अतीव दूये वीक्ष्य त्वां सुकुमारतराकृतिम् ।\nअत्युग्रतपसा क्लिष्टा पद्मिनीव हिमर्दिता ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003638057, "chapter_id": 23638, "verse_number": "१-२-२५-५८", "content_sanskrit": "इदं चान्यत्त्व शुभे शिरसो रोगदं मम ।\nयद्देहं त्यक्तुकामा त्वं प्रबुद्धा नासि बालिके ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003638058, "chapter_id": 23638, "verse_number": "१-२-२५-५९", "content_sanskrit": "वामः कामो मनुष्येषु सत्यमेतद्वचो यतः ।\nस्पृहणीयासि सर्वेषामेवं पीडयसे वपुः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003638059, "chapter_id": 23638, "verse_number": "१-२-२५-६०", "content_sanskrit": "अविज्ञातान्वयो नग्नः शूली भूतगणाधिपः ।\nश्मशाननिलयो भस्मोद्धूलनो वृषवाहनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003638060, "chapter_id": 23638, "verse_number": "१-२-२५-६१", "content_sanskrit": "गजाजिनो द्विजिह्वाद्यलंकृतांगो जटाधरः ।\nविरूपाक्षः कथंकारं निर्गुणः स्यात्तवोचितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003638061, "chapter_id": 23638, "verse_number": "१-२-२५-६२", "content_sanskrit": "गुणा ये कुलशीलाद्य वराणामुदिता बुधैः ।\nतेषामेकोऽपि नैवास्ति तस्मिंस्तन्नोचितः स ते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003638062, "chapter_id": 23638, "verse_number": "१-२-२५-६३", "content_sanskrit": "शोचनीयतमा पूर्वमासीत्पार्वति कौमुदी ।\nत्वं संवृत्ता द्वितीयासि तस्यास्तत्संगमाशया ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003638063, "chapter_id": 23638, "verse_number": "१-२-२५-६४", "content_sanskrit": "तपोधनाः सर्वसमा वयं यद्यपि पार्वति ।\nदुनोत्येव तवारंभः शूलायां यूपसत्क्रिया ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003638064, "chapter_id": 23638, "verse_number": "१-२-२५-६५", "content_sanskrit": "वृषभारोहणं वासः श्मशाने पाणिसंग्रहः ।\nसव्यालपाणिना क्षौमगजत्वग्बंधनः कथम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003638065, "chapter_id": 23638, "verse_number": "१-२-२५-६६", "content_sanskrit": "जनहास्यकरं सर्वं त्वयारब्धमसांप्रतम् ।\nस्त्रीभावाद्भूतिसंपर्क्कः कथं चाभिमतस्तव ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003638066, "chapter_id": 23638, "verse_number": "१-२-२५-६७", "content_sanskrit": "निवर्तय मनस्तस्मादस्मात्सर्वविरोधिनः ।\nमृगाक्षि मदनारातेर्मर्कटाक्षस्य प्रार्थनात् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003638067, "chapter_id": 23638, "verse_number": "१-२-२५-६८", "content_sanskrit": "विरुद्धवादिनं चैवं ब्रह्मचारिणमीश्वरम् ।\nनिशम्य कुपिता देवी प्राह वाचा सगद्गदम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003638068, "chapter_id": 23638, "verse_number": "१-२-२५-६९", "content_sanskrit": "मा मा ब्राह्मण भाषिष्ठा विरुद्धमिति शंकरे ।\nमहत्तमो याति पुमान्देवदेवस्य निंदया ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003638069, "chapter_id": 23638, "verse_number": "१-२-२५-७०", "content_sanskrit": "न सम्यगभिजानासि तस्य देवस्य चेष्टितम् ।\nश्रृणु ब्राह्मण त्वं पापाद्यथास्मात्परिमुच्यसे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003638070, "chapter_id": 23638, "verse_number": "१-२-२५-७१", "content_sanskrit": "स आदिः सर्वजगतां कोस्य वेदान्वयं ततः ।\nसर्वं जगद्यस्य रूपं दिग्वासाः कीर्त्यते ततः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003638071, "chapter_id": 23638, "verse_number": "१-२-२५-७२", "content_sanskrit": "गुणत्रयमयं शूलं शूली यस्माद्बिभार्ते सः ।\nअबद्धाः सर्वतो मुक्ता भूता एव च तत्पतिः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003638072, "chapter_id": 23638, "verse_number": "१-२-२५-७३", "content_sanskrit": "श्मशानं चापि संसारस्तद्वासी कृपयार्थिनाम् ।\nभूतयः कथिता भूतिस्तां बिभर्ति स भूतिभृत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003638073, "chapter_id": 23638, "verse_number": "१-२-२५-७४", "content_sanskrit": "वृषो धर्म इति प्रोक्तस्तमारूढस्ततो वृषी ।\nसर्पाश्च दोषाः क्रोधाद्यास्तान्बिभर्ति जगन्मयः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003638074, "chapter_id": 23638, "verse_number": "१-२-२५-७५", "content_sanskrit": "नानाविधाः कर्मयोगा जटारूपा बिभर्ति सः ।\nवेदत्रयी त्रिनेत्राणि त्रिपुरं त्रिगुणं वपुः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003638075, "chapter_id": 23638, "verse_number": "१-२-२५-७६", "content_sanskrit": "भस्मीकरोति तद्देवस्त्रिपुरध्नस्ततः स्मृतः ।\nएवंविध महादेवं विदुर्ये सूक्ष्मदर्शिनः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003638076, "chapter_id": 23638, "verse_number": "१-२-२५-७७", "content_sanskrit": "कथंकारं हि ते नाम भजंते नैव तं हरम् ।\nअथ वा भीतसंसाराः सर्वे विप्र यतो जनाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003638077, "chapter_id": 23638, "verse_number": "१-२-२५-७८", "content_sanskrit": "विमृश्य कुर्वते सर्वं विमृश्यैतन्मया कृतम् ।\nशुभं वाप्यशुभं वास्तु त्वमप्येनं प्रपूजय ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003638078, "chapter_id": 23638, "verse_number": "१-२-२५-७९", "content_sanskrit": "इति ब्रुवंत्यां तस्यां तु किंचित्प्रस्फुरिताधरम् ।\nविज्ञाय तां सखीमाह किमप्येष विवक्षुकः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003638079, "chapter_id": 23638, "verse_number": "१-२-२५-८०", "content_sanskrit": "वार्यतामिति विप्रोऽयं महद्दूषणबाषकः ।\nन केवलं पापभागी श्रोता वै स्यान्न संशयः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003638080, "chapter_id": 23638, "verse_number": "१-२-२५-८१", "content_sanskrit": "अथ वा किं च नः कार्यं वादेन सह ब्राह्मणैः ।\nकर्णौ पिधाय यास्यामो यथा यः स्यात्ततास्तु सः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003638081, "chapter_id": 23638, "verse_number": "१-२-२५-८२", "content_sanskrit": "इत्युक्त्वोत्थाय गच्छंत्यां पिधाय श्रवणावुभौ ।\nस्वरूपं समुपाश्रित्य जगृहे वसनं हरः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003638082, "chapter_id": 23638, "verse_number": "१-२-२५-८३", "content_sanskrit": "ततो निरीक्ष्य तं देवं संभ्रांता परमेश्वरी ।\nप्रणिपत्य महेशानं तुष्टावावनता उमा ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003638083, "chapter_id": 23638, "verse_number": "१-२-२५-८४", "content_sanskrit": "प्राह तां च महादेवो दासोऽस्मि तव शोभने ।\nतपोद्रव्येण क्रीतश्च समादिश यथेप्सितम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003638084, "chapter_id": 23638, "verse_number": "१-२-२५-८५", "content_sanskrit": "देव्युवाच ।\nमनसस्त्वं प्रभुः शंभो दत्तं तच्च मया तव ।\nवपुषः पितरावीशौ तौ सम्मानयितुमर्हसि ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003638085, "chapter_id": 23638, "verse_number": "१-२-२५-८६", "content_sanskrit": "महादेव उवाच ।\nपित्रा हि ते परिज्ञातं दृष्ट्वा त्वां रूपशालिनीम् ।\nबालां स्वयंवरं पुत्री महं दास्यामि नान्यथा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003638086, "chapter_id": 23638, "verse_number": "१-२-२५-८७", "content_sanskrit": "तत्तस्य सर्वमेवास्तु वचनं त्वं हिमाचलम् ।\nस्वयंवरार्थं सुश्रोणि प्रेरय त्वां वृणे ततः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003638087, "chapter_id": 23638, "verse_number": "१-२-२५-८८", "content_sanskrit": "इत्युक्त्वा तां महादेवः शुचिः शुचिषदो विभुः ।\nजगामेष्टं तदा देशं स्वपुरं प्रययौ च सा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003638088, "chapter_id": 23638, "verse_number": "१-२-२५-८९", "content_sanskrit": "दृष्ट्वा देवीं तदा हृष्टो मेनया सहितोऽचलः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003638089, "chapter_id": 23638, "verse_number": "१-२-२५-९०", "content_sanskrit": "आलिंग्याघ्राय पप्रच्छ सर्वं सा च न्यवेदयत् ।\nदुहितुर्देवदेवेन आज्ञप्तं तु हिमाचलः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003638090, "chapter_id": 23638, "verse_number": "१-२-२५-९१", "content_sanskrit": "स्वयंवरं प्रमुदितः सर्वलोकेष्वघोषयत् ।\nअश्विनो द्वादशादित्या गन्धर्वरुडोरगाः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003638091, "chapter_id": 23638, "verse_number": "१-२-२५-९२", "content_sanskrit": "यक्षाः सिद्धास्तथा साध्या दैत्याः किंपुरुषा नगाः ।\nसमुद्राद्याश्च ये केचित्त्रैलोक्यप्रवरास्च ये ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003638092, "chapter_id": 23638, "verse_number": "१-२-२५-९३", "content_sanskrit": "त्रयस्त्रिंशत्सहस्राणि त्रयस्त्रिंशच्छतानि च ।\nत्रयस्त्रिंशच्च ये देवास्त्रयस्त्रिंशच्च कोटयः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003638093, "chapter_id": 23638, "verse_number": "१-२-२५-९४", "content_sanskrit": "जग्मुर्गिरीन्द्रपुत्र्यास्तु स्वयंवरमनुत्तमम् ।\nआमंत्रितस्तथा विष्णुर्मेरुमाह हसन्निव ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003638094, "chapter_id": 23638, "verse_number": "१-२-२५-९५", "content_sanskrit": "तातास्माकं च सा देवी मेरो गच्छ नमामि ताम् ।\nअथ शैलसुता देवी हैममारुह्य शोभनम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003638095, "chapter_id": 23638, "verse_number": "१-२-२५-९६", "content_sanskrit": "विमानं सर्वतोभद्रं सर्वरत्नैरलंकृतम् ।\nअप्सरोभिः प्रनृत्यद्भिः सर्वाभरणभूषिता ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003638096, "chapter_id": 23638, "verse_number": "१-२-२५-९७", "content_sanskrit": "गंधर्वसंघैर्विविधैः किंनरैश्च सुशोभनैः ।\nबंदिभिः स्तूयमाना च वीरकांस्यधरा स्थिता ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003638097, "chapter_id": 23638, "verse_number": "१-२-२५-९८", "content_sanskrit": "सितातपत्ररत्नांशुमिश्रितं चावहत्तदा ।\nशालिनी नाम पार्वत्याः संध्यापूर्णेदुमंडला ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003638098, "chapter_id": 23638, "verse_number": "१-२-२५-९९", "content_sanskrit": "चामरासक्तहस्ताभिर्दिव्यस्त्रीभिश्च संवृता ।\nमालां प्रगृह्य सा तस्थौ सुरद्रुमसमुद्भवाम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003638099, "chapter_id": 23638, "verse_number": "१-२-२५-१००", "content_sanskrit": "एवं तस्यां स्थितायां तु स्थिते लोकत्रये तदा ।\nशिशुर्भूत्वा महादेवः क्रीडार्थं वृषभध्वजः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003638100, "chapter_id": 23638, "verse_number": "१-२-२५-१०१", "content_sanskrit": "उत्संगतलसंगुप्तो बभूव भगवान्भवः ।\nजयेति यत्पदं ख्यातं तस्य सत्यार्थमीश्वरम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003638101, "chapter_id": 23638, "verse_number": "१-२-२५-१०२", "content_sanskrit": "अथ दृष्ट्वा शिशुं देवास्तस्य उत्संगवर्तिनः ।\nकोयमत्रेति संमंत्र्य चुक्रुशुर्भृशरोषिताः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003638102, "chapter_id": 23638, "verse_number": "१-२-२५-१०३", "content_sanskrit": "वज्रमाहारयत्तस्य बाहुमुद्यम्य वृत्रहा ।\nस बाहुरुद्यतस्तस्य तथैव समतिष्ठत ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003638103, "chapter_id": 23638, "verse_number": "१-२-२५-१०४", "content_sanskrit": "स्तंभितः शिशुरूपेण देवदेवेन लीलया ।\nवज्रं क्षेप्तुं न शक्नोति बाहुं चालयितुं तदा ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003638104, "chapter_id": 23638, "verse_number": "१-२-२५-१०५", "content_sanskrit": "वह्निः शक्तिं तदा क्षेप्तुं न शशाक तथोत्थितः ।\nयमोऽपि दंडं खड्गं च निरृतिस्तं शिशुं प्रति ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003638105, "chapter_id": 23638, "verse_number": "१-२-२५-१०६", "content_sanskrit": "पाशं च वरुणो राजा ध्वजयष्टिं समीरणः ।\nसोमो गुडं धनेशश्च गदां सुमहतीं दृढाम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003638106, "chapter_id": 23638, "verse_number": "१-२-२५-१०७", "content_sanskrit": "नानायुधानि चादित्या मुसलं वसवस्तथा ।\nमहाघोराणि शस्त्राणि तारकाद्याश्च दानवाः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003638107, "chapter_id": 23638, "verse_number": "१-२-२५-१०८", "content_sanskrit": "स्तंभिता देवदेवेन तथान्ये भुवनेषु ये ।\nपूषा दंतान्दशन्दंर्बालमैक्षत मोहितः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003638108, "chapter_id": 23638, "verse_number": "१-२-२५-१०९", "content_sanskrit": "तस्यापि दशनाः पेतुर्दृष्टमात्रस्य शंभुना ।\nभगश्च नेत्रे विकृते चकार स्फुटिते च ते ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003638109, "chapter_id": 23638, "verse_number": "१-२-२५-११०", "content_sanskrit": "बलं तेजश्च योगांश्च सर्वेषां जगृहे प्रभुः ।\nअथ तेषु स्थितेष्वेव मन्युमत्सु सुरेष्वपि ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003638110, "chapter_id": 23638, "verse_number": "१-२-२५-१११", "content_sanskrit": "ब्रह्मा ध्यानमुपाश्रित्य बुबोध हरचेष्टितम् ।\nसोऽभिगम्य महादेवं तुष्टाव प्रयतो विधिः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003638111, "chapter_id": 23638, "verse_number": "१-२-२५-११२", "content_sanskrit": "पौराणैः सामसंगीतैर्वेदिकैर्गुह्यनामभिः ।\nनमस्तुभ्यं महादेव महादेव्यै नमोनमः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003638112, "chapter_id": 23638, "verse_number": "१-२-२५-११३", "content_sanskrit": "प्रसादात्तव बुद्ध्यादिर्जगदेतत्प्रवर्तते ।\nमूढाश्च देवताः सर्वा नैनं बुध्यत शंकरम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003638113, "chapter_id": 23638, "verse_number": "१-२-२५-११४", "content_sanskrit": "महादेवमिहायातं सर्वदेवनमस्कृतम् ।\nगच्छध्वं शरणं शीघ्रं यदि जीवितुमिच्छत ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003638114, "chapter_id": 23638, "verse_number": "१-२-२५-११५", "content_sanskrit": "ततः संभ्रम संपन्नास्तुष्टुवुः प्रणताः सुराः ।\nनमोनमो महादेव पाहिपाहि जगत्पते ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003638115, "chapter_id": 23638, "verse_number": "१-२-२५-११६", "content_sanskrit": "दुराचारान्भवानस्मानात्मद्रोहपरायणान् ।\nअहो पश्यत नो मौढ्यं जानंतस्तव भाविनीम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003638116, "chapter_id": 23638, "verse_number": "१-२-२५-११७", "content_sanskrit": "भार्यामुमां महादेवीं तथाप्यत्र समागताः ।\nयुक्तमेतद्यदस्माकं राज्यं गृह्येत चासुरैः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003638117, "chapter_id": 23638, "verse_number": "१-२-२५-११८", "content_sanskrit": "येषामेवंविधाबुद्धिरस्माभिः किं कृतं त्विदम् ।\nअथ वा नो न दोषोऽस्ति पशवो हि वयं यतः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003638118, "chapter_id": 23638, "verse_number": "१-२-२५-११९", "content_sanskrit": "त्वयैव पतिना सर्वे प्रेरिताः कुर्महे विभो ।\nईश्वरः सर्व भूतानां पतिस्त्वं परमेश्वरः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003638119, "chapter_id": 23638, "verse_number": "१-२-२५-१२०", "content_sanskrit": "भ्रामयस्यखिलं विश्वं यन्त्रारूढं स्वमायया ।\nयेन विभ्रामिता मूढाः समायाताः स्वयंवरम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003638120, "chapter_id": 23638, "verse_number": "१-२-२५-१२१", "content_sanskrit": "तस्मै पशुनां पतये नमस्तुभ्यं प्रसीद नः ।\nअथ तेषां प्रसन्नऽभूद्देवदेवास्त्रियंबकः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003638121, "chapter_id": 23638, "verse_number": "१-२-२५-१२२", "content_sanskrit": "यथापूर्वं चकारैतान्संस्तवाद्ब्रह्मणः प्रभुः ।\nतारकप्रमुखा दैत्याः संक्रुद्धास्तत्र प्रोचिरे ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003638122, "chapter_id": 23638, "verse_number": "१-२-२५-१२३", "content_sanskrit": "कोयमंग महादेवो न मन्यामो वयं च तम् ।\nततः प्रहस्य बालोऽसौ हुंकारं लीलया व्यधात् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003638123, "chapter_id": 23638, "verse_number": "१-२-२५-१२४", "content_sanskrit": "हुंकारेणैव ते दैत्याः स्वमेव नगरं गताः ।\nविस्मृतं सकलं तेषां स्वयंवरमुखं च तत् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003638124, "chapter_id": 23638, "verse_number": "१-२-२५-१२५", "content_sanskrit": "महादेवप्रभावेन दैत्यानां घोरकर्मणाम् ।\nएवं यस्य प्रभावो हि देवदैत्येषु फाल्गुन ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003638125, "chapter_id": 23638, "verse_number": "१-२-२५-१२६", "content_sanskrit": "कथमीश्वरवाक्यार्थस्तस्मादन्यत्र मुच्यते ।\nअसंशयं विमुढास्ते पश्चात्तापः पुरा महान् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003638126, "chapter_id": 23638, "verse_number": "१-२-२५-१२७", "content_sanskrit": "ईश्वरं भुवनस्यास्य ये भजंते न त्र्यंबकम् ।\nततः संस्तूयमानः स सुरैः पद्मभुवादिभिः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003638127, "chapter_id": 23638, "verse_number": "१-२-२५-१२८", "content_sanskrit": "वपुश्चकार देवेशस्त्र्यंबकः परमाद्भुतम् ।\nतेजसा तस्य देवास्ते सेंद्रचंद्रदिवाकराः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003638128, "chapter_id": 23638, "verse_number": "१-२-२५-१२९", "content_sanskrit": "सब्रह्मकाः ससाध्याश्च वसुर्विश्वे च देवताः ।\nसयमाश्च सरुद्राश्च चक्षुरप्रार्थयन्प्रभुम् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003638129, "chapter_id": 23638, "verse_number": "१-२-२५-१३०", "content_sanskrit": "तेभ्यः परतमं चक्षुः स्ववपुर्द्रष्टुमुत्तमम् ।\nददावम्बापतिः शर्वो भवान्याश्चालस्य च ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003638130, "chapter_id": 23638, "verse_number": "१-२-२५-१३१", "content_sanskrit": "लब्ध्वा रुद्रप्रसादेन दिव्यं चक्षुरनुत्तमम् ।\nसब्रह्यकास्तदा देवास्तमपश्यन्महेश्वरम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003638131, "chapter_id": 23638, "verse_number": "१-२-२५-१३२", "content_sanskrit": "ततो जगुश्च मुनयः पुष्पवृष्टिं च खेचराः ।\nमुमुचुश्च तदा नेदुर्देवदुंदुभयो भृशम् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003638132, "chapter_id": 23638, "verse_number": "१-२-२५-१३३", "content_sanskrit": "जगुगधर्वमुख्याश्च ननृतुश्चाप्सरोगणाः ।\nमुमुदुर्गणपाः सर्वे मुमोदांबा च पार्वती ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003638133, "chapter_id": 23638, "verse_number": "१-२-२५-१३४", "content_sanskrit": "ब्रह्माद्या मेनिरे पूर्णां भवानीं च गिरीश्वरम् ।\nतस्य देवी ततो हृष्टा समक्षं त्रिदिवौकसाम् ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003638134, "chapter_id": 23638, "verse_number": "१-२-२५-१३५", "content_sanskrit": "पादयोः स्थापयामास मालां दिव्यां सुगंधिनीम् ।\nसादुसाध्विति संप्रोच्य तया तं तत्र चर्चितम् ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003638135, "chapter_id": 23638, "verse_number": "१-२-२५-१३६", "content_sanskrit": "सह देव्या नमश्चक्रुः शिरोभिर्भूतलाश्रितैः ।\nसर्वे सब्रह्मका देवा जयेति च मुदा जगुः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}]