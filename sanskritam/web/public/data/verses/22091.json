[{"id": 7002091000, "chapter_id": 22091, "verse_number": "१३६-१", "content_sanskrit": "ईश्वर उवाच ।\nअथ चक्रं प्रवक्ष्यामि यात्रादौ च फलप्रदम् ।\nअश्विन्यादौ लिखेच्चक्रं त्रिनाडीपरिभूषितं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002091001, "chapter_id": 22091, "verse_number": "१३६-२", "content_sanskrit": "अश्विन्यार्द्रादिभिः पूर्वा ततश्चोत्तरफल्गुनी ।\nहस्ता ज्येष्ठा तथा मूलं वारुणं चाप्यजैकपात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002091002, "chapter_id": 22091, "verse_number": "१३६-३", "content_sanskrit": "नाडीयं प्रथमा चान्या याम्यं मृगशिरस्तथा ।\nपुष्यं भाग्यन्तथा चित्रा मैत्रञ्चाप्यं च वासवं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002091003, "chapter_id": 22091, "verse_number": "१३६-४", "content_sanskrit": "अहिर्बुध्न्यं तृतीयाथ कृत्तिका रोहिणी ह्यहिः ।\nचित्रा स्वाती विशाखा च श्रवणा रेवती च भं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002091004, "chapter_id": 22091, "verse_number": "१३६-५", "content_sanskrit": "नाडीत्रितयसंजुष्टग्रहाज्ज्ञेयं शुभाशुभं ।\nचक्रम्फणीश्वरन्तत्तु त्रिनाडीपरिभूषितं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002091005, "chapter_id": 22091, "verse_number": "१३६-६", "content_sanskrit": "रविभौमार्कराहुस्थमशुभं स्याच्छुभं परं ।\nदेशग्रामयुता भ्रातृभार्याद्या एकशः शुभाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]