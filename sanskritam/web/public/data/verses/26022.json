[{"id": 7006022000, "chapter_id": 26022, "verse_number": "१-२०५-१", "content_sanskrit": "कुमार उवाच ।\nअथ व्याकरणं वक्ष्ये कात्यायन समासत ।\nसिद्धशब्दविवेकाय बालव्युत्पत्तिहेतवे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006022001, "chapter_id": 26022, "verse_number": "१-२०५-२", "content_sanskrit": "सुप्तिङन्तं पदं ख्यातं सुपः सप्त विभक्तयः ।\nस्वौजसः प्रथमा प्रोक्ता सा प्रातिपदिकात्मके ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006022002, "chapter_id": 26022, "verse_number": "१-२०५-३", "content_sanskrit": "सम्बोधने च लिङ्गादावुक्ते कर्मणि कर्तरि। ।\nअर्थवत्प्रातिपदिकं धातुप्रत्ययवर्जितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006022003, "chapter_id": 26022, "verse_number": "१-२०५-४", "content_sanskrit": "अमौशसो द्वितीया स्यात्तत्कर्म क्रियते च त् ।\nद्वितीया कर्मणि प्रोक्तान्तरान्तरेण संयुते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006022004, "chapter_id": 26022, "verse_number": "१-२०५-५", "content_sanskrit": "टाभ्यांभिसस्तृतीया स्यात्करणे कर्तरीरिता ।\nयेन क्रियते करणं तत्कर्ता यः करोति सः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006022005, "chapter_id": 26022, "verse_number": "१-२०५-६", "content_sanskrit": "ङेभ्यांभ्यसश्चतुर्थो स्यात्सम्प्रदाने च कारक ।\nयस्मै दित्सा धारयते रोचते सम्प्रदानकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006022006, "chapter_id": 26022, "verse_number": "१-२०५-७", "content_sanskrit": "पञ्चमी स्यान्ङसिभ्यांभ्योह्यपादाने च कारक ।\nयतोऽपैति समादत्ते उपादत्ते भयं यतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006022007, "chapter_id": 26022, "verse_number": "१-२०५-८", "content_sanskrit": "ङसोसामश्च षष्ठी स्यात्स्वामिसम्बन्धमुख्यके ।\nङयोः सुपो वै सप्तमी स्यात्सा चाधिकरणे भवेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006022008, "chapter_id": 26022, "verse_number": "१-२०५-९", "content_sanskrit": "आधारश्चाधिकरणं रक्षार्थानां प्रयोगतः ।\nईप्सितं चानीप्सितं यत्तदपादानकं स्मृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006022009, "chapter_id": 26022, "verse_number": "१-२०५-१०", "content_sanskrit": "पञ्चमी पर्युपाङ्योगे इतरर्तेऽन्यदिङ्मुख। ।\nएनयोगे द्वितीया स्यात्कर्मप्रवचनीयकैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006022010, "chapter_id": 26022, "verse_number": "१-२०५-११", "content_sanskrit": "वीप्सेत्थम्भावचिह्नेऽभिर्भागेनैव परिप्रती ।\nअनुरेषु सहार्थे च हीनेऽनूपश्च कथ्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006022011, "chapter_id": 26022, "verse_number": "१-२०५-१२", "content_sanskrit": "द्वितीया च चतुर्थो स्याच्चेष्टायां गतिकर्मणि ।\nअप्राणे हि विभक्ती द्बे मन्यकर्मण्यनादरे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006022012, "chapter_id": 26022, "verse_number": "१-२०५-१३", "content_sanskrit": "नमः स्वस्तिस्वधास्वाहालंवषड्योग ईरिता ।\nचतुर्थो चैव तादर्थ्ये तुमर्थाद्भाववाचिनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006022013, "chapter_id": 26022, "verse_number": "१-२०५-१४", "content_sanskrit": "तृतीया सहयोगे स्यात्कुत्सितेङ्गे विशेषणे ।\nकाले भावे सप्तमी स्यादेतैर्योगेऽपिषष्ठ्यति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006022014, "chapter_id": 26022, "verse_number": "१-२०५-१५", "content_sanskrit": "स्वामीश्वराधिपतिभिः साक्षिदायादप्रसूतैः ।\nनिर्धारणे द्वे विभक्तो षष्ठी हेतुप्रयोगके ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006022015, "chapter_id": 26022, "verse_number": "१-२०५-१६", "content_sanskrit": "स्मृत्यर्थकर्मणि तथा करोतेः प्रतियत्नके ।\nहिंसार्थानां प्रयोगे च कृति कर्मणि कर्तरि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006022016, "chapter_id": 26022, "verse_number": "१-२०५-१७", "content_sanskrit": "न कर्तृकर्मणोः षष्ठी निष्ठयोः प्रातिपदिक। ।\nद्विविधं प्रातिपदिकं नाम धातुस्तथैव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006022017, "chapter_id": 26022, "verse_number": "१-२०५-१८", "content_sanskrit": "भूवान्दिभ्यस्तिङो लः स्याल्लकारा दश वै स्मृताः ।\nतिप्तसूझि प्रथमो मध्यः सिप्थस्थोत्तमपूरुषः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006022018, "chapter_id": 26022, "verse_number": "१-२०५-१९", "content_sanskrit": "मिब्वस्मस्तु परस्मै हि पदानां चात्मनेपदम् ।\nताताञ्झ प्रथमो मध्य स्थासाथान्ध्वमथोत्तमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006022019, "chapter_id": 26022, "verse_number": "१-२०५-२०", "content_sanskrit": "आदेशा इड्बहिमहि धातुतोथ णिजादिवत् ।\nनाम्नि प्रयुज्यमानेऽपि प्रथमः पुरुषो भवेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006022020, "chapter_id": 26022, "verse_number": "१-२०५-२१", "content_sanskrit": "मध्यमो युष्मदि प्रोक्त उत्तमः पुरुषोऽस्मदि ।\nभूवाद्या धातवः प्रोक्ताः सनाद्यन्तास्तथा ततः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006022021, "chapter_id": 26022, "verse_number": "१-२०५-२२", "content_sanskrit": "लडीरितो वर्तमाने स्मेनातीते च धातुतः ।\nभूतेऽनद्यतने लङ्वा लोडाद्याशिषि धातुतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006022022, "chapter_id": 26022, "verse_number": "१-२०५-२३", "content_sanskrit": "विध्यादावेवानुमतो लोड्वाच्यो मन्त्रणे भवेत् ।\nनिमन्त्रणाधीष्टसंप्रश्रे प्रार्थनेषु तथाशिषि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006022023, "chapter_id": 26022, "verse_number": "१-२०५-२४", "content_sanskrit": "लिङतीते परोक्षे स्याल्लिड्भूते ळड्भविष्यति ।\nस्यादनद्यतने तद्वद्भविष्यति तु धातुतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006022024, "chapter_id": 26022, "verse_number": "१-२०५-२५", "content_sanskrit": "दातोरॢङ्क्रियातिपत्तौ लिङर्थे लेट्प्रकीर्तितः ।\nकृतस्त्रिष्वपि वर्तन्ते भावे कर्मणि कर्तरि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006022025, "chapter_id": 26022, "verse_number": "१-२०५-२६", "content_sanskrit": "सदृशास्तव्यता ण्यद्यदनीयाश्च तृजादयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]