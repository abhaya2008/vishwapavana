[{"id": 2112876, "chapter_id": 3432, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112877, "chapter_id": 3432, "verse_number": "१", "content_sanskrit": "रूपशीलगुणोपेता धर्मकामा नरर्षभ ।\nदुहिता कुन्तिभोजस्य कुन्ती राष्ट्रे पतिंवरा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112878, "chapter_id": 3432, "verse_number": "२", "content_sanskrit": "सिंहदंष्ट्रं महाबाहुमृषभाक्षं मनस्विनम्।\nपतिं वव्रे महेष्वासं पाण्डुं कुन्ती यशस्विनी \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112879, "chapter_id": 3432, "verse_number": "३", "content_sanskrit": "भूमिपालसहस्राणामग्रतः स तया वृतः ।\nयुयुजे भरतश्रेष्ठः पौलोम्या मघवानिव \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112880, "chapter_id": 3432, "verse_number": "४", "content_sanskrit": "यात्वा देवव्रतेनापि मद्राणां पुटभेदनम् ।\nविश्रुता सर्वलोकेषु माद्री मद्रपतेः सुता \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112881, "chapter_id": 3432, "verse_number": "५", "content_sanskrit": "सर्वराजसु विख्याता रूपेणासदृशी भुवि ।\nपाण्डोरर्थे धनुष्क्रीता मद्रराजेश्वरात्मजा \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112882, "chapter_id": 3432, "verse_number": "६", "content_sanskrit": "विवाहं कारयामास भीप्मः पाण्डोर्महात्मनः ।\nसिंहोरस्कं महेष्वासं वृषभाक्षं मनस्विनम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112883, "chapter_id": 3432, "verse_number": "७", "content_sanskrit": "दृष्ट्वा पाण्डुं नरव्याघ्रं व्यस्मयन्त नरा मुवि ।\nकृतोद्वाहस्तदा पाण्डुर्बलोत्साहसमन्वितः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112884, "chapter_id": 3432, "verse_number": "८", "content_sanskrit": "गोप्ता भरतवंशस्य पाण्डुः सर्वास्त्रकोविदः ।\nजिगीषमाणो वसुधां ययौ शत्रूननेकशः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112885, "chapter_id": 3432, "verse_number": "९", "content_sanskrit": "पूर्वमागस्कृतो यात्वा दशार्णाः समरे हताः ।\nपाण्डुना नरसिंहेन कौरवाणां यशोभृता \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112886, "chapter_id": 3432, "verse_number": "१०", "content_sanskrit": "ततः सेनामुपादाय पाण्डुर्नानायुधध्वजाम् ।\nसमृद्धहयपादातामप्रमेयरथद्विपाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112887, "chapter_id": 3432, "verse_number": "११", "content_sanskrit": "हत्वा काशीषु वङ्गेषु पुण्ड्रेषु च नराधिपान् ।\nस्वबाहुबलवीर्येण कुरूणामकरोद् यशः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112888, "chapter_id": 3432, "verse_number": "१२", "content_sanskrit": "आगस्कृत् सर्ववीराणां वैरी सर्वकुरुक्षिताम् ।\nबहूनामागसां कर्ता वैरी सर्वमहीक्षिताम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112889, "chapter_id": 3432, "verse_number": "१३", "content_sanskrit": "गोप्ता मगधराष्ट्रस्य दार्वो राजगृहे हतः ।\nततः कोशं समादाय वाहनानि बलानि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112890, "chapter_id": 3432, "verse_number": "१४", "content_sanskrit": "पाण्डुना मिथिलां यात्वा मैथिलाः समरे जिताः ।\nतं शरौघं महावेगमस्त्रज्वलितपावकम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112891, "chapter_id": 3432, "verse_number": "१५", "content_sanskrit": "पाण्डुमासाद्य राजानो न शेकुरतिवर्तितुम् ।\nते ससेनाः ससेनेन विध्वंसितमहाबलाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112892, "chapter_id": 3432, "verse_number": "१६", "content_sanskrit": "पाण्डुना पृथिवीपालाः करकर्मसु योजिताः ।\nतेन ते निर्जिताः सर्वे पृथिव्यां राजसत्तमाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112893, "chapter_id": 3432, "verse_number": "१७", "content_sanskrit": "तमेकं मेनिरे शूरं देवेष्विव पुरन्दरम् ।\nते कृताञ्जलयः शूरमासाद्य वसुधाधिपाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112894, "chapter_id": 3432, "verse_number": "१८", "content_sanskrit": "आजह्रुर्धनधान्यानि रत्नानि विविधानि च ।\nमणिप्रवाळमुक्तानि सुवर्णं रजतं तथा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112895, "chapter_id": 3432, "verse_number": "१९", "content_sanskrit": "गोरत्नान्यश्वरत्नानि रथरत्नानि कुञ्जरान् ।\nखरोष्ट्रमाहिषान् गाश्च यच्च किञ्चिदजाविकम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112896, "chapter_id": 3432, "verse_number": "२०", "content_sanskrit": "तत्सर्व प्रतिजग्राह राजा नागपुरधिपः ।\nतदादाय ययौ पाण्डुर्भृशं मुदितवाहनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112897, "chapter_id": 3432, "verse_number": "२१", "content_sanskrit": "हर्षयन् सर्वराष्ट्राणि पुरं च गजसाह्वयम् ।\nशन्तनो राजसिंहस्य भरतस्य च घीमतः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112898, "chapter_id": 3432, "verse_number": "२२", "content_sanskrit": "नष्टा कीर्तिः स्ववंशस्य पाण्डुना पुनरुद्धता ।\nये पूर्वापरराष्ट्राणि जह्रुः परधनानि च \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112899, "chapter_id": 3432, "verse_number": "२३", "content_sanskrit": "ते नागपुरसिंहेन पाण्डुना वशगाः कृताः ।\nइत्यभाषन्त राष्ट्राणि भूमिपालाश्च सङ्गताः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112900, "chapter_id": 3432, "verse_number": "२४", "content_sanskrit": "अभ्यनन्दंश्च वै पाण्डुमाशीर्वादैः पृथग्विधैः ।\nप्रसन्नमनसा हृष्टाः पाण्डुं वै कुरुभिः सह \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112901, "chapter_id": 3432, "verse_number": "२५", "content_sanskrit": "प्रत्युद्ययुस्तं प्रहृष्टाश्च सर्वे भीष्मपुरःसराः ।\nते त्वदीर्घमिवायान्तं गत्वा नागपुरालयाः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112902, "chapter_id": 3432, "verse_number": "२६", "content_sanskrit": "आवृतं ददृशुर्लोकं हृष्टा बहुविधैर्धनैः ।\nनानायानसमानीतै रत्नैरुच्चावचैस्तथा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112903, "chapter_id": 3432, "verse_number": "२७", "content_sanskrit": "अजाविकाश्वसङ्घानामुष्ट्रगोमहिषस्य च ।\nनान्तं ददृशुरासाद्य भीष्मेण सह कौरवाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112904, "chapter_id": 3432, "verse_number": "२८", "content_sanskrit": "सोऽभिवाद्य पितुः पादौ कौसल्यानन्दवर्धनः ।\nयथार्हं मानयामास पौरजानपदानपि \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112905, "chapter_id": 3432, "verse_number": "२९", "content_sanskrit": "प्रमृद्य परराष्ट्रणि कृतार्थं पुनरागतम् ।\nपुत्रमासाद्य भीष्मस्तु हर्षादश्रूण्यवर्तयत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112906, "chapter_id": 3432, "verse_number": "३०", "content_sanskrit": "स तूर्यशङ्खसङ्घैश्च भेरीणां च महास्वनैः ।\nहर्षयन् सर्वभूतानि विवेश गजसाह्वयम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112907, "chapter_id": 3432, "verse_number": "३१", "content_sanskrit": "धृतराष्ट्राभ्यनुज्ञातः स्वबाहुविजितं धनम् ।\nभीष्माय सत्यवत्यै च मात्रे चोपजहार तत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112908, "chapter_id": 3432, "verse_number": "३२", "content_sanskrit": "विदुराय च वै पाण्डुः प्रेषयामास तद्धनम् ।\nसुहृदश्चापि धर्मात्मा धनेन समतर्पयत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112909, "chapter_id": 3432, "verse_number": "३३", "content_sanskrit": "ततः सत्यवती भीष्मः कौसल्या च यशस्विनी ।\nशुभैः पाण्डुजितै रत्नैर्भृशं तुतुषुराहृतैः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112910, "chapter_id": 3432, "verse_number": "३४", "content_sanskrit": "ननन्द माता कौसल्या तमप्रतिमतेजसम् ।\nजयन्तमिव पौलोमी परिष्वज्य नरर्षभम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112911, "chapter_id": 3432, "verse_number": "३५", "content_sanskrit": "तस्य वीरस्य विक्रान्तैः सहस्रशतदक्षिणैः ।\nअश्वमेधशतैरीजे धृतराष्ट्रो महामखैः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112912, "chapter_id": 3432, "verse_number": "३६", "content_sanskrit": "सम्प्रयुक्तश्च कुन्त्या च माद्र्या च सततं नृपः ।\nजितेन्द्रियस्तदा पाण्डुर्बभूव वनगोचरः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112913, "chapter_id": 3432, "verse_number": "३७", "content_sanskrit": "हित्वा प्रासादपङ्क्तीश्च शुभानि शयनानि च ।\nचापपाणिर्मृगान् निघ्नन् बभूव मृगयापरः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112914, "chapter_id": 3432, "verse_number": "३८", "content_sanskrit": "स चरन् दक्षिणं पार्श्वं रम्यं हिमवतो गिरेः ।\nउवास गिरिशृङ्गेषु महासालवनेषु च \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112915, "chapter_id": 3432, "verse_number": "३९", "content_sanskrit": "बभूव कुन्त्या माद्र्या च पाण्डुः सह वनेचरः ।\nगजराजः करेणुभ्यां यथा मध्यगतस्तथा \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112916, "chapter_id": 3432, "verse_number": "४०", "content_sanskrit": "चरन्तं सह भार्याभ्यां बाणखङ्गधनुर्धरम् ।\nविचित्रकवचं वीरं परमास्त्रविदं नृपम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112917, "chapter_id": 3432, "verse_number": "४१", "content_sanskrit": "देवोऽयमित्यमन्यन्त चरन्तो वनवासिनः ।\nतस्य कामांश्च भोगांश्च नरा नित्यमतन्द्रिताः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112918, "chapter_id": 3432, "verse_number": "४२", "content_sanskrit": "अनुजह्रुर्वनान्तेषु धृतराष्ट्रप्रचोदिताः ।\nतदासाद्य महारण्यं मृगव्याळनिषेवितम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112919, "chapter_id": 3432, "verse_number": "४३", "content_sanskrit": "तत्र मैथुनकालस्थं ददर्श मृगयूथपम् ।\nततस्तं च मृगीं चैव रुग्मपुङ्खैः सवाजिभिः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112920, "chapter_id": 3432, "verse_number": "४४", "content_sanskrit": "निर्बिभेद शरैस्तूर्णं पाण्डुः पञ्चभिरायसैः ।\nस च राजन् महातेजा ऋषिपुत्रस्तपोयुतः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112921, "chapter_id": 3432, "verse_number": "४५", "content_sanskrit": "भार्यया सह तेजस्वी मृगरूपेण सङ्गतः ।\nस संयुक्तस्तथा मृग्या मानुषीं वाचमीरयन् ।\nक्षणेन पतितो भूमौ विललापातुरो मृगः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112922, "chapter_id": 3432, "verse_number": "", "content_sanskrit": "मृगः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112923, "chapter_id": 3432, "verse_number": "४६", "content_sanskrit": "काममन्युवशं प्राप्ता बुद्ध्यन्तरगता अपि ।\nवर्जयन्ति नृशंसानि पापेष्वभिरता जनाः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112924, "chapter_id": 3432, "verse_number": "४७", "content_sanskrit": "न विधिं ग्रसते प्रज्ञा प्रज्ञां तु ग्रसते विधिः ।\nविधिपर्यागतानर्थान् प्रज्ञया परिपश्यति \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112925, "chapter_id": 3432, "verse_number": "४८", "content_sanskrit": "तस्माद् धर्मात्मनो मुख्ये कुले जातस्य भारत ।\nकामलोभाभिभूतस्य कस्मात् ते चलिता मतिः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112926, "chapter_id": 3432, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112927, "chapter_id": 3432, "verse_number": "४९", "content_sanskrit": "या वै शत्रुवधे वृत्तिः सा मृगाणां वधे ध्रुवा ।\nराज्ञां मृग विजानीहि किं त्वं मोहाद् विगर्हसे \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2112928, "chapter_id": 3432, "verse_number": "५०", "content_sanskrit": "अमायया ह्मच्छलेन मृगाणामिषुधारिभिः ।\nवध एव भवेद् धर्मः तद्विद्वान् किं विगर्हसे \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2112929, "chapter_id": 3432, "verse_number": "५१", "content_sanskrit": "अगस्त्यः सत्रमासीनः चचार मृगयामृषिः ।\nआरण्यान् सर्वदैवत्यान् पशून् प्रेक्ष्य महावने \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2112930, "chapter_id": 3432, "verse_number": "५२", "content_sanskrit": "प्रमाणदृष्टं धर्मस्य शास्त्रं किं त्वं विगर्हसे ।\nअगस्त्यस्याभिचारेण युष्माकं हि वपा हृता \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2112931, "chapter_id": 3432, "verse_number": "५३", "content_sanskrit": "रिपूनेव समुद्दिश्य विमुञ्चन्ति पुनश्शरान् ।\nन रिपूणां समाधानं प्रतीक्षन्ते पुरातनाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2112932, "chapter_id": 3432, "verse_number": "५४", "content_sanskrit": "रन्ध्र एषां विशेषेण वधकालः प्रशस्यते ।\nप्रमत्तमप्रमत्तं वा निकृत्या घ्नन्ति चौजसा ।\nउपायैरिषुभिस्तीक्ष्णैर्मृग कस्माद् विगर्हसे\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2112933, "chapter_id": 3432, "verse_number": "", "content_sanskrit": "मृगः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2112934, "chapter_id": 3432, "verse_number": "५५", "content_sanskrit": "नाहं घ्नन्तं मृगान् राजन् विगर्हे त्वात्मकारणात् ।\nमैथुनं सम्प्रतीक्ष्यं च त्वया स्यादनृशंस्यवत्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2112935, "chapter_id": 3432, "verse_number": "५६", "content_sanskrit": "सर्वभूतहितः कालः सर्वभूतेप्सितश्च सः ।\nनृशंसं कर्म सुमहत् सर्वलोकविगर्हितम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2112936, "chapter_id": 3432, "verse_number": "५७", "content_sanskrit": "पुरुषार्थफलं कान्तं यत् त्वया वितथं कृतम् ।\nपौरवाणां नृपर्षीणां तेषामक्लिष्टकर्मणाम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2112937, "chapter_id": 3432, "verse_number": "५८", "content_sanskrit": "वंशे जातस्य राजेन्द्र नानुरुपमिदं तव ।\nअस्वर्ग्यमयशस्यं च अधर्मिष्ठं च भारत\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2112938, "chapter_id": 3432, "verse_number": "५९", "content_sanskrit": "को हि विद्वान् मृगं हन्याच्चरन्तं मैथुनं वने ।\nस्त्रीभोगानां विशेषज्ञः शास्त्रधर्मार्थतत्ववित्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2112939, "chapter_id": 3432, "verse_number": "६०", "content_sanskrit": "नार्हस्यमरसङ्काश कर्तुमाचारमीदृशम् ।\nत्वया नृशंसं कर्तारः पापाचाराश्च ये नराः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2112940, "chapter_id": 3432, "verse_number": "६१", "content_sanskrit": "निग्राह्माः पार्थिवश्रेष्ठ त्रिवर्गपरिवर्जिताः ।\nकिं कृतं ते नरश्रेष्ठ निघ्नतो मामनागसम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2112941, "chapter_id": 3432, "verse_number": "६२", "content_sanskrit": "मुनिं मूलफलाहारं मृगवेषधरं नृप ।\nवसमानमरण्येषु नित्यं शमपरायणम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2112942, "chapter_id": 3432, "verse_number": "६३", "content_sanskrit": "त्वयाऽहं निहतो यस्मात् तस्मात् त्वामप्यनागसम् ।\nआवयोर्नृशंसकर्तारमवशं काममोहितम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2112943, "chapter_id": 3432, "verse_number": "६४", "content_sanskrit": "जीवितान्तकरो भावो मैथुने समुपेष्यति ।\nअहं हि किन्दमो नाम तपसाऽप्रतिमो मुनिः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2112944, "chapter_id": 3432, "verse_number": "६५", "content_sanskrit": "अपत्रपाभिभूतत्वान्मृग्यां मैथुनमाचरम् ।\nन हि ते ब्रह्महत्येयं भविष्यत्यनु जानतः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2112945, "chapter_id": 3432, "verse_number": "६६", "content_sanskrit": "मृगरूपधरं हत्वा मामेवं काममोहितम्\nअस्य तु त्वं फलं मूढ प्राप्स्यसीदृशमेव हि\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2112946, "chapter_id": 3432, "verse_number": "६७", "content_sanskrit": "प्रियया सह संवासं प्राप्य कामविमोहितः ।\nत्वमप्यस्यामवस्थायां प्रेतलोकं गमिष्यसि \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2112947, "chapter_id": 3432, "verse_number": "६८", "content_sanskrit": "अन्तकाले च संवासं यया गन्तासि कान्तया ।\nप्रेतराजवशं प्राप्तं सर्वभूतदुरत्ययम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2112948, "chapter_id": 3432, "verse_number": "६९", "content_sanskrit": "भत्तया भक्तिमतां श्रेष्ठा सा वै त्वामनुयास्यति ।\nवर्तमानः सुखे दुःखं यथाऽहं प्रापितस्त्वया\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2112949, "chapter_id": 3432, "verse_number": "७०", "content_sanskrit": "तथा सुखं त्वं सम्प्राप्य दुःखमभ्यागमिष्यसि ।\nएवमुक्त्वा सुदुःखार्तो जीवितात् स व्ययुज्यत ।\nमृगः पाण्डुश्च शोकार्तः क्षणेन समपद्यत \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2112950, "chapter_id": 3432, "verse_number": "११०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकादशाधिकशततमोऽध्यायः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2112951, "chapter_id": 3432, "verse_number": "५९", "content_sanskrit": "॥ इति सम्भवपर्वणि एकोनषष्टितमोऽध्यायः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2112952, "chapter_id": 3432, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]