[{"id": 7004891000, "chapter_id": 24891, "verse_number": "७-१-७४-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि शाकल्येश्वरमुत्तमम् ।\nदैत्यसूदनवायव्ये धनुषां त्रिंशता स्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004891001, "chapter_id": 24891, "verse_number": "७-१-७४-२", "content_sanskrit": "शाकल्येन महादेवि पूजितं सर्वकामदम् ।\nशाकल्योनाम राजर्षिर्यत्र तप्त्वा महत्तपः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004891002, "chapter_id": 24891, "verse_number": "७-१-७४-३", "content_sanskrit": "समाराध्य महादेवं प्रत्यक्षीकृतवान्भवम् ।\nलिंगेऽवतारयामास प्रसन्नं तं महेश्वरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004891003, "chapter_id": 24891, "verse_number": "७-१-७४-४", "content_sanskrit": "तस्मिन्दृष्टे वरारोहे सप्तजन्मकृतं नृणाम् ।\nपापं प्रणश्यते शीघ्रं तमः सूर्योदये यथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004891004, "chapter_id": 24891, "verse_number": "७-१-७४-५", "content_sanskrit": "तत्राष्टम्यां चतुर्द्दश्यां स्नापयेत्पयसा शिवम् ।\nपूजयेच्च विधानेन गन्धपुष्पादिभिः क्रमात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004891005, "chapter_id": 24891, "verse_number": "७-१-७४-६", "content_sanskrit": "हिरण्यं तत्र दातव्यं सम्यग्यात्राफलेप्सुभिः ।\nचत्वारि तस्य नामानि कथ्यमानानि मे शृणु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004891006, "chapter_id": 24891, "verse_number": "७-१-७४-७", "content_sanskrit": "आदौ कृतयुगे देवि कीर्तितो भैरवेश्वरः ।\nततः सावर्णिमनुना सम्यगाराधितः प्रिये ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004891007, "chapter_id": 24891, "verse_number": "७-१-७४-८", "content_sanskrit": "सावर्णिकेश्वरं नाम त्रेतायां तस्य संज्ञितम् ।\nततस्तु द्वापरे देवि गालवेन महात्मना ।\nसम्यगाराधितस्तत्र लिंगरूपीवृषध्वजः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004891008, "chapter_id": 24891, "verse_number": "७-१-७४-९", "content_sanskrit": "तृतीयं तस्य देवस्य गालवेश्वरसंज्ञितम् ।\nकलौ युगे तु संप्राप्ते शाकल्योनाम वै मुनिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004891009, "chapter_id": 24891, "verse_number": "७-१-७४-१०", "content_sanskrit": "यत्र सिद्धिमनुप्राप्त ऐश्वर्यं चाणिमादिकम् ।\nशाकल्येश्वरनामेति ततः ख्यातं तुरीयकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004891010, "chapter_id": 24891, "verse_number": "७-१-७४-११", "content_sanskrit": "एवं चातुर्युगं नाम तस्य लिंगस्य कीर्तितम् ।\nपापघ्नं पुण्यदं नॄणां कीर्त्तितं सर्वकामदम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004891011, "chapter_id": 24891, "verse_number": "७-१-७४-१२", "content_sanskrit": "तस्यैव देवदेवस्य क्षेत्रोत्पत्तिं शृणु प्रिये ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004891012, "chapter_id": 24891, "verse_number": "७-१-७४-१३", "content_sanskrit": "अष्टादशधनुर्देवि समंतात्परिमण्डलम् ।\nमहापापहरं देवि तत्र क्षेत्रनिवासिनाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004891013, "chapter_id": 24891, "verse_number": "७-१-७४-१४", "content_sanskrit": "कृमिकीटपतंगानां तिरश्चामपि मोक्षदम् ।\nयत्र कूपादितोयेषु जलं सारस्वतं स्मृतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004891014, "chapter_id": 24891, "verse_number": "७-१-७४-१५", "content_sanskrit": "यत्र तत्र नरः स्नात्वा स्वर्गलोके महीयते ।\nअश्वमेधसहस्रस्य वाजपेयशतस्य च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004891015, "chapter_id": 24891, "verse_number": "७-१-७४-१६", "content_sanskrit": "तत्फलं समवाप्नोति तस्य लिंगस्य दर्शनात् ।\nसोमपर्वणि संप्राप्ते यस्तत्र शुचिरात्मवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004891016, "chapter_id": 24891, "verse_number": "७-१-७४-१७", "content_sanskrit": "अघोरं च जपेत्सम्यगाज्यहोमसमन्वितम् ।\nतल्लिंगस्य समीपस्थो यावन्मासावधिः प्रिये ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004891017, "chapter_id": 24891, "verse_number": "७-१-७४-१८", "content_sanskrit": "महापातकयुक्तोऽपि युक्तो वाऽप्युपपातकैः ।\nस सर्वां लभते सिद्धिमुत्तमां वरवर्णिनि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004891018, "chapter_id": 24891, "verse_number": "७-१-७४-१९", "content_sanskrit": "कामिकं तत्स्मृतं लिंगं सर्वकामफलप्रदम् ।\nअघोर वक्त्रं देवस्य तत्रस्थं भैरवं महत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004891019, "chapter_id": 24891, "verse_number": "७-१-७४-२०", "content_sanskrit": "भैरवेश्वरनामेति पूर्वं ख्यातमभूद्भुवि ।\nअस्मिन्युगे तु संप्राप्ते शाकल्येश्वरनामकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]