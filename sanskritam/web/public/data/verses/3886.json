[{"id": 2133750, "chapter_id": 3886, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133751, "chapter_id": 3886, "verse_number": "१", "content_sanskrit": "मार्कण्डेयमृषयो ब्राह्मणा युधिष्ठिरश्च ।\nपर्यपृच्छन्नृषिः केन दीर्घायुरासीद् बकः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133752, "chapter_id": 3886, "verse_number": "२", "content_sanskrit": "मार्कण्डेयस्तु तान् सर्वान् प्रत्युवाच महातपाः ।\nदीर्घायुश्च बको राजन्नृषिर्नात्र विचारणा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133753, "chapter_id": 3886, "verse_number": "३", "content_sanskrit": "एतच्छ्रुत्वा तु कौन्तेयो भ्रातृभिः सह भारत ।\nमार्कण्डेयं पर्यपृच्छद्धर्मराजो युधिष्ठिरः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133754, "chapter_id": 3886, "verse_number": "४", "content_sanskrit": "श्रूयते हि महाभाग बकोट्टाल्पो महायशाः ।\nप्रियः सखा च शक्रस्य चिरञ्जीवी च सत्तम \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133755, "chapter_id": 3886, "verse_number": "५", "content_sanskrit": "एतदिच्छामि भगवन् बकशक्रसमागमम् ।\nसुखदुःखसमायुक्तं तत्वेन कथितं त्वया \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133756, "chapter_id": 3886, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133757, "chapter_id": 3886, "verse_number": "६", "content_sanskrit": "वृत्ते देवासुरे राजन् सङ्ग्रामे रोमहर्षणे ।\nत्रयाणामपि लोकानामिन्द्रो लोकाधिपोऽभवत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133758, "chapter_id": 3886, "verse_number": "७", "content_sanskrit": "सम्यग्वर्षति पर्जन्ये सस्यसम्पद उत्तमाः ।\nनिरामयाः सुधर्मिष्ठाः प्रजा धर्मपरायणाः ।\nमुदितश्च जनः सर्वः स्वधर्मेषु व्यवस्थितः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133759, "chapter_id": 3886, "verse_number": "८", "content_sanskrit": "ताः प्रजा मुदिताः सर्वा दृष्ट्वा बलनिषूदनः ।\nततस्तु मुदितो राजन् देवराजः शतक्रतुः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133760, "chapter_id": 3886, "verse_number": "९", "content_sanskrit": "ऐरावतं समास्थाय अपश्यन् मुदिताः प्रजाः ।\nआश्रमांश्च विचित्रांश्च नदीश्च विविधाः शुभाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133761, "chapter_id": 3886, "verse_number": "१०", "content_sanskrit": "नगराणि समृद्धानि घेटाञ्जनपदांस्तथा ।\nप्रजापालनदक्षांश्च नरेन्द्रान् धर्मचारिणः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133762, "chapter_id": 3886, "verse_number": "११", "content_sanskrit": "उदपानं प्रपा वापी तटाकानि सरांसि च ।\nनानाब्रह्मसमाचारैः सेवितानि द्विजोत्तमैः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133763, "chapter_id": 3886, "verse_number": "१२", "content_sanskrit": "ततोऽवतीर्य रम्यायां पृथ्व्यां राजन् शतक्रतुः ।\nतत्र रम्ये शिवे देशे बहुवृक्षसमाकुले \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133764, "chapter_id": 3886, "verse_number": "१३", "content_sanskrit": "पूर्वस्यां दिशि रम्यायां समुद्राभ्याशतो नृप ।\nतत्राश्रमपदं रम्यं मृगद्विजनिषेवितम् ।\nतत्राश्रमपदे रम्ये बकं पश्यति देवराट् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133765, "chapter_id": 3886, "verse_number": "१४", "content_sanskrit": "बकस्तु दृष्ट्वा देवेन्द्रं दृढं प्रीतमनाऽभवत् ।\nपाद्यासनार्थदानेन फलमूलैरथार्चयत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133766, "chapter_id": 3886, "verse_number": "१५", "content_sanskrit": "सुखोपविष्टो वरदस्ततस्तु बलसूदनः ।\nततः प्रश्नं बकं देव उवाच त्रिदशेश्वरः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133767, "chapter_id": 3886, "verse_number": "१६", "content_sanskrit": "शतं वर्षसहस्राणि मुने जातस्य तेऽनघ ।\nसमाख्याहि मम ब्रह्मन् किं दुःखं चिरजीविनाम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133768, "chapter_id": 3886, "verse_number": "", "content_sanskrit": "बकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133769, "chapter_id": 3886, "verse_number": "१७", "content_sanskrit": "अप्रियैः सह संवासः प्रियैश्चापि विनाभवः ।\nअसद्भिः सम्प्रयोगश्च तद्दुःखं चिरजीविनाम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133770, "chapter_id": 3886, "verse_number": "१८", "content_sanskrit": "पुत्रदारविनाशोऽत्र ज्ञातीनां सुहृदामपि ।\nपरेष्वायत्तता कृच्छ्रं किन्नु दुःखतरं ततः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133771, "chapter_id": 3886, "verse_number": "१९", "content_sanskrit": "नान्यद् दुःखतरं किञ्चिल्लोकेषु प्रतिभाति मे ।\nअर्थैर्विहीनः पुरुषः परैः सम्परिभूयते \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133772, "chapter_id": 3886, "verse_number": "२०", "content_sanskrit": "अकुलानां कुले भावं कुलीनानां कुलक्षयम् ।\nसंयोगं विप्रयोगं च पश्यन्ति चिरजीविनः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133773, "chapter_id": 3886, "verse_number": "२१", "content_sanskrit": "अपि प्रत्यक्षमेवैतत् तव देव शतक्रतो ।\nअकुलानां समृद्धानां कथं कुलविपर्ययः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133774, "chapter_id": 3886, "verse_number": "२२", "content_sanskrit": "देवदानवगन्धर्वमनुष्योरगराक्षसाः ।\nप्राप्नुवन्ति विपर्यासं किन्नु दुःखतरं ततः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133775, "chapter_id": 3886, "verse_number": "२३", "content_sanskrit": "कुले जाताश्च क्लिश्यन्ते दौष्कुलेयवशानुगाः ।\nआढ्यैर्दरिद्राऽवमताः किन्नु दुःखतरं ततः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133776, "chapter_id": 3886, "verse_number": "२४", "content_sanskrit": "लोके वैधर्म्यमेतत् तु दृश्यते बहुविस्तरम् ।\nहीनज्ञानाश्च हृष्यन्ते क्लिश्यन्ते प्राज्ञकोविदाः ।\nबहुदुःखपरिक्लेशं मानुष्यमिह दृश्यते \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133777, "chapter_id": 3886, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133778, "chapter_id": 3886, "verse_number": "२५", "content_sanskrit": "पुनरेव महाभाग देवर्षिगणसेवित ।\nसमाख्याहि मम ब्रह्मन् किं सुखं चिरजीविनाम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133779, "chapter_id": 3886, "verse_number": "", "content_sanskrit": "बकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133780, "chapter_id": 3886, "verse_number": "२६", "content_sanskrit": "अष्टमे द्वादशे वाऽपि शाकं यः पचते गृहे ।\nकुमित्राण्यनपाश्रित्य किं वै सुखतरं ततः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133781, "chapter_id": 3886, "verse_number": "२७", "content_sanskrit": "यत्राहानि न गण्यन्ते नैनमाहुर्महाशनम् ।\nअपि शाकं पचानस्य सुखं वै मघवन् गृहे \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133782, "chapter_id": 3886, "verse_number": "२८", "content_sanskrit": "आर्जितं स्वेन वीर्येण नाप्यपाश्रित्य कञ्चन ।\nफलशाकमपि श्रेयो भोक्तुं ह्यकृपणं गृहे \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2133783, "chapter_id": 3886, "verse_number": "२९", "content_sanskrit": "परस्य तु गृहे भोक्तुः परिभूतस्य नित्यशः ।\nसुमृष्टमपि न श्रेयो विकल्पोऽयमतः सताम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2133784, "chapter_id": 3886, "verse_number": "३०", "content_sanskrit": "श्ववद्धि लोलुपो यस्तु परान्नं भोक्तुमिच्छति ।\nधिगस्तु तस्य तद्भुक्तं कृपणस्य दुरात्मनः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2133785, "chapter_id": 3886, "verse_number": "३१", "content_sanskrit": "यो दत्त्वाऽतिथिभृत्येभ्यः पितृभ्यश्च द्विजोत्तमः ।\nविशिष्टान्नानि यो भुङ्क्ते किं वै सुखतरं ततः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2133786, "chapter_id": 3886, "verse_number": "३२", "content_sanskrit": "अतो मृष्टतरं नान्यत् पूतं किञ्चिच्छतक्रतो ।\nदत्त्वा यस्त्वतिथिभ्योऽन्नं भुङ्क्ते तेनैव नित्यशः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2133787, "chapter_id": 3886, "verse_number": "३३", "content_sanskrit": "यावतो ह्यन्धसः पिण्डानश्नाति सततं द्विजः ।\nतावतां गोसहस्राणां फलं प्राप्नोति दायकः ।\nयदेनो यौवनकृतं तत्सर्वं नश्यते ध्रुवम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2133788, "chapter_id": 3886, "verse_number": "३४", "content_sanskrit": "सदक्षिणस्य भुक्तस्य द्विजस्य तु करे गतम् ।\nयद्वारि वारिणा सिञ्चेत् तद्ध्येनस्तरते क्षणात् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2133789, "chapter_id": 3886, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2133790, "chapter_id": 3886, "verse_number": "३५", "content_sanskrit": "एताश्चान्याश्च वै बह्वीः कथयित्वा कथाः शुभाः ।\nबकेन सह देवेन्द्र आपृच्छ्य त्रिदिवं गतः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2133791, "chapter_id": 3886, "verse_number": "२०७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसाहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्ताधिकद्विशततमोऽध्यायः ॥२०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2133792, "chapter_id": 3886, "verse_number": "", "content_sanskrit": "॥ मार्कण्डेयसमास्यापर्वणि द्वात्रिंशोऽध्यायः ॥३२॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2133793, "chapter_id": 3886, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां वनपर्वणि द्वितीयो भागः ॥\n॥ श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]