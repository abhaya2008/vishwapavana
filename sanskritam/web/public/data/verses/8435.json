[{"id": 900005587, "chapter_id": 8435, "verse_number": "16.1", "content_sanskrit": "समन्वये प्रतिज्ञाते शब्दगोचरतैव हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900005588, "chapter_id": 8435, "verse_number": "16.2", "content_sanskrit": "कथं च लक्षणावादी ब्रूयाद्ब्रह्मसमन्वयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900005589, "chapter_id": 8435, "verse_number": "16.3", "content_sanskrit": "योऽसौ शब्दस्य मुख्यार्थस्तत्रैव स्यात्समन्वयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900005590, "chapter_id": 8435, "verse_number": "16.4", "content_sanskrit": "उक्तं तदेव जिज्ञास्यं क्वावकाशोऽत्र निर्गुणे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900005591, "chapter_id": 8435, "verse_number": "16.5", "content_sanskrit": "कथं चासंभवस्तय मुख्यार्थस्य निराकृतौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900005592, "chapter_id": 8435, "verse_number": "16.6", "content_sanskrit": "मानेन केन विज्ञेयमवाच्याज्ञेयनिर्गुणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900005593, "chapter_id": 8435, "verse_number": "16.7", "content_sanskrit": "अमेयं चेन्न शास्त्रस्य तत्र वृत्तिः कथञ्चन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900005594, "chapter_id": 8435, "verse_number": "16.8", "content_sanskrit": "तस्माच्छास्त्रेण जिज्ञास्यमस्मदीयं गुणार्णवम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900005595, "chapter_id": 8435, "verse_number": "16.9", "content_sanskrit": "विज्ञेयवाच्यलक्ष्यत्वपूर्वाशेषविशेषतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900005596, "chapter_id": 8435, "verse_number": "16.10", "content_sanskrit": "यदि तत्स्यादगोचरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900005597, "chapter_id": 8435, "verse_number": "16.11", "content_sanskrit": "अवाच्यं वाच्यमित्युक्त्वा किमित्युन्मत्तवन्मृषा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900005598, "chapter_id": 8435, "verse_number": "16.12", "content_sanskrit": "जन्मादिकारणं यत्तत्साक्षान्नारायणाभिधम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900005599, "chapter_id": 8435, "verse_number": "16.13", "content_sanskrit": "सर्वशब्दैरवाच्यं तदुक्त्वा तद्विषयं पुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900005600, "chapter_id": 8435, "verse_number": "16.14", "content_sanskrit": "मा वदो मा विजानीहि त्यजास्मच्छास्त्रचोरताम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900005601, "chapter_id": 8435, "verse_number": "16.15", "content_sanskrit": "वयं त्वां श्रुतियुक्तिभ्यां बद्ध्वाऽस्मच्छास्त्रमञ्जसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900005602, "chapter_id": 8435, "verse_number": "16.16", "content_sanskrit": "अद्भुतत्वादवाच्यं तदतर्क्याज्ञेयमेव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900005603, "chapter_id": 8435, "verse_number": "16.17", "content_sanskrit": "अवाच्यमिति लोकोऽपि वक्त्याश्चर्यतमं भुवि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900005604, "chapter_id": 8435, "verse_number": "16.18", "content_sanskrit": "अवाच्यमिति लोकोऽपि वक्त्याश्चर्यतमं भुवि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900005605, "chapter_id": 8435, "verse_number": "16.19", "content_sanskrit": "अवाच्यमिति लोकोऽपि वक्त्याश्चर्यतमं भुवि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]