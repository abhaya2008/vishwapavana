[{"id": 5000339000, "chapter_id": 9339, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे सप्तषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000339001, "chapter_id": 9339, "verse_number": "४-६७-१", "content_sanskrit": "तं दृष्ट्वा जृम्भमाणं ते क्रमितुं शतयोजनम्।\nवेगेनापूर्यमाणं च सहसा वानरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000339002, "chapter_id": 9339, "verse_number": "४-६७-२", "content_sanskrit": "सहसा शोकमुत्सृज्य प्रहर्षेण समन्विताः।\nविनेदुस्तुष्टुवुश्चापि हनूमन्तं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000339003, "chapter_id": 9339, "verse_number": "४-६७-३", "content_sanskrit": "प्रहृष्टा विस्मिताश्चापि ते वीक्षन्ते समन्ततः।\nत्रिविक्रमं कृतोत्साहं नारायणमिव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000339004, "chapter_id": 9339, "verse_number": "४-६७-४", "content_sanskrit": "संस्तूयमानो हनुमान् व्यवर्धत महाबलः।\nसमाविद्ध्य च लाङ्गूलं हर्षाद् बलमुपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000339005, "chapter_id": 9339, "verse_number": "४-६७-५", "content_sanskrit": "तस्य संस्तूयमानस्य वृद्धैर्वानरपुङ्गवैः।\nतेजसाऽऽपूर्यमाणस्य रूपमासीदनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000339006, "chapter_id": 9339, "verse_number": "४-६७-६", "content_sanskrit": "यथा विजृम्भते सिंहो विवृते गिरिगह्वरे।\nमारुतस्यौरसः पुत्रस्तथा सम्प्रति जृम्भते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000339007, "chapter_id": 9339, "verse_number": "४-६७-७", "content_sanskrit": "अशोभत मुखं तस्य जृम्भमाणस्य धीमतः।\nअम्बरीषोपमं दीप्तं विधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000339008, "chapter_id": 9339, "verse_number": "४-६७-८", "content_sanskrit": "हरीणामुत्थितो मध्यात् सम्प्रहृष्टतनूरुहः।\nअभिवाद्य हरीन् वृद्धान् हनूमानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000339009, "chapter_id": 9339, "verse_number": "४-६७-९", "content_sanskrit": "आरुजन् पर्वताग्राणि हुताशनसखोऽनिलः।\nबलवानप्रमेयश्च वायुराकाशगोचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000339010, "chapter_id": 9339, "verse_number": "४-६७-१०", "content_sanskrit": "तस्याहं शीघ्रवेगस्य शीघ्रगस्य महात्मनः।\nमारुतस्यौरसः पुत्रः प्लवनेनास्मि तत्समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000339011, "chapter_id": 9339, "verse_number": "४-६७-११", "content_sanskrit": "उत्सहेयं हि विस्तीर्णमालिखन्तमिवाम्बरम्।\nमेरुं गिरिमसङ्गेन परिगन्तुं सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000339012, "chapter_id": 9339, "verse_number": "४-६७-१२", "content_sanskrit": "बाहुवेगप्रणुन्नेन सागरेणाहमुत्सहे।\nसमाप्लावयितुं लोकं सपर्वतनदीह्रदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000339013, "chapter_id": 9339, "verse_number": "४-६७-१३", "content_sanskrit": "ममोरुजङ्घावेगेन भविष्यति समुत्थितः।\nसमुत्थितमहाग्राहः समुद्रो वरुणालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000339014, "chapter_id": 9339, "verse_number": "४-६७-१४", "content_sanskrit": "पन्नगाशनमाकाशे पतन्तं पक्षिसेवितम्।\nवैनतेयमहं शक्तः परिगन्तुं सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000339015, "chapter_id": 9339, "verse_number": "४-६७-१५", "content_sanskrit": "उदयात् प्रस्थितं वापि ज्वलन्तं रश्मिमालिनम्।\nअनस्तमितमादित्यमहं गन्तुं समुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000339016, "chapter_id": 9339, "verse_number": "४-६७-१६", "content_sanskrit": "ततो भूमिमसंस्पृष्ट्वा पुनरागन्तुमुत्सहे।\nप्रवेगेनैव महता भीमेन प्लवगर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000339017, "chapter_id": 9339, "verse_number": "४-६७-१७", "content_sanskrit": "उत्सहेयमतिक्रान्तुं सर्वानाकाशगोचरान्।\nसागरान् शोषयिष्यामि दारयिष्यामि मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000339018, "chapter_id": 9339, "verse_number": "४-६७-१८", "content_sanskrit": "पर्वतांश्चूर्णयिष्यामि प्लवमानः प्लवङ्गमः।\nहरिष्याम्युरुवेगेन प्लवमानो महार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000339019, "chapter_id": 9339, "verse_number": "४-६७-१९", "content_sanskrit": "लतानां विविधं पुष्पं पादपानां च सर्वशः।\nअनुयास्यति मामद्य प्लवमानं विहायसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000339020, "chapter_id": 9339, "verse_number": "४-६७-२०", "content_sanskrit": "भविष्यति हि मे पन्थाः स्वातेः पन्था इवाम्बरे।\nचरन्तं घोरमाकाशमुत्पतिष्यन्तमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000339021, "chapter_id": 9339, "verse_number": "४-६७-२१", "content_sanskrit": "द्रक्ष्यन्ति निपतन्तं च सर्वभूतानि वानराः।\nमहामेरुप्रतीकाशं मां द्रक्ष्यध्वं प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000339022, "chapter_id": 9339, "verse_number": "४-६७-२२", "content_sanskrit": "दिवमावृत्य गच्छन्तं ग्रसमानमिवाम्बरम्।\nविधमिष्यामि जीमूतान् कम्पयिष्यामि पर्वतान्।\nसागरं शोषयिष्यामि प्लवमानः समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000339023, "chapter_id": 9339, "verse_number": "४-६७-२३", "content_sanskrit": "वैनतेयस्य वा शक्तिर्मम वा मारुतस्य वा।\nऋते सुपर्णराजानं मारुतं वा महाबलम्।\nन तद् भूतं प्रपश्यामि यन्मां प्लुतमनुव्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000339024, "chapter_id": 9339, "verse_number": "४-६७-२४", "content_sanskrit": "निमेषान्तरमात्रेण निरालम्बनमम्बरम्।\nसहसा निपतिष्यामि घनाद् विद्युदिवोत्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000339025, "chapter_id": 9339, "verse_number": "४-६७-२५", "content_sanskrit": "भविष्यति हि मे रूपं प्लवमानस्य सागरम्।\nविष्णोः प्रक्रममाणस्य तदा त्रीन् विक्रमानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000339026, "chapter_id": 9339, "verse_number": "४-६७-२६", "content_sanskrit": "बुद्‍ध्या चाहं प्रपश्यामि मनश्चेष्टा च मे तथा।\nअहं द्रक्ष्यामि वैदेहीं प्रमोदध्वं प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000339027, "chapter_id": 9339, "verse_number": "४-६७-२७", "content_sanskrit": "मारुतस्य समो वेगे गरुडस्य समो जवे।\nअयुतं योजनानां तु गमिष्यामीति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000339028, "chapter_id": 9339, "verse_number": "४-६७-२८", "content_sanskrit": "वासवस्य सवज्रस्य ब्रह्मणो वा स्वयम्भुवः।\nविक्रम्य सहसा हस्तादमृतं तदिहानये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000339029, "chapter_id": 9339, "verse_number": "४-६७-२९", "content_sanskrit": "लङ्कां वापि समुत्क्षिप्य गच्छेयमिति मे मतिः।\nतमेवं वानरश्रेष्ठं गर्जन्तममितप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000339030, "chapter_id": 9339, "verse_number": "४-६७-३०", "content_sanskrit": "प्रहृष्टा हरयस्तत्र समुदैक्षन्त विस्मिताः।\nतच्चास्य वचनं श्रुत्वा ज्ञातीनां शोकनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000339031, "chapter_id": 9339, "verse_number": "४-६७-३१", "content_sanskrit": "उवाच परिसंहृष्टो जाम्बवान् प्लवगेश्वरः।\nवीर केसरिणः पुत्र वेगवन् मारुतात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000339032, "chapter_id": 9339, "verse_number": "४-६७-३२", "content_sanskrit": "ज्ञातीनां विपुलः शोकस्त्वया तात प्रणाशितः।\nतव कल्याणरुचयः कपिमुख्याः समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000339033, "chapter_id": 9339, "verse_number": "४-६७-३३", "content_sanskrit": "मङ्गलान्यर्थसिद्ध्यर्थं करिष्यन्ति समाहिताः।\nऋषीणां च प्रसादेन कपिवृद्धमतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000339034, "chapter_id": 9339, "verse_number": "४-६७-३४", "content_sanskrit": "गुरूणां च प्रसादेन सम्प्लव त्वं महार्णवम्।\nस्थास्यामश्चैकपादेन यावदागमनं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000339035, "chapter_id": 9339, "verse_number": "४-६७-३५", "content_sanskrit": "त्वद‍्गतानि च सर्वेषां जीवनानि वनौकसाम्।\nततश्च हरिशार्दूलस्तानुवाच वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000339036, "chapter_id": 9339, "verse_number": "४-६७-३६", "content_sanskrit": "कोऽपि लोके न मे वेगं प्लवने धारयिष्यति।\nएतानीह नगस्यास्य शिलासंकटशालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000339037, "chapter_id": 9339, "verse_number": "४-६७-३७", "content_sanskrit": "शिखराणि महेन्द्रस्य स्थिराणि च महान्ति च।\nयेषु वेगं गमिष्यामि महेन्द्रशिखरेष्वहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000339038, "chapter_id": 9339, "verse_number": "४-६७-३८", "content_sanskrit": "नानाद्रुमविकीर्णेषु धातुनिष्पन्दशोभिषु।\nएतानि मम वेगं हि शिखराणि महान्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000339039, "chapter_id": 9339, "verse_number": "४-६७-३९", "content_sanskrit": "प्लवतो धारयिष्यन्ति योजनानामितः शतम्।\nततस्तु मारुतप्रख्यः स हरिर्मारुतात्मजः।\nआरुरोह नगश्रेष्ठं महेन्द्रमरिमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000339040, "chapter_id": 9339, "verse_number": "४-६७-४०", "content_sanskrit": "वृतं नानाविधैः पुष्पैर्मृगसेवितशाद्वलम्।\nलताकुसुमसम्बाधं नित्यपुष्पफलद्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000339041, "chapter_id": 9339, "verse_number": "४-६७-४१", "content_sanskrit": "सिंहशार्दूलसहितं मत्तमातङ्गसेवितम्।\nमत्तद्विजगणोद‍्घुष्टं सलिलोत्पीडसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000339042, "chapter_id": 9339, "verse_number": "४-६७-४२", "content_sanskrit": "महद्भिरुच्छ्रितं शृङ्गैर्महेन्द्रं स महाबलः।\nविचचार हरिश्रेष्ठो महेन्द्रसमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000339043, "chapter_id": 9339, "verse_number": "४-६७-४३", "content_sanskrit": "पादाभ्यां पीडितस्तेन महाशैलो महात्मना।\nररास सिंहाभिहतो महान् मत्त इव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000339044, "chapter_id": 9339, "verse_number": "४-६७-४४", "content_sanskrit": "मुमोच सलिलोत्पीडान् विप्रकीर्णशिलोच्चयः।\nवित्रस्तमृगमातङ्गः प्रकम्पितमहाद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000339045, "chapter_id": 9339, "verse_number": "४-६७-४५", "content_sanskrit": "नानागन्धर्वमिथुनैः पानसंसर्गकर्कशैः।\nउत्पतद्भिर्विहंगैश्च विद्याधरगणैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000339046, "chapter_id": 9339, "verse_number": "४-६७-४६", "content_sanskrit": "त्यज्यमानमहासानुः संनिलीनमहोरगः।\nशैलशृङ्गशिलोत्पातस्तदाभूत् स महागिरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000339047, "chapter_id": 9339, "verse_number": "४-६७-४७", "content_sanskrit": "निःश्वसद्भिस्तदा तैस्तु भुजगैरर्धनिःसृतैः।\nसपताक इवाभाति स तदा धरणीधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000339048, "chapter_id": 9339, "verse_number": "४-६७-४८", "content_sanskrit": "ऋषिभिस्त्राससम्भ्रान्तैस्त्यज्यमानः शिलोच्चयः।\nसीदन् महति कान्तारे सार्थहीन इवाध्वगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000339049, "chapter_id": 9339, "verse_number": "४-६७-४९", "content_sanskrit": "स वेगवान् वेगसमाहितात्मा\nहरिप्रवीरः परवीरहन्ता।\nमनः समाधाय महानुभावो\nजगाम लङ्कां मनसा मनस्वी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000339050, "chapter_id": 9339, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे सप्तषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]