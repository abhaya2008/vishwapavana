[{"id": 40020633, "chapter_id": 9339, "verse_number": "1", "content_sanskrit": "ततो वित्रासयन्मर्त्यान्पृथिव्यां राक्षसाधिपः । आससाद घने तस्मिन्नारदं मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020634, "chapter_id": 9339, "verse_number": "2", "content_sanskrit": "तस्याभिवादनं कृत्वा दशग्रीवो निशाचरः । अब्रवीत्कुशलं पृष्ट्वा हेतुमागमनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020635, "chapter_id": 9339, "verse_number": "3", "content_sanskrit": "नारदस्तु महातेजा देवर्षिरमितप्रभः । अब्रवीन्मेघपृष्ठस्थो रावणं पुष्पके स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020636, "chapter_id": 9339, "verse_number": "4", "content_sanskrit": "राक्षसाधिपते सौम्य तिष्ठ विश्रवसः सुत । प्रीतो ऽस्म्यभिजनोपेतविक्रमैरूर्जितैस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020637, "chapter_id": 9339, "verse_number": "5", "content_sanskrit": "विष्णुना दैत्यघातैश्च गन्धर्वोरगधर्षणैः । त्वया समं विमर्दैश्च भृशं हि परितोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020638, "chapter_id": 9339, "verse_number": "6", "content_sanskrit": "किंचिद्वक्ष्यामि तावत्ते श्रोतव्यं श्रोष्यसे यदि । श्रुत्वा चानन्तरं कार्यं त्वया राक्षससत्तम । तन्मे निगदतस्तात समाधिं श्रवणे कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020639, "chapter_id": 9339, "verse_number": "7", "content_sanskrit": "किमयं वध्यते तात त्वया ऽवध्येन दैवतैः । हत एव ह्ययं लोको यदा मृत्युवशं गतः ॥ ्तम ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020640, "chapter_id": 9339, "verse_number": "8", "content_sanskrit": "देवदानवदैत्यानां यक्षगन्धर्वरक्षसाम् । अवध्येन त्वया लोकः क्लेष्टुं युक्तो न मानुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020641, "chapter_id": 9339, "verse_number": "9", "content_sanskrit": "नित्यं श्रेयसि सम्मूढं महद्भिर्व्यसनैर्वृतम् । हन्यात्कस्तादृशं लोकं जराव्याधिशतैर्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020642, "chapter_id": 9339, "verse_number": "10", "content_sanskrit": "तैस्तैरनिष्टोपगमैरजस्रं यत्र कुत्र कः । मतिमान्मानुषे लोके युद्धेन प्रणयी भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020643, "chapter_id": 9339, "verse_number": "11", "content_sanskrit": "क्षीयमाणं दैवहतं श्रुत्पिपासाजरादिभिः । विषादशोकसम्मूढं लोकं त्वं क्षपयस्व मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020644, "chapter_id": 9339, "verse_number": "12", "content_sanskrit": "पश्य तावन्महाबाहो राक्षसेश्वर मानुषम् । मूढमेवं विचित्रार्थं यस्य न ज्ञायते गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020645, "chapter_id": 9339, "verse_number": "13", "content_sanskrit": "क्वचिद्वादित्रनृत्यादि सेव्यते मुदितैर्जनैः । रुद्यते चापरैरार्तैर्धाराश्रुनयनाननैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020646, "chapter_id": 9339, "verse_number": "14", "content_sanskrit": "मातापितृसुतस्नेहैर्भार्याबन्धुमनोरमैः । मोहितो ऽयं जनो ध्वस्तः क्लेशं स्वं नावबुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020647, "chapter_id": 9339, "verse_number": "15", "content_sanskrit": "अलमेनं परिक्लिश्य लोकं मोहनिराकृतम् । जित एव त्वया सौम्य मर्त्यलोको न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020648, "chapter_id": 9339, "verse_number": "16", "content_sanskrit": "अवश्यमेभिः सर्वैश्च गन्तव्यं यमसादनम् । तन्निगृह्णीष्व पौलस्त्य यमं परपुरञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020649, "chapter_id": 9339, "verse_number": "17", "content_sanskrit": "तस्मिञ्जिते जितं सर्वं भवत्येव न संशयः । एवमुक्तस्तु लङ्केशो दीप्यमानं स्वतेजसा । अब्रवीन्नारदं तत्र सम्प्रहस्याभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020650, "chapter_id": 9339, "verse_number": "18", "content_sanskrit": "महर्षे देवगन्धर्वविहार समरप्रिय । अहं समुद्यतो गन्तुं विजयार्थं रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020651, "chapter_id": 9339, "verse_number": "19", "content_sanskrit": "ततो लोकत्रयं जित्वा स्थाप्य नागान्सुरान्वशे । समुद्रममृतार्थं च मथिष्यामि रसालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020652, "chapter_id": 9339, "verse_number": "20", "content_sanskrit": "अथाब्रवीदृशग्रीवं नारदो भगवानृषिः । क्व खल्विदानीं मार्गेण त्वया ह्यन्येन गम्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020653, "chapter_id": 9339, "verse_number": "21", "content_sanskrit": "अयं खलु सुदुर्गम्यः प्रेतराजपुरं प्रति । मार्गो गच्छति दुर्धर्षो यमस्यामित्रकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020654, "chapter_id": 9339, "verse_number": "22", "content_sanskrit": "स तु शारदमेघाभं हासं मुक्त्वा दशाननः । उवाच कृतमित्येव वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020655, "chapter_id": 9339, "verse_number": "23", "content_sanskrit": "तस्मादेवमहं ब्रह्मन् वैवस्वतवधोद्यतः । गच्छामि दक्षिणामाशां यत्र सूर्यात्मजो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020656, "chapter_id": 9339, "verse_number": "24", "content_sanskrit": "मया हि भगवन्क्रोधात्प्रतिज्ञातं रणार्थिना । अवजेष्यामि चतुरो लोकपालानिति प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020657, "chapter_id": 9339, "verse_number": "25", "content_sanskrit": "तदिह प्रस्थितो ऽहं वै प्रेतराजपुरं प्रति । प्राणिसङ्क्लेशकर्तारं योजयिष्यामि मृत्युना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020658, "chapter_id": 9339, "verse_number": "26", "content_sanskrit": "एवमुक्त्वा दशग्रीवो मुनिं तमभिवाद्य च । प्रययौ दक्षिणामाशां प्रविष्टः सह मन्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020659, "chapter_id": 9339, "verse_number": "27", "content_sanskrit": "नारदस्तु महातेजा मुहूर्तं ध्यानमास्थितः । चिन्तयामास विप्रेन्द्रो विधूम इव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020660, "chapter_id": 9339, "verse_number": "28", "content_sanskrit": "येन लोकास्त्रयः सेन्द्राः क्लिश्यन्ते सचराचराः । क्षीणे चायुषि धर्मेण स कालो जेष्यते कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020661, "chapter_id": 9339, "verse_number": "29", "content_sanskrit": "स्वदत्तकृतसाक्षी यो द्वितीय इव पावकः । लब्धसञ्ज्ञा विजेष्यन्ते लोका यस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020662, "chapter_id": 9339, "verse_number": "30", "content_sanskrit": "यस्य नित्यं त्रयो लोका विद्रवन्ति भयार्दिताः । तं कथं राक्षसेन्द्रो ऽसौ स्वयमेव गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020663, "chapter_id": 9339, "verse_number": "31", "content_sanskrit": "यो विधाता च धाता च सुकृतं दुष्कृतं तथा । त्रैलोक्यं विजितं येन तं कथं विजयिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020664, "chapter_id": 9339, "verse_number": "32", "content_sanskrit": "अपरं किन्तु कृत्वायं विधानं संविधास्यति । कौतूहलसमुत्पन्नो यास्यामि यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020665, "chapter_id": 9339, "verse_number": "33", "content_sanskrit": "विमर्दं द्रष्टुमनयोर्यमराक्षसयोः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]