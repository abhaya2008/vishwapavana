[{"id": 2090629, "chapter_id": 2927, "verse_number": "१३-५७-१", "content_sanskrit": "`मार्कण्डेय उवाच।\nश्रुता भार्याश्च पुत्राश्च विस्तरेण महामुने।\nआश्रमस्थाः कथं नार्यो न दुष्यन्तीति ब्रूहि भो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090630, "chapter_id": 2927, "verse_number": "१३-५७-२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090631, "chapter_id": 2927, "verse_number": "१३-५७-२", "content_sanskrit": "आश्रमस्थासु नारीषु बान्धवत्वं प्रणश्यति।\nनष्टवंश्या भवन्त्येता बन्धूनामथ भर्तृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090632, "chapter_id": 2927, "verse_number": "१३-५७-३", "content_sanskrit": "परदारा मुक्तदोषास्ता नार्योऽऽश्रमसंस्थिताः।\nस्वयमीशाः स्वदेहानां काम्यास्तद्गतमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090633, "chapter_id": 2927, "verse_number": "१३-५७-४", "content_sanskrit": "एवं नार्यो न दुष्यन्ति नराणां तत्प्रसूतिषु।\nधर्मपत्न्यो भवन्त्येताः सपुत्रा हव्यकव्यदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090634, "chapter_id": 2927, "verse_number": "१३-५७-५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090635, "chapter_id": 2927, "verse_number": "१३-५७-५", "content_sanskrit": "परस्य भार्या या पूर्वं मृते भर्तरि या पुनः।\nअन्यं भजति भर्तारं ससुता असुता कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090636, "chapter_id": 2927, "verse_number": "१३-५७-६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090637, "chapter_id": 2927, "verse_number": "१३-५७-६", "content_sanskrit": "असुता वा प्रसूता वा गृहस्थानां परस्त्रियः।\nपरामृष्टेति ता वर्ज्या धर्माचारेषु दूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090638, "chapter_id": 2927, "verse_number": "१३-५७-७", "content_sanskrit": "न चासां हव्यकव्यानि प्रतिगृह्णन्ति देवताः।\nयस्तासु जनयेत्पुत्रान्न तैः पुत्रमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090639, "chapter_id": 2927, "verse_number": "१३-५७-८x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090640, "chapter_id": 2927, "verse_number": "१३-५७-८", "content_sanskrit": "परक्षेत्रेषु यो बीजं चापलाद्विसृजेन्नरः।\nकथं पुत्रफलं तस्य भवेत्तदृषिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090641, "chapter_id": 2927, "verse_number": "१३-५७-९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090642, "chapter_id": 2927, "verse_number": "१३-५७-९", "content_sanskrit": "अस्वामिके परक्षेत्रे यो नरो बीजमुत्सृजेत्।\nस्वयंवृतोऽऽश्रमस्थायां तद्बीजं न विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090643, "chapter_id": 2927, "verse_number": "१३-५७-१०", "content_sanskrit": "परक्षेत्रेषु यो बीजं नरो दर्पात्समुत्सृजेत्।\nक्षेत्रिकस्यैव तद्बीजं न बीजी लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090644, "chapter_id": 2927, "verse_number": "१३-५७-११", "content_sanskrit": "नातः परमधर्म्यं चाप्ययशस्यं तथोत्तरम्।\nगर्भादीनां च बहुभिस्ताश्च त्याज्याः समेष्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090645, "chapter_id": 2927, "verse_number": "१३-५७-१२x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090646, "chapter_id": 2927, "verse_number": "१३-५७-१२", "content_sanskrit": "अथ ये परदारेषु पुत्रा जायन्ति नारद।\nकस्य ते बन्धुदायादा भवन्ति परमद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090647, "chapter_id": 2927, "verse_number": "१३-५७-१३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090648, "chapter_id": 2927, "verse_number": "१३-५७-१३", "content_sanskrit": "परदारेषु जायेते द्वौ पुत्रौ कुण्डगोलकौ।\nजीवत्यथ पतौ कुण्डो मृते भर्तरि गोलकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090649, "chapter_id": 2927, "verse_number": "१३-५७-१४", "content_sanskrit": "ते च जाताः परक्षेत्रे देहिनां प्रेत्य चेह च।\nदत्तानि हव्यकव्यानि नाशयन्त्यथ दातृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090650, "chapter_id": 2927, "verse_number": "१३-५७-१५", "content_sanskrit": "पितुहि नरकायैते गोलकस्तु विशेषतः।\nचण्डालतुल्यौ तज्जौ हि परत्रेह च नश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090651, "chapter_id": 2927, "verse_number": "१३-५७-१६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090652, "chapter_id": 2927, "verse_number": "१३-५७-१६", "content_sanskrit": "कस्य ते गर्हिताः पुत्राः पितॄणां हव्यकव्यदाः।\nयस्य क्षेत्रे प्रसूयन्ते यो वा ताञ्जनयेत्सुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090653, "chapter_id": 2927, "verse_number": "१३-५७-१७x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090654, "chapter_id": 2927, "verse_number": "१३-५७-१७", "content_sanskrit": "क्षेत्रिकश्चैव बीजी च द्वावेतौ निरयं गतौ।\nन रक्षति च यो दारान्परदाराश्च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090655, "chapter_id": 2927, "verse_number": "१३-५७-१८", "content_sanskrit": "गर्हितास्ते नरा नित्यं धर्माचारबहिष्कृताः।\nकुण्डो भोक्ता च भोगी च कुत्सिताः पितृदैवतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090656, "chapter_id": 2927, "verse_number": "१३-५७-१९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090657, "chapter_id": 2927, "verse_number": "१३-५७-१९", "content_sanskrit": "तथैते गर्हिताः पुत्रा हव्यकव्यानि नारद।\nकस्य नित्यं प्रयच्छन्ति धर्मो वा तेषु किं फलं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090658, "chapter_id": 2927, "verse_number": "१३-५७-२०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090659, "chapter_id": 2927, "verse_number": "१३-५७-२०", "content_sanskrit": "यातुधानाः पिशाचाश्च प्रतिगृह्णन्ति तैर्हुतम्।\nहव्यं कव्यं च तैर्दत्तं ये च भूता निशाचराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090660, "chapter_id": 2927, "verse_number": "१३-५७-२१x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090661, "chapter_id": 2927, "verse_number": "१३-५७-२१", "content_sanskrit": "अथ ते राक्षसाः प्रीताः किं प्रयच्छन्ति दातृणाम्।\nकिं वा धर्मफलं तेषां भवेत्तदृषिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090662, "chapter_id": 2927, "verse_number": "१३-५७-२२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090663, "chapter_id": 2927, "verse_number": "१३-५७-२२", "content_sanskrit": "न दत्तं नश्यते किञ्चित्सर्वभूतेषु दातृणाम्।\nप्रेत्य चेह च तां पुष्टिमुपाश्नन्ति प्रदायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090664, "chapter_id": 2927, "verse_number": "१३-५७-२३x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090665, "chapter_id": 2927, "verse_number": "१३-५७-२३", "content_sanskrit": "अथ गोलककुण्डाभ्यां सन्ततिर्या भविष्यति।\nतयोर्ये बान्धवाः केचित्प्रदास्यन्ति कथं नु तं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090666, "chapter_id": 2927, "verse_number": "१३-५७-२४x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090667, "chapter_id": 2927, "verse_number": "१३-५७-२४", "content_sanskrit": "साध्वीजाताः सुतास्तेषां तां वृत्तिमनुतिष्ठताम्।\nप्रीणन्ति पितृदैवत्यं हव्यकव्यसमाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2090668, "chapter_id": 2927, "verse_number": "१३-५७-२५", "content_sanskrit": "एवं गोलककुण्डाभ्यां ये च वर्णापदेशिनः।\nहव्यं कव्यं च शुद्धानां प्रतिगृह्णन्ति देवताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2090669, "chapter_id": 2927, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तपञ्चाशोऽध्यायः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]