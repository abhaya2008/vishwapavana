[{"id": 2150789, "chapter_id": 4273, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150790, "chapter_id": 4273, "verse_number": "१", "content_sanskrit": "एवमुक्त्वा ययौ व्यासो धृतराष्ट्राय धीमते ।\nधृतराष्ट्रोऽपि तच्छ्रुत्वा ध्यानमेवान्वपद्यत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150791, "chapter_id": 4273, "verse_number": "२", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा विनिःश्वस्य मुहुर्मुहुः ।\nसञ्जयं संशितात्मानमपृच्छद् भरतर्षभ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150792, "chapter_id": 4273, "verse_number": "३", "content_sanskrit": "सञ्जयेमे महीपालाः शूरा युद्धाभिनन्दिनः ।\nअन्योन्यमभिनिघ्नन्ति शस्त्रैरुच्चावचैरपि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150793, "chapter_id": 4273, "verse_number": "४", "content_sanskrit": "पार्थिवाः पृथिवीहेतोः समभित्यक्तजीविताः ।\nन च शाम्यन्ति निघ्नन्तो वर्धयन्तो यमक्षयम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150794, "chapter_id": 4273, "verse_number": "५", "content_sanskrit": "भौममैश्वर्यमिच्छन्तो न मृष्यन्ते परस्परम् ।\nमन्ये बहुगुणा भूमिस्तन्ममाचक्ष्व सञ्जय ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150795, "chapter_id": 4273, "verse_number": "६", "content_sanskrit": "बहूनि च सहस्राणि प्रयुतान्यर्बुदानि च ।\nकोट्यश्च लोकवीराणां समेताः कुरुजाङ्गले ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150796, "chapter_id": 4273, "verse_number": "७", "content_sanskrit": "देशानां च परीमाणं नगराणां च सञ्जय ।\nश्रोतुमिच्छामि तत्त्वेन यत एते समागताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150797, "chapter_id": 4273, "verse_number": "८", "content_sanskrit": "दिव्यबुद्धिप्रदीपेन युक्तस्त्वं ज्ञानचक्षुषा ।\nप्रसादात् तस्य विप्रर्षेर्व्यासस्यामिततेजसः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150798, "chapter_id": 4273, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150799, "chapter_id": 4273, "verse_number": "९", "content_sanskrit": "यथाप्रज्ञं महाप्राज्ञ भौमान् वक्ष्यामि ते गुणान् ।\nशास्त्रचक्षुरवेक्षस्व नमस्ते भरतर्षभ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150800, "chapter_id": 4273, "verse_number": "१०", "content_sanskrit": "द्विविधानीह भूतानि त्रसानि स्थावराणि च ।\nत्रसानां त्रिविधा योनिरण्डस्वेदजरायुजाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150801, "chapter_id": 4273, "verse_number": "११", "content_sanskrit": "त्रसानां खलु सर्वेषां श्रेष्ठा राजन् जरायुजाः ।\nजरायुजानां प्रवरा मानवाः पशवश्च ये ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150802, "chapter_id": 4273, "verse_number": "१२", "content_sanskrit": "नानारूपाणि बिभ्राणास्तेषां भेदाश्चतुर्दश ।\nअरण्यवासिनः सप्त सप्तैषां ग्रामवासिनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150803, "chapter_id": 4273, "verse_number": "१३", "content_sanskrit": "सिंहव्याघ्रवराहाश्च महिषा वारणास्तथा ।\nऋक्षाश्च वानराश्चैव सप्तारण्याः स्मृता नृप ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150804, "chapter_id": 4273, "verse_number": "१४", "content_sanskrit": "गौरजो मनुजो मेषो वाज्यश्वतरगर्दभाः ।\nएते ग्राम्याः समाख्याताः पशवः सप्त साधुभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150805, "chapter_id": 4273, "verse_number": "१५", "content_sanskrit": "एते वै पशवो राजन् ग्राम्यारण्याश्चतुर्दश ।\nवेदोक्ताः पृथिवीपाल येषु यज्ञाः प्रतिष्ठिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150806, "chapter_id": 4273, "verse_number": "१६", "content_sanskrit": "ग्राम्याणां पुरुषः श्रेष्ठः सिंहश्चारण्यवासिनाम् ।\nसर्वेषामेव भूतानामन्योन्येनाभिजीवनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150807, "chapter_id": 4273, "verse_number": "१७", "content_sanskrit": "उद्भिजाः स्थावराः प्रोक्तास्तेषां पञ्चैव जातयः ।\nवृक्षगुल्मलतावल्ल्यस्त्वक्सारास्तृणजातयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150808, "chapter_id": 4273, "verse_number": "१८", "content_sanskrit": "एषां विंशतिरेकोना महाभूतेषु पञ्चसु ।\nचतुर्विंशतिरुद्दिष्टा गायत्री लोकसम्मता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150809, "chapter_id": 4273, "verse_number": "१९", "content_sanskrit": "य एतां वेद गायत्रीं पुण्यां सर्वगुणान्विताम् ।\nतत्त्वेन भरतश्रेष्ठ स लोकान्न प्रणश्यति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150810, "chapter_id": 4273, "verse_number": "२०", "content_sanskrit": "भूमौ हि जायते सर्वं भूमौ सर्वं प्रणश्यति ।\nभूमिः प्रतिष्ठा भूतानां भूमिरेव परायणम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150811, "chapter_id": 4273, "verse_number": "२१", "content_sanskrit": "यस्य भूमिस्तस्य सर्वं जगत्स्थावरजङ्गमम् ।\nतत्राभिगृद्धा राजानो विनिघ्नन्तीतरेतरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150812, "chapter_id": 4273, "verse_number": "५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150813, "chapter_id": 4273, "verse_number": "", "content_sanskrit": "॥ इति जम्बूखण्डनिर्माणपर्वणि पञ्चमोऽध्यायः ॥५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]