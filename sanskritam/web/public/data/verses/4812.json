[{"id": 2179898, "chapter_id": 4812, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2179899, "chapter_id": 4812, "verse_number": "१", "content_sanskrit": "ज्ञातिशोकाभितप्तस्य प्राणानभ्युत्सिसृक्षतः ।\nज्येष्ठस्य पाण्डुपुत्रस्य व्यासः शोकमपानुदत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2179900, "chapter_id": 4812, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2179901, "chapter_id": 4812, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nअश्मगीतं नरव्याघ्र तन्निबोध युधिष्ठिर\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2179902, "chapter_id": 4812, "verse_number": "३", "content_sanskrit": "अश्मानं ब्राह्मणं प्राज्ञं वैदेहो जनको नृपः ।\nसंशयं परिपप्रच्छ दुःखशोकपरिप्लुतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2179903, "chapter_id": 4812, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2179904, "chapter_id": 4812, "verse_number": "४", "content_sanskrit": "आगमे यदि वापाये ज्ञातीनां द्रविणस्य च ।\nनरेण प्रतिपत्तव्यं कल्याणं कथमिच्छता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2179905, "chapter_id": 4812, "verse_number": "", "content_sanskrit": "अश्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2179906, "chapter_id": 4812, "verse_number": "५", "content_sanskrit": "उत्पन्नमिममात्मानं नरस्यानन्तंर ततः ।\nतानि तान्यभिवर्तन्ते दुःखानि च सुखानि च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2179907, "chapter_id": 4812, "verse_number": "६", "content_sanskrit": "तेषामन्यतरापत्तौ यद् यदेवोपसेवते ।\nतत् तद्धि चेतनामस्य हरत्यभ्रमिवानिलः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2179908, "chapter_id": 4812, "verse_number": "७", "content_sanskrit": "अभिजातोऽस्मि सिद्धोऽस्मि नास्मि केवलमानुषः ।\nइत्येवं हेतुभिस्तस्य त्रिभिश्चित्तं प्रसिच्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2179909, "chapter_id": 4812, "verse_number": "८", "content_sanskrit": "सम्प्रसिक्तमना भोगान् विसृज्य पितृसञ्चितान् ।\nपरिक्षीणं परस्वानामादानं साधु मन्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2179910, "chapter_id": 4812, "verse_number": "९", "content_sanskrit": "तमतिक्रान्तमर्यादमाददानमसाम्प्रतम् ।\nप्रतिषेधन्ति राजानो लुब्धा मृगमिवेषुभिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2179911, "chapter_id": 4812, "verse_number": "१०", "content_sanskrit": "ये च विंशतिवर्षा वा त्रिंशद् वर्षाश्च मानवाः ।\nपरेण ते वर्षशतान्न भविष्यन्ति पार्थिव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2179912, "chapter_id": 4812, "verse_number": "११", "content_sanskrit": "तेषां परमदुःखानां बुद्ध्या भेषजमादिशेत् ।\nसर्वप्राणभृतां वृत्तं प्रेक्षमाणस्ततस्ततः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2179913, "chapter_id": 4812, "verse_number": "१२", "content_sanskrit": "मानसानां पुनवर्योनिर्दुःखानां चित्तविभ्रमः ।\nअनिष्टोपनिपातो वा तृतीयं नोपपद्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2179914, "chapter_id": 4812, "verse_number": "१३", "content_sanskrit": "एवमेतानि दुःखानि तानि तानीह मानवम् ।\nविविधान्युपवर्तन्ते तथा सांस्पर्शकानि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2179915, "chapter_id": 4812, "verse_number": "१४", "content_sanskrit": "जरामृत्यू ह भूतानि खादितारौ वृकाविव ।\nबलिनां दुर्बलानां च ह्रस्वानां महतामपि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2179916, "chapter_id": 4812, "verse_number": "१५", "content_sanskrit": "न कश्चिज्जात्वतिक्रामेज् जरामृत्यू ह मानवः ।\nअपि सागरपर्यन्तां विजित्येमां वसुन्धराम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2179917, "chapter_id": 4812, "verse_number": "१६", "content_sanskrit": "सुखं वा यदि वा दुःखं भूतानां पर्युपस्थितम् ।\nप्राप्तव्यमवशैः सर्वं परिहारो न विद्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2179918, "chapter_id": 4812, "verse_number": "१७", "content_sanskrit": "पूर्वे वयसि मध्ये वाप्युत्तमे वा नराधिप ।\nअवर्जनीयास्तेऽर्था वै काङ्क्षिताश्च ततोऽन्यथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2179919, "chapter_id": 4812, "verse_number": "१७", "content_sanskrit": "सुप्रियैर्विप्रयोगश्च संप्रयोगस्तथाप्रियैः ।\nअर्थानर्थौ सुखं दुःखं विधानमनुवर्तते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2179920, "chapter_id": 4812, "verse_number": "१९", "content_sanskrit": "प्रादुर्भावश्च भूतानां देहन्यासस्तथैव च ।\nप्राप्तिव्यायामयोगश्च सर्वमेतत् प्रतिष्ठितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2179921, "chapter_id": 4812, "verse_number": "२०", "content_sanskrit": "गन्धवर्णरसस्पर्शा निवर्तन्ते स्वभावतः ।\nतथैव सुखदुःखानि विधानमनुवर्तते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2179922, "chapter_id": 4812, "verse_number": "२१", "content_sanskrit": "आसनं शयनं यानमुत्थानं पानभोजनम् ।\nनियतं सर्वभूतानां कालेनैव भवन्त्युत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2179923, "chapter_id": 4812, "verse_number": "२२", "content_sanskrit": "वैद्याश्चाप्यातुराः सन्ति बलवन्तः सुदुर्बलाः ।\nस्त्रीमन्तश्च तथा षण्ढा विचित्रः कालपर्ययः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2179924, "chapter_id": 4812, "verse_number": "२३", "content_sanskrit": "कुले जन्म तथा वीर्यमारोग्यं धैर्यमेव च ।\nसौभाग्यमुपभोगश्च भवितव्येन लभ्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2179925, "chapter_id": 4812, "verse_number": "२४", "content_sanskrit": "सन्ति पुत्राः सुबहवो दरिद्राणामनिच्छताम् ।\nबहूनामिच्छतां नास्ति समृद्धानां विचेष्टताम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2179926, "chapter_id": 4812, "verse_number": "२५", "content_sanskrit": "व्याधिरग्निर्जलं शस्त्रं बुभुक्षा श्वापदं विषम् ।\nरज्ज्वा च मरणं जन्तोरुच्चाच्च पतनं तथा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2179927, "chapter_id": 4812, "verse_number": "२६", "content_sanskrit": "निर्याणं यस्य यद् दिष्टं तेन गच्छति हेतुना ।\nदृश्यते नाभ्यतिक्रामन्नतिक्रान्तो नवा पुनः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2179928, "chapter_id": 4812, "verse_number": "२७", "content_sanskrit": "दृश्यते हि युवैवेह विनश्यन् वसुमान्नरः ।\nदरिद्रश्च परिक्लिष्टः शतवर्षो जनाधिप\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2179929, "chapter_id": 4812, "verse_number": "२८", "content_sanskrit": "अकिञ्चनाश्च दृश्यन्ते पुरुषाश्चिरजीविनः ।\nसमृद्धे च कुले जाता विनश्यन्ति पतङ्गवत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2179930, "chapter_id": 4812, "verse_number": "२९", "content_sanskrit": "प्रायेण श्रीमतां लोके भोक्तुं शक्तिर्न विद्यते ।\nकाष्ठान्यपि हि जीर्यन्ते दरिद्राणां नराधिप\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2179931, "chapter_id": 4812, "verse_number": "३०", "content_sanskrit": "अहमेतत् करोमीति मन्यते कालचोदितः ।\nयद्यदिष्टमसन्तोषाद् दुरात्मा पापमाचरन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2179932, "chapter_id": 4812, "verse_number": "३१", "content_sanskrit": "स्त्रियोऽक्षा मृगया पानं प्रसङ्गान्निन्दिता बुधैः ।\nदृश्यन्ते चापि बहवः सम्प्रसक्ता बहुश्रुताः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2179933, "chapter_id": 4812, "verse_number": "समाप्तिः", "content_sanskrit": "इति कालेन सर्वार्थानीप्सितानीप्सितानि च ।\nस्पृशन्ति सर्वभूतानि निमित्तं नोपलभ्यते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2179934, "chapter_id": 4812, "verse_number": "३३", "content_sanskrit": "वायुमाकाशमग्निं च चन्द्रादित्यावहःक्षपे ।\nज्योतींषि सरितः शैलान् कः करोति बिभर्ति वा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2179935, "chapter_id": 4812, "verse_number": "३४", "content_sanskrit": "शीतमुष्णं तथा वर्षं कालेन परिवर्तते ।\nएवमेव मनुष्याणां सुखदुःखे नरर्षभ\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2179936, "chapter_id": 4812, "verse_number": "३५", "content_sanskrit": "नौषधानि न शास्त्राणि न होमा न पुनर्जपाः ।\nत्रायन्ते मृत्युनोपेतं जरया वापि मानुषम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2179937, "chapter_id": 4812, "verse_number": "३६", "content_sanskrit": "यथा काष्ठं च काष्ठं च समेयातां महोदधौ ।\nसमेत्य च व्यतीयातां तद्वद् भूतसमागमः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2179938, "chapter_id": 4812, "verse_number": "३७", "content_sanskrit": "ये चापि पुरुषैः स्त्रीभिर्गीतवाद्यैरुपस्थिताः ।\nये चानाथाः परान्नादाः कालस्तेषु समक्रियः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2179939, "chapter_id": 4812, "verse_number": "३८", "content_sanskrit": "मातृपितृसहस्राणि पुत्रदारशतानि च ।\nसंसारेष्वनुभूतानि कस्य ते कस्य वा वयम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2179940, "chapter_id": 4812, "verse_number": "३९", "content_sanskrit": "नैवास्य कश्चिद् भविता नायं भवति कस्यचित् ।\nपथि सङ्गतमेवेदं दारबन्धुसुहद्गणैः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2179941, "chapter_id": 4812, "verse_number": "४०", "content_sanskrit": "क्वासं क्वास्मि गमिष्यामि को न्वहं किमिहास्थितः ।\nकस्मात् कमनुशोचेयमित्येवं स्थापयेन्मनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2179942, "chapter_id": 4812, "verse_number": "४१", "content_sanskrit": "अनित्ये प्रियसंवासे संसारे चक्रवद् गतौ ।\nन दृष्टपूर्वं प्रत्यक्षं परलोकं विदुर्बुधाः ।\nआगमांस्त्वनतिक्रम्य श्रद्धातव्यं बुभूषता\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2179943, "chapter_id": 4812, "verse_number": "४२", "content_sanskrit": "कुर्वीत पितृदैवत्यं धर्माणि च समाचरेत् ।\nयजेच्च विद्वान् विधिवत् त्रिवर्गं चाप्यनुव्रजेत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2179944, "chapter_id": 4812, "verse_number": "४३", "content_sanskrit": "सन्निमज्जज् जगदिदं गम्भीरे कालसागरे ।\nजरामृत्युमहाग्राहे न कश्चिदवबुद्ध्यते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2179945, "chapter_id": 4812, "verse_number": "४४", "content_sanskrit": "आयुर्वेदमधीयानाः केवलं सपरिग्रहम् ।\nदृश्यन्ते बहवो वैद्या व्याधिभिः समभिप्लुताः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2179946, "chapter_id": 4812, "verse_number": "४५", "content_sanskrit": "ते पिबन्तः कषायांश्च सर्पींषि विविधानि च ।\nन मृत्युमतिवर्तन्ते वेलामिव महोदधिः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2179947, "chapter_id": 4812, "verse_number": "४६", "content_sanskrit": "रसायनविदश्चैव सुप्रयुक्तरसायनाः ।\nदृश्यन्ते जरया भग्ना नगा नागैरिवोत्तमैः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2179948, "chapter_id": 4812, "verse_number": "४७", "content_sanskrit": "तथैव तपसोपेताः स्वाध्यायाभ्यसने रताः ।\nदातारो यज्ञशीलाश्च न तरन्ति जरान्तकौ\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2179949, "chapter_id": 4812, "verse_number": "४८", "content_sanskrit": "न ह्यहानि निवर्तन्ते न मासा न पुनः समाः ।\nजातानां सर्वभूतानां न पक्षा न पुनः क्षपाः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2179950, "chapter_id": 4812, "verse_number": "४९", "content_sanskrit": "सोनयं विपुलमध्वानं कालेन ध्रुवमध्रुवः ।\nनरोऽवशः समभ्येति सर्वभूतनिषेवितम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2179951, "chapter_id": 4812, "verse_number": "५०", "content_sanskrit": "देहो वा जीवतोऽभ्येति जीवो वाऽप्येति देहतः ।\nपथि सङ्गतमेवेदं दारैरन्यैश्च बन्धुभिः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2179952, "chapter_id": 4812, "verse_number": "५१", "content_sanskrit": "नायमत्यन्तसंवासो लभ्यते जातु केनचित् ।\nअपि स्वेन शरीरेण किमुतान्येन केनचित्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2179953, "chapter_id": 4812, "verse_number": "५२", "content_sanskrit": "क्व नु तेऽद्य पिता राजन् क्व नु तेऽद्य पितामहः ।\nन त्वं पश्यसि तानद्य न त्वां पश्यन्ति तेऽपि च\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2179954, "chapter_id": 4812, "verse_number": "५३", "content_sanskrit": "नह्येव पुरुषो द्रष्टा स्वर्गस्य नरकस्य वा ।\nआगमस्तु सतां चक्षुर्नृपतते तमिहाचर\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2179955, "chapter_id": 4812, "verse_number": "५४", "content_sanskrit": "चरितब्रह्मचर्यो हि प्रजायेत यजेत च ।\nपितृदेवमहर्षीणामानृण्यायानसूयकः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2179956, "chapter_id": 4812, "verse_number": "५५", "content_sanskrit": "स यज्ञशीलः प्रजने निविष्टः\nप्राग् ब्रह्मचारी प्रविभक्तपक्षः ।\nआराधयन् स्वर्गमिमं च लोकं\nपरं च मुक्त्वा हृदयव्यलीकम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2179957, "chapter_id": 4812, "verse_number": "५६", "content_sanskrit": "सम्यग् हि धर्मं चरतो नृपस्य\nद्रव्याणि चाप्याहरतो यथावत् ।\nप्रवृत्तचक्रस्य यशोऽभिवर्धते\nसर्वेषु लोकेषु चराचरेषु\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2179958, "chapter_id": 4812, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2179959, "chapter_id": 4812, "verse_number": "५७", "content_sanskrit": "इत्येवमाज्ञाय विदेहराजो\nवाक्यं समग्रं परिपूर्णहेतुः ।\nअश्मानमामन्त्र्य विशुद्धबुद्धिः\nययौ गृहं स्वं प्रति शान्तशोकः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2179960, "chapter_id": 4812, "verse_number": "५८", "content_sanskrit": "तथा त्वमप्यच्युत मुञ्च शोकं\nउत्तिष्ठ शक्रोपम हर्षमेहि ।\nक्षात्रेण धर्मेण मही जिता ते\nतां भुङ्क्ष्व कुन्तीसुत मा विषादीः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2179961, "chapter_id": 4812, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे व्यासवाक्ये अश्मगीतं नाम एकोनत्रिंशोऽध्यायः ॥ २९ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]