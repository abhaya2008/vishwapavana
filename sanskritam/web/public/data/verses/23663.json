[{"id": 7003663000, "chapter_id": 23663, "verse_number": "१-२-५०-१", "content_sanskrit": "अतिथिरुवाच ।\nसाध्वबालमते बाल कमठैतत्त्वयोच्यते ।\nशरीरलक्षणं श्रोतुं पुनरिच्छामि तद्वद ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003663001, "chapter_id": 23663, "verse_number": "१-२-५०-२", "content_sanskrit": "कमठ उवाच ।\nयथैतद्वेद ब्रह्मांडं शरीरं च तथा शृणु ।\nपादमूलं च पातालं प्रपदं च रसातलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003663002, "chapter_id": 23663, "verse_number": "१-२-५०-३", "content_sanskrit": "तलातलं तथा गुल्फौ जंघे चास्य महातलम् ।\nजानुनी सुतलं चोरू वितलं चातलं कटिम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003663003, "chapter_id": 23663, "verse_number": "१-२-५०-४", "content_sanskrit": "नाभिं महीतलं प्राहुर्भुवर्लोकमथोदरम् ।\nउरःस्थलं च स्वर्लोकं महर्ग्रीवा मुखं जनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003663004, "chapter_id": 23663, "verse_number": "१-२-५०-५", "content_sanskrit": "नेत्रे तपः सत्यलोकं शीर्षदेशं वदंति च ।\nतद्यथा सप्त द्वीपानि पृथिव्यां संस्थितानि च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003663005, "chapter_id": 23663, "verse_number": "१-२-५०-६", "content_sanskrit": "तथात्र धातवः सप्त नामतस्तान्निबोध मे ।\nत्वगसृङ्मांस मेदोऽस्थिमज्जाशुक्राणि धातवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003663006, "chapter_id": 23663, "verse_number": "१-२-५०-७", "content_sanskrit": "अस्थ्नामत्र शतानि स्युस्त्रीणि षष्ट्यधिकानि च ।\nत्रिंशच्छतसहस्राणि नाडीनां कथितानि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003663007, "chapter_id": 23663, "verse_number": "१-२-५०-८", "content_sanskrit": "षट्पंचाशत्सहस्राणि तथान्यानि नवैव तु ।\nता वहंति रसं देहे जलं नद्यो यथा भुवि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003663008, "chapter_id": 23663, "verse_number": "१-२-५०-९", "content_sanskrit": "सार्धाभिस्तिसृभिश्छन्नं समंताद्रोमकोटिभिः ।\nशरीरं स्थूलसूक्ष्माभिर्दृश्यादृश्या हि ताः स्मृताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003663009, "chapter_id": 23663, "verse_number": "१-२-५०-१०", "content_sanskrit": "षडंगानि प्रधानानि कथ्यमानानि मे शृणु ।\nद्वौ बाहू सक्थिनी द्वे च मूर्धा जठरमेव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003663010, "chapter_id": 23663, "verse_number": "१-२-५०-११", "content_sanskrit": "अंत्राण्यत्र तथा त्रीणि सार्धव्यामत्रयाणि च ।\nत्रिव्यामानि तथा स्त्रीणामाहुर्वेदविदो द्विजाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003663011, "chapter_id": 23663, "verse_number": "१-२-५०-१२", "content_sanskrit": "ऊर्ध्वनालमधोवक्त्रं हृदि पद्मं प्रकीर्त्यते ।\nहृत्पद्मवामतः प्लीहो दक्षिणे स्यात्तथा यकृत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003663012, "chapter_id": 23663, "verse_number": "१-२-५०-१३", "content_sanskrit": "मज्जातो मेदसश्चैव वसायाश्च तथा द्विज ।\nमूत्रस्य चैव पित्तस्य श्लेष्मणः शकृतस्तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003663013, "chapter_id": 23663, "verse_number": "१-२-५०-१४", "content_sanskrit": "रक्तस्य चरमस्यात्र गर्ता द्व्यंजलयः स्मृताः ।\nगेयः प्रवर्तमानास्ते देहं संधारयंत्युत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003663014, "chapter_id": 23663, "verse_number": "१-२-५०-१५", "content_sanskrit": "सीवन्यश्च तथा सप्त पंच मूर्धानमास्थिताः ।\nएका मेढ्रं गता चैका तथा जिह्वां गता द्विज ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003663015, "chapter_id": 23663, "verse_number": "१-२-५०-१६", "content_sanskrit": "नाड्यः सर्वाः प्रवर्तंते नाभिपद्मात्तथात्र च ।\nयासां श्रेष्ठा शिरो याता सुषुम्नेडाऽथ पिंगला ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003663016, "chapter_id": 23663, "verse_number": "१-२-५०-१७", "content_sanskrit": "नासिकाद्वारमासाद्य संस्थिते देहवर्धने ।\nवायुरग्निश्चंद्रमाश्च पंचधा पंचधात्र च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003663017, "chapter_id": 23663, "verse_number": "१-२-५०-१८", "content_sanskrit": "प्राणापानसमानाश्च उदानो व्यान एव च ।\nपंच भेदाः स्मृता वायोः कर्मार्ण्येषां वदंति च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003663018, "chapter_id": 23663, "verse_number": "१-२-५०-१९", "content_sanskrit": "उच्छ्वासश्चैव निःश्वासो ह्यन्नपानप्रवेशनम् ।\nआकंठाच्छीर्षसंस्थास्य प्राणकर्म प्रकीर्तितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003663019, "chapter_id": 23663, "verse_number": "१-२-५०-२०", "content_sanskrit": "त्यागो विण्मूत्रशुक्राणां गर्भविस्रवणं तथा ।\nअपानकर्म निर्दिष्टं स्थानमस्य गुदोपरि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003663020, "chapter_id": 23663, "verse_number": "१-२-५०-२१", "content_sanskrit": "समानो धारयत्यन्नं विवेचयति चाप्यथ ।\nरसयंश्चैव चरति सर्वश्रोणिष्ववारितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003663021, "chapter_id": 23663, "verse_number": "१-२-५०-२२", "content_sanskrit": "वाक्प्रवृत्तिप्रदोद्गारे प्रयत्ने सर्वकर्मणाम् ।\nआकंठसुरसंस्थानमुदानस्य प्रकीर्त्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003663022, "chapter_id": 23663, "verse_number": "१-२-५०-२३", "content_sanskrit": "व्यानो हृदि स्थितो नित्यं तथा देहचरोपि च ।\nधातुवृद्धिप्रदः स्वेदलालोन्मेषनिमेषकृत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003663023, "chapter_id": 23663, "verse_number": "१-२-५०-२४", "content_sanskrit": "पाचको रजकश्चैव साधकालोचकौ तथा ।\nभ्राजकश्च तथा देहे पञ्चधा पावकः स्थितः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003663024, "chapter_id": 23663, "verse_number": "१-२-५०-२५", "content_sanskrit": "पाचकस्तु पचत्यन्नं नित्यं पक्वाशये स्थित॥  ।\nआमाशयस्थोऽपि रसं रंजकः कुरुते त्वसृक् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003663025, "chapter_id": 23663, "verse_number": "१-२-५०-२६", "content_sanskrit": "साधको हृदिसंस्थश्च बुद्ध्याद्युत्साहकारकः ।\nआलोचकश्च दृक्संस्थो रूपदर्शनशक्ति कृत ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003663026, "chapter_id": 23663, "verse_number": "१-२-५०-२७", "content_sanskrit": "त्वक्संस्थो भ्राजको देहं भ्राजयेन्निर्मलीकृतः ।\nक्लेदको बोधकश्चैव तर्पणः श्लेष्मणस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003663027, "chapter_id": 23663, "verse_number": "१-२-५०-२८", "content_sanskrit": "आलंबकस्तथा देहे पंचधा सोम उच्यते ।\nक्लेदकः क्लेदयत्यन्नं नित्यं पक्वाशये स्थितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003663028, "chapter_id": 23663, "verse_number": "१-२-५०-२९", "content_sanskrit": "बोधको रसनास्थश्च रसानामवबोधकः ।\nशिरःस्थश्चक्षुरादीनां तर्पणात्तर्पणः स्मृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003663029, "chapter_id": 23663, "verse_number": "१-२-५०-३०", "content_sanskrit": "सर्वसंधिगतश्चैव श्लेष्मणः श्लेष्मकृत्तथा ।\nउरःस्थः सर्वगात्राणि स वै ह्यालंबकः स्थितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003663030, "chapter_id": 23663, "verse_number": "१-२-५०-३१", "content_sanskrit": "एवं वाय्वग्निसोमैश्च देहः संधारितस्त्वसौ ।\nआकाशजानि स्रोतांसि तथा कोष्ठविविक्तता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003663031, "chapter_id": 23663, "verse_number": "१-२-५०-३२", "content_sanskrit": "पार्थिवानीह जानीहि घ्राणकेशनखानि च ।\nअस्थीनि धैर्यं गुरुता त्वङ्मांस हृदयं गुदम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003663032, "chapter_id": 23663, "verse_number": "१-२-५०-३३", "content_sanskrit": "नाभिर्मेदो यकृन्मज्जा अंत्रमामाशयः शिरा ।\nस्नायुः पक्वाशयश्चैव प्राहुर्वेदविदो द्विजाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003663033, "chapter_id": 23663, "verse_number": "१-२-५०-३४", "content_sanskrit": "नेत्रयोर्मडलं शुक्लं कफाद्भवति पैतृकम् ।\nकृष्णं च मण्डलं वातात्तथा भवति मातृकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003663034, "chapter_id": 23663, "verse_number": "१-२-५०-३५", "content_sanskrit": "पक्ष्ममण्डलमेकं तु द्वितीयं चर्ममण्डलम् ।\nशुक्लं तृतीयं कथित चतुर्थं कृष्णमण्डलम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003663035, "chapter_id": 23663, "verse_number": "१-२-५०-३६", "content_sanskrit": "दृङ्मण्डलं पंचमं तु नेत्रं स्यात्पंचमण्डलम् ।\nअपरे नेत्रभागे द्वे उपांगोऽपांग एव च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003663036, "chapter_id": 23663, "verse_number": "१-२-५०-३७", "content_sanskrit": "उपांगो नेत्रपर्यंतो नासा मूलमपांगकः ।\nवृषणौ च तथा प्रोक्तौ मेदोसृक्कफमांसकौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003663037, "chapter_id": 23663, "verse_number": "१-२-५०-३८", "content_sanskrit": "असृङ्मांसमयी जिह्वा सर्वेषामेव देहिनाम् ।\nहस्तयोरोष्ठयोर्मेढ्रे ग्रीवायां षट् च कूर्चकाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003663038, "chapter_id": 23663, "verse_number": "१-२-५०-३९", "content_sanskrit": "एवमत्र स्थिते जीवो देहेऽस्मिन्सप्तसप्तके ।\nपंचविंशतिको व्याप्य देहं वासोऽस्य मूर्धनि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003663039, "chapter_id": 23663, "verse_number": "१-२-५०-४०", "content_sanskrit": "त्वगसृग्मांसमित्याहुस्त्रिकं मातृसमुद्भवम् ।\nमेदोमज्जास्थिकं प्रोक्तं पितृजं षट्च कौशिकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003663040, "chapter_id": 23663, "verse_number": "१-२-५०-४१", "content_sanskrit": "एवं भूतमयं देहं पंचभूतसमुद्भवैः ।\nअन्नैर्यथा वृद्धिमेति तदहं वर्णयामि ते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003663041, "chapter_id": 23663, "verse_number": "१-२-५०-४२", "content_sanskrit": "तदन्नं पिण्डकवलैर्ग्रासैर्भुक्तं च देहिभिः ।\nपूर्वं स्थूलाशये वायुः प्राणः प्रकुरुते द्विधा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003663042, "chapter_id": 23663, "verse_number": "१-२-५०-४३", "content_sanskrit": "संप्रविश्यान्नमध्ये तु पृथगन्नपृथग्जलम् ।\nअग्नेरूर्ध्वं जलं स्थाप्य तदन्नं तज्जलोपरि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003663043, "chapter_id": 23663, "verse_number": "१-२-५०-४४", "content_sanskrit": "जलस्याधः स्वयं प्राणः स्थित्वाग्निं धमते शनैः ।\nवायुना धम्यमानोग्निरत्युष्णं कुरुते जलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003663044, "chapter_id": 23663, "verse_number": "१-२-५०-४५", "content_sanskrit": "तदन्नमुष्णतोयेन समंतात्पच्यते पुनः ।\nद्विधा भवति तत्पक्वं पृथक्किट्टं पृथग्रसम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003663045, "chapter_id": 23663, "verse_number": "१-२-५०-४६", "content_sanskrit": "मलैर्द्वादशभिः किट्टं भिन्नं देहाद्बहिर्व्रजेत् ।\nकर्णाक्षिनासिकाजिह्वादताः शिश्नं गुदं नखाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003663046, "chapter_id": 23663, "verse_number": "१-२-५०-४७", "content_sanskrit": "रोमकूपाणि चैव स्युर्द्वादशैते मलाश्रयाः ।\nहृत्पद्मप्रतिबद्धाश्च सर्वा नाड्यः समंततः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003663047, "chapter_id": 23663, "verse_number": "१-२-५०-४८", "content_sanskrit": "तासां मुखेषु तं सूक्ष्मं व्यानः स्थापयते रसम् ।\nरसेन तेन ता नाडीः समानः पूरयेत्पुनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003663048, "chapter_id": 23663, "verse_number": "१-२-५०-४९", "content_sanskrit": "ततः प्रयांति संपूर्णास्ताश्च देहं समंततः ।\nततः स नाडिमध्यस्थो रञ्जकेनोष्मणा रसः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003663049, "chapter_id": 23663, "verse_number": "१-२-५०-५०", "content_sanskrit": "पच्यते पच्यमानस्तु रुधिरत्वं भजेत्पुनः ।\nततस्त्वग्लोमकेशाश्च मांसं स्नायु शिरास्थि च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003663050, "chapter_id": 23663, "verse_number": "१-२-५०-५१", "content_sanskrit": "नखा मज्जा खवैमल्यं शुक्रवृद्धिः क्रमाद्भवेत् ।\nएवं द्वादशधान्नस्य परिणामः प्रकीर्त्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003663051, "chapter_id": 23663, "verse_number": "१-२-५०-५२", "content_sanskrit": "एवमेतद्विनिष्पन्नं शरीरं पुण्यहेतवे ।\nयथैव स्यंदनः शुभ्रो भारसंवाहनाय च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003663052, "chapter_id": 23663, "verse_number": "१-२-५०-५३", "content_sanskrit": "तैलाभ्यंगादिभिर्यत्नैर्बहुभिः पाल्यते न चेत् ।\nकिं कृत्यं साध्यते तेन यदि भारं वहेन्न हि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003663053, "chapter_id": 23663, "verse_number": "१-२-५०-५४", "content_sanskrit": "एवमेतेन देहेन किं कृत्यं भोजनोत्तमैः ।\nवर्धितेन न चेत्पुण्यं कुरुते पशुवच्च तत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003663054, "chapter_id": 23663, "verse_number": "१-२-५०-५५", "content_sanskrit": "भवंति चात्र श्लोकाः ।\nयस्मिन्काले च देशे च वयसा यादृशेन च ।\nकृतं शुभाशुभं कर्म तत्तथा तेन भुज्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003663055, "chapter_id": 23663, "verse_number": "१-२-५०-५६", "content_sanskrit": "तस्मात्सदा शुभं कार्यमविच्छिन्नसुखार्थिभिः ।\nविच्छिद्यंतेऽन्यथा भोगा ग्रीष्मे कुसरितो यथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003663056, "chapter_id": 23663, "verse_number": "१-२-५०-५७", "content_sanskrit": "यस्मात्पापेन दुःखानि तीव्राणि सुबहून्यपि ।\nतस्मात्पापं न कर्तव्यमात्मपीडाकरं हि तत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003663057, "chapter_id": 23663, "verse_number": "१-२-५०-५८", "content_sanskrit": "एवं ते वर्णितः साधो प्रश्नोऽयं शक्तितो मया ।\nयथा संजायते प्राणी यथा शृणु प्रलीयते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003663058, "chapter_id": 23663, "verse_number": "१-२-५०-५९", "content_sanskrit": "आयुष्ये कर्मणि क्षीणे संप्राप्ते मरणे नृणाम् ।\nस्वकर्मवशगो देही कृष्यते यमकिंकरैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003663059, "chapter_id": 23663, "verse_number": "१-२-५०-६०", "content_sanskrit": "पंचतन्मात्रसहितः समनोबुद्ध्यहंकृतिः ।\nपुण्यपापमयैः पाशैर्बद्धो जीवस्त्यजे द्वपुः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003663060, "chapter_id": 23663, "verse_number": "१-२-५०-६१", "content_sanskrit": "शीर्ष्णश्च सप्तभिश्छिद्रैर्निर्गच्छेत्पुण्यकर्मणाम् ।\nअधश्च पापिनां यांति योगिनां ब्रह्मरंध्रतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003663061, "chapter_id": 23663, "verse_number": "१-२-५०-६२", "content_sanskrit": "तत्क्षणात्सोऽथ गृह्णाति शारीरं चातिवाहिकम् ।\nअंगुष्ठपर्वमात्रं तु स्वप्राणैरेव निर्मितम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003663062, "chapter_id": 23663, "verse_number": "१-२-५०-६३", "content_sanskrit": "ततस्तस्मिन्स्थितं जीवं देहे यमभटास्तदा ।\nबद्ध्वा नयंति मार्गेण याम्येनाति यथाबलम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003663063, "chapter_id": 23663, "verse_number": "१-२-५०-६४", "content_sanskrit": "तप्तांबरीषतुल्येन अयोगुडनिभेन च ।\nप्रतप्तसिकतेनापि ताम्रपात्रनिभेन च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003663064, "chapter_id": 23663, "verse_number": "१-२-५०-६५", "content_sanskrit": "षडशीतिसहस्राणि योजनानां महीतलात् ।\nकृष्यमाणो यमपुरीं नीयते पापकृद्भटैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003663065, "chapter_id": 23663, "verse_number": "१-२-५०-६६", "content_sanskrit": "क्वचिच्छीतं महादुर्गमन्धकारं क्वचिन्महत् ।\nअग्निसंस्पर्शवदनैः काककाकोलजंबुकैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003663066, "chapter_id": 23663, "verse_number": "१-२-५०-६७", "content_sanskrit": "मक्षिकादंशमशकैर्भक्ष्यते सर्पवृश्चिकैः ।\nभक्ष्यमाणोऽपि तैर्जंतुः क्रंदते म्रियते न हि ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003663067, "chapter_id": 23663, "verse_number": "१-२-५०-६८", "content_sanskrit": "क्वचिच्च भक्ष्यते घोरै राक्षसैः कृष्यतेऽस्यते ।\nदह्यमानोतिघोरेण सैकतेन च नीयते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003663068, "chapter_id": 23663, "verse_number": "१-२-५०-६९", "content_sanskrit": "मुहूतैर्दशभिर्याति तं मार्गमतिदुस्तरम् ।\nतं कालं सुमहद्वेत्ति पुरुषो वर्षसंमितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003663069, "chapter_id": 23663, "verse_number": "१-२-५०-७०", "content_sanskrit": "तार्यते च नदीं घोरां पूयशोणितवाहिनीम् ।\nनदीं वैतरणीं नाम केशशैवलशाद्वलाम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003663070, "chapter_id": 23663, "verse_number": "१-२-५०-७१", "content_sanskrit": "ततो यमस्य पुरतः स्थाप्यते यमकिंकरैः ।\nपापी महाभयं पश्येत्कालांतकमुखैर्वृतम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003663071, "chapter_id": 23663, "verse_number": "१-२-५०-७२", "content_sanskrit": "पुण्यकर्मा सौम्यरूपं धर्मराजं तदा किल ।\nमनुष्या एव गच्छंति यमलोकेन चापरे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003663072, "chapter_id": 23663, "verse_number": "१-२-५०-७३", "content_sanskrit": "मरणानंतरं तेषां जंतूनां योनिपूरणम् ।\nतथाहि प्रेता मनुजाः श्रूयंते नान्यजंतवः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003663073, "chapter_id": 23663, "verse_number": "१-२-५०-७४", "content_sanskrit": "धार्मिकः पूज्यते तत्र पापः पाशगलो भवेत् ।\nधार्मिकश्च यथा याति तं मार्गं शृणु वच्मि ते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003663074, "chapter_id": 23663, "verse_number": "१-२-५०-७५", "content_sanskrit": "आरामद्रुमदातारः फलपुष्पवता पथा ।\nछायया च सुखं यांति तथा ये च्छत्रदा नराः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003663075, "chapter_id": 23663, "verse_number": "१-२-५०-७६", "content_sanskrit": "उपानहप्रदा यानैर्वितृषाः पूर्तधर्मिणः ।\nविमानैर्यानदा यांति तथा शय्यासनप्रदाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003663076, "chapter_id": 23663, "verse_number": "१-२-५०-७७", "content_sanskrit": "भक्ष्यभोज्यैस्तथा तृप्ता यांति भोजनदायिन ।\nदीपप्रदाः प्रकाशेन गोप्रदास्तां नदीं सुखम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003663077, "chapter_id": 23663, "verse_number": "१-२-५०-७८", "content_sanskrit": "श्रीसूर्यं श्रीमहादेवं भक्ता ये पुरुषोत्तमम् ।\nजन्मप्रभृति ते यांति पूज्यमाना यमानुगैः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003663078, "chapter_id": 23663, "verse_number": "१-२-५०-७९", "content_sanskrit": "महीं गां कांचनं लोहं तिलान्कार्पासमेव च ।\nलवणं सप्तधान्यं च दत्त्वा याति सुखं नरः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003663079, "chapter_id": 23663, "verse_number": "१-२-५०-८०", "content_sanskrit": "तेषां तत्र गतानां च पापिनां पुण्यकर्मिणाम् ।\nचित्रगुप्तः प्रेतपाय निरूपयति वै ततः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003663080, "chapter_id": 23663, "verse_number": "१-२-५०-८१", "content_sanskrit": "प्रेतलोके स वसति ततः संवत्सरं नरः ।\nवत्सरेण च तेनास्य शरीरमभिजायते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003663081, "chapter_id": 23663, "verse_number": "१-२-५०-८२", "content_sanskrit": "सोदकुम्भमथान्नाद्यं बांधवैर्यत्प्रदीयते ।\nदिनेदिने स तद्भुक्त्वा तेन वृद्धिं प्रयाति च ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003663082, "chapter_id": 23663, "verse_number": "१-२-५०-८३", "content_sanskrit": "पूर्वदत्तमथान्नाद्यं प्राप्नोति स्वयमेव च ।\nस्वयं येन न दत्तं च तथा दाता न विद्यते ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003663083, "chapter_id": 23663, "verse_number": "१-२-५०-८४", "content_sanskrit": "न चाप्युदकदातासौ क्षुत्तृड्भ्यामतिपीड्यते ।\nबांधवैस्तूदकं दत्तं नदीभूत्वोपतिष्ठति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003663084, "chapter_id": 23663, "verse_number": "१-२-५०-८५", "content_sanskrit": "मासिमासि च यच्छ्राद्धं षोडशश्राद्धपूर्वकम् ।\nअत्र न क्रियते यस्य प्रेतत्वात्स न मुच्यते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003663085, "chapter_id": 23663, "verse_number": "१-२-५०-८६", "content_sanskrit": "मानुषेण दिनेनैव प्रेतलोके दिनं स्मृतम् ।\nतस्माद्दिनेदिने देयं प्रेतायान्नं च वत्सरम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003663086, "chapter_id": 23663, "verse_number": "१-२-५०-८७", "content_sanskrit": "तं च स्माशानिकानाम गणा याम्या भयावहाः ।\nशीतवातातपोपेतं तत्र रक्षंति पापिनम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003663087, "chapter_id": 23663, "verse_number": "१-२-५०-८८", "content_sanskrit": "यथेह बन्धने कश्चिद्रक्ष्यते विषमैर्नरैः ।\nप्रेतपिंडा न दीयंते षोडशश्राद्धपूर्वकाः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003663088, "chapter_id": 23663, "verse_number": "१-२-५०-८९", "content_sanskrit": "यस्य तस्य न मोक्षोऽस्ति प्रेतत्वाद्वै युगैरपि ।\nततः सपिण्डीकरणे बांधवैः सुकृते नरः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003663089, "chapter_id": 23663, "verse_number": "१-२-५०-९०", "content_sanskrit": "पूर्णे संवत्सरे देहं संपूर्णं प्रतिपद्यते ।\nपापात्मा घोररूपं तु धार्मिको दिव्यमुत्तमम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003663090, "chapter_id": 23663, "verse_number": "१-२-५०-९१", "content_sanskrit": "ततः स नरकं याति स्वर्गं वा स्वेन कर्मणा ।\nरौरवाद्याश्च नरकाः पातालतलसंस्थिताः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003663091, "chapter_id": 23663, "verse_number": "१-२-५०-९२", "content_sanskrit": "सुराद्याः सत्यपर्यंताः स्वर्लोकस्योर्ध्वमाश्रिताः ।\nइतिहासपुराणेषु वेदस्मृतिषु यच्छुतम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003663092, "chapter_id": 23663, "verse_number": "१-२-५०-९३", "content_sanskrit": "पुण्यं तेन भवेत्स्वर्गो नरकस्तद्विपर्ययात् ।\nतत्रापि कालवसति कर्मणामनुरूपतः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003663093, "chapter_id": 23663, "verse_number": "१-२-५०-९४", "content_sanskrit": "अर्वाक्सपिंडीकरणं यस्य वर्षाच्च वा कृतम् ।\nप्रेतत्वमपि तस्यापि प्रोक्तं संवत्सरं धुवम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003663094, "chapter_id": 23663, "verse_number": "१-२-५०-९५", "content_sanskrit": "यैरिष्टं च त्रिभिर्मेधैरर्चितं वा सुरत्रयम् ।\nप्रेतलोकं न ते यांति तथा ये समरे हताः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003663095, "chapter_id": 23663, "verse_number": "१-२-५०-९६", "content_sanskrit": "शुद्धेन पुण्येन दिवं च शुद्धां पापेन शुद्धेन तथा तमोंधम् ।\nमिश्रेण स्वर्गं नरकं च याति देहस्तथैवास्य भवेच्च तादृक् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003663096, "chapter_id": 23663, "verse_number": "१-२-५०-९७", "content_sanskrit": "प्रश्नत्रयं चेति तव प्रणीतमुत्पत्तिमृत्यू परलोकवासः ।\nयथा गुरुर्मे समुदाजहार किं भूय इच्छत्युत तद्वदामि ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003663097, "chapter_id": 23663, "verse_number": "१-२-५०-९८", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्ड कौमारिकाखण्डे आदित्यकमठसंवादे जीवस्य पारलौकिकगत्यादिवर्णनंनाम पंचाशत्तमोऽध्यायः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]