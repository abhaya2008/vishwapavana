[{"id": 7005723000, "chapter_id": 25723, "verse_number": "१९६-१", "content_sanskrit": "मत्स्य उवाच ।\nमरीचितनया राजन्! सुरूपा नाम विश्रुता ।\nभार्या चाङ्गिरसो देवास्तस्याः पुत्रा दश स्मृताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005723001, "chapter_id": 25723, "verse_number": "१९६-२", "content_sanskrit": "आत्मायुर्दमनो दक्षः सदः प्राणस्तथैव च ।\nहविष्मांश्च गविष्ठश्च ऋतः सत्यश्च ते दश ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005723002, "chapter_id": 25723, "verse_number": "१९६-३", "content_sanskrit": "एते चाङ्गिरसो नाम देवा वै सोमपायिनः ।\nसुरूपा जनयामास ऋषीन् सर्वेश्वरानिमान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005723003, "chapter_id": 25723, "verse_number": "१९६-४", "content_sanskrit": "बृहस्पतिङ्गौतमञ्च संवर्त्तमृषिमुत्तमम् ।\nउतथ्यं वामदेवं च अजस्य मृषिजन्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005723004, "chapter_id": 25723, "verse_number": "१९६-५", "content_sanskrit": "इत्येते ऋषयः सर्वे गोत्रकाराः प्रकीर्तिताः ।\nतेषां गोत्रसमुत्पन्नान् गोत्रकारान्निबोध मे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005723005, "chapter_id": 25723, "verse_number": "१९६-६", "content_sanskrit": "उतथ्यो गौतमश्चैव तौलेयोऽभिजितस्तथा ।\nसार्धनेमिः सलौगाक्षिः क्षीरः कौष्टिकिरेव च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005723006, "chapter_id": 25723, "verse_number": "१९६-७", "content_sanskrit": "राहुकपिः सौपुरिश्च कैरातिः सामलोमकिः ।\nपौषजितिर्भार्गवतो ह्यृषिश्चैरीडवस्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005723007, "chapter_id": 25723, "verse_number": "१९६-८", "content_sanskrit": "कारोटकः सजीवी च उपबिन्दुसुरेषिणौ ।\nवाहिनीपति वैशाली क्रोष्टा चैवारुणायनिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005723008, "chapter_id": 25723, "verse_number": "१९६-९", "content_sanskrit": "सोमोत्रायनि कासोरु कौशल्याः पार्थिवास्तथा ।\nरौहिण्यायनिरैवाग्नी मूलपः पाण्डुरेव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005723009, "chapter_id": 25723, "verse_number": "१९६-१०", "content_sanskrit": "क्षपाविश्वकरोऽरिश्च पारिकारारिरेव च ।\nत्र्यार्षेयाः प्रवराश्चैव तेषां च प्रवरान् श्रृणु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005723010, "chapter_id": 25723, "verse_number": "१९६-११", "content_sanskrit": "अङ्गिराः सुवचो तथ्य उशिजश्च महानृषिः ।\nपरस्परमवैवाह्या ऋषयः परिकीर्तिताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005723011, "chapter_id": 25723, "verse_number": "१९६-१२", "content_sanskrit": "आत्रेयायनिसौवेष्ट्यौ अग्निवेश्यः शिलास्थलिः ।\nबालिशायनिश्चैकेपी वाराहिर्बाष्कलिस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005723012, "chapter_id": 25723, "verse_number": "१९६-१३", "content_sanskrit": "सौटिश्चत्रिणकर्णिश्च प्रावहिश्चाश्वलायनिः ।\nवाराहिर्बर्हिसादी च शिखाग्रीविस्तथैव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005723013, "chapter_id": 25723, "verse_number": "१९६-१४", "content_sanskrit": "कारकिश्च महाकापिस्तथा चोडुपतिः प्रभुः ।\nकौचकिर्धूमितश्चैव पुष्पान्वेषिस्तथैव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005723014, "chapter_id": 25723, "verse_number": "१९६-१५", "content_sanskrit": "सोमतन्विर्ब्रह्मतन्विः सालडिर्बालडिस्तथा ।\nदेवरारिर्देवस्थानिर्हारिकर्णिः सरिद्भविः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005723015, "chapter_id": 25723, "verse_number": "१९६-१६", "content_sanskrit": "प्रावेपिः साद्यसुग्रीविस्तथा गोमेदगन्धिकः ।\nमत्स्याच्छाद्यो मूलहरः फलाहारस्तथैव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005723016, "chapter_id": 25723, "verse_number": "१९६-१७", "content_sanskrit": "गाङ्गोदधिः कोरुपतिः कौरुक्षेत्रिस्तथैव च ।\nनायकिर्जैत्यद्रौणिश्च जैह्वलायनिरेव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005723017, "chapter_id": 25723, "verse_number": "१९६-१८", "content_sanskrit": "आपस्तम्बिर्मौञ्जवृष्टिर्मार्ष्टपिङ्गलिरेव च ।\nपैलश्चैव महातेजाः शालङ्कायनिरेव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005723018, "chapter_id": 25723, "verse_number": "१९६-१९", "content_sanskrit": "द्व्याख्येयोः मारुतश्चैषां त्र्यार्षेयः प्रवरो नृप! ।\nअङ्गिराः प्रथमस्तेषां द्वितीयश्च बृहस्पतिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005723019, "chapter_id": 25723, "verse_number": "१९६-२०", "content_sanskrit": "तृतीयश्च भरद्वाजः प्रवराः परिकीर्तिताः ।\nपरस्परमवैवाह्या इत्येते परिकीर्तिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005723020, "chapter_id": 25723, "verse_number": "१९६-२१", "content_sanskrit": "काण्वायनाः कोपचयास्तथा वात्स्यतरायणाः ।\nभ्राष्ट्रकृद्राष्ट्रपिण्डी च लैन्द्राणिः सायकायनिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005723021, "chapter_id": 25723, "verse_number": "१९६-२२", "content_sanskrit": "क्रोष्टाक्षी बहुवीती च तालकृन्मधुरावहः ।\nलावकृद्गालविद्गाथी मार्कटिः पौलिकायनिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005723022, "chapter_id": 25723, "verse_number": "१९६-२३", "content_sanskrit": "स्कन्दसश्च तथा चक्री गार्ग्यः श्यामायनिस्तथा ।\nबालाकिः साहरिश्चैव पञ्चर्षेयाः प्रकीर्तिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005723023, "chapter_id": 25723, "verse_number": "१९६-२४", "content_sanskrit": "अङ्गिराश्च महातेजा देवाचार्यो बृहस्पतिः ।\nभरद्वाजस्तथा गर्गः सैन्यश्च भगवानृषिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005723024, "chapter_id": 25723, "verse_number": "१९६-२५", "content_sanskrit": "परस्परमवैवाह्या ऋषयः परिकीर्तिताः ।\nकपीतरः स्वस्तितरो दाक्षिः शक्तिः पतञ्जलिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005723025, "chapter_id": 25723, "verse_number": "१९६-२६", "content_sanskrit": "भूयसिर्जलसन्धिश्च विन्दुर्मादिः कुसीदकिः ।\nऊर्बस्तु राजकेशी च वौषडिः शंसपिस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005723026, "chapter_id": 25723, "verse_number": "१९६-२७", "content_sanskrit": "शालिश्चकलशीकण्टः ऋषिः कारीरयस्तथा ।\nकाट्यो धान्यायनिश्चैव भावास्यायनिरेव च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005723027, "chapter_id": 25723, "verse_number": "१९६-२८", "content_sanskrit": "भारद्वाजिः सौबुधिश्च लघ्वी देवमतीस्तथा ।\nत्र्यार्षेयोऽभिमतश्चैव प्रवरो भूमिपोत्तम! ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005723028, "chapter_id": 25723, "verse_number": "१९६-२९", "content_sanskrit": "अङ्गिरा दमबाह्यश्च तता चैवाप्युरुक्षयः ।\nपरस्परायण्वर्णी च लौक्षिर्गार्ग्य हरिस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005723029, "chapter_id": 25723, "verse_number": "१९६-३०", "content_sanskrit": "गालविश्चैव त्र्यार्षेयः सर्वेषां प्रवरो मतः ।\nअङ्गिरा संकृतिश्चैव गौरवीतिस्तथैव च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005723030, "chapter_id": 25723, "verse_number": "१९६-३१", "content_sanskrit": "परस्परमवैवाह्या ऋषयः परिकीर्तिताः ।\nबृहदुक्थो वामदेवस्तथा त्रिः प्रवरा मताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005723031, "chapter_id": 25723, "verse_number": "१९६-३२", "content_sanskrit": "अङ्गिरा बृहदुक्थश्च वामदेवस्तथैव च ।\nकुत्साकुत्सैरवैवाह्या एवमाहुः पुरातनाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005723032, "chapter_id": 25723, "verse_number": "१९६-३३", "content_sanskrit": "रथीतराणां प्रवरा त्र्यार्षेयाः परिकीर्तिताः ।\nअङ्गिराश्च विरूपश्च तथैव च रथीतरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005723033, "chapter_id": 25723, "verse_number": "१९६-३४", "content_sanskrit": "रथीतराह्यवैवाह्या नित्यमेव रथीतरैः ।\nविष्णुवृद्धिः शिवमतिर्जतृणः कत्तृणस्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005723034, "chapter_id": 25723, "verse_number": "१९६-३५", "content_sanskrit": "पुत्रवश्च महातेजास्तथा वैरपरायणः ।\nत्र्यार्षेयोऽभिमतस्तेषां सर्वेषां प्रवरो नृप! ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005723035, "chapter_id": 25723, "verse_number": "१९६-३६", "content_sanskrit": "अङ्गिरा मत्स्यदग्धश्च मुद्गलश्च महातपाः ।\nपरस्परमवैवाह्या ऋषयः परिकीर्तिताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005723036, "chapter_id": 25723, "verse_number": "१९६-३७", "content_sanskrit": "हंसजिह्वो देवजिह्वो ह्यग्निजिह्वो विराडपः ।\nअपाग्नेयस्त्वश्वयुश्च परण्यस्ता विमौद्गलाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005723037, "chapter_id": 25723, "verse_number": "१९६-३८", "content_sanskrit": "त्र्यार्षेयाभिमतास्तेषां सर्वेषां प्रवराः शुभाः ।\nअङ्गिराश्चैव ताण्डिश्च मौद्गल्यश्च महातपाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005723038, "chapter_id": 25723, "verse_number": "१९६-३९", "content_sanskrit": "परस्परमवैवाह्या ऋषयः परिकीर्तिताः ।\nअपाण्डुश्च गुरुश्चैव तृतीयः शाकटायनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005723039, "chapter_id": 25723, "verse_number": "१९६-४०", "content_sanskrit": "ततः प्रागाथमा नारी मार्कण्डो मरणः शिवः ।\nकटुमर्कटपश्चैव तता नाडायनो ह्यृषिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005723040, "chapter_id": 25723, "verse_number": "१९६-४१", "content_sanskrit": "श्यामायनस्तथैवेषां त्र्यार्षेयाः प्रवरा शुभाः ।\nअङ्गिराश्चाजमीढश्च कट्यश्चैव महातपाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005723041, "chapter_id": 25723, "verse_number": "१९६-४२", "content_sanskrit": "परस्परमवैवाह्या ऋषयः परिकीर्तिताः ।\nतित्तिरिः कपिभूश्चैव गार्ग्यश्चैव महानृषिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005723042, "chapter_id": 25723, "verse_number": "१९६-४३", "content_sanskrit": "त्र्यार्षेयो हि मतस्तेषां सर्वेषां प्रवरः शुभः ।\nअङ्गिरास्तित्तिरिश्चैव कविभूश्च महानृषिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005723043, "chapter_id": 25723, "verse_number": "१९६-४४", "content_sanskrit": "परस्परमवैवाह्या ऋषयः परिकीर्तिताः ।\nअथ ऋक्षभरद्वाजौ ऋषिवान् मानवस्तथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005723044, "chapter_id": 25723, "verse_number": "१९६-४५", "content_sanskrit": "ऋषिर्मैत्रवरश्चैव पञ्चार्षेयाः प्रकीर्तिताः ।\nअङ्गिराः सभरद्वाजस्तथैव च बृहस्पतिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005723045, "chapter_id": 25723, "verse_number": "१९६-४६", "content_sanskrit": "ऋषिर्मित्रवरश्चैव ऋषिवान् मानवस्तथा ।\nपरस्परमवैवाह्या ऋषयः परिकीर्तिताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005723046, "chapter_id": 25723, "verse_number": "१९६-४७", "content_sanskrit": "भारद्वाजो हुतः शौङ्ग शैशिरेयस्तथैव च ।\nहत्येते कथिताः सर्वे द्व्यामुष्यायणगोत्रजाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005723047, "chapter_id": 25723, "verse_number": "१९६-४८", "content_sanskrit": "पञ्चार्षेयास्तथा ह्योषां प्रवराः परिकीर्तिताः ।\nअङ्गिराश्च भरद्वाजस्तथैव च बृहस्पतिः   ॥मौद्गल्यः शैशिरश्चैव प्रवरा परिकीर्तिताः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005723048, "chapter_id": 25723, "verse_number": "१९६-४९", "content_sanskrit": "एते तवोक्ताङ्गिरसस्तु वंशे महानुभावा ऋषिगोत्रकाराः ।\nयेषान्तु नाम्ना परिकीर्तितेन पापं समग्रं पुरुषो जहाति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]