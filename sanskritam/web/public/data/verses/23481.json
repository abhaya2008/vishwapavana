[{"id": 7003481000, "chapter_id": 23481, "verse_number": "१२१-१", "content_sanskrit": "अथ जन्माभावः ।\nश्रीवराह उवाच ।\nयेन गर्भं न गच्छेत तच्छृणुष्व वसुन्धरे ।\nकथयिष्यामि ते ह्येवं सर्वधर्मविनिश्चयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003481001, "chapter_id": 23481, "verse_number": "१२१-२", "content_sanskrit": "कृत्वापि विपुलं कर्म आत्मानं न प्रशंसति ।\nकरोति बहुकर्माणि शुद्धेनैवान्तरात्मना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003481002, "chapter_id": 23481, "verse_number": "१२१-३", "content_sanskrit": "कृत्वा तु मम कर्माणि समर्थोऽनुग्रहे रतः ।\nकार्याकार्ये विजानाति सर्वधर्मेषु निष्ठितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003481003, "chapter_id": 23481, "verse_number": "१२१-४", "content_sanskrit": "शीतोष्णवातवर्षादिक्षुत्पिपासासहश्च यः ।\nयो दरिद्रो निरालस्यः सत्यवागनसूयकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003481004, "chapter_id": 23481, "verse_number": "१२१-५", "content_sanskrit": "स्वदारनिरतो नित्यं परदारविवर्जकः ।\nसत्यवादी विशुद्धात्मा नित्यं च भगवत्प्रियः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003481005, "chapter_id": 23481, "verse_number": "१२१-६", "content_sanskrit": "संविभाज्य विशेषज्ञो नित्यं ब्राह्मणवत्सलः ।\nप्रियभाषी द्विजानां च मम कर्मपरायणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003481006, "chapter_id": 23481, "verse_number": "१२१-७", "content_sanskrit": "कुयोनिं तु न गच्छेत मम लोकं स गच्छति ।\nअन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003481007, "chapter_id": 23481, "verse_number": "१२१-८", "content_sanskrit": "यो वियोनिं न गच्छेत मम कर्मपरायणः ।\nजीवहिंसानिवृत्तस्तु सर्वभूतहितः शुचिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003481008, "chapter_id": 23481, "verse_number": "१२१-९", "content_sanskrit": "सर्वत्र समतायुक्तः समलोष्ठाश्मकांचनः ।\nबाल्ये स्थितोऽपि वयसि क्षान्तो दान्तः शुभे रतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003481009, "chapter_id": 23481, "verse_number": "१२१-१०", "content_sanskrit": "नित्यं नैव विजानाति परेणापकृतं क्वचित् ।\nकर्त्तव्यं संस्मरेत्सर्वं मम सत्यं च जल्पति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003481010, "chapter_id": 23481, "verse_number": "१२१-११", "content_sanskrit": "व्यलीकाद्विनिवृत्तो यस्तथ्येतिकृतनिश्चयः ।\nनित्यं च वृत्तिमान्कश्चित्परोक्षेऽपि न चाक्षिपेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003481011, "chapter_id": 23481, "verse_number": "१२१-१२", "content_sanskrit": "ऋतुकालेऽपि गच्छेद्यः अपत्यार्थे स्वकां स्त्रियम् ।\nईदृशास्तु नरा भद्रे मम कर्मपरायणाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003481012, "chapter_id": 23481, "verse_number": "१२१-१३", "content_sanskrit": "ते वियोनिं न गच्छन्ति मम गच्छन्ति सुन्दरि ।\nपुनरन्यत्प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003481013, "chapter_id": 23481, "verse_number": "१२१-१४", "content_sanskrit": "पुरुषाणां प्रसन्नानां यश्च धर्मः सनातनः ।\nमनुनाप्यन्यथा दृष्टो ह्यन्यथांगिरसेन च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003481014, "chapter_id": 23481, "verse_number": "१२१-१५", "content_sanskrit": "शुक्रेण चान्यथा दृष्टो गौतमेनापि चान्यथा ।\nसोमेन चान्यथा दृष्टो रुद्रेणाप्यन्यथा पुनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003481015, "chapter_id": 23481, "verse_number": "१२१-१६", "content_sanskrit": "शङ्खेन चान्यथा दृष्टो लिखितेनापि चान्यथा ।\nकश्यपेनान्यथा दृष्टो धर्मेणाप्यन्यथा धरे॥।३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003481016, "chapter_id": 23481, "verse_number": "१२१-१७", "content_sanskrit": "अग्निना वायुना चैव दृष्टो धर्मोऽन्यथा धरे ।\nयमेन चान्यथा दृष्ट इन्द्रेण वरुणेन च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003481017, "chapter_id": 23481, "verse_number": "१२१-१८", "content_sanskrit": "कुबेरेणान्यथा दृष्टः शाण्डिल्येनापि चान्यथा ।\nपुलस्त्येनान्यथा दृष्ट आदित्येनापि चान्यथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003481018, "chapter_id": 23481, "verse_number": "१२१-१९", "content_sanskrit": "पितृभिश्चान्यथा दृष्टो ह्यन्यथापि स्वयम्भुवा ।\nआत्मनात्मनि धर्मेण ये नरा निश्चितव्रताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003481019, "chapter_id": 23481, "verse_number": "१२१-२०", "content_sanskrit": "स्वकं पालयते धर्मं स्वमतेनैव भाषितम् ।\nपरवादं न कुर्वीत सर्वधर्मेषु निश्चितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003481020, "chapter_id": 23481, "verse_number": "१२१-२१", "content_sanskrit": "न निन्देद्धर्मकार्याणि आत्मधर्मपथे स्थितः ।\nएभिर्गुणैः समायुक्तो मम कर्माणि कारयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003481021, "chapter_id": 23481, "verse_number": "१२१-२२", "content_sanskrit": "वियोनिं स न गच्छेत मम लोकाय गच्छति ।\nपुनरन्यत्तु वक्ष्यामि तच्छृणुष्वेह माधवि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003481022, "chapter_id": 23481, "verse_number": "१२१-२३", "content_sanskrit": "तरन्ति पुरुषा येन गर्भसंसारसागरम् ।\nजितेन्द्रिया जितक्रोधा लोभमोहविवर्जिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003481023, "chapter_id": 23481, "verse_number": "१२१-२४", "content_sanskrit": "आत्मोपकारका नित्यं देवातिथिगुरुप्रियाः ।\nहिंसादीनि न कुर्वन्ति मधुमांसविवर्जकाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003481024, "chapter_id": 23481, "verse_number": "१२१-२५", "content_sanskrit": "मनसा ब्राह्मणीं चैव यो गच्छेन्न कदाचन ।\nविप्राय कपिलां दद्याद्वृद्वं सान्त्वेन पालयेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003481025, "chapter_id": 23481, "verse_number": "१२१-२६", "content_sanskrit": "सर्वेषां चैव पुत्राणां न विशेषं करोति यः ।\nसंक्रुद्धं ब्राह्मणं दृष्ट्वा यस्तु तत्र प्रसादयेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003481026, "chapter_id": 23481, "verse_number": "१२१-२७", "content_sanskrit": "यः स्पृशेत्कपिलां भक्त्या कुमारीं न च दूषयेत् ।\nअग्निं न च क्रमेत्पद्भ्यां न च पुत्रेण भाषयेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003481027, "chapter_id": 23481, "verse_number": "१२१-२८", "content_sanskrit": "जलेन मेहयेद्यस्तु गुरुभक्तो न जल्पकः ।\nएवं धर्मेण संयुक्तो यो नु मां प्रतिपद्यते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003481028, "chapter_id": 23481, "verse_number": "१२१-२९", "content_sanskrit": "स च गर्भं न गच्छेत मम लोकं स गच्छति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]