[{"id": 5000406000, "chapter_id": 9406, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे सप्तषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000406001, "chapter_id": 9406, "verse_number": "५-६७-१", "content_sanskrit": "एवमुक्तस्तु हनुमान् राघवेण महात्मना।\nसीताया भाषितं सर्वं न्यवेदयत राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000406002, "chapter_id": 9406, "verse_number": "५-६७-२", "content_sanskrit": "इदमुक्तवती देवी जानकी पुरुषर्षभ।\nपूर्ववृत्तमभिज्ञानं चित्रकूटे यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000406003, "chapter_id": 9406, "verse_number": "५-६७-३", "content_sanskrit": "सुखसुप्ता त्वया सार्धं जानकी पूर्वमुत्थिता।\nवायसः सहसोत्पत्य विददार स्तनान्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000406004, "chapter_id": 9406, "verse_number": "५-६७-४", "content_sanskrit": "पर्यायेण च सुप्तस्त्वं देव्यङ्के भरताग्रज।\nपुनश्च किल पक्षी स देव्या जनयति व्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000406005, "chapter_id": 9406, "verse_number": "५-६७-५", "content_sanskrit": "ततः पुनरुपागम्य विददार भृशं किल।\nततस्त्वं बोधितस्तस्याः शोणितेन समुक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000406006, "chapter_id": 9406, "verse_number": "५-६७-६", "content_sanskrit": "वायसेन च तेनैवं सततं बाध्यमानया।\nबोधितः किल देव्या त्वं सुखसुप्तः परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000406007, "chapter_id": 9406, "verse_number": "५-६७-७", "content_sanskrit": "तां च दृष्ट्वा महाबाहो दारितां च स्तनान्तरे।\nआशीविष इव क्रुद्धस्ततो वाक्यं त्वमूचिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000406008, "chapter_id": 9406, "verse_number": "५-६७-८", "content_sanskrit": "नखाग्रैः केन ते भीरु दारितं वै स्तनान्तरम्।\nकः क्रीडति सरोषेण पञ्चवक्त्रेण भोगिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000406009, "chapter_id": 9406, "verse_number": "५-६७-९", "content_sanskrit": "निरीक्षमाणः सहसा वायसं समुदैक्षथाः।\nनखैः सरुधिरैस्तीक्ष्णैस्तामेवाभिमुखं स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000406010, "chapter_id": 9406, "verse_number": "५-६७-१०", "content_sanskrit": "सुतः किल स शक्रस्य वायसः पततां वरः।\nधरान्तरगतः शीघ्रं पवनस्य गतौ समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000406011, "chapter_id": 9406, "verse_number": "५-६७-११", "content_sanskrit": "ततस्तस्मिन् महाबाहो कोपसंवर्तितेक्षणः।\nवायसे त्वं व्यधाः क्रूरां मतिं मतिमतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000406012, "chapter_id": 9406, "verse_number": "५-६७-१२", "content_sanskrit": "स दर्भसंस्तराद् गृह्य ब्रह्मास्त्रेण न्ययोजयः।\nस दीप्त इव कालाग्निर्जज्वालाभिमुखं खगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000406013, "chapter_id": 9406, "verse_number": "५-६७-१३", "content_sanskrit": "स त्वं प्रदीप्तं चिक्षेप दर्भं तं वायसं प्रति।\nततस्तु वायसं दीप्तः स दर्भोऽनुजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000406014, "chapter_id": 9406, "verse_number": "५-६७-१४", "content_sanskrit": "भीतैश्च सम्परित्यक्तः सुरैः सर्वैश्च वायसः।\nत्रीँल्लोकान् सम्परिक्रम्य त्रातारं नाधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000406015, "chapter_id": 9406, "verse_number": "५-६७-१५", "content_sanskrit": "पुनरप्यागतस्तत्र त्वत्सकाशमरिंदम।\nत्वं तं निपतितं भूमौ शरण्यः शरणागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000406016, "chapter_id": 9406, "verse_number": "५-६७-१६", "content_sanskrit": "वधार्हमपि काकुत्स्थ कृपया परिपालयः।\nमोघमस्त्रं न शक्यं तु कर्तुमित्येव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000406017, "chapter_id": 9406, "verse_number": "५-६७-१७", "content_sanskrit": "भवांस्तस्याक्षि काकस्य हिनस्ति स्म स दक्षिणम्।\nराम त्वां स नमस्कृत्य राज्ञो दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000406018, "chapter_id": 9406, "verse_number": "५-६७-१८", "content_sanskrit": "विसृष्टस्तु तदा काकः प्रतिपेदे स्वमालयम्।\nएवमस्त्रविदां श्रेष्ठः सत्त्ववाञ्छीलवानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000406019, "chapter_id": 9406, "verse_number": "५-६७-१९", "content_sanskrit": "किमर्थमस्त्रं रक्षःसु न योजयसि राघव।\nन दानवा न गन्धर्वा नासुरा न मरुद‍्गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000406020, "chapter_id": 9406, "verse_number": "५-६७-२०", "content_sanskrit": "तव राम रणे शक्तास्तथा प्रतिसमासितुम्।\nतव वीर्यवतः कश्चिन्मयि यद्यस्ति सम्भ्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000406021, "chapter_id": 9406, "verse_number": "५-६७-२१", "content_sanskrit": "क्षिप्रं सुनिशितैर्बाणैर्हन्यतां युधि रावणः।\nभ्रातुरादेशमाज्ञाय लक्ष्मणो वा परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000406022, "chapter_id": 9406, "verse_number": "५-६७-२२", "content_sanskrit": "स किमर्थं नरवरो न मां रक्षति राघवः।\nशक्तौ तौ पुरुषव्याघ्रौ वाय्वग्निसमतेजसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000406023, "chapter_id": 9406, "verse_number": "५-६७-२३", "content_sanskrit": "सुराणामपि दुर्धर्षौ किमर्थं मामुपेक्षतः।\nममैव दुष्कृतं किंचिन्महदस्ति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000406024, "chapter_id": 9406, "verse_number": "५-६७-२४", "content_sanskrit": "समर्थौ सहितौ यन्मां न रक्षेते परंतपौ।\nवैदेह्या वचनं श्रुत्वा करुणं साधुभाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000406025, "chapter_id": 9406, "verse_number": "५-६७-२५", "content_sanskrit": "पुनरप्यहमार्यां तामिदं वचनमब्रुवम्।\nत्वच्छोकविमुखो रामो देवि सत्येन ते शपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000406026, "chapter_id": 9406, "verse_number": "५-६७-२६", "content_sanskrit": "रामे दुःखाभिभूते च लक्ष्मणः परितप्यते।\nकथंचिद् भवती दृष्टा न कालः परिशोचितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000406027, "chapter_id": 9406, "verse_number": "५-६७-२७", "content_sanskrit": "अस्मिन् मुहूर्ते दुःखानामन्तं द्रक्ष्यसि भामिनि।\nतावुभौ नरशार्दूलौ राजपुत्रौ परंतपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000406028, "chapter_id": 9406, "verse_number": "५-६७-२८", "content_sanskrit": "त्वद्दर्शनकृतोत्साहौ लङ्कां भस्मीकरिष्यतः।\nहत्वा च समरे रौद्रं रावणं सहबान्धवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000406029, "chapter_id": 9406, "verse_number": "५-६७-२९", "content_sanskrit": "राघवस्त्वां वरारोहे स्वपुरीं नयिता ध्रुवम्।\nयत् तु रामो विजानीयादभिज्ञानमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000406030, "chapter_id": 9406, "verse_number": "५-६७-३०", "content_sanskrit": "प्रीतिसंजननं तस्य प्रदातुं तत् त्वमर्हसि।\nसाभिवीक्ष्य दिशः सर्वा वेण्युद्‍ग्रथनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000406031, "chapter_id": 9406, "verse_number": "५-६७-३१", "content_sanskrit": "मुक्त्वा वस्त्राद् ददौ मह्यं मणिमेतं महाबल।\nप्रतिगृह्य मणिं दोर्भ्यां तव हेतो रघुप्रिय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000406032, "chapter_id": 9406, "verse_number": "५-६७-३२", "content_sanskrit": "शिरसा सम्प्रणम्यैनामहमागमने त्वरे।\nगमने च कृतोत्साहमवेक्ष्य वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000406033, "chapter_id": 9406, "verse_number": "५-६७-३३", "content_sanskrit": "विवर्धमानं च हि मामुवाच जनकात्मजा।\nअश्रुपूर्णमुखी दीना बाष्पगद‍्गदभाषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000406034, "chapter_id": 9406, "verse_number": "५-६७-३४", "content_sanskrit": "ममोत्पतनसम्भ्रान्ता शोकवेगसमाहता।\nमामुवाच ततः सीता सभाग्योऽसि महाकपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000406035, "chapter_id": 9406, "verse_number": "५-६७-३५", "content_sanskrit": "यद् द्रक्ष्यसि महाबाहुं रामं कमललोचनम्।\nलक्ष्मणं च महाबाहुं देवरं मे यशस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000406036, "chapter_id": 9406, "verse_number": "५-६७-३६", "content_sanskrit": "सीतयाप्येवमुक्तोऽहमब्रुवं मैथिलीं तथा।\nपृष्ठमारोह मे देवि क्षिप्रं जनकनन्दनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000406037, "chapter_id": 9406, "verse_number": "५-६७-३७", "content_sanskrit": "यावत्ते दर्शयाम्यद्य ससुग्रीवं सलक्ष्मणम्।\nराघवं च महाभागे भर्तारमसितेक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000406038, "chapter_id": 9406, "verse_number": "५-६७-३८", "content_sanskrit": "साब्रवीन्मां ततो देवी नैष धर्मो महाकपे।\nयत्ते पृष्ठं सिषेवेऽहं स्ववशा हरिपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000406039, "chapter_id": 9406, "verse_number": "५-६७-३९", "content_sanskrit": "पुरा च यदहं वीर स्पृष्टा गात्रेषु रक्षसा।\nतत्राहं किं करिष्यामि कालेनोपनिपीडिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000406040, "chapter_id": 9406, "verse_number": "५-६७-४०", "content_sanskrit": "गच्छ त्वं कपिशार्दूल यत्र तौ नृपतेः सुतौ।\nइत्येवं सा समाभाष्य भूयः संदेष्टुमास्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000406041, "chapter_id": 9406, "verse_number": "५-६७-४१", "content_sanskrit": "हनूमन् सिंहसंकाशौ तावुभौ रामलक्ष्मणौ।\nसुग्रीवं च सहामात्यं सर्वान् ब्रूया अनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000406042, "chapter_id": 9406, "verse_number": "५-६७-४२", "content_sanskrit": "यथा च स महाबाहुर्मां तारयति राघवः।\nअस्माद्दुःखाम्बुसंरोधात् तत् त्वमाख्यातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000406043, "chapter_id": 9406, "verse_number": "५-६७-४३", "content_sanskrit": "इदं च तीव्रं मम शोकवेगं\nरक्षोभिरेभिः परिभर्त्सनं च।\nब्रूयास्तु रामस्य गतः समीपं\nशिवश्च तेऽध्वास्तु हरिप्रवीर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000406044, "chapter_id": 9406, "verse_number": "५-६७-४४", "content_sanskrit": "एतत् तवार्या नृप संयता सा\nसीता वचः प्राह विषादपूर्वम्।\nएतच्च बुद्‍ध्वा गदितं यथा त्वं\nश्रद्धत्स्व सीतां कुशलां समग्राम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000406045, "chapter_id": 9406, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे सप्तषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]