[{"id": 40022712, "chapter_id": 9406, "verse_number": "1", "content_sanskrit": "तच्छ्रुत्वा लक्ष्मणेनोक्तं वाक्यं वाक्यविशारदः । प्रत्युवाच महातेजाः प्रहसन्राघवो वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022713, "chapter_id": 9406, "verse_number": "2", "content_sanskrit": "एवमेव नरश्रेष्ठ यथा वदसि लक्ष्मण । वृत्रघातमशेषेण वाजिमेधफलं च यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022714, "chapter_id": 9406, "verse_number": "3", "content_sanskrit": "श्रूयते हि पुरा सौम्य कर्दमस्य प्रजापतेः । पुत्रो बाह्लीश्वरः श्रीमानिलो नाम महाशयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022715, "chapter_id": 9406, "verse_number": "4", "content_sanskrit": "स राजा पृथिवीं सर्वां वशे कृत्वा सुधार्मिकः । राज्यं चैव नरव्याघ्र पुत्रवत्पर्यपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022716, "chapter_id": 9406, "verse_number": "5", "content_sanskrit": "सुरैश्च परमोदारैर्दैतेयैश्च महाधनैः । नागराक्षसगन्धर्वैर्यक्षैश्च सुमहात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022717, "chapter_id": 9406, "verse_number": "6", "content_sanskrit": "पूज्यते नित्यशः सौम्य भयार्तै रघुनन्दन । अबिभ्यंश्च त्रयो लोकाः सरोषस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022718, "chapter_id": 9406, "verse_number": "7", "content_sanskrit": "स राजा तादृशो ह्यासीद्धर्मे वीर्ये च निष्ठितः । बुद्ध्या च परमोदारो बाह्लीकेशो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022719, "chapter_id": 9406, "verse_number": "8", "content_sanskrit": "स प्रचक्रे महाबाहुर्मृगयां रुचिरे वने । चैत्रे मनोरमे मासि सभृत्यबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022720, "chapter_id": 9406, "verse_number": "9", "content_sanskrit": "प्रजघ्ने च नृपो ऽरण्ये मृगाञ्छतसहस्रशः । हत्वैव तृप्तिर्नाभूच्च राज्ञस्तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022721, "chapter_id": 9406, "verse_number": "10", "content_sanskrit": "नानामृगाणामयुतं वध्यमानं महात्मना । यत्र जातो माहासेनस्तं देशमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022722, "chapter_id": 9406, "verse_number": "11", "content_sanskrit": "तस्मिन्प्रदेशे देवेश शैलराजसुतां हरः । रमयामास दुर्धर्षः सर्वैरनुचरैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022723, "chapter_id": 9406, "verse_number": "12", "content_sanskrit": "कृत्वा स्त्रीरूपमात्मानमुमेशो गोपतिध्वजः । देव्याः प्रियचिकीर्षुः संस्तस्मिन्पर्वतनिर्झरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022724, "chapter_id": 9406, "verse_number": "13", "content_sanskrit": "ये तु तत्र वनोद्देशे सत्त्वाः पुरुषवादिनः । वृक्षाः पुरुषनामानस्ते ऽभवन् स्त्रीजनास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022725, "chapter_id": 9406, "verse_number": "14", "content_sanskrit": "यच्च किञ्चन तत्सर्वं नारीसञ्ज्ञं बभूव ह । एतस्मिन्नन्तरे राजा स इलः कर्दमात्मजः । निघ्नन्मृगसहस्राणि तं देशमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022726, "chapter_id": 9406, "verse_number": "15", "content_sanskrit": "स दृष्ट्वा स्त्रीकृतं सर्वं सव्यालमृगपक्षकम् । आत्मनं स्त्रीकृतं चैव सानुगं रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022727, "chapter_id": 9406, "verse_number": "16", "content_sanskrit": "तस्य दुःखं महच्चासीद्दृष्ट्वा ऽ ऽत्मानं तथागतम् । उमापतेश्च तत्कर्म ज्ञात्वा त्रासमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022728, "chapter_id": 9406, "verse_number": "17", "content_sanskrit": "ततो देवं महात्मानं शितिकण्ठं कपर्दिनम् । जगाम शरणं राजा सभृत्यबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022729, "chapter_id": 9406, "verse_number": "18", "content_sanskrit": "ततः प्रहस्य वरदः सह देव्या महेश्वरः । प्रजापतिसुतं वाक्यमुवाच वरदः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022730, "chapter_id": 9406, "verse_number": "19", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ राजर्षे कार्दमेय महाबल । पुरुषत्वमृते सौम्य वरं वरय सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022731, "chapter_id": 9406, "verse_number": "20", "content_sanskrit": "ततः स राजा दुःखार्तः प्रत्याख्यातो महात्मना । न च जग्राह स्त्रीभूतो वरमन्यं सुरोत्तमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022732, "chapter_id": 9406, "verse_number": "21", "content_sanskrit": "ततः शोकेन महता शैलराजसुतां नृपः । प्रणिपत्य ह्युमां देवीं सर्वेणैवान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022733, "chapter_id": 9406, "verse_number": "22", "content_sanskrit": "ईशे वराणां वरदे लोकानामसि भामिनी । अमोघदर्शने देवी भज सौम्येन चक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022734, "chapter_id": 9406, "verse_number": "23", "content_sanskrit": "हृद्गतं तस्य राजर्षेर्विज्ञाय हरसन्निधौ । प्रत्युवाच शुभं वाक्यं देवी रुद्रस्य संमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022735, "chapter_id": 9406, "verse_number": "24", "content_sanskrit": "अर्धस्य देवो वरदो वरार्धस्य तव ह्यहम् । तस्मादर्धं गृहाण त्वं स्त्रीपुंसोर्यावदिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022736, "chapter_id": 9406, "verse_number": "25", "content_sanskrit": "तदद्भुततरं श्रुत्वा देव्या वरमनुत्तमम् । सम्प्रहृष्टमना भूत्वा राजा वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40022737, "chapter_id": 9406, "verse_number": "26", "content_sanskrit": "यदि देवि प्रसन्ना मे रूपेणाप्रतिमा भुवि । मासं स्त्रीत्वमुपासित्वा मासं स्यां पुरुषः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40022738, "chapter_id": 9406, "verse_number": "27", "content_sanskrit": "ईप्सितं तस्य विज्ञाय देवी सुरुचिरानना । प्रत्युवाच शुभं वाक्यमेवमेव भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40022739, "chapter_id": 9406, "verse_number": "28", "content_sanskrit": "राजन्पुरुषभूतस्त्वं स्त्रीभावं न स्मरिष्यसि । स्त्रीभूतश्च परं मासं न स्मरिष्यसि पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40022740, "chapter_id": 9406, "verse_number": "29", "content_sanskrit": "एवं स राजा पुरुषो मासं भूत्वाथ कार्दमिः । त्रैलोक्यसुन्दरी नारी मासमेकमिला ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]