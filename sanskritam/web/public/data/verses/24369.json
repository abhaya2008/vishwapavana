[{"id": 7004369000, "chapter_id": 24369, "verse_number": "५-३-६३-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेत्तु राजेन्द्र कुमारेश्वरमुत्तमम् ।\nप्रसिद्धं सर्वतीर्थानामगस्त्येश्वरसन्निधौ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004369001, "chapter_id": 24369, "verse_number": "५-३-६३-२", "content_sanskrit": "षण्मुखेन पुरा तात सर्वपातकनाशनम् ।\nआराध्य परया भक्त्या सिद्धिः प्राप्ता नराधिप॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004369002, "chapter_id": 24369, "verse_number": "५-३-६३-३", "content_sanskrit": "देवसैन्याधिपो जातः सर्वशत्रुनिबर्हणः ।\nउग्रतेजा महात्मासौ संजातस्तीर्थसेवनात्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004369003, "chapter_id": 24369, "verse_number": "५-३-६३-४", "content_sanskrit": "तदाप्रभृति तत्तीर्थं संजातंनर्मदातटे ।\nतत्र तीर्थे तु यो गत्वा एकचित्तो जितेन्द्रियः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004369004, "chapter_id": 24369, "verse_number": "५-३-६३-५", "content_sanskrit": "कार्त्तिकस्य चतुर्दश्यामष्टम्यां च विशेषतः ।\nस्नापयेद्गिरिजानाथं दधिदुग्धेन सर्पिषा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004369005, "chapter_id": 24369, "verse_number": "५-३-६३-६", "content_sanskrit": "गीतं तत्र प्रकर्तव्यं पिण्डदानं यथाविधि ।\nब्राह्मणैः श्रोत्रियैः पार्थ षट्कर्मनिरतैः शुभैः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004369006, "chapter_id": 24369, "verse_number": "५-३-६३-७", "content_sanskrit": "यत्किंचिद्दीयते तत्र अक्षयं पाण्डुनन्दन ।\nसर्वतीर्थमयं तीर्थ निर्मितं शिखिना नृप॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004369007, "chapter_id": 24369, "verse_number": "५-३-६३-८", "content_sanskrit": "एतत्ते सर्वमाख्यातं कुमारेश्वरजं फलम् ।\nकुमारदर्शनात्पुण्यं प्राप्यते पाण्डुनन्दन॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004369008, "chapter_id": 24369, "verse_number": "५-३-६३-९", "content_sanskrit": "मृतः स्वर्गमवाप्नोति सत्यमीश्वरभाषितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]