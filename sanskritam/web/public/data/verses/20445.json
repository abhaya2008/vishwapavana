[{"id": 7000445000, "chapter_id": 20445, "verse_number": "२-११७-१", "content_sanskrit": "कुंजल उवाच ।\nनहुषः प्रियया सार्द्धं तया चैव सरंभया ।\nऐंद्रेणापि स दिव्येन स्यंदनेन वरेण च॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000445001, "chapter_id": 20445, "verse_number": "२-११७-२", "content_sanskrit": "नागाह्वयं पुरं प्राप्तः सर्वशोभासमन्वितम् ।\nदिव्यैर्मंगलकैर्युक्तं भवनैरुपशोभितम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000445002, "chapter_id": 20445, "verse_number": "२-११७-३", "content_sanskrit": "हेमतोरणसंयुक्तं पताकाभिरलंकृतम् ।\nनानावादित्रनादैश्च बंदिचारणशोभितम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000445003, "chapter_id": 20445, "verse_number": "२-११७-४", "content_sanskrit": "देवरूपोपमैः पुण्यैः पुरुषैः समलंकृतम् ।\nनारीभिर्दिव्यरूपाभिर्गजाश्वैः स्यंदनैस्तथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000445004, "chapter_id": 20445, "verse_number": "२-११७-५", "content_sanskrit": "नानामंगलशब्दैश्च वेदध्वनिसमाकुलम् ।\nगीतवादित्रशब्दैश्च वीणावेणुस्वनैस्ततः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000445005, "chapter_id": 20445, "verse_number": "२-११७-६", "content_sanskrit": "सर्वशोभासमाकीर्णं विवेश स पुरोत्तमम् ।\nवेदमंगलघोषैश्च ब्राह्मणैश्चैव पूजितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000445006, "chapter_id": 20445, "verse_number": "२-११७-७", "content_sanskrit": "ददृशे पितरं वीरो मातरं च सुपुण्यकाम् ।\nहर्षेण महताविष्टः पितुः पादौ ननाम सः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000445007, "chapter_id": 20445, "verse_number": "२-११७-८", "content_sanskrit": "अशोकसुंदरी सा तु तयोः पादौ पुनः पुनः ।\nननाम भक्त्या भावेन उभयोः सा वरानना॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000445008, "chapter_id": 20445, "verse_number": "२-११७-९", "content_sanskrit": "रंभा च सा ननामाथ प्रीतिं चैवाप्यदर्शयत् ।\nनमस्कृत्वा समाभाष्य स्वगुरुं नृपनंदनः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000445009, "chapter_id": 20445, "verse_number": "२-११७-१०", "content_sanskrit": "अनामयं च पप्रच्छ मातरं पितरं प्रति ।\nएवमुक्तो महाभागः सानंदपुलकोद्गमः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000445010, "chapter_id": 20445, "verse_number": "२-११७-११", "content_sanskrit": "आयुरुवाच ।\nअद्यैव व्याधयो नष्टा दुःखशोकावुभौ गतौ ।\nभवतो दर्शनात्पुत्र सुतुष्ट्या हृष्यते जगत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000445011, "chapter_id": 20445, "verse_number": "२-११७-१२", "content_sanskrit": "कृतकृत्योस्मि संजातस्त्वयि जाते महौजसि ।\nस्ववंशोद्धरणं कृत्वा अहमेव समुद्धृतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000445012, "chapter_id": 20445, "verse_number": "२-११७-१३", "content_sanskrit": "इंदुमत्युवाच ।\nपर्वणि प्राप्य इंदोस्तु तेजो दृष्ट्वा महोदधिः ।\nवृद्धिं याति महाभाग तथाहं तव दर्शनात्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000445013, "chapter_id": 20445, "verse_number": "२-११७-१४", "content_sanskrit": "वर्द्धितास्मि सुहृष्टास्मि आनंदेन समाकुला ।\nदर्शनात्ते महाप्राज्ञ धन्या जातास्मि मानद॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000445014, "chapter_id": 20445, "verse_number": "२-११७-१५", "content_sanskrit": "एवं संभाष्य तं पुत्रमालिंग्य तनयोत्तमम् ।\nशिरश्चाघ्राय तस्यापि वत्सं धेनुर्यथा स्वकम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000445015, "chapter_id": 20445, "verse_number": "२-११७-१६", "content_sanskrit": "अभिनंद्य सुतं प्राप्तं नहुषं देवरूपिणम् ।\nआशीर्भिश्चार्चयद्देवी पुण्या इंदुमती तदा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000445016, "chapter_id": 20445, "verse_number": "२-११७-१७", "content_sanskrit": "सूत उवाच ।\nअथासौ मातरं पुण्यां देवीमिंदुमतीं सुतः ।\nकथयामास वृत्तांतं यथाहरणमात्मनः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000445017, "chapter_id": 20445, "verse_number": "२-११७-१८", "content_sanskrit": "स्वभार्यायास्तथोत्पत्तिं प्राप्तिं चैव महायशाः ।\nहुंडेनापि यथा युद्धं हुंडस्यापि निपातनम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000445018, "chapter_id": 20445, "verse_number": "२-११७-१९", "content_sanskrit": "समासेन समस्तं तदाख्यातं स्वयमेव हि ।\nमातापित्रोर्यथा वृत्तं तयोरानंददायकम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000445019, "chapter_id": 20445, "verse_number": "२-११७-२०", "content_sanskrit": "मातापितरावाकर्ण्य पुत्रस्य विक्रमोद्यमम् ।\nहर्षेण महताविष्टौ संजातौ पूर्णमानसौ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000445020, "chapter_id": 20445, "verse_number": "२-११७-२१", "content_sanskrit": "नहुषो धनुरादाय इंद्रस्य स्यंदनेन वै ।\nजिगाय पृथिवीं सर्वां सप्तद्वीपां सपत्तनाम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000445021, "chapter_id": 20445, "verse_number": "२-११७-२२", "content_sanskrit": "पित्रे समर्पयामास वसुपूर्णां वसुंधराम् ।\nपितरं हर्षयन्नित्यं दानधर्मैः सुकर्मभिः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000445022, "chapter_id": 20445, "verse_number": "२-११७-२३", "content_sanskrit": "पितरं याजयामास राजसूयादिभिस्तदा ।\nमहायज्ञैश्च दानैश्च व्रतैर्नियमसंयमैः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000445023, "chapter_id": 20445, "verse_number": "२-११७-२४", "content_sanskrit": "सुदानैर्यशसा पुण्यैर्यज्ञैः पुण्यमहोदयैः ।\nसुसंपूर्णौ कृतौ तौ तु पितरौ चायुसूनुना॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000445024, "chapter_id": 20445, "verse_number": "२-११७-२५", "content_sanskrit": "अथ देवाः समागत्य नागाह्वयं पुरोत्तमम् ।\nअभ्यषिंचन्महात्मानं नहुषं वीरमर्दनम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000445025, "chapter_id": 20445, "verse_number": "२-११७-२६", "content_sanskrit": "मुनिभिश्च सुसिद्धैश्च आयुना तेन भूभुजा ।\nअभिषिंच्य स्वराज्ये तं समेतं शिवकन्यया॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000445026, "chapter_id": 20445, "verse_number": "२-११७-२७", "content_sanskrit": "भार्यायुक्तः स्वकायेन आयु राजा महायशाः ।\nदिवं जगाम धर्मात्मा देवैः सिद्धैः सुपूजितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000445027, "chapter_id": 20445, "verse_number": "२-११७-२८", "content_sanskrit": "ऐंद्रं पदं परित्यज्य ब्रह्मलोकं गतः पुनः ।\nहरलोकं जगामाथ मुनिभिर्देवपूजितः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000445028, "chapter_id": 20445, "verse_number": "२-११७-२९", "content_sanskrit": "स्वकर्मभिर्महाराजः पुत्रस्यापि सुतेजसा ।\nहरेर्लोकं गतः पुण्यैर्निवसत्येष भूपतिः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000445029, "chapter_id": 20445, "verse_number": "२-११७-३०", "content_sanskrit": "पुरुषैः पुण्यकर्माख्यैरीदृशं पुण्यमुत्तमम् ।\nजनितव्यं महाभाग किमन्यैः शोककारकैः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000445030, "chapter_id": 20445, "verse_number": "२-११७-३१", "content_sanskrit": "यथा जातः स धर्मात्मा नहुषः पितृतारकः ।\nकुलस्य धर्त्ता सर्वस्य नहुषो ज्ञानपंडितः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000445031, "chapter_id": 20445, "verse_number": "२-११७-३२", "content_sanskrit": "एतत्ते सर्वमाख्यातं चरित्रं तस्य भूपतेः ।\nअन्यत्किं ते प्रवक्ष्यामि वद पुत्र कपिंजल॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000445032, "chapter_id": 20445, "verse_number": "२-११७-३३", "content_sanskrit": "एवंविधं पुण्यमयं पवित्रं चरित्रमेतद्यशसा समेतम् ।\nआयोः सुतस्यापि शृणोति मर्त्यो भोगान्स भुक्त्वैति पदं मुरारेः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]