[{"id": 7001755000, "chapter_id": 21755, "verse_number": "२-१६-१", "content_sanskrit": "वसिष्ठ उवाच ।\nधर्मांगवदचः श्रुत्वा हृष्टो रुक्मांगदोऽब्रवीत् ।\nसत्य ते जननी पुत्र संप्राप्ता मंदरे मया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001755001, "chapter_id": 21755, "verse_number": "२-१६-२", "content_sanskrit": "वेदाश्रयसुता बाला मदर्थं कृतनिश्चया ।\nकुर्वंती दारुणं पुत्र तपो देवगिरौ पुरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001755002, "chapter_id": 21755, "verse_number": "२-१६-३", "content_sanskrit": "इतः पंचदशादह्नो हयगामी गतो ह्यहम् ।\nमंदरे पर्वतश्रेष्ठे बहुधातुसमन्विते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001755003, "chapter_id": 21755, "verse_number": "२-१६-४", "content_sanskrit": "तस्य मूर्द्धनि बालेयं तोषयंती महेश्वरम् ।\nस्थिता गानपरा दृष्टा मया तत्र सुदर्शना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001755004, "chapter_id": 21755, "verse_number": "२-१६-५", "content_sanskrit": "ततोऽहं मूर्च्छया युक्तः पतितो धरणीतले ।\nअनंगबाणसंविद्धो व्याधविद्धो यथा मृगः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001755005, "chapter_id": 21755, "verse_number": "२-१६-६", "content_sanskrit": "ततोऽहमनया देव्या चालितश्चारुनेत्रया ।\nवृतश्चैवापि भर्तृत्वे किंचित्प्रार्थनया सह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001755006, "chapter_id": 21755, "verse_number": "२-१६-७", "content_sanskrit": "मया चापि प्रतिज्ञातं स्वदक्षिणकरान्वितम् ।\nसेयं भार्या विशालाक्षी कृता भूधरमस्तके ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001755007, "chapter_id": 21755, "verse_number": "२-१६-८", "content_sanskrit": "अवरुह्य धरापृष्टे समारुह्य तुरंगमम् ।\nदिनत्रयेण त्वरितः संप्राप्तस्तव सन्निधौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001755008, "chapter_id": 21755, "verse_number": "२-१६-९", "content_sanskrit": "पश्यमानो गिरीन्देशान्सरांसिसरितस्तथा ।\nइयं हि जननी पुत्र तव प्रीतिविवर्द्धिनी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001755009, "chapter_id": 21755, "verse_number": "२-१६-१०", "content_sanskrit": "अभिवादय चार्वंगीं त्वं निजामिव मातरम् ।\nतत्पितुर्वचनं श्रुत्वा हयसंस्थामरिंदमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001755010, "chapter_id": 21755, "verse_number": "२-१६-११", "content_sanskrit": "शिरसा धरणीं गत्वा इदं वचनमब्रवीत् ।\nप्रसीद देवि मातस्त्वं भृत्यो दासः सुतस्तव ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001755011, "chapter_id": 21755, "verse_number": "२-१६-१२", "content_sanskrit": "नमस्करोमि जननीं बहुभूपालसंयुतः ।\nतं पुत्रमवनीं प्राप्तं मोहिनी प्रेक्ष्य भूपते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001755012, "chapter_id": 21755, "verse_number": "२-१६-१३", "content_sanskrit": "भर्तुर्दाक्षिण्ययोगाच्च अवतीर्य तुरंगमात् ।\nअवागूहत बाहुभ्यामुत्थाप्य पतितं सुतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001755013, "chapter_id": 21755, "verse_number": "२-१६-१४", "content_sanskrit": "परिष्वक्तस्तदा मात्रा पुनरेवाभ्यनंदयत् ।\nततस्तां सुमनोज्ञैस्तु चारुवस्त्रैस्च भूषणैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001755014, "chapter_id": 21755, "verse_number": "२-१६-१५", "content_sanskrit": "भूषयित्वा समारोप्य पुनरेव हयोत्तमम् ।\nस्वपृष्ठे चरणं कृत्वा तस्या राजीवलोचनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001755015, "chapter_id": 21755, "verse_number": "२-१६-१६", "content_sanskrit": "तेनैव विधिना भूप पितरं चान्वरोहयत् ।\nभूपालैः संवृतो गच्छन्पभ्द्यां धर्मांगदः सुतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001755016, "chapter_id": 21755, "verse_number": "२-१६-१७", "content_sanskrit": "प्रहर्षपुलको ह्यासीज्जननीं प्रेक्ष्य मोहिनीम् ।\nस्तूयमानः स्वयं चापि मेघगंभीरया गिरा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001755017, "chapter_id": 21755, "verse_number": "२-१६-१८", "content_sanskrit": "धन्यः स तनयो लोके मातरो यस्य भूरिशः ।\nनवा नवतरा भार्याः पितुरिष्टा मनोहराः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001755018, "chapter_id": 21755, "verse_number": "२-१६-१९", "content_sanskrit": "यस्यैका जननी लोके पिता तस्यैव दुःखभाक् ।\nपितुर्दुःखेन किं सौख्यं पुत्रस्य हृदि वर्तते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001755019, "chapter_id": 21755, "verse_number": "२-१६-२०", "content_sanskrit": "एकस्या वंदने मातुः पृथिवीफलमश्नुते ।\nमातॄणां वंदने मह्यं महत्पुण्यं भविष्यति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001755020, "chapter_id": 21755, "verse_number": "२-१६-२१", "content_sanskrit": "तस्मादभ्यधिकं पुण्यं भविष्यति दिने दिने ।\nएकमुच्चरमाणोऽसौ राजभिः परिवारितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001755021, "chapter_id": 21755, "verse_number": "२-१६-२२", "content_sanskrit": "प्रविष्टो नगरं रम्यं वैदिशं ऋद्धिसंयुतम् ।\nहयस्थः प्रययौ राजा मोहिन्या सह तत्क्षणात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001755022, "chapter_id": 21755, "verse_number": "२-१६-२३", "content_sanskrit": "ततो गृहवरं प्राप्य पूज्यमानो जनैर्नृपः ।\nअवरुह्य हयातस्मान्‌मोहिनीं वाक्यमब्रवीत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001755023, "chapter_id": 21755, "verse_number": "२-१६-२४", "content_sanskrit": "धर्मांगदस्य पुत्रस्य गृहे गच्छ मनोहरे ।\nएष ते गुरुशुश्रूषां करिष्यति यथा गुणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001755024, "chapter_id": 21755, "verse_number": "२-१६-२५", "content_sanskrit": "न सखी नैव दासी ते शुश्रूषामाचरेदिति ।\nसा चैवमुक्ता पत्या तु प्रस्थिता सुतमन्दिरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001755025, "chapter_id": 21755, "verse_number": "२-१६-२६", "content_sanskrit": "धर्मांगदेन सा दृष्टा गच्छंती मन्दिराय वै ।\nआत्मनो भर्तृवाक्येन परित्यज्य महीपतीन् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001755026, "chapter_id": 21755, "verse_number": "२-१६-२७", "content_sanskrit": "तिष्ठध्वं पितुरादेशादिमां शुश्रूषये ह्यहम् ।\nस एवमुक्त्वा गत्वा तु बाहुभ्यां परिगृह्य वै ।\nक्रमे पञ्चदशे प्राप्ते पर्यंके त्ववरोपयत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001755027, "chapter_id": 21755, "verse_number": "२-१६-२८", "content_sanskrit": "कांचने पट्टसूत्रेण रचिते कोमले दृढे ।\nमृद्वास्तरणसंयुक्ते मणिरत्नविभूषिते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001755028, "chapter_id": 21755, "verse_number": "२-१६-२९", "content_sanskrit": "रत्नदीपैश्च बहुशः खचिते सूर्यसप्रभे ।\nततः पादोदकं चक्रे मोहिन्या धर्मभूषणः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001755029, "chapter_id": 21755, "verse_number": "२-१६-३०", "content_sanskrit": "सन्ध्यावल्या गुरुत्वेन ह्यपश्यत्तां नृपात्मजः ।\nनैवमस्याभवद्दुष्टं मनस्तां मोहिनीं प्रति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001755030, "chapter_id": 21755, "verse_number": "२-१६-३१", "content_sanskrit": "सुकुमारोऽपि तन्वंगीं पीनोरुजघनस्तनीम् ।\nमेने वर्षायुतसमामात्मानं च त्रिवत्सरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001755031, "chapter_id": 21755, "verse_number": "२-१६-३२", "content_sanskrit": "प्रक्षाल्य चरणौ तस्यास्तज्जलं शिरसि न्यधात् ।\nउवाचावनतो भूत्वा सुकृती मातरस्म्यहम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001755032, "chapter_id": 21755, "verse_number": "२-१६-३३", "content_sanskrit": "इत्युक्त्वा नरनारीभिः स्वयं च श्रमनाशनम् ।\nचकार सर्वभोगैस्तां युयोज च मुदान्वितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001755033, "chapter_id": 21755, "verse_number": "२-१६-३४", "content_sanskrit": "क्षीरोदमथने जाते कुण्डले चामृतस्रवं ।\nये लब्धे दानवाञ्चित्वा पाताले धर्ममूर्त्तिना ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001755034, "chapter_id": 21755, "verse_number": "२-१६-३५", "content_sanskrit": "मोहिन्या कर्णयोश्चक्रे स्वयमेव वृषांगदः ।\nअष्टोत्तरसहस्रैश्च धात्रीफलनिभैः शुभैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001755035, "chapter_id": 21755, "verse_number": "२-१६-३६", "content_sanskrit": "मौक्तिकै रचितैः शुभ्रैर्हारो देव्याः कृतो हृदि ।\nनिष्कं पलशतं स्वर्णं कुलिशायुतभूषितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001755036, "chapter_id": 21755, "verse_number": "२-१६-३७", "content_sanskrit": "हार लघूत्तरं चक्रे मातुर्नृपसुतस्तदा ।\nवलया वज्रखचिता द्विरष्टौ करयोर्द्वयोः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001755037, "chapter_id": 21755, "verse_number": "२-१६-३८", "content_sanskrit": "एकैके निष्ककोटीभिर्मूल्यविद्भिर्नरैः कृताः ।\nकेयूरनूपुरौ तस्या अनर्घौ स नृपात्मजः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001755038, "chapter_id": 21755, "verse_number": "२-१६-३९", "content_sanskrit": "प्रददौ पितुरिष्टाया भूषणार्थं रविप्रभौ ।\nकटिसूत्रं तु शर्वाण्या यदासीत्पावकप्रभम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001755039, "chapter_id": 21755, "verse_number": "२-१६-४०", "content_sanskrit": "तद्भ्रष्टं भयभीतायाः संग्रामे तारकामये ।\nकालनेमौ स्थिते राज्ये पतितं मूलपाचने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001755040, "chapter_id": 21755, "verse_number": "२-१६-४१", "content_sanskrit": "तद्गृहीतं तु दैत्येन मयेन लोकमायिना ।\nतं हत्वा मलये दैत्यं दैत्यकोटिसमावृतम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001755041, "chapter_id": 21755, "verse_number": "२-१६-४२", "content_sanskrit": "संवत्सररणे घोरे पितुर्वचनकारणात् ।\nअवाप कटिसूत्रं तु दैत्यराजप्रियास्थितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001755042, "chapter_id": 21755, "verse_number": "२-१६-४३", "content_sanskrit": "तद्ददौ पितुरिष्टायाः सानन्दपुलको नृपः ।\nहिरण्यकशिपोः पूर्वं या भार्या लोकसुन्दरी ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001755043, "chapter_id": 21755, "verse_number": "२-१६-४४", "content_sanskrit": "तस्याः सीमंतकश्चासीत्सौदामिनिसमप्रभः ।\nसा प्रविष्टा समं पत्या यदा पावकमंगला ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001755044, "chapter_id": 21755, "verse_number": "२-१६-४५", "content_sanskrit": "समुद्रे क्षिप्य सीमन्तं दुःखेन महतान्विता ।\nसागरस्तत्तु संगृह्य रत्नश्रेष्ठयुगं किल ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001755045, "chapter_id": 21755, "verse_number": "२-१६-४६", "content_sanskrit": "ददौ धर्मांगदायाथ तस्य वीर्येण तोषितः ।\nजनन्याः प्रददौ हृष्टः सूर्यकोटिसमप्रभम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001755046, "chapter_id": 21755, "verse_number": "२-१६-४७", "content_sanskrit": "अग्निशौचे शुभे वस्त्रे कंचुके सुमनोहरे ।\nसहस्रकोटिमूल्ये ते मोहिन्याः संन्यवेदयत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001755047, "chapter_id": 21755, "verse_number": "२-१६-४८", "content_sanskrit": "देवमाल्यं सुगंधाढ्यं तथा देवविलेपनम् ।\nसर्वदेवगुरोः पूर्वं सिद्धहस्तात्सुदुर्लभम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001755048, "chapter_id": 21755, "verse_number": "२-१६-४९", "content_sanskrit": "धर्मांगदेन वीरेण द्वीपानां विजये तथा ।\nलब्धं तत् प्रददौ देव्या मोहिन्याः कामवर्द्धनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001755049, "chapter_id": 21755, "verse_number": "२-१६-५०", "content_sanskrit": "संभूष्य परया भक्त्या पश्चात्षड्रसभोजनम् ।\nआनीतं मातृहस्तेन भोजयामास भूमिप ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001755050, "chapter_id": 21755, "verse_number": "२-१६-५१", "content_sanskrit": "पुरस्तादेव जननीं वाक्यैः संबोध्य भूरिशः ।\nमया त्वया च कर्तव्यं राज्ञो वाक्यं न संशयः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001755051, "chapter_id": 21755, "verse_number": "२-१६-५२", "content_sanskrit": "या इष्टा नृपतेर्देवि सास्माकं हि गरीयसी ।\nइष्टा या भूपतेर्भर्तुस्तस्या या दुष्टमाचरेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001755052, "chapter_id": 21755, "verse_number": "२-१६-५३", "content_sanskrit": "सा पत्नी नरकं याति यावदिंद्राश्चतुर्दश ।\nसापत्नभावं या कुर्याद्भर्तृस्नेहेष्टया सह ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001755053, "chapter_id": 21755, "verse_number": "२-१६-५४", "content_sanskrit": "तस्याः स्नेहवियोगार्थं तप्यते ताम्रभ्राष्टके ।\nयथा सुखं भवेद्भर्तुस्तथा कार्यं हि भार्यया ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001755054, "chapter_id": 21755, "verse_number": "२-१६-५५", "content_sanskrit": "अनुकूलं हितं तस्या इष्टाया भर्तुराचरेत् ।\nयथा भर्ता तथा तां हि पश्येत वरवर्णिनि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001755055, "chapter_id": 21755, "verse_number": "२-१६-५६", "content_sanskrit": "हीनायाश्चापि शुश्रूषां कृत्वा याति त्रिविष्टपम् ।\nपश्चात्स्थाने भवेत्सापि मनसा याभवत्प्रिये ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001755056, "chapter_id": 21755, "verse_number": "२-१६-५७", "content_sanskrit": "सर्वान्भोगानवाप्नोति भर्तुरिष्टं प्रगृह्य हि ।\nइर्ष्याभावपरित्यागात्सर्वेश्वरपदं लभेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001755057, "chapter_id": 21755, "verse_number": "२-१६-५८", "content_sanskrit": "सपत्नी या सपत्न्यास्तुःशुश्रूषां कुरुते सदा ।\nभर्तुरिष्टां संनिरीक्ष्य तस्या लोकोऽक्षयो भवेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001755058, "chapter_id": 21755, "verse_number": "२-१६-५९", "content_sanskrit": "भर्तुरिष्टा पुरा वेश्या ह्यभवत्सा कुलेषु वै ।\nशूद्रजातेः सुदुष्टस्य परित्यक्तक्रियस्य तु ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001755059, "chapter_id": 21755, "verse_number": "२-१६-६०", "content_sanskrit": "आचरद्‌वेश्यया सार्द्धं सा भार्या पतिरंजिनी ।\nप्रक्षालनं द्वयोः पादौ द्वयोरुच्छिष्टभोजिनी ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001755060, "chapter_id": 21755, "verse_number": "२-१६-६१", "content_sanskrit": "उभयोरप्यधः शेते उभयोर्वै हितं रता ।\nवेश्यया वार्यमाणापि सदाचारपथे स्थिता ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001755061, "chapter_id": 21755, "verse_number": "२-१६-६२", "content_sanskrit": "एवं शुश्रीषयंत्या हि भर्तारं वेश्यया सह ।\nजगाम सुमहान्कालो वर्तंत्या दुःखसागरे ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001755062, "chapter_id": 21755, "verse_number": "२-१६-६३", "content_sanskrit": "अपरस्मिन्दिने भर्ता माहिषं मूलकान्वितम् ।\nअभक्षयत निष्पावं दुर्मेधास्तैलमिश्रितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001755063, "chapter_id": 21755, "verse_number": "२-१६-६४", "content_sanskrit": "तदपथ्यभुजस्तस्य अवमन्य पतिव्रताम् ।\nअभवद्दारुणो रोगो गुदे तस्य भगंदरः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001755064, "chapter_id": 21755, "verse_number": "२-१६-६५", "content_sanskrit": "संदह्यमानोऽतितरां दिवा रात्रौ स भूरिशः ।\nतस्य गेहे स्थितं वित्तं समादाय जगाम सा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001755065, "chapter_id": 21755, "verse_number": "२-१६-६६", "content_sanskrit": "वेश्यान्यस्मैददौ प्रीत्या यूने कामपरायणा ।\nततः स दीनवदनो व्रीडया च समन्वितः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001755066, "chapter_id": 21755, "verse_number": "२-१६-६७", "content_sanskrit": "उवाच प्ररुदन्भार्यां शूद्रो व्याकुलचेतनः ।\nपरिपालय मां देवि वेश्यासक्तं सुनिष्ठुरम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001755067, "chapter_id": 21755, "verse_number": "२-१६-६८", "content_sanskrit": "न मयोपकृतं किंचित्तव सुंदरि पापिना ।\nरमते वेश्यया सार्द्धं बहूनब्दान्सुमध्यमे ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001755068, "chapter_id": 21755, "verse_number": "२-१६-६९", "content_sanskrit": "यो भार्यां प्रणतां पापोनानुमन्येत गर्वितः ।\nसोऽशुभानि समाप्नोति जन्मानि दश पंच च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001755069, "chapter_id": 21755, "verse_number": "२-१६-७०", "content_sanskrit": "दिवाकीर्तिगृहे तस्माद्योनिं प्राप्स्यामि गर्हिताम् ।\nतवापमानतो देवि मनो न कलुषीकृतम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001755070, "chapter_id": 21755, "verse_number": "२-१६-७१", "content_sanskrit": "इति भर्तृवचः श्रुत्वा भार्या भर्तारमब्रवीत् ।\nपुराकृतानि पापानि दुःखानि प्रभवंति हि ।\nतानि सक्षमते विद्वान् स विज्ञेयो नृणां वरः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001755071, "chapter_id": 21755, "verse_number": "२-१६-७२", "content_sanskrit": "तन्मया पापया पापं कृतं वै पूर्वजन्मनि ।\nतद्भजंत्या न मे दुःखं न विषादः कथंचन ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001755072, "chapter_id": 21755, "verse_number": "२-१६-७३", "content_sanskrit": "एवमुक्त्वा समाश्वास्य भर्तारमनुशास्य च ।\nअनीतं जनकाद्वित्तं बंधुभ्यो वरवर्णिनी ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001755073, "chapter_id": 21755, "verse_number": "२-१६-७४", "content_sanskrit": "क्षीरोदनिलयावासं मन्यते स्म सती पतिम् ।\nदिवा दिवा त्रिर्यत्नेन रात्रौ गुह्यविशोधनम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001755074, "chapter_id": 21755, "verse_number": "२-१६-७५", "content_sanskrit": "रजनीकरवृक्षोत्थं गृह्य निर्यासमंजसा ।\nनखेन पातयेद्भर्तुः क्रिमीन्कुष्ठाच्छनैः शनैः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001755075, "chapter_id": 21755, "verse_number": "२-१६-७६", "content_sanskrit": "मयूरपुच्छसंयुक्तं पवनं चाकरोत्तदा ।\nन देवि रात्रौ स्वपिति न दिवा च वरानना ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001755076, "chapter_id": 21755, "verse_number": "२-१६-७७", "content_sanskrit": "भर्तृदुःखेन संतप्ता अपश्यज्ज्वलितं जगत् ।\nयद्यस्ति वसुधा देवी पितरो देवतास्तथा ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001755077, "chapter_id": 21755, "verse_number": "२-१६-७८", "content_sanskrit": "कुर्वंतु रोगहीनं मे भर्तारं गतकल्मषम् ।\nचंडिकायै प्रदास्यामि रक्तं मांससमुद्भवम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001755078, "chapter_id": 21755, "verse_number": "२-१६-७९", "content_sanskrit": "नृच्छागमहिषोपेतं भर्तुरारोग्यहेतवे ।\nसादरं कारयिष्यामि उपवासान्दशैव तु ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001755079, "chapter_id": 21755, "verse_number": "२-१६-८०", "content_sanskrit": "शरीरं स्थापयिष्येऽहं सूक्ष्मकंटकसंस्तरे ।\nनोपभोक्ष्यामि मधुरं नोपभोक्ष्यामि वै घृतम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001755080, "chapter_id": 21755, "verse_number": "२-१६-८१", "content_sanskrit": "बाह्याभ्यंगविहीनाहं संस्थास्ये दिनसंचयम् ।\nजीवतां रोगहीनो हि भर्ता मे शरदां शतम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001755081, "chapter_id": 21755, "verse_number": "२-१६-८२", "content_sanskrit": "एवं प्रव्याहरंती सा वासरे वासरे गते ।\nअथ कालेन चाल्पेन त्रिदोषोऽस्य व्यजायत ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001755082, "chapter_id": 21755, "verse_number": "२-१६-८३", "content_sanskrit": "त्रिकटुं प्रददौ भर्तुर्यत्नेन महता तदा ।\nशीतार्तः कंपमानोऽसौ पत्न्यंगुलिमखंडयत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001755083, "chapter_id": 21755, "verse_number": "२-१६-८४", "content_sanskrit": "उभयोर्दतयोः श्लेषः सहसा समपद्यत ।\nतत्खंडमंगुलेर्वक्त्रे स्थितं नृपतिवल्लभे ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001755084, "chapter_id": 21755, "verse_number": "२-१६-८५", "content_sanskrit": "अथ विक्रीय वलयं क्रीत्वा काष्ठानि भूरिशः ।\nचितां सार्पिर्युतां चक्रे मध्ये धृत्वा पतिं तदा ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001755085, "chapter_id": 21755, "verse_number": "२-१६-८६", "content_sanskrit": "अवरुह्य च बाहुभ्यां पादेनाकृष्य पावकम् ।\nमुखे सुखं समाधाय हृदये हृदयं तथा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001755086, "chapter_id": 21755, "verse_number": "२-१६-८७", "content_sanskrit": "जघने जघनं देवि आत्मनः संनिवेश्य वै ।\nदाहयामास कल्याणी भर्तुर्देहं रुजान्वितम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001755087, "chapter_id": 21755, "verse_number": "२-१६-८८", "content_sanskrit": "आत्मना सह चार्वंगी ज्वलिते जातवेदसि ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001755088, "chapter_id": 21755, "verse_number": "२-१६-८९", "content_sanskrit": "विमुच्य देहं सहसा जगाम पतिं समादाय च देवलोकम् ।\nविशोधयित्वा बहुपापसंघान्स्वकर्मणा दुष्करसाधनेन ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]