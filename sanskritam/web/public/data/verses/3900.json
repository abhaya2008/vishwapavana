[{"id": 2134328, "chapter_id": 3900, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134329, "chapter_id": 3900, "verse_number": "१", "content_sanskrit": "यदाऽभिषिक्तो भगवान् सैनापत्येन पावकिः ।\nतदा सम्प्रस्थितः श्रीमान् हृष्टो भद्रवटं हरः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134330, "chapter_id": 3900, "verse_number": "२", "content_sanskrit": "रथेनादित्यवर्णेन पार्वत्या सहितः प्रभुः ।\nअनुयातः सुरैः सर्वैः सहस्राक्षपुरोगमैः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134331, "chapter_id": 3900, "verse_number": "३", "content_sanskrit": "सहस्रं तत्र सिंहानां तस्मिन् युक्तं रथोत्तमे ।\nउत्पपात दिवं शुभ्रं सूतेनाभिप्रचोदितः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134332, "chapter_id": 3900, "verse_number": "४", "content_sanskrit": "ते पिबन्त इवाकाशं त्रासयन्तश्चराचरान् ।\nसिंहा नभस्यगच्छन्त नदन्तश्चारुकेसराः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134333, "chapter_id": 3900, "verse_number": "५", "content_sanskrit": "तस्मिन् रथे पशुपतिः स्थितो भात्युमया सह ।\nविद्युता सहितः सूर्यः सेन्द्रचापे घने यथा \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134334, "chapter_id": 3900, "verse_number": "६", "content_sanskrit": "अग्रतस्तस्य भगवान् धनेशो गुह्यकैः सह ।\nआस्थाय रुचिरं याति पुष्पकं नरवाहनः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134335, "chapter_id": 3900, "verse_number": "७", "content_sanskrit": "ऐरावतं समास्थाय शक्रश्चापि सुरैः सह ।\nपृष्ठतोऽनुययौ यान्तं वरदं वृषभध्वजम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134336, "chapter_id": 3900, "verse_number": "८", "content_sanskrit": "गुह्यकैर्यक्षरक्षोभिः स्रग्विभिः समलङ्कृतः ।\nयात्यमोघो महायक्षो दक्षिणं पक्षमास्थितः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134337, "chapter_id": 3900, "verse_number": "९", "content_sanskrit": "तस्य दक्षिणतो देवा मरुतश्चित्रयोधिनः ।\nगच्छन्ति वसुभिः सार्धं रुद्रैश्च सह सङ्गताः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134338, "chapter_id": 3900, "verse_number": "१०", "content_sanskrit": "यमश्च मृत्युना सार्धं सर्वतः परिवारितः ।\nघोरैर्व्याधिशतैर्याति घोररूपवपुस्तदा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134339, "chapter_id": 3900, "verse_number": "११", "content_sanskrit": "यमस्य पृष्ठतश्चैव घोरस्त्रिशिखरः शितः ।\nविजयो नाम रुद्रस्य याति शूलः स्वलङ्कृतः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134340, "chapter_id": 3900, "verse_number": "१२", "content_sanskrit": "तमुग्रपाशो वरुणो भगवान् सलिलेश्वरः ।\nपरिवार्य शनैर्याति यादोभिर्विविधैर्वृतः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134341, "chapter_id": 3900, "verse_number": "१३", "content_sanskrit": "पृष्ठतो विजयस्यापि याति रुद्रस्य पट्ट(ट्टि)सः ।\nगदामुसलशक्त्याद्यैर्वृतः प्रहरणोत्तमैः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134342, "chapter_id": 3900, "verse_number": "१४", "content_sanskrit": "पट्टिसं त्वन्वगाद् राजन् शस्त्रं रौद्रं महाबलम् ।\nकमण्डलुश्चाप्यनु तं महर्षिगणसेवितम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134343, "chapter_id": 3900, "verse_number": "१५", "content_sanskrit": "तस्य दक्षिणतो याति दण्डो गच्छन् श्रिया वृतः ।\nभृग्वङ्गिरोभिः सहितो दैवतैश्चानुपूजितः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134344, "chapter_id": 3900, "verse_number": "१६", "content_sanskrit": "एषां तु पृष्ठतो रुद्रो विमले स्यन्दने स्थितः ।\nयाति संहर्षयन् सर्वांस्तेजसा त्रिदिवौकसः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134345, "chapter_id": 3900, "verse_number": "१७", "content_sanskrit": "ऋषयश्चापि देवाश्च गन्धर्वा भुजगास्तथा ।\nनद्यो ह्रदाः समुद्राश्च तथैवाप्सरसां गणाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134346, "chapter_id": 3900, "verse_number": "१८", "content_sanskrit": "नक्षत्राणि ग्रहाश्चैव देवानां शिशवश्च ये ।\nस्त्रियश्च विविधाकारा यान्ति रुद्रस्य पृष्ठतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134347, "chapter_id": 3900, "verse_number": "१९", "content_sanskrit": "सृजन्त्यः पुष्पवर्षाणि चारुरूपा वराङ्गनाः ।\nपर्जन्यश्चाप्यनुययौ नमस्कृत्य पिनाकिनम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134348, "chapter_id": 3900, "verse_number": "२०", "content_sanskrit": "छत्रं च पाण्डरं सोमस्तस्य मूर्धन्यधारयत् ।\nचामरे चापि वायुश्च गृहीत्वाग्निश्च धिष्ठितौ\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134349, "chapter_id": 3900, "verse_number": "२१", "content_sanskrit": "शक्रश्च पृष्ठतस्तस्य याति राजन् श्रिया वृतः ।\nसह राजर्षिभिः सर्वैः स्तुवानो वृषकेतनम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134350, "chapter_id": 3900, "verse_number": "२२", "content_sanskrit": "गौरी विद्याऽथ गान्धारी केशिनी मित्रसाह्वया ।\nसावित्र्या सह सर्वास्ताः पार्वत्या यान्ति पृष्ठतः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134351, "chapter_id": 3900, "verse_number": "२३", "content_sanskrit": "तत्र विद्यागणाः सर्वे ये केचित् कविभिः कृताः ।\nतस्य कुर्वन्ति वचनं सेन्द्रा देवाश्चमूमुखे \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134352, "chapter_id": 3900, "verse_number": "२४", "content_sanskrit": "स्वेन स्वेनानुयोगेन सर्वे तेऽनुययुर्हरम् ।\nगृहीत्वा तु पताकां वै यात्यसौ राक्षसो ग्रहः ।\nव्यापृतस्तु श्मशाने यो नित्यं रुद्रस्य वै सखा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134353, "chapter_id": 3900, "verse_number": "२५", "content_sanskrit": "पिङ्गलो नाम यक्षेन्द्रो लोकस्यानन्ददायकः ।\nएभिश्च सहितो देवस्तत्र याति यथासुखम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134354, "chapter_id": 3900, "verse_number": "२६", "content_sanskrit": "अग्रतः पृष्ठतश्चैव न हि तस्य गतिर्ध्रुवा ।\nरुद्रं सत्कर्मभिर्मर्त्याः पूजयन्तीह दैवतम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134355, "chapter_id": 3900, "verse_number": "२७", "content_sanskrit": "शिवमित्येव यं प्राहुरीशं रुद्रं पितामहम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134356, "chapter_id": 3900, "verse_number": "२८", "content_sanskrit": "एवं सर्वे सुरगणास्तदा वै प्रीतमानसाः ।\nभावैस्तु विविधाकारैः पूजयन्ति महेश्वरम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2134357, "chapter_id": 3900, "verse_number": "२९", "content_sanskrit": "देवसेनापतिस्त्वेवं देवसेनाभिरावृतः ।\nअनुगच्छति देवेशं ब्रह्मण्यः कृत्तिकासुतः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2134358, "chapter_id": 3900, "verse_number": "३०", "content_sanskrit": "अथाब्रवीन्महासेनं महादेवो बृहद्वचः ।\nसप्तमं मारुतस्कन्धं रक्ष नित्यमतन्द्रितः\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2134359, "chapter_id": 3900, "verse_number": "", "content_sanskrit": "स्कन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2134360, "chapter_id": 3900, "verse_number": "३१", "content_sanskrit": "सप्तमं मारुतस्कन्धं पालयिष्याम्यहं प्रभो ।\nयदन्यदपि मे कार्यं देव तद् वद माचिरम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2134361, "chapter_id": 3900, "verse_number": "", "content_sanskrit": "रुद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2134362, "chapter_id": 3900, "verse_number": "३२", "content_sanskrit": "कार्येष्वहं त्वया पुत्र सन्द्रष्टव्यः सदैव हि ।\nदर्शनान्मम भक्त्या च श्रेयः परमवाप्स्यसि \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2134363, "chapter_id": 3900, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2134364, "chapter_id": 3900, "verse_number": "३३", "content_sanskrit": "इत्युक्त्वा विससर्जैनं परिष्वज्य महेश्वरः ।\nस्कन्दं सहोमया प्रीतो ज्वलन्तमिव तेजसा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2134365, "chapter_id": 3900, "verse_number": "३४", "content_sanskrit": "विसर्जिते ततः स्कन्दे बभूवौत्पातिकं महत् ।\nसहसैव महाराज देवान् सर्वान् प्रमोहयत् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2134366, "chapter_id": 3900, "verse_number": "३५", "content_sanskrit": "जज्वाल खं सनक्षत्रं प्रमूढं भुवनं भृशम् ।\nचचाल व्यनदच्चोर्वी तमोभूतं जगद् बभौ \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2134367, "chapter_id": 3900, "verse_number": "३६", "content_sanskrit": "ततस्तद् दारुणं दृष्ट्वा क्षुभितः शङ्करस्तदा ।\nउमा चैव महाभागा देवाश्चर्षिगणैः सह \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2134368, "chapter_id": 3900, "verse_number": "३७", "content_sanskrit": "ततस्तेषु प्रमूढेषु पर्वताम्बुदसन्निभम् ।\nनानाप्रहरणं घोरमदृश्यत महद्बलम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2134369, "chapter_id": 3900, "verse_number": "३८", "content_sanskrit": "तद् वै घोरमसङ्ख्येयं गर्जच्च विविधा गिरः ।\nअभ्यद्रवद् रणे देवान् भगवन्तं च शङ्करम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2134370, "chapter_id": 3900, "verse_number": "३९", "content_sanskrit": "तैर्विसृष्टान्यनीकेषु बाणजालान्यनेकशः ।\nपर्वताश्च शतघ्न्यश्च प्रासासिपरिघा गदाः\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2134371, "chapter_id": 3900, "verse_number": "४०", "content_sanskrit": "निपतद्भिस्तु तैर्घोरैर्देवानीकं महायुधैः ।\nक्षणेन व्यद्रवत् सर्वं विमुखं चाप्यदृश्यत \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2134372, "chapter_id": 3900, "verse_number": "४१", "content_sanskrit": "निकृत्तयोधनागाश्वं कृत्तायुधमहारथम् ।\nदानवैरर्दितं सैन्यं देवानां विमुखं बभौ \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2134373, "chapter_id": 3900, "verse_number": "४२", "content_sanskrit": "असुरैर्वध्यमानं तत् पावकैरिव काननम् ।\nअपतद् दग्धभूयिष्ठं महाद्रुमवनं यथा \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2134374, "chapter_id": 3900, "verse_number": "४३", "content_sanskrit": "ते विभिन्नशिरोदेहाः प्राद्रवन्तो दिवौकसः ।\nन नाथमभ्यगच्छन्ति वध्यमाना महारणे \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2134375, "chapter_id": 3900, "verse_number": "४४", "content_sanskrit": "अथ तद् विद्रुतं सैन्यं दृष्ट्वा देवः पुरन्दरः ।\nआश्वासयन्नुवाचेदं बलभिद् दानवार्दितम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2134376, "chapter_id": 3900, "verse_number": "४५", "content_sanskrit": "भयं त्यजत भद्रं वः शूराः शस्त्राणि गृह्णत ।\nकुरुध्वं विक्रमे बुद्धि मा वः काचिद् व्यथा भवेत् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2134377, "chapter_id": 3900, "verse_number": "४६", "content_sanskrit": "जयतैनान् दुराचारान् दानवान् घोरदर्शनान् ।\nअभिद्रवत भद्रं वो मया सह महासुरान् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2134378, "chapter_id": 3900, "verse_number": "४७", "content_sanskrit": "शक्रस्य वचनं श्रुत्वा समाश्वस्ता दिवौकसः ।\nदानवान् प्रत्ययुध्यन्त शक्रं कृत्वा व्यपाश्रयम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2134379, "chapter_id": 3900, "verse_number": "४८", "content_sanskrit": "ततस्ते त्रिदशाः सर्वे मरुतश्च महाबलाः ।\nप्रत्युद्ययुर्महावेगाः साध्याश्च वसुभिः सह \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2134380, "chapter_id": 3900, "verse_number": "४९", "content_sanskrit": "तैर्विसृष्टान्यनीकेषु क्रुद्धैः शस्त्राणि संयुगे ।\nशराश्च दैत्यकायेषु पिबन्ति रुधिरं बहु \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2134381, "chapter_id": 3900, "verse_number": "५०", "content_sanskrit": "तेषां देहान् विनिर्भिद्य शरास्ते निशितास्तदा ।\nनिपतन्तोऽभ्यदृश्यन्त नगेभ्य इव पन्नगाः\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2134382, "chapter_id": 3900, "verse_number": "५१", "content_sanskrit": "तानि दैत्यशरीराणि निर्भिन्नानि स्म सायकैः ।\nअपतन् भूतळे राजंश्छिन्नाभ्राणीव सर्वशः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2134383, "chapter_id": 3900, "verse_number": "५२", "content_sanskrit": "ततस्तद् दानवं सैन्यं सर्वैर्देवगणैर्युधि।\nत्रासितं विविधैर्बाणैः कृतं चैव पराङ्मुखम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2134384, "chapter_id": 3900, "verse_number": "५३", "content_sanskrit": "अथो क्रुष्टं तदा हृष्टैः सर्वैर्देवैरुदायुधैः ।\nसंहितानि च तूर्याणि प्रावाद्यन्त ह्यनेकशः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2134385, "chapter_id": 3900, "verse_number": "५४", "content_sanskrit": "एवमन्योन्यसंयुक्तं युद्धमासीत् सुदारुणम् ।\nदेवानां दानवानां च मांसशोणितकर्दमम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2134386, "chapter_id": 3900, "verse_number": "५५", "content_sanskrit": "अभयो देवलोकस्य सहसैवाभ्यदृश्यत ।\nतदाऽपि दानवा घोरा विनिघ्नन्ति दिवौकसः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2134387, "chapter_id": 3900, "verse_number": "५६", "content_sanskrit": "ततस्तूर्यप्रणादाश्च भेरीणां च महास्वनः ।\nबभूवुर्दानवेन्द्राणां सिंहनादाश्च दारुणाः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2134388, "chapter_id": 3900, "verse_number": "५७", "content_sanskrit": "अथ दैत्यबलाद् घोरान्निष्पपात महाबलः ।\nदानवो महिषो नाम प्रगृह्य विपुलं गिरिम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2134389, "chapter_id": 3900, "verse_number": "५८", "content_sanskrit": "ते तं घनैरिवादित्यं दृष्ट्वा सम्परिवारितम् ।\nसमुद्यम्य गिरिं राजन् व्यद्रवन्त दिवौकसः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2134390, "chapter_id": 3900, "verse_number": "५९", "content_sanskrit": "अथाभिद्रुत्य महिषो देवांश्चिक्षेप तं गिरिम् ।\nमहाकायं महाराज सतोयमिव तोयदम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2134391, "chapter_id": 3900, "verse_number": "६०", "content_sanskrit": "पतता तेन गिरिणा देवसैन्यस्य पार्थिव ।\nभीमरूपेण निहतमयुतं प्रापतद् भुवि \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2134392, "chapter_id": 3900, "verse_number": "६१", "content_sanskrit": "अथ तैर्दानवैः सार्धं महिषस्त्रासयन् सुरान् ।\nअभ्यद्रवद् रणे तूर्णं सिंहः क्षुद्रमृगानिव \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2134393, "chapter_id": 3900, "verse_number": "६२", "content_sanskrit": "तमापतन्तं महिषं दृष्ट्वा सेन्द्रा दिवौकसः ।\nव्यद्रवन्त रणे भीता विकीर्णायुधकेतनाः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2134394, "chapter_id": 3900, "verse_number": "६३", "content_sanskrit": "ततः स महिषः क्रुद्धस्तूर्णं रुद्ररथं ययौ ।\nअभिद्रुत्य च जग्राह रुद्रस्य रथकूबरम् \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2134395, "chapter_id": 3900, "verse_number": "६४", "content_sanskrit": "यदा रुद्ररथं क्रुद्धो महिषः सहसा गतः ।\nरेसतू रोदसी गाढं मुमुहुश्चर्षयस्तदा \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2134396, "chapter_id": 3900, "verse_number": "६५", "content_sanskrit": "अनदंश्च महाकाया दैत्या जलधरोपमाः ।\nआसीच्च निश्चितं तेषां जितमस्माभिरित्युत \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2134397, "chapter_id": 3900, "verse_number": "६६", "content_sanskrit": "तथाभूते तु भगवान् नाहनन्महिषं रणे ।\nसस्मार च तदा स्कन्दं मृत्युं तस्य दुरात्मनः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2134398, "chapter_id": 3900, "verse_number": "६७", "content_sanskrit": "महिषोऽपि रथं दृष्ट्वा रौद्रो रुद्रस्य चानदत् ।\nदेवान् सन्त्रासयंश्चापि दैत्यांश्चापि प्रहर्षयन् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2134399, "chapter_id": 3900, "verse_number": "६८", "content_sanskrit": "ततस्तस्मिन् भये घोरे देवानां समुपस्थिते ।\nआजगाम महासेनः क्रोधात् सूर्य इव ज्वलन् \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2134400, "chapter_id": 3900, "verse_number": "६९", "content_sanskrit": "लोहिताम्बरसंवीतो लोहितस्रग्विभूषणः ।\nलोहिताक्षो महाबाहुर्हिरण्यकवचः प्रभुः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2134401, "chapter_id": 3900, "verse_number": "७०", "content_sanskrit": "रथमादित्यसङ्काशमास्थितः कनकप्रभम् ।\nतं दृष्ट्वा दैत्यसेना सा व्यद्रवत् सहसा रणे \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2134402, "chapter_id": 3900, "verse_number": "७१", "content_sanskrit": "स चापि तां प्रज्वलितां महिषस्य विदारिणीम् ।\nमुमोच शक्ति राजेन्द्र महासेनो महाबलः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2134403, "chapter_id": 3900, "verse_number": "७२", "content_sanskrit": "सा मुक्ताऽभ्यहरत् तस्य महिषस्य शिरो महत् ।\nपपात भिन्ने शिरसि महिषस्त्यक्तजीवितः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2134404, "chapter_id": 3900, "verse_number": "७३", "content_sanskrit": "क्षिप्ताक्षिप्ता तु सा शक्तिर्हत्वा शत्रून् सहस्रशः ।\nस्कन्दहस्तमनुप्राप्ता दृश्यते देवदानवैः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2134405, "chapter_id": 3900, "verse_number": "७४", "content_sanskrit": "प्रायः शरैर्विनिहता महासेनेन धीमता ।\nदानवेषु महाराज तस्मिन् देवासुरे युधि \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2134406, "chapter_id": 3900, "verse_number": "७५", "content_sanskrit": "शेषा दैत्यगणा घोरा भीतास्त्रस्ता दुरासदैः ।\nस्कन्दपारिषदैर्हत्वा भक्षिताश्च सहस्रशः \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2134407, "chapter_id": 3900, "verse_number": "७६", "content_sanskrit": "दानवान् भक्षयन्तस्ते प्रपिबन्तश्च शोणितम् ।\nक्षणान्निर्दानवं सर्वमकार्षुर्भृशहर्षिताः \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2134408, "chapter_id": 3900, "verse_number": "७७", "content_sanskrit": "तमांसि च यथा सूर्यो वृक्षानग्निर्घनान् खगः ।\nतथा स्कन्दोऽजयच्छत्रून् स्वेन वीर्येण कीर्तिमान् \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2134409, "chapter_id": 3900, "verse_number": "७८", "content_sanskrit": "सम्पूज्यमानस्त्रिदशैरभिवाद्य महेश्वरम् ।\nशुशुभे कृत्तिकापुत्रः प्रकीर्णांशुरिवांशुमान् \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2134410, "chapter_id": 3900, "verse_number": "७९", "content_sanskrit": "नष्टशत्रुर्यदा स्कन्दः प्रयातस्तु महेश्वरम् ।\nतदाब्रवीन्महासेनं परिष्वज्य पुरन्दरः \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2134411, "chapter_id": 3900, "verse_number": "८०", "content_sanskrit": "ब्रह्मदत्तवरः स्कन्द त्वयाऽयं महिषो हतः ।\nअजेयो युधि देवानां दानवः सुमहाबलः \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2134412, "chapter_id": 3900, "verse_number": "८१", "content_sanskrit": "देवास्तृणसमा यस्य बभूवुर्जयतां वर ।\nसोऽयं त्वया महाबाहो शमितो देवकण्टकः \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2134413, "chapter_id": 3900, "verse_number": "८२", "content_sanskrit": "शतं महिषतुल्यानां दानवानां महा(त्वया)रणे ।\nनिहतं देवशत्रूणां यैर्वयं पूर्वतापिताः \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2134414, "chapter_id": 3900, "verse_number": "८३", "content_sanskrit": "तावकैर्भक्षिताश्चान्ये दानवाः शतसङ्घशः ।\nअजेयस्त्वं रणेऽरीणामुमापतिरिव प्रभुः ।\nभवतोऽनुचरैर्वीर गणैः परमभीषणैः \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2134415, "chapter_id": 3900, "verse_number": "८४", "content_sanskrit": "एतत् ते प्रथमं देव ख्यातं कर्म भविष्यति ।\nत्रिषु लोकेषु कीर्तिश्च तवाक्षय्या भविष्यति \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2134416, "chapter_id": 3900, "verse_number": "८५", "content_sanskrit": "वशगाश्च भविष्यन्ति सुरास्तव सुरात्मज \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2134417, "chapter_id": 3900, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2134418, "chapter_id": 3900, "verse_number": "८६", "content_sanskrit": "एवमुक्त्वा महासेनं निवृत्तः सह दैवतैः ।\nअनुज्ञातो भगवता त्र्यम्बकेण शचीपतिः \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2134419, "chapter_id": 3900, "verse_number": "८७", "content_sanskrit": "गतो भद्रवटं रुद्रो निवृत्ताश्च दिवौकसः ।\nउक्ताश्च देवा रुद्रेण स्कन्दं पश्यत मामिव \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2134420, "chapter_id": 3900, "verse_number": "८८", "content_sanskrit": "स हत्वा दानवगणान् पूज्यमानो महर्षिभिः ।\nएकाह्नैवाजयत् सर्वं त्रैलोक्यं वह्निनन्दनः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2134421, "chapter_id": 3900, "verse_number": "८९", "content_sanskrit": "स्कन्दस्य य इदं विप्रः पठेज्जन्म समाहितः ।\nस पुष्टिमिह सम्प्राप्य स्कन्दसालोक्यमाप्नुयात् \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2134422, "chapter_id": 3900, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nएकविंशदधिकद्विशततमोऽध्यायः ॥२२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2134423, "chapter_id": 3900, "verse_number": "४६", "content_sanskrit": "॥ इति मार्कण्डेयसमास्यापर्वणि आङ्गिरसे स्कन्दोत्पत्तौ महिषासुरवधे षट्चत्वारिंशोऽध्यायः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2134424, "chapter_id": 3900, "verse_number": "", "content_sanskrit": "॥ समाप्तं मार्कण्डेयसमास्यापर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]