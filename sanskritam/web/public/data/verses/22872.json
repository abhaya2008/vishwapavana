[{"id": 7002872000, "chapter_id": 22872, "verse_number": "९-१५७-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअथातः संप्रवक्ष्यामि दानमन्यत्सुदुर्ल्लभम् ।\nरत्नधेन्विति विख्यातं गोलोकफलदं नृणाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002872001, "chapter_id": 22872, "verse_number": "९-१५७-२", "content_sanskrit": "पुण्यं दिनमथासाद्य गोमयेनोपलेपनम् ।\nकृत्वा भूमौ महाराज तत्र धेनुं प्रकल्पयेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002872002, "chapter_id": 22872, "verse_number": "९-१५७-३", "content_sanskrit": "धेनुं रत्नमयीं कुर्यात्तत्तत्संकल्पपूर्विकाम् ।\nस्थापयेत्पद्मरागाणामेकाशीतिं मुखे बुधः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002872003, "chapter_id": 22872, "verse_number": "९-१५७-४", "content_sanskrit": "पुष्परागशतं धेनोः पादयोः परिकल्पयेत् ।\nललाटे हेमतिलकं मुक्ताफलशतं दृशोः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002872004, "chapter_id": 22872, "verse_number": "९-१५७-५", "content_sanskrit": "भ्रूयुगे विद्रुमशतं शुक्ती कर्णद्वये स्मृते ।\nकाञ्चनानि च शृङ्गाणि शिरोवज्रशतात्मकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002872005, "chapter_id": 22872, "verse_number": "९-१५७-६", "content_sanskrit": "ग्रीवायां नेत्रपुटके गोमेदकशतं तथा ।\nइन्द्रनीलशतं पृष्ठे वैदूर्यशत पार्श्वके ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002872006, "chapter_id": 22872, "verse_number": "९-१५७-७", "content_sanskrit": "स्फाटिकैरुदरं कार्यं सौगन्धिकशतं कटौ ।\nखुरा हेममया कार्याः पुच्छं मुक्तावलीमयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002872007, "chapter_id": 22872, "verse_number": "९-१५७-८", "content_sanskrit": "सूर्यकान्तेन्दुकान्तौ च घ्राणे कर्पूरचन्दनैः ।\nकुंकुमेन च रोमाणि रौप्यं नाभिं च कारयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002872008, "chapter_id": 22872, "verse_number": "९-१५७-९", "content_sanskrit": "गारुत्मतशतं तद्वदपाने परिकल्पयेत् ।\nतथान्यानि च रत्नानि स्थापयेत्सर्वसंधिषु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002872009, "chapter_id": 22872, "verse_number": "९-१५७-१०", "content_sanskrit": "कुर्याच्छर्करया जिह्वां गोमयं च गुडात्मकम् ।\nगोमूत्रमाज्येन तथा दधिदुग्धस्वरूपतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002872010, "chapter_id": 22872, "verse_number": "९-१५७-११", "content_sanskrit": "पुच्छाग्रे चामरं दद्यात्स्तनयोस्ताम्रदोहनम् ।\nकारयेदेवमेवं तु चतुर्थांशेन वत्सकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002872011, "chapter_id": 22872, "verse_number": "९-१५७-१२", "content_sanskrit": "नानाफलानि पार्श्वेषु कृत्वा पूजां प्रयत्नतः ।\nगुडधेनुवदावाह्य इदं चोदाहरेत्ततः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002872012, "chapter_id": 22872, "verse_number": "९-१५७-१३", "content_sanskrit": "त्वां सर्वदेवगणवासमिति स्तुवंति रुद्रेन्द्रचन्द्रकमलासनवासुदेवाः ।\nतस्मात्समस्तभुवनत्रयदेहयुक्ता मां पाहि देवि भवसागर मग्नमासु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002872013, "chapter_id": 22872, "verse_number": "९-१५७-१४", "content_sanskrit": "एवमामन्त्र्य तां धेनुं विप्राय प्रतिपादयेत् ।\nसंपूज्य वस्त्राभरणैर्विधिज्ञं वेदपारगम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002872014, "chapter_id": 22872, "verse_number": "९-१५७-१५", "content_sanskrit": "ततश्च दक्षिणां दत्त्वा प्रणिपत्य क्षमापयेत् ।\nएवं यः कुरुते पार्थ तस्य पुण्यफलं शृणु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002872015, "chapter_id": 22872, "verse_number": "९-१५७-१६", "content_sanskrit": "कल्पकोटिशतं साग्रं शिवलोके सुखं वसेत् ।\nततः काले बहुतिथे राजराजो भवेदिह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002872016, "chapter_id": 22872, "verse_number": "९-१५७-१७", "content_sanskrit": "सर्वकामसमृद्धश्च शत्रुपक्षक्षयंकरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]