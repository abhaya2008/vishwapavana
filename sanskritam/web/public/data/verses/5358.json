[{"id": 2204506, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204507, "chapter_id": 5358, "verse_number": "१", "content_sanskrit": "भगवन् भगनेत्रघ्न मानुषाणां विचेष्टितम् ।\nसर्वमात्मकृतं चेति श्रुतं मे भगवन्मतम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204508, "chapter_id": 5358, "verse_number": "२", "content_sanskrit": "लोके ग्रहकृतं सर्वं मत्वा कर्म शुभाशुभम् ।\nतदेव ग्रहनक्षत्रं प्रायशः पर्युपासते ।\nएतं मे संशयं देव तद्गतं छेत्तुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204509, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204510, "chapter_id": 5358, "verse_number": "३", "content_sanskrit": "स्थाने संशयितुं देवि शृणु तत्त्वविनिश्चयम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204511, "chapter_id": 5358, "verse_number": "४", "content_sanskrit": "नक्षत्राणि ग्रहाश्चैव शुभाशुभनिवेदकाः ।\nमानवानां महाभागे न तु कर्मकराः स्वयम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204512, "chapter_id": 5358, "verse_number": "५", "content_sanskrit": "प्रजानां तु हितार्थाय शुभाशुभविधिं प्रति ।\nअनागतमतिक्रान्तं ज्योतिश्चक्रेण बोध्यते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204513, "chapter_id": 5358, "verse_number": "६", "content_sanskrit": "किन्तु तत्र शुभं कर्म सुग्रहैस्तन्निवेद्यते ।\nदुष्कृतस्याशुभैरेव समवायो भवेदिति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204514, "chapter_id": 5358, "verse_number": "७", "content_sanskrit": "तस्माद्धि ग्रहवैषम्ये वैषम्यं कुरुते जनः ।\nग्रहसाम्ये शुभं कुर्यात् जात्यां जात्यां पुरस्कृतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204515, "chapter_id": 5358, "verse_number": "८", "content_sanskrit": "केवलं ग्रहनक्षत्रं न करोति शुभाशुभम् ।\nसर्वमात्मकृतं कर्म लोकवादो ग्रहा इति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204516, "chapter_id": 5358, "verse_number": "९", "content_sanskrit": "पृथग्ग्रहाः पृथक्कर्ता स्वयम्भूर्भुज्यते फलम् ।\nइति ते कथितं सर्वं विशङ्कां जहि शोभने\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204517, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204518, "chapter_id": 5358, "verse_number": "१०", "content_sanskrit": "भगवन् विविधं कर्म कृत्वा जन्तुः शुभाशुभम् ।\nकिं तयोः पूर्वकतरं भुङ्क्ते जन्मान्तरे पुनः ।\nएष मे संशयो देव तं मे त्वं छेत्तुमर्हसि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204519, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204520, "chapter_id": 5358, "verse_number": "११", "content_sanskrit": "स्थाने संशयितुं देवि तत् ते वक्ष्यामि तत्त्वतः।\nअशुभं पूर्वमित्याहुरपरे शुभमित्यपि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204521, "chapter_id": 5358, "verse_number": "१२", "content_sanskrit": "मिथ्या तदुभयं प्रोक्तं केवलं तद् ब्रवीमि ते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204522, "chapter_id": 5358, "verse_number": "१३", "content_sanskrit": "मानुषे तु पदे कर्म युगपद् युज्यते सदा ।\nयथाकृतं यथायोगमुभयं भुज्यते क्रमात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204523, "chapter_id": 5358, "verse_number": "१४", "content_sanskrit": "भुञ्जानाश्चैव दृश्यन्ते क्रमशो भुवि मानवाः ।\nऋद्धिं हानिं सुखं दुःखमभयं भयमेव च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204524, "chapter_id": 5358, "verse_number": "१५", "content_sanskrit": "दुःखान्यनुभवन्त्याढ्या दरिद्राश्च सुखानि च ।\nयौगपद्याच्च भुञ्जाना दृश्यन्ते लोकसाक्षिकम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204525, "chapter_id": 5358, "verse_number": "१६", "content_sanskrit": "नरके स्वर्गलोके च न तथा संस्थितिः प्रिये ।\nनित्यं दुःखं हि नरके स्वर्गे नित्यं सुखं तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204526, "chapter_id": 5358, "verse_number": "१७", "content_sanskrit": "शुभाशुभानामाधिक्यात् कर्मणां तत्र सेव्यते ।\nनिरन्तरं सुखं दुःखं स्वर्गे च नरके भवेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204527, "chapter_id": 5358, "verse_number": "१८", "content_sanskrit": "तत्रापि सुमहद् भुक्त्वा पूर्वमल्पं पुनः शुभे ।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204528, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204529, "chapter_id": 5358, "verse_number": "१९", "content_sanskrit": "भगवन् प्राणिनो लोके म्रियन्ते केन हेतुना ।\nजाताजाता न तिष्ठन्ति तन्मे शंसितुमर्हसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204530, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204531, "chapter_id": 5358, "verse_number": "२०", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु तत्त्वं समाहिता ।\nआत्मकर्मक्षयाद् देहं यथा मुञ्चति तच्छृणु\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204532, "chapter_id": 5358, "verse_number": "२१", "content_sanskrit": "शरीरात्मसमाहारो जनुरित्यभिधीयते ।\nतत्रात्मानं नित्यमाहुरनित्यं क्षेत्रमुच्यते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204533, "chapter_id": 5358, "verse_number": "२२", "content_sanskrit": "तत्तु कालवशाल्लोके जीर्णं भवति शोभने ।\nकालश्छिनत्ति चायूंषि दिनमासर्तुहायनैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204534, "chapter_id": 5358, "verse_number": "२३", "content_sanskrit": "कालः पचति भूतानि कालेनाकुलितं जगत् ।\nकालं नातिक्रमेरन् हि सदेवासुरमानवाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204535, "chapter_id": 5358, "verse_number": "२४", "content_sanskrit": "यथाकाशे न तिष्ठेत द्रव्यं किञ्चिदचेतनम् ।\nतथा धावति कालोऽयं क्षणं किञ्चिन्न तिष्ठति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204536, "chapter_id": 5358, "verse_number": "२५", "content_sanskrit": "एवं कालेन सङ्क्रान्तं शरीरं जर्झरीकृतम् ।\nअकर्मयोग्यं संशीर्णं त्यक्त्वा देही ततो व्रजेत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204537, "chapter_id": 5358, "verse_number": "२६", "content_sanskrit": "न च नित्यस्य जीवस्य विनाशो विद्यते शुभे ।\nस पुनर्जायतेऽन्यत्र शरीरं नवमाविशन् ।\nएवं लोकगतिर्नित्यमादिप्रभृति वर्तते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204538, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204539, "chapter_id": 5358, "verse_number": "२७", "content_sanskrit": "भगवन् प्राणिनो बाला दृश्यन्ते मरणं गताः ।\nअतिवृद्धाश्च जीवन्तो दृश्यन्ते चिरजीविनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204540, "chapter_id": 5358, "verse_number": "२८", "content_sanskrit": "केवलं कालमरणं न प्रमाणं महेश्वर ।\nतस्मान्मे संशय ब्रूहि प्राणिनां जीवकारणम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204541, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204542, "chapter_id": 5358, "verse_number": "२९", "content_sanskrit": "शृणु तत्कारणं देवि निर्णयस्त्वेक एव सः ।\nजीर्णत्वमात्रं कुरुते कालो देहं न पातयेत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204543, "chapter_id": 5358, "verse_number": "३०", "content_sanskrit": "जीर्णे कर्मणि सङ्घातः स्वयमेव विशीर्यते ।\nपूर्वकर्मप्रमाणेन जीवितं मृत्युरेव वा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204544, "chapter_id": 5358, "verse_number": "३१", "content_sanskrit": "यावत् पूर्वकृतं कर्म तावज्जीवति मानवः ।\nतद्वत् कालवशाद् बाला म्रियन्ते भोगसङ्क्षयात्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204545, "chapter_id": 5358, "verse_number": "३२", "content_sanskrit": "जीवन्ति चिरवृद्धाश्च तथा कर्मप्रमाणतः ।\nइति ते कथितं देवि निर्विशङ्का भव प्रिये\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204546, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204547, "chapter_id": 5358, "verse_number": "३३", "content_sanskrit": "भगवन् केन वृत्तेन भवन्ति चिरजीविनः ।\nअल्पायुषो नराः केन तन्मे शंसितुमर्हसि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204548, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204549, "chapter_id": 5358, "verse_number": "३४", "content_sanskrit": "शृणु तत्सर्वमखिलं गुह्यं पथ्यतरं नृणाम् ।\nये नरा वृत्तसम्पन्ना भवन्ति चिरजीविनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204550, "chapter_id": 5358, "verse_number": "३५", "content_sanskrit": "अहिंसा सत्यवचनमक्रोधः क्षान्तिरार्जवम् ।\nगुरूणां नित्यशुश्रूषा वृद्धानामपि पूजनम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204551, "chapter_id": 5358, "verse_number": "३६", "content_sanskrit": "शौचं चाकार्यसन्त्यागः सदा पथ्यस्य भोजनम् ।\nएवमादि शुभं वृत्तं नराणां दीर्घजीविनाम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204552, "chapter_id": 5358, "verse_number": "३७", "content_sanskrit": "तपसा ब्रह्मचर्येण रसायननिषेवणात् ।\nउदग्रसत्त्वा बलिनो भवन्ति चिरजीविनः ।\nस्वर्गे वा मानुषे वाऽपि चिरं तिष्ठन्ति धार्मिकाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204553, "chapter_id": 5358, "verse_number": "३८", "content_sanskrit": "अपरे पापकर्माणः प्रायशोऽनृतवादिनः ।\nहिंसाप्रिया गुरुद्विष्टा निष्क्रियाः शौचवर्जिताः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204554, "chapter_id": 5358, "verse_number": "३९", "content_sanskrit": "नास्तिका घोरकर्माणः सततं मांसपानपाः ।\nपापाचारा गुरुद्वेषाः कोपनाः कलहप्रियाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204555, "chapter_id": 5358, "verse_number": "४०", "content_sanskrit": "एवमेवाशुभाचारास्तिष्ठन्ति नरके चिरम् ।\nतिर्यग्योनौ तथाऽत्यन्तमल्पं तिष्ठन्ति मानुषे ।\nतस्मादल्पायुषो मर्त्यास्तादृशाः सम्भवन्ति ते\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204556, "chapter_id": 5358, "verse_number": "४१", "content_sanskrit": "अगम्यदेशगमनादपथ्यानां च भोजनात् ।\nआयुःक्षयो भवेन्नॄणामायुःक्षयकरा हि ते\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2204557, "chapter_id": 5358, "verse_number": "४२", "content_sanskrit": "भवन्त्यल्पायुषस्तैस्तैरन्यथा चिरजीविनः ।\nएतत्ते कथितं सर्वं भूयः श्रोतुं किमिच्छसि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2204558, "chapter_id": 5358, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे नृणामल्पायुष्ट्वादिनिमित्तकथनं नाम नवोत्तरद्विशततमोऽध्यायः ॥२०९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]