[{"id": 6000051000, "chapter_id": 10051, "verse_number": null, "content_sanskrit": "अथ एकविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "स्वायम्भुवमनोः कथाया मध्ये प्रसक्तां भगवतो वराहावतारकथां हिरण्याक्षवधकथां च त्रयोदशाद्यूनविंशान्तैः सप्तभिरध्यायैः परिसमाप्य, विदुरप्रश्नानुरोधेन मैत्रेयेण ब्रह्मकृतयक्षरक्षोगन्धर्वभूतपिशाचादिनानाप्रजासृष्टेर्विस्तरेण कथनम्", "range": null}]}, {"id": 6000051001, "chapter_id": 10051, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.001.m4a", "display_order": 2}, {"id": 6000051002, "chapter_id": 10051, "verse_number": "३-२१-१", "content_sanskrit": "महीं प्रतिष्ठामध्यास्य योऽसौ स्वायम्भुवो मनुः।\nकान्यध्यतिष्ठद् द्वाराणि मार्गायावरजन्मनाम्॥ ३/२१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.002.m4a", "display_order": 3}, {"id": 6000051003, "chapter_id": 10051, "verse_number": "३-२१-२", "content_sanskrit": "क्षत्ता महाभागवतः कृष्णस्यैकान्तिकः सुहृत्।\nयस्तत्याजाग्रजं कृष्णे सापत्यमघवानिति॥ ३/२१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.003.m4a", "display_order": 4}, {"id": 6000051004, "chapter_id": 10051, "verse_number": "३-२१-३", "content_sanskrit": "द्वैपायनादनवमो महित्वे तस्य देहजः।\nसर्वात्मना श्रितः कृष्णं तत्परांश्चाप्यनुव्रतः॥ ३/२१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.004.m4a", "display_order": 5}, {"id": 6000051005, "chapter_id": 10051, "verse_number": "३-२१-४", "content_sanskrit": "किमन्वपृच्छन्मैत्रेयं विदुरस्तीर्थसेवया।\nउपगम्य कुशावर्त आसीनं तत्त्ववित्तमम्॥ ३/२१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.005.m4a", "display_order": 6}, {"id": 6000051006, "chapter_id": 10051, "verse_number": "३-२१-५", "content_sanskrit": "तयोः संवदतोः भद्र प्रवृत्ता ह्यमलाः कथाः।\nआपो गाङ्ग्य इवाघघ्न्यो हरेः पादाम्बुजाश्रयाः॥ ३/२१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.006.m4a", "display_order": 7}, {"id": 6000051007, "chapter_id": 10051, "verse_number": "३-२१-६", "content_sanskrit": "ता नः कीर्तय भद्रं ते कीर्तन्योदारकर्मणः।\nरसज्ञः को नु तृप्येत हरिलीलामृतं पिबन्॥ ३/२१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.007.m4a", "display_order": 8}, {"id": 6000051008, "chapter_id": 10051, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.008.m4a", "display_order": 9}, {"id": 6000051009, "chapter_id": 10051, "verse_number": "३-२१-७", "content_sanskrit": "एवं परीक्षिता पृष्टो भगवान् बादरायणिः।\nभगवत्यर्पिताध्यात्मस्तमाह श्रूयतामिति॥ ३/२१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.009.m4a", "display_order": 10}, {"id": 6000051010, "chapter_id": 10051, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.010.m4a", "display_order": 11}, {"id": 6000051011, "chapter_id": 10051, "verse_number": "३-२१-८", "content_sanskrit": "हरेर्धृतक्रोडतनोः स्वमायया निशम्य गोरुद्धरणं रसातलात्।\nलीलां हिरण्याक्षमवज्ञया हतं सञ्जातहर्षो मुनिमाह भारतः॥ ३/२१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.011.m4a", "display_order": 12}, {"id": 6000051012, "chapter_id": 10051, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.012.m4a", "display_order": 13}, {"id": 6000051013, "chapter_id": 10051, "verse_number": "३-२१-९", "content_sanskrit": "प्रजापतिपतिः सृष्ट्वा प्रजासर्गे प्रजापतीन्।\nकिमारभत मे ब्रह्मन् प्रब्रूह्यव्यक्तमार्गवित्॥ ३/२१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.013.m4a", "display_order": 14}, {"id": 6000051014, "chapter_id": 10051, "verse_number": "३-२१-१०", "content_sanskrit": "ये मरीच्यादयो विप्रा यस्तु स्वायम्भुवो मनुः।\nते वै ब्रह्मण आदेशात् कथमेतदभावयन्॥ ३/२१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.014.m4a", "display_order": 15}, {"id": 6000051015, "chapter_id": 10051, "verse_number": "३-२१-११", "content_sanskrit": "सद्वितीयाः किमसृजन् स्वतन्त्रा उत कर्मभिः।\nआहोस्वित् संहताः सर्व इदं स्म समकल्पयन्॥ ३/२१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.015.m4a", "display_order": 16}, {"id": 6000051016, "chapter_id": 10051, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.016.m4a", "display_order": 17}, {"id": 6000051017, "chapter_id": 10051, "verse_number": "३-२१-१२", "content_sanskrit": "दैवेन दुर्वितर्क्येण परेणानिमिषेण च।\nजातक्षोभाद् भगवतो महानासीद् गुणत्रयात्॥ ३/२१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.017.m4a", "display_order": 18}, {"id": 6000051018, "chapter_id": 10051, "verse_number": "३-२१-१३", "content_sanskrit": "रजःप्रधानान्महतस्‍त्रिलिङ्गो दैवचोदितात्।\nजातः ससर्ज भूतादिर्वियदादीनि पञ्च च॥ ३/२१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.018.m4a", "display_order": 19}, {"id": 6000051019, "chapter_id": 10051, "verse_number": "३-२१-१४", "content_sanskrit": "तानि चैकैकशः स्रष्टुमसमर्थानि भौतिकम्।\nसंहत्य देवयोगेन हैममण्डमवासृजन्॥ ३/२१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.019.m4a", "display_order": 20}, {"id": 6000051020, "chapter_id": 10051, "verse_number": "३-२१-१५", "content_sanskrit": "सोऽशयिष्टाधिसलिले आण्डकोशो निरात्मकः।\nसाग्रं वै वर्षसाहस्रमन्ववात्सीत् तमीश्वरः॥ ३/२१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.020.m4a", "display_order": 21}, {"id": 6000051021, "chapter_id": 10051, "verse_number": "३-२१-१६", "content_sanskrit": "तस्य नाभेरभूत् पद्मं सहस्रार्कोरुदीधिति।\nसर्वजीवनिकायौको यतः स्वयमभूत् स्वराट्॥ ३/२१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.021.m4a", "display_order": 22}, {"id": 6000051022, "chapter_id": 10051, "verse_number": "३-२१-१७", "content_sanskrit": "सोऽनुविष्टो भगवता यः शेते सलिलाशये।\nलोकसंस्था यथापूर्वं निर्ममे संस्थया स्वया॥ ३/२१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.022.m4a", "display_order": 23}, {"id": 6000051023, "chapter_id": 10051, "verse_number": "३-२१-१८", "content_sanskrit": "ससर्ज च्छाययाऽविद्यां पञ्चपर्वाणमग्रतः।\nतामिस्रमन्धतामिस्रं तमो मोहो महातमः॥ ३/२१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.023.m4a", "display_order": 24}, {"id": 6000051024, "chapter_id": 10051, "verse_number": "३-२१-१९", "content_sanskrit": "विससर्जाऽत्मनः कायं नाभ्यनन्दत् तमोमयम्।\nजगृहुर्यक्षरक्षांसि रात्रिं क्षुत्तृट्‌समुद्भवाम्॥ ३/२१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.024.m4a", "display_order": 25}, {"id": 6000051025, "chapter_id": 10051, "verse_number": "३-२१-२०", "content_sanskrit": "क्षुत्तृड्भ्यामुपसृष्टास्ते तं जग्धुमभिदुद्रुवुः।\nमा रक्षतैनं जक्षध्वमित्युच्चैः क्षुत्तृडर्दिताः॥ ३/२१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.025.m4a", "display_order": 26}, {"id": 6000051026, "chapter_id": 10051, "verse_number": "३-२१-२१", "content_sanskrit": "देवस्तानाह संविग्नो मा मा जक्षत रक्षत।\nअहो मे यक्षरक्षांसि प्रजा यूयं भविष्यथ॥ ३/२१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.026.m4a", "display_order": 27}, {"id": 6000051027, "chapter_id": 10051, "verse_number": "३-२१-२२", "content_sanskrit": "देवताः प्रभया या या दिव्याः प्रमुखतोऽसृजत्।\nतेऽहार्षुर्देवयन्तोऽपि विसृष्टां तां प्रभामहः॥ ३/२१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.027.m4a", "display_order": 28}, {"id": 6000051028, "chapter_id": 10051, "verse_number": "३-२१-२३", "content_sanskrit": "देवोऽदेवान् जघनतः सृजति स्मातिलोलुपान्।\nत एनं लोलुपतया मैथुनायाभिपेदिरे॥ ३/२१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.028.m4a", "display_order": 29}, {"id": 6000051029, "chapter_id": 10051, "verse_number": "३-२१-२४", "content_sanskrit": "ततो हसन् स भगवानसुरैर्निरपत्रपैः।\nअन्वीयमानस्तरसा क्रुद्धो भीतः परापतत्॥ ३/२१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.029.m4a", "display_order": 30}, {"id": 6000051030, "chapter_id": 10051, "verse_number": "३-२१-२५", "content_sanskrit": "स उपव्रज्य वरदं प्रपन्नार्तिहरं हरिम्।\nअनुग्रहाय भक्तानामनुरूपात्मदर्शनम्॥ ३/२१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.030.m4a", "display_order": 31}, {"id": 6000051031, "chapter_id": 10051, "verse_number": "३-२१-२६", "content_sanskrit": "पाहि मां परमात्मंस्ते प्रेषणेनासृजं प्रजाः।\nता इमा यभितुं पापा उपक्रामन्ति मां प्रभो॥ ३/२१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.031.m4a", "display_order": 32}, {"id": 6000051032, "chapter_id": 10051, "verse_number": "३-२१-२७", "content_sanskrit": "त्वमेकः किल लोकानां क्लिष्टानां क्लेशनाशनः।\nत्वमेकः क्लेशदस्तेषामनासन्नपदां तव॥ ३/२१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.032.m4a", "display_order": 33}, {"id": 6000051033, "chapter_id": 10051, "verse_number": "३-२१-२८", "content_sanskrit": "सोऽवधार्यास्य कार्पण्यं विविक्ताध्यात्मदर्शनः।\nविमुञ्चात्मतनुं घोरामित्युक्तो विमुमोच ह॥ ३/२१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.033.m4a", "display_order": 34}, {"id": 6000051034, "chapter_id": 10051, "verse_number": "३-२१-२९", "content_sanskrit": "तां क्‍वणच्चरणाम्भोजां मदविह्वललोचनाम्।\nकाञ्चीकलापविलसद्दुकूलच्छन्नरोधसम्॥ ३/२१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.034.m4a", "display_order": 35}, {"id": 6000051035, "chapter_id": 10051, "verse_number": "३-२१-३०", "content_sanskrit": "अन्योन्याश्लेषयोत्तुङ्गनिरन्तरपयोधराम्।\nसुनासां सुद्विजां स्निग्धहासलीलावलोकनाम्॥ ३/२१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.035.m4a", "display_order": 36}, {"id": 6000051036, "chapter_id": 10051, "verse_number": "३-२१-३१", "content_sanskrit": "गूहन्तीं व्रीडयाऽऽत्मानं नीलालकवरूथिनीम्।\nउपलभ्यासुराः सन्ध्यां सर्वे तां मुमुहुः स्‍त्रियम्॥ ३/२१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.036.m4a", "display_order": 37}, {"id": 6000051037, "chapter_id": 10051, "verse_number": "३-२१-३२", "content_sanskrit": "अहो रूपमहो धैर्यमहो अस्या नवं वयः।\nमध्ये कामयमानानामकामेव विसर्पति॥ ३/२१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.037.m4a", "display_order": 38}, {"id": 6000051038, "chapter_id": 10051, "verse_number": "३-२१-३३", "content_sanskrit": "वितर्कयन्तो बहुधा तां सन्ध्यां प्रमदाकृतिम्।\nअभिसम्भाव्य विस्रम्भात् पर्यपृच्छन् कुमेधसः॥ ३/२१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.038.m4a", "display_order": 39}, {"id": 6000051039, "chapter_id": 10051, "verse_number": "३-२१-३४", "content_sanskrit": "काऽसि कस्यासि रम्भोरु को वासस्तेऽत्र भामिनि।\nरूपद्रविणपण्येन दुर्भगान् नो विबाधसे॥ ३/२१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.039.m4a", "display_order": 40}, {"id": 6000051040, "chapter_id": 10051, "verse_number": "३-२१-३५", "content_sanskrit": "या वा काऽसि त्वमबले दिष्ट्या सन्दर्शनं तव।\nउद्धुनोषीक्ष्यमाणानां कन्दुकक्रीडया मनः॥ ३/२१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.040.m4a", "display_order": 41}, {"id": 6000051041, "chapter_id": 10051, "verse_number": "३-२१-३६", "content_sanskrit": "नैकत्र ते जयति शालिनि पादपद्मं घ्नन्त्या मुहुः करतलेन पतत्पतङ्गम्।\nमध्यं विषीदति बृहत्स्तनभारभीतं शान्ता च दृष्टिरमलः सुजटावरूथः॥ ३/२१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.041.m4a", "display_order": 42}, {"id": 6000051042, "chapter_id": 10051, "verse_number": "३-२१-३७", "content_sanskrit": "इति सायन्तनीं सन्ध्यामसुराः प्रमदायतीम्।\nप्रलोभयन्तीं जगृहुर्मत्वा मूढधियः स्‍त्रियम्॥ ३/२१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.042.m4a", "display_order": 43}, {"id": 6000051043, "chapter_id": 10051, "verse_number": "३-२१-३८", "content_sanskrit": "प्रहस्य भावगम्भीरं जिघ्रन्त्यात्मानमात्मना।\nकान्त्या ससर्ज भगवान् गन्धर्वाप्सरसां गणान्॥ ३/२१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.043.m4a", "display_order": 44}, {"id": 6000051044, "chapter_id": 10051, "verse_number": "३-२१-३९", "content_sanskrit": "विससर्ज तनुं तां वै ज्योत्स्नां कान्तिमतीं प्रियाम्।\nतामेव चाददुः प्रीत्या विश्वावसुपुरोगमाः॥ ३/२१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.044.m4a", "display_order": 45}, {"id": 6000051045, "chapter_id": 10051, "verse_number": "३-२१-४०", "content_sanskrit": "सृष्ट्वा भूतपिशाचांश्च भगवानात्मतन्द्रिणा।\nदिग्वाससो मुक्तकेशान् वीक्ष्य चामीलयद् दृशौ॥ ३/२१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.045.m4a", "display_order": 46}, {"id": 6000051046, "chapter_id": 10051, "verse_number": "३-२१-४१", "content_sanskrit": "जगृहुस्तद्विसृष्टां तां जृम्भणाख्यां तनुं प्रभोः। निद्रादीन्द्रियविक्लेदो यया भूतेषु दृश्यते।\nतयोच्छिष्टान् धर्षयन्ति तमुन्मादं प्रचक्षते॥ ३/२१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.046.m4a", "display_order": 47}, {"id": 6000051047, "chapter_id": 10051, "verse_number": "३-२१-४२", "content_sanskrit": "ऊर्जस्वन्तं मन्यमान आत्मानं भगवानजः।\nसाध्यान् गणान् पितृगणान् परोक्षेणासृजत् प्रभुः॥ ३/२१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.047.m4a", "display_order": 48}, {"id": 6000051048, "chapter_id": 10051, "verse_number": "३-२१-४३", "content_sanskrit": "त आत्मसर्गं तत्कायं पितरः प्रतिपेदिरे।\nसाध्येभ्यश्च पितृभ्यश्च कवयो यद् वितन्वते॥ ३/२१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.048.m4a", "display_order": 49}, {"id": 6000051049, "chapter_id": 10051, "verse_number": "३-२१-४४", "content_sanskrit": "सिद्धान् विद्याधरांश्चैव तिरोधानेन सोऽसृजत्।\nतेभ्यो ददौ तमात्मानमन्तर्धानाख्यमद्भुतम्॥ ३/२१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.049.m4a", "display_order": 50}, {"id": 6000051050, "chapter_id": 10051, "verse_number": "३-२१-४५", "content_sanskrit": "स किन्नरान् किम्पुरुषानात्मना चासृजत् प्रभुः।\nमानयन्नात्मनाऽऽत्मानम् आत्माभासं विलोकयन्॥ ३/२१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.050.m4a", "display_order": 51}, {"id": 6000051051, "chapter_id": 10051, "verse_number": "३-२१-४६", "content_sanskrit": "ते तु तज्जगृहू रूपं त्यक्तं यत् परमेष्ठिना।\nमिथुनीभूय गायन्तस्तमेवोषसि कर्मभिः॥ ३/२१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.051.m4a", "display_order": 52}, {"id": 6000051052, "chapter_id": 10051, "verse_number": "३-२१-४७", "content_sanskrit": "देहेन वै भोगवता शयानो बहुचिन्तया।\nसर्गेऽनुपचिते क्रोधादुत्ससर्ज हि तद्वपुः॥ ३/२१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.052.m4a", "display_order": 53}, {"id": 6000051053, "chapter_id": 10051, "verse_number": "३-२१-४८", "content_sanskrit": "येऽहीयन्तामुतः केशा अहयस्तेऽङ्ग जज्ञिरे।\nसर्पा विसर्पतः क्रूरा नागा भोगोरुकन्धराः॥ ३/२१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.053.m4a", "display_order": 54}, {"id": 6000051054, "chapter_id": 10051, "verse_number": "३-२१-४९", "content_sanskrit": "स आत्मानं मन्यमानः कृतकृत्यमिवात्मभूः।\nतदा मनून् ससर्जान्ते मनसा लोकभावनान्॥ ३/२१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.054.m4a", "display_order": 55}, {"id": 6000051055, "chapter_id": 10051, "verse_number": "३-२१-५०", "content_sanskrit": "तेभ्यः स व्यसृजद् देहं परः पुरुष आत्मनः।\nतां दृष्ट्वा ये पुरा सृष्टाः प्रशशंसुः प्रजापतिम्॥ ३/२१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.055.m4a", "display_order": 56}, {"id": 6000051056, "chapter_id": 10051, "verse_number": "३-२१-५१", "content_sanskrit": "अहो एतज्जगत्स्रष्टः सुकृतं बत ते कृतम्।\nप्रतिष्ठिताः क्रिया यस्मिन् साकमन्नमदामहे॥ ३/२१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.056.m4a", "display_order": 57}, {"id": 6000051057, "chapter_id": 10051, "verse_number": "३-२१-५२", "content_sanskrit": "तपसा विद्यया युक्तो योगेन सुसमाधिना।\nआदावृषीन् हृषीकेशः ससर्जाभिमताः प्रजाः॥ ३/२१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.057.m4a", "display_order": 58}, {"id": 6000051058, "chapter_id": 10051, "verse_number": "३-२१-५३", "content_sanskrit": "तेभ्यश्चैकैकशस्तस्य देहस्यांशमदादजः।\nयत् तत् समाधियोगर्द्धितपोविद्याविरक्तिमत्॥ ३/२१/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_021/BhP_03.021.058.m4a", "display_order": 59}, {"id": 6000051059, "chapter_id": 10051, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे एकविंशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]