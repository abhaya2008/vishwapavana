[{"id": 900009201, "chapter_id": 8733, "verse_number": "23.1", "content_sanskrit": "‘‘स्वर्गकामो यजेत’’ इत्यादौ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009202, "chapter_id": 8733, "verse_number": "23.2", "content_sanskrit": "किञ्च न लिङा साक्षात्साधनत्वं बोध्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009203, "chapter_id": 8733, "verse_number": "23.3", "content_sanskrit": "न च सामान्यज्ञानं विशेषज्ञानपूर्वकमिति नियमोस्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009204, "chapter_id": 8733, "verse_number": "23.4", "content_sanskrit": "किं चैवं यदुत्पत्त्यनन्तरमेव १कार्योत्पत्तिस्तत्रैव कामिनः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009205, "chapter_id": 8733, "verse_number": "23.5", "content_sanskrit": "किञ्चैवं विलम्बेन महाव्याधिनिवृत्तिकाम ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009206, "chapter_id": 8733, "verse_number": "23.6", "content_sanskrit": "किञ्च मास्तु प्रथमं यागे फलसाधनताधीः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009207, "chapter_id": 8733, "verse_number": "23.7", "content_sanskrit": "किञ्च यथाऽऽग्नेयादिषट्कस्य ब्राह्मणावगोरणस्य च ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009208, "chapter_id": 8733, "verse_number": "23.8", "content_sanskrit": "यदि च काम्यस्थळे क्रियाया..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009209, "chapter_id": 8733, "verse_number": "23.9", "content_sanskrit": "अपि च..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009210, "chapter_id": 8733, "verse_number": "23.10", "content_sanskrit": "किंच पीनश्चैत्रो दिवा न भुङ्क्ते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009211, "chapter_id": 8733, "verse_number": "23.11", "content_sanskrit": "किं च लोके लिङ्१शब्दशक्यत्वेन निश्चितस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009212, "chapter_id": 8733, "verse_number": "23.12", "content_sanskrit": "किञ्च केयं योग्यता या व्यवहिते नास्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009213, "chapter_id": 8733, "verse_number": "23.13", "content_sanskrit": "नाप्यन्वयविरोधिरूपविरहो योग्यता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009214, "chapter_id": 8733, "verse_number": "23.14", "content_sanskrit": "तस्माद् बाधकप्रमाणाभाव एव योग्यता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009215, "chapter_id": 8733, "verse_number": "23.15", "content_sanskrit": "किं चापूर्वे लिङादेः शक्तिग्रहो न तावत्कार्यत्वेन वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009216, "chapter_id": 8733, "verse_number": "23.16", "content_sanskrit": "किं चैवं नित्यस्थे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009217, "chapter_id": 8733, "verse_number": "23.17", "content_sanskrit": "न्यायमते त्वपूर्वस्य कल्प्यत्वमयुक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009218, "chapter_id": 8733, "verse_number": "23.18", "content_sanskrit": "मम त्वनन्यथासिद्धनियतपूर्ववृत्तित्वं न कारणत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009219, "chapter_id": 8733, "verse_number": "23.19", "content_sanskrit": "ननु अस्तु यागध्वंस एव यागस्य व्यापारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009220, "chapter_id": 8733, "verse_number": "23.20", "content_sanskrit": "ननु– तर्हि देवताप्रीतिरेव यागव्यापारोस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009221, "chapter_id": 8733, "verse_number": "23.21", "content_sanskrit": "ननु क्षणिकब्रह्महत्यादिक्रियायाः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900009222, "chapter_id": 8733, "verse_number": "23.22", "content_sanskrit": "यत्तु मणौ– वैकल्पिकव्रीहियवसाध्ये यागे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900009223, "chapter_id": 8733, "verse_number": "23.23", "content_sanskrit": "यत्र तु साधने यागादौ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900009224, "chapter_id": 8733, "verse_number": "23.24", "content_sanskrit": "यत्तु मणौ गयाश्राद्धादावपूर्वस्यौत्सर्गिकं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]