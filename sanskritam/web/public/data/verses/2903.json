[{"id": 2088962, "chapter_id": 2903, "verse_number": "१३-३३-१", "content_sanskrit": "`युधिष्ठिर उवाच।\nप्रायश्चित्तं कृतघ्नानां प्रतिब्रूहि पितामह।\nमातॄः पितॄन्गुरुंश्चैव येऽवमन्यन्ति मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088963, "chapter_id": 2903, "verse_number": "१३-३३-२", "content_sanskrit": "ये चाप्यन्ते परे तात कृतघ्ना निरपत्रपाः।\nतेषां गतिं महाबाहो श्रोतुमिच्छामि तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088964, "chapter_id": 2903, "verse_number": "१३-३३-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088965, "chapter_id": 2903, "verse_number": "१३-३३-३", "content_sanskrit": "कृतघ्नानां गतिस्तात नरके शाश्वतीः समाः।\nमातापितृगुरूणां च ये न तिष्ठन्ति शासने।\nक्रिमिकीटपिपीलेषु जायन्ते स्थावरेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088966, "chapter_id": 2903, "verse_number": "१३-३३-४", "content_sanskrit": "दुर्लभो हि पुनस्तेषां मानुष्ये पुनरुद्भवः।\nअत्राप्युदाहरन्तीममितिहासं पुरातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088967, "chapter_id": 2903, "verse_number": "१३-३३-५", "content_sanskrit": "वत्सनाभो महाप्राज्ञो महर्षिः संशितव्रतः।\nवल्मीकभूतो ब्रह्मर्षिस्तप्यते सुमहत्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088968, "chapter_id": 2903, "verse_number": "१३-३३-६", "content_sanskrit": "तस्मिंश्च तप्यति तपो वासवो भरतर्षभ।\nववर्ष समुहद्वर्षं सविद्युत्स्तनयित्नुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088969, "chapter_id": 2903, "verse_number": "१३-३३-७", "content_sanskrit": "तत्र सप्ताहवर्षं तु मुमुचे पाकशासनः।\nनिमीलिताक्षस्तद्वर्षं प्रत्यगृह्यत वै द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088970, "chapter_id": 2903, "verse_number": "१३-३३-८", "content_sanskrit": "तस्मिन्पतति वर्षे तु शीतवातसमन्विते।\nविशीर्णध्वस्तशिखरो वल्मीकोऽशनिताडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088971, "chapter_id": 2903, "verse_number": "१३-३३-९", "content_sanskrit": "ताड्यमाने ततस्तस्मिन्वत्सनाभे महात्मनि।\nकारुण्यात्तस्य धर्मः स्वमानृशंस्यमथाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088972, "chapter_id": 2903, "verse_number": "१३-३३-१०", "content_sanskrit": "चिन्तयानस्य ब्रह्मर्षि तपन्तमतिधार्मिकम्।\nअनुरूपा मतिः क्षिप्रमुपजाता स्वभावजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088973, "chapter_id": 2903, "verse_number": "१३-३३-११", "content_sanskrit": "स्वं रूपं माहिषं कृत्वा ********* मनोहरम्।\nरक्षार्थं वत्सनामस्य चतुष्पादुपरिस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088974, "chapter_id": 2903, "verse_number": "१३-३३-१२", "content_sanskrit": "यदा त्वपगतं वर्षं वृष्टिवातसमन्वितम्।\nततो महिषरुपेण धर्मो धर्मभृतांवर।\nशनैर्वल्मीकमुत्सृज्य प्राद्रवद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088975, "chapter_id": 2903, "verse_number": "१३-३३-१३", "content_sanskrit": "स्थितेऽस्मिन्वृष्टिसम्पाते वीक्षते स्म महातपाः।\nदिशश्च विपुलास्तत्र गिरीणां शिखराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088976, "chapter_id": 2903, "verse_number": "१३-३३-१४", "content_sanskrit": "दृष्ट्वा च पृथिवीं सर्वां सलिलेन परिप्लुताम्।\nजलाशयान्स तान्दृष्ट्वा विप्रः प्रमुदितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088977, "chapter_id": 2903, "verse_number": "१३-३३-१५", "content_sanskrit": "अचिन्तयद्विस्मितश्चि विप्रः प्रमुदितोऽभवत्॥\nअचिन्तयद्विस्तितश्च वर्षात्केनाभिरक्षितः।\nततोऽपश्यत्स महिषमवस्थितमदूरतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088978, "chapter_id": 2903, "verse_number": "१३-३३-१६", "content_sanskrit": "तिर्यग्योनावपि कथं दृश्यते धर्मवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088979, "chapter_id": 2903, "verse_number": "१३-३३-१७", "content_sanskrit": "अतो नु भद्रमहिषः शिलापट्टमवस्थितः।\nपीवरश्चैव बल्यश्च बहुमांसो भवेदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088980, "chapter_id": 2903, "verse_number": "१३-३३-१८", "content_sanskrit": "तस्य बुद्धिरियं जाता धर्मसंसक्तजा मुनेः।\nकृतघ्ना नरकं यान्ति ये च विश्वस्तघातिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088981, "chapter_id": 2903, "verse_number": "१३-३३-१९", "content_sanskrit": "निष्कृतिं नैव पश्यामि कृतघ्नानां कथञ्चन।\nक्रते प्राणिपरित्यागाद्धर्मज्ञानां वचो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088982, "chapter_id": 2903, "verse_number": "१३-३३-२०", "content_sanskrit": "अकृत्वा भरणं पित्रोरदत्त्वा गुरुदक्षिणाम्।\nकृतघ्नतां च सम्प्राप्य मरणान्ता च निष्कृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088983, "chapter_id": 2903, "verse_number": "१३-३३-२१", "content_sanskrit": "आकाङ्क्षायामुपेक्षायां चोपपातकमुत्तमम्।\nतस्मात्प्राणान्परित्यक्ष्ये प्रायश्चित्तार्थमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088984, "chapter_id": 2903, "verse_number": "१३-३३-२२", "content_sanskrit": "स मेरुशिखरं गत्वा निस्यङ्केनान्तरात्मना।\nप्रायश्चित्तं कर्तुकामः शरीरं त्यक्तुमुद्यतः।\nनिगृहीतश्च धर्मात्मा हस्ते धर्मेण धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088985, "chapter_id": 2903, "verse_number": "१३-३३-२३x", "content_sanskrit": "धर्मि उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088986, "chapter_id": 2903, "verse_number": "१३-३३-२३", "content_sanskrit": "वत्सनाभ महाप्राज्ञ बहुवर्षशतायुष।\nपरितुष्टोस्मि त्यागेन निस्सङ्गेन तथाऽऽत्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088987, "chapter_id": 2903, "verse_number": "१३-३३-२४", "content_sanskrit": "एवं धर्मभृतः सर्वे विमृशन्ति कृताकृतम्।\nन कश्चिद्वत्सनाभस्य यस्य नोपहतं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088988, "chapter_id": 2903, "verse_number": "१३-३३-२५", "content_sanskrit": "यश्चानवद्यश्चरति शक्तो धर्मं च सर्वशः।\nनिवर्तस्व महाप्राज्ञ् पूतात्मा ह्यसि शाश्वतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088989, "chapter_id": 2903, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रयस्त्रिंशोऽध्यायः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]