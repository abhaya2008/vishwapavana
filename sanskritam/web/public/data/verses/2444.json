[{"id": 2068869, "chapter_id": 2444, "verse_number": "९-६२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068870, "chapter_id": 2444, "verse_number": "९-६२-१", "content_sanskrit": "हतं दुर्योधनं दृष्ट्वा भीमसेनेन संयुगे।\nपाण्डवाः सृञ्जयाश्चैव किमकुर्वत सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068871, "chapter_id": 2444, "verse_number": "९-६२-२x", "content_sanskrit": "स़ञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068872, "chapter_id": 2444, "verse_number": "९-६२-२", "content_sanskrit": "हतं दुर्योधनं दृष्ट्वा भीमसेनेन संयुगे।\nसिंहेनेव महाराज मत्तं वनगजं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068873, "chapter_id": 2444, "verse_number": "९-६२-३", "content_sanskrit": "प्रहृष्टमनसस्तत्र कृष्णेन सह पाण्डवाः।\nपाञ्चालाः सृञ्जयाश्चैव निहते कुरुनन्दने।\nआविध्यन्नुत्तरीयाणि सिंहनादांश्च नेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068874, "chapter_id": 2444, "verse_number": "९-६२-४", "content_sanskrit": "नैतान्हर्षसमाविष्टानियं सेहे वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068875, "chapter_id": 2444, "verse_number": "९-६२-५", "content_sanskrit": "धनूंष्येके व्याक्षिपन्त ज्याश्चाप्यन्ये तथाऽक्षिपन्।\nदध्मुरन्ये महाशङ्खानन्ये जघ्नुश्च दुन्दुभीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068876, "chapter_id": 2444, "verse_number": "९-६२-६", "content_sanskrit": "चिकीडुश्च तथैवान्ये जहसुश्च तवाहिताः।\nअब्रुवंश्चासकृद्वीरा भीमसेनमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068877, "chapter_id": 2444, "verse_number": "९-६२-७", "content_sanskrit": "दुष्करं भवता कर्म रणेऽद्य सुमहत्कृतम्।\nकौरवेयं रणे हत्वा गदयाऽतिकृतश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068878, "chapter_id": 2444, "verse_number": "९-६२-८", "content_sanskrit": "इन्द्रेणेव हि वृत्रस्य वधं परमसंयुगे।\nत्वया कृतममन्यन्त शत्रोर्वधमिमं जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068879, "chapter_id": 2444, "verse_number": "९-६२-९", "content_sanskrit": "चरन्तं विविधान्मार्गान्मण्डलानि च सर्वशः।\nदुर्योधनमिमं शूरं कोऽन्यो हन्याद्वृकोदरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068880, "chapter_id": 2444, "verse_number": "९-६२-१०", "content_sanskrit": "वैरस्य च गतः पारं त्वमिहान्यैः सुदुर्गमम्।\nअशक्यमेतदन्येन सम्पादयितुमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068881, "chapter_id": 2444, "verse_number": "९-६२-११", "content_sanskrit": "कुञ्जरेणेव मत्तेन वीरसङ्ग्राममूर्धनि।\nदुर्योधपशिरो दिष्ट्या पादेन मृदितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068882, "chapter_id": 2444, "verse_number": "९-६२-१२", "content_sanskrit": "सिंहेन महिषस्येव कृत्वा सङ्गरमुत्तमम्।\nदुःशासनस्य रुधिरं दिष्ट्या पीतं त्वयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068883, "chapter_id": 2444, "verse_number": "९-६२-१३", "content_sanskrit": "ये विप्रकुर्वन्राजानं धर्मात्मानं युधिष्ठिरम्।\nमूर्ध्नि तेषां कृतः पादो दिष्ट्या ते स्वेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068884, "chapter_id": 2444, "verse_number": "९-६२-१४", "content_sanskrit": "अमित्राणामधिष्ठानाद्वधाद्दुर्योधनस्य च।\nभीम दिष्ट्या पृथिव्यां ते प्रथितं सुमहद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068885, "chapter_id": 2444, "verse_number": "९-६२-१५", "content_sanskrit": "एवं नूनं हते वृत्रे शक्रं नन्दन्ति बन्दिनः।\nतथा त्वां निहतामित्रं वयं नन्दाम भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068886, "chapter_id": 2444, "verse_number": "९-६२-१६", "content_sanskrit": "दुर्योधनवधे यानि रोमाणि हृषितानि नः।\nअद्यापि न विकृष्यन्ते तानि तद्विद्धि भारत।\nइत्यब्रुन्भीमसेनं वातिकास्तत्र सङ्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068887, "chapter_id": 2444, "verse_number": "९-६२-१७", "content_sanskrit": "तान्हृष्टान्पुरुषव्याघ्रान्पाञ्चालान्पाण्डवैः सह।\nब्रुवतोऽसदृशं तत्र प्रोवाच मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068888, "chapter_id": 2444, "verse_number": "९-६२-१८", "content_sanskrit": "न न्याय्यं निहतं शत्रुं भूयो हन्तुं नराधिपाः।\nअसकृद्वाग्भिरुग्राभिर्निहतो ह्येष मन्दधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068889, "chapter_id": 2444, "verse_number": "९-६२-१९", "content_sanskrit": "तदैवैष हतः पापो यदैव निरपत्रपः।\nलुब्धः पापसहायश्च सुहृदां शासनातिगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068890, "chapter_id": 2444, "verse_number": "९-६२-२०", "content_sanskrit": "बहुशो विदुरद्रोणकृपगाङ्गेयसृञ्जयैः।\nपाण्डुभ्यः प्रार्थ्यमानोऽपि पित्र्यमंशं न दत्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068891, "chapter_id": 2444, "verse_number": "९-६२-२१", "content_sanskrit": "नैव तेभ्योऽद्य मित्रं वा शत्रुर्वा पुरुषाधमः।\nकिमनेन वितुन्नेन वाग्भिः काष्ठसधर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068892, "chapter_id": 2444, "verse_number": "९-६२-२२", "content_sanskrit": "रथेष्वारोहत क्षिप्रं गच्छामो वसुधाधिपाः।\nदिष्ट्या हतोऽयं पापात्मा सामात्यज्ञातिबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068893, "chapter_id": 2444, "verse_number": "९-६२-२३", "content_sanskrit": "इति श्रुत्वा त्वधिक्षेपं कृष्णाद्दुर्योधनो नृपः।\nअमर्षवशमापन्न उदतिष्ठद्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068894, "chapter_id": 2444, "verse_number": "९-६२-२४", "content_sanskrit": "स्फिग्देशेनोपविष्टः स दोर्भ्यां विष्टभ्य मेदिनीम्।\nदृष्टिं भ्रूसङ्कटां कृत्वा वासुदेवे न्यपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068895, "chapter_id": 2444, "verse_number": "९-६२-२५", "content_sanskrit": "अर्धोन्नतशरीरस्य रूपमासीन्नृपस्य तु।\nक्रुद्धस्याशीविषस्येव च्छिन्नपुच्छस्य भोगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068896, "chapter_id": 2444, "verse_number": "९-६२-२६", "content_sanskrit": "प्राणान्तकरिणीं घोरां वेदनामप्यचिन्तयन्।\nदुर्योधनो वासुदेवं वाग्भिरुग्राभिरार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068897, "chapter_id": 2444, "verse_number": "९-६२-२७", "content_sanskrit": "कंसदासस्य दायाद न ते लज्जाऽस्त्यनेन वै।\nअधर्मेण गदायुद्धे यदर्हं विनिपातितः।\nऊरूभिन्धीति भीमस्य स्मृतिं मिथ्याप्रयच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068898, "chapter_id": 2444, "verse_number": "९-६२-२८", "content_sanskrit": "किं न विज्ञातमेतन्मे यदर्जुनमवोचथाः।\nघातयित्वा महीपालानृजुयुद्धान्सहस्रशः।\nजिह्मैरुपायैर्बहुभिर्न ते लज्जा न ते घृणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068899, "chapter_id": 2444, "verse_number": "९-६२-२९", "content_sanskrit": "अहन्यहनि शूराणां कुर्वाणः कदनं महत्।\nशिखण्डिनं पुरस्कृत्य घातितस्ते पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068900, "chapter_id": 2444, "verse_number": "९-६२-३०", "content_sanskrit": "अश्वत्थाम्नः सनामानं हत्वा नागं सुदुर्मते।\nआचार्यो न्यासितः शस्त्रं किं तन्न विदितं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068901, "chapter_id": 2444, "verse_number": "९-६२-३१", "content_sanskrit": "स चानेन नृशंसेन धृष्टद्युम्नेन वीर्यवान्।\nपात्यमानस्त्वया दृष्टो न चैनं त्वमवारयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068902, "chapter_id": 2444, "verse_number": "९-६२-३२", "content_sanskrit": "वधार्थं पाण्डुपुत्रस्य याचितां शक्तिमेव च।\nघटोत्कचे व्यंसयतः कस्त्वत्तः पापकृत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068903, "chapter_id": 2444, "verse_number": "९-६२-३३", "content_sanskrit": "छिन्नहस्तः प्रायगतस्तथा भूरिश्रवा बली।\nत्वयाऽभिसृष्टेन हतः शैनेयेन दुरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068904, "chapter_id": 2444, "verse_number": "९-६२-३४", "content_sanskrit": "कुर्वाणश्चोत्तमं कर्म कर्णः पार्थजिगीषया।\nव्यंसनेनाश्वसेनस्य पन्नगेन्द्रस्य वै पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068905, "chapter_id": 2444, "verse_number": "९-६२-३५", "content_sanskrit": "पुनश्च पतिते चक्रे व्यसनार्तः पराजितः।\nपापितः समरे कर्णश्चक्रव्याग्रोऽग्रणीर्नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068906, "chapter_id": 2444, "verse_number": "९-६२-३६", "content_sanskrit": "यदि मां चापि कर्णं च भीष्मद्रोणौ च संयुगे।\nऋजुना प्रतियुध्येथा न ते स्याद्विजयो ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068907, "chapter_id": 2444, "verse_number": "९-६२-३७", "content_sanskrit": "त्वया पुनरनार्येण जिह्ममार्गेण पार्थिवाः।\nस्वधर्ममनुतिष्ठन्तो वयं चान्ये च घातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068908, "chapter_id": 2444, "verse_number": "९-६२-३८", "content_sanskrit": "`त्वया मायाविना कृष्ण मायां कर्मप्रमोषिणीम्।\nकृत्वा हतः सिन्धुपतिः किं तन्न विदितं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068909, "chapter_id": 2444, "verse_number": "९-६२-३९x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068910, "chapter_id": 2444, "verse_number": "९-६२-३९", "content_sanskrit": "हतस्त्वमसि गान्धारे सभ्रातृसुतबान्धवः।\nसगणः ससुहृच्चैव पापं मार्गमनुष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068911, "chapter_id": 2444, "verse_number": "९-६२-४०", "content_sanskrit": "तवैव दुष्कृतैर्वीरौ भीष्मद्रोणौ निपातितौ।\nकर्णश्च निहतः सङ्ख्ये तव शीलानुवर्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068912, "chapter_id": 2444, "verse_number": "९-६२-४१", "content_sanskrit": "याच्यमानं मया मूढ पित्र्यमंशं न दित्ससि।\nपाण्डवेभ्यः स्वराज्यं च लोभाच्छकुनिनिश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068913, "chapter_id": 2444, "verse_number": "९-६२-४२", "content_sanskrit": "विषं ते भीमसेनाय दत्तं सर्वे च पाण्डवाः।\nप्रदीपिता जतुगृहे मात्रा सह सुदुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068914, "chapter_id": 2444, "verse_number": "९-६२-४३", "content_sanskrit": "सभायां याज्ञसेनी च कृष्टा द्यूते रजस्वला।\nतदैव तावद्दुष्टात्मन्वध्यस्त्वं निरपत्रप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068915, "chapter_id": 2444, "verse_number": "९-६२-४४", "content_sanskrit": "अनक्षज्ञं च धर्मज्ञं सौबलेनाक्षवेदिना।\nनिकृत्या यत्पराजैषीस्तस्मादसि हतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068916, "chapter_id": 2444, "verse_number": "९-६२-४५", "content_sanskrit": "जयद्रथेन पापेन यत्कृष्णा क्लेशिता वने।\nयातेषु मृगयां चैव तृणबिन्दोरथाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068917, "chapter_id": 2444, "verse_number": "९-६२-४६", "content_sanskrit": "अभिमन्युश्च यद्बाल एको बहुभिराहवे।\nत्वद्दोषैर्निहतः पाप तस्मादसि हतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2068918, "chapter_id": 2444, "verse_number": "९-६२-४७", "content_sanskrit": "`कुर्वाणं कर्म समरे पाण्डवानर्थकाङ्क्षिणम्।\nयच्छिखण्ड्यवधीद्भीष्मं मित्रार्थे न व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2068919, "chapter_id": 2444, "verse_number": "९-६२-४८", "content_sanskrit": "स्वधर्मं पृष्ठतः कृत्वा आचार्यस्त्वत्प्रियेप्सया।\nपार्षतेन हतः सङ्ख्ये वर्तमानोऽसतां पथि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2068920, "chapter_id": 2444, "verse_number": "९-६२-४९", "content_sanskrit": "प्रतिज्ञामात्मनः सत्यां चिकीर्षन्समरे निपुम्।\nहतवान्सात्वतो विद्वान्सौमदत्तिं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2068921, "chapter_id": 2444, "verse_number": "९-६२-५०", "content_sanskrit": "अर्जुनः समरे राजन्युध्यमानः कदाचन।\nनिन्दितं पुरुषव्याघ्रः करोति न कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2068922, "chapter_id": 2444, "verse_number": "९-६२-५१", "content_sanskrit": "लब्ध्वाऽपि बहुधा छिद्रं वीरवृत्तमनुस्मरन्।\nनिजघान रणे कर्णं मैवं वोचः सुदुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2068923, "chapter_id": 2444, "verse_number": "९-६२-५२", "content_sanskrit": "देवानां मतमाज्ञाय तेषां प्रियहितेप्सया।\nअर्जुनस्य महानागं मया व्यंसितमस्त्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2068924, "chapter_id": 2444, "verse_number": "९-६२-५३", "content_sanskrit": "त्वं च भीष्मश्च कर्णश्च द्रोणो द्रौणायनिस्तथा।\nविराटनगरे तस्य ह्यानृशंस्येन जीविताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2068925, "chapter_id": 2444, "verse_number": "९-६२-५४", "content_sanskrit": "स्मर पार्थस्य विक्रान्तं गन्धर्वेषु कृतं तथा।\nअधर्मं नात्र गान्धारे पाण्डवैर्यत्कृतं त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2068926, "chapter_id": 2444, "verse_number": "९-६२-५५", "content_sanskrit": "स्वबाहुबलमास्थाय स्वधर्मेण परन्तपाः।\nजितवन्तो रणे वीराः पापोसि निधनं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2068927, "chapter_id": 2444, "verse_number": "९-६२-५६", "content_sanskrit": "[यान्यकार्याणि चास्माकं कृतानिति प्रभाषसे।\nवैगुण्येन तवात्यर्थं सर्वं हि तदनुष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2068928, "chapter_id": 2444, "verse_number": "९-६२-५७", "content_sanskrit": "बृहस्पतेरुशनसो नोपदेशः श्रुतस्त्वया।\nवृद्धा नोपासिताश्चैव हितं वाक्यं न ते श्रुतभ्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2068929, "chapter_id": 2444, "verse_number": "९-६२-५८", "content_sanskrit": "लोभेनातिबलेन त्वं तृष्णया च वशीकृतः।\nकृतवानस्यकार्याणि विपाकस्तस्य भुज्यताम्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2068930, "chapter_id": 2444, "verse_number": "९-६२-५९x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2068931, "chapter_id": 2444, "verse_number": "९-६२-५९", "content_sanskrit": "अधीतं विधिवद्दत्तं भूः प्रभुक्ता ससागरा।\nमूर्ध्नि स्थिममित्राणां को नु स्वन्ततरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2068932, "chapter_id": 2444, "verse_number": "९-६२-६०", "content_sanskrit": "यदिष्टं क्षत्रबन्धूनां स्वधर्ममनुपश्यताम्।\nतदिदं निधनं प्राप्तं को नु स्वन्ततरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2068933, "chapter_id": 2444, "verse_number": "९-६२-६१", "content_sanskrit": "देवार्हा मानुषा भोगाः प्राप्ता असुलभा नृपैः।\nऐश्वर्यं चोत्तमं प्राप्तं को नु स्वन्ततरो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2068934, "chapter_id": 2444, "verse_number": "९-६२-६२", "content_sanskrit": "ससुहृत्सानुबन्धस्च स्वर्गं गन्ताऽहमच्युत।\nयूयं गर्हितसङ्कल्पाः शोचन्तो वर्तयिष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2068935, "chapter_id": 2444, "verse_number": "९-६२-६३", "content_sanskrit": "`न मे विषादो भीमेन पादेन शिर आहतम्।\nकाका वा कङ्कगृध्रा वा निधास्यन्ति पदं क्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2068936, "chapter_id": 2444, "verse_number": "९-६२-६४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2068937, "chapter_id": 2444, "verse_number": "९-६२-६४", "content_sanskrit": "अस्य वाक्यस्य निधने कुरुराजस्य धीमतः।\nअपतत्सुमहद्वर्षं पुष्पाणां पुण्यगन्धिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2068938, "chapter_id": 2444, "verse_number": "९-६२-६५", "content_sanskrit": "अवादयन्त गन्धर्वा वादित्रं सुमनोहरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2068939, "chapter_id": 2444, "verse_number": "९-६२-६६", "content_sanskrit": "जगुश्चाप्सरसो राज्ञो यशः सम्बद्धमेव च।\nसिद्धाश्च मुमुचुर्वाचः साधुसाध्विति पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2068940, "chapter_id": 2444, "verse_number": "९-६२-६७", "content_sanskrit": "ववौ च सुरभिर्वायुः पुण्यगन्धो मृदुःसुखः।\nव्यराजंश्च दिशः सर्वा नभो वैदूर्यसन्निभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2068941, "chapter_id": 2444, "verse_number": "९-६२-६८", "content_sanskrit": "अत्यद्भुतानि ते दृष्ट्वा वासुदेवपुरोगमाः।\nदुर्योधनस्य पूजां तु दृष्ट्वा व्रीडामुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2068942, "chapter_id": 2444, "verse_number": "९-६२-६९", "content_sanskrit": "हतांश्चाधर्मतः श्रुत्वा शोकार्ताः शुशुचुर्हि ते।\nभीष्मं द्रोणं तथा कर्णं भूरिश्रवसमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2068943, "chapter_id": 2444, "verse_number": "९-६२-७०", "content_sanskrit": "तांस्तु चिन्तापरान्दृष्ट्वा पाण्डवान्दीनचेतसः।\nप्रोवाचेदं वचः कृष्णो मेघदुन्दुभिनिस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2068944, "chapter_id": 2444, "verse_number": "९-६२-७१", "content_sanskrit": "नैष शक्योऽतिशीघ्रास्त्रस्ते च सर्वे महारथाः।\nऋजुयुद्धेन विक्रान्ता हन्तुं युष्माभिराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2068945, "chapter_id": 2444, "verse_number": "९-६२-७२", "content_sanskrit": "उपायान्निहता ह्येते मया तस्मान्नराधिपाः।\nअन्यथा पाण्डवेयानां नाभविष्यज्जयः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2068946, "chapter_id": 2444, "verse_number": "९-६२-७३", "content_sanskrit": "ते हि सर्वे महेष्वासाश्चत्वारोऽतिरथा मुवि।\nअशक्या धर्मतो हन्तुं लोकपालैरपि स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2068947, "chapter_id": 2444, "verse_number": "९-६२-७४", "content_sanskrit": "तथैवायं गदापाणिर्धार्तराष्ट्रो गतश्रमः।\nअशक्यो धर्मतो हन्तुं कालेनापि दि दण्डिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2068948, "chapter_id": 2444, "verse_number": "९-६२-७५", "content_sanskrit": "नैतन्मनसि कर्तव्यं यदयं निहतो नृपः।\nमिथ्याचर्याच्छलोपायैर्बहवः शत्रवो हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2068949, "chapter_id": 2444, "verse_number": "९-६२-७६", "content_sanskrit": "पूर्वैरनुगतो मार्गो देवैरसुरघातिभिः।\nसद्भिश्चानुगतः पन्थाः सर्वैरनुगमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2068950, "chapter_id": 2444, "verse_number": "९-६२-७७", "content_sanskrit": "`एवं विधात्रा विहितं स्वयमेषां महात्मनाम्।\nदैवं पुरुषकारेण न शक्यमतिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2068951, "chapter_id": 2444, "verse_number": "९-६२-७८", "content_sanskrit": "भूतं भव्यं भविष्यच्च निमेषाद्यो हनिष्यति।\nकृतान्तमन्यथा कर्तुं नेच्छेत्सोऽयं धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2068952, "chapter_id": 2444, "verse_number": "९-६२-७९", "content_sanskrit": "कृतकृत्याः स्म सायाह्ने निवासं रोचयामहे।\nसाश्वनागरथाः सर्वे विश्राम्यन्तु नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2068953, "chapter_id": 2444, "verse_number": "९-६२-८०", "content_sanskrit": "वासुदेववचः श्रुत्वा तदानीं पाण्डवैः सह।\nपाञ्चाला भृशसंहृष्टा विनेदुः सिंहसङ्घवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2068954, "chapter_id": 2444, "verse_number": "९-६२-८१", "content_sanskrit": "ततः प्राध्मापयच्छङ्खं पाञ्चजन्यं जनार्दनः।\n`देवदत्तं प्रहृष्टात्मा शङ्खप्रवरमर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2068955, "chapter_id": 2444, "verse_number": "९-६२-८२", "content_sanskrit": "अनन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः।\nपोण्ड्रं दध्मौ महाशङ्खं भीमकर्मा वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2068956, "chapter_id": 2444, "verse_number": "९-६२-८३", "content_sanskrit": "नकुलः सहदेवश्च सुघोषमणिपुष्पकौ।\nधृष्टद्युम्नस्तथा जैत्रं सात्यकिर्नन्दिवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2068957, "chapter_id": 2444, "verse_number": "९-६२-८४", "content_sanskrit": "तेषां नादेन महता शङ्खानां भरतर्षभ।\nआपुपूरे नभः सर्वं पृथिवी च चचाल ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2068958, "chapter_id": 2444, "verse_number": "९-६२-८५", "content_sanskrit": "ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः।\nपाण्डुसैन्येष्ववाद्यन्त स शब्दस्तुमुलोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2068959, "chapter_id": 2444, "verse_number": "९-६२-८६", "content_sanskrit": "अस्तुवन्पाण्डवानन्ये निर्भीश्च स्तुतिमङ्गलैः।\nहृष्टा दुर्योधनं दृष्ट्वा निहतं पुरुषर्षभाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2068960, "chapter_id": 2444, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि गदायुद्धपर्वणि द्विषष्टितमोऽध्यायः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]