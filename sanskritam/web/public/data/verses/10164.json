[{"id": 6000164000, "chapter_id": 10164, "verse_number": null, "content_sanskrit": "अथ एकादशध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000164001, "chapter_id": 10164, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.001.m4a", "display_order": 2}, {"id": 6000164002, "chapter_id": 10164, "verse_number": "८-११-१", "content_sanskrit": "वृषध्वजो निशम्येदं योषिद्रूपेण दानवान्।\nमोहयित्वा सुरगणान् हरिः सोममपाययत्॥ ८/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.002.m4a", "display_order": 3, "topics": [{"text": "मोहिनीरूपं पुनः स्वस्मै दर्शयितुं रुद्रयाचितेन भगवता तत्प्रदर्शने सति तत्सौन्दर्यदर्शनक्षुभितमनसो हरस्य मोहाधिगमः", "range": "१–४६"}]}, {"id": 6000164003, "chapter_id": 10164, "verse_number": "८-११-२", "content_sanskrit": "वृषमारुह्य गिरिशः सर्वभूतगणैर्वृतः।\nसह देव्या ययौ द्रष्टुं यत्रास्ते मधुसूदनः॥ ८/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.003.m4a", "display_order": 4}, {"id": 6000164004, "chapter_id": 10164, "verse_number": "८-११-३", "content_sanskrit": "सभाजितो भगवता सादरं सोमया भवः।\nसूपविष्ट उवाचेदं प्रतिपूज्य स्मयन् हरिम्॥ ८/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.004.m4a", "display_order": 5}, {"id": 6000164005, "chapter_id": 10164, "verse_number": "८-११-४", "content_sanskrit": "देव देव जगद्व्यापिन् जगदीश जगन्मय।\nसर्वेषामेव भावानां त्वमात्मा हेतुरीश्वरः॥ ८/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.005.m4a", "display_order": 6}, {"id": 6000164006, "chapter_id": 10164, "verse_number": "८-११-५", "content_sanskrit": "तवैव चरणाम्भोजं श्रेयस्कामा निराशिषः।\nविसृज्योभयतः सङ्गं मुनयः समुपासते॥ ८/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.006.m4a", "display_order": 7}, {"id": 6000164007, "chapter_id": 10164, "verse_number": "८-११-६", "content_sanskrit": "त्वं ब्रह्म पूर्णममृतं विगुणं विशोकमानन्दमात्रमविकारमनन्यदन्यत्।\nविश्वस्य हेतुरुदयस्थितिसंयमानामात्मेश्वरश्च तदुपेक्षतयाऽनपेक्षः॥ ८/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.007.m4a", "display_order": 8}, {"id": 6000164008, "chapter_id": 10164, "verse_number": "८-११-७", "content_sanskrit": "एकस्त्वमेव सदसद्द्वयमद्वयं च स्वर्णं कृताकृतमिवेह न वस्तुभेदः।\nअज्ञानतस्त्वयि जनैर्विहतो विकल्पो यस्माद् गुणव्यतिकरो निरुपाधिकश्च॥ ८/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.008.m4a", "display_order": 9}, {"id": 6000164009, "chapter_id": 10164, "verse_number": "८-११-८", "content_sanskrit": "त्वां ब्रह्म केचिदवयन्त्युत धर्ममेक एके परं सदसतोः पुरुषं परेशम्।\nअन्ये वदन्ति नवशक्तियुतं परं त्वां केचिन्महापुरुषमव्ययमात्मतन्त्रम्॥ ८/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.009.m4a", "display_order": 10}, {"id": 6000164010, "chapter_id": 10164, "verse_number": "८-११-९", "content_sanskrit": "नाहं परायुर्ऋषयो न मरीचिमुख्या जानन्ति यद्विरचितं खलु सत्त्वसर्गाः।\nयन्मायया मुषितचेतस ईश दैत्यमर्त्यादयः किमुत शश्वदभद्रवृत्ताः॥ ८/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.010.m4a", "display_order": 11}, {"id": 6000164011, "chapter_id": 10164, "verse_number": "८-११-१०", "content_sanskrit": "स त्वं समीहसि ततः स्थितिजन्मनाशान् भूतेहितं च जगतो ह्यपि बन्धमोक्षौ।\nवायुर्यथा विशति खं च चराचराख्यं सर्वं त्वदात्मकतयाऽवगमो नुतिस्ते॥ ८/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.011.m4a", "display_order": 12}, {"id": 6000164012, "chapter_id": 10164, "verse_number": "८-११-११", "content_sanskrit": "अवतारा मया दृष्टा रममाणस्य ते गुणैः।\nसोऽहं तद् द्रष्टुमिच्छामि यत् ते योषिद्वपुर्धृतम्॥ ८/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.012.m4a", "display_order": 13}, {"id": 6000164013, "chapter_id": 10164, "verse_number": "८-११-१२", "content_sanskrit": "येन सम्मोहिता दैत्याः पायिताश्चामृतं सुराः।\nतद् दिदृक्षव आयाताः परं कौतूहलं हि नः॥ ८/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.013.m4a", "display_order": 14}, {"id": 6000164014, "chapter_id": 10164, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.014.m4a", "display_order": 15}, {"id": 6000164015, "chapter_id": 10164, "verse_number": "८-११-१३", "content_sanskrit": "एवमभ्यर्थितो विष्णुर्भगवान् शूलपाणिना।\nप्रहस्य भावगम्भीरं गिरिशं प्रत्यभाषत॥ ८/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.015.m4a", "display_order": 16}, {"id": 6000164016, "chapter_id": 10164, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.016.m4a", "display_order": 17}, {"id": 6000164017, "chapter_id": 10164, "verse_number": "८-११-१४", "content_sanskrit": "कौतूहलाय दैत्यानां योषिद्वेषो मया कृतः।\nपश्यता सुरकार्याणि गते पीयूषभाजने॥ ८/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.017.m4a", "display_order": 18}, {"id": 6000164018, "chapter_id": 10164, "verse_number": "८-११-१५", "content_sanskrit": "तत् तेऽहं दर्शयिष्यामि दिदृक्षोः सुरसत्तम।\nतत्कामिनां च मन्तव्यं सङ्कल्पप्रभवोदयम्॥ ८/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.018.m4a", "display_order": 19}, {"id": 6000164019, "chapter_id": 10164, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.019.m4a", "display_order": 20}, {"id": 6000164020, "chapter_id": 10164, "verse_number": "८-११-१६", "content_sanskrit": "इति ब्रुवाणो भगवांस्तत्रैवान्तरधीयत।\nसर्वतश्चारयंश्चक्षुर्भव आस्त सहोमया॥ ८/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.020.m4a", "display_order": 21}, {"id": 6000164021, "chapter_id": 10164, "verse_number": "८-११-१७", "content_sanskrit": "ततो ददर्शोपवने वरस्‍त्रियं विचित्रपुष्पारुणपल्‍लवद्रुमे।\nविक्रीडतीं कन्दुकलीलया लसन्नितम्बपर्यस्तदुकूलमेखलाम्॥ ८/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.021.m4a", "display_order": 22}, {"id": 6000164022, "chapter_id": 10164, "verse_number": "८-११-१८", "content_sanskrit": "आवर्तनोद्वर्तनकम्पितस्तनप्रकृष्टहारोरुभरैः पदे पदे।\nप्रभज्यमानामिव मध्यतश्चलत्पदप्रवालं नयतीं ततस्ततः॥ ८/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.022.m4a", "display_order": 23}, {"id": 6000164023, "chapter_id": 10164, "verse_number": "८-११-१९", "content_sanskrit": "दिक्षु भ्रमत्कन्दुकचापलैर्भृशं प्रोद्विग्नतारायतलोललोचनाम्।\nस्वकर्णविभ्राजितलोलकुण्डलोल्लसत्कपोलालकमण्डिताननाम्॥ ८/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.023.m4a", "display_order": 24}, {"id": 6000164024, "chapter_id": 10164, "verse_number": "८-११-२०", "content_sanskrit": "श्लथद्दुकूलां कबरीं च विच्युतां सन्नह्यतीं वामकरेण वल्गुना।\nविनिघ्नतीमन्यकरेण कन्दुकं विमोहयन्तीं जगदात्ममायया॥ ८/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.024.m4a", "display_order": 25}, {"id": 6000164025, "chapter_id": 10164, "verse_number": "८-११-२१", "content_sanskrit": "तां वीक्ष्य देव इति कन्दुकलीलयेषद् व्रीडास्फुटस्मितविसृष्टकटाक्षमूढः।\nस्‍त्रीप्रेक्षणप्रतिसमीक्षणनिर्वृतात्मा नात्मानमन्तिक उमां स्वगणांश्च वेद॥ ८/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.025.m4a", "display_order": 26}, {"id": 6000164026, "chapter_id": 10164, "verse_number": "८-११-२२", "content_sanskrit": "तस्याः कराग्रात् स तु कन्दुको यदा गतो विदूरं तमनुव्रजन्त्याः।\nवासः ससूत्रं लघु मारुतोऽहरद् भवस्य देवस्य किलानुपश्यतः॥ ८/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.026.m4a", "display_order": 27}, {"id": 6000164027, "chapter_id": 10164, "verse_number": "८-११-२३", "content_sanskrit": "एवं तां रुचिरापाङ्गीं दर्शनीयां मनोरमाम्।\nदृष्ट्वा तस्यां मनश्चक्रे विलज्जन्त्यां भवः किल॥ ८/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.027.m4a", "display_order": 28}, {"id": 6000164028, "chapter_id": 10164, "verse_number": "८-११-२४", "content_sanskrit": "तयाऽपहृतविज्ञानस्तत्कृतस्मरविह्वलः।\nभवान्या अपि पश्यन्त्या गतह्रीस्तत्पदं ययौ॥ ८/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.028.m4a", "display_order": 29}, {"id": 6000164029, "chapter_id": 10164, "verse_number": "८-११-२५", "content_sanskrit": "सा तमायान्तमालोक्य विवस्‍त्रा व्रीडिता भृशम्।\nनिलीयमाना वृक्षेषु हसन्ती नान्वतिष्ठत॥ ८/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.029.m4a", "display_order": 30}, {"id": 6000164030, "chapter_id": 10164, "verse_number": "८-११-२६", "content_sanskrit": "तामन्वगच्छद् भगवान् भवः प्रव्यथितेन्द्रियः।\nकामस्य च वशं नीतः करेणुमिव यूथपः॥ ८/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.030.m4a", "display_order": 31}, {"id": 6000164031, "chapter_id": 10164, "verse_number": "८-११-२७", "content_sanskrit": "सोऽनुव्रज्यातिवेगेन गृहीत्वाऽनिच्छतीं स्‍त्रियम्।\nकेशबन्ध उपानीय बाहुभ्यां परिषस्वजे॥ ८/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.031.m4a", "display_order": 32}, {"id": 6000164032, "chapter_id": 10164, "verse_number": "८-११-२८", "content_sanskrit": "सोपगूढा भगवता करिणा करिणी यथा।\nइतस्ततः प्रसर्पन्ती विप्रकीर्णशिरोरुहा॥ ८/११/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.032.m4a", "display_order": 33}, {"id": 6000164033, "chapter_id": 10164, "verse_number": "८-११-२९", "content_sanskrit": "आत्मानं मोचयित्वाऽङ्ग सुरर्षभभुजान्तरात्।\nप्राद्रवत् सा पृथुश्रोणी माया देवविनिर्मिता॥ ८/११/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.033.m4a", "display_order": 34}, {"id": 6000164034, "chapter_id": 10164, "verse_number": "८-११-३०", "content_sanskrit": "तस्यासौ पदवीं रुद्रो विष्णोरद्भुतकर्मणः।\nप्रत्यपद्यत कामेन वैरिणेव विनिर्जितः॥ ८/११/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.034.m4a", "display_order": 35}, {"id": 6000164035, "chapter_id": 10164, "verse_number": "८-११-३१", "content_sanskrit": "तस्यानुधावतो रेतश्चस्कन्दामोघरेतसः।\nशुष्मिणो यूथपस्येव वासितामनुधावतः॥ ८/११/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.035.m4a", "display_order": 36}, {"id": 6000164036, "chapter_id": 10164, "verse_number": "८-११-३२", "content_sanskrit": "यत्र यत्रापतन्मह्यां रेतस्तस्य महात्मनः।\nतानि रुद्रस्य हेम्नश्च क्षेत्राण्यासन् महीपते॥ ८/११/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.036.m4a", "display_order": 37}, {"id": 6000164037, "chapter_id": 10164, "verse_number": "८-११-३३", "content_sanskrit": "सरित्सरस्सु शैलेषु वनेषूपवनेषु च।\nयत्र क्‍व चासन् ऋषयस्तत्र सन्निहितो हरः॥ ८/११/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.037.m4a", "display_order": 38}, {"id": 6000164038, "chapter_id": 10164, "verse_number": "८-११-३४", "content_sanskrit": "स्कन्ने रेतसि सोऽपश्यदात्मानं देवमायया।\nजडीकृतं नृपश्रेष्ठ सन्न्यवर्तत कश्मलात्॥ ८/११/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.038.m4a", "display_order": 39}, {"id": 6000164039, "chapter_id": 10164, "verse_number": "८-११-३५", "content_sanskrit": "अथावगतमाहात्म्य आत्मनो जगदात्मनः।\nअपरिज्ञेयवीर्यस्य न मेने तदुदाहृतम्॥ ८/११/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.039.m4a", "display_order": 40}, {"id": 6000164040, "chapter_id": 10164, "verse_number": "८-११-३६", "content_sanskrit": "तमविक्लवमव्रीडमालक्ष्य मधुसूदनः।\nउवाच परमप्रीतो बिभ्रत् स्वां पौरुषीं तनुम्॥ ८/११/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.040.m4a", "display_order": 41}, {"id": 6000164041, "chapter_id": 10164, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.041.m4a", "display_order": 42}, {"id": 6000164042, "chapter_id": 10164, "verse_number": "८-११-३७", "content_sanskrit": "दिष्ट्या त्वं विबुधश्रेष्ठ स्वां निष्ठामात्मना स्थितः।\nयतो दुस्तरया स्वैरं मोहितोऽस्यङ्ग मायया॥ ८/११/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.042.m4a", "display_order": 43}, {"id": 6000164043, "chapter_id": 10164, "verse_number": "८-११-३८", "content_sanskrit": "को नु मेऽतितरेन्मायां विषक्तस्त्वदृते पुमान्।\nतांस्तान् विसृजतीं भावान् दुस्तरामकृतात्मभिः॥ ८/११/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.043.m4a", "display_order": 44}, {"id": 6000164044, "chapter_id": 10164, "verse_number": "८-११-३९", "content_sanskrit": "सेयं गुणमयी माया न त्वामभिभविष्यति।\nमया समेतं कालेन कामरूपेण भागशः॥ ८/११/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.044.m4a", "display_order": 45}, {"id": 6000164045, "chapter_id": 10164, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.045.m4a", "display_order": 46}, {"id": 6000164046, "chapter_id": 10164, "verse_number": "८-११-४०", "content_sanskrit": "एवं भगवता राजन् श्रीवत्साङ्केन सत्कृतः।\nआमन्त्र्य तं परिक्रम्य सगणः स्वालयं ययौ॥ ८/११/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.046.m4a", "display_order": 47}, {"id": 6000164047, "chapter_id": 10164, "verse_number": "८-११-४१", "content_sanskrit": "आत्मांशभूतां तां मायां भवानीं भगवान् भवः।\nशंसतामृषिमुख्यानां प्रीत्या तुष्टाव भारत॥ ८/११/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.047.m4a", "display_order": 48}, {"id": 6000164048, "chapter_id": 10164, "verse_number": "८-११-४२", "content_sanskrit": "अयि व्यपश्यस्त्वमजस्य मायां परस्य पुंसः परदेवतायाः।\nअहं कलानामृषभो विमुह्ये यया वशोऽन्ये किमुतास्वतन्त्राः॥ ८/११/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.048.m4a", "display_order": 49}, {"id": 6000164049, "chapter_id": 10164, "verse_number": "८-११-४३", "content_sanskrit": "यं मामपृच्छस्त्वमुपेत्य योगात् समासहस्रान्त उपारतं वै।\nस एष साक्षात् पुरुषः पुराणो न यत्र कालो विशते न वेदः॥ ८/११/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.049.m4a", "display_order": 50}, {"id": 6000164050, "chapter_id": 10164, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.050.m4a", "display_order": 51}, {"id": 6000164051, "chapter_id": 10164, "verse_number": "८-११-४४", "content_sanskrit": "इति तेऽभिहितस्तात विक्रमः शार्ङ्गधन्वनः।\nसिन्धोर्निर्मथने येन धृतः पृष्ठे महाचलः॥ ८/११/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.051.m4a", "display_order": 52}, {"id": 6000164052, "chapter_id": 10164, "verse_number": "८-११-४५", "content_sanskrit": "एतन्मुहुः कीर्तयतोऽनुशृृण्वतो न रिष्यते जातु समुद्यमः क्‍वचित्।\nयदुत्तमश्लोकगुणानुवर्णनं समस्तसंसारपरिश्रमापहम्॥ ८/११/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.052.m4a", "display_order": 53}, {"id": 6000164053, "chapter_id": 10164, "verse_number": "८-११-४६", "content_sanskrit": "असदविषयमङ्घ्रिं भावगम्यं प्रपन्नानमृतममरवर्यानाशयत् सिन्धुमथ्यम्।\nकपटयुवतिवेषो मोहयन् यः सुरारींस्तमिममुपसृतानां कामपूरं नतोऽस्मि॥ ८/११/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_011/BhP_08.011.053.m4a", "display_order": 54}, {"id": 6000164054, "chapter_id": 10164, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]