[{"id": 2184917, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2184918, "chapter_id": 4923, "verse_number": "१", "content_sanskrit": "हीने परमके धर्मे सर्वलोकातिलङ्घिनि ।\nअधर्मे धर्मतां नीते धर्मे चाधर्मतां गते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2184919, "chapter_id": 4923, "verse_number": "२", "content_sanskrit": "मर्यादासु प्रभिन्नासु क्षुभिते धर्मनिश्चये ।\nराजभिः पीडिते लोके चोरैर्वापि विशां पते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2184920, "chapter_id": 4923, "verse_number": "३", "content_sanskrit": "सर्वाश्रमेषु मूढेषु कर्मसूपहतेषु च ।\nकामान्मोहाच्च लोभाच्च भयं पश्यत्सु भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2184921, "chapter_id": 4923, "verse_number": "४", "content_sanskrit": "अविश्वस्तेषु सर्वेषु नित्यभीतेषु पार्थिव ।\nनिकृत्या हन्यमानेषु वञ्चयत्सु परस्परम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2184922, "chapter_id": 4923, "verse_number": "५", "content_sanskrit": "सम्प्रदीप्तेषु देशेषु ब्राह्मण्ये चाभिपीडिते ।\nअवर्षति च पर्जन्ये मिथो भेदे समुत्थिते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2184923, "chapter_id": 4923, "verse_number": "६", "content_sanskrit": "सर्वस्मिन्दस्युसाद्भूते पृथिव्यामुपजीवने ।\nकेन स्विद्ब्राह्मणो जीवेज्जघन्ये काल आगते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2184924, "chapter_id": 4923, "verse_number": "७", "content_sanskrit": "अतित्यक्षुः पुत्रपौत्राननुक्रोशान्नराधिप ।\nकथमापत्सु वर्तेत तन्मे ब्रूहि पितामह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2184925, "chapter_id": 4923, "verse_number": "८", "content_sanskrit": "कथं च राजा वर्तेत लोके कलुषतां गते ।\nकथमर्थाच्च धर्माच्च न हीयेत परन्तप\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2184926, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2184927, "chapter_id": 4923, "verse_number": "९", "content_sanskrit": "राजमूला महाराज योगक्षेमसुवृष्टयः ।\nप्रजासु व्याधयश्चैव मरणं च भयानि च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2184928, "chapter_id": 4923, "verse_number": "१०", "content_sanskrit": "कृतं त्रेता द्वापरश्च कलिश्च भरतर्षभ ।\nराजमूलानि सर्वाणि मम नास्त्यत्र संशयः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2184929, "chapter_id": 4923, "verse_number": "११", "content_sanskrit": "तस्मिंस्त्वभ्यागते काले प्रजानां दोषकारके ।\nविज्ञानबलमास्थाय जीवितव्यं तदा भवेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2184930, "chapter_id": 4923, "verse_number": "१२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nविश्वामित्रस्य संवादं चण्डालस्य च पक्कणे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2184931, "chapter_id": 4923, "verse_number": "१३", "content_sanskrit": "त्रेताद्वापरयोः सन्धौ पुरा दैवविधिक्रमात् ।\nअनावृष्टिरभूद् घोरा राजन् द्वादशवार्षिकी\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2184932, "chapter_id": 4923, "verse_number": "१४", "content_sanskrit": "प्रजानामभिवृद्धानां युगान्ते पर्युपस्थिते ।\nत्रेतानिर्मोक्षसमये द्वापरप्रतिपादने\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2184933, "chapter_id": 4923, "verse_number": "१५", "content_sanskrit": "न ववर्ष सहस्राक्षः प्रतिलोमोऽभवद् गुरुः ।\nजगाम दक्षिणं मार्गं सोमो व्यावृत्तलक्षणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2184934, "chapter_id": 4923, "verse_number": "१६", "content_sanskrit": "नावश्यायोऽपि रात्र्यन्ते कुत एवाभ्रराजयः ।\nनद्यः सङ्क्षिप्ततोयौघाः क्वचिदन्तर्गताभवन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2184935, "chapter_id": 4923, "verse_number": "१७", "content_sanskrit": "सरांसि सरितश्चैव कूपाः प्रस्रवणानि च ।\nहतत्विट्कान्यलक्ष्यन्त विसर्गाद् पूर्वकारितात्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2184936, "chapter_id": 4923, "verse_number": "१८", "content_sanskrit": "उपशुष्कजलस्थाया विनिवृत्तसभाप्रपा ।\nनिवृत्तयज्ञस्वाध्याया निर्वषट्कारमङ्गला\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2184937, "chapter_id": 4923, "verse_number": "१९", "content_sanskrit": "उत्पन्नकृषिगोरक्ष्या निवृत्तविपणापणा ।\nनिवृत्तपूगसमया सम्प्रनष्टमहोत्सवा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2184938, "chapter_id": 4923, "verse_number": "२०", "content_sanskrit": "अस्थिकङ्कालसङ्कीर्णा हाहाभूतजनाकुला ।\nशून्यभूयिष्ठनगरा दग्धग्रामनिवेशना\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2184939, "chapter_id": 4923, "verse_number": "२१", "content_sanskrit": "क्वचिच्चोरैः क्वचिच्छस्त्रैः क्वचिद्राजभिरातुरैः ।\nपरस्परभयाच्चैव शून्यभूयिष्ठनिर्जना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2184940, "chapter_id": 4923, "verse_number": "२२", "content_sanskrit": "गतदैवतसङ्कल्पा वृद्धबालविनाकृता ।\nगोजाविमहिषैर्हीना परस्परहराहरा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2184941, "chapter_id": 4923, "verse_number": "२३", "content_sanskrit": "हतविप्रा हतारक्षा प्रनष्टौषधिसञ्चया ।\nश्यावभूतनरप्राया बभूव वसुधा तदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2184942, "chapter_id": 4923, "verse_number": "२४", "content_sanskrit": "तस्मिन् प्रतिभये काले क्षीणे धर्मे युधिष्ठिर ।\nबभ्रमुः क्षुधिता मर्त्याः खादन्तः स्म परस्परम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2184943, "chapter_id": 4923, "verse_number": "२५", "content_sanskrit": "ऋषयो नियमांस्त्यक्त्वा परित्यक्ताग्निदैवताः ।\nआश्रमान् सम्परित्यज्य पर्यधावन्नितस्ततः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2184944, "chapter_id": 4923, "verse_number": "२६", "content_sanskrit": "विश्वामित्रोऽथ भगवान्महर्षिरनिकेतनः ।\nक्षुधा परिगतो धीमान् समन्तात् पर्यधावत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2184945, "chapter_id": 4923, "verse_number": "२७", "content_sanskrit": "स कदाचित् परिपतञ्श्वपचानां निवेशनम् ।\nहिंस्राणां प्राणिहन्तॄणामाससाद वने क्वचित्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2184946, "chapter_id": 4923, "verse_number": "२८", "content_sanskrit": "विभिन्नकलशाकीर्णं श्वचर्माच्छादनायुतम् ।\nवराहखरभग्नास्थिकपालघटसङ्कुलम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2184947, "chapter_id": 4923, "verse_number": "२९", "content_sanskrit": "मृतचेलपरिस्तीर्णं निर्मलं कृत्तिभूषितम् ।\nसर्पनिर्मोकमालाभिः कृतचिह्नकुटीमठम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2184948, "chapter_id": 4923, "verse_number": "३०", "content_sanskrit": "उलूकपक्षध्वजिभिर्देवतायतनैर्वृतम् ।\nलोहघण्टापरिष्कारं श्वयूथपरिवारितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2184949, "chapter_id": 4923, "verse_number": "३१", "content_sanskrit": "तत् प्रविश्य क्षुधाविष्टो गाधेः पुत्रो महानृषिः ।\nआहारान्वेषणे युक्तः परं यत्नं समास्थितः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2184950, "chapter_id": 4923, "verse_number": "३२", "content_sanskrit": "न च क्वचिदविन्दत्स भिक्षमाणोऽपि कौशिकः ।\nमांसमन्नं मूलफलमन्यद् वा तत्र किञ्चन\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2184951, "chapter_id": 4923, "verse_number": "३३", "content_sanskrit": "अहो कृच्छ्रं मया प्राप्तमिति निश्चित्य कौशिकः ।\nपपात भूमौ दौर्बल्यात्तस्मिंश्चण्डालपक्कणे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2184952, "chapter_id": 4923, "verse_number": "३४", "content_sanskrit": "चिन्तयामास स मुनिः किं नु मे सुकृतं भवेत् ।\nकथं वृथा न मृत्युः स्यादिति पार्थिवसत्तम\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2184953, "chapter_id": 4923, "verse_number": "३५", "content_sanskrit": "स ददर्श श्वमांसस्य कुतन्त्रिकततिं मुनिः ।\nचण्डालस्य गृहे राजन् सद्यः शस्त्रहतस्य च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2184954, "chapter_id": 4923, "verse_number": "३६", "content_sanskrit": "स चिन्तयामास तदा स्तेयं कार्यमितो मया ।\nन हीदानीमुपायोऽन्यो विद्यते प्राणधारणे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2184955, "chapter_id": 4923, "verse_number": "३७", "content_sanskrit": "आपत्सु विहितं स्तेयं विशिष्टस्य निहीनतः ।\nपरस्परं भवेत् पूर्वमास्थेयमिति निश्चयः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2184956, "chapter_id": 4923, "verse_number": "३८", "content_sanskrit": "हीनादादेयमादौ स्यात् समानात्तदनन्तरम् ।\nअसम्भवादाददीत विशिष्टादपि धार्मिकात्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2184957, "chapter_id": 4923, "verse_number": "३९", "content_sanskrit": "सोऽहमन्तेत्यवस्थायां हरमाणः परिग्रहात् ।\nन स्तेयदोषं पश्यामि हरिष्याम्येतदामिषम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2184958, "chapter_id": 4923, "verse_number": "४०", "content_sanskrit": "एतां बुद्धिं समास्थाय विश्वामित्रो महामुनिः ।\nतस्मिन् देशे प्रसुष्वाप पतितो यत्र भारत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2184959, "chapter_id": 4923, "verse_number": "४१", "content_sanskrit": "स विगाढां निशां दृष्ट्वा सुप्ते चण्डालपक्कणे ।\nशनैरुत्थाय भगवान् प्रविवेश कुटीमठम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2184960, "chapter_id": 4923, "verse_number": "४२", "content_sanskrit": "स सुप्त एव चण्डालः श्र्लेष्मापिहितलोचनः ।\nपरिभिन्नस्वरो रूक्ष उवाचाप्रियदर्शनः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2184961, "chapter_id": 4923, "verse_number": "४३", "content_sanskrit": "कः कुतन्तीं घट्टयति सुप्ते चण्डालपक्कणे ।\nजागर्मि नावसुप्तोऽस्मि हतोऽसीति च दारुणः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2184962, "chapter_id": 4923, "verse_number": "४४", "content_sanskrit": "विश्वामित्रोऽहमित्येव सहसा तमुवाच सः ।\nसहसाभ्यागतभयः सोद्वेगस्तेन कर्मणा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2184963, "chapter_id": 4923, "verse_number": "४५", "content_sanskrit": "चण्डालस्तद्वचः श्रुत्वा महर्षेर्भावितात्मनः ।\nशयनादुपसम्भ्रान्त इयेष पतितुं ततः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2184964, "chapter_id": 4923, "verse_number": "४६", "content_sanskrit": "स विसृज्याश्रु नेत्राभ्यां बहुमानात्कृताञ्जलिः ।\nउवाच कौशिकं रात्रौ ब्रह्मन्किं ते चिकीर्षितम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2184965, "chapter_id": 4923, "verse_number": "४७", "content_sanskrit": "विश्वामित्रस्तु मातङ्गमुवाच परिसान्त्वयन् ।\nक्षुधितोऽहं गतप्राणो हरिष्यामि श्वजाघनीम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2184966, "chapter_id": 4923, "verse_number": "४८", "content_sanskrit": "अवसीदन्ति मे प्राणाः स्मृतिर्मे नश्यति क्षुधा ।\nस्वधर्मं बुध्यमानोऽपि हरिष्यामि श्वजाघनीम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2184967, "chapter_id": 4923, "verse_number": "४९", "content_sanskrit": "अटन् भैक्षं न विन्दामि यदा युष्माकमालये ।\nतदा बुद्धिः कृता पापे हरिष्यामि श्वजाघनीम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2184968, "chapter_id": 4923, "verse_number": "५०", "content_sanskrit": "तृषितः कलुषं पाता नास्ति ह्रीरशनार्थिनः ।\nक्षुद्धर्मं दूषयत्यत्र हरिष्यामि श्वजाघनीम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2184969, "chapter_id": 4923, "verse_number": "५१", "content_sanskrit": "अग्निर्मुखं पुरोधाश्च देवानां शुचिपाद् विभुः ।\nयथा स सर्वभुग्ब्रह्मा तथा मां विद्धि धर्मतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2184970, "chapter_id": 4923, "verse_number": "५२", "content_sanskrit": "तमुवाच स चण्डालो महर्षे शृणु मे वचः ।\nश्रुत्वा तथा समातिष्ठ यथा धर्मान्न हीयसे\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2184971, "chapter_id": 4923, "verse_number": "५३", "content_sanskrit": "मृगाणामधमं श्वानं प्रवदन्ति मनीषिणः ।\nतस्याप्यधम उद्देशः शरीरस्य तु जाघनी\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2184972, "chapter_id": 4923, "verse_number": "५४", "content_sanskrit": "नेदं सम्यग्व्यवसितं महर्षे कर्म वैकृतम् ।\nचण्डालस्वस्य हरणमभक्ष्यस्य विशेषतः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2184973, "chapter_id": 4923, "verse_number": "५५", "content_sanskrit": "साध्वन्यमनुपश्य त्वमुपायं प्राणधारणे ।\nन मांसलोभात् तपसो नाशस्ते स्यान्महामुने\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2184974, "chapter_id": 4923, "verse_number": "५६", "content_sanskrit": "जानतोऽविहितो मार्गो न कार्यो धर्मसङ्करः ।\nमा स्म धर्मं परित्याक्षीस्त्वं हि धर्मविदुत्तमः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2184975, "chapter_id": 4923, "verse_number": "५७", "content_sanskrit": "विश्वामित्रस्ततो राजन्नित्युक्तो भरतर्षभ ।\nक्षुधार्तः प्रत्युवाचेदं पुनरेव महामुनिः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2184976, "chapter_id": 4923, "verse_number": "५८", "content_sanskrit": "निराहारस्य सुमहान्मम कालोऽभिधावतः ।\nन विद्यतेऽभ्युपायश्च कश्चिन्मे प्राणधारणे\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2184977, "chapter_id": 4923, "verse_number": "५९", "content_sanskrit": "येन तेन विशेषेण कर्मणा येन केनचित् ।\nअभ्युज्जीवेत् सीदमानः समर्थो धर्ममाचरेत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2184978, "chapter_id": 4923, "verse_number": "६०", "content_sanskrit": "ऐन्द्रो धर्मः क्षत्रियाणां ब्राह्मणानामथाग्निकः ।\nब्रह्मवह्निर्मम बलं भोक्ष्यामि शमयन् क्षुधम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2184979, "chapter_id": 4923, "verse_number": "६१", "content_sanskrit": "यथा यथा वै जीवेद्धि तत् कर्तव्यमपीडया ।\nजीवितं मरणाच्छ्रेयो जीवन् धर्ममवाप्नुयात्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2184980, "chapter_id": 4923, "verse_number": "६२", "content_sanskrit": "सोऽहं जीवितमाकाङ्क्षन्नभक्षस्यापि भक्षणम् ।\nव्यवस्ये बुद्धिपूर्वं वै तद्भवाननुमन्यताम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2184981, "chapter_id": 4923, "verse_number": "६३", "content_sanskrit": "जीवन् धर्मं चरिष्यामि प्रणोत्स्याम्यशुभानि च ।\nतपोभिर्विद्यया चैव ज्योतींषीव महत्तमः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2184982, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2184983, "chapter_id": 4923, "verse_number": "६४", "content_sanskrit": "नैतत्खादन् प्राप्स्यसे प्राणमद्य\nनायुर्दीर्घं नामृतस्येव तृप्तिम् ।\nभिक्षामन्यां भिक्ष मा ते मनोऽस्तु\nश्वभक्षणे श्वा ह्यभक्ष्यो द्विजानाम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2184984, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2184985, "chapter_id": 4923, "verse_number": "६५", "content_sanskrit": "न दुर्भिक्षे सुलभं मांसमद्यं\nश्वपाक नान्नं न च मेऽस्ति वित्तम् ।\nक्षुधार्तश्चाहमगतिर्निराशः\nश्वमांसे चास्मिन् षड्रसान् साधु मन्ये\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2184986, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2184987, "chapter_id": 4923, "verse_number": "६६", "content_sanskrit": "पञ्च पञ्चनखा भक्ष्या ब्रह्मक्षत्रस्य वै द्विज ।\nयदि शास्त्रं प्रमाणं ते माभक्ष्ये मानसं कृथाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2184988, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2184989, "chapter_id": 4923, "verse_number": "६७", "content_sanskrit": "अगस्त्येनासुरो जग्धो वातापिः क्षुधितेन वै ।\nअहमापद्गतः क्षुब्धो भक्षयिष्ये श्वजाघनीम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2184990, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2184991, "chapter_id": 4923, "verse_number": "६८", "content_sanskrit": "भिक्षामन्यामाहरेति न चैतत् कर्तुमर्हसि ।\nन नूनं कार्यमेतद्वै हर कामं श्वजाघनीम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2184992, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2184993, "chapter_id": 4923, "verse_number": "६९", "content_sanskrit": "शिष्टा वै कारणं धर्मे तद्वृत्तमनुवर्तये ।\nपरां मेध्याशनादेतां भक्ष्यां मन्ये श्वजाघनीम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2184994, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2184995, "chapter_id": 4923, "verse_number": "७०", "content_sanskrit": "असता यत् समाचीर्णं न स धर्मः सनातनः ।\nनावृत्तमनुकार्यं वै मा छलेनानृतं कृथाः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2184996, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2184997, "chapter_id": 4923, "verse_number": "७१", "content_sanskrit": "न पातकं न चावृत्तं मृषा तत् कर्तुमर्हसि ।\nसमौ च श्वमृगौ मन्ये तस्माद्भक्ष्या श्वजाघनी\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2184998, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2184999, "chapter_id": 4923, "verse_number": "७२", "content_sanskrit": "यद् ब्राह्मणार्थे कृतमर्थितेन\nतेनर्षिणा तदभक्ष्यं न कस्मात् ।\nस वै धर्मो यत्र न पापमस्ति\nसर्वैरुपायैर्हि स रक्षितव्यः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2185000, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2185001, "chapter_id": 4923, "verse_number": "७३", "content_sanskrit": "मित्रं च मे ब्राह्मणश्चायमात्मा\nप्रियश्च मे पूज्यतमश्च लोके ।\nतं भर्तुकामोऽहमिमां हरिष्ये\nनृशंसानामीदृशानां न बिभ्ये\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2185002, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2185003, "chapter_id": 4923, "verse_number": "७४", "content_sanskrit": "कामं नरा जीवितं सन्त्यजन्ति\nन चाभक्ष्यैः प्रतिकुर्वन्ति तत्र ।\nसर्वान् कामान् प्राप्नुवन्तीह विद्वन्\nप्रियस्व कामं सहितः क्षुधा वै\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2185004, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2185005, "chapter_id": 4923, "verse_number": "७५", "content_sanskrit": "स्थाने भवेत् संशयः प्रेत्यभावे\nनिःसंशयं कर्मणो वै विनाशः ।\nअहं पुनर्वर्त इत्याशयात्मा\nशुष्कं रक्ष्यं भक्षयिष्याम्यभक्ष्यम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2185006, "chapter_id": 4923, "verse_number": "७६", "content_sanskrit": "बुद्ध्यात्मके व्यक्तमस्मीति सृष्टो\nमोक्षात्मके त्वं यथा शिष्टचक्षुः ।\nयद्यप्येतत् संशयाच्च त्रपामि\nनाहं भविष्यामि यथा न माया\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2185007, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2185008, "chapter_id": 4923, "verse_number": "७७", "content_sanskrit": "गोपनीयमिदं दुःखमिति मे निश्चिता मतिः ।\nदुष्कृतं ब्राह्मणं सन्तं यस्त्वामहमुपालभे\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2185009, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2185010, "chapter_id": 4923, "verse_number": "७८", "content_sanskrit": "पिबन्त्येवोदकं गावो मण्डूकेषु रुवत्स्वपि ।\nन तेऽधिकारो धर्मेऽस्ति मा भूरात्मप्रशंसकः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2185011, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2185012, "chapter_id": 4923, "verse_number": "७९", "content_sanskrit": "सुहृद्भूत्वानुशास्मि त्वा कृपा हि त्वयि मे द्विज ।\nतदेवं श्रेय आधत्स्व मा लोभाच्छ्वानमादिथाः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2185013, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2185014, "chapter_id": 4923, "verse_number": "८०", "content_sanskrit": "सुहृन्मे त्वं सुखेप्सुश्चेदापदो मां समुद्धर ।\nजानेऽहं धर्मतोऽऽत्मानमुत्सृजेमां श्वजाघनीम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2185015, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2185016, "chapter_id": 4923, "verse_number": "८१", "content_sanskrit": "नैवोत्सहे भवते दातुमेतां\nनोपेक्षितुं ह्रियमाणं स्वमन्नम् ।\nउभौ स्यावः स्वमलेनावलिप्तौ\nदाताहं च त्वं च विप्र प्रतीच्छन्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2185017, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2185018, "chapter_id": 4923, "verse_number": "८२", "content_sanskrit": "अद्याहमेतद् वृजिनं कर्म कृत्वा\nजीवंश्चरिष्यामि महापवित्रम् ।\nप्रपूतात्मा धर्ममेवाभिपत्स्ये\nयदेतयोर्गुरु तद्वै ब्रवीहि\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2185019, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2185020, "chapter_id": 4923, "verse_number": "८३", "content_sanskrit": "आत्मैव साक्षी किल लोककृत्ये\nत्वमेव जानासि यदत्र दुष्टम् ।\nयो ह्याद्रियेद् भक्ष्यमिति श्वमांसं\nमन्ये न तस्यास्ति विवर्जनीयम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2185021, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2185022, "chapter_id": 4923, "verse_number": "८४", "content_sanskrit": "उपाधानैः साधते नापि दोषः\nकार्ये सिद्धे मित्र नात्रापवादः ।\nअस्मिन्नहिंसा नानृते वाक्यलेशो\nभक्ष्यक्रिया तत्र न तद् गरीयः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2185023, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2185024, "chapter_id": 4923, "verse_number": "८५", "content_sanskrit": "यद्येष हेतुस्तव तत्स्वादने स्यात्\nन ते वेदः कारणं नापि धर्मः ।\nतस्माद् भक्ष्ये भक्षणे वा द्विजेन्द्र\nदोषं न पश्यामि यदर्थमाह\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2185025, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2185026, "chapter_id": 4923, "verse_number": "८६", "content_sanskrit": "न पातकं भक्षणमस्य दृष्टं\nसुरां पीत्वा पततीति शब्दः ।\nअन्योन्यकार्याणि यथा तथैव\nन लेपमात्रेण कृतं हिनस्ति\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2185027, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "श्वपचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2185028, "chapter_id": 4923, "verse_number": "८७", "content_sanskrit": "अस्थानतो हीनतः कुत्सिताद्वा\nतं विद्वांसं बाधते साधुवृत्तम् ।\nस्थानं पुनर्यो लभतेऽतिभङ्गात्\nतेनापि दण्डः प्रहितः स एव\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2185029, "chapter_id": 4923, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2185030, "chapter_id": 4923, "verse_number": "८८", "content_sanskrit": "एवमुक्त्वा निववृते मातङ्गः कौशिकं तदा ।\nविश्वामित्रो जहारैव कृतबुद्धिः श्वजाघनीम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2185031, "chapter_id": 4923, "verse_number": "८९", "content_sanskrit": "ततो जग्राह पञ्चाङ्गीं जीवितार्थी महामुनिः ।\nसदारस्तामुपाकृत्य वने यातो महामुनिः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2185032, "chapter_id": 4923, "verse_number": "९०", "content_sanskrit": "एतस्मिन्नेव काले तु प्रववर्षाथ वासवः ।\nसञ्जीवयन् प्रजाः सर्वा जनयामास चौषधीः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2185033, "chapter_id": 4923, "verse_number": "९१", "content_sanskrit": "विश्वामित्रोऽपि भगवांस्तपसा दग्धकिल्बिषः ।\nकालेन महता सिद्धिमवाप परमाद्भुताम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2185034, "chapter_id": 4923, "verse_number": "९२", "content_sanskrit": "एवं विद्वानदीनात्मा व्यसनस्थो जिजीविषुः ।\nसर्वोपायैरुपायज्ञो दीनमात्मानमुद्धरेत्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2185035, "chapter_id": 4923, "verse_number": "९३", "content_sanskrit": "एतां बुद्धिं समास्थाय जीवितव्यं सदा भवेत् ।\nजीवन् पुण्यमवाप्नोति नरो भद्राणि पश्यति\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2185036, "chapter_id": 4923, "verse_number": "९४", "content_sanskrit": "तस्मात् कौन्तेय विदुषा धर्माधर्मविनिश्चये ।\nबुद्धिमास्थाय लोकेऽस्मिन्वर्तितव्यं यतात्मना\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2185037, "chapter_id": 4923, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे एकादशोऽध्यायः ॥ ११ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}]