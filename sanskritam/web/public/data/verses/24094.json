[{"id": 7004094000, "chapter_id": 24094, "verse_number": "४-४३-१", "content_sanskrit": "अगस्तिरुवाच ।\nदिवोदासं नरपतिं कथं देवस्त्रिलोचनः ।\nकाशीं संत्याजयामास कथमागाच्च मंदरात् ।\nएतदाख्यानमाख्याहि श्रोतॄणां प्रमुदे भगोः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004094001, "chapter_id": 24094, "verse_number": "४-४३-२", "content_sanskrit": "स्कंद उवाच ।\nमंदरं गतवान्देवो ब्रह्मणो वाक्य गौरवात् ।\nतपसा तस्य संतुष्टो मंदरस्यैव भूभृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004094002, "chapter_id": 24094, "verse_number": "४-४३-३", "content_sanskrit": "गते विश्वेश्वरे देवे मंदरं गिरिसुंदरम् ।\nगिरिशेन समं जग्मुरपि सर्वे दिवौकसः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004094003, "chapter_id": 24094, "verse_number": "४-४३-४", "content_sanskrit": "क्षेत्राणि वैष्णवानीह त्यक्त्वा विष्णुरपि क्षितेः ।\nप्रयातो मंदरं यत्र देवदेव उमाधवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004094004, "chapter_id": 24094, "verse_number": "४-४३-५", "content_sanskrit": "स्थानानि गाणपत्यानि गणेशोपि ततो व्रजत् ।\nहित्वाहमपि विप्रेंद्र गतवान्मंदरं प्रति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004094005, "chapter_id": 24094, "verse_number": "४-४३-६", "content_sanskrit": "सूरः सौराणि संत्यज्य गतश्चायतनादरम् ।\nस्वंस्वं स्थानं क्षितौ त्यक्त्वा ययुरन्येपि निर्जराः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004094006, "chapter_id": 24094, "verse_number": "४-४३-७", "content_sanskrit": "गतेषु देवसंघेषु पृथिव्याः पृथिवीपतिः ।\nचकार राज्यं निर्द्वंद्वं दिवोदासः प्रतापवान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004094007, "chapter_id": 24094, "verse_number": "४-४३-८", "content_sanskrit": "विधाय राजधानीं स वाराणस्यां सुनिश्चलाम् ।\nएधां चक्रे महाबुद्धिः प्रजाधर्मेण पालयन् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004094008, "chapter_id": 24094, "verse_number": "४-४३-९", "content_sanskrit": "सूर्यवत्स प्रतपिता दुर्हृदां हृदि नेत्रयोः ।\nसोमवत्सुहृदामासीन्मानसेषु स्वकेष्वऽपि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004094009, "chapter_id": 24094, "verse_number": "४-४३-१०", "content_sanskrit": "अखंडमाखंडलवत्कोदंडकलयन्रणे ।\nपलायमानैरालोकिशत्रुसैन्यबलाहकैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004094010, "chapter_id": 24094, "verse_number": "४-४३-११", "content_sanskrit": "स धर्मराजवज्जातो धर्माधर्मविवेचकः ।\nअदंड्यान्मण्डयन्राजा दंड्यांश्च परिदंडयन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004094011, "chapter_id": 24094, "verse_number": "४-४३-१२", "content_sanskrit": "धनंजय इवाधाक्षीत्परारण्यान्यनेकशः ।\nपाशीव पाशयांचक्रे वैरिचक्रं विदूरगः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004094012, "chapter_id": 24094, "verse_number": "४-४३-१३", "content_sanskrit": "सोभूत्पुण्यजनाधीशो रिपुराक्षसवर्धनः ।\nजगत्प्राणसमानश्च जगत्प्राणनतत्परः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004094013, "chapter_id": 24094, "verse_number": "४-४३-१४", "content_sanskrit": "राजराजः स एवाभूत्सर्वेषां धनदः सताम् ।\nस एव रुद्रमूर्तिश्च प्रेक्षिष्ट रिपुभी रणे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004094014, "chapter_id": 24094, "verse_number": "४-४३-१५", "content_sanskrit": "विश्वेषां स हि देवानां तपसा रूपधृग्यतः ।\nविश्वेदेवास्ततस्तं तु स्तुवंति च भजंति च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004094015, "chapter_id": 24094, "verse_number": "४-४३-१६", "content_sanskrit": "असाध्यः स हि साध्यानां वसुभ्यो वसुनाधिकः ।\nग्रहाणां विग्रहधरो दस्रतोऽजस्ररूपभाक् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004094016, "chapter_id": 24094, "verse_number": "४-४३-१७", "content_sanskrit": "मरुद्गणानगणयंस्तुषितांस्तोषयन्गुणैः ।\nसर्वविद्याधरो यस्तु सर्वविद्याधरेष्वपि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004094017, "chapter_id": 24094, "verse_number": "४-४३-१८", "content_sanskrit": "अगर्वानेव गंधर्वान्यश्चक्रे निजगीतिभिः ।\nररक्षुर्यक्षरक्षांसि तद्दुर्गं स्वर्गसोदरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004094018, "chapter_id": 24094, "verse_number": "४-४३-१९", "content_sanskrit": "नागानागांसि चक्रुश्च तस्य नागबलीयसः ।\nदनुजामनुजाकारं कृत्वा तं च सिषेविरे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004094019, "chapter_id": 24094, "verse_number": "४-४३-२०", "content_sanskrit": "जाता गुह्यचरा यस्य गुह्यकाः परितो नृषु ।\nसंसेविष्यामहे राजन्नसुरास्त्वां स्ववैभवैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004094020, "chapter_id": 24094, "verse_number": "४-४३-२१", "content_sanskrit": "वयं यतस्त्वद्विषये सुरावासोऽपि दुर्लभः ।\nअशिक्षयत्क्षितिपतेरिह यस्य तुरंगमान् ।\nआशुगश्चाशुगामित्वं पावमाने पथिस्थितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004094021, "chapter_id": 24094, "verse_number": "४-४३-२२", "content_sanskrit": "अगजान्यस्य तु गजान्नगवर्ष्मसुवर्ष्मणः ।\nअजस्र दानिनो दृष्ट्वा भवन्नन्येपि दानिनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004094022, "chapter_id": 24094, "verse_number": "४-४३-२३", "content_sanskrit": "सदोजिरे च बोद्धारो योद्धारश्चरणाजिरे ।\nन यस्य शास्त्रैर्विजिता न शस्त्रैः केनचित्क्वचित् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004094023, "chapter_id": 24094, "verse_number": "४-४३-२४", "content_sanskrit": "न नेत्रविषये जाता विषये यस्यभूभृतः ।\nसदा नष्टपदा द्वेष्यास्तदाऽनष्टपदाः प्रजाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004094024, "chapter_id": 24094, "verse_number": "४-४३-२५", "content_sanskrit": "कलावानेक एवास्ति त्रिदिवेपि दिवौकसाम् ।\nतस्य क्षोणिभृतः क्षोण्यां जनाः सर्वे कलालयाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004094025, "chapter_id": 24094, "verse_number": "४-४३-२६", "content_sanskrit": "एक एव हि कामोस्ति स्वर्गे सोप्यंगवर्जितः ।\nसांगोपांगाश्च सर्वेषां सर्वे कामा हि तद्भुवि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004094026, "chapter_id": 24094, "verse_number": "४-४३-२७", "content_sanskrit": "तस्योपवर्तनेप्येको न श्रुतो गोत्रभित्क्वचित् ।\nस्वर्गे स्वर्गसदामीशो गोत्रभित्परिकीर्तितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004094027, "chapter_id": 24094, "verse_number": "४-४३-२८", "content_sanskrit": "क्षयी च तस्य विषये कोप्याकर्णि न केनचित् ।\nत्रिविष्टपे क्षपानाथः पक्षेपक्षे क्षयीष्यते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004094028, "chapter_id": 24094, "verse_number": "४-४३-२९", "content_sanskrit": "नाके नवग्रहाः संति देशास्तस्याऽनवग्रहाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004094029, "chapter_id": 24094, "verse_number": "४-४३-३०", "content_sanskrit": "हिरण्यगर्भः स्वर्लोकेप्येक एव प्रकाशते ।\nहिरण्यगर्भाः सर्वेषां तत्पौराणामिहालयाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004094030, "chapter_id": 24094, "verse_number": "४-४३-३१", "content_sanskrit": "सप्ताश्व एकः स्वर्लोके नितरां भासतेंऽशुमान् ।\nसदंशुकाः प्रतिदिनं बह्वश्वास्तत्पुरौकसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004094031, "chapter_id": 24094, "verse_number": "४-४३-३२", "content_sanskrit": "सदप्सरा यथास्वर्भूस्तत्पुर्यपिसदप्सराः ।\nएकैव पद्मा वैकुंठे तस्य पद्माकराः शतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004094032, "chapter_id": 24094, "verse_number": "४-४३-३३", "content_sanskrit": "अनीतयश्च तद्ग्रामानाराजपुरुषाः क्वचित् ।\nगृहेगृहेत्र धनदा नाक एकोऽलकापतिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004094033, "chapter_id": 24094, "verse_number": "४-४३-३४", "content_sanskrit": "दिवोदासस्य तस्यैवं काश्यां राज्यं प्रशासतः ।\nगतं वर्षं दिनप्रायं शरदामयुताष्टकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004094034, "chapter_id": 24094, "verse_number": "४-४३-३५", "content_sanskrit": "गीर्वाणा विप्रतीकारमथ तस्य चिकीर्षवः ।\nगुरुणा मंत्रयांचक्रुर्धर्मवर्त्मानुयायिनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004094035, "chapter_id": 24094, "verse_number": "४-४३-३६", "content_sanskrit": "भवादृशामिव मुने प्रायशो धर्मचारिणाम् ।\nविबुधा विदधत्येव महतीरापदांततीः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004094036, "chapter_id": 24094, "verse_number": "४-४३-३७", "content_sanskrit": "यद्यप्यसौ धराधीशो व्याधिनोद्दुर्धराध्वरैः ।\nतानध्वरभुजोऽत्यंतं तथापि सुहृदो न ते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004094037, "chapter_id": 24094, "verse_number": "४-४३-३८", "content_sanskrit": "स्वभाव एव द्युसदां परोत्कर्षासहिष्णुता ।\nबलि बाण दधीच्याद्यैरपराद्धं किमत्र तैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004094038, "chapter_id": 24094, "verse_number": "४-४३-३९", "content_sanskrit": "अंतराया भवंत्येव धर्मस्यापि पदेपदे ।\nतथापि न निजो धर्मो धर्मधीभिर्विमुच्यते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004094039, "chapter_id": 24094, "verse_number": "४-४३-४०", "content_sanskrit": "अधर्मिणः समेधंते धनधान्यसमृद्धिभिः ।\nअधर्मादेव च परं समूलं यांत्यधोगतिम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004094040, "chapter_id": 24094, "verse_number": "४-४३-४१", "content_sanskrit": "प्रजाः पालयतस्तस्य पुत्रानिव निजौरसान् ।\nरिपुंजयस्य नाल्पोपि बभूवाधर्मसंग्रहः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004094041, "chapter_id": 24094, "verse_number": "४-४३-४२", "content_sanskrit": "षाड्गुण्यवेदिनस्तस्य त्रिशक्त्यूर्जितचेतसः ।\nचतुरोपायवित्तस्य न रंध्रं विविदुः सुराः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004094042, "chapter_id": 24094, "verse_number": "४-४३-४३", "content_sanskrit": "बुद्धिमंतोपि विबुधा विप्रतीकर्तुमुद्यताः ।\nमनागपि न संशेकुरपकर्तुं तदीशितुः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004094043, "chapter_id": 24094, "verse_number": "४-४३-४४", "content_sanskrit": "एकपत्नीव्रताः सर्वे पुमांसस्तस्य मंडले ।\nनारीषु काचिन्नैवासीदपतिव्रतधर्मिणी ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004094044, "chapter_id": 24094, "verse_number": "४-४३-४५", "content_sanskrit": "अनधीतो न विप्रोभूदशूरोनैव बाहुजः ।\nवैश्योनभिज्ञो नैवासीदर्थोपार्जनकर्मसु ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004094045, "chapter_id": 24094, "verse_number": "४-४३-४६", "content_sanskrit": "अनन्यवृत्तयः शूद्रा द्विजशुश्रूषणं प्रति ।\nतस्य राष्ट्रे समभवन्दिवोदासस्य भूपतेः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004094046, "chapter_id": 24094, "verse_number": "४-४३-४७", "content_sanskrit": "अविप्लुत ब्रह्मचर्यास्तद्राष्ट्रे ब्रह्मचारिणः ।\nनित्यं गुरुकुलाधीना वेदग्रहणतत्पराः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004094047, "chapter_id": 24094, "verse_number": "४-४३-४८", "content_sanskrit": "आतिथ्यधर्मप्रवणा धर्मशास्त्रविचक्षणाः ।\nनित्यसाधुसमाचारा गृहस्थास्तस्य सर्वतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004094048, "chapter_id": 24094, "verse_number": "४-४३-४९", "content_sanskrit": "तृतीयाश्रमिणो यस्मिन्वनवृत्तिकृतादराः ।\nनिःस्पृहा ग्रामवार्तासु वेदवर्त्मानुसारिणः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004094049, "chapter_id": 24094, "verse_number": "४-४३-५०", "content_sanskrit": "सर्वसंगविनिर्मुक्ता निर्मुक्ता निष्परिग्रहाः ।\nवाङ्मनःकर्मदंडाढ्या यतयो यत्र निःस्पृहाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004094050, "chapter_id": 24094, "verse_number": "४-४३-५१", "content_sanskrit": "अन्येनुलोमजन्मानः प्रतिलो मभवा अपि ।\nस्वपारंपर्यतो दृष्टं मनाग्वर्त्म न तत्यजुः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004094051, "chapter_id": 24094, "verse_number": "४-४३-५२", "content_sanskrit": "अनपत्या न तद्राष्ट्रे धनहीनोपि कोपि न ।\nअवृद्धसेवी नो कश्चिदकांडमृतिभाक्च न ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004094052, "chapter_id": 24094, "verse_number": "४-४३-५३", "content_sanskrit": "न चाटा नैव वाचाटा वंचका नो न हिंसकाः ।\nन पाषंडा न वै भंडा न रंडा न च शौंडिकाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004094053, "chapter_id": 24094, "verse_number": "४-४३-५४", "content_sanskrit": "श्रुतिघोषो हि सर्वत्र शास्त्रवादः पदेपदे ।\nसर्वत्र सुभगालापा मुदामंगलगीतयः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004094054, "chapter_id": 24094, "verse_number": "४-४३-५५", "content_sanskrit": "वीणावेणुप्रवादाश्च मृदंगा मधुरस्वनाः ।\nसोमपानं विनान्यत्र पानगोष्ठी न कर्णगा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004094055, "chapter_id": 24094, "verse_number": "४-४३-५६", "content_sanskrit": "मांसाशिनः पुरोडाशे नैवान्यत्र कदाचन ।\nन दुरोदरिणो यत्र नाधमर्णा न तस्कराः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004094056, "chapter_id": 24094, "verse_number": "४-४३-५७", "content_sanskrit": "पुत्रस्य पित्रोः पदयोः पूजनं देवपूजनम् ।\nउपवासो व्रतं तीर्थं देवताराधनं परम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004094057, "chapter_id": 24094, "verse_number": "४-४३-५८", "content_sanskrit": "नारीणां भर्तृपद् योरर्चनं तद्वचःश्रुतिः ।\nसमर्चयंति सततमनुजा निजमग्रजम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004094058, "chapter_id": 24094, "verse_number": "४-४३-५९", "content_sanskrit": "सपर्ययंति मुदिता भृत्याः स्वामिपदांबुजम् ।\nहीनवर्णैरग्रवर्णो वर्ण्यते गुणगौरवैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004094059, "chapter_id": 24094, "verse_number": "४-४३-६०", "content_sanskrit": "वरिवस्यंति भूयोपि त्रिकालं काशिदेवताः ।\nसर्वत्र सर्वे विद्वांसः समर्च्यंते मनोरथैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004094060, "chapter_id": 24094, "verse_number": "४-४३-६१", "content_sanskrit": "विद्वद्भिश्च तपोनिष्ठास्तपोनिष्ठैर्जितेंद्रियाः ।\nजितेंद्रियैर्ज्ञाननिष्ठा ज्ञानिभिः शिवयोगिनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004094061, "chapter_id": 24094, "verse_number": "४-४३-६२", "content_sanskrit": "मंत्रपूतं महार्हं च विधियुक्तं सुसंस्कृतम् ।\nवाडवानां मुखाग्नौ च हूयतेऽहर्निशं हविः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004094062, "chapter_id": 24094, "verse_number": "४-४३-६३", "content_sanskrit": "वापीकूपतडागानामारामाणां पदेपदे ।\nशुचिभिर्द्रव्यसंभारैः कर्तारो यत्र भूरिशः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004094063, "chapter_id": 24094, "verse_number": "४-४३-६४", "content_sanskrit": "यद्राष्ट्रे हृष्टपुष्टाश्च दृश्यंते सर्वजातयः ।\nअनिंद्यसेवा संपन्ना विनामृगयु सौनिकान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004094064, "chapter_id": 24094, "verse_number": "४-४३-६५", "content_sanskrit": "इत्थं तस्य महीजानेः सर्वत्र शुचिवर्तिनः ।\nउन्मिषंतोप्यनिमिषा मनाक्छिद्रं न लेभिरे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004094065, "chapter_id": 24094, "verse_number": "४-४३-६६", "content_sanskrit": "अथोवाचामर गुरुर्देवानपचिकीर्षुकान् ।\nतस्मिन्राजनि धर्मिष्ठे वरिष्ठे मंत्रवेदिषु ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004094066, "chapter_id": 24094, "verse_number": "४-४३-६७", "content_sanskrit": "गुरुरुवाच ।\nसंधिविग्रहयानास्ति सं श्रयं द्वैधभावनम् ।\nयथा स राजा संवेत्ति न तथात्रापि कश्चन ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004094067, "chapter_id": 24094, "verse_number": "४-४३-६८", "content_sanskrit": "उपायोप्येक एवास्ति चतुर्ष्विह दिवौकसः ।\nभेदो नाम स चेत्सिध्येत्तपोबलिनि तत्र हि ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004094068, "chapter_id": 24094, "verse_number": "४-४३-६९", "content_sanskrit": "तेन यद्यपि भूभर्त्रा भूमेर्देवा विवासिताः ।\nतथापि भूरिशस्तत्र संत्यस्मत्पक्षपातिनः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004094069, "chapter_id": 24094, "verse_number": "४-४३-७०", "content_sanskrit": "कालो निमिषमात्रोपि यान्विना न सुखं व्रजेत् ।\nअस्माकमपि तस्यापि संति ते तत्र मानिताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004094070, "chapter_id": 24094, "verse_number": "४-४३-७१", "content_sanskrit": "अंतर्बहिश्चरा नित्यं सर्वविश्रंभ भूमयः ।\nसमागतेषु तेष्वत्र सर्वं नः सेत्स्यति प्रियम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004094071, "chapter_id": 24094, "verse_number": "४-४३-७२", "content_sanskrit": "समाकर्ण्य च ते सर्वे त्रिदशा गीष्पतीरितम् ।\nनिर्णीतवंतस्तस्यार्थं तस्मादंतर्बहिश्चरान् ।\nअभिनंद्याथ तं सर्वे प्रोचुरित्थं भवेदिति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004094072, "chapter_id": 24094, "verse_number": "४-४३-७३", "content_sanskrit": "ततः शक्रः समाहूय वीतिहोत्रं पुरःस्थितम् ।\nऊचे मधुरया वाचा बहुमानपुरःसरम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004094073, "chapter_id": 24094, "verse_number": "४-४३-७४", "content_sanskrit": "हव्यवाहन या मूर्तिस्तव तत्र प्रतिष्ठिता ।\nतामुपासंहर क्षिप्रं विषयात्तस्य भूपतेः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004094074, "chapter_id": 24094, "verse_number": "४-४३-७५", "content_sanskrit": "समागतायां तन्मूर्तौ सर्वानष्टाग्रयः प्रजाः ।\nहव्यकव्यक्रियाशून्या विरजिष्यंति राजनि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004094075, "chapter_id": 24094, "verse_number": "४-४३-७६", "content_sanskrit": "प्रजासु च विरक्तासु राज्यकामदुघासु वै ।\nकृच्छ्रेणोपार्जितोऽपार्थो राजशब्दो भविष्यति ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004094076, "chapter_id": 24094, "verse_number": "४-४३-७७", "content_sanskrit": "प्रजानां रंजनाद्राजा येयं रूढिरुपार्जिता ।\nतस्यां रूढ्यां प्रनष्टायां राज्यमेव विनंक्ष्यति ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004094077, "chapter_id": 24094, "verse_number": "४-४३-७८", "content_sanskrit": "प्रजाविरहितो राजा कोशदुर्गबलादिभिः ।\nसमृद्धोप्यचिरान्नश्येत्कूलसंस्थ इव द्रुमः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004094078, "chapter_id": 24094, "verse_number": "४-४३-७९", "content_sanskrit": "त्रिवर्गसाधनाहेतुः प्राक्प्रजैव महीपतेः ।\nक्षीणवृत्त्यां प्रजायां वै त्रिवर्गः क्षीयते स्वयम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004094079, "chapter_id": 24094, "verse_number": "४-४३-८०", "content_sanskrit": "क्षीणे त्रिवर्गे संक्षीणा गतिर्लोकद्वयात्मिका ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004094080, "chapter_id": 24094, "verse_number": "४-४३-८१", "content_sanskrit": "इतींद्रवचनाद्वह्निरह्नाय क्षोणिमंडलात् ।\nआचकर्ष निजां मूर्तिं योगमाया बलान्वितः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004094081, "chapter_id": 24094, "verse_number": "४-४३-८२", "content_sanskrit": "निन्ये न केवलं त्रेतां जाठराग्निमपि प्रभुः ।\nवज्रिणो वचसा वह्निर्निजशक्तिसमन्वितम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004094082, "chapter_id": 24094, "verse_number": "४-४३-८३", "content_sanskrit": "वह्नौ स्वर्लोकमापन्ने जाते मध्यंदिने नृपः ।\nकृतमाध्याह्निकस्तूर्णं प्राविशद्भोज्यमंडपम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004094083, "chapter_id": 24094, "verse_number": "४-४३-८४", "content_sanskrit": "महानसाधिकृतयो वेपमानास्ततो मुहुः ।\nक्षुधार्तमपि भूपालमिदं मंदं व्यजिज्ञपन् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004094084, "chapter_id": 24094, "verse_number": "४-४३-८५", "content_sanskrit": "सूपकारा ऊचुः ।\nअत्यहस्करतेजस्क प्रतापविजितानल ।\nकिंचिद्विज्ञप्तुकामाः स्मोप्यकांडेरणपंडित ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004094085, "chapter_id": 24094, "verse_number": "४-४३-८६", "content_sanskrit": "यदि विश्रुणयेद्राजन्भवानभयदक्षिणाम् ।\nतदा विज्ञापयिष्यामः प्रबद्धकरसंपुटाः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004094086, "chapter_id": 24094, "verse_number": "४-४३-८७", "content_sanskrit": "भ्रूसंज्ञयाकृतादेशाः प्रशस्तास्येनभूभुजा ।\nमृदु विज्ञापयांचक्रुः पाकशालाधिकारिणः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004094087, "chapter_id": 24094, "verse_number": "४-४३-८८", "content_sanskrit": "न जानीमो वयं नाथ त्वत्प्रतापभयार्दितः ।\nकुसृत्याथ कया विद्वान्नष्टो वैश्वानरः पुरात् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004094088, "chapter_id": 24094, "verse_number": "४-४३-८९", "content_sanskrit": "कृशानौ कृशतां प्राप्ते कथं पाकक्रिया भवेत् ।\nतथापि सूर्यपाकेन सिद्धा पक्तिर्हि काचन ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004094089, "chapter_id": 24094, "verse_number": "४-४३-९०", "content_sanskrit": "प्रभोरादेशमासाद्य तामिहैवानयामहे ।\nमन्यामहे च भूजाने पक्तिरद्यतनी शुभा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004094090, "chapter_id": 24094, "verse_number": "४-४३-९१", "content_sanskrit": "श्रुत्वांधसिकवाक्यं स महासत्त्वो महामतिः ।\nनृपतिश्चिंतयामास देवानां वै कृतं त्विदम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004094091, "chapter_id": 24094, "verse_number": "४-४३-९२", "content_sanskrit": "क्षणं संशीलयंस्तत्र ददर्श तपसोबलात् ।\nन केवलं जहौ गेहं हुतभुक्चौदरीर्दरीः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004094092, "chapter_id": 24094, "verse_number": "४-४३-९३", "content_sanskrit": "अप्यहासीदितोलोकाज्जगाम च सुरालयम् ।\nभवत्विह हि का हानिरस्माकं ज्वलने गतै ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004094093, "chapter_id": 24094, "verse_number": "४-४३-९४", "content_sanskrit": "तेषामेवविचाराच्च हानिरेषा सुपर्वणाम् ।\nतद्बलेन च किं राज्यं मयेदमुररीकृतम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004094094, "chapter_id": 24094, "verse_number": "४-४३-९५", "content_sanskrit": "पितामहेन महतो गौरवात्प्रतिपादितम् ।\nइति चिंतयतस्तस्य मध्यलोकशतक्रतोः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004094095, "chapter_id": 24094, "verse_number": "४-४३-९६", "content_sanskrit": "पौराः समागता द्वारि सह जानपदैर्नरैः ।\nद्वास्थेन चाज्ञया राज्ञस्ततस्तेंतः प्रवेशिताः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004094096, "chapter_id": 24094, "verse_number": "४-४३-९७", "content_sanskrit": "दत्त्वोपदं यथार्हं ते प्रणेमुः क्षोणिवज्रिणम् ।\nकेचित्संभाषिता राज्ञादरसोदरया गिरा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004094097, "chapter_id": 24094, "verse_number": "४-४३-९८", "content_sanskrit": "केचिच्च समुदा दृष्ट्या केचिच्च करसंज्ञया ।\nविसर्जिता सना राज्ञा बहुमानपुरःसरम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004094098, "chapter_id": 24094, "verse_number": "४-४३-९९", "content_sanskrit": "तेजिरे भेजिरे सर्वे रत्नार्चिः परिसेविते ।\nविजितामोदसंदोहे सुरानोकहसौरभैः ।\nराज्ञः शतशलाकस्थच्छत्रस्यच्छाययाशुभे ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004094099, "chapter_id": 24094, "verse_number": "४-४३-१००", "content_sanskrit": "विशांपतिरथोवाच तन्मुखच्छाययेरितम् ।\nविज्ञाय तदभिप्रायमलंभीत्या पुरौकसः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004094100, "chapter_id": 24094, "verse_number": "४-४३-१०१", "content_sanskrit": "विकारकारिभिर्लेखैर्यदिनीतोऽनलो भुवः ।\nएतावतैव किं सिद्धयेन्मयि तेषां पराभवः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004094101, "chapter_id": 24094, "verse_number": "४-४३-१०२", "content_sanskrit": "चिकीर्षुरहमेवासं पौराः कार्यमिदंपुरा ।\nपरं ह्युपेक्षितप्रायं दिष्ट्या तैः स्मारितं चिरात् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004094102, "chapter_id": 24094, "verse_number": "४-४३-१०३", "content_sanskrit": "गतोऽनलोऽभवद्भद्रं जगत्प्राणोपि यात्वितः ।\nवरुणः पुष्पवंताभ्यामविलंबं प्रयात्वितः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004094103, "chapter_id": 24094, "verse_number": "४-४३-१०४", "content_sanskrit": "अहमेव हि पर्जन्यो भविष्यामि तपोबलात् ।\nमुदे जनपदानां च सर्वसस्यसमृद्धिदः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004094104, "chapter_id": 24094, "verse_number": "४-४३-१०५", "content_sanskrit": "तपोयोगबलेनाहमात्मानं परिकल्प्य च ।\nत्रिधावह्निस्वरूपेण पक्तीष्टिव्युष्टिकृत्तमः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004094105, "chapter_id": 24094, "verse_number": "४-४३-१०६", "content_sanskrit": "अंतर्बहिश्च यो द्वेधा नभस्वत्पदवी दधत् ।\nसर्वेषामेव वेत्स्यामि त्वंतःकरणचेष्टितम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004094106, "chapter_id": 24094, "verse_number": "४-४३-१०७", "content_sanskrit": "विधाय चांभसीं मूर्तिं सर्वजीवैकजीवनीम् ।\nप्रजाः संजीवयिप्यामि किं जडैर्विषये मम ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004094107, "chapter_id": 24094, "verse_number": "४-४३-१०८", "content_sanskrit": "यदा खे तमसा पौरा ग्रस्येते शशिभास्करौ ।\nतदा न किं विना ताभ्यां जीवामः क्षितिमंडले ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004094108, "chapter_id": 24094, "verse_number": "४-४३-१०९", "content_sanskrit": "श्रियं चांद्रमसीं प्राप्य ह्लादयिष्याम्यहं प्रजाः ।\nनिशाचरेण किमिह क्षयिणा च कलंकिना ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004094109, "chapter_id": 24094, "verse_number": "४-४३-११०", "content_sanskrit": "अस्मत्कुले मूलभूतो भास्करो मान्य एव नः ।\nस तिष्ठतु सुखेनात्र यातायातं करोतु च ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004094110, "chapter_id": 24094, "verse_number": "४-४३-१११", "content_sanskrit": "स एको जगतामात्मा विशेषात्कुलदेवता ।\nसोपकर्तुं न वेत्त्येव तस्येदं व्रतमुत्तमम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004094111, "chapter_id": 24094, "verse_number": "४-४३-११२", "content_sanskrit": "इति नरपतिवाक्सुधारसौघं श्रुतिपुटकैः परिपीय पौरवर्गः ।\nविकसितवदनांबुजो जगामनिजनिजमालयमाधिमुक्तचित्तः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004094112, "chapter_id": 24094, "verse_number": "४-४३-११३", "content_sanskrit": "क्षितिपतिरपि तत्तथा विधाय तपसोसाध्यमिहास्ति किं त्रिलोक्याम् ।\nअतिवह्न्यर्कमसौ दधच्चतेजो द्युसदां शल्यमिवोच्चकैर्बभूव ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}]