[{"id": 7006026000, "chapter_id": 26026, "verse_number": "१-२१०-१", "content_sanskrit": "सूत उवाच ।\nसससलगाश्च विषमे पादे यद्युपचित्रकम् ।\nसमे भौ भगगाः स्युश्च द्रुतमध्या भभौ भगौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006026001, "chapter_id": 26026, "verse_number": "१-२१०-२", "content_sanskrit": "गः पादे विषमेऽन्यत्र नजौ ज्यौ च गणौ स्मृतौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006026002, "chapter_id": 26026, "verse_number": "१-२१०-३", "content_sanskrit": "विषमे वेगवती सा गः समे भौ भो गगौ गणाः ।\nपादेऽसमे तजौ रो गः समे मसौ जगौ गरु ।\nभवेद्भद्रविराट्केतुमती तु विषमे सजौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006026003, "chapter_id": 26026, "verse_number": "१-२१०-४", "content_sanskrit": "सगौ समे भ्रौ नगगा आख्यानकी त्वथासमे ।\nतौ जो गगौ समे पादे जतजा गुरुकद्वयम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006026004, "chapter_id": 26026, "verse_number": "१-२१०-५", "content_sanskrit": "विपरीताख्यानकं स्याद्विषमे जस्तजौ गगौ ।\nततौ जगौ समे गः स्यात्पिङ्गलेन ह्युदाहृतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006026005, "chapter_id": 26026, "verse_number": "१-२१०-६", "content_sanskrit": "पादेऽथ विषमे चैव पुष्पिताग्रा ननौ रयौ ।\nसमे नजौ जरौ गश्च वैतालीयं वदन्ति हि ।\nवृत्तञ्चापरवक्त्राख्यमौपच्छन्दसिकं परम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006026006, "chapter_id": 26026, "verse_number": "१-२१०-७", "content_sanskrit": "वाङ्मती रजरा यः स्यादयुग्मे जरजा रगौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]