[{"id": 2136294, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136295, "chapter_id": 3955, "verse_number": "१", "content_sanskrit": "राघवः सहसौमित्रिः सुग्रीवेणाभिपालितः ।\nवसन्माल्यवतः पृष्ठे ददृशे विमलं नभः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136296, "chapter_id": 3955, "verse_number": "२", "content_sanskrit": "स दृष्ट्वा विमले व्योम्नि निर्मलं शशलक्ष्म(क्ष)णम् ।\nग्रहनक्षत्रताराभिरनुयातममित्रहा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136297, "chapter_id": 3955, "verse_number": "३", "content_sanskrit": "कुमुदोत्पलपद्मानां गन्धमादाय वायुना ।\nमहीधरस्थः शीतेन सहसा प्रतिबोधितः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136298, "chapter_id": 3955, "verse_number": "४", "content_sanskrit": "प्रभाते लक्ष्मणं वीरमभ्यभाषत दुर्मनाः ।\nसीतां संस्मृत्य धर्मात्मा रुद्धां राक्षसवेश्मनि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136299, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "श्रीरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136300, "chapter_id": 3955, "verse_number": "५", "content_sanskrit": "गच्छ लक्ष्मण जानीहि किष्किन्धायां कपीश्वरम् ।\nप्रमत्तं ग्राम्यधर्मेषु कृतघ्नं स्वार्थपण्डितम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136301, "chapter_id": 3955, "verse_number": "६", "content_sanskrit": "योऽसौ कुलाधमो मूढो मया राज्येऽभिषेचितः ।\nसर्ववानरगोपुच्छा यमृक्षाश्च भजन्ति वै \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136302, "chapter_id": 3955, "verse_number": "७", "content_sanskrit": "यदर्थं निहतो वाली मया रघुकुलोद्वह ।\nत्वया सह महाबाहो किष्किन्धोपवने तदा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136303, "chapter_id": 3955, "verse_number": "८", "content_sanskrit": "कृतघ्नं तमहं मन्ये वानरापसदं भुवि ।\nयो मामेवङ्गतं(तो) मूढो न जानीतेऽद्य लक्ष्मण \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136304, "chapter_id": 3955, "verse_number": "९", "content_sanskrit": "असौ मन्ये न जानीते समयप्रतिपालनम् ।\nकृतोपकारं मां नूनमवमन्याल्पया धिया \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136305, "chapter_id": 3955, "verse_number": "१०", "content_sanskrit": "यदि तावदनुद्युक्तः शेते कामसुखात्मकः ।\nनेतव्यो वालिमार्गेण सर्वभूतगतिं त्वया \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136306, "chapter_id": 3955, "verse_number": "११", "content_sanskrit": "अथापि घटतेऽस्माकमर्थे वानरपुङ्गवः ।\nतमादायैव काकुत्स्थ त्वरावान् भव माचिरम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136307, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136308, "chapter_id": 3955, "verse_number": "१२", "content_sanskrit": "इत्युक्तो लक्ष्मणो भ्रात्रा गुरुवाक्यहिते रतः ।\nप्रतस्थे रुचिरं गृह्य समार्गणगुणं धनुः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136309, "chapter_id": 3955, "verse_number": "१३", "content_sanskrit": "किष्किन्धाद्वारमासाद्य प्रविवेशानिवारितः ।\nसक्रोध इति तं मत्वा राजा प्रत्युद(द्य)यौ हरिः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136310, "chapter_id": 3955, "verse_number": "१४", "content_sanskrit": "तं सदारो विनीतात्मा सुग्रीवः प्लवगाधिपः ।\nपूजया प्रतिजग्राह प्रीयमाणस्तदर्हया \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136311, "chapter_id": 3955, "verse_number": "१५", "content_sanskrit": "तमब्रवीद् रामवचः सौमित्रिरकुतोभयः।\nस तत्सर्वमशेषेण श्रुत्वा प्रह्वः कृताञ्जलिः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136312, "chapter_id": 3955, "verse_number": "१६", "content_sanskrit": "सभृत्यदारो राजेन्द्रः(न्द्र) सुग्रीवो वानराधिपः ।\nइदमाह वचः प्रीतो लक्ष्मणं नरकुञ्जरम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136313, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "सुग्रीवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136314, "chapter_id": 3955, "verse_number": "१७", "content_sanskrit": "नास्मि लक्ष्मण दुर्मेधा नाकृतज्ञो न निर्घृणः ।\nश्रूयतां यः प्रयत्नो मे सीतापर्येषणे कृतः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136315, "chapter_id": 3955, "verse_number": "१८", "content_sanskrit": "दिशः प्रस्थापिताः सर्वे विनीता हरयो मया ।\nसर्वेषां च कृतः कालो मासेनागमनं पुनः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136316, "chapter_id": 3955, "verse_number": "१९", "content_sanskrit": "यैरियं सवना साद्रिः सपुरा सागराम्बरा ।\nविचेतव्या मही वीर सग्रामनगराकरा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136317, "chapter_id": 3955, "verse_number": "२०", "content_sanskrit": "स मासः पञ्चरात्रेण पूर्णो भवितुमर्हति ।\nततः श्रोष्यसि रामेण सहितः सुमहत् प्रियम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136318, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136319, "chapter_id": 3955, "verse_number": "२१", "content_sanskrit": "इत्युक्तो लक्ष्मणस्तेन वानरेन्द्रेण धीमता ।\nत्वक्त्वा रोषमदीनात्मा सुग्रीवं प्रत्यपूजयत् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136320, "chapter_id": 3955, "verse_number": "२२", "content_sanskrit": "स रामं सहसुग्रीवो माल्यवत्पृष्ठमास्थितम् ।\nअभिगम्योदयं तस्य कार्यस्य प्रत्यवेदयत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136321, "chapter_id": 3955, "verse_number": "२३", "content_sanskrit": "इत्येवं वानरेन्द्रास्ते समाजग्मुः सहस्रशः ।\nदिशस्तिस्रो विचित्याथ न तु ये दक्षिणां गताः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136322, "chapter_id": 3955, "verse_number": "२४", "content_sanskrit": "आचख्युस्तत्र रामाय महीं सागरमेखलाम् ।\nविचितां न तु वैदेह्या दर्शनं रावणस्य वा \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136323, "chapter_id": 3955, "verse_number": "२५", "content_sanskrit": "गतास्तु दक्षिणामाशां ये वै वानरपुङ्गवाः ।\nआशावांस्तेषु काकुत्स्थः प्राणानार्तोऽभ्यधारयत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136324, "chapter_id": 3955, "verse_number": "२६", "content_sanskrit": "द्विमासोपरमे काले व्यतीते प्लवगास्ततः ।\nसुग्रीवमभिगम्येदं त्वरिता वाक्यमब्रुवन् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136325, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "वानराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136326, "chapter_id": 3955, "verse_number": "२७", "content_sanskrit": "रक्षितं वालिना यत्तत्स्फीतं मधुवनं महत् ।\nत्वया च प्लवगश्रेष्ठ तद् भुङ्क्ते पवनात्मजः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136327, "chapter_id": 3955, "verse_number": "२८", "content_sanskrit": "वालिपुत्रोऽङ्गदश्चैव ये चान्ये प्लवगर्षभाः ।\nविचेतुं दक्षिणामाशां राजन् प्रस्थापितास्त्वया \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136328, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136329, "chapter_id": 3955, "verse_number": "२९", "content_sanskrit": "तेषां तत्प्रणयं(षामपनयं) श्रुत्वा मेने स कृतकृत्यताम् ।\nकृतार्थानां हि भृत्यानामेतद् भवति चेष्टितम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136330, "chapter_id": 3955, "verse_number": "३०", "content_sanskrit": "स तद्रामाय मेधावी शशंस प्लवगर्षभः ।\nरामश्चाप्यनुमानेन मेने दृष्टां तु मैथिलीम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136331, "chapter_id": 3955, "verse_number": "३१", "content_sanskrit": "हनू(नु)मत्प्रमुखाश्चापि विश्रुतास्ते प्लवङ्गमाः ।\nअभिजग्मुर्हरीन्द्रं तं रामलक्ष्मणसंनिधौ \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136332, "chapter_id": 3955, "verse_number": "३२", "content_sanskrit": "गतिं च मुखवर्णं च दृष्ट्वा रामो हनूमतः ।\nअगमत् प्रत्ययं भूयो दृष्टा सीतेति भारत \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136333, "chapter_id": 3955, "verse_number": "३३", "content_sanskrit": "हनुमत् प्रमुखास्ते तु वानराः पूर्णमानसाः ।\nप्रणेमुर्विधिवद्रामं सुग्रीवं लक्ष्मणं तथा ।\nतानुवाचाग(न)तान् रामः प्रगृह्य सशरं धनुः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136334, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "श्रीरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136335, "chapter_id": 3955, "verse_number": "३४", "content_sanskrit": "अपि मां जीवयिष्यध्वमपि वः कृतकृत्यता ।\nअपि राज्यमयोध्यायां कारयिष्याम्यहं पुनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136336, "chapter_id": 3955, "verse_number": "३५", "content_sanskrit": "निहत्य समरे शत्रूनाहृत्य जनकात्मजाम् ।\nअमोक्षयित्वा वैदेहीमहत्वा च रणे रिपून् । \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136337, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "हृतदारोऽवधूतश्च नाहं जीवितुमुत्सहे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136338, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136339, "chapter_id": 3955, "verse_number": "३६", "content_sanskrit": "इत्युक्तवचनं रामं प्रत्युवाचानिलात्मजः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136340, "chapter_id": 3955, "verse_number": "३७", "content_sanskrit": "प्रियमाख्यामि ते राम दृष्टा सा जानकी मया\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136341, "chapter_id": 3955, "verse_number": "३८", "content_sanskrit": "विचित्य दक्षिणामाशां सपर्वतवनाकराम् ।\nश्रान्ताः काले व्यतीते स्म दृष्टवन्तो महागुहाम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136342, "chapter_id": 3955, "verse_number": "३९", "content_sanskrit": "प्रविशामो वयं तां तु बहुयोजनमायताम् ।\nअ(सा)न्धकारां सुविपिनां गहनां कीटसेविताम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136343, "chapter_id": 3955, "verse_number": "४०", "content_sanskrit": "गत्वा सुमहदध्वानमादित्यस्य प्रभां ततः ।\nदृष्टवन्तः स्म तत्रैव भवनं दिव्यमन्तरा \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2136344, "chapter_id": 3955, "verse_number": "४१", "content_sanskrit": "मयस्य किल दैत्यस्य तदासीद्वेश्म राघव ।\nतत्र प्रभावती नाम तपोऽतप्यत तापसी \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2136345, "chapter_id": 3955, "verse_number": "४२", "content_sanskrit": "तया दत्तानि भोज्यानि पानानि विविधानि च ।\nभुक्त्वा लब्धबलाः सन्तस्तयोक्तेन पथा ततः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2136346, "chapter_id": 3955, "verse_number": "४३", "content_sanskrit": "निर्याय तस्मादुद्देशात् पश्यामो लवणाम्भसः ।\nसमीपे सह्यमलयौ दर्दुरं च महागिरिम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2136347, "chapter_id": 3955, "verse_number": "४४", "content_sanskrit": "ततो मलयमारुह्य पश्यन्तो वरुणालयम् ।\nविषण्णा व्यथिताः खिन्ना निराशा जीविते भृशम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2136348, "chapter_id": 3955, "verse_number": "४५", "content_sanskrit": "अनेकशतविस्तीर्णं योजनानां महोदधिम् ।\nतिमिनक्रझषावासं चिन्तयन्तः सुदुःखिताः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2136349, "chapter_id": 3955, "verse_number": "४६", "content_sanskrit": "तत्रानशनसङ्कल्पं कृत्वाऽऽसीना वयं तदा ।\nततः कथान्ते गृध्रस्य जटायोरभवत् कथा \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2136350, "chapter_id": 3955, "verse_number": "४७", "content_sanskrit": "ततः पर्वतशृङ्गाभं घोररूपं भयावहम् ।\nपक्षिणं दृष्टवन्तः स्म वैनतेयमिवापरम् ।\nसोऽस्मानतर्कयद् भोक्तुमथाभ्येत्य वचोऽब्रवीत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2136351, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "पक्षी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2136352, "chapter_id": 3955, "verse_number": "४८", "content_sanskrit": "भोः क एष मम भ्रातुर्जटायोः कुरुते कथाम् \t॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2136353, "chapter_id": 3955, "verse_number": "४९", "content_sanskrit": "सम्पातिर्नाम तस्याहं ज्येष्ठो भ्राता खगाधिपः ।\nअन्योन्यस्पर्धयारूढावावामादित्यसत्पदम् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2136354, "chapter_id": 3955, "verse_number": "५०", "content_sanskrit": "ततो दग्धाविमौ पक्षौ न दग्धौ तु जटायुषः ।\nतदा मे चिरदृष्टः स भ्राता गृध्रपतिः प्रियः\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2136355, "chapter_id": 3955, "verse_number": "५१", "content_sanskrit": "निर्दग्धपक्षः पतितो ह्यहमस्मिन् महागिरौ ।\nद्रष्टुं वीरं न शक्नोमि भ्रातरं वै जटायुषम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2136356, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "हनुमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2136357, "chapter_id": 3955, "verse_number": "५२", "content_sanskrit": "तस्यैवं वदतोऽस्माभिर्हतो भ्राता निवेदितः ।\nव्यसनं भवतश्चेदं सङ्क्षेपाद् वै निवेदितम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2136358, "chapter_id": 3955, "verse_number": "५३", "content_sanskrit": "स सम्पातिस्तदा राजन् श्रुत्वा सुमहदप्रियम् ।\nविषण्णचेताः पप्रच्छ पुनरस्मानरिन्दम \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2136359, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "सम्पातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2136360, "chapter_id": 3955, "verse_number": "५४", "content_sanskrit": "कः स रामः कथं सीता जटायुश्च कथं हतः ।\nइच्छामि सर्वमेवैतच्छ्रोतुं प्लवगसत्तमाः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2136361, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "हनुमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2136362, "chapter_id": 3955, "verse_number": "५५", "content_sanskrit": "तस्याहं सर्वमेवैतद् भवतो व्यसनागमम् ।\nप्रायोपवेशने चैव हेतुं विस्तरशोऽब्रुवम् ।\nसोऽस्मानुत्थापयामास वाक्येनानेन पक्षिराट् \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2136363, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "सम्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2136364, "chapter_id": 3955, "verse_number": "५६", "content_sanskrit": "रावणो विदितो मह्यं लङ्का चास्य महापुरी ।\nदृष्टा पारे समुद्रस्य त्रिकूटगिरिकन्दरे \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2136365, "chapter_id": 3955, "verse_number": "५७", "content_sanskrit": "भवित्री तत्र वैदेही न मेऽस्त्यत्र विचारणा \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2136366, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "हनुमान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2136367, "chapter_id": 3955, "verse_number": "समाप्तिः", "content_sanskrit": "इति तस्य वचः श्रुत्वा वयमुत्थाय सत्वराः ।\nसागरक्रमणे मन्त्रं मन्त्रयामः परन्तप \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2136368, "chapter_id": 3955, "verse_number": "५९", "content_sanskrit": "नाध्यवास्यद् यदा कश्चित् सागरस्य विलङ्घनम् ।\nततः पितरमाविश्य पुप्लु(प्ल)वेऽहं महार्णवम् ।\nशतयोजनविस्तीर्णं निहत्य जलराक्षसीम् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2136369, "chapter_id": 3955, "verse_number": "६०", "content_sanskrit": "तत्र सीता मया दृष्टा रावणान्तःपुरे सती ।\nउपवासतपःशीला भर्तृदर्शनलालसा \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2136370, "chapter_id": 3955, "verse_number": "६१", "content_sanskrit": "जटिला मलदिग्धाङ्गी कृशा दीना तपस्विनी \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2136371, "chapter_id": 3955, "verse_number": "६२", "content_sanskrit": "निमित्तैस्तामहं सीतामुपलभ्य पृथग्विधैः ।\nउपसृत्याब्रुवं चार्यामभिगम्य रहोगताम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2136372, "chapter_id": 3955, "verse_number": "६३", "content_sanskrit": "सीते रामस्य दूतोऽहं वानरो मारुतात्मजः ।\nत्वद् दर्शनमभिप्रेप्सुरिह प्राप्तो विहायसा \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2136373, "chapter_id": 3955, "verse_number": "६४", "content_sanskrit": "राजपुत्रौ कुशलिनौ भ्रातरौ रामलक्ष्मणौ ।\nसर्वशाखामृगेन्द्रेण सुग्रीवेणाभिपालितौ \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2136374, "chapter_id": 3955, "verse_number": "६५", "content_sanskrit": "कुशलं त्वाऽब्रवीद् रामः सीते सौमित्रिणा सह ।\nसखिभावाच्च सुग्रीवः कुशलं त्वानुपृच्छति \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2136375, "chapter_id": 3955, "verse_number": "६६", "content_sanskrit": "क्षिप्रमेष्यति ते भर्ता सर्वशाखामृगैः सह ।\nप्रत्ययं कुरु मे देवि वानरोऽस्मि न राक्षसः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2136376, "chapter_id": 3955, "verse_number": "६७", "content_sanskrit": "मुहूर्तमिव च ध्यात्वा सीता मां प्रत्युवाच ह ।\nअवैमि त्वां हनूमन्तमविन्ध्यवचनादहम्\t ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2136377, "chapter_id": 3955, "verse_number": "६८", "content_sanskrit": "अविन्ध्यो हि महाबाहो राक्षसो वृद्धसम्मतः ।\nकथितस्तेन सुग्रीवस्त्वद्विधैः सचिवैर्वृतः ।\nगम्यतामिति चोक्त्वा मां सीता प्रादादिमं मणिम् \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2136378, "chapter_id": 3955, "verse_number": "६९", "content_sanskrit": "धारिता येन वैदेही कालमेतमनिन्दिता ।\nप्रत्ययार्थं कथां चेमां कथयामास जानकी \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2136379, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "जानकी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2136380, "chapter_id": 3955, "verse_number": "७०", "content_sanskrit": "क्षिप्तामिषीकां काकाय चित्रकूटे महागिरौ ।\nभवता पुरुषव्याघ्र प्रत्यभिज्ञानकारणात् ।\nएकाक्षिविकलः काकः सुदुष्टात्मा कृतश्च वै \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2136381, "chapter_id": 3955, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2136382, "chapter_id": 3955, "verse_number": "७१", "content_sanskrit": "ग्राहयित्वाहमात्मानं ततो दग्ध्वा च तां पुरीम् ।\nसम्प्राप्त इति तं रामः प्रियवादिनमार्चयत् \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2136383, "chapter_id": 3955, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकसप्तत्यधिकद्विशततमोऽध्यायः ॥२७१॥\nरामोपाख्यानपर्वणि हनुमत्प्रत्यागमने एकादशोऽध्यायः ॥११॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]