[{"id": 2100771, "chapter_id": 3163, "verse_number": "१४-१९-१", "content_sanskrit": "ब्राह्मण उवाच।\nशुभानामशुभानां च नेह नाशोस्ति कर्मणाम्।\nप्राप्यप्राप्यानुपच्यन्ते क्षेत्रेक्षेत्रे तथातथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100772, "chapter_id": 3163, "verse_number": "१४-१९-२", "content_sanskrit": "यथा प्रसूयमानस्तु फली दद्यात्फलं बहु।\nतथा स्याद्विपुलं पुण्यं शुद्धेन मनसा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100773, "chapter_id": 3163, "verse_number": "१४-१९-३", "content_sanskrit": "पापं चापि तथैव स्यात्पापेन मनसा कृतम्।\nपुरोधाय मनो हीह कर्मण्यात्मा प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100774, "chapter_id": 3163, "verse_number": "१४-१९-४", "content_sanskrit": "यथा कर्मसमाविष्टः काममन्युसमावृतः।\nनरो गर्भं प्रविशति तत्रापि शृणु चोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100775, "chapter_id": 3163, "verse_number": "१४-१९-५", "content_sanskrit": "शुक्रं शोणितसंसृष्टं स्त्रिया गर्भाशयं गतम्।\nक्षेत्रं कर्मजमाप्नोति शुभं वा यदि वाऽशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100776, "chapter_id": 3163, "verse_number": "१४-१९-६", "content_sanskrit": "सौक्ष्म्यादव्यक्तयावाच्च न च क्वचन सज्जति।\nसम्प्राप्य ब्राह्मणः कायं तस्मात्तद्ब्रह्म शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100777, "chapter_id": 3163, "verse_number": "१४-१९-७", "content_sanskrit": "तद्बीजं सर्वभूतानां तेन जीवन्ति जन्तवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100778, "chapter_id": 3163, "verse_number": "१४-१९-८", "content_sanskrit": "स जीवः सर्वभूतानां गर्भमाविश्य भागशः।\nदधाति चेतना सद्यः प्राणस्थानेष्ववस्थितः।\nततः स्पन्दयतेऽङ्गानि स गर्भश्चेतनान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100779, "chapter_id": 3163, "verse_number": "१४-१९-९", "content_sanskrit": "यथा लोहस्य विष्यन्दो निषिक्तो बिम्बविग्रहम्।\nउपैति तद्वज्जानीहि गर्भे जीवप्रवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100780, "chapter_id": 3163, "verse_number": "१४-१९-१०", "content_sanskrit": "लोहपिण्डं यथा वह्निः प्रविश्य ह्यतितापयेत्।\nतथा त्वमपि जानीहि गर्भे जीवोपपादनम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100781, "chapter_id": 3163, "verse_number": "१४-१९-११", "content_sanskrit": "यथा च दीपः शरणं दीप्यमानः प्रकाशयेत्।\nएवमेव शरीराणि प्रकाशयति चेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100782, "chapter_id": 3163, "verse_number": "१४-१९-१२", "content_sanskrit": "यद्यच्च कुरुते कर्म शुभं वा यदि वाऽशुभम्।\nपूर्वदेहकृतं सर्वमवश्यमुपभुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100783, "chapter_id": 3163, "verse_number": "१४-१९-१३", "content_sanskrit": "ततस्तु क्षीयते चैव पुनश्चान्यत्प्रचीयते।\nयावत्तु मोक्षयोगस्थं धर्मं नैवावबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100784, "chapter_id": 3163, "verse_number": "१४-१९-१४", "content_sanskrit": "तत्ते धर्मं प्रवक्ष्यामि सुखी भवति येन वै।\nआवर्तमानो जातीषु यथाऽन्योन्यासु सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100785, "chapter_id": 3163, "verse_number": "१४-१९-१५", "content_sanskrit": "दानं व्रतं ब्रह्मचर्यं यथोक्तव्रतधारणम्।\nदमः प्रशान्तता चैव भूतानां चानुकम्पनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100786, "chapter_id": 3163, "verse_number": "१४-१९-१६", "content_sanskrit": "संयमश्चानृशंस्य च परस्वादानवर्जनम्।\nव्यलीकानामकरणं भूताना मनसा भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100787, "chapter_id": 3163, "verse_number": "१४-१९-१७", "content_sanskrit": "मातापित्रोश्च शुश्रूषा देवतातितिपूजनम्।\nगुरुपूजा घृणा शौचं नित्यमिन्द्रयसंयमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100788, "chapter_id": 3163, "verse_number": "१४-१९-१८", "content_sanskrit": "प्रवर्तनं शुभानां च तत्सतां व्रतमुच्यते।\nततो धर्मः प्रभवति यः प्रजाः पाति शाश्वतीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100789, "chapter_id": 3163, "verse_number": "१४-१९-१९", "content_sanskrit": "`सद्भिराचरितो धर्मः सदाचारे प्रतिष्ठितः।\nउभयार्थो भवत्येव स्वर्गार्थो मोक्षतस्तथा॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100790, "chapter_id": 3163, "verse_number": "१४-१९-२०", "content_sanskrit": "एवं सत्सु सदा पश्येत्तत्रछाप्येषा ध्रुवा स्थितिः।\nआचारो धर्ममाचष्टे यस्मिन्सन्तो व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100791, "chapter_id": 3163, "verse_number": "१४-१९-२१", "content_sanskrit": "तेषु तत्कर्म निक्षिप्तं यः स धर्मः सनातनः।\nयस्तं समभिपद्येत न स दुर्गतिमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100792, "chapter_id": 3163, "verse_number": "१४-१९-२२", "content_sanskrit": "अतो नियम्यते लोकः प्रच्यवन्धर्मवर्त्मसु।\nयश्च योगी च मुक्तश्च स ऐतेभ्यो विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100793, "chapter_id": 3163, "verse_number": "१४-१९-२३", "content_sanskrit": "वर्तमानस्य धर्मेण पुरुषस्य यथा तथा।\nसंसारतारणं ह्यस्य कालेन महता भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100794, "chapter_id": 3163, "verse_number": "१४-१९-२४", "content_sanskrit": "एवं पूर्वकृतं कर्म सर्वो जन्तुः प्रपद्यते।\nसर्वं तत्कारणं येन निकृतोऽप्यमिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100795, "chapter_id": 3163, "verse_number": "१४-१९-२५", "content_sanskrit": "शरीरग्रहणं चास्य केन पूर्वं प्रकल्पितम्।\nइत्येवं संशये लोके तच्च वक्ष्याम्यतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100796, "chapter_id": 3163, "verse_number": "१४-१९-२६", "content_sanskrit": "शरीरमात्मनः कृत्वा सर्वलोकपितामहः।\nत्रैलोक्यमसृजद्ब्रह्मा कृत्स्नं स्थावरजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100797, "chapter_id": 3163, "verse_number": "१४-१९-२७", "content_sanskrit": "ततः प्रधानमसृजच्चेतनां तु शरीरिणाम्।\nयया सर्वमिदं व्याप्तं यां लोके परमां विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100798, "chapter_id": 3163, "verse_number": "१४-१९-२८", "content_sanskrit": "इदं तत्क्षरमित्युक्तं परं त्वमृतमक्षरम्।\nत्रयाणां मिथुनं सर्वमेकैकस्य पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100799, "chapter_id": 3163, "verse_number": "१४-१९-२९", "content_sanskrit": "असृजत्सर्वभूतानि पूर्वदृष्टः प्रजापतिः।\nस्थावराणि च भूतानि इत्येषा पौर्विकी श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100800, "chapter_id": 3163, "verse_number": "१४-१९-३०", "content_sanskrit": "तस्य कालपरीमाणमकरोत्स पितामहः।\nभूतेषु परिवृत्तिं च पनरावृत्तिमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100801, "chapter_id": 3163, "verse_number": "१४-१९-३१", "content_sanskrit": "यथा तु कश्चिन्मेधावी दृष्टात्मा पूर्वजन्मनि।\nयत्प्रवक्ष्यामि तत्सर्वं यथावदुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100802, "chapter_id": 3163, "verse_number": "१४-१९-३२", "content_sanskrit": "सुखदुःखे यथा सम्यगनित्ये यः प्रपश्यति।\nकायं चामेध्यसंस्थानं विनाशं कर्मसंहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100803, "chapter_id": 3163, "verse_number": "१४-१९-३३", "content_sanskrit": "यच्च किञ्चित्सुखं तच्च दुःखं दृष्टमिति स्मरन्।\nसंसारसागरं घोरं तरिष्यति सुदुस्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100804, "chapter_id": 3163, "verse_number": "१४-१९-३४", "content_sanskrit": "जनीमरणरोगैश्च समाविष्टः प्रधानवित्।\nचेतनाव्तसु चैतन्यं समं भूतेषु पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100805, "chapter_id": 3163, "verse_number": "१४-१९-३५", "content_sanskrit": "निर्विद्यते ततः कश्चिन्मार्गमाणः परं पदम्।\nतस्योपदेशं वक्ष्यामि याथातथ्येन सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100806, "chapter_id": 3163, "verse_number": "१४-१९-३६", "content_sanskrit": "शाश्वतस्याव्ययस्याथ् यदस्य ज्ञानमुत्तमम्।\nप्रोच्यमानं मया विप्र निबोधदमशेषतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2100807, "chapter_id": 3163, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकोविंशोऽध्यायः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]