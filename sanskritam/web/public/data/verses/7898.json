[{"id": 33000379, "chapter_id": 7898, "verse_number": "1", "content_sanskrit": "यानि पूर्वमसङ्गत्या नैवाऽऽख्यातान्यचक्षत । वक्ष्यन्ते तानि वर्गेऽस्मिन्‌ प्रकीर्णाऽऽख्ये यथास्मृति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000380, "chapter_id": 7898, "verse_number": "2", "content_sanskrit": "विभाति व्युच्छते व्युष्टे प्रभाति विविशत्यपि । श्विन्दते श्वेतते त्रीणि स्युः शुक्लत्वेऽवदायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000381, "chapter_id": 7898, "verse_number": "3", "content_sanskrit": "रज्यति त्रीणि रजति लोहितायति चाऽऽत्मने । शोणतीति च रञ्जिम्नि श्यामत्वे श्यामलायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000382, "chapter_id": 7898, "verse_number": "4", "content_sanskrit": "नीलायते नीलति च तथा श्यामायते पदम्‌ । बिन्दत्यवयवे भिन्दत्यवयौति सटत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000383, "chapter_id": 7898, "verse_number": "5", "content_sanskrit": "सङ्घाते झटति श्रोणत्येवं जटति पूलति । गोष्टते लोष्टते श्लोणत्यपि म्रक्षति पिण्डते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000384, "chapter_id": 7898, "verse_number": "6", "content_sanskrit": "श्लोकते हुण्डते पिण्डयति पूलयतीत्यपि । शण्डतेऽथो मुस्तयति स्त्यायत्यश्नोति चाऽक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}]