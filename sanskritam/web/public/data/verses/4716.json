[{"id": 2175225, "chapter_id": 4716, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175226, "chapter_id": 4716, "verse_number": "१", "content_sanskrit": "वसिष्ठापवाहो ब्रह्मन् वै भीमवेगः कथं नु सः ।\nकिमर्थं च सरिच्छ्रेष्ठा तमृषिं प्रत्यवाहयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175227, "chapter_id": 4716, "verse_number": "२", "content_sanskrit": "केन चाप्यभवद्वैरं कारणं किं च तत् प्रभो ।\nवद पृष्टो महाप्राज्ञ न हि तृप्यामि ते वचः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175228, "chapter_id": 4716, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175229, "chapter_id": 4716, "verse_number": "३", "content_sanskrit": "विश्वामित्रस्य चैवर्षेर्वसिष्ठस्य च भारत ।\nभृशं वैरमभूद् राजन् तपःस्पर्धाकृतं महत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175230, "chapter_id": 4716, "verse_number": "४", "content_sanskrit": "आश्रमो वै वसिष्ठस्य स्थाणुतीर्थेऽभवन्महान् ।\nपूर्वतः पश्चिमश्चासीद् विश्वामित्रस्य धीमतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175231, "chapter_id": 4716, "verse_number": "५", "content_sanskrit": "यत्र स्थाणुर्महाराज तप्तवान् सुमहत् तपः ।\nयत्रास्य कर्म तद्घोरं प्रवदन्ति मनीषिणः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175232, "chapter_id": 4716, "verse_number": "६", "content_sanskrit": "यत्रेष्ट्वा भगवान् स्थाणुः पूजयित्वा सरस्वतीम् ।\nस्थापयामास तत्तीर्थं स्थाणुतीर्थमिति प्रभुः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175233, "chapter_id": 4716, "verse_number": "७", "content_sanskrit": "यत्र सर्वे सुराः स्कन्दमभ्यषिञ्चन् नराधिप ।\nसैनापत्येन तं स्कन्दं सुरारिविनिबर्हणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175234, "chapter_id": 4716, "verse_number": "८", "content_sanskrit": "तस्मिन् सारस्वते तीर्थे विश्वामित्रो महातपाः ।\nवसिष्ठं चालयामास तपसोग्रेण तच्छृणु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175235, "chapter_id": 4716, "verse_number": "९", "content_sanskrit": "विश्वामित्रवसिष्ठौ तावहन्यहनि भारत ।\nस्पर्धां तपोन्वितां तीव्रां चक्रतुस्तौ तपोधनौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175236, "chapter_id": 4716, "verse_number": "१०", "content_sanskrit": "तत्राप्यधिकसन्तप्तो विश्वामित्रो महामुनिः ।\nदृष्ट्वा तेजो वसिष्ठस्य चिन्तामभिजगाम ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175237, "chapter_id": 4716, "verse_number": "११", "content_sanskrit": "तस्य बुद्धिरियं चासीद् धर्मनित्यस्य भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175238, "chapter_id": 4716, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175239, "chapter_id": 4716, "verse_number": "१२", "content_sanskrit": "इयं सरस्वती तूर्णं मत्समीपं तपोधनम् ।\nआनयिष्यति वेगेन जपन्तं जपतां वरम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175240, "chapter_id": 4716, "verse_number": "१३", "content_sanskrit": "इहागतं द्विजश्रेष्ठं हनिष्यामि न संशयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175241, "chapter_id": 4716, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175242, "chapter_id": 4716, "verse_number": "१४", "content_sanskrit": "एवं निश्चित्य मनसा विश्वामित्रो महामुनिः ।\nसस्मार सरितां श्रेष्ठां क्रोधसंरक्तलोचनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175243, "chapter_id": 4716, "verse_number": "१५", "content_sanskrit": "सा ध्याता मुनिना तेन व्याकुलत्वं जगाम ह ।\nगत्वा चैव महावीर्यं महाकोपं च भामिनी\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175244, "chapter_id": 4716, "verse_number": "१६", "content_sanskrit": "तदा तं वेपमानाङ्गी विवर्णा प्राञ्जलिर्भृशम् ।\nउपतस्थे मुनिवरं विश्वामित्रं सरस्वती\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175245, "chapter_id": 4716, "verse_number": "१७", "content_sanskrit": "हतवीरा यथा नारी दुःखिता साऽभवद् भृशम् ।\nब्रूहि किं करवाणीति प्रोवाच मुनिसत्तमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175246, "chapter_id": 4716, "verse_number": "१८", "content_sanskrit": "तामुवाच ततः क्रुद्धो वसिष्ठं शीघ्रमानय ।\nयावदेनं निहन्म्यद्य तच्छ्रुत्वा व्यथिता नदी\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175247, "chapter_id": 4716, "verse_number": "१९", "content_sanskrit": "साऽञ्जलिं तु तदा कृत्वा पुण्डरीकनिभेक्षणा ।\nप्राकम्पत भृशं भीता वायुनेवाहता लता\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175248, "chapter_id": 4716, "verse_number": "२०", "content_sanskrit": "तथागतां तु तां दृष्ट्वा वेपमानां कृताञ्जलिम् ।\nअविचारं वसिष्ठं त्वमानय स्वान्तिकं मम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175249, "chapter_id": 4716, "verse_number": "२१", "content_sanskrit": "सा तस्य वचनं श्रुत्वा गत्वा पापं चिकीर्षितम् ।\nवसिष्ठस्य प्रभावञ्च जानन्त्यप्रतिमं भुवि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175250, "chapter_id": 4716, "verse_number": "२२", "content_sanskrit": "साऽभिगम्य वसिष्ठं त इममर्थमचोदयत् ।\nयदुक्ता सरितां श्रेष्ठा विश्वामित्रेण धीमता\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175251, "chapter_id": 4716, "verse_number": "२३", "content_sanskrit": "उभयोः शापयोर्भीता वेपमाना पुनः पुनः ।\nचिन्तयित्वा महाशापमृषिभ्यां त्रासिता भृशम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175252, "chapter_id": 4716, "verse_number": "२४", "content_sanskrit": "तां कृशां च विवर्णां च दृष्ट्वा चिन्तासमन्विताम् ।\nउवाच राजन् धर्मात्मा वसिष्ठः सुमहातपाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175253, "chapter_id": 4716, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175254, "chapter_id": 4716, "verse_number": "२५", "content_sanskrit": "त्राह्यात्मानं सरिच्छ्रेष्ठे वह मां शीघ्रगामिनी ।\nविश्वामित्रः शपेद्धि त्वां मा कृथास्त्वं विचारणाम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175255, "chapter_id": 4716, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175256, "chapter_id": 4716, "verse_number": "२६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा कृपाशीलस्य वै सरित् ।\nचिन्तयामास कौरव्य किं कृत्वा सुकृतं भवेत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175257, "chapter_id": 4716, "verse_number": "२७", "content_sanskrit": "तस्याश्चिन्ता समुत्पन्ना वसिष्ठो मय्यतीव हि ।\nकृतवान् हि दया नित्यं तस्य कार्यं हितं मया\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175258, "chapter_id": 4716, "verse_number": "२८", "content_sanskrit": "अथ कूले स्वके राजन् जपन्तमृषिसत्तमम् ।\nजुह्वानं कौशिकं दृष्ट्वा सरस्वत्यभ्यचिन्तयत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175259, "chapter_id": 4716, "verse_number": "२९", "content_sanskrit": "इदमन्तरमित्येव ततः सा सरितां वरा ।\nकूलापहारमकरोत् स्वेन वेगेन भारत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175260, "chapter_id": 4716, "verse_number": "३०", "content_sanskrit": "कूलापहारेण तेन मैत्रावरुणिरौह्यत ।\nउह्यमानश्च तुष्टाव तदा राजन् सरस्वतीम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175261, "chapter_id": 4716, "verse_number": "३१", "content_sanskrit": "पितामहस्य सरसः प्रवृत्ताऽसि सरस्वति ।\nव्याप्तं चेदं जगत्सर्वं तवैवाम्भोभिरुत्तमैः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175262, "chapter_id": 4716, "verse_number": "३२", "content_sanskrit": "त्वमेवाकाशगा देवि मेघेषूत्सृजते पयः ।\nसर्वाश्चापस्त्वमेवेति यथा वयमधीमहे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175263, "chapter_id": 4716, "verse_number": "३३", "content_sanskrit": "बुद्धिः पुष्टिस्तथा कीर्तिः सिद्धिर्वृद्धिर्यथा तथा ।\nत्वमेव वाणी त्वं स्वाहा त्वय्यायत्तमिदं जगत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175264, "chapter_id": 4716, "verse_number": "३४", "content_sanskrit": "त्वमेव सर्वभूतेषु वससीह चतुर्विधा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175265, "chapter_id": 4716, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175266, "chapter_id": 4716, "verse_number": "३५", "content_sanskrit": "एवं सरस्वती राजन् स्तुता तेन महात्मना ।\nवेगेनोवाह तं विप्रं विश्वामित्राश्रमं प्रति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175267, "chapter_id": 4716, "verse_number": "३६", "content_sanskrit": "न्यवेदयत चाभीक्ष्णं विश्वामित्राय तं मुनिम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175268, "chapter_id": 4716, "verse_number": "३७", "content_sanskrit": "तमानीतं सरस्वत्या दृष्ट्वा कोपसमन्वितः ।\nअथान्वेषत् प्रहरणं वसिष्ठान्तकरं तदा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175269, "chapter_id": 4716, "verse_number": "३८", "content_sanskrit": "तं च क्रुद्धमभिप्रेक्ष्य ब्रह्महत्याभयान्नदी ।\nअपोवाह वसिष्ठं तु प्राचीं दिशमतन्द्रिता\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175270, "chapter_id": 4716, "verse_number": "३९", "content_sanskrit": "उभयोः कुर्वती वाक्यं वञ्चयित्वा च गाधिजम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175271, "chapter_id": 4716, "verse_number": "४०", "content_sanskrit": "ततोऽपवाहितं दृष्ट्वा वसिष्ठमृषिसत्तमम् ।\nअब्रवीदथ सङ्क्रुद्धो विश्वामित्रः सरस्वतीम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175272, "chapter_id": 4716, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175273, "chapter_id": 4716, "verse_number": "४१", "content_sanskrit": "यस्मात् त्वं सरितां श्रेष्ठे वञ्चयित्वा पुनर्गता ।\nशोणितं वह कल्याणि राक्षसानां च सम्मतम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175274, "chapter_id": 4716, "verse_number": "४२", "content_sanskrit": "ततः सरस्वती शप्ता विश्वामित्रेण धीमता ।\nअवहच्छोणितोन्मिश्रं तोयं संवत्सरं तदा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2175275, "chapter_id": 4716, "verse_number": "४३", "content_sanskrit": "अथर्षयश्च देवाश्च गन्धर्वाप्सरसस्तदा ।\nसरस्वतीं तथा दृष्ट्वा बभूवुर्भृशदुःखिताः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2175276, "chapter_id": 4716, "verse_number": "४४", "content_sanskrit": "एवं वसिष्ठोऽपहृतः शीघ्राद् यातो जनाधिप ।\nआगच्छच्च ततो मार्गं स्वमेव सरितां वरा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2175277, "chapter_id": 4716, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि वसिष्ठापवाहो नाम चतुर्दशोऽध्यायः ॥१४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]