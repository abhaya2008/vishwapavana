[{"id": 7001634000, "chapter_id": 21634, "verse_number": "१-२०-१", "content_sanskrit": "नारद उवाच ।\nभगवन्सर्वधर्मज्ञ सर्वशास्त्रार्थपारग ।\nसर्वकर्मवरिष्टं च त्वयोक्तं ध्वजधारणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001634001, "chapter_id": 21634, "verse_number": "१-२०-२", "content_sanskrit": "यस्तु वै सुमतिर्नाम ध्वजारोपपरो मुने ।\nत्वयोक्तस्तस्य चरितं विस्तरेण ममादिश ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001634002, "chapter_id": 21634, "verse_number": "१-२०-३", "content_sanskrit": "सनक उवाच ।\nश्रृणुष्वैकमनाः पुण्यमितिहासं पुरातनम् ।\nब्रह्मणा कथितं मह्यं सर्वपापप्रणाशनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001634003, "chapter_id": 21634, "verse_number": "१-२०-४", "content_sanskrit": "आसीत्पुरा कृतयुगे सुमतिर्नाम भूपतिः ।\nसोमवंशोद्भवः श्रीमान्सत्पद्वीपैकनायकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001634004, "chapter_id": 21634, "verse_number": "१-२०-५", "content_sanskrit": "धर्‌मात्मा सत्यसंपन्नः शुचिवंश्योऽतिथिप्रियः ।\nसर्वलक्षणसंपन्नः सर्वसंपद्विभूषितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001634005, "chapter_id": 21634, "verse_number": "१-२०-६", "content_sanskrit": "सदा हरिकथासेवी हरिपूजापरायणः ।\nहरिभक्तिपराणां च शुश्रूषुर्निरहंकृतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001634006, "chapter_id": 21634, "verse_number": "१-२०-७", "content_sanskrit": "पूज्यपूजारतो नित्यं समदर्शी गुणान्वितः ।\nसर्वभूतहितः शान्तः कृतज्ञः कीर्तिमांस्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001634007, "chapter_id": 21634, "verse_number": "१-२०-८", "content_sanskrit": "तस्य भार्या महाभागा सर्वलक्षणसंयुता ।\nपतिव्रता पतिप्राणा नाम्रा सत्यमतिर्मुने ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001634008, "chapter_id": 21634, "verse_number": "१-२०-९", "content_sanskrit": "तावुभौ दम्पती नित्यं हरिपूजापरायणौ ।\nजातिस्मरौ महाभागौ सत्यज्ञौ सत्परायणौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001634009, "chapter_id": 21634, "verse_number": "१-२०-१०", "content_sanskrit": "अन्नदानरतौ नित्यं जलदानपरायणौ ।\nतडागारामवप्रादौ नसंख्यातान्वितेनतुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001634010, "chapter_id": 21634, "verse_number": "१-२०-११", "content_sanskrit": "सा तु सत्यमतिर्नित्यं शुचिर्विष्णुगृहे सती ।\nनृत्यत्यत्यन्तसन्तुष्टा मनोज्ञा मञ्जुवादिनी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001634011, "chapter_id": 21634, "verse_number": "१-२०-१२", "content_sanskrit": "सोऽपि राजा महाभागो द्वादशीद्धादशीदिने ।\nध्वजमारोपयत्येव मनोज्ञं बहुविस्तरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001634012, "chapter_id": 21634, "verse_number": "१-२०-१३", "content_sanskrit": "एवं हरिपरं नित्यं राजानं धर्मकोविदम् ।\nप्रियां सत्यमतिं चास्य देवा अपि सदास्तुवन् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001634013, "chapter_id": 21634, "verse_number": "१-२०-१४", "content_sanskrit": "त्रिलोके विश्रुतौ ज्ञात्वा दम्पती धर्मको विदौ ।\nआययौ बहुभिः शिष्यैर्द्रष्टुकामो विभाण्डकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001634014, "chapter_id": 21634, "verse_number": "१-२०-१५", "content_sanskrit": "तमायांतं मुनिं श्रुत्वा स तु राजा विभाण्डकम् ।\nप्रत्युद्ययौ सपत्नीकः प्रजाभि र्बहुविस्तरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001634015, "chapter_id": 21634, "verse_number": "१-२०-१६", "content_sanskrit": "कृतातिथ्यक्रियं शान्तं कृतासनपरिग्रहम् ।\nनीचासनस्थितो भूयः प्राञ्जलिर्मुनिमब्रवीत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001634016, "chapter_id": 21634, "verse_number": "१-२०-१७", "content_sanskrit": "राजो वाच ।\nभगवन्कृतकृत्योऽस्मिं त्वदभ्यागमनेन वै ।\nसतामायमनं सन्तं प्रशंसन्ति सुरवावहम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001634017, "chapter_id": 21634, "verse_number": "१-२०-१८", "content_sanskrit": "यत्र स्यान्महतां प्रेम तत्र स्युः सर्वसम्पदः ।\nतेजः कीर्तिर्धनं पुत्रा इति प्राहुर्विपश्चितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001634018, "chapter_id": 21634, "verse_number": "१-२०-१९", "content_sanskrit": "तत्र वृद्धिमुपायान्ति श्रेयांस्यनुदिनं मुने ।\nयत्र सन्तः प्रकुर्वन्ति महतीं करुणां प्रभो ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001634019, "chapter_id": 21634, "verse_number": "१-२०-२०", "content_sanskrit": "यो मृर्ध्नि धारयेदूह्यन्महत्पादजलं रजः ।\nस स्नातः सर्वतीर्थेषु पुण्यात्मा नात्र संशयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001634020, "chapter_id": 21634, "verse_number": "१-२०-२१", "content_sanskrit": "मम पुत्राश्च दाराश्च संपत्त्वयि समर्पिताः ।\nमामाज्ञापय विप्रेन्द्र किं प्रियं करवाणि ते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001634021, "chapter_id": 21634, "verse_number": "१-२०-२२", "content_sanskrit": "विनञ्चवनतं भूपं स निरीक्ष्य मुनीश्वरः ।\nस्पृशन्करेण तं प्रीत्युवाचातिहर्षितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001634022, "chapter_id": 21634, "verse_number": "१-२०-२३", "content_sanskrit": "ऋषिरुवाच ।\nगजन्यदुक्तं भवता तत्सर्वं त्वत्कुलोचितम् ।\nविनयावनतः सर्वो बहुश्रेयो लभेदिह ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001634023, "chapter_id": 21634, "verse_number": "१-२०-२४", "content_sanskrit": "धर्मश्चार्थश्च कामश्च मोक्षश्च नृपसत्तम ।\nविनयाल्लभते मर्त्यो दुर्लभं किं महात्मनाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001634024, "chapter_id": 21634, "verse_number": "१-२०-२५", "content_sanskrit": "प्रीतोऽस्मि तव भूपाल सन्मार्गपरिवर्त्तिनः ।\nस्वस्ति ते सततं भूयाद्यत्पृच्छामि तदुच्यताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001634025, "chapter_id": 21634, "verse_number": "१-२०-२६", "content_sanskrit": "पूजा बहुविधाः सन्ति हरितुष्टिविधायिकाः ।\nतासु नित्यं ध्वजारोपे वर्त्त्से त्वं सदोद्यतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001634026, "chapter_id": 21634, "verse_number": "१-२०-२७", "content_sanskrit": "भार्यापि तव साध्वीयं नित्यं नृत्यपरायणा ।\nकिमर्थमेतद्वृत्तान्तं यथावद्वक्तुमर्हसि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001634027, "chapter_id": 21634, "verse_number": "१-२०-२८", "content_sanskrit": "राजोवाच ।\nश्रृणुष्व भगवन्सर्वं यत्पृच्छसि वदामि तत् ।\nआश्चर्यभूतं लोकानामावयोश्चरितं त्विह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001634028, "chapter_id": 21634, "verse_number": "१-२०-२९", "content_sanskrit": "अहमासं पुरा शूद्रो मालिनिर्नाम सत्तम ।\nकुमार्गनिरतो नित्यं सर्वलोकाहिते रतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001634029, "chapter_id": 21634, "verse_number": "१-२०-३०", "content_sanskrit": "पिशुनो धर्मविद्वेषी देवद्रव्यापहारकः ।\nगोध्नश्च ब्रह्महा चौरः सर्वप्राणिवधे रतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001634030, "chapter_id": 21634, "verse_number": "१-२०-३१", "content_sanskrit": "नित्यं निष्ठुरवक्ता च पापी वेश्यापरायणः ।\nएवं स्थितः कियत्कालमनाहत्यं महदृचः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001634031, "chapter_id": 21634, "verse_number": "१-२०-३२", "content_sanskrit": "सर्वबन्धुपरित्यक्तो दुःखी वनमुपागतः ।\nमृगमांसाशनो नित्यं तथा पान्थाविलुम्पकः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001634032, "chapter_id": 21634, "verse_number": "१-२०-३३", "content_sanskrit": "एकाकी दुःखबहुलो न्यवसन्निर्जने वने ।\nएकदा क्षुत्परिश्रान्तो निदाघार्त्तः पिपासितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001634033, "chapter_id": 21634, "verse_number": "१-२०-३४", "content_sanskrit": "जीर्णं देवालयं विष्णोरपश्यं विजने वने ।\nहंसकारण्डवाकीर्णं तत्समीपे महत्सरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001634034, "chapter_id": 21634, "verse_number": "१-२०-३५", "content_sanskrit": "पर्यन्तवनपुष्पौघच्छादितं तन्मुनीश्वर ।\nअपिबं तत्र पानीयं तत्तीरे विगतश्रमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001634035, "chapter_id": 21634, "verse_number": "१-२०-३६", "content_sanskrit": "फलानि जग्ध्वा शीर्णानि स्वयं क्षुच्च निवारिता ।\nतस्मिञ्जीर्णीलये विष्णोनर्निवासं कृतकवानहम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001634036, "chapter_id": 21634, "verse_number": "१-२०-३७", "content_sanskrit": "जीर्णस्फुटितसंधानं तस्य नित्यमकारिषम् ।\nपर्णैस्तृणैश्च काष्ठैघै र्गृहं सम्यक् प्रकल्पितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001634037, "chapter_id": 21634, "verse_number": "१-२०-३८", "content_sanskrit": "स्वसुऱार्थं तु तद्भमिर्मया लिप्ता मुनीश्वर ।\nतत्राहं व्याधवृत्तिस्थो हत्वा बहुविधान्मृगान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001634038, "chapter_id": 21634, "verse_number": "१-२०-३९", "content_sanskrit": "आजीवं वर्तय न्नित्यं वर्षाणां विंशतिः स्थितः ।\nअथेयमागता साध्वी विन्ध्यदेशसमुद्भवा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001634039, "chapter_id": 21634, "verse_number": "१-२०-४०", "content_sanskrit": "निषादकुलजा विप्रा नान्मा ख्याताऽवकोकिला ।\nबन्धुवर्गपरित्यक्ता दुःखिता जीर्णविग्रहा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001634040, "chapter_id": 21634, "verse_number": "१-२०-४१", "content_sanskrit": "क्षुत्तृड्घर्मपरिश्रान्ता शोचन्ती स्वकृतं ह्यघम् ।\nदैवयोगाकत्समायाताभ्रमन्ती विजने वने ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001634041, "chapter_id": 21634, "verse_number": "१-२०-४२", "content_sanskrit": "ग्रीष्मतापार्द्दिता बाह्ये स्वान्ते चाधिनिपूडिता ।\nइमां दुःखार्दितां दृष्ट्वा जाता मे विपुला दया ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001634042, "chapter_id": 21634, "verse_number": "१-२०-४३", "content_sanskrit": "दत्तं मया जलं चास्यै मांसं वन्यफलानि च ।\nगतश्रमात्वियं ब्रह्मन्मया पृष्टा यथा तथम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001634043, "chapter_id": 21634, "verse_number": "१-२०-४४", "content_sanskrit": "अवेदयत्स्ववृत्तान्तं तच्छृणुष्व महामुने ।\nनान्मावकोकिला चाहं निषादकुलसम्भवा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001634044, "chapter_id": 21634, "verse_number": "१-२०-४५", "content_sanskrit": "दारुकस्य सुता चाहं विन्ध्यपर्वतवासिनी ।\nपरस्वहारिणी नित्यं सदा पैशुन्यवादिनी ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001634045, "chapter_id": 21634, "verse_number": "१-२०-४६", "content_sanskrit": "पुंश्चलूत्येवमुक्त्वा तु बन्धुवर्गैः समुज्झिता ।\nकियत्कालं ततः पत्या भृताहं लोकनिन्दिता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001634046, "chapter_id": 21634, "verse_number": "१-२०-४७", "content_sanskrit": "दैवात्सोऽपि गतो लोकं यमस्यात्र विहाय माम् ।\nकान्तारे विजने चैका भ्रमन्ती दुःखपीडिता ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001634047, "chapter_id": 21634, "verse_number": "१-२०-४८", "content_sanskrit": "दैवात्त्वत्सविधं प्राप्ता जीविताहं त्वयाधुना ।\nइत्येवं स्वकृतं कर्म मह्यं सर्वं न्यवेदयत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001634048, "chapter_id": 21634, "verse_number": "१-२०-४९", "content_sanskrit": "ततो देवालये तस्मिन्दम्‌पतीभावमाश्रितौ ।\nस्थितौ वर्षाणि दश च आवां मांसफलाशिनौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001634049, "chapter_id": 21634, "verse_number": "१-२०-५०", "content_sanskrit": "एकदा मद्यपानेन प्रमत्तौ निर्भरैमुने ।\nतत्र देवालये रात्रौ मुदितौ मांसभोजनात् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001634050, "chapter_id": 21634, "verse_number": "१-२०-५१", "content_sanskrit": "तनुवस्त्रापरिज्ञानौ नृत्यं चकृव मोहितौ ।\nप्रारब्धकर्म भोगान्तमावां युगपदागतौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001634051, "chapter_id": 21634, "verse_number": "१-२०-५२", "content_sanskrit": "यमदूतास्तदायाताः पाशहस्ता भयंकराः ।\nनेतुमावां नृत्यरतौ सुधोरां यमयातनाम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001634052, "chapter_id": 21634, "verse_number": "१-२०-५३", "content_sanskrit": "ततः प्रसन्नो भगवान्कर्मणा मम मानद ।\nदेवावसथसंस्कारसंज्ञितेन कृतेन नः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001634053, "chapter_id": 21634, "verse_number": "१-२०-५४", "content_sanskrit": "स्वदूतान्प्रेषयामास स्वभक्तावनतत्परः ।\nते दूता देवदेवस्य शङ्खचक्र गदाधराः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001634054, "chapter_id": 21634, "verse_number": "१-२०-५५", "content_sanskrit": "सहस्रसूर्यासंकाशाः सर्वे चारुचतुर्भुजाः ।\nकिरीटकुण्डलधरा हारिणो वनमालिनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001634055, "chapter_id": 21634, "verse_number": "१-२०-५६", "content_sanskrit": "दिशो वितिमिरा विप्र कुर्वन्तः स्वेन तेजसा ।\nभयंकरान्याशहस्तान्दंष्ट्रिणो यमकिङ्करान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001634056, "chapter_id": 21634, "verse_number": "१-२०-५७", "content_sanskrit": "आवयोग्राहणे यत्तानृचुः कृष्णपरायणाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001634057, "chapter_id": 21634, "verse_number": "१-२०-५८", "content_sanskrit": "विष्णुदूता ऊचुः ।\nभो भो क्रूरा दूराचारा विवेकपरिवर्जिताः ।\nमुञ्चध्वमेतौ निष्पापौ दम्पती हरिवल्लभौ ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001634058, "chapter_id": 21634, "verse_number": "१-२०-५९", "content_sanskrit": "विवेकस्त्रिषु लोकेषु संपदामादिकारणम् ।\nअपापे पापधीर्यस्तु तं विद्यात्पुरुषाधमम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001634059, "chapter_id": 21634, "verse_number": "१-२०-६०", "content_sanskrit": "पापे त्वपापधीर्यस्तु तं विद्यादधमाधमम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001634060, "chapter_id": 21634, "verse_number": "१-२०-६१", "content_sanskrit": "यमदूता ऊचुः ।\nयुष्माभिः सत्यमेवोक्तं किं त्वेतौ पापिसत्तमौ ।\nयमेन पापिनो दण्ड्यास्तन्नेष्यामो वयं त्विमौ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001634061, "chapter_id": 21634, "verse_number": "१-२०-६२", "content_sanskrit": "श्रुतिप्रणिहितो धर्मो ह्यधर्मस्तद्विपर्ययः ।\nधर्माधर्मविवेकोऽयं तन्नेष्यामो यमान्तिकम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001634062, "chapter_id": 21634, "verse_number": "१-२०-६३", "content_sanskrit": "एतच्त्छुवातिकुपिता विष्णुदूता महौजसः ।\nप्रत्यूचूस्तान्यमभटानधर्मे धर्ममानिनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001634063, "chapter_id": 21634, "verse_number": "१-२०-६४", "content_sanskrit": "विष्णदूता ऊचुः ।\nअहो कष्टं धर्मदृशामधर्मः स्पृशते सभाम् ।\nसम्यग्विवेकशून्यानां निदानं ह्यापदां महत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001634064, "chapter_id": 21634, "verse_number": "१-२०-६५", "content_sanskrit": "तर्काणाद्यविशेषेण नरकाध्यक्षतां गताः ।\nयूयं किमर्थमद्यापि कर्त्तुं पापानि सोद्यमाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001634065, "chapter_id": 21634, "verse_number": "१-२०-६६", "content_sanskrit": "स्वकर्मक्षयपर्यन्तं महापातकिनोऽपि च ।\nतिष्टन्ति नरके घोरे यावच्चन्द्रार्कतारकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001634066, "chapter_id": 21634, "verse_number": "१-२०-६७", "content_sanskrit": "पूर्वसंचितपापानामदृष्ट्वा निष्कृतिं वृथा ।\nकिमर्थं पापकर्माणि करिष्येऽथ पुनः पुनः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001634067, "chapter_id": 21634, "verse_number": "१-२०-६८", "content_sanskrit": "श्रुतिप्रणिहितो धर्मः सत्यं सत्यं न संशयः ।\nकिन्त्वाभ्यां चरितान्धर्मान्प्रवक्ष्यामो यथातथम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001634068, "chapter_id": 21634, "verse_number": "१-२०-६९", "content_sanskrit": "एतौ पापविनिर्मुक्तौ हरिशुश्रूषणे रतौ ।\nहरिणात्रायमाणौ च मुञ्चध्वमविलम्बितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001634069, "chapter_id": 21634, "verse_number": "१-२०-७०", "content_sanskrit": "एषा च नर्तनं चक्रे तथैव ध्वजरोषणम् ।\nअन्तकाले विष्णुगृहे तेन निष्पापतां गतौ ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001634070, "chapter_id": 21634, "verse_number": "१-२०-७१", "content_sanskrit": "अन्तकाले तु यन्नाम श्रुत्वोक्त्वापि च वै सकृत् ।\nलभते परमं स्थानं किमु शूश्रूषणे रताः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001634071, "chapter_id": 21634, "verse_number": "१-२०-७२", "content_sanskrit": "महापातकयुक्तो वा युक्तो वाप्युपपातकैः ।.  ।\nकृष्णसेवी नरोऽन्तेऽपि लभते परमां गतिम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001634072, "chapter_id": 21634, "verse_number": "१-२०-७३", "content_sanskrit": "यतीनां विष्णुभक्तानां परिचर्या परायणाः ।\nते दूताः सहसा यान्ति पापिनोऽपि परां गतिम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001634073, "chapter_id": 21634, "verse_number": "१-२०-७४", "content_sanskrit": "मुहुर्तं वा मुहुर्तार्द्धं यस्तिष्टोद्धरिमन्दिरे ।\nसोऽपि याति परं स्थानं किमुद्वात्रघिंशवत्सरान् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001634074, "chapter_id": 21634, "verse_number": "१-२०-७५", "content_sanskrit": "उपलेपनकर्त्तारौ संमार्जनपरायणौ ।\nएतौ हरिगृहे नित्यं जीर्णशीर्णाधिरोपकौ ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001634075, "chapter_id": 21634, "verse_number": "१-२०-७६", "content_sanskrit": "जलसेचनकर्त्तारौ दीपदौ हरिमन्दिरे ।\nकथमेतौ महाभागौ यातनाभोगमर्हथ ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001634076, "chapter_id": 21634, "verse_number": "१-२०-७७", "content_sanskrit": "इत्युक्ता विष्णुदूतास्ते च्छित्वा पाशांस्तदैव हि ।\nआरोप्यावां विमानाग्रयं ययुर्विष्णोः परं पदम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001634077, "chapter_id": 21634, "verse_number": "१-२०-७८", "content_sanskrit": "तत्र सामीप्यमापन्नौ देवदेवस्य चक्रिणः ।\nदिव्यान्भोगान्भुक्तवन्तौ तावत्कालं मुनीश्वर ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001634078, "chapter_id": 21634, "verse_number": "१-२०-७९", "content_sanskrit": "दिव्यान्भोगांस्तु तत्रापि भुक्त्वा यातौ महीमिमाम् ।\nअत्रापि संपदतुला हरिसेवाप्रसादतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001634079, "chapter_id": 21634, "verse_number": "१-२०-८०", "content_sanskrit": "अनिच्छया कृतेनापि सेवनेन हरेर्मुने ।\nप्राप्तमीदृक् फलं विप्र देवानामपि दुर्लभम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001634080, "chapter_id": 21634, "verse_number": "१-२०-८१", "content_sanskrit": "इच्छयाराध्य विश्वेशं भक्तिभावेन माधवम् ।\nप्राप्स्यावः परमं श्रेय इति हेतुर्निरुपितः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001634081, "chapter_id": 21634, "verse_number": "१-२०-८२", "content_sanskrit": "अवशेनापि यत्कर्म कृतं स्यात्सुमहत्फलम् ।\nजायते भूमिदेवेन्द्र किं पुनः श्रद्धया कृतम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001634082, "chapter_id": 21634, "verse_number": "१-२०-८३", "content_sanskrit": "एतदुक्तं निशम्यासौ स मुनीन्द्रो विभण्डकः ।\nप्रशस्य दम्पती तौ तु प्रययौ स्वतपोवनम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001634083, "chapter_id": 21634, "verse_number": "१-२०-८४", "content_sanskrit": "तस्माज्जानीहि देवर्षे देवदेवस्य चक्रिणः ।\nपरिचर्या तु सर्वेषां कामधेनूपमा स्मृता ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001634084, "chapter_id": 21634, "verse_number": "१-२०-८५", "content_sanskrit": "हरिपूजापराणां तु हरिरेव सनातनः ।\nददाति परमं श्रेयः सर्वकामफलमप्रदः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001634085, "chapter_id": 21634, "verse_number": "१-२०-८६", "content_sanskrit": "य इदं पुण्यमाख्यानं सर्वपापप्रणाशनम् ।\nपठेच्च श्रृणुयाद्वापि सोऽपि याति परां रातिम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]