[{"id": 2129878, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129879, "chapter_id": 3798, "verse_number": "१", "content_sanskrit": "द्रष्टारः पर्वताः सर्वे नद्यः सपुरकाननाः ।\nतीर्थानि चैव श्रीमन्ति स्पृष्टं च सलिलं करैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129880, "chapter_id": 3798, "verse_number": "२", "content_sanskrit": "पर्वतं मन्दरं दिव्यमेष पन्थाः प्रयास्यति ।\nसमाहिता निरुद्विग्नाः सर्वे भवत पाण्डवाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129881, "chapter_id": 3798, "verse_number": "३", "content_sanskrit": "अयं देवनिवासो वै गन्तव्यो वो भविष्यति ।\nऋषीणां चैव दिव्यानां निवासः पुण्यकर्मणाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129882, "chapter_id": 3798, "verse_number": "४", "content_sanskrit": "एषा शिवजला पुण्या याति सौम्य महानदी ।\nबदरीप्रभवा राजन् देवर्षिगणसेविता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129883, "chapter_id": 3798, "verse_number": "५", "content_sanskrit": "एषा वैहायसैर्नित्यं बालखिल्यैर्महात्मभिः ।\nअर्चिता चोपयाता च गन्धर्वैश्च महात्मभिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129884, "chapter_id": 3798, "verse_number": "६", "content_sanskrit": "अत्र साम स्म गायन्ति सामगाः पुण्यनिस्वनाः ।\nमरीचिः पुलहश्चैव भृगुश्चैवाङ्गिरास्तथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129885, "chapter_id": 3798, "verse_number": "७", "content_sanskrit": "अत्राह्निकं सुरश्रेष्ठो जपते समरुद्गणः ।\nसाध्याश्चैवाश्विनौ चैव परिधावन्ति तं तदा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129886, "chapter_id": 3798, "verse_number": "८", "content_sanskrit": "चन्द्रमाः सह सूर्येण ज्योतींषि च ग्रहैः सह ।\nअहोरात्रविभागेन नदीमेनामनुव्रजन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129887, "chapter_id": 3798, "verse_number": "९", "content_sanskrit": "एतस्याः सलिलं मूर्ध्ना(र्ध्नि) वृषाङ्कः पर्यधारयत् ।\nगङ्गाद्वारे महाभाग येन लोकस्थितिर्भवेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129888, "chapter_id": 3798, "verse_number": "१०", "content_sanskrit": "एतां भगवतीं देवीं भवन्तः सर्व एव हि ।\nप्रयतेनात्मना तात प्रतिगम्याभिवादत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129889, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129890, "chapter_id": 3798, "verse_number": "११", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा लोमशस्य महात्मनः ।\nआकाशगङ्गां प्रयताः पाण्डवास्तेऽभ्यवादयन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129891, "chapter_id": 3798, "verse_number": "१२", "content_sanskrit": "अभिवाद्य च ते सर्वे पाण्डवा धर्मचारिणः ।\nपुनः प्रयाताः संहृष्टाः सर्वैर्ऋषिगणैः सह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129892, "chapter_id": 3798, "verse_number": "१३", "content_sanskrit": "ततो दूरात् प्रकाशन्तं पाण्डरं मेरुसन्निभम् ।\nददृशुस्ते नरश्रेष्ठा विकीर्णं सर्वतोदिशम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129893, "chapter_id": 3798, "verse_number": "१४", "content_sanskrit": "तान् प्रष्टुकामान् विज्ञाय पाण्डवान् स तु लोमशः ।\nउवाच वाक्यं वाक्यज्ञः शृणुध्वं पाण्डुनन्दनाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129894, "chapter_id": 3798, "verse_number": "१५", "content_sanskrit": "एतद् विकीर्णं सुश्रीमत् कैलासशिखरोपमम् ।\nयत् पश्यसि नरश्रेष्ठ पर्वतप्रतिमं स्थितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129895, "chapter_id": 3798, "verse_number": "१६", "content_sanskrit": "एतान्यस्थीनि दैत्यस्य नरकस्य महात्मनः ।\nपर्वतप्रतिमं भाति पर्वतप्रस्तराश्रितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129896, "chapter_id": 3798, "verse_number": "१७", "content_sanskrit": "पुरातनेन देवेन विष्णुना परमात्मना ।\nदैत्यो विनिहतस्तेन सुरराजहितैषिणा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129897, "chapter_id": 3798, "verse_number": "१८", "content_sanskrit": "दशवर्षसहस्राणि तपस्तप्यन् महामनाः ।\nऐन्द्रं प्रार्थयते स्थानं तपःस्वाध्यायविक्रमात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129898, "chapter_id": 3798, "verse_number": "१९", "content_sanskrit": "तपोबलेन महता बाहुवेगबलेन च ।\nनित्यमेव दुराधर्षो धर्षयन् स दितेः सुतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129899, "chapter_id": 3798, "verse_number": "२०", "content_sanskrit": "स तु तस्य बलं ज्ञात्वा धर्मे च चरितव्रतम् ।\nभयाभिभूतः संविग्नः शक्र आसीत् तदानघ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129900, "chapter_id": 3798, "verse_number": "२१", "content_sanskrit": "तेन सञ्चिन्तितो देवो मनसा विष्णुरव्ययः ।\nसर्वत्रगः प्रभुः श्रीमानागतश्च स्थितो बभौ ।\nऋषयश्चापि तं सर्वे तुष्टुवुश्च दिवौकसः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129901, "chapter_id": 3798, "verse_number": "२२", "content_sanskrit": "तं दृष्ट्वा ज्वलमानश्रीर्भगवान् हव्यवाहनः ।\nनष्टतेजाः समभवत् तस्य तेजोऽभिभर्त्सितः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129902, "chapter_id": 3798, "verse_number": "२३", "content_sanskrit": "तं दृष्ट्वा वरदं देवं विष्णुं देवगणेश्वरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129903, "chapter_id": 3798, "verse_number": "२४", "content_sanskrit": "प्राञ्जलिः प्रणतो भूत्वा नमस्कृत्य च वज्रभृत् ।\nप्राह वाक्यं ततस्तत्त्वं यतस्तस्य भयं भवेत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129904, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "विष्णुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129905, "chapter_id": 3798, "verse_number": "२५", "content_sanskrit": "जानामि ते भयं शक्र दैत्येन्द्रान्नरकात् ततः ।\nऐन्द्रं प्रार्थयते स्थानं तपःसिद्धेन कर्मणा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129906, "chapter_id": 3798, "verse_number": "२६", "content_sanskrit": "सोऽहमेनं तव प्रीत्या तपःसिद्धमपि ध्रुवम् ।\nवियुनज्मि देहाद् देवेन्द्र मुहूर्तं प्रतिपालय\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129907, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129908, "chapter_id": 3798, "verse_number": "२७", "content_sanskrit": "तस्य विष्णुर्महातेजाः पाणिना चेतनां हरत् ।\nस पपात ततो भूमौ गिरिराज इवाहतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129909, "chapter_id": 3798, "verse_number": "२८", "content_sanskrit": "तस्यैतदस्थिसङ्घातं मायाविनिहतस्य वै ।\nइदं द्वितीयमपरं विष्णोः कर्म प्रकाशते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2129910, "chapter_id": 3798, "verse_number": "२९", "content_sanskrit": "नष्टा वसुमती कृत्स्ना पाताळे चैव मज्जिता ।\nपुनरुद्धरिता तेन वाराहेणैकशृङ्गिणा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2129911, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2129912, "chapter_id": 3798, "verse_number": "३०", "content_sanskrit": "भगवन् विस्तरेणेमां कथां कथय तत्त्वतः ।\nकथं तेन सुरेशेन नष्टा वसुमती तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2129913, "chapter_id": 3798, "verse_number": "३१", "content_sanskrit": "योजनानां शतं ब्रह्मन् पुनरुद्धरिता तदा ।\nकेन चैव प्रकारेण जगतो धरणी ध्रुवा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2129914, "chapter_id": 3798, "verse_number": "३२", "content_sanskrit": "शिवा देवी महाभागा सर्वसस्यप्ररोहिणी ।\nकस्य चैव प्रभावाद्धि योजनानां शतं गता\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2129915, "chapter_id": 3798, "verse_number": "३३", "content_sanskrit": "केन तद्वीर्यसर्वस्वं दर्शितं परमात्मनः ।\nएतत्सर्वं यथातत्त्वमिच्छामि द्विजसत्तम ।\nश्रोतुं विस्तरशः सर्वं त्वं हि तस्य प्रतिश्रयः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2129916, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2129917, "chapter_id": 3798, "verse_number": "३४", "content_sanskrit": "यत् तेऽहं परिपृष्टोऽस्मि कथामेतां युधिष्ठिर ।\nतत्सर्वमखिलेनेह श्रूयतां मम भाषतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2129918, "chapter_id": 3798, "verse_number": "३५", "content_sanskrit": "पुरा कृतयुगे तात वर्तमानेऽभयङ्करे ।\nयमत्वं कारयामास आदिदेवः पुरातनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2129919, "chapter_id": 3798, "verse_number": "३६", "content_sanskrit": "यमत्वं कुर्वतस्तस्य देवदेवस्य धीमतः ।\nन तत्र म्रियते कश्चिज्जायते वा तथान्युत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2129920, "chapter_id": 3798, "verse_number": "३७", "content_sanskrit": "वर्धन्ते पक्षिसङ्घाश्च तथा पशुगवेडकम् ।\nगवाश्वं च मृगाश्चैव सर्वे ते पिशिताशनाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2129921, "chapter_id": 3798, "verse_number": "३८", "content_sanskrit": "तथा पुरुषशार्दूल मानुषाश्च परन्तप ।\nसहस्रशो ह्ययुतशो वर्धन्ते सलिलं यथा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2129922, "chapter_id": 3798, "verse_number": "३९", "content_sanskrit": "एतस्मिन् सङ्कुले तात वर्तमाने भयङ्करे ।\nअतिभाराद् वसुमती योजनानां शतं गता\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2129923, "chapter_id": 3798, "verse_number": "४०", "content_sanskrit": "सा वै व्यथितसर्वाङ्गी भारेणाक्रान्तचेतना ।\nनारायणं वरं देवं प्रपन्ना शरणं गता\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2129924, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "पृथिवी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2129925, "chapter_id": 3798, "verse_number": "४१", "content_sanskrit": "भगवंस्त्वत्प्रसादाद्धि तिष्ठेयं सुचिरं त्विह ।\nभारेणास्मि समाक्रान्ता न शक्नोमि स्म वर्तितुम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2129926, "chapter_id": 3798, "verse_number": "४२", "content_sanskrit": "ममेमं भगवन् भारं व्यपनेतुं त्वमर्हसि ।\nशरणागतास्मि ते देव प्रसादं कुरु मे विभो\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2129927, "chapter_id": 3798, "verse_number": "४३", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा भगवानक्षरः प्रभुः ।\nप्रोवाच वचनं हृष्टः श्रव्याक्षरसमीरितम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2129928, "chapter_id": 3798, "verse_number": "४४", "content_sanskrit": "न ते महि भयं कार्यं भारार्ते वसुधारिणि ।\nअहमेवं तथा कुर्मि यथा लघ्वी भविष्यसि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2129929, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2129930, "chapter_id": 3798, "verse_number": "४५", "content_sanskrit": "स तां विसर्जयित्वा तु वसुधां शैलकुण्डलाम् ।\nततो वराहः संवृत्त एकशृङ्गो महाद्युतिः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2129931, "chapter_id": 3798, "verse_number": "४६", "content_sanskrit": "रक्ताभ्यां नयनाभ्यां तु भयमुत्पादयन्निव ।\nधूमं च ज्वलयँल्लक्ष्म्या तत्र देशे व्यवर्धत\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2129932, "chapter_id": 3798, "verse_number": "४७", "content_sanskrit": "स गृहीत्वा वसुमतीं शृङ्गेणेकेन भास्वता ।\nयोजनानां शतं वीर समुद्धरति सोऽक्षरः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2129933, "chapter_id": 3798, "verse_number": "४८", "content_sanskrit": "तस्यां चोद्धार्यमाणायां सङ्क्षोभः समजायत ।\nदेवाः सङ्क्षुभिताः सर्वे ऋषयश्च तपोधनाः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2129934, "chapter_id": 3798, "verse_number": "४९", "content_sanskrit": "हाहाभूतमभूत् सर्वं त्रिदिवं व्योम भूस्तथा ।\nन पर्य वस्थितः कश्चिद् देवो वा मानुषोऽपि वा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2129935, "chapter_id": 3798, "verse_number": "५०", "content_sanskrit": "ततो ब्रह्माणमासीनं ज्वलमानमिव श्रिया ।\nदेवाः सर्षिगणाश्चैव उपतस्थुरनेकशः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2129936, "chapter_id": 3798, "verse_number": "५१", "content_sanskrit": "उपसर्प्य च देवेशं ब्रह्माणं लोकसाक्षिकम् ।\nभूत्वा प्राञ्जलयः सर्वे वाक्यमुच्चारयंस्तदा\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2129937, "chapter_id": 3798, "verse_number": "५२", "content_sanskrit": "लोकाः सङ्क्षुभिताः सर्वे व्याकुलं च चराचरम् ।\nसमुद्राणां च सङ्क्षोभस्त्रिदशेश प्रकाशते\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2129938, "chapter_id": 3798, "verse_number": "५३", "content_sanskrit": "सैषा वसुमती कृत्स्ना योजनानां शतं गता ।\nकिमेतद् किं प्रभावेण येनेदं व्याकुलं जगत् ।\nआख्यातु नो भवान् शीघ्रं विसञ्ज्ञाः स्मेह सर्वशः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2129939, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2129940, "chapter_id": 3798, "verse_number": "५४", "content_sanskrit": "असुरेभ्यो भयं नास्ति युष्माकं कुत्रचित् क्वचित् ।\nश्रूयतां यत्कृते त्वेष सङ्क्षोभो जायतेऽमराः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2129941, "chapter_id": 3798, "verse_number": "५५", "content_sanskrit": "योऽसौ सर्वत्रगः श्रीमानक्षरात्मा व्यवस्थितः ।\nतस्य प्रभावात् सङ्क्षोभस्त्रिदिवस्य प्रकाशते\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2129942, "chapter_id": 3798, "verse_number": "५६", "content_sanskrit": "यैषा वसुमती कृत्स्ना योजनानां शतं गता ।\nसमुद्धृता पुनस्तेन विष्णुना परमात्मना\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2129943, "chapter_id": 3798, "verse_number": "५७", "content_sanskrit": "तस्यामुद्धार्यमाणायां सङ्क्षोभः समजायत ।\nएवं भवन्तो जानन्तु छिद्यतां संशयश्च वः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2129944, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2129945, "chapter_id": 3798, "verse_number": "५८", "content_sanskrit": "क्व तद्भूतं वसुमतीं समुद्धरति हृष्टवत् ।\nतं देशं भगवन् ब्रूहि तत्र यास्यामहे वयम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2129946, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2129947, "chapter_id": 3798, "verse_number": "५९", "content_sanskrit": "हन्त गच्छत भद्रं वो नन्दने पश्यत स्थितम् ।\nएषोऽत्र भगवान् श्रीमान् सुपर्णः सम्प्रकाशते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2129948, "chapter_id": 3798, "verse_number": "६०", "content_sanskrit": "वाराहेणैव रूपेण भगवाँल्लोकभावनः ।\nकालानल इवाभाति पृथिवीतळमुद्धरन्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2129949, "chapter_id": 3798, "verse_number": "६१", "content_sanskrit": "एतस्योरसि सुव्यक्तं श्रीवत्समभिराजते ।\nपश्यध्वं विबुधाः सर्वे भूतमेतदनामयम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2129950, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2129951, "chapter_id": 3798, "verse_number": "६२", "content_sanskrit": "ततो दृष्ट्वा महात्मानं श्रुत्वा चामन्त्र्य चामराः ।\nपितामहं पुरस्कृत्य जग्मुर्देवा यथागतम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2129952, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2129953, "chapter_id": 3798, "verse_number": "६३", "content_sanskrit": "श्रुत्वा तु तां कथां सर्वे पाण्डवा जनमेजय ।\nलोमशादेशितेनाशु पथा जग्मुः प्रहृष्टवत् \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2129954, "chapter_id": 3798, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकोनचत्वारिंशदधिकशततमोऽध्यायः ॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2129955, "chapter_id": 3798, "verse_number": "", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि पञ्चनवतितमोऽध्यायः ॥९५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]