[{"id": 7006352000, "chapter_id": 26352, "verse_number": "२-८-१", "content_sanskrit": "वैशम्पायन उवाच\nएवं तौ बाल्यमुत्तीर्णौ कृष्णसंकर्षणावुभौ ।\nतस्मिन्नेव व्रजस्थाने सप्तवर्षौ बभूवतुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006352001, "chapter_id": 26352, "verse_number": "२-८-२", "content_sanskrit": "नीलपीताम्बरधरौ पीतश्वेतानुलेपनौ ।\nबभूवतुर्वत्सपालौ काकपक्षधरावुभौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006352002, "chapter_id": 26352, "verse_number": "२-८-३", "content_sanskrit": "पर्णवाद्यं श्रुतिसुखं वादयन्तौ वराननौ ।\nशुशुभाते वनगतौ त्रिशीर्षाविव पन्नगौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006352003, "chapter_id": 26352, "verse_number": "२-८-४", "content_sanskrit": "मयूराङ्गदकर्णौ तु पल्लवापीडधारिणौ ।\nवनमालाकुलोरस्कौ द्रुमपोताविवोद्गतौ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006352004, "chapter_id": 26352, "verse_number": "२-८-५", "content_sanskrit": "अरविन्दकृतापीडौ रज्जुयज्ञोपवीतिनौ ।\nसशिक्यतुम्बकरकौ गोपवेणुप्रवादकौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006352005, "chapter_id": 26352, "verse_number": "२-८-६", "content_sanskrit": "क्वचिद्धसन्तावन्योन्यं क्रीडमानौ क्वचित्क्वचित् ।\nपर्णशय्यासु संसुप्तौ क्वचिन्निद्रान्तरेक्षणौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006352006, "chapter_id": 26352, "verse_number": "२-८-७", "content_sanskrit": "एवं वत्सान् पालयन्तौ शोभयन्तौ महावनम् ।\nचञ्चूर्यन्तौ रमन्तौ स्म किशोराविव चञ्चलौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006352007, "chapter_id": 26352, "verse_number": "२-८-८", "content_sanskrit": "अथ दामोदरः श्रीमान् संकर्षणमुवाच ह ।\nआर्य नास्मिन् वने शक्यं गोपालैः सह क्रीडितुम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006352008, "chapter_id": 26352, "verse_number": "२-८-९", "content_sanskrit": "अवगीतमिदं सर्वमावाभ्यां भुक्तकाननम् ।\nप्रक्षीणतृणकाष्ठं च गोपैर्मथितपादपम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006352009, "chapter_id": 26352, "verse_number": "२-८-१०", "content_sanskrit": "घनीभूतानि यान्यासन् काननानि वनानि च ।\nतान्याकाशनिकाशानि दृश्यन्तेऽद्य यथाऽसुखम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006352010, "chapter_id": 26352, "verse_number": "२-८-११", "content_sanskrit": "गोवाटेष्वपि ये वृक्षाः परिवृत्तार्गलेषु च ।\nसर्वे गोष्ठाग्निषु गताः क्षयमक्षयवर्चसः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006352011, "chapter_id": 26352, "verse_number": "२-८-१२", "content_sanskrit": "संनिकृष्टानि यान्यासन्काष्ठानि च तृणानि च ।\nतानि दूरावकृष्टासु मार्गितव्यानि भूमिषु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006352012, "chapter_id": 26352, "verse_number": "२-८-१३", "content_sanskrit": "अरण्यमिदमल्पोदमल्पकक्षं निराश्रयम् ।\nअन्वेषितव्यविश्रामं दारुणं विरलद्रुमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006352013, "chapter_id": 26352, "verse_number": "२-८-१४", "content_sanskrit": "अकर्मण्येषु वृक्षेषु स्थितविप्रस्थितद्विजम् ।\nसंवासस्यास्य महतो जनेनोत्सादितद्रुमम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006352014, "chapter_id": 26352, "verse_number": "२-८-१५", "content_sanskrit": "निरानन्दं निरास्वादं निष्प्रयोजनमारुतम् ।\nनिर्विहङ्गमिदं शून्यं निर्व्यञ्जनमिवाशनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006352015, "chapter_id": 26352, "verse_number": "२-८-१६", "content_sanskrit": "विक्रीयमाणैः काष्ठैश्च शाकैश्च वनसम्भवैः ।\nउच्छिन्नसंचयतृणैर्घोषोऽयं नगरायते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006352016, "chapter_id": 26352, "verse_number": "२-८-१७", "content_sanskrit": "शैलानां भूषणं घोषो घोषाणां भूषणं वनम् ।\nवनानां भूषणं गावस्ताश्चास्माकं परा गतिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006352017, "chapter_id": 26352, "verse_number": "२-८-१८", "content_sanskrit": "तस्मादन्यद् वनं यामः प्रत्यग्रयवसेन्धनम् ।\nइच्छन्त्यनुपभुक्तानि गावो भोक्तुं तृणानि च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006352018, "chapter_id": 26352, "verse_number": "२-८-१९", "content_sanskrit": "तस्माद् वनं नवतृणं गच्छन्तु धनिनो व्रजाः ।\nन द्वारबन्धावरणा न गृहक्षेत्रिणस्तथा ।\nप्रशस्ता वै व्रजा लोके यथा वै चक्रचारिणः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006352019, "chapter_id": 26352, "verse_number": "२-८-२०", "content_sanskrit": "शकृन्मूत्रेषु तेष्वेव जातक्षाररसायनम् ।\nन तृणं भुञ्जते गावो नापि तत् पयसे हितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006352020, "chapter_id": 26352, "verse_number": "२-८-२१", "content_sanskrit": "स्थलीप्रायासु रथ्यासु नवासु वनराजिषु ।\nचरावः सहितौ गोभिः क्षिप्रं संवाह्यतां व्रजः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006352021, "chapter_id": 26352, "verse_number": "२-८-२२", "content_sanskrit": "श्रूयते हि वनं रम्यं पर्याप्ततृणसंस्तरम् ।\nनाम्ना वृन्दावनं नाम स्वादुवृक्षफलोदकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006352022, "chapter_id": 26352, "verse_number": "२-८-२३", "content_sanskrit": "अझिल्लिकण्टकवनं सर्वैर्वनगुणैर्युतम् ।\nकदम्बपादपप्रायं यमुनातीरसंश्रितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006352023, "chapter_id": 26352, "verse_number": "२-८-२४", "content_sanskrit": "स्निग्धशीतानिलवनं सर्वर्तुनिलयं शुभम् ।\nगोपीनां सुखसंचारं चारुचित्रवनान्तरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006352024, "chapter_id": 26352, "verse_number": "२-८-२५", "content_sanskrit": "तत्र गोवर्धनो नाम नातिदूरे गिरिर्महान् ।\nभ्राजते दीर्घशिखरो नन्दनस्येव मन्दरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006352025, "chapter_id": 26352, "verse_number": "२-८-२६", "content_sanskrit": "मध्ये चास्य महाशाखो न्यग्रोधो योजनोच्छ्रितः ।\nभाण्डीरो नाम शुशुभे नीलमेघ इवाम्बरे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006352026, "chapter_id": 26352, "verse_number": "२-८-२७", "content_sanskrit": "मध्येन चास्य कालिन्दी सीमन्तमिव कुर्वती ।\nप्रयाता नन्दनस्येव नलिनी सरितां वरा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006352027, "chapter_id": 26352, "verse_number": "२-८-२८", "content_sanskrit": "तत्र गोवर्धनं चैव भाण्डीरं च वनस्पतिम् ।\nकालिन्दीं च नदीं रम्यां द्रक्ष्यावश्चरतः सुखम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006352028, "chapter_id": 26352, "verse_number": "२-८-२९", "content_sanskrit": "तत्रायं कल्प्यतां घोषस्त्यज्यतां निर्गुणं वनम् ।\nसंत्रासयावो भद्रं ते किञ्चिदुत्पाद्य कारणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006352029, "chapter_id": 26352, "verse_number": "२-८-३०", "content_sanskrit": "एवं कथयतस्तस्य वासुदेवस्य धीमतः ।\nप्रादुर्बभूवुः शतशो रक्तमांसवसाशनाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006352030, "chapter_id": 26352, "verse_number": "२-८-३१", "content_sanskrit": "घोराश्चिन्तयतस्तस्य स्वतनूरुहजास्तदा ।\nविनिष्पेतुर्भयकराः सर्वशः शतशो वृकाः ॥ ३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006352031, "chapter_id": 26352, "verse_number": "२-८-३२", "content_sanskrit": "निष्पतन्ति स्म बहवो व्रजस्योत्सादनाय वै ।\nवृकान् निष्पतितान्दृष्ट्वा गोषु वत्सेष्वथो नृषु ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006352032, "chapter_id": 26352, "verse_number": "२-८-३३", "content_sanskrit": "गोपीषु च यथाकामं व्रजे त्रासोऽभवन्महान् ।\nते वृकाः पञ्चबद्धाश्च दशबद्धास्तथा परे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006352033, "chapter_id": 26352, "verse_number": "२-८-३४", "content_sanskrit": "त्रिंशद्विंशतिबद्धाश्च शतबद्धास्तथा परे ।\nनिश्चेरुस्तस्य गात्रेभ्यः श्रीवत्सकृतलक्षणाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006352034, "chapter_id": 26352, "verse_number": "२-८-३५", "content_sanskrit": "कृष्णस्य कृष्णवदना गोपानां भयवर्धनाः ।\nभक्षयद्भिश्च तैर्वत्सांस्त्रासयद्भिश्च गोव्रजान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006352035, "chapter_id": 26352, "verse_number": "२-८-३६", "content_sanskrit": "निशि बालान् हरद्भिश्च वृकैरुत्साद्यते व्रजः ।\nन वने शक्यते गन्तुं न गाश्च परिरक्षितुम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006352036, "chapter_id": 26352, "verse_number": "२-८-३७", "content_sanskrit": "न वनात्किंचिदाहर्तुं न च वा तरितुं नदीम् ।\nत्रस्ता ह्युद्विग्नमनसोऽगतास्तस्मिन्वनेऽवसन् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006352037, "chapter_id": 26352, "verse_number": "२-८-३८", "content_sanskrit": "एवं वृकैरुदीर्णैस्तु व्याघ्रतुल्यपराक्रमैः ।\nव्रजो निष्पन्दचेष्टः स एकस्थानचरः कृतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]