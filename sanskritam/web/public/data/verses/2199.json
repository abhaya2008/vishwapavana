[{"id": 2054715, "chapter_id": 2199, "verse_number": "७-१२६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054716, "chapter_id": 2199, "verse_number": "७-१२६-१", "content_sanskrit": "व्यूहेष्वालोड्यमानेषु पाण्डवानां ततस्ततः।\nसुदूरमन्वयुः पार्थाः पाञ्चालाः सह सोमकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054717, "chapter_id": 2199, "verse_number": "७-१२६-२", "content_sanskrit": "वर्तमाने तथा रौद्रे सङ्ग्रामे रोमहर्षणे।\nसङ्क्षये जगतस्तीव्रे युगान्त इव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054718, "chapter_id": 2199, "verse_number": "७-१२६-३", "content_sanskrit": "द्रोणे युधि पराक्रान्ते नर्दमाने मुहुर्मुहुः।\nपाञ्चालेषु च क्षीणेषु वध्यमानेषु पाण्डुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054719, "chapter_id": 2199, "verse_number": "७-१२६-४", "content_sanskrit": "नापश्यच्छरणं कञ्चिद्वर्मराजो युधिष्ठिरः।\nचिन्तयामास राजेन्द्र कथमेतद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054720, "chapter_id": 2199, "verse_number": "७-१२६-५", "content_sanskrit": "ततो विक्ष्य दिशः सर्वाः सव्यसाचिदिदृक्षया।\nयुधिष्ठिरो ददर्शाथ नैव पार्थं न माधवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054721, "chapter_id": 2199, "verse_number": "७-१२६-६", "content_sanskrit": "सोऽपश्यन्नरशार्दूलं वानरर्षभलक्षणम्।\nगाण़्डीवस्य च निर्घोषमशृण्वन्व्यथितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054722, "chapter_id": 2199, "verse_number": "७-१२६-७", "content_sanskrit": "अपश्यन्सात्यकिं चापि वृष्णीनां प्रवरं रथम्।\nचिन्तयाभिपरीताङ्गो धर्मराजो युधिष्ठिरः।\nनाध्यगच्छत्तदा शान्ति तावपश्यन्नरोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054723, "chapter_id": 2199, "verse_number": "७-१२६-८", "content_sanskrit": "लोकोपक्रोशभीरुत्वाद्वर्मराजो महामनाः।\nअचिन्तयन्महाबाहुः शैनेयस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054724, "chapter_id": 2199, "verse_number": "७-१२६-९", "content_sanskrit": "पदवीं प्रेषितश्चैव फल्गुनस्य मया रणे।\nशैनेयः सात्यकिः सत्यो मित्राणामभयङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054725, "chapter_id": 2199, "verse_number": "७-१२६-१०", "content_sanskrit": "तदिदं ह्येकमेवासीद्द्द्विधा जातं ममाऽद्य वै।\nसात्यकिश्च हि विज्ञेयः पाण्डवश्च धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054726, "chapter_id": 2199, "verse_number": "७-१२६-११", "content_sanskrit": "सात्यकिं प्रेषयित्वा तु पाण्डवस्य पदानुगम्।\nसात्वतस्यापि कं युद्धे प्रेषयिष्ये पदानुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054727, "chapter_id": 2199, "verse_number": "७-१२६-१२", "content_sanskrit": "परिष्यामि प्रयत्नेन भ्रातुरन्वेषणं यदि।\nयुयुधानमनन्विष्य लोको मां गर्हयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054728, "chapter_id": 2199, "verse_number": "७-१२६-१३", "content_sanskrit": "भ्रातुरन्वेषणं कृत्वा धर्मपुत्रो युधिष्ठिरः।\nपरित्यजति वार्ष्णेयं सात्यकिं सत्यविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054729, "chapter_id": 2199, "verse_number": "७-१२६-१४", "content_sanskrit": "लोकापवादभीरुत्वात्सोऽहं पार्थं वृकोदरम्।\nपदवीं प्रेषयिष्यामि माधवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054730, "chapter_id": 2199, "verse_number": "७-१२६-१५", "content_sanskrit": "यथैव च मम प्रीतिरर्जुने शत्रुमूदने।\nतथैव वृष्णिवीरेऽपि सात्वते युद्धदुर्मदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054731, "chapter_id": 2199, "verse_number": "७-१२६-१६", "content_sanskrit": "अतिभारे नियुक्तश्च मया शैनेयनन्दनः।\nस तु मित्रोपरोधेन गौरवात्तु महाबलः।\nप्रविष्टो भारतीं सेनां मकरः सागरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054732, "chapter_id": 2199, "verse_number": "७-१२६-१७", "content_sanskrit": "असौ हि श्रूयते शब्दः शूराणामनिवर्तिनाम्।\nमिथः संयुध्यमानानं वृष्णिवीरेण धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054733, "chapter_id": 2199, "verse_number": "७-१२६-१८", "content_sanskrit": "प्राप्तकालं सुबलवन्निश्चितं बहुधा हि मे।\nतत्रैव पाण्डवेयस्य भीमसेनस्य धन्विनः।\nगमनं रोचते मह्यं यत्र यातौ महारथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054734, "chapter_id": 2199, "verse_number": "७-१२६-१९", "content_sanskrit": "न चाप्यसह्यं भीमस्य विद्यते भुवि किञ्चिन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054735, "chapter_id": 2199, "verse_number": "७-१२६-२०", "content_sanskrit": "शक्तो ह्येष रणे यत्तः पृथिव्यां सर्वधन्विनाम्।\nस्वबाहुबलमास्थाय प्रतिव्यूहितुमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054736, "chapter_id": 2199, "verse_number": "७-१२६-२१", "content_sanskrit": "यस्य बाहुबलं सर्वे समाश्रित्य महात्मनः।\nवनवासान्निवृत्ताः स्म न च युद्धेषु निर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054737, "chapter_id": 2199, "verse_number": "७-१२६-२२", "content_sanskrit": "इतो गते भीमसेने सात्वतं प्रति पाण़्डवे।\nसनाथौ भवितारौ हि युधि सात्वतफल्गुनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054738, "chapter_id": 2199, "verse_number": "७-१२६-२३", "content_sanskrit": "कामं त्वशोचनीयौ तौ रणे सात्वतफल्गुनौ।\nरक्षितौ वासुदेवेन स्वयं शस्त्रविशारदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054739, "chapter_id": 2199, "verse_number": "७-१२६-२४", "content_sanskrit": "अवश्यं तु मया कार्यमात्मनः शोकनाशनम्।\nतस्माद्भीमं नियोक्ष्यामि सात्वतस्य पदानुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054740, "chapter_id": 2199, "verse_number": "७-१२६-२५", "content_sanskrit": "ततः प्रतिकृतं मन्ये विधानं सात्यकिं प्रति॥\nएवं निश्चित्य मनसा धर्मपुत्रो युधिष्ठिरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054741, "chapter_id": 2199, "verse_number": "७-१२६-२६", "content_sanskrit": "यन्तारमब्रवीद्राजा भीमं प्रति नयस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054742, "chapter_id": 2199, "verse_number": "७-१२६-२७", "content_sanskrit": "धर्मराजवचः श्रुत्वा सारथिर्हयकोविदः।\nरथं हेमपरिष्कारं भीमान्तिकमुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054743, "chapter_id": 2199, "verse_number": "७-१२६-२८", "content_sanskrit": "भीमसेनमनुज्ञाप्य प्राप्तकालमचिन्तयत्।\nकश्मलं प्राविशद्राजा बहु तत्र समादिशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054744, "chapter_id": 2199, "verse_number": "७-१२६-२९", "content_sanskrit": "स कश्मलसमाविष्टो भीममाहूय पार्थिवः।\nअब्रवीद्वचनं राजन्कुन्तीपुत्रो युधिष्ठिरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054745, "chapter_id": 2199, "verse_number": "७-१२६-३०", "content_sanskrit": "अब्रवीद्वचनं राजन्कुन्तीपुत्रो युधिष्ठिरः॥\nयः सदेवान्सगन्धर्वान्दैत्यांश्चैकरथोऽजयत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054746, "chapter_id": 2199, "verse_number": "७-१२६-३१", "content_sanskrit": "तस्य लक्ष्म न पश्यामि भीमसेनानुजस्य ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054747, "chapter_id": 2199, "verse_number": "७-१२६-३१x", "content_sanskrit": "सञ्जय उवाच।\nततोऽब्रवीद्धर्मराजं भीमसेनस्तथागतम्।\nनैवाद्राक्षं नचाश्रौषं तव कश्मलमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054748, "chapter_id": 2199, "verse_number": "७-१२६-३२", "content_sanskrit": "पुरातिदुःखदीर्णानां भवान्गतिरभूद्धि नः।\nउत्तिष्ठोत्तिष्ठ राजेन्द्र शाधि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054749, "chapter_id": 2199, "verse_number": "७-१२६-३३", "content_sanskrit": "न ह्यसाध्यमकार्यं वा विद्यते मम मानद।\nआज्ञापय कुरुश्रेष्ठ मा च शोके मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054750, "chapter_id": 2199, "verse_number": "७-१२६-३४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054751, "chapter_id": 2199, "verse_number": "७-१२६-३४", "content_sanskrit": "तमब्रवीदश्रुपूर्णः कृष्णसर्प इव श्वसन्।\nभीमसेनमिदं वाक्यं प्रम्लानवदनो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054752, "chapter_id": 2199, "verse_number": "७-१२६-३५", "content_sanskrit": "श्रूयते पाञ्चजन्यस्य यथा शङ्खस्य निस्वनः।\nपूरितो वासुदेवेन संरब्धेन यशस्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054753, "chapter_id": 2199, "verse_number": "७-१२६-३६", "content_sanskrit": "नूनमद्य हतः शेते तव भ्राता धनञ्जयः।\nतस्मिन्विनिहते नूनं युध्यतेऽसौ जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054754, "chapter_id": 2199, "verse_number": "७-१२६-३७", "content_sanskrit": "यस्य सत्ववतो वीर्यं ह्युपजीवन्ति पाण्डवाः।\nयं भयेष्वभिगच्छन्ति सहस्राक्षमिवामराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054755, "chapter_id": 2199, "verse_number": "७-१२६-३८", "content_sanskrit": "स शूरः सैन्धवप्रेप्सुरन्वयाद्भारतीं चमूम्।\nतस्य वै गमनं विद्मो भीम नावर्तनं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054756, "chapter_id": 2199, "verse_number": "७-१२६-३९", "content_sanskrit": "श्यामो युवा गुडाकेशो दर्शनीयो महारथः।\nव्यूढोरस्को महाबाहुर्मत्तद्विरदविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054757, "chapter_id": 2199, "verse_number": "७-१२६-४०", "content_sanskrit": "चकोरनेत्रस्ताम्रास्यो द्विषतां भयवर्धनः।\n`मम प्रियहितार्थं च शक्रलोकादिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054758, "chapter_id": 2199, "verse_number": "७-१२६-४१", "content_sanskrit": "वृद्धोपसेवी धृतिमान्कृतज्ञः सत्यसङ्गरः।\nप्रविष्टो महतीं सेनामपर्यन्तां धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054759, "chapter_id": 2199, "verse_number": "७-१२६-४२", "content_sanskrit": "प्रविष्टे च चमूं घोरामर्जुने शत्रुनाशने।\nप्रेषितः सात्वतो वीरः फल्गुनस्य पदानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054760, "chapter_id": 2199, "verse_number": "७-१२६-४३", "content_sanskrit": "तस्याभिगमनं जाने भीम नावर्तनं पुनः।\nतदिदं मम भद्रं ते शोकस्थानमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054761, "chapter_id": 2199, "verse_number": "७-१२६-४४", "content_sanskrit": "अर्जुनार्थे महाबाहो सात्वतस्य च कारणात्।\nवर्धते हविषेवाग्निरिध्यमानः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054762, "chapter_id": 2199, "verse_number": "७-१२६-४५", "content_sanskrit": "तस्य लक्ष्म न पश्यामि तेन विन्दामि कश्मलम्।\nतं विद्धि पुरुषव्याघ्रं सात्वतं च महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054763, "chapter_id": 2199, "verse_number": "७-१२६-४६", "content_sanskrit": "स तं महारथं पश्चादनुयातस्तवानुजम्।\nतमपश्यन्महाबाहुमदं विन्दामि कश्मलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2054764, "chapter_id": 2199, "verse_number": "७-१२६-४७", "content_sanskrit": "`अथैनं पुनराचक्ष्व लोहिताक्षं सकेशवम्।\nदृष्ट्वा कुशलिनं पार्थं सैन्धवान्ते ससात्यकिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2054765, "chapter_id": 2199, "verse_number": "७-१२६-४८", "content_sanskrit": "संविदं मम कुर्यास्त्वं सिंहनादेन पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2054766, "chapter_id": 2199, "verse_number": "७-१२६-४९", "content_sanskrit": "नूनं विनिहतः शूरः सव्यासाची परन्तप।\nपार्थे तस्मिन्हते चैव युध्यते गरुडध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2054767, "chapter_id": 2199, "verse_number": "७-१२६-५०", "content_sanskrit": "सहयो नास्य वै कश्चित्तेन विन्दामि कश्मलम्।\nतस्मात्कृष्णो रणे नूनं युध्यते युद्धकोविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2054768, "chapter_id": 2199, "verse_number": "७-१२६-५१", "content_sanskrit": "न हि मे शुध्यते भावस्तयोरेव परन्तप।\nस तत्र गच्छ कौन्तेय यत्र यातो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2054769, "chapter_id": 2199, "verse_number": "७-१२६-५२", "content_sanskrit": "सात्यकिश्च महावीर्यः कर्तव्यं यदि मन्यसे।\nवचनं मम धर्मज्ञ भ्राता ज्येष्ठो भवामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2054770, "chapter_id": 2199, "verse_number": "७-१२६-५३", "content_sanskrit": "न मेऽर्जुनस्तथा ज्ञेयो ज्ञातव्यः सात्यकिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2054771, "chapter_id": 2199, "verse_number": "७-१२६-५४", "content_sanskrit": "चिकीर्षुर्मत्प्रियं पार्थ स यातः सव्यसाचिनः।\nपदवीं दुर्गमां घोरामगम्यामकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2054772, "chapter_id": 2199, "verse_number": "७-१२६-५५", "content_sanskrit": "दृष्ट्वा कुशलिनौ कृष्णौ सात्वतं चैव सात्यकिम्।\nसंविदं चैव कुर्यास्त्वं सिंहनादेन पाण़्डव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2054773, "chapter_id": 2199, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे षड्विंशत्यधिकशततमोऽध्यायः॥ १२६ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१२६-६ वानरर्षभलक्षणं वानरप्रधानध्वजम्। वरवानरकेतनमिति पाठो वा॥ ५-१२६-९ सत्यो दृढप्रतिज्ञः॥ ५-१२६-२५ सात्यकिम्प्रति प्रतिविधानं कृतमित्यन्वयः॥ ५-१२६-४० चकोरनेत्रो रक्तान्तायतनयनः। ताम्रास्यो रक्तगौरमुखः॥ ५-१२६-१२६ षड्विंशत्यधिकशततमोऽध्यायः॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]