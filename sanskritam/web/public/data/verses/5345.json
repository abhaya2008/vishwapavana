[{"id": 2203749, "chapter_id": 5345, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203750, "chapter_id": 5345, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश त्रिपुरान्तक शङ्कर ।\nअयं त्वृषिगणो देव तपस्तप इति प्रभो\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203751, "chapter_id": 5345, "verse_number": "२", "content_sanskrit": "तपसा कर्शिता नित्यं तपोऽर्जनपरायणः ।\nअस्य किंलक्षणो धर्मः कीदृशश्चागमस्तथा ।\nएतदिच्छाम्यहं श्रोतुं तन्मे वद वरप्रद\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203752, "chapter_id": 5345, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203753, "chapter_id": 5345, "verse_number": "३", "content_sanskrit": "एवं ब्रुवन्त्यां रुद्राण्यामृषयः साधुसाध्विति ।\nअब्रुवन् हृष्टमनसः सर्वे तद्गतमानसाः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203754, "chapter_id": 5345, "verse_number": "४", "content_sanskrit": "शृण्वन्तीमृषिधर्मांस्तु ऋषयश्चाभ्यपूजयन्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203755, "chapter_id": 5345, "verse_number": "५", "content_sanskrit": "त्वत्प्रसादाद् वयं देवि श्रोष्यामः परमं हितम् ।\nधन्याः खलु वयं सर्वे पादमूलं तवाश्रिताः ।\nइति सर्वे तदा देवीं वाचा समभिपूजयन्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203756, "chapter_id": 5345, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203757, "chapter_id": 5345, "verse_number": "६", "content_sanskrit": "न्यायतस्त्वं महाभागे श्रोतुकामा मनस्विनि ।\nहन्त ते कथयिष्यामि मुनिधर्मं शुचिस्मिते\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203758, "chapter_id": 5345, "verse_number": "७", "content_sanskrit": "वानप्रस्थं समाश्रित्य क्रियते बहुधा नरैः ।\nबहुशाखो बहुविधो ऋषिधर्मः सनातनः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203759, "chapter_id": 5345, "verse_number": "८", "content_sanskrit": "प्रायशः सर्वभोगार्थमृषिभिः क्रियते तपः ।\nतथा सञ्चरतां तेषां देवि धर्मविधिं शृणु\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203760, "chapter_id": 5345, "verse_number": "९", "content_sanskrit": "भूत्वा पूर्वं गृहस्थस्तु पुत्रानृण्यमवाप्य च ।\nकलत्रकार्यं संस्थाप्य कारणात् सन्त्यजेद् गृहम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203761, "chapter_id": 5345, "verse_number": "१०", "content_sanskrit": "अवस्थाप्य मनो धृत्या व्यवसायपुरःसरः ।\nनिर्दारो वा सदारो वा वनवासाय संव्रजेत्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203762, "chapter_id": 5345, "verse_number": "११", "content_sanskrit": "देशाः परमपुण्या ये नदीवनसमन्विताः ।\nअबाधमुक्ताः प्रायेण तीर्थायतनसंयुताः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203763, "chapter_id": 5345, "verse_number": "१२", "content_sanskrit": "तत्र गत्वा विधिं ज्ञात्वा दीक्षां कुर्याद् यथागमम् ।\nदीक्षित्वैकमना भूत्वा परिचर्यां समाचरेत्\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203764, "chapter_id": 5345, "verse_number": "१३", "content_sanskrit": "काल्योत्थानं च शौचं च सर्वदेवप्रणामनम् ।\nशकृदालेपनं काये त्यक्तदोषोऽप्रमादिता\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203765, "chapter_id": 5345, "verse_number": "१४", "content_sanskrit": "सायम्प्रातश्चाभिषेकमग्निहोत्रं यथाविधि ।\nकायशौचं च कार्यं च जटावल्कलधारणम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203766, "chapter_id": 5345, "verse_number": "१५", "content_sanskrit": "सततं वनचर्या च समित्कुसुमकारणात् ।\nनीवारग्रहणं काले शाकमूलोपचायनम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203767, "chapter_id": 5345, "verse_number": "१६", "content_sanskrit": "सदायतनशौचं च तस्य धर्माय चेष्यते ।\nअतिथीनामाभिमुख्यं तत्परत्वं च सर्वशः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203768, "chapter_id": 5345, "verse_number": "१७", "content_sanskrit": "पाद्यासनाभ्यां सम्पूज्य तथाऽऽहारनिमन्त्रणम् ।\nअग्राम्यपचनं काले पितृदेवार्चनं तथा\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203769, "chapter_id": 5345, "verse_number": "१८", "content_sanskrit": "पश्चादतिथिसत्कारस्तस्य धर्माः सनातनाः ।\nशिष्टैर्धर्मासने चैव धर्मार्थसहिताः कथाः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2203770, "chapter_id": 5345, "verse_number": "१९", "content_sanskrit": "प्रतिश्रयविभागश्च भूमिशय्या शिलासु वा ।\nव्रतोपवासयोगश्च क्षमा चेन्द्रियनिग्रहः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2203771, "chapter_id": 5345, "verse_number": "२०", "content_sanskrit": "दिवारात्रं यथायोगं शौचं धर्मस्य चिन्तनम् ।\nएवं धर्माः पुरा दृष्टाः सामान्या वनवासिनाम्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2203772, "chapter_id": 5345, "verse_number": "२१", "content_sanskrit": "एवं वै यतमानस्य कालधर्मो यथा भवेत् ।\nतदैव सोऽभिजायेत स्वर्गलोकं शुचिस्मिते\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2203773, "chapter_id": 5345, "verse_number": "२२", "content_sanskrit": "तत्र संविहिता भोगाः स्वर्गस्त्रीभिरनिन्दिते ।\nपरिभ्रष्टो यदा स्वर्गाद् विशिष्टस्तु भवेन्नृषु\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2203774, "chapter_id": 5345, "verse_number": "२३", "content_sanskrit": "एवं धर्मः सदा देवि सर्वेषां वनवासिनाम् ।\nएतत्ते कथितं सर्वं किं भूयः श्रोतुमिच्छसि\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2203775, "chapter_id": 5345, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2203776, "chapter_id": 5345, "verse_number": "२४", "content_sanskrit": "भगवन् देवदेवेश ऋषीणां चरितं शुभम् ।\nविशेषधर्मानिच्छामि श्रोतुं कौतूहलं हि मे\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2203777, "chapter_id": 5345, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2203778, "chapter_id": 5345, "verse_number": "२५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु देवि समाहिता\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2203779, "chapter_id": 5345, "verse_number": "२६", "content_sanskrit": "वननित्यैर्वनरतैर्वानप्रस्थैर्महर्षिभिः ।\nवनं गुरुमिवालम्ब्य वस्तव्यमिति निश्चयः\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2203780, "chapter_id": 5345, "verse_number": "२७", "content_sanskrit": "वीरशय्यामुपासद्भिर्वीरस्थानोपसेविभिः ।\nव्रतोपवासैर्बहुभिर्ग्रीष्मे पञ्चतपैस्तथा\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2203781, "chapter_id": 5345, "verse_number": "२८", "content_sanskrit": "पञ्चयज्ञपरैर्नित्यं पौर्णमास्यपरायणैः ।\nमण्डूकशायैर्हेमन्ते शैवालाङ्कुरभोजनैः\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2203782, "chapter_id": 5345, "verse_number": "२९", "content_sanskrit": "चीरवल्कलसंवीतैर्मृगाजिनधरैस्तथा ।\nचातुर्मास्यपरैः कैश्चिद् देवधर्मपरायणैः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2203783, "chapter_id": 5345, "verse_number": "३०", "content_sanskrit": "एवंविधैर्वनगतैस्तप्यते सुमहत् तपः ।\nएवं कृत्वा शुभं कर्म पश्चाद् याति त्रिविष्टपम्\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2203784, "chapter_id": 5345, "verse_number": "३१", "content_sanskrit": "तत्रापि सुमहत्कालं स विहृत्य यथासुखम् ।\nजायते मानुषे लोके दानभोगसमन्वितः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2203785, "chapter_id": 5345, "verse_number": "३२", "content_sanskrit": "तपोविशेषसंयुक्ताः कथितास्ते शुचिस्मिते\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2203786, "chapter_id": 5345, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2203787, "chapter_id": 5345, "verse_number": "३३", "content_sanskrit": "भगवन् देवदेवेश तेषु ये दारसंयुताः ।\nकीदृशं चरितं तेषां तन्मे शंसितुमर्हसि\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2203788, "chapter_id": 5345, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2203789, "chapter_id": 5345, "verse_number": "३४", "content_sanskrit": "य एकपत्नीधर्माणश्चरन्ति विपुलं तपः ।\nविन्ध्यपादेषु ये केचिद् ये च नैमिशवासिनः\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2203790, "chapter_id": 5345, "verse_number": "३५", "content_sanskrit": "पुष्करेषु च ये चान्ये नदीवनसमाश्रिताः ।\nसर्वे ते विधिदृष्टेन चरन्ति विपुलं तपः\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2203791, "chapter_id": 5345, "verse_number": "३६", "content_sanskrit": "हिंसाद्रोहविमुक्ताश्च सर्वभूतानुकम्पिनः ।\nशान्ता दान्ता जितक्रोधाः सर्वातिथ्यपरायणाः\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2203792, "chapter_id": 5345, "verse_number": "३७", "content_sanskrit": "प्राणिष्वात्मोपमा नित्यमृतुकालाभिगामिनः ।\nस्वदारसहिता देवि चरन्ति व्रतमुत्तमम्\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2203793, "chapter_id": 5345, "verse_number": "३८", "content_sanskrit": "वसन्ति सुखमव्यग्राः पुत्रदारसमन्विताः ।\nतेषां परिच्छदारम्भाः कृतोपकरणानि च\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2203794, "chapter_id": 5345, "verse_number": "३९", "content_sanskrit": "गृहस्थवद् विधीयन्ते यथायोगं प्रमाणतः ।\nपोषणार्थं स्वदाराणामग्निकार्यार्थमेव च ।\nगावश्च कर्षकाश्चैव सर्वमेतद्विधीयते\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2203795, "chapter_id": 5345, "verse_number": "४०", "content_sanskrit": "एवं वनगतैर्देवि कर्तव्यं दारसंयुतैः ।\nते स्वदारैः समायान्ति पुण्याँल्लोकान् द्दढव्रताः\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2203796, "chapter_id": 5345, "verse_number": "४१", "content_sanskrit": "पतिभिः सह ये दाराश्चरन्ति विपुलं तपः ।\nअल्पग्रहा वारहव्या ते च गच्छन्ति वै दिवम् ।\nएतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि॥\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2203797, "chapter_id": 5345, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे वानप्रस्थधर्मकथनं नाम षण्णवत्युत्तरशततमोऽध्यायः ॥१९६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]