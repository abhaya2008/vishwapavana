[{"id": 2198825, "chapter_id": 5229, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198826, "chapter_id": 5229, "verse_number": "१", "content_sanskrit": "दर्शने कीदृशः स्नेहः संवासे च पितामह ।\nमहाभाग्यं गवां चैव तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198827, "chapter_id": 5229, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198828, "chapter_id": 5229, "verse_number": "२", "content_sanskrit": "हन्त ते कथयिष्यामि पुरावृत्तं महाद्युते ।\nनहुषस्य च संवादं महर्षेश्च्यवनस्य च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198829, "chapter_id": 5229, "verse_number": "३", "content_sanskrit": "पुरा महर्षिश्च्यवनो भार्गवो भरतर्षभ ।\nउदवासकृतारम्भो बभूव सुमहाव्रतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198830, "chapter_id": 5229, "verse_number": "४", "content_sanskrit": "निहत्य मानं क्रोधं च प्रहर्षं शोकमेव च ।\nवर्षाणि द्वादश मुनिर्जलवासे धृतव्रतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198831, "chapter_id": 5229, "verse_number": "५", "content_sanskrit": "आदधत् सर्वभूतेषु विस्रम्भं परमं शुभम् ।\nजलेचरेषु सत्त्वेषु शीतरश्मिरिव प्रभुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198832, "chapter_id": 5229, "verse_number": "६", "content_sanskrit": "स्थाणुभूतः शुचिर्भूत्वा दैवतेभ्यः प्रणम्य च ।\nगङ्गायमुनयोर्मध्ये जलं सम्प्रविवेश ह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198833, "chapter_id": 5229, "verse_number": "७", "content_sanskrit": "गङ्गायमुनयोर्वेगं सुभीमं भीमनिस्वनम् ।\nप्रतिजग्राह शिरसा वातवेगसमं जवे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198834, "chapter_id": 5229, "verse_number": "८", "content_sanskrit": "गङ्गा च यमुना चैव सरितश्चानुगास्तयोः ।\nप्रदक्षिणमृषिं चक्रुर्न चैनं पर्यपीडयन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198835, "chapter_id": 5229, "verse_number": "९", "content_sanskrit": "अन्तर्जले स सुष्वाप काष्ठभूतो महामुनिः ।\nततश्चोर्ध्वस्थितो धीमानभवद् भरतर्षभ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198836, "chapter_id": 5229, "verse_number": "१०", "content_sanskrit": "जलौकसां स सत्त्वानां बभूव प्रियदर्शनः ।\nउपाजिघ्रन्त च तदा मत्स्यास्तं हृष्टमानसाः ।\nतत्र तस्यासतः कालः समतीतोऽभवन्महान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198837, "chapter_id": 5229, "verse_number": "११", "content_sanskrit": "ततः कदाचित्समये कस्मिंश्चिन्मत्स्यजीविनः ।\nतं देशं समुपाजग्मुर्जालहस्ता महाद्युते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198838, "chapter_id": 5229, "verse_number": "१२", "content_sanskrit": "निषादा बहवस्तत्र मत्स्योद्धरणनिश्चिताः ।\nव्यायता बलिनः शूराः सलिलेष्वनिवर्तिनः ।\nअभ्याययुश्च तं देशं निश्चिता जालकर्मणि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198839, "chapter_id": 5229, "verse_number": "१३", "content_sanskrit": "जालं च योजयामासुर्विशेषेण जनाधिप ।\nमत्स्योदकं समासाद्य तदा भरतसत्तम\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198840, "chapter_id": 5229, "verse_number": "१४", "content_sanskrit": "ततस्ते बहुभिर्योगैः कैवर्ता मत्स्यकाङ्क्षिणः ।\nगङ्गायमुनयोर्वारि जालैरभ्यकिरंस्ततः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198841, "chapter_id": 5229, "verse_number": "१५", "content_sanskrit": "जालं सुविततं तेषां नवसूत्रकृतं तथा ।\nविस्तारायामसम्पन्नं यत् तत्र सलिले क्षमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198842, "chapter_id": 5229, "verse_number": "१६", "content_sanskrit": "ततस्ते सुमहच्चैव बलवच्च सुवर्तितम् ।\nप्रकीर्य सर्वतः सर्वे जालं चकृषिरे तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198843, "chapter_id": 5229, "verse_number": "१७", "content_sanskrit": "अभीतरूपाः संहृष्टास्तेऽन्योन्यवशवर्तिनः ।\nबबन्धुस्तत्र मत्स्यांश्च तथान्यान् जलचारिणः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198844, "chapter_id": 5229, "verse_number": "१८", "content_sanskrit": "तथा मत्स्यैः परिवृतं च्यवनं भृगुनन्दनम् ।\nआकर्षन्त महाराज जालेनाथ यदृच्छया\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198845, "chapter_id": 5229, "verse_number": "१९", "content_sanskrit": "नदीशैवलदिग्धाङ्गं हरिश्मश्रुजटाधरम् ।\nलग्नशङ्खनखैर्गात्रैः कोष्ठैश्चित्रैरिवावृतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198846, "chapter_id": 5229, "verse_number": "२०", "content_sanskrit": "तं जालेनोद्धृतं दृष्ट्वा ते तदा वेदपारगम् ।\nसर्वे प्राञ्जलयो दाशाः शिरोभिः प्रापतन् भुवि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198847, "chapter_id": 5229, "verse_number": "२१", "content_sanskrit": "परिखेदपरित्रासाज्जालस्याकर्षणेन च ।\nमत्स्या बभूवुर्व्यापन्नाः स्थलसङ्कर्षणेन च\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198848, "chapter_id": 5229, "verse_number": "२२", "content_sanskrit": "स मुनिस्तत्तदा दृष्ट्वा मत्स्यानां कदनं कृतम् ।\nबभूव कृपयाऽऽविष्टो निःश्वसंश्च पुनः पुनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198849, "chapter_id": 5229, "verse_number": "", "content_sanskrit": "निषादाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198850, "chapter_id": 5229, "verse_number": "२३", "content_sanskrit": "अज्ञानाद् यत् कृतं पापं प्रसादं तत्र नः कुरु ।\nकरवाम प्रियं किं ते तन्नो ब्रूहि महामुने\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198851, "chapter_id": 5229, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198852, "chapter_id": 5229, "verse_number": "२४", "content_sanskrit": "इत्युक्तो मत्स्यमध्यस्थश्च्यवनो वाक्यमब्रवीत् ।\nयो मेऽद्य परमः कामस्तं शृणुध्वं समाहिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198853, "chapter_id": 5229, "verse_number": "२५", "content_sanskrit": "प्राणोत्सर्गं विक्रयं वा मत्स्यैर्यास्याम्यहं सह ।\nसंवासान्नोत्सहे त्यक्तुं सलिलाध्युषितानिमान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2198854, "chapter_id": 5229, "verse_number": "२६", "content_sanskrit": "इत्युक्तास्ते निषादास्तु सुभृशं भयकम्पिताः ।\nसर्वे विषण्णवदना नहुषाय न्यवेदयन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2198855, "chapter_id": 5229, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे जाले च्यवनग्रहणं नाम अशीतितमोऽध्यायः ॥८०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]