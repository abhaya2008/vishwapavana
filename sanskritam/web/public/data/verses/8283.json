[{"id": 900003333, "chapter_id": 8283, "verse_number": "17.1", "content_sanskrit": "ये शास्त्रविधिमुत्सृज्य यजन्ते श्रद्धयाऽन्विताः । तेषां निष्ठा तु का कृष्ण सत्त्वमाहो रजस्तमः ।। १ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003334, "chapter_id": 8283, "verse_number": "17.2", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003335, "chapter_id": 8283, "verse_number": "17.3", "content_sanskrit": "त्रिविधा भवति श्रद्धा देहिनां सा स्वभावजा । सात्त्विका राजसी चैव तामसी चेति तां शृणु ।। २ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003336, "chapter_id": 8283, "verse_number": "17.4", "content_sanskrit": "सत्त्वानुरूपा सर्वस्य श्रद्धा भवति भारत । श्रद्धामयोऽयं पुरुषो यो यच्छ्रद्धः स एव सः ।। ३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003337, "chapter_id": 8283, "verse_number": "17.5", "content_sanskrit": "यजन्ते सात्त्विका देवान् यक्षरक्षांसि राजसाः । प्रेतान् भूतगणांश्चान्ये यजन्ते तामसा जनाः ।। ४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003338, "chapter_id": 8283, "verse_number": "17.6", "content_sanskrit": "अशास्त्रविहितं घोरं तप्यन्ते ये तपो जनाः । दम्भाहङ्कारसंयुक्ताः कामरागबलान्विताः ।। ५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003339, "chapter_id": 8283, "verse_number": "17.7", "content_sanskrit": "कर्शयन्तः शरीरस्थं भूतग्राममचेतसः । मां चैवान्तःशरीरस्थं तान् विद्ध्यासुरनिश्चयान् ।। ६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003340, "chapter_id": 8283, "verse_number": "17.8", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003341, "chapter_id": 8283, "verse_number": "17.9", "content_sanskrit": "आहारस्त्वपि सर्वस्य त्रिविधो भवति प्रियः । यज्ञस्तपस्तथा दानं तेषां भेदमिमं शृणु ।। ७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003342, "chapter_id": 8283, "verse_number": "17.10", "content_sanskrit": "आयुः सत्त्वबलारोग्यसुखप्रीतिविवर्धनाः । रस्याः स्निग्धाः स्थिरा हृद्या आहाराः सात्त्विकप्रियाः ।। ८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003343, "chapter_id": 8283, "verse_number": "17.11", "content_sanskrit": "कट्वाम्ललवणात्युष्णतीक्ष्णरूक्षविदाहिनः । आहारा राजसस्येष्टा दुःखशोकामयप्रदाः ।। ९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003344, "chapter_id": 8283, "verse_number": "17.12", "content_sanskrit": "यातयामं गतरसं पूति पर्युषितं च यत् । उच्छिष्टमपि चामेध्यं भोजनं तामसप्रियम् ।। १० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003345, "chapter_id": 8283, "verse_number": "17.13", "content_sanskrit": "अफलाकाङ्क्षिभिर्यज्ञो विधिदृष्टो य इज्यते । यष्टव्यमेवेति मनः समाधाय स सात्त्विकः ।। ११ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003346, "chapter_id": 8283, "verse_number": "17.14", "content_sanskrit": "अभिसन्धाय तु फलं दम्भार्थमपि चैव यत् । इज्यते भरतश्रेष्ठ तं यज्ञं विद्धि राजसम् ।। १२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003347, "chapter_id": 8283, "verse_number": "17.15", "content_sanskrit": "विधिहीनमसृष्टान्नं मन्त्रहीनमदक्षिणम् । श्रद्धाविरहितं यज्ञं तामसं परिचक्षते ।। १३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003348, "chapter_id": 8283, "verse_number": "17.16", "content_sanskrit": "देवद्विजगुरुप्राज्ञपूजनं शौचमार्जवम् । ब्रह्मचर्यमहिंसा च शारीरं तप उच्यते ।। १४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003349, "chapter_id": 8283, "verse_number": "17.17", "content_sanskrit": "अनुद्वेगकरं वाक्यं सत्यं प्रियहितं च यत् । स्वाध्यायाभ्यसनं चैव वाङ्मयं तप उच्यते ।। १५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003350, "chapter_id": 8283, "verse_number": "17.18", "content_sanskrit": "मनःप्रसादः सौम्यत्वं मौनमात्मविनिग्रहः । भावसंशुद्धिरित्येतत्तपो मानसमुच्यते ।। १६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003351, "chapter_id": 8283, "verse_number": "17.19", "content_sanskrit": "श्रद्धया परया तप्तं तपस्तत् त्रिविधं नरैः । अफलाकाङ्क्षिभिर्युक्तैः सात्त्विकं परिचक्षते ।। १७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003352, "chapter_id": 8283, "verse_number": "17.20", "content_sanskrit": "सत्कारमानपूजार्थं तपो दम्भेन चैव यत् । क्रियते तदिह प्रोक्तं राजसं चलमध्रुवम् ।। १८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900003353, "chapter_id": 8283, "verse_number": "17.21", "content_sanskrit": "मूढग्राहेणाऽत्मनो यत् पीडया क्रियते तपः । परस्योत्सादनार्थं वा तत् तामसमुदाहृतम् ।। १९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900003354, "chapter_id": 8283, "verse_number": "17.22", "content_sanskrit": "दातव्यमिति यद्दानं दीयतेऽनुपकारिणे । देशे काले च पात्रे च तद्दानं सात्त्विकं स्मृतम् ।। २० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900003355, "chapter_id": 8283, "verse_number": "17.23", "content_sanskrit": "यत्तु प्रत्युपकारार्थं फलमुद्दिश्य वा पुनः । दीयते च परिक्लिष्टं तद्दानं राजसं स्मृतम् ।। २१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900003356, "chapter_id": 8283, "verse_number": "17.24", "content_sanskrit": "ओशकाले यद्दानमपात्रेभ्यश्च दीयते । असत्कृतमवज्ञातं तत् तामसमुदाहृतम् ।। २२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900003357, "chapter_id": 8283, "verse_number": "17.25", "content_sanskrit": "ओ३म् तत् सदिति निर्देशो ब्रह्मणस्त्रिविधः स्मृतः । ब्राह्मणास्तेन वेदाश्च यज्ञाश्च विहिताः पुरा ।। २३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900003358, "chapter_id": 8283, "verse_number": "17.26", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900003359, "chapter_id": 8283, "verse_number": "17.27", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900003360, "chapter_id": 8283, "verse_number": "17.28", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900003361, "chapter_id": 8283, "verse_number": "17.29", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900003362, "chapter_id": 8283, "verse_number": "17.30", "content_sanskrit": "तस्मादोमित्युदाहृत्य यज्ञदानतपःक्रियाः । प्रवर्तन्ते विधानोक्ताः सततं ब्रह्मवादिनाम् ।। २४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900003363, "chapter_id": 8283, "verse_number": "17.31", "content_sanskrit": "तदित्यनभिसन्धाय फलं यज्ञतपःक्रियाः । दानक्रियाश्च विविधाः क्रियन्ते मोक्षकाङ्क्षिभिः ।। २५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900003364, "chapter_id": 8283, "verse_number": "17.32", "content_sanskrit": "सद्भावे साधुभावे च सदित्येतत् प्रयुज्यते । प्रशस्ते कर्मणि तथा सच्छब्दः पार्थ युज्यते ।। २६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900003365, "chapter_id": 8283, "verse_number": "17.33", "content_sanskrit": "यज्ञे तपसि दाने च स्थितिः सदिति चोच्यते । कर्म चैव तदर्थीयं सदित्येवाभिधीयते ।। २७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900003366, "chapter_id": 8283, "verse_number": "17.34", "content_sanskrit": "अश्रद्धया हुतं दत्तं तपस्तप्तं कृतं च यत् । असदित्युच्यते पार्थ नच तत् प्रेत्य नो इह ।। २८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]