[{"id": 7000689000, "chapter_id": 20689, "verse_number": "६-३२-१", "content_sanskrit": "महादेव उवाच ।\nदृष्ट्वा शतक्रतुं सिद्धं समाप्तवरदक्षिणम् ।\nमघवा जातसंकल्पः पर्यपृच्छद्बृहस्पतिम् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000689001, "chapter_id": 20689, "verse_number": "६-३२-२", "content_sanskrit": "भगवन्केन दानेन सर्वतः सुखमेधते ।\nयदक्षयं महार्घं च तन्मे ब्रूहि महातपः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000689002, "chapter_id": 20689, "verse_number": "६-३२-३", "content_sanskrit": "एवमिंद्रेण चोक्तोऽसौ देवदेवः पुरोहितः ।\nप्रहस्य तं महाप्राज्ञो बृहस्पतिरुवाचह ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000689003, "chapter_id": 20689, "verse_number": "६-३२-४", "content_sanskrit": "हिरण्यदानं गोदानं भूमिदानं च वासव ।\nएतत्प्रयच्छमानस्तु सर्वपापैः प्रमुच्यते ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000689004, "chapter_id": 20689, "verse_number": "६-३२-५", "content_sanskrit": "सुवर्णं रजतं वस्त्रं मणिरत्नं च वासव ।\nसर्वमेव भवेद्दत्तं वसुधां यः प्रयच्छति ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000689005, "chapter_id": 20689, "verse_number": "६-३२-६", "content_sanskrit": "फालकृष्टां महीं दत्वा सबीजां सस्यमालिनीम् ।\nयावत्सूर्यकृतालोकस्तावत्स्वर्गेमहीयते ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000689006, "chapter_id": 20689, "verse_number": "६-३२-७", "content_sanskrit": "यत्किंचित्कुरुते पापं पुरुषो वृत्तिकर्षितः ।\nअपि गोचर्ममात्रेण भूमिदानेन शुध्यति ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000689007, "chapter_id": 20689, "verse_number": "६-३२-८", "content_sanskrit": "दशहस्तेन दंडोऽत्र त्रिंशद्दंडानि वर्तनम् ।\nदशतान्येव गोचर्म्म ब्रह्मगोचर्मलक्षणम् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000689008, "chapter_id": 20689, "verse_number": "६-३२-९", "content_sanskrit": "सवृषं गोसहस्रं तु यत्र तिष्ठत्ययंत्रितम् ।\nबालवत्सप्रसूतानां तद्गोचर्म इति स्मृतम् ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000689009, "chapter_id": 20689, "verse_number": "६-३२-१०", "content_sanskrit": "विप्राय दद्याच्च गुणान्विताय तपोयुताय प्रजितेंद्रियाय ।\nयावन्मही तिष्ठति सागरांता तावत्फलं तस्य भवेदनंतम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000689010, "chapter_id": 20689, "verse_number": "६-३२-११", "content_sanskrit": "यथाप्सु पतितः शक्र तैलबिंदुः प्रसर्पति ।\nएवंभूमिकृतं दानं सस्ये सस्ये प्रसर्पति ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000689011, "chapter_id": 20689, "verse_number": "६-३२-१२", "content_sanskrit": "यथाबीजानि रोहंति प्रचीर्णानि महीतले ।\nएवं कामान्प्ररोहंति भूमिदानसमन्विताः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000689012, "chapter_id": 20689, "verse_number": "६-३२-१३", "content_sanskrit": "अन्नदाः सुखिनो नित्यं वस्त्रदो रूपवान्भवेत् ।\nस नरः सर्वदो भूयो यो ददाति वसुंधराम् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000689013, "chapter_id": 20689, "verse_number": "६-३२-१४", "content_sanskrit": "यथा गौर्भरते वत्सं क्षीरमुत्सृज्य क्षीरिणी ।\nएवं दत्ता सहस्राक्ष भूमिर्भरति भूमिदम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000689014, "chapter_id": 20689, "verse_number": "६-३२-१५", "content_sanskrit": "शंखो भद्रासनं छत्रं वराश्ववरवारणाः ।\nभूमिदानस्य पुण्यस्य फलं स्वर्गः पुरंदर ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000689015, "chapter_id": 20689, "verse_number": "६-३२-१६", "content_sanskrit": "आदित्यो वरुणो वह्निर्ब्रह्मा सोमो हुताशनः ।\nशूलपाणिश्च भगवानभिनंदंति भूमिदम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000689016, "chapter_id": 20689, "verse_number": "६-३२-१७", "content_sanskrit": "आस्फोटयंति पितरो वर्णयंति पितामहाः ।\nभूमिदाता कुले जातः स नस्त्राता भविष्यति ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000689017, "chapter_id": 20689, "verse_number": "६-३२-१८", "content_sanskrit": "त्रीण्याहुरतिदानानि गावः पृथ्वी सरस्वती ।\nनरकादुद्धरंत्येते जपवापनदोहनात् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000689018, "chapter_id": 20689, "verse_number": "६-३२-१९", "content_sanskrit": "दुर्गतिं तारयंत्येते विद्वद्भिर्विप्रधारणैः ।\nप्रावृता वस्त्रदा यांति नग्ना यान्तित्ववस्त्रदाः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000689019, "chapter_id": 20689, "verse_number": "६-३२-२०", "content_sanskrit": "तृप्ता यांत्यन्नदातारः क्षुधिता यांत्यनन्नदाः ।\nकांक्षंति पितरः सर्वे नरकाद्भयभीरवः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000689020, "chapter_id": 20689, "verse_number": "६-३२-२१", "content_sanskrit": "गयां यास्यति यः पुत्रः स नस्त्राता भविष्यति ।\nएष्टव्या बहवः पुत्रा यद्येकोऽपि गयां व्रजेत् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000689021, "chapter_id": 20689, "verse_number": "६-३२-२२", "content_sanskrit": "यजेत वाश्वमेधेन नीलं वा वृषमुत्सृजेत् ।\nलोहितो यस्तु वर्णेन पुच्छाग्रे यस्तु पांडुरः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000689022, "chapter_id": 20689, "verse_number": "६-३२-२३", "content_sanskrit": "श्वेतः खुरविषाणाभ्यां स नीलो वृष उच्यते ।\nनीलः पांडुरलांगूलस्तोयमुद्धरते तु यः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000689023, "chapter_id": 20689, "verse_number": "६-३२-२४", "content_sanskrit": "षष्टिं वर्षसहस्राणि पितरस्तेन तर्पिताः ।\nयच्च शृंगगतं पंकं कुलं तिष्ठति चोद्धृतम् ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000689024, "chapter_id": 20689, "verse_number": "६-३२-२५", "content_sanskrit": "पितरस्तस्य चाश्नंति सोमलोकं महाद्युतिम् ।\nआसीद्राज्ञो दिलीपस्य नृगस्य नहुषस्य च ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000689025, "chapter_id": 20689, "verse_number": "६-३२-२६", "content_sanskrit": "अन्येषां तु नरेंद्राणां पुनरन्यो न गच्छति ।\nबहुभिर्वसुधा दत्ता राजभिः सगरादिभिः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000689026, "chapter_id": 20689, "verse_number": "६-३२-२७", "content_sanskrit": "यस्य यस्य यदा भूमिस्तस्यतस्य तदा फलम् ।\nब्रह्मघ्नो वाथ स्त्रीहंता बालघ्नः पतितोऽथवा ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000689027, "chapter_id": 20689, "verse_number": "६-३२-२८", "content_sanskrit": "गवां शतसहस्राणि हंता तत्तस्यदुःष्कृतम् ।\nस्वदत्तां परदत्तां वा यो हरेत्तु वसुंधराम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000689028, "chapter_id": 20689, "verse_number": "६-३२-२९", "content_sanskrit": "स च विष्ठाकृमिर्भूत्वा पितृभिः सह पच्यते ।\nषष्टिवर्षसहस्राणि स्वर्गे तिष्ठति भूमिदः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000689029, "chapter_id": 20689, "verse_number": "६-३२-३०", "content_sanskrit": "प्रहर्ता चानुमंता च तावद्वै नरकं व्रजेत् ।\nभूमिदाद्भूमिहर्तुश्च नापरः पुण्यपापवान् ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000689030, "chapter_id": 20689, "verse_number": "६-३२-३१", "content_sanskrit": "उर्द्ध्वाधस्तौ च तिष्ठेते यावदाभूतसंप्लवम् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000689031, "chapter_id": 20689, "verse_number": "६-३२-३२", "content_sanskrit": "अग्नेरपत्यं प्रथमं सुवर्णं भूर्वैष्णवी सूर्यसुतास्तु गावः ।\nतेषांमनंतं फलमश्नुवीत यः कांचनं गां च महीं च दद्यात् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000689032, "chapter_id": 20689, "verse_number": "६-३२-३३", "content_sanskrit": "भूमिं यः प्रतिगृह्णाति यश्च भूमिं प्रयच्छति ।\nउभौ तौ पुण्यकर्माणौ नियतौ स्वर्गगामिनौ ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000689033, "chapter_id": 20689, "verse_number": "६-३२-३४", "content_sanskrit": "अन्यायेन हृता भूमिर्यैर्नरैरपहारिता ।\nहरंतो हारयंतश्च हन्युस्ते सप्तमं कुलम् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000689034, "chapter_id": 20689, "verse_number": "६-३२-३५", "content_sanskrit": "हरेद्धारयते यस्तु मंदबुद्धिस्तमोवृतः ।\nस बद्धो वारुणैः पाशैस्तिर्यग्योनिषु जायते ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000689035, "chapter_id": 20689, "verse_number": "६-३२-३६", "content_sanskrit": "अश्रुभिः पतितैस्तेषां दानानामवकीर्त्तनम् ।\nब्राह्मणस्य हृते क्षेत्रे हतं त्रिपुरुषं कुलम् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000689036, "chapter_id": 20689, "verse_number": "६-३२-३७", "content_sanskrit": "वापीकूपसहस्रेण अश्वमेधशतेन च ।\nगवांकोटिप्रदानेन भूमिहर्ता न शुद्ध्यति ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000689037, "chapter_id": 20689, "verse_number": "६-३२-३८", "content_sanskrit": "कृतं दत्तं तपोऽधीतं यत्किंचिद्धर्मसंस्थितम् ।\nअर्द्धांगुलस्य सीमाया हरणेन प्रणश्यति ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000689038, "chapter_id": 20689, "verse_number": "६-३२-३९", "content_sanskrit": "गोतीर्थं ग्रामरथ्यां च श्मशानग्राममेव च ।\nसंपीड्य नरकं याति यावदाभूतसंप्लवम् ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000689039, "chapter_id": 20689, "verse_number": "६-३२-४०", "content_sanskrit": "पंचकन्यानृते हंति दश हंति गवानृते ।\nशतमश्वानृते हंति सहस्रं पुरुषानृते ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000689040, "chapter_id": 20689, "verse_number": "६-३२-४१", "content_sanskrit": "हंति जातानजातांश्च हिरण्यार्थेऽनृतं वदन् ।\nसर्वं भूम्यनृते हंति मास्म भूम्यनृतं वद ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000689041, "chapter_id": 20689, "verse_number": "६-३२-४२", "content_sanskrit": "ब्रह्मस्वे नो रतिं कुर्यात्प्राणैः कंठगतैरपि ।\nअग्निदग्धाः प्ररोहंति ब्रह्मदग्धो न रोहति ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000689042, "chapter_id": 20689, "verse_number": "६-३२-४३", "content_sanskrit": "अग्निदग्धाः प्ररोहंति सूर्यदग्धास्तथैव च ।\nराजदंडहताश्चैव ब्रह्मशापहता हताः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000689043, "chapter_id": 20689, "verse_number": "६-३२-४४", "content_sanskrit": "ब्रह्मस्वेन च पुष्टानि अंगानि च मुहुर्महुः ।\nकार्यकालेविशीर्यंते सिकताभि तपो यथा ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000689044, "chapter_id": 20689, "verse_number": "६-३२-४५", "content_sanskrit": "ब्रह्मस्वहरणं कुर्वन्नरो यातीह रौरवम् ।\nन विषं विषमित्याहुर्ब्रह्मस्वं विषमुच्यते ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000689045, "chapter_id": 20689, "verse_number": "६-३२-४६", "content_sanskrit": "विषमेकाकिनं हंति ब्रह्मस्वं पुत्रपौत्रिकम् ।\nलोहचूर्णं चाश्मचूर्णं विषं संजरयेन्नरः ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000689046, "chapter_id": 20689, "verse_number": "६-३२-४७", "content_sanskrit": "ब्रह्मस्वं त्रिषु लोकेषु कः पुमान्जरयिष्यति ।\nब्रह्मस्वेन तु यत्सौख्यं देवस्वेन तु या रतिः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000689047, "chapter_id": 20689, "verse_number": "६-३२-४८", "content_sanskrit": "तद्धनं कुलनाशाय भवत्यात्मविनाशनम् ।\nब्रह्मस्वं ब्रह्महत्या च दरिद्रस्य तु यद्धनम् ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000689048, "chapter_id": 20689, "verse_number": "६-३२-४९", "content_sanskrit": "गुरुमित्रहिरण्यं च स्वर्गस्थमपि पीडयेत् ।\nश्रोत्रियाय कुलीनाय दरिद्राय च वासव ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000689049, "chapter_id": 20689, "verse_number": "६-३२-५०", "content_sanskrit": "संतुष्टाय विनीताय सर्वस्वसहिताय च ।\nवेदाभ्यास तपो ज्ञानेंद्रियसंयमशालिने ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000689050, "chapter_id": 20689, "verse_number": "६-३२-५१", "content_sanskrit": "ईदृशाय सुरश्रेष्ठ यद्दत्तं हि तदक्षयम् ।\nआमपात्रे यथा न्यस्तं क्षीरं दधि घृतं मधु ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000689051, "chapter_id": 20689, "verse_number": "६-३२-५२", "content_sanskrit": "भिनत्ति पात्रं दौर्बल्यान्न च पात्रं विनश्यति ।\nएवं गां च हिरण्यं च वस्त्रमन्नं मही तिलान् ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000689052, "chapter_id": 20689, "verse_number": "६-३२-५३", "content_sanskrit": "अविद्वान्प्रतिगृह्णाति भस्मीभवति काष्ठवत् ।\nयस्तडागं नवं कुर्यात्पुराणं वापि खानयेत् ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000689053, "chapter_id": 20689, "verse_number": "६-३२-५४", "content_sanskrit": "सर्वं कुलं समुद्धृत्य स्वर्गलोके महीयते ।\nवापीकूपतडागानि उद्यानप्रभवानि च ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000689054, "chapter_id": 20689, "verse_number": "६-३२-५५", "content_sanskrit": "पुनर्नीतानि संस्कारं ददते मौक्तिकं फलम् ।\nनिदाघकाले पानीय यस्य तिष्ठति वासव ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000689055, "chapter_id": 20689, "verse_number": "६-३२-५६", "content_sanskrit": "स दुर्गं विषमं कृच्छ्रं न कदाचिदवाप्नुयात् ।\nएकाहं तु स्थितं तोयं पृथिव्यां देवसत्तम ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000689056, "chapter_id": 20689, "verse_number": "६-३२-५७", "content_sanskrit": "कुलानि तारयेत्तस्य सप्तसप्त परानपि ।\nदीपालोकप्रदानेन वपुष्मान्स भवेन्नरः ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000689057, "chapter_id": 20689, "verse_number": "६-३२-५८", "content_sanskrit": "दक्षिणायाः प्रदानेन स्मृतिं मेधां च विंदति ।\nकृत्वापि पातकं कर्म यो दद्यादनुसंधिने ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000689058, "chapter_id": 20689, "verse_number": "६-३२-५९", "content_sanskrit": "ब्राह्मणाय विशेषेण न स पापैर्हि लिप्यते ।\nभूमेर्गावस्तथादासः प्रसह्य प्रहृता यदा ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000689059, "chapter_id": 20689, "verse_number": "६-३२-६०", "content_sanskrit": "न निवेदयते यस्तु तमाहुर्ब्रह्मघातकम् ।\nउपस्थिते विवाहे च यज्ञे दाने च वासव ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000689060, "chapter_id": 20689, "verse_number": "६-३२-६१", "content_sanskrit": "मोहाच्चरति विघ्नं यः स मृतो जायते कृमिः ।\nधनं फलति दानेन जीवितं जीवरक्षणात् ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000689061, "chapter_id": 20689, "verse_number": "६-३२-६२", "content_sanskrit": "रूपमैश्वर्यमारोग्यमहिंसाफलमश्नुते ।\nफलमूलाशनात्पूजां स्वर्गः सत्येन लभ्यते ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000689062, "chapter_id": 20689, "verse_number": "६-३२-६३", "content_sanskrit": "प्रायोपवेशनाद्राज्यं सर्वत्र सुखमश्नुते ।\nसुखाट्यः शक्रदीक्षायां सुगामी च तृणाशनः ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000689063, "chapter_id": 20689, "verse_number": "६-३२-६४", "content_sanskrit": "रूपी त्रिषवणस्नायी वायुं पीत्वा क्रतुं लभेत् ।\nनित्यस्नायी भवेद्दक्षः संध्यावेदजपान्वितः ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000689064, "chapter_id": 20689, "verse_number": "६-३२-६५", "content_sanskrit": "अहिंस्रो याति वैराज्यं नाकपृष्ठमनाशकम् ।\nअग्निप्रवेशी नियतं ब्रह्मलोके महीयते ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000689065, "chapter_id": 20689, "verse_number": "६-३२-६६", "content_sanskrit": "रसानां प्रतिसंहारे पशून्पुत्रांश्च विंदति ।\nनाके चिरं स वसति उपवासी च यो भवेत् ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000689066, "chapter_id": 20689, "verse_number": "६-३२-६७", "content_sanskrit": "सततं भूमिशायी यः स लभेदीप्सितां गतिम् ।\nवीरासनं वीरशयं वीरस्थानमुपासतः ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000689067, "chapter_id": 20689, "verse_number": "६-३२-६८", "content_sanskrit": "अक्षयास्तस्यलोकाः स्युः सर्वकामगमास्तथा ।\nउपवासं च दीक्षां च अभिषेकं च वासव ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000689068, "chapter_id": 20689, "verse_number": "६-३२-६९", "content_sanskrit": "कृत्वा द्वादशवर्षाणि वीरस्थानाद्विशिष्यते ।\nपावनं चरते धर्मं स्वर्गलोके महीयते ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000689069, "chapter_id": 20689, "verse_number": "६-३२-७०", "content_sanskrit": "बृहस्पतिमतं पुण्यं ये पठंति द्विजोत्तमाः ।\nतेषां चत्वारि वर्द्धंते आयुर्विद्यायशोबलम् ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000689070, "chapter_id": 20689, "verse_number": "६-३२-७१", "content_sanskrit": "नारद उवाच ।\nइतींद्राय बृहस्पतिप्रणीतं धर्मशास्त्रकम् ।\nमह्यं भक्ताय संप्रोक्तं महेशेनाखिलं नृप ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]