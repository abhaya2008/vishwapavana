[{"id": 6000340000, "chapter_id": 10340, "verse_number": null, "content_sanskrit": "अथ अष्टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000340001, "chapter_id": 10340, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.001.m4a", "display_order": 2}, {"id": 6000340002, "chapter_id": 10340, "verse_number": "१२-८-१", "content_sanskrit": "संस्तुतो भगवानित्थं मार्कण्डेयेन धीमता।\nनारायणो नरसखः प्रीत आह भृगूद्वह॥ १२/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.002.m4a", "display_order": 3, "topics": [{"text": "भगवता मार्कण्डेयाय प्रलयप्रदर्शनम्", "range": "१–१९"}]}, {"id": 6000340003, "chapter_id": 10340, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.003.m4a", "display_order": 4}, {"id": 6000340004, "chapter_id": 10340, "verse_number": "१२-८-२", "content_sanskrit": "भो भो ब्रह्मर्षिवर्यासि सिद्ध आत्मसमाधिना।\nमयि भक्त्याऽनपायिन्या तपःस्वाध्यायसंयमैः॥ १२/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.004.m4a", "display_order": 5}, {"id": 6000340005, "chapter_id": 10340, "verse_number": "१२-८-३", "content_sanskrit": "वयं ते परितुष्टाः स्म त्वद्बृहद्व्रतचर्यया।\nवरं प्रतीच्छ भद्रं ते वरदेशादभीप्सितम्॥ १२/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.005.m4a", "display_order": 6}, {"id": 6000340006, "chapter_id": 10340, "verse_number": null, "content_sanskrit": "ऋषिरुवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.006.m4a", "display_order": 7}, {"id": 6000340007, "chapter_id": 10340, "verse_number": "१२-८-४", "content_sanskrit": "जितं ते देवदेवेश प्रपन्नार्तिहराच्युत।\nवरेणैतावताऽलं नो यद् भवान् समदृश्यत॥ १२/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.007.m4a", "display_order": 8}, {"id": 6000340008, "chapter_id": 10340, "verse_number": "१२-८-५", "content_sanskrit": "वाञ्छन्त्यजादयो यस्य श्रीमत्पादाब्जदर्शनम्।\nमनसा योगपक्‍वेन स भवान् मेऽक्षगोचरः॥ १२/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.008.m4a", "display_order": 9}, {"id": 6000340009, "chapter_id": 10340, "verse_number": "१२-८-६", "content_sanskrit": "अथाप्यम्बुजपत्राक्ष पुण्यश्लोकशिखामणे।\nईक्षे मायां यया लोकः सपालो वेद सद्भिदाम्॥ १२/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.009.m4a", "display_order": 10}, {"id": 6000340010, "chapter_id": 10340, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.010.m4a", "display_order": 11}, {"id": 6000340011, "chapter_id": 10340, "verse_number": "१२-८-७", "content_sanskrit": "इतीरितोऽर्चितः काममृषिणा भगवान् मुने।\nतथेति सस्मयं प्रागाद् बदर्याश्रममीश्वरः॥ १२/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.011.m4a", "display_order": 12}, {"id": 6000340012, "chapter_id": 10340, "verse_number": "१२-८-८", "content_sanskrit": "तमेव चिन्तयन्नर्थमृषिः स्वाश्रम एव सः।\nवसन्नग्न्यर्कसोमाम्बुभूवायुवियदात्मसु॥ १२/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.012.m4a", "display_order": 13}, {"id": 6000340013, "chapter_id": 10340, "verse_number": "१२-८-९", "content_sanskrit": "ध्यायन् सर्वत्र च हरिं भावद्रव्यैरपूजयत्।\nक्‍वचित् पूजां विसस्मार भक्तिप्रसरसम्प्लुतः॥ १२/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.013.m4a", "display_order": 14}, {"id": 6000340014, "chapter_id": 10340, "verse_number": "१२-८-१०", "content_sanskrit": "तस्यैकदा भृगुश्रेष्ठ पुष्पभद्रातटे मुने।\nउपासीनस्य सन्ध्यायां ब्रह्मन् वायुरभून्महान्॥ १२/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.014.m4a", "display_order": 15}, {"id": 6000340015, "chapter_id": 10340, "verse_number": "१२-८-११", "content_sanskrit": "तं चण्डशब्दं समुदीरयन्तं बलाहका अन्वभवन् करालाः।\nअक्षस्थविष्ठा मुमुचुस्तडिद्भिस्तन्वन्त उच्चैरभिवर्षधाराः॥ १२/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.015.m4a", "display_order": 16}, {"id": 6000340016, "chapter_id": 10340, "verse_number": "१२-८-१२", "content_sanskrit": "ततो व्यदृश्यन्त चतुःसमुद्राः समन्ततः क्ष्मातलमाग्रसन्तः।\nसमीरवेगोर्मिभिरुग्रनक्रभयानकावर्तगभीरघोषाः॥ १२/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.016.m4a", "display_order": 17}, {"id": 6000340017, "chapter_id": 10340, "verse_number": "१२-८-१३", "content_sanskrit": "अन्तर्बहिश्चाद्भिरभिद्युभिर्घनैः शतह्रदाभिरुपतापितं जगत्।\nचतुर्विधं वीक्ष्य महामना मुनिर्जलप्लुतां क्ष्मां विमनाः समत्रसत्॥ १२/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.017.m4a", "display_order": 18}, {"id": 6000340018, "chapter_id": 10340, "verse_number": "१२-८-१४", "content_sanskrit": "तस्यैवमुद्वीक्षत ऊर्मिभीषणः प्रभञ्जनाघूर्णितवार्महार्णवः।\nआपूर्यमाणः प्रवृषद्भिरम्बुदैः क्ष्मामप्यधाद् द्वीपवर्षादिभिः समम्॥ १२/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.018.m4a", "display_order": 19}, {"id": 6000340019, "chapter_id": 10340, "verse_number": "१२-८-१५", "content_sanskrit": "सक्ष्मान्तरिक्षं सदिवं सभागणं त्रैलोक्यमासीत् सहसाऽद्भिराप्लुतम्।\nस एक एवोर्वरितो महामुनिर्बभ्राम विक्षिप्तजटो जडान्धवत्॥ १२/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.019.m4a", "display_order": 20}, {"id": 6000340020, "chapter_id": 10340, "verse_number": "१२-८-१६", "content_sanskrit": "क्षुत्तृट्परीतो मकरैस्तिमिङ्गिलैरुपद्रुतो वीचिनभस्वता हृतः।\nतमस्यपारे पतितो भ्रमद्दिशो न वेद खं गां च परिश्रमोषितः॥ १२/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.020.m4a", "display_order": 21}, {"id": 6000340021, "chapter_id": 10340, "verse_number": "१२-८-१७", "content_sanskrit": "क्‍वचिन्मग्नो महावर्ते तरलैस्ताडितः क्‍वचित्।\nयादोभिर्भक्ष्यते क्‍वापि स्वयमन्योन्यघातिभिः॥ १२/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.021.m4a", "display_order": 22}, {"id": 6000340022, "chapter_id": 10340, "verse_number": "१२-८-१८", "content_sanskrit": "क्‍वचिच्छोकं क्‍वचिन्मोहं क्‍वचिद् दुःखं सुखं भयम्।\nक्‍वचिन्मृत्युमवाप्नोति व्याध्यादिभिरुपद्रुतः॥ १२/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.022.m4a", "display_order": 23}, {"id": 6000340023, "chapter_id": 10340, "verse_number": "१२-८-१९", "content_sanskrit": "अयुतायुतवर्षाणां सहस्राणि शतानि च।\nव्यतीयुर्भ्रमतस्तस्मिन् विष्णुमायावृतात्मनः॥ १२/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.023.m4a", "display_order": 24}, {"id": 6000340024, "chapter_id": 10340, "verse_number": "१२-८-२०", "content_sanskrit": "स कदाचिद् भ्रमंस्तस्मिन् पृथिव्याः ककुदि द्विजः।\nन्यग्रोधपोतं ददृशे फलपल्लवशोभितम्॥ १२/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.024.m4a", "display_order": 25, "topics": [{"text": "वटपत्रशायिनो बालमुकुन्दस्य मार्कण्डेयेन दर्शनम्", "range": "२०–३४"}]}, {"id": 6000340025, "chapter_id": 10340, "verse_number": "१२-८-२१", "content_sanskrit": "प्रागुत्तरस्यां शाखायां तस्यापि ददृशे शिशुम्।\nशयानं पर्णपुटके ग्रसन्तं प्रभया तमः॥ १२/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.025.m4a", "display_order": 26}, {"id": 6000340026, "chapter_id": 10340, "verse_number": "१२-८-२२", "content_sanskrit": "महामरकतश्यामं श्रीमद्वदनपङ्कजम्।\nकम्बुग्रीवं महोरस्कं सुनासं सुन्दरभ्रुवम्॥ १२/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.026.m4a", "display_order": 27}, {"id": 6000340027, "chapter_id": 10340, "verse_number": "१२-८-२३", "content_sanskrit": "श्वासैजदलकव्रातमिश्रश्रीकर्णदाडिमम्।\nविद्रुमाधरभासेषच्छोणायितसुधास्मितम्॥ १२/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.027.m4a", "display_order": 28}, {"id": 6000340028, "chapter_id": 10340, "verse_number": "१२-८-२४", "content_sanskrit": "पद्मगर्भारुणापाङ्गं हृद्यहासावलोकनम्।\nश्वासैजद्वलिसंविग्ननिम्ननाभिचलोदरम्॥ १२/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.028.m4a", "display_order": 29}, {"id": 6000340029, "chapter_id": 10340, "verse_number": "१२-८-२५", "content_sanskrit": "चार्वङ्गुलिभ्यां पाणिभ्यामुन्नीय चरणाम्बुजम्।\nमुखे निधाय विप्रेन्द्र धयन्तं वीक्ष्य विस्मितः॥ १२/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.029.m4a", "display_order": 30}, {"id": 6000340030, "chapter_id": 10340, "verse_number": "१२-८-२६", "content_sanskrit": "तद्दर्शनाद् वीतपरिश्रमो मुदा प्रोत्फुल्लहृत्पद्मविलोचनाम्बुजः।\nप्रहृष्टरोमाऽद्भुतभावशङ्कितः प्रष्टुं पुरस्तं प्रससार बालकम्॥ १२/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.030.m4a", "display_order": 31}, {"id": 6000340031, "chapter_id": 10340, "verse_number": "१२-८-२७", "content_sanskrit": "तावच्छिशोर्वै श्वसितेन भार्गवः सोऽन्तःशरीरं मशको यथाऽविशत्।\nतत्राप्यदो न्यस्तमचष्ट कृत्स्नशो यथा पुराऽमुह्यदतीव विस्मितः॥ १२/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.031.m4a", "display_order": 32}, {"id": 6000340032, "chapter_id": 10340, "verse_number": "१२-८-२८", "content_sanskrit": "खं रोदसी भगणानद्रिसागरान् द्वीपान् सवर्षान् ककुभः सुरासुरान्।\nवनानि देशान् सरितः पुराकरान् खेटान् व्रजानाश्रमवर्णवृत्तयः॥ १२/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.032.m4a", "display_order": 33}, {"id": 6000340033, "chapter_id": 10340, "verse_number": "१२-८-२९", "content_sanskrit": "महान्ति भूतान्यथ भौतिकान्यसौ कालं च नानायुगकल्पकल्पनम्।\nयत् किञ्चिदन्यद्व्यवहारकारणं ददर्श विश्वं सदिवावभासितम्॥ १२/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.033.m4a", "display_order": 34}, {"id": 6000340034, "chapter_id": 10340, "verse_number": "१२-८-३०", "content_sanskrit": "हिमालयं पुष्पवहां च तां नदीं निजाश्रमं यत्र ऋषीनपश्यत्।\nविश्वं विपश्यन् श्वसिताच्छिशोर्वै बहिर्निरस्तो न्यपतल्लयाब्धौ॥ १२/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.034.m4a", "display_order": 35}, {"id": 6000340035, "chapter_id": 10340, "verse_number": "१२-८-३१", "content_sanskrit": "तस्मिन् पृथिव्याः ककुदि प्ररूढं वटं च तत्पर्णपुटे शयानम्।\nतोकं च तत्प्रेमसुधास्मितेन निरीक्षितोऽपाङ्गनिरीक्षणेन॥ १२/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.035.m4a", "display_order": 36}, {"id": 6000340036, "chapter_id": 10340, "verse_number": "१२-८-३२", "content_sanskrit": "अथ तं बालकं वीक्ष्य नेत्राभ्यां धिष्ठितं हृदि।\nअभ्यगादतिसंहृष्टः परिष्वक्तुमधोक्षजम्॥ १२/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.036.m4a", "display_order": 37}, {"id": 6000340037, "chapter_id": 10340, "verse_number": "१२-८-३३", "content_sanskrit": "तावत् स भगवान् साक्षाद् योगाधीशो गुहाशयः।\nअन्तर्दधे ऋषेः सद्यो यथेहानीशनिर्मिता॥ १२/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.037.m4a", "display_order": 38}, {"id": 6000340038, "chapter_id": 10340, "verse_number": "१२-८-३४", "content_sanskrit": "तमन्वथ वटो ब्रह्मन् सलिलं लोकसम्प्लवम्।\nतिरोधायि क्षणादस्य स्वाश्रमे पूर्ववत् स्थितः॥ १२/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_008/BhP_12.008.038.m4a", "display_order": 39}, {"id": 6000340039, "chapter_id": 10340, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे अष्टमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]