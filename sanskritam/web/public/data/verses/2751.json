[{"id": 2082402, "chapter_id": 2751, "verse_number": "१२-२५६-०x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082403, "chapter_id": 2751, "verse_number": "१२-२५६-१", "content_sanskrit": "यस्माद्धर्मात्परो धर्मो विद्यदे नेह कश्चन।\nयो वि----- न्प्रब्रवीतु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082404, "chapter_id": 2751, "verse_number": "१२-२५६-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082405, "chapter_id": 2751, "verse_number": "१२-२५६-२", "content_sanskrit": "धर्मं ति संप्रवक्ष्यामि पुराणमृषिसंस्तुतम्।\nविशिष्टं सर्वधर्मेभ्यस्तमिहैकमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082406, "chapter_id": 2751, "verse_number": "", "content_sanskrit": "इन्द्रिया-----प्रमाथीनि बुद्ध्या संयम्य यत्नतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]