[{"id": 7006406000, "chapter_id": 26406, "verse_number": "२-६४-१", "content_sanskrit": "वैशम्पायन उवाच\nनिहत्य नरकं भौमं वासवोपमविक्रमम् ।\nवासवावरजो विष्णुर्ददर्श नरकालयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006406001, "chapter_id": 26406, "verse_number": "२-६४-२", "content_sanskrit": "अथार्थगृहमासाद्य नरकस्य जनार्दनः ।\nददर्श धनमक्षय्यं रत्नानि विविधानि च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006406002, "chapter_id": 26406, "verse_number": "२-६४-३", "content_sanskrit": "मणिमुक्ताप्रवालानि वैदूर्यस्य च संचयान् ।\nमासारगल्वकूटानि तथा वज्रस्य संचयान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006406003, "chapter_id": 26406, "verse_number": "२-६४-४", "content_sanskrit": "जाम्बूनदमयान्यस्य शातकुम्भमयानि च ।\nप्रदीप्तज्वलनाभानि शीतरश्मिनिभानि च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006406004, "chapter_id": 26406, "verse_number": "२-६४-५", "content_sanskrit": "शयनानि महार्हाणि तथा सिंहासनानि च ।\nहिरण्यदण्डरुचिरं शीतरश्मिसमप्रभम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006406005, "chapter_id": 26406, "verse_number": "२-६४-६", "content_sanskrit": "ददर्श तन्महच्छत्रं वर्षमाणमिवाम्बुदम् ।\nजातरूपस्य शुभ्रस्य धाराः शतसहस्रशः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006406006, "chapter_id": 26406, "verse_number": "२-६४-७", "content_sanskrit": "वरुणादाहृतं पूर्वं नरकेणेति नः श्रुतम् ।\nयावद्रत्नं गृहे दृष्टं नरकस्य धनं बहु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006406007, "chapter_id": 26406, "verse_number": "२-६४-८", "content_sanskrit": "नैव राज्ञः कुबेरस्य न शक्रस्य यमस्य च ।\nरत्नसंनिचयस्तादृग् दृष्टपूर्वो न च श्रुतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006406008, "chapter_id": 26406, "verse_number": "२-६४-९", "content_sanskrit": "हते भौमे निसुन्दे च हयग्रीवे च दानवे ।\nउपानिन्युस्ततस्तानि रत्नान्यन्तःपुराणि च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006406009, "chapter_id": 26406, "verse_number": "२-६४-१०", "content_sanskrit": "दानवा हतशिष्टा ये कोशसंचयरक्षिणः ।\nकेशवाय महार्हाणि यान्यर्हति जनार्दनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006406010, "chapter_id": 26406, "verse_number": "२-६४-११", "content_sanskrit": "दैत्या ऊचुः\nइमानि मणिरत्नानि विविधानि बहूनि च ।\nभीमरूपाश्च मातङ्गाः प्रवालविकृताः कुथाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006406011, "chapter_id": 26406, "verse_number": "२-६४-१२", "content_sanskrit": "हेमसूत्रा महाकक्षाश्चापतोमरशालिनः ।\nरुचिराभिः पताकाभिः शबला रुचिरांकुशाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006406012, "chapter_id": 26406, "verse_number": "२-६४-१३", "content_sanskrit": "ते च विंशतिसाहस्रा द्विस्तावत्यः करेणवः ।\nअष्टौ शत सहस्राणि देशजाश्चोत्तमा हयाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006406013, "chapter_id": 26406, "verse_number": "२-६४-१४", "content_sanskrit": "गोषु चापि कृतो यावान् कामस्तव जनार्दन ।\nतावतीः प्रापयिष्यामो वृष्ण्यन्धकनिवेशनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006406014, "chapter_id": 26406, "verse_number": "२-६४-१५", "content_sanskrit": "आविकानि च सूक्ष्माणि शयनान्यासनानि च ।\nकामव्याहारिणश्चैव पक्षिणः प्रियदर्शनाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006406015, "chapter_id": 26406, "verse_number": "२-६४-१६", "content_sanskrit": "नन्दनागुरुकाष्ठानि तथा कालीयकान्यपि ।\nवसु यत् त्रिषु लोकेषु धर्मेणाधिगतं तव ।\nप्रापयिष्याम तत् सर्व वृष्ण्यन्धकनिवेशनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006406016, "chapter_id": 26406, "verse_number": "२-६४-१७", "content_sanskrit": "देवगन्धर्वरत्नानि पन्नगानां च यद् वसु ।\nतानि सर्वाणि सन्तीह नरकस्य निवेशने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006406017, "chapter_id": 26406, "verse_number": "२-६४-१८", "content_sanskrit": "वैशम्पायन उवाच\nतच्च सर्वं हृषीकेशः परिगृह्य परीक्ष्य च ।\nसर्वमाहारयामास दानवैर्द्वारकां पुरीम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006406018, "chapter_id": 26406, "verse_number": "२-६४-१९", "content_sanskrit": "ततस्तद् वारुणं छत्रं स्वयमुत्क्षिप्य माधवः ।\nहिरण्यवर्षं वर्षन्तमारुरोह विहङ्गमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006406019, "chapter_id": 26406, "verse_number": "२-६४-२०", "content_sanskrit": "गरुडं पतगश्रेष्ठं मूर्तिमन्तमिवाम्बुदम् ।\nततोऽभ्ययाद् गिरिश्रेष्ठमभितो मणिपर्वतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006406020, "chapter_id": 26406, "verse_number": "२-६४-२१", "content_sanskrit": "तत्र पुण्या वयुर्वाता ह्यभवंश्चामलाः प्रभाः ।\nमणीनां हेमवर्णानामभिभूय दिवाकरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006406021, "chapter_id": 26406, "verse_number": "२-६४-२२", "content_sanskrit": "तत्र वैदूर्यवर्णानि ददर्श मधुसूदनः ।\nसतोरणपताकानि द्वाराणि शरणानि च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006406022, "chapter_id": 26406, "verse_number": "२-६४-२३", "content_sanskrit": "विद्युद्ग्रथितमेघाभः प्रबभौ मणिपर्वतः ।\nहेमचित्रवितानैश्च प्रासादैरुपशोभितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006406023, "chapter_id": 26406, "verse_number": "२-६४-२४", "content_sanskrit": "तत्र ता वरहेमाभा ददर्श मधुसूदनः ।\nगन्धर्वसुरमुख्यानां प्रिया दुहितरस्तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006406024, "chapter_id": 26406, "verse_number": "२-६४-२५", "content_sanskrit": "ददर्श पृथुलश्रोणीः संरुद्धा गिरिकन्दरे ।\nनरकेण समानीता रक्ष्यमाणाः समन्ततः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006406025, "chapter_id": 26406, "verse_number": "२-६४-२६", "content_sanskrit": "त्रिविष्टपसमे देशे तिष्ठन्तीरपराजिताः ।\nनिर्विशन्त्यो यथा देव्यः सुखिन्यः कामवर्जिताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006406026, "chapter_id": 26406, "verse_number": "२-६४-२७", "content_sanskrit": "परिवव्रुर्महाबाहुमेकवेणीधराः स्त्रियः ।\nसर्वाः काषायवासिन्यः सर्वाश्च नियतेन्द्रियाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006406027, "chapter_id": 26406, "verse_number": "२-६४-२८", "content_sanskrit": "व्रतोपवासतन्वङ्ग्यः काङ्क्षन्त्यः कृष्णदर्शनम् ।\nसमेत्य यदुसिंहस्य सर्वाश्चक्रुः स्त्रियोऽञ्जलीन् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006406028, "chapter_id": 26406, "verse_number": "२-६४-२९", "content_sanskrit": "नरकं निहतं ज्ञात्वा मुरं चैव महासुरम् ।\nहयग्रीवं निसुन्दं च ताः कृष्णं पर्यवारयन् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006406029, "chapter_id": 26406, "verse_number": "२-६४-३०", "content_sanskrit": "ये चासां रक्षिणो वृद्धा दानवा यदुनन्दनम् ।\nकृताञ्जलिपुटाः सर्वे प्रणिपेतुर्वयोऽधिकाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006406030, "chapter_id": 26406, "verse_number": "२-६४-३१", "content_sanskrit": "तासां परमनारीणामृषभाक्षं निरीक्ष्य तम् ।\nसर्वासामेव संकल्पः पतित्वेनाभवत् ततः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006406031, "chapter_id": 26406, "verse_number": "२-६४-३२", "content_sanskrit": "तस्य चन्द्रोपमं वक्त्रं निरीक्ष्य मुदितेन्द्रियाः ।\nसम्प्रहष्टा महाबाहुमिदं वचनमब्रुवन् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006406032, "chapter_id": 26406, "verse_number": "२-६४-३३", "content_sanskrit": "सत्यं च यत्पुरा वायुरिहास्मान्वाक्यमब्रवीत् ।\nसर्वभूतमतिज्ञश्च देवर्षिरपि नारदः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006406033, "chapter_id": 26406, "verse_number": "२-६४-३४", "content_sanskrit": "विष्णुर्नारायणो देवः शङ्खचक्रगदासिभृत् ।\nस भौमं नरकं हत्वा भर्ता च भविता स वः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006406034, "chapter_id": 26406, "verse_number": "२-६४-३५", "content_sanskrit": "सुप्रियं बत पश्यामश्चिरश्रुतमरिंदमम् ।\nदर्शनेन कृतार्था हि वयमद्य महात्मनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006406035, "chapter_id": 26406, "verse_number": "२-६४-३६", "content_sanskrit": "ततस्ताः सान्त्वयामास प्रमदा वासवानुजः ।\nसर्वाः कमलपत्राक्षीर्दृष्ट्वा चोवाच माधवः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006406036, "chapter_id": 26406, "verse_number": "२-६४-३७", "content_sanskrit": "यथार्हतः पूजयित्वा समाभाष्य च केशवः ।\nयानैः किङ्करसंयुक्तैरुवाह मधुसूदनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006406037, "chapter_id": 26406, "verse_number": "२-६४-३८", "content_sanskrit": "किङ्कराणां सहस्राणि रक्षसां वातरंहसाम् ।\nशिबिकां वहतां तत्र निर्घोषः सुमहानभूत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006406038, "chapter_id": 26406, "verse_number": "२-६४-३९", "content_sanskrit": "तस्य पर्वतराजस्य शृङ्गं यत् परमार्चितम् ।\nविमलार्केन्दुसंकाशं मणिकाञ्चनतोरणम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006406039, "chapter_id": 26406, "verse_number": "२-६४-४०", "content_sanskrit": "सपक्षिगणमातङ्गं समृगव्यालपादपम् ।\nशाखामृगगणाकीर्णं सुप्रस्तरशिलातलम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006406040, "chapter_id": 26406, "verse_number": "२-६४-४१", "content_sanskrit": "न्यंकुभिश्च वराहैश्च रुरुभिश्च निषेवितम् ।\nसप्रपातं महासानुं विचित्रशिखरद्रुमम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006406041, "chapter_id": 26406, "verse_number": "२-६४-४२", "content_sanskrit": "अत्यद्भुतमचिन्त्यं च मृगवृन्दविलोडितम् ।\nजीवञ्जीवकसंघैश्च बर्हिभिश्च निनादितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006406042, "chapter_id": 26406, "verse_number": "२-६४-४३", "content_sanskrit": "तदप्यतिबलो विष्णुर्दोर्भ्यामुत्पाट्य भासुरम् ।\nआरोपयामास बली गरुडे पक्षिणां वरे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006406043, "chapter_id": 26406, "verse_number": "२-६४-४४", "content_sanskrit": "मणिपर्वतशृङ्गं च सभार्यं च जनार्दनम् ।\nउवाह लीलया पक्षी गरुडः पततां वरः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006406044, "chapter_id": 26406, "verse_number": "२-६४-४५", "content_sanskrit": "स पक्षवलविक्षेपैर्हिमाद्रिशिखरोपमः ।\nदिक्षु सर्वासु संह्रादं जनयामास पक्षिराट् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006406045, "chapter_id": 26406, "verse_number": "२-६४-४६", "content_sanskrit": "आरुजन् पर्वताग्राणि पादपांश्च समुत्क्षिपन् ।\nसंजहार महाभ्राणि विजहार च कानिचित् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006406046, "chapter_id": 26406, "verse_number": "२-६४-४७", "content_sanskrit": "विषयं समतिक्रम्य देवयोश्चन्द्रसूर्ययोः ।\nययौ वातजवः पक्षी जनार्दनवशे स्थितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006406047, "chapter_id": 26406, "verse_number": "२-६४-४८", "content_sanskrit": "स मेरुगिरिमासाद्य देवगन्धर्वसेवितम् ।\nदेवसद्मानि सर्वाणि ददर्श मधुसूदनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006406048, "chapter_id": 26406, "verse_number": "२-६४-४९", "content_sanskrit": "विश्वेषां मरुतां चैव साध्यानां च नराधिप ।\nभ्राजमानान्यतिक्रामन्नश्विनोश्च परंतप ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006406049, "chapter_id": 26406, "verse_number": "२-६४-५०", "content_sanskrit": "प्राप्य पुण्यतमांल्लोकान् देवलोकमरिंदमः ।\nशक्रसद्म समासाद्य प्रविवेश जनार्दनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006406050, "chapter_id": 26406, "verse_number": "२-६४-५१", "content_sanskrit": "अवतीर्य स तार्क्ष्यात् तु ददर्श विबुधाधिपम् ।\nप्रीतश्चैवाभ्यनन्दत् तं देवराजः शतक्रतुः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006406051, "chapter_id": 26406, "verse_number": "२-६४-५२", "content_sanskrit": "प्रादाय कुण्डले दिव्ये ववन्दे तं तदाच्युतः ।\nसभार्यो विबुधश्रेष्ठं नरश्रेष्ठो जनार्दनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006406052, "chapter_id": 26406, "verse_number": "२-६४-५३", "content_sanskrit": "अर्चितो देवराजेन रत्नैश्च प्रतिपूजितः ।\nसत्यभामा च पौलोम्या यथावदभिनन्दिता ॥ ५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006406053, "chapter_id": 26406, "verse_number": "२-६४-५४", "content_sanskrit": "वासवो वासुदेवश्च जग्मतुः सहितौ तदा ।\nअदित्या भवनं दिव्यं देवमातुर्महर्द्धिमत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006406054, "chapter_id": 26406, "verse_number": "२-६४-५५", "content_sanskrit": "तत्रादितिमुपास्यन्तीमप्सरोभिः समन्ततः ।\nददृशाते महात्मानौ महाभागां तपोऽन्विताम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006406055, "chapter_id": 26406, "verse_number": "२-६४-५६", "content_sanskrit": "ततस्ते कुण्डले दिव्ये प्रादाददितिनन्दनः ।\nववन्दे तां शचीभर्ता मातरं स्वां पुरंदरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006406056, "chapter_id": 26406, "verse_number": "२-६४-५७", "content_sanskrit": "जनार्दनं पुरस्कृत्य कर्म चैव शशंस तत् ।\nअदितिस्तौ सुतौ प्रीत्या परिष्वज्याभिनन्द्य च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006406057, "chapter_id": 26406, "verse_number": "२-६४-५८", "content_sanskrit": "आशीर्भिरनुकूलाभिरुभावप्यवदत् तदा ।\nपौलोमी सत्यभामा च प्रीत्या परमया युते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006406058, "chapter_id": 26406, "verse_number": "२-६४-५९", "content_sanskrit": "अगृह्णीतां वरार्हाया देव्यास्ते चरणौ शुभौ ।\nते चाप्यभ्यवदत् प्रेम्णा देवमाता यशस्विनी ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006406059, "chapter_id": 26406, "verse_number": "२-६४-६०", "content_sanskrit": "यथावदब्रवीच्चैव जनार्दनमिदं वचः ।\nअधृष्यः सर्वभूतानामवध्यश्च भविष्यसि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006406060, "chapter_id": 26406, "verse_number": "२-६४-६१", "content_sanskrit": "यथैव देवराजोऽयमजितो लोकपूजितः ।\nभवत्वियं वरारोहा नित्यं च प्रियदर्शना ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006406061, "chapter_id": 26406, "verse_number": "२-६४-६२", "content_sanskrit": "सर्वलोकेषु विख्याता दिव्यगन्धा मनोरमा ।\nसत्यभामोत्तमा स्त्रीणां सुभगा स्थिरयौवना ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006406062, "chapter_id": 26406, "verse_number": "२-६४-६३", "content_sanskrit": "जरां न यास्यति वधूर्यावत्त्वं कृष्ण मानुषः ।\nएवमभ्यर्चितः कृष्णो देवमात्रा महाबलः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006406063, "chapter_id": 26406, "verse_number": "२-६४-६४", "content_sanskrit": "देवराजाभ्यनुज्ञातो रत्नैश्च प्रतिपूजितः ।\nवैनतेयं समारुह्य सहितः सत्यभामया ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006406064, "chapter_id": 26406, "verse_number": "२-६४-६५", "content_sanskrit": "देवाक्रीडं परिक्रामन् पूज्यमानं सुरर्षिभिः ।\nस ददर्श महाबाहुराक्रीडे वासवस्य ह ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006406065, "chapter_id": 26406, "verse_number": "२-६४-६६", "content_sanskrit": "दिव्यभभ्यर्चितं देवैः पारिजातं महाद्रुमम् ।\nनित्यपुष्पधरं दिव्यं पुण्यगन्धमनुत्तमम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006406066, "chapter_id": 26406, "verse_number": "२-६४-६७", "content_sanskrit": "यमासाद्य जनः सर्वो जातिं स्मरति पौर्विकीम् ।\nसंरक्ष्यमाणं देवैस्तं प्रसह्यामितविक्रमः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006406067, "chapter_id": 26406, "verse_number": "२-६४-६८", "content_sanskrit": "उत्पाट्यारोपयामास विष्णुस्तं गरुडोपरि ।\nसोऽपश्यत्सत्यभामा च दिव्यमप्सरसां गणम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006406068, "chapter_id": 26406, "verse_number": "२-६४-६९", "content_sanskrit": "पृष्ठतः सत्यभामा च दिव्या योषा च वीक्षिता ।\nप्रायात् ततो द्वारवतीं वायुजुष्टेन वै पथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006406069, "chapter_id": 26406, "verse_number": "२-६४-७०", "content_sanskrit": "श्रुत्वा तं देवराजस्तु कर्म कृष्णस्य तत् तदा ।\nअनुमेने महाबाहुः कृतकर्मेति चाब्रवीत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006406070, "chapter_id": 26406, "verse_number": "२-६४-७१", "content_sanskrit": "स पूज्यमानस्त्रिदशैः सप्तर्षिगणसंस्तुतः ।\nप्रतस्थे द्वारकां कृष्णो देवलोकादरिंदमः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006406071, "chapter_id": 26406, "verse_number": "२-६४-७२", "content_sanskrit": "सोऽभिपत्य महाबाहुर्दीर्घमध्वानमल्पवत् ।\nपूजितो देवराजेन ददृशे यादवीं पुरीम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006406072, "chapter_id": 26406, "verse_number": "२-६४-७३", "content_sanskrit": "तथा कर्म महत्कृत्वा भगवान् वासवानुजः ।\nउपायाद् द्वारकां कृष्णः श्रीमान् गरुडवाहनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]