[{"id": 2213516, "chapter_id": 5560, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213517, "chapter_id": 5560, "verse_number": "१", "content_sanskrit": "भगवान् श्वशुरो मेऽसि दैवतस्यापि दैवतम् ।\nस मे देवातिदेवस्त्वं शृणु सत्यां गिरं मम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213518, "chapter_id": 5560, "verse_number": "२", "content_sanskrit": "तपस्वी कोपनो विप्रो दुर्वासा नाम मे पितुः ।\nभिक्षामुपगतो भोक्तुं तमहं पर्यतोषयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213519, "chapter_id": 5560, "verse_number": "३", "content_sanskrit": "शौचेन त्वागसस्त्यागैः शुद्धेन मनसा तथा ।\nकोपस्थानेष्वपि महत्स्वकुप्यन्न कदाचन\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213520, "chapter_id": 5560, "verse_number": "४", "content_sanskrit": "स प्रीतो वरदो मेऽभूत् कृतकृत्यो महामुनिः ।\nअवश्यं ते ग्रहीतव्यमिति मां सोब्रवीद् वचः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213521, "chapter_id": 5560, "verse_number": "५", "content_sanskrit": "ततः शापभयाद् विप्रमवोचं पुनरेव तम् ।\nएवमस्त्विति च प्राह पुनरेव स मे द्विजः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213522, "chapter_id": 5560, "verse_number": "६", "content_sanskrit": "धर्मस्य जननी भद्रे भवित्री त्वं शुभानने ।\nवशे स्थास्यन्ति ते देवा यांस्त्वमावाहयिष्यसि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213523, "chapter_id": 5560, "verse_number": "७", "content_sanskrit": "इत्युक्त्वाऽन्तर्हितो विप्रस्ततोऽहं विस्मिताऽभवम् ।\nन च सर्वास्ववस्थासु स्मृतिर्मे विप्रणश्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213524, "chapter_id": 5560, "verse_number": "८", "content_sanskrit": "अथ हर्म्यतळस्थाऽहं रविमुद्यन्तमीक्षती ।\nसंस्मृत्य तदृषेर्वाक्यं स्पृहयन्ती दिवाकरम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213525, "chapter_id": 5560, "verse_number": "९", "content_sanskrit": "स्थिताऽहं बालभावेन तत्र दोषमबुद्ध्यती ।\nअथ देवः सहस्रांशुर्मत्समीपगतोऽभवत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213526, "chapter_id": 5560, "verse_number": "१०", "content_sanskrit": "द्विधा कृत्वाऽऽत्मनो देहं भूमौ च गगनेऽपि च ।\nतताप लोकानेकेन द्वितीयेनागमत्स माम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213527, "chapter_id": 5560, "verse_number": "११", "content_sanskrit": "स मामुवाच वेपन्तीं वरं मत्तो वृणीष्व ह ।\nगम्यतामिति तं चाहं प्रणम्य शिरसाऽवदम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213528, "chapter_id": 5560, "verse_number": "१२", "content_sanskrit": "(स मामुवाच तिग्मांशुर्वृथाऽऽह्वानं न मे क्षमम् ।\nधक्ष्यामि त्वां च विप्रं च येन दत्तो वरस्तव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213529, "chapter_id": 5560, "verse_number": "", "content_sanskrit": "तमहं रक्षती विप्रं शापादनपकारिणम् ।\nपुत्रो मे त्वत्समो देव भवेदिति ततोऽब्रवम्\t॥१३॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213530, "chapter_id": 5560, "verse_number": "१४", "content_sanskrit": "ततो मां तेजसाऽऽविश्य मोहयित्वा च भानुमान् ।\nउवाच भविता पुत्रस्तवेत्यभ्यगमद् दिवम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213531, "chapter_id": 5560, "verse_number": "१५", "content_sanskrit": "ततोऽहमन्तर्भवने पितुश्चित्तानुरक्षिणी ।\nगूढोत्पन्नं सुतं बालं जले कर्णमवासृजम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213532, "chapter_id": 5560, "verse_number": "१६", "content_sanskrit": "नूनं तस्यैव देवस्य प्रसादात् पुनरेव तु ।\nकन्याऽहमभवं विप्र यथा प्राह स मामृषिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213533, "chapter_id": 5560, "verse_number": "१७", "content_sanskrit": "स मया मूढया पुत्रो ज्ञायमानोऽप्युपेक्षितः ।\nतन्मां दहति विप्रर्षे यथा सुविदितं तव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213534, "chapter_id": 5560, "verse_number": "१८", "content_sanskrit": "यदि पापमपापं वा वदेतद् विवृतं मया ।\nतं मे भवन्तं भगवन् व्यपनेतुं त्वमर्हसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213535, "chapter_id": 5560, "verse_number": "१९", "content_sanskrit": "यच्चास्य राज्ञो विदितं हृदिस्थं भवतोऽनघ ।\nतं चायं लभतां काममद्यैव मुनिसत्तम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213536, "chapter_id": 5560, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213537, "chapter_id": 5560, "verse_number": "२०", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं व्यासो वेदविदांवरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213538, "chapter_id": 5560, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213539, "chapter_id": 5560, "verse_number": "२१", "content_sanskrit": "साधु सर्वमिदं भाव्यमेवमेतद् यथाऽऽत्थ माम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213540, "chapter_id": 5560, "verse_number": "२२", "content_sanskrit": "अपराधश्च ते नास्ति कन्याभावं गता ह्यसि ।\nदेवाश्चैश्वर्यवन्तो वै शरीराण्याविशन्ति वै\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213541, "chapter_id": 5560, "verse_number": "२३", "content_sanskrit": "सन्ति देवनिकायाश्च सङ्कल्पाज्जनयन्ति वै ।\nवाचा दृष्ट्या तथा स्पर्शात् सङ्घर्षेणेति पञ्चधा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213542, "chapter_id": 5560, "verse_number": "२४", "content_sanskrit": "मनुष्यधर्मो दैवेन धर्मेण हि न दुष्यति ।\nआर्यो दैवेन धर्मेण युज्यते न कदाचन\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213543, "chapter_id": 5560, "verse_number": "", "content_sanskrit": "(इति कुन्ति विजानीहि व्येतु ते मानसो ज्वरः\t॥२५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213544, "chapter_id": 5560, "verse_number": "२६", "content_sanskrit": "सर्वं बलवतां पथ्यं सर्वं बलवतां शुचि ।\nसर्वं बलवतां धर्मः सर्वं बलवतां स्वकम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213545, "chapter_id": 5560, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि कुन्ती-व्यासवाक्यं नाम षट्त्रिंशोऽध्यायः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213546, "chapter_id": 5560, "verse_number": "", "content_sanskrit": "पुत्रदर्शनपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]