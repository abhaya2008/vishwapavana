[{"id": 5000465000, "chapter_id": 9465, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000465001, "chapter_id": 9465, "verse_number": "६-५८-१", "content_sanskrit": "ततः प्रहस्तं निर्यान्तं दृष्ट्वा रणकृतोद्यमम्।\nउवाच सस्मितं रामो विभीषणमरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000465002, "chapter_id": 9465, "verse_number": "६-५८-२", "content_sanskrit": "क एष सुमहाकायो बलेन महता वृतः।\nआगच्छति महावेगः किंरूपबलपौरुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000465003, "chapter_id": 9465, "verse_number": "६-५८-३", "content_sanskrit": "आचक्ष्व मे महाबाहो वीर्यवन्तं निशाचरम्।\nराघवस्य वचः श्रुत्वा प्रत्युवाच विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000465004, "chapter_id": 9465, "verse_number": "६-५८-४", "content_sanskrit": "एष सेनापतिस्तस्य प्रहस्तो नाम राक्षसः।\nलङ्कायां राक्षसेन्द्रस्य त्रिभागबलसंवृतः।\nवीर्यवानस्त्रविच्छूरः सुप्रख्यातपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000465005, "chapter_id": 9465, "verse_number": "६-५८-५", "content_sanskrit": "ततः प्रहस्तं निर्यान्तं भीमं भीमपराक्रमम्।\nगर्जन्तं सुमहाकायं राक्षसैरभिसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000465006, "chapter_id": 9465, "verse_number": "६-५८-६", "content_sanskrit": "ददर्श महती सेना वानराणां बलीयसाम्।\nअभिसंजातघोषाणां प्रहस्तमभिगर्जताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000465007, "chapter_id": 9465, "verse_number": "६-५८-७", "content_sanskrit": "खड्गशक्त्यृष्टिशूलाश्च बाणानि मुसलानि च।\nगदाश्च परिघाः प्रासा विविधाश्च परश्वधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000465008, "chapter_id": 9465, "verse_number": "६-५८-८", "content_sanskrit": "धनूंषि च विचित्राणि राक्षसानां जयैषिणाम्।\nप्रगृहीतान्यराजन्त वानरानभिधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000465009, "chapter_id": 9465, "verse_number": "६-५८-९", "content_sanskrit": "जगृहुः पादपांश्चापि पुष्पितांस्तु गिरींस्तथा।\nशिलाश्च विपुला दीर्घा योद‍्धुकामाः प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000465010, "chapter_id": 9465, "verse_number": "६-५८-१०", "content_sanskrit": "तेषामन्योन्यमासाद्य संग्रामः सुमहानभूत्।\nबहूनामश्मवृष्टिं च शरवर्षं च वर्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000465011, "chapter_id": 9465, "verse_number": "६-५८-११", "content_sanskrit": "बहवो राक्षसा युद्धे बहून् वानरपुङ्गवान्।\nवानरा राक्षसांश्चापि निजघ्नुर्बहवो बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000465012, "chapter_id": 9465, "verse_number": "६-५८-१२", "content_sanskrit": "शूलैः प्रमथिताः केचित् केचित् तु परमायुधैः।\nपरिघैराहताः केचित् केचिच्छिन्नाः परश्वधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000465013, "chapter_id": 9465, "verse_number": "६-५८-१३", "content_sanskrit": "निरुच्छ्वासाः पुनः केचित् पतिता जगतीतले।\nविभिन्नहृदयाः केचिदिषुसंधानसाधिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000465014, "chapter_id": 9465, "verse_number": "६-५८-१४", "content_sanskrit": "केचिद् द्विधा कृताः खड्गैः स्फुरन्तः पतिता भुवि।\nवानरा राक्षसैः शूरैः पार्श्वतश्च विदारिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000465015, "chapter_id": 9465, "verse_number": "६-५८-१५", "content_sanskrit": "वानरैश्चापि संक्रुद्धै राक्षसौघाः समन्ततः।\nपादपैर्गिरिशृङ्गैश्च सम्पिष्टा वसुधातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000465016, "chapter_id": 9465, "verse_number": "६-५८-१६", "content_sanskrit": "वज्रस्पर्शतलैर्हस्तैर्मुष्टिभिश्च हता भृशम्।\nवमन् शोणितमास्येभ्यो विशीर्णदशनेक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000465017, "chapter_id": 9465, "verse_number": "६-५८-१७", "content_sanskrit": "आर्तस्वनं च स्वनतां सिंहनादं च नर्दताम्।\nबभूव तुमुलः शब्दो हरीणां रक्षसामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000465018, "chapter_id": 9465, "verse_number": "६-५८-१८", "content_sanskrit": "वानरा राक्षसाः क्रुद्धा वीरमार्गमनुव्रताः।\nविवृत्तवदनाः क्रूराश्चक्रुः कर्माण्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000465019, "chapter_id": 9465, "verse_number": "६-५८-१९", "content_sanskrit": "नरान्तकः कुम्भहनुर्महानादः समुन्नतः।\nएते प्रहस्तसचिवाः सर्वे जघ्नुर्वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000465020, "chapter_id": 9465, "verse_number": "६-५८-२०", "content_sanskrit": "तेषां निपततां शीघ्रं निघ्नतां चापि वानरान्।\nद्विविदो गिरिशृङ्गेण जघानैकं नरान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000465021, "chapter_id": 9465, "verse_number": "६-५८-२१", "content_sanskrit": "दुर्मुखः पुनरुत्थाय कपिः सविपुलद्रुमम्।\nराक्षसं क्षिप्रहस्तं तु समुन्नतमपोथयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000465022, "chapter_id": 9465, "verse_number": "६-५८-२२", "content_sanskrit": "जाम्बवांस्तु सुसंक्रुद्धः प्रगृह्य महतीं शिलाम्।\nपातयामास तेजस्वी महानादस्य वक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000465023, "chapter_id": 9465, "verse_number": "६-५८-२३", "content_sanskrit": "अथ कुम्भहनुस्तत्र तारेणासाद्य वीर्यवान्।\nवृक्षेण महता सद्यः प्राणान् संत्याजयद् रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000465024, "chapter_id": 9465, "verse_number": "६-५८-२४", "content_sanskrit": "अमृष्यमाणस्तत्कर्म प्रहस्तो रथमास्थितः।\nचकार कदनं घोरं धनुष्पाणिर्वनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000465025, "chapter_id": 9465, "verse_number": "६-५८-२५", "content_sanskrit": "आवर्त इव संजज्ञे सेनयोरुभयोस्तदा।\nक्षुभितस्याप्रमेयस्य सागरस्येव निःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000465026, "chapter_id": 9465, "verse_number": "६-५८-२६", "content_sanskrit": "महता हि शरौघेण राक्षसो रणदुर्मदः।\nअर्दयामास संक्रुद्धो वानरान् परमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000465027, "chapter_id": 9465, "verse_number": "६-५८-२७", "content_sanskrit": "वानराणां शरीरैस्तु राक्षसानां च मेदिनी।\nबभूवातिचिता घोरैः पर्वतैरिव संवृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000465028, "chapter_id": 9465, "verse_number": "६-५८-२८", "content_sanskrit": "सा मही रुधिरौघेण प्रच्छन्ना सम्प्रकाशते।\nसंछन्ना माधवे मासि पलाशैरिव पुष्पितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000465029, "chapter_id": 9465, "verse_number": "६-५८-२९", "content_sanskrit": "हतवीरौघवप्रां तु भग्नायुधमहाद्रुमाम्।\nशोणितौघमहातोयां यमसागरगामिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000465030, "chapter_id": 9465, "verse_number": "६-५८-३०", "content_sanskrit": "यकृत् प्लीहमहापङ्कां विनिकीर्णान्त्रशैवलाम्।\nभिन्नकायशिरोमीनामङ्गावयवशाद्वलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000465031, "chapter_id": 9465, "verse_number": "६-५८-३१", "content_sanskrit": "गृध्रहंसवराकीर्णां कङ्कसारससेविताम्।\nमेदःफेनसमाकीर्णामार्तस्तनितनिःस्वनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000465032, "chapter_id": 9465, "verse_number": "६-५८-३२", "content_sanskrit": "तां कापुरुषदुस्तारां युद्धभूमिमयीं नदीम्।\nनदीमिव घनापाये हंससारससेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000465033, "chapter_id": 9465, "verse_number": "६-५८-३३", "content_sanskrit": "राक्षसाः कपिमुख्यास्ते तेरुस्तां दुस्तरां नदीम्।\nयथा पद्मरजोध्वस्तां नलिनीं गजयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000465034, "chapter_id": 9465, "verse_number": "६-५८-३४", "content_sanskrit": "ततः सृजन्तं बाणौघान् प्रहस्तं स्यन्दने स्थितम्।\nददर्श तरसा नीलो विधमन्तं प्लवंगमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000465035, "chapter_id": 9465, "verse_number": "६-५८-३५", "content_sanskrit": "उद्‍धूत इव वायुः खे महदभ्रबलं बलात्।\nसमीक्ष्याभिद्रुतं युद्धे प्रहस्तो वाहिनीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000465036, "chapter_id": 9465, "verse_number": "६-५८-३६", "content_sanskrit": "रथेनादित्यवर्णेन नीलमेवाभिदुद्रुवे।\nस धनुर्धन्विनां श्रेष्ठो विकृष्य परमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000465037, "chapter_id": 9465, "verse_number": "६-५८-३७", "content_sanskrit": "नीलाय व्यसृजद् बाणान् प्रहस्तो वाहिनीपतिः।\nते प्राप्य विशिखा नीलं विनिर्भिद्य समाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000465038, "chapter_id": 9465, "verse_number": "६-५८-३८", "content_sanskrit": "महीं जग्मुर्महावेगा रोषिता इव पन्नगाः।\nनीलः शरैरभिहतो निशितैर्ज्वलनोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000465039, "chapter_id": 9465, "verse_number": "६-५८-३९", "content_sanskrit": "स तं परमदुर्धर्षमापतन्तं महाकपिः।\nप्रहस्तं ताडयामास वृक्षमुत्पाट्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000465040, "chapter_id": 9465, "verse_number": "६-५८-४०", "content_sanskrit": "स तेनाभिहतः क्रुद्धो नर्दन् राक्षसपुंगवः।\nववर्ष शरवर्षाणि प्लवंगानां चमूपतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000465041, "chapter_id": 9465, "verse_number": "६-५८-४१", "content_sanskrit": "तस्य बाणगणानेव राक्षसस्य दुरात्मनः।\nअपारयन् वारयितुं प्रत्यगृह्णान्निमीलितः।\nयथैव गोवृषो वर्षं शारदं शीघ्रमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000465042, "chapter_id": 9465, "verse_number": "६-५८-४२", "content_sanskrit": "एवमेव प्रहस्तस्य शरवर्षान् दुरासदान्।\nनिमीलिताक्षः सहसा नीलः सेहे दुरासदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000465043, "chapter_id": 9465, "verse_number": "६-५८-४३", "content_sanskrit": "रोषितः शरवर्षेण सालेन महता महान्।\nप्रजघान हयान् नीलः प्रहस्तस्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000465044, "chapter_id": 9465, "verse_number": "६-५८-४४", "content_sanskrit": "ततो रोषपरीतात्मा धनुस्तस्य दुरात्मनः।\nबभञ्ज तरसा नीलो ननाद च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000465045, "chapter_id": 9465, "verse_number": "६-५८-४५", "content_sanskrit": "विधनुः स कृतस्तेन प्रहस्तो वाहिनीपतिः।\nप्रगृह्य मुसलं घोरं स्यन्दनादवपुप्लुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000465046, "chapter_id": 9465, "verse_number": "६-५८-४६", "content_sanskrit": "तावुभौ वाहिनीमुख्यौ जातवैरौ तरस्विनौ।\nस्थितौ क्षतजसिक्ताङ्गौ प्रभिन्नाविव कुञ्जरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000465047, "chapter_id": 9465, "verse_number": "६-५८-४७", "content_sanskrit": "उल्लिखन्तौ सुतीक्ष्णाभिर्दंष्ट्राभिरितरेतरम्।\nसिंहशार्दूलसदृशौ सिंहशार्दूलचेष्टितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000465048, "chapter_id": 9465, "verse_number": "६-५८-४८", "content_sanskrit": "विक्रान्तविजयौ वीरौ समरेष्वनिवर्तिनौ।\nकाङ्क्षमाणौ यशः प्राप्तुं वृत्रवासवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000465049, "chapter_id": 9465, "verse_number": "६-५८-४९", "content_sanskrit": "आजघान तदा नीलं ललाटे मुसलेन सः।\nप्रहस्तः परमायत्तस्ततः सुस्राव शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000465050, "chapter_id": 9465, "verse_number": "६-५८-५०", "content_sanskrit": "ततः शोणितदिग्धाङ्गः प्रगृह्य च महातरुम्।\nप्रहस्तस्योरसि क्रुद्धो विससर्ज महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000465051, "chapter_id": 9465, "verse_number": "६-५८-५१", "content_sanskrit": "तमचिन्त्यप्रहारं स प्रगृह्य मुसलं महत्।\nअभिदुद्राव बलिनं बलान्नीलं प्लवङ्गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000465052, "chapter_id": 9465, "verse_number": "६-५८-५२", "content_sanskrit": "तमुग्रवेगं संरब्धमापतन्तं महाकपिः।\nततः सम्प्रेक्ष्य जग्राह महावेगो महाशिलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000465053, "chapter_id": 9465, "verse_number": "६-५८-५३", "content_sanskrit": "तस्य युद्धाभिकामस्य मृधे मुसलयोधिनः।\nप्रहस्तस्य शिलां नीलो मूर्ध्नि तूर्णमपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000465054, "chapter_id": 9465, "verse_number": "६-५८-५४", "content_sanskrit": "नीलेन कपिमुख्येन विमुक्ता महती शिला।\nबिभेद बहुधा घोरा प्रहस्तस्य शिरस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000465055, "chapter_id": 9465, "verse_number": "६-५८-५५", "content_sanskrit": "स गतासुर्गतश्रीको गतसत्त्वो गतेन्द्रियः।\nपपात सहसा भूमौ छिन्नमूल इव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000465056, "chapter_id": 9465, "verse_number": "६-५८-५६", "content_sanskrit": "विभिन्नशिरसस्तस्य बहु सुस्राव शोणितम्।\nशरीरादपि सुस्राव गिरेः प्रस्रवणं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000465057, "chapter_id": 9465, "verse_number": "६-५८-५७", "content_sanskrit": "हते प्रहस्ते नीलेन तदकम्प्यं महाबलम्।\nराक्षसानामहृष्टानां लङ्कामभिजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000465058, "chapter_id": 9465, "verse_number": "६-५८-५८", "content_sanskrit": "न शेकुः समवस्थातुं निहते वाहिनीपतौ।\nसेतुबन्धं समासाद्य विशीर्णं सलिलं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000465059, "chapter_id": 9465, "verse_number": "६-५८-५९", "content_sanskrit": "हते तस्मिंश्चमूमुख्ये राक्षसास्ते निरुद्यमाः।\nरक्षःपतिगृहं गत्वा ध्यानमूकत्वमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000465060, "chapter_id": 9465, "verse_number": "६-५८-६०", "content_sanskrit": "प्राप्ताः शोकार्णवं तीव्रं विसंज्ञा इव तेऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000465061, "chapter_id": 9465, "verse_number": "६-५८-६१", "content_sanskrit": "ततस्तु नीलो विजयी महाबलः\nप्रशस्यमानः सुकृतेन कर्मणा।\nसमेत्य रामेण सलक्ष्मणेन\nप्रहृष्टरूपस्तु बभूव यूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000465062, "chapter_id": 9465, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]