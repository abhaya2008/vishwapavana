[{"id": 2118830, "chapter_id": 3553, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2118831, "chapter_id": 3553, "verse_number": "१", "content_sanskrit": "तथा शैलनिपातेन धर्षिताः खाण्डवालयाः ।\nदानवा राक्षसा नागास्तरक्ष्वृक्षवनौकसः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2118832, "chapter_id": 3553, "verse_number": "२", "content_sanskrit": "द्विपाः प्रभिन्नाः शार्दूलाः सिंहाः केसरिणस्तथा ।\nमृगाश्च महिषाश्चैव शतशः पक्षिणस्तथा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2118833, "chapter_id": 3553, "verse_number": "३", "content_sanskrit": "समुद्विग्ना विससृपुस्तथाऽन्या भूतजातयः ।\nतं दावं समुदैक्षन्त कृष्णं चाभ्युद्यतायुधम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2118834, "chapter_id": 3553, "verse_number": "४", "content_sanskrit": "तत्पातनादशब्देन त्रासिता इव चाभवन् ।\nस्वतेजोभास्वरं चक्रमुत्ससर्जातिवेगवान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2118835, "chapter_id": 3553, "verse_number": "५", "content_sanskrit": "तेनार्ता जातयः क्षुद्राः सदानवनिशाचराः ।\nनिकृत्ताः शतशः पेतुरनले प्राणिनः क्षणात् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2118836, "chapter_id": 3553, "verse_number": "६", "content_sanskrit": "न्यपतन् राक्षसास्तत्र कृष्णचक्रविदारिताः ।\nवसारुधिरसम्पृक्ताः सन्ध्यायामिव तोयदाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2118837, "chapter_id": 3553, "verse_number": "७", "content_sanskrit": "पिशाचान् पक्षिणो नागान् पशूंश्चैव सहस्रशः ।\nनिघ्नंश्चरति वार्ष्णेयः कालवत् तत्र भारत \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2118838, "chapter_id": 3553, "verse_number": "८", "content_sanskrit": "क्षिप्तंक्षिप्तं पुनश्चक्रं कृष्णस्यामिततेजसः ।\nहत्वाऽनेकानि सत्वानि पाणिमेति पुनःपुनः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2118839, "chapter_id": 3553, "verse_number": "९", "content_sanskrit": "तथा तु निघ्नतस्तस्य सर्वभूतानि भारत ।\nबभूव रूपमत्युग्रं सर्वभूतात्मनस्तदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2118840, "chapter_id": 3553, "verse_number": "१०", "content_sanskrit": "समेतानां हि देवानां दानवानां च सर्वशः ।\nविजेता नाभवत् कश्चित् कृष्णपाण्डवयोर्मृधे \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2118841, "chapter_id": 3553, "verse_number": "११", "content_sanskrit": "तयोर्बलात् परित्रातुं तं च दावं यदा सुराः ।\nनाशक्नुवन् शमयितुं तदाऽभूवन् पराङ्मुखाः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2118842, "chapter_id": 3553, "verse_number": "१२", "content_sanskrit": "शतक्रतुस्तु सम्प्रेक्ष्य विमुखान् देवतागणान् ।\nबभूवावस्थितः प्रीतः प्रशंसन् कृष्णपाण्डवौ \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2118843, "chapter_id": 3553, "verse_number": "१३", "content_sanskrit": "विनिवृत्तेषु देवेषु वागुवाचाशरीरिणी ।\nशतक्रतुमभिप्रेक्ष्य तदा गम्भीरनिस्वना \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2118844, "chapter_id": 3553, "verse_number": "१४", "content_sanskrit": "न ते सखा सन्निहितस्तक्षकः पन्नगोत्तमः ।\nदाहकाले खाण्डवस्य कुरुक्षेत्रं गतो ह्यसौ \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2118845, "chapter_id": 3553, "verse_number": "१५", "content_sanskrit": "न च शक्यौ त्वया जेतुं युद्धेऽस्मिन् समवस्थितौ ।\nवासुदेवार्जुनौ शक्र निबोधेदं वचो मम \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2118846, "chapter_id": 3553, "verse_number": "१६", "content_sanskrit": "नरनारायणावेतौ तावेतौ लोकभावनौ ।\nभवानप्यभिजानाति यद्वीर्यौ यत्पराक्रमौ \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2118847, "chapter_id": 3553, "verse_number": "१७", "content_sanskrit": "नैतौ शक्यौ दुराधर्षौ विजेतुममरैरपि ।\nअपि सर्वेषु लोकेषु पुरणावृषिसत्तमौ \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2118848, "chapter_id": 3553, "verse_number": "१८", "content_sanskrit": "पूजनीयतमावेतावपि सर्वैः सुरासुरैः ।\nसयक्षरक्षोगन्धर्वैर्गुह्यकिन्नरपन्नगैः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2118849, "chapter_id": 3553, "verse_number": "१९", "content_sanskrit": "तस्मादितः सुरैः सार्धं गन्तुमर्हसि वासव ।\nदिष्टं चाप्यनुपश्यैतत् खाण्डवस्य च नाशनम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2118850, "chapter_id": 3553, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2118851, "chapter_id": 3553, "verse_number": "समाप्तिः", "content_sanskrit": "इति वाक्यमुपश्रुत्य तथ्यमित्यमरेश्वरः ।\nरोषामर्षौ समुत्सृज्य सम्प्रतस्थे दिवं तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2118852, "chapter_id": 3553, "verse_number": "२१", "content_sanskrit": "सम्प्रस्थितं महात्मानं सर्व एव दिवौकसः ।\nत्वरिताः सहिता राजन्ननुजम्मुः शतक्रतुम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2118853, "chapter_id": 3553, "verse_number": "२२", "content_sanskrit": "देवराजं तथा यान्तं सह देवैरुदीक्ष्य तु ।\nवासुदेवार्जुनौ वीरौ सिंहनादं विनेदतुः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2118854, "chapter_id": 3553, "verse_number": "२३", "content_sanskrit": "देवराजे गते राजन् प्रहृष्टौ कृष्णपाण्डवौ ।\nनिर्विशङ्कौ पुनर्दावं दाहयामासतुस्तदा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2118855, "chapter_id": 3553, "verse_number": "२४", "content_sanskrit": "स मारुत इवाभ्राणि नाशयित्वाऽर्जुनः सुरान् ।\nव्यधमच्छरसम्पातैः प्राणिनः खाण्डवालयान् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2118856, "chapter_id": 3553, "verse_number": "२५", "content_sanskrit": "न च स्म किञ्चिच्छक्तोऽभूद् भूतं निश्चरितुं ततः ।\nसञ्छाद्यमानमिषुभिरस्यता सव्यसाचिना \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2118857, "chapter_id": 3553, "verse_number": "२६", "content_sanskrit": "नाशकंश्चापि भूतानि महात्मानं रणेऽर्जुनम् ।\nनिरीक्षितुममोघेषुं करिष्यन्ति कुतो रणम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2118858, "chapter_id": 3553, "verse_number": "२७", "content_sanskrit": "शतेनैकं च विव्याध शतं चैकेन पत्रिणा ।\nव्यसवस्ते पतन्त्यग्नौ साक्षात् कालहता इव \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2118859, "chapter_id": 3553, "verse_number": "२८", "content_sanskrit": "न चालभन्त ते शर्म रोधःसु विषमेषु च ।\nपितृदेवनिवासेषु सन्तापश्चैव जायते \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2118860, "chapter_id": 3553, "verse_number": "२९", "content_sanskrit": "भूतसङ्घसहस्राणि दीनाश्चक्रुर्महास्वनम् ।\nरुरुदुर्दारुणं चैव तथान्ये मृगपक्षिणः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2118861, "chapter_id": 3553, "verse_number": "३०", "content_sanskrit": "तेन शब्देन वित्रेसुर्गङ्गोदधिचरा झषाः ।\nअप्सु न व्यचरंश्चैव तथाऽन्ये मृगपक्षिणः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2118862, "chapter_id": 3553, "verse_number": "३१", "content_sanskrit": "न ह्यर्जुनं महाबाहुं नापि कृष्णं महाबलम् ।\nनिरीक्षितुं च शक्नोति कश्चिद् योद्धुं कुतः पुनः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2118863, "chapter_id": 3553, "verse_number": "३२", "content_sanskrit": "एकायनगता येऽपि उत्पतन्त्यत्र केचन ।\nराक्षसान् दानवान् नागान् जघ्ने चक्रेण तान् हरिः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2118864, "chapter_id": 3553, "verse_number": "३३", "content_sanskrit": "ते तु भिन्नशिरोदेहाश्चक्रवेगाद् गतासवः ।\nपेतुरास्ये महाकायाः दीप्तस्य वसुरेतसः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2118865, "chapter_id": 3553, "verse_number": "३४", "content_sanskrit": "समांसरुधिरौघैश्च मेदौघैश्च समीरितः ।\nउपर्याकाशगो वह्निर्विधूम इव दृश्यते \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2118866, "chapter_id": 3553, "verse_number": "३५", "content_sanskrit": "दीप्ताक्षो दीप्तजिह्वश्च दीप्तव्यात्तमहाननः ।\nदीप्तोर्ध्वकेशः पिङ्गाक्षो विष्वक् प्राणभृतां वरः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2118867, "chapter_id": 3553, "verse_number": "३६", "content_sanskrit": "तां स कृष्णार्जुनकृतां सुधां प्राप्य हुताशनः ।\nबभूव मुदितः सद्यः परां निर्वृतिमागतः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2118868, "chapter_id": 3553, "verse_number": "३७", "content_sanskrit": "अथाऽसुरं मयं नाम तक्षकस्य निवेशनात् ।\nविप्रद्रवन्तं सहसा ददर्श मधुसूदनः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2118869, "chapter_id": 3553, "verse_number": "३८", "content_sanskrit": "तमग्निः प्रार्थयामास दिधक्षुर्वातसारथिः ।\nदेहवान् वै जटी भूत्वा नर्दंश्च जलदो यथा \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2118870, "chapter_id": 3553, "verse_number": "३९", "content_sanskrit": "जिघांसुर्वासुदेवश्च चक्रमुद्यम्य विष्ठितः ।\nस चक्रमुद्यतं दृष्ट्वा दिधक्षुं च हुताशनम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2118871, "chapter_id": 3553, "verse_number": "४०", "content_sanskrit": "अभिधायार्जुनेत्येवं मयश्चुक्रोश भारत ।\nतस्य भीतस्वनं श्रुत्वा मा भैरिति धनञ्जयः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2118872, "chapter_id": 3553, "verse_number": "४१", "content_sanskrit": "प्रत्युवाच मयं पार्थो जीवयन्निव भारत ।\nयं न भेतव्यमित्याह मयं पार्थो दयापरः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2118873, "chapter_id": 3553, "verse_number": "४२", "content_sanskrit": "तं पार्थेनाभये दत्ते नमुचेर्भ्रातरं मयम् ।\nन हन्तुमैच्छद् दाशार्हः पावको न ददाह च \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2118874, "chapter_id": 3553, "verse_number": "४३", "content_sanskrit": "तद्वनं पावको धीमान् दिनानि दश पञ्च च ।\nददाह कृष्णपार्थाभ्यां रक्षितः पाकशासनात् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2118875, "chapter_id": 3553, "verse_number": "४४", "content_sanskrit": "तस्मिन् वने दह्यमाने षडग्निर्न ददाह च ।\nअश्वसेनं मयं चैव चतुरः शार्ङ्गकांस्तथा \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2118876, "chapter_id": 3553, "verse_number": "१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nद्वात्रिंशत्यधिकद्विशततमोऽध्यायः ॥२३२॥ इति मयदर्शने प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]