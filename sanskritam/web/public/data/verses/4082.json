[{"id": 2142996, "chapter_id": 4082, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142997, "chapter_id": 4082, "verse_number": "१", "content_sanskrit": "अथैनां रूपिणी साध्वीमुपातिष्ठदुपश्रुतिः ।\nतां वयोरूपसम्पन्नां दृष्ट्वा देवीमुपस्थिताम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142998, "chapter_id": 4082, "verse_number": "२", "content_sanskrit": "इन्द्राणी सम्प्रहृष्टात्मा सम्पूज्यैनामथाब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142999, "chapter_id": 4082, "verse_number": "३", "content_sanskrit": "इच्छामि त्वामहं ज्ञातुं का त्वं ब्रूहि वरानने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2143000, "chapter_id": 4082, "verse_number": "", "content_sanskrit": "उपश्रुतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2143001, "chapter_id": 4082, "verse_number": "४", "content_sanskrit": "उपश्रुतिरहं देवि तवान्तिकमुपागता ।\nदर्शनं चैव सम्प्राप्ता तव सत्येन भामिनि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2143002, "chapter_id": 4082, "verse_number": "५", "content_sanskrit": "पतिव्रता च युक्ता च यमेन नियमेन च ।\nदर्शयिष्यामि ते शक्रं देवं वृत्रनिषूदनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2143003, "chapter_id": 4082, "verse_number": "६", "content_sanskrit": "क्षिप्रमन्वेहि भद्रं ते द्रक्ष्यसे सुरसत्तमम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2143004, "chapter_id": 4082, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2143005, "chapter_id": 4082, "verse_number": "७", "content_sanskrit": "ततस्तां प्रस्थितां देवीम् इन्द्राणी सा समन्वगात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2143006, "chapter_id": 4082, "verse_number": "८", "content_sanskrit": "देवारण्यान्यतिक्रम्य पर्वतांश्च बहूंस्ततः ।\nहिमवन्तमतिक्रम्य उत्तरं पार्श्वमागमत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2143007, "chapter_id": 4082, "verse_number": "९", "content_sanskrit": "समुद्रं च समासाद्य बहुयोजनविस्तृतम् ।\nआससाद महाद्वीपं नानाद्रुमलतायुतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2143008, "chapter_id": 4082, "verse_number": "१०", "content_sanskrit": "तत्रापश्यत् सरो दिव्यं नानाशकुनिभिर्वृतम् ।\nशतयोजनविस्तीर्णं तावदेवायतं शुभम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2143009, "chapter_id": 4082, "verse_number": "११", "content_sanskrit": "तत्र दिव्यानि पद्मानि पञ्चवर्णानि भारत ।\nषट्पदैरुपगीतानि प्रफुल्लानि सहस्रशः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2143010, "chapter_id": 4082, "verse_number": "१२", "content_sanskrit": "पद्मस्य भित्त्वा नाळं च विवेश सहिता तया ।\nबिसतन्तुप्रविष्टं च तत्रापश्यच्छतक्रतुम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2143011, "chapter_id": 4082, "verse_number": "१३", "content_sanskrit": "तं दृष्ट्वा च सुसूक्ष्मेण रूपेणावस्थितं प्रभुम् ।\nसूक्ष्मरूपधरा देवी बभूवोपश्रुतिश्च सा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2143012, "chapter_id": 4082, "verse_number": "१४", "content_sanskrit": "इन्द्रं तुष्टाव चेन्द्राणी विश्रुतैः पूर्वकर्मभिः ।\nस्तूयमानस्ततो देवः शचीमाह पुरन्दरः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2143013, "chapter_id": 4082, "verse_number": "१५", "content_sanskrit": "किमर्थमसि सम्प्राप्ता विज्ञातश्च कथं त्वहम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2143014, "chapter_id": 4082, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2143015, "chapter_id": 4082, "verse_number": "१६", "content_sanskrit": "ततः सा कथयामास नहुषस्य विचेष्टितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2143016, "chapter_id": 4082, "verse_number": "१७", "content_sanskrit": "इन्द्रत्वं त्रिषु लोकेषु प्राप्य वीर्यसमन्वितः ।\nदर्पाविष्टश्च दुष्टात्मा मामुवाच शतक्रतो\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2143017, "chapter_id": 4082, "verse_number": "१८", "content_sanskrit": "उपतिष्ठेति स क्रूरः कालं च कृतवान् मम ।\nयदि न त्रास्यसि विभो करिष्यति स मां वशे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2143018, "chapter_id": 4082, "verse_number": "१९", "content_sanskrit": "एतेन चाहं सम्प्राप्ता नूनं शक्र तवान्तिकम् ।\nजहि रौद्रं महाबाहो नहुषं पापनिश्चयम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2143019, "chapter_id": 4082, "verse_number": "२०", "content_sanskrit": "प्रकाशयात्मनाऽऽत्मानं दैत्यदानवसूदन ।\nतेजः समाप्नुहि विभो देवराज्यं प्रशाधि च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2143020, "chapter_id": 4082, "verse_number": "२१", "content_sanskrit": "यथैव च महाराज त्वया वृत्रो निषूदितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2143021, "chapter_id": 4082, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुर्दशोऽध्यायः ॥१४॥ सेनोद्योगपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]