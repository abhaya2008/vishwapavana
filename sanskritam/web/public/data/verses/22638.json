[{"id": 7002638000, "chapter_id": 22638, "verse_number": "६-१६-१", "content_sanskrit": "सूत उवाच ।\nपुनः प्राह स वैतालो भूपतिं ज्ञानकोविदम् ।\nचंद्रशेखरभूपस्य नगरी दक्षिणे स्थिता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002638001, "chapter_id": 22638, "verse_number": "६-१६-२", "content_sanskrit": "रत्नदत्तोवसद्वैश्यो धर्मज्ञो धनधान्यवान् ।\nकामावरूथिनी तस्य सुता जाता महोत्तमा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002638002, "chapter_id": 22638, "verse_number": "६-१६-३", "content_sanskrit": "तद्रूपमुत्तमं दृष्ट्वा स वैश्यो भूपतिं प्रति ।\nउवाच भो महाराज सुता मम सुरेप्सिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002638003, "chapter_id": 22638, "verse_number": "६-१६-४", "content_sanskrit": "तां गृहाण कृपासिंधो त्वद्योग्या विधिनिर्मिता ।\nइति श्रुत्वा तु वचनं भूपतिश्चंद्रशेखरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002638004, "chapter_id": 22638, "verse_number": "६-१६-५", "content_sanskrit": "मंत्रिणं विदुरं प्राह त्वं च गच्छ महामते ।\nयथायोग्यं हि तद्रूपं मां निवेदय सत्वरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002638005, "chapter_id": 22638, "verse_number": "६-१६-६", "content_sanskrit": "इत्युक्त्वा स ययौ गेहं भूपतिश्चंद्रशेखरः ।\nश्यामला नाम तत्पत्नी ज्ञात्वा राजानमागतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002638006, "chapter_id": 22638, "verse_number": "६-१६-७", "content_sanskrit": "धूपदीपादिभिः पुष्पैर्यथायोग्यैः समार्चयत् ।\nएतस्मिन्नेव काले तु गौश्च शार्दूलपीडिता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002638007, "chapter_id": 22638, "verse_number": "६-१६-८", "content_sanskrit": "हंभाशब्देन महता विललाप भयातुरा ।\nतच्छ्रुत्वा स तु भूपालः खड्गहस्तः समभ्यगात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002638008, "chapter_id": 22638, "verse_number": "६-१६-९", "content_sanskrit": "शीघ्रं हत्वा तु शार्दूलं मुमोद नृपतिस्तदा ।\nमुकुलो दानवो नाम तद्देहाद्रूपमाप्तवान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002638009, "chapter_id": 22638, "verse_number": "६-१६-१०", "content_sanskrit": "भूपतिं प्राह नम्रात्मा धर्मज्ञं चंद्रशेखरम् ।\nत्वया विमोचितो नाथ यास्यामि वरुणालयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002638010, "chapter_id": 22638, "verse_number": "६-१६-११", "content_sanskrit": "प्रह्रादस्यैव शापेन व्याघ्रदेहत्वमागतः ।\nपरिक्रम्य ययौ दैत्यः प्रह्लादं प्रति सत्वरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002638011, "chapter_id": 22638, "verse_number": "६-१६-१२", "content_sanskrit": "नृपतिर्गृहमागत्य सुष्वाप परया मुदा ।\nप्रभाते बोधितो राजा सभायां स्वयमागमत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002638012, "chapter_id": 22638, "verse_number": "६-१६-१३", "content_sanskrit": "नृपोक्तः स ययौ तत्र यत्र कामावरूथिनी ।\nदिव्यमूर्तिमयीं दृष्ट्वाचिंतयत्स स्वमानसे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002638013, "chapter_id": 22638, "verse_number": "६-१६-१४", "content_sanskrit": "अस्या मूर्तिप्रभावेन राजासौ मोहमाप्स्यति ।\nइति ज्ञात्वा नृपं प्राह सैव त्वद्योग्यका न हि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002638014, "chapter_id": 22638, "verse_number": "६-१६-१५", "content_sanskrit": "तथा मत्वा स नृपतिर्न विवाहमथाकरोत् ।\nरत्नदत्तस्य भूपस्य सेनायाः पतये ददौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002638015, "chapter_id": 22638, "verse_number": "६-१६-१६", "content_sanskrit": "बलभद्रस्य सा पत्नी बभूव वरवर्णिनी ।\nएकदा नृपतिस्तां वै दृष्ट्वा कामावथरूथिनीम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002638016, "chapter_id": 22638, "verse_number": "६-१६-१७", "content_sanskrit": "मोहितः कामबाणेन मूर्च्छितः पतितो भुवि ।\nतदा सेनापतिस्तूर्णं नृपमुत्थाप्य सत्वरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002638017, "chapter_id": 22638, "verse_number": "६-१६-१८", "content_sanskrit": "शिबिकां चैव संस्थाप्य सभायां च समैरयत् ।\nतदा प्रबुद्धो नृपतिः प्राह सेनापतिं मुदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002638018, "chapter_id": 22638, "verse_number": "६-१६-१९", "content_sanskrit": "कस्येयं सुन्दरी भार्या कुतो जाता महोत्तमा ।\nबलभद्रस्तु तच्छ्रुत्वा नृपतिं प्राह नम्रधीः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002638019, "chapter_id": 22638, "verse_number": "६-१६-२०", "content_sanskrit": "ममेयं सुन्दरी नारी रत्नदत्तस्य सा सुता ।\nराज्यभंगभयान्मन्त्री न रूपं त्वयि वर्णिवान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002638020, "chapter_id": 22638, "verse_number": "६-१६-२१", "content_sanskrit": "मम दासस्य या पत्नी त्वद्योग्या भूपते सदा ।\nतवेच्छां पूरयिष्यामि तां गृहाण कृपानिधे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002638021, "chapter_id": 22638, "verse_number": "६-१६-२२", "content_sanskrit": "इत्युक्तः क्रोधताम्राक्षो भूपतिस्तमुवाच ह ।\nतवेयं धर्मतो भार्या प्राप्ता सुन्दररूपिणी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002638022, "chapter_id": 22638, "verse_number": "६-१६-२३", "content_sanskrit": "गृह्णामि यदि तां देवीं नरके यमकिंकराः ।\nपातयित्वा महादुःखं भजयिष्यन्ति तर्हि भोः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002638023, "chapter_id": 22638, "verse_number": "६-१६-२४", "content_sanskrit": "इत्युक्त्वा भूपतिस्तूर्णं विरहाग्निप्रपीडितः ।\nमरणं प्राप्तवान्राजा गतो धर्मपुरांतिके ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002638024, "chapter_id": 22638, "verse_number": "६-१६-२५", "content_sanskrit": "इत्युक्त्वा स तु वैतालो नृपं प्राह शृणुष्व भोः ।\nमृते राजनि तत्पत्नी सती भूत्वा प्रदृश्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002638025, "chapter_id": 22638, "verse_number": "६-१६-२६", "content_sanskrit": "सेनापतिस्तु तत्रैव भस्मसादभवत्क्षणात् ।\nकामावरूथिनी देवी भस्म कृत्वा कलेवरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002638026, "chapter_id": 22638, "verse_number": "६-१६-२७", "content_sanskrit": "स्वर्गं गतास्तु ते सर्वे कस्य पुण्याधिकं मतम् ।\nस होवाच च वैतालं राजा धर्माधिको मतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002638027, "chapter_id": 22638, "verse_number": "६-१६-२८", "content_sanskrit": "मरणं किंकरस्यैव योग्यं भूपतिहेतवे ।\nपतिव्रताया मरणं पतिसंगेन योग्यकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002638028, "chapter_id": 22638, "verse_number": "६-१६-२९", "content_sanskrit": "दत्ता यत्किंकरेणैव सुंदरी नृपहेतवे ।\nधर्मभीत्या न नृपतिस्तामगृह्णात्स कामुकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002638029, "chapter_id": 22638, "verse_number": "६-१६-३०", "content_sanskrit": "जित्वा कामं तथा पाल्यं धर्मं तस्मान्नृपेऽधिकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]