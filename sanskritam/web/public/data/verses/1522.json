[{"id": 2024396, "chapter_id": 1522, "verse_number": "३-१६०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024397, "chapter_id": 1522, "verse_number": "३-१६०-१", "content_sanskrit": "युधिष्ठिरस्तमासाद्य तपसा दग्धकिल्बिषम्।\nअभ्यवादयत प्रीतः शिरसा नाम कीर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024398, "chapter_id": 1522, "verse_number": "३-१६०-२", "content_sanskrit": "ततः कृष्णा च भीमश्च यमौ च सुतपस्विनौ।\nशिरोभिः प्राप्य राजर्षिं परिवार्योपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024399, "chapter_id": 1522, "verse_number": "३-१६०-३", "content_sanskrit": "तथैव धौम्यो धर्मज्ञः पाण्डवानां पुरोहितः।\nयथान्यायमुपाक्रान्तस्तमृषिं संशितव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024400, "chapter_id": 1522, "verse_number": "३-१६०-४", "content_sanskrit": "अन्वजानात्स धर्मज्ञो मुनिर्दिव्येन चक्षुषा।\nपाण्डोः पुत्रान्कुरुश्रेष्ठानास्यतामिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024401, "chapter_id": 1522, "verse_number": "३-१६०-५", "content_sanskrit": "कुरूणामृपभं प्राज्ञं पूजयित्वा महातपाः।\nसह भ्रातृभिरसीनं पर्यपृच्छदनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024402, "chapter_id": 1522, "verse_number": "३-१६०-६", "content_sanskrit": "नानृते कुरुपे भावं कच्चिद्धर्मे प्रवर्तसे।\nमातापित्रोश्च ते वृत्तिः कच्चित्पार्थ न सीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024403, "chapter_id": 1522, "verse_number": "३-१६०-७", "content_sanskrit": "कच्चित्ते गुरवः सर्वे वृद्धा वैद्याश्च पूजिताः।\nकच्चिन्न कुरुपे भावं पार्थ पापेषु कर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024404, "chapter_id": 1522, "verse_number": "३-१६०-८", "content_sanskrit": "सुकृतंप्रतिकर्तुं च कच्चिद्धातुं च दुष्कृतम्।\nयथान्यायं कुरुश्रष्ठ जानासि न विकत्थसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024405, "chapter_id": 1522, "verse_number": "३-१६०-९", "content_sanskrit": "यथार्हं मानिताः कच्चित्त्वया नन्दन्ति साधवः।\nवनेष्वपि वसन्कच्चिद्धर्ममेवानुवर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024406, "chapter_id": 1522, "verse_number": "३-१६०-१०", "content_sanskrit": "कच्चिद्धौम्यस्त्वदाचारैर्न पार्थ परितप्यते।\nदानधर्मतपःशौचैरार्जवेन तितिक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024407, "chapter_id": 1522, "verse_number": "३-१६०-११", "content_sanskrit": "पितृपैतामहं वृत्तं कच्चित्पार्थानुवर्तसे।\nकच्चिद्राजर्षियातेन पथा गच्छसि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024408, "chapter_id": 1522, "verse_number": "३-१६०-१२", "content_sanskrit": "स्वेस्वे किल कुले जाते पुत्रे नप्तरि वा पुनः।\nपितरः पितृलोकस्थाः शोचन्ति च रमन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024409, "chapter_id": 1522, "verse_number": "३-१६०-१३", "content_sanskrit": "किं तस्य दुष्कृतेऽस्माभिः संप्राप्तव्यं भविष्यति।\nकिं चास्य सुकृतेऽस्माभिः प्राप्तव्यमिति शोभनं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024410, "chapter_id": 1522, "verse_number": "३-१६०-१४", "content_sanskrit": "पिता माता तथैवाग्निर्गुरुरात्मा च पञ्चमः।\nयस्यैतेपूजिताः पार्थ तस् लोकावुभौ जितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024411, "chapter_id": 1522, "verse_number": "३-१६०-१५x", "content_sanskrit": "[युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024412, "chapter_id": 1522, "verse_number": "३-१६०-१५", "content_sanskrit": "भगवन्नार्य माऽऽहैतद्यथावद्धर्मनिश्चयम्।\nयथाशक्ति यथान्यायं क्रियते विधिवन्मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024413, "chapter_id": 1522, "verse_number": "३-१६०-१६x", "content_sanskrit": "आर्ष्टिषेण उवाच।]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024414, "chapter_id": 1522, "verse_number": "३-१६०-१६", "content_sanskrit": "अब्भक्षा वायुभक्षाश्च प्लवमाना विहायसा।\nजुषन्ते पर्वतश्रेष्ठमृषयः पर्वसन्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024415, "chapter_id": 1522, "verse_number": "३-१६०-१७", "content_sanskrit": "कामिनः सह कान्ताभिः परस्परमनुव्रताः।\nदृश्यन्ते शैलशृङ्गस्था यथा किंपुरुषा नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024416, "chapter_id": 1522, "verse_number": "३-१६०-१८", "content_sanskrit": "अरजांसि च वासांसि वसानाः कौशिकानि च।\nदृश्यन्ते बहवः पार्थ गन्धर्वाप्सरसां गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024417, "chapter_id": 1522, "verse_number": "३-१६०-१९", "content_sanskrit": "विद्याधरगणाश्चैव स्रग्विणः प्रियदर्शनाः।\nमहोरगगणाश्चैव सुपर्णाश्चारणादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024418, "chapter_id": 1522, "verse_number": "३-१६०-२०", "content_sanskrit": "अस्य चोपरि शैलस्य श्रूयते पर्वसन्धिषु।\nभेरीपणवशङ्खानां मृदङ्गानां च निःखनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024419, "chapter_id": 1522, "verse_number": "३-१६०-२१", "content_sanskrit": "इहस्थैरेव तत्सर्वं श्रोतव्यं भरतर्षभाः।\nन कार्या वः कथंचित्स्यात्तत्राभिगमने मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024420, "chapter_id": 1522, "verse_number": "३-१६०-२२", "content_sanskrit": "न चाप्यतः परं शक्यं गन्तुं भरतसत्तमाः।\nविहारस्तत्र देवानाममानुषगतिस्तु सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024421, "chapter_id": 1522, "verse_number": "३-१६०-२३", "content_sanskrit": "ईषच्चपलकर्माणं मनुष्यमिह भारत।\nद्विषन्ति सर्वभूतानि ताडयन्ति च राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024422, "chapter_id": 1522, "verse_number": "३-१६०-२४", "content_sanskrit": "अस्यातिक्रम्य शिखरं कैलासस्य युधिष्ठिर।\nगतिः परमसिद्धानां देवर्षीणां प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024423, "chapter_id": 1522, "verse_number": "३-१६०-२५", "content_sanskrit": "चापलाद्धि न गन्तव्यं पार्त यानैस्ततः परम्।\nअयःशूलादिभिर्घ्नन्ति राक्षसाः शत्रुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024424, "chapter_id": 1522, "verse_number": "३-१६०-२६", "content_sanskrit": "अप्सरोभिः परिवृतः समृद्ध्या नरवाहनः।\nइह वैश्रवणस्तात पर्वसन्धिषु दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024425, "chapter_id": 1522, "verse_number": "३-१६०-२७", "content_sanskrit": "शिखरे तं समासीनमधिपं यक्षरक्षसाम्।\nप्रेक्षन्ते सर्वभूतानि भानुमन्तमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024426, "chapter_id": 1522, "verse_number": "३-१६०-२८", "content_sanskrit": "देवदानवसिद्धानां तथा वैश्रवणस्य च।\nगिरेः शिखरमुद्यानमिदं भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024427, "chapter_id": 1522, "verse_number": "३-१६०-२९", "content_sanskrit": "उपासीनस्य धनदं तुम्बुरोः पर्वसन्धिषु।\nगीतसामस्वनस्तात श्रूयते गन्धमादने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024428, "chapter_id": 1522, "verse_number": "३-१६०-३०", "content_sanskrit": "एतदेवंविधं चित्रमिह तात युधिष्ठिर।\nप्रेक्षन्ते सर्वभूतानि बहुशः पर्वसन्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024429, "chapter_id": 1522, "verse_number": "३-१६०-३१", "content_sanskrit": "भुञ्जाना मुनिभोज्यानि रसवन्ति फलानि च।\nवसध्वं पाण्डवश्रेष्ठा यावदर्जुनदर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024430, "chapter_id": 1522, "verse_number": "३-१६०-३२", "content_sanskrit": "न तात चपलैर्भाव्यमिह प्राप्तैः कथंचन।\n`चपलः सर्वभूतानां द्वेष्यो भवति मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024431, "chapter_id": 1522, "verse_number": "३-१६०-३३", "content_sanskrit": "उषित्वेह यथाकामं यथाश्रद्धं विहृत्य च।\nततः शस्त्रजितां श्रेष्ठ पृथिवीं पालयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024432, "chapter_id": 1522, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणिः यक्षयुद्धपर्वणि षष्ट्यधिकततमोऽध्यायः ॥ १६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]