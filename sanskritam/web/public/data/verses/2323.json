[{"id": 2061973, "chapter_id": 2323, "verse_number": "८-४४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061974, "chapter_id": 2323, "verse_number": "८-४४-१", "content_sanskrit": "विदार्य कर्णस्तां सेनां युधिष्ठिरमथाद्रवत्।\nरथहस्त्यश्वपत्तीनां सहस्रैः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061975, "chapter_id": 2323, "verse_number": "८-४४-२", "content_sanskrit": "नानायुधसहस्राणि प्रेरितान्यरिभिर्वृषः।\nछित्त्वा बाणशतैरुग्रैस्तानविध्यदसम्भ्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061976, "chapter_id": 2323, "verse_number": "८-४४-३", "content_sanskrit": "निचकर्त शिरांस्येषां बाहूनूरूंश्च सूतजः॥\nते हता भूतले पेतुर्भग्नाश्चान्ये विदुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061977, "chapter_id": 2323, "verse_number": "८-४४-४", "content_sanskrit": "द्रविडान्ध्रनिषादास्तु पुनः सात्यकिचोदिताः।\nप्रभ्यद्रवञ्जिघांसन्तः पत्तयः कर्णमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061978, "chapter_id": 2323, "verse_number": "८-४४-५", "content_sanskrit": "ते विबाहुशिरस्त्राणाः प्रहताः कर्णसायकैः।\nपेतुः पृथिव्यां युगपच्छिन्नं सालवनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061979, "chapter_id": 2323, "verse_number": "८-४४-६", "content_sanskrit": "एवं योधशतान्याजौ सहस्राण्ययुतानि च।\nहतानीयुर्महीं देहैर्यशसाऽपूरयन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061980, "chapter_id": 2323, "verse_number": "८-४४-७", "content_sanskrit": "अथ वैकर्तनं कर्णं रणे क्रुद्धमिवान्तकम्।\nरुरुधुः पाण्डुपाञ्चाला व्याधिं मन्त्रौषधा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061981, "chapter_id": 2323, "verse_number": "८-४४-८", "content_sanskrit": "स तान्प्रमृद्याब्यपतत्पुनरेव युधिष्ठिरम्।\nमन्त्रौषधिक्रियातीतो व्याधिरत्युल्बणो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061982, "chapter_id": 2323, "verse_number": "८-४४-९", "content_sanskrit": "स राजगृद्धिभी रुद्धः पाण्डुपाञ्चालकेकयैः।\nनाशकत्तानतिक्रान्तुं मृत्युर्ब्राह्मविदो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061983, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "ततो युधिष्ठिरः कर्णमदूरस्थं निवारितम्।\n`तैर्योधप्रमुखैर्वीरं दृष्ट्वा विव्याध सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061984, "chapter_id": 2323, "verse_number": "८-४४-११", "content_sanskrit": "कर्णः पार्थशराविद्धस्तोत्रार्दित इव द्विपः।\nप्रमथ्य सहितान्वीरान्युधिष्ठिरमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061985, "chapter_id": 2323, "verse_number": "८-४४-१२", "content_sanskrit": "ततो युधिष्ठिरः कर्णमासाद्य जयतां वरम्।\nअब्रवीत्परवीरघ्नं क्रोधसंरक्तलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061986, "chapter_id": 2323, "verse_number": "८-४४-१३", "content_sanskrit": "कर्णकर्ण वृथादृष्टे सूतपुत्र वचः शृणु।\nसदा स्पर्धसि सङ्ग्रामे फल्गुनेन तरस्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061987, "chapter_id": 2323, "verse_number": "८-४४-१४", "content_sanskrit": "यथाऽस्मान्बाधसे नित्यं धार्तराष्ट्रमते स्थितः।\nयद्बलं यच्च ते वीर्यं प्रद्वेषो यस्तु पाण्डुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061988, "chapter_id": 2323, "verse_number": "८-४४-१५", "content_sanskrit": "तत्सर्वं दर्शयस्वाद्य पौरुषं महदास्थितः।\nयुद्धश्रद्वां च तेऽद्याहं विनेष्यामि महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061989, "chapter_id": 2323, "verse_number": "८-४४-१६", "content_sanskrit": "एवमुक्त्वा महाराज कर्णं पाण्डुसुतस्तदा।\nसुवर्णपुङ्खैर्दशभिर्विव्यादायस्मयैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061990, "chapter_id": 2323, "verse_number": "८-४४-१७", "content_sanskrit": "तं सूतपुत्रो दशभिः प्रत्यविद्ध्यदरिन्दमः।\nवत्सदन्तैर्महेष्वासः प्रहसन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061991, "chapter_id": 2323, "verse_number": "८-४४-१८", "content_sanskrit": "सोऽवज्ञाय तु निर्विद्धः सूतपुत्रेण पाण्डवः।\nप्रजज्वाल ततः क्रोधाद्धविषेव हुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061992, "chapter_id": 2323, "verse_number": "८-४४-१९", "content_sanskrit": "ज्वालामालापरिक्षिप्तो राज्ञो देहो व्यदृश्यत।\nयुगान्ते दग्धुकामस्य संवर्ताग्नेरिवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061993, "chapter_id": 2323, "verse_number": "८-४४-२०", "content_sanskrit": "ततो विस्फार्य सुमहच्चापं हेमपरिष्कृतम्।\nसमाधत्त शितं बाणं गिरीणामपि दारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061994, "chapter_id": 2323, "verse_number": "८-४४-२१", "content_sanskrit": "ततः पूर्णायतोत्कृष्टं यमदण्डनिभं शरम्।\nमुमोच त्वरितो राजा सूतपुत्रजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061995, "chapter_id": 2323, "verse_number": "८-४४-२२", "content_sanskrit": "स तु वेगवता मुक्तो बाणो वज्राशनिस्वनः।\nविवेश सहसा कर्णं सव्ये पार्श्वे महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061996, "chapter_id": 2323, "verse_number": "८-४४-२३", "content_sanskrit": "स तु तेन प्रहारेण पीडितः प्रमुमोह वै।\nस्रस्तगात्रो महाबाहुर्धनुरुत्सृज्य कम्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061997, "chapter_id": 2323, "verse_number": "८-४४-२४", "content_sanskrit": "गतासुरिव निश्चेताः शल्यस्याभिमुखोऽपतत्।\nराजाऽपि भूयो नाजघ्ने कर्णं पार्थहितेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061998, "chapter_id": 2323, "verse_number": "८-४४-२५", "content_sanskrit": "ततो हाहाकृतं सर्वं धार्तराष्ट्रबलं महत्।\nविवर्णमुखमार्तं च कर्णं दृष्ट्वा तथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061999, "chapter_id": 2323, "verse_number": "८-४४-२६", "content_sanskrit": "सिंहनादाश्च सञ्जज्ञुः क्ष्वेलाः किलकिलास्तथा।\nपाण्डवानां महाराज दृष्ट्वा राज्ञः पराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062000, "chapter_id": 2323, "verse_number": "८-४४-२७", "content_sanskrit": "प्रतिलभ्य तु राधेयः संज्ञां नातिचिरादिव।\nदध्रे राजविनाशाय मनः क्रूरपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062001, "chapter_id": 2323, "verse_number": "८-४४-२८", "content_sanskrit": "स हेमविकृतं चापं विस्फार्य विजयं महत्।\nअवाकिरदमेयात्मा पाण्डवं निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062002, "chapter_id": 2323, "verse_number": "८-४४-२९", "content_sanskrit": "ततः क्षुराभ्यां पाञ्चाल्यौ चक्ररक्षौ महात्मनः।\nजघान चन्द्रदेवं च दण्डधारं च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062003, "chapter_id": 2323, "verse_number": "८-४४-३०", "content_sanskrit": "तावुभौ धर्मराजस्य प्रवीरौ युधि भारत।\nरथाभ्याशे चकाशेते चन्द्रस्येव पुनर्वसू॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062004, "chapter_id": 2323, "verse_number": "८-४४-३१", "content_sanskrit": "युधिष्ठिरः पुनः कर्णमविद्व्यत्त्रिंशता शरैः।\nसुषेणं सत्यसेनं च त्रिभिस्त्रिभिरताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062005, "chapter_id": 2323, "verse_number": "८-४४-३२", "content_sanskrit": "शल्यं नवत्या विव्याध त्रिसप्तत्या च सूतजम्।\nतांस्तस्य गोप्तॄन्विव्याध त्रिभिस्त्रिभिरजिह्मगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062006, "chapter_id": 2323, "verse_number": "८-४४-३३", "content_sanskrit": "ततः प्रहस्याधिरथिः षष्ठ्या राजञ्शितैः शरैः।\nविद्ध्वा युधिष्ठिरं सङ्ख्ये ननादातिरथस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062007, "chapter_id": 2323, "verse_number": "८-४४-३४", "content_sanskrit": "ततः प्रवीराः पाण्डूनामभ्यधावन्नमर्षिताः।\nयुधिष्ठिरं परीप्सन्तः कर्णमभ्यर्दयञ्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062008, "chapter_id": 2323, "verse_number": "८-४४-३५", "content_sanskrit": "सात्यकिश्चेकितानश्च युयुत्सुः पाण्ड्य एव च।\nधृष्टद्युम्नः शिखण्डी च द्रौपदेयाः प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062009, "chapter_id": 2323, "verse_number": "८-४४-३६", "content_sanskrit": "यमौ च भीमसेनश्च शिशुपालस्य चात्मजः।\nकारूशा मात्स्यशेषाश्च केकयाः काशिकोसलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062010, "chapter_id": 2323, "verse_number": "८-४४-३७", "content_sanskrit": "एते च त्वरिता वीरा वसुषेणमताडयन्।\nजनमेजयश्च पाञ्चाल्यः कर्णं विव्याध सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062011, "chapter_id": 2323, "verse_number": "८-४४-३८", "content_sanskrit": "वाराहकर्णनाराचैर्नालीकैर्निशितैः शरैः।\nवत्सदन्तैर्विपाठैश्च क्षुरप्रैश्चटकामुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062012, "chapter_id": 2323, "verse_number": "८-४४-३९", "content_sanskrit": "नानाप्रहरणैश्चोग्रै रथहस्त्यश्वसादिभिः।\nसर्वतोऽभ्यद्रवत्कर्णं परिवार्य जिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062013, "chapter_id": 2323, "verse_number": "८-४४-४०", "content_sanskrit": "स पाण्डवानां प्रवरैः सर्वतः समभिद्रुतः।\nछाद्यमानः शिततैर्घोरैः स्वस्वनामाङ्कितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062014, "chapter_id": 2323, "verse_number": "८-४४-४१", "content_sanskrit": "न चचाल रणे कर्णो महेन्द्रो दानवैरिव।\n`निजघान महेष्वासान्पाञ्चालानेकविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062015, "chapter_id": 2323, "verse_number": "८-४४-४२", "content_sanskrit": "ततः पुनरमेयात्मा चेदीनां प्रवरान्दश।\nन्यहनद्भरतश्रेष्ठ कर्णो वैकर्तनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062016, "chapter_id": 2323, "verse_number": "८-४४-४३", "content_sanskrit": "तस्य बाणसहस्राणि सम्प्रपन्नानि मारिष।\nदृश्यन्ते दिक्षु सर्वासु शलभानामिव व्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062017, "chapter_id": 2323, "verse_number": "८-४४-४४", "content_sanskrit": "कर्णनामाङ्किता बाणाः स्वर्णपुङ्खाः सुतेजनाः।\nनराश्वकायान्निर्भिद्य पेतुरुर्व्यां समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062018, "chapter_id": 2323, "verse_number": "८-४४-४५", "content_sanskrit": "कर्णेनैकेन समरे चेदीनां प्रवरास्तदा।\nसृज्जयानां च सर्वेषां शतशो निहता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2062019, "chapter_id": 2323, "verse_number": "८-४४-४६", "content_sanskrit": "कर्णस्य शरसञ्छन्नं बभूव तुमुलं तमः।\nनाज्ञायत ततः किञ्चित्परेषामात्मनोऽपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2062020, "chapter_id": 2323, "verse_number": "८-४४-४७", "content_sanskrit": "तस्मिंस्तमसि भूते च क्षत्रियाणां भयङ्करे।\nविचचार महबिहुर्निर्दहन्क्षत्रियान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2062021, "chapter_id": 2323, "verse_number": "८-४४-४८", "content_sanskrit": "ततः शरमहाज्वालो वीर्योष्मा कर्णपावकः।\nनिर्दहन्पाण्डववनं चारु पर्यचरद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2062022, "chapter_id": 2323, "verse_number": "८-४४-४९", "content_sanskrit": "`ततस्तेषां महाराज पाण्डवानां महारथाः।\nसृञ्जयानां च सर्वेषां शतशोऽथ सहस्रशः।\nअस्त्रैः कर्णं महेष्वासं समन्तात्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2062023, "chapter_id": 2323, "verse_number": "८-४४-५०", "content_sanskrit": "स संवार्य महास्त्राणि महेष्वासो महात्मनाम्।\nप्रहस्य पुरुषेन्द्रस्य कर्णश्चिच्छेद कार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2062024, "chapter_id": 2323, "verse_number": "८-४४-५१", "content_sanskrit": "ततः सन्धाय नवतिं निमेषान्नतपर्वणाम्।\nबिभेद कवचं राज्ञो रणे कर्णः शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2062025, "chapter_id": 2323, "verse_number": "८-४४-५२", "content_sanskrit": "तद्वर्म हेमविकृतं रत्नचित्रं बभौ पतत्।\nसविद्युदभ्रं सवितुः श्लिष्टं वातहतं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2062026, "chapter_id": 2323, "verse_number": "८-४४-५३", "content_sanskrit": "तदङ्गात्पुरुषेन्द्रस्य भ्रष्टं वर्म व्यरोचत।\nरत्नैरलंवृतं चित्रेर्व्यभ्नं निशि यथा नभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2062027, "chapter_id": 2323, "verse_number": "८-४४-५४", "content_sanskrit": "भिन्नवर्मा शरैः पार्थो रुधिरेण समुक्षितः।\nबभासे पुरुषश्रेष्ठ उद्यन्निव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2062028, "chapter_id": 2323, "verse_number": "८-४४-५५", "content_sanskrit": "स शराचितसर्वाङ्गश्छिन्नवर्माऽथ संयुगे।\nक्षात्रं धर्मं समास्थाय सिंहनादमकुर्वत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2062029, "chapter_id": 2323, "verse_number": "८-४४-५६", "content_sanskrit": "नर्दित्वा च चिरं कालं पाण्डवो रभसो रणे।\nशक्तिं चिक्षेप वेगेन प्रदीप्तामशनीमिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2062030, "chapter_id": 2323, "verse_number": "८-४४-५७", "content_sanskrit": "तां ज्वलन्तीमिवाकाशे शक्तिं शप्तभिराशुगैः।\nभल्लैश्चिच्छेद राधेयः सा त्वशीर्यत वै रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2062031, "chapter_id": 2323, "verse_number": "८-४४-५८", "content_sanskrit": "हृदि बाह्वोर्ललाटे च क्षिप्रकारी युधिष्ठिरः।\nचतुर्भिस्तोमरैः कर्णं ताडयित्वाऽनदन्मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2062032, "chapter_id": 2323, "verse_number": "८-४४-५९", "content_sanskrit": "उद्भिन्नरुधिरः कर्णः क्रुद्वः सर्प इव श्वसन्।\nजघान सूतं पार्थस्य पार्ष्ठिं च नवभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2062033, "chapter_id": 2323, "verse_number": "८-४४-६०", "content_sanskrit": "ध्वजं चिच्छेद नृपतेस्त्रिभिर्विव्याध चैव तम्।\nइषुधी चास्य चिच्छेद रथं च तिलशोऽच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2062034, "chapter_id": 2323, "verse_number": "८-४४-६१", "content_sanskrit": "एतस्मिन्नन्तरे शूराः पाण्डवानां महारथाः।\nववृषुः शरवर्षाणि राधेयं प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2062035, "chapter_id": 2323, "verse_number": "८-४४-६२", "content_sanskrit": "सात्यकिः पञ्चविंशत्या शिखण्डी नवभिः शरैः।\nअवर्षतां महाराज राधेयं शत्रुकर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2062036, "chapter_id": 2323, "verse_number": "८-४४-६३", "content_sanskrit": "शैनेयं तु ततुः क्रुद्धः कर्णः पञ्चभिरायसैः।\nविव्याध समरे राजंस्त्रिभिश्चान्यैः शिलीमुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2062037, "chapter_id": 2323, "verse_number": "८-४४-६४", "content_sanskrit": "दक्षिणं तु भुजं तस्य त्रिभिः कर्णोऽभ्यविध्यत।\nसव्यं षोडशभिर्बाणैर्यन्तारं चास्य सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2062038, "chapter_id": 2323, "verse_number": "८-४४-६५", "content_sanskrit": "अथास्य चतुरो वाहांश्चतुर्भिर्निशितैः शरैः।\nसूतपुत्रोऽनयत्क्षिप्रं यमस्य सदनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2062039, "chapter_id": 2323, "verse_number": "८-४४-६६", "content_sanskrit": "अथापरेण भल्लेन धनुश्छित्त्वा महारथः।\nसारथेः सशिरस्त्राणं शिरः कायादपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2062040, "chapter_id": 2323, "verse_number": "८-४४-६७", "content_sanskrit": "हताश्वसूते तु रथे स्थितः स शिनिपुङ्गवः।\nशक्तिं चिक्षेप कर्णाय वैदूर्यमणिभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2062041, "chapter_id": 2323, "verse_number": "८-४४-६८", "content_sanskrit": "तामापतन्तीं सहसा द्विधा चिच्छेद भारत।\nकर्णो वै धन्विनां श्रेष्ठस्तांश्च सर्वानवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2062042, "chapter_id": 2323, "verse_number": "८-४४-६९", "content_sanskrit": "ततस्तान्निशितैर्बाणैः पाण्डवानां महारथान्।\nन्यवारयदमेयात्मा शिक्षया च बलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2062043, "chapter_id": 2323, "verse_number": "८-४४-७०", "content_sanskrit": "अर्दयित्वा शरैस्तांस्तु सिंहः क्षुद्रमृगानिव।\nपीडयन्धर्मराजानं शरैः सन्नतपर्वमिः।\nअभ्यद्रवत राधेयो धर्मपुत्रं शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2062044, "chapter_id": 2323, "verse_number": "८-४४-७१", "content_sanskrit": "ततः पार्षो ह्यपासासीद्वताश्वो हतसारथिः।\nअशक्नुवन्मुखे स्थातुं ततः कर्णस्य दुर्मनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2062045, "chapter_id": 2323, "verse_number": "८-४४-७२", "content_sanskrit": "तमभिद्रुत्य राधेयः पाण्डुपुत्रं युधिष्ठिरम्।\nअब्रवीत्प्रहसन्राजन्कुत्सयन्निव पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2062046, "chapter_id": 2323, "verse_number": "८-४४-७३", "content_sanskrit": "कथं नाम कुले जातः क्षत्रधर्मे व्यवस्थितः।\nप्रजह्यात्समरे शत्रून्प्राणान्रक्ष महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2062047, "chapter_id": 2323, "verse_number": "८-४४-७४", "content_sanskrit": "न भवान्क्षत्रधर्मेषु कुशलोऽसीति मे मतिः।\nब्राह्मे बले भवान्युक्तः स्वाध्याये यज्ञकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2062048, "chapter_id": 2323, "verse_number": "८-४४-७५", "content_sanskrit": "मा स्म युध्यस्व कौन्तेय मा स्म वीरान्समासदः।\nमा चैवं विप्रियं ब्रूहि मा च त्वं भज संयुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2062049, "chapter_id": 2323, "verse_number": "८-४४-७६", "content_sanskrit": "वक्तव्या मारिषाऽन्ये तु न वक्तव्यास्तु मादृशाः।\nमादृशान्हि ब्रुवन्युद्धे एतदन्यच्च लप्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2062050, "chapter_id": 2323, "verse_number": "८-४४-७७", "content_sanskrit": "स्वगृहं गच्छ कौन्तेय यत्र वा केशवार्जुनौ।\nन हि त्वां समरे राजन्हन्यात्कर्णः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2062051, "chapter_id": 2323, "verse_number": "८-४४-७८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2062052, "chapter_id": 2323, "verse_number": "८-४४-७८", "content_sanskrit": "वरप्रदानं कुन्त्यास्तु कर्णः स्मृत्वा महारथः।\nवधप्राप्तं तु कौन्तेयं नावधीत्पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2062053, "chapter_id": 2323, "verse_number": "८-४४-७९", "content_sanskrit": "एवमुक्त्वा ततः पार्थं विसृज्य च महाबलः।\nन्यहनत्पाण्डवीं सेनां वज्रहस्त इवासुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2062054, "chapter_id": 2323, "verse_number": "८-४४-८०", "content_sanskrit": "ततोऽपायाद्द्रुतं राजन्व्रीडन्निव नरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2062055, "chapter_id": 2323, "verse_number": "८-४४-८१", "content_sanskrit": "अथापयातं राजानं मत्वाऽन्वीयुस्तमच्युतम्।\nचेदिपाण्डवपाञ्चालाः सात्यकिश्च महारथः।\nद्रौपदेयास्तथा शूरा माद्रीपुत्रौ च पाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2062056, "chapter_id": 2323, "verse_number": "८-४४-८२", "content_sanskrit": "ततो युधिष्ठिरानीकं दृष्ट्वा कर्णः पराङ्मुखम्।\nकुरुभिः सहितो वीरः प्रहृष्टः पृष्ठतोऽन्वगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2062057, "chapter_id": 2323, "verse_number": "८-४४-८३", "content_sanskrit": "भेरीशङ्खमृदङ्गानां कार्मुकाणां च निःस्वनः।\nबभूव धार्तराष्ट्राणां सिंहनादरवस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2062058, "chapter_id": 2323, "verse_number": "८-४४-८४", "content_sanskrit": "युधिष्ठिरस्तु कौरव्य रथमारुह्य सत्वरम्।\nश्रुतकीर्तेर्महाराज दृष्ट्वा तत्कर्णविक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2062059, "chapter_id": 2323, "verse_number": "८-४४-८५", "content_sanskrit": "काल्यमानं बलं दृष्ट्वा सूतपुत्रेण मारिष।\nस्वान्योधानब्रवीत्क्रुद्वो निघ्नतैतान्किमासत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2062060, "chapter_id": 2323, "verse_number": "८-४४-८६", "content_sanskrit": "ततो राज्ञाऽभ्यनुज्ञाताः पाण्डवानां महारथाः।\nभीमसेनमुखाः सर्वे पुत्रांस्ते प्रत्युपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2062061, "chapter_id": 2323, "verse_number": "८-४४-८७", "content_sanskrit": "अभवत्तुमुलः शब्दो योधानां तत्र भारत।\nरथहस्त्यश्वपत्तीनां द्रवतां निनदो महान्।\nउद्यतप्रतिविष्टानां शस्त्राणां च ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2062062, "chapter_id": 2323, "verse_number": "८-४४-८८", "content_sanskrit": "आगच्छत प्रहरत क्षिप्रं विपरिधावत।\nइति ब्रुवाणा ह्यन्योन्यं जघ्नुर्योधा महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2062063, "chapter_id": 2323, "verse_number": "८-४४-८९", "content_sanskrit": "अभ्रच्छायेव तत्रासीच्छरवृष्टिभिरम्बरे।\nसमावृतैर्नरवरैर्निघ्नद्भिरितरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2062064, "chapter_id": 2323, "verse_number": "८-४४-९०", "content_sanskrit": "विपताकध्वजच्छत्रा व्यश्वसूतरथायुधाः।\nव्यङ्गाङ्गावयवाः पेतुः क्षितौ क्षीणाः क्षितीश्वराः।\nशिखराणीव शेलानां वज्रभिन्नानि मानिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2062065, "chapter_id": 2323, "verse_number": "८-४४-९१", "content_sanskrit": "सारोहा निहताः पेतुर्द्विपा भिन्ना महीतले।\nछिन्नभिन्नविपर्यस्तवर्मालङ्कारविग्रहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2062066, "chapter_id": 2323, "verse_number": "८-४४-९२", "content_sanskrit": "सारोहास्तुरगाः पेतुर्हतवीराः सहस्रशः।\nविप्रविद्वायुधाङ्गाश्च द्विरदा रथिभिर्हताः।\nप्रतिवीरैश्च सम्मर्दे पत्तिसङ्घाः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2062067, "chapter_id": 2323, "verse_number": "८-४४-९३", "content_sanskrit": "विशालायतताम्राक्षैः पद्मेन्दुसदृशाननैः।\nशिरोभिर्युद्धशौण्डानां सर्वतः संवृता मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2062068, "chapter_id": 2323, "verse_number": "८-४४-९४", "content_sanskrit": "यथा भुवि तथा व्योम्नि निःस्वनं शुश्रुवुर्जनाः।\nविमानेऽप्सरसां सङ्घैर्गीतवादित्रनिःस्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2062069, "chapter_id": 2323, "verse_number": "८-४४-९५", "content_sanskrit": "हतानभिमुखान्वीरान्वीरैः शतसहस्रशः।\nआरोप्यारोप्य गच्छन्ति विमानेष्वप्सरोगणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2062070, "chapter_id": 2323, "verse_number": "८-४४-९६", "content_sanskrit": "तद्दृष्ट्वा महदाश्चर्यं प्रत्यक्षं स्वर्गलिप्सया।\nप्रहृष्टमनसः शूराः क्षिप्रं जघ्नुः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2062071, "chapter_id": 2323, "verse_number": "८-४४-९७", "content_sanskrit": "रथिनो रथिभिः सार्धं चित्रं युयुधुराहवे।\nपत्तयः पत्तिभिर्नागाः सह नागैर्हयैर्हयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2062072, "chapter_id": 2323, "verse_number": "८-४४-९८", "content_sanskrit": "एवं प्रवृत्ते सङ्ग्रामे गजवाजिनरक्षये।\nसैन्येन रजसा वृत्तते स्वे स्वाञ्जघ्नुः परे परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2062073, "chapter_id": 2323, "verse_number": "८-४४-९९", "content_sanskrit": "कचाकचं युद्धमासीद्दन्तादन्ति नखानखि।\nमुष्टियुद्धं नियुद्धं च देहपाप्मविनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2062074, "chapter_id": 2323, "verse_number": "८-४४-१००", "content_sanskrit": "तथा वर्ततति सङ्ग्रमे गजवाजिनरक्षये।\nनराश्वनागदेहेभ्यः प्रसृता लोहितापगा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2062075, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "गजाश्वनरदेहान्सा व्युवाह पतितान्बहून्।\nनराश्वगजसम्बाधे नराश्वगजसादिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2062076, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "लोहितोदा महाघोरा मांसशोणितकर्दमा।\nनराश्वगजदेहान्वै वहन्ती भीरुभीषणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2062077, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "तस्या नद्याः परं पारं व्रजन्ति विजयैषिणः।\nनागेन च प्लवन्तो वै निमज्ज्योन्मज्ज्य चापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2062078, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "ते तु लोहितदिग्धाङ्गा रक्तवर्मायुधाम्बराः।\nसस्नुस्ततस्यां पपुश्चास्रं मम्लुश्च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2062079, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "रथानश्वान्नारान्नागानायुधाभरणानि च।\nवर्माणि चाप्यपश्याम पतितानि सहस्रशः।\nखं द्यां भूमिं दिशश्चैव प्रायः पश्याम लोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2062080, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "लोहितस्य तु गन्धेन स्पर्देन च रसेन च।\nरूपेण चातिरक्ततेन शब्देन च विसर्पता।\nविषादः सुमहानासीत्प्रायः सैन्यस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2062081, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "तत्तु विप्रहतं सैन्यं भीमसेनमुखैस्तव।\nभूयः समाद्रवन्वीराः सातत्यकिप्रमुखास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2062082, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "तेषामापतततां वेगमविषह्यं निरीक्ष्य च।\nपुत्राणां ते महासैन्यमासीद्राजन्पराङ्मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2062083, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "तत्प्रकीर्णरथाश्वेभं नरवाजिसमाकुलम्।\nविध्वस्तवर्मकवचं प्रविद्वायुधकार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2062084, "chapter_id": 2323, "verse_number": "८-४४-१०", "content_sanskrit": "व्यद्रवत्तावकं सैन्यं लोड्यमानं समन्ततः।\nसिंहार्दितमिवारण्ये यथा गजकुलं तथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2062085, "chapter_id": 2323, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे चतुश्चत्वारिंशोऽध्यायः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}]