[{"id": 2058565, "chapter_id": 2264, "verse_number": "७-१९१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058566, "chapter_id": 2264, "verse_number": "७-१९१-१", "content_sanskrit": "पाञ्चालानां ततो द्रोणोऽप्यकरोत्कदनं महत्।\nयथा क्रुद्धो रणे शक्रो दानवानां क्षयं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058567, "chapter_id": 2264, "verse_number": "७-१९१-२", "content_sanskrit": "द्रोणास्त्रेण महाराज वध्यमानाः परे युधि।\nनात्रसन्त रणे द्रोणत्सत्ववन्तो महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058568, "chapter_id": 2264, "verse_number": "७-१९१-३", "content_sanskrit": "युध्यमाना महाराज पाञ्चालाः सृञ्जयास्तथा।\nद्रोणमेवाभ्ययुर्युद्धे योधयन्तो महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058569, "chapter_id": 2264, "verse_number": "७-१९१-४", "content_sanskrit": "तेषां तु च्छाद्यमानानां पाञ्चालानां समन्ततः।\nअभवद्भैरवो नादो वध्यतां शरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058570, "chapter_id": 2264, "verse_number": "७-१९१-५", "content_sanskrit": "वध्यमानेषु सङ्ग्रामे पाञ्चालेषु महात्मना।\nउदीर्यमाणे द्रोणास्त्रे पाण़्डवान्भयमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058571, "chapter_id": 2264, "verse_number": "७-१९१-६", "content_sanskrit": "दृष्ट्वाऽश्वनरयोधानां विपुलं च क्षयं युधि।\nपाण़्डवेया महाराज नाशशंसुर्जयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058572, "chapter_id": 2264, "verse_number": "७-१९१-७", "content_sanskrit": "कच्चिद्द्रोणो न नः सर्वान्क्षपयेत्परमास्त्रवित्।\nसमिद्धः शिशिरापाये दहन्कक्षमिवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058573, "chapter_id": 2264, "verse_number": "७-१९१-८", "content_sanskrit": "न चैनं संयुगे कश्चित्समर्थः प्रतिवीक्षितुम्।\nन चैनमर्जुनो जातु प्रतियुध्येत धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058574, "chapter_id": 2264, "verse_number": "७-१९१-९", "content_sanskrit": "त्रस्तान्कुन्तीसुतान्दृष्ट्वा द्रोणसायकपीडितान्।\nमतिमाञ्श्रेयसे युक्तः केशवोऽर्जुनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058575, "chapter_id": 2264, "verse_number": "७-१९१-१०", "content_sanskrit": "नैष युद्धेन सङ्ग्रामे जेतुं शक्यः कथञ्चन।\nसधनुर्धन्विनां श्रेष्ठो देवैरपि सवासवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058576, "chapter_id": 2264, "verse_number": "७-१९१-११", "content_sanskrit": "न्यस्तशस्त्रस्तु सङ्गारमे शक्यो हन्तुं भवेन्नृभिः।\nआस्थीयतां जये योगो धर्ममुत्सृज्य पाण्डवाः।\nयथा न संयुगे सर्वान्निहन्याद्रुक्मवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058577, "chapter_id": 2264, "verse_number": "७-१९१-१२", "content_sanskrit": "अश्वत्थाम्नि हते नैष युध्येदिति मतिर्मम।\nतं हतं संयुगे कश्चिदस्मै शंसतु मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058578, "chapter_id": 2264, "verse_number": "७-१९१-१३", "content_sanskrit": "एतन्नारोचयद्राजन्कुन्तीपुत्रो धनञ्जयः।\nअन्ये त्वरोचयन्सर्वे कृच्छ्रेण तु युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058579, "chapter_id": 2264, "verse_number": "७-१९१-१४", "content_sanskrit": "ततो भीमो महाबाहुरनीकेषु महागजम्।\nजघान गदया राजन्नश्वत्थामानमित्युत।\nपरप्रमथनं घोरं मालवस्येन्द्रवर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058580, "chapter_id": 2264, "verse_number": "७-१९१-१५", "content_sanskrit": "भीमसेनस्तु सव्रीडमुपेत्य द्रोणमाहवे।\nअश्वत्थामा हत इति शब्दमुच्चैश्चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058581, "chapter_id": 2264, "verse_number": "७-१९१-१६", "content_sanskrit": "अश्वत्थामेति हि गजः ख्यातो नाम्ना हतोऽभवत्।\nकृत्वा मनसि तं भीमो मिथ्या व्याहृतवांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058582, "chapter_id": 2264, "verse_number": "७-१९१-१७", "content_sanskrit": "भीमसेनवचः श्रुत्वा द्रोणस्तत्परमाप्रियम्।\nमनसा सन्नागात्रोऽभूद्यथा सैकतमम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058583, "chapter_id": 2264, "verse_number": "७-१९१-१८", "content_sanskrit": "शङ्कमानः स तन्मिथ्या वीर्यज्ञः स्वसुतस्य वै।\nहतः स इति च श्रुत्वा नैव धैर्यादकम्पत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058584, "chapter_id": 2264, "verse_number": "७-१९१-१९", "content_sanskrit": "स लब्ध्वा चेतनां द्रोणः क्षणेनैव समाश्वसत्।\nअनुचिन्त्यात्मनः पुत्रमविषह्यमरातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058585, "chapter_id": 2264, "verse_number": "७-१९१-२०", "content_sanskrit": "स पार्षतमभिद्रुत्य जिघांसुर्मृत्युमात्मनः।\nअवाकिरत्सहस्रेण तीक्ष्णानां कङ्कपत्रिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058586, "chapter_id": 2264, "verse_number": "७-१९१-२१", "content_sanskrit": "तं विंशतिसहस्राणि पाञ्चालानां नरर्षभाः।\nयथा चरन्तं सङ्ग्रामे सर्वतोऽवाकिरञ्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058587, "chapter_id": 2264, "verse_number": "७-१९१-२२", "content_sanskrit": "शरैस्तैराचितं द्रोणं नापश्याम महारथम्।\nभास्करं जलदै रुद्धं वर्षास्विव विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058588, "chapter_id": 2264, "verse_number": "७-१९१-२३", "content_sanskrit": "विधूय तान्बाणगणान्पाञ्चालानां महारथः।\nप्रादुश्चक्रे ततो द्रोणो ब्राह्ममस्त्रं परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058589, "chapter_id": 2264, "verse_number": "७-१९१-२४", "content_sanskrit": "वधाय तेषां शूराणां पाञ्चालानाममर्षितः।\nततो व्यरोचत द्रोणो विनिघ्नन्सर्वसैनिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058590, "chapter_id": 2264, "verse_number": "७-१९१-२५", "content_sanskrit": "शिरांस्यापातयच्चापि पाञ्चालानां महामृधे।\nतथैव परिघाकारान्बाहून्कनकभूषणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058591, "chapter_id": 2264, "verse_number": "७-१९१-२६", "content_sanskrit": "ते वध्यमानाः समरे भारद्वाजेन पार्थिवाः।\nमेदिन्यामन्वकीर्यन्त वातनुन्ना इव द्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058592, "chapter_id": 2264, "verse_number": "७-१९१-२७", "content_sanskrit": "कुञ्जराणां च पततां हयौघानां च भारत।\nअगम्यरूपा पृथिवी मांसशोणितकर्दमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058593, "chapter_id": 2264, "verse_number": "७-१९१-२८", "content_sanskrit": "हत्वा विंशतिसाहस्रान्पाञ्चालानां रथव्रजान्।\nअतिष्ठदाहवे द्रोणो विधूमोऽग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058594, "chapter_id": 2264, "verse_number": "७-१९१-२९", "content_sanskrit": "तथैव च पुनः क्रुद्धो भारद्वाजः प्रतापवान्।\nवसुदानस्य भल्लेन शिरः कायादपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058595, "chapter_id": 2264, "verse_number": "७-१९१-३०", "content_sanskrit": "पुनः पञ्चशतान्मात्स्यान्षट्सहस्रांश्च सृञ्जयान्।\nहस्तिनामयुतं हत्वा जघानाश्वायुतं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2058596, "chapter_id": 2264, "verse_number": "७-१९१-३१", "content_sanskrit": "क्षत्रियाणामभावाय दृष्ट्वा द्रोणमवस्थितम्।\nऋषयोऽभ्यागतास्तूर्णं हव्यवाहपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2058597, "chapter_id": 2264, "verse_number": "७-१९१-३२", "content_sanskrit": "विश्वामित्रो जमदग्निर्भरद्वाजोऽथ गौतमः।\nवसिष्ठः कश्यपोऽत्रिश्च ब्रह्मलोकं निनीषवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2058598, "chapter_id": 2264, "verse_number": "७-१९१-३३", "content_sanskrit": "सिकताः पृश्नयो गर्गा वालखिल्या मरीचिपाः।\nभृगवोऽङ्गिरसश्चैव सूक्ष्माश्चान्ये महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2058599, "chapter_id": 2264, "verse_number": "७-१९१-३४", "content_sanskrit": "त एनमब्रुवन्सर्वे द्रोणमाहरवशोभिनम्।\nअधर्मतः कृतं युद्धं समयो निधनस्य ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2058600, "chapter_id": 2264, "verse_number": "७-१९१-३५", "content_sanskrit": "न्यस्यायुधं रणे द्रोण समीक्षास्मानवस्थितान्।\nनातः क्रूरतरं कर्म पुनः कर्तुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2058601, "chapter_id": 2264, "verse_number": "७-१९१-३६", "content_sanskrit": "वेदवेदाङ्गविदुषः सत्यधर्मरतस्य ते।\nब्राह्मणस्य विशेषेण तवैतन्नोपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2058602, "chapter_id": 2264, "verse_number": "७-१९१-३७", "content_sanskrit": "त्यजायुधममोधेषो तिष्ठ वर्त्मनि शाश्वते।\nपरिपूर्णश्च कालस्ते वस्तुं लोकेऽद्य मानुषे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2058603, "chapter_id": 2264, "verse_number": "७-१९१-३८", "content_sanskrit": "ब्रह्मास्त्रेण त्वया दग्धा अनस्त्रज्ञा नरा भुवि।\nयदेतदीदृशं विप्र कृतं कर्म न साधु तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2058604, "chapter_id": 2264, "verse_number": "७-१९१-३९", "content_sanskrit": "न्यस्यायुधं रणे विप्र द्रोण मा त्वं चिरं कृथाः।\nमा पापिष्ठतरं कर्म करिष्यसि पुनर्द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2058605, "chapter_id": 2264, "verse_number": "७-१९१-४०", "content_sanskrit": "इति तेषां वचः श्रुत्वा भीमसेनवचः स्मरन्।\nधृष्टद्युम्नं च सम्प्रेक्ष्य रणे स विमनाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2058606, "chapter_id": 2264, "verse_number": "७-१९१-४१", "content_sanskrit": "सन्दिह्यमानो व्यथितः कुन्तीपुत्रं युधिष्ठिरम्।\nअहतं वा हतं वेति पप्रच्छ सुतमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2058607, "chapter_id": 2264, "verse_number": "७-१९१-४२", "content_sanskrit": "स्थिरा बुद्धिर्हि द्रोणस्य न पार्थो वक्ष्यतेऽनृतम्।\nत्रयाणामपि लोकानामैश्वर्यार्थे कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2058608, "chapter_id": 2264, "verse_number": "७-१९१-४३", "content_sanskrit": "तस्मात्तं परिपप्रच्छ नान्यं कञ्छिद्द्विजर्षभः।\nतस्मिंस्तस्य हि सत्याशा बाल्यात्प्रभृति पाण्डवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2058609, "chapter_id": 2264, "verse_number": "७-१९१-४४", "content_sanskrit": "ततो निष्पाण्डवामुर्वीं करिष्यन्तं युधाम्पतिम्।\nद्रोणं ज्ञात्वा धर्मराजं गोविन्दो व्यथितोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2058610, "chapter_id": 2264, "verse_number": "७-१९१-४५", "content_sanskrit": "यद्यर्धदिवसं द्रोणो युध्यते मन्युमास्थितः।\nसत्यं ब्रवीमि ते सेना विनाशं समुपैष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2058611, "chapter_id": 2264, "verse_number": "७-१९१-४६", "content_sanskrit": "स भवांस्त्रातु नो द्रोणात्सत्याज्ज्यायोऽनृतं वचः।\nअनृतं जीवितस्यार्थे वदन्न स्पृश्यतेऽनृतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2058612, "chapter_id": 2264, "verse_number": "७-१९१-४७", "content_sanskrit": "तयोः संवदतोरेवं भीमसेनोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2058613, "chapter_id": 2264, "verse_number": "७-१९१-४८", "content_sanskrit": "श्रुत्वैवं तु महाराज वधोपायं महात्मनः।\nगाहमानस्य ते सेनां मालवस्येन्द्रवर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2058614, "chapter_id": 2264, "verse_number": "७-१९१-४९", "content_sanskrit": "अश्वत्थामेति विख्यातो गजः शक्रगजोपमः।\nनिहतो युधि विक्रम्य ततोऽहं द्रोणमब्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2058615, "chapter_id": 2264, "verse_number": "७-१९१-५०", "content_sanskrit": "अश्वत्थामा हतो ब्रह्मन्निवर्तस्वाहवादिति।\nनूनं नाश्रद्दधद्वाक्यमेष मे पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2058616, "chapter_id": 2264, "verse_number": "७-१९१-५१", "content_sanskrit": "स त्वं गोविन्दवाक्यानि मानयस्व जयैषिणः।\nद्रोणाय निहतं शंस राजञ्शारद्वतीसुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2058617, "chapter_id": 2264, "verse_number": "७-१९१-५२", "content_sanskrit": "त्वयोक्ते नैव युध्येत जातु राजन्द्विजर्षभः।\nसत्यवागिति लोकेऽस्मिन्भवान्ख्यातो जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2058618, "chapter_id": 2264, "verse_number": "७-१९१-५३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा कृष्णवाक्यप्रचोदितः।\nभावित्वाच्च महाराज वक्तुं समुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2058619, "chapter_id": 2264, "verse_number": "७-१९१-५४", "content_sanskrit": "तमतथ्यभये मग्नो जये सक्तो युधिष्ठिरः।\n`अश्वत्थामा हति शब्दमुच्चैश्चकार ह।\nअव्यक्तमब्रवीद्राजन्हतः कुञ्जर इत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2058620, "chapter_id": 2264, "verse_number": "७-१९१-५५", "content_sanskrit": "तस्य पूर्वं रथः पृथ्व्याश्चतुरङ्गुलमुच्छ्रितः।\nबभूवैवं च तेनोक्ते तस्य वाहाः स्पृशन्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2058621, "chapter_id": 2264, "verse_number": "७-१९१-५६", "content_sanskrit": "युधिष्ठिरात्तु तद्वाक्यं श्रुत्वा द्रोणो महारथः।\nपुत्रव्यसनसन्तप्तो निराशो जीवितेऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2058622, "chapter_id": 2264, "verse_number": "७-१९१-५७", "content_sanskrit": "आगस्कृतमिवात्मानं पाण्डवानां महात्मनाम्।\nऋषिवाक्येन मन्वानः श्रुत्वा च निहतं सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2058623, "chapter_id": 2264, "verse_number": "७-१९१-५८", "content_sanskrit": "विचेताः परमोद्विग्नो धृष्टद्युम्नमवेक्ष्य च।\nयोद्धुं नाशक्नुवद्राजन्यथापूर्वमरिन्दमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2058624, "chapter_id": 2264, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणवधपर्वणि पञ्चदशदिवसयुद्धे एकनवत्यधिकशततमोऽध्यायः॥ १९१ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१९१-५१ जयैषिण इत्यस्य गोविन्दवाक्यानीत्यत्रैकदेशे गोविन्देऽन्वयः॥ ५-१९१-१९१ एकनवत्यधिकशततमोऽध्यायः॥ १९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]