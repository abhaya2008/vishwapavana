[{"id": 2035488, "chapter_id": 1767, "verse_number": "५-१२-०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035489, "chapter_id": 1767, "verse_number": "५-१२-१", "content_sanskrit": "क्रुद्धं तु नहुषं दृष्ट्वा देवा ऋषिपुरोगमाः।\nअब्रुवन्देवराजानं नहुषं घोरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035490, "chapter_id": 1767, "verse_number": "५-१२-२", "content_sanskrit": "देवराज जहि क्रोधं त्वयि क्रुद्धे जगद्विभो।\nत्रस्तं सासुरगन्धर्वं सकिंनरमहोरगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035491, "chapter_id": 1767, "verse_number": "५-१२-३", "content_sanskrit": "जहि क्रोधमिमं साधो न कुप्यन्ति भवद्विधाः ।\nपरस्य पत्नी सा देवी प्रसीदस्व सुरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035492, "chapter_id": 1767, "verse_number": "५-१२-४", "content_sanskrit": "निवर्तय मनः पापात्परदाराभिमर्शनात्।\nदेवराजोऽसि भद्रं ते प्रजा धर्मेण पालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035493, "chapter_id": 1767, "verse_number": "५-१२-५", "content_sanskrit": "एवमुक्तो न जग्राह तद्वचः काममोहितः ।\nअथ देवानुवाचेदमिन्द्रं प्रति सुराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035494, "chapter_id": 1767, "verse_number": "५-१२-६", "content_sanskrit": "अहल्या धर्षिता पूर्वमृषिपत्नी यशस्विनी ।\nजीवतो भर्तुरिन्द्रेण स वः किं न निवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035495, "chapter_id": 1767, "verse_number": "५-१२-७", "content_sanskrit": "बहूनि च नृशंसानि कृतानीन्द्रेण वै पुरा ।\nवैधर्म्याण्युपधाश्चैव स वः किं न निवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035496, "chapter_id": 1767, "verse_number": "५-१२-८", "content_sanskrit": "उपतिष्ठतु देवी मामेतदस्या हितं परम्।\nयुष्माकं च सदा देवाः शिवमेवं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035497, "chapter_id": 1767, "verse_number": "५-१२-९x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035498, "chapter_id": 1767, "verse_number": "५-१२-९", "content_sanskrit": "इन्द्राणीमानयिष्यामो यथेच्छसि दिवस्पते।\nजहि क्रोधमिमं वीर प्रीतो भव सुरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035499, "chapter_id": 1767, "verse_number": "५-१२-१०x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035500, "chapter_id": 1767, "verse_number": "५-१२-१०", "content_sanskrit": "इत्युक्त्वा तं तदा देवा ऋषिभिः सह भारत।\nतग्मुर्बृहस्पतिं वक्तुमिन्द्राणीं चाशुभं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035501, "chapter_id": 1767, "verse_number": "५-१२-११", "content_sanskrit": "जानीमः शरणं प्राप्तामिन्द्राणीं तव वेश्मनि।\nदत्ताभयां च विप्रेन्द्र त्वया देवर्षिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035502, "chapter_id": 1767, "verse_number": "५-१२-१२", "content_sanskrit": "ते त्वां देवाः सगन्धर्वा ऋषयश्च महाद्युते ।\nप्रसादयन्ति चेन्द्राणी नहुषाय प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035503, "chapter_id": 1767, "verse_number": "५-१२-१३", "content_sanskrit": "इन्द्राद्विशिष्टो नहुषो देवराजो महाद्युतिः ।\nवृणोत्विमं वरारोहा भर्तृत्वे वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035504, "chapter_id": 1767, "verse_number": "५-१२-१४", "content_sanskrit": "एवमुक्ते तु सा देवी बाष्पमुत्सृज्य सस्वनम् ।\nउवाच रुदती दीना बृहस्पतिमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035505, "chapter_id": 1767, "verse_number": "५-१२-१५", "content_sanskrit": "नाहमिच्छामि नहुषं पतिं देवर्षिसत्तम।\nशरणागतास्मि ते ब्रहंस्त्रायस्व महतो भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035506, "chapter_id": 1767, "verse_number": "५-१२-१६x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035507, "chapter_id": 1767, "verse_number": "५-१२-१६", "content_sanskrit": "शरणागतं न त्यजेयमिन्द्राणि मम निश्चयः।\nधर्मज्ञां सत्यशीलां च न त्यजेयमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035508, "chapter_id": 1767, "verse_number": "५-१२-१७", "content_sanskrit": "नाकार्यं कर्तुमिच्छामि ब्राह्मणः सन्विशेषतः ।\nश्रुतधर्मा सत्यशीलो जानन्धर्मानुशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035509, "chapter_id": 1767, "verse_number": "५-१२-१८", "content_sanskrit": "नाहमेतत्करिष्यामि गच्छध्वं वै सुरोत्तमाः ।\nअस्मिंश्चार्थे पुरा गीतं ब्रह्मणा श्रूयतामिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035510, "chapter_id": 1767, "verse_number": "५-१२-१९", "content_sanskrit": "न तस्य बीजं रोहति रोहकाले\nन तस्य वर्षं वर्षति वर्षकाले।\nभीतं प्रपन्नं प्रददाति शत्रवे\nन स त्रातारं लभते त्राणमिच्छन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035511, "chapter_id": 1767, "verse_number": "५-१२-२०", "content_sanskrit": "मोघमन्नं विन्दति चाप्यचेताः\nस्वर्गाल्लोकाद्धश्यति नष्टचेष्टः।\nभीतं प्रपन्नं प्रददाति यो वै\nन तस्य हव्यं प्रतिगृह्णन्ति देवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035512, "chapter_id": 1767, "verse_number": "५-१२-२१", "content_sanskrit": "प्रमीयते चास्य प्रजा ह्यकाले\nसदा विवासं पितरोऽस्य कुर्वते।\nभीतं प्रपन्नं प्रददाति शत्रवे\nसेन्द्रा देवाः प्रहरन्त्यस्य वज्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035513, "chapter_id": 1767, "verse_number": "५-१२-२२", "content_sanskrit": "एतदेवं विजानन्वै न दास्यामि शचीमिमाम्।\nइन्द्राणीं विश्रुतां लोके शक्रस्य महिषीं प्रियां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035514, "chapter_id": 1767, "verse_number": "५-१२-२३", "content_sanskrit": "अस्या हितं भवेद्यच्च मम चापि हितं भवेत्।\nक्रियतां तत्सुरश्रेष्ठा नहि दास्याम्यहं शचीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035515, "chapter_id": 1767, "verse_number": "५-१२-२४x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2035516, "chapter_id": 1767, "verse_number": "५-१२-२४", "content_sanskrit": "अथ देवाः सगन्धर्वा गुरुमाहुरिदं वचः।\nकथं सुनीतं नु भवेन्मन्त्रयस्व बृहस्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2035517, "chapter_id": 1767, "verse_number": "५-१२-२५x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2035518, "chapter_id": 1767, "verse_number": "५-१२-२५", "content_sanskrit": "नहुषं याचतां देवी किंचित्कालान्तरं शुभा।\nइन्द्राणि हितमेतद्धि तथाऽस्माकं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2035519, "chapter_id": 1767, "verse_number": "५-१२-२६", "content_sanskrit": "बहुविघ्नः सुराः कालः कालः कालं नयिष्यति।\nगर्वितो बलवांश्चापि नहुषो वरसंश्रयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2035520, "chapter_id": 1767, "verse_number": "५-१२-२७x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2035521, "chapter_id": 1767, "verse_number": "५-१२-२७", "content_sanskrit": "ततस्तेन तथोक्ते तु प्रीता देवास्तथाब्रुवन्।\nब्रह्मन्साध्विदमुक्तं ते हितं सर्वं दिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2035522, "chapter_id": 1767, "verse_number": "५-१२-२८", "content_sanskrit": "एवमेतद्द्विजश्रेष्ठ देवी चेयं प्रसाद्यताम्।\nततः समस्ता इन्द्राणीं देवाश्चाग्निपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2035523, "chapter_id": 1767, "verse_number": "५-१२-२९", "content_sanskrit": "ऊचुर्वचनमव्यग्रा लोकानां हितकाम्यया।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2035524, "chapter_id": 1767, "verse_number": "५-१२-२९x", "content_sanskrit": "देवा ऊचुः।\nत्वया जगदिदं सर्वं धृतं स्थावरजङ्गमम्।\nएकपत्न्यसि सत्या च गच्छस्व नहुषं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2035525, "chapter_id": 1767, "verse_number": "५-१२-३०", "content_sanskrit": "क्षिप्रं त्वामभिकामश्च विनशिष्यति पापकृत्।\nनहुषो देवि शक्रश्च सुरैश्वर्यमवाप्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2035526, "chapter_id": 1767, "verse_number": "५-१२-३१", "content_sanskrit": "एवं विनिश्चयं कृत्वा इन्द्राणी कार्यसिद्धये।\nअभ्यगच्छत सव्रीडा नहुषं घोरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2035527, "chapter_id": 1767, "verse_number": "५-१२-३२", "content_sanskrit": "दृष्ट्वा तां नहुषश्चापि वयोरूपसमन्विताम् ।\nसमहृष्यत दुष्टात्मा कामोपहतचेतनः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2035528, "chapter_id": 1767, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि द्वादशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]