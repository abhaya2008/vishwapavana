[
  {
    "id": 20007151,
    "chapter_id": 6647,
    "verse_number": "17.1",
    "content_sanskrit": "इतीरिते वचसि वचस्विनामुना युगक्षयक्षुभितमरुद्गरीयसि । प्रचक्षुभे सपदि तदम्बुराशिना समं महाप्रलयसमुद्यतं सदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20007152,
    "chapter_id": 6647,
    "verse_number": "17.2",
    "content_sanskrit": "सरागया स्रुतघनघर्मतोयया कराहतिध्वनितपृथूरुपीठया । मुहुर्मुहुर्दशनविखण्डितोष्ठया रुषा नृपाः प्रियतमयेव भेजिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20007153,
    "chapter_id": 6647,
    "verse_number": "17.3",
    "content_sanskrit": "अलक्ष्यत क्षणदलिताङ्गदे गदे करोदरप्रहितनिजांसधामनि । समुल्लसच्छकलितपाटलोपलैः स्फुलिङ्गवान्स्फुटमिव कोपपावकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20007154,
    "chapter_id": 6647,
    "verse_number": "17.4",
    "content_sanskrit": "अवज्ञया यदहसदुच्चकैर्बलः समुल्लसद्दशनमयूखमण्डलः । रुषारुणीकृतमपि तेन तत्क्षणं निजं वपुः पुनरयन्निजां रुचिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20007155,
    "chapter_id": 6647,
    "verse_number": "17.5",
    "content_sanskrit": "यदुत्पतत्पृथुतरहारमण्डलं व्यवर्तत द्रुतमभिदूतमुल्मुकः । बृहच्छिलातलकठिनांसघट्टितं ततोऽभवद्भ्रमितमिवाखिलं सदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20007156,
    "chapter_id": 6647,
    "verse_number": "17.6",
    "content_sanskrit": "प्रकुप्यतः श्वसनसमीरणाहतिस्फुटोष्मभिस्तनुवसनान्तमारुतैः । युधाजितः कृतपरितूर्णवीजनं पुनस्तरां वदनसरोजमस्विदत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20007157,
    "chapter_id": 6647,
    "verse_number": "17.7",
    "content_sanskrit": "प्रजापतिक्रतुनिधनार्थमुत्थितंव्यतर्कयज्ज्वरमिव रौद्रमुद्धतम् । समुद्यतं सपदि वधाय विद्विषामतिक्रुधं निषधमनौषधं जनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20007158,
    "chapter_id": 6647,
    "verse_number": "17.8",
    "content_sanskrit": "परस्परं परिकुपितस्य पिंषतः क्षतोर्मिकाकनकपरागपङ्किलम् । करद्वयं सपदि सुधन्वनो निजैरनारतस्रुतिभिरधाव्यताम्बुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20007159,
    "chapter_id": 6647,
    "verse_number": "17.9",
    "content_sanskrit": "निरायतामनलशिखोज्ज्वलां ज्वलन्नखप्रभाकृतपरिवेषसंपदं । अविभ्रमद्भ्रमदनलोल्मुकाकृतिं प्रदेशिनीं जगदिव दग्धुमाहुकिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20007160,
    "chapter_id": 6647,
    "verse_number": "17.10",
    "content_sanskrit": "दुरीक्षतामभजत मन्मथस्तथा यथा पुरा परिचितदाहधार्ष्ट्याया । ध्रुवं पुरः सशरममुं तृतीयया हरोऽपि न व्यसहत वीक्षितुं दृशा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20007161,
    "chapter_id": 6647,
    "verse_number": "17.11",
    "content_sanskrit": "विचिन्तयन्नुपनतमाहवं रसादुरः स्फुरत्तनुरुहमग्रपाणिना । परामृशत्कठिनकठोरकामिनीकुचस्थलप्रमुषितचन्दनं पृथुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20007162,
    "chapter_id": 6647,
    "verse_number": "17.12",
    "content_sanskrit": "विलङ्घितस्थितिमभिवीक्ष्य रुक्षया रिपोर्गिरागुरुमपि गान्दिनीसुतम् । जनैस्तदा युगपरिवर्तवायुभिर्विवर्तिता गिरिपतयः प्रतीयिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20007163,
    "chapter_id": 6647,
    "verse_number": "17.13",
    "content_sanskrit": "विवर्तयन्मदकलुषीकृते दृशौ कराहतक्षितिकृतभैरवावरवः । क्रुधा दधत्तनुमतिलोहिनीमभूत्प्रसेनजिद्गज इव गैरिकारुणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20007164,
    "chapter_id": 6647,
    "verse_number": "17.14",
    "content_sanskrit": "सकुङ्कुमैरविरलमम्बुबिन्दुभिर्गवेषणः परिणतदाडिमारुणैः । स मत्सरस्फुटितवपुर्विनिःसृतैर्बभौ चिरं निचित इवासृजां लवैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20007165,
    "chapter_id": 6647,
    "verse_number": "17.15",
    "content_sanskrit": "ससंभ्रमं चरणतलाभिताडनस्फुटन्महीविवरवितीर्णवर्त्मभिः । रवेः करैरनुचिततापितोरगं प्रकाशतां शिनिरनयद्रसातलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20007166,
    "chapter_id": 6647,
    "verse_number": "17.16",
    "content_sanskrit": "प्रतिक्षणं विधुवति शारणे शिरः शिखिद्युतः कनककिरीटरश्मयः । अशङ्कितं युधमधुना विशन्त्वमी क्षमापतीनिति निरराजयन्निव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20007167,
    "chapter_id": 6647,
    "verse_number": "17.17",
    "content_sanskrit": "दधौ चलत्पृथुरसनं विवक्षया विदारितं विततबृहद्भुजालतः । विदूरथः प्रतिभयमास्यकन्दरं चलत्फणाधरमिव कोटरं तरुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20007168,
    "chapter_id": 6647,
    "verse_number": "17.18",
    "content_sanskrit": "समाकुले सदसि तथापि विक्रियां मनोऽगमन्न मुरभिदः परोदितैः । घनाम्बुभिर्बहुलितनिम्नगाजलैर्जलं न हि व्रजति विकारमम्बुधेः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20007169,
    "chapter_id": 6647,
    "verse_number": "17.19",
    "content_sanskrit": "परानमी यदपवदन्त आत्मनः स्तुवन्ति च स्थितिरसतामसाविति । निनाय नो विकृतिमविस्मितः स्मितं मुखं शरच्छशधरमुग्धमुद्धवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20007170,
    "chapter_id": 6647,
    "verse_number": "17.20",
    "content_sanskrit": "निराकृते यदुभिरिति प्रकोपिभिः स्पशे शनैर्गतवति तत्र विद्विषाम् । मुरद्विषः स्वनितभयानकानकं बलं क्षणादथ समनह्यताजये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20007171,
    "chapter_id": 6647,
    "verse_number": "17.21",
    "content_sanskrit": "मुहुः प्रतिस्खलितपरायुधा युधि स्थवीयसीरचलनितम्बनिर्भराः । अदंशयन्नरहितशौर्यदंशनास्तनूरयं नय इति वृष्णिभूभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20007172,
    "chapter_id": 6647,
    "verse_number": "17.22",
    "content_sanskrit": "दुरुद्वहाः क्षणमपरैस्तदन्तरे रणश्रवादुपचयमाशु बिभ्रति । महीभुजां महिमभृतां न संममुर्मुदोऽन्तरावपुषि बहिश्च कञ्चुकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20007173,
    "chapter_id": 6647,
    "verse_number": "17.23",
    "content_sanskrit": "संकल्पं द्विरदगणं वरूथिनस्तुरङ्गिणो जयनयुजश्च वाजिनः । त्वरायुजः स्वयमपि कुर्वतो नृपाः पुनः पुनस्तदधिकृतानतत्वरन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20007174,
    "chapter_id": 6647,
    "verse_number": "17.24",
    "content_sanskrit": "युधे परैः सह दृढबद्धकक्षया कलक्वणन्मधुपकुलोपगीतया । अदीयत द्विपघटया सवारिभिः करोदरैः स्वयमथ दानमक्षयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20007175,
    "chapter_id": 6647,
    "verse_number": "17.25",
    "content_sanskrit": "सुमेखलाः सिततरदन्तचारवः समुल्लसत्तनुपरिधानसंपदः । रणैषिणां पुलकभृतोऽधिकन्धरं ललम्बिरे सदसिलताः प्रिया इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20007176,
    "chapter_id": 6647,
    "verse_number": "17.26",
    "content_sanskrit": "मनोहरैः प्रकृतिमनोरमाकृतिर्भयप्रदैः समितिषु भीमदर्शनः । सदैवतैः सततमथानपायिभिर्निजाङ्गवन्मुरजिदसेव्यतायुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20007177,
    "chapter_id": 6647,
    "verse_number": "17.27",
    "content_sanskrit": "अवारितं गतमुभयेषु भूरिशः क्षमाभृतामथ कटकान्तरेष्वपि । मुहुर्युधि क्षतसुरशत्रुशोणितप्लुतप्रधिं रथमधिरोहति स्म सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20007178,
    "chapter_id": 6647,
    "verse_number": "17.28",
    "content_sanskrit": "उपेत्यच स्वनगुरुपक्षमारुतं दिवस्त्विषा कपिशितदूरदिङ्मुखः । प्रकम्पितस्थिरतरयष्टि तत्क्षणं पतत्पतिः पदमधिकेतनं दधौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20007179,
    "chapter_id": 6647,
    "verse_number": "17.29",
    "content_sanskrit": "गभीरताविजितमृदङ्गनादया स्वनश्रिया हतरिपुहंसहर्षया । प्रमोदयन्नथ मुखरान्कलापिनः प्रतिष्ठते नवघनवद्रथः स्म सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20007180,
    "chapter_id": 6647,
    "verse_number": "17.30",
    "content_sanskrit": "निरन्तरस्थगितदिगन्तरं ततः समुच्चलद्बलमवलोकयञ्जनः । विकौतुकः प्रकृतमहाप्लवेऽभवद्विशृङ्खलं प्रचलितसिन्धुवारिणि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20007181,
    "chapter_id": 6647,
    "verse_number": "17.31",
    "content_sanskrit": "बबृंहिरे गजपतयो महानकाः प्रदध्वनुर्जयतुरगा जिहेषिरे । असंभवद्गिरिवरगह्वरैरभूत्तदा रवैर्दलित इव स्व आश्रयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20007182,
    "chapter_id": 6647,
    "verse_number": "17.32",
    "content_sanskrit": "अनारतं रसति जयाय दुन्दुभौ मधुद्विषः फलदलघुप्रतिस्वनैः । विनिष्पतन्मृगपतिभिर्गुहामुखैर्गताः परां मुदमहसन्निवाद्रयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20007183,
    "chapter_id": 6647,
    "verse_number": "17.33",
    "content_sanskrit": "जडीकृतश्रवणपथे दिवौकसां चमूरवे विशति सुराद्रिकन्दराः । अनर्थकैरजनि विदग्धकामिनीरतान्तरक्वणितविलासकौशलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20007184,
    "chapter_id": 6647,
    "verse_number": "17.34",
    "content_sanskrit": "अरातिभिर्युधि सहयुध्वनो हताञ्जिघृक्षवः श्रुतरणतूर्यनिःस्वनाः । अकुर्वत प्रथमसमागमोचितं चिरोज्झितं सुरगणिकाः प्रसाधनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20007185,
    "chapter_id": 6647,
    "verse_number": "17.35",
    "content_sanskrit": "प्रचोदिताः परिचितयन्तृकर्मभिर्निषादिभिर्विदितयताङ्कुशक्रियैः । गजाः सकृत्करतललोलनालिकाहता मुहुः प्रणदितघण्डमाययुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20007186,
    "chapter_id": 6647,
    "verse_number": "17.36",
    "content_sanskrit": "सविक्रमक्रमणचलैरितस्ततः प्रकीर्णकैः क्षिपत इव क्षिते रजः । व्यरंसिषुर्न खलु जनस्य दृष्टयस्तुरङ्गमादभिनवभाण्डभारिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20007187,
    "chapter_id": 6647,
    "verse_number": "17.37",
    "content_sanskrit": "चलाङ्गुलीकिसलयमुद्धतैः करैरनृत्यत स्फुटकृतकर्णतालया । मदोदकद्रवकटभित्तिसङ्गिभिः कलस्वरं मधुपगणैरगीयत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20007188,
    "chapter_id": 6647,
    "verse_number": "17.38",
    "content_sanskrit": "असिच्यत प्रशमितपांशुभिर्मही मदाम्बुभिर्धृतनवपूर्णकुम्भया । अवाद्यत श्रवणसुखं समुन्नमत्पयोधरध्वनिगुरु तूर्यमाननैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20007189,
    "chapter_id": 6647,
    "verse_number": "17.39",
    "content_sanskrit": "उदासिरे पवनविधूतवाससस्ततस्ततो गगनलिहश्च केतवः । यतः पुरः प्रतिरिपु शार्ङ्गिणः स्वयं व्यधीयत द्विपघटयेति मङ्गलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20007190,
    "chapter_id": 6647,
    "verse_number": "17.40",
    "content_sanskrit": "न शून्यतामगमदसौ निवेशभूः प्रभूततां दधति बले चलत्यपि । पयस्यभिद्रवति भुवं युगावधौ सरित्पतिर्न हि समुपैति रिक्तताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20007191,
    "chapter_id": 6647,
    "verse_number": "17.41",
    "content_sanskrit": "यियासितामथ मधुभिद्विवस्वता जनो जरन्महिषविषाणधूसराम् । पुरः पतत्परबलरेणुमालिनीमलक्षयद्दिशमभिधूमितामिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20007192,
    "chapter_id": 6647,
    "verse_number": "17.42",
    "content_sanskrit": "मनस्विनामुदितगुरुप्रतिश्रुतिः श्रुतस्तथा न निजमृदङ्गनिःस्वनः । यथा पुरःसमरसमुद्यतद्विषद्वलानकध्वनिरुदकर्षयन्मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20007193,
    "chapter_id": 6647,
    "verse_number": "17.43",
    "content_sanskrit": "यथा यथा पटहरवः समीपतामुपागमत्स हरिवराग्रतः सरः । तथा तथा हृषितवपुर्मुदाकुला द्विषां चमूरजनि जनीव चेतसा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20007194,
    "chapter_id": 6647,
    "verse_number": "17.44",
    "content_sanskrit": "प्रसारिणि सपदि नभस्तले ततः समीरणभ्रमितपरागरूषिता । व्यभाव्यत प्रलयजकालिकाकृतिर्विदूरतः प्रतिबलकेतनावलिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20007195,
    "chapter_id": 6647,
    "verse_number": "17.45",
    "content_sanskrit": "क्षणेन च प्रतिमुखतिग्मदीधितिप्रतिप्रभास्फुरदसिदुःखदर्शना । भयङ्करा भृशमपि दर्शनीयतां ययावसावसुरचमूश्च भूभृताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20007196,
    "chapter_id": 6647,
    "verse_number": "17.46",
    "content_sanskrit": "पयोमुचामभिपततां दिवि द्रुतं विपर्ययः परित इवातपस्य सः । समक्रमः समविषमेष्वथ क्षणात्क्षमातलं बलजलराशिरानशे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20007197,
    "chapter_id": 6647,
    "verse_number": "17.47",
    "content_sanskrit": "ममौ पुरः क्षणमिव पश्यतो महत्तनूदरस्थितभुवनत्रयस्य तत् । विशालतां दधति नितान्तमायते बलं द्विषां मधुमथनस्य चक्षुषि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20007198,
    "chapter_id": 6647,
    "verse_number": "17.48",
    "content_sanskrit": "भृशस्विदः पुलकविकासिमूर्तयो रसाधिके मनसि निविष्टसाहसाः । मुखे युधः सपदि रतेरिवाभवन्ससम्भ्रमाः क्षितिपचमूवधूगणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20007199,
    "chapter_id": 6647,
    "verse_number": "17.49",
    "content_sanskrit": "ध्वजांशुकैर्ध्रुवमनुकूलमारुतप्रसारितैः प्रसभकृतोपहूतयः । यदूनभि द्रुततरमुद्यतायुधाः क्रुधा परं रयमरयः प्रपेदिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20007200,
    "chapter_id": 6647,
    "verse_number": "17.50",
    "content_sanskrit": "हरेरपि प्रति परकीयवाहिनीरधिस्यदं प्रववृतिरे चमूचराः । विलम्बितुं न खलु सहा मनस्विनो विधित्सतः कलहमवेक्ष्य विद्विषः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20007201,
    "chapter_id": 6647,
    "verse_number": "17.51",
    "content_sanskrit": "उपाहितैर्वपुषि निवातवर्मभिः स्फुरन्मणिप्रसृतमरीचिसूचिभिः । निरन्तरं नरपतयो रणाजिरे रराजिरे शरनिकराचिता इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20007202,
    "chapter_id": 6647,
    "verse_number": "17.52",
    "content_sanskrit": "अथोच्चकैर्जरठकपोतकन्धरातनूरुहप्रकरविपाण्डुरद्युति । वलैश्चलच्चरणविधूतमुच्चरद्धनावलीरुदचरत क्षमारजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20007203,
    "chapter_id": 6647,
    "verse_number": "17.53",
    "content_sanskrit": "विषङ्गिभिर्भृशमितरेतरं क्वचित्तुरङ्गमैरुपरि निरुद्धनिर्गमाः । चलाचलैरनुपदमाहताः खुरैर्विबभ्रमुश्चिरमध एव धूलयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20007204,
    "chapter_id": 6647,
    "verse_number": "17.54",
    "content_sanskrit": "गरीयसः प्रचुरमुखस्य रागिणो रजोऽभवद्व्यवहितसत्वमुत्कटम् । सिसृक्षतः सरसिजजन्मनो जगद्बलस्य तु क्षयमपनेतुमिच्छतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20007205,
    "chapter_id": 6647,
    "verse_number": "17.55",
    "content_sanskrit": "पुरा शरक्षतिजनितानि संयुगे नयन्ति नः प्रसभमसृञ्जि पङ्कताम् । इति ध्रुवं व्यलगिषुरात्तभीतयः खमुच्चकैरनलसखस्य केतवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20007206,
    "chapter_id": 6647,
    "verse_number": "17.56",
    "content_sanskrit": "क्वचिल्लसद्घननिकुरम्बकर्बुरः क्वचिद्धिरण्मयकणपुञ्जपिञ्जरः । क्वचिच्छरच्छशधरखण्डपाण्डुरः खुरक्षतक्षितितलरेणुरुद्ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20007207,
    "chapter_id": 6647,
    "verse_number": "17.57",
    "content_sanskrit": "महीयसा महति दिगन्तदन्तिनामनीकजे रजसि मुखानुषङ्गिणि । विसारितामजिहत कोकिलावलीमलीमसा जलदमदाम्बुराजयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20007208,
    "chapter_id": 6647,
    "verse_number": "17.58",
    "content_sanskrit": "शिरोरुहैरलिकुलकोमलैरमी मुधा मृधे मृषत युवान एव मा । बलोद्धतं धवलितमूर्धजानिति ध्रुवं जनाञ्जरत इवाकरोद्रजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20007209,
    "chapter_id": 6647,
    "verse_number": "17.59",
    "content_sanskrit": "सुसंहतैर्दधदपि धाम नीयते तिरस्कृतिं बहुभिरसंशयं परैः । यतः क्षितेरवयवसंपदोऽणवस्त्विषां निधेरपि वपुरावरीषत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20007210,
    "chapter_id": 6647,
    "verse_number": "17.60",
    "content_sanskrit": "द्रुतद्रवद्रथचरणक्षतक्षमातलोल्लसद्बहुलरजोऽवगुण्ठितम् । युगक्षयक्षणनिरवग्रहे जगत्पयोनिधेर्जल इव मग्नमाबभौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20007211,
    "chapter_id": 6647,
    "verse_number": "17.61",
    "content_sanskrit": "समुल्लसद्दिनकरवक्त्रकान्तयो रजस्वलाः परिमलिताम्बरश्रियः । दिगङ्गनाः क्षणमविलोकनक्षमाः शरीरिणां परिहरणीयतां ययुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20007212,
    "chapter_id": 6647,
    "verse_number": "17.62",
    "content_sanskrit": "निरीक्षितुं वियति समेत्यकौतुकात्पराक्रमं समरमुखे महीभृताम् । रजस्ततावनिमिषलोचनोत्पलव्यथाकृति त्रिदशगणैः पलाय्यत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20007213,
    "chapter_id": 6647,
    "verse_number": "17.63",
    "content_sanskrit": "विषङ्गिणि प्रतिपदमापिबत्यपो हताचिरद्युतिनि समीरलक्ष्मणि । शनैःशनैरुपचितपङ्कभारिकाः पयोमुचः प्रययुरपेतवृष्टयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20007214,
    "chapter_id": 6647,
    "verse_number": "17.64",
    "content_sanskrit": "नभोनदीव्यतिकरधौतमूर्तिभिर्वियद्गतैरनधिगतानि लेभिरे । चलच्चमूतुरगखुराहतोत्पतन्महीरजःस्नपनसुखानि दिग्गजैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20007215,
    "chapter_id": 6647,
    "verse_number": "17.65",
    "content_sanskrit": "गजव्रजाक्रमणभरावनम्रया रसातलं यदखिलमानशे भुवा । नभस्तलं भहुलतरेण रेणुना ततोऽगमत्त्रिजगदिवैकतां स्फुटम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20007216,
    "chapter_id": 6647,
    "verse_number": "17.66",
    "content_sanskrit": "समस्थलीकृतविवरेण पूरिता महीभृतां बलरजसा महागुहाः । रहस्त्रपाविधुरवघूरतार्थिनां नभःसदामुपकरणीयतां ययुः ॥",
