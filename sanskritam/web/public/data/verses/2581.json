[{"id": 2074832, "chapter_id": 2581, "verse_number": "१२-८६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074833, "chapter_id": 2581, "verse_number": "१२-८६-१", "content_sanskrit": "कथंविधं पुरं राजा स्वयमावस्तुमर्हति।\nकृतं वा कारयित्वा वा तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074834, "chapter_id": 2581, "verse_number": "१२-८६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074835, "chapter_id": 2581, "verse_number": "१२-८६-२", "content_sanskrit": "वस्तव्यं यत्र कौन्तेय सपुत्रज्ञातिबन्धुना।\nन्याय्यं च परिप्रष्टुं वृत्तिं गुप्तिं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074836, "chapter_id": 2581, "verse_number": "१२-८६-३", "content_sanskrit": "तस्मात्ते र्तयिष्यामि दुर्गकर्म विशेषतः।\nश्रुत्वा तथा विधातव्यमनुष्ठेयं च यत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074837, "chapter_id": 2581, "verse_number": "१२-८६-४", "content_sanskrit": "षङ्विधं दुर्गमास्थाय पुराण्यथ निवेशयेत्।\nसर्वसंपत्प्रधानं च बाहुल्यं चापि संभवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074838, "chapter_id": 2581, "verse_number": "१२-८६-५", "content_sanskrit": "धन्वदुर्गं महीदुर्गं गिरिदुर्गं तथैव च।\nमनुष्यदुर्गं मृद्दुर्गं वनदुर्गं च तानि षट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074839, "chapter_id": 2581, "verse_number": "१२-८६-६", "content_sanskrit": "यत्पुरं दुर्गसंपन्नं धान्यायुधसमन्वितम्।\nदृढप्राकारपरिखं हस्त्यश्वरथसंकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074840, "chapter_id": 2581, "verse_number": "१२-८६-७", "content_sanskrit": "विद्वांसः शिल्पिनो यत्र निचयाश्च सुसंचिताः।\nधार्मिकश्च जनो यत्र दाक्ष्यमुत्तममास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074841, "chapter_id": 2581, "verse_number": "१२-८६-८", "content_sanskrit": "ऊर्जस्विनरनागाश्वं चत्वरापणशोभितम्।\nप्रसिद्धव्यवहारं च प्रशान्तमकुतोभयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074842, "chapter_id": 2581, "verse_number": "१२-८६-९", "content_sanskrit": "सुप्रभं सानुनादं च सुप्रशस्तनिवेशनम्।\nशूराढ्यं प्राज्ञसंपूर्णं ब्रह्मघोषानुनादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074843, "chapter_id": 2581, "verse_number": "१२-८६-१०", "content_sanskrit": "समाजोत्सवसंपन्नं सदापूजितदैवतम्।\nवश्यामात्यबलो राजा तत्पुरं स्वयमाविशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074844, "chapter_id": 2581, "verse_number": "१२-८६-११", "content_sanskrit": "तत्र कोशं बलं मित्रं व्यवहारं च वर्धयेत्।\nपुरे जनपदे चैव सर्वदोषान्निवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074845, "chapter_id": 2581, "verse_number": "१२-८६-१२", "content_sanskrit": "भाण्डागारायुधागारं प्रयत्नेनाभिवर्धयेत्।\nनिचयान्वर्धयेत्सर्वांस्तथा यन्त्रकटंकटान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074846, "chapter_id": 2581, "verse_number": "१२-८६-१३", "content_sanskrit": "काष्ठलोहतुषाङ्गारदारुशृङ्गास्थिवैणवान्।\nमज्जास्नेहवसाक्षौद्रमौषधग्राममेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074847, "chapter_id": 2581, "verse_number": "१२-८६-१४", "content_sanskrit": "शणं सर्जरसं धान्यमायुधानि शरांस्तथा।\nचर्म स्नायुं तथा वेत्रं मुञ्जवल्वजदंध्वनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074848, "chapter_id": 2581, "verse_number": "१२-८६-१५", "content_sanskrit": "आशयाश्चोदपानाश्च प्रभूतसलिलाकराः।\nनिरोद्धव्याः सदा राज्ञा क्षीरिणश्च महीरुहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074849, "chapter_id": 2581, "verse_number": "१२-८६-१६", "content_sanskrit": "सत्कृताश्च प्रयत्नेन आचार्यर्त्विक्पुरोहिताः।\nमहेष्वासाः स्थपतयः सांवत्सरचिकित्सकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074850, "chapter_id": 2581, "verse_number": "१२-८६-१७", "content_sanskrit": "प्राज्ञा मेधाविनो दान्ता दक्षाः शूरा बहुश्रुताः।\nकुलीनाः सत्वसंपन्ना युक्ताः सर्वेषु कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074851, "chapter_id": 2581, "verse_number": "१२-८६-१८", "content_sanskrit": "पूजयेद्धार्मिकान्राजा निगृह्णीयादधार्मेकान्।\nनियुञ्ज्याच्च प्रयत्नेन सर्ववर्णान्स्वकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074852, "chapter_id": 2581, "verse_number": "१२-८६-१९", "content_sanskrit": "बाह्यमाभ्यन्तरं चैव पौरजानपदं तथा।\nचारैः सुविदितं कृत्वा ततः कर्म प्रयोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074853, "chapter_id": 2581, "verse_number": "१२-८६-२०", "content_sanskrit": "चरान्मन्त्रं च कोशं च दण्डं चैव विशेषतः।\nअनुतिष्ठेत्स्वयं राजा सर्वं ह्यत्र प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074854, "chapter_id": 2581, "verse_number": "१२-८६-२१", "content_sanskrit": "उदासीनारिमित्राणां सर्वमेव चिकीर्षितम्।\nपुरे जनपदे चैव ज्ञातव्यं चारचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074855, "chapter_id": 2581, "verse_number": "१२-८६-२२", "content_sanskrit": "ततस्तेषां विधातव्यं सर्वमेवाप्रमादतः।\nभक्तान्पूजयता नित्यं द्विषतश्च निगृह्णता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074856, "chapter_id": 2581, "verse_number": "१२-८६-२३", "content_sanskrit": "यष्टव्यं क्रतुभिर्नित्यं दातव्यं चाप्यपीडया।\nप्रजानां रक्षणं कार्यं न कार्यं धर्मबाधकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074857, "chapter_id": 2581, "verse_number": "१२-८६-२४", "content_sanskrit": "कृपणानाथवृद्धानां विधवानां च योषिताम्।\nयोगक्षेमं च वृत्तिं च नित्यमेव प्रकल्पयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074858, "chapter_id": 2581, "verse_number": "१२-८६-२५", "content_sanskrit": "आश्रमेषु यथाकालं चैलभाजनभोजनम्।\nसदैवोपहरेद्राजा सत्कृयाभ्यर्च्य मान्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074859, "chapter_id": 2581, "verse_number": "१२-८६-२६", "content_sanskrit": "आत्मानं सर्वकार्याणि तापसे राष्ट्रमेव च।\nनिवेदयेत्प्रयत्नेन तिष्ठेत्प्रह्वश्च सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074860, "chapter_id": 2581, "verse_number": "१२-८६-२७", "content_sanskrit": "` ते कस्यांचिदवस्थायां शरणं शरणार्थिने।\nराज्ञे दद्युर्यथाकामं तापसाः शंसितव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074861, "chapter_id": 2581, "verse_number": "१२-८६-२८", "content_sanskrit": "सर्वार्थत्यागिनं राजा कुले जातं बहुश्रुतम्।\nपूजयेत्तादृशं दृष्ट्वा शयनासनभोजनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074862, "chapter_id": 2581, "verse_number": "१२-८६-२९", "content_sanskrit": "तस्मिन्कुर्वीत विश्वासं राजा कस्यांचिदापदि।\nतापसेषु हि विश्वासमपि कुर्वन्ति दस्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074863, "chapter_id": 2581, "verse_number": "१२-८६-३०", "content_sanskrit": "तस्मिन्निधीनादधीत पुनः प्रत्याददीत च।\nन चाप्यभीक्ष्णं सेवेत भृशं वा प्रतिपूजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074864, "chapter_id": 2581, "verse_number": "१२-८६-३१", "content_sanskrit": "अन्यः कार्यः स्वराष्ट्रेषु परराष्ट्रेषु चापरः।\nअटवीषु परः कार्यः सामन्तनगरेष्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074865, "chapter_id": 2581, "verse_number": "१२-८६-३२", "content_sanskrit": "तेषु सत्कारमानाभ्यां संविभागांश्च कारयेत्।\nपरराष्ट्राटवीस्थेषु यथा स्वविषये तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074866, "chapter_id": 2581, "verse_number": "१२-८६-३३", "content_sanskrit": "ते कस्यांचिदवस्थायां शरणं शरणार्थिने।\nराज्ञे दद्युर्थथाकामं तापसाः संशितव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074867, "chapter_id": 2581, "verse_number": "१२-८६-३४", "content_sanskrit": "एष ते लक्षणोद्देशः संक्षेपेण प्रकीर्तितः।\nयादृशे नगरे राजा स्वयमावस्तुमर्हति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074868, "chapter_id": 2581, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षडशीतिममोऽध्यायः॥ ८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]