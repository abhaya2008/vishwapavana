[{"id": 2212495, "chapter_id": 5526, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212496, "chapter_id": 5526, "verse_number": "१", "content_sanskrit": "एवं सम्पूजितो राजा पाण्डवैरम्बिकासुतः ।\nविजहार यथापूर्वमृषिभिः पर्युपस्थितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212497, "chapter_id": 5526, "verse_number": "२", "content_sanskrit": "ब्रह्मदेयाग्रहारांश्च प्रददौ कुरुसत्तमः ।\nतच्च कुन्तीसुतो राजा सर्वमेवान्वमोदत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212498, "chapter_id": 5526, "verse_number": "३", "content_sanskrit": "आनृशंस्यपरो धीमान् प्रीयमाणो युधिष्ठिरः ।\nउवाच च स तान् भ्रातॄन् अमात्यांश्च महीपतिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212499, "chapter_id": 5526, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212500, "chapter_id": 5526, "verse_number": "४", "content_sanskrit": "मया चैव भवद्भिश्च मान्य एव नराधिपः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212501, "chapter_id": 5526, "verse_number": "५", "content_sanskrit": "निदेशे धृतराष्ट्रस्य यः स्थास्यति स मे सुहृत् ।\nविपरीतश्च मे शत्रुर्निरस्यश्च भवेन्नरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212502, "chapter_id": 5526, "verse_number": "६", "content_sanskrit": "परिवृत्तेषु चाहस्सु पुत्राणां श्राद्धकर्मणि ।\nददातु राजा वित्तानि यावदस्य चिकीर्षितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212503, "chapter_id": 5526, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212504, "chapter_id": 5526, "verse_number": "७", "content_sanskrit": "ततः स राजा कौरव्यो धृतराष्ट्रो महामनाः ।\nब्राह्मणेभ्यो यथार्हेभ्यो ददौ वित्तमनेकशः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212505, "chapter_id": 5526, "verse_number": "८", "content_sanskrit": "धर्मराजश्च भीमश्च सव्यसाची यमावपि ।\nतत्सर्वमन्ववर्तन्त धृतराष्ट्रव्यपेक्षया\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212506, "chapter_id": 5526, "verse_number": "९", "content_sanskrit": "कथं नु राजा वृद्धः सन् पुत्रशोकसमाहतः ।\nशोकमस्मत्कृतं प्राप्य न म्रियेतेति चिन्त्य वै\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212507, "chapter_id": 5526, "verse_number": "१०", "content_sanskrit": "यावद्धि कुरुमुख्यस्य जीवपुत्रस्य वै सुखम् ।\nतावत् सुखमवाप्नोतु भोगांश्चेति व्यवस्थिताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212508, "chapter_id": 5526, "verse_number": "११", "content_sanskrit": "ततस्ते सहिताः सर्वे भ्रातरः पञ्च पाण्डवाः ।\nदानशीलास्तथा तस्थुर्धृतराष्ट्रस्य शासने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212509, "chapter_id": 5526, "verse_number": "१२", "content_sanskrit": "धृतराष्ट्रस्तु तान् वीरान् विनीतान् विनये स्थितान् ।\nशिष्यवृत्तौ स्थितान् नित्यं गुरुवत् तानपश्यत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212510, "chapter_id": 5526, "verse_number": "१३", "content_sanskrit": "गान्धारी चापि पुत्राणां विविधैः श्राद्धकर्मभिः ।\nआनृण्यमगमत् कामं विप्रेभ्यः प्रतिपाद्य वै\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212511, "chapter_id": 5526, "verse_number": "१४", "content_sanskrit": "एवं धर्मभृतां श्रेष्ठो धर्मराजो युधिष्ठिरः ।\nभ्रातृभिः सहितो धीमान् पूजयामास तं नृपम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212512, "chapter_id": 5526, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212513, "chapter_id": 5526, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]