[{"id": 7003968000, "chapter_id": 23968, "verse_number": "३-१-३१-१", "content_sanskrit": "ऋषय ऊचुः ।\nअश्वत्थामा कथं सूत सुप्तमारणमाचरत् ।\nकथं च मुक्तस्तत्पापाद्धनुष्कोटौ निमज्जनात्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003968001, "chapter_id": 23968, "verse_number": "३-१-३१-२", "content_sanskrit": "एतन्नः श्रद्दधानानां ब्रूहि पौराणिकोत्तम ।\nतृप्तिर्न जायतेऽ स्माकं त्वद्वचोमृतपायिनाम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003968002, "chapter_id": 23968, "verse_number": "३-१-३१-३", "content_sanskrit": "इति पृष्टस्तदा सूतो नैमिषारण्यवासिभिः ।\nवक्तुं प्रचक्रमे तत्र व्यासं नत्वा गुरुं मुदा ।\nश्रीसूत उवाच ।\nराज्यार्थं कलहे जाते पांडवानां पुरा द्विजाः ।\nधार्तराष्ट्रैर्महायुद्धे महदक्षौहिणीयुते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003968003, "chapter_id": 23968, "verse_number": "३-१-३१-४", "content_sanskrit": "युद्धं दशदिनं कृत्वा भीष्मे शांतनवे हते ।\nद्रोणे पंचदिनं कृत्वा कर्णे च द्विदिनं तथा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003968004, "chapter_id": 23968, "verse_number": "३-१-३१-५", "content_sanskrit": "तथैवैकदिनं युद्ध्वा शल्ये च निधनं गते ।\nअष्टादशदिने तत्र रणे दुर्योधने द्विजाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003968005, "chapter_id": 23968, "verse_number": "३-१-३१-६", "content_sanskrit": "भग्नोरौ भीमगदया पतिते राजसत्तमे ।\nसर्वे नृपतयो विप्रा निवेशाय कृतत्वराः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003968006, "chapter_id": 23968, "verse_number": "३-१-३१-७", "content_sanskrit": "ये जीवितास्तु राजानस्ते ययुर्हृष्टमानसाः ।\nधृष्टद्युम्नशिखंडयाद्याः सृञ्जयाः सर्व एव हि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003968007, "chapter_id": 23968, "verse_number": "३-१-३१-८", "content_sanskrit": "अन्ये चापि महीपाला जग्मुः स्वशिबिराण्यथ ।\nअथ पार्था महावीरा कृष्णसात्यकिसंयुताः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003968008, "chapter_id": 23968, "verse_number": "३-१-३१-९", "content_sanskrit": "दुर्योधनस्य शिबिरं प्राविशन्निर्जनं द्विजाः ।\nवृद्धैरमात्यैस्तत्रस्थैः षंढैः स्त्रीरक्षकैस्तथा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003968009, "chapter_id": 23968, "verse_number": "३-१-३१-१०", "content_sanskrit": "कृतांजलिपुटैः प्रह्वैः काषायमलिनांबरैः ।\nप्रणम्यमानास्ते पार्थाः कुरुराजस्य वेश्मनि॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003968010, "chapter_id": 23968, "verse_number": "३-१-३१-११", "content_sanskrit": "तत्रत्यद्रव्यजातानि समादाय महा बलाः ।\nसुयोधनस्य शिबिरे न्यवसंत सुखेन ते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003968011, "chapter_id": 23968, "verse_number": "३-१-३१-१२", "content_sanskrit": "अथ तानब्रवीत्पार्थाञ्छ्रीकृष्णः प्रीणयन्निव ।\nमंगलार्थाय चास्माभिर्वस्तव्यं शिबिराद्बहिः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003968012, "chapter_id": 23968, "verse_number": "३-१-३१-१३", "content_sanskrit": "इत्युक्ता वासुदेवेन तथेत्युक्त्वाथ पांडवाः ।\nकृष्णसात्यकिसंयुक्ताः प्रययुः शिबिराद्बहिः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003968013, "chapter_id": 23968, "verse_number": "३-१-३१-१४", "content_sanskrit": "वासुदेवेन सहिता मंगलार्थं हि पांडवाः ।\nओघवत्याः समासाद्य तीरं नद्या नरोत्तमाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003968014, "chapter_id": 23968, "verse_number": "३-१-३१-१५", "content_sanskrit": "ऊषुस्तां रजनीं तत्र हतशत्रुगणाः सुखम् ।\nकृतवर्मा कृपो द्रौणिस्तथा दुर्योधनांतिकम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003968015, "chapter_id": 23968, "verse_number": "३-१-३१-१६", "content_sanskrit": "आदित्यास्तमयात्पूर्वमपराह्णे समाययुः ।\nसुयोधनं तदा दृष्ट्वा रणपांसुषु रूषितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003968016, "chapter_id": 23968, "verse_number": "३-१-३१-१७", "content_sanskrit": "भग्नोरुदण्डं गदया भीमसेन स्य भीमया ।\nरुधिरासिक्तसर्वांगं चेष्टमानं महीतले॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003968017, "chapter_id": 23968, "verse_number": "३-१-३१-१८", "content_sanskrit": "अशोचंत तदा तत्र द्रोणपुत्रादयस्त्रयः ।\nशुशोच सोऽपि तान्दृष्ट्वा रणे दुर्योधनो नृपः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003968018, "chapter_id": 23968, "verse_number": "३-१-३१-१९", "content_sanskrit": "दृष्ट्वा तथा तु राजानं बाष्पव्याकुललोचनम् ।\nअश्वत्थामा तदा कोपाज्ज्वलन्निव महानलः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003968019, "chapter_id": 23968, "verse_number": "३-१-३१-२०", "content_sanskrit": "पाणौ पाणिं विनिष्पिष्य क्रोध विस्फारितेक्षणः ।\nअश्रुविक्लवया वाचा दुर्योधनमभाषत॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003968020, "chapter_id": 23968, "verse_number": "३-१-३१-२१", "content_sanskrit": "पिता मे पातितः क्षुद्रैश्छलेनैव रणाजिरे ।\nन तथा तेन शोचामि यथा निष्पातिते त्वयि॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003968021, "chapter_id": 23968, "verse_number": "३-१-३१-२२", "content_sanskrit": "शृणु वाक्यं ममाद्य त्वं यथार्थं वदतो नृप ।\nसुकृतेन शपे चाहं सुयोधन महामते॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003968022, "chapter_id": 23968, "verse_number": "३-१-३१-२३", "content_sanskrit": "अद्य रात्रौ हनिष्यामि पांडवा न्सह सृंजयैः ।\nपश्यतो वासुदेवस्य त्वमनुज्ञां प्रयच्छ मे॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003968023, "chapter_id": 23968, "verse_number": "३-१-३१-२४", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा द्रौणिं राजा तदाऽब्रवीत् ।\nतथास्त्विति पुनः प्राह कृपं राजा द्विजोत्तमाः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003968024, "chapter_id": 23968, "verse_number": "३-१-३१-२५", "content_sanskrit": "आचार्यैनं द्रोणपुत्रं कलशोत्थेन वारिणा ।\nसैनापत्येऽभिषिंचस्वेत्यथ सोपि तथाऽकरोत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003968025, "chapter_id": 23968, "verse_number": "३-१-३१-२६", "content_sanskrit": "सोभिषिक्तस्तदा द्रौणिः परिष्वज्य नृपोत्तमम् ।\nकृतवर्मकृपाभ्यां च सहितस्त्वरितं ययौ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003968026, "chapter_id": 23968, "verse_number": "३-१-३१-२७", "content_sanskrit": "ततस्ते तु त्रयो वीराः प्रयाता दक्षिणोन्मुखाः ।\nआदित्यास्तमयात्पूर्वं शिबिरांतिकमासत॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003968027, "chapter_id": 23968, "verse_number": "३-१-३१-२८", "content_sanskrit": "पार्थानां भीषणं शब्दं श्रुत्वा तत्र जयैषिणः ।\nपांडवानुद्रुता भीतास्तदा द्रौण्यादयस्त्रयः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003968028, "chapter_id": 23968, "verse_number": "३-१-३१-२९", "content_sanskrit": "प्राङ्मुखा दुद्रुवुर्भीत्या कियद्दूरं श्रमातुराः ।\nमुहुर्तं ते ततो गत्वा क्रोधामर्षवशानुगाः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003968029, "chapter_id": 23968, "verse_number": "३-१-३१-३०", "content_sanskrit": "दुर्योधनवधार्तास्ते क्षणं तत्रावतस्थिरे ।\nततोऽपश्यन्नरण्यं वै नानातरुलतावृतम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003968030, "chapter_id": 23968, "verse_number": "३-१-३१-३१", "content_sanskrit": "अनेकमृगसंबाधं क्रूरपक्षिगणाकुलम् ।\nसमृद्धजलसंपूर्णतटाकपरिशोभितम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003968031, "chapter_id": 23968, "verse_number": "३-१-३१-३२", "content_sanskrit": "पद्मेंदीवरकह्लारसरसी शतसंकुलम् ।\nतत्र पीत्वा जलं ते तु पाययित्वा हयांस्तथा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003968032, "chapter_id": 23968, "verse_number": "३-१-३१-३३", "content_sanskrit": "अनेकशाखासंबाधन्यग्रोधं ददृशुस्ततः ।\nसंप्राप्य तु महावृक्षं न्यग्रोधं ते त्रयस्तदा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003968033, "chapter_id": 23968, "verse_number": "३-१-३१-३४", "content_sanskrit": "अवतीर्य रथेभ्यश्च मोचयित्वा तुरंगमान् ।\nउपस्पृश्य जलं तत्र सायंसंध्यामुपासत॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003968034, "chapter_id": 23968, "verse_number": "३-१-३१-३५", "content_sanskrit": "अथ चास्तगिरिं भानुः प्रपेदे च गतप्रभः ।\nततश्च रजनी घोरा समभूत्तिमिराकुला॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003968035, "chapter_id": 23968, "verse_number": "३-१-३१-३६", "content_sanskrit": "रात्रिचराणि सत्त्वानि संचरंति ततस्ततः ।\nदिवाचराणि सत्त्वानि निद्रावशमुपा ययुः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003968036, "chapter_id": 23968, "verse_number": "३-१-३१-३७", "content_sanskrit": "कृतवर्मा कृपो द्रौणिः प्रदोषसमये हि ते ।\nन्यग्रोधस्योपविविशुरंतिके शोककर्शिताः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003968037, "chapter_id": 23968, "verse_number": "३-१-३१-३८", "content_sanskrit": "कृपभोजौ तदा निद्रां भेजातेऽतिप याक्रमौ ।\nसुखोचितास्त्वदुःखार्हा निषेदुर्धरणीतले॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003968038, "chapter_id": 23968, "verse_number": "३-१-३१-३९", "content_sanskrit": "द्रोणपुत्रस्तु कोपेन कलुषीकृतमानसः ।\nययौ न निद्रां विप्रेंद्रा निश्वसन्नुरगो यथा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003968039, "chapter_id": 23968, "verse_number": "३-१-३१-४०", "content_sanskrit": "ततोऽवलोकयांचक्रे तदरण्यं भयानकम् ।\nन्यग्रोधं च ततोऽपश्यद्बहुवायससंकुलम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003968040, "chapter_id": 23968, "verse_number": "३-१-३१-४१", "content_sanskrit": "तत्र वायसवृन्दानि निशायां वासमाय युः ।\nसुखं भिन्नासु शाखासु सुषुपुस्ते पृथक्पृथक्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003968041, "chapter_id": 23968, "verse_number": "३-१-३१-४२", "content_sanskrit": "काकेषु तेषु सुप्तेषु विश्वस्तेषु समंततः ।\nततोऽपश्यत्समायांतं भासं द्रौणिर्भयंकरम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003968042, "chapter_id": 23968, "verse_number": "३-१-३१-४३", "content_sanskrit": "कूरशब्दं क्रूरकायं बभ्रुपिंगकलेवरम् ।\nस भासोऽथ भृशं शब्दं कृत्वालीयत शाखिनि॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003968043, "chapter_id": 23968, "verse_number": "३-१-३१-४४", "content_sanskrit": "उत्प्लुत्य तस्य शाखायां न्यग्रोधस्य विहंगमः ।\nसुप्तान्काकान्निजघ्नेऽसावनेकान्वायसांतकः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003968044, "chapter_id": 23968, "verse_number": "३-१-३१-४५", "content_sanskrit": "काकानामभिनत्पक्षान्स केषांचिद्विहंगमः ।\nइतरेषां च चरणाञ्छिरांसि चरणा युधः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003968045, "chapter_id": 23968, "verse_number": "३-१-३१-४६", "content_sanskrit": "विचकर्त क्षणेनासावुलूको वलवान्द्विजाः ।\nस भिन्नदेहावयवैः काकानां बहुभिस्तदा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003968046, "chapter_id": 23968, "verse_number": "३-१-३१-४७", "content_sanskrit": "समंतादावृतं सर्वं न्यग्रोधपरि मण्डलम् ।\nवायसांस्तान्निहत्यासावुलूको मुमुदे तदा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003968047, "chapter_id": 23968, "verse_number": "३-१-३१-४८", "content_sanskrit": "द्रौणिर्दृष्ट्वा तु तत्कर्म भासेनैवं कृतं निशि ।\nकरिष्याम्यहमप्येवं शत्रूणां निधनं निशि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003968048, "chapter_id": 23968, "verse_number": "३-१-३१-४९", "content_sanskrit": "इत्यचिंतयदेकः सन्नुपदेशमिमं स्मरन् ।\nजेतुं न शक्याः पार्था हि ऋजुमार्गेण युद्ध्यता॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003968049, "chapter_id": 23968, "verse_number": "३-१-३१-५०", "content_sanskrit": "मया तच्छद्मना तेऽथ हंतव्या जितकाशिनः ।\nसुयोधनसकाशे च प्रतिज्ञातो मया वधः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003968050, "chapter_id": 23968, "verse_number": "३-१-३१-५१", "content_sanskrit": "ऋजुमार्गेण युद्धे मे प्राणनाशो भविष्यति ।\nछलेन युध्यमानस्य जयश्चास्य रिपुक्षयः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003968051, "chapter_id": 23968, "verse_number": "३-१-३१-५२", "content_sanskrit": "यच्च निंद्यं भवेत्कार्यं लोके सर्वजनैरपि ।\nकार्यमेव हि तत्कर्म क्षत्रधर्मानुवर्तिना॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003968052, "chapter_id": 23968, "verse_number": "३-१-३१-५३", "content_sanskrit": "पार्थैरपि छलेनैव कृतं कर्म सुयोधने ।\nअस्मिन्नर्थे पुराविद्भिः प्रोक्ताः श्लोका भवंति हि॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003968053, "chapter_id": 23968, "verse_number": "३-१-३१-५४", "content_sanskrit": "परिश्रांते विदीर्णे च भुंजाने च रिपोर्बले ।\nप्रस्थाने च प्रवेशे च प्रहर्तव्यं न संशयः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003968054, "chapter_id": 23968, "verse_number": "३-१-३१-५५", "content_sanskrit": "निद्रार्तमर्धरात्रे च तथा त्यक्तायुधं रणे ।\nभिन्नयोधं बलं सर्वं प्रहर्तव्यमरातिभिः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003968055, "chapter_id": 23968, "verse_number": "३-१-३१-५६", "content_sanskrit": "एवं स नियमं कृत्वा सुप्तमारणकर्मणि ।\nप्राबोधयद्भोजकृपौ सुप्तौ रात्रौ स साहसी ।\nद्रौणिर्ध्यात्वा मुहूर्तं तु तावुभावभ्यभाषत॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003968056, "chapter_id": 23968, "verse_number": "३-१-३१-५७", "content_sanskrit": "अश्वत्थामोवाच ।\nमृतः सुयोधनो राजा महाबलपराक्रमः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003968057, "chapter_id": 23968, "verse_number": "३-१-३१-५८", "content_sanskrit": "शुद्धकर्मा हतः पार्थैर्बहुभिः क्षुद्रकर्मभिः ।\nभीमेनातिनृशंसेन शिरो राज्ञः पदा हतम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003968058, "chapter_id": 23968, "verse_number": "३-१-३१-५९", "content_sanskrit": "ततोऽद्य रात्रौ पार्थानां समेत्य पटमण्डपम् ।\nसुखसुप्तान्हनिष्यामः शस्त्रैर्नानाविधैर्वयम् ।\nकृपः प्रोवाच तत्रैन मिति श्रुत्वा द्विजोत्तमाः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003968059, "chapter_id": 23968, "verse_number": "३-१-३१-६०", "content_sanskrit": "कृप उवाच ।\nसुप्तानां मारणं लोके न धर्मो न च पूज्यते॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003968060, "chapter_id": 23968, "verse_number": "३-१-३१-६१", "content_sanskrit": "तथैव त्यक्तशस्त्राणां संत्यक्तरथवाजि नाम् ।\nशृणु मे वचनं वत्स मुच्यतां साहसं त्वया॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003968061, "chapter_id": 23968, "verse_number": "३-१-३१-६२", "content_sanskrit": "वयं तु धृतराष्टं च गांधारीं च पतिव्रताम् ।\nपृच्छामो विदुरं चापि तदुक्तं करवा महे ।\nइत्युक्तः स तदा द्रौणिः कृपं प्रोवाच वै पुनः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003968062, "chapter_id": 23968, "verse_number": "३-१-३१-६३", "content_sanskrit": "अश्वत्थामोवाच ।\nपांडवैश्च पुरा यन्मे छलाद्युद्धे पिता हतः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003968063, "chapter_id": 23968, "verse_number": "३-१-३१-६४", "content_sanskrit": "तन्मे सर्वाणि मर्माणि निकृन्तति हि मातुल ।\nद्रोणहंताहमित्येतद्धृष्टद्युमस्य यद्वचः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003968064, "chapter_id": 23968, "verse_number": "३-१-३१-६५", "content_sanskrit": "कथं जनसमक्षे तद्वचनं संशृणोम्यहम् ।\nतैरेव पांडवैः पूर्वं धर्मसेतुर्निराकृतः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003968065, "chapter_id": 23968, "verse_number": "३-१-३१-६६", "content_sanskrit": "समक्षमेव युष्माकं सर्वेषामेव भूभृताम् ।\nत्यक्तायुधो मम पिता धृष्टद्युम्नेन पातितः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003968066, "chapter_id": 23968, "verse_number": "३-१-३१-६७", "content_sanskrit": "तथा शांतनवो भीष्मस्त्यक्तचापो निरायुधः ।\nशिखंडिनं पुरोधाय निहतः सव्यसाचिना॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003968067, "chapter_id": 23968, "verse_number": "३-१-३१-६८", "content_sanskrit": "एवमन्येऽपि भूपालाश्छलेनैव हतास्तु तैः ।\nतथैवाहं करिष्यामि सुप्तानां मारणं निशि॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003968068, "chapter_id": 23968, "verse_number": "३-१-३१-६९", "content_sanskrit": "एवमुक्त्वा तदा द्रौणिः संयुक्ततुरगं रथम् ।\nप्रायादभिमुखः शत्रून्समारुह्य क्रुधा ज्वलन्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003968069, "chapter_id": 23968, "verse_number": "३-१-३१-७०", "content_sanskrit": "तं यांतम न्वगातां तौ कृतवर्मकृपावुभौ ।\nययुश्च शिबिरे तेषां संप्रसुप्तजनं तदा॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003968070, "chapter_id": 23968, "verse_number": "३-१-३१-७१", "content_sanskrit": "शिबिरद्वारमासाद्य द्रोणपुत्रो व्यतिष्ठत ।\nरात्रौ तत्र समाराध्य महादेवं घृणानिधिम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003968071, "chapter_id": 23968, "verse_number": "३-१-३१-७२", "content_sanskrit": "अवाप विमलं खङ्गं महादेवाद्वरप्रदात् ।\nततो द्रौणिरवस्थाप्य कृतवर्मकृपावुभौ॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003968072, "chapter_id": 23968, "verse_number": "३-१-३१-७३", "content_sanskrit": "द्वारदेशे महावीरः शिबि रांतः प्रविष्टवान् ।\nप्रविष्टे शिबिरे द्रौणौ कृतवर्मकृपावुभौ॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003968073, "chapter_id": 23968, "verse_number": "३-१-३१-७४", "content_sanskrit": "द्वारदेशे व्यतिष्ठेतां यत्तौ परमधन्विनौ ।\nअथ द्रौणिः सुसंक्रुद्धस्तेजसा प्रज्वलन्निव॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003968074, "chapter_id": 23968, "verse_number": "३-१-३१-७५", "content_sanskrit": "खङ्गं विमलमादाय व्यचरच्छिबिरे निशि ।\nततस्तु धृष्टद्युम्नस्य शिबिरं मंदमाययौ॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003968075, "chapter_id": 23968, "verse_number": "३-१-३१-७६", "content_sanskrit": "धृष्टद्युम्नादयस्तत्र महायुद्धेन कर्शिताः ।\nसुषुपुर्निशि विश्वस्ताः स्वस्वसैन्यसमावृताः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003968076, "chapter_id": 23968, "verse_number": "३-१-३१-७७", "content_sanskrit": "धृष्टद्युम्नस्य शिबिरं प्रविश्य द्रौणिरस्त्रवित् ।\nतं सुप्तं शयने शुभ्रे ददर्शारान्महाबलम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003968077, "chapter_id": 23968, "verse_number": "३-१-३१-७८", "content_sanskrit": "पादेनाघातयद्रोषात्स्वपंतं द्रोणनंदनः ।\nस बुद्धश्चरणाघातादुत्थाय शयनादथ॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003968078, "chapter_id": 23968, "verse_number": "३-१-३१-७९", "content_sanskrit": "व्यलोकयत्तदा वीरो द्रोणपुत्रं पुरः स्थितम् ।\nतमुत्पतंतं शयनाद्द्रोणाचार्यसुतो बली॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003968079, "chapter_id": 23968, "verse_number": "३-१-३१-८०", "content_sanskrit": "केशेष्वाकृष्य बाहुभ्यां निष्पिपेष धरातले ।\nधृष्टद्युम्नस्तदा तेन निष्पिष्टः स भया तुरः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003968080, "chapter_id": 23968, "verse_number": "३-१-३१-८१", "content_sanskrit": "निद्रांधः पादघातातो न शशाक विचेष्टितुम् ।\nद्रौणिस्त्वाक्रम्य तस्योरः कण्ठं बद्ध्वा धनुर्गुणैः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003968081, "chapter_id": 23968, "verse_number": "३-१-३१-८२", "content_sanskrit": "नदंतं विस्फुरंतं तं पशुमारममारयत् ।\nतस्य सैन्यानि सर्वाणि न्यवधीच्च तथैव सः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003968082, "chapter_id": 23968, "verse_number": "३-१-३१-८३", "content_sanskrit": "युधामन्युं महावीर्यममुत्तमौजसमेव च ।\nतथैव द्रौपदीपुत्रानवशिष्टांश्च सोमकान्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003968083, "chapter_id": 23968, "verse_number": "३-१-३१-८४", "content_sanskrit": "शिखंडिप्रमुखानन्यान्खङ्गेनामारयद्बहून् ।\nतद्भयाद्द्वारनिर्यातान्सर्वानेव च सैनिकान्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003968084, "chapter_id": 23968, "verse_number": "३-१-३१-८५", "content_sanskrit": "प्रापयामासतुर्मृत्युं कृतवर्मकृपा वुभौ ।\nएवं निहतसैन्यं तच्छिबिरं तैर्महाबलैः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003968085, "chapter_id": 23968, "verse_number": "३-१-३१-८६", "content_sanskrit": "तत्क्षणे शून्यमभवत्त्रिजगत्प्रलये यथा ।\nएवं हत्वा ततः सर्वान्द्रोणपुत्रादयस्त्रयः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003968086, "chapter_id": 23968, "verse_number": "३-१-३१-८७", "content_sanskrit": "निरगुः शिबिरात्तस्मात्पार्थभीता भयातुराः ।\nसर्वे पृथक्पृथग्देशान्दुद्रुवुः शीघ्रगामिनः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003968087, "chapter_id": 23968, "verse_number": "३-१-३१-८८", "content_sanskrit": "अथ द्रौणिर्ययौ विप्रा रेवातीरं मनोरमम् ।\nतत्र ह्यनेकसाहस्रा ऋषयो वेदवादिनः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003968088, "chapter_id": 23968, "verse_number": "३-१-३१-८९", "content_sanskrit": "कथयंतः कथाः पुण्यास्तपश्चक्रुरनुत्तमम् ।\nतत्रायं प्रययौ द्रौणिरृषीणामाश्रमेष्वथ॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003968089, "chapter_id": 23968, "verse_number": "३-१-३१-९०", "content_sanskrit": "प्रविष्टमात्रे तस्मिंस्तु मुनयो ब्रह्मवादिनः ।\nद्रौणेर्दुश्चरितं ज्ञात्वा प्राहुर्योगबलेन तम्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003968090, "chapter_id": 23968, "verse_number": "३-१-३१-९१", "content_sanskrit": "सुप्तमा रणकृत्पापी द्रौणे त्वं ब्राह्मणाधमः ।\nत्वद्दर्शनेन ह्यस्माकं पातित्यं भवति ध्रुवम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003968091, "chapter_id": 23968, "verse_number": "३-१-३१-९२", "content_sanskrit": "त्वत्संभाषणमात्रेण ब्रह्महत्यायुतं भ वेत् ।\nअतोऽस्मदाश्रमेभ्यस्त्वं निर्गच्छ पुरुषाधम॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003968092, "chapter_id": 23968, "verse_number": "३-१-३१-९३", "content_sanskrit": "इत्यब्रुवंस्तदा द्रौणिं तत्रत्या मुनयो द्विजाः ।\nइतीरितस्ततो द्रौणिर्मुनिभिर्ब्रह्म वादिभिः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003968093, "chapter_id": 23968, "verse_number": "३-१-३१-९४", "content_sanskrit": "लज्जितो निलात्तस्मादाश्रमान्मुनिसेवितात् ।\nएवं काश्यादितीर्थेषु पुण्येषु प्रययौ च सः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003968094, "chapter_id": 23968, "verse_number": "३-१-३१-९५", "content_sanskrit": "तत्रतत्र द्विजैः सर्वै र्निंदितोऽसौ महात्मभिः ।\nव्यासं शरणमापेदे प्रायश्चित्तचिकीर्षया॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003968095, "chapter_id": 23968, "verse_number": "३-१-३१-९६", "content_sanskrit": "ततो बदरिकारण्ये समासीनं महामुनिम् ।\nद्वैपायनं समागम्य प्रणनाम सभक्तिकम्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003968096, "chapter_id": 23968, "verse_number": "३-१-३१-९७", "content_sanskrit": "ततो व्यासोऽब्रवीदेनं द्रोणाचार्यसुतं मुनिः ।\nत्वमस्मदाश्रमादद्रौणे निर्याहि त्वरया त्विति॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003968097, "chapter_id": 23968, "verse_number": "३-१-३१-९८", "content_sanskrit": "सुप्तमारण दोषेण महापातकवान्भवान् ।\nअतो मे भवतालापान्महत्पापं भविष्यति ।\nइत्युक्तः स तदा द्रौणिः प्रोवाचेदं वचो मुनिः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003968098, "chapter_id": 23968, "verse_number": "३-१-३१-९९", "content_sanskrit": "अश्वत्थामोवाच ।\nभगवन्निंदितः सर्वैस्त्वामस्मि शरणं गतः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003968099, "chapter_id": 23968, "verse_number": "३-१-३१-१००", "content_sanskrit": "ब्रवीषि चेत्त्वमप्येवं कोऽन्यो मे शरणं भवेत् ।\nकृपां कुरु मयि ब्रह्मन्साधवो दीनवत्सलाः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003968100, "chapter_id": 23968, "verse_number": "३-१-३१-१०१", "content_sanskrit": "सुप्तमारणदोषस्य शांत्यर्थं भगवन्मम ।\nप्रायश्चित्तं विधेहि त्वं सर्वज्ञोऽसि भवान्यतः ।\nइत्युक्तो द्रौणिना व्यासश्चिरं ध्यात्वा तमब्रवीत्॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003968101, "chapter_id": 23968, "verse_number": "३-१-३१-१०२", "content_sanskrit": "व्यास उवाच ।\nएतत्पापस्य शांत्यर्थं प्रायश्चित्तं स्मृतौ न हि॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003968102, "chapter_id": 23968, "verse_number": "३-१-३१-१०३", "content_sanskrit": "तथाप्युपायं वक्ष्यामि तवैतद्दोष शांतये ।\nदक्षिणांबुनिधौ पुण्ये रामसेतौ विमुक्तिदे॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003968103, "chapter_id": 23968, "verse_number": "३-१-३१-१०४", "content_sanskrit": "धनुष्कोटिरितिख्यातं तीर्थमस्ति महत्तरम् ।\nअस्ति पुण्यतमं द्रौणे महापात कनाशनम्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003968104, "chapter_id": 23968, "verse_number": "३-१-३१-१०५", "content_sanskrit": "स्वर्गमोक्षप्रदं पुंसां ब्रह्महत्यादिशोधकम् ।\nसर्वमंगलमांगल्यं सर्वाभीष्टप्रदायकम्॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003968105, "chapter_id": 23968, "verse_number": "३-१-३१-१०६", "content_sanskrit": "पवित्राणां पवित्रं च तीर्थानां च तथोत्तमम् ।\nदुःस्वप्ननाशनं पुण्यं नरकक्लेशनाशनम्॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003968106, "chapter_id": 23968, "verse_number": "३-१-३१-१०७", "content_sanskrit": "अकालमृत्युशमनं पुंसां विजयवर्द्धनम् ।\nदारिद्र्यनाशनं पुंसामायुर्वर्धनकार णम्॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003968107, "chapter_id": 23968, "verse_number": "३-१-३१-१०८", "content_sanskrit": "चित्तशुद्धिप्रदं नृणां शांतिदांत्यादिकारणम् ।\nतत्र गत्वा धनुष्कोटौ रामसेतौ विमुक्तिदे॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003968108, "chapter_id": 23968, "verse_number": "३-१-३१-१०९", "content_sanskrit": "स्नानं कुरुष्व द्रौणे त्वं मासमात्रं निरं तरम् ।\nसुप्तमारणदोषात्त्वं सद्यः पूतो भविष्यसि॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003968109, "chapter_id": 23968, "verse_number": "३-१-३१-११०", "content_sanskrit": "कुरुष्व वचनं शीघ्रं मम त्वं द्रोणनंदन ।\nएवमुक्तस्तदा द्रौणिर्व्यासेन परमर्षिणा॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003968110, "chapter_id": 23968, "verse_number": "३-१-३१-१११", "content_sanskrit": "रामसेतुं समासाद्य धनुष्कोटिं पवित्रदाम् ।\nसस्नौ संकल्पपूर्वं तु मासमेकं निरन्तरम्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003968111, "chapter_id": 23968, "verse_number": "३-१-३१-११२", "content_sanskrit": "त्रिसंध्यं रामनाथं च सिषेवे स दिने दिने ।\nततस्त्रिंशद्दिने तोयस्नानाद्द्रोणात्मजस्तदा॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003968112, "chapter_id": 23968, "verse_number": "३-१-३१-११३", "content_sanskrit": "जजाप च धनुष्कोट्यां मंत्रं पंचाक्षरं तदा ।\nअकार्षीदुपवासं च द्रोणपुत्रस्तु तद्दिने॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003968113, "chapter_id": 23968, "verse_number": "३-१-३१-११४", "content_sanskrit": "अकरोज्जागरं रात्रौ रामनाथस्य सन्निधौ ।\nअपरेद्युर्धनुष्कोटौ स्नात्वा संकल्पपूर्वकम्॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003968114, "chapter_id": 23968, "verse_number": "३-१-३१-११५", "content_sanskrit": "सिषेवे रामनाथं च स्तुत्वा भक्तिपुरःसरम् ।\nननर्त पुरतः शंभोरानंदाश्रुपरिप्लुतः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003968115, "chapter_id": 23968, "verse_number": "३-१-३१-११६", "content_sanskrit": "ततः प्रसन्नो भगवान्प्रादुरासीत्तदग्रतः ।\nदृष्ट्वा तत्र महादेवं तुष्टाव परमेश्वरम्॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003968116, "chapter_id": 23968, "verse_number": "३-१-३१-११७", "content_sanskrit": "द्रौणिरुवाच ।\nनमस्ते देवदेवेश करुणाकर शंकर ।\nआपदंबुधिमग्नानां पोतायितपदांबुज॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003968117, "chapter_id": 23968, "verse_number": "३-१-३१-११८", "content_sanskrit": "महादेव कृपामूर्ते धूर्जटे नीललोहित ।\nउमाकांत विरूपाक्ष चंद्रशेखर ते नमः॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003968118, "chapter_id": 23968, "verse_number": "३-१-३१-११९", "content_sanskrit": "मृत्युंजय त्रिनेत्र त्वं पाहि मां कृपया दृशा ।\nपार्वतीपतये तुभ्यं त्रिपुरघ्नाय शंभवे॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003968119, "chapter_id": 23968, "verse_number": "३-१-३१-१२०", "content_sanskrit": "पिनाकपाणये तुभ्यं त्र्यंबकाय नमोनमः ।\nअनंतादिमहानागहारभूषणभूषित॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003968120, "chapter_id": 23968, "verse_number": "३-१-३१-१२१", "content_sanskrit": "शूलपाणे नमस्तुभ्यं गंगाधर मृडाव्यय ।\nरक्ष मां कृपया देव पापसंघातपंजरात् ।\nइति स्तुतो महादेवो द्रौणिं प्रोवाच हर्षितः॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003968121, "chapter_id": 23968, "verse_number": "३-१-३१-१२२", "content_sanskrit": "महादेव उवाच ।\nसुप्तमारणदोषस्ते धनुष्कोटौ निमज्जनात्॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003968122, "chapter_id": 23968, "verse_number": "३-१-३१-१२३", "content_sanskrit": "अश्वत्थामन्विनष्टोऽभूद्वरं वरय सुव्रत ।\nमयि प्रसन्ने लोकेषु किमलभ्यं भवेन्नृणाम्॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003968123, "chapter_id": 23968, "verse_number": "३-१-३१-१२४", "content_sanskrit": "अतोऽभीष्टं वृणीष्व त्वं मत्तो द्रोणात्मजाधुना ।\nइत्युक्तः शंभुना द्रौणिः प्राह तं परमेश्वरम्॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003968124, "chapter_id": 23968, "verse_number": "३-१-३१-१२५", "content_sanskrit": "तवाद्य दर्शनेनाहं कृतार्थोस्मि महेश्वरम् ।\nत्वद्दर्शनमपुण्यानामलभ्यं जन्मकोटिभिः॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003968125, "chapter_id": 23968, "verse_number": "३-१-३१-१२६", "content_sanskrit": "अतो युष्मत्पदांभोजे निश्चला भक्तिरस्तु मे ।\nइममेव वरं देहि मह्यं शंभो नमोऽस्तु ते॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003968126, "chapter_id": 23968, "verse_number": "३-१-३१-१२७", "content_sanskrit": "उक्त्वा तथास्त्विति द्रौणिं देवदेवो महेश्वरः ।\nपश्यतो द्रोणपुत्रस्य तत्रैवांतरधीयत॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003968127, "chapter_id": 23968, "verse_number": "३-१-३१-१२८", "content_sanskrit": "अश्वत्थामापि विप्रेंद्रा धूतपापो विनिर्मलः ।\nरामचंद्रधनुष्कोटौ स्नानमात्रेण तत्क्षणे॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003968128, "chapter_id": 23968, "verse_number": "३-१-३१-१२९", "content_sanskrit": "धूतपापमिमं द्रौणिं सर्वे चापि महर्षयः ।\nशुद्धं प्रत्यग्रहीषुस्ते तदाप्रभृति निर्मलम्॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003968129, "chapter_id": 23968, "verse_number": "३-१-३१-१३०", "content_sanskrit": "एवं वः कथितं विप्रा द्रौणिपापविमोक्षणम् ।\nरामचंद्रधनुष्कोटिस्नानवैभवमात्रतः॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003968130, "chapter_id": 23968, "verse_number": "३-१-३१-१३१", "content_sanskrit": "यः पठेदिममध्यायं शृणुयाद्वा समाहितः ।\nस विधूयेह पापानि शिवलोके महीयते॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}]