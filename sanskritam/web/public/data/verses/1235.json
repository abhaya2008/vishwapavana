[{"id": 2011481, "chapter_id": 1235, "verse_number": "१-२३६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011482, "chapter_id": 1235, "verse_number": "१-२३६-१", "content_sanskrit": "ततः समुद्रे तीर्थानि दक्षिमे भरतर्षभः।\nअभ्यगच्छत्सुपुण्यानि सोभितानि तपस्विभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011483, "chapter_id": 1235, "verse_number": "१-२३६-२", "content_sanskrit": "वर्जयन्ति स्म तीर्तानि तत्र पञ्च सम तापसाः।\nअवकीर्णानि यान्यासन्पुरस्तात्तु तपस्विभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011484, "chapter_id": 1235, "verse_number": "१-२३६-३", "content_sanskrit": "अगस्त्यतीर्थं सौभद्रं पौलोमं च सुपावनम्।\nकारन्धमं प्रसन्नं च महमेधफलं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011485, "chapter_id": 1235, "verse_number": "१-२३६-४", "content_sanskrit": "भारद्वाजस्य तीर्थं तु पापप्रशमनं महत्।\nएतानि पञ्च तीर्थानि ददर्श कुरुसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011486, "chapter_id": 1235, "verse_number": "१-२३६-५", "content_sanskrit": "विविक्तान्युपलक्ष्याथ तानि तीर्थानि पाण्डवः।\nदृष्ट्वा च वर्ज्यमानानि मुनिभिर्धर्मबुद्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011487, "chapter_id": 1235, "verse_number": "१-२३६-६", "content_sanskrit": "तपस्विनस्ततोऽपृच्छत्प्राञ्जलिः कुरुनन्दनः।\nतीर्थानीमानि वर्ज्यन्ते किमर्थं ब्रह्मवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011488, "chapter_id": 1235, "verse_number": "१-२३६-७x", "content_sanskrit": "तापसा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011489, "chapter_id": 1235, "verse_number": "१-२३६-७", "content_sanskrit": "ग्राहाः पञ्च वसन्त्येषु हरन्ति च तपोधनान्।\nतत एतानि वर्ज्यन्ते तीर्थानि कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011490, "chapter_id": 1235, "verse_number": "१-२३६-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011491, "chapter_id": 1235, "verse_number": "१-२३६-८", "content_sanskrit": "तेषां श्रुत्वा महाबाहुर्वार्यमाणस्तपोधनैः।\nजगाम तानि तीर्थानि द्रष्टुं पुरुषसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011492, "chapter_id": 1235, "verse_number": "१-२३६-९", "content_sanskrit": "ततः सौभद्रमासाद्य महर्षेस्तीर्थमुत्तमम्।\nविगाह्य सहसा शूरः स्नानं चक्रे परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011493, "chapter_id": 1235, "verse_number": "१-२३६-१०", "content_sanskrit": "अथ तं पुरुषव्याघ्रमन्तर्जलचरो महान्।\nजग्राह चरणे ग्राहः कुन्तीपुत्रं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011494, "chapter_id": 1235, "verse_number": "१-२३६-११", "content_sanskrit": "स तमादाय कौन्तेयो विस्फुरन्तं जलेचरम्।\nउदतिष्ठन्महाबाहुर्बलेन बलिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011495, "chapter_id": 1235, "verse_number": "१-२३६-१२", "content_sanskrit": "उत्कृष्ट एव ग्राहस्तु सोऽर्जुनेन यशस्विना।\nबभूव नारी कल्याणी सर्वाभरणभूषइता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011496, "chapter_id": 1235, "verse_number": "१-२३६-१३", "content_sanskrit": "दीप्यमाना श्रिया राजन्दिव्यरूपा मनोरमा।\nतदद्भुतं महद्दृष्ट्वा कुन्तीपुत्रो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011497, "chapter_id": 1235, "verse_number": "१-२३६-१४", "content_sanskrit": "तां स्त्रियं परमप्रीत इदं वचनमब्रवीत्।\nका वै त्वमसि कल्याणिकुतो वाऽसि जलेचरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011498, "chapter_id": 1235, "verse_number": "१-२३६-१५", "content_sanskrit": "किमर्थं च महत्पापमिदं कृतवती पुरा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011499, "chapter_id": 1235, "verse_number": "१-२३६-१५x", "content_sanskrit": "वर्गोवाच।\nअप्सराऽस्मि महाबाहो देवारण्यविहारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011500, "chapter_id": 1235, "verse_number": "१-२३६-१६", "content_sanskrit": "इष्टा धनपतेर्नित्यं वर्गा नाम महाबल।\nमम सख्यश्चतस्रोऽन्याः सर्वाः कामगमाः शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011501, "chapter_id": 1235, "verse_number": "१-२३६-१७", "content_sanskrit": "ताभिः सार्धं प्रयाताऽस्मि लोकपालनिवेशनम्।\nततः पश्यामहे सर्वा ब्राह्मणं संशितव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011502, "chapter_id": 1235, "verse_number": "१-२३६-१८", "content_sanskrit": "रूपवन्तमधीयानमेकमेकान्तचारिणम्।\nतस्यैव तपसा राजंस्तद्वयं तेजसा वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011503, "chapter_id": 1235, "verse_number": "१-२३६-१९", "content_sanskrit": "आदित्य इव तं देशं इत्वं सर्व व्यकाशयत्।\nतस्य दृष्ट्वा तपस्तादृग्रूपचाद्भुतमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011504, "chapter_id": 1235, "verse_number": "१-२३६-२०", "content_sanskrit": "अवतीर्णाः स्म तं देशं तपोविघ्नचिकीर्षया।\nअहं च सौरभेयी च समीची बुद्बुदा लता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011505, "chapter_id": 1235, "verse_number": "१-२३६-२१", "content_sanskrit": "यौगपद्येन तं विप्रमभ्यगच्छाम भारत।\nगायन्त्योऽथहसन्त्यश्च लोभयित्वा च तं द्विजं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011506, "chapter_id": 1235, "verse_number": "१-२३६-२२", "content_sanskrit": "स च नास्मासु कृतवान्मनो वीर कथंचन।\nनाकम्पत महातेजाः स्थितस्तपसि निर्मले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011507, "chapter_id": 1235, "verse_number": "१-२३६-२३", "content_sanskrit": "सोऽशपत्कुपितोऽस्मांस्तु ब्राह्मणः क्षत्रियर्षभ।\nग्राहभूता जले यूयं चरिष्यथ शतं समाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011508, "chapter_id": 1235, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अर्जुनवनवासपर्वणि षट्त्रिंशदधिकद्विशततमोऽध्यायः॥ २३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]