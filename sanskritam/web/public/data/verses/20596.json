[{"id": 7000596000, "chapter_id": 20596, "verse_number": "५-५५-१", "content_sanskrit": "व्यास उवाच ।\nएतां श्रुत्वा कथां रम्यां लवस्य बलिनो मुनिः ।\nसंशयानः पर्यपृच्छन्नागं दशशताननम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000596001, "chapter_id": 20596, "verse_number": "५-५५-२", "content_sanskrit": "श्रीवात्स्यायन उवाच ।\nत्वयोक्तं तु पुरा रामः सीतामेकाकिनीं वने ।\nरजकस्य दुरुक्त्यासौ तत्याज महि लोलुपः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000596002, "chapter_id": 20596, "verse_number": "५-५५-३", "content_sanskrit": "जानक्यां क्व सुतौ जातौ क्व धनुर्धरतां गतौ ।\nकथं च शिक्षिता विद्या यो रामहयमाहरत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000596003, "chapter_id": 20596, "verse_number": "५-५५-४", "content_sanskrit": "व्यास उवाच ।\nइति श्रुत्वा मुनेर्वाक्यं शेषो नागो महामतिः ।\nप्रशस्य विप्रं जगदे रामचारित्रमद्भुतम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000596004, "chapter_id": 20596, "verse_number": "५-५५-५", "content_sanskrit": "शेष उवाच ।\nरामो राज्यमयोध्यायां भ्रातृभिः सहितोऽकरोत् ।\nधर्मेण पालयन्सर्वं क्षितिखंडं स्वया स्त्रिया॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000596005, "chapter_id": 20596, "verse_number": "५-५५-६", "content_sanskrit": "सीता दधार तद्वीर्यं मासाः पंचाभवंस्तदा ।\nअत्यंतं शुशुभे देवी त्रयीव पुरुषं धरा॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000596006, "chapter_id": 20596, "verse_number": "५-५५-७", "content_sanskrit": "कदाचित्समये रामः पप्रच्छ च विदेहजाम् ।\nकीदृशो दोहदः साध्वि मया ते साध्यते हि सः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000596007, "chapter_id": 20596, "verse_number": "५-५५-८", "content_sanskrit": "रहस्येव तु सा पृष्टा त्रपमाणा पतिं सती ।\nलज्जा गद्गद वाग्रामं निजगाद वचोऽमृतम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000596008, "chapter_id": 20596, "verse_number": "५-५५-९", "content_sanskrit": "सीतोवाच ।\nत्वत्कृपातो मया सर्वं भुक्तं भोक्ष्यामि शोभनम् ।\nन कश्चिन्मानसे कांत विषयो ह्यतिरिच्यते॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000596009, "chapter_id": 20596, "verse_number": "५-५५-१०", "content_sanskrit": "यस्याभवादृशः स्वामी देवसंस्तुतसत्पदः ।\nतस्याः सर्वं वरीवर्ति न किंचिदवशिष्यते॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000596010, "chapter_id": 20596, "verse_number": "५-५५-११", "content_sanskrit": "त्वमाग्रहात्पृच्छसि मां दोहदं मनसि स्थितम् ।\nब्रवीमि पुरतः सत्यं तव स्वामिन्मनोहर॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000596011, "chapter_id": 20596, "verse_number": "५-५५-१२", "content_sanskrit": "चिरं जातं मया सत्यो लोपामुद्रादिकाः स्त्रियः ।\nदृष्ट्वा स्वामिन्मनो द्रष्टुं ता उत्सुकति सुंदरीः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000596012, "chapter_id": 20596, "verse_number": "५-५५-१३", "content_sanskrit": "राज्यं प्राप्ता त्वया सार्द्धमनेकसुखमास्थिता ।\nकृतघ्नाहं कदापीह ता नमस्कर्तुमानसा॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000596013, "chapter_id": 20596, "verse_number": "५-५५-१४", "content_sanskrit": "तत्र गत्वा तपःकोशान्वस्त्राद्यैः परिपूजये ।\nरत्नानि चैव भास्वंति भूषा अपि समर्पये॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000596014, "chapter_id": 20596, "verse_number": "५-५५-१५", "content_sanskrit": "यथा मे तोषिताः सत्यो ददत्याशीर्मनोहराः ।\nएष मे दोहदः कांत परिपूरय मानसः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000596015, "chapter_id": 20596, "verse_number": "५-५५-१६", "content_sanskrit": "इत्थमाकर्ण्य वचनं सीतायाः सुमनोहरम् ।\nजगाद परमप्रीतो रामचंद्रः प्रियां प्रति॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000596016, "chapter_id": 20596, "verse_number": "५-५५-१७", "content_sanskrit": "धन्यासि जानकी प्रातर्गमिष्यसि तपोधनाः ।\nप्रेक्ष्यतास्तु कृतार्था त्वमागमिष्यसि मेंऽतिकम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000596017, "chapter_id": 20596, "verse_number": "५-५५-१८", "content_sanskrit": "इति रामवचः श्रुत्वा परमां प्रीतिमाप सा ।\nप्रातर्मम भवत्यद्धा तापसीनां समीक्षणम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000596018, "chapter_id": 20596, "verse_number": "५-५५-१९", "content_sanskrit": "अथ तन्निशि रामेण चाराः कीर्तिं निजां श्रुताम् ।\nप्रेक्षितुं प्रेषितास्ते तु निशीथे ह्यगमनञ्छनैः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000596019, "chapter_id": 20596, "verse_number": "५-५५-२०", "content_sanskrit": "ते प्रत्यहं रामकथाः शृण्वंतः सुमनोहराः ।\nतद्दिने गतवंतस्तु धनाढ्यस्य गृहं महत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000596020, "chapter_id": 20596, "verse_number": "५-५५-२१", "content_sanskrit": "दीपं वीक्ष्य प्रज्वलंतं वचनं वीक्ष्य मानुषम् ।\nस्थितास्तत्र क्षणं चाराः समशृण्वन्यशो भृशम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000596021, "chapter_id": 20596, "verse_number": "५-५५-२२", "content_sanskrit": "तत्र काचन वामाक्षी बालकं प्रति हर्षिता ।\nस्तनं धयंतं निजगौ वाक्यं तु सुमनोहरम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000596022, "chapter_id": 20596, "verse_number": "५-५५-२३", "content_sanskrit": "पिब पुत्र यथेष्टं त्वं स्तन्यं मम मनोहरम् ।\nपश्चात्तव सुदुष्प्रापं भविष्यति ममात्मज॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000596023, "chapter_id": 20596, "verse_number": "५-५५-२४", "content_sanskrit": "एतत्पुर्याः पती रामो नीलोत्पलदलप्रभः ।\nतत्पुरीस्थजनानां तु न भविष्यति वै जनुः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000596024, "chapter_id": 20596, "verse_number": "५-५५-२५", "content_sanskrit": "जन्माभावात्कथं पानं स्तन्यस्य भुवि जायते ।\nतस्मात्पिब मुहुः स्तन्यं दुर्ल्लभं हृदि मन्य च॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000596025, "chapter_id": 20596, "verse_number": "५-५५-२६", "content_sanskrit": "ये श्रीरामं स्मरिष्यंति ध्यायंति च वदंति ये ।\nतेषामपि पयःपानं न भविष्यति जातुचित्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000596026, "chapter_id": 20596, "verse_number": "५-५५-२७", "content_sanskrit": "इत्यादिवाक्यं संश्रुत्य श्रीरामयशसोऽमृतम् ।\nहर्षिताः प्रययुर्गेहमन्यद्भाग्यवतो महत्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000596027, "chapter_id": 20596, "verse_number": "५-५५-२८", "content_sanskrit": "तावदन्यश्चरस्तत्र मनोरममिदं गृहम् ।\nमत्वा तिष्ठन्हि रामस्य क्षणं शुश्रूषया यशः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000596028, "chapter_id": 20596, "verse_number": "५-५५-२९", "content_sanskrit": "तत्र काचिन्निजं कांतं पर्यंकोपरि सुस्थितम् ।\nतांबूलं चर्वती दत्तं भर्त्तास्नेहेन सुंदरी॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000596029, "chapter_id": 20596, "verse_number": "५-५५-३०", "content_sanskrit": "कंकणस्वरशोभाढ्या कर्पूरागरुधूपिता ।\nकांतं वीक्ष्य चलन्नेत्रा कामरूपमवोचत॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000596030, "chapter_id": 20596, "verse_number": "५-५५-३१", "content_sanskrit": "नाथ त्वं तादृशो मह्यं भासि यादृग्रघोः पतिः ।\nअत्यंतं सुंदरतरं वपुर्बिभ्रत्सुकोमलम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000596031, "chapter_id": 20596, "verse_number": "५-५५-३२", "content_sanskrit": "पद्मप्रांतं नेत्रयुग्मं वक्षो मोहनविस्तृतम् ।\nभुजौ च सांगदौ बिभ्रत्साक्षाद्राम इवासि मे॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000596032, "chapter_id": 20596, "verse_number": "५-५५-३३", "content_sanskrit": "इति वाक्यं समाकर्ण्य कांतायाः सुमनोहरम् ।\nउवाच नेत्रयोः प्रांतं नर्तयन्कामसुंदरः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000596033, "chapter_id": 20596, "verse_number": "५-५५-३४", "content_sanskrit": "शृणु कांते त्वया प्रोक्तं साध्व्या तु सुमनोहरम् ।\nपतिव्रतानां तद्योग्यं स्वकांतो राम एव हि॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000596034, "chapter_id": 20596, "verse_number": "५-५५-३५", "content_sanskrit": "परं क्वाहं मंदभाग्यः क्व रामो भाग्यवान्महान् ।\nक्व चाहं कीटवत्तुच्छः क्व ब्रह्मादिसुरार्चितः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000596035, "chapter_id": 20596, "verse_number": "५-५५-३६", "content_sanskrit": "खद्योतः क्व नभोरत्नं शलभः क्व नु पामरः ।\nगजारिः क्व मृगेंद्रोऽसौ शशकः क्व नु मंदधीः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000596036, "chapter_id": 20596, "verse_number": "५-५५-३७", "content_sanskrit": "क्व च सा जाह्नवी देवी क्व रथ्या जलमुत्पथम् ।\nक्व मेरुः सुरसंवासः क्व गुंजापुंजकोल्पकः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000596037, "chapter_id": 20596, "verse_number": "५-५५-३८", "content_sanskrit": "तथाहं क्व क्व रामोऽसौ यत्पादरजसांगना ।\nशिलीभूता क्षणाज्जाता ब्रह्ममोहनरूपधृक्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000596038, "chapter_id": 20596, "verse_number": "५-५५-३९", "content_sanskrit": "इति वाक्यं प्रब्रुवाणं परिरेभे निजं पतिम् ।\nजातकामा हृतप्रेम्णा नर्तित भ्रू धनुर्धरा॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000596039, "chapter_id": 20596, "verse_number": "५-५५-४०", "content_sanskrit": "इत्यादि वाक्यं संश्रुत्य गतश्चान्यनिवेशनम् ।\nतावदन्यश्चरो वाक्यं शुश्राव यशसान्वितम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000596040, "chapter_id": 20596, "verse_number": "५-५५-४१", "content_sanskrit": "काचित्पुष्पमयीं शय्यां चंदनं सह चंद्रकम् ।\nसर्वं विधाय कामार्हं जगाद वचनं पतिम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000596041, "chapter_id": 20596, "verse_number": "५-५५-४२", "content_sanskrit": "पते कुरुष्व भोगार्हे शयनं पुष्पमंचके ।\nचंदनादिकलेपं च तथा भोगमनेकधा॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000596042, "chapter_id": 20596, "verse_number": "५-५५-४३", "content_sanskrit": "त्वादृशा एव भोगार्हा न च रामपराङ्मुखाः ।\nसर्वं रामकृपाप्राप्तमुपभुंक्ष्व यथातथम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000596043, "chapter_id": 20596, "verse_number": "५-५५-४४", "content_sanskrit": "मत्सदृशी कामिनी ते चंदनं तापहारकम् ।\nपर्यंकः पुष्परचितः सर्वं रामकृपाभवम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000596044, "chapter_id": 20596, "verse_number": "५-५५-४५", "content_sanskrit": "ये रामं न भजिष्यंति ते नरा जठरं स्वयम् ।\nन भर्तुं शक्नुवंत्येव वस्त्रभोगादि वर्जिताः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000596045, "chapter_id": 20596, "verse_number": "५-५५-४६", "content_sanskrit": "इति ब्रुवंतीं महिलां हर्षितः पतिरब्रवीत् ।\nसर्वं तथ्यं ब्रवीषि त्वं मम रामकृपाभवम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000596046, "chapter_id": 20596, "verse_number": "५-५५-४७", "content_sanskrit": "इत्येवं रामभद्रस्य यशः श्रुत्वा गतश्चरः ।\nतावदन्यस्य वेश्मस्थश्चरोऽन्य शुश्रुवे वचः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000596047, "chapter_id": 20596, "verse_number": "५-५५-४८", "content_sanskrit": "काचित्कांतेन पर्यंके वीणावादनतत्परा ।\nकांतेन रामसत्कीर्तिं गायमाना पतिं जगौ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000596048, "chapter_id": 20596, "verse_number": "५-५५-४९", "content_sanskrit": "स्वामिन्वयं धन्यतमा येषां पुर्याः पतिः प्रभुः ।\nश्रीरामः स्वप्रजाः पुत्रानिव पाति च रक्षकः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000596049, "chapter_id": 20596, "verse_number": "५-५५-५०", "content_sanskrit": "यो महत्कर्मदुःसाध्यं कृतवान्सुलभं न तत् ।\nसमुद्रं यो निजग्राह सेतुं तत्र बबंध च॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000596050, "chapter_id": 20596, "verse_number": "५-५५-५१", "content_sanskrit": "रावणं यो रिपुं हत्वा लंकां संभज्य वानरैः ।\nजानकीमाजहारात्र महदाचारमाचरत्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000596051, "chapter_id": 20596, "verse_number": "५-५५-५२", "content_sanskrit": "इति प्रोक्तं समाकर्ण्य वचः सुमधुराक्षरम् ।\nपतिः स्मितं चकारेमां वाक्यं पुनरथाब्रवीत्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000596052, "chapter_id": 20596, "verse_number": "५-५५-५३", "content_sanskrit": "मुग्धेनेदं महत्कर्म रामचंद्रस्य भामिनी ।\nदशाननवधादीनि समुद्र दमनानि च॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000596053, "chapter_id": 20596, "verse_number": "५-५५-५४", "content_sanskrit": "लीलयायोऽवनिं प्राप्तो ब्रह्मादिप्रार्थितो महान् ।\nकरोति सच्चरित्राणि महापापहराणि च॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000596054, "chapter_id": 20596, "verse_number": "५-५५-५५", "content_sanskrit": "मा जानीहि नरं रामं कौसल्यानंददायकम् ।\nसृजत्यवति हंत्येतद्विश्वं लीलात्तमानुषः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000596055, "chapter_id": 20596, "verse_number": "५-५५-५६", "content_sanskrit": "धन्या वयं ये रामस्य पश्यामो मुखपंकजम् ।\nब्रह्मादिसुरदुर्दर्शं महत्पुण्यकृतो वयम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000596056, "chapter_id": 20596, "verse_number": "५-५५-५७", "content_sanskrit": "अशृणोद्रामचंद्रस्य चरित्रं श्रुतिसौख्यदम् ।\nइत्यादिवाक्यं शुश्राव चारो द्वारिस्थितो मुहुः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000596057, "chapter_id": 20596, "verse_number": "५-५५-५८", "content_sanskrit": "अन्यो ह्यन्यं गृहं गत्वा तस्थौ श्रोतुं हरेर्यशः ।\nतत्रापि रामभद्रस्य यशः शुश्राव शोभनम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000596058, "chapter_id": 20596, "verse_number": "५-५५-५९", "content_sanskrit": "खेलंती स्वामिना सार्धं द्यूतेन सुमनोहरा ।\nउवाच वाक्यं मधुरं नर्तयंतीव कंकणे॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000596059, "chapter_id": 20596, "verse_number": "५-५५-६०", "content_sanskrit": "जितं मया कांत जवेन सर्वं ।\nकरिष्यसि त्वं किमु हारिमानसः ।\nइत्यादि वाक्यं परिहासपूर्वकं ।\nकृत्वा स्वकांतं परिषस्वजे मुदा॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000596060, "chapter_id": 20596, "verse_number": "५-५५-६१", "content_sanskrit": "उवाच कांतश्चार्वंगि जितमेव सुशोभने ।\nरामं मे स्मरतो नित्यं न कुत्रापि पराजयः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000596061, "chapter_id": 20596, "verse_number": "५-५५-६२", "content_sanskrit": "इदानीं त्वां तु जेष्यामि रामं स्मृत्वा मनोहरम् ।\nदेवा यथा पुरा स्मृत्वा दितिजानजयन्क्षणात्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000596062, "chapter_id": 20596, "verse_number": "५-५५-६३", "content_sanskrit": "एवमुक्त्वा पाशकानां परिवर्तनमाकरोत् ।\nतावज्जयं प्रपेदेऽसौ हर्षितो वाक्यमब्रवीत्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000596063, "chapter_id": 20596, "verse_number": "५-५५-६४", "content_sanskrit": "मम प्रोक्तमृतं जातं जिता त्वं नवयौवना ।\nरामस्मारी कदाप्येव न भवेद्रिपुतो भयी॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000596064, "chapter_id": 20596, "verse_number": "५-५५-६५", "content_sanskrit": "इत्येवं तौ वदंतौ च परस्परमथोत्सुकौ ।\nपरिरभ्य दृढं प्रेम्णा ततश्चारो गतो गृहम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000596065, "chapter_id": 20596, "verse_number": "५-५५-६६", "content_sanskrit": "एवं पंचमहाचारा राज्ञः संश्रुत्य वै यशः ।\nपरस्परं प्रशंसंतो गेहं स्वं स्वं ययुर्मुदा॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000596066, "chapter_id": 20596, "verse_number": "५-५५-६७", "content_sanskrit": "एकः षष्ठश्चरः कारुगेहानालोक्य तत्र ह ।\nजगाम श्रोतुकामोऽसौ यशो राज्ञो महीपतेः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000596067, "chapter_id": 20596, "verse_number": "५-५५-६८", "content_sanskrit": "रजकः क्रोधसंस्पृष्टो भार्यामन्यगृहोषिताम् ।\nपदा संताडयामास धिक्कुर्वञ्छोणनेत्रवान्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000596068, "chapter_id": 20596, "verse_number": "५-५५-६९", "content_sanskrit": "गच्छ त्वं मद्गृहात्तस्य गेहं यत्रोषिता दिनम् ।\nनाहं गृह्णामि भवतीं दुष्टां वचनलंघिनीम्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000596069, "chapter_id": 20596, "verse_number": "५-५५-७०", "content_sanskrit": "तदास्य माता प्रोवाच मा त्यजैनां गृहागताम् ।\nअपराधेन रहितां दुष्टकर्मविवर्जिताम्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000596070, "chapter_id": 20596, "verse_number": "५-५५-७१", "content_sanskrit": "मातरं प्रत्युवाचाथ रजकः क्रोधसंयुतः ।\nनाहं रामैव प्रेष्ठां गृह्णाम्यन्यगृहोषिताम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000596071, "chapter_id": 20596, "verse_number": "५-५५-७२", "content_sanskrit": "स राजा यत्करोत्येव तत्सर्वं नीतिमद्भवेत् ।\nअहं गृह्णामि नो भार्यां परवेश्मनि संस्थिताम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000596072, "chapter_id": 20596, "verse_number": "५-५५-७३", "content_sanskrit": "पुनःपुनरुवाचेदं नाहं रामो महीश्वरः ।\nयः परस्य गृहे संस्थां जानकीं वै ररक्ष सः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000596073, "chapter_id": 20596, "verse_number": "५-५५-७४", "content_sanskrit": "इति वाक्यं समाश्रुत्य चारः क्रोधपरिप्लुतः ।\nखड्गं गृहीत्वा स्वकरे तं हंतुं विदधे मनः॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000596074, "chapter_id": 20596, "verse_number": "५-५५-७५", "content_sanskrit": "स रामोक्तं च सस्मार न वध्यः कोपि मे जनः ।\nइति ज्ञात्वा सरोषं तु संजहार महामनाः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000596075, "chapter_id": 20596, "verse_number": "५-५५-७६", "content_sanskrit": "तदा श्रुत्वा सुदुःखार्तः पंचचारा यतः स्थिताः ।\nततो गतः प्रकुपितो निःश्वसन्मुहुरुच्छ्वसन्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000596076, "chapter_id": 20596, "verse_number": "५-५५-७७", "content_sanskrit": "ते वै परस्परं तत्र मिलितास्तु समब्रुवन् ।\nस्वश्रुतं रामचरितं सर्वलोकैकपूजितम्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000596077, "chapter_id": 20596, "verse_number": "५-५५-७८", "content_sanskrit": "ते तद्भाषितमाकर्ण्य परस्परममंत्रयन् ।\nन वाच्यं रघुनाथाया वाच्यं दुष्टजनोदितम्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]