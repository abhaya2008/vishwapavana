[{"id": 2001752, "chapter_id": 1032, "verse_number": "१-३३-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001753, "chapter_id": 1032, "verse_number": "१-३३-१", "content_sanskrit": "जाम्बूनदमयो भूत्वा मरीचिनिकरोज्ज्वलः।\nप्रविवेश बलात्पक्षी वारिवेग इवार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001754, "chapter_id": 1032, "verse_number": "१-३३-२", "content_sanskrit": "स चक्रं क्षुरपर्यन्तमपश्यदमृतान्तिके।\nपरिभ्रमन्तमनिशं तीक्ष्णधारमयस्मयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001755, "chapter_id": 1032, "verse_number": "१-३३-३", "content_sanskrit": "ज्वलनार्कप्रभं घोरं छेदनं सोमहारिणाम्।\nघोररूपं तदत्यर्थं यन्त्रं देवैः सुनिर्मितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001756, "chapter_id": 1032, "verse_number": "१-३३-४", "content_sanskrit": "तस्यान्तरं स दृष्ट्वै पर्यवर्तत खेचरः।\nअरान्तरेणाभ्यपतत्संक्षिप्याङ्गं क्षणेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001757, "chapter_id": 1032, "verse_number": "१-३३-५", "content_sanskrit": "अधश्चक्रस्य चैवात्र दीप्तानलसमद्व्युती।\nविद्युज्जिह्वौ महावीर्यौ दीप्तास्यौ दीप्तलोचनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001758, "chapter_id": 1032, "verse_number": "१-३३-६", "content_sanskrit": "चक्षुर्विषौ महाघोरौ नित्यं क्रुद्धौ तरस्विनौ।\nअमृतस्यैव रक्षार्थं ददर्श भुजगोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001759, "chapter_id": 1032, "verse_number": "१-३३-७", "content_sanskrit": "सदा संरब्धनयनौ सदा चानिमिषेक्षणौ।\nतयोरेकोऽपि यं पश्येत्स तूर्णं भस्मसाद्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001760, "chapter_id": 1032, "verse_number": "१-३३-८", "content_sanskrit": "तौ दृष्ट्वा सहसा खेदं जगाम विनतात्मजः।\nकथमेतौ महावीर्यौ जेतव्यौ हरिभोजिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001761, "chapter_id": 1032, "verse_number": "१-३३-९", "content_sanskrit": "इति संचिन्त्य गरुडस्तयोस्तूर्णं निराकरः।\nतयोश्चक्षूंषि रजसा सुपर्णः सहसाऽऽवृणोत्।\nताभ्यामदृष्टरूपोऽसौ सर्वतः समताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001762, "chapter_id": 1032, "verse_number": "१-३३-१०", "content_sanskrit": "तयोरङ्गे समाक्रम्य वैनतेयोऽन्तरिक्षगः।\nआच्छिनत्तरसा मध्ये सोममभ्यद्रवत्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001763, "chapter_id": 1032, "verse_number": "१-३३-११", "content_sanskrit": "समुत्पाट्यामृतं तत्र वैनतेयस्ततो बली।\nउत्पपात जवेनैव यन्त्रमुन्मथ्य वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001764, "chapter_id": 1032, "verse_number": "१-३३-१२", "content_sanskrit": "अपीत्वैवामृतं पक्षी परिगृह्याशु निःसृतः।\nआगच्छदपरिश्रान्त आवार्यार्कप्रभां ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001765, "chapter_id": 1032, "verse_number": "१-३३-१३", "content_sanskrit": "विष्णुना च तदाकाशे वैनतेयः समेयिवान्।\nतस्य नारायणस्तुष्टस्तेनालौल्येन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001766, "chapter_id": 1032, "verse_number": "१-३३-१४", "content_sanskrit": "तमुवाचाव्ययो देवो वरदोऽस्मीति खेचरम्।\nस वव्रे तव तिष्ठेयमुपरीत्यन्तरिक्षगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001767, "chapter_id": 1032, "verse_number": "१-३३-१५", "content_sanskrit": "उवाच चैनं भूयोऽपि नारायणमिदं वचः।\nअजरश्चामरश्च स्याममृतेन विनाऽप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001768, "chapter_id": 1032, "verse_number": "१-३३-१६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001769, "chapter_id": 1032, "verse_number": "१-३३-१६", "content_sanskrit": "एवमस्त्विति तं विष्णुरुवाच विनतासुतम्।\nप्रतिगृह्य वनौ तौ च गरुडो विष्णुमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001770, "chapter_id": 1032, "verse_number": "१-३३-१७", "content_sanskrit": "भवतेपि वरं दद्यां वृणोतु भगवानपि।\nतं वव्रे वाहनं विष्णुर्नरुत्मन्तं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001771, "chapter_id": 1032, "verse_number": "१-३३-१८", "content_sanskrit": "ध्वजं च चक्रे भगवानुपरि स्थास्यसीति तम्।\nएवमस्त्विति तं देवमुक्त्वा नारायणं खगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001772, "chapter_id": 1032, "verse_number": "१-३३-१९", "content_sanskrit": "वव्राज तरसा वेगाद्वायुं स्पर्धन्महाजवः।\nतं व्रजन्तं खगश्रेष्ठं वज्रेणेन्द्रोऽभ्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001773, "chapter_id": 1032, "verse_number": "१-३३-२०", "content_sanskrit": "हरन्तममृतं रोषाद्गरुडं पक्षिणां वरम्।\nतमुवाचेन्द्रमाक्रन्दे गरुडः पततां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001774, "chapter_id": 1032, "verse_number": "१-३३-२१", "content_sanskrit": "प्रहसञ्श्लक्ष्णया वाचा तथा वज्रसमाहतः।\nऋषेर्मानं करिष्यामि वज्रं यस्यास्थिसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001775, "chapter_id": 1032, "verse_number": "१-३३-२२", "content_sanskrit": "वज्रस्य च करिष्यामि तवैव च शतक्रतो।\nएतत्पत्रं त्यजाम्येकं यस्यान्तं नोपलप्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001776, "chapter_id": 1032, "verse_number": "१-३३-२३", "content_sanskrit": "न च वज्रनिपातेन रुजा मेऽस्तीह काचन।\nएवमुक्त्वा ततः पुत्रमुत्ससर्ज स पक्षिराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001777, "chapter_id": 1032, "verse_number": "१-३३-२४", "content_sanskrit": "तदुत्सृष्टमभिप्रेक्ष्य तस्य पर्णमनुत्तमम्।\nहृष्टानि सर्धभूतानि नाम चक्रुर्गरुत्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001778, "chapter_id": 1032, "verse_number": "१-३३-२५", "content_sanskrit": "सुरूपं पत्रमालक्ष्य सुपर्णोऽयं भवत्विति।\nतद्दृष्ट्वा महदाश्चर्यं सहस्राक्षः पुरंदरः।\nखगो महदिदं भूतमिति मत्वाऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001779, "chapter_id": 1032, "verse_number": "१-३३-२६", "content_sanskrit": "बलं विज्ञातुमिच्छामि यत्ते परमनुत्तमम्।\nसख्यं चानन्तमिच्छामि त्वया सह खगोत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001780, "chapter_id": 1032, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीपर्वणि त्रयस्त्रिंशोऽध्यायः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]