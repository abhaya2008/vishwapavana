[{"id": 7001043000, "chapter_id": 21043, "verse_number": "५-२५-१", "content_sanskrit": "वने विचरतस्तस्य सह गोपैर्महात्मनः ।\nमानुषच्छद्मरूपस्य शेषस्य धरणीभृतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001043001, "chapter_id": 21043, "verse_number": "५-२५-२", "content_sanskrit": "निष्पादितोरुकाय्यस्य काय्यणोर्व्वीविचारिणः ।\nउपभोगाथमत्यर्थ वरुणः प्राह वारुणीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001043002, "chapter_id": 21043, "verse_number": "५-२५-३", "content_sanskrit": "अभीष्टा सर्व्वदा यस्य मदिरे त्व!महौजसः ।\nअनन्तस्यौपभोगाय तस्य गच्छ मुदे शुभे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001043003, "chapter_id": 21043, "verse_number": "५-२५-४", "content_sanskrit": "इत्युक्ता वारुणी तेन सन्निधानमथाकरोत् ।\nवृन्दावनवनोतूपन्न-कदम्बतरुकोटरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001043004, "chapter_id": 21043, "verse_number": "५-२५-५", "content_sanskrit": "विचरन् बलदेवोऽपि मदिरागन्धमुत्तमम् ।\nआघ्राय मादरातर्षमवापाथ पुरातनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001043005, "chapter_id": 21043, "verse_number": "५-२५-६", "content_sanskrit": "ततः कदम्बात् सहसा मद्यधारां स लाङ्गली ।\nपतन्तीं वीक्ष्य मंत्रेय !प्रययौ परमां मुदम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001043006, "chapter_id": 21043, "verse_number": "५-२५-७", "content_sanskrit": "पपौ च गोपगोपीभिः समवेतो मुदान्वितः ।\nप्रगीयमानो ललितं गीतवाद्यविशारदैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001043007, "chapter_id": 21043, "verse_number": "५-२५-८", "content_sanskrit": "समन्तोतूपन्न-घर्म्माम्भः कणिकामौक्तिकोज्जवलः ।\nआगच्छ यमुने! स्त्रतुमिच्चामीत्त्याह विह्वलः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001043008, "chapter_id": 21043, "verse_number": "५-२५-९", "content_sanskrit": "तस्य वाचं नदी सा च मत्तोक्तामवमत्य वै ।\nनाजगाम ततः क्रुद्धो हलं जग्राह लाङ्गली ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001043009, "chapter_id": 21043, "verse_number": "५-२५-१०", "content_sanskrit": "गृहीत्वा तां तटे तेन चकर्ष मदविह्वलः ।\nपापे नायासि नायासि गम्यतामिच्छयात्मनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001043010, "chapter_id": 21043, "verse_number": "५-२५-११", "content_sanskrit": "सा कृष्टा तेन सहसा गार्ग सन्त्यज्य निम्रगा ।\nयत्रास्ते बलभद्रोऽसौ प्लावयामास तदूनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001043011, "chapter_id": 21043, "verse_number": "५-२५-१२", "content_sanskrit": "शरीरिणी तथोत्पत्य त्रासविह्वललोचना ।\nप्रसीदेत्यब्रवीद् रामं मुञ्च मां मुषलायुध ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001043012, "chapter_id": 21043, "verse_number": "५-२५-१३", "content_sanskrit": "सोऽब्रवीदवजानासि मम शौर्य्यबले यदि ।\nसोऽहं त्वां हलपातेन विनेष्यामि सहस्त्रधा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001043013, "chapter_id": 21043, "verse_number": "५-२५-१४", "content_sanskrit": "इत्युक्तयातिसन्त्रासात् तया नद्या प्रसादितः ।\nभूभागे प्लाविते तस्मिन् मुमोच यमुनां बलः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001043014, "chapter_id": 21043, "verse_number": "५-२५-१५", "content_sanskrit": "ततः स्त्रातस्य वै कान्तिराजगाम महात्मनः ।\nअवतंसोतूपलं चारु गृहीत्वैकञ्च कुण्डलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001043015, "chapter_id": 21043, "verse_number": "५-२५-१६", "content_sanskrit": "वरुणप्रहितां चास्मै मालामम्लानपङ्कजाम् ।\nसमूद्राभे तथा वस्त्रे नीले लक्ष्मीरयच्छत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001043016, "chapter_id": 21043, "verse_number": "५-२५-१७", "content_sanskrit": "कृतावतंसः स तदा चारुकुण्जलभूषितः ।\nनीलाम्बरधरः स्क्षग्वी शुशुबे कान्तिसंयुतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001043017, "chapter_id": 21043, "verse_number": "५-२५-१८", "content_sanskrit": "इत्थं विभूषितो रेमे तत्र रामस्तथा व्रजे ।\nमासदूयेन यातश्व पुनः स द्रारकां पुरीम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001043018, "chapter_id": 21043, "verse_number": "५-२५-१९", "content_sanskrit": "रेवतीं नाम तनयां रैवतस्य महीपतेः ।\nउपयेमे बलस्तस्यां जज्ञाते निशठोल्मुकौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]