[{"id": 2004432, "chapter_id": 1088, "verse_number": "१-८९-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004433, "chapter_id": 1088, "verse_number": "१-८९-१", "content_sanskrit": "भगवन्विस्तरेणेह भरतस्य महात्मनः।\nजन्म कर्म च सुश्रूषोस्तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004434, "chapter_id": 1088, "verse_number": "१-८९-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004435, "chapter_id": 1088, "verse_number": "१-८९-२", "content_sanskrit": "पौरवाणां वंशकरो दुष्यन्तो नाम वीर्यवान्।\nपृथिव्याश्चतुरन्ताया गोप्ता भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004436, "chapter_id": 1088, "verse_number": "१-८९-३", "content_sanskrit": "चतुर्भागं भुवः कृत्स्नं यो भुङ्क्ते मनुजेश्वरः।\nसमुद्रावरणांश्चापि देशान्स समितिंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004437, "chapter_id": 1088, "verse_number": "१-८९-४", "content_sanskrit": "आम्लेच्छावधिकान्सर्वान्स भुङ्क्ते रिपुमर्दनः।\nरत्नाकरसमुद्रान्तांश्चातुर्वर्ण्यजनावृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004438, "chapter_id": 1088, "verse_number": "१-८९-५", "content_sanskrit": "न वर्णसङ्करकरो न कृष्याकरकृज्जनः।\nन पापकृत्कश्चिदासीत्तस्मिन्राजनि शासति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004439, "chapter_id": 1088, "verse_number": "१-८९-६", "content_sanskrit": "धर्मे रतिं सेवमाना धर्मार्थावभिपेदिरे।\nतदा नरा नरव्याघ्र तस्मिञ्जनपदेश्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004440, "chapter_id": 1088, "verse_number": "१-८९-७", "content_sanskrit": "नासीच्चोरभयं तात न क्षुधाभयमण्वपि।\nनासीद्व्याधिभयं चापि तस्मिञ्जनपदेश्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004441, "chapter_id": 1088, "verse_number": "१-८९-८", "content_sanskrit": "स्वधर्मै रेमिरे वर्णा दैवे कर्मणि निःस्पृहाः।\nतमाश्रित्य महीपालमासंश्चैवाकुतोभयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004442, "chapter_id": 1088, "verse_number": "१-८९-९", "content_sanskrit": "कालवर्षी च पर्जन्यः सस्यानि रसवन्ति च।\nसर्वरत्नसमृद्धा च मही पशुमती तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004443, "chapter_id": 1088, "verse_number": "१-८९-१०", "content_sanskrit": "स्वकर्मनिरता विप्रा नानृतं तेषु विद्यते।\nस चाद्भुतमहावीर्यो वज्रसंहननो युवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004444, "chapter_id": 1088, "verse_number": "१-८९-११", "content_sanskrit": "उद्यम्य मन्दरं दोर्भ्यां वहेत्सवनकाननम्।\nचतुष्पथगदायुद्धे सर्वप्रहरणेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004445, "chapter_id": 1088, "verse_number": "१-८९-१२", "content_sanskrit": "नागपृष्ठेऽश्वपृष्ठे च बभूव परिनिष्ठतः।\nबले विष्णुसमश्चासीत्तेजसा भास्करोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004446, "chapter_id": 1088, "verse_number": "१-८९-१३", "content_sanskrit": "अक्षोभ्यत्वेऽर्णवसमः सहिष्णुत्वे धरासमः।\nसंमतः स महीपालः प्रसन्नपुरराष्ट्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004447, "chapter_id": 1088, "verse_number": "१-८९-१४", "content_sanskrit": "भूयो धर्मपरैर्भावैर्मुदितं जनमादिशत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004448, "chapter_id": 1088, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकोननवतितमोऽध्यायः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]