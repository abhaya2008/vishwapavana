[{"id": 7003533000, "chapter_id": 23533, "verse_number": "१७३-१", "content_sanskrit": "श्रीवराह उवाच ।\nतत्र स्थित्वा यथान्यायं गोकर्णः सर्वमंगलम् ।\nशुकं च मातापितरौ साधुभार्याचतुष्टयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003533001, "chapter_id": 23533, "verse_number": "१७३-२", "content_sanskrit": "संमान्य पूजयामास यथाविभवशक्तितः ।\nमथुरावासिभिर्लोकैरुद्यानं कारयंस्तदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003533002, "chapter_id": 23533, "verse_number": "१७३-३", "content_sanskrit": "स्वयं च कृतवांस्तत्र अविघ्नस्य महामखम् ।\nभक्ष्यभोज्ये ब्राह्मणेभ्यो ददौ दानानि नित्यशः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003533003, "chapter_id": 23533, "verse_number": "१७३-४", "content_sanskrit": "गीतवादित्रमंगल्यं पुत्रवृद्धौ यथोचितम् ।\nतत्सर्वं कृतवाँल्लोको गोकर्णस्य महात्मनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003533004, "chapter_id": 23533, "verse_number": "१७३-५", "content_sanskrit": "एकैकं च परिष्वज्य प्रणिपत्य यथाक्रमम् ।\nमातापित्रोः प्रणम्याथ शिरसा पादपंकजे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003533005, "chapter_id": 23533, "verse_number": "१७३-६", "content_sanskrit": "शुकं हृदि समालोक्य प्ररुरोद स वै वणिक् ।\nयस्य प्रसादाज्जीवश्च धर्मश्चानुत्तमा गतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003533006, "chapter_id": 23533, "verse_number": "१७३-७", "content_sanskrit": "विशिष्टेन   मया प्राप्तो राज्ञो लाभः सुपुष्कलः ।\nशुक पुत्रान्मया प्राप्तमिह लोके परत्र च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003533007, "chapter_id": 23533, "verse_number": "१७३-८", "content_sanskrit": "एवं वसन्सुखं तत्र गोकर्णः सह बन्धुभिः ।\nशुक नाम्ना कृतं तेन शिवस्यायतनं महत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003533008, "chapter_id": 23533, "verse_number": "१७३-९", "content_sanskrit": "शुकेश्वरं प्रतिष्ठाप्य दिव्यं सत्रं चकार ह ।\nब्राह्मणानां शते द्वे च मिष्टान्नवरभोजने ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003533009, "chapter_id": 23533, "verse_number": "१७३-१०", "content_sanskrit": "शुकसत्रमिति ख्यातं मृतो मुक्तिमवाप सः ।\nविमानवरमारुह्य स्वर्गलोकं गतः शुकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003533010, "chapter_id": 23533, "verse_number": "१७३-११", "content_sanskrit": "शुकप्रदाने गोकर्णः फलं स्नानस्य संगमात्।\nश्राद्धं सुवर्णैर्गोदानं कृत्वा तस्मै ददौ च सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003533011, "chapter_id": 23533, "verse_number": "१७३-१२", "content_sanskrit": "शबराय सभार्याय तेन स्वर्गं गतश्च ह ।\nशुकोदरेण सहितो विमानवरमास्थितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003533012, "chapter_id": 23533, "verse_number": "१७३-१३", "content_sanskrit": "एतत्ते कथितं सर्वं मथुरायां महत्फलम् ।\nसरस्वतीसंगमस्य गोकर्णस्य शिवस्य च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003533013, "chapter_id": 23533, "verse_number": "१७३-१४", "content_sanskrit": "गोकर्णस्य तु सन्तानमक्षयं धर्मतोऽव्ययम् ।\nसम्भूतं स सुखं भुक्त्वा ततो मोक्षमवाप्नुयात् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]