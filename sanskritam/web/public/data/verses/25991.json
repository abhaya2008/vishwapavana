[{"id": 7005991000, "chapter_id": 25991, "verse_number": "१-१७४-१", "content_sanskrit": "धन्वतरिरुवाच । घृततैलादि वक्ष्यामि शृणु सुश्रुत रोगनुत् ।\nशङ्खपुष्पी वचा सोमा ब्राह्मी ब्रह्मसुवर्चला ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005991001, "chapter_id": 25991, "verse_number": "१-१७४-२", "content_sanskrit": "अभया च गुडूची च अटरूपकवागुजी ।\nएतैरक्षसमैर्भागैर्घृतप्रस्थं विपाचयेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005991002, "chapter_id": 25991, "verse_number": "१-१७४-३", "content_sanskrit": "कण्टकार्या रसप्रस्थक्षीरप्रस्थममन्वितम ।\nएतद्ब्राह्मीघृतं नाम श्रुतिमेधाकरं परम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005991003, "chapter_id": 25991, "verse_number": "१-१७४-४", "content_sanskrit": "त्रिफलाचित्रकबलानिर्गुण्डी निम्बवासकाः ।\nपुनर्नवा गुडूची च बृहती च शतावरी ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005991004, "chapter_id": 25991, "verse_number": "१-१७४-५", "content_sanskrit": "एतैर्घृतं यथालाभं ।\nबलाशतकषाये तु तैलस्यार्धाढकं पचेत् ।\nकल्कैर्मधूकमञ्जिष्ठाचन्दनोत्पलपद्मकैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005991005, "chapter_id": 25991, "verse_number": "१-१७४-६", "content_sanskrit": "सूक्ष्मैलापिप्पलीकुष्ठत्वगेलागुरुकेसरैः ।\nगन्धाश्वजीवनीयैश्च क्षीराढकसमाश्रितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005991006, "chapter_id": 25991, "verse_number": "१-१७४-७", "content_sanskrit": "एतन्मृद्वग्निना पक्वं स्थापयेद्राजते शुभे। ।\nसर्ववातविकारांस्तु सर्वधात्वन्तराश्रयान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005991007, "chapter_id": 25991, "verse_number": "१-१७४-८", "content_sanskrit": "तैलमेतत्प्रशमयेद्वल्याक्यं राजवल्लभम् ।\nशतावरीरसप्रस्थं क्षीरप्रस्थं तथैव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005991008, "chapter_id": 25991, "verse_number": "१-१७४-९", "content_sanskrit": "शतपुष्पं देवदारु मांसी शैलेयकं बला ।\nचन्दनं तगरं कुष्टं मनः शिला ज्योतिष्मती ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005991009, "chapter_id": 25991, "verse_number": "१-१७४-१०", "content_sanskrit": "एतैः कर्षसमैः कल्कैः घृतप्रस्थं विपाचयेत। ।\nकुव्जवामनपङ्गूनां बधिरव्यङ्गकुष्ठिनाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005991010, "chapter_id": 25991, "verse_number": "१-१७४-११", "content_sanskrit": "वायुना भग्नगात्राणां ये च सीदन्ति मैथुन। ।\nजराजर्जरगात्राणां चाध्मानमुख शोषिणाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005991011, "chapter_id": 25991, "verse_number": "१-१७४-१२", "content_sanskrit": "त्वग्गताश्चापि ये वाता शिरास्नायुगताश्च ये ।\nसर्वांस्तान्नाशयत्याशु तैलं रोगकुलान्तकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005991012, "chapter_id": 25991, "verse_number": "१-१७४-१३", "content_sanskrit": "नारायणमिदं तैलं विष्णुनोक्तं रुगर्दनम् ।\nपृथक्तैलं घृतं कुर्यात्समस्तैरौषधैः पृथक् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005991013, "chapter_id": 25991, "verse_number": "१-१७४-१४", "content_sanskrit": "शतावर्या गुडूच्या वा चित्रकै गोचनान्वितैः ।\nनिर्गुण्ड्या वा प्रसारः स्यात्कण्टकार्या रसादिभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005991014, "chapter_id": 25991, "verse_number": "१-१७४-१५", "content_sanskrit": "वर्षाभूवालया वापि वासकन फलत्रिकैः ।\nब्राहया चैग्ण्डकेनापि भृङ्गराजेन कुष्टिना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005991015, "chapter_id": 25991, "verse_number": "१-१७४-१६", "content_sanskrit": "मुसल्या दशमूलेन खदिरेण वटादिभिः ।\nवटिका मोदको वापि चूर्ण स्यात्सर्वरोगनुत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005991016, "chapter_id": 25991, "verse_number": "१-१७४-१७", "content_sanskrit": "घृतेन मधुना वापि अद्भिः खण्डगुडादिभिः ।\nलवणैः कटुकैर्युक्तं यथालाभं च गेगनुत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005991017, "chapter_id": 25991, "verse_number": "१-१७४-१८", "content_sanskrit": "चित्रकार्कत्रिवृद्वापि यवानीहयमारकम् ।\nसुधां च बालां गणिकां सप्तपर्णसुवर्चिकाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005991018, "chapter_id": 25991, "verse_number": "१-१७४-१९", "content_sanskrit": "ज्योतिष्मतीञ्च संभृत्य तैलं धीरो विपाचयेत् ।\nएतन्निष्यन्दनं तैलं भृशं दद्याद्भगन्दरे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005991019, "chapter_id": 25991, "verse_number": "१-१७४-२०", "content_sanskrit": "शोधनं गेपणं चैव सर्ववर्णकरं परम् ।\nचित्रकाद्यं महातैलं सर्वरोगप्रभञ्जनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005991020, "chapter_id": 25991, "verse_number": "१-१७४-२१", "content_sanskrit": "अजमोदं ससिन्दूरं हरितालं निशाद्वयम् ।\nक्षारद्वयं फेनयुतमार्द्रक सर (शवः लोद्भवम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005991021, "chapter_id": 25991, "verse_number": "१-१७४-२२", "content_sanskrit": "इन्द्रवारुण्यपामार्गकदलैः स्यन्दनैः सम ।\nएभिः सर्षपजं तैलमजामूत्रैश्चयोजितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005991022, "chapter_id": 25991, "verse_number": "१-१७४-२३", "content_sanskrit": "मृद्वग्निना पचेदेत्गव्यक्षीरेण संयुतम। ।\nअजमोदादिकं तैलं गण्डमालां व्यपोहति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005991023, "chapter_id": 25991, "verse_number": "१-१७४-२४", "content_sanskrit": "विदग्धस्तु पचेत्पक्वं चैव विशोधयेत् ।\nरोपणं मृदुभावं च तैलेनानेन कारयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]