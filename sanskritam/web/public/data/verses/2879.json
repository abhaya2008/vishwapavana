[{"id": 2088332, "chapter_id": 2879, "verse_number": "१३-९-१", "content_sanskrit": "युधिष्ठिर उवाच।\nपितामह महाप्राज्ञ सर्वसास्त्रविशारद।\nदैवे पुरुषकारे च किंस्विच्छ्रेष्ठतरं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088333, "chapter_id": 2879, "verse_number": "१३-९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088334, "chapter_id": 2879, "verse_number": "१३-९-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nवसिष्ठस्य च संवादं ब्रह्मणश्च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088335, "chapter_id": 2879, "verse_number": "१३-९-३", "content_sanskrit": "दैवमानुषयोः किंस्वित्कर्मणोः श्रेष्ठमित्युत।\nपुरा वसिष्ठो भगवान्पितामहमपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088336, "chapter_id": 2879, "verse_number": "१३-९-४", "content_sanskrit": "ततः पद्मोद्भवो राजन्देवदेवः पितामहः।\nउवाच मधुरं वाक्यमर्थवद्धेतुभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088337, "chapter_id": 2879, "verse_number": "१३-९-५", "content_sanskrit": "`बीजतो ह्यङ्कुरोत्पत्तिरङ्कुरात्पर्णसम्भवः।\nपर्णान्नालाः प्रसूयन्ते नालात्स्कन्धः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088338, "chapter_id": 2879, "verse_number": "१३-९-६", "content_sanskrit": "स्कन्धात्प्रवर्तते पुष्पं पुष्पात्संवर्धते फलम्।\nफलान्निर्वर्तते बीजं बीजात्स्यात्सम्भवः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088339, "chapter_id": 2879, "verse_number": "१३-९-७", "content_sanskrit": "नाबीजं जायते किञ्चिन्न बीजेने विना फलम्।\nबीजाद्बीजं प्रभवति नाबीजं विद्यते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088340, "chapter_id": 2879, "verse_number": "१३-९-८", "content_sanskrit": "यादृशं वपते बीजं क्षेत्रमासाद्य वापकः।\nसुकृते दुष्कृते वाऽपि तादृशं लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088341, "chapter_id": 2879, "verse_number": "१३-९-९", "content_sanskrit": "यथा बीजं विना क्षेत्रमुप्तं भवति निष्फलम्।\nतथा पुरुषकारेण विना दैवं न सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088342, "chapter_id": 2879, "verse_number": "१३-९-१०", "content_sanskrit": "क्षेत्रं पुरुषकारस्तु दैवं बीजमुदाहृतम्।\nक्षेत्रबीजसमायोगात्ततः सस्यं समृद्ध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088343, "chapter_id": 2879, "verse_number": "१३-९-११", "content_sanskrit": "कर्मणः फलनिर्वृत्तिं स्वयमश्नाति कारकः।\nप्रत्यक्षं दृश्यते लोके कृतस्याप्यकृतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088344, "chapter_id": 2879, "verse_number": "१३-९-१२", "content_sanskrit": "शुभेन कर्मणा सौख्यं दुःखं पापेन कर्मणा।\nकृतं सर्वत्र लभते नाकृतं भुज्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088345, "chapter_id": 2879, "verse_number": "१३-९-१३", "content_sanskrit": "कृती सर्वत्र लभते प्रतिष्ठां भाग्यवीक्षितः।\nअकृती लभते भ्रष्टः क्षते क्षारावसेचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088346, "chapter_id": 2879, "verse_number": "१३-९-१४", "content_sanskrit": "तपसा रूपसौभाग्यं रत्नानि विविधानि च।\nप्राप्यते कर्मणा सर्वं न दैवादकृतात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088347, "chapter_id": 2879, "verse_number": "१३-९-१५", "content_sanskrit": "तथा स्वर्गश्च भोगश्च निष्ठा या च मनीषिता।\nसर्वं पुरुषकारेण कृतेनेहोपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088348, "chapter_id": 2879, "verse_number": "१३-९-१६", "content_sanskrit": "ज्योतींषि त्रिदशा नागा यक्षाश्चन्द्रार्कमारुताः।\nसर्वे पुरुषकारेण मानुष्याद्देवतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088349, "chapter_id": 2879, "verse_number": "१३-९-१७", "content_sanskrit": "अर्थो वा मित्रवर्गो वा ऐश्वर्यं वा कुलान्वितम्।\nश्रीश्चापि दुर्लभा भोक्तुं तथैवाकृतकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088350, "chapter_id": 2879, "verse_number": "१३-९-१८", "content_sanskrit": "शौचेन लभते विप्रः क्षत्रियो विक्रमेण तु।\nवैश्यः पुरुषकारेण शूद्रः शुश्रूषया श्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088351, "chapter_id": 2879, "verse_number": "१३-९-१९", "content_sanskrit": "नादातारं भजन्त्यर्था न क्लीबं नापि निष्क्रियम्।\nनाकर्मशीलं नाशूरं तथा नैवातपस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088352, "chapter_id": 2879, "verse_number": "१३-९-२०", "content_sanskrit": "येन लोकास्त्रयः सृष्टा दैत्याः सर्वाश्च देवताः।\nस एष भगवान्विष्णुः समुद्रे तप्यते तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088353, "chapter_id": 2879, "verse_number": "१३-९-२१", "content_sanskrit": "स्वं चेत्कर्मफलं न स्यात्सर्वमेवाफलं भवेत्।\nलोको दैवं समालक्ष्य उदासीनो भवेद्यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088354, "chapter_id": 2879, "verse_number": "१३-९-२२", "content_sanskrit": "अकृत्वा मानुषं कर्म यो दैवमनुवर्तते।\nवृथा श्राम्यति सम्प्राप्य पतिं क्लीबमिवाङ्गना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088355, "chapter_id": 2879, "verse_number": "१३-९-२३", "content_sanskrit": "न तथा मानुषे लोके फलमस्ति शुभाशुभे।\nयथा त्रिदशलोके हि फलमल्पेन जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088356, "chapter_id": 2879, "verse_number": "१३-९-२४", "content_sanskrit": "कृतः पुरुषकारस्तु दैवमेवानुवर्तते।\nन दैवमकृते किञ्चित्कस्यचिद्दातुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088357, "chapter_id": 2879, "verse_number": "१३-९-२५", "content_sanskrit": "यथा स्थानान्यनित्यानि दृश्यन्ते दैवतेष्वपि।\nकथं कर्म विना दैवं स्थास्यति स्थापयिष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088358, "chapter_id": 2879, "verse_number": "१३-९-२६", "content_sanskrit": "न दैवतानि लोकेऽस्मिन्व्यापारं यान्ति कस्यचित्।\nव्यासङ्गं जनयन्त्युग्रमात्माभिभवशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088359, "chapter_id": 2879, "verse_number": "१३-९-२७", "content_sanskrit": "ऋषीणां देवतानां च सदा भवति विग्रहः।\nकस्य वाचा ह्यदैवं स्याद्यतो दैवं प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088360, "chapter_id": 2879, "verse_number": "१३-९-२८", "content_sanskrit": "कथं तस्य समुत्पत्तिर्यतो दैवं प्रवर्तते।\nएवं त्रिदशलोकेऽपि प्राप्यते परमं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088361, "chapter_id": 2879, "verse_number": "१३-९-२९", "content_sanskrit": "आत्मैव ह्यात्मनो बन्धुरात्मैव रिपुरात्मनः।\nआत्मैव ह्यात्मनः साक्षी कृतस्याप्यकृतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088362, "chapter_id": 2879, "verse_number": "१३-९-३०", "content_sanskrit": "कृतं च विकृतं किञ्चित्सिद्ध्यते गुरुकर्मणा।\nसुकृतं दुष्कृतं कर्म अकृतार्थं प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088363, "chapter_id": 2879, "verse_number": "१३-९-३१", "content_sanskrit": "देवानां शरणं पुण्यं सर्वं पुण्यैरवाप्यते।\nपुण्यहीनं नरं प्राप्य किं दैवं प्रकरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088364, "chapter_id": 2879, "verse_number": "१३-९-३२", "content_sanskrit": "पुरा ययातिर्विभ्रष्टश्च्यावितः पतितः क्षितौ।\nपुनरारोपितः स्वर्गं दौहित्रैः पुण्यकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088365, "chapter_id": 2879, "verse_number": "१३-९-३३", "content_sanskrit": "पुरूरवाश्च राजर्षिर्द्विजैरभिहितः पुरा।\nऐल इत्यभिविख्यातः स्वर्गं प्राप्तो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2088366, "chapter_id": 2879, "verse_number": "१३-९-३४", "content_sanskrit": "अश्वमेधादिभिर्यज्ञैः सत्कृतः कोसलाधिपः।\nमहर्षिशापात्सौदासः पुरुषादत्वमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2088367, "chapter_id": 2879, "verse_number": "१३-९-३५", "content_sanskrit": "अश्वत्थामा च रामश्च मुनिपुत्रौ धनुर्धरौ।\nन गच्छतः स्वर्गलोकं वेददृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2088368, "chapter_id": 2879, "verse_number": "१३-९-३६", "content_sanskrit": "वसुर्यज्ञशतैरिष्ट्वा द्वितीय इव वासवः।\nमिथ्याभिधानेनैकेन रसातलतलं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2088369, "chapter_id": 2879, "verse_number": "१३-९-३७", "content_sanskrit": "बलिर्वैरोचनिर्बद्धो धर्मपाशेन दैवतैः।\nविष्णोः पुरुषकारेण पातालसदनः कृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2088370, "chapter_id": 2879, "verse_number": "१३-९-३८", "content_sanskrit": "शक्रस्याथ रथोपस्थे विष्ठितो जनमेजयः।\nद्विजस्त्रीणां वधं कृत्वा किं दैवेन न वारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2088371, "chapter_id": 2879, "verse_number": "१३-९-३९", "content_sanskrit": "अज्ञानाद्ब्राह्मणं हत्वा स्पृष्टो बालवधेन च।\nवैशम्पायनविप्रर्षिः किं दैवेन न वारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2088372, "chapter_id": 2879, "verse_number": "१३-९-४०", "content_sanskrit": "गोप्रदानेन मिथ्या च ब्राह्मणेभ्यो महामखे।\nपुरा नृगश्च राजर्षिः कृकलासत्वमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2088373, "chapter_id": 2879, "verse_number": "१३-९-४१", "content_sanskrit": "धुन्धुमारश्च राजर्षिः सत्रेष्वेव जरां गतः।\nप्रीतिदायं परित्यज्य सुष्वाप स गिरिव्रजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2088374, "chapter_id": 2879, "verse_number": "१३-९-४२", "content_sanskrit": "पाण्डवानां हृतं राज्यं धार्तराष्ट्रैर्महाबलैः।\nपुनः प्रत्याहृतं चैव न दैवाद्भुजसंश्रयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2088375, "chapter_id": 2879, "verse_number": "१३-९-४३", "content_sanskrit": "तपोनियमसंयुक्ता मुनयः संशितव्रताः।\nकिं ते दैवबलाच्छापमुत्सृजन्ते न कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2088376, "chapter_id": 2879, "verse_number": "१३-९-४४", "content_sanskrit": "पापमुत्सृजते लोके सर्वं प्राप्य सुदुर्लभम्।\nलोभमोहसमापन्नं न दैवं त्रायते नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2088377, "chapter_id": 2879, "verse_number": "१३-९-४५", "content_sanskrit": "यथाऽऽग्निः पवनोद्भूतः सुसूक्ष्मोऽपि महान्भवेत्।\nतथा कर्मसमायुक्तं दैवं साधु विवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2088378, "chapter_id": 2879, "verse_number": "१३-९-४६", "content_sanskrit": "यथा तैलक्षयाद्दीपः प्रम्लानिमुपगच्छति।\nतथा कर्मक्षयाद्दैवं प्रम्लानिमुपगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2088379, "chapter_id": 2879, "verse_number": "१३-९-४७", "content_sanskrit": "विपुलमपि धनौघं प्राप्य भोगान्त्रियो वा\nपुरुष इह न शक्तः कर्महीनो हि भोक्तुम्।\nसुविहितमपि चार्थं दैवते रक्ष्यमाणं\nपुरुष इह महात्मा प्राप्नुते नित्ययुक्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2088380, "chapter_id": 2879, "verse_number": "१३-९-४८", "content_sanskrit": "व्ययगुमपि साधुं कर्मणा संश्रयन्ते\nभवती मनुजलोकाद्दैवलोको विशिष्टः।\nबहुतरसुसमृद्ध्या मानुषाणां गृहाणि\nपितृवनभवनाभं दृश्यते चामराणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2088381, "chapter_id": 2879, "verse_number": "१३-९-४९", "content_sanskrit": "न च फलति विकर्मा जीवलोके न दैवं\nव्यपनयति विमार्गं नास्ति दैवे प्रभुत्वम्।\nगुरुमिव कृतमग्र्यं कर्म संयाति दैवं\nनयति पुरुषकारः सञ्चितस्तत्रतत्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2088382, "chapter_id": 2879, "verse_number": "१३-९-५०", "content_sanskrit": "एतत्ते सर्वमाख्यातं मया वै मुनिसत्तम।\nफलं पुरुषकारस्य सदा संदृश्य तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2088383, "chapter_id": 2879, "verse_number": "१३-९-५१", "content_sanskrit": "अभ्युत्थानेन दैवस्य समारब्धेन केनचित्।\nविधिना कर्मणा चैव स्वर्गमार्गमवाप्नुयात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2088384, "chapter_id": 2879, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि नवमोऽध्यायः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]