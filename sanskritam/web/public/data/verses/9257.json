: "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 40017094, "chapter_id": 9257, "verse_number": "57", "content_sanskrit": "वानरान्वानरैरेवजघ्नुस्तेनैरृतर्षभाः ॥ राक्षसान्राक्षसैरेवजघ्नुस्तेवानराअपि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40017095, "chapter_id": 9257, "verse_number": "58", "content_sanskrit": "आक्षिप्य च शिलास्तेषांनिजघ्नाराक्षसाहरीन् ॥ तेषांचाछचिद्यशस्त्राणिजघ्नूरक्षांसिवानराः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40017096, "chapter_id": 9257, "verse_number": "59", "content_sanskrit": "निजघ्नुश्शैलशूलार्स्सैर्भिभिदुश्चपरस्परम् ॥ सिंहनादान्विनेदुश्चरणेराक्षसावानराः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40017097, "chapter_id": 9257, "verse_number": "60", "content_sanskrit": "छिन्नवर्णतनुत्राणाराक्षसावानरैर्हताः ॥ रुधिरंप्रसृतास्तत्ररससारमिवद्रुमाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 40017098, "chapter_id": 9257, "verse_number": "61", "content_sanskrit": "रथेन च रथंचापिवारणेनैववारणम् ॥ हयेन च हयंकेचिन्निजघ्नुर्वानरारणे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 40017099, "chapter_id": 9257, "verse_number": "62", "content_sanskrit": "क्षुरप्रैरर्धचन्द्रैश्चभल्लैश्चनिशितैश्शरैः ॥ राक्षसावानरेन्द्राणांबिभिदुःपादपान् शिलाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 40017100, "chapter_id": 9257, "verse_number": "63", "content_sanskrit": "विकीर्णैपर्वताग्रैश्चद्रुमैछशिनैश्चसंयुगे ॥ हतैश्चकपिरक्षोभिर्दुर्गमावसुधाऽभवत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 40017101, "chapter_id": 9257, "verse_number": "64", "content_sanskrit": "तेवानरागर्वितहृष्टचेष्टास्सङ्ग्राममासाद्यभयंविम । युद्धंस्मसर्वेसहराक्षसैस्सैयुधाश्चक्रुरदीनसत्त्वाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 40017102, "chapter_id": 9257, "verse_number": "65", "content_sanskrit": "तस्मिन्प्रवृत्तेतुमुलेविमर्देप्रहृष्यमाणेषुवलीमुखेषु । निपात्यमानेषु च राक्षसेषुमहर्षयोदेवगणाश्चनेदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 40017103, "chapter_id": 9257, "verse_number": "66", "content_sanskrit": "ततोहयंमारुततुल्यवेगमारुह्यशक्तिंनिशितांप्रगृह्य । नरान्तकोवानरराजसैन्यंमहार्णवंमीनइवाविवेश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 40017104, "chapter_id": 9257, "verse_number": "67", "content_sanskrit": "स वानरान् सप्तशतानिवीरःप्रासेनदीप्तेनन्वििर्बिभेद । एकःक्षणेनेन्द्ररिपुर्महात्माजघानसैन्यंहरिपुङ्गवानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 40017105, "chapter_id": 9257, "verse_number": "68", "content_sanskrit": "ददृशुश्चमहात्मानंहयपृष्ठेप्रतिष्ठितम् । चरन्तंहरिसैन्येषुविद्याधरमहर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 40017106, "chapter_id": 9257, "verse_number": "69", "content_sanskrit": "स तस्यददृशेमार्गोमांसशोणितकर्दमः । पतितैःपर्वताकारैर्वानरैरभिसंवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 40017107, "chapter_id": 9257, "verse_number": "70", "content_sanskrit": "यावद्विक्रमितुंबुधदिंचक्रुःप्लवगपुङ्गवाः । तावदेतानतिक्रम्यनिर्बिभेदनरान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 40017108, "chapter_id": 9257, "verse_number": "71", "content_sanskrit": "ददाहहरिसैन्यानिवनानीवविभावसुः । यावदुत्पाटयामासुर्वृक्षान्शैलान्वनौकसः ॥ तावत्प्रासहताःपेतुर्वज्रकृत्ताइवाचलाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 40017109, "chapter_id": 9257, "verse_number": "72", "content_sanskrit": "ज्वलन्तम्प्रासमुद्यम्यसङ्ग्रामान्तेनरान्तकः ॥ दिक्षुसर्वासुबलवान् विचचारनरान्तकः । प्रमृद्नन्सर्वतोयुद्धेप्रावृटकालेयथानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 40017110, "chapter_id": 9257, "verse_number": "73", "content_sanskrit": "ज्वलन्तम्प्रासमुद्यम्यसङ्ग्रामान्तेनरान्तकः ॥ दिक्षुसर्वासुबलवान् विचचारनरान्तकः । प्रमृद्नन्सर्वतोयुद्धेप्रावृटकालेयथानिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 40017111, "chapter_id": 9257, "verse_number": "74", "content_sanskrit": "न शेकुर्भाषितुंवीरा न स्थातुंस्पन्दितुंभयात् । उत्पतन्तंस्थितंयान्तंसर्वान्विव्याधवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 40017112, "chapter_id": 9257, "verse_number": "75", "content_sanskrit": "एकेनानन्तकल्पेनप्रासेनादित्यतेजसा । भग्नानिहरिसैन्यानिनिपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 40017113, "chapter_id": 9257, "verse_number": "76", "content_sanskrit": "वज्रनिष्पेषदृशंप्रासस्याभिनिपातनम् । न शेकुर्वानरास्सोढुंतेविनेदुर्महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 40017114, "chapter_id": 9257, "verse_number": "77", "content_sanskrit": "पततांहरिवीराणांरूपाणिप्रचकाशिरे । वज्रभिन्नाग्रकूटानांशैलानांपततामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 40017115, "chapter_id": 9257, "verse_number": "78", "content_sanskrit": "येतुपूर्वंमहात्मानःकुम्भकर्णेनपातिताः । तेस्वस्थावानरश्रेष्ठास्सुग्रीवमुपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 40017116, "chapter_id": 9257, "verse_number": "79", "content_sanskrit": "विप्रेक्षमाणस्सुग्रीवोददर्शहरिवाहिनीम् । नरान्तकभयत्रस्तांविद्रवन्तीमितस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 40017117, "chapter_id": 9257, "verse_number": "80", "content_sanskrit": "विद्रुतांवाहिनींदृष्टवा स ददर्शनरान्तकम् । गृहीतप्रासमायान्तंहयपृष्ठेप्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 40017118, "chapter_id": 9257, "verse_number": "81", "content_sanskrit": "अथोवाचमहातेजास्सुग्रीवोवानराधिपः । कुमारमङ्गदंवीरंशक्रतुल्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 40017119, "chapter_id": 9257, "verse_number": "82", "content_sanskrit": "गच्छत्वंराक्षसंवीरोयोऽसौतुरगमास्थितः । क्षोभयन्तहरिबलंक्षिप्रंप्राणैर्वियोजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 40017120, "chapter_id": 9257, "verse_number": "83", "content_sanskrit": "स भर्तुर्वचनंश्रुत्वानिष्पपाताङ्गदतः । अनीकान्मेघसङ्काशादंशुमानिववीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 40017121, "chapter_id": 9257, "verse_number": "84", "content_sanskrit": "शैलसङ्घातसङ्काशोहरीणामुत्तमोऽङ्गदः । रराजाङ्गदसन्नद्धस्सधातुरिवपर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 40017122, "chapter_id": 9257, "verse_number": "85", "content_sanskrit": "निरायुधोमहातेजाःकेवलंनखदंष्ट्रवान् । नरान्तकमभिक्रम्यवालिपुत्रोऽब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 40017123, "chapter_id": 9257, "verse_number": "86", "content_sanskrit": "तिष्ठकिंप्राकृतैरेभिर्हरिभिस्त्वंकरिष्यसि । अस्मिन्वज्रसमस्पर्शंप्रासंक्षिपममोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 40017124, "chapter_id": 9257, "verse_number": "87", "content_sanskrit": "अङ्गदस्यवचश्श्रुत्वाप्रचुक्रोधनरान्तकः । सन्दश्यदशनैरोष्ठंन्वििश्श्वस्यभुजङ्गवत् ॥ अभिगम्याङ्गदंक्रुद्धोवालिपुत्रंनरान्तकः । प्रासंसमाविध्यतदाङ्गदायसमुज्ज्वलन्तंसहसोत्ससर्ज । स वालिपुत्रोरसिवज्रकल्पेबभूवभग्नोन्यपतच्चभूमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 40017125, "chapter_id": 9257, "verse_number": "88", "content_sanskrit": "अङ्गदस्यवचश्श्रुत्वाप्रचुक्रोधनरान्तकः । सन्दश्यदशनैरोष्ठंन्वििश्श्वस्यभुजङ्गवत् ॥ अभिगम्याङ्गदंक्रुद्धोवालिपुत्रंनरान्तकः । प्रासंसमाविध्यतदाङ्गदायसमुज्ज्वलन्तंसहसोत्ससर्ज । स वालिपुत्रोरसिवज्रकल्पेबभूवभग्नोन्यपतच्चभूमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 40017126, "chapter_id": 9257, "verse_number": "89", "content_sanskrit": "तंप्रासमालोक्यतदाविभग्नंसुपर्णकृत्तोरगभोगकल्पम् । तलंसमुद्यम्य स वालिपुत्रस्तुरङ्गमतस्यजघानमूर्ध्नि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 40017127, "chapter_id": 9257, "verse_number": "90", "content_sanskrit": "निमग्नतालुस्फ्सुटिताक्षितारोनिष्क्रान्तजिह्वोऽचलसन्निकाशः । स तस्यवाजीनिपपातभूमौतलप्रहारेणविशीर्णमूर्धा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 40017128, "chapter_id": 9257, "verse_number": "91", "content_sanskrit": "नरान्तकःक्रोधवशंजगामहतंतुरङ्गंपतितंनिरीक्ष्य । स मुष्टिमुद्यम्यमहाप्रभावोजघानशीर्षेयुधि वालिपुत्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 40017129, "chapter_id": 9257, "verse_number": "92", "content_sanskrit": "अथाङ्गदोमुष्टिविशीर्णमूर्धासुस्रावतीव्रंरुधिरंभृशोष्णम् । मुहुर्विजज्वालमुमोहचापिसंज्ञांसमासाद्यविसिष्मिये च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 40017130, "chapter_id": 9257, "verse_number": "93", "content_sanskrit": "अथाङ्गदोमृत्युसमानवेगंसंवर्त्यमुष्टिंगिरिशृङ्गकल्पम् । निपातयामासतदामहात्मानरान्तकस्योरसिवालिपुत्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 40017131, "chapter_id": 9257, "verse_number": "94", "content_sanskrit": "स मुष्टिनिष्पिष्टविभिन्नवक्षाज्वालावमन्शोणितदिग्धगात्रः । नरान्तकोभूमितलेपपातयथाऽचलोवज्रनिपातभग्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 40017132, "chapter_id": 9257, "verse_number": "95", "content_sanskrit": "अथान्तरिक्षेत्रिदशोत्तमानांवनौकसांचैवमहाप्रणादः । बभूवतस्मिन्निहतेऽग्य्रवीर्येनरान्तकेवालिसुतेनसंख्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]