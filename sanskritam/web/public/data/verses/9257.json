[{"id": 40017038, "chapter_id": 9257, "verse_number": "1", "content_sanskrit": "एवंविलपमानस्यरावणस्यदुरात्मनः । श्रुत्वाशोकाभितप्तस्यत्रिशिरावाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017039, "chapter_id": 9257, "verse_number": "2", "content_sanskrit": "एवमेवमहावीर्योहतोनस्तातमध्यमः । न तुसत्पुरुषाराजन्विलपन्तियथाभवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017040, "chapter_id": 9257, "verse_number": "3", "content_sanskrit": "नूनंत्रिभुवनस्यापिपर्याप्तस्त्वमसिप्रभो । स कस्मात्प्राकृतइवशोचस्यात्मानमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017041, "chapter_id": 9257, "verse_number": "4", "content_sanskrit": "ब्रह्मदत्ताऽस्तितेशक्तिःकवचस्सायकोधनुः । सहस्रखरसंयुक्तोरथोमेघस्वनोमहान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017042, "chapter_id": 9257, "verse_number": "5", "content_sanskrit": "त्वयाऽसकृद्विशस्त्रेणविशस्तादेवदानवाः । स सर्वायुधसम्पन्नोराघवंशास्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017043, "chapter_id": 9257, "verse_number": "6", "content_sanskrit": "कामंतिष्ठमहाराजनिर्गमिष्याम्यहंरणम् । उद्धरिष्यामितेशत्रूंन्गरुडःपन्नगानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017044, "chapter_id": 9257, "verse_number": "7", "content_sanskrit": "शम्बरोदेवराजेननरकोविष्णुवायथा । तथाऽद्यशयितारामोमयायुधिनिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017045, "chapter_id": 9257, "verse_number": "8", "content_sanskrit": "श्रुत्वात्रिशिरसोवाक्यंरावणोराक्षसाधिपः । पुनर्जातमिवात्मानंमन्यतेकालचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017046, "chapter_id": 9257, "verse_number": "9", "content_sanskrit": "श्रुत्वात्रिशिरसोवाक्यंदेवान्तकनरान्तकौ । अतिकायश्चतेजस्वीबभूवुर्युद्धहर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017047, "chapter_id": 9257, "verse_number": "10", "content_sanskrit": "ततोऽहमहमित्येवगर्जन्तोनैरृतर्षभाः । रावणस्यसुतावीराश्शक्रतुल्यपराक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017048, "chapter_id": 9257, "verse_number": "11", "content_sanskrit": "अन्तरिक्षगतास्सर्वेसर्वेमायाविशारदाः । सर्वेत्रिदशदर्पघ्नास्सर्वे च रणदुर्जयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017049, "chapter_id": 9257, "verse_number": "12", "content_sanskrit": "सर्वेसुबलसम्पन्नास्सर्वेविस्तीर्णकीर्तयः । सर्वेसमरमासाद्य न श्रूयन्तेस्मपराजिताः ॥ देवैरपिसगन्धर्वैस्सकिन्नरमहोरगैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017050, "chapter_id": 9257, "verse_number": "13", "content_sanskrit": "सर्वेस्त्रविदुषोवीरास्सर्वेयुद्धविशारदाः ॥ सर्वेप्रसवरविज्ञानास्सर्वेलब्धवरास्तथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017051, "chapter_id": 9257, "verse_number": "14", "content_sanskrit": "सतैस्तथाभास्करतुल्यवर्चसैःपुस्त्रैर्वृतश्शत्रुबलप्रमार्दनैः । रराजराजामघवान्यथामरै ।र्वृतोमहादानवदर्पनाशनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017052, "chapter_id": 9257, "verse_number": "15", "content_sanskrit": "स पुत्रान् सम्परिष्वज्यभूषयित्वा च भूषणैः । आशीर्भिश्चप्रशस्ताभिःप्रेषयामाससम्युगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017053, "chapter_id": 9257, "verse_number": "16", "content_sanskrit": "युद्धोन्मत्तं च मत्तं च भ्रातरौचापिरावणः । रक्षणार्थंकुमाराणांप्रेषयामाससंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017054, "chapter_id": 9257, "verse_number": "17", "content_sanskrit": "तेऽभिवाद्यमहात्मानंरावणंरिपुरावणम् । कृत्वाप्रदक्षिणंचैवमहाकायाःप्रतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017055, "chapter_id": 9257, "verse_number": "18", "content_sanskrit": "सर्वौषधीभिर्गन्धैश्चसमालभ्यमहाबलाः । निर्जग्मुर्नैरृतश्रेष्ठाषडेतेयुद्धकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017056, "chapter_id": 9257, "verse_number": "19", "content_sanskrit": "त्रिशिराश्चातिकायश्चदेवान्तकनरान्तकौ । महोदरमहापार्श्वौनिर्जग्मुःकालचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017057, "chapter_id": 9257, "verse_number": "20", "content_sanskrit": "ततस्सुदर्शनंनागंनीलजीमूतसन्निभम् । ऐरावतकुलेजातमारुरोहमहोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017058, "chapter_id": 9257, "verse_number": "21", "content_sanskrit": "सर्वायुधसमायुक्तंतूणीभिश्चस्वलङ्कृतम् । रराजगजमास्थायसवितेवास्तमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017059, "chapter_id": 9257, "verse_number": "22", "content_sanskrit": "हयोत्तमसमायुक्तंसर्वायुधसमाकुलम् । आरुरोहरथश्रेष्ठंत्रिशिरारावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017060, "chapter_id": 9257, "verse_number": "23", "content_sanskrit": "त्रिशिरारथमास्थायविरराजधनुर्धरः । सविद्युदुल्कश्शैलाग्रेस्सेन्द्रइवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017061, "chapter_id": 9257, "verse_number": "24", "content_sanskrit": "त्रिभिःकिरीटैश्शुशुभेत्रिशिरास्सरथोत्तमे । हिमवानिशैलेन्द्रस्त्रिभिःकाञ्चनपर्वतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017062, "chapter_id": 9257, "verse_number": "25", "content_sanskrit": "अतिकायोऽपितितेजस्वीराक्षसेन्द्रसुतस्तदा । आरुरोहरथश्रेष्ठंश्रेष्ठस्सर्वधनुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017063, "chapter_id": 9257, "verse_number": "26", "content_sanskrit": "सुचक्राक्षंसुसंयुक्तंस्वनुकर्षंसुकूबरम् । तूणीबाणासनैर्दीप्तंप्रासासिपरिघाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017064, "chapter_id": 9257, "verse_number": "27", "content_sanskrit": "सकाञ्चनविचित्रेणमकुटेनविराजता । भूषणैश्चबभौमेरुःप्रभाभिरिवभासयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017065, "chapter_id": 9257, "verse_number": "28", "content_sanskrit": "स रराजरथेतस्मिन् राजसूनुर्महाबलः । वृतोनैरृतशार्दूलैर्वज्रपाणिरिवामरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017066, "chapter_id": 9257, "verse_number": "29", "content_sanskrit": "हयमुच्चैश्श्रवःप्रख्यंश्वेतंकनकभूषणम् । मनोजवंमहाक