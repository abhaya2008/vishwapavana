[{"id": 5000257000, "chapter_id": 9257, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000257001, "chapter_id": 9257, "verse_number": "३-६०-१", "content_sanskrit": "भृशमाव्रजमानस्य तस्याधो वामलोचनम्।\nप्रास्फुरच्चास्खलद् रामो वेपथुश्चास्य जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000257002, "chapter_id": 9257, "verse_number": "३-६०-२", "content_sanskrit": "उपालक्ष्य निमित्तानि सोऽशुभानि मुहुर्मुहुः।\nअपि क्षेमं तु सीताया इति वै व्याजहार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000257003, "chapter_id": 9257, "verse_number": "३-६०-३", "content_sanskrit": "त्वरमाणो जगामाथ सीतादर्शनलालसः।\nशून्यमावसथं दृष्ट्वा बभूवोद्विग्नमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000257004, "chapter_id": 9257, "verse_number": "३-६०-४", "content_sanskrit": "उद‍्भ्रमन्निव वेगेन विक्षिपन् रघुनन्दनः।\nतत्र तत्रोटजस्थानमभिवीक्ष्य समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000257005, "chapter_id": 9257, "verse_number": "३-६०-५", "content_sanskrit": "ददर्श पर्णशालां च सीतया रहितां तदा।\nश्रिया विरहितां ध्वस्तां हेमन्ते पद्मिनीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000257006, "chapter_id": 9257, "verse_number": "३-६०-६", "content_sanskrit": "रुदन्तमिव वृक्षैश्च ग्लानपुष्पमृगद्विजम्।\nश्रिया विहीनं विध्वस्तं संत्यक्तं वनदैवतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000257007, "chapter_id": 9257, "verse_number": "३-६०-७", "content_sanskrit": "विप्रकीर्णाजिनकुशं विप्रविद्धबृसीकटम्।\nदृष्ट्वा शून्योटजस्थानं विललाप पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000257008, "chapter_id": 9257, "verse_number": "३-६०-८", "content_sanskrit": "हृता मृता वा नष्टा वा भक्षिता वा भविष्यति।\nनिलीनाप्यथवा भीरुरथवा वनमाश्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000257009, "chapter_id": 9257, "verse_number": "३-६०-९", "content_sanskrit": "गता विचेतुं पुष्पाणि फलान्यपि च वा पुनः।\nअथवा पद्मिनीं याता जलार्थं वा नदीं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000257010, "chapter_id": 9257, "verse_number": "३-६०-१०", "content_sanskrit": "यत्नान्मृगयमाणस्तु नाससाद वने प्रियाम्।\nशोकरक्तेक्षणः श्रीमानुन्मत्त इव लक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000257011, "chapter_id": 9257, "verse_number": "३-६०-११", "content_sanskrit": "वृक्षाद् वृक्षं प्रधावन् स गिरींश्चापि नदीनदम्।\nबभ्राम विलपन् रामः शोकपङ्कार्णवप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000257012, "chapter_id": 9257, "verse_number": "३-६०-१२", "content_sanskrit": "अस्ति कच्चित्त्वया दृष्टा सा कदम्बप्रिया प्रिया।\nकदम्ब यदि जानीषे शंस सीतां शुभाननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000257013, "chapter_id": 9257, "verse_number": "३-६०-१३", "content_sanskrit": "स्निग्धपल्लवसंकाशां पीतकौशेयवासिनीम्।\nशंसस्व यदि सा दृष्टा बिल्व बिल्वोपमस्तनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000257014, "chapter_id": 9257, "verse_number": "३-६०-१४", "content_sanskrit": "अथवार्जुन शंस त्वं प्रियां तामर्जुनप्रियाम्।\nजनकस्य सुता तन्वी यदि जीवति वा न वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000257015, "chapter_id": 9257, "verse_number": "३-६०-१५", "content_sanskrit": "ककुभः ककुभोरुं तां व्यक्तं जानाति मैथिलीम्।\nलतापल्लवपुष्पाढ्यो भाति ह्येष वनस्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000257016, "chapter_id": 9257, "verse_number": "३-६०-१६", "content_sanskrit": "भ्रमरैरुपगीतश्च यथा द्रुमवरो ह्यसि।\nएष व्यक्तं विजानाति तिलकस्तिलकप्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000257017, "chapter_id": 9257, "verse_number": "३-६०-१७", "content_sanskrit": "अशोक शोकापनुद शोकोपहतचेतनम्।\nत्वन्नामानं कुरु क्षिप्रं प्रियासंदर्शनेन माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000257018, "chapter_id": 9257, "verse_number": "३-६०-१८", "content_sanskrit": "यदि ताल त्वया दृष्टा पक्वतालोपमस्तनी।\nकथयस्व वरारोहां कारुण्यं यदि ते मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000257019, "chapter_id": 9257, "verse_number": "३-६०-१९", "content_sanskrit": "यदि दृष्टा त्वया जम्बो जाम्बूनदसमप्रभा।\nप्रियां यदि विजानासि निःशङ्क कथयस्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000257020, "chapter_id": 9257, "verse_number": "३-६०-२०", "content_sanskrit": "अहो त्वं कर्णिकाराद्य पुष्पितः शोभसे भृशम्।\nकर्णिकारप्रियां साध्वीं शंस दृष्टा यदि प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000257021, "chapter_id": 9257, "verse_number": "३-६०-२१", "content_sanskrit": "चूतनीपमहासालान् पनसान् कुरवान् धवान्।\nदाडिमानपि तान् गत्वा दृष्ट्वा रामो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000257022, "chapter_id": 9257, "verse_number": "३-६०-२२", "content_sanskrit": "बकुलानथ पुन्नागांश्चन्दनान् केतकांस्तथा।\nपृच्छन् रामो वने भ्रान्त उन्मत्त इव लक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000257023, "chapter_id": 9257, "verse_number": "३-६०-२३", "content_sanskrit": "अथवा मृगशावाक्षीं मृग जानासि मैथिलीम्।\nमृगविप्रेक्षणी कान्ता मृगीभिः सहिता भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000257024, "chapter_id": 9257, "verse_number": "३-६०-२४", "content_sanskrit": "गज सा गजनासोरुर्यदि दृष्टा त्वया भवेत्।\nतां मन्ये विदितां तुभ्यमाख्याहि वरवारण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000257025, "chapter_id": 9257, "verse_number": "३-६०-२५", "content_sanskrit": "शार्दूल यदि सा दृष्टा प्रिया चन्द्रनिभानना।\nमैथिली मम विस्रब्धः कथयस्व न ते भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000257026, "chapter_id": 9257, "verse_number": "३-६०-२६", "content_sanskrit": "किं धावसि प्रिये नूनं दृष्टासि कमलेक्षणे।\nवृक्षैराच्छाद्य चात्मानं किं मां न प्रतिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000257027, "chapter_id": 9257, "verse_number": "३-६०-२७", "content_sanskrit": "तिष्ठ तिष्ठ वरारोहे न तेऽस्ति करुणा मयि।\nनात्यर्थं हास्यशीलासि किमर्थं मामुपेक्षसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000257028, "chapter_id": 9257, "verse_number": "३-६०-२८", "content_sanskrit": "पीतकौशेयकेनासि सूचिता वरवर्णिनि।\nधावन्त्यपि मया दृष्टा तिष्ठ यद्यस्ति सौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000257029, "chapter_id": 9257, "verse_number": "३-६०-२९", "content_sanskrit": "नैव सा नूनमथवा हिंसिता चारुहासिनी।\nकृच्छ्रं प्राप्तं न मां नूनं यथोपेक्षितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000257030, "chapter_id": 9257, "verse_number": "३-६०-३०", "content_sanskrit": "व्यक्तं सा भक्षिता बाला राक्षसैः पिशिताशनैः।\nविभज्याङ्गानि सर्वाणि मया विरहिता प्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000257031, "chapter_id": 9257, "verse_number": "३-६०-३१", "content_sanskrit": "नूनं तच्छुभदन्तोष्ठं सुनासं शुभकुण्डलम्।\nपूर्णचन्द्रनिभं ग्रस्तं मुखं निष्प्रभतां गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000257032, "chapter_id": 9257, "verse_number": "३-६०-३२", "content_sanskrit": "सा हि चम्पकवर्णाभा ग्रीवा ग्रैवेयकोचिता।\nकोमला विलपन्त्यास्तु कान्ताया भक्षिता शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000257033, "chapter_id": 9257, "verse_number": "३-६०-३३", "content_sanskrit": "नूनं विक्षिप्यमाणौ तौ बाहू पल्लवकोमलौ।\nभक्षितौ वेपमानाग्रौ सहस्ताभरणाङ्गदौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000257034, "chapter_id": 9257, "verse_number": "३-६०-३४", "content_sanskrit": "मया विरहिता बाला रक्षसां भक्षणाय वै।\nसार्थेनेव परित्यक्ता भक्षिता बहुबान्धवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000257035, "chapter_id": 9257, "verse_number": "३-६०-३५", "content_sanskrit": "हा लक्ष्मण महाबाहो पश्यसे त्वं प्रियां क्वचित्।\nहा प्रिये क्व गता भद्रे हा सीतेति पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000257036, "chapter_id": 9257, "verse_number": "३-६०-३६", "content_sanskrit": "इत्येवं विलपन् रामः परिधावन् वनाद् वनम्।\nक्वचिदुद‍्भ्रमते वेगात् क्वचिद् विभ्रमते बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000257037, "chapter_id": 9257, "verse_number": "३-६०-३७", "content_sanskrit": "क्वचिन्मत्त इवाभाति कान्तान्वेषणतत्परः।\nस वनानि नदीः शैलान् गिरिप्रस्रवणानि च।\nकाननानि च वेगेन भ्रमत्यपरिसंस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000257038, "chapter_id": 9257, "verse_number": "३-६०-३८", "content_sanskrit": "तदा स गत्वा विपुलं महद् वनं\nपरीत्य सर्वं त्वथ मैथिलीं प्रति।\nअनिष्ठिताशः स चकार मार्गणे\nपुनः प्रियायाः परमं परिश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000257039, "chapter_id": 9257, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे षष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]