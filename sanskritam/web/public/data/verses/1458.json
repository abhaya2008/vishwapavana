[{"id": 2022020, "chapter_id": 1458, "verse_number": "३-९६-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022021, "chapter_id": 1458, "verse_number": "३-९६-१", "content_sanskrit": "ततो जगाम कौरव्य सोऽगस्त्यो भिक्षितुं वसु।\nश्रुतर्वाणं महीपालं यं वेदाभ्यधिकं नृपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022022, "chapter_id": 1458, "verse_number": "३-९६-२", "content_sanskrit": "स विदित्वा तु नृपतिः कुम्भयोनिमुपागतम्।\nविषयान्ते सहामात्यः प्रत्यगृह्णात्सुसत्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022023, "chapter_id": 1458, "verse_number": "३-९६-३", "content_sanskrit": "तस्मै चार्घ्यं थान्यायमानीय पृथिवीपतिः।\nप्राञ्जलिः प्रयतो भूत्वापप्रच्छागमनेऽर्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022024, "chapter_id": 1458, "verse_number": "३-९६-४x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022025, "chapter_id": 1458, "verse_number": "३-९६-४", "content_sanskrit": "वित्तार्थिनमनुप्राप्तं विद्धि मां पृथिवीपते।\nथाशक्त्यविहिंस्यान्यान्संविभागं प्रयच्छ मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022026, "chapter_id": 1458, "verse_number": "३-९६-५x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022027, "chapter_id": 1458, "verse_number": "३-९६-५", "content_sanskrit": "तत आयव्ययौ पूर्णो तस्मै राजा न्यवेदयत्।\nअतो विद्वन्नुपादत्स्व यदत्रव्यतिरिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022028, "chapter_id": 1458, "verse_number": "३-९६-६", "content_sanskrit": "तत आयव्ययौ दृष्ट्वा समौ सममतिर्द्विजः।\nसर्वथा प्राणिनां पीडामुपादानादमन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022029, "chapter_id": 1458, "verse_number": "३-९६-७", "content_sanskrit": "स श्रुतर्वाणमादाय ब्रध्नश्वमगमत्ततः।\nस च तौ विषयस्यान्ते प्रत्यगृह्णाद्यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022030, "chapter_id": 1458, "verse_number": "३-९६-८", "content_sanskrit": "तयोरर्ध्यं च पाद्यं च ब्रध्नश्वः प्रत्यवेदयत्।\nअनुज्ञाप्यच पप्रच्छ प्रयोजनमुपक्रमे।\n`वद कामं मुनिश्रेष्ठ धन्योस्म्यागमनेन ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022031, "chapter_id": 1458, "verse_number": "३-९६-९x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022032, "chapter_id": 1458, "verse_number": "३-९६-९", "content_sanskrit": "वित्तकामाविह प्राप्तौ विद्ध्यावां पृथिवीपते।\nयथाशक्त्यविहिंस्यान्यान्संविभागं प्रयच्छ नौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022033, "chapter_id": 1458, "verse_number": "३-९६-१०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022034, "chapter_id": 1458, "verse_number": "३-९६-१०", "content_sanskrit": "तत आयव्ययौ पूर्णौ ताभ्यां राजा न्यवेदयत्।\nअतो ज्ञात्वा तु गृह्णीतं यदत्रव्यतिरिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022035, "chapter_id": 1458, "verse_number": "३-९६-११", "content_sanskrit": "तत आयव्ययौ दृष्ट्वासमौ सममतिर्द्विजः।\nसर्वथा प्राणिनां पीडामुपादानादमन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022036, "chapter_id": 1458, "verse_number": "३-९६-१२", "content_sanskrit": "पौरुकुत्सं ततो जग्मुस्त्रसदस्युं महाधनम्।\nअगस्त्यश्च श्रुतर्वा च ब्रध्नश्वश्च महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022037, "chapter_id": 1458, "verse_number": "३-९६-१३", "content_sanskrit": "त्रसदस्युस्तु तान्दृष्ट्वा प्रत्यगृह्णाद्यथाविधि।\nअभिगम्य महाराज विषयान्ते महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022038, "chapter_id": 1458, "verse_number": "३-९६-१४", "content_sanskrit": "अर्चयित्वा यथान्यायमैक्ष्वाको राजसत्तमः।\nसमस्तांश्च ततोऽपच्छत्प्रयोजनमुपक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022039, "chapter_id": 1458, "verse_number": "३-९६-१५x", "content_sanskrit": "अगस्त्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022040, "chapter_id": 1458, "verse_number": "३-९६-१५", "content_sanskrit": "वित्तकामानिह प्राप्तान्विद्धि नः पृथिवीपते।\nयथाशक्त्यवीहिंस्यान्यान्संविभागं प्रयच्छ नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022041, "chapter_id": 1458, "verse_number": "३-९६-१६x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022042, "chapter_id": 1458, "verse_number": "३-९६-१६", "content_sanskrit": "तत आयव्ययौ पूर्णौ तेषां राजा न्यवेदयत्।\nएतज्ज्ञात्वा ह्युपादद्ध्वं यदत्रव्यतिरिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022043, "chapter_id": 1458, "verse_number": "३-९६-१७", "content_sanskrit": "तत आयव्ययौ दृष्ट्वासमौ सममतिर्द्विजः।\nसर्वथा प्राणिनां पीडामुपादानादमन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022044, "chapter_id": 1458, "verse_number": "३-९६-१८", "content_sanskrit": "ततः सर्वे समेत्याथ ते नृपास्तं महामुनिम्।\nइदमूचुर्महाराज समवेक्ष्य परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022045, "chapter_id": 1458, "verse_number": "३-९६-१९", "content_sanskrit": "अयं वै दानवो ब्रह्मन्निल्वलो वसुमान्भुवि।\nतमतिक्रम्य सर्वेऽद्यवयं चार्तामहे वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022046, "chapter_id": 1458, "verse_number": "३-९६-२०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022047, "chapter_id": 1458, "verse_number": "", "content_sanskrit": "तेषां तदासीदुचितमिल्वलस्यैव भिक्षणम्।\nततस्ते सहिता राजन्निल्वलं समुपाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]