    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20012489,
    "chapter_id": 6692,
    "verse_number": "20.37",
    "content_sanskrit": "अन्धिताविव जगद्गरीयसा तोयदान्धतमसेन रुन्धता । संप्रयोगरसमूर्च्छितौ न तौ कामसूत्रनियममपश्यताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20012490,
    "chapter_id": 6692,
    "verse_number": "20.38",
    "content_sanskrit": "श्लेषचुम्बनविशेषपल्लवं पुष्पितं नखरदाङ्कपङ्क्तिभिः । स्वादुभी रतिफलैर्वृतं तयोर्यौवनं वनमिव व्यवर्धत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20012491,
    "chapter_id": 6692,
    "verse_number": "20.39",
    "content_sanskrit": "मेघमुक्तसततोदकच्छटासात्कृतश्रवणतर्पितश्रवौ । तौ रतिश्रमवशान्निदद्रतुर्वासरेषु च विभावरीषु च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20012492,
    "chapter_id": 6692,
    "verse_number": "20.40",
    "content_sanskrit": "फुल्लपद्मवदना परिस्फुरद्वन्धुजीवविपिनानुलेपना । सृष्टचन्द्रमुकुरप्रकाशिता तारकाभरणभासुरद्युतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20012493,
    "chapter_id": 6692,
    "verse_number": "20.41",
    "content_sanskrit": "आक्षिपन्त्यथ जगन्मनोहरा वार्मुचां यवनिकामिवावलिम् । दृष्टहंसनिवहाभिनन्दिता नर्तकीव ददृशे शरत्पुरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20012494,
    "chapter_id": 6692,
    "verse_number": "20.42",
    "content_sanskrit": "क्षिप्तमेघबलमागतंचिरात् प्रेक्ष्य मित्रमहसन्नहानि नु । फुल्लपद्मवदनानि मञ्जुभिर्व्याहरन्ति कलहंसकूजितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20012495,
    "chapter_id": 6692,
    "verse_number": "20.43",
    "content_sanskrit": "मेघकुम्भगलितोदकप्लुता हंसहारशतपत्रभूषिताः । वासरा गगनकेशबन्धनन्यस्तसूर्यमणयश्चकाशिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20012496,
    "chapter_id": 6692,
    "verse_number": "20.44",
    "content_sanskrit": "सद्युकेशशशिमण्डलाननाश्चन्द्रिकामलयजानुलेपनाः । स्रंसमानसिततोयदांशुका रात्रयः सहृदयानमोहयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20012497,
    "chapter_id": 6692,
    "verse_number": "20.45",
    "content_sanskrit": "चित्रचारुसहनादसम्पदा व्योम्नि पर्वत इव प्रसारितम् । चापचक्रमगलत्पयोमुचां केकिनामिव शिखण्डमण्डलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20012498,
    "chapter_id": 6692,
    "verse_number": "20.46",
    "content_sanskrit": "कृष्यमाणसलिला रवेः करैर्निर्मले नभसि मेघपङ्क्तयः । पाण्डुतामुपययुः क्रमाज्जले वालुका इव समुद्रयोषिताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20012499,
    "chapter_id": 6692,
    "verse_number": "20.47",
    "content_sanskrit": "हंसयूथकृतवेतसालिभिः सैकते स्म सरितश्चकासति । अंशुकस्थगितरोमराजिभिः सुश्रुवो जघनमण्डलैरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20012500,
    "chapter_id": 6692,
    "verse_number": "20.48",
    "content_sanskrit": "बिभ्रतीं मुकुलिताम्बुजाननां पत्रसंहतिमपत्रपामिव । पद्मिनीमभिनवांसकञ्चुकां चुम्बति स्म तरुणातपश्शनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20012501,
    "chapter_id": 6692,
    "verse_number": "20.49",
    "content_sanskrit": "चातका बहुतृषोऽपि नाऽपिबन् भूजलं विमलदिव्यवारिपाः । सद्गृहाशनजुषो न साधवः प्रार्थयन्ति ननु नीचभोजनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20012502,
    "chapter_id": 6692,
    "verse_number": "20.50",
    "content_sanskrit": "प्राक्प्रबुद्धकमलाकराम्बुजस्पर्शकण्टकितपादपङ्कजम् । बुद्धवानिव विबुद्धमच्युतं शङ्कितश्शममवाप वारिधिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20012503,
    "chapter_id": 6692,
    "verse_number": "20.51",
    "content_sanskrit": "वारिपूरचरमीनघट्टितस्पष्टपद्मवनगन्धबन्धुना । मन्दशीतमरुता तरङ्गितैर्भक्तयः फलितशालिभिर्बभुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20012504,
    "chapter_id": 6692,
    "verse_number": "20.52",
    "content_sanskrit": "श्यामलद्युतिभिरुत्पतिष्णुभिर्मस्तकस्थफलभारधारिभिः । पूरितं तुलितशालिभिशुकैः शालिभूतलमिवाम्बरं बभौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20012505,
    "chapter_id": 6692,
    "verse_number": "20.53",
    "content_sanskrit": "आयतेन विकचेन चक्षुषा लङ्घितश्रवणमेचकोत्पला । लोलतालदलकण्ठवेष्टना शालियोषिदरुणं मृगव्रजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20012506,
    "chapter_id": 6692,
    "verse_number": "20.54",
    "content_sanskrit": "लङ्घिताभ्रककुदाग्रमुन्मदं लम्बमानगलकम्बलं बभौ । वप्रपङ्कचितशृङ्गमण्डलं वारितप्रतिमहोक्षमौक्षकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20012507,
    "chapter_id": 6692,
    "verse_number": "20.55",
    "content_sanskrit": "एकदा तु सह कृष्णभगिन्या सौधपृष्ठमधिरुह्य किरीटी । शर्वरीमुखतमोपहदीपं शुभ्रभासि शयने निषसाद ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20012508,
    "chapter_id": 6692,
    "verse_number": "20.56",
    "content_sanskrit": "सौरतं परिकरं सकलं द्राक् पार्श्ववर्ति शयनस्य विधाय । व्यापृतो बहुविधे करणीये पण्डितः परिजनोऽपससार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20012509,
    "chapter_id": 6692,
    "verse_number": "20.57",
    "content_sanskrit": "हारयष्टिमृदितस्तनकुम्भां जम्भसूदनसुतोऽथ सुभद्राम् । स्वेदवान् पुलकविश्लथनीवीस्रंसमानवसनां परिरेभे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20012510,
    "chapter_id": 6692,
    "verse_number": "20.58",
    "content_sanskrit": "वल्लभस्य वदनं परिचुम्ब्य स्वादु दन्तवसनं दशनाग्रैः । मृद्वती रससुधामपि पीत्वा सा कुतो नु सुरतान्निमवाञ्छत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20012511,
    "chapter_id": 6692,
    "verse_number": "20.59",
    "content_sanskrit": "उत्पतिष्णुकुचनर्तितहारं तायमानरशनामणिनादम् । उल्लसत्कनककुण्डलघृष्टस्वेदबिन्दुकणिकार्द्रकपोलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20012512,
    "chapter_id": 6692,
    "verse_number": "20.60",
    "content_sanskrit": "स्रस्तकुन्तलभरच्युतपुष्पश्रेणिभूषितभुजान्तरकान्तम् । लोलितालकमुखाम्बुजवातं वल्लभं रमयति स्म मृगाक्षी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20012513,
    "chapter_id": 6692,
    "verse_number": "20.61",
    "content_sanskrit": "स्पर्शिताधरसुधाकलनादात् कुर्वती सुरभिवक्त्रसमीरा । सुन्दराङ्गलतिका दमयन्ती सेन्द्रियाणि रमणस्य जहार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20012514,
    "chapter_id": 6692,
    "verse_number": "20.62",
    "content_sanskrit": "कान्तयोर्नखरदक्षतिजातं दुःखमप्यनुपमं सुखमासीत् । कङ्कणक्वणितसीत्कृतगम्यं मोहनस्य स हि मोहनभावः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20012515,
    "chapter_id": 6692,
    "verse_number": "20.63",
    "content_sanskrit": "खिन्नसन्नसकलावयवा सा सृत्वराननसरोजसमीरा । चक्षुषा मुकुलितेन रतान्ते वक्षसि प्रियतमस्य पपात ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20012516,
    "chapter_id": 6692,
    "verse_number": "20.64",
    "content_sanskrit": "श्रेयसो लवमिवानुभवन्ती सुप्तवत्युरसि कञ्चन कालम् । तस्य सा मृदुतरैः परिरम्भैरुन्मिमील पुनरस्तरतार्तिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20012517,
    "chapter_id": 6692,
    "verse_number": "20.65",
    "content_sanskrit": "रक्तभाजनभृताग्रपाणिना तामपाययत वारुणीं वरः । घूर्णमानरुधिरारुणेक्षणा वक्त्रचन्द्रचषकेण साऽपि तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20012518,
    "chapter_id": 6692,
    "verse_number": "20.66",
    "content_sanskrit": "वाससा विगलताऽथ निर्दयं सस्वजे हरिसुतं हरिस्वसा । आपपौ च मृदिताधरं मुखं चुम्बितं करगृहीतकुन्तलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20012519,
    "chapter_id": 6692,
    "verse_number": "20.67",
    "content_sanskrit": "तत्र हस्तमृदितोन्नतस्तनीमामृशञ्जघनमन्थपाणिना । स्रंसमानवसनाङ्कवर्तिनीं माधवीमिति जगाद पाण्डवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20012520,
    "chapter_id": 6692,
    "verse_number": "20.68",
    "content_sanskrit": "एतदुत्पतति पश्य वारिधेस्सुभ्रु शुभ्रकिरणस्य मण्डलम् । यत्तरङ्गनिकरैरितोत्पतत्पद्मरागमणिमण्डलायते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20012521,
    "chapter_id": 6692,
    "verse_number": "20.69",
    "content_sanskrit": "सुन्दरीन्दुमवलोकयाऽधुना धारयन्तमुदयारुणं वपुः । तावकं मधुमदेन लोहितं यद्विडम्बयति गण्डमण्डलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20012522,
    "chapter_id": 6692,
    "verse_number": "20.70",
    "content_sanskrit": "छादयत्युदयरागमुद्वहन्नाम नूनमयमात्मलाञ्छनम् । अग्रतस्तव मुखस्य लज्जया रक्तकञ्चुकधरो निशाकरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20012523,
    "chapter_id": 6692,
    "verse_number": "20.71",
    "content_sanskrit": "स्वेदवारिरिह संहरत्यसौ रागवानमृतवर्षिभिः करैः । शर्वरीयुवतिकेशबन्धनं ध्वान्तमद्य धवलद्युति प्रिये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20012524,
    "chapter_id": 6692,
    "verse_number": "20.72",
    "content_sanskrit": "मञ्जुभाषिणि मरुत्वतो दिशि प्रोतमेचकमणीव लक्ष्मणा । पुण्डरीकपरिपन्थिनोऽधुना मण्डलं कनककुण्डलायते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20012525,
    "chapter_id": 6692,
    "verse_number": "20.73",
    "content_sanskrit": "अन्तरिक्षसरसीसिताम्बुजं वक्त्रमित्थमयमीक्ष्यतां त्वया । यामिनीयुवतिकुन्दशेखरः शक्रदिङ्मुखविशेषकः शशी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20012526,
    "chapter_id": 6692,
    "verse_number": "20.74",
    "content_sanskrit": "पूर्वशैलशिरसि प्रियेऽधुना नृत्यतो रजनिकालबर्हिणः । उल्लसत्तिमिरबर्हमण्डलीदण्डतां दधति चन्द्ररश्मयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20012527,
    "chapter_id": 6692,
    "verse_number": "20.75",
    "content_sanskrit": "भिद्यमानमुडुभर्तुरंशुभिः पश्य सुन्दरि तमिस्रसञ्चयम् । अम्बुभिर्दिवि भुवीव यामुनं वारिपूरमिव सौरसैन्धवैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20012528,
    "chapter_id": 6692,
    "verse_number": "20.76",
    "content_sanskrit": "ज्योत्स्नयेन्दुरधुना कुमुद्वतीं नन्दयत्यमलया मनोज्ञया । स्वापिताम्बुरुहमूर्तया गिरा सत्कविः परिषदं सतामिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20012529,
    "chapter_id": 6692,
    "verse_number": "20.77",
    "content_sanskrit": "साध्यनृत्तचलितस्य धूर्जटेरट्टहास इव भस्मपूरितः । चन्द्रपादनिकरो निरङ्कुशः साम्प्रतं दिशि दिशि प्रतायते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20012530,
    "chapter_id": 6692,
    "verse_number": "20.78",
    "content_sanskrit": "अन्तरब्भववनस्य निषण्णास्तारकेशगृहिणोऽतिथयोऽमी । निर्मलं हविरिवाद्य चकोराश्चन्द्रधाम मधुरं रसयन्ति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20012531,
    "chapter_id": 6692,
    "verse_number": "20.79",
    "content_sanskrit": "स्विद्यतीन्दुमणिभूमिरिदानीं यामिनीकरकरव्यतिषङ्गात् । मानिनीव मदनज्वरतप्ता वल्लभस्य निबिडात्परिरंभात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20012532,
    "chapter_id": 6692,
    "verse_number": "20.80",
    "content_sanskrit": "इति ब्रुवन्नेव स भिन्नकायो रोमाञ्चलक्षेण मनोजबाणैः । स्वेदच्छलात्प्रेम परिस्रवन्तीं रामस्वसारं रमयाञ्चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20012533,
    "chapter_id": 6692,
    "verse_number": "20.81",
    "content_sanskrit": "तावनादृतगलत्परिधानौ पीड्यमानजघनग्रथितोरू । स्वेदिनौ पुलकितावशयातां चुम्बनाधरमणिग्रहलोलौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20012534,
    "chapter_id": 6692,
    "verse_number": "20.82",
    "content_sanskrit": "शिक्षितोरुजघनस्तनादिना कुर्वती घनतरोपगूहहनम् । सन्ततेषु सुरतेषु सुन्दरी वल्लभस्य हृदयञ्जहार सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20012535,
    "chapter_id": 6692,
    "verse_number": "20.83",
    "content_sanskrit": "एवं नीत्वा क्षणमिव शरदं तौ हेमन्तं ततहिमपटलम् । गाढाश्लेषैः पुलकितवपुषौ कोष्णैस्तीर्णावविरतसुरतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20012536,
    "chapter_id": 6692,
    "verse_number": "20.84",
    "content_sanskrit": "तनुशीततया मनोहरं विकसत्सुन्दरसिन्धुवारकम् । रमणौ शिशिरञ्च निन्यतू रमणीयं सहकारकोरकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20012537,
    "chapter_id": 6692,
    "verse_number": "20.85",
    "content_sanskrit": "अथ गर्भमधत्त माधवी समये धाममयं यशोनिधिम् । शितिपर्वणि सेन्दुमण्डलं रविदिग्गूढमिवांशुमालिनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20012538,
    "chapter_id": 6692,
    "verse_number": "20.86",
    "content_sanskrit": "प्रतिबिम्बमपश्यदात्मनः सुमुखी कृष्टकृपाणदर्पणे । दयितेन सहाऽऽयुधालयं प्रविवेशाऽऽयुधदर्शनोत्सुका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20012539,
    "chapter_id": 6692,
    "verse_number": "20.87",
    "content_sanskrit": "परिरब्धुमियेप वत्सला स्फुरतः पञ्चरसिंहशावकान् । अतिशूरकुमारधारिणी न तु सा क्रीडनकान् मृगद्विजान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20012540,
    "chapter_id": 6692,
    "verse_number": "20.88",
    "content_sanskrit": "रुचितं रुचितं महाभुजो दयितायै दिशति स्म फल्गुनः । नहि तेन सुधाऽपि दुर्लभा सुरगुप्ता सुरराजसूनुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20012541,
    "chapter_id": 6692,
    "verse_number": "20.89",
    "content_sanskrit": "शरगौरशरीरधारिणी स्फुटनेत्रावलिनेत्रचूचुका । तिमिरांशुवतीव पूर्णिमा हृदयं गाण्डिविनश्चकर्ष सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20012542,
    "chapter_id": 6692,
    "verse_number": "20.90",
    "content_sanskrit": "विधिवत्सुरराजसूनुना विहिताः पुंसवनादिकाः क्रियाः । घनदाममहाधनाखिलद्विजयोषिद्विहिताशिषा ततः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20012543,
    "chapter_id": 6692,
    "verse_number": "20.91",
    "content_sanskrit": "पृथया सकलैश्च देवरैर्द्रुपदस्यात्मजया च रक्षितः । विदुषा च पुरोधसाऽर्भकः स जनन्यास्समवर्धतोदरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20012544,
    "chapter_id": 6692,
    "verse_number": "20.92",
    "content_sanskrit": "रामसात्यकियुतोऽथ जातुचित् सूतिकालविदिवाऽच्युतस्वसुः । आययौ गृहमितो यदृच्छया कार्यवानवनिपालमीक्षकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20012545,
    "chapter_id": 6692,
    "verse_number": "20.93",
    "content_sanskrit": "उपगम्य नृपं सहाऽनुजं प्रविशन्नेव हरिः पृथागृहम् । अशृणोत्स्वसुरायता गिरो गुरुगर्भस्फुरणव्यथोदिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20012546,
    "chapter_id": 6692,
    "verse_number": "20.94",
    "content_sanskrit": "अथ सा करुणार्द्रचेतसा कमलाक्षेण मृदूकृतव्यथा । सुषुवे सुतमाशु भास्वरं हरिदैन्द्रीव मयूखमालिनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20012547,
    "chapter_id": 6692,
    "verse_number": "20.95",
    "content_sanskrit": "मुष्टिन्धयो मुक्तनिमेषदृष्टी रोदूयमाणश्चलपाणिपादः । स पौरलोकार्णवपूर्णचन्द्रो विभूषयामास तदा सुभद्राम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20012548,
    "chapter_id": 6692,
    "verse_number": "20.96",
    "content_sanskrit": "सन्तर्पयन्नेत्रचकोरपङ्क्ति विकासयन्नाननकैरवालिम् । विद्रावयन् मानसचन्द्रकान्तान् स बान्धवानामहरत्सुधांशुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20012549,
    "chapter_id": 6692,
    "verse_number": "20.97",
    "content_sanskrit": "बलवासुदेवयुयुधानपाण्डवाः सुतभागिनेयजनकाभिधायिनः । तरसेतरेतरदुकूलभूषणान्यथ पूर्णपात्रमहरन्मुदाकुलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20012550,
    "chapter_id": 6692,
    "verse_number": "20.98",
    "content_sanskrit": "पाण्डोस्सुतास्तं सुतमीक्षमाणाः पितॄणबन्धादपि मुच्यमानाः । तदङ्गलग्नोत्तमराजचिह्ननिवद्धनेत्राश्चलितुं न शेकुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20012551,
    "chapter_id": 6692,
    "verse_number": "20.99",
    "content_sanskrit": "युधिष्ठिरप्रत्तधनौघतर्पिताः परिक्षरद्भिश्शिशिराश्रुशीकरैः । तताशिषस्तत्र कृशाः कुटुम्बिनो द्विजा बबन्धुः सुदिनेऽपि दुर्दिनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20012552,
    "chapter_id": 6692,
    "verse_number": "20.100",
    "content_sanskrit": "अहमहमिकविष्टः शंसन्'कुमारजनिन्तदा दिशि दिशि चरन् पूर्णामत्रं जहार जनो जनात् । पुरयुवतयः सिन्दूराक्तैर्मुखैः परिवभ्रमु रणितवलया रुद्धाकाशोन्नमत्कुचमण्डलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20012553,
    "chapter_id": 6692,
    "verse_number": "20.101",
    "content_sanskrit": "वीतव्यथस्य युधि मन्युमतः पुरोधास्तस्याभिमन्युरिति नाम चकार काले । मीलद्द्युतिस्स ववृधे विधिभिस्तदीयैः पक्षे वलक्ष इव बालविधुः क्रमेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20012554,
    "chapter_id": 6692,
    "verse_number": "20.102",
    "content_sanskrit": "अवरजैः प्रतिविन्ध्यपुरस्सरैर्द्रुपदजातनयैस्स सहैधत । पितृसमैः पितृतुल्यपराक्रमो हरिकिशोरकयूथपलीलया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20012555,
    "chapter_id": 6692,
    "verse_number": "20.103",
    "content_sanskrit": "विश्वामित्रस्य गोत्रे द्विजमणिरभवद्ब्रह्मदत्ताभिधानः श्राद्धस्वाध्यायपूतस्सकलगुणनिधिः शास्त्रवित्काव्यशौण्डः । अन्तेवासी विपश्चिद्विप्रहरिणभृतोर्जातवेदोष्टमूर्त्योस्तत्सूनुः काव्यमेतद् व्यधित बुधमुदे ख्यातनारायणाख्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  }
]