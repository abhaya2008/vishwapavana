[
  {
    "id": 20012453,
    "chapter_id": 6692,
    "verse_number": "20.1",
    "content_sanskrit": "गूढमन्मथरसामथ प्रियां शैशवाभरणभूतया ह्रिया । स्पन्दनार्धनयनामुपक्रमैः कोमलै रमयति स्म फल्गुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20012454,
    "chapter_id": 6692,
    "verse_number": "20.2",
    "content_sanskrit": "नाऽददादभिहिता यदुत्तरं यन्न्यधायि शयने पराङ्मुखी । प्रातिकूल्यमपि तत्तया कृतं बालया दयितमन्वकूलयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20012455,
    "chapter_id": 6692,
    "verse_number": "20.3",
    "content_sanskrit": "निर्यतीश्शयनसद्मनः सखीस्साऽनुगन्तुमचलत्त्रपाकुला । तान्निवेश्य दयितान्तिके ततस्ताः क्रमेण शनकैरपासरन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20012456,
    "chapter_id": 6692,
    "verse_number": "20.4",
    "content_sanskrit": "स्मेरमाच्छुरितकर्मवृत्तिभिः पश्यति स्म विजयो वधूमुखम् । कुङ्कुमोदयजरागरूषितं चन्द्रिकाचितमिवेन्दुमण्डलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20012457,
    "chapter_id": 6692,
    "verse_number": "20.5",
    "content_sanskrit": "पाणिनाऽऽकलितकेशमर्जुनो वक्त्रमुन्नमितमेणचक्षुषः । चुम्बति स्म मुकुलीकृतेक्षणं बालपद्ममिव सुप्तषट्पदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20012458,
    "chapter_id": 6692,
    "verse_number": "20.6",
    "content_sanskrit": "बाहुपञ्जरनिरुद्धविग्रहा प्रातिकूल्यमपि सोपगूहने । तन्वती तमधिनोदुरःस्थलं कोमलस्तनयुगेन मृद्नती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20012459,
    "chapter_id": 6692,
    "verse_number": "20.7",
    "content_sanskrit": "बाहुमध्यमृदुपीडितस्तनैरीषदात्तदशनच्छदामृतैः । सोऽनरुष्करनखद्विजार्पणैस्तामरीरमदकर्कशै रतैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20012460,
    "chapter_id": 6692,
    "verse_number": "20.8",
    "content_sanskrit": "जानती रतिकलाः क्रमेण सा पर्यशोभत विमुञ्चती त्रपाम् । शर्वरीव शशलाञ्छनत्विषो गृह्नतीतिमिरराजिमुज्झती ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20012461,
    "chapter_id": 6692,
    "verse_number": "20.9",
    "content_sanskrit": "सा गुरो रहसि याः किरीटिनः षष्टिमाप चतुरुत्तराः कलाः । ताभिरेव शयनेषु दक्षिणा दक्षिणाभिरमुमभ्यराधयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20012462,
    "chapter_id": 6692,
    "verse_number": "20.10",
    "content_sanskrit": "इन्धनैर्मदनजातवेदसः प्रेमसस्यानवमेघवारिभिः । स्पृष्टकादिभिरतर्पयत्प्रियं सा यथावसरमुन्नमत्कुचा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20012463,
    "chapter_id": 6692,
    "verse_number": "20.11",
    "content_sanskrit": "सा युगेन कुचचक्रगुच्छयोः पीडयन्त्यधिरुरोह वल्लभम् । वक्त्रपुष्पमिलितोष्ठपल्लवा सल्लतेव सहकारपादपम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20012464,
    "chapter_id": 6692,
    "verse_number": "20.12",
    "content_sanskrit": "क्षीरमिश्रमिव वारि बिभ्रती वल्लभाङ्गमिलितं निजं वपुः । शङ्करार्धकलितार्थविग्रहां शैलराजतनयाञ्जहास सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20012465,
    "chapter_id": 6692,
    "verse_number": "20.13",
    "content_sanskrit": "इन्दुसुन्दरतरद्विजच्छदा पीनवृत्तकुचमण्डलस्थया । कान्तदन्तशिखरैर्निबद्धया सा रराज मणिमालया भृशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20012466,
    "chapter_id": 6692,
    "verse_number": "20.14",
    "content_sanskrit": "पुण्डरीकनखपङ्क्तिमण्डितौ सन्मयूरपदकावधत्त सा । भूषितौ शशपदैस्समन्ततो भूधराविव पयोधराभुभौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20012467,
    "chapter_id": 6692,
    "verse_number": "20.15",
    "content_sanskrit": "फल्गुनो दशनपाणिजव्रणैर्माधवीविरचितैर्वृतो बभौ । मण्डलीकृतशरासनच्युतैर्जर्जरीकृत इव स्मरेषुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20012468,
    "chapter_id": 6692,
    "verse_number": "20.16",
    "content_sanskrit": "फुल्लचूतबकुलादिसौरभभ्रान्तभृङ्गकुलनिष्कुटालयौ । तौ वसन्तसमये विभूषितौ मन्मथाननुबभूवत् रसान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20012469,
    "chapter_id": 6692,
    "verse_number": "20.17",
    "content_sanskrit": "'चूतपुष्परसमत्तकोकिलस्वानपूर्णमदिरामदस्मरौ । तत्र तावतनुतां रतोत्सवान् भग्नहारमणिमेखलागुणान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20012470,
    "chapter_id": 6692,
    "verse_number": "20.18",
    "content_sanskrit": "सान्द्रचन्दनपरागधूसरौ तौ मृणालशयनेषु हारिणौ । सङ्गतावपि निदाघमूर्छणां निन्यतुर्विरहपीडिताविव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20012471,
    "chapter_id": 6692,
    "verse_number": "20.19",
    "content_sanskrit": "पक्षपेशलशिलीमुखक्षतैः पुण्डरीकनिकरैरलङ्कृतम् । मन्मथश्लथदुकूलयाऽर्जुनः कान्तया सह वनं व्यगाहत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20012472,
    "chapter_id": 6692,
    "verse_number": "20.20",
    "content_sanskrit": "स्नानशीतलमिलत्पयोधरा मल्लिकामुकुलगर्भकुन्तला । सौधमूर्ध्नि धवलेन्दुधाम्नि सा घर्मरात्रिषु सुखाचकार तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20012473,
    "chapter_id": 6692,
    "verse_number": "20.21",
    "content_sanskrit": "चन्द्रिकोदयदलत्कुमुद्वतीमन्दवातहतघर्मशीकरौ । ग्रीष्मरात्रिषु रतिश्रमालसौ तौ सरस्तटजुषौ निदद्रतुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20012474,
    "chapter_id": 6692,
    "verse_number": "20.22",
    "content_sanskrit": "केतकीमुकुलतीक्ष्णदंष्ट्रया चञ्चलाकपिशकेशपाशया । पुष्पराजदटवीदुकूलया घोरमेघरसिताट्टहासया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20012475,
    "chapter_id": 6692,
    "verse_number": "20.23",
    "content_sanskrit": "पीवरोन्नतपयोधरस्फुरत्कीकसोज्ज्वलवलाकमालया । प्रावृषा घनतमोभृता ततः पान्थकालनिशया विजृम्भितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20012476,
    "chapter_id": 6692,
    "verse_number": "20.24",
    "content_sanskrit": "कम्पितस्फुरदरण्यराजयः केतकीकुसुमगन्धबन्धवः । कीर्णमेघननववारिशीकराः बभ्रमुर्दिशि दिशि प्रभञ्जनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20012477,
    "chapter_id": 6692,
    "verse_number": "20.25",
    "content_sanskrit": "आक्षिपन्त्यतिजगन्मनोहरा वार्मुचां यवनिकामिवावलीम् । पक्षपातिमधुपावलीयुता सीदति स्म बिसिनी सरोगृहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20012478,
    "chapter_id": 6692,
    "verse_number": "20.26",
    "content_sanskrit": "विद्युदीक्षणविलोकगर्जितैर्वारिमुग्भिरभिनन्दिता इव । भूधरेषु विदधुः शिखण्डिनस्ताण्डवं ततशिखण्डमण्डलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20012479,
    "chapter_id": 6692,
    "verse_number": "20.27",
    "content_sanskrit": "बिभ्रती नवतृणावलिं बभौ सेन्द्रगोपनिकरा वसुन्धरा । वल्लभार्द्रनखलक्ष्मभूषिता रोमराजिमिव वारसुन्दरी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20012480,
    "chapter_id": 6692,
    "verse_number": "20.28",
    "content_sanskrit": "मुष्णतोऽधरमणित्विषं मुखैः शिञ्जितैश्च मधुरां सरस्वतीम् । कोपभाज इव गोपकन्यकाः शालिभक्तिषु शुकानवारयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20012481,
    "chapter_id": 6692,
    "verse_number": "20.29",
    "content_sanskrit": "कर्कशेतरतृणादिनिर्मितं नित्यनीतबहुलान्नपूरितम् । अध्यशेरत कुलायमण्डजाः वृष्टिषु प्रमुदिताः कुटुम्बिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20012482,
    "chapter_id": 6692,
    "verse_number": "20.30",
    "content_sanskrit": "वृष्टिषु प्रचुरशीतपीडिता बिभ्रतो वपुषि वेपथुं भृशम् । मर्कटा विटपमण्डलान्तरे विस्तृते विटपिनामुपाविशन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20012483,
    "chapter_id": 6692,
    "verse_number": "20.31",
    "content_sanskrit": "मेखलीकृतवराटकोऽहसन्नीलशोणमणिहारभूषणः । सेन्द्रचापबिसकर्णिकावलिं मेघमद्रिषु वनेचरीजनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20012484,
    "chapter_id": 6692,
    "verse_number": "20.32",
    "content_sanskrit": "पादपाद्रिपृथुपत्रवर्तिनो रेजिरे जलदवारिबिन्दवः । चञ्चलाघनघनोपगूहनच्छिन्नहारमणयश्च्युता इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20012485,
    "chapter_id": 6692,
    "verse_number": "20.33",
    "content_sanskrit": "ध्वान्तपूर्णमभवद्विना निशां मन्दिरश्रितजनं दिनान्दिनम् । मुक्तकारणमहासि केतकीकन्दलीप्रभृतिभिर्वने वने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20012486,
    "chapter_id": 6692,
    "verse_number": "20.34",
    "content_sanskrit": "मेघरुद्धमवलोक्य खे पतिं भास्करं तडिदलातमार्गितम् । सन्ततस्तनितवृष्टिभिर्घनैर्वासरा गुरुशुचोऽरुदन्निव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20012487,
    "chapter_id": 6692,
    "verse_number": "20.35",
    "content_sanskrit": "दुर्दिनान्यनवसानवृष्टिभिर्नीलमेघपटले विबभ्रति । माधवीविजययोरनल्पया तृष्णयाऽजनि परस्पराधरे ॥",
    "padaccheda": "",
    "anvaya": "",
