[{"id": 2116006, "chapter_id": 3498, "verse_number": "", "content_sanskrit": "वसिष्ठेन सूर्यानुमत्या तपत्यानयनम् । तपत्या सह संवरणस्य विवाहः । तयोर्वन एव द्वादशवर्षाणि विहारः । राष्ट्रे दुर्भिक्षपीडिते संवरणस्य प्रतिनिवृत्तिः । कुरुजन्म ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116007, "chapter_id": 3498, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116008, "chapter_id": 3498, "verse_number": "१", "content_sanskrit": "योजनानां चतुष्षष्टिं निमेषात् त्रिशतं तथा ।\nअश्वैर्गच्छति नित्यं यस्तं पार्श्वस्थोऽब्रवीदिदम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116009, "chapter_id": 3498, "verse_number": "२", "content_sanskrit": "अजाय लोकत्रयभावनाय भूतात्मने गोपतये वृषाय ।\nसूर्याय सर्गप्रळयालयाय नमो महाकारुणिकोत्तमाय \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116010, "chapter_id": 3498, "verse_number": "३", "content_sanskrit": "विवस्वते ज्ञानहृदन्तरात्मने जगत्प्रदीपाय जगद्धितैषिणे ।\nस्वयम्भुवे दीप्तसहस्रचक्षुषे सुरोत्तमायामिततेजसे नमः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116011, "chapter_id": 3498, "verse_number": "", "content_sanskrit": "सूर्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116012, "chapter_id": 3498, "verse_number": "४", "content_sanskrit": "स्तुतोऽहं वरदस्तेन वरं वरय सुव्रत ।\nस्तुतिस्त्वयोक्ता भक्तानां जप्येयं वरदोऽस्म्यहम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116013, "chapter_id": 3498, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116014, "chapter_id": 3498, "verse_number": "५", "content_sanskrit": "यैषा ते तपती नाम सावित्र्यवरजा सुता ।\nतां त्वां संवरणस्यार्थे वरयामि विभावसो\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116015, "chapter_id": 3498, "verse_number": "६", "content_sanskrit": "स हि राजा बृहत्कीर्तिर्धर्मार्थविदुदारधीः ।\nयुक्तः संवरणो भर्ता दुहितुस्ते विहङ्गम\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116016, "chapter_id": 3498, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116017, "chapter_id": 3498, "verse_number": "७", "content_sanskrit": "इत्युक्तः सविता तेन ददामीत्येव निश्चितः ।\nप्रत्यभाषत तं विप्रं प्रतिनन्द्य दिवाकरः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116018, "chapter_id": 3498, "verse_number": "८", "content_sanskrit": "वरः संवरणो राज्ञां त्वमृषीणां वरो मुने ।\nतपती योषितां श्रेष्ठा किमन्यत्रापसर्जनात् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116019, "chapter_id": 3498, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116020, "chapter_id": 3498, "verse_number": "९", "content_sanskrit": "ततः सर्वानवद्याङ्गीं तपतीं तपनः स्वयम् ।\nददौ संवरणस्यार्थे वसिष्ठाय महात्मने \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116021, "chapter_id": 3498, "verse_number": "१०", "content_sanskrit": "प्रतिजग्राह तां कन्यां महर्षिर्स्तपतीं तदा ।\nवसिष्ठोऽथ विसृष्टश्च पुनरेवाजगाम ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116022, "chapter_id": 3498, "verse_number": "११", "content_sanskrit": "यत्र विख्यातवीर्यः स कुरूणामृषभोऽभवत् ।\nस राजा मन्मथाविष्टः तद्गतेनान्तरात्मना \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116023, "chapter_id": 3498, "verse_number": "१२", "content_sanskrit": "दृष्ट्वा तु देवकन्यां तां तपतीं चारुहासिनीम् ।\nवसिष्ठेन सहायान्तीं स हृष्टोऽभ्यधिकं बभौ \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116024, "chapter_id": 3498, "verse_number": "१३", "content_sanskrit": "कृच्छ्राद् द्वादशरात्रेषु तस्य राज्ञः समाहिते ।\nआजगाम विशुद्धात्मा वसिष्ठो भगवानृषिः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116025, "chapter_id": 3498, "verse_number": "१४", "content_sanskrit": "तपसाऽऽराध्य विधिवद् देवं गोपतिमीश्वरम् ।\nलेभे संवरणो भार्यां वसिष्ठस्य च तेजसा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116026, "chapter_id": 3498, "verse_number": "१५", "content_sanskrit": "ततस्तस्मिन् गिरिश्रेष्ठे देवगन्धर्वसेविते ।\nजग्राह विधिवत् पाणिं तपत्याः स नरर्षभः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116027, "chapter_id": 3498, "verse_number": "१६", "content_sanskrit": "वसिष्ठेनाभ्यनुज्ञातः तस्मिन्नेव धराधरे ।\nसोऽकामयत राजर्षिर्विहर्तुं सह भार्यया \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116028, "chapter_id": 3498, "verse_number": "१७", "content_sanskrit": "ततः पुरेषु राष्ट्रेषु वाहनेषु बलेषु च ।\nआदिदेश महीपालः तमेव सचिवं तदा \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116029, "chapter_id": 3498, "verse_number": "१८", "content_sanskrit": "नृपतिं त्वभ्यनुज्ञाप्य वसिष्ठोऽथापचक्रमे ।\nस हि राजा गिरौ तस्मिन् विजहारामरोपमः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116030, "chapter_id": 3498, "verse_number": "१९", "content_sanskrit": "ततो द्वादशवर्षाणि काननेषु जलेषु च ।\nरेमे तस्मिन् गिरौ राजा सहितो भार्यया यदा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116031, "chapter_id": 3498, "verse_number": "२०", "content_sanskrit": "तस्य राज्ञः पुरे तस्मिन् समा द्वादश सर्वशः ।\nन ववर्ष सहस्राक्षो रहितेऽथ नृपे तदा \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116032, "chapter_id": 3498, "verse_number": "२१", "content_sanskrit": "तत् क्षुधार्तैर्निरानन्दैः शवभूतैस्तदा नरैः ।\nअभवत् प्रेतराजस्य पुरं प्रेतैरिवावृतम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116033, "chapter_id": 3498, "verse_number": "२२", "content_sanskrit": "ततस्तं तादृशं दृष्ट्वा स एव भगवानृषिः ।\nअभ्यपद्यत धर्मात्मा वसिष्ठो नरसत्तमम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116034, "chapter_id": 3498, "verse_number": "२३", "content_sanskrit": "तं च पार्थिवशार्दूलमानयामास तत्पुरम् ।\nतपत्या सहितं तत्र वर्षे द्वादशमे गते \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116035, "chapter_id": 3498, "verse_number": "२४", "content_sanskrit": "ततः प्रहृष्टस्तत्रासीद् यथाकालं सुरारिहा ।\nततस्तु राजशार्दूले प्रविष्टे नगरं पुनः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116036, "chapter_id": 3498, "verse_number": "२५", "content_sanskrit": "प्रववर्ष सहस्राक्षः सस्यानि जनयन् प्रभुः ।\nततस्तु राष्ट्रं मुमुदे तत् पुरं परया मुदा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116037, "chapter_id": 3498, "verse_number": "२६", "content_sanskrit": "तेन पार्थिवमुख्येन भावितं भावितात्मना ।\nततो द्वादश वर्षाणि पुनरीजे जनाधिपः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116038, "chapter_id": 3498, "verse_number": "२७", "content_sanskrit": "पत्न्या तपत्या सहितो यथा शच्या मरुत्पतिः ।\nएवमासीन्महाभाग तपती नाम पूर्विका \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116039, "chapter_id": 3498, "verse_number": "२८", "content_sanskrit": "सैषा वैवस्वती कन्या लब्धा संवरणेन ह ।\nतस्यां स जनयामास कुरुं संवरणो नृपः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116040, "chapter_id": 3498, "verse_number": "२९", "content_sanskrit": "तपत्यां तपतां श्रेष्ठ तापत्यस्त्वं ततोऽर्जुन ।\nकुरूद्भवा यतो यूयं कौरवाः कुरवस्तथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116041, "chapter_id": 3498, "verse_number": "३०", "content_sanskrit": "पौरवा आजमीढाश्च भारता भरतर्षभ ।\nतस्मात् त्वां कौरवेत्याहुः कुरूणां प्रथितेन च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116042, "chapter_id": 3498, "verse_number": "३१", "content_sanskrit": "तापत्यमखिलं प्रोक्तं वृत्तान्तं तव पूर्विकम् ।\nपुरोहितमुखा यूयं भुङ्क्ष्वध्वं पृथिवीमिमाम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116043, "chapter_id": 3498, "verse_number": "१०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तसप्तत्यधिकशततमोऽध्यायः ॥१७७॥\n॥ इति चैत्ररथपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116044, "chapter_id": 3498, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]