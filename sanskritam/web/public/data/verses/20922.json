[{"id": 7000922000, "chapter_id": 20922, "verse_number": "७-१०-१", "content_sanskrit": "जैमिनिरुवाच ।\nमाहात्म्यमेतद्गङ्गायास्त्वत्प्रसादाच्छ्रुतं मया ।\nइदानीं श्रोतुमिच्छामि विष्णुपूजाफलं गुरो ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000922001, "chapter_id": 20922, "verse_number": "७-१०-२", "content_sanskrit": "व्यास उवाच ।\nशृणु लक्ष्मीपतेर्वत्स सपर्या फलमुत्तमम् ।\nयच्छ्रुत्वा मानवाः सर्वे लभंते ज्ञानमुत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000922002, "chapter_id": 20922, "verse_number": "७-१०-३", "content_sanskrit": "विप्र द्वादशमासेषु माघादिषु सनातनः ।\nपूजितव्यो विधानैर्यैः शृणु तानि वदाम्यहम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000922003, "chapter_id": 20922, "verse_number": "७-१०-४", "content_sanskrit": "माघेमासि समायाते सर्वमासोत्तमे शुभे ।\nआमिषं मैथुनं चैव त्याजयेद्वैष्णवोत्तमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000922004, "chapter_id": 20922, "verse_number": "७-१०-५", "content_sanskrit": "प्रातःस्नायी भवेन्नित्यं तैलान्यपि च वर्जयेत् ।\nद्विर्भोजनं परान्नं च माघेमासि परित्यजेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000922005, "chapter_id": 20922, "verse_number": "७-१०-६", "content_sanskrit": "प्रातः शुक्लांबरधरः कृतपंच महाध्वरः ।\nसपर्यामारभेद्विष्णोः स्थिरचित्तो हि मानवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000922006, "chapter_id": 20922, "verse_number": "७-१०-७", "content_sanskrit": "ईषदुष्णजलैः शुद्धैः स्नापयेद्विष्णुमव्ययम् ।\nअतिश्लथैश्चंदनैश्च विष्णोरङ्गानि लेपयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000922007, "chapter_id": 20922, "verse_number": "७-१०-८", "content_sanskrit": "पूजयेज्जगदीशस्य देवदेवस्य चक्रिणः ।\nप्रक्षालितानि पात्राणि जलहीनानि कारयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000922008, "chapter_id": 20922, "verse_number": "७-१०-९", "content_sanskrit": "स्नापयित्वा जगन्नाथमीषदुष्णेन वारिणा ।\nप्रोक्षितव्यं तच्छरीरं दिव्यवस्त्रेण यत्नतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000922009, "chapter_id": 20922, "verse_number": "७-१०-१०", "content_sanskrit": "सलिलैरीषदुष्णैश्च प्रस्नापयति केशवम् ।\nमाघेमासि द्विजश्रेष्ठ फलं तस्य मयोच्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000922010, "chapter_id": 20922, "verse_number": "७-१०-११", "content_sanskrit": "विमुक्तः पातकैः सर्वैर्जन्मजन्मांतरार्जितैः ।\nइह भुंक्ते सुखं सर्वं शेषे याति हरेर्गृहम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000922011, "chapter_id": 20922, "verse_number": "७-१०-१२", "content_sanskrit": "यत्नात्प्रक्षाल्य पात्राणि कृत्वाशुद्धानिवारिभिः ।\nयः पूजयेज्जगन्नाथं तस्य पुण्यं निशामय ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000922012, "chapter_id": 20922, "verse_number": "७-१०-१३", "content_sanskrit": "इह भुक्त्वाखिलान्कामान्सर्वव्याधिविवर्जितः ।\nअंते युगसहस्राणि तिष्ठेत्केशवमंदिरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000922013, "chapter_id": 20922, "verse_number": "७-१०-१४", "content_sanskrit": "प्रभाते विश्वसंध्यायां पुरतश्चक्रपाणिनः ।\nज्वलंतं स्थापयेद्वह्निं निर्द्धूमं वैष्णवो जनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000922014, "chapter_id": 20922, "verse_number": "७-१०-१५", "content_sanskrit": "शीतस्य वारणार्थाय सायंप्रातश्च वैष्णवः ।\nमाघे विष्ण्वग्रतो वह्निं ज्वालयेत्तत्फलंशृणु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000922015, "chapter_id": 20922, "verse_number": "७-१०-१६", "content_sanskrit": "इह भुक्त्वाखिलान्कामान्पुत्रपौत्रसमन्वितः ।\nअंते विष्णुपुरं याति दैवतैरपि दुर्ल्लभम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000922016, "chapter_id": 20922, "verse_number": "७-१०-१७", "content_sanskrit": "यथैवात्मा तथा विष्णुः संदेहोनात्र विद्यते ।\nस्वपंतं देवदेवेशं पर्यंकोपरि केशवम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000922017, "chapter_id": 20922, "verse_number": "७-१०-१८", "content_sanskrit": "आत्मनः कुरुते मर्त्यो यथा शीतनिवारणम् ।\nक्षीरेण स्नापयेद्यस्तु माघे मासि जनार्दनम् ।\nतस्मै देवोत्तमो विष्णुः संतुष्टो न ददाति किम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000922018, "chapter_id": 20922, "verse_number": "७-१०-१९", "content_sanskrit": "तथा शीतक्षयं कुर्याद्दिव्यवस्त्रेण चक्रिणः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000922019, "chapter_id": 20922, "verse_number": "७-१०-२०", "content_sanskrit": "यः पूजयेत्सकृन्माघे स्नापयित्वा चतुर्भुजम् ।\nनालिकेरोदकैर्दुग्धैः फलं तस्य वदाम्यहम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000922020, "chapter_id": 20922, "verse_number": "७-१०-२१", "content_sanskrit": "नरकाब्धौ मज्जमानान्दुस्तरे स्वेन कर्मणा ।\nउद्धृत्य कोटिपुरुषान्स याति चक्रिणः पदम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000922021, "chapter_id": 20922, "verse_number": "७-१०-२२", "content_sanskrit": "माघे मासे च शुक्लायां पंचम्यां द्विजसत्तम ।\nएकादश्यां च पंचम्यां हरिपूजा विशेषतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000922022, "chapter_id": 20922, "verse_number": "७-१०-२३", "content_sanskrit": "दातव्यो देवदेवाय सपद्माय मुरारये ।\nपायसो धूपसहितो माघेमासि दिने दिने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000922023, "chapter_id": 20922, "verse_number": "७-१०-२४", "content_sanskrit": "सधूपपायसं यस्तु माघे यच्छति चक्रिणे ।\nतस्य पुण्यफलं वच्मि शृणु वैष्णव जैमिने ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000922024, "chapter_id": 20922, "verse_number": "७-१०-२५", "content_sanskrit": "अंते विष्णुपुरं गत्वा मन्वंतरचतुष्टयम् ।\nभुंक्ते मनोरमान्भोगान्प्रसादाच्चक्रपाणिनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000922025, "chapter_id": 20922, "verse_number": "७-१०-२६", "content_sanskrit": "पुनरागत्य धरणीं चक्रवर्ती नृपो भवेत् ।\nभुंक्ते च भोगं सुचिरं मृतो याति हरेर्गृहम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000922026, "chapter_id": 20922, "verse_number": "७-१०-२७", "content_sanskrit": "पंचम्यां वापि सप्तम्यामेकादश्यां च जैमिने ।\nअशक्तो वैष्णवो दद्यात्परमान्नं मुरारये ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000922027, "chapter_id": 20922, "verse_number": "७-१०-२८", "content_sanskrit": "कृष्णपक्षाद्दिवजश्रेष्ठ शुक्लपक्षे विशेषतः ।\nशुक्लपक्षे तिथिष्वेषु दद्यादन्नं मुरारये ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000922028, "chapter_id": 20922, "verse_number": "७-१०-२९", "content_sanskrit": "एकाहमपि यो माघे विष्णवे दैत्यजिष्णवे ।\nसपूपंपायसं दद्यान्न तस्य दुर्ल्लभो हरिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000922029, "chapter_id": 20922, "verse_number": "७-१०-३०", "content_sanskrit": "यत्किच्चिद्दिवजतुष्ट्यर्थं माघेमासि प्रदीयते ।\nतदक्षयं भवेत्पुंसः कोऽपि नास्त्यत्र संशयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000922030, "chapter_id": 20922, "verse_number": "७-१०-३१", "content_sanskrit": "माघे मासि कृतं कर्म शुभं वाशुभमेव वा ।\nतस्य नास्ति क्षयं विप्र मन्वंतरशतैरपि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000922031, "chapter_id": 20922, "verse_number": "७-१०-३२", "content_sanskrit": "माघे चंपकपुष्पेण योऽर्चयेत्कमलापतिम् ।\nस गच्छेत्परमं धाम विमुक्तः सर्वपातकैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000922032, "chapter_id": 20922, "verse_number": "७-१०-३३", "content_sanskrit": "यावंति स्वर्णपुष्पाणि दीयंते चक्रपाणये ।\nतावद्युगसहस्राणि स्थीयते विष्णुमंदिरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000922033, "chapter_id": 20922, "verse_number": "७-१०-३४", "content_sanskrit": "मेरुतुल्यसुवर्णानि दत्वा भवति यत्फलम् ।\nएकेन स्वर्णपुष्पेण हरिं संपूज्य तत्फलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000922034, "chapter_id": 20922, "verse_number": "७-१०-३५", "content_sanskrit": "सुवर्णपुष्पं विप्रेन्द्र सर्वदा केशवप्रियम् ।\nमाघेमासि विशेषेण पवित्रं केशवप्रियम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000922035, "chapter_id": 20922, "verse_number": "७-१०-३६", "content_sanskrit": "सुवर्णकुसुमैर्दिव्यैर्येन नाराधितो हरिः ।\nरत्नैर्हीनः सुवर्णाद्यैः स भवेज्जन्मजन्मनि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000922036, "chapter_id": 20922, "verse_number": "७-१०-३७", "content_sanskrit": "फलं चंपकपुष्पस्य ब्रवीम्यहं विशेषतः ।\nआकर्णय द्विजश्रेष्ठ सेतिहासमनुत्तमम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000922037, "chapter_id": 20922, "verse_number": "७-१०-३८", "content_sanskrit": "सुवर्णो नाम भूपालो बलवान्सर्वशास्त्रवित् ।\nआर्यावर्तेषु सर्वेषु बभूव विप्रवर्चसा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000922038, "chapter_id": 20922, "verse_number": "७-१०-३९", "content_sanskrit": "राजश्रिया विद्यया च वयसा च स भूपतिः ।\nअतिप्रमत्तो विप्रर्षे सदा पापरतोऽभवत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000922039, "chapter_id": 20922, "verse_number": "७-१०-४०", "content_sanskrit": "पाखंडमंत्रिणां वाक्यैर्विनादोषैरपि द्विज ।\nधनलोभात्तेन राज्ञा दंड्यंते साधवो जनाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000922040, "chapter_id": 20922, "verse_number": "७-१०-४१", "content_sanskrit": "अन्यायोपार्जितं वित्तं गीतवाद्यादिभिर्वृतः ।\nसमस्तं नाशयामास यज्ञदानविवर्जितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000922041, "chapter_id": 20922, "verse_number": "७-१०-४२", "content_sanskrit": "न ज्ञातिपोषणं चक्रे न देवद्विजभोजनम् ।\nन च याचकसंतुष्टिं सर्वदा पापमोहितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000922042, "chapter_id": 20922, "verse_number": "७-१०-४३", "content_sanskrit": "न चकारातिथेः पूजां सदा पापपरायणः ।\nययौ च मंदिरान्नित्यं स भूपः पापमंदिरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000922043, "chapter_id": 20922, "verse_number": "७-१०-४४", "content_sanskrit": "कृतानि तेन पापानि यान्यन्यान्यविवेकिनाम् ।\nअपि वर्षशतैः शक्तः संख्यातुं जनितानि किम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000922044, "chapter_id": 20922, "verse_number": "७-१०-४५", "content_sanskrit": "एकदा स महीपालः कामेन परिमोहितः ।\nजगाम वेश्यानिलयं निशीथे दुरिताशयः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000922045, "chapter_id": 20922, "verse_number": "७-१०-४६", "content_sanskrit": "तमायांतं ततो दृष्ट्वा भूपालमुज्ज्वलाह्वया ।\nसहसोत्थाय पर्यंके चक्रे तत्पादवंदनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000922046, "chapter_id": 20922, "verse_number": "७-१०-४७", "content_sanskrit": "प्रक्षाल्य तत्पादयुगं भृंगारसलिलैश्च सा ।\nमंचे निवेशयामास दोर्भ्यामालिङ्ग्य तं नृपम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000922047, "chapter_id": 20922, "verse_number": "७-१०-४८", "content_sanskrit": "तत्प्रेमामृतधाराभिः सिक्तोऽसौ पृथिवीपतिः ।\nतस्मिन्नुवास पर्यंके तया सह कुतूहली ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000922048, "chapter_id": 20922, "verse_number": "७-१०-४९", "content_sanskrit": "ततः सा गणिका प्रीत्या हसंती नवयौवना ।\nददौ चंपकपुष्पाणां तस्मै भूमिभुजे स्वयम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000922049, "chapter_id": 20922, "verse_number": "७-१०-५०", "content_sanskrit": "पुष्पमाला पुष्पमेकं तस्माद्भूपति हस्ततः ।\nपपात धरणीपृष्ठे गन्धव्याप्तदिगंतरम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000922050, "chapter_id": 20922, "verse_number": "७-१०-५१", "content_sanskrit": "तच्च्युतं कुसुमं दृष्ट्वा स राजाऽत्यतसंभ्रमात् ।\nनमोनारायणायेति जगादोङ्कारपूर्वकम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000922051, "chapter_id": 20922, "verse_number": "७-१०-५२", "content_sanskrit": "नारायणायेति वाक्यात्सर्वाणि पातकानि च ।\nस्वर्णपुष्पप्रदानेन तस्य नष्टानि भूभुजः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000922052, "chapter_id": 20922, "verse_number": "७-१०-५३", "content_sanskrit": "ग्रामीणा अथ सर्वेऽपि समागत्यातिदुर्जये ।\nतस्यामेव निशायां तं जघ्नुर्वेश्यागृहे स्थितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000922053, "chapter_id": 20922, "verse_number": "७-१०-५४", "content_sanskrit": "नेतुं तमथ भूपालं सर्वपातकिनां वरम् ।\nकिंकरान्प्रेषयामास क्रुद्धो वैवस्वतो भृशम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000922054, "chapter_id": 20922, "verse_number": "७-१०-५५", "content_sanskrit": "तेनाज्ञप्तास्ततो दूताः पाशमुद्गरपाणयः ।\nअतिवेगात्समायाताः क्रोधसंरक्तलोचनाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000922055, "chapter_id": 20922, "verse_number": "७-१०-५६", "content_sanskrit": "उद्यमं चक्रिरे नेतुं यमदूताः स्वमालयम् ।\nततो नारायणप्रेष्याः शङ्खचक्रगदाधराः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000922056, "chapter_id": 20922, "verse_number": "७-१०-५७", "content_sanskrit": "आयाता गरुडारूढास्तं नेतुं पृथिवीपतिम् ।\nपाशे नियंत्रितं दृष्ट्वा तं भूपं विष्णुकिंकराः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000922057, "chapter_id": 20922, "verse_number": "७-१०-५८", "content_sanskrit": "जघ्नुश्चक्रैर्गदाभिश्च यमदूतान्महाबलाः ।\nसमारोप्य रथे दिव्ये शंखान्दध्मुरनुत्तमान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000922058, "chapter_id": 20922, "verse_number": "७-१०-५९", "content_sanskrit": "तथा राजा रथारूढस्तुलसीमाल्यभूषितः ।\nपीतकौशेयवासाश्च स्वर्णालंकारभूषितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000922059, "chapter_id": 20922, "verse_number": "७-१०-६०", "content_sanskrit": "स्तूयमानो मुनिगर्णैर्वेदवेदाङ्गपारगैः ।\nविष्णुदूतैः परिवृतो हरेः सालोक्यमाययौ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000922060, "chapter_id": 20922, "verse_number": "७-१०-६१", "content_sanskrit": "अथोत्थाय स्वयं विष्णुश्चतुर्भिर्दीर्घबाहुभिः ।\nतमालिंगितवान्भूपं प्रोक्तवांश्च द्विजोत्तम ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000922061, "chapter_id": 20922, "verse_number": "७-१०-६२", "content_sanskrit": "श्रीभगवानुवाच ।\nनृपते कुशलं ब्रूहि सर्वपुण्यात्मनां वर ।\nकिमस्ति साध्यं भवतस्तदाज्ञापय संप्रति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000922062, "chapter_id": 20922, "verse_number": "७-१०-६३", "content_sanskrit": "नमोनारायणायेति वारैकमपि यो वदेत् ।\nनित्यं तस्यानुपाल्योऽहं स मे भ्राता स मे पिता ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000922063, "chapter_id": 20922, "verse_number": "७-१०-६४", "content_sanskrit": "नारायणेति मन्नाम कदाचिद्यः स्मेरन्नरः ।\nसाधयाम्यखिलं तस्य पितुः पुत्र इवेप्सितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000922064, "chapter_id": 20922, "verse_number": "७-१०-६५", "content_sanskrit": "भक्तोऽसि नृपतिश्रेष्ठ तस्मान्निजमनोरथम् ।\nप्रकाशयाद्भुतं तात किं ते दास्यामि चाधुना ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000922065, "chapter_id": 20922, "verse_number": "७-१०-६६", "content_sanskrit": "राजोवाच ।\nसर्वमेव दयासिन्धो त्वया दत्तं न संशयः ।\nपापिनापि मया प्राप्तं तव स्थानं सुदुर्ल्लभम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000922066, "chapter_id": 20922, "verse_number": "७-१०-६७", "content_sanskrit": "तस्यानेन तु वाक्येन प्रसन्नः कमलापतिः ।\nस्नेहान्निवेशयामास भूपालं तन्निशामय ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000922067, "chapter_id": 20922, "verse_number": "७-१०-६८", "content_sanskrit": "ततः सुवर्णालंकारैर्विश्वकर्मविनिर्मितैः ।\nचकार मण्डलं तस्य स्वयमेव दयामया ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000922068, "chapter_id": 20922, "verse_number": "७-१०-६९", "content_sanskrit": "अथ नानाविधैर्भक्ष्यैर्दिव्यैरपि सुदुर्ल्लभैः ।\nतोषितः स महीपालो विष्णुनाति सहिष्णुना ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000922069, "chapter_id": 20922, "verse_number": "७-१०-७०", "content_sanskrit": "एवं प्रतिदिनं तस्थौ स राजा विष्णुमंदिरम् ।\nमन्वन्तरसहस्राणि नव वर्ष शतानि च ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000922070, "chapter_id": 20922, "verse_number": "७-१०-७१", "content_sanskrit": "प्रजानां पालनं चक्रे स राजा धर्मतत्परः ।\nपूजयामास सततं भक्त्या परमया हरिः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000922071, "chapter_id": 20922, "verse_number": "७-१०-७२", "content_sanskrit": "चारु चंपकपुष्पैश्च नैवेद्यैर्विविधैश्च सः ।\nआयुःशेषे स भूपालो मरणं जाह्नवी जले ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000922072, "chapter_id": 20922, "verse_number": "७-१०-७३", "content_sanskrit": "समासाद्य ययौ मोक्षं प्रसादाच्चक्रपाणिनः ।\nव्यास उवाच ।\nविप्र चंपकपुष्पस्य प्रभावोऽयं प्रकीर्तितः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000922073, "chapter_id": 20922, "verse_number": "७-१०-७४", "content_sanskrit": "चपंकैर्हरिमभ्यर्च्य मुक्ताः स्युः पापिनो जनाः ।\nस्फुटचंपकपुष्पेण पूजितो भगवान्हरिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000922074, "chapter_id": 20922, "verse_number": "७-१०-७५", "content_sanskrit": "अचिरेणैव विप्रर्षे ददाति परमं पदम् ।\nये यजंति परात्मानमिच्छया वाप्यनिच्छया ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000922075, "chapter_id": 20922, "verse_number": "७-१०-७६", "content_sanskrit": "तेऽपि यांति परं धाम विमुक्ताः सर्वपातकैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000922076, "chapter_id": 20922, "verse_number": "७-१०-७७", "content_sanskrit": "हरौ प्रसन्ने दुरितानिकोऽपि यतः स राजा कृतपातकोऽपि ।\nजगाम मोक्षं कृपयामुरारेर्विश्वार्णवं निम्नमिमं वितीर्य ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000922077, "chapter_id": 20922, "verse_number": "७-१०-७८", "content_sanskrit": "दिव्यैः सुगन्धैः कनकप्रसूनैर्नारायणं पद्मदलायताक्षम् ।\nभक्त्या यजेद्यः परमादरेण मर्त्यो व्रजेत्तत्तु विहाय पापम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]