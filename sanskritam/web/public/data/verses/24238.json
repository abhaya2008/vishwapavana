[{"id": 7004238000, "chapter_id": 24238, "verse_number": "५-२-१६-१", "content_sanskrit": "ईश्वर उवाच ।\nईशानेश्वरसंज्ञं तु षोडशं विद्धि पार्वति ।\nयस्य दर्शनमात्रेण ऐश्वर्यं जायते नृणाम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004238001, "chapter_id": 24238, "verse_number": "५-२-१६-२", "content_sanskrit": "तुहुंडेन पुरा देवि सर्वे ह्युपद्रुताः सुराः ।\nऋषयश्च महाभागा यक्षगन्धर्वकि न्नराः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004238002, "chapter_id": 24238, "verse_number": "५-२-१६-३", "content_sanskrit": "नंदनाख्यं वनं सर्वं तदधीनमभूत्किल ।\nऐरावणं द्विपेन्द्रं च जित्वा द्वारि समादधत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004238003, "chapter_id": 24238, "verse_number": "५-२-१६-४", "content_sanskrit": "उच्चैःश्रवससंज्ञं तु हृतवान्दानवेश्वरः ।\nदेवांगनानां सर्वासां विध्वंसं कर्तुमुद्यतः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004238004, "chapter_id": 24238, "verse_number": "५-२-१६-५", "content_sanskrit": "स्वर्गमार्गः खिलीभूतस्तद्भयेन ह्यभूत्सति ।\nहृताधिकारा देवाश्च मंत्रं समुपचक्रमुः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004238005, "chapter_id": 24238, "verse_number": "५-२-१६-६", "content_sanskrit": "तस्मिन्काले च कालज्ञो नारदोऽथ महामुनिः ।\nआजगाम महातेजा भ्रममाणश्च मंत्रिभिः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004238006, "chapter_id": 24238, "verse_number": "५-२-१६-७", "content_sanskrit": "देवैर्नमस्कृतः सोऽथ पूजितश्च यथाविधि ।\nनिवेदितं यथावृत्तं तुहुण्डस्य विचेष्टितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004238007, "chapter_id": 24238, "verse_number": "५-२-१६-८", "content_sanskrit": "पप्रच्छुरथ ते मंत्रं नारदं मुनिसत्तमम् ।\nकथयस्व महाबुद्धे सर्वं जानासि सर्व्वतः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004238008, "chapter_id": 24238, "verse_number": "५-२-१६-९", "content_sanskrit": "ईदृक्काले समायाते किं कर्त्तव्यं महामुने ।\nनाज्ञातं त्रिषु लोकेषु किंचिद्देवर्षिसत्तम॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004238009, "chapter_id": 24238, "verse_number": "५-२-१६-१०", "content_sanskrit": "मुहूर्तं ध्यानमालंब्य किंचिन्मील्य च लोचने ।\nउपायं कथयामास सर्वदुःखविनाशनम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004238010, "chapter_id": 24238, "verse_number": "५-२-१६-११", "content_sanskrit": "महाकालवने रम्ये शीघ्रं गच्छंतु विह्वलाः ।\nइन्द्रद्युम्नेश्वरस्यैव पश्चाद्भागे व्यवस्थिताः ।\nसेवध्वं परमं लिंगमीशानेश्वरसंज्ञकम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004238011, "chapter_id": 24238, "verse_number": "५-२-१६-१२", "content_sanskrit": "पुरा चेशानकल्पे तु ईशानेन सुखेन हि ।\nमुनिना श्रोत्रियेणैव वेदाभ्यासरतेन वै ।\nउत्तमांगपदं लब्धं शंकरस्य च मूर्द्धनि॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004238012, "chapter_id": 24238, "verse_number": "५-२-१६-१३", "content_sanskrit": "तस्याराधनमात्रेण मनोऽभीष्टं हि लभ्यते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004238013, "chapter_id": 24238, "verse_number": "५-२-१६-१४", "content_sanskrit": "नारदस्य वचः श्रुत्वा देवा मुदितमानसाः ।\nजग्मुर्यत्र महल्लिंगं स्तुतिं सर्वेऽप्यकुर्वत॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004238014, "chapter_id": 24238, "verse_number": "५-२-१६-१५", "content_sanskrit": "ईशानेशान ईशान तत्पुरुष नमोऽस्तु ते ।\nनमो वाम महाघोर सद्योमुख नमोनमः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004238015, "chapter_id": 24238, "verse_number": "५-२-१६-१६", "content_sanskrit": "त्र्यक्ष भर्ग महादेव उमाकांत नमोनमः ।\nनमः शिव नमो भीम नमः सर्व नमोनमः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004238016, "chapter_id": 24238, "verse_number": "५-२-१६-१७", "content_sanskrit": "नमः शंभो नमो रुद्र विरूपाक्ष नमोनमः ।\nत्वया देव प्रजाः सर्वाः सदेवासुरमानुषाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004238017, "chapter_id": 24238, "verse_number": "५-२-१६-१८", "content_sanskrit": "स्थावराणि च भूतानि जंगमानि चराणि च ।\nब्रह्म वेदाश्च वेद्यं च त्वया सृष्टं महेश्वर॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004238018, "chapter_id": 24238, "verse_number": "५-२-१६-१९", "content_sanskrit": "शिरस्ते गगनं देवा नेत्रे शशिदिवाकरौ ।\nनिःश्वासः पवनश्चापि तेजोऽग्निश्च तवाच्युतः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004238019, "chapter_id": 24238, "verse_number": "५-२-१६-२०", "content_sanskrit": "बाहवस्ते दिशः सर्वाः कुक्षिश्चैव महार्णवः ।\nउरू ते पर्वता देव चरणौ पृथिवी मता॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004238020, "chapter_id": 24238, "verse_number": "५-२-१६-२१", "content_sanskrit": "इंद्रसोमाग्निवरुणा देवासुरमहोरगाः ।\nप्रह्वास्त्वामनुतिष्ठंति स्तुवंतो विविधैः स्तवैः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004238021, "chapter_id": 24238, "verse_number": "५-२-१६-२२", "content_sanskrit": "त्वया व्याप्तानि भूतानि सर्वाणि भुवनेश्वर ।\nत्वयि तुष्टे जगत्तुष्टं त्वयि क्रुद्धे महद्भयम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004238022, "chapter_id": 24238, "verse_number": "५-२-१६-२३", "content_sanskrit": "भयानामपनेतासि त्वमेकः शत्रुसूदनः ।\nअसुराणां समर्थानां विनाशश्च त्वया कृतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004238023, "chapter_id": 24238, "verse_number": "५-२-१६-२४", "content_sanskrit": "न च विक्रमणैर्देव निर्वाणमगमत्परम् ।\nत्वं हि कर्त्ता विकर्त्ता च भूतानामिह सर्वशः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004238024, "chapter_id": 24238, "verse_number": "५-२-१६-२५", "content_sanskrit": "आराधयित्वा सर्वे ते नमस्यंति च सर्वशः ।\nएतस्मिन्नंतरे देवि लिंगमध्यात्समुत्थिता॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004238025, "chapter_id": 24238, "verse_number": "५-२-१६-२६", "content_sanskrit": "धूमावृता महा ज्वाला यया दग्धः स दानवः ।\nतुहुण्डो मुंडपुत्रस्तु ससैन्यपरिवारितः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004238026, "chapter_id": 24238, "verse_number": "५-२-१६-२७", "content_sanskrit": "स्वाधिकारांश्च संप्रापुर्लिंगस्यास्य प्रभावतः ।\nसुरैश्चाख्या समादिष्टा लिंगस्यास्यैव हर्षितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004238027, "chapter_id": 24238, "verse_number": "५-२-१६-२८", "content_sanskrit": "ऐश्वर्यशीलमस्यास्तीत्यस्माकं च विनिश्चितम् ।\nईशान इति विख्यातस्त्रैलोक्ये च भविष्यति॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004238028, "chapter_id": 24238, "verse_number": "५-२-१६-२९", "content_sanskrit": "ईशानेश्वरसंज्ञं तु ये समाराधयंति च ।\nकीर्तिर्लक्ष्मीर्ध्रुवा तेषां सिद्धिः प्रीतिर्भविष्यति॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004238029, "chapter_id": 24238, "verse_number": "५-२-१६-३०", "content_sanskrit": "पूज्यमानः सदा देवैर्गंधर्वाप्सरसांगणैः ।\nस्वर्गलोकं गमिष्यंति विमानैरुज्ज्वलैर्मुदा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004238030, "chapter_id": 24238, "verse_number": "५-२-१६-३१", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्राः स्त्रियः कुमारिकाः ।\nयथाभिलषितान्कामानाप्नुवंति न संशयः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004238031, "chapter_id": 24238, "verse_number": "५-२-१६-३२", "content_sanskrit": "यः करोति नरः सम्यग्दर्शनं नियमस्थितः ।\nन कुत्र तस्य हानिः स्याद्यावजन्मशतं भवेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004238032, "chapter_id": 24238, "verse_number": "५-२-१६-३३", "content_sanskrit": "सर्वदा सर्वकार्येषु ते समर्था यशस्विनि ।\nईशानेश्वरसंज्ञं तु ये पश्यंति दिनेदिने॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004238033, "chapter_id": 24238, "verse_number": "५-२-१६-३४", "content_sanskrit": "एवं ते कथितो देवि प्रभावः पापनाशनः ।\nईशानेश्वरदेवस्य श्रूयतामप्सरेश्वरः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]