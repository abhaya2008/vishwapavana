[{"id": 7005489000, "chapter_id": 25489, "verse_number": "२-६-१", "content_sanskrit": "ईश्‍वर (शंकर ) ऋषिगणोंको अपना सर्वव्यापी स्वरुप बतलाना तथा अपनी भगवत्ताका और इस ज्ञानसे मुक्तिकी प्राप्तिका निरुपण करना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005489001, "chapter_id": 25489, "verse_number": "२-६-२", "content_sanskrit": "ईश्‍वर उवाच ।\nश्रृणुध्वमृषयाः सर्वे यथावत परमेष्ठिनः ।\nवक्ष्योमीशस्य माहात्म्यं यत्तद्वेदविदो विदुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005489002, "chapter_id": 25489, "verse_number": "२-६-३", "content_sanskrit": "सर्वलोकैकनिर्माता सर्वलोकैकरक्षिता ।\nसर्वलोकैकसंहर्ता सर्वत्माहं सनातनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005489003, "chapter_id": 25489, "verse_number": "२-६-४", "content_sanskrit": "सर्वेषामेव वस्तुनामन्तर्यामी पिता ह्याहम ।\nमध्ये चन्तः स्थितं सर्व नाहं सर्वत्र संस्थितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005489004, "chapter_id": 25489, "verse_number": "२-६-५", "content_sanskrit": "भवद्भिरदभुतं दृष्टं यत्स्वरुपं तु मामकम ।\nममैषा ह्युपमा विप्रा मायया दर्शिता मया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005489005, "chapter_id": 25489, "verse_number": "२-६-६", "content_sanskrit": "सर्वेषामेव भावानामन्तरा समवस्थितः ।\nप्रेरयामि जगत कृत्स्नं क्रियाशक्तिरियं मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005489006, "chapter_id": 25489, "verse_number": "२-६-७", "content_sanskrit": "ययेदं चेष्टते विश्‍वं तत्स्वभावानुवर्ति च ।\nसोऽहं कालो जगत कृत्स्नं प्रेरयामि कलात्मकम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005489007, "chapter_id": 25489, "verse_number": "२-६-८", "content_sanskrit": "एकांशेन जगत कृत्स्नं करोमि मुनिपुंगवाः ।\nसंहाराम्येकरुपेण द्विधावस्था ममैव तु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005489008, "chapter_id": 25489, "verse_number": "२-६-९", "content_sanskrit": "आदिमध्यान्तनिर्मुक्तो मायातत्वप्रवर्तकः ।\nक्षोभयामि च सर्गादी प्रधानपुरुषावुभौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005489009, "chapter_id": 25489, "verse_number": "२-६-१०", "content_sanskrit": "ताभ्यां संजायते विश्वं संयुक्तभ्यां परस्परम ।\nमहदादिक्रमेणैव मम तेजो विजृम्भते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005489010, "chapter_id": 25489, "verse_number": "२-६-११", "content_sanskrit": "यो हि सर्वजगत्साक्षी कालचक्रप्रवर्तकः ।\nहिरण्यगर्भो मार्तण्डः सोऽपि मद्देहसम्भवः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005489011, "chapter_id": 25489, "verse_number": "२-६-१२", "content_sanskrit": "तस्मै दिव्य स्वमैश्वर्यं ज्ञानयोगं सनातनम ।\nदत्तवानात्मजान वेदान कल्पादौ चतुरो द्विजाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005489012, "chapter_id": 25489, "verse_number": "२-६-१३", "content_sanskrit": "स मन्नियोगतो देवो ब्रह्मा मद्भावभावितः ।\nदिव्यं तन्मामकैश्वर्य सर्वदा वहति स्वयम ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005489013, "chapter_id": 25489, "verse_number": "२-६-१४", "content_sanskrit": "स सर्वलोकनिर्माता मत्रियोगेन सर्ववित ।\nभूत्वा चतुर्मुखः सर्ग सृजतेवात्मसम्भवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005489014, "chapter_id": 25489, "verse_number": "२-६-१५", "content_sanskrit": "योऽपि नारायणोऽनन्तो लोकानां प्रभवाव्ययः ।\nममैव परमा मूर्तिः करोति परिपालनम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005489015, "chapter_id": 25489, "verse_number": "२-६-१६", "content_sanskrit": "योऽन्तकः सर्वभुतानां रुद्रः कालत्मकः प्रभुः ।\nमदाज्ञयासौ सततं संहरिष्यति मे तनुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005489016, "chapter_id": 25489, "verse_number": "२-६-१७", "content_sanskrit": "हव्यं वहति देवानां कव्यं काव्यशिनामपि ।\nपाकं च कुरुते वह्निः सोऽपि मच्छक्तिचोदितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005489017, "chapter_id": 25489, "verse_number": "२-६-१८", "content_sanskrit": "भ्क्तामाहारजातं च पचते तदहर्निशम ।\nवैश्वानरे‍ग्निर्बह्गवानीश्वरस्य नियोगतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005489018, "chapter_id": 25489, "verse_number": "२-६-१९", "content_sanskrit": "योऽपि सर्वाम्भसां योनिर्वरुणो देवपुंगवः ।\nसोऽपि संजीवयेत कृत्स्नमीशस्यैव नियोगतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005489019, "chapter_id": 25489, "verse_number": "२-६-२०", "content_sanskrit": "योऽन्तास्तिष्ठति भुतानां बहिर्देवः प्रभत्र्जनः ।\nमदज्ञयासौ भुतानां शरीरणि बिभर्ति हि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005489020, "chapter_id": 25489, "verse_number": "२-६-२१", "content_sanskrit": "योऽपि संजीवनो नृणां देवानाममृताकरः ।\nसोमः स मन्नियोगेनं चोदितः किल वर्तते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005489021, "chapter_id": 25489, "verse_number": "२-६-२२", "content_sanskrit": "यः स्वभासा जगत कृत्स्नं प्र्काशयति सर्वदा ।\nसुर्यो वृष्टिं वितनुते शास्त्रेणैव स्वयम्भुवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005489022, "chapter_id": 25489, "verse_number": "२-६-२३", "content_sanskrit": "योऽप्यशेषजगच्छास्ता शक्रः सर्वामरेश्वरः ।\nयज्वनां फलदो देवो वर्ततेऽसौ मदाज्ञया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005489023, "chapter_id": 25489, "verse_number": "२-६-२४", "content_sanskrit": "यः प्रशास्ता ह्रासाधुनां वर्तते सम्प्रदायकः ।\nयमो वैवस्वतो देवो देवदेवनियोगतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005489024, "chapter_id": 25489, "verse_number": "२-६-२५", "content_sanskrit": "योऽपि सर्वधनाध्यक्षो धनानां सम्प्रदायकः ।\nसोऽपीश्वरनियोगेन कुबेरो वर्तते सदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005489025, "chapter_id": 25489, "verse_number": "२-६-२६", "content_sanskrit": "यः सर्वरक्षसां नाथस्तामसानां फलप्रदः ।\nमन्नियोगादसौ देवो वर्तते निऋतिः सदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005489026, "chapter_id": 25489, "verse_number": "२-६-२७", "content_sanskrit": "वेतालगणभुतानां स्वामी भोगफलप्रदः ।\nइशानः किल भक्तानां सोऽपि तिष्ठन्ममाज्ञाया ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005489027, "chapter_id": 25489, "verse_number": "२-६-२८", "content_sanskrit": "यो वामदेवोऽगिरसःशिष्यों रुद्रगणाग्रणीः ।\nरक्षको योगिनां नित्यं वर्ततेऽसौ मदाज्ञया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005489028, "chapter_id": 25489, "verse_number": "२-६-२९", "content_sanskrit": "यश्च सर्वजगत्पुज्यो वर्तते विघ्नकारकः ।\nविनायको धर्मनेता सोऽपि मद्वचनात किल ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005489029, "chapter_id": 25489, "verse_number": "२-६-३०", "content_sanskrit": "योऽपि ब्रह्माविदां श्रेष्ठो देवसेनापतिः प्रभुः ।\nस्कन्दोऽसौ वर्तते नित्यं स्वयम्भूर्विधिचोदितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005489030, "chapter_id": 25489, "verse_number": "२-६-३१", "content_sanskrit": "ये च प्रजानां पतयो मरेच्यद्या महर्षयः ।\nसृजन्ति विविधं लोकं परस्यैव नियोगतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005489031, "chapter_id": 25489, "verse_number": "२-६-३२", "content_sanskrit": "याचश्रीः सर्वभुतानां ददाति विपुलां श्रियम ।\nपत्‍नी नारायणस्यासी वर्तते मदनुग्रहात ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005489032, "chapter_id": 25489, "verse_number": "२-६-३३", "content_sanskrit": "वाचं ददाति विपुलां या च देवी सरस्वती ।\nसापीश्वरनियोगेन चोदित सम्प्रवर्तते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005489033, "chapter_id": 25489, "verse_number": "२-६-३४", "content_sanskrit": "याशेषपुरुषान घ्रान्नरकात तारयिष्यति ।\nसावित्री संस्मृता देवी देवाज्ञानिविधायिनी ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005489034, "chapter_id": 25489, "verse_number": "२-६-३५", "content_sanskrit": "पार्वती परमा देवी ब्रह्माविद्यापरदायिनी ।\nयापि ध्याता विशेषन सापि मद्वचनानुगा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005489035, "chapter_id": 25489, "verse_number": "२-६-३६", "content_sanskrit": "योऽनन्तमहिमानन्तः शेषोऽशेषामरप्रभुः ।\nदधाति शिरसा लोकं सोऽपि देवानियोगतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005489036, "chapter_id": 25489, "verse_number": "२-६-३७", "content_sanskrit": "योऽग्रि सवर्तको नित्यं वडवारुपसंस्थितः ।\nपिबत्यखिलमम्भोधिमीश्वरस्य नियोगतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005489037, "chapter_id": 25489, "verse_number": "२-६-३८", "content_sanskrit": "ये चतुर्दश लोकेऽस्मिन मनवः प्रथितौजसः ध्यायः ।\nपालयन्ति प्रजाः प्सर्वास्तेऽपि तस्य नियोगतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005489038, "chapter_id": 25489, "verse_number": "२-६-३९", "content_sanskrit": "आदित्या वसवो रुद्रा मरुतश्च तथाश्विनौ ।\nअन्याश्च देवताः सर्वा मच्छास्त्रेणैव धिष्ठिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005489039, "chapter_id": 25489, "verse_number": "२-६-४०", "content_sanskrit": "गन्धर्वा गरुड़ा ऋक्षाः सिद्धाः साध्याश्च चारणाः ।\nयक्षरक्षः पिशाचाश्च स्थिता शास्त्रे स्वय्तम्भुव ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005489040, "chapter_id": 25489, "verse_number": "२-६-४१", "content_sanskrit": "कलाकाष्ठानिमेषाश्च मुहुर्ता दिवसाः क्षपाः ।\nऋतवः पक्षमासाश्च स्थिताः शास्त्रे प्रजापते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005489041, "chapter_id": 25489, "verse_number": "२-६-४२", "content_sanskrit": "युगामन्वन्तराण्येव मम तिष्ठन्ति शासने ।\nपराश्चैव परार्धाश्च कालभेदास्तथा परे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005489042, "chapter_id": 25489, "verse_number": "२-६-४३", "content_sanskrit": "चतुर्विधानि भुतानि स्थावराणि चराणि च ।\nनियोगादेव वर्तान्ते देवस्य परमात्मनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005489043, "chapter_id": 25489, "verse_number": "२-६-४४", "content_sanskrit": "पातालानि च सर्वाणि भुवननि च शासनात ।\nब्रह्माण्डानि च वर्तन्ते सर्वाण्येव स्वयम्भुवः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005489044, "chapter_id": 25489, "verse_number": "२-६-४५", "content_sanskrit": "अतीतान्यप्यसंख्यांनि ब्रह्माण्डनि ममाज्ञयाः ।\nप्रवृत्तनि पदार्थोघैः सहितानि समन्ततः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005489045, "chapter_id": 25489, "verse_number": "२-६-४६", "content_sanskrit": "ब्रह्माण्डानि भविष्यन्ति सह वस्तुभिरात्मगैः ।\nवहिष्यन्ति सदिवौज्ञं परस्य परमाम्तानः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005489046, "chapter_id": 25489, "verse_number": "२-६-४७", "content_sanskrit": "भूमिरापोऽनलो वायुः खं मनो बुद्धिरेव च ।\nभूतादिरादिपकृतिर्नियोगे मम वर्तते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005489047, "chapter_id": 25489, "verse_number": "२-६-४८", "content_sanskrit": "याशेषजगातां योनिर्मोहिनी सर्वदेहिनाम ।\nमाया विवर्तते नित्यं सामीश्वरनियोगतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005489048, "chapter_id": 25489, "verse_number": "२-६-४९", "content_sanskrit": "यो वै देहभृतां देवः पुरुषः पठ्यते परः ।\nआत्मासौ वर्तते नित्यामेश्वरस्य नियोगतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005489049, "chapter_id": 25489, "verse_number": "२-६-५०", "content_sanskrit": "विधुय मोहकलिलं यया पश्यति तत पदम ।\nसापि विद्या महेशस्य नियोगवशवर्तिनी ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005489050, "chapter_id": 25489, "verse_number": "२-६-५१", "content_sanskrit": "बहुनात्र किमुक्तेन मम शक्त्यात्मकं जगत ।\nमयैव प्रेर्यते कृत्स्नं मय्येव प्रलयं व्रजेत ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005489051, "chapter_id": 25489, "verse_number": "२-६-५२", "content_sanskrit": "अहं हि भगवानीशः स्वयं ज्योतिःसनातनः ।\nपरमात्मा परं ब्रह्मा मत्तो ह्यान्यत्र विद्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005489052, "chapter_id": 25489, "verse_number": "२-६-५३", "content_sanskrit": "इत्येतत परमं ज्ञानं युष्माकं कथितं मया ।\nज्ञात्वां विमुच्यते जन्तुर्जन्मसंसरबन्धनात ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]