[{"id": 7005958000, "chapter_id": 25958, "verse_number": "१-१४१-१", "content_sanskrit": "हरिरुवाच । शतानीको ह्यश्वमेधदत्तश्चाप्यधिसोमकः ।\nकृष्णोऽनिरुद्धश्चाप्युष्णस्ततश्चित्ररथो नृपः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005958001, "chapter_id": 25958, "verse_number": "१-१४१-२", "content_sanskrit": "शुचिद्रथो वृष्णिमांश्च सुपेणश्च सुनीथकः ।\nनृचक्षुश्च मुखाबाणः मेधावी च नृपञ्जयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005958002, "chapter_id": 25958, "verse_number": "१-१४१-३", "content_sanskrit": "पारिप्लवश्च मुनयो मेधावी च नृपञ्जयः। ।\nबृहद्रथो हरिस्तिग्मो शतानीकः सुदानकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005958003, "chapter_id": 25958, "verse_number": "१-१४१-४", "content_sanskrit": "उदानोऽह्निनरश्चैव दण्डपाणिर्निमित्तकः ।\nक्षेमकश्च ततः शूद्रः पिता पूर्वस्ततः सुतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005958004, "chapter_id": 25958, "verse_number": "१-१४१-५", "content_sanskrit": "बृहद्बलास्तु कथयन्ते नृपोश्चैक्ष्वाकुवंशजा ।\nबृहद्बलादुरुक्षयो वत्सव्यूहस्ततः परः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005958005, "chapter_id": 25958, "verse_number": "१-१४१-६", "content_sanskrit": "वत्सव्यूहात्ततः सूर्यः सहदेवस्तदात्मजः ।\nबृहदश्वो भानुरथः प्रतीच्यश्च प्रतीतकः ।\nमनुदेवः सुनक्षत्रः किन्नरश्चान्तरिक्षकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005958006, "chapter_id": 25958, "verse_number": "१-१४१-७", "content_sanskrit": "सुपर्णः कृतजिच्चैव बृहद्भ्राजश्च धार्मिकः। ।\nकृतञ्जयो धनञ्जयः संजयः शाक्य एव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005958007, "chapter_id": 25958, "verse_number": "१-१४१-८", "content_sanskrit": "शुद्धोदनो बाहुलश्च सेनजित्क्षुद्रकस्तथा। ।\nसुमित्रः कुडवश्चातः सुमित्रान्मागधाञ्छणु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005958008, "chapter_id": 25958, "verse_number": "१-१४१-९", "content_sanskrit": "जरासन्धः सहदेवः सोमापिश्च श्रुतश्रवाः ।\nअयुतायुर्निरमित्रः सुक्षत्रो बहुकर्मकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005958009, "chapter_id": 25958, "verse_number": "१-१४१-१०", "content_sanskrit": "श्रुतञ्जयः सेनजिच्च भूरिश्चैव शुचिस्तथा ।\nक्षेम्यश्च सुव्रतो धर्मः श्मश्रुलो दृढसेनकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005958010, "chapter_id": 25958, "verse_number": "१-१४१-११", "content_sanskrit": "सुमतिः सुबलो नीतो सत्यजिद्विश्वजित्तथा ।\nइषुञ्जयश्च इत्येते नृपा बार्हद्रथाः स्मृताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005958011, "chapter_id": 25958, "verse_number": "१-१४१-१२", "content_sanskrit": "अधर्मिष्ठाश्च शूद्राश्च भविष्यन्ति नृपास्तत। ।\nस्वर्गादिकृद्धि भगवान्साक्षान्नारायणोऽव्ययः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005958012, "chapter_id": 25958, "verse_number": "१-१४१-१३", "content_sanskrit": "नैमित्तिकः प्राकृतिकस्तथैवात्यन्तिको लयः ।\nयाति भूः प्रलयं चाप्सु ह्यापस्तेजसि पावकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005958013, "chapter_id": 25958, "verse_number": "१-१४१-१४", "content_sanskrit": "वायौ वायुश्च वियति त्वाकाशौ यात्यहङ्कृतौ ।\nअहं बुद्धौ मतिर्जोवे जीवोऽव्यक्ते तदात्मनि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005958014, "chapter_id": 25958, "verse_number": "१-१४१-१५", "content_sanskrit": "आत्मा परेश्वरो विष्णुरेको नारायणो नरः ।\nअविनाश्यपरं सर्वं जगत्स्वर्गादि नाशि हि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005958015, "chapter_id": 25958, "verse_number": "१-१४१-१६", "content_sanskrit": "नृपादयो गता नाशमतः पापं विवर्जयेत् ।\nधर्मं कुर्यात्स्थिरं येन पापं हित्वा हरिं व्रजेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]