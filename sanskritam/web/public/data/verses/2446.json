[{"id": 2069021, "chapter_id": 2446, "verse_number": "९-६४-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069022, "chapter_id": 2446, "verse_number": "९-६४-१", "content_sanskrit": "किमर्थं द्विजशार्दूल धर्मराजो युधिष्ठिरः।\nगान्धार्याः प्रेषयामास वासुदेवं परन्तपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069023, "chapter_id": 2446, "verse_number": "९-६४-२", "content_sanskrit": "यदा पूर्वं गतः कृष्णः शमार्थं कौरवान्प्रति।\nन च तं लब्धवान्कामं ततो युद्धमभूदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069024, "chapter_id": 2446, "verse_number": "९-६४-३", "content_sanskrit": "निहतेषु तु योधेषु हते दुर्योधने तदा।\nपृथिव्यां पाण्डवेयस्य निःसपत्ने कृते युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069025, "chapter_id": 2446, "verse_number": "९-६४-४", "content_sanskrit": "विद्रुते शिबिरे शून्ये प्राप्ते यशसि चोत्तमे।\nकिं तु तत्कारणं ब्रह्मन्येन कृष्णो गतः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069026, "chapter_id": 2446, "verse_number": "९-६४-५", "content_sanskrit": "न चैतत्कारणं ब्रह्मन्नल्पं विप्रतिभाति मे।\nयत्रागमदमेयात्मा स्वयमेव जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069027, "chapter_id": 2446, "verse_number": "९-६४-६", "content_sanskrit": "तत्त्वतो वै समाचक्ष्व सर्वमध्वर्युसत्तम।\nयच्चात्र कारणं ब्रह्मन्कार्यस्यास्य विनिश्चये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069028, "chapter_id": 2446, "verse_number": "९-६४-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069029, "chapter_id": 2446, "verse_number": "९-६४-७", "content_sanskrit": "त्वद्युक्तोऽयमनुप्रश्नो यन्मां पृच्छसि पार्थिव।\nतत्तेऽहं संप्रवक्ष्यामि यथावद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069030, "chapter_id": 2446, "verse_number": "९-६४-८", "content_sanskrit": "हतं दुर्योधनं दृष्ट्वा भीमसेनेन संयुगे।\nव्युत्क्रम्य समयं राजन्धार्तराष्ट्रं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069031, "chapter_id": 2446, "verse_number": "९-६४-९", "content_sanskrit": "अन्यायेन हतं दृष्ट्वा गदायुद्धेन भारत।\nयुधिष्ठिरं महाराज महद्भयमथाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069032, "chapter_id": 2446, "verse_number": "९-६४-१०", "content_sanskrit": "सोऽचिन्तयन्महाभागां गान्धारीं तपसान्विताम्।\nघोरेण तपसा युक्तां त्रैलोक्यमपि सा दहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069033, "chapter_id": 2446, "verse_number": "९-६४-११", "content_sanskrit": "तस्य चिन्तयमानस्य बुद्धिः समभवत्तदा।\nगान्धार्याः क्रोधदीप्तायाः पूर्वं प्रशमनं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069034, "chapter_id": 2446, "verse_number": "९-६४-१२", "content_sanskrit": "सा हि पुत्रवधं श्रुत्वा कृतमस्माभिरीदृशम्।\nमानसेनाग्निना क्रुद्धा भस्मसान्नः करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069035, "chapter_id": 2446, "verse_number": "९-६४-१३", "content_sanskrit": "कथं दुःखमिदं तीव्रं गान्धारी सम्प्रशक्ष्यति।\nश्रुत्वा विनिहतं पुत्रं छलेनाजिह्मयोधिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069036, "chapter_id": 2446, "verse_number": "९-६४-१४", "content_sanskrit": "एवं विचिन्त्य बहुधा भयशोकसमन्वितः।\nवासुदेवमिदं वाक्यं धर्मराजोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069037, "chapter_id": 2446, "verse_number": "९-६४-१५", "content_sanskrit": "तव प्रसादाद्गोविन्द राज्यं निहतकण्टकम्।\nअप्राप्यं मनसाऽपीदं प्राप्तमस्माभिरच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069038, "chapter_id": 2446, "verse_number": "९-६४-१६", "content_sanskrit": "प्रत्यक्षं मे महाबाहो सङ्ग्रामे रोमहर्षणे।\nविमर्दः सुमहान्प्राप्तस्त्वया यादवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069039, "chapter_id": 2446, "verse_number": "९-६४-१७", "content_sanskrit": "त्वया देवासुरे युद्धे वधार्थममरद्विषाम्।\nयथा साह्यं पुरा दत्तं हताश्च विबुधद्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069040, "chapter_id": 2446, "verse_number": "९-६४-१८", "content_sanskrit": "साह्यं तथा महाबाहो दत्तमस्माकमच्युत।\nसारथ्येन च वार्ष्णेय भवता हि धृता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069041, "chapter_id": 2446, "verse_number": "९-६४-१९", "content_sanskrit": "यदि न त्वं भवेन्नाथः फल्गुनस्य महारणे।\nकथं शक्यो रणे जेतुं भवेदेष बलार्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069042, "chapter_id": 2446, "verse_number": "९-६४-२०", "content_sanskrit": "गदाप्रहारा विपुलाः परिघैश्चापि ताडनम्।\nशक्तिभिर्भिण्डिपालैश्च तोमरैः सपरश्वथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069043, "chapter_id": 2446, "verse_number": "९-६४-२१", "content_sanskrit": "अस्मत्कृते त्वया कृष्ण वाचः सुपरुषाः श्रुताः।\nशस्त्राणां च निपाता वै वज्रस्पर्शोपमा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069044, "chapter_id": 2446, "verse_number": "९-६४-२२", "content_sanskrit": "ते च ते सफला जाता हते दुर्योधनेऽच्युत।\nतत्सर्वं न यथा नश्येत्पुनः कृष्ण तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069045, "chapter_id": 2446, "verse_number": "९-६४-२३", "content_sanskrit": "सन्देहडोलां प्राप्तं नश्चेतः कृष्ण जये सति।\nगान्धार्या हि महाबाहो क्रोधं शमय माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069046, "chapter_id": 2446, "verse_number": "९-६४-२४", "content_sanskrit": "सा हि नित्यं महाभागा तपसोग्रेण कर्शिता।\nपुत्रपौत्रवधं श्रुत्वा ध्रुवं नः सम्प्रधक्ष्यति।\nतस्या प्रसादनं वीर प्राप्तकालं मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069047, "chapter_id": 2446, "verse_number": "९-६४-२५", "content_sanskrit": "कश्च तां क्रोधसन्दीप्तां पुत्रव्यसनकर्शिताम्।\nवीक्षितुं पुरुषः शक्तस्त्वामृते पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069048, "chapter_id": 2446, "verse_number": "९-६४-२६", "content_sanskrit": "तत्र मे गमनं प्राप्तं रोचते तव माधव।\nगान्धार्याः क्रोधदीप्तायाः प्रशमार्थमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069049, "chapter_id": 2446, "verse_number": "९-६४-२७", "content_sanskrit": "त्वं हि कर्ता विकर्ता च लोकानां प्रभवाव्ययः।\nहेतुकारणसंयुक्तैर्वाक्यैः कालसमीरितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069050, "chapter_id": 2446, "verse_number": "९-६४-२८", "content_sanskrit": "क्षिप्रमेव महाबाहो गान्धारीं शमयिष्यसि।\nपितामहश्च भगवान्कृष्णस्तत्र भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069051, "chapter_id": 2446, "verse_number": "९-६४-२९", "content_sanskrit": "सर्वथा ते महाबाहो गान्धार्याः क्रोधनाशनम्।\nकर्तव्यं सात्वतां श्रेष्ठ पाण्डवानां हितार्थिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069052, "chapter_id": 2446, "verse_number": "९-६४-३०", "content_sanskrit": "धर्मराजस्य वचनं श्रुत्वा यदुकुलोद्वहः।\nआमन्त्र्य दारुकं प्राह रथः सञ्जो विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069053, "chapter_id": 2446, "verse_number": "९-६४-३१", "content_sanskrit": "केशवस्य वचः श्रुत्वा त्वरमाणोऽथ दारुकः।\nन्यवेदयद्रथं सज्जं केशवाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069054, "chapter_id": 2446, "verse_number": "९-६४-३२", "content_sanskrit": "तं रथं यादवश्रेष्ठः समारुह्य परन्तपः।\nजगाम हास्तिनपुरं त्वरितः केशवो विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069055, "chapter_id": 2446, "verse_number": "९-६४-३३", "content_sanskrit": "ततः प्रायान्महाराज माधवो भगवान्रथी।\nनागसाह्वयमासाद्य प्रविवेश च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069056, "chapter_id": 2446, "verse_number": "९-६४-३४", "content_sanskrit": "प्रविश्य नगरं वीरो रथघोषेण नादयन्।\nविदितो धृतराष्ट्रस्य सोऽवतीर्य रथोत्तमात्।\nअभ्यगच्छददीनात्मा धृतराष्ट्रनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069057, "chapter_id": 2446, "verse_number": "९-६४-३५", "content_sanskrit": "पूर्वं चाभिगतं तत्र सोऽपश्यदृषिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069058, "chapter_id": 2446, "verse_number": "९-६४-३६", "content_sanskrit": "पादौ प्रपीड्य कृष्णस्य राज्ञश्चापि जनार्दनः।\nअभ्यवादयदव्यग्रो गान्धारीं चापि केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2069059, "chapter_id": 2446, "verse_number": "९-६४-३७", "content_sanskrit": "ततस्तु यादवश्रेष्ठो धृतराष्ट्रमधोक्षजः।\nपाणिमालम्ब्य राजेन्द्र सुस्वरं प्ररुरोद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069060, "chapter_id": 2446, "verse_number": "९-६४-३८", "content_sanskrit": "स मुहूर्तादिवोत्सृज्य बाष्पं शोकसमुद्भवम्।\nप्रक्षाल्य वारिणा नेत्रे ह्याचम्य च यथाविधि।\nउवाच प्रश्रितं वाक्यं धृतराष्ट्रमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069061, "chapter_id": 2446, "verse_number": "९-६४-३९", "content_sanskrit": "न तेऽस्त्यविदितं किञ्चिद्भूतं भव्यं च भारत।\nकालस्य च यथावृत्तं तत्ते सुविदितं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069062, "chapter_id": 2446, "verse_number": "९-६४-४०", "content_sanskrit": "यदिदं पाण्डवैः सर्वैस्तव चित्तानुरोधिभिः।\nकथं कुलक्षयो न स्यात्तथा क्षत्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069063, "chapter_id": 2446, "verse_number": "९-६४-४१", "content_sanskrit": "भ्रातृभिः समयं कृत्वा क्षान्तवान्धर्मवत्सलः।\nद्यूतच्छलजितैः शुद्वैर्वनवासो ह्युपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2069064, "chapter_id": 2446, "verse_number": "९-६४-४२", "content_sanskrit": "अज्ञातवासचर्या च नानावेषसमावृतैः।\nअन्ये च बहवः क्लेशास्त्वशक्तैरिव सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2069065, "chapter_id": 2446, "verse_number": "९-६४-४३", "content_sanskrit": "मया च स्वयमागम्य युद्धकाल उपस्थिते।\nसर्वलोकस्य सान्निध्येग्रामांस्त्वं पञ्चयाचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2069066, "chapter_id": 2446, "verse_number": "९-६४-४४", "content_sanskrit": "त्वया कालोपसृष्टेन लोभतो नापवर्जिताः।\nतवापराधान्नृपते सर्वं क्षत्रं क्षयं गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2069067, "chapter_id": 2446, "verse_number": "९-६४-४५", "content_sanskrit": "भीष्मेण सोमदत्तेन बाह्लीकेन कृपेण च।\nद्रोणेन च सपुत्रेण विदुरेण च धीमता।\nयाचितस्त्वं शमं नित्यं न च तत्कृतवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2069068, "chapter_id": 2446, "verse_number": "९-६४-४६", "content_sanskrit": "कालोपहतचित्ता हि सर्वे मुह्यन्ति भारत।\nयथा मूढो भवान्पूर्वमस्मिन्नर्थे समुद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2069069, "chapter_id": 2446, "verse_number": "९-६४-४७", "content_sanskrit": "किमन्यत्कालयोगाद्धि द्विष्टमेव परायणम्।\nमा च दोषान्महाप्राज्ञ पाण्डवेषु निवेशय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2069070, "chapter_id": 2446, "verse_number": "९-६४-४८", "content_sanskrit": "अल्पोप्यतिक्रमो नास्ति पाण्डवानां महात्मनाम्।\nधर्मतो न्यायतश्चैव स्नेहतश्च परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2069071, "chapter_id": 2446, "verse_number": "९-६४-४९", "content_sanskrit": "एतत्सर्वं तु विज्ञाय ह्यात्मदोषकृतं फलम्।\nतन्मन्युं पाण्डुपुत्रेषु न भवान्कर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2069072, "chapter_id": 2446, "verse_number": "९-६४-५०", "content_sanskrit": "कुलं वंशश्च पिण्डाश्च यच्च पुत्रकृत फलम्।\nगान्धार्यास्तव वै नाथ पाण्डवेषु प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2069073, "chapter_id": 2446, "verse_number": "९-६४-५१", "content_sanskrit": "त्वं चैव कुरुशार्दूल गान्धारी च यशस्विनी।\nमा शुचो नरशार्दूल पाण्डवान्प्रतिकिल्बिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2069074, "chapter_id": 2446, "verse_number": "९-६४-५२", "content_sanskrit": "एतत्सर्वमनुध्याय आत्मनश्च व्यतिक्रमम्।\nशिवेन पाण्डवान्ध्याहि नमस्ते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2069075, "chapter_id": 2446, "verse_number": "९-६४-५३", "content_sanskrit": "जानासि च महाबाहो धर्मराजस्य या त्वयि।\nभक्तिर्भरतशार्दूल स्नेहश्चापि स्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2069076, "chapter_id": 2446, "verse_number": "९-६४-५४", "content_sanskrit": "एतच्च कदनं कृत्वा शत्रूणामपकारिणाम्।\nदह्यते स दिवारात्रौ न च शर्माधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2069077, "chapter_id": 2446, "verse_number": "९-६४-५५", "content_sanskrit": "त्वां चैव नरशार्दूल गान्धारीं च यशस्विनीम्।\nस शोचन्नरशार्दूलः शान्तिं नैवाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2069078, "chapter_id": 2446, "verse_number": "९-६४-५६", "content_sanskrit": "हिया च परयाऽविष्टो भवन्तं नाधिगच्छति।\nपुत्रशोकाभिसन्तप्तं बुद्धिव्याकुलितेन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2069079, "chapter_id": 2446, "verse_number": "९-६४-५७", "content_sanskrit": "एवमुक्त्वा महाराज धृतराष्ट्रं यदूत्तमः।\nउवाच परमं वाक्यं गान्धारीं शोककर्शिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2069080, "chapter_id": 2446, "verse_number": "९-६४-५८", "content_sanskrit": "सौबलेयि निबोध त्वं यत्त्वां वक्ष्यामि सुव्रते।\nत्वत्समा नास्ति लोकेऽस्मिन्नद्य सीमन्तिनी शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2069081, "chapter_id": 2446, "verse_number": "९-६४-५९", "content_sanskrit": "जानासि च यथा राज्ञि सभायां मम सन्निधौ।\nधर्मार्थसहितं वाक्यमुभयोः पक्षयोर्हितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2069082, "chapter_id": 2446, "verse_number": "९-६४-६०", "content_sanskrit": "उक्तवत्यसि कल्याणि न च ते तनयैः कृतम्।\nदुर्योधनस्त्वया चोक्तो जयार्थी परुषं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2069083, "chapter_id": 2446, "verse_number": "६-६४-६१", "content_sanskrit": "शृणु मूढ वचो मह्यं यतो धर्मस्ततो जयः।\nतदिदं समनुप्राप्तं तव वाक्यं नृपात्मजे॥ a", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2069084, "chapter_id": 2446, "verse_number": "९-६४-६२", "content_sanskrit": "एवं विदित्वा कल्याणि मा स्म शोके मनः कृथाः।\nपाण्डवानां विनाशाय मा ते बुद्धिः कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2069085, "chapter_id": 2446, "verse_number": "९-६४-६३", "content_sanskrit": "शक्ता चासि महाभागे पृथिवीं सचराचराम्।\nचक्षुषा क्रोधदीप्तेन निर्दग्धुं तपसो बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2069086, "chapter_id": 2446, "verse_number": "९-६४-६४", "content_sanskrit": "वासुदेववचः श्रुत्वा गान्धारी वाक्यमब्रवीत्।\nएवमेतन्महाबाहो यथा वदसि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2069087, "chapter_id": 2446, "verse_number": "९-६४-६५", "content_sanskrit": "आधिभिर्दह्यमानाया मतिः सञ्चलिता मम।\nसा मे व्यवस्थिता श्रुत्वा तव वाक्यं जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2069088, "chapter_id": 2446, "verse_number": "९-६४-६६", "content_sanskrit": "राज्ञस्त्वन्धस्य वृद्धस्य हतपुत्रस्य केशव।\nत्वं गतिः सहितैर्वीरैः पाण्डवैर्दिपदा वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2069089, "chapter_id": 2446, "verse_number": "९-६४-६७", "content_sanskrit": "एतावदुक्त्वा वचनं मुखं प्रच्छाद्य वाससा।\nपुत्रशोकाभिसन्तप्ता गान्धारी प्ररुरोद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2069090, "chapter_id": 2446, "verse_number": "९-६४-६८", "content_sanskrit": "तत एनां महाबाहुः केश्वः शोककर्शिताम्।\nहेतुकारणसंयुक्तैर्वाक्यैराश्वासयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2069091, "chapter_id": 2446, "verse_number": "९-६४-६९", "content_sanskrit": "समाश्वास्य च गान्धारीं धृतराष्ट्रं च माधवः।\nद्रौणिसङ्कल्पितं भावमन्वबुध्यत केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2069092, "chapter_id": 2446, "verse_number": "९-६४-७०", "content_sanskrit": "ततस्त्वरित उत्थाय पादौ मूर्ध्ना प्रणम्य च।\nद्वैपायनस्य राजेन्द्र ततः कौरवमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2069093, "chapter_id": 2446, "verse_number": "९-६४-७१", "content_sanskrit": "आपृच्छे त्वां कुरुश्रेष्ठ मा च शोके मनः कृथाः।\nद्रौणेः पापोस्त्यभिप्रायस्तेनास्मि सहसोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2069094, "chapter_id": 2446, "verse_number": "९-६४-७२", "content_sanskrit": "पाण्डवानां वधे रात्रौ बुद्धिस्तेन प्रदर्शिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2069095, "chapter_id": 2446, "verse_number": "९-६४-७३", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं गान्धार्या सहितोऽब्रवीत्।\nधृतराष्ट्रो महाबाहुः केशवं केशिसूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2069096, "chapter_id": 2446, "verse_number": "९-६४-७४", "content_sanskrit": "शीघ्रं गच्छ महाबाहो पाण्डवान्परिपालय।\nभूयस्त्वया समेष्यामि क्षिप्रमेव जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2069097, "chapter_id": 2446, "verse_number": "९-६४-७५", "content_sanskrit": "प्रायात्ततस्तु त्वरितो दारुकेण सहाच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2069098, "chapter_id": 2446, "verse_number": "९-६४-७६", "content_sanskrit": "वासुदेवे गते राजन्धृतराष्ट्रं जनेश्वरम्।\nआश्वासयदमेयात्मा व्यासो लोकनमस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2069099, "chapter_id": 2446, "verse_number": "९-६४-७७", "content_sanskrit": "वासुदेवोऽपि धर्मात्मा कृतकृत्यो जगाम ह।\nशिबिरं हास्तिनपुराद्दिदृक्षुः पाण्डवान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2069100, "chapter_id": 2446, "verse_number": "९-६४-७८", "content_sanskrit": "आगम्य शिबिरं रात्रौ सोऽभ्यगच्छत पाण्डवान्।\nतच्च तेभ्यः समाख्याय सहितस्तैः समाहितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2069101, "chapter_id": 2446, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि गदायुद्धपर्वणि चतुःषष्टितमोऽध्यायः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]