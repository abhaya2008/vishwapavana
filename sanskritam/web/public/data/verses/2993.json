[{"id": 2093370, "chapter_id": 2993, "verse_number": "१३-१२३-१", "content_sanskrit": "`भीष्म उवाच।\nता गावो रन्तिदेवस्य गत्वा यज्ञं मनीषिणः।\nआत्मानं ज्ञापयामासुर्महर्षीणां समक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093371, "chapter_id": 2993, "verse_number": "१३-१२३-२", "content_sanskrit": "रन्तिदेवस्ततो राजा प्रयतः प्राञ्जलिः शुचिः।\nउवाच गावः प्रणतः किमागमनमित्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093372, "chapter_id": 2993, "verse_number": "१३-१२३-३x", "content_sanskrit": "गाव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093373, "chapter_id": 2993, "verse_number": "१३-१२३-३", "content_sanskrit": "इच्चामस्तव राजेन्द्र सत्रेऽस्मिन्विनियोजनम्।\nपशुत्वमुपसम्प्राप्तुं प्रसादं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093374, "chapter_id": 2993, "verse_number": "१३-१२३-४x", "content_sanskrit": "रन्तिदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093375, "chapter_id": 2993, "verse_number": "१३-१२३-४", "content_sanskrit": "नास्ति शक्तो गवां घातं कर्तुं शतसहस्रशः।\nघातयित्वा त्वहं युष्मान्कथमात्मानमुत्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093376, "chapter_id": 2993, "verse_number": "१३-१२३-५", "content_sanskrit": "यः पशुत्वेन संयोज्य युष्मान्स्वर्गं नयेदिह।\nआत्मानं चैव तपसा गावः समुपगम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093377, "chapter_id": 2993, "verse_number": "१३-१२३-६x", "content_sanskrit": "गाव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093378, "chapter_id": 2993, "verse_number": "१३-१२३-६", "content_sanskrit": "अस्माकं तारणे युक्तो धर्मात्मा तपसि स्थितः।\nश्रुतोऽस्माभिर्भवान्राजंस्ततस्तु स्वयमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093379, "chapter_id": 2993, "verse_number": "१३-१२३-७x", "content_sanskrit": "रन्तिदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093380, "chapter_id": 2993, "verse_number": "१३-१२३-७", "content_sanskrit": "मम सत्रे पशुत्वं वो यद्येवं हि मनीषितम्।\nसमयेनाहमेतेन जुहुयां वो हुताशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093381, "chapter_id": 2993, "verse_number": "१३-१२३-८", "content_sanskrit": "कदाचिद्यदि वः काचिदकामा विनियुज्यते।\nतदा समाप्तिः सत्रस्य गवां स्यादिति नैष्ठिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093382, "chapter_id": 2993, "verse_number": "१३-१२३-९x", "content_sanskrit": "गाव ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093383, "chapter_id": 2993, "verse_number": "१३-१२३-९", "content_sanskrit": "एवमस्तु महाराज यथा त्वं प्रब्रवीषि नः।\nअकामाः स्युर्यदा गावस्तदा सत्रं समाप्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093384, "chapter_id": 2993, "verse_number": "१३-१२३-१०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093385, "chapter_id": 2993, "verse_number": "१३-१२३-१०", "content_sanskrit": "ततः प्रवृत्ते गोसत्रे रन्तिदेवस्य धीमतः।\nगोसहस्राण्यहरहर्नियुज्यन्ते शमीतृभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093386, "chapter_id": 2993, "verse_number": "१३-१२३-११", "content_sanskrit": "एवं बहनि वर्षाणि व्यतीतानि नराधिप।\nगवां वै वध्यमानानां न चान्तः प्रत्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093387, "chapter_id": 2993, "verse_number": "१३-१२३-१२", "content_sanskrit": "गवां चर्मसहस्रैस्तु राशयः पर्वतोपमाः।\nबभूवुः कुरुशार्दूल बहुधा मेघसंनिभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093388, "chapter_id": 2993, "verse_number": "१३-१२३-१३", "content_sanskrit": "मेदःक्लेदवहा चैव प्रावर्तत महानदी।\nअद्यापि भुवि विख्याता नदी चर्मण्वती शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093389, "chapter_id": 2993, "verse_number": "१३-१२३-१४", "content_sanskrit": "ततः कदाचित्स्वं वत्सं गौरुपामन्त्र्य दुःखिता।\nएहि वत्स स्तनं पाहि मा त्वं पश्चात्क्षुदार्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093390, "chapter_id": 2993, "verse_number": "१३-१२३-१५", "content_sanskrit": "तप्स्यसे विमना दुःखं घातितायां मयि ध्रुवम्।\nएते ह्यायान्ति चण्डालाः सशस्त्रामां जिघांसवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093391, "chapter_id": 2993, "verse_number": "१३-१२३-१६", "content_sanskrit": "अथ शुश्राव तां वाणीं मानुषीं समुदाहृताम्।\nरन्तिदेवो महाराज ततस्तां समवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093392, "chapter_id": 2993, "verse_number": "१३-१२३-१७", "content_sanskrit": "स्थापयामास गोसत्रमथ तं पार्तिवर्षभ।\nसत्रोत्सृष्टाः परित्यक्ता गावोऽन्याः समुपाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093393, "chapter_id": 2993, "verse_number": "१३-१२३-१८", "content_sanskrit": "यास्तस्य राज्ञो निहता गावो यज्ञे महात्मनः।\nता गोलोकमुपाजग्मुः प्रेक्षिता ब्रह्मवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093394, "chapter_id": 2993, "verse_number": "१३-१२३-१९", "content_sanskrit": "रन्तिदेवोपि राजर्षिरिष्ट्वा यज्ञं यथाविधि।\nततः सख्यं सुरपतेस्त्रिदिवं चाक्षयं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093395, "chapter_id": 2993, "verse_number": "१३-१२३-२०", "content_sanskrit": "फेनपो दिवि गोलोके मुमुदे शाश्वतीः समाः।\nअवशिष्टश्च या गवस्ता बभूवुर्वनेचराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093396, "chapter_id": 2993, "verse_number": "१३-१२३-२१", "content_sanskrit": "फेनपाख्यानमेतत्ते गवां माहात्म्यमेव च।\nकथितं पावनं पुण्यं कृष्णद्वैपायनेरितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093397, "chapter_id": 2993, "verse_number": "१३-१२३-२२", "content_sanskrit": "नारायणोऽपि भगवान्दृष्ट्वा गोषु परं यशः।\nशुश्रूषां परमां चक्रे भक्तिं च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093398, "chapter_id": 2993, "verse_number": "१३-१२३-२३", "content_sanskrit": "तस्मात्त्वमपि राजेन्द्र गा वै पूजय भारत।\nद्विजेभ्यश्चैव सततं प्रयच्छ कुरुसत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093399, "chapter_id": 2993, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रयोविंशत्यधिकशततमोऽध्यायः॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]