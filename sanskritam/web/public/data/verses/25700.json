[{"id": 7005700000, "chapter_id": 25700, "verse_number": "१७३-१", "content_sanskrit": "दैत्यसैन्यविस्तारवर्णनम् ।\nमत्स्य उवाच ।\nततो भयं विष्णुवचः श्रुत्वा दैत्याश्च दानवाः ।\nउद्योग विपुलं चक्रुर्युद्धाय विजयाय च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005700001, "chapter_id": 25700, "verse_number": "१७३-२", "content_sanskrit": "मयस्तु काञ्चनमयं त्रिनल्वायतमक्षयम् ।\nचतुश्चक्रं सुविपुलं सुकल्पित महायुगम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005700002, "chapter_id": 25700, "verse_number": "१७३-३", "content_sanskrit": "किङ्किणीजालनिर्घोषं द्वीपिचर्मपरिष्कृतम् ।\nरुचिरं रत्नजालैश्च हेमजालैश्च शोभितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005700003, "chapter_id": 25700, "verse_number": "१७३-४", "content_sanskrit": "ईहामृगगणाकीर्णं पक्षिपङ्क्ति विराजितम् ।\nदिव्यास्त्रतूणीरधरं पयोधर विनादितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005700004, "chapter_id": 25700, "verse_number": "१७३-५", "content_sanskrit": "स्वक्षं रथवरोदारं सूपस्थं गगनोपमम् ।\nगदापरिघसम्पूर्णं मूर्तिमन्तमिवार्णवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005700005, "chapter_id": 25700, "verse_number": "१७३-६", "content_sanskrit": "हेमकेयूरवलयं स्वर्णमण्डल कूवरम् ।\nसपताक ध्वजोपेतं सादित्यमिव मन्दरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005700006, "chapter_id": 25700, "verse_number": "१७३-७", "content_sanskrit": "गजेन्द्रा भोगवपुषं क्वचित् केसरि वर्चसम् ।\nयुक्तमृक्षसहस्रेण समृद्धाम्बुद नादितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005700007, "chapter_id": 25700, "verse_number": "१७३-८", "content_sanskrit": "दीप्तमाकाशगं दिव्यं रथं पररथारुजम् ।\nअध्यतिष्ठद्रणाकाङ्क्षी मेरुं दीप्तमिवांशुमान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005700008, "chapter_id": 25700, "verse_number": "१७३-९", "content_sanskrit": "तारमुत्क्रोशविस्तारं सर्वं हेममयं रथम् ।\nशैलाकारमसम्बाधं नीलाञ्जन च योपमम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005700009, "chapter_id": 25700, "verse_number": "१७३-१०", "content_sanskrit": "कार्ष्णायसमयं दिव्यं लोहेषा बद्ध कूबरम् ।\nतिमिरोद्गारि किरणं गर्जन्तमिव तोयदम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005700010, "chapter_id": 25700, "verse_number": "१७३-११", "content_sanskrit": "लोहजालेन महता सगवाक्षेण दंशितम् ।\nआयसैः परिधैः पूर्णं क्षेपणीयैश्च मुद्गरैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005700011, "chapter_id": 25700, "verse_number": "१७३-१२", "content_sanskrit": "प्रासैः पाशैश्च विततैर्नर संयुक्त कण्टकैः ।\nशोभितं त्रासयानैश्च तोमरैश्च परश्वधैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005700012, "chapter_id": 25700, "verse_number": "१७३-१३", "content_sanskrit": "उद्यन्तं द्विषतां हेतोर्द्वितीयमिव मन्दरम् ।\nयुक्तं खरसहस्रेण सोऽध्यारोहद्रथोत्तमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005700013, "chapter_id": 25700, "verse_number": "१७३-१४", "content_sanskrit": "विरोचनस्तु सङ्क्रुद्धो गदापाणिरवस्थितः ।\nप्रमुखे तस्य सैन्यस्य दीप्तग्रह इवाचलः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005700014, "chapter_id": 25700, "verse_number": "१७३-१५", "content_sanskrit": "युक्तं रथसहस्रेण हयग्रीवस्तु दानवः ।\nस्यन्दनं वाहयामास सपत्नानीक मर्दनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005700015, "chapter_id": 25700, "verse_number": "१७३-१६", "content_sanskrit": "व्यायतं किष्कु साहस्रं धनुर्विस्फारयन्महत् ।\nवाराहः प्रमुखे तस्थौ सप्ररोह इवाचलः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005700016, "chapter_id": 25700, "verse_number": "१७३-१७", "content_sanskrit": "खरस्तु विक्षरन्दर्पान्नेत्राभ्यां रोषजं जलम् ।\nस्फुरद्दन्तोष्ठ नयनं सङ्ग्रामं सोऽभ्यकाङ्क्षत ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005700017, "chapter_id": 25700, "verse_number": "१७३-१८", "content_sanskrit": "त्वष्टा त्वष्टगजं घोरं यानमास्थाय दानवः ।\nव्यूहितुं दानवव्यूहं परिचक्राम वीर्यवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005700018, "chapter_id": 25700, "verse_number": "१७३-१९", "content_sanskrit": "विप्रचित्ति वपुश्चैव श्वेत कुण्डल भूषणः ।\nश्वेतः श्वेतप्रतीकाशो युद्धायाभिमुखे स्थितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005700019, "chapter_id": 25700, "verse_number": "१७३-२०", "content_sanskrit": "अरिष्टो बलिपुत्रश्च वरिष्ठाद्रि शिलायुधः ।\nयुद्धायाभिमुखस्तस्थौ धराधर विकम्पनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005700020, "chapter_id": 25700, "verse_number": "१७३-२१", "content_sanskrit": "किशोरस्त्वभिसङ्घर्षात् किशोर इति चोदितः ।\nसबला दानवाश्चैव सन्नह्यन्ते यताक्रमम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005700021, "chapter_id": 25700, "verse_number": "१७३-२२", "content_sanskrit": "अभवद्दैत्यसैन्यस्य मध्ये रविरिवोदितः ।\nलम्बस्तु नवमेघाभः प्रलम्बाम्बर भूषणः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005700022, "chapter_id": 25700, "verse_number": "१७३-२३", "content_sanskrit": "दैत्यव्यूहगतो भाति सनीहार इवांशुमान् ।\nस्वर्भानुरास्ययोधी तु दशनौष्ठे क्षणायुधः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005700023, "chapter_id": 25700, "verse_number": "१७३-२४", "content_sanskrit": "हसंस्तिष्ठति दैत्यानां प्रमुखे स महाग्रहः ।\nअन्ये हयगतास्तत्र गजस्कन्धगताः परे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005700024, "chapter_id": 25700, "verse_number": "१७३-२५", "content_sanskrit": "सिंहव्याघ्रगताश्चान्ये वराहर्क्षेषु चापरे ।\nकेचित् खरोष्ट्रयातारः केचिच्छ्वापदवाहनाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005700025, "chapter_id": 25700, "verse_number": "१७३-२६", "content_sanskrit": "पतिनस्त्वपरे दैत्या भीषणा विकृताननाः ।\nएकपादार्द्धपादाश्च ननृतुर्युद्दकाङ्क्षिणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005700026, "chapter_id": 25700, "verse_number": "१७३-२७", "content_sanskrit": "आस्फोटयन्तो बहवः क्ष्वेडन्तश्च तथापरे ।\nहृष्टशार्दूलनिर्घोषा नेदुर्दानव पुङ्गवाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005700027, "chapter_id": 25700, "verse_number": "१७३-२८", "content_sanskrit": "ते गदापरिघैरुग्रैः शिलामुसलपाणयः ।\nबाहुभिः परिघाकारैस्तर्जयन्तिस्म देवताः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005700028, "chapter_id": 25700, "verse_number": "१७३-२९", "content_sanskrit": "पाशैः प्रासैश्च परिघैस्तोमराङ्कुश पट्टिशैः ।\nचिक्रीडुस्ते शतघ्नीभिः शतधारैश्च मुद्गरैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005700029, "chapter_id": 25700, "verse_number": "१७३-३०", "content_sanskrit": "गण्डशैलैश्च शैलैश्च परिघैश्चोत्तमायसैः ।\nचक्रैश्च दैत्यप्रवरा श्चक्रुरानन्दितं बलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005700030, "chapter_id": 25700, "verse_number": "१७३-३१", "content_sanskrit": "एतद्दानवसैन्यं तत्सर्वं युद्ध मदोत्कटम् ।\nदेवानभिमुखे तस्थौ मेघानीकमिवोद्धतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005700031, "chapter_id": 25700, "verse_number": "१७३-३२", "content_sanskrit": "तदद्भुतं दैत्यसहस्रगाढं वाय्वग्नि शैलाम्बुद तोयकल्पम् ।\nबलं रणौघाभ्युदयेऽभ्युदीर्णं युयुत्सयोन्मत्तमिवावभासे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]