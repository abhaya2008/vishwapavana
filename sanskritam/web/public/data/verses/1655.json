[{"id": 2029993, "chapter_id": 1655, "verse_number": "३-२९३-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029994, "chapter_id": 1655, "verse_number": "३-२९३-१", "content_sanskrit": "एवमेतन्महाबाहो रामेणामिततेजसा।\nप्राप्तं व्यसनमत्युग्रं वनवासकृतं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029995, "chapter_id": 1655, "verse_number": "३-२९३-२", "content_sanskrit": "मा शुचः परुषव्याघ्र क्षत्रियोसि परंतप।\nबाहुवीर्याश्रयेमार्गे वर्तसे दीप्तनिर्णये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029996, "chapter_id": 1655, "verse_number": "३-२९३-३", "content_sanskrit": "न हि ते वृजिनं किंचिद्दृश्यते परमण्वपि।\nअस्मिन्मार्गे निपीदेयुः सेन्द्रा अपि सुरासुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029997, "chapter_id": 1655, "verse_number": "३-२९३-४", "content_sanskrit": "संहत्य निहतोवृत्रो मरुद्भिर्वज्रपाणिना।\nनमुचिश्चैवदुर्धर्षो दीर्गजिह्वा चराक्षसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029998, "chapter_id": 1655, "verse_number": "३-२९३-५", "content_sanskrit": "सहायवति सर्वार्थाः सतिष्ठन्तीह सर्वशः।\nकिंनु तस्याजितं सङ्ख्ये यस् भ्राता धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029999, "chapter_id": 1655, "verse_number": "३-२९३-६", "content_sanskrit": "अयं च बलिनांश्रेष्ठो भीमो भीमपराक्रमाः।\nयुवानौ च महेष्वासौ वीरौ माद्रवतीसुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030000, "chapter_id": 1655, "verse_number": "३-२९३-७", "content_sanskrit": "एभिः सहायैः कस्मात्त्वं विषीदसि परंतप।\nय इमे वज्रिणः सेनां जयेयुः समरुद्गणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030001, "chapter_id": 1655, "verse_number": "३-२९३-८", "content_sanskrit": "त्वमप्येभिर्महेष्वासैः सहायैर्देवरूपिभिः।\nविजेष्यसि रणे सर्वानमित्रान्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030002, "chapter_id": 1655, "verse_number": "३-२९३-९", "content_sanskrit": "इतश्च त्वमिमां पश्यसैन्धवेन दुरात्मना।\nबलिना वीर्यमत्तेन हृतामेभिर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030003, "chapter_id": 1655, "verse_number": "३-२९३-१०", "content_sanskrit": "आनीतां द्रौपदीं कृष्णां कृत्वा कर्म सुदुष्करम्।\nजयद्रथं च राजानं विजितं वशमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030004, "chapter_id": 1655, "verse_number": "३-२९३-११", "content_sanskrit": "असहायेन रामेण वैदेही पुनराहृता।\nहत्वासङ्ख्ये दशग्रीवं राक्षसं भीमविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030005, "chapter_id": 1655, "verse_number": "३-२९३-१२", "content_sanskrit": "यस् शाखामृगामित्राण्यृक्षाः कालमुखास्तथा।\nजात्यन्तरगता राजन्नेतद्बुद्ध्याऽनुचिन्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030006, "chapter_id": 1655, "verse_number": "३-२९३-१३", "content_sanskrit": "तस्मात्सर्वं कुरुश्रेष्ठ मा शुचो भरतर्षभ।\nत्वद्विधा हि महात्मानो न शोचन्ति परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030007, "chapter_id": 1655, "verse_number": "३-२९३-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030008, "chapter_id": 1655, "verse_number": "३-२९३-१४", "content_sanskrit": "एवमाश्वासितो राजामार्कण्डेयेन धीमता।\nत्यक्त्वा दुःखमदीनात्मा पुनरप्येनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030009, "chapter_id": 1655, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपपर्वणि त्रिनवत्यधिकद्विशततमोऽध्यायः ॥ २९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]