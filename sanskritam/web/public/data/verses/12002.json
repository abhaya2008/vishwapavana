[{"id": 50025285, "chapter_id": 12002, "verse_number": "1", "content_sanskrit": "वन्दे वन्द्यं सदानन्दं वासुदेवं निरञ्जनम्। इन्दिरापतिमाद्यादिवरदेशवरप्रदम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50025286, "chapter_id": 12002, "verse_number": "2", "content_sanskrit": "नमामि निखिलाधीशकिरीटाघृष्टपीठवत्। हृत्तमःशमनेऽर्काभं श्रीपतेः पादपङ्कजम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50025287, "chapter_id": 12002, "verse_number": "3", "content_sanskrit": "जाम्बूनदाम्बराधारं नितम्बं चिन्त्यमीशितुः। स्वर्णमञ्जीरसंवीतमारूढं जगदम्बया॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50025288, "chapter_id": 12002, "verse_number": "4", "content_sanskrit": "उदरं चिन्त्यमीशस्य तनुत्वेऽप्यखिलम्भरम्। वलित्रयाङ्कितं नित्यमुपगूढं श्रियैकया॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50025289, "chapter_id": 12002, "verse_number": "5", "content_sanskrit": "स्मरणीयमुरो विष्णोरिन्दिरावासमीशितुः। 【पाठभेदः: BG—विष्णोरिन्दिरावासमुत्तमैः।】 अनन्तमन्तवदिव भुजयोरन्तरं गतम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50025290, "chapter_id": 12002, "verse_number": "6", "content_sanskrit": "शङ्खचक्रगदापद्मधराश्चिन्त्या हरेर्भुजाः। पीनवृत्ता जगद्रक्षाकेवलोद्योगिनोऽनिशम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50025291, "chapter_id": 12002, "verse_number": "7", "content_sanskrit": "सन्ततं चिन्तयेत् कण्ठं भास्वत्कौस्तुभभासकम्। वैकुण्ठस्याखिला वेदा उद्गीर्यन्तेऽनिशं यतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50025292, "chapter_id": 12002, "verse_number": "8", "content_sanskrit": "स्मरेत यामिनीनाथसहस्रामितकान्तिमत्। भवतापापनोदीड्यं श्रीपतेर्मुखपङ्कजम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50025293, "chapter_id": 12002, "verse_number": "9", "content_sanskrit": "पूर्णानन्यसुखोद्भासि मन्दस्मितमधीशितुः। गोविन्दस्य सदा चिन्त्यं नित्यानन्दपदप्रदम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50025294, "chapter_id": 12002, "verse_number": "10", "content_sanskrit": "स्मरामि भवसन्तापहानिदामृतसागरम्। पूर्णानन्दस्य रामस्य सानुरागावलोकनम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50025295, "chapter_id": 12002, "verse_number": "11", "content_sanskrit": "ध्यायेदजस्रमीशस्य पद्मजादिप्रतीक्षितम्। भ्रूभङ्गं पारमेष्ठ्यादिपददायि विमुक्तिदम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50025296, "chapter_id": 12002, "verse_number": "12", "content_sanskrit": "सन्ततं चिन्तयेऽनन्तमन्तकाले विशेषतः। नैवोदापुर्गृणन्तोऽन्तं यद्गुणानामजादयः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50025297, "chapter_id": 12002, "verse_number": "13", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते द्वादशस्तोत्रे प्रथमोऽध्यायः॥ 【पाठभेदः: BG—[-]】", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]