[{"id": 7000576000, "chapter_id": 20576, "verse_number": "५-३५-१", "content_sanskrit": "शेष उवाच ।\nप्राप्य तं वाजिनं राजा शत्रुघ्नो राक्षसैर्हृतम् ।\nअत्यंतं हर्षमापेदे पुष्कलेन समन्वितः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000576001, "chapter_id": 20576, "verse_number": "५-३५-२", "content_sanskrit": "रुधिरैः सिक्तगात्रास्ते योधा लक्ष्मीनिधिस्तथा ।\nरणोत्साहेन संयुक्तं प्रशशंसुर्महानृपम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000576002, "chapter_id": 20576, "verse_number": "५-३५-३", "content_sanskrit": "हते तस्मिन्महादैत्ये विद्युन्मालिनि दुर्जये ।\nसुराः सर्वे भयं त्यक्त्वा सुखमापुर्मुनेमहत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000576003, "chapter_id": 20576, "verse_number": "५-३५-४", "content_sanskrit": "नद्यस्तु विमला जाता रविस्तु विमलोऽभवत् ।\nवाता ववुः सुगंधोद सिक्ता विमलशुष्मिणः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000576004, "chapter_id": 20576, "verse_number": "५-३५-५", "content_sanskrit": "सन्नद्धास्ते महावीरा रथस्था विमलांगकाः ।\nराजानमूचुस्ते सर्वे जयलक्ष्म्या समन्विताः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000576005, "chapter_id": 20576, "verse_number": "५-३५-६", "content_sanskrit": "वीरा ऊचुः ।\nदिष्ट्या हतस्त्वया दैत्यो विद्युन्माली महामते ।\nयद्भयात्त्रासमापन्नाः सुराः स्वर्गान्निराकृताः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000576006, "chapter_id": 20576, "verse_number": "५-३५-७", "content_sanskrit": "दिष्ट्या प्राप्तो महावाजी रघुनाथस्य शोभनः ।\nदिष्ट्या गंतासि सर्वत्र जयं तु क्षितिमंडले॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000576007, "chapter_id": 20576, "verse_number": "५-३५-८", "content_sanskrit": "स्वामिन्मुंचत्विमं वाहं मनोवेगं मनोरमम् ।\nसमयस्य विलंबो मा भवत्वत्र महामते॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000576008, "chapter_id": 20576, "verse_number": "५-३५-९", "content_sanskrit": "शेष उवाच ।\nइति श्रुत्वा तु तद्वाक्यं वीराणां समयोचितम् ।\nसाधु साधु प्रशस्यैतान्मुमोच हयसत्तमम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000576009, "chapter_id": 20576, "verse_number": "५-३५-१०", "content_sanskrit": "स मुक्तश्चोत्तरामाशां बभ्रामाथ सुरक्षितः ।\nरथपत्तिहयश्रेष्ठैः सर्वशस्त्रास्त्रकोविदैः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000576010, "chapter_id": 20576, "verse_number": "५-३५-११", "content_sanskrit": "तत्र यद्वृत्तमेतस्य शत्रुघ्नस्य मनोहरम् ।\nवात्स्यायन शृणुष्वैतत्पापराशिप्रदाहकम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000576011, "chapter_id": 20576, "verse_number": "५-३५-१२", "content_sanskrit": "रेवातीरमथ प्राप्तो मुनिवृंदनिषेवितम् ।\nनीलरत्नसमूहस्य रसः किं तु पयो मिषात्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000576012, "chapter_id": 20576, "verse_number": "५-३५-१३", "content_sanskrit": "तांस्तान्मुनिवरान्सर्वान्प्रणमञ्छूरसेवितः ।\nजगाम हयरत्नस्य पृष्ठतः कामगामिनः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000576013, "chapter_id": 20576, "verse_number": "५-३५-१४", "content_sanskrit": "गच्छंस्तत्राश्रमं जीर्णं पलाशपर्णनिर्मितम् ।\nरेवायाजलकल्लोलैः सिक्तं पापहराश्रयम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000576014, "chapter_id": 20576, "verse_number": "५-३५-१५", "content_sanskrit": "तं दृष्ट्वा सुमतिं प्राह सर्वज्ञं नयकोविदम् ।\nशत्रुघ्नः सर्वधर्मार्थकर्मकर्तव्यकोविदः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000576015, "chapter_id": 20576, "verse_number": "५-३५-१६", "content_sanskrit": "राजोवाच ।\nमंत्रिन्कथय कस्यायमाश्रमः पुण्यदर्शनः ।\nविचारचतुरश्रेष्ठ वदैतन्मम पृच्छतः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000576016, "chapter_id": 20576, "verse_number": "५-३५-१७", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य सुमतिः प्राह तं नृपम् ।\nविशद स्मेरया वाचा दर्शयन्नात्मसौहृदम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000576017, "chapter_id": 20576, "verse_number": "५-३५-१८", "content_sanskrit": "सुमतिरुवाच ।\nएनं दृष्ट्वा महाराज धूतपापा वयं खलु ।\nभविष्यामो मुनिश्रेष्ठं सर्वशास्त्रपरायणम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000576018, "chapter_id": 20576, "verse_number": "५-३५-१९", "content_sanskrit": "तस्मान्नत्वा तमापृच्छ सर्वं ते कथयिष्यति ।\nरघुनाथपदांभोजमकरंदाति लोलुपः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000576019, "chapter_id": 20576, "verse_number": "५-३५-२०", "content_sanskrit": "नाम्ना त्वारण्यकं ख्यातं रघुनाथांघ्रिसेवकम् ।\nअत्युग्रतपसा पूर्णं सर्वशास्त्रार्थकोविदम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000576020, "chapter_id": 20576, "verse_number": "५-३५-२१", "content_sanskrit": "इति श्रुत्वा तु तद्वाक्यं धर्मार्थपरिबृंहितम् ।\nजगाम तमथो द्रष्टुं स्वल्पसेवकसंयुतः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000576021, "chapter_id": 20576, "verse_number": "५-३५-२२", "content_sanskrit": "हनूमान्पुष्कलो वीरः सुमतिर्मंत्रिसत्तमः ।\nलक्ष्मीनिधिः प्रतापाग्र्यः सुबाहुः सुमदस्तथा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000576022, "chapter_id": 20576, "verse_number": "५-३५-२३", "content_sanskrit": "एतैः परिवृतो राजा शत्रुघ्नः प्रापदाश्रमम् ।\nनमस्कर्तुं द्विजवरमारण्यकमुदारधीः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000576023, "chapter_id": 20576, "verse_number": "५-३५-२४", "content_sanskrit": "गत्वा तं तापसश्रेष्ठं नमस्कारमथाकरोत् ।\nसर्वैस्तैः सहितो वीरैर्विनयानतकंधरैः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000576024, "chapter_id": 20576, "verse_number": "५-३५-२५", "content_sanskrit": "तान्दृष्ट्वा सन्नतान्सर्वाञ्छत्रुघ्नप्रमुखान्नृपान् ।\nअर्घ्यपाद्यादिकं चक्रे फलमूलादिभिस्तदा॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000576025, "chapter_id": 20576, "verse_number": "५-३५-२६", "content_sanskrit": "उवाच तान्नृपान्सर्वान्भवंतः कुत्र संगताः ।\nकथमत्र समायातास्तत्सर्वं वदतानघाः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000576026, "chapter_id": 20576, "verse_number": "५-३५-२७", "content_sanskrit": "तच्छ्रुत्वा वाक्यमेतस्य मुनिवर्यस्य वाडव ।\nसुमतिः कथयामास वाक्यं वादविचक्षणः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000576027, "chapter_id": 20576, "verse_number": "५-३५-२८", "content_sanskrit": "सुमतिरुवाच ।\nरघुवंशनृपस्यायमश्वो वै पाल्यतेऽखिलैः ।\nयागं करिष्यते वीरः सर्वसंभारसंभृतम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000576028, "chapter_id": 20576, "verse_number": "५-३५-२९", "content_sanskrit": "तच्छ्रुत्वा वचनं तेषां जगाद मुनिसत्तमः ।\nदंतकांत्याखिलं घोरं तमोनिर्वारयन्निव॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000576029, "chapter_id": 20576, "verse_number": "५-३५-३०", "content_sanskrit": "आरण्यक उवाच ।\nकिं यागैर्विविधैरन्यैः सर्वसंभारसंभृतैः ।\nस्वल्पपुण्यप्रदैर्नूनं क्षयिष्णुपददातृभिः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000576030, "chapter_id": 20576, "verse_number": "५-३५-३१", "content_sanskrit": "मूढो लोको हरिं त्यक्त्वा करोत्यन्यसमर्चनम् ।\nरघुवीरं रमानाथं स्थिरैश्वर्यपदप्रदम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000576031, "chapter_id": 20576, "verse_number": "५-३५-३२", "content_sanskrit": "यो नरैः स्मृतमात्रोपि हरते पापपर्वतम् ।\nतं मुक्त्वा क्लिश्यते मूढो यागयोगव्रतादिभिः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000576032, "chapter_id": 20576, "verse_number": "५-३५-३३", "content_sanskrit": "अहो पश्यत मूढत्वं लोकानामतिवंचितम् ।\nसुलभं रामभजनं मुक्त्वा दुर्ल्लभमाचरेत्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000576033, "chapter_id": 20576, "verse_number": "५-३५-३४", "content_sanskrit": "सकामैर्योगिभिर्वापि चिंत्यते कामवर्जितैः ।\nअपवर्गप्रदं नॄणां स्मृतमात्राखिलाघहम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000576034, "chapter_id": 20576, "verse_number": "५-३५-३५", "content_sanskrit": "पुराहं तत्त्ववित्सायां ज्ञानिनं सुविचारयन् ।\nअगमं बहुतीर्थानि तत्त्वं कोपि न मेऽदिशत्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000576035, "chapter_id": 20576, "verse_number": "५-३५-३६", "content_sanskrit": "तदैकं हि महद्भाग्यात्प्राप्तं वै लोमशं मुनिम् ।\nस्वर्गलोकात्समायातं तीर्थयात्राचिकीर्षया॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000576036, "chapter_id": 20576, "verse_number": "५-३५-३७", "content_sanskrit": "तमहं प्रणिपत्याथ पर्यपृच्छं महामुनिम् ।\nमहायुषं महायोगिसंसेवितपदद्वयम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000576037, "chapter_id": 20576, "verse_number": "५-३५-३८", "content_sanskrit": "स्वामिन्मयाद्य मानुष्यं प्राप्तमद्भुतदुर्ल्लभम् ।\nसंसारघोरजलधिं किं कर्तव्यं तितीर्षुणा॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000576038, "chapter_id": 20576, "verse_number": "५-३५-३९", "content_sanskrit": "विचार्य कथय त्वं तद्व्रतं दानं जपो मखः ।\nदेवो वा विद्यते यो वै संसृत्यंभोधितारकः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000576039, "chapter_id": 20576, "verse_number": "५-३५-४०", "content_sanskrit": "यज्ज्ञात्वा संसृतिं घोरां तरामि त्वत्कृपाब्धितः ।\nतन्मे कथय योगेश सर्वशास्त्रार्थपारग॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000576040, "chapter_id": 20576, "verse_number": "५-३५-४१", "content_sanskrit": "इति मद्वाक्यमाकर्ण्य जगाद मुनिसत्तमः ।\nशृणुष्वैकमना विप्र श्रद्धया परया युतः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000576041, "chapter_id": 20576, "verse_number": "५-३५-४२", "content_sanskrit": "संति दानानि तीर्थानि व्रतानि नियमा यमाः ।\nयोगा यज्ञास्तथानेके वर्तंते स्वर्गदायकाः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000576042, "chapter_id": 20576, "verse_number": "५-३५-४३", "content_sanskrit": "परं गुह्यं प्रवक्ष्यामि सर्वपापप्रणाशनम् ।\nतच्छृणुष्व महाभाग संसारांभोधितारकम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000576043, "chapter_id": 20576, "verse_number": "५-३५-४४", "content_sanskrit": "नास्तिकाय न वक्तव्यं न चाऽश्रद्धालवे पुनः ।\nनिंदकाय शठायापि न देयं भक्तिवैरिणे॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000576044, "chapter_id": 20576, "verse_number": "५-३५-४५", "content_sanskrit": "रामभक्ताय शांताय कामक्रोधवियोगिने ।\nवक्तव्यं सर्वदुःखस्य नाशकारकमुत्तमम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000576045, "chapter_id": 20576, "verse_number": "५-३५-४६", "content_sanskrit": "रामान्नास्ति परो देवो रामान्नास्ति परं व्रतम् ।\nन हि रामात्परो योगो न हि रामात्परो मखः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000576046, "chapter_id": 20576, "verse_number": "५-३५-४७", "content_sanskrit": "तं स्मृत्वा चैव जप्त्वा च पूजयित्वा नरः परम् ।\nप्राप्नोति परमामृद्धिमैहिकामुष्मिकीं तथा॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000576047, "chapter_id": 20576, "verse_number": "५-३५-४८", "content_sanskrit": "संस्मृतो मनसा ध्यातः सर्वकामफलप्रदः ।\nददाति परमां भक्तिं संसारांभोधितारिणीम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000576048, "chapter_id": 20576, "verse_number": "५-३५-४९", "content_sanskrit": "श्वपाकोपि हि संस्मृत्य रामं याति परां गतिम् ।\nये वेदशास्त्रनिरतास्त्वादृशास्तत्र किं पुनः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000576049, "chapter_id": 20576, "verse_number": "५-३५-५०", "content_sanskrit": "सर्वेषां वेदशास्त्राणां रहस्यं ते प्रकाशितम् ।\nसमाचर तथा त्वं वै यथा स्यात्ते मनीषितम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000576050, "chapter_id": 20576, "verse_number": "५-३५-५१", "content_sanskrit": "एको देवो रामचंद्रो व्रतमेकं तदर्चनम् ।\nमंत्रोऽप्येकश्च तन्नाम शास्त्रं तद्ध्येव तत्स्तुतिः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000576051, "chapter_id": 20576, "verse_number": "५-३५-५२", "content_sanskrit": "तस्मात्सर्वात्मना रामचंद्रं भजमनोहरम् ।\nयथा गोष्पदवत्तुच्छो भवेत्संसारसागरः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000576052, "chapter_id": 20576, "verse_number": "५-३५-५३", "content_sanskrit": "श्रुत्वा मया तु तद्वाक्यं पुनः प्रश्नमकारिषम् ।\nकथं वा ध्यायते देवः कथं वा पूज्यते नरैः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000576053, "chapter_id": 20576, "verse_number": "५-३५-५४", "content_sanskrit": "कथयस्व महाबुद्धे सर्वज्ञ मम विस्तरात् ।\nयज्ज्ञात्वाहं कृतार्थः स्यां त्रिलोक्यां मुनिसत्तम॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000576054, "chapter_id": 20576, "verse_number": "५-३५-५५", "content_sanskrit": "एतच्छ्रुत्वा तु मद्वाक्यं विचार्य स तु लोमशः ।\nकथयामास मे सर्वं रामध्यानपुरःसरम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000576055, "chapter_id": 20576, "verse_number": "५-३५-५६", "content_sanskrit": "शृणु विप्रेंद्र वक्ष्यामि यत्पृष्टं तु त्वयानघ ।\nयथा तुष्येद्रमानाथः संसारज्वरदाहकः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000576056, "chapter_id": 20576, "verse_number": "५-३५-५७", "content_sanskrit": "अयोध्यानगरे रम्ये चित्रमंडपशोभिते ।\nध्यायेत्कल्पतरोर्मूले सर्वकामसमृद्धिदे॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000576057, "chapter_id": 20576, "verse_number": "५-३५-५८", "content_sanskrit": "महामरकतस्वर्णनीलरत्नादिशोभितम् ।\nसिंहासनं चित्तहरं कांत्या तामिस्रनाशनम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000576058, "chapter_id": 20576, "verse_number": "५-३५-५९", "content_sanskrit": "तस्योपरि समासीनं रघुराजं मनोरमम् ।\nदूर्वादलश्यामतनुं देवदेवेंद्रपूजितम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000576059, "chapter_id": 20576, "verse_number": "५-३५-६०", "content_sanskrit": "राकायां पूर्णशीतांशुकांतिधिक्कारिवक्त्रिणम् ।\nअष्टमीचंद्रशकलसमभालाधिधारिणम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000576060, "chapter_id": 20576, "verse_number": "५-३५-६१", "content_sanskrit": "नीलकुंतलशोभाढ्यं किरीटमणिरंजितम् ।\nमकराकारसौंदर्यकुंडलाभ्यां विराजितम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000576061, "chapter_id": 20576, "verse_number": "५-३५-६२", "content_sanskrit": "विद्रुमच्छवि सत्कांतिरदच्छदविराजितम् ।\nतारापतिकराकार द्विजराजि सुशोभितम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000576062, "chapter_id": 20576, "verse_number": "५-३५-६३", "content_sanskrit": "जपापुष्पाभया माध्व्या जिह्वया शोभिताननम् ।\nयस्यां वसंति निगमा ऋगाद्याः शास्त्रसंयुताः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000576063, "chapter_id": 20576, "verse_number": "५-३५-६४", "content_sanskrit": "कंबुकांतिधरग्रीवा शोभया समलंकृतम् ।\nसिंहवदुच्चकौ स्कन्धौ मांसलौ बिभ्रतं वरम्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000576064, "chapter_id": 20576, "verse_number": "५-३५-६५", "content_sanskrit": "बाहू दधानं दीर्घांगौ केयूरकटकांकितौ ।\nमुद्रिकाहीरशोभाभिर्भूषितौ जानुलंबिनौ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000576065, "chapter_id": 20576, "verse_number": "५-३५-६६", "content_sanskrit": "वक्षो दधानं विपुलं लक्ष्मीवासेन शोभितम् ।\nश्रीवत्सादिविचित्रांकैरंकितं सुमनोहरम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000576066, "chapter_id": 20576, "verse_number": "५-३५-६७", "content_sanskrit": "महोदरं महानाभिं शुभकट्याविराजितम् ।\nकांच्या वै मणिमत्या च विशेषेण श्रियान्वितम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000576067, "chapter_id": 20576, "verse_number": "५-३५-६८", "content_sanskrit": "ऊरुभ्यां विमलाभ्यां वै जानुभ्यां शोभितं श्रिया ।\nचरणाभ्यां वज्ररेखा यवांकुशसुरेखया॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000576068, "chapter_id": 20576, "verse_number": "५-३५-६९", "content_sanskrit": "युताभ्यां योगिध्येयाभ्यां कोमलाभ्यां विराजितम् ।\nध्यात्वा स्मृत्वा च संसारसागरं त्वं तरिष्यसि॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000576069, "chapter_id": 20576, "verse_number": "५-३५-७०", "content_sanskrit": "तमेव पूजयन्नित्यं चंदनादिभिरिच्छया ।\nप्राप्नोति परमामृद्धिमैहिकामुष्मिकीं पराम्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000576070, "chapter_id": 20576, "verse_number": "५-३५-७१", "content_sanskrit": "त्वया पृष्टं महाराज रामस्य ध्यानमुत्तमम् ।\nतत्ते कथितमेतद्वै संसारजलधिं तर॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]