[{"id": 2062794, "chapter_id": 2336, "verse_number": "८-५७-०x", "content_sanskrit": "दृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062795, "chapter_id": 2336, "verse_number": "८-५७-१", "content_sanskrit": "पाण्ड्ये हते किमकरोदर्जुनो जयतांवरः।\nएकवीरेण कर्णेन द्राविते च युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062796, "chapter_id": 2336, "verse_number": "८-५७-२", "content_sanskrit": "समाप्तविद्यो बलवान्युक्तो वीरश्च पाण्डवः।\nसर्वभूतेष्वनुज्ञातः शङ्करेण महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062797, "chapter_id": 2336, "verse_number": "८-५७-३", "content_sanskrit": "तस्मान्महद्भयं तीव्रममित्रघ्नाद्धनञ्जयात्।\nस यत्तत्राकरोत्पार्थस्तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062798, "chapter_id": 2336, "verse_number": "८-५७-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062799, "chapter_id": 2336, "verse_number": "८-५७-४", "content_sanskrit": "हते पाण्ड्येऽर्जुनं कृष्णस्त्वरन्नाह वचो हितम्।\nहतं पश्य स्वराजानमपयातांश्च पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062800, "chapter_id": 2336, "verse_number": "८-५७-५", "content_sanskrit": "कर्णं पश्य महारङ्गे ज्वलन्तमिव पावकम्।\nअसौ भीमो महेष्वासः प्रतिवृत्तो रणं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062801, "chapter_id": 2336, "verse_number": "८-५७-६", "content_sanskrit": "त इमे नानुवर्तन्ते धृष्टद्युम्नपुरोगमाः।\nपाञ्चालाः सृञ्जयाश्चैव पाण्डवानां चमूमुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062802, "chapter_id": 2336, "verse_number": "८-५७-७", "content_sanskrit": "`निवृत्तैश्च पुनः पार्थैर्भग्नं शत्रुबलं महत्।\nकौरवान्द्रवतो ह्येष कर्णो वारयते भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062803, "chapter_id": 2336, "verse_number": "८-५७-८", "content_sanskrit": "अन्तकप्रतिमो वेगे शक्रतुल्यपराक्रमः।\nअसौ गच्छति कौन्तेय द्रौणिः शस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062804, "chapter_id": 2336, "verse_number": "८-५७-९", "content_sanskrit": "तमेष प्रद्रुतः सङ्ख्ये धृष्टद्युम्नो महारथः।\nअश्वत्थाम्ना हताः सङ्ख्ये सर्वे कौन्तेय सृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062805, "chapter_id": 2336, "verse_number": "८-५७-१०", "content_sanskrit": "रथाश्वनरनागानां कृतं च कदनं महत्।\nइत्येतत्सर्वमाचष्ट वासुदेवः किरीटिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062806, "chapter_id": 2336, "verse_number": "८-५७-११", "content_sanskrit": "एतच्छ्रुत्वा च दृष्ट्वा च भ्रातृणां व्यसनं महत्।\nवाहयाश्वान्हृषीकेश क्षिप्रमित्याह पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062807, "chapter_id": 2336, "verse_number": "८-५७-१२", "content_sanskrit": "ततः प्रायाद्धृषीकेशो रथेनाप्रतिमो युधि।\n`ततो रेणुः समभवत्पुनस्तत्र महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062808, "chapter_id": 2336, "verse_number": "८-५७-१३", "content_sanskrit": "ततो राजन्महानासीत्सङ्गामो रोमहर्षणः।\nसिंहनादरवाश्चात्र प्रादुरासन्समागमे।\nउभयोः सेनयो राजन्मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062809, "chapter_id": 2336, "verse_number": "८-५७-१४", "content_sanskrit": "ततः हुनः समाजग्मुरभीताः कुरुसृञ्जयाः।\nयुधिषरमुखाः पार्था वैकर्तनमुखा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062810, "chapter_id": 2336, "verse_number": "८-५७-१५", "content_sanskrit": "ततः प्रववृते यूद्धं घोररूपं विशाम्पते।\nकर्णस्य पाण्डवानां च यमराष्ट्रविवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062811, "chapter_id": 2336, "verse_number": "८-५७-१६", "content_sanskrit": "तस्मिन्प्रवृत्ते सङ्ग्रामे तुमुले रोमहर्षणे।\nसंशप्तकेषु वीरेषु किञ्चिच्छेषेषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062812, "chapter_id": 2336, "verse_number": "८-५७-१७", "content_sanskrit": "धृष्टद्युम्नो महाराज सहितः सर्वराजभिः।\nकर्णमेवाभिदुद्राव पाण्डवाश्च महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062813, "chapter_id": 2336, "verse_number": "८-५७-१८", "content_sanskrit": "आगच्छमानांस्तान्दृष्ट्वा सङ्ग्रमे विजयैषिणः।\nदधारैको रणे कार्णो जलौघानिव पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062814, "chapter_id": 2336, "verse_number": "८-५७-१९", "content_sanskrit": "समासाद्य तु ते कर्णं व्यशीर्यन्त महारथाः।\nयथाऽचलं समासाद्य वार्योधाः सर्वतोदिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062815, "chapter_id": 2336, "verse_number": "८-५७-२०", "content_sanskrit": "तयोरासीन्महाराज सङ्ग्रामो घोरदर्शनः।\nप्रवृद्धयोर्महारङ्गे बलिनोर्विजिगीषतोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062816, "chapter_id": 2336, "verse_number": "८-५७-२१", "content_sanskrit": "धृष्टद्युम्नस्तु राधेयं शरेणानतपर्वणा।\nछादयामास सङ्क्रुद्धस्तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062817, "chapter_id": 2336, "verse_number": "८-५७-२२", "content_sanskrit": "विजयं तु धनुः श्रेष्ठं विधृन्वानो महारथः।\nपार्षतस्य धनुश्छित्त्वा शरांश्चाशीविषोपमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062818, "chapter_id": 2336, "verse_number": "८-५७-२३", "content_sanskrit": "ववर्ष शरवर्षाणि तोयवर्षानिवाम्बुदः।\nछादयामास सङ्क्रुद्धः पार्षतं नवभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062819, "chapter_id": 2336, "verse_number": "८-५७-२४", "content_sanskrit": "ते हेमविकृतं वर्म भित्त्वा तस्य महात्मनः।\nशोणिताक्ता व्यराजन्त शक्रगोपा इवानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062820, "chapter_id": 2336, "verse_number": "८-५७-२५", "content_sanskrit": "तदपास्य धनुश्छिन्नं धृष्टद्युम्नः प्रतापवान्।\nततोऽन्यद्धनुरादाय सारवद्भारसाधनम्।\nकर्णं विव्याध सप्तत्या शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062821, "chapter_id": 2336, "verse_number": "८-५७-२६", "content_sanskrit": "तथैव राजन्कर्णोऽपि पार्षतं शत्रुतापनम्।\nद्रोणशत्रुं महेष्वासो विव्याध निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062822, "chapter_id": 2336, "verse_number": "८-५७-२७", "content_sanskrit": "पुनरन्यं महाराज शरं कनकभूषणम्।\nप्रेषयामास समरे मृत्युदण्डमिवापरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062823, "chapter_id": 2336, "verse_number": "८-५७-२८", "content_sanskrit": "तमापतन्तं सहसा घोररूपं विशाम्पते।\nचिच्छेद शतधा राजन्पार्षतः कृतहस्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062824, "chapter_id": 2336, "verse_number": "८-५७-२९", "content_sanskrit": "दृष्टवान्पतितं भूमौ शरं कर्णो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062825, "chapter_id": 2336, "verse_number": "८-५७-३०", "content_sanskrit": "पार्षतः शरवर्षेण समन्तात्पर्यवारयत्।\nविव्याध चैनं त्वरितो नाराचैः सप्तभिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062826, "chapter_id": 2336, "verse_number": "८-५७-३१", "content_sanskrit": "तं प्रत्यविध्यद्दशभिः शरैर्हेमविभूषितैः।\nतयोर्युद्धं समभवद्दृष्टिश्रोत्रमनोहरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062827, "chapter_id": 2336, "verse_number": "८-५७-३२", "content_sanskrit": "आसीद्धोरं च चित्रं च प्रेक्षणीयं च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062828, "chapter_id": 2336, "verse_number": "८-५७-३३", "content_sanskrit": "सर्वेषां तत्र भूतानां रोमहर्षो व्यजायत।\nदृष्ट्वा तत्समरे कर्म कर्णपार्षतयोर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062829, "chapter_id": 2336, "verse_number": "८-५७-३४", "content_sanskrit": "एतस्मिन्नन्तरे द्रौणिरभ्ययात्तं महारथम्।\nपार्षतं शत्रुदमनं शत्रुवीर्यासुनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062830, "chapter_id": 2336, "verse_number": "८-५७-३५", "content_sanskrit": "स दृष्ट्वा समरे यान्तमभीतं च महारथम्।\nअभ्यभाषत सङ्क्रुद्धः पार्षतं शत्रुतापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062831, "chapter_id": 2336, "verse_number": "८-५७-३६", "content_sanskrit": "रथं रथेन सम्पीड्य पार्षतस्य तु ब्राह्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062832, "chapter_id": 2336, "verse_number": "८-५७-३७", "content_sanskrit": "तिष्ठतिष्ठेति ब्रह्मघ्न न मे जीवन्विमोक्ष्यसे।\nइत्युक्त्वा सुभृशं वीरः शीघ्रकृन्निशितैः शरैः।\nछादयामास समरे यतमानो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062833, "chapter_id": 2336, "verse_number": "८-५७-३८", "content_sanskrit": "यत्नतः परया शक्त्या धृष्टद्युम्नं महारथम्।\nयोधयामास समरे क्रुद्धरूपो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062834, "chapter_id": 2336, "verse_number": "८-५७-३९", "content_sanskrit": "तयोस्तु सन्निपाते हि घोररूपो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062835, "chapter_id": 2336, "verse_number": "८-५७-४०", "content_sanskrit": "यथा हि समरे द्रौणिः पार्षतं दृश्यत मारिष।\nनातिहृष्टमना ह्यासीन्मन्वानो मृत्युमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062836, "chapter_id": 2336, "verse_number": "८-५७-४१", "content_sanskrit": "स ज्ञात्वा पितुरत्यन्तरैरिणं तु महाहवे।\nआत्मानं समरे ज्ञात्वाऽशस्त्रवध्यं महाबलः।\nजवेनाभिययौ द्रौणिं कालः कालक्षये यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062837, "chapter_id": 2336, "verse_number": "८-५७-४२", "content_sanskrit": "द्रौणिस्तु दृष्ट्वा राजेन्द्र धृष्टद्युम्नमवस्थितम्।\nक्रोधेन निःश्वसन्वीरः पार्षदं समभिद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062838, "chapter_id": 2336, "verse_number": "८-५७-४३", "content_sanskrit": "तावन्योन्यं तु दृष्ट्वैव संरम्भं जग्मतुः परम्।\nप्रगृह्य महती चापे शरासनसमन्विते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062839, "chapter_id": 2336, "verse_number": "८-५७-४४", "content_sanskrit": "अथाब्रवीन्महाराज द्रोणपुत्रः प्रतापवान्।\nधृष्टद्युम्नं समीपस्थं त्वरमाणो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2062840, "chapter_id": 2336, "verse_number": "८-५७-४५", "content_sanskrit": "पाञ्चालापशदाद्य त्वां प्रेषयामि यमक्षयम्।\nपापं हि यत्त्वया कर्म कृतं तातं घ्नता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2062841, "chapter_id": 2336, "verse_number": "८-५७-४६", "content_sanskrit": "अद्य त्वं प्राप्स्यसे तद्वै यथा ह्यकुशलस्तथा।\nअरक्ष्यमाणः पार्थेन यदि तिष्ठसि संयुगे।\nनापक्रामसि वा मोहात्सत्यमेतद्ब्रवीमि ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2062842, "chapter_id": 2336, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे सप्तपञ्चाशोऽध्यायः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]