[{"id": 2039834, "chapter_id": 1881, "verse_number": "५-१२६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039835, "chapter_id": 1881, "verse_number": "५-१२६-१", "content_sanskrit": "धृतराष्ट्रवचः श्रुत्वा भीष्मद्रोणौ समव्यथौ।\nदुर्योधनमिदं वाक्यमूचतुः शासनातिगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039836, "chapter_id": 1881, "verse_number": "५-१२६-२", "content_sanskrit": "यावत्कृष्णावसन्नद्धौ यावत्तिष्ठति गाण्डिवम् ।\nयावद्धौम्यो न मेधाग्नौ जुहोतीह द्विषद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039837, "chapter_id": 1881, "verse_number": "५-१२६-३", "content_sanskrit": "यावन्न प्रेक्षते क्रूद्धः सेनां तव युधिष्ठिरः।\nह्रीनिषेवो महेष्वासस्तावच्छाम्यतु वैशसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039838, "chapter_id": 1881, "verse_number": "५-१२६-४", "content_sanskrit": "यावन्न दृश्यते पार्थः स्वेऽप्यनीके व्यवस्थितः।\nभीमसेनो महेष्वासस्तावच्छाम्यतु वैशसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039839, "chapter_id": 1881, "verse_number": "५-१२६-५", "content_sanskrit": "यावन्न चरते मार्गान्पृतनामभिधर्षयन् ।\nभीमसेनो गदापाणिस्तावत्संशाम्य पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039840, "chapter_id": 1881, "verse_number": "५-१२६-६", "content_sanskrit": "यावन्न शातयत्याजौ शिरांसि गजयोधिनाम् ।\nगदया वीरघातिन्या फलानीव वनस्पतेः ।\nकालेन परिपक्वानि तावच्छाम्यतु वैशसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039841, "chapter_id": 1881, "verse_number": "५-१२६-७", "content_sanskrit": "नकुलः सहदेवश्च धृष्टद्युम्नश्च पार्षतः ॥\nविराटश्च शिखण्डी च शैशुपालिश्च दंशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039842, "chapter_id": 1881, "verse_number": "५-१२६-८", "content_sanskrit": "यावन्न प्रविशन्त्येते नक्रा इव महार्णवम् ।\nकृतास्त्राः क्षिप्रमस्यन्तस्तावच्छाम्यतु वैशसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039843, "chapter_id": 1881, "verse_number": "५-१२६-९", "content_sanskrit": "यावन्न सुकुमारेषु शरीरेषु महीक्षिताम्।\nगार्ध्रपत्राः पतन्त्युग्रास्तावच्छाम्यतु वैशसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039844, "chapter_id": 1881, "verse_number": "५-१२६-१०", "content_sanskrit": "चन्दनागुरुदिग्धेषु हारनिष्कधरेषु च ।\nनोरस्सु यावद्योधानां महेष्वासैर्महेषवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039845, "chapter_id": 1881, "verse_number": "५-१२६-११", "content_sanskrit": "कृतस्त्रैः क्षिप्रमस्यद्भिर्दूरपातिभिरायसाः ।\nअभिलक्ष्यैर्निपात्यन्ते तावच्छाम्यतु वैशसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039846, "chapter_id": 1881, "verse_number": "५-१२६-१२", "content_sanskrit": "अभिवादयमानं त्वां शिरसा राजकुञ्जरः ।\nपाणिभ्यां प्रतिगृह्णातु धर्मराजो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039847, "chapter_id": 1881, "verse_number": "५-१२६-१३", "content_sanskrit": "ध्वजाङ्कुशपताकाङ्कं दक्षिणं ते सुदक्षिणः ।\nस्कन्धे निक्षिपतां बहुं शान्तये भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039848, "chapter_id": 1881, "verse_number": "५-१२६-१४", "content_sanskrit": "रत्नौषधिसमेतेन रत्नाङ्गुलितलेन च।\nउपविष्टस्य पृष्ठं ते पाणिना परिमार्जतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039849, "chapter_id": 1881, "verse_number": "५-१२६-१५", "content_sanskrit": "शालस्कन्धो महाबहुस्त्वां स्वजानो वृकोदरः । ५-१२६-१५bसाम्नाऽभिवदतां चापि शान्तये भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039850, "chapter_id": 1881, "verse_number": "५-१२६-१६", "content_sanskrit": "अर्जुनेन यमाभ्यां च त्रिभिस्तैरभिवादितः।\nमूर्ध्नि तान्समुपाघ्राय प्रेम्णाऽभिवद पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039851, "chapter_id": 1881, "verse_number": "५-१२६-१७", "content_sanskrit": "दृष्ट्वा त्वां पाण्डवैर्वीरैर्भ्रातृभिः सह संगतम् ।\nयावदानन्दजाश्रूणि प्रन्मुञ्चन्तु नराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039852, "chapter_id": 1881, "verse_number": "५-१२६-१८", "content_sanskrit": "घुष्यतां राजधानीषु सर्वसंपन्महीक्षिताम् ।\nपृथिवी भ्रातृभावेन भुज्यतां विज्वरो भव ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039853, "chapter_id": 1881, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि षड्विंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]