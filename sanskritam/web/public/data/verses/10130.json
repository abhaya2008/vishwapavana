[{"id": 6000130000, "chapter_id": 10130, "verse_number": null, "content_sanskrit": "अथ एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "इन्द्रेण सह युद्‍ध्यमानस्य वृत्रस्य इन्द्रं बहु विनिन्द्य भगवद्भक्तियुक्ता वाचः", "range": null}]}, {"id": 6000130001, "chapter_id": 10130, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.001.m4a", "display_order": 2}, {"id": 6000130002, "chapter_id": 10130, "verse_number": "६-११-१", "content_sanskrit": "त एवं शंसतो धर्मं वचः पत्युरचेतसः।\nनैवागृह्णन् भयत्रस्ताः पलायनपरा नृप॥ ६/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.002.m4a", "display_order": 3}, {"id": 6000130003, "chapter_id": 10130, "verse_number": "६-११-२", "content_sanskrit": "विशीर्यमाणां पृतनामासुरीमसुरर्षभः।\nकालानुकूलैस्‍त्रिदशैः काल्यमानामनाथवत्॥ ६/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.003.m4a", "display_order": 4}, {"id": 6000130004, "chapter_id": 10130, "verse_number": "६-११-३", "content_sanskrit": "दृष्ट्वाऽतप्यत संक्रुद्ध इन्द्रशत्रुरमर्षितः।\nतान् निवार्यौजसा राजन् निर्भर्त्स्येदमुवाच ह॥ ६/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.004.m4a", "display_order": 5}, {"id": 6000130005, "chapter_id": 10130, "verse_number": null, "content_sanskrit": "वृत्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.005.m4a", "display_order": 6}, {"id": 6000130006, "chapter_id": 10130, "verse_number": "६-११-४", "content_sanskrit": "किं व उच्चरिता मातुर्धावद्भिः पृष्ठतो हतैः।\nन हि भीतवधः श्लाघ्यो न स्वर्ग्यः शूरमानिनाम्॥ ६/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.006.m4a", "display_order": 7}, {"id": 6000130007, "chapter_id": 10130, "verse_number": "६-११-५", "content_sanskrit": "यदि वः प्रधने श्रद्धा सारं वा क्षुल्लका हृदि।\nअग्रे तिष्ठत मात्रं मे न चेद् ग्राम्यसुखे स्पृहा॥ ६/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.007.m4a", "display_order": 8}, {"id": 6000130008, "chapter_id": 10130, "verse_number": "६-११-६", "content_sanskrit": "एवं सुरगणान् क्रुद्धो भीषयन् वपुषा रिपून्।\nव्यनदत् सुमहाप्राणो येन लोका विचेतसः॥ ६/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.008.m4a", "display_order": 9}, {"id": 6000130009, "chapter_id": 10130, "verse_number": "६-११-७", "content_sanskrit": "तेन देवगणाः सर्वे वृत्रविस्फोटनेन वै।\nनिपेतुर्मूर्च्छिता भूमौ यथैवाशनिना हताः॥ ६/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.009.m4a", "display_order": 10}, {"id": 6000130010, "chapter_id": 10130, "verse_number": "६-११-८", "content_sanskrit": "ममर्द पद्भ्यां सुरसैन्यमातुरं निमीलिताक्षं रणरङ्गदुर्मदः।\nगां कम्पयन्नुद्यतशूल ओजसा नालं वनं यूथपतिर्यथोन्मदः॥ ६/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.010.m4a", "display_order": 11}, {"id": 6000130011, "chapter_id": 10130, "verse_number": "६-११-९", "content_sanskrit": "विलोक्य तं वज्रधरोऽत्यमर्षितः स्वशत्रवेऽभिद्रवते महागदाम्।\nचिक्षेप तामापततीं सुदुस्सहां जग्राह वामेन करेण लीलया॥ ६/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.011.m4a", "display_order": 12}, {"id": 6000130012, "chapter_id": 10130, "verse_number": "६-११-१०", "content_sanskrit": "स इन्द्रशत्रुः कुपितो भृशं तया महेन्द्रवाहं गदयोरुविक्रमः।\nजघान कुम्भस्थल उन्नदन् मृधे तत्कर्म सर्वे समपूजयन् नृप॥ ६/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.012.m4a", "display_order": 13}, {"id": 6000130013, "chapter_id": 10130, "verse_number": "६-११-११", "content_sanskrit": "ऐरावतो वृत्रगदाऽभिमृष्टो विघूर्णितोऽद्रिः कुलिशाहतो यथा।\nअपासरद् भिन्नमुखः सहेन्द्रो मुञ्चन्नसृक् सप्तधनुर्भृशार्तः॥ ६/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.013.m4a", "display_order": 14}, {"id": 6000130014, "chapter_id": 10130, "verse_number": "६-११-१२", "content_sanskrit": "न सन्नवाहाय विषण्णचेतसे प्रायुङ्क्त भूयः स गदां महात्मा।\nइन्द्रोऽमृतस्यन्दिकराभिमर्षवीतव्यथः क्षतवाहोऽवतस्थे॥ ६/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.014.m4a", "display_order": 15}, {"id": 6000130015, "chapter_id": 10130, "verse_number": "६-११-१३", "content_sanskrit": "स तं नृपेन्द्राहवकाम्यया रिपुं वज्रायुधं भ्रातृहणं विलोक्य।\nस्मरंश्च तत्कर्म नृशंसमंहः शोकेन मोहेन हसञ्जगाद॥ ६/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.015.m4a", "display_order": 16}, {"id": 6000130016, "chapter_id": 10130, "verse_number": null, "content_sanskrit": "वृत्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.016.m4a", "display_order": 17}, {"id": 6000130017, "chapter_id": 10130, "verse_number": "६-११-१४", "content_sanskrit": "दिष्ट्या भवान् मे समवस्थितो रिपुर्यो ब्रह्महा गुरुहा भ्रातृहा च।\nदिष्ट्याऽनृणोऽद्याहमसत्तम त्वया मच्छूलनिर्भिन्नदृषद्धृदाऽचिरात्॥ ६/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.017.m4a", "display_order": 18}, {"id": 6000130018, "chapter_id": 10130, "verse_number": "६-११-१५", "content_sanskrit": "यो नोऽग्रजस्यात्मविदो द्विजातेर्गुरोरपापस्य च दीक्षितस्य।\nविस्रभ्य खड्गेन शिरांस्यवृश्चः पशोरिवाकरुणः स्वर्गकामः॥ ६/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.018.m4a", "display_order": 19}, {"id": 6000130019, "chapter_id": 10130, "verse_number": "६-११-१६", "content_sanskrit": "ह्रीश्रीदयाकीर्तिभिरुज्ज्ञितं त्वां स्वकर्मणा पुरुषादैश्च गर्ह्यम्।\nकृच्छ्रेण मच्छूलविभिन्नदेहमस्पृष्टवह्निं समदन्तु गृध्राः॥ ६/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.019.m4a", "display_order": 20}, {"id": 6000130020, "chapter_id": 10130, "verse_number": "६-११-१७", "content_sanskrit": "अन्ये तु ये त्वाऽनु नृशंसमज्ञा यद्युद्यतास्‍त्राः प्रहरन्ति मह्यम्।\nतैर्भूतनाथं सगणं निशातत्रिशूलनिर्भिन्नगलैर्यजामि॥ ६/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.020.m4a", "display_order": 21}, {"id": 6000130021, "chapter_id": 10130, "verse_number": "६-११-१८", "content_sanskrit": "अथो हरे मे कुलिशेन वीर हर्ता प्रमथ्येह शिरो यदीह।\nतत्रानृणो भूतबलिं विधाय मनस्विनां पादरजः प्रपत्स्ये॥ ६/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.021.m4a", "display_order": 22}, {"id": 6000130022, "chapter_id": 10130, "verse_number": "६-११-१९", "content_sanskrit": "सुरेश कस्मान्न हिनोषि वज्रं पुरःस्थिते वैरिणि मय्यमोघम्।\nमा संशयिष्ठा भगदेव वज्रं स्यान्निष्फलं कृपणार्थेव याञ्चा॥ ६/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.022.m4a", "display_order": 23}, {"id": 6000130023, "chapter_id": 10130, "verse_number": "६-११-२०", "content_sanskrit": "नन्वेष वज्रस्तव शक्र तेजसा हरेर्दधीचेस्तपसा च तेजितः।\nतेनैव शत्रुं जहि विष्णुयन्त्रितो यतो हरिर्विजयः श्रीर्गुणास्ततः॥ ६/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.023.m4a", "display_order": 24}, {"id": 6000130024, "chapter_id": 10130, "verse_number": "६-११-२१", "content_sanskrit": "अहं समाधाय मनो यथाऽऽह सङ्कर्षणस्तच्चरणारविन्दे।\nत्वद्वज्ररंहोलुलितग्राम्यपाशो गतिं मुनेर्याम्यपविद्धलोकः॥ ६/११/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.024.m4a", "display_order": 25}, {"id": 6000130025, "chapter_id": 10130, "verse_number": "६-११-२२", "content_sanskrit": "पुंसां किलैकान्तधियां स्वकानां याः संपदो दिवि भूमौ रसायाम्।\nन राति यस्माद् भयमुद्वेग आधिर्मदः कलिर्व्यसनं सम्प्रयासः॥ ६/११/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.025.m4a", "display_order": 26}, {"id": 6000130026, "chapter_id": 10130, "verse_number": "६-११-२३", "content_sanskrit": "त्रैवर्गिकायासविघातमस्मत्पतिर्विधत्ते पुरुषस्य शक्र।\nतेनानुमेयो भगवत्प्रसादो यो दुर्लभोऽकिञ्चनगोचरोऽन्यैः॥ ६/११/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.026.m4a", "display_order": 27}, {"id": 6000130027, "chapter_id": 10130, "verse_number": "६-११-२४", "content_sanskrit": "अहं हरे तव पादैकमूलदासानुदासो भविताऽस्मि भूयः।\nमनः स्मरेतात्मपतेर्गुणान् नो, गृणीत वाक्, कर्म करोतु कायः॥ ६/११/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.027.m4a", "display_order": 28}, {"id": 6000130028, "chapter_id": 10130, "verse_number": "६-११-२५", "content_sanskrit": "न नाकपृष्ठं न च पारमेष्ठ्यं न सार्वभौमं न रसाधिपत्यम्।\nन योगसिद्धीरपुनर्भवं वा समञ्जसं त्वां विरहय्य काङ्क्षे॥ ६/११/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.028.m4a", "display_order": 29}, {"id": 6000130029, "chapter_id": 10130, "verse_number": "६-११-२६", "content_sanskrit": "अजातपक्षा इव मातरं खगाः स्तन्यं यथा वत्सतराः क्षुधाऽऽर्ताः।\nप्रियं प्रियेवाध्युषितं विषण्णा मनोऽरविन्दाक्ष दिदृक्षते त्वाम्॥ ६/११/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.029.m4a", "display_order": 30}, {"id": 6000130030, "chapter_id": 10130, "verse_number": "६-११-२७", "content_sanskrit": "ममोत्तमश्लोकजनेषु सख्यं संसारचक्रे भ्रमतः स्वकर्मभिः।\nत्वन्माययाऽऽत्मात्मजदारगेहेष्वासक्तचित्तेषु न नाथ भूयात्॥ ६/११/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_011/BhP_06.011.030.m4a", "display_order": 31}, {"id": 6000130031, "chapter_id": 10130, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]