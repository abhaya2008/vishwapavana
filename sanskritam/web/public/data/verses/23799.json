[{"id": 7003799000, "chapter_id": 23799, "verse_number": "२-२-४३-१", "content_sanskrit": "जैमिनिरुवाच ।\nफाल्गुने मासि कुर्वीत दोलारोहणमुत्तमम् ।\nयत्र क्रीडति गोविंदो लोकानुग्रहणाय वै ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003799001, "chapter_id": 23799, "verse_number": "२-२-४३-२", "content_sanskrit": "प्रत्यर्चां देवदेवस्य गोविंदाख्यां तु कारयेत् ।\nप्रासादपुरतः कुर्यात्षोडश स्तंभमुच्छ्रितम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003799002, "chapter_id": 23799, "verse_number": "२-२-४३-३", "content_sanskrit": "चतुरस्रं चतुर्द्वारं मण्डपं वेदिकान्वितम् ।\nचारुचंद्रातपं माल्यचामरध्वजशोभितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003799003, "chapter_id": 23799, "verse_number": "२-२-४३-४", "content_sanskrit": "भद्रासनं वेदिकायां श्रीपर्णीकाष्ठनिर्मितम् ।\nफल्गूत्सवं प्रकुर्वीत पञ्चाहानि त्र्यहाणि वा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003799004, "chapter_id": 23799, "verse_number": "२-२-४३-५", "content_sanskrit": "फाल्गुन्यां पूर्वतो विप्राश्चतुर्दश्यां निशामुखे ।\nवह्न्युत्सवं प्रकुर्वीत दोलामण्डपपूर्वतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003799005, "chapter_id": 23799, "verse_number": "२-२-४३-६", "content_sanskrit": "गोविंदानुगृहीतं तु यात्रांगं तत्प्रकीर्तितम् ।\nआचार्यवरणं कृत्वा वह्निं निर्मथनोद्भवम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003799006, "chapter_id": 23799, "verse_number": "२-२-४३-७", "content_sanskrit": "भूमिं संस्कृत्य विधिवत्तृणराशिं महोच्छ्रयम् ।\nसुसमं कारयित्वा तु वह्निं तत्र विनिक्षिपेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003799007, "chapter_id": 23799, "verse_number": "२-२-४३-८", "content_sanskrit": "पूजयित्वा विधानेन कूष्मांडविधिना हुनेत् ।\nगोविंदं पूजयित्वा तु भ्रामयेत्स तत विभुम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003799008, "chapter_id": 23799, "verse_number": "२-२-४३-९", "content_sanskrit": "यत्नात्तं रक्षयेद्वह्निं यावद्यात्रा समाप्यते ।\nप्रातर्यामे चतुर्दश्यां गोविंदप्रतिमां शुभाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003799009, "chapter_id": 23799, "verse_number": "२-२-४३-१०", "content_sanskrit": "वासयित्वा हरेरग्रे पूजयेत्पुरुषोत्तमम् ।\nउपचारावशिष्टैस्तु प्रत्यर्चामपि पूजयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003799010, "chapter_id": 23799, "verse_number": "२-२-४३-११", "content_sanskrit": "ततोऽवरोप्य वसनं मालां च द्विजसत्तमाः ।\nअर्चायां विन्यसेन्मंत्री परं ज्योतिर्विभावयन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003799011, "chapter_id": 23799, "verse_number": "२-२-४३-१२", "content_sanskrit": "ततः सा प्रतिमा साक्षाज्जायते पुरुषोत्तमः ।\nरत्नांदोलिकया तां वै नयेत्स्नानस्य मंडपम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003799012, "chapter_id": 23799, "verse_number": "२-२-४३-१३", "content_sanskrit": "तत्र नाना तूर्यनादैः शंखध्वनिपुरःसरम् ।\nजयशब्दैस्तथा स्तोत्रैः पुष्पवृष्टिभिरेव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003799013, "chapter_id": 23799, "verse_number": "२-२-४३-१४", "content_sanskrit": "छत्रध्वजपताकाभिश्चामरैर्व्यजनैस्तथा ।\nनिरंतरं दीपिकाभिस्तदा कुर्यान्महोत्सवम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003799014, "chapter_id": 23799, "verse_number": "२-२-४३-१५", "content_sanskrit": "आगच्छंति तदा देवाः पितामहपुरोगमाः ।\nद्रष्टुं चर्षिगणैः सार्द्धं गोविंदस्य महोत्सवम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003799015, "chapter_id": 23799, "verse_number": "२-२-४३-१६", "content_sanskrit": "भद्रासनेऽधिवास्यैव पूजयेदुपचारकैः ।\nमहास्नानस्य विधिना स्नपनं तस्य कारयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003799016, "chapter_id": 23799, "verse_number": "२-२-४३-१७", "content_sanskrit": "पंचामृतैश्च सर्वैश्च तेषामन्यतमेन वा ।\nस्नानांते गंधतोयेन श्रीसूक्तेनाभिषेचयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003799017, "chapter_id": 23799, "verse_number": "२-२-४३-१८", "content_sanskrit": "संप्रोक्ष्य भूषयेद्देवं वस्त्रालंकारमाल्यकैः ।\nनीराजयित्वा संपूज्य प्रासादं परिवेष्टयेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003799018, "chapter_id": 23799, "verse_number": "२-२-४३-१९", "content_sanskrit": "सप्तकृत्वस्ततो देवं दोलामंडपमानयेत् ।\nसुसंस्कृतायां रथ्यायां पताकातोरणादिभिः ।\nअधोदेशे मंडपं तं सप्तशो भ्रामयेत्पुनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003799019, "chapter_id": 23799, "verse_number": "२-२-४३-२०", "content_sanskrit": "ऊर्द्ध्वदेशे पुनः सप्त स्तंभवेद्यां च सप्त वै ।\nयात्रावसाने च पुनर्भ्रामयेदेकविंशतिम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003799020, "chapter_id": 23799, "verse_number": "२-२-४३-२१", "content_sanskrit": "इयं लीला भगवतः पितामहमुखेरिता ।\nराजर्षिणेंद्रद्युम्नेन कारिता पूर्वमेव हि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003799021, "chapter_id": 23799, "verse_number": "२-२-४३-२२", "content_sanskrit": "फलपुष्पोपनम्रैश्च शाखिभिः परिकल्पिते ।\nवृंदावनांतरे रम्ये मत्तभ्रमरराविणि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003799022, "chapter_id": 23799, "verse_number": "२-२-४३-२३", "content_sanskrit": "कोकिलारावमधुरे नानापक्षिगणाकुले ।\nनानोपशोभारचितनानागुरुसुधूपिते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003799023, "chapter_id": 23799, "verse_number": "२-२-४३-२४", "content_sanskrit": "प्रफुल्लकेतकीषंडगंधामोदिदिगंतरे ।\nमल्लिकाशोकपुन्नागचंपकैरुपशोभिते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003799024, "chapter_id": 23799, "verse_number": "२-२-४३-२५", "content_sanskrit": "तत्काननांतर्घटिते मंडपे चारुतोरणे ।\nभूषिते माल्यवसनचामरैरुपशोभिते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003799025, "chapter_id": 23799, "verse_number": "२-२-४३-२६", "content_sanskrit": "रत्नखट्वांदोलिकायां तन्मध्ये वासयेत्प्रभुम् ।\nसद्रत्नमुकुटं तारहारशोभितवक्षसम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003799026, "chapter_id": 23799, "verse_number": "२-२-४३-२७", "content_sanskrit": "अनर्घ्यरत्नघटितकुंडलोद्भासितश्रुतिम् ।\nयथास्थानं यथाशोभं दिव्यालंकारमंजुलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003799027, "chapter_id": 23799, "verse_number": "२-२-४३-२८", "content_sanskrit": "विकचांबुजमध्यस्थं विश्वधात्र्या श्रिया युतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003799028, "chapter_id": 23799, "verse_number": "२-२-४३-२९", "content_sanskrit": "शंखचक्रगदापद्मधारिणं वनमालिनम् ।\nसुप्रसन्नं सुनासं तं पीनवक्षःस्थलोज्ज्वलम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003799029, "chapter_id": 23799, "verse_number": "२-२-४३-३०", "content_sanskrit": "पुरो व्योमस्थितैर्देवैर्ब्रह्माद्यैर्नतमस्तकैः ।\nकृतांजलिपुटैर्भक्त्या जयशब्दैरभिष्टुतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003799030, "chapter_id": 23799, "verse_number": "२-२-४३-३१", "content_sanskrit": "गंधर्वैरप्सरोभिश्च किन्नरैः सिद्धचारणैः ।\nहाहाहूहूप्रभृतिभिः सत्वरं दिव्यगायनैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003799031, "chapter_id": 23799, "verse_number": "२-२-४३-३२", "content_sanskrit": "अहंपूर्विकया नृत्यगीतवादित्रकारिभिः ।\nनेत्रांबुजसहस्रैश्च पूज्यमानं मुदान्वितैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003799032, "chapter_id": 23799, "verse_number": "२-२-४३-३३", "content_sanskrit": "किरद्भिः सर्वतोदिक्षु गंधचंदनजं रजः ।\nउपवेश्याथ गोविंदं पूजयेदुपचारकैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003799033, "chapter_id": 23799, "verse_number": "२-२-४३-३४", "content_sanskrit": "बल्लवीवृंदमध्यस्थं कदंबतरुमूलगम् ।\nहावहास्यविलासैश्च क्रीडमानं वनांतरे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003799034, "chapter_id": 23799, "verse_number": "२-२-४३-३५", "content_sanskrit": "गोपीभिश्चैव गोपालैर्लीलांदोलितयानगम् ।\nचिंतयित्वा जगन्नाथं विकिरेद्गंधचूर्णकैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003799035, "chapter_id": 23799, "verse_number": "२-२-४३-३६", "content_sanskrit": "सकर्पूरै रक्तपीतशुक्लैर्दिक्षु समंततः ।\nदिव्यैर्वस्त्रैर्दिव्यमाल्यैर्द्दिव्यैर्गंधैः सुधूपकैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003799036, "chapter_id": 23799, "verse_number": "२-२-४३-३७", "content_sanskrit": "चामरांदोलनैर्गीतैः स्तुतिभिश्च समर्चितम् ।\nआंदोलयेद्दोलिकास्थं सप्तवाराञ्छनैः शनैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003799037, "chapter_id": 23799, "verse_number": "२-२-४३-३८", "content_sanskrit": "तदा पश्यंति ये कृष्णं मुक्तिस्तेषां न संशयः ।\nब्रह्महत्यादिपापानां पंचकानां क्षयो भवेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003799038, "chapter_id": 23799, "verse_number": "२-२-४३-३९", "content_sanskrit": "त्रिरेवं दोलयेद्देवं सर्वपापापनोदनम् ।\nभक्त्यानुग्राहकं पुंसां भुक्तिमुक्त्येककारणम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003799039, "chapter_id": 23799, "verse_number": "२-२-४३-४०", "content_sanskrit": "लीलाविचेष्टितं यस्य कृत्रिमं सहजं तथा ।\nअंहःसंघक्षयकरं मूलाविद्यानिवर्त्तकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003799040, "chapter_id": 23799, "verse_number": "२-२-४३-४१", "content_sanskrit": "पश्यन्द्वितीयं हरति गोहत्याद्युपपातकम् ।\nहरत्यशेषपापानि तृतीये नात्र संशयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003799041, "chapter_id": 23799, "verse_number": "२-२-४३-४२", "content_sanskrit": "दृष्ट्वा दोलायितं देवं सर्वपापैः प्रमुच्यते ।\nआध्यात्मिकैराधिभौतैराधिदैवैर्विमुच्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003799042, "chapter_id": 23799, "verse_number": "२-२-४३-४३", "content_sanskrit": "इमां यात्रां कारयित्वा चक्रवर्ती भवेन्नृपः ।\nब्राह्मणस्तु चतुर्वेदी ज्ञानवाञ्जायते ध्रुवम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003799043, "chapter_id": 23799, "verse_number": "२-२-४३-४४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये दोलारोहणंनाम त्रयश्चत्वारिंशोऽध्यायः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]