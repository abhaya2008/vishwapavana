[{"id": 6000313000, "chapter_id": 10313, "verse_number": null, "content_sanskrit": "द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000313001, "chapter_id": 10313, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.001.m4a", "display_order": 2}, {"id": 6000313002, "chapter_id": 10313, "verse_number": "११-१२-१", "content_sanskrit": "न रोधयति मां योगो न साङ्ख्यं धर्म एव च।\nन स्वाध्यायस्तपस्त्यागो नेष्टापूर्ते न दक्षिणाः॥ ११/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.002.m4a", "display_order": 3, "topics": [{"text": "कृष्णेनोद्धवं प्रति सत्सङ्गमहिमकथनम्", "range": "१–१६"}]}, {"id": 6000313003, "chapter_id": 10313, "verse_number": "११-१२-२", "content_sanskrit": "व्रतानि यज्ञाश्छन्दांसि तीर्थानि नियमा यमाः।\nयथाऽवरुन्धेन्मत्सङ्गः सर्वदुःखापहो हि माम्॥ ११/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.003.m4a", "display_order": 4}, {"id": 6000313004, "chapter_id": 10313, "verse_number": "११-१२-३", "content_sanskrit": "मत्सङ्गेन तु दैतेया यातुधाना मृगाः खगाः।\nगन्धर्वाप्सरसो नागाः सिद्धाश्चारणगुह्यकाः॥ ११/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.004.m4a", "display_order": 5}, {"id": 6000313005, "chapter_id": 10313, "verse_number": "११-१२-४", "content_sanskrit": "विद्याधरा मनुष्येषु वैश्याः शूद्राः स्‍त्रियोऽन्त्यजाः।\nरजस्तमःप्रकृतयस्तस्मिंस्तस्मिन् युगेऽनघ॥ ११/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.005.m4a", "display_order": 6}, {"id": 6000313006, "chapter_id": 10313, "verse_number": "११-१२-५", "content_sanskrit": "बहवो मत्पदं प्राप्ता त्वाष्ट्रकावन्तिकादयः।\nवृषपर्वा बलिर्बाणो मयश्चाथ विभीषणः॥ ११/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.006.m4a", "display_order": 7}, {"id": 6000313007, "chapter_id": 10313, "verse_number": "११-१२-६", "content_sanskrit": "सुग्रीवो हनुमान् ऋक्षो गजो गृध्रो वणिक्पथः।\nव्याधः कुब्जा व्रजे गोप्यो यज्ञपत्न्यस्तथाऽपरे॥ ११/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.007.m4a", "display_order": 8}, {"id": 6000313008, "chapter_id": 10313, "verse_number": "११-१२-७", "content_sanskrit": "ते नाधीतश्रुतिगणा नोपासितमहत्तमाः।\nअव्रतातप्ततपसो मत्सङ्गान्मामुपागताः॥ ११/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.008.m4a", "display_order": 9}, {"id": 6000313009, "chapter_id": 10313, "verse_number": "११-१२-८", "content_sanskrit": "केवलेन हि भावेन गोप्यो गावः खगा मृगाः।\nयेऽन्ये मूढधियो नागाः सिद्धा मामीयुरञ्जसा॥ ११/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.009.m4a", "display_order": 10}, {"id": 6000313010, "chapter_id": 10313, "verse_number": "११-१२-९", "content_sanskrit": "यं न योगेन सांख्येन दानव्रततपोऽध्वरैः।\nव्याख्यास्वाध्यायसंन्यासैः प्राप्नुयाद् यत्नवानपि॥ ११/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.010.m4a", "display_order": 11}, {"id": 6000313011, "chapter_id": 10313, "verse_number": "११-१२-१०", "content_sanskrit": "रामेण सार्धं मधुरां प्रणीते श्वाफल्किना मय्यनुरक्तचित्ताः।\nविगाढभावेन न मे वियोगतीव्राधयोऽन्यद् ददृशुः सुखाय ताः॥ ११/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.011.m4a", "display_order": 12}, {"id": 6000313012, "chapter_id": 10313, "verse_number": "११-१२-११", "content_sanskrit": "यासां क्षपाः प्रेष्ठतमेन नीता मयैव वृन्दावनगोचरेण।\nक्षणार्धवत् ताः पुनरङ्ग तासां हीना मया कल्पसमा बभूवुः॥ ११/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.012.m4a", "display_order": 13}, {"id": 6000313013, "chapter_id": 10313, "verse_number": "११-१२-१२", "content_sanskrit": "ता नाविदन् मय्यनुषङ्गबद्धधियः स्वमात्मानमदस्तथेदम्।\nयथा समाधौ मुनयोऽब्धितोये नद्यः प्रविष्टा इव नामरूपे॥ ११/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.013.m4a", "display_order": 14}, {"id": 6000313014, "chapter_id": 10313, "verse_number": "११-१२-१३", "content_sanskrit": "मत्कामा रमणं जारं मत्स्वरूपाविदोऽबलाः।\nब्रह्म मां परमं प्रापुः शतशोऽथ सहस्रशः॥ ११/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.014.m4a", "display_order": 15}, {"id": 6000313015, "chapter_id": 10313, "verse_number": "११-१२-१४", "content_sanskrit": "तस्मात् त्वमुद्धवोत्सृज्य चोदितां प्रति चोदनाम्।\nप्रवृत्तं च निवृत्तं च श्रोतव्यं श्रुतमेव च॥ ११/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.015.m4a", "display_order": 16}, {"id": 6000313016, "chapter_id": 10313, "verse_number": "११-१२-१५", "content_sanskrit": "मामेकमेव शरणमात्मानं सर्वदेहिनाम्।\nयाहि सर्वात्मभावेन यस्मिन्नस्त्यकुतोभयम्॥ ११/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.016.m4a", "display_order": 17}, {"id": 6000313017, "chapter_id": 10313, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.017.m4a", "display_order": 18}, {"id": 6000313018, "chapter_id": 10313, "verse_number": "११-१२-१६", "content_sanskrit": "संशयः शृण्वतो वाचं तव योगेश्वरेश्वर।\nन निवर्तत आत्मस्थो येन भ्राम्यति मे मनः॥ ११/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.018.m4a", "display_order": 19}, {"id": 6000313019, "chapter_id": 10313, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.019.m4a", "display_order": 20}, {"id": 6000313020, "chapter_id": 10313, "verse_number": "११-१२-१७", "content_sanskrit": "य एष जीवो विवरप्रसूतिः प्राणेन घोषेण गुहां प्रविष्टः।\nमनोमयं सूक्ष्ममुपैति रूपं मात्रा स्वरो वर्ण इति स्थविष्ठम्॥ ११/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.020.m4a", "display_order": 21, "topics": [{"text": "जगद्वृक्षादिवर्णनम्", "range": "१७–२४"}]}, {"id": 6000313021, "chapter_id": 10313, "verse_number": "११-१२-१८", "content_sanskrit": "यथाऽनलः खेऽनिलबन्धुरूष्मा बलेन दारुण्यधिमथ्यमानः।\nअणुः प्रजातो हविषा समिद्ध्यते तथैव मे व्यक्तिरियं हि वाणी॥ ११/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.021.m4a", "display_order": 22}, {"id": 6000313022, "chapter_id": 10313, "verse_number": "११-१२-१९", "content_sanskrit": "एवं गतिः कर्म रतिर्विसर्गो घ्राणो रसो दृक् स्पर्शः श्रुतिश्च।\nसङ्कल्पविज्ञानमथाभिमानः सूत्रं रजः सत्त्वतमो विकारः॥ ११/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.022.m4a", "display_order": 23}, {"id": 6000313023, "chapter_id": 10313, "verse_number": "११-१२-२०", "content_sanskrit": "अयं हि जीवस्‍त्रिवृदब्जयोनिरव्यक्त एको जगतां यथाऽऽद्यः।\nविश्लिष्टशक्तिर्बहुधैव भाति बीजानि योनिं प्रतिपद्य यद्वत्॥ ११/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.023.m4a", "display_order": 24}, {"id": 6000313024, "chapter_id": 10313, "verse_number": "११-१२-२१", "content_sanskrit": "यस्मिन्निदं प्रोतमशेषमोतं पटे यथा तन्तुवितानसंस्था।\nय एष संसारतरुः पुराणः कर्मात्मकः पुष्पफले प्रसूते॥ ११/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.024.m4a", "display_order": 25}, {"id": 6000313025, "chapter_id": 10313, "verse_number": "११-१२-२२", "content_sanskrit": "द्वे अस्य बीजे शतमूलस्‍त्रिनालः पञ्चस्कन्धः पञ्चरसप्रसूतिः।\nदशैकशाखो द्विसुपर्णनीडस्‍त्रिवल्कलो द्विफलः खं प्रविष्टः॥ ११/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.025.m4a", "display_order": 26}, {"id": 6000313026, "chapter_id": 10313, "verse_number": "११-१२-२३", "content_sanskrit": "अदन्ति चैकं फलमस्य गृध्रा ग्रामेचरा एकमरण्यवासाः।\nहंसा य एवं बहुरूपमिष्टं मायामयं वेद स वेद वेदम्॥ ११/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.026.m4a", "display_order": 27}, {"id": 6000313027, "chapter_id": 10313, "verse_number": "११-१२-२४", "content_sanskrit": "एवं गुरूपासनयैकभक्त्या विद्याकुठारेण शितेन धीरः।\nविवृश्च्य जीवाशयमप्रमत्तः सम्पद्य चात्मानमथ त्यजास्‍त्रम्॥ ११/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_012/BhP_11.012.027.m4a", "display_order": 28}, {"id": 6000313028, "chapter_id": 10313, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे द्वादशाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]