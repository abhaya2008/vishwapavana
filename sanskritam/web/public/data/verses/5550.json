[{"id": 2213182, "chapter_id": 5550, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213183, "chapter_id": 5550, "verse_number": "१", "content_sanskrit": "नारदस्य तु तद्वाक्यं प्रशशंसुर्द्विजोत्तमाः ।\nशतयूपस्तु राजर्षिर्नारदं वाक्यमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213184, "chapter_id": 5550, "verse_number": "", "content_sanskrit": "शतयूपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213185, "chapter_id": 5550, "verse_number": "२", "content_sanskrit": "अहो भगवता राज्ञः प्रीतिरस्य विवर्धिता ।\nसर्वस्य च जनस्यास्य मम चैव महाद्युते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213186, "chapter_id": 5550, "verse_number": "३", "content_sanskrit": "अस्ति काचिद्विवक्षा तु मम तां गदतः शृणु ।\nधृतराष्ट्रं प्रति नृपं देवर्षे लोकपूजितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213187, "chapter_id": 5550, "verse_number": "४", "content_sanskrit": "लोकवृत्तान्ततत्त्वज्ञो भवान् दिव्येन चक्षुषा ।\nयुक्तः पश्यतु देवर्षे गतयो विविधा नृणाम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213188, "chapter_id": 5550, "verse_number": "५", "content_sanskrit": "उक्तवान् नृपतीशान् त्वं महेन्द्रसमलोकगान् ।\nन त्वस्य नृपतेर्लोकाः कथितास्ते महामुने\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213189, "chapter_id": 5550, "verse_number": "६", "content_sanskrit": "स्थानमस्य क्षितिपतेः श्रोतुमिच्छाम्यहं विभो ।\nत्वत्तः कीदृक् कदा चेति तन्ममाचक्ष्व पृच्छतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213190, "chapter_id": 5550, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213191, "chapter_id": 5550, "verse_number": "७", "content_sanskrit": "इत्युक्तो नारदस्तेन वाक्यं सर्वमनोनुगम् ।\nव्याजहार सतां मध्ये दिव्यदर्शी महातपाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213192, "chapter_id": 5550, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213193, "chapter_id": 5550, "verse_number": "८", "content_sanskrit": "यदृच्छया शक्रसदो गत्वा शक्रं शचीपतिम् ।\nदृष्टवानस्मि राजेन्द्र तत्र पाण्डुं नृपं तदा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213194, "chapter_id": 5550, "verse_number": "९", "content_sanskrit": "तत्रेयं धृतराष्ट्रस्य कथा समभवन्नृप ।\nतपसो दुश्चरस्यास्य यदयं तप्स्यते नृपः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213195, "chapter_id": 5550, "verse_number": "१०", "content_sanskrit": "तत्राहमिदमश्रौषं शक्रस्य वदतो दिवि ।\nवर्षाणि त्रीणि शिष्टानि राज्ञोऽस्य परमायुषः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213196, "chapter_id": 5550, "verse_number": "११", "content_sanskrit": "ततः कुबेरभवनं गान्धारीसहितो नृपः ।\nविहर्ता धृतराष्ट्रोऽयं राजराजाभिपूजितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213197, "chapter_id": 5550, "verse_number": "१२", "content_sanskrit": "कामगेन विमानेन दिव्याभरणभूषितः ।\nऋषिपुत्रो महाभागस्तपसा दग्धकिल्बिषः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213198, "chapter_id": 5550, "verse_number": "१३", "content_sanskrit": "सञ्चरिष्यति लोकांश्च देवगन्धर्वरक्षसाम् ।\nस्वच्छन्देनेति धर्मात्मा व्यासस्य तु तपोबलात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213199, "chapter_id": 5550, "verse_number": "१४", "content_sanskrit": "देवगुह्यमिदं प्रीत्या मया वः कथितं महत् ।\nभवन्तो हि श्रुतधनास्तपसा दग्धकिल्बिषाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213200, "chapter_id": 5550, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213201, "chapter_id": 5550, "verse_number": "समाप्तिः", "content_sanskrit": "इति ते तस्य तच्छ्रुत्वा देवर्षेर्मधुरं वचः ।\nसर्वे सुमनसः प्रीता बभूवुः स च पार्थिवः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213202, "chapter_id": 5550, "verse_number": "", "content_sanskrit": "(एवं कथाभिरन्वास्य धृतराष्ट्रं मनीषिणम् ।\nविप्रजग्मुर्यथाकामं ते सिद्धगतिमास्थिताः\t॥१६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213203, "chapter_id": 5550, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि नारदवचनं नाम षड्विंशोऽध्यायः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213204, "chapter_id": 5550, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि षड्विंशोऽध्यायः ॥२६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]