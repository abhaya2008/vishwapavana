[{"id": 900008094, "chapter_id": 8617, "verse_number": "8.1", "content_sanskrit": "सर्ववैलक्षण्याङ्गीकाराद्दुर्घटमपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008095, "chapter_id": 8617, "verse_number": "8.2", "content_sanskrit": "सर्ववैलक्षण्याङ्गीकाराद्दुर्घटमपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008096, "chapter_id": 8617, "verse_number": "8.3", "content_sanskrit": "जगतो भिन्नमभिन्नं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008097, "chapter_id": 8617, "verse_number": "8.4", "content_sanskrit": "यद्येवमपि नानिर्वचनीयत्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008098, "chapter_id": 8617, "verse_number": "8.5", "content_sanskrit": "‘‘विश्वं सत्य’’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008099, "chapter_id": 8617, "verse_number": "8.6", "content_sanskrit": "‘विश्वं सत्यम्’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008100, "chapter_id": 8617, "verse_number": "8.7", "content_sanskrit": "न हि दृष्टेर्बलवत्किञ्चित्प्रमाणम्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008101, "chapter_id": 8617, "verse_number": "8.8", "content_sanskrit": "न हि युक्तिपराजितोऽपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008102, "chapter_id": 8617, "verse_number": "8.9", "content_sanskrit": "बलवद्दृष्ट्यबाधे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008103, "chapter_id": 8617, "verse_number": "8.10", "content_sanskrit": "न चान्नत्वे दुर्घटे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008104, "chapter_id": 8617, "verse_number": "8.11", "content_sanskrit": "न चान्नानन्नवैलक्षण्यमनुभूयते..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008105, "chapter_id": 8617, "verse_number": "8.12", "content_sanskrit": "अतो विशिष्टादिनिराकरणयुक्तीनामपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]