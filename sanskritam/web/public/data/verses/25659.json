[{"id": 7005659000, "chapter_id": 25659, "verse_number": "१३२-१", "content_sanskrit": "दानवानामुपद्रवं दृष्ट्वा देवैः ब्रह्मसमीपे गमनम् ।\nसूत उवाच ।\nअशीलेषु प्रदुष्टेषु दानवेषु दुरात्मसु ।\nलोकेषूत्साद्यमानेषु तपोधनवनेषु च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005659001, "chapter_id": 25659, "verse_number": "१३२-२", "content_sanskrit": "सिंहनादे व्योमगानान्तेषु भीतेषु जन्तुषु ।\nत्रैलोक्ये भयसम्मूढे तमोन्धत्वमुपागते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005659002, "chapter_id": 25659, "verse_number": "१३२-३", "content_sanskrit": "आदित्या वसवः साध्याः पितरो मरुताङ्गणाः ।\nभीताः शरणमाजग्युर्ब्रह्माणं प्रपितामहम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005659003, "chapter_id": 25659, "verse_number": "१३२-४", "content_sanskrit": "ते तं स्वर्णोत्पलासीनं ब्रह्माणं समुपागताः ।\nनेमुरूचुश्च सहिताः पञ्चास्यं चतुराननम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005659004, "chapter_id": 25659, "verse_number": "१३२-५", "content_sanskrit": "वरगुप्तास्तवैवेह दानवास्त्रिपुरालयाः ।\nबाधन्तेऽस्मान्यथाप्रेष्याननुशाधि ततोऽनघ! ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005659005, "chapter_id": 25659, "verse_number": "१३२-६", "content_sanskrit": "मेधागमे यथा हंसा मृगाः सिंहभयादिव ।\nदानवानां भयात्तद्वद्बभ्राम प्रपितामहः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005659006, "chapter_id": 25659, "verse_number": "१३२-७", "content_sanskrit": "पुत्राणां नामधेयानि कलत्राणां तथैव च ।\nदानवैर्भ्राम्यमाणानां विस्तृतानि ततोऽनघ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005659007, "chapter_id": 25659, "verse_number": "१३२-८", "content_sanskrit": "देववेश्मप्रभङ्गाश्च आश्रमभ्रंशनानि च ।\nदानवैर्लोभमोहान्धैः क्रियन्ते च भ्रमन्ति च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005659008, "chapter_id": 25659, "verse_number": "१३२-९", "content_sanskrit": "यदि न त्रायसे लोकं दानवैर्विद्रुतं द्रुतम् ।\nधर्षेणानेन निर्देवं निर्मनुष्याश्रमं जगत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005659009, "chapter_id": 25659, "verse_number": "१३२-१०", "content_sanskrit": "इत्येवं त्रिदशैरुक्तः पद्मयोनिः पितामहः ।\nप्रत्याह त्रिदशान् सेन्द्रानिन्दुतुल्याननः प्रभुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005659010, "chapter_id": 25659, "verse_number": "१३२-११", "content_sanskrit": "मयस्य यो वरो दत्तो मया मतिमताम्वराः! ।\nतस्यान्त एष सम्प्राप्तो यः पुरोक्तो मया सुराः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005659011, "chapter_id": 25659, "verse_number": "१३२-१२", "content_sanskrit": "तच्च तेषामधिष्ठानं त्रिपुरं त्रिदशर्षभाः ।\nएतेषु पातमोक्षेण हन्तव्यं नेषुवृष्टिभिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005659012, "chapter_id": 25659, "verse_number": "१३२-१३", "content_sanskrit": "भवताञ्च न पश्यामि कमप्यत्र सुरर्षभाः ।\nयस्तु चैकप्रहारेण पुरं हन्यात् सदानवम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005659013, "chapter_id": 25659, "verse_number": "१३२-१४", "content_sanskrit": "त्रिपुरं नाल्पवीर्येण शक्यं हन्तुं शरेण तु ।\nएकं मुक्त्वा महादेवं महेशानं प्रजापतिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005659014, "chapter_id": 25659, "verse_number": "१३२-१५", "content_sanskrit": "ते यूयं यदि अन्ये च क्रतुविध्वंसकं हरम् ।\nयाचामः सहिता देवं त्रिपुरं स हनिष्यति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005659015, "chapter_id": 25659, "verse_number": "१३२-१६", "content_sanskrit": "कृतः पुराणां विष्कम्भो योजनानां शतं शतम् ।\nयथा चैकप्रहारेण हन्यते वैभवेन तु ।\nपुष्पयोगेन युक्तानि तानि चैकक्षणेन तु ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005659016, "chapter_id": 25659, "verse_number": "१३२-१७", "content_sanskrit": "ततो देवैश्च सम्प्रोक्तो यास्याम इति दुःखितैः ।\nपितामहश्च तै सार्द्धं भवसंसदमागतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005659017, "chapter_id": 25659, "verse_number": "१३२-१८", "content_sanskrit": "तं भवं भूतभव्येशं गिरिशं शूलपाणिनम् ।\nपश्यन्ति चोमया सार्द्धन्नन्दिना च महात्मना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005659018, "chapter_id": 25659, "verse_number": "१३२-१९", "content_sanskrit": "अग्निवर्णमजन्देवमग्निकुण्डनिभेक्षणम् ।\nअग्न्यादित्यसहस्राभमग्निवर्णविभूषितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005659019, "chapter_id": 25659, "verse_number": "१३२-२०", "content_sanskrit": "चन्द्रावयवलक्ष्माणं चन्द्रसौम्यवराननम् ।\nआगम्य तमजन्देवमथ तं नीललोहितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005659020, "chapter_id": 25659, "verse_number": "१३२-२१", "content_sanskrit": "स्तुवन्तो वरदं शम्भुं गोपात पार्वतीपतिम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005659021, "chapter_id": 25659, "verse_number": "१३२-२२", "content_sanskrit": "देवा ऊचुः ।\nनमो भगवतेशाय रुद्राय वरदाय च ।\nपशूनाम्पतये नित्यमुग्राय च कपर्दिने ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005659022, "chapter_id": 25659, "verse_number": "१३२-२३", "content_sanskrit": "महादेवाय भीमाय त्र्यम्बकाय च शान्तये ।\nईशानाय भयघ्नाय नमस्त्वन्धकघातिने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005659023, "chapter_id": 25659, "verse_number": "१३२-२४", "content_sanskrit": "नीलग्रीवाय भीमाय वेधसे वेधसास्तुते ।\nकुमारशत्रुनिघ्नाय कुमारजनकाय च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005659024, "chapter_id": 25659, "verse_number": "१३२-२५", "content_sanskrit": "विलोहिताय धूम्राय वराय क्रथनाय च ।\nनित्यं नीलशिखण्डाय शूलिने दिव्यशायिने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005659025, "chapter_id": 25659, "verse_number": "१३२-२६", "content_sanskrit": "उरगाय त्रिनेत्राय हिरण्यवसुरेतसे ।\nअचिन्त्यायाम्बिकाभर्त्रे सर्वदेवस्तुताय च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005659026, "chapter_id": 25659, "verse_number": "१३२-२७", "content_sanskrit": "वृषध्वजाय मुण्डाय जटिने ब्रह्मचारिणे ।\nतप्यमानाय सलिले ब्रह्मण्यायाजिताय च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005659027, "chapter_id": 25659, "verse_number": "१३२-२८", "content_sanskrit": "विश्वात्मने विश्वसृजे विश्वमावृत्य तिष्ठते ।\nनमोऽस्तु दिव्यरूपाय प्रभवे दिव्यशम्भवे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005659028, "chapter_id": 25659, "verse_number": "१३२-२९", "content_sanskrit": "अभिगम्याय काम्याय स्तुत्यायार्च्याय सर्वदा ।\nभक्तानुकम्पिने नित्यं दिशते यन्मनोगतम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]