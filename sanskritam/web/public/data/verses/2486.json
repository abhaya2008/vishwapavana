[{"id": 2070690, "chapter_id": 2486, "verse_number": "११-१८-०x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070691, "chapter_id": 2486, "verse_number": "११-१८-१", "content_sanskrit": "पश्य माधव पुत्रान्मे शतसङ्ख्याञ्जितक्लमान्।\nगदया भीमसेनेन भूयिष्ठं निहतान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070692, "chapter_id": 2486, "verse_number": "११-१८-२", "content_sanskrit": "इदं दुःखतरं मेऽद्य यदिमा मुक्तमूर्धजाः।\nहतपुत्रा रणे बालाः परिधावन्ति मे स्नुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070693, "chapter_id": 2486, "verse_number": "११-१८-३", "content_sanskrit": "प्रासादतलचारिण्यश्चरमैर्भूषणान्वितैः।\nकायेनाद्य स्पृशन्तीमां रुधिरार्द्रां वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070694, "chapter_id": 2486, "verse_number": "११-१८-४", "content_sanskrit": "कृच्छ्रादुत्सारयन्ति स्म गृध्रगोमायुवायसान्।\nदुःखेनार्ता विघूर्णन्त्यो मत्ता इव चरन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070695, "chapter_id": 2486, "verse_number": "११-१८-५", "content_sanskrit": "एषाऽन्या त्वनवद्याङ्गी करसम्मितमध्यमा।\nघोरमायोधनं दृष्ट्वा निपतत्यतिदुःखिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070696, "chapter_id": 2486, "verse_number": "११-१८-६", "content_sanskrit": "दृष्ट्वा मे पार्थिवसुतामेतां लक्ष्मणमातरम्।\nराजपुत्रीं महाबाहो मनो न ह्युपशाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070697, "chapter_id": 2486, "verse_number": "११-१८-७", "content_sanskrit": "भ्रातॄंश्चान्याः पितॄंश्चान्याः पुत्रांश्च निहतान्भुवि।\nदृष्ट्वा परिपतन्त्येषाः प्रगृह्य सुमहाभुजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070698, "chapter_id": 2486, "verse_number": "११-१८-८", "content_sanskrit": "मध्यमानां तु नारीणां वृद्धानां चापराजित।\nआक्रन्दं हतबन्धूना दारुणे वैशसे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070699, "chapter_id": 2486, "verse_number": "११-१८-९", "content_sanskrit": "रथनीडानि देहांश्च हतानां गजवाजिनाम्।\nआश्रित्य श्रममोहार्ताः स्थिताः पश्य महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070700, "chapter_id": 2486, "verse_number": "११-१८-१०", "content_sanskrit": "अन्या चापहृतं कायाच्चारुकुण्डलमुन्नसम्।\nस्वस्य बन्धोः शिरः कृष्ण गृहीत्वा पश्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070701, "chapter_id": 2486, "verse_number": "११-१८-११", "content_sanskrit": "पूर्वजातिकृतं पापं मन्ये नाल्पमिवानघ।\nएताभिर्निरवद्याभिर्मया चैवाल्पपुण्यया।\nयदिदं धर्मराजेन घातितं नो जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070702, "chapter_id": 2486, "verse_number": "११-१८-१२", "content_sanskrit": "न हि नाशोऽस्ति वार्ष्णेय कर्मणोः शुभपापयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070703, "chapter_id": 2486, "verse_number": "११-१८-१३", "content_sanskrit": "प्रत्यग्रवयसः पश्य दर्शनीयकुचाननाः।\nकुलेषु जाता हीमत्यः कृष्णपक्ष्माक्षिमूर्धजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070704, "chapter_id": 2486, "verse_number": "११-१८-१४", "content_sanskrit": "हंसगद्गदभाषिण्यो दुःखशोकप्रमोहिताः।\nसारस्य इव वाशन्त्यः पतिताः पश्य माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070705, "chapter_id": 2486, "verse_number": "११-१८-१५", "content_sanskrit": "फुल्लुपद्यप्रकाशानि पुण्डरीकाक्ष योषिताम्।\nअनवद्यानि वक्त्राणि तापयत्येष रश्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070706, "chapter_id": 2486, "verse_number": "११-१८-१६", "content_sanskrit": "सेर्ष्याणां मम पुत्राणां वासुदेवावरोधनम्।\nमत्तमातङ्गदर्पाणां पश्यन्त्यद्य पृथग्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070707, "chapter_id": 2486, "verse_number": "११-१८-१७", "content_sanskrit": "शतचन्द्राणि चर्माणि ध्वजांश्चादित्यवर्चसः।\nरौक्माणि चैव वर्माणि निष्कानपि च काञ्चनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070708, "chapter_id": 2486, "verse_number": "११-१८-१८", "content_sanskrit": "शिरस्त्राणानि चैतानि पुत्राणां मे महीतले।\nपश्य दीप्तानि गोविन्द पावकान्सुहुतानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070709, "chapter_id": 2486, "verse_number": "११-१८-१९", "content_sanskrit": "एष दुःशासनः शेते शूरेणामित्रघातिना।\nपीतशोणिxx सर्वाङ्गो युधि भीमेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070710, "chapter_id": 2486, "verse_number": "११-१८-२०", "content_sanskrit": "गदया भीमसेनेन पश्य माधव मे सुतम्।\nद्यूतक्लेशाननुस्मृत्य द्रौपदीचोदितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070711, "chapter_id": 2486, "verse_number": "११-१८-२१", "content_sanskrit": "उक्ता ह्यनेन पाञ्चाली सभायां द्यूतनिर्जिता।\nप्रियं चिकीर्षता भ्रातुः कर्णस्य च जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070712, "chapter_id": 2486, "verse_number": "११-१८-२२", "content_sanskrit": "सहैव सहदेवेन नकुलेनार्जुनेन च।\nदासीभूताऽसि पाञ्चालि क्षिप्रं प्रविश नो गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070713, "chapter_id": 2486, "verse_number": "११-१८-२३", "content_sanskrit": "ततोऽहमब्रुवं कृष्ण तदा दुर्योधनं नृपम्।\nमृत्युपाशपरिक्षिप्तां द्रौपदीं पुत्र वर्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070714, "chapter_id": 2486, "verse_number": "११-१८-२४", "content_sanskrit": "निबोधैनं सुदुर्बुद्धिं मातुलं कलहप्रियम्।\nक्षिप्रमेनं परित्यज्य पुत्र संशाम्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070715, "chapter_id": 2486, "verse_number": "११-१८-२५", "content_sanskrit": "न बुद्ध्यसे त्वं दुर्बुद्धे भीमसेनममर्षणम्।\nवाङ्गराचैस्तुदंस्तीक्ष्णैरुल्काभिरिव कुञ्जरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070716, "chapter_id": 2486, "verse_number": "११-१८-२६", "content_sanskrit": "तानेवं रहसि क्रुद्धो वाक्शल्यानवधारयन्।\nउत्ससर्ज विषं तेषु सर्पो गोवृषभेष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070717, "chapter_id": 2486, "verse_number": "११-१८-२७", "content_sanskrit": "एष दुःशासनः शेते विक्षिप्य विपुलौ भुजौ।\nनिहतो भीमसेनेन सिहेनेव महागजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070718, "chapter_id": 2486, "verse_number": "११-१८-२८", "content_sanskrit": "अत्यर्थमकरोद्रौद्रं भीमसेनोऽत्यमर्षणः।\nदुःशासनस्य यत्क्रुद्धोऽपिबच्छोणितमाहवे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070719, "chapter_id": 2486, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि स्त्रीविलापपर्वणि अष्टादशोऽध्यायः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]