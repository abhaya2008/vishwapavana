[{"id": 2123404, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123405, "chapter_id": 3649, "verse_number": "१", "content_sanskrit": "त्रयः किलेमे ह्यधना भवन्ति\nदासः शिष्यश्चास्वतन्त्रा च नारी ।\nत्वं दासपत्नी धनमस्य भद्रे\nहीनेश्वरा दासधनं च दासी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123406, "chapter_id": 3649, "verse_number": "२", "content_sanskrit": "प्रविश्य चाऽन्तः परिचारैर्भजस्व\nतत् ते कार्यं दिष्टमाविश्य वेश्म ।\nईशाश्च सर्वे तव राजपुत्रि\nभवन्ति ते धार्तराष्ट्रा न पार्थाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123407, "chapter_id": 3649, "verse_number": "३", "content_sanskrit": "अन्यं वृणीष्व पतिमाशु भामिनि\nयस्माद् दास्यं न लभसे देवनेन ।\nअनवद्या वै पतिषु कामवृत्तिः\nनित्यं तु दास्ये विहिता वै तवास्तु ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123408, "chapter_id": 3649, "verse_number": "४", "content_sanskrit": "पराजितो नकुलो भीमसेनो युधिष्ठिरः सहदेवोऽर्जुनश्च ।\nदासीभूता प्रविशतु याज्ञसेनि पराजितास्ते पतयो न सन्ति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123409, "chapter_id": 3649, "verse_number": "५", "content_sanskrit": "प्रयोजनं जन्मनि किं नु मन्यते ।\nपराक्रमं चात्मनि चेह पार्थः ।\nपाञ्चाल्यस्य द्रुपदस्यात्मजां त्वां\nसभामध्ये योऽतिदेवीद् ग्लहेषु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123410, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123411, "chapter_id": 3649, "verse_number": "६", "content_sanskrit": "तच्च श्रुत्वा भीमसेनोऽत्यमर्षी\nभृशं निशश्वास तदाऽर्तरूपः ।\nराजानुगो धर्मपाशानुबद्धो\nदहन्निवैनं क्रोधविरक्तचक्षुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123412, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123413, "chapter_id": 3649, "verse_number": "७", "content_sanskrit": "नाहं कुप्ये सूतपुत्राय राजन्\nएतत् सत्यं दासधर्मं प्रविष्टः ।\nकिं विद्विषो वाक्यमाहारयेयुः\nनादेवीस्त्वं यद्यनया नरेन्द्र ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123414, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123415, "chapter_id": 3649, "verse_number": "८", "content_sanskrit": "राधेयस्य वचः श्रुत्वा राजा दुर्योधनस्तदा ।\nयुधिष्ठिरमुवाचेदं तूष्णीम्भूतमचेतनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123416, "chapter_id": 3649, "verse_number": "९", "content_sanskrit": "भीमार्जुनौ यमौ चैव स्थितौ नृपतिशासने ।\nप्रश्नं प्रब्रूहि कृष्णां त्वमजितां यदि मन्यसे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123417, "chapter_id": 3649, "verse_number": "१०", "content_sanskrit": "एवमुक्त्वा स कौन्तेयमपोह्य वसनं स्वकम् ।\nस्मयन्नैक्षत पाञ्चालीमैश्वर्यमदमोहितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123418, "chapter_id": 3649, "verse_number": "११", "content_sanskrit": "कदळीकाण्डसदृशं सर्वलक्षणपूजितम् ।\nगजहस्तप्रतीकाशं वज्रप्रतिमगौरवम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123419, "chapter_id": 3649, "verse_number": "१२", "content_sanskrit": "अभ्युत्स्मयित्वा राधेयं भीममाधर्षयन्निव ।\nद्रौपद्यां प्रेक्षमाणायां सव्यमूरुमदर्शयत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123420, "chapter_id": 3649, "verse_number": "१३", "content_sanskrit": "वृकोदरस्तदालोक्य नेत्रे उत्फाल्य लोहिते ।\nप्रोवाच राजमध्ये तं सभां विश्रावयन्निव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123421, "chapter_id": 3649, "verse_number": "१४", "content_sanskrit": "पितृभिः सह सालोक्यं मा स्म गच्छेद् वृकोदरः ।\nयद्येतमूरुं गदया न भिद्येऽहं महाहवे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123422, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123423, "chapter_id": 3649, "verse_number": "१५", "content_sanskrit": "क्रुद्धस्य तस्य स्रोतोभ्यः निःसृताः पावकार्चिषः ।\nवृक्षस्येव विनिश्चेरुः कोटरेभ्यः प्रदह्यतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123424, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123425, "chapter_id": 3649, "verse_number": "१६", "content_sanskrit": "परं भयं पश्यति भीमसेनाद्\nबुध्यध्वं वै वरुणस्येव पाशात् ।\nदैवेषितो नूनमयं पुरस्तात् ।\nपराभवो भरतेषूदपादि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123426, "chapter_id": 3649, "verse_number": "१७", "content_sanskrit": "अतिद्यूतं कृतमिदं धार्तराष्ट्रैः\nयेऽस्यां स्त्रियां विवदध्वे सभायाम् ।\nयोगक्षेमो दृश्यते नैव नाशं\nपापात्मानः कुरवो मन्त्रयन्ते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123427, "chapter_id": 3649, "verse_number": "१८", "content_sanskrit": "इदं धर्मं कुरवोऽजानताशु\nदुर्दृष्टेऽस्मिन् परिषत् सम्प्रदुष्येत् ।\nइमां च पूर्वं कितवोऽग्रहीष्यद्\nदोषोऽभविष्यन्नपराजितात्मा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123428, "chapter_id": 3649, "verse_number": "१९", "content_sanskrit": "स्वप्ने यथैतद्धि धनं जितं स्यात्\nएवं मन्ये यदि दीव्यत्यनीशः ।\nगान्धारपुत्रस्य वचो निशम्य\nधर्मादस्मात् कुरवो माऽपगात ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2123429, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2123430, "chapter_id": 3649, "verse_number": "२०", "content_sanskrit": "भीमस्य वाक्ये तद्वदेवार्जुनस्य\nस्थितोऽहं वै यमयोश्चैवमेव ।\nयुधिष्ठिरश्चेद् विवदत्यनीशं\nतदा दास्यान्मोक्ष्यते याज्ञसेनी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2123431, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2123432, "chapter_id": 3649, "verse_number": "२१", "content_sanskrit": "ईशो राजा पूर्वमासीद् गृहेशः\nकुन्तीपुत्रो धर्मराजो महात्मा ।\nईशस्त्वयं कस्य पराजितात्मा\nतं जानीध्वं कुरवः सर्व एव ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2123433, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2123434, "chapter_id": 3649, "verse_number": "२२", "content_sanskrit": "दुश्शसन निबोधेदं वचनं मे प्रभाषितम् ।\nकिमनेन चिरं वीर नयस्व द्रुपदात्मजाम् ।\nदासीभावेन भुङ्क्ष्व त्वं यथेष्टं कुरु मानद ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2123435, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2123436, "chapter_id": 3649, "verse_number": "२३", "content_sanskrit": "ततो गान्धारराजस्य पुत्रः शकुनिरब्रवीत् ।\nसाधु कर्ण महाबाहो यथेष्टं क्रियतामिति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2123437, "chapter_id": 3649, "verse_number": "२४", "content_sanskrit": "ततो दुश्शासनस्तूर्णं द्रुपदस्य सुतां बलात् ।\nप्रवेशयितुमारब्धः स चकर्ष दुरात्मवान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2123438, "chapter_id": 3649, "verse_number": "२५", "content_sanskrit": "ततो विक्रोशती वेगात् पाञ्चाली देववर्णिनी ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2123439, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2123440, "chapter_id": 3649, "verse_number": "२६", "content_sanskrit": "परित्रायस्व मां भीष्म द्रोण द्रौणे तथा कृप ।\nपरित्रायस्व विदुर धर्मिष्ठो धर्मवत्सल ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2123441, "chapter_id": 3649, "verse_number": "२७", "content_sanskrit": "धृतराष्ट्र महाराज परित्रायस्व वै स्नुषाम् ।\nगान्धारि त्वं महाभागे सर्वज्ञे धर्मदर्शिनि ।\nपरित्रायस्व मां देवि सुयोधनपराजिताम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2123442, "chapter_id": 3649, "verse_number": "२८", "content_sanskrit": "त्वमार्ये वीरजननि किं मां पश्यसि चापदि ।\nक्लिश्यमानामनार्यैर्मां कि न त्रायसि स्वां वधूम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2123443, "chapter_id": 3649, "verse_number": "समाप्तिः", "content_sanskrit": "इति लालप्यमानां मां न कश्चित् किञ्चिदब्रवीत् ।\nहा हताऽस्मि सुमन्दात्मा सुयोधनवशं गता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2123444, "chapter_id": 3649, "verse_number": "३०", "content_sanskrit": "न वा पाण्डुर्नरपतिर्न धर्मो न च देवराट् ।\nन वायुर्नाश्विनौ वाऽपि परित्रायन्ति वै स्नुषाम् ।\nधिक् कष्टं यदहं जीवे मन्दभाग्या पतिव्रता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2123445, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2123446, "chapter_id": 3649, "verse_number": "३१", "content_sanskrit": "शृणोमि वाक्यं तव राजपुत्रि\nनवै पार्थाः किञ्चिदपि ब्रुवन्ति ।\nसा त्वं प्रियार्थं कुरु वाक्यमेतद्\nयदुच्यते पापमतिः कृतघ्नः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2123447, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "सुयोधनः सानुचरः सुदुष्टः सहैव राज्ञा धिक्कृतसूनुना च ।\nयद्येव वाक्यं महदुच्यमानं न श्रोष्यते पापमतिः सुदुष्टः ॥३२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2123448, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2123449, "chapter_id": 3649, "verse_number": "३३", "content_sanskrit": "इत्येवमुक्त्वा द्रुपदस्य पुत्रीं\nक्षत्ताऽब्रवीद् धृतराष्ट्रस्य पुत्रम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2123450, "chapter_id": 3649, "verse_number": "३४", "content_sanskrit": "मा क्लिश्यतां वै द्रुपदस्य पुत्री\nमा त्वं चारीन् द्रक्ष्यसि राजपुत्र ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2123451, "chapter_id": 3649, "verse_number": "३५", "content_sanskrit": "तमेवमुक्त्वा प्रथमं धृतराष्ट्रमुवाच ह ।\nयद्येवं त्वं महाराज संक्लेशयसि द्रौपदीम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2123452, "chapter_id": 3649, "verse_number": "३६", "content_sanskrit": "अचिरेणैव कालेन पुत्रस्ते सह मन्त्रिभिः ।\nगमिष्यति क्षयं पापः पाण्डवाप्रियकारकः ।\nभीमार्जुनाभ्यां क्रुद्धाभ्यां माद्रीपुत्रद्वयेन च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2123453, "chapter_id": 3649, "verse_number": "३७", "content_sanskrit": "तस्मान्निवारय सुतं मा विनाशं विचिन्तय ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2123454, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2123455, "chapter_id": 3649, "verse_number": "३८", "content_sanskrit": "एतच्छ्रुत्वा मन्दबुद्धिर्नोत्तरं किञ्चिदब्रवीत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2123456, "chapter_id": 3649, "verse_number": "३९", "content_sanskrit": "ततो दुर्योधनस्तत्र दैवमोहबलात्कृतः ।\nअचिन्त्य क्षत्तुर्वचनं हर्षेणायतलोचनः ।\nऊरू दर्शयते पापो द्रौपद्या वै मुहुर्मुहुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2123457, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "द्रोपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2123458, "chapter_id": 3649, "verse_number": "४०", "content_sanskrit": "यस्माच्चोरुं दर्शयसे यस्माच्चोरुं निरीक्षसि ।\nतस्मात् तद्वाप्यधर्मिष्ठ ऊरौ मृत्युर्भविष्यति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2123459, "chapter_id": 3649, "verse_number": "४१", "content_sanskrit": "यस्माच्चैवं क्लेशयति भ्राता ते मां दुरात्मवान् ।\nतस्माद् रुधिरमेवास्य पास्यते वै वृकोदरः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2123460, "chapter_id": 3649, "verse_number": "४२", "content_sanskrit": "इमं च पापिष्ठमतिं कर्णं ससुतबान्धवम् ।\nसामात्यं सपरीवारं हनिष्यति धनञ्जयः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2123461, "chapter_id": 3649, "verse_number": "४३", "content_sanskrit": "क्षुद्रकर्मन् नैकृतिकं शकुनिं पापचेतसम् ।\nसहदेवो रणे क्रुद्धो हनिष्यति सबान्धवम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2123462, "chapter_id": 3649, "verse_number": "४४", "content_sanskrit": "इत्येवमाह वचनं द्रोपदी धर्मदर्शिनी ।\nततोऽन्तरिक्षात् सुमहत् पुष्पवर्षमवापतत् ।\nमूर्ध्न्यदृश्यत पाञ्चाल्याः साधुशब्दश्च सर्वशः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2123463, "chapter_id": 3649, "verse_number": "४५", "content_sanskrit": "तेषां तु वचनं श्रुत्वा नोचुस्तत्र सभासदः ।\nअर्जुनस्य भयाद् राजन्नभून्निश्शब्दमत्र वै ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2123464, "chapter_id": 3649, "verse_number": "४६", "content_sanskrit": "द्रौपद्या वचनं श्रुत्वा चुकोपाथ धनञ्जयः ।\nस तदा क्रोधताम्राक्ष इदं वचनमब्रवीत् ।\nकर्णं हन्तास्मि समरे सपुत्रं सहबान्धवम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2123465, "chapter_id": 3649, "verse_number": "४७", "content_sanskrit": "यस्याश्रयात् स्वयं पापो धार्तराष्ट्रः प्रगर्जति ।\nतं समूलं हनिष्यामि सूतजं बलशाळिनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2123466, "chapter_id": 3649, "verse_number": "४८", "content_sanskrit": "ये चापरे च योत्स्यन्ति धार्तराष्ट्रस्य राजकाः ।\nतान् सर्वान् निहनिष्यामि सत्येनायुधमालभे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2123467, "chapter_id": 3649, "verse_number": "४९", "content_sanskrit": "अद्यैवाहं हनिष्यामि सर्वानेतान् सभासदः ।\nअतीव मन्युर्भवति दृष्ट्वेमां द्रुपदात्मजाम् ।\nकिन्न्वहं वै करिष्यामि यद् राजा सततं घृणी ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2123468, "chapter_id": 3649, "verse_number": "५०", "content_sanskrit": "अद्यैवाऽहं मुहूर्तेन कृत्स्नं नृपतिमण्डलम् ।\nशरैर्नयिष्ये सदनं यमस्यामित्रकर्शनः ।\nअयं तु मां वारयते धर्मराजो युधिष्ठिरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2123469, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2123470, "chapter_id": 3649, "verse_number": "५१", "content_sanskrit": "मा पार्थ साहसं कार्षीर्विनाशं गमयेद् यशः ।\nपापं त्विमं पापमतिं स भवान् हन्तुमुत्सहेत् ।\nत्वमिमं जगतोऽर्थे वै क्रोधं संयच्छ पाण्डव ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2123471, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2123472, "chapter_id": 3649, "verse_number": "५२", "content_sanskrit": "एवमुक्तस्तदा राज्ञा पाण्डवोऽथ धनञ्जयः ।\nक्रोधं संशमयन् पार्थो धार्तराष्ट्रं प्रति स्थितः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2123473, "chapter_id": 3649, "verse_number": "५३", "content_sanskrit": "तस्मिन् वीरे प्रशान्ते तु पाण्डवे फल्गुने ततः ।\nसर्वं प्रहृष्टमभवज्जगत् स्थावरजङ्गमम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2123474, "chapter_id": 3649, "verse_number": "५४", "content_sanskrit": "वारितं च ततो दृष्ट्वा भ्रात्रा पार्थं वृकोदरः ।\nबभूव विमना राजन्नभून्निश्शब्दमत्र वै ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2123475, "chapter_id": 3649, "verse_number": "५५", "content_sanskrit": "ततो राज्ञो धृतराष्ट्रस्य गेहे\nगोमायुरुच्चैर्व्याजहाराग्निहोत्रे ।\nतं रासभाः प्रत्यवदंश्च राजन्\nसमन्ततः पक्षिणश्चैव रौद्राः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2123476, "chapter_id": 3649, "verse_number": "५६", "content_sanskrit": "तं वै शब्दं विदुरस्त्ववेदीत्\nसा चैव देवी सुबलात्मजा च ।\nभीष्मो द्रोणो गौतमश्चापि विद्वान्\nस्वस्ति स्वस्तीत्यब्रुवन् सर्व एव ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2123477, "chapter_id": 3649, "verse_number": "५७", "content_sanskrit": "ततो गान्धारी विदुरश्चैव विद्वान् तमुत्पातं घोरमालक्ष्य राज्ञे ।\nनिवेदयामासतुरार्तवत् तदा ततो राजा वाक्यमिदं बभाषे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2123478, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "हतोऽसि दुर्योधन मन्दबुद्धे यस्त्वं सभायां कुरुपुङ्गवानाम् ।\nस्त्रियं समाकर्षसि दुर्विनीत विशेषतो द्रौपदीं धर्मपत्नीम् ॥५८", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2123479, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "एवमुक्त्वा धृतराष्ट्रो मनीषी हितान्वेषी बान्धवानामपायात् ।\nकृष्णां पाञ्चालीमब्रवीत् सान्त्वपूर्वं विमृश्यैतत् प्रज्ञयाऽमन्दबुद्धिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2123480, "chapter_id": 3649, "verse_number": "६०", "content_sanskrit": "वरं वृणीष्व पाञ्चालि मत्तो यदभिकाङ्क्षसि ।\nवधूनां हि विशिष्टा मे त्वं धर्मपरमा सती ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2123481, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2123482, "chapter_id": 3649, "verse_number": "६१", "content_sanskrit": "ददासि चेद् वरं मह्यं वृणोमि भरतर्षभ ।\nसर्वधर्मानुगः श्रीमानदासोऽस्तु युधिष्ठिरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2123483, "chapter_id": 3649, "verse_number": "६२", "content_sanskrit": "मनस्विनमजानन्तो मैवं ब्रूयुः कुमारकाः ।\nएष वै दासपुत्रेति प्रतिविन्ध्यं ममात्मजम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2123484, "chapter_id": 3649, "verse_number": "६३", "content_sanskrit": "राजपुत्रः पुरा भूत्वा यथा नान्यः पुमान् क्वचित् ।\nलाळितो दासपुत्रत्वं पश्यन् नश्येद्धि भारत ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2123485, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "धृतराष्ट्र", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2123486, "chapter_id": 3649, "verse_number": "६४", "content_sanskrit": "तथास्तु ते महाभागे यथा त्वं नन्दिनीच्छसि ।\nद्वितीयं ते वरं भद्रे ददामि वरयस्व मे ।\nमनो हि मे वितरति नैकं त्वं वरमर्हसि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2123487, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "द्रोपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2123488, "chapter_id": 3649, "verse_number": "६५", "content_sanskrit": "सरथौ सधनुष्कौ च भीमसेनधनञ्जयौ ।\nनकुलः सहदेवश्च द्वितीयं वरये वरम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2123489, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2123490, "chapter_id": 3649, "verse_number": "६६", "content_sanskrit": "एवं भवतु कल्याणि यथा त्वमभिभाषसे ।\nतृतीयं वरयास्मत्तो नासि द्वाभ्यां सुसत्कृता ।\nत्वं हि सर्वस्नुषाणां मे श्रेयसी धर्मचारिणी ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2123491, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2123492, "chapter_id": 3649, "verse_number": "६७", "content_sanskrit": "लोभो धर्मविनाशाय भगवन् नाहमुत्सहे ।\nअनर्हा वरमादातुं तृतीयं राजसत्तम ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2123493, "chapter_id": 3649, "verse_number": "६८", "content_sanskrit": "एकमाहुर्वैश्यवरं द्वौ वरौ क्षत्रियस्त्रियाः ।\nत्रयस्तु राज्ञां राजेन्द्र ब्राह्मणस्य शतं वराः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2123494, "chapter_id": 3649, "verse_number": "६९", "content_sanskrit": "पापीयांस इमे भूत्वा सन्तीर्णाः पतयो मम ।\nवेत्स्यन्ति चैव भद्राणि राजन् पुण्येन कर्मणा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2123495, "chapter_id": 3649, "verse_number": "२३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि एकनवतितमोऽध्यायः ॥९१॥\n॥ द्यूतपर्वणि त्रयोविंशोऽध्यायः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2123496, "chapter_id": 3649, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]