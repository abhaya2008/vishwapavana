[{"id": 7002174000, "chapter_id": 22174, "verse_number": "२१९-१", "content_sanskrit": "पुष्कर उवाच ।\nराजदेवाद्यभिषेकमन्त्रान्वक्ष्येऽघमर्दनान् ।\nकुम्भात्कुशोदकैः सिञ्चेत्तेन सर्वं हि सिद्ध्यति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002174001, "chapter_id": 22174, "verse_number": "२१९-२", "content_sanskrit": "सुरास्त्वामभिषिञ्चन्तु ब्रह्मविष्णुमहेश्वराः ।\nवासुदेवः सङ्कर्षणः प्रद्युम्नश्चानिरुद्धकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002174002, "chapter_id": 22174, "verse_number": "२१९-३", "content_sanskrit": "भवन्तु विजयायैते इन्द्राद्या दशदिग्गताः ।\nरुद्रो धर्मो मनुर्दक्षो रुचिः श्रद्धा च सर्वदा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002174003, "chapter_id": 22174, "verse_number": "२१९-४", "content_sanskrit": "भृगुरत्रिर्वसिष्ठश्च सनकश्च सनन्दनः ।\nसनत्कुमारोऽङ्गिराश्च पुलस्त्यः पुलहः क्रतुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002174004, "chapter_id": 22174, "verse_number": "२१९-५", "content_sanskrit": "मरीचिः कश्यपः पान्तु प्रजेशाः पृथिवीपतिः ।\nप्रभासुरा वहिर्षद अग्निष्वात्ताश्च पान्तु ते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002174005, "chapter_id": 22174, "verse_number": "२१९-६", "content_sanskrit": "क्रव्यादाश्चोपहूताश्च आज्यपाश्च सुकालिनः ।\nअग्निभिश्चाभिषिञ्चन्तु लक्ष्म्याद्या धर्मवल्लभाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002174006, "chapter_id": 22174, "verse_number": "२१९-७", "content_sanskrit": "आदित्याद्याः कश्यपस्य बहुपुत्रस्य वल्लभाः ।\nकृशाश्वस्याग्निपुत्रस्य भार्याश्चारिष्ठनेमिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002174007, "chapter_id": 22174, "verse_number": "२१९-८", "content_sanskrit": "अश्विन्याद्याश्च चन्द्रस्य पुलहस्य तथा प्रियाः ।\nभूता च कपिशा दंष्ट्री सुरसा सरमा दनुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002174008, "chapter_id": 22174, "verse_number": "२१९-९", "content_sanskrit": "श्येनी भासी तथा क्रौञ्ची धृतराष्ट्री शुकी तथा ।\nपत्न्यस्त्वामभिषिञ्चन्तु अरुणश्चार्कसारथिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002174009, "chapter_id": 22174, "verse_number": "२१९-१०", "content_sanskrit": "आयतिर्नियतीरात्रिर्निद्रा लोकस्थितौ स्थिताः ।\nउमा मेना शची पान्तु धूमोर्नानिरृतिर्जये ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002174010, "chapter_id": 22174, "verse_number": "२१९-११", "content_sanskrit": "गौरी शिवा च ऋद्धिश्च वेला चैव नड्वला ।\nअशिक्नी च तथा ज्योत्स्ना देवपत्न्यो वनस्पतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002174011, "chapter_id": 22174, "verse_number": "२१९-१२", "content_sanskrit": "महाकल्पश्च कल्पश्च मन्वन्तरयुगानि च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]