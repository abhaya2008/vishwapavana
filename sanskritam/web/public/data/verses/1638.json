[{"id": 2029213, "chapter_id": 1638, "verse_number": "३-२७६-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029214, "chapter_id": 1638, "verse_number": "३-२७६-१", "content_sanskrit": "पुलस्त्यस् तु यः क्रोधादर्धदेहोऽभवन्मुनिः।\nविश्रवानाम सक्रोधं पितरं राक्षसेश्वरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029215, "chapter_id": 1638, "verse_number": "३-२७६-२", "content_sanskrit": "बुबुधे तं तु सक्रोधं पितरं राक्षसेश्वरः।\nकुबेरस्तत्प्रसादार्थं यतते स्म सदा नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029216, "chapter_id": 1638, "verse_number": "३-२७६-३", "content_sanskrit": "स राजराजो लङ्कायां न्यवसन्नरवाहनः।\nराक्षसीः प्रददौ तिस्रः पितुर्वै परिचारिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029217, "chapter_id": 1638, "verse_number": "३-२७६-४", "content_sanskrit": "ताः सदा तं महात्मानं संतोषयितुमुद्यताः।\nऋषिं भरतशार्दूल नृत्यगीतविशारदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029218, "chapter_id": 1638, "verse_number": "३-२७६-५", "content_sanskrit": "पुष्पोत्कटा च राका च मालिनी च विशांपते।\nअन्योन्यस्पर्धयाराजञ्श्रेयस्कामाः सुमध्यमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029219, "chapter_id": 1638, "verse_number": "३-२७६-६", "content_sanskrit": "स तासां भगवांस्तुष्टो महात्मा प्रददौ वरान्।\nलोकपालोपमान्पुत्रानकैकस्या यथेप्सितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029220, "chapter_id": 1638, "verse_number": "३-२७६-७", "content_sanskrit": "पुष्पोत्कटायां जज्ञाते द्वौ पुत्रौ राक्षसेश्वरौ।\nकुम्भकर्णदशग्रीवौ बलेनाप्रतिमौ भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029221, "chapter_id": 1638, "verse_number": "३-२७६-८", "content_sanskrit": "मालिन जनयामास पुत्रमेकं विभीषणम्।\nराकार्या मिथुनं जज्ञे खरः शूर्पणखा तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029222, "chapter_id": 1638, "verse_number": "३-२७६-९", "content_sanskrit": "विभीषणस्तु रूपेण सर्वेभ्योऽभ्यधिकोऽभवत्।\nस बभूव महाभागो धर्मगोप्ता क्रियारतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029223, "chapter_id": 1638, "verse_number": "३-२७६-१०", "content_sanskrit": "दशग्रीवस्तु सर्वेषां श्रेष्ठो राक्षसपुङ्गवः।\nमहोत्साहो महावीर्यो महासत्वपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029224, "chapter_id": 1638, "verse_number": "३-२७६-११", "content_sanskrit": "कुम्भकर्णओ बलेनासीत्सर्वेभ्योऽभ्यधिको युधि।\nमायावी रणशौण्डश्चरौद्रश्च रजनीचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029225, "chapter_id": 1638, "verse_number": "३-२७६-१२", "content_sanskrit": "खरो धनुषि विक्रान्तो ब्रह्मद्विट् पिशिताशनः।\nसिद्धविघ्नकरी चापि रौद्री शूर्पणखा तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029226, "chapter_id": 1638, "verse_number": "३-२७६-१३", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वेसुचरितव्रताः।\nऊषुः पित्रा सह रता गन्धमादनपर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029227, "chapter_id": 1638, "verse_number": "३-२७६-१४", "content_sanskrit": "ततो वैश्रवणं तत्र ददृशुर्नरवाहनम्।\nपित्रा सार्धं समासीनमृद्ध्या परमया युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029228, "chapter_id": 1638, "verse_number": "३-२७६-१५", "content_sanskrit": "जातामर्षास्ततस्ते तु तपसे धृतनिश्चयाः।\nब्रह्माणं तोषयामासुर्घोरेण तपसा तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029229, "chapter_id": 1638, "verse_number": "३-२७६-१६", "content_sanskrit": "अतिष्ठदेकपादेन सहस्रं परिवत्सरान्।\nवायुभक्षो दशग्रीवः पञ्चाग्निः सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029230, "chapter_id": 1638, "verse_number": "३-२७६-१७", "content_sanskrit": "अधःशायी कुम्भकर्णो यताहारो यतव्रतः।\nविभीषणः शीर्णपर्णमेकमभ्यवहारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029231, "chapter_id": 1638, "verse_number": "३-२७६-१८", "content_sanskrit": "उपवासरतिर्धीमान्सदा जप्यपरायणः।\nतमेव कालमातिष्ठत्तीव्रं तप उदारधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029232, "chapter_id": 1638, "verse_number": "३-२७६-१९", "content_sanskrit": "स्वरः शूर्पणखा चैव तेषां वै तप्यतां तपः।\nपरिचर्यां च रक्षां च चक्रतुर्हष्टमानसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029233, "chapter_id": 1638, "verse_number": "३-२७६-२०", "content_sanskrit": "पूर्णे वर्षसहस्रेतु शिरश्छित्त्वा दशाननः।\nजुहोत्यग्नौ दुराधर्षस्तेनातुष्यज्जगत्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029234, "chapter_id": 1638, "verse_number": "३-२७६-२१", "content_sanskrit": "ततो ब्रह्मा स्वयं गत्वा तपसस्तान्न्यवारयत्।\nप्रलोभ्यवरदानेन सर्वानेवपृथक्पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029235, "chapter_id": 1638, "verse_number": "३-२७६-२२x", "content_sanskrit": "ब्राह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029236, "chapter_id": 1638, "verse_number": "३-२७६-२२", "content_sanskrit": "प्रीतोऽस्मि वो निवर्तध्वं वरान्वृणुत पुत्रकाः।\nयद्यदिष्टमृते त्वेकममरत्वं तथाऽस्तु तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029237, "chapter_id": 1638, "verse_number": "३-२७६-२३", "content_sanskrit": "यद्यदग्नौ हुतं सर्वं शिरस्ते महदीप्सया।\nतथैव तानि ते देहे भविष्यन्ति यथेप्सया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029238, "chapter_id": 1638, "verse_number": "३-२७६-२४", "content_sanskrit": "वैरूप्यं च न ते देहे कामरूपधरस्तथा।\nभविष्यसि रणेऽरीणां विजेता न च संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029239, "chapter_id": 1638, "verse_number": "३-२७६-२५x", "content_sanskrit": "रावण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029240, "chapter_id": 1638, "verse_number": "३-२७६-२५", "content_sanskrit": "गन्धर्वदेवासुरतो यक्षराक्षसतस्तथा।\nसर्पकिंनरभूतेभ्यो न मे भूयात्पराभवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029241, "chapter_id": 1638, "verse_number": "३-२७६-२६x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029242, "chapter_id": 1638, "verse_number": "३-२७६-२६", "content_sanskrit": "य एते कीर्तिताः सर्वे न तेभ्योस्ति भयं रतव।\nऋते मनुष्याद्भद्रं ते तथा तद्विहितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029243, "chapter_id": 1638, "verse_number": "३-२७६-२७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029244, "chapter_id": 1638, "verse_number": "३-२७६-२७", "content_sanskrit": "एवमुक्तो दशग्रीवस्तुष्टः समभवत्तदा।\nअवमेने हि दुर्बुद्धिर्मनुष्यान्पुरुषादकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029245, "chapter_id": 1638, "verse_number": "३-२७६-२८", "content_sanskrit": "कुम्भकर्णमथोवाच तथैव प्रपितामहः।\n`वरं वृणीष्व भद्रं ते प्रीतोस्मीति पुनःपुनः।\nस वव्रे महतीं निद्रां तमसा ग्रस्तचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029246, "chapter_id": 1638, "verse_number": "३-२७६-२९", "content_sanskrit": "तथाभविष्यतीत्युक्त्वा विभीषणमुवाच ह।\nवरं वृणीष्व पुत्र त्वं प्रीतोऽस्मीति पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029247, "chapter_id": 1638, "verse_number": "३-२७६-२९x", "content_sanskrit": "विभीषण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029248, "chapter_id": 1638, "verse_number": "३-२७६-३०", "content_sanskrit": "परमापद्गतस्यापि नाधर्मे मे मतिर्भवेत्।\nअशिक्षितं च भगवन्ब्रह्मास्त्रं प्रतिभातु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029249, "chapter_id": 1638, "verse_number": "३-२७६-३१x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029250, "chapter_id": 1638, "verse_number": "३-२७६-३१", "content_sanskrit": "यस्माद्राक्षसयोनौ ते जातस्यामित्रकर्शन।\nनाधर्मे धीयते बुद्धिरमरत्वं ददानि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029251, "chapter_id": 1638, "verse_number": "३-२७६-३२x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029252, "chapter_id": 1638, "verse_number": "३-२७६-३२", "content_sanskrit": "राक्षसस्तु वरंलब्ध्वा दशग्रीवो विशांपते।\nलङ्कायाश्च्यावयामास युधि जित्वा धनेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029253, "chapter_id": 1638, "verse_number": "३-२७६-३३", "content_sanskrit": "हित्वास भगवाँल्लङ्कामाविशद्गन्धमादनम्।\nगन्धर्वयक्षानुगतो रक्षःकिंपुरुषैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029254, "chapter_id": 1638, "verse_number": "३-२७६-३४", "content_sanskrit": "विमानं पुष्पकं तस्य जहाराक्रम्य रावणः।\nशशाप तं वैश्रवणो न त्वामेतद्वहिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029255, "chapter_id": 1638, "verse_number": "३-२७६-३५", "content_sanskrit": "यस्तु त्वां समरे हन्ता तमेवैतद्वहिष्यति।\nअवमत्य गुरुं मां च क्षिप्रं त्वंनभविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2029256, "chapter_id": 1638, "verse_number": "३-२७६-३६", "content_sanskrit": "विभीषणस्तु धर्मात्मा सतां मार्गमनुस्मरन्।\nअन्वगच्छन्महाराज श्रिया परमया युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2029257, "chapter_id": 1638, "verse_number": "३-२७६-३७", "content_sanskrit": "तस्मै स भगवांस्तुष्टो भ्राता भ्रात्रे धनेश्वरः।\nसैनापत्यं ददौ धीमान्यक्षराक्षससेनयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2029258, "chapter_id": 1638, "verse_number": "३-२७६-३८", "content_sanskrit": "राक्षसाः पुरुषादाश्च पिशाचाश्च महाबलाः।\nसर्वे समेत्य राजानमभ्यषिञ्चन्दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2029259, "chapter_id": 1638, "verse_number": "३-२७६-३९", "content_sanskrit": "दशग्रीवश्चदैत्यानां दानवानां बलोत्कटः।\nआक्रम्य रत्नान्यहरत्कामरूपी विहंगम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2029260, "chapter_id": 1638, "verse_number": "३-२७६-४०", "content_sanskrit": "रावयामास लोकान्यत्तस्माद्रावण उच्यते।\nदशग्रीवः कामबलो देवानां भयमादधत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2029261, "chapter_id": 1638, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि ,ट्सप्तत्यधिकद्विशततमोऽध्यायः ॥ २७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]