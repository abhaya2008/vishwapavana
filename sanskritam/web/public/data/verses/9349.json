[{"id": 5000349000, "chapter_id": 9349, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000349001, "chapter_id": 9349, "verse_number": "५-१०-१", "content_sanskrit": "तत्र दिव्योपमं मुख्यं स्फाटिकं रत्नभूषितम्।\nअवेक्षमाणो हनुमान् ददर्श शयनासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000349002, "chapter_id": 9349, "verse_number": "५-१०-२", "content_sanskrit": "दान्तकाञ्चनचित्रांगैर्वैदूर्यैश्च वरासनैः।\nमहार्हास्तरणोपेतैरुपपन्नं महाधनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000349003, "chapter_id": 9349, "verse_number": "५-१०-३", "content_sanskrit": "तस्य चैकतमे देशे दिव्यमालोपशोभितम्।\nददर्श पाण्डुरं छत्रं ताराधिपतिसंनिभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000349004, "chapter_id": 9349, "verse_number": "५-१०-४", "content_sanskrit": "जातरूपपरिक्षिप्तं चित्रभानोः समप्रभम्।\nअशोकमालाविततं ददर्श परमासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000349005, "chapter_id": 9349, "verse_number": "५-१०-५", "content_sanskrit": "वालव्यजनहस्ताभिर्वीज्यमानं समन्ततः।\nगन्धैश्च विविधैर्जुष्टं वरधूपेन धूपितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000349006, "chapter_id": 9349, "verse_number": "५-१०-६", "content_sanskrit": "परमास्तरणास्तीर्णमाविकाजिनसंवृतम्।\nदामभिर्वरमाल्यानां समन्तादुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000349007, "chapter_id": 9349, "verse_number": "५-१०-७", "content_sanskrit": "तस्मिञ्जीमूतसंकाशं प्रदीप्तोज्ज्वलकुण्डलम्।\nलोहिताक्षं महाबाहुं महारजतवाससम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000349008, "chapter_id": 9349, "verse_number": "५-१०-८", "content_sanskrit": "लोहितेनानुलिप्तांगं चन्दनेन सुगन्धिना।\nसंध्यारक्तमिवाकाशे तोयदं सतडिद्गुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000349009, "chapter_id": 9349, "verse_number": "५-१०-९", "content_sanskrit": "वृतमाभरणैर्दिव्यैः सुरूपं कामरूपिणम्।\nसवृक्षवनगुल्माढ्यं प्रसुप्तमिव मन्दरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000349010, "chapter_id": 9349, "verse_number": "५-१०-१०", "content_sanskrit": "क्रीडित्वोपरतं रात्रौ वराभरणभूषितम्।\nप्रियं राक्षसकन्यानां राक्षसानां सुखावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000349011, "chapter_id": 9349, "verse_number": "५-१०-११", "content_sanskrit": "पीत्वाप्युपरतं चापि ददर्श स महाकपिः।\nभास्वरे शयने वीरं प्रसुप्तं राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000349012, "chapter_id": 9349, "verse_number": "५-१०-१२", "content_sanskrit": "निःश्वसन्तं यथा नागं रावणं वानरोत्तमः।\nआसाद्य परमोद्विग्नः सोपासर्पत् सुभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000349013, "chapter_id": 9349, "verse_number": "५-१०-१३", "content_sanskrit": "अथारोहणमासाद्य वेदिकान्तरमाश्रितः।\nक्षीबं राक्षसशार्दूलं प्रेक्षते स्म महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000349014, "chapter_id": 9349, "verse_number": "५-१०-१४", "content_sanskrit": "शुशुभे राक्षसेन्द्रस्य स्वपतः शयनं शुभम्।\nगन्धहस्तिनि संविष्टे यथा प्रस्रवणं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000349015, "chapter_id": 9349, "verse_number": "५-१०-१५", "content_sanskrit": "काञ्चनांगदसंनद्धौ ददर्श स महात्मनः।\nविक्षिप्तौ राक्षसेन्द्रस्य भुजाविन्द्रध्वजोपमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000349016, "chapter_id": 9349, "verse_number": "५-१०-१६", "content_sanskrit": "ऐरावतविषाणाग्रैरापीडनकृतव्रणौ।\nवज्रोल्लिखितपीनांसौ विष्णुचक्रपरिक्षतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000349017, "chapter_id": 9349, "verse_number": "५-१०-१७", "content_sanskrit": "पीनौ समसुजातांसौ संगतौ बलसंयुतौ।\nसुलक्षणनखांगुष्ठौ स्वंगुलीयकलक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000349018, "chapter_id": 9349, "verse_number": "५-१०-१८", "content_sanskrit": "संहतौ परिघाकारौ वृत्तौ करिकरोपमौ।\nविक्षिप्तौ शयने शुभ्रे पञ्चशीर्षाविवोरगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000349019, "chapter_id": 9349, "verse_number": "५-१०-१९", "content_sanskrit": "शशक्षतजकल्पेन सुशीतेन सुगन्धिना।\nचन्दनेन परार्घ्येन स्वनुलिप्तौ स्वलंकृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000349020, "chapter_id": 9349, "verse_number": "५-१०-२०", "content_sanskrit": "उत्तमस्त्रीविमृदितौ गन्धोत्तमनिषेवितौ।\nयक्षपन्नगगन्धर्वदेवदानवराविणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000349021, "chapter_id": 9349, "verse_number": "५-१०-२१", "content_sanskrit": "ददर्श स कपिस्तस्य बाहू शयनसंस्थितौ।\nमन्दरस्यान्तरे सुप्तौ महाही रुषिताविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000349022, "chapter_id": 9349, "verse_number": "५-१०-२२", "content_sanskrit": "ताभ्यां स परिपूर्णाभ्यामुभाभ्यां राक्षसेश्वरः।\nशुशुभेऽचलसंकाशः शृंगाभ्यामिव मन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000349023, "chapter_id": 9349, "verse_number": "५-१०-२३", "content_sanskrit": "चूतपुंनागसुरभिर्बकुलोत्तमसंयुतः।\nमृष्टान्नरससंयुक्तः पानगन्धपुरःसरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000349024, "chapter_id": 9349, "verse_number": "५-१०-२४", "content_sanskrit": "तस्य राक्षसराजस्य निश्चक्राम महामुखात्।\nशयानस्य विनिःश्वासः पूरयन्निव तद् गृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000349025, "chapter_id": 9349, "verse_number": "५-१०-२५", "content_sanskrit": "मुक्तामणिविचित्रेण काञ्चनेन विराजिता।\nमुकुटेनापवृत्तेन कुण्डलोज्ज्वलिताननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000349026, "chapter_id": 9349, "verse_number": "५-१०-२६", "content_sanskrit": "रक्तचन्दनदिग्धेन तथा हारेण शोभिना।\nपीनायतविशालेन वक्षसाभिविराजिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000349027, "chapter_id": 9349, "verse_number": "५-१०-२७", "content_sanskrit": "पाण्डुरेणापविद्धेन क्षौमेण क्षतजेक्षणम्।\nमहार्हेण सुसंवीतं पीतेनोत्तरवाससा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000349028, "chapter_id": 9349, "verse_number": "५-१०-२८", "content_sanskrit": "माषराशिप्रतीकाशं निःश्वसन्तं भुजंगवत्।\nगांगे महति तोयान्ते प्रसुप्तमिव कुञ्जरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000349029, "chapter_id": 9349, "verse_number": "५-१०-२९", "content_sanskrit": "चतुर्भिः काञ्चनैर्दीपैर्दीप्यमानं चतुर्दिशम्।\nप्रकाशीकृतसर्वांगं मेघं विद्युद‍्गणैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000349030, "chapter_id": 9349, "verse_number": "५-१०-३०", "content_sanskrit": "पादमूलगताश्चापि ददर्श सुमहात्मनः।\nपत्नीः स प्रियभार्यस्य तस्य रक्षःपतेर्गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000349031, "chapter_id": 9349, "verse_number": "५-१०-३१", "content_sanskrit": "शशिप्रकाशवदना वरकुण्डलभूषणाः।\nअम्लानमाल्याभरणा ददर्श हरियूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000349032, "chapter_id": 9349, "verse_number": "५-१०-३२", "content_sanskrit": "नृत्यवादित्रकुशला राक्षसेन्द्रभुजाङ्कगाः।\nवराभरणधारिण्यो निषण्णा ददृशे कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000349033, "chapter_id": 9349, "verse_number": "५-१०-३३", "content_sanskrit": "वज्रवैदूर्यगर्भाणि श्रवणान्तेषु योषिताम्।\nददर्श तापनीयानि कुण्डलान्यंगदानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000349034, "chapter_id": 9349, "verse_number": "५-१०-३४", "content_sanskrit": "तासां चन्द्रोपमैर्वक्त्रैः शुभैर्ललितकुण्डलैः।\nविरराज विमानं तन्नभस्तारागणैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000349035, "chapter_id": 9349, "verse_number": "५-१०-३५", "content_sanskrit": "मदव्यायामखिन्नास्ता राक्षसेन्द्रस्य योषितः।\nतेषु तेष्ववकाशेषु प्रसुप्तास्तनुमध्यमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000349036, "chapter_id": 9349, "verse_number": "५-१०-३६", "content_sanskrit": "अंगहारैस्तथैवान्या कोमलैर्नृत्यशालिनी।\nविन्यस्तशुभसर्वांगी प्रसुप्ता वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000349037, "chapter_id": 9349, "verse_number": "५-१०-३७", "content_sanskrit": "काचिद् वीणां परिष्वज्य प्रसुप्ता सम्प्रकाशते।\nमहानदीप्रकीर्णेव नलिनी पोतमाश्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000349038, "chapter_id": 9349, "verse_number": "५-१०-३८", "content_sanskrit": "अन्या कक्षगतेनैव मड्डुकेनासितेक्षणा।\nप्रसुप्ता भामिनी भाति बालपुत्रेव वत्सला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000349039, "chapter_id": 9349, "verse_number": "५-१०-३९", "content_sanskrit": "पटहं चारुसर्वांगी न्यस्य शेते शुभस्तनी।\nचिरस्य रमणं लब्ध्वा परिष्वज्येव कामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000349040, "chapter_id": 9349, "verse_number": "५-१०-४०", "content_sanskrit": "काचिद् वीणां परिष्वज्य सुप्ता कमललोचना।\nवरं प्रियतमं गृह्य सकामेव हि कामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000349041, "chapter_id": 9349, "verse_number": "५-१०-४१", "content_sanskrit": "विपञ्चीं परिगृह्यान्या नियता नृत्यशालिनी।\nनिद्रावशमनुप्राप्ता सहकान्तेव भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000349042, "chapter_id": 9349, "verse_number": "५-१०-४२", "content_sanskrit": "अन्या कनकसंकाशैर्मृदुपीनैर्मनोरमैः।\nमृदंगं परिविद्‍‍ध्यांगैः प्रसुप्ता मत्तलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000349043, "chapter_id": 9349, "verse_number": "५-१०-४३", "content_sanskrit": "भुजपाशान्तरस्थेन कक्षगेन कृशोदरी।\nपणवेन सहानिन्द्या सुप्ता मदकृतश्रमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000349044, "chapter_id": 9349, "verse_number": "५-१०-४४", "content_sanskrit": "डिण्डिमं परिगृह्यान्या तथैवासक्तडिण्डिमा।\nप्रसुप्ता तरुणं वत्समुपगुह्येव भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000349045, "chapter_id": 9349, "verse_number": "५-१०-४५", "content_sanskrit": "काचिदाडम्बरं नारी भुजसम्भोगपीडितम्।\nकृत्वा कमलपत्राक्षी प्रसुप्ता मदमोहिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000349046, "chapter_id": 9349, "verse_number": "५-१०-४६", "content_sanskrit": "कलशीमपविद्ध्यान्या प्रसुप्ता भाति भामिनी।\nवसन्ते पुष्पशबला मालेव परिमार्जिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000349047, "chapter_id": 9349, "verse_number": "५-१०-४७", "content_sanskrit": "पाणिभ्यां च कुचौ काचित् सुवर्णकलशोपमौ।\nउपगुह्याबला सुप्ता निद्राबलपराजिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000349048, "chapter_id": 9349, "verse_number": "५-१०-४८", "content_sanskrit": "अन्या कमलपत्राक्षी पूर्णेन्दुसदृशानना।\nअन्यामालिंग्य सुश्रोणीं प्रसुप्ता मदविह्वला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000349049, "chapter_id": 9349, "verse_number": "५-१०-४९", "content_sanskrit": "आतोद्यानि विचित्राणि परिष्वज्य वरस्त्रियः।\nनिपीड्य च कुचैः सुप्ताः कामिन्यः कामुकानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000349050, "chapter_id": 9349, "verse_number": "५-१०-५०", "content_sanskrit": "तासामेकान्तविन्यस्ते शयानां शयने शुभे।\nददर्श रूपसम्पन्नामथ तां स कपिः स्त्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000349051, "chapter_id": 9349, "verse_number": "५-१०-५१", "content_sanskrit": "मुक्तामणिसमायुक्तैर्भूषणैः सुविभूषिताम्।\nविभूषयन्तीमिव च स्वश्रिया भवनोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000349052, "chapter_id": 9349, "verse_number": "५-१०-५२", "content_sanskrit": "गौरीं कनकवर्णाभामिष्टामन्तःपुरेश्वरीम्।\nकपिर्मन्दोदरीं तत्र शयानां चारुरूपिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000349053, "chapter_id": 9349, "verse_number": "५-१०-५३", "content_sanskrit": "स तां दृष्ट्वा महाबाहुर्भूषितां मारुतात्मजः।\nतर्कयामास सीतेति रूपयौवनसम्पदा।\nहर्षेण महता युक्तो ननन्द हरियूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000349054, "chapter_id": 9349, "verse_number": "५-१०-५४", "content_sanskrit": "आस्फोटयामास चुचुम्ब पुच्छं\nननन्द चिक्रीड जगौ जगाम।\nस्तम्भानरोहन्निपपात भूमौ\nनिदर्शयन् स्वां प्रकृतिं कपीनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000349055, "chapter_id": 9349, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]