[{"id": 50002393, "chapter_id": 10573, "verse_number": "1", "content_sanskrit": "यामिमां पुष्पितां वाचं प्रवदन्त्यविपश्चितः। वेदवादरताः पार्थ नान्यदस्तीति वादिनः॥ २/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002394, "chapter_id": 10573, "verse_number": "2", "content_sanskrit": "कामात्मानः स्वर्गपरा जन्मकर्मफलप्रदाम्। क्रियाविशेषबहुलां भोगैश्वर्यगतिं प्रति॥ २/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002395, "chapter_id": 10573, "verse_number": "3", "content_sanskrit": "भोगैश्वर्यप्रसक्तानां तयाऽपहृतचेतसाम्। व्यवसायात्मिका बुद्धिः समाधौ न विधीयते॥ २/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002396, "chapter_id": 10573, "verse_number": "4", "content_sanskrit": "॥ योगकथनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]