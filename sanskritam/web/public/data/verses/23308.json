[{"id": 7003308000, "chapter_id": 23308, "verse_number": "२-३-१", "content_sanskrit": "अम्बरीष उवाच  ।\nमार्कंडेय महाप्राज्ञ केन योगेन लब्धवान् ।\nगानविद्यां महाभागे उत्तरभाग नारदो भगवान्मुनिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003308001, "chapter_id": 23308, "verse_number": "२-३-२", "content_sanskrit": "तुंबरोश्च समानत्वं कस्मिन्काल उपेयिवान् ।\nएतदाचक्ष्व मे सर्वं सर्वज्ञोसि महामते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003308002, "chapter_id": 23308, "verse_number": "२-३-३", "content_sanskrit": "मार्कंडेय उवाच  ।\nश्रुतो मयायमर्थो वै नारदाद्देवदर्शनात् ।\nस्वयमहा महातेजा नारदोऽसौ महामतिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003308003, "chapter_id": 23308, "verse_number": "२-३-४", "content_sanskrit": "संतप्यमानो भगवान् दिव्यंवर्षसहस्रकम् ।\nनिरुच्छ्वासेन संयुक्तस्तुंबरोर्गौरवं स्मरन् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003308004, "chapter_id": 23308, "verse_number": "२-३-५", "content_sanskrit": "तताप च महाघोरं तपोराशिस्तपः परम् ।\nअथांतरिक्षे शुश्राव नारदोऽसौ महामुनिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003308005, "chapter_id": 23308, "verse_number": "२-३-६", "content_sanskrit": "वाणीं दिव्यां महाघोषामद्भुतामसरीरिणीम् ।\nकिमर्थं मुनिशार्दूल तपस्तपसि दुश्चरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003308006, "chapter_id": 23308, "verse_number": "२-३-७", "content_sanskrit": "उलूकं पश्य गत्वा त्वं यदि गाने रता मतिः ।\nमानसोत्तरशैले तु गानबंधुरिति स्मृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003308007, "chapter_id": 23308, "verse_number": "२-३-८", "content_sanskrit": "गच्छ शीघ्रं च पश्यैनं गानवित्त्वं भविष्यसि ।\nइत्युक्तो विस्मया विष्टो नारदो वाग्विदां वरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003308008, "chapter_id": 23308, "verse_number": "२-३-९", "content_sanskrit": "मानसोत्तरशैले तु गानबंधुं जगाम वै ।\nगंधर्वाः किन्नरा यक्षास्तथा चाप्सरसां गणाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003308009, "chapter_id": 23308, "verse_number": "२-३-१०", "content_sanskrit": "समासीनास्तु परितो गानबंधुं ततस्ततः ।\nगनविद्यां समापन्नः सिक्षितास्तेन पक्षिणा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003308010, "chapter_id": 23308, "verse_number": "२-३-११", "content_sanskrit": "स्निग्धकंठस्वरास्त्र समासीना मुदान्विताः ।\nततो नारदमालोक्य गानबंधुरुवाच  ।\n॥११।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003308011, "chapter_id": 23308, "verse_number": "२-३-१२", "content_sanskrit": "प्रणिपत्य यथान्यायं स्वागतेनाभ्यपूजयत् ।\nकिमर्थं भगवानत्र चागतोऽसि महामते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003308012, "chapter_id": 23308, "verse_number": "२-३-१३", "content_sanskrit": "किं कार्यं हि मया ब्रह्मन् ब्रूहि किं करवाणि ते  ।\nनारद उवाच  ।\nउलूकेंद्र महाप्राज्ञ श्रृणुसर्वं यथातथम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003308013, "chapter_id": 23308, "verse_number": "२-३-१४", "content_sanskrit": "मम वृत्तं प्रवक्ष्यामि पुरा भूतं महाद्भुतम् ।\nअतीते हि युगे विद्वन्नारायणसमीपगम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003308014, "chapter_id": 23308, "verse_number": "२-३-१५", "content_sanskrit": "मां विनिर्धूय संहृष्टः समाहूय च तुंबरुम् ।\nलक्ष्मीसमन्वितो विष्णुरश्रृणोद्गानमुत्तमम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003308015, "chapter_id": 23308, "verse_number": "२-३-१६", "content_sanskrit": "ब्रह्मादयः सुराः सर्वे निरस्ताः स्थानतोऽच्युताः ।\nकौशिकाद्याः समासीना गानयोगेन वै हरिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003308016, "chapter_id": 23308, "verse_number": "२-३-१७", "content_sanskrit": "एवमाराध्य संप्राप्ता गाणपत्यं यथासुखम् ।\nतेनाहमतिदुःखार्तस्तपस्तप्तुमिहागतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003308017, "chapter_id": 23308, "verse_number": "२-३-१८", "content_sanskrit": "यद्दत्तं यद्धुतं चैव यथा वा श्रुतमेव च ।\nयदधीतं मया सर्वं कलां नार्हति षोडशीम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003308018, "chapter_id": 23308, "verse_number": "२-३-१९", "content_sanskrit": "विष्णोर्माहात्म्ययुक्तस्य गान योगस्य वै ततः ।\nसंचिंत्याहं तपो घोरं तदर्थं तप्तवान् द्विज ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003308019, "chapter_id": 23308, "verse_number": "२-३-२०", "content_sanskrit": "दिव्यवर्षसहस्रं वै ततो ह्यश्रृणुवं पुनः ।\nवाणीमाकाशसंभूतां त्वामुद्दिश्य विहंगम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003308020, "chapter_id": 23308, "verse_number": "२-३-२१", "content_sanskrit": "उलूकं गच्छ देवर्षे गानबंधुं मतिर्यदि ।\nगाते चेद्वर्तते ब्रह्मन् तत्र त्वं वेत्स्यसे चिरात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003308021, "chapter_id": 23308, "verse_number": "२-३-२२", "content_sanskrit": "इत्यहं प्रेरितस्तेन त्वत्समीपमीहागतः ।\nकिं करीष्यामि शिष्योहं तव मां पालयाव्यय ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003308022, "chapter_id": 23308, "verse_number": "२-३-२३", "content_sanskrit": "गानबंधुरुवाच  ।\nश्रृणु नारद यद्वृत्तं पुरा मम महामते ।\nअत्याश्चर्यसमायुक्तं सर्वपापहरं शुभम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003308023, "chapter_id": 23308, "verse_number": "२-३-२४", "content_sanskrit": "भुवनेश इति ख्यातो राजभूद्धार्मिकः पुरा ।\nअश्वमेधसहस्रैश्च वाजपेयायुतेन च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003308024, "chapter_id": 23308, "verse_number": "२-३-२५", "content_sanskrit": "गवां कोट्यर्बुदे चैव सुवर्मस्य तथैव च ।\nवाससां रथहस्तीनां कन्याश्वानां तथैव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003308025, "chapter_id": 23308, "verse_number": "२-३-२६", "content_sanskrit": "दत्वा स राजा विप्रेभ्यो मेदिनीं प्रतिपालयन् ।\nनिवारयन् स्वके राज्ये गेययोगेन केशवम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003308026, "chapter_id": 23308, "verse_number": "२-३-२७", "content_sanskrit": "अन्यं वा गेययोगेन गायन्यदि स मे भवेत् ।\nवध्यः सर्वात्मना तस्माद्वेदै रीड्यः परः पुमान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003308027, "chapter_id": 23308, "verse_number": "२-३-२८", "content_sanskrit": "गानयोगेन सर्वत्र स्त्रियो गायंतु नित्यशः ।\nसूतमागधसंघाश्च गीतं ते कारयंतु वै ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003308028, "chapter_id": 23308, "verse_number": "२-३-२९", "content_sanskrit": "इत्यज्ञाप्यमहातेजा राज्यं वै पर्यपालयत् ।\nतस्य राज्ञः पुराभ्याशे हरिमित्र इति श्रुतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003308029, "chapter_id": 23308, "verse_number": "२-३-३०", "content_sanskrit": "ब्राह्मणो विष्णुभक्तश्च सर्वद्वंद्वविवर्जितः ।\nनदीपुलिनमासाद्य प्रतिमां च हरेः शुभाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003308030, "chapter_id": 23308, "verse_number": "२-३-३१", "content_sanskrit": "अभ्यर्च्य च यथान्यायं घृतदध्युत्तरं बहु ।\nमिष्टान्नं पायसं दत्त्वा हरेरावेद्य पूपकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003308031, "chapter_id": 23308, "verse_number": "२-३-३२", "content_sanskrit": "प्रणिपत्य यथान्यायं तत्र विन्यस्तमानसः ।\nअगायत हरिं तत्र तालवर्णलयान्वितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003308032, "chapter_id": 23308, "verse_number": "२-३-३३", "content_sanskrit": "अतीव स्नेहसंयुक्तस्तद्गतेनांतरात्मना ।\nततो राज्ञः समादेशाच्चारास्तत्र समागताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003308033, "chapter_id": 23308, "verse_number": "२-३-३४", "content_sanskrit": "तदर्चनादि सकलं निर्दूय च समंततः ।\nब्राह्मणं तं गृहीत्वा ते राज्ञे सम्यङ्न्यवेदयन् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003308034, "chapter_id": 23308, "verse_number": "२-३-३५", "content_sanskrit": "ततो राजा द्विजश्रेष्ठं परिभर्त्स्य सुदुर्मतिः ।\nराज्यान्नर्यातयामास हृत्वा सर्वं धनादिकम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003308035, "chapter_id": 23308, "verse_number": "२-३-३६", "content_sanskrit": "प्रतिमां च हरेश्चैव म्लेच्छा हृत्वा ययुः पुनः ।\nततः कालेन महता कालधर्ममुपेयिवान् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003308036, "chapter_id": 23308, "verse_number": "२-३-३७", "content_sanskrit": "स राजा सर्वलोकेषु पूज्यमानः समंततः ।\nक्षुधार्तश्च तथा खिन्नो यममाह सुदुः खितः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003308037, "chapter_id": 23308, "verse_number": "२-३-३८", "content_sanskrit": "क्षुत्तृट् च वर्तते देव स्वर्गतस्यापि मे सदा ।\nमया पापं कृतं किं वा किं करिष्यामि वै यम ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003308038, "chapter_id": 23308, "verse_number": "२-३-३९", "content_sanskrit": "यम उवाच  ।\nत्वया हि सुमहत्पापं कृतमज्ञानमोहतः ।\nहरिमित्रं प्रति तदा वासुदेवपरायणम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003308039, "chapter_id": 23308, "verse_number": "२-३-४०", "content_sanskrit": "हरिमित्रे कृतं पापं वासुदेवार्चनादिषु ।\nतेन पापेन संप्राप्तः क्षुद्रोगस्त्वां सदा नृप ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003308040, "chapter_id": 23308, "verse_number": "२-३-४१", "content_sanskrit": "दानयज्ञादिकं सर्वं प्रनष्टं ते नराधिप ।\nगीतवाद्यसमोपेतं गायमानं महामतिम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003308041, "chapter_id": 23308, "verse_number": "२-३-४२", "content_sanskrit": "हरिमित्रं समाहूय हृतवानसि तद्धनम् ।\nउपहारादिकं सर्वं वासुदेवस्य सन्निधौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003308042, "chapter_id": 23308, "verse_number": "२-३-४३", "content_sanskrit": "तव भृत्यैस्तदा लुप्तं पापं चक्रुस्त्वदाज्ञया ।\nहरेः कीर्तिं विना चान्यद्ब्रह्मणेन नृपोत्तम ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003308043, "chapter_id": 23308, "verse_number": "२-३-४४", "content_sanskrit": "न गेययोगे गातव्यं तस्मात्पापं कृतं त्वया ।\nनष्टस्ते सर्वलोकोद्य गच्च पर्वतकोटरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003308044, "chapter_id": 23308, "verse_number": "२-३-४५", "content_sanskrit": "पूर्वोत्सृष्टं स्वदेहं तं खादन्नित्यं निकृत्य वै ।\nतस्मिन्कोणे त्विमं देहं खादन्नित्यं क्षुधन्वितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003308045, "chapter_id": 23308, "verse_number": "२-३-४६", "content_sanskrit": "महानिरयसंस्थस्त्वं यावन्मन्वंतरं भवेत् ।\nमन्वंतरे ततोऽतीते भूम्यां त्वं च भविष्यसि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003308046, "chapter_id": 23308, "verse_number": "२-३-४७", "content_sanskrit": "ततः कालेन संप्राप्य मानुष्यमवगच्छसि  ।\nगानबंधुरुवाच  ।\nएवमुक्त्वा यमो विद्वांस्तत्रैवांतरधीयत ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003308047, "chapter_id": 23308, "verse_number": "२-३-४८", "content_sanskrit": "हरिमित्रो विमानेन स्तूयमानो गणाधिपैः ।\nविष्णुलोकं गतः श्रीमान् संगृह्य गमबांधवान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003308048, "chapter_id": 23308, "verse_number": "२-३-४९", "content_sanskrit": "भुवनेशो नृपो ह्यस्मिन् कोटरे पर्वतस्य वै ।\nखादमानः शवं नित्यमास्ते क्षत्तृट्रसमन्वितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003308049, "chapter_id": 23308, "verse_number": "२-३-५०", "content_sanskrit": "अद्राक्षं तं नृपं तत्र सर्वमेतन्ममोक्तवान् ।\nसमालोक्याहमाज्ञाय हरिमित्रं समेयिवान् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003308050, "chapter_id": 23308, "verse_number": "२-३-५१", "content_sanskrit": "विमानेनार्कवर्णेन गच्छंतममरैर्वृतम् ।\nइंद्रद्युम्नप्रसादेन प्राप्तं मे ह्यायुरुत्तमम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003308051, "chapter_id": 23308, "verse_number": "२-३-५२", "content_sanskrit": "तेनाहं हरिमित्रं वै दृष्ट्वानस्मि सुव्रत ।\nतदैश्वर्यप्रभावेन मनो मे समुपागतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003308052, "chapter_id": 23308, "verse_number": "२-३-५३", "content_sanskrit": "गानविद्यां प्रति तदा किन्नरैः समुपाविशम् ।\nषष्टिं वर्षसहस्राणां गान्योगेन मे मुने ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003308053, "chapter_id": 23308, "verse_number": "२-३-५४", "content_sanskrit": "जिह्वा प्रसादिता स्पष्टा ततो गानमशिक्षयम् ।\nततस्तु द्विगुणेनैव कालेनाभूदियं मम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003308054, "chapter_id": 23308, "verse_number": "२-३-५५", "content_sanskrit": "गानयोगसमायुक्ता गता मन्वंतरा दश ।\nगानाचार्योऽभवं तत्र गंधर्वाद्याः समागताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003308055, "chapter_id": 23308, "verse_number": "२-३-५६", "content_sanskrit": "एते किन्नरसंघा वै मामाचार्यमुपागताः ।\nतपसा नैव शक्या वै गानविद्या तपोधन ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003308056, "chapter_id": 23308, "verse_number": "२-३-५७", "content_sanskrit": "तस्माच्छ्रुतेन संयुक्तो मत्तस्त्वं गानमाप्नुहि ।\nएवमुक्तो मुनिस्तं वै प्रणिपत्य जगौ तदा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003308057, "chapter_id": 23308, "verse_number": "२-३-५८", "content_sanskrit": "तच्छृणुष्व मुनिश्रेष्ठ वासुदेवं नमस्य तु  ।\nमार्कंडेय उवाच  ।\nउलूकेनैवमुक्तस्तु नारदो मुनिसत्तमः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003308058, "chapter_id": 23308, "verse_number": "२-३-५९", "content_sanskrit": "शिक्षाक्रमेण संयुक्तस्तत्र गानमाशिक्षयत् ।\nगानबंधुस्तदाहेदं त्यक्तलज्जो भवाधुना ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003308059, "chapter_id": 23308, "verse_number": "२-३-६०", "content_sanskrit": "उलूक उवाच  ।\nस्त्रीसंगमे तथा गीते द्यूते व्याख्यानसमगमे ।\nव्यवहारे तथाहारे त्वर्थानां च समागमे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003308060, "chapter_id": 23308, "verse_number": "२-३-६१", "content_sanskrit": "आये व्यये तथा नित्यं त्यक्तलज्जस्तु वै भवेत् ।\nन कुंचितेन गूढेन नित्यं प्रावरमादिभिः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003308061, "chapter_id": 23308, "verse_number": "२-३-६२", "content_sanskrit": "हस्तविक्षेपभावेन व्यादि तास्येन चैव हि ।\nनिर्यातजिह्वायोगेन न गेयं हि कथंचन ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003308062, "chapter_id": 23308, "verse_number": "२-३-६३", "content_sanskrit": "न गायेदूर्ध्वबाहुश्च नोर्ध्वदृष्टिः कथंचन ।\nस्वांगं निरीक्षमाणेन परं संप्रेक्षता तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003308063, "chapter_id": 23308, "verse_number": "२-३-६४", "content_sanskrit": "संघट्टे च तथोत्थाने कटिस्थानं न शस्यते ।\nहासो रोषस्तथा कंपस्तथान्यत्र स्मृतिः पुनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003308064, "chapter_id": 23308, "verse_number": "२-३-६५", "content_sanskrit": "नैतानि शस्तरूपाणि गानयोगे महामते ।\nनैकहस्तेन शक्यं स्यात्तालसंघट्टनं मुने ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003308065, "chapter_id": 23308, "verse_number": "२-३-६६", "content_sanskrit": "क्षुधार्त्तेन भयार्तेन तृष्णार्तेन तथैव च ।\nगानयोगे न कर्तव्यो नांधकारे कथंचन ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003308066, "chapter_id": 23308, "verse_number": "२-३-६७", "content_sanskrit": "एवमादीनि चान्यानि न कर्तव्यानि गायता  ।\nमार्कंडेय उवाच  ।\nएवमुक्तः स भगवांस्तेनोक्तैर्विधिलक्षणैः ।\nअशिक्षयत्तथा गीतं दिव्यं वर्षसहस्रकम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003308067, "chapter_id": 23308, "verse_number": "२-३-६८", "content_sanskrit": "ततः समस्तसंपन्नो गीतप्रस्तारकादिषु ।\nविपंच्यादिषु संपन्नः सर्वस्वरविभावित् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003308068, "chapter_id": 23308, "verse_number": "२-३-६९", "content_sanskrit": "अयुतानि च षट्त्रिंशत्सहस्राणि शतानि च ।\nस्वराणां भेदयोगेन ज्ञातवान्मुनिसत्तमः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003308069, "chapter_id": 23308, "verse_number": "२-३-७०", "content_sanskrit": "ततो गंधर्वसंघाश्च किन्नराणां तथैव च ।\nमुनिना सह संयुक्ताः प्रीतियुक्ता भवंति ते ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003308070, "chapter_id": 23308, "verse_number": "२-३-७१", "content_sanskrit": "गानबंधुं मुनिः प्राह प्राप्य गानमनुत्तमम् ।\nत्वां समासाद्य संपन्नस्त्वं हि गीतविशारदः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003308071, "chapter_id": 23308, "verse_number": "२-३-७२", "content_sanskrit": "ध्वांक्षशत्रो महाप्राज्ञ किमाचार्य करोमि ते  ।\nगानबंधुरुवाच  ।\nब्रह्मणो दिवसे ब्रह्मन् मनवस्तु चतुर्दश ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003308072, "chapter_id": 23308, "verse_number": "२-३-७३", "content_sanskrit": "ततस्त्रै लोक्यसंप्लावो भविष्यति महामुने ।\nतावन्मे त्वायुषो भावस्तावन्मे परमं शुभम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003308073, "chapter_id": 23308, "verse_number": "२-३-७४", "content_sanskrit": "मनसाध्याहितं मे स्याद्दक्षिणा मुनिसत्तम  ।\nनारद उवाच  ।\nअतीतकल्पसंयोगे गरुडस्त्वं भविष्यसि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003308074, "chapter_id": 23308, "verse_number": "२-३-७५", "content_sanskrit": "स्वस्ति तेऽस्तु महाप्राज्ञ गमिष्यामि प्रसीद माम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003308075, "chapter_id": 23308, "verse_number": "२-३-७६", "content_sanskrit": "मार्कंडेय उवाच  ।\nएवमुक्त्वा जगामथ नारदोपि जनार्दनम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003308076, "chapter_id": 23308, "verse_number": "२-३-७७", "content_sanskrit": "श्वेतद्वीपे हृषीकेशं गापयामास गीतकान् ।\nतत्र श्रुत्वा तु भगवान्नारदं प्राह माधवः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003308077, "chapter_id": 23308, "verse_number": "२-३-७८", "content_sanskrit": "तुंबरोर्न विशिष्टोसि गीतैरद्यापि नारद ।\nयदा विशिष्टो भविता तं कालं प्रवदाम्यहम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003308078, "chapter_id": 23308, "verse_number": "२-३-७९", "content_sanskrit": "गानबंधुं समासाद्य गानार्थज्ञो भवानसि ।\nमनोर्वैवस्वतस्याहमष्टविशतिमे युगे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003308079, "chapter_id": 23308, "verse_number": "२-३-८०", "content_sanskrit": "द्वांपरां ते भवष्यामि युदवंशकुलोद्भवः ।\nदेवक्यां वसुदेवस्य कृष्णो नाम्ना महामते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003308080, "chapter_id": 23308, "verse_number": "२-३-८१", "content_sanskrit": "तदानीं मां समासाद्य स्मारयेथा यथातथम् ।\nतत्र त्वां गीतसंपन्नं करिष्यामि महाव्रतम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003308081, "chapter_id": 23308, "verse_number": "२-३-८२", "content_sanskrit": "तुंबरोश्च समंचैव तथातिशयसंयुतम् ।\nतावत्कालं यतायोगं देवगंधर्वयोनिषु ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003308082, "chapter_id": 23308, "verse_number": "२-३-८३", "content_sanskrit": "शिक्षयस्व यतान्यायमित्युक्त्वांतरधीयत ।\nततो मुनिः प्रणम्यैनं तथातिशयसंयुतम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003308083, "chapter_id": 23308, "verse_number": "२-३-८४", "content_sanskrit": "देवर्षिर्देवसंकाशः सर्वाभरणभूषितः ।\nतपसां निधिरत्यंतं वासुदेवपरायणः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003308084, "chapter_id": 23308, "verse_number": "२-३-८५", "content_sanskrit": "स्कंधे विपंचीमासाद्य सर्वलोकांश्चचार सः ।\nवारुणं याम्यमाग्नेयमैद्रं कौबेरमेव च ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003308085, "chapter_id": 23308, "verse_number": "२-३-८६", "content_sanskrit": "वायव्यं च तथेशानं संसदं प्राप्य धर्मवित् ।\nगायमानो हरिं सम्यग्वीणावादविचक्षणः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003308086, "chapter_id": 23308, "verse_number": "२-३-८७", "content_sanskrit": "गंधर्वाप्सरसां संघैः पूज्यमानस्तत स्ततः ।\nब्रह्मलोकं समासाद्य कस्मिंश्चित्कालपर्यये ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003308087, "chapter_id": 23308, "verse_number": "२-३-८८", "content_sanskrit": "हाहाहूहूश्च गंधर्वौ गीतवाद्यविशारदौ ।\nब्रह्मणो गायकौ दिव्यौ नित्यौ गंधर्वसत्तमौ ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003308088, "chapter_id": 23308, "verse_number": "२-३-८९", "content_sanskrit": "तत्र ताभ्यां समासाद्य गायमानो हरिं प्रभुम् ।\nब्रह्मणा च महातेजाः पूजितो मुनिसत्तमः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003308089, "chapter_id": 23308, "verse_number": "२-३-९०", "content_sanskrit": "तं प्रणम्य महात्मानं सर्वलोकपितामहम् ।\nचचार च यथाकामं सर्वलोकेषु नारदः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003308090, "chapter_id": 23308, "verse_number": "२-३-९१", "content_sanskrit": "ततः कालेन महता गृहं प्राप्य च तुंबरोः ।\nवीणामादाय तत्रस्थो ह्यगायत महामुनिः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003308091, "chapter_id": 23308, "verse_number": "२-३-९२", "content_sanskrit": "स्वरकल्पास्तु तत्रस्थाः षड्जाद्याः सप्त वै मताः ।\nक्रीडतो भगवान्दृष्ट्वा निर्गतश्च सुसत्वरम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003308092, "chapter_id": 23308, "verse_number": "२-३-९३", "content_sanskrit": "शिक्षया मास बहुशस्तत्र तत्र महामतिः ।\nश्रमयोगेन संयुक्तो नारदोपि महामुनिः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003308093, "chapter_id": 23308, "verse_number": "२-३-९४", "content_sanskrit": "सप्तस्वरांगनाः पश्यन् गानविद्याविशारदः ।\nआसीद्वीणा समायोगे न तास्तंत्र्यः प्रपेदिरे ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003308094, "chapter_id": 23308, "verse_number": "२-३-९५", "content_sanskrit": "ततो रवैतके कृष्णं प्रणिपत्य महामुनिः ।\nविज्ञापयदशेषं तु श्वेतद्वीपे तु यत् पुरा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003308095, "chapter_id": 23308, "verse_number": "२-३-९६", "content_sanskrit": "नारायणेन कथितं गानयोगमनुत्तमम् ।\nतच्छ्रुत्वा प्राहसन्कृष्णः प्राह जांबवतीं मुदा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003308096, "chapter_id": 23308, "verse_number": "२-३-९७", "content_sanskrit": "एतं मुनिवरं भद्रे शिक्षयस्व यथाविधि ।\nवीणागान समायोगे तथेत्युक्त्वा च सा हरिम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003308097, "chapter_id": 23308, "verse_number": "२-३-९८", "content_sanskrit": "प्रहसंती यथायोगं शिक्षयामास तं मुनिम् ।\nततः संवत्सरे पूर्णे पुनरागम्य माधवम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003308098, "chapter_id": 23308, "verse_number": "२-३-९९", "content_sanskrit": "प्रणिपत्याग्रतस्तस्थौ पुनराह स केशवः ।\nसत्यां समीपमागच्छ शिक्षयस्व यथाविधि ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003308099, "chapter_id": 23308, "verse_number": "२-३-१००", "content_sanskrit": "तथेत्युक्त्वा सत्यभामां प्रणिपत्यजगौ मुनिः ।\nतया स सिक्षितो विद्वान् पूर्णे संवत्सरे पुनः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003308100, "chapter_id": 23308, "verse_number": "२-३-१०१", "content_sanskrit": "वासुदेवमियुक्तोऽसौ रुक्मिणीसदनं गतः ।\nअंगनाभिस्ततस्ताभिर्दासीभिर्मुनिसत्तमः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003308101, "chapter_id": 23308, "verse_number": "२-३-१०२", "content_sanskrit": "उक्तोऽसौ गायमानोपि न स्वरं वेत्सि वै मुने ।\nततः श्रमेण महता वत्सरत्रयसंयुतम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003308102, "chapter_id": 23308, "verse_number": "२-३-१०३", "content_sanskrit": "शिक्षितोसौ तदा देव्या रुक्मिण्यापि जगौ मुनिः ।\nततः स्वरांगनाः प्राप्यः तंत्रीयोगं महामुनेः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003308103, "chapter_id": 23308, "verse_number": "२-३-१०४", "content_sanskrit": "आहूय कृष्णो भगवान् स्वयमेव महामुनिम् ।\nअशिक्षयदमेयात्मा गानयोगमनुत्तमम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003308104, "chapter_id": 23308, "verse_number": "२-३-१०५", "content_sanskrit": "ततोऽतिशयमापन्नस्तुंबरोर्मुनिसत्तमः ।\nततो ननर्त देवर्षिः प्रणिपत्य जनार्दनम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003308105, "chapter_id": 23308, "verse_number": "२-३-१०६", "content_sanskrit": "उवाच  ।\nहृषीकेशः सर्वज्ञस्त्वं महामुने ।\nप्रहस्य गानयोगेन गायस्व मम सन्निधौ ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003308106, "chapter_id": 23308, "verse_number": "२-३-१०७", "content_sanskrit": "एतत्ते प्रार्थितं प्राप्तं मम लोके तथैव च ।\nनित्यं तुंबरुणा सार्धं गायस्व च यथातथम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003308107, "chapter_id": 23308, "verse_number": "२-३-१०८", "content_sanskrit": "एवमुक्तो मुनिस्तत्र यथायोगं चचार सः ।\nयदा संपूजयन् कृष्णो रुद्रं भुवननायकम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003308108, "chapter_id": 23308, "verse_number": "२-३-१०९", "content_sanskrit": "तदा जगै हरेस्तस्य नियोगाच्छंकराय वै ।\nरुक्मिण्या सह सत्या च जांबवत्या महामुनिः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003308109, "chapter_id": 23308, "verse_number": "२-३-११०", "content_sanskrit": "कृष्णेन च नृपश्रेष्ठ श्रुतिजातिविशारदः ।\nएष वो मुनिशार्दूलाः प्रोक्तो गीतक्रमो मुनेः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003308110, "chapter_id": 23308, "verse_number": "२-३-१११", "content_sanskrit": "ब्राह्मणो वासुदेवाख्यां गायमानो भृशं नृप ।\nहरेः सालोक्यमाप्नोति रुद्रगानोऽधिको भवेत् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003308111, "chapter_id": 23308, "verse_number": "२-३-११२", "content_sanskrit": "अन्यथा नरकं गच्छेद्गायमानोन्यदेव हि ।\nकर्मणा मनसा वाचा वासुदेवपरायणः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003308112, "chapter_id": 23308, "verse_number": "२-३-११३", "content_sanskrit": "गायन् श्रृण्वंस्तमाप्नोति तस्माद्गेयं परं विदुः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}]