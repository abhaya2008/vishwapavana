[{"id": 2016333, "chapter_id": 1343, "verse_number": "२-८४-१", "content_sanskrit": "वैशम्पायन उवाच॥\nप्रविश्य तां सभां पार्था युधिष्ठिरपुरोगमाः।\nसमेत्य पार्थिवान्सर्वान्पूजार्हानभिपूज्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016334, "chapter_id": 1343, "verse_number": "२-८४-२", "content_sanskrit": "यथावयः समेयाना उपविष्टा यथार्हतः।\nआसनेषु विचित्रेषु स्पर्द्ध्यास्तरणवत्सु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016335, "chapter_id": 1343, "verse_number": "२-८४-३", "content_sanskrit": "तेषु तत्रोपविष्टेषु सर्वेष्वथ नृपेषु च।\nशकुनिः सौबलस्तत्र युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016336, "chapter_id": 1343, "verse_number": "२-८४-४x", "content_sanskrit": "शकुनिरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016337, "chapter_id": 1343, "verse_number": "२-८४-४", "content_sanskrit": "उपस्तीर्णा सभा राजन्सर्वे त्वयि कृतक्षणाः।\nअक्षानुप्त्वा देवनस्य समयोऽस्तु युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016338, "chapter_id": 1343, "verse_number": "२-८४-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016339, "chapter_id": 1343, "verse_number": "२-८४-५", "content_sanskrit": "नितिर्देवनं पापं न क्षात्रोऽत्र पराक्रमः।\nन च नीतिर्ध्रुवा राजन्किं त्वं द्यूतं प्रशंससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016340, "chapter_id": 1343, "verse_number": "२-८४-६", "content_sanskrit": "न हि मानं प्रशंसन्ति निकृतौ कितवस्य हि।\nशकुने मैवं नोऽजैषीरमार्गेण नृशंसवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016341, "chapter_id": 1343, "verse_number": "२-८४-७x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016342, "chapter_id": 1343, "verse_number": "२-८४-७", "content_sanskrit": "यो वेत्ति सङ्ख्या निकृतौ विधिज्ञ-\nश्चेष्टास्वखिन्नः कितवोऽक्षजासु।\nमहामतिर्यश्च जानाति द्यूतं\nस वै सर्वं सहते प्रक्रियासु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016343, "chapter_id": 1343, "verse_number": "२-८४-८", "content_sanskrit": "अक्षग्लहः सोऽभिभवेत्परं न-\nस्तेनैव दोषो भवतीह पार्थ।\nदीव्यामहे पार्थिव मा विशङ्कां\nकुरुष्व पाणं च चिरं च मा कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016344, "chapter_id": 1343, "verse_number": "२-८४-९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016345, "chapter_id": 1343, "verse_number": "२-८४-९", "content_sanskrit": "एवमाहायमसितो देवलो मुनिसत्तमः।\nइमानि लोकद्वाराणि यो वै भ्राम्यति सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016346, "chapter_id": 1343, "verse_number": "२-८४-१०", "content_sanskrit": "इदं वै देवनं पापं निकृत्या कितवैः सह।\nधर्मेण तु जयो युद्धे तत्परं न तु देवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016347, "chapter_id": 1343, "verse_number": "२-८४-११", "content_sanskrit": "नार्या म्लेच्छन्ति भाषाभिर्मायया न चरन्त्युत।\nअजिह्यमशठं युद्धमेतत्सत्पुरुषव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016348, "chapter_id": 1343, "verse_number": "२-८४-१२", "content_sanskrit": "शक्तितो ब्राह्मणार्थाय शिक्षितुं प्रयतामहे।\nतद्वै वित्तं मातिदेवीर्माजैषीः शकुने परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016349, "chapter_id": 1343, "verse_number": "२-८४-१३", "content_sanskrit": "निकृत्या कामये नाहं सुखान्युत धनानि वा।\nकितवस्येह कृतिनो वृत्तमेतन्न पूज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016350, "chapter_id": 1343, "verse_number": "२-८४-१४x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016351, "chapter_id": 1343, "verse_number": "२-८४-१४", "content_sanskrit": "श्रोत्रियः श्रोत्रियानेति निकृत्यैव युधिष्ठिर।\nविद्वानविदुषोऽभ्येति नाहुस्तां निकृतिं जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016352, "chapter_id": 1343, "verse_number": "२-८४-१५", "content_sanskrit": "अक्षैर्हि शिक्षितोऽभ्येति निकृत्यैव युधिष्ठिर।\nविद्वानविदुषोऽभ्येति नाहुस्तां निकृतिं जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016353, "chapter_id": 1343, "verse_number": "२-८४-१६", "content_sanskrit": "अकृतास्त्रं कृतास्रश्च दुर्बलं बलवत्तरः।\nएवं कर्मसु सर्वेषु निकृत्यैव युधिष्ठिरः।\nविद्वानविदुषोभ्येति नाहुस्तां निकृतिं जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016354, "chapter_id": 1343, "verse_number": "२-८४-१७", "content_sanskrit": "एवं त्वं मामिहाभ्येत्य निकृतिं यदि मन्यसे।\nदेवनाद्विनिवर्तस्व यदि ते विद्यते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016355, "chapter_id": 1343, "verse_number": "२-८४-१८x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016356, "chapter_id": 1343, "verse_number": "२-८४-१८", "content_sanskrit": "आहूतो न निवर्तेयमिति मे व्रतमाहितम्।\nविधिश्च बलवान्राजन्दिष्टस्यास्मि वशे स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016357, "chapter_id": 1343, "verse_number": "२-८४-१९", "content_sanskrit": "अस्मिन्समागमे केन देवनं मे भविष्यति।\nप्रतिपाणश्च कोऽन्योस्ति ततो द्यूतं प्रवर्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016358, "chapter_id": 1343, "verse_number": "२-८४-२०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016359, "chapter_id": 1343, "verse_number": "२-८४-२०", "content_sanskrit": "अहं दातास्मि रत्नानां धनानां च विशाम्पते।\nमदर्थे देविता चायं शकुनिर्मातुलो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016360, "chapter_id": 1343, "verse_number": "२-८४-२१x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016361, "chapter_id": 1343, "verse_number": "२-८४-२१", "content_sanskrit": "अन्येनान्यस्य वै द्यूतं विषमं प्रतिभाति मे।\nएतद्विद्विन्नुपादत्स्व काममेवं प्रवर्ततम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016362, "chapter_id": 1343, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि चतुरशीतितमोऽध्यायः॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]