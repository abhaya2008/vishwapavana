[{"id": 7002496000, "chapter_id": 22496, "verse_number": "१-१५८-१", "content_sanskrit": "सुमंतुरुवाच ।\nप्रश्नभारो महांस्तात त्वयोक्तो रश्मिमालिनि ।\nयथाशक्ति तु वक्ष्यामि श्रूयतां भानवं यशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002496001, "chapter_id": 22496, "verse_number": "१-१५८-२", "content_sanskrit": "भानोः प्रभावश्रवणे यस्य ते मतिरुत्थिता ।\nहंत भानोः प्रवृत्तिं च शृणु दिव्यां मयेरिताम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002496002, "chapter_id": 22496, "verse_number": "१-१५८-३", "content_sanskrit": "सहस्रास्यं सहस्राक्षं सहस्रकिरणं च यम् ।\nसहस्रशिरसं देवं सहस्रकरम व्ययम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002496003, "chapter_id": 22496, "verse_number": "१-१५८-४", "content_sanskrit": "सहस्रजिह्वं भास्वंतं सहस्रमुकुटं प्रभुम् ।\nसहस्रदं सहस्रारिं सहस्रभुजमव्ययम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002496004, "chapter_id": 22496, "verse_number": "१-१५८-५", "content_sanskrit": "सवनं भवनं चैव हव्यं होतारमेव च ।\nपात्राणि समतीतानि वेददीक्षी चरुं शुभम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002496005, "chapter_id": 22496, "verse_number": "१-१५८-६", "content_sanskrit": "श्रोत्रियं शूर्पमुसलं प्रोक्षणं दक्षिणायनम् ।\nअध्वर्युं सामगं विप्रं सदस्यं सदनं तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002496006, "chapter_id": 22496, "verse_number": "१-१५८-७", "content_sanskrit": "यूपं समित्स्रुवं दर्वीं मुसलोलूखलानि च ।\nप्राग्वंशं जयभूतिं च होतारं चयनं च यत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002496007, "chapter_id": 22496, "verse_number": "१-१५८-८", "content_sanskrit": "रहस्यानि प्रमाणानि स्थावराणि चराणि च ।\nप्रतिष्ठितानि दार्ढ्यं च स्थंडिलानि कुशांस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002496008, "chapter_id": 22496, "verse_number": "१-१५८-९", "content_sanskrit": "मंत्रयज्ञवहं वह्निभागं भार्गवमेव च ।\nअग्रेभुजी सोमभुजां यश्च त्रिषु उदाहृतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002496009, "chapter_id": 22496, "verse_number": "१-१५८-१०", "content_sanskrit": "आयुर्वेदविदो विप्रा यजंते शाश्वतं विभुम् ।\nतस्य भानोः सुरेशस्य वीर चंदनमालिनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002496010, "chapter_id": 22496, "verse_number": "१-१५८-११", "content_sanskrit": "प्राहुर्भावसहस्राणि समतीतान्यनेकशः ।\nभूयश्चैव भविष्यंति विनश्यंति दिनेदिने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002496011, "chapter_id": 22496, "verse_number": "१-१५८-१२", "content_sanskrit": "यत्पृच्छसि महाराज पुण्यां दिव्यां कथां शुभाम् ।\nयदर्थं भगवान्भानुः कश्यपस्य सुतोऽभवत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002496012, "chapter_id": 22496, "verse_number": "१-१५८-१३", "content_sanskrit": "तामहं त्वं प्रवक्ष्यामि शृणु सर्वमशेषतः ।\nहितार्थं सर्वमर्त्यानां लोकानां प्रभवाय च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002496013, "chapter_id": 22496, "verse_number": "१-१५८-१४", "content_sanskrit": "बहुशः सर्वभूतात्मा स्वयं समभिजायते ।\nतथा समभवद्देवः कश्यपस्यादितेः सुतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002496014, "chapter_id": 22496, "verse_number": "१-१५८-१५", "content_sanskrit": "तुष्टो दत्त्वा वरं वीर विरञ्चस्य महात्मनः ।\nयं यं जनयते पुत्रमदितिः कश्यपाद्विभोः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002496015, "chapter_id": 22496, "verse_number": "१-१५८-१६", "content_sanskrit": "स स याति विनाशं वै तत्क्षणादेव भारत ।\nदृष्ट्वा सुतान्नश्यमानान्पुत्रशोकान्विता ऽदितिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002496016, "chapter_id": 22496, "verse_number": "१-१५८-१७", "content_sanskrit": "जगाम कश्यपाभ्याशे शोकव्याकुलितेक्षणा ।\nसापश्यत्तं च मारीचं मुनिं दीप्तं तपोनिधिम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002496017, "chapter_id": 22496, "verse_number": "१-१५८-१८", "content_sanskrit": "आद्यं देवगुरुं विप्रं दिव्यं त्रिषवणांबुभिः ।\nतेजसा वह्निसंकाशं सौरं वृकसमप्रभम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002496018, "chapter_id": 22496, "verse_number": "१-१५८-१९", "content_sanskrit": "न्यस्तदण्डश्रिया युक्तं बद्धकृष्णाजिनांबरम् ।\nवल्कलाजिनसंवीतं प्रदीप्तं ब्रह्मवर्चसम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002496019, "chapter_id": 22496, "verse_number": "१-१५८-२०", "content_sanskrit": "हुताशमिव दीव्यन्तं तपन्तमिव भास्करम् ।\nअथादितिश्च दृष्ट्वैवं भर्तारममितौजसम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002496020, "chapter_id": 22496, "verse_number": "१-१५८-२१", "content_sanskrit": "शोकगद्गदया वाचा इदं वचनमब्रवीत् ।\nकिमर्थं भगवान्देवो निरुद्योगस्तु तिष्ठति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002496021, "chapter_id": 22496, "verse_number": "१-१५८-२२", "content_sanskrit": "जातोजातो हि मे पुत्रः सद्य एव विनश्यति ।\nश्रुत्वा तु वचनं तस्याः कश्यपो मुनिसत्तमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002496022, "chapter_id": 22496, "verse_number": "१-१५८-२३", "content_sanskrit": "चकार गमने बुद्धिं ब्रह्मलोकं प्रति प्रभो ।\nस गत्वा ब्रह्मभवनं नानाभावसमन्वितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002496023, "chapter_id": 22496, "verse_number": "१-१५८-२४", "content_sanskrit": "तद्वाक्य मुक्तं तं सर्वं यदुक्तं तस्य जायया ।\nकश्यपस्य वचः श्रुत्वा कञ्जजो वाक्यमब्रवीत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002496024, "chapter_id": 22496, "verse_number": "१-१५८-२५", "content_sanskrit": "पुत्र गच्छाम सदनं भानोः परमदुर्लभम् ।\nइत्युक्त्वा यानमारुह्य आग्नेयं पद्मलोचनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002496025, "chapter_id": 22496, "verse_number": "१-१५८-२६", "content_sanskrit": "वेधा जगाम भवनमादित्यस्य महात्मनः ।\nअदितिः कश्यपो ब्रह्मा जग्मुर्विपुलमाश्रिताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002496026, "chapter_id": 22496, "verse_number": "१-१५८-२७", "content_sanskrit": "ते मुहूर्तेन संप्राप्ताः सूर्यलोकं सुवर्चसम् ।\nदिव्यकामगमैर्यानैर्यथार्हं कुरुनन्दन ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002496027, "chapter_id": 22496, "verse_number": "१-१५८-२८", "content_sanskrit": "आदित्यं प्रष्टुमिच्छंति तेजसां राशिमुत्तमम् ।\nगच्छन्तस्ते च विस्तीर्णामादित्यस्य परां सभाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002496028, "chapter_id": 22496, "verse_number": "१-१५८-२९", "content_sanskrit": "षट्पदोद्गीतनिनदां साभगैस्तु समीरिताम् ।\nक्रतवो बह्वृचमुखाः प्रोक्ताः पुण्यवदक्षराः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002496029, "chapter_id": 22496, "verse_number": "१-१५८-३०", "content_sanskrit": "तुष्टुवुः पुरुषव्याघ्रं विततेषु च कर्मसु ।\nयज्ञसन्धौ वेदविदां पदक्रमविदां तथा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002496030, "chapter_id": 22496, "verse_number": "१-१५८-३१", "content_sanskrit": "घोषेण परमर्षीणां सर्वं तत्र निनादितम् ।\nयज्ञसंस्तवविद्भिश्च शिक्षाविद्भिस्तथा द्विजैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002496031, "chapter_id": 22496, "verse_number": "१-१५८-३२", "content_sanskrit": "अष्टादशपुराणज्ञैः सर्वविद्याविशारदैः ।\nमीमांसाहेतुवादज्ञैः सर्ववादविशारदैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002496032, "chapter_id": 22496, "verse_number": "१-१५८-३३", "content_sanskrit": "लोकायतिकमुख्यैश्च तुष्टुवुः सूर्यमीरितम् ।\nतत्रतत्र च विप्रेन्द्रान् नियताञ्छंसितव्रतान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002496033, "chapter_id": 22496, "verse_number": "१-१५८-३४", "content_sanskrit": "जपहोमपरान्योग्यान्ददृशुः कश्यपादयः ।\nतस्यां सभायामास्ते स रश्मिमाली दिवाकरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002496034, "chapter_id": 22496, "verse_number": "१-१५८-३५", "content_sanskrit": "सुरासुरगुरुः श्रीमाञ्छुशुभे वीर मायया ।\nउपासते च तत्रैव प्रजानां पतिमीश्वरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002496035, "chapter_id": 22496, "verse_number": "१-१५८-३६", "content_sanskrit": "दक्षः प्रचेताः पुलहो मरीचिश्च द्विजोत्तमः ।\nभृगुरत्रिर्वशिष्ठश्च गौतमो नारदस्तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002496036, "chapter_id": 22496, "verse_number": "१-१५८-३७", "content_sanskrit": "दिव्या आत्मांतरिक्षं च वायुस्तेजोबलं मही ।\nशब्दः स्पर्शः स्वरूपं च रसगन्धौ तथैव च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002496037, "chapter_id": 22496, "verse_number": "१-१५८-३८", "content_sanskrit": "प्रकृतिश्च विकाराश्च यच्चान्यत्कारणं महत् ।\nसांगोपागाश्च चत्वारो वेदा लोकपते तथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002496038, "chapter_id": 22496, "verse_number": "१-१५८-३९", "content_sanskrit": "लवाश्च ऋतवश्चैव संकल्पप्रणवास्तथा ।\nएते चान्ये च बहवो भानुमंतमुपासते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002496039, "chapter_id": 22496, "verse_number": "१-१५८-४०", "content_sanskrit": "अर्थो धर्मश्च कामश्च मोक्षश्च सविशेषतः ।\nद्वेषो हर्षश्च मोहश्च मत्सरो मान एव च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002496040, "chapter_id": 22496, "verse_number": "१-१५८-४१", "content_sanskrit": "वृको विष्णुसुतः पुत्रः पुष्पजो धिषणस्तथा ।\nमाहेश्वरस्तथा सौरो विटपो विकचस्तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002496041, "chapter_id": 22496, "verse_number": "१-१५८-४२", "content_sanskrit": "मारुतो विश्वकर्मा च अश्वि नावन्यवाहनौ ।\nएवमुक्तः सुवचनैर्भानुना प्रभविष्णुना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002496042, "chapter_id": 22496, "verse_number": "१-१५८-४३", "content_sanskrit": "जगाम कश्यपो वीर सहादित्या स्वमाश्रमम् ।\nअदितिर्देवमाता च तं गर्भं निदधे स्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002496043, "chapter_id": 22496, "verse_number": "१-१५८-४४", "content_sanskrit": "भूतात्मानं महात्मानं दिव्यं वर्षसहस्रकम् ।\nपूर्णे वर्षसहस्रे तु प्रवृत्तो गर्भ उत्तमः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002496044, "chapter_id": 22496, "verse_number": "१-१५८-४५", "content_sanskrit": "सुराणां शरणं देवश्चासुराणां विनाशनः ।\nगर्भस्थेन तु तेनैव परित्रातः सुतस्तथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002496045, "chapter_id": 22496, "verse_number": "१-१५८-४६", "content_sanskrit": "आददानस्तु तेजांसि त्रैलोक्यस्य नराधिप ।\nतस्मिञ्जाते तु देवेशे त्रैलोक्यस्य सुखावहे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002496046, "chapter_id": 22496, "verse_number": "१-१५८-४७", "content_sanskrit": "प्रहत्य दैत्यसंघांश्च सुराणां नादवर्धने ।\nअभवत्परमानन्दः सर्वेषां तत्र तस्थुषाम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]