[{"id": 2070048, "chapter_id": 2466, "verse_number": "१०-१८-०x", "content_sanskrit": "कश्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070049, "chapter_id": 2466, "verse_number": "१०-१८-१", "content_sanskrit": "ततो देवयुगेऽतीते देवा वै समकल्पयन्।\nयज्ञवेदप्रमाणेन विधिवद्यष्टुमीप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070050, "chapter_id": 2466, "verse_number": "१०-१८-२", "content_sanskrit": "कल्पयामासुरथ ते साधनानि हवींषि च।\nभागार्हा देवताश्चैव यज्ञियं द्रव्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070051, "chapter_id": 2466, "verse_number": "१०-१८-३", "content_sanskrit": "ता वै रुद्रमजानन्त्यो याथातथ्येन देवताः।\nनाकल्पयन्त देवस्य स्थाणोर्भागं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070052, "chapter_id": 2466, "verse_number": "१०-१८-४", "content_sanskrit": "सोऽकल्प्यमाने भागे तु कृत्तिवासा मखेऽमरैः।\nतपसा यज्ञमन्विच्छन्धनुरादौ ससर्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070053, "chapter_id": 2466, "verse_number": "१०-१८-५", "content_sanskrit": "लोकयज्ञः क्रियायज्ञो गृहयज्ञः सनातनः।\nपञ्चभूतनृयज्ञश्च जज्ञे सर्वमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070054, "chapter_id": 2466, "verse_number": "१०-१८-६", "content_sanskrit": "लोकयज्ञैर्नृयज्ञैश्च कपर्दी विदधे धनुः।\nधनुः सृष्टमभूत्तस्य षष्टिकिष्कुप्रमाणतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070055, "chapter_id": 2466, "verse_number": "१०-१८-७", "content_sanskrit": "वषट्कारोऽभवज्ज्या तु धनुषस्तस्य भारत।\nयज्ञाङ्गानि च चत्वारि तस्य सन्नहनेऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070056, "chapter_id": 2466, "verse_number": "१०-१८-८", "content_sanskrit": "ततः क्रुद्धो महादेवस्दुपादाय कार्मुकम्।\nआजगामाथ तत्रैव यत्र देवाः समीजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070057, "chapter_id": 2466, "verse_number": "१०-१८-९", "content_sanskrit": "तमात्कार्मुकं दृष्ट्वा ब्रह्मचारिणमव्ययम्।\nविव्यथे पृथिवी देवी पर्वताश्च चकम्पिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070058, "chapter_id": 2466, "verse_number": "१०-१८-१०", "content_sanskrit": "न ववौ पवनश्चैव नाग्निर्जज्वाल वैधितः।\nव्यभ्रमच्चापि संविग्नं दिवि नक्षत्रमण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070059, "chapter_id": 2466, "verse_number": "१०-१८-११", "content_sanskrit": "न बभौ भास्करश्चापि सोमः श्रीमुक्तमण्डलः।\nतिमिरेणाकुलं सर्वमाकाशं चाभवृद्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070060, "chapter_id": 2466, "verse_number": "१०-१८-१२", "content_sanskrit": "अभिभूतास्ततो देवा विषयान्न प्रजज्ञिरे।\nन प्रत्यभाच्च यज्ञः स देवतास्त्रेसिरे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070061, "chapter_id": 2466, "verse_number": "१०-१८-१३", "content_sanskrit": "ततः स यज्ञं विव्याध रौद्रेण हृदि पत्रिणा।\nअपक्रान्स्ततो यज्ञो मृगो भूत्वा सपावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070062, "chapter_id": 2466, "verse_number": "१०-१८-१४", "content_sanskrit": "स तु तेनैव रूपेण दिविस्थो वै व्यराजत।\nअन्वीयमानो रुद्रेण युधिष्ठिर नभस्तले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070063, "chapter_id": 2466, "verse_number": "१०-१८-१५", "content_sanskrit": "अपक्रान्ते ततो यज्ञे संज्ञा न प्रत्यभात्सुरान्।\nनष्टसंज्ञेषु देवेषु न प्राज्ञायत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070064, "chapter_id": 2466, "verse_number": "१०-१८-१६", "content_sanskrit": "त्र्यम्बकः सवितुर्बाहू भगस्य नयने तथा।\nपूष्णश्च दशनान्क्रुद्धो धनुष्कोट्या व्यशातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070065, "chapter_id": 2466, "verse_number": "१०-१८-१७", "content_sanskrit": "प्राद्रवन् ततो देवा यज्ञाङ्गानि च सर्वशः।\nकेचित्तत्रैव घूर्णन्तो गतासव इवाभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070066, "chapter_id": 2466, "verse_number": "१०-१८-१८", "content_sanskrit": "स तु विद्राव्य तत्सर्वं शितिकम्ठोऽवहस्य च।\nअवष्टभ्य धनुष्कोटिं रुरोध विबुधांस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070067, "chapter_id": 2466, "verse_number": "१०-१८-१९", "content_sanskrit": "ततो वागमरैरुक्ता ज्यां तस्य धनुषोऽच्छिनत्।\nअथ तत्सहसा राजंश्छिन्नज्यं विस्फुरद्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070068, "chapter_id": 2466, "verse_number": "१०-१८-२०", "content_sanskrit": "ततो विधनुषं देवा देवश्रेष्ठमुपागमन्।\nशरणं सह यज्ञेन प्रसादं चाकरोत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070069, "chapter_id": 2466, "verse_number": "१०-१८-२१", "content_sanskrit": "ततः प्रसन्नो भगवान्प्रास्यत्कोपं जलाशये।\nस जलं पावको भूत्वा शोषयत्यनिशं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070070, "chapter_id": 2466, "verse_number": "१०-१८-२२", "content_sanskrit": "भगस्य नयने चैव बाहू च सवितुस्तथा।\nप्रादात्पूष्णश्च दशनान्पुनर्यज्ञांश्च पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070071, "chapter_id": 2466, "verse_number": "१०-१८-२३", "content_sanskrit": "ततः सुस्थमिदं सर्वं बभूव पुनरेव हि।\nसर्वाणि च हवींष्यस्य देवा भागमकल्पयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070072, "chapter_id": 2466, "verse_number": "१०-१८-२४", "content_sanskrit": "तस्मिन्क्रुद्धेऽभवत्सर्वमसुस्थं भुवनं प्रभो।\nप्रसन्ने च पुनः सुस्थं जगद्भवति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070073, "chapter_id": 2466, "verse_number": "१०-१८-२५", "content_sanskrit": "ततस्ते निहताः सर्वे तव पुत्रा महारथाः।\nअन्ये च बहवः शूराः पाञ्चालस्य पदानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070074, "chapter_id": 2466, "verse_number": "१०-१८-२६", "content_sanskrit": "न तन्मनसि कर्व्यं न च तद्द्रौणिना कृतम्।\nमहादेवप्रसादः स कुरुकार्यमनन्तरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070075, "chapter_id": 2466, "verse_number": "१०-१८-१", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्रिकायां संहितायां वैयासिक्यां सौप्तिकपर्वणि ऐषीकपर्वणि अष्टादशोऽध्यायः॥ १८ ॥ समाप्तं ऐषीकपर्व ॥ २ ॥ सौप्तिकपर्व च समाप्तम्॥ १० ॥\nअस्यानन्रं स्त्रीपर्व भविष्यति\nतस्यायमाद्यः श्लोकः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070076, "chapter_id": 2466, "verse_number": "", "content_sanskrit": "जनमेजय उवाच।\nहते दुर्योधने चैव हते सैन्ये च सर्वशः।\nधृतराष्ट्रो महाराज श्रुत्वा किमकरोन्मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]