[{"id": 2028458, "chapter_id": 1617, "verse_number": "३-२५५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028459, "chapter_id": 1617, "verse_number": "३-२५५-१", "content_sanskrit": "ततः कर्णो महेष्वासो बलेन महता वृतः।\nद्रुपदस्य पुरं रम्यं रुरोध भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028460, "chapter_id": 1617, "verse_number": "३-२५५-२", "content_sanskrit": "युद्धेन महता चैनं चक्रे वीरं वशानुगम्।\nसुवर्णं रजतं चापि रत्नानि विविधानि च।\nकरं च दापयांमास द्रुपदं नृपसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028461, "chapter_id": 1617, "verse_number": "३-२५५-३", "content_sanskrit": "तं विनिर्जित्य राजेन्द्र राजानस्तस्य येऽनुगाः।\nतान्सर्वान्वशगांश्चक्रे करं चैनानदापयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028462, "chapter_id": 1617, "verse_number": "३-२५५-४", "content_sanskrit": "अथोत्तरां दिशं गत्वा वशे चक्रे नराधिपान्।\nभगदत्तं च निर्जित्य राधेयो गिरिमारुहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028463, "chapter_id": 1617, "verse_number": "३-२५५-५", "content_sanskrit": "हिमवन्तं महाशैलं युध्यमानश्च शत्रुभिः।\nप्रययौ च दिशः सर्वान्नृपतीन्वशमानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028464, "chapter_id": 1617, "verse_number": "३-२५५-६", "content_sanskrit": "स हैमवतिकाञ्जित्वा करं सर्वानदापयत्।\nनेपालविषये ये च राजानस्तानवाजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028465, "chapter_id": 1617, "verse_number": "३-२५५-७", "content_sanskrit": "अवतीर्य ततः शैलात्पूर्वां दिशमभिद्रुतः।\nअङ्गान्वङ्गान्कलिङ्गांश्च शुण्डिकान्मिथिलानथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028466, "chapter_id": 1617, "verse_number": "३-२५५-८", "content_sanskrit": "मागधान्कर्कखण्डांश्च निवेश्य विषयेऽऽत्मनः।\nआवशीरांश्च योध्यांश्च अहिक्षत्रांश्च सोऽजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028467, "chapter_id": 1617, "verse_number": "३-२५५-९", "content_sanskrit": "पूर्वां दिशं विनिर्जित्य वत्सभूमिं तथाऽगमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028468, "chapter_id": 1617, "verse_number": "३-२५५-१०", "content_sanskrit": "वत्सभूमिं विनिर्जित्य केवलां मृत्तिकावतीम्।\nमोहनं पत्तनं चैव त्रिपुरीं कोसलां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028469, "chapter_id": 1617, "verse_number": "३-२५५-११", "content_sanskrit": "एतान्सर्वान्विनिर्जित्य करमादाय सर्वशः।\nदक्षिणां दिशमास्थाय कर्णो जित्वा महारथान्।\nरुक्मिणं दाक्षिणात्येषु योधयामास सूतजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028470, "chapter_id": 1617, "verse_number": "३-२५५-१२", "content_sanskrit": "स युद्धं तुमुलं कृत्वा रुक्मी प्रोवाच सूतजम्।\nप्रीतोस्मि तव राजेन्द्र विक्रमेण बलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028471, "chapter_id": 1617, "verse_number": "३-२५५-१३", "content_sanskrit": "न ते विघ्नं करिष्यामि प्रतिज्ञां समपालयम्।\nप्रीत्या चाहं प्रयच्छामि हिरण्यं यावदिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028472, "chapter_id": 1617, "verse_number": "३-२५५-१४", "content_sanskrit": "समेत्य रुक्मिणा कर्णः पाण्ड्यं शैलं च सोगमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028473, "chapter_id": 1617, "verse_number": "३-२५५-१५", "content_sanskrit": "स केवलं रणए चैव नीलं चापि महीपतिम्।\nवेणुदारिसुतं चैव ये चान्ये नृपसत्तमाः।\nदक्षिणस्यां दिशि नृपान्करान्सर्वानदापयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028474, "chapter_id": 1617, "verse_number": "३-२५५-१६", "content_sanskrit": "शैशुपालिं ततो गत्वा विजिग्ये सूतनन्दनः।\nपार्श्वस्थांश्चापि नृपतीन्वशे चक्रे महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028475, "chapter_id": 1617, "verse_number": "३-२५५-१७", "content_sanskrit": "आवन्त्यांश्च वशे कृत्वा साम्ना च भरतर्षभ।\nवृष्णिभिः सह संम्य पश्चिमामपि निर्जयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028476, "chapter_id": 1617, "verse_number": "३-२५५-१८", "content_sanskrit": "वारुणीं दिशमागम्य यावनान्वर्बरांस्तथा।\nनृपान्पश्चिमभूमिस्थान्दापयामास वै करान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028477, "chapter_id": 1617, "verse_number": "३-२५५-१९", "content_sanskrit": "विजित्य पृथिवीं सर्वां सपूर्वापरदक्षिणाम्।\nसम्लेच्छाटविकान्वीरः सपर्वतनिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028478, "chapter_id": 1617, "verse_number": "३-२५५-२०", "content_sanskrit": "भद्रान्रोहितकांश्चैव आग्रेयान्मालवानपि।\nगणान्सर्वान्विनिर्जित्य नीतिकृत्प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028479, "chapter_id": 1617, "verse_number": "३-२५५-२१", "content_sanskrit": "शशकान्यवनांश्चैव विजिग्ये सूतनन्दनः।\nनग्नजित्प्रमुखांश्चैव गणाञ्जित्वा महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028480, "chapter_id": 1617, "verse_number": "३-२५५-२२", "content_sanskrit": "एवं स पृथिवीं सर्वां वशे कृत्वा महारथः।\nविजित्य पुरुषव्याघ्रो नागसाह्वयमागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028481, "chapter_id": 1617, "verse_number": "३-२५५-२३", "content_sanskrit": "तमागतं महेष्वासं धार्तराष्ट्रो जनाधिपः।\nप्रत्युद्गत्य महाराज सभ्रातृपितृबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028482, "chapter_id": 1617, "verse_number": "३-२५५-२४", "content_sanskrit": "अर्चयामास विधिना कर्णमाहवशोभिनम्।\nआश्रावयच्च तत्कर्म प्रीयमाणो जनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028483, "chapter_id": 1617, "verse_number": "३-२५५-२५", "content_sanskrit": "यन्न भीष्मान्न च द्रोणान्न कृपान्न च वाह्लिकात्।\nप्राप्तवानस्मि भद्रं ते त्वत्तःप्राप्तं मया हि तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028484, "chapter_id": 1617, "verse_number": "३-२५५-२६", "content_sanskrit": "बहुना च किमुक्तेन शृणु कर्ण वचो मम।\nसनाथोस्मि महाबाहो त्वया नाथेन सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028485, "chapter_id": 1617, "verse_number": "३-२५५-२७", "content_sanskrit": "न हि ते पाण्डवाः सर्वे कलामर्हन्ति षोडशीम्।\nअन्येवा पुरुषव्याघ्र राजानोऽभ्युदितोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028486, "chapter_id": 1617, "verse_number": "३-२५५-२८", "content_sanskrit": "स भवान्धृतराष्ट्रं तं गान्धारीं च यशस्विनीम्।\nपश्य कर्ण महेष्वास अदितिं वज्रभृद्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028487, "chapter_id": 1617, "verse_number": "३-२५५-२९", "content_sanskrit": "ततो हलहलाशब्दः प्रादुरासीद्विशांपते।\nहाहाकाराश्च बहवो नगरे नागसाह्वये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028488, "chapter_id": 1617, "verse_number": "३-२५५-३०", "content_sanskrit": "रकेचिदेनं प्रशंसन्ति निन्दन्ति स्म तथा परे।\nतूष्णीमासंस्तथा चान्ये नृपास्तत्र जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028489, "chapter_id": 1617, "verse_number": "३-२५५-३१", "content_sanskrit": "एवं विजित्य राजेन्द्र कर्णः शस्त्रभृतांवरः।\nसपर्वतवनाकाशां ससमुद्रां सनुष्कुटाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028490, "chapter_id": 1617, "verse_number": "३-२५५-३२", "content_sanskrit": "देशैरुच्चावचैः पूर्णां पत्तनैर्नगरैरपि।\nद्वीपैश्चानूपसंपूर्णैः पृथिवीं पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028491, "chapter_id": 1617, "verse_number": "३-२५५-३३", "content_sanskrit": "कालेन नातिदीर्घेण वशे कृत्वा तु पार्थिवान्।\nअक्षयं धनमादाय सूतजो नृपमभ्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028492, "chapter_id": 1617, "verse_number": "३-२५५-३४", "content_sanskrit": "प्रविश्य च गृहं राजन्नभ्यन्तरमरिंदम।\nगान्धारीसहितं वीरो धृतराष्ट्रं ददर्श सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028493, "chapter_id": 1617, "verse_number": "३-२५५-३५", "content_sanskrit": "पुत्रवच्च नरव्याघ्र पादौ जग्राह धर्मवित्।\nधृतराष्ट्रेण चाश्लिष्य प्रेम्णा चापि विसर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028494, "chapter_id": 1617, "verse_number": "३-२५५-३६", "content_sanskrit": "तदाप्रभृति राजा च शकुनिश्चापि सौबलः।\nजानाते निर्जितान्पार्थान्कर्णेन युधि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028495, "chapter_id": 1617, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि पञ्चपञ्चाशदधिकद्विशततमोऽध्यायः ॥ २५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]