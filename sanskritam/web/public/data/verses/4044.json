[{"id": 2141071, "chapter_id": 4044, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141072, "chapter_id": 4044, "verse_number": "१", "content_sanskrit": "ततः सुदर्शनं नाम प्रासादं हरिवाहनः ।\nसर्वान् देवान् समारोप्य प्रययौ यत्र पाण्डवः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141073, "chapter_id": 4044, "verse_number": "२", "content_sanskrit": "स्थूणा राजन् सहस्रं तु यत्र मध्ये प्रतिष्ठितम् ।\nतत्र सूर्यपथेऽतिष्ठद् विमला वासवी सभा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141074, "chapter_id": 4044, "verse_number": "३", "content_sanskrit": "आदित्या वसवो रुद्रा अश्विनौ च मरुद्गणाः ।\nतत्र श्वेतानि च्छत्राणि काञ्चनस्फाटिकानि च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141075, "chapter_id": 4044, "verse_number": "४", "content_sanskrit": "तथा चित्राणि च्छत्राणि दिव्यरूपाणि भारत ।\nमणिरत्नविचित्राणि नानारूपाणि भागशः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141076, "chapter_id": 4044, "verse_number": "५", "content_sanskrit": "आकाशे समदृश्यन्त भानुमन्ति शुभानि च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141077, "chapter_id": 4044, "verse_number": "६", "content_sanskrit": "अग्नेरिन्द्रस्य सोमस्य यमस्य वरुणस्य च ।\nतथा धातुर्विधातुश्च मित्रस्य धनदस्य च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141078, "chapter_id": 4044, "verse_number": "७", "content_sanskrit": "रुद्रस्य विष्णोः सवितुस्त्रिदशानां तथैव च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141079, "chapter_id": 4044, "verse_number": "८", "content_sanskrit": "काञ्चनानि च दामानि विविधाश्चोत्तमस्रजः ।\nदिव्यपुष्पाभिसंवीतास्तत्र च्छत्राणि भेजिरे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141080, "chapter_id": 4044, "verse_number": "९", "content_sanskrit": "तस्मिंश्च राजन् प्रासादे दिव्यरत्नविभूषिते ।\nदिव्यगन्धसमाविष्टाः स्रजो दिव्याश्चकाशिरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141081, "chapter_id": 4044, "verse_number": "१०", "content_sanskrit": "दिव्यश्च वायुः प्रववौ गन्धमादाय सर्वशः ।\nऋतवः पुष्पमादाय समतिष्ठन्त भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141082, "chapter_id": 4044, "verse_number": "११", "content_sanskrit": "प्रजानां पतयः सप्त सप्त चैव महर्षयः ।\nतत्र देवर्षयश्चैव ते च रेजुर्दिवौकसः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141083, "chapter_id": 4044, "verse_number": "१२", "content_sanskrit": "इन्द्रेण सहिताः सर्वे त्रिदशाश्च व्यवस्थिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141084, "chapter_id": 4044, "verse_number": "१३", "content_sanskrit": "न पङ्को न रजस्तत्र प्रविवेश कथञ्चन ।\nआदित्यश्चापि रूक्षोऽत्र नातिवेलमिवातपत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141085, "chapter_id": 4044, "verse_number": "१४", "content_sanskrit": "दिव्यगन्धं समादाय वायुस्तत्राभिगच्छति ।\nप्रकाशं त्रिदिवः सर्वादर्शनीयमदृश्यत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141086, "chapter_id": 4044, "verse_number": "१५", "content_sanskrit": "तत्र देवाः समारुँह्य तं दिव्यं सर्वतःप्रभाम् ।\nअम्बरे विमलेऽगच्छन् प्रासादं गामगामिनीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141087, "chapter_id": 4044, "verse_number": "१६", "content_sanskrit": "तत्र राजर्षयश्चैव समारूढा दिवौकसः ।\nश्वेतो राजा वसुमनास्तथा भद्रः प्रतर्दनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141088, "chapter_id": 4044, "verse_number": "१७", "content_sanskrit": "नृगो ययातिर्नहुषो मान्धाता भरतः पुरुः ।\nअष्टकश्च शिबिश्चोभौ स च राजा पुरूरवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141089, "chapter_id": 4044, "verse_number": "१८", "content_sanskrit": "डम्भोद्भवः कार्तवीर्यो ह्यर्जुनः सगरस्तथा ।\nदिलीपः केरळः पूरुः शर्यातिः सोमकस्तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141090, "chapter_id": 4044, "verse_number": "१९", "content_sanskrit": "हरिश्चन्द्रश्च तेजस्वी रघुर्दशरथस्तथा ।\nभगीरथश्च राजर्षिः सर्वे च जनमेजय\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141091, "chapter_id": 4044, "verse_number": "२०", "content_sanskrit": "पाण्डुश्चैव महाबाहुश्चामरव्यजनैर्युतः ।\nछत्रेण ध्रियमाणेन राजसूयश्रिया वृतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141092, "chapter_id": 4044, "verse_number": "२१", "content_sanskrit": "एते चान्ये च बहवः सत्यशीलाः शुचिव्रताः ।\nकीर्तिमन्तो महावीर्यास्तत्रैवासन् दिवि स्थिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141093, "chapter_id": 4044, "verse_number": "२२", "content_sanskrit": "गणाश्चाप्सरसां सर्वे गन्धर्वाश्चापि सर्वशः ।\nदैत्यराक्षसयक्षाश्च सुपर्णाः पन्नगास्तथा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141094, "chapter_id": 4044, "verse_number": "२३", "content_sanskrit": "वासवप्रमुखाः सर्वे देवाश्च सगणेश्वराः ।\nआसंस्तत्र समारूढाः सङ्ग्रामं तं दिदृक्षवः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141095, "chapter_id": 4044, "verse_number": "२४", "content_sanskrit": "इत्यम्बरे व्यवस्थाय प्रासादस्था दिवौकसः ।\nएकस्य च बहूनां च द्रष्टुं युद्धं व्यवस्थिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141096, "chapter_id": 4044, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि द्विपञ्चाशोऽध्यायः ॥५२॥ गोग्रहणपर्वणि पञ्चविंशोऽध्यायः ॥२५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]