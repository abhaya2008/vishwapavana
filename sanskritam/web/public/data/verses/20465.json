[{"id": 7000465000, "chapter_id": 20465, "verse_number": "३-१२-१", "content_sanskrit": "वसिष्ठ उवाच ।\nप्रदक्षिणमुपावृत्तो जंबूमार्गे समाविशेत् ।\nजंबूमार्गं समाविश्य पितृदेवर्षिपूजितम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000465001, "chapter_id": 20465, "verse_number": "३-१२-२", "content_sanskrit": "अश्वमेधमवाप्नोति विष्णुलोकं च गच्छति ।\nतत्रोष्य रजनीः पंच षष्ठकालेश्नुवन्नरः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000465002, "chapter_id": 20465, "verse_number": "३-१२-३", "content_sanskrit": "न दुर्गतिमवाप्नोति सिद्धिं चाप्नोत्यनुत्तमाम् ।\nजंबुमार्गादुपावृत्तो गच्छेत्तु दुलिकाश्रमम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000465003, "chapter_id": 20465, "verse_number": "३-१२-४", "content_sanskrit": "न दुर्गतिमवाप्नोति स्वर्गलोके च पूज्यते ।\nअगस्त्याश्रममासाद्य पितृदेवार्चने रतः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000465004, "chapter_id": 20465, "verse_number": "३-१२-५", "content_sanskrit": "त्रिरात्रोपोषितो राजन्नग्निष्टोमफलं लभेत् ।\nशाकवृत्तिः फलैर्वापि कौमारं विंदते परम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000465005, "chapter_id": 20465, "verse_number": "३-१२-६", "content_sanskrit": "कन्याश्रमं समासाद्य श्रीपुष्टं लोकपूजितम् ।\nधर्मारण्यं हि तत्पुण्यमाद्यं च पार्थिवर्षभ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000465006, "chapter_id": 20465, "verse_number": "३-१२-७", "content_sanskrit": "यत्र प्रविष्टमात्रो वै पापेभ्यो विप्रमुच्यते ।\nअर्चयित्वा पितॄन्देवान्प्रयतो नियताशनः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000465007, "chapter_id": 20465, "verse_number": "३-१२-८", "content_sanskrit": "सर्वकामसमृद्धस्य यज्ञस्य फलमश्नुते ।\nप्रादक्षिण्यं ततः कृत्वा ययातिपतनं व्रजेत्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000465008, "chapter_id": 20465, "verse_number": "३-१२-९", "content_sanskrit": "हयमेधस्य यज्ञस्य फलमाप्नोति तत्र वै ।\nमहाकालमतो गच्छेन्नियतो नियताशनः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000465009, "chapter_id": 20465, "verse_number": "३-१२-१०", "content_sanskrit": "कोटितीर्थमुपस्पृश्य हयमेधफलं लभेत् ।\nततो गच्छेत धर्मज्ञ स्थानं तीर्थमुमापतेः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000465010, "chapter_id": 20465, "verse_number": "३-१२-११", "content_sanskrit": "नाम्ना भद्रवटं नाम त्रिषु लोकेषु विश्रुतम् ।\nतत्राभिगम्य चेशानं गोसहस्रफलं लभेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000465011, "chapter_id": 20465, "verse_number": "३-१२-१२", "content_sanskrit": "महादेवप्रसादाच्च गाणपत्यमवाप्नुयात् ।\nसमृद्धमसपत्नं तु श्रियायुक्तं नरोत्तम॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000465012, "chapter_id": 20465, "verse_number": "३-१२-१३", "content_sanskrit": "नर्मदां तु समासाद्य नदीं त्रैलोक्यविश्रुताम् ।\nतर्पयित्वा पितॄन्देवानग्निष्टोमफलं लभेत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]