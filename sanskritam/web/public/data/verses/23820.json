[{"id": 7003820000, "chapter_id": 23820, "verse_number": "२-४-७-१", "content_sanskrit": "नारद उवाच ।\nभगवन्कृतकृत्योऽस्मि तव पादसमाश्रयात् ।\nश्रोतव्यं नेह भूयो मे विद्यते देवसत्तम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003820001, "chapter_id": 23820, "verse_number": "२-४-७-२", "content_sanskrit": "तथापि भगवन्किंचित्प्रष्टव्यं मे हृदि स्थितम् ।\nत्वद्वाक्यामृतपीतस्य न मे तृप्तिर्हि जायते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003820002, "chapter_id": 23820, "verse_number": "२-४-७-३", "content_sanskrit": "दीपदानस्य माहात्म्यं श्रोतुमिच्छामि ते प्रभो ।\nयेन चाऽपि पुरा दत्तस्तद्वदस्व चतुर्मुख ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003820003, "chapter_id": 23820, "verse_number": "२-४-७-४", "content_sanskrit": "ब्रह्मोवाच ।\nप्रातः स्नात्वा शुचिर्भूत्वा दीपं दद्यात्प्रयत्नतः ।\nतेन पापानि नश्येयुस्तमांसीव भगोदये ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003820004, "chapter_id": 23820, "verse_number": "२-४-७-५", "content_sanskrit": "आजन्म यत्कृतं पापं स्त्रिया वा पुरुषेण च ।\nतत्सर्वं नाशमायाति कार्तिके दीपदानतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003820005, "chapter_id": 23820, "verse_number": "२-४-७-६", "content_sanskrit": "अत्र ते वर्णयिष्यामि इतिहासं पुरातनम् ।\nश्रवणात्सर्वपापघ्नं दीपदानफलप्रदम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003820006, "chapter_id": 23820, "verse_number": "२-४-७-७", "content_sanskrit": "पुरा द्रविडदेशे तु ब्राह्मणो बुद्धनामकः ।\nतस्य भार्याऽभवद्दुष्टा अनाचाररता मुने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003820007, "chapter_id": 23820, "verse_number": "२-४-७-८", "content_sanskrit": "तस्याः संसर्गदोषेण क्षीणाऽयुर्मृतिमाप्तवान् ।\nपत्यौ मृतेऽपि सा पत्नी अनाचारे विशेषतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003820008, "chapter_id": 23820, "verse_number": "२-४-७-९", "content_sanskrit": "रताभून्न हि तस्यास्तु लज्जा लोकापवादतः ।\nसुतबंधुविहीना सा सदाभिक्षान्नभोजना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003820009, "chapter_id": 23820, "verse_number": "२-४-७-१०", "content_sanskrit": "न संस्कारान्नमल्पं वा भुक्त्वा पर्युषिताशिनी ।\nपरपाकरता नित्यं तीर्थयात्रादिवर्जिता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003820010, "chapter_id": 23820, "verse_number": "२-४-७-११", "content_sanskrit": "कथायाः श्रवणं चैव न श्रुतं तु तया द्विज ।\nएकदा ब्राह्मणः कश्चित्तीर्थयात्रापरायणः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003820011, "chapter_id": 23820, "verse_number": "२-४-७-१२", "content_sanskrit": "तस्या गृहं समागच्छद्विद्वान्वै कुत्सनामकः ।\nअनाचाररतां तां तु दृष्ट्वा ब्रह्मर्षिसत्तमः ।\nकोपेन रक्तचक्षुः संस्तामुवाचाऽसतीं स्त्रियम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003820012, "chapter_id": 23820, "verse_number": "२-४-७-१३", "content_sanskrit": "कुत्स उवाच ।\nवक्ष्यामि सांप्रतं मूढे मद्वाक्यमवधारय ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003820013, "chapter_id": 23820, "verse_number": "२-४-७-१४", "content_sanskrit": "दुःखहेतुमिमं देहं पूयशोणितपूरितम् ।\nपंचभूतात्मकं चैव किं च पुष्णासि दूतिके ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003820014, "chapter_id": 23820, "verse_number": "२-४-७-१५", "content_sanskrit": "जलबुद्बुदवद्देहो नाशमायाति निश्चितम् ।\nअनित्यं देहमाश्रित्य नित्यं त्वं मन्यसे हृदि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003820015, "chapter_id": 23820, "verse_number": "२-४-७-१६", "content_sanskrit": "तस्मादंतःस्थितं मोहं त्यज मूढे विचारतः ।\nस्मर सर्वोत्तमं देवं कुरु श्रवणमादरात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003820016, "chapter_id": 23820, "verse_number": "२-४-७-१७", "content_sanskrit": "कार्तिके मासि संप्राप्ते स्नानदानादिकं कुरु ।\nदामोदरस्य प्रीत्यर्थं दीपदानं तथा कुरु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003820017, "chapter_id": 23820, "verse_number": "२-४-७-१८", "content_sanskrit": "लक्षवर्त्यादिकं चैव लक्षपद्मादिकं तथा ।\nप्रदक्षिणां तु देवस्य नमस्कारं तथैव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003820018, "chapter_id": 23820, "verse_number": "२-४-७-१९", "content_sanskrit": "धारणं पारणं चैव कुरु भक्त्या हि कार्तिके ।\nविधवानां व्रतमिदं सधवानां तथैव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003820019, "chapter_id": 23820, "verse_number": "२-४-७-२०", "content_sanskrit": "सर्वपापप्रशमनं सर्वोपद्रवनाशनम् ।\nतत्राऽपि कार्तिके मासि दीयतां दीप उत्तमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003820020, "chapter_id": 23820, "verse_number": "२-४-७-२१", "content_sanskrit": "दीपो हरेः प्रियकरः कार्तिके मासि निश्चितम् ।\nमहापातककृद्वापि दीपदानात्प्रमुच्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003820021, "chapter_id": 23820, "verse_number": "२-४-७-२२", "content_sanskrit": "पुरा कश्चिद्द्विजवरो नाम्ना हरिकरो ह्यभूत् ।\nअधर्मविषयासक्तः शश्वद्वेश्यारतो द्विजः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003820022, "chapter_id": 23820, "verse_number": "२-४-७-२३", "content_sanskrit": "पितृवित्तक्षयकरो वंशच्छेदे कुठारकः ।\nकदाचित्तेन विधवे द्यूते पितृधनं महत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003820023, "chapter_id": 23820, "verse_number": "२-४-७-२४", "content_sanskrit": "हारितं दुष्टसंसर्गात्ततो दुःखी स चाऽभवत् ।\nकदाचित्साधुसंसर्गात्तीर्थयात्राप्रसंगतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003820024, "chapter_id": 23820, "verse_number": "२-४-७-२५", "content_sanskrit": "अयोध्यामागतो वत्से महापापकरो द्विजः ।\nकार्तिके मासि संप्राप्तः श्रीमद्द्विजगृहे सदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003820025, "chapter_id": 23820, "verse_number": "२-४-७-२६", "content_sanskrit": "द्यूतव्याजेन तेनाऽशु दीपो दत्तो हरेः पुरः ।\nततः कालांतरे विप्रो मृतो मोक्षमवाप्तवान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003820026, "chapter_id": 23820, "verse_number": "२-४-७-२७", "content_sanskrit": "महापातककृद्वाऽपि गतवानभयं हरिम् ।\nतस्मात्त्वं कार्तिके मासि दीपदानं तथा कुरु ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003820027, "chapter_id": 23820, "verse_number": "२-४-७-२८", "content_sanskrit": "तथाऽन्यान्यपि दानानि कुरु भक्तिसमन्विता ।\nइत्यादिश्याथ तां कुत्सो जगामाऽन्यगृहं द्विजः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003820028, "chapter_id": 23820, "verse_number": "२-४-७-२९", "content_sanskrit": "साऽपि कुत्सवचः श्रुत्वा पश्चात्तापेन संयुता ।\nव्रतं तु कार्तिके मासि करिष्यामीति निश्चिता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003820029, "chapter_id": 23820, "verse_number": "२-४-७-३०", "content_sanskrit": "पतंगोदयवेलायां कार्तिके स्नानमंभसि ।\nदीपदानं वत चैव मासमेकं चकार सा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003820030, "chapter_id": 23820, "verse_number": "२-४-७-३१", "content_sanskrit": "ततः कालांतरे चैव गतायुर्मृतिमागता ।\nदीपदानस्य माहात्म्यान्महापापकृदप्यसौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003820031, "chapter_id": 23820, "verse_number": "२-४-७-३२", "content_sanskrit": "स्वर्गमार्गं गता सा स्त्री काले मोक्षमवाप ह ।\nतस्मान्नारद माहात्म्यं दीपदानस्य को वदेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003820032, "chapter_id": 23820, "verse_number": "२-४-७-३३", "content_sanskrit": "कार्तिके दीपदानं तु महापुण्यफलप्रदम् ।\nकार्तिकव्रतनिष्ठो यो दीपदानादिकृन्नरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003820033, "chapter_id": 23820, "verse_number": "२-४-७-३४", "content_sanskrit": "दीपदानस्येतिहासं शृण्वन्वै मोक्षमाप्नुयात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003820034, "chapter_id": 23820, "verse_number": "२-४-७-३५", "content_sanskrit": "दीपदानस्य माहात्म्यं वक्तुं केनेह शक्यते ।\nपरदीपप्रबोधस्य माहात्म्यं शृणु नारद ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003820035, "chapter_id": 23820, "verse_number": "२-४-७-३६", "content_sanskrit": "स्वस्याऽपि शक्तिराहित्ये परस्याऽपि प्रबोधनम् ।\nयः कुर्याल्लभते सोऽपि नाऽत्र कार्या विचारणा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003820036, "chapter_id": 23820, "verse_number": "२-४-७-३७", "content_sanskrit": "दीपार्थं वर्तिकां तैलं पात्रं वा यो ददाति हि ।\nसहायं वाऽथ कुरुते ददतां दीपमुत्तमम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003820037, "chapter_id": 23820, "verse_number": "२-४-७-३८", "content_sanskrit": "स तु मोक्षमवाप्नोति नाऽत्र कार्या विचारणा ।\nकार्तिके दीपदानस्य माहात्म्यं को नु वर्णयेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003820038, "chapter_id": 23820, "verse_number": "२-४-७-३९", "content_sanskrit": "स्वस्यापि शक्तिराहित्ये परदीपं प्रबोधयेत् ।\nसोऽपि तत्फलमाप्नोति नाऽत्र कार्या विचारणा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003820039, "chapter_id": 23820, "verse_number": "२-४-७-४०", "content_sanskrit": "वेश्या चेन्दुमतीनाम तस्या गेहेऽथ मूषिका ।\nपरदीपप्रबोधेन मोक्षं प्राप सुदुर्लभम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003820040, "chapter_id": 23820, "verse_number": "२-४-७-४१", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन परदीपं प्रबोधयेत् ।\nतेन मोक्षमवाप्नोति मूषिकावन्न संशयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003820041, "chapter_id": 23820, "verse_number": "२-४-७-४२", "content_sanskrit": "परदीपप्रबबोधस्य फलमीदृग्विधं मुने ।\nसाक्षाद्दीपप्रदानस्य माहात्म्यं केन वर्ण्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003820042, "chapter_id": 23820, "verse_number": "२-४-७-४३", "content_sanskrit": "नारद उवाच ।\nकार्तिके दीपदानस्य माहात्म्यं च मया श्रुतम् ।\nपरदीप प्रबोधस्य माहात्म्यमपि वै श्रुतम् ।\nइदानीं श्रोतुमिच्छामि व्योमदीपस्य वैभवम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003820043, "chapter_id": 23820, "verse_number": "२-४-७-४४", "content_sanskrit": "ब्रह्मोवाच ।\nआकाशदीप माहात्म्यं शृणु पुत्र समाहितः ।\nयस्य श्रवणमात्रेण दीपदाने मतिर्भवेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003820044, "chapter_id": 23820, "verse_number": "२-४-७-४५", "content_sanskrit": "संप्राप्ते कार्तिके मासि प्रातःस्नानपरायणः ।\nआकाशदीपं यो दद्यात्तस्य पुण्यं वदाम्यहम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003820045, "chapter_id": 23820, "verse_number": "२-४-७-४६", "content_sanskrit": "सर्वलोकाधिपो भूत्वा सर्वसंपत्समन्वितः ।\nइह लोके सुखं भुक्त्वा चांते मोक्षमवाप्नुयात् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003820046, "chapter_id": 23820, "verse_number": "२-४-७-४७", "content_sanskrit": "स्नानदानक्रियापूर्वं हरिमंदिरमस्तके ।\nआकाशदीपो दातव्यो मासमेकं तु कार्तिके ।\nकार्तिके शुद्धपूर्णायां विधिनोत्सर्जयेच्च तम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003820047, "chapter_id": 23820, "verse_number": "२-४-७-४८", "content_sanskrit": "यः करोति विधानेन कार्तिके व्योम्नि दीपकम् ।\nन तस्य पुनरावृत्तिः कल्पकोटिशतैरपि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003820048, "chapter_id": 23820, "verse_number": "२-४-७-४९", "content_sanskrit": "अत्र ते वर्णयिष्यामि इतिहासं पुरातनम् ।\nयस्य श्रवणमात्रेण व्योमदीपफलं लभेत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003820049, "chapter_id": 23820, "verse_number": "२-४-७-५०", "content_sanskrit": "पुरा तु निष्ठुरोनाम लुब्धको लोककंटकः ।\nयमुनातीरवासी च कालमृत्युरिवाऽपरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003820050, "chapter_id": 23820, "verse_number": "२-४-७-५१", "content_sanskrit": "वने चरन्मृगान्सर्वान्हत्वा वृत्तिमकल्पयत् ।\nपथिकान्बाधते नित्यं चोरवृत्त्या धनुर्धरः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003820051, "chapter_id": 23820, "verse_number": "२-४-७-५२", "content_sanskrit": "कंचिद्ग्रामं जगामाशु चौर्यार्थं कार्तिके मुने ।\nतस्मिन्विदर्भनगरे राजा सुकृतिनामकः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003820052, "chapter_id": 23820, "verse_number": "२-४-७-५३", "content_sanskrit": "चन्द्रशर्माख्यविप्रस्य वचनात्कार्तिके सुधीः ।\nचकार व्योमदीपं तु हरिमंदिरमस्तके ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003820053, "chapter_id": 23820, "verse_number": "२-४-७-५४", "content_sanskrit": "दीपं दत्त्वा महाभक्त्या अशृणोच्च कथां निशि ।\nएतस्मिन्नेव काले तु चौर्यार्थं समुपागतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003820054, "chapter_id": 23820, "verse_number": "२-४-७-५५", "content_sanskrit": "राज्ञा दत्तं व्योमदीपं पश्यन्क्षणमतिष्ठत ।\nतदानीं दैवयोगेन गृध्रो जवसमन्वितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003820055, "chapter_id": 23820, "verse_number": "२-४-७-५६", "content_sanskrit": "शीघ्रमागत्य जग्राह तैलपात्रं सदीपकम् ।\nस्वमुखेनैव संगृह्य वृक्षाग्रं च समाश्रयत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003820056, "chapter_id": 23820, "verse_number": "२-४-७-५७", "content_sanskrit": "तत्र पीत्वा तु तैलं च दीपं स्थाप्य स पक्षिराट् ।\nवृक्षाग्रं तु समास्थाय क्षणमात्रमतिष्ठत ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003820057, "chapter_id": 23820, "verse_number": "२-४-७-५८", "content_sanskrit": "तदानीं दैवयोगेन ग्रहीतुं पक्षिसत्तमम् ।\nमार्जारोऽप्यारुहद्वृक्षं पक्षिणाऽधिष्ठितं तु तम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003820058, "chapter_id": 23820, "verse_number": "२-४-७-५९", "content_sanskrit": "तदग्रे मुखदीपं च पश्यन्क्षणमतिष्ठत ।\nआकाशदीपमाहात्म्यं कथितं चन्द्रशर्मणा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003820059, "chapter_id": 23820, "verse_number": "२-४-७-६०", "content_sanskrit": "राज्ञे सुकृतिनाम्ने च तौ वै शुश्रुवतुः क्षणम् ।\nखगमार्जारकौ तत्र स्वस्वचामचल्यदोषतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003820060, "chapter_id": 23820, "verse_number": "२-४-७-६१", "content_sanskrit": "मार्जारो जगृहे तत्र शाखामतरगतं खगम् ।\nदैवेन चोदितौ वृक्षाच्छिलायां पतितौ तदा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003820061, "chapter_id": 23820, "verse_number": "२-४-७-६२", "content_sanskrit": "भग्नगात्रौ मृतौ तत्र पक्षिमार्जारकौ भुवि ।\nदिव्यदेहसमायुक्तौ यानारूढौ दिवं गतौ ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003820062, "chapter_id": 23820, "verse_number": "२-४-७-६३", "content_sanskrit": "तत्सर्वं लुब्धको दृष्ट्वा चौर्यार्थं समुपागतः ।\nनिवृत्तो दुष्टभावेन कथयंतं कथां मुनिम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003820063, "chapter_id": 23820, "verse_number": "२-४-७-६४", "content_sanskrit": "चंद्रशर्माणमाभाष्य इदं वचनमब्रवीत् ।\nचंद्रशर्मन्मया दृष्टं चौर्यार्थं ह्यागतेन च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003820064, "chapter_id": 23820, "verse_number": "२-४-७-६५", "content_sanskrit": "राज्ञा सुकृतिना दत्तं व्योमदीपं मनोहरम् ।\nतदानीं दैवयोगेन खगः पात्रं प्रगृह्य च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003820065, "chapter_id": 23820, "verse_number": "२-४-७-६६", "content_sanskrit": "तैलं पीत्वा तु तत्पात्रं सदीपं तु मनोहरम् ।\nवृक्षाग्रे स्थापयित्वा च तत्र क्षणमतिष्ठत ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003820066, "chapter_id": 23820, "verse_number": "२-४-७-६७", "content_sanskrit": "मार्जारोऽप्यागतस्तत्र ग्रहीतुं पक्षिपुंगवम् ।\nदैवेन प्रेरितौ तौ च उभे शाखे समाश्रितौ ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003820067, "chapter_id": 23820, "verse_number": "२-४-७-६८", "content_sanskrit": "त्वन्मुखात्कथ्यमानां हि कथां शुश्रुवतुः क्षणम् ।\nपश्चाच्चांचल्यदोषेण मार्जारो ह्यग्रहीत्खगम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003820068, "chapter_id": 23820, "verse_number": "२-४-७-६९", "content_sanskrit": "तौ वृक्षात्पतितौ मृत्युं प्राप्तौ च क्षणमात्रतः ।\nउभौ तौ दिव्यरूपौ च यानारूढौ दिवं गतौ ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003820069, "chapter_id": 23820, "verse_number": "२-४-७-७०", "content_sanskrit": "तदाश्चर्यमहं दृष्ट्वा त्वां प्रष्टुं समुपागतः ।\nतौ कौ पुरा च मार्जारखगौ तद्वद भो द्विज ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003820070, "chapter_id": 23820, "verse_number": "२-४-७-७१", "content_sanskrit": "तिर्यग्योनिसमापन्नौ मुक्तौ केन च कर्मणा ।\nइति लुब्धवचः श्रुत्वा चंद्रशर्माऽब्रवीत्तदा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003820071, "chapter_id": 23820, "verse_number": "२-४-७-७२", "content_sanskrit": "शृणु लुब्ध प्रवक्ष्यामि तयोर्वृत्तांतमंजसा ।\nमार्जारोऽपि पुरा पापी तथा श्रीवत्सगोत्रजः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003820072, "chapter_id": 23820, "verse_number": "२-४-७-७३", "content_sanskrit": "देवशर्मा इति प्रोक्तो देवद्रव्याऽपहारकः ।\nअहोबलनृसिंहस्य पूजाकर्तृत्वमाप सः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003820073, "chapter_id": 23820, "verse_number": "२-४-७-७४", "content_sanskrit": "तस्मिन्देवालये प्राप्तं तैलं द्रव्यादिकं तथा ।\nअपहृत्य च तेनैव कुटुंबं पोषयत्यसौ ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003820074, "chapter_id": 23820, "verse_number": "२-४-७-७५", "content_sanskrit": "आयुर्नीत्वैवमेवाऽसौ ततः पंचत्वमागतः ।\nतस्मात्पापात्कालसूत्रं महारौरवरौरवम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003820075, "chapter_id": 23820, "verse_number": "२-४-७-७६", "content_sanskrit": "निरुच्छ्वासं तथा प्राप्य असिपत्रवनं क्रमात् ।\nछिद्यमानो महाकायैर्यमदूतैर्भयंकरैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003820076, "chapter_id": 23820, "verse_number": "२-४-७-७७", "content_sanskrit": "अनुभूय च तान्सर्वान्ब्रह्मराक्षसतां गतः ।\nततस्तु श्वानयोनौ च चंडालोऽभूत्कुकर्मतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003820077, "chapter_id": 23820, "verse_number": "२-४-७-७८", "content_sanskrit": "एवं जन्मशतं प्राप्य भूमौ मार्जारतां गतः ।\nआकाशदीपमाहात्म्यं श्रुत्वेदानीं तु दैवतः ।\nनिर्मुक्ताऽखिलपापस्तु अगमद्धरिमंदिरम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003820078, "chapter_id": 23820, "verse_number": "२-४-७-७९", "content_sanskrit": "गृध्रोऽयं तु पुरा विप्रो मिथिले वेदपारगः ।\nशर्यातिरिति विख्यातौ नाम्ना लोके महाप्रभुः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003820079, "chapter_id": 23820, "verse_number": "२-४-७-८०", "content_sanskrit": "दासीसंगं चकारासौ वेश्यासंगं तथैव च ।\nतेन दोषेण महता पंचत्वमगमत्तदा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003820080, "chapter_id": 23820, "verse_number": "२-४-७-८१", "content_sanskrit": "कुंभीपाके महाघोरे स्थित्वा युगचतुष्टयम् ।\nकर्मशेषेण भूमौ च गृध्रत्वमगमत्तदा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003820081, "chapter_id": 23820, "verse_number": "२-४-७-८२", "content_sanskrit": "दैवेन चोदितो गृध्रस्तैलपानार्थमागतः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003820082, "chapter_id": 23820, "verse_number": "२-४-७-८३", "content_sanskrit": "दत्त्वा चाकाशदीपं च श्रुत्वा चैव हरेः कथाम् ।\nविध्वस्ताऽखिलपापस्तु जगाम हरिमंदिरम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003820083, "chapter_id": 23820, "verse_number": "२-४-७-८४", "content_sanskrit": "इत्येतत्सर्वमाख्यातं लुब्ध गच्छ यथासुखम् ।\nव्याधोऽप्यस्य वचः श्रुत्वा गत्वा चैव स्वमंदिरम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003820084, "chapter_id": 23820, "verse_number": "२-४-७-८५", "content_sanskrit": "व्रतं चाकाशदीपस्य चकार विधिवन्मुने ।\nआयुःशेषं तदा नीत्वा जगाम हरिमंदिरम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003820085, "chapter_id": 23820, "verse_number": "२-४-७-८६", "content_sanskrit": "सुनंदोपि महाराज आश्चर्यं समुपागतः ।\nचकार विधिना मासं चंद्रशर्मोक्तमार्गतः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003820086, "chapter_id": 23820, "verse_number": "२-४-७-८७", "content_sanskrit": "प्रातः स्नात्वा शुचिर्भूत्वा कार्तिके मासि वै नृपः ।\nकोमलैस्तुलसीपत्रैः समभ्यर्च्य जनार्दनम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003820087, "chapter_id": 23820, "verse_number": "२-४-७-८८", "content_sanskrit": "रात्रौ दद्याद्व्योमदीपं मंत्रेणानेन वै नृपः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003820088, "chapter_id": 23820, "verse_number": "२-४-७-८९", "content_sanskrit": "दामोदराय विश्वाय विश्वरूपधराय च ।\nनमस्कृत्वा प्रदास्यामि व्योमदीपं हरिप्रियम् ।\nनिर्विघ्नं कुरु देवेश यावन्मासः समाप्यते ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003820089, "chapter_id": 23820, "verse_number": "२-४-७-९०", "content_sanskrit": "व्रतेनाऽनेन देवेश त्वयि भक्तिः प्रवर्द्धताम् ।\nइति मंत्रेण राजाऽसौ दीपदानं चकार ह ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003820090, "chapter_id": 23820, "verse_number": "२-४-७-९१", "content_sanskrit": "ब्राह्मे मुहूर्ते च पुनर्व्योमदीपं ददाति हि ।\nविष्णोः पूजा कृता प्रातः प्रातःस्नानं चकार ह ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003820091, "chapter_id": 23820, "verse_number": "२-४-७-९२", "content_sanskrit": "उत्सर्गस्य विधिं कृत्वा व्योम्नि दीपं समाप्य च ।\nब्राह्मणान्भोजयित्वा च व्रतं विष्णोः समार्पयत् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003820092, "chapter_id": 23820, "verse_number": "२-४-७-९३", "content_sanskrit": "तेन पुण्यप्रभावेन स राजा मुनिसत्तम ।\nशरदां शतसाहस्रमिह भोगान्मनोहरान् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003820093, "chapter_id": 23820, "verse_number": "२-४-७-९४", "content_sanskrit": "सुपुत्रपौत्रस्वजनैर्बुभुजे सह भार्यया ।\nततश्चांऽते द्विजवर विमानं सुमनोहरम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003820094, "chapter_id": 23820, "verse_number": "२-४-७-९५", "content_sanskrit": "स्त्रीभिः सह समारुह्य मोक्षमार्गं गतो मुने ।\nचतुर्भुजः पीतवासाः शंखचक्रगदाधरः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003820095, "chapter_id": 23820, "verse_number": "२-४-७-९६", "content_sanskrit": "विष्णुलोके विष्णुरिव प्रोच्यमानः सदाऽमरैः ।\nक्रीडयामास राजाऽसौ यथाकामं महामनाः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003820096, "chapter_id": 23820, "verse_number": "२-४-७-९७", "content_sanskrit": "तस्मात्तु कार्तिके मासि मानुष्यं प्राप्य दुर्लभम् ।\nआकाशदीपो दातव्यो विधानेन हरेः प्रियः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003820097, "chapter_id": 23820, "verse_number": "२-४-७-९८", "content_sanskrit": "दास्यंति ये कार्तिकमासि मर्त्या व्योमप्रदीपं हरितुष्टयेऽत्र ।\nपश्यंति ते नैव कदाऽपि देवं यमं महाक्रूरमुखं मुनींद्र ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003820098, "chapter_id": 23820, "verse_number": "२-४-७-९९", "content_sanskrit": "अथाऽन्यच्च प्रवक्ष्यामि व्योमदीपस्य वैभवम् ।\nवालखिल्यैः पुरा प्रोक्तं तच्छृणुष्व द्विजोत्तम ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003820099, "chapter_id": 23820, "verse_number": "२-४-७-१००", "content_sanskrit": "वालखिल्या ऊचुः ।\nकृष्णादिमासक्रमतः कार्तिकस्यादिमासतः ।\nआकाशादीपदानं तु कुर्वंतु ऋषिसत्तमाः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003820100, "chapter_id": 23820, "verse_number": "२-४-७-१०१", "content_sanskrit": "तुलायां तिलतैलेन सायं संध्यासमागमे ।\nआकाशदीपं यो दयान्मासमेकं निरंतरम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003820101, "chapter_id": 23820, "verse_number": "२-४-७-१०२", "content_sanskrit": "सश्रीकाय श्रीपतये श्रिया न स वियुज्यते ।\nआकाशदीपवंशस्तु विंशद्धस्तोत्तमो भवेत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003820102, "chapter_id": 23820, "verse_number": "२-४-७-१०३", "content_sanskrit": "मध्यमो नवहस्तः स्यात्कनिष्ठः पंचहस्तकः ।\nयथा दूरस्थितैर्लोकैर्दृश्यते तत्तथाऽचरेत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003820103, "chapter_id": 23820, "verse_number": "२-४-७-१०४", "content_sanskrit": "तथाऽभ्रादिकरंडेषु दीपदानं विशिष्यते ।\nवंशस्य नवमांशेन लंबा कार्या पताकिका ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003820104, "chapter_id": 23820, "verse_number": "२-४-७-१०५", "content_sanskrit": "मयूरपिच्छमुष्टिं वा कलशं चोपरि न्यसेत् ।\nविष्णुप्रीतिकरो दीपः पित्रुद्धारस्य कारकः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003820105, "chapter_id": 23820, "verse_number": "२-४-७-१०६", "content_sanskrit": "एकादश्यास्तुलार्काद्वा दीपदानमतोऽपि वा ।\nदामोदराय नभसि तुलायां लोलया सह ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003820106, "chapter_id": 23820, "verse_number": "२-४-७-१०७", "content_sanskrit": "प्रदीपं ते प्रयच्छामि नमोऽनंताय वेधसे ।\nआकाशदीपसदृशं पितुरुद्धारकं नहि ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003820107, "chapter_id": 23820, "verse_number": "२-४-७-१०८", "content_sanskrit": "हेलिकस्य च द्वौ पुत्रौ तत्रैकस्तु पिशाचकः ।\nव्योमदीपपुण्यदानान्मोक्षं प्राप सुदुर्लभम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003820108, "chapter_id": 23820, "verse_number": "२-४-७-१०९", "content_sanskrit": "नमः पितृभ्यः प्रेतेभ्यो नमो धर्माय विष्णवे ।\nनमो यमाय रुद्राय कांतारपतये नमः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003820109, "chapter_id": 23820, "verse_number": "२-४-७-११०", "content_sanskrit": "मन्त्रेणाऽनेन ये मर्त्याः पितृभ्यः खे तु दीपकम् ।\nप्रयच्छंति गता ये स्युर्नरके यांति तेऽपि वै ।\nउत्तमां गतिमित्थं ते दीपदानं मयेरितम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003820110, "chapter_id": 23820, "verse_number": "२-४-७-१११", "content_sanskrit": "लक्ष्मीसंततिसिद्ध्यर्थमारोग्याय प्रदीपयेत् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003820111, "chapter_id": 23820, "verse_number": "२-४-७-११२", "content_sanskrit": "कार्तिके कृष्णपक्षे तु द्वादश्यादिषु पंचसु ।\nतिथीषूक्तः पूर्वरात्रे नृणां नीराजनाविधिः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003820112, "chapter_id": 23820, "verse_number": "२-४-७-११३", "content_sanskrit": "ब्रह्मविष्णुशिवादीनां भवनेषु विशेषतः ।\nकूटागारेषु चैत्येषु सभासु च नदीषु च ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003820113, "chapter_id": 23820, "verse_number": "२-४-७-११४", "content_sanskrit": "प्राकारोद्यानवापीषु प्रतोलीनिष्कुटेषु च ।\nमन्दुरासु विविक्तासु हस्तिशालासु चैव हि ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003820114, "chapter_id": 23820, "verse_number": "२-४-७-११५", "content_sanskrit": "प्रदोषसमये दीपान्दद्यादेवं मनोहरान् ।\nकृतं यैः कार्तिके मासि दीपदानं विधानतः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003820115, "chapter_id": 23820, "verse_number": "२-४-७-११६", "content_sanskrit": "दृश्यंते ये रत्नभाजस्तेऽत एव प्रकीर्तिताः ।\nदीपदानासमर्थश्चेत्परदीपं तु रक्षयेत् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003820116, "chapter_id": 23820, "verse_number": "२-४-७-११७", "content_sanskrit": "यो वेदाभ्यासिने दद्याद्दीपार्थं तैलमादरात् ।\nको वा तस्य फलं वक्तुं भुवि तिष्ठति मानवः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003820117, "chapter_id": 23820, "verse_number": "२-४-७-११८", "content_sanskrit": "दीपान्दद्याद्बहुविधान्कार्तिके विष्णुसंनिधौ ।\nकार्तिके मासि संप्राप्ते गगने स्वच्छताके ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003820118, "chapter_id": 23820, "verse_number": "२-४-७-११९", "content_sanskrit": "रात्रौ लक्ष्मीः समायाति द्रष्टुं भुवनकौतुकम् ।\nयत्रयत्र च दीपान्सा पश्यत्यब्धिसमुद्भवा ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003820119, "chapter_id": 23820, "verse_number": "२-४-७-१२०", "content_sanskrit": "तत्रतत्र रतिं कुर्यान्नांधकारे कदाचन ।\nतस्माद्दीपः स्थापनीयः कार्तिके मासि वै सदा ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003820120, "chapter_id": 23820, "verse_number": "२-४-७-१२१", "content_sanskrit": "लक्ष्मीरूपार्थिनां प्रोक्तं दीपदानं विशेषतः ।\nदेवाऽलये नदीतीरे राजमार्गे विशेषतः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003820121, "chapter_id": 23820, "verse_number": "२-४-७-१२२", "content_sanskrit": "निद्रास्थले दीपदाता तस्य श्रीः सर्वतोमुखी ।\nदुर्बलस्याऽलयं वीक्ष्य दीपशून्यं तु यो ददेत् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003820122, "chapter_id": 23820, "verse_number": "२-४-७-१२३", "content_sanskrit": "विप्रस्य वाऽन्यवर्णस्य विष्णुलोके महीयते ।\nकीटकंटकसंकीर्णे दुर्गमे विषमस्थले ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003820123, "chapter_id": 23820, "verse_number": "२-४-७-१२४", "content_sanskrit": "कुर्याद्यो दीपदानानि नरकं स न गच्छति ।\nदद्याद्रात्रौ पंचनदे दीपं यो विधिपूर्वकम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003820124, "chapter_id": 23820, "verse_number": "२-४-७-१२५", "content_sanskrit": "तस्य वंशे प्रजायन्ते बालकाः कुलदीपकाः ।\nपितृपक्षेऽन्नदानेन ज्येष्ठाऽषाढे च वारिणा ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003820125, "chapter_id": 23820, "verse_number": "२-४-७-१२६", "content_sanskrit": "कार्तिके तत्फलं तेषां परदीपप्रबोधनात् ।\nबोधनात्परदीपस्य वैष्णवानां च सेवनात् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003820126, "chapter_id": 23820, "verse_number": "२-४-७-१२७", "content_sanskrit": "कार्तिके फलमाप्नोति राजसूयाश्वमेधयोः ।\nपुरा हरिकरोनाम द्विजः पापरतः सदा ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003820127, "chapter_id": 23820, "verse_number": "२-४-७-१२८", "content_sanskrit": "कृतं द्यूतप्रसंगेन दीपदानं हि कार्तिके ।\nतेन पुण्यप्रभावेन स्वर्गं प्राप द्विजोत्तमः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003820128, "chapter_id": 23820, "verse_number": "२-४-७-१२९", "content_sanskrit": "आकाशदीपदानेन पुरा वै धर्मनन्दनः ।\nविमानवरमारुह्य विष्णुलोकं ययौ नृपः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003820129, "chapter_id": 23820, "verse_number": "२-४-७-१३०", "content_sanskrit": "यः कुर्यात्कार्तिके विष्णोः पुरः कर्पूरदीपकम् ।\nप्रबोधिन्यां विशेषेण तस्य पुण्यं वदाम्यहम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003820130, "chapter_id": 23820, "verse_number": "२-४-७-१३१", "content_sanskrit": "कुले तस्य प्रसूता ये पुरुषास्ते हरिप्रियाः ।\nक्रीडित्वा सुचिरं कालमन्ते मुक्तिं व्रजंति च ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003820131, "chapter_id": 23820, "verse_number": "२-४-७-१३२", "content_sanskrit": "दीपको ज्वलते यस्य दिवा रात्रौ हरेर्गृहे ।\nएकादश्यां विशेषेण स याति हरिमन्दिरम् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003820132, "chapter_id": 23820, "verse_number": "२-४-७-१३३", "content_sanskrit": "लुब्धकोऽपि चतुर्दश्यां दीपं दत्त्वा शिवालये ।\nभक्त्या विना परे लिंगे शिवलोकं जगाम सः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003820133, "chapter_id": 23820, "verse_number": "२-४-७-१३४", "content_sanskrit": "गोपः कश्चिदमावास्यां दीपं प्रज्वाल्य शार्ङ्गिणः ।\nमुहुर्जयजयेत्युक्त्वा स च राजेश्वरोऽभवत् ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}]