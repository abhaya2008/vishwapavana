[{"id": 40022011, "chapter_id": 9377, "verse_number": "1", "content_sanskrit": "एवं ब्रुवति रामे तु लक्ष्मणः परवीरहा । प्रत्युवाच महात्मानं ज्वलन्तमिव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022012, "chapter_id": 9377, "verse_number": "2", "content_sanskrit": "महदद्भुतमाश्चर्यं विदेहस्य पुरातनम् । निर्वृत्तं राजशार्दूल वसिष्ठस्य निमेस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022013, "chapter_id": 9377, "verse_number": "3", "content_sanskrit": "निमिस्तु क्षत्रियः शूरो विशेषेण च दीक्षितः । न क्षमां कृतवान्राजा वसिष्ठस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022014, "chapter_id": 9377, "verse_number": "4", "content_sanskrit": "एवमुक्तस्तु तेनायं श्रीमान् क्षत्रियपुङ्गवः । उवाच लक्ष्मणं वाक्यं सर्वशास्त्रविशारदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022015, "chapter_id": 9377, "verse_number": "5", "content_sanskrit": "रामो रमयतां श्रेष्ठो भ्रातरं दीप्ततेजसम् । न सर्वत्र क्षमा वीर पुरुषेषु प्रदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022016, "chapter_id": 9377, "verse_number": "6", "content_sanskrit": "सौमित्रे दुःसहो रोषो यथा क्षान्तो ययातिना । सत्त्वानुगं पुरस्कृत्य तन्निबोध समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022017, "chapter_id": 9377, "verse_number": "7", "content_sanskrit": "नहुषस्य सुतो राजा ययातिः पौरवर्धनः । तस्य भार्याद्वयं सौम्य रूपेणाप्रतिमं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022018, "chapter_id": 9377, "verse_number": "8", "content_sanskrit": "एका तु तस्य राजर्षेर्नाहुषस्य पुरस्कृता । शर्मिष्ठा नाम दैतेयी दुहिता वृषपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022019, "chapter_id": 9377, "verse_number": "9", "content_sanskrit": "अन्या तूशनसः पत्नी ययातेः पुरुषर्षभ । न तु सा दयिता राज्ञो देवयानी सुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022020, "chapter_id": 9377, "verse_number": "10", "content_sanskrit": "तयोः पुत्रौ तु सम्भूतौ रूपवन्तौ समाहितौ । शर्मिष्ठा ऽजनयत्पूरुं देवयानी यदुं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022021, "chapter_id": 9377, "verse_number": "11", "content_sanskrit": "पूरुस्तु दयितो राज्ञो गुणैर्मातृकृतेन च । ततो दुःखसमाविष्टो यदुर्मातरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022022, "chapter_id": 9377, "verse_number": "12", "content_sanskrit": "भार्गवस्य कुले जाता देवस्याक्लिष्टकर्मणः । सहसे हृद्गतं दुःखमवमानं च दुःसहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022023, "chapter_id": 9377, "verse_number": "13", "content_sanskrit": "आवां च सहितौ देवि प्रविशाव हुताशनम् । राजा तु रमतां सार्धं दैत्यपुत्र्या बहुक्षपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022024, "chapter_id": 9377, "verse_number": "14", "content_sanskrit": "यदि वा सहनीयं ते मामनुज्ञातुमर्हसि । क्षम त्वं न क्षमिष्ये ऽहं मरिष्यामि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022025, "chapter_id": 9377, "verse_number": "15", "content_sanskrit": "पुत्रस्य भाषितं श्रुत्वा परमार्तस्य रोदतः । देवयानी तु सङ्क्रुद्धा सस्मार पितरं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022026, "chapter_id": 9377, "verse_number": "16", "content_sanskrit": "इङ्गितं तदभिज्ञाय दुहितुर्भार्गवस्तदा । आगतस्त्वरितं तत्र देवयानी तु यत्र सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022027, "chapter_id": 9377, "verse_number": "17", "content_sanskrit": "दृष्ट्वा चाप्रकृतिस्थां तामप्रहृष्टामचेतनाम् । पिता दुहितरं वाक्यं किमेतदिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022028, "chapter_id": 9377, "verse_number": "18", "content_sanskrit": "पृच्छन्तमसकृत्तं वै भार्गवं दीप्ततेजसम् । देवयानी तु सङ्क्रुद्धा पितरं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022029, "chapter_id": 9377, "verse_number": "19", "content_sanskrit": "अहमग्निं विषं तीक्ष्णमपो वा मुनिसत्तम । भक्षयिष्ये प्रवेक्ष्यामि न तु शक्ष्यामि जीवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022030, "chapter_id": 9377, "verse_number": "20", "content_sanskrit": "न मां त्वमवजानीषे दुःखितामवमानिताम् । वृक्षस्यावज्ञया ब्रह्मंश्छिद्यन्ते वृक्षजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022031, "chapter_id": 9377, "verse_number": "21", "content_sanskrit": "अवज्ञया च राजर्षिः परिभूय च भार्गव । मय्यवज्ञां प्रयुङ्क्ते हि न च मां बहु मन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022032, "chapter_id": 9377, "verse_number": "22", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा कोपेनाभिपरिप्लुतः । व्याहर्तुमुपचक्राम भार्गवो नहुषात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022033, "chapter_id": 9377, "verse_number": "23", "content_sanskrit": "यस्मान्मामवजानीषे नाहुष त्वं दुरात्मवान् । जरया परया जीर्णः शैथिल्यमुपयास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022034, "chapter_id": 9377, "verse_number": "24", "content_sanskrit": "एवमुक्त्वा दुहितरं समाश्वास्य च भार्गवः । पुनर्जगाम ब्रह्मर्षिर्भवनं स्वं महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022035, "chapter_id": 9377, "verse_number": "25", "content_sanskrit": "स एवमुक्त्वा द्विजपुङ्गवाग्र्यः सुतां समाश्वास्य च देवयानीम् । पुनर्ययौ सूर्यसमानतेजा दत्त्वा च शापं नहुषात्मजाय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]