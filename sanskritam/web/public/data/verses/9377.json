[{"id": 5000377000, "chapter_id": 9377, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000377001, "chapter_id": 9377, "verse_number": "५-३८-१", "content_sanskrit": "ततः स कपिशार्दूलस्तेन वाक्येन तोषितः।\nसीतामुवाच तच्छ्रुत्वा वाक्यं वाक्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000377002, "chapter_id": 9377, "verse_number": "५-३८-२", "content_sanskrit": "युक्तरूपं त्वया देवि भाषितं शुभदर्शने।\nसदृशं स्त्रीस्वभावस्य साध्वीनां विनयस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000377003, "chapter_id": 9377, "verse_number": "५-३८-३", "content_sanskrit": "स्त्रीत्वान्न त्वं समर्थासि सागरं व्यतिवर्तितुम्।\nमामधिष्ठाय विस्तीर्णं शतयोजनमायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000377004, "chapter_id": 9377, "verse_number": "५-३८-४", "content_sanskrit": "द्वितीयं कारणं यच्च ब्रवीषि विनयान्विते।\nरामादन्यस्य नार्हामि संसर्गमिति जानकि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000377005, "chapter_id": 9377, "verse_number": "५-३८-५", "content_sanskrit": "एतत् ते देवि सदृशं पत्न्यास्तस्य महात्मनः।\nका ह्यन्या त्वामृते देवि ब्रूयाद् वचनमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000377006, "chapter_id": 9377, "verse_number": "५-३८-६", "content_sanskrit": "श्रोष्यते चैव काकुत्स्थः सर्वं निरवशेषतः।\nचेष्टितं यत् त्वया देवि भाषितं च ममाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000377007, "chapter_id": 9377, "verse_number": "५-३८-७", "content_sanskrit": "कारणैर्बहुभिर्देवि रामप्रियचिकीर्षया।\nस्नेहप्रस्कन्नमनसा मयैतत् समुदीरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000377008, "chapter_id": 9377, "verse_number": "५-३८-८", "content_sanskrit": "लङ्काया दुष्प्रवेशत्वाद् दुस्तरत्वान्महोदधेः।\nसामर्थ्यादात्मनश्चैव मयैतत् समुदीरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000377009, "chapter_id": 9377, "verse_number": "५-३८-९", "content_sanskrit": "इच्छामि त्वां समानेतुमद्यैव रघुनन्दिना।\nगुरुस्नेहेन भक्त्या च नान्यथा तदुदाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000377010, "chapter_id": 9377, "verse_number": "५-३८-१०", "content_sanskrit": "यदि नोत्सहसे यातुं मया सार्धमनिन्दिते।\nअभिज्ञानं प्रयच्छ त्वं जानीयाद् राघवो हि यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000377011, "chapter_id": 9377, "verse_number": "५-३८-११", "content_sanskrit": "एवमुक्ता हनुमता सीता सुरसुतोपमा।\nउवाच वचनं मन्दं बाष्पप्रग्रथिताक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000377012, "chapter_id": 9377, "verse_number": "५-३८-१२", "content_sanskrit": "इदं श्रेष्ठमभिज्ञानं ब्रूयास्त्वं तु मम प्रियम्।\nशैलस्य चित्रकूटस्य पादे पूर्वोत्तरे पदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000377013, "chapter_id": 9377, "verse_number": "५-३८-१३", "content_sanskrit": "तापसाश्रमवासिन्याः प्राज्यमूलफलोदके।\nतस्मिन् सिद्धाश्रिते देशे मन्दाकिन्यविदूरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000377014, "chapter_id": 9377, "verse_number": "५-३८-१४", "content_sanskrit": "तस्योपवनखण्डेषु नानापुष्पसुगन्धिषु।\nविहृत्य सलिले क्लिन्नो ममाङ्के समुपाविशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000377015, "chapter_id": 9377, "verse_number": "५-३८-१५", "content_sanskrit": "ततो मांससमायुक्तो वायसः पर्यतुण्डयत्।\nतमहं लोष्टमुद्यम्य वारयामि स्म वायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000377016, "chapter_id": 9377, "verse_number": "५-३८-१६", "content_sanskrit": "दारयन् स च मां काकस्तत्रैव परिलीयते।\nन चाप्युपारमन्मांसाद् भक्षार्थी बलिभोजनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000377017, "chapter_id": 9377, "verse_number": "५-३८-१७", "content_sanskrit": "उत्कर्षन्त्यां च रशनां क्रुद्धायां मयि पक्षिणे।\nस्रंसमाने च वसने ततो दृष्टा त्वया ह्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000377018, "chapter_id": 9377, "verse_number": "५-३८-१८", "content_sanskrit": "त्वया विहसिता चाहं क्रुद्धा संलज्जिता तदा।\nभक्ष्यगृद्धेन काकेन दारिता त्वामुपागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000377019, "chapter_id": 9377, "verse_number": "५-३८-१९", "content_sanskrit": "ततः श्रान्ताहमुत्सङ्गमासीनस्य तवाविशम्।\nक्रुध्यन्तीव प्रहृष्टेन त्वयाहं परिसान्त्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000377020, "chapter_id": 9377, "verse_number": "५-३८-२०", "content_sanskrit": "बाष्पपूर्णमुखी मन्दं चक्षुषी परिमार्जती।\nलक्षिताहं त्वया नाथ वायसेन प्रकोपिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000377021, "chapter_id": 9377, "verse_number": "५-३८-२१", "content_sanskrit": "परिश्रमाच्च सुप्ता हे राघवाङ्केऽस्म्यहं चिरम्।\nपर्यायेण प्रसुप्तश्च ममाङ्के भरताग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000377022, "chapter_id": 9377, "verse_number": "५-३८-२२", "content_sanskrit": "स तत्र पुनरेवाथ वायसः समुपागमत्।\nततः सुप्तप्रबुद्धां मां राघवाङ्कात् समुत्थिताम्।\nवायसः सहसागम्य विददार स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000377023, "chapter_id": 9377, "verse_number": "५-३८-२३", "content_sanskrit": "पुनः पुनरथोत्पत्य विददार स मां भृशम्।\nततः समुत्थितो रामो मुक्तैः शोणितबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000377024, "chapter_id": 9377, "verse_number": "५-३८-२४", "content_sanskrit": "स मां दृष्ट्वा महाबाहुर्वितुन्नां स्तनयोस्तदा।\nआशीविष इव क्रुद्धः श्वसन् वाक्यमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000377025, "chapter_id": 9377, "verse_number": "५-३८-२५", "content_sanskrit": "केन ते नागनासोरु विक्षतं वै स्तनान्तरम्।\nकः क्रीडति सरोषेण पञ्चवक्त्रेण भोगिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000377026, "chapter_id": 9377, "verse_number": "५-३८-२६", "content_sanskrit": "वीक्षमाणस्ततस्तं वै वायसं समवैक्षत।\nनखैः सरुधिरैस्तीक्ष्णैर्मामेवाभिमुखं स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000377027, "chapter_id": 9377, "verse_number": "५-३८-२७", "content_sanskrit": "पुत्रः किल स शक्रस्य वायसः पततां वरः।\nधरान्तरं गतः शीघ्रं पवनस्य गतौ समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000377028, "chapter_id": 9377, "verse_number": "५-३८-२८", "content_sanskrit": "ततस्तस्मिन् महाबाहुः कोपसंवर्तितेक्षणः।\nवायसे कृतवान् क्रूरां मतिं मतिमतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000377029, "chapter_id": 9377, "verse_number": "५-३८-२९", "content_sanskrit": "स दर्भसंस्तराद् गृह्य ब्रह्मणोऽस्त्रेण योजयत्।\nस दीप्त इव कालाग्निर्जज्वालाभिमुखो द्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000377030, "chapter_id": 9377, "verse_number": "५-३८-३०", "content_sanskrit": "स तं प्रदीप्तं चिक्षेप दर्भं तं वायसं प्रति।\nततस्तु वायसं दर्भः सोऽम्बरेऽनुजगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000377031, "chapter_id": 9377, "verse_number": "५-३८-३१", "content_sanskrit": "अनुसृष्टस्तदा काको जगाम विविधां गतिम्।\nत्राणकाम इमं लोकं सर्वं वै विचचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000377032, "chapter_id": 9377, "verse_number": "५-३८-३२", "content_sanskrit": "स पित्रा च परित्यक्तः सर्वैश्च परमर्षिभिः।\nत्रीँल्लोकान् सम्परिक्रम्य तमेव शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000377033, "chapter_id": 9377, "verse_number": "५-३८-३३", "content_sanskrit": "स तं निपतितं भूमौ शरण्यः शरणागतम्।\nवधार्हमपि काकुत्स्थः कृपया पर्यपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000377034, "chapter_id": 9377, "verse_number": "५-३८-३४", "content_sanskrit": "परिद्यूनं विवर्णं च पतमानं तमब्रवीत्।\nमोघमस्त्रं न शक्यं तु ब्राह्मं कर्तुं तदुच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000377035, "chapter_id": 9377, "verse_number": "५-३८-३५", "content_sanskrit": "ततस्तस्याक्षि काकस्य हिनस्ति स्म स दक्षिणम्।\nदत्त्वा तु दक्षिणं नेत्रं प्राणेभ्यः परिरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000377036, "chapter_id": 9377, "verse_number": "५-३८-३६", "content_sanskrit": "स रामाय नमस्कृत्वा राज्ञे दशरथाय च।\nविसृष्टस्तेन वीरेण प्रतिपेदे स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000377037, "chapter_id": 9377, "verse_number": "५-३८-३७", "content_sanskrit": "मत्कृते काकमात्रेऽपि ब्रह्मास्त्रं समुदीरितम्।\nकस्माद् यो माहरत् त्वत्तः क्षमसे तं महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000377038, "chapter_id": 9377, "verse_number": "५-३८-३८", "content_sanskrit": "स कुरुष्व महोत्साहां कृपां मयि नरर्षभ।\nत्वया नाथवती नाथ ह्यनाथा इव दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000377039, "chapter_id": 9377, "verse_number": "५-३८-३९", "content_sanskrit": "आनृशंस्यं परो धर्मस्त्वत्त एव मया श्रुतम्।\nजानामि त्वां महावीर्यं महोत्साहं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000377040, "chapter_id": 9377, "verse_number": "५-३८-४०", "content_sanskrit": "अपारवारमक्षोभ्यं गाम्भीर्यात् सागरोपमम्।\nभर्तारं ससमुद्राया धरण्या वासवोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000377041, "chapter_id": 9377, "verse_number": "५-३८-४१", "content_sanskrit": "एवमस्त्रविदां श्रेष्ठो बलवान् सत्त्ववानपि।\nकिमर्थमस्त्रं रक्षःसु न योजयसि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000377042, "chapter_id": 9377, "verse_number": "५-३८-४२", "content_sanskrit": "न नागा नापि गन्धर्वा न सुरा न मरुद‍्गणाः।\nरामस्य समरे वेगं शक्ताः प्रतिसमीहितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000377043, "chapter_id": 9377, "verse_number": "५-३८-४३", "content_sanskrit": "तस्य वीर्यवतः कच्चिद् यद्यस्ति मयि सम्भ्रमः।\nकिमर्थं न शरैस्तीक्ष्णैः क्षयं नयति राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000377044, "chapter_id": 9377, "verse_number": "५-३८-४४", "content_sanskrit": "भ्रातुरादेशमादाय लक्ष्मणो वा परंतपः।\nकस्य हेतोर्न मां वीरः परित्राति महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000377045, "chapter_id": 9377, "verse_number": "५-३८-४५", "content_sanskrit": "यदि तौ पुरुषव्याघ्रौ वाय्विन्द्रसमतेजसौ।\nसुराणामपि दुर्धर्षौ किमर्थं मामुपेक्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000377046, "chapter_id": 9377, "verse_number": "५-३८-४६", "content_sanskrit": "ममैव दुष्कृतं किंचिन्महदस्ति न संशयः।\nसमर्थावपि तौ यन्मां नावेक्षेते परंतपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000377047, "chapter_id": 9377, "verse_number": "५-३८-४७", "content_sanskrit": "वैदेह्या वचनं श्रुत्वा करुणं साश्रु भाषितम्।\nअथाब्रवीन्महातेजा हनूमान् हरियूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000377048, "chapter_id": 9377, "verse_number": "५-३८-४८", "content_sanskrit": "त्वच्छोकविमुखो रामो देवि सत्येन ते शपे।\nरामे दुःखाभिपन्ने तु लक्ष्मणः परितप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000377049, "chapter_id": 9377, "verse_number": "५-३८-४९", "content_sanskrit": "कथंचिद् भवती दृष्टा न कालः परिशोचितुम्।\nइमं मुहूर्तं दुःखानामन्तं द्रक्ष्यसि शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000377050, "chapter_id": 9377, "verse_number": "५-३८-५०", "content_sanskrit": "तावुभौ पुरुषव्याघ्रौ राजपुत्रौ महाबलौ।\nत्वद्दर्शनकृतोत्साहौ लोकान् भस्मीकरिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000377051, "chapter_id": 9377, "verse_number": "५-३८-५१", "content_sanskrit": "हत्वा च समरक्रूरं रावणं सहबान्धवम्।\nराघवस्त्वां विशालाक्षि स्वां पुरीं प्रति नेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000377052, "chapter_id": 9377, "verse_number": "५-३८-५२", "content_sanskrit": "ब्रूहि यद् राघवो वाच्यो लक्ष्मणश्च महाबलः।\nसुग्रीवो वापि तेजस्वी हरयो वा समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000377053, "chapter_id": 9377, "verse_number": "५-३८-५३", "content_sanskrit": "इत्युक्तवति तस्मिंश्च सीता पुनरथाब्रवीत्।\nकौसल्या लोकभर्तारं सुषुवे यं मनस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000377054, "chapter_id": 9377, "verse_number": "५-३८-५४", "content_sanskrit": "तं ममार्थे सुखं पृच्छ शिरसा चाभिवादय।\nस्रजश्च सर्वरत्नानि प्रियायाश्च वराङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000377055, "chapter_id": 9377, "verse_number": "५-३८-५५", "content_sanskrit": "ऐश्वर्यं च विशालायां पृथिव्यामपि दुर्लभम्।\nपितरं मातरं चैव सम्मान्याभिप्रसाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000377056, "chapter_id": 9377, "verse_number": "५-३८-५६", "content_sanskrit": "अनुप्रव्रजितो रामं सुमित्रा येन सुप्रजाः।\nआनुकूल्येन धर्मात्मा त्यक्त्वा सुखमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000377057, "chapter_id": 9377, "verse_number": "५-३८-५७", "content_sanskrit": "अनुगच्छति काकुत्स्थं भ्रातरं पालयन् वने।\nसिंहस्कन्धो महाबाहुर्मनस्वी प्रियदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000377058, "chapter_id": 9377, "verse_number": "५-३८-५८", "content_sanskrit": "पितृवद् वर्तते रामे मातृवन्मां समाचरत्।\nह्रियमाणां तदा वीरो न तु मां वेद लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000377059, "chapter_id": 9377, "verse_number": "५-३८-५९", "content_sanskrit": "वृद्धोपसेवी लक्ष्मीवान् शक्तो न बहुभाषिता।\nराजपुत्रप्रियश्रेष्ठः सदृशः श्वशुरस्य मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000377060, "chapter_id": 9377, "verse_number": "५-३८-६०", "content_sanskrit": "मत्तः प्रियतरो नित्यं भ्राता रामस्य लक्ष्मणः।\nनियुक्तो धुरि यस्यां तु तामुद्वहति वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000377061, "chapter_id": 9377, "verse_number": "५-३८-६१", "content_sanskrit": "यं दृष्ट्वा राघवो नैव वृत्तमार्यमनुस्मरत्।\nस ममार्थाय कुशलं वक्तव्यो वचनान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000377062, "chapter_id": 9377, "verse_number": "५-३८-६२", "content_sanskrit": "मृदुर्नित्यं शुचिर्दक्षः प्रियो रामस्य लक्ष्मणः।\nयथा हि वानरश्रेष्ठ दुःखक्षयकरो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000377063, "chapter_id": 9377, "verse_number": "५-३८-६३", "content_sanskrit": "त्वमस्मिन् कार्यनिर्वाहे प्रमाणं हरियूथप।\nराघवस्त्वत्समारम्भान्मयि यत्नपरो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000377064, "chapter_id": 9377, "verse_number": "५-३८-६४", "content_sanskrit": "इदं ब्रूयाश्च मे नाथं शूरं रामं पुनः पुनः।\nजीवितं धारयिष्यामि मासं दशरथात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000377065, "chapter_id": 9377, "verse_number": "५-३८-६५", "content_sanskrit": "ऊर्ध्वं मासान्न जीवेयं सत्येनाहं ब्रवीमि ते।\nरावणेनोपरुद्धां मां निकृत्या पापकर्मणा।\nत्रातुमर्हसि वीर त्वं पातालादिव कौशिकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000377066, "chapter_id": 9377, "verse_number": "५-३८-६६", "content_sanskrit": "ततो वस्त्रगतं मुक्त्वा दिव्यं चूडामणिं शुभम्।\nप्रदेयो राघवायेति सीता हनुमते ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000377067, "chapter_id": 9377, "verse_number": "५-३८-६७", "content_sanskrit": "प्रतिगृह्य ततो वीरो मणिरत्नमनुत्तमम्।\nअङ्गुल्या योजयामास नह्यस्य प्राभवद् भुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000377068, "chapter_id": 9377, "verse_number": "५-३८-६८", "content_sanskrit": "मणिरत्नं कपिवरः प्रतिगृह्याभिवाद्य च।\nसीतां प्रदक्षिणं कृत्वा प्रणतः पार्श्वतः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000377069, "chapter_id": 9377, "verse_number": "५-३८-६९", "content_sanskrit": "हर्षेण महता युक्तः सीतादर्शनजेन सः।\nहृदयेन गतो रामं लक्ष्मणं च सलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000377070, "chapter_id": 9377, "verse_number": "५-३८-७०", "content_sanskrit": "मणिवरमुपगृह्य तं महार्हं\nजनकनृपात्मजया धृतं प्रभावात्।\nगिरिवरपवनावधूतमुक्तः\nसुखितमनाः प्रतिसंक्रमं प्रपेदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000377071, "chapter_id": 9377, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे अष्टात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]