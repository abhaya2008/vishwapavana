[{"id": 7000281000, "chapter_id": 20281, "verse_number": "१-३५-१", "content_sanskrit": "भीष्म उवाच ।\nउक्तं भगवता सर्वं पुराणाश्रयसंयुतं ।\nतथा श्वेतेन ब्रह्मांडं गुरवे प्रतिपादितं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000281001, "chapter_id": 20281, "verse_number": "१-३५-२", "content_sanskrit": "श्रुत्वैतत्कौतुकं जातं यथा तेनास्थिलेहनं ।\nकृतं क्षुधापनोदार्थे अन्नदानाद्विना द्विज ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000281002, "chapter_id": 20281, "verse_number": "१-३५-३", "content_sanskrit": "तदहं श्रोतुमिच्छामि पृथिव्यां ये च पार्थिवाः ।\nअन्नदानाद्दिवं प्राप्ताः क्रतवश्चान्नमूलकाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000281003, "chapter_id": 20281, "verse_number": "१-३५-४", "content_sanskrit": "कथं तस्य मतिर्नष्टा श्वेतस्य च महात्मनः ।\nन दत्तं तेनान्नदानमृषिभिर्वा न दर्शितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000281004, "chapter_id": 20281, "verse_number": "१-३५-५", "content_sanskrit": "अहो माहात्म्यमन्नस्य इह दत्तस्य यत्फलम् ।\nपरत्र भुज्यते पुंभिः स्वर्गश्चाक्षयतां व्रजेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000281005, "chapter_id": 20281, "verse_number": "१-३५-६", "content_sanskrit": "अन्नदानं परं विप्राः कीर्तयंति सदोत्थिताः ।\nअन्नदानात्सुरेद्रेण त्रैलोक्यमिह भुज्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000281006, "chapter_id": 20281, "verse_number": "१-३५-७", "content_sanskrit": "शतक्रतुरिति प्रोक्तः सर्वैरेव द्विजोत्तमैः ।\nतेनावस्थां तत्सदृशीं प्राप्तवांस्त्रिदशेश्वरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000281007, "chapter_id": 20281, "verse_number": "१-३५-८", "content_sanskrit": "दानदेवगतः स्वर्गं त्वत्तः सर्वं श्रुतं मया ।\nअपरं च पुरावृत्तं निवृत्तं यदि कर्हिचित् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000281008, "chapter_id": 20281, "verse_number": "१-३५-९", "content_sanskrit": "भूयोपि श्रोतुमिच्छामि तन्मे वद महामते ।\nपुलस्त्य उवाच ।\nएतदाख्यानकं पूर्वमगस्त्येन महात्मना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000281009, "chapter_id": 20281, "verse_number": "१-३५-१०", "content_sanskrit": "रामाय कथितं राजंस्तत्ते वक्ष्यामि सांप्रतम् ।\nभीष्म उवाच ।\nकस्मिन्वंशे समुत्पन्नो रामोऽसौ नृपसत्तमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000281010, "chapter_id": 20281, "verse_number": "१-३५-११", "content_sanskrit": "यस्यागस्त्येन कथितश्चेतिहासः पुरातनः ।\nपुलस्त्य उवाच ।\nरघुवंशे समुत्पन्नो रामो नाम महाबलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000281011, "chapter_id": 20281, "verse_number": "१-३५-१२", "content_sanskrit": "देवकार्यं कृतं तेन लंकायां रावणो हतः ।\nपृथिवीं राज्यसंस्थस्य ऋषयोऽभ्यागता गृहे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000281012, "chapter_id": 20281, "verse_number": "१-३५-१३", "content_sanskrit": "प्राप्तास्ते तु महात्मानो राघवस्य निवेशनम् ।\nप्रतीहारस्ततो राममगस्त्यवचनाद्द्रुतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000281013, "chapter_id": 20281, "verse_number": "१-३५-१४", "content_sanskrit": "आवेदयामास ऋषीन्प्राप्तास्तांश्च त्वरान्वितः ।\nदृष्ट्वा रामं द्वारपालः पूर्णचंद्रमिवोदितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000281014, "chapter_id": 20281, "verse_number": "१-३५-१५", "content_sanskrit": "कौसल्यासुत भद्रं ते सुप्रभाताद्य शर्वरी ।\nद्रष्टुमभ्युदयं तेद्य सम्प्राप्तो रघुनंदन ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000281015, "chapter_id": 20281, "verse_number": "१-३५-१६", "content_sanskrit": "अगस्त्यो मुनिभिः सार्धं द्वारि तिष्ठति ते नृप ।\nश्रुत्वा प्राप्तान्मुनीन्रामस्तान्भास्करसमद्युतीन् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000281016, "chapter_id": 20281, "verse_number": "१-३५-१७", "content_sanskrit": "प्राह वाक्यं तदा द्वास्थं प्रवेशय त्वरान्वितः ।\nकिमर्थं तु त्वया द्वारि निरुद्धा मुनिसत्तमाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000281017, "chapter_id": 20281, "verse_number": "१-३५-१८", "content_sanskrit": "रामवाक्यान्मुनींस्तांस्तु प्रावेशयद्यथासुखम् ।\nदृष्ट्वा तु तान्मुनींन्प्राप्तान्प्रत्युवाच कृतांजलि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000281018, "chapter_id": 20281, "verse_number": "१-३५-१९", "content_sanskrit": "रामोऽभिवाद्य प्रणत आसनेषु न्यवेशयत् ।\nते तु कांचनचित्रेषु स्वास्तीर्णेषु सुखेषु च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000281019, "chapter_id": 20281, "verse_number": "१-३५-२०", "content_sanskrit": "कुशोत्तरेषु चासीनाः समंतान्मुनिपुंगवाः ।\nपाद्यमाचमनीयं च ददौ चार्घ्यं पुरोहितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000281020, "chapter_id": 20281, "verse_number": "१-३५-२१", "content_sanskrit": "रामेण कुशलं पृष्टा ऋषयः सर्व एव ते ।\nमहर्षयो वेदविद इदं वचनमब्रुवन् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000281021, "chapter_id": 20281, "verse_number": "१-३५-२२", "content_sanskrit": "कुशलं ते महाबाहो सर्वत्र रघुनंदन ।\nत्वां तु दिष्ट्या कुशलिनं पश्यामो हतविद्विषम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000281022, "chapter_id": 20281, "verse_number": "१-३५-२३", "content_sanskrit": "हृता सीतातिपापेन रावणेन दुरात्मना ।\nपत्नी ते रघुशार्दूल तस्या एवौजसा हतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000281023, "chapter_id": 20281, "verse_number": "१-३५-२४", "content_sanskrit": "असहायेन चैकेन त्वया राम रणे हतः ।\nयादृशं ते कृतं कर्म तस्य कर्ता न विद्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000281024, "chapter_id": 20281, "verse_number": "१-३५-२५", "content_sanskrit": "इह संभाषितुं प्राप्ता दृष्ट्वा पूताः स्म सांप्रतम् ।\nदर्शनात्तव राजेंद्र सर्वे जातास्तपस्विनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000281025, "chapter_id": 20281, "verse_number": "१-३५-२६", "content_sanskrit": "रावणस्य वधात्तेद्य कृतमश्रुप्रमार्जनम् ।\nदत्वा पुण्यामिमां वीर जगत्यभयदक्षिणाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000281026, "chapter_id": 20281, "verse_number": "१-३५-२७", "content_sanskrit": "दिष्ट्या वर्धसि काकुत्स्थ जयेनामितविक्रम ।\nदृष्टस्संभाषितश्चासि यास्यामश्चाश्रमान्स्वकान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000281027, "chapter_id": 20281, "verse_number": "१-३५-२८", "content_sanskrit": "अरण्यं ते प्रविष्टस्य मया चेंद्रशरासनम् ।\nअर्पितं चाक्षयौ तूणौ कवचं च परंतप ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000281028, "chapter_id": 20281, "verse_number": "१-३५-२९", "content_sanskrit": "भूयोप्यागमनं कार्यमाश्रमे मे रघूद्वह ।\nएवमुक्त्वा तु ते सर्वे मुनयोंतर्हिताऽभवन् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000281029, "chapter_id": 20281, "verse_number": "१-३५-३०", "content_sanskrit": "गतेषु मुनिमुख्येषु रामो धर्मभृतां वरः ।\nचिंतयामास तत्कार्यं किं स्यान्मे मुनिनोदितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000281030, "chapter_id": 20281, "verse_number": "१-३५-३१", "content_sanskrit": "भूयोप्यागमनं कार्यमाश्रमे रघुनंदन ।\nअवश्यमेव गंतव्यं मयाऽगस्त्यस्य सन्निधौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000281031, "chapter_id": 20281, "verse_number": "१-३५-३२", "content_sanskrit": "श्रोतव्यं देवगुह्यं तु कार्यमन्यच्च यद्वदेत् ।\nएवं चिंतयतस्तस्य रामस्यामिततेजसः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000281032, "chapter_id": 20281, "verse_number": "१-३५-३३", "content_sanskrit": "करिष्ये नियतं धर्मं धर्मो हि परमा गतिः ।\nसुतवर्षसहस्राणि दश राज्यमकारयत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000281033, "chapter_id": 20281, "verse_number": "१-३५-३४", "content_sanskrit": "ददतो जुह्वतश्चैव जग्मुस्तान्येकवर्षवत् ।\nप्रजाः पालयतस्तस्य राघवस्य महात्मनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000281034, "chapter_id": 20281, "verse_number": "१-३५-३५", "content_sanskrit": "एतस्मिन्नेव दिवसे वृद्धो जानपदो द्विजः ।\nमृतं पुत्रमुपादाय रामद्वारमुपागतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000281035, "chapter_id": 20281, "verse_number": "१-३५-३६", "content_sanskrit": "उवाच विविधं वाक्यं स्नेहाक्षरसमन्वितम् ।\nदुष्कृतं किंतु मे पुत्र पूर्वदेहांतरे कृतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000281036, "chapter_id": 20281, "verse_number": "१-३५-३७", "content_sanskrit": "त्वामेकपुत्रं यदहं पश्यामि निधनं गतम् ।\nअप्राप्तयौवनं बालं पंचवर्षं गतायुषम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000281037, "chapter_id": 20281, "verse_number": "१-३५-३८", "content_sanskrit": "अकाले कालमापन्नं दुःखाय मम पुत्रक ।\nअकृत्वा पितृकार्याणि गतो वैवस्वतक्षयम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000281038, "chapter_id": 20281, "verse_number": "१-३५-३९", "content_sanskrit": "रामस्य दुष्कृतं व्यक्तं येन ते मृत्युरागतः ।\nबालवध्या ब्रह्मवध्या स्त्रीवध्या चैव राघवम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000281039, "chapter_id": 20281, "verse_number": "१-३५-४०", "content_sanskrit": "प्रवेक्ष्यति न सन्देहः सभार्ये तु मृते मयि ।\nशुश्राव राघवः सर्वं दुःखशोकसमन्वितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000281040, "chapter_id": 20281, "verse_number": "१-३५-४१", "content_sanskrit": "निवार्य तं द्विजं रामो वसिष्ठं वाक्यमब्रवीत् ।\nकिं मयाद्य च कर्तव्यं कार्यमेवं विधे स्थिते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000281041, "chapter_id": 20281, "verse_number": "१-३५-४२", "content_sanskrit": "प्राणानहं जुहोम्यग्नौ पर्वताद्वा पतेह्यहम् ।\nकथं शुद्धिमहं यामि श्रुत्वा ब्राह्मणभाषितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000281042, "chapter_id": 20281, "verse_number": "१-३५-४३", "content_sanskrit": "वसिष्ठस्याग्रतः स्थित्वा राज्ञो दीनस्य नारदः ।\nप्रत्युवाच श्रुतं वाक्यमृषीणां सन्निधौ तदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000281043, "chapter_id": 20281, "verse_number": "१-३५-४४", "content_sanskrit": "शृणु राम यथाकालं प्राप्तो वै बालसंक्षयः ।\nपुरा कृतयुगे राम सर्वत्र ब्राह्मणोत्तरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000281044, "chapter_id": 20281, "verse_number": "१-३५-४५", "content_sanskrit": "अब्राह्मणो न वै कश्चित्तपस्तपति राघव ।\nअमृत्यवस्तदा सर्वे जायंते चिरजीविनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000281045, "chapter_id": 20281, "verse_number": "१-३५-४६", "content_sanskrit": "त्रेतायुगे पुनः प्राप्ते ब्रह्मक्षत्रमनुत्तमम् ।\nअधर्मो द्वापरे तेषां वैश्यान्शूद्रांस्तथाविशत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000281046, "chapter_id": 20281, "verse_number": "१-३५-४७", "content_sanskrit": "एवं निरंतरं जुष्टमुद्भूतमनृतं पुनः ।\nअधर्मस्य त्रयः पादा एको धर्मस्य चागतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000281047, "chapter_id": 20281, "verse_number": "१-३५-४८", "content_sanskrit": "ततः पूर्वे भृशं त्रस्ता वर्णा ब्राह्मणपूर्वकाः ।\nभूयः पादस्तु धर्मस्य द्वितीयः समपद्यत ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000281048, "chapter_id": 20281, "verse_number": "१-३५-४९", "content_sanskrit": "तस्मिन्द्वापरसंज्ञे तु तपो वैश्यं समाविशत् ।\nयुगत्रयस्य वैधर्म्यं धर्मस्य प्रतितिष्ठति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000281049, "chapter_id": 20281, "verse_number": "१-३५-५०", "content_sanskrit": "कलिसंज्ञे ततः प्राप्ते वर्तमाने युगेंतिमे ।\nअधर्मश्चानृतं चैव ववृधाते नरर्षभ ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000281050, "chapter_id": 20281, "verse_number": "१-३५-५१", "content_sanskrit": "भविता शूद्रयोन्यां तु तपश्चर्या कलौ युगे ।\nस ते विषयपर्यंते राजन्नुग्रतरं तपः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000281051, "chapter_id": 20281, "verse_number": "१-३५-५२", "content_sanskrit": "शूद्रस्तपति दुर्बुद्धिस्तेन बालवधः कृतः ।\nयस्याधर्ममकार्यं वा विषये पार्थिवस्य हि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000281052, "chapter_id": 20281, "verse_number": "१-३५-५३", "content_sanskrit": "पुरे वा राजशार्दूल कुरुते दुर्मतिर्नरः ।\nक्षिप्रं स नरकं याति यावदाभूतसंप्लवम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000281053, "chapter_id": 20281, "verse_number": "१-३५-५४", "content_sanskrit": "चतुर्थं तस्य पापस्य भागमश्नाति पार्थिवः ।\nसत्त्वं पुरुषशार्दूल गच्छस्व विषयं स्वकम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000281054, "chapter_id": 20281, "verse_number": "१-३५-५५", "content_sanskrit": "दुष्कृतं यत्र पश्येथास्तत्र यत्नं समाचर ।\nएवं ते धर्मवृद्धिश्च बलस्य वर्धनं तथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000281055, "chapter_id": 20281, "verse_number": "१-३५-५६", "content_sanskrit": "भविष्यति नरश्रेष्ठ बालस्यास्य च जीवनम् ।\nनारदेनैवमुक्तस्तु साश्चर्यो रघुनंदनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000281056, "chapter_id": 20281, "verse_number": "१-३५-५७", "content_sanskrit": "प्रहर्षमतुलं लेभे लक्ष्मणं चेदमब्रवीत् ।\nगच्छ सौम्य द्विजश्रेष्ठं समाश्वासय लक्ष्मण ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000281057, "chapter_id": 20281, "verse_number": "१-३५-५८", "content_sanskrit": "बालस्य च शरीरं त्वं तैलद्रोण्यां निधापय ।\nगंधैश्च परमोदारैस्तैलैश्चैव सुगंधिभिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000281058, "chapter_id": 20281, "verse_number": "१-३५-५९", "content_sanskrit": "यथा न शीर्यते बालस्तथा सौम्य विधीयताम् ।\nयथा शरीरं गुप्तं स्याद्बालस्याक्लिष्टकर्मणः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000281059, "chapter_id": 20281, "verse_number": "१-३५-६०", "content_sanskrit": "विपत्तिः परिभेदो वा न भवेत्तत्तथा कुरु ।\nतथा संदिश्य सौमित्रं लक्ष्मणं शुभलक्षणम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000281060, "chapter_id": 20281, "verse_number": "१-३५-६१", "content_sanskrit": "मनसा पुष्पकं दध्यावागच्छेति महायशाः ।\nइंगितं तत्तु विज्ञाय कामगं हेमभूषितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000281061, "chapter_id": 20281, "verse_number": "१-३५-६२", "content_sanskrit": "आजगाम मुहूर्तात्तु समीपं राघवस्य हि ।\nसोब्रवीत्प्राञ्जलिर्वाक्यमहमस्मि नराधिप ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000281062, "chapter_id": 20281, "verse_number": "१-३५-६३", "content_sanskrit": "अग्रे तव महाबाहो किंकरः समुपस्थितः ।\nभाषितं सुचिरं श्रुत्वा पुष्पकस्य नराधिप ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000281063, "chapter_id": 20281, "verse_number": "१-३५-६४", "content_sanskrit": "अभिवाद्य महर्षींस्तान्विमानं सोध्यरोहत ।\nधनुर्गृहीत्वा तूणौ च खड्गं चापि महाप्रभम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000281064, "chapter_id": 20281, "verse_number": "१-३५-६५", "content_sanskrit": "निक्षिप्य नगरे वीरौ सौमित्रि भरतावुभौ ।\nप्रायात्प्रतीचीं त्वरितो विचिन्वन्सुसमाहितः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000281065, "chapter_id": 20281, "verse_number": "१-३५-६६", "content_sanskrit": "उत्तरामगमत्पश्चाद्दिशं हिमवदाश्रिताम् ।\nपूर्वामपि दिशां गत्वा तथाऽपश्यन्नराधिपः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000281066, "chapter_id": 20281, "verse_number": "१-३५-६७", "content_sanskrit": "सर्वां शुद्धसमाचारामादर्शमिव निर्मलाम् ।\nततो दिशं समाक्रामद्दक्षिणां रघुनंदनः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000281067, "chapter_id": 20281, "verse_number": "१-३५-६८", "content_sanskrit": "शैलस्य उत्तरे पार्श्वे ददर्श सुमहत्सरः ।\nतस्मिन्सरसि तप्यंतं तापसं सुमहत्तपः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000281068, "chapter_id": 20281, "verse_number": "१-३५-६९", "content_sanskrit": "ददर्श राघवो भीमं लंबमानमधोमुखं ।\nतमुपागम्य काकुत्स्थस्तप्यमानं तु तापसम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000281069, "chapter_id": 20281, "verse_number": "१-३५-७०", "content_sanskrit": "उवाच राघवो वाक्यं धन्यस्त्वममरप्रभ ।\nकस्यां योनौ तपोवृद्धिर्वर्तते दृढनिश्चय ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000281070, "chapter_id": 20281, "verse_number": "१-३५-७१", "content_sanskrit": "अहं दाशरथी रामः पृच्छामि त्वां कुतूहलात् ।\nकोर्थो व्यवसितस्तुभ्यं स्वर्गलोकोथ वेतरः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000281071, "chapter_id": 20281, "verse_number": "१-३५-७२", "content_sanskrit": "किमर्थं तप्यसे वा त्वं श्रोतुमिच्छामि तापस ।\nब्राह्मणो वासि भद्रं ते क्षत्रियो वाथ दुर्जयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000281072, "chapter_id": 20281, "verse_number": "१-३५-७३", "content_sanskrit": "वैश्यस्तृतीयवर्णो वा शूद्रो वा सत्यमुच्यताम् ।\nतपः सत्यात्मकं नित्यं स्वर्गलोकपरिग्रहे ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000281073, "chapter_id": 20281, "verse_number": "१-३५-७४", "content_sanskrit": "सात्विकं राजसं चैव तच्च सत्यात्मकं तपः ।\nजगदुपकारहेतुर्हि सृष्टं तद्वै विरिंचिना ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000281074, "chapter_id": 20281, "verse_number": "१-३५-७५", "content_sanskrit": "रौद्रं क्षत्रियतेजोजं तत्तु राजसमुच्यते ।\nपरस्योत्सादनार्थाय तच्चासुरमुदाहृतम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000281075, "chapter_id": 20281, "verse_number": "१-३५-७६", "content_sanskrit": "अंगानि निह्नुते यो वा असृग्दिग्धानि भागशः ।\nपंचाग्निंसाधयेद्वापि सिद्धिं वा मृत्युमेव वा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000281076, "chapter_id": 20281, "verse_number": "१-३५-७७", "content_sanskrit": "आसुरो ह्येष ते भावो न च मे त्वं द्विजो मतः ।\nसत्यं ते वदतः सिद्धिरनृते नास्ति जीवितम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000281077, "chapter_id": 20281, "verse_number": "१-३५-७८", "content_sanskrit": "तस्य तद्भाषितं श्रुत्वा रामस्याक्लिष्टकर्मणः ।\nअवाक्शिरास्तथा भूतो वाक्यमेतदुवाच ह ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000281078, "chapter_id": 20281, "verse_number": "१-३५-७९", "content_sanskrit": "स्वागतं ते नृपश्रेष्ठ चिराद्दृष्टोसि राघव ।\nपुत्रभूतोस्मि ते चाहं पितृभूतोसि मेनघ ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000281079, "chapter_id": 20281, "verse_number": "१-३५-८०", "content_sanskrit": "अथवा नैतदेवं हि सर्वेषां नृपतिः पिता ।\nसत्वमर्च्योऽसि भो राजन्वयं ते विषये तपः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000281080, "chapter_id": 20281, "verse_number": "१-३५-८१", "content_sanskrit": "चरामस्तत्रभागोस्ति पूर्वं सृष्टः स्वयंभुवा ।\nन धन्याः स्मो वयं राम धन्यस्त्वमसि पार्थिव ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000281081, "chapter_id": 20281, "verse_number": "१-३५-८२", "content_sanskrit": "यस्य ते विषये ह्येवं सिद्धिमिच्छंति तापसाः ।\nतपसा त्वं मदीयेन सिद्धिमाप्नुहि राघव ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000281082, "chapter_id": 20281, "verse_number": "१-३५-८३", "content_sanskrit": "यदेतद्भवता प्रोक्तं योनौ कस्यां तु ते तपः ।\nशूद्रयोनिप्रसूतोहं तप उग्रं समास्थितः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000281083, "chapter_id": 20281, "verse_number": "१-३५-८४", "content_sanskrit": "देवत्वं प्रार्थये राम स्वशरीरेण सुव्रत ।\nन मिथ्याहं वदे भूप देवलोकजिगीषया ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000281084, "chapter_id": 20281, "verse_number": "१-३५-८५", "content_sanskrit": "शूद्रं मां विद्धि काकुत्स्थ शंबूकं नाम नामतः ।\nभाषतस्तस्य काकुत्स्थः खड्गं तु रुचिरप्रभं ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000281085, "chapter_id": 20281, "verse_number": "१-३५-८६", "content_sanskrit": "निष्कृष्य कोशाद्विमलं शिरश्चिच्छेद राघवः ।\nतस्मिन्शूद्रे हते देवाः सेन्द्राश्चाग्निपुरोगमाः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000281086, "chapter_id": 20281, "verse_number": "१-३५-८७", "content_sanskrit": "साधुसाध्विति काकुत्स्थं प्रशशंसुर्मुहुर्मुहुः ।\nपुष्पवृष्टिश्च महती देवानां सुसुगंधिनी ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000281087, "chapter_id": 20281, "verse_number": "१-३५-८८", "content_sanskrit": "आकाशाद्विप्रमुक्ता तु राघवं सर्वतोकिरत् ।\nसुप्रीताश्चाब्रुवन्देवा रामं वाक्यविदांवरम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000281088, "chapter_id": 20281, "verse_number": "१-३५-८९", "content_sanskrit": "सुरकार्यमिदं सौम्य कृतं ते रघुनंदन ।\nगृहाण च वरं राम यमिच्छसि महाव्रत ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000281089, "chapter_id": 20281, "verse_number": "१-३५-९०", "content_sanskrit": "त्वत्कृतेन हि शूद्रोऽयं सशरीरोऽभ्यगाद्दिवं ।\nदेवानां भाषितं श्रुत्वा राघवः सुसमाहितः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000281090, "chapter_id": 20281, "verse_number": "१-३५-९१", "content_sanskrit": "उवाच प्राञ्जलिर्वाक्यं सहस्राक्षं पुरंदरम् ।\nयदि देवाः प्रसन्ना मे वरार्हो यदि वाप्यहम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000281091, "chapter_id": 20281, "verse_number": "१-३५-९२", "content_sanskrit": "कर्मणा यदि मे प्रीता द्विजपुत्रः स जीवतु ।\nवरमेतद्धि भवतां कांक्षितं परमं हि मे ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000281092, "chapter_id": 20281, "verse_number": "१-३५-९३", "content_sanskrit": "ममापराधाद्बालोऽसौ ब्राह्मणस्यैकपुत्रकः ।\nअप्राप्तकालः कालेन नीतो वैवस्वत क्षयम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000281093, "chapter_id": 20281, "verse_number": "१-३५-९४", "content_sanskrit": "तं जीवयत भद्रं वो नानृती स्यामहं गुरोः ।\nद्विजस्य संश्रुतो ह्यर्थो जीवयिष्यामि ते सुतम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000281094, "chapter_id": 20281, "verse_number": "१-३५-९५", "content_sanskrit": "मदीयेनायुषा बालं पादेनार्द्धेन वा सुराः ।\nजीवेदयं वरो मह्यं वरकोट्यधिको वृतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000281095, "chapter_id": 20281, "verse_number": "१-३५-९६", "content_sanskrit": "राघवस्य तु तद्वाक्यं श्रुत्वा विबुधसत्तमाः ।\nप्रत्यूचुस्ते महात्मानं प्रीताः प्रीतिसमन्विताः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000281096, "chapter_id": 20281, "verse_number": "१-३५-९७", "content_sanskrit": "निर्वृतो भव काकुत्स्थ ब्राह्मणस्यैकपुत्रकः ।\nजीवितं प्राप्तवान्भूयः समेतश्चापि बंधुभिः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000281097, "chapter_id": 20281, "verse_number": "१-३५-९८", "content_sanskrit": "यस्मिन्मुहूर्ते काकुत्स्थ शूद्रोयं विनिपातितः ।\nतस्मिन्मुहूर्ते सहसा जीवेन समयुज्यत ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000281098, "chapter_id": 20281, "verse_number": "१-३५-९९", "content_sanskrit": "स्वस्ति प्राप्नुहि भद्रं ते साधयामः परंतपः ।\nअगस्त्यस्याश्रमपदे द्रष्टारः स्म महामुनिम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000281099, "chapter_id": 20281, "verse_number": "१-३५-१००", "content_sanskrit": "स तथेति प्रतिज्ञाय देवानां रघुनंदनः ।\nआरुरोह विमानं तं पुष्पकं हेमभूषितम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]