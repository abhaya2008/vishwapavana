[{"id": 2005188, "chapter_id": 1102, "verse_number": "१-१०३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005189, "chapter_id": 1102, "verse_number": "१-१०३-१", "content_sanskrit": "ततः प्रतीपो राजाऽऽसीत्सर्वभूतहितः सदा।\nनिषसाद समा बह्वीर्गङ्गाद्वारगतो जपन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005190, "chapter_id": 1102, "verse_number": "१-१०३-२", "content_sanskrit": "तस्य रूपगुणोपेता गङ्गा स्त्रीरूपधारिणी।\nउत्तीर्य सलिलात्तस्माल्लोभनीयतमाकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005191, "chapter_id": 1102, "verse_number": "१-१०३-३", "content_sanskrit": "अधीयानस्य राजर्षेर्दिव्यरूपा मनस्विनी।\nदक्षिणं शालसङ्काशमूरुं भेजे शुभानना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005192, "chapter_id": 1102, "verse_number": "१-१०३-४", "content_sanskrit": "प्रतीपस्तु महीपालस्तामुवाच यशस्विनीम्।\nवाक्यं वाक्यविदां श्रेष्ठो धर्मनिश्चयतत्त्ववित्।\nकरोमि किं ते कल्याणि प्रियं यत्तेऽभिकाङ्क्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005193, "chapter_id": 1102, "verse_number": "१-१०३-५x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005194, "chapter_id": 1102, "verse_number": "१-१०३-५", "content_sanskrit": "त्वामहं कामये राजन्भजमानां भजस्व माम्।\nत्यागः कामवतीनां हि स्त्रीणां सद्भिर्विगर्हितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005195, "chapter_id": 1102, "verse_number": "१-१०३-६x", "content_sanskrit": "प्रतीप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005196, "chapter_id": 1102, "verse_number": "१-१०३-६", "content_sanskrit": "नाहं परस्त्रियं कामाद्गच्छेदं वरवर्णिनि।\nन चासवर्णां कल्याणि धर्म्यमेतद्धि मे व्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005197, "chapter_id": 1102, "verse_number": "१-१०३-७", "content_sanskrit": "यः स्वदारान्परित्यज्य पारक्यां सेवते स्त्रियम्।\nनिरयान्नैव मुच्यते यावदाभूतसंप्लवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005198, "chapter_id": 1102, "verse_number": "१-१०३-८x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005199, "chapter_id": 1102, "verse_number": "१-१०३-८", "content_sanskrit": "नाश्रेयस्यस्मि नागम्या न वक्तव्या च कर्हिचित्।\nभजन्तीं भज मां राजन्दिव्यां कन्यां वरस्त्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005200, "chapter_id": 1102, "verse_number": "१-१०३-९x", "content_sanskrit": "प्रतीप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005201, "chapter_id": 1102, "verse_number": "१-१०३-९", "content_sanskrit": "त्वया निवृत्तमेतत्तु यन्मां चोदयसि प्रियम्।\nअन्यथा प्रतिपन्नं मां नाशयेद्धर्मविप्लवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005202, "chapter_id": 1102, "verse_number": "१-१०३-१०", "content_sanskrit": "प्राप्य दक्षिणमूरुं मे त्वमाश्लिष्टा वराङ्गने।\nअपत्यानां स्नुषाणां च भीरु विद्ध्येतदासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005203, "chapter_id": 1102, "verse_number": "१-१०३-११", "content_sanskrit": "सव्योरुः कामिनीभोग्यस्त्वया स च विवर्जितः।\nतस्मादहं नाचरिष्ये त्वयि कामं वराङ्गने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005204, "chapter_id": 1102, "verse_number": "१-१०३-१२", "content_sanskrit": "स्नुषा मे भव सुश्रोणि पुत्रार्थं त्वां वृणोम्यहम्।\nस्नुषापक्षं हि वामोरु त्वमागम्य समाश्रिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005205, "chapter_id": 1102, "verse_number": "१-१०३-१३x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005206, "chapter_id": 1102, "verse_number": "१-१०३-१३", "content_sanskrit": "एवमप्यस्तु धर्मज्ञ संयुज्येयं सुतेन ते।\nत्वद्भक्त्या तु भजिष्यामि प्रख्यातं भारतं कुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005207, "chapter_id": 1102, "verse_number": "१-१०३-१४", "content_sanskrit": "पृथिव्यां पार्थिवा ये च तेषां यूयं परायणम्।\nगुणा न हि मया शक्या वक्तुं वर्षशतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005208, "chapter_id": 1102, "verse_number": "१-१०३-१५", "content_sanskrit": "कुलस्य ये वः प्रथितास्तत्साधुत्वमथोत्तमम्।\nसमयेनेह धर्मज्ञ आचरेयं च यद्विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005209, "chapter_id": 1102, "verse_number": "१-१०३-१६", "content_sanskrit": "तत्सर्वमेव पुत्रस्ते न मीमांसेत कर्हिचित्।\nएवं वसन्ती पुत्रे ते वर्धयिष्याम्यहं रतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005210, "chapter_id": 1102, "verse_number": "१-१०३-१७", "content_sanskrit": "पुत्रैः पुण्यैः प्रियैश्चैव स्वर्गं प्राप्स्यति ते सुतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005211, "chapter_id": 1102, "verse_number": "१-१०३-१७x", "content_sanskrit": "वैशम्पायन उवाच।\nतथेत्युक्त्वा तु सा राजंस्तत्रैवान्तरधीयत।\nअदृश्या राजसिंहस्य पश्यतः साऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005212, "chapter_id": 1102, "verse_number": "१-१०३-१८", "content_sanskrit": "पुत्रजन्म प्रतीक्षन्वै स राजा तदधारयत्।\nएतस्मिन्नेव काले तु प्रतीपः क्षत्रियर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005213, "chapter_id": 1102, "verse_number": "१-१०३-१९", "content_sanskrit": "तपस्तेपे सुतस्यार्थे सभार्यः कुरुनन्दन।\nप्रतीपस्य तु भार्यायां गर्भः श्रीमानवर्धत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005214, "chapter_id": 1102, "verse_number": "१-१०३-२०", "content_sanskrit": "श्रिया परमया युक्तः शरच्छुक्ले यथा शशी।\nततस्तु दशमे मासि प्राजायत रविप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005215, "chapter_id": 1102, "verse_number": "१-१०३-२१", "content_sanskrit": "कुमारं देवगर्भाभं प्रतीपमहिषी तदा।\nतयोः समभवत्पुत्रो वृद्धयोः स महाभिषक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005216, "chapter_id": 1102, "verse_number": "१-१०३-२२", "content_sanskrit": "शान्तस्य जज्ञे सन्तानस्तस्मादासीत्स शान्तनुः।\nतस्य जातस्य कृत्यानि प्रतीपोऽकारयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005217, "chapter_id": 1102, "verse_number": "१-१०३-२३", "content_sanskrit": "जातकर्मादि विप्रेण वेदोक्तैः कर्मभिस्तदा।\nनामकर्म च विप्रास्तु चक्रुः परमसत्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005218, "chapter_id": 1102, "verse_number": "१-१०३-२४", "content_sanskrit": "शान्तनोरवनीपाल वेदोक्तैः कर्मभिस्तदा।\nततः संवर्धितो राजा शान्तनुर्लोकधार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005219, "chapter_id": 1102, "verse_number": "१-१०३-२५", "content_sanskrit": "स तु लेभे परां निष्ठां प्राप्य धर्मभृतां वरः।\nधनुर्वेदे च वेदे च गतिं स परमा गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005220, "chapter_id": 1102, "verse_number": "१-१०३-२६", "content_sanskrit": "यौवनं चापि संप्राप्तः कुमारो वदतां वरः।\nसंस्मरंश्चाक्षयाँल्लोकान्विजातान्स्वेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005221, "chapter_id": 1102, "verse_number": "१-१०३-२७", "content_sanskrit": "पुण्यकर्मकृदेवासीच्छान्तनुः कुरुसत्तमः।\nप्रतीपः शान्तनुं पुत्रं यौवनस्थं ततोऽन्वशात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005222, "chapter_id": 1102, "verse_number": "१-१०३-२८", "content_sanskrit": "पुरा स्त्री मां समभ्यागाच्छान्तनो भूतये तव।\nत्वामाव्रजेद्यदि रहः सा पुत्र वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005223, "chapter_id": 1102, "verse_number": "१-१०३-२९", "content_sanskrit": "कामयानाऽभिरूपाढ्या दिव्यस्त्री पुत्रकाम्यया।\nसा त्वया नानुयोक्तव्या कासि कस्यासि चाङ्गने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005224, "chapter_id": 1102, "verse_number": "१-१०३-३०", "content_sanskrit": "यच्च कुर्यान्न तत्कर्म सा प्रष्टव्या त्वयाऽनघ।\nसन्नियोगाद्भजन्तीं तां भजेथा इत्युवाच तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005225, "chapter_id": 1102, "verse_number": "१-१०३-३१", "content_sanskrit": "एवं संदिश्य तनयं प्रतीपः शान्तनुं तदा।\nस्वे च राज्येऽभिषिच्यैनं वनं राजा विवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005226, "chapter_id": 1102, "verse_number": "१-१०३-३२", "content_sanskrit": "स राजा शान्तनुर्धीमान्देवराजसमद्युतिः।\nबभूव सर्वलोकस्य सत्यवागिति संमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005227, "chapter_id": 1102, "verse_number": "१-१०३-३३", "content_sanskrit": "पीनस्कन्धो महाबाहुर्मत्तवारणविक्रमः।\nअन्वितः परिपूर्णार्थैः सर्वैर्नृपतिलक्षणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005228, "chapter_id": 1102, "verse_number": "१-१०३-३४", "content_sanskrit": "अमात्यलक्षणोपेतः क्षत्रधर्मविशेषवित्।\nवशे चक्रे महीमेको विजित्य वसुधाधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005229, "chapter_id": 1102, "verse_number": "१-१०३-३५", "content_sanskrit": "वेदानागमयत्कृत्स्नान्राजधर्मांश्च सर्वशः।\nईजे च बहुभिः सत्रैः क्रतुभिर्भूरिदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005230, "chapter_id": 1102, "verse_number": "१-१०३-३६", "content_sanskrit": "तर्पयामास विप्रांश्च वेदाध्ययनकोविदान्।\nरत्नैरुच्चावचैर्गोभिर्ग्रामैरश्वैर्धनैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005231, "chapter_id": 1102, "verse_number": "१-१०३-३७", "content_sanskrit": "वयोरूपेण संपन्नः पौरुषेण बलेन च।\nऐश्वर्येण प्रतापेन विक्रमेण धनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005232, "chapter_id": 1102, "verse_number": "१-१०३-३८", "content_sanskrit": "वर्तमानश्च सत्येन सर्वधर्मविशारदः।\nतं महीपं महीपाला राजराजमकुर्वत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2005233, "chapter_id": 1102, "verse_number": "१-१०३-३९", "content_sanskrit": "वीतशोकभयाबाधाः सुखस्वप्नप्रबोधाः।\nश्रिया भरतशार्दूल समपद्यन्त भूमिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2005234, "chapter_id": 1102, "verse_number": "१-१०३-४०", "content_sanskrit": "नियमैः सर्ववर्णानां ब्रह्मोत्तरमवर्तत।\nब्राह्मणाभिमुखं क्षत्रं क्षत्रियाभिमुखा विशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2005235, "chapter_id": 1102, "verse_number": "१-१०३-४१", "content_sanskrit": "ब्रह्मक्षत्रानुकूलांश्च शूद्राः पर्यचरन्विशः।\nएवं पशुवराहाणां तथैव मृगपक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2005236, "chapter_id": 1102, "verse_number": "१-१०३-४२", "content_sanskrit": "शान्तनावथ राज्यस्थे नावर्तत वृथा वधः।\nअसुखानामनाथानां तिर्यग्योनिषु वर्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2005237, "chapter_id": 1102, "verse_number": "१-१०३-४३", "content_sanskrit": "स एव राजा सर्वेषां भूतानामभवत्पिता।\nस हस्तिनाम्नि धर्मात्मा विहरन्कुरुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2005238, "chapter_id": 1102, "verse_number": "१-१०३-४४", "content_sanskrit": "तेजसा सूर्यकल्पोऽभूद्वायुना च समो बले।\nअन्तकप्रतिमः कोपे क्षमया पृथिवीसमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2005239, "chapter_id": 1102, "verse_number": "१-१०३-४५", "content_sanskrit": "बभूव राजा सुमतिः प्रजानां सत्यविक्रमः।\nस वनेषु च रम्येषु शैलप्रस्रवणेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2005240, "chapter_id": 1102, "verse_number": "१-१०३-४६", "content_sanskrit": "चचार मृगयाशीलः शान्तनुर्वनगोचरः।\nस मृगान्महिषांश्चैव विनिघ्नन्राजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2005241, "chapter_id": 1102, "verse_number": "१-१०३-४७", "content_sanskrit": "गङ्गामनु चचारैकः सिद्धचारणसेविताम्।\nस कदाचिन्महाराज ददर्श परमां स्त्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2005242, "chapter_id": 1102, "verse_number": "१-१०३-४८", "content_sanskrit": "जाज्वल्यमानां वपुषा साक्षाच्छ्रियमिवापराम्।\nसर्वानवद्यां सुदतीं दिव्याभरणभूषिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2005243, "chapter_id": 1102, "verse_number": "१-१०३-४९", "content_sanskrit": "सूक्ष्माम्बरधरामेकां पद्मोदरसमप्रभाम्।\nस्नातगात्रां धौतवस्त्रां गङ्गातीररुहे वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2005244, "chapter_id": 1102, "verse_number": "१-१०३-५०", "content_sanskrit": "प्रकीर्णकेशीं पाणिभ्यां संस्पृशन्तीं शिरोरुहान्।\nरूपेण वयसा कान्त्या शरीरावयवैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2005245, "chapter_id": 1102, "verse_number": "१-१०३-५१", "content_sanskrit": "हावभावविलासैश्च लोचनाञ्चलविक्रियैः।\nश्रोणीभारेण मध्येन स्तनाभ्यामुरसा दृशा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2005246, "chapter_id": 1102, "verse_number": "१-१०३-५२", "content_sanskrit": "कवरीभरेण पादाभ्यामिङ्गितेन स्मितेन च।\nकोकिलालापसंल्लापैर्न्यक्कुर्वन्तीं त्रिलोकगाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2005247, "chapter_id": 1102, "verse_number": "१-१०३-५३", "content_sanskrit": "वाणीं च गिरिजां लक्ष्मीं योषितोन्याः सुराङ्गनाः।\nसा च शान्तनुमब्यागादलक्ष्मीमपकर्षती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2005248, "chapter_id": 1102, "verse_number": "१-१०३-५४", "content_sanskrit": "तां दृष्ट्वा हृष्टरोमाऽभूद्विस्मितो रूपसंपदा।\nपिबन्निव च नेत्राभ्यां नातृप्यत नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2005249, "chapter_id": 1102, "verse_number": "१-१०३-५५", "content_sanskrit": "सा च दृष्ट्वैव राजानं विचरन्तं महाद्युतिम्।\nस्नेहादागतसौहार्दा नातृप्यत विलासिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2005250, "chapter_id": 1102, "verse_number": "१-१०३-५६", "content_sanskrit": "गङ्गा कामेन राजानं प्रेक्षमाणा विलासिनी।\nचञ्चूर्यताग्रतस्तस्य किन्नरीवाप्सरोपमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2005251, "chapter_id": 1102, "verse_number": "१-१०३-५७", "content_sanskrit": "दृष्ट्वा प्रहृष्टरूपोऽभूद्दर्शनादेव शान्तनुः।\nरूपेणातीत्य तिष्ठन्तीं सर्वा राजन्ययोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2005252, "chapter_id": 1102, "verse_number": "१-१०३-५८", "content_sanskrit": "तामुवाच ततो राजा सान्त्वयञ्श्लक्ष्णया गिरा।\nदेवी वा दानवी वा त्वं गन्धर्वी चाथवाऽप्सराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2005253, "chapter_id": 1102, "verse_number": "१-१०३-५९", "content_sanskrit": "यक्षी वा पन्नगी वाऽपि मानुषी वा सुमध्यमे।\nयाऽसि काऽसि सुरप्रख्ये महिषी मे भवानघे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2005254, "chapter_id": 1102, "verse_number": "१-१०३-६०", "content_sanskrit": "त्वां गता हि मम प्रामा वसु यन्मेऽस्ति किंचन।\nयाचे त्वां सुरगर्भाभे भार्या मे भव शोभने॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2005255, "chapter_id": 1102, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि त्र्यधिकशततमोऽध्यायः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]