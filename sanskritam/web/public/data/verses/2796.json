[{"id": 2084342, "chapter_id": 2796, "verse_number": "१२-३०१-०x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084343, "chapter_id": 2796, "verse_number": "१२-३०१-१", "content_sanskrit": "एष धर्मविधिस्तात गृहस्थस्य प्रकीर्तितः।\nतपोविधिं तु वक्ष्यामि तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084344, "chapter_id": 2796, "verse_number": "१२-३०१-२", "content_sanskrit": "प्रायेण च गृहस्थस्य ममत्वं नाम जायते।\nसङ्गागतं नरश्रेष्ठ भावै राजसतामसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084345, "chapter_id": 2796, "verse_number": "१२-३०१-३", "content_sanskrit": "गृहाण्याश्रित्य गावश्च क्षेत्राणि च धनानि च।\nदाराः पुत्राश्च भृत्याश्च भवन्तीह नरस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084346, "chapter_id": 2796, "verse_number": "१२-३०१-४", "content_sanskrit": "एवं तस्य प्रवृत्तस्य नित्यमेवानुपश्यतः।\nरागद्वेषौ विवर्धेते ह्यनित्यत्वमपश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084347, "chapter_id": 2796, "verse_number": "१२-३०१-५", "content_sanskrit": "रागद्वेषाभिभूतं च नरं द्रव्यवशानुगम्।\nमोहजस्तारतिर्नाम समुपैति नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084348, "chapter_id": 2796, "verse_number": "१२-३०१-६", "content_sanskrit": "कृतार्थ भोगिनं मत्वा सर्वो रतिपरायणः।\nलाभं प्रात्यसुखादन्यं रतितो नानुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084349, "chapter_id": 2796, "verse_number": "१२-३०१-७", "content_sanskrit": "ततो लोभाभिभूतात्मा सङ्गाद्वधर्यते जनम्।\nदुष्टार्थं चैव तस्येह जनस्यार्थं चिकीर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084350, "chapter_id": 2796, "verse_number": "१२-३०१-८", "content_sanskrit": "स जानत्रपि चाकार्यमर्थार्थं सेवते नरः।\nबालस्नेहपरीतात्मा तत्क्षयाच्चानुतप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084351, "chapter_id": 2796, "verse_number": "१२-३०१-९", "content_sanskrit": "ततो दानेन संपन्नो रक्षन्नात्मपराजयम्।\nकरोति येन भोनी स्यामिति तस्माद्विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084352, "chapter_id": 2796, "verse_number": "१२-३०१-१०", "content_sanskrit": "तद्यदि वुद्धियुक्तानां शाश्वतं ब्रह्मवादिनाम्।\nअभिच्छतां शुभं कर्म नराणां त्यजतां सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084353, "chapter_id": 2796, "verse_number": "१२-३०१-११", "content_sanskrit": "लोकायतननाशाच्च धननाशाच्च पार्थिव।\nआधिव्याधिप्रतापाच्च निर्वेदमुपगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084354, "chapter_id": 2796, "verse_number": "१२-३०१-१२", "content_sanskrit": "निर्वेदादात्मसंबोधः संबोधादात्मदर्शनम्।\nशास्त्रार्थदर्शनाद्राजसंस्तप एवानुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084355, "chapter_id": 2796, "verse_number": "१२-३०१-१३", "content_sanskrit": "दुर्लभो हि मनुष्येन्द्र नरः प्रत्यवमर्शवान्।\nयो वै प्रियसुखे क्षीणे तपः कर्तुं व्यवस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084356, "chapter_id": 2796, "verse_number": "१२-३०१-१४", "content_sanskrit": "तपः सर्वगतं तात हीनस्यापि विधीयते।\nजितेन्द्रियस्य दान्तस्य स्वर्गमार्गप्रवर्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084357, "chapter_id": 2796, "verse_number": "१२-३०१-१५", "content_sanskrit": "प्रजापतिः प्रजाः पूर्वमसृजत्तपसा विभुः।\nक्वचित्क्वचिद्ब्रतपरो व्रतान्यास्थाय पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084358, "chapter_id": 2796, "verse_number": "१२-३०१-१६", "content_sanskrit": "आदित्या वसवो रुद्रास्तथैवाग्न्यश्विमारुताः।\nविश्वेदेवास्तथा साध्याः पितरोऽथ मरुद्गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084359, "chapter_id": 2796, "verse_number": "१२-३०१-१७", "content_sanskrit": "यक्षराक्षसगन्धर्वाः सिद्धाश्चान्ये दिवौकसः।\nसंसिद्धास्तपसा तात ये चान्ये स्वर्गवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084360, "chapter_id": 2796, "verse_number": "१२-३०१-१८", "content_sanskrit": "ये चादौ ब्राह्मणाः सृष्टा ब्रह्मणा तपसा पुरा।\nते भावयन्तः पृथिवीं विचरन्ति दिवं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084361, "chapter_id": 2796, "verse_number": "१२-३०१-१९", "content_sanskrit": "मर्त्यलोके च राजानो ये चान्ये गृहमेधिनः।\nमहाकुलेषु दृश्यन्ते तत्सर्वं तपसः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084362, "chapter_id": 2796, "verse_number": "१२-३०१-२०", "content_sanskrit": "कौशेयानि च वस्त्राणि शुभान्याभरणानि च।\nवाहनासनपानानि तत्सर्वं तपसः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084363, "chapter_id": 2796, "verse_number": "१२-३०१-२१", "content_sanskrit": "मनोनुकूलाः प्रमदा रूपवत्यः सहस्रशः।\nवासः प्रासादपृष्ठे च तत्सर्वं तपसः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084364, "chapter_id": 2796, "verse_number": "१२-३०१-२२", "content_sanskrit": "शयनानि च मुख्यानि भोज्यानि विविधानि च।\nअभिप्रेतानि सर्वाणि भवन्ति शुभकर्मिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084365, "chapter_id": 2796, "verse_number": "१२-३०१-२३", "content_sanskrit": "नाप्राप्यं तपसः किंचिन्त्रैलोक्येऽपि परंतप।\nउपभोगपरित्यागः फलान्यकृतकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084366, "chapter_id": 2796, "verse_number": "१२-३०१-२४", "content_sanskrit": "सुखितो दुःखितो वाऽपि नरो लोभं परित्यजेत्।\nअवेक्ष्य मनसा शास्त्रं बुद्ध्या च नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084367, "chapter_id": 2796, "verse_number": "१२-३०१-२५", "content_sanskrit": "असंतोषोऽसुखथायेति लोभादिन्द्रियविभ्रमः।\nततोऽस्य नश्यति प्रज्ञा विद्येवाभ्यासवर्जिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084368, "chapter_id": 2796, "verse_number": "१२-३०१-२६", "content_sanskrit": "नष्टप्रज्ञो यदा तु स्यात्तदा न्यायं न पश्यति।\nतस्मात्सुखक्षये प्राप्ते पुमानुग्रतपश्चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084369, "chapter_id": 2796, "verse_number": "१२-३०१-२७", "content_sanskrit": "यदिष्टं तत्सुखं प्राहुर्द्वेष्यं दुःखमिहेष्यते।\nकृताकृतस्य तपसः फलं पश्यस्व यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084370, "chapter_id": 2796, "verse_number": "१२-३०१-२८", "content_sanskrit": "नित्यं भद्राणि पश्यन्ति विषयांश्चोपभुञ्जते।\nप्राकाश्यं चैवं गच्छन्ति कृत्वा निष्कल्मषं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084371, "chapter_id": 2796, "verse_number": "१२-३०१-२९", "content_sanskrit": "अप्रियाण्यवमानाश्च दुःखं बहुविधात्मकम्।\nफलार्थी सत्पथं त्यक्त्वा प्राप्नोति विषयात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084372, "chapter_id": 2796, "verse_number": "१२-३०१-३०", "content_sanskrit": "धर्मे तपसि दाने च विचिकित्साऽस्य जायते।\nस कृत्वा पापकान्येव निरयं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084373, "chapter_id": 2796, "verse_number": "१२-३०१-३१", "content_sanskrit": "सुखे तु वर्तमानो वै दुःखे वाऽपि नरोत्तम्।\nसुवृत्ताद्यो न चलते शास्त्रचक्षुः स मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084374, "chapter_id": 2796, "verse_number": "१२-३०१-३२", "content_sanskrit": "इषुप्रपातमात्रं हि स्पर्शयोगे रतिः स्मृता।\nरसने दर्शने घ्राणे श्रवणे च विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084375, "chapter_id": 2796, "verse_number": "१२-३०१-३३", "content_sanskrit": "ततोऽस्य जायते तीव्रा वेदना तत्क्षयात्पुनः।\nबुधा ये न प्रशंसन्ति मोक्षं सुखमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084376, "chapter_id": 2796, "verse_number": "१२-३०१-३४", "content_sanskrit": "ततः फलार्थं सर्वस्य भवन्ति ज्यायसे गुणाः।\nधर्मवृद्ध्या च सततं कामार्थाभ्यां न हीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084377, "chapter_id": 2796, "verse_number": "१२-३०१-३५", "content_sanskrit": "अप्रयत्नागताः सेव्या गृहस्थैर्विषयाः सदा।\nप्रयत्नेनोपगम्यश्च स्वधर्म इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084378, "chapter_id": 2796, "verse_number": "१२-३०१-३६", "content_sanskrit": "मानिनां कुलजातानां नित्यं शास्त्रार्थचक्षुषाम्।\nक्रियाधर्मविमुक्तानामशक्त्या संवृतात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084379, "chapter_id": 2796, "verse_number": "१२-३०१-३७", "content_sanskrit": "क्रियमाणं यदा कर्म नाशं गच्छति मानुषम्।\nतेषां नान्यदृते लोके तपसः कर्म विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084380, "chapter_id": 2796, "verse_number": "१२-३०१-३८", "content_sanskrit": "सर्वात्मनाऽनुकुर्वीत गृहस्थः कर्मनिश्चयम्।\nदाक्ष्येण हव्यकव्यार्थं स्वधर्मे विचरन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084381, "chapter_id": 2796, "verse_number": "१२-३०१-३९", "content_sanskrit": "यथा नदीनदाः सर्वे सागरे यान्ति संस्थितिम्।\nएवमाश्रमिणः सर्वे गृहस्थे यान्ति संस्थितिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084382, "chapter_id": 2796, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकाधिकत्रिशततमोऽध्यायः॥ ३०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]