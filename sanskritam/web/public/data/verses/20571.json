[{"id": 7000571000, "chapter_id": 20571, "verse_number": "५-३०-१", "content_sanskrit": "शेष उवाच ।\nअथ तेजःपुरं प्राप्तस्तुरगः पत्रशोभितः ।\nयस्यां पालयते राजा प्रजाः सत्येन सत्यवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000571001, "chapter_id": 20571, "verse_number": "५-३०-२", "content_sanskrit": "अथ कोटिपरीवारो रघुनाथानुजस्ततः ।\nहयानुगो ययौ तस्य पुरतः पुरधर्षणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000571002, "chapter_id": 20571, "verse_number": "५-३०-३", "content_sanskrit": "तद्दृष्ट्वा नगरं रम्यं चित्रप्राकारशोभितम् ।\nकांचनैः कलशैस्तत्र परितः प्रतिभासितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000571003, "chapter_id": 20571, "verse_number": "५-३०-४", "content_sanskrit": "देवायतनसाहस्रैः सर्वतश्च विराजितम् ।\nयतीनां तु मठास्तत्र शोभंते यतिपूरिताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000571004, "chapter_id": 20571, "verse_number": "५-३०-५", "content_sanskrit": "वहत्यत्र महादेवी शिखिलोचनमूर्धगा ।\nहंसकारंडवाकीर्णामुनिवृंदनिषेविता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000571005, "chapter_id": 20571, "verse_number": "५-३०-६", "content_sanskrit": "ब्राह्मणानां प्रत्यगारमग्निहोत्रभवः पुनः ।\nधूमस्तत्र पुनात्यंग पातकाप्लुतमानसान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000571006, "chapter_id": 20571, "verse_number": "५-३०-७", "content_sanskrit": "उवाच सुमतिं राजा शत्रुघ्नः शत्रुतापनः ।\nतत्पुरप्रेक्षणोद्भूतहर्षविस्मितमानसः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000571007, "chapter_id": 20571, "verse_number": "५-३०-८", "content_sanskrit": "शत्रुघ्न उवाच ।\nमंत्रिन्कथय कस्येदं पुरं मे दृष्टिगोचरम् ।\nकरोति मानसाह्लादं धर्मेण प्रतिपालितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000571008, "chapter_id": 20571, "verse_number": "५-३०-९", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य शत्रुघ्नस्य महीपतेः ।\nउवाच सुमतिः सर्वं यथातथमनुद्धतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000571009, "chapter_id": 20571, "verse_number": "५-३०-१०", "content_sanskrit": "सुमतिरुवाच ।\nशृणुष्वावहितः स्वामिन्वैष्णवस्य कथाः शुभाः ।\nयाः श्रुत्वा मुच्यते पापाद्ब्रह्महत्यासमादपि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000571010, "chapter_id": 20571, "verse_number": "५-३०-११", "content_sanskrit": "जीवन्मुक्तो वरीवर्ति रामांघ्र्यंबुजषट्पदः ।\nसत्यवान्यज्ञयज्ञांग ज्ञाता कर्ताऽविता महान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000571011, "chapter_id": 20571, "verse_number": "५-३०-१२", "content_sanskrit": "धेनुं प्रसाद्य बहुभिर्व्रतैर्यं प्राप तत्पिता ।\nऋतंभराख्यो जगति ख्यातः परमधार्मिकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000571012, "chapter_id": 20571, "verse_number": "५-३०-१३", "content_sanskrit": "गौः प्रसन्ना ददौ पुत्रमनेकगुणसंस्कृतम् ।\nसत्यवंतं सुशोभाढ्यं तं जानीहि नृपोत्तमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000571013, "chapter_id": 20571, "verse_number": "५-३०-१४", "content_sanskrit": "शत्रुघ्न उवाच ।\nको वा ऋतंभरो राजा किमर्थं धेनुपूजनम् ।\nकथं प्राप्तः सुतस्तस्य वैष्णवो विष्णुसेवकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000571014, "chapter_id": 20571, "verse_number": "५-३०-१५", "content_sanskrit": "सर्वमेतत्समाचक्ष्व वैष्णवस्य कथानकम् ।\nश्रुतं हरति जंतूनां महापातकपर्वतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000571015, "chapter_id": 20571, "verse_number": "५-३०-१६", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य शत्रुघ्नस्य महार्थकम् ।\nकथयामास विशदं तदुत्पत्तिकथानकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000571016, "chapter_id": 20571, "verse_number": "५-३०-१७", "content_sanskrit": "ऋतंभरो नरपतिरनपत्यः पुराऽभवत् ।\nकलत्राणि बहून्यस्य न पुत्रं प्राप तेषु वै ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000571017, "chapter_id": 20571, "verse_number": "५-३०-१८", "content_sanskrit": "तदा जाबालिनामानं मुनिं दैवादुपागतम् ।\nप्रपच्छ कुशलोद्युक्तः सपुत्रोत्पत्तिकारणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000571018, "chapter_id": 20571, "verse_number": "५-३०-१९", "content_sanskrit": "ऋतंभर उवाच ।\nस्वामिन्वंध्यस्य मे ब्रूहि पुत्रोत्पत्तिकरं वचः ।\nयत्कृत्वा जायतेऽपत्यं मम वंशधरं वरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000571019, "chapter_id": 20571, "verse_number": "५-३०-२०", "content_sanskrit": "तज्ज्ञात्वा भवतो भव्यं प्रकुर्यां निश्चितं वचः ।\nदानं व्रतं वा तीर्थं वा मखं वा मुनिसत्तम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000571020, "chapter_id": 20571, "verse_number": "५-३०-२१", "content_sanskrit": "इति राज्ञोवचः श्रुत्वा जगाद मुनिसत्तमः ।\nसुतोत्पत्तिकरं वाक्यं प्रणतस्य सुतार्थिनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000571021, "chapter_id": 20571, "verse_number": "५-३०-२२", "content_sanskrit": "अपत्यप्राप्तिकामस्य संत्युपायास्त्रयः प्रभो ।\nविष्णोः प्रसादो गोश्चापि शिवस्याप्यथवा पुनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000571022, "chapter_id": 20571, "verse_number": "५-३०-२३", "content_sanskrit": "तस्मात्त्वं कुरु वै पूजां धेनोर्देवतनोर्नृप ।\nयस्याः पुच्छे मुखे शृंगे पृष्ठे देवाः प्रतिष्ठिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000571023, "chapter_id": 20571, "verse_number": "५-३०-२४", "content_sanskrit": "सा तुष्टा दास्यति क्षिप्रं वांछितं धर्मसंयुतम् ।\nएवं विदित्वा गोपूजां विधेहि त्वमृतंभर ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000571024, "chapter_id": 20571, "verse_number": "५-३०-२५", "content_sanskrit": "यो वै नित्यं पूजयति गां गेहे यवसादिभिः ।\nतस्य देवाश्च पितरो नित्यं तृप्ता भवंति हि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000571025, "chapter_id": 20571, "verse_number": "५-३०-२६", "content_sanskrit": "यो वै गवाह्निकं दद्यान्नियमेन शुभव्रतः ।\nतेन सत्येन तस्य स्युः सर्वे पूर्णा मनोरथाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000571026, "chapter_id": 20571, "verse_number": "५-३०-२७", "content_sanskrit": "तृषिता गौर्गृहे बद्धा गेहे कन्या रजस्वला ।\nदेवता च सनिर्माल्या हंति पुण्यं पुराकृतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000571027, "chapter_id": 20571, "verse_number": "५-३०-२८", "content_sanskrit": "यो वै गां प्रतिषिद्ध्येत चरंतीं स्वं तृणं नरः ।\nतस्य पूर्वे च पितरः कंपंते पतनोन्मुखाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000571028, "chapter_id": 20571, "verse_number": "५-३०-२९", "content_sanskrit": "यो वै यष्ट्या ताडयति धेनुं मर्त्यो विमूढधीः ।\nधर्मराजस्य नगरं स याति करवर्जितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000571029, "chapter_id": 20571, "verse_number": "५-३०-३०", "content_sanskrit": "यो वै दंशान्वारयति तस्य पूर्वे ह्यधोगताः ।\nनृत्यंति मत्सुतो ह्यस्मांस्तारयिष्यति भाग्यवान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000571030, "chapter_id": 20571, "verse_number": "५-३०-३१", "content_sanskrit": "अत्रैवोदाहरंतीममितिहासं पुरातनम् ।\nजनकस्य पुरावृत्तं धर्मराजपुरेऽद्भुतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000571031, "chapter_id": 20571, "verse_number": "५-३०-३२", "content_sanskrit": "एकदा जनको राजा योगेनासून्समत्यजत् ।\nतदा विमानं संप्राप्तं किंकिणीजालभूषितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000571032, "chapter_id": 20571, "verse_number": "५-३०-३३", "content_sanskrit": "तदारुह्य गतो राजा सेवकैरूढदेहवान् ।\nमार्गे जगाम धर्मस्य संयमिन्याः पुरोंऽतिके ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000571033, "chapter_id": 20571, "verse_number": "५-३०-३४", "content_sanskrit": "तदा नरककोटीषु पीड्यंते पापकारिणः ।\nजनकस्यांगपवनं प्राप्य सौख्यं प्रपेदिरे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000571034, "chapter_id": 20571, "verse_number": "५-३०-३५", "content_sanskrit": "निरये दाहजापीडा जातैषां सुखकारिणी ।\nमहादुःखं तदा नष्टं जनकस्यांगवायुना ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000571035, "chapter_id": 20571, "verse_number": "५-३०-३६", "content_sanskrit": "तदा तं निर्गतं दृष्ट्वा जंतवः पापपीडिताः ।\nअत्यंतं चुक्रुशुर्भीतास्तद्वियोगमनिच्छवः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000571036, "chapter_id": 20571, "verse_number": "५-३०-३७", "content_sanskrit": "ऊचुस्ते करुणां वाचं मा गच्छ सुकृतिन्नितः ।\nत्वदंगवायुसंस्पर्शात्सुखिनः स्यामपीडिताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000571037, "chapter_id": 20571, "verse_number": "५-३०-३८", "content_sanskrit": "इति वाक्यं समाकर्ण्य राजा परमधार्मिकः ।\nमानसे चिंतयामास करुणापूरपूरितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000571038, "chapter_id": 20571, "verse_number": "५-३०-३९", "content_sanskrit": "चेन्मत्तः प्राणिनां सौख्यं भवेदिह तदा पुनः ।\nअत्रैव च पुरे स्थास्ये स्वर्ग एष मनोरमः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000571039, "chapter_id": 20571, "verse_number": "५-३०-४०", "content_sanskrit": "एवं कृत्वा नृपस्तस्थौ तत्रैव निरयाग्रतः ।\nविदधत्प्राणिनां सौख्यमनुकंपितमानसः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000571040, "chapter_id": 20571, "verse_number": "५-३०-४१", "content_sanskrit": "तत्र धर्मस्तु संप्राप्तो निरयद्वारि दुःखदे ।\nकारयन्यातनास्तीव्रा नानापातककारिणाम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000571041, "chapter_id": 20571, "verse_number": "५-३०-४२", "content_sanskrit": "तदा ददर्श राजानं जनकं द्वारिसंस्थितम् ।\nविमानेन महापुण्यकारिणं दययायुतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000571042, "chapter_id": 20571, "verse_number": "५-३०-४३", "content_sanskrit": "तमुवाच प्रेतपतिर्जनकं सहसन्गिरा ।\nराजन्कुतस्त्वं संप्राप्तः सर्वधर्मशिरोमणिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000571043, "chapter_id": 20571, "verse_number": "५-३०-४४", "content_sanskrit": "एतत्स्थानं पातकिनां दुष्टानां प्राणघातिनाम् ।\nनायांति पुरुषा भूप त्वादृशाः पुण्यकारिणः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000571044, "chapter_id": 20571, "verse_number": "५-३०-४५", "content_sanskrit": "अत्रायांति नरास्ते वै ये परद्रोहतत्पराः ।\nपरापवादनिरताः परद्रव्यपरायणाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000571045, "chapter_id": 20571, "verse_number": "५-३०-४६", "content_sanskrit": "यो वै कलत्रं धर्मिष्ठं निजसेवापरायणम् ।\nअपराधादृते जह्यात्सनरोऽत्र समाव्रजेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000571046, "chapter_id": 20571, "verse_number": "५-३०-४७", "content_sanskrit": "मित्रं वञ्चयते यस्तु धनलोभेन लोभितः ।\nआगत्यात्र नरः पीडां मत्तः प्राप्नोति दारुणाम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000571047, "chapter_id": 20571, "verse_number": "५-३०-४८", "content_sanskrit": "यो रामं मनसा वाचा कर्मणा दंभतोऽपि वा ।\nद्वेषाद्वाचोपहासाद्वा न स्मरत्येव मूढधीः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000571048, "chapter_id": 20571, "verse_number": "५-३०-४९", "content_sanskrit": "तं बध्नामि पुनस्त्वेषु निक्षिप्य श्रपयामि च ।\nयैः स्मृतो न रमानाथो नरकक्लेशवारकः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000571049, "chapter_id": 20571, "verse_number": "५-३०-५०", "content_sanskrit": "तावत्पापं मनुष्याणामंगेषु नृप तिष्ठति ।\nयावद्रामं न रसना गृणाति कलि दुर्मतेः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000571050, "chapter_id": 20571, "verse_number": "५-३०-५१", "content_sanskrit": "महापापकरा राजन्ये भवंति महामते ।\nतानानयंति मद्भृत्यास्त्वादृशान्द्रष्टुमक्षमाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000571051, "chapter_id": 20571, "verse_number": "५-३०-५२", "content_sanskrit": "तस्माद्गच्छ महाराज भुंक्ष्व भोगाननेकशः ।\nविमानवरमारुह्य भुंक्ष्व पुण्यमुपार्जितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000571052, "chapter_id": 20571, "verse_number": "५-३०-५३", "content_sanskrit": "इति वाक्यं समाकर्ण्यध र्मराजस्य तत्पतेः ।\nउवाच धर्मराजानं करुणापूरपूरितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000571053, "chapter_id": 20571, "verse_number": "५-३०-५४", "content_sanskrit": "जनक उवाच ।\nअहं गच्छामि नो नाथ जीवानामनुकम्पया ।\nमदंगवायुना ह्येते सुखं प्राप्ताः स्म संस्थिताः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000571054, "chapter_id": 20571, "verse_number": "५-३०-५५", "content_sanskrit": "एतान्मुंचसि चेद्राजन्सर्वान्वै निरयस्थितान् ।\nततो गच्छामि सुखितः स्वर्गं पुण्यजनाश्रितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000571055, "chapter_id": 20571, "verse_number": "५-३०-५६", "content_sanskrit": "जाबालिरुवाच ।\nइति वाक्यमथाश्रुत्य जनकं प्रत्युवाच सः ।\nप्रत्येकं निर्दिशञ्जीवान्निरयस्थाननेकशः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000571056, "chapter_id": 20571, "verse_number": "५-३०-५७", "content_sanskrit": "धर्म उवाच ।\nअयं मित्र कलत्रं वै विश्वस्तमनुजग्मिवान् ।\nतस्मादेनं लोहशंकौ वर्षायुतमपीपचम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000571057, "chapter_id": 20571, "verse_number": "५-३०-५८", "content_sanskrit": "पश्चादेनं सूकराणां योनौ निक्षिप्य दोषिणम् ।\nमानुषेष्ववतार्योऽयं षंढचिह्नेन चिह्नितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000571058, "chapter_id": 20571, "verse_number": "५-३०-५९", "content_sanskrit": "अनेन परदाराश्च बलादालिगिता मुहुः ।\nतस्मादयं पच्यतेऽत्र रौरवे शतहायनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000571059, "chapter_id": 20571, "verse_number": "५-३०-६०", "content_sanskrit": "अयं तु परकीयं स्वं मुषित्वा बुभुजे कुधीः ।\nतस्मादस्य करौ छित्त्वा पचेयं पूयशोणिते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000571060, "chapter_id": 20571, "verse_number": "५-३०-६१", "content_sanskrit": "अयं सायंतने प्राप्तमतिथिं क्षुधयार्दितम् ।\nवाण्यापि नाकरोत्तस्य पूजनं स्वागतं न च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000571061, "chapter_id": 20571, "verse_number": "५-३०-६२", "content_sanskrit": "तस्मादयं पातनीयस्तामिस्रेंधनपूरिते ।\nभ्रमरैः पीडितो यातु यातनां शतहायनम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000571062, "chapter_id": 20571, "verse_number": "५-३०-६३", "content_sanskrit": "अयं तावत्परस्योच्चैर्निंदां कुर्वन्नलज्जितः ।\nअयमप्यशृणोत्कर्णौ प्रेरयन्बहुशस्तु ताम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000571063, "chapter_id": 20571, "verse_number": "५-३०-६४", "content_sanskrit": "तस्मादिमावंधकूपे पतितौ दुःखदुःखितौ ।\nअयं मित्रध्रुगुद्विग्नः पच्यते रौरवे भृशम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000571064, "chapter_id": 20571, "verse_number": "५-३०-६५", "content_sanskrit": "तस्मादेतान्पापभोगान्कारयित्वा विमोचये ।\nत्वं गच्छ नरशार्दूल पुण्यराशिविधायकः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000571065, "chapter_id": 20571, "verse_number": "५-३०-६६", "content_sanskrit": "जाबालिरुवाच ।\nएवं स निर्दिशञ्जीवांस्तूष्णीमासाघकारिणः ।\nप्रोवाच रामभक्तोऽसौ करुणापूरितेक्षणः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000571066, "chapter_id": 20571, "verse_number": "५-३०-६७", "content_sanskrit": "जनक उवाच ।\nकथं निरयनिर्मुक्तिर्जीवानां दुःखिनां भवेत् ।\nतदाशु कथय त्वं वै यत्कृत्वा सुखमाप्नुयुः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000571067, "chapter_id": 20571, "verse_number": "५-३०-६८", "content_sanskrit": "धर्म उवाच ।\nनैभिराराधितो विष्णुर्नैभिस्तस्य कथाः श्रुताः ।\nकथं निरयनिर्मुक्तिर्भवेद्वै पापकारिणाम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000571068, "chapter_id": 20571, "verse_number": "५-३०-६९", "content_sanskrit": "यदि त्वं मोचयस्येतान्महापापकरानपि ।\nतर्ह्यर्पय महाराज पुण्यं तत्कथयामि यत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000571069, "chapter_id": 20571, "verse_number": "५-३०-७०", "content_sanskrit": "एकदा प्रातरुत्थाय शुद्धभावेन चेतसा ।\nध्यातः श्रीरघुनाथोऽसौ महापापहराभिधः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000571070, "chapter_id": 20571, "verse_number": "५-३०-७१", "content_sanskrit": "रामरामेति यच्चोक्तं त्वया शुद्धेन चेतसा ।\nतत्पुण्यमर्पयैतेभ्यो येन स्यान्निरयाच्च्युतिः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000571071, "chapter_id": 20571, "verse_number": "५-३०-७२", "content_sanskrit": "जाबालिरुवाच ।\nएतच्छ्रुत्वा वचस्तस्य धर्मराजस्य धीमतः ।\nपुण्यं ददौ महाराज आजन्मसमुपार्जितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000571072, "chapter_id": 20571, "verse_number": "५-३०-७३", "content_sanskrit": "यदा जन्मकृतैः पुण्यै रघुनाथार्चनोद्भवैः ।\nएतेषां निरयान्मुक्तिर्भवत्वत्र मनोरमा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000571073, "chapter_id": 20571, "verse_number": "५-३०-७४", "content_sanskrit": "एवं कथयतस्तस्य जीवा निरयसंस्थिताः ।\nतत्क्षणान्निरयान्मुक्ता जाता दिव्यवपुर्धराः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000571074, "chapter_id": 20571, "verse_number": "५-३०-७५", "content_sanskrit": "ऊचुस्ते जनकं राजंस्त्वत्प्रसादाद्वयं क्षणात् ।\nदुःखदान्निरयान्मुक्ता यास्यामः परमं पदम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000571075, "chapter_id": 20571, "verse_number": "५-३०-७६", "content_sanskrit": "तान्दृष्ट्वा सूर्यसंकाशान्नरान्निरयनिःसृतान् ।\nतुतोष चित्ते सुभृशं सर्वभूतदयापरः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000571076, "chapter_id": 20571, "verse_number": "५-३०-७७", "content_sanskrit": "ते सर्वे प्रययुर्लोकं दिवं देवैरलंकृतम् ।\nजनकं तु प्रशंसंतो महाराजं दयानिधिम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]