[{"id": 2082476, "chapter_id": 2757, "verse_number": "१२-२६२-०x", "content_sanskrit": "युधिष्ठिरं उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082477, "chapter_id": 2757, "verse_number": "१२-२६२-१", "content_sanskrit": "य इमे पृथिवीपालाः शेरते पृथिवीतले।\nपृतनामध्य एते हि गतसत्त्वा महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082478, "chapter_id": 2757, "verse_number": "१२-२६२-२", "content_sanskrit": "एकैकशो भीमबला नागायुतबलास्तथा।\nएते हि निहताः सङ्ख्ये तुल्यतेजीबलैर्नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082479, "chapter_id": 2757, "verse_number": "१२-२६२-३", "content_sanskrit": "नैषां पश्यामि हन्तारं प्राणिनां संयुगे पुरा।\nविक्रमेणोपसंपन्नास्तेजोबलसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082480, "chapter_id": 2757, "verse_number": "१२-२६२-४", "content_sanskrit": "अथ चेमे महाप्राज्ञाः शेरते हि गतासवः।\nमृता इति च शब्दोऽयं वर्तत्येषु गतासुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082481, "chapter_id": 2757, "verse_number": "१२-२६२-५", "content_sanskrit": "इमे मृता नृपतयः प्रायशो भीमविक्रमाः।\nतत्र मे संशयो जातः कुतः संज्ञा मृता इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082482, "chapter_id": 2757, "verse_number": "१२-२६२-६", "content_sanskrit": "कस्य मृत्युः कुतो मृत्युः केन मृत्युरिह प्रजाः।\nहरत्यमरसंकाश तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082483, "chapter_id": 2757, "verse_number": "१२-२६२-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082484, "chapter_id": 2757, "verse_number": "१२-२६२-७", "content_sanskrit": "पुरा कृतयुगे तात राजा ह्यासीदकम्पनः।\nस शत्रुवशमापन्नः संग्रामे क्षीणवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082485, "chapter_id": 2757, "verse_number": "१२-२६२-८", "content_sanskrit": "तस्य पुत्रो हरिर्नाम नारायणसमो बले।\nस शत्रुभिर्हतः सङ्ख्ये सबलः सपदानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082486, "chapter_id": 2757, "verse_number": "१२-२६२-९", "content_sanskrit": "स राजा शत्रुवशगः पुत्रशोकसमन्वितः।\nयदृच्छया शान्तिपरो ददर्श भुवि नारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082487, "chapter_id": 2757, "verse_number": "१२-२६२-१०", "content_sanskrit": "तस्मै स सर्वमाचष्ट यथावृत्तं जनेश्वरः।\nशत्रुभिर्ग्रहणं सङ्ख्ये पुत्रस्य मरणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082488, "chapter_id": 2757, "verse_number": "१२-२६२-११", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा नारदोऽथ तपोधनः।\nआख्यानमिदमाचष्ट पुत्रशोकापहं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082489, "chapter_id": 2757, "verse_number": "१२-२६२-१२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082490, "chapter_id": 2757, "verse_number": "१२-२६२-१२", "content_sanskrit": "राजञ्शृणु महाख्यानं ममेदं बहुविस्तरम्।\nयथावृत्तं श्रुतं चैव मयाऽपि वसुधाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082491, "chapter_id": 2757, "verse_number": "१२-२६२-१३", "content_sanskrit": "प्रजाः सृष्ट्वा महातेजाः प्रजासर्गे पितामहः।\nअतीव वृद्धा बहुला नामृष्यत पुनः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082492, "chapter_id": 2757, "verse_number": "१२-२६२-१४", "content_sanskrit": "न ह्यन्तरमभूत्किंचित्क्वचिज्जन्तुभिरच्युत।\nनिरुच्छ्वासमिवोन्नद्धं त्रैलोक्यमभवन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082493, "chapter_id": 2757, "verse_number": "१२-२६२-१५", "content_sanskrit": "तस्य चिन्ता समुत्पन्ना संहारं प्रति भूपते।\nचिन्तयन्नाध्यगच्छच्च संहारे हेतुकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082494, "chapter_id": 2757, "verse_number": "१२-२६२-१६", "content_sanskrit": "तस्य रोपान्महाराज खेभ्योऽग्निरुदतिष्ठत।\nतेन सर्वा दिशो राजन्ददाह स पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082495, "chapter_id": 2757, "verse_number": "१२-२६२-१७", "content_sanskrit": "ततो दिवं भुवं खं च जगच्च सचराचरम्।\nददाह पावको राजन्भगवत्कोपसंभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082496, "chapter_id": 2757, "verse_number": "१२-२६२-१८", "content_sanskrit": "तत्रादह्यन्त भूतानि जङ्गमानि ध्रुवाणि च।\nमहता क्रोधवेगेन कुपिते प्रपितामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082497, "chapter_id": 2757, "verse_number": "१२-२६२-१९", "content_sanskrit": "ततो हरो जटी स्थाणुर्देवोऽध्वरपतिः शिवः।\nजगाम शरणं देवो ब्रह्माणं परमेष्ठिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082498, "chapter_id": 2757, "verse_number": "१२-२६२-२०", "content_sanskrit": "तस्मिन्नभिगते स्थाणौ प्रजानां हितकाम्यया।\nअब्रवीद्वरदो देवो ज्वलन्निव तदा शिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082499, "chapter_id": 2757, "verse_number": "१२-२६२-२१", "content_sanskrit": "करवाण्यद्य कं कामं व्नरार्होऽसि मतो मम।\nकर्ता ह्यसि प्रियं शंभो तव यद्धृदि वर्तते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082500, "chapter_id": 2757, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्विषष्ट्यधिकद्विशततमोऽध्यायः॥ २६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]