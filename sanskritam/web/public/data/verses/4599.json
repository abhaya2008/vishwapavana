[{"id": 2167614, "chapter_id": 4599, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167615, "chapter_id": 4599, "verse_number": "१", "content_sanskrit": "प्रत्येत्याथ पुनर्जिष्णुर्हत्वा संशप्तकान् बभौ ।\nवक्रानुवक्रगमनाद् अङ्गारक इव ग्रहः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167616, "chapter_id": 4599, "verse_number": "२", "content_sanskrit": "पार्थबाणैर्हतास्तेऽथ नराश्वरथकुञ्जराः ।\nविचेलुर्बभ्रमुर्नेदुः पेतुर्मम्रुश्च भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167617, "chapter_id": 4599, "verse_number": "३", "content_sanskrit": "धुर्यान् धुर्येतरान् सूतान् ध्वजांश्चापासिसायकान् ।\nपाणीन् पाणिगतं शस्त्रं बाहूनपि शिरांसि च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167618, "chapter_id": 4599, "verse_number": "४", "content_sanskrit": "भल्लैः क्षुरैरर्धचन्द्रैर्वत्सदन्तैश्च पाण्डवः ।\nचिच्छेदामित्रवीराणां समरे प्रतियुध्यताम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167619, "chapter_id": 4599, "verse_number": "५", "content_sanskrit": "(तं प्रवीरास्त्वदीयानां नर्दमाना हि दुद्रुवुः ।)\nवाशितार्थं युध्यमाना वृषभा वृषभं यथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167620, "chapter_id": 4599, "verse_number": "६", "content_sanskrit": "अपतन्नर्जुनं शूराः शतशोऽथ सहस्रशः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167621, "chapter_id": 4599, "verse_number": "७", "content_sanskrit": "तेषां तस्यापि तद्युद्धमभवद् रोमहर्षणम् ।\nत्रैलोक्यविजये यादृग् दैत्यानां सह वज्रिणा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167622, "chapter_id": 4599, "verse_number": "८", "content_sanskrit": "अथाविध्यत् त्रिभिर्बाणैर्दन्दशूकैरिवाहिभिः ।\nउग्रायुधोऽस्य तज्जिष्णुः शिरः कायादपाहरत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167623, "chapter_id": 4599, "verse_number": "९", "content_sanskrit": "तेऽर्जुनं सर्वतः क्रुद्धा नानाशस्त्रैरवीवृषन् ।\nमरुद्भिः प्रेरिता मेघा हिमवन्तमिवोष्णगे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167624, "chapter_id": 4599, "verse_number": "१०", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य द्विषतां सर्वतोऽर्जुनः ।\nसम्यगस्तैः शरैः सर्वान् अहितानहनद् बहून्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167625, "chapter_id": 4599, "verse_number": "११", "content_sanskrit": "छिन्नत्रिवेणुसङ्घातान् हताश्वपार्ष्णिसारथीन् ।\nविध्वस्तायुधतूणीरान् विचक्ररथकेतनान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167626, "chapter_id": 4599, "verse_number": "१२", "content_sanskrit": "सञ्छिन्नरश्मियोक्त्राक्षान् व्यनुकर्षयुगान् रथान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167627, "chapter_id": 4599, "verse_number": "१३", "content_sanskrit": "विध्वस्तसर्वसन्नाहान् बाणैश्चक्रेऽर्जुनस्त्वरन्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167628, "chapter_id": 4599, "verse_number": "१४", "content_sanskrit": "ते रथास्तत्र विध्वस्ताः परार्द्ध्या भान्त्यनेकशः ।\nधनिनामिव वेश्मानि हतान्यग्न्यनिलाम्बुभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167629, "chapter_id": 4599, "verse_number": "१५", "content_sanskrit": "द्विपाः सम्भिन्नमर्माणो वज्राशनिनिभैः शरैः ।\nपेतुर्गिर्यग्रवेश्मानि वज्रवाताग्निभिर्यथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167630, "chapter_id": 4599, "verse_number": "१६", "content_sanskrit": "सारोहास्तुरगाः पेतुर्बहवोऽर्जुनपीडिताः ।\nनिर्जिह्वान्ताः क्षितौ क्षीणा रुधिरार्द्राः सुदुर्दृशः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167631, "chapter_id": 4599, "verse_number": "१७", "content_sanskrit": "नराश्वनागा नाराचैः संस्यूताः सव्यसाचिना ।\nबभ्रमुश्चस्खलुर्नेदुः पेतुर्मम्रुश्च मारिष\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167632, "chapter_id": 4599, "verse_number": "१८", "content_sanskrit": "अनेकैश्च शिलाघातैर्वज्रानलविषोपमैः ।\nशरैर्निजघ्निवान् पार्थो महेन्द्र इव दानवान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167633, "chapter_id": 4599, "verse_number": "१९", "content_sanskrit": "महार्हवर्माभरणा नानावर्णाम्बरायुधाः ।\nसरथाश्वद्विपा वीरा हताः पार्थेन शेरते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167634, "chapter_id": 4599, "verse_number": "२०", "content_sanskrit": "निर्भयाः पुण्यकर्माणो विशिष्टाभिजनश्रुताः ।\nगताः शरीरैर्वसुधामूर्जितैः कर्मभिर्दिवम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167635, "chapter_id": 4599, "verse_number": "२१", "content_sanskrit": "अथार्जुनरथं वीरास्त्वदीयाः समभिद्रवन् ।\nनानाजनपदाध्यक्षाः सगणा जातमन्यवः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167636, "chapter_id": 4599, "verse_number": "२२", "content_sanskrit": "ऊह्यमाना रथाश्वेभैः पत्तयश्च जिघांसवः ।\nसमभ्यधावन्नस्यन्तो विविधं क्षिप्रमायुधम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167637, "chapter_id": 4599, "verse_number": "२३", "content_sanskrit": "तदायुधमहावर्षं क्षिप्तं योधमहाम्बुदैः ।\nव्यधमन्निशितैर्बाणैः क्षिप्रमर्जुनमारुतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167638, "chapter_id": 4599, "verse_number": "२४", "content_sanskrit": "साश्वपत्तिद्विपरथं महाशस्त्रौघविप्लवम् ।\nसहसा सन्तितीर्षन्तं पार्थं शस्त्रास्त्रसेतुना\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167639, "chapter_id": 4599, "verse_number": "२५", "content_sanskrit": "अथाब्रवीद् वासुदेवः पार्थ किं क्रीडसेऽनघ ।\nसंशप्तकान् प्रमथ्यैनान् अथ कर्णवधे त्वर\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167640, "chapter_id": 4599, "verse_number": "२६", "content_sanskrit": "तथेत्युक्त्वाऽर्जुनः क्रोधात् शिष्टान् संशप्तकानथ ।\nक्षपयिष्यन् तदाऽस्त्रेण दैत्यानिन्द्र इवावधीत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167641, "chapter_id": 4599, "verse_number": "२७", "content_sanskrit": "नाददत् सन्दधच्चैव दृष्टः कैश्चिद् रणेऽर्जुनः ।\nविमुञ्चन् वा शरान् घोरान् दृश्यन्ते वै नरा हताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167642, "chapter_id": 4599, "verse_number": "२८", "content_sanskrit": "आश्चर्यमिति गोविन्दो ब्रुवन्नश्वानचोदयत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167643, "chapter_id": 4599, "verse_number": "२९", "content_sanskrit": "ततस्ते हंससदृशाः तुरगा वातरंहसः ।\nतां सेनां विविशुः हृष्टाः हंसा इव महासरः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167644, "chapter_id": 4599, "verse_number": "३०", "content_sanskrit": "ततः सङ्ग्रामभूमिं तां वर्तमाने जनक्षये ।\nअवेक्षमाणो गोविन्दः सव्यसाचिनमब्रवीत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167645, "chapter_id": 4599, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167646, "chapter_id": 4599, "verse_number": "३१", "content_sanskrit": "एष पार्थ महारौद्रो वर्तते भरतक्षयः ।\nपृथिव्यां पार्थिवानां च दुर्योधनकृते महान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167647, "chapter_id": 4599, "verse_number": "३२", "content_sanskrit": "पश्य भारत चापानि रुग्मपृष्ठानि धन्विनाम् ।\nहतानामपविद्धानि कलापानिषुधींस्तथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167648, "chapter_id": 4599, "verse_number": "३३", "content_sanskrit": "जातरूपमयैः पुङ्खैः शरांश्च नतपर्वणः ।\nतैलधौतांश्च नाराचान् निर्मुक्तानिव पन्नगान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167649, "chapter_id": 4599, "verse_number": "३४", "content_sanskrit": "आकीर्णांस्तोमरांश्चापि चित्रान् हेमविभूषितान् ।\n(दण्डान् कनकचित्रांश्च रणभूमिं च संवृताम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167650, "chapter_id": 4599, "verse_number": "३५", "content_sanskrit": "हस्तिदन्तत्सरून् खड्गान् जातरूपपरिष्कृतान् ।)\nवर्माणि चापविद्धानि तोमरांश्च बहून् रणे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167651, "chapter_id": 4599, "verse_number": "३६", "content_sanskrit": "सुवर्णविकृतान् प्रासान् शक्तीः कनकभूषिताः ।\nजाम्बूनदमयैः पट्टैर्बद्धाश्च विविधा गदाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167652, "chapter_id": 4599, "verse_number": "३७", "content_sanskrit": "जातरूपमयांश्चोग्रान् पट्टसान् हेमभूषितान् ।\nदण्डैः कनकचित्रैश्च विप्रविद्धान् परश्वधान्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167653, "chapter_id": 4599, "verse_number": "३८", "content_sanskrit": "परिघान् भिण्डिपालांश्च मुसुण्ठीः क्रकचानपि ।\nअयस्कन्धांश्च पतितान् मुसलानि गुरूणि च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167654, "chapter_id": 4599, "verse_number": "", "content_sanskrit": "(शतघ्नीः पश्य चित्राश्च विपुलान् परिघांस्तथा ।\nचक्राणि चापविद्धानि खड्गांश्चापि महारथान्\t॥३९॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167655, "chapter_id": 4599, "verse_number": "४०", "content_sanskrit": "नानाविधानि शस्त्राणि प्रगृह्य जयगृद्धिनः ।\nजीवन्त इव दृश्यन्ते गतसत्त्वास्तरस्विनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2167656, "chapter_id": 4599, "verse_number": "४१", "content_sanskrit": "गदाविमथितैर्गात्रैर्मुसलैर्भिन्नमस्तकान् ।\nगजवाजिरथक्षुण्णान् पश्य योधान् सहस्रशः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2167657, "chapter_id": 4599, "verse_number": "४२", "content_sanskrit": "गजवाजिमनुष्याणां शरशक्त्यृष्टितोमरैः ।\nनिस्त्रिंशैः पट्टसैः प्रासैर्नखरैर्लगुडैरपि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2167658, "chapter_id": 4599, "verse_number": "४३", "content_sanskrit": "शरीरैर्बहुधा च्छिन्नैर्शोणितौघपरिप्लुतैः ।\nगतासुभिरमित्रघ्न संवृता रणभूमयः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2167659, "chapter_id": 4599, "verse_number": "४४", "content_sanskrit": "बहुभिश्चन्दनादिग्धैः साङ्गदैर्लब्धभूषणैः ।\nसतळत्रैः सकेयूरैर्भाति भारत मेदिनी\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2167660, "chapter_id": 4599, "verse_number": "४५", "content_sanskrit": "साङ्गुलित्रैर्भुजाग्रैश्च विप्रविद्धैरलङ्कृतैः ।\nहस्तिहस्तोपमैश्छिन्नैरूरुभिश्च तरस्विनाम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2167661, "chapter_id": 4599, "verse_number": "४६", "content_sanskrit": "बद्धचूडामणिवरैः शिरोभिश्चारुकुण्डलैः ।\n(निकृत्तैर्वृषभाक्षाणां विराजति वसुन्धरा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2167662, "chapter_id": 4599, "verse_number": "४७", "content_sanskrit": "गजवाजिमनुष्याणां शरशक्त्यृष्टितोमरैः ।\nकबन्धैः शोणितादिग्धैश्छिन्नगात्रशिरोधरैः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2167663, "chapter_id": 4599, "verse_number": "", "content_sanskrit": "भूर्भाति भरतश्रेष्ठ शान्तार्चिभिरिवाग्निभिः\t॥४८॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2167664, "chapter_id": 4599, "verse_number": "४९", "content_sanskrit": "रथांश्च बहुधा च्छिन्नान् हेमकिङ्किणिभूषितान् ।\nवाजिनश्च हतान् पश्य निष्कीर्णान्त्रान् शराचितान्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2167665, "chapter_id": 4599, "verse_number": "५०", "content_sanskrit": "अनुकर्षानुपासङ्गान् पताका विविधान् ध्वजान् ।\nरथिनां च महाशङ्खान् पाण्डरांश्च प्रकीर्णकान्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2167666, "chapter_id": 4599, "verse_number": "५१", "content_sanskrit": "निरस्तजिह्वान् मातङ्गान् शयानान् पर्वतोपमान् ।\nवैजयन्तीर्विचित्राश्च हतांश्च गजयोधिनः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2167667, "chapter_id": 4599, "verse_number": "५२", "content_sanskrit": "वारणानां परिस्तोमान् संयुक्तानेकम्बळान् ।\nविपाटितविचित्राश्च रौप्यचित्राः कुथास्तथा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2167668, "chapter_id": 4599, "verse_number": "५३", "content_sanskrit": "भिन्नाश्च बहुधा घण्टाः पतद्भिस्ताडिता गजैः ।\nवैडूर्यमणिदण्डांश्च पतितानङ्कुशान् भुवि\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2167669, "chapter_id": 4599, "verse_number": "५४", "content_sanskrit": "अश्वानां च युगानीषान् रत्नचित्रपरिच्छदान् ।\nपश्य सादिभुजाग्रेषु सुवर्णविकृताः कशाः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2167670, "chapter_id": 4599, "verse_number": "५५", "content_sanskrit": "विचित्रान् मणिचित्रांश्च जातरूपपरिष्कृतान् ।\nअश्वास्तरपरिस्तोमान् राङ्कवान् पतितान् भुवि\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2167671, "chapter_id": 4599, "verse_number": "५६", "content_sanskrit": "चूडामणीन् नरेन्द्राणां विचित्राः काञ्चनस्रजः ।\nछत्राणि चापविद्धानि चामरव्यजनानि च\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2167672, "chapter_id": 4599, "verse_number": "५७", "content_sanskrit": "चन्द्रनक्षत्रभासैश्च वदनैश्चारुकुण्डलैः ।\nक्लृप्तश्मश्रुभिरत्यर्थं वीराणां समलङ्कृतैः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2167673, "chapter_id": 4599, "verse_number": "५८", "content_sanskrit": "कुमुदोत्पलपद्मानां षण्डैः पूर्णं यथा सरः ।\nतथा महीभृतां वस्त्रैः कुमुदोत्पलसन्निभैः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2167674, "chapter_id": 4599, "verse_number": "५९", "content_sanskrit": "तारागणविचित्रस्य निर्मलेन्दुद्युतित्विषः ।\nपश्येमां नभसस्तुल्यां शिरोनक्षत्रमालिनीम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2167675, "chapter_id": 4599, "verse_number": "६०", "content_sanskrit": "वदनैः पश्य सञ्छन्नां महीं शोणितकर्दमाम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2167676, "chapter_id": 4599, "verse_number": "६१", "content_sanskrit": "सजीवांश्च नरान् पश्य कूजमानान् समन्ततः ।\nउपास्यमानांश्च बहून् न्यस्तशस्त्रैर्विशाम्पते\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2167677, "chapter_id": 4599, "verse_number": "६२", "content_sanskrit": "ज्ञातिभिश्च जलक्लिन्नान् रोदमानैर्मुहुर्मुहुः ।\nव्युत्क्रान्तानपरान् योधांश्छादयित्वा तरस्विनः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2167678, "chapter_id": 4599, "verse_number": "६३", "content_sanskrit": "पुनर्युद्धाय गच्छन्ति जये लुब्धाः प्रमन्यवः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2167679, "chapter_id": 4599, "verse_number": "६४", "content_sanskrit": "अपरे तत्र तत्रैव परिधावन्ति मानवाः ।\nज्ञातिभिः पतितैः शूरा याच्यमाना जलं तदा\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2167680, "chapter_id": 4599, "verse_number": "६५", "content_sanskrit": "जलार्थं च गताः केचिन्मृता वै बहवो जनाः ।\nसन्निवृत्ताश्च ते शूरा दृष्ट्वा चैनान् विचेतसः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2167681, "chapter_id": 4599, "verse_number": "६६", "content_sanskrit": "जलं त्यक्त्वा प्रधावन्ति क्रोशमानाः परस्परम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2167682, "chapter_id": 4599, "verse_number": "६७", "content_sanskrit": "जलं पीत्वा मृतान् पश्य पिबन्त्यन्ये च भारत\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2167683, "chapter_id": 4599, "verse_number": "६८", "content_sanskrit": "परिष्वज्य प्रियानन्ये बान्धवान् बन्धुवत्सलाः ।\nविसञ्ज्ञाः समरे योधास्तत्र तत्र महारणे\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2167684, "chapter_id": 4599, "verse_number": "६९", "content_sanskrit": "पश्यापरान् नरश्रेष्ठ सन्दष्टोष्ठपुटान् पुनः ।\nभ्रुकुटीकुटिलैर्वक्त्रैः प्रेक्षमाणान् महारणम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2167685, "chapter_id": 4599, "verse_number": "७०", "content_sanskrit": "एतत्तवैवानुरूपं कर्मार्जुन महाहवे ।\nदिवि वा देवराजस्य त्वया यत् कृतमद्य वै\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2167686, "chapter_id": 4599, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2167687, "chapter_id": 4599, "verse_number": "७१", "content_sanskrit": "एवं तां दर्शयन् कृष्णो रणभूमिं किरीटिने ।\nगच्छन्नेवाशृणोच्छब्दं दुर्योधनबले महत्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2167688, "chapter_id": 4599, "verse_number": "७२", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषं भेरीपणवमिश्रितम् ।\nरथाश्वनरनागानां पादशब्दांश्च दारुणान्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2167689, "chapter_id": 4599, "verse_number": "७३", "content_sanskrit": "प्रविश्य तद्बलं कृष्णस्तुरगैर्वातवेगितैः ।\nपाण्ड्येनाभ्यर्दितां सेनां त्वदीयां वीक्ष्य विष्ठितः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2167690, "chapter_id": 4599, "verse_number": "७४", "content_sanskrit": "स हि नानाविधैः शस्त्रैरिष्वस्त्रप्रवरो युधि ।\nन्यहनद् द्विषतां व्रातान् गतासूनन्तको यथा\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2167691, "chapter_id": 4599, "verse_number": "७५", "content_sanskrit": "गजवाजिमनुष्याणां शरीराणि शितैः शरैः ।\nहत्वा प्रहरतां श्रेष्ठो विदेहासूनथाकरोत्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2167692, "chapter_id": 4599, "verse_number": "७६", "content_sanskrit": "शत्रुप्रवीरैरस्तानि नानाशस्त्राणि सायकैः ।\nछित्त्वा तानवधीत् पाण्ड्यः शत्रून् शक्र इवासुरान्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2167693, "chapter_id": 4599, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nपाण्ड्ययुद्धं नाम एकोनविंशोऽध्यायः ॥१९॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]