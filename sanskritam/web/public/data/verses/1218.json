[{"id": 2010781, "chapter_id": 1218, "verse_number": "१-२१९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010782, "chapter_id": 1218, "verse_number": "१-२१९-१", "content_sanskrit": "वृत्ते स्वयंवरे चैव राजानः सर्व एव ते।\nयथागतं विप्रजग्मुर्विदित्वा पाण्डवान्वृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010783, "chapter_id": 1218, "verse_number": "१-२१९-२", "content_sanskrit": "अथ दुर्योधनो राजा विमना भ्रातृभिः सह।\nअश्वत्थाम्ना मातुलेन कर्णेन च कृपेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010784, "chapter_id": 1218, "verse_number": "१-२१९-३", "content_sanskrit": "विनिवृत्तो वृतं दृष्ट्वा द्रौपद्या श्वेतवाहनम्।\nतं तु दुःशासनोऽव्रीडो मन्दंमन्दमिवाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010785, "chapter_id": 1218, "verse_number": "१-२१९-४", "content_sanskrit": "यद्यसौ ब्राह्मणो न स्याद्विन्देत द्रौपदीं न सः।\nन हि तं तत्त्वतो राजन्वेद कश्चिद्धनंजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010786, "chapter_id": 1218, "verse_number": "१-२१९-५", "content_sanskrit": "दैवं च परमं मन्ये पौरुषं चाप्यनर्थकम्।\nधिगस्तु पौरुषं मन्त्रं यद्धरन्तीह पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010787, "chapter_id": 1218, "verse_number": "१-२१९-६", "content_sanskrit": "बध्वा चक्षूंषि नः पार्था राज्ञां च द्रुपदात्मजाम्।\nउद्वाह्य राज्ञां तैर्न्यस्तो वामः पादः पृथासुतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010788, "chapter_id": 1218, "verse_number": "१-२१९-७", "content_sanskrit": "विमुक्ताः कथमेतेन जतुवेश्मविर्भुजः।\nअस्माकं पौरुषं सत्वं बुद्धिश्चापि गता ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010789, "chapter_id": 1218, "verse_number": "१-२१९-८", "content_sanskrit": "वयं हता मातुलाद्य विश्वस्य च पुरोचनम्।\nअदग्ध्वा पाण्डवानेतान्स्वयं दग्धो हुताशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010790, "chapter_id": 1218, "verse_number": "१-२१९-९", "content_sanskrit": "मत्तो मातुल मन्येऽहं पाण्डवा बुद्धिमत्तराः।\nतेषां नास्ति भयं मृत्योर्मुक्तानां जतुवेश्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010791, "chapter_id": 1218, "verse_number": "१-२१९-१०x", "content_sanskrit": "वैशंपावयन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010792, "chapter_id": 1218, "verse_number": "१-२१९-१०", "content_sanskrit": "एवं संभाषमाणास्ते निन्दन्तश्च पुरोचनम्।\nपञ्चपुत्रां किरातीं च विदुरं च महामतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010793, "chapter_id": 1218, "verse_number": "१-२१९-११", "content_sanskrit": "विविशुर्हास्तिनपुरं दीना विगतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010794, "chapter_id": 1218, "verse_number": "१-२१९-१२", "content_sanskrit": "त्रस्ता विगतसंकल्पा दृष्ट्वा पार्थान्महौजसः।\nमुक्तान्हव्यभुजश्चैव संयुक्तान्द्रुपदेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010795, "chapter_id": 1218, "verse_number": "१-२१९-१३", "content_sanskrit": "धृष्टद्युम्नं तु संचिन्त्य तथैव च शिखण्डिनम्।\nद्रुपदस्यात्मजांश्चान्यान्सर्वयुद्धविशारदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010796, "chapter_id": 1218, "verse_number": "१-२१९-१४", "content_sanskrit": "विदुरस्त्वथ ताञ्श्रुत्वा द्रौपद्या पाण्डवान्वृतान्।\nव्रीडितान्धार्तराष्ट्रांश्च भग्नदर्पानुपागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010797, "chapter_id": 1218, "verse_number": "१-२१९-१५", "content_sanskrit": "ततः प्रीतमनाः क्षत्ता धृतराष्ट्रं विशांपते।\nउवाच दिष्ट्या कुरवो वर्ध्त इति विस्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010798, "chapter_id": 1218, "verse_number": "१-२१९-१६", "content_sanskrit": "वैचित्रवीर्यस्तु नृपो निशम्य विदुरस्य तत्।\nअब्रवीत्परमप्रीतो दिष्ट्या दिष्ट्येति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010799, "chapter_id": 1218, "verse_number": "१-२१९-१७", "content_sanskrit": "मन्यते स वृतं पुत्रं ज्येष्ठं द्रुपदकन्यया।\nदुर्योधनमविज्ञानात्प्रज्ञाचक्षुर्नरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010800, "chapter_id": 1218, "verse_number": "१-२१९-१८", "content_sanskrit": "अथ त्वाज्ञापयामास द्रौपद्या भूषणं बहु।\nआनीयतां वै कृष्णेति पुत्रं दुर्योधनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010801, "chapter_id": 1218, "verse_number": "१-२१९-१९", "content_sanskrit": "अथ स्म पश्चाद्विदुर आचख्यावम्बिकात्मजम्।\nकौरव्या इति सामान्यान्न मन्येथास्तवात्मजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010802, "chapter_id": 1218, "verse_number": "१-२१९-२०", "content_sanskrit": "वर्धन्त इति मद्वाक्याद्वर्धिताः पाण्डुनन्दनाः।\nकृष्णया संवृताः पार्था विमुक्ता राजसङ्गरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010803, "chapter_id": 1218, "verse_number": "१-२१९-२१", "content_sanskrit": "दिष्ट्या कुशलिनो राजन्पूजिता द्रुपदेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010804, "chapter_id": 1218, "verse_number": "१-२१९-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010805, "chapter_id": 1218, "verse_number": "१-२१९-२२", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं विदुरस्य नराधिपः।\nआकारच्छादनार्थाय दिष्ट्यादिष्ट्येति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010806, "chapter_id": 1218, "verse_number": "१-२१९-२३x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010807, "chapter_id": 1218, "verse_number": "१-२१९-२३", "content_sanskrit": "एवं विदुर भद्रं ते यदि जीवन्ति पाण्डवाः।\nन ममौ मे तनौ प्रीतिस्त्वद्वाक्यामृतसंभवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010808, "chapter_id": 1218, "verse_number": "१-२१९-२४", "content_sanskrit": "साध्वाचारतया तेषां संबन्धो द्रुपदेन च।\nबभूव परमश्लाघ्यो दिष्ट्यादिष्ट्येति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010809, "chapter_id": 1218, "verse_number": "१-२१९-२५", "content_sanskrit": "अन्ववाये वसोर्जातः प्रवरे मात्स्यके कुले।\nवृत्तविद्यातपोवृद्धः पार्थिवानां च संमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010810, "chapter_id": 1218, "verse_number": "१-२१९-२६", "content_sanskrit": "पुत्राश्चास्य तथा पौत्राः सर्वे सुचरितव्रताः।\nतेषां संबन्धिनश्चान्ये बहवः सुमहाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010811, "chapter_id": 1218, "verse_number": "१-२१९-२७", "content_sanskrit": "यथैव पाण्डोः पुत्रास्ते ततोऽप्यभ्यधिका मम।\nसेयमभ्यधिकान्येभ्यो वृत्तिर्विदुर मे मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010812, "chapter_id": 1218, "verse_number": "१-२१९-२८", "content_sanskrit": "या प्रीतिः पाण्डुपुत्रेषु न साऽन्यत्र ममाभिभो।\nनित्योऽयं चिन्तितः क्षत्तः सत्यं सत्येन शपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010813, "chapter_id": 1218, "verse_number": "१-२१९-२९", "content_sanskrit": "यत्ते कुशलिनो वीराः पाण्डुपुत्रा महारथाः।\nमित्रवन्तोऽभवन्पुत्रा दुर्योधनमुखास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2010814, "chapter_id": 1218, "verse_number": "१-२१९-३०", "content_sanskrit": "मया श्रुतं यदा वह्नेर्दग्धाः पाण्डुसुता इति।\nतदाऽदह्यं दिवारात्रं न भोक्ष्ये न स्वपामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2010815, "chapter_id": 1218, "verse_number": "१-२१९-३१", "content_sanskrit": "असहायाश्चं मे पुत्रा लूनपक्षा इव द्विजाः।\nतत्त्वतः शृणु मे क्षत्तः सुसहायाः सुता मम।\nअद्य वै स्थिरसाम्राज्यमाचन्द्रार्कं ममाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2010816, "chapter_id": 1218, "verse_number": "१-२१९-३२", "content_sanskrit": "को हि द्रुपदमासाद्य मित्रं क्षत्तः सबान्धवम्।\nन बुभूषेद्भवेनार्थी गतश्रीरपि पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2010817, "chapter_id": 1218, "verse_number": "१-२१९-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2010818, "chapter_id": 1218, "verse_number": "१-२१९-३३", "content_sanskrit": "तं तथा भाषमाणं तु विदुरः प्रत्यभाषत।\nनित्यं भवतु ते बुद्धिरेषा राजञ्छतं समाः।\nइत्युक्त्वा प्रययौ राजन्विदुरः स्वं निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2010819, "chapter_id": 1218, "verse_number": "१-२१९-३४", "content_sanskrit": "ततो दुर्योधनश्चापि राधेयश्च विशांपते।\nधृतराष्ट्रमुपागम्य वचोऽब्रूतामिदं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2010820, "chapter_id": 1218, "verse_number": "१-२१९-३५", "content_sanskrit": "सन्निधौ विदुरस्य त्वां दोषं वक्तुं न शक्नुवः।\nविविक्तमिति वक्ष्यावः किं तवेदं चिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2010821, "chapter_id": 1218, "verse_number": "१-२१९-३६", "content_sanskrit": "सपत्नवृद्धिं यत्तात मन्यसे वृद्धिमात्मनः।\nअभिष्टौषि च यत्क्षत्तुः समीपे द्विपदांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2010822, "chapter_id": 1218, "verse_number": "१-२१९-३७", "content_sanskrit": "अन्यस्मिन्नृप कर्तव्ये त्वमन्यत्कुरुषेऽनघ।\nतेषां बलविघातो हि कर्तव्यस्तात नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2010823, "chapter_id": 1218, "verse_number": "१-२१९-३८", "content_sanskrit": "ते वयं प्राप्तकालस्य चिकीर्षां मन्त्रयामहे।\nयथा नो न ग्रसेयुस्ते सपुत्रबलबान्धवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2010824, "chapter_id": 1218, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वमि विदुरागमनराज्यलाभपर्वणि एकोनविंशत्यधिकद्विशततमोऽध्यायः॥ २१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]