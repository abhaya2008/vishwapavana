[{"id": 7000250000, "chapter_id": 20250, "verse_number": "१-४-१", "content_sanskrit": "भीष्म उवाच ।\nक्षीराब्धौ तु तथा लक्ष्मीः किलोत्पन्ना मया श्रुता ।\nख्यात्यां भृगोः समुत्पन्ना एतदाह कथं भवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000250001, "chapter_id": 20250, "verse_number": "१-४-२", "content_sanskrit": "कथं च दक्षदुहिता देहं त्यक्तवती शुभा ।\nमेनायां गर्भसंभूतिमुमाया जन्म एव च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000250002, "chapter_id": 20250, "verse_number": "१-४-३", "content_sanskrit": "किमर्थं देवदेवेन पत्नी हैमवती कृता ।\nविरोधं चाथ दक्षेण भगवांस्तु ब्रवीतु मे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000250003, "chapter_id": 20250, "verse_number": "१-४-४", "content_sanskrit": "पुलस्त्य उवाच ।\nइदं च शृणु भूपाल यत्पृष्टोहमिह त्वया ।\nश्रीसंबंधो मयाप्येष श्रुत आसीत्पितामहात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000250004, "chapter_id": 20250, "verse_number": "१-४-५", "content_sanskrit": "अत्रिपुत्रस्तु दुर्वासाः परिभ्राम्यन्महीमिमाम् ।\nविद्याधरीकरेमालां दृष्ट्वा सौगन्धिकीं शुभाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000250005, "chapter_id": 20250, "verse_number": "१-४-६", "content_sanskrit": "याचयामास मे देहि जटाजूटे करोम्यहम् ।\nइति विद्याधरी तेन पृष्टा सा ऋषिणा तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000250006, "chapter_id": 20250, "verse_number": "१-४-७", "content_sanskrit": "ददौ तस्मै मुदायुक्ता तां मालां स तदा नृप ।\nगृहीत्वा सुचिरं कालं शिरोमालां बबंध ह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000250007, "chapter_id": 20250, "verse_number": "१-४-८", "content_sanskrit": "उन्मत्त प्रेतवद्विप्रः शोभमानोब्रवीदिदम् ।\nइयं विद्याधरी कन्या पीनोन्नत पयोधरा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000250008, "chapter_id": 20250, "verse_number": "१-४-९", "content_sanskrit": "शोभालंकारसौभाग्यैर्युक्ता दृष्टा ततो मनः ।\nक्षोभमायाति मे चाद्य नाहं कामे विचक्षणः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000250009, "chapter_id": 20250, "verse_number": "१-४-१०", "content_sanskrit": "व्रजामि तावदन्यत्र सौभाग्यं स्वं प्रदर्शयन् ।\nएवमुक्त्वा स राजेंद्र परिबभ्राम मेदिनीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000250010, "chapter_id": 20250, "verse_number": "१-४-११", "content_sanskrit": "ऐरावतं समारूढं राजानं त्रिदिवौकसाम् ।\nत्रैलोक्याधिपतिं शक्रं भ्राजमानं शचीपतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000250011, "chapter_id": 20250, "verse_number": "१-४-१२", "content_sanskrit": "तामात्मशिरसो मालां भ्रमदुन्मत्तषट्पदाम् ।\nआदायामरराजाय चिक्षेपोन्मत्तवन्मुनिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000250012, "chapter_id": 20250, "verse_number": "१-४-१३", "content_sanskrit": "गृहीत्वा देवराजेन माला सा गजमूर्द्धनि ।\nमुक्ता रराज सा माला कैलासे जाह्नवी यथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000250013, "chapter_id": 20250, "verse_number": "१-४-१४", "content_sanskrit": "मदांधकारिताक्षोसौ गंधाघ्राणेन वारणः ।\nकरेणादाय चिक्षेप तां मालां पृथिवीतले ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000250014, "chapter_id": 20250, "verse_number": "१-४-१५", "content_sanskrit": "ततश्चुक्रोध भगवान्दुर्वासा मुनिपुंगवः ।\nराजेंद्रदेवराजानं क्रुद्धश्चेदमुवाच ह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000250015, "chapter_id": 20250, "verse_number": "१-४-१६", "content_sanskrit": "ऐश्वर्यमददुष्टात्मन्नतिस्तब्धोसि वासव ।\nश्रियोधामस्रजं यस्मान्मद्दत्तान्नाभिनंदसि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000250016, "chapter_id": 20250, "verse_number": "१-४-१७", "content_sanskrit": "त्रैलोक्यश्रीरतो मूढ विनाशमुपयास्यति ।\nमद्दत्ता भवता माला क्षिप्ता यस्मान्महीतले ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000250017, "chapter_id": 20250, "verse_number": "१-४-१८", "content_sanskrit": "तस्मात्प्रणष्टलक्ष्मीकं त्रैलोक्यं ते भविष्यति ।\nयस्य संजातकोपस्य भयमेति चराचरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000250018, "chapter_id": 20250, "verse_number": "१-४-१९", "content_sanskrit": "तं मां त्वमतिगर्वेण देवराजावमन्यसे ।\nमहेंद्रो वारणस्कंधादवतीर्य त्वरान्वितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000250019, "chapter_id": 20250, "verse_number": "१-४-२०", "content_sanskrit": "प्रसादयामास मुनिं दुर्वाससमकल्मषम् ।\nप्रसाद्यमानः स तदा प्रणिपातपुरःसरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000250020, "chapter_id": 20250, "verse_number": "१-४-२१", "content_sanskrit": "नाहं क्षमिष्ये बहुना किमुक्तेन शतक्रतो ।\nइत्युक्त्वा प्रययौ विप्रो देवराजोपि तं पुनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000250021, "chapter_id": 20250, "verse_number": "१-४-२२", "content_sanskrit": "आरुह्यैरावतं नागं प्रययावमरावतीम् ।\nततः प्रभृति निःश्रीकं सशक्रं भुवनत्रयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000250022, "chapter_id": 20250, "verse_number": "१-४-२३", "content_sanskrit": "न यज्ञाः संप्रवर्तंते न तपस्यंति तापसाः ।\nन च दानानि दीयंते नष्टप्रायमभूज्जगत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000250023, "chapter_id": 20250, "verse_number": "१-४-२४", "content_sanskrit": "एवमत्यंतनिःश्रीके त्रैलोक्ये सत्त्ववर्जिते ।\nदेवान्प्रतिबलोद्योगं चक्रुर्दैतेयदानवाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000250024, "chapter_id": 20250, "verse_number": "१-४-२५", "content_sanskrit": "विजितास्त्रिदशा दैत्यैरिंद्राद्याः शरणं ययुः ।\nपितामहं महाभागं हुताशनपुरोगमाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000250025, "chapter_id": 20250, "verse_number": "१-४-२६", "content_sanskrit": "यथावत्कथिते देवैर्ब्रह्मा प्राह तथा सुरान् ।\nक्षीरोदस्योत्तरं कूलं जगाम सहितः सुरैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000250026, "chapter_id": 20250, "verse_number": "१-४-२७", "content_sanskrit": "गत्वा जगाद भगवान्वासुदेवं पितामहः ।\nउत्तिष्ठ विष्णो शीघ्रं त्वं देवतानां हितं कुरु ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000250027, "chapter_id": 20250, "verse_number": "१-४-२८", "content_sanskrit": "त्वया विना दानवैस्तु जिताः सर्वे पुनःपुनः ।\nइत्युक्तः पुंडरीकाक्षः पुरुषः पुरुषोत्तमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000250028, "chapter_id": 20250, "verse_number": "१-४-२९", "content_sanskrit": "अपूर्वरूपसंस्थानान्दृष्ट्वा देवानुवाच ह ।\nतेजसो भवतां देवाः करिष्याम्युपबृंहणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000250029, "chapter_id": 20250, "verse_number": "१-४-३०", "content_sanskrit": "वदाम्यहं यत्क्रियतां भवद्भिस्तदिदं सुराः ।\nआनीय सहिता दैत्यैः क्षीराब्धौ सकलौषधीः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000250030, "chapter_id": 20250, "verse_number": "१-४-३१", "content_sanskrit": "मंथानं मंदरं कृत्वा नेत्रं कृत्वा च वासुकिम् ।\nमथ्यताममृतं देवाः सहाये मय्यवस्थिते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000250031, "chapter_id": 20250, "verse_number": "१-४-३२", "content_sanskrit": "सामपूर्वं च दैतेयांस्तत्र सम्भाष्य कर्मणि ।\nसमानफलभोक्तारो यूंय चात्र भविष्यथ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000250032, "chapter_id": 20250, "verse_number": "१-४-३३", "content_sanskrit": "मथ्यमाने च तत्राब्धौ यत्समुत्पद्यतेऽमृतम् ।\nतत्पानाद्बलिनो यूयममराः संभविष्यथ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000250033, "chapter_id": 20250, "verse_number": "१-४-३४", "content_sanskrit": "तथैवाहं करिष्यामि यथा त्रिदशविद्विषः ।\nन प्राप्स्यंत्यमृतं देवाः केवलं क्लेशभागिनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000250034, "chapter_id": 20250, "verse_number": "१-४-३५", "content_sanskrit": "इत्युक्ता देवदेवेन सर्व एव ततः सुराः ।\nसंधानमसुरैः कृत्वा यत्नवंतोऽमृतेभवन् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000250035, "chapter_id": 20250, "verse_number": "१-४-३६", "content_sanskrit": "सर्वौषधीः समानीय देवदैतेयदानवाः ।\nक्षिप्त्वा क्षीराब्धिपयसि शरदभ्रामलत्विषि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000250036, "chapter_id": 20250, "verse_number": "१-४-३७", "content_sanskrit": "मंथानं मंदरं कृत्वा नेत्रं कृत्वा च वासुकिम् ।\nततो मथितुमारब्धा राजेंद्र तरसामृतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000250037, "chapter_id": 20250, "verse_number": "१-४-३८", "content_sanskrit": "विबुधाः सहिताः सर्वे यतः पुच्छं ततः स्थिताः ।\nविष्णुना वासुकेर्द्दैत्याः पूर्वकाये निवेशिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000250038, "chapter_id": 20250, "verse_number": "१-४-३९", "content_sanskrit": "ते तस्य प्राणवातेन वह्निना च हतत्त्विषः ।\nनिस्तेजसोऽसुराः सर्वे बभूवुरमरद्युते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000250039, "chapter_id": 20250, "verse_number": "१-४-४०", "content_sanskrit": "तेनैव मुखनिःश्वासवायुनाथ बलाहकैः ।\nपुच्छप्रदेशे वर्षद्भिस्तदा चाप्पयिताः सुराः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000250040, "chapter_id": 20250, "verse_number": "१-४-४१", "content_sanskrit": "क्षीरोदमध्ये भगवान्ब्रह्मा ब्रह्मविदां वरः ।\nमहादेवो महातेजा विष्णुपृष्ठनिवासिनौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000250041, "chapter_id": 20250, "verse_number": "१-४-४२", "content_sanskrit": "बाहुभ्यां मंदरं गृह्य पद्मवत्स परंतपः ।\nशृंखले च तदा कृत्वा गृहीत्वा मंदराचलम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000250042, "chapter_id": 20250, "verse_number": "१-४-४३", "content_sanskrit": "देवानां दानवानां च बलमध्ये व्यवस्थितः ।\nक्षीरोदमध्ये भगवान्कूर्मरूपी स्वयं हरिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000250043, "chapter_id": 20250, "verse_number": "१-४-४४", "content_sanskrit": "अन्येन तेजसा देवानुपबृंहितवान्हरिः ।\nमथ्यमाने ततस्तस्मिन्क्षीराब्धौ देवदानवैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000250044, "chapter_id": 20250, "verse_number": "१-४-४५", "content_sanskrit": "हविर्धान्यभवत्पूर्वं सुरभिः सुरपूजिता ।\nजग्मुर्मुदं तदा देवा दानवाश्च महामते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000250045, "chapter_id": 20250, "verse_number": "१-४-४६", "content_sanskrit": "व्याक्षिप्तचेतसः सर्वे बभूवुस्तिमितेक्षणाः ।\nकिमेतदिति सिद्धानां दिवि चिंतयतां तदा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000250046, "chapter_id": 20250, "verse_number": "१-४-४७", "content_sanskrit": "बभूव वारुणी देवी मदाघूर्णितलोचना ।\nकृतावर्त्ता ततस्तस्मात्प्रस्खलंती पदे पदे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000250047, "chapter_id": 20250, "verse_number": "१-४-४८", "content_sanskrit": "एकवस्त्रा मुक्तकेशी रक्तांतस्तब्धलोचना ।\nअहं बलप्रदा देवी मां वा गृह्णन्तु दानवाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000250048, "chapter_id": 20250, "verse_number": "१-४-४९", "content_sanskrit": "अशुचिं वारुणीं मत्वा त्यक्तवंतस्तदा सुराः ।\nजगृहुस्तां तदा दैत्या ग्रहणान्तेसुराभवत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000250049, "chapter_id": 20250, "verse_number": "१-४-५०", "content_sanskrit": "मंथने पारिजातोभूद्देव श्रीनंदनो द्रुमः ।\nरूपौदार्य्यगुणोपेतास्ततश्चाप्सरसां गणाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000250050, "chapter_id": 20250, "verse_number": "१-४-५१", "content_sanskrit": "षष्टिकोट्यस्तदा जातास्सामान्या देव दानवैः ।\nसर्वास्ताः कृतपूर्वास्तु सामान्याः पुण्यकर्मणा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000250051, "chapter_id": 20250, "verse_number": "१-४-५२", "content_sanskrit": "ततः शीतांशुरभवद्देवानां प्रीतिदायकः ।\nययाचे शंकरो देवो जटाभूषणकृन्मम ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000250052, "chapter_id": 20250, "verse_number": "१-४-५३", "content_sanskrit": "भविष्यति न संदेहो गृहीतोयं मया शशी ।\nअनुमेने च तं ब्रह्मा भूषणाय हरस्य तु ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000250053, "chapter_id": 20250, "verse_number": "१-४-५४", "content_sanskrit": "ततो विषं समुत्पन्नं कालकूटं भयावहं ।\nतेन चैवार्दितास्सर्वे दानवाः सह दैवतैः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000250054, "chapter_id": 20250, "verse_number": "१-४-५५", "content_sanskrit": "महादेवेन तत्पीतं विषं गृह्य यदृच्छया ।\nतस्य पानान्नीलकंठस्तदा जातो महेश्वरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000250055, "chapter_id": 20250, "verse_number": "१-४-५६", "content_sanskrit": "पीतावशेषं नागास्तु क्षीराब्धेस्तु समुत्थितम् ।\nततो धन्वंतरिर्जातः श्वेतांबरधरः स्वयम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000250056, "chapter_id": 20250, "verse_number": "१-४-५७", "content_sanskrit": "बिभ्रत्कमंडलुं पूर्णममृतस्य समुत्थितः ।\nततः स्वस्थमनस्कास्ते वैद्यराजस्य दर्शनात् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000250057, "chapter_id": 20250, "verse_number": "१-४-५८", "content_sanskrit": "ततश्चाश्वः समुत्पन्नो नागश्चैरावतस्तथा ।\nतत स्फुरत्कांतीमतिविकासि कमलेस्थिता ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000250058, "chapter_id": 20250, "verse_number": "१-४-५९", "content_sanskrit": "श्रीर्द्देवी पयसस्तस्मादुत्थिता धृतपंकजा ।\nतां तुष्टवुर्मुदायुक्ताः श्रीसूक्तेन महर्षयः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000250059, "chapter_id": 20250, "verse_number": "१-४-६०", "content_sanskrit": "विश्वावसुमुखास्तस्या गंधर्वाः पुरतो जगुः ।\nघृताचीप्रमुखास्तत्र ननृतुश्चाप्सरोगणाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000250060, "chapter_id": 20250, "verse_number": "१-४-६१", "content_sanskrit": "गंगाद्याः सरितस्तोयैः स्नानार्थमुपतस्थिरे ।\nदिग्गजा हेमपात्रस्थमादाय विमलं जलम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000250061, "chapter_id": 20250, "verse_number": "१-४-६२", "content_sanskrit": "स्नापयांचक्रिरे देवीं सर्वलोकमहेश्वरीम् ।\nक्षीरोदस्तु स्वयं तस्यै मालामम्लानपंकजाम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000250062, "chapter_id": 20250, "verse_number": "१-४-६३", "content_sanskrit": "ददौ विभूषणान्यंगे विश्वकर्मा चकार ह ।\nदिव्यमाल्यांबरधरां स्नातां भूषणभूषिताम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000250063, "chapter_id": 20250, "verse_number": "१-४-६४", "content_sanskrit": "इंद्राद्याश्चामरगणा विद्याधरमहोरगाः ।\nदानवाश्च महादैत्या राक्षसाः सह गुह्यकैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000250064, "chapter_id": 20250, "verse_number": "१-४-६५", "content_sanskrit": "कन्यामभिलषन्ति स्म ततो ब्रह्मा उवाच ह ।\nवासुदेव त्वमेवैनां मया दत्तां गृहाण वै ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000250065, "chapter_id": 20250, "verse_number": "१-४-६६", "content_sanskrit": "देवाश्च दानवाश्चैव प्रतिषिद्धा मया त्विह ।\nतुष्टोहं भवतस्तावदलौल्येनेह कर्मणा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000250066, "chapter_id": 20250, "verse_number": "१-४-६७", "content_sanskrit": "सा तु श्रीर्ब्रह्मणा प्रोक्ता देवि गछस्व केशवं ।\nमया दत्तं पतिं प्राप्य मोदस्व शाश्वतीः समाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000250067, "chapter_id": 20250, "verse_number": "१-४-६८", "content_sanskrit": "पश्यतां सर्वदेवानां गता वक्षस्थलं हरेः ।\nततो वक्षस्थलं प्राप्य देवं वचनमब्रवीत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000250068, "chapter_id": 20250, "verse_number": "१-४-६९", "content_sanskrit": "नाहं त्याज्या सदा देव सदैवादेशकारिणी ।\nवक्षस्थले निवत्स्यामि सर्वस्य जगतः प्रिय ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000250069, "chapter_id": 20250, "verse_number": "१-४-७०", "content_sanskrit": "ततोवलोकिता देवा विष्णुवक्षस्थलस्थया ।\nलक्ष्म्या राजेंद्र सहसा परां निर्वृतिमागताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000250070, "chapter_id": 20250, "verse_number": "१-४-७१", "content_sanskrit": "उद्वेगं च परं जग्मुर्द्दैत्या विष्णुपराङ्मुखाः ।\nत्यक्तास्तु दानवा लक्ष्म्या विप्रचित्तिपुरोगमाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000250071, "chapter_id": 20250, "verse_number": "१-४-७२", "content_sanskrit": "ततस्ते जगृहुर्दैत्या धन्वंतरिकरस्थितम् ।\nअमृतं तन्महावीर्य्या दैत्याः पापसमन्विताः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000250072, "chapter_id": 20250, "verse_number": "१-४-७३", "content_sanskrit": "मायया लोभयित्वा तु विष्णुः स्त्रीरूपसंश्रयः ।\nआगत्य दानवान्प्राह दीयतां मे कमंडलुः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000250073, "chapter_id": 20250, "verse_number": "१-४-७४", "content_sanskrit": "युष्माकं वशगा भूत्वा स्थास्यामि भवतां गृहे ।\nतां दृष्ट्वा रूपसंपन्नां नारीं त्रैलोक्यसुंदरीम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000250074, "chapter_id": 20250, "verse_number": "१-४-७५", "content_sanskrit": "प्रार्थयानास्सुवपुषं लोभोपहतचेतसः ।\nदत्त्वामृतं तदा तस्यै ततोपश्यन्त तेग्रतः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000250075, "chapter_id": 20250, "verse_number": "१-४-७६", "content_sanskrit": "दानवेभ्यस्तदादाय देवेभ्यः प्रददेमृतं ।\nततः पपुः सुरगणाः शक्राद्यास्तत्तदामृतम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000250076, "chapter_id": 20250, "verse_number": "१-४-७७", "content_sanskrit": "उद्यतायुधनिस्त्रिंशा दैत्यास्तांस्ते समभ्ययुः ।\nपीतेमृते च बलिभिर्जिता दैत्यचमूस्ततः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000250077, "chapter_id": 20250, "verse_number": "१-४-७८", "content_sanskrit": "वध्यमाना दिशो भेजुः पातालं विविशुश्च ते ।\nततो देवा मुदायुक्ताः शंखचक्रगदाधरम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000250078, "chapter_id": 20250, "verse_number": "१-४-७९", "content_sanskrit": "प्रणिपत्य यथापूर्वं प्रययुस्ते त्रिविष्टपम् ।\nततःप्रभृति ते भीष्म स्त्रीलोला दानवाभवन् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000250079, "chapter_id": 20250, "verse_number": "१-४-८०", "content_sanskrit": "अपध्यातास्तु कृष्णेन गतास्ते तु रसातलम् ।\nततः सूर्यः प्रसन्नाभः प्रययौ स्वेन वर्त्मना ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000250080, "chapter_id": 20250, "verse_number": "१-४-८१", "content_sanskrit": "जज्वाल भगवांश्चोच्चैश्चारुदीप्तिर्हुताशनः ।\nधर्मे च सर्वभूतानां तदा मतिरजायत ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000250081, "chapter_id": 20250, "verse_number": "१-४-८२", "content_sanskrit": "श्रियायुक्तं च त्रैलोक्यं विष्णुना प्रतिपालितं ।\nदेवास्तु ते तदा प्रोक्ता ब्रह्मणा लोकधारिणा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000250082, "chapter_id": 20250, "verse_number": "१-४-८३", "content_sanskrit": "भवतां रक्षणार्थाय मया विष्णुर्नियोजितः ।\nउमापतिश्च देवेशो योगक्षेमं करिष्यतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000250083, "chapter_id": 20250, "verse_number": "१-४-८४", "content_sanskrit": "उपास्यमानौ सततं युष्मत्क्षेमकरौ यतः ।\nततः क्षेम्यौ सदा चैतौ भविष्येते वरप्रदौ ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000250084, "chapter_id": 20250, "verse_number": "१-४-८५", "content_sanskrit": "एवमुक्त्वा तु भगवान्जगाम गतिमात्मनः ।\nअदर्शनं गते देवे सर्वलोकपितामहे ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000250085, "chapter_id": 20250, "verse_number": "१-४-८६", "content_sanskrit": "देवलोकं गते शक्रे स्वं लोकं हरिशंकरौ ।\nप्राप्तौ तु तत्क्षणाद्देवौ स्थानं कैलासमेव च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000250086, "chapter_id": 20250, "verse_number": "१-४-८७", "content_sanskrit": "ततस्तु देवराजेन पालितं भुवनत्रयम् ।\nएवं लक्ष्मीर्महाभागा उत्पन्ना क्षीरसागरात् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000250087, "chapter_id": 20250, "verse_number": "१-४-८८", "content_sanskrit": "पुनः ख्यात्यां समुत्पन्ना भृगोरेषा सनातनी ।\nश्रिया सह समुत्पन्ना भृगुणा च महर्षिणा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000250088, "chapter_id": 20250, "verse_number": "१-४-८९", "content_sanskrit": "स्वनाम्ना नगरी चैव कृता पूर्वं सरित्तटे ।\nनर्मदायां महाराज ब्रह्मणा चानुमोदिता ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000250089, "chapter_id": 20250, "verse_number": "१-४-९०", "content_sanskrit": "लक्ष्मीः पुरं स्वपित्रे स्वं सह कुञ्चिकयाऽप्य च ।\nआगता देवलोकं साऽयाचतागत्य वै पुनः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000250090, "chapter_id": 20250, "verse_number": "१-४-९१", "content_sanskrit": "लोभान्न दत्तं तु पुरं प्रार्थयाना यदा पुनः ।\nभृगोः सकाशान्नावाप तदा चैवाह केशवम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000250091, "chapter_id": 20250, "verse_number": "१-४-९२", "content_sanskrit": "परिभूता तु पित्राहं गृहीतं नगरं मम ।\nतस्य हस्तात्त्वमाक्षिप्य पुरं तच्चानय स्वयम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000250092, "chapter_id": 20250, "verse_number": "१-४-९३", "content_sanskrit": "तं गत्वा पुंडरीकाक्षो देवश्चक्रगदाधरः ।\nभृगुं सानुनयं प्राह कन्यायै पुरमर्पय ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000250093, "chapter_id": 20250, "verse_number": "१-४-९४", "content_sanskrit": "कुञ्चिकातालिके चोभे दीयेतां च प्रसादतः ।\nभृगुस्तं कुपितः प्राह नार्पयिष्याम्यहं पुरम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000250094, "chapter_id": 20250, "verse_number": "१-४-९५", "content_sanskrit": "न लक्ष्म्यास्तत्पुरं देव मया चेदं स्वयं कृतम् ।\nभगवन्नैव दास्यामि त्यजाक्षेपं तु केशव ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000250095, "chapter_id": 20250, "verse_number": "१-४-९६", "content_sanskrit": "तं प्राह देवो भूयोपि लक्ष्म्यास्तत्पुरमर्पय ।\nसर्वथा तु त्वया त्याज्यं वचनान्मे महामुने ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000250096, "chapter_id": 20250, "verse_number": "१-४-९७", "content_sanskrit": "ततः कोपसमाविष्टो भृगुरप्याह केशवम् ।\nपक्षपातेन मां साधो भार्याया बाधसेधुना ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000250097, "chapter_id": 20250, "verse_number": "१-४-९८", "content_sanskrit": "नृलोके दशजन्मानि लप्स्यसे मधुसूदन ।\nभार्यायास्ते वियोगेन दुःखान्यनुभविष्यसि ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000250098, "chapter_id": 20250, "verse_number": "१-४-९९", "content_sanskrit": "एवं शापं ददौ तस्मै भृगुः परमकोपनः ।\nविष्णुना च पुनस्तस्य दत्तः शापो महात्मना ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000250099, "chapter_id": 20250, "verse_number": "१-४-१००", "content_sanskrit": "न चापत्यकृतां प्रीतिं प्राप्स्यसे मुनिपुंगव ।\nशापं दत्त्वा ऋषेस्तस्य ब्रह्मलोकं जगाम ह ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000250100, "chapter_id": 20250, "verse_number": "१-४-१०१", "content_sanskrit": "पद्मजन्मानमाहेदं दृष्ट्वा देवस्तु केशवः ।\nभगवंस्तव पुत्रोसौ भृगुः परमकोपनः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000250101, "chapter_id": 20250, "verse_number": "१-४-१०२", "content_sanskrit": "निष्कारणं च तेनाहं शप्तो जन्मानि मानुषे ।\nलप्स्यसे दशधा त्वं हि ततो दुःखान्यनेकशः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000250102, "chapter_id": 20250, "verse_number": "१-४-१०३", "content_sanskrit": "भार्यावियोगजा पीडा बलपौरुषनाशिनी ।\nत्यत्क्वा चाहमिमं लोकं शयिष्ये च महोदधौ ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000250103, "chapter_id": 20250, "verse_number": "१-४-१०४", "content_sanskrit": "देवकार्येषु सर्वेषु पुनश्चावाहनं क्रियाः ।\nतथा ब्रुवंतं तं देवं ब्रह्मा लोकगुरुस्तदा ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000250104, "chapter_id": 20250, "verse_number": "१-४-१०५", "content_sanskrit": "प्रसादनार्थं विष्णोस्तु स्तुतिमेतां चकार ह ।\nत्वया सृष्टं जगदिदं पद्मं नाभौ विनिःसृतम् ।\nतत्र चाहं समुत्पन्नस्तव वश्यश्च केशव ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000250105, "chapter_id": 20250, "verse_number": "१-४-१०६", "content_sanskrit": "त्वं त्राता सर्वलोकानां स्रष्टा त्वं जगतः प्रभो ।\nत्रैलोक्यं न त्वया त्याज्यमेष एव वरो मम ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000250106, "chapter_id": 20250, "verse_number": "१-४-१०७", "content_sanskrit": "दशजन्ममनुष्येषु लोकानां हितकाम्यया ।\nस्वयं कर्त्ता न ते शक्तः शापदानाय कोपि वा ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000250107, "chapter_id": 20250, "verse_number": "१-४-१०८", "content_sanskrit": "कोयं भृगुः कथं तेन शक्यं शप्तुं जनार्दन ।\nमानयस्व सदा विप्रान्ब्राह्मणास्ते तनुस्स्वयम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000250108, "chapter_id": 20250, "verse_number": "१-४-१०९", "content_sanskrit": "योगनिद्रामुपास्व त्वं क्षीराब्धौ स्वपि हीश्वर ।\nकार्यकाले पुनस्त्वां तु बोधयिष्यामि माधव ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000250109, "chapter_id": 20250, "verse_number": "१-४-११०", "content_sanskrit": "भगवन्नेष तावत्तु त्वच्छक्त्या चोपबृंहितः ।\nसर्वकार्यकरः शक्रस्तवैवांशेन शत्रुहा ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000250110, "chapter_id": 20250, "verse_number": "१-४-१११", "content_sanskrit": "त्रैलोक्यं पालयन्नेव त्वदाज्ञां स करिष्यति ।\nएवं स्तुतस्तदा विष्णुर्ब्रह्माणमिदमुक्तवान् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000250111, "chapter_id": 20250, "verse_number": "१-४-११२", "content_sanskrit": "सर्वमेतत्करिष्यामि यन्मां ज्ञापयसे प्रभो ।\nअदर्शनं गतो देवो ब्रह्मा तं नाभिजज्ञिवान् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000250112, "chapter_id": 20250, "verse_number": "१-४-११३", "content_sanskrit": "गते देवे तदा विष्णौ ब्रह्मा लोकपितामहः ।\nभूयश्चकार वै सृष्टिं लोकानां प्रभवः प्रभुः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000250113, "chapter_id": 20250, "verse_number": "१-४-११४", "content_sanskrit": "तं दृष्ट्वा नारदः प्राह वाक्यं वाक्यविदां वरः ।\nसहस्रशीर्षा पुरुषः सहस्राक्षः सहस्रपात् ।\nसर्वव्यापी भुवः स्पर्शादध्यतिष्ठद्दशांगुलम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000250114, "chapter_id": 20250, "verse_number": "१-४-११५", "content_sanskrit": "यद्भूतं यच्च वै भाव्यं सर्वमेव भवान्यतः ।\nततो विश्वमिदं तात त्वत्तो भूतं भविष्यति ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000250115, "chapter_id": 20250, "verse_number": "१-४-११६", "content_sanskrit": "त्वत्तो यज्ञः सर्वहुतः पृषदाज्यं पशुर्द्विधा ।\nऋचस्त्वत्तोथ सामानि त्वत्त एवाभिजज्ञिरे ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000250116, "chapter_id": 20250, "verse_number": "१-४-११७", "content_sanskrit": "त्वत्तो यज्ञास्त्वजायंत त्वत्तो श्वाश्चैव दंतिनः ।\nगावस्त्वत्तः समुद्भूताः त्वत्तो जातावयोमृगाः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000250117, "chapter_id": 20250, "verse_number": "१-४-११८", "content_sanskrit": "त्वन्मुखाद्ब्राह्मणा जातास्त्वत्तः क्षत्रमजायत ।\nवैश्यास्तवोरुजाः शूद्रास्तव पद्भ्यां समुद्गताः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000250118, "chapter_id": 20250, "verse_number": "१-४-११९", "content_sanskrit": "अक्ष्णोः सूर्योनिलः श्रोत्राच्चंद्रमा मनसस्तव ।\nप्राणोंतः सुषिराज्जातो मुखादग्निरजायत ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000250119, "chapter_id": 20250, "verse_number": "१-४-१२०", "content_sanskrit": "नाभितो गगनं द्यौश्च शिरसः समवर्त्तत ।\nदिशः श्रोत्रात्क्षितिः पद्भ्यां त्वत्तः सर्वमभूदिदम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000250120, "chapter_id": 20250, "verse_number": "१-४-१२१", "content_sanskrit": "न्यग्रोधः सुमहानल्पे यथा बीजे व्यवस्थितः ।\nससर्ज्ज विश्वमखिलं बीजभूते तथा त्वयि ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000250121, "chapter_id": 20250, "verse_number": "१-४-१२२", "content_sanskrit": "बीजांकुरसमुद्भूतो न्यग्रोधः समुपस्थितः ।\nविस्तारं च यथा याति त्वत्तः सृष्टौ तथा जगत् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000250122, "chapter_id": 20250, "verse_number": "१-४-१२३", "content_sanskrit": "यथा हि कदली नान्या त्वक्पत्रेभ्योऽभिदृश्यते ।\nएवं विश्वमिदं नान्यत्त्वत्स्थमीश्वर दृश्यते ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000250123, "chapter_id": 20250, "verse_number": "१-४-१२४", "content_sanskrit": "ह्लादिनी त्वयि शक्तिस्सा त्वय्येका सहभाविनी ।\nह्लादतापकरीमिश्रा त्वयि नो गुणवर्जिते ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000250124, "chapter_id": 20250, "verse_number": "१-४-१२५", "content_sanskrit": "पृथग्भूतैकभूताय सर्वभूताय ते नमः ।\nव्यक्तं प्रधानं पुरुषो विराट्सम्राट्तथा भवान् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000250125, "chapter_id": 20250, "verse_number": "१-४-१२६", "content_sanskrit": "सर्वस्मिन्सर्वभूतस्त्वं सर्वः सर्वस्वरूपधृक् ।\nसर्वं त्वत्तः समुद्भूतं नमः सर्वात्मने ततः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000250126, "chapter_id": 20250, "verse_number": "१-४-१२७", "content_sanskrit": "सर्वात्मकोसि सर्वेश सर्वभूतस्थितो यतः ।\nकथयामि ततः किं ते सर्वं वेत्सि हृदिस्थितं ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000250127, "chapter_id": 20250, "verse_number": "१-४-१२८", "content_sanskrit": "यो मे मनोरथो देव सफलः स त्वया कृतः ।\nतप्तं सुतप्तं सफलं यद्दृष्टोसि जगत्पते ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000250128, "chapter_id": 20250, "verse_number": "१-४-१२९", "content_sanskrit": "ब्रह्मोवाच ।\nतपसस्तत्फलं पुत्र यद्दृष्टोहं त्वयाधुना ।\nमद्दर्शनं हि विफलं नारदेह न जायते ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000250129, "chapter_id": 20250, "verse_number": "१-४-१३०", "content_sanskrit": "वरं वरय तस्मात्त्वं यथाभिमतमात्मनः ।\nसर्वं संपद्यते तात मयि दृष्टिपथं गते ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000250130, "chapter_id": 20250, "verse_number": "१-४-१३१", "content_sanskrit": "नारद उवाच ।\nभगवन्सर्वभूतेश सर्वस्यास्ते भवान्हृदि ।\nकिमज्ञातं तव स्वामिन्मनसा यन्मयेप्सितम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000250131, "chapter_id": 20250, "verse_number": "१-४-१३२", "content_sanskrit": "कृता त्वया यथा सृष्टिर्मया दृष्टा तथा विभो ।\nतेन मे कौतुकं जातं दृष्ट्वा देवर्षिदानवान् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000250132, "chapter_id": 20250, "verse_number": "१-४-१३३", "content_sanskrit": "पुलस्त्य उवाच ।\nनारदस्य पिता तुष्टो ब्रह्मा देवो दिवस्पतिः ।\nनारदाय वरं प्रादादृषीणामुत्तमो भवान् ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000250133, "chapter_id": 20250, "verse_number": "१-४-१३४", "content_sanskrit": "भविता मत्प्रसादेन कलिकेलिकथाप्रियः ।\nगतिश्च तेऽप्रतिहता दिवि भूमौ रसातले ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7000250134, "chapter_id": 20250, "verse_number": "१-४-१३५", "content_sanskrit": "यज्ञोपवीतसूत्रेण योगपट्टावलंबिका ।\nछत्रिका च तथा वीणा अलंकाराय तेनघ ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7000250135, "chapter_id": 20250, "verse_number": "१-४-१३६", "content_sanskrit": "विष्णोः समीपे रुद्रस्य तथा शक्रस्य नारद ।\nद्वीपेषु पार्थिवानां तु सदा प्रीतिं च लप्स्यसे ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7000250136, "chapter_id": 20250, "verse_number": "१-४-१३७", "content_sanskrit": "वर्णानां तु भवान्शास्तावरोदत्तोमयातव ।\nतिष्ठ पुत्र यथाकामं सेव्यमानः सुरैर्द्दिवि ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}]