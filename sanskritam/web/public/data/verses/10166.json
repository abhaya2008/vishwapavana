[{"id": 6000166000, "chapter_id": 10166, "verse_number": null, "content_sanskrit": "अथ त्रयोदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000166001, "chapter_id": 10166, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.001.m4a", "display_order": 2}, {"id": 6000166002, "chapter_id": 10166, "verse_number": "८-१३-१", "content_sanskrit": "मन्वन्तरेषु भगवन् यथा मन्वादयस्त्विमे।\nयस्मिन् कर्मणि ये येन नियुक्तास्तद्वदस्व मे॥ ८/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.002.m4a", "display_order": 3, "topics": [{"text": "सर्वमन्वन्तरेष्वपि मन्वादीनां साधारणकर्मकथनम्", "range": "१–११"}]}, {"id": 6000166003, "chapter_id": 10166, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.003.m4a", "display_order": 4}, {"id": 6000166004, "chapter_id": 10166, "verse_number": "८-१३-२", "content_sanskrit": "मनवो मनुपुत्राश्च मुनयश्च महीपते।\nइन्द्राः सुरगणाश्चैव सर्वे पुरुषशासनाः॥ ८/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.004.m4a", "display_order": 5}, {"id": 6000166005, "chapter_id": 10166, "verse_number": "८-१३-३", "content_sanskrit": "यज्ञादयो याः कथिताः पौरुष्यस्तनवो नृप।\nमन्वादयो जगद्यात्रां नयन्त्याभिः प्रचोदिताः॥ ८/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.005.m4a", "display_order": 6}, {"id": 6000166006, "chapter_id": 10166, "verse_number": "८-१३-४", "content_sanskrit": "चतुर्युगान्ते कालेन ग्रस्तांच्छ्रुतिगणान् यथा।\nतपसा ऋषयोऽपश्यन् यतो धर्मः सनातनः॥ ८/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.006.m4a", "display_order": 7}, {"id": 6000166007, "chapter_id": 10166, "verse_number": "८-१३-५", "content_sanskrit": "ततो धर्मं चतुष्पादं मनवो हरिणोदिताः।\nयुक्ताः सञ्चारयन्त्यद्धा स्वे स्वे काले महीं नृपाः॥ ८/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.007.m4a", "display_order": 8}, {"id": 6000166008, "chapter_id": 10166, "verse_number": "८-१३-६", "content_sanskrit": "पालयन्ति प्रजापाला यावदन्तं विभागशः।\nयज्ञभागभुजो देवा ये च तत्रानुकीर्तिताः॥ ८/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.008.m4a", "display_order": 9}, {"id": 6000166009, "chapter_id": 10166, "verse_number": "८-१३-७", "content_sanskrit": "इन्द्रो भगवता दत्तां त्रैलोक्यश्रियमूर्जिताम्।\nभुञ्जानः पाति लोकांस्‍त्रीन् कामं लोके प्रवर्षति॥ ८/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.009.m4a", "display_order": 10}, {"id": 6000166010, "chapter_id": 10166, "verse_number": "८-१३-८", "content_sanskrit": "ज्ञानं चानुयुगं ब्रूते हरिः सिद्धस्वरूपधृक्।\nऋषिरूपधरः कर्म योगं योगेशरूपधृक्॥ ८/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.010.m4a", "display_order": 11}, {"id": 6000166011, "chapter_id": 10166, "verse_number": "८-१३-९", "content_sanskrit": "सर्गं प्रजेशरूपेण दस्यून् हन्ति स्वराड्वपुः।\nकालरूपेण सर्वेषामभावाय पृथग्गुणः॥ ८/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.011.m4a", "display_order": 12}, {"id": 6000166012, "chapter_id": 10166, "verse_number": "८-१३-१०", "content_sanskrit": "स्तूयमानो जनैरेभिर्माययाऽनामरूपया।\nविमोहितात्मभिर्नानादर्शनैर्न च दृश्यते॥ ८/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.012.m4a", "display_order": 13}, {"id": 6000166013, "chapter_id": 10166, "verse_number": "८-१३-११", "content_sanskrit": "एतत् कल्पविकल्पस्य प्रमाणं परिकीर्तितम्।\nयत्र मन्वन्तराण्याहुश्चतुर्दश पुराविदः॥ ८/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_013/BhP_08.013.013.m4a", "display_order": 14}, {"id": 6000166014, "chapter_id": 10166, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे त्रयोदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]