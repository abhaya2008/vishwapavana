[{"id": 6000239000, "chapter_id": 10239, "verse_number": null, "content_sanskrit": "अथ त्रिचत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000239001, "chapter_id": 10239, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.001.m4a", "display_order": 2}, {"id": 6000239002, "chapter_id": 10239, "verse_number": "१०-४३-१", "content_sanskrit": "पितरावुपलब्धार्थौ विदित्वा पुरुषोत्तमः।\nमा भूदिति निजां मायां ततान जनमोहिनीम्॥ १०/४३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णेन देवकीवसुदेवयोः सान्‍त्वनम्", "range": "१–१२"}]}, {"id": 6000239003, "chapter_id": 10239, "verse_number": "१०-४३-२", "content_sanskrit": "उवाच पितरावेत्य साग्रजः सात्वतर्षभः।\nप्रश्रयावनतः प्रीणन्नम्ब तातेति सादरम्॥ १०/४३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.003.m4a", "display_order": 4}, {"id": 6000239004, "chapter_id": 10239, "verse_number": "१०-४३-३", "content_sanskrit": "नास्मत्तो युवयोस्तात नित्योत्कण्ठितयोरपि।\nबाल्यपौगण्डकैशोराः पुत्राभ्यामगमन्क्‍वचित्॥ १०/४३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.004.m4a", "display_order": 5}, {"id": 6000239005, "chapter_id": 10239, "verse_number": "१०-४३-४", "content_sanskrit": "न लब्धो दैवहतयोर्वासो नौ भवदन्तिके।\nयां बालाः पितृगेहस्था विन्दन्ते लालिता मुदम्॥ १०/४३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.005.m4a", "display_order": 6}, {"id": 6000239006, "chapter_id": 10239, "verse_number": "१०-४३-५", "content_sanskrit": "सर्वार्थसम्भवो देहो जनितः पोषितो यतः।\nन तयोर्याति निर्वेशं पित्रोर्मर्त्यः शतायुषा॥ १०/४३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.006.m4a", "display_order": 7}, {"id": 6000239007, "chapter_id": 10239, "verse_number": "१०-४३-६", "content_sanskrit": "यस्तयोरात्मजः कल्प आत्मना च धनेन च।\nवृत्तिं न दद्यात् तं प्रेत्य स्वमांसं खादयन्ति हि॥ १०/४३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.007.m4a", "display_order": 8}, {"id": 6000239008, "chapter_id": 10239, "verse_number": "१०-४३-७", "content_sanskrit": "मातरं पितरं वृद्धं भार्यां साध्वीं सुतं शिशुम्।\nगुरुं विप्रं प्रपन्नं च कल्पोऽबिभ्रच्छ्वसन्मृतः॥ १०/४३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.008.m4a", "display_order": 9}, {"id": 6000239009, "chapter_id": 10239, "verse_number": "१०-४३-८", "content_sanskrit": "तन्नावकल्पयोः कंसान्नित्यमुद्विग्नचेतसोः।\nमोघमेते व्यतिक्रान्ता दिवसा वामनर्चतोः॥ १०/४३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.009.m4a", "display_order": 10}, {"id": 6000239010, "chapter_id": 10239, "verse_number": "१०-४३-९", "content_sanskrit": "तत् क्षन्तुमर्हथस्तात मातर्नौ परतन्त्रयोः।\nअकुर्वतोर्वां शुश्रूषां क्लिष्टयोर्दुर्हृदा भृशम्॥ १०/४३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.010.m4a", "display_order": 11}, {"id": 6000239011, "chapter_id": 10239, "verse_number": "१०-४३-१०", "content_sanskrit": "इति मायामनुष्यस्य हरेर्विश्वात्मनो गिरा।\nमोहितावङ्कमारोप्य परिष्वज्यापतुर्मुदम्॥ १०/४३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.011.m4a", "display_order": 12}, {"id": 6000239012, "chapter_id": 10239, "verse_number": "१०-४३-११", "content_sanskrit": "सिञ्चन्तावश्रुधाराभिः स्नेहपाशेन संवृतौ।\nन किञ्चिदूचतू राजन् बाष्पकण्ठौ विमोहितौ॥ १०/४३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.012.m4a", "display_order": 13}, {"id": 6000239013, "chapter_id": 10239, "verse_number": "१०-४३-१२", "content_sanskrit": "एवमाश्वास्य पितरौ भगवान् देवकीसुतः।\nमातामहं तूग्रसेनं यदूनामकरोन्नृपम्॥ १०/४३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.013.m4a", "display_order": 14}, {"id": 6000239014, "chapter_id": 10239, "verse_number": "१०-४३-१३", "content_sanskrit": "आह चास्मान् महराज प्रजाः स्वाज्ञप्तुमर्हसि।\nययातिशापाद् यदुभिर्नासितव्यं नृपासने॥ १०/४३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.014.m4a", "display_order": 15, "topics": [{"text": "उग्रसेनस्य राज्येऽभिषेकः", "range": "१३–१९"}]}, {"id": 6000239015, "chapter_id": 10239, "verse_number": "१०-४३-१४", "content_sanskrit": "मयि भृत्य उपासीने भवतो विबुधादयः।\nबलिं हरन्त्यवनताः किमुतान्ये नराधिपाः॥ १०/४३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.015.m4a", "display_order": 16}, {"id": 6000239016, "chapter_id": 10239, "verse_number": "१०-४३-१५", "content_sanskrit": "सर्वान् स्वज्ञातिसम्बन्धान् दिग्भ्यः कंसभयाद् गतान्।\nयदुवृष्ण्यन्धकमधुदाशार्हकुकरार्हकान्॥ १०/४३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.016.m4a", "display_order": 17}, {"id": 6000239017, "chapter_id": 10239, "verse_number": "१०-४३-१६", "content_sanskrit": "सभाजितान् समाश्वास्य विदेशावासकर्शितान्।\nन्यवासयत् स्वगेहेषु वित्तैः सन्तर्प्य विश्वसृक्॥ १०/४३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.017.m4a", "display_order": 18}, {"id": 6000239018, "chapter_id": 10239, "verse_number": "१०-४३-१७", "content_sanskrit": "कृष्णसङ्कर्षणभुजैर्गुप्ता लब्धमनोरथाः।\nगेहेषु रेमिरे सिद्धाः कृष्णरामगतज्वराः॥ १०/४३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.018.m4a", "display_order": 19}, {"id": 6000239019, "chapter_id": 10239, "verse_number": "१०-४३-१८", "content_sanskrit": "वीक्षन्तोऽहरहः प्रीता मुकुन्दवदनाम्बुजम्।\nनित्यप्रमुदितं श्रीमत्सदयस्मितवीक्षणम्॥ १०/४३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.019.m4a", "display_order": 20}, {"id": 6000239020, "chapter_id": 10239, "verse_number": "१०-४३-१९", "content_sanskrit": "तत्र प्रवयसोऽप्यासन् युवानोऽतिबलौजसः।\nपिबन्तोऽक्षैर्मुकुन्दस्य मुखाम्बुजसुधां मुहुः॥ १०/४३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.020.m4a", "display_order": 21}, {"id": 6000239021, "chapter_id": 10239, "verse_number": "१०-४३-२०", "content_sanskrit": "अथ नन्दं समासाद्य भगवान् देवकीसुतः।\nसङ्कर्षणश्च राजेन्द्र परिष्वज्येदमूचतुः॥ १०/४३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.021.m4a", "display_order": 22, "topics": [{"text": "यशोदानन्दयोः सान्‍त्वनम्", "range": "२०–२५"}]}, {"id": 6000239022, "chapter_id": 10239, "verse_number": "१०-४३-२१", "content_sanskrit": "पितर्युवाभ्यां स्निग्धाभ्यां पोषितौ लालितौ भृशम्।\nपित्रोरभ्यधिका प्रीतिरात्मजेष्वात्मनोऽपि हि॥ १०/४३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.022.m4a", "display_order": 23}, {"id": 6000239023, "chapter_id": 10239, "verse_number": "१०-४३-२२", "content_sanskrit": "स पिता सा च जननी यौ पुष्णीतां स्वपुत्रवत्।\nशिशून् बन्धुभिरुत्सृष्टानकल्पैः पोषरक्षणे॥ १०/४३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.023.m4a", "display_order": 24}, {"id": 6000239024, "chapter_id": 10239, "verse_number": "१०-४३-२३", "content_sanskrit": "यात यूयं व्रजं तात वयं च स्नेहदुःखितान्।\nज्ञातीन् नो द्रष्टुमेष्यामो विधाय सुहृदां सुखम्॥ १०/४३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.024.m4a", "display_order": 25}, {"id": 6000239025, "chapter_id": 10239, "verse_number": "१०-४३-२४", "content_sanskrit": "एवं सान्त्वय्य भगवान् नन्दं सव्रजमच्युतः।\nवासोऽलङ्कारकुप्याग्रैरर्हयामास सादरम्॥ १०/४३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.025.m4a", "display_order": 26}, {"id": 6000239026, "chapter_id": 10239, "verse_number": "१०-४३-२५", "content_sanskrit": "इत्युक्तस्तौ परिष्वज्य नन्दः प्रणयविह्वलः।\nपूरयन्नश्रुभिर्नेत्रे सह गोपैर्व्रजं ययौ॥ १०/४३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.026.m4a", "display_order": 27}, {"id": 6000239027, "chapter_id": 10239, "verse_number": "१०-४३-२६", "content_sanskrit": "अथ शूरसुतो राजन् पुत्रयोः समकारयत्।\nपुरोधसा ब्राह्मणैश्च यथावद् द्विजसंस्कृतिम्॥ १०/४३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.027.m4a", "display_order": 28, "topics": [{"text": "श्रीकृष्णरामयोरुपनयनम्", "range": "२६–३०"}]}, {"id": 6000239028, "chapter_id": 10239, "verse_number": "१०-४३-२७", "content_sanskrit": "तेभ्योऽदाद्दक्षिणां गावो रुग्ममालाः स्वलङ्कृताः।\nस्वलङ्कृतेभ्यः सम्पूज्य सवत्साः क्षौममालिनीः॥ १०/४३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.028.m4a", "display_order": 29}, {"id": 6000239029, "chapter_id": 10239, "verse_number": "१०-४३-२८", "content_sanskrit": "याः कृष्णरामजन्मर्क्षे मनोदत्ता महामतिः।\nताश्चाददादनुस्मृत्य कंसेनाधर्मतो हृताः॥ १०/४३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.029.m4a", "display_order": 30}, {"id": 6000239030, "chapter_id": 10239, "verse_number": "१०-४३-२९", "content_sanskrit": "ततश्च लब्धसंस्कारौ द्विजत्वं प्राप्य सुव्रतौ।\nगर्गाद् यदुकुलाचार्याद् गायत्रं व्रतमास्थितौ॥ १०/४३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.030.m4a", "display_order": 31}, {"id": 6000239031, "chapter_id": 10239, "verse_number": "१०-४३-३०", "content_sanskrit": "प्रभवौ सर्वविद्यानां सर्वज्ञौ जगदीश्वरौ।\nनान्यसिद्धामलं ज्ञानं गूहमानौ नरेहितैः॥ १०/४३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.031.m4a", "display_order": 32}, {"id": 6000239032, "chapter_id": 10239, "verse_number": "१०-४३-३१", "content_sanskrit": "अथो गुरुकुले वासमिच्छन्तावुपजग्मतुः।\nकाश्यं सान्दीपनिं नाम अवन्तिपुरवासिनम्॥ १०/४३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.032.m4a", "display_order": 33, "topics": [{"text": "तयोस्सान्दीपन्याचार्याद्विद्याभ्यासः", "range": "३१–३६"}]}, {"id": 6000239033, "chapter_id": 10239, "verse_number": "१०-४३-३२", "content_sanskrit": "यथोपसाद्य तौ दान्तौ गुरौ वृत्तिमनिन्दिताम्।\nग्राहयन्तावुपेतौ स्म भक्त्या देवमिवादृतौ॥ १०/४३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.033.m4a", "display_order": 34}, {"id": 6000239034, "chapter_id": 10239, "verse_number": "१०-४३-३३", "content_sanskrit": "तयोर्द्विजवरस्तुष्टः शुद्धभावानुवृत्तिभिः।\nप्रोवाच वेदानखिलान् साङ्गोपनिषदो गुरुः॥ १०/४३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.034.m4a", "display_order": 35}, {"id": 6000239035, "chapter_id": 10239, "verse_number": "१०-४३-३४", "content_sanskrit": "सरहस्यं धनुर्वेदं धर्मन्यायपथांस्तथा।\nतथा चान्वीक्षिकीं विद्यां राजनीतिं च षड्विधाम्॥ १०/४३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.035.m4a", "display_order": 36}, {"id": 6000239036, "chapter_id": 10239, "verse_number": "१०-४३-३५", "content_sanskrit": "सर्वं तदमरश्रेष्ठौ सर्वविद्याप्रवर्तकौ।\nसकृन्निगदमात्रेण तौ सञ्जगृहतुर्नृप॥ १०/४३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.036.m4a", "display_order": 37}, {"id": 6000239037, "chapter_id": 10239, "verse_number": "१०-४३-३६", "content_sanskrit": "अहोरात्रैश्चतुःषष्ट्या संयातौ तावतीः कलाः।\nगुरुदक्षिणयाऽऽचार्यं छन्दयामासतुर्नृप॥ १०/४३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.037.m4a", "display_order": 38}, {"id": 6000239038, "chapter_id": 10239, "verse_number": "१०-४३-३७", "content_sanskrit": "द्विजस्तयोस्तं महिमानमद्भुतं संलक्ष्य राजन्नतिमानुषीं मतिम्।\nसम्मन्त्र्य पत्न्या स महार्णवे मृतं बालं प्रभासे वरयाम्बभूव ह॥ १०/४३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.038.m4a", "display_order": 39, "topics": [{"text": "श्रीकृष्णेन मृतगुरुपुत्रानयनम्", "range": "३७–५१"}]}, {"id": 6000239039, "chapter_id": 10239, "verse_number": "१०-४३-३८", "content_sanskrit": "तथेत्यथारुह्य महारथौ रथं प्रभासमासाद्य दुरन्तविक्रमौ।\nवेलामुपव्रज्य निषीदतुः क्षणं सिन्धुर्विदित्वाऽर्हणमाहरत् तयोः॥ १०/४३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.039.m4a", "display_order": 40}, {"id": 6000239040, "chapter_id": 10239, "verse_number": "१०-४३-३९", "content_sanskrit": "तमाह भगवानाशु गुरुपुत्रः प्रदीयताम्।\nयोऽसाविह त्वया ग्रस्तो बालको महतोर्मिणा॥ १०/४३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.040.m4a", "display_order": 41}, {"id": 6000239041, "chapter_id": 10239, "verse_number": "१०-४३-४०", "content_sanskrit": "तमाह वरुणो देवो विनयावनतः स्थितः।\nन चाहार्षमहं देव दैत्यः पञ्चजनोऽहरत्॥ १०/४३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.041.m4a", "display_order": 42}, {"id": 6000239042, "chapter_id": 10239, "verse_number": "१०-४३-४१", "content_sanskrit": "अन्तर्जलचरः कृष्ण शङ्खरूपधरोऽसुरः।\nजलमाविश्य तं हत्वा गृह्यतामित्युवाच सः॥ १०/४३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.042.m4a", "display_order": 43}, {"id": 6000239043, "chapter_id": 10239, "verse_number": "१०-४३-४२", "content_sanskrit": "ततस्स जलमाविश्य हत्वाऽन्तर्जलवासिनम्। विदार्य जठरं तस्य नापश्यदुदरेऽर्भकम्।\nतदङ्गप्रभवं शङ्खमादाय रथमागमत्॥ १०/४३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.043.m4a", "display_order": 44}, {"id": 6000239044, "chapter_id": 10239, "verse_number": "१०-४३-४३", "content_sanskrit": "ततः संयमनीं नाम यमस्य दयितां पुरीम्।\nगत्वा जनार्दनः शङ्खं प्रदध्मौ सहलायुधः॥ १०/४३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.044.m4a", "display_order": 45}, {"id": 6000239045, "chapter_id": 10239, "verse_number": "१०-४३-४४", "content_sanskrit": "शङ्खनिर्ह्रादमाकर्ण्य प्रजासंयमनो यमः।\nतयोः सपर्यां महतीं चक्रे भक्त्युपबृंहितः॥ १०/४३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.045.m4a", "display_order": 46}, {"id": 6000239046, "chapter_id": 10239, "verse_number": "१०-४३-४५", "content_sanskrit": "उवाचावनतः कृष्णं सर्वभूताशयालयम्। लीलामनुष्य हे विष्णो युवयोः करवाम किम्।\nइत्युक्तस्तेन देवेशो देवकीनन्दनोऽब्रवीत्॥ १०/४३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.046.m4a", "display_order": 47}, {"id": 6000239047, "chapter_id": 10239, "verse_number": null, "content_sanskrit": "श्री भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.047.m4a", "display_order": 48}, {"id": 6000239048, "chapter_id": 10239, "verse_number": "१०-४३-४६", "content_sanskrit": "गुरुपुत्रमिहानीतं निजकर्मनिबन्धनम्।\nआनयस्व महाराज मच्छासनपुरस्कृतः॥ १०/४३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.048.m4a", "display_order": 49}, {"id": 6000239049, "chapter_id": 10239, "verse_number": "१०-४३-४७", "content_sanskrit": "तथेति तेनोपनीतं गुरुपुत्रं यदूत्तमौ।\nदत्वा स्वगुरवे भूयो वृणीष्वेति तमूचतुः॥ १०/४३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.049.m4a", "display_order": 50}, {"id": 6000239050, "chapter_id": 10239, "verse_number": "१०-४३-४८", "content_sanskrit": "ततः प्रीतमना राजन्निदं वचनमब्रवीत्।\nसान्दीपनिर्महाभागो रामकृष्णावरिन्दमौ॥ १०/४३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.050.m4a", "display_order": 51}, {"id": 6000239051, "chapter_id": 10239, "verse_number": "१०-४३-४९", "content_sanskrit": "सम्यक् सम्पादिता वत्सौ भवद्भ्यां गुरुनिष्क्रिया। को नु युष्मद्विधगुरोः कामानामवशिष्यते।\nगच्छतं स्वगृहं वीरौ कीर्तिर्वामस्तु पावनी॥ १०/४३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.051.m4a", "display_order": 52}, {"id": 6000239052, "chapter_id": 10239, "verse_number": "१०-४३-५०", "content_sanskrit": "गुरुणैवमनुज्ञातौ रथेनानिलरंहसा।\nआयातौ स्वपुरं तात पर्जन्यनिनदेन वै॥ १०/४३/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.052.m4a", "display_order": 53}, {"id": 6000239053, "chapter_id": 10239, "verse_number": "१०-४३-५१", "content_sanskrit": "समनन्दन् प्रजाः सर्वा दृष्ट्वा रामजनार्दनौ।\nअपश्यन्त्यो बह्वहानि नष्टलब्धधना इव॥ १०/४३/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_043/BhP_10.043.053.m4a", "display_order": 54}, {"id": 6000239054, "chapter_id": 10239, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे त्रिचत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]