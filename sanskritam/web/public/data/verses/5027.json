[{"id": 2189645, "chapter_id": 5027, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2189646, "chapter_id": 5027, "verse_number": "१", "content_sanskrit": "यदिदं वेदवचनं कुरु कर्म त्यजेति च ।\nकां दिशं विद्यया यान्ति कां च गच्छन्ति कर्मणा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2189647, "chapter_id": 5027, "verse_number": "२", "content_sanskrit": "एतद्वै श्रोतुमिच्छामि तद्भवान् प्रब्रवीतु मे ।\nएतत्त्वन्योन्यवैरूप्ये वर्तते प्रतिकूलतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2189648, "chapter_id": 5027, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2189649, "chapter_id": 5027, "verse_number": "३", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं पराशरसुतः सुतम् ।\nकर्मविद्यामयावेतौ व्याख्यास्यामि क्षराक्षरौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2189650, "chapter_id": 5027, "verse_number": "४", "content_sanskrit": "यां दिशं विद्यया यान्ति यां च गच्छन्ति कर्मणा ।\nशृणुष्वैकमनाः पुत्र गह्वरं ह्येतदन्तरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2189651, "chapter_id": 5027, "verse_number": "५", "content_sanskrit": "अस्ति धर्म इति प्रोक्तं नास्तीत्यत्रैव यो वदेत् ।\nतस्य पक्षस्य सदृशमिदं मम भवेदथ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2189652, "chapter_id": 5027, "verse_number": "६", "content_sanskrit": "द्वाविमावथ पन्थानौ यत्र वेदाः प्रतिष्ठिताः ।\nप्रवृत्तिलक्षणो धर्मो निवृत्तौ च सुभाषितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2189653, "chapter_id": 5027, "verse_number": "७", "content_sanskrit": "कर्मणा बद्ध्यते जन्तुर्विद्यया तु प्रमुच्यते ।\nतस्मात् कर्म न कुर्वन्ति यतयः पारदर्शिनः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2189654, "chapter_id": 5027, "verse_number": "८", "content_sanskrit": "कर्मणा जायते प्रेत्य मूर्तिमान् षोडशात्मकः ।\nविद्यया जायते नित्यमव्ययो ह्यव्ययात्मकः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2189655, "chapter_id": 5027, "verse_number": "९", "content_sanskrit": "कर्म त्वेके प्रशंसन्ति स्वल्पबुद्धितरा नराः ।\nतेन ते देहजालानि रमयन्त उपासते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2189656, "chapter_id": 5027, "verse_number": "१०", "content_sanskrit": "ये तु बुद्धिं परां प्राप्ता धर्मनैपुण्यदर्शिनः ।\nन ते कर्म प्रशंसन्ति कूपं नद्यां पिबन्निव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2189657, "chapter_id": 5027, "verse_number": "११", "content_sanskrit": "कर्मणः फलमाप्नोति सुखदुःखे भवाभवौ ।\nविद्यया तदवाप्नोति यत्र गत्वा न शोचति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2189658, "chapter_id": 5027, "verse_number": "१२", "content_sanskrit": "यत्र गत्वा न म्रियते यत्र गत्वा न जायते ।\nन जीर्यते यत्र गत्वा यत्र गत्वा न वर्धते \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2189659, "chapter_id": 5027, "verse_number": "१३", "content_sanskrit": "यत्र तद्ब्रह्म परममव्यक्तमजरं ध्रुवम् ।\nअव्याहतमनायासममृतं चावियोगि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2189660, "chapter_id": 5027, "verse_number": "१४", "content_sanskrit": "द्वन्द्वैर्यत्र न बाध्यन्ते मानसेन च कर्मणा ।\nसमाः सर्वत्र मैत्राश्च सर्वभूतहिते रताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2189661, "chapter_id": 5027, "verse_number": "१५", "content_sanskrit": "विद्यामयोऽन्यः पुरुषस्तात कर्ममयोऽपरः ।\nविद्धि चन्द्रमसं दर्शे सूक्ष्मया कलया स्थितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2189662, "chapter_id": 5027, "verse_number": "१६", "content_sanskrit": "तदेतदृषिणा प्रोक्तं विस्तरेणानुमीयते ।\nनवजं शशिनं दृष्ट्वा वक्रं तन्तुमिवाम्बरे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2189663, "chapter_id": 5027, "verse_number": "१७", "content_sanskrit": "एकादशविकारात्मा कलासम्भारसम्भृतः ।\nमूर्तिमानिति तं विद्धि तात कर्मगुणात्मकम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2189664, "chapter_id": 5027, "verse_number": "१८", "content_sanskrit": "तस्मिन् यः संस्थितो ह्यग्निर्नित्यं स्थाल्यामिवाहितः ।\nआत्मानं तं विजानीहि नित्यं त्यागजितात्मकम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2189665, "chapter_id": 5027, "verse_number": "१९", "content_sanskrit": "तमो रजश्च सत्त्वं च विद्धि जीवगुणानिमान् ।\nजीवमात्मगुणं विद्यादात्मानं परमात्मनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2189666, "chapter_id": 5027, "verse_number": "२०", "content_sanskrit": "अचेतनं जीवगुणं वदन्ति\nस चेष्टते चेष्टयते च सर्वम् ।\nततः परं क्षेत्रविदो वदन्ति\nप्रावर्तयद्यो भुवनानि सप्त\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2189667, "chapter_id": 5027, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे षट्सप्ततितमोऽध्यायः ॥७६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]