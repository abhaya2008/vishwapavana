[{"id": 5000570000, "chapter_id": 9570, "verse_number": "७-३५-१", "content_sanskrit": "अपृच्छत तदा रामो दक्षिणाशाश्रमं मुनिम् ।\nप्राञ्जलिर्विनयोपेत इदमाह वचो ऽर्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000570001, "chapter_id": 9570, "verse_number": "७-३५-२", "content_sanskrit": "अतुलं बलमेतद्वै वालिनो रावणस्य च ।\nन त्वेताभ्यां हनुमता समं त्विति मतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000570002, "chapter_id": 9570, "verse_number": "७-३५-३", "content_sanskrit": "शौर्यं दाक्ष्यं बलं धैर्यं प्राज्ञता नयसाधनम् ।\nविक्रमश्च प्रभावश्च हनूमति कृतालयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000570003, "chapter_id": 9570, "verse_number": "७-३५-४", "content_sanskrit": "दृष्ट्वैव सागरं वीक्ष्य सीदन्तीं कपिवाहिनीम् ।\nसमाश्वास्य महाबाहुर्योजनानां शतं प्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000570004, "chapter_id": 9570, "verse_number": "७-३५-५", "content_sanskrit": "धर्षयित्वा पुरीं लङ्कां रावणान्तःपुरं तदा ।\nदृष्ट्वा सम्भाषिता चापि सीता ह्याश्वासिता तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000570005, "chapter_id": 9570, "verse_number": "७-३५-६", "content_sanskrit": "सेनाग्रगा मन्त्रिसुताः किङ्करा रावणात्मजः ।\nएते हनुमता तत्र ह्येकेन वितिपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000570006, "chapter_id": 9570, "verse_number": "७-३५-७", "content_sanskrit": "भूयो बन्धाद्विमुक्तेन भाषयित्वा दशाननम् ।\nलङ्का भस्मीकृता येन पावकेनेव मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000570007, "chapter_id": 9570, "verse_number": "७-३५-८", "content_sanskrit": "न कालस्य न शक्रस्य न विष्णोर्वित्तपस्य च ।\nकर्माणि तानि श्रूयन्ते यानि युद्धे हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000570008, "chapter_id": 9570, "verse_number": "७-३५-९", "content_sanskrit": "एतस्य बाहुवीर्येण लङ्का सीता च लक्ष्मणः ।\nप्राप्ता मया जयश्चैव राज्यं मित्राणि बान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000570009, "chapter_id": 9570, "verse_number": "७-३५-१०", "content_sanskrit": "हनूमान्यदि मे नः स्याद्वानराधिपतेः सखा ।\nप्रवृत्तिमपि को वेत्तुं जानक्याः शक्तिमान्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000570010, "chapter_id": 9570, "verse_number": "७-३५-११", "content_sanskrit": "किमर्थं वाल्यनेनैव सुग्रीवप्रियकाम्यया ।\nतदा वैरे समुत्पन्ने न दग्धो वीरुधो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000570011, "chapter_id": 9570, "verse_number": "७-३५-१२", "content_sanskrit": "नहि वेदितवान्मन्ये हनूमानात्मनो बलम् ।\nयद्दृष्टवाञ्जीवितेष्टं क्लिश्यन्तं वानराधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000570012, "chapter_id": 9570, "verse_number": "७-३५-१३", "content_sanskrit": "एतन्मे भगवन्सर्वं हनूमति महामतौ ।\nविस्तरेण यथातत्त्वं कथयामरपूजित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000570013, "chapter_id": 9570, "verse_number": "७-३५-१४", "content_sanskrit": "राघवस्य वचः श्रुत्वा हेतुयुक्तमृषिस्तदा ।\nहनूमतः समक्षं तमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000570014, "chapter_id": 9570, "verse_number": "७-३५-१५", "content_sanskrit": "सत्यमेतद्रघुश्रेष्ठ यद्ब्रवीषि हनूमतः ।\nन बले विद्यते तुल्यो न गतौ न मतौ परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000570015, "chapter_id": 9570, "verse_number": "७-३५-१६", "content_sanskrit": "अमोघशापैः शप्तस्तु दत्तो ऽस्य मुनिभिः पुरा ।\nन वेत्ता हि बलं येन बली सन्निरिमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000570016, "chapter_id": 9570, "verse_number": "७-३५-१७", "content_sanskrit": "बाल्ये ऽप्येतेन यत्कर्म कृतं राम महाबल ।\nतन्न वर्णयितुं शक्यमिति बालतया ऽ ऽस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000570017, "chapter_id": 9570, "verse_number": "७-३५-१८", "content_sanskrit": "यदि वा ऽस्ति त्वभिप्रायस्तच्छ्रोतुं तव राघव ।\nसमाधाय मतिं राम निशामय वदाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000570018, "chapter_id": 9570, "verse_number": "७-३५-१९", "content_sanskrit": "सूर्यदत्तवरस्वर्णः सुमेरुर्नाम पर्वतः ।\nयत्र राज्यं प्रशास्त्यस्य केसरी नाम वै पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000570019, "chapter_id": 9570, "verse_number": "७-३५-२०", "content_sanskrit": "तस्य भार्या बभूवैषा ह्यञ्जनेति परिश्रुता ।\nजनयामास तस्यां वै वायुरात्मजमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000570020, "chapter_id": 9570, "verse_number": "७-३५-२१", "content_sanskrit": "शालिशूकनिभाभासं प्रासूतामुं तदा ऽञ्जना ।\nफलान्याहर्तुकामा वै निष्क्रान्ता गहनेचरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000570021, "chapter_id": 9570, "verse_number": "७-३५-२२", "content_sanskrit": "एष मातुर्वियोगाच्च क्षुधया च भृशार्दितः ।\nरुरोद शिशुरत्यर्थं शिशुः शरवणे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000570022, "chapter_id": 9570, "verse_number": "७-३५-२३", "content_sanskrit": "तदोद्यन्तं विवस्वन्तं जपापुष्पोत्करोपमम् ।\nददर्श फललोभाच्च ह्युत्पपात रविं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000570023, "chapter_id": 9570, "verse_number": "७-३५-२४", "content_sanskrit": "बालार्काभिमुखो बालो बालार्क इव मूर्तिमान् ।\nग्रहीतुकामो बालार्कं प्लवते ऽम्बरमध्यगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000570024, "chapter_id": 9570, "verse_number": "७-३५-२५", "content_sanskrit": "एतस्मिन्प्लवमाने तु शिशुभावे हनूमति ।\nदेवदानवयक्षाणां विस्मयः सुमहानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000570025, "chapter_id": 9570, "verse_number": "७-३५-२६", "content_sanskrit": "नाप्येवं वेगवान्वायुर्गरुडो वा मनस्तथा ।\nयथा ऽयं वायुपुत्रस्तु क्रमते ऽम्बरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000570026, "chapter_id": 9570, "verse_number": "७-३५-२७", "content_sanskrit": "यदि तावच्छिशोरस्य त्वीदृशो गतिविक्रमः ।\nयौवनं बलमासाद्य कथं वेगो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000570027, "chapter_id": 9570, "verse_number": "७-३५-२८", "content_sanskrit": "तमनुप्लवते वायुः प्लवन्तं पुत्रमात्मनः ।\nसूर्यदाहभयाद्रक्षंस्तुषारचयशीतलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000570028, "chapter_id": 9570, "verse_number": "७-३५-२९", "content_sanskrit": "बहुयोजनसाहस्रं क्रमत्येष गतोम्बरम् ।\nपितुर्बलाच्च बाल्याच्च भास्कराभ्याशमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000570029, "chapter_id": 9570, "verse_number": "७-३५-३०", "content_sanskrit": "शिशुरेष त्वदोषज्ञ इति मत्वा दिवाकरः ।\nकार्यं चात्र समायत्तमित्येवं न ददाह सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000570030, "chapter_id": 9570, "verse_number": "७-३५-३१", "content_sanskrit": "यमेव दिवसं ह्येष ग्रहीतुं भास्करं प्लुतः ।\nतमेव दिवसं राहुर्जिघृक्षति दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000570031, "chapter_id": 9570, "verse_number": "७-३५-३२", "content_sanskrit": "अनेन स परामृष्टो राम सूर्यरथोपरि ।\nअपक्रान्तस्ततस्त्रस्तो राहुश्चन्द्रार्कमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000570032, "chapter_id": 9570, "verse_number": "७-३५-३३", "content_sanskrit": "स इन्द्रभवनं गत्वा सरोषः सिंहिकासुतः ।\nअब्रवीद्भ्रुकुटिं कृत्वा देवं देवगणैर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000570033, "chapter_id": 9570, "verse_number": "७-३५-३४", "content_sanskrit": "बुभुक्षापनयं दत्त्वा चन्द्रार्कौ मम वासव ।\nकिमिदं तत्त्वया दत्तमन्यस्य बलवृत्रहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000570034, "chapter_id": 9570, "verse_number": "७-३५-३५", "content_sanskrit": "अद्याहं पर्वकाले तु जिघृक्षुः सूर्यमागतः ।\nअथान्यो राहुरासाद्य जग्राह सहसा रविम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000570035, "chapter_id": 9570, "verse_number": "७-३५-३६", "content_sanskrit": "स राहोर्वचनं श्रुत्वा वासवः सम्भ्रमान्वितः ।\nउत्पपातासनं हित्वा चोद्वहन्काञ्चनीं स्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000570036, "chapter_id": 9570, "verse_number": "७-३५-३७", "content_sanskrit": "ततः कैलासकूटाभं चतुर्दन्तं मदस्रवम् ।\nशृङ्गारधारिणं प्रांशुं स्वर्णघण्टाट्टहासिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000570037, "chapter_id": 9570, "verse_number": "७-३५-३८", "content_sanskrit": "इन्द्रः करीन्द्रमारुह्य राहुं कृत्वा पुरःसरम् ।\nप्रायाद्यत्राभवत्सूर्यः सहानेन हनूमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000570038, "chapter_id": 9570, "verse_number": "७-३५-३९", "content_sanskrit": "अथातिरभसेनागाद्राहुरुत्सृज्य वासवम् ।\nअनेन च स वै दृष्टः प्रधावञ्छैलकूटवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000570039, "chapter_id": 9570, "verse_number": "७-३५-४०", "content_sanskrit": "ततः सूर्यं समुत्सृज्य राहुं फलमवेक्ष्य च ।\nउत्पपात पुनर्व्योम ग्रहीतुं सिंहिकासुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000570040, "chapter_id": 9570, "verse_number": "७-३५-४१", "content_sanskrit": "उत्सृज्यार्कमिमं राम प्रधावन्तं प्लवङ्गमम् ।\nअवेक्ष्यैवं परावृत्त्य मुखशेषः पराङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000570041, "chapter_id": 9570, "verse_number": "७-३५-४२", "content_sanskrit": "इन्द्रमाशंसमानस्तु त्रातारं सिंहिकासुतः ।\nइन्द्र इन्द्रेति संत्रासान्मुहुर्महुरभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000570042, "chapter_id": 9570, "verse_number": "७-३५-४३", "content_sanskrit": "राहोर्विक्रोशमानस्य प्रागेवालक्षितं स्वरम् ।\nश्रुत्वेन्द्रोवाच मा भैषीरहमेनं निषूदये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000570043, "chapter_id": 9570, "verse_number": "७-३५-४४", "content_sanskrit": "ऐरावतं ततो दृष्ट्वा महत्तदिदमित्यपि ।\nफलं मत्वा हस्तिराजमभिदुद्राव मारुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000570044, "chapter_id": 9570, "verse_number": "७-३५-४५", "content_sanskrit": "तथास्य धावतो रूपमैरावतजिघृक्षया ।\nमुहूर्तमभवद्घोरमिन्द्राग्न्योरिव भास्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000570045, "chapter_id": 9570, "verse_number": "७-३५-४६", "content_sanskrit": "एवमाधावमानं तु नातिक्रुद्धः शचीपतिः ।\nहस्तान्तादतिमुक्तेन कुलिशेनाभ्यताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000570046, "chapter_id": 9570, "verse_number": "७-३५-४७", "content_sanskrit": "ततो गिरौ पपातैष इन्द्रवज्राभिताडितः ।\nपतमानस्य चैतस्य वामो हनुरभज्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000570047, "chapter_id": 9570, "verse_number": "७-३५-४८", "content_sanskrit": "तस्मिंस्तु पतिते बाले वज्रताडनविह्वले ।\nचुक्रोधेन्द्राय पवनः प्रजानामहिताय सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000570048, "chapter_id": 9570, "verse_number": "७-३५-४९", "content_sanskrit": "प्रचारं स तु सङ्गृह्य प्रजास्वन्तर्गतः प्रभुः ।\nगुहां प्रविष्टः स्वसुतं शिशुमादाय मारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000570049, "chapter_id": 9570, "verse_number": "७-३५-५०", "content_sanskrit": "विण्मूत्राशयमावृत्य प्रजानां परमार्तिकृत् ।\nरुरोध सर्वभूतानि यथा वर्षाणि वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000570050, "chapter_id": 9570, "verse_number": "७-३५-५१", "content_sanskrit": "वायुप्रकोपाद्भूतानि निरुच्छ्वासानि सर्वतः ।\nसन्धिभिर्भिद्यमानैश्च काष्ठभूतानि जज्ञिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000570051, "chapter_id": 9570, "verse_number": "७-३५-५२", "content_sanskrit": "निःस्वाध्यायवषट्कारं निष्क्रियं धर्मवर्जितम् ।\nवायुप्रकोपात्ऺत्रैलोक्यं निरयस्थमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000570052, "chapter_id": 9570, "verse_number": "७-३५-५३", "content_sanskrit": "ततः प्रजाः सगन्धर्वाः सदेवासुरमानुषाः ।\nप्रजापतिं समाधावन्दुःखिताश्च सुखेच्छया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000570053, "chapter_id": 9570, "verse_number": "७-३५-५४", "content_sanskrit": "ऊचुः प्राञ्जलयो देवा महोदरनिभोदराः ।\nत्वया नु भगवन्सृष्टाः प्रजानाथ चतुर्विधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000570054, "chapter_id": 9570, "verse_number": "७-३५-५५", "content_sanskrit": "त्वया दत्तो ऽयमस्माकमायुषः पवनः पतिः ।\nसो ऽस्मान्प्राणेश्वरो भूत्वा कस्मादेषो ऽद्य सत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000570055, "chapter_id": 9570, "verse_number": "७-३५-५६", "content_sanskrit": "रुरोध दुःखं जनयन्नन्तःपुर इव स्त्रियः ।\nतस्मात्त्वां शरणं प्राप्ता वायुनोहता वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000570056, "chapter_id": 9570, "verse_number": "७-३५-५७", "content_sanskrit": "एतत्प्रजानां श्रुत्वा तु प्रजानाथः प्रजापतिः ।\nकारणादिति चोक्त्वासौ प्रजाः पुनरभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000570057, "chapter_id": 9570, "verse_number": "७-३५-५८", "content_sanskrit": "यस्मिंश्च कारणे वायुश्चुक्रोध च रुरोध च ।\nप्रजाः शृणुध्वं तत्सर्वं श्रोतव्यं चात्मनः क्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000570058, "chapter_id": 9570, "verse_number": "७-३५-५९", "content_sanskrit": "पुत्रस्तस्यामरेशेन इन्द्रेणाद्य निपातितः ।\nराहोर्वचनमास्थाय ततः स कुपितो ऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000570059, "chapter_id": 9570, "verse_number": "७-३५-६०", "content_sanskrit": "अशरीरः शरीरेषु वायुश्चरति पालयन् ।\nशरीरं हि विना वायुं समतां याति दारुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000570060, "chapter_id": 9570, "verse_number": "७-३५-६१", "content_sanskrit": "वायुः प्राणः सुखं वायुर्वायुः सर्वमिदं जगत् ।\nवायुना सम्परित्यक्तं न सुखं विन्दते जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000570061, "chapter_id": 9570, "verse_number": "७-३५-६२", "content_sanskrit": "अद्यैव च परित्यक्तं वायुना जगदायुषा ।\nअद्यैव ते निरुच्छ्वासाः काष्ठकुड्योपमाः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000570062, "chapter_id": 9570, "verse_number": "७-३५-६३", "content_sanskrit": "तद्यामस्तत्र यत्रास्ते मारुतो रुक्प्रदो हि नः ।\nमा विनाशं गमिष्याम अप्रसाद्यादितेः सुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000570063, "chapter_id": 9570, "verse_number": "७-३५-६४", "content_sanskrit": "ततः प्रजाभिः सहितः प्रजापतिः सदेवगन्धर्वभुजङ्गगुह्यकैः ।\nजगाम तत्रास्यति यत्र मारुतः सुतं सुरेन्द्राभिहतं प्रगृह्य सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000570064, "chapter_id": 9570, "verse_number": "७-३५-६५", "content_sanskrit": "ततो ऽर्कवैश्वानरकाञ्चनप्रभं सुतं तदोत्सङ्गगतं सदागतेः ।\nचतुर्मुखो वीक्ष्य कृपामथाकरोत्सदेवगन्धर्वर्षियक्षराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000570065, "chapter_id": 9570, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पंचत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]