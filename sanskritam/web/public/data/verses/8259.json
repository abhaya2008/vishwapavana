[{"id": 900002203, "chapter_id": 8259, "verse_number": "4.1", "content_sanskrit": "समस्तस्य खलु साम्ना उपासनं साधु ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002204, "chapter_id": 8259, "verse_number": "4.2", "content_sanskrit": "लोकेषु पञ्चविधं सामोपासीत पृथिवी हिङ्कारोऽग्निः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002205, "chapter_id": 8259, "verse_number": "4.3", "content_sanskrit": "वृष्टौ पञ्चविधं सामोपासीत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002206, "chapter_id": 8259, "verse_number": "4.4", "content_sanskrit": "सर्वास्वप्सु पञ्चविधं सामोपासीत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002207, "chapter_id": 8259, "verse_number": "4.5", "content_sanskrit": "ऋतुषु पञ्चविध सामोपासीत वसन्तो हिङ्कारो ग्रीष्मः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002208, "chapter_id": 8259, "verse_number": "4.6", "content_sanskrit": "पशुषु पञ्चविधं सामोपासीताजा हिङ्कारोऽवयः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002209, "chapter_id": 8259, "verse_number": "4.7", "content_sanskrit": "प्राणेषु पञ्चविधं परोवरीयः सामोपासीत प्राणो हिङ्कारः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002210, "chapter_id": 8259, "verse_number": "4.8", "content_sanskrit": "अथ सप्तविधस्य वाचि सप्तविधं सामोपासीत ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002211, "chapter_id": 8259, "verse_number": "4.9", "content_sanskrit": "अथ खल्वमुमादित्यं सप्तविधं सामोपासीत सर्वदा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002212, "chapter_id": 8259, "verse_number": "4.10", "content_sanskrit": "अथ खल्वात्मसंमितमतिमृत्यु सप्तविधं सामोपासीत हिङ्कार इति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002213, "chapter_id": 8259, "verse_number": "4.11", "content_sanskrit": "एकविंशत्याऽऽदित्यमाप्नोत्येकविंशो वा इतोऽसावादित्यो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002214, "chapter_id": 8259, "verse_number": "4.12", "content_sanskrit": "आप्नोतीहादित्यस्य जयं परो हास्यादित्यजयाज्जयो भवति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002215, "chapter_id": 8259, "verse_number": "4.13", "content_sanskrit": "मनो हिङ्कारो वाक् प्रस्तावश्चक्षुरुद्गीथः श्रोत्रं प्रतिहारः प्राणो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002216, "chapter_id": 8259, "verse_number": "4.14", "content_sanskrit": "अभिमन्थति स हिङ्कारो धूमो जायते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002217, "chapter_id": 8259, "verse_number": "4.15", "content_sanskrit": "उपमन्त्रयते स हिङ्कारो ज्ञपयते स प्रस्तावः स्त्रिया सह शेते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002218, "chapter_id": 8259, "verse_number": "4.16", "content_sanskrit": "उद्यन् हिङ्कारः उदितः प्रस्तावो मध्यन्दिन उद्गीथोऽपराह्णः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002219, "chapter_id": 8259, "verse_number": "4.17", "content_sanskrit": "समुद्रेकात् समुद्रस्तु देशनाद् दिश उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002220, "chapter_id": 8259, "verse_number": "4.18", "content_sanskrit": "'यादृश्येवोन्नतिर्योग्या तस्याः सर्वात्मनाऽऽयतिः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002221, "chapter_id": 8259, "verse_number": "4.19", "content_sanskrit": "जीवैक्याङ्गीकारे यस्तद् वेदेति तच्छब्दोऽप्ययुक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002222, "chapter_id": 8259, "verse_number": "4.20", "content_sanskrit": "यस्तु भिन्नः स्वतः खादिस्तस्य भेदो ह्यबुद्धिनाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002223, "chapter_id": 8259, "verse_number": "4.21", "content_sanskrit": "'अनन्यप्रोक्ते गतिरत्र नास्त्यणीयान् ह्यतर्क्यमणुप्रमाणात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002224, "chapter_id": 8259, "verse_number": "4.22", "content_sanskrit": "'प्रद्युम्नादीनि रूपाणि त्रीणि त्रीण्येव पञ्च च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900002225, "chapter_id": 8259, "verse_number": "4.23", "content_sanskrit": "दृष्टवस्तुनो मिथ्यात्वाङ्गीकारे च युक्त्यपेक्षा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900002226, "chapter_id": 8259, "verse_number": "4.24", "content_sanskrit": "न च कदाचित्कस्यापि (१) नासीदस्ति भविष्यतीति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900002227, "chapter_id": 8259, "verse_number": "4.25", "content_sanskrit": "'जीवेश्वरगतो जीवेष्वथ जीवजडात्मनोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900002228, "chapter_id": 8259, "verse_number": "4.26", "content_sanskrit": "विदि:(१) कादाचित्कस्वरूपलाभ इति च धातुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900002229, "chapter_id": 8259, "verse_number": "4.27", "content_sanskrit": "विनर्दि साम्नो वृणे पशव्यमित्यग्नेरुद्गीथोऽनिरुक्तः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900002230, "chapter_id": 8259, "verse_number": "4.28", "content_sanskrit": "अमृतत्वं देवेभ्य आगायानीत्यागायेत् स्वधां पितृभ्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900002231, "chapter_id": 8259, "verse_number": "4.29", "content_sanskrit": "सर्वे स्वरा इन्द्रस्यात्मनः सर्व ऊष्मणः प्रजापतेरात्मानः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900002232, "chapter_id": 8259, "verse_number": "4.30", "content_sanskrit": "त्रयो धर्मस्कन्धाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900002233, "chapter_id": 8259, "verse_number": "4.31", "content_sanskrit": "प्रजापतिर्लोकानभ्यतपत् तेभ्योऽभितप्तेभ्यस्त्रयी विद्या सम्प्रास्रवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900002234, "chapter_id": 8259, "verse_number": "4.32", "content_sanskrit": "तपः शब्देनैव यतिधर्मश्वोक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900002235, "chapter_id": 8259, "verse_number": "4.33", "content_sanskrit": "न च संन्यासमात्रेणामृतत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900002236, "chapter_id": 8259, "verse_number": "4.34", "content_sanskrit": "ब्रह्मवादिनो वदन्ति यद्वसूनां प्रातःसवनं रुद्राणां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900002237, "chapter_id": 8259, "verse_number": "4.35", "content_sanskrit": "'यो देवानां नामधा एक एव' इति श्रुतेश्च भगवत एव स्वादिनामानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900002238, "chapter_id": 8259, "verse_number": "4.36", "content_sanskrit": "'पूर्वपूर्वगुणैर्दोषा न शक्ता उत्तरोत्तराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900002239, "chapter_id": 8259, "verse_number": "4.37", "content_sanskrit": "त्रिलोकप्राप्तिपरिघास्त्रयः सन्ति सदातनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]