[
  {
    "id": 16701001,
    "chapter_id": 6101,
    "verse_number": "1.1",
    "content_sanskrit": "धृतराष्ट्र उवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "BG_C01_V01"
  },
  {
    "id": 16701002,
    "chapter_id": 6101,
    "verse_number": "1.2",
    "content_sanskrit": "सञ्जय उवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "BG_C01_V02"
  },
  {
    "id": 16701003,
    "chapter_id": 6101,
    "verse_number": "1.3",
    "content_sanskrit": "पश्यैतां पाण्डुपुत्राणामाचार्य महतीं चमूम् ।\nव्यूढां द्रुपदपुत्रेण तव शिष्येण धीमता ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "BG_C01_V03"
  },
  {
    "id": 16701004,
    "chapter_id": 6101,
    "verse_number": "1.4",
    "content_sanskrit": "अत्र शूरा महेष्वासा भीमार्जुनसमा युधि ।\nयुयुधानो विराटश्च द्रुपदश्च महारथः ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "BG_C01_V04"
  },
  {
    "id": 16701005,
    "chapter_id": 6101,
    "verse_number": "1.5",
    "content_sanskrit": "धृष्टकेतुश्चेकितानः काशीराजश्च वीर्यवान् ।\nपुरुजित्कुन्तिभोजश्च शैब्यश्च नरपुङ्गवः ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "BG_C01_V05"
  },
  {
    "id": 16701006,
    "chapter_id": 6101,
    "verse_number": "1.6",
    "content_sanskrit": "युधामन्युश्च विक्रान्त उत्तमौजाश्च वीर्यवान् ।\nसौभद्रो द्रौपदेयाश्च सर्व एव महारथाः ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "BG_C01_V06"
  },
  {
    "id": 16701007,
    "chapter_id": 6101,
    "verse_number": "1.7",
    "content_sanskrit": "अस्माकं तु विशिष्टा ये तान्निबोध द्विजोत्तम ।\nनायका मम सैन्यस्य संज्ञार्थं तान्ब्रवीमि ते ॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "BG_C01_V07"
  },
  {
    "id": 16701008,
    "chapter_id": 6101,
    "verse_number": "1.8",
    "content_sanskrit": "भवान्भीष्मश्च कर्णश्च कृपश्च समितिञ्जयः ।\nअश्वत्थामा विकर्णश्च सौमदत्तिर्जयद्रथः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "BG_C01_V08"
  },
  {
    "id": 16701009,
    "chapter_id": 6101,
    "verse_number": "1.9",
    "content_sanskrit": "अन्ये च बहवः शूरा मदर्थे त्यक्तजीविताः ।\nनानाशस्त्रप्रहरणाः सर्वे युद्धविशारदाः ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "BG_C01_V09"
  },
  {
    "id": 16701010,
    "chapter_id": 6101,
    "verse_number": "1.10",
    "content_sanskrit": "अपर्याप्तं तदस्माकं बलं भीष्माभिरक्षितम् ।\nपर्याप्तं त्विदमेतेषां बलं भीमाभिरक्षितम् ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "BG_C01_V10"
  },
  {
    "id": 16701011,
    "chapter_id": 6101,
    "verse_number": "1.11",
    "content_sanskrit": "अयनेषु च सर्वेषु यथाभागमवस्थिताः ।\nभीष्ममेवाभिरक्षन्तु भवन्तः सर्व एव हि ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "BG_C01_V11"
  },
  {
    "id": 16701012,
    "chapter_id": 6101,
    "verse_number": "1.12",
    "content_sanskrit": "तस्य सञ्जनयन्हर्षं कुरुवृद्धः पितामहः ।\nसिंहनादं विनद्योच्चैः शङ्खं दध्मौ प्रतापवान् ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "BG_C01_V12"
  },
  {
    "id": 16701013,
    "chapter_id": 6101,
    "verse_number": "1.13",
    "content_sanskrit": "ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः ।\nसहसैवाभ्यहन्यन्त स शब्दस्तुमुलोऽभवत् ॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "base_unit_id": "BG_C01_V13"
  },
  {
    "id": 16701014,
    "chapter_id": 6101,
    "verse_number": "1.14",
    "content_sanskrit": "ततः श्वेतैर्हयैर्युक्ते महति स्यन्दने स्थितौ ।\nमाधवः पाण्डवश्चैव दिव्यौ शङ्खौ प्रदध्मतुः ॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "base_unit_id": "BG_C01_V14"
  },
  {
    "id": 16701015,
    "chapter_id": 6101,
    "verse_number": "1.15",
    "content_sanskrit": "पाञ्चजन्यं हृषीकेशो देवदत्तं धनञ्जयः ।\nपौण्ड्रं दध्मौ महाशङ्खं भीमकर्मा वृकोदरः ॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "base_unit_id": "BG_C01_V15"
  },
  {
    "id": 16701016,
    "chapter_id": 6101,
    "verse_number": "1.16",
    "content_sanskrit": "अनन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः ।\nनकुलः सहदेवश्च सुघोषमणिपुष्पकौ ॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "base_unit_id": "BG_C01_V16"
  },
  {
    "id": 16701017,
    "chapter_id": 6101,
    "verse_number": "1.17",
    "content_sanskrit": "काश्यश्च परमेष्वासः शिखण्डी च महारथः ।\nधृष्टद्युम्नो विराटश्च सात्यकिश्चापराजितः ॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "base_unit_id": "BG_C01_V17"
  },
  {
    "id": 16701018,
    "chapter_id": 6101,
    "verse_number": "1.18",
    "content_sanskrit": "द्रुपदो द्रौपदेयाश्च सर्वशः पृथिवीपते ।\nसौभद्रश्च महाबाहुः शङ्खान्दध्मुः पृथक्पृथक् ॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "base_unit_id": "BG_C01_V18"
  },
  {
    "id": 16701019,
    "chapter_id": 6101,
    "verse_number": "1.19",
    "content_sanskrit": "स घोषो धार्तराष्ट्राणां हृदयानि व्यदारयत् ।\nनभश्च पृथिवीं चैव तुमुलो व्यनुनादयन् ॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "base_unit_id": "BG_C01_V19"
  },
  {
    "id": 16701020,
    "chapter_id": 6101,
    "verse_number": "1.20",
    "content_sanskrit": "अथ व्यवस्थितान्दृष्ट्वा धार्तराष्ट्रान्कपिध्वजः ।\nप्रवृत्ते शस्त्रसम्पाते धनुरुद्यम्य पाण्डवः ॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "base_unit_id": "BG_C01_V20"
  },
  {
    "id": 16701021,
    "chapter_id": 6101,
    "verse_number": "1.21",
    "content_sanskrit": "हृषीकेशं तदा वाक्यमिदमाह महीपते ।\nअर्जुन उवाच —\nसेनयोरुभयोर्मध्ये रथं स्थापय मेऽच्युत ॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "base_unit_id": "BG_C01_V21"
  },
  {
    "id": 16701022,
    "chapter_id": 6101,
    "verse_number": "1.22",
    "content_sanskrit": "यावदेतान्निरीक्षेऽहं योद्धुकामानवस्थितान् ।\nकैर्मया सह योद्धव्यमस्मिन्रणसमुद्यमे ॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "base_unit_id": "BG_C01_V22"
  },
  {
    "id": 16701023,
    "chapter_id": 6101,
    "verse_number": "1.23",
    "content_sanskrit": "योत्स्यमानानवेक्षेऽहं य एतेऽत्र समागताः ।\nधार्तराष्ट्रस्य दुर्बुद्धेर्युद्धे प्रियचिकीर्षवः ॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "base_unit_id": "BG_C01_V23"
  },
  {
    "id": 16701024,
    "chapter_id": 6101,
    "verse_number": "1.24",
    "content_sanskrit": "सञ्जय उवाच —",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "base_unit_id": "BG_C01_V24"
  },
  {
    "id": 16701025,
    "chapter_id": 6101,
    "verse_number": "1.25",
    "content_sanskrit": "भीष्मद्रोणप्रमुखतः सर्वेषां च महीक्षिताम् ।\nउवाच पार्थ पश्यैतान्समवेतान्कुरूनिति ॥ २५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "base_unit_id": "BG_C01_V25"
  },
  {
    "id": 16701026,
    "chapter_id": 6101,
    "verse_number": "1.26",
    "content_sanskrit": "तत्रापश्यत्स्थितान्पार्थः पितॄनथ पितामहान् ।\nआचार्यान्मातुलान्भ्रातॄन्पुत्रान्पौत्रान्सखींस्तथा ॥ २६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "base_unit_id": "BG_C01_V26"
  },
  {
    "id": 16701027,
    "chapter_id": 6101,
    "verse_number": "1.27",
    "content_sanskrit": "श्वशुरान्सुहृदश्चैवसेनयोरुभयोरपि ।\nतान्समीक्ष्य स कौन्तेयः सर्वान्बन्धूनवस्थितान् ॥ २७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "base_unit_id": "BG_C01_V27"
  },
  {
    "id": 16701028,
    "chapter_id": 6101,
    "verse_number": "1.28",
    "content_sanskrit": "कृपया परयाविष्टो विषीदन्निदमब्रवीत् ।\nअर्जुन उवाच —\nदृष्ट्वेमान्स्वजनान्कृष्ण युयुत्सून्समुपस्थितान् ॥ २८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "base_unit_id": "BG_C01_V28"
  },
  {
    "id": 16701029,
    "chapter_id": 6101,
    "verse_number": "1.29",
    "content_sanskrit": "सीदन्ति मम गात्राणि मुखं च परिशुष्यति ।\nवेपथुश्च शरीरे मे रोमहर्षश्च जायते ॥ २९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "base_unit_id": "BG_C01_V29"
  },
  {
    "id": 16701030,
    "chapter_id": 6101,
    "verse_number": "1.30",
    "content_sanskrit": "गाण्डीवं स्रंसते हस्तात्त्वक्चैव परिदह्यते ।\nन च शक्नोम्यवस्थातुं भ्रमतीव च मे मनः ॥ ३० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "base_unit_id": "BG_C01_V30"
  },
  {
    "id": 16701031,
    "chapter_id": 6101,
    "verse_number": "1.31",
    "content_sanskrit": "निमित्तानि च पश्यामि विपरीतानि केशव ।\nन च श्रेयोऽनुपश्यामि हत्वा स्वजनमाहवे ॥ ३१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "base_unit_id": "BG_C01_V31"
  },
  {
    "id": 16701032,
    "chapter_id": 6101,
    "verse_number": "1.32",
    "content_sanskrit": "न काङ्क्षे विजयं कृष्ण न च राज्यं सुखानि च ।\nकिं नो राज्येन गोविन्द किं भोगैर्जीवितेन वा ॥ ३२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "base_unit_id": "BG_C01_V32"
  },
  {
    "id": 16701033,
    "chapter_id": 6101,
    "verse_number": "1.33",
    "content_sanskrit": "येषामर्थे काङ्क्षितं नो राज्यं भोगाः सुखानि च ।\nत इमेऽवस्थिता युद्धे प्राणांस्त्यक्त्वा धनानि च ॥ ३३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "base_unit_id": "BG_C01_V33"
  },
  {
    "id": 16701034,
    "chapter_id": 6101,
    "verse_number": "1.34",
    "content_sanskrit": "आचार्याः पितरः पुत्रास्तथैव च पितामहाः ।\nमातुलाः श्वशुराः पौत्राः स्यालाः सम्बन्धिनस्तथा ॥ ३४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "base_unit_id": "BG_C01_V34"
  },
  {
    "id": 16701035,
    "chapter_id": 6101,
    "verse_number": "1.35",
    "content_sanskrit": "एतान्न हन्तुमिच्छामि घ्नतोऽपि मधुसूदन ।\nअपि त्रैलोक्यराज्यस्य हेतोः किं नु महीकृते ॥ ३५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "base_unit_id": "BG_C01_V35"
  },
  {
    "id": 16701036,
    "chapter_id": 6101,
    "verse_number": "1.36",
    "content_sanskrit": "निहत्य धार्तराष्ट्रान्नः का प्रीतिः स्याज्जनार्दन ।\nपापमेवाश्रयेदस्मान्हत्वैतानाततायिनः ॥ ३६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "base_unit_id": "BG_C01_V36"
  },
  {
    "id": 16701037,
    "chapter_id": 6101,
    "verse_number": "1.37",
    "content_sanskrit": "तस्मान्नार्हा वयं हन्तुं धार्तराष्ट्रान्सबान्धवान् ।\nस्वजनं हि कथं हत्वा सुखिनः स्याम माधव ॥ ३७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "base_unit_id": "BG_C01_V37"
  },
  {
    "id": 16701038,
    "chapter_id": 6101,
    "verse_number": "1.38",
    "content_sanskrit": "यद्यप्येते न पश्यन्ति लोभोपहतचेतसः ।\nकुलक्षयकृतं दोषं मित्रद्रोहे च पातकम् ॥ ३८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "base_unit_id": "BG_C01_V38"
  },
  {
    "id": 16701039,
    "chapter_id": 6101,
    "verse_number": "1.39",
    "content_sanskrit": "कथं न ज्ञेयमस्माभिः पापादस्मान्निवर्तितुम् ।\nकुलक्षयकृतं दोषं प्रपश्यद्भिर्जनार्दन ॥ ३९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "base_unit_id": "BG_C01_V39"
  },
  {
    "id": 16701040,
    "chapter_id": 6101,
    "verse_number": "1.40",
    "content_sanskrit": "कुलक्षये प्रणश्यन्ति कुलधर्माः सनातनाः ।\nधर्मे नष्टे कुलं कृत्स्नमधर्मोऽभिभवत्युत ॥ ४० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "base_unit_id": "BG_C01_V40"
  },
  {
    "id": 16701041,
    "chapter_id": 6101,
    "verse_number": "1.41",
    "content_sanskrit": "अधर्माभिभवात्कृष्ण प्रदुष्यन्ति कुलस्त्रियः ।\nस्त्रीषु दुष्टासु वार्ष्णेय जायते वर्णसङ्करः ॥ ४१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "base_unit_id": "BG_C01_V41"
  },
  {
    "id": 16701042,
    "chapter_id": 6101,
    "verse_number": "1.42",
    "content_sanskrit": "सङ्करो नरकायैव कुलघ्नानां कुलस्य च ।\nपतन्ति पितरो ह्येषां लुप्तपिण्डोदकक्रियाः ॥ ४२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "base_unit_id": "BG_C01_V42"
  },
  {
    "id": 16701043,
    "chapter_id": 6101,
    "verse_number": "1.43",
    "content_sanskrit": "दोषैरेतैः कुलघ्नानां वर्णसङ्करकारकैः ।\nउत्साद्यन्ते जातिधर्माः कुलधर्माश्च शाश्वताः ॥ ४३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "base_unit_id": "BG_C01_V43"
  },
  {
    "id": 16701044,
    "chapter_id": 6101,
    "verse_number": "1.44",
    "content_sanskrit": "उत्सन्नकुलधर्माणां मनुष्याणां जनार्दन ।\nनरके नियतं वासो भवतीत्यनुशुश्रुम ॥ ४४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "base_unit_id": "BG_C01_V44"
  },
  {
    "id": 16701045,
    "chapter_id": 6101,
    "verse_number": "1.45",
    "content_sanskrit": "अहो बत महत्पापं कर्तुं व्यवसिता वयम् ।\nयद्राज्यसुखलोभेन हन्तुं स्वजनमुद्यताः ॥ ४५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "base_unit_id": "BG_C01_V45"
  },
  {
    "id": 16701046,
    "chapter_id": 6101,
    "verse_number": "1.46",
    "content_sanskrit": "यदि मामप्रतीकारमशस्त्रं शस्त्रपाणयः ।\nधार्तराष्ट्रा रणे हन्युस्तन्मे क्षेमतरं भवेत् ॥ ४६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "base_unit_id": "BG_C01_V46"
  },
  {
    "id": 16701047,
    "chapter_id": 6101,
    "verse_number": "1.47",
    "content_sanskrit": "सञ्जय उवाच —",
