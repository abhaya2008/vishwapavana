[{"id": 2006723, "chapter_id": 1133, "verse_number": "१-१३४-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006724, "chapter_id": 1133, "verse_number": "१-१३४-१", "content_sanskrit": "कस्मिन्वयसि संप्राप्ताः पाण्डवा गजसाह्वयम्।\nसमपद्यन्त देवेभ्यस्तेषामायुश्च किं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006725, "chapter_id": 1133, "verse_number": "१-१३४-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006726, "chapter_id": 1133, "verse_number": "१-१३४-२", "content_sanskrit": "पाण्डवानामिहायुष्यं शृणु कौरवनन्दन।\nजगाम हास्तिनपुरं षोडशाब्दो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006727, "chapter_id": 1133, "verse_number": "१-१३४-३", "content_sanskrit": "भीमसेनः पञ्चदशो बीभत्सुर्वै चतुर्दशः।\nत्रयोदशाब्दौ च यमौ जग्मतुर्नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006728, "chapter_id": 1133, "verse_number": "१-१३४-४", "content_sanskrit": "तत्र त्रयोदशाब्दानि धार्तराष्ट्रैः सहोषिताः।\nषण्मासाञ्जातुषगृहान्मुक्ता जातो घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006729, "chapter_id": 1133, "verse_number": "१-१३४-५", "content_sanskrit": "षण्मासानेकचक्रायां वर्षं पाञ्चालके गृहे।\nधार्तराष्ट्रैः सहोषित्वा पञ्च वर्षाणि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006730, "chapter_id": 1133, "verse_number": "१-१३४-६", "content_sanskrit": "इन्द्रप्रस्थे वसन्तस्ते त्रीणि वर्षाणि विंशतिम्।\nद्वादशाब्दानथैकं च बभूवुर्द्यूतनिर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006731, "chapter_id": 1133, "verse_number": "१-१३४-७", "content_sanskrit": "भुक्त्वा षट्त्रिंशतं राजन्सागरान्तां वसुन्धराम्।\nमासैः षड्भिर्महात्मानः सर्वे कृष्णपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006732, "chapter_id": 1133, "verse_number": "१-१३४-८", "content_sanskrit": "राज्ये परीक्षितं स्थाप्य दिष्टां गतिमवाप्नुवन्।\nएवं युधिष्ठिरस्यासीदायुरष्टोत्तरं शतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006733, "chapter_id": 1133, "verse_number": "१-१३४-९", "content_sanskrit": "अर्जुनात्केशवो ज्येष्ठस्त्रिभिर्मासैर्महाद्युतिः।\nकृष्णात्संकर्षणो ज्येष्ठस्त्रिभिर्मासैर्महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006734, "chapter_id": 1133, "verse_number": "१-१३४-१०", "content_sanskrit": "पाण्डुः पञ्चमहातेजास्तान्पश्यन्पर्वते सुतान्।\nरेमे स काश्यपयुतः पत्नीभ्यां सुभृशं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006735, "chapter_id": 1133, "verse_number": "१-१३४-११", "content_sanskrit": "सुपुष्पितवने काले प्रवृत्ते मधुमाधवे।\nपूर्णे चतुर्दशे वर्षे फल्गुनस्य च धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006736, "chapter_id": 1133, "verse_number": "१-१३४-१२", "content_sanskrit": "यस्मिन्नृक्षे समुत्पन्नः पार्थस्तस्य च धीमतः।\nतस्मिन्नुत्तरफल्गुन्यां प्रवृत्ते स्वस्तिवाचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006737, "chapter_id": 1133, "verse_number": "१-१३४-१३", "content_sanskrit": "रक्षणे विस्मृता कुन्ती व्यग्रा ब्राह्मणभोजने।\nपुरोहितेन सहितान्ब्राह्मणान्पर्यवेषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006738, "chapter_id": 1133, "verse_number": "१-१३४-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006739, "chapter_id": 1133, "verse_number": "१-१३४-१४", "content_sanskrit": "दर्शनीयांस्ततः पुत्रान्पाण्डुः पञ्च महावने।\nतान्पश्यन्पर्वते रम्ये स्वबाहुबलमाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006740, "chapter_id": 1133, "verse_number": "१-१३४-१५", "content_sanskrit": "सुपुष्पितवने काले कदाचिन्मधुमाधवे।\nभूतसंमोहने राजा सभार्यो व्यचरद्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006741, "chapter_id": 1133, "verse_number": "१-१३४-१६", "content_sanskrit": "पलाशैस्तिलकैश्चूतैश्चम्पकैः पारिभद्रकैः।\nअन्यैश्च बहुभिर्वृक्षैः फलपुष्पसमृद्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006742, "chapter_id": 1133, "verse_number": "१-१३४-१७", "content_sanskrit": "जलस्थानैश्च विविधैः पद्मिनीभिश्च शोभितम्।\nपाण्डोर्वनं तत्संप्रेक्ष्य प्रजज्ञे हृदि मन्मथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006743, "chapter_id": 1133, "verse_number": "१-१३४-१८", "content_sanskrit": "प्रहृष्टमनसं तत्र विचरन्तं यथाऽमरम्।\nतं माद्र्यनुजगामैका वसनं बिभ्रती शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006744, "chapter_id": 1133, "verse_number": "१-१३४-१९", "content_sanskrit": "समीक्षमाणः स तु तां वयःस्थां तनुवाससम्।\nतस्य कामः प्रवृते गहनेऽग्निरिवोद्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006745, "chapter_id": 1133, "verse_number": "१-१३४-२०", "content_sanskrit": "रहस्येकां तु तां दृष्ट्वा राजा राजीवलोचनाम्।\nन शशाक नियन्तुं तं कामं कामवशीकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006746, "chapter_id": 1133, "verse_number": "१-१३४-२१", "content_sanskrit": "अथ सोऽष्टादशे वर्षे ऋतौ माद्रमलङ्कृताम्।\nआजुहाव ततः पाण्डुः परीतात्मा यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006747, "chapter_id": 1133, "verse_number": "१-१३४-२२", "content_sanskrit": "तत एनां बलाद्राजा निजग्राह रहोगताम्।\nवार्यमाणस्तया देव्या विस्फुरन्त्या यथाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006748, "chapter_id": 1133, "verse_number": "१-१३४-२३", "content_sanskrit": "स तु कामपरीतात्मा तं शापं नान्वबुध्यत।\nमाद्रीं मैथुनधर्मेण सोऽन्वगच्छद्बलादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006749, "chapter_id": 1133, "verse_number": "१-१३४-२४", "content_sanskrit": "जीवितान्ताय कौरव्य मन्मथस्य वशं गतः।\nशापजं भयमुत्सृज्य विधिना संप्रचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006750, "chapter_id": 1133, "verse_number": "१-१३४-२५", "content_sanskrit": "तस्य कामात्मनो बुद्धिः साक्षात्कालेन मोहिता।\nसंप्रमथ्येन्द्रियग्रामं प्रनष्टा सह चेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006751, "chapter_id": 1133, "verse_number": "१-१३४-२६", "content_sanskrit": "स तया सह संगम्य भार्यया कुरुनन्दनः।\nपाण्डुः परमधर्मात्मा युयुजे कालधर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006752, "chapter_id": 1133, "verse_number": "१-१३४-२७", "content_sanskrit": "ततो माद्री समालिङ्ग्य राजानं गतचेतसम्।\nमुमोच दुःखजं शब्दं पुनः पुनरतीव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006753, "chapter_id": 1133, "verse_number": "१-१३४-२८", "content_sanskrit": "सह पुत्रैस्ततः कुन्ती माद्रीपुत्रौ च पाण्डवौ।\nआजग्मुः सहितास्तत्र यत्र राजा तथागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006754, "chapter_id": 1133, "verse_number": "१-१३४-२९", "content_sanskrit": "ततो माद्र्यब्रवीद्राजन्नार्ता कुन्तीमिदं वचः।\nएकैव त्वमिहागच्छ तिष्ठन्त्वत्रैव दारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006755, "chapter_id": 1133, "verse_number": "१-१३४-३०", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्यास्तत्रैवाधाय दरकान्।\nहता।हमिति विक्रुश्च सहसैवाजगाम सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006756, "chapter_id": 1133, "verse_number": "१-१३४-३१", "content_sanskrit": "दृष्ट्वा पाण्डुं च माद्रीं च शयानौ धरणीतले।\nकुन्ती शोकपरीताङ्गी विललाप सुदुःखिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006757, "chapter_id": 1133, "verse_number": "१-१३४-३२", "content_sanskrit": "रक्ष्यमाणो मया नित्यं वीरः सततमात्मवान्।\nकथं त्वामत्यतिक्रान्तः शापं जानन्वनौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006758, "chapter_id": 1133, "verse_number": "१-१३४-३३", "content_sanskrit": "ननु नाम त्वया माद्रि रक्षितव्यो नराधिपः।\nसा कथं लोभितवती विजने त्वं नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006759, "chapter_id": 1133, "verse_number": "१-१३४-३४", "content_sanskrit": "कथं दीनस्य सततं त्वामासाद्य रहोगताम्।\nतं विचिन्तयतः शापं प्रहर्षः समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006760, "chapter_id": 1133, "verse_number": "१-१३४-३५", "content_sanskrit": "धन्या त्वमसि बाह्लीकि मत्तो भाग्यतरा तथा।\nदृष्टवत्यसि यद्वक्त्रं प्रहृष्टस्य महीपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006761, "chapter_id": 1133, "verse_number": "१-१३४-३६x", "content_sanskrit": "माद्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006762, "chapter_id": 1133, "verse_number": "१-१३४-३६", "content_sanskrit": "विलपन्त्या मया देवि वार्यमाणेन चासकृत्।\nआत्मा न वारितोऽनेन सत्यं दिष्टं चिकीर्षुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006763, "chapter_id": 1133, "verse_number": "१-१३४-३७x", "content_sanskrit": "वैशंपायान उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006764, "chapter_id": 1133, "verse_number": "१-१३४-३७", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा कुन्ती शोकाग्निदीपिता।\nपपात सहसा भूमौ छिन्नमूल इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006765, "chapter_id": 1133, "verse_number": "१-१३४-३८", "content_sanskrit": "निश्चेष्टा पतिता भूमौ मोहेन न चचाल सा।\nतस्मिन्क्षणे कृतस्नानमहताम्बरसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006766, "chapter_id": 1133, "verse_number": "१-१३४-३९", "content_sanskrit": "अलङ्कारकृतं पाण्डुं शयानं शयने शुभे।\nकुन्तीमुत्थाप्य माद्री तु मोहेनाविष्टचेतनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006767, "chapter_id": 1133, "verse_number": "१-१३४-४०", "content_sanskrit": "आर्ये एहीति तां कुन्तीं दर्शयामास कौरव।\nपादयोः पतिता कुन्ती पुनरुत्थाय भूमिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006768, "chapter_id": 1133, "verse_number": "१-१३४-४१", "content_sanskrit": "रक्तचन्दनदिग्धांङ्गं महारजनवाससम्।\nसस्मितेन च वक्त्रेण वदन्तमिव भारतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006769, "chapter_id": 1133, "verse_number": "१-१३४-४२", "content_sanskrit": "परिरभ्य ततो मोहाद्विललापाकुलेन्द्रिया।\nमाद्री चापि समालिङ्ग्य राजानं विललाप सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2006770, "chapter_id": 1133, "verse_number": "१-१३४-४३", "content_sanskrit": "तं तथा शायिनं पुत्रा ऋषयः सह चारणैः।\nअभ्येत्य सहिताः सर्वे शोकादश्रूण्यवर्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2006771, "chapter_id": 1133, "verse_number": "१-१३४-४४", "content_sanskrit": "अस्तं गतमिवादित्यं संशुष्कमिव सागरम्।\nदृष्ट्वा पाण्डुं नरव्याघ्रं शोचन्ति स्म महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2006772, "chapter_id": 1133, "verse_number": "१-१३४-४५", "content_sanskrit": "समानशोका ऋषयः पाण्डवाश्च बभूविरे।\nते समाश्वासिते विप्रैर्विलेपतुरनिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2006773, "chapter_id": 1133, "verse_number": "१-१३४-४६x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2006774, "chapter_id": 1133, "verse_number": "१-१३४-४६", "content_sanskrit": "हा राजन्कस्य नो हित्वा गच्छसि त्रिदशालयम्।\nहा राजन्मम मन्दायाः कथं माद्रीं समेत्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2006775, "chapter_id": 1133, "verse_number": "१-१३४-४७", "content_sanskrit": "निधनं प्राप्तवान्राजन्मद्भाग्यपरिसंक्षयात्।\nयुधिष्ठिरं भीमसेनमर्जुनं च यमावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2006776, "chapter_id": 1133, "verse_number": "१-१३४-४८", "content_sanskrit": "कस्य हित्वा प्रियान्पुत्रान्प्रयातोऽसि विशांपते।\nनूनं त्वां त्रिदशा देवाः प्रतिनन्दन्ति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2006777, "chapter_id": 1133, "verse_number": "१-१३४-४९", "content_sanskrit": "यतो हि तप उग्रं वै चरितं ब्रह्मसंसदि।\nआवाभ्यां सहितो राजन्गमिष्यसि दिवं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2006778, "chapter_id": 1133, "verse_number": "१-१३४-५०", "content_sanskrit": "आजमीढाजमीढानां कर्मणा चरतां गतिम्।\nननु नाम सहावाभ्यां गमिष्यामीति यत्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2006779, "chapter_id": 1133, "verse_number": "१-१३४-५१", "content_sanskrit": "प्रतिज्ञाता कुरुश्रेष्ठ यदाऽस्मि वनमागता।\nआवाभ्यां चैव सहितो गमिष्यसि विशांपते।\nमुहूर्तं क्षम्यतां राजन्द्रक्ष्येऽहं च मुखं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2006780, "chapter_id": 1133, "verse_number": "१-१३४-५२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2006781, "chapter_id": 1133, "verse_number": "१-१३४-५२", "content_sanskrit": "विलपित्वा भृशं चैव निःसंज्ञे पतिते भुवि।\nयथा हते मृगे मृग्यौ लुब्धैर्वनगते तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2006782, "chapter_id": 1133, "verse_number": "१-१३४-५३", "content_sanskrit": "युधिष्ठिरमुखाः सर्वे पाण्डवा वेदपरागाः।\nतेऽभ्यागत्य पितुर्मूले निःसंज्ञाः पतिता भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2006783, "chapter_id": 1133, "verse_number": "१-१३४-५४", "content_sanskrit": "पाण्डोः पादौ परिष्वज्य विलपन्ति स्म पाण्डवाः।\nहा विनष्टाः स्म तातेति हा अनाथा भवामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2006784, "chapter_id": 1133, "verse_number": "१-१३४-५५", "content_sanskrit": "त्वद्विहीना महाप्राज्ञ कथं जीवाम बालकाः।\nलोकनाथस्य पुत्राः स्मो न सनाथा भवामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2006785, "chapter_id": 1133, "verse_number": "१-१३४-५६", "content_sanskrit": "क्षणेनैव महाराज अहो लोकस्य चित्रता।\nनास्मद्विधा राजपुत्रा अधन्याः सन्ति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2006786, "chapter_id": 1133, "verse_number": "१-१३४-५७", "content_sanskrit": "त्वद्विनाशाच्च राजेन्द्र राज्यप्रस्खलनात्तदा।\nपाण्डवाश्च वयं सर्वे प्राप्ताः स्म व्यसनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2006787, "chapter_id": 1133, "verse_number": "१-१३४-५८", "content_sanskrit": "किं करिष्यामहे राजन्कर्तव्यं च प्रसीदताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2006788, "chapter_id": 1133, "verse_number": "१-१३४-५८x", "content_sanskrit": "भीमसेन उवाच।\nहित्वा राज्यं च भोगांश्च शतशृङ्गनिवासिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2006789, "chapter_id": 1133, "verse_number": "१-१३४-५९", "content_sanskrit": "त्वया लब्धाः स्म राजेन्द्र महता तपसा वयम्।\nहित्वा मानं वनं गत्वा स्वयमाहृत्य भक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2006790, "chapter_id": 1133, "verse_number": "१-१३४-६०", "content_sanskrit": "शाकमूलफलैर्वन्यैर्भरणं वै त्वया कृतम्।\nपुत्रानुत्पाद्य पितरो यमिच्छ्ति महातम्नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2006791, "chapter_id": 1133, "verse_number": "१-१३४-६१", "content_sanskrit": "त्रिवर्गफलमिच्छन्तस्तस्य कालोऽयमागतः।\nअभुक्त्वैव फलं राजन्गन्तुं नार्हसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2006792, "chapter_id": 1133, "verse_number": "१-१३४-६२", "content_sanskrit": "इत्येवमुक्त्वा पितरं भीमोऽपि विललाप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2006793, "chapter_id": 1133, "verse_number": "१-१३४-६३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2006794, "chapter_id": 1133, "verse_number": "१-१३४-६३", "content_sanskrit": "प्रनष्टं भारतं वंशं पाण्डुना पुनरुद्धृतम्।\nतस्मिंस्तदा वनगते नष्टं राज्यमराजकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2006795, "chapter_id": 1133, "verse_number": "१-१३४-६४", "content_sanskrit": "पुनर्निःसारितं क्षत्रं पाण्डुपुत्रैश्च पञ्चभिः।\nएतच्छ्रुत्वाऽनुमोदित्वा गन्तुमर्हसि शङ्कर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2006796, "chapter_id": 1133, "verse_number": "१-१३४-६५", "content_sanskrit": "इत्येवमुक्त्वा पितरं विललाप धनञ्जयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2006797, "chapter_id": 1133, "verse_number": "१-१३४-६५x", "content_sanskrit": "यमावूचतुः।\nदुःसहं च तपः कृत्वा लब्ध्वा नो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2006798, "chapter_id": 1133, "verse_number": "१-१३४-६६", "content_sanskrit": "पुत्रलाभस्य महतः शुश्रूषादिफलं त्वया।\nन चावाप्तं किंचिदेव पुरा दशरथो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2006799, "chapter_id": 1133, "verse_number": "१-१३४-६७", "content_sanskrit": "एवमुक्त्वा यमौ चापि विलेपतुरथातुरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2006800, "chapter_id": 1133, "verse_number": "१-१३४-६८x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2006801, "chapter_id": 1133, "verse_number": "१-१३४-६८", "content_sanskrit": "अहं ज्येष्ठा धर्मपत्नी ज्येष्ठं धर्मफलं मम।\nअवश्यं भाविनो भावान्मा मां माद्रि निवर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2006802, "chapter_id": 1133, "verse_number": "१-१३४-६९", "content_sanskrit": "अन्विष्यामीह भर्तारमहं प्रेतवशं गतम्।\nउत्तिष्ठ त्वं विसृज्यैनमिमान्रक्षस्व दारकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2006803, "chapter_id": 1133, "verse_number": "१-१३४-७०", "content_sanskrit": "अवाप्य पुत्रांल्लब्धार्थान्वीरपत्नीत्वमर्थये।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2006804, "chapter_id": 1133, "verse_number": "१-१३४-७०x", "content_sanskrit": "वैशम्पायन उवाच।\nमद्रराजसुता कुन्तीमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2006805, "chapter_id": 1133, "verse_number": "१-१३४-७१", "content_sanskrit": "अहमेवानुयास्यामि भर्तारमपलापिनम्।\nन हि तृप्ताऽस्मि कामानां ज्येष्ठा मामनुमन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2006806, "chapter_id": 1133, "verse_number": "१-१३४-७२", "content_sanskrit": "मां चाभिगम्य क्षीणोऽयं कामाद्भरतसत्तमः।\nसमुच्छिद्यामि तत्कामं कथं नु यमसादने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2006807, "chapter_id": 1133, "verse_number": "१-१३४-७३", "content_sanskrit": "मम हतोर्हि राजाऽयं दिवं राजर्पिसत्तमः।\nन चैव तादृशी बुद्धिर्बान्धवाश्च न तादृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2006808, "chapter_id": 1133, "verse_number": "१-१३४-७४", "content_sanskrit": "न चोत्सहे धारयितुं प्राणान्भर्त्रा विना कृता।\nतस्मात्तमनुयास्यामि यान्तं वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2006809, "chapter_id": 1133, "verse_number": "१-१३४-७५", "content_sanskrit": "वर्तेयं न समां वृत्तिं जात्वहं न सुतेषु ते।\nतथाहि वर्तमानां मामधर्मः संस्पृशेन्महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2006810, "chapter_id": 1133, "verse_number": "१-१३४-७६", "content_sanskrit": "तस्मान्मे सुतयोर्देवि वर्तितव्यं स्वपुत्रवत्।\nअन्वेष्यामि च भर्तारं व्रजन्तं यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2006811, "chapter_id": 1133, "verse_number": "१-१३४-७७", "content_sanskrit": "मां हि कामयमानोऽयं राजा प्रेतवशं गतः।\nराज्ञः शरीरेण सह मामपीदं कलेवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2006812, "chapter_id": 1133, "verse_number": "१-१३४-७८", "content_sanskrit": "दग्धव्यं सुप्रतिच्छन्नं त्वेतदार्ये प्रियं कुरु।\nदारकेष्वप्रमत्ता त्वं भवेश्चाभिहिता मया।\nअतोऽहं न प्रपश्यामि संदेष्टव्यं हितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2006813, "chapter_id": 1133, "verse_number": "१-१३४-७९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2006814, "chapter_id": 1133, "verse_number": "१-१३४-७९", "content_sanskrit": "ऋषयस्तान्समाश्वास्य पाण्डवान्सत्यविक्रमान्।\nऊचुः कुन्तीं च माद्रीं च समाश्वास्य तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2006815, "chapter_id": 1133, "verse_number": "१-१३४-८०", "content_sanskrit": "सुभगे बालपुत्रा तु न मर्तव्यं तथंचन।\nपाण्डवांश्चापि नेष्यामः कुरुराष्ट्रं परन्तपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2006816, "chapter_id": 1133, "verse_number": "१-१३४-८१", "content_sanskrit": "अधर्मेष्वर्थजातेषु धृतराष्ट्रश्च लोभवान्।\nस कदाचिन्न वर्तेत पाण्डवेषु यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2006817, "chapter_id": 1133, "verse_number": "१-१३४-८२", "content_sanskrit": "कुन्त्याश्च वृष्णयो नाथाः कुन्तिभोजस्तथैव च।\nमाद्र्याश्च बलिनांश्रेष्ठः शल्यो भ्राता महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2006818, "chapter_id": 1133, "verse_number": "१-१३४-८३", "content_sanskrit": "भर्त्रा तु मरणं सार्धं फलवन्नात्र संशयः।\nयुवाभ्यां दुष्करं चैतद्वदन्ति द्विजपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2006819, "chapter_id": 1133, "verse_number": "१-१३४-८४", "content_sanskrit": "मृते भर्तरि साध्वी स्त्री ब्रह्मचर्यव्रते स्थिता।\nयमैश्च नियमैः पूता मनोवाक्कायजैः शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2006820, "chapter_id": 1133, "verse_number": "१-१३४-८५", "content_sanskrit": "भर्तारं चिन्तयन्ती सा भर्तारं निस्तरेच्छुभा।\nतारितश्चापि भर्ता स्यादात्मा पुत्रस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2006821, "chapter_id": 1133, "verse_number": "१-१३४-८६", "content_sanskrit": "तस्माञ्जीवितमेवैतद्युवयोर्विद्म शोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2006822, "chapter_id": 1133, "verse_number": "१-१३४-८७x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2006823, "chapter_id": 1133, "verse_number": "१-१३४-८७", "content_sanskrit": "यथा पाण्डोस्तु निर्देशस्तथा विप्रगणस्य च।\nआज्ञा शिरसि निक्षिप्ता करिष्यामि च तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2006824, "chapter_id": 1133, "verse_number": "१-१३४-८८", "content_sanskrit": "यदाद्दुर्भगवन्तोऽपि तन्मन्ये शोभनं परम्।\nभर्तुश्च मम पुत्राणामात्मनश्च न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2006825, "chapter_id": 1133, "verse_number": "१-१३४-८९x", "content_sanskrit": "माद्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2006826, "chapter_id": 1133, "verse_number": "१-१३४-८९", "content_sanskrit": "कुन्ती समर्था पुत्राणां योगक्षेमस्य धारणे।\nअस्या हि न समा बुद्ध्या यद्यपि स्यादरुन्धती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2006827, "chapter_id": 1133, "verse_number": "१-१३४-९०", "content_sanskrit": "कुन्त्याश्च वृष्णयो नाथाः कुन्तिभोजस्तथैव च।\nनाहं त्वमिव पुत्राणां समर्था धारणे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2006828, "chapter_id": 1133, "verse_number": "१-१३४-९१", "content_sanskrit": "साऽहं भर्तारमन्विष्ये संतृप्ता नापि भोगतः।\nभर्तृलोकस्य तु ज्येष्ठा देवी मामनुमन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2006829, "chapter_id": 1133, "verse_number": "१-१३४-९२", "content_sanskrit": "धर्मज्ञस्य कृतज्ञस्य सत्यसन्धस्य धीमतः।\nपादौ परिचरिष्यामि तथार्याऽद्यानुमन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2006830, "chapter_id": 1133, "verse_number": "१-१३४-९३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2006831, "chapter_id": 1133, "verse_number": "१-१३४-९३", "content_sanskrit": "एवमुक्त्वा तदा राजन्मद्रराजसुता शुभा।\nददौ कुन्त्यै यमौ माद्री शिरसाऽभिप्रणम्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2006832, "chapter_id": 1133, "verse_number": "१-१३४-९४", "content_sanskrit": "अभिवाद्य महर्षीन्सा परिष्वज्य च पाण्डवान्।\nमूर्ध्न्युपाघ्राय बहुशः पार्थानात्मसुतौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2006833, "chapter_id": 1133, "verse_number": "१-१३४-९५", "content_sanskrit": "हस्ते युधिष्ठिरं गृह्य माद्री वाक्यमभाषत।\nकुन्ती माता अहं धात्री युष्माकं तु पिता मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2006834, "chapter_id": 1133, "verse_number": "१-१३४-९६", "content_sanskrit": "युधिष्ठिरः पिता ज्येष्ठश्चतुर्णां धर्मतः सदा।\nवृद्धाद्युपासनासक्ताः सत्यधर्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2006835, "chapter_id": 1133, "verse_number": "१-१३४-९७", "content_sanskrit": "तादृशा न विनश्यन्ति नैव यान्ति पराभवम्।\nतस्मात्सर्वे कुरुध्वं वै गुरुवृत्तिमतन्द्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2006836, "chapter_id": 1133, "verse_number": "१-१३४-९८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2006837, "chapter_id": 1133, "verse_number": "१-१३४-९८", "content_sanskrit": "ऋषीणां च पृथायाश्च नमस्कृत्य पुनःपुनः।\nआयासकृपणा माद्री प्रत्युवाच पृथां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2006838, "chapter_id": 1133, "verse_number": "१-१३४-९९x", "content_sanskrit": "माद्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2006839, "chapter_id": 1133, "verse_number": "१-१३४-९९", "content_sanskrit": "ऋषीणां संनिधावेषां यथा वागभ्युदीरिता।\nदिदृक्षमाणायाः स्वर्गं न ममैषा वृथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2006840, "chapter_id": 1133, "verse_number": "१-१३४-१००", "content_sanskrit": "धन्या त्वमसि वार्ष्णेयि नास्ति स्त्री सदृशी त्वया।\nवीर्यं तेजश्च योगं च माहात्म्यं च यशस्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2006841, "chapter_id": 1133, "verse_number": "१-१३४-१०१", "content_sanskrit": "कुन्ति द्रक्ष्यसि पुत्राणां पञ्चानाममितौजसाम्।\nआर्या चाप्यभिवाद्या च मम पूज्या च सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2006842, "chapter_id": 1133, "verse_number": "१-१३४-१०२", "content_sanskrit": "ज्येष्ठा वरिष्ठा त्वं देवि भूषिता स्वगुणैः शुभैः।\nअभ्यनुज्ञातुमिच्छामि त्वया यावनन्दिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2006843, "chapter_id": 1133, "verse_number": "१-१३४-१०३", "content_sanskrit": "धर्मं स्वर्गं च कीर्तिं च त्वत्कृतेऽहमवाप्नुयाम्।\nयथा तथा विधत्स्वेह मा च कार्षीर्विचारणां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2006844, "chapter_id": 1133, "verse_number": "१-१३४-१०४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2006845, "chapter_id": 1133, "verse_number": "१-१३४-१०४", "content_sanskrit": "बाष्पसंदिग्धया वाचा कुन्त्युवाच यशस्विनी।\nअनुज्ञाताऽसि कल्याणि त्रिदिवे सङ्गमोऽस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2006846, "chapter_id": 1133, "verse_number": "१-१३४-१०५", "content_sanskrit": "भर्त्रा सह विशालिक्षि क्षिप्रमद्यैव भामिनि।\nसंगतास्वर्गलोके त्वं रमेथाः शाश्वतीः समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2006847, "chapter_id": 1133, "verse_number": "१-१३४-१०६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2006848, "chapter_id": 1133, "verse_number": "१-१३४-१०६", "content_sanskrit": "ततः पुरोहितः स्नात्वा प्रेतकर्मणि पारगः।\nहिरण्यशकलानाज्यं तिलं दधि च तण्डुलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2006849, "chapter_id": 1133, "verse_number": "१-१३४-१०७", "content_sanskrit": "उदकुम्भांश्च परशुं समानीय तपस्विभिः।\nअश्वमेधाग्निमाहृत्य यथान्यायं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2006850, "chapter_id": 1133, "verse_number": "१-१३४-१०८", "content_sanskrit": "काश्यपः कारयामास पाण्डोः प्रेतस्य तां क्रियाम्।\nपुरोहितोक्तविधिना पाण्डोः पुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2006851, "chapter_id": 1133, "verse_number": "१-१३४-१०९", "content_sanskrit": "तेनाग्निनाऽदहत्पाण्डुं कृत्वा चापि क्रियास्तदा।\nरुदञ्छोकाभिसंतप्तः पपात भुवि पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2006852, "chapter_id": 1133, "verse_number": "१-१३४-११०", "content_sanskrit": "ऋषीन्पुत्रान्पृथां चैव विसृज्य च नृपात्मज।\nनमस्कृत्य चिताग्निस्थं धर्मपत्नी नरर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2006853, "chapter_id": 1133, "verse_number": "१-१३४-१११", "content_sanskrit": "मद्रराजसुता तूर्णमन्वारोहद्यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2006854, "chapter_id": 1133, "verse_number": "१-१३४-११२", "content_sanskrit": "अहताम्बरसंवीतो भ्रातृभिः सहितोऽनघः।\nउदकं कृतवांस्तत्र पुरोहितमते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2006855, "chapter_id": 1133, "verse_number": "१-१३४-११३", "content_sanskrit": "अर्हतस्तस्य कृत्यानि शतशृङ्गनिवासिनः।\nतापसा विधिवच्चक्रुश्चारणा ऋषिभिः सह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2006856, "chapter_id": 1133, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि चतुस्त्रिंशदधिकशततमोऽध्यायः॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}]