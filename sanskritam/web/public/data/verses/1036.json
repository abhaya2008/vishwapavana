[{"id": 2001884, "chapter_id": 1036, "verse_number": "१-३७-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001885, "chapter_id": 1036, "verse_number": "१-३७-१", "content_sanskrit": "मातुः सकाशात्तं शापं श्रुत्वा वै पन्नगोत्तमः।\nवासुकिश्चिन्तयामास शापोऽयं न भवेत्कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001886, "chapter_id": 1036, "verse_number": "१-३७-२", "content_sanskrit": "ततः स मन्त्रयामास भ्रातृभिः सह सर्वशः।\nऐरावतप्रभृतिभिः सर्वैर्धर्मपरायणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001887, "chapter_id": 1036, "verse_number": "१-३७-३x", "content_sanskrit": "वासुकिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001888, "chapter_id": 1036, "verse_number": "१-३७-३", "content_sanskrit": "अयं शापो यथोद्दिष्टो विदितं वस्तथाऽनघाः।\nतस्य शापस्य मोक्षार्थं मन्त्रयित्वा यतामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001889, "chapter_id": 1036, "verse_number": "१-३७-४", "content_sanskrit": "सर्वेषामेव शापानां प्रतिघातो हि विद्यते।\nन तु मात्राऽभिशप्तानां मोक्षः क्वचन विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001890, "chapter_id": 1036, "verse_number": "१-३७-५", "content_sanskrit": "अव्ययस्याप्रमेयस्य सत्यस्य च तथाग्रतः।\nशप्ता इत्येव मे श्रुत्वा जायते हृदि वेपथुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001891, "chapter_id": 1036, "verse_number": "१-३७-६", "content_sanskrit": "नूनं सर्वविनाशोऽयमस्माकं समुपागतः।\nशापः सृष्टो महाघोरो मात्रा खल्वविनीतया।\nन ह्येतां सोऽव्ययो देवः शपत्नीं प्रत्यषेधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001892, "chapter_id": 1036, "verse_number": "१-३७-७", "content_sanskrit": "तस्मात्संमन्त्रयामोऽद्य भुजङ्गानामनामयम्।\nयथा भवेद्धि सर्वेषां मा नः कालोऽत्यगादयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001893, "chapter_id": 1036, "verse_number": "१-३७-८", "content_sanskrit": "सर्व एव हि नस्तावद्बुद्धिमन्तो विचक्षणाः।\nअपि मन्त्रयमाणा हि हेतुं पश्याम मोक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001894, "chapter_id": 1036, "verse_number": "१-३७-९", "content_sanskrit": "यथा नष्टं पुरा देवा गूढमग्निं गुहागतम्।\nयथा स यज्ञो न भवेद्यथा वाऽपि पराभवः।\nजनमेजयस्य सर्पाणां विनाशकरणाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001895, "chapter_id": 1036, "verse_number": "१-३७-१०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001896, "chapter_id": 1036, "verse_number": "१-३७-१०", "content_sanskrit": "तथेत्युक्त्वा ततः सर्वे काद्रवेयाः समागताः।\nसमयं चकिरे तत्र मन्त्रबुद्धिविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001897, "chapter_id": 1036, "verse_number": "१-३७-११", "content_sanskrit": "एके तत्राब्रुवन्नागा वयं भूत्वा द्विजर्षभाः।\nजनमेजयं तु भिक्षामो यज्ञस्ते न भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001898, "chapter_id": 1036, "verse_number": "१-३७-१२", "content_sanskrit": "अपरे त्वब्रुवन्नागास्तत्र पण्डितमानिनः।\nमन्त्रिणोऽस्य वयं सर्वे भविष्यामः सुसंमताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001899, "chapter_id": 1036, "verse_number": "१-३७-१३", "content_sanskrit": "स नः प्रक्ष्यति सर्वेषु कार्येष्वर्थविनिश्चयम्।\nतत्र बुद्धिं प्रदास्यामो यथा यज्ञो निवर्त्स्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001900, "chapter_id": 1036, "verse_number": "१-३७-१४", "content_sanskrit": "स नो बहुमतान्राजा बुद्ध्या बुद्धिमतां वरः।\nयज्ञार्थं प्रक्ष्यति व्यक्तं नेति वक्ष्यामहे वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001901, "chapter_id": 1036, "verse_number": "१-३७-१५", "content_sanskrit": "दर्शयन्तो बहून्दोषान्प्रेत्य चेह च दारुणान्।\nहेतुभिः कारणैश्चैव यथा यज्ञो भवेन्न सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001902, "chapter_id": 1036, "verse_number": "१-३७-१६", "content_sanskrit": "अथवा य उपाध्यायः क्रतोस्तस्य भविष्यति।\nसर्पसत्रविधानज्ञो राजकार्यहिते रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001903, "chapter_id": 1036, "verse_number": "१-३७-१७", "content_sanskrit": "तं गत्वा दशतां कश्चिद्भुजङ्गः स मरिष्यति।\nतस्मिन्मृते यज्ञकारे क्रतुः स न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001904, "chapter_id": 1036, "verse_number": "१-३७-१८", "content_sanskrit": "ये चान्ये सर्पसत्रज्ञा भविष्यन्त्यस्य चर्त्विजः।\nतांश्च सर्वान्दशिष्यामः कृतमेवं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001905, "chapter_id": 1036, "verse_number": "१-३७-१९", "content_sanskrit": "अपरे त्वब्रुवन्नागा धर्मात्मानो दयालवः।\nअबुद्धिरेषा भवतां ब्रह्महत्या न शोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001906, "chapter_id": 1036, "verse_number": "१-३७-२०", "content_sanskrit": "सम्यक्सद्धर्ममूला वै व्यसने शान्तिरुत्तमा।\nअधर्मोत्तरता नाम कृत्स्नं व्यापादयेज्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001907, "chapter_id": 1036, "verse_number": "१-३७-२१", "content_sanskrit": "अपरे त्वब्रुवन्नागाः समिद्धं जातवेदसम्।\nवर्षैर्निर्वापयिष्यामो मेघा भूत्वा सविद्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001908, "chapter_id": 1036, "verse_number": "१-३७-२२", "content_sanskrit": "स्रुग्भाण्डं निशि गत्वा च अपरे भुजगोत्तमाः।\nप्रमत्तानां हरन्त्वाशु विघ्न एवं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001909, "chapter_id": 1036, "verse_number": "१-३७-२३", "content_sanskrit": "यज्ञे वा भुजगास्तस्मिञ्शतशोऽथ सहस्रशः।\nजनान्दशन्तु वै सर्वे नैवं त्रासो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001910, "chapter_id": 1036, "verse_number": "१-३७-२४", "content_sanskrit": "अथवा संस्कृतं भोज्यं दूषयन्तु भुजङ्गमाः।\nस्वेन मूत्रपुरीषेण सर्वभोज्यविनाशिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001911, "chapter_id": 1036, "verse_number": "१-३७-२५", "content_sanskrit": "अपरे त्वब्रुवंस्तत्र ऋत्विजोऽस्य भवामहे।\nयज्ञविघ्नं करिष्यामो दक्षिणा दीयतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001912, "chapter_id": 1036, "verse_number": "१-३७-२६", "content_sanskrit": "वश्यतां च गतोऽसौ नः करिष्यति यथेप्सितम्।\nअपरे त्वब्रुवंस्तत्र जले प्रक्रीडितं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001913, "chapter_id": 1036, "verse_number": "१-३७-२७", "content_sanskrit": "गृहमानीय बध्नीमः क्रतुरेवं भवेन्न सः।\nअपरे त्वब्रुवंस्तत्र नागाः पण्डितमानिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001914, "chapter_id": 1036, "verse_number": "१-३७-२८", "content_sanskrit": "दशामस्तं प्रगृह्याशु कृतपेवं भविष्यति।\nछिन्नं मूलमनर्थानां मृते तस्मिन्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001915, "chapter_id": 1036, "verse_number": "१-३७-२९", "content_sanskrit": "एषा नो नैष्ठिकी बुद्धिः सर्वेषामीक्षणश्रवः।\nअथ यन्मन्यसे राजन्द्रुतं तत्संविधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001916, "chapter_id": 1036, "verse_number": "१-३७-३०", "content_sanskrit": "इत्युक्त्वा समुदैक्षन्त वासुकिं पन्नगोत्तमम्।\nवासुकिश्चापि संचिन्त्य तानुवाच भुजङ्गमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001917, "chapter_id": 1036, "verse_number": "१-३७-३१", "content_sanskrit": "नैषा वो नैष्ठिकी बुद्धिर्मता कर्तुं भुजङ्गमाः।\nसर्वेषामेव मे बुद्धिः पन्नगानां न रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2001918, "chapter_id": 1036, "verse_number": "१-३७-३२", "content_sanskrit": "किं तत्र संविधातव्यं भवतां स्याद्धितं तु यत्।\nश्रेयः प्रसादनं मन्ये कश्यपश्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2001919, "chapter_id": 1036, "verse_number": "१-३७-३३", "content_sanskrit": "ज्ञातिवर्गस्य सौहार्दादात्मनश्च भुजङ्गमाः।\nन च जानाति मे बुद्धिः किंचित्कर्तुं वचो हिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2001920, "chapter_id": 1036, "verse_number": "१-३७-३४", "content_sanskrit": "मया हीदं विधातव्यं भवतां यद्धितं भवेत्।\nअनेनाहं भृशं तप्ये गुणदोषौ मदाश्रयौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2001921, "chapter_id": 1036, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि सप्तत्रिंशोऽध्यायः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]