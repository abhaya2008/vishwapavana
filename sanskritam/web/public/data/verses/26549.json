[{"id": 7006549000, "chapter_id": 26549, "verse_number": "३-८८-१", "content_sanskrit": "भगवता श्रीशिवेन श्रीविष्णोः स्तुतिः वैशम्पायन उवाच ततो वृषध्वजो देवः शूली साक्षादुमापतिः ।\nकरं करेण संस्पृश्य विष्णोश्चक्रधरस्य ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006549001, "chapter_id": 26549, "verse_number": "३-८८-२", "content_sanskrit": "प्रोवाच भगवान् रुद्रः केशवं गरुडध्वजम् ।\nशृण्वतां सर्वदेवानां मुनीनां भावितात्मनाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006549002, "chapter_id": 26549, "verse_number": "३-८८-३", "content_sanskrit": "किमिदं देवदेवेश चक्रपाणे जनार्दन ।\nतपश्चर्या किमर्थं ते प्रार्थना तव का विभो ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006549003, "chapter_id": 26549, "verse_number": "३-८८-४", "content_sanskrit": "स्वयं विष्णुर्भवान्नित्यस्तपस्त्वं तपसां हरे ।\nपुत्रार्थं यदि ते देव तपश्चर्या जनार्दन ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006549004, "chapter_id": 26549, "verse_number": "३-८८-५", "content_sanskrit": "पुत्रो दत्तो मया देव पूर्वमेव जगत्पते ।\nशृणु तत्रापि भगवन् कारणं कारणात्मक ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006549005, "chapter_id": 26549, "verse_number": "३-८८-६", "content_sanskrit": "तपश्चर्तुं प्रवृत्तोऽहं कुतश्चित् कारणाद्धरे ।\nवर्षायुतं महाघोरं पुरा कृतयुगे तदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006549006, "chapter_id": 26549, "verse_number": "३-८८-७", "content_sanskrit": "भवानी तत्र मे देव परिचर्तुं तदाभवत् ।\nपित्रा नियुक्ता देवेश उमैषा वरवर्णिनी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006549007, "chapter_id": 26549, "verse_number": "३-८८-८", "content_sanskrit": "भीत इन्द्रस्तदा देव मारं मां प्रैषयत्तदा ।\nमधुना सह संयुक्तो मारो मामागतस्तदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006549008, "chapter_id": 26549, "verse_number": "३-८८-९", "content_sanskrit": "लक्ष्यं मामकरोत् तत्र बाणस्य प्रेषितस्य ह ।\nएष मां सेवते तत्र दानात् पुष्पादिनां हरे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006549009, "chapter_id": 26549, "verse_number": "३-८८-१०", "content_sanskrit": "ततः क्रुद्धोऽहमभवं दृष्ट्वा मारं तथाविधम् ।\nक्रुद्ध्यतो मम देवेश नेत्रादग्निः पपात ह ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006549010, "chapter_id": 26549, "verse_number": "३-८८-११", "content_sanskrit": "सोऽयमग्निस्तदा मारं भस्मसात्कृतवान् हरे ।\nअचिन्तयं तदा विष्णो शक्रस्यैतच्चिकीर्षितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006549011, "chapter_id": 26549, "verse_number": "३-८८-१२", "content_sanskrit": "ततः प्रभृति देवेश दया तं प्रति वर्तते ।\nब्रह्मणा च नियुक्तोऽस्मि प्रीतस्तत्र जनार्दन ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006549012, "chapter_id": 26549, "verse_number": "३-८८-१३", "content_sanskrit": "नियुक्तः पुत्ररूपेण स ते देव जगत्पते ।\nज्येष्ठस्तव सुतो देव प्रद्युम्नेत्यभिविश्रुतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006549013, "chapter_id": 26549, "verse_number": "३-८८-१४", "content_sanskrit": "स्मरं तं विद्धि देवेश नात्र कार्या विचारणा ।\nइत्युक्त्वा पुनराहेदं याथात्म्यं दर्शयन्निव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006549014, "chapter_id": 26549, "verse_number": "३-८८-१५", "content_sanskrit": "मुनीनां श्रोतुकामानां याथात्म्यं तत्र सत्तमः ।\nअञ्जलिं सम्पुटं कृत्वा विष्णुमुद्दिश्य शंकरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006549015, "chapter_id": 26549, "verse_number": "३-८८-१६", "content_sanskrit": "उमया सार्धमीशानो याथात्म्यं वक्तुमैहत ।\nहरे कुर्वति तत्रैवमञ्जलिं कुरुसत्तम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006549016, "chapter_id": 26549, "verse_number": "३-८८-१७", "content_sanskrit": "मुनयो देवगन्धर्वाः सिद्धाश्च सह किन्नराः ।\nअञ्जलिं चक्रिरे विष्णौ देवदेवेश्वरे हरौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006549017, "chapter_id": 26549, "verse_number": "३-८८-१८", "content_sanskrit": "महेश्वर उवाच यत्तत्कारणमाहुस्तत्सांख्याः प्रकृतिसंज्ञकम् ।\nततो महान् समुत्पन्नः प्रकृतिर्यस्य कारणम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006549018, "chapter_id": 26549, "verse_number": "३-८८-१९", "content_sanskrit": "त्रिधा भूतं जगद्योनिं प्रधानं कारणात्मकम् ।\nसत्त्वं रजस्तमो विष्णो जगदण्डं जनार्दन ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006549019, "chapter_id": 26549, "verse_number": "३-८८-२०", "content_sanskrit": "तस्य कारणमाहुस्त्वां सांख्यप्रकृतिसंज्ञकम् ।\nतद्रूपेण भवान् विष्णो परिणम्याधितिष्ठति ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006549020, "chapter_id": 26549, "verse_number": "३-८८-२१", "content_sanskrit": "तस्मात्तु महतो घोरादहंकारो महानभूत् ।\nस त्वमादौ जगन्नाथ परिणामस्तथा हि सः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006549021, "chapter_id": 26549, "verse_number": "३-८८-२२", "content_sanskrit": "अहंकारात् प्रभो देव करणानि महान्ति च ।\nतन्मात्राणि तथा पञ्च भूतानि प्रभवन्त्युत ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006549022, "chapter_id": 26549, "verse_number": "३-८८-२३", "content_sanskrit": "तानि त्वामाहुरीशानं भूतानीह जगत्पते ।\nपृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006549023, "chapter_id": 26549, "verse_number": "३-८८-२४", "content_sanskrit": "चक्षुर्घ्राणं तथा स्पर्शो रसनं श्रोत्रमेव च ।\nमनः षष्ठं तथा देव प्रेरकं तत्र तत्र ह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006549024, "chapter_id": 26549, "verse_number": "३-८८-२५", "content_sanskrit": "कर्मेन्द्रियाणि चान्यानि वागादीनि जनार्दन ।\nत्वमेव तानि सर्वाणि करोषि नियतात्मवान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006549025, "chapter_id": 26549, "verse_number": "३-८८-२६", "content_sanskrit": "स्वेषु स्वेषु जगन्नाथ विषयेषु तथा हरे ।\nनिवेशयसि देवेश योग्यामिन्द्रियपद्धतिम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006549026, "chapter_id": 26549, "verse_number": "३-८८-२७", "content_sanskrit": "यदा त्वं रजसा युक्तस्तदा भूतानि सृष्टवान् ।\nयदाच सत्त्वयुक्तोऽसि तदा पाता जगत्त्रयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006549027, "chapter_id": 26549, "verse_number": "३-८८-२८", "content_sanskrit": "यदा त्वं तमसाऽऽकृष्टस्तदा संहरसे जगत् ।\nत्रिभिरेव गुणैर्युक्तः सृष्टिरक्षाविनाशने ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006549028, "chapter_id": 26549, "verse_number": "३-८८-२९", "content_sanskrit": "वर्तसे त्रिविधां भूतिमादाय नियतात्मवान् ।\nइन्द्रियाणीन्द्रियार्थेषु नियोजयसि माधव ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006549029, "chapter_id": 26549, "verse_number": "३-८८-३०", "content_sanskrit": "प्राणिनामुपभोगार्थमन्तः स्थित्वा जगद्गुरो ।\nतस्मात् सर्वत्र भूतेषु वर्तते सर्वभोगवान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006549030, "chapter_id": 26549, "verse_number": "३-८८-३१", "content_sanskrit": "ब्रह्मा त्वं सृष्टिकाले तु स्थितौ विष्णुरसि प्रभो ।\nसंहारे रुद्रनामासि त्रिधामा त्वमसि प्रभो ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006549031, "chapter_id": 26549, "verse_number": "३-८८-३२", "content_sanskrit": "भूमिरापोऽनलो वायुः खं मनो बुद्धिरेव च ।\nएताः प्रकृतयो देव भिन्नाः सर्वत्र ते हरे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006549032, "chapter_id": 26549, "verse_number": "३-८८-३३", "content_sanskrit": "सहस्रशीर्षा पुरुषः सहस्राक्षः सहस्रपात् ।\nसहस्रधारः साहस्री सहस्रात्मा दिवस्पतिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006549033, "chapter_id": 26549, "verse_number": "३-८८-३४", "content_sanskrit": "भूमिं सर्वामिमां प्राप्य सप्तद्वीपां ससागराम् ।\nअणुः सर्वत्रगो भूत्वा अत्यतिष्ठद् दशाङ्गुलम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006549034, "chapter_id": 26549, "verse_number": "३-८८-३५", "content_sanskrit": "त्वमेवेदं जगत् सर्वं यद् भूतं यद् भविष्यति ।\nत्वत्तो विराट् प्रादुरभूत् सम्राट् चैव जनार्दन ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006549035, "chapter_id": 26549, "verse_number": "३-८८-३६", "content_sanskrit": "तव वक्त्राज्जगन्नाथ ब्राह्मणो लोकरक्षकः ।\nप्रादुरासीत्पुराणात्मन् षट्कर्मनिरतः सदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006549036, "chapter_id": 26549, "verse_number": "३-८८-३७", "content_sanskrit": "राजन्यस्तु तथा बाह्वोरासीत् संरक्षणे रतः ।\nऊर्वोर्वैश्यस्तथा विष्णो पादाच्छूद्र उदाहृतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006549037, "chapter_id": 26549, "verse_number": "३-८८-३८", "content_sanskrit": "एवं वर्णा जगन्नाथ तव देहाज्जनार्दन ।\nमनसस्तव देवेश चन्द्रमाः समपद्यत ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006549038, "chapter_id": 26549, "verse_number": "३-८८-३९", "content_sanskrit": "सुखकृत् सर्वभूतानां शीतांशुरमितप्रभः ।\nअक्ष्णोः सूर्यः समुत्पन्नः सर्वप्राणिविलोचनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006549039, "chapter_id": 26549, "verse_number": "३-८८-४०", "content_sanskrit": "यस्य भासा जगत् सर्वं भासते भानुमानसौ ।\nमुखादिन्द्रश्च अग्निश्च प्राणाद् वायुरजायत ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006549040, "chapter_id": 26549, "verse_number": "३-८८-४१", "content_sanskrit": "नाभेरभूदन्तरिक्षं तव देव जनार्दन ।\nद्यौरासीत् तु महाघोरा शिरसस्तव गोपते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006549041, "chapter_id": 26549, "verse_number": "३-८८-४२", "content_sanskrit": "पद्भ्यां भूमिः समुत्पन्ना दिशः श्रोत्राज्जगत्पते ।\nएव सृष्ट्वा जगत्सर्वं व्याप्य सर्वं व्यवस्थितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006549042, "chapter_id": 26549, "verse_number": "३-८८-४३", "content_sanskrit": "व्याप्य सर्वानिमाँल्लोकान् स्थितः सर्वत्र केशव ।\nततश्च विष्णुनामासि धातोर्व्याप्तेश्च दर्शनात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006549043, "chapter_id": 26549, "verse_number": "३-८८-४४", "content_sanskrit": "नारा आपः समाख्यातास्तासामयनमादितः ।\nयतस्त्वं भूतभव्येश तन्नारायणशब्दितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006549044, "chapter_id": 26549, "verse_number": "३-८८-४५", "content_sanskrit": "हरसि प्राणिनो देव ततो हरिरिति स्मृतः ।\nशंकरोऽसि सदा देव ततः शंकरतां गतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006549045, "chapter_id": 26549, "verse_number": "३-८८-४६", "content_sanskrit": "बृहत्त्वाद् बृंहणत्वाच्च तस्माद् ब्रह्मेति शब्दितः ।\nमधुरिन्द्रियनामेति ततो मधुनिषूदनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006549046, "chapter_id": 26549, "verse_number": "३-८८-४७", "content_sanskrit": "हृषीकाणीन्द्रियाण्याहुस्तेषामीशो यतो भवान् ।\nहृषीकेशस्ततो विष्णो ख्यातो देवेषु केशव ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006549047, "chapter_id": 26549, "verse_number": "३-८८-४८", "content_sanskrit": "क इति ब्रह्मणो नाम ईशोऽहं सर्वदेहिनाम् ।\nआवां तवाङ्गसम्भूतौ तस्मात्केशवनामवान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006549048, "chapter_id": 26549, "verse_number": "३-८८-४९", "content_sanskrit": "मा विद्या च हरे प्रोक्ता तस्या ईशो यतो भवान् ।\nतस्मान्माधवनामासि धवः स्वामीतिब्दितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006549049, "chapter_id": 26549, "verse_number": "३-८८-५०", "content_sanskrit": "गौरेषा तु यतो वाणी तां च वेद यतो भवान् ।\nगोविन्दस्तु ततो देव मुनिभिः कथ्यते भवान् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006549050, "chapter_id": 26549, "verse_number": "३-८८-५१", "content_sanskrit": "त्रिरित्येव त्रयो वेदाः कीर्तिता मुनिसत्तमैः ।\nक्रमते तांस्तथा सर्वांस्त्रिविक्रम इति श्रुतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006549051, "chapter_id": 26549, "verse_number": "३-८८-५२", "content_sanskrit": "अणुर्वामननामासि यतस्त्वं वामनाख्यया ।\nमननान्मुनिरेवासि यमनाद् यतिरुच्यसे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006549052, "chapter_id": 26549, "verse_number": "३-८८-५३", "content_sanskrit": "तपश्चरसि यस्मात्त्वं तपस्वीति च शब्दितः ।\nवसन्ति त्वयि भूतानि भूतावासस्ततो हरे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006549053, "chapter_id": 26549, "verse_number": "३-८८-५४", "content_sanskrit": "ईशस्त्वं सर्वभूतानामीश्वरोऽसि ततो हरे ।\nप्रणवः सर्ववेदानां गायत्री छन्दसां प्रभो ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006549054, "chapter_id": 26549, "verse_number": "३-८८-५५", "content_sanskrit": "अक्षराणामकारस्त्वं स्फोटस्त्वं वर्णसंश्रयः ।\nरुद्राणामहमेवासि वसूनां पावको भवान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006549055, "chapter_id": 26549, "verse_number": "३-८८-५६", "content_sanskrit": "अश्वत्थो वृक्षजातीनां ब्रह्मा लोकगुरुर्भवान् ।\nमेरुस्त्वं पर्वतेन्द्राणां देवर्षीणां च नारदः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006549056, "chapter_id": 26549, "verse_number": "३-८८-५७", "content_sanskrit": "दानवानां भवान् दैत्यः प्रह्रादो भक्तवत्सलः ।\nसर्पाणामेव सर्वेषां भवान् वासुकिसंज्ञितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006549057, "chapter_id": 26549, "verse_number": "३-८८-५८", "content_sanskrit": "गुह्यकानां च सर्वेषां भवान् धनद एव च ।\nवरुणो यादसां राजा गङ्गा त्रिपथभाग् भवान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006549058, "chapter_id": 26549, "verse_number": "३-८८-५९", "content_sanskrit": "आदिस्त्वं सर्वभूतानां मध्यमन्तस्तथा भवान् ।\nत्वत्तः समभवद् विश्वं त्वयि सर्वं प्रलीयते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006549059, "chapter_id": 26549, "verse_number": "३-८८-६०", "content_sanskrit": "अहं त्वं सर्वगो देव त्वमेवाहं जनार्दन ।\nआवयोरन्तरं नास्ति शब्दैरर्थैर्जगत्पते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006549060, "chapter_id": 26549, "verse_number": "३-८८-६१", "content_sanskrit": "नामानि तव गोविन्द यानि लोके महान्ति च ।\nतान्येव मम नामानि नात्र कार्या विचारणा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006549061, "chapter_id": 26549, "verse_number": "३-८८-६२", "content_sanskrit": "त्वदुपासा जगन्नाथ सैवास्ति मम गोपते ।\nयश्च त्वां द्वेष्टि देवेश स मां द्वेष्टि न संशयः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006549062, "chapter_id": 26549, "verse_number": "३-८८-६३", "content_sanskrit": "त्वद्विस्तारो यतो देव अहं भूतपतिस्ततः ।\nन तदस्ति विना देव यत् ते विरहितं हरे ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006549063, "chapter_id": 26549, "verse_number": "३-८८-६४", "content_sanskrit": "यदासीद् वर्तते यच्च यच्च भावि जगत्पते ।\nसर्वे त्वमेव देवेश विना किंचित्त्वया न हि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006549064, "chapter_id": 26549, "verse_number": "३-८८-६५", "content_sanskrit": "स्तुवन्ति देवाः सततं भवन्तं स्वैर्गुणैः प्रभो ।\nऋक्च त्वं यजुरेवासि सामासि सततं प्रभो ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006549065, "chapter_id": 26549, "verse_number": "३-८८-६६", "content_sanskrit": "किमुच्यते मया देव सर्वं त्वं भूतभावन ।\nनमः सर्वात्मना देव विष्णो माधव केशव ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006549066, "chapter_id": 26549, "verse_number": "३-८८-६७", "content_sanskrit": "नमस्करोमि सर्वात्मन् नमस्तेऽस्तु सदा हरे ।\nनमः पुष्करनाभाय वन्दे त्वामहमीश्बर ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]