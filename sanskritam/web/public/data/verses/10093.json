[{"id": 6000093000, "chapter_id": 10093, "verse_number": null, "content_sanskrit": "अथ एकोनत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000093001, "chapter_id": 10093, "verse_number": null, "content_sanskrit": "प्राचीनबर्हिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.001.m4a", "display_order": 2}, {"id": 6000093002, "chapter_id": 10093, "verse_number": "४-२९-१", "content_sanskrit": "भगवंस्ते वचोऽस्माभिर्न सम्यगवगम्यते।\nकवयस्तद्विजानन्ति न वयं कर्ममोहिताः॥ ४/२९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.002.m4a", "display_order": 3, "topics": [{"text": "पूर्वोक्तप्रमेयस्य दुर्बोधत्वात्तत्स्पष्टीकरणार्थं प्राचीनवर्हिषा प्रार्थितेन नारदेन तद्विवरणम्", "range": "१–२४"}]}, {"id": 6000093003, "chapter_id": 10093, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.003.m4a", "display_order": 4}, {"id": 6000093004, "chapter_id": 10093, "verse_number": "४-२९-२", "content_sanskrit": "पुरुषं पुरञ्जनं विद्याद् यद् व्यनक्त्यात्मनः पुरम्।\nएकद्वित्रिचतुष्पादं बहुपादमपादकम्॥ ४/२९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.004.m4a", "display_order": 5}, {"id": 6000093005, "chapter_id": 10093, "verse_number": "४-२९-३", "content_sanskrit": "योऽविज्ञाताह्वयस्तस्य पुरुषस्य सखेश्वरः।\nयन्न विज्ञायते रूपैर्नामभिर्वा क्रियागुणैः॥ ४/२९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.005.m4a", "display_order": 6}, {"id": 6000093006, "chapter_id": 10093, "verse_number": "४-२९-४", "content_sanskrit": "यदा जिघृक्षन् पुरुषः कार्त्‍स्न्येन प्रकृतेर्गुणान्।\nनवद्वारं द्विहस्ताङ्घ्रि तत्रामनुत साध्विति॥ ४/२९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.006.m4a", "display_order": 7}, {"id": 6000093007, "chapter_id": 10093, "verse_number": "४-२९-५", "content_sanskrit": "बुद्धिं तु प्रमदां विद्यान्ममाहमिति यत्कृतम्।\nयामधिष्ठाय देहेऽस्मिन् पुमान् भुङ्क्तेऽक्षिभिर्गुणान्॥ ४/२९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.007.m4a", "display_order": 8}, {"id": 6000093008, "chapter_id": 10093, "verse_number": "४-२९-६", "content_sanskrit": "सखाय इन्द्रियगणो ज्ञानं कर्म च यत्कृतम्।\nसख्यस्तद्वृत्तयः प्राणः पञ्चवृत्तिर्यथोरगः॥ ४/२९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.008.m4a", "display_order": 9}, {"id": 6000093009, "chapter_id": 10093, "verse_number": "४-२९-७", "content_sanskrit": "बृहद्बलं मनो विद्यादुभयेन्द्रियनायकम्।\nपञ्चालाः पञ्चविषया यन्मध्ये नवखं पुरम्॥ ४/२९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.009.m4a", "display_order": 10}, {"id": 6000093010, "chapter_id": 10093, "verse_number": "४-२९-८", "content_sanskrit": "अक्षिणी नासिके कर्णौ मुखं शिश्नगुदाविति।\nद्वे द्वे द्वारौ बहिर्याति तत्तदिन्द्रियसंयुतः॥ ४/२९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.010.m4a", "display_order": 11}, {"id": 6000093011, "chapter_id": 10093, "verse_number": "४-२९-९", "content_sanskrit": "अक्षिणी नासिके आस्यमिति पञ्च पुरस्कृताः।\nदक्षिणा दक्षिणः कर्ण उत्तरा चोत्तरः स्मृतः॥ ४/२९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.011.m4a", "display_order": 12}, {"id": 6000093012, "chapter_id": 10093, "verse_number": "४-२९-१०", "content_sanskrit": "पश्चिमे इत्यधोद्वारौ गुदशिश्नाविहोदिते।\nखद्योताविर्मुखी चात्र नेत्रे एकत्र निर्मिते॥ ४/२९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.012.m4a", "display_order": 13}, {"id": 6000093013, "chapter_id": 10093, "verse_number": "४-२९-११", "content_sanskrit": "रूपं विभ्राजितं ताभ्यां विचष्टे चक्षुषेश्वरः।\nनलिनी नालिनी नासे गन्धः सौरभ उच्यते॥ ४/२९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.013.m4a", "display_order": 14}, {"id": 6000093014, "chapter_id": 10093, "verse_number": "४-२९-१२", "content_sanskrit": "घ्राणोऽवधूतो मुख्याऽऽस्यं विपणो रसविद् रसः।\nआपणो व्यवहारोऽत्र चित्रमन्धो बहूदनम्॥ ४/२९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.014.m4a", "display_order": 15}, {"id": 6000093015, "chapter_id": 10093, "verse_number": "४-२९-१३", "content_sanskrit": "पितृभूर्दक्षिणः कर्ण उत्तरो देवभूः स्मृतः।\nप्रवृत्तं च निवृत्तं च शास्‍त्रं पाञ्चालसंज्ञितम्॥ ४/२९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.015.m4a", "display_order": 16}, {"id": 6000093016, "chapter_id": 10093, "verse_number": "४-२९-१४", "content_sanskrit": "पितृयानं देवयानं श्रोत्रात् श्रुतधरो व्रजेत्।\nआसुरी मेहनार्थं द्वार्व्यवायो ग्रामिणां रतिः॥ ४/२९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.016.m4a", "display_order": 17}, {"id": 6000093017, "chapter_id": 10093, "verse_number": "४-२९-१५", "content_sanskrit": "उपस्थो दुर्मदः प्रोक्तो निर्ऋतिर्गुद उच्यते।\nवैशसं नरकं पायुर्लुब्धकोऽन्धौ तु मे शृणु॥ ४/२९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.017.m4a", "display_order": 18}, {"id": 6000093018, "chapter_id": 10093, "verse_number": "४-२९-१६", "content_sanskrit": "हस्तपादौ पुमांस्ताभ्यां युक्तो याति करोति च।\nअन्तःपुरं च हृदयं विषूचिर्मन उच्यते॥ ४/२९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.018.m4a", "display_order": 19}, {"id": 6000093019, "chapter_id": 10093, "verse_number": "४-२९-१७", "content_sanskrit": "तत्र मोहं प्रसादं वा हर्षं प्राप्नोति तद्गुणैः।\nयथा यथा विक्रियते गुणाक्तो विकरोति वा॥ ४/२९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.019.m4a", "display_order": 20}, {"id": 6000093020, "chapter_id": 10093, "verse_number": "४-२९-१८", "content_sanskrit": "तथा तथोपद्रष्टाऽऽत्मा तद्वृत्तिरिति कीर्त्यते।\nदेहो रथस्त्विन्द्रियाश्वः संवत्सरवयोगतिः॥ ४/२९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.020.m4a", "display_order": 21}, {"id": 6000093021, "chapter_id": 10093, "verse_number": "४-२९-१९", "content_sanskrit": "द्विकर्मचक्रस्‍त्रिगुणध्वजः पञ्चासुबन्धुरः।\nमनोरश्मिर्बुद्धिसूतो हृन्नीडो द्वन्द्वकूबरः॥ ४/२९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.021.m4a", "display_order": 22}, {"id": 6000093022, "chapter_id": 10093, "verse_number": "४-२९-२०", "content_sanskrit": "पञ्चेन्द्रियार्थप्रक्षेपः सप्तधातुवरूथकः।\nआकूतिर्विक्रमोबाह्यो मृगतृष्णां प्रधावति॥ ४/२९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.022.m4a", "display_order": 23}, {"id": 6000093023, "chapter_id": 10093, "verse_number": "४-२९-२१", "content_sanskrit": "एकादशेन्द्रियचमूः पञ्चसूनाविनोदकृत्।\nसंवत्सरश्चण्डवेगः कालो येनोपलक्षितः॥ ४/२९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.023.m4a", "display_order": 24}, {"id": 6000093024, "chapter_id": 10093, "verse_number": "४-२९-२२", "content_sanskrit": "तस्याहानीह गन्धर्वा गन्धर्व्यो रात्रयः स्मृताः।\nहरन्त्यायुः परिक्रान्त्या षष्ट्युत्तरशतत्रयम्॥ ४/२९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.024.m4a", "display_order": 25}, {"id": 6000093025, "chapter_id": 10093, "verse_number": "४-२९-२३", "content_sanskrit": "कालकन्या जरा साक्षाल्लोकस्तां नाभिनन्दति।\nस्वसारं जगृहे मृत्युः क्षयाय यवनेश्वरः॥ ४/२९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.025.m4a", "display_order": 26}, {"id": 6000093026, "chapter_id": 10093, "verse_number": "४-२९-२४", "content_sanskrit": "आधयो व्याधयस्तस्य सैनिका यवनाः खलाः।\nभूतोपसर्गा अरयः प्रज्वारो द्विविधो ज्वरः॥ ४/२९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.026.m4a", "display_order": 27}, {"id": 6000093027, "chapter_id": 10093, "verse_number": "४-२९-२५", "content_sanskrit": "एवं बहुविधैर्दुःखैर्दैवभूतात्मसम्भवैः।\nक्लिश्यमानः शतं वर्षं देहे देही तमोवृतः॥ ४/२९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.027.m4a", "display_order": 28, "topics": [{"text": "अस्यां गाथायाम् अध्यात्मसन्देशः", "range": "२५–५७"}]}, {"id": 6000093028, "chapter_id": 10093, "verse_number": "४-२९-२६", "content_sanskrit": "प्राणेन्द्रियमनोधर्मान् आत्मन्यध्यस्य निर्गुणः।\nशेते कामलवं ध्यायन् ममाहमिति कर्मकृत्॥ ४/२९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.028.m4a", "display_order": 29}, {"id": 6000093029, "chapter_id": 10093, "verse_number": "४-२९-२७", "content_sanskrit": "यदाऽऽत्मानमविज्ञाय भगवन्तं परं गुरुम्।\nपुरुषस्तु विषज्जेत गुणेषु प्राकृतेष्वदृक्॥ ४/२९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.029.m4a", "display_order": 30}, {"id": 6000093030, "chapter_id": 10093, "verse_number": "४-२९-२८", "content_sanskrit": "गुणाभिमानी स तदा कर्माणि कुरुतेऽवशः।\nशुक्लं कृष्णं लोहितं वा यथाकर्माभिजायते॥ ४/२९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.030.m4a", "display_order": 31}, {"id": 6000093031, "chapter_id": 10093, "verse_number": "४-२९-२९", "content_sanskrit": "शुक्लान् प्रकाशभूयिष्ठान् लोकानाप्नोति कर्हिचित्।\nदुःखोदर्कान् क्रियायासान् तमश्शोकोत्कटान्क्‍वचित्॥ ४/२९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.031.m4a", "display_order": 32}, {"id": 6000093032, "chapter_id": 10093, "verse_number": "४-२९-३०", "content_sanskrit": "क्‍वचित् पुमान्क्‍वचिच्च स्‍त्री क्‍वचिन्नोभयमन्धधीः।\nदेवो मनुष्यस्तिर्यग् वा यथाकर्मगुणं भवः॥ ४/२९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.032.m4a", "display_order": 33}, {"id": 6000093033, "chapter_id": 10093, "verse_number": "४-२९-३१", "content_sanskrit": "क्षुत्परीतो यथा दीनः सारमेयो गृहं गृहम्।\nचरन् विन्दति यद् दिष्टं दण्डमोदनमेव वा॥ ४/२९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.033.m4a", "display_order": 34}, {"id": 6000093034, "chapter_id": 10093, "verse_number": "४-२९-३२", "content_sanskrit": "तथा कामाशयो जीव उच्चावचपथा भ्रमन्।\nउपर्यधो वा मध्ये वा याति दिष्टं प्रियाप्रियम्॥ ४/२९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.034.m4a", "display_order": 35}, {"id": 6000093035, "chapter_id": 10093, "verse_number": "४-२९-३३", "content_sanskrit": "दुःखेष्वेकतरेणापि दैवभूतात्महेतुषु।\nजीवस्य न व्यवच्छेदः स्याच्चेत् तत् तत्प्रतिक्रिया॥ ४/२९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.035.m4a", "display_order": 36}, {"id": 6000093036, "chapter_id": 10093, "verse_number": "४-२९-३४", "content_sanskrit": "यथा हि पुरुषो भारं शिरसा गुरुमुद्वहन्।\nतं स्कन्धेन स आधत्ते तथा सर्वाः प्रतिक्रियाः॥ ४/२९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.036.m4a", "display_order": 37}, {"id": 6000093037, "chapter_id": 10093, "verse_number": "४-२९-३५", "content_sanskrit": "नैकान्ततः प्रतीकारः कर्मणां कर्म केवलम्।\nद्वयं ह्यविद्योपसृतं स्वप्ने स्वप्न इवानघ॥ ४/२९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.037.m4a", "display_order": 38}, {"id": 6000093038, "chapter_id": 10093, "verse_number": "४-२९-३६", "content_sanskrit": "अर्थे ह्यविद्यमानेऽपि संसृतिर्न निवर्तते।\nमनसा लिङ्गरूपेण स्वप्ने विचरतो यथा॥ ४/२९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.038.m4a", "display_order": 39}, {"id": 6000093039, "chapter_id": 10093, "verse_number": "४-२९-३७", "content_sanskrit": "अथात्मनोऽर्थभूतस्य यतोऽनर्थपरम्परा।\nसंसृतिस्तद्व्यवच्छेदो भक्त्या परमया हरौ॥ ४/२९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.039.m4a", "display_order": 40}, {"id": 6000093040, "chapter_id": 10093, "verse_number": "४-२९-३८", "content_sanskrit": "वासुदेवे भगवति भक्तियोगः समाहितः।\nसध्रीचीनेन वैराग्यं ज्ञानं च जनयिष्यति॥ ४/२९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.040.m4a", "display_order": 41}, {"id": 6000093041, "chapter_id": 10093, "verse_number": "४-२९-३९", "content_sanskrit": "सोऽचिरादिव राजर्षे स्यादच्युतकथाश्रयः।\nशृृण्वतः श्रद्धधानस्य नित्यदा स्यादधीयतः॥ ४/२९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.041.m4a", "display_order": 42}, {"id": 6000093042, "chapter_id": 10093, "verse_number": "४-२९-४०", "content_sanskrit": "यत्र भागवता राजन् साधवो विशदाशयाः।\nभगवद्गुणानुकथनश्रवणाव्यग्रचेतसः॥ ४/२९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.042.m4a", "display_order": 43}, {"id": 6000093043, "chapter_id": 10093, "verse_number": "४-२९-४१", "content_sanskrit": "तस्मिन् महन्मुखरिता मधुभिच्चरित्रपीयूषतोयसरितः परितः स्रवन्ति।\nता ये पिबन्त्यनुसवं नृप गाढकर्णैस्तान् न स्पृशन्त्यशनतृड्भयशोकमोहाः॥ ४/२९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.043.m4a", "display_order": 44}, {"id": 6000093044, "chapter_id": 10093, "verse_number": "४-२९-४२", "content_sanskrit": "एतैरुपद्रुतो नित्यं जीवलोकः स्वभावजैः।\nन करोति हरेर्नूनं कथामृतनिधौ रतिम्॥ ४/२९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.044.m4a", "display_order": 45}, {"id": 6000093045, "chapter_id": 10093, "verse_number": "४-२९-४३", "content_sanskrit": "प्रजापतिपतिः साक्षाद्भगवान् गिरिशो मनुः।\nदक्षादयः प्रजाध्यक्षा नैष्ठिकाः सनकादयः॥ ४/२९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.045.m4a", "display_order": 46}, {"id": 6000093046, "chapter_id": 10093, "verse_number": "४-२९-४४", "content_sanskrit": "मरीचिरत्र्यङ्गिरसौ पुलस्त्यः पुलहः क्रतुः।\nभृगुर्वसिष्ठ इत्येते मदन्ता ब्रह्मवादिनः॥ ४/२९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.046.m4a", "display_order": 47}, {"id": 6000093047, "chapter_id": 10093, "verse_number": "४-२९-४५", "content_sanskrit": "अद्यापि वाचस्पतयस्तपोविद्यासमाधिभिः।\nपश्यन्तोऽपि न पश्यन्ति तद् विष्णोः परमं पदम्॥ ४/२९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.047.m4a", "display_order": 48}, {"id": 6000093048, "chapter_id": 10093, "verse_number": "४-२९-४६", "content_sanskrit": "शब्दब्रह्मणि दुष्पारे चरन्त उरुविस्तरे।\nमन्त्रलिङ्गैर्व्यवच्छिन्नं भजन्तो न विदुः परम्॥ ४/२९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.048.m4a", "display_order": 49}, {"id": 6000093049, "chapter_id": 10093, "verse_number": "४-२९-४७", "content_sanskrit": "सर्वेषामिह जन्तूनां सन्ततं देहपोषणे।\nअस्ति प्रज्ञा समायत्ता को विशेषस्तया नृणाम्॥ ४/२९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.049.m4a", "display_order": 50}, {"id": 6000093050, "chapter_id": 10093, "verse_number": "४-२९-४८", "content_sanskrit": "लब्ध्वेहान्ते मनुष्यत्वं हित्वा देहाद्यसद्ग्रहम्।\nआत्मसृत्या विहायेदं जीवात्मा स विशिष्यते॥ ४/२९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.050.m4a", "display_order": 51}, {"id": 6000093051, "chapter_id": 10093, "verse_number": "४-२९-४९", "content_sanskrit": "यदा यस्यानुगृह्णाति भगवानात्मभावितः।\nस जहाति मतिं लोके वेदे च परिनिष्ठिताम्॥ ४/२९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.051.m4a", "display_order": 52}, {"id": 6000093052, "chapter_id": 10093, "verse_number": "४-२९-५०", "content_sanskrit": "तस्मात् कर्मसु बर्हिष्मन्नज्ञानादर्थकाशिषु।\nमाऽर्थदृष्टिं कृथाः श्रोत्रस्पर्शिष्वस्पृष्टवस्तुषु॥ ४/२९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.052.m4a", "display_order": 53}, {"id": 6000093053, "chapter_id": 10093, "verse_number": "४-२९-५१", "content_sanskrit": "स्वलोकं न विदुस्ते वै यत्र देवो जनार्दनः।\nआहुर्धूम्रधियो वेदं सकर्मकमतद्विदः॥ ४/२९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.053.m4a", "display_order": 54}, {"id": 6000093054, "chapter_id": 10093, "verse_number": "४-२९-५२", "content_sanskrit": "आस्तीर्य दर्भैः प्रागग्रैः कार्त्स्न्येन क्षितिमण्डलम्।\nततो बृहद्वधान्मानी कर्म नावैषि यत् परम्॥ ४/२९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.054.m4a", "display_order": 55}, {"id": 6000093055, "chapter_id": 10093, "verse_number": "४-२९-५३", "content_sanskrit": "तत् कर्म हरितोषं यत् सा विद्या तन्मतिर्यया।\nहरिर्देहभृतामात्मा स्वयं प्रकृतिरीश्वरः॥ ४/२९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.055.m4a", "display_order": 56}, {"id": 6000093056, "chapter_id": 10093, "verse_number": "४-२९-५४", "content_sanskrit": "तत्पादमूलं शरणं यतः क्षेमो नृणामिह। स वै प्रियतमो ह्यस्य यतो न भयमण्वपि।\nइति वेद स वै विद्वान् यो विद्वान् स्वगुरुर्हरिः॥ ४/२९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.056.m4a", "display_order": 57}, {"id": 6000093057, "chapter_id": 10093, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.057.m4a", "display_order": 58}, {"id": 6000093058, "chapter_id": 10093, "verse_number": "४-२९-५५", "content_sanskrit": "प्रश्न एवं हि संछिन्नो भवतः पुरुषर्षभ।\nअत्र मे वदतो गुह्यं निशामय सुनिश्चितम्॥ ४/२९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.058.m4a", "display_order": 59}, {"id": 6000093059, "chapter_id": 10093, "verse_number": "४-२९-५६", "content_sanskrit": "क्षुद्रञ्चरं सुमनसां शरणे मथित्वा रक्तं षडङ्घ्रिगणसामसुलुब्धकर्णम्।\nअग्रे वृकानसुहृदोऽविगणय्य यान्तं पृष्ठे मृगं मृगयुलुब्धकबाणभिन्नम्॥ ४/२९/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.059.m4a", "display_order": 60}, {"id": 6000093060, "chapter_id": 10093, "verse_number": "४-२९-५७", "content_sanskrit": "स त्वं विचक्ष्व मृगचेष्टितमात्मनोऽन्तश्चित्तं नियच्छ हृदि कर्णधुनीं च चित्तिम्।\nजह्यङ्गनाश्रममसत्तमयूथगाथं प्रीणीहि हंसशरणं विरम क्रमेण॥ ४/२९/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.060.m4a", "display_order": 61}, {"id": 6000093061, "chapter_id": 10093, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.061.m4a", "display_order": 62}, {"id": 6000093062, "chapter_id": 10093, "verse_number": "४-२९-५८", "content_sanskrit": "श्रुतमन्वीक्षितं ब्रह्मन् भगवान् यदभाषत।\nनैतज्जानन्त्युपाध्यायाः किन्न ब्रूयुर्विदुर्यदि॥ ४/२९/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.062.m4a", "display_order": 63, "topics": [{"text": "कर्मणां गतिः, फलं च", "range": "५८–६९"}]}, {"id": 6000093063, "chapter_id": 10093, "verse_number": "४-२९-५९", "content_sanskrit": "संशयोऽत्र न मे विप्र संच्छिन्नस्तत्कृतो महान्।\nऋषयोऽपि हि मुह्यन्ति यत्र नेन्द्रियवृत्तयः॥ ४/२९/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.063.m4a", "display_order": 64}, {"id": 6000093064, "chapter_id": 10093, "verse_number": "४-२९-६०", "content_sanskrit": "कर्माण्यारभते येन पुमानिह विहाय तम्।\nअमुत्रान्येन देहेन जुष्टान्यसकृदश्नुते॥ ४/२९/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.064.m4a", "display_order": 65}, {"id": 6000093065, "chapter_id": 10093, "verse_number": "४-२९-६१", "content_sanskrit": "इति वेदविदां वाचः श्रूयन्ते तत्र तत्र ह।\nकर्म च क्रियते प्रोक्तं परोक्षं न प्रकाशते॥ ४/२९/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.065.m4a", "display_order": 66}, {"id": 6000093066, "chapter_id": 10093, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.066.m4a", "display_order": 67}, {"id": 6000093067, "chapter_id": 10093, "verse_number": "४-२९-६२", "content_sanskrit": "येनैवारभते कर्म तेनैवामुत्र तत् पुमान्।\nभुङ्क्ते ह्यव्यवधानेन लिङ्गेन मनसा स्वकम्॥ ४/२९/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.067.m4a", "display_order": 68}, {"id": 6000093068, "chapter_id": 10093, "verse_number": "४-२९-६३", "content_sanskrit": "शयानमिममुत्सृज्य श्वसन्तं पुरुषो यथा।\nकर्मात्मन्याहितं भुङ्क्ते तादृशेनेतरेण वा॥ ४/२९/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.068.m4a", "display_order": 69}, {"id": 6000093069, "chapter_id": 10093, "verse_number": "४-२९-६४", "content_sanskrit": "ममेति मनसा यद् यदसावहमिति ब्रुवन्।\nगृह्णीयात् तत् पुमान् राद्धं कर्म येन पुनर्भवः॥ ४/२९/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.069.m4a", "display_order": 70}, {"id": 6000093070, "chapter_id": 10093, "verse_number": "४-२९-६५", "content_sanskrit": "यथाऽनुमीयते चित्तमुभयैरिन्द्रियेहितैः।\nएवं प्राग्देहजं कर्म लक्ष्यते चित्तवृत्तिभिः॥ ४/२९/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.070.m4a", "display_order": 71}, {"id": 6000093071, "chapter_id": 10093, "verse_number": "४-२९-६६", "content_sanskrit": "नानुभूतं क्‍व चानेन देहेनादृष्टमश्रुतम्।\nकदाचिदुपलभ्येत यद्रूपं यादृगात्मनि॥ ४/२९/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.071.m4a", "display_order": 72}, {"id": 6000093072, "chapter_id": 10093, "verse_number": "४-२९-६७", "content_sanskrit": "तेनास्य तादृशो राजन् लिङ्गिनो देहसम्भवः।\nश्रद्धत्स्वाननुभूतार्थं न मनः स्प्रष्टुमर्हति॥ ४/२९/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.072.m4a", "display_order": 73}, {"id": 6000093073, "chapter_id": 10093, "verse_number": "४-२९-६८", "content_sanskrit": "मन एव मनुष्यस्य पूर्वरूपाणि शंसति।\nभविष्यतश्च भद्रं ते तथैव न भविष्यतः॥ ४/२९/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.073.m4a", "display_order": 74}, {"id": 6000093074, "chapter_id": 10093, "verse_number": "४-२९-६९", "content_sanskrit": "अदृष्टमश्रुतं चेहक्‍वचिन्मनसि दृश्यते।\nयथा तथाऽनुमन्तव्यं देशकालक्रियाश्रयम्॥ ४/२९/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.074.m4a", "display_order": 75}, {"id": 6000093075, "chapter_id": 10093, "verse_number": "४-२९-७०", "content_sanskrit": "सर्वे क्रमानुरोधेन मनसीन्द्रियगोचराः।\nआयान्ति वर्गशो यान्ति सर्वे सुमनसो जवात्॥ ४/२९/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.075.m4a", "display_order": 76, "topics": [{"text": "कर्मविमुक्तिः", "range": "७०–८९"}]}, {"id": 6000093076, "chapter_id": 10093, "verse_number": "४-२९-७१", "content_sanskrit": "सत्त्वैकनिष्ठे मनसि भगवत्पार्श्ववर्तिनि।\nतमश्चन्द्रमसीवेदमुपरज्यावभासते॥ ४/२९/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.076.m4a", "display_order": 77}, {"id": 6000093077, "chapter_id": 10093, "verse_number": "४-२९-७२", "content_sanskrit": "नाहंममेति भावोऽयं पुरुषे व्यवधीयते।\nतावद् बुद्धिमनोऽक्षार्थगुणव्यूहो ह्यनादिमान्॥ ४/२९/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.077.m4a", "display_order": 78}, {"id": 6000093078, "chapter_id": 10093, "verse_number": "४-२९-७३", "content_sanskrit": "सुप्तिमूर्च्छोपतापेषु प्राणायनविघाततः।\nनेहतेऽहमिति ज्ञानं मृत्युप्रज्वारयोरपि॥ ४/२९/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.078.m4a", "display_order": 79}, {"id": 6000093079, "chapter_id": 10093, "verse_number": "४-२९-७४", "content_sanskrit": "गर्भे बाल्येऽप्यपौष्कल्यादेकादशविधं तदा।\nलिङ्गं न दृश्यतेऽयूनः कुह्वां चन्द्रमसो यथा॥ ४/२९/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.079.m4a", "display_order": 80}, {"id": 6000093080, "chapter_id": 10093, "verse_number": "४-२९-७५", "content_sanskrit": "अर्थे ह्यविद्यमानेऽपि संसृतिर्न निवर्तते।\nध्यायतो विषयानस्य स्वप्नेऽनर्थागमो यथा॥ ४/२९/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.080.m4a", "display_order": 81}, {"id": 6000093081, "chapter_id": 10093, "verse_number": "४-२९-७६", "content_sanskrit": "एकं पञ्चविधं लिङ्गं त्रिवृत् षोडशविस्तरम्।\nएष चेतनया युक्तो जीव इत्यभिधीयते॥ ४/२९/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.081.m4a", "display_order": 82}, {"id": 6000093082, "chapter_id": 10093, "verse_number": "४-२९-७७", "content_sanskrit": "अनेन पुरुषो देहानुपादत्ते विमुञ्चति।\nहर्षं शोकं भयं दुःखं सुखं चानेन विन्दति॥ ४/२९/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.082.m4a", "display_order": 83}, {"id": 6000093083, "chapter_id": 10093, "verse_number": "४-२९-७८", "content_sanskrit": "यथा तृणजलूका च नोपयात्यपयाति च।\nन त्यजेन्म्रियमाणोऽपि प्राग्देहाभिमतिं जनः॥ ४/२९/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.083.m4a", "display_order": 84}, {"id": 6000093084, "chapter_id": 10093, "verse_number": "४-२९-७९", "content_sanskrit": "यावदन्यं न विन्देत व्यवधानेन कर्मणाम्।\nमन एव मनुष्येन्द्र भूतानां भवभावनम्॥ ४/२९/७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.084.m4a", "display_order": 85}, {"id": 6000093085, "chapter_id": 10093, "verse_number": "४-२९-८०", "content_sanskrit": "यदक्षैश्चरितं ध्यायन् कर्माण्याचिनुतेऽसकृत्।\nसति कर्मण्यविद्यायां बन्धः कर्मण्य आत्मनः॥ ४/२९/८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.085.m4a", "display_order": 86}, {"id": 6000093086, "chapter_id": 10093, "verse_number": "४-२९-८१", "content_sanskrit": "अतस्तदपबाधार्थं भज सर्वात्मना हरिम्।\nपश्यंस्तदात्मकं विश्वं स्थित्युत्पत्त्यप्यया यतः॥ ४/२९/८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.086.m4a", "display_order": 87}, {"id": 6000093087, "chapter_id": 10093, "verse_number": "४-२९-८२", "content_sanskrit": "भक्तिः कृष्णे दया जीवेष्वकुण्ठज्ञानमात्मनि।\nयदि स्यादात्मनो भूयादपवर्गस्तु संसृतेः॥ ४/२९/८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.087.m4a", "display_order": 88}, {"id": 6000093088, "chapter_id": 10093, "verse_number": "४-२९-८३", "content_sanskrit": "अदृष्टं दृष्टवन्नङ्‍क्ष्येद् भूतं स्वप्नवदन्यथा।\nभूतं भवद् भविष्यच्च सुप्तं सर्वरहो रहः॥ ४/२९/८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.088.m4a", "display_order": 89}, {"id": 6000093089, "chapter_id": 10093, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.089.m4a", "display_order": 90}, {"id": 6000093090, "chapter_id": 10093, "verse_number": "४-२९-८४", "content_sanskrit": "भागवतमुख्यो भगवान् नारदो हंसयोर्गतिम्।\nप्रदर्श्य ह्यमुमामन्त्र्य सिद्धलोकं ततोऽगमत्॥ ४/२९/८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.090.m4a", "display_order": 91}, {"id": 6000093091, "chapter_id": 10093, "verse_number": "४-२९-८५", "content_sanskrit": "प्राचीनबर्ही राजर्षिः प्रजासर्गाभिरक्षणे।\nआदिश्य पुत्रानगमत् तपसे कपिलाश्रमम्॥ ४/२९/८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.091.m4a", "display_order": 92}, {"id": 6000093092, "chapter_id": 10093, "verse_number": "४-२९-८६", "content_sanskrit": "तत्रैकाग्रमना वीरो गोविन्दचरणाम्बुजम्।\nविमुक्तसङ्गोऽनुभजन् भक्त्या तत्साम्यतामगात्॥ ४/२९/८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.092.m4a", "display_order": 93}, {"id": 6000093093, "chapter_id": 10093, "verse_number": "४-२९-८७", "content_sanskrit": "एतदध्यात्मपारोक्ष्यं गीतं देवर्षिणाऽनघ।\nयः श्रावयेद् यः शृणुयात् स लिङ्गेन विमुच्यते॥ ४/२९/८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.093.m4a", "display_order": 94}, {"id": 6000093094, "chapter_id": 10093, "verse_number": "४-२९-८८", "content_sanskrit": "एतन्मुकुन्दयशसा भुवनं पुनानं देवर्षिवर्यमुखनिःसृतमात्मशौचम्।\nयः कीर्त्यमानमधिगच्छति पारमेष्ठ्यं नास्मिन् भवे भ्रमति मुक्तसमस्तबन्धः॥ ४/२९/८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.094.m4a", "display_order": 95}, {"id": 6000093095, "chapter_id": 10093, "verse_number": "४-२९-८९", "content_sanskrit": "अध्यात्मपारोक्ष्यमिदं मयाऽधिगतमद्भुतम्।\nएवं त्रय्याश्रयः पुंसश्छिन्नोऽमुत्र च संशयः॥ ४/२९/८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_029/BhP_04.029.095.m4a", "display_order": 96}, {"id": 6000093096, "chapter_id": 10093, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे एकोनत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]