[{"id": 5000029000, "chapter_id": 9029, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकोनत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000029001, "chapter_id": 9029, "verse_number": "१-२९-१", "content_sanskrit": "अथ तस्याप्रमेयस्य वचनं परिपृच्छतः ।\nविश्वामित्रो महातेजा व्याख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000029002, "chapter_id": 9029, "verse_number": "१-२९-२", "content_sanskrit": "इह राम महाबाहो विष्णुर्देवनमस्कृतः ।\nवर्षाणि सुबहूनीह तथा युगशतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000029003, "chapter_id": 9029, "verse_number": "१-२९-३", "content_sanskrit": "तपश्चरणयोगार्थमुवास सुमहातपाः ।\nएष पूर्वाश्रमो राम वामनस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000029004, "chapter_id": 9029, "verse_number": "१-२९-४", "content_sanskrit": "सिद्धाश्रम इति ख्यातः सिद्धो ह्यत्र महातपाः ।\nएतस्मिन्नेव काले तु राजा वैरोचनिर्बलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000029005, "chapter_id": 9029, "verse_number": "१-२९-५", "content_sanskrit": "निर्जित्य दैवतगणान् सेन्द्रान् सहमरुद्गणान् ।\nकारयामास तद्राज्यं त्रिषु लोकेषु विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000029006, "chapter_id": 9029, "verse_number": "१-२९-६", "content_sanskrit": "यज्ञं चकार सुमहानसुरेन्द्रो महाबलः ।\nबलेस्तु यजमानस्य देवाः साग्निपुरोगमाः ।\nसमागम्य स्वयं चैव विष्णुमूचुरिहाश्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000029007, "chapter_id": 9029, "verse_number": "१-२९-७", "content_sanskrit": "बलिर्वैरोचनिर्विष्णो यजते यज्ञमुत्तमम् ।\nअसमाप्तव्रते तस्मिन् स्वकार्यमभिपद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000029008, "chapter_id": 9029, "verse_number": "१-२९-८", "content_sanskrit": "ये चैनमभिवर्तन्ते याचितार इतस्ततः ।\nयच्च यत्र यथावच्च सर्वं तेभ्यः प्रयच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000029009, "chapter_id": 9029, "verse_number": "१-२९-९", "content_sanskrit": "स त्वं सुरहितार्थाय मायायोगमुपाश्रितः ।\nवामनत्वं गतो विष्णो कुरु कल्याणमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000029010, "chapter_id": 9029, "verse_number": "१-२९-१०", "content_sanskrit": "एतस्मिन्नन्तरे राम कश्यपोग्निसमप्रभः ।\nअदित्या सहितो राम दीप्यमान इवौजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000029011, "chapter_id": 9029, "verse_number": "१-२९-११", "content_sanskrit": "देवीसहायो भगवान् दिव्यं वर्षसहस्रकम् ।\nव्रतं समाप्य वरदं तुष्टाव मधुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000029012, "chapter_id": 9029, "verse_number": "१-२९-१२", "content_sanskrit": "तपोमयं तपोराशिं तपोमूर्तिं तपात्मकम् ।\nतपसा त्वां सुतप्तेन पश्यामि पुरुषोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000029013, "chapter_id": 9029, "verse_number": "१-२९-१३", "content_sanskrit": "शरीरे तव पश्यामि जगत् सर्वमिदं प्रभो ।\nत्वमनादिरनिर्देश्यस्त्वामहं शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000029014, "chapter_id": 9029, "verse_number": "१-२९-१४", "content_sanskrit": "तमुवाच हरिः प्रीतः कश्यपं गतकल्मषम् ।\nवरं वरय भद्रं ते वरार्होऽसि मतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000029015, "chapter_id": 9029, "verse_number": "१-२९-१५", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य मारीचः कश्यपोऽब्रवीत् ।\nअदित्या देवतानां च मम चैवानुयाचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000029016, "chapter_id": 9029, "verse_number": "१-२९-१६", "content_sanskrit": "वरं वरद सुप्रीतो दातुमर्हसि सुव्रत ।\nपुत्रत्वं गच्छ भगवन्नदित्या मम चानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000029017, "chapter_id": 9029, "verse_number": "१-२९-१७", "content_sanskrit": "भ्राता भव यवीयांस्त्वं शक्रस्यासुरसूदन ।\nशोकार्तानां तु देवानां साहाय्यं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000029018, "chapter_id": 9029, "verse_number": "१-२९-१८", "content_sanskrit": "अयं सिद्धाश्रमो नाम प्रसादात् ते भविष्यति ।\nसिद्धे कर्मणि देवेश उत्तिष्ठ भगवन्नितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000029019, "chapter_id": 9029, "verse_number": "१-२९-१९", "content_sanskrit": "अथ विष्णुर्महातेजा अदित्यां समजायत ।\nवामनं रूपमास्थाय वैरोचनिमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000029020, "chapter_id": 9029, "verse_number": "१-२९-२०", "content_sanskrit": "त्रीन् पदानथ भिक्षित्वा प्रतिगृह्य च मेदिनीम् ।\nआक्रम्य लोकाँल्लोकार्थी सर्वलोकहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000029021, "chapter_id": 9029, "verse_number": "१-२९-२१", "content_sanskrit": "महेन्द्राय पुनः प्रादान्नियम्य बलिमोजसा ।\nत्रैलोक्यं स महातेजाश्चक्रे शक्रवशं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000029022, "chapter_id": 9029, "verse_number": "१-२९-२२", "content_sanskrit": "तेनैव पूर्वमाक्रान्त आश्रमः श्रमनाशनः ।\nमयापि भक्त्या तस्यैव वामनस्योपभुज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000029023, "chapter_id": 9029, "verse_number": "१-२९-२३", "content_sanskrit": "एनमाश्रममायान्ति राक्षसा विघ्नकारिणः ।\nअत्र ते पुरुषव्याघ्र हन्तव्या दुष्टचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000029024, "chapter_id": 9029, "verse_number": "१-२९-२४", "content_sanskrit": "अद्य गच्छामहे राम सिद्धाश्रममनुत्तमम् ।\nतदाश्रमपदं तात तवाप्येतद् यथा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000029025, "chapter_id": 9029, "verse_number": "१-२९-२५", "content_sanskrit": "इत्युक्त्वा परमप्रीतो गृह्य रामं सलक्ष्मणम् ।\nप्रविशन्नाश्रमपदं व्यरोचत महामुनिः ।\nशशीव गतनीहारः पुनर्वसुसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000029026, "chapter_id": 9029, "verse_number": "१-२९-२६", "content_sanskrit": "तं दृष्ट्वा मुनयः सर्वे सिद्धाश्रमनिवासिनः ।\nउत्पत्योत्पत्य सहसा विश्वामित्रमपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000029027, "chapter_id": 9029, "verse_number": "१-२९-२७", "content_sanskrit": "यथार्हं चक्रिरे पूजां विश्वामित्राय धीमते ।\nतथैव राजपुत्राभ्यामकुर्वन्नतिथिक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000029028, "chapter_id": 9029, "verse_number": "१-२९-२८", "content_sanskrit": "मुहूर्तमथ विश्रान्तौ राजपुत्रावरिंदमौ ।\nप्राञ्जली मुनिशार्दूलमूचतू रघुनन्दनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000029029, "chapter_id": 9029, "verse_number": "१-२९-२९", "content_sanskrit": "अद्यैव दीक्षां प्रविश भद्रं ते मुनिपुङ्गव ।\nसिद्धाश्रमोऽयं सिद्धः स्यात् सत्यमस्तु वचस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000029030, "chapter_id": 9029, "verse_number": "१-२९-३०", "content_sanskrit": "एवमुक्तो महातेजा विश्वामित्रो महानृषिः ।\nप्रविवेश तदा दीक्षां नियतो नियतेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000029031, "chapter_id": 9029, "verse_number": "१-२९-३१", "content_sanskrit": "कुमारावपि तां रात्रिमुषित्वा सुसमाहितौ ।\nप्रभातकाले चोत्थाय पूर्वां संध्यामुपास्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000029032, "chapter_id": 9029, "verse_number": "१-२९-३२", "content_sanskrit": "प्रशुची परमं जाप्यं समाप्य नियमेन च ।\nहुताग्निहोत्रमासीनं विश्वामित्रमवन्दताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000029033, "chapter_id": 9029, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकोनत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]