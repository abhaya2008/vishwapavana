[{"id": 40008102, "chapter_id": 9029, "verse_number": "1", "content_sanskrit": "इत्युक्तस्य यथान्यायं रावणस्य जटायुषा। क्रुद्धस्याग्निनिभास्सर्वा रेजुर्विंशतिदृष्टयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40008103, "chapter_id": 9029, "verse_number": "2", "content_sanskrit": "संरक्तनयनः कोपात्तप्तकाञ्चनकुण्डलः। राक्षसेन्द्रोऽभिदुद्राव पतगेन्द्रममर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40008104, "chapter_id": 9029, "verse_number": "3", "content_sanskrit": "स सम्प्रहारस्तुमुल स्तयोस्तस्मिन्महावने। बभूव वातोद्धतयोर्मेघयोर्गगने यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40008105, "chapter_id": 9029, "verse_number": "4", "content_sanskrit": "तद्बभूवाद्भुतं युद्धं गृध्रराक्षसयोस्तदा। सपक्षयोर्माल्यवतोर्महापर्वतयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40008106, "chapter_id": 9029, "verse_number": "5", "content_sanskrit": "ततो नालीकनाराचैस्तीक्ष्णाग्रैश्च विकर्णिभिः। अभ्यवर्षन्महाघोरैर्गृध्रराजं महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40008107, "chapter_id": 9029, "verse_number": "6", "content_sanskrit": "स तानि शरजालानि गृध्रः पत्त्ररथेश्वरः। जटायुः प्रतिजग्राह रावणास्त्राणि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40008108, "chapter_id": 9029, "verse_number": "7", "content_sanskrit": "तस्य तीक्ष्णनखाभ्यां तु चरणाभ्यां महाबलः। चकार बहुधा गात्रे व्रणान्पतगसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40008109, "chapter_id": 9029, "verse_number": "8", "content_sanskrit": "अथ क्रोधाद्धशग्रीवो जग्राह दश मार्गणान्। मृत्युदण्डनिभान्घोरान्छत्रुमर्दनकाङ्क्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40008110, "chapter_id": 9029, "verse_number": "9", "content_sanskrit": "स तैर्बाणैर्महावीर्यः पूर्णमुक्तैरजिह्मगैः। बिभेद निशितैस्तीक्ष्णैर्गृध्रं घोरैश्शिलीमुखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40008111, "chapter_id": 9029, "verse_number": "10", "content_sanskrit": "स राक्षसरथे पश्यन्जानकीं बाष्पलोचनाम्। अचिन्तयित्वा तान्बाणान्राक्षसं समभिद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40008112, "chapter_id": 9029, "verse_number": "11", "content_sanskrit": "ततोऽस्य सशरं चापं मुक्तामणिविभूषितम्। चरणाभ्यां महातेजा बभञ्ज पतगेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40008113, "chapter_id": 9029, "verse_number": "12", "content_sanskrit": "ततोऽन्यद्धनुरादाय रावणः क्रोधमूर्छितः। ववर्ष शरवर्षाणि शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40008114, "chapter_id": 9029, "verse_number": "13", "content_sanskrit": "शरैरावारितस्तस्य संयुगे पतगेश्वरः। कुलायमुपसम्प्राप्तः पक्षीव प्रबभौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40008115, "chapter_id": 9029, "verse_number": "14", "content_sanskrit": "स तानि शरवर्षाणि पक्षाभ्यां च विधूयच। चरणाभ्यां महातेजा बभञ्जास्य महद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40008116, "chapter_id": 9029, "verse_number": "15", "content_sanskrit": "तच्चाग्निसदृशं दीप्तं रावणस्य शरावरम्। पक्षाभ्यां स महावीर्यो व्याधुनोत्पतगेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40008117, "chapter_id": 9029, "verse_number": "16", "content_sanskrit": "काञ्चनोरश्छदान्दिव्यान्पिशाचवदनान्खरान्। तांश्चास्य जवसम्पन्नाञ्जघान समरे बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40008118, "chapter_id": 9029, "verse_number": "17", "content_sanskrit": "वरं त्रिवेणुसम्पन्नं कामगं पावकार्चिषम्। मणिहेमविचित्राङ्गं बभञ्ज च महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40008119, "chapter_id": 9029, "verse_number": "18", "content_sanskrit": "पूर्णचन्द्रप्रतीकाशं छत्रं च व्यजनैस्सह। पातयामास वेगेन ग्राहिभी राक्षसैस्सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40008120, "chapter_id": 9029, "verse_number": "19", "content_sanskrit": "सारथेश्चास्य वेगेन तुण्डेनैव महच्छिरः। पुनर्व्यपाहरच्छ्रीमान्पक्षिराजो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40008121, "chapter_id": 9029, "verse_number": "20", "content_sanskrit": "स भग्नधन्वा विरथो हताश्वो हतसारथिः। अङ्केनादाय वैदेहीं पपात भुवि रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40008122, "chapter_id": 9029, "verse_number": "21", "content_sanskrit": "दृष्ट्वा निपतितं भूमौ रावणं भग्नवाहनम्। साधुसाध्विति भूतानि गृध्रराजमपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40008123, "chapter_id": 9029, "verse_number": "22", "content_sanskrit": "परिश्रान्तं तु तं दृष्टवा जरया पक्षियूथपम्। उत्पपात पुनर्हृष्टो मैथिलीं गृह्य रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40008124, "chapter_id": 9029, "verse_number": "23", "content_sanskrit": "तं प्रहृष्टं निधायाङ्के गच्छन्तं जनकात्मजाम्। गृध्रराजस्समुत्पत्य समभिद्रुत्य रावणम् ॥ समावार्य महातेजा जटायुरिदमब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40008125, "chapter_id": 9029, "verse_number": "24", "content_sanskrit": "वज्रसंस्पर्शबाणस्य भार्यां रामस्य रावण ॥ अल्पबुद्धे हरस्येनां वधाय खलु रक्षसाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40008126, "chapter_id": 9029, "verse_number": "25", "content_sanskrit": "समित्रबन्धुस्सामात्यस्सबलस्सपरिच्छदः ॥ विषपानं पिबस्येतत्पिपासित इवोदकम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40008127, "chapter_id": 9029, "verse_number": "26", "content_sanskrit": "अनुबन्धमजानन्तः कर्मणामविचक्षणाः ॥ शीघ्रमेव विनश्यन्ति यथा त्वं विनशिष्यसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40008128, "chapter_id": 9029, "verse_number": "27", "content_sanskrit": "बद्धस्त्वं कालपाशेन क्व गतस्तस्य मोक्ष्यसे ॥ वधाय बडिशं गृह्य सामिषं जलजो यथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40008129, "chapter_id": 9029, "verse_number": "28", "content_sanskrit": "न हि जातु दुराधर्षौ काकुत्स्थौ तव रावण ॥ धर्षणं चाश्रमस्यास्य क्षमिष्येते तु राघवौ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40008130, "chapter_id": 9029, "verse_number": "29", "content_sanskrit": "यथा त्वया कृतं कर्म भीरुणा लोकगर्हितम् ॥ तस्कराचरितो मार्गो नैव वीरनिषेवितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40008131, "chapter_id": 9029, "verse_number": "30", "content_sanskrit": "युध्यस्व यदि शूरोऽसि मुहूर्तं तिष्ठरावण ॥ शयिष्यसे हतो भूमौ यथा भ्राता खरस्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40008132, "chapter_id": 9029, "verse_number": "31", "content_sanskrit": "परेतकाले पुरुषो यत्कर्म प्रतिपद्यते ॥ विनाशायात्मनोऽधर्म्यं प्रतिपन्नोऽसि कर्म तत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40008133, "chapter_id": 9029, "verse_number": "32", "content_sanskrit": "पापानुबन्धो वै यस्य कर्मणः कर्मको नु तत् ॥ कुर्वीत लोकाधिपतिस्स्वयंभूर्भगवानपि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40008134, "chapter_id": 9029, "verse_number": "33", "content_sanskrit": "एवमुक्त्वा शुभं वाक्यं जटायुस्तस्य रक्षसः ॥ निपपात भृशं पृष्ठे दशग्रीवस्य वीर्यवान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40008135, "chapter_id": 9029, "verse_number": "34", "content_sanskrit": "तं गृहीत्वा नखैस्तीक्ष्णैर्विददार समन्ततः ॥ अधिरूढो गजारोहो यथा स्याद्दुष्टवारणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40008136, "chapter_id": 9029, "verse_number": "35", "content_sanskrit": "विददार नखैरस्य तुण्डं पृष्ठे समर्पयन् ॥ केशांश्चोत्पाटयामास नखपक्षमुखायुधः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40008137, "chapter_id": 9029, "verse_number": "36", "content_sanskrit": "स तथा गृध्रराजेन क्लिश्यमानो मुहुर्मुहुः ॥ अमर्षस्फुरितोष्ठस्सन्प्राकम्पत च रावणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40008138, "chapter_id": 9029, "verse_number": "37", "content_sanskrit": "स परिष्वज्य च वैदेहीं वामेनाङ्केन रावणः ॥ तलेनाभिजघानाशु जटायुं क्रोधमुर्छीतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40008139, "chapter_id": 9029, "verse_number": "38", "content_sanskrit": "जटायुस्तमभिक्रम्य तुण्डेनास्य खगाधिपः ॥ वामबाहून्दश तदा व्यपाहरदरिन्दमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40008140, "chapter_id": 9029, "verse_number": "39", "content_sanskrit": "सञ्छिन्नबाहोस्सद्यैव बाहवस्सहसाभवन् ॥ विषज्वालावलीयुक्ता वल्मीकादिव पन्नगाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40008141, "chapter_id": 9029, "verse_number": "40", "content_sanskrit": "ततः क्रोधाद्दशग्रीवस्सीतामुत्सृज्य रावणः ॥ मुष्टिभ्यां चरणाभ्यां च गृध्रराजमपोथयत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40008142, "chapter_id": 9029, "verse_number": "41", "content_sanskrit": "ततो मुहूर्तं सङ्ग्रामो बभूवातुल्यवीर्ययोः ॥ राक्षसानां च मुख्यस्य पक्षिणां प्रवरस्य च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40008143, "chapter_id": 9029, "verse_number": "42", "content_sanskrit": "तस्य व्यायच्छमानस्य रामस्यार्थे स रावणः ॥ पक्षौ पार्श्वौ च पादौ च खड्गमुद्धृत्य सोऽच्छिनत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40008144, "chapter_id": 9029, "verse_number": "43", "content_sanskrit": "स च्छिन्नपक्षस्सहसा रक्षसा रौद्रकर्मणा ॥ निपपात हतो गृद्रो धरण्यामल्पजीवितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40008145, "chapter_id": 9029, "verse_number": "44", "content_sanskrit": "तं दृष्ट्वा पतितं भूमौ क्षतजार्द्रं जटायुषम् ॥ अभ्यधावत वैदेही स्वबन्धुमिव दुःखिता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40008146, "chapter_id": 9029, "verse_number": "45", "content_sanskrit": "तं नीलजीमूतनिकाशकल्पं सुपाण्डुरोरस्कमुदारवीर्यम्। ददर्श लङ्काधिपतिः पृथिव्यां जटायुषं शान्तमिवाग्निदावम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40008147, "chapter_id": 9029, "verse_number": "46", "content_sanskrit": "ततस्तु तं पत्ररथं महीतले निपातितं रावणवेगमर्दितम्। पुनः परिश्वज्य शशिप्रभानना रुरोद सीता जनकात्मजातदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]