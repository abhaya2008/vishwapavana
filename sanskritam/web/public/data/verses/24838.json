[{"id": 7004838000, "chapter_id": 24838, "verse_number": "७-१-२१-१", "content_sanskrit": "देव्युवाच ।\nश्रुतं सर्वमशेषेण चन्द्रस्योत्पत्ति कारणम् ।\nचिह्नं यथाऽभवत्तस्य सांप्रतं तत्प्रकीर्त्तय ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004838001, "chapter_id": 24838, "verse_number": "७-१-२१-२", "content_sanskrit": "ईश्वर उवाच ।\nब्रह्मणस्तु पुरा देवि दक्षो नाम सुतोऽभवत् ।\nप्रजाः सृजेति उद्दिष्टः पूर्वं दक्षः स्वयंभुवा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004838002, "chapter_id": 24838, "verse_number": "७-१-२१-३", "content_sanskrit": "षष्टिं दक्षोऽसृजत्कन्या वैरिण्यां वै प्रजापतिः ।\nददौ स दश धर्माय कश्यपाय त्रयोदश ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004838003, "chapter_id": 24838, "verse_number": "७-१-२१-४", "content_sanskrit": "सप्त विशतिं सोमाय चतस्रोऽरिष्टनेमिने ।\nद्वे चैव भृगुपुत्राय द्वे कृशाश्वाय धीमते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004838004, "chapter_id": 24838, "verse_number": "७-१-२१-५", "content_sanskrit": "द्वे चैवांगिरसे तद्वत्तासां नामानि विस्तरात् ।\nशृणु त्वं देवि मातॄणां प्रजाविस्तरमादितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004838005, "chapter_id": 24838, "verse_number": "७-१-२१-६", "content_sanskrit": "मरुत्वती वसुर्जामी लंबा भानुररुन्धती ।\nसंकल्पा च मुहूर्ता च साध्या विश्वा च भामिनि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004838006, "chapter_id": 24838, "verse_number": "७-१-२१-७", "content_sanskrit": "धर्म पत्न्यः समाख्याता दक्षः प्राचेतसो ददौ ।\nअदितिर्दितिर्दनुस्तद्वदरिष्टा सुरसैव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004838007, "chapter_id": 24838, "verse_number": "७-१-२१-८", "content_sanskrit": "सुरभिर्विनता चैव नाम्ना क्रोधवशा त्विला ।\nकद्रूस्त्विषा वसुस्तद्वत्तासां पुत्रान्वदामि वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004838008, "chapter_id": 24838, "verse_number": "७-१-२१-९", "content_sanskrit": "विश्वेदेवास्तु विश्वायाः साध्या साध्यानजीजनत् ।\nमरुत्वत्यां मरुत्वंतो वसोस्तु वसवस्तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004838009, "chapter_id": 24838, "verse_number": "७-१-२१-१०", "content_sanskrit": "भानोस्तु भानवस्तेन मुहूर्त्तायां मुहूर्त्तकाः ।\nलंबाया घोषनामानो नागवीथिस्तु जामिजा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004838010, "chapter_id": 24838, "verse_number": "७-१-२१-११", "content_sanskrit": "संकल्पायास्तु संकल्पो धर्मपुत्रा दश स्मृताः ।\nआपो ध्रुवश्च सोमश्च धरश्चैवानलोऽनिलः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004838011, "chapter_id": 24838, "verse_number": "७-१-२१-१२", "content_sanskrit": "प्रत्यूषश्च प्रभासश्च वसवोष्टौ प्रकीर्तिताः ।\nआपस्य पुत्रा वैदंड्यः श्रमः शान्तो ध्वनिस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004838012, "chapter_id": 24838, "verse_number": "७-१-२१-१३", "content_sanskrit": "ध्रुवस्य पुत्रो भगवान्कालो लोकप्रकालनः ।\nसोमस्य भगवाञ्छर्वो ध्रुवश्च गृहबोधनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004838013, "chapter_id": 24838, "verse_number": "७-१-२१-१४", "content_sanskrit": "हुतहव्यवहश्चैव धरस्य द्रविण स्मृतः ।\nमनोजवोऽनिलस्यासीदविज्ञातगतिस्तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004838014, "chapter_id": 24838, "verse_number": "७-१-२१-१५", "content_sanskrit": "देवलो भगवान्योगी प्रत्यूषस्याभवन्सुताः ।\nबृहस्पतेस्तु भगिनी भुवना ब्रह्मवादिनी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004838015, "chapter_id": 24838, "verse_number": "७-१-२१-१६", "content_sanskrit": "प्रभासस्य तु सा भार्या वसूनामष्टमस्य च ।\nविश्वकर्मा सुतस्तस्य शिल्पकर्त्ता प्रजापतिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004838016, "chapter_id": 24838, "verse_number": "७-१-२१-१७", "content_sanskrit": "तुषितानां तु साध्यानां नामान्येतानि वच्मि ते ।\nमनोऽनुमन्ता प्राणश्च नरोऽपानश्च वीर्यवान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004838017, "chapter_id": 24838, "verse_number": "७-१-२१-१८", "content_sanskrit": "भक्तिर्भयोऽनघश्चैव हंसो नारायणस्तथा ।\nविभुश्चैव प्रभुश्चैव साध्या द्वादश कीर्तिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004838018, "chapter_id": 24838, "verse_number": "७-१-२१-१९", "content_sanskrit": "कश्यपस्य प्रवक्ष्यामि सन्ततिं वरवर्णिनि ।\nअंशो धाता भगस्त्वष्टा मित्रोऽथ वरुणो र्यमा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004838019, "chapter_id": 24838, "verse_number": "७-१-२१-२०", "content_sanskrit": "विवस्वान्सविता पूषा ह्यंशुमान्विष्णुरेव च ।\nएते सहस्रकिरणा आदित्या द्वादश स्मृताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004838020, "chapter_id": 24838, "verse_number": "७-१-२१-२१", "content_sanskrit": "अजैकपादहिर्बुध्न्यो विरूपाक्षोऽथ रैवतः ।\nहरश्च बहुरूपश्च त्र्यंबकश्च सुरेश्वरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004838021, "chapter_id": 24838, "verse_number": "७-१-२१-२२", "content_sanskrit": "सावित्रश्च जयन्तश्च पिनाकी चापराजितः ।\nएते रुद्राः समाख्याता एकादश गणेश्वराः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004838022, "chapter_id": 24838, "verse_number": "७-१-२१-२३", "content_sanskrit": "दितिः पुत्रद्वयं लेभे कश्यपाद्बलगर्वितम् ।\nहिरण्यकशिपुं श्रेष्ठं हिरण्याक्षं तथानुजम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004838023, "chapter_id": 24838, "verse_number": "७-१-२१-२४", "content_sanskrit": "हिरण्यकशिपोर्दैत्यैः श्लोकोगीतः पुरातनैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004838024, "chapter_id": 24838, "verse_number": "७-१-२१-२५", "content_sanskrit": "राजा हिरण्यकशिपुर्यांयामाशां निरीक्षते ।\nतस्यां तस्यां दिशि सुरा नमश्चक्रुर्महर्षिभिः ।\nहिरण्यकशिपोः पुत्राश्चत्वारः सुमहाबलाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004838025, "chapter_id": 24838, "verse_number": "७-१-२१-२६", "content_sanskrit": "प्रह्लादः पूर्वजस्तेषामनुह्रादस्ततः परः ।\nह्रादश्चैव ह्रदश्चैव पुत्राश्चैते प्रकीर्तिताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004838026, "chapter_id": 24838, "verse_number": "७-१-२१-२७", "content_sanskrit": "उभौ सुन्दोपसुन्दौ तु ह्रदपुत्रौ बभूवतुः ।\nह्रादस्य पुत्रस्त्वेकोऽभून्मूक इत्यभिविश्रुतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004838027, "chapter_id": 24838, "verse_number": "७-१-२१-२८", "content_sanskrit": "मारीचः सुंदपुत्रस्तु ताडकायामजायत ।\nदण्डके निहतः सोऽयं राघवेण वलीयसा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004838028, "chapter_id": 24838, "verse_number": "७-१-२१-२९", "content_sanskrit": "मूको विनिहतश्चापि कैराते सब्यसाचिना ।\nसंह्रादस्य तु दैत्यस्य निवातकवचाः कुले ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004838029, "chapter_id": 24838, "verse_number": "७-१-२१-३०", "content_sanskrit": "तिस्रः कोट्यस्तु विख्याता निहताः सव्यसाचिना ।\nगवेष्ठी कालनेमिश्च जंभो वल्कल एव च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004838030, "chapter_id": 24838, "verse_number": "७-१-२१-३१", "content_sanskrit": "जृंभः षष्ठोनुजस्तेषां स्मृताः प्रह्रादसूनवः ।\nशुंभश्चैव निशुंभश्च गवेष्ठिनः सुतौ स्मृतौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004838031, "chapter_id": 24838, "verse_number": "७-१-२१-३२", "content_sanskrit": "धनुकश्चासिलोमा च शुंभपुत्रौ प्रकीर्तितौ ।\nविरोचनस्य पुत्रस्तु बलिरेकः प्रतापवान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004838032, "chapter_id": 24838, "verse_number": "७-१-२१-३३", "content_sanskrit": "हिरण्याक्षसुताः पंच विक्रांताः सुमहाबलाः ।\nअन्धकः शकुनिश्चैव कालनाभस्तथैव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004838033, "chapter_id": 24838, "verse_number": "७-१-२१-३४", "content_sanskrit": "महानाभश्च विक्रांतो भूतसंतापनस्तथा ।\nशतं शतसहस्राणि निहतास्तारकामये ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004838034, "chapter_id": 24838, "verse_number": "७-१-२१-३५", "content_sanskrit": "इति संक्षपतः प्रोक्ता कश्यपान्वयसंततिः ।\nयया व्याप्तं जगत्सर्वं सदेवासुरमानुषम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004838035, "chapter_id": 24838, "verse_number": "७-१-२१-३६", "content_sanskrit": "अथ याः कन्यका दत्ताः सप्तविंशतिरिंदवे ।\nतासां मध्ये महादेवि प्रिया तस्य च रोहिणी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004838036, "chapter_id": 24838, "verse_number": "७-१-२१-३७", "content_sanskrit": "अथ नक्षत्रनाथस्य तासां मध्येतिवल्लभा ।\nबभूव रोहिणी देवी प्राणेभ्योऽपि गरीयसी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004838037, "chapter_id": 24838, "verse_number": "७-१-२१-३८", "content_sanskrit": "सर्वास्ताः संपरित्यज्य रोहिण्या सहितो रहः ।\nरेमे कामपरीतात्मा वनेषूपवनेषु च ।\nरमणीयेषु देशेषु कन्दरेषु गुहासु च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004838038, "chapter_id": 24838, "verse_number": "७-१-२१-३९", "content_sanskrit": "अथ ता दुःखसंपन्नाः पत्न्यः शेषा यशस्विनि ।\nजग्मुश्च शरणं दक्षं वचनं चेदमब्रुवन् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004838039, "chapter_id": 24838, "verse_number": "७-१-२१-४०", "content_sanskrit": "सोमः सर्वा तिक्रम्य रोहिण्या सह मोदते ।\nसंवत्सरसहस्रं तु क्रीडमानो यथासुखम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004838040, "chapter_id": 24838, "verse_number": "७-१-२१-४१", "content_sanskrit": "अवशिष्टास्तु षड्विंशन्मलिना विगतश्रियः ।\nपाणिग्रहणमारभ्य रोहिण्या सह चंद्रमाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004838041, "chapter_id": 24838, "verse_number": "७-१-२१-४२", "content_sanskrit": "संवत्सरसहस्रं तु जानात्येकां स शर्वरीम् ।\nपरित्यक्ता वयं तात शशिना दोषवर्जिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004838042, "chapter_id": 24838, "verse_number": "७-१-२१-४३", "content_sanskrit": "स रेमे सह रोहिण्या अस्माकमसुखप्रदः ।\nअस्माकं दुःखदग्धानां श्रेयोऽतो मरणं भवेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004838043, "chapter_id": 24838, "verse_number": "७-१-२१-४४", "content_sanskrit": "तासां तद्वचनं श्रुत्वा दुःखार्तानां प्रजापतिः ।\nब्रह्मतेजः समायुक्तः पुत्रीस्नेहेन कर्षितः ।\nजगाम यत्र ऋक्षेशो वचनं चेदमब्रवीत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004838044, "chapter_id": 24838, "verse_number": "७-१-२१-४५", "content_sanskrit": "समं वर्त्तस्व कन्यासु मामकासु निशाकर ।\nअन्यथा दोषभागी त्वं भविष्यसि न संशयः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004838045, "chapter_id": 24838, "verse_number": "७-१-२१-४६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा लज्जयावनतः स्थितः ।\nबाढमित्येव ऋक्षेंद्रो दक्षस्य पुरतोऽब्रवीत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004838046, "chapter_id": 24838, "verse_number": "७-१-२१-४७", "content_sanskrit": "अद्यप्रभृति विप्रर्षे समं वर्त्तयितास्म्यहम् ।\nपुत्रीभिस्तव सत्यं वै शपेऽहं शपथेन ते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004838047, "chapter_id": 24838, "verse_number": "७-१-२१-४८", "content_sanskrit": "एवं प्रतिज्ञासंयुक्ते निशानाथे तदांबिके ।\nसर्वा रूपेण संयुक्तास्तस्य कन्या निवेदिताः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004838048, "chapter_id": 24838, "verse_number": "७-१-२१-४९", "content_sanskrit": "दक्षः स्वभवनं गत्वा निर्वृतिं परमां गतः ।\nचन्द्रोऽपि पूर्ववद्देवि रोहिण्यां निरतोऽभवत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004838049, "chapter_id": 24838, "verse_number": "७-१-२१-५०", "content_sanskrit": "संपरित्यज्य ताः सर्वाः कामोपहतमानसः ।\nअथ भूयस्तु ताः सर्वा दक्षं वचनमब्रुवन् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004838050, "chapter_id": 24838, "verse_number": "७-१-२१-५१", "content_sanskrit": "मलिनास्ताः कृशांग्यश्च दीनाः सर्वा विचेतसः ।\nततो दृष्ट्वा तथारूपं दक्षो मोहमुपागतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004838051, "chapter_id": 24838, "verse_number": "७-१-२१-५२", "content_sanskrit": "लब्धसंज्ञः पुनः सोऽपि क्रोधोद्भूततनूरुहः ।\nउवाच सर्वाः स्वाः पुत्रीः किमित्थं मलिनांबराः ।\nकिमिदं निष्प्रभाः सर्वाः कथयध्वं ममानघाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004838052, "chapter_id": 24838, "verse_number": "७-१-२१-५३", "content_sanskrit": "असुरान्सानुगांश्चैव ये चान्ये सुरसत्तमाः ।\nअद्य शापहतान्पुत्र्यः करिष्यामि न संशयः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004838053, "chapter_id": 24838, "verse_number": "७-१-२१-५४", "content_sanskrit": "एवमुक्तास्तु दक्षेण सर्वास्ताः समुदैरयन् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004838054, "chapter_id": 24838, "verse_number": "७-१-२१-५५", "content_sanskrit": "न चास्माकं निशानाथ ऋतुमात्रमपि प्रभो ।\nप्रयच्छति पुनस्तेन युष्मत्पार्श्वं समागताः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004838055, "chapter_id": 24838, "verse_number": "७-१-२१-५६", "content_sanskrit": "अनादृत्य तु ते वाक्यं रोहिण्यां निरतो रहः ।\nरेमे कामपरीतात्मा अस्माकं शोकवर्द्धनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004838056, "chapter_id": 24838, "verse_number": "७-१-२१-५७", "content_sanskrit": "तासां तद्वचनं श्रुत्वा दक्षः कोपमुपागतः ।\nगत्वा चंद्रं महादेवि शशाप प्रमुखे स्थितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004838057, "chapter_id": 24838, "verse_number": "७-१-२१-५८", "content_sanskrit": "अनादृत्य हि मे वाक्यं यस्मात्त्वं रोहिणीरतः ।\nसंत्यज्य पुत्रीश्चास्माकं शेषा दोषेण वर्जिताः ।\nतस्माद्यक्ष्मा शरीरं ते ग्रसिष्यति न संशयः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004838058, "chapter_id": 24838, "verse_number": "७-१-२१-५९", "content_sanskrit": "एतस्मिन्नेव काले तु यक्ष्मा पर्वतपुत्रिके ।\nदक्षेण तु समादिष्टस्तस्य कायं समाविशत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004838059, "chapter_id": 24838, "verse_number": "७-१-२१-६०", "content_sanskrit": "यक्ष्मणा ग्रस्तकायोऽसौ क्षयं याति दिनेदिने ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004838060, "chapter_id": 24838, "verse_number": "७-१-२१-६१", "content_sanskrit": "एवं सोमस्तु दक्षेण कृतशापो गतप्रभः ।\nपपात वसुधां देवि निश्चेष्टो रोहिणीयुतः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004838061, "chapter_id": 24838, "verse_number": "७-१-२१-६२", "content_sanskrit": "लब्ध्वसंज्ञो मुहूर्तेन रोहिणीवाक्य मब्रवीत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004838062, "chapter_id": 24838, "verse_number": "७-१-२१-६३", "content_sanskrit": "देवि कार्यं किमधुना त्वत्पित्रा शापितो ह्यहम् ।\nक्षयकुष्ठेन संयुक्तः किं करोम्यधुना प्रिये ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004838063, "chapter_id": 24838, "verse_number": "७-१-२१-६४", "content_sanskrit": "एवमुक्ता रोहिणी तु बाष्पव्याकुललोचना ।\nदक्षशापहतं दृष्ट्वा सोमं वचनमब्रवीत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004838064, "chapter_id": 24838, "verse_number": "७-१-२१-६५", "content_sanskrit": "येन शापस्तु ते दत्तस्तमेव शरणं व्रज ।\nस ते शापाभिभूतस्य नूनं श्रेयो विधास्यति ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004838065, "chapter_id": 24838, "verse_number": "७-१-२१-६६", "content_sanskrit": "लप्स्यसे तत्प्रसादात्त्वं प्रभां पूर्वोचितां शुभाम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004838066, "chapter_id": 24838, "verse_number": "७-१-२१-६७", "content_sanskrit": "रोहिण्या वचनं श्रुत्वा गतो दक्षसमीपतः ।\nचंद्रः प्रोवाच विनयाद्वाष्प व्याकुललोचनः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004838067, "chapter_id": 24838, "verse_number": "७-१-२१-६८", "content_sanskrit": "कुरुष्वानुग्रहं दक्ष प्रसन्नेनांतरात्मना ।\nकोपं त्यज महर्षे त्वं ममोपरि दयां कुरु ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004838068, "chapter_id": 24838, "verse_number": "७-१-२१-६९", "content_sanskrit": "त्वया क्रोधपरीतेन कारणे वाप्यकारणे ।\nअनुकंपां च मे कृत्वा कार्यं शापस्य मोक्षणम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004838069, "chapter_id": 24838, "verse_number": "७-१-२१-७०", "content_sanskrit": "विदितं तु महाभाग शप्तोहं येन कर्मणा ।\nकुरुष्वानुग्रहं दक्ष मम दीनस्य याचतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004838070, "chapter_id": 24838, "verse_number": "७-१-२१-७१", "content_sanskrit": "एवं विलपमानस्य सोमस्य तु महात्मनः ।\nअनुग्रहे मतिं कृत्वा इदं वचनमब्रवीत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004838071, "chapter_id": 24838, "verse_number": "७-१-२१-७२", "content_sanskrit": "दक्ष उवाच ।\nमया शापहतः सोम त्रातुं शक्यो न दैवतैः ।\nयद्यद्ब्रवीम्यहं सोम तत्तथेति न संशयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004838072, "chapter_id": 24838, "verse_number": "७-१-२१-७३", "content_sanskrit": "आयुः कर्म च वित्तं च विद्या निधनमेव च ।\nपूर्वसृष्टानि यान्येव संभवंति हि तानि वै ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004838073, "chapter_id": 24838, "verse_number": "७-१-२१-७४", "content_sanskrit": "असुराश्च सुराश्चैव ये चान्ये यक्षराक्षसाः ।\nसर्वेपि शक्ता न त्रातुं वर्जयित्वा महेश्वरम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004838074, "chapter_id": 24838, "verse_number": "७-१-२१-७५", "content_sanskrit": "एषां शापो मया दत्तोऽनुग्रहीष्य ति शंकरः ।\nनान्यस्त्रातुं भवेच्छक्तो विना पशुपतिं भवम् ।\nतत्त्वं शीघ्रतरं गच्छ समाराधय शंकर ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004838075, "chapter_id": 24838, "verse_number": "७-१-२१-७६", "content_sanskrit": "न शक्तोऽन्यः पुनश्चंद्रः कर्तुं त्वां निर्मलं पुनः ।\nवर्जयित्वा महादेवं शितिकंठमुमापतिम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004838076, "chapter_id": 24838, "verse_number": "७-१-२१-७७", "content_sanskrit": "दक्षस्य च वचः श्रुत्वा कृतांजलिपुटः स्थितः ।\nप्रत्युवाच तदा सोमः प्रहष्टेनांतरात्मना ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004838077, "chapter_id": 24838, "verse_number": "७-१-२१-७८", "content_sanskrit": "भगवन्यदि तुष्टोसि मम भक्तस्य सुव्रत ।\nअनुग्रहे कृता बुद्धिस्तदाचक्ष्व कुतः शिवः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004838078, "chapter_id": 24838, "verse_number": "७-१-२१-७९", "content_sanskrit": "कस्मिन्स्थाने मया दक्ष द्रष्टव्योऽसौ महेश्वरः ।\nतत्स्थानानि चरिष्यामि यानि तानि वदस्व मे ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004838079, "chapter_id": 24838, "verse_number": "७-१-२१-८०", "content_sanskrit": "दक्ष उवाच ।\nशृणु सोम प्रयत्नेन श्रुत्वा चैवावधारय ।\nवारुणीं दिशमाश्रित्य सागरानूपसन्निधौ ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004838080, "chapter_id": 24838, "verse_number": "७-१-२१-८१", "content_sanskrit": "कृतस्मरस्यापरतो धन्वंतरशतत्रये ।\nलिंगं महाप्रभावं च स्वयंभूतं व्यवस्थितम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004838081, "chapter_id": 24838, "verse_number": "७-१-२१-८२", "content_sanskrit": "सूर्य्यबिंबसमप्रख्यं सर्प मेखलमंडितम् ।\nकुक्कुटांडकमानं तद्भूमिमध्ये व्यवस्थितम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004838082, "chapter_id": 24838, "verse_number": "७-१-२१-८३", "content_sanskrit": "स्पर्शलिंगं हि तद्विद्धि तद्भक्त्या ज्ञास्यते भवान् ।\nतत्र संनिहितो देवः शंकरः परमेश्वरः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004838083, "chapter_id": 24838, "verse_number": "७-१-२१-८४", "content_sanskrit": "गच्छ त्वं तपसोग्रेण आराधय सुरेश्वरम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004838084, "chapter_id": 24838, "verse_number": "७-१-२१-८५", "content_sanskrit": "प्रशस्य देवदेवेशमात्मानं निर्मलं कुरु ।\nयस्याशु वरदानेन प्राप्स्यसे रूपमुत्तमम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004838085, "chapter_id": 24838, "verse_number": "७-१-२१-८६", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्यासंहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये सोमेश्वरोत्पत्तिप्रसंगे दक्षेण स्वशापजन्ययक्ष्मरोगार्त्तस्य चंद्रस्य यक्ष्मकुष्ठरोगनिवृत्तये शिवाराधनोपदेशवर्णनंनामैकविंशोऽध्यायः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]