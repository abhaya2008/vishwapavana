[{"id": 7000078000, "chapter_id": 20078, "verse_number": "७८-१", "content_sanskrit": "अथाष्टसप्ततितमोऽध्यायः सगराख्यानकथनम् नारद उवाच द्विविधा सैव गदिता एकाऽपि सुरसत्तम् ।\nएको भेदस्तु कथितो ब्राह्मणेनाऽऽहृतो यतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000078001, "chapter_id": 20078, "verse_number": "७८-२", "content_sanskrit": "क्षत्रियेणापरोऽप्यंशो जटास्वेव व्यवस्थितः ।\nभवस्य देवदेवस्य आहृतस्तद्वदस्व मे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000078002, "chapter_id": 20078, "verse_number": "७८-३", "content_sanskrit": "वैवस्वतान्वये जात इक्ष्वाकुकुलसंभवः ।\nपुरा वै सगरो नाम राजाऽऽसीदतिधार्मिकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000078003, "chapter_id": 20078, "verse_number": "७८-४", "content_sanskrit": "यज्वा दानपरो नित्यं धर्माचारविचारवान् ।\nतस्य भार्याद्वयं चाऽऽसीत्पतिभक्तिपरायणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000078004, "chapter_id": 20078, "verse_number": "७८-५", "content_sanskrit": "तस्य वै संततिर्नाभूदिति चिन्तापरोऽभवत् ।\nवसिष्ठं गृहमाहूय संपूज्य विधिवत्ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000078005, "chapter_id": 20078, "verse_number": "७८-६", "content_sanskrit": "उवाच वचनं राजा संततेः कारणं प्रति ।\nइति तद्वचनं श्रुत्वा ध्यात्वा राजानमब्रवीत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000078006, "chapter_id": 20078, "verse_number": "७८-७", "content_sanskrit": "वसिष्ठ उवाच सपत्नीकः सदा राजन्नृषिपूजापरे भव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000078007, "chapter_id": 20078, "verse_number": "७८-८", "content_sanskrit": "ब्रह्मोवाच इत्युक्त्वा स मुनिर्विप्र यथास्थानं जगाम ह ।\nएकदा तस्य राजर्षेर्गृहमागात्तपोनिधिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000078008, "chapter_id": 20078, "verse_number": "७८-९", "content_sanskrit": "तस्यर्षेः पूजनं चक्रे स संतुष्टोऽब्रवीद्वचः ।\nवरं ब्रूहि महाभागेत्युक्ते पुत्रान्स चावृणोत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000078009, "chapter_id": 20078, "verse_number": "७८-१०", "content_sanskrit": "स मुनिः प्राह राजानमेकस्यां वंशधारकः ।\nपुत्रो भूयात्तथाऽन्यस्यां षष्टिसाहस्रकं सुताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000078010, "chapter_id": 20078, "verse_number": "७८-११", "content_sanskrit": "वरं दत्त्वा मुनौ याते पुत्रा जाताः सहस्रशः ।\nस यज्ञान्सुबहूंश्चक्रे हयमेधान्सुदक्षिणान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000078011, "chapter_id": 20078, "verse_number": "७८-१२", "content_sanskrit": "एकस्मिन्हयमेधे वै दीक्षितो विधिवन्नृपः ।\nपुत्रान्न्ययोजयद्राजा ससैन्यान्हयरक्षणे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000078012, "chapter_id": 20078, "verse_number": "७८-१३", "content_sanskrit": "क्वचिदन्तरमासाद्य हयं जह्रे शतक्रतुः ।\nमार्गमाणाश्च ते पुत्रा नैवापश्यन्हयं तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000078013, "chapter_id": 20078, "verse_number": "७८-१४", "content_sanskrit": "सहस्राणां तथा षिष्टिर्नानायुद्धविशारदाः ।\nतेषु पश्यत्सु रक्षांसि पुत्रेषु सगरस्य हि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000078014, "chapter_id": 20078, "verse_number": "७८-१५", "content_sanskrit": "प्रोक्षितं तद्धयं नीत्वा ते रसातलमागमन् ।\nराक्षसान्मायया युक्तान्नैवापश्यन्त सागराः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000078015, "chapter_id": 20078, "verse_number": "७८-१६", "content_sanskrit": "न दृष्ट्वा ते हयं पुत्राः सगरस्य बलीयसः ।\nइतश्चेतश्चनरन्तस्ते नैवापश्यन्हयं तदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000078016, "chapter_id": 20078, "verse_number": "७८-१७", "content_sanskrit": "देवलोकं तदा जग्मुः पर्वतांश्च सरांसि च ।\nवनानि च विचिन्वन्तो नैवापश्यन्हयं तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000078017, "chapter_id": 20078, "verse_number": "७८-१८", "content_sanskrit": "कृतस्वस्त्ययनो राजा ऋत्विग्भिः कृतमङ्लः ।\nअदृष्ट्वा तु पशुं रम्यं राजा चिन्तामुपेयिवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000078018, "chapter_id": 20078, "verse_number": "७८-१९", "content_sanskrit": "अटन्तः सागराः सर्वे देवलोकमुपागमन् ।\nहयं तमनुचिन्वन्तस्तत्रापि न हयोऽभवत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000078019, "chapter_id": 20078, "verse_number": "७८-२०", "content_sanskrit": "ततो महीं समाजग्मुः पर्वतांश्च वनानि च ।\nतत्रापि च हयं नैव दृष्टवन्तो नृपात्मजाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000078020, "chapter_id": 20078, "verse_number": "७८-२१", "content_sanskrit": "एतस्मिन्नन्तरे यत्र दैवी वागभवत्तदा ।\nरसातले हयो बद्ध आस्ते नान्यत्र सागराः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000078021, "chapter_id": 20078, "verse_number": "७८-२२", "content_sanskrit": "इति श्रुत्वा ततो वाक्यं गन्तुकामा रसातलम् ।\nअखनन्पृथिवीं सर्वां परितः सागरास्ततः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000078022, "chapter_id": 20078, "verse_number": "७८-२३", "content_sanskrit": "ते क्षुधार्ता मृदं शुष्कां भक्षयन्तस्त्वहर्निशम् ।\nन्यखनंश्चापि जग्मुश्च सत्परास्ते रसातलम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000078023, "chapter_id": 20078, "verse_number": "७८-२४", "content_sanskrit": "तानागतान्भूपसुतान्सागरान्बलिनः कृतीन् ।\nश्रुत्वा रक्षांसि संत्रस्तां व्यगमन्कपिलान्तिकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000078024, "chapter_id": 20078, "verse_number": "७८-२५", "content_sanskrit": "कपिलोऽपि महाप्राज्ञस्तत्र शेते रसातले ।\nपुरा च साधितं तेन देवानां कार्यमुत्तमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000078025, "chapter_id": 20078, "verse_number": "७८-२६", "content_sanskrit": "विनिद्रेण ततः श्रान्तः सिद्धे कार्ये सुरान्प्रति ।\nअब्रवीत्कपिलः श्रीमान्निद्रास्थानं प्रयच्छथ(त) ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000078026, "chapter_id": 20078, "verse_number": "७८-२७", "content_sanskrit": "रसातलं ददुस्तस्मै पुनराह सुरान्मुनिः ।\nयो मामुत्थापयेन्मन्दो भस्मी भूयाच्च सत्वरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000078027, "chapter_id": 20078, "verse_number": "७८-२८", "content_sanskrit": "ततः शये तलगतो नो चेन्न स्वप्न एव हि ।\nतथेत्युक्तः सुरगणैस्तत्र शेते रसातले ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000078028, "chapter_id": 20078, "verse_number": "७८-२९", "content_sanskrit": "तस्य प्रभावं ते ज्ञात्वा राक्षसा मायया युताः ।\nसागराणां च सर्वेषां वधोपायं प्रचक्रिरे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000078029, "chapter_id": 20078, "verse_number": "७८-३०", "content_sanskrit": "विना युद्धेन ते भीता राक्षसाः सत्वरास्तदा ।\nआगत्य यत्र स मुनिः कपिलः कोपनो महान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000078030, "chapter_id": 20078, "verse_number": "७८-३१", "content_sanskrit": "शिरोदेशे हयं ते वै बद्ध्यवाऽथ त्वरयाऽन्विताः ।\nदूरे स्थित्वा मौनिनश्च प्रेक्षन्तः किं भवेदिति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000078031, "chapter_id": 20078, "verse_number": "७८-३२", "content_sanskrit": "ततस्तु सागराः सर्वे निर्विशन्तो रसातलम् ।\nददृशुस्ते हयं बद्धं शयानं परुषं तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000078032, "chapter_id": 20078, "verse_number": "७८-३३", "content_sanskrit": "तं मेनिरे च हर्तारं क्रतुहन्तारमेव च ।\nएनं हत्वा महापापं नयामोऽश्वं नृपान्तिकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000078033, "chapter_id": 20078, "verse_number": "७८-३४", "content_sanskrit": "केचिदूचुः पशुं बद्धं नयामोऽनेन किं फलम् ।\nतदाऽऽहुरपरे शूरा राजानः शासका वयम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000078034, "chapter_id": 20078, "verse_number": "७८-३५", "content_sanskrit": "उत्थाप्यैनं महापापं हन्मः क्षात्रेण वर्चसा ।\nते तं जघ्नुर्मुनिं पादैर्ब्रुवन्तो निष्ठुराणि च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000078035, "chapter_id": 20078, "verse_number": "७८-३६", "content_sanskrit": "ततः कोपेन महता कपिलो मुनिसत्तमः ।\nसागरानीक्षयामास तान्कोपाद्भस्मसात्करोत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000078036, "chapter_id": 20078, "verse_number": "७८-३७", "content_sanskrit": "जज्वलुस्ते ततस्तत्र सागराः सर्व एव हि ।\nतत्तु सर्वं न जानाति दीक्षितः सगरो नृपः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000078037, "chapter_id": 20078, "verse_number": "७८-३८", "content_sanskrit": "नारदः कथयामास सगराय महात्मने ।\nकपिलस्य तु संस्थानं हयस्यापि तु संस्थितिम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000078038, "chapter_id": 20078, "verse_number": "७८-३९", "content_sanskrit": "राक्षसानां तु विकृतिं सागराणां च नाशनम् ।\nततश्चिन्तापरो राजा कर्तव्यं नावबुध्यत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000078039, "chapter_id": 20078, "verse_number": "७८-४०", "content_sanskrit": "अपरोऽपि सुतश्चाऽऽसीदसमञ्जा इति श्रुतः ।\nस तु बालांस्तथा पौरान्मौर्ख्यात्क्षिपति चाम्भसि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000078040, "chapter_id": 20078, "verse_number": "७८-४१", "content_sanskrit": "सगरोऽप्यथ विज्ञप्तः पौरैः संमिलितैस्तदा ।\nदुर्नयं तस्य तं ज्ञात्वा ततः क्रुद्धोऽब्रवीन्नृपः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000078041, "chapter_id": 20078, "verse_number": "७८-४२", "content_sanskrit": "स्वानमात्यांस्तदा राजा देशत्यागं करोत्वयम् ।\nअसमञ्जाः क्षत्रधर्मत्यागी वै बालघातकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000078042, "chapter_id": 20078, "verse_number": "७८-४३", "content_sanskrit": "सगरस्य तु तद्वाक्यं श्रुत्वाऽमात्यास्त्वरान्विताः ।\nतत्यजुर्नृपतेः पुत्रमसमञ्जा गतो वनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000078043, "chapter_id": 20078, "verse_number": "७८-४४", "content_sanskrit": "सागरा ब्रह्मशापेन नष्टाः सर्वे रसातले ।\nएकोऽपि च वनं प्राप्त इदानीं का गतिर्मम ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000078044, "chapter_id": 20078, "verse_number": "७८-४५", "content_sanskrit": "अंशुमानिति विख्यातः पुत्रस्तस्यासमञ्जसः ।\nआनाय्य बालकं राजा कार्यं तस्मै न्यवेदयत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000078045, "chapter_id": 20078, "verse_number": "७८-४६", "content_sanskrit": "कपिलं च समाराध्य अंशुमानापि बालकः ।\nसगराय हयं प्रादात्ततः पूर्णोऽभत्क्रतुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000078046, "chapter_id": 20078, "verse_number": "७८-४७", "content_sanskrit": "तस्यापि पुत्रस्तेजस्वी दिलीप इति धर्मिकः ।\nतस्यापि पुत्रो मतिमान्भगीरथ इति श्रुतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000078047, "chapter_id": 20078, "verse_number": "७८-४८", "content_sanskrit": "पितामहानां सर्वेषां गतिं श्रुत्वा सुदुःखितः ।\nसगरं नृपशार्दूलं पप्रच्छ विनयान्वितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000078048, "chapter_id": 20078, "verse_number": "७८-४९", "content_sanskrit": "सगराणां तु सर्वेषां निष्कटतिस्तु कथं भवेत् ।\nभगीरथं नृपः प्राह कपिलो वेत्ति पुत्रक ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000078049, "chapter_id": 20078, "verse_number": "७८-५०", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा बालः प्रायाद्रसातलम् ।\nकपिलं च नमस्कृत्वा सर्वं तस्मै न्यवेदयत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000078050, "chapter_id": 20078, "verse_number": "७८-५१", "content_sanskrit": "स मुनिस्तु चिरं ध्यात्वा तपसाऽऽराध्य शंकरम् ।\nजटाजलेन स्वपितॄनाप्लाव्य नृपसत्तम ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000078051, "chapter_id": 20078, "verse_number": "७८-५२", "content_sanskrit": "ततः कृतार्थो भविता त्वं च ते पितरस्तथा ।\nतथा करोमीति मुनिं प्रणम्य पुनरब्रवीत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000078052, "chapter_id": 20078, "verse_number": "७८-५३", "content_sanskrit": "क्व गच्छेऽहं मुनिश्रेष्ठ कर्तव्यं चापि तद्वद ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000078053, "chapter_id": 20078, "verse_number": "७८-५४", "content_sanskrit": "कपिल उवाच कैलासं तं नरश्रेष्ठ गत्वा स्तुहि महेश्वरम् ।\nतपः कुरु यथाशक्ति ततश्चेप्सितमाप्स्यसि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000078054, "chapter_id": 20078, "verse_number": "७८-५५", "content_sanskrit": "ब्रह्मोवाच तच्छ्रुत्वा स मुनेर्वाक्यं मुनिं नत्वा त्वगान्नगम् ।\nकैलासं स शुचिर्भूत्वा बालो बालक्रियान्वितः ।\nतपसे निश्चयं कृत्वा उवाच स भगीरथः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000078055, "chapter_id": 20078, "verse_number": "७८-५६", "content_sanskrit": "भगीरथ उवाच बालोऽहं बालबुद्धिश्च बालचन्द्रधर प्रभो ।\nनाहं किमपि जानामि ततः प्रीतो भव प्रभो ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000078056, "chapter_id": 20078, "verse_number": "७८-५७", "content_sanskrit": "वाग्भिर्मनोभिः कृतिभिः कदाचिन्ममोपकुर्वन्ति हिते रता ये ।\nतेभ्यो हितार्थं त्विह चामरेश, सोमं नमस्यामि सुरादिपूज्यम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000078057, "chapter_id": 20078, "verse_number": "७८-५८", "content_sanskrit": "उत्पादितो यैरभिवर्धितश्च, समानगोत्रश्च समानधर्मा ।\nतेषामभीष्टानि शिवः करोतु, बालेन्दुमौलिं प्रणतोऽस्मि नित्यम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000078058, "chapter_id": 20078, "verse_number": "७८-५९", "content_sanskrit": "ब्रह्मोवाच एवं तु ब्रुवतस्तस्य पुरस्तादभवच्छिवः ।\nवरेण च्छन्दयानो वै भगीरथमुवाच ह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000078059, "chapter_id": 20078, "verse_number": "७८-६०", "content_sanskrit": "शिव उवाच यन्न साध्यं सुरगणैर्देयं तत्ते मया ध्रुवम् ।\nवदस्व निर्भयो भूत्वा भगीरथ महामते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000078060, "chapter_id": 20078, "verse_number": "७८-६१", "content_sanskrit": "ब्रह्मोवाच भगीरथः प्रणम्येशं हृष्टः प्रोवाच शंकरम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000078061, "chapter_id": 20078, "verse_number": "७८-६२", "content_sanskrit": "भगीरथ उवाच जटस्थितां पितॄणां मे पावनाय सरिद्वराम् ।\nतामेव देहि देवेश सर्वमाप्तं ततो भवेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000078062, "chapter_id": 20078, "verse_number": "७८-६३", "content_sanskrit": "ब्रह्मोवाच महेशोऽपि विहस्याथ भगीरथमुवाच ह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000078063, "chapter_id": 20078, "verse_number": "७८-६४", "content_sanskrit": "शिव उवाच दत्ता मयेयं ते पुत्र पुनस्तां स्तुहि सुव्रत ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000078064, "chapter_id": 20078, "verse_number": "७८-६५", "content_sanskrit": "ब्रह्मोवाच तद्देववचनं श्रुत्वा तदर्थं तु तपो महत् ।\nस्तुतिं चकार गङ्गाया भक्त्या प्रयतमानसः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000078065, "chapter_id": 20078, "verse_number": "७८-६६", "content_sanskrit": "तस्या अपि प्रसादं प्राप्य बालोऽप्यबालवत् ।\nगङ्गां महेश्वरात्प्राप्तामादायागाद्रसातलम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000078066, "chapter_id": 20078, "verse_number": "७८-६७", "content_sanskrit": "न्यवेदयत्स मुनये कपिलाय महात्मने ।\nयथोदितप्रकारेण गङ्गां संस्थाप्य यत्नतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000078067, "chapter_id": 20078, "verse_number": "७८-६८", "content_sanskrit": "प्रदक्षिणमथाऽऽवर्त्य कृताञ्जलिपुटोऽब्रवीत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000078068, "chapter_id": 20078, "verse_number": "७८-६९", "content_sanskrit": "भगीरथ उवाच देवि मे पितरः शापात्कपिलस्य महामुनेः ।\nप्राप्तास्ते विगतिं मातस्तस्मात्तान्पातुर्महसि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000078069, "chapter_id": 20078, "verse_number": "७८-७०", "content_sanskrit": "तथेत्युक्त्वा सुरनदी सर्वेषामुपकारिका ।\nलोकनामुकारार्थं पितॄणां पावनाय च ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000078070, "chapter_id": 20078, "verse_number": "७८-७१", "content_sanskrit": "अगस्त्यपीतस्याम्भोधेः पूरणाय विशेषतः ।\nस्मरणादेव पापानां नाशाय सुरनिम्नगा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000078071, "chapter_id": 20078, "verse_number": "७८-७२", "content_sanskrit": "भगीरथोदितं चक्रे रसातलतले स्थितान् ।\nभस्मीभूतान्नृपसुतान्सागरांश्च विशेषतः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000078072, "chapter_id": 20078, "verse_number": "७८-७३", "content_sanskrit": "विनिर्दग्धानथाऽऽप्लाव्य खातपूरमथाकरोत् ।\nततो मेरुं समाप्लाव्य स्थितां बालोऽब्रवीन्नृपः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000078073, "chapter_id": 20078, "verse_number": "७८-७४", "content_sanskrit": "कर्मभूमौ त्वया भाव्यं तथेत्यागाद्धिमालयम् ।\nहिमवत्पर्वतात्पुण्याद्भारतं वर्षमभ्यगात् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000078074, "chapter_id": 20078, "verse_number": "७८-७५", "content_sanskrit": "तन्मध्यतः पुण्यनदी प्रायात्पूर्वार्णवं प्रति ।\nएवमेषाऽपि ते प्रोक्ता गङ्गा क्षात्रा महामुने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000078075, "chapter_id": 20078, "verse_number": "७८-७६", "content_sanskrit": "माहेश्वरी वैष्णवी च सैव ब्राह्मी च पावनी ।\nभागीरथी देवनदी हिमवच्छिखराश्रया ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000078076, "chapter_id": 20078, "verse_number": "७८-७७", "content_sanskrit": "प्रहेश्वरजटावारि एवं द्वैविध्यमागतम् ।\nविन्ध्यस्य दक्षिणे गङ्गा गौतमी सा निगद्यते ।\nउत्तरे साऽपि विन्ध्यस्य भागीरथ्यभिधीयते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]