[{"id": 2102488, "chapter_id": 3218, "verse_number": "१४-७४-१", "content_sanskrit": "वैशम्पायन उवाच।\nत्रिगर्तैरभवद्युद्धं कृतवैरैः किरीटिनः।\nमहारथसमाज्ञातैर्हतानां पुत्रनप्तृभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102489, "chapter_id": 3218, "verse_number": "१४-७४-२", "content_sanskrit": "ते समाज्ञाय सम्प्राप्तं यज्ञियं तुरगोत्तम*****\nविषयान्तं ततो वीरा दंशिताः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102490, "chapter_id": 3218, "verse_number": "१४-७४-३", "content_sanskrit": "रथिनो बद्धतूणीराः सदश्वैः समलङ्कृतैः।\nपरिवार्य हयं राजन्ग्रहीतुं सम्प्रचक्रमुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102491, "chapter_id": 3218, "verse_number": "१४-७४-४", "content_sanskrit": "ततः किरीटी सञ्चिन्त्य तेषां तत्र चिकीर्षितम्।\nवारयामास तान्वीरान्सान्त्वपूर्वमरिंदमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102492, "chapter_id": 3218, "verse_number": "१४-७४-५", "content_sanskrit": "तदनादृत्य ते सर्वे शरैरभ्यहनंस्तदा।\nतमोरजोभ्यां संछन्नांस्तान्किरीटी न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102493, "chapter_id": 3218, "verse_number": "१४-७४-६", "content_sanskrit": "तानव्रवीत्ततो जिष्णुः प्रहसन्निव भारत।\nनिवर्तध्वमधर्मज्ञाः श्रेयो जीवितमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102494, "chapter_id": 3218, "verse_number": "१४-७४-७", "content_sanskrit": "स हि वीरः प्रयास्यन्वै धर्मराजेन वारितः।\nहतबान्धवा न ते पार्त हन्तव्याः पार्थिवा इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102495, "chapter_id": 3218, "verse_number": "१४-७४-८", "content_sanskrit": "स तदा तद्वचः श्रुत्वा धर्मराजस्य धीमतः।\nतान्निवर्तध्वमित्याह न न्यवर्तन्ति चापि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102496, "chapter_id": 3218, "verse_number": "१४-७४-९", "content_sanskrit": "ततस्त्रिगर्तराजानं सूर्यवर्माणमाहवे।\nविनद्य शरजालेनि प्रजहास धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102497, "chapter_id": 3218, "verse_number": "१४-७४-१०", "content_sanskrit": "ततस्ते रथघोपेण रथनेमिस्वनेन च।\nपूरयन्तो दिशः सर्वा धनंजयमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102498, "chapter_id": 3218, "verse_number": "१४-७४-११", "content_sanskrit": "सूर्यवर्मा ततः पार्ते शराणां नतपर्वणाम्।\nशतान्यमुञ्चद्राजेन्द्र लघ्वस्त्रमभिदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102499, "chapter_id": 3218, "verse_number": "१४-७४-१२", "content_sanskrit": "तथैवान्ये महेष्वासा ये च तस्यानुयायिनः।\nमुमुचुः शरवर्षाणि धनंजयवधैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102500, "chapter_id": 3218, "verse_number": "१४-७४-१३", "content_sanskrit": "स ताञ्ज्यामुखनिर्मुक्तैर्बहुभिः सुबहूञ्शरान्।\nचिच्छेद पाण्डवो राजंस्ते भूमौ न्यपतंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102501, "chapter_id": 3218, "verse_number": "१४-७४-१४", "content_sanskrit": "केतुवर्मा तु तेजस्वी तस्यैवावरजो युवा।\nयुयुधे भ्रातुरर्थाय पाण्डवेन यशस्विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102502, "chapter_id": 3218, "verse_number": "१४-७४-१५", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य केतुवर्माणमाहवे।\nअभ्यघ्नन्निशितैर्बाणैर्बीभत्सुः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102503, "chapter_id": 3218, "verse_number": "१४-७४-१६", "content_sanskrit": "केतुवर्मण्यभिहते धृतवर्मा महारथः।\nरथेनाशु समुत्पत्य शरैर्जिष्णुमवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102504, "chapter_id": 3218, "verse_number": "१४-७४-१७", "content_sanskrit": "तस्य तां शीघ्रतामीक्ष्य तुतोषातीव वीर्यवान्।\nगुडाकेशो महादेजा बालस्य धृतवर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102505, "chapter_id": 3218, "verse_number": "१४-७४-१८", "content_sanskrit": "न संदधानं ददृशे नाददानं च तं तदा।\nकिरन्तमेवं स शरान्ददृशे पाकशासनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102506, "chapter_id": 3218, "verse_number": "१४-७४-१९", "content_sanskrit": "स तु तं पूजयामास धृतवर्माणमाहवे।\nमनसा तु मुहूर्तं वै रणे समभिहर्षयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102507, "chapter_id": 3218, "verse_number": "१४-७४-२०", "content_sanskrit": "`न विव्याध रणे क्रुद्धः कुन्तीपुत्रो हसन्निव।\nसौभद्रस्येव तत्कर्म दृष्ट्वा बालस्य विस्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102508, "chapter_id": 3218, "verse_number": "१४-७४-२१", "content_sanskrit": "तं पन्नगमिव क्रुद्धं कुरुवीरः स्मयन्निव।\nप्रीतिपूर्वं महाबाहुः प्राणैर्न व्यपरोपयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102509, "chapter_id": 3218, "verse_number": "१४-७४-२२", "content_sanskrit": "स तथा रक्ष्यमाणो वै पार्थेनामिततेजसा।\nधृतवर्मा शरं दीप्तं मुमोच विजये तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102510, "chapter_id": 3218, "verse_number": "१४-७४-२३", "content_sanskrit": "स तेन विजयस्तूर्णमासीद्विद्धः करे भृशम्।\nमुमोच गाण्डिवं मोहात्तत्पपाताथ भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102511, "chapter_id": 3218, "verse_number": "१४-७४-२४", "content_sanskrit": "धनुषः पततस्तस्य सव्यसाचिकराद्विभो।\nबभूव सदृशं रूपं शक्रचापस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102512, "chapter_id": 3218, "verse_number": "१४-७४-२५", "content_sanskrit": "तस्मिन्निपतिते दिव्ये महाधनुषि पार्थिवः।\nचकार सस्वनं हासं धृतवर्मा महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102513, "chapter_id": 3218, "verse_number": "१४-७४-२६", "content_sanskrit": "ततो रोषार्दितो जिष्णुः प्रमृज्य रुधिरं करात्।\nधनुरादत्त तद्दिव्यं शरवर्षैर्ववर्ष च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102514, "chapter_id": 3218, "verse_number": "१४-७४-२७", "content_sanskrit": "ततो हलहलाशब्दो दिवस्पृगभवत्तदा।\nनानाविधानां भूतानां तत्कर्माणि प्रशंसताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102515, "chapter_id": 3218, "verse_number": "१४-७४-२८", "content_sanskrit": "ततः सम्प्रेक्ष्य संक्रुद्धं कालान्तकयमोपमम्।\nजिष्णुं त्रैगर्तका योधाः परीताः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102516, "chapter_id": 3218, "verse_number": "१४-७४-२९", "content_sanskrit": "अभिसृत्य परीप्सार्थं ततस्ते धृतवर्मणः।\nपरिवव्रुर्गुडाकेशं तत्राक्रुद्ध्यद्धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102517, "chapter_id": 3218, "verse_number": "१४-७४-३०", "content_sanskrit": "ततो योधाञ्जघानाशु तेषां स दश चाष्ट च।\nमहेन्द्रवज्रप्रतिमैरायसैर्बहुभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102518, "chapter_id": 3218, "verse_number": "१४-७४-३१", "content_sanskrit": "तान्सम्प्रभग्नान्सम्प्रेक्ष्य त्वरमाणो धनंजयः।\nशरैराशीविषाकारैर्जघान स्वनवद्धसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102519, "chapter_id": 3218, "verse_number": "१४-७४-३२", "content_sanskrit": "ते भग्नमनसः सर्वे त्रैगर्तकमहारथाः।\nदिशोऽभिदुद्रुवू राजन्धनंजयशरार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102520, "chapter_id": 3218, "verse_number": "१४-७४-३३", "content_sanskrit": "`हतावशिष्टा हि पराः पार्थं दृष्टपराक्रमाः।\nतमूचुः पुरुषव्याघ्रं संशप्तकनिषूदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102521, "chapter_id": 3218, "verse_number": "१४-७४-३४", "content_sanskrit": "तवास्म किंकराः सर्वे सर्वे वै वशगास्तव।\nआज्ञापयस्वः नः पार्थ प्रह्वान्प्रेष्यानवस्थितान्।\nकरिष्यामः प्रियं सर्वं तव कौरवनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2102522, "chapter_id": 3218, "verse_number": "१४-७४-३५", "content_sanskrit": "एतदाज्ञाय वचनं सर्वांस्तानब्रवीत्तदा।\nजीवितं रक्षत नृपाः शासनं प्रतिगृह्यताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2102523, "chapter_id": 3218, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि चतुःसप्ततितमोऽध्यायः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]