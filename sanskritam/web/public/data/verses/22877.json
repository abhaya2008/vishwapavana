[{"id": 7002877000, "chapter_id": 22877, "verse_number": "९-१६२-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nमहिषीदानमाहात्म्यं कथयामि युधिष्ठिर ।\nपुण्यं पापविनाशं च आयुष्यं सर्वकामदम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002877001, "chapter_id": 22877, "verse_number": "९-१६२-२", "content_sanskrit": "चन्द्रसूर्यग्रहे पुण्ये कार्त्तिक्यामयने तथा ।\nशुक्लपक्षे चतुर्दश्यां सूर्यसंक्रान्तिवासरे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002877002, "chapter_id": 22877, "verse_number": "९-१६२-३", "content_sanskrit": "यदा वा जायते चित्तं वित्तं च कुरुनन्दन ।\nतदैव देया महिषी संसारभयभीरुणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002877003, "chapter_id": 22877, "verse_number": "९-१६२-४", "content_sanskrit": "सुपयोधरशोभाढ्या सुशृंगी सुखुरा तथा ।\nप्रथमप्रसूता तरुणी सुशीला दोषवर्जिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002877004, "chapter_id": 22877, "verse_number": "९-१६२-५", "content_sanskrit": "सुवर्णशृङ्गतिलका घंटाभरणभूषिता ।\nरक्तवस्त्रावृता रम्या कांस्यदोहनकान्विता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002877005, "chapter_id": 22877, "verse_number": "९-१६२-६", "content_sanskrit": "पिण्याकपिटिकोपेता सहिरण्या च शक्तितः ।\nसप्तधान्ययुता देया ब्राह्मणे वेदपारगे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002877006, "chapter_id": 22877, "verse_number": "९-१६२-७", "content_sanskrit": "पुराणपाठके तद्वज्ज्योतिःशास्त्रविदे तथा ।\nदेया न वेदरहिते न च कुव्रतिने क्वचित् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002877007, "chapter_id": 22877, "verse_number": "९-१६२-८", "content_sanskrit": "द्रव्यैरेभिः समायुक्तां पुण्येऽह्नि विधिपूर्वकम् ।\nदद्यान्मंत्रेण राजेन्द्र पुराणपठितेन तु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002877008, "chapter_id": 22877, "verse_number": "९-१६२-९", "content_sanskrit": "इन्द्रादिलोकपालानां या राजमहिषी शुभा ।\nमहिषी दानमाहात्म्यात्सास्तु मे सर्वकामदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002877009, "chapter_id": 22877, "verse_number": "९-१६२-१०", "content_sanskrit": "धर्मराजस्य साहाय्ये यस्याः पुत्रः प्रतिष्ठितः ।\nमहिषासुरस्य जननी या सास्तु वरदा मम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002877010, "chapter_id": 22877, "verse_number": "९-१६२-११", "content_sanskrit": "दद्यात्प्रदक्षिणीकृत्य ब्राह्मणे तां पयस्विनीम् ।\nप्रतिग्रहः स्मृतस्तस्याः पृष्ठदेशे स्वयंभुवा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002877011, "chapter_id": 22877, "verse_number": "९-१६२-१२", "content_sanskrit": "एवं दत्त्वा विधानेन ब्राह्मणस्य गृहं नयेत् ।\nवस्त्रैराभरणैः पूज्य भक्त्या च कुरुनन्दन ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002877012, "chapter_id": 22877, "verse_number": "९-१६२-१३", "content_sanskrit": "संपादिता मया तुभ्यं संतुष्टो मे भव द्विज ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002877013, "chapter_id": 22877, "verse_number": "९-१६२-१४", "content_sanskrit": "अनेन विधिना दत्त्वा महिषीं द्विजपुङ्गवे ।\nसर्वान्कामानवाप्नोति इह लोके परत्र च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002877014, "chapter_id": 22877, "verse_number": "९-१६२-१५", "content_sanskrit": "या सा ददाति महिषीं सा राजमहिषी भवेत् ।\nमहाराजः पुमान्राजन्व्यासस्य वचनं यथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002877015, "chapter_id": 22877, "verse_number": "९-१६२-१६", "content_sanskrit": "यज्ञयाजी भवेद्विप्रः क्षत्रियो विजयी भवेत् ।\nभवेद्वैश्यस्तु धनवाञ्छूद्रः सर्वार्थसंयुतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002877016, "chapter_id": 22877, "verse_number": "९-१६२-१७", "content_sanskrit": "तस्मान्नरेण दातव्या महिषी विभवे सति ।\nपुत्रपौत्रप्रपौत्रार्थमात्मनः शुभमिच्छता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002877017, "chapter_id": 22877, "verse_number": "९-१६२-१८", "content_sanskrit": "दशधेनुसमां राजन्महिषीं नारदोऽब्रवीत् ।\nविंशतिगोसमां व्यासः सर्वदानोत्तमं रविः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002877018, "chapter_id": 22877, "verse_number": "९-१६२-१९", "content_sanskrit": "सगरेण ककुत्स्थेन धुंधुमारेण गाधिना ।\nदत्ताः संपूज्य विप्रेभ्यो महिष्यः सर्वकामदाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002877019, "chapter_id": 22877, "verse_number": "९-१६२-२०", "content_sanskrit": "महिषी दानमाहात्म्यं यः शृणोति सदा नरः ।\nस सर्वपापनिर्मुक्तः शिवलोके महीयते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002877020, "chapter_id": 22877, "verse_number": "९-१६२-२१", "content_sanskrit": "दुग्धाधिकां हि महिषीं जलमेघवर्णां सपुष्टपट्टकवतीं जघनाभिरामाम् ।\nदत्त्वा सुवर्णतिलकां द्विजपुंगवाय लोकद्वयं विजयते किमु तत्र चित्रम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]