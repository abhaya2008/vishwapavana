[{"id": 5000569000, "chapter_id": 9569, "verse_number": "७-३४-१", "content_sanskrit": "अर्जुनेन विमुक्तस्तु रावणो राक्षसाधिपः ।\nचचार पृथिवीं सर्वामनिर्विण्णस्तथा कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000569001, "chapter_id": 9569, "verse_number": "७-३४-२", "content_sanskrit": "राक्षसं वा मनुष्यं वा शृणुते ऽयं बलाधिकम् ।\nरावणस्तं समासाद्य युद्धे ह्वयति दर्पितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000569002, "chapter_id": 9569, "verse_number": "७-३४-३", "content_sanskrit": "ततः कदाचित्किष्किन्धां नगरीं वालिपालिताम् ।\nगत्वा ह्वयति युद्धाय वालिनं हेममालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000569003, "chapter_id": 9569, "verse_number": "७-३४-४", "content_sanskrit": "ततस्तु वानरामात्यस्तारस्तारापिता प्रभुः ।\nउवाच वानरो वाक्यं युद्धप्रेप्सुमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000569004, "chapter_id": 9569, "verse_number": "७-३४-५", "content_sanskrit": "राक्षसेन्द गतो वाली यस्ते प्रतिबलो भवेत् ।\nको ऽन्यः प्रमुखतः स्थातुं तव शक्तः प्लवङ्गमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000569005, "chapter_id": 9569, "verse_number": "७-३४-६", "content_sanskrit": "चतुर्भ्यो ऽपि समुद्रेभ्यः सन्ध्यामन्वास्य रावण ।\nइमं मुहूर्तमायाति वाली तिष्ठ मुहूर्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000569006, "chapter_id": 9569, "verse_number": "७-३४-७", "content_sanskrit": "एतानस्थिचयान्पश्य य एते शङ्खपाण्डुराः ।\nयुद्धार्थिनामिमे राजन्वानराधिपतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000569007, "chapter_id": 9569, "verse_number": "७-३४-८", "content_sanskrit": "यद्वा ऽमृतरसः पीतस्त्वया रावण राक्षस ।\nतदा वालिनमासाद्य तदन्तं तव जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000569008, "chapter_id": 9569, "verse_number": "७-३४-९", "content_sanskrit": "पश्येदानीं जगच्चित्रमिमं विश्रवसः सुत ।\nइदं मुहूर्तं तिष्ठस्व दुर्लभं ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000569009, "chapter_id": 9569, "verse_number": "७-३४-१०", "content_sanskrit": "अथवा त्वरसे मर्तुं गच्छ दक्षिणसागरम् ।\nवालिनं द्रक्ष्यसे तत्र भूमिस्थमिव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000569010, "chapter_id": 9569, "verse_number": "७-३४-११", "content_sanskrit": "स तु तारं विनिर्भर्त्स्य रावणो लोकरावणः ।\nपुष्पकं तत्समारुह्य प्रययौ दक्षिणार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000569011, "chapter_id": 9569, "verse_number": "७-३४-१२", "content_sanskrit": "तत्र हेमगिरिप्रख्यं तरुणार्कनिभाननम् ।\nरावणो वालिनं दृष्ट्वा सन्ध्योपासनतत्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000569012, "chapter_id": 9569, "verse_number": "७-३४-१३", "content_sanskrit": "पुष्पकादवरुह्याथ रावणो ऽञ्जनसन्निभः ।\nग्रहीतुं वालिनं तूर्णं निःशब्दपदमाव्रजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000569013, "chapter_id": 9569, "verse_number": "७-३४-१४", "content_sanskrit": "यदृच्छया तदा दृष्टो वालिनापि स रावणः ।\nपापाभिप्रायवान् दृष्ट्वा चकार न तु सम्भ्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000569014, "chapter_id": 9569, "verse_number": "७-३४-१५", "content_sanskrit": "शशमालक्ष्य सिंहो वा पन्नगं गरुडो यथा ।\nन चिन्तयति तं वाली रावणं पापनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000569015, "chapter_id": 9569, "verse_number": "७-३४-१६", "content_sanskrit": "जिघृक्षमाणमायान्तं रावणं पापचेतसम् ।\nकक्षावलम्बिनं कृत्वा गमिष्ये त्रीन्महार्णवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000569016, "chapter_id": 9569, "verse_number": "७-३४-१७", "content_sanskrit": "द्रक्ष्यन्त्यरिं ममाङ्कस्थं स्रंसदूरुकराम्बरम् ।\nलम्बमानं दशग्रीवं गरुडस्येव पन्नगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000569017, "chapter_id": 9569, "verse_number": "७-३४-१८", "content_sanskrit": "इत्येवं मतिमास्थाय वाली कर्णमुपाश्रितः ।\nजपन्वै नैगमान्मन्त्रांस्तस्थौ पर्वतराडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000569018, "chapter_id": 9569, "verse_number": "७-३४-१९", "content_sanskrit": "तावन्योन्यं जिघृक्षन्तौ हरिराक्षसपार्थिवौ ।\nप्रयत्नवन्तौ तत्कर्म ईहतुर्बलदर्पितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000569019, "chapter_id": 9569, "verse_number": "७-३४-२०", "content_sanskrit": "हस्तग्राहं तु तं मत्वा पादशब्देन रावणम् ।\nपराङ्मुखो ऽपि जग्राह वाली सर्पमिवाण्डजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000569020, "chapter_id": 9569, "verse_number": "७-३४-२१", "content_sanskrit": "ग्रहीतुकामं तं गृह्य रक्षसामीश्वरं हरिः ।\nखमुत्पपात वेगेन कृत्वा कक्षावलम्बिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000569021, "chapter_id": 9569, "verse_number": "७-३४-२२", "content_sanskrit": "तं चापीडयमानं तु वितुदन्तं नखैर्मुहुः ।\nजहार रावणं वाली पवनस्तोयदं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000569022, "chapter_id": 9569, "verse_number": "७-३४-२३", "content_sanskrit": "अथ ते राक्षसामात्या ह्रियमाणं दशाननम् ।\nमुमोक्षयिषवो वालिं रवमाणा अभिद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000569023, "chapter_id": 9569, "verse_number": "७-३४-२४", "content_sanskrit": "अन्वीयमानस्तैर्वाली भ्राजते ऽम्बरमध्यगः ।\nअन्वीयमानो मेघौघैरम्बरस्थ इवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000569024, "chapter_id": 9569, "verse_number": "७-३४-२५", "content_sanskrit": "ते ऽशक्नुवन्तः सम्प्राप्तुं वालिनं राक्षसोत्तमाः ।\nतस्य बाहूरुवेगेन परिश्रान्ता व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000569025, "chapter_id": 9569, "verse_number": "७-३४-२६", "content_sanskrit": "वालिमार्गादपाक्रामन्पर्वतेन्द्रो हि गच्छतः ।\nकिं पुनर्जीवितप्रेप्सुर्बिभ्रद्वै मांसशोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000569026, "chapter_id": 9569, "verse_number": "७-३४-२७", "content_sanskrit": "अपक्षिगणसम्पातान्वानरेन्द्रो महाजवः ।\nक्रमशः सागरान्सर्वान्सन्ध्याकालमवन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000569027, "chapter_id": 9569, "verse_number": "७-३४-२८", "content_sanskrit": "सभाज्यमानो भूतैस्तु खैचरैः खैचरोत्तमः ।\nपश्चिमं सागरं वाली ह्याजगाम सरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000569028, "chapter_id": 9569, "verse_number": "७-३४-२९", "content_sanskrit": "तस्मिन्सन्ध्यामुपासित्वा स्नात्वा जप्त्वा च वानरः ।\nउत्तरं सागरं प्रायाद्वहमानो दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000569029, "chapter_id": 9569, "verse_number": "७-३४-३०", "content_sanskrit": "बहुयोजनसाहस्रं वहमानो महाहरिः ।\nवायुवच्च मनोवच्च जगाम सह शत्रुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000569030, "chapter_id": 9569, "verse_number": "७-३४-३१", "content_sanskrit": "उत्तरे सागरे सन्ध्यामुपासित्वा दशाननम् ।\nवहमानो ऽगमद्वाली पूर्वं वै स महोदधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000569031, "chapter_id": 9569, "verse_number": "७-३४-३२", "content_sanskrit": "तत्रापि सन्ध्यामन्वास्य वासविः सहरीश्वरः ।\nकिष्किन्धामभितो गृह्य रावणं पुनरागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000569032, "chapter_id": 9569, "verse_number": "७-३४-३३", "content_sanskrit": "चतुर्ष्वपि समुद्रेषु सन्ध्यामन्वास्य वानरः ।\nरावणोद्वहनश्रान्तः किष्किन्धोपवने ऽपतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000569033, "chapter_id": 9569, "verse_number": "७-३४-३४", "content_sanskrit": "रावणं तु मुमोचाथ स्वकक्षात्कपिसत्तमः ।\nकुतस्त्वमिति चोवाच प्रहसन्रावणं मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000569034, "chapter_id": 9569, "verse_number": "७-३४-३५", "content_sanskrit": "विस्मयं तु महद्गत्वा श्रमलोलनिरीक्षणः ।\nराक्षसेन्द्रो हरीन्द्रं तमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000569035, "chapter_id": 9569, "verse_number": "७-३४-३६", "content_sanskrit": "वानरेन्द्र महेन्द्राभ राक्षसेन्द्रो ऽस्मि रावणः ।\nयुद्धेप्सुरिह सम्प्राप्तः स चाद्यासादितस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000569036, "chapter_id": 9569, "verse_number": "७-३४-३७", "content_sanskrit": "अहो बलमहो वीर्यमहो गाम्भीर्यमेव च ।\nयेनाहं पशुवद्गृह्य भ्रामितश्चतुरो ऽर्णवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000569037, "chapter_id": 9569, "verse_number": "७-३४-३८", "content_sanskrit": "एवमश्रान्तवद्वीर शीघ्रमेव महार्णवान् ।\nमां चैवोद्वहमानस्तु को ऽन्यो वीरः क्रमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000569038, "chapter_id": 9569, "verse_number": "७-३४-३९", "content_sanskrit": "त्रयाणामेव भूतानां गतिरेषा प्लवङ्गम ।\nमनोनिलसुपर्णानां तव चात्र न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000569039, "chapter_id": 9569, "verse_number": "७-३४-४०", "content_sanskrit": "सो ऽहं दृष्टबलस्तुभ्यमिच्छामि हरिपुङ्गव ।\nत्वया सह चिरं सख्यं सुस्निग्धं पावकाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000569040, "chapter_id": 9569, "verse_number": "७-३४-४१", "content_sanskrit": "दाराः पुत्राः पुरं राष्ट्रं भोगाच्छादनभोजनम् ।\nसर्वमेवाविभक्तं नौ भविष्यति हरीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000569041, "chapter_id": 9569, "verse_number": "७-३४-४२", "content_sanskrit": "ततः प्रज्वालयित्वाग्निं तावुभौ हरीराक्षसौ ।\nभ्रातृत्वमुपसम्पन्नौ परिष्वज्य परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000569042, "chapter_id": 9569, "verse_number": "७-३४-४३", "content_sanskrit": "अन्योन्यं लम्बितकरौ ततस्तौ हरिराक्षसौ ।\nकिष्किन्धां विशतुर्हृष्टौ सिंहौ गिरिगुहामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000569043, "chapter_id": 9569, "verse_number": "७-३४-४४", "content_sanskrit": "स तत्र मासमुषितः सुग्रीव इव रावणः ।\nअमात्यैरागतैर्नीतस्त्रैलोक्योत्सादनार्थिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000569044, "chapter_id": 9569, "verse_number": "७-३४-४५", "content_sanskrit": "एवमेतत्पुरावृत्तं वालिना रावणः प्रभो ।\nधर्षितश्च कृतश्चापि भ्राता पावकसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000569045, "chapter_id": 9569, "verse_number": "७-३४-४६", "content_sanskrit": "बलमप्रतिमं राम वालिनो ऽभवदुत्तमम् ।\nसो ऽपि त्वया विनिर्दग्धः शलभो वह्निना यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000569046, "chapter_id": 9569, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]