[{"id": 2013767, "chapter_id": 1284, "verse_number": "२-२५-१", "content_sanskrit": "वैशम्पायन उवाच।\nभीमसेनस्ततः कृष्णमुवाच यदुनन्दनम्।\nबुद्धिमास्थाय विपुलां जरासन्धवधोप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013768, "chapter_id": 1284, "verse_number": "२-२५-२", "content_sanskrit": "नायं पापो मया कृष्ण युक्तः स्यादनुरोधितुम्।\nप्रायेण यदुशार्दूल बान्धवक्षयकृत्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013769, "chapter_id": 1284, "verse_number": "२-२५-३", "content_sanskrit": "एवमुक्तस्ततः कृष्णः प्रत्युवाच वृकोदरम्।\nत्वरयन्पुरुषव्याघ्रो जरासन्धवधेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013770, "chapter_id": 1284, "verse_number": "२-२५-४", "content_sanskrit": "यत्ते दैवं परं सत्वं यच्च ते मातरिश्वनः।\nबलं भीमं जरासन्धे दर्शयाशु तदद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013771, "chapter_id": 1284, "verse_number": "२-२५-५", "content_sanskrit": "तवैष वध्यो दुर्बुद्धिर्जरासन्धो महारथः।\nइत्यन्तरिक्षे त्वश्रौषं यदा वायुरवाप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013772, "chapter_id": 1284, "verse_number": "२-२५-६", "content_sanskrit": "गोमन्ते पर्वतश्रेष्ठे येनैष परिमोक्षितः।\nबलदेवबलं प्राप्य कोऽन्यो जीवेत्तु मागधात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013773, "chapter_id": 1284, "verse_number": "२-२५-७", "content_sanskrit": "तदस्य मृत्युर्विहितस्त्वदृते न महाबल।\nवायुं चिन्त्य महाबाहो जहीमं मगधाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013774, "chapter_id": 1284, "verse_number": "२-२५-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013775, "chapter_id": 1284, "verse_number": "२-२५-८", "content_sanskrit": "एवमुक्तस्ततो भीमो मनसाऽऽचिन्त्य मारुतम्।\nजनार्दनं नमस्कृत्य परिष्वज्य च फल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013776, "chapter_id": 1284, "verse_number": "२-२५-९", "content_sanskrit": "प्रभञ्जनबलाविष्टो जरासन्धमरिन्दमः।\nउत्क्षिप्य भ्रामयामास बलवन्तं महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013777, "chapter_id": 1284, "verse_number": "२-२५-१०", "content_sanskrit": "भ्रामयित्वा शतगुणं जानुभ्यां भरतर्षभ।\nबभञ्ज पृष्टं सङ्क्षिप्य निष्पिष्य विननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013778, "chapter_id": 1284, "verse_number": "२-२५-११", "content_sanskrit": "करे गृहीत्वा चरणं द्विधा चक्रे महाबलः।\nतस्य निष्पिष्यमाणस्य पाण्डवस्य च गर्जतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013779, "chapter_id": 1284, "verse_number": "२-२५-१२", "content_sanskrit": "अभवत्तुमुलो नादः सर्वप्राणिभयङ्करः।\nवित्रेसुर्मागधाः सर्वे स्त्रीणां गर्भाश्च सुस्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013780, "chapter_id": 1284, "verse_number": "२-२५-१३", "content_sanskrit": "भीमसेनस्य नादेन जरासन्धस्य चैव ह।\nकिं नु स्याद्धिमवान्भिन्नः किंनुस्विद्दीर्यते मही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013781, "chapter_id": 1284, "verse_number": "२-२५-१४", "content_sanskrit": "इति वै मागधा जज्ञुर्भीमसेनस्य निखनात्।\nततस्तु भगवान्कृष्णो जरासन्धजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013782, "chapter_id": 1284, "verse_number": "२-२५-१५", "content_sanskrit": "भीमसेनं समालोक्य नलं जग्राह पाणिना।\nद्विधा चिच्छेद वै तत्तु जरासन्धवधं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013783, "chapter_id": 1284, "verse_number": "२-२५-१६", "content_sanskrit": "ततस्त्वाज्ञाय तस्यैव पादमुत्क्षिप्य मारुतिः।\nद्विधा बभञ्ज तद्गात्रं प्राक्षिपद्विननाद च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013784, "chapter_id": 1284, "verse_number": "२-२५-१७", "content_sanskrit": "पुनः सन्धाय तु तदा जरान्धः प्रतापवान्।\nभीमेन च समागम्य बाहुयुद्धं चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013785, "chapter_id": 1284, "verse_number": "२-२५-१८", "content_sanskrit": "तयोः समभवद्युद्धं तुमुलं रोमहर्षणम्।\nसर्वलोकक्षयकरं सर्वभूतभयावहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013786, "chapter_id": 1284, "verse_number": "२-२५-१९", "content_sanskrit": "पुनः कृष्णस्तमिरिणं द्विधा विच्छिद्य माधवः।\nव्यत्यस्य प्राक्षिपत्तत्तु जरासन्धवधेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013787, "chapter_id": 1284, "verse_number": "२-२५-२०", "content_sanskrit": "भीमसेनस्तदा ज्ञात्वा निर्बिभेद च मागधम्।\nद्विधा व्यत्यस्य पादेन प्राक्षिपच्च ननाद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013788, "chapter_id": 1284, "verse_number": "२-२५-२१", "content_sanskrit": "शुष्कमांसास्थिमेदस्त्वग्भिन्नमस्तिष्कपिण्डकटः।\nशवभूतस्तदा राजन्पिण्डीकृत इवाबबौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013789, "chapter_id": 1284, "verse_number": "२-२५-२२", "content_sanskrit": "ततो राज्ञः कुलद्वारि प्रसुप्तमिव तं नृपम्।\nरात्रौ गतासुमुत्सृज्य निश्चक्रमुररिन्दमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013790, "chapter_id": 1284, "verse_number": "२-२५-२३", "content_sanskrit": "जरासन्धरथं कृष्णो योजयित्वा पताकिनम्।\nआरोप्य भ्रातरौ चैव मोक्षयामास बान्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013791, "chapter_id": 1284, "verse_number": "२-२५-२४", "content_sanskrit": "ते वै रत्नुभुजं कृष्णं रत्नार्हं पृथिवीश्वराः।\nराजानं चक्ररासाद्य मोक्षिता महतो भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013792, "chapter_id": 1284, "verse_number": "२-२५-२५", "content_sanskrit": "अक्षतः शस्त्रसम्पन्नो जितारिः सह राजभिः।\nरथमास्थाय तं दिव्यं निर्जगाम गिरिव्रजात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013793, "chapter_id": 1284, "verse_number": "२-२५-२६", "content_sanskrit": "यः स सोदर्यवान्नाम द्वियोधी कृष्णसारथिः।\nअभ्यासघाती सन्दृश्यो दुर्जयः सर्वराजभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013794, "chapter_id": 1284, "verse_number": "२-२५-२७", "content_sanskrit": "भीमार्जुनाभ्यां योधाभ्यामास्थितः कृष्णसारथिः।\nशुशुभे रथवर्योऽसौ दुर्जयः सर्वधन्विभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013795, "chapter_id": 1284, "verse_number": "२-२५-२८", "content_sanskrit": "शक्रविष्णू हि सङ्ग्रामे चेरतुस्तारकामये।\nरथेन तेन वै कृष्ण उपारुह्य ययौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013796, "chapter_id": 1284, "verse_number": "२-२५-२९", "content_sanskrit": "एवमेतौ महाबाहू तदा दुष्करकारिणौ।\nकृष्णप्रणीतौ लोकेऽस्मिन्नथे को द्रष्टुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013797, "chapter_id": 1284, "verse_number": "२-२५-३०", "content_sanskrit": "इत्यवोचन्व्रजन्तं तं जरासन्धपुरालयाः।\nवासुदेवं नरश्रेष्ठं युक्तं वातजवैर्हयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013798, "chapter_id": 1284, "verse_number": "२-२५-३१", "content_sanskrit": "तप्तचामीकराभेण किङ्किणीजालमालिना।\nमेघनिर्घोषनादेन जैत्रेणामित्रघातिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013799, "chapter_id": 1284, "verse_number": "२-२५-३२", "content_sanskrit": "येन शक्रो दानवानां जघान नवतीर्नव।\nतं प्राप्य समहृष्यन्त रथं ते पुरुषर्थभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013800, "chapter_id": 1284, "verse_number": "२-२५-३३", "content_sanskrit": "ततः कृष्णं महाबाहुं भ्रातृभ्यां सहितं तदा।\nरथस्थं मागधा दृष्ट्वा समपद्यन्त विस्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013801, "chapter_id": 1284, "verse_number": "२-२५-३४", "content_sanskrit": "हयैर्दिव्यैः समायुक्तो रथो वायुसमो जवे।\nअधिष्ठितः स शुशुभे कृष्णेनातीव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013802, "chapter_id": 1284, "verse_number": "२-२५-३५", "content_sanskrit": "असङ्गो देवविहितस्तस्मिन्रथवरे ध्वजः।\nयोजनाद्ददृशे श्रीमानिन्द्रायुधसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013803, "chapter_id": 1284, "verse_number": "२-२५-३६", "content_sanskrit": "चिन्तयामास कृष्णोऽथ गरुत्मन्तं स चाभ्ययात्।\nक्षणे तस्मिन्स तेनासीच्चैत्यवृक्ष इवोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013804, "chapter_id": 1284, "verse_number": "२-२५-३७", "content_sanskrit": "व्यादितास्यैर्महानादैः सह भूतैर्ध्वजालयैः।\nतस्मिन्रथवरे तस्थौ गुरुत्मान्पन्नगाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013805, "chapter_id": 1284, "verse_number": "२-२५-३८", "content_sanskrit": "दुर्निरीक्ष्यो हि भूतानां तेजसाऽऽभ्याधिकं बभौ।\nआदित्य इव मध्याह्ने सहस्रकिरणावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013806, "chapter_id": 1284, "verse_number": "२-२५-३९", "content_sanskrit": "न सज्जति वृक्षेषु शस्त्रैश्चापि न रिष्यते।\nदिव्यो ध्वजवरो राजन्दृश्यते चेह मानुषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013807, "chapter_id": 1284, "verse_number": "२-२५-४०", "content_sanskrit": "तमास्थाय रथं दिव्यं पर्जन्यसमनिः स्वनम्।\nनिर्ययौ पुरुषव्याघ्रः पाण्डवाभ्यां सहाच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013808, "chapter_id": 1284, "verse_number": "२-२५-४१", "content_sanskrit": "यं लेभे वासवाद्राजा वसुस्तस्माद्बृहद्रथः।\nबृहद्रथात्क्रमेणैव प्राप्तो बार्हद्रथो रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2013809, "chapter_id": 1284, "verse_number": "२-२५-४२", "content_sanskrit": "स निर्याय महाबाहुः पुण्डरीकेक्षणस्ततः।\nगिरिव्रजाद्बहिस्तस्थौ समदेशे महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2013810, "chapter_id": 1284, "verse_number": "२-२५-४३", "content_sanskrit": "तत्रैनं नागराः सर्वे सत्कारेणाभ्ययुस्तदा।\nब्राह्मणप्रमुखा राजन्विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2013811, "chapter_id": 1284, "verse_number": "२-२५-४४", "content_sanskrit": "बन्धनाद्विप्रमुक्ताश्च राजानो मधुसूदनम्।\nपूजयामासुरूचुश्च स्तुतिपूर्वमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2013812, "chapter_id": 1284, "verse_number": "२-२५-४५", "content_sanskrit": "नैतच्चित्रं महाबाहो त्वयि देवकिनन्दने।\nभीमार्जुनबलोपेते धर्मस्य प्रतिपालनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2013813, "chapter_id": 1284, "verse_number": "२-२५-४६", "content_sanskrit": "जरासन्धह्रदे घोरे दुःखपङ्के निमज्जताम्।\nराज्ञां समभ्युद्धरमं यदिदं कृतमद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2013814, "chapter_id": 1284, "verse_number": "२-२५-४७", "content_sanskrit": "विष्णो समवसन्नानां गिरिदुर्गे सुदारुणे।\nदिष्ट्या मोक्षाद्यशो दीप्तमाप्तं ते यदुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2013815, "chapter_id": 1284, "verse_number": "२-२५-४८", "content_sanskrit": "किं कर्मः पुरुषव्याघ्र शाधि नः प्रणतिस्थितान्।\nकृतमित्येव तद्विद्वि नृपैर्ययद्यपि दुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2013816, "chapter_id": 1284, "verse_number": "२-२५-४९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2013817, "chapter_id": 1284, "verse_number": "२-२५-४९", "content_sanskrit": "तानुवाच हृम्पीकेशः समाश्चास्य महामनाः।\nयिधिष्ठिरो राजसूयं क्रतुमार्हतुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2013818, "chapter_id": 1284, "verse_number": "२-२५-५०", "content_sanskrit": "तस्य धर्मप्रवृत्तस्य पार्थिवत्वं चिकीर्षतः।\nसर्वैर्भवद्भिर्विज्ञाय साहाय्यं क्रियतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2013819, "chapter_id": 1284, "verse_number": "२-२५-५१", "content_sanskrit": "ततः सुप्रीतमनसस्ते नृपा नृपसत्तम।\nतथेत्येवाब्रुवन्सर्वे प्रतिगृह्यास्य तां गिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2013820, "chapter_id": 1284, "verse_number": "२-२५-५२", "content_sanskrit": "रत्नभाजं च दाशार्हं चक्रुस्ते पृथिवीश्वराः।\nकृच्छ्राञ्जग्राह गोविन्दस्तेषां तदनुकम्पया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2013821, "chapter_id": 1284, "verse_number": "२-२५-५३", "content_sanskrit": "जरासन्धात्मजश्चैव सहदेवो महामनाः।\nनिर्ययौ सजनामात्यः पुरस्कृत्य पुरोहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2013822, "chapter_id": 1284, "verse_number": "२-२५-५४", "content_sanskrit": "स नीचैः प्रणतो भूत्वा बहुरत्नपुरोगमः।\nसहदेवो नृणां देवं वासुदेवमुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2013823, "chapter_id": 1284, "verse_number": "२-२५-५५", "content_sanskrit": "भयार्ताय ततस्तस्मै कृष्णो दत्त्वाऽभयं तदा।\nआददेऽस्य महार्हाणि रत्नानि पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2013824, "chapter_id": 1284, "verse_number": "२-२५-५६x", "content_sanskrit": "सददेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2013825, "chapter_id": 1284, "verse_number": "२-२५-५६", "content_sanskrit": "यत्कृतं पुरुषव्याघ्र मम पित्रा जनार्दन।\nतत्ते हृदि महाबाहो न कार्यं पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2013826, "chapter_id": 1284, "verse_number": "२-२५-५७", "content_sanskrit": "त्वां प्रपन्नोऽस्मि गोविन्द प्रासदं कुरु मे प्रभो।\nपितुरिच्छामि संस्कारं कर्तुं देवकिनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2013827, "chapter_id": 1284, "verse_number": "२-२५-५८", "content_sanskrit": "त्वत्तोऽभ्यनुज्ञां सम्प्राप्य भीमसेनात्तथार्जुनात्।\nनिर्भयो विचरिष्यामि यथाकामं यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2013828, "chapter_id": 1284, "verse_number": "२-२५-५९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2013829, "chapter_id": 1284, "verse_number": "२-२५-५९", "content_sanskrit": "एवं विज्ञाप्यमानस्य सहदेवस्य मारिष।\nप्रहृष्टो देवकीपुत्रः पाण्डवै च महारथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2013830, "chapter_id": 1284, "verse_number": "२-२५-६०", "content_sanskrit": "क्रियतां संस्क्रिया राजन्पितुस्त इति चाब्रुवन्।\nतच्छ्रुत्वा वासुदेवस्य पार्थयोश्च स मागधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2013831, "chapter_id": 1284, "verse_number": "२-२५-६१", "content_sanskrit": "प्रविश्य नगरं तूर्णं सह मन्त्रिभिरप्युत।\nचितां चन्दनकाष्ठैश्च कालेयसरलैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2013832, "chapter_id": 1284, "verse_number": "२-२५-६२", "content_sanskrit": "कालागरुसुनगन्धैश्च तैलैश्च विविधैरपि।\nघृतधाराशतैश्चैव सुमनोभिश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2013833, "chapter_id": 1284, "verse_number": "२-२५-६३", "content_sanskrit": "समन्तादेव कीर्यन्तोऽदहन्त मगधाधिपम्।\nउदकं तस्य चक्रेऽथ सहदेवः सहानुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2013834, "chapter_id": 1284, "verse_number": "२-२५-६४", "content_sanskrit": "कृत्वा पितुः स्वर्गगतिं निर्ययौ यत्र केशवः।\nपाण्डवौ च महाभागौ भीमसेनार्जुनावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2013835, "chapter_id": 1284, "verse_number": "२-२५-६५", "content_sanskrit": "स प्रह्वः प्राञ्जलिर्भूत्वा व्यज्ञापयत माधवम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2013836, "chapter_id": 1284, "verse_number": "२-२५-६५x", "content_sanskrit": "सहदेव उवाच।\nइमे रत्नानि भूरिणी गोजाविमहिषादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2013837, "chapter_id": 1284, "verse_number": "२-२५-६६", "content_sanskrit": "हस्तिनोऽश्वाश्च गोविन्द वासांसि विविधानि च।\nदीयतां धर्मराजाय यथा वा मन्यते भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2013838, "chapter_id": 1284, "verse_number": "२-२५-६७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2013839, "chapter_id": 1284, "verse_number": "२-२५-६७", "content_sanskrit": "भयार्ताय ततस्तस्मै कृत्वा कृष्णोऽभयं तदा।\nअभ्यषिञ्चत राजानं सहदेवं जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2013840, "chapter_id": 1284, "verse_number": "२-२५-६८", "content_sanskrit": "मागधानां महीपालं जरासन्धात्मजं तदा।\nआददे च महार्हाणि रत्नानि पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2013841, "chapter_id": 1284, "verse_number": "२-२५-६९", "content_sanskrit": "गत्वैकत्वं स कृष्णेन पार्थाभ्यां चापि सत्कृतः।\nविवेश मतिमान्त्राजा पुनर्बार्हद्रथं पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2013842, "chapter_id": 1284, "verse_number": "२-२५-७०", "content_sanskrit": "पार्थाभायं सहितः कृष्णः सर्वैश्च वसुधाधिपैः।\nयथावयः समागम्य विससर्ज नराधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2013843, "chapter_id": 1284, "verse_number": "२-२५-७१", "content_sanskrit": "विसृज्य सर्वान्नृपतीन्राजसूये महात्मभिः।\nआगन्तव्यं भवद्भिश्च धर्मराजप्रियेप्सुभिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2013844, "chapter_id": 1284, "verse_number": "२-२५-७२", "content_sanskrit": "एवमुक्ता माधवेन सर्वे ते वसुधाधिपाः।\nएवमस्त्विति चाप्युक्त्वा समेताः परया मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2013845, "chapter_id": 1284, "verse_number": "२-२५-७३", "content_sanskrit": "भीमार्जुनहृषीकेशैः प्रहृष्टाः प्रययुस्तदा।\nरत्नान्यादाय भूरीणी ज्वलन्तो रिपुसूदनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2013846, "chapter_id": 1284, "verse_number": "२-२५-७४", "content_sanskrit": "कृष्णस्तु सह पार्थाभ्यां श्रिया परमया युतः।\nरत्नान्यादाय भूरिणी प्रययौ पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2013847, "chapter_id": 1284, "verse_number": "२-२५-७५", "content_sanskrit": "इन्द्रप्रस्थमुपागम्य पाण्डवाभ्यां सहाच्युतः।\nसमेत्य धर्मराजानं प्रीयमाणोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2013848, "chapter_id": 1284, "verse_number": "२-२५-७६", "content_sanskrit": "दिष्ट्या भीमेन बलवाञ्जरासन्धो निपातितः।\nराजानो मोक्षिताश्चेमे बन्धनान्नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2013849, "chapter_id": 1284, "verse_number": "२-२५-७७", "content_sanskrit": "दिष्ट्या कुशलिनौ चेमौ भीमसेनधनञ्जयौ।\nपुनः स्वनगरं प्राप्तावक्षताविति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2013850, "chapter_id": 1284, "verse_number": "२-२५-७८", "content_sanskrit": "ततो युधिष्ठिरः कृष्णं पूजयित्वा यथार्हतः।\nभीमसेनार्जुनौ चैव प्रहृष्टः परिषस्वजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2013851, "chapter_id": 1284, "verse_number": "२-२५-७९", "content_sanskrit": "ततः क्षीणे जरासन्धे भ्रातृभ्यां विहितं जयम्।\nअजातशत्रुरासाद्य मुमुदे भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2013852, "chapter_id": 1284, "verse_number": "२-२५-८०", "content_sanskrit": "हृष्टश्च धर्मराड्वाक्यं जनार्दनमभाषत।\nत्वां प्राप्य पुरुषव्याघ्र भीमसेनेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2013853, "chapter_id": 1284, "verse_number": "२-२५-८१", "content_sanskrit": "मागधोऽसौ बलोन्मत्तो जरासन्धः प्रतापवान्।\nराजसूयं क्रतुश्रेष्ठं प्राप्स्यामि विगतज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2013854, "chapter_id": 1284, "verse_number": "२-२५-८२", "content_sanskrit": "त्वद्बुद्धिबलमाश्रित्य यागार्होऽस्मि जनार्दन।\nपीतं पृथिव्याः क्रुद्धेन यशस्ते पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2013855, "chapter_id": 1284, "verse_number": "२-२५-८३", "content_sanskrit": "जरासन्धवधेनैव प्राप्तास्ते विपुलाः श्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2013856, "chapter_id": 1284, "verse_number": "२-२५-८३x", "content_sanskrit": "वैशम्पायन उवाच।\nएवं सम्भाष्य कौन्तेयः प्रादाद्रथवरं प्रभोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2013857, "chapter_id": 1284, "verse_number": "२-२५-८४", "content_sanskrit": "प्रतिगृह्य तु गोविन्दो जरासन्धस्य तं रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2013858, "chapter_id": 1284, "verse_number": "२-२५-८५", "content_sanskrit": "प्रहृष्टस्तस्य मुमुदे फल्गुनेन जनार्दनः।\nप्रीतिमानभवद्राजन्धर्मराजपुरस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2013859, "chapter_id": 1284, "verse_number": "२-२५-८६", "content_sanskrit": "यथावयः समागम्य भ्रातृभिः सह पाण्डवः।\nसत्कृत्य पूजयित्वा च विससर्ज नराधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2013860, "chapter_id": 1284, "verse_number": "२-२५-८७", "content_sanskrit": "युधिष्ठिराभ्यनुज्ञातास्ते नृपा हृष्टमानसाः।\nजग्मुः स्वदेशांस्त्वरिता यानैरुच्चावचैस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2013861, "chapter_id": 1284, "verse_number": "२-२५-८८", "content_sanskrit": "एवं पुरुषशार्दूलो महाबुद्धिर्जनार्दनः।\nपाण्डवैर्घातयामास जरासन्धमरिं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2013862, "chapter_id": 1284, "verse_number": "२-२५-८९", "content_sanskrit": "घातयित्वा जरासन्धं बुद्धिपूर्वमरिन्दमः।\nधर्मराजमनुज्ञाप्य पृथां कृष्णां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2013863, "chapter_id": 1284, "verse_number": "२-२५-९०", "content_sanskrit": "सुभद्रां भीमसेनं च फाल्गुनं यमजौ तथा।\nधौम्यमामन्त्रयित्वा च प्रययौ स्वां पुरीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2013864, "chapter_id": 1284, "verse_number": "२-२५-९१", "content_sanskrit": "पाण्डवैरनुधावद्भिर्युधिष्ठिरपुरोगमैः।\nहर्षेण महता युक्तः प्राप्य चानुत्तमं यशः।\nजगाम हृष्टः कृष्णस्तु पुनर्द्वारवतीं पुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2013865, "chapter_id": 1284, "verse_number": "२-२५-९२", "content_sanskrit": "तेनैव रथमुख्येन मनसस्तुल्यगामिना।\nधर्मराजविसृष्टेन दिव्येनानादयन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2013866, "chapter_id": 1284, "verse_number": "२-२५-९३", "content_sanskrit": "ततो युधिष्ठिरमुखाः पाण्डवा भरतर्षभ।\nप्रदक्षिणमकुर्वन्त कृष्णमक्लिष्टकारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2013867, "chapter_id": 1284, "verse_number": "२-२५-९४", "content_sanskrit": "ततो गते भगवति कृष्णे देवकिनन्दने।\nजयं लब्ध्वा सुविपुलं राज्ञां दत्त्वाऽभयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2013868, "chapter_id": 1284, "verse_number": "२-२५-९५", "content_sanskrit": "संवर्धितं यशो भूयः कर्मणा तेन भारत।\nद्रौपद्याः पाण्डवा राजन्परां प्रीतिमवर्धयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2013869, "chapter_id": 1284, "verse_number": "२-२५-९६", "content_sanskrit": "तस्मिन्काले तु यद्युक्तं धर्मकामार्थसंहितम्।\nतद्राजा धर्मतश्चक्रे प्रजापालनकीर्तनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2013870, "chapter_id": 1284, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि जरासन्धवधपर्वणि पञ्चविंशोऽध्यायः॥ २५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]