[{"id": 7002055000, "chapter_id": 22055, "verse_number": "१००-१", "content_sanskrit": "ईश्वर उवाच ।\nद्वाराश्रितप्रतिष्ठाया वक्ष्यामि विधिमप्यथ ।\nद्वाराङ्गानि कषायाद्यैः संस्कृत्य शयने न्यसेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002055001, "chapter_id": 22055, "verse_number": "१००-२", "content_sanskrit": "मूलमध्याग्रभागेषु त्रयमात्मादिसेश्वरं ।\nविन्यस्य सन्निवेश्याथ हुत्वा जप्त्वात्र रूपतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002055002, "chapter_id": 22055, "verse_number": "१००-३", "content_sanskrit": "द्वारादथो यजेद्वास्तुन्तत्रैवानन्तमन्त्रितः ।\nरत्नादिपञ्चकं न्यस्य शान्तिहोमं विधाय च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002055003, "chapter_id": 22055, "verse_number": "१००-४", "content_sanskrit": "यवसिद्धार्थकाक्रान्ता ऋद्धिवृद्धिमहातिलाः ।\nगोमृत्सर्षपरागेन्द्रमोहनीलक्षणामृताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002055004, "chapter_id": 22055, "verse_number": "१००-५", "content_sanskrit": "रोचना रुग्वचो दूर्वा प्रासादधश्च पोटलीं ।\nप्रकृत्योदुम्बरे बद्ध्वा रक्षार्थं प्रणवेन तु ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002055005, "chapter_id": 22055, "verse_number": "१००-६", "content_sanskrit": "द्वारमुत्तरतः किञ्चिदाश्रितं सन्निवेशयेत् ।\nआत्मतत्त्वमधो न्यस्य विद्यातत्त्वञ्च शाखयोः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002055006, "chapter_id": 22055, "verse_number": "१००-७", "content_sanskrit": "शिवमकाशदेशे च व्यापकं सर्वमङ्गले ।\nततो महेशनाथं च विन्यसेन्मूलमन्त्रतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]