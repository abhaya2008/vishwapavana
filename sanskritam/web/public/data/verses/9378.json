[{"id": 5000378000, "chapter_id": 9378, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000378001, "chapter_id": 9378, "verse_number": "५-३९-१", "content_sanskrit": "मणिं दत्त्वा ततः सीता हनूमन्तमथाब्रवीत्।\nअभिज्ञानमभिज्ञातमेतद् रामस्य तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000378002, "chapter_id": 9378, "verse_number": "५-३९-२", "content_sanskrit": "मणिं दृष्ट्वा तु रामो वै त्रयाणां संस्मरिष्यति।\nवीरो जनन्या मम च राज्ञो दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000378003, "chapter_id": 9378, "verse_number": "५-३९-३", "content_sanskrit": "स भूयस्त्वं समुत्साहचोदितो हरिसत्तम।\nअस्मिन् कार्यसमुत्साहे प्रचिन्तय यदुत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000378004, "chapter_id": 9378, "verse_number": "५-३९-४", "content_sanskrit": "त्वमस्मिन् कार्यनिर्योगे प्रमाणं हरिसत्तम।\nतस्य चिन्तय यो यत्नो दुःखक्षयकरो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000378005, "chapter_id": 9378, "verse_number": "५-३९-५", "content_sanskrit": "हनूमन् यत्नमास्थाय दुःखक्षयकरो भव।\nस तथेति प्रतिज्ञाय मारुतिर्भीमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000378006, "chapter_id": 9378, "verse_number": "५-३९-६", "content_sanskrit": "शिरसाऽऽवन्द्य वैदेहीं गमनायोपचक्रमे।\nज्ञात्वा सम्प्रस्थितं देवी वानरं पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000378007, "chapter_id": 9378, "verse_number": "५-३९-७", "content_sanskrit": "बाष्पगद‍्गदया वाचा मैथिली वाक्यमब्रवीत्।\nहनूमन् कुशलं ब्रूयाः सहितौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000378008, "chapter_id": 9378, "verse_number": "५-३९-८", "content_sanskrit": "सुग्रीवं च सहामात्यं सर्वान् वृद्धांश्च वानरान्।\nब्रूयास्त्वं वानरश्रेष्ठ कुशलं धर्मसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000378009, "chapter_id": 9378, "verse_number": "५-३९-९", "content_sanskrit": "यथा च स महाबाहुर्मां तारयति राघवः।\nअस्माद् दुःखाम्बुसंरोधात् त्वं समाधातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000378010, "chapter_id": 9378, "verse_number": "५-३९-१०", "content_sanskrit": "जीवन्तीं मां यथा रामः सम्भावयति कीर्तिमान्।\nतत् त्वया हनुमन् वाच्यं वाचा धर्ममवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000378011, "chapter_id": 9378, "verse_number": "५-३९-११", "content_sanskrit": "नित्यमुत्साहयुक्तस्य वाचः श्रुत्वा मयेरिताः।\nवर्धिष्यते दाशरथेः पौरुषं मदवाप्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000378012, "chapter_id": 9378, "verse_number": "५-३९-१२", "content_sanskrit": "मत्संदेशयुता वाचस्त्वत्तः श्रुत्वैव राघवः।\nपराक्रमे मतिं वीरो विधिवत् संविधास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000378013, "chapter_id": 9378, "verse_number": "५-३९-१३", "content_sanskrit": "सीतायास्तद् वचः श्रुत्वा हनूमान् मारुतात्मजः।\nशिरस्यञ्जलिमाधाय वाक्यमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000378014, "chapter_id": 9378, "verse_number": "५-३९-१४", "content_sanskrit": "क्षिप्रमेष्यति काकुत्स्थो हर्यृक्षप्रवरैर्वृतः।\nयस्ते युधि विजित्यारीन् शोकं व्यपनयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000378015, "chapter_id": 9378, "verse_number": "५-३९-१५", "content_sanskrit": "नहि पश्यामि मर्त्येषु नासुरेषु सुरेषु वा।\nयस्तस्य वमतो बाणान् स्थातुमुत्सहतेऽग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000378016, "chapter_id": 9378, "verse_number": "५-३९-१६", "content_sanskrit": "अप्यर्कमपि पर्जन्यमपि वैवस्वतं यमम्।\nस हि सोढुं रणे शक्तस्तव हेतोर्विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000378017, "chapter_id": 9378, "verse_number": "५-३९-१७", "content_sanskrit": "स हि सागरपर्यन्तां महीं साधितुमर्हति।\nत्वन्निमित्तो हि रामस्य जयो जनकनन्दिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000378018, "chapter_id": 9378, "verse_number": "५-३९-१८", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा सम्यक् सत्यं सुभाषितम्।\nजानकी बहु मेने तं वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000378019, "chapter_id": 9378, "verse_number": "५-३९-१९", "content_sanskrit": "ततस्तं प्रस्थितं सीता वीक्षमाणा पुनः पुनः।\nभर्तृस्नेहान्वितं वाक्यं सौहार्दादनुमानयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000378020, "chapter_id": 9378, "verse_number": "५-३९-२०", "content_sanskrit": "यदि वा मन्यसे वीर वसैकाहमरिंदम।\nकस्मिंश्चित् संवृते देशे विश्रान्तः श्वो गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000378021, "chapter_id": 9378, "verse_number": "५-३९-२१", "content_sanskrit": "मम चैवाल्पभाग्यायाः सांनिध्यात् तव वानर।\nअस्य शोकस्य महतो मुहूर्तं मोक्षणं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000378022, "chapter_id": 9378, "verse_number": "५-३९-२२", "content_sanskrit": "ततो हि हरिशार्दूल पुनरागमनाय तु।\nप्राणानामपि संदेहो मम स्यान्नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000378023, "chapter_id": 9378, "verse_number": "५-३९-२३", "content_sanskrit": "तवादर्शनजः शोको भूयो मां परितापयेत्।\nदुःखादुःखपरामृष्टां दीपयन्निव वानर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000378024, "chapter_id": 9378, "verse_number": "५-३९-२४", "content_sanskrit": "अयं च वीर संदेहस्तिष्ठतीव ममाग्रतः।\nसुमहांस्त्वत्सहायेषु हर्यृक्षेषु हरीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000378025, "chapter_id": 9378, "verse_number": "५-३९-२५", "content_sanskrit": "कथं नु खलु दुष्पारं तरिष्यन्ति महोदधिम्।\nतानि हर्यृक्षसैन्यानि तौ वा नरवरात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000378026, "chapter_id": 9378, "verse_number": "५-३९-२६", "content_sanskrit": "त्रयाणामेव भूतानां सागरस्येह लङ्घने।\nशक्तिः स्याद् वैनतेयस्य तव वा मारुतस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000378027, "chapter_id": 9378, "verse_number": "५-३९-२७", "content_sanskrit": "तदस्मिन् कार्यनिर्योगे वीरैवं दुरतिक्रमे।\nकिं पश्यसे समाधानं त्वं हि कार्यविदां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000378028, "chapter_id": 9378, "verse_number": "५-३९-२८", "content_sanskrit": "काममस्य त्वमेवैकः कार्यस्य परिसाधने।\nपर्याप्तः परवीरघ्न यशस्यस्ते फलोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000378029, "chapter_id": 9378, "verse_number": "५-३९-२९", "content_sanskrit": "बलैः समग्रैर्युधि मां रावणं जित्य संयुगे।\nविजयी स्वपुरं यायात् तत्तस्य सदृशं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000378030, "chapter_id": 9378, "verse_number": "५-३९-३०", "content_sanskrit": "बलैस्तु संकुलां कृत्वा लङ्कां परबलार्दनः।\nमां नयेद् यदि काकुत्स्थस्तत् तस्य सदृशं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000378031, "chapter_id": 9378, "verse_number": "५-३९-३१", "content_sanskrit": "तद्यथा तस्य विक्रान्तमनुरूपं महात्मनः।\nभवेदाहवशूरस्य तथा त्वमुपपादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000378032, "chapter_id": 9378, "verse_number": "५-३९-३२", "content_sanskrit": "तदर्थोपहितं वाक्यं प्रश्रितं हेतुसंहितम्।\nनिशम्य हनुमान् शेषं वाक्यमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000378033, "chapter_id": 9378, "verse_number": "५-३९-३३", "content_sanskrit": "देवि हर्यृक्षसैन्यानामीश्वरः प्लवतां वरः।\nसुग्रीवः सत्यसम्पन्नस्तवार्थे कृतनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000378034, "chapter_id": 9378, "verse_number": "५-३९-३४", "content_sanskrit": "स वानरसहस्राणां कोटीभिरभिसंवृतः।\nक्षिप्रमेष्यति वैदेहि राक्षसानां निबर्हणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000378035, "chapter_id": 9378, "verse_number": "५-३९-३५", "content_sanskrit": "तस्य विक्रमसम्पन्नाः सत्त्ववन्तो महाबलाः।\nमनःसंकल्पसम्पाता निदेशे हरयः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000378036, "chapter_id": 9378, "verse_number": "५-३९-३६", "content_sanskrit": "येषां नोपरि नाधस्तान्न तिर्यक् सज्जते गतिः।\nन च कर्मसु सीदन्ति महत्स्वमिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000378037, "chapter_id": 9378, "verse_number": "५-३९-३७", "content_sanskrit": "असकृत् तैर्महोत्साहैः ससागरधराधरा।\nप्रदक्षिणीकृता भूमिर्वायुमार्गानुसारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000378038, "chapter_id": 9378, "verse_number": "५-३९-३८", "content_sanskrit": "मद्विशिष्टाश्च तुल्याश्च सन्ति तत्र वनौकसः।\nमत्तः प्रत्यवरः कश्चिन्नास्ति सुग्रीवसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000378039, "chapter_id": 9378, "verse_number": "५-३९-३९", "content_sanskrit": "अहं तावदिह प्राप्तः किं पुनस्ते महाबलाः।\nनहि प्रकृष्टाः प्रेष्यन्ते प्रेष्यन्ते हीतरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000378040, "chapter_id": 9378, "verse_number": "५-३९-४०", "content_sanskrit": "तदलं परितापेन देवि शोको व्यपैतु ते।\nएकोत्पातेन ते लङ्कामेष्यन्ति हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000378041, "chapter_id": 9378, "verse_number": "५-३९-४१", "content_sanskrit": "मम पृष्ठगतौ तौ च चन्द्रसूर्याविवोदितौ।\nत्वत्सकाशं महासङ्घौ नृसिंहावागमिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000378042, "chapter_id": 9378, "verse_number": "५-३९-४२", "content_sanskrit": "तौ हि वीरौ नरवरौ सहितौ रामलक्ष्मणौ।\nआगम्य नगरीं लङ्कां सायकैर्विधमिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000378043, "chapter_id": 9378, "verse_number": "५-३९-४३", "content_sanskrit": "सगणं रावणं हत्वा राघवो रघुनन्दनः।\nत्वामादाय वरारोहे स्वपुरीं प्रति यास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000378044, "chapter_id": 9378, "verse_number": "५-३९-४४", "content_sanskrit": "तदाश्वसिहि भद्रं ते भव त्वं कालकाङ्क्षिणी।\nनचिराद् द्रक्ष्यसे रामं प्रज्वलन्तमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000378045, "chapter_id": 9378, "verse_number": "५-३९-४५", "content_sanskrit": "निहते राक्षसेन्द्रे च सपुत्रामात्यबान्धवे।\nत्वं समेष्यसि रामेण शशाङ्केनेव रोहिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000378046, "chapter_id": 9378, "verse_number": "५-३९-४६", "content_sanskrit": "क्षिप्रं त्वं देवि शोकस्य पारं द्रक्ष्यसि मैथिलि।\nरावणं चैव रामेण द्रक्ष्यसे निहतं बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000378047, "chapter_id": 9378, "verse_number": "५-३९-४७", "content_sanskrit": "एवमाश्वास्य वैदेहीं हनूमान् मारुतात्मजः।\nगमनाय मतिं कृत्वा वैदेहीं पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000378048, "chapter_id": 9378, "verse_number": "५-३९-४८", "content_sanskrit": "तमरिघ्नं कृतात्मानं क्षिप्रं द्रक्ष्यसि राघवम्।\nलक्ष्मणं च धनुष्पाणिं लङ्काद्वारमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000378049, "chapter_id": 9378, "verse_number": "५-३९-४९", "content_sanskrit": "नखदंष्ट्रायुधान् वीरान् सिंहशार्दूलविक्रमान्।\nवानरान् वारणेन्द्राभान् क्षिप्रं द्रक्ष्यसि संगतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000378050, "chapter_id": 9378, "verse_number": "५-३९-५०", "content_sanskrit": "शैलाम्बुदनिकाशानां लङ्कामलयसानुषु।\nनर्दतां कपिमुख्यानामार्ये यूथान्यनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000378051, "chapter_id": 9378, "verse_number": "५-३९-५१", "content_sanskrit": "स तु मर्मणि घोरेण ताडितो मन्मथेषुणा।\nन शर्म लभते रामः सिंहार्दित इव द्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000378052, "chapter_id": 9378, "verse_number": "५-३९-५२", "content_sanskrit": "रुद मा देवि शोकेन मा भूत् ते मनसो भयम्।\nशचीव भर्त्रा शक्रेण सङ्गमेष्यसि शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000378053, "chapter_id": 9378, "verse_number": "५-३९-५३", "content_sanskrit": "रामाद् विशिष्टः कोऽन्योऽस्ति कश्चित् सौमित्रिणा समः।\nअग्निमारुतकल्पौ तौ भ्रातरौ तव संश्रयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000378054, "chapter_id": 9378, "verse_number": "५-३९-५४", "content_sanskrit": "नास्मिंश्चिरं वत्स्यसि देवि देशे\nरक्षोगणैरध्युषितेऽतिरौद्रे।\nन ते चिरादागमनं प्रियस्य\nक्षमस्व मत्संगमकालमात्रम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000378055, "chapter_id": 9378, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे एकोनचत्वारिंश सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]