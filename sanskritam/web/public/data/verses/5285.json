[{"id": 2201032, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201033, "chapter_id": 5285, "verse_number": "१", "content_sanskrit": "ब्राह्मणेभ्यः प्रयच्छन्ति दानानि विविधानि च ।\nदातृप्रतिग्रहीत्रोर्वा को विशेषः पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201034, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201035, "chapter_id": 5285, "verse_number": "२", "content_sanskrit": "साधोर्यः प्रतिगृह्णीयात् तथैवासाधुतो द्विजः ।\nगुणवत्यल्पदोषः स्यान्निर्गुणे तु निमज्जति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201036, "chapter_id": 5285, "verse_number": "३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nवृषादर्भेश्च संवादं सप्तर्षीणां च भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201037, "chapter_id": 5285, "verse_number": "४", "content_sanskrit": "कश्यपोऽत्रिर्वसिष्ठश्च भरद्वाजोऽथ गौतमः ।\nविश्वामित्रो जमदग्निः साध्वी चैवाप्यरुन्धती\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201038, "chapter_id": 5285, "verse_number": "५", "content_sanskrit": "सर्वेषामथ तेषां तु गण्डाऽभूत्कर्मकारिका ।\nशूद्रः पशुसखश्चैव भर्ता चास्या बभूव ह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201039, "chapter_id": 5285, "verse_number": "६", "content_sanskrit": "ते वै सर्वे तपस्यन्तः पुरा चेरुर्महीमिमाम् ।\nसमाधिनोपशिक्षन्तो ब्रह्मलोकं सनातनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201040, "chapter_id": 5285, "verse_number": "७", "content_sanskrit": "अथाभवदनावृष्टिर्महती कुरुनन्दन ।\nकृच्छ्रप्राणोऽभवद् यत्र लोकोऽयं वै क्षुधान्वितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201041, "chapter_id": 5285, "verse_number": "८", "content_sanskrit": "कस्मिंश्चिच्च पुरा यज्ञे याज्येन शिबिसूनुना ।\nदक्षिणार्थेऽथ ऋत्विग्भ्यो दत्तः पुत्रो निजः किल\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201042, "chapter_id": 5285, "verse_number": "९", "content_sanskrit": "तस्मिन् कालेऽथ सोऽल्पायुर्दिष्टान्तमगमत् प्रभो ।\nते तं क्षुधाभिसन्तप्ताः परिवार्योपतस्थिरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201043, "chapter_id": 5285, "verse_number": "१०", "content_sanskrit": "याज्यात्मजमथो दृष्ट्वा गतासुमृषिसत्तमाः ।\nअपचन्त तदा स्थाल्यां क्षुधार्ताः किल भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201044, "chapter_id": 5285, "verse_number": "११", "content_sanskrit": "निराद्ये मर्त्यलोकेऽस्मिन्नात्मानं ते परीप्सवः ।\nकृच्छ्रामापेदिरे वृत्तिमन्नहेतोस्तपस्विनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201045, "chapter_id": 5285, "verse_number": "१२", "content_sanskrit": "अटमानोऽथ तान् मार्गे पचमानान् महीपतिः ।\nराजा शैब्यो वृषादर्भिः क्लिश्यमानान् ददर्श ह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201046, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "वृषादर्भिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201047, "chapter_id": 5285, "verse_number": "१३", "content_sanskrit": "प्रतिग्रहस्तारयति पुष्टिर्वै प्रतिगृह्णताम् ।\nमयि यद् विद्यते वित्तं तच्छृणुध्वं तपोधनाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201048, "chapter_id": 5285, "verse_number": "१४", "content_sanskrit": "प्रियो हि मे ब्राह्मणो याचमानो\nदद्यामहं वोऽश्वतरीसहस्रम् ।\nएकैकशः सवृषाः सम्प्रसूताः\nसर्वेषां वै शीघ्रगाः श्वेतलोमाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201049, "chapter_id": 5285, "verse_number": "१५", "content_sanskrit": "कुलम्भराननडुहः शतंशतान्\nधुर्यान् शुभान् सर्वशोऽहं ददानि ।\nप्रष्ठौहीनां पीवराणां च तावत्\nअग्र्या गृष्ट्यो धेनवः सुव्रताश्च \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201050, "chapter_id": 5285, "verse_number": "१६", "content_sanskrit": "वरान् ग्रामान् व्रीहियवं रसांश्च\nरत्नं चान्यद् दुर्लभं किं ददानि ।\nमा स्माभक्ष्ये भावमेवं कुरुध्वं\nपुष्ट्यर्थं वै किं प्रयच्छाम्यहं वः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201051, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201052, "chapter_id": 5285, "verse_number": "१७", "content_sanskrit": "राजन् प्रतिग्रहो राज्ञो मध्वास्वादो विषोपमः ।\nतज्जानमानः कस्मात् त्वं कुरुषे नः प्रलोभनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201053, "chapter_id": 5285, "verse_number": "१८", "content_sanskrit": "क्षत्रं हि दैवतमिव ब्राह्मणं समुपाश्रितम् ।\nअमलो ह्येष तपसा प्रीतः प्रीणाति देवताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201054, "chapter_id": 5285, "verse_number": "१९", "content_sanskrit": "अह्नायेह तपो जातु ब्राह्मणस्योपजायते ।\nतद् दाव इव निर्दह्यात् प्राप्तो राजप्रतिग्रहः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201055, "chapter_id": 5285, "verse_number": "२०", "content_sanskrit": "कुशलं सह दानेन राजन्नस्तु सदा तव ।\nअर्थिभ्यो दीयतां सर्वमित्युक्त्वा ते ततो ययुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201056, "chapter_id": 5285, "verse_number": "२१", "content_sanskrit": "अपक्वमेव तन्मांसमभूत् तेषां च धीमताम् ।\nअथ हित्वा ययुः सर्वे वनमाहारकाङ्क्षिणः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201057, "chapter_id": 5285, "verse_number": "२२", "content_sanskrit": "ततः प्रचोदिता राज्ञा वनं गत्वाऽस्य मन्त्रिणः ।\nप्रचीयोदुम्बराणि स्म दानं दातुं प्रचक्रमुः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201058, "chapter_id": 5285, "verse_number": "२३", "content_sanskrit": "उदुम्बराण्यथान्यानि हेमगर्भाण्युपाहरन् ।\nभृत्यास्तेषां ततस्तानि प्रग्राहितुमुपाद्रवन्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201059, "chapter_id": 5285, "verse_number": "२४", "content_sanskrit": "गुरूणीति विदित्वाथ न ग्राह्याण्यत्रिरब्रवीत् ।\nन स्महे मूढविज्ञाना न स्महे मन्दबुद्धयः ।\nहैमानीमानि जानीमः प्रतिबुद्धाः स्म जागृमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201060, "chapter_id": 5285, "verse_number": "२५", "content_sanskrit": "इह ह्येतदुपादत्तं प्रेत्य स्यात् कटुकोदयम् ।\nअप्रतिग्राह्यमेवैतत् प्रेत्य चेह सुखेप्सुना\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201061, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201062, "chapter_id": 5285, "verse_number": "२६", "content_sanskrit": "शतेन निष्कं गणितं सहस्रेण च सम्मितम् ।\nयथा बहु प्रतीच्छन् हि पापिष्ठां लभते गतिम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2201063, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "कश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2201064, "chapter_id": 5285, "verse_number": "२७", "content_sanskrit": "यत् पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः ।\nसर्वं तन्नालमेकस्य तस्माद् विद्वान् शमं व्रजेत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2201065, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2201066, "chapter_id": 5285, "verse_number": "२८", "content_sanskrit": "उत्पन्नस्य रुरोः शृङ्गं वर्धमानस्य वर्धते ।\nप्रार्थना पुरुषस्येव तस्य मात्रा न विद्यते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2201067, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2201068, "chapter_id": 5285, "verse_number": "२९", "content_sanskrit": "न तल्लोके द्रव्यमस्ति यल्लोकं प्रतिपूरयेत् ।\nसमुद्रकल्पः पुरुषो न कदाचन पूर्यते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2201069, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2201070, "chapter_id": 5285, "verse_number": "३०", "content_sanskrit": "कामं कामयमानस्य यदा कामः समृध्यते ।\nअथैनमपरः कामस्तृष्णा विध्यति बाणवत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2201071, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "जमदग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2201072, "chapter_id": 5285, "verse_number": "३१", "content_sanskrit": "प्रतिग्रहे संयमो वै तपो धारयते ध्रुवम् ।\nतद् धनं ब्राह्मणस्येह लुभ्यमानस्य विस्रवेत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2201073, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "अत्रिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2201074, "chapter_id": 5285, "verse_number": "३२", "content_sanskrit": "न जातु कामः कामानामुपभोगेन शाम्यति ।\nहविषा कृष्णवर्त्मेव भूयसेवाभिवर्धते \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2201075, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "अरुन्धती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2201076, "chapter_id": 5285, "verse_number": "३३", "content_sanskrit": "धर्मार्थं सञ्चयो यो वै द्रव्याणां पक्षसम्मतः ।\nतपःसञ्चय एवेह विशिष्टो द्रव्यसञ्चयात्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2201077, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "गण्डा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2201078, "chapter_id": 5285, "verse_number": "३४", "content_sanskrit": "उग्रादितो भयाद् यस्माद् बिभ्यतीमे ममेश्वराः ।\nबलीयांसो दुर्बलवद् बिभेम्यहमतः परम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2201079, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "पशुसखः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2201080, "chapter_id": 5285, "verse_number": "३५", "content_sanskrit": "यद्वै धर्मे परं नास्ति ब्राह्मणास्तद् धनं विदुः ।\nविनयार्थं सुविद्वांसमुपासेयं यथातथम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2201081, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "ऋषयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2201082, "chapter_id": 5285, "verse_number": "३६", "content_sanskrit": "कुशलं सह दानाय तस्मै यस्य प्रजा इमाः ।\nफलान्युपधियुक्तानि य एवं नः प्रयच्छसि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2201083, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2201084, "chapter_id": 5285, "verse_number": "३७", "content_sanskrit": "इत्युक्त्वा हेमगर्भाणि हित्वा तानि फलानि ते ।\nऋषयो जग्मुरन्यत्र सर्व एव धृतव्रताः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2201085, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "मन्त्रिणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2201086, "chapter_id": 5285, "verse_number": "३८", "content_sanskrit": "उपधिं शङ्कमानास्ते हित्वेमानि फलानि वै ।\nततोऽन्येनैव गच्छन्ति विदितं तेऽस्तु पार्थिव\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2201087, "chapter_id": 5285, "verse_number": "३९", "content_sanskrit": "इत्युक्तः स तु भृत्यैस्तैर्वृषादर्भिश्चुकोप ह ।\nतेषां सम्प्रतिकर्तुं च सर्वेषामगमद् गृहम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2201088, "chapter_id": 5285, "verse_number": "४०", "content_sanskrit": "स गत्वाऽहवनीयेऽग्नौ तीव्रं नियममास्थितः ।\nजुहाव संस्कृतां मन्त्रैरेकैकामाहुतिं नृपः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2201089, "chapter_id": 5285, "verse_number": "४१", "content_sanskrit": "तस्मादग्नेः समुत्तस्थौ कृत्या लोकभयङ्करी ।\nतस्या नाम वृषादर्भिर्यातुधानीत्यथाकरोत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2201090, "chapter_id": 5285, "verse_number": "४२", "content_sanskrit": "सा कृत्या काळरात्रीव कृताञ्जलिरुपस्थिता ।\nवृषादर्भिं नरपतिं किं करोमीति चाब्रवीत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2201091, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "वृषादर्भिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2201092, "chapter_id": 5285, "verse_number": "४३", "content_sanskrit": "ऋषीणां गच्छ सप्तानामरुन्धत्यास्तथैव च ।\nदासीभर्तुश्च दास्याश्च मनसा नाम धारय\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2201093, "chapter_id": 5285, "verse_number": "४४", "content_sanskrit": "ज्ञात्वा नामानि चैतेषां सर्वानेतान् विनाशय ।\nविनष्टेषु यथा स्वैरं गच्छ यत्रेप्सितं तव\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2201094, "chapter_id": 5285, "verse_number": "४५", "content_sanskrit": "सा तथेति प्रतिश्रुत्य यातुधानी स्वरूपिणी ।\nजगाम तद्वनं यत्र विचेरुस्ते महर्षयः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2201095, "chapter_id": 5285, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे प्रतिग्रहदूषणं नाम षट्त्रिंशोत्तरशततमोऽध्यायः ॥१३६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]