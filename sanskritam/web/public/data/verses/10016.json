[{"id": 6000016000, "chapter_id": 10016, "verse_number": null, "content_sanskrit": "अथ षोडशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "तेन कुत्रचित् कस्यचिद् आश्‍चर्यस्य दर्शनम्", "range": "१९–१८"}]}, {"id": 6000016001, "chapter_id": 10016, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.001.m4a", "display_order": 2}, {"id": 6000016002, "chapter_id": 10016, "verse_number": "१-१६-१", "content_sanskrit": "ततः परीक्षद् द्विजवर्यशिक्षया महीं महाभागवतः शशास ह।\nयथा हि सूत्यामभिजातकोविदाः समादिशन्विप्रमहद्गुणांस्तथा॥ १/१६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.002.m4a", "display_order": 3, "topics": [{"text": "परीक्षित उत्तरकुमारपुत्र्या इरावत्या सह विवाहः। तस्यां जनमेजयादिपुत्रचतुष्‍टयोत्पत्तिश्‍च", "range": "१–२"}]}, {"id": 6000016003, "chapter_id": 10016, "verse_number": "१-१६-२", "content_sanskrit": "स उत्तरस्य तनयामुपयेम इरावतीम्।\nजनमेजयादींश्‍चतुरस्तस्यामुत्पादयत्सुतान्॥ १/१६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.003.m4a", "display_order": 4}, {"id": 6000016004, "chapter_id": 10016, "verse_number": "१-१६-३", "content_sanskrit": "आजहाराश्‍वमेधांस्‍त्रीन् गङ्गायां भूरिदक्षिणान्।\nशारद्वतं गुरुं कृत्वा देवा यत्राक्षिगोचराः॥ १/१६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.004.m4a", "display_order": 5, "topics": [{"text": "तेनाश्‍वमेधत्रययजनम्", "range": "३"}]}, {"id": 6000016005, "chapter_id": 10016, "verse_number": "१-१६-४", "content_sanskrit": "निजग्राहौजसा धीरः कलिं दिग्विजये क्‍वचित्।\nनृपलिङ्गधरं शूद्रं घ्नन्तं गोमिथुनं पदा॥ १/१६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.005.m4a", "display_order": 6, "topics": [{"text": "तेन दिग्विजये भद्राश्‍वकेतुमालादिवर्षविजयः", "range": "४–१३"}]}, {"id": 6000016006, "chapter_id": 10016, "verse_number": null, "content_sanskrit": "शौनक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.006.m4a", "display_order": 7}, {"id": 6000016007, "chapter_id": 10016, "verse_number": "१-१६-५", "content_sanskrit": "कस्य हेतोर्निजग्राह कलिं दिग्विजये नृपः।\nनृदेवचिह्नधृक् शूद्रः कोऽसौ गां यः पदाऽहनत्॥ १/१६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.007.m4a", "display_order": 8}, {"id": 6000016008, "chapter_id": 10016, "verse_number": "१-१६-६", "content_sanskrit": "तत्कथ्यतां महाभाग यदि विष्णुकथाश्रयम्।\nअथ वाऽस्य पदाम्भोजमकरन्दलिहां सताम्॥ १/१६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.008.m4a", "display_order": 9}, {"id": 6000016009, "chapter_id": 10016, "verse_number": "१-१६-७", "content_sanskrit": "किमन्यैरसदालापैरायुषो यदसद्व्ययः।\nक्षुद्रायुषां नृणामङ्ग मर्त्यानां मृतिमृच्छताम्॥ १/१६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.009.m4a", "display_order": 10}, {"id": 6000016010, "chapter_id": 10016, "verse_number": "१-१६-८", "content_sanskrit": "इहोपहूतो भगवान्मृत्युः शामित्रकर्मणि।\nन कश्‍चिन्म्रियते तावद्यावादास्त इहान्तकः॥ १/१६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.010.m4a", "display_order": 11}, {"id": 6000016011, "chapter_id": 10016, "verse_number": "१-१६-९", "content_sanskrit": "एतदर्थं हि भगवानाहूतः परमर्षिभिः।\nअहो नृलोके पीयेत हरिलीलामृतं वचः॥ १/१६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.011.m4a", "display_order": 12}, {"id": 6000016012, "chapter_id": 10016, "verse_number": "१-१६-१०", "content_sanskrit": "मन्दस्य मन्दप्रज्ञस्य प्रायो मन्दायुषश्‍च वै।\nनिद्रया ह्रियते नक्‍तं दिवा चाप्यर्थकर्मभिः॥ १/१६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.012.m4a", "display_order": 13}, {"id": 6000016013, "chapter_id": 10016, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.013.m4a", "display_order": 14}, {"id": 6000016014, "chapter_id": 10016, "verse_number": "१-१६-११", "content_sanskrit": "यदा परीक्षित्कुरुजाङ्गले वसन् कलिं प्रविष्‍टं निजचक्रवर्तिते।\nनिशम्य वार्तामनतिप्रियां ततः शरासनं संयुगरोचिराददे॥ १/१६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.014.m4a", "display_order": 15}, {"id": 6000016015, "chapter_id": 10016, "verse_number": "१-१६-१२", "content_sanskrit": "स्वलङ्कृतं श्यामतुरङ्गयोजितं रथं मृगेन्द्रध्वजमास्थितः पुरात्।\nवृतो रथाश्‍वद्विपपत्तियुक्‍तया स्वसेनया दिग्विजयाय निर्गतः॥ १/१६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.015.m4a", "display_order": 16}, {"id": 6000016016, "chapter_id": 10016, "verse_number": "१-१६-१३", "content_sanskrit": "भद्राश्‍वं केतुमालं ‍च भारतं ‍चोत्तरान्कुरून्।\nकिम्पुरुषादीनि सर्वाणि विजित्य जगृहे बलिम्॥ १/१६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.016.m4a", "display_order": 17}, {"id": 6000016017, "chapter_id": 10016, "verse_number": "१-१६-१४", "content_sanskrit": "तत्र तत्रोपशृण्वानः स्वपूर्वेषां महात्मनाम्।\nप्रगीयमानं पुरतः कृष्णमाहात्म्यसूचनम्॥ १/१६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.017.m4a", "display_order": 18}, {"id": 6000016018, "chapter_id": 10016, "verse_number": "१-१६-१५", "content_sanskrit": "आत्मानं ‍च परित्रातमश्‍वत्थाम्नोऽस्‍त्रतेजसः।\nस्नेहं ‍च वृष्णिपार्थानां तेषां भक्‍तिं ‍च केशवे॥ १/१६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.018.m4a", "display_order": 19}, {"id": 6000016019, "chapter_id": 10016, "verse_number": "१-१६-१६", "content_sanskrit": "तेभ्यः परमसन्तुष्‍टः प्रीत्युज्जृम्भितलोचनः।\nमहाधनानि वासांसि ददौ हारान्महामनाः॥ १/१६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.019.m4a", "display_order": 20}, {"id": 6000016020, "chapter_id": 10016, "verse_number": "१-१६-१७", "content_sanskrit": "सारथ्यपार्षदसेवनसख्यदौत्यवीरासनानुगमनस्तवनप्रणामैः।\nस्निग्धेषु पाण्डुषु जगत्प्रणतस्य विष्णोः भक्‍तिं करोति नृपतिश्‍चरणारविन्दे॥ १/१६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.020.m4a", "display_order": 21}, {"id": 6000016021, "chapter_id": 10016, "verse_number": "१-१६-१८", "content_sanskrit": "तस्यैवं वर्तमानस्य पूर्वेषां वृत्तमन्वहम्।\nनातिदूरे किलाश्‍चर्यं यदासीत्तन्निबोध मे॥ १/१६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.021.m4a", "display_order": 22}, {"id": 6000016022, "chapter_id": 10016, "verse_number": "१-१६-१९", "content_sanskrit": "धर्मः पदैकेन चरन्विच्छायामुपलभ्य गाम्।\nपृच्छति स्माश्रुवदनां विवत्सामिव मातरम्॥ १/१६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.022.m4a", "display_order": 23, "topics": [{"text": "एकचरणावशिष्‍टेन वृषरूपिणा धर्मेण विवर्णां गोरूपधारिणीं धरणीदेवीं प्रति नानाविकल्पपूर्वकं शोककारणप्रश्नः", "range": "१९–२५"}]}, {"id": 6000016023, "chapter_id": 10016, "verse_number": null, "content_sanskrit": "धर्म उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.023.m4a", "display_order": 24}, {"id": 6000016024, "chapter_id": 10016, "verse_number": "१-१६-२०", "content_sanskrit": "कच्चिद्भद्रेऽनामयमात्मनस्ते विच्छायाऽसि म्लायता यन्मुखेन।\nआलक्षये भवतीमन्तराधिं दूरे बन्धुं कञ्चन शोचसीव॥ १/१६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.024.m4a", "display_order": 25}, {"id": 6000016025, "chapter_id": 10016, "verse_number": "१-१६-२१", "content_sanskrit": "पादैर्न्यूनं शोचसि मैकपादमुतात्मानं वृषलैर्भोक्ष्यमाणम्।\nअथो सुरादीन् हृतयज्ञभागान् प्रजा उत स्विन्मघवत्यवर्षति॥ १/१६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.025.m4a", "display_order": 26}, {"id": 6000016026, "chapter_id": 10016, "verse_number": "१-१६-२२", "content_sanskrit": "अरक्ष्यमाणा स्‍त्रिय उर्वि बालाञ्छोचस्यथो पुरुषादैरिवार्तान्।\nवाचं देवीं ब्रह्मकुले कुकर्मण्यब्रह्मण्ये राजकुले कुलाग्र्याम्॥ १/१६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.026.m4a", "display_order": 27}, {"id": 6000016027, "chapter_id": 10016, "verse_number": "१-१६-२३", "content_sanskrit": "किं क्षत्रबन्धून्कलिनोपसृष्‍टान्राष्‍ट्राणि वा तैरवरोपितानि।\nइतस्ततो वाऽशनपानवासस्नानव्यवायोत्सुकजीवलोकम्॥ १/१६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.027.m4a", "display_order": 28}, {"id": 6000016028, "chapter_id": 10016, "verse_number": "१-१६-२४", "content_sanskrit": "यद्वाऽथ ते भूरिभारावतारकृतावतारस्य हरेर्धरित्रि।\nअन्तर्हितस्य स्मरती विसृष्‍टा कर्माणि निर्वाणविलम्बितानि॥ १/१६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.028.m4a", "display_order": 29}, {"id": 6000016029, "chapter_id": 10016, "verse_number": "१-१६-२५", "content_sanskrit": "इदं ममाचक्ष्व तवाधिमूलं वसुन्धरे येन विकर्शिताऽसि।\nकालेन वा ते बलिनाऽवलीढं सुरार्चितं किं प्रभुणाऽद्य सौभगम्॥ १/१६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.029.m4a", "display_order": 30}, {"id": 6000016030, "chapter_id": 10016, "verse_number": null, "content_sanskrit": "धरोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.030.m4a", "display_order": 31}, {"id": 6000016031, "chapter_id": 10016, "verse_number": "१-१६-२६", "content_sanskrit": "भवान्हि वेद तत्सर्वं यन्मां धर्मानुपृच्छसि।\nचतुर्भिः वर्तसे येन पादैर्लोकसुखावहैः॥ १/१६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.031.m4a", "display_order": 32, "topics": [{"text": "तया तं प्रति कलिकलितसर्ववर्णाश्रमधर्मलोपस्य श्रीकृष्णवियोगस्य च स्वशोककारणत्वकथनम्", "range": "२६–३७"}]}, {"id": 6000016032, "chapter_id": 10016, "verse_number": "१-१६-२७", "content_sanskrit": "सत्यं शौचं दया दानं त्यागः सन्तोष आर्जवम्।\nशमो दमः तपः साम्यं तितिक्षोपरतिः श्रुतम्॥ १/१६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.032.m4a", "display_order": 33}, {"id": 6000016033, "chapter_id": 10016, "verse_number": "१-१६-२८", "content_sanskrit": "ज्ञानं विरक्‍तिरैश्‍वर्यं शौर्यं तेजो धृतिः स्मृतिः।\nस्वातन्त्र्यं कौशलं कान्तिः सौभगं मार्दवं क्षमा॥ १/१६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.033.m4a", "display_order": 34}, {"id": 6000016034, "chapter_id": 10016, "verse_number": "१-१६-२९", "content_sanskrit": "प्रागल्भ्यं प्रश्रयः शीलं सह ओजो बलं भगः।\nगाम्भीर्यं स्थैर्यमास्तिक्यं कीर्तिर्मानोऽनहंकृतिः॥ १/१६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.034.m4a", "display_order": 35}, {"id": 6000016035, "chapter_id": 10016, "verse_number": "१-१६-३०", "content_sanskrit": "इमे चान्ये च भगवन्नित्या यत्र महागुणाः।\nप्रार्थ्या महत्त्वमिच्छद्भिः न च यान्ति स्म कर्हिचित्॥ १/१६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.035.m4a", "display_order": 36}, {"id": 6000016036, "chapter_id": 10016, "verse_number": "१-१६-३१", "content_sanskrit": "तेनाहं गुणपात्रेण श्रीनिवासेन साम्प्रतम्।\nशोचामि रहितं लोकं पाप्मना कलिनेक्षितम्॥ १/१६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.036.m4a", "display_order": 37}, {"id": 6000016037, "chapter_id": 10016, "verse_number": "१-१६-३२", "content_sanskrit": "आत्मानं चानुशोचामि भवन्तं चामरोत्तम।\nदेवानृषीन् पितॄन् साधून् सर्वान् वर्णांस्तथाऽऽश्रमान्॥ १/१६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.037.m4a", "display_order": 38}, {"id": 6000016038, "chapter_id": 10016, "verse_number": "१-१६-३३", "content_sanskrit": "ब्रह्मादयो बहुतिथं यदपाङ्गमोक्षकामा यथोक्‍तविधिना भगवत्प्रपन्नाः।\nसा श्रीः स्ववासमरविन्दवनं विहाय यत्पादसौभगमलं भजतेऽनुरक्‍ता॥ १/१६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.038.m4a", "display_order": 39}, {"id": 6000016039, "chapter_id": 10016, "verse_number": "१-१६-३४", "content_sanskrit": "तस्याहमब्जकुलिशाङ्कुशकेतुकेतैः श्रीमत्पदैर्भगवतः समलंकृताङ्गी।\nत्रीनत्यरोचमुपलब्धतपोविभूतिर्लोकान्स मां व्यसृजदुत्स्मयतीं तदन्ते॥ १/१६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.039.m4a", "display_order": 40}, {"id": 6000016040, "chapter_id": 10016, "verse_number": "१-१६-३५", "content_sanskrit": "यो वै ममातिभरमासुरवंशराज्ञामक्षौहिणीशतमपानुददात्मतन्त्रः।\nत्वां दुःस्थमूनपदमात्मनि पौरुषेण सम्पादयन्यदुषु रम्यमबिभ्रदङ्गम्॥ १/१६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.040.m4a", "display_order": 41}, {"id": 6000016041, "chapter_id": 10016, "verse_number": "१-१६-३६", "content_sanskrit": "का वा सहेत विरहं पुरुषोत्तमस्य प्रेमावलोकरुचिरस्मितवल्गुजल्पैः।\nस्थैर्यं समानमहरन्मधुमानिनीनां रोमोत्सवो मम यदङ्घ्रिविटङ्कितायाः॥ १/१६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.041.m4a", "display_order": 42}, {"id": 6000016042, "chapter_id": 10016, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.042.m4a", "display_order": 43}, {"id": 6000016043, "chapter_id": 10016, "verse_number": "१-१६-३७", "content_sanskrit": "तयोरेवं कथयतोः पृथिवीधर्मयोस्तदा।\nपरीक्षिन्नाम राजर्षिः प्राप्‍तः प्राचीं सरस्वतीम्॥ १/१६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_016/BhP_01.016.043.m4a", "display_order": 44}, {"id": 6000016044, "chapter_id": 10016, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे षोडशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]