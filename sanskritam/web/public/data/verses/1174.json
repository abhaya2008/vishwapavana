[{"id": 2008948, "chapter_id": 1174, "verse_number": "१-१७५-०x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008949, "chapter_id": 1174, "verse_number": "१-१७५-१", "content_sanskrit": "न विषादस्त्वया कार्यो भयादस्मात्कथंचन।\nउपायः परिदृष्टोऽत्र तस्मान्मोक्षाय रक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008950, "chapter_id": 1174, "verse_number": "१-१७५-२", "content_sanskrit": "नैव स्वयं सपुत्रस्य गमनं तत्र रोचये।\nएकस्तव सुतो बालः कन्या चैका तपस्विनी।\nन चैतयोस्तथा पत्न्या गमनं तव रोचये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008951, "chapter_id": 1174, "verse_number": "१-१७५-३", "content_sanskrit": "मम पञ्च सुता ब्रह्मंस्तेषामेको गमिष्यति।\nत्वदर्थं बलिमादाय तस्य पापस्य रक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008952, "chapter_id": 1174, "verse_number": "१-१७५-४x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008953, "chapter_id": 1174, "verse_number": "१-१७५-४", "content_sanskrit": "नाहमेतत्करिष्यामि जीवितार्थी कथंचन।\nब्राह्मणस्यातिथेश्चैव स्वार्थे प्राणान्वियोजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008954, "chapter_id": 1174, "verse_number": "१-१७५-५", "content_sanskrit": "न त्वेतदकुलीनासु नाधर्मिष्ठासु विद्यते।\nयद्ब्राह्ममार्थं विसृजेदात्मानमपि चात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008955, "chapter_id": 1174, "verse_number": "१-१७५-६", "content_sanskrit": "आत्मनस्तु वधः श्रेयो बोद्धव्यमिति रोचते।\nब्रहम्वध्याऽऽत्मवध्या वा श्रेयानात्मवधो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008956, "chapter_id": 1174, "verse_number": "१-१७५-७", "content_sanskrit": "ब्रह्मवध्या परं पापं निष्कृतिर्नात्र विद्यते।\nअबुद्धिपूर्वं कृत्वापि प्रत्यवायो हि विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008957, "chapter_id": 1174, "verse_number": "१-१७५-८", "content_sanskrit": "न त्वहं वधमाकाङ्क्षे स्वयमेवात्मनः शुभे।\nपरैः कृते वधे पापं न किंचिन्मयि विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008958, "chapter_id": 1174, "verse_number": "१-१७५-९", "content_sanskrit": "अभिसंधौ कृते तस्मिन्ब्राह्मणस्य वधे मया।\nनिष्कृतिं न प्रपश्यामि नृशंसं क्षुद्रमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008959, "chapter_id": 1174, "verse_number": "१-१७५-१०", "content_sanskrit": "आगतस्य गृहं त्यागस्तथैव शरणार्थिनः।\nयाचमानस्य च वधो नृशंसो गर्हितो बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008960, "chapter_id": 1174, "verse_number": "१-१७५-११", "content_sanskrit": "कुर्यान्न निन्दितं कर्म न नृशंसं कथंचन।\nइति पूर्वे महात्मान आपद्धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008961, "chapter_id": 1174, "verse_number": "१-१७५-१२", "content_sanskrit": "श्रेयांस्तु सहदारस्य विनाशोऽद्य मम स्वयम्।\nब्राह्मणस्य वधं नाहमनुमंस्ये कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008962, "chapter_id": 1174, "verse_number": "१-१७५-१३x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008963, "chapter_id": 1174, "verse_number": "१-१७५-१३", "content_sanskrit": "ममाप्येषा मतिर्ब्रह्मन्विप्रा रक्ष्या इति स्थिरा।\nन चाप्यनिष्टः पुत्रो मे यदि पुत्रशतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008964, "chapter_id": 1174, "verse_number": "१-१७५-१४", "content_sanskrit": "न चासौ राक्षसः शक्तो मम पुत्रविनाशने।\nवीर्यमन्मन्त्रसिद्धश्च तेजस्वी च सुतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008965, "chapter_id": 1174, "verse_number": "१-१७५-१५", "content_sanskrit": "राक्षसाय च तत्सर्वं प्रापयिष्यति भोजनम्।\nमोक्षयिष्यति चात्मानमिति मे निश्चिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008966, "chapter_id": 1174, "verse_number": "१-१७५-१६", "content_sanskrit": "समागताश्च वीरेण दृष्टपूर्वाश्च राक्षसाः।\nबलवन्तो महाकाया निहताश्चाप्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008967, "chapter_id": 1174, "verse_number": "१-१७५-१७", "content_sanskrit": "न त्विदं केषुचिद्ब्रह्मान्व्याहर्तव्यं कथंचन।\nविद्यार्थिनो हि मे पुत्रान्विप्रकुर्युः कुतूहलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008968, "chapter_id": 1174, "verse_number": "१-१७५-१८", "content_sanskrit": "गुरुणा चाननुज्ञातो ग्राहयेद्यः सुतो मम।\nन स कुर्यात्तथा कार्यं विद्ययेति सतां मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008969, "chapter_id": 1174, "verse_number": "१-१७५-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008970, "chapter_id": 1174, "verse_number": "१-१७५-१९", "content_sanskrit": "एवमुक्तस्तु पृथया स विप्रो भार्यया सह।\nहृष्टः संपूजयामास तद्वाक्यममृतोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008971, "chapter_id": 1174, "verse_number": "१-१७५-२०", "content_sanskrit": "ततः कुन्ती च विप्रश्च सहितावनिलात्मजम्।\nतमब्रूतां कुरुष्वेति स तथेत्यब्रवीच्च तौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2008972, "chapter_id": 1174, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि पञ्चसप्तत्यधिकशततमोऽध्यायः॥ १७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]