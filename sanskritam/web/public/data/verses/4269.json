[{"id": 2150617, "chapter_id": 4269, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150618, "chapter_id": 4269, "verse_number": "१", "content_sanskrit": "कथं युयुधिरे वीराः कुरुपाण्डवसोमकाः ।\nपार्थिवाश्च महाभागा नानादेशसमागताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150619, "chapter_id": 4269, "verse_number": "२", "content_sanskrit": "प्रत्ययुध्यन्त समरे भीष्मेणामित्रकर्षिणा ।\nकथं वा कौरवाः सर्वे भीमसेने चमूपतौ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150620, "chapter_id": 4269, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150621, "chapter_id": 4269, "verse_number": "३", "content_sanskrit": "यथा युयुधिरे वीराः कुरुपाण्डवसोमकाः ।\nकुरुक्षेत्रे तपःक्षेत्रे शृणु तत् पृथिवीपते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150622, "chapter_id": 4269, "verse_number": "४", "content_sanskrit": "अवतीर्य कुरुक्षेत्रं पाण्डवाः सहसोमकाः ।\nकौरवानभ्यवर्तन्त जिगीषन्तो महाबलाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150623, "chapter_id": 4269, "verse_number": "५", "content_sanskrit": "वेदाध्ययनसम्पन्नाः सर्वे युद्धाभिनन्दिनः ।\nआशंसन्तो जयं युद्धे वधं वाभिमुखा रणे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150624, "chapter_id": 4269, "verse_number": "६", "content_sanskrit": "अभियाय च दुर्धर्षां धार्तराष्ट्रस्य वाहिनीम् ।\nप्राङ्मुखाः पश्चिमे भागे न्यविशन्त ससैनिकाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150625, "chapter_id": 4269, "verse_number": "७", "content_sanskrit": "पूर्वभागे तु क्षेत्रस्य स्थिताः प्रत्यङ्मुखा युधि ।\nआहवाय धुराधर्ष धार्तराष्ट्रस्य पार्थिवाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150626, "chapter_id": 4269, "verse_number": "८", "content_sanskrit": "समन्तपञ्चकाद् बाह्यं शिबिराणि सहस्रशः ।\nकारयामास विधिवत् कुन्तीपुत्रो युधिष्ठिरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150627, "chapter_id": 4269, "verse_number": "९", "content_sanskrit": "अन्येव पृथिवी सर्वा बालवृद्धावशेषिता ।\nनिरस्तपुरुषेवासीत् रथकुञ्जरवर्जिता\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150628, "chapter_id": 4269, "verse_number": "१०", "content_sanskrit": "यावत् तपति सूर्यो हि जम्बूद्वीपस्य मण्डलम् ।\nतावदेव समावृत्तं बलं पार्थिवसत्तम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150629, "chapter_id": 4269, "verse_number": "११", "content_sanskrit": "एकस्थाः सर्ववर्णास्ते मण्डलं बहुयोजनम् ।\nपर्याक्रामन्त देशांश्च नदीः शैलान् वनानि च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150630, "chapter_id": 4269, "verse_number": "१२", "content_sanskrit": "तेषां युधिष्ठिरो राजा सर्वेषां पुरुषर्षभ ।\nआदिदेश सवाहानां भक्ष्यभोज्यमनुत्तमम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150631, "chapter_id": 4269, "verse_number": "१३", "content_sanskrit": "सञ्ज्ञाश्च विविधास्तास्तास्तेषां चक्रे युधिष्ठिरः ।\nएवंवादी वेदितव्यः पाण्डवेयोऽयमित्युत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150632, "chapter_id": 4269, "verse_number": "१४", "content_sanskrit": "अभिज्ञानानि सर्वेषां सञ्ज्ञाश्चाभरणानि च ।\nयोजयामास कौरव्यो युद्धकाल उपस्थिते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150633, "chapter_id": 4269, "verse_number": "१५", "content_sanskrit": "दृष्ट्वा ध्वजाग्रं पार्थानां धार्तराष्ट्रो महामनाः ।\nसह सर्वैर्महीपालैः प्रत्यव्यूहत पाण्डवान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150634, "chapter_id": 4269, "verse_number": "१६", "content_sanskrit": "पाण्डरेणातपत्रेण ध्रियमाणेन मूर्धनि ।\nवृतं सर्वैः महीपालैः भ्रातृभिः परिवारितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150635, "chapter_id": 4269, "verse_number": "१७", "content_sanskrit": "मध्ये नागसहस्रस्य स्थितं युद्धाभिनन्दिनम् ।\nदृष्ट्वा दुर्योधनं हृष्टाः सर्वे पाण्डवसैनिकाः ।\nदध्मुः सर्वे महाशङ्खान् भेरीर्जघ्नुः सहस्रशः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150636, "chapter_id": 4269, "verse_number": "१८", "content_sanskrit": "ततः प्रहृष्टां स्वां सेनामभिवीक्ष्याथ पाण्डवाः ।\nबभूवुर्हृष्टमनसो वासुदेवश्च वीर्यवान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150637, "chapter_id": 4269, "verse_number": "१९", "content_sanskrit": "ततो योधान् हर्षयन्तौ वासुदेवधनञ्जयौ ।\nदध्मतुः पुरुषव्याघ्रौ दिव्यौ शङ्खौ रथे स्थितौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150638, "chapter_id": 4269, "verse_number": "२०", "content_sanskrit": "पाञ्चजन्यस्य निर्घोषं देवदत्तस्य चोभयोः ।\nश्रुत्वा सवाहना योधाः शकृन्मूत्रं प्रसुस्रुवुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150639, "chapter_id": 4269, "verse_number": "२१", "content_sanskrit": "यथा सिंहस्य नदतः स्वनं श्रुत्वेतरे मृगाः ।\nत्रसेयुस्तद्वदेवासीद् धार्तराष्ट्रबलं तदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150640, "chapter_id": 4269, "verse_number": "२२", "content_sanskrit": "उदतिष्ठद् रजो भौमं न प्राज्ञायत किञ्चन ।\nअन्तर्धीयत चादित्यः सैन्येन रजसावृतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150641, "chapter_id": 4269, "verse_number": "२३", "content_sanskrit": "ववर्ष चात्र पर्जन्यो मांसशोणितवृष्टिमान् ।\nव्युक्षन् सर्वाण्यनीकानि तदद्भुतमिवाभवत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150642, "chapter_id": 4269, "verse_number": "२४", "content_sanskrit": "वायुस्ततः प्रादुरभून्नीचैः शर्करकर्षणः ।\nविनिघ्नंस्तान्यनीकानि विधमंश्चैव तद् रजः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150643, "chapter_id": 4269, "verse_number": "२५", "content_sanskrit": "उभे सेने तदा राजन् युद्धाय मुदिते भृशम् ।\nकुरुक्षेत्रे स्थिते यत् ते सागरक्षुभितोपमे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150644, "chapter_id": 4269, "verse_number": "२६", "content_sanskrit": "तयोस्तु सेनयोरासीदद्भुतः स समागमः ।\nयुगान्ते समनुप्राप्ते द्वयोः सागरयोरिव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150645, "chapter_id": 4269, "verse_number": "२७", "content_sanskrit": "शून्यासीत् पृथिवी सर्वा बालवृद्धावशेषिता ।\nतेन सेनासमूहेन समानीतेन कौरवैः ।\nसमन्तान्नागकल्पेन गर्जमानेन सर्वशः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150646, "chapter_id": 4269, "verse_number": "२८", "content_sanskrit": "ततस्ते समयं चक्रुः कुरुपाण्डवसोमकाः ।\nधर्मांश्च स्थापयामासुर्युद्धानां भरतर्षभ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150647, "chapter_id": 4269, "verse_number": "२९", "content_sanskrit": "निवृत्ते चैव नो युद्धे प्रीतिश्च स्यात् परस्परम् ।\nयथापुरं यथायोगं न च स्याच्छलनं पुनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150648, "chapter_id": 4269, "verse_number": "३०", "content_sanskrit": "वाचा युद्धे प्रवृत्ते नो वाचैव प्रतियोधनम् ।\nनिष्क्रान्तः पृतनामध्यान्न हन्तव्यः कथञ्चन\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150649, "chapter_id": 4269, "verse_number": "३१", "content_sanskrit": "रथी च रथिना योध्यो गजेन गजधूर्गतः ।\nअश्वेनाश्वी पदातिश्च पदातेनैव भारत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150650, "chapter_id": 4269, "verse_number": "३२", "content_sanskrit": "यथायोगं यथावीर्यं यथोत्साहं यथावयः ।\nसमाभाष्य प्रहर्तव्यं न विश्वस्ते न विह्वले\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150651, "chapter_id": 4269, "verse_number": "३३", "content_sanskrit": "परेण सह संयुक्तः प्रमत्तो विमुखस्तथा ।\nक्षीणशस्त्रो विवर्मा च न हन्तव्यः कथञ्चन\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150652, "chapter_id": 4269, "verse_number": "३४", "content_sanskrit": "न सूतेषु न धुर्येषु न च शस्त्रोपनायिषु ।\nन भेरीशङ्खवादेषु प्रहर्तव्यं कथञ्चन\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150653, "chapter_id": 4269, "verse_number": "३५", "content_sanskrit": "एवं ते समयं कृत्वा कुरुपाण्डवसोमकाः ।\nविस्मयं परमं जग्मुः प्रेक्षमाणाः परस्परम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150654, "chapter_id": 4269, "verse_number": "३६", "content_sanskrit": "निविश्य च महात्मानस्ततस्ते पुरुषर्षभाः ।\nहृष्टरूपाः सुमनसो बभूवुः सहसैनिकाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150655, "chapter_id": 4269, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150656, "chapter_id": 4269, "verse_number": "", "content_sanskrit": "॥ इति जम्बूखण्डनिर्माणपर्वणि प्रथमोऽध्यायः ॥१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]