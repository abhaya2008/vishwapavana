[{"id": 6000081000, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "अथ सप्तदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000081001, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.001.m4a", "display_order": 2}, {"id": 6000081002, "chapter_id": 10081, "verse_number": "४-१७-१", "content_sanskrit": "एवं स भगवान् वैन्यः ख्यापितो गुणकर्मभिः।\nछन्दयामास तान् कामैः प्रतिपूज्याभिनन्द्य च॥ ४/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.002.m4a", "display_order": 3, "topics": [{"text": "अन्नाभावात्प्रजासु क्षुधापीडितासु पृथुना तत्कारणं ज्ञात्वा उप्तानि बीजानि ग्रसन्त्या आत्मरुद्धानि बीजानि बहिरमुञ्चन्त्याश्च भूमेर्हननोद्यमः", "range": "१–२९"}]}, {"id": 6000081003, "chapter_id": 10081, "verse_number": "४-१७-२", "content_sanskrit": "ब्राह्मणप्रमुखान् वर्णान् भृत्यामात्यपुरोधसः।\nपौरान् जानपदान् श्रेणीः प्रकृतीः समपूजयत्॥ ४/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.003.m4a", "display_order": 4}, {"id": 6000081004, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.004.m4a", "display_order": 5}, {"id": 6000081005, "chapter_id": 10081, "verse_number": "४-१७-३", "content_sanskrit": "कस्माद् दधार गोरूपं धरित्री बहुरूपिणी।\nयां दुदोह पृथुस्तत्र को वत्सो दोहनं च किम्॥ ४/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.005.m4a", "display_order": 6}, {"id": 6000081006, "chapter_id": 10081, "verse_number": "४-१७-४", "content_sanskrit": "प्रकृत्या विषमा देवी कृता तेन समा कथम्।\nतस्य मेध्यं हयं देवः कस्य हेतोरपाहरत्॥ ४/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.006.m4a", "display_order": 7}, {"id": 6000081007, "chapter_id": 10081, "verse_number": "४-१७-५", "content_sanskrit": "सनत्कुमाराद् भगवतो ब्रह्मन् ब्रह्मविदुत्तमात्।\nलब्ध्वा ज्ञानं सविज्ञानं राजर्षिः कां गतिं गतः॥ ४/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.007.m4a", "display_order": 8}, {"id": 6000081008, "chapter_id": 10081, "verse_number": "४-१७-६", "content_sanskrit": "यच्चान्यदपि कृष्णस्य ब्रह्मन् भगवतः प्रभोः।\nश्रवः सुश्रवसः पुण्यं पूर्वदेहकथाश्रयम्॥ ४/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.008.m4a", "display_order": 9}, {"id": 6000081009, "chapter_id": 10081, "verse_number": "४-१७-७", "content_sanskrit": "भक्ताय मेऽनुरक्ताय तव चाधोक्षजस्य च।\nवक्तुमर्हसि योऽदुह्यद् वैन्यरूपेण गामिमाम्॥ ४/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.009.m4a", "display_order": 10}, {"id": 6000081010, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.010.m4a", "display_order": 11}, {"id": 6000081011, "chapter_id": 10081, "verse_number": "४-१७-८", "content_sanskrit": "चोदितो विदुरेणैवं वासुदेवकथां प्रति।\nप्रशस्य तं प्रीतमना मैत्रेयः प्रत्यभाषत॥ ४/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.011.m4a", "display_order": 12}, {"id": 6000081012, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.012.m4a", "display_order": 13}, {"id": 6000081013, "chapter_id": 10081, "verse_number": "४-१७-९", "content_sanskrit": "यदाऽभिषिक्तः पृथुरङ्ग विप्रैरामन्त्रितो जनतायाश्च पालः।\nप्रजा निरन्ने क्षितिपृष्ठ एत्य क्षुत्क्षामदेहाः पतिमभ्यवोचन्॥ ४/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.013.m4a", "display_order": 14}, {"id": 6000081014, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "प्रजा ऊचुः —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.014.m4a", "display_order": 15}, {"id": 6000081015, "chapter_id": 10081, "verse_number": "४-१७-१०", "content_sanskrit": "वयं राजन् जाठरेणाभितप्ता यथाऽग्निना कोटरस्थेन वृक्षः।\nत्वामद्य याताः शरणं शरण्यं यः शाधि नो वृत्तिकरः पतिर्नः॥ ४/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.015.m4a", "display_order": 16}, {"id": 6000081016, "chapter_id": 10081, "verse_number": "४-१७-११", "content_sanskrit": "तन्नो भवानर्हति रातवेऽन्नं क्षुधाऽर्दितानां नरदेवदेव।\nयावन्न नङ्क्ष्यामह उज्झितान्ना वार्तापतिस्त्वं किल लोकपालः॥ ४/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.016.m4a", "display_order": 17}, {"id": 6000081017, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.017.m4a", "display_order": 18}, {"id": 6000081018, "chapter_id": 10081, "verse_number": "४-१७-१२", "content_sanskrit": "पृथुः प्रजानां करुणं निशम्य परिवेदितम्।\nदीर्घं दध्यौ कुरुश्रेष्ठ निमित्तं सोऽन्वपद्यत॥ ४/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.018.m4a", "display_order": 19}, {"id": 6000081019, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "(पृथिव्यौषधिबीजानि निगीर्णान्यसति शास्तरि।\nतदहं देहिनां वृत्तिमात्मयोगेन साधये॥ ४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.019.m4a", "display_order": 20}, {"id": 6000081020, "chapter_id": 10081, "verse_number": "४-१७-१३", "content_sanskrit": ")\nइति व्यवसितो बुद्ध्या प्रगृहीतशरासनः। संदधे विशिखं भूमौ क्रुद्धस्‍त्रिपुरहा यथा॥ ४/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.020.m4a", "display_order": 21}, {"id": 6000081021, "chapter_id": 10081, "verse_number": "४-१७-१४", "content_sanskrit": "प्रवेपमाना धरणी निशम्योदायुधं च तम्।\nगौः सत्यपाद्रवद् भीता मृगीव मृगयोर्द्रुतम्॥ ४/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.021.m4a", "display_order": 22}, {"id": 6000081022, "chapter_id": 10081, "verse_number": "४-१७-१५", "content_sanskrit": "तामेवान्वव्रजद् वैन्यः कुपितोऽत्यरुणेक्षणः।\nशरं धनुषि संधाय यत्र यत्र पलायति॥ ४/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.022.m4a", "display_order": 23}, {"id": 6000081023, "chapter_id": 10081, "verse_number": "४-१७-१६", "content_sanskrit": "सा दिशो विदिशो देवी रोदसी चान्तरं तयोः।\nधावती तत्र तत्रैनं ददर्शानूद्यतायुधम्॥ ४/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.023.m4a", "display_order": 24}, {"id": 6000081024, "chapter_id": 10081, "verse_number": "४-१७-१७", "content_sanskrit": "लोके नाविन्दत त्राणं वैन्यान्मृत्योरिव प्रजाः।\nत्रस्ता तदा निववृते हृदयेन विदूयता॥ ४/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.024.m4a", "display_order": 25}, {"id": 6000081025, "chapter_id": 10081, "verse_number": "४-१७-१८", "content_sanskrit": "अवोचाथ महाभागं धर्मज्ञाऽपन्नवत्सल।\nत्राहि मामपि भूतानां पालनेऽवस्थितो भवान्॥ ४/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.025.m4a", "display_order": 26}, {"id": 6000081026, "chapter_id": 10081, "verse_number": "४-१७-१९", "content_sanskrit": "स त्वं जिघांससे कस्माद् दीनामकृतकिल्बिषाम्।\nअहनिष्यत् कथं योषां धर्मज्ञ इति यो मतः॥ ४/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.026.m4a", "display_order": 27}, {"id": 6000081027, "chapter_id": 10081, "verse_number": "४-१७-२०", "content_sanskrit": "प्रहरन्ति न वै स्‍त्रीषु कृतागःस्वपि जन्तवः।\nकिमुत त्वद्विधा राजन् करुणा दीनवत्सलाः॥ ४/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.027.m4a", "display_order": 28}, {"id": 6000081028, "chapter_id": 10081, "verse_number": "४-१७-२१", "content_sanskrit": "मां निहत्याजरां नावं यत्र विश्वं प्रतिष्ठितम्।\nआत्मानं च प्रजाश्चेमाः कथमम्भसि धास्यसि॥ ४/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.028.m4a", "display_order": 29}, {"id": 6000081029, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "पृथुरुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.029.m4a", "display_order": 30}, {"id": 6000081030, "chapter_id": 10081, "verse_number": "४-१७-२२", "content_sanskrit": "वसुधे त्वां वधिष्यामि मच्छासनपराङ्मुखीम्।\nभागं बर्हिषि या वृङ्क्ते न तनोषि च नो वसु॥ ४/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.030.m4a", "display_order": 31}, {"id": 6000081031, "chapter_id": 10081, "verse_number": "४-१७-२३", "content_sanskrit": "यवसं जग्ध्यनुदिनं नैव दोग्ध्यौधसं पयः।\nतस्यामेवं हि दुष्टायां दण्डो नात्र न शस्यते॥ ४/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.031.m4a", "display_order": 32}, {"id": 6000081032, "chapter_id": 10081, "verse_number": "४-१७-२४", "content_sanskrit": "त्वं खल्वौषधिबीजानि प्राक् सृष्टानि स्वयम्भुवा।\nन मुञ्चस्यात्मरुद्धानि मामवज्ञाय मन्दधीः॥ ४/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.032.m4a", "display_order": 33}, {"id": 6000081033, "chapter_id": 10081, "verse_number": "४-१७-२५", "content_sanskrit": "अमूषां क्षुत्परीतानामार्तानां परिवेदितम्।\nशमयिष्यामि तद्बाणैर्भिन्नायास्तव मेदसा॥ ४/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.033.m4a", "display_order": 34}, {"id": 6000081034, "chapter_id": 10081, "verse_number": "४-१७-२६", "content_sanskrit": "पुमान् योषिदुत क्लीब आत्मसम्भावनोऽधमः।\nभूतेषु निरनुक्रोशो नृपाणां तद्वधो वरः॥ ४/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.034.m4a", "display_order": 35}, {"id": 6000081035, "chapter_id": 10081, "verse_number": "४-१७-२७", "content_sanskrit": "त्वां स्तब्धां दुर्मदां नीत्वा मायागां तिलशः शरैः।\nआत्मयोगबलेनेमा धारयिष्याम्यहं प्रजाः॥ ४/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.035.m4a", "display_order": 36}, {"id": 6000081036, "chapter_id": 10081, "verse_number": "४-१७-२८", "content_sanskrit": "एवं मन्युमयीं मूर्तिं कृतान्तमिव बिभ्रतम्।\nप्रणता प्राञ्जलिः प्राह मही संजातवेपथुः॥ ४/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.036.m4a", "display_order": 37}, {"id": 6000081037, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "धरण्युवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.037.m4a", "display_order": 38}, {"id": 6000081038, "chapter_id": 10081, "verse_number": "४-१७-२९", "content_sanskrit": "नमः परस्मै पुरुषाय मायया विन्यस्तनानातनवे(ऽ)गुणात्मने।\nनमः स्वरूपानुभवेन निर्धुतद्रव्यक्रियाकारकविभ्रमोर्मये॥ ४/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.038.m4a", "display_order": 39}, {"id": 6000081039, "chapter_id": 10081, "verse_number": "४-१७-३०", "content_sanskrit": "येनाहमात्मीयतनुर्विनिर्मिता धात्रा यतोऽयं गुणसर्गसङ्ग्रहः।\nस एव मां हन्तुमुदायुधः स्वराडुपस्थितोऽन्यं शरणं कमाश्रये॥ ४/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.039.m4a", "display_order": 40, "topics": [{"text": "भीतया भूम्या पृथोः स्तुतिः", "range": "३०–३७"}]}, {"id": 6000081040, "chapter_id": 10081, "verse_number": "४-१७-३१", "content_sanskrit": "य एतदादावसृजच्चराचरं स्वमाययाऽऽत्माश्रययाऽवितर्क्यया।\nतयैव सोऽयं किल गोप्तुमुद्यतः कथं नु मां धर्मपरो जिघांसति॥ ४/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.040.m4a", "display_order": 41}, {"id": 6000081041, "chapter_id": 10081, "verse_number": "४-१७-३२", "content_sanskrit": "नूनं तवेशस्य समीहितं जनैस्स्वमायया दुर्जययाऽकृतात्मभिः।\nन लक्ष्यते यस्त्वकरोदकारयद् योऽनेक एकः परतः स ईश्वरः॥ ४/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.041.m4a", "display_order": 42}, {"id": 6000081042, "chapter_id": 10081, "verse_number": "४-१७-३३", "content_sanskrit": "सर्गादि योऽस्यानुरुणद्धि शक्तिभिर्द्रव्यक्रियाकारकचेतनात्मभिः।\nतस्मै समुन्नद्धविरुद्धशक्तये नमः परस्मै पुरुषाय वेधसे॥ ४/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.042.m4a", "display_order": 43}, {"id": 6000081043, "chapter_id": 10081, "verse_number": "४-१७-३४", "content_sanskrit": "स वै भवानात्मविनिर्मितं जगद् भूतेन्द्रियान्तःकरणात्मकं विभो।\nसंस्थापयिष्यन्नज मा रसातलादभ्युज्जहाराम्भस आदिसूकरः॥ ४/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.043.m4a", "display_order": 44}, {"id": 6000081044, "chapter_id": 10081, "verse_number": "४-१७-३५", "content_sanskrit": "अपामुपस्थे मयि नाव्यवस्थिताः प्रजा भवानद्य रिरक्षिषुः किल।\nस वीरमूर्तिः समभूद् धराधरो यो मां पयस्युग्रशरो जिघांसति॥ ४/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.044.m4a", "display_order": 45}, {"id": 6000081045, "chapter_id": 10081, "verse_number": "४-१७-३६", "content_sanskrit": "नूनं जनैरीहितमीश्वराणामस्मद्विधैस्तद्गुणसर्गमायया।\nन ज्ञायते मोहितचित्तवृत्तिभिस्तेभ्यो नमो वीरयशस्करेभ्यः॥ ४/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_017/BhP_04.017.045.m4a", "display_order": 46}, {"id": 6000081046, "chapter_id": 10081, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे सप्तदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]