[{"id": 2106817, "chapter_id": 3320, "verse_number": "१८-५-१", "content_sanskrit": "जनमेजय उवाच।\nभीष्मद्रोणौ महात्मानौ धृतराष्ट्रश्च पार्थिवः।\nविराटद्रुपदौ चोभौ शङ्खश्चैवोत्तरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106818, "chapter_id": 3320, "verse_number": "१८-५-२", "content_sanskrit": "धृष्टकेजुर्जयत्सेनो राजा चैव स सत्यजित्।\nदुर्योधनसुताश्चैव शकुनिश्चैव सौबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106819, "chapter_id": 3320, "verse_number": "१८-५-३", "content_sanskrit": "कर्णपुत्राश्च विक्रान्ता राजा चैव जयद्रथः।\nघटोत्कवादयश्चैव ये चान्ये नानुकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106820, "chapter_id": 3320, "verse_number": "१८-५-४", "content_sanskrit": "ये चान्ये कीर्तिता वीरा राजानो दीप्तमूर्तयः।\nस्वर्गे कालं कियन्तं ते तस्थुस्तदपि शंस मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106821, "chapter_id": 3320, "verse_number": "१८-५-५", "content_sanskrit": "आहोस्विच्छाश्वतं स्थानं तेषां तत्र द्विजोत्तम।\nअन्ते वा कर्मणां कां ते गतिं प्राप्ता नरर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106822, "chapter_id": 3320, "verse_number": "१८-५-६", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं प्रोच्यमानं द्विजोत्तम।\nतपसा हि प्रदीप्तेन सर्वं त्वमनुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106823, "chapter_id": 3320, "verse_number": "१८-५-७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106824, "chapter_id": 3320, "verse_number": "१८-५-७", "content_sanskrit": "इत्युक्तः स तु विप्रर्षिरनुज्ञातो महात्मना।\nव्यासेन तस्य नृपतेराख्यातुमुपचक्रमे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106825, "chapter_id": 3320, "verse_number": "१८-५-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106826, "chapter_id": 3320, "verse_number": "१८-५-८", "content_sanskrit": "गन्तव्यं कर्मणामन्ते सर्वेषां मनुजाधिप।\nशृणु गुह्यमिदं राजन्देवानां भरतर्षभ।\nयदुवाच महातेजा दिव्यचक्षुः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106827, "chapter_id": 3320, "verse_number": "१८-५-९", "content_sanskrit": "मुनिः पुराणः कौरव्य पाराशर्यो महाव्रतः।\nअगाधबुद्धिः सर्वज्ञो गतिज्ञः सर्वकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106828, "chapter_id": 3320, "verse_number": "१८-५-१०", "content_sanskrit": "तेनोक्तं कर्मणामन्ते प्रविशन्ति स्विकां तनुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106829, "chapter_id": 3320, "verse_number": "१८-५-११", "content_sanskrit": "वसूनेव महातेजा भीष्मः प्राप महाद्युतिः।\nअष्टावेव हि दृश्यन्ते वसवो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106830, "chapter_id": 3320, "verse_number": "१८-५-१२", "content_sanskrit": "बृहस्पतिं विवेशाथ द्रोणो ह्यङ्गिरसां वरम्।\nकृतवर्मा तु हार्दिक्यः प्रविवेश मरुद्गणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106831, "chapter_id": 3320, "verse_number": "१८-५-१३", "content_sanskrit": "सनत्कुमारं प्रद्युम्नः प्रविवेश यथागतम्।\nधृतराष्ट्रो धनेशस्य लोकान्प्राप दुरासदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106832, "chapter_id": 3320, "verse_number": "१८-५-१४", "content_sanskrit": "धृतराष्ट्रो सहिता गन्धारी च यशस्विनी।\nपत्नीभ्यां सहितः पाण्डुमहेन्द्रसदनं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106833, "chapter_id": 3320, "verse_number": "१८-५-१५", "content_sanskrit": "विराटद्रुपदौ चोभौ धृष्टकेतुश्च पार्थिवः।\nनिशठाक्रूरसाम्बाश्च भानुः कण्वो विदूरथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106834, "chapter_id": 3320, "verse_number": "१८-५-१६", "content_sanskrit": "भूरिश्रवाः शलश्चैव भूरिश्च पृथिवीपतिः।\nकंशश्चैवोग्रसेनश्च वसुदेवस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106835, "chapter_id": 3320, "verse_number": "१८-५-१७", "content_sanskrit": "उत्तरश्च सह भ्रात्रा शङ्खेन नरपुङ्गवः।\nविश्वेषां देवतानां ते विविशुर्नरसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106836, "chapter_id": 3320, "verse_number": "१८-५-१८", "content_sanskrit": "[वर्चा नाम महातेजाः सोमपुत्रः प्रतापवान्।\nसोभिमन्युर्नृसिंहस्य फल्गुनस्य सुतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106837, "chapter_id": 3320, "verse_number": "१८-५-१९", "content_sanskrit": "स युद्ध्वा क्षत्रधर्मेण यथा नान्यः पुमान्क्वचित्।]\nविवेश सोमं धर्मात्मा कर्मणोन्ते मरारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106838, "chapter_id": 3320, "verse_number": "१८-५-२०", "content_sanskrit": "आविवेश रविं कर्णो निहतः पुरुषर्षभ।\nद्वापरं शकुनिः प्राप धृष्टद्युम्नस्तु पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106839, "chapter_id": 3320, "verse_number": "१८-५-२१", "content_sanskrit": "धृतराष्ट्रात्मजाः सर्वे यातुधानान्प्रपेदिरे।\nधर्ममेवाविशत्क्षत्ता राजा चैव युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106840, "chapter_id": 3320, "verse_number": "१८-५-२२", "content_sanskrit": "अनन्तो भगवान्देवः प्रविवेश रसातलम्।\nपितामहनियोगाद्वै यो योगाद्गामधारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106841, "chapter_id": 3320, "verse_number": "१८-५-२३", "content_sanskrit": "यः स नारायणो नाम देवदेवः सनातनः।\nतस्यांशो वासुदेवस्तु कर्मणोन्ते विवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106842, "chapter_id": 3320, "verse_number": "१८-५-२४", "content_sanskrit": "षोडशस्त्रीसहस्राणि वासुदेवपरिग्रहाः।\nअमज्जंस्ताः सरस्वत्यां कालेन जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106843, "chapter_id": 3320, "verse_number": "१८-५-२५", "content_sanskrit": "तत्र त्यक्त्वा शरीराणि दिवमारुरुहुः पुनः।\nताश्चैवाप्सरसो भूत्वा वासुदेवमुपाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106844, "chapter_id": 3320, "verse_number": "१८-५-२६", "content_sanskrit": "हतास्तस्मिन्महायुद्धे ये वीरास्तु महारथाः।\nघटोत्कचादयश्चैव देवान्यक्षांश्च भेजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106845, "chapter_id": 3320, "verse_number": "१८-५-२७", "content_sanskrit": "दुर्योधनसहायाश्च राक्षसा येऽनुकीर्तिताः।\nप्राप्तास्ते क्रमशो राजन्सर्वलोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106846, "chapter_id": 3320, "verse_number": "१८-५-२८", "content_sanskrit": "भवनं च महेन्द्रस्य कुबेरस्य च धीमतः।\nवरुणस्य तथा लोकान्विविशुः पुरुषर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106847, "chapter_id": 3320, "verse_number": "१८-५-२९", "content_sanskrit": "एतत्ते सर्वमाख्यातं विस्तरेण महाद्युते।\nकुरूणां चरितं कृत्स्नं पाण्डवानां च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106848, "chapter_id": 3320, "verse_number": "१८-५-३०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106849, "chapter_id": 3320, "verse_number": "१८-५-३०", "content_sanskrit": "एतच्छ्रुत्वा द्विजश्रेष्ठात्स राजा जनमेजयः।\nविस्मितोऽभवदत्यर्थं यज्ञकर्मान्तरेष्वथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106850, "chapter_id": 3320, "verse_number": "१८-५-३१", "content_sanskrit": "ततः समापयामासुः कर्म तत्तस्य याजकाः।\nआस्तिकश्चाभवत्प्रीतः परिमोक्ष्य भुजङ्गमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106851, "chapter_id": 3320, "verse_number": "१८-५-३२", "content_sanskrit": "ततो द्विजातीन्सर्वास्तान्दक्षिणाभिरतोषयत्।\nपूजिताश्चापि ते राज्ञा ततो जग्मुर्यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106852, "chapter_id": 3320, "verse_number": "१८-५-३३", "content_sanskrit": "विसर्जयित्वा विप्रांस्तान्राजाऽपि जनमेजयः।\nहृष्टस्तक्षशिलायाः स पुनरायाद्गचाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106853, "chapter_id": 3320, "verse_number": "१८-५-३४", "content_sanskrit": "एतत्ते सर्वमाख्यातं वैशम्पायनकीर्तितम्।\nव्यासाज्ञया समाज्ञातं सर्पसत्रे नृपस्य हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106854, "chapter_id": 3320, "verse_number": "१८-५-३५", "content_sanskrit": "पुण्योऽयमितिहासाख्यः पवित्रं चेदमुत्तमम्।\nकृष्णेन मुनिना विप्र निर्मितं सत्यवादिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106855, "chapter_id": 3320, "verse_number": "१८-५-३६", "content_sanskrit": "सर्वज्ञेन विधिज्ञेन धर्मज्ञानवता सता।\nअतीन्द्रियेण शुचिना तपसा भावितात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106856, "chapter_id": 3320, "verse_number": "१८-५-३७", "content_sanskrit": "ऐश्वर्ये वर्तता चैव साङ्ख्ययोगवता तथा।\nनैकतन्त्रविबुद्धेन दृष्ट्वा दिव्येन चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106857, "chapter_id": 3320, "verse_number": "१८-५-३८", "content_sanskrit": "कीर्तिं प्रथयता लोके पाण्डवानां महात्मनाम्।\nअन्येषां क्षत्रियाणां च भूरिद्रविणतेजसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106858, "chapter_id": 3320, "verse_number": "१८-५-३९", "content_sanskrit": "`क्रीडां च वासुदेवस्य देवदेवस्य शाङ्गिणः।\nविश्वेषां देवभागानां जन्मसायुज्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2106859, "chapter_id": 3320, "verse_number": "१८-५-४०", "content_sanskrit": "य इदं शृणुयाद्विद्वान्पर्वसु द्विजसत्तमः।\nधूतपाप्मा जितस्वर्गो ब्रह्मभूयाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2106860, "chapter_id": 3320, "verse_number": "१८-५-४१", "content_sanskrit": "कार्ष्णं वेदमिमं सर्वं शृणुयाद्यः समाहितः।\nब्रह्महत्याकृतं पापं तत्क्षणादेव नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2106861, "chapter_id": 3320, "verse_number": "१८-५-४२", "content_sanskrit": "यश्चेदं श्रावयेच्छ्राद्धे ब्राह्मणान्पादमन्ततः।\nअक्षय्यमन्नपानं वै पितॄंस्तस्योपतदिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2106862, "chapter_id": 3320, "verse_number": "१८-५-४३", "content_sanskrit": "अह्ना यदेनः कुरुते इन्द्रियैर्मनसाऽपि वा।\nमहाभारतमाख्याय सर्पपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2106863, "chapter_id": 3320, "verse_number": "१८-५-४४", "content_sanskrit": "[यद्रात्रौ कुरुते पापं ब्राह्मणः स्त्रीगणैर्वृतः।\nमहाभारतमाख्याय पूर्वां सन्ध्यां प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2106864, "chapter_id": 3320, "verse_number": "१८-५-४५", "content_sanskrit": "महत्त्वाद्भारवत्त्वाच्च महाभारतमुच्यते।\nनिरुक्तमस्य यो वेद सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2106865, "chapter_id": 3320, "verse_number": "१८-५-४६", "content_sanskrit": "अष्टादशपुराणानि धर्मशास्त्राणि सर्वशः।\nवेदाः साङ्गास्तथैकत्र भारतं चैकतः स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2106866, "chapter_id": 3320, "verse_number": "१८-५-४७", "content_sanskrit": "श्रूयतां सिंहनादोऽयमृषेस्तस्य महात्मनः।\nअष्टादशपुराणानां कर्तुर्वेदमहोदधेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2106867, "chapter_id": 3320, "verse_number": "१८-५-४८", "content_sanskrit": "त्रिभिर्वर्षैर्महत्पुण्यं कृष्णद्वैपायनः प्रभुः।\nअखिलं भारतं चेदं चकार भगवान्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2106868, "chapter_id": 3320, "verse_number": "१८-५-४९", "content_sanskrit": "[आकर्ण्य भक्त्या सततं जयाख्यं भारतं महत्।\nश्रीश्च कीर्तिस्तथा विद्या भवन्ति सहिताः सदा॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2106869, "chapter_id": 3320, "verse_number": "१८-५-५०", "content_sanskrit": "धर्मे चार्थे च कामे च मोक्षे च भरतर्षभ।\nयदिहास्ति तदन्यत्र यन्नेहास्ति न कुत्रिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2106870, "chapter_id": 3320, "verse_number": "१८-५-५१", "content_sanskrit": "\"वाच्यते यत्र सततं जयाख्यं भारतं महत्।\nश्रीश्व कीर्तिश्च विद्या च भवन्ति मुदिताः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2106871, "chapter_id": 3320, "verse_number": "१८-५-५२", "content_sanskrit": "भारतस्य तु वक्तारं ब्रह्मर्षि च महागुरुम्॥\nवैशम्पायनमारोप्य स्वर्णभद्रासनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2106872, "chapter_id": 3320, "verse_number": "१८-५-५३", "content_sanskrit": "जनमेजयादिराजान आस्तिकाद्या द्विजातयः।\nधर्मदत्तादिवैश्याश्च सोम्यवंश्यादिशूद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2106873, "chapter_id": 3320, "verse_number": "१८-५-५४", "content_sanskrit": "प्रयुतं चायुतं चेति सहस्रं शतमित्यपि।\nदशकं चेति निष्काणामानर्चुस्तं महागुरुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2106874, "chapter_id": 3320, "verse_number": "१८-५-५५", "content_sanskrit": "निष्काणां दशकं दत्त्वा मृतपुत्रोऽमृतप्रजः।\nऊष्मादिव्याधियुक्तश्च शतं दत्त्वा निरामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2106875, "chapter_id": 3320, "verse_number": "१८-५-५६", "content_sanskrit": "सहस्रदानात्संतानहीनः संतानपुत्रवान्।\nआयुरारोग्यमैश्वर्यं भेजुस्तेऽन्नं च पुत्रकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2106876, "chapter_id": 3320, "verse_number": "१८-५-५७", "content_sanskrit": "सुवर्णं रजतं रत्नं सर्वाण्याभरणानि च।\nसर्वोपकरणैर्युक्तं निधिनिक्षेपसंयुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2106877, "chapter_id": 3320, "verse_number": "१८-५-५८", "content_sanskrit": "इष्टकाभित्तिसंयुक्तमग्निबाधादिवर्जितम्।\nदेवपूजाग्निहोत्रादिपाठार्थगृहसंयुतम्।\nसान्तर्बहिस्संवरणं सप्रासादं सगोगृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2106878, "chapter_id": 3320, "verse_number": "१८-५-५९", "content_sanskrit": "व्यष्ट्या समष्ट्या वा दद्यात्स्वर्गारोहणपर्वणि।\nनिवृत्तिकामो दद्याच्चेत्पुनर्जन्म न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2106879, "chapter_id": 3320, "verse_number": "१८-५-६०", "content_sanskrit": "सकामश्चेद्ब्रह्मकल्पं सुकं ब्रह्मगृहे वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2106880, "chapter_id": 3320, "verse_number": "१८-५-६१", "content_sanskrit": "पुराणमुखतो यस्माद्वेदान्तज्ञानमाप्यते।\nस तेन गुरुराख्यातस्तत्पूजा हीशपूजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2106881, "chapter_id": 3320, "verse_number": "१८-५-६२", "content_sanskrit": "भारतस्य तु वक्तारं श्रोतारं लेखकांस्तदा।\nप्रपूजयन्ति संहृष्टाः सिद्धाश्च परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2106882, "chapter_id": 3320, "verse_number": "१८-५-६३", "content_sanskrit": "महाभारतवक्तारं नार्चयन्तीह ये नराः।\nतेषां सर्वक्रियाहानिर्भवेद्देवाः शपन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2106883, "chapter_id": 3320, "verse_number": "१८-५-६४", "content_sanskrit": "जयो नामेतिहासोऽयं श्रोतव्यो जयमिच्छता।\nराज्ञा राजसुतैश्चैव गर्भिण्या चैव योषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2106884, "chapter_id": 3320, "verse_number": "१८-५-६५", "content_sanskrit": "[स्वर्गकामो लभेत्स्वर्गं जयकामो लभेज्जयम्।\nगर्भिणी लभते पुत्रं कन्यां वा बहुभागिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2106885, "chapter_id": 3320, "verse_number": "१८-५-६६", "content_sanskrit": "अनागतश्च मोक्षश्च कृष्णद्वैपायनः प्रभुः।\nसंदर्भं भारतस्यास्य कृतवान्धर्मकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2106886, "chapter_id": 3320, "verse_number": "१८-५-६७", "content_sanskrit": "षष्टिं शतसहस्राणि चकारान्यां स संहिताम्।\nत्रिंशच्छतसहस्राणि देवलोके प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2106887, "chapter_id": 3320, "verse_number": "१८-५-६८", "content_sanskrit": "पित्र्ये पञ्चदशं ज्ञेयं यक्षलोके चतुर्दश।\nएकं शतसहस्रं तु मानुषेषु प्रभाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2106888, "chapter_id": 3320, "verse_number": "१८-५-६९", "content_sanskrit": "नारदोऽश्रावयद्देवानसितो देवलः पितॄन्।\nरक्षोयक्षाञ्शुको मर्त्यान्वैशम्पायन एव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2106889, "chapter_id": 3320, "verse_number": "१८-५-७०", "content_sanskrit": "इतिहासमिमं पुण्यं महार्थं वेदसंमितम्।\nव्यासोक्तं श्रूयते येन कृत्वा ब्राह्म्णमग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2106890, "chapter_id": 3320, "verse_number": "१८-५-७१", "content_sanskrit": "स नरः सर्वकामांश्च कीर्तिं प्राप्येह शौनक।\nगच्छेत्परमिकां सिद्धिमत्र मे नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2106891, "chapter_id": 3320, "verse_number": "१८-५-७२", "content_sanskrit": "भारताध्ययनात्पुण्यादपि पादमधीयतः।\nश्रद्धया परया भक्त्या श्राव्यते चापि येन तु।\nय इमां संहितां पुण्यां पुत्रमध्यापयच्छुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2106892, "chapter_id": 3320, "verse_number": "१८-५-७३", "content_sanskrit": "मातापितृसहस्राणि पुत्रदारशतानि च।\nसंसारेष्वनुभूतानि यान्ति यास्यन्ति चापरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2106893, "chapter_id": 3320, "verse_number": "१८-५-७४", "content_sanskrit": "हर्षस्थानसहस्राणि भयस्थानशतानि च।\nदिवसेदिवसे मूढमाविशन्ति न पण्डितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2106894, "chapter_id": 3320, "verse_number": "१८-५-७५", "content_sanskrit": "ऊर्ध्वबाहुर्विरौम्येष न च कश्चिच्छृणोति मे।\nधर्मादर्थश्च कामश्च स किमर्थं न सेव्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2106895, "chapter_id": 3320, "verse_number": "१८-५-७६", "content_sanskrit": "न जातु कामान्न भयान्न लोभा-\nद्धर्मं त्यजेज्जीवितस्यापि हेतोः।\nनित्यो धर्मः सुखदुःखे त्वनिथ्ये\nजीवो नित्यो हेतुरस्य त्वनित्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2106896, "chapter_id": 3320, "verse_number": "१८-५-७७", "content_sanskrit": "इमां भारतसावित्रीं प्रातरुत्थायः यः पठेत्।\nस भारतफलं प्राप्य परं ब्रह्माधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2106897, "chapter_id": 3320, "verse_number": "१८-५-७८", "content_sanskrit": "कयथा समुद्रो भगवान्यथा हि हिमवान्गिरिः।\nख्यातावुभौ रत्ननिधी तथा भारतमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2106898, "chapter_id": 3320, "verse_number": "१८-५-७९", "content_sanskrit": "कार्ष्णं देवमिमं विद्वाञ्श्रावयित्वाऽर्थमश्नुते।\nइदं भारतमाख्यानं यः पठेत्सुसमाहितः।\nस गच्छेत्परमां सिद्धिमिति मे नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2106899, "chapter_id": 3320, "verse_number": "१८-५-८०", "content_sanskrit": "द्वैपायनोष्ठपुटनिस्सृतमप्रमेयं\nपुण्यं पवित्रमथ पापहरं शिवं च।\nयो भारतं समधिगच्छति वाच्यमानं\nकिं तस्य पुष्करजलैरभिषेचनेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2106900, "chapter_id": 3320, "verse_number": "१८-५-८१", "content_sanskrit": "यो गोशतं कनकशृङ्गमयं ददाति\nविप्राय वेदविदुषे सुबहुश्रुताय।\nपुण्यां च भारतकथां सततं शृणोति\nतुल्यं फलं भवति तस्य च तस्य चैव॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2106901, "chapter_id": 3320, "verse_number": "१८-५-८२", "content_sanskrit": "\"यद्यदिष्टतमं कामं लभते श्रद्धयाऽन्वितः।\nशृणुयान्मुदितो भूत्वा आस्तिको बुद्धिसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2106902, "chapter_id": 3320, "verse_number": "१८-५-८३", "content_sanskrit": "वासुदेवं स्मरन्विद्वान्पुण्डरीकायतेक्षणम्।\nइतिहासमिमं पुण्यं महार्थं वेदसंमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2106903, "chapter_id": 3320, "verse_number": "१८-५-८४", "content_sanskrit": "श्रावयेद्यस्तु वर्णादीन्कृत्वा ब्राह्मणमग्रतः।\nसर्वपापविशुद्धात्मा शुचिस्तद्गतमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2106904, "chapter_id": 3320, "verse_number": "१८-५-८५", "content_sanskrit": "इह कीर्तिं महत्प्राप्य भोगवान्सुखमश्नुते।\nव्यासप्रसादेन पुनः स्वर्गलोकं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2106905, "chapter_id": 3320, "verse_number": "१८-५-८६", "content_sanskrit": "एतद्विदित्वा सर्वं तु सर्ववेदार्थविद्भवेत्।\nपूजनीयश्च सततं माननीयो भवेद्द्विजः॥\" ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]