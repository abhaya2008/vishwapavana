[{"id": 900002290, "chapter_id": 8261, "verse_number": "6.1", "content_sanskrit": "जानश्रुतिर्हि पौत्रायणः श्रद्धादेयो बहुदायी बहुवाक्य आस", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002291, "chapter_id": 8261, "verse_number": "6.2", "content_sanskrit": "तदु ह जानश्रुतिः पौत्रायणः षट् शतानि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002292, "chapter_id": 8261, "verse_number": "6.3", "content_sanskrit": "वायुर्वाव संवर्गो यदा वा महाप्रलये अग्निरुद्वायति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002293, "chapter_id": 8261, "verse_number": "6.4", "content_sanskrit": "सत्यकामो ह जाबालो जबालां मातरमामन्त्रयाञ्चक्रे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002294, "chapter_id": 8261, "verse_number": "6.5", "content_sanskrit": "अथ हैनमृषभोऽभ्युवाद सत्यकामा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002295, "chapter_id": 8261, "verse_number": "6.6", "content_sanskrit": "उपकोसलो ह वै कामलायनः सत्यकामे जाबाले ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002296, "chapter_id": 8261, "verse_number": "6.7", "content_sanskrit": "अथ हैनं गार्हपत्योऽनुशशास पृथिव्यग्निरन्नमादित्य इति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002297, "chapter_id": 8261, "verse_number": "6.8", "content_sanskrit": "ते होचुरुपकोसलैषा सोम्य तेऽस्मद्विद्यात्मविद्या ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002298, "chapter_id": 8261, "verse_number": "6.9", "content_sanskrit": "य एषोऽन्तरक्षिणि पुरुषो दृश्यते एष आत्मेति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002299, "chapter_id": 8261, "verse_number": "6.10", "content_sanskrit": "एष ह वै यज्ञो योऽयं पवत एष यन्निदं सर्वं पुनाति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002300, "chapter_id": 8261, "verse_number": "6.11", "content_sanskrit": "प्रजापतिर्लोकानभ्यतपत् तेषां तप्यमानानां रसान् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]