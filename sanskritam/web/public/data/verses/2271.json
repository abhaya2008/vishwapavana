[{"id": 2058969, "chapter_id": 2271, "verse_number": "७-१९८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058970, "chapter_id": 2271, "verse_number": "७-१९८-१", "content_sanskrit": "अर्जुनस्य वचः श्रुत्वा नोचुस्तत्र महारथाः।\nअप्रियं वा प्रियं वाऽपि महाराज धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058971, "chapter_id": 2271, "verse_number": "७-१९८-२", "content_sanskrit": "ततः क्रुद्धो महाबाहुर्भीमसेनोऽभ्यभाषत।\nकुत्सयन्निव कौन्तेयमर्जुनं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058972, "chapter_id": 2271, "verse_number": "७-१९८-३", "content_sanskrit": "मुनिर्यथाऽरण्यगतो भाषते धर्मसंहितम्।\nन्यस्तदण्डो यथा पार्थं ब्राह्मणः संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058973, "chapter_id": 2271, "verse_number": "७-१९८-४", "content_sanskrit": "क्षतत्राता क्षताज्जीवन्क्षन्ता स्त्रीष्वपि साधुषु।\nक्षत्रियः क्षितिमाप्नोति क्षिप्रं धर्मं यशः श्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058974, "chapter_id": 2271, "verse_number": "७-१९८-५", "content_sanskrit": "स भवान्क्षत्रियगुणैर्युक्तः सर्वैः कुलोद्वहः।\nअविपश्चिद्यथा वाचं व्याहरन्नाद्य शोभसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058975, "chapter_id": 2271, "verse_number": "७-१९८-६", "content_sanskrit": "पराक्रमस्ते कौन्तेय शक्रस्येव शचीपतेः।\nन चातिवर्तसे धर्मं वेलामिव महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058976, "chapter_id": 2271, "verse_number": "७-१९८-७", "content_sanskrit": "न पूजयेत्त्वां कोन्वद्य यत्त्रयोदशवार्षिकम्।\nअमर्षं पृष्ठतः कृत्वा धर्ममेवाभिकाङ्क्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058977, "chapter_id": 2271, "verse_number": "७-१९८-८", "content_sanskrit": "दिष्ट्या तात मनस्तेऽद्य स्वधर्ममनुवर्तते।\nआनृशंस्ये च ते दिष्ट्या बुद्धिः सततमच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058978, "chapter_id": 2271, "verse_number": "७-१९८-९", "content_sanskrit": "यत्तु धर्मप्रवृत्तस्य हृतं राज्यमधर्मतः।\nद्रौपदी च परामृष्टा सभामानीय शत्रुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058979, "chapter_id": 2271, "verse_number": "७-१९८-१०", "content_sanskrit": "वनं प्रव्राजिताश्चास्म वल्कलाजिनवाससः।\nअनर्हमाणास्तं भावं त्रयोदश समाः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058980, "chapter_id": 2271, "verse_number": "७-१९८-११", "content_sanskrit": "`बहूनि क्षाम्य शत्रूणां सत्यधर्मरता वयम्।\nतथा तन्मर्षयित्वा तु यथा ते उत्पथे स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058981, "chapter_id": 2271, "verse_number": "७-१९८-१२", "content_sanskrit": "एतान्यमर्षस्थानानि मर्षितानि त्वयाऽघन।\nक्षत्रधर्मप्रसक्तेन सर्वमेतदनुष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058982, "chapter_id": 2271, "verse_number": "७-१९८-१३", "content_sanskrit": "तमधर्ममपाकृष्टं स्मृत्वाऽद्य सहितस्त्वया।\nसानुबन्धान्हनिष्यामि क्षुद्रान्राज्यहरानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058983, "chapter_id": 2271, "verse_number": "७-१९८-१४", "content_sanskrit": "त्वया हि कथितं पूर्वं युद्धायाभ्यागता वयम्।\nघटामहे यथाशक्ति त्वं तु नोऽद्य जुगुप्ससे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058984, "chapter_id": 2271, "verse_number": "७-१९८-१५", "content_sanskrit": "स्वधर्मं नेच्छसे ज्ञातुं वृथा वचनमेव ते।\nभयार्दितानामस्माकं वाचा मर्माणि कृन्तसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058985, "chapter_id": 2271, "verse_number": "७-१९८-१६", "content_sanskrit": "वपन्व्रणे क्षारमिव क्षतानां शत्रुकर्शन।\nविदीर्यते मे हृदयं त्वया वाक्शल्यपीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058986, "chapter_id": 2271, "verse_number": "७-१९८-१७", "content_sanskrit": "अधर्ममेन विपुलं धार्मिकः सन्न बुध्यसे।\nयत्त्वमात्मानमस्मांश्च प्रशंस्यान्न प्रशंससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058987, "chapter_id": 2271, "verse_number": "७-१९८-१८", "content_sanskrit": "वासुदेवे स्थिते चापि द्रोणपुत्रं प्रशंससि।\nयः कलां षोडशीं पूर्णां धनञ्जय न तेऽर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058988, "chapter_id": 2271, "verse_number": "७-१९८-१९", "content_sanskrit": "स्वयमेवात्मनो दोषान्ब्रुवाणः किं न लज्जसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058989, "chapter_id": 2271, "verse_number": "७-१९८-२०", "content_sanskrit": "`मम नागायुतं पार्थ बलं बाह्वोर्विधीयते।\nदारयेयं महीं क्रोधाद्विकिरेयं च पर्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058990, "chapter_id": 2271, "verse_number": "७-१९८-२१", "content_sanskrit": "आविध्यैतां गदां गुर्वी भीमां काञ्चनमालिनीम्।\nगिरिप्रकाशान्क्षितिजान्भञ्जेयमनिलो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058991, "chapter_id": 2271, "verse_number": "७-१९८-२२", "content_sanskrit": "द्रावयेयं शरैश्चापि सेन्द्रान्देवान्समागतान्।\nसराक्षसगणान्पार्थ सासुरोरगमानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058992, "chapter_id": 2271, "verse_number": "७-१९८-२३", "content_sanskrit": "स त्वमेवंविधं जानन्भ्रातरं मां नरर्षभ।\nद्रोणपुत्राद्भयं कर्तुं नार्हस्यमितविक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058993, "chapter_id": 2271, "verse_number": "७-१९८-२४", "content_sanskrit": "अथवा तिष्ठ बीभत्सो सह सर्वैः सहोदरैः।\nअहमेनं गदापाणिर्जेष्याम्येको महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058994, "chapter_id": 2271, "verse_number": "७-१९८-२५", "content_sanskrit": "ततः पाञ्चालराजस्य पुत्रः पार्थमथाब्रवीत्।\nसङ्क्रुद्धमिव नर्दन्तं हिरण्यकशिपुर्हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058995, "chapter_id": 2271, "verse_number": "७-१९८-२६x", "content_sanskrit": "धृष्टद्युम्न उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058996, "chapter_id": 2271, "verse_number": "७-१९८-२६", "content_sanskrit": "बीभत्सो विप्रकर्माणि विहितानि मनीषिभिः।\nयाजनाध्यापने दानं यथा यज्ञप्रतिग्रहौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058997, "chapter_id": 2271, "verse_number": "७-१९८-२७", "content_sanskrit": "षष्ठमध्ययनं नाम तेषां कस्मिन्प्रतिष्ठितः।\nहतो द्रोणो मया ह्येवं किं मां पार्थ विगर्हसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058998, "chapter_id": 2271, "verse_number": "७-१९८-२८", "content_sanskrit": "अपक्रान्तः स्वधर्माच्च क्षात्रधर्मं व्यपाश्रितः।\nअधर्मेण हतस्तस्मादस्त्रेण क्षुद्रकर्मकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058999, "chapter_id": 2271, "verse_number": "७-१९८-२९", "content_sanskrit": "तथा मायां प्रयुञ्जानमसह्यं ब्राह्मणब्रुवम्।\nप्रतिमायी निहन्याद्यो न युक्तं पार्थ तत्र किम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2059000, "chapter_id": 2271, "verse_number": "७-१९८-३०", "content_sanskrit": "तस्मिंस्तथा मया शस्ते यदि द्रौणायनी रुषा।\nकुरुते भैरवं नादं तत्र किं मम हीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2059001, "chapter_id": 2271, "verse_number": "७-१९८-३१", "content_sanskrit": "न चाद्भुतमिदं मन्ये यद्द्रौणिश्चात्र गर्जति।\nघातयिष्यति कौरव्यान्परित्रातुमशक्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2059002, "chapter_id": 2271, "verse_number": "७-१९८-३२", "content_sanskrit": "यच्च मां धार्मिको भूत्वा ब्रवीषि गुरुघातिनम्।\nतदर्थमहमुत्पन्नः पाञ्चाल्यस्य सुतोऽनलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2059003, "chapter_id": 2271, "verse_number": "७-१९८-३३", "content_sanskrit": "यस्य कार्यमकार्यं वा युध्यतः स्यात्समं रणे।\nतं कथं ब्राह्मणं ब्रूयाः क्षत्रियं वा धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2059004, "chapter_id": 2271, "verse_number": "७-१९८-३४", "content_sanskrit": "यो ह्यनस्त्रविदो हन्याद्ब्रह्मास्त्रैः क्रोधमूर्च्छितः।\nसर्वोपायैर्न स कथं वध्यः पुरुषसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2059005, "chapter_id": 2271, "verse_number": "७-१९८-३५", "content_sanskrit": "विशेषात्पितृहन्ता मे न स वध्यः कथं मया।\nयोऽयं पापः सुदुर्मेधा बान्धवान्युधि जघ्निवान्।\nतस्य विप्रब्रुववधे कथं पापं भवेन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2059006, "chapter_id": 2271, "verse_number": "७-१९८-३६", "content_sanskrit": "विधर्मिणं धर्मविद्भिः प्रोक्तं तेषां विषोपमम्।\nजानन्धर्मार्थतत्त्वज्ञ किं मामर्जुन गर्हसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2059007, "chapter_id": 2271, "verse_number": "७-१९८-३७", "content_sanskrit": "नृशंसः स मयाऽऽक्रम्य रथ एव निपातितः।\nतन्मामनिन्द्यं बीभत्सो किमर्थं नाभिनन्दसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2059008, "chapter_id": 2271, "verse_number": "७-१९८-३८", "content_sanskrit": "कालानलसमं पार्थ ज्वलार्कविषोपमम्।\nभीमं द्रोणशिरश्छिन्नं न प्रशंससि मे कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2059009, "chapter_id": 2271, "verse_number": "७-१९८-३९", "content_sanskrit": "योऽसौ ममैव नान्यस्य बान्धवान्युधि जघ्निवान्।\nछित्त्वाऽपि तस्य मूर्धानं नैवास्मि विगतज्वरेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2059010, "chapter_id": 2271, "verse_number": "७-१९८-४०", "content_sanskrit": "तच्च मे कृन्तते मर्म यन्न तस्य शिरो मया।\nनिषादविषये क्षिप्तं जयद्रथशिरो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2059011, "chapter_id": 2271, "verse_number": "७-१९८-४१", "content_sanskrit": "अथावधश्च शत्रूणामधर्मः श्रूयतेऽर्जुन।\nक्षत्रियस्य हि धर्मोऽयं हन्याद्धन्येत वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2059012, "chapter_id": 2271, "verse_number": "७-१९८-४२", "content_sanskrit": "स शत्रुर्निहतः सङ्ख्ये मया धर्मेण पाण्डव।\nयथा त्वया हतः शूरो भगदत्तः पितुः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2059013, "chapter_id": 2271, "verse_number": "७-१९८-४३", "content_sanskrit": "पितामहं रणे हत्वा मन्यसे धर्ममात्मनः।\nमया शत्रौ हते कस्मात्पापे धर्मं न मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2059014, "chapter_id": 2271, "verse_number": "७-१९८-४४", "content_sanskrit": "सम्बन्धावनतं पार्थ न मां त्वं वक्तुमर्हसि।\nस्वगात्रकृतसोपानं निषण्णमिव दन्तिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2059015, "chapter_id": 2271, "verse_number": "७-१९८-४५", "content_sanskrit": "क्षमामि ते सर्वमेव वाग्व्यतिक्रममर्जुन।\nद्रौपद्या द्रौपदेयानां कृते नान्येन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2059016, "chapter_id": 2271, "verse_number": "७-१९८-४६", "content_sanskrit": "कुलक्रमागतं वैरं ममाचार्येण विश्रुतम्।\nतथा जानात्ययं लोको न यूयं पाण्डुनन्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2059017, "chapter_id": 2271, "verse_number": "७-१९८-४७", "content_sanskrit": "नानृती पाण्डवो ज्येष्ठो नाहं वाऽधार्मिकोऽर्जुन।\n`न क्षत्रिय इति प्राहुर्यो न हन्ति रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2059018, "chapter_id": 2271, "verse_number": "७-१९८-४८", "content_sanskrit": "पितरं वा गुरुं वाऽपि जिघांसु पुत्रशिष्ययोः।\nजिह्मेन वाऽप्यजिह्मेन हन्यादेवाविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2059019, "chapter_id": 2271, "verse_number": "७-१९८-४९", "content_sanskrit": "इत्युक्तं ब्रह्मणा पूर्वं क्षत्रियाणां द्विषद्वधे।\nतस्माच्छिष्येण निहतः शत्रुर्मे ब्राह्मणब्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2059020, "chapter_id": 2271, "verse_number": "७-१९८-५०", "content_sanskrit": "यः क्षत्रियसुतो हन्यात्पितरं वा गुरुं च वा।\nअनिष्टं क्षत्रियो हन्यात्स वै क्षत्रिय उच्यते।\nशिष्यद्रोही हतः पापो युध्यस्व विजयस्तव॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2059021, "chapter_id": 2271, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि नारायणास्त्रमोक्षपर्वणि अष्टनवत्यधिकशततमोऽध्यायः॥ १९८ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१९८-२५ हिरण्यकशिपुं हरिरिति क.ख.पाठः॥ ५-१९८-१९८ अष्टनवत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]