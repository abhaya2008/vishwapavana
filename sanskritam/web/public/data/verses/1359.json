[{"id": 2017258, "chapter_id": 1359, "verse_number": "२-१००-१", "content_sanskrit": "युधिष्ठिर उवाच॥\nआमन्त्रयामि भरतांस्तथा वृद्धं पितामहम्॥\nराजानं सोमदत्तं च महाराजं च बाह्लिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017259, "chapter_id": 1359, "verse_number": "२-१००-२", "content_sanskrit": "द्रोणं कृपं नृपांश्चान्यानश्वत्थामानमेव च।\nविदुरं धृतराष्ट्रं च धार्तराष्ट्रांश्च सर्वशः॥ २-१००-३aसौमदत्तिं महावीर्यं विकर्णं च महामतिम्।\nयुयुत्सुं सञ्जयं चैव तथैवान्यान्सभासदः॥ २-१००-४aगान्धारीं च महाभागां मातरं च तथा पृथाम्।\nसर्वानामन्त्र्य गच्छामि द्रष्टाऽस्मि पुनरेत्य वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017260, "chapter_id": 1359, "verse_number": "२-१००-५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017261, "chapter_id": 1359, "verse_number": "२-१००-५", "content_sanskrit": "न च किञ्चिदथोचुस्तं ह्रियाऽऽसन्ना युधिष्ठिरम्।\nमनोभिरेव कल्याणं दध्युस्ते तस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017262, "chapter_id": 1359, "verse_number": "२-१००-६x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017263, "chapter_id": 1359, "verse_number": "२-१००-६", "content_sanskrit": "आर्या पृथा राजपुत्री नारण्यं गन्तुमर्हति।\nसुकुमारी च वृद्धा च नित्यं चैव सुखोचिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017264, "chapter_id": 1359, "verse_number": "२-१००-७", "content_sanskrit": "इह वत्स्यति कल्याणी सत्कृता मम वेश्मनि।\nइति पार्था विजानीध्वमगदं वोऽस्तु सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017265, "chapter_id": 1359, "verse_number": "२-१००-८x", "content_sanskrit": "पाण्डवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017266, "chapter_id": 1359, "verse_number": "२-१००-८", "content_sanskrit": "तथेत्युक्त्वाऽब्रुवन्सर्वे यथा नो वदसेऽनघ।\nत्वं पितृव्यः पितृसमो वयं च त्वत्परायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017267, "chapter_id": 1359, "verse_number": "२-१००-९", "content_sanskrit": "यथाऽऽज्ञापयसे विद्वंस्त्वं हि नः परमो गुरुः।\nयच्चान्यदपि कर्तव्यं तद्विधत्स्व महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017268, "chapter_id": 1359, "verse_number": "२-१००-१०x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017269, "chapter_id": 1359, "verse_number": "२-१००-१०", "content_sanskrit": "युधिष्ठिर विजानीहि ममेदं भरतर्षभ।\nनाधर्मेण जितः कश्चिद्व्यथते वै पराजये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017270, "chapter_id": 1359, "verse_number": "२-१००-११", "content_sanskrit": "त्वं वै धर्मं विजानीषे युद्धे जेता धनञ्जयः।\nहन्ताऽरीणां भीमसेनो नकुलस्त्वर्थसङ्ग्रही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017271, "chapter_id": 1359, "verse_number": "२-१००-१२", "content_sanskrit": "संयन्ता सहदेवस्तु धौम्यो ब्रह्मविदुत्तमः।\nधर्मार्थकुशला चैव द्रौपदी धर्मचारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017272, "chapter_id": 1359, "verse_number": "२-१००-१३", "content_sanskrit": "अन्योन्यस्य प्रियाः सर्वे तथैव प्रियदर्शनाः।\nपरैरभेद्याः सन्तुष्टाः को वोन न स्पृहयेदिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017273, "chapter_id": 1359, "verse_number": "२-१००-१४", "content_sanskrit": "एष वै सर्वकल्याणः समाधिस्तव भारत।\nनैनं शत्रुर्विषहते शक्रेणापि समोऽप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017274, "chapter_id": 1359, "verse_number": "२-१००-१५", "content_sanskrit": "हिमवत्यनुशिष्टोऽसि मेरुसावर्णिना पुरा।\nद्वैपायनेन कृष्णेन नगरे वारणावते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017275, "chapter_id": 1359, "verse_number": "२-१००-१६", "content_sanskrit": "भृगुतुङ्गे च रामेण दृष्टद्वत्यां च शम्भुना।\nअश्रौषीरसि तस्यापि महर्षेरञ्जनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017276, "chapter_id": 1359, "verse_number": "२-१००-१७", "content_sanskrit": "कल्माषीतीरसंस्थस्य गतस्त्वं शिष्यतां भृगोः।\nद्रष्टा सदा नारदस्ते धौम्यस्तेऽयं पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017277, "chapter_id": 1359, "verse_number": "२-१००-१८", "content_sanskrit": "माहासीः साम्पराये त्वं बुद्धिं तामृषिपूजिताम्।\nपुरूरवसमैलं त्वं बुद्ध्या जयसि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017278, "chapter_id": 1359, "verse_number": "२-१००-१९", "content_sanskrit": "शक्त्या जयसि राज्ञोऽन्यानृषीन्धर्गोपसेवया।\nऐन्द्रे जये धृतमना याम्ये कोपविधारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017279, "chapter_id": 1359, "verse_number": "२-१००-२०", "content_sanskrit": "तथा विसर्गे कौबेरे वारुणे कोपविधारणे॥\nआत्मप्रदानं सौम्यत्वमद्भ्यश्चैवोपजीवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017280, "chapter_id": 1359, "verse_number": "२-१००-२१", "content_sanskrit": "भूमेः क्षमा च तेजश्च समग्रं सूर्यमण्डलात्।\nवायोर्बलं प्राप्नुहि त्वं भूतेभ्यश्चात्मसम्पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017281, "chapter_id": 1359, "verse_number": "२-१००-२२", "content_sanskrit": "अगदं वोऽस्तु भद्रं वो द्रष्टाऽस्मि पुनरागतान्।\nआपद्धर्मार्थकृच्छ्रेषु सर्वकार्येषु वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017282, "chapter_id": 1359, "verse_number": "२-१००-२३", "content_sanskrit": "यथावत्प्रतिपद्येथाः काले काले युधिष्ठिर।\nआपृष्टोऽसीह कौन्तेय स्वस्ति प्राप्नुहि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017283, "chapter_id": 1359, "verse_number": "२-१००-२४", "content_sanskrit": "कृतार्थं स्वस्मिमन्तं त्वां द्रक्ष्यामः पुनरागतम्।\nन हि वो वृजिनं किञ्चिद्वेद कश्चित्पुराकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017284, "chapter_id": 1359, "verse_number": "२-१००-२५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017285, "chapter_id": 1359, "verse_number": "२-१००-२५", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा पाण्डवः सत्यविक्रमः।\nभीष्मद्रोणौ नमस्कृत्य प्रातिष्ठत युधिष्ठिरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017286, "chapter_id": 1359, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अनुद्यातपर्वणि शततमोऽध्यायः॥ १००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]