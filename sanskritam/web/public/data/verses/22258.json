[{"id": 7002258000, "chapter_id": 22258, "verse_number": "३०३-१", "content_sanskrit": "अग्निरुवाच ।\nयदा जन्मर्क्षगश्चन्द्रो भानुः सप्तमराशिगः ।\nपौष्णः कालः स विज्ञेयस्तदा ग्रासं परीक्षयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002258001, "chapter_id": 22258, "verse_number": "३०३-२", "content_sanskrit": "कण्ठेष्ठै चलतः स्थानाद्यस्य वक्रा च नासिका ।\nकृष्णा च जिह्वा सप्ताहं जीवितं तस्य वै भवेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002258002, "chapter_id": 22258, "verse_number": "३०३-३", "content_sanskrit": "तारो मेषो विषं दन्ती नरो दीर्घो घणा रसः ।\nक्रुद्धोल्काय महोल्काय वीरोत्लाय शिखा भवेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002258003, "chapter_id": 22258, "verse_number": "३०३-४", "content_sanskrit": "ह्यल्काय सहसोल्काय वैष्णवोष्टाक्षरो मनुः ।\nकनिष्ठादितदष्टानामङ्गुलीनाञ्च पर्वसु ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002258004, "chapter_id": 22258, "verse_number": "३०३-५", "content_sanskrit": "ज्येष्ठाग्रेण क्रमात्तावन् मूर्द्धन्यष्टाक्षरं न्यसेत् ।\nतर्ज्जन्यान्तारमङ्गुष्ठे लग्ने मध्यमया च तत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002258005, "chapter_id": 22258, "verse_number": "३०३-६", "content_sanskrit": "तलेङ्गुष्ठे तदुत्तारं वीजोत्तारं ततो न्यसेत् ।\nरक्तगौरधूम्रहरिज्जातरूपाः सितास्त्रथः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002258006, "chapter_id": 22258, "verse_number": "३०३-७", "content_sanskrit": "एवं रूपानिमान् वर्णान् भाववुद्धान्न्यसेत् क्रमात् ।\nहृदास्यनेत्रमूर्द्धाङ्घ्रितालुगुह्यकरादिषु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002258007, "chapter_id": 22258, "verse_number": "३०३-८", "content_sanskrit": "अङ्गानि च न्यसेद्वीजान्न्यस्याथ करदेहयोः ।\nयथात्मनि तथा देवेन्यासः सार्य्यः करं विना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002258008, "chapter_id": 22258, "verse_number": "३०३-९", "content_sanskrit": "हृदादिस्थानगान् वर्णान् गन्धपुष्पैः समर्च्चयेत् ।\nधर्म्माद्यग्न्याद्यधर्मादि गात्रे पीठेऽम्बुजे न्यसेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002258009, "chapter_id": 22258, "verse_number": "३०३-१०", "content_sanskrit": "यत्र केशरकिञ्चल्कव्यापिसूर्य्येन्दुदाहिनां ।\nमण्डलन्त्रितयन्तावद् भेदैस्तत्र न्यसेत् क्रमात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002258010, "chapter_id": 22258, "verse_number": "३०३-११", "content_sanskrit": "गुणाश्च तन्त्रसत्वाद्याः केशरम्थाश्च शक्तयः ।\nविमलोत्कर्षणीज्ञानक्रियायोगाश्च वै क्रमात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002258011, "chapter_id": 22258, "verse_number": "३०३-१२", "content_sanskrit": "प्रह्वी सत्या तथेशानानुग्रहा मध्यतस्ततः ।\nयोगपीठं समभ्यर्च्य समावाह्य हरिं यजेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002258012, "chapter_id": 22258, "verse_number": "३०३-१३", "content_sanskrit": "पाद्यार्घ्याचमनीयञ्च पीतवस्त्रविभूषणं ।\nयोगपीठं समभ्यर्च्य समावाह्य हरिं यजेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002258013, "chapter_id": 22258, "verse_number": "३०३-१४", "content_sanskrit": "वासुदेवादयः पूज्याश्चत्वारो दिक्षु मूर्त्तयः ।\nविदिक्षु श्रईसरस्वत्यै रतिशान्त्यै च पूजयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002258014, "chapter_id": 22258, "verse_number": "३०३-१५", "content_sanskrit": "शङ्खं चक्रं गदां पद्मं मुषलं खड्गशार्ङ्गिके ।\nवनमालान्वितं दिक्षु विदिक्षु च यजेत् क्रमात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002258015, "chapter_id": 22258, "verse_number": "३०३-१६", "content_sanskrit": "अब्यर्च्य च चवहिस्तार्क्ष्यं देवस्य पुरतोऽर्च्चयेत् ।\nविश्वक्सेनञ्च सोमेशं मध्ये आवरणाद्वहिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002258016, "chapter_id": 22258, "verse_number": "३०३-१७", "content_sanskrit": "इन्द्रादिपरिचारेण पूज्य सर्व्वमवाप्नुयात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]