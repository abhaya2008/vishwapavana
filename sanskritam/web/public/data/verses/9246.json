padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 40016344, "chapter_id": 9246, "verse_number": "58", "content_sanskrit": "हतेप्रहस्तेनीलेनतदकम्प्यंमहाबलम् । राक्षसानामहृष्टानांलङ्कामभिजगामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 40016345, "chapter_id": 9246, "verse_number": "59", "content_sanskrit": "नशेकुस्समवस्थातुंनिहतेवाहिनीपतौ । सेतुबन्धंसमासाद्यविशीर्णंसलिलंयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 40016346, "chapter_id": 9246, "verse_number": "60", "content_sanskrit": "हतेतस्मिंश्चमूमुख्येराक्षसास्तेनिरुद्यमाः । रक्षःपतिगृहंगत्वाध्यानमूकत्वमास्थिताः ॥ प्राप्ताश्शोकार्णवंतीव्रंनिस्सज्ञौइवतेऽभवन् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]