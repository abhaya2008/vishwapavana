[{"id": 5000246000, "chapter_id": 9246, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000246001, "chapter_id": 9246, "verse_number": "३-५०-१", "content_sanskrit": "तं शब्दमवसुप्तस्तु जटायुरथ शुश्रुवे।\nनिरैक्षद् रावणं क्षिप्रं वैदेहीं च ददर्श सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000246002, "chapter_id": 9246, "verse_number": "३-५०-२", "content_sanskrit": "ततः पर्वतशृङ्गाभस्तीक्ष्णतुण्डः खगोत्तमः।\nवनस्पतिगतः श्रीमान् व्याजहार शुभां गिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000246003, "chapter_id": 9246, "verse_number": "३-५०-३", "content_sanskrit": "दशग्रीव स्थितो धर्मे पुराणे सत्यसंश्रयः।\nभ्रातस्त्वं निन्दितं कर्म कर्तुं नार्हसि साम्प्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000246004, "chapter_id": 9246, "verse_number": "३-५०-४", "content_sanskrit": "जटायुर्नाम नाम्नाहं गृध्रराजो महाबलः।\nराजा सर्वस्य लोकस्य महेन्द्रवरुणोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000246005, "chapter_id": 9246, "verse_number": "३-५०-५", "content_sanskrit": "लोकानां च हिते युक्तो रामो दशरथात्मजः।\nतस्यैषा लोकनाथस्य धर्मपत्नी यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000246006, "chapter_id": 9246, "verse_number": "३-५०-६", "content_sanskrit": "सीता नाम वरारोहा यां त्वं हर्तुमिहेच्छसि।\nकथं राजा स्थितो धर्मे परदारान् परामृशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000246007, "chapter_id": 9246, "verse_number": "३-५०-७", "content_sanskrit": "रक्षणीया विशेषेण राजदारा महाबल।\nनिवर्तय गतिं नीचां परदाराभिमर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000246008, "chapter_id": 9246, "verse_number": "३-५०-८", "content_sanskrit": "न तत् समाचरेद् धीरो यत् परोऽस्य विगर्हयेत्।\nयथाऽऽत्मनस्तथान्येषां दारा रक्ष्या विमर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000246009, "chapter_id": 9246, "verse_number": "३-५०-९", "content_sanskrit": "अर्थं वा यदि वा कामं शिष्टाः शास्त्रेष्वनागतम्।\nव्यवस्यन्त्यनुराजानं धर्मं पौलस्त्यनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000246010, "chapter_id": 9246, "verse_number": "३-५०-१०", "content_sanskrit": "राजा धर्मश्च कामश्च द्रव्याणां चोत्तमो निधिः।\nधर्मः शुभं वा पापं वा राजमूलं प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000246011, "chapter_id": 9246, "verse_number": "३-५०-११", "content_sanskrit": "पापस्वभावश्चपलः कथं त्वं रक्षसां वर।\nऐश्वर्यमभिसम्प्राप्तो विमानमिव दुष्कृती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000246012, "chapter_id": 9246, "verse_number": "३-५०-१२", "content_sanskrit": "कामस्वभावो यःसोऽसौ न शक्यस्तं प्रमार्जितुम्।\nनहि दुष्टात्मनामार्यमावसत्यालये चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000246013, "chapter_id": 9246, "verse_number": "३-५०-१३", "content_sanskrit": "विषये वा पुरे वा ते यदा रामो महाबलः।\nनापराध्यति धर्मात्मा कथं तस्यापराध्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000246014, "chapter_id": 9246, "verse_number": "३-५०-१४", "content_sanskrit": "यदि शूर्पणखाहेतोर्जनस्थानगतः खरः।\nअतिवृत्तो हतः पूर्वं रामेणाक्लिष्टकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000246015, "chapter_id": 9246, "verse_number": "३-५०-१५", "content_sanskrit": "अत्र ब्रूहि यथातत्त्वं को रामस्य व्यतिक्रमः।\nयस्य त्वं लोकनाथस्य हृत्वा भार्यां गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000246016, "chapter_id": 9246, "verse_number": "३-५०-१६", "content_sanskrit": "क्षिप्रं विसृज वैदेहीं मा त्वा घोरेण चक्षुषा।\nदहेद् दहनभूतेन वृत्रमिन्द्राशनिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000246017, "chapter_id": 9246, "verse_number": "३-५०-१७", "content_sanskrit": "सर्पमाशीविषं बद्‍ध्वा वस्त्रान्ते नावबुध्यसे।\nग्रीवायां प्रतिमुक्तं च कालपाशं न पश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000246018, "chapter_id": 9246, "verse_number": "३-५०-१८", "content_sanskrit": "स भारः सौम्य भर्तव्यो यो नरं नावसादयेत्।\nतदन्नमपि भोक्तव्यं जीर्यते यदनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000246019, "chapter_id": 9246, "verse_number": "३-५०-१९", "content_sanskrit": "यत् कृत्वा न भवेद् धर्मो न कीर्तिर्न यशो ध्रुवम्।\nशरीरस्य भवेत् खेदः कस्तत् कर्म समाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000246020, "chapter_id": 9246, "verse_number": "३-५०-२०", "content_sanskrit": "षष्टिवर्षसहस्राणि जातस्य मम रावण।\nपितृपैतामहं राज्यं यथावदनुतिष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000246021, "chapter_id": 9246, "verse_number": "३-५०-२१", "content_sanskrit": "वृद्धोऽहं त्वं युवा धन्वी सरथः कवची शरी।\nन चाप्यादाय कुशली वैदेहीं मे गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000246022, "chapter_id": 9246, "verse_number": "३-५०-२२", "content_sanskrit": "न शक्तस्त्वं बलाद्धर्तुं वैदेहीं मम पश्यतः।\nहेतुभिर्न्यायसंयुक्तैर्ध्रुवां वेदश्रुतीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000246023, "chapter_id": 9246, "verse_number": "३-५०-२३", "content_sanskrit": "युध्यस्व यदि शूरोऽसि मुहूर्तं तिष्ठ रावण।\nशयिष्यसे हतो भूमौ यथा पूर्वं खरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000246024, "chapter_id": 9246, "verse_number": "३-५०-२४", "content_sanskrit": "असकृत्संयुगे येन निहता दैत्यदानवाः।\nन चिराच्चीरवासास्त्वां रामो युधि वधिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000246025, "chapter_id": 9246, "verse_number": "३-५०-२५", "content_sanskrit": "किं नु शक्यं मया कर्तुं गतौ दूरं नृपात्मजौ।\nक्षिप्रं त्वं नश्यसे नीच तयोर्भीतो न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000246026, "chapter_id": 9246, "verse_number": "३-५०-२६", "content_sanskrit": "नहि मे जीवमानस्य नयिष्यसि शुभामिमाम्।\nसीतां कमलपत्राक्षीं रामस्य महिषीं प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000246027, "chapter_id": 9246, "verse_number": "३-५०-२७", "content_sanskrit": "अवश्यं तु मया कार्यं प्रियं तस्य महात्मनः।\nजीवितेनापि रामस्य तथा दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000246028, "chapter_id": 9246, "verse_number": "३-५०-२८", "content_sanskrit": "तिष्ठ तिष्ठ दशग्रीव मुहूर्तं पश्य रावण।\nवृन्तादिव फलं त्वां तु पातयेयं रथोत्तमात्।\nयुद्धातिथ्यं प्रदास्यामि यथाप्राणं निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000246029, "chapter_id": 9246, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]