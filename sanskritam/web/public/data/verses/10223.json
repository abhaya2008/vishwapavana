[{"id": 6000223000, "chapter_id": 10223, "verse_number": null, "content_sanskrit": "अथ सप्तविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000223001, "chapter_id": 10223, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.001.m4a", "display_order": 2}, {"id": 6000223002, "chapter_id": 10223, "verse_number": "१०-२७-१", "content_sanskrit": "भगवानपि तां रात्रिं शारदोत्फुल्लमल्लिकाम्।\nवीक्ष्य रन्तुं मनश्चक्रे योगमायामुपाश्रितः॥ १०/२७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.002.m4a", "display_order": 3, "topics": [{"text": "गोपीभिस्सह श्रीकृष्णस्य रासक्रीडारम्भः", "range": "१–४१"}]}, {"id": 6000223003, "chapter_id": 10223, "verse_number": "१०-२७-२", "content_sanskrit": "तदोडुराजः ककुभः करैर्मुखं प्राच्या विलिम्पन्नरुणैश्च शन्तमैः।\nस चर्षणीनामुदगाच्छुचो मृजन् प्रियः प्रियाया इव दीर्घदर्शनः॥ १०/२७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.003.m4a", "display_order": 4}, {"id": 6000223004, "chapter_id": 10223, "verse_number": "१०-२७-३", "content_sanskrit": "दृष्ट्वा मुकुन्दस्तमखण्डमण्डलं रामाननाभं नवकुङ्कुमारुणम्।\nवनं च तत्कोमलगोभिरञ्जितं जगौ कलं वामदृशां मनोरमम्॥ १०/२७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.004.m4a", "display_order": 5}, {"id": 6000223005, "chapter_id": 10223, "verse_number": "१०-२७-४", "content_sanskrit": "निशम्य गीतं तदनङ्गवर्धनं व्रजस्‍त्रियः कृष्णनिषक्तमानसाः।\nआजग्मुरन्योन्यमलक्षिताशयाः स यत्र कार्तस्वरलोलकुण्डलाः॥ १०/२७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.005.m4a", "display_order": 6}, {"id": 6000223006, "chapter_id": 10223, "verse_number": "१०-२७-५", "content_sanskrit": "दुहन्त्योऽभिययुः काश्चिद् दोहं हित्वा समुत्सुकाः।\nपयोऽधिश्रित्य संयावमनुद्वास्यापरा ययुः॥ १०/२७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.006.m4a", "display_order": 7}, {"id": 6000223007, "chapter_id": 10223, "verse_number": "१०-२७-६", "content_sanskrit": "परिवेषयन्त्यस्तद् हित्वा पाययन्त्यः शिशून् पयः।\nशुश्रूषन्त्यः पतीन् काश्चिदश्नन्त्योऽपास्य भोजनम्॥ १०/२७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.007.m4a", "display_order": 8}, {"id": 6000223008, "chapter_id": 10223, "verse_number": "१०-२७-७", "content_sanskrit": "लिम्पन्त्यः प्रमृजन्त्योऽन्या अञ्जन्त्यः काश्च लोचने।\nव्यत्यस्तवस्‍त्राभरणाः काश्चित् कृष्णान्तिकं ययुः॥ १०/२७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.008.m4a", "display_order": 9}, {"id": 6000223009, "chapter_id": 10223, "verse_number": "१०-२७-८", "content_sanskrit": "ता वार्यमाणाः पतिभिः पितृभिर्भ्रातृबन्धुभिः।\nगोविन्दापहृतात्मानो न न्यवर्तन्त योषितः॥ १०/२७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.009.m4a", "display_order": 10}, {"id": 6000223010, "chapter_id": 10223, "verse_number": "१०-२७-९", "content_sanskrit": "अन्तर्गृहगताः काश्चिद् गोप्योऽलब्धविनिर्गमाः।\nकृष्णं तद्भावनायुक्ता दध्युर्मीलितलोचनाः॥ १०/२७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.010.m4a", "display_order": 11}, {"id": 6000223011, "chapter_id": 10223, "verse_number": "१०-२७-१०", "content_sanskrit": "दुस्सहप्रेष्ठविरहतीव्रतापधुताशुभाः।\nध्यानप्राप्ताच्युताश्लेषनिर्वृत्या क्षीणमङ्गलाः॥ १०/२७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.011.m4a", "display_order": 12}, {"id": 6000223012, "chapter_id": 10223, "verse_number": "१०-२७-११", "content_sanskrit": "तमेव परमात्मानं जारबुद्ध्याऽपि सङ्गताः।\nजहुर्गुणमयं देहं सद्यः प्रक्षीणबन्धनाः॥ १०/२७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.012.m4a", "display_order": 13}, {"id": 6000223013, "chapter_id": 10223, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.013.m4a", "display_order": 14}, {"id": 6000223014, "chapter_id": 10223, "verse_number": "१०-२७-१२", "content_sanskrit": "कृष्णं विदुः परं कान्तं न तु ब्रह्मतया मुने।\nगुणप्रवाहोपरमस्तासां गुणधियां कथम्॥ १०/२७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.014.m4a", "display_order": 15}, {"id": 6000223015, "chapter_id": 10223, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.015.m4a", "display_order": 16}, {"id": 6000223016, "chapter_id": 10223, "verse_number": "१०-२७-१३", "content_sanskrit": "उक्तं पुरस्तादेेतत्ते चैद्यः सिद्धिं यथा गतः।\nद्विषन्नपि हृषीकेशं किमुताधोक्षजप्रियाः॥ १०/२७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.016.m4a", "display_order": 17}, {"id": 6000223017, "chapter_id": 10223, "verse_number": "१०-२७-१४", "content_sanskrit": "नृणां निःश्रेयसार्थाय व्यक्तिर्भगवतो नृप।\nअव्यक्तस्याप्रमेयस्य निर्गुणस्य गुणात्मनः॥ १०/२७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.017.m4a", "display_order": 18}, {"id": 6000223018, "chapter_id": 10223, "verse_number": "१०-२७-१५", "content_sanskrit": "कामं क्रोधं भयं मोहं मैत्रीं सौहृदमेव वा।\nनित्यं हरौ विदधतो यान्ति तन्मयतां हि ते॥ १०/२७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.018.m4a", "display_order": 19}, {"id": 6000223019, "chapter_id": 10223, "verse_number": "१०-२७-१६", "content_sanskrit": "न चैवं विस्मयः कार्यो भवता भगवत्यजे।\nयोगेश्वरेश्वरे कृष्णे यत एतद् विमुच्यते॥ १०/२७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.019.m4a", "display_order": 20}, {"id": 6000223020, "chapter_id": 10223, "verse_number": "१०-२७-१७", "content_sanskrit": "ता दृष्ट्वाऽन्तिकमायाता भगवान् व्रजयोषितः।\nअवदद् वदतां श्रेष्ठो वाचःपाशैर्विमोहयन्॥ १०/२७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.020.m4a", "display_order": 21}, {"id": 6000223021, "chapter_id": 10223, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.021.m4a", "display_order": 22}, {"id": 6000223022, "chapter_id": 10223, "verse_number": "१०-२७-१८", "content_sanskrit": "स्वागतं वो महाभागाः प्रियं किं करवाणि वः।\nव्रजस्यानामयं कच्चिद् ब्रूतागमनकारणम्॥ १०/२७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.022.m4a", "display_order": 23}, {"id": 6000223023, "chapter_id": 10223, "verse_number": "१०-२७-१९", "content_sanskrit": "रजन्येषा घोररूपा घोरसत्वनिषेविता।\nप्रतियात व्रजं नेह स्थेयं स्‍त्रीभिः सुमध्यमाः॥ १०/२७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.023.m4a", "display_order": 24}, {"id": 6000223024, "chapter_id": 10223, "verse_number": "१०-२७-२०", "content_sanskrit": "मातरः पितरः पुत्रा भ्रातरः पतयश्च वः।\nविचिन्वन्तो ह्यपश्यन्तो मा कृध्वं बन्धुसाध्वसम्॥ १०/२७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.024.m4a", "display_order": 25}, {"id": 6000223025, "chapter_id": 10223, "verse_number": "१०-२७-२१", "content_sanskrit": "दृष्टं वनं कुसुमितं राकेशकररञ्जितम्।\nयमुनानिलनीरैजत्तरुपल्लवशोभितम्॥ १०/२७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.025.m4a", "display_order": 26}, {"id": 6000223026, "chapter_id": 10223, "verse_number": "१०-२७-२२", "content_sanskrit": "तद् यात माचिरं गोष्ठं शुश्रूषध्वं पतीन् सतीः।\nक्रन्दन्ति वत्सा बालाश्च तान् पाययत दुह्यत॥ १०/२७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.026.m4a", "display_order": 27}, {"id": 6000223027, "chapter_id": 10223, "verse_number": "१०-२७-२३", "content_sanskrit": "अथवा मदभिस्नेहाद् भवत्यो यन्त्रिताशयाः।\nआगता ह्युपपन्नं तत् प्रीयन्ते मम जन्तवः॥ १०/२७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.027.m4a", "display_order": 28}, {"id": 6000223028, "chapter_id": 10223, "verse_number": "१०-२७-२४", "content_sanskrit": "भर्तुः शुश्रूषणं स्‍त्रीणां परो धर्मो ह्यमायया।\nतद् बन्धूनां च कल्याणं प्रजानां चानुपोषणम्॥ १०/२७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.028.m4a", "display_order": 29}, {"id": 6000223029, "chapter_id": 10223, "verse_number": "१०-२७-२५", "content_sanskrit": "दुश्शीलो दुर्भगो वृद्धो जडो रोग्यधनोऽपि वा।\nपतिः स्‍त्रीभिर्न हातव्यो लोकेऽशुचिरपातकी॥ १०/२७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.029.m4a", "display_order": 30}, {"id": 6000223030, "chapter_id": 10223, "verse_number": "१०-२७-२६", "content_sanskrit": "अस्वर्ग्यमयशस्यं च फल्गु कृच्छ्रं भयावहम्।\nजुगुप्सितं च सर्वत्र औपपत्यं कुलस्‍त्रियः॥ १०/२७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.030.m4a", "display_order": 31}, {"id": 6000223031, "chapter_id": 10223, "verse_number": "१०-२७-२७", "content_sanskrit": "श्रवणाद् दर्शनाद् ध्यानान्मयि भावोऽनुकीर्तनात्।\nन तथा सन्निकर्षेण प्रतियात ततो गृहान्॥ १०/२७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.031.m4a", "display_order": 32}, {"id": 6000223032, "chapter_id": 10223, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.032.m4a", "display_order": 33}, {"id": 6000223033, "chapter_id": 10223, "verse_number": "१०-२७-२८", "content_sanskrit": "इति विप्रियमाकर्ण्य गोप्यो गोविन्दभाषितम्।\nविषण्णा भग्नसङ्कल्पाश्चिन्तामापुर्दुरत्ययाम्॥ १०/२७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.033.m4a", "display_order": 34}, {"id": 6000223034, "chapter_id": 10223, "verse_number": "१०-२७-२९", "content_sanskrit": "न्यक्कृत्य वक्त्रवनजान्यतितापशुष्यद्बिम्बाधराणि चरणेन महीं लिखन्त्यः।\nआस्रैरुपात्तमषिभिः कुचकुङ्कुमानि तस्थुर्मृजन्त्य उरुदुःखभराः स्म तूष्णीम्॥ १०/२७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.034.m4a", "display_order": 35}, {"id": 6000223035, "chapter_id": 10223, "verse_number": "१०-२७-३०", "content_sanskrit": "प्रेष्ठं प्रियेतरमिव प्रतिभाषमाणं कृष्णं तदर्थविनिवर्तितसर्वकामाः।\nनेत्रे विमृज्य रुदितोपहते स्म किञ्चित्संरम्भगद्गदपदोऽब्रुवतानुरक्ताः॥ १०/२७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.035.m4a", "display_order": 36}, {"id": 6000223036, "chapter_id": 10223, "verse_number": null, "content_sanskrit": "गोप्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.036.m4a", "display_order": 37}, {"id": 6000223037, "chapter_id": 10223, "verse_number": "१०-२७-३१", "content_sanskrit": "मैवं विभोऽर्हति भवान् गदितुं नृशंसं सन्त्यज्य सर्वविषयांस्तव पादमूलम्।\nभक्त्या भजेम दुरवग्रह मा त्यजास्मान् देवो यथाऽऽदिपुरुषो भजतो मुमुक्षून्॥ १०/२७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.037.m4a", "display_order": 38}, {"id": 6000223038, "chapter_id": 10223, "verse_number": "१०-२७-३२", "content_sanskrit": "यत्पत्यपत्यसुहृदामनुवृत्तिरङ्ग स्‍त्रीणां स्वधर्म इति धर्मविदा त्वयोक्तम्।\nअस्त्येव तत् तदपि देववरे त्वयीशे प्रेष्ठो भवांस्तनुभृतां किल बन्धुरात्मा॥ १०/२७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.038.m4a", "display_order": 39}, {"id": 6000223039, "chapter_id": 10223, "verse_number": "१०-२७-३३", "content_sanskrit": "कुर्वन्ति हि त्वयि रतिं कुशलाः स्व आत्मन् नित्याप्रियैः पतिसुतादिभिरार्तिदैः किम्।\nतन्नः प्रसीद वरदेश्वर मा स्म छिन्द्या आशां धृतां त्वयि परामरविन्दनेत्र॥ १०/२७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.039.m4a", "display_order": 40}, {"id": 6000223040, "chapter_id": 10223, "verse_number": "१०-२७-३४", "content_sanskrit": "चित्तं सखे न भवतापहृतं गृहेषु यन्निर्विशत्युत करावपि गृह्यकृत्ये।\nपादौ पदं न चलतस्तव पादमूलाद् यामः कथं व्रजमथो करवाम किं वा॥ १०/२७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.040.m4a", "display_order": 41}, {"id": 6000223041, "chapter_id": 10223, "verse_number": "१०-२७-३५", "content_sanskrit": "सिञ्चाङ्ग नस्त्वदधरामृतपूरकेण हासावलोककलगीतजहृच्छयाग्निम्।\nनो चेद् वयं विरहजाग्न्युपयुक्तदेहा ध्यानेन याम पदयोः पदवीं सखे ते॥ १०/२७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.041.m4a", "display_order": 42}, {"id": 6000223042, "chapter_id": 10223, "verse_number": "१०-२७-३६", "content_sanskrit": "यर्ह्यम्बुजाक्ष तव पादतलं रमाया दत्तक्षणं क्‍वचिदरण्यजनप्रियस्य।\nअस्प्राक्ष्म तत्प्रभृति नान्यसमक्षमङ्ग स्थातुं त्वया विरहिता बत पारयामः॥ १०/२७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.042.m4a", "display_order": 43}, {"id": 6000223043, "chapter_id": 10223, "verse_number": "१०-२७-३७", "content_sanskrit": "श्रीर्यत्पदाम्बुजरजश्चकमे तुलस्या लब्ध्वाऽपि वक्षसि पदं किल भृत्यजुष्टम्।\nयस्याः स्ववीक्षणकृतोऽन्यसुरप्रयासस्तद्वद् वयं च तव पादरजः प्रपन्नाः॥ १०/२७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.043.m4a", "display_order": 44}, {"id": 6000223044, "chapter_id": 10223, "verse_number": "१०-२७-३८", "content_sanskrit": "तन्नः प्रसीद वृजिनार्दन तेऽङ्घ्रिमूलं प्राप्ता विसृज्य वसतीस्त्वदुपासनाशाः।\nत्वत्सुन्दरस्मितनिरीक्षणतीव्रकामतप्तात्मनां पुरुषभूषण देहि दास्यम्॥ १०/२७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.044.m4a", "display_order": 45}, {"id": 6000223045, "chapter_id": 10223, "verse_number": "१०-२७-३९", "content_sanskrit": "वीक्ष्यालकावृतमुखं तव कुण्डलश्रीगण्डस्थलाधरसुधं हसितावलोकम्।\nदत्ताभयं च भुजदण्डयुगं विलोक्य वक्षः श्रियैकरमणं च भवाम दास्यः॥ १०/२७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.045.m4a", "display_order": 46}, {"id": 6000223046, "chapter_id": 10223, "verse_number": "१०-२७-४०", "content_sanskrit": "का स्‍त्र्यङ्ग ते कलपदामृतवेणुगीतसम्मोहिताऽऽर्यचरितान्न चलेत् त्रिलोक्याम्।\nत्रैलोक्यसौभगमिदं च निरीक्ष्य रूपं यद् गोद्विजद्रुममृगाः पुलकान्यबिभ्रन्॥ १०/२७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.046.m4a", "display_order": 47}, {"id": 6000223047, "chapter_id": 10223, "verse_number": "१०-२७-४१", "content_sanskrit": "व्यक्तं भवान् व्रजभयार्तिहरोऽभिजातो देवो यथाऽऽदिपुरुषः सुरलोकगोप्ता।\nतन्नो निधेहि करपङ्कजमार्तबन्धो तप्तस्तनेषु च शिरस्सु च किङ्करीणाम्॥ १०/२७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.047.m4a", "display_order": 48}, {"id": 6000223048, "chapter_id": 10223, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.048.m4a", "display_order": 49}, {"id": 6000223049, "chapter_id": 10223, "verse_number": "१०-२७-४२", "content_sanskrit": "इति विक्लवितं तासां श्रुत्वा योगेश्वरेश्वरः।\nप्रहस्य सदयं गोपीरात्मारामो न्यरीरमत्॥ १०/२७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.049.m4a", "display_order": 50, "topics": [{"text": "गोपीनां गर्वपरिहारार्थं क्रीडामध्ये श्रीकृष्णस्यान्तर्धानम्", "range": "४२–४८"}]}, {"id": 6000223050, "chapter_id": 10223, "verse_number": "१०-२७-४३", "content_sanskrit": "ताभिः समेताभिरुदारचेष्टितः प्रियेक्षणोत्फुल्लमुखीभिरच्युतः।\nउदारहासद्विजकुन्ददीधितिर्व्यरोचतैणाङ्क इवोडुभिर्वृतः॥ १०/२७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.050.m4a", "display_order": 51}, {"id": 6000223051, "chapter_id": 10223, "verse_number": "१०-२७-४४", "content_sanskrit": "उपगीयमान उद्गायन् वनिताशतयूथपः।\nमालां बिभ्रद् वैजयन्तीं व्यचरन् मण्डयन् वनम्॥ १०/२७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.051.m4a", "display_order": 52}, {"id": 6000223052, "chapter_id": 10223, "verse_number": "१०-२७-४५", "content_sanskrit": "नद्याः पुलिनमाविश्य गोपीभिर्हिमवालुकम्।\nरेमे तत्तरलानन्दिकुमुदामोदवायुना॥ १०/२७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.052.m4a", "display_order": 53}, {"id": 6000223053, "chapter_id": 10223, "verse_number": "१०-२७-४६", "content_sanskrit": "बाहुप्रसारपरिरम्भकरालकोरुनीवीस्तनालभननर्मकराग्रपातैः।\nक्ष्वेलावलोकहसितैर्व्रजसुन्दरीणामुत्तम्भयन् रतिपतिं रमयाञ्चकार॥ १०/२७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.053.m4a", "display_order": 54}, {"id": 6000223054, "chapter_id": 10223, "verse_number": "१०-२७-४७", "content_sanskrit": "एवं भगवतः कृष्णाल्लब्धमाना महात्मनः।\nस्वात्मानं मेनिरे स्‍त्रीणां मानिन्योऽभ्यधिकं भुवि॥ १०/२७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.054.m4a", "display_order": 55}, {"id": 6000223055, "chapter_id": 10223, "verse_number": "१०-२७-४८", "content_sanskrit": "तासां तत्सौभगमदं वीक्ष्य मानं च केशवः।\nप्रशमाय प्रसादाय तत्रैवान्तरधीयत॥ १०/२७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_027/BhP_10.027.055.m4a", "display_order": 56}, {"id": 6000223056, "chapter_id": 10223, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे सप्तविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]