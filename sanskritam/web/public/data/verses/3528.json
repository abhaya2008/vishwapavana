[{"id": 2117365, "chapter_id": 3528, "verse_number": "", "content_sanskrit": "धुतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117366, "chapter_id": 3528, "verse_number": "१", "content_sanskrit": "भीष्मः शान्तनवश्चैव द्रोणश्चैव महामतिः ।\nहितं परमकं वाक्यं त्वं च सत्यं ब्रवीषि माम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117367, "chapter_id": 3528, "verse_number": "२", "content_sanskrit": "यथैव पाण्डोस्ते वीराः कुन्तीपुत्रा महाबलाः ।\nतथैव धर्मतः सर्वे मम पुत्रा न संशयः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117368, "chapter_id": 3528, "verse_number": "३", "content_sanskrit": "यथैव मम पुत्राणामिदं राज्यं विधीयते ।\nतथैव पाण्डुपुत्राणामिदं राज्यमसंशयम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117369, "chapter_id": 3528, "verse_number": "४", "content_sanskrit": "क्षत्तरानय गच्छैतान् सह मात्रा सुसत्कृतान् ।\nतया च देवरूपिण्या कृष्णया सह भारत \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117370, "chapter_id": 3528, "verse_number": "५", "content_sanskrit": "दिष्ट्या जीवन्ति ते पार्था दिष्ट्या जीवति सा पृथा ।\nदिष्ट्या द्रुपदकन्यां च लब्धवन्तो महारथाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117371, "chapter_id": 3528, "verse_number": "६", "content_sanskrit": "दिष्ट्या वर्धामहे सर्वे दिष्ट्या शान्तः पुरोचनः ।\nदिष्ट्या मम परं दुःखमपनीतं महाद्युते ।\nत्वमेव गत्वा विदुर तानिहानय माचिरम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117372, "chapter_id": 3528, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117373, "chapter_id": 3528, "verse_number": "७", "content_sanskrit": "एवमुक्तस्ततः क्षत्ता रथमारुह्य शीघ्रगम् ।\nअगात् कतिपयाहोभिः पाञ्चालान् राजधर्मवित् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117374, "chapter_id": 3528, "verse_number": "८", "content_sanskrit": "ततो जगाम विदुरो धृतराष्ट्रस्य शासनात् ।\nसकाशं यज्ञसेनस्य पाण्डवानां च भारत \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117375, "chapter_id": 3528, "verse_number": "९", "content_sanskrit": "आगतं विदुरं श्रुत्वा द्रुपदो राजसत्तमः ।\nस्वपुत्रैः सह धर्मात्मा पूजयामास धर्मतः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117376, "chapter_id": 3528, "verse_number": "१०", "content_sanskrit": "तत्र गत्वा च धर्मज्ञः सर्वशास्त्रविशारदः ।\nद्रुपदं न्यायतो राजन् संयुक्तमुपतस्थिवान् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117377, "chapter_id": 3528, "verse_number": "११", "content_sanskrit": "स चापि प्रतिजग्राह धर्मेण विदुरं ततः ।\nचक्रे पूजां यथान्यायं विदुरस्य महात्मनः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117378, "chapter_id": 3528, "verse_number": "१२", "content_sanskrit": "चक्रतुश्च यथान्यायं कुशलप्रश्नसंविदम् ।\nददर्श पाण्डवांस्तत्र वासुदेवं च भारत \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117379, "chapter_id": 3528, "verse_number": "१३", "content_sanskrit": "ततः स्नेहात् परिष्वज्य पप्रच्छानामयं ततः ।\nवचनाद् धृतराष्ट्रस्य स्नेहयुक्तं पुनः पुनः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117380, "chapter_id": 3528, "verse_number": "१४", "content_sanskrit": "तैश्चाप्यमितबुद्धिः स पूजितोऽथ यथाक्रमम् ।\nपाण्डवा विनयोपेता नत्वाऽऽलिङ्ग्य विशाम्पते \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117381, "chapter_id": 3528, "verse_number": "१५", "content_sanskrit": "दृष्ट्वा मुहुर्मुहू राजन् हर्षादश्रूण्यवर्तयन् ।\nदृष्ट्वा कुशलिनश्चैतान् ततस्तान् पाण्डुनन्दनान् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117382, "chapter_id": 3528, "verse_number": "१६", "content_sanskrit": "प्रददौ चापि रत्नानि विविधानि वसूनि च ।\nपाण्डवानां च कुन्त्याश्च द्रोपद्याश्च विशेषतः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117383, "chapter_id": 3528, "verse_number": "१७", "content_sanskrit": "द्रुपदस्य च पुत्राणां तथा दत्तानि कौरवैः ।\nसङ्कर्षणं वासुदेवं प्रणम्य विदुरस्ततः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117384, "chapter_id": 3528, "verse_number": "१८", "content_sanskrit": "आसने काञ्चने शुभ्रे निषसाद महामतिः ।\nकृत्वा मिथस्तु सँल्लापं मुदा पुनरभाषत \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117385, "chapter_id": 3528, "verse_number": "१९", "content_sanskrit": "भीष्मद्रोणाजमीढैश्च यदुक्तं पाण्डवान् प्रति ।\nअवदत् तत्र तत्सर्वं सर्वेषामेव शृण्वताम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117386, "chapter_id": 3528, "verse_number": "२०", "content_sanskrit": "प्रोवाच चामितप्रज्ञः प्रश्रितं विनयान्वितम् ।\nद्रुपदं पाण्डुपुत्राणां सन्निधौ केशवस्य च \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117387, "chapter_id": 3528, "verse_number": "२१", "content_sanskrit": "राजन् शृणु सहामात्यः सपुत्रश्च वचो मम ।\nधृतराष्ट्रः सपुत्रं त्वां सहामात्यं सबान्धवम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117388, "chapter_id": 3528, "verse_number": "२२", "content_sanskrit": "अब्रवीत् कुशलं राजन् प्रीयमाणः पुनः पुनः ।\nप्रीतिमांस्ते दृढं चासीत् सम्बन्धेन नराधिप \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117389, "chapter_id": 3528, "verse_number": "२३", "content_sanskrit": "अथ भीष्मः शान्तनवः कौरवैः सह सर्वशः ।\nकुशलं त्वां महेश्वासः सर्वतः परिपृच्छति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117390, "chapter_id": 3528, "verse_number": "२४", "content_sanskrit": "भारद्वाजो महाप्राज्ञो द्रोणः प्रियसखस्तव ।\nसमाश्लेषमुपेत्य त्वां कुशलं परिपृच्छति \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117391, "chapter_id": 3528, "verse_number": "२५", "content_sanskrit": "धृतराष्ट्रस्तु पाञ्चाल्य त्वया सम्बन्धमेयिवान् ।\nकृतार्थं मन्यते त्मानं तथा सर्वेऽपि कौरवाः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117392, "chapter_id": 3528, "verse_number": "२६", "content_sanskrit": "न तथा राज्यसम्प्राप्तिस्तेषां प्रीतिकरा मता ।\nयथा सम्बन्धकं प्राप्य यज्ञसेन त्वया सह \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117393, "chapter_id": 3528, "verse_number": "२७", "content_sanskrit": "एतद् विदित्वा तु भवान् प्रस्थापयतु पाण्डवान् ।\nद्रष्टुं हि पाण्डुदायादान् त्वरन्ते कुरवो भृशम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117394, "chapter_id": 3528, "verse_number": "२८", "content_sanskrit": "विप्रोषिता दीर्घकालमेते चापि नरर्षभाः ।\nउत्सुका नागरा द्रष्टुं भविष्यन्ति पृथां तथा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117395, "chapter_id": 3528, "verse_number": "२९", "content_sanskrit": "कृष्णामपि च पाञ्चालीं सर्वास्ताः कौरवस्त्रियः ।\nद्रष्टुकामाः प्रतीक्षन्ते पुरं च विषयं च नः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117396, "chapter_id": 3528, "verse_number": "३०", "content_sanskrit": "स भवान् पाण्डुपुत्राणामाज्ञापयतु माचिरम् ।\nगमनं सहदाराणामेतदागमनं मम \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117397, "chapter_id": 3528, "verse_number": "३१", "content_sanskrit": "निसृष्टेषु त्वया राजन् पाण्डवेषु महात्मसु ।\nततोऽहं प्रेषयिष्यामि धृतराष्ट्रस्य शीघ्रगान् ।\nआगमिष्यन्ति कौन्तेयाः कुन्ती च सह कृष्णया \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117398, "chapter_id": 3528, "verse_number": "२०७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्ताधिकद्विशततमोऽध्यायः ॥२०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117399, "chapter_id": 3528, "verse_number": "८", "content_sanskrit": "॥ इति विदुरागमनपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117400, "chapter_id": 3528, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]