[{"id": 2028143, "chapter_id": 1607, "verse_number": "३-२४५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028144, "chapter_id": 1607, "verse_number": "३-२४५-१", "content_sanskrit": "युधिष्ठिरवचः श्रुत्वा भीमसेनपुरोगमाः।\nप्रहृष्टवदनाः सर्वे समुत्तस्थुर्नरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028145, "chapter_id": 1607, "verse_number": "३-२४५-२", "content_sanskrit": "अभेद्यानि ततः सर्वे समनह्यन्त भारत।\nजाम्बूनदविचित्राणि कवचानि महारथाः।\nआयुधानि च दिव्यानि विविधानि समादधुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028146, "chapter_id": 1607, "verse_number": "३-२४५-३", "content_sanskrit": "ते दंशिता रथैः सर्वे ध्वजिनः सशरासनाः।\nपाण्डवाः प्रत्यदृश्यन्त ज्वलिता इवपावकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028147, "chapter_id": 1607, "verse_number": "३-२४५-४", "content_sanskrit": "तान्रथान्साधुसंपन्नान्संयुक्ताञ्जवनैर्हयैः।\nआस्थाय रथशार्दूलाः शीघ्रमेव ययुस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028148, "chapter_id": 1607, "verse_number": "३-२४५-५", "content_sanskrit": "ततः कौरवसैन्यानां प्रादुरासीन्महास्वनः।\nप्रयातान्सहितान्दृष्ट्वा पाण्डुपुत्रान्महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028149, "chapter_id": 1607, "verse_number": "३-२४५-६", "content_sanskrit": "जितकाशिनश्च स्वचरास्त्वरिताश्च महारथाः।\nक्षणेनैव वने तस्मिन्समाजग्मुरभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028150, "chapter_id": 1607, "verse_number": "३-२४५-७", "content_sanskrit": "न्यवर्तन्त ततः सर्वे गन्धर्वा जितकाशिनः।\nदृष्ट्वा रथगतान्वीरान्पाण्डवांश्चतुरो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028151, "chapter_id": 1607, "verse_number": "३-२४५-८", "content_sanskrit": "तांस्तु विभ्राजितान्दृष्ट्वा लोकपालानिवोद्यतान्।\nव्यूढानीका व्यतिष्ठन्त गन्धमादनवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028152, "chapter_id": 1607, "verse_number": "३-२४५-९", "content_sanskrit": "राज्ञस्तु वचनं श्रुत्वा धर्मपुत्रस्य धीमतः।\nक्रमेण मृदुना युद्धमुपक्रान्तं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028153, "chapter_id": 1607, "verse_number": "३-२४५-१०", "content_sanskrit": "न तु गन्धर्वराजस्य सैनिका मन्दचेतसः।\nशक्यन्ते मृदुना श्रेयः प्रतिपादयितुं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028154, "chapter_id": 1607, "verse_number": "३-२४५-११", "content_sanskrit": "ततस्तान्युधि दुर्धर्षान्सव्यसाची परंतपः।\nसान्त्वपूर्वमिदं वाक्यमुवाच खचरान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028155, "chapter_id": 1607, "verse_number": "३-२४५-१२", "content_sanskrit": "नैतद्गन्धर्वराजस्य युक्तं कर्म जुगुप्सितम्।\nपरदाराभिमर्शश्च मानुषैश्च समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028156, "chapter_id": 1607, "verse_number": "३-२४५-१३", "content_sanskrit": "उत्सृजध्वं महावीर्यान्धृतराष्ट्रसुतानिमान्।\nदारांश्चैषां प्रमुञ्चध्वं धर्मराजस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028157, "chapter_id": 1607, "verse_number": "३-२४५-१४", "content_sanskrit": "त एवमुक्ता गन्धर्वाः पाण्डवेन यशस्विना।\nउत्स्मयन्तस्तदा पार्थमिदं वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028158, "chapter_id": 1607, "verse_number": "३-२४५-१५", "content_sanskrit": "एकस्यैव वयं तात कुर्याम वचनं भुवि।\nयस्य शासनमाज्ञाय चरामो विगतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028159, "chapter_id": 1607, "verse_number": "३-२४५-१६", "content_sanskrit": "तेनैकेन रकयथादिष्टं तथा वर्ताम भारत।\nन शास्ता विद्यतेऽस्माकमन्यस्तस्मात्सुरेश्वरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028160, "chapter_id": 1607, "verse_number": "३-२४५-१७", "content_sanskrit": "एवमुक्तः स गन्धर्वैः कुन्तीपुत्रो धनंजयः।\nगन्धर्वान्पुनरेवैतान्वचनं प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028161, "chapter_id": 1607, "verse_number": "३-२४५-१८", "content_sanskrit": "यदि साम्ना न मुञ्चध्वं गन्धर्वा धृतराष्ट्रजान्।\nमोक्षयिष्यामि विक्रम्य स्वयमेव सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028162, "chapter_id": 1607, "verse_number": "३-२४५-१९", "content_sanskrit": "एवमुक्त्वा ततः पार्थः सव्यसाची धनंजयः।\nससर्ज निशितान्बाणान्खचरान्खचरान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028163, "chapter_id": 1607, "verse_number": "३-२४५-२०", "content_sanskrit": "तथैव शरवर्षेण गन्धर्वास्ते बलोत्काटाः।\nपाण्डवानभ्यवर्तन्त पाण्डवाश्च दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028164, "chapter_id": 1607, "verse_number": "३-२४५-२१", "content_sanskrit": "ततः सुतुमुलं युद्धं गन्धर्वाणां तरस्विनाम्।\nबभूव भीमवेगानां च भात ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028165, "chapter_id": 1607, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि पञ्चचत्वारिंशदधिकद्विशततमोऽध्यायः ॥ २४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]