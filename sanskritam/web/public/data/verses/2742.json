[{"id": 2082143, "chapter_id": 2742, "verse_number": "१२-२४७-०x", "content_sanskrit": "शुक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082144, "chapter_id": 2742, "verse_number": "१२-२४७-१", "content_sanskrit": "यदिदं वेदवचनं कुरु कर्म त्यजेति च।\nकां दिशं विद्यया यान्ति कां च गच्छन्ति कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082145, "chapter_id": 2742, "verse_number": "१२-२४७-२", "content_sanskrit": "एतद्वै श्रोतुमिच्छामि तद्भवान्प्रब्रवीतु मे।\nएतच्चान्योन्यवैरूप्ये वर्तेते प्रतिकूलतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082146, "chapter_id": 2742, "verse_number": "१२-२४७-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082147, "chapter_id": 2742, "verse_number": "१२-२४७-३", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं पराशरसुतः सुतम्।\nकर्मविद्यामयावेतौ व्याख्यास्यामि क्षराक्षरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082148, "chapter_id": 2742, "verse_number": "१२-२४७-४", "content_sanskrit": "यां दिशं विद्यया यान्ति यां च गच्छन्ति कर्मणा।\nशृणुष्वैकमना वत्स गह्वरं ह्येतदन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082149, "chapter_id": 2742, "verse_number": "१२-२४७-५", "content_sanskrit": "अस्ति धर्म इति ह्युक्त्वा नास्तीत्यत्रैव यो वदेत्।\nतस्य पक्षस्य सदृशमिदं मम भवेदथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082150, "chapter_id": 2742, "verse_number": "१२-२४७-६", "content_sanskrit": "द्वाविमावथ पन्थानौ यत्र वेदाः प्रतिष्ठिताः।\nप्रवृत्तिलक्षणो धर्मो निवृत्तौ च व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082151, "chapter_id": 2742, "verse_number": "१२-२४७-७", "content_sanskrit": "कर्मणा बध्यते जन्तुर्विद्यया तु प्रमुच्यते।\nतस्मात्कर्म न कुर्वन्ति यतयः पारदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082152, "chapter_id": 2742, "verse_number": "१२-२४७-८", "content_sanskrit": "कर्मणा जायते प्रेत्य मूर्तिमान्षोडशात्मकः।\nविद्यया जायते नित्यमव्ययो ह्यक्षरात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082153, "chapter_id": 2742, "verse_number": "१२-२४७-९", "content_sanskrit": "कर्म त्वेके प्रशंसन्ति स्वल्पबुद्धितया नराः।\nतेन ते देहजालानि रमयन्त उपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082154, "chapter_id": 2742, "verse_number": "१२-२४७-१०", "content_sanskrit": "ये स्म बुद्धिं परां प्राप्ता धमैर्नपुण्यदर्शिनः।\nन ते कर्म प्रशंसन्ति कूपं नद्यां पिबन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082155, "chapter_id": 2742, "verse_number": "१२-२४७-११", "content_sanskrit": "कर्मणः फलमाप्नोति सुखदुःखे भवाभवौ।\nविद्यया तदवाप्नोति यत्र गत्वा न शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082156, "chapter_id": 2742, "verse_number": "१२-२४७-१२", "content_sanskrit": "यत्र गत्वा न म्रियते यत्र गत्वा न जायते।\nन जीर्यते यत्र गत्वा यत्र गत्वा न वर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082157, "chapter_id": 2742, "verse_number": "१२-२४७-१३", "content_sanskrit": "यत्र तद्ब्रह्म परममव्यक्तमचलं ध्रवम्।\nअव्याहतमनायासममृतं चावियोगि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082158, "chapter_id": 2742, "verse_number": "१२-२४७-१४", "content_sanskrit": "द्वन्द्वैर्न यत्र बाध्यन्ते मानसेन च कर्मणा।\nसमाः सर्वत्र मैत्राश्च सर्वभूतहिते रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082159, "chapter_id": 2742, "verse_number": "१२-२४७-१५", "content_sanskrit": "विद्यामयोऽन्यः पुरुषस्तात कर्ममयोऽपरः।\nविद्धि चन्द्रमसं दर्शे सूक्ष्मया कलया स्थितम्।\n`विद्यामयं तं पुरुषं नित्यं ज्ञानगुणात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082160, "chapter_id": 2742, "verse_number": "१२-२४७-१६", "content_sanskrit": "तदेतदृषिणा प्रोक्तं विस्तरेणानुमीयते।\nनवं तु शशिनं दृष्ट्वा वक्रतन्तुमिवाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082161, "chapter_id": 2742, "verse_number": "१२-२४७-१७", "content_sanskrit": "एकादशविकारात्मा कलासंभारसंभृतः।\nमृर्तिमानिति तं विद्धि तात कर्म गुणात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082162, "chapter_id": 2742, "verse_number": "१२-२४७-१८", "content_sanskrit": "`तस्मिन्यः संस्थितो ह्यग्निर्नित्यंस्थाल्यामिवाहितः।\nआत्मानं तं विजानीहि नित्यं त्यागजितात्मकं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082163, "chapter_id": 2742, "verse_number": "१२-२४७-१९", "content_sanskrit": "देवो यः संश्रितस्तस्मिन्नब्विन्दुरिव पुष्करे।\nक्षेत्रज्ञं तं विजानीयान्नित्यं योगजितात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082164, "chapter_id": 2742, "verse_number": "१२-२४७-२०", "content_sanskrit": "तमोरजश्च सत्त्वं च विद्धि जीवगुणात्मकम्।\nजीवमात्मगुणं विद्यादात्मानं प-----नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082165, "chapter_id": 2742, "verse_number": "१२-२४७-२१", "content_sanskrit": "अचेतनं जीवगुणं वदन्ति\nस चेष्टते चेष्टयते च सर्वम्\nततः परं क्षेत्रविदो वदन्ति\nप्राकल्पयद्यो भुवनानि सप्त॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082166, "chapter_id": 2742, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तचत्वारिंशदधिकद्विशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]