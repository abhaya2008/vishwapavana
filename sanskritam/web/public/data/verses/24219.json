[{"id": 7004219000, "chapter_id": 24219, "verse_number": "५-१-६८-१", "content_sanskrit": "सनत्कुमार उवाच ।\nशृणु व्यास महापुण्यं तीर्थं परमशोभनम् ।\nदेवप्रयागमाख्यातं सर्वपापप्रणाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004219001, "chapter_id": 24219, "verse_number": "५-१-६८-२", "content_sanskrit": "देवानां च परं स्थानं यत्र तीर्थं परंतप ।\nसोमतीर्थोत्तरे भागे प्रयागस्य च दक्षिणे॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004219002, "chapter_id": 24219, "verse_number": "५-१-६८-३", "content_sanskrit": "क्षिप्रायाः पूर्वभागे च तत्र तीर्थं प्रतिष्ठितम् ।\nतत्र तीर्थे नरः स्नात्वा पश्येच्चैव सुरोत्तमम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004219003, "chapter_id": 24219, "verse_number": "५-१-६८-४", "content_sanskrit": "देवं माधवमित्याख्यं भुवि सर्वफलप्रदम् ।\nददाति तस्य देवेंद्रो वांछितार्थं जगत्पतिः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004219004, "chapter_id": 24219, "verse_number": "५-१-६८-५", "content_sanskrit": "आनंदभैरवस्तत्र सर्वदेवनमस्कृतः ।\nयस्य दर्शनमात्रेण सर्वपापक्षयो भवेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004219005, "chapter_id": 24219, "verse_number": "५-१-६८-६", "content_sanskrit": "न तस्य जायते व्यास यातना भैरवी कदा ।\nस्वर्गद्वारे सदा व्यास जायते निर्भयः पुमान्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004219006, "chapter_id": 24219, "verse_number": "५-१-६८-७", "content_sanskrit": "ज्येष्ठे मासे सिते पक्षे दशम्यां बुध हस्तयोः ।\nगरानन्दे व्यतीपाते कन्याचन्द्रे वृषे रवौ ।\nदशाला जायते वत्स गंगाजन्म परं शुचि॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004219007, "chapter_id": 24219, "verse_number": "५-१-६८-८", "content_sanskrit": "तद्दिने च नरः स्नात्वा सर्वतीर्थफलं लभेत् ।\nअखण्डं च परं तीर्थं शृणु व्यास ह्यतः परम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004219008, "chapter_id": 24219, "verse_number": "५-१-६८-९", "content_sanskrit": "यस्य श्रवणमात्रेण व्रतभंगो न जायते ।\nएक एव पुरा ब्रह्मन्ब्राह्मणो ब्रह्मवित्तमः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004219009, "chapter_id": 24219, "verse_number": "५-१-६८-१०", "content_sanskrit": "धर्मशर्मेति विख्यातः सदाचाररतः शुचिः ।\nबहुव्रतधरो दांतो वेदवेदांगपारगः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004219010, "chapter_id": 24219, "verse_number": "५-१-६८-११", "content_sanskrit": "किंचिद्दोषप्रसंगेन व्रतपूर्तिर्न चाभवत् ।\nएवं बहुतिथे काले नारदो देवदर्श नः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004219011, "chapter_id": 24219, "verse_number": "५-१-६८-१२", "content_sanskrit": "तस्य गेहागतो ब्रह्मन्नातिथ्यार्थं महातपाः ।\nतदोत्थाय द्विजो नित्यं बहुमानपुरःसरम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004219012, "chapter_id": 24219, "verse_number": "५-१-६८-१३", "content_sanskrit": "सत्कृत्य नारदं भूमन्विधिदृष्टेन कर्मणा ।\nपूजयित्वा द्विजश्रेष्ठः पप्रच्छ मुनिसत्तम॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004219013, "chapter_id": 24219, "verse_number": "५-१-६८-१४", "content_sanskrit": "भगवन्भवता सर्वं विदितं ज्ञानचक्षुषा ।\nअस्माकं च परं दोषः किंचिज्जातः पुराऽनघ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004219014, "chapter_id": 24219, "verse_number": "५-१-६८-१५", "content_sanskrit": "येन पापप्रसंगेन व्रतभंगोऽभवद्ध्रुवम् ।\nकारणं ब्रूहि मे नाथ किं दोषोऽत्र तु गण्यते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004219015, "chapter_id": 24219, "verse_number": "५-१-६८-१६", "content_sanskrit": "नारद उवाच ।\nश्रूयतां भो द्विजश्रेष्ठ भवद्भिश्च पुराकृतम् ।\nमहाराष्ट्रे सुविख्यातो ब्राह्मणो धनसंचकः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004219016, "chapter_id": 24219, "verse_number": "५-१-६८-१७", "content_sanskrit": "ब्रह्मदत्तेत्यसौ विप्रो वेदब्राह्मणनिंदकः ।\nधनलोभी पराक्रांतः सर्वधर्मबहिर्मुखः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004219017, "chapter_id": 24219, "verse_number": "५-१-६८-१८", "content_sanskrit": "नास्तिको देवतीर्थेषु परद्रव्यापहारकः ।\nपरस्त्रीषु रतो नित्यं द्यूतवादी च तस्करः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004219018, "chapter_id": 24219, "verse_number": "५-१-६८-१९", "content_sanskrit": "एवमायुःपरिक्षीणो धनहीनोऽभवत्तदा ।\nइतस्ततोऽभ्रमद्भ्रष्टो नदीतीरे सुविह्वलः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004219019, "chapter_id": 24219, "verse_number": "५-१-६८-२०", "content_sanskrit": "गतश्चौर्यप्रसंगेन यात्रिकैः सह संगतः ।\nकिंचित्कालेषु दुःशीलो मृतिं प्राप्तो रुजार्दितः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004219020, "chapter_id": 24219, "verse_number": "५-१-६८-२१", "content_sanskrit": "नीतः संयमिनीं विप्रस्तत्कालं यमकिंकरैः ।\nयमराजपुरं प्राप्तो बहुपापकरो द्विजः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004219021, "chapter_id": 24219, "verse_number": "५-१-६८-२२", "content_sanskrit": "दृष्टोऽसौ धर्मराजेन तदा पत्यपरायणः ।\nनिरीक्ष्य सहसोवाच धर्मपूर्वमिदं वचः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004219022, "chapter_id": 24219, "verse_number": "५-१-६८-२३", "content_sanskrit": "शृणुध्वं किंकराः सर्वे यूयमेकाग्रमानसाः ।\nअनेनाचरितं सर्वं दुष्कर्म सर्वकिल्बिषम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004219023, "chapter_id": 24219, "verse_number": "५-१-६८-२४", "content_sanskrit": "गोदातीरे मृतः पापी तत्र नः कारणं न हि ।\nतिस्रःकोट्योऽर्धकोटिश्च यानि तीर्थान्यहर्निशम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004219024, "chapter_id": 24219, "verse_number": "५-१-६८-२५", "content_sanskrit": "आयांति गौतमीतीरे सिंहस्थेऽपि बृहस्पतौ ।\nतेषां तु वायुसंस्पर्शो जातोस्यांते कलेवरे॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004219025, "chapter_id": 24219, "verse_number": "५-१-६८-२६", "content_sanskrit": "तेन पुण्यप्रभावेन नोऽस्माकं कारणं क्वचित् ।\nग्राह्यो भवद्भिनैवायं मुच्यतां भोः पुरःसराः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004219026, "chapter_id": 24219, "verse_number": "५-१-६८-२७", "content_sanskrit": "एवं तैर्मोचितो विप्रः पुनर्ब्रह्मगतिं गतः ।\nतेन पापप्रसंगेन व्रतभंगी गतो भुवि॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004219027, "chapter_id": 24219, "verse_number": "५-१-६८-२८", "content_sanskrit": "ब्राह्मण उवाच ।\nब्रह्मन्केन प्रकारेण सर्वपापक्षयो भवेत् ।\nकिं तपः किं च दानं च किं तीर्थव्रतसेवनम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004219028, "chapter_id": 24219, "verse_number": "५-१-६८-२९", "content_sanskrit": "येन पुण्यप्रभावेन व्रतभंगो न जायते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004219029, "chapter_id": 24219, "verse_number": "५-१-६८-३०", "content_sanskrit": "नारद उवाच ।\nशृणु द्विजवरश्रेष्ठ महाकालवनं स्मृतम् ।\nयत्र रुद्रसरः प्रोक्तमृषिणा तत्त्वदर्शिना॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004219030, "chapter_id": 24219, "verse_number": "५-१-६८-३१", "content_sanskrit": "कोटिकोटिसुतीर्थानि वर्तंते द्विजसत्तम ।\nकोटितीर्थेति विख्यातं तस्माद्द्विज सनातनम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004219031, "chapter_id": 24219, "verse_number": "५-१-६८-३२", "content_sanskrit": "तत्तीर्थस्योत्तरे भागे सुतीर्थं सर्वकामदम् ।\nनाम्नाऽखंडसरः ख्यातमखंडेश्वरसन्निधौ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004219032, "chapter_id": 24219, "verse_number": "५-१-६८-३३", "content_sanskrit": "यस्य दर्शनमात्रेण सर्वयज्ञफलं लभेत् ।\nतस्माद्धि सर्वथा वत्स गच्छ त्वं तत्र मा चिरम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004219033, "chapter_id": 24219, "verse_number": "५-१-६८-३४", "content_sanskrit": "इति तस्य वचः श्रुत्वा स द्विजोऽगात्कुमुद्वतीम् ।\nस्नात्वाऽखण्डसरे व्यास दृष्ट्वा देवं महेश्वरम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004219034, "chapter_id": 24219, "verse_number": "५-१-६८-३५", "content_sanskrit": "सद्यः पुण्यवतांलोकान्प्राप्तो वै द्विजसत्तमः ।\nएवं व्यास महातीर्थमखंडेश्वरमुत्तमम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]