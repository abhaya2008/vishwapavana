[{"id": 2007002, "chapter_id": 1137, "verse_number": "१-१३८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007003, "chapter_id": 1137, "verse_number": "१-१३८-१", "content_sanskrit": "ततस्ते मन्त्रयामासुर्दुर्योधनपुरोगमाः।\nप्राणवान्विक्रमी चापि शौर्ये च महति स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007004, "chapter_id": 1137, "verse_number": "१-१३८-२", "content_sanskrit": "स्पर्धते चापि सततमस्मानेव वृकोदरः।\nतं तु सुप्तं पुरोद्याने जले शूले क्षिपामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007005, "chapter_id": 1137, "verse_number": "१-१३८-३", "content_sanskrit": "ततो जलविहारार्थं कारयामास भारत।\nप्रमाणकोट्यामुद्देशे स्थलं किंचिदुपेत्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007006, "chapter_id": 1137, "verse_number": "१-१३८-४", "content_sanskrit": "भक्ष्यं भोज्यं च पेयं च चोष्यं लेह्यमथापि च।\nउपपादितं नरैस्तत्र कुशलैः सूदकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007007, "chapter_id": 1137, "verse_number": "१-१३८-५", "content_sanskrit": "न्यवेदयंस्तत्पुरुषा धार्तराष्ट्राय वै तदा।\nततो दुर्योधनस्तत्र पाण्डवानाह दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007008, "chapter_id": 1137, "verse_number": "१-१३८-६", "content_sanskrit": "गङ्गां चैवानुयास्याम उद्यानवनशोभिताम्।\nसहिता भ्रातरः सर्वे जलक्रीडामवाप्नुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007009, "chapter_id": 1137, "verse_number": "१-१३८-७", "content_sanskrit": "एवमस्त्विति तं चापि प्रत्युवाच युधिष्ठिरः।\nते रथैर्नगराकारैर्देशजैश्च गजोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007010, "chapter_id": 1137, "verse_number": "१-१३८-८", "content_sanskrit": "निर्ययुर्नगराच्छूराः कौरवाः पाण्डवैः सह।\nउद्यानवनमासाद्य विसृज्य च महाजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007011, "chapter_id": 1137, "verse_number": "१-१३८-९", "content_sanskrit": "विशन्ति स्म तदा वीराः सिंहा इव गिरेर्गुहाम्।\nउद्यानमभिपश्यन्तो भ्रातरः सर्व एव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007012, "chapter_id": 1137, "verse_number": "१-१३८-१०", "content_sanskrit": "उपस्थानगृहैः शुभ्रैर्वलभीभिश्च शोभितम्।\nगवाक्षकैस्तथा जालैर्यन्त्रैः सांचारिकैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007013, "chapter_id": 1137, "verse_number": "१-१३८-११", "content_sanskrit": "संमार्जितं सौधकारैश्चित्रकारैश्च चित्रितम्।\nदीर्घिकाभिश्च पूर्णाभिस्तथा पुष्करिणीषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007014, "chapter_id": 1137, "verse_number": "१-१३८-१२", "content_sanskrit": "जलं तच्छुशुभे च्छन्नं फुल्लैर्जलरुहैस्तथा।\nउपच्छन्ना वसुमती तथा पुष्पैर्यथर्तुकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007015, "chapter_id": 1137, "verse_number": "१-१३८-१३", "content_sanskrit": "तत्रोपविष्टास्ते सर्वे पाण्डवाः कौरवाश्च ह।\nउपच्छन्नान्बहून्कामांस्ते भुञ्जन्ति ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007016, "chapter_id": 1137, "verse_number": "१-१३८-१४", "content_sanskrit": "अथोद्यानवरे तस्मिंस्तथा क्रीडागताश्चते।\nपरस्परस्य वक्त्रेषु ददुर्भक्ष्यांस्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007017, "chapter_id": 1137, "verse_number": "१-१३८-१५", "content_sanskrit": "ततो दुर्योधनः पापस्तद्भक्ष्ये कालकूटकम्।\nविषं प्रक्षेपयामास भीमसेनजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007018, "chapter_id": 1137, "verse_number": "१-१३८-१६", "content_sanskrit": "स्वयमुत्थाय चैवाथ हृदयेन क्षुरोपमः।\nस वाचाऽमृतकल्पश्च भ्रातृवच्च सुहृद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007019, "chapter_id": 1137, "verse_number": "१-१३८-१७", "content_sanskrit": "स्वयं प्रक्षिपते भक्ष्यं बहु भीमस्य पाकृत्।\nप्रभक्षितं च भीमेन तं वै दोषमजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007020, "chapter_id": 1137, "verse_number": "१-१३८-१८", "content_sanskrit": "ततो दुर्योधनस्तत्र हृदयेन हसन्निव।\nकृतकृत्यमीवात्मानं मन्यते पुरुषाधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007021, "chapter_id": 1137, "verse_number": "१-१३८-१९", "content_sanskrit": "ततस्ते सहिताः सर्वे जलक्रीडामकुर्वत।\nपाण्डवा धार्तराष्ट्राश्च तदा मुदितमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007022, "chapter_id": 1137, "verse_number": "१-१३८-२०", "content_sanskrit": "विहारावसथेष्वेव वीरा वासमरोचयन्।\nभीमस्तु बलवान्भुक्त्वा व्यायामाभ्यधिकं जले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007023, "chapter_id": 1137, "verse_number": "१-१३८-२१", "content_sanskrit": "वाहयित्वा कुमारांस्ताञ्जलक्रीडागतांस्तदा।\nप्रमाणकोट्यां वासार्थी सुष्वापावाप्य तत्स्थलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007024, "chapter_id": 1137, "verse_number": "१-१३८-२२", "content_sanskrit": "शीतं वातं समासाद्य श्रान्तो मदविमोहितः।\nविषेण च परीताङ्गो निश्चेष्टः पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007025, "chapter_id": 1137, "verse_number": "१-१३८-२३", "content_sanskrit": "ततो बद्ध्वा लतापाशैर्भीमं दुर्योधनः स्वयम्।\nशूलान्यप्सु निखायाशु प्रादेशाभ्यन्तराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007026, "chapter_id": 1137, "verse_number": "१-१३८-२४", "content_sanskrit": "लतापाशैर्दृढं बद्धं स्थलाज्जलमपातयत्।\nसशेषत्वान्न संप्राप्तो जले शूलिनि पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007027, "chapter_id": 1137, "verse_number": "१-१३८-२५", "content_sanskrit": "पपात यत्र तत्रास्य शूलं नासीद्यदृच्छया।\nस निःसंज्ञो जलस्यान्तमवाग्वै पाण्डवोऽविशत्।\nआक्रामन्नागभवने तदा नागकुमारकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007028, "chapter_id": 1137, "verse_number": "१-१३८-२६", "content_sanskrit": "ततः समेत्य बहुभिस्तदा नागैर्महाविषैः।\nअदश्यत भृशं भीमो महादंष्ट्रैर्विपोल्बणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007029, "chapter_id": 1137, "verse_number": "१-१३८-२७", "content_sanskrit": "ततोऽस्य दश्यमानस्य तद्विषं कालकूटकम्।\nहतं सर्पविषेणैव स्थावरं जङ्गमेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007030, "chapter_id": 1137, "verse_number": "१-१३८-२८", "content_sanskrit": "दंष्ट्राश्च दंष्ट्रिणां तेषां मर्मस्वपि निपातिताः।\nत्वचं नैवास्य बिभिदुः सारत्वात्पृथुवक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007031, "chapter_id": 1137, "verse_number": "१-१३८-२९", "content_sanskrit": "ततः प्रबुद्धः कौन्तेयः सर्वं संछिद्य बन्धनम्।\nपोथयामास तान्सर्पान्केचिद्भीताः प्रदुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007032, "chapter_id": 1137, "verse_number": "१-१३८-३०", "content_sanskrit": "हतावशेषा भीमेन सर्वे वासुकिमभ्ययुः।\nऊचुश्च सर्पराजानं वासुकिं वासवोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007033, "chapter_id": 1137, "verse_number": "१-१३८-३१", "content_sanskrit": "अयं नरो वै नागरेन्द्र ह्यप्सु बद्ध्वा प्रवेशितः।\nयथा च नो मतिर्व्रीर विषपीतो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007034, "chapter_id": 1137, "verse_number": "१-१३८-३२", "content_sanskrit": "निश्चेष्टोऽस्माननुप्राप्तः स च दष्टोऽन्वबुध्यत।\nससंज्ञश्चापि संवृत्तश्छित्त्वा बन्धनमाशु नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007035, "chapter_id": 1137, "verse_number": "१-१३८-३३", "content_sanskrit": "पोथयन्तं महाबाहुं त्वं वै तं ज्ञातुमर्हसि।\nततो वासुकिरभ्येत्य नागैरनुगतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007036, "chapter_id": 1137, "verse_number": "१-१३८-३४", "content_sanskrit": "पश्यति स्म महाबाहुं भीमं भीमपराक्रमम्।\nआर्यकेण च दृष्टः स पृथाया आर्यकेम च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007037, "chapter_id": 1137, "verse_number": "१-१३८-३५", "content_sanskrit": "तदा दौहित्रदौहित्रः परिष्वक्तः सुपीडितम्।\nसुप्रीतश्चाभवत्तस्य वासुकिः स महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007038, "chapter_id": 1137, "verse_number": "१-१३८-३६", "content_sanskrit": "अब्रवीत्तं च नागेन्द्रः किमस्य क्रियतां प्रियम्।\nधनौघो रत्ननिचयो वसु चास्य प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007039, "chapter_id": 1137, "verse_number": "१-१३८-३७", "content_sanskrit": "एवमुक्तस्तदा नागो वासुकिं प्रत्यभाषत।\nयदि नागेन्द्र तुष्टोऽसि किमस्य धनसंचयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007040, "chapter_id": 1137, "verse_number": "१-१३८-३८", "content_sanskrit": "रसं पिबेत्कुमारोऽयं त्वयि प्रीते महाबलः।\nबलं नागसहस्रस्य यस्मिन्कुण्डे प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007041, "chapter_id": 1137, "verse_number": "१-१३८-३९", "content_sanskrit": "यावत्पिबति बालोऽयं तावदस्मै प्रदीयताम्।\nएवमस्त्विति तं नागं वासुकिः प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007042, "chapter_id": 1137, "verse_number": "१-१३८-४०", "content_sanskrit": "ततो भीमस्तदा नागैः कृतस्वस्त्ययनः शुचिः।\nप्राङ्मुखश्चोपविष्टश्च रसं पिबति पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007043, "chapter_id": 1137, "verse_number": "१-१३८-४१", "content_sanskrit": "एकोच्छ्वासात्ततः कुण्डं पिबति स्म महाबलः।\nएवमष्टौ स कुण्डानि ह्यपिबत्पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007044, "chapter_id": 1137, "verse_number": "१-१३८-४२", "content_sanskrit": "ततस्तु शयने दिव्ये नागदत्ते महाभुजः।\nअशेत भीमसेनस्तु यथासुखमरिंदमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007045, "chapter_id": 1137, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अष्टत्रिंशदधिकशततमोऽध्यायः॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]