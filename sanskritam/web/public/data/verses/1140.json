[{"id": 2007170, "chapter_id": 1140, "verse_number": "१-१४१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007171, "chapter_id": 1140, "verse_number": "१-१४१-१", "content_sanskrit": "ततो द्रुपदमासाद्य भारद्वाजः प्रतापवान्।\nअब्रवीत्पार्थिवं राजन्सखायं विद्धि मामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007172, "chapter_id": 1140, "verse_number": "१-१४१-२", "content_sanskrit": "इत्येवमुक्तः सख्या स प्रीतिर्पूर्वं जनेश्वरः।\nभारद्वाजेन पाञ्चाल्यो नामृष्यत वचोऽस्य तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007173, "chapter_id": 1140, "verse_number": "१-१४१-३", "content_sanskrit": "स क्रोधामर्षजिह्मभ्रूः कषायीकृतलोचनः।\nऐश्वर्यमदसंपन्नो द्रोणं राजाऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007174, "chapter_id": 1140, "verse_number": "१-१४१-४x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007175, "chapter_id": 1140, "verse_number": "१-१४१-४", "content_sanskrit": "अकृतेयं तव प्रज्ञा ब्रह्मन्नातिसमञ्जसा।\nयन्मां व्रवीषि प्रसभं सखा तेऽहमिति द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007176, "chapter_id": 1140, "verse_number": "१-१४१-५", "content_sanskrit": "न हि राज्ञामुदीर्णानामेवंभूतैर्नरैः क्वचित्।\nसख्यं भवति मन्दात्मञ्श्रिया हीनैर्धनच्युतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007177, "chapter_id": 1140, "verse_number": "१-१४१-६", "content_sanskrit": "सौहृदान्यपि जीर्यन्ते कालेन परिजीर्यतः।\nसौहृदं मे त्वया ह्यासीत्पूर्वं सामर्थ्यबन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007178, "chapter_id": 1140, "verse_number": "१-१४१-७", "content_sanskrit": "न सख्यमजरं लोके हृदि तिष्ठति कस्यचित्।\nकामश्चैतन्नाशयति क्रोधो वैनं रहत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007179, "chapter_id": 1140, "verse_number": "१-१४१-८", "content_sanskrit": "मैवं जीर्णमुपास्स्व त्वं सख्यं भवदुपाधिकृत्।\nआसीत्सख्यं द्विजश्रेष्ठ त्वया मेऽर्थनिबन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007180, "chapter_id": 1140, "verse_number": "१-१४१-९", "content_sanskrit": "न दरिद्रो वसुमतो नाविद्वान्विदुषः सखा।\nन शूरस्य सखा क्लीबः सखिपूर्वं किमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007181, "chapter_id": 1140, "verse_number": "१-१४१-१०", "content_sanskrit": "ययोरेव समं वित्तं ययोरेव समं श्रुतम्।\nतयोर्विवाहः सख्यं च न तु पुष्टविपुष्टयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007182, "chapter_id": 1140, "verse_number": "१-१४१-११", "content_sanskrit": "नाश्रोत्रियः श्रोत्रियस्य नारथी रथिनः सखा।\nनाराजा पार्थिवस्यापि सखिपूर्वं किमिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007183, "chapter_id": 1140, "verse_number": "१-१४१-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007184, "chapter_id": 1140, "verse_number": "१-१४१-१२", "content_sanskrit": "द्रुपदेनैवमुक्तस्तु भारद्वाजः प्रतापवान्।\nमुहूर्तं चिन्तयित्वा तु मन्युनाऽभिपरिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007185, "chapter_id": 1140, "verse_number": "१-१४१-१३", "content_sanskrit": "स विनिश्चित्य मनसा पाञ्चाल्यं प्रतिबुद्धिमान्।\nशिष्यैः परिवृतः श्रीमान्पुत्रेण सहितस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007186, "chapter_id": 1140, "verse_number": "१-१४१-१४", "content_sanskrit": "जगाम कुरुमुख्यानां नागरं नागसाह्वयम्।\nतां प्रतिज्ञां प्रतिज्ञाय यां कर्ता नचिरादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007187, "chapter_id": 1140, "verse_number": "१-१४१-१५", "content_sanskrit": "स नागपुरमागम्य गौतमस्य निवेशने।\nभारद्वाजोऽवसत्तत्र प्रच्छन्नं द्विजसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007188, "chapter_id": 1140, "verse_number": "१-१४१-१६", "content_sanskrit": "ततोऽस्य तनुजः पार्थान्कृपस्यानन्तरं प्रभुः।\nअस्त्राणि शिक्षयामास नाबुध्यन्त च तं जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007189, "chapter_id": 1140, "verse_number": "१-१४१-१७", "content_sanskrit": "एवं स तत्र गूढात्मा कंचित्कालमुवास ह।\nकुमारास्त्वथ निष्क्रम्य समेता गजसाह्वयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007190, "chapter_id": 1140, "verse_number": "१-१४१-१८", "content_sanskrit": "क्रीडन्तो वीटया तत्र वीराः पर्यचरन्मुदा।\nतेषां संक्रीडमानानामुदपानेऽङ्गुलीयकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007191, "chapter_id": 1140, "verse_number": "१-१४१-१९", "content_sanskrit": "पपात धर्मपुत्रस्य वीटा तत्रैव चापतत्।\nगर्तान्बुना प्रतिच्छन्नं तारारूपमिवाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007192, "chapter_id": 1140, "verse_number": "१-१४१-२०", "content_sanskrit": "दृष्ट्वा चैते कुमाराश्च तं यत्नात्पर्यवारयन्।\nततस्ते यत्नमातिष्ठन्वीटामुद्धर्तुमादृताः।\nन च ते प्रत्ययद्यन्त कर्म वीटोपलब्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007193, "chapter_id": 1140, "verse_number": "१-१४१-२१", "content_sanskrit": "ततोऽन्योन्यमवैक्षन्त व्रीडयावनताननाः।\nतस्या योगमविदन्तो भृशं चोत्कण्ठिताभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007194, "chapter_id": 1140, "verse_number": "१-१४१-२२", "content_sanskrit": "तेऽपश्यन्ब्राह्मणं श्याममापन्नं पलितं कृशम्।\nकृत्यवन्तमदूरस्थमग्निहोत्रपुरस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007195, "chapter_id": 1140, "verse_number": "१-१४१-२३", "content_sanskrit": "ते तं दृष्ट्वा महातमानमुपगम्य कुमारकाः।\nभग्नोत्साहक्रियात्मानो ब्राह्मणं पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007196, "chapter_id": 1140, "verse_number": "१-१४१-२४", "content_sanskrit": "अथ द्रोणः कुमारांस्तान्दृष्ट्वा कत्यवशस्तदा।\nप्रहस्य मन्दं पैशल्यादभ्यभाषत वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007197, "chapter_id": 1140, "verse_number": "१-१४१-२५", "content_sanskrit": "अहो वो धिग्बलं क्षात्रं धिगेतां वः कृतास्त्रताम्।\nभरतस्यान्वये जाता ये वीटां नाधिगच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007198, "chapter_id": 1140, "verse_number": "१-१४१-२६", "content_sanskrit": "वीटां च मुद्रिकां चैव ह्यहमेतदपि द्वयम्।\nउद्धरेयमिषीकाभिर्भोजनं मे प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007199, "chapter_id": 1140, "verse_number": "१-१४१-२७", "content_sanskrit": "ततोऽब्रवीत्तदा द्रोणं कुन्तीपुत्रो युधिष्ठिरः।\nकृपस्यानुमते ब्रह्मन्भिक्षामाप्नुहि शाश्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007200, "chapter_id": 1140, "verse_number": "१-१४१-२८", "content_sanskrit": "एवमुक्तः प्रत्युवाच प्रहस्य भरतानिदम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007201, "chapter_id": 1140, "verse_number": "१-१४१-२८x", "content_sanskrit": "द्रोण उवाच।\nएषा मुष्टिरिषीकाणां मयाऽस्त्रेणाभिमन्त्रिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007202, "chapter_id": 1140, "verse_number": "१-१४१-२९", "content_sanskrit": "अस्या वीर्यं निरीक्षध्वं यदन्येषु न विद्यते।\nवेत्स्यामीषिकया वीटां तामिषीकां तथाऽन्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007203, "chapter_id": 1140, "verse_number": "१-१४१-३०", "content_sanskrit": "तामन्यया समायोगे वीटाया ग्रहणं मम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007204, "chapter_id": 1140, "verse_number": "१-१४१-३०x", "content_sanskrit": "वैशम्पायन उवाच।\nततो यथोक्तं द्रोणेन तत्सर्वं कृतमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007205, "chapter_id": 1140, "verse_number": "१-१४१-३१", "content_sanskrit": "तदवेक्ष्य कुमारास्ते विस्मयोत्फुल्ललोचनाः।\nआश्चर्यमिदमत्यन्तमिति मत्वा वचोऽब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007206, "chapter_id": 1140, "verse_number": "१-१४१-३२", "content_sanskrit": "मुद्रिकामणि विप्रर्षे शीध्रमेतां समुद्धरथ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007207, "chapter_id": 1140, "verse_number": "१-१४१-३२x", "content_sanskrit": "वैशम्पायन उवाच।\nततः शरं समादाय धनुश्चापि महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007208, "chapter_id": 1140, "verse_number": "१-१४१-३३", "content_sanskrit": "शरेण विद्ध्वा मुद्रां तामूर्ध्वमावाहयत्प्रभुः।\nस शरं समुपादाय कूपादङ्गुलिवेष्टनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007209, "chapter_id": 1140, "verse_number": "१-१४१-३४", "content_sanskrit": "ददौ ततः कुमाराणां विस्मितानामविस्मितः।\nमुद्रिकामुद्धृतां दृष्ट्वा तमाहुस्ते कुमारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007210, "chapter_id": 1140, "verse_number": "१-१४१-३५", "content_sanskrit": "अभिवन्दामहे ब्रह्मन्नैतदन्येषु विद्यते।\nकोऽसि कस्यासि जानीमो वयं किं करवामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007211, "chapter_id": 1140, "verse_number": "१-१४१-३६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007212, "chapter_id": 1140, "verse_number": "१-१४१-३६", "content_sanskrit": "एवमुक्तस्ततो द्रोणः प्रत्युवाच कुमारकान्।\nआचक्षध्वं च भीष्माय रूपेण च गुणैश्च माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007213, "chapter_id": 1140, "verse_number": "१-१४१-३७", "content_sanskrit": "स एव सुमहातेजाः सांप्रतं प्रतिपत्स्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007214, "chapter_id": 1140, "verse_number": "१-१४१-३७x", "content_sanskrit": "वैशम्पायन उवाच।\nतथेत्युक्त्वा च गत्वा च भीष्ममूचुः कुमारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007215, "chapter_id": 1140, "verse_number": "१-१४१-३८", "content_sanskrit": "ब्राह्मणस्य वचः कृत्स्नं तच्च कर्म तथाविधम्।\nभीष्मः श्रुत्वा कुमाराणां द्रोणं तं प्रत्यजानत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007216, "chapter_id": 1140, "verse_number": "१-१४१-३९", "content_sanskrit": "युक्तरूपः स हि गुरुरित्येवमनुचिन्त्य च।\nअथैनमानीय तदा स्वयमेव सुसत्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2007217, "chapter_id": 1140, "verse_number": "१-१४१-४०", "content_sanskrit": "परिपप्रच्छ निपुणं भीष्मः शस्त्रभृतां वरः।\nहेतुमागमने तच्च द्रोणः सर्वं न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2007218, "chapter_id": 1140, "verse_number": "१-१४१-४१x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2007219, "chapter_id": 1140, "verse_number": "१-१४१-४१", "content_sanskrit": "महर्षेरग्निवेश्यस्य सकाशमहमच्युत।\nअस्त्रार्थमगमं पूर्वं धनुर्वेदजिघृक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2007220, "chapter_id": 1140, "verse_number": "१-१४१-४२", "content_sanskrit": "ब्रह्मचारी विनीतात्मा जटिलो बहुलाः समाः।\nअवसं सुचिरं तत्र गुरुशुश्रूषणे रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2007221, "chapter_id": 1140, "verse_number": "१-१४१-४३", "content_sanskrit": "पाञ्चाल्यो राजपुत्रश्च यज्ञसेनो महाबलः।\nइष्वस्त्रहेतोर्न्यवसत्तस्मिन्नेव गुरौ प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2007222, "chapter_id": 1140, "verse_number": "१-१४१-४४", "content_sanskrit": "स मे तत्र सखा चासीदुपकारी प्रियश्च मे।\nतेनाहं सह संगम्य वर्तयन्सुचिरं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2007223, "chapter_id": 1140, "verse_number": "१-१४१-४५", "content_sanskrit": "बाल्यात्प्रभृति कौरव्य सहाध्ययनमेव च।\nस मे सखा सदा तत्र प्रियवादी प्रियंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2007224, "chapter_id": 1140, "verse_number": "१-१४१-४६", "content_sanskrit": "अब्रवीदिति मां भीष्म वचनं प्रीतिवर्धनम्।\nअहं प्रियतमः पुत्रः पितुर्द्रोण महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2007225, "chapter_id": 1140, "verse_number": "१-१४१-४७", "content_sanskrit": "अभिषेक्ष्यति मां राज्ये स पाञ्चाल्यो यदा तदा।\nतद्भोज्यं भवता राज्यमर्धं सत्येन ते शपे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2007226, "chapter_id": 1140, "verse_number": "१-१४१-४८", "content_sanskrit": "मम भोगाश्च वित्तं च त्वदधीनं सुखानि च।\nएवमुक्त्वाऽथ वव्राज कृतास्त्रः पूजितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2007227, "chapter_id": 1140, "verse_number": "१-१४१-४९", "content_sanskrit": "तच्च वाक्यमहं नित्यं मनसा धारयंस्तदा।\nसोऽहं पितृनियोगेन पुत्रलोभाद्यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2007228, "chapter_id": 1140, "verse_number": "१-१४१-५०", "content_sanskrit": "शारद्वतीं महाप्रज्ञामुपयेमे महाव्रताम्।\nअग्निहोत्रे च सत्रे च दमे च सततं रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2007229, "chapter_id": 1140, "verse_number": "१-१४१-५१", "content_sanskrit": "लेभे च गौतमी पुत्रमश्वत्थामानमौरसम्।\nभीमविक्रमकर्माणमादित्यसमतेजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2007230, "chapter_id": 1140, "verse_number": "१-१४१-५२", "content_sanskrit": "पुत्रेण तेन प्रीतोऽहं भरद्वाजो मया यथा।\nगोक्षीरं पिबतो दृष्ट्वा धनिनस्तत्र पुत्रकान्।\nअश्वत्थामारुदद्बालस्तन्मे संदेहयद्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2007231, "chapter_id": 1140, "verse_number": "१-१४१-५३", "content_sanskrit": "न स्नातकोऽवसीदेत वर्तमानः स्वकर्मसु।\nइति संचिन्त्य मनसा तं देशं बहुशो भ्रमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2007232, "chapter_id": 1140, "verse_number": "१-१४१-५४", "content_sanskrit": "विशुद्धणिच्छन्गाङ्गेय धर्मोपेतं प्रतिग्रहम्।\nअन्तादन्तं परिक्रम्य नाध्यगच्छं पयस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2007233, "chapter_id": 1140, "verse_number": "१-१४१-५५", "content_sanskrit": "यवपिष्टोदकेनैनं लोभयेयं कुमारकम्।\nपीत्वा पिष्टरसं बालः क्षीरं पीतं मयाऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2007234, "chapter_id": 1140, "verse_number": "१-१४१-५६", "content_sanskrit": "ननर्तोत्थाय कौरव्य हृष्टो बाल्याद्विमोहितः।\nतं दृष्ट्वा नृत्यमानं तु बालैः परिवृतं सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2007235, "chapter_id": 1140, "verse_number": "१-१४१-५७", "content_sanskrit": "हास्यतामुपसंप्राप्तं कश्मलं तत्र मेऽभवत्।\nद्रोणं धिगस्त्वधनिनं यो धनं नाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2007236, "chapter_id": 1140, "verse_number": "१-१४१-५८", "content_sanskrit": "पिष्टोदकं सुतो यस्य पीत्वा क्षीरस्य तृष्णया।\nनृत्यतिस्म मुदाविष्टः क्षीरं पीतं मयाऽप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2007237, "chapter_id": 1140, "verse_number": "१-१४१-५९", "content_sanskrit": "इति संभाषतां वाचं श्रुत्वा मे बुद्धिरच्यवत्।\nआत्मानं चात्मना गर्हन्मनसेदं व्यचिन्तयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2007238, "chapter_id": 1140, "verse_number": "१-१४१-६०", "content_sanskrit": "अपि चाहं पुरा विप्रैर्वर्जितो गर्हितो वसे।\nपरोपसेवां पापिष्ठां न च कुर्यां धनेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2007239, "chapter_id": 1140, "verse_number": "१-१४१-६१", "content_sanskrit": "इति मत्वा प्रियं पुत्रं भीष्मादाय ततो ह्यहम्।\nपूर्वस्नेहानुरागित्वात्सदारः सौमकिं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2007240, "chapter_id": 1140, "verse_number": "१-१४१-६२", "content_sanskrit": "अभिषिक्तं तु श्रुत्वैव कृतार्थोऽस्मीति चिन्तयन्।\nप्रियं सखायं सुप्रीतो राज्यस्थं समुपागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2007241, "chapter_id": 1140, "verse_number": "१-१४१-६३", "content_sanskrit": "संस्मरन्सङ्गमं चैव वचनं चैव तस्य तत्।\nततो द्रुपदमागम्य सखइपूर्वमहं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2007242, "chapter_id": 1140, "verse_number": "१-१४१-६४", "content_sanskrit": "अब्रुवं पुरुषव्याघ्र सखायं विद्धि मामिति।\nउपस्थितस्तु द्रुपदं सखिवच्चास्मि सङ्गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2007243, "chapter_id": 1140, "verse_number": "१-१४१-६५", "content_sanskrit": "स मां निराकारमिव प्रहसन्निदमब्रवीत्।\nअकृतेयं तव प्रज्ञा ब्रह्मन्नातिसमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2007244, "chapter_id": 1140, "verse_number": "१-१४१-६६", "content_sanskrit": "यदात्थ मां त्वं प्रसभं सखा तेऽहमिति द्विज।\nसंगतनीह जीर्यन्ति कालेन परिजीर्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2007245, "chapter_id": 1140, "verse_number": "१-१४१-६७", "content_sanskrit": "सौहृदं मे त्वया ह्यासीत्पूर्वं सामर्थ्यबन्धनम्।\nनाश्रोत्रियः श्रोत्रियस्य नारथी रथिनः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2007246, "chapter_id": 1140, "verse_number": "१-१४१-६८", "content_sanskrit": "साम्याद्धि सख्यं भवति वैषम्यान्नोपपद्यते।\nन सख्यमजरं लोके विद्यते जातु कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2007247, "chapter_id": 1140, "verse_number": "१-१४१-६९", "content_sanskrit": "कामो वैनं विहरति क्रोधो वैनं रहत्युत।\nमैवं जीर्णमुपास्स्व त्वं सख्यं भवदुपाधिकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2007248, "chapter_id": 1140, "verse_number": "१-१४१-७०", "content_sanskrit": "आसीत्सख्यं द्विजश्रेष्ठ त्वया मेऽर्थनिबन्धनम्।\nनह्यनाढ्यः सखाऽऽढ्यस्य नाविद्वान्विदुषः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2007249, "chapter_id": 1140, "verse_number": "१-१४१-७१", "content_sanskrit": "न शूरस्य सखा क्लीबः सखिपूर्वं किमिष्यते।\nन हि राज्ञामुदीर्णानामेवं भूतैर्नरैः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2007250, "chapter_id": 1140, "verse_number": "१-१४१-७२", "content_sanskrit": "सख्यं भवति मन्दात्मञ्छ्रिया हीनैर्धनच्युतैः।\nनाश्रोत्रियः श्रोत्रियस्य नारथी रथिनः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2007251, "chapter_id": 1140, "verse_number": "१-१४१-७३", "content_sanskrit": "नाराजा पार्थिवस्यापि सखिपूर्वं किमिष्यते।\nअहं त्वया न जानामि राज्यार्थे संविदं कृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2007252, "chapter_id": 1140, "verse_number": "१-१४१-७४", "content_sanskrit": "एकरात्रं तु ते ब्रह्मन्कामं दास्यामि भोजनम्।\nएवमुक्तस्त्वहं तेन सदारः प्रस्थितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2007253, "chapter_id": 1140, "verse_number": "१-१४१-७५", "content_sanskrit": "तां प्रतिज्ञां प्रतिज्ञाय यां कर्ताऽस्म्यचिरादिव।\nद्रुपदेनैवमुक्तोऽहं मन्युनाऽभिपरिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2007254, "chapter_id": 1140, "verse_number": "१-१४१-७६", "content_sanskrit": "अभ्यागच्छं कुरून्भीष्म शिष्यैरर्थी गुणान्वितैः।\nततोऽहं भवतः कामं संवर्धयितुमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2007255, "chapter_id": 1140, "verse_number": "१-१४१-७७", "content_sanskrit": "इदं नागपुरं रम्यं ब्रूहि किं करवाणि ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2007256, "chapter_id": 1140, "verse_number": "१-१४१-७७x", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्तस्तदा भीष्मो भारद्वाजमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2007257, "chapter_id": 1140, "verse_number": "१-१४१-७८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2007258, "chapter_id": 1140, "verse_number": "१-१४१-७८", "content_sanskrit": "अपज्यं क्रियतां चापं साध्वस्त्रं प्रतिपादय।\nभुङ्क्ष भोगान्भृशं प्रीतः पूज्यमानः कुरुक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2007259, "chapter_id": 1140, "verse_number": "१-१४१-७९", "content_sanskrit": "कुरूणामस्ति यद्वित्तं राज्यं चेदं सराष्ट्रकम्।\nत्वमेव परमो राजा सर्वे वाक्यकरास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2007260, "chapter_id": 1140, "verse_number": "", "content_sanskrit": "यच्च ते प्रार्थितं ब्रह्मन्कृतं तदिति चिन्त्यताम्।\nदिष्ट्या प्राप्तोऽसि विप्रर्षे महान्मेऽनुग्रहः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]