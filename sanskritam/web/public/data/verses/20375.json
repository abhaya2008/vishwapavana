[{"id": 7000375000, "chapter_id": 20375, "verse_number": "२-४७-१", "content_sanskrit": "सप्तचत्वारिंशोऽध्यायः ।\nसुकलोवाच ।\nसुदेवा चारुसर्वांगी तामुवाचाथ सूकरीम् ।\nपशुयोनिं गता त्वं हि कथं वदसि संस्कृतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000375001, "chapter_id": 20375, "verse_number": "२-४७-२", "content_sanskrit": "एवंविधं महाज्ञानं कस्माद्भूतं वदस्व मे ।\nकथं जानासि वै भर्तुश्चरित्रमात्मनः शुभे॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000375002, "chapter_id": 20375, "verse_number": "२-४७-३", "content_sanskrit": "शूकर्युवाच ।\nपशोर्भावेन मोहेन मुष्टाहं वरवर्णिनि ।\nनिहता खड्गबाणैश्च पतिता रणमूर्धनि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000375003, "chapter_id": 20375, "verse_number": "२-४७-४", "content_sanskrit": "मूर्च्छयाभिपरिक्लिन्ना ज्ञानहीना वरानने ।\nत्वयाभिषिक्ता येनाहं पुण्यहस्तेन सुंदरि॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000375004, "chapter_id": 20375, "verse_number": "२-४७-५", "content_sanskrit": "पुण्योदकेन शीतेन तव हस्तगतेन वै ।\nअभिषिक्ते हि मे काये मोहो नष्टो विहाय माम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000375005, "chapter_id": 20375, "verse_number": "२-४७-६", "content_sanskrit": "यथा विनाशं तेजोभिरंधकारः प्रयाति सः ।\nतथा तवाभिषेकेण मम पापं गतं शुभे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000375006, "chapter_id": 20375, "verse_number": "२-४७-७", "content_sanskrit": "प्रसादात्तव चार्वंगि लब्धं ज्ञानं पुरातनम् ।\nपुण्यां गतिं प्रयास्यामि इति ज्ञातं मया शुभे॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000375007, "chapter_id": 20375, "verse_number": "२-४७-८", "content_sanskrit": "श्रूयतामभिधास्यामि पूर्वं वृत्तांतमात्मनः ।\nयत्कृतं तु मया भद्रे पापया दुष्कृतं बहु॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000375008, "chapter_id": 20375, "verse_number": "२-४७-९", "content_sanskrit": "कलिंगाख्ये महादेशे श्रीपुरंनाम पत्तनम् ।\nसर्वसिद्धिसमाकीर्णं चतुर्वर्णनिषेवितम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000375009, "chapter_id": 20375, "verse_number": "२-४७-१०", "content_sanskrit": "वसति स्म द्विजः कोपि वसुदत्त इति श्रुतः ।\nब्रह्माचारपरोनित्यं सत्यधर्मपरायणः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000375010, "chapter_id": 20375, "verse_number": "२-४७-११", "content_sanskrit": "वेदवेत्ता ज्ञानवेत्ता शुचिमान्गुणवान्धनी ।\nधनधान्यसमाकीर्णः पुत्रपौत्रैरलंकृतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000375011, "chapter_id": 20375, "verse_number": "२-४७-१२", "content_sanskrit": "तस्याहं तनया भद्रे सोदरैः स्वजनबांधवैः ।\nअलंकारैस्तु शृंगारैर्भूषितास्मि वरानने॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000375012, "chapter_id": 20375, "verse_number": "२-४७-१३", "content_sanskrit": "सुदेवानाम मे तातश्चकार स महामतिः ।\nतस्याहं दयिता नित्यं पितुश्चापि महामते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000375013, "chapter_id": 20375, "verse_number": "२-४७-१४", "content_sanskrit": "रूपेणाप्रतिमा जाता संसारे नास्ति तादृशी ।\nरूपयौवनगर्वेण मत्ताहं चारुहासिनी॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000375014, "chapter_id": 20375, "verse_number": "२-४७-१५", "content_sanskrit": "अहं कन्या सुरूपा वै सर्वालंकारशोभिता ।\nमां च दृष्ट्वा ततो लोकाः सर्वे स्वजनवर्गकाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000375015, "chapter_id": 20375, "verse_number": "२-४७-१६", "content_sanskrit": "मामेवं याचमानास्ते विवाहार्थे वरानने ।\nयाचिताहं द्विजैः सर्वैर्न ददाति पिता मम॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000375016, "chapter_id": 20375, "verse_number": "२-४७-१७", "content_sanskrit": "स्नेहाच्चैव महाभागे मुमोह स महामतिः ।\nन दत्ताहं तदा तेन पित्रा चैव महात्मना॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000375017, "chapter_id": 20375, "verse_number": "२-४७-१८", "content_sanskrit": "संप्राप्तं यौवनं बाले मयि भावसमन्वितम् ।\nरूपं मे तादृशं दृष्ट्वा मम माता सुदुःखिता॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000375018, "chapter_id": 20375, "verse_number": "२-४७-१९", "content_sanskrit": "पितरं मे उवाचाथ कस्मात्कन्या न दीयते ।\nत्वं कस्मै सुद्विजायैव ब्राह्मणाय महात्मने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000375019, "chapter_id": 20375, "verse_number": "२-४७-२०", "content_sanskrit": "देहि कन्यां महाभाग संप्राप्ता यौवनं त्वियम् ।\nवसुदत्तो द्विजश्रेष्ठः प्रत्युवाच द्विजोत्तमः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000375020, "chapter_id": 20375, "verse_number": "२-४७-२१", "content_sanskrit": "मातरं मे महाभागे श्रूयतां वचनं मम ।\nमहामोहेनमुग्धोऽस्मि सुताया वरवर्णिनि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000375021, "chapter_id": 20375, "verse_number": "२-४७-२२", "content_sanskrit": "यो मे गृहस्थो विप्रो वै भविष्यति शुभे शृणु ।\nतस्मै कन्यां प्रदास्यामि जामात्रे तु न संशयः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000375022, "chapter_id": 20375, "verse_number": "२-४७-२३", "content_sanskrit": "मम प्राणप्रिया चैषा सुदेवा नात्र संशयः ।\nएवमूचे मदर्थे स वसुदत्तः पिता मम॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000375023, "chapter_id": 20375, "verse_number": "२-४७-२४", "content_sanskrit": "कौशिकस्य कुले जातः सर्वविद्याविशारदः ।\nब्राह्मणानां गुणैर्युक्तः शीलवान्गुणवाञ्छुचिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000375024, "chapter_id": 20375, "verse_number": "२-४७-२५", "content_sanskrit": "वेदाध्ययनसंपन्नं पठमानं हि सुस्वरम् ।\nभिक्षार्थं द्वारमायांतं पितृमातृविवर्जितम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000375025, "chapter_id": 20375, "verse_number": "२-४७-२६", "content_sanskrit": "तं दृष्ट्वासमनुप्राप्तं रूपं वीक्ष्य महामतिः ।\nतं प्रोवाच पिता एवं को भवान्वै भविष्यति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000375026, "chapter_id": 20375, "verse_number": "२-४७-२७", "content_sanskrit": "किं ते नाम कुलं गोत्रमाचारं वद सांप्रतम् ।\nसमाकर्ण्य पितुर्वाक्यं वसुदत्तमुवाच सः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000375027, "chapter_id": 20375, "verse_number": "२-४७-२८", "content_sanskrit": "कौशिकस्यान्वये जातो वेदवेदांगपारगः ।\nशिवशर्मेति मे नाम पितृमातृविवर्जितः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000375028, "chapter_id": 20375, "verse_number": "२-४७-२९", "content_sanskrit": "संति मे भ्रातरश्चान्ये चत्वारो वेदपारगाः ।\nएवं कुलं समाख्यातमाचारः कुलसंभवः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000375029, "chapter_id": 20375, "verse_number": "२-४७-३०", "content_sanskrit": "एवं सर्वं समाख्यातं पितरं शिवशर्मणा ।\nशुभे लग्ने तिथौ प्राप्ते नक्षत्रे भगदैवते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000375030, "chapter_id": 20375, "verse_number": "२-४७-३१", "content_sanskrit": "पित्रा दत्तास्मि सुभगे तस्मै विप्राय वै तदा ।\nपितृगेहे वसाम्येका तेन सार्धं महात्मना॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000375031, "chapter_id": 20375, "verse_number": "२-४७-३२", "content_sanskrit": "नैव शुश्रूषितो भर्ता मया स पापया तदा ।\nपितृमातृसुद्रव्येण गर्वेणापि प्रमोहिता॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000375032, "chapter_id": 20375, "verse_number": "२-४७-३३", "content_sanskrit": "अंगसंवाहनं तस्य न कृतं हि मया कदा ।\nरतिभावेन स्नेहेन वचनेन मया शुभे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000375033, "chapter_id": 20375, "verse_number": "२-४७-३४", "content_sanskrit": "क्रूरबुद्ध्या हि दृष्टोसौ सर्वदा पापया मया ।\nपुंश्चलीनां प्रसंगेन तद्भावं हि गता शुभे॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000375034, "chapter_id": 20375, "verse_number": "२-४७-३५", "content_sanskrit": "मातापित्रोश्च भर्तुश्च भ्रातॄणां हितमेव च ।\nन करोम्यहमेवापि यत्रयत्र व्रजाम्यहम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000375035, "chapter_id": 20375, "verse_number": "२-४७-३६", "content_sanskrit": "एवं मे दुष्कृतं दृष्ट्वा शिवशर्मा पतिर्मम ।\nस्नेहाच्छ्वशुरवर्गस्य मम भर्त्ता महामतिः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000375036, "chapter_id": 20375, "verse_number": "२-४७-३७", "content_sanskrit": "न किंचिद्वक्ति मां सोपि क्षमते दुष्कृतं मम ।\nवार्यमाणा कुटुंबेन अहमेवं सुपापिनी॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000375037, "chapter_id": 20375, "verse_number": "२-४७-३८", "content_sanskrit": "तस्य शीलं विदित्वा ते साधुत्वं शिवशर्मणः ।\nपितामाता च मे सर्वे मम पापेन दुःखिताः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000375038, "chapter_id": 20375, "verse_number": "२-४७-३९", "content_sanskrit": "भर्त्ता मे दुष्कृतं दृष्ट्वा स्वगृहान्निर्गतो बहिः ।\nतं देशं ग्राममेनं च परित्यज्य गतस्ततः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000375039, "chapter_id": 20375, "verse_number": "२-४७-४०", "content_sanskrit": "गते भर्तरि मे तातः संजातश्चिंतयान्वितः ।\nमम दुःखेन दुःखात्मा यथा रोगेण पीडितः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000375040, "chapter_id": 20375, "verse_number": "२-४७-४१", "content_sanskrit": "मम माता उवाचैनं भर्तारं दुःखपीडितम् ।\nकस्माच्चिंतयसे कांत वद दुःखं ममाग्रतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000375041, "chapter_id": 20375, "verse_number": "२-४७-४२", "content_sanskrit": "वसुदत्त उवाचैनां मातरं मम नंदने ।\nसुतां त्यक्त्वा गतो विप्रो जामाता शृणु वल्लभे॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000375042, "chapter_id": 20375, "verse_number": "२-४७-४३", "content_sanskrit": "इयं पापसमाचारा निर्घृणा पापचारिणी ।\nअनया हि परित्यक्तः शिवशर्मा महामतिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000375043, "chapter_id": 20375, "verse_number": "२-४७-४४", "content_sanskrit": "समस्तस्य कुटुंबस्य दाक्षिण्येन महामतिः ।\nममायं स द्विजः कांते सुदेवां नैव भाषते॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000375044, "chapter_id": 20375, "verse_number": "२-४७-४५", "content_sanskrit": "वसते सौम्यभावेन नैव निंदति कुत्सति ।\nसुदेवां पापसंचारां स वै पंडितबुद्धिमान्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000375045, "chapter_id": 20375, "verse_number": "२-४७-४६", "content_sanskrit": "भविष्यति त्वियं दुष्टा सुदेवा कुलनाशिनी ।\nअहमेनां परित्यज्य व्रजामि गृहवासिनि॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000375046, "chapter_id": 20375, "verse_number": "२-४७-४७", "content_sanskrit": "ब्राह्मण्युवाच ।\nअद्य ज्ञातं त्वया कांत सुताया गुणदूषणम् ।\nतव मोहेन स्नेहेन नष्टेयं शृणु सांप्रतम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000375047, "chapter_id": 20375, "verse_number": "२-४७-४८", "content_sanskrit": "तावद्विलाडयेत्पुत्रं यावत्स्यात्पंचवार्षिकः ।\nशिक्षाबुद्ध्या सदा कांत पुनर्मोहेन पोषयेत्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000375048, "chapter_id": 20375, "verse_number": "२-४७-४९", "content_sanskrit": "स्नानाच्छादनकैर्भक्ष्यैर्भोज्यैः पेयैर्न संशयः ।\nगुणेषु योजयेत्कांत सद्विद्यासु च तं सुतम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000375049, "chapter_id": 20375, "verse_number": "२-४७-५०", "content_sanskrit": "गुणशिक्षार्थंनिर्मोहः पिता भवति सर्वदा ।\nपालने पोषणे कांत संमोहः परिजायते॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000375050, "chapter_id": 20375, "verse_number": "२-४७-५१", "content_sanskrit": "सगुणं न वदेत्पुत्रं कुत्सयेच्च दिनेदिने ।\nकाठिन्यं च वदेन्नित्यं वचनैः परिपीडयेत्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000375051, "chapter_id": 20375, "verse_number": "२-४७-५२", "content_sanskrit": "यथाहि साधयेन्नित्यं सुविद्यां ज्ञानतत्परः ।\nअभिमानेच्छलेनापि पापं त्यक्त्वा प्रदूरतः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000375052, "chapter_id": 20375, "verse_number": "२-४७-५३", "content_sanskrit": "नैपुण्यं जायते नित्यं विद्यासु च गुणेषु च ।\nमाता च ताडयेत्कन्यां स्नुषां श्वश्रूर्विताडयेत्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000375053, "chapter_id": 20375, "verse_number": "२-४७-५४", "content_sanskrit": "गुरुश्च ताडयेच्छिष्यं ततः सिध्यंति नान्यथा ।\nभार्यां च ताडयेत्कांत अमात्यं नृपतिस्तथा॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000375054, "chapter_id": 20375, "verse_number": "२-४७-५५", "content_sanskrit": "हयं च ताडयेद्धीरो गजं मात्रो दिनेदिने ।\nशिक्षाबुद्ध्या प्रसिध्यंति ताडनात्पालनाद्विभो॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000375055, "chapter_id": 20375, "verse_number": "२-४७-५६", "content_sanskrit": "त्वयेयं नाशिता नाथ सर्वदैव न संशयः ।\nसार्धं सुब्राह्मणेनापि भवता शिवशर्मणा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000375056, "chapter_id": 20375, "verse_number": "२-४७-५७", "content_sanskrit": "निरंकुशा कृता गेहे तेन नष्टा महामते ।\nतावद्धि धारयेत्कन्यां गृहे कांतवचः शृणु॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000375057, "chapter_id": 20375, "verse_number": "२-४७-५८", "content_sanskrit": "अष्टवर्षान्विता यावत्प्रबलां नैव धारयेत् ।\nपितुर्गेहस्थिता पुत्री यत्पापं हि प्रकुर्वती॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000375058, "chapter_id": 20375, "verse_number": "२-४७-५९", "content_sanskrit": "उभाभ्यामपि तत्पापं पितृभ्यामपि विंदति ।\nतस्मान्न धार्यते कन्या समर्था निजमंदिरे॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000375059, "chapter_id": 20375, "verse_number": "२-४७-६०", "content_sanskrit": "यस्य दत्ता भवेत्सा च तस्य गेहे प्रपोषयेत् ।\nतत्रस्था साधयेत्कांतं सगुणं भक्तिपूर्वकम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000375060, "chapter_id": 20375, "verse_number": "२-४७-६१", "content_sanskrit": "कुलस्य जायते कीर्तिः पिता सुखेन जीवति ।\nतत्रस्था कुरुते पापं तत्पापं भुंजते पतिः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000375061, "chapter_id": 20375, "verse_number": "२-४७-६२", "content_sanskrit": "तत्रस्था वर्द्धते नित्यं पुत्रैः पौत्रैः सदैव सा ।\nपिता कीर्तिमवाप्नोति सुतायाः सुगुणैः प्रिय॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000375062, "chapter_id": 20375, "verse_number": "२-४७-६३", "content_sanskrit": "तस्मान्न धारयेत्कांत गेहे पुत्रीं सभर्तृकाम् ।\nइत्यर्थे श्रूयते कांत इतिहासो भविष्यति॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000375063, "chapter_id": 20375, "verse_number": "२-४७-६४", "content_sanskrit": "अष्टविंशतिके प्राप्ते युगे द्वापरके महान् ।\nउग्रसेनस्य वीरस्य यदुज्येष्ठस्य यत्प्रभो॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000375064, "chapter_id": 20375, "verse_number": "२-४७-६५", "content_sanskrit": "चरित्रं ते प्रवक्ष्यमि शृणुष्वैकमना द्विज॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]