[{"id": 2189668, "chapter_id": 5028, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2189669, "chapter_id": 5028, "verse_number": "१", "content_sanskrit": "क्षरात् प्रभृति यः सर्गः सगुणानीन्द्रियाणि च ।\nबुद्ध्यैश्वर्याभिसर्गार्थं यद् ध्यानं चात्मनः शुभम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2189670, "chapter_id": 5028, "verse_number": "२", "content_sanskrit": "भूय एव तु लोकेऽस्मिन् सद्वृत्तिं वृत्तिहैतुकीम् ।\nयया सन्तः प्रवर्तन्ते तदिच्छाम्यनुवर्णितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2189671, "chapter_id": 5028, "verse_number": "३", "content_sanskrit": "वेदे वचनमुक्तं तु कुरु कर्म त्यजेति च ।\nकथमेतद् विजानीयां तच्च व्याख्यातुमर्हसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2189672, "chapter_id": 5028, "verse_number": "४", "content_sanskrit": "लोकवृत्तान्ततत्त्वज्ञः पूतोऽहं गुरुशासनात् ।\nकृत्वा बुद्धिं वियुक्तात्मा त्यक्ष्याम्यात्मानमव्यथः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2189673, "chapter_id": 5028, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2189674, "chapter_id": 5028, "verse_number": "५", "content_sanskrit": "यैषा वै विहिता वृत्तिः पुरस्ताद्ब्रह्मणा स्वयम् ।\nएषा पूर्वतरैः सद्भिराचीर्णा परमर्षिभिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2189675, "chapter_id": 5028, "verse_number": "६", "content_sanskrit": "ब्रह्मचर्येण वै लोकान् जयन्ति परमर्षयः ।\nआत्मनश्च हृदि श्रेयस्त्वन्विच्छ मनसात्मनि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2189676, "chapter_id": 5028, "verse_number": "७", "content_sanskrit": "वने मूलफलाशी च तप्यन् सुविपुलं तपः ।\nपुण्यायतनचारी च भूतानामविहिंसकः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2189677, "chapter_id": 5028, "verse_number": "८", "content_sanskrit": "विधूमे सन्नमुसले वानप्रस्थप्रतिश्रये ।\nकाले प्राप्ते चरन् भैक्षं कल्पते ब्रह्मभूयसे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2189678, "chapter_id": 5028, "verse_number": "९", "content_sanskrit": "निःस्तुतिर्निर्नमस्कारः परित्यज्य शुभाशुभे ।\nअरण्ये विचरैकाकी येन केनचिदाशितः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2189679, "chapter_id": 5028, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2189680, "chapter_id": 5028, "verse_number": "१०", "content_sanskrit": "यदिदं वेदवचनं लोकवादे विरुद्ध्यते ।\nप्रमाणे चाप्रमाणे च विरुद्धे शास्त्रता कुतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2189681, "chapter_id": 5028, "verse_number": "११", "content_sanskrit": "इत्येतच्छ्रोतुमिच्छामि भगवान् प्रब्रवीतु मे ।\nकर्मणामविरोधेन कथमेतत् प्रवर्तते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2189682, "chapter_id": 5028, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2189683, "chapter_id": 5028, "verse_number": "१२", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं गन्धवत्याः सुतः सुतम् ।\nऋषिस्तत्पूजयन्वाक्यं पुत्रस्यामिततेजसः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2189684, "chapter_id": 5028, "verse_number": "१३", "content_sanskrit": "गृहस्थो ब्रह्मचारी च वानप्रस्थोऽथ भिक्षुकः ।\nयथोक्तकारिणः सर्वे गच्छन्ति परमां गतिम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2189685, "chapter_id": 5028, "verse_number": "१४", "content_sanskrit": "एको य आश्रमानेताननुतिष्ठेद्यथाविधि ।\nअकामद्वेषसंयुक्तः स परत्र महीयते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2189686, "chapter_id": 5028, "verse_number": "१५", "content_sanskrit": "चतुष्पदी हि निःश्रेणी ब्रह्मण्येषा प्रतिष्ठिता ।\nएतामाश्रित्य निःश्रेणीं ब्रह्मलोके महीयते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2189687, "chapter_id": 5028, "verse_number": "१६", "content_sanskrit": "आयुषस्तु चतुर्भागं ब्रह्मचार्यनसूयकः ।\nगुरौ वा गुरुपुत्रे वा वसेद्धर्मार्थकोविदः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2189688, "chapter_id": 5028, "verse_number": "१७", "content_sanskrit": "कर्मातिरेकेण गुरोरध्येतव्यं बुभूषता ।\nदक्षिणो नापवादी स्यादाहूतो गुरुमाश्रयेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2189689, "chapter_id": 5028, "verse_number": "१८", "content_sanskrit": "जघन्यशायी पूर्वं स्यादुत्थायी गुरुवेश्मनि ।\nयच्च शिष्येण कर्तव्यं कार्यं दासेन वा पुनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2189690, "chapter_id": 5028, "verse_number": "१९", "content_sanskrit": "कृतमित्येव तत् सर्वं कृत्वा तिष्ठेत पार्श्वतः ।\nकिङ्करः सर्वकारी च सर्वकर्मसु कोविदः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2189691, "chapter_id": 5028, "verse_number": "२०", "content_sanskrit": "शुचिर्दक्षो गुणोपेतो ब्रूयादिषुरिवात्वरः ।\nचक्षुषा गुरुमव्यग्रो निरीक्षेत जितेन्द्रियः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2189692, "chapter_id": 5028, "verse_number": "२१", "content_sanskrit": "नाभुक्तवति चाश्नीयादपीतवति नो पिबेत् ।\nन तिष्ठति तथासीत नासुप्ते प्रस्वपेत च\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2189693, "chapter_id": 5028, "verse_number": "२२", "content_sanskrit": "उत्तानाभ्यां च पाणिभ्यां पादावस्य मृदु स्पृशेत् ।\nदक्षिणं दक्षिणेनैव सव्यं सव्येन पीडयेत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2189694, "chapter_id": 5028, "verse_number": "२३", "content_sanskrit": "अभिवाद्य गुरुं ब्रूयादधीष्व भगवन्निति ।\nइदं करिष्ये भगवन्निदं चापि कृतं मया\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2189695, "chapter_id": 5028, "verse_number": "समाप्तिः", "content_sanskrit": "इति सर्वमनुज्ञाप्य निवेद्य गुरवे धनम् ।\nकुर्यात्कृत्वा च तत् सर्वमाख्येयं गुरवे पुनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2189696, "chapter_id": 5028, "verse_number": "२५", "content_sanskrit": "यांस्तु गन्धान् रसान् वापि ब्रह्मचारी न सेवते ।\nसेवेत तान् समावृत्त इति धर्मेषु निश्चयः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2189697, "chapter_id": 5028, "verse_number": "२६", "content_sanskrit": "ये केचिद् विस्तरेणोक्ता नियमा ब्रह्मचारिणः ।\nतान् सर्वाननुगृह्णीयाद् भवेच्चानपगो गुरोः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2189698, "chapter_id": 5028, "verse_number": "२७", "content_sanskrit": "स एवं गुरवे प्रीतिमुपहृत्य यथाबलम् ।\nआश्रमेष्वाश्रमेष्वेवं शिष्यो वर्तेत कर्मणा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2189699, "chapter_id": 5028, "verse_number": "२८", "content_sanskrit": "वेदव्रतोपवासेन चतुर्थे चायुषो गते ।\nगुरवे दक्षिणां दत्त्वा समावर्तेद् यथाविधि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2189700, "chapter_id": 5028, "verse_number": "२९", "content_sanskrit": "धर्मलब्धैर्युतो दारैरग्नीनुत्पाद्य धर्मतः ।\nद्वितीयमायुषो भागं गृहमेधिव्रती भवेत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2189701, "chapter_id": 5028, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे सप्तसप्ततितमोऽध्यायः ॥७७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]