[{"id": 7006312000, "chapter_id": 26312, "verse_number": "१-२२-१", "content_sanskrit": "मार्कण्डेय उवाच ततस्तं चक्रवाकौ द्वावूचतुः सहचारिणौ ।\nआवां ते सचिवौ स्यावस्तव प्रियहितैषिणौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006312001, "chapter_id": 26312, "verse_number": "१-२२-२", "content_sanskrit": "तथेत्युक्त्वा च तस्यासीत्तदा योगात्मिका मतिः ।\nएवं ते समयं चक्रुः शुचिवाक् तमुवाच ह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006312002, "chapter_id": 26312, "verse_number": "१-२२-३", "content_sanskrit": "यस्मात् कामप्रधानस्त्वं योगधर्ममपास्य वै ।\nएवं वरं प्रार्थयसे तस्माद् वाक्यं निबोध मे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006312003, "chapter_id": 26312, "verse_number": "१-२२-४", "content_sanskrit": "राजा त्वं भविता तात काम्पिल्ये नात्र संशयः ।\nभविष्यतः सखायौ च द्वाविमौ सचिवौ तव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006312004, "chapter_id": 26312, "verse_number": "१-२२-५", "content_sanskrit": "शप्त्वा चानभिभाष्यांस्तांश्चत्वारश्चक्रुरण्डजाः ।\nतांस्त्रीनभीप्सतो राज्यं व्यभिचारप्रदर्शितान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006312005, "chapter_id": 26312, "verse_number": "१-२२-६", "content_sanskrit": "शप्ताः खगास्त्रयस्ते तु योगभ्रष्टा विचेतसः ।\nतानयाचन्त चतुरस्त्रयस्ते सहचारिणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006312006, "chapter_id": 26312, "verse_number": "१-२२-७", "content_sanskrit": "तेषां प्रसादं ते चक्रुरथैतान्सुमनाऽब्रवीत् ।\nसर्वेषामेव वचनात्प्रसादानुगतं वचः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006312007, "chapter_id": 26312, "verse_number": "१-२२-८", "content_sanskrit": "अन्तवान् भविता शापो युष्माकं नात्र संशयः ।\nइतश्च्युताश्च मानुष्यं प्राप्य योगमवाप्स्यथ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006312008, "chapter_id": 26312, "verse_number": "१-२२-९", "content_sanskrit": "सर्वसत्त्वरुतज्ञश्च स्वतन्त्रोऽयं भविष्यति ।\nपितृप्रसादो ह्यस्माभिरस्य प्राप्तः कृतेन वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006312009, "chapter_id": 26312, "verse_number": "१-२२-१०", "content_sanskrit": "गां प्रोक्षयित्वा धर्मेण पितृभ्य उपकल्प्यताम् ।\nअस्माकं ज्ञानसंयोगः सर्वेषां योगसाधनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006312010, "chapter_id": 26312, "verse_number": "१-२२-११", "content_sanskrit": "इमं च वाक्यसंदर्भश्लोकमेकमुदाहृतम् ।\nपुरुषान्तरितं श्रुत्वा ततो योगमवाप्स्यथ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]