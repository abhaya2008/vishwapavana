[{"id": 900001392, "chapter_id": 8232, "verse_number": "6.1", "content_sanskrit": "आत्मा वा इदमेक एवाग्र आसीत्, नान्यत् किञ्चन मिषत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001393, "chapter_id": 8232, "verse_number": "6.2", "content_sanskrit": "स ईक्षत इमान् लोकानु सृजा इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001394, "chapter_id": 8232, "verse_number": "6.3", "content_sanskrit": "तमभ्यतपत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001395, "chapter_id": 8232, "verse_number": "6.4", "content_sanskrit": "ता एता देवताः सृष्टा अस्मिन्महत्यर्णवे प्रापतन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001396, "chapter_id": 8232, "verse_number": "6.5", "content_sanskrit": "तमशनापिपासे अब्रूतां आवाभ्यामभि प्रजानीहि इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001397, "chapter_id": 8232, "verse_number": "6.6", "content_sanskrit": "सईक्षेत, इमे नु लोकाश्च लोकपालाश्चान्नमेभ्यः सृजा इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001398, "chapter_id": 8232, "verse_number": "6.7", "content_sanskrit": "तद्वाचाऽजिघृक्षत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001399, "chapter_id": 8232, "verse_number": "6.8", "content_sanskrit": "सईक्षत कथं विदं मदृते स्यादिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001400, "chapter_id": 8232, "verse_number": "6.9", "content_sanskrit": "स एतमेव सीमानं विदार्येतया द्वारा प्रापद्यत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001401, "chapter_id": 8232, "verse_number": "6.10", "content_sanskrit": "स जातो भूतान्यभिव्यैख्यत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001402, "chapter_id": 8232, "verse_number": "6.11", "content_sanskrit": "गुणपूर्णस्वरूपस्य त्वापरोक्ष्येण दर्शनात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001403, "chapter_id": 8232, "verse_number": "6.12", "content_sanskrit": "आततगुणत्वादात्मा नारायण:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001404, "chapter_id": 8232, "verse_number": "6.13", "content_sanskrit": "मत्सीन्द्रमिन्दो पवमान विष्णुम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900001405, "chapter_id": 8232, "verse_number": "6.14", "content_sanskrit": "यो देवानां नामधा एक एव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900001406, "chapter_id": 8232, "verse_number": "6.15", "content_sanskrit": "अग्रशब्दो गुणाधिक्यवाची", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900001407, "chapter_id": 8232, "verse_number": "6.16", "content_sanskrit": "सर्वजीवानां रमायाश्च प्रलयेऽपि विद्यमानत्वादेव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900001408, "chapter_id": 8232, "verse_number": "6.17", "content_sanskrit": "अं विष्णुं बिभर्तीत्यम्भो विष्णुलोको दिवः परः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900001409, "chapter_id": 8232, "verse_number": "6.18", "content_sanskrit": "या अधस्तात् पूर्वमेव सृष्टा देवतास्ता आप इत्युच्यन्ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900001410, "chapter_id": 8232, "verse_number": "6.19", "content_sanskrit": "ब्रह्मवायू च तद्भार्ये वीन्द्रशेषौ च तत्स्त्रियौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900001411, "chapter_id": 8232, "verse_number": "6.20", "content_sanskrit": "ते तु महादादीनां सर्वेऽपि ह्यभिमानिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900001412, "chapter_id": 8232, "verse_number": "6.21", "content_sanskrit": "अमूर्च्छयत् मूर्तमकरोत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900001413, "chapter_id": 8232, "verse_number": "6.22", "content_sanskrit": "यदि वागादीनामेवाभिव्याहरणादिशक्तिः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900001414, "chapter_id": 8232, "verse_number": "6.23", "content_sanskrit": "पूर्णानन्दस्वरूपत्वान्नन्दनो भगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900001415, "chapter_id": 8232, "verse_number": "6.24", "content_sanskrit": "एतमेव पुरुषं व्यासकृष्णकपिलराघवादिरूपं ततममपश्यत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]