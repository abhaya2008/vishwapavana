t": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017326, "chapter_id": 9260, "verse_number": "13", "content_sanskrit": "सर्वतश्चापितिष्ठध्वंस्स्वै: परिवृताबलैः ॥ द्रष्टव्यं च पदंतेषांवानराणांनिशाचराः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017327, "chapter_id": 9260, "verse_number": "14", "content_sanskrit": "प्रदोषेवार्धरात्रेवाप्रत्यूषेवापिसर्वत ॥ नावज्ञातेषुकर्तव्यावानरेषुकदाचन । द्विषतांबलमुद्युक्तमापतकतिंस्थितंसदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017328, "chapter_id": 9260, "verse_number": "15", "content_sanskrit": "प्रदोषेवार्धरात्रेवाप्रत्यूषेवापिसर्वत ॥ नावज्ञातेषुकर्तव्यावानरेषुकदाचन । द्विषतांबलमुद्युक्तमापतकतिंस्थितंसदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017329, "chapter_id": 9260, "verse_number": "16", "content_sanskrit": "ततस्तेराक्षसास्सर्वेश्रुत्वालङ्काधिपस्यतत् । वचनंसर्वमातिष्ठन् यथावत्तुमहाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017330, "chapter_id": 9260, "verse_number": "17", "content_sanskrit": "स तान् सर्वान् हिसन्दिश्यरावणोराक्षसाधिपः । मन्युशल्यंवहन् दीनःप्रविवेशस्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]