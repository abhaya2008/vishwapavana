[{"id": 2030783, "chapter_id": 1674, "verse_number": "३-३१२-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030784, "chapter_id": 1674, "verse_number": "३-३१२-१", "content_sanskrit": "एवं हृतायां भार्यायां प्राप्य क्लेशमनुत्तमम्।\nप्रतिपद्य ततः कृष्णां किमकुर्वत पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030785, "chapter_id": 1674, "verse_number": "३-३१२-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030786, "chapter_id": 1674, "verse_number": "३-३१२-२", "content_sanskrit": "एवं हृतायां कृष्णायां प्राप्य क्लेशमनुत्तमम्।\nविहाय काम्यकं राजा सह भ्रातृभिरच्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030787, "chapter_id": 1674, "verse_number": "३-३१२-३", "content_sanskrit": "पुनर्द्वैतवनं रम्यमाजगाम युधिष्ठिरः।\nस्वादुमूलफलं रम्यं विचित्रबहुपादपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030788, "chapter_id": 1674, "verse_number": "३-३१२-४", "content_sanskrit": "अनुभुक्तफलाहाराः सर्व एव मिताशनाः।\nन्यवसन्पाण्डवास्तत्रकृष्णया सह भार्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030789, "chapter_id": 1674, "verse_number": "३-३१२-५", "content_sanskrit": "वसन्द्वैतवने राजा कुन्तीपुत्रो युधिष्ठिरः।\nभीमसेनोऽर्जुनश्चैव माद्रीपुत्रौ च पाण्डवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030790, "chapter_id": 1674, "verse_number": "३-३१२-६", "content_sanskrit": "ब्राह्मणार्थे पराक्रान्ता धर्मात्मानो यतव्रताः।\nक्लेशमार्च्छन्त विपुलं सुखोदर्कं परंतपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030791, "chapter_id": 1674, "verse_number": "३-३१२-७", "content_sanskrit": "तस्मिन्प्रतिवसन्तस्ते यत्प्रापुः कुरुसत्तमाः।\nवने क्लेशं सुखोदर्कं तत्प्रवक्ष्यामि ते शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030792, "chapter_id": 1674, "verse_number": "३-३१२-८", "content_sanskrit": "अरणीसहितं भाण्डं ब्राह्मणस्य तपस्विनः।\nमृगस् घर्षणस्य विपाणे समसज्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030793, "chapter_id": 1674, "verse_number": "३-३१२-९", "content_sanskrit": "तदादाय गतो राजंस्त्वरमाणो महामृगः।\nआश्रमान्तरितः शीघ्रं प्लवमानो महाजवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030794, "chapter_id": 1674, "verse_number": "३-३१२-१०", "content_sanskrit": "ह्रियमाणं तु तं दृष्ट्वा स विप्रः कुरुसत्तम।\nत्वरितोऽभ्यागमत्तत्रअग्निहोत्रपरीप्सया।\n`तेषां तु वसतां तत्र पाण्डवानां महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030795, "chapter_id": 1674, "verse_number": "३-३१२-११", "content_sanskrit": "अजातशत्रुमासीनं भ्रातृभिः सहितं वने।\nआगम्य ब्राह्मणस्तूर्णं संतप्तश्चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030796, "chapter_id": 1674, "verse_number": "३-३१२-१२", "content_sanskrit": "अरणीसहितं भाण्डं समासक्तं वनस्पतौ।\nमृगस्य घऱ्षमाणस्य विषाणे समसज्जत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030797, "chapter_id": 1674, "verse_number": "३-३१२-१३", "content_sanskrit": "तमादाय गतो राजंस्त्वरमाणो महामृगः।\nआश्रमात्त्वरितः शीघ्रं प्लवमानो महाजवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030798, "chapter_id": 1674, "verse_number": "३-३१२-१४", "content_sanskrit": "तस्य गत्वा पदं राजन्नासाद्य च महामृगम्।\nअग्निहोत्रं न लुप्येत तदानयत पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030799, "chapter_id": 1674, "verse_number": "३-३१२-१५", "content_sanskrit": "ब्राह्मणस्य वचः श्रुत्वा सन्तप्तोऽथ युधिष्ठिरः।\nधनुरादाय कौन्तेयः प्राद्रवद्भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030800, "chapter_id": 1674, "verse_number": "३-३१२-१६", "content_sanskrit": "सन्नद्धा धन्विनः सर्वे प्राद्रवन्नरपुङ्गवाः।\nब्राह्मणार्थे यतन्तस्ते शीघ्रमन्वगमन्मृगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030801, "chapter_id": 1674, "verse_number": "३-३१२-१७", "content_sanskrit": "कर्णिनालीकनाराचानुत्सृजन्तो महारथाः।\nनाविध्यन्पाण्डवास्तत्र पश्यन्तो मृगमन्तिकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030802, "chapter_id": 1674, "verse_number": "३-३१२-१८", "content_sanskrit": "तेषां प्रयतमानानां नादृश्यत महामृगः।\nअपश्यन्तोमृगं श्रान्ता दुःखं प्राप्ता मनस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030803, "chapter_id": 1674, "verse_number": "३-३१२-१९", "content_sanskrit": "शीतलच्छायमागमय् न्यग्रोधं गहने वने।\nक्षुत्पिपासापरीताङ्गाः पाण्डवाः समुपाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030804, "chapter_id": 1674, "verse_number": "३-३१२-२०", "content_sanskrit": "तेषां समुपविष्टानां नकुलो दुःखितस्तदा।\nअब्रवीद्भ्रातरं श्रेष्ठममर्षात्कुरुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030805, "chapter_id": 1674, "verse_number": "३-३१२-२१", "content_sanskrit": "नास्मिन्कुले जातु ममज्ज धर्मो\nन चालस्यादर्थलोपो बभूव।\nअनुत्तराः सर्वभूतेषु भूप\nसंप्राप्ताः स्मः संशयं किंनु राजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030806, "chapter_id": 1674, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि आरण्येयपर्वणि द्वादशाधिकत्रिशततमोऽध्यायः ॥ ३१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]