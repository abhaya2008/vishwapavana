[{"id": 2200337, "chapter_id": 5267, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200338, "chapter_id": 5267, "verse_number": "१", "content_sanskrit": "ता गावो रन्तिदेवस्य गत्वा यज्ञं मनीषिणः ।\nआत्मानं ज्ञापयामासुर्महर्षीणां समक्षतः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200339, "chapter_id": 5267, "verse_number": "२", "content_sanskrit": "रन्तिदेवस्ततो राजा प्रयतः प्राञ्जलिः शुचिः ।\nउवाच गावः प्रणतः किमागमनमित्यपि\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200340, "chapter_id": 5267, "verse_number": "", "content_sanskrit": "गावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200341, "chapter_id": 5267, "verse_number": "३", "content_sanskrit": "इच्छामस्तव राजेन्द्र सत्रेऽस्मिन् विनियोजनम् ।\nपशुत्वमुपसम्प्राप्तुं प्रसादं कर्तुमर्हसि\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200342, "chapter_id": 5267, "verse_number": "", "content_sanskrit": "रन्तिदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200343, "chapter_id": 5267, "verse_number": "४", "content_sanskrit": "नास्मि शक्तो गवां घातं कर्तुं शतसहस्रशः ।\nघातयित्वा त्वहं युष्मान् कथमात्मानमुद्धरे\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200344, "chapter_id": 5267, "verse_number": "५", "content_sanskrit": "यः पशुत्वेन संयोज्य युष्मान् स्वर्गं नयेदिह ।\nआत्मानं चैव तपसा गावः समुपगम्यताम्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200345, "chapter_id": 5267, "verse_number": "", "content_sanskrit": "गावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200346, "chapter_id": 5267, "verse_number": "६", "content_sanskrit": "अस्माकं तारणे युक्तो धर्मात्मा तपसि स्थितः ।\nश्रुतोऽस्माभिर्भवान् राजन् ततस्तु स्वयमागताः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200347, "chapter_id": 5267, "verse_number": "", "content_sanskrit": "रन्तिदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200348, "chapter_id": 5267, "verse_number": "७", "content_sanskrit": "मम सत्रे पशुत्वं वो यद्येवं हि मनीषितम् ।\nसमयेनाहमेतेन जुहुयां वो हुताशने\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200349, "chapter_id": 5267, "verse_number": "८", "content_sanskrit": "कदाचिद् यदि वः काचिदकामा विनियुज्यते ।\nतदा समाप्तिः सत्रस्य गवां स्यादिति नैष्ठिकी\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200350, "chapter_id": 5267, "verse_number": "", "content_sanskrit": "गावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2200351, "chapter_id": 5267, "verse_number": "९", "content_sanskrit": "एवमस्तु महाराज यथा त्वं प्रब्रवीषि नः ।\nअकामा स्युर्यदा गावस्तदा सत्रं समाप्यताम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2200352, "chapter_id": 5267, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2200353, "chapter_id": 5267, "verse_number": "१०", "content_sanskrit": "ततः प्रवृत्ते गोसत्रे रन्तिदेवस्य धीमतः ।\nगोसहस्राण्यहरहर्नियुज्यन्ते शमितृभिः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2200354, "chapter_id": 5267, "verse_number": "११", "content_sanskrit": "एवं बहूनि वर्षाणि व्यतीतानि नराधिप ।\nगवां वै वध्यमानानां न चान्तः प्रत्यदृश्यत\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2200355, "chapter_id": 5267, "verse_number": "१२", "content_sanskrit": "गवां चर्मसहस्रैस्तु राशयः पर्वतोपमाः ।\nबभूवुः कुरुशार्दूल बहुधा मेघसन्निभाः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2200356, "chapter_id": 5267, "verse_number": "१३", "content_sanskrit": "मेदःक्लेदवहा चैव प्रावर्तत महानदी ।\nअद्यापि भुवि विख्याता नदी चर्मण्वती शुभा\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2200357, "chapter_id": 5267, "verse_number": "१४", "content_sanskrit": "तदा कदाचित्स्वं वत्सं गौरुपामन्त्र्य दुःखिता ।\nएहि वत्स स्तनं पिब मा त्वं पश्चात् क्षुधार्दितः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2200358, "chapter_id": 5267, "verse_number": "१५", "content_sanskrit": "तप्स्यसे विमना दुःखं घातितायां मयि ध्रुवम् ।\nएते ह्यायान्ति चण्डालाः सशस्त्रा मां जिघांसवः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2200359, "chapter_id": 5267, "verse_number": "१६", "content_sanskrit": "अथ शुश्राव तां वाणीं मानुषीं समुदाहृताम् ।\nरन्तिदेवो महाराज ततस्तां समवारयत्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2200360, "chapter_id": 5267, "verse_number": "१७", "content_sanskrit": "स्थापयामास गोसत्रमथ तं पार्थिवर्षभम् ।\nसत्रोत्सृष्टाः परित्यक्ता गावोऽन्या समुपाश्रिताः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2200361, "chapter_id": 5267, "verse_number": "१८", "content_sanskrit": "यास्तस्य गावो निहताः गावो यज्ञे महात्मनः ।\nता गोलोकमुपाजग्मुः प्रोक्षिता ब्रह्मवादिभिः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2200362, "chapter_id": 5267, "verse_number": "१९", "content_sanskrit": "रन्तिदेवोऽपि राजर्षिरिष्ट्वा यज्ञं यथाविधि ।\nततः सख्यं सुरपतेस्त्रिदिवं चाक्षयं ययौ\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2200363, "chapter_id": 5267, "verse_number": "२०", "content_sanskrit": "फेनपो दिवि गोलोके मुमुदे शाश्वतीः समाः ।\nअवशिष्टाश्च या गावस्ता बभूवुर्वनेचराः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2200364, "chapter_id": 5267, "verse_number": "२१", "content_sanskrit": "फेनपाख्यानमेतत् ते गवां माहात्म्यमेव च ।\nकथितं पावनं पुण्यं कृष्णद्वैपायनेरितम्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2200365, "chapter_id": 5267, "verse_number": "२२", "content_sanskrit": "नारायणोऽपि भगवान् दृष्ट्वा गोषु परं यशः ।\nशु(शि)श्रूषां परमां चक्रे भक्तिं च भरतर्षभ\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2200366, "chapter_id": 5267, "verse_number": "२३", "content_sanskrit": "तस्मात् त्वमपि राजेन्द्र गा वै पूजय भारत ।\nद्विजेभ्यश्चैव सततं प्रयच्छ कुरुसत्तम\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2200367, "chapter_id": 5267, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे भार्गवोपाख्यानसमाप्तिर्नाम अष्टादशाधिकशततमोऽध्यायः ॥११८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]