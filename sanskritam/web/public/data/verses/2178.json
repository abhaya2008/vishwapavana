[{"id": 2053378, "chapter_id": 2178, "verse_number": "७-१०५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2053379, "chapter_id": 2178, "verse_number": "७-१०५-१", "content_sanskrit": "ध्वजान्बहुविधाकारान्भ्राजमानानतिश्रिया।\nपार्थानां मामकानां च तान्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2053380, "chapter_id": 2178, "verse_number": "७-१०५-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2053381, "chapter_id": 2178, "verse_number": "७-१०५-२", "content_sanskrit": "ध्वजान्बहुविधाकाराञ्शृणु तेषां महात्मनाम्।\nरूपतो वर्णतश्चैव नामतश्च निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2053382, "chapter_id": 2178, "verse_number": "७-१०५-३", "content_sanskrit": "तेषां तु रथमुख्यानां रथेषु विविधा ध्वजाः।\nप्रत्यदृश्यन्त राजेन्द्र ज्वलिता इव पावकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2053383, "chapter_id": 2178, "verse_number": "७-१०५-४", "content_sanskrit": "काञ्चनाः काञ्चनापीडाः काञ्चनस्रगलङ्कृताः।\nकाञ्चनानीव शृङ्गाणि काञ्चनस्य महागिरेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2053384, "chapter_id": 2178, "verse_number": "७-१०५-५", "content_sanskrit": "अनेकवर्णा विविधा ध्वजाः परमशोभनाः।\nते ध्वजाः संवृतास्तेषां पताकाभिः समन्ततः।\nनानावर्णविराणाभिः शुशुभुः सर्वतो वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2053385, "chapter_id": 2178, "verse_number": "७-१०५-६", "content_sanskrit": "पताकाश्च ततस्तास्तु श्वसनेन समीरिताः।\nनृत्यमाना व्यदृश्यन्त रङ्गमध्ये विलासिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2053386, "chapter_id": 2178, "verse_number": "७-१०५-७", "content_sanskrit": "इन्द्रायुधसवर्णाभाः पताका भरतर्षभ।\nदोधूयमाना रथिनां शोभयन्ति महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2053387, "chapter_id": 2178, "verse_number": "७-१०५-८", "content_sanskrit": "सिंहलाङ्गूल उग्रास्यो ध्वजो वानरलक्षणः।\nधनञ्जयस्य सङ्ग्रामे प्रत्यदृश्यत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2053388, "chapter_id": 2178, "verse_number": "७-१०५-९", "content_sanskrit": "स वानरध्वजो राजन्पताकाभिरलङ्कृतः।\nत्रासयामास तत्सैन्यं ध्वजो गाण्डीवधन्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2053389, "chapter_id": 2178, "verse_number": "७-१०५-१०", "content_sanskrit": "तथैव सिंहलाङ्गूलं द्रोणपुत्रस्य भारत।\nध्वजाघ्रं समपश्याम बालसूर्यसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2053390, "chapter_id": 2178, "verse_number": "७-१०५-११", "content_sanskrit": "काञ्चनं पवनोद्धूतं शक्रध्वजसमप्रभम्।\nनन्दनं कौरवेन्द्राणां द्रौणेर्लक्ष्म समुच्छ्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2053391, "chapter_id": 2178, "verse_number": "७-१०५-१२", "content_sanskrit": "हस्तिकक्ष्या पुनर्हैमी बभूवाधिरथेर्ध्वजः।\nआहवे खं महाराज ददृशे पूरयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2053392, "chapter_id": 2178, "verse_number": "७-१०५-१३", "content_sanskrit": "पताकी काञ्चनः स्रग्वी ध्वजः कर्णस्य संयुगे।\nनृत्यतीव रथोपस्थे श्वसनेन समीरितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2053393, "chapter_id": 2178, "verse_number": "७-१०५-१४", "content_sanskrit": "आचार्यस्य तु पाण्डूनां ब्राह्मणस्य तपस्विनः।\nगोवृषो गौतमस्यासीत्कृपस्य सुपरिष्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2053394, "chapter_id": 2178, "verse_number": "७-१०५-१५", "content_sanskrit": "स तेन भ्राजते राजन्गोवृषेण महारथः।\nत्रिपुरघ्नरथो यद्वद्गोवृषेण विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2053395, "chapter_id": 2178, "verse_number": "७-१०५-१६", "content_sanskrit": "मयूरो वृषसेनस्य काञ्चनो मणिरत्नवान्।\nव्याहरिष्यन्निवातिष्ठत्सेनाग्रमुपशोभयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2053396, "chapter_id": 2178, "verse_number": "७-१०५-१७", "content_sanskrit": "तेन तस्य रथो भाति मयूरेण महात्मनः।\nयथा स्कन्दस्य राजेन्द्र मयूरेण विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2053397, "chapter_id": 2178, "verse_number": "७-१०५-१८", "content_sanskrit": "मद्रराजस्य शल्यस्य ध्वजाग्रेऽग्निशिखामिव।\nसौवर्णीं प्रतिपश्याम सीतामप्रतिमां शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2053398, "chapter_id": 2178, "verse_number": "७-१०५-१९", "content_sanskrit": "सा सीता भ्राजते तस्य रथमास्थाय मारिष।\nसर्वबीजविरूढेव यथा सीता श्रिया वृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2053399, "chapter_id": 2178, "verse_number": "७-१०५-२०", "content_sanskrit": "वराहः सिन्धुराजस्य राजतोऽभिविराजते।\nध्वजाग्रे लोहिताङ्गाभो हेमजालपरिष्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2053400, "chapter_id": 2178, "verse_number": "७-१०५-२१", "content_sanskrit": "शुशुभे केतुना तेन राजतेन जयद्रथः।\nयथा देवासुरे युद्धे पुरा पूषा स्म शोभते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2053401, "chapter_id": 2178, "verse_number": "७-१०५-२२", "content_sanskrit": "सौमदत्तेः पुनर्यूपो यज्ञशीलस्य धीमतः।\nध्वजः सूर्य इवाभाति सोमश्चात्र प्रदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2053402, "chapter_id": 2178, "verse_number": "७-१०५-२३", "content_sanskrit": "स यूपः काञ्चनो राजन्सौमदत्तेर्विराजते।\nराजसूये मखश्रेष्ठे यथा यूपः समुच्छ्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2053403, "chapter_id": 2178, "verse_number": "७-१०५-२४", "content_sanskrit": "शलस्य तु महाराज राजतो द्विरदो महान्।\nकेतुः काञ्चनचित्राङ्गैर्मयूरैरुपशोभितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2053404, "chapter_id": 2178, "verse_number": "७-१०५-२५", "content_sanskrit": "स केतुः शोभयामास सैन्यं ते भरतर्षभ।\nयथा श्वेतो महानागो देवराजचमूं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2053405, "chapter_id": 2178, "verse_number": "७-१०५-२६", "content_sanskrit": "नागो मणिमयो राज्ञो ध्वजः कनकसंवृतः।\nकिङ्किणीशतसंहादो भ्राजंश्चित्रो रथोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2053406, "chapter_id": 2178, "verse_number": "७-१०५-२७", "content_sanskrit": "व्यभ्राजत भृशं राजन्पुत्रस्तव विशाम्पते।\nध्वजेन महता सङ्ख्ये कुरूणामृषभस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2053407, "chapter_id": 2178, "verse_number": "७-१०५-२८", "content_sanskrit": "नवैते तव वाहिन्यामुच्छ्रिताः परमध्वजाः।\nव्यदीपयंस्ते पृतनां युगान्तादित्यसन्निभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2053408, "chapter_id": 2178, "verse_number": "७-१०५-२९", "content_sanskrit": "दशमस्त्वर्जुनस्यासीदेक एव महाकपिः।\nअदीप्यतार्जुनो येन हिमवानिव शम्भुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2053409, "chapter_id": 2178, "verse_number": "७-१०५-३०", "content_sanskrit": "ततश्चित्राणि शुभ्राणि सुमहान्ति महारथाः।\nकार्मुकाण्याददुस्तूर्णमर्जुनार्थे परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2053410, "chapter_id": 2178, "verse_number": "७-१०५-३१", "content_sanskrit": "तथैव धनुरायच्छत्पार्थः शत्रुविनाशनः।\nगाण्डीवं दिव्यकर्मा तद्राजन्दुर्मन्त्रिते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2053411, "chapter_id": 2178, "verse_number": "७-१०५-३२", "content_sanskrit": "तवापराधाद्राजानो निहता बहुशो युधि।\nनानादिग्भ्यः समाहूताः सहयाः सरथद्विपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2053412, "chapter_id": 2178, "verse_number": "७-१०५-३३", "content_sanskrit": "तेषामासीद्व्यातिक्षेपो गजर्तामितरेतरम्।\nदुर्योधनमुखानां च पाण्डूनामृषभस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2053413, "chapter_id": 2178, "verse_number": "७-१०५-३४", "content_sanskrit": "तत्राद्भुतं परं चक्रे कौन्तेयः कृष्णसारथिः।\nयदेको बहुभिः सार्घं समागच्छदभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2053414, "chapter_id": 2178, "verse_number": "७-१०५-३५", "content_sanskrit": "अशोभत महाबाहुर्गाण्डीवं विक्षिपन्धनुः।\nजिगीषुस्तान्नरव्याघ्रो जिघांसुश्च जयद्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2053415, "chapter_id": 2178, "verse_number": "७-१०५-३६", "content_sanskrit": "तत्रार्जुनो नरव्याघ्रः शरैर्मुक्तैः सहस्रशः।\nअदृश्यांस्तावकान्योधान्प्रचक्रे शत्रुतापनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2053416, "chapter_id": 2178, "verse_number": "७-१०५-३७", "content_sanskrit": "ततस्तेऽपि नरव्याघ्राः पार्थं सर्वे महारथाः।\nअदृश्यं समरे चक्रुः सायकौघैः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2053417, "chapter_id": 2178, "verse_number": "७-१०५-३८", "content_sanskrit": "संवृते नरसिंहैस्तु कूरूणामृषभेऽर्जुने।\nमहानासीत्समुद्भूतस्तस्य सैन्यस्य निःस्वनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2053418, "chapter_id": 2178, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे पञ्चाधिकशततमोऽध्यायः॥ १०५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१०५-२ रूपमाकारः॥ ५-१०५-१० ध्वजाग्रं ध्वजमुख्यम्॥ ५-१०५-११ काञ्चनम् काञ्चनमयम्॥ ५-१०५-१६ व्याहरिष्यन्वदिष्यन्॥ ५-१०५-३३ व्यतिक्षेपः अन्योन्याभिघातः॥ ५-१०५-१०५ पञ्चाधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]