[{"id": 2113933, "chapter_id": 3451, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113934, "chapter_id": 3451, "verse_number": "१", "content_sanskrit": "द्रोणः समुदितान् दृष्ट्वा कुरून् वृत्तिपरीप्सया ।\nआजगाम महातेजा विप्रो नागपुरं प्रति \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113935, "chapter_id": 3451, "verse_number": "२", "content_sanskrit": "स तथोक्तस्तदा तेन सदारः प्राद्रवत् कुरून् ।\nतां प्रतिज्ञां प्रतिज्ञाय यां कर्ता नचिरादिव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113936, "chapter_id": 3451, "verse_number": "३", "content_sanskrit": "भारद्वाजोऽवसत् तत्र ह्युञ्छेन द्विजसत्तमः ।\nततोऽस्य तनुजः पार्थान् कृतास्त्रानन्तरं प्रभो\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113937, "chapter_id": 3451, "verse_number": "४", "content_sanskrit": "शस्त्राणि शिक्षयामास नाबुध्यत च तं जनाः ।\nएवं स तत्र गूढात्मा कञ्चित्कालमुवास ह \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]