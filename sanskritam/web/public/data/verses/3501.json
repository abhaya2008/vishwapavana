[{"id": 2116202, "chapter_id": 3501, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116203, "chapter_id": 3501, "verse_number": "१", "content_sanskrit": "स आश्रमपदं दृष्ट्वा रहितं तैर्महामुनिः ।\nनिर्जगाम सुदुःखार्तः पुनरेवाश्रमात् ततः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116204, "chapter_id": 3501, "verse_number": "२", "content_sanskrit": "सोऽपश्यत् सरितं पूर्णां प्रावृट्काले नवाम्भसा ।\nवृक्षान् वञ्जुलनीपादीन् वहन्तीं तीरजान् बहून् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116205, "chapter_id": 3501, "verse_number": "३", "content_sanskrit": "अम्भस्यस्या निमज्जेयमिति दुःखसमन्वितः ।\nतथा पाशैस्तदाऽऽत्मानं गाढं बद्ध्वा महामुनिः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116206, "chapter_id": 3501, "verse_number": "४", "content_sanskrit": "तस्या जले महानद्या निममज्ज सुदुःखितः ।\nअथ च्छित्त्वा नदी पाशं तस्यारिबलमर्दन \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116207, "chapter_id": 3501, "verse_number": "५", "content_sanskrit": "स्थलस्थं तमृषिं कृत्वा विपाशं सा समासृजत् ।\nउत्ततार ततः पाशैर्विमुक्तः स महानृषिः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116208, "chapter_id": 3501, "verse_number": "६", "content_sanskrit": "विपाशेति च नामास्या नद्याश्चक्रे महामुनिः ।\nसा विपाशेति विख्याता नदी लोकेषु भारत \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116209, "chapter_id": 3501, "verse_number": "७", "content_sanskrit": "ऋषेस्त्वस्य नरव्याघ्र वचनात् तस्य धीमतः ।\nउत्तीर्य च ततो राजन् दुःखितो भगवानृषिः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116210, "chapter_id": 3501, "verse_number": "८", "content_sanskrit": "शोके बुद्धिं तु तां चक्रे न चैकत्र व्यतिष्ठत ।\nसोऽपश्यत् पर्वतांश्चैव सरितश्च सरांसि च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116211, "chapter_id": 3501, "verse_number": "९", "content_sanskrit": "दृष्ट्वा स पुनरेवर्षिर्नदीं हैमवतीं तदा ।\nचण्डग्राहवतीं दृष्ट्वा स्रोतस्यात्मानमात्मना \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116212, "chapter_id": 3501, "verse_number": "१०", "content_sanskrit": "मज्जयामास शोकार्तो मरणे कृतनिश्चयः ।\nसा तमग्निसमं विप्रमुपलभ्य सरिद्वरा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116213, "chapter_id": 3501, "verse_number": "११", "content_sanskrit": "शतधा विद्रुता तस्माच्छतद्रुरिति विश्रुता ।\nततः स्थलगतं दृष्ट्वा आत्मानमृषिसत्तमः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116214, "chapter_id": 3501, "verse_number": "१२", "content_sanskrit": "मर्तुं न शक्यमित्युक्त्वा पुनरेवाश्रमं ययौ ।\nवध्वाऽदृश्यन्त्याऽनुगत आश्रमाभिमुखं व्रजन् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116215, "chapter_id": 3501, "verse_number": "१३", "content_sanskrit": "अथ शुश्राव साङ्गस्य वेदाध्ययननिस्वनम् ।\nपृष्ठतः परिपूर्णार्थैः षड्भिरङ्गैरलङ्कृतम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116216, "chapter_id": 3501, "verse_number": "१४", "content_sanskrit": "अनुव्रजति को न्वेष मामित्येव च सोऽब्रवीत् ।\nअदृश्यन्त्यहमित्येव तं स्नुषा प्रत्युवाच ह ।\nभार्या शक्तेर्महाभागा तपोयुक्ता मनस्विनी \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116217, "chapter_id": 3501, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116218, "chapter_id": 3501, "verse_number": "१५", "content_sanskrit": "पुरुः कस्यैष साङ्गस्य वेदाध्ययननिस्वनः ।\nपुत्रि साङ्गस्य वेदस्य शक्तेरिव मया श्रुतः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116219, "chapter_id": 3501, "verse_number": "", "content_sanskrit": "अदृश्यन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116220, "chapter_id": 3501, "verse_number": "१६", "content_sanskrit": "अयं कुक्षौ समुत्पन्नः शक्तेर्गर्भः सुतस्य ते ।\nसमा द्वादश तस्येह वेदानभ्यस्यतो गताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116221, "chapter_id": 3501, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116222, "chapter_id": 3501, "verse_number": "१७", "content_sanskrit": "एवमुक्तस्ततो हृष्टो वसिष्ठः श्रेष्ठभागिनीम् ।\nअस्ति सन्तानमित्युक्त्वा मृत्योः पार्थ न्यवर्तत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116223, "chapter_id": 3501, "verse_number": "१८", "content_sanskrit": "ततः प्रतिनिवृत्तः स तया वध्वा सहानघ ।\nकल्माषपादमासीनं ददर्श विजने तदा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116224, "chapter_id": 3501, "verse_number": "१९", "content_sanskrit": "स तु दृष्ट्वैव तं राजा क्रुद्ध उत्थाय भारत ।\nआविष्टो रक्षसोग्रेण इयेषात्तुमथौजसा \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116225, "chapter_id": 3501, "verse_number": "२०", "content_sanskrit": "अदृश्यन्ती तु तं दृष्ट्वा घोरकर्माणमग्रतः ।\nभयसंविग्नया वाचा वसिष्ठमिदमब्रवीत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116226, "chapter_id": 3501, "verse_number": "२१", "content_sanskrit": "असौ मृत्युरिवोग्रेण दण्डेन भगवन्निह ।\nप्रगृहीतोऽतिघोरेण राक्षसोऽभ्येति भीषणः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116227, "chapter_id": 3501, "verse_number": "२२", "content_sanskrit": "तं निवारयितुं शक्तो नान्योऽस्ति भुवि कश्चन ।\nत्वदृतेऽद्य महाभाग सर्ववेदविदां वर \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116228, "chapter_id": 3501, "verse_number": "२३", "content_sanskrit": "त्राहि मां भगवन् पापादस्माद् दारुणदर्शनात् ।\nराक्षसाद् भक्षितुं यावद् यत्नमेतच्चिकीर्षति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116229, "chapter_id": 3501, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116230, "chapter_id": 3501, "verse_number": "२४", "content_sanskrit": "मा भैः पुत्रि न भेतव्यं रक्षसोऽस्मात् कथञ्चन ।\nनैतद्रक्षो भयं यस्मात् पश्यसि त्वमुपस्थितम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116231, "chapter_id": 3501, "verse_number": "२५", "content_sanskrit": "राजा कल्माषपादोऽयं वीर्येण प्रथितो भुवि ।\nस एषोऽस्मिन् वनोद्देशे निवसत्यतिभीषणः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116232, "chapter_id": 3501, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116233, "chapter_id": 3501, "verse_number": "२६", "content_sanskrit": "तमापतन्तं सङ्क्रुद्धं वसिष्ठो भगवानृषिः ।\nवारयामास तेजस्वी हुङ्कारेणैव भारत \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116234, "chapter_id": 3501, "verse_number": "२७", "content_sanskrit": "मन्त्रपूतेन च पुनः स तमभ्युक्ष्य वारिणा ।\nमोक्षयामास घोराद् वै राक्षसाद् राजसत्तम \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116235, "chapter_id": 3501, "verse_number": "२८", "content_sanskrit": "स हि द्वादश वर्षाणि वासिष्ठस्यैव तेजसा ।\nग्रस्त आसीद् ग्रहेणेव पर्वकाले दिवाकरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116236, "chapter_id": 3501, "verse_number": "२९", "content_sanskrit": "रक्षसा विप्रमुक्तोऽथ स नृपस्तद्वनं महत् ।\nतेजसा रञ्जयामास सन्ध्याभ्रमिव भास्करः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116237, "chapter_id": 3501, "verse_number": "३०", "content_sanskrit": "प्रतिलभ्य ततः सञ्ज्ञामभिवाद्य कृताञ्जलिः ।\nउवाच नृपतिः काले वसिष्ठमृषिसत्तमम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116238, "chapter_id": 3501, "verse_number": "३१", "content_sanskrit": "सौदासोऽहं महाभाग याज्यस्ते द्विजसत्तम ।\nअस्मिन् काले यदिष्टं ते ब्रूहि किं करवाणि ते \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116239, "chapter_id": 3501, "verse_number": "३२", "content_sanskrit": "नावमंस्यामि वै ब्रह्मन् कदाचिद् ब्राह्मणानहम् ।\nत्वन्निदेशे स्थितः शश्वत् पूजयिष्याम्यहं द्विजान् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116240, "chapter_id": 3501, "verse_number": "३३", "content_sanskrit": "इक्ष्वाकूणां तु येनाहमनृणः स्यां द्विजोत्तम ।\nतत् त्वत्तः प्राप्तुमिच्छामि सर्ववेदविदां वर \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2116241, "chapter_id": 3501, "verse_number": "३४", "content_sanskrit": "अपत्यायेप्सिताय त्वं महिषीं गन्तुमर्हसि ।\nशीलरूपगुणोपेतामिक्ष्वाकूणां हि वृद्धये \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2116242, "chapter_id": 3501, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2116243, "chapter_id": 3501, "verse_number": "३५", "content_sanskrit": "ददानीत्येव तं तत्र राजानं प्रत्युवाच ह ।\nवसिष्ठः परमेष्वासं सत्यसन्धो महातपाः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2116244, "chapter_id": 3501, "verse_number": "३६", "content_sanskrit": "ततः प्रतिययौ काले वसिष्ठसहितोऽनघ ।\nख्यातं पुरवरं लोकेष्वयोध्यां मनुजेश्वरः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2116245, "chapter_id": 3501, "verse_number": "३७", "content_sanskrit": "प्रजास्तं प्रतिनन्दन्त्यः सर्वाः प्रत्युद्ययुस्तदा ।\nविपाप्मानं महात्मानं दिवौकस इवेश्वरम् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2116246, "chapter_id": 3501, "verse_number": "३८", "content_sanskrit": "अचिरात् स मनुष्येन्द्रो नगरीं पुण्यकर्मणाम् ।\nविवेश सहितस्तेन वसिष्ठेन महात्मना \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2116247, "chapter_id": 3501, "verse_number": "३९", "content_sanskrit": "ददृशुस्तं ततो राजन्नयोध्यापुरवासिनः ।\nपुष्येण सहितं काले निशाकरमिवोदितम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2116248, "chapter_id": 3501, "verse_number": "४०", "content_sanskrit": "स हि तां पूरयामास लक्ष्म्या लक्ष्मीवतां वरः ।\nअयोध्यां व्योम शीतांशुः शरत्काल इवोदितः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2116249, "chapter_id": 3501, "verse_number": "४१", "content_sanskrit": "संसिक्तमृष्टपन्थानं पताकोच्छ्रितभूषितम् ।\nमनः प्रह्लादयामास तस्य तत्पुरमुत्तमम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2116250, "chapter_id": 3501, "verse_number": "४२", "content_sanskrit": "हृष्टपुष्टजनाकीर्णा सा पुरी कुरुनन्दन ।\nअशोभत तदा तेन शक्रेणेवामरावती \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2116251, "chapter_id": 3501, "verse_number": "४३", "content_sanskrit": "ततः प्रविष्टे कौन्तेय तस्मिन् राजनि तां पुरीम् ।\nतस्य राज्ञोऽथ सा देवी वसिष्ठमुपचक्रमे \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2116252, "chapter_id": 3501, "verse_number": "४४", "content_sanskrit": "ऋतावथ महर्षिस्तु सम्बभूव तथा सह ।\nदेव्या दिव्येन विधिना वसिष्ठः श्रेष्ठभागृषिः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2116253, "chapter_id": 3501, "verse_number": "४५", "content_sanskrit": "राज्ञाऽभिवादितस्तेन जगाम पुनराश्रमम् ।\nदीर्घकालधृतं गर्भं सुषाव न तु तं यदा \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2116254, "chapter_id": 3501, "verse_number": "४६", "content_sanskrit": "साऽथ देव्यश्मना कुक्षिं निर्बिभेद तदा स्वकम् ।\nद्वादशेऽथ ततो वर्षे सञ्जज्ञे मनुषर्षभ ।\nअश्मको नाम राजर्षिः पत्तनं यो न्यवेशयत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2116255, "chapter_id": 3501, "verse_number": "१८०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअशीत्यधिकशततमोऽध्यायः ॥१८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2116256, "chapter_id": 3501, "verse_number": "१३", "content_sanskrit": "॥ इति चैत्ररथपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2116257, "chapter_id": 3501, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]