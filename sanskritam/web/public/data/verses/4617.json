[{"id": 2168814, "chapter_id": 4617, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168815, "chapter_id": 4617, "verse_number": "१", "content_sanskrit": "अयं ते कर्ण सारथ्यं मद्रराजः करिष्यति ।\nकृष्णादभ्यधिको यन्ता देवेशस्येव मातलिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168816, "chapter_id": 4617, "verse_number": "२", "content_sanskrit": "यथा रथं हयैर्युक्तं सङ्गृह्णाति स मातलिः ।\nशल्यस्तथा तवाद्यायं संयन्ता रथवाजिनाम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168817, "chapter_id": 4617, "verse_number": "३", "content_sanskrit": "योधे त्वयि रथस्थे च मद्रराजे च सारथौ ।\nरथश्रेष्ठो ध्रुवं सङ्खे पार्थानभिभविष्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168818, "chapter_id": 4617, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168819, "chapter_id": 4617, "verse_number": "४", "content_sanskrit": "ततो दुर्योधनो भूयो मद्रराजं तरस्विनम् ।\nउवाच राजन् सङ्ग्रामेऽध्युषिते पर्युपस्थिते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168820, "chapter_id": 4617, "verse_number": "५", "content_sanskrit": "कर्णस्य यच्छ सङ्ग्रामे मद्रराज हयोत्तमान् ।\nत्वयाऽभिगुप्तो राधेयो विजेष्यति धनञ्जयम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168821, "chapter_id": 4617, "verse_number": "६", "content_sanskrit": "इत्युक्तो रथमास्थाय तथेति प्राह भारत ।\nशल्येऽभ्युपगते कर्णः सारथिं सुमनाऽब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168822, "chapter_id": 4617, "verse_number": "७", "content_sanskrit": "त्वं सूत स्यन्दनं मह्यं कल्पयेत्यसकृत्त्वरन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168823, "chapter_id": 4617, "verse_number": "८", "content_sanskrit": "ततो जैत्रं रथवरं गन्धर्वनगरोपमम् ।\nविधिवत्कल्पितं भद्रं जयेत्युक्त्वा न्यवेदयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168824, "chapter_id": 4617, "verse_number": "९", "content_sanskrit": "तं रथं रथिनां श्रेष्ठः कर्णोऽभ्यर्च्य यथाविधि ।\nसम्पादितं ब्रह्मविदा पूर्वमेव पुरोधसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168825, "chapter_id": 4617, "verse_number": "१०", "content_sanskrit": "कृत्वा प्रदक्षिणं यत्नादुपस्थाय च भास्करम् ।\nसमीपस्थं मद्रराजमारोह त्वमथाब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168826, "chapter_id": 4617, "verse_number": "११", "content_sanskrit": "ततः कर्णस्य दुर्धर्षं स्यन्दनप्रवरं महत् ।\nआरुरोह महातेजाः शल्यः सिंह इवाचलम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168827, "chapter_id": 4617, "verse_number": "१२", "content_sanskrit": "ततः शल्याश्रितं दृष्ट्वा कर्णः स्वं रथमुत्तमम् ।\nअध्यतिष्ठद्यथाऽम्भोदं विद्युत्वन्तं दिवाकरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168828, "chapter_id": 4617, "verse_number": "१३", "content_sanskrit": "तावेकरथमारूढावादित्याग्निसमत्विषौ ।\nव्यभ्राजेतां यथा मेघं सूर्याग्नी सहितौ दिवि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168829, "chapter_id": 4617, "verse_number": "१४", "content_sanskrit": "संस्तूयमानौ तौ वीरौ तदास्तां द्युतिसत्तमौ ।\nऋत्विक्सदस्यैरिन्द्राग्नी स्तूयमानाविवाध्वरे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168830, "chapter_id": 4617, "verse_number": "१५", "content_sanskrit": "स शल्यसङ्गृहीताश्वे रथे कर्णः स्थितो बभौ ।\nधनुर्विष्फारयन् घोरं परिवेषीव भास्करः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168831, "chapter_id": 4617, "verse_number": "१६", "content_sanskrit": "आस्थितः स रथश्रेष्ठं कर्णः शरगभस्तिमान् ।\nप्रबभौ पुरुषव्याघ्रो मन्दरस्थ इवांशुमान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168832, "chapter_id": 4617, "verse_number": "१७", "content_sanskrit": "तं रथस्थं महाबाहुं युद्धायामिततेजसम् ।\nदुर्योधनस्तु राधेयमिदं वचनमब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168833, "chapter_id": 4617, "verse_number": "१८", "content_sanskrit": "अकृतं द्रोणभीष्माभ्यां दुष्करं कर्म संयुगे ।\nकुरुष्वाधिरथे वीर मिषतां सर्वधन्विनाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168834, "chapter_id": 4617, "verse_number": "१९", "content_sanskrit": "मनोगतं मम ह्यासीद् भीष्मद्रौणौ महारथौ ।\nअर्जुनं भीमसेनं च निहन्ताराविति ध्रुवम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168835, "chapter_id": 4617, "verse_number": "२०", "content_sanskrit": "ताभ्यां यदकृतं वीर वीरकर्म महामृधे ।\nतत्कर्म कुरु राधेय वज्रपाणिरिवापरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168836, "chapter_id": 4617, "verse_number": "२१", "content_sanskrit": "गृहाण धर्मराजं वा जहि वा त्वं धनञ्जयम् ।\nभीमसेनं च राधेय माद्रीपुत्रौ यमावपि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168837, "chapter_id": 4617, "verse_number": "२२", "content_sanskrit": "जयश्च तेऽस्तु भद्रं ते प्रयाहि पुरुषर्षभ ।\nपाण्डुपुत्रस्य सैन्यानि कुरु सर्वाणि भस्मसात्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168838, "chapter_id": 4617, "verse_number": "२३", "content_sanskrit": "ततस्तूर्यसहस्राणि भेरीणामयुतानि च ।\nवाद्यमानान्यरोचन्त मेघशब्दो यथा दिवि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168839, "chapter_id": 4617, "verse_number": "२४", "content_sanskrit": "(प्रतिगृह्य तु तद्वाक्यं रथस्थो रथसत्तमः ।\nअभ्यभाषत राधेयः शल्यं युद्धविशारदम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168840, "chapter_id": 4617, "verse_number": "२५", "content_sanskrit": "चोदयाश्वान् महाबाहो यावद्धन्मि धनञ्जयम् ।\nभीमसेनं यमौ चोभौ राजानं च युधिष्ठिरम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168841, "chapter_id": 4617, "verse_number": "२६", "content_sanskrit": "अद्य पश्यतु मे शल्य बाहुवीर्यं धनञ्जयः ।\nअस्यतः कङ्कपत्राणां सहस्राणि शतानि च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168842, "chapter_id": 4617, "verse_number": "२७", "content_sanskrit": "अद्य क्षेप्स्याम्यहं शल्य शरान् परमतेजनान् ।)\nपाण्डवानां विनाशाय दुर्योधनजयाय च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168843, "chapter_id": 4617, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168844, "chapter_id": 4617, "verse_number": "२८", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य शल्यः कर्णं वचोऽब्रवीत् ।\nकथं नु तान् महावीर्यान् पाण्डवानवमन्यसे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168845, "chapter_id": 4617, "verse_number": "२९", "content_sanskrit": "सर्वास्त्रज्ञान् महेष्वासान् सर्वानेव महाबलान् ।\nअनिवर्तिनो महाभागानजय्यान् सत्यविक्रमान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168846, "chapter_id": 4617, "verse_number": "३०", "content_sanskrit": "अपि सञ्जनयेयुर्ये भयं साक्षाच्छतक्रतोः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168847, "chapter_id": 4617, "verse_number": "३१", "content_sanskrit": "यदा श्रोष्यसि निर्घोषं विस्फूर्जितमिवाशनेः ।\nराधेय पार्थधनुषस्तदा नैवं वदिष्यसि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168848, "chapter_id": 4617, "verse_number": "३२", "content_sanskrit": "यदा द्रक्ष्यसि भीमेन कुञ्जरानीकमाहवे ।\nविशीर्णदन्तं निहतं तदा नैवं वदिष्यसि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168849, "chapter_id": 4617, "verse_number": "३३", "content_sanskrit": "यदा द्रक्ष्यसि सङ्ग्रामे धर्मपुत्रं यमौ तथा ।\nशितैः पृषत्कैः कुर्वाणानभ्रच्छायामिवाम्बरे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168850, "chapter_id": 4617, "verse_number": "३५", "content_sanskrit": "अस्यतः क्षिण्वतश्चारीन् लघुहस्तान् दुरासदान् ।\nपार्थिवानपि चान्यांस्त्वं तदा नैवं वदिष्यसि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168851, "chapter_id": 4617, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168852, "chapter_id": 4617, "verse_number": "३५", "content_sanskrit": "अनादृत्य तु तद्वाक्यं मद्रराजेन भाषितम् ।\nद्रक्ष्यस्यद्येत्यवोचत् तं शल्यं कर्णो जनेश्वर\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168853, "chapter_id": 4617, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nशल्यसंवादे सप्तत्रिंशोऽध्यायः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]