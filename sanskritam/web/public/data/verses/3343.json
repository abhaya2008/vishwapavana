[{"id": 2108276, "chapter_id": 3343, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108277, "chapter_id": 3343, "verse_number": "१", "content_sanskrit": "एवं स्तुतस्तदा कद्र्वा भगवान् हरिवाहनः ।\nनीलजीमूतसङ्घातैर्व्योम सर्वं समावृणोत् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108278, "chapter_id": 3343, "verse_number": "२", "content_sanskrit": "ते मेघा मुमुचुस्तोयं मुहूर्तं विद्युदुज्ज्वलाः ।\nपरस्परमिवात्यर्थं गर्जन्तः सततं दिवि \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108279, "chapter_id": 3343, "verse_number": "३", "content_sanskrit": "अद्रिसङ्घैरिवाकाशं जलदैस्तु महाद्भुतैः ।\nसृजद्भिरतुलं तोयमजस्रं सुमहारवैः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108280, "chapter_id": 3343, "verse_number": "४", "content_sanskrit": "सम्प्रवृत्तमिवाकाशं धारात्मभिरनेकशः ।\nमेघस्तनितनिर्घोषमम्बरं समपद्यत \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108281, "chapter_id": 3343, "verse_number": "५", "content_sanskrit": "नागानामुत्तमो हर्षस्तथा वर्षति वासवे ।\nआपूर्यत मही चापि सलिलेन समन्ततः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108282, "chapter_id": 3343, "verse_number": "२२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि द्वाविंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108283, "chapter_id": 3343, "verse_number": "१०", "content_sanskrit": "॥ आस्तीकपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]