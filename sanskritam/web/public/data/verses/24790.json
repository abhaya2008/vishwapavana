[{"id": 7004790000, "chapter_id": 24790, "verse_number": "६-२५२-१", "content_sanskrit": "शूद्र उवाच ।\nमहदाश्चर्यमेतद्धि यत्सुरा वृक्षरूपिणः ।\nचातुर्मास्ये समायाते सर्ववृक्षनिवासिनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004790001, "chapter_id": 24790, "verse_number": "६-२५२-२", "content_sanskrit": "भगवन्के सुरास्ते तु केषुकेषु निवासिनः ।\nएतद्विस्तरतो ब्रूहि ममानुग्रहकाम्यया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004790002, "chapter_id": 24790, "verse_number": "६-२५२-३", "content_sanskrit": "गालव उवाच ।\nअमृतं जलमित्याहुश्चातुर्मास्ये तदिच्छया ।\nलीलया विधृतं देवैः पिबंति द्रुमदेवताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004790003, "chapter_id": 24790, "verse_number": "६-२५२-४", "content_sanskrit": "तस्य पानान्महातृप्तिर्जायते नाऽत्र संशयः ।\nबलं तेजश्च कांतिश्च सौष्ठवं लघुविक्रमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004790004, "chapter_id": 24790, "verse_number": "६-२५२-५", "content_sanskrit": "गुणा एते प्रजायन्ते पानात्कृष्णांशसंभवात् ।\nनित्यामृतस्यपानेन बलं स्वल्पं प्रजायते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004790005, "chapter_id": 24790, "verse_number": "६-२५२-६", "content_sanskrit": "भोजनं तत्प्रशंसंति नित्यमेतन्न संशयः ।\nतस्माच्चतुर्षु मासेषु पिबन्ति जलमेव हि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004790006, "chapter_id": 24790, "verse_number": "६-२५२-७", "content_sanskrit": "वृक्षस्थाः पितरो देवाः प्राणिनां हित काम्यया ।\nवृक्षाणां सेवनं श्रेष्ठं सर्वमासेषु सर्वदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004790007, "chapter_id": 24790, "verse_number": "६-२५२-८", "content_sanskrit": "चातुर्मास्ये विशेषेण सेविताः सौख्यकारकाः ।\nतिलोदकेन वृक्षाणां सेचनं सर्वकाम दम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004790008, "chapter_id": 24790, "verse_number": "६-२५२-९", "content_sanskrit": "क्षीरवृक्षाः क्षीरयुक्तैस्तोयैः सिक्ताः शुभप्रदाः ।\nचतुष्टयं च वृक्षाणां यच्चोक्तं पूर्वतो मया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004790009, "chapter_id": 24790, "verse_number": "६-२५२-१०", "content_sanskrit": "चातुर्मास्ये विशेषेण सर्वकाम फलप्रदम् ।\nब्रह्मा तु वटमाश्रित्य प्राणिनां स वरप्रदः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004790010, "chapter_id": 24790, "verse_number": "६-२५२-११", "content_sanskrit": "सावित्रीं तिलमास्थाय पवित्रं श्वेतभूषणम् ।\nसुप्ते देवे विशेषेण तिलसेवा महाफला ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004790011, "chapter_id": 24790, "verse_number": "६-२५२-१२", "content_sanskrit": "तिलाः पवित्रमतुलं तिला धर्मार्थसाधकाः ।\nतिला मोक्षप्रदाश्चैव तिलाः पापापहारिणः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004790012, "chapter_id": 24790, "verse_number": "६-२५२-१३", "content_sanskrit": "तिला विशेषफलदास्तिलाः शत्रुविनाशनाः ।\nतिलाः सर्वेषु पुण्येषु प्रथमं समुदाहृताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004790013, "chapter_id": 24790, "verse_number": "६-२५२-१४", "content_sanskrit": "न तिला धान्यमित्याहुर्देवधान्यमिति स्मृतम् ।\nतस्मात्सर्वेषु दानेषु तिल दानं महोत्तमम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004790014, "chapter_id": 24790, "verse_number": "६-२५२-१५", "content_sanskrit": "कनकेन युता येन तिलादत्तास्तु शूद्रज ।\nब्रह्महत्यादिपापानां विनाशस्तेन वै कृतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004790015, "chapter_id": 24790, "verse_number": "६-२५२-१६", "content_sanskrit": "सावित्री च तिलाः प्रोक्ता सर्वकार्यार्थसाधकाः ।\nतिलैस्तु तर्पणं कुर्याच्चातुर्मास्ये विशेषतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004790016, "chapter_id": 24790, "verse_number": "६-२५२-१७", "content_sanskrit": "तिलानां दर्शनं पुण्यं स्पर्शनं सेवनं तथा ।\nहवनं भक्षणं चैव शरीरोद्वर्त्तनं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004790017, "chapter_id": 24790, "verse_number": "६-२५२-१८", "content_sanskrit": "सर्वथा तिलवृक्षोऽयं दर्शनादेव पापहा ।\nचातुर्मास्ये विशेषेण सेवितः सर्वसौख्यदः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004790018, "chapter_id": 24790, "verse_number": "६-२५२-१९", "content_sanskrit": "महेन्द्रो यवमा स्थाय स्थितो भूतहिते रतः ।\nयवस्य सेवनं पुण्यं दर्शनं स्पर्शनं तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004790019, "chapter_id": 24790, "verse_number": "६-२५२-२०", "content_sanskrit": "यवैस्तु तर्पणं कुर्याद्देवानां दत्तमक्षयम् ।\nप्रजानां पतयः सर्वे चूतवृक्षमुपाश्रिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004790020, "chapter_id": 24790, "verse_number": "६-२५२-२१", "content_sanskrit": "गन्धर्वा मलयं वृक्षमगुरुं गणनायकः ।\nसमुद्रा वेतसं वृक्षं यक्षा पुन्नागमेव च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004790021, "chapter_id": 24790, "verse_number": "६-२५२-२२", "content_sanskrit": "नागवृक्षं तथा नागाः सिद्धाः कंकोलकं द्रुमम् ।\nगुह्यकाः पनसं चैव किन्नरा मरिचं श्रिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004790022, "chapter_id": 24790, "verse_number": "६-२५२-२३", "content_sanskrit": "यष्टीमधु समाश्रित्य कन्दर्पोऽभूद्व्यवस्थितः ।\nरक्तांजनं महावृक्षं वह्निराश्रित्य तिष्ठति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004790023, "chapter_id": 24790, "verse_number": "६-२५२-२४", "content_sanskrit": "यमो विभीतकं चैव बकुलं नैरृताधिपः ।\nवरुणः खर्जुरीवृक्षं पूगवृक्षं च मारुतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004790024, "chapter_id": 24790, "verse_number": "६-२५२-२५", "content_sanskrit": "धनदोऽक्षोटकं वृक्षं रुद्राश्च बदरीद्रुमम् ।\nसप्तर्षीणां महाताला बहुलश्चामरैर्वृतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004790025, "chapter_id": 24790, "verse_number": "६-२५२-२६", "content_sanskrit": "जंबूर्मेघैः परिवृतः कृष्णवर्णोऽघनाशनः ।\nकृष्णस्य सदृशो वर्णस्तेन जंबू नगोत्तमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004790026, "chapter_id": 24790, "verse_number": "६-२५२-२७", "content_sanskrit": "तत्फलैर्वासुदेवस्तु प्रीतो भवति दानतः ।\nजंबूवृक्षं समाश्रित्य कुर्वंति द्विजभोजनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004790027, "chapter_id": 24790, "verse_number": "६-२५२-२८", "content_sanskrit": "तेषां प्रीतो हरिर्दद्यात्पु रुषार्थचतुष्टयम् ।\nचातुर्मास्ये समायाते सुप्ते देवे जनार्दने ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004790028, "chapter_id": 24790, "verse_number": "६-२५२-२९", "content_sanskrit": "ब्राह्मणान्भोजयेद्यस्तु सपत्नीकाञ्छुचिः स्थितः ।\nतेन नारायणस्तुष्टो भवे ल्लक्ष्मीसहायवान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004790029, "chapter_id": 24790, "verse_number": "६-२५२-३०", "content_sanskrit": "लक्ष्मीनारायणप्रीत्यै वस्त्रालंकरणैः शुभैः ।\nपरिधाय सपत्नीकः कृतकृत्यो भवेन्नरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004790030, "chapter_id": 24790, "verse_number": "६-२५२-३१", "content_sanskrit": "यद्रात्रित्रितयेनैव वटा शोकभवेन च ।\nफलं संजायते तच्च जंबुना द्विजभोजनात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004790031, "chapter_id": 24790, "verse_number": "६-२५२-३२", "content_sanskrit": "तस्मिन्दिने एकभुक्तं कारयेत्कृत्यकृत्तदा ।\nबहुना च किमुक्तेन जंबूवृक्ष प्रपूजनात् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004790032, "chapter_id": 24790, "verse_number": "६-२५२-३३", "content_sanskrit": "पुत्रपौत्रधनैर्युक्तो जायते नात्र संशयः ।\nजंबूर्मेघैः परिवृता विद्युताऽशोक एव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004790033, "chapter_id": 24790, "verse_number": "६-२५२-३४", "content_sanskrit": "वसुभिः स्वीकृतो नित्यं प्रिया लश्च महानगः ।\nआदित्यैस्तु जपावृक्षो ह्यश्विभ्यां मदनस्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004790034, "chapter_id": 24790, "verse_number": "६-२५२-३५", "content_sanskrit": "विश्वेभिश्च मधूकश्च गुग्गुलः पिशिताशनैः ।\nसूर्येणार्कः पवित्रेण सोमे नाथ त्रिपत्रकः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004790035, "chapter_id": 24790, "verse_number": "६-२५२-३६", "content_sanskrit": "खदिरो भूमिपुत्रेण अपामार्गो बुधेन च ।\nअश्वत्थो गुरुणा चैव शुक्रेणोदुम्बरस्तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004790036, "chapter_id": 24790, "verse_number": "६-२५२-३७", "content_sanskrit": "शमी शनैश्चरेणाथ स्वीकृता शूद्रजातिभिः ।\nराहुणा स्वीकृता दूर्वा पितॄणां तर्पणोचिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004790037, "chapter_id": 24790, "verse_number": "६-२५२-३८", "content_sanskrit": "विष्णोश्च दयिता नित्यं चातुर्मास्ये विशेषतः ।\nकेतुना स्वीकृतो दर्भो याज्ञिकेयो महाफलः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004790038, "chapter_id": 24790, "verse_number": "६-२५२-३९", "content_sanskrit": "विना येन शुभं कर्म संपूर्णं नैव जायते ।\nपवित्राणां पवित्रं यो मङ्गलानां च मङ्गलम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004790039, "chapter_id": 24790, "verse_number": "६-२५२-४०", "content_sanskrit": "मुमूर्षूणां मोक्षरूपो धरासंस्थो महाद्रुमः ।\nअस्मिन्वसंति सततं ब्रह्मविष्णुशिवाः सदा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004790040, "chapter_id": 24790, "verse_number": "६-२५२-४१", "content_sanskrit": "मूले मध्ये तथाऽग्रे च यस्य नामापि तृप्ति दम् ।\nअन्येऽपि देवा वृक्षांस्तानधिश्रित्य महाद्रुमाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004790041, "chapter_id": 24790, "verse_number": "६-२५२-४२", "content_sanskrit": "प्रवर्त्तंते हि मासेषु चतुर्षु च न संशयः ।\nचातुर्मास्ये देवपत्न्यः सर्वा वल्लीसमाश्रि ताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004790042, "chapter_id": 24790, "verse_number": "६-२५२-४३", "content_sanskrit": "प्रयच्छंति नृणां कामान्वांछितान्सेविता अपि ।\nतस्मात्सर्वात्मभावेन पिप्पलो येन सेवितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004790043, "chapter_id": 24790, "verse_number": "६-२५२-४४", "content_sanskrit": "सेविताः सकला वृक्षा श्चातुर्मास्ये विशेषतः ।\nतुलसी सेविता येन सर्ववल्यश्च सेविताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004790044, "chapter_id": 24790, "verse_number": "६-२५२-४५", "content_sanskrit": "आप्यायितं जगत्सर्वमाब्रह्मस्तंबसेवितम् ।\nचातुर्मास्ये गृह स्थेन वानप्रस्थेन वा पुनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004790045, "chapter_id": 24790, "verse_number": "६-२५२-४६", "content_sanskrit": "ब्रह्मचारियतिभ्यां च सेविता मोक्षदायिनी ।\nएतेषां सर्ववृक्षाणां छेदनं नैव कारयेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004790046, "chapter_id": 24790, "verse_number": "६-२५२-४७", "content_sanskrit": "चातुर्मास्ये विशेषेण विना यज्ञादिकारणम् ।\nएतदुक्तमशेषेण यत्पृष्टोऽहमिह त्वया ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004790047, "chapter_id": 24790, "verse_number": "६-२५२-४८", "content_sanskrit": "यथा वृक्षत्वमापन्ना देवाः सर्वेऽपि शूद्रज ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004790048, "chapter_id": 24790, "verse_number": "६-२५२-४९", "content_sanskrit": "अश्वत्थमेकं पिचुमन्दमेकं न्यग्रोधमेकं दश तित्तिडीश्च ।\nकपित्थबिल्वामलकीत्रयं च एतांश्च दृष्ट्वा नरकं न पश्येत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004790049, "chapter_id": 24790, "verse_number": "६-२५२-५०", "content_sanskrit": "सर्वे देवा विश्ववृक्षेशयाश्च कृष्णा धारा कृष्णमध्याग्रकाश्च ।\nयस्मिन्देवे सेविते विश्वपूज्ये सर्वं तृप्तं जायते विश्वमेतत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]