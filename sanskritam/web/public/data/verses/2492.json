[{"id": 2070865, "chapter_id": 2492, "verse_number": "११-२४-०x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070866, "chapter_id": 2492, "verse_number": "११-२४-१", "content_sanskrit": "सोमदत्तसुतं पश्य युयुधानेन पातितम्।\nवितुद्यमानं विहगैर्बहुभिर्माधवान्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070867, "chapter_id": 2492, "verse_number": "११-२४-२", "content_sanskrit": "पुत्रशोकाभिसन्तप्तः शोमदत्तो जनार्दन।\nयुयुधानं महेष्वासं गर्हयन्निव दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070868, "chapter_id": 2492, "verse_number": "११-२४-३", "content_sanskrit": "असौ हि भूरिश्वसो माता शोकपरिप्लुता।\nआश्वासयति भर्तारं सोमदत्तमनिन्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070869, "chapter_id": 2492, "verse_number": "११-२४-४", "content_sanskrit": "दिष्ट्या नैनं महाराज दारुणं भरतक्षयम्।\nकुरुसङ्क्रन्दनं घोरं युगान्तमनुपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070870, "chapter_id": 2492, "verse_number": "११-२४-५", "content_sanskrit": "दिष्ट्या यूपध्वजं पुत्रं वीरं भूरिसहस्रदम्।\nअनेकक्रतुयज्वानं निहतं नानुपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070871, "chapter_id": 2492, "verse_number": "११-२४-६", "content_sanskrit": "दिष्ट्या स्नुषाणामाक्रन्दे घोरं विलपितं बहु।\nन शृणोषि महाराज सारसीनामिवार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070872, "chapter_id": 2492, "verse_number": "११-२४-७", "content_sanskrit": "एकवस्त्रास्तु पञ्चैताः प्रकीर्णासितमूर्धजाः।\nस्नुषास्ते परिधावन्ति हतापत्या हतेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070873, "chapter_id": 2492, "verse_number": "११-२४-८", "content_sanskrit": "श्वापदैर्भक्ष्यमाणं त्वमहो दिष्ट्या न पश्यसि।\nछिन्नबाहुं नरव्याघ्रमर्जुनेन निपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070874, "chapter_id": 2492, "verse_number": "११-२४-९", "content_sanskrit": "शलं विनिहतं सङ्ख्ये भूरिश्रवसमेव च।\nस्नुषाश्च विविधाः सर्वा दिष्ट्या नाद्येह पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070875, "chapter_id": 2492, "verse_number": "११-२४-१०", "content_sanskrit": "दिष्ट्या तत्काञ्चनं छत्रं यूपकेतोर्महात्मनः।\nविनीकीर्णं रथोपस्थे सौमदत्तेर्न पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070876, "chapter_id": 2492, "verse_number": "११-२४-११", "content_sanskrit": "अमूस्तु भूरिश्रवसो भार्याः सात्यकिना हतम्।\nपरिवार्यानुशोचन्ति भर्तारमसितेक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070877, "chapter_id": 2492, "verse_number": "११-२४-१२", "content_sanskrit": "एता विलप्य करुणं भर्तृशोकेन कर्शिताः।\nपतन्त्यभिमुखा भूमौ कृपणं बत केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070878, "chapter_id": 2492, "verse_number": "११-२४-१३", "content_sanskrit": "बीभत्सुरतिबीभत्सं कर्मेदमकरोत्कथम्।\nप्रमत्तस्य यदच्छैत्सीद्बाहुं शूरस्य यज्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070879, "chapter_id": 2492, "verse_number": "११-२४-१४", "content_sanskrit": "ततः पापतरं कर्म कृतवानपि सात्यकिः।\nयस्मात्प्रायोपविष्टस्य प्राहार्षीत्संशितात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070880, "chapter_id": 2492, "verse_number": "११-२४-१५", "content_sanskrit": "एको द्वाभ्यां हतः शेते क्षत्रधर्मेण धार्मिकः।\nकिन्नु वक्ष्यति वै सत्सु गोष्ठीषु च सभासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070881, "chapter_id": 2492, "verse_number": "११-२४-१६", "content_sanskrit": "अपुण्यमयशस्यं च कर्मेदं सात्यकिः स्वयम्।\nइति यूपध्वजस्यैताः स्त्रियः क्रोशन्ति माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070882, "chapter_id": 2492, "verse_number": "११-२४-१७", "content_sanskrit": "भार्या यूपध्वजस्यैषा करसम्मितमध्यमा।\nकृत्वोत्सङ्गे भुजं भर्तुः कृपणं परिदेवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070883, "chapter_id": 2492, "verse_number": "११-२४-१८", "content_sanskrit": "अयं स हन्ता शूराणां मित्राणामभयप्रदः।\nप्रदाता गोसहस्राणां क्षत्रियान्तकरः करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070884, "chapter_id": 2492, "verse_number": "११-२४-१९", "content_sanskrit": "अयं स रशनोत्कर्षी पीनस्तनविमर्दनः।\nनाभ्यूरुजघनस्पर्शी नीवीविस्रंसनः करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070885, "chapter_id": 2492, "verse_number": "११-२४-२०", "content_sanskrit": "वासुदेवस्य सान्निध्ये पार्थेनाक्लिष्टकर्मणा।\nयुध्यतः समरेऽन्येन प्रमत्तस्य निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070886, "chapter_id": 2492, "verse_number": "११-२४-२१", "content_sanskrit": "किन्नु वक्ष्यसि संसत्सु कथासु च जनार्दन।\nअर्जुनस्य महत्कर्म स्वयं वा स किरीटभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070887, "chapter_id": 2492, "verse_number": "११-२४-२२", "content_sanskrit": "इत्येवं गर्हयित्वैषा तूष्णीमास्ते वराङ्गना।\nतामेतामनुशोचन्ति सपत्न्यः स्वामिव स्नुषाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070888, "chapter_id": 2492, "verse_number": "११-२४-२३", "content_sanskrit": "गान्धारराजः शकुनिर्बलवान्सत्यविक्रमः।\nनिहतः सहदेवेन भागिनेमेन मातुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070889, "chapter_id": 2492, "verse_number": "११-२४-२४", "content_sanskrit": "यः पुरा हेमदण्डाभ्यां व्यजनाभ्यां स्म वीज्यते।\nस एष पक्षिभिः पक्षैः शयान उपवीज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070890, "chapter_id": 2492, "verse_number": "११-२४-२५", "content_sanskrit": "यः स्वरूपाणि कुरुते शतशोऽथ सहस्रशः।\nतस्य मायाविनो माया दग्धाः पाण्डवतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070891, "chapter_id": 2492, "verse_number": "११-२४-२६", "content_sanskrit": "मायया निकृतिप्रज्ञो जितवान्यो युधिष्ठिरम्।\nसभायां विपुलं राज्यं स जहौ जीवितं कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070892, "chapter_id": 2492, "verse_number": "११-२४-२७", "content_sanskrit": "शकुन्ताः शकुनिं कृष्ण समन्तात्पर्युपासते।\nकितवं मम पुत्राणां विनाशायोपशिक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070893, "chapter_id": 2492, "verse_number": "११-२४-२८", "content_sanskrit": "एतेनैतन्महद्वैरं प्रसक्तं पाण्डवैः सह।\nवधाय मम पुत्राणामात्मनः सगणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070894, "chapter_id": 2492, "verse_number": "११-२४-२९", "content_sanskrit": "यथैव मम पुत्राणां लोकाः शस्त्रजिताः प्रभो।\nएवमस्यापि दुर्बुद्धेर्लोकाः शस्त्रेण वै जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070895, "chapter_id": 2492, "verse_number": "११-२४-३०", "content_sanskrit": "कथं च नायं तत्रापि पुत्रान्मे भ्रातृभिः सह।\nविरोधयेदृजुप्रज्ञाननृजुर्मधुसूदन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070896, "chapter_id": 2492, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि स्त्रीविलापपर्वणि चतुर्विंशोऽध्यायः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]