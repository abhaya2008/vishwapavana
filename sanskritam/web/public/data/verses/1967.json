[{"id": 2043262, "chapter_id": 1967, "verse_number": "६-१६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043263, "chapter_id": 1967, "verse_number": "६-१६-१", "content_sanskrit": "ततो रजन्यां व्युष्टायां शब्दः समभवन्महान्।\nक्रोशतां भूमिपलानां युज्यतां युज्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043264, "chapter_id": 1967, "verse_number": "६-१६-२", "content_sanskrit": "शङ्खदुन्दुभिघोषैश्च सिंहनादैश्च भारत।\nहयहेषितनादैश्च रथनेमिस्वनैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043265, "chapter_id": 1967, "verse_number": "६-१६-३", "content_sanskrit": "गाजानां बृहतां चैव योधानां चापि गर्जताम्।\nक्ष्वेलितास्फोटितोत्क्रुष्टैस्तुमुलं सर्वतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043266, "chapter_id": 1967, "verse_number": "६-१६-४", "content_sanskrit": "उदतिष्ठन्महाराज सर्वं युक्तमशेषतः ।\nसूर्योदये महत्सैन्यं कुरुपाण्डवसेनयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043267, "chapter_id": 1967, "verse_number": "६-१६-५", "content_sanskrit": "राजेन्द्र तव पुत्राणां पाण्डवानां तथैव च।\nदुष्प्रधृष्याणि चास्त्राणि सशस्रकवचानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043268, "chapter_id": 1967, "verse_number": "६-१६-६", "content_sanskrit": "ततः प्रकाशे सैन्यानि समदृश्यन्त भारत।\nत्वदीयानां परेषां च शस्त्रवन्ति महान्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043269, "chapter_id": 1967, "verse_number": "६-१६-७", "content_sanskrit": "तत्र नागा रथाश्चैव जाम्बूनदपरिष्कृताः।\nविभ्राजमाना दृश्यन्ते मेघा इव सविद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043270, "chapter_id": 1967, "verse_number": "६-१६-८", "content_sanskrit": "रथानीकान्यदृश्यन्त नगराणीव भूरिशः ।\nअतीव शुशुभे तत्र पिता ते पूर्णचन्द्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043271, "chapter_id": 1967, "verse_number": "६-१६-९", "content_sanskrit": "धनुर्भिर्ऋष्टिभिः खङ्गैर्गदाभिः शक्तितोमरैः ।\nयोधाः प्रहरणैः शुभ्रैस्तेष्वनीकेष्ववस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043272, "chapter_id": 1967, "verse_number": "६-१६-१०", "content_sanskrit": "गजाः पदाता रथिनस्तुरगाश्च विशांपते ।\nव्यतिष्ठन्वागुराकाराः शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043273, "chapter_id": 1967, "verse_number": "६-१६-११", "content_sanskrit": "ध्वजा बहुविधाकारा व्यदृश्यन्त समुच्छ्रिताः।\nस्वेषां चैव परेषां च द्युतिमन्तः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043274, "chapter_id": 1967, "verse_number": "६-१६-१२", "content_sanskrit": "काञ्चना मणिचित्राङ्गा ज्वलन्त इव पावकाः।\nअर्चिष्मन्तो व्यरोचन्त गजारोहाः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043275, "chapter_id": 1967, "verse_number": "६-१६-१३", "content_sanskrit": "महेन्द्रकेतवः शुभ्रा महेन्द्रसदनेष्विव।\nसन्नद्धास्ते प्रवीराश्च ददृशुर्युद्धकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043276, "chapter_id": 1967, "verse_number": "६-१६-१४", "content_sanskrit": "उद्यतैरायुधैश्चित्रास्तलबद्धाः कलापिनः ।\nऋषभाक्षा मनुष्येन्द्राश्चमूमुखगता बभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043277, "chapter_id": 1967, "verse_number": "६-१६-१५", "content_sanskrit": "शकुनिः सौबलः शल्य आवन्त्योऽथ जयद्रथः ।\nविन्दानुविन्दौ कैकेयाः काम्भोजश्च सुदक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043278, "chapter_id": 1967, "verse_number": "६-१६-१६", "content_sanskrit": "श्रुतायुधश्च कालिङ्गो जयत्सेनश्च पार्थिवः ।\nबृहद्बलश्च कौशल्यः कृतवर्मा च सात्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043279, "chapter_id": 1967, "verse_number": "६-१६-१७", "content_sanskrit": "दशैते पुरुषव्याघ्राः शूराः परिघबाहवः ।\nअक्षौहिणीनां पतयो यज्वानो भूरिदक्षिणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043280, "chapter_id": 1967, "verse_number": "६-१६-१८", "content_sanskrit": "एते चान्ये च बहवो दुर्योधनवशानुगाः ।\nराजानो राजपुत्राश्च नीतिमन्तो महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043281, "chapter_id": 1967, "verse_number": "६-१६-१९", "content_sanskrit": "सन्नद्धाः समदृश्यन स्वेष्वनीकेष्ववस्थिताः ।\nबद्धकृष्णाजिनाः सर्वे बलिनो युद्धशालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2043282, "chapter_id": 1967, "verse_number": "६-१६-२०", "content_sanskrit": "हृष्टा दुर्योधनस्यार्थे ब्रह्मलोकाय दीक्षिताः।\nसमर्था दश वाहिन्यः परिगृह्य व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2043283, "chapter_id": 1967, "verse_number": "६-१६-२१", "content_sanskrit": "एकादशी धार्तराष्ट्री कौरवाणां महाचमूः ।\nअग्रतः सर्वसैन्यानां यत्र शान्तनवोऽग्रणीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2043284, "chapter_id": 1967, "verse_number": "६-१६-२२", "content_sanskrit": "श्वेतोष्णीषं श्वेतहयं श्वेतवर्माणमच्युतम् ।\nअपश्याम महाराज भीष्मं चन्द्रमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2043285, "chapter_id": 1967, "verse_number": "६-१६-२३", "content_sanskrit": "हेमतालध्वजं भीष्मं राजते स्यन्दते स्थितम् ।\nश्वेताभ्र इव तीक्ष्णांशुं ददृशुः कुरुपाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2043286, "chapter_id": 1967, "verse_number": "६-१६-२४", "content_sanskrit": "दृष्ट्वा चमूमुखे भीष्मं समकम्पन्त पाण्डवाः ।\nसृञ्जयाश्च महेष्वासा धृष्टद्युम्नपुरोगमाः ।\nजृम्भमाणं महासिंहं दृष्ट्वा क्षुद्रमृगा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2043287, "chapter_id": 1967, "verse_number": "६-१६-२५", "content_sanskrit": "धृष्टद्युम्नमुखाः सर्वे समुद्विविजिरे मुहुः ।\nएकादशैताः श्रीजुष्टा वाहिन्यस्तव पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2043288, "chapter_id": 1967, "verse_number": "६-१६-२६", "content_sanskrit": "पाण्डवानां तथा सप्त महापुरुषपालिताः ।\nउन्मत्तमकरावर्तौ महाग्राहसमाकुलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2043289, "chapter_id": 1967, "verse_number": "६-१६-२७", "content_sanskrit": "युगान्ते समवेतौ द्वौ दृश्येते सागराविव ।\nनैव नस्तादृशो राजन्दृष्टपूर्वो न च श्रुतः ।\nअनीकानां समेतानां कौरवाणां तथाविधः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2043290, "chapter_id": 1967, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि षोडशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]