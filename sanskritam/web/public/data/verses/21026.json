[{"id": 7001026000, "chapter_id": 21026, "verse_number": "५-८-१", "content_sanskrit": "गाः पालयन्तौ च पुनः सहितौ बल-केशवौ ।\nभ्रममाणौ वने तस्मिन् रम्यं तालवनं गतौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001026001, "chapter_id": 21026, "verse_number": "५-८-२", "content_sanskrit": "तत्तु तालवनं दिव्यं धेनुको नाम दानवः ।\nमृगमांसकृताहारः सदाध्यास्ते खराकृतिः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001026002, "chapter_id": 21026, "verse_number": "५-८-३", "content_sanskrit": "तत्तु तालवन पक्क-फलसम्पत्समन्वितम् ।\nदृष्ट्वा स्पृहान्विता गोपाः फलादानेऽब्रु वन्, वचः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001026003, "chapter_id": 21026, "verse_number": "५-८-४", "content_sanskrit": "हे राम! हे कृष्ण! सदा धेनुकेनैष रक्ष्यते ।\nभूप्रदेशो यतस्तस्मात् पक्कानीमानि सन्ति वै ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001026004, "chapter_id": 21026, "verse_number": "५-८-५", "content_sanskrit": "फलानि पश्य तालानां गन्धामोदितदींशि च ।\nवयमत्तुमभीप्सामः पात्यन्तां यदि रोचसे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001026005, "chapter_id": 21026, "verse_number": "५-८-६", "content_sanskrit": "इति गोपकुमाराणां श्रुत्वा सङ्कर्षणो वचः ।\nकृष्णश्व पातयामास भुवि तालफलानि वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001026006, "chapter_id": 21026, "verse_number": "५-८-७", "content_sanskrit": "फलानां पततां शब्दमाकर्ण्य स दुरासदः ।\nआजगाम सुदुष्टात्मा कोपादू दैतेयगर्द्दभः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001026007, "chapter_id": 21026, "verse_number": "५-८-८", "content_sanskrit": "पद्भयामुभाभ्यां स तदा पश्विमाभ्यां बली बलम् ।\nजघानोरसि ताभ्याञ्च स च तेनाप्यगृह्यत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001026008, "chapter_id": 21026, "verse_number": "५-८-९", "content_sanskrit": "गृहीत्वा भ्रामणेनैव सोऽम्बरे गतजीवितम् ।\nतस्मिन्नेव च चिक्षेप वेगेन तृणराजनि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001026009, "chapter_id": 21026, "verse_number": "५-८-१०", "content_sanskrit": "ततः फलान्यनेकानि तालाग्रान्निपतन् खरः ।\nपृथिव्यां पातयामास महावातोऽम्बुदानिव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001026010, "chapter_id": 21026, "verse_number": "५-८-११", "content_sanskrit": "अन्यानप्यस्य वै ज्ञातीनागतान् दैत्यगर्द्दभान् ।\nकृष्णाश्विक्षेप तालाग्र बलभद्रश्व लीलया ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001026011, "chapter_id": 21026, "verse_number": "५-८-१२", "content_sanskrit": "क्षणेनालङ्कृता पृथ्वी पक्कस्तालफलैस्तथा ।\nदैत्यगर्द्दभदेहैश्व मैत्रेय! शुशुभेऽधिकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001026012, "chapter_id": 21026, "verse_number": "५-८-१३", "content_sanskrit": "ततो गावो निराबाधास्तस्मिंस्तालवने द्रिज!\nनवशस्य सुख चेरुर्यन्न भुक्तमभूत् पुरा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]