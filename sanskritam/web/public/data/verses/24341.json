[{"id": 7004341000, "chapter_id": 24341, "verse_number": "५-३-३५-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nजलमध्ये महादेवः केन तिष्ठति हेतुना ।\nउत्तरं दक्षिणं कूलं वर्जयित्वा द्विजोत्तम॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004341001, "chapter_id": 24341, "verse_number": "५-३-३५-२", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nएतदाख्यानमतुलं पुण्यं श्रुतिमुखावहम् ।\nपुराणे यच्छ्रुतं तात तत्ते वक्ष्याम्यशेषतः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004341002, "chapter_id": 24341, "verse_number": "५-३-३५-३", "content_sanskrit": "त्रेतायुगे महाभाग रावणो देवकण्टकः ।\nत्रैलोक्यविजयी रौद्रः सुरासुरभयंकरः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004341003, "chapter_id": 24341, "verse_number": "५-३-३५-४", "content_sanskrit": "देवदानवगन्धर्वैरृषिभिश्च तपोधनैः ।\nअवध्योऽथ विमानेन यावत्पर्यटते महीम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004341004, "chapter_id": 24341, "verse_number": "५-३-३५-५", "content_sanskrit": "तावद्धिन्ध्यगिरेर्मध्ये दानवो बलदर्पितः ।\nमयो नामेति विख्यातो गुहावासी तपश्चरन्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004341005, "chapter_id": 24341, "verse_number": "५-३-३५-६", "content_sanskrit": "तस्य पार्श्वगतो रक्षो विनयादवनिं गतः ।\nपूजितो दानसन्मानैरिदं वचनमब्रवीत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004341006, "chapter_id": 24341, "verse_number": "५-३-३५-७", "content_sanskrit": "कस्येयं पद्मपत्राक्षी पूर्णचन्द्रनिभानना ।\nकिंनामधेया तपति तप उग्रं कथं विभो॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004341007, "chapter_id": 24341, "verse_number": "५-३-३५-८", "content_sanskrit": "मय उवाच ।\nदानवानां पतिः श्रेष्ठो मयोऽहं नाम नामतः ।\nभार्या तेजोवती नाम तस्यास्तु तनया शुभा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004341008, "chapter_id": 24341, "verse_number": "५-३-३५-९", "content_sanskrit": "मन्दोदरीति विख्याता तपते भर्तृकारणात् ।\nआराधयन्ती भर्तारमुमाया दयितं शुभम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004341009, "chapter_id": 24341, "verse_number": "५-३-३५-१०", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य रावणो मदमोहितः ।\nप्रसृतः प्रणतो भूत्वा मयं वचनमब्रवीत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004341010, "chapter_id": 24341, "verse_number": "५-३-३५-११", "content_sanskrit": "पौलस्त्यान्वयसंजातो देवदानवदर्पहा ।\nप्रार्थयामि महाभाग सुतां त्वं दातुमर्हसि॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004341011, "chapter_id": 24341, "verse_number": "५-३-३५-१२", "content_sanskrit": "ज्ञात्वा पैतामहं वृत्तं मयेनापि महात्मना ।\nरावणाय सुता दत्ता पूजयित्वा विधानतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004341012, "chapter_id": 24341, "verse_number": "५-३-३५-१३", "content_sanskrit": "गृहीत्वा तां तदा रक्षोऽभ्यर्च्यमानो निशाचरैः ।\nदेवोद्याने विमानैश्च क्रीडते स तया सह॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004341013, "chapter_id": 24341, "verse_number": "५-३-३५-१४", "content_sanskrit": "केनचित्त्वथ कालेन रावणो लोकरावणः ।\nपुत्रं पुत्रवतां श्रेष्ठो जनयामास भारत॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004341014, "chapter_id": 24341, "verse_number": "५-३-३५-१५", "content_sanskrit": "तेनैव जातमात्रेण रावो मुक्तो महात्मना ।\nसंवर्तकस्य मेघस्य तेन लोका जडीकृताः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004341015, "chapter_id": 24341, "verse_number": "५-३-३५-१६", "content_sanskrit": "श्रुत्वा तन्नर्दितं घोरं ब्रह्मा लोकपितामहः ।\nनाम चक्रे तदा तस्य मेघनादो भविष्यति॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004341016, "chapter_id": 24341, "verse_number": "५-३-३५-१७", "content_sanskrit": "एवंनामा कृतः सोऽपि परमं व्रतमास्थितः ।\nतोषयामास देवेशमुमया सह शङ्करम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004341017, "chapter_id": 24341, "verse_number": "५-३-३५-१८", "content_sanskrit": "व्रतैर्नियमदानैश्च होमजाप्यविधानतः ।\nकृच्छ्रचान्द्रायणैर्नित्यं कृशं कुर्वन्कलेवरम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004341018, "chapter_id": 24341, "verse_number": "५-३-३५-१९", "content_sanskrit": "एवमन्यद्दिने तात कैलासं धरणीधरम् ।\nगत्वा लिङ्गद्वयं गृह्य प्रस्थितो दक्षिणामुखः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004341019, "chapter_id": 24341, "verse_number": "५-३-३५-२०", "content_sanskrit": "नर्मदातटमाश्रित्य स्नातुकामो महाबलः ।\nनिक्षिप्य पूजयन् देवं कृतजाप्यो नरेश्वर॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004341020, "chapter_id": 24341, "verse_number": "५-३-३५-२१", "content_sanskrit": "तत्रायतनावासेन स्नातो हुतहुताशनः ।\nकृतकृत्यमिवात्मानं मानयित्वा निशाचरः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004341021, "chapter_id": 24341, "verse_number": "५-३-३५-२२", "content_sanskrit": "गन्तुकामः परं मार्गं लङ्कायां नृपसत्तम ।\nएकमुद्धरतो लिङ्गं प्रणतः सव्यपाणिना॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004341022, "chapter_id": 24341, "verse_number": "५-३-३५-२३", "content_sanskrit": "द्वितीयं तु द्वितीयेन भक्त्या पौलस्त्यनन्दनः ।\nतावदेव महालिङ्गं पतितं नर्मदांभसि॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004341023, "chapter_id": 24341, "verse_number": "५-३-३५-२४", "content_sanskrit": "याहि याहीति चेत्युक्त्वा जलमध्ये प्रतिष्ठितः ।\nनमित्वा रावणिस्तस्य देवस्य परमेष्ठिनः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004341024, "chapter_id": 24341, "verse_number": "५-३-३५-२५", "content_sanskrit": "जगामाकाशमाविश्य पूज्यमानो निशाचरैः ।\nतदा प्रभृति तत्तीर्थं मेघनादेति विश्रुतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004341025, "chapter_id": 24341, "verse_number": "५-३-३५-२६", "content_sanskrit": "पूर्वं तु गर्जनं नाम सर्वपापक्षयंकरम् ।\nतस्मिंस्तीर्थे तु राजेन्द्र यस्तु स्नानं समाचरेत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004341026, "chapter_id": 24341, "verse_number": "५-३-३५-२७", "content_sanskrit": "अहोरात्रोषितो भूत्वा अश्वमेधफलं लभेत् ।\nपिण्डदानं तु यः कुर्यात्तस्मिंस्तीर्थे नराधिप॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004341027, "chapter_id": 24341, "verse_number": "५-३-३५-२८", "content_sanskrit": "यत्फलं सत्त्रयज्ञेन तद्भवेन्नात्र संशयः ।\nतेन द्वादशवर्षाणि पितरः संप्रतर्पिताः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004341028, "chapter_id": 24341, "verse_number": "५-३-३५-२९", "content_sanskrit": "यस्तु भोजयते विप्रं षड्रसात्रेन भारत ।\nअक्षयपुण्यमाप्नोति तत्र तीर्थे नरोत्तम॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004341029, "chapter_id": 24341, "verse_number": "५-३-३५-३०", "content_sanskrit": "प्राणत्यागं तु यः कुर्याद्भावितो भावितात्मना ।\nस वसेच्छाङ्करे लोके यावदा भूतसम्प्लवम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004341030, "chapter_id": 24341, "verse_number": "५-३-३५-३१", "content_sanskrit": "एषा ते नरशार्दूल गर्जनोत्पत्तिरुत्तमा ।\nकथिता स्नेहबन्धेन सर्वपापक्षयकरी॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]