[{"id": 2093459, "chapter_id": 2996, "verse_number": "१३-१२६-१", "content_sanskrit": "`शुक उवाच।\nनानावर्णैरुपेतानां गवां किं मुनिसत्तम।\nकपिलाः सर्ववर्णेषु वरिष्ठत्वमवाप्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093460, "chapter_id": 2996, "verse_number": "१३-१२६-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093461, "chapter_id": 2996, "verse_number": "१३-१२६-२", "content_sanskrit": "शृणु पुत्र यथा गोषु वरिष्ठाः कपिलाः स्मृताः।\nकपिलत्वं च सम्प्राप्ताः पूज्याश्चि सततं नृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093462, "chapter_id": 2996, "verse_number": "१३-१२६-३", "content_sanskrit": "अग्निः पुरापचक्राम देवेभ्य इति नः श्रुतम्।\nदेवेभ्यो मां छादयत शरण्याः शरणं गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093463, "chapter_id": 2996, "verse_number": "१३-१२६-४", "content_sanskrit": "ऊचुस्ताः सहितास्तत्र स्वागतं तव पावकः।\nइह गुप्तस्त्वमस्माभिर्न देवैरुपलप्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093464, "chapter_id": 2996, "verse_number": "१३-१२६-५", "content_sanskrit": "अथ देवा विवित्सन्तः पावकं परिचक्रमुः।\nगोषु गुप्तं च विज्ञाय ताः क्षिप्रमुपतस्थिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093465, "chapter_id": 2996, "verse_number": "१३-१२६-६", "content_sanskrit": "युष्मासु निवसत्यग्निरिति गाः समचूचुदन्।\nप्रकाश्यतां हुतवहो लोकान्न च्छेत्तुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093466, "chapter_id": 2996, "verse_number": "१३-१२६-७", "content_sanskrit": "एवमस्त्वित्युनुज्ञाय पावकं समदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093467, "chapter_id": 2996, "verse_number": "१३-१२६-८", "content_sanskrit": "अधिगम्य पावकं तुष्टास्ते देवाः सद्य एव तु।\nअग्निं प्रचोदयामासुः क्रियतां गोष्वनुग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093468, "chapter_id": 2996, "verse_number": "१३-१२६-९", "content_sanskrit": "गवां तु यासां गात्रेषु पावकः समवस्थितः।\nकपिलत्वमनुप्राप्ताः सर्वश्रेष्ठत्वमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093469, "chapter_id": 2996, "verse_number": "१३-१२६-१०", "content_sanskrit": "महाफलत्वं लोके च ददौ तासां हुताशनः।\nतस्माद्धि सर्ववर्णानां कपिलां गां प्रदापय।\nश्रोत्रियाय प्रशान्ताय प्रयतायाग्निहोत्रिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093470, "chapter_id": 2996, "verse_number": "१३-१२६-११", "content_sanskrit": "यावन्ति रोमाणि भन्ति धेन्वा\nयुगानि तावन्ति पुनाति दातॄन्।\nप्रतिग्रहीतॄंश्च पुनाति दत्ता\nशिष्टे तु गौर्वै प्रतिपादनेन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093471, "chapter_id": 2996, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षड्विंशत्यधिकशततमोऽध्यायः॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]