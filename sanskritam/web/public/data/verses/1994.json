[{"id": 2044281, "chapter_id": 1994, "verse_number": "६-४३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044282, "chapter_id": 1994, "verse_number": "६-४३-१", "content_sanskrit": "गीता सुगीता कर्तव्या किमन्यैः शास्त्रसंग्रहैः ।\nया स्वयं पद्मनाभस्य सुखपद्माद्विनिःसृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044283, "chapter_id": 1994, "verse_number": "६-४३-२", "content_sanskrit": "सर्वशास्त्रमयी गीता सर्वदेवमयो हरिः।\nसर्वतीर्थमयी गङ्गा सर्वदेवमयो मनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044284, "chapter_id": 1994, "verse_number": "६-४३-३", "content_sanskrit": "गीता गङ्गा च गायत्री गोविन्देति हृदि स्थिते।\nचतुर्गकारसंयुक्ते पुनर्जन्म न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044285, "chapter_id": 1994, "verse_number": "६-४३-४", "content_sanskrit": "षट्शतानि सविंशानि श्लोकानां प्राह केशवः।\nअर्जुनः सप्तपञ्चाशत्सप्तषष्टिं तु सञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044286, "chapter_id": 1994, "verse_number": "६-४३-५", "content_sanskrit": "धृतराष्ट्रः श्लोकमेकं गीताया मानमुच्यते ।\nभारतामृतसर्वस्वगीताया मथितस्य च।\nसारमुद्धृत्य कृष्णेन अर्जुनस्य मुखे हुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044287, "chapter_id": 1994, "verse_number": "६-४३-६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044288, "chapter_id": 1994, "verse_number": "६-४३-६", "content_sanskrit": "ततो धनंजयं दृष्ट्वा बाणगाण्डीवधारिणम् ।\nपुनरेव महानादं व्यसृजन्त महारथाःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044289, "chapter_id": 1994, "verse_number": "६-४३-७", "content_sanskrit": "पाण्डवाः सोमकाश्चैव ये चैषामनुयायिनः ।\nदध्मुश्च मुदिताः शङ्खान्वीराः सागरसंभवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044290, "chapter_id": 1994, "verse_number": "६-४३-८", "content_sanskrit": "ततो भेर्यश्च पेश्यश्च क्रकचा गोविषाणिकाः ।\nसहसैवाभ्यहन्यन्त ततः शब्दो महानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044291, "chapter_id": 1994, "verse_number": "६-४३-९", "content_sanskrit": "तथा देवाः सगन्धर्वाः पितरश्च जनाधिप ।\nसिद्धचारणसङ्घाश्च समीयुस्ते दिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044292, "chapter_id": 1994, "verse_number": "६-४३-१०", "content_sanskrit": "ऋषयश्च महाभागाः पुरस्कृत्य शतक्रतुम् ।\nसमीयुस्तत्र सहिता द्रुष्टुं तद्वैशसं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044293, "chapter_id": 1994, "verse_number": "६-४३-११", "content_sanskrit": "` ते सेने स्तिमिते सञ्जे वीक्षमाणे परस्परम् ।\nगङ्गायमुनयोर्वेगो यथैवैत्य परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044294, "chapter_id": 1994, "verse_number": "६-४३-१२", "content_sanskrit": "एवं प्रवत्ते ते सेने निःशब्दे जनसंसदि ।\nचित्रे पट इवालेख्ये दर्शनीयतरे शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044295, "chapter_id": 1994, "verse_number": "६-४३-१३", "content_sanskrit": "ततो युधिष्ठिरो दृष्ट्वा युद्धाय समवस्थिते।\nते सेने सागरप्रख्ये मुहुः प्रज्वलिते नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044296, "chapter_id": 1994, "verse_number": "६-४३-१४", "content_sanskrit": "विमुच्य कवचं वीरो निक्षिप्य च वरायुधम् ।\nअवरुह्य रथात्क्षिप्रं पद्म्यामेव कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044297, "chapter_id": 1994, "verse_number": "६-४३-१५", "content_sanskrit": "पितामहमभिप्रेक्ष्य धर्मराजो युधिष्ठिरः ।\nवाग्यतः प्रययौ धीरः प्राङ्भुखो रिपुवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044298, "chapter_id": 1994, "verse_number": "६-४३-१६", "content_sanskrit": "तं प्रयान्तमभिप्रेभ्य कुन्तीपुत्रो धनञ्जयः ।\nअवतीर्य रथात्तूर्णं भ्रातृभिः सहितोऽन्वयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044299, "chapter_id": 1994, "verse_number": "६-४३-१७", "content_sanskrit": "वासुदेवश्च भगवान्पृष्ठतोऽनुजगाम तम् ।\nतथा मुख्याश्च राजानस्तच्चित्ता जग्मुरुत्सुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044300, "chapter_id": 1994, "verse_number": "६-४३-१८x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044301, "chapter_id": 1994, "verse_number": "६-४३-१८", "content_sanskrit": "किं ते व्यवसितं राजन्यदस्मानपहाय वै।\nप्रद्म्यामेव प्रयातोऽसि प्राङ्मुखो रिपुवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044302, "chapter_id": 1994, "verse_number": "६-४३-१९x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044303, "chapter_id": 1994, "verse_number": "६-४३-१९", "content_sanskrit": "क्व गमिष्यसि राजेन्द्र निक्षिप्तकवचायुधः।\nदंशितेष्वरिसैन्येषु भ्रातॄनुत्सृज्य पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044304, "chapter_id": 1994, "verse_number": "६-४३-२०x", "content_sanskrit": "नकुल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044305, "chapter_id": 1994, "verse_number": "६-४३-२०", "content_sanskrit": "एवं गते त्वयि ज्येष्ठे मम भ्रातरि भारत।\nभीमे दुनोति हृदयं ब्रूहि गन्ता भवान्क्व नु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044306, "chapter_id": 1994, "verse_number": "६-४३-२१x", "content_sanskrit": "सहदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044307, "chapter_id": 1994, "verse_number": "६-४३-२१", "content_sanskrit": "अस्मिन्रणसमूहे वै वर्तमाने महाभये।\nउत्सृज्य क्व नु गन्तासि शत्रूनभिमुखो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044308, "chapter_id": 1994, "verse_number": "६-४३-२२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044309, "chapter_id": 1994, "verse_number": "६-४३-२२", "content_sanskrit": "एवमाभाष्यमाणोऽपि भ्रातृभिः कुरुनन्दनः।\nनोवाच वाग्यतः किंचिद्गच्छत्येव युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044310, "chapter_id": 1994, "verse_number": "६-४३-२३", "content_sanskrit": "तानुवाच महाप्राज्ञो वासुदेवो महामनाः ।\nअभिप्रायोऽस्य विज्ञातो मयेति प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044311, "chapter_id": 1994, "verse_number": "६-४३-२४", "content_sanskrit": "एष भीष्मं तथा द्रोणं गौतमं शल्यमेव च।\nअनुमान्य गुरून्सर्वान्योत्स्यते पार्थिवोऽरिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044312, "chapter_id": 1994, "verse_number": "६-४३-२५", "content_sanskrit": "श्रूयते हि पुराकल्पे गुरूनननुमान्य यः।\nयुध्यते स भवेद्व्यक्तमपध्यातो महत्तरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044313, "chapter_id": 1994, "verse_number": "६-४३-२६", "content_sanskrit": "अनुमान्य यथाशास्त्रं यस्तु युध्येन्महत्तरैः ।\nध्रुवस्तस्य जयो युद्धे भवेदिति मतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2044314, "chapter_id": 1994, "verse_number": "६-४३-२७", "content_sanskrit": "एवं ब्रुवति कृष्णेऽत्र धार्तराष्ट्रचमूं प्रति।\nहाहाकारो महानासीन्निःशब्दास्त्वपरेऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2044315, "chapter_id": 1994, "verse_number": "६-४३-२८", "content_sanskrit": "दृष्ट्वा युधिष्ठिरं दूराद्धार्तराष्ट्रस्य सैनिकाः ।\nमिथः संकथयांचक्रुरेषो हि कुलपांसनः ॥ ६-४३-२९aव्यक्तं भीत इवाभ्येति राजासौ भीष्ममन्तिकम् ।\nयुधिष्ठिरः ससोदर्यः शरणार्थं प्रयाचकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2044316, "chapter_id": 1994, "verse_number": "६-४३-३०", "content_sanskrit": "धनञ्जये कथं नाथे पाण्डवे च वृकोदरे ।\nनकुले सहदेवे च भीतिरभ्येति पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2044317, "chapter_id": 1994, "verse_number": "६-४३-३१", "content_sanskrit": "न नूनं क्षत्रियकुले जातः संप्रथिते भुवि।\nयथाऽस्य हृदयं भीतमल्पसत्वस्य संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2044318, "chapter_id": 1994, "verse_number": "६-४३-३२", "content_sanskrit": "ततस्ते सैनिकाः सर्वे प्रशंसन्ति स्म कौरवान् ।\nहृष्टाः सुमनसो भूत्वा चेलानि दुधुवुश्च ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2044319, "chapter_id": 1994, "verse_number": "६-४३-३३", "content_sanskrit": "व्यनिन्दंश्च तथा सर्वे योधास्तव विशांपते।\nयुधिष्ठिरं ससोदर्यं सहितं केशवनेन हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2044320, "chapter_id": 1994, "verse_number": "६-४३-३४", "content_sanskrit": "ततस्तत्कौरवं सैन्यं धिक्वृत्वा तु युधिष्ठिरम् ।\nनिःशब्दमभवत्तूर्णं पुनरेव विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2044321, "chapter_id": 1994, "verse_number": "६-४३-३५", "content_sanskrit": "किं नु वक्ष्याति राजाऽसौ किं भीष्मः प्रतिवक्ष्यति।\nकिं भीमः समरश्लाघी किं नु कृष्णार्जुनाविति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2044322, "chapter_id": 1994, "verse_number": "६-४३-३६", "content_sanskrit": "विवक्षितं किमस्येति संशयः सुमहानभूत् ।\nउभयो सेनयो राजन्युधिष्ठिरकृते तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2044323, "chapter_id": 1994, "verse_number": "६-४३-३७", "content_sanskrit": "सोऽवगाह्य चमूं शत्रोः शरशक्तिसमाकुलाम् ।\nभीष्ममेवाभ्यात्तूर्णं भ्रातृभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2044324, "chapter_id": 1994, "verse_number": "६-४३-३८", "content_sanskrit": "तमुवाच ततः पादौ कारभ्यां पीड्य पाण्डवः ।\nभीष्मं शान्तनवं राजा युद्धाय समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2044325, "chapter_id": 1994, "verse_number": "६-४३-३९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2044326, "chapter_id": 1994, "verse_number": "६-४३-३९", "content_sanskrit": "आमन्त्रये त्वां दुर्धर्ष त्वया योत्स्यामहे सह।\nअनजानीहि मां तात आशिषश्च प्रयोजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2044327, "chapter_id": 1994, "verse_number": "६-४३-४०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2044328, "chapter_id": 1994, "verse_number": "६-४३-४०", "content_sanskrit": "यद्येवं नाभिगच्छेथा युधि मां पृथिवीपते।\nशपेयं त्वां महाराज परीभावाय भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2044329, "chapter_id": 1994, "verse_number": "६-४३-४१", "content_sanskrit": "प्रीतोऽहं पुत्र युध्यस्व जयमाप्नुहि पाण्डव ।\nयत्तेऽभिलषितं चान्यत्तदवाप्नुहि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2044330, "chapter_id": 1994, "verse_number": "६-४३-४२", "content_sanskrit": "व्रियतां च वरः पार्थ किमस्मत्तोऽभिकाङ्क्षसि ।\nएवं गते महाराज न तवास्ति पराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2044331, "chapter_id": 1994, "verse_number": "६-४३-४३", "content_sanskrit": "अर्थस्य पुरुषो दासो दासस्त्वर्थो न कस्यचित्।\nइति सत्यं महाराज बद्धोऽस्म्यर्थेन कौरवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2044332, "chapter_id": 1994, "verse_number": "६-४३-४४", "content_sanskrit": "अतस्त्वां क्लीबवद्वाक्यं ब्रवीमि कुरुनन्दन ।\nभृतोऽस्त्म्यर्थेन कौरव्य युद्धादन्यत्किमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2044333, "chapter_id": 1994, "verse_number": "६-४३-४५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2044334, "chapter_id": 1994, "verse_number": "६-४३-४५", "content_sanskrit": "मन्त्रयस्व महाबाहो हितैषी मम नित्यशः।\nयुध्यस्व कौरवस्यार्थे ममैष सततं वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2044335, "chapter_id": 1994, "verse_number": "६-४३-४६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2044336, "chapter_id": 1994, "verse_number": "६-४३-४६", "content_sanskrit": "राजन्किमत्र साह्यं ते करोमि कुरुनन्दन।\nकामं योत्स्ये परस्यार्थे ब्रूहि यत्ते विवक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2044337, "chapter_id": 1994, "verse_number": "६-४३-४७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2044338, "chapter_id": 1994, "verse_number": "६-४३-४७", "content_sanskrit": "कथं जयेयं संग्रामे भवन्तमपराजितम्।\nएतन्मे मन्त्रय हितं यदि श्रेयः प्रपश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2044339, "chapter_id": 1994, "verse_number": "६-४३-४८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2044340, "chapter_id": 1994, "verse_number": "६-४३-४८", "content_sanskrit": "नैनं पश्यामि कौन्तेय यो मां युध्यन्तमाहवे।\nविजयेत पुमान्कश्तित्साक्षादपि शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2044341, "chapter_id": 1994, "verse_number": "६-४३-४९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2044342, "chapter_id": 1994, "verse_number": "६-४३-४९", "content_sanskrit": "हन्त पृच्छामि तस्मात्त्वां पितामह नमोस्तु ते।\nवधोपायं ब्रवीहि त्वमात्मनः समरे परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2044343, "chapter_id": 1994, "verse_number": "६-४३-५०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2044344, "chapter_id": 1994, "verse_number": "६-४३-५०", "content_sanskrit": "न स्म तं तात पश्यामि समरे यो जयेत माम्।\nन तावन्मृत्युकालोऽपि पुनरागमनं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2044345, "chapter_id": 1994, "verse_number": "६-४३-५१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2044346, "chapter_id": 1994, "verse_number": "६-४३-५१", "content_sanskrit": "ततो युधिष्ठिरो वाक्यं भीष्मस्य कुरुनन्दन।\nशिरसा प्रतिजग्राह भूयस्तमभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2044347, "chapter_id": 1994, "verse_number": "६-४३-५२", "content_sanskrit": "प्रायात्पुनर्महाबाहुराचार्यस्य रथं प्रति।\nपश्यतां सर्वसैन्यानां मध्येन भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2044348, "chapter_id": 1994, "verse_number": "६-४३-५३", "content_sanskrit": "स द्रोणमभिवाद्याथ कृत्वं चाभिप्रदक्षिणम् ।\nउवाच राजा दुर्धर्षमात्मनिःश्रेयसं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2044349, "chapter_id": 1994, "verse_number": "६-४३-५४", "content_sanskrit": "आमन्त्रये त्वां भगवन्योत्स्ये विगितकल्मषः ।\nकथं जये रिपून्सर्वाननुज्ञातस्त्वया द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2044350, "chapter_id": 1994, "verse_number": "६-४३-५५x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2044351, "chapter_id": 1994, "verse_number": "६-४३-५५", "content_sanskrit": "यदि मां नाभिगच्छेथा युद्धाय कृतनिश्चयः।\nशपेयं त्वां महाराज परीभावाय सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2044352, "chapter_id": 1994, "verse_number": "६-४३-५६", "content_sanskrit": "तद्युधिष्ठिर तुष्टोऽस्मि पूजितश्च त्वयाऽनघ।\nअनुजानामि युध्यस्व विजयं समवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2044353, "chapter_id": 1994, "verse_number": "६-४३-५७", "content_sanskrit": "करवाणि च ते कामं ब्रूहि त्वमभिकाङ्क्षितम् ।\nएवं गते महाराज युद्धादन्यत्किमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2044354, "chapter_id": 1994, "verse_number": "६-४३-५८", "content_sanskrit": "अर्थस्य पुरुषो दासो दासस्त्वर्थो न कस्यचित्।\nइति सत्यं महाराज बद्धोऽस्म्यर्थेन कौरवैःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2044355, "chapter_id": 1994, "verse_number": "६-४३-५९", "content_sanskrit": "ब्रवीम्येतत्क्लीबवत्त्वां युद्धादन्यत्किमिच्छसि।\nयोत्स्येऽहं कौरवस्यार्थे तवाशास्यो जयो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2044356, "chapter_id": 1994, "verse_number": "६-४३-६०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2044357, "chapter_id": 1994, "verse_number": "६-४३-६०", "content_sanskrit": "जयमाशास्स्व मे ब्रह्मन्मन्त्रयस्व च मद्धितम्।\nयुध्यस्व कौरवस्यार्थे वर एष वृतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2044358, "chapter_id": 1994, "verse_number": "६-४३-६१x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2044359, "chapter_id": 1994, "verse_number": "६-४३-६१", "content_sanskrit": "ध्रुवस्ते विजयो राजन्यस्य मन्त्री हरिस्तव ।\nअहं त्वामभिजानामि रणे शत्रून्विजेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2044360, "chapter_id": 1994, "verse_number": "६-४३-६२", "content_sanskrit": "यतो धर्मस्ततः कृष्णो यतः कृष्णस्ततो जयः।\nयुध्यस्व गच्छ कौन्तेय पृच्छ मां किं ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2044361, "chapter_id": 1994, "verse_number": "६-४३-६३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2044362, "chapter_id": 1994, "verse_number": "६-४३-६३", "content_sanskrit": "पृच्छामि त्वां द्विजश्रेष्ठ श्रृणु यन्मेऽभिकाङ्क्षितम्।\nकथं जयेयं संग्रामे भवन्तमपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2044363, "chapter_id": 1994, "verse_number": "६-४३-६४x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2044364, "chapter_id": 1994, "verse_number": "६-४३-६४", "content_sanskrit": "न तेऽस्ति विजयस्तावद्यावद्युद्ध्याम्यहं रणे।\nममाशु निधने राजन्यतस्व सह सदरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2044365, "chapter_id": 1994, "verse_number": "६-४३-६५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2044366, "chapter_id": 1994, "verse_number": "६-४३-६५", "content_sanskrit": "हन्त तस्मान्महाबाहो वधोपायं वदात्मनः।\nआचार्य प्रणिपत्यैष पृच्छामि त्वां नमोऽस्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2044367, "chapter_id": 1994, "verse_number": "६-४३-६६x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2044368, "chapter_id": 1994, "verse_number": "६-४३-६६", "content_sanskrit": "न शत्रुं तात पश्यामि यो मां हन्याद्रथे स्थितम्।\nयुध्यमानं सुसंरब्धं शरवर्षौघवर्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2044369, "chapter_id": 1994, "verse_number": "६-४३-६७", "content_sanskrit": "ऋते प्रायगतं रजन्न्यस्तशस्त्रमचेतनम् ।\nहन्यान्मां युधि योधानां सत्यमेतद्ब्रवीमि ते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2044370, "chapter_id": 1994, "verse_number": "६-४३-६८", "content_sanskrit": "शस्त्रं चाहं रणे जह्यां श्रुत्वा तु महदप्रियम्।\nश्रद्धेपवाक्यात्पुरुषादेतत्सत्यं ब्रवीति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2044371, "chapter_id": 1994, "verse_number": "६-४३-६९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2044372, "chapter_id": 1994, "verse_number": "६-४३-६९", "content_sanskrit": "एतच्छ्रुत्वा महाराज भारद्वाजस्य धीमतः।\nअनुमान्य तमाचार्यं प्रायाच्छारद्वतं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2044373, "chapter_id": 1994, "verse_number": "६-४३-७०", "content_sanskrit": "सोऽभिवाद्य कृपं राजा कृत्वा चापि प्रदक्षिणम् ।\nउवाच दुर्धर्षतमं वाक्यं वाक्यविदां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2044374, "chapter_id": 1994, "verse_number": "६-४३-७१", "content_sanskrit": "अनुमानये त्वां योत्स्येऽहं गुरो विगतकल्मषः ।\nजयेयं च रिपून्सर्वाननुज्ञातस्त्वयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2044375, "chapter_id": 1994, "verse_number": "६-४३-७२x", "content_sanskrit": "कृप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2044376, "chapter_id": 1994, "verse_number": "६-४३-७२", "content_sanskrit": "यदि मां नाभिगच्छेथा युद्धाय कृतनिश्चयः।\nशपेयं त्वां महाराज परीभावाय सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2044377, "chapter_id": 1994, "verse_number": "६-४३-७३", "content_sanskrit": "अर्थस्य पुरुषो दासो दासस्त्वर्थो न कस्यचित् ।\nइति सत्यं महाराज बद्धोऽस्म्यर्थेन कौरवैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2044378, "chapter_id": 1994, "verse_number": "६-४३-७४", "content_sanskrit": "तेषामर्थे महाराज योद्धव्यमिति मे मतिः ।\nअतस्त्वां क्लीबवद्ब्रूयांयुद्धादन्यत्किमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2044379, "chapter_id": 1994, "verse_number": "६-४३-७५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2044380, "chapter_id": 1994, "verse_number": "६-४३-७५", "content_sanskrit": "हन्त पृच्छामि ते तस्मादाचार्य श्रृणु मे वचः।\nइत्युक्त्वा व्यथितो राजा नोवाच गतचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2044381, "chapter_id": 1994, "verse_number": "६-४३-७६x", "content_sanskrit": "सञ्जय उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2044382, "chapter_id": 1994, "verse_number": "६-४३-७६", "content_sanskrit": "तं गौतमः प्रत्युवाच विज्ञायास्य विवक्षितम्।\nअवध्योऽहं महीपाल यद्ध्यस्व जयमाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2044383, "chapter_id": 1994, "verse_number": "६-४३-७७", "content_sanskrit": "प्रीतस्तेऽभिगमेनाहं जयं तव नराधिप ।\nआशासिष्ये सदोत्थाय सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2044384, "chapter_id": 1994, "verse_number": "६-४३-७८", "content_sanskrit": "एतच्छ्रुत्वा महाराज गौतमस्य विशांपते।\nअनुमान्य कृपं राजा प्रययौ येन मद्रराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2044385, "chapter_id": 1994, "verse_number": "६-४३-७९", "content_sanskrit": "स शल्यमभिवाद्याथ कृत्वा चाभिप्रदक्षिणम् ।\nउवाच राजा दुर्धर्षमात्मनिःश्रेयसं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2044386, "chapter_id": 1994, "verse_number": "६-४३-८०", "content_sanskrit": "अनुमानये त्वां दुर्धर्ष योत्स्ये विगतकल्मषः ।\nजयेयं नु परान्राजन्ननुज्ञातस्त्वया रिपून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2044387, "chapter_id": 1994, "verse_number": "६-४३-८१x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2044388, "chapter_id": 1994, "verse_number": "६-४३-८१", "content_sanskrit": "यदि मां नाधिगच्छेथा युद्धाय कृतनिश्चयः ।\nशपेयं त्वां महाराज परीभावाय वै रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2044389, "chapter_id": 1994, "verse_number": "६-४३-८२", "content_sanskrit": "तुष्टोऽस्मि पूजितश्चास्मि यत्काङ्क्षसि तदस्तु ते ।\nअनुजानामि चैव त्वां युध्यस्व जयमाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2044390, "chapter_id": 1994, "verse_number": "६-४३-८३", "content_sanskrit": "ब्रूहि चैष परं वीर केनार्थः किं ददामि ते।\nएवं गते महाराज युद्धादन्यत्किमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2044391, "chapter_id": 1994, "verse_number": "६-४३-८४", "content_sanskrit": "अर्थस्य पुरुषो दासो दासस्त्वर्थो न कस्यचित्।\nइति सत्यं महाराज बद्धोस्म्यर्थेन कौरवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2044392, "chapter_id": 1994, "verse_number": "६-४३-८५", "content_sanskrit": "करिष्यामि हि ते कामं भागिनेय यथेप्सितम्।\nब्रवीम्यतः क्लीबवत्त्वां युद्धादन्यत्किमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2044393, "chapter_id": 1994, "verse_number": "६-४३-८६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2044394, "chapter_id": 1994, "verse_number": "६-४३-८६", "content_sanskrit": "मन्त्रयस्व महाराज नित्यं मद्धितमुत्तमम्।\nकामं युद्ध्य परस्यार्थे वरमेतं वृणोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2044395, "chapter_id": 1994, "verse_number": "६-४३-८७x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2044396, "chapter_id": 1994, "verse_number": "६-४३-८७", "content_sanskrit": "किमत्र ब्रूहि साह्यं ते करोमि नृपसत्तम।\nकामं योत्स्ये परस्यार्थे बद्धोऽस्म्यर्थेन कौरवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2044397, "chapter_id": 1994, "verse_number": "६-४३-८८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2044398, "chapter_id": 1994, "verse_number": "६-४३-८८", "content_sanskrit": "स एव मे वरः शल्य उद्योगे यस्त्वया कृतः।\nसूतपुत्रस्य संग्रामे कार्यस्तेजोवधस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2044399, "chapter_id": 1994, "verse_number": "६-४३-८९x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2044400, "chapter_id": 1994, "verse_number": "६-४३-८९", "content_sanskrit": "संपत्स्यत्येष ते कामः कुन्तीपुत्र यथेप्सितम् ।\nगच्छ युध्यस्व विस्रब्धः प्रतिजाने वचस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2044401, "chapter_id": 1994, "verse_number": "६-४३-९०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2044402, "chapter_id": 1994, "verse_number": "६-४३-९०", "content_sanskrit": "अनुमान्याथ कौन्तेयो मातुलं मद्रकेश्वरम् ।\nनिर्जगाम महासैन्याद्भ्रतृभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2044403, "chapter_id": 1994, "verse_number": "६-४३-९१", "content_sanskrit": "वासुदेवस्तु राधेयमाहवेऽभिजगाम वै।\nतत एनमुवाचेदं पाण्डवार्थे गदाग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2044404, "chapter_id": 1994, "verse_number": "६-४३-९२", "content_sanskrit": "श्रुतं मे कर्ण भीष्मस्य द्वोषात्किल न योत्स्यसे।\nअस्मान्वरय राधेय यावद्भीष्मो न हन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2044405, "chapter_id": 1994, "verse_number": "६-४३-९३", "content_sanskrit": "हते तु भीष्मे राधेय पुनरेष्यसि संयुगम् ।\nधार्तराष्ट्रस्य साहाय्यं यदि पश्यसि चेत्समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2044406, "chapter_id": 1994, "verse_number": "६-४३-९४x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2044407, "chapter_id": 1994, "verse_number": "६-४३-९४", "content_sanskrit": "न विप्रियं करिष्यामि धार्तराष्ट्रस्य केशव ।\nत्यक्तप्राणं हि मां विद्धि दुर्योधनहितैषिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2044408, "chapter_id": 1994, "verse_number": "६-४३-९५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2044409, "chapter_id": 1994, "verse_number": "६-४३-९५", "content_sanskrit": "तच्छ्रुत्वा वचनं कृष्णः संन्यवर्तत भारत ।\nयुधिष्ठिरपुरोगैश्च पाण्डवैः सह संगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2044410, "chapter_id": 1994, "verse_number": "६-४३-९६", "content_sanskrit": "अथ सैन्यस्य मध्ये तु प्राक्रोशत्पाण्डवाग्रजः ।\nयोऽस्मान्वृणोति तमहं वरये साह्यकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2044411, "chapter_id": 1994, "verse_number": "६-४३-९७", "content_sanskrit": "अथ तान्समभिप्रेक्ष्य युयुत्सुरिदमब्रवीत् ।\nप्रीतात्मा धर्मराजानं कुन्तीपुत्रं युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2044412, "chapter_id": 1994, "verse_number": "६-४३-९८", "content_sanskrit": "अहं योत्स्यामि भवतः संयुगे धृतराष्ट्रजान् ।\nयुष्मदर्थं महाराज यदि मां वृणुषेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2044413, "chapter_id": 1994, "verse_number": "६-४३-९९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2044414, "chapter_id": 1994, "verse_number": "६-४३-९९", "content_sanskrit": "एह्येहि सर्वे योत्स्यामस्तव भ्रातॄनपण्डितान्।\nयुयुत्सो वासुदेवश्च वयं च ब्रूम सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2044415, "chapter_id": 1994, "verse_number": "६-४३-१००", "content_sanskrit": "वृणोमि त्वां महाबाहो युध्यस्व मम कारणात्।\nत्वयि पिण्डश्च तन्तुश्च धृतराष्ट्रस्य दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2044416, "chapter_id": 1994, "verse_number": "६-४३-१०१", "content_sanskrit": "भजस्वास्मान्राजपुत्र भजमानान्महाद्युते ।\nन भविष्यति दुर्बुद्धिर्धार्तराष्ट्रोऽत्यमर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2044417, "chapter_id": 1994, "verse_number": "६-४३-१०२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2044418, "chapter_id": 1994, "verse_number": "६-४३-१०२", "content_sanskrit": "ततो युयुत्सुः कौरव्यान्परित्यज्य सुतांस्तव।\nजगाम पाण्डुपुत्राणां सेनां विश्राव्य दुन्दुभिं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2044419, "chapter_id": 1994, "verse_number": "६-४३-१०३", "content_sanskrit": "ततो युधिष्ठिरो राजा संप्रहृष्टःक सहानुजः ।\nजग्राह कवचं भूयो दीप्तिमत्कनकोञ्ज्वलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2044420, "chapter_id": 1994, "verse_number": "६-४३-१०४", "content_sanskrit": "प्रत्यपद्यन्त ते सर्वे स्वरथान्पुरुषर्षभाः ।\nततो व्यूहं यथापूर्वं प्रत्यव्यूहन्त ते पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2044421, "chapter_id": 1994, "verse_number": "६-४३-१०५", "content_sanskrit": "अवादयन्दुन्दुभींश्च शतशश्चैव पुष्करान् ।\nसिंहनादांश्च विविधान्विनेदुः पुरुषर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2044422, "chapter_id": 1994, "verse_number": "६-४३-१०६", "content_sanskrit": "रथस्थान्पुरुषव्याघ्रान्पाण्डवान्प्रेक्ष्य पार्थिवाः ।\nधृष्टद्युम्नादयः सर्वे पुनर्जहृषिरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2044423, "chapter_id": 1994, "verse_number": "६-४३-१०७", "content_sanskrit": "गौरवं पाण्डुपुत्राणां मान्यान्मानयतां च तान्।\nदृष्ट्वा महीक्षितस्तत्र पूजयांचक्रिरे भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2044424, "chapter_id": 1994, "verse_number": "६-४३-१०८", "content_sanskrit": "सौहृदं च कृपां चैव प्राप्तकालं महात्मनाम् ।\nदयां च ज्ञातिषु परां कथयांचक्रिरे नृपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2044425, "chapter_id": 1994, "verse_number": "६-४३-१०९", "content_sanskrit": "साधुसाध्विति सर्वत्र निश्चेरुः स्तुतिसंहिताः।\nवाचः पुण्याः कीर्तिमतां मनोहृदयहर्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2044426, "chapter_id": 1994, "verse_number": "६-४३-११०", "content_sanskrit": "म्लेच्छाश्चार्याश्च ये तत्र ददृशुः शुश्रुवुस्तथा ।\nवृत्तं तत्पाण्डुपुत्राणां रुरुदुस्ते सगद्गदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2044427, "chapter_id": 1994, "verse_number": "६-४३-१११", "content_sanskrit": "ततो जघ्नुर्महाभेरीः शतशश्च सहस्रशः ।\nशङ्खांश्च गोक्षीरनिभान्दध्मुर्हृष्टा मनस्विनः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2044428, "chapter_id": 1994, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि त्रिचत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}]