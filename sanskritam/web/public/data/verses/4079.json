[{"id": 2142880, "chapter_id": 4079, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142881, "chapter_id": 4079, "verse_number": "१", "content_sanskrit": "ऋषयोऽथाब्रुवन् सर्वे देवाश्च त्रिदिवेश्वराः ।\nअयं वै नहुषः श्रीमान् देवराज्येऽभिषिच्यताम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142882, "chapter_id": 4079, "verse_number": "२", "content_sanskrit": "तेजस्वी च यशस्वी च धार्मिकश्चैव नित्यदा ।\nते गत्वा त्वब्रुवन् सर्वे राजा नो भव पार्थिव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142883, "chapter_id": 4079, "verse_number": "३", "content_sanskrit": "स तानुवाच नहुषो देवान् ऋषिगणांस्तथा ।\nपितृभिः सहितो राजन् परीप्सन् हितमात्मनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142884, "chapter_id": 4079, "verse_number": "४", "content_sanskrit": "दुर्बलोऽहं न मे शक्तिर्भवतां परिपालने ।\nबलवान् ज्ञायतां राजा बलं शक्ते हि नित्यदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142885, "chapter_id": 4079, "verse_number": "५", "content_sanskrit": "तमब्रुवन् पुनः सर्वे देवा ऋषिपुरोगमाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142886, "chapter_id": 4079, "verse_number": "६", "content_sanskrit": "अस्माकं तपसा युक्तः पाहि राज्यं त्रिविष्टपे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142887, "chapter_id": 4079, "verse_number": "७", "content_sanskrit": "परस्परभयं घोरमस्माकं हि न संशयः ।\nअभिषिञ्चस्व राजेन्द्र भव राजा त्रिविष्टपे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142888, "chapter_id": 4079, "verse_number": "८", "content_sanskrit": "देवदानवयक्षाणाम् ऋषीणां रक्षसां तथा ।\nपितृगन्धर्वभूतानां चक्षुर्विषयवर्तिनाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142889, "chapter_id": 4079, "verse_number": "९", "content_sanskrit": "तेज आदास्यसे पश्यन् बलवांश्च भविष्यसि ।\nधर्मं पुरस्कृत्य सदा सर्वलोकाधिपो भव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142890, "chapter_id": 4079, "verse_number": "१०", "content_sanskrit": "ब्रह्मर्षींश्चापि देवांश्च गोपायस्व त्रिविष्टपे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142891, "chapter_id": 4079, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142892, "chapter_id": 4079, "verse_number": "११", "content_sanskrit": "अभ्यषिच्यत राजेन्द्र ततो राजा त्रिविष्टपे ।\nधर्मं पुरस्कृत्य तदा सर्वलोकाधिपोऽभवत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142893, "chapter_id": 4079, "verse_number": "१२", "content_sanskrit": "सुदुर्लभतरं लब्ध्वा प्राप्य राज्यं त्रिविष्टपे ।\nधर्मात्मा सततं भूत्वा कामात्मा समपद्यत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142894, "chapter_id": 4079, "verse_number": "१३", "content_sanskrit": "देवोद्यानेषु सर्वेषु नन्दनोपवनेषु च ।\nकैलासे हिमवत्पृष्ठे मन्दरे श्वेतपर्वते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142895, "chapter_id": 4079, "verse_number": "१४", "content_sanskrit": "सह्ये महेन्द्रमलये समुद्रेषु सरित्सु च ।\nअप्सरोभिः परिवृतो देवकन्यासमावृतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142896, "chapter_id": 4079, "verse_number": "१५", "content_sanskrit": "नहुषो देवराजोऽथ क्रीडन् बहुविधं तदा ।\nशृण्वन् दिव्या बहुविधाः कथाः श्रुतिमनोहराः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142897, "chapter_id": 4079, "verse_number": "१६", "content_sanskrit": "वादित्राणि च सर्वाणि गीतं च मधुरस्वरम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142898, "chapter_id": 4079, "verse_number": "१७", "content_sanskrit": "विश्वावसुर्नारदश्च गन्धर्वाप्सरसां गणाः ।\nऋतवः षट् च देवेन्द्रं मूर्तिमन्त उपासते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142899, "chapter_id": 4079, "verse_number": "१८", "content_sanskrit": "मारुतः सुरभिर्वाति मनोज्ञः सुखशीतलः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142900, "chapter_id": 4079, "verse_number": "१९", "content_sanskrit": "एवं हि क्रीडतस्तस्य नहुषस्य दुरात्मनः ।\nसम्प्राप्ता दर्शनं देवी शक्रस्य महिषी प्रिया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142901, "chapter_id": 4079, "verse_number": "२०", "content_sanskrit": "स तां सन्दृश्य दुष्टात्मा प्राह सर्वान् सभासदः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142902, "chapter_id": 4079, "verse_number": "२१", "content_sanskrit": "इन्द्रस्य महिषी देवी कस्मान्मां नोपतिष्ठति ।\nअहमिन्द्रोऽस्मि देवानां लोकानां च तथेश्वरः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142903, "chapter_id": 4079, "verse_number": "२२", "content_sanskrit": "आगच्छतु शची मह्यं क्षिप्रमद्य निवेशनम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142904, "chapter_id": 4079, "verse_number": "२३", "content_sanskrit": "तच्छ्रुत्वा दुर्मना देवी बृहस्पतिमुवाच ह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142905, "chapter_id": 4079, "verse_number": "२४", "content_sanskrit": "रक्ष मां नहुषाद् ब्रह्मन् त्वामस्मि शरणं गता ।\nसर्वलक्षणसम्पन्नां ब्रह्मंस्त्वं मां प्रभाषसे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142906, "chapter_id": 4079, "verse_number": "२५", "content_sanskrit": "देवराजस्य दयितामत्यन्तसुखभागिनीम् ।\nअवैधव्येन युक्तां वाऽप्येकपत्नीं पतिव्रताम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142907, "chapter_id": 4079, "verse_number": "२६", "content_sanskrit": "उक्तवानसि मां पूर्वम् ऋतां तां कुरु वै गिरम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142908, "chapter_id": 4079, "verse_number": "२७", "content_sanskrit": "नोक्तपूर्वं च भगवन् मृषा ते किञ्चिदीश्वर ।\nतस्मादेतद् भवेत् सत्यं त्वयोक्तं द्विजसत्तम\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142909, "chapter_id": 4079, "verse_number": "२८", "content_sanskrit": "बृहस्पतिरथोवाच इन्द्राणीं भयमोहिताम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142910, "chapter_id": 4079, "verse_number": "२९", "content_sanskrit": "यदुक्ताऽसि मया देवि तत् सत्यं भविता ध्रुवम् ।\nद्रक्ष्यसे देवराजानमिन्द्रं शीघ्रमिहागतम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142911, "chapter_id": 4079, "verse_number": "३०", "content_sanskrit": "न भेतव्यं च नहुषात् सत्यमेतद् ब्रवीमि ते ।\nसमागमिष्ये शक्रेण न चिराद् भवतीमहम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142912, "chapter_id": 4079, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142913, "chapter_id": 4079, "verse_number": "३१", "content_sanskrit": "अथ शुश्राव नहुषः शक्राणीं शरणागताम् ।\nबृहस्पतिं चाङ्गिरसं चुक्रोध नहुषस्तदा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142914, "chapter_id": 4079, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकादशोऽध्यायः ॥११॥ सेनोद्योगपर्वणि एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]