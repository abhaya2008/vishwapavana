[{"id": 6000210000, "chapter_id": 10210, "verse_number": null, "content_sanskrit": "अथ चतुर्दशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000210001, "chapter_id": 10210, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.001.m4a", "display_order": 2}, {"id": 6000210002, "chapter_id": 10210, "verse_number": "१०-१४-१", "content_sanskrit": "विलोक्य दूषितां कृष्णां कृष्णः कृष्णाहिना विभुः।\nतस्या विशुद्धिमन्विच्छन् सर्पं तमुदवासयत्॥ १०/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.002.m4a", "display_order": 3, "topics": [{"text": "यमुनां निर्विषां कर्तुं तद्ध्रदमवगाह्य कालियदमनम्", "range": "१–३२"}]}, {"id": 6000210003, "chapter_id": 10210, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.003.m4a", "display_order": 4}, {"id": 6000210004, "chapter_id": 10210, "verse_number": "१०-१४-२", "content_sanskrit": "कथमन्तर्जलेऽगाधे न्यगृह्णाद् भगवानहिम्।\nस वै बहुयुगावासी यथाऽऽसीद् विप्र कथ्यताम्॥ १०/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.004.m4a", "display_order": 5}, {"id": 6000210005, "chapter_id": 10210, "verse_number": "१०-१४-३", "content_sanskrit": "ब्रह्मन् भगवतस्तस्य भूम्नः स्वच्छन्दवर्तिनः।\nगोपालोदारचरितं कस्तृप्येतामृतं जुषन्॥ १०/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.005.m4a", "display_order": 6}, {"id": 6000210006, "chapter_id": 10210, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.006.m4a", "display_order": 7}, {"id": 6000210007, "chapter_id": 10210, "verse_number": "१०-१४-४", "content_sanskrit": "कालिन्द्यां कालियस्यासीद् ह्रदः कश्चिद् विषाग्निना।\nश्रप्यमाणपयो यस्मिन् पतन्त्युपरिगाः खगाः॥ १०/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.007.m4a", "display_order": 8}, {"id": 6000210008, "chapter_id": 10210, "verse_number": "१०-१४-५", "content_sanskrit": "विप्लुष्मता विषोदोर्मिमारुतेनाभिमर्शिताः।\nम्रियन्ते तीरगा यस्य प्राणिनः स्थिरजङ्गमाः॥ १०/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.008.m4a", "display_order": 9}, {"id": 6000210009, "chapter_id": 10210, "verse_number": "१०-१४-६", "content_sanskrit": "तं चण्डवेगविषवीर्यमवेक्ष्य तेन दुष्टां नदीं च खलसंयमनावतारः।\nकृष्णः कदम्बमधिरुह्य ततोऽतितुङ्गादास्फोट्य गाढरषनो न्यपतद् विषोदे॥ १०/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.009.m4a", "display_order": 10}, {"id": 6000210010, "chapter_id": 10210, "verse_number": "१०-१४-७", "content_sanskrit": "सार्पह्रदः पुरुषसारनिपातवेगसङ्क्षोभितोरगविषोच्छ्वसिताम्बुराशिः।\nपर्यक् प्लुतो विषकषायविभीषणोर्मिभीमो धनुःशतमनन्तबलस्य किं तत्॥ १०/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.010.m4a", "display_order": 11}, {"id": 6000210011, "chapter_id": 10210, "verse_number": "१०-१४-८", "content_sanskrit": "तस्मिन् ह्रदे विहरतो भुजदण्डघूर्णवार्घोषमङ्ग वरवारणविक्रमस्य।\nआश्रुत्य तत् स्वसदनाभिभवं ससैन्यश्चक्षुःश्रवाः समसरत् तममृष्यमाणः॥ १०/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.011.m4a", "display_order": 12}, {"id": 6000210012, "chapter_id": 10210, "verse_number": "१०-१४-९", "content_sanskrit": "तं प्रेक्षणीयसुकुमारघनावदातं श्रीवत्सपीतवसनं स्मितसुन्दरास्यम्।\nक्रीडन्तमप्रतिभयं कमलोदराङ्घ्रिं सन्दश्य मर्मसु रुषा भुजगश्चछाद॥ १०/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.012.m4a", "display_order": 13}, {"id": 6000210013, "chapter_id": 10210, "verse_number": "१०-१४-१०", "content_sanskrit": "तं नागभोगपरिवीतमदृष्टचेष्टमालोक्य तत्प्रियसखाः पशुपा भृशार्ताः।\nकृष्णेऽर्पितात्मसुहृदर्थकलत्रकामा दुःखानुशोकभयमूढधियो निपेतुः॥ १०/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.013.m4a", "display_order": 14}, {"id": 6000210014, "chapter_id": 10210, "verse_number": "१०-१४-११", "content_sanskrit": "गावो वृषा वत्सतर्यः क्रन्दमानाः सुदुःखिताः।\nकृष्णे न्यस्तेक्षणा भीता रुदन्त्य इव तस्थिरे॥ १०/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.014.m4a", "display_order": 15}, {"id": 6000210015, "chapter_id": 10210, "verse_number": "१०-१४-१२", "content_sanskrit": "अथ व्रजे महोत्पातास्‍त्रिविधा ह्यतिदारुणाः।\nउत्पेतुर्दिवि भुव्यात्मन्यासन्नभयशंसिनः॥ १०/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.015.m4a", "display_order": 16}, {"id": 6000210016, "chapter_id": 10210, "verse_number": "१०-१४-१३", "content_sanskrit": "तानालक्ष्य भयोद्विग्ना गोपा नन्दपुरोगमाः।\nविना रामेण गाः कृष्णं ज्ञात्वा चारयितुं गतम्॥ १०/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.016.m4a", "display_order": 17}, {"id": 6000210017, "chapter_id": 10210, "verse_number": "१०-१४-१४", "content_sanskrit": "तैर्दुर्निमित्तैर्निधनं मत्वा प्राप्तमतद्विदः।\nतत्प्राणास्तन्मनस्काश्च दुःखशोकभयातुराः॥ १०/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.017.m4a", "display_order": 18}, {"id": 6000210018, "chapter_id": 10210, "verse_number": "१०-१४-१५", "content_sanskrit": "आबालवृद्धवनिताः सर्वेऽङ्ग पशुवृत्तयः।\nनिर्जग्मुर्गोकुलाद् दीनाः कृष्णदर्शनलालसाः॥ १०/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.018.m4a", "display_order": 19}, {"id": 6000210019, "chapter_id": 10210, "verse_number": "१०-१४-१६", "content_sanskrit": "तांस्तथा कातरान् वीक्ष्य भगवान् माधवो बलः।\nप्रहस्य किञ्चिन्नोवाच प्रभावज्ञोऽनुजस्य सः॥ १०/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.019.m4a", "display_order": 20}, {"id": 6000210020, "chapter_id": 10210, "verse_number": "१०-१४-१७", "content_sanskrit": "तेऽन्वेषमाणा दयितं कृष्णं सूचितया पदैः।\nभगवल्लक्षणैर्जग्मुः पदव्या यमुनातटम्॥ १०/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.020.m4a", "display_order": 21}, {"id": 6000210021, "chapter_id": 10210, "verse_number": "१०-१४-१८", "content_sanskrit": "ते तत्र तत्राब्जयवाङ्कुशाशनिध्वजोपपन्नानि पदानि विश्पतेः।\nमार्गे गवामन्यपदान्तरान्तरे निरीक्षमाणा ययुरङ्ग सत्वराः॥ १०/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.021.m4a", "display_order": 22}, {"id": 6000210022, "chapter_id": 10210, "verse_number": "१०-१४-१९", "content_sanskrit": "अन्तर्ह्रदे भुजगभोगपरीतमारात् कृष्णं निरीहमुपलक्ष्य जलाशयान्ते।\nगोपांश्च मूढधिषणान् परितः पशूंश्च सङ्क्रन्दतः परमकश्मलमापुरार्ताः॥ १०/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.022.m4a", "display_order": 23}, {"id": 6000210023, "chapter_id": 10210, "verse_number": "१०-१४-२०", "content_sanskrit": "गोप्योऽनुरक्तमनसो भगवत्यनन्ते तत्सौहृदस्मितविलोकगिरः स्मरन्त्यः।\nग्रस्तेऽहिना प्रियतमे भृशदुःखतप्ताः शून्यं प्रियव्यतिहृतं ददृशुस्‍त्रिलोकम्॥ १०/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.023.m4a", "display_order": 24}, {"id": 6000210024, "chapter_id": 10210, "verse_number": "१०-१४-२१", "content_sanskrit": "ताः कृष्णमातरमपत्यमनुप्रविष्टां तुल्यव्यथाः समनुगृह्य शुचः स्रवन्त्यः।\nत्रस्ता व्रजप्रियकथाः कथयन्त्य आसन् कृष्णाननेऽर्पितदृशो मृतकप्रतीकाः॥ १०/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.024.m4a", "display_order": 25}, {"id": 6000210025, "chapter_id": 10210, "verse_number": "१०-१४-२२", "content_sanskrit": "कृष्णप्राणान् निर्विशतो नन्दादीन् वीक्ष्य तं ह्रदम्।\nप्रत्यषेधत् स भगवान् रामः कृष्णानुभाववित्॥ १०/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.025.m4a", "display_order": 26}, {"id": 6000210026, "chapter_id": 10210, "verse_number": "१०-१४-२३", "content_sanskrit": "इत्थं स्वगोकुलमनन्यगतिं निरीक्ष्य सस्‍त्रीकुमारमतिदुःखितमात्महेतोः।\nआज्ञाय मर्त्यपदवीमनुवर्तमानः स्थित्वा मुहूर्तमुदतिष्ठदुरङ्गबन्धात्॥ १०/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.026.m4a", "display_order": 27}, {"id": 6000210027, "chapter_id": 10210, "verse_number": "१०-१४-२४", "content_sanskrit": "तत्प्रथ्यमानवपुषा व्यथितात्मभोगस्त्यक्त्वोन्नमय्य कुपितः स्वफणान् भुजङ्गः।\nतस्थौ श्वसन् श्वसनरन्ध्रविषाम्बरीषस्तब्धेक्षणोल्मुकमुखो हरिमीक्षमाणः॥ १०/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.027.m4a", "display_order": 28}, {"id": 6000210028, "chapter_id": 10210, "verse_number": "१०-१४-२५", "content_sanskrit": "तं जिह्वया द्विशिखया परिलेलिहानं द्वे सृक्‍किणी ह्यतिकरालविषाग्निदृष्टिम्।\nक्रीडन्नमुं परिससार यथा खगेन्द्रो बभ्राम सोऽप्यपसरन् प्रसमीक्षमाणः॥ १०/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.028.m4a", "display_order": 29}, {"id": 6000210029, "chapter_id": 10210, "verse_number": "१०-१४-२६", "content_sanskrit": "एवं परिभ्रमहतौजसमुन्नतांसमानम्य तत्पृथुशिरस्यधिरूढ आद्यः।\nतन्मूर्धरत्ननिकरस्पर्शातिताम्रपादाम्बुजोऽमृतकलाधिगुरुर्ननर्त॥ १०/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.029.m4a", "display_order": 30}, {"id": 6000210030, "chapter_id": 10210, "verse_number": "१०-१४-२७", "content_sanskrit": "तं नर्तुमुद्यतमवेक्ष्य तदा तदीयगन्धर्वसिद्धसुरचारणदेववध्वः।\nप्रीत्या मृदङ्गपणवानकवाद्यगीतपुष्पोपहारनुतिभिः सहसोपसेदुः॥ १०/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.030.m4a", "display_order": 31}, {"id": 6000210031, "chapter_id": 10210, "verse_number": "१०-१४-२८", "content_sanskrit": "यद्यच्छिरो न नमते गरकालशीर्ष्णस्तत्तन्ममर्द खलदण्डधरोऽङ्घ्रिपातैः।\nक्षीणे बले भगवतोल्बणमाशु वक्त्राद् रक्तं वमन् परमकश्मलमाप नागः॥ १०/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.031.m4a", "display_order": 32}, {"id": 6000210032, "chapter_id": 10210, "verse_number": "१०-१४-२९", "content_sanskrit": "तस्याक्षिभिर्गरलमुद्वमतः शिरस्सु यद्यत् समुन्नमति निःश्वसतो रुषोच्चैः।\nनृत्यन् पदाऽनुनमयन् स यदा बभूव पुष्पैः स्तुतोऽथ भगवान् पुरुषः पुराणः॥ १०/१४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.032.m4a", "display_order": 33}, {"id": 6000210033, "chapter_id": 10210, "verse_number": "१०-१४-३०", "content_sanskrit": "तच्चित्रताण्डवविरुग्णफणातपत्रो रक्तं मुखैरुरु वमन् नृप भग्नगात्रः।\nस्मृत्वा चराचरगुरुं पुरुषं पुराणं नारायणं तमरणं मनसा जगाम॥ १०/१४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.033.m4a", "display_order": 34}, {"id": 6000210034, "chapter_id": 10210, "verse_number": "१०-१४-३१", "content_sanskrit": "कृष्णस्य गर्भजगतोऽतिभरावसन्नपार्ष्णिप्रहारपरिरुग्णफणातपत्रम्।\nदृष्ट्वाऽहिराजमुपसेदुरमुष्य पत्न्य आर्ताः श्लथद्वसनभूषणकेशबन्धाः॥ १०/१४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.034.m4a", "display_order": 35}, {"id": 6000210035, "chapter_id": 10210, "verse_number": "१०-१४-३२", "content_sanskrit": "तं ता विपन्नमनसोऽथ पुरस्कृतार्हाः कायं निधाय भुवि भूतपतिं प्रणेमुः।\nसाध्व्यः कृताञ्जलिपुटाः परमस्य भर्तुर्मोक्षेच्छवः शरणदं शरणं प्रपन्नाः॥ १०/१४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.035.m4a", "display_order": 36}, {"id": 6000210036, "chapter_id": 10210, "verse_number": null, "content_sanskrit": "नागपत्न्य ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.036.m4a", "display_order": 37}, {"id": 6000210037, "chapter_id": 10210, "verse_number": "१०-१४-३३", "content_sanskrit": "न्याय्यो हि दण्डः कृतकिल्बिषेऽस्मिन् तवावतारः खलनिग्रहाय।\nरिपोः सुतानामपि तुल्यदृष्टेः धत्से दमं फलमेवानुशंस्यम्॥ १०/१४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.037.m4a", "display_order": 38, "topics": [{"text": "कालियपत्नीभिः श्रीकृष्णस्तुतिः", "range": "३३–५९"}]}, {"id": 6000210038, "chapter_id": 10210, "verse_number": "१०-१४-३४", "content_sanskrit": "अनुग्रहोऽयं भवता कृतो हि नो दण्डोऽसतां ते खलु कल्मषापहः।\nयद् दन्दशूकत्वममुष्य देहिनः क्रोधोऽपि तेऽनुग्रह एव सम्मतः॥ १०/१४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.038.m4a", "display_order": 39}, {"id": 6000210039, "chapter_id": 10210, "verse_number": "१०-१४-३५", "content_sanskrit": "तपः सुतप्तं किमनेन पूर्वं निरस्तमानेन च मानदेन।\nधर्मोऽथवा सर्वजनानुकम्पया यतो भवांस्तुष्यति सर्वजीवः॥ १०/१४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.039.m4a", "display_order": 40}, {"id": 6000210040, "chapter_id": 10210, "verse_number": "१०-१४-३६", "content_sanskrit": "कस्यानुभावोऽस्य न देव विद्महे तवाङ्घ्रिरेणुस्पर्शाधिकारः।\nयद्वाञ्छया श्रीर्ललनाऽचरत् तपो विहाय कामान् सुचिरं धृतव्रता॥ १०/१४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.040.m4a", "display_order": 41}, {"id": 6000210041, "chapter_id": 10210, "verse_number": "१०-१४-३७", "content_sanskrit": "न नाकपृष्ठं न च पारमेष्ठ्यं न सार्वभौमं न रसाधिपत्यम्।\nन योगसिद्धीरपुनर्भवं वा वाञ्छन्ति त्वत्पादरजःप्रपन्नाः॥ १०/१४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.041.m4a", "display_order": 42}, {"id": 6000210042, "chapter_id": 10210, "verse_number": "१०-१४-३८", "content_sanskrit": "तदीशनाथाप दुरापमन्यैस्तमोजनिः क्रोधवशोऽप्यनीशः।\nसंसारचक्रे भ्रमतः शरीरिणो यदीप्सितं स्याद्धि भवत्समक्षम्॥ १०/१४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.042.m4a", "display_order": 43}, {"id": 6000210043, "chapter_id": 10210, "verse_number": "१०-१४-३९", "content_sanskrit": "नमस्तुभ्यं भगवते पुरुषाय महात्मने।\nभूतावासाय भूताय पराय परमात्मने॥ १०/१४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.043.m4a", "display_order": 44}, {"id": 6000210044, "chapter_id": 10210, "verse_number": "१०-१४-४०", "content_sanskrit": "ज्ञानविज्ञाननिधये ब्रह्मणेऽनन्तशक्तये।\nअगुणायाविकाराय नमस्तेऽप्राकृताय च॥ १०/१४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.044.m4a", "display_order": 45}, {"id": 6000210045, "chapter_id": 10210, "verse_number": "१०-१४-४१", "content_sanskrit": "कालाय कालनाभाय कालावयवसाक्षिणे।\nविश्वाय तदुपद्रष्ट्रे तत्कर्त्रे विश्वहेतवे॥ १०/१४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.045.m4a", "display_order": 46}, {"id": 6000210046, "chapter_id": 10210, "verse_number": "१०-१४-४२", "content_sanskrit": "भूतमात्रेन्द्रियप्राणमनोबुद्ध्याशयात्मने।\nनिर्गुणेनाभिमानेन गूढस्वात्मानुभूतये॥ १०/१४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.046.m4a", "display_order": 47}, {"id": 6000210047, "chapter_id": 10210, "verse_number": "१०-१४-४३", "content_sanskrit": "नमोऽनन्ताय सूक्ष्माय कूटस्थाय विपश्चिते।\nनानावादानुरोधाय वाच्यवाचकशक्तये॥ १०/१४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.047.m4a", "display_order": 48}, {"id": 6000210048, "chapter_id": 10210, "verse_number": "१०-१४-४४", "content_sanskrit": "नमः प्रमाणमूलाय कवये शास्‍त्रयोनये।\nप्रवृत्ताय निवृत्ताय निगमाय नमो नमः॥ १०/१४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.048.m4a", "display_order": 49}, {"id": 6000210049, "chapter_id": 10210, "verse_number": "१०-१४-४५", "content_sanskrit": "नमः कृष्णाय रामाय वसुदेवसुताय च।\nप्रद्युम्नायानिरुद्धाय सात्त्वतां पतये नमः॥ १०/१४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.049.m4a", "display_order": 50}, {"id": 6000210050, "chapter_id": 10210, "verse_number": "१०-१४-४६", "content_sanskrit": "नमो गुणप्रदीपाय गुणात्मस्थोदयाय च।\nगुणप्रत्युपलक्ष्याय गुणद्रष्ट्रे स्वसंविदे॥ १०/१४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.050.m4a", "display_order": 51}, {"id": 6000210051, "chapter_id": 10210, "verse_number": "१०-१४-४७", "content_sanskrit": "अव्याकृतविहाराय सर्वव्याकृतसिद्धये।\nहृषीकेश नमस्तेऽस्तु मुनये मौनशीलिने॥ १०/१४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.051.m4a", "display_order": 52}, {"id": 6000210052, "chapter_id": 10210, "verse_number": "१०-१४-४८", "content_sanskrit": "परावरगतिज्ञाय सर्वाध्यक्षाय ते नमः।\nअविश्वाय च विश्वाय तद्द्रष्ट्रे विश्वहेतवे॥ १०/१४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.052.m4a", "display_order": 53}, {"id": 6000210053, "chapter_id": 10210, "verse_number": "१०-१४-४९", "content_sanskrit": "त्वं ह्यस्य जन्मस्थितिसंयमान् विभो गुणैरनीहोऽकृतकालशक्तिधृक्।\nतस्मात् स्वभावात् प्रतिबोधयस्व नः समीक्षयाऽमोघविहार ईहसे॥ १०/१४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.053.m4a", "display_order": 54}, {"id": 6000210054, "chapter_id": 10210, "verse_number": "१०-१४-५०", "content_sanskrit": "तस्यैव तेऽमूस्तनवस्‍त्रिलोक्यां शान्ता अशान्ता उत मूढयोनयः।\nशान्ताः प्रियास्ते ह्यधुनाऽवितुः सतां स्थातुश्च ते कर्मपरीप्सयेहतः॥ १०/१४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.054.m4a", "display_order": 55}, {"id": 6000210055, "chapter_id": 10210, "verse_number": "१०-१४-५१", "content_sanskrit": "अपराधः सकृद् भर्त्रा सोढव्यः स्वप्रजाकृतः।\nक्षन्तुमर्हसि शान्तात्मन् मूढस्य त्वामजानतः॥ १०/१४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.055.m4a", "display_order": 56}, {"id": 6000210056, "chapter_id": 10210, "verse_number": "१०-१४-५२", "content_sanskrit": "अनुगृह्णीष्व भगवन् प्राणांस्त्यजति पन्नगः।\nस्‍त्रीणां नः साधुशोच्यानां पतिः प्राणः प्रदीयताम्॥ १०/१४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.056.m4a", "display_order": 57}, {"id": 6000210057, "chapter_id": 10210, "verse_number": "१०-१४-५३", "content_sanskrit": "विधेहि ते किङ्करीणामनुष्ठेयं तवाज्ञया।\nयच्छ्रद्धयाऽनुतिष्ठन् वै मुच्यते स पुमान् भयात्॥ १०/१४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.057.m4a", "display_order": 58}, {"id": 6000210058, "chapter_id": 10210, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.058.m4a", "display_order": 59}, {"id": 6000210059, "chapter_id": 10210, "verse_number": "१०-१४-५४", "content_sanskrit": "इत्थं स नागपत्नीभिर्भगवान् समभिष्टुतः।\nमूर्च्छितं भग्नशिरसं विससर्जाङ्घ्रिकुट्टनैः॥ १०/१४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.059.m4a", "display_order": 60}, {"id": 6000210060, "chapter_id": 10210, "verse_number": "१०-१४-५५", "content_sanskrit": "प्रतिलब्धेन्द्रियप्राणः कालियः शनकैर्हरिम्।\nकृच्छ्रात् समुच्छ्वसन् दीनः कृष्णं प्राह कृताञ्जलिः॥ १०/१४/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.060.m4a", "display_order": 61}, {"id": 6000210061, "chapter_id": 10210, "verse_number": "१०-१४-५६", "content_sanskrit": "वयं खलाः सहोत्पत्त्या तामसा दीर्घमन्यवः।\nस्वभावो दुस्त्यजो नाथ भूतानां यदसद्ग्रहः॥ १०/१४/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.061.m4a", "display_order": 62}, {"id": 6000210062, "chapter_id": 10210, "verse_number": "१०-१४-५७", "content_sanskrit": "त्वया सृष्टमिदं विश्वं धातुर्गुणविसर्जनम्।\nनानास्वभाववीर्यौजोयोनिबीजाशयाकृति॥ १०/१४/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.062.m4a", "display_order": 63}, {"id": 6000210063, "chapter_id": 10210, "verse_number": "१०-१४-५८", "content_sanskrit": "वयं च तत्र भगवन् सर्पा जात्युरुमन्यवः।\nकथं त्यजामस्त्वन्मायां दुस्त्यजां मोहिताः प्रभो॥ १०/१४/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.063.m4a", "display_order": 64}, {"id": 6000210064, "chapter_id": 10210, "verse_number": "१०-१४-५९", "content_sanskrit": "भवान् हि कारणं तत्र सर्वज्ञ जगदीश्वर।\nअनुग्रहं निग्रहं वा मन्यसे तद् विधेहि नः॥ १०/१४/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.064.m4a", "display_order": 65}, {"id": 6000210065, "chapter_id": 10210, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.065.m4a", "display_order": 66}, {"id": 6000210066, "chapter_id": 10210, "verse_number": "१०-१४-६०", "content_sanskrit": "इत्याकर्ण्य वचः प्राह भगवान् कार्यमानुषः।\nनात्र स्थेयं त्वया सर्प समुद्रं याहि माचिरम्॥ १०/१४/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.066.m4a", "display_order": 67, "topics": [{"text": "श्रीकृष्णाज्ञया कालियस्य पुना रमणकद्वीपगमनम्", "range": "६०–६८"}]}, {"id": 6000210067, "chapter_id": 10210, "verse_number": "१०-१४-६१", "content_sanskrit": "सज्ञात्यपत्यदाराढ्यो गोनृभिर्भुज्यते नदी। य एतत् संस्मरेन्मर्त्यस्तुभ्यं मदनुशासनम्।\nकीर्तयन्नुभयोः सन्ध्योर्न युष्मद्भयमाप्नुयात्॥ १०/१४/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.067.m4a", "display_order": 68}, {"id": 6000210068, "chapter_id": 10210, "verse_number": "१०-१४-६२", "content_sanskrit": "योऽस्मिन् स्नात्वा ममाक्रीडे देवादींस्तर्पयेज्जलैः।\nउपोष्य मां स्मरन्नर्चेत् सर्वपापैः प्रमुच्यते॥ १०/१४/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.068.m4a", "display_order": 69}, {"id": 6000210069, "chapter_id": 10210, "verse_number": "१०-१४-६३", "content_sanskrit": "द्वीपं रमणकं हित्वा ह्रदमेतमुपाश्रितः।\nयद्भयात् स सुपर्णस्त्वां नाऽद्यान्मत्पादलाञ्छनम्॥ १०/१४/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.069.m4a", "display_order": 70}, {"id": 6000210070, "chapter_id": 10210, "verse_number": "१०-१४-६४", "content_sanskrit": "एवमुक्तो भगवता कृष्णेनाद्भुतकर्मणा।\nतं पूजयामास मुदा नागपत्न्यश्च सादरम्॥ १०/१४/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.070.m4a", "display_order": 71}, {"id": 6000210071, "chapter_id": 10210, "verse_number": "१०-१४-६५", "content_sanskrit": "दिव्याम्बरस्रङ्मणिभिः परार्घ्यैरपि भूषणैः।\nदिव्यगन्धानुलेपैश्च महत्योत्पलमालया॥ १०/१४/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.071.m4a", "display_order": 72}, {"id": 6000210072, "chapter_id": 10210, "verse_number": "१०-१४-६६", "content_sanskrit": "पूजयित्वा जगन्नाथं प्रसाद्य गरुडध्वजम्॥ १०/१४/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.072.m4a", "display_order": 73}, {"id": 6000210073, "chapter_id": 10210, "verse_number": "१०-१४-६७", "content_sanskrit": "नागराजोऽभ्यनुज्ञातः परिक्रम्य प्रणम्य च।\nसकलत्रसुहृत्पुत्रो द्वीपमब्धेर्जगाम ह॥ १०/१४/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.073.m4a", "display_order": 74}, {"id": 6000210074, "chapter_id": 10210, "verse_number": "१०-१४-६८", "content_sanskrit": "तदैव साऽमृतजला यमुना निर्विषाऽभवत्।\nअनुग्रहाद् भगवतः क्रीडामनुजरूपिणः॥ १०/१४/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_014/BhP_10.014.074.m4a", "display_order": 75}, {"id": 6000210075, "chapter_id": 10210, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे चतुर्दशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]