[{"id": 2106345, "chapter_id": 3308, "verse_number": "१६-३७-१", "content_sanskrit": "वैशम्पायन उवाच।\nअदृष्ट्वा तु नृपः पुत्रान्दर्शनं प्रतिलब्धवान्।\nऋषेः प्रसादात्पुत्राणां स्वरूपाणां कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106346, "chapter_id": 3308, "verse_number": "१६-३७-२", "content_sanskrit": "स राजा राजधर्मांश्च ब्रह्मोपनिषदं तथा।\nअवाप्तवान्नरश्रेष्ठो बुद्धिनिश्चयमेव च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106347, "chapter_id": 3308, "verse_number": "१६-३७-३", "content_sanskrit": "विदुरश्च महाप्राज्ञो ययौ सिद्धिं तपोबलात्।\nधृतराष्ट्रः समासाद्य व्यासं चैव तपस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106348, "chapter_id": 3308, "verse_number": "१६-३७-४x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106349, "chapter_id": 3308, "verse_number": "१६-३७-४", "content_sanskrit": "ममापि वरदो व्यासो दर्शयेत्पितरं यदि।\nतद्रूपवेषवयसं श्रद्दध्यां सर्वमेव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106350, "chapter_id": 3308, "verse_number": "१६-३७-५", "content_sanskrit": "प्रियं मे स्यात्कृतार्थश्च स्यामहं कृतनिश्चयः।\nप्रसादादृषिमुख्यस्य मम कामः समृद्ध्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106351, "chapter_id": 3308, "verse_number": "१६-३७-६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106352, "chapter_id": 3308, "verse_number": "१६-३७-६", "content_sanskrit": "इत्युक्तवचने तस्मिन्नृपे व्यासः प्रतापवान्।\nप्रसादमकरोद्धीमानानयच्च परिक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106353, "chapter_id": 3308, "verse_number": "१६-३७-७", "content_sanskrit": "ततस्तद्रूपवयसमागतं नृपतिं दिवः।\nश्रीमन्तं पितरं राजा ददर्श स परीक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106354, "chapter_id": 3308, "verse_number": "१६-३७-८", "content_sanskrit": "शमीकं च महात्मानं पुत्रं तं चास्य शृङ्गिणम्।\nअमात्या ये च निहता राज्ञस्तांश्च ददर्श ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106355, "chapter_id": 3308, "verse_number": "१६-३७-९", "content_sanskrit": "ततः सोवभृथे राजा मुदितो जनमेजयः।\nपितरं स्नापयामास स्वयं सस्नौ च पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106356, "chapter_id": 3308, "verse_number": "१६-३७-१०", "content_sanskrit": "`परीक्षिदपि तत्रैव बभूव स तिरोहितः।\nस्नात्वा स नृपतिर्विप्रमास्तीकमिदमब्रवीत्।\nयायावरकुलोत्पन्नं जरत्कारुसुतं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106357, "chapter_id": 3308, "verse_number": "१६-३७-११", "content_sanskrit": "आस्तीक विविधाश्चर्यो यज्ञेऽयमिति मे मतिः।\nयदद्यायं पिता प्राप्तो मम शोकप्रणाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106358, "chapter_id": 3308, "verse_number": "१६-३७-१२x", "content_sanskrit": "आस्तीक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106359, "chapter_id": 3308, "verse_number": "१६-३७-१२", "content_sanskrit": "ऋषिर्द्वैपायनो यत्र पुराणस्तपसो निधिः।\nयज्ञे कुरुकुलश्रेष्ठ तस्य लोकावुभौ जितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106360, "chapter_id": 3308, "verse_number": "१६-३७-१३", "content_sanskrit": "श्रुतं विचित्रमाख्यानं त्वया पाण्डवनन्दन।\nसर्पाश्च भस्मसान्नीता गताश्च पदवीं पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106361, "chapter_id": 3308, "verse_number": "१६-३७-१४", "content_sanskrit": "कथंचित्तक्षको मुक्तः सत्यत्वात्तव पार्थिव।\nऋषयः पूजिताः सर्वे गतिर्दृष्टा महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106362, "chapter_id": 3308, "verse_number": "१६-३७-१५", "content_sanskrit": "प्राप्तः सुविपुलो धर्मः श्रुत्वा पापविनाशनम्।\nविमुक्तो हृदयग्रन्थिरुदारजनदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106363, "chapter_id": 3308, "verse_number": "१६-३७-१६", "content_sanskrit": "ये च पक्षधरा धर्मे सद्वृत्तरुचयश्च ये।\nयान्दृष्ट्वा हीयते पापं तेभ्यः कार्या नमस्क्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106364, "chapter_id": 3308, "verse_number": "१६-३७-१७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106365, "chapter_id": 3308, "verse_number": "१६-३७-१७", "content_sanskrit": "एतच्छ्रुत्वा द्विजश्रेष्ठात्स राजा जनमेजयः।\nपूजयामास तमृषिमनुमान्य पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106366, "chapter_id": 3308, "verse_number": "१६-३७-१८", "content_sanskrit": "पप्रच्छ तमृषि चापि वैशम्पायनमच्युतम्।\nकथावशेषं धर्मज्ञो वनवासस्य सत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106367, "chapter_id": 3308, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि पुत्रदर्शनपर्वणि सप्तत्रिंशोऽध्यायः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]