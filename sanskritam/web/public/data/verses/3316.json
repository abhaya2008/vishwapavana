[{"id": 2106661, "chapter_id": 3316, "verse_number": "१८-१-१", "content_sanskrit": "श्रीवेदव्यासाय नमः।\nनारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106662, "chapter_id": 3316, "verse_number": "१८-१-१x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106663, "chapter_id": 3316, "verse_number": "१८-१-१", "content_sanskrit": "स्वर्गं त्रिविष्टपं प्राप्य मम पूर्वपितामहाः।\nपाण्डवा धार्तराष्ट्राश्च कानि स्थानानि भेजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106664, "chapter_id": 3316, "verse_number": "१८-१-२", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं सर्वविच्चासि मे मतः।\nमहर्षिणाऽभ्यनुज्ञातो व्यासेनाद्भुतकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106665, "chapter_id": 3316, "verse_number": "१८-१-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106666, "chapter_id": 3316, "verse_number": "१८-१-३", "content_sanskrit": "स्वर्गं त्रिविष्टपं प्राप्य तव पूर्वपितामहाः।\nयुधिष्ठिरप्रभृतयो यदकुर्वत तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106667, "chapter_id": 3316, "verse_number": "१८-१-४", "content_sanskrit": "स्वर्गं त्रिविष्टपं प्राप्य धर्मराजो युधिष्ठिरः।\nदुर्योधनं श्रिया जुष्टं ददर्शासीनमासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106668, "chapter_id": 3316, "verse_number": "१८-१-५", "content_sanskrit": "भ्राजमानमिवादित्यं वीरलक्ष्म्याऽभिसंवृतम्।\nदेवैर्भ्राजिष्णुभिः साध्यैः सहितं पुण्यकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106669, "chapter_id": 3316, "verse_number": "१८-१-६", "content_sanskrit": "ततो युधिष्ठिरो राजा दुर्योधनममर्षितः।\nसहसा सन्निवृत्तोऽभूच्छ्रियं दृष्ट्वा सुयोधने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106670, "chapter_id": 3316, "verse_number": "१८-१-७", "content_sanskrit": "ब्रुवन्नुच्चैर्वचस्तान्वै नाहं दुर्योधनेन वै।\nसहितः कामये लोकाँल्लब्धेनादीर्घदर्शिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106671, "chapter_id": 3316, "verse_number": "१८-१-८", "content_sanskrit": "यत्कृते पृथिवी सर्वा सुहृदो बान्धवास्तथा।\nहतास्माभिः प्रसह्याजौ किल्ष्टैः पूर्वं महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106672, "chapter_id": 3316, "verse_number": "१८-१-९", "content_sanskrit": "द्रौपदी च सभामध्ये पाञ्चाली धर्मचारिणी।\nपर्याकृष्टाऽनवद्याङ्गी पत्नी नो गुरुसन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106673, "chapter_id": 3316, "verse_number": "१८-१-१०", "content_sanskrit": "अस्ति देवा न मे कामः सुयोधनमुदीक्षितुम्।\nतत्राहं गन्तुमिच्छामि यत्र ते भ्रातरो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106674, "chapter_id": 3316, "verse_number": "१८-१-११", "content_sanskrit": "नैवमित्यब्रवीत्तं तु नारदः प्रहसन्निव।\nस्वर्गे निवासे राजेन्द्र विरुद्धं चापि नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106675, "chapter_id": 3316, "verse_number": "१८-१-१२", "content_sanskrit": "युधिष्ठिर महाबाहो मैवं वोचः कथञ्चन।\nदुर्योधनं प्रति नृपं शृणु चेदं वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106676, "chapter_id": 3316, "verse_number": "१८-१-१३", "content_sanskrit": "एष दुर्योधनो राजा पूज्यते त्रिदशैः सह।\nसद्भिश्च राजप्रवरैते इमे स्वर्गवासिनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106677, "chapter_id": 3316, "verse_number": "१८-१-१४", "content_sanskrit": "वीरलोकगतिं प्राप्ता युद्धे हुत्वाऽऽत्मनस्तनुम्।\nयूयं सर्वे सुरसमा येन युद्धेन बाधिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106678, "chapter_id": 3316, "verse_number": "१८-१-१५", "content_sanskrit": "स एष क्षत्रधर्मेण स्थानमेतदवाप्तवान्।\nभये महति योऽभीतो बभूव पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106679, "chapter_id": 3316, "verse_number": "१८-१-१६", "content_sanskrit": "न तन्मनसि कर्तव्यं पुत्र यद्द्यूतकारितम्।\nद्रौपद्याश्च परिक्लेशं न चिन्तयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106680, "chapter_id": 3316, "verse_number": "१८-१-१७", "content_sanskrit": "ये चान्येऽपि परिक्लेशा युष्माकं ज्ञातिकारिताः।\nसंग्रामेष्वथवाऽन्यत्र न तान्संस्मर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106681, "chapter_id": 3316, "verse_number": "१८-१-१८", "content_sanskrit": "समागच्छ यथान्यायं राज्ञा दुर्योधनेन वै।\nस्वर्गोऽयं नेह वैराणि भन्ति मनुजाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106682, "chapter_id": 3316, "verse_number": "१८-१-१९", "content_sanskrit": "नारदेनैवमुक्तस्तु कुरुराजो युधिष्ठिरः।\nभ्रातॄन्पप्रच्छ मेधावी वाक्यमेतदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106683, "chapter_id": 3316, "verse_number": "१८-१-२०", "content_sanskrit": "यदि दुर्योधनस्यैते वीरलोकाः सनातनाः।\nअधर्मज्ञस्य पापस्य पृथिवीसुहृदद्रुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106684, "chapter_id": 3316, "verse_number": "१८-१-२१", "content_sanskrit": "यत्कृते पृथिवी नष्टा सहसा सनरद्विपा।\nवयं च मन्युना दग्धा वैरं प्रतिचिकीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106685, "chapter_id": 3316, "verse_number": "१८-१-२२", "content_sanskrit": "ये ते वीरी महात्मानो भ्रातरो मे महाव्रताः।\nसत्यप्रतिज्ञा लोकस्य शूरा वै सत्यवादिनः।\nतेषामिदानीं के लोका द्रष्टुमिच्छामि तानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106686, "chapter_id": 3316, "verse_number": "१८-१-२३", "content_sanskrit": "कर्णं चैव महात्मानं कौन्तेयं सत्यसङ्गरम्।\nधृष्टद्युम्नं सात्यकिं च धृष्टद्युम्नस्य चात्मजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106687, "chapter_id": 3316, "verse_number": "१८-१-२४", "content_sanskrit": "ये च शस्त्रैर्वधं प्राप्ताः क्षत्रधर्मेण पार्थिवाः।\nक्वनु ते पार्थिवान्ब्रह्मन्नैतान्पश्यामि नारद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106688, "chapter_id": 3316, "verse_number": "१८-१-२५", "content_sanskrit": "विराटद्रुपदौ चैव धृष्टकेतुमुखांश्च तान्।\nशिखण्डिनं च पाञ्चाल्यं द्रौपदेयांश्च सर्वशः।\nअभिमन्युं च दुर्धर्षं द्रष्टुमिच्छामि नारद॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106689, "chapter_id": 3316, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्वर्गारोहणपर्वणि प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]