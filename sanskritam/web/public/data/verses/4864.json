[{"id": 2182304, "chapter_id": 4864, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182305, "chapter_id": 4864, "verse_number": "१", "content_sanskrit": "क्वसमुत्थाः कथंशीलाः ऋत्विजः स्युः पितामह ।\nकथंविधाश्च राजेन्द्र तद् ब्रूहि वदतांवर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182306, "chapter_id": 4864, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182307, "chapter_id": 4864, "verse_number": "२", "content_sanskrit": "प्रतिकर्म पुराचार ऋत्विजां स्म विधीयते ।\nआदौ छन्दांसि विज्ञाय द्विजानां श्रुतमेव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182308, "chapter_id": 4864, "verse_number": "३", "content_sanskrit": "ये त्वेकरतयो नित्यं धीरा नाप्रियवादिनः ।\nपरस्परस्य सुहृदः सम्मताः समदर्शिनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182309, "chapter_id": 4864, "verse_number": "४", "content_sanskrit": "येष्वानृशंस्यं सत्यं चाप्यहिंसा तप आर्जवम् ।\nअद्रोहो नाभिमानश्च ह्रीस्तितिक्षा दमः शमः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182310, "chapter_id": 4864, "verse_number": "५", "content_sanskrit": "ह्रीमान् सत्यधृतिर्दान्तो भूतानामविहिंसकः ।\nअकामद्वेषसंयुक्तस्त्रिभिः शुक्लैः समन्वितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182311, "chapter_id": 4864, "verse_number": "६", "content_sanskrit": "अहिंसको ज्ञानतृप्तः स ब्रह्मासनमर्हति ।\nएते महर्त्विजस्तात सर्वे मान्या यथातथम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182312, "chapter_id": 4864, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182313, "chapter_id": 4864, "verse_number": "७", "content_sanskrit": "यदिदं वेदवचनं दक्षिणासु विधीयते ।\nइदं देयमिदं देयं न क्वचिद् व्यवतिष्ठते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182314, "chapter_id": 4864, "verse_number": "८", "content_sanskrit": "नेदं प्रतिधनं शास्त्रमापद्धर्माश्च शास्त्रतः ।\nआज्ञा शास्त्रस्य घोरेयं न शक्तिं समवेक्षते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182315, "chapter_id": 4864, "verse_number": "९", "content_sanskrit": "श्रद्धामारभ्य यष्टव्यमित्येषा वैदिकी श्रुतिः ।\nमिथ्योपेतस्य यज्ञस्य किमु श्रद्धा करिष्यति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182316, "chapter_id": 4864, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182317, "chapter_id": 4864, "verse_number": "१०", "content_sanskrit": "न वेदानां परिभवान्न शाठ्येन न मायया ।\nकश्चिन्महदवाप्नोति मा ते भूद् बुद्धिरीदृशी\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182318, "chapter_id": 4864, "verse_number": "११", "content_sanskrit": "यज्ञाङ्गं दक्षिणास्तात वेदानां परिबृंहणम् ।\nन मन्त्रा दक्षिणाहीनास्तारयन्ति कथञ्चन\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182319, "chapter_id": 4864, "verse_number": "१२", "content_sanskrit": "शक्तिस्तु पूर्णपात्रेण सम्मिता नावमा भवेत् ।\nअवश्यं तात यष्टव्यं त्रिभिर्वर्णैर्यथाविधि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182320, "chapter_id": 4864, "verse_number": "१३", "content_sanskrit": "सोमो राजा ब्राह्मणानामित्येषा वैदिकी श्रुतिः ।\nतं च विक्रेतुमिच्छन्ति न वृथावृत्तिरिष्यते ।\nतेन क्रीतेन धर्मेण ततो यज्ञः प्रवर्तते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182321, "chapter_id": 4864, "verse_number": "१४", "content_sanskrit": "इत्येवं धर्मतः ख्यातमृषिभिर्धर्मवादिभिः ।\nपुमान् यज्ञश्च सोमश्च न्यायवृत्तो यथा भवेत् ।\nअन्यायवृत्तः पुरुषो न परस्य नचात्मनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182322, "chapter_id": 4864, "verse_number": "१५", "content_sanskrit": "शरीरं यज्ञपात्राणि इत्येषा श्रूयते श्रुतिः ।\nतानि सम्यक् प्रणीतानि ब्राह्मणानां महात्मनाम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182323, "chapter_id": 4864, "verse_number": "१६", "content_sanskrit": "तपो यज्ञादपि श्रेष्ठमित्येषा परमा श्रुतिः ।\nतत् ते तपः प्रवक्ष्यामि विद्वंस्तदपि मे शृणु\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182324, "chapter_id": 4864, "verse_number": "१७", "content_sanskrit": "अहिंसा सत्यवचनमानृशंस्यं दमो घृणा ।\nएतत् तपो विदुर्धीरा न शरीरस्य शोषणम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182325, "chapter_id": 4864, "verse_number": "१८", "content_sanskrit": "अप्रामाण्यं च वेदानां शास्त्राणां चातिलङ्घनम् ।\nअव्यवस्था च सर्वत्र तद् वै नाशनमात्मनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182326, "chapter_id": 4864, "verse_number": "१९", "content_sanskrit": "निबोध दशहोतॄणां विधानं पार्थ यादृशम् ।\nवित्तं स्रुक् चित्तमाज्यं च पवित्रं ज्ञानमुत्तमम् ।\nनस्पृष्टत्वं नजिह्मत्वं देशः कालश्च ते तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182327, "chapter_id": 4864, "verse_number": "२०", "content_sanskrit": "सर्वं जिह्मं मृत्युपदमार्जवंं ब्रह्मणः पदम् ।\nएतावान् ज्ञानविषयः किं प्रलापः करिष्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182328, "chapter_id": 4864, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे एकाशीतितमोऽध्यायः ॥ ८१ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]