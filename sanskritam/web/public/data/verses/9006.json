[{"id": 5000006000, "chapter_id": 9006, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000006001, "chapter_id": 9006, "verse_number": "१-६-१", "content_sanskrit": "तस्यां पुर्यामयोध्यायां वेदवित् सर्वसंग्रहः ।\nदीर्घदर्शी महातेजाः पौरजानपदप्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000006002, "chapter_id": 9006, "verse_number": "१-६-२", "content_sanskrit": "इक्ष्वाकूणामतिरथो यज्वा धर्मपरो वशी ।\nमहर्षिकल्पो राजर्षिस्त्रिषु लोकेषु विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000006003, "chapter_id": 9006, "verse_number": "१-६-३", "content_sanskrit": "बलवान् निहतामित्रो मित्रवान् विजितेन्द्रियः ।\nधनैश्च संचयैश्चान्यैः शक्रवैश्रवणोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000006004, "chapter_id": 9006, "verse_number": "१-६-४", "content_sanskrit": "यथा मनुर्महातेजा लोकस्य परिरक्षिता ।\nतथा दशरथो राजा लोकस्य परिरक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000006005, "chapter_id": 9006, "verse_number": "१-६-५", "content_sanskrit": "तेन सत्याभिसंधेन त्रिवर्गमनुतिष्ठता ।\nपालिता सा पुरी श्रेष्ठा इन्द्रेणेवामरावती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000006006, "chapter_id": 9006, "verse_number": "१-६-६", "content_sanskrit": "तस्मिन् पुरवरे हृष्टा धर्मात्मानो बहुश्रुताः ।\nनरास्तुष्टा धनैः स्वैः स्वैरलुब्धाः सत्यवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000006007, "chapter_id": 9006, "verse_number": "१-६-७", "content_sanskrit": "नाल्पसंनिचयः कश्चिदासीत् तस्मिन् पुरोत्तमे ।\nकुटुम्बी यो ह्यसिद्धार्थोऽगवाश्वधनधान्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000006008, "chapter_id": 9006, "verse_number": "१-६-८", "content_sanskrit": "कामी वा न कदर्यो वा नृशंसः पुरुषः क्वचित् ।\nद्रष्टुं शक्यमयोध्यायां नाविद्वान् न च नास्तिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000006009, "chapter_id": 9006, "verse_number": "१-६-९", "content_sanskrit": "सर्वे नराश्च नार्यश्च धर्मशीलाः सुसंयताः ।\nमुदिताः शीलवृत्ताभ्यां महर्षय इवामलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000006010, "chapter_id": 9006, "verse_number": "१-६-१०", "content_sanskrit": "नाकुण्डली नामुकुटी नास्रग्वी नाल्पभोगवान् ।\nनामृष्टो न नलिप्ताङ्गो नासुगन्धश्च विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000006011, "chapter_id": 9006, "verse_number": "१-६-११", "content_sanskrit": "नामृष्टभोजी नादाता नाप्यनङ्गदनिष्कधृक् ।\nनाहस्ताभरणो वापि दृश्यते नाप्यनात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000006012, "chapter_id": 9006, "verse_number": "१-६-१२", "content_sanskrit": "नानाहिताग्निर्नायज्वा न क्षुद्रो वा न तस्करः ।\nकश्चिदासीदयोध्यायां न चार्वृत्तो न संकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000006013, "chapter_id": 9006, "verse_number": "१-६-१३", "content_sanskrit": "स्वकर्मनिरता नित्यं ब्राह्मणा विजितेन्द्रियाः ।\nदानाध्ययनशीलाश्च संयताश्च प्रतिग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000006014, "chapter_id": 9006, "verse_number": "१-६-१४", "content_sanskrit": "नास्तिको नानृती वापि न कश्चिदबहुश्रुतः ।\nनासूयको न चाशक्तो नाविद्वान् विद्यते क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000006015, "chapter_id": 9006, "verse_number": "१-६-१५", "content_sanskrit": "नाषडङ्गविदत्रास्ति नाव्रतो नासहस्रदः ।\nन दीनः क्षिप्तचित्तो वा व्यथितो वापि कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000006016, "chapter_id": 9006, "verse_number": "१-६-१६", "content_sanskrit": "कश्चिन्नरो वा नारी वा नाश्रीमान् नाप्यरूपवान् ।\nद्रष्टुं शक्यमयोध्यायां नापि राजन्यभक्तिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000006017, "chapter_id": 9006, "verse_number": "१-६-१७", "content_sanskrit": "वर्णेष्वग्र्यचतुर्थेषु देवतातिथिपूजकाः ।\nकृतज्ञाश्च वदान्याश्च शूरा विक्रमसंयुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000006018, "chapter_id": 9006, "verse_number": "१-६-१८", "content_sanskrit": "दीर्घायुषो नराः सर्वे धर्मं सत्यं च संश्रिताः ।\nसहिताः पुत्रपौत्रैश्च नित्यं स्त्रीभिः पुरोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000006019, "chapter_id": 9006, "verse_number": "१-६-१९", "content_sanskrit": "क्षत्रं ब्रह्ममुखं चासीद् वैश्याः क्षत्रमनुव्रताः ।\nशूद्राः स्वधर्मनिरतास्त्रीन् वर्णानुपचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000006020, "chapter_id": 9006, "verse_number": "१-६-२०", "content_sanskrit": "सा तेनेक्ष्वाकुनाथेन पुरी सुपरिरक्षिता ।\nयथा पुरस्तान्मनुना मानवेन्द्रेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000006021, "chapter_id": 9006, "verse_number": "१-६-२१", "content_sanskrit": "योधानामग्निकल्पानां पेशलानाममर्षिणाम् ।\nसम्पूर्णा कृतविद्यानां गुहा केसरिणामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000006022, "chapter_id": 9006, "verse_number": "१-६-२२", "content_sanskrit": "काम्बोजविषये जातैर्बाह्लीकैश्च हयोत्तमैः ।\nवनायुजैर्नदीजैश्च पूर्णा हरिहयोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000006023, "chapter_id": 9006, "verse_number": "१-६-२३", "content_sanskrit": "विन्ध्यपर्वतजैर्मत्तैः पूर्णा हैमवतैरपि ।\nमदान्वितैरतिबलैर्मातङ्गैः पर्वतोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000006024, "chapter_id": 9006, "verse_number": "१-६-२४", "content_sanskrit": "ऐरावतकुलीनैश्च महापद्मकुलैस्तथा ।\nअञ्जनादपि निष्क्रान्तैर्वामनादपि च द्विपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000006025, "chapter_id": 9006, "verse_number": "१-६-२५", "content_sanskrit": "भदैर्मन्द्रैर्मृगैश्चैव भद्रमन्द्रमृगैस्तथा ।\nभद्रमन्द्रैर्भद्रमृगैर्मृगमन्द्रैश्च सा पुरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000006026, "chapter_id": 9006, "verse_number": "१-६-२६", "content_sanskrit": "नित्यमत्तैः सदा पूर्णा नागैरचलसंनिभैः ।\nसा योजने द्वे च भूयः सत्यनामा प्रकाशते ।\nयस्यां दशरथो राजा वसञ्जगदपालयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000006027, "chapter_id": 9006, "verse_number": "१-६-२७", "content_sanskrit": "तां पुरीं स महातेजा राजा दशरथो महान् ।\nशशास शमितामित्रो नक्षत्राणीव चन्द्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000006028, "chapter_id": 9006, "verse_number": "१-६-२८", "content_sanskrit": "तां सत्यनामां दृढतोरणार्गलाम्\n::गृहैर्विचित्रैरुपशोभितां शिवाम् ।\nपुरीमयोध्यां नृसहस्रसंकुलां\n::शशास वै शक्रसमो महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000006029, "chapter_id": 9006, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]