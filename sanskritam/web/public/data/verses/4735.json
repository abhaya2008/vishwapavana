[{"id": 2176628, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176629, "chapter_id": 4735, "verse_number": "१", "content_sanskrit": "किमर्थं राजशार्दूलो धर्मपुत्रो युधिष्ठिरः ।\nगान्धार्यै प्रेषयामास वासुदेवं परन्तपम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176630, "chapter_id": 4735, "verse_number": "२", "content_sanskrit": "यदा पूर्वं गतः कृष्णः शमार्थं कौरवान् प्रति ।\nन च तँल्लब्धवान् कामं ततो युद्धमभूदिदम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176631, "chapter_id": 4735, "verse_number": "३", "content_sanskrit": "निहतेषु तु योधेषु हते दुर्योधने तदा ।\nपृथिव्यां पाण्डवेयस्य निःसपत्ने कृते युधि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176632, "chapter_id": 4735, "verse_number": "४", "content_sanskrit": "विश्रुते शिबिरे शून्ये प्राप्ते यशसि चोत्तमे ।\nकिं नु तत्कारणं ब्रह्मन् येन कृष्णो गतः पुरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176633, "chapter_id": 4735, "verse_number": "५", "content_sanskrit": "न च तत्कारणं ब्रह्मन्नल्पं वै प्रतिभाति मे ।\nयत्रागमदमेयात्मा स्वयमेव जनार्दनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176634, "chapter_id": 4735, "verse_number": "६", "content_sanskrit": "त्वमेवैतन्ममाचक्ष्व सर्वमेतद् द्विजोत्तम ।\nयच्चान्यत् कारणं ब्रह्मन् कार्यस्यास्य विनिर्णये\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176635, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176636, "chapter_id": 4735, "verse_number": "७", "content_sanskrit": "त्वद्युक्तोऽयमनुप्रश्नो यन्मां त्वं परिपृच्छसि ।\nतत्तेऽहं सम्प्रवक्ष्यामि यथावद् भरतर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176637, "chapter_id": 4735, "verse_number": "८", "content_sanskrit": "हतं दुर्योधनं दृष्ट्वा भीमसेनेन संयुगे ।\nव्युत्क्रम्य समयं राजन् धार्तराष्ट्रं महाबलम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176638, "chapter_id": 4735, "verse_number": "९", "content_sanskrit": "अन्यायेन हतं दृष्ट्वा गदायुद्धेन भारत ।\nयुधिष्ठिरं महाराज महद् भयमथाविशत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176639, "chapter_id": 4735, "verse_number": "१०", "content_sanskrit": "सोऽचिन्तयन्महाभागां गान्धारीं तपसाऽन्विताम् ।\nघोरेण चक्षुषा शक्तां त्रैलोक्यस्य विनाशने\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176640, "chapter_id": 4735, "verse_number": "११", "content_sanskrit": "तस्य चिन्तयमानस्य बुद्धिः समभवत् तदा ।\nगान्धार्याः क्रोधदीप्तायाः पूर्वं प्रशमनं भवेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176641, "chapter_id": 4735, "verse_number": "१२", "content_sanskrit": "सा हि पुत्रवधं श्रुत्वा कृतमस्माभिरीदृशम् ।\nमानसेनाग्निना क्रुद्धा भस्मसान्नः करिष्यति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176642, "chapter_id": 4735, "verse_number": "१३", "content_sanskrit": "कथं दुःखमिदं तीव्रं गान्धारी सा सहिष्यति ।\nश्रुत्वा विनिहतं पुत्रं छलेनाजिह्मयोधिनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176643, "chapter_id": 4735, "verse_number": "१४", "content_sanskrit": "वधं विचिन्त्य बहुधा भयशोकसमन्वितः ।\nवासुदेवमिदं वाक्यं धर्मराजोऽभ्यभाषत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176644, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176645, "chapter_id": 4735, "verse_number": "१५", "content_sanskrit": "तव प्रसादाद् गोविन्द राज्यं निहतकण्टकम् ।\nअप्राप्यं मनसाऽपीह प्राप्तमस्माभिरच्युत\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176646, "chapter_id": 4735, "verse_number": "१६", "content_sanskrit": "प्रत्यक्षं ते महाबाहो सङ्ग्रामे रोमहर्षणे ।\nविमर्दः सुमहान् प्राप्तः त्वया यादवनन्दन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176647, "chapter_id": 4735, "verse_number": "१७", "content_sanskrit": "त्वया देवासुरे युद्धे वधार्थममरद्विषाम् ।\nयथा साह्यं पुरा दत्तं हताश्च सुरशत्रवः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176648, "chapter_id": 4735, "verse_number": "१८", "content_sanskrit": "साह्यं तथा महाबाहो दत्तमस्माकमच्युत ।\nसारथ्येन च वार्ष्णेय भवता यद्धृता वयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176649, "chapter_id": 4735, "verse_number": "१९", "content_sanskrit": "यदि न त्वं भवेन्नाथः फल्गुनस्य महारणे ।\nकथं शक्यं रणे जेतुं भवेदेतद् बलार्णवम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176650, "chapter_id": 4735, "verse_number": "२०", "content_sanskrit": "गदाप्रहारा विपुलाः परिघैश्चापि ताडनम् ।\nशक्तिभिर्भिण्डिपालैश्च तोमरैः सपरश्वथैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176651, "chapter_id": 4735, "verse_number": "२१", "content_sanskrit": "वाचश्च परुषाः प्राप्ताः त्वया ह्यस्मज्जयैषिणा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176652, "chapter_id": 4735, "verse_number": "२२", "content_sanskrit": "ताश्च ते सफलाः सर्वा हते दुर्योधनेऽच्युत ।\nगान्धार्या हि महाबाहो क्रोधं शमय माधव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176653, "chapter_id": 4735, "verse_number": "२३", "content_sanskrit": "सा हि नित्यं महाभाग तपसोग्रेण कर्शिता ।\nपुत्रपौत्रवधं प्राप्ता ध्रुवं नः प्रदहिष्यति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176654, "chapter_id": 4735, "verse_number": "२४", "content_sanskrit": "तस्याः प्रसादनं वीर प्राप्तकालमिदं मम\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176655, "chapter_id": 4735, "verse_number": "२५", "content_sanskrit": "कश्च तां क्रोधसन्दीप्तां पुत्रव्यसनकर्शिताम् ।\nवीक्षितुं पुरुषः शक्तस्त्वामृते पुरुषोत्तम\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176656, "chapter_id": 4735, "verse_number": "२६", "content_sanskrit": "ततस्ते गमनं प्राप्तं तन्मे माधव रोचते ।\nगान्धार्याः क्रोधदीप्तायाः प्रशमार्थमरिन्दम\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176657, "chapter_id": 4735, "verse_number": "२७", "content_sanskrit": "त्वं हि कर्ता विकर्ता च लोकानां प्रभवाप्ययः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176658, "chapter_id": 4735, "verse_number": "२८", "content_sanskrit": "हेतुकारणसंयुक्तैर्वचनैः कालचोदितैः ।\nक्षिप्रमेव महाभागां गान्धारीं शमयिष्यसि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176659, "chapter_id": 4735, "verse_number": "२९", "content_sanskrit": "पितामहश्च भगवान् तत्र कृष्णो भविष्यति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176660, "chapter_id": 4735, "verse_number": "३०", "content_sanskrit": "सर्वथा ते महाबाहो गान्धार्या रोषनाशनम् ।\nकर्तव्यं सात्वतश्रेष्ठ पाण्डवानां हितैषिणा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176661, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176662, "chapter_id": 4735, "verse_number": "३१", "content_sanskrit": "धर्मराजस्य वचनं श्रुत्वा यदुकुलोद्वहः ।\nआमन्त्र्य दारुकं प्राह रथः सज्जो विधीयताम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176663, "chapter_id": 4735, "verse_number": "३२", "content_sanskrit": "केशवस्य वचः श्रुत्वा त्वरमाणोऽथ दारुकः ।\nन्यवेदयद् रथं सज्जं केशवाय महात्मने\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176664, "chapter_id": 4735, "verse_number": "३३", "content_sanskrit": "तं रथं यादवश्रेष्ठः समारुह्य यदूत्तमः ।\nजगाम हस्तिनपुरं त्वरितः केशवो विभुः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176665, "chapter_id": 4735, "verse_number": "३४", "content_sanskrit": "ततः प्रायान्महाभागः केशवो वेगवद् द्रुतम् ।\nनागसाह्वयमासाद्य प्रविवेश च वीर्यवान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176666, "chapter_id": 4735, "verse_number": "३५", "content_sanskrit": "प्रविश्य नगरं वीरो रथघोषेण नादयन् ।\nविदितो धृतराष्ट्रस्य सोऽवतीर्य रथोत्तमात्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176667, "chapter_id": 4735, "verse_number": "३६", "content_sanskrit": "अभ्यगच्छदमेयात्मा धृतराष्ट्रनिवेशनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176668, "chapter_id": 4735, "verse_number": "३७", "content_sanskrit": "पूर्वं चाभिगतं तत्र सोऽपश्यदृषिसत्तमम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176669, "chapter_id": 4735, "verse_number": "३८", "content_sanskrit": "पादौ प्रपीड्य कृष्णस्य राज्ञश्चापि जनार्दनः ।\nअभ्यवादयदव्यग्रो गान्धारीं चापि केशवः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176670, "chapter_id": 4735, "verse_number": "३९", "content_sanskrit": "ततस्तु यादवश्रेष्ठो धृतराष्ट्रमधोक्षजः ।\nपाणिमालम्ब्य राज्ञः स सस्वनं प्ररुरोद ह\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176671, "chapter_id": 4735, "verse_number": "४०", "content_sanskrit": "स मुहूर्तमिवोत्सृज्य बाष्पं शोकसमुद्भवम् ।\nप्रक्षाल्य वारिणा नेत्रे आचम्य च यथाविधि\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176672, "chapter_id": 4735, "verse_number": "४१", "content_sanskrit": "उवाच प्रश्रितं वाक्यं धृतराष्ट्रमरिन्दम\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176673, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176674, "chapter_id": 4735, "verse_number": "४२", "content_sanskrit": "न तेऽस्त्यविदितं किञ्चिद् भूतं भव्यं च भारत ।\nकालस्य च यथावृत्तं तत्ते सुविदितं प्रभो\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176675, "chapter_id": 4735, "verse_number": "४३", "content_sanskrit": "यति(दि)दं पाण्डवैः सर्वैः तव चित्तानुवर्तिभिः ।\nकथं कुलक्षयो न स्यात् तथा क्षत्रस्य भारत\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176676, "chapter_id": 4735, "verse_number": "४४", "content_sanskrit": "भ्रातृभिः समयं कृत्वा क्षान्तवान् धर्मवत्सलः ।\nद्यूतेऽधर्मजितैः शक्तैर्वनवासोऽभ्युपागतः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176677, "chapter_id": 4735, "verse_number": "४५", "content_sanskrit": "अज्ञातवेषचर्या च नानावेशसमाश्रितैः ।\nअन्ये च बहवः क्लेशा अशक्तैरिव नित्यदा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176678, "chapter_id": 4735, "verse_number": "४६", "content_sanskrit": "मया च स्वयमागम्य युद्धकाल उपस्थिते ।\nसर्वलोकस्य सान्निध्ये ग्रामांस्त्वं पञ्च याचितः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176679, "chapter_id": 4735, "verse_number": "४७", "content_sanskrit": "त्वया कालोपसृष्टेन लोभतो नापवर्जिताः ।\nतवापराधान्नृपते क्षत्रं सर्वं क्षयं गतम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176680, "chapter_id": 4735, "verse_number": "४८", "content_sanskrit": "भीष्मेण सोमदत्तेन बाह्लीकेन कृपेण च ।\nद्रोणेन सहपुत्रेण विदुरेण च धीमता\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176681, "chapter_id": 4735, "verse_number": "४९", "content_sanskrit": "याचितस्त्वं शमं नित्यं न च तत्कृतवानसि\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2176682, "chapter_id": 4735, "verse_number": "५०", "content_sanskrit": "कालोपहतचित्तो हि सर्वो मुह्यति भारत ।\nतथा मूढो भवान् पूर्वमस्मिन्नर्थे समुद्यते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2176683, "chapter_id": 4735, "verse_number": "५१", "content_sanskrit": "किमन्यत् कालयोगाद्धि द्विष्टमेतत् पुरातनम् ।\nमा च द्वेषं महाराज पाण्डवेषु निवेशय\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2176684, "chapter_id": 4735, "verse_number": "५२", "content_sanskrit": "स्वल्पोऽप्यतिक्रमो नास्ति पाण्डवानां महात्मनाम् ।\nधर्मतो न्यायतश्चैव स्नेहतश्च परन्तप\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2176685, "chapter_id": 4735, "verse_number": "५३", "content_sanskrit": "एतत् सर्वं तु विज्ञाय ह्यात्मदोषकृतं फलम् ।\nतन्मन्युं पाण्डुपुत्रेषु न भवान् कर्तुमर्हति\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2176686, "chapter_id": 4735, "verse_number": "५४", "content_sanskrit": "कुलं वंशश्च पिण्डश्च यच्च पुत्रकृतं फलम् ।\nगान्धार्यास्तव चैवाद्य पाण्डवेषु प्रतिष्ठितम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2176687, "chapter_id": 4735, "verse_number": "५५", "content_sanskrit": "एतत् सर्वमनुध्याय आत्मनश्च व्यतिक्रमम् ।\nशिवेन पाण्डवान् ध्याहि नमस्ते पुरुषर्षभ\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2176688, "chapter_id": 4735, "verse_number": "५६", "content_sanskrit": "जानासि त्वं महाबाहो धर्मराजस्य या त्वयि ।\nभक्तिर्भरतशार्दूल स्नेहश्चापि स्वभावतः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2176689, "chapter_id": 4735, "verse_number": "५७", "content_sanskrit": "एतच्च कदनं कृत्वा शत्रूणामपकारिणाम् ।\nदह्यते स्म दिवारात्रं न च शर्माधिगच्छति\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2176690, "chapter_id": 4735, "verse_number": "५८", "content_sanskrit": "त्वां चैव नरशार्दूल गान्धारीं च यशस्विनीम् ।\nस शोचन् भरतश्रेष्ठ न शान्तिमधिगच्छति\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2176691, "chapter_id": 4735, "verse_number": "५९", "content_sanskrit": "ह्रिया परमया युक्तो भवन्तं नोपसर्पति ।\nपुत्रशोकाभिसन्तप्तं बुद्ध्या व्याकुलितेन्द्रियम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2176692, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2176693, "chapter_id": 4735, "verse_number": "६०", "content_sanskrit": "एवमुक्त्वा महाबाहुर्धृतराष्ट्रं यदूत्तमः ।\nउवाच परमं वाक्यं गान्धारीं शोककर्शिताम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2176694, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2176695, "chapter_id": 4735, "verse_number": "६१", "content_sanskrit": "सौबलेयि निबोधस्व यत् त्वां वक्ष्यामि सुव्रते ।\nत्वत्समा नास्ति लोकेऽस्मिन् काचित् सीमन्तिनी शुभे\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2176696, "chapter_id": 4735, "verse_number": "६२", "content_sanskrit": "जानासि च यथा राज्ञि सभायां मम सन्निधौ ।\nधमार्थसहितं वाक्यमुभयोः पक्षयोर्हितम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2176697, "chapter_id": 4735, "verse_number": "६३", "content_sanskrit": "उक्तवत्यसि कल्याणि न च ते तनयैः श्रुतम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2176698, "chapter_id": 4735, "verse_number": "६४", "content_sanskrit": "दुर्योधनस्त्वया चोक्तो जयार्थी परुषं वचः ।\nशृणु मूढ वचो मे त्वं यतो धर्मस्ततो जयः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2176699, "chapter_id": 4735, "verse_number": "६५", "content_sanskrit": "तदिदं समनुप्राप्तं तव वाक्यं नृपात्मजे\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2176700, "chapter_id": 4735, "verse_number": "६६", "content_sanskrit": "एवं विदित्वा गान्धारि मा स्म शोके मनः कृथाः ।\nपाण्डवानां विनाशे च मा ते बुद्धिः कदाचन\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2176701, "chapter_id": 4735, "verse_number": "६७", "content_sanskrit": "शक्ता चासि महाभागे पृथिवीं सचराचराम् ।\nचक्षुषा क्रोधदीप्तेन निर्दग्धुं तपसो बलात्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2176702, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2176703, "chapter_id": 4735, "verse_number": "६८", "content_sanskrit": "वासुदेववचः श्रुत्वा गान्धारी वाक्यमब्रवीत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2176704, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2176705, "chapter_id": 4735, "verse_number": "६९", "content_sanskrit": "एवमेतन्महाभाग यथा वदसि केशव ।\nआधिभिर्दह्यमानाया मतिः सञ्चलिता मम\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2176706, "chapter_id": 4735, "verse_number": "७०", "content_sanskrit": "सा मे व्यवस्थिता श्रुत्वा तव वाक्यं जनार्दन\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2176707, "chapter_id": 4735, "verse_number": "७१", "content_sanskrit": "राज्ञस्त्वन्धस्य वृद्धस्य हतपुत्रस्य माधव ।\nत्वं गतिः सह तैः सर्वैः पाण्डवैर्वदतां वर\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2176708, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2176709, "chapter_id": 4735, "verse_number": "७२", "content_sanskrit": "एवमुक्त्वा तु वचनं मुखं प्रच्छाद्य वाससा ।\nपुत्रशोकाभिसन्तप्ता गान्धारी प्ररुरोद ह\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2176710, "chapter_id": 4735, "verse_number": "७३", "content_sanskrit": "तत एनां महाबाहुः केशवः शोककर्शिताम् ।\nहेतुकारणसंयुक्तैर्वाक्यैराश्वासयत् प्रभुः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2176711, "chapter_id": 4735, "verse_number": "७४", "content_sanskrit": "समाश्वास्य स गान्धारीं धृतराष्ट्रं च माधवः ।\nद्रौणेः सङ्कल्पितं भावमन्वबुद्ध्यत भारत\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2176712, "chapter_id": 4735, "verse_number": "७५", "content_sanskrit": "ततस्त्वरित उत्थाय पादौ मूर्ध्ना प्रणम्य च ।\nद्वैपायनस्य राजेन्द्र ततः कौरवमब्रवीत्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2176713, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2176714, "chapter_id": 4735, "verse_number": "७६", "content_sanskrit": "आपृच्छे त्वां कुरुश्रेष्ठ मा च शोके मनः कृथाः ।\nद्रौणेः पापोऽस्त्यभिप्रायस्ततोऽस्मि सहसोत्थितः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2176715, "chapter_id": 4735, "verse_number": "७७", "content_sanskrit": "पाण्डवानां वधे रात्रौ बुद्धिस्तेन निदर्शिता\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2176716, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2176717, "chapter_id": 4735, "verse_number": "७८", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं गान्धार्या सहितोऽब्रवीत् ।\nधृतराष्ट्रो महाराज केशवं केशिसूदनम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2176718, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "धृतराष्ट्र", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2176719, "chapter_id": 4735, "verse_number": "७९", "content_sanskrit": "शीघ्रं गच्छ महाबाहो पाण्डवान् परिपालय ।\nभूयस्त्वया समेष्यामि क्षिप्रमेव जनार्दन\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2176720, "chapter_id": 4735, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2176721, "chapter_id": 4735, "verse_number": "८०", "content_sanskrit": "प्रायात् ततस्तु त्वरितो दारुकेण सहाच्युतः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2176722, "chapter_id": 4735, "verse_number": "८१", "content_sanskrit": "वासुदेवे गते राजन् धृतराष्ट्रं जनेश्वरम् ।\nआश्वासयदमेयात्मा व्यासो लोकनमस्कृतः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2176723, "chapter_id": 4735, "verse_number": "८२", "content_sanskrit": "वासुदेवोऽपि धर्मात्मा कृतकृत्यो जगाम ह ।\nशिबिरं हस्तिनपुराद् दिदृक्षुः पाण्डवान् नृप\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2176724, "chapter_id": 4735, "verse_number": "८३", "content_sanskrit": "आगम्य शिबिरं रात्रौ सोऽभ्यगच्छत पाण्डवान् ।\nतच्च तेभ्यः समाख्याय सहितैस्तैः समाविशत्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2176725, "chapter_id": 4735, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि वासुदेवप्रत्यागमनं नाम त्रयस्त्रिंशोऽध्यायः ॥३३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}]