[{"id": 2082789, "chapter_id": 2765, "verse_number": "१२-२७०-०x", "content_sanskrit": "तुलाधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082790, "chapter_id": 2765, "verse_number": "१२-२७०-१", "content_sanskrit": "सद्भिर्वा यदि वाऽसद्भिः पन्थानमिममाश्रितः।\nप्रत्यक्षं क्रियतां साधु ततो ज्ञास्यसि तद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082791, "chapter_id": 2765, "verse_number": "१२-२७०-२", "content_sanskrit": "एते शकुन्ता बहवः समन्ताद्विचरन्ति ह।\nतवोत्तमाङ्गे संभूताः श्येनाश्चान्याश्च जातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082792, "chapter_id": 2765, "verse_number": "१२-२७०-३", "content_sanskrit": "आहूयैनान्महाब्रह्मन्विशमानांस्ततस्ततः।\nपश्येमान्हस्तपादैश्च श्लिष्टान्देहेषु सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082793, "chapter_id": 2765, "verse_number": "१२-२७०-४", "content_sanskrit": "संभावयन्ति पितरं त्वया संभाविताः स्वगाः।\nअसंशयं पिता वै त्वं पुत्रानाह्वय जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082794, "chapter_id": 2765, "verse_number": "१२-२७०-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082795, "chapter_id": 2765, "verse_number": "१२-२७०-५", "content_sanskrit": "ततो जाजलिना तेन समाहूताः पतत्रिणः।\nवाचमुच्चारयन्ति स्म धर्मस्य वचनात्किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082796, "chapter_id": 2765, "verse_number": "१२-२७०-६x", "content_sanskrit": "तुलाधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082797, "chapter_id": 2765, "verse_number": "१२-२७०-६", "content_sanskrit": "अहिंसादि कृतं कर्म इह चैव परत्र च।\nश्रद्धां निहन्ति वै ब्रह्मन्सा हता हन्ति तं नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082798, "chapter_id": 2765, "verse_number": "१२-२७०-७", "content_sanskrit": "समानां श्रद्दधानानां संयतानां सुचेतसाम्।\nकुर्वतां यज्ञ इत्येव न यज्ञो जातु नेष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082799, "chapter_id": 2765, "verse_number": "१२-२७०-८", "content_sanskrit": "श्रद्धा वै सात्विकी देवी सूर्यस्य दुहिता द्विज।\nसावित्री प्रसवित्री च हविर्वाङ्भनसी ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082800, "chapter_id": 2765, "verse_number": "१२-२७०-९", "content_sanskrit": "वाग्वृद्धं त्रायते श्रद्धा मनोवृद्धं च जाजले।\nश्रद्धावृद्धं वाङ्भनसी न यज्ञस्त्रातुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082801, "chapter_id": 2765, "verse_number": "१२-२७०-१०", "content_sanskrit": "अत्र गाथा ब्रह्मगीताः कीर्तयन्ति पुराविदः।\nशुचेरश्रद्दधानस्य श्रद्दधानस्यर चाशुचेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082802, "chapter_id": 2765, "verse_number": "१२-२७०-११", "content_sanskrit": "देवा वित्तममन्यन्त सदृशं यज्ञकर्मणि।\nश्रोत्रियस्य कदर्यस्य वदान्यस्य च वार्धुषेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082803, "chapter_id": 2765, "verse_number": "१२-२७०-१२", "content_sanskrit": "मीमांसित्वोभयं देवाः सममन्नमकल्पयन्।\nप्रजापतिस्तानुवाच विषमं कृतमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082804, "chapter_id": 2765, "verse_number": "१२-२७०-१३", "content_sanskrit": "श्रद्धापूतं वदान्यस्य हतमश्रद्धयेतरत्।\nभोज्यमन्नं वदान्यस्य कदर्यस्य न वार्धुषेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082805, "chapter_id": 2765, "verse_number": "१२-२७०-१४", "content_sanskrit": "अश्रद्दधान एवैको देवानां नार्हते हविः।\nतस्यैवान्नं न भोक्तव्यमिति धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082806, "chapter_id": 2765, "verse_number": "१२-२७०-१५", "content_sanskrit": "अश्रद्धा परमं पापं श्रद्धा पापप्रमोचनी।\nजहाति पापं श्रद्धावान्सर्पो जीर्णामिव त्वचम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082807, "chapter_id": 2765, "verse_number": "१२-२७०-१६", "content_sanskrit": "ज्यायसी या पवित्राणां निवृत्तिः श्रद्धया सह।\nनिवृत्तशीलदोषो यः श्रद्धावान्पूत एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082808, "chapter_id": 2765, "verse_number": "१२-२७०-१७", "content_sanskrit": "किं तस्य तपसा कार्यं किं वृत्तेन किमात्मना।\nश्रद्धामयोऽयं पुरुषो यो यच्छ्रद्धः स एव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082809, "chapter_id": 2765, "verse_number": "१२-२७०-१८", "content_sanskrit": "इति धर्मः समाख्यातः सद्भिर्धर्मार्थदर्शिभिः।\nवयं जिज्ञासमानास्तु संप्राप्ता धर्मदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082810, "chapter_id": 2765, "verse_number": "१२-२७०-१९", "content_sanskrit": "श्रद्धां कुरु महाप्राज्ञ ततः प्राप्स्यसि यत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082811, "chapter_id": 2765, "verse_number": "१२-२७०-२०x", "content_sanskrit": "`जाजलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082812, "chapter_id": 2765, "verse_number": "१२-२७०-२०", "content_sanskrit": "न वै मुनीनां शृणुमश्च तत्वं\nपृच्छामि ते वाणिज तत्वमेतत्।\nपूर्वे हि पूर्वेऽप्यनवेक्षमाणा\nनातः परं ते ऋषयः स्थापयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082813, "chapter_id": 2765, "verse_number": "१२-२७०-२१", "content_sanskrit": "यस्मिन्नेवानुतीर्थेन पशवः प्राप्नुयुः सुखम्।\nपत्नीव्रतेन विधिना प्रकरोति नियोजयन्।\nश्रद्धावाञ्श्रद्दधानश्च धर्मश्चैव हि वाणिज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082814, "chapter_id": 2765, "verse_number": "१२-२७०-२२x", "content_sanskrit": "तुलाधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082815, "chapter_id": 2765, "verse_number": "१२-२७०-२२", "content_sanskrit": "स्ववर्त्मनि स्थितश्चैव गरीयानेव जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082816, "chapter_id": 2765, "verse_number": "१२-२७०-२३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082817, "chapter_id": 2765, "verse_number": "१२-२७०-२३", "content_sanskrit": "ततोऽचिरेण कालेन तुलाधारः स एव च।\nदिवं गत्वा महाप्राज्ञौ विहरेतां यथासुखम्।\nस्वंस्वं स्थानमुपागम्य स्वकर्मफलनिर्मितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082818, "chapter_id": 2765, "verse_number": "१२-२७०-२४", "content_sanskrit": "एवं बहुविधार्थं च तुलाधारेण भापितम्।\nसम्यक्चैवमुपालब्धो धर्मश्चोक्तः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082819, "chapter_id": 2765, "verse_number": "१२-२७०-२५", "content_sanskrit": "तस्य विख्यातवीर्यस्य श्रुत्वा वाक्यानि जाजलिः।\nतुलाधारस्य कौन्तेय शान्तिमेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082820, "chapter_id": 2765, "verse_number": "१२-२७०-२६", "content_sanskrit": "`समानां श्रद्दधानानां युक्तानां च यथाबलम्।\nकुर्वतां यज्ञ इत्येव नायज्ञो जातु नेष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082821, "chapter_id": 2765, "verse_number": "१२-२७०-२७", "content_sanskrit": "एवं बहुमतार्थं च तुलाधारेण भाषितम्।\nयथौपम्योपदेशेन किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082822, "chapter_id": 2765, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तत्यधिकद्विशततमोऽध्यायः॥ २७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]