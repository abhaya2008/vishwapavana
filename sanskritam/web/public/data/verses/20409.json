[{"id": 7000409000, "chapter_id": 20409, "verse_number": "२-८१-१", "content_sanskrit": "सुकर्मोवाच ।\nयथेंद्रोसौ महाप्राज्ञः सदा भीतो महात्मनः ।\nययातेर्विक्रमं दृष्ट्वा दानपुण्यादिकं बहु॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000409001, "chapter_id": 20409, "verse_number": "२-८१-२", "content_sanskrit": "मेनकां प्रेषयामास अप्सरां दूतकर्मणि ।\nगच्छ भद्रे महाभागे ममादेशं वदस्व हि॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000409002, "chapter_id": 20409, "verse_number": "२-८१-३", "content_sanskrit": "कामकन्यामितो गत्वा देवराजवचो वद ।\nयेनकेनाप्युपायेन राजानं त्वमिहानय॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000409003, "chapter_id": 20409, "verse_number": "२-८१-४", "content_sanskrit": "एवं श्रुत्वा गता सा च मेनका तत्र प्रेषिता ।\nसमाचष्ट तु तत्सर्वं देवराजस्य भाषितम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000409004, "chapter_id": 20409, "verse_number": "२-८१-५", "content_sanskrit": "एवमुक्ता गता सा च मेनका तत्प्रचोदिता ।\nगतायां मेनकायां तु रतिपुत्री मनस्विनी॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000409005, "chapter_id": 20409, "verse_number": "२-८१-६", "content_sanskrit": "राजानं धर्मसंकेतं प्रत्युवाच यशस्विनी ।\nराजंस्त्वयाहमानीता सत्यवाक्येन वै पुरा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000409006, "chapter_id": 20409, "verse_number": "२-८१-७", "content_sanskrit": "स्वकरश्चांतरे दत्तो भवनं च समाहृता ।\nयद्यद्वदाम्यहं राजंस्तत्तत्कार्यं हि वै त्वया॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000409007, "chapter_id": 20409, "verse_number": "२-८१-८", "content_sanskrit": "तदेवं हि त्वया वीर न कृतं भाषितं मम ।\nत्वामेवं तु परित्यक्ष्ये यास्यामि पितृमंदिरम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000409008, "chapter_id": 20409, "verse_number": "२-८१-९", "content_sanskrit": "राजोवाच ।\nयथोक्तं हि त्वया भद्रे तत्ते कर्त्ता न संशयः ।\nअसाध्यं तु परित्यज्य साध्यं देवि वदस्व मे॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000409009, "chapter_id": 20409, "verse_number": "२-८१-१०", "content_sanskrit": "अश्रुबिंदुमत्युवाच ।\nएतदर्थे महीकांत भवानिह मया वृतः ।\nसर्वलक्षणसंपन्नः सर्वधर्मसमन्वितः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000409010, "chapter_id": 20409, "verse_number": "२-८१-११", "content_sanskrit": "सर्वं साध्यमिति ज्ञात्वा सर्वधर्तारमेव च ।\nकर्त्तारं सर्वधर्माणां स्रष्टारं पुण्यकर्मणाम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000409011, "chapter_id": 20409, "verse_number": "२-८१-१२", "content_sanskrit": "त्रैलोक्यसाधकं ज्ञात्वा त्रैलोक्येऽप्रतिमं च वै ।\nविष्णुभक्तमहं जाने वैष्णवानां महावरम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000409012, "chapter_id": 20409, "verse_number": "२-८१-१३", "content_sanskrit": "इत्याशया मया भर्त्ता भवानंगीकृतः पुरा ।\nयस्य विष्णुप्रसादोऽस्ति स सर्वत्र परिव्रजेत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000409013, "chapter_id": 20409, "verse_number": "२-८१-१४", "content_sanskrit": "दुर्लभं नास्ति राजेंद्र त्रैलोक्ये सचराचरे ।\nसर्वेष्वेव सुलोकेषु विद्यते तव सुव्रत॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000409014, "chapter_id": 20409, "verse_number": "२-८१-१५", "content_sanskrit": "विष्णोश्चैव प्रसादेन गगने गतिरुत्तमा ।\nमर्त्यलोकं समासाद्य त्वयैव वसुधाधिप॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000409015, "chapter_id": 20409, "verse_number": "२-८१-१६", "content_sanskrit": "जरापलितहीनास्तु मृत्युहीना जनाः कृताः ।\nगृहद्वारेषु सर्वेषु मर्त्यानां च नरर्षभ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000409016, "chapter_id": 20409, "verse_number": "२-८१-१७", "content_sanskrit": "कल्पद्रुमा अनेकाश्च त्वयैव परिकल्पिताः ।\nयेषां गृहेषु मर्त्यानां मुनयः कामधेनवः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000409017, "chapter_id": 20409, "verse_number": "२-८१-१८", "content_sanskrit": "त्वयैव प्रेषिता राजन्स्थिरीभूताः सदा कृताः ।\nसुखिनः सर्वकामैश्च मानवाश्च त्वया कृताः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000409018, "chapter_id": 20409, "verse_number": "२-८१-१९", "content_sanskrit": "गृहैकमध्ये साहस्रं कुलीनानां प्रदृश्यते ।\nएवं वंशविवृद्धिश्च मानवानां त्वया कृता॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000409019, "chapter_id": 20409, "verse_number": "२-८१-२०", "content_sanskrit": "यमस्यापि विरोधेन इंद्रस्य च नरोत्तम ।\nव्याधिपापविहीनस्तु मर्त्यलोकस्त्वया कृतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000409020, "chapter_id": 20409, "verse_number": "२-८१-२१", "content_sanskrit": "स्वतेजसाहंकारेण स्वर्गरूपं तु भूतलम् ।\nदर्शितं हि महाराज त्वत्समो नास्ति भूपतिः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000409021, "chapter_id": 20409, "verse_number": "२-८१-२२", "content_sanskrit": "नरो नैव प्रसूतो हि नोत्पत्स्यति भवादृशः ।\nभवंतमित्यहं जाने सर्वधर्मप्रभाकरम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000409022, "chapter_id": 20409, "verse_number": "२-८१-२३", "content_sanskrit": "तस्मान्मया कृतो भर्ता वदस्वैवं ममाग्रतः ।\nनर्ममुक्त्वा नृपेंद्र त्वं वद सत्यं ममाग्रतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000409023, "chapter_id": 20409, "verse_number": "२-८१-२४", "content_sanskrit": "यदि ते सत्यमस्तीह धर्ममस्ति नराधिप ।\nदेवलोकेषु मे नास्ति गगने गतिरुत्तमा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000409024, "chapter_id": 20409, "verse_number": "२-८१-२५", "content_sanskrit": "सत्यं त्यक्त्वा यदा च त्वं नैव स्वर्गं गमिष्यसि ।\nतदा कूटं तव वचो भविष्यति न संशयः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000409025, "chapter_id": 20409, "verse_number": "२-८१-२६", "content_sanskrit": "पूर्वंकृतं हि यच्छ्रेयो भस्मीभूतं भविष्यति ।\nराजोवाच ।\nसत्यमुक्तं त्वया भद्रे साध्यासाध्यं न चास्ति मे॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000409026, "chapter_id": 20409, "verse_number": "२-८१-२७", "content_sanskrit": "सर्वंसाध्यं सुलोकं मे सुप्रसादाज्जगत्पते ।\nस्वर्गं देवि यतो नैमि तत्र मे कारणं शृणु॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000409027, "chapter_id": 20409, "verse_number": "२-८१-२८", "content_sanskrit": "आगंतुं तु न दास्यंति लोके मर्त्ये च देवताः ।\nततो मे मानवाः सर्वे प्रजाः सर्वा वरानने॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000409028, "chapter_id": 20409, "verse_number": "२-८१-२९", "content_sanskrit": "मृत्युयुक्ता भविष्यंति मया हीना न संशयः ।\nगंतुं स्वर्गं न वाञ्छामि सत्यमुक्तं वरानने॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000409029, "chapter_id": 20409, "verse_number": "२-८१-३०", "content_sanskrit": "देव्युवाच ।\nलोकान्दृष्ट्वा महाराज आगमिष्यसि वै पुनः ।\nपूरयस्व ममाद्यत्वं जातां श्रद्धां महातुलाम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000409030, "chapter_id": 20409, "verse_number": "२-८१-३१", "content_sanskrit": "राजोवाच ।\nसर्वमेवं करिष्यामि यत्त्वयोक्तं न संशयः ।\nसमालोक्य महातेजा ययातिर्नहुषात्मजः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000409031, "chapter_id": 20409, "verse_number": "२-८१-३२", "content_sanskrit": "एवमुक्त्वा प्रियां राजा चिंतयामास वै तदा ।\nअंतर्जलचरो मत्स्यः सोपि जाले न बध्यते॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000409032, "chapter_id": 20409, "verse_number": "२-८१-३३", "content_sanskrit": "मरुत्समानवेगोपि मृगः प्राप्नोति बंधनम् ।\nयोजनानां सहस्रस्थमामिषं वीक्षते खगः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000409033, "chapter_id": 20409, "verse_number": "२-८१-३४", "content_sanskrit": "सकंठलग्नपाशं च न पश्येद्दैवमोहितः ।\nकालः समविषमकृत्कालः सन्मानहानिदः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000409034, "chapter_id": 20409, "verse_number": "२-८१-३५", "content_sanskrit": "परिभावकरः कालो यत्रकुत्रापि तिष्ठतः ।\nनरं करोति दातारं याचितारं च वै पुनः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000409035, "chapter_id": 20409, "verse_number": "२-८१-३६", "content_sanskrit": "भूतानि स्थावरादीनि दिवि वा यदि वा भुवि ।\nसर्वं कलयते कालः कालो ह्येक इदं जगत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000409036, "chapter_id": 20409, "verse_number": "२-८१-३७", "content_sanskrit": "अनादिनिधनो धाता जगतः कारणं परम् ।\nलोकान्कालः स पचति वृक्षे फलमिवाहितम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000409037, "chapter_id": 20409, "verse_number": "२-८१-३८", "content_sanskrit": "न मंत्रा न तपो दानं न मित्राणि न बांधवाः ।\nशक्नुवंति परित्रातुं नरं कालेन पीडितम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000409038, "chapter_id": 20409, "verse_number": "२-८१-३९", "content_sanskrit": "त्रयः कालकृताः पाशाः शक्यंते नातिवर्तितुम् ।\nविवाहो जन्ममरणं यदा यत्र तु येन च॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000409039, "chapter_id": 20409, "verse_number": "२-८१-४०", "content_sanskrit": "यथा जलधरा व्योम्नि भ्राम्यंते मातरिश्वना ।\nतथेदं कर्मयुक्तेन कालेन भ्राम्यते जगत्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000409040, "chapter_id": 20409, "verse_number": "२-८१-४१", "content_sanskrit": "सुकर्मोवाच ।\nकालोऽयं कर्मयुक्तस्तु यो नरैः समुपासितः ।\nकालस्तु प्रेरयेत्कर्म न तं कालः करोति सः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000409041, "chapter_id": 20409, "verse_number": "२-८१-४२", "content_sanskrit": "उपद्रवा घातदोषाः सर्पाश्च व्याधयस्ततः ।\nसर्वे कर्मनियुक्तास्ते प्रचरंति च मानुषे॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000409042, "chapter_id": 20409, "verse_number": "२-८१-४३", "content_sanskrit": "सुखस्य हेतवो ये च उपायाः पुण्यमिश्रिताः ।\nते सर्वे कर्मसंयुक्ता न पश्येयुः शुभाशुभम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000409043, "chapter_id": 20409, "verse_number": "२-८१-४४", "content_sanskrit": "कर्मदा यदि वा लोके कर्मसंबधि बांधवाः ।\nकर्माणि चोदयंतीह पुरुषं सुखदुःखयोः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000409044, "chapter_id": 20409, "verse_number": "२-८१-४५", "content_sanskrit": "सुवर्णं रजतं वापि यथा रूपं विनिश्चितम् ।\nतथा निबध्यते जंतुः स्वकर्मणि वशानुगः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000409045, "chapter_id": 20409, "verse_number": "२-८१-४६", "content_sanskrit": "पंचैतानीह सृज्यंते गर्भस्थस्यैव देहिनः ।\nआयुः कर्म च वित्तं च विद्यानिधनमेव च॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000409046, "chapter_id": 20409, "verse_number": "२-८१-४७", "content_sanskrit": "यथा मृत्पिंडतः कर्ता कुरुते यद्यदिच्छति ।\nतथा पूर्वकृतं कर्म कर्तारमनुगच्छति॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000409047, "chapter_id": 20409, "verse_number": "२-८१-४८", "content_sanskrit": "देवत्वमथ मानुष्यं पशुत्वं पक्षिता तथा ।\nतिर्यक्त्वं स्थावरत्वं च प्राप्यते च स्वकर्मभिः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000409048, "chapter_id": 20409, "verse_number": "२-८१-४९", "content_sanskrit": "स एव तत्तथा भुंक्ते नित्यं विहितमात्मना ।\nआत्मना विहितं दुःखं चात्मना विहितं सुखम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000409049, "chapter_id": 20409, "verse_number": "२-८१-५०", "content_sanskrit": "गर्भशय्यामुपादाय भुंजते पूर्वदैहिकम् ।\nसंत्यजंति स्वकं कर्म न क्वचित्पुरुषा भुवि॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000409050, "chapter_id": 20409, "verse_number": "२-८१-५१", "content_sanskrit": "बलेन प्रज्ञया वापि समर्थाः कर्तुमन्यथा ।\nसुकृतान्युपभुंजंति दुःखानि च सुखानि च॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000409051, "chapter_id": 20409, "verse_number": "२-८१-५२", "content_sanskrit": "हेतुं प्राप्य नरो नित्यं कर्मबंधैस्तु बध्यते ।\nयथा धेनुसहस्रेषु वत्सो विंदति मातरम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000409052, "chapter_id": 20409, "verse_number": "२-८१-५३", "content_sanskrit": "तथा शुभाशुभं कर्म कर्तारमनुगच्छति ।\nउपभोगादृते यस्य नाश एव न विद्यते॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000409053, "chapter_id": 20409, "verse_number": "२-८१-५४", "content_sanskrit": "प्राक्तनं बंधनं कर्म कोन्यथा कर्तुमर्हति ।\nसुशीघ्रमपि धावंतं विधानमनुधावति॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000409054, "chapter_id": 20409, "verse_number": "२-८१-५५", "content_sanskrit": "शेते सह शयानेन पुरा कर्म यथाकृतम् ।\nउपतिष्ठति तिष्ठंतं गच्छंतमनुगच्छति॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000409055, "chapter_id": 20409, "verse_number": "२-८१-५६", "content_sanskrit": "करोति कुर्वतः कर्मच्छायेवानु विधीयते ।\nयथा छायातपौ नित्यं सुसंबद्धौ परस्परम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000409056, "chapter_id": 20409, "verse_number": "२-८१-५७", "content_sanskrit": "तद्वत्कर्म च कर्ता च सुसंबद्धौ परस्परम् ।\nग्रहा रोगा विषाः सर्पाः शाकिन्यो राक्षसास्तथा॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000409057, "chapter_id": 20409, "verse_number": "२-८१-५८", "content_sanskrit": "पीडयंति नरं पश्चात्पीडितं पूर्वकर्मणा ।\nयेन यत्रोपभोक्तव्यं सुखं वा दुःखमेव वा॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000409058, "chapter_id": 20409, "verse_number": "२-८१-५९", "content_sanskrit": "स तत्र बद्ध्वा रज्ज्वा वै बलाद्दैवेन नीयते ।\nदैवः प्रभुर्हि भूतानां सुखदुःखोपपादने॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000409059, "chapter_id": 20409, "verse_number": "२-८१-६०", "content_sanskrit": "अन्यथा चिंत्यते कर्म जाग्रता स्वपतापि वा ।\nअन्यथा स तथा प्राज्ञ दैव एवं जिघांसति॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000409060, "chapter_id": 20409, "verse_number": "२-८१-६१", "content_sanskrit": "शस्त्राग्नि विष दुर्गेभ्यो रक्षितव्यं च रक्षति ।\nअरक्षितं भवेत्सत्यं तदेवं दैवरक्षितम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000409061, "chapter_id": 20409, "verse_number": "२-८१-६२", "content_sanskrit": "दैवेन नाशितं यत्तु तस्य रक्षा न दृश्यते ।\nयथा पृथिव्यां बीजानि उप्तानि च धनानि च॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000409062, "chapter_id": 20409, "verse_number": "२-८१-६३", "content_sanskrit": "तथैवात्मनि कर्माणि तिष्ठंति प्रभवंति च ।\nतैलक्षयाद्यथा दीपो निर्वाणमधिगच्छति॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000409063, "chapter_id": 20409, "verse_number": "२-८१-६४", "content_sanskrit": "कर्मक्षयात्तथा जंतुः शरीरान्नाशमृच्छति ।\nकर्मक्षयात्तथा मृत्युस्तत्त्वविद्भिरुदाहृतः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000409064, "chapter_id": 20409, "verse_number": "२-८१-६५", "content_sanskrit": "विविधाः प्राणिनस्तस्य मृत्यो रोगाश्च हेतवः ।\nतथा मम विपाकोयं पूर्वं कृतस्य नान्यथा॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000409065, "chapter_id": 20409, "verse_number": "२-८१-६६", "content_sanskrit": "संप्राप्तो नात्र संदेहः स्त्रीरूपोऽयं न संशयः ।\nक्व मे गेहं समायाता नाटका नटनर्तकाः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000409066, "chapter_id": 20409, "verse_number": "२-८१-६७", "content_sanskrit": "तेषां संगप्रसंगेन जरा देहं समाश्रिता ।\nसर्वं कर्मकृतं मन्ये यन्मे संभावितं ध्रुवम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000409067, "chapter_id": 20409, "verse_number": "२-८१-६८", "content_sanskrit": "तस्मात्कर्मप्रधानं च उपायाश्च निरर्थकाः ।\nपुरा वै देवराजेन मदर्थे दूतसत्तमः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000409068, "chapter_id": 20409, "verse_number": "२-८१-६९", "content_sanskrit": "प्रेषितो मातलिर्नाम न कृतं तस्य तद्वचः ।\nतस्य कर्मविपाकोऽयं दृश्यते सांप्रतं मम॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000409069, "chapter_id": 20409, "verse_number": "२-८१-७०", "content_sanskrit": "इति चिंतापरो भूत्वा दुःखेन महतान्वितः ।\nयद्यस्याहि वचः प्रीत्या न करोमि हि सर्वथा॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000409070, "chapter_id": 20409, "verse_number": "२-८१-७१", "content_sanskrit": "सत्यधर्मावुभावेतौ यास्यतस्तौ न संशयः ।\nसदृशं च समायातं यद्दृष्टं मम कर्मणा॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000409071, "chapter_id": 20409, "verse_number": "२-८१-७२", "content_sanskrit": "भविष्यति न संदेहो दैवो हि दुरतिक्रमः ।\nएवं चिंतापरो भूत्वा ययातिः पृथिवीपतिः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000409072, "chapter_id": 20409, "verse_number": "२-८१-७३", "content_sanskrit": "कृष्णं क्लेशापहं देवं जगाम शरणं हरिम् ।\nध्यात्वा नत्वा ततः स्तुत्वा मनसा मधुसूदनम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000409073, "chapter_id": 20409, "verse_number": "२-८१-७४", "content_sanskrit": "त्राहि मां शरणं प्राप्तस्त्वामहं कमलाप्रिय॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]