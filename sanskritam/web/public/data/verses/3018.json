[{"id": 2094451, "chapter_id": 3018, "verse_number": "१३-१४८-१", "content_sanskrit": "`पराशर उवाच।\nन तथा सम्प्रदानेन नोपवासादिभिस्तथा।\nइष्टां गतिमवाप्नोति यथा शुश्रूषकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094452, "chapter_id": 3018, "verse_number": "१३-१४८-२", "content_sanskrit": "यादृशेन तु तोयेन शुद्धिं प्रकुरुते नरः।\nतादृग्भवति तद्धौतमुदकस्य प्रभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094453, "chapter_id": 3018, "verse_number": "१३-१४८-३", "content_sanskrit": "शूद्रोप्येतेन मार्गेण यादृशं सेवते जनम्।\nतादृग्भवति संसर्गादचिरेण न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094454, "chapter_id": 3018, "verse_number": "१३-१४८-४", "content_sanskrit": "तस्मात्प्रयत्नतः सेव्या भिक्षवो नियतात्मना।\nउदकग्राहणाद्येन स्नपनोद्वर्तनैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094455, "chapter_id": 3018, "verse_number": "१३-१४८-५", "content_sanskrit": "अध्वना कर्शितानां च व्याधितानां तथैव च।\nशुश्रूषां नियतं कुर्यात्तेषामापदि यत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094456, "chapter_id": 3018, "verse_number": "१३-१४८-६", "content_sanskrit": "दर्भाजिनान्यवेक्षेत भैक्षभाजनमेव च।\nयथाकामं च कार्याणि सर्वाण्येवोपसाधयेत्।\nप्रायश्चित्तं यता न स्यात्तथा सर्वं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094457, "chapter_id": 3018, "verse_number": "१३-१४८-७", "content_sanskrit": "व्याधितानां तु भिक्षूणां चेलप्रक्षालनादिभिः।\nप्रतिकर्मक्रिया कार्या भेषजानयनैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094458, "chapter_id": 3018, "verse_number": "१३-१४८-८", "content_sanskrit": "पिंषणालेपनं चूर्णं कषायमथ साधनम्।\nनान्यस्य प्रतिचारेषु सुखार्थमुपपादयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094459, "chapter_id": 3018, "verse_number": "१३-१४८-९", "content_sanskrit": "भिक्षाटनोऽभिगच्छेत भिषजश्च विपश्चितः।\nततो विनिष्क्रियार्थानि द्रव्याणि समुपार्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094460, "chapter_id": 3018, "verse_number": "१३-१४८-१०", "content_sanskrit": "यश्च प्रीतमना दद्यादादद्याद्भेषजं नरः।\nअश्रद्धया हि दत्तानि तान्यभोक्ष्याणि भिक्षुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094461, "chapter_id": 3018, "verse_number": "१३-१४८-११", "content_sanskrit": "श्रद्धया यदुपादत्तं श्रद्धया चोपपादितम्।\nतस्योपभोगाद्धर्मः स्याद्व्याधिभिश्च निवर्त्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094462, "chapter_id": 3018, "verse_number": "१३-१४८-१२", "content_sanskrit": "आदेहपतनादेवं शुश्रूषेद्विधिपूर्वकम्।\nन त्वेवं धर्ममुत्सृज्य कुर्यात्तेषां प्रतिक्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094463, "chapter_id": 3018, "verse_number": "१३-१४८-१३", "content_sanskrit": "स्वभावतो हि द्वन्द्वानि विप्रयान्त्युपयान्ति च।\nस्वभावतः सर्वभावा भवन्ति नभवन्ति च।\nसागरस्योर्मिसदृशा विज्ञातव्या गुणात्मकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094464, "chapter_id": 3018, "verse_number": "१३-१४८-१४", "content_sanskrit": "विद्यादेवं हि यो धीमांस्तत्ववित्तत्वदर्शनः।\nन स लिप्येत पापेन पद्मपत्रमिवाम्भसा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094465, "chapter_id": 3018, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टचत्वारिंशदधिकशततमोऽध्यायः॥ १४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]