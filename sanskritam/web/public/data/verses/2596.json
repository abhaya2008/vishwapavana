[{"id": 2075432, "chapter_id": 2596, "verse_number": "१२-१०१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2075433, "chapter_id": 2596, "verse_number": "१२-१०१-१", "content_sanskrit": "किंशीलाः किंसमुत्थानाः कथंरूपाश्च भारत।\nकिंसन्नाहाः कथंशस्त्रा जनाः स्युः संयुगे नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2075434, "chapter_id": 2596, "verse_number": "१२-१०१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2075435, "chapter_id": 2596, "verse_number": "१२-१०१-२", "content_sanskrit": "यथाचरितमेवात्र शस्त्रं पत्रं विधीयते।\nआचाराद्धीह पुरुषस्तथा कर्मसु वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2075436, "chapter_id": 2596, "verse_number": "१२-१०१-३", "content_sanskrit": "गान्धाराः सिन्धुसौवीरा नखरप्रासयोधिनः।\nअभीरवः सुबलिनस्तद्वलं सर्वपारगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2075437, "chapter_id": 2596, "verse_number": "१२-१०१-४", "content_sanskrit": "सर्वशस्त्रेषु कुशलाः सत्ववन्तो ह्युशीनराः।\nप्राच्या मातङ्गयुद्धेषु कुशलाः कूटयोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2075438, "chapter_id": 2596, "verse_number": "१२-१०१-५", "content_sanskrit": "तथा यवनकाम्भोजा मधुरामभितश्च ये।\nएतेऽश्वयुद्धकुशला दाक्षिणात्याऽसिचर्मिणः।\nसर्वत्र शूरा जायन्ते महासत्वा महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2075439, "chapter_id": 2596, "verse_number": "१२-१०१-६", "content_sanskrit": "आवन्तिका महाशूराश्चतुरङ्गे च मालवाः।\nएकोऽपि हि सहस्रस्य तिष्ठत्यभिमुखो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2075440, "chapter_id": 2596, "verse_number": "१२-१०१-७", "content_sanskrit": "प्रायो देशाः समुद्दिष्टा लक्षणानि तु मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2075441, "chapter_id": 2596, "verse_number": "१२-१०१-८", "content_sanskrit": "सिंहशार्दूलवाङ्गेत्राः सिंहशार्दूलगामिनः।\nपारावतकुलिङ्गाक्षाः सर्वे शूराः प्रमाथिनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2075442, "chapter_id": 2596, "verse_number": "१२-१०१-९", "content_sanskrit": "मृगस्वरा द्वीपिनेत्रा ऋषभाक्षास्तथा परे।\nप्रमाथिनश्च मन्द्राश्च क्रोधनाः किङ्किणीस्वनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2075443, "chapter_id": 2596, "verse_number": "१२-१०१-१०", "content_sanskrit": "मेघस्वनाः क्रूरमुखाः केचिच्च कलनिस्वनाः।\nजिह्मनासाग्रजिह्वाश्च दूरगा दूरपातिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2075444, "chapter_id": 2596, "verse_number": "१२-१०१-११", "content_sanskrit": "बिडालकुब्जाः स्तब्धाक्षास्तनुकेशास्तनुत्वचः।\nशीघ्राश्चपलचित्ताश्च ते भवन्ति दुरासदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2075445, "chapter_id": 2596, "verse_number": "१२-१०१-१२", "content_sanskrit": "गौरा निमीलिताः केचिन्मृदुप्रकृतयस्तथा।\nतुरङ्गगतिनिर्घोषास्ते नराः पारयिष्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2075446, "chapter_id": 2596, "verse_number": "१२-१०१-१३", "content_sanskrit": "सुसंहताः प्रतनवो व्यूढोरस्काः सुसंस्थिताः।\nप्रवादितेषु कुप्यन्ति हृष्यन्ति कलद्देषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2075447, "chapter_id": 2596, "verse_number": "१२-१०१-१४", "content_sanskrit": "गम्भीराक्षा निसृष्टाक्षाः पिङ्गाक्षा भ्रुकुटीमुखाः।\nनकुलाक्षास्तथा चैव सर्वे शूरास्तनुत्यजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2075448, "chapter_id": 2596, "verse_number": "१२-१०१-१५", "content_sanskrit": "जिह्नाक्षाः प्रललाटाश्च निर्मांसहनवोऽव्यथाः।\nवक्रबाह्वङ्गुलीसक्थाः कृशा धमनिसंतताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2075449, "chapter_id": 2596, "verse_number": "१२-१०१-१६", "content_sanskrit": "प्रविशन्ति च वेगेन सांपराये ह्युपस्थिते।\nवारणा इव संमत्तास्ते भवन्ति दुरासदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2075450, "chapter_id": 2596, "verse_number": "१२-१०१-१७", "content_sanskrit": "दीप्तस्फुटितकेशान्ताः स्थूलपार्श्वहनूमुखाः।\nउन्नतांसाः पृथुग्रीवा विकटाः स्थूलपिण्डिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2075451, "chapter_id": 2596, "verse_number": "१२-१०१-१८", "content_sanskrit": "उद्बन्धा इव सुग्रीवा विनताविहगा इव।\nपिण्डशीर्षातिवक्राश्च पृषदंशमुखास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2075452, "chapter_id": 2596, "verse_number": "१२-१०१-१९", "content_sanskrit": "अग्रस्वरा मन्युमन्तो युद्धेष्वारावसारिणः।\nअधर्मज्ञाऽवलिप्ताश्च घोरा रौद्रप्रदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2075453, "chapter_id": 2596, "verse_number": "१२-१०१-२०", "content_sanskrit": "त्यक्तात्मानः सर्व एते उदग्रा ह्यनिवर्तिनः।\nपुरस्कार्याः सदा सैन्ये हन्यन्ते घ्नन्ति चापि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2075454, "chapter_id": 2596, "verse_number": "१२-१०१-२१", "content_sanskrit": "अधार्मिका भिन्नवृत्ताः सान्त्वेनैषां पराभवः।\nएवमेव प्रदूष्यन्ते राज्ञोऽप्येते ह्यभीक्ष्णशः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2075455, "chapter_id": 2596, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकाधिकशततमोऽध्यायः॥ १०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]