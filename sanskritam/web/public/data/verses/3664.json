[{"id": 2124300, "chapter_id": 3664, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124301, "chapter_id": 3664, "verse_number": "१", "content_sanskrit": "गते तु विदुरे राजन्नाश्रमं पाण्डवान् प्रति ।\nधृतराष्ट्रो महाप्राज्ञः पर्यतप्यत दुर्मनाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124302, "chapter_id": 3664, "verse_number": "२", "content_sanskrit": "स सभाद्वारमागम्य विदुरस्मारमोहितः ।\nसमक्षं पार्थिवेन्द्राणां विसञ्ज्ञः प्रापतद् भुवि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124303, "chapter_id": 3664, "verse_number": "३", "content_sanskrit": "स तु लब्ध्वा चिरात् सञ्ज्ञां समुत्थाय महीतळात् ।\nसमीपोपस्थितं राजा सञ्जयं वाक्यमब्रवीत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124304, "chapter_id": 3664, "verse_number": "४", "content_sanskrit": "भ्राता मम सुहृच्चैव साक्षाद्धर्म इवापरः ।\nतस्य स्मृत्याऽद्य हृदयं सुभृशं दीर्यते मम \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124305, "chapter_id": 3664, "verse_number": "५", "content_sanskrit": "तमानयस्व धर्मज्ञं मम भ्रातरमाशु वै ।\nइति ब्रुवन् सन्तपति करुणं पर्यदेवयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124306, "chapter_id": 3664, "verse_number": "६", "content_sanskrit": "पश्चात्तापाभिसन्तप्तो विदुरस्मारकर्शितः ।\nभ्रातृस्नेहादिदं राजा सञ्जयं वाक्यमब्रवीत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124307, "chapter_id": 3664, "verse_number": "७", "content_sanskrit": "गच्छ सञ्जय जानीहि भ्रातरं विदुरं मम ।\nमया मूढेन निकृतः कच्चिज्जीवति वा न वा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124308, "chapter_id": 3664, "verse_number": "८", "content_sanskrit": "नहि तेन मम भ्रात्रा सुसूक्ष्ममपि किञ्चन ।\nव्यलीकं कृतपूर्वं मे प्राज्ञेनामितबुद्धिना \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124309, "chapter_id": 3664, "verse_number": "९", "content_sanskrit": "स व्यलीकं कथं प्राप्तो मत्तः परमबुद्धिमान् ।\nन जह्याज्जीवितं प्राज्ञस्तं गच्छानय सञ्जय \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124310, "chapter_id": 3664, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124311, "chapter_id": 3664, "verse_number": "१०", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राज्ञस्तमनुमान्य च ।\nसञ्जयो बाढमित्युक्त्वा प्राद्रवत् काम्यकं वनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124312, "chapter_id": 3664, "verse_number": "११", "content_sanskrit": "सोऽचिरेण समासाद्य तद्वनं यत्र पाण्डवाः ।\nरौरवाजिनसंवीतं ददर्शाथ युधिष्ठिरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124313, "chapter_id": 3664, "verse_number": "१२", "content_sanskrit": "विदुरेण सहासीनं ब्राह्मणैश्च सहस्रशः ।\nभ्रातृभिश्चासिसङ्गुप्तं देवैरिव शतक्रतुम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124314, "chapter_id": 3664, "verse_number": "१३", "content_sanskrit": "युधिष्ठिरमथाभ्येत्य पूजयामास सञ्जयः ।\nभीमार्जुनयमांश्चापि तदर्हं प्रत्यपद्यत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124315, "chapter_id": 3664, "verse_number": "१४", "content_sanskrit": "राज्ञा पृष्टः स कुशलं सुखासीनश्च सञ्जयः ।\nशशंसागमने हेतुमिदं चैवाब्रवीद् वचः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124316, "chapter_id": 3664, "verse_number": "१५", "content_sanskrit": "राजा स्मरति ते क्षत्तः धृतराष्ट्रोऽम्बिकासुतः ।\nतं पश्य गत्वा त्वं क्षिप्रं सञ्जीवय नराधिपम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124317, "chapter_id": 3664, "verse_number": "१६", "content_sanskrit": "सोऽनुमान्य कुरुश्रेष्ठान् पाण्डवान् कुरुनन्दनान् ।\nनियोगाद् राजसिंहस्य गन्तुमर्हसि मानद\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124318, "chapter_id": 3664, "verse_number": "१७", "content_sanskrit": "एवमुक्तस्तु विदुरो धीमान् स्वजनवत्सलः ।\nयुधिष्ठिरस्यानुमते पुनरायाद् गजह्वयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124319, "chapter_id": 3664, "verse_number": "१८", "content_sanskrit": "सोऽभिगत्वा तदा वेश्म राज्ञस्तमभिवाद्य च ।\nउपातिष्ठन्महात्मानं राजानं प्रत्यवर्तत ।\nतमब्रवीन्महाप्राज्ञो धृतराष्ट्रोऽम्बिकासुतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124320, "chapter_id": 3664, "verse_number": "१९", "content_sanskrit": "दिष्ट्या प्राप्तोऽसि धर्मज्ञ दिष्ट्या स्मरसि मेऽनघ ।\nअद्य रात्रौ दिवा चाहं त्वत्कृते भरतर्षभ ।\nप्रजागरे प्रपश्यामि विचित्रं देहमात्मनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124321, "chapter_id": 3664, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124322, "chapter_id": 3664, "verse_number": "२०", "content_sanskrit": "सोऽङ्कमारोप्य विदुरं मूर्धन्याघ्राय चैव ह ।\nक्षम्यतामिति होवाच यदुक्तोऽसि मया रुषा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124323, "chapter_id": 3664, "verse_number": "", "content_sanskrit": "विदुर", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124324, "chapter_id": 3664, "verse_number": "२१", "content_sanskrit": "क्षान्तमेव मया राजन् गुरुर्नः परमो भवान् ।\nतथाऽहमागतः क्षिप्रं त्वद्दर्शनपरायणः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124325, "chapter_id": 3664, "verse_number": "२२", "content_sanskrit": "भवन्ति हि कुरुश्रेष्ठ पुरुषा धर्मवेतनाः ।\nदीनानुपातिनो राजन् नात्र कार्या विचारणा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2124326, "chapter_id": 3664, "verse_number": "२३", "content_sanskrit": "पाण्डवा यादृशा मे वै तादृशास्ते मता मम ।\nपाण्डोः पुत्रा यादृशास्ते तादृशा मे सुतास्तव ।\nदीना इति हि मे बुद्धिरभिपन्नाऽद्य तान् प्रति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2124327, "chapter_id": 3664, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2124328, "chapter_id": 3664, "verse_number": "२४", "content_sanskrit": "अन्योन्यमनुनीयैवं भ्रातरौ तौ महाद्युती ।\nविदुरो धृतराष्ट्रश्च लेभाते परमां मुदम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2124329, "chapter_id": 3664, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nषष्ठोऽध्यायः ॥६॥\n॥ आरण्यकपर्वणि षष्ठोऽध्यायः ॥६॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]