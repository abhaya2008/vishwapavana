[{"id": 2023035, "chapter_id": 1491, "verse_number": "३-१२९-०x", "content_sanskrit": "सोमक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023036, "chapter_id": 1491, "verse_number": "३-१२९-१", "content_sanskrit": "ब्रह्मन्यद्यद्यथा कार्यं तत्कुरुष्व तथातथा।\nपुत्रकामतया सर्वंकरिष्यामि वचस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023037, "chapter_id": 1491, "verse_number": "३-१२९-२x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023038, "chapter_id": 1491, "verse_number": "३-१२९-२", "content_sanskrit": "ततः स याजयामास सोमकं तेन जन्तुना।\nमातरस्तु बलातपुत्रमपाकार्षुः कृपान्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023039, "chapter_id": 1491, "verse_number": "३-१२९-३", "content_sanskrit": "हा हताः स्मेति वाशन्त्यस्तीव्रशोकसमाहताः।\nतं मातरः प्त्यकर्षन्गृहीत्वा दक्षिणे करे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023040, "chapter_id": 1491, "verse_number": "३-१२९-४", "content_sanskrit": "सव्ये पाणौ गृहीत्वा तु याजकोपि स्म कर्षति।\nकुररीणामिवार्तानामपाकृष्य तु तं सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023041, "chapter_id": 1491, "verse_number": "३-१२९-५", "content_sanskrit": "विशस्य चैनं विधिवद्वपामस्य जुहाव सः।\nवपायां हूयमानायां गन्धमाघ्राय मातरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023042, "chapter_id": 1491, "verse_number": "३-१२९-६", "content_sanskrit": "आर्ता निपेतुः सहसा पृथिव्यां कुरुनन्दन।\nसर्वाश्च गर्भानलबंस्ततस्ताः पार्थिवाङ्गनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023043, "chapter_id": 1491, "verse_number": "३-१२९-७", "content_sanskrit": "ततो दशसु मासेषु सोमकस्य विशांपते।\nजज्ञे पुत्रशतं पूर्णं तासु सर्वासु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023044, "chapter_id": 1491, "verse_number": "३-१२९-८", "content_sanskrit": "जन्तुर्ज्येष्ठः समभवज्जनित्र्यामेव पूर्ववत्।\nस तासामिष्ट एवासीन्न तथाऽन्ये निजाः सुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023045, "chapter_id": 1491, "verse_number": "३-१२९-९", "content_sanskrit": "तच्च लक्षणमस्यासीत्सौवर्णं पार्श्व उत्तरे।\nतस्मिन्पुत्रशते चाग्र्यः स बभूव गुणैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023046, "chapter_id": 1491, "verse_number": "३-१२९-१०", "content_sanskrit": "ततः स लोकमगमत्सोमकस्य गुरुः परम्।\nअन्वक्षमेव पश्चात्तु सोमकोप्यगमत्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023047, "chapter_id": 1491, "verse_number": "३-१२९-११", "content_sanskrit": "अथ तं नरके घोरे पच्यमानं ददर्श सः।\nतमपृच्छत्किमर्थं त्वं नरके पच्यसे द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023048, "chapter_id": 1491, "verse_number": "३-१२९-१२", "content_sanskrit": "तमब्रवीद्गुरुः सोऽथ पच्यमानोऽग्निना भृशम्।\nत्वं मया याजितो राजंस्तस्येदं कर्मणः फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023049, "chapter_id": 1491, "verse_number": "३-१२९-१३", "content_sanskrit": "एतच्छ्रुत्वा स राजर्षिर्धर्मराजमथाब्रवीत्।\nअहमत्र प्रवेक्ष्यामि मुच्यतां मम याजकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023050, "chapter_id": 1491, "verse_number": "३-१२९-१४", "content_sanskrit": "मत्कृते हि महाभागः पच्यते नरकाग्निना।\n`सोहमात्मानमाधास्ये नरके मुच्यतां गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023051, "chapter_id": 1491, "verse_number": "३-१२९-१५x", "content_sanskrit": "धर्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023052, "chapter_id": 1491, "verse_number": "३-१२९-१५", "content_sanskrit": "नान्य कर्तुः फलं राजन्नुपभुङ्क्ते कदाचन।\nइमानि तव दृश्यन्ते फलानि वदतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023053, "chapter_id": 1491, "verse_number": "३-१२९-१६x", "content_sanskrit": "सोमक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023054, "chapter_id": 1491, "verse_number": "३-१२९-१६", "content_sanskrit": "पुण्यान्न कामये लोकानृतेऽहं ब्रह्मवादिनम्।\nइच्छाम्यहमननैव सह वस्तुं सुरालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023055, "chapter_id": 1491, "verse_number": "३-१२९-१७", "content_sanskrit": "नरके वा धर्मराज कर्मणाऽस्य समो ह्यहम्।\nपुण्यापुण्यफलं देव सममस्त्वावयोरिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023056, "chapter_id": 1491, "verse_number": "३-१२९-१८x", "content_sanskrit": "धर्मराज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023057, "chapter_id": 1491, "verse_number": "३-१२९-१८", "content_sanskrit": "यद्येवमीप्सितं राजन्भुङ्खास्य सहितः फलम्।\nतुल्यकालं सहानेन पश्चात्प्राप्स्यसि सद्गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023058, "chapter_id": 1491, "verse_number": "३-१२९-१९x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023059, "chapter_id": 1491, "verse_number": "३-१२९-१९", "content_sanskrit": "स चकार तथा सर्वं राजा राजीवलोचनः।\nक्षीणपापश्च तस्मात्स विमुक्तो गुरुणा सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023060, "chapter_id": 1491, "verse_number": "३-१२९-२०", "content_sanskrit": "लेभे कामाञ्शुभान्राजन्कर्मणा निर्जितान्स्वयम्।\nसह तेनैव विप्रेण गुरुणा स गुरुप्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023061, "chapter_id": 1491, "verse_number": "३-१२९-२१", "content_sanskrit": "एष तस्याश्रमः पुण्यो य एषोग्रे विराजते।\nक्षान्त उष्यात्र षड्रात्रं प्राप्नोति सुगतिं नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023062, "chapter_id": 1491, "verse_number": "३-१२९-२२", "content_sanskrit": "एतस्मिन्नपि राजेन्द्र वत्स्यामो विगतज्वराः।\nषड्रात्रं नियतात्मानः स़ज्जीभव कुरूद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023063, "chapter_id": 1491, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकोनत्रिंशदधिकशततमोऽध्यायः ॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]