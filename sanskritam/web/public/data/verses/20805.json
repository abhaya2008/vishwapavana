[{"id": 7000805000, "chapter_id": 20805, "verse_number": "६-१४८-१", "content_sanskrit": "महादेव उवाच ।\nसाभ्रमत्यास्तटे तीर्थं गयातीर्थमनुत्तमम् ।\nचित्रांगवदनं नाम मालार्काधिष्ठितं शुभम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000805001, "chapter_id": 20805, "verse_number": "६-१४८-२", "content_sanskrit": "कल्पपादपसंतानैर्मंदारैश्चोपशोभितम् ।\nचूतनिंबकदंबैश्च काश्मर्यश्वत्थतिंदुकैः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000805002, "chapter_id": 20805, "verse_number": "६-१४८-३", "content_sanskrit": "तस्मादपहरेत्कुष्ठं योजनस्मृतिविभ्रमात् ।\nयस्य संजायते कुष्ठं तस्य मालार्कको हरेत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000805003, "chapter_id": 20805, "verse_number": "६-१४८-४", "content_sanskrit": "या तु वेदोक्तविधिना नारी तत्राभिषिंचति ।\nमृतवत्साऽथवा वंध्या पुत्रं प्राप्नोति साचिरात्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000805004, "chapter_id": 20805, "verse_number": "६-१४८-५", "content_sanskrit": "संध्यास्नानं जपो होमः स्वाध्यायो देवतार्चनम् ।\nकृतं भास्करभक्तेन मालार्के ह्यक्षयं भवेत्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000805005, "chapter_id": 20805, "verse_number": "६-१४८-६", "content_sanskrit": "अत्र गत्वा तु देवेशि श्रीरवेर्व्रतमाचरेत् ।\nइहलोके सुखं भुक्त्वा रवेर्लोकं हि याति वै॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000805006, "chapter_id": 20805, "verse_number": "६-१४८-७", "content_sanskrit": "मृतवत्सो हि राजर्षिस्तत्र गत्वाऽकरोत्तपः ।\nस राजा प्राप्तवान्पुत्रं श्रीमालार्कप्रसादतः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000805007, "chapter_id": 20805, "verse_number": "६-१४८-८", "content_sanskrit": "अत्र गत्वा विशेषण उपवासी जितेंद्रियः ।\nमालार्कं पूजयेद्यो वै मुक्तिभागी भवेद्ध्रुवम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000805008, "chapter_id": 20805, "verse_number": "६-१४८-९", "content_sanskrit": "वसिष्ठप्रमुखाविप्रा देवा इंद्रादयः सदा ।\nनिवसंति सुरश्रेष्ठे मालार्के रविसन्निधौ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]