[{"id": 2185204, "chapter_id": 4930, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185205, "chapter_id": 4930, "verse_number": "१", "content_sanskrit": "अबुद्धिपूर्वं यः पापं कुर्याद्भरतसत्तम ।\nमुच्यते स कथं तस्मादेनसस्तद्वदस्व मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185206, "chapter_id": 4930, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185207, "chapter_id": 4930, "verse_number": "२", "content_sanskrit": "अत्र ते वर्णयिष्येऽहमितिहासं पुरातनम् ।\nदण्डेन शौनको विप्रो यदाह जनमेजयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185208, "chapter_id": 4930, "verse_number": "३", "content_sanskrit": "आसीद् राजा महावीर्यः परिक्षिज्जनमेजयः ।\nअबुद्धिपूर्वं ब्रह्महत्या तमागच्छन्महीपतिम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185209, "chapter_id": 4930, "verse_number": "४", "content_sanskrit": "तं ब्राह्मणाः सर्व एव तत्यजुः सपुरोहिताः ।\nजगाम स वनं राजा दह्यमानो दिवानिशम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185210, "chapter_id": 4930, "verse_number": "५", "content_sanskrit": "स प्रजाभिः परित्यक्तश्चकार कुशलं महत् ।\nअतिवेलं तपस्तेपे दह्यमानः स मन्युना\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185211, "chapter_id": 4930, "verse_number": "६", "content_sanskrit": "ब्रह्महत्यापनोदार्थमपृच्छद् ब्राह्मणान् बहून् ।\nपर्यटन् पृथिवीं कृत्स्नां देशे देशे नराधिपः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185212, "chapter_id": 4930, "verse_number": "७", "content_sanskrit": "तत्रेतिहासं वक्ष्यामि धर्मस्यास्योपबृंहणम् ।\nदह्यमानः पापकृत्या जगाम जनमेजयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185213, "chapter_id": 4930, "verse_number": "८", "content_sanskrit": "वरिष्यमाण इन्द्रोतं शौनकं संशितव्रतम् ।\nसमासाद्योपजग्राह पादयोः परिपीडयन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185214, "chapter_id": 4930, "verse_number": "९", "content_sanskrit": "ततो भीतो महाप्राज्ञो जगर्हे सुभृशं तदा ।\nकर्ता पापस्य महतो भ्रूणहा किमिहागतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185215, "chapter_id": 4930, "verse_number": "१०", "content_sanskrit": "किं तवास्मासु कर्तव्यं मा मा स्प्राक्षीः कथञ्चन ।\nगच्छ गच्छ न ते स्थानं प्रीणात्यस्मानिह ध्रुवम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185216, "chapter_id": 4930, "verse_number": "११", "content_sanskrit": "रुधिरस्येव ते गन्धः शवस्येव च दर्शनम् ।\nअशिवः शिवसङ्काशो मृतो जीवन्निवाटसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185217, "chapter_id": 4930, "verse_number": "१२", "content_sanskrit": "अन्तर्मृत्युरशुद्धात्मा पापमेवानुचिन्तयन् ।\nप्रबुध्यसे प्रस्वपिषि वर्तसे चरसे सुखी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185218, "chapter_id": 4930, "verse_number": "१३", "content_sanskrit": "मोघं ते जीवितं राजन् परिक्लिष्टं च जीवसि ।\nपापायैव च सृष्टोऽसि कर्मणे ह यवीयसे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185219, "chapter_id": 4930, "verse_number": "", "content_sanskrit": "बहु कल्याणमिच्छन्त ईहन्ते पितरः सुतान् ।\nतपसा देवतेज्याभिर्वन्दनेन तितिक्षया\t।१४॥।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2185220, "chapter_id": 4930, "verse_number": "१५", "content_sanskrit": "पितृवंशमिमं पश्य त्वत्कृते नरकं गतम् ।\nनिरर्थाः सर्व एवैषामाशाबन्धास्त्वदाश्रयाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2185221, "chapter_id": 4930, "verse_number": "१६", "content_sanskrit": "यान् पूजयन्तो विन्दन्ति स्वर्गमायुर्यशः सुखम् ।\nतेषु ते सततं द्वेषो ब्राह्मणेषु निरर्थकः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2185222, "chapter_id": 4930, "verse_number": "१७", "content_sanskrit": "इमं लोकं विमुच्य त्वमवाङ्मूर्धा पतिष्यसि ।\nअशाश्वतीः शाश्वतीश्च समाः पापेन कर्मणा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2185223, "chapter_id": 4930, "verse_number": "१८", "content_sanskrit": "अद्यमानो जन्तुगृध्रैः शितिकण्ठैरयोमुखैः ।\nततोऽपि पुनरावृत्तः पापयोनिं गमिष्यसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2185224, "chapter_id": 4930, "verse_number": "१९", "content_sanskrit": "यदिदं मन्यसे राजन्नायमस्ति परः कुतः ।\nप्रतिस्मारयितारस्त्वां यमदूता यमक्षये\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2185225, "chapter_id": 4930, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे अष्टादशोऽध्यायः ॥ १८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]