[{"id": 40022669, "chapter_id": 9404, "verse_number": "1", "content_sanskrit": "लक्ष्मणस्य तु तद्वाक्यं श्रुत्वा शत्रुनिबर्हणः । वृत्रघातमशेषेण कथयेत्याह सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022670, "chapter_id": 9404, "verse_number": "2", "content_sanskrit": "राघवेणैवमुक्तस्तु सुमित्रानन्दवर्धनः । भूय एव कथां दिव्यां कथयामास सुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022671, "chapter_id": 9404, "verse_number": "3", "content_sanskrit": "सहस्राक्षवचः श्रुत्वा सर्वेषां च दिवौकसाम् । विष्णुर्देवानुवाचेदं सर्वानिन्द्रपुरोगमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022672, "chapter_id": 9404, "verse_number": "4", "content_sanskrit": "पूर्वं सौहृदबद्धो ऽस्मि वृत्रस्य ह महात्मनः । तेन युष्मत्प्रियार्थं हि नाहं हन्मि महासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022673, "chapter_id": 9404, "verse_number": "5", "content_sanskrit": "अवश्यं करणीयं च भवतां सुखमुत्तमम् । तस्मादुपायमाख्यास्ये येन वृत्रो निहन्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022674, "chapter_id": 9404, "verse_number": "6", "content_sanskrit": "त्रिधाभूतं करिष्यामि ह्यात्मानं सुरसत्तमाः । तेन वृत्रं सहस्राक्षो वधिष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022675, "chapter_id": 9404, "verse_number": "7", "content_sanskrit": "एकांशो वासवं यातु द्वितीयो वज्रमेव तु । तृतीयो भूतलं शक्रस्तदा वृत्रं वधिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022676, "chapter_id": 9404, "verse_number": "8", "content_sanskrit": "तथा ब्रुवति देवेशे देवा वाक्यमथाब्रुवन् । एवमेतन्न सन्देहो यथा वदसि दैत्यहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022677, "chapter_id": 9404, "verse_number": "9", "content_sanskrit": "भद्रं ते ऽस्तु गमिष्यामो वृत्रासुरवधैषिणः । भजस्व परमोदार वासवं स्वेन तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022678, "chapter_id": 9404, "verse_number": "10", "content_sanskrit": "ततः सर्वे महात्मानः सहस्राक्षपुरोगमाः । तदारण्यमुपाक्रामन्यत्र वृत्रो महासुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022679, "chapter_id": 9404, "verse_number": "11", "content_sanskrit": "ते पश्यंस्तेजसा भूतं तप्यन्तमसुरोत्तमम् । पिबन्तमिव लोकांस्त्रीन्निर्दहन्तमिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022680, "chapter_id": 9404, "verse_number": "12", "content_sanskrit": "दृष्ट्वैव चासुरश्रेष्ठं देवास्त्रासमुपागमन् । कथमेनं वधिष्यामः कथं न स्यात्पराजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022681, "chapter_id": 9404, "verse_number": "13", "content_sanskrit": "तेषां चिन्तयतां तत्र सहस्राक्षः पुरन्दरः । वज्रं प्रगृह्य पाणिभ्यां प्राहिणोद्वृत्रमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022682, "chapter_id": 9404, "verse_number": "14", "content_sanskrit": "कालाग्निनेव घोरेण तप्तेनैव महार्चिषा । पतता वृत्रशिरसा जगत्ऺत्रासमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022683, "chapter_id": 9404, "verse_number": "15", "content_sanskrit": "असम्भाव्यं वधं तस्य वृत्रस्य विबुधाधिपः । चिन्तयानो जगामाशु लोकस्यान्तं महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022684, "chapter_id": 9404, "verse_number": "16", "content_sanskrit": "तमिन्द्रं ब्रह्महत्या ऽ ऽशु गच्छन्तमनुगच्छति । अपतच्चास्य गात्रेषु तमिन्द्रं दुःखमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022685, "chapter_id": 9404, "verse_number": "17", "content_sanskrit": "हतारयः प्रनष्टेन्द्रा देवाः साग्निपुरोगमाः । विष्णुं त्रिभुवनेशानं मुहुर्मुहुरपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022686, "chapter_id": 9404, "verse_number": "18", "content_sanskrit": "त्वं गतिः परमेशान पूर्वजो जगतः पिता । रक्षार्थं सर्वभूतानां विष्णुत्वमुपजग्मिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022687, "chapter_id": 9404, "verse_number": "19", "content_sanskrit": "हतश्चायं त्वया वृत्रो ब्रह्महत्या च वासवम् । बाधते सुरशार्दूल मोक्षं तस्या विनिर्दिश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022688, "chapter_id": 9404, "verse_number": "20", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा देवानां विष्णुरब्रवीत् । मामेव यजतां शक्रः पावयिष्यामि वज्रिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022689, "chapter_id": 9404, "verse_number": "21", "content_sanskrit": "पुण्येन हयमेधेन मामिष्ट्वा पाकशासनः । पुनरेष्यति देवानामिन्द्रत्वमकुतोभयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022690, "chapter_id": 9404, "verse_number": "22", "content_sanskrit": "एवं सन्दिश्य तां वाणीं देवानाममृतोपमाम् । जगाम विष्णुर्देवेशः स्तूयमानस्त्रिविष्टपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]