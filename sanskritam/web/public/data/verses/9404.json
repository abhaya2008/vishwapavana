[{"id": 5000404000, "chapter_id": 9404, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे पञ्चषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000404001, "chapter_id": 9404, "verse_number": "५-६५-१", "content_sanskrit": "ततः प्रस्रवणं शैलं ते गत्वा चित्रकाननम्।\nप्रणम्य शिरसा रामं लक्ष्मणं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000404002, "chapter_id": 9404, "verse_number": "५-६५-२", "content_sanskrit": "युवराजं पुरस्कृत्य सुग्रीवमभिवाद्य च।\nप्रवृत्तिमथ सीतायाः प्रवक्तुमुपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000404003, "chapter_id": 9404, "verse_number": "५-६५-३", "content_sanskrit": "रावणान्तःपुरे रोधं राक्षसीभिश्च तर्जनम्।\nरामे समनुरागं च यथा च नियमः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000404004, "chapter_id": 9404, "verse_number": "५-६५-४", "content_sanskrit": "एतदाख्याय ते सर्वं हरयो रामसंनिधौ।\nवैदेहीमक्षतां श्रुत्वा रामस्तूत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000404005, "chapter_id": 9404, "verse_number": "५-६५-५", "content_sanskrit": "क्व सीता वर्तते देवी कथं च मयि वर्तते।\nएतन्मे सर्वमाख्यात वैदेहीं प्रति वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000404006, "chapter_id": 9404, "verse_number": "५-६५-६", "content_sanskrit": "रामस्य गदितं श्रुत्वा हरयो रामसंनिधौ।\nचोदयन्ति हनूमन्तं सीतावृत्तान्तकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000404007, "chapter_id": 9404, "verse_number": "५-६५-७", "content_sanskrit": "श्रुत्वा तु वचनं तेषां हनूमान् मारुतात्मजः।\nप्रणम्य शिरसा देव्यै सीतायै तां दिशं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000404008, "chapter_id": 9404, "verse_number": "५-६५-८", "content_sanskrit": "उवाच वाक्यं वाक्यज्ञः सीताया दर्शनं यथा।\nतं मणिं काञ्चनं दिव्यं दीप्यमानं स्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000404009, "chapter_id": 9404, "verse_number": "५-६५-९", "content_sanskrit": "दत्त्वा रामाय हनुमांस्ततः प्राञ्जलिरब्रवीत्।\nसमुद्रं लङ्घयित्वाहं शतयोजनमायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000404010, "chapter_id": 9404, "verse_number": "५-६५-१०", "content_sanskrit": "अगच्छं जानकीं सीतां मार्गमाणो दिदृक्षया।\nतत्र लङ्केति नगरी रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000404011, "chapter_id": 9404, "verse_number": "५-६५-११", "content_sanskrit": "दक्षिणस्य समुद्रस्य तीरे वसति दक्षिणे।\nतत्र सीता मया दृष्टा रावणान्तःपुरे सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000404012, "chapter_id": 9404, "verse_number": "५-६५-१२", "content_sanskrit": "त्वयि संन्यस्य जीवन्ती रामा राम मनोरथम्।\nदृष्टा मे राक्षसीमध्ये तर्ज्यमाना मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000404013, "chapter_id": 9404, "verse_number": "५-६५-१३", "content_sanskrit": "राक्षसीभिर्विरूपाभी रक्षिता प्रमदावने।\nदुःखमापद्यते देवी त्वया वीर सुखोचिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000404014, "chapter_id": 9404, "verse_number": "५-६५-१४", "content_sanskrit": "रावणान्तःपुरे रुद्धा राक्षसीभिः सुरक्षिता।\nएकवेणीधरा दीना त्वयि चिन्तापरायणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000404015, "chapter_id": 9404, "verse_number": "५-६५-१५", "content_sanskrit": "अधःशय्या विवर्णाङ्गी पद्मिनीव हिमागमे।\nरावणाद् विनिवृत्तार्था मर्तव्यकृतनिश्चया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000404016, "chapter_id": 9404, "verse_number": "५-६५-१६", "content_sanskrit": "देवी कथंचित् काकुत्स्थ त्वन्मना मार्गिता मया।\nइक्ष्वाकुवंशविख्यातिं शनैः कीर्तयतानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000404017, "chapter_id": 9404, "verse_number": "५-६५-१७", "content_sanskrit": "सा मया नरशार्दूल शनैर्विश्वासिता तदा।\nततः सम्भाषिता देवी सर्वमर्थं च दर्शिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000404018, "chapter_id": 9404, "verse_number": "५-६५-१८", "content_sanskrit": "रामसुग्रीवसख्यं च श्रुत्वा हर्षमुपागता।\nनियतः समुदाचारो भक्तिश्चास्याः सदा त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000404019, "chapter_id": 9404, "verse_number": "५-६५-१९", "content_sanskrit": "एवं मया महाभाग दृष्टा जनकनन्दिनी।\nउग्रेण तपसा युक्ता त्वद्भक्त्या पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000404020, "chapter_id": 9404, "verse_number": "५-६५-२०", "content_sanskrit": "अभिज्ञानं च मे दत्तं यथावृत्तं तवान्तिके।\nचित्रकूटे महाप्राज्ञ वायसं प्रति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000404021, "chapter_id": 9404, "verse_number": "५-६५-२१", "content_sanskrit": "विज्ञाप्यः पुनरप्येष रामो वायुसुत त्वया।\nअखिलेन यथा दृष्टमिति मामाह जानकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000404022, "chapter_id": 9404, "verse_number": "५-६५-२२", "content_sanskrit": "अयं चास्मै प्रदातव्यो यत्नात् सुपरिरक्षितः।\nब्रुवता वचनान्येवं सुग्रीवस्योपशृण्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000404023, "chapter_id": 9404, "verse_number": "५-६५-२३", "content_sanskrit": "एष चूडामणिः श्रीमान् मया ते यत्नरक्षितः।\nमनःशिलायास्तिलकं तत् स्मरस्वेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000404024, "chapter_id": 9404, "verse_number": "५-६५-२४", "content_sanskrit": "एष निर्यातितः श्रीमान् मया ते वारिसम्भवः।\nएनं दृष्ट्वा प्रमोदिष्ये व्यसने त्वामिवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000404025, "chapter_id": 9404, "verse_number": "५-६५-२५", "content_sanskrit": "जीवितं धारयिष्यामि मासं दशरथात्मज।\nऊर्ध्वं मासान्न जीवेयं रक्षसां वशमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000404026, "chapter_id": 9404, "verse_number": "५-६५-२६", "content_sanskrit": "इति मामब्रवीत् सीता कृशाङ्गी धर्मचारिणी।\nरावणान्तःपुरे रुद्धा मृगीवोत्फुल्ललोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000404027, "chapter_id": 9404, "verse_number": "५-६५-२७", "content_sanskrit": "एतदेव मयाऽऽख्यातं सर्वं राघव यद् यथा।\nसर्वथा सागरजले संतारः प्रविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000404028, "chapter_id": 9404, "verse_number": "५-६५-२८", "content_sanskrit": "तौ जाताश्वासौ राजपुत्रौ विदित्वा\nतच्चाभिज्ञानं राघवाय प्रदाय।\nदेव्या चाख्यातं सर्वमेवानुपूर्व्याद्\nवाचा सम्पूर्णं वायुपुत्रः शशंस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000404029, "chapter_id": 9404, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे पञ्चषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]