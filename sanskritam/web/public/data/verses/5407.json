[{"id": 2206817, "chapter_id": 5407, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206818, "chapter_id": 5407, "verse_number": "१", "content_sanskrit": "कृतोदकस्तु राजानं धृतराष्ट्रं युधिष्ठिरः ।\nपुरस्कृत्य महाबाहुरुत्तताराकुलेन्द्रियः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206819, "chapter_id": 5407, "verse_number": "२", "content_sanskrit": "उत्तीर्य तु महीपालो बाष्पव्याकुललोचनः ।\nपपात तीरे गङ्गाया व्याधविद्ध इव द्विपः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206820, "chapter_id": 5407, "verse_number": "३", "content_sanskrit": "तं सीदमानं जग्राह भीमः कृष्णेन चोदितः ।\nमैवमित्यब्रवीच्चैनं कृष्णः परबलार्दनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206821, "chapter_id": 5407, "verse_number": "४", "content_sanskrit": "तमार्तं पतितं भूमौ श्वसन्तं च पुनः पुनः ।\nददृशुः पाण्डवा राजन् धर्मपुत्रं युधिष्ठिरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206822, "chapter_id": 5407, "verse_number": "५", "content_sanskrit": "तं दृष्ट्वा दीनमनसं गतसत्वं जनेश्वरम् ।\nभूयः शोकसमाविष्टाः पाण्डवाः समुपाविशन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206823, "chapter_id": 5407, "verse_number": "६", "content_sanskrit": "राजा च धृतराष्ट्रस्तमुपासीनं महाभुजम् ।\nवाक्यमाह महाबुद्धिर्महाबुद्धिं जनेश्वरम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206824, "chapter_id": 5407, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206825, "chapter_id": 5407, "verse_number": "७", "content_sanskrit": "उत्तिष्ठ नरशार्दूल कुरु कार्यमनन्तरम् ।\nक्षत्रधर्मेण कौरव्य जितेयमवनिस्त्वया\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206826, "chapter_id": 5407, "verse_number": "८", "content_sanskrit": "तां भुङ्क्ष्व भ्रातृभिः सार्धं सुहृद्भिश्च जनेश्वर ।\nन शोचितव्यं पश्यामि त्वया धर्मभृतां वर\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206827, "chapter_id": 5407, "verse_number": "९", "content_sanskrit": "शोचितव्यं मया चैव गान्धार्या च महामते ।\nययोः पुत्रशतं नष्टं स्वप्नलब्धं धनं यथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206828, "chapter_id": 5407, "verse_number": "१०", "content_sanskrit": "अश्रुत्वा हितकामस्य विदुरस्य महात्मनः ।\nवाक्यानि सुमहार्थानि परितप्तोऽस्मि दुर्मतिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206829, "chapter_id": 5407, "verse_number": "११", "content_sanskrit": "उक्तवानेष मां पूर्वं धर्मात्मा दिव्यदर्शनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206830, "chapter_id": 5407, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206831, "chapter_id": 5407, "verse_number": "१२", "content_sanskrit": "दुर्योधनापराधेन कुलं ते विनशिष्यति ।\nस्वस्ति चेदिच्छसे कामं कुलस्य कुरु मे वचः ।\nबध्यतामेष दुष्टात्मा मन्दो राजा सुयोधनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206832, "chapter_id": 5407, "verse_number": "१३", "content_sanskrit": "कर्णश्च शकुनिश्चैव मैनं पश्यतु कर्हिचित् ।\nदूतसम्पातमप्येषामप्रमत्तो निवारय\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206833, "chapter_id": 5407, "verse_number": "१४", "content_sanskrit": "अभिषेचय राजानं धर्मात्मानं युधिष्ठिरम् ।\nस पालयिष्यति वशी धर्मेण पृथिवीमिमाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206834, "chapter_id": 5407, "verse_number": "१५", "content_sanskrit": "अथ नेच्छसि राजानं कुन्तीपुत्रं युधिष्ठिरम् ।\nमेढीभूतं स्वयं राज्यं प्रतिगृह्णीष्व पार्थिव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206835, "chapter_id": 5407, "verse_number": "१६", "content_sanskrit": "अनुजीवन्तु सर्वे त्वां ज्ञातयो ज्ञातिवर्धन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206836, "chapter_id": 5407, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206837, "chapter_id": 5407, "verse_number": "१७", "content_sanskrit": "एवं ब्रुवति कौन्तेय विदुरे दीर्घदर्शिनि ।\nदुर्योधनमहं पापमनुवृत्तो वृथामतिः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206838, "chapter_id": 5407, "verse_number": "१८", "content_sanskrit": "अश्रुत्वैवास्य वाक्यानि हितानि मधुराणि च ।\nफलं प्राप्य महद् दुःखं निमग्नः शोकसागरे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206839, "chapter_id": 5407, "verse_number": "१९", "content_sanskrit": "वृद्धौ हि तेऽम्बापितरौ पश्यावां दुःखितौ नृप ।\nन शोचितव्यं भवता पश्यामीह जनाधिप\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206840, "chapter_id": 5407, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि प्रथमोऽध्यायः ॥१॥\nअश्वमेधपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]