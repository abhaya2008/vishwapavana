[{"id": 7003505000, "chapter_id": 23505, "verse_number": "१४५-१", "content_sanskrit": "अथ सालग्रामक्षेत्रमाहात्म्यम् ।\nधरण्युवाच ।\nभगवन्देवदेवेश सालंकायनको मुनिः ।\nकिं चकार तपः कुर्वंस्तव क्षेत्रे विमुक्तिदे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003505001, "chapter_id": 23505, "verse_number": "१४५-२", "content_sanskrit": "श्रीवराह उवाच।\nअथ दीर्घेण कालेन स ऋषिः संशित व्रतः ।\nतप्यमानो यथान्यायं पश्यन्वै सालमुत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003505002, "chapter_id": 23505, "verse_number": "१४५-३", "content_sanskrit": "अभिन्नमतुलच्छायं विशालं पुष्पितं तथा ।\nमनोज्ञं च सुगन्धं च देवानामपि दुर्ल्लभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003505003, "chapter_id": 23505, "verse_number": "१४५-४", "content_sanskrit": "ऋषिर्ज्ञानपरिश्रान्तः सालंकायनकोऽद्भुतम् ।\nददर्श च पुनः सालं शुभानां शुभदर्शनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003505004, "chapter_id": 23505, "verse_number": "१४५-५", "content_sanskrit": "ततो दृष्ट्वा महासालं परिश्रान्तो महामुनिः ।\nविश्रामं कुरुते तत्र द्रष्टुकामोऽथ मां मुनिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003505005, "chapter_id": 23505, "verse_number": "१४५-६", "content_sanskrit": "सालस्य तस्य पूर्वेण स्थितः पश्चान्मुखो मुनिः ।\nमायया मम मूढात्मा शक्तो द्रष्टुं न मामभूत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003505006, "chapter_id": 23505, "verse_number": "१४५-७", "content_sanskrit": "ततः पूर्वेण पार्श्वेन तस्य सालस्य सुन्दरि ।\nवैशाखमासद्वादश्यां मद्दर्शनमुपागतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003505007, "chapter_id": 23505, "verse_number": "१४५-८", "content_sanskrit": "दृष्ट्वा मां तत्र स मुनिस्त पस्वी संशितव्रतः ।\nतुष्टाव वैदिकैः सूक्तैः प्रणम्य च पुनःपुनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003505008, "chapter_id": 23505, "verse_number": "१४५-९", "content_sanskrit": "मत्तेजसा ताडिताक्षः शनैरुन्मील्य लोचने ।\nयावत्पश्यति मां तत्र स्तुवन्स तपसान्वितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003505009, "chapter_id": 23505, "verse_number": "१४५-१०", "content_sanskrit": "वृक्षस्य दक्षिणे पार्श्वे गतस्तावदहं धरे ।\nपूर्वस्थानं परित्यज्य स ऋषिः संशितव्रतः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003505010, "chapter_id": 23505, "verse_number": "१४५-११", "content_sanskrit": "स्थित्वा मत्प्रमुखे चैव स्तुवन्नेवं मम प्रियम्।\n&nbsp;ततोऽहं स्तूयमानौ वै ऋग्वेदस्यैव ऋग्गतैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003505011, "chapter_id": 23505, "verse_number": "१४५-१२", "content_sanskrit": "स्तोत्रैः सम्पूज्यमानो हि गतोऽहं पश्चिमां दिशम् ।\nततः पश्चिमपार्श्वे तु स्थितस्तत्रैव माधवि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003505012, "chapter_id": 23505, "verse_number": "१४५-१३", "content_sanskrit": "यजुर्वेदोक्तमन्त्रेण संस्तुतः पश्चिमां गतः ।\nस्तुवतीत्थं मुनौ देवि गतोऽहं चोत्तरां दिशम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003505013, "chapter_id": 23505, "verse_number": "१४५-१४", "content_sanskrit": "तत्रापि सामवेदोक्तैर्मन्त्रैस्तुष्टाव मां मुनिः ।\nततोऽहं स्तूयमानो वै ऋषिमुख्येन सुन्दरि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003505014, "chapter_id": 23505, "verse_number": "१४५-१५", "content_sanskrit": "प्राप्तश्च परमां प्रीतिं तमवोचमृषिं तदा ।\nसाधु ब्रह्मन्महाभाग सालंकायन सत्तम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003505015, "chapter_id": 23505, "verse_number": "१४५-१६", "content_sanskrit": "तपसानेन सन्तुष्टः स्तुत्या चैवानया तव ।\nवरं वरय भद्रं ते संसिद्धस्तपसा भवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003505016, "chapter_id": 23505, "verse_number": "१४५-१७", "content_sanskrit": "एवमुक्तः स तु मया सालंकायनको मुनिः ।\nसालवृक्षं समाश्रित्य निभृतेनान्तरात्मना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003505017, "chapter_id": 23505, "verse_number": "१४५-१८", "content_sanskrit": "ततो मां भाषते देवि स ऋषिः संशितव्रतः ।\nतवैवाराधनार्थाय तपस्तप्तं मया हरे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003505018, "chapter_id": 23505, "verse_number": "१४५-१९", "content_sanskrit": "पर्यटामि महीं सर्वां सशैलवनकाननाम् ।\nइदानीं खलु दृष्टोऽसि चक्रपाणे महाप्रभो ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003505019, "chapter_id": 23505, "verse_number": "१४५-२०", "content_sanskrit": "यदि तुष्टोऽसि मे देव सर्वशान्तिकरः परः ।\nयदि देयो वरो मह्यं तपसाराधितेन च ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003505020, "chapter_id": 23505, "verse_number": "१४५-२१", "content_sanskrit": "तदा देहि जगन्नाथ ममेश्वर समं सुतम् ।\nएष एव वरो मह्यं दीयतां मधुसूदन ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003505021, "chapter_id": 23505, "verse_number": "१४५-२२", "content_sanskrit": "एवं वरं याचितोऽस्मि मुनिना भीमकर्मणा ।\nपुत्रकामेन विप्रेण दीर्घ कालं तपस्यता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003505022, "chapter_id": 23505, "verse_number": "१४५-२३", "content_sanskrit": "एवं तस्य वचः श्रुत्वा ब्राह्मणस्य तपस्विनः ।\nमधुरां गिरमादाय प्रत्यवोचमृषिं प्रति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003505023, "chapter_id": 23505, "verse_number": "१४५-२४", "content_sanskrit": "चिरकालं व्रतस्थेन यत्त्वया चिन्तितं मुने ।\nस कामस्तव सञ्जातः सिद्धोऽसि तपसा भवान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003505024, "chapter_id": 23505, "verse_number": "१४५-२५", "content_sanskrit": "ईश्वरस्य परा मूर्त्तिर्नाम्ना वै नन्दिकेश्वरः ।\nत्वद्दक्षिणांगादुद्भूतः पुत्रस्तव मुनीश्वर ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003505025, "chapter_id": 23505, "verse_number": "१४५-२६", "content_sanskrit": "संहरस्व तपो ब्रह्मञ्शान्तिं गच्छ महामुने ।\nअथ चैतस्य जातस्य कल्पा वै  सप्त सप्त च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003505026, "chapter_id": 23505, "verse_number": "१४५-२७", "content_sanskrit": "त्वं न जानासि विप्रर्षे स जातो नन्दिकेश्वरः ।\nमायायोगबलोपेतो गोव्रजं स मया स्थितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003505027, "chapter_id": 23505, "verse_number": "१४५-२८", "content_sanskrit": "मथुरायाः समानीय आमुष्यायणसंज्ञितम् ।\nतव शिष्यं पुरस्कृत्य शूलपाणिरवस्थितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003505028, "chapter_id": 23505, "verse_number": "१४५-२९", "content_sanskrit": "तत्राश्रमे महाभाग स्थित्वा त्वं तपसां निधे ।\nपुत्रेण परमप्रीतो मत्क्षेत्रेऽस्मत्समो भव ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003505029, "chapter_id": 23505, "verse_number": "१४५-३०", "content_sanskrit": "अन्यच्च गुह्यं वक्ष्यामि सालङ्कायन तच्छृणु ।\nतव प्रीत्या प्रवक्ष्यामि येनैतत्क्षेत्रमुत्तमम् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003505030, "chapter_id": 23505, "verse_number": "१४५-३१", "content_sanskrit": "शालग्राममिति ख्यातं तन्निबोध मुने शुभम् ।\nयोऽयं वृक्षस्त्वया दृष्टः सोऽहमेव न संशयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003505031, "chapter_id": 23505, "verse_number": "१४५-३२", "content_sanskrit": "एतत्कोऽपि न जानाति विना देवं महेश्वरम् ।\nमाययाऽहं निगूढोऽस्मि त्वत्प्रसादात्प्रकाशितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003505032, "chapter_id": 23505, "verse_number": "१४५-३३", "content_sanskrit": "एवं तस्मै वरं दत्त्वा सालंकायनकाय वै ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003505033, "chapter_id": 23505, "verse_number": "१४५-३४", "content_sanskrit": "पश्यतस्तस्य वसुधे तत्रैवान्तर्हितोऽभवम् ।\nवृक्षं दक्षिणतः कृत्वा जगाम स्वाश्रमं मुनिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003505034, "chapter_id": 23505, "verse_number": "१४५-३५", "content_sanskrit": "मम तद्रोचते स्थानं गिरिकूटशिलोच्चये ।\nशालग्राम इति ख्यातं भक्तसंसारमोक्षणम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003505035, "chapter_id": 23505, "verse_number": "१४५-३६", "content_sanskrit": "तत्र गुह्यानि मे भूमे वक्ष्यमाणानि मे शृणु ।\nतरन्ति मनुजा येभ्यो घोरं संसारसागरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003505036, "chapter_id": 23505, "verse_number": "१४५-३७", "content_sanskrit": "गुह्यानि तत्र वसुधे तीर्थानि दश पंच च ।\nनाद्यापि किंचिज्जानन्ति मुच्यन्ते यैरिह स्थिताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003505037, "chapter_id": 23505, "verse_number": "१४५-३८", "content_sanskrit": "तत्र बिल्वप्रभं नाम गुह्यं क्षेत्रं मम प्रियम् ।\nकुञ्जानि तत्र चत्वारि क्रोशमात्रे यशस्विनि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003505038, "chapter_id": 23505, "verse_number": "१४५-३९", "content_sanskrit": "हृद्यं तत्परमं गुह्यं भक्तकर्मसुखावहम् ।\nतत्र स्नानं तु कुर्वीत अहोरात्रोषितो नरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003505039, "chapter_id": 23505, "verse_number": "१४५-४०", "content_sanskrit": "चतुर्णामश्वमेधानां फलं प्राप्नोति मानवः ।\nअथात्र मुंचते प्राणान्मम कर्मसु निष्ठितः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003505040, "chapter_id": 23505, "verse_number": "१४५-४१", "content_sanskrit": "अश्वमेधफलं भुक्त्वा मम लोके स मोदते ।\nचक्रस्वामीति विख्यातं तस्मिन्क्षेत्रे परं मम ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003505041, "chapter_id": 23505, "verse_number": "१४५-४२", "content_sanskrit": "चक्राङ्कितशिलास्तत्र दृश्यन्ते च इतस्ततः ।\nचक्राङ्कितशिला यत्र वरवर्णिनि तिष्ठति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003505042, "chapter_id": 23505, "verse_number": "१४५-४३", "content_sanskrit": "तदेतद्विद्धि वसुधे समन्ता द्योजनत्रयम् ।\nतत्र स्नानं तु कुर्वीत त्रिरात्रोपोषितो नरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003505043, "chapter_id": 23505, "verse_number": "१४५-४४", "content_sanskrit": "त्रयाणामपि यज्ञानां फलं प्राप्नोति निश्चितम् ।\nअथात्र मुंचते प्राणान्मम कर्म परायणः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003505044, "chapter_id": 23505, "verse_number": "१४५-४५", "content_sanskrit": "वाजपेयफलं भुक्त्वा मम् लोकं च गच्छति ।\nतत्र विष्णुपदं नाम क्षेत्रं गुह्यं परं मम ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003505045, "chapter_id": 23505, "verse_number": "१४५-४६", "content_sanskrit": "तिस्रो धाराः पतन्त्यत्र हिमकूटं समाश्रिताः ।\nतत्र स्नानं तु कुर्वीत त्रिरात्रोपोषितो नरः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003505046, "chapter_id": 23505, "verse_number": "१४५-४७", "content_sanskrit": "त्रयाणामपि रात्रीणां फलं प्राप्नोति निष्कलम् ।\nतथैव मुंचते प्राणान्मुक्तसंगो गत क्लमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003505047, "chapter_id": 23505, "verse_number": "१४५-४८", "content_sanskrit": "अतिरात्रफलं भुक्त्वा मम लोके महीयते ।\nतत्र कालीह्रदं नाम गुह्यं क्षेत्रं परं मम ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003505048, "chapter_id": 23505, "verse_number": "१४५-४९", "content_sanskrit": "अत्र चैव ह्रदस्रोतो बदरीवृक्षनिःसृतः ।\nतत्र स्नानं तु कुर्वीत षष्टिकालोषितो नरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003505049, "chapter_id": 23505, "verse_number": "१४५-५०", "content_sanskrit": "नरमेधस्य यज्ञस्य फलं प्राप्नोति मानवः ।\nअथात्र मुंचते प्राणान्मुक्तरागो गत क्लमः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003505050, "chapter_id": 23505, "verse_number": "१४५-५१", "content_sanskrit": "नरमेधफलं भुक्त्वा मम लोके च मोदते ।\nअन्यच्च ते प्रवक्ष्यामि महाश्चर्यं वसुन्धरे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003505051, "chapter_id": 23505, "verse_number": "१४५-५२", "content_sanskrit": "तत्र शङ्खप्रभं नाम गुह्यं क्षेत्रं परं मम ।\nश्रूयते शंखशब्दश्च द्वादश्यामर्द्धरात्रके ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003505052, "chapter_id": 23505, "verse_number": "१४५-५३", "content_sanskrit": "गदाकुण्डमिति ख्यातं तस्मिन्क्षेत्रे परं मम ।\nयत्र वै कम्पते स्रोतो दक्षिणां दिशामाश्रि तम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003505053, "chapter_id": 23505, "verse_number": "१४५-५४", "content_sanskrit": "तत्र स्नानं तु कुर्वीत त्रिरात्रोपोषितो नरः ।\nवेदान्तगानां विप्राणां फलं प्राप्नोति मानवः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003505054, "chapter_id": 23505, "verse_number": "१४५-५५", "content_sanskrit": "अथ वै मुंचते प्राणान्कृतकृत्यो गुणान्वितः ।\nगदापाणिर्महाकायो मम लोकं प्रपद्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003505055, "chapter_id": 23505, "verse_number": "१४५-५६", "content_sanskrit": "पुनश्चाग्निप्रभं नाम गुह्यं क्षेत्रं परं मम ।\nधारा पतति तत्रैका पूर्वोत्तरसमाश्रिता ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003505056, "chapter_id": 23505, "verse_number": "१४५-५७", "content_sanskrit": "यस्तत्र कुरुते स्नानं चतूरात्रोषितो नरः ।\nअग्निष्टोमात्पंचगुणं फलं प्राप्नोति मानवः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003505057, "chapter_id": 23505, "verse_number": "१४५-५८", "content_sanskrit": "अथात्र मुंचते प्राणान् मम कर्मसु निष्ठितः ।\nअग्निष्टोमफलं भुक्त्वा मम लोकं प्रपद्यते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003505058, "chapter_id": 23505, "verse_number": "१४५-५९", "content_sanskrit": "तत्राश्चर्यं महाभागे कथ्यमानं मया शृणु ।\nहेमन्ते चोष्णकं  तीर्थं ग्रीष्मे भवति शीतलम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003505059, "chapter_id": 23505, "verse_number": "१४५-६०", "content_sanskrit": "गुह्यं सर्वायुधं नाम तत्र क्षेत्रे परं मम ।\nपतन्ति सप्त स्रोतांसि हिमवन्निःसृतानि वै ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003505060, "chapter_id": 23505, "verse_number": "१४५-६१", "content_sanskrit": "तत्र स्नानं प्रकुर्वीत सप्तरात्रोषितो नरः ।\nराजा भवति सुश्रोणि सवार्युधकलान्वितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003505061, "chapter_id": 23505, "verse_number": "१४५-६२", "content_sanskrit": "अथ वै मुंचते प्राणान्मम कर्माविनिश्चितः ।\nस भुक्त्वा राज्य भोज्यानि मम लोकं च गच्छति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003505062, "chapter_id": 23505, "verse_number": "१४५-६३", "content_sanskrit": "तत्र देवप्रभं नाम गुह्यं क्षेत्रं परं मम ।\nधाराः पंचमुखास्तत्र पतंति गिरिसंश्रिता ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003505063, "chapter_id": 23505, "verse_number": "१४५-६४", "content_sanskrit": "तत्र स्नानं तु कुर्वीत त्वष्टकालोषितो नरः ।\nचतुर्णामपि वेदानां याति पारं न संशयः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003505064, "chapter_id": 23505, "verse_number": "१४५-६५", "content_sanskrit": "अथात्र मुंचते प्राणाँल्लोभमोहविवर्ज्जितः ।\nवेदकर्म समुत्सृज्य मम लोके महीयते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003505065, "chapter_id": 23505, "verse_number": "१४५-६६", "content_sanskrit": "गुह्यं विद्याधरं नाम तत्र क्षेत्रं परं मम ।\nपंच धाराः पतन्त्यत्र हिमकूटविनिःसृताः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003505066, "chapter_id": 23505, "verse_number": "१४५-६७", "content_sanskrit": "यस्तत्र कुरुते स्नानं मेकरात्रोषितो नरः ।\nयाति वैद्याधरं लोकं कृतकृत्यो न संशयः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003505067, "chapter_id": 23505, "verse_number": "१४५-६८", "content_sanskrit": "अथात्र मुंचते प्राणान्वीतरागो गतक्लमः ।\nभुक्त्वा वैद्याधरान्भोगान्मम लोकं स गच्छति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003505068, "chapter_id": 23505, "verse_number": "१४५-६९", "content_sanskrit": "तत्र पुण्यनदी नाम गुह्यक्षेत्रे परे मम ।\nशिलाकुञ्जलताकीर्णा गन्धर्वाप्सरसेविता ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003505069, "chapter_id": 23505, "verse_number": "१४५-७०", "content_sanskrit": "तत्र स्नानं तु कुर्वीत अष्ट रात्रोषितो नरः ।\nसप्तद्वीपेषु भ्रमति स्वच्छंदगमनालयः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003505070, "chapter_id": 23505, "verse_number": "१४५-७१", "content_sanskrit": "अथात्र मुञ्चते प्राणान्मम कमार्नुसारकः ।\nसप्तद्वीपान् समुत्सृज्य मम लोकं स गच्छति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003505071, "chapter_id": 23505, "verse_number": "१४५-७२", "content_sanskrit": "गन्धर्वेति च विख्यातं तस्मिन् क्षेत्रं परं मम ।\nएकधारा पतत्यत्र पश्चिमां दिशमाश्रिता ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003505072, "chapter_id": 23505, "verse_number": "१४५-७३", "content_sanskrit": "तत्र स्नानं तु कुर्वीत चतूरात्रो षितो नरः ।\nमोदते लोकपालेषु स्वच्छंदगमनालयः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003505073, "chapter_id": 23505, "verse_number": "१४५-७४", "content_sanskrit": "अथात्र मुञ्चते प्राणान्ममकर्मपरायणः ।\nलोकपालान्परित्यज्य मम लोकं स गच्छति ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003505074, "chapter_id": 23505, "verse_number": "१४५-७५", "content_sanskrit": "तत्र देवह्रदं नाम मम क्षेत्रं वसुन्धरे।\nयत्र कांतासि मे भूमे बलेर्यज्ञविनाशनात् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003505075, "chapter_id": 23505, "verse_number": "१४५-७६", "content_sanskrit": "स ह्रदो वरदः श्रेष्ठो मनोज्ञः सुखशीतलः ।\nअगाधः सौख्यदश्चापि देवानामपि दुर्ल्लभः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003505076, "chapter_id": 23505, "verse_number": "१४५-७७", "content_sanskrit": "तस्मिन् ह्रदे महाभागे मम वै नियमोदके ।\nमत्स्याश्चक्रांकिताश्चैव पर्यटन्ते इतस्ततः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003505077, "chapter_id": 23505, "verse_number": "१४५-७८", "content_sanskrit": "अन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वसुंधरे ।\nमहाश्चर्यं विशालाक्षि यत्र तत्परिवर्त्तते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003505078, "chapter_id": 23505, "verse_number": "१४५-७९", "content_sanskrit": "पश्येति श्रद्दधानस्तु न पश्यत्पापपूरुषः ।\nतस्मिन्देवह्रदे पुण्यं चतुर्विंशतिर्द्वादश ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003505079, "chapter_id": 23505, "verse_number": "१४५-८०", "content_sanskrit": "सौवर्णानि च पद्मानि दृश्यन्ते भास्करोदये ।\nतावत्पश्यन्ति भूतानि यावन्मध्यन्दिनं भवेत् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003505080, "chapter_id": 23505, "verse_number": "१४५-८१", "content_sanskrit": "यत्र स्नाता दिवं यांति शुद्धा वाक्कायजैर्मलैः ।\nतत्र स्नानं प्रकुर्वीत दशरात्रोषितो नरः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003505081, "chapter_id": 23505, "verse_number": "१४५-८२", "content_sanskrit": "दशानामश्वमेधानां प्राप्नोत्यविकलं फलम् ।\nअथाऽत्र मुञ्चते प्राणान्मम चिंताव्यवस्थितः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003505082, "chapter_id": 23505, "verse_number": "१४५-८३", "content_sanskrit": "अश्वमेधफलं भुक्त्वा भूमे मत्समतां व्रजेत् ।\nअन्यच्च ते प्रवक्ष्यामि क्षेत्रं गुह्यं परं मम ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003505083, "chapter_id": 23505, "verse_number": "१४५-८४", "content_sanskrit": "संभेदो देवनद्योस्तु समस्तसुखवल्लभः ।\nदिवोऽवतीर्य तिष्ठन्ति देवा यत्र सहप्रियाः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003505084, "chapter_id": 23505, "verse_number": "१४५-८५", "content_sanskrit": "गन्धर्वाप्सरसश्चैव नागकन्याः सहोरगैः ।\nदेवर्षयश्च मुनयः समस्तसुरनायकाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003505085, "chapter_id": 23505, "verse_number": "१४५-८६", "content_sanskrit": "सिद्धाश्च किन्नराश्चैव स्वर्गादवतरन्ति हि ।\nनेपाले यच्छिवस्थानं समस्तसुखवल्लभम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003505086, "chapter_id": 23505, "verse_number": "१४५-८७", "content_sanskrit": "तेभ्यस्तेभ्यश्च स्थानेभ्यस्तीर्थेभ्यश्च विशेषतः ।\nमहादेवजटाजूटान्नीलकण्ठाच्छिवालयः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003505087, "chapter_id": 23505, "verse_number": "१४५-८८", "content_sanskrit": "श्वतेगंगेति या प्रोक्ता तया संभूय सादरम् ।\nनाना नद्यः समायाता दृश्यादृश्यतया स्थिताः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003505088, "chapter_id": 23505, "verse_number": "१४५-८९", "content_sanskrit": "गण्डक्या कृष्णया चैव या कृष्णस्य तनूद्भवा ।\nतया संभेदमापन्ना या सा शिवतनूद्भवा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003505089, "chapter_id": 23505, "verse_number": "१४५-९०", "content_sanskrit": "त्रिशूलगंगेत्याख्याता सापि तत्र महानदी ।\nएवं नदीसमुद्भेदः सर्वतीर्थकदंबकम् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003505090, "chapter_id": 23505, "verse_number": "१४५-९१", "content_sanskrit": "मम क्षेत्रे समाख्यातं पुण्यं परमपावनम् ।\nवसुधे त्वं विजानीहि देवानामपि दुर्ल्लभम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003505091, "chapter_id": 23505, "verse_number": "१४५-९२", "content_sanskrit": "यच्च सिद्धाश्रम इति विख्यातः पुण्यवर्द्धनः ।\nशंभोस्तपोवनं तत्र सर्वाश्रमवरं प्रति ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003505092, "chapter_id": 23505, "verse_number": "१४५-९३", "content_sanskrit": "नानापुष्पफलोपेतं कदलीषण्डमण्डितम् ।\nनिचुलैश्चैव पुन्नागैः केसरैश्च विराजितम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003505093, "chapter_id": 23505, "verse_number": "१४५-९४", "content_sanskrit": "खर्ज्जूराशोकबकुलैश्चूतैश्चैव प्रियालकैः ।\nनारिकेलैश्च पूगैश्च चंपकैर्जंबुभिर्धवैः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003505094, "chapter_id": 23505, "verse_number": "१४५-९५", "content_sanskrit": "नारंगैर्बदरीभिश्च जंबीरैर्मातुलुंगकैः ।\nकेतकीमल्लिकाजातीयूथिकाराजिराजितम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003505095, "chapter_id": 23505, "verse_number": "१४५-९६", "content_sanskrit": "कुन्दैः कुरवकैर्नागैः कुटजैर्दाडिमैरपि ।\nआगत्य यत्र क्रीडन्ति देवानां मिथुनानि च ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003505096, "chapter_id": 23505, "verse_number": "१४५-९७", "content_sanskrit": "तस्मिन्ह्रदे महापुण्ये पुण्यनद्योस्तु संगमे ।\nस्नानाच्छताश्वमेधानां फलं प्राप्नोति मानवः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003505097, "chapter_id": 23505, "verse_number": "१४५-९८", "content_sanskrit": "स्नात्वा तत्र तु वैशाखे गोसहस्रफलं भवेत् ।\nमाघमासे पुनः स्नात्वा प्रयागस्नानजं फलम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003505098, "chapter_id": 23505, "verse_number": "१४५-९९", "content_sanskrit": "कार्त्तिके मासि यः स्नाति तुलासंस्थे दिवाकरे ।\nविधिना नियतः सोऽपि मुक्तिभागी न संशयः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003505099, "chapter_id": 23505, "verse_number": "१४५-१००", "content_sanskrit": "यस्त्रिरात्रमुषित्वा तु नियते नियता शनः ।\nराजसूयफलं प्राप्य मोदते देववद्दिवि ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003505100, "chapter_id": 23505, "verse_number": "१४५-१०१", "content_sanskrit": "यज्ञस्तपोऽथवा दानं श्राद्धमिष्टस्य पूजनम् ।\nयत्किंचित्क्रियते कर्म तदनन्तफलं भवेत् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003505101, "chapter_id": 23505, "verse_number": "१४५-१०२", "content_sanskrit": "भूमे तस्यापराधांश्च सर्वानेव क्षमाम्यहम् ।\nगंगायमुनयोर्यद्वत्संगमो मर्त्त्यदुर्ल्लभः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003505102, "chapter_id": 23505, "verse_number": "१४५-१०३", "content_sanskrit": "तथैवायं देवनद्यो संगमः समुदाहृतः ।\nएतद्गुह्यं परं देवि मम क्षेत्रे वसुन्धरे ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003505103, "chapter_id": 23505, "verse_number": "१४५-१०४", "content_sanskrit": "अहमस्मिन्महाक्षेत्रे धरे पूर्वमुखः स्थितः ।\nशालग्रामे महाक्षेत्रे भूमे भागवत प्रियः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003505104, "chapter_id": 23505, "verse_number": "१४५-१०५", "content_sanskrit": "अन्यच्च ते प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nअन्तर्गुह्यं परं श्रेष्ठं यन्न जानन्ति मोहिताः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003505105, "chapter_id": 23505, "verse_number": "१४५-१०६", "content_sanskrit": "शिवो मे दक्षिणस्थाने तिष्ठन्वै विगतज्वरः ।\nलोकानां प्रवरः श्रेष्ठः सर्वलोकवरो हरः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003505106, "chapter_id": 23505, "verse_number": "१४५-१०७", "content_sanskrit": "तं ये विन्दन्ति ते देवि नूनं मामेव विन्दति ।\nये मां विदन्ति देवेशि ते विदन्ति शिवं परम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003505107, "chapter_id": 23505, "verse_number": "१४५-१०८", "content_sanskrit": "अहं यत्र शिवस्तत्र शिवो यत्र वसुन्धरे ।\nतत्राहमपि तिष्ठामि आवयोर्नान्तरं क्वचित् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003505108, "chapter_id": 23505, "verse_number": "१४५-१०९", "content_sanskrit": "शिवं यो वन्दते भूमे स हि मामेव वन्दते ।\nलभते पुष्कलां सिद्धिमेवं यो वेत्ति तत्त्वतः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003505109, "chapter_id": 23505, "verse_number": "१४५-११०", "content_sanskrit": "एवमेतन्महाभागे क्षेत्रं हरिहरात्मकम् ।\nमृता येऽत्र गतिं यान्ति मम कर्मानुसारिणः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003505110, "chapter_id": 23505, "verse_number": "१४५-१११", "content_sanskrit": "मुक्तिक्षेत्रं प्रथमतो रुरुखण्डं ततः परम् ।\nसंभेदो देवनद्योश्च त्रिवेणी च ततः परम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003505111, "chapter_id": 23505, "verse_number": "१४५-११२", "content_sanskrit": "क्षेत्रं प्रमाणं विज्ञेयं गण्डकी सङ्गतं परम् ।\nएवं सा गण्डकी देवि नदीनामुत्तमा नदी ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003505112, "chapter_id": 23505, "verse_number": "१४५-११३", "content_sanskrit": "गङ्गया मिलिता यत्र भागीरथ्या महाफला ।\nअपरं तन्महत्क्षेत्रं हरिक्षेत्रमिति स्मृतम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003505113, "chapter_id": 23505, "verse_number": "१४५-११४", "content_sanskrit": "आदौ सा गण्डकी पुण्या भागीरथ्या च सङ्गता ।\nतस्य तीर्थस्य महिमा ज्ञायते न सुरैरपि ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003505114, "chapter_id": 23505, "verse_number": "१४५-११५", "content_sanskrit": "एतत्ते कथितं भद्रे शालग्रामस्य सुन्दरि ।\nगण्डक्याश्चैव माहात्म्यं सर्वकल्मषनाशनम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003505115, "chapter_id": 23505, "verse_number": "१४५-११६", "content_sanskrit": "पूर्वपृष्टं तया यच्च पुण्यं भागवतप्रियम् ।\nआख्यानानां महाख्यानं द्युतीनां परमा द्युतिः ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003505116, "chapter_id": 23505, "verse_number": "१४५-११७", "content_sanskrit": "पुण्यानां परमं पुण्यं तपसां च महत्तपः ।\nगुह्यानां परमं गुह्यं गतीनां परमा गतिः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003505117, "chapter_id": 23505, "verse_number": "१४५-११८", "content_sanskrit": "महालाभस्तु लाभानां नास्त्यस्मादपरं महत् ।\nपिशुनाय न दातव्यं न शठाय गुरुद्रुहे ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003505118, "chapter_id": 23505, "verse_number": "१४५-११९", "content_sanskrit": "ये च पापाः कृतघ्नाश्च द्विजदेवापराधिनः ।\nकुशिष्याय न दातव्यं न दद्याच्छास्त्रदूषके ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003505119, "chapter_id": 23505, "verse_number": "१४५-१२०", "content_sanskrit": "नीचाय न च दातव्यं ये न जानन्ति सेवितुम् ।\nसुशिष्याय च दातव्यं धीराय शुभ बुद्धये ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003505120, "chapter_id": 23505, "verse_number": "१४५-१२१", "content_sanskrit": "लोभमोहमदाद्यैर्ये वर्जिताः पुण्यबुद्धयः ।\nय एतत्पठते नित्यं कल्यमुत्थाय मानवः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003505121, "chapter_id": 23505, "verse_number": "१४५-१२२", "content_sanskrit": "कुलानि तारितान्येवं सप्त सप्त च सप्त च ।\nएवं मरणकाले तु न कदाचिद्विमुह्यते ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003505122, "chapter_id": 23505, "verse_number": "१४५-१२३", "content_sanskrit": "यदीच्छेत्परमां सिद्धिं मम लोकं स गच्छति ।\nक्षेत्रस्य शालग्रामस्य माहात्म्यं परमं मया ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003505123, "chapter_id": 23505, "verse_number": "१४५-१२४", "content_sanskrit": "कथितं ते महादेवि किमन्यच्छ्रोतुमिच्छसि ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}]