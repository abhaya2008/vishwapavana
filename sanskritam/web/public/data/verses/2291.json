[{"id": 2060327, "chapter_id": 2291, "verse_number": "८-१२-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060328, "chapter_id": 2291, "verse_number": "८-१२-१", "content_sanskrit": "भीमसेनं ततो द्रौणी राजन्विव्याध पत्रिणा।\nपरया त्वरया युक्तो दर्शयन्नस्त्रलाघवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060329, "chapter_id": 2291, "verse_number": "८-१२-२", "content_sanskrit": "अथैनं पुनराजघ्ने नवत्या निशितैः शरैः।\nसर्वमर्माणि सम्प्रेक्ष्य मर्मज्ञो लघुहस्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060330, "chapter_id": 2291, "verse_number": "८-१२-३", "content_sanskrit": "भीमसेनः समाकीर्णो द्रौणिना निशितैः शरैः।\nरराज समरे राजन्रश्मिवानिव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060331, "chapter_id": 2291, "verse_number": "८-१२-४", "content_sanskrit": "ततः शरसहस्रेण सुप्रयुक्तेन पाण्डवः।\nद्रोणपुत्रमवच्छाद्य सिंहनादममुञ्चत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060332, "chapter_id": 2291, "verse_number": "८-१२-५", "content_sanskrit": "शरैः सरांस्ततो द्रौणिः संवार्य युधि पाण्डवम्।\nललाटेऽभ्याहनद्राजन्नाराचेन स्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060333, "chapter_id": 2291, "verse_number": "८-१२-६", "content_sanskrit": "ललाटस्थं ततो बाणं धारयामास पाण्डवः।\nयथा शृङ्गं वने दृप्तः खङ्गो धारयते नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060334, "chapter_id": 2291, "verse_number": "८-१२-७", "content_sanskrit": "ततो द्रौणिं रणे भीमो यतमानं पराक्रमी।\nत्रिभिर्विव्याध नाराचैर्ललाटे विस्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060335, "chapter_id": 2291, "verse_number": "८-१२-८", "content_sanskrit": "ललाटस्थैस्ततो बाणैर्ब्राह्मणोऽसौ व्यशोभत।\nप्रावृषीव यथा सिक्तस्त्रिशृङ्गः पर्वतोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060336, "chapter_id": 2291, "verse_number": "८-१२-९", "content_sanskrit": "ततः शरशतैर्द्रौणिरर्दयामास पाण्डवम्।\nन चैनं कम्पयामास मातरिश्वेव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060337, "chapter_id": 2291, "verse_number": "८-१२-१०", "content_sanskrit": "तथैव पांण्डवो युद्धे द्रौणिं शरशतैः शितैः।\nनाकम्पयत संहृष्टो वार्योध इव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060338, "chapter_id": 2291, "verse_number": "८-१२-११", "content_sanskrit": "तावन्योन्यं शरैर्घोरैश्छादयानौ महारथौ।\nरथवर्यगतौ वीरौ शुशुभाते बलोत्कटौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060339, "chapter_id": 2291, "verse_number": "८-१२-१२", "content_sanskrit": "आदित्याविव सन्दीप्तौ लोकक्षयकरावुभौ।\nस्वरश्मिभिरिवान्योन्यं तापयन्तौ शरोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060340, "chapter_id": 2291, "verse_number": "८-१२-१३", "content_sanskrit": "ततः प्रविकृते यत्नं कुर्वाणौ तौ महारणे।\nकृतप्रतिकृते यत्तौ शरसङ्घैरभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060341, "chapter_id": 2291, "verse_number": "८-१२-१४", "content_sanskrit": "व्याघ्राविव च सङ्ग्रामे चेरतुस्तौ नरोत्तमौ।\nशरदंष्ट्रौ दुराधर्षौ चापवक्रौ भयङ्करौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060342, "chapter_id": 2291, "verse_number": "८-१२-१५", "content_sanskrit": "अभूतां तावदृश्यौ च शरजालैः समन्ततः।\nमेघजालैरिव च्छनौ गगने चन्द्रभास्करौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060343, "chapter_id": 2291, "verse_number": "८-१२-१६", "content_sanskrit": "चकाशेते मुहूर्तेन ततस्तावप्यरिन्दमौ।\nविमुक्तावभ्रजालेन अङ्गारकबुधाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060344, "chapter_id": 2291, "verse_number": "८-१२-१७", "content_sanskrit": "अथ तत्रैव सङ्ग्रमे वर्तमाने सुदारुणे।\nअपसव्यं ततश्चक्रे द्रौणिस्तत्र वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060345, "chapter_id": 2291, "verse_number": "८-१२-१८", "content_sanskrit": "किरञ्छरशतैरुग्रैर्धाराभिरिव पर्वतम्।\nन तु तन्ममृषे भीमः शत्रोर्विजलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060346, "chapter_id": 2291, "verse_number": "८-१२-१९", "content_sanskrit": "प्रतिचक्रे ततो राजन्पाण्डवोऽप्यपसव्यतः।\nमण्डलानां विभागेन गतप्रत्यागतेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060347, "chapter_id": 2291, "verse_number": "८-१२-२०", "content_sanskrit": "बभूव तुमुलं युद्धं तयोः पुरुषसिंहयोः।\nचरित्वा विविधान्मार्गान्मण्डलस्थानमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060348, "chapter_id": 2291, "verse_number": "८-१२-२१", "content_sanskrit": "शरैः पूर्णायतोत्सृष्टैरन्योन्यमभिजघ्नतुः।\nअन्योन्यस्य वधे चैव चक्रतुर्यत्नमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060349, "chapter_id": 2291, "verse_number": "८-१२-२२", "content_sanskrit": "ईषतुर्विरथं चैव कर्तुमन्योन्यमाहवे।\nततो द्रौणिर्महास्त्राणि प्रादुश्चक्रे महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060350, "chapter_id": 2291, "verse_number": "८-१२-२३", "content_sanskrit": "तान्यस्त्रैरेव समरे प्रतिजघ्नेऽथ पाण्डवः।\nततो घोरं महाराज अस्त्रयुद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060351, "chapter_id": 2291, "verse_number": "८-१२-२४", "content_sanskrit": "ग्रहयुद्वं यथा घोरं प्रजासंहरणे ह्यभूत्।\nते वाणाः समसज्जन्त मुक्तास्ताभ्यां तु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060352, "chapter_id": 2291, "verse_number": "८-१२-२५", "content_sanskrit": "द्योतग्रन्तो दिशः सर्वास्तव सैन्यं समन्ततः।\nबाणसङ्घैर्वृतं घोरमाकाशं समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060353, "chapter_id": 2291, "verse_number": "८-१२-२६", "content_sanskrit": "उल्कापातावृतं युद्धं प्रजानां संक्षये नृप।\nबाणाभिघातात्सञ्जज्ञे तत्र भारत पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060354, "chapter_id": 2291, "verse_number": "८-१२-२७", "content_sanskrit": "सविस्फुलिङ्गो दीप्तार्चिर्योऽदहद्वाहिनीद्वयम्।\nतत्र सिद्धा महाराज सम्पतन्तोऽब्रुवन्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060355, "chapter_id": 2291, "verse_number": "८-१२-२८", "content_sanskrit": "युद्धानामति सर्वेषां युद्धमेतदिति प्रभो।\nसर्वयुद्धानि चैतस्य कलां नार्हन्ति षोडशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060356, "chapter_id": 2291, "verse_number": "८-१२-२९", "content_sanskrit": "नेदृशं च पुनर्युद्धं भविष्यति कदाचन।\nअहो ज्ञानेन सम्पन्नावुभ ब्राह्मणक्षत्रियौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060357, "chapter_id": 2291, "verse_number": "८-१२-३०", "content_sanskrit": "अहो शौर्येण सम्पन्नावुभौ चोग्रपराक्रमौ।\nअहो भीमबलो भीम एतस्य च कृतास्त्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060358, "chapter_id": 2291, "verse_number": "८-१२-३१", "content_sanskrit": "अहो वीर्यस्य सारत्वमहो सौष्ठवमेतयोः।\nस्थितावेतौ हि समरे कालान्तकयमोपमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060359, "chapter_id": 2291, "verse_number": "८-१२-३२", "content_sanskrit": "रुद्रौ द्वावि सम्भूतौ यथा द्वाविव भास्करौ।\nयमौ वा पुरुषव्याघ्रौ घोररूपावुभौ रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060360, "chapter_id": 2291, "verse_number": "८-१२-३३", "content_sanskrit": "इति वाचः स्म श्रूयन्ते सिद्धानां वै मुहुर्मुहुः।\nसिंहनादश्च सञ्जज्ञे समेतानां दिवौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060361, "chapter_id": 2291, "verse_number": "८-१२-३४", "content_sanskrit": "अद्भुतं चाप्यचिन्त्यं च दृष्ट्वा कर्म तयो रणे।\nसिद्वचारणसङ्घानां विस्मयः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060362, "chapter_id": 2291, "verse_number": "८-१२-३५", "content_sanskrit": "प्रशंसन्ति तदा देवाः सिद्वाश्च परमर्षयः।\nसाधु द्रौणे महाबाहो साधु भीमेति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060363, "chapter_id": 2291, "verse_number": "८-१२-३६", "content_sanskrit": "तौ शूरौ समरे राजन्परस्परकृतागसौ।\nपरस्परमुदीक्षेतां क्रोधादुद्वृत्य चक्षुषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060364, "chapter_id": 2291, "verse_number": "८-१२-३७", "content_sanskrit": "क्रोधरक्तेक्षणौ तौ तु क्रोधात्प्रस्फुरिताधरौ।\nक्रोधात्संदष्टदशनौ तथैव दशनच्छदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060365, "chapter_id": 2291, "verse_number": "८-१२-३८", "content_sanskrit": "अन्योन्यं छादयन्तौ स्म शरवृष्ट्या महारथौ।\nशराम्बुधारो समरे शस्त्रविद्युत्प्रकाशिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060366, "chapter_id": 2291, "verse_number": "८-१२-३९", "content_sanskrit": "तावन्यन्यं ध्वजं विद्व्वा सारथिं च महारणे।\nअन्योन्यस्य हयान्विद्वा बिभिदाते परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060367, "chapter_id": 2291, "verse_number": "८-१२-४०", "content_sanskrit": "ततः क्रुद्धौ महाराज बाणौ गृह्य महाहवे।\nउभौ चिक्षिपतुस्तूर्ममन्योन्यस्य वधैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060368, "chapter_id": 2291, "verse_number": "८-१२-४१", "content_sanskrit": "तौ सायकौ महाराज द्योतमानौ चमूमुखे।\nआजघ्नतुः समासाद्य वज्रवेगौ दुरासदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060369, "chapter_id": 2291, "verse_number": "८-१२-४२", "content_sanskrit": "तौ परस्परवेगाच्च शराभ्यां च भृशाहतौ।\nनिपेततुर्महावीर्यौ रथोपस्थे तयोस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060370, "chapter_id": 2291, "verse_number": "८-१२-४३", "content_sanskrit": "ततस्तु सारथिर्ज्ञात्वा द्रोणपुत्रमचेतनम्।\nअपोवाह रणाद्राजन्सर्वसैन्यस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060371, "chapter_id": 2291, "verse_number": "", "content_sanskrit": "तथैव पाण्डवं राजन्विह्वलन्तं मुहुर्मुहुः।\nअपोवाह रथेनाजौ विशोकः शत्रुतापनम्॥ ॥ *इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धे द्वादशोऽध्यायः॥ १२ ॥ *.झ. पन्तके एतदनन्तरं स्थिताः सप्ताध्याया एतत्पाठे क्रमेण ५२-५३-५४-५५-५६-५९-६० तमाध्यायतया वर्तन्ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]