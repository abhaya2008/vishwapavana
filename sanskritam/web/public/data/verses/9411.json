[{"id": 5000411000, "chapter_id": 9411, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000411001, "chapter_id": 9411, "verse_number": "६-४-१", "content_sanskrit": "श्रुत्वा हनूमतो वाक्यं यथावदनुपूर्वशः।\nततोऽब्रवीन्महातेजा रामः सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000411002, "chapter_id": 9411, "verse_number": "६-४-२", "content_sanskrit": "यन्निवेदयसे लङ्कां पुरीं भीमस्य रक्षसः।\nक्षिप्रमेनां वधिष्यामि सत्यमेतद् ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000411003, "chapter_id": 9411, "verse_number": "६-४-३", "content_sanskrit": "अस्मिन् मुहूर्ते सुग्रीव प्रयाणमभिरोचय।\nयुक्तो मुहूर्ते विजये प्राप्तो मध्यं दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000411004, "chapter_id": 9411, "verse_number": "६-४-४", "content_sanskrit": "सीतां हृत्वा तु तद् यातु क्वासौ यास्यति जीवितः।\nसीता श्रुत्वाभियानं मे आशामेष्यति जीविते।\nजीवितान्तेऽमृतं स्पृष्ट्वा पीत्वामृतमिवातुरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000411005, "chapter_id": 9411, "verse_number": "६-४-५", "content_sanskrit": "उत्तराफाल्गुनी ह्यद्य श्वस्तु हस्तेन योक्ष्यते।\nअभिप्रयाम सुग्रीव सर्वानीकसमावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000411006, "chapter_id": 9411, "verse_number": "६-४-६", "content_sanskrit": "निमित्तानि च पश्यामि यानि प्रादुर्भवन्ति वै।\nनिहत्य रावणं सीतामानयिष्यामि जानकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000411007, "chapter_id": 9411, "verse_number": "६-४-७", "content_sanskrit": "उपरिष्टाद्धि नयनं स्फुरमाणमिमं मम।\nविजयं समनुप्राप्तं शंसतीव मनोरथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000411008, "chapter_id": 9411, "verse_number": "६-४-८", "content_sanskrit": "ततो वानरराजेन लक्ष्मणेन सुपूजितः।\nउवाच रामो धर्मात्मा पुनरप्यर्थकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000411009, "chapter_id": 9411, "verse_number": "६-४-९", "content_sanskrit": "अग्रे यातु बलस्यास्य नीलो मार्गमवेक्षितुम्।\nवृतः शतसहस्रेण वानराणां तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000411010, "chapter_id": 9411, "verse_number": "६-४-१०", "content_sanskrit": "फलमूलवता नील शीतकाननवारिणा।\nपथा मधुमता चाशु सेनां सेनापते नय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000411011, "chapter_id": 9411, "verse_number": "६-४-११", "content_sanskrit": "दूषयेयुर्दुरात्मानः पथि मूलफलोदकम्।\nराक्षसाः पथि रक्षेथास्तेभ्यस्त्वं नित्यमुद्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000411012, "chapter_id": 9411, "verse_number": "६-४-१२", "content_sanskrit": "निम्नेषु वनदुर्गेषु वनेषु च वनौकसः।\nअभिप्लुत्याभिपश्येयुः परेषां निहितं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000411013, "chapter_id": 9411, "verse_number": "६-४-१३", "content_sanskrit": "यत्तु फल्गु बलं किंचित् तदत्रैवोपपद्यताम्।\nएतद्धि कृत्यं घोरं नो विक्रमेण प्रयुज्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000411014, "chapter_id": 9411, "verse_number": "६-४-१४", "content_sanskrit": "सागरौघनिभं भीममग्रानीकं महाबलाः।\nकपिसिंहाः प्रकर्षन्तु शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000411015, "chapter_id": 9411, "verse_number": "६-४-१५", "content_sanskrit": "गजश्च गिरिसंकाशो गवयश्च महाबलः।\nगवाक्षश्चाग्रतो यातु गवां दृप्त इवर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000411016, "chapter_id": 9411, "verse_number": "६-४-१६", "content_sanskrit": "यातु वानरवाहिन्या वानरः प्लवतां पतिः।\nपालयन् दक्षिणं पार्श्वमृषभो वानरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000411017, "chapter_id": 9411, "verse_number": "६-४-१७", "content_sanskrit": "गन्धहस्तीव दुर्धर्षस्तरस्वी गन्धमादनः।\nयातु वानरवाहिन्याः सव्यं पार्श्वमधिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000411018, "chapter_id": 9411, "verse_number": "६-४-१८", "content_sanskrit": "यास्यामि बलमध्येऽहं बलौघमभिहर्षयन्।\nअधिरुह्य हनूमन्तमैरावतमिवेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000411019, "chapter_id": 9411, "verse_number": "६-४-१९", "content_sanskrit": "अङ्गदेनैष संयातु लक्ष्मणश्चान्तकोपमः।\nसार्वभौमेन भूतेशो द्रविणाधिपतिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000411020, "chapter_id": 9411, "verse_number": "६-४-२०", "content_sanskrit": "जाम्बवांश्च सुषेणश्च वेगदर्शी च वानरः।\nऋक्षराजो महाबाहुः कुक्षिं रक्षन्तु ते त्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000411021, "chapter_id": 9411, "verse_number": "६-४-२१", "content_sanskrit": "राघवस्य वचः श्रुत्वा सुग्रीवो वाहिनीपतिः।\nव्यादिदेश महावीर्यो वानरान् वानरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000411022, "chapter_id": 9411, "verse_number": "६-४-२२", "content_sanskrit": "ते वानरगणाः सर्वे समुत्पत्य महौजसः।\nगुहाभ्यः शिखरेभ्यश्च आशु पुप्लुविरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000411023, "chapter_id": 9411, "verse_number": "६-४-२३", "content_sanskrit": "ततो वानरराजेन लक्ष्मणेन च पूजितः।\nजगाम रामो धर्मात्मा ससैन्यो दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000411024, "chapter_id": 9411, "verse_number": "६-४-२४", "content_sanskrit": "शतैः शतसहस्रैश्च कोटिभिश्चायुतैरपि।\nवारणाभैश्च हरिभिर्ययौ परिवृतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000411025, "chapter_id": 9411, "verse_number": "६-४-२५", "content_sanskrit": "तं यान्तमनुयान्ती सा महती हरिवाहिनी।\nहृष्टाः प्रमुदिताः सर्वे सुग्रीवेणापि पालिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000411026, "chapter_id": 9411, "verse_number": "६-४-२६", "content_sanskrit": "आप्लवन्तः प्लवन्तश्च गर्जन्तश्च प्लवंगमाः।\nक्ष्वेलन्तो निनदन्तश्च जग्मुर्वै दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000411027, "chapter_id": 9411, "verse_number": "६-४-२७", "content_sanskrit": "भक्षयन्तः सुगन्धीनि मधूनि च फलानि च।\nउद्वहन्तो महावृक्षान् मञ्जरीपुञ्जधारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000411028, "chapter_id": 9411, "verse_number": "६-४-२८", "content_sanskrit": "अन्योन्यं सहसा दृप्ता निर्वहन्ति क्षिपन्ति च।\nपतन्तश्चोत्पतन्त्यन्ये पातयन्त्यपरे परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000411029, "chapter_id": 9411, "verse_number": "६-४-२९", "content_sanskrit": "रावणो नो निहन्तव्यः सर्वे च रजनीचराः।\nइति गर्जन्ति हरयो राघवस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000411030, "chapter_id": 9411, "verse_number": "६-४-३०", "content_sanskrit": "पुरस्तादृषभो नीलो वीरः कुमुद एव च।\nपन्थानं शोधयन्ति स्म वानरैर्बहुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000411031, "chapter_id": 9411, "verse_number": "६-४-३१", "content_sanskrit": "मध्ये तु राजा सुग्रीवो रामो लक्ष्मण एव च।\nबलिभिर्बहुभिर्भीमैर्वृतः शत्रुनिबर्हणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000411032, "chapter_id": 9411, "verse_number": "६-४-३२", "content_sanskrit": "हरिः शतबलिर्वीरः कोटिभिर्दशभिर्वृतः।\nसर्वामेको ह्यवष्टभ्य ररक्ष हरिवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000411033, "chapter_id": 9411, "verse_number": "६-४-३३", "content_sanskrit": "कोटीशतपरीवारः केसरी पनसो गजः।\nअर्कश्च बहुभिः पार्श्वमेकं तस्याभिरक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000411034, "chapter_id": 9411, "verse_number": "६-४-३४", "content_sanskrit": "सुषेणो जाम्बवांश्चैव ऋक्षैर्बहुभिरावृतौ।\nसुग्रीवं पुरतः कृत्वा जघनं संररक्षतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000411035, "chapter_id": 9411, "verse_number": "६-४-३५", "content_sanskrit": "तेषां सेनापतिर्वीरो नीलो वानरपुंगवः।\nसम्पतन् प्लवतां श्रेष्ठस्तद् बलं पर्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000411036, "chapter_id": 9411, "verse_number": "६-४-३६", "content_sanskrit": "दरीमुखः प्रजङ्घश्च जम्भोऽथ रभसः कपिः।\nसर्वतश्च ययुर्वीरास्त्वरयन्तः प्लवंगमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000411037, "chapter_id": 9411, "verse_number": "६-४-३७", "content_sanskrit": "एवं ते हरिशार्दूला गच्छन्ति बलदर्पिताः।\nअपश्यन्त गिरिश्रेष्ठं सह्यं गिरिशतायुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000411038, "chapter_id": 9411, "verse_number": "६-४-३८", "content_sanskrit": "सरांसि च सुफुल्लानि तटाकानि वराणि च।\nरामस्य शासनं ज्ञात्वा भीमकोपस्य भीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000411039, "chapter_id": 9411, "verse_number": "६-४-३९", "content_sanskrit": "वर्जयन् नागराभ्याशांस्तथा जनपदानपि।\nसागरौघनिभं भीमं तद् वानरबलं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000411040, "chapter_id": 9411, "verse_number": "६-४-४०", "content_sanskrit": "निःससर्प महाघोरं भीमघोषमिवार्णवम्।\nतस्य दाशरथेः पार्श्वे शूरास्ते कपिकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000411041, "chapter_id": 9411, "verse_number": "६-४-४१", "content_sanskrit": "तूर्णमापुप्लुवुः सर्वे सदश्वा इव चोदिताः।\nकपिभ्यामुह्यमानौ तौ शुशुभाते नरर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000411042, "chapter_id": 9411, "verse_number": "६-४-४२", "content_sanskrit": "महद्भ्यामिव संस्पृष्टौ ग्रहाभ्यां चन्द्रभास्करौ।\nततो वानरराजेन लक्ष्मणेन सुपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000411043, "chapter_id": 9411, "verse_number": "६-४-४३", "content_sanskrit": "जगाम रामो धर्मात्मा ससैन्यो दक्षिणां दिशम्।\nतमङ्गदगतो रामं लक्ष्मणः शुभया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000411044, "chapter_id": 9411, "verse_number": "६-४-४४", "content_sanskrit": "उवाच परिपूर्णार्थं पूर्णार्थप्रतिभानवान्।\nहृतामवाप्य वैदेहीं क्षिप्रं हत्वा च रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000411045, "chapter_id": 9411, "verse_number": "६-४-४५", "content_sanskrit": "समृद्धार्थः समृद्धार्थामयोध्यां प्रतियास्यसि।\nमहान्ति च निमित्तानि दिवि भूमौ च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000411046, "chapter_id": 9411, "verse_number": "६-४-४६", "content_sanskrit": "शुभानि तव पश्यामि सर्वाण्येवार्थसिद्धये।\nअनुवाति शिवो वायुः सेनां मृदुहितः सुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000411047, "chapter_id": 9411, "verse_number": "६-४-४७", "content_sanskrit": "पूर्णवल्गुस्वराश्चेमे प्रवदन्ति मृगद्विजाः।\nप्रसन्नाश्च दिशः सर्वा विमलश्च दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000411048, "chapter_id": 9411, "verse_number": "६-४-४८", "content_sanskrit": "उशना च प्रसन्नार्चिरनु त्वां भार्गवो गतः।\nब्रह्मराशिर्विशुद्धश्च शुद्धाश्च परमर्षयः।\nअर्चिष्मन्तः प्रकाशन्ते ध्रुवं सर्वे प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000411049, "chapter_id": 9411, "verse_number": "६-४-४९", "content_sanskrit": "त्रिशङ्कुर्विमलो भाति राजर्षिः सपुरोहितः।\nपितामहः पुरोऽस्माकमिक्ष्वाकूणां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000411050, "chapter_id": 9411, "verse_number": "६-४-५०", "content_sanskrit": "विमले च प्रकाशेते विशाखे निरुपद्रवे।\nनक्षत्रं परमस्माकमिक्ष्वाकूणां महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000411051, "chapter_id": 9411, "verse_number": "६-४-५१", "content_sanskrit": "नैर्ऋतं नैर्ऋतानां च नक्षत्रमतिपीड्यते।\nमूलो मूलवता स्पृष्टो धूप्यते धूमकेतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000411052, "chapter_id": 9411, "verse_number": "६-४-५२", "content_sanskrit": "सर्वं चैतद् विनाशाय राक्षसानामुपस्थितम्।\nकाले कालगृहीतानां नक्षत्रं ग्रहपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000411053, "chapter_id": 9411, "verse_number": "६-४-५३", "content_sanskrit": "प्रसन्नाः सुरसाश्चापो वनानि फलवन्ति च।\nप्रवान्ति नाधिका गन्धा यथर्तुकुसुमा द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000411054, "chapter_id": 9411, "verse_number": "६-४-५४", "content_sanskrit": "व्यूढानि कपिसैन्यानि प्रकाशन्तेऽधिकं प्रभो।\nदेवानामिव सैन्यानि संग्रामे तारकामये।\nएवमार्य समीक्ष्यैतत् प्रीतो भवितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000411055, "chapter_id": 9411, "verse_number": "६-४-५५", "content_sanskrit": "इति भ्रातरमाश्वास्य हृष्टः सौमित्रिरब्रवीत्।\nअथावृत्य महीं कृत्स्नां जगाम हरिवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000411056, "chapter_id": 9411, "verse_number": "६-४-५६", "content_sanskrit": "ऋक्षवानरशार्दूलैर्नखद्रंष्ट्रायुधैरपि।\nकराग्रैश्चरणाग्रैश्च वानरैरुद्धतं रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000411057, "chapter_id": 9411, "verse_number": "६-४-५७", "content_sanskrit": "भीममन्तर्दधे लोकं निवार्य सवितुः प्रभाम्।\nसपर्वतवनाकाशं दक्षिणां हरिवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000411058, "chapter_id": 9411, "verse_number": "६-४-५८", "content_sanskrit": "छादयन्ती ययौ भीमा द्यामिवाम्बुदसंततिः।\nउत्तरन्त्याश्च सेनायाः सततं बहुयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000411059, "chapter_id": 9411, "verse_number": "६-४-५९", "content_sanskrit": "नदीस्रोतांसि सर्वाणि सस्यन्दुर्विपरीतवत्।\nसरांसि विमलाम्भांसि द्रुमाकीर्णांश्च पर्वतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000411060, "chapter_id": 9411, "verse_number": "६-४-६०", "content_sanskrit": "समान् भूमिप्रदेशांश्च वनानि फलवन्ति च।\nमध्येन च समन्ताच्च तिर्यक् चाधश्च साविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000411061, "chapter_id": 9411, "verse_number": "६-४-६१", "content_sanskrit": "समावृत्य महीं कृत्स्नां जगाम महती चमूः।\nते हृष्टवदनाः सर्वे जग्मुर्मारुतरंहसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000411062, "chapter_id": 9411, "verse_number": "६-४-६२", "content_sanskrit": "हरयो राघवस्यार्थे समारोपितविक्रमाः।\nहर्षं वीर्यं बलोद्रेकान् दर्शयन्तः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000411063, "chapter_id": 9411, "verse_number": "६-४-६३", "content_sanskrit": "यौवनोत्सेकजाद् दर्पाद् विविधांश्चक्रुरध्वनि।\nतत्र केचिद् द्रुतं जग्मुरुत्पेतुश्च तथापरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000411064, "chapter_id": 9411, "verse_number": "६-४-६४", "content_sanskrit": "केचित् किलकिलां चक्रुर्वानरा वनगोचराः।\nप्रास्फोटयंश्च पुच्छानि संनिजघ्नुः पदान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000411065, "chapter_id": 9411, "verse_number": "६-४-६५", "content_sanskrit": "भुजान् विक्षिप्य शैलांश्च द्रुमानन्ये बभञ्जिरे।\nआरोहन्तश्च शृङ्गाणि गिरीणां गिरिगोचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000411066, "chapter_id": 9411, "verse_number": "६-४-६६", "content_sanskrit": "महानादान् प्रमुञ्चन्ति क्ष्वेडामन्ये प्रचक्रिरे।\nऊरुवेगैश्च ममृदुर्लताजालान्यनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000411067, "chapter_id": 9411, "verse_number": "६-४-६७", "content_sanskrit": "जृम्भमाणाश्च विक्रान्ता विचिक्रीडुः शिलाद्रुमैः।\nततः शतसहस्रैश्च कोटिभिश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000411068, "chapter_id": 9411, "verse_number": "६-४-६८", "content_sanskrit": "वानराणां सुघोराणां श्रीमत्परिवृता मही।\nसा स्म याति दिवारात्रं महती हरिवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000411069, "chapter_id": 9411, "verse_number": "६-४-६९", "content_sanskrit": "प्रहृष्टमुदिताः सर्वे सुग्रीवेणाभिपालिताः।\nवानरास्त्वरिता यान्ति सर्वे युद्धाभिनन्दिनः।\nप्रमोक्षयिषवः सीतां मुहूर्तं क्वापि नावसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000411070, "chapter_id": 9411, "verse_number": "६-४-७०", "content_sanskrit": "ततः पादपसम्बाधं नानावनसमायुतम्।\nसह्यपर्वतमासाद्य वानरास्ते समारुहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000411071, "chapter_id": 9411, "verse_number": "६-४-७१", "content_sanskrit": "काननानि विचित्राणि नदीप्रस्रवणानि च।\nपश्यन्नपि ययौ रामः सह्यस्य मलयस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000411072, "chapter_id": 9411, "verse_number": "६-४-७२", "content_sanskrit": "चम्पकांस्तिलकांश्चूतानशोकान् सिन्दुवारकान्।\nतिनिशान् करवीरांश्च भञ्जन्ति स्म प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000411073, "chapter_id": 9411, "verse_number": "६-४-७३", "content_sanskrit": "अङ्कोलांश्च करञ्जांश्च प्लक्षन्यग्रोधपादपान्।\nजम्बूकामलकान् नीपान् भञ्जन्ति स्म प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000411074, "chapter_id": 9411, "verse_number": "६-४-७४", "content_sanskrit": "प्रस्तरेषु च रम्येषु विविधाः काननद्रुमाः।\nवायुवेगप्रचलिताः पुष्पैरवकिरन्ति तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000411075, "chapter_id": 9411, "verse_number": "६-४-७५", "content_sanskrit": "मारुतः सुखसंस्पर्शो वाति चन्दनशीतलः।\nषट्पदैरनुकूजद्भिर्वनेषु मधुगन्धिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000411076, "chapter_id": 9411, "verse_number": "६-४-७६", "content_sanskrit": "अधिकं शैलराजस्तु धातुभिस्तु विभूषितः।\nधातुभ्यः प्रसृतो रेणुर्वायुवेगेन घट्टितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000411077, "chapter_id": 9411, "verse_number": "६-४-७७", "content_sanskrit": "सुमहद्वानरानीकं छादयामास सर्वतः।\nगिरिप्रस्थेषु रम्येषु सर्वतः सम्प्रपुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000411078, "chapter_id": 9411, "verse_number": "६-४-७८", "content_sanskrit": "केतक्यः सिन्दुवाराश्च वासन्त्यश्च मनोरमाः।\nमाधव्यो गन्धपूर्णाश्च कुन्दगुल्माश्च पुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000411079, "chapter_id": 9411, "verse_number": "६-४-७९", "content_sanskrit": "चिरिबिल्वा मधूकाश्च वञ्जुला बकुलास्तथा।\nरञ्जकास्तिलकाश्चैव नागवृक्षाश्च पुष्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000411080, "chapter_id": 9411, "verse_number": "६-४-८०", "content_sanskrit": "चूताः पाटलिकाश्चैव कोविदाराश्च पुष्पिताः।\nमुचुलिन्दार्जुनाश्चैव शिंशपाः कुटजास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000411081, "chapter_id": 9411, "verse_number": "६-४-८१", "content_sanskrit": "हिन्तालास्तिनिशाश्चैव चूर्णका नीपकास्तथा।\nनीलाशोकाश्च सरला अङ्कोलाः पद्मकास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000411082, "chapter_id": 9411, "verse_number": "६-४-८२", "content_sanskrit": "प्रीयमाणैः प्लवंगैस्तु सर्वे पर्याकुलीकृताः।\nवाप्यस्तस्मिन् गिरौ रम्याः पल्वलानि तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000411083, "chapter_id": 9411, "verse_number": "६-४-८३", "content_sanskrit": "चक्रवाकानुचरिताः कारण्डवनिषेविताः।\nप्लवैः क्रौञ्चैश्च संकीर्णा वराहमृगसेविताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000411084, "chapter_id": 9411, "verse_number": "६-४-८४", "content_sanskrit": "ऋक्षैस्तरक्षुभिः सिंहैः शार्दूलैश्च भयावहैः।\nव्यालैश्च बहुभिर्भीमैः सेव्यमानाः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000411085, "chapter_id": 9411, "verse_number": "६-४-८५", "content_sanskrit": "पद्मैः सौगन्धिकैः फुल्लैः कुमुदैश्चोत्पलैस्तथा।\nवारिजैर्विविधैः पुष्पै रम्यास्तत्र जलाशयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000411086, "chapter_id": 9411, "verse_number": "६-४-८६", "content_sanskrit": "तस्य सानुषु कूजन्ति नानाद्विजगणास्तथा।\nस्नात्वा पीत्वोदकान्यत्र जले क्रीडन्ति वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000411087, "chapter_id": 9411, "verse_number": "६-४-८७", "content_sanskrit": "अन्योन्यं प्लावयन्ति स्म शैलमारुह्य वानराः।\nफलान्यमृतगन्धीनि मूलानि कुसुमानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000411088, "chapter_id": 9411, "verse_number": "६-४-८८", "content_sanskrit": "बभञ्जुर्वानरास्तत्र पादपानां मदोत्कटाः।\nद्रोणमात्रप्रमाणानि लम्बमानानि वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000411089, "chapter_id": 9411, "verse_number": "६-४-८९", "content_sanskrit": "ययुः पिबन्तः स्वस्थास्ते मधूनि मधुपिङ्गलाः।\nपादपानवभञ्जन्तो विकर्षन्तस्तथा लताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000411090, "chapter_id": 9411, "verse_number": "६-४-९०", "content_sanskrit": "विधमन्तो गिरिवरान् प्रययुः प्लवगर्षभाः।\nवृक्षेभ्योऽन्ये तु कपयो नदन्तो मधु दर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000411091, "chapter_id": 9411, "verse_number": "६-४-९१", "content_sanskrit": "अन्ये वृक्षान् प्रपद्यन्ते प्रपिबन्त्यपि चापरे।\nबभूव वसुधा तैस्तु सम्पूर्णा हरिपुङ्गवैः।\nयथा कमलकेदारैः पक्वैरिव वसुंधरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000411092, "chapter_id": 9411, "verse_number": "६-४-९२", "content_sanskrit": "महेन्द्रमथ सम्प्राप्य रामो राजीवलोचनः।\nआरुरोह महाबाहुः शिखरं द्रुमभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000411093, "chapter_id": 9411, "verse_number": "६-४-९३", "content_sanskrit": "ततः शिखरमारुह्य रामो दशरथात्मजः।\nकूर्ममीनसमाकीर्णमपश्यत् सलिलाशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000411094, "chapter_id": 9411, "verse_number": "६-४-९४", "content_sanskrit": "ते सह्यं समतिक्रम्य मलयं च महागिरिम्।\nआसेदुरानुपूर्व्येण समुद्रं भीमनिःस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000411095, "chapter_id": 9411, "verse_number": "६-४-९५", "content_sanskrit": "अवरुह्य जगामाशु वेलावनमनुत्तमम्।\nरामो रमयतां श्रेष्ठः ससुग्रीवः सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000411096, "chapter_id": 9411, "verse_number": "६-४-९६", "content_sanskrit": "अथ धौतोपलतलां तोयौघैः सहसोत्थितैः।\nवेलामासाद्य विपुलां रामो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000411097, "chapter_id": 9411, "verse_number": "६-४-९७", "content_sanskrit": "एते वयमनुप्राप्ताः सुग्रीव वरुणालयम्।\nइहेदानीं विचिन्ता सा या नः पूर्वमुपस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 5000411098, "chapter_id": 9411, "verse_number": "६-४-९८", "content_sanskrit": "अतः परमतीरोऽयं सागरः सरितां पतिः।\nन चायमनुपायेन शक्यस्तरितुमर्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 5000411099, "chapter_id": 9411, "verse_number": "६-४-९९", "content_sanskrit": "तदिहैव निवेशोऽस्तु मन्त्रः प्रस्तूयतामिह।\nयथेदं वानरबलं परं पारमवाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 5000411100, "chapter_id": 9411, "verse_number": "६-४-१००", "content_sanskrit": "इतीव स महाबाहुः सीताहरणकर्शितः।\nरामः सागरमासाद्य वासमाज्ञापयत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 5000411101, "chapter_id": 9411, "verse_number": "६-४-१०१", "content_sanskrit": "सर्वाः सेना निवेश्यन्तां वेलायां हरिपुङ्गव।\nसम्प्राप्तो मन्त्रकालो नः सागरस्येह लङ्घने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 5000411102, "chapter_id": 9411, "verse_number": "६-४-१०२", "content_sanskrit": "स्वां स्वां सेनां समुत्सृज्य मा च कश्चित् कुतो व्रजेत्।\nगच्छन्तु वानराः शूरा ज्ञेयं छन्नं भयं च नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 5000411103, "chapter_id": 9411, "verse_number": "६-४-१०३", "content_sanskrit": "रामस्य वचनं श्रुत्वा सुग्रीवः सहलक्ष्मणः।\nसेनां निवेशयत् तीरे सागरस्य द्रुमायुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 5000411104, "chapter_id": 9411, "verse_number": "६-४-१०४", "content_sanskrit": "विरराज समीपस्थं सागरस्य च तद् बलम्।\nमधुपाण्डुजलः श्रीमान् द्वितीय इव सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 5000411105, "chapter_id": 9411, "verse_number": "६-४-१०५", "content_sanskrit": "वेलावनमुपागम्य ततस्ते हरिपुङ्गवाः।\nनिविष्टाश्च परं पारं काङ्क्षमाणा महोदधेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 5000411106, "chapter_id": 9411, "verse_number": "६-४-१०६", "content_sanskrit": "तेषां निविशमानानां सैन्यसंनाहनिःस्वनः।\nअन्तर्धाय महानादमर्णवस्य प्रशुश्रुवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 5000411107, "chapter_id": 9411, "verse_number": "६-४-१०७", "content_sanskrit": "सा वानराणां ध्वजिनी सुग्रीवेणाभिपालिता।\nत्रिधा निविष्टा महती रामस्यार्थपराभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 5000411108, "chapter_id": 9411, "verse_number": "६-४-१०८", "content_sanskrit": "सा महार्णवमासाद्य हृष्टा वानरवाहिनी।\nवायुवेगसमाधूतं पश्यमाना महार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 5000411109, "chapter_id": 9411, "verse_number": "६-४-१०९", "content_sanskrit": "दूरपारमसम्बाधं रक्षोगणनिषेवितम्।\nपश्यन्तो वरुणावासं निषेदुर्हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 5000411110, "chapter_id": 9411, "verse_number": "६-४-११०", "content_sanskrit": "चण्डनक्रग्राहघोरं क्षपादौ दिवसक्षये।\nहसन्तमिव फेनौघैर्नृत्यन्तमिव चोर्मिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 5000411111, "chapter_id": 9411, "verse_number": "६-४-१११", "content_sanskrit": "चन्द्रोदये समुद्भूतं प्रतिचन्द्रसमाकुलम्।\nचण्डानिलमहाग्राहैः कीर्णं तिमितिमिंगिलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 5000411112, "chapter_id": 9411, "verse_number": "६-४-११२", "content_sanskrit": "दीप्तभोगैरिवाकीर्णं भुजङ्गैर्वरुणालयम्।\nअवगाढं महासत्त्वैर्नानाशैलसमाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 5000411113, "chapter_id": 9411, "verse_number": "६-४-११३", "content_sanskrit": "सुदुर्गं दुर्गमार्गं तमगाधमसुरालयम्।\nमकरैर्नागभोगैश्च विगाढा वातलोलिताः।\nउत्पेतुश्च निपेतुश्च प्रहृष्टा जलराशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 5000411114, "chapter_id": 9411, "verse_number": "६-४-११४", "content_sanskrit": "अग्निचूर्णमिवाविद्धं भास्वराम्बुमहोरगम्।\nसुरारिनिलयं घोरं पातालविषयं सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 5000411115, "chapter_id": 9411, "verse_number": "६-४-११५", "content_sanskrit": "सागरं चाम्बरप्रख्यमम्बरं सागरोपमम्।\nसागरं चाम्बरं चेति निर्विशेषमदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 5000411116, "chapter_id": 9411, "verse_number": "६-४-११६", "content_sanskrit": "सम्पृक्तं नभसाप्यम्भः सम्पृक्तं च नभोऽम्भसा।\nतादृग्रूपे स्म दृश्येते तारारत्नसमाकुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 5000411117, "chapter_id": 9411, "verse_number": "६-४-११७", "content_sanskrit": "समुत्पतितमेघस्य वीचिमालाकुलस्य च।\nविशेषो न द्वयोरासीत् सागरस्याम्बरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 5000411118, "chapter_id": 9411, "verse_number": "६-४-११८", "content_sanskrit": "अन्योन्यैरहताः सक्ताः सस्वनुर्भीमनिःस्वनाः।\nऊर्मयः सिन्धुराजस्य महाभेर्य इवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 5000411119, "chapter_id": 9411, "verse_number": "६-४-११९", "content_sanskrit": "रत्नौघजलसंनादं विषक्तमिव वायुना।\nउत्पतन्तमिव क्रुद्धं यादोगणसमाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 5000411120, "chapter_id": 9411, "verse_number": "६-४-१२०", "content_sanskrit": "ददृशुस्ते महात्मानो वाताहतजलाशयम्।\nअनिलोद्‍धूतमाकाशे प्रवलान्तमिवोर्मिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 5000411121, "chapter_id": 9411, "verse_number": "६-४-१२१", "content_sanskrit": "ततो विस्मयमापन्ना हरयो ददृशुः स्थिताः।\nभ्रान्तोर्मिजालसंनादं प्रलोलमिव सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 5000411122, "chapter_id": 9411, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे चतुर्थः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]