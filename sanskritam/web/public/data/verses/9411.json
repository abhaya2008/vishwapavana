[{"id": 40022840, "chapter_id": 9411, "verse_number": "1", "content_sanskrit": "तत्सर्वमखिलेनाशु प्रस्थाप्य भरताग्रजः । हयं लक्षणसम्पन्नं कृष्णसारं मुमोच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022841, "chapter_id": 9411, "verse_number": "2", "content_sanskrit": "ऋत्विग्भिर्लक्ष्मणं सार्धमश्वतन्त्रे नियोज्य च । ततो ऽभ्यगच्छत्काकुत्स्थः सह सैन्येन नैमिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022842, "chapter_id": 9411, "verse_number": "3", "content_sanskrit": "यज्ञवाटं महाबाहुर्दृष्ट्वा परममद्भुतम् । प्रबर्षमतुलं लेभे श्रीमानिति वचो ऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022843, "chapter_id": 9411, "verse_number": "4", "content_sanskrit": "नैमिषे वसतस्तस्य सर्व एव नराधिपाः । आनिन्युरुपहारांश्च तान्रामः प्रत्यपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022844, "chapter_id": 9411, "verse_number": "5", "content_sanskrit": "उपकार्या महार्हाश्च पार्थिवानां महात्मनाम् । सानुगानां नरश्रेष्ठो व्यादिदेश महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022845, "chapter_id": 9411, "verse_number": "6", "content_sanskrit": "अन्नपानानि वस्त्राणि सानुगानां महात्मनाम् । भरतः सन्ददावाशु शत्रुघ्नसहितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022846, "chapter_id": 9411, "verse_number": "7", "content_sanskrit": "वानराश्च महात्मानः सुग्रीवसहितास्तदा । विप्राणां प्रणताः सर्वे चक्रिरे परिवेषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022847, "chapter_id": 9411, "verse_number": "8", "content_sanskrit": "बिभीषणश्च रक्षोभिर्बहुभिः स्रग्विभिर्वृतः । ऋषीणामुग्रतपसां पूजां चक्रे महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022848, "chapter_id": 9411, "verse_number": "9", "content_sanskrit": "एवं सुविहितो यज्ञो हयमेधो ऽभ्यवर्तत । लक्ष्मणेनागुप्ता च हयचर्या प्रवर्तत । ईदृशं राजसिंहस्य यज्ञप्रवरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022849, "chapter_id": 9411, "verse_number": "10", "content_sanskrit": "नान्यः शब्दो ऽभवत्तत्र हयमेधे महात्मनः । छन्दतो देहि विस्रब्धो यावत्तुष्यन्ति याचकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022850, "chapter_id": 9411, "verse_number": "11", "content_sanskrit": "तावत्सर्वाणि दत्तानि क्रतुमध्ये महात्मनः । विविधानि च गौडानि खाण्डवानि तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022851, "chapter_id": 9411, "verse_number": "12", "content_sanskrit": "न निस्सृतं भतत्योष्ठाद्वचनं यावदर्थिनाम् । तावद्वानररक्षोभिर्दत्तमेवाभ्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022852, "chapter_id": 9411, "verse_number": "13", "content_sanskrit": "न कश्चिन्मलिनस्तत्र दीनो वा ऽप्यथ कृर्शतः । तस्मिन्यज्ञवरे राज्ञो हृष्टपुष्टजनावृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022853, "chapter_id": 9411, "verse_number": "14", "content_sanskrit": "ये च तत्र महात्मानो मुनयश्चिरजीविनः । नास्मरंस्तादृशं यज्ञं नाप्यासीत् स कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022854, "chapter_id": 9411, "verse_number": "15", "content_sanskrit": "यः कृत्यवान्सुवर्णेन सुवर्णं लभते स्म सः । वित्तार्थी लभते वित्तं रत्नार्थी रत्नमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022855, "chapter_id": 9411, "verse_number": "16", "content_sanskrit": "रजतानां सुवर्णानामश्मनामथ वाससाम् । अनिशं दीयमानानां राशिः समुपदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022856, "chapter_id": 9411, "verse_number": "17", "content_sanskrit": "न शक्रस्य धनेशस्य यमस्य वरुणस्य वा । ईदृशो दृष्टपूर्वो न एवमूचुस्तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022857, "chapter_id": 9411, "verse_number": "18", "content_sanskrit": "सर्वत्र वानरास्तस्थुः सर्वत्रैव च राक्षसाः । वासोधनान्नमर्थिभ्यः पूर्णहस्ता ददुर्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022858, "chapter_id": 9411, "verse_number": "19", "content_sanskrit": "ईदृशो राजसिंहस्य यज्ञः सर्वगुणान्वितः । संवत्सरमथो साग्रं वर्तते न च हीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]