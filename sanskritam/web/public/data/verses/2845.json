[{"id": 2086927, "chapter_id": 2845, "verse_number": "१२-३५०-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2086928, "chapter_id": 2845, "verse_number": "१२-३५०-१", "content_sanskrit": "अस्तौषीद्वैदिकैर्व्यासः सशिष्यो मधुसूदनम्।\nनामभिर्विविधैरेषां निरुक्तं भगवन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2086929, "chapter_id": 2845, "verse_number": "१२-३५०-२", "content_sanskrit": "वक्तुमर्हसि शुश्रूषोः प्रजापतिपतेर्हरः।\nश्रुत्वा भवेयं यत्पूतः शरच्चन्द्र इवामलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2086930, "chapter_id": 2845, "verse_number": "१२-३५०-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2086931, "chapter_id": 2845, "verse_number": "१२-३५०-३", "content_sanskrit": "शृणु राजन्यथाचष्ट फल्गुनस्य हरिः प्रभुः।\nप्रसन्नात्मात्मनो नाम्नां निरुक्तं गुणकर्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2086932, "chapter_id": 2845, "verse_number": "१२-३५०-४", "content_sanskrit": "नामभिः कीर्तितैस्तस्य केशवस्य महात्मनः।\nपृष्टवान्केशवं राजन्फगुनः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2086933, "chapter_id": 2845, "verse_number": "१२-३५०-५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2086934, "chapter_id": 2845, "verse_number": "१२-३५०-५", "content_sanskrit": "भगवन्भूतभव्येश सर्वभूतसृगव्यय।\nलोकधाम जगन्नाथ लोकानामभयप्रद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2086935, "chapter_id": 2845, "verse_number": "१२-३५०-६", "content_sanskrit": "यानि नामानि ते देव कीर्तितानि महर्षिभिः।\nवेदेषु सपुराणेषु यानि गुह्यानि कर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2086936, "chapter_id": 2845, "verse_number": "१२-३५०-७", "content_sanskrit": "तेषां निरुक्तं त्वत्तोऽहं श्रोतुमिच्छामि केशव।\nन ह्यन्यो वर्णयेन्नाम्नां निरुक्तं त्वामृते प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2086937, "chapter_id": 2845, "verse_number": "१२-३५०-८x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2086938, "chapter_id": 2845, "verse_number": "१२-३५०-८", "content_sanskrit": "ऋग्वेदे सयजुर्वेदे तथैवाथर्वसामसु।\nपुराणे सोपनिषदे तथैव ज्योतिषेऽर्जुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2086939, "chapter_id": 2845, "verse_number": "१२-३५०-९", "content_sanskrit": "साङ्ख्ये च योगशास्त्रे च आयुर्वेदे तथैव च।\nबहूनि मम नामानि कीर्तितानि महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2086940, "chapter_id": 2845, "verse_number": "१२-३५०-१०", "content_sanskrit": "गौणानि तत्र नामानि कर्मजानि च कानिचित्।\nनिरुक्तं कर्मजानां त्वं शृणुष्व प्रयतोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2086941, "chapter_id": 2845, "verse_number": "१२-३५०-११", "content_sanskrit": "कथ्यमानं मया तात त्वं हि मेऽर्धं स्मृतः पुरा।\nनमोऽतियशमे तस्मै देवानां परमात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2086942, "chapter_id": 2845, "verse_number": "१२-३५०-१२", "content_sanskrit": "नारायणाय विश्वाय निर्गुणाय गुणात्मने।\nयस्य प्रसादजो ब्रह्मा रुद्रस्य क्रोधसंभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2086943, "chapter_id": 2845, "verse_number": "१२-३५०-१३", "content_sanskrit": "योसौ योनिर्हि सर्वस्य स्थावरस्य चरस्य च।\nअष्टादशगुणं यत्तत्सत्वं सत्ववतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2086944, "chapter_id": 2845, "verse_number": "१२-३५०-१४", "content_sanskrit": "प्रकृतिः सा परा मह्यं रोदसी लोकधारिणी।\nऋता सत्याऽमरा जय्या लोकानामात्मसंज्ञिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2086945, "chapter_id": 2845, "verse_number": "१२-३५०-१५", "content_sanskrit": "तस्मात्सर्वाः प्रवर्तन्ते सर्गप्रलयविक्रियाः।\nतपो यज्ञश्च यष्टा च पुराणः पुरुषो विराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2086946, "chapter_id": 2845, "verse_number": "१२-३५०-१६", "content_sanskrit": "अनिरुद्ध इति प्रोक्तो लोकानां प्रभवाप्ययः।\nब्राह्मे रात्रिक्षये प्राप्ते तस्य ह्यमिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2086947, "chapter_id": 2845, "verse_number": "१२-३५०-१७", "content_sanskrit": "प्रसादात्प्रादुरभवत्पद्ममर्कनिभं क्षणात्।\nतत्र ब्रह्मा समभवत्स तस्यैव प्रसादजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2086948, "chapter_id": 2845, "verse_number": "१२-३५०-१८", "content_sanskrit": "अह्नः क्षये ललाटाच्च सुतो देवस्य वै तथा।\nक्रोधाविष्टस्य संजज्ञे रुद्रः संहारकारकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2086949, "chapter_id": 2845, "verse_number": "१२-३५०-१९", "content_sanskrit": "एतौ द्वौ विबुधश्रेष्ठौ प्रसादक्रोधजावुभौ।\nतदादर्शितपन्थानौ सृष्टिसंहारकारकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2086950, "chapter_id": 2845, "verse_number": "१२-३५०-२०", "content_sanskrit": "निमित्तमात्रं तावत्र सर्वप्राणिवरप्रदौ।\nकपदीं जटिलो मुण्डः श्मशानगृहसेवकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2086951, "chapter_id": 2845, "verse_number": "१२-३५०-२१", "content_sanskrit": "उग्रव्रतचरो रुद्रो योगी त्रिपुरदारणः।\nदक्षक्रतुहरश्चैव भगनेत्रहरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2086952, "chapter_id": 2845, "verse_number": "१२-३५०-२२", "content_sanskrit": "नारायणात्मको ज्ञेयः पाण्डवेय युगेयुगे।\nतस्मिन्हि पूज्यमाने वै देवदेवे महेश्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2086953, "chapter_id": 2845, "verse_number": "१२-३५०-२३", "content_sanskrit": "संपूजितो भवत्पार्थ देवो नारायणः प्रभुः।\nअहमात्मा हि लोकानां विश्वेषां पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2086954, "chapter_id": 2845, "verse_number": "१२-३५०-२४", "content_sanskrit": "तस्मादात्मानमेवाग्रे रुद्रं संपूजयाम्यहम्।\nयद्यहं नार्चयेयं वै ईशानं वरदं शिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2086955, "chapter_id": 2845, "verse_number": "१२-३५०-२५", "content_sanskrit": "आत्मानं नार्चयेत्कश्चिदिति मे भावितात्मनः।\nमया प्रमाणं हि कृतं लोकः समनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2086956, "chapter_id": 2845, "verse_number": "१२-३५०-२६", "content_sanskrit": "प्रमाणानि हि पूज्यानि ततस्तं पूजयाम्यहम्।\nयस्तं वेत्ति स मां वेत्ति योऽनु तं स हि मामनु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2086957, "chapter_id": 2845, "verse_number": "१२-३५०-२७", "content_sanskrit": "रुद्रो नारायणश्चैव सत्वमेकं द्विधा कृतम्।\nलोके चरति कौन्तेय व्यक्तिस्थं सर्वकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2086958, "chapter_id": 2845, "verse_number": "१२-३५०-२८", "content_sanskrit": "न हि मे केनचिद्देयो वरः पाण्डवनन्दन।\nइति संचिन्त्य मनसा पुराणं रुद्रमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2086959, "chapter_id": 2845, "verse_number": "१२-३५०-२९", "content_sanskrit": "पुत्रार्थमाराधितवानहमात्मानमात्मना।\nन हि विष्णुः प्रणमति कस्मैचिद्विबुधाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2086960, "chapter_id": 2845, "verse_number": "१२-३५०-३०", "content_sanskrit": "ऋते आत्मानमेवेति ततो रुद्रं नमाम्यहम्।\nसब्रह्मकाः सरुद्राश्च सेन्द्रा देवाः सहर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2086961, "chapter_id": 2845, "verse_number": "१२-३५०-३१", "content_sanskrit": "अर्चयन्ति सुरश्रेष्ठं देवं नारायणं हरिम्।\nभविष्यतां वर्ततां च भूतानां चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2086962, "chapter_id": 2845, "verse_number": "१२-३५०-३२", "content_sanskrit": "सर्वेषामग्रणीर्विष्णुः सेव्यः पूज्यश्च नित्यशः।\nनमस्व हव्यदं विष्णुं तथा शरणदं नमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2086963, "chapter_id": 2845, "verse_number": "१२-३५०-३३", "content_sanskrit": "वरदं नमस्व कौन्तेय हव्यकव्यभुजं नमः।\nचतुर्विधा मम जना भक्ता एव हि मे श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2086964, "chapter_id": 2845, "verse_number": "१२-३५०-३४", "content_sanskrit": "तेषामेकान्तिनः श्रेष्ठा ये चैवानन्यदेवताः।\nअहमेव गतिस्तेषां निराशीः कर्मकारिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2086965, "chapter_id": 2845, "verse_number": "१२-३५०-३५", "content_sanskrit": "ये च शिष्टास्त्रयो भक्ताः फलकामा हि ते मताः।\nसर्वे च्यवनधर्माणः प्रतिबुद्धस्तु श्रेष्ठभाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2086966, "chapter_id": 2845, "verse_number": "१२-३५०-३६", "content_sanskrit": "ब्रह्माणं शितिकण्ठं च याश्चान्या देवताः स्मृताः।\nप्रबुद्धचर्याः सेवन्तो मामेवैष्यन्ति यत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2086967, "chapter_id": 2845, "verse_number": "१२-३५०-३७", "content_sanskrit": "भक्तं प्रति विशेषस्ते एष पार्थानुकीर्तितः।\nत्वं चैवाहं च कौन्तेय नरनारायणौ स्मृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2086968, "chapter_id": 2845, "verse_number": "१२-३५०-३८", "content_sanskrit": "भारावतरणार्थं तु प्रविष्टौ मानुषीं तनुम्।\nनानीभ्यध्यात्मयोगांश्च योऽहं यस्माच्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2086969, "chapter_id": 2845, "verse_number": "१२-३५०-३९", "content_sanskrit": "निवृत्तिलक्षणो धर्मस्तथाऽऽभ्यदयिकोऽपि च।\nनराणामयनं ख्यातमहमेकः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2086970, "chapter_id": 2845, "verse_number": "१२-३५०-४०", "content_sanskrit": "आपो नारा इति प्रोक्ता आपो वै नरसूनवः।\nअयनं मम ताः पूर्वमतो नारायणोस्म्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2086971, "chapter_id": 2845, "verse_number": "१२-३५०-४१", "content_sanskrit": "छादयामि जगद्विश्वं भूत्वा सूर्य इवांशुभिः।\nसर्वभूताधिवासश्च वासुदेवस्ततो ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2086972, "chapter_id": 2845, "verse_number": "१२-३५०-४२", "content_sanskrit": "गतिश्च सर्वभूतानां प्रजनश्चापि भारत।\nव्याप्ते म रोदसी पार्थ कान्तिश्चाभ्यधिका मम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2086973, "chapter_id": 2845, "verse_number": "१२-३५०-४३", "content_sanskrit": "अधिभूतनिविष्टश्च तद्विश्वं चास्मि भारत।\nक्रमणाच्चाप्यहं पार्थ विष्णुरित्यभिसंज्ञितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2086974, "chapter_id": 2845, "verse_number": "१२-३५०-४४", "content_sanskrit": "दमात्सिद्धिं परीप्सन्तो मां जनाः कामयन्ति ह।\nदिवं चोर्वी च मध्यं च तस्माद्दामोदरो ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2086975, "chapter_id": 2845, "verse_number": "१२-३५०-४५", "content_sanskrit": "पृश्निरित्युच्यते चान्नं वेदा आपोऽमृतं तथा।\nममैतानि सदा गर्भः पृश्निगर्भस्ततो ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2086976, "chapter_id": 2845, "verse_number": "१२-३५०-४६", "content_sanskrit": "ऋषयः प्राहुरेवं मां त्रितं कूपनिपातितम्।\nपृश्निगर्भ त्रितं पाहीत्येकतद्वितपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2086977, "chapter_id": 2845, "verse_number": "१२-३५०-४७", "content_sanskrit": "ततः स ब्रह्मणः पुत्र आद्यो ह्यृषिवरस्त्रितः।\nउत्ततारोदपानाद्वै पृश्निगर्भानुकीर्तनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2086978, "chapter_id": 2845, "verse_number": "१२-३५०-४८", "content_sanskrit": "सूर्यस्य तपतो लोकानग्नेः सोमस्य चाप्युत।\nअंशवो यत्प्रकाशन्ते ममैते केशसंज्ञिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2086979, "chapter_id": 2845, "verse_number": "१२-३५०-४९", "content_sanskrit": "सर्वज्ञाः केशवं तस्मान्मामाहुर्द्विजसत्तमाः।\nस्वपत्न्यामाहितो गर्भ उचथ्येन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2086980, "chapter_id": 2845, "verse_number": "१२-३५०-५०", "content_sanskrit": "उचथ्येऽन्तहिंते चैव कदाचिद्देवताज्ञया।\nबृहस्पतिरथाविन्दत्तां पत्नीं तस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2086981, "chapter_id": 2845, "verse_number": "१२-३५०-५१", "content_sanskrit": "ततो वै तमृषिश्रेष्ठं मैथुनोपगतं तथा।\nउवाच गर्भः कौन्तेय पञ्चभूतगुणात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2086982, "chapter_id": 2845, "verse_number": "१२-३५०-५२", "content_sanskrit": "पूर्वागतोऽहं वरद नार्हस्यम्बां प्रबाधितुम्।\nएतद्बृहस्पतिः श्रुत्वा चुक्रोध च शशाप च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2086983, "chapter_id": 2845, "verse_number": "१२-३५०-५३", "content_sanskrit": "मैथुनायागतो यस्मात्त्वयाऽहं विनिवारितः।\nतस्मादन्धो यास्यसि त्वं मच्छापान्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2086984, "chapter_id": 2845, "verse_number": "१२-३५०-५४", "content_sanskrit": "स शापादृषिमुख्यस्य दीर्घं तम उपेयिवान्।\nस हि दीर्घतमा नाम नाम्ना ह्यासीदृषिः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2086985, "chapter_id": 2845, "verse_number": "१२-३५०-५५", "content_sanskrit": "वेदानवाप्य चतुरः साङ्गोपाङ्गान्सनातनान्।\nप्रयोजयामास तदा नाम गुह्यमिदं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2086986, "chapter_id": 2845, "verse_number": "१२-३५०-५६", "content_sanskrit": "आनुपूर्व्येण विधिना केशवेति पुनः पुनः।\nस चक्षुष्मान्समभवद्गौतमश्चाभवत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2086987, "chapter_id": 2845, "verse_number": "१२-३५०-५७", "content_sanskrit": "एवं हि वरदं नाम केशवेति ममार्जुन।\nदेवानामथ सर्वेषामृषीणां च महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2086988, "chapter_id": 2845, "verse_number": "१२-३५०-५८", "content_sanskrit": "अग्निः सोमेन संयुक्त एकयोनिर्मुखं कृतम्।\nअग्नीषोममयं तस्माज्जगत्कृत्स्नं चराचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2086989, "chapter_id": 2845, "verse_number": "१२-३५०-५९", "content_sanskrit": "अपि हि पुराणे भवति एकयोन्यावग्नीषोमौ देवाश्चाग्निमुखा इति। एकयोनित्वाच्च परस्परं हर्षयन्तो लोकान्धारयन्त इति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2086990, "chapter_id": 2845, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये पञ्चाशदधिकत्रिशततमोऽध्यायः॥ ३५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]