[{"id": 6000213000, "chapter_id": 10213, "verse_number": null, "content_sanskrit": "अथ सप्तदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000213001, "chapter_id": 10213, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.001.m4a", "display_order": 2}, {"id": 6000213002, "chapter_id": 10213, "verse_number": "१०-१७-१", "content_sanskrit": "क्रीडासक्तेषु गोपेषु तद्गावो दूरचारिणीः।\nस्वैरं चरन्त्यो विविशुस्तृणलोभेन गह्वरम्॥ १०/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णादिभिश्चार्यमाणानां गवां मुञ्जाटवीप्रवेशः", "range": "१–५"}]}, {"id": 6000213003, "chapter_id": 10213, "verse_number": "१०-१७-२", "content_sanskrit": "अजा गावो महिष्यश्च निर्विशन्त्यो वनाद् वनम्।\nमुञ्जाटवीं निविविशुः क्रन्दन्त्यो दावतर्षिताः॥ १०/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.003.m4a", "display_order": 4}, {"id": 6000213004, "chapter_id": 10213, "verse_number": "१०-१७-३", "content_sanskrit": "तेऽपश्यन्तः पशून् गोपाः कृष्णरामादयस्तदा।\nजातानुतापा न विदुर्विचिन्वन्तो गवां गतिम्॥ १०/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.004.m4a", "display_order": 5}, {"id": 6000213005, "chapter_id": 10213, "verse_number": "१०-१७-४", "content_sanskrit": "तृणैस्तत्खुरदच्छिन्नैर्गोष्पदैरङ्कितैर्गवाम्।\nमार्गमन्वगमन् सर्वे नष्टाजीवा विचेतसः॥ १०/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.005.m4a", "display_order": 6}, {"id": 6000213006, "chapter_id": 10213, "verse_number": "१०-१७-५", "content_sanskrit": "मुञ्जाटव्यां भ्रष्टमार्गं क्रन्दमानाः स्वगोधनम्।\nअप्राप्य तृषिताः श्रान्तास्ततस्ते सन्न्यवर्तयन्॥ १०/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.006.m4a", "display_order": 7}, {"id": 6000213007, "chapter_id": 10213, "verse_number": "१०-१७-६", "content_sanskrit": "ता आहूता भगवता मेघगम्भीरया गिरा।\nस्वनाम्ना निनदं श्रुत्वा प्रतिनेदुः प्रहर्षिताः॥ १०/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.007.m4a", "display_order": 8, "topics": [{"text": "ता अन्विष्य गतानां दावाग्निना वेष्टितानां गोपानां श्रीकृष्णेन तस्मान्मोक्षणम्", "range": "६–१२"}]}, {"id": 6000213008, "chapter_id": 10213, "verse_number": "१०-१७-७", "content_sanskrit": "ततः समन्ताद् वनधूमकेतुर्यदृच्छयाऽभूत् क्षयकृद् वनौकसाम्।\nसमीरितः सारथिनोल्बणोल्मुकैर्विलेलिहानः स्थिरजङ्गमान् महान्॥ १०/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.008.m4a", "display_order": 9}, {"id": 6000213009, "chapter_id": 10213, "verse_number": "१०-१७-८", "content_sanskrit": "तमापतन्तं परितो दवाग्निं गोपाश्च गावः प्रसमीक्ष्य भीताः।\nऊचुः स्म कृष्णं सबलं प्रपन्ना यथा हरिं मृत्युभयार्दिता जनाः॥ १०/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.009.m4a", "display_order": 10}, {"id": 6000213010, "chapter_id": 10213, "verse_number": "१०-१७-९", "content_sanskrit": "कृष्ण कृष्ण महावीर्य हे रामामोघविक्रम।\nदावाग्निना दह्यमानान् प्रपन्नांस्‍त्रातुमर्हथः॥ १०/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.010.m4a", "display_order": 11}, {"id": 6000213011, "chapter_id": 10213, "verse_number": "१०-१७-१०", "content_sanskrit": "नूनं त्वद्बान्धवाः कृष्ण न चार्हन्त्यवसीदितुम्।\nवयं हि सर्वधर्मज्ञ त्वन्नाथास्त्वत्परायणाः॥ १०/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.011.m4a", "display_order": 12}, {"id": 6000213012, "chapter_id": 10213, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.012.m4a", "display_order": 13}, {"id": 6000213013, "chapter_id": 10213, "verse_number": "१०-१७-११", "content_sanskrit": "वचो निशम्य कृपणं बन्धूनां भगवान् हरिः।\nनिमीलयत मा भैष्ट लोचनानीत्यभाषत॥ १०/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.013.m4a", "display_order": 14}, {"id": 6000213014, "chapter_id": 10213, "verse_number": "१०-१७-१२", "content_sanskrit": "तथेति मीलिताक्षेषु भगवानग्निमुल्बणम्।\nपीत्वा मुखेन तान् कृच्छ्राद् योगाधीशो व्यमोचयत्॥ १०/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.014.m4a", "display_order": 15}, {"id": 6000213015, "chapter_id": 10213, "verse_number": "१०-१७-१३", "content_sanskrit": "ततश्च तेऽक्षीण्युन्मील्य पुनर्भाण्डीरमाश्रिताः।\nनिशाम्य विस्मिता आसन्नात्मानं गाश्च मोचिताः॥ १०/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.015.m4a", "display_order": 16}, {"id": 6000213016, "chapter_id": 10213, "verse_number": "१०-१७-१४", "content_sanskrit": "कृष्णस्य योगवीर्यं तद् योगमायानुभावितम्।\nदावाग्नेरात्मनः क्षेमं वीक्ष्य तं मेनिरेऽमरम्॥ १०/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.016.m4a", "display_order": 17}, {"id": 6000213017, "chapter_id": 10213, "verse_number": "१०-१७-१५", "content_sanskrit": "गाः सन्निवर्त्य सायाह्ने सहरामो जनार्दनः।\nवेणुं विरणयन् गोष्ठमगाद् गोपैरभिष्टुतः॥ १०/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.017.m4a", "display_order": 18}, {"id": 6000213018, "chapter_id": 10213, "verse_number": "१०-१७-१६", "content_sanskrit": "गोपीनां परमानन्द आसीद् गोविन्ददर्शने।\nक्षणं यथा युगशतं यासां येन विनाऽभवत्॥ १०/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.018.m4a", "display_order": 19}, {"id": 6000213019, "chapter_id": 10213, "verse_number": "१०-१७-१७", "content_sanskrit": "तयोस्तदद्भुतं कर्म दावाग्नेर्मोक्षमात्मनः।\nगोपाः स्‍त्रीभ्यः समाचख्युः प्रलम्बवधमेव च॥ १०/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.019.m4a", "display_order": 20}, {"id": 6000213020, "chapter_id": 10213, "verse_number": "१०-१७-१८", "content_sanskrit": "गोपवृद्धाश्च गोप्यश्च तदुपाकर्ण्य विस्मिताः।\nमेनिरे देवप्रवरौ कृष्णरामौ व्रजं गतौ॥ १०/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_017/BhP_10.017.020.m4a", "display_order": 21}, {"id": 6000213021, "chapter_id": 10213, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे सप्तदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]