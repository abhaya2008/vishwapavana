[{"id": 7002517000, "chapter_id": 22517, "verse_number": "१-१७९-१", "content_sanskrit": "अरुण उवाच ।\nकृत्तिका परमा देवी रोहिणी च वरानना ।\nश्रीमन्मृगशिरो भद्रा आर्द्रा चाप्यपरोज्ज्वला ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002517001, "chapter_id": 22517, "verse_number": "१-१७९-२", "content_sanskrit": "पुनर्वसुस्तथा पुष्य आश्लेषा च तथाधिप ।\nसूर्यार्चनरता नित्यं सूर्यभावानुभाविताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002517002, "chapter_id": 22517, "verse_number": "१-१७९-३", "content_sanskrit": "अर्चयंति सदा देवमादित्यं सुरते सदा ।\nनक्षत्रमातरो ह्येताः प्रभामालाविभूषिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002517003, "chapter_id": 22517, "verse_number": "१-१७९-४", "content_sanskrit": "मघा सर्वगुणोपेता पूर्वा चैव तु फाल्गुनी ।\nस्वाती विशाखा वरदा दक्षिणां दिशमाश्रिताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002517004, "chapter_id": 22517, "verse_number": "१-१७९-५", "content_sanskrit": "अर्चयंति सदा देवमादित्यं सुरपूजितम् ।\nतवापि शांतिकं द्योतं कुर्वंतु गगनोदिताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002517005, "chapter_id": 22517, "verse_number": "१-१७९-६", "content_sanskrit": "अनुराधा तथा ज्येष्ठा मूलं सूर्यपुरःसरा ।\nपूर्वाषाढा महावीर्या आषाढा चोत्तरा तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002517006, "chapter_id": 22517, "verse_number": "१-१७९-७", "content_sanskrit": "अभिजिन्नाम नक्षत्रं श्रवणं च बहुश्रुतम् ।\nएताः पश्चिमतो दीप्ता राजंते चानु मूर्तयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002517007, "chapter_id": 22517, "verse_number": "१-१७९-८", "content_sanskrit": "भास्करं पूजयंत्येताः सर्वकालं सुभाविताः ।\nशांतिं कुर्वंतु ते नित्यं विभूतिं च महर्द्धिकाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002517008, "chapter_id": 22517, "verse_number": "१-१७९-९", "content_sanskrit": "धनिष्ठा शतभिषा तु पूर्वभाद्रपदा तथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002517009, "chapter_id": 22517, "verse_number": "१-१७९-१०", "content_sanskrit": "उत्तरा भाद्ररेवत्यौ चाश्विनी च महामते ।\nभरणी च महादेवी नित्यमुत्तरतः स्थिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002517010, "chapter_id": 22517, "verse_number": "१-१७९-११", "content_sanskrit": "सूर्यार्चनरता नित्यमादित्यगतमा नसाः ।\nशांतिं कुर्वतु ते नित्यं विभूतिं च महर्द्धिकाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002517011, "chapter_id": 22517, "verse_number": "१-१७९-१२", "content_sanskrit": "मेषो मृगाधिपः सिंहो धनुर्दीप्तिमतां वरः ।\nपूर्वेण भासयंत्येते सूर्ययोगपराः शुभाः ।\nशांतिं कुर्वंतु ते नित्यं भक्त्या सूर्यपदांबुजे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002517012, "chapter_id": 22517, "verse_number": "१-१७९-१३", "content_sanskrit": "वृषः कन्या च परमा मकरश्चापि बुद्धिमान् ।\nएते दक्षिणभागे तु पूजयंति रविं सदा ।\nभक्त्या परमया नित्यं शांतिं कुर्वंतु ते सदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002517013, "chapter_id": 22517, "verse_number": "१-१७९-१४", "content_sanskrit": "मिथुनं च तुला कुंभः पश्चिमे च व्यवस्थिताः ।\nजपंत्येते सदाकालमादित्यं ग्रहनाय कम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002517014, "chapter_id": 22517, "verse_number": "१-१७९-१५", "content_sanskrit": "शांतिं कुर्वंतु ते नित्यं खखोल्काज्ञानतत्पराः ।\nसतपोदत्तपुष्पाभ्यां ये स्मृता सततं बुधैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002517015, "chapter_id": 22517, "verse_number": "१-१७९-१६", "content_sanskrit": "ऋषयः सप्त विख्याता ध्रुवांताः प्ररमोज्ज्वलाः ।\nभानुप्रसादात्संपन्नाः शांतिं कुर्वंतु ते सदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002517016, "chapter_id": 22517, "verse_number": "१-१७९-१७", "content_sanskrit": "कश्यपो गालवो गार्ग्यो विश्वामित्रो महामुनिः ।\nमुनिर्दक्षो वशिष्ठश्च मार्कण्डः पुलहः क्रतुः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002517017, "chapter_id": 22517, "verse_number": "१-१७९-१८", "content_sanskrit": "नारदो भृगुरात्रेयो भारद्वाजश्च वै मुनिः ।\nवाल्मीकिः कौशिको वात्स्यः शाकल्योऽथ पुनर्वसुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002517018, "chapter_id": 22517, "verse_number": "१-१७९-१९", "content_sanskrit": "शालंकायन इत्येते ऋषयोऽथ महातपाः ।\nसूर्यध्यानैकपरमाः शांतिं कुर्वंतु ते सदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002517019, "chapter_id": 22517, "verse_number": "१-१७९-२०", "content_sanskrit": "मुनिकन्या महाभागा ऋषिकन्याः कुमारिकाः ।\nसूर्यार्चनरता नित्यं शांतिं कुर्वंतु ते सदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002517020, "chapter_id": 22517, "verse_number": "१-१७९-२१", "content_sanskrit": "सिद्धाः समृद्धतपसो ये चान्ये वै महातपाः ।\nविद्याधरा महात्मानो गरुडश्च त्वया सह ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002517021, "chapter_id": 22517, "verse_number": "१-१७९-२२", "content_sanskrit": "आदित्यपरमा ह्येते आदित्याराधने रताः ।\nसिद्धिं ते संप्रयच्छंतु आशीर्वादपरायणाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002517022, "chapter_id": 22517, "verse_number": "१-१७९-२३", "content_sanskrit": "नमुचिर्दैत्यराजेद्रः शंकुकर्णो महाबलः ।\nमहानाथोऽथ विख्यातो दैत्यः परमवीर्यवान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002517023, "chapter_id": 22517, "verse_number": "१-१७९-२४", "content_sanskrit": "ग्रहाधिपस्य देवस्य नित्यं पूजापरायणाः ।\nबलं वीर्यं च ते ऋद्धिमारोग्यं च ब्रुवंतु ते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002517024, "chapter_id": 22517, "verse_number": "१-१७९-२५", "content_sanskrit": "महाढ्यो यो हयग्रीवः प्रह्लादः प्रभयान्वितः ।\nतानैकाग्निमुखो दैत्यः कालनेमिर्महाबलः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002517025, "chapter_id": 22517, "verse_number": "१-१७९-२६", "content_sanskrit": "एते दैत्या महात्मानः सूर्यभावेन भाविताः  ।\nतुष्टिं बलं तथाऽरोग्यं प्रयच्छंतु सुरारयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002517026, "chapter_id": 22517, "verse_number": "१-१७९-२७", "content_sanskrit": "वैरोचनो हिरण्याक्षस्तुर्वसुश्च सुलोचनः ।\nमुचकुंदो मुकुंदश्च दैत्यो रैवतकस्तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002517027, "chapter_id": 22517, "verse_number": "१-१७९-२८", "content_sanskrit": "भावेन परमेणेमं यजंते सततं रविम् ।\nसततं च शुभात्मानः पुष्टिं कुर्वंतु ते सदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002517028, "chapter_id": 22517, "verse_number": "१-१७९-२९", "content_sanskrit": "दैत्यपतयो महाभागा दैत्यानां कन्यकाः शुभाः ।\nकुमारा ये च दैत्यानां शांतिं कुर्वंतु ते सदा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002517029, "chapter_id": 22517, "verse_number": "१-१७९-३०", "content_sanskrit": "आरक्तेन शरीरण रक्तांतायतलोचनाः ।\nमहाभागाः कृताटोपाः शंखाद्याः कृतलक्षणाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002517030, "chapter_id": 22517, "verse_number": "१-१७९-३१", "content_sanskrit": "अनंतो नागराजेंद्र आदित्याराधने रतः ।\nमहापापविषं हत्वा शांतिमाशु करोतु ते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002517031, "chapter_id": 22517, "verse_number": "१-१७९-३२", "content_sanskrit": "अतिपीतेन देहेन विस्फुरद्भोगसंपदा ।\nतेजसा चातिदीप्तेन कृतस्वस्तिकलांछनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002517032, "chapter_id": 22517, "verse_number": "१-१७९-३३", "content_sanskrit": "नागराट् तक्षकः श्रीमान्नामकोट्या समन्वितः ।\nकरोतु ते महाशांतिं सर्वदोषविषापहाम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002517033, "chapter_id": 22517, "verse_number": "१-१७९-३४", "content_sanskrit": "अतिकृष्णेन वर्णेन स्फुटाधिकटमस्तकः ।\nकंठरेखात्रयोपेतो घोरदंष्ट्रायुधोद्यतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002517034, "chapter_id": 22517, "verse_number": "१-१७९-३५", "content_sanskrit": "कर्कोटको महानागो विषदर्पबलान्वितः ।\nविषशस्त्राग्निसंतापं हत्वा शांतिं करोतु ते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002517035, "chapter_id": 22517, "verse_number": "१-१७९-३६", "content_sanskrit": "पद्मवर्णः पद्मकान्तिः फुल्लपद्मायतेक्षणः ।\nख्यातः पद्मो महानागो नित्यं भास्करपूजकः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002517036, "chapter_id": 22517, "verse_number": "१-१७९-३७", "content_sanskrit": "स ते शांति शुभं शीघ्रमचलं संप्रयच्छतु ।\nश्यामेन देहभारेण श्रीमत्कमललोचनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002517037, "chapter_id": 22517, "verse_number": "१-१७९-३८", "content_sanskrit": "विषदर्पबलोन्मत्तो ग्रीवायां रेखयान्वितः ।\nशंखपालश्रिया दीप्तः सूर्यपादाब्जपूजकः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002517038, "chapter_id": 22517, "verse_number": "१-१७९-३९", "content_sanskrit": "महाविषं गरश्रेष्ठं हत्वा शांतिं करोतु ते ।\nअतिगौरेण देहेन चंद्रार्धकृतशेखरः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002517039, "chapter_id": 22517, "verse_number": "१-१७९-४०", "content_sanskrit": "दीपभागे कृताटोपशुभलक्षणलक्षितः ।\nकुलिको नाम नागेन्द्रो नित्यं सूर्यपरायणः ।\nअपहृत्य विषं घोरं करोतु तव शांतिकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002517040, "chapter_id": 22517, "verse_number": "१-१७९-४१", "content_sanskrit": "अंतरिक्षे च ये नागा ये नागाः स्वर्गसंस्थिताः ।\nगिरिकंदरदुर्गेषु ये नागा भुवि संस्थिताः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002517041, "chapter_id": 22517, "verse_number": "१-१७९-४२", "content_sanskrit": "पाताले ये स्थिता नागाः सर्वे यत्र समाहिताः ।\nसूर्यपादा र्चनासक्ताः शांतिं कुर्वंतु ते सदा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002517042, "chapter_id": 22517, "verse_number": "१-१७९-४३", "content_sanskrit": "नागिन्यो नागकन्याश्च तथा नागकुमारकाः ।\nसूर्यभक्ताः सुमनसः शांतिं कुर्वंतु ते सदा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002517043, "chapter_id": 22517, "verse_number": "१-१७९-४४", "content_sanskrit": "य इदं नामसंस्थानं कीर्तयेच्छृणुयात्तथा ।\nन तं सर्पा विहिंसति न विषं क्रमते सदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]