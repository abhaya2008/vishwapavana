[{"id": 2041279, "chapter_id": 1916, "verse_number": "५-१६१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041280, "chapter_id": 1916, "verse_number": "५-१६१-१", "content_sanskrit": "सेनानिवेशं संप्राप्तः कैतव्यः पाण्डवस्य ह ।\nसमागतः पाण्डवेयैर्युधिष्ठिरमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041281, "chapter_id": 1916, "verse_number": "५-१६१-२", "content_sanskrit": "अभिज्ञो दूतवाक्यानां यथोक्तं ब्रुवतो मम।\nदुर्योधनसमादेशं श्रुत्वा न क्रोद्धुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041282, "chapter_id": 1916, "verse_number": "५-१६१-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041283, "chapter_id": 1916, "verse_number": "५-१६१-३", "content_sanskrit": "उलूक न भयं तेऽस्ति ब्रूहि त्वं विगतज्वरः ।\nयन्मत्तं धार्तराष्ट्रस्य लुब्धस्यादीर्घदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041284, "chapter_id": 1916, "verse_number": "५-१६१-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041285, "chapter_id": 1916, "verse_number": "५-१६१-४", "content_sanskrit": "ततो द्युतिमतां मध्ये पाण्डवानां महात्मनाम्।\nसृञ्जयानां च मत्स्यानां कृष्णस्य च यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041286, "chapter_id": 1916, "verse_number": "५-१६१-५", "content_sanskrit": "द्रुपदस्य सपुत्रस्य विराटस्य च संनिधौ ।\nभूमिपानां च सर्वेषां मध्ये वाक्यं जगाद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041287, "chapter_id": 1916, "verse_number": "५-१६१-६x", "content_sanskrit": "उलूक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041288, "chapter_id": 1916, "verse_number": "५-१६१-६", "content_sanskrit": "इदं त्वामब्रवीद्राजा धार्तराष्ट्रो महामनाः ।\nश्रृण्वतां कुरुवीराणां तन्निबोध युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041289, "chapter_id": 1916, "verse_number": "५-१६१-७", "content_sanskrit": "पराजितोऽसि द्यूतेन कृष्णा चानायिता सभाम् ।\nशक्योऽमर्षो मनुष्येण कर्तुं पुरुषमानिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041290, "chapter_id": 1916, "verse_number": "५-१६१-८", "content_sanskrit": "द्वादशैव तु वर्षाणि वने धिष्ण्याद्विवासितः ।\nसंवत्सरं विराटस्य दास्यमास्थाय चोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041291, "chapter_id": 1916, "verse_number": "५-१६१-९", "content_sanskrit": "अमर्षं राज्यहरणं वनवासं च पाण्डव।\nद्रौपद्याश्च परिक्लेशं संस्मरन्पुरुषो भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041292, "chapter_id": 1916, "verse_number": "५-१६१-१०", "content_sanskrit": "अशक्तेन च यच्छप्तं भीमसेनेन पाण्डव ।\nदुःशासनस्य रुधिरं पीयतां यदि शक्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041293, "chapter_id": 1916, "verse_number": "५-१६१-११", "content_sanskrit": "लोहाभिसारो निर्वृत्तः कुरुक्षेत्रमकर्दमम्।\nसमः पन्था भृतास्तेश्वाः श्वो युध्यस्व सकेशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041294, "chapter_id": 1916, "verse_number": "५-१६१-१२", "content_sanskrit": "असमागम्य भीष्मेण संयुगे किं विकत्थसे ।\nआरुरुक्षुर्यथा पङ्गुः पर्वतं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041295, "chapter_id": 1916, "verse_number": "५-१६१-१३", "content_sanskrit": "एवं कत्थसि कौन्तेय अकत्थन्पुरुषो भव।\nसूतपुत्रं सुदुर्घर्षं शल्यं च बलिनां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041296, "chapter_id": 1916, "verse_number": "५-१६१-१४", "content_sanskrit": "द्रोणं च बलिनां श्रेष्ठं शचीपतिसमं युधि।\nअजित्वा संयुगे पार्थ राज्यं कथमिहेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041297, "chapter_id": 1916, "verse_number": "५-१६१-१५", "content_sanskrit": "ब्राह्मे धनुषि चाचार्यं वेदयोरन्तगं द्वयोः।\nयुधि धुर्यमविक्षोभ्यमनीकचरमच्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041298, "chapter_id": 1916, "verse_number": "५-१६१-१६", "content_sanskrit": "द्रोणं महाद्युतिं पार्थ जेतुमिच्छसि तन्मृषा ।\nन हि शुश्रुम वातेन मेरुमुन्मथितं गिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041299, "chapter_id": 1916, "verse_number": "५-१६१-१७", "content_sanskrit": "अनिलो वा वहेन्मेरुं द्यौर्वापि निपतेन्महीम् ।\nयुगं वा परिवर्तेत यद्येवं स्याद्यथात्थ माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041300, "chapter_id": 1916, "verse_number": "५-१६१-१८", "content_sanskrit": "को ह्यस्ति जीविताकाङ्क्षी प्राप्येममरिमर्दनम् ।\nगजो वाजी रथो वापि पुनः स्वस्ति गृहान्व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041301, "chapter_id": 1916, "verse_number": "५-१६१-१९", "content_sanskrit": "कथमाभ्यामभिध्यातः संसृष्टो दारुणेन वा ।\nरणे जीवन्विमुच्येत पदा भूमिमुपस्पृशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041302, "chapter_id": 1916, "verse_number": "५-१६१-२०", "content_sanskrit": "किं दुर्दुरः कूपशयो यथेमां\nन बुध्यमे राजचमूं समेताम्।\nदुराधरषां देवचमूप्रकाशां\nगुप्तां नरेन्द्रैस्त्रिदशैरिव द्याम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041303, "chapter_id": 1916, "verse_number": "५-१६१-२१", "content_sanskrit": "प्राच्यैः प्रतीच्यैरथ दाक्षिणात्यै-\nरुदीच्यकाम्भोजशकैः खशैश्च।\nसाल्वैः समत्स्यैः कुरुमुख्यदेश्यै-\nर्म्लेच्छैः पुलिन्दैर्द्रविडान्ध्रकाञ्च्यैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041304, "chapter_id": 1916, "verse_number": "५-१६१-२२", "content_sanskrit": "नानाजनौघं युधि संप्रवृद्धं\nनाङ्गं यथा वेगमपारकणीयम्।\nमां च स्थितं नागबलस्य मध्ये\nयुयुत्समे मन्द किमल्पबुद्धे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041305, "chapter_id": 1916, "verse_number": "५-१६१-२३", "content_sanskrit": "इत्येवमुक्त्वा राजानं धर्मपुत्रं युधिष्ठिरम्।\nअभ्यवृत्य पुनर्जिष्णुमुलूकः प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041306, "chapter_id": 1916, "verse_number": "५-१६१-२४", "content_sanskrit": "अकत्थमानो युध्यस्व कत्थेसेऽर्जुन किं बहु।\nपर्यायात्सिद्धिरेस्य नैतत्सिध्यति कत्थनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041307, "chapter_id": 1916, "verse_number": "५-१६१-२५", "content_sanskrit": "यदीदं कत्थनाल्लोके सिध्येत्कर्म धनञ्जय ।\nसर्वे भवेयुः सिद्धार्थाः कत्थने को हि दुर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041308, "chapter_id": 1916, "verse_number": "५-१६१-२६", "content_sanskrit": "जानामि ते वासुदेवं सहायं\nजानामि ते गाण्डिवं तालमात्रम्।\nजानाम्येतत्त्वादृशो नास्ति योद्धा\nजानानस्ते राज्यमेतद्धरामि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041309, "chapter_id": 1916, "verse_number": "५-१६१-२७", "content_sanskrit": "न तु पर्यायधर्मेण राज्यं प्राप्नोति मानुषः ।\nमनसैवानुकूलानि विधाता कुरुते वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041310, "chapter_id": 1916, "verse_number": "५-१६१-२८", "content_sanskrit": "त्रयोदश समा भुक्तं राज्यं विलपतस्तव ।\nभूयश्चैव प्रशासिष्ये निहत्य त्वां सबान्धवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041311, "chapter_id": 1916, "verse_number": "५-१६१-२९", "content_sanskrit": "क्व तदा गाण्डिवं तेऽभूद्यत्त्वं दासपणैर्जितः।\nक्व तदा भीमसेनस्य बलमासीच्च फाल्गुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041312, "chapter_id": 1916, "verse_number": "५-१६१-३०", "content_sanskrit": "सगदाद्भीमसेनाद्वा पार्थाद्वापि सगाण्डिवात् ।\nन वै मोक्षस्तदा वोभूद्विना कृष्णामनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041313, "chapter_id": 1916, "verse_number": "५-१६१-३१", "content_sanskrit": "सा वो दास्ये समापन्नान्मोचयामास पार्षती ।\nअमानुष्यं समापन्नान्दासकर्मण्यवस्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041314, "chapter_id": 1916, "verse_number": "५-१६१-३२", "content_sanskrit": "अवोचं यत्षण्डतिलानहं वस्तथ्यमेव तत् ।\nधृता हि वेणी पार्थेन विराटनगरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041315, "chapter_id": 1916, "verse_number": "५-१६१-३३", "content_sanskrit": "सूदकर्मणि च श्रान्तं विराटस्य महानसे ।\nभीमसेनेन कौन्तेय यच्च तन्मम पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041316, "chapter_id": 1916, "verse_number": "५-१६१-३४", "content_sanskrit": "एवमेतत्सदां दण्डं क्षत्रियाः क्षत्रिये दधुः ।\nवेणीं कृत्वा षण्डवेषः कन्यां नर्तितवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041317, "chapter_id": 1916, "verse_number": "५-१६१-३५", "content_sanskrit": "न भयाद्वासुदेवस्य न चापि तव फाल्गुन ।\nराज्यं प्रतिप्रदाकस्यामि युद्ध्यस्व सहकेशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041318, "chapter_id": 1916, "verse_number": "५-१६१-३६", "content_sanskrit": "न माया हीन्द्रजालं वा कुहका वापि भीषणा ।\nआत्तशस्त्रस्य मे युद्धे वहन्ति प्रतिगर्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041319, "chapter_id": 1916, "verse_number": "५-१६१-३७", "content_sanskrit": "वासुदेवसहस्रं वा फाल्गुनानां शतानि वा।\nआसाद्य माममोघेषुं द्रविष्यन्ति दिशो दशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2041320, "chapter_id": 1916, "verse_number": "५-१६१-३८", "content_sanskrit": "संयुगं गच्छ भूष्मेण भिन्धि वा शिरसा गिरिम्।\nतरेमं वा महागाधं सौमदत्तितिमिङ्गिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2041321, "chapter_id": 1916, "verse_number": "५-१६१-३९", "content_sanskrit": "शारद्वतमहामीनं विविंशतिमहोरगम् ।\nबृहद्बलमहोद्वेलं सौमदत्तिकतिमिङ्गितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2041322, "chapter_id": 1916, "verse_number": "५-१६१-४०", "content_sanskrit": "भीष्मवेगमपर्यन्तं द्रोणग्राहदुरासदम्।\nकर्णशल्यझषावर्तं काम्भोजबडबासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2041323, "chapter_id": 1916, "verse_number": "५-१६१-४१", "content_sanskrit": "दुःशासनौघं शलशल्यमत्स्यं\nसुषेणचित्रायुधनागनक्रम्।\nजयद्रथाद्रिं पुरुमित्रगाधं\nदुर्मर्षणोदं शकुनिप्रपातम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2041324, "chapter_id": 1916, "verse_number": "५-१६१-४२", "content_sanskrit": "शस्त्रौघमक्षय्यमतिप्रवृद्धं\nयदावगाह्य श्रमनष्टचेताः।\nभविष्यसि त्वं हतसर्वबान्धव-\nस्तदा मनस्ते परितापमेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2041325, "chapter_id": 1916, "verse_number": "५-१६१-४३", "content_sanskrit": "तदा मनस्ते त्रिदिवादिवाशुचे-\nर्निवर्तिता पार्थ महीप्रशासनात्।\nप्रशाम्य राज्यं हि सुदुर्लभं त्वया\nबुभूषितः स्वर्ग इवातपस्विना ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2041326, "chapter_id": 1916, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि उलूकदूतागमनपर्वणि एकषष्ट्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]