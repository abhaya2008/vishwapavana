[{"id": 2131472, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131473, "chapter_id": 3840, "verse_number": "१", "content_sanskrit": "निवर्तमानेन तदा(मया) महद् दृष्टं ततोऽपरम् ।\nपुरं कामगमं(चरं) दिव्यं पावकार्कसमप्रभम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131474, "chapter_id": 3840, "verse_number": "२", "content_sanskrit": "रत्नद्रुममयैश्चित्रैः सुस्वरैश्च पतत्त्रिभिः ।\nपौलोमैः कालकेयै(कञ्जै)श्च नित्यहृष्टैरधिष्ठितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131475, "chapter_id": 3840, "verse_number": "३", "content_sanskrit": "गोपुराट्टालकोपेतं चतुर्द्वारं दुरासदम् ।\nसर्वरत्नमयं दिव्यमद्भुतोपमदर्शनम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131476, "chapter_id": 3840, "verse_number": "४", "content_sanskrit": "द्रुमैः पुष्पफलोपेतैः सर्वरत्नमयैर्वृतम् ।\nतथा पतत्त्रिभिर्दिव्यैरुपेतं सुमनोहरैः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131477, "chapter_id": 3840, "verse_number": "५", "content_sanskrit": "असुरैर्नित्यमुदितैः शूलर्ष्टिमुसलायुधैः ।\nचापमुद्गरहस्तैश्च स्रग्विभिः सर्वतो वृतम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131478, "chapter_id": 3840, "verse_number": "६", "content_sanskrit": "तदहं प्रेक्ष्य दैत्यानां पुरमद्भुतदर्शनम् ।\nअपृच्छं मातलिं राजन् किमिदं वर्ततेऽद्भुतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131479, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "मातलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131480, "chapter_id": 3840, "verse_number": "७", "content_sanskrit": "पुलोमा नाम दैतेयी कालका च महासुरी ।\nदिव्यं वर्षसहस्रं ते चेरतुः परमं तपः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131481, "chapter_id": 3840, "verse_number": "८", "content_sanskrit": "तपसोऽन्ते ततस्ताभ्यां स्वयम्भूरददाद् वरम् ।\nअगृह्णीतां वरं ते तु सुतानामल्पदुःखताम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131482, "chapter_id": 3840, "verse_number": "९", "content_sanskrit": "अवध्यतां च राजेन्द्र सुरराक्षसपन्नगैः ।\nपुरं सुरमणीयं च खचरं सुमहाप्रभम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131483, "chapter_id": 3840, "verse_number": "१०", "content_sanskrit": "सर्वरत्नैः समुदितं दुर्धर्षममरैरपि ।\nमहर्षियक्षगन्धर्वपन्नगासुरराक्षसैः ।\nसर्वकामगुणोपेतं वीतशोकमनामयम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131484, "chapter_id": 3840, "verse_number": "११", "content_sanskrit": "ब्रह्मणा भरतश्रेष्ठ कालकेयकृते कृतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131485, "chapter_id": 3840, "verse_number": "१२", "content_sanskrit": "तदेतत्खपुरं दिव्यं चरत्यमरवर्जितम् ।\nपौलोमाध्युषितं वीर कालकञ्जैश्च दानवैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131486, "chapter_id": 3840, "verse_number": "१३", "content_sanskrit": "हिरण्यपुरामित्येवं ख्यायते नगरं महत् ।\nरक्षितं कालकेयैश्च पौलोमैश्च महासुरैः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131487, "chapter_id": 3840, "verse_number": "१४", "content_sanskrit": "त एते मुदिता राजन्नवध्याः सर्वदैवतैः ।\nनिवसन्त्यत्र राजेन्द्र गतोद्वेगा निरुत्सुकाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131488, "chapter_id": 3840, "verse_number": "१५", "content_sanskrit": "सुरासुरैरवध्यानां दानवानां धनञ्जय ।\nमानुषान्मृत्युरेतेषां निर्दिष्टो ब्रह्मणा पुरा \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131489, "chapter_id": 3840, "verse_number": "१६", "content_sanskrit": "एतानपि रणे पार्थ कालकञ्जान् दुरासदान् ।\nवज्रास्त्रेण नयस्वाशु विनाशं सुमहाबलान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131490, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131491, "chapter_id": 3840, "verse_number": "१७", "content_sanskrit": "सुरासुरैरवध्यं तदहं ज्ञात्वा विशाम्पते ।\nअब्रुवं मातलिं हृष्टो याह्येतत्पुरमञ्जसा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131492, "chapter_id": 3840, "verse_number": "१८", "content_sanskrit": "त्रिदशेशद्विषो यावत् क्षयमस्त्रैर्नयाम्यहम् ।\nन कथञ्चिद्धि मे पापा नवध्या ये सुरद्विषः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131493, "chapter_id": 3840, "verse_number": "१९", "content_sanskrit": "उवाह मां ततः शीघ्रं हिरण्यपुरमन्तिकात् ।\nरथेन तेन दिव्येन हरियुक्तेन मातलिः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131494, "chapter_id": 3840, "verse_number": "२०", "content_sanskrit": "ते मामालक्ष्य दैतेया विचित्राभरणाम्बराः ।\nसमुत्पेतुर्महावेगा रथानास्थाय दंसिताः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131495, "chapter_id": 3840, "verse_number": "२१", "content_sanskrit": "ततो नालीकनाराचैर्भल्लैः शक्त्यृष्टितोमरैः ।\nप्रत्यघ्नन् दानवेन्द्रा मां क्रुद्धास्तीव्रपराक्रमाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131496, "chapter_id": 3840, "verse_number": "२२", "content_sanskrit": "तदहं शरवर्षेण महता प्रत्यवारयम् ।\nशस्त्रवर्षं महद् राजन् विद्याबलमुपाश्रितः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131497, "chapter_id": 3840, "verse_number": "२३", "content_sanskrit": "व्यामोहयं च तान् सर्वान् रथमार्गैश्चरन् रणे ।\nतेऽन्योन्यमभिसम्मूढाः पातयन्ति स्म दानवान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131498, "chapter_id": 3840, "verse_number": "२४", "content_sanskrit": "तेषामेवं विमूढानामन्योन्यमभिधावताम् ।\nशिरांसि विशिखैर्दीप्तैर्न्यहनं शतसङ्घशः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131499, "chapter_id": 3840, "verse_number": "२५", "content_sanskrit": "ते वध्यमाना दैतेयाः पुरमास्थाय तत्पुनः ।\nस(ख)मुत्पेतुः स नगरा मायामास्थाय दानवीम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131500, "chapter_id": 3840, "verse_number": "२६", "content_sanskrit": "ततोऽहं शरवर्षेण महता कुरुनन्दन ।\nमार्गमावृत्य दैत्यानां गतिं चैषामवारयम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131501, "chapter_id": 3840, "verse_number": "२७", "content_sanskrit": "तत्पुरं खचरं दिव्यं कामगं सूर्यसप्रभम् ।\nदैतेयैर्वरदानेन धार्यते स्म यथासुखम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131502, "chapter_id": 3840, "verse_number": "२८", "content_sanskrit": "अन्तर्भूमौ निपतति पुनरूर्ध्वं प्रतिष्ठते ।\nपुनस्तिर्यक् प्रयात्याशु पुनरप्सु निमज्जति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131503, "chapter_id": 3840, "verse_number": "२९", "content_sanskrit": "अमरावतिसङ्काशं तत्पुरं कामगं महत् ।\nअहमस्त्रैर्बहुविधैः प्रत्यगृह्णं परन्तप\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131504, "chapter_id": 3840, "verse_number": "३०", "content_sanskrit": "ततोऽहं शरजालेन दिव्यास्त्रनुदितेन च ।\nव्यगृह्णं सह दैतेयैस्तत्पुरं पुरुषर्षभ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131505, "chapter_id": 3840, "verse_number": "३१", "content_sanskrit": "विक्षतं चायसैर्बाणैर्मत्प्रयुक्तैरजिह्मगैः ।\nमहीमभ्यपतद् राजन् प्रभग्नं पुरमासुरम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131506, "chapter_id": 3840, "verse_number": "३२", "content_sanskrit": "ते वध्यमाना मद्बाणैर्वज्रवेगैरयस्मयैः ।\nपर्यभ्रमन्त वै राजन्नसुराः कालचोदिताः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2131507, "chapter_id": 3840, "verse_number": "३३", "content_sanskrit": "ततो मातलिरारुह्य पुरस्तान्निपतन्निव ।\nमहीमवातरत् क्षिप्रं रथेनादित्यवर्चसा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2131508, "chapter_id": 3840, "verse_number": "३४", "content_sanskrit": "युयुत्सूनां मया सार्धं पर्यवर्तन्त भारत ।\nतान्यहं निशितैर्बाणैर्व्यधमं गार्ध्रराजितैः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2131509, "chapter_id": 3840, "verse_number": "३५", "content_sanskrit": "ते युद्धे सन्न्यवर्तन्त समुद्रस्य यथोर्मयः ।\nनेमे शक्या मानुषेण युद्धेनेति प्रचिन्त्य तत् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2131510, "chapter_id": 3840, "verse_number": "३६", "content_sanskrit": "ततोऽहमानुपूर्व्येण दिव्यान्यस्त्राण्ययोजयम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2131511, "chapter_id": 3840, "verse_number": "३७", "content_sanskrit": "ततस्तानि सहस्राणि रथिनां चित्रयोधिनाम् ।\nअस्त्राणि मम दिव्यानि प्रत्यघ्नन् शनकैरिव \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2131512, "chapter_id": 3840, "verse_number": "३८", "content_sanskrit": "रथमार्गान् विचित्रांस्ते विचरन्तो महाबलाः ।\nप्रत्यदृश्यन्त सङ्ग्रामे शतशोऽथ सहस्रशः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2131513, "chapter_id": 3840, "verse_number": "३९", "content_sanskrit": "विचित्रमुकुटापीडा विचित्रकवचध्वजाः ।\nविचित्राभरणाश्चैव नन्दयन्तीव मे मनः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2131514, "chapter_id": 3840, "verse_number": "४०", "content_sanskrit": "अहं तु शरवर्षैस्तानस्त्रप्रचुदितैः रणे ।\nनाशक्नुवं पीडयितुं ते तु मां प्रत्यपीडयन्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2131515, "chapter_id": 3840, "verse_number": "४१", "content_sanskrit": "तैः पीड्यमानो बहुभिः कृतास्त्रैः कुशलैर्युधि ।\nव्यथितोऽस्मि महायुद्धे भयं चागान्महन्मम\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2131516, "chapter_id": 3840, "verse_number": "४२", "content_sanskrit": "ततोऽहं परमायत्तो मातलिं परिपृष्टवान् ।\nकिमेते मम बाणौघैर्दिव्यास्त्रप्रतिमन्त्रितैः ।\nन वध्यन्ते महाघोरैस्तत्त्वमाख्याहि पृच्छतः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2131517, "chapter_id": 3840, "verse_number": "४३", "content_sanskrit": "स मामुवाच पर्याप्तस्त्वमेषां भरतर्षभ ।\nतानुद्दिश्याथ मर्माणि प्रतिघातं तदाचर \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2131518, "chapter_id": 3840, "verse_number": "४४", "content_sanskrit": "एतच्छ्रुत्वा तु राजेन्द्र सम्प्रहृष्टस्तमूचिवान् ।\nनिवर्तय रथं शीघ्रं पश्य चैतान् निपातितान्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2131519, "chapter_id": 3840, "verse_number": "४५", "content_sanskrit": "एवमुक्तो रथं तत्र मातलिः पर्यवर्तयत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2131520, "chapter_id": 3840, "verse_number": "४६", "content_sanskrit": "ततो मत्वा रणे भग्नं दानवाः प्रतिहर्षिताः ।\nविचुक्रुशुर्महाराज स्वरेण महाता मुहुः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2131521, "chapter_id": 3840, "verse_number": "४७", "content_sanskrit": "अभग्नः कैश्चिदप्येष पाण्डवो रणमूर्धनि ।\nअस्माभिस्समरे भग्न इत्येवं सङ्घशस्तदा\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2131522, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "ततोऽहं देवदेवाय रुद्राय प्रयतो रणे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2131523, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "महत्पाशुपतं दिव्यं सर्वलोकनमस्कृतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2131524, "chapter_id": 3840, "verse_number": "४८", "content_sanskrit": "प्रयतः प्रणतो भूत्वा नमस्कृत्य महात्मने ।\nस्वस्ति भूतेभ्य इत्युक्त्वा महास्त्रं समचोदयम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2131525, "chapter_id": 3840, "verse_number": "४९", "content_sanskrit": "यत्तद् रौद्रमिति ख्यातं सर्वामित्रविनाशनम् ।\nअहं पाशुपतं दिव्यं सर्वलोकनमस्कृतम् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2131526, "chapter_id": 3840, "verse_number": "५०", "content_sanskrit": "ततोऽपश्यं त्रिशिरसं पुरुषं नवलोचनम् ।\nत्रिमुखं षड्भुजं दीप्तमर्कज्वलनमूर्धजम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2131527, "chapter_id": 3840, "verse_number": "५१", "content_sanskrit": "लेलिहानैर्महानागैः कृतचौड(चीर)ममित्रहन् ।\nभक्तानुकम्पिनं देवं नागयज्ञोपवीतिनम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2131528, "chapter_id": 3840, "verse_number": "५२", "content_sanskrit": "विभो(भी)स्ततस्तदस्त्रं तु घोरं रौद्रं सनातनम् ।\nदृष्ट्वा गाण्डीवसंयोगमानीय भरतर्षभ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2131529, "chapter_id": 3840, "verse_number": "५३", "content_sanskrit": "नमस्कृत्वा त्रिनेत्राय शर्वायामिततेजसे ।\nमुक्तवान् दानवेन्द्राणां पराभावाय भारत\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2131530, "chapter_id": 3840, "verse_number": "५४", "content_sanskrit": "मुक्तमात्रे ततस्तस्मिन् रूपाण्यासन् सहस्रशः ।\nमृगाणामथ सिंहानां व्याघ्राणां च विशाम्पते\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2131531, "chapter_id": 3840, "verse_number": "५५", "content_sanskrit": "ऋक्षाणां महिषाणां च पन्नगानां तथा गवाम् ।\nशरभाणां गजानां च वानराणां च सङ्घशः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2131532, "chapter_id": 3840, "verse_number": "५६", "content_sanskrit": "ऋषभाणां वराहाणां मार्जाराणां तथैव च ।\nऋक्षाश्वगजवक्त्राणामुलूकानां तथैव च \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2131533, "chapter_id": 3840, "verse_number": "५७", "content_sanskrit": "मीनवायसरूपाणां नानावक्त्रप्रचारिणाम् ।\nसालावृकाणां प्रेतानां मुरुण्टानां च सर्वशः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2131534, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "शार्दूलानां वराहाणां शरभाणां प्रवल्गताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2131535, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "गृध्राणां गरुडानां च चमराणां तथैव च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2131536, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "देवानां च ऋषीणां च गन्धर्वाणां च सर्वशः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2131537, "chapter_id": 3840, "verse_number": "५८", "content_sanskrit": "पिशाचानां सयक्षाणां तथैव च सुरद्विषाम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2131538, "chapter_id": 3840, "verse_number": "५९", "content_sanskrit": "गुह्यकानां च सङ्ग्रामे नैर्ऋतानां तथैव च ।\nझषाणां गजवक्त्राणामुलूकानां तथैव च\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2131539, "chapter_id": 3840, "verse_number": "६०", "content_sanskrit": "मीनवाजिसरूपाणां नानाशस्त्रासिपाणिनाम् ।\nतथैव यातुधानानां गदामुद्गरधारिणाम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2131540, "chapter_id": 3840, "verse_number": "६१", "content_sanskrit": "एतैश्चान्यैश्च बहुभिर्नानारूपधरैस्तथा ।\nसर्वमासीज्जगद् व्याप्तं तस्मिन्नस्त्रे विसर्जिते\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2131541, "chapter_id": 3840, "verse_number": "६२", "content_sanskrit": "त्रिशिरोभिश्चतुर्दंष्ट्रैश्चतुरास्यैश्चतुर्भुजैः ।\nअनेकरूपसंयुक्तैर्मांसमेदोवसाशिभिः ।\nअभीक्ष्णं वध्यमानास्ते दानवा नाशमागताः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2131542, "chapter_id": 3840, "verse_number": "६३", "content_sanskrit": "अर्कज्वलनतेजोभिर्वज्राशनिसमप्रभैः \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2131543, "chapter_id": 3840, "verse_number": "६४", "content_sanskrit": "अद्रिसारमयैश्चान्यैर्बाणैरपि निबर्हणैः ।\nन्यहनं दानवान् सर्वान् मुहूर्तेनैव भारत\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2131544, "chapter_id": 3840, "verse_number": "६५", "content_sanskrit": "गाण्डीवास्त्रप्रणुन्नांस्तान् गतासून् नभसश्च्युतान् ।\nदृष्ट्वाऽहं प्रणमं भूयस्त्रिपुरघ्नाय वेधसे\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2131545, "chapter_id": 3840, "verse_number": "६६", "content_sanskrit": "तथा रौद्रास्त्रनिष्पिष्टान् दिव्याभरणभूषितान् ।\nनिशाम्य परमं हर्षमगमद् देवसारथिः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2131546, "chapter_id": 3840, "verse_number": "६७", "content_sanskrit": "तदसह्यं कृतं कर्म देवैरपि दुरासदम्।\nदृष्ट्वा मां पूजयामास मातलिः शक्रसारथिः \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2131547, "chapter_id": 3840, "verse_number": "६८", "content_sanskrit": "उवाच वचनं चेदं प्रीयमाणः कृताञ्जलिः ।\nहतांस्तान् दानवान् दृष्ट्वा मया सङ्खे सहस्रशः \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2131548, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "मातलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2131549, "chapter_id": 3840, "verse_number": "६९", "content_sanskrit": "सुरासुरैरसह्यं हि कर्म यत् साधितं त्वया ।\nन ह्येतत् संयुगे कर्तुमपि शक्तः सुरेश्वरः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2131550, "chapter_id": 3840, "verse_number": "७०", "content_sanskrit": "ध्रुवं धनञ्जय प्रीतस्त्वयि शक्रः पुरार्दन \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2131551, "chapter_id": 3840, "verse_number": "७१", "content_sanskrit": "सुरासुरैरवध्यं हि पुरमेतत् खगं महत् ।\nत्वया विमथितं वीर स्ववीर्यतपसो बलात्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2131552, "chapter_id": 3840, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2131553, "chapter_id": 3840, "verse_number": "७२", "content_sanskrit": "विध्वस्ते खपुरे तस्मिन् दानवेषु हतेषु च ।\nविनदन्त्यः स्त्रियः सर्वा निष्पेतुर्नगराद् बहिः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2131554, "chapter_id": 3840, "verse_number": "७३", "content_sanskrit": "प्रकीर्णकेश्यो व्यथिताः कुरर्य इव दुःखिताः ।\nकुरर्य इव वाशन्त्यो दुःखिताश्च मुहुर्मुहुः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2131555, "chapter_id": 3840, "verse_number": "७४", "content_sanskrit": "पेतुः पुत्रान् पितॄन् भ्रातॄन् शोचमाना महीतळे ।\nरुदत्यो दीनकण्ठ्यस्तु निनदन्त्यो हतेश्वराः ।\nउरांसि परिनिघ्नन्त्यो विस्रस्तस्रग्विभूषणाः \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2131556, "chapter_id": 3840, "verse_number": "७५", "content_sanskrit": "तच्छोकयुक्तमश्रीकं दुःखदैन्यसमाहतम् ।\nन बभौ दानवपुरं हतत्विट्कं हतेश्वरम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2131557, "chapter_id": 3840, "verse_number": "७६", "content_sanskrit": "गन्धर्वनगराकारं हतनागमिव ह्रदम् ।\nशुष्कवृक्षमिवारण्यमदृश्यमभवत् पुरम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2131558, "chapter_id": 3840, "verse_number": "७७", "content_sanskrit": "मां तु संहृष्टमनसं क्षिप्रं मातलिरानयत् ।\nदेवराजस्य भवनं कृतकर्माणमाहवात्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2131559, "chapter_id": 3840, "verse_number": "७८", "content_sanskrit": "हिरण्यपुरमुत्सृज्य निहत्य च महासुरान् ।\nनिवातकवचांश्चैव ततोऽहं शक्रमागमम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2131560, "chapter_id": 3840, "verse_number": "७९", "content_sanskrit": "मम कर्म च देवेन्द्रं मातलिर्विस्तरेण तत् ।\nसर्वं विश्रावयामास यथाभूतं महाद्युते\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2131561, "chapter_id": 3840, "verse_number": "८०", "content_sanskrit": "हिरण्यपुरघातं च मायानां च निवारणम् ।\nनिवातकवचानां च वधं सङ्खे महौजसाम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2131562, "chapter_id": 3840, "verse_number": "८१", "content_sanskrit": "कालकेयवधञ्चैव अद्भुतं रोमहर्षणम् ।\nतच्छ्रुत्वा भगवान् प्रीतः सहस्राक्षः पुरन्दरः \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2131563, "chapter_id": 3840, "verse_number": "८२", "content_sanskrit": "मरुद्भिः सहितः श्रीमान् साधु साध्वित्यथाब्रवीत् ।\nपरिष्वज्य च मां प्रेम्णा मूर्ध्नि चाघ्राय सस्मितम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2131564, "chapter_id": 3840, "verse_number": "८३", "content_sanskrit": "ततो मां देवराजो वै समाश्वास्य पुनः पुनः ।\nअब्रवीद् विबुधैः सार्धमिदं स मधुरं वचः \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2131565, "chapter_id": 3840, "verse_number": "८४", "content_sanskrit": "अतिदेवासुरं कर्म कृतमेव त्वया रणे ।\nगुर्वर्थश्च कृतः पार्थ महाशत्रून् घ्नता मम\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2131566, "chapter_id": 3840, "verse_number": "८५", "content_sanskrit": "एवमेव सदा भाव्यं स्थिरेणाजौ धनञ्जय ।\nअसम्मूढेन चास्त्राणां कर्तव्यं प्रतिपादनम् \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2131567, "chapter_id": 3840, "verse_number": "८६", "content_sanskrit": "अविषह्यो रणे हि त्वं देवदानवराक्षसैः ।\nसयक्षासुरगन्धर्वैः सपक्षिगणपन्नगैः \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2131568, "chapter_id": 3840, "verse_number": "८७", "content_sanskrit": "वसुधां चापि कौन्तेय त्वद्बाहुबलनिर्जिताम् ।\nपालयिष्यति धर्मात्मा कुन्तीपुत्रो युधिष्ठिरः \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2131569, "chapter_id": 3840, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2131570, "chapter_id": 3840, "verse_number": "१५", "content_sanskrit": "अष्टषष्ट्यधिकशततमोऽध्यायः ॥१६८॥ यक्षयुद्धपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]