[{"id": 2087577, "chapter_id": 2855, "verse_number": "१२-३६०-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087578, "chapter_id": 2855, "verse_number": "१२-३६०-१", "content_sanskrit": "बहवः पुरुषा ब्रह्मन्नुताहो एक एव तु।\nको ह्यत्र पुरुषः श्रेष्ठः को वा योनिरिहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087579, "chapter_id": 2855, "verse_number": "१२-३६०-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087580, "chapter_id": 2855, "verse_number": "१२-३६०-२", "content_sanskrit": "बहवः पुरुषा लोके साङ्ग्ययोगविचारणे।\nनैतदिच्छन्ति पुरुषमेकं कुरुकुलोद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087581, "chapter_id": 2855, "verse_number": "१२-३६०-३", "content_sanskrit": "बहनां पुरुषाणां च यथैका योनिरुच्यते।\nतथा तं पुरुषं विश्वं व्याख्यास्यामि गुणाधिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087582, "chapter_id": 2855, "verse_number": "१२-३६०-४", "content_sanskrit": "नमस्कृत्वा च गुरवे व्यासाय विदितात्मने।\nतपोयुक्ताय दान्ताय वन्द्याय परमपये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087583, "chapter_id": 2855, "verse_number": "१२-३६०-५", "content_sanskrit": "इदं पुरुषसूक्तं हि सर्ववेदेषु पार्थिव।\nऋतं सत्यं च विख्यातमृपिसिंहेन चिन्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087584, "chapter_id": 2855, "verse_number": "१२-३६०-६", "content_sanskrit": "उत्सर्गेणापवादेन ऋषिभिः कपिलादिभिः।\nअध्यान्मचिन्तामाश्रित्य शास्त्राण्युक्तानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087585, "chapter_id": 2855, "verse_number": "१२-३६०-७", "content_sanskrit": "समासतेस्तु यद्व्यासः पुरुषैकत्वमुक्तवान्।\nतत्तेऽहं संप्रवक्ष्यामि प्रसादादमितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087586, "chapter_id": 2855, "verse_number": "१२-३६०-८", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nब्रह्मणा सह संवादं त्र्यम्बकस्य विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087587, "chapter_id": 2855, "verse_number": "१२-३६०-९", "content_sanskrit": "क्षीरोदस्य समुद्रस्य मध्ये हाटकसप्रभः।\nवैजयन्त इति ख्यातः पर्वतप्रवरो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087588, "chapter_id": 2855, "verse_number": "१२-३६०-१०", "content_sanskrit": "तत्राध्यात्मगतिं देव एकाकी प्रविचिन्तयन्।\nवैराजसदनान्नित्यं वैजयन्तं निपेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087589, "chapter_id": 2855, "verse_number": "१२-३६०-११", "content_sanskrit": "अथ तत्राऽऽसतस्तस्य चतुर्वक्रस्य धीमतः।\nललाटप्रभवः पुत्रः शिव आगाद्यदृच्छया।\nआकाशेन महायोगी पुरा त्रिनयनः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087590, "chapter_id": 2855, "verse_number": "१२-३६०-१२", "content_sanskrit": "ततः खान्निपपाताशु धरणीधरमूर्धनि।\nअग्रतश्चाभवत्प्रीतो ववन्दे चापि पादयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087591, "chapter_id": 2855, "verse_number": "१२-३६०-१३", "content_sanskrit": "तं पादयोनिंपतितं दृष्ट्वा सव्येन पाणिना।\nअत्थापयामास तदा प्रभुरेकः प्रजापतिः।\nउवाच चैनं भगवांश्चिरस्यागतमात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087592, "chapter_id": 2855, "verse_number": "१२-३६०-१४x", "content_sanskrit": "पितामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087593, "chapter_id": 2855, "verse_number": "१२-३६०-१४", "content_sanskrit": "स्वागतं ते महाबाहो दिष्ट्या प्राप्तोसि मेऽन्तिकम्।\nकच्चित्ते कुशलं पुत्र स्वाध्यायतपसोः सदा।\nनित्यमुग्रतपास्त्वं हि ततः पृच्छामि ते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087594, "chapter_id": 2855, "verse_number": "१२-३६०-१५x", "content_sanskrit": "रुद्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087595, "chapter_id": 2855, "verse_number": "१२-३६०-१५", "content_sanskrit": "त्वत्प्रसादेन भगवन्स्वाध्यायतपसोर्मम।\nकृशलं चाव्ययं चैव सर्वस्य जगतस्त्वथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087596, "chapter_id": 2855, "verse_number": "१२-३६०-१६", "content_sanskrit": "चिरदृष्टोमि भगवन्वैराजसदने मया।\nततोऽहं पर्वतं प्राप्तस्त्विमं त्वत्पादसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087597, "chapter_id": 2855, "verse_number": "१२-३६०-१७", "content_sanskrit": "कौतूहलं चापि हि मे एकान्तगमनेन ते।\nनैतत्कारणमल्पं हि भविष्यति पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087598, "chapter_id": 2855, "verse_number": "१२-३६०-१८", "content_sanskrit": "किंनु तत्सदनं श्रेष्ठं क्षुत्पिपासाविवर्जितम्।\nसुरासुरैरध्युपितमृषिभिश्चामितप्रभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087599, "chapter_id": 2855, "verse_number": "१२-३६०-१९", "content_sanskrit": "गन्धर्वैरेप्सरोभिश्च सततं संनिषेवितम्।\nउत्सृज्येमं गिरिवरमेकाकी प्राप्तवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087600, "chapter_id": 2855, "verse_number": "१२-३६०-२०x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087601, "chapter_id": 2855, "verse_number": "१२-३६०-२०", "content_sanskrit": "वैजयन्तो गिरिवरः सततं सेव्यते मया।\nअत्रैकाग्रेण मनसा पुरुषश्चिन्त्यते विराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087602, "chapter_id": 2855, "verse_number": "१२-३६०-२१x", "content_sanskrit": "रुद्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087603, "chapter_id": 2855, "verse_number": "१२-३६०-२१", "content_sanskrit": "बहवः पुरुषा ब्रह्मंस्त्वया सृष्टाः स्वयंभुव।\nसृज्यन्ते चापरे ब्रह्मन्स चैकः पुरुषो विराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087604, "chapter_id": 2855, "verse_number": "१२-३६०-२२", "content_sanskrit": "को ह्यसौ चिन्त्यते ब्रह्मंस्त्वयैकः पुरुषोत्तमः।\nएतन्मे संशयं छिन्धि महत्कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087605, "chapter_id": 2855, "verse_number": "१२-३६०-२३x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2087606, "chapter_id": 2855, "verse_number": "१२-३६०-२३", "content_sanskrit": "बहवः पुरुषाः पुत्र त्वया ये समुदाहृताः।\nएवमेतदतिक्रान्तं द्रष्टव्यं नैवमित्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2087607, "chapter_id": 2855, "verse_number": "१२-३६०-२४", "content_sanskrit": "आधारं तु प्रवक्ष्यामि एकस्य पुरुषस्य ते।\nबहूनां पुरुषाणां स यथैका योनिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2087608, "chapter_id": 2855, "verse_number": "१२-३६०-२५", "content_sanskrit": "तथा तं पुरुषं विश्वं परमं सुमहत्तमम्।\nनिर्गुणं निर्गुणा भूत्वा प्रविशन्ति सनातनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2087609, "chapter_id": 2855, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये षष्ट्यधिकत्रिशततमोऽध्यायः॥ ३६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]