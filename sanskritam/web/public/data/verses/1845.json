[{"id": 2038593, "chapter_id": 1845, "verse_number": "५-९०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038594, "chapter_id": 1845, "verse_number": "५-९०-१", "content_sanskrit": "अथोपगम्य विदुरमपराह्णे जनार्दनः।\nपितृष्वसारं स पृथामभ्यगच्छदरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038595, "chapter_id": 1845, "verse_number": "५-९०-२", "content_sanskrit": "सा दृष्ट्वा कृष्णमायान्तं प्रसन्नादित्यवर्चसम्।\nकण्ठे गृहीत्वा प्राक्रोशत्स्मरन्ती तनयान्पृथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038596, "chapter_id": 1845, "verse_number": "५-९०-३", "content_sanskrit": "तेषां सत्ववतां मध्ये गोविन्दं सहचारिणम् ।\nचिरस्य दृष्ट्वा वार्ष्णेयं बाष्पमाहारयत्मृथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038597, "chapter_id": 1845, "verse_number": "५-९०-४", "content_sanskrit": "साऽब्रवीत्कृष्णमासीनं कृतातिथ्यं युधां पतिम् ।\nबाष्पगद्गदपूर्णेन मुखेन परिशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038598, "chapter_id": 1845, "verse_number": "५-९०-५", "content_sanskrit": "एते बाल्यान्प्रभृत्येव गुरुशुश्रूषणे रताः ।\nपरस्परस्य सुहृदः संमताः समचेतसः।\nनिकृत्या भ्रंशिता राज्याञ्जनार्हा निर्जनं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038599, "chapter_id": 1845, "verse_number": "५-९०-६", "content_sanskrit": "विनीतक्रोधहर्षाश्च ब्रह्मण्याः सत्यवादिनः ।\nत्यक्त्वा प्रियमुखे पार्था रुदतीमपहाय माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038600, "chapter_id": 1845, "verse_number": "५-९०-७", "content_sanskrit": "अहार्षुश्च वनं यान्तः समूलं हृदयं मम।\nअतदर्हा महात्मानः कथं केशव पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038601, "chapter_id": 1845, "verse_number": "५-९०-८", "content_sanskrit": "ऊषुर्महावने तात सिंहव्याघ्रगजाकुले ।\nबाला विहीनाः पित्रा ते मया सततलालिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038602, "chapter_id": 1845, "verse_number": "५-९०-९", "content_sanskrit": "अपश्यन्तश्च पितरौ कथमुषूर्महावने।\nशङ्खदुन्दुभिनिर्घोषैर्भृदङ्गैर्वेणुनिस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038603, "chapter_id": 1845, "verse_number": "५-९०-१०", "content_sanskrit": "पाण्डवाः समबोध्यन्त बाल्यात्प्रभृति केशव ।\nये स्म वारणशब्देन हयानां हेषितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038604, "chapter_id": 1845, "verse_number": "५-९०-११", "content_sanskrit": "रथेनेमिनिनादैश्च व्यबोध्यन्त तदा गृहे ।\nशङ्खभेरीनिनादेन वेणुवीणानुनादिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038605, "chapter_id": 1845, "verse_number": "५-९०-१२", "content_sanskrit": "पुण्याहघोषमिश्रेण पूज्यमाना द्विजातिभिः ।\nवस्त्रै रत्नैरलङ्कारैः पूजयन्तो द्विजन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038606, "chapter_id": 1845, "verse_number": "५-९०-१३", "content_sanskrit": "गीर्भिर्मङ्गलयुक्ताभिर्ब्राह्मणानां महात्मनाम् ।\nअर्चितैरर्चनार्हैश्च स्तुवद्भिरभिनन्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038607, "chapter_id": 1845, "verse_number": "५-९०-१४", "content_sanskrit": "प्रासादाग्नेष्वबोध्यन्त राङ्खवाजिनशायिनः ।\nक्रूरं च निनदं श्रुत्वा श्वापदानां महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038608, "chapter_id": 1845, "verse_number": "५-९०-१५", "content_sanskrit": "न स्मोपयान्ति निद्रां ते नतदर्हा जनार्दन ।\nभेरीमृदङ्गनिनदैः शङ्खवैणवनिस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038609, "chapter_id": 1845, "verse_number": "५-९०-१६", "content_sanskrit": "स्त्रीणां गीतनिनादैश्च मधुरैर्मधुसूदन ॥\nवन्दिमागधसूतैश्च स्तुवद्भिर्बोधिताः कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038610, "chapter_id": 1845, "verse_number": "५-९०-१७", "content_sanskrit": "महावनेष्वबोध्यन्त श्वापदानां रुतेन च ।\nह्रीमात्सत्यधृतिर्दान्तो भूतानामनुकम्पिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038611, "chapter_id": 1845, "verse_number": "५-९०-१८", "content_sanskrit": "कामद्वेषौ वशे कृत्वा सतां वर्त्मानुवर्तते ।\nअम्बरीषस्य मान्धातुर्ययातेर्नहुषस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038612, "chapter_id": 1845, "verse_number": "५-९०-१९", "content_sanskrit": "भरतस्य दिलीपस्य शिबेरौशीनरस्य च।\nराजर्षीणां पुराणानां धुरं धत्ते दुरुद्वहाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038613, "chapter_id": 1845, "verse_number": "५-९०-२०", "content_sanskrit": "शीलवृत्तोपसंपन्नोः धर्मज्ञः सत्यसङ्गरः ।\nराजा सर्वगुणोपेतस्त्रौलोक्यस्यापि यो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038614, "chapter_id": 1845, "verse_number": "५-९०-२१", "content_sanskrit": "अजातशत्रुर्धर्मात्मा शुद्धजाम्बूनदप्रभः ।\nश्रेष्ठः कुरुषु सर्वेषु धर्मतः श्रुतवृत्ततः ।\nप्रियदर्शो दीर्घभुजः कथं कृष्ण युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038615, "chapter_id": 1845, "verse_number": "५-९०-२२", "content_sanskrit": "यः स नागायुतप्राणो वातरंहा महाबलः ।\nसामर्षः पाण्डवो नित्यं प्रियो भ्रातुः प्रियंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038616, "chapter_id": 1845, "verse_number": "५-९०-२३", "content_sanskrit": "कीचकस्य तु सज्ञातेर्यो हन्ता मधुसूदन ।\nशूरः क्रोधवशानां च हिडिम्बस्य बकस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038617, "chapter_id": 1845, "verse_number": "५-९०-२४", "content_sanskrit": "पराक्रमे शक्रसमो मातरिश्वसमो बले।\nमहेश्वरसमः क्रोधे भीमः प्रहरतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038618, "chapter_id": 1845, "verse_number": "५-९०-२५", "content_sanskrit": "क्रोधं बलममर्षं च यो निधाय परंतपः ।\nजितात्मा पाण्डवोऽमर्षी भ्रातुस्तिष्ठति शासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038619, "chapter_id": 1845, "verse_number": "५-९०-२६", "content_sanskrit": "तेजोराशिं महात्मानं वरिष्ठमभितौजसम् ।\nभीमं प्रदर्शनेनापि भीमसेनं जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038620, "chapter_id": 1845, "verse_number": "५-९०-२७", "content_sanskrit": "तं ममाचक्ष्व वार्ष्णेय कथमद्य वृकोदरः ।\nआस्ते परिघबाहुः स मध्यमः पाण्डवो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038621, "chapter_id": 1845, "verse_number": "५-९०-२८", "content_sanskrit": "अर्जुनेनार्जुनो यः स कृष्ण बाहुसहस्रिणा ।\nद्विबाहुः स्पर्धते नित्यमतीतेनापि केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038622, "chapter_id": 1845, "verse_number": "५-९०-२९", "content_sanskrit": "क्षिपत्येकेन वेगेन पञ्चबाणशतानि यः ।\nइष्वस्त्रे सदृशो राज्ञः कार्तवीर्यस्य पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2038623, "chapter_id": 1845, "verse_number": "५-९०-३०", "content_sanskrit": "तेजसाऽऽदित्यसदृशो महर्षिसदृशो दमे।\nक्षमया पृथिवीतुल्यो महेन्द्रसमविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2038624, "chapter_id": 1845, "verse_number": "५-९०-३१", "content_sanskrit": "आधिराज्यं महद्दीप्तं प्रथितं मधुसूदन ।\nआहृतं येन वीर्येण कुरूणां सर्वराजसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2038625, "chapter_id": 1845, "verse_number": "५-९०-३२", "content_sanskrit": "यस्य बाहुबलं सर्वे पाण्डवाः पर्युपासते।\nस सर्वरथिनां श्रेष्ठः पाण्डवः सत्यविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2038626, "chapter_id": 1845, "verse_number": "५-९०-३३", "content_sanskrit": "यं गत्वाऽभिमुखः सङ्ख्ये न जीवन्तश्चिदाव्रजेत् ।\nयो जेता सर्वभूतानामजेयो जिष्णुरच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2038627, "chapter_id": 1845, "verse_number": "५-९०-३४", "content_sanskrit": "योऽपाश्रयः पाण्डवानां देवानामिव वासवः ।\nस ते भ्राता सखा चैव कथमद्य धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2038628, "chapter_id": 1845, "verse_number": "५-९०-३५", "content_sanskrit": "दयावान्सर्वभूतेषु ह्रीनिषेवो महास्रवित् ।\nमृदुश्च सुकुमारश्च धार्मिकश्च प्रियश्च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2038629, "chapter_id": 1845, "verse_number": "५-९०-३६", "content_sanskrit": "सहदेवो महेष्वासः शूरः समितिशोभनः ।\nभ्रातृणां कृष्ण शुश्रूषुर्धर्मार्थकुशलो युवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2038630, "chapter_id": 1845, "verse_number": "५-९०-३७", "content_sanskrit": "सदैव सहदेवस्य भ्रातरो मधुसूदन ।\nवृत्तं कल्याणवृत्तस्य पूजयन्ति महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2038631, "chapter_id": 1845, "verse_number": "५-९०-३८", "content_sanskrit": "ज्येष्ठोपचायिनं वीरं सहदेवं युधां पतिम्।\nशुश्रूषुं मम वार्ष्णेय माद्रीपुत्रं प्रचक्ष्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2038632, "chapter_id": 1845, "verse_number": "५-९०-३९", "content_sanskrit": "सुकुमारो युवा शूरो दर्शनीयश्च पाण्डवः।\nभ्रातॄणां चैव सर्वेषां प्रियः प्राणो बहिश्चरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2038633, "chapter_id": 1845, "verse_number": "५-९०-४०", "content_sanskrit": "चित्रयोधी च नकुलो महेष्वासो महाबलः ।\nकच्चित्स कुशली कृष्ण वत्सो मम सुखैधितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2038634, "chapter_id": 1845, "verse_number": "५-९०-४१", "content_sanskrit": "सुखोचितमदुःखार्हं सुकुमारं महारथम् ।\nअपि जातु महाबाहो पश्येयं नकुलं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2038635, "chapter_id": 1845, "verse_number": "५-९०-४२", "content_sanskrit": "पक्ष्मसंपातजे काले नकुलेन विनाकृता ।\nन लभामि धृतिं वीर साऽद्य जीवामि पश्य माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2038636, "chapter_id": 1845, "verse_number": "५-९०-४३", "content_sanskrit": "सर्वैः पुत्रैः प्रियतरा द्रौपदी मे जनार्दन ।\nकुलीना रूपसंपन्ना सर्वैः समुदिता गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2038637, "chapter_id": 1845, "verse_number": "५-९०-४४", "content_sanskrit": "पुत्रलोकात्पतिलोकं वृण्वाना सत्यवादिनी।\nप्रियान्पुत्रान्परित्यज्य पाण्डवाननुरुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2038638, "chapter_id": 1845, "verse_number": "५-९०-४५", "content_sanskrit": "महाभिजनसंपन्ना सर्वकामैः सुपूजिता।\nईश्वरी सर्वकल्याणी द्रौपदी कथमच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2038639, "chapter_id": 1845, "verse_number": "५-९०-४६", "content_sanskrit": "पतिभिः पञ्चभिः शूरैरग्निकल्पैः प्रहारिभिः ।\nउपपन्ना महेष्वासैर्द्रौपदी दुःखभागिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2038640, "chapter_id": 1845, "verse_number": "५-९०-४७", "content_sanskrit": "चतुर्दशमिदं वर्षं यन्नापश्यमरिन्दम ।\nपुत्रादिभिः परिद्यूनां द्रौपदीं सत्यवादिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2038641, "chapter_id": 1845, "verse_number": "५-९०-४८", "content_sanskrit": "न नूनं कर्मभिः पुण्यैरश्रुते पुरुषः सुखम् ।\nद्रौपदी चेत्तथावृत्ता नाश्रुते सुखमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2038642, "chapter_id": 1845, "verse_number": "५-९०-४९", "content_sanskrit": "न प्रियो मम कृष्णाया बीभत्सुर्न युधिष्ठिरः ।\nभीमसेनो यमौ वापि यदपश्यं सभागताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2038643, "chapter_id": 1845, "verse_number": "५-९०-५०", "content_sanskrit": "न मे दुःखतरं किंचिद्भूतपूर्वं ततोऽधिकम् ।\nस्त्रीधर्मिणीं द्रौपदीं यच्छ्वशुराणां समीपगाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2038644, "chapter_id": 1845, "verse_number": "५-९०-५१", "content_sanskrit": "आनायितामनार्येण क्रोधलोभानुवर्तिना ।\nसर्वे प्रैक्षन्त कुरव एकवस्त्रां सभागताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2038645, "chapter_id": 1845, "verse_number": "५-९०-५२", "content_sanskrit": "तत्रैव धृतराष्ट्रश्च महाराजश्च बाह्लिकः ।\nकृपश्च कसोमदत्तश्च निर्विष्णाः कुरवस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2038646, "chapter_id": 1845, "verse_number": "५-९०-५३", "content_sanskrit": "तस्यां संसदि सर्वेषां क्षत्तारं पूजयाम्यहम् ।\nवृत्तेन हि भवत्यार्यो न धनेन न विद्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2038647, "chapter_id": 1845, "verse_number": "५-९०-५४", "content_sanskrit": "तस्य कृष्ण महाबुद्धेर्गम्भीरस्य महात्मनः।\nक्षत्तुःक शीलमलङ्कारो लोकान्विष्टभ्य तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2038648, "chapter_id": 1845, "verse_number": "५-९०-५५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2038649, "chapter_id": 1845, "verse_number": "५-९०-५५", "content_sanskrit": "सा शोकार्ता च हृष्टा च दृष्ट्वा गोविन्दमागतम्।\nनानाविधानि दुःखानि सर्वाण्येवान्वकीर्तयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2038650, "chapter_id": 1845, "verse_number": "५-९०-५६", "content_sanskrit": "पूर्वैराचरितं यत्तत्कुराजभिररिन्दम ।\nअक्षद्यूतं मृगवधः कच्चिदेषां सुखावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2038651, "chapter_id": 1845, "verse_number": "५-९०-५७", "content_sanskrit": "तन्मां दहति यत्कृष्णा सभायां कुरुसन्निधौ ।\nधार्तराष्ट्रैः परिक्लिष्टा यथा न कुशलं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2038652, "chapter_id": 1845, "verse_number": "५-९०-५८", "content_sanskrit": "निर्वासनं च नगरात्प्रव्रज्या च परन्तप ।\nनानाविधानां दुःखानामावासोऽस्मि जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2038653, "chapter_id": 1845, "verse_number": "५-९०-५९", "content_sanskrit": "अज्ञातचर्या बालानामवरोधश्च माधव ।\nन मे क्लेशतमं तत्स्यात्पुत्रैः सह परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2038654, "chapter_id": 1845, "verse_number": "५-९०-६०", "content_sanskrit": "दुर्योधनेन निकृता वर्षमद्य चतुर्दशम्।\nदुःखादपि सुखं नः स्याद्यदि पुण्यफलक्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2038655, "chapter_id": 1845, "verse_number": "५-९०-६१", "content_sanskrit": "न मे विशेपो जात्वासीद्धार्तराष्ट्रेषु पाण्डवैः ।\nतेन सत्येन कृष्ण त्वां हतामित्रं श्रिया वृतम् ।\nअस्माद्विमुक्तं सङ्ग्रामात्पश्येयं पाण्डवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2038656, "chapter_id": 1845, "verse_number": "५-९०-६२", "content_sanskrit": "नैव शक्याः पराजेतुं सर्वं ह्येषां तथाविधम् ।\nपितरं त्वेव गर्हेयं नात्मानं न सुयोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2038657, "chapter_id": 1845, "verse_number": "५-९०-६३", "content_sanskrit": "येनाहं कुन्तिभोजाय धनं वृत्तैरिवार्पिता ।\nबालां मामार्यकस्तुभ्यं क्रीडन्तीं कन्दुहस्तिकां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2038658, "chapter_id": 1845, "verse_number": "५-९०-६४", "content_sanskrit": "अदात्तु कुन्तिभोजाय सखा सख्ये महात्मने ।\nसाऽहं पित्रा च निकृता श्वशुरैश्च परन्तप।\nअत्यन्तदुःखिता कृष्ण किं जीवितफलं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2038659, "chapter_id": 1845, "verse_number": "५-९०-६५", "content_sanskrit": "यन्मां वागब्रवीन्नक्तं सूतके सव्यसाचिनः ।\nपुत्रस्ते पृथिवीं जेता यशश्चास्य दिवं स्पृशेत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2038660, "chapter_id": 1845, "verse_number": "५-९०-६६", "content_sanskrit": "हत्वा कुरून्महाजन्ये राज्यं प्राप्य धनञ्जयः ।\nभ्रातृभिः सह कौन्तेयस्त्रीन्मेधानाहरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2038661, "chapter_id": 1845, "verse_number": "५-९०-६७", "content_sanskrit": "नाहं तामभ्यसूयामि नमो धर्माय वेधसे ।\nकृष्णाय महते नित्यं धर्मो धारयति प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2038662, "chapter_id": 1845, "verse_number": "५-९०-६८", "content_sanskrit": "धर्मश्चेदस्ति वार्ष्णेय यथा वागभ्यभाषत।\nत्वं चापि तत्तथा कृष्ण सर्वं संपादयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2038663, "chapter_id": 1845, "verse_number": "५-९०-६९", "content_sanskrit": "न मां माधव वैधव्यं नार्थनाशो न वैरिता ।\nतथा शोकाय दहति यथा पुत्रैर्विना भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2038664, "chapter_id": 1845, "verse_number": "५-९०-७०", "content_sanskrit": "याऽहं गाण्डीवधन्वानं सर्वशस्त्रभृतां वरम्।\nधनञ्जयं न पश्यामि का शान्तिर्हृदयस्य मे।\nइतश्चतुर्दशं वर्षं यन्नापश्यं युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2038665, "chapter_id": 1845, "verse_number": "५-९०-७१", "content_sanskrit": "धनञ्जयं च गोविन्द यमौ तं च वृकोदरम्।\nजीवनाशं प्रनष्टानां श्राद्धं कुर्वन्ति मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2038666, "chapter_id": 1845, "verse_number": "५-९०-७२", "content_sanskrit": "अर्थतस्ते मम मृतास्तेषां चाहं जनार्दना ।\nब्रूया माधव राजानं धर्मात्मानं युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2038667, "chapter_id": 1845, "verse_number": "५-९०-७३", "content_sanskrit": "भूयांस्ते हीयते धर्मो मा पुत्रक वृथा कृथाः ।\nपराश्रया वासुदेव या जीवति घिगस्तु ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2038668, "chapter_id": 1845, "verse_number": "५-९०-७४", "content_sanskrit": "वृत्तेः कार्पण्यलब्धाया अप्रतिष्ठैव ज्यायसी।\nअथो धनञ्जयं ब्रूया नित्योद्युक्तं वृकोदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2038669, "chapter_id": 1845, "verse_number": "५-९०-७५", "content_sanskrit": "यदर्थं क्षत्रिया सूते तस्य कालोऽयमागतः।\nअस्मिंश्चेदागते काले मिथ्या चातिक्रमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2038670, "chapter_id": 1845, "verse_number": "५-९०-७६", "content_sanskrit": "लोकसंभाविताः संतः सुनृशंसं करिष्यथ ।\nनृशंसेन च वो युक्तांस्त्यजेयं शाश्वतीः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2038671, "chapter_id": 1845, "verse_number": "५-९०-७७", "content_sanskrit": "काले हि समनुप्राप्ते त्यक्तव्यमपि जीवनम् ।\nमाद्रीपुत्रौ च व्यक्तव्यौ क्षत्रधर्मरतौ सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2038672, "chapter_id": 1845, "verse_number": "५-९०-७८", "content_sanskrit": "विक्रमेणार्जितान्भोगान्वृणीतं जीवितादपि ।\nविक्रमाधिगता ह्यर्थाः क्षत्रधर्मेण जीवतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2038673, "chapter_id": 1845, "verse_number": "५-९०-७९", "content_sanskrit": "मनो मनुष्यस्य सदा प्रीणन्ति पुरुषोत्तम।\nगत्वा ब्रूहि महाबाहो सर्वशस्त्रभृतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2038674, "chapter_id": 1845, "verse_number": "५-९०-८०", "content_sanskrit": "अर्जुनं पाण्डवं वीरं द्रौपद्याः पदवीं चर ।\nविदितौ हि तवात्यन्तं क्रुद्धौ तौ तु यथान्तकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2038675, "chapter_id": 1845, "verse_number": "५-९०-८१", "content_sanskrit": "भीमार्जुनौ नयेतां हि देवानपि परां गतिम्।\nतयोश्चैतदवज्ञानं यत्सा कृष्णा सभां गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2038676, "chapter_id": 1845, "verse_number": "५-९०-८२", "content_sanskrit": "दुःशासतश्च कर्णश्च परुषाण्यभ्यभाषताम्।\nदुर्योधनो भीमसेनमभ्यगच्छन्मनस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2038677, "chapter_id": 1845, "verse_number": "५-९०-८३", "content_sanskrit": "पश्यतां कुरुमुख्यानां तस्य द्रक्ष्यति यत्फलम् ।\nन हि वैरं समासाद्य प्रशाम्यति वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2038678, "chapter_id": 1845, "verse_number": "५-९०-८४", "content_sanskrit": "सुचिरादपि भीमस्य न हि वैरं प्रशाम्यति।\nयावदन्तं न नयति शात्रवाञ्चत्रुकर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2038679, "chapter_id": 1845, "verse_number": "५-९०-८५", "content_sanskrit": "न दुःखं राज्यहरणं न च द्यूते पराजयः ।\nप्रव्राजनं तु पुत्राणां न मे तद्दुःखकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2038680, "chapter_id": 1845, "verse_number": "५-९०-८६", "content_sanskrit": "यत्तु सा बृहती श्यामा एकवस्त्रा सभां गता।\nअशृणोत्परुषा वाचः किं नु दुःखतरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2038681, "chapter_id": 1845, "verse_number": "५-९०-८७", "content_sanskrit": "स्त्रीधर्मिणी वरारोहा क्षत्रधर्मरता सदा।\nनाभ्यगच्छत्तदा नाथं कृष्णा नाथवती सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2038682, "chapter_id": 1845, "verse_number": "५-९०-८८", "content_sanskrit": "यस्या मम सपुत्रायास्त्वं नाथो मधुसूदन ।\nरामश्च बलिनां श्रेष्ठः प्रद्युम्नश्च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2038683, "chapter_id": 1845, "verse_number": "५-९०-८९", "content_sanskrit": "साऽहमेवंविधं दुःखं सहेयं पुरुषोत्तम ।\nभीमे जीवति दुर्धर्षे विजये चापलायिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2038684, "chapter_id": 1845, "verse_number": "५-९०-९०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2038685, "chapter_id": 1845, "verse_number": "५-९०-९०", "content_sanskrit": "तत आश्वासयामास पुत्राधिभिरभिप्लुताम्।\nपितृष्वसारं शोचन्तीं शौरिः पार्थसखः पृथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2038686, "chapter_id": 1845, "verse_number": "५-९०-९१x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2038687, "chapter_id": 1845, "verse_number": "५-९०-९१", "content_sanskrit": "का नु सीमन्तिनी त्वादृग्लोकेष्वस्ति पितृष्वसः ।\nशूरस्य राज्ञो दुहिता आजमीढकुलं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2038688, "chapter_id": 1845, "verse_number": "५-९०-९२", "content_sanskrit": "महाकुलीना भवती ह्रदाद्ध्रदमिवागता।\nईश्वरी सर्वकल्याणी भर्त्रा परमपूजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2038689, "chapter_id": 1845, "verse_number": "५-९०-९३", "content_sanskrit": "वीरसूर्वीरपत्नी त्वं सर्वैः समुदिता गुणैः ।\nमुखदुःखे महाप्राज्ञे त्वादृशी सोढुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2038690, "chapter_id": 1845, "verse_number": "५-९०-९४", "content_sanskrit": "निद्रातन्द्रे क्रोधहर्षौ क्षुत्पिपासे हिमातपौ।\nएतानि पार्था निर्जित्य नित्यं वीरसुखे रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2038691, "chapter_id": 1845, "verse_number": "५-९०-९५", "content_sanskrit": "त्यक्तग्राम्यसुखाः पार्था नित्यं वीरसुखप्रियाः ।\nन तु स्वल्पेन तुष्येयुर्महोत्साहा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2038692, "chapter_id": 1845, "verse_number": "५-९०-९६", "content_sanskrit": "अन्तं धीरा निषेवन्ते मध्यं ग्राम्यसुखप्रियाः ।\nउत्तमांश्च परिक्लेशान्भोगांश्चातीव मानुषान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2038693, "chapter_id": 1845, "verse_number": "५-९०-९७", "content_sanskrit": "अन्तेषु रेमिरे धीरा न ते मध्येषु रेमिरे ।\nअन्तप्राप्तिं सुखं प्राहुर्दुःखमन्तरमन्तयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2038694, "chapter_id": 1845, "verse_number": "५-९०-९८", "content_sanskrit": "अभिवादयन्ति भवतीं पाण्डवाः सह कृष्णया ।\nआत्मानं ते कुशलिनं निवेद्याहुरनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2038695, "chapter_id": 1845, "verse_number": "५-९०-९९", "content_sanskrit": "अरोगान्सर्वसिद्धार्थान्क्षिप्रं द्रक्ष्यसि पाण्डवान् ।\nईश्वरान्सर्वलोकस्य हतामित्राञ्श्रिया वृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2038696, "chapter_id": 1845, "verse_number": "५-९०-१००", "content_sanskrit": "एवमाश्वासिता कुन्ती प्रत्युवाच जनार्दनम् ।\nपुत्राधिभिरभिध्वस्ता निगृह्याबुद्धिजं तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2038697, "chapter_id": 1845, "verse_number": "५-९०-१०१x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2038698, "chapter_id": 1845, "verse_number": "५-९०-१०१", "content_sanskrit": "यद्यत्तेषां महाबाहो पथ्यं स्यान्मधुसूदन।\nयथायथा त्वं मन्येथाः कुर्याः कृष्ण तथातथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2038699, "chapter_id": 1845, "verse_number": "५-९०-१०२", "content_sanskrit": "अविलोपेन धर्मस्य अनिकृत्या परन्तप।\nप्रभावज्ञाऽस्मि ते कृष्ण सत्यस्याभिजनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2038700, "chapter_id": 1845, "verse_number": "५-९०-१०३", "content_sanskrit": "व्यवस्थायां च मित्रेषु बुद्धिविक्रमयोस्तथा।\nत्वमेव नः कुले धर्मस्त्वं सत्यं त्वं तपो महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2038701, "chapter_id": 1845, "verse_number": "५-९०-१०४", "content_sanskrit": "त्वं त्राता त्वं महद्ब्रह्म त्वयि सर्वं प्रतिष्ठितम्।\nयथैवात्थ तथैवैतत्त्वयि सत्यं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2038702, "chapter_id": 1845, "verse_number": "५-९०-१०५", "content_sanskrit": "` कुरूणां पाण्डवानां च लोकानां चापराजित ।\nसर्वस्यैतस्य वार्ष्णेय गतिस्त्वमसि माधव।\nप्रभावो बुद्धिवीर्यं च तादृशं तव केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2038703, "chapter_id": 1845, "verse_number": "५-९०-१०६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2038704, "chapter_id": 1845, "verse_number": "५-९०-१०६", "content_sanskrit": "तामामन्त्र्य च गोविन्दः कृत्वा चाभिप्रदक्षिणम्।\nप्रातिष्ठत महाबाहुर्दुर्योधनगृहान्प्रति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2038705, "chapter_id": 1845, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि नवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}]