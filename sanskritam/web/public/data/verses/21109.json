[{"id": 7001109000, "chapter_id": 21109, "verse_number": "२-१-२०-१", "content_sanskrit": "ब्रह्मोवाच ।\nनारद त्वं शृणु मुने शिवागमनसत्तमम् ।\nकैलासे पर्वतश्रेष्ठे कुबेरस्य तपोबलात्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001109001, "chapter_id": 21109, "verse_number": "२-१-२०-२", "content_sanskrit": "निधिपत्व वरं दत्त्वा गत्वा स्वस्थानमुत्तमम् ।\nविचिन्त्य हृदि विश्वेशः कुबेरवरदायकः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001109002, "chapter_id": 21109, "verse_number": "२-१-२०-३", "content_sanskrit": "विध्यंगजस्स्वरूपो मे पूर्णः प्रलयकार्यकृत् ।\nतद्रूपेण गमिष्यामि कैलासं गुह्यकालयम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001109003, "chapter_id": 21109, "verse_number": "२-१-२०-४", "content_sanskrit": "रुद्रो हृदयजो मे हि पूर्णांशो ब्रह्मनिष्फलः ।\nहरि ब्रह्मादिभिस्सेव्यो मदभिन्नो निरंजन॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001109004, "chapter_id": 21109, "verse_number": "२-१-२०-५", "content_sanskrit": "तत्स्वरूपेण तत्रैव सुहृद्भूवा विलास्यहम् ।\nकुबेरस्य च वत्स्यामि करिष्यामि तपो महत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001109005, "chapter_id": 21109, "verse_number": "२-१-२०-६", "content_sanskrit": "इति संचिंत्य रुद्रोऽसौ शिवेच्छां गंतुमुत्सुकः ।\nननाद तत्र ढक्कां स्वां सुगतिं नादरूपिणीम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001109006, "chapter_id": 21109, "verse_number": "२-१-२०-७", "content_sanskrit": "त्रैलोक्यामानशे तस्या ध्वनिरुत्साहकारकः ।\nआह्वानगतिसंयुक्तो विचित्रः सांद्रशब्दकः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001109007, "chapter_id": 21109, "verse_number": "२-१-२०-८", "content_sanskrit": "तच्छ्रुत्वा विष्णुब्रह्माद्याः सुराश्च मुनयस्तथा ।\nआगमा निगमामूर्तास्सिद्धा जग्मुश्च तत्र वै॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001109008, "chapter_id": 21109, "verse_number": "२-१-२०-९", "content_sanskrit": "सुरासुराद्यास्सकलास्तत्र जग्मुश्च सोत्सवाः ।\nसर्वेऽपि प्रमथा जग्मुर्यत्र कुत्रापि संस्थिताः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001109009, "chapter_id": 21109, "verse_number": "२-१-२०-१०", "content_sanskrit": "गणपाश्च महाभागास्सर्वलोक नमस्कृताः ।\nतेषां संख्यामहं वच्मि सावधानतया शृणु॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001109010, "chapter_id": 21109, "verse_number": "२-१-२०-११", "content_sanskrit": "अभ्ययाच्छंखकर्णश्च गणकोट्या गणेश्वरः ।\nदशभिः केकराक्षश्च विकृतोऽष्टाभिरेव च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001109011, "chapter_id": 21109, "verse_number": "२-१-२०-१२", "content_sanskrit": "चतुःषष्ट्या विशाखश्च नवभिः पारियात्रकः ।\nषड्भिः सर्वान्तकः श्रीमान्दुन्दुभोऽष्टाभिरेव च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001109012, "chapter_id": 21109, "verse_number": "२-१-२०-१३", "content_sanskrit": "जालंको हि द्वादशभिः कोटिभिर्गणपुंगवः ।\nसप्तभिस्समदः श्रीमांस्तथैव विकृताननः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001109013, "chapter_id": 21109, "verse_number": "२-१-२०-१४", "content_sanskrit": "पंचभिश्च कपाली हि षड्भिः सन्दारकश्शुभः ।\nकोटिकोटिभिरेवेह कण्डुकः कुण्डकस्तथा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001109014, "chapter_id": 21109, "verse_number": "२-१-२०-१५", "content_sanskrit": "विष्टंभोऽष्टाभिरगमदष्टभिश्चन्द्रतापनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001109015, "chapter_id": 21109, "verse_number": "२-१-२०-१६", "content_sanskrit": "महाकेशस्सहस्रेण कोटीनां गणपो वृतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001109016, "chapter_id": 21109, "verse_number": "२-१-२०-१७", "content_sanskrit": "कुण्डी द्वादशभिर्वाहस्तथा पर्वतकश्शुभः ।\nकालश्च कालकश्चैव महाकालः शतेन वै॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001109017, "chapter_id": 21109, "verse_number": "२-१-२०-१८", "content_sanskrit": "अग्निकश्शतकोट्या वै कोट्याभिमुख एव च ।\nआदित्यमूर्द्धा कोट्या च तथा चैव धनावहः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001109018, "chapter_id": 21109, "verse_number": "२-१-२०-१९", "content_sanskrit": "सन्नाहश्च शतेनैव कुमुदः कोटिभिस्तथा ।\nअमोघः कोकिलश्चैव कोटिकोट्या सुमंत्रकः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001109019, "chapter_id": 21109, "verse_number": "२-१-२०-२०", "content_sanskrit": "काकपादोऽपरः षष्ट्या षष्ट्या संतानकः प्रभुः ।\nमहाबलश्च नवभिर्मधु पिंगश्च पिंगलः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001109020, "chapter_id": 21109, "verse_number": "२-१-२०-२१", "content_sanskrit": "नीलो नवत्या देवेशं पूर्णभद्रस्तथैव च ।\nकोटीनां चैव सप्तानां चतुर्वक्त्रो महाबलः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001109021, "chapter_id": 21109, "verse_number": "२-१-२०-२२", "content_sanskrit": "कोटिकोटिसहस्राणां शतैर्विंशतिभिर्वृतः ।\nतत्राजगाम सर्वेशः कैलासगमनाय वै॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001109022, "chapter_id": 21109, "verse_number": "२-१-२०-२३", "content_sanskrit": "काष्ठागूढश्चतुष्षष्ट्या सुकेशो वृषभस्तथा ।\nकोटिभिस्सप्तभिश्चैत्रो नकुलीशस्त्वयं प्रभुः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001109023, "chapter_id": 21109, "verse_number": "२-१-२०-२४", "content_sanskrit": "लोकांतकश्च दीप्तात्मा तथा दैत्यांतकः प्रभुः ।\nदेवो भृंगी रिटिः श्रीमान्देवदेवप्रियस्तथा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001109024, "chapter_id": 21109, "verse_number": "२-१-२०-२५", "content_sanskrit": "अशनिर्भानुकश्चैव चतुष्षष्ट्या सनातनः ।\nनंदीश्वरो गणाधीशः शतकोट्या महाबलः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001109025, "chapter_id": 21109, "verse_number": "२-१-२०-२६", "content_sanskrit": "एते चान्ये च गणपा असंख्याता महाबलः ।\nसर्वे सहस्रहस्ताश्च जटामुकुटधारिणः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001109026, "chapter_id": 21109, "verse_number": "२-१-२०-२७", "content_sanskrit": "सर्वे चंद्रावतंसाश्च नीलकण्ठास्त्रिलोचनाः ।\nहारकुण्डलकेयूरमुकुटाद्यैरलंकृताः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001109027, "chapter_id": 21109, "verse_number": "२-१-२०-२८", "content_sanskrit": "ब्रह्मेन्द्रविष्णुसंकाशा अणिमादि गणैर्वृताः ।\nसूर्यकोटिप्रतीकाशास्तत्राजग्मुर्गणेश्वराः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001109028, "chapter_id": 21109, "verse_number": "२-१-२०-२९", "content_sanskrit": "एते गणाधिपाश्चान्ये महान्मानोऽमलप्रभाः ।\nजग्मुस्तत्र महाप्रीत्या शिवदर्शनलालसाः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001109029, "chapter_id": 21109, "verse_number": "२-१-२०-३०", "content_sanskrit": "गत्वा तत्र शिवं दृष्ट्वा नत्वा चक्रुः परां नुतिम् ।\nसर्वे साञ्जलयो विष्णुप्रमुखा नतमस्तकाः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001109030, "chapter_id": 21109, "verse_number": "२-१-२०-३१", "content_sanskrit": "इति विष्ण्वादिभिस्सार्द्धं महेशः परमेश्वरः ।\nकैलासमगमत्प्रीत्या कुबेरस्य महात्मनः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001109031, "chapter_id": 21109, "verse_number": "२-१-२०-३२", "content_sanskrit": "कुबेरोप्यागतं शंभुं पूजयामास सादरम् ।\nभक्त्या नानोपहारैश्च परिवारसमन्वितः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001109032, "chapter_id": 21109, "verse_number": "२-१-२०-३३", "content_sanskrit": "ततो विष्ण्वादिकान्देवान्गणांश्चान्यानपि ध्रुवम् ।\nशिवानुगान्समानर्च शिवतोषणहेतवे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001109033, "chapter_id": 21109, "verse_number": "२-१-२०-३४", "content_sanskrit": "अथ शम्भुस्तमालिंग्य कुबेरं प्रीतमानसः ।\nमूर्ध्निं चाघ्राय संतस्थावलकां निकषाखिलैः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001109034, "chapter_id": 21109, "verse_number": "२-१-२०-३५", "content_sanskrit": "शशास विश्वकर्माणं निर्माणार्थं गिरौ प्रभुः ।\nनानाभक्तैर्निवासाय स्वपरेषां यथोचितम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001109035, "chapter_id": 21109, "verse_number": "२-१-२०-३६", "content_sanskrit": "विश्वकर्मा ततो गत्वा तत्र नानाविधां मुने ।\nरचनां रचयामास द्रुतं शम्भोरनुज्ञया॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001109036, "chapter_id": 21109, "verse_number": "२-१-२०-३७", "content_sanskrit": "अथ शम्भुः प्रमुदितो हरिप्रार्थनया तदा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001109037, "chapter_id": 21109, "verse_number": "२-१-२०-३८", "content_sanskrit": "कुबेरानुग्रहं कृत्वा ययौ कैलासपर्वतम् ।\nसुमुहूर्ते प्रविश्यासौ स्वस्थानं परमेश्वरः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001109038, "chapter_id": 21109, "verse_number": "२-१-२०-३९", "content_sanskrit": "अकरोदखिलान्प्रीत्या सनाथान्भक्तवत्सलः ।\nअथ सर्वे प्रमुदिता विष्णुप्रभृतयस्सुराः ।\nमुनयश्चापरे सिद्धा अभ्यषिंचन्मुदा शिवम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001109039, "chapter_id": 21109, "verse_number": "२-१-२०-४०", "content_sanskrit": "समानर्चुः क्रमात्सर्वे नानोपायनपाणयः ।\nनीराजनं समाकार्षुर्महोत्सवपुरस्सरम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001109040, "chapter_id": 21109, "verse_number": "२-१-२०-४१", "content_sanskrit": "तदासीत्सुमनोवृष्टिर्मंगलायतना मुने ।\nसुप्रीता ननृतुस्तत्राप्सरसो गानतत्पराः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001109041, "chapter_id": 21109, "verse_number": "२-१-२०-४२", "content_sanskrit": "जयशब्दो नमश्शब्दस्तत्रासीत्सर्वसंस्कृतः ।\nतदोत्साहो महानासीत्सर्वेषां सुखवर्धनः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001109042, "chapter_id": 21109, "verse_number": "२-१-२०-४३", "content_sanskrit": "स्थित्वा सिंहासने शंभुर्विराजाधिकं तदा ।\nसर्वैस्संसेवितोऽभीक्ष्णं विष्ण्वाद्यैश्च यथोचितम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001109043, "chapter_id": 21109, "verse_number": "२-१-२०-४४", "content_sanskrit": "अथ सर्वे सुराद्याश्च तुष्टुवुस्तं पृथक्पृथक् ।\nअर्थ्याभिर्वाग्भिरिष्टाभिश्शकरं लोकशंकरम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001109044, "chapter_id": 21109, "verse_number": "२-१-२०-४५", "content_sanskrit": "प्रसन्नात्मा स्तुतिं श्रुत्वा तेषां कामान्ददौ शिवः ।\nमनोभिलषितान्प्रीत्या वरान्सर्वेश्वरः प्रभुः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001109045, "chapter_id": 21109, "verse_number": "२-१-२०-४६", "content_sanskrit": "शिवाज्ञयाथ ते सर्वे स्वंस्वं धाम ययुर्मुने ।\nप्राप्तकामाः प्रमुदिता अहं च विष्णुना सह॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001109046, "chapter_id": 21109, "verse_number": "२-१-२०-४७", "content_sanskrit": "उपवेश्यासने विष्णुं माञ्च शम्भुरुवाच ह ।\nबहु सम्बोध्य सुप्रीत्यानुगृह्य परमेश्वरः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001109047, "chapter_id": 21109, "verse_number": "२-१-२०-४८", "content_sanskrit": "शिव उवाच ।\nहे हरे हे विधे तातौ युवां प्रियतरौ मम ।\nसुरोत्तमौ त्रिजगतोऽवनसर्गकरौ सदा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001109048, "chapter_id": 21109, "verse_number": "२-१-२०-४९", "content_sanskrit": "गच्छतं निर्भयन्नित्यं स्वस्थानश्च मदाज्ञया ।\nसुखप्रदाताहं वै वाम्विशेषात्प्रेक्षकस्सदा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001109049, "chapter_id": 21109, "verse_number": "२-१-२०-५०", "content_sanskrit": "इत्याकर्ण्य वचश्शम्भोस्सुप्रणम्य तदाज्ञया ।\nअहं हरिश्च स्वं धामागमाव प्रीतमानसौ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001109050, "chapter_id": 21109, "verse_number": "२-१-२०-५१", "content_sanskrit": "तदानीमेव सुप्रीतश्शंकरो निधिपम्मुदा ।\nउपवेश्य गृहीत्वा तं कर आह शुभं वचः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001109051, "chapter_id": 21109, "verse_number": "२-१-२०-५२", "content_sanskrit": "॥ शिव उवाच  ।\nतव प्रेम्णा वशीभूतो मित्रतागमनं सखे ।\nस्वस्थानङ्गच्छ विभयस्सहायोहं सदानघ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001109052, "chapter_id": 21109, "verse_number": "२-१-२०-५३", "content_sanskrit": "इत्याकर्ण्य वचश्शम्भोः कुबेरः प्रीतमानसः ।\nतदाज्ञया स्वकं धाम जगाम प्रमुदान्वितः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001109053, "chapter_id": 21109, "verse_number": "२-१-२०-५४", "content_sanskrit": "स उवाच गिरौ शम्भुः कैलासे पर्वतोत्तमे ।\nसगणो योगनिरतस्स्वच्छन्दो ध्यान तत्परः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001109054, "chapter_id": 21109, "verse_number": "२-१-२०-५५", "content_sanskrit": "क्वचिद्दध्यौ स्वमात्मानं क्वचिद्योगरतोऽभवत् ।\nइतिहासगणान्प्रीत्यावादीत्स्वच्छन्दमानसः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001109055, "chapter_id": 21109, "verse_number": "२-१-२०-५६", "content_sanskrit": "क्वचित्कैलास कुधरसुस्थानेषु महेश्वरः ।\nविजहार गणैः प्रीत्या विविधेषु विहारवित्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001109056, "chapter_id": 21109, "verse_number": "२-१-२०-५७", "content_sanskrit": "इत्थं रुद्रस्वरूपोऽसौ शंकरः परमेश्वरः ।\nअकार्षीत्स्वगिरौ लीला नाना योगिवरोऽपि यः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001109057, "chapter_id": 21109, "verse_number": "२-१-२०-५८", "content_sanskrit": "नीत्वा कालं कियन्तं सोऽपत्नीकः परमेश्वरः ।\nपश्चादवाप स्वाम्पत्नीन्दक्षपत्नीसमुद्भवाम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001109058, "chapter_id": 21109, "verse_number": "२-१-२०-५९", "content_sanskrit": "विजहार तया सत्या दक्षपुत्र्या महेश्वरः ।\nसुखी बभूव देवर्षे लोकाचारपरायणः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001109059, "chapter_id": 21109, "verse_number": "२-१-२०-६०", "content_sanskrit": "इत्थं रुद्रावतारस्ते वर्णितोऽयं मुनीश्वर ।\nकैलासागमनञ्चास्य सखित्वान्निधिपस्य हि॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001109060, "chapter_id": 21109, "verse_number": "२-१-२०-६१", "content_sanskrit": "तदन्तर्गतलीलापि वर्णिता ज्ञानवर्धिनी ।\nइहामुत्र च या नित्यं सर्वकामफलप्रदा॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001109061, "chapter_id": 21109, "verse_number": "२-१-२०-६२", "content_sanskrit": "इमां कथाम्पठेद्यस्तु शृणुयाद्वा समाहितः ।\nइह भुक्तिं समासाद्य लभेन्मुक्तिम्परत्र सः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]