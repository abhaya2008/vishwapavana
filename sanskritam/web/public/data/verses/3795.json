[{"id": 2129777, "chapter_id": 3795, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129778, "chapter_id": 3795, "verse_number": "१", "content_sanskrit": "उशीरबीजं मैनाकं गिरिं श्वेतं च भारत ।\nसमतीतोऽसि कौन्तेय कालशैलं च पार्थिव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129779, "chapter_id": 3795, "verse_number": "२", "content_sanskrit": "एषा गङ्गा सप्तविधा राजते भरतर्षभ ।\nस्थानं विरजसं पुण्यं यत्राग्निर्नित्यमिध्यते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129780, "chapter_id": 3795, "verse_number": "३", "content_sanskrit": "एतद्वै मानुषेणाद्य न शक्यं द्रष्टुमद्भुतम् ।\nसमाधिं कुरुताव्यग्रास्तीर्थान्येतानि द्रक्ष्यथ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129781, "chapter_id": 3795, "verse_number": "", "content_sanskrit": "एतद् द्रक्ष्यसि देवानामाक्रीडं चरणाङ्कितम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129782, "chapter_id": 3795, "verse_number": "४", "content_sanskrit": "श्वेतं गिरिं प्रवेक्ष्यामो मन्दरं चैव पर्वतम् ।\nयत्र माणिवरो यक्षः कुबेरश्चैव यक्षराट्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129783, "chapter_id": 3795, "verse_number": "५", "content_sanskrit": "अष्टाशीतिसहस्राणि गन्धर्वाः शीघ्रगामिनः ।\nतथा किम्पुरुषा राजन् यक्षाश्चैव चतुर्गुणाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129784, "chapter_id": 3795, "verse_number": "६", "content_sanskrit": "अनेकरूपसंस्थाना नानाप्रहरणाश्च ते ।\nयक्षेन्द्रं मनुजश्रेष्ठ माणिभद्रमुपासते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129785, "chapter_id": 3795, "verse_number": "७", "content_sanskrit": "तेषामृद्धिरतीवात्र गतौ वायुसमाश्च ते ।\nस्थानात् प्रच्यावयेयुर्ये देवराजमपि ध्रुवम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129786, "chapter_id": 3795, "verse_number": "८", "content_sanskrit": "तैस्तात बलिभिर्गुप्ता यातुधानैश्च रक्षिताः ।\nदुर्गमाः पर्वताः पार्थ समाधिं परमं कुरु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129787, "chapter_id": 3795, "verse_number": "९", "content_sanskrit": "कुबेरसचिवाश्चान्ये रौद्रा मैत्राश्च राक्षसाः ।\nतैः समेष्याम कौन्तेय संयतो विक्रमेण च \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129788, "chapter_id": 3795, "verse_number": "१०", "content_sanskrit": "कैलासः पर्वतो राजन् षड्योजनसमुच्छ्रितः ।\nयत्र देवा समायान्ति विशाला यत्र भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129789, "chapter_id": 3795, "verse_number": "११", "content_sanskrit": "असङ्ख्येयास्तु कौन्तेय यक्षराक्षसकिन्नराः ।\nनागाः सुपर्णा गन्धर्वाः कुबेरसदनं प्रति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129790, "chapter_id": 3795, "verse_number": "१२", "content_sanskrit": "तान् विगाहस्व पार्थाद्य तपसा च दमेन च ।\nरक्ष्यमाणो मया राजन् भीमसेनबलेन च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129791, "chapter_id": 3795, "verse_number": "१३", "content_sanskrit": "स्वस्ति ते वरुणो राजा यमश्च समितिञ्जयः ।\nगङ्गा च यमुना चैव पर्वतश्च दधातु ते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129792, "chapter_id": 3795, "verse_number": "", "content_sanskrit": "मरुतश्च सहाश्विभ्यां सरितश्च सरांसि च ।\nस्वस्ति देवासुरेभ्यश्च वसुभ्यश्च महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129793, "chapter_id": 3795, "verse_number": "१४", "content_sanskrit": "इन्द्रस्य जाम्बूनदपर्वताद् वै\nशृणोमि घोषं तव देवि गङ्गे ।\nगोपायैनं त्वं सुभगे गिरिभ्यः\nसर्वाजमीढापचितं नरेन्द्रम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129794, "chapter_id": 3795, "verse_number": "१५", "content_sanskrit": "ददस्व शर्म प्रविविक्षतोऽस्य शैलानिमान् शैलसुते नृपस्य ।\nशिवप्रदा सर्वसरित्प्रधाने सभ्रातृकस्येह युधिष्ठिरस्य\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129795, "chapter_id": 3795, "verse_number": "", "content_sanskrit": "उक्त्वा तथा (स च गङ्गां हि) सागरगां हि\nविप्रो यत्तो भवस्वेति शशास पार्थम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129796, "chapter_id": 3795, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129797, "chapter_id": 3795, "verse_number": "१६", "content_sanskrit": "अपूर्वोऽयं सम्भ्रमो लोमशस्य\nकृष्णां च सर्वे रक्षत मा प्रमादम् ।\nदेशो ह्ययं दुर्गतमो मतोऽस्य\nतस्मात् परं शौचमिहाचरध्वम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129798, "chapter_id": 3795, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129799, "chapter_id": 3795, "verse_number": "१७", "content_sanskrit": "ततोऽब्रवीद् भीममुदारवीर्यं\nकृष्णां यत्तः पालय भीमसेन ।\nशून्येऽर्जुनेऽसन्निहिते च तात\nत्वामेव कृष्णा भजते भयेषु\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129800, "chapter_id": 3795, "verse_number": "१८", "content_sanskrit": "ततो महात्मा स यमौ समेत्य मूर्धन्युपाघ्राय विमृज्य गात्रे ।\nउवाच तौ बाष्पकलं स राजा मा भैष्टमागच्छतमप्रमत्तौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129801, "chapter_id": 3795, "verse_number": "१३६", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि षट्त्रिंशदधिकशततमोऽध्यायः ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129802, "chapter_id": 3795, "verse_number": "", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि द्विनवतितमोऽध्यायः ॥९२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]