[{"id": 2209652, "chapter_id": 5483, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209653, "chapter_id": 5483, "verse_number": "१", "content_sanskrit": "जित्वा प्रसाद्य राजानं भगदत्तसुतं तदा ।\nविसृज्य याते तुरगे सैन्धवान् प्रति भारत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209654, "chapter_id": 5483, "verse_number": "२", "content_sanskrit": "सैन्धवैरभवद् युद्धं ततस्तस्य किरीटिनः ।\nहतशेषैर्महायुद्धे हतानां च सुतैरपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209655, "chapter_id": 5483, "verse_number": "३", "content_sanskrit": "तेऽवतीर्णमुपश्रुत्य विषयं श्वेतवाहनम् ।\nप्रत्युद्ययुरमृष्यन्तो राजानः पाण्डवर्षभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209656, "chapter_id": 5483, "verse_number": "४", "content_sanskrit": "अश्ववन्तं परामृश्य विषयान्ते विगाहितम् ।\nन भयं चक्रिरे पार्थाद् भीमसेनादनन्तरात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209657, "chapter_id": 5483, "verse_number": "५", "content_sanskrit": "तेऽविदूराद् धनुष्पाणिं याज्ञियस्य हयस्य च ।\nबीभत्सुं प्रत्यपश्यन्त पदातिं प्रत्युपस्थितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209658, "chapter_id": 5483, "verse_number": "६", "content_sanskrit": "ततस्ते तं महावीर्यं राजानः पर्यवारयन् ।\nजिगीषन्तो नरव्याघ्राः पूर्वं विनिकृता युधि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209659, "chapter_id": 5483, "verse_number": "७", "content_sanskrit": "ते नामान्यथ गोत्राणि कर्माणि विविधानि च ।\nकीर्तयन्तस्तदा पार्थं शरवर्षैरवाकिरन् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209660, "chapter_id": 5483, "verse_number": "८", "content_sanskrit": "ते किरन्तः शरांस्तीक्ष्णान् वारणेन्द्रनिवारणान् ।\nरणे जयमभीप्सन्तः कौन्तेयं पर्यवारयन् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209661, "chapter_id": 5483, "verse_number": "९", "content_sanskrit": "ते समीक्ष्य तु तं वीरमुग्रकर्माणमाहवे ।\nसर्वे युयुधिरे वीरा रथस्थास्तं पदातिनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209662, "chapter_id": 5483, "verse_number": "१०", "content_sanskrit": "ते तमाजघ्निरे वीरा निवातकवचान्तकम् ।\nसंशप्तकनिहन्तारं हन्तारं सैन्धवस्य च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209663, "chapter_id": 5483, "verse_number": "११", "content_sanskrit": "ततो रथसहस्रेण गजानामयुतेन च ।\nकोष्ठकीकृत्य कौन्तेयं सम्प्रस्थितमवारयन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209664, "chapter_id": 5483, "verse_number": "१२", "content_sanskrit": "संस्मरन्तो वधं वीराः सिन्धुराजस्य धीमतः ।\nजयद्रथस्य कौरव्य समरे सव्यसाचिना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209665, "chapter_id": 5483, "verse_number": "१३", "content_sanskrit": "ततः पर्जन्यवत् सर्वे शरवृष्टिमवासृजन् ।\nतैः कीर्णः शुशुभे पार्थो रविर्मेघान्तरे यथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209666, "chapter_id": 5483, "verse_number": "१४", "content_sanskrit": "स शरैः समवच्छन्नो ददृशे पाण्डवर्षभः ।\nपञ्जरान्तरसञ्चारी शकुन्त इव भारत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209667, "chapter_id": 5483, "verse_number": "१५", "content_sanskrit": "ततो हाहाकृतं सर्वं कौन्तेये शरपीडिते ।\nत्रैलोक्यमभवत् सर्वं रविश्चासीद् रजोरुणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209668, "chapter_id": 5483, "verse_number": "१६", "content_sanskrit": "ततो ववौ महाराज मारुतो रोमहर्षणः ।\nराहुरग्रसदादित्यं युगपत् सोममेव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209669, "chapter_id": 5483, "verse_number": "१७", "content_sanskrit": "उल्काश्च जघ्निरे सूर्यं कीर्यमाणाः समन्ततः ।\nवेपथुश्चाभवद् राजन् कैलासस्य महागिरेः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209670, "chapter_id": 5483, "verse_number": "१८", "content_sanskrit": "मुमुचुश्चास्रमत्युष्णं दुःखशोकसमन्विताः ।\nसप्तर्षयो जातभयास्तथा देवर्षयोऽपि च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209671, "chapter_id": 5483, "verse_number": "१९", "content_sanskrit": "शशश्चाशु विनिर्भिद्य मण्डलं शशिनोऽगमत् ।\nविपरीतस्तथाऽऽकाशस्तस्मिन्नुत्पातलक्षणे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209672, "chapter_id": 5483, "verse_number": "२०", "content_sanskrit": "रासभारुणसङ्काशा धनुष्मन्तः सविद्युतः ।\nआवृत्य गगनं मेघा मुमुचुर्मांसशोणितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209673, "chapter_id": 5483, "verse_number": "२१", "content_sanskrit": "एवमासीत् तदा वीरे शरवर्षाभिसंवृते ।\nलोकेऽस्मिन् भरतश्रेष्ठ तदद्भुतमिवाभवत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209674, "chapter_id": 5483, "verse_number": "२२", "content_sanskrit": "तस्य तेनाभिकीर्णेन शरजालेन सर्वतः ।\nमोहात् पपात गाण्डीवमावापश्च करादपि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209675, "chapter_id": 5483, "verse_number": "२३", "content_sanskrit": "तस्मिन् मोहमनुप्राप्ते शरजालं महत्तरम् ।\nसैन्धवा मुमुचुस्तूर्णं गतसत्वे महारथे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209676, "chapter_id": 5483, "verse_number": "२४", "content_sanskrit": "ततो मोहसमापन्नं ज्ञात्वा पार्थं दिवौकसः ।\nसर्वे वित्रस्तमनसः सर्वे शान्तिपराः स्थिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209677, "chapter_id": 5483, "verse_number": "२५", "content_sanskrit": "ततो देवर्षयः सर्वे तथा सप्तर्षयोऽपि च ।\nब्रह्मर्षयश्च विजयं जेपुः पार्थस्य धीमतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209678, "chapter_id": 5483, "verse_number": "२६", "content_sanskrit": "ततः प्रदीपिते देवैः पार्थतेजसि पार्थिव ।\nतस्थावचलवद्धीमान् सङ्ग्रामे परमास्त्रवित् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209679, "chapter_id": 5483, "verse_number": "२७", "content_sanskrit": "विचकर्ष धनुर्दिव्यं ततः कौरवनन्दनः ।\nवज्रस्येवेह शब्दोऽभून्महांस्तस्य पुनः पुनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209680, "chapter_id": 5483, "verse_number": "२८", "content_sanskrit": "ततः स शरवर्षाणि प्रत्यमित्रान् प्रति प्रभुः ।\nववर्ष च तथा पार्थो वर्षाणीव पुरन्दरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209681, "chapter_id": 5483, "verse_number": "२९", "content_sanskrit": "ततस्ते सैन्धवा योधाः सर्व एव सराजकाः ।\nनादृश्यन्त शरैः कीर्णाः शलभैरिव पादपाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209682, "chapter_id": 5483, "verse_number": "३०", "content_sanskrit": "तस्य शब्देन वित्रेसुर्भयार्ताश्च विदुद्रुवुः ।\nमुमुचुश्चाश्रु शोकार्ता निकृत्ताश्चापि सैन्धवाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209683, "chapter_id": 5483, "verse_number": "३१", "content_sanskrit": "तांस्तु सर्वान् नरश्रेष्ठः सर्वतो विचरद् बली ।\nअलातचक्रवद् राजन् शरजालैः समर्पयन् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209684, "chapter_id": 5483, "verse_number": "३२", "content_sanskrit": "तमिन्द्रजालप्रतिमं बाणजालममित्रहा ।\nव्यसृजद् दिक्षु सर्वासु महेन्द्र इव सर्वतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209685, "chapter_id": 5483, "verse_number": "३३", "content_sanskrit": "मेघजालनिभं सैन्यं विदार्य स रविप्रभः ।\nविबभौ कौरवश्रेष्ठः शरदीव दिवाकरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209686, "chapter_id": 5483, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसञ्चरणे सैन्धवयुद्धं नाम सप्तसप्ततितमोऽध्यायः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]