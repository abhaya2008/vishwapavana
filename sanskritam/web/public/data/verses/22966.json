[{"id": 7002966000, "chapter_id": 22966, "verse_number": "२-१३-१", "content_sanskrit": "नारद उवाच ।\nनारायणप्रिया साध्वी कथं सा च बभूव ह ।\nतुलसी कुत्र सम्भूता का वा सा पूर्वजन्मनि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002966001, "chapter_id": 22966, "verse_number": "२-१३-२", "content_sanskrit": "कस्य वा सा कुले जाता कस्य कन्या तपस्विनी ।\nकेन वा तपसा सा च संप्राप प्रकृतेः परम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002966002, "chapter_id": 22966, "verse_number": "२-१३-३", "content_sanskrit": "निर्विकल्पं निरीहं च सर्वसाक्षिस्वरूपकम् ।\nनारायणं परं ब्रह्म परमात्मानमीश्वरम्॥ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002966003, "chapter_id": 22966, "verse_number": "२-१३-४", "content_sanskrit": "सर्वाराध्यं च सर्वेशं सर्वज्ञं सर्वकारणम् ।\nसर्वाधारं सर्वरूपं सर्वेषां परिपालनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002966004, "chapter_id": 22966, "verse_number": "२-१३-५", "content_sanskrit": "कथमेतादृशी देवी वृक्षत्वं समवाप ह ।\nकथं साऽप्यसुरग्रस्ता संबभूव तपस्विनी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002966005, "chapter_id": 22966, "verse_number": "२-१३-६", "content_sanskrit": "सन्दिग्धं मे मनो लोलं प्रेरयेन्मां मुहुर्मुहुः ।\nछेत्तुमर्हसि सन्देहं सर्वसन्देहभञ्जना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002966006, "chapter_id": 22966, "verse_number": "२-१३-७", "content_sanskrit": "नारायण उवाच ।\nमनुश्च दक्षसावर्णिः पुण्यवान्वैष्णवः शुचिः ।\nयशस्वी कीर्तिमांश्चैव विष्णोरंशसमुद्भवः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002966007, "chapter_id": 22966, "verse_number": "२-१३-८", "content_sanskrit": "तत्पुत्रो धर्मसावर्णिर्धर्मिष्ठो वैष्णवः शुचिः ।\nतत्पुत्रो विष्णुसावर्णिर्वैष्णवश्च जितेन्द्रियः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002966008, "chapter_id": 22966, "verse_number": "२-१३-९", "content_sanskrit": "तत्पुत्रो देवसावर्णिर्विष्णुव्रतपरायणः ।\nतत्पुत्रो राजसावर्णिर्महाविष्णुपरायणः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002966009, "chapter_id": 22966, "verse_number": "२-१३-१०", "content_sanskrit": "वृषध्वजश्च तत्पुत्रो वृषध्वजपरायणः ।\nयस्याश्रमे स्वयं शम्भुरासीद्दैवयुगत्रयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002966010, "chapter_id": 22966, "verse_number": "२-१३-११", "content_sanskrit": "पुत्रादपि परः स्नेहो नृपे तस्मिञ्छिवस्य च ।\nन च नारायणं मेने न च लक्ष्मीं सरस्वतीम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002966011, "chapter_id": 22966, "verse_number": "२-१३-१२", "content_sanskrit": "पूजां च सर्वदेवानां दूरीभूतां चकार सः ।\nभाद्रे मासि महालक्ष्मीपूजां मत्तोऽत्यजन्नृपः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002966012, "chapter_id": 22966, "verse_number": "२-१३-१३", "content_sanskrit": "माघे सरस्वतीपूजां दूरीभूतां चकार सः ।\nयज्ञं च विष्णुपूजां च निनिन्दे न चकार सः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002966013, "chapter_id": 22966, "verse_number": "२-१३-१४", "content_sanskrit": "न कोऽपि देवो भूपेन्द्रं शशाप शिवकारणात् ।\nभ्रष्टश्रीर्भव भूपेति चाशपत्तं दिवाकरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002966014, "chapter_id": 22966, "verse_number": "२-१३-१५", "content_sanskrit": "शूलं गृहीत्वा तं सूर्य्यं धृतवाच्छङ्करः स्वयम् ।\nपित्रा सार्द्ध दिनेशश्च ब्रह्माणं शरणं ययौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002966015, "chapter_id": 22966, "verse_number": "२-१३-१६", "content_sanskrit": "शिवस्त्रिशूलहस्तश्च ब्रह्मलोकं ययौ क्रुधा ।\nब्रह्मा सूर्य्यं पुरस्कृत्य वैकुण्ठं च ययौ भिया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002966016, "chapter_id": 22966, "verse_number": "२-१३-१७", "content_sanskrit": "शूलं गृहीत्वा तत्रापि धृतवाञ्छङ्करो रविम् ।\nब्रह्मकश्यपमार्त्तण्डाः संत्रस्ताः शुष्कतालुकाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002966017, "chapter_id": 22966, "verse_number": "२-१३-१८", "content_sanskrit": "नारायणं च सर्वेशं ते ययुः शरणं भिया ।\nमूर्ध्ना प्रणेमुस्ते गत्वा तुष्टुवुश्च पुनः पुनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002966018, "chapter_id": 22966, "verse_number": "२-१३-१९", "content_sanskrit": "सर्वे निवेदनं चक्रुर्भियस्ते कारणं हरौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002966019, "chapter_id": 22966, "verse_number": "२-१३-२०", "content_sanskrit": "नारायणश्च कृपयाऽभयं तेभ्यो ददौ मुने ।\nस्थिरा भवत हे भीता भयं किं वो मयि स्थिते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002966020, "chapter_id": 22966, "verse_number": "२-१३-२१", "content_sanskrit": "स्मरन्ति ये यत्र तत्र मां विपत्तौ भयान्विताः ।\nतांस्तत्र गत्वा रक्षामि चक्र हस्तस्त्वरान्वितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002966021, "chapter_id": 22966, "verse_number": "२-१३-२२", "content_sanskrit": "पाताऽहं जगतां देवः कर्त्ताऽहं सततं सदा ।\nसृष्ट्वा च ब्रह्मरूपेण संहर्त्ता शिवरूपतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002966022, "chapter_id": 22966, "verse_number": "२-१३-२३", "content_sanskrit": "शिवोऽहं त्वमहं चापि सूर्य्योऽहं त्रिगुणात्मकः ।\nविधाय नानारूपं च कुर्यां सृष्ट्यादिकाः क्रियाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002966023, "chapter_id": 22966, "verse_number": "२-१३-२४", "content_sanskrit": "यूयं गच्छत भद्रं वो भविष्यति भयं कुतः ।\nअद्यप्रभृति वो नास्ति मद्वराच्छङ्कराद्भयम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002966024, "chapter_id": 22966, "verse_number": "२-१३-२५", "content_sanskrit": "आशुतोषः स भगवाञ्छरण्यश्च सतां गतिः ।\nभक्ताधीनश्च भक्तेशो भक्तात्मा भक्तवत्सलः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002966025, "chapter_id": 22966, "verse_number": "२-१३-२६", "content_sanskrit": "सुदर्शनं शिवश्चैव मम प्राणाधिकप्रियौ ।\nब्रह्माण्डेषु न तेजस्वी हे ब्रह्मन्ननयोः परः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002966026, "chapter_id": 22966, "verse_number": "२-१३-२७", "content_sanskrit": "शक्तः स्रष्टुं महादेवः सूर्य्यकोटिं च लीलया ।\nकोटिं च ब्रह्मणामेवं किमसाध्यं च शूलिनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002966027, "chapter_id": 22966, "verse_number": "२-१३-२८", "content_sanskrit": "बाह्यज्ञानं तन्न किंचिद्ध्यायतो मां दिवानिशम् ।\nमन्नाम मद्गणं भक्त्या पञ्चवक्त्रेण गीयते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002966028, "chapter_id": 22966, "verse_number": "२-१३-२९", "content_sanskrit": "अहमेव चिन्तयामि तत्कल्याणं दिवानिशम् ।\nये यथा मां प्रपद्यन्ते तांस्तथैव भजाम्यहम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002966029, "chapter_id": 22966, "verse_number": "२-१३-३०", "content_sanskrit": "शिवस्वरूपो भगवाञ्छिवाधिष्ठातृदेवता ।\nशिवो भवति यस्माच्च शिवं तेन विदुर्बुधाः  ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002966030, "chapter_id": 22966, "verse_number": "२-१३-३१", "content_sanskrit": "एतस्मिन्नन्तरे तत्र चागमच्छङ्करः स्वयम् ।\nशूलहस्तो वृषारूढो रक्तपङ्कजलोचनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002966031, "chapter_id": 22966, "verse_number": "२-१३-३२", "content_sanskrit": "अवरुह्य वृषात्तूर्णं भक्तिनम्रात्मकन्धरः ।\nननाम भक्त्या तं शान्तं लक्ष्मीकान्तं परात्परम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002966032, "chapter_id": 22966, "verse_number": "२-१३-३३", "content_sanskrit": "रत्नसिंहासनस्थं च रत्नालङ्कारभूषितम् ।\nकिरीटिनं कुण्डलिनं चक्रिणं वनमालिनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002966033, "chapter_id": 22966, "verse_number": "२-१३-३४", "content_sanskrit": "नवीननीरदश्यामं सुन्दरं च चतुर्भुजम् ।\nचतुर्भुजैः सेवितं च श्वेतचामरवायुना ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002966034, "chapter_id": 22966, "verse_number": "२-१३-३५", "content_sanskrit": "चन्दनोक्षितसर्वांगं भूषितं पीतवाससा ।\nलक्ष्मीप्रदत्तताम्बूलं भुक्तवन्तं च नारद ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002966035, "chapter_id": 22966, "verse_number": "२-१३-३६", "content_sanskrit": "विद्याधरीनृत्यगीतं शृण्वन्तं सस्मितं मुदा ।\nईश्वरं परमात्मानं भक्तानुग्रहविग्रहम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002966036, "chapter_id": 22966, "verse_number": "२-१३-३७", "content_sanskrit": "तं ननाम महादेवो ब्रह्माणं च ननाम सः ।\nननाम सूर्य्यो भक्त्या च संत्रस्तश्चन्द्रशेखरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002966037, "chapter_id": 22966, "verse_number": "२-१३-३८", "content_sanskrit": "कश्यपश्च महाभक्त्या तुष्टाव च ननाम च ।\nशिवः संस्तूय सर्वेशं समुवास सुखासने॥ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002966038, "chapter_id": 22966, "verse_number": "२-१३-३९", "content_sanskrit": "सुखासने सुखासीनं विश्रान्तं चन्द्रशेखरम् ।\nश्वेतचामरवातेन सेवितं विष्णुपार्षदैः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002966039, "chapter_id": 22966, "verse_number": "२-१३-४०", "content_sanskrit": "अक्रोधं सत्त्वसंसर्गात्प्रसन्नं सस्मितं मुदा ।\nस्तूयमानं पञ्चवक्त्रैः परं नारायणं विभुम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002966040, "chapter_id": 22966, "verse_number": "२-१३-४१", "content_sanskrit": "तमुवाच प्रसन्नात्मा प्रसन्नं सुरसंसदि ।\nपीयूषतुल्यं मधुरं वचनं सुमनोहरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002966041, "chapter_id": 22966, "verse_number": "२-१३-४२", "content_sanskrit": "श्रीभगवानुवाच ।\nअत्यन्तमुपहास्यं च शिवप्रश्नं शिवे शिवम् ।\nलौकिकं वैदिकं चैव त्वां पृच्छामि तथा ऽपि शम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002966042, "chapter_id": 22966, "verse_number": "२-१३-४३", "content_sanskrit": "तपसां फलदातारं दातारं सर्वसम्पदाम् ।\nसम्पत्प्रश्नं तपःप्रश्नमयोग्यं त्वां च साम्प्रतम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002966043, "chapter_id": 22966, "verse_number": "२-१३-४४", "content_sanskrit": "ज्ञानाधिदेवे सर्वज्ञे ज्ञानं पृच्छामि किं वृथा ।\nनिरापदि विपत्प्रश्नमलं मृत्युञ्जये हरे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002966044, "chapter_id": 22966, "verse_number": "२-१३-४५", "content_sanskrit": "त्वामेव वाग्धनं प्रश्नमलं स्वाश्रयमागमे ।\nआगतोऽसि कथं वेगादित्युवाच रमापतिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002966045, "chapter_id": 22966, "verse_number": "२-१३-४६", "content_sanskrit": "श्रीमहादेव उवाच ।\nवृषध्वजं च मद्भक्तं मम प्राणाधिकप्रियम् ।\nसूर्य्यः शशाप इति मे हेतुरागमकोपयोः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002966046, "chapter_id": 22966, "verse_number": "२-१३-४७", "content_sanskrit": "पुत्रवात्सल्यशोकेन सूर्य्यं हन्तुं समुद्यतः ।\nस ब्रह्माणं प्रपन्नश्च स सूर्य्यश्च विधिस्त्वयि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002966047, "chapter_id": 22966, "verse_number": "२-१३-४८", "content_sanskrit": "त्वां ये शरणमापन्ना ध्यानेन वचसाऽपि वा ।\nनिरापदस्ते निश्शङ्का जरा मृत्युश्च तैर्जितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002966048, "chapter_id": 22966, "verse_number": "२-१३-४९", "content_sanskrit": "साक्षाद्ये शरणापन्नास्तत्फलं किं वदामि भोः ।\nहरिस्मृतिश्चाभयदा सर्वमङ्गलदा सदा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002966049, "chapter_id": 22966, "verse_number": "२-१३-५०", "content_sanskrit": "किं मे भक्तस्य भविता तन्मे ब्रूहि जगत्प्रभो ।\nश्रीहतस्यास्य मूढस्य सूर्य्यशापेन हेतुना ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002966050, "chapter_id": 22966, "verse_number": "२-१३-५१", "content_sanskrit": "श्रीभगवानुवाच ।\nकालोऽतियातो दैवेन युगानामेकविंशतिः ।\nवैकुण्ठे घटिकार्द्धेन शीघ्रं याहि नृपालयम्॥ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002966051, "chapter_id": 22966, "verse_number": "२-१३-५२", "content_sanskrit": "वृषध्वजो मृतः कालाद्दुर्निवार्य्यात्सुदारुणात् ।\nहंसध्वजश्च तत्पुत्रो मृतः सोऽपि श्रिया हतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002966052, "chapter_id": 22966, "verse_number": "२-१३-५३", "content_sanskrit": "तत्पुत्रौ च महाभागौ धर्मध्वजकुशध्वजौ ।\nहतश्रियौ सूर्य्यशापात्तौ वै परमवैष्णवौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002966053, "chapter_id": 22966, "verse_number": "२-१३-५४", "content_sanskrit": "राज्यभ्रष्टौ श्रिया भ्रष्टौ कमलातापसावुभौ ।\nतयोश्च भार्य्ययोर्लक्ष्मीः कलया च जनिष्यति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002966054, "chapter_id": 22966, "verse_number": "२-१३-५५", "content_sanskrit": "सम्पद्युक्तौ तदा तौ च नृपश्रेष्ठौ भविष्यतः ।\nमृतस्ते सेवकः शम्भो गच्छ यूयं च गच्छत ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002966055, "chapter_id": 22966, "verse_number": "२-१३-५६", "content_sanskrit": "इत्युक्त्वा च सलक्ष्मीकः सभातोऽभ्यन्तरं गतः ।\nदेवा जग्मुश्च संहृष्टाः स्वाश्रमं परमं मुदा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002966056, "chapter_id": 22966, "verse_number": "२-१३-५७", "content_sanskrit": "शिवश्च तपसे शीघ्रं परिपूर्णतमो ययौ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]