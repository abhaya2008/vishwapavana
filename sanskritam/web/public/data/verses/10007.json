[{"id": 6000007000, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "अथ सप्‍तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000007001, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "शौनक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.001.m4a", "display_order": 2}, {"id": 6000007002, "chapter_id": 10007, "verse_number": "१-७-१", "content_sanskrit": "निर्गते नारदे सूत भगवान्बादरायणः।\nश्रुतवांस्तदभिप्रेतं ततः किमकरोद्विभुः॥ १/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.002.m4a", "display_order": 3, "topics": [{"text": "श्रीव्यासेन नारदाज्ञानुसारेण भागवतं निर्माय स्वपुत्राय शुकाचार्याय तदुपदेशः", "range": "१–८"}]}, {"id": 6000007003, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.003.m4a", "display_order": 4}, {"id": 6000007004, "chapter_id": 10007, "verse_number": "१-७-२", "content_sanskrit": "ब्रह्मनद्याः सरस्वत्या आश्रमः पश्‍चिमे तटे।\nशम्याप्रास इति प्रोक्‍त ऋषीणां सत्रवर्धनः॥ १/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.004.m4a", "display_order": 5}, {"id": 6000007005, "chapter_id": 10007, "verse_number": "१-७-३", "content_sanskrit": "तस्मिन् ऋष्याश्रमे व्यासो बदरीषण्डमण्डिते।\nआसीनोऽप उपस्पृश्य प्रणिदध्यौ मनश्‍चिरम्॥ १/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.005.m4a", "display_order": 6}, {"id": 6000007006, "chapter_id": 10007, "verse_number": "१-७-४", "content_sanskrit": "भक्‍तियोगेन मनसि सम्यक् प्रणिहितेऽमले।\nअपश्यत् पुरुषं पूर्णं मायाञ्च तदपाश्रयाम्॥ १/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.006.m4a", "display_order": 7}, {"id": 6000007007, "chapter_id": 10007, "verse_number": "१-७-५", "content_sanskrit": "यया संमोहितो जीव आत्मानं त्रिगुणात्मकम्।\nपरोऽपि मनुतेऽनर्थं तत्कृतञ्चाभिपद्यते॥ १/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.007.m4a", "display_order": 8}, {"id": 6000007008, "chapter_id": 10007, "verse_number": "१-७-६", "content_sanskrit": "अनर्थोपशमं साक्षाद्भक्‍तियोगमधोक्षजे।\nलोकस्याजानतो विद्वांश्‍चक्रे सात्वतसंहिताम्॥ १/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.008.m4a", "display_order": 9}, {"id": 6000007009, "chapter_id": 10007, "verse_number": "१-७-७", "content_sanskrit": "यस्यां वै श्रूयमाणायां कृष्णे परमपूरुषे।\nभक्‍तिरुत्पद्यते पुंसां शोकमोहभयापहा॥ १/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.009.m4a", "display_order": 10}, {"id": 6000007010, "chapter_id": 10007, "verse_number": "१-७-८", "content_sanskrit": "स संहितां भागवतीं कृत्वाऽनुक्रम्य चात्मजम्।\nशुकमध्यापयामास निवृत्तिनिरतं मुनिम्॥ १/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.010.m4a", "display_order": 11}, {"id": 6000007011, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "शौनक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.011.m4a", "display_order": 12}, {"id": 6000007012, "chapter_id": 10007, "verse_number": "१-७-९", "content_sanskrit": "स वै निवृत्तिनिरतः सर्वत्रोपेक्षको मुनिः।\nकस्य वा बृहतीमेतामात्मारामः समभ्यसत्॥ १/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.012.m4a", "display_order": 13, "topics": [{"text": "शौनकेन ‘कस्मिन् युगे प्रवृत्ता इयम्’ [४.३] इति पृष्‍टस्योत्तरतया सूतेन परीक्षिद्वृत्तान्तकथनोपोद्घाततयाऽश्‍वत्थामवृत्तान्त-कथनारम्भः", "range": "९–१२"}]}, {"id": 6000007013, "chapter_id": 10007, "verse_number": "१-७-१०", "content_sanskrit": "आत्मारामाश्‍च मुनयो निर्ग्राह्या अप्युरुक्रमे।\nकुर्वन्त्यहैतुकीं भक्‍तिं इत्थंभूतगुणो हरिः॥ १/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.013.m4a", "display_order": 14}, {"id": 6000007014, "chapter_id": 10007, "verse_number": "१-७-११", "content_sanskrit": "हरेर्गुणाक्षिप्‍तमतिर्भगवान् बादरायणिः।\nअध्यगान्महदाख्यानं नित्यं विष्णुजनप्रियम्॥ १/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.014.m4a", "display_order": 15}, {"id": 6000007015, "chapter_id": 10007, "verse_number": "१-७-१२", "content_sanskrit": "परीक्षितोऽथ राजर्षेः जन्मकर्मविलापनम्।\nसंस्थां च पाण्डुपुत्राणां वक्ष्ये कृष्णकथोदयाम्॥ १/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.015.m4a", "display_order": 16}, {"id": 6000007016, "chapter_id": 10007, "verse_number": "१-७-१३", "content_sanskrit": "यदा मृधे कौरवपाण्डवानां वीरेष्वथो वीरगतिं गतेषु।\nवृकोदराविद्धगदाभिमर्शभग्नोरुदण्डे धृतराष्‍ट्रपुत्रे॥ १/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.016.m4a", "display_order": 17, "topics": [{"text": "भीमसेनेन हतस्य दुर्योधनस्य प्रीतये शिबिरसुप्‍तान् पाण्डवेयान् हतवतोऽश्‍वत्थाम्नो वधाय अर्जुनस्यानुधावनम्", "range": "१३–१७"}]}, {"id": 6000007017, "chapter_id": 10007, "verse_number": "१-७-१४", "content_sanskrit": "भर्तुः प्रियं द्रौणिरिति स्म पश्यन् कृष्णासुतानां स्वपतां शिरांसि।\nअपाहरद्विप्रियमेतदस्य जुगुप्सितं कर्म विगर्हयन्ती॥ १/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.017.m4a", "display_order": 18}, {"id": 6000007018, "chapter_id": 10007, "verse_number": "१-७-१५", "content_sanskrit": "माता शिशूनां निधनं सुतानां निशम्य घोरं परितप्यमाना।\nतदारुदद्बाष्पकलाकुलाक्षी तां सान्त्वयन्नाह किरीटमाली॥ १/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.018.m4a", "display_order": 19}, {"id": 6000007019, "chapter_id": 10007, "verse_number": "१-७-१६", "content_sanskrit": "तन्मा शुचस्ते प्रमृजाशु भद्रे यद्ब्रह्मबन्धोः शिर आततायिनः।\nगाण्डीवमुक्‍तैर्विशिखैरुपाहरे त्वाक्रम्य यत्स्नास्यसि नेत्रजैर्जलैः॥ १/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.019.m4a", "display_order": 20}, {"id": 6000007020, "chapter_id": 10007, "verse_number": "१-७-१७", "content_sanskrit": "इति प्रियां वल्गुविचित्रजल्पैः स सान्त्वयित्वाऽच्युतमित्रसूतः।\nअभ्यद्रवद्दंशित उग्रधन्वा कपिध्वजो गुरुपुत्रं रथेन॥ १/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.020.m4a", "display_order": 21}, {"id": 6000007021, "chapter_id": 10007, "verse_number": "१-७-१८", "content_sanskrit": "तमापतन्तं स विलोक्य दूरात्कुमारहोद्विग्नमना रथेन।\nपराद्रवत्प्राणपरीप्सुरुर्व्यां यावद्गमं रुद्रभयाद्यथाऽऽर्किः॥ १/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.021.m4a", "display_order": 22, "topics": [{"text": "अश्‍वत्थाम्नः प्राणसङ्कटे प्राप्‍ते तेनार्जुनवधाय ब्रह्मास्‍त्रप्रयोगः", "range": "१८–२१"}]}, {"id": 6000007022, "chapter_id": 10007, "verse_number": "१-७-१९", "content_sanskrit": "यदाऽशरणमात्मनमैक्षत श्रान्तवाहनम्।\nअस्‍त्रं ब्रह्मशिरो मेन आत्मत्राणं द्विजात्मजः॥ १/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.022.m4a", "display_order": 23}, {"id": 6000007023, "chapter_id": 10007, "verse_number": "१-७-२०", "content_sanskrit": "अथोपस्पृश्य सलिलं सन्दधेऽस्‍त्रं समाहितः।\nअजानन्नपि संहारं प्राणकृच्छ्र उपस्थिते॥ १/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.023.m4a", "display_order": 24}, {"id": 6000007024, "chapter_id": 10007, "verse_number": "१-७-२१", "content_sanskrit": "ततः प्रादुष्कृतं तेजः प्रचण्डं सर्वतो दिशम्।\nप्रापतत्तदभिप्रेक्ष्य विष्णुं जिष्णुरुवाच ह॥ १/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.024.m4a", "display_order": 25}, {"id": 6000007025, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "अर्जुन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.025.m4a", "display_order": 26}, {"id": 6000007026, "chapter_id": 10007, "verse_number": "१-७-२२", "content_sanskrit": "कृष्ण कृष्ण महाभाग भक्‍तानामभयङ्कर।\nत्वमेको दह्यमानानामपवर्गोऽसि संसृतेः॥ १/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.026.m4a", "display_order": 27, "topics": [{"text": "तत्प्रतिघातार्थमर्जुनेन प्रतिब्रह्मास्‍त्रप्रयोगः", "range": "२२–२९"}]}, {"id": 6000007027, "chapter_id": 10007, "verse_number": "१-७-२३", "content_sanskrit": "त्वमाद्यः पुरुषः साक्षादीश्‍वरः प्रकृतेः परः।\nमायां व्युदस्य चिच्छक्‍त्या कैवल्ये स्थित आत्मनि॥ १/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.027.m4a", "display_order": 28}, {"id": 6000007028, "chapter_id": 10007, "verse_number": "१-७-२४", "content_sanskrit": "स एव जीवलोकस्य मायामोहितचेतसः।\nविधित्सुः स्वेन वीर्येण श्रेयो धर्मादिलक्षणम्॥ १/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.028.m4a", "display_order": 29}, {"id": 6000007029, "chapter_id": 10007, "verse_number": "१-७-२५", "content_sanskrit": "तथाऽयं ‍चावतारस्ते भुवो भारजिहीर्षया।\nस्वानां ‍चानन्यभावानामनुध्यानाय चासकृत्॥ १/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.029.m4a", "display_order": 30}, {"id": 6000007030, "chapter_id": 10007, "verse_number": "१-७-२६", "content_sanskrit": "किमिदं स्वित्कुतो वेति देवदेव न वेद्म्यहम्।\nसर्वतोमुखमायाति तेजः परमदारुणम्॥ १/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.030.m4a", "display_order": 31}, {"id": 6000007031, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.031.m4a", "display_order": 32}, {"id": 6000007032, "chapter_id": 10007, "verse_number": "१-७-२७", "content_sanskrit": "वेत्थेदं द्रोणपुत्रस्य ब्राह्ममस्‍त्रं प्रदर्शितम्।\nनैवासौ वेद संहारं प्राणबाध उपास्थिते॥ १/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.032.m4a", "display_order": 33}, {"id": 6000007033, "chapter_id": 10007, "verse_number": "१-७-२८", "content_sanskrit": "न ह्यस्यान्यतमं किञ्चिदस्‍त्रं प्रत्यवकर्षणम्।\nजह्यस्‍त्रतेज उन्नद्धमस्‍त्रज्ञो ह्यस्‍त्रतेजसा॥ १/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.033.m4a", "display_order": 34}, {"id": 6000007034, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.034.m4a", "display_order": 35}, {"id": 6000007035, "chapter_id": 10007, "verse_number": "१-७-२९", "content_sanskrit": "श्रुत्वा भगवता प्रोक्‍तं फल्गुनः परवीरहा।\nस्पृष्‍ट्वाऽपस्तं परिक्रम्य ब्राह्मं ब्राह्माय सन्दधे॥ १/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.035.m4a", "display_order": 36}, {"id": 6000007036, "chapter_id": 10007, "verse_number": "१-७-३०", "content_sanskrit": "संहत्यान्योन्यमुभयोस्तेजसी शरसंवृते।\nआवृत्य रोदसी खं ‍च ववृधातेऽर्कवह्निवत्॥ १/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.036.m4a", "display_order": 37, "topics": [{"text": "ब्रह्मास्‍त्रद्वयेनोत्पन्नं प्रजोपप्लवमालक्ष्य अर्जुनेन श्रीकृष्णाज्ञया स्वास्‍त्रोपसंहारपूर्वकम् अश्‍वत्थाम्नो बन्धनेन द्रौपदीसमीपप्रापणम्", "range": "३०–४०"}]}, {"id": 6000007037, "chapter_id": 10007, "verse_number": "१-७-३१", "content_sanskrit": "दृष्‍ट्वाऽस्‍त्रतेजस्तु तयोस्‍त्रील्‍ँलोकान्प्रदहन्महत्।\nदह्यमानाः प्रजास्सर्वाः सांवर्तकममंसत॥ १/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.037.m4a", "display_order": 38}, {"id": 6000007038, "chapter_id": 10007, "verse_number": "१-७-३२", "content_sanskrit": "प्रजोपप्लवमालक्ष्य लोकव्यतिकरं च तम्।\nमतं च वासुदेवस्य संजहारार्जुनो द्वयम्॥ १/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.038.m4a", "display_order": 39}, {"id": 6000007039, "chapter_id": 10007, "verse_number": "१-७-३३", "content_sanskrit": "तत आसाद्य तरसा दारुणं गौतमीसुतम्।\nबबन्धामर्षताम्राक्षः पशुं रशनया यथा॥ १/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.039.m4a", "display_order": 40}, {"id": 6000007040, "chapter_id": 10007, "verse_number": "१-७-३४", "content_sanskrit": "शिबिराय निनीषन्तं रज्‍ज्वा बद्‍ध्वा रिपुं बलात्।\nप्राहार्जुनं प्रकुपितो भगवानम्बुजेक्षणः॥ १/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.040.m4a", "display_order": 41}, {"id": 6000007041, "chapter_id": 10007, "verse_number": "१-७-३५", "content_sanskrit": "मैनं पार्थार्हसि त्रातुं ब्रह्यबन्धुमिमं जहि।\nयोऽसावनागसः सुप्‍तानवधीन्निशि बालकान्॥ १/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.041.m4a", "display_order": 42}, {"id": 6000007042, "chapter_id": 10007, "verse_number": "१-७-३६", "content_sanskrit": "मत्तं प्रमत्तमुन्मत्तं सुप्‍तं बालं स्‍त्रियं जडम्।\nप्रपन्नं विरथं भीतं न रिपुं हन्ति धर्मवित्॥ १/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.042.m4a", "display_order": 43}, {"id": 6000007043, "chapter_id": 10007, "verse_number": "१-७-३७", "content_sanskrit": "स्वप्राणान् यः परप्राणैः प्रपुष्णात्यघृणः खलः।\nतद्वधस्तस्य हि श्रेयः यद्दोषाद् यात्यधः पुमान्॥ १/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.043.m4a", "display_order": 44}, {"id": 6000007044, "chapter_id": 10007, "verse_number": "१-७-३८", "content_sanskrit": "प्रतिश्रुतं ‍च भवता पाञ्चाल्यै शृण्वतो मम।\nआहरिष्ये शिरस्तस्य यस्ते मानिनि पुत्रहा॥ १/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.044.m4a", "display_order": 45}, {"id": 6000007045, "chapter_id": 10007, "verse_number": "१-७-३९", "content_sanskrit": "तदसौ वध्यतां पाप आतताय्यात्मबन्धुहा।\nभर्तुश्‍च विप्रियं वीर कृतवान्कुलपांसनः॥ १/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.045.m4a", "display_order": 46}, {"id": 6000007046, "chapter_id": 10007, "verse_number": "१-७-४०", "content_sanskrit": "एवं परीक्षता धर्मं पार्थः कृष्णेन चोदितः।\nनैच्छद्धन्तुं गुरुसुतं यद्यप्यात्महनं महान्॥ १/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.046.m4a", "display_order": 47}, {"id": 6000007047, "chapter_id": 10007, "verse_number": "१-७-४१", "content_sanskrit": "अथोपेत्य स्वशिबिरं गोविन्दप्रियसारथिः।\nन्यवेदयत्तं प्रियायै शोचन्त्या आत्मजान् हतान्॥ १/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.047.m4a", "display_order": 48}, {"id": 6000007048, "chapter_id": 10007, "verse_number": "१-७-४२", "content_sanskrit": "तथाऽऽहृतं पशुवत्पाशबद्धमवाङ्मुखं कर्मजुगुप्सितेन।\nनिरीक्ष्य कृष्णापकृतं गुरोः सुतं वामस्वभावा कृपया ननाम॥ १/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.048.m4a", "display_order": 49, "topics": [{"text": "द्रौपदीप्रार्थनयाऽर्जुनेनाश्‍वत्थाममूर्धन्यमणिहरणपूर्वकं तस्य शिबिराद्बहिर्निष्कासनम्", "range": "४२–५७"}]}, {"id": 6000007049, "chapter_id": 10007, "verse_number": "१-७-४३", "content_sanskrit": "उवाचासहन्त्यस्य बन्धनाऽनयनं सती।\nमुच्यतां मुच्यतामेष ब्राह्यणो नितरां गुरुः॥ १/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.049.m4a", "display_order": 50}, {"id": 6000007050, "chapter_id": 10007, "verse_number": "१-७-४४", "content_sanskrit": "सरहस्यो धनुर्वेदः सविसर्गोपसंयमः।\nअस्‍त्रग्रामश्‍च भवता शिक्षितो यदनुग्रहात्॥ १/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.050.m4a", "display_order": 51}, {"id": 6000007051, "chapter_id": 10007, "verse_number": "१-७-४५", "content_sanskrit": "स एष भगवान्द्रोणः प्रजारूपेण वर्तते।\nतस्याऽऽत्मनोऽर्धं पत्‍न्या‍स्ते नान्वगाद्वीरसूः कृपी॥ १/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.051.m4a", "display_order": 52}, {"id": 6000007052, "chapter_id": 10007, "verse_number": "१-७-४६", "content_sanskrit": "तद्धर्मज्ञ महाभाग भवद्भिः कौरवं कुलम्।\nवृजिनं नार्हति प्राप्‍तुं पूज्यं वन्द्यमभीक्ष्णशः॥ १/७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.052.m4a", "display_order": 53}, {"id": 6000007053, "chapter_id": 10007, "verse_number": "१-७-४७", "content_sanskrit": "मा रोदीदस्य जननी गौतमी पतिदेवता।\nयथाऽहं मृतवत्साऽऽर्ता रोदिम्यश्रुमुखी मुहुः॥ १/७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.053.m4a", "display_order": 54}, {"id": 6000007054, "chapter_id": 10007, "verse_number": "१-७-४८", "content_sanskrit": "यैः कोपितं ब्रह्मकुलं राजन्यैरकृतात्मभिः।\nतत्कुलं प्रदहत्याशु सानुबन्धं शुचाऽर्पितम्॥ १/७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.054.m4a", "display_order": 55}, {"id": 6000007055, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.055.m4a", "display_order": 56}, {"id": 6000007056, "chapter_id": 10007, "verse_number": "१-७-४९", "content_sanskrit": "धर्म्यं न्याय्यं सकरुणं निर्व्यलीकं समं महत्।\nराजा धर्मसुतो राज्ञ्याः प्रत्यनन्दद्वचो द्विजाः॥ १/७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.056.m4a", "display_order": 57}, {"id": 6000007057, "chapter_id": 10007, "verse_number": "१-७-५०", "content_sanskrit": "नकुलः सहदेवश्‍च युयुधानो धनञ्जयः।\nभगवान्देवकीपुत्रो ये चान्ये याश्‍च योषितः॥ १/७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.057.m4a", "display_order": 58}, {"id": 6000007058, "chapter_id": 10007, "verse_number": "१-७-५१", "content_sanskrit": "तत्राहामर्षितो भीमः तस्य श्रेयान्वधः स्मृतः।\nन भर्तुरात्मनश्‍चार्थे योऽहन्सुप्‍तान् शिशून् वृथा॥ १/७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.058.m4a", "display_order": 59}, {"id": 6000007059, "chapter_id": 10007, "verse_number": "१-७-५२", "content_sanskrit": "निशम्य भीमगदितं द्रौपद्याश्‍च चतुर्भुजः।\nआलोक्य वदनं सख्युरिदमाह हसन्निव॥ १/७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.059.m4a", "display_order": 60}, {"id": 6000007060, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "श्री भगवान् उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.060.m4a", "display_order": 61}, {"id": 6000007061, "chapter_id": 10007, "verse_number": "१-७-५३", "content_sanskrit": "ब्रह्मबन्धुर्न हन्तव्य आततायी वधार्हणः।\nमयैवोभयमाम्नातं परिपाह्यनुशासनम्॥ १/७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.061.m4a", "display_order": 62}, {"id": 6000007062, "chapter_id": 10007, "verse_number": "१-७-५४", "content_sanskrit": "कुरु प्रतिश्रुतं सत्यं यत्तत् सान्त्वयता प्रियाम्।\nप्रियं ‍च भीमसेनस्य पाञ्चाल्यै मह्यमेव च॥ १/७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.062.m4a", "display_order": 63}, {"id": 6000007063, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.063.m4a", "display_order": 64}, {"id": 6000007064, "chapter_id": 10007, "verse_number": "१-७-५५", "content_sanskrit": "अर्जुनः सहसाऽऽज्ञाय हरेर्हार्दमथासिना।\nमणिं जहार मूर्धन्यं द्विजस्य सहमूर्धजम्॥ १/७/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.064.m4a", "display_order": 65}, {"id": 6000007065, "chapter_id": 10007, "verse_number": "१-७-५६", "content_sanskrit": "विमुच्य रशनाबद्धं बालहत्याहतप्रभम्।\nतेजसा मणिना हीनं शिबिरान्निरवापयत्॥ १/७/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.065.m4a", "display_order": 66}, {"id": 6000007066, "chapter_id": 10007, "verse_number": "१-७-५७", "content_sanskrit": "बन्धनं द्रविणादानं स्थानान्निर्यापणं तथा।\nएष हि ब्रह्मबन्धूनां वधो नान्योऽस्ति दैहिकः॥ १/७/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_007/BhP_01.007.066.m4a", "display_order": 67}, {"id": 6000007067, "chapter_id": 10007, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे सप्‍तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]