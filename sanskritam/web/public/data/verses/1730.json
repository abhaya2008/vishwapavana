[{"id": 2033811, "chapter_id": 1730, "verse_number": "४-५३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033812, "chapter_id": 1730, "verse_number": "४-५३-१", "content_sanskrit": "ततः सुदर्शनं नाम प्रासादं हरिवाहनः ।\nसर्वान्देवान्समारोष्य प्रययो यत्र पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033813, "chapter_id": 1730, "verse_number": "४-५३-२", "content_sanskrit": "स्थूणाराजिसहस्रं तु यत्र मध्ये प्रतिष्ठितम् ।\nतत्र सूर्यपथेऽतिष्ठद्विमला महती सभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033814, "chapter_id": 1730, "verse_number": "४-५३-३", "content_sanskrit": "आदित्या वसवो रुद्रा अश्विनौ च मरुद्गणाः ।\nतत्र श्वेतानि चक्राणि काञ्चनस्फाटिकानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033815, "chapter_id": 1730, "verse_number": "४-५३-४", "content_sanskrit": "तथा चित्राणि छत्राणि दिव्यरूपाणि भारत ।\nमणिरत्नविचित्राणि नानारूपाणि भागशः ।\nआकाशे सह दृश्यन्ते भानुमन्ति शुभानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033816, "chapter_id": 1730, "verse_number": "४-५३-५", "content_sanskrit": "अग्नेरिन्द्रस्य सोमस्य यमस्य वरुणस्य च।\nतथा धातुर्विधातुश्च मित्रस्य धनदस्य च।\nरुद्रस्य विष्णो सवितुस्त्रिदशानां तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033817, "chapter_id": 1730, "verse_number": "४-५३-६", "content_sanskrit": "काञ्चनानि च दामानि विविधाश्चोत्तमस्रजः।\nदिव्यपुष्पाभिसवीतास्तत्र चित्राणि भेजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033818, "chapter_id": 1730, "verse_number": "४-५३-७", "content_sanskrit": "तस्मिंस्तु राजन्प्रासादे दिव्यरत्नविभूषिते ।\nदिव्यगन्धसमायुक्ताः स्रजो दिव्याश्चकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033819, "chapter_id": 1730, "verse_number": "४-५३-८", "content_sanskrit": "दिव्यश्च वायुः प्रववौ गन्धमादाय सर्वशः ।\nऋतवः पुष्पमादाय समतिष्ठन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033820, "chapter_id": 1730, "verse_number": "४-५३-९", "content_sanskrit": "प्रजानां पतयः सप्त सप्त चैव महर्षभः।\nतत्र देवर्षयश्चैव देवराजं दिवौकसः ।\nइन्द्रेण सहिताः सर्वे त्रिदशाश्च व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033821, "chapter_id": 1730, "verse_number": "४-५३-१०", "content_sanskrit": "न पङ्को न रजस्तत्र प्रविवेश कथंचन ।\nआदित्यश्च विरूक्षोत्र नातिवेलमिवातपत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033822, "chapter_id": 1730, "verse_number": "४-५३-११", "content_sanskrit": "दिव्यगन्धं समादाय वायुस्तत्राभिगच्छति।\nआकाशं च दिशः सर्वा दर्शनीयमदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033823, "chapter_id": 1730, "verse_number": "४-५३-१२", "content_sanskrit": "तत्र देवाः समारुह्य तं दिव्यं सर्वतःप्रभम् ।\nअम्बरे विमलेऽतिष्ठन्प्रासादं कामगामिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033824, "chapter_id": 1730, "verse_number": "४-५३-१३", "content_sanskrit": "तत्र राजर्षयश्चैव समारुह्य दिवौकसः ।\nश्वेतो राजा वसुमनास्तथा भद्रः प्रदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033825, "chapter_id": 1730, "verse_number": "४-५३-१४", "content_sanskrit": "नृगो ययातिर्नहुपो मान्धात भरतः कुरुः ।\nअष्टकश्च शिबिश्चोभौ स च राजा पुरूरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033826, "chapter_id": 1730, "verse_number": "४-५३-१५", "content_sanskrit": "डम्भोद्भवः कार्तवीर्यो ह्यर्जुनः सगरस्तथा।\nदिलीपः केरलः पूरुः शर्यातिः सोमकस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033827, "chapter_id": 1730, "verse_number": "४-५३-१६", "content_sanskrit": "हरिश्चन्द्रश्च तेजस्वी रघुर्दशरथस्तथा।\nभगीरथश्च राजर्षिः सर्वे च जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033828, "chapter_id": 1730, "verse_number": "४-५३-१७", "content_sanskrit": "पाण्डुश्चैव महाराजश्चामरव्यजनोज्ज्वलः।\nछत्रेण ध्रियमाणेन राजसूयश्रिया वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033829, "chapter_id": 1730, "verse_number": "४-५३-१८", "content_sanskrit": "एते चान्ये च बहवः पुण्यशीलाः शुचिव्रताः ।\nकीर्तिमन्तो महावीर्यास्तत्रैवासन्दिवि स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033830, "chapter_id": 1730, "verse_number": "४-५३-१९", "content_sanskrit": "गणाश्चाप्सरसां सर्वे गन्धर्वाश्चापि सर्वशः ।\nदैत्यराक्षसयक्षाश्च सुपर्णाः पन्नगास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033831, "chapter_id": 1730, "verse_number": "४-५३-२०", "content_sanskrit": "वासवप्रमुखाः सर्वे देवाश्च सगणेश्वराः ।\nआसंस्तत्र समारूढाः संग्रामं तं दिदृक्षवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033832, "chapter_id": 1730, "verse_number": "", "content_sanskrit": "इत्यम्बरे व्यवस्थाय प्रासादस्था दिवौकसः ।\nएकस्य च बहूनां च युद्धं द्रुष्टुं व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]