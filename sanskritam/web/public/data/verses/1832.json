[{"id": 2038222, "chapter_id": 1832, "verse_number": "५-७७-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038223, "chapter_id": 1832, "verse_number": "५-७७-१", "content_sanskrit": "उक्तं युधिष्ठिरेणैव यावद्वाच्यं जनार्दन ।\nतव वाक्यं तु मे श्रुत्वा प्रतिभाति परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038224, "chapter_id": 1832, "verse_number": "५-७७-२", "content_sanskrit": "नैव प्रशममत्र त्वं मन्यसे सुकरं प्रभो ।\nलोभाद्वा धृतराष्ट्रस्य दैन्याद्वा समुपस्थितात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038225, "chapter_id": 1832, "verse_number": "५-७७-३", "content_sanskrit": "अफलं मन्यसे वाऽपि पुरुषस्य पराक्रमम् ।\nन चान्तरेण कर्माणि पौरुषेण बलोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038226, "chapter_id": 1832, "verse_number": "५-७७-४", "content_sanskrit": "तदिदं भाषितं वाक्यं तथाचन तथैव तत्।\nन चैतदेवं द्रष्टव्यमसाध्यमपि किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038227, "chapter_id": 1832, "verse_number": "५-७७-५", "content_sanskrit": "किं चैतन्मन्यसे कृच्छ्रमस्माकमवसादकम्।\nकुर्वन्ति तेषां कर्माणि येषां नास्ति फलोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038228, "chapter_id": 1832, "verse_number": "५-७७-६", "content_sanskrit": "संपाद्यमानं सम्यक्व स्यात्कर्म सफलं प्रभो।\nस तथा कृष्ण वर्तस्व यथा शर्म भवेत्परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038229, "chapter_id": 1832, "verse_number": "५-७७-७", "content_sanskrit": "पाण्डवानां कुरूणां च भवान्नः प्रथमः सुहृत्।\nसुराणामसुराणां च यथा वीर प्रजापतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038230, "chapter_id": 1832, "verse_number": "५-७७-८", "content_sanskrit": "कुरूणां पाण्डवानां च प्रतिपत्स्व निरामयम् ।\nअस्मद्धितमनुष्ठानं मन्ये तव न दुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038231, "chapter_id": 1832, "verse_number": "५-७७-९", "content_sanskrit": "एवं च कार्यतामेति कार्यं तव जनार्दन ।\nगमनादेवमेव त्वं करिष्यसि जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038232, "chapter_id": 1832, "verse_number": "५-७७-१०", "content_sanskrit": "चिकीर्षितमथान्यत्ते तस्मिन्वीर दुरात्मानि ।\nभविष्यति च तत्सर्वं यथा तव चिकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038233, "chapter_id": 1832, "verse_number": "५-७७-११", "content_sanskrit": "शर्म तैः सह वा नोऽस्तु तव वा यच्चिकीर्षितम् ।\nविचार्यमाणो यः कामस्तव कृष्ण स नो गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038234, "chapter_id": 1832, "verse_number": "५-७७-१२", "content_sanskrit": "न स नार्हति दुष्टात्मा वधं ससुतबान्धवः।\nयेन धर्मसुते दृष्टा न सा श्रीरुपमर्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038235, "chapter_id": 1832, "verse_number": "५-७७-१३", "content_sanskrit": "यच्चाप्यपश्यतोपायं धर्मिष्ठं मधुसूदन।\nउपायेन नृशंसेन हृता दुर्द्यूतदेविना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038236, "chapter_id": 1832, "verse_number": "५-७७-१४", "content_sanskrit": "कथं हि पुरुषो जातः क्षत्रियेषु धनुर्धरः ।\nसमाहूतो निवर्तेत प्राणत्यागेऽप्युपस्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038237, "chapter_id": 1832, "verse_number": "५-७७-१५", "content_sanskrit": "अधर्मेण जितान्दृष्ट्वा वने प्रवृजितांस्तथा।\nवध्यतां मम वार्ष्णेय निर्गतोऽसौ सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038238, "chapter_id": 1832, "verse_number": "५-७७-१६", "content_sanskrit": "न चैतदद्भुतं कृष्ण मित्रार्थे यच्चिकीर्षसि।\nक्रिया कथंच मुख्या स्यान्मृदुना चेतरेण वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038239, "chapter_id": 1832, "verse_number": "५-७७-१७", "content_sanskrit": "अथवा मन्यसे ज्यायान्वधस्तेषामनन्तरम् ।\nतदेव क्रियतामाशु न विचार्यमतस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038240, "chapter_id": 1832, "verse_number": "५-७७-१८", "content_sanskrit": "जानासि हि यथैतेन द्रौपदी पापबुद्धिना ।\nपरिक्लिष्टा सभामध्ये तच्च तस्योपमर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038241, "chapter_id": 1832, "verse_number": "५-७७-१९", "content_sanskrit": "स नाम सम्यग्वर्तेत पाण्डवेष्विति माधव।\nन मे सञ्जायते बुद्धिर्बीजमुप्तमिवोषरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038242, "chapter_id": 1832, "verse_number": "५-७७-२०", "content_sanskrit": "तस्माद्यन्मन्यसे युक्तं पाण्डवानां हितं च यत्।\nतथाऽऽशु कुरु वार्ष्णेय यन्नः कार्यमनन्तरम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038243, "chapter_id": 1832, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि सप्तसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]