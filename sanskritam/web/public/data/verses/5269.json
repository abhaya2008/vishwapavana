[{"id": 2200418, "chapter_id": 5269, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200419, "chapter_id": 5269, "verse_number": "१", "content_sanskrit": "क्षत्रियाश्चैव शूद्राश्च मन्त्रहीनाश्च ये द्विजाः ।\nकपिलामुपजीवन्ति कथमेतत् पितर्भवेत्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200420, "chapter_id": 5269, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200421, "chapter_id": 5269, "verse_number": "२", "content_sanskrit": "क्षत्रियाश्चैव शूद्राश्च मन्त्रहीनाश्च ये द्विजाः ।\nकपिलामुपजीवन्ति तेषां वक्ष्यामि निर्णयम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200422, "chapter_id": 5269, "verse_number": "३", "content_sanskrit": "कपिलास्तूत्तमा लोके गोषु चैवोत्तमा मताः ।\nतासां दाता लभेत् स्वर्गं विधिना यश्च सेवते\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200423, "chapter_id": 5269, "verse_number": "४", "content_sanskrit": "स्पृशेत कपिलां यस्तु दण्डेन चरणेन वा ।\nतेन स्पर्शनमात्रेण नरकायोपपद्यते\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200424, "chapter_id": 5269, "verse_number": "५", "content_sanskrit": "मन्त्रेण युञ्ज्यात् कपिलां मन्त्रेणैव प्रमुञ्चते ।\nमन्त्रहीनं तु यो युञ्ज्यात् कृमियोनौ प्रसूयते\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200425, "chapter_id": 5269, "verse_number": "६", "content_sanskrit": "प्रहारहतमर्माङ्गा दुःखेन च जडीकृता ।\nपदानि यावद् गच्छेत तावल्लोकान् कृमिर्भवेत्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200426, "chapter_id": 5269, "verse_number": "७", "content_sanskrit": "यावच्च बिन्दवस्तस्याः शोणितस्य क्षितिं गताः ।\nतावद् वर्षसहस्राणि नरकं प्रतिपद्यते\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200427, "chapter_id": 5269, "verse_number": "८", "content_sanskrit": "मन्त्रेण युञ्ज्यात् कपिलां मन्त्रेण विनियोजयेत् ।\nमन्त्रहीनैरनुयुतो मज्जयेत् तमसि प्रभो\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200428, "chapter_id": 5269, "verse_number": "९", "content_sanskrit": "कपिलां येऽपि जीवन्ति बुद्धिमोहान्विता नराः ।\nतेऽपि वर्षसहस्राणि पतन्ति नरके नृप\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200429, "chapter_id": 5269, "verse_number": "१०", "content_sanskrit": "अथ न्यायेन ये विप्राः कपिलामुपयुञ्जते ।\nतस्मिन् लोके प्रमोदन्ते लोकाश्चैषामनामयाः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200430, "chapter_id": 5269, "verse_number": "११", "content_sanskrit": "विधिना ये न कुर्वन्ति शूद्रांस्तानुपधारय\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200431, "chapter_id": 5269, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे कपिलोपजीवनं नाम विंशत्यधिकशततमोऽध्यायः ॥१२०॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]