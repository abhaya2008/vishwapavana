[{"id": 7001223000, "chapter_id": 21223, "verse_number": "२-४-१६-१", "content_sanskrit": "ब्रह्मोवाच ।\nइति श्रुत्वा महेशानो भक्तानुग्रहकारकः ।\nत्वद्वाचा युदकामोभूत्तेन बालेन नारद॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001223001, "chapter_id": 21223, "verse_number": "२-४-१६-२", "content_sanskrit": "विष्णुमाहूय संमंत्र्य बलेन महता युतः ।\nसामरस्सम्मुखस्तस्याप्यभूद्देवस्त्रिलोचनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001223002, "chapter_id": 21223, "verse_number": "२-४-१६-३", "content_sanskrit": "देवाश्च युयुधुस्तेन स्मृत्वा शिवपदाम्बुजम् ।\nमहाबला महोत्साहाश्शिवसद्दृष्टिलोकिताः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001223003, "chapter_id": 21223, "verse_number": "२-४-१६-४", "content_sanskrit": "युयुधेऽथ हरिस्तेन महाबलपराक्रमः ।\nमहादेव्यायुधो वीरः प्रवणः शिवरूपकः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001223004, "chapter_id": 21223, "verse_number": "२-४-१६-५", "content_sanskrit": "यष्ट्या गणाधिपस्सोथ जघानामरपुङ्गवान् ।\nहरिं च सहसा वीरश्शक्तिदत्तमहाबलः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001223005, "chapter_id": 21223, "verse_number": "२-४-१६-६", "content_sanskrit": "सर्वेऽमरगणास्तत्र विकुंठितबला मुने ।\nअभूवन् विष्णुना तेन हता यष्ट्या पराङ्मुखाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001223006, "chapter_id": 21223, "verse_number": "२-४-१६-७", "content_sanskrit": "शिवोपि सह सैन्येन युद्धं कृत्वा चिरं मुने ।\nविकरालं च तं दृष्ट्वा विस्मयं परमं गतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001223007, "chapter_id": 21223, "verse_number": "२-४-१६-८", "content_sanskrit": "छलेनैव च हंतव्यो नान्यथा हन्यते पुनः ।\nइति बुद्धिं समास्थाय सैन्यमध्ये व्यवस्थितः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001223008, "chapter_id": 21223, "verse_number": "२-४-१६-९", "content_sanskrit": "शिवे दृष्टे तदा देवे निर्गुणे गुणरूपिणि ।\nविष्णौ चैवाथ संग्रामे आयाते सर्वदेवताः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001223009, "chapter_id": 21223, "verse_number": "२-४-१६-१०", "content_sanskrit": "गणाश्चैव महेशस्य महाहर्षं तदा ययुः ।\nसर्वे परस्परं प्रीत्या मिलित्वा चक्रुरुत्सवम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001223010, "chapter_id": 21223, "verse_number": "२-४-१६-११", "content_sanskrit": "अथ शक्तिसुतो वीरो वीरगत्या स्वयष्टितः ।\nप्रथम पूजयामास विष्णुं सर्वसुखावहम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001223011, "chapter_id": 21223, "verse_number": "२-४-१६-१२", "content_sanskrit": "अहं च मोहयिष्यामि हन्यतां च त्वया विभो ।\nछलं विना न वध्योऽयं तामसोयं दुरासदः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001223012, "chapter_id": 21223, "verse_number": "२-४-१६-१३", "content_sanskrit": "इति कृत्वा मतिं तत्र सुसंमंत्र्य च शंभुना ।\nआज्ञां प्राप्याऽभवच्छैवी विष्णुर्मोहपरायणः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001223013, "chapter_id": 21223, "verse_number": "२-४-१६-१४", "content_sanskrit": "शक्तिद्वयं तथा लीनं हरिं दृष्ट्वा तथाविधम् ।\nदत्त्वा शक्तिबलं तस्मै गणेशायाभवन्मुने॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001223014, "chapter_id": 21223, "verse_number": "२-४-१६-१५", "content_sanskrit": "शक्तिद्वयेऽथ संलीने यत्र विष्णुः स्थितस्स्वयम् ।\nपरिघं क्षिप्तवांस्तत्र गणेशो बलवत्तरः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001223015, "chapter_id": 21223, "verse_number": "२-४-१६-१६", "content_sanskrit": "कृत्वा यत्नं किमप्यत्र वंचयामास तद्गतिम् ।\nशिवं स्मृत्वा महेशानं स्वप्रभुं भक्तवत्सलम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001223016, "chapter_id": 21223, "verse_number": "२-४-१६-१७", "content_sanskrit": "एकतस्तन्मुखं दृष्ट्वा शंकरोप्याजगाम ह ।\nस्वत्रिशूलं समादाय सुक्रुद्धो युद्धकाम्यया॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001223017, "chapter_id": 21223, "verse_number": "२-४-१६-१८", "content_sanskrit": "स ददर्शागतं शंभुं शूलह्स्तं महेश्वरम् ।\nहंतुकामं निजं वीरश्शिवापुत्रो महाबलः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001223018, "chapter_id": 21223, "verse_number": "२-४-१६-१९", "content_sanskrit": "शक्त्या जघान तं हस्ते स्मृत्वा मातृपदांबुजम् ।\nस गणशो महावीरश्शिवशक्तिप्रवर्द्धितः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001223019, "chapter_id": 21223, "verse_number": "२-४-१६-२०", "content_sanskrit": "त्रिशूलं पतितं हस्ताच्छिवस्य परमात्मनः ।\nदृष्ट्वा सदूतिकस्तं वै पिनाकं धनुराददे॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001223020, "chapter_id": 21223, "verse_number": "२-४-१६-२१", "content_sanskrit": "तमप्यपातयद्भूमौ परिघेण गणेश्वरः ।\nहताः पंच तथा हस्ताः पञ्चभिश्शूलमाददे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001223021, "chapter_id": 21223, "verse_number": "२-४-१६-२२", "content_sanskrit": "अहो दुःखतरं नूनं संजातमधुना मम ।\nभवेत्पुनर्गणानां किं भवाचारी जगाविति॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001223022, "chapter_id": 21223, "verse_number": "२-४-१६-२३", "content_sanskrit": "एतस्मिन्नंतरे वीरः परिघेण गणेश्वरः ।\nजघान सगणान् देवान्शक्तिदत्तबलान्वितः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001223023, "chapter_id": 21223, "verse_number": "२-४-१६-२४", "content_sanskrit": "गता दशदिशो देवास्सगणा परिघार्द्दिताः ।\nन तस्थुस्समरे केपि तेनाद्भुतप्रहा रिणा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001223024, "chapter_id": 21223, "verse_number": "२-४-१६-२५", "content_sanskrit": "विष्णुस्तं च गणं दृष्ट्वा धन्योयमिति चाब्रवीत् ।\nमहाबलो महावीरो महाशूरो रणप्रियः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001223025, "chapter_id": 21223, "verse_number": "२-४-१६-२६", "content_sanskrit": "बहवो देवताश्चैव मया दृष्टास्तथा पुनः ।\nदानवा बहवो दैत्या यक्षगंधर्वराक्षसाः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001223026, "chapter_id": 21223, "verse_number": "२-४-१६-२७", "content_sanskrit": "नैतेन गणनाथेन समतां यांति केपि च ।\nत्रैलोक्येऽप्यखिले तेजो रूपशौर्यगुणादिभिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001223027, "chapter_id": 21223, "verse_number": "२-४-१६-२८", "content_sanskrit": "एवं संब्रुवतेऽमुष्मै परिघं भ्रामयन् स च ।\nचिक्षेप विष्णवे तत्र शक्तिपुत्रो गणेश्वरः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001223028, "chapter_id": 21223, "verse_number": "२-४-१६-२९", "content_sanskrit": "चक्रं गृहीत्वा हरिणा स्मृत्वा शिवपदाम्बुजम् ।\nतेन चक्रेण परिघो द्रुतं खंडीकृतस्तदा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001223029, "chapter_id": 21223, "verse_number": "२-४-१६-३०", "content_sanskrit": "खंडं तु परिघस्यापि हरये प्राक्षिपद्गणः ।\nगृहीत्वा गरुडेनापि पक्षिणा विफलीकृतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001223030, "chapter_id": 21223, "verse_number": "२-४-१६-३१", "content_sanskrit": "एवं विचरितं कालं महावीरावुभावपि ।\nविष्णुश्चापि गणश्चैव युयुधाते परस्परम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001223031, "chapter_id": 21223, "verse_number": "२-४-१६-३२", "content_sanskrit": "पुनर्वीरवरश्शक्तिसुतस्स्मृतशिवो बली ।\nगृहीत्वा यष्टिमतुलां तया विष्णुं जघान ह॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001223032, "chapter_id": 21223, "verse_number": "२-४-१६-३३", "content_sanskrit": "अविषह्य प्रहारं तं स भूमौ निपपात ह ।\nद्रुतमुत्थाय युयुधे शिवापुत्रेण तेन वै॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001223033, "chapter_id": 21223, "verse_number": "२-४-१६-३४", "content_sanskrit": "एतदंतरमासाद्य शूलपाणिस्तथोत्तरे ।\nआगत्य च त्रिशूलेन तच्छिरो निरकृंतत॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001223034, "chapter_id": 21223, "verse_number": "२-४-१६-३५", "content_sanskrit": "छिन्ने शिरसि तस्यैव गणनाथस्य नारद ।\nगणसैन्यं देवसैन्यमभवच्च सुनिश्चलम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001223035, "chapter_id": 21223, "verse_number": "२-४-१६-३६", "content_sanskrit": "नारदेन त्वयाऽऽगत्य देव्यै सर्वं निवेदितम् ।\nमानिनि श्रूयतां मानस्त्याज्यो नैव त्वयाधुना॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001223036, "chapter_id": 21223, "verse_number": "२-४-१६-३७", "content_sanskrit": "इत्युक्त्वाऽन्तर्हितस्तत्र नारद त्वं कलिप्रियः ।\nअविकारी सदा शंभुर्मनोगतिकरो मुनिः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]