[{"id": 7005452000, "chapter_id": 25452, "verse_number": "१-२२-१", "content_sanskrit": "रोमहर्षण उवाच ।\nऐलः पुरूरवाश्चाथ राजा राज्यमपालयत् ।\nतस्य पुत्रा बभूवुर्हि षडिन्द्रसमतेजसः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005452001, "chapter_id": 25452, "verse_number": "१-२२-२", "content_sanskrit": "आयुर्मायुरमायुश्चर्विश्वायुश्चैव वीर्यवान् ।\nशतायुश्च श्रुतायुश्च दिव्याश्चैवोर्वशीसुताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005452002, "chapter_id": 25452, "verse_number": "१-२२-३", "content_sanskrit": "आयुषस्तनया वीराः पञ्चैवासन् महौजसः ।\nस्वर्भानुतनयायां वै प्रभायामिति नः श्रुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005452003, "chapter_id": 25452, "verse_number": "१-२२-४", "content_sanskrit": "नहुषः प्रथमस्तेषां धर्मज्ञो लोकविश्रुतः ।\nनहुषस्य तु दायादाः षडिन्द्रोपमतेजसः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005452004, "chapter_id": 25452, "verse_number": "१-२२-५", "content_sanskrit": "उत्पन्नाः पितृकन्यायां विरजायां महाबलाः ।\nयतिर्ययातिः संयातिरायातिः पञ्चकोऽश्वकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005452005, "chapter_id": 25452, "verse_number": "१-२२-६", "content_sanskrit": "तेषां ययातिः पञ्चानां महाबलपराक्रमः ।\nदेवयानीमुशनसः सुतां भार्यामवाप सः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005452006, "chapter_id": 25452, "verse_number": "१-२२-७", "content_sanskrit": "शर्मिष्ठामासुरीं चैव तनयां वृषपर्वणः ।\nयदुं च तुर्वसुं चैव देवयानी व्यजायत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005452007, "chapter_id": 25452, "verse_number": "१-२२-८", "content_sanskrit": "द्रुह्युं चानुं च पूरुं च शर्मिष्ठा चाप्यजीजनत् ।\nसोऽभ्यषिञ्चदतिक्रम्य ज्येष्ठं यदुमनिन्दितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005452008, "chapter_id": 25452, "verse_number": "१-२२-९", "content_sanskrit": "पुरुमेव कनीयांसं पितुर्वचनपालकम् ।\nदिशि दक्षिणपूर्वस्यां तुर्वसुं पुत्रमादिशत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005452009, "chapter_id": 25452, "verse_number": "१-२२-१०", "content_sanskrit": "दक्षिणापरयो राजा यदुं ज्येष्ठं न्ययोजयत् ।\nप्रतीच्यामुत्तारायां च द्रुह्युं चानुमकल्पयत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005452010, "chapter_id": 25452, "verse_number": "१-२२-११", "content_sanskrit": "तैरियं पृथिवी सर्वा धर्मतः परिपालिता ।\nराजाऽपि दारसहितो नवं प्राप महायशाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005452011, "chapter_id": 25452, "verse_number": "१-२२-१२", "content_sanskrit": "यदोरप्यभवन् पुत्राः पञ्च देवसुतोपमाः ।\nसहस्त्रजित् तथाज्येष्ठः क्रोषटुर्नीलोऽजिनोरघुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005452012, "chapter_id": 25452, "verse_number": "१-२२-१३", "content_sanskrit": "सहस्त्रजित्सुतस्तद्वच्छतजिन्नाम पार्थिवः ।\nसुताः शतजितोऽप्यासंस्त्रयः परमधार्मिकाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005452013, "chapter_id": 25452, "verse_number": "१-२२-१४", "content_sanskrit": "हैहयश्च हयश्चैव राजा वेणुहयश्च यः ।\nहैहयस्याभवत् पुत्रो धर्म इत्यभिविश्रुतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005452014, "chapter_id": 25452, "verse_number": "१-२२-१५", "content_sanskrit": "तस्य पुत्रोऽभवद् विप्रा धर्मनेत्रः प्रतापवान् ।\nधर्मनेत्रस्य कीर्त्तिस्तु संजितस्तत्सुतोऽभवत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005452015, "chapter_id": 25452, "verse_number": "१-२२-१६", "content_sanskrit": "महिष्मान् संजितस्याभूद् भद्रश्रेण्यस्तदन्वयः ।\nभद्रश्रेण्यस्य दायादो दुर्दमो नाम पार्थिवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005452016, "chapter_id": 25452, "verse_number": "१-२२-१७", "content_sanskrit": "दुर्दमस्य सुतो धीमान् धनको नाम वीर्यवान् ।\nअन्धकस्य तु दायादाश्चत्वारो लोकसम्मताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005452017, "chapter_id": 25452, "verse_number": "१-२२-१८", "content_sanskrit": "कृतवीर्यः कृताग्निश्च कृतवर्मा तथैव च ।\nकृतौजाश्च चतुर्थोऽभूत् कार्त्तवीर्योऽर्जुनोऽभवत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005452018, "chapter_id": 25452, "verse_number": "१-२२-१९", "content_sanskrit": "सहत्रबाहुर्द्युतिमान् धनुर्वेदविदां वरः ।\nतस्य रामोऽभवन्मृत्युर्जामदग्न्यो जनार्दनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005452019, "chapter_id": 25452, "verse_number": "१-२२-२०", "content_sanskrit": "तस्य पुत्रशतान्यासन् पञ्च तत्र महारथाः ।\nकृतास्त्रा बलिनः शूरा धर्मात्मानो मनस्विनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005452020, "chapter_id": 25452, "verse_number": "१-२२-२१", "content_sanskrit": "शूरश्च शूरसेनश्च धृष्णः कृष्णस्तथैव च ।\nजयध्वजश्च बलवान् नारायणपरो नृपः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005452021, "chapter_id": 25452, "verse_number": "१-२२-२२", "content_sanskrit": "शूरसेनादयः सर्वे चत्वारः प्रथितौजसः ।\nरुद्रभक्ता महात्मानः पूजयन्ति स्म शंकरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005452022, "chapter_id": 25452, "verse_number": "१-२२-२३", "content_sanskrit": "जयध्वजस्तु मतिमान् देवं नारायणं हरिम् ।\nजगाम शरणं विष्णुं दैवतं धर्मतत्परः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005452023, "chapter_id": 25452, "verse_number": "१-२२-२४", "content_sanskrit": "तमूचुरितरे पुत्रा नायं धर्मस्तवानघ ।\nईश्वराराधनरतः पिताऽस्माकमिति श्रुतिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005452024, "chapter_id": 25452, "verse_number": "१-२२-२५", "content_sanskrit": "तानब्रवीन्महातेजा एष धर्मः परो मम ।\nविष्णोरंशेन संभूता राजानो ये महीतले ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005452025, "chapter_id": 25452, "verse_number": "१-२२-२६", "content_sanskrit": "राज्यं पालयिताऽवश्यं भगवान् पुरुषोत्तमः ।\nपूजनीयो यतो विष्णुः पालको जगतो हरिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005452026, "chapter_id": 25452, "verse_number": "१-२२-२७", "content_sanskrit": "सात्त्विकी राजसी चैव तामसी च स्वयंभुवः ।\nतिस्त्रस्तु मूर्त्तयः प्रोक्ताः सृष्टिस्थित्यन्तहेतवः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005452027, "chapter_id": 25452, "verse_number": "१-२२-२८", "content_sanskrit": "सत्त्वात्मा भगवान् विष्णुः संस्थापयति सर्वदा ।\nसृजेद् ब्रह्मा रजोमूर्त्तिः संहरेत् तामसो हरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005452028, "chapter_id": 25452, "verse_number": "१-२२-२९", "content_sanskrit": "तस्मान्महीपतीनां तु राज्यं पालयतामयम् ।\nआराध्यो भगवान् विष्णुः केशवः केशिमर्दनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005452029, "chapter_id": 25452, "verse_number": "१-२२-३०", "content_sanskrit": "निशम्य तस्य वचनं भ्रातरोऽन्ये मनस्विनः ।\nप्रोचुः संहारकृद् रुद्रः पूजनीयो मुमुक्षुभिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005452030, "chapter_id": 25452, "verse_number": "१-२२-३१", "content_sanskrit": "अयं हि भगवान् रुद्रः सर्वं जगदिदं शिवः ।\nतमोगुणं समाश्रित्य कल्पान्ते संहरेत् प्रभुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005452031, "chapter_id": 25452, "verse_number": "१-२२-३२", "content_sanskrit": "या सा घोरतमा मूर्त्तिरस्य तेजोमयी परा ।\nसंहरेद् विद्यया सर्वं संसारं शूलभृत्तया ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005452032, "chapter_id": 25452, "verse_number": "१-२२-३३", "content_sanskrit": "ततस्तानब्रवीद् राजा विचिन्त्यासौ जयध्वजः ।\nसत्त्वेन मुच्यते जन्तुः सत्त्वात्मा भगवान् हरिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005452033, "chapter_id": 25452, "verse_number": "१-२२-३४", "content_sanskrit": "तमूचुर्भ्रातरो रुद्रः सेवितः सात्त्विकैर्जनैः ।\nमोचयेत् सत्त्वसंयुक्तः पूजयेत्सततं हरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005452034, "chapter_id": 25452, "verse_number": "१-२२-३५", "content_sanskrit": "अथाब्रवीद् राजपुत्रः प्रहसन् वै जयध्वजः ।\nस्वधर्मो मुक्तये पन्था नान्यो मुनिभिरष्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005452035, "chapter_id": 25452, "verse_number": "१-२२-३६", "content_sanskrit": "तथा च वैष्णवीं शक्ति र्नृपाणान् दधतां सदा ।\nआराधनं परो धर्मो पुरारेरमितौजसः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005452036, "chapter_id": 25452, "verse_number": "१-२२-३७", "content_sanskrit": "तमब्रवीद् राजपुत्रः कृष्णो मतिमतां वरः ।\nयदर्जुनोऽस्मज्जनकः स धर्मं कृतवानिति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005452037, "chapter_id": 25452, "verse_number": "१-२२-३८", "content_sanskrit": "एवं विवादे वितते शूरसेनोऽब्रवीद् वचः ।\nप्रमाणमृषयो ह्यत्र ब्रूयुस्ते यत् तथैव तत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005452038, "chapter_id": 25452, "verse_number": "१-२२-३९", "content_sanskrit": "ततस्ते राजशार्दूलाः पप्रच्छुर्ब्रह्मवादिनः ।\nगत्वा सर्वे सुसंरब्धाः सप्तर्षीणां तदाश्रमम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005452039, "chapter_id": 25452, "verse_number": "१-२२-४०", "content_sanskrit": "तानब्रुवंस्ते मुनयो वसिष्ठाद्या यथार्थतः ।\nया यस्याभिमता पुंसः सा हि तस्यैव देवता ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005452040, "chapter_id": 25452, "verse_number": "१-२२-४१", "content_sanskrit": "किन्तु कार्यविशेषेण पूजिताश्चेष्टदा नृणाम् ।\nविशेषात् सर्वदा नायं नियमो ह्यन्यथा नृपाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005452041, "chapter_id": 25452, "verse_number": "१-२२-४२", "content_sanskrit": "नृपाणां दैवतं विष्णुस्तथैव च पुरंदरः ।\nविप्राणामग्निरादित्यो ब्रह्मा चैव पिनाकधृक् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005452042, "chapter_id": 25452, "verse_number": "१-२२-४३", "content_sanskrit": "देवानां दैवतं विष्णुर्दानवानां त्रिशूलभृत् ।\nगन्धर्वाणां तथा सोमो यक्षाणामपि कथ्यते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005452043, "chapter_id": 25452, "verse_number": "१-२२-४४", "content_sanskrit": "विद्याधराणां वाग्देवी सिद्धानां भगवान्‌हरिः ।\nरक्षसां शंकरो रुद्रः किंनराणां च पार्वती ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005452044, "chapter_id": 25452, "verse_number": "१-२२-४५", "content_sanskrit": "ऋषीणां दैवतं ब्रह्मा महादेवस्त्रिशूलभृत् ।\nमनूनां स्यादुमा देवी तथा विष्णुः सभास्करः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005452045, "chapter_id": 25452, "verse_number": "१-२२-४६", "content_sanskrit": "गृहस्थानां च सर्वे स्युर्ब्रह्मा वै ब्रह्मचारिणाम् ।\nवैखानसानामर्कः स्याद् यतीनां च महेश्वरः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005452046, "chapter_id": 25452, "verse_number": "१-२२-४७", "content_sanskrit": "भूतानां भगवान् रुद्रः कूष्माण्डानां विनायकः ।\nसर्वेषां भगवान् ब्रह्मा देवदेवः प्रजापतिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005452047, "chapter_id": 25452, "verse_number": "१-२२-४८", "content_sanskrit": "इत्येवं भगवान् ब्रह्मा स्वयं देवोह्यभाषत ।\nतस्माज्जयध्वजो नूनं विष्ण्वाराधनमर्हति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005452048, "chapter_id": 25452, "verse_number": "१-२२-४९", "content_sanskrit": "किंतु रुद्रेण तादात्म्यं बुध्वा पूज्यो हरिर्नरैः ।\nअन्यथा नृपतेः शत्रुं न हरि संहरेद्यतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005452049, "chapter_id": 25452, "verse_number": "१-२२-५०", "content_sanskrit": "तान् प्रणम्याथ ते जग्मुः पुरीं परमशोभनाम् ।\nपालयाञ्चक्रिरे पृथ्वीं जित्वा सर्वरिपून् रणे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005452050, "chapter_id": 25452, "verse_number": "१-२२-५१", "content_sanskrit": "ततः कदाचिद् विप्रेन्द्रा विदेहो नाम दानवः ।\nभीषणः सर्वसत्त्वानां पुरीं तेषां समाययौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005452051, "chapter_id": 25452, "verse_number": "१-२२-५२", "content_sanskrit": "दंष्ट्राकरालो दीप्तात्मा युगान्तदहनोपमः ।\nशूलमादाय सूर्याभं नादयन् वै दिशो दश ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005452052, "chapter_id": 25452, "verse_number": "१-२२-५३", "content_sanskrit": "तन्नादश्रवणान्मर्त्यास्तत्र ये निवसन्ति ते ।\nतत्यजुर्जोवितं त्वन्ये दुद्रुवुर्भयविह्वलाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005452053, "chapter_id": 25452, "verse_number": "१-२२-५४", "content_sanskrit": "ततः सर्वे सुसंयत्ताः कार्त्तवीर्यात्मजास्तदा ।\nशूरसेनादयः पञ्च राजानस्तु महाबलाः ।\n॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005452054, "chapter_id": 25452, "verse_number": "१-२२-५५", "content_sanskrit": "युयुधुर्दानवं शक्तिगिरिकूटासिमुद्‌गरैः ।\nतान् सर्वान् दानवो विप्राः शूलेन प्रहसन्निव ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005452055, "chapter_id": 25452, "verse_number": "१-२२-५६", "content_sanskrit": "युद्धाय कृतसंरम्भा विदेहं त्वभिदुद्रुवुः ।\nशूरोऽस्त्रं प्राहिणोद्‌ रौद्रं शूरसेनस्तु वारुणम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005452056, "chapter_id": 25452, "verse_number": "१-२२-५७", "content_sanskrit": "प्राजापत्यं तथा कृष्णो वायव्यं धृष्ण एव च ।\nजयध्वजश्च कौबेरमैन्द्रमाग्नेयमेव च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005452057, "chapter_id": 25452, "verse_number": "१-२२-५८", "content_sanskrit": "भञ्जयामास शूलेन तान्यस्त्राणि स दानवः ।\nततः कृष्णो महावीर्यो गदामादाय भीषणाम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005452058, "chapter_id": 25452, "verse_number": "१-२२-५९", "content_sanskrit": "स्पृष्ट्वा मन्त्रेण तरसा चिक्षेप न ननाद च ।\nसंप्राप्य सा गादाऽस्योरो विदेहस्य शिलोपमम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005452059, "chapter_id": 25452, "verse_number": "१-२२-६०", "content_sanskrit": "न दानवं चालयितुं शशाकान्तकसंनिभम् ।\nदुद्रुवुस्ते भयग्रस्ता दृष्ट्वा तस्यातिपौरुषम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005452060, "chapter_id": 25452, "verse_number": "१-२२-६१", "content_sanskrit": "जयध्वजस्तु मतिमान् सस्मार जगतः पतिम् ।\nविष्णुं जयिष्णुं लोकादिमप्रमेयमनामयम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005452061, "chapter_id": 25452, "verse_number": "१-२२-६२", "content_sanskrit": "त्रातारं पुरुषं पूर्वं श्रीपतिं पीतवाससम् ।\nततः प्रादुरभूच्चक्रं सूर्यायुतसमप्रभम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005452062, "chapter_id": 25452, "verse_number": "१-२२-६३", "content_sanskrit": "आदेशाद् वासुदेवस्य भक्तानुग्रहकारणात् ।\nजग्राह जगतां योनिं स्मृत्वा नारायणं नृपः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005452063, "chapter_id": 25452, "verse_number": "१-२२-६४", "content_sanskrit": "प्राहिणोद् वै विदेहाय दानवेभ्यो यथा हरिः ।\nसंप्राप्य तस्य घोरस्य स्कन्धदेशं सुदर्शनम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005452064, "chapter_id": 25452, "verse_number": "१-२२-६५", "content_sanskrit": "पृथिव्यां पातयामास शिरोऽद्रिशिखराकृति ।\nतस्मिन् हते देवरिपौ शूराद्या भ्रातरो नृपाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005452065, "chapter_id": 25452, "verse_number": "१-२२-६६", "content_sanskrit": "तद्दि चक्रं पुरा विष्णुस्तपसाराध्य शंकरम ।\nयस्मदवाप तत्तस्मादसुराणां विनाशकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005452066, "chapter_id": 25452, "verse_number": "१-२२-६७", "content_sanskrit": "समाययुः पुरीं रम्यां भ्रातरं चाप्यपूजयन् ।\nश्रुत्वाजगाम भगवान् जयध्वजपराक्रमम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005452067, "chapter_id": 25452, "verse_number": "१-२२-६८", "content_sanskrit": "कार्त्तवीर्यसुतं द्रष्टुं विश्वामित्रो महामुनिः ।\nतमागतमथो दृष्ट्वा राजा संभ्रान्तमानसः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005452068, "chapter_id": 25452, "verse_number": "१-२२-६९", "content_sanskrit": "समावेश्यासने रम्ये पूजयामास भावतः ।\nउवाच भगवान् घोरः प्रसादाद् भवतोऽसुरः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005452069, "chapter_id": 25452, "verse_number": "१-२२-७०", "content_sanskrit": "निपातितो मया संख्ये विदेहो दानवेश्वरः ।\nत्वद्वाक्याच्छिन्नसंदेहो विष्णुं सत्यपराक्रमम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005452070, "chapter_id": 25452, "verse_number": "१-२२-७१", "content_sanskrit": "प्रपन्नः शरणं तेन प्रसादो मे कृतः शुभः ।\nयक्ष्यामि परमेशानं विष्णुं पद्मदलेक्षणम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005452071, "chapter_id": 25452, "verse_number": "१-२२-७२", "content_sanskrit": "कथं केन विधानेन संपूज्यो हरिरीश्वरः ।\nकोऽयं नारायणो देवः किंप्रभावश्च सुव्रत ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005452072, "chapter_id": 25452, "verse_number": "१-२२-७३", "content_sanskrit": "सर्वमेतन्ममाचक्ष्व परं कौतूहलं हि मे ।\nजयध्वजस्य वचनं श्रुत्वा शान्तो मुनिस्ततः ।\nदृष्ट्वा हरौ परां भक्तिं विश्वामित्र उवाच ह ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005452073, "chapter_id": 25452, "verse_number": "१-२२-७४", "content_sanskrit": "विश्वामित्र उवाच ।\nयतः प्रवृत्तिर्भूतानां यस्मिन् सर्वं यतो जगत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005452074, "chapter_id": 25452, "verse_number": "१-२२-७५", "content_sanskrit": "स विष्णुः सर्वभूतात्मा तमाश्रित्य विमुच्यते ।\nयमक्षरात्परतरात्परं प्राहुर्गुहश्रयम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005452075, "chapter_id": 25452, "verse_number": "१-२२-७६", "content_sanskrit": "आनन्दं परमं व्योम स वै नारायण स्मृतः । ।\nनित्योदितो निर्विकल्पो नित्यानन्दो नरञ्जनः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005452076, "chapter_id": 25452, "verse_number": "१-२२-७७", "content_sanskrit": "चतुर्व्यूहधरो विष्णुरव्यूहः प्रोच्यते स्वयम् ।\nपरमैत्मा परन्धाम परं व्योम परं पदम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005452077, "chapter_id": 25452, "verse_number": "१-२२-७८", "content_sanskrit": "त्रिपादमक्षरं ब्रह्म तमाहुब्रह्मवादिनः ।\nस वासुदेवो विश्वात्मा योगात्मा पुरुषोत्तमः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005452078, "chapter_id": 25452, "verse_number": "१-२२-७९", "content_sanskrit": "यस्यांश सम्भवो ब्रह्मा रुद्रोऽपि परमेश्वरः ।\nस्ववर्णाश्रमधर्मेण पुंसां यः पुरुषोत्तमः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005452079, "chapter_id": 25452, "verse_number": "१-२२-८०", "content_sanskrit": "अकामहतभावेन समाराध्यो न चान्यथा ।\nएतावदुक्त्वा भगवान् विश्वामित्रो महातपाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005452080, "chapter_id": 25452, "verse_number": "१-२२-८१", "content_sanskrit": "शूराद्यैः पूजितो विप्रा जगामाथ स्वमालयम् ।\nअथ शूरादयो देवमयजन्त महेश्वरम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005452081, "chapter_id": 25452, "verse_number": "१-२२-८२", "content_sanskrit": "यज्ञेन यज्ञगम्यं तं निष्कामा रुद्रमव्ययम् ।\nतान् वसिष्ठस्तु भगवान् याजयामास धर्मवित् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005452082, "chapter_id": 25452, "verse_number": "१-२२-८३", "content_sanskrit": "गौतमोऽत्रिरगस्त्यश्च सर्वे रुद्रपरायणाः ।\nविश्वामित्रस्तु भगवान् जयध्वजमरिंदमम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005452083, "chapter_id": 25452, "verse_number": "१-२२-८४", "content_sanskrit": "याजयामास भूतादिमादिदेवं जनार्दनम् ।\nतस्य यज्ञे महायोगी साक्षाद् देवः स्वयं हरिः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005452084, "chapter_id": 25452, "verse_number": "१-२२-८५", "content_sanskrit": "आविरासीत् स भगवान् तदद्भुतमिवाभवत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005452085, "chapter_id": 25452, "verse_number": "१-२२-८६", "content_sanskrit": "जयध्वजोऽपि तं विष्णुं रुद्रस्य परमां तनुम् ।\nइत्येवं परमं बुद्ध्वा यत्नेनायजदच्युतम् ।\nय इमं श्रृणुयान्नित्यं जयध्वजपराक्रमम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005452086, "chapter_id": 25452, "verse_number": "१-२२-८७", "content_sanskrit": "सर्वपापविमुक्तात्मा विष्णुलोकं स गच्छति ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}]