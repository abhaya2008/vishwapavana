[{"id": 7002584000, "chapter_id": 22584, "verse_number": "३-९-१", "content_sanskrit": "सूत उवाच ।\nवक्ष्ये प्रवरसंतानं यथाक्रममिति द्विजाः ।\nयद्विना व्यत्ययो यस्मात्तस्माच्छास्त्रानुसारतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002584001, "chapter_id": 22584, "verse_number": "३-९-२", "content_sanskrit": "प्रवरत्रयं काश्यपस्य काश्यपाशावनैर्ध्रुवम् ।\nपञ्चाश्वगौतमस्याद्य गौतमश्चोय एव च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002584002, "chapter_id": 22584, "verse_number": "३-९-३", "content_sanskrit": "च्यवनो जामदग्न्यश्च आप्लवायनमेव च ।\nमोकुन्यांगिरसभास्याज्जामदग्न्याप्लवायनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002584003, "chapter_id": 22584, "verse_number": "३-९-४", "content_sanskrit": "शांडिल्यासितदैवलाः प्रवरत्रयमेव च ।\nपराशरस्य च तथा स्वयं शांबवशिष्ठकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002584004, "chapter_id": 22584, "verse_number": "३-९-५", "content_sanskrit": "आत्रेयमाचार्यणस्याबालप्रवरमेव हि ।\nवात्स्यवास्यायनौ चैव उरुकंटक एव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002584005, "chapter_id": 22584, "verse_number": "३-९-६", "content_sanskrit": "अर्थक्षीरमित्रावरुणं पञ्चमं परिकीर्तितम् ।\nऔतथ्यस्य त्रयं विद्याद्वाल्मीकोऽवरमेव हि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002584006, "chapter_id": 22584, "verse_number": "३-९-७", "content_sanskrit": "औतथ्यस्य च वाशिष्ठमैन्द्रे चक्रं च क्रौञ्चायनं तथा ।\nऔतथ्येति समाख्यातं माहिष्यं च्यवनं तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002584007, "chapter_id": 22584, "verse_number": "३-९-८", "content_sanskrit": "उरुकंटत्रयं विद्यात्कौशिकस्य त्रयं तथा ।\nयद्गालो देवराट् ख्यातः कुशिकाद्याश्च भो द्विजाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002584008, "chapter_id": 22584, "verse_number": "३-९-९", "content_sanskrit": "विश्वामित्रो देवराट्च स्वयं चैव त्रयं मतम् ।\nघृतकौशिकस्य कुशिका विश्वामित्राघमर्षणम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002584009, "chapter_id": 22584, "verse_number": "३-९-१०", "content_sanskrit": "चण्डकौशिकस्य च तथा देवराट् देवरातकम् ।\nविश्वामित्रे तु विख्यातः सुमन्तोरेव एव हि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002584010, "chapter_id": 22584, "verse_number": "३-९-११", "content_sanskrit": "तरुंकशाकटायनः स्वयमेव प्रवरत्रयम् ।\nभ्रमद्वयं जैमिनेश्च स्वयं वाशिष्ठमेव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002584011, "chapter_id": 22584, "verse_number": "३-९-१२", "content_sanskrit": "शंखमांगिरसच्यवनं शंखभस्य त्रयं मतम् ।\nवात्स्यस्य च्यवनो नाम आप्लवायनकस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002584012, "chapter_id": 22584, "verse_number": "३-९-१३", "content_sanskrit": "सावर्णस्य तु सावर्ण्यच्यवनजामदग्निभार्गवम् ।\nआप्लवायनेति पाठीने एक एव तु सत्तमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002584013, "chapter_id": 22584, "verse_number": "३-९-१४", "content_sanskrit": "कृष्णाजिनस्य कृष्णाजिनं विश्वामित्रस्य जैमिनम् ।\nकात्यायनस्य कात्यायनगार्ग्यायणत्रयं तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002584014, "chapter_id": 22584, "verse_number": "३-९-१५", "content_sanskrit": "वात्स्यायनेति विख्यातं कुशिकस्य च पंचमम् ।\nअमुं च विश्वामित्रं च जामदग्न्याप्लवायनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002584015, "chapter_id": 22584, "verse_number": "३-९-१६", "content_sanskrit": "गार्ग्यस्य गार्ग्यसामुंच तथांगिरस एव च ।\nबार्हस्पत्यभरद्वाज इति पंच प्रकीर्तितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002584016, "chapter_id": 22584, "verse_number": "३-९-१७", "content_sanskrit": "वशिष्ठस्य च वासिष्ठं च तथांगिरस एव च ।\nमित्रावरुणसंयुक्तं तावत्तस्य प्रकीर्तितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002584017, "chapter_id": 22584, "verse_number": "३-९-१८", "content_sanskrit": "जाह्वकर्णभवकर्णौ प्रवरौ परिकीर्तितौ ।\nउपमन्युरुपमन्योस्तथेन्द्रः सह एव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002584018, "chapter_id": 22584, "verse_number": "३-९-१९", "content_sanskrit": "तदुत्तमेति त्रितयं मित्रावरुणस्य च त्रयम् ।\nआत्रेयगौतमांगिरसप्रवरत्रयमेव हि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002584019, "chapter_id": 22584, "verse_number": "३-९-२०", "content_sanskrit": "कमंडलोत्पलमित्रामित्रावरुण एव च ।\nकमंडलुश्चेति त्रितयं प्रवरत्रयमेव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002584020, "chapter_id": 22584, "verse_number": "३-९-२१", "content_sanskrit": "च्यवनस्य तथा ज्ञेयमूर्वच्यवनाप्लवायनम् ।\nअथ स कस्यांगिरसबार्हस्पत्य एव त्रयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002584021, "chapter_id": 22584, "verse_number": "३-९-२२", "content_sanskrit": "आगस्त्यस्य अगस्तिश्च माहश्च च्यवनेति च ।\nविश्वामित्रे देवरात औतथ्येति तथैव च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002584022, "chapter_id": 22584, "verse_number": "३-९-२३", "content_sanskrit": "ये नोक्ता ये ऽप्यविज्ञातास्ते प्रोक्ताः काश्यपाज्जगत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]