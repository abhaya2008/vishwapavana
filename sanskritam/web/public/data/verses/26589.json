[{"id": 7006589000, "chapter_id": 26589, "verse_number": "३-१२८-१", "content_sanskrit": "श्रीकृष्णेन हंसस्य वधम् वैशम्पायन उवाच अथ भीतो महारौद्रमस्त्रं दृष्ट्वा नृपोत्तम ।\nहंसो राजा महाराज निश्चेष्ट इव सम्बभौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006589001, "chapter_id": 26589, "verse_number": "३-१२८-२", "content_sanskrit": "उत्प्लुत्य स रथात्तस्माद् यमुनामभ्यधावत ।\nयत्र कृष्णो हृषीकेशः कालियाहिं ममर्द ह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006589002, "chapter_id": 26589, "verse_number": "३-१२८-३", "content_sanskrit": "महाह्रदं महारौद्रं यावत्पातालसंस्थितम् ।\nतावद्दीर्घं महानीलं कालाञ्जननिभं हि यत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006589003, "chapter_id": 26589, "verse_number": "३-१२८-४", "content_sanskrit": "तस्मिन् ह्रदे महाघोरे पपाताथ स हंसकः ।\nहंसे पतति तस्मिंस्तु महान् रावो बभूव ह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006589004, "chapter_id": 26589, "verse_number": "३-१२८-५", "content_sanskrit": "गिरीणां पात्यमानानां समुद्र इव वज्रिणा ।\nरथादुत्प्लुत्य कृष्णोऽपि तस्योपरि पपात ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006589005, "chapter_id": 26589, "verse_number": "३-१२८-६", "content_sanskrit": "देवदेवो जगन्नाथो जगद् विस्मापयन्निव ।\nप्राहरन् तं महाबाहुः पादाभ्यामथ केशवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006589006, "chapter_id": 26589, "verse_number": "३-१२८-७", "content_sanskrit": "पादक्षेपं नृपस्तस्माल्लब्ध्वा हंसो नृपोत्तम ।\nममार च नृपश्रेष्ठ केचिदेवं वदन्ति हि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006589007, "chapter_id": 26589, "verse_number": "३-१२८-८", "content_sanskrit": "अन्ये पातालमायातो भक्षितः पन्नगैरिति ।\nअद्यापि नैव राजेन्द्र दृष्ट इत्यनुशुश्रुम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006589008, "chapter_id": 26589, "verse_number": "३-१२८-९", "content_sanskrit": "यथापूर्वं जगन्नाथो रथं समुपजग्मिवान् ।\nहते तस्मिन् महाराज धर्मपुत्रो युधिष्ठिरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006589009, "chapter_id": 26589, "verse_number": "३-१२८-१०", "content_sanskrit": "अकरोत् राजसूयं च तव पूर्वपितामहः ।\nयदि जीवेदसौ हंसः को नमस्यति तं क्रतुम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006589010, "chapter_id": 26589, "verse_number": "३-१२८-११", "content_sanskrit": "स च सर्वास्त्रविन्नित्यं रुद्राल्लब्धवरः प्रभो ।\nक्षणादेव महाराज वार्तेयं गामगाहत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006589011, "chapter_id": 26589, "verse_number": "३-१२८-१२", "content_sanskrit": "हतो हंसो हतो हंसः कृष्णेन रिपुमर्दिना ।\nजगुर्गन्धर्वपतयो देवलोके दिवानिशम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006589012, "chapter_id": 26589, "verse_number": "३-१२८-१३", "content_sanskrit": "कृष्णेन लोकनाथेन विष्णुना प्रभविष्णुना ।\nयमुनाया ह्रदे घोरे हंसो निहत इत्यपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]