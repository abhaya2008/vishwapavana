[{"id": 2117274, "chapter_id": 3525, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117275, "chapter_id": 3525, "verse_number": "१", "content_sanskrit": "तत आनाय्य तान् सर्वान् मन्त्रिणः सुमहायशाः ।\nधृतराष्ट्रो महाराज मन्त्रयामास वै तदा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117276, "chapter_id": 3525, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117277, "chapter_id": 3525, "verse_number": "२", "content_sanskrit": "न रोचते विक्रमस्तु पाण्डुपुत्रैः कथञ्चन ।\nयथैव धृतराष्ट्रो मे तथा पाण्डुरसंशयम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117278, "chapter_id": 3525, "verse_number": "३", "content_sanskrit": "गान्धार्याश्च यथा पुत्रास्तथा कुन्तीसुता मताः ।\nयथा च मम ते रक्ष्या धृतराष्ट्र तथा तव \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117279, "chapter_id": 3525, "verse_number": "४", "content_sanskrit": "यथा च मम राज्ञश्च तथा दुर्योधनस्य ते ।\nतथा कुरूणां सर्वेषामन्येषामपि पार्थिव \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117280, "chapter_id": 3525, "verse_number": "५", "content_sanskrit": "एवं गते विग्रहं तैर्न रोचे\nसन्धाय वीरैर्दीयतामद्य भूमिः ।\nतेषमपीदं प्रपितामहानां\nराज्यं पितुश्चैव कुरूत्तमानाम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117281, "chapter_id": 3525, "verse_number": "६", "content_sanskrit": "दुर्योधन यथा राज्यं त्वमिदं तात पश्यसि ।\nमम पैतृकमेवेति तथा तेषामपि प्रभो \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117282, "chapter_id": 3525, "verse_number": "७", "content_sanskrit": "यदि राज्यं न ते प्राप्ताः पूर्वमेव तपस्विनः ।\nकुत एतत् तवापीदं भारतस्यापि कस्यचित् \t॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117283, "chapter_id": 3525, "verse_number": "८", "content_sanskrit": "अथ धर्मेण राज्यं त्वं प्राप्तवानसि भारत ।\nतेऽपि राज्यमनुप्राप्ताः पूर्वमेव न संशयः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117284, "chapter_id": 3525, "verse_number": "९", "content_sanskrit": "मधुरेणैवमुक्त्वा तान् राज्यस्यार्धं प्रदीयताम् ।\nएतद्धि पुरषव्याघ्र हितं सर्वजनस्य नः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117285, "chapter_id": 3525, "verse_number": "१०", "content_sanskrit": "अतोऽन्यथा चेत् क्रियते न हितं नो भविष्यति ।\nतवाप्यकीर्तिः सकला भविष्यति न संशयः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117286, "chapter_id": 3525, "verse_number": "११", "content_sanskrit": "कीर्तिरक्षणमातिष्ठेत् कीर्तिर्हि विमलं फलम् ।\nनष्टकीर्तेर्मनुष्यस्य जीवितं विफलं स्मृतम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117287, "chapter_id": 3525, "verse_number": "१३", "content_sanskrit": "यावत् कीर्तिर्मनुष्यस्य लोके तिष्ठति भारत ।\nतावज्जीवति गान्धारे नष्टकीर्तिर्हि नश्यति \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117288, "chapter_id": 3525, "verse_number": "१४", "content_sanskrit": "तदिदं समुपातिष्ठ धर्मं कुरुकुलोचितम् ।\nअनुरूपं महाबाहो पूर्वेषामात्मनः कुरु \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117289, "chapter_id": 3525, "verse_number": "१५", "content_sanskrit": "दिष्ठ्या धरन्ति ते वीरा दिष्ठ्या जीवति सा पृथा ।\nदिष्ट्या पुरोचनः पापो न सकामोऽत्ययं गतः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117290, "chapter_id": 3525, "verse_number": "१६", "content_sanskrit": "तदाप्रभृति गान्धारे न शक्नोम्यभिवीक्षितुम् ।\nअदाहयो यदा पार्थांस्त्वमग्रौ जतुवेश्मनि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117291, "chapter_id": 3525, "verse_number": "१७", "content_sanskrit": "लोके प्राणभृतां किञ्चिच्छ्रुत्वा कुन्तीं तथागताम् ।\nदुःखं तु जायते राजन् भवान् सर्वस्य कारणम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117292, "chapter_id": 3525, "verse_number": "१८", "content_sanskrit": "न चापि दोषेण तथा लोको वेत्ति पुरोचनम् ।\nयथा त्वां पुरुषव्याघ्र लोको दोषेण गच्छति \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117293, "chapter_id": 3525, "verse_number": "१९", "content_sanskrit": "तदिदं जीवितं तेषां तव किल्बिषनाशनम् ।\nसम्मन्तव्यं महाराज पाण्डवानां च दर्शनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117294, "chapter_id": 3525, "verse_number": "२०", "content_sanskrit": "न चापि तेषां वीराणां जयतां कुरुनन्दन ।\nपित्र्योंऽशः शक्य आदातुमपि वज्रभृता स्वयम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117295, "chapter_id": 3525, "verse_number": "२१", "content_sanskrit": "ते हि धर्मे स्थिताः सर्वे सर्वे चैवैकचेतसः ।\nअधर्मेण निरस्ताश्च तुल्ये राज्ये च धर्मतः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117296, "chapter_id": 3525, "verse_number": "२२", "content_sanskrit": "यदि धर्मस्त्वया कार्यो यदि कार्यं प्रियं च मे ।\nक्षेमं च यदि कर्तव्यं राज्यं तेषां प्रयच्छताम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117297, "chapter_id": 3525, "verse_number": "२०४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुरधिकद्विशततमोऽध्यायः ॥२०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117298, "chapter_id": 3525, "verse_number": "५", "content_sanskrit": "॥ इति विदुरागमनपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117299, "chapter_id": 3525, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]