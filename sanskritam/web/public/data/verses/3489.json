[{"id": 2115634, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115635, "chapter_id": 3489, "verse_number": "१", "content_sanskrit": "ते तदा पुरुषव्याघ्रा निहत्य बकराक्षसम् ।\nअत ऊर्ध्वं तदा ब्रह्मन् किमकुर्वत पाण्डवाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115636, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115637, "chapter_id": 3489, "verse_number": "२", "content_sanskrit": "तत्रैव न्यवसन् राजन् निहत्य बकराक्षसम् ।\nअधीयाना नरव्याघ्रा ब्राह्मणस्य निवेशने \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115638, "chapter_id": 3489, "verse_number": "३", "content_sanskrit": "ततः कदाचित् काले तु ब्राह्मणः संशितव्रतः ।\nप्रतिश्रयार्थं तद् वेश्म ब्राह्मणस्यागमत् तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115639, "chapter_id": 3489, "verse_number": "४", "content_sanskrit": "स सम्यक् पूजयित्वा तु विद्वान् विप्रर्षभस्तदा ।\nददौ प्रतिश्रयं तस्मै तदा सर्वातिथिव्रतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115640, "chapter_id": 3489, "verse_number": "५", "content_sanskrit": "ततस्ते पाण्डवाः सर्वे कुन्ती च भरतर्षभ ।\nउपासाञ्चक्रिरे विप्रं कथयन्तः कथाः शुभाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115641, "chapter_id": 3489, "verse_number": "६", "content_sanskrit": "कथयामास देशान् स तीर्थानि विविधानि च ।\nराज्ञश्च विविधाकारान् पुराणि च वनानि च \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115642, "chapter_id": 3489, "verse_number": "७", "content_sanskrit": "स तत्राकथयद् विप्रः कथान्ते जनमेजय ।\nपाञ्चालेष्वद्भुताकारं याज्ञसेन्याः स्वयंवरम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115643, "chapter_id": 3489, "verse_number": "८", "content_sanskrit": "धृष्टद्युम्नस्य चोत्पत्तिं द्रोणस्य च शिखण्डिनः ।\nअयोनिजत्वं कृष्णाया द्रुपदस्य महामखे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115644, "chapter_id": 3489, "verse_number": "९", "content_sanskrit": "तदद्भुततमं श्रुत्वा पाण्डवाः सत्यविक्रमाः ।\nविस्तरेणैव पप्रच्छुः कथां तां पुरुषर्षभाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115645, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "पाण्डवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115646, "chapter_id": 3489, "verse_number": "१०", "content_sanskrit": "कथं द्रुपदपुत्रस्य धृष्टद्युम्नस्य पावकात् ।\nसम्भवो वेदिमध्ये च कथं कृष्णा व्यजायत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115647, "chapter_id": 3489, "verse_number": "११", "content_sanskrit": "कथं द्रोणान्महेष्वासात् सर्वाण्यस्त्राण्यशिक्षयत् ।\nधृष्टद्युम्नो महेष्वासः कथं द्रोणस्य मृत्युता ।\nकथं प्रियसखायौ तौ भिन्नौ कस्य कृतेऽनघ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115648, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115649, "chapter_id": 3489, "verse_number": "१२", "content_sanskrit": "एवं तैश्चोदितो विप्रो राजन् स पुरुषर्षभैः ।\nकथयामास तत्सर्वं द्रौपदीसम्भवं तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115650, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115651, "chapter_id": 3489, "verse_number": "१३", "content_sanskrit": "गङ्गाद्वारं प्रति महान् बभूवर्षिर्महातपाः ।\nभरद्वाजो महाप्राज्ञः सततं संशितव्रतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115652, "chapter_id": 3489, "verse_number": "१४", "content_sanskrit": "सोऽभिषेक्तुं गतो गङ्गां पूर्वमेवागतां सतीम् ।\nददर्शाप्सरसं तत्र घृताचीमाप्लुतामृषिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115653, "chapter_id": 3489, "verse_number": "१५", "content_sanskrit": "तस्या वायुर्नदीतीरे वासो व्यपहरत् तदा ।\nअपकृष्टाम्बरां दृष्ट्वा तामृषिश्चकमे तदा \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115654, "chapter_id": 3489, "verse_number": "१६", "content_sanskrit": "तस्यां संरक्तमनसः कौमारब्रह्मचारिणः ।\nहृष्टस्य रेतश्चस्कन्द तदृषिर्द्रोण आदधे \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115655, "chapter_id": 3489, "verse_number": "१७", "content_sanskrit": "ततः समभवद् द्रोणः कुमारस्तस्य धीमतः ।\nअध्यगीष्ट च वेदांश्च वेदाङ्गानि च सर्वशः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115656, "chapter_id": 3489, "verse_number": "१८", "content_sanskrit": "भरद्वाजसखा ह्यासीत् पृषतो नाम पार्थिवः ।\nतस्यापि द्रुपदो नाम तदा समभवत् सुतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115657, "chapter_id": 3489, "verse_number": "१९", "content_sanskrit": "स नित्यमाश्रमं गत्वा द्रोणेन सह पार्षतः ।\nचिक्रीडाध्ययनं चैव चकार क्षत्रियर्षभः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115658, "chapter_id": 3489, "verse_number": "२०", "content_sanskrit": "ततस्तु पृषतेऽतीते स राजा द्रुपदोऽभवत् ।\nद्रोणोऽपि रामं शुश्राव दित्सन्तं वसु सर्वशः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115659, "chapter_id": 3489, "verse_number": "२१", "content_sanskrit": "वनं तु प्रस्थितं रामं भरद्वाजसुतोऽब्रवीत् ।\nआगतं वित्तकामं मां विद्धि द्रोणं द्विजर्षभम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115660, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115661, "chapter_id": 3489, "verse_number": "२२", "content_sanskrit": "शरीरमात्रमेवाद्य ममेदमवशेषितम् ।\nअस्त्राणि वा शरीरं वा ब्रह्मन्नन्यतरं वृणु \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115662, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115663, "chapter_id": 3489, "verse_number": "२३", "content_sanskrit": "अस्त्राणि चैव सर्वाणि तेषां संहारमेव च ।\nप्रयोगं चैव सर्वेषां दातुमर्हति मे भवान् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115664, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115665, "chapter_id": 3489, "verse_number": "२४", "content_sanskrit": "तथेत्युक्त्वा ततस्तस्मै प्रददौ भृगुनन्दनः ।\nप्रतिगृह्य तदा द्रोणः कृतकृत्योऽभवत् तदा \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115666, "chapter_id": 3489, "verse_number": "२५", "content_sanskrit": "स प्रहृष्टमनाश्चापि रामात् सद्यो न्यवर्तत ।\nब्रह्मास्त्रं समनुप्राप्य नरेष्वभ्यधिकोऽभवत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115667, "chapter_id": 3489, "verse_number": "२६", "content_sanskrit": "ततो द्रुपदमासाद्य भारद्वाजः प्रतापवान् ।\nअब्रवीत् पुरुषव्याघ्र सखायं विद्धि मामिति \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115668, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2115669, "chapter_id": 3489, "verse_number": "२७", "content_sanskrit": "नाश्रोत्रियः श्रोत्रियस्य नारथी रथिनः सखा ।\nनाराजा पार्थिवस्यापि सखिपूर्वं किमिष्यते \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2115670, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2115671, "chapter_id": 3489, "verse_number": "२८", "content_sanskrit": "स विनिश्चित्य मनसा पाञ्चाल्यं प्रति बुद्धिमान् ।\nजगाम कुरुमुख्यानां नगरं नागसाह्वयम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2115672, "chapter_id": 3489, "verse_number": "२९", "content_sanskrit": "तस्मै पार्थान् समादाय वसूनि विविधानि च ।\nप्राप्ताय प्रददौ भीष्मः शिष्यान् द्रोणाय धीमते \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2115673, "chapter_id": 3489, "verse_number": "३०", "content_sanskrit": "द्रोणः शिष्यांस्ततः सर्वानिदं वचनमब्रवीत् ।\nसमानीय ततः शिष्यान् द्रुपदस्यासुखाय वै \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2115674, "chapter_id": 3489, "verse_number": "३१", "content_sanskrit": "गुरुशुश्रूषणं चैव तथैव गुरुदक्षिणा ।\nकृतास्त्रैस्तत् प्रदेया स्यात् तद् ऋतं वदतानघाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2115675, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2115676, "chapter_id": 3489, "verse_number": "३२", "content_sanskrit": "तथेत्युवाच तं पार्थः पादौ जग्राह बुद्धिमान् ।\nयदा च पाण्डवाश्चान्ये कृतास्त्राः सर्वतोऽभवन् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2115677, "chapter_id": 3489, "verse_number": "३३", "content_sanskrit": "ततो द्रोणोऽब्रवीद् भूयो दातव्या गुरुदक्षिणा ।\nपार्षतो द्रुपदो नाम वेत्रवत्यां नरेश्वरः ।\nतस्मादाकृष्य तद्राज्यं मम शीघ्रं प्रदीयताम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2115678, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2115679, "chapter_id": 3489, "verse_number": "३४", "content_sanskrit": "धार्तराष्ट्रैश्च सहिताः पाञ्चालान् पाण्डवा ययुः ।\nयज्ञसेनेन सङ्गम्य कर्णदुर्योधनादयः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2115680, "chapter_id": 3489, "verse_number": "३५", "content_sanskrit": "निर्जिताः सन्न्यवर्तन्त तथाऽन्ये क्षत्रियर्षभाः ।\nततः पाण्डुसुताः पञ्च निर्जित्य द्रुपदं युधि \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2115681, "chapter_id": 3489, "verse_number": "३६", "content_sanskrit": "द्रोणाय दर्शयामासुर्बद्ध्वा ससचिवं तदा ।\nमहेन्द्रमिव दुर्धर्षं महेन्द्र इव दानवम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2115682, "chapter_id": 3489, "verse_number": "३७", "content_sanskrit": "महेन्द्रपुत्रः पाञ्चालं जितवानर्जुनस्तदा ।\nतद् दृष्ट्वा तु महावीर्यं फल्गुनस्यामितौजसः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2115683, "chapter_id": 3489, "verse_number": "३९", "content_sanskrit": "व्यस्मयन्त जनाः सर्वे यज्ञसेनस्य बान्धवाः ।\nनास्त्यर्जुनसमो वीर्ये राजपुत्र इति ब्रुवन् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2115684, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2115685, "chapter_id": 3489, "verse_number": "४०", "content_sanskrit": "प्रार्थयामि त्वया सख्यं पुनरेव नराधिप ।\nनाराजा किल वै राज्ञः सखा भवितुमर्हति \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2115686, "chapter_id": 3489, "verse_number": "४१", "content_sanskrit": "अतः प्रयतितं राज्ये यज्ञसेन मया नृप ।\nराजाऽसि दक्षिणे तीरे भागीरथ्याहमुत्तरे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2115687, "chapter_id": 3489, "verse_number": "४२", "content_sanskrit": "कन्याकुब्जे च काम्पिल्ये वसेथास्त्वं नरोत्तम ।\nब्राह्मणैः सहितो राजन्नहिच्छत्रे वसाम्यहम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2115688, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2115689, "chapter_id": 3489, "verse_number": "४३", "content_sanskrit": "असत्कारः स सुमहान् मुहूर्तमपि तस्य तु ।\nनापैति हृदयाद् राज्ञो दुर्मनाः स कृशोऽभवत् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2115690, "chapter_id": 3489, "verse_number": "४४", "content_sanskrit": "अमर्षी द्रुपदो राजा कर्मसिद्धान् द्विजोत्तमान् ।\nअन्विच्छन् परिचक्राम ब्राह्मणावसथान् बहून् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2115691, "chapter_id": 3489, "verse_number": "४५", "content_sanskrit": "द्रोणेन वैरं द्रुपदो न सुष्वाप स्मरंस्तदा ।\nपुत्रजन्म परीप्सन् सः शोकोपहतचेतनः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2115692, "chapter_id": 3489, "verse_number": "४६", "content_sanskrit": "पुत्रजन्म परीप्सन् वै शोकोपहतचेतनः ।\nनास्ति श्रेष्ठं ममापत्यमिति निश्चित्य चिन्तयन् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2115693, "chapter_id": 3489, "verse_number": "४७", "content_sanskrit": "जातान् पुत्रान् स निर्वेदाद् धिग् बन्धूनिति चाब्रवीत् ।\nनिर्वेदः परमश्चासीद् द्रोणाप्रियचिकीर्षया \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2115694, "chapter_id": 3489, "verse_number": "४८", "content_sanskrit": "प्रभावं विनयं शिष्यान् द्रोणस्य चरितानि च ।\nक्षात्रेण च बलेनास्य पराजेतुं हि नाशकत् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2115695, "chapter_id": 3489, "verse_number": "४९", "content_sanskrit": "अप्राप्तवान् नरश्रेष्ठो यतमानोऽपि भारत ।\nअभितः सोऽथ कल्माषीं गङ्गाकूले परिभ्रमन् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2115696, "chapter_id": 3489, "verse_number": "५०", "content_sanskrit": "ब्राह्मणावसथं पुण्यमाससाद महीपतिः ।\nतत्र नास्नातकः कश्चिन्न चासीदव्रती द्विजः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2115697, "chapter_id": 3489, "verse_number": "५१", "content_sanskrit": "अधीयानौ महाभागौ सोऽपश्यत् संशितव्रतौ ।\nयाजोपयाजौ ब्रह्मर्षी शाम्यन्तौ पृषतात्मजः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2115698, "chapter_id": 3489, "verse_number": "५२", "content_sanskrit": "संहिताध्ययने युक्तौ गोत्रतश्चापि काश्यपौ ।\nतरुणौ तौ युक्तरूपौ ब्राह्मणावृषिसत्तमौ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2115699, "chapter_id": 3489, "verse_number": "५३", "content_sanskrit": "स उपामन्त्रयामास सर्वकामैरतन्द्रितः ।\nस बुद्ध्वा बलबुद्धिं तु कनीयांसमुपह्वरे \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2115700, "chapter_id": 3489, "verse_number": "५४", "content_sanskrit": "प्रपेदे च्छन्दयन् कामैरुपयाजं धृतव्रजम् ।\nपादशुश्रूषणे युक्तः प्रियवाक् सर्वकामदः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2115701, "chapter_id": 3489, "verse_number": "५५", "content_sanskrit": "अर्चयित्वा यथान्यायमुपयाजमुवाच ह ।\nयेन मे कर्मणा ब्रह्मन् पुत्रः स्याद् द्रोणमृत्यवे \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2115702, "chapter_id": 3489, "verse_number": "५६", "content_sanskrit": "अर्जुनस्य तथा भार्या भवेद् या वरवर्णिनी ।\nउपयाज कृते तस्मिन् गवां दास्यामि तेऽर्बुदम् \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2115703, "chapter_id": 3489, "verse_number": "५७", "content_sanskrit": "यदन्यत् ते द्विजश्रेष्ठ मनसः सुप्रियं भवेत् ।\nसर्वं तत् ते प्रदास्यामि न हि मेऽस्त्यत्र संशयः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2115704, "chapter_id": 3489, "verse_number": "५८", "content_sanskrit": "इत्युक्तो नाहमित्येवं तमृषिः प्रत्युवाच ह ।\nआराधयिष्यन् द्रुपदः स तं पर्यचरत् पुनः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2115705, "chapter_id": 3489, "verse_number": "५९", "content_sanskrit": "ततः संवत्सरस्यान्ते द्रुपदं स द्विजोत्तमः ।\nउपयाजोऽब्रवीद् राजन् काले मधुरया गिरा ।\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2115706, "chapter_id": 3489, "verse_number": "६०", "content_sanskrit": "ज्येष्ठो भ्राता ममागृह्णाद् विचरन् वननिर्झरे ।\nअपरिज्ञातशौचायां भूमौ निपतितं फलम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2115707, "chapter_id": 3489, "verse_number": "६१", "content_sanskrit": "तदपश्यमहं भ्रातुरसाम्प्रतमनुव्रजन् ।\nविमर्शं सङ्करादाने नायं कुर्यात् कथञ्चन ।\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2115708, "chapter_id": 3489, "verse_number": "६२", "content_sanskrit": "दृष्ट्वा फलस्यापगमं दोषांस्तस्यानुबन्धिकान् ।\nविविनक्ति नचाशौचं यः सोऽन्यत्रापि कथञ्चन \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2115709, "chapter_id": 3489, "verse_number": "६३", "content_sanskrit": "संहिताध्ययनं कुर्वन् वसन् गुरुकुले च यः ।\nभैक्षमुच्छिष्ठमन्येषां भुञ्जति स्म सदा सदा \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2115710, "chapter_id": 3489, "verse_number": "६४", "content_sanskrit": "तमहं फलार्थिनं मन्ये भ्रातरं तर्कचक्षुषा ।\nतं वै गच्छस्व नृपते स त्वां संयाजयिष्यति ।\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2115711, "chapter_id": 3489, "verse_number": "६५", "content_sanskrit": "जुगुप्समानो नृपतिर्मनसाऽनुविचिन्तयन् ।\nउपयाजवचः श्रुत्वा नृपतिः सर्वधर्मवित् ।\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2115712, "chapter_id": 3489, "verse_number": "६६", "content_sanskrit": "अभिसम्पूज्य पूजार्हमृषिं याजमुवाच सः ।\nअयुतानि ददान्यष्टौ गवां याजय मां विभो \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2115713, "chapter_id": 3489, "verse_number": "६७", "content_sanskrit": "द्रोणवैराभिसन्तप्तं मां संह्लादयितुमर्हसि ।\nस हि ब्रह्मविदां श्रेष्ठो ब्रह्मास्त्रे चाप्यनुत्तमः ।\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2115714, "chapter_id": 3489, "verse_number": "६८", "content_sanskrit": "तस्माद् द्रोणः पराजैषीन्मां वै स सखिविग्रहे ।\nक्षत्रियो नास्ति तुल्योऽस्य पृथिव्यां कश्चिदग्रणीः \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2115715, "chapter_id": 3489, "verse_number": "६९", "content_sanskrit": "कौरवाचार्यमुख्यस्य भारद्वाजस्य धीमतः ।\nद्रोणस्य शरजालानि प्राणिदेहहराणि च \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2115716, "chapter_id": 3489, "verse_number": "७०", "content_sanskrit": "षडरत्नि धनुश्चास्य ताळमात्रमनुत्तमम् ।\nस हि ब्राह्मणवेगेन क्षात्रं वेगमसंशयम् \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2115717, "chapter_id": 3489, "verse_number": "७१", "content_sanskrit": "प्रतिहन्ति महेष्वासो भारद्वाजो महामनाः ।\nक्षत्रोच्छेदाय विहितो जामदग्न्य इवोत्थितः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2115718, "chapter_id": 3489, "verse_number": "७२", "content_sanskrit": "तस्य ह्यस्त्रबलं घोरमप्रसह्यं नरैर्भुवि ।\nब्राह्ममुच्चावचं तेजो हुताहुतिरिवानलः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2115719, "chapter_id": 3489, "verse_number": "७३", "content_sanskrit": "ब्रह्मक्षत्रे च विहिते ब्रह्मतेजो विशिष्यते ।\nसोऽहं क्षात्राद् बलाद्धीनो ब्रह्मतेजः प्रपेदिवान् \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2115720, "chapter_id": 3489, "verse_number": "७४", "content_sanskrit": "द्रोणाद् विशिष्टमासाद्य भवन्तं ब्रह्मवित्तमम् ।\nद्रोणान्तकमहं पुत्रं लभेयं युधि दुर्जयम् \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2115721, "chapter_id": 3489, "verse_number": "७५", "content_sanskrit": "पाण्डोः स्नुषार्थं कन्या च भवेदिति मतिर्मम ।\nतत्कर्म कुरु मे याज प्रददाम्यर्बुदं गवाम् \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2115722, "chapter_id": 3489, "verse_number": "७६", "content_sanskrit": "याजो द्रोणविनाशाय प्रतिजज्ञे तथैव सः ।\nतथेत्युक्त्वा तु तं यज्ञं पुत्रकामीयमारभत् \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2115723, "chapter_id": 3489, "verse_number": "७७", "content_sanskrit": "गुर्वर्थ इति चाकाम उपयाजोऽप्ययोजयत् ।\nयाजस्तु यजतां श्रेष्ठो हव्यवाहमतर्पयत् \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2115724, "chapter_id": 3489, "verse_number": "७८", "content_sanskrit": "ततस्तस्य नरेन्द्रस्य उपयाजो महायशाः ।\nआचख्यौ कर्म वैतानं तथा पुत्रफलस्य वै \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2115725, "chapter_id": 3489, "verse_number": "७९", "content_sanskrit": "स च पुत्रो महावीर्यो महातेजा महाबलः ।\nइष्यते यद्विधो राजन् भविता वै तथाविधः \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2115726, "chapter_id": 3489, "verse_number": "८०", "content_sanskrit": "यथोक्तं कल्पयामास राजा विप्रेण तं क्रतुम् ।\nभारद्वाजस्य हन्तारं सोऽभिसन्धाय भूमिपः \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2115727, "chapter_id": 3489, "verse_number": "८१", "content_sanskrit": "आजह्रे तत् तथा सर्वं द्रुपदः कर्मसिद्धये ।\nयाजस्तु सवनस्यान्ते देवीमाह्वापयत् तदा \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2115728, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "याजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2115729, "chapter_id": 3489, "verse_number": "८२", "content_sanskrit": "प्रेहि मां राज्ञि पृषति मिथुनं त्वामुपस्थितम् ।\nकुमारश्च कुमारी च पतिवंशविवृद्धये \t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2115730, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "देवी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2115731, "chapter_id": 3489, "verse_number": "८३", "content_sanskrit": "नालिप्तं वै मम मुखं पुण्यान् गन्धान् बिभर्मि च ।\nन पत्नी तेऽस्मि सूत्यर्थं तिष्ठ याज मम प्रिये \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2115732, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "याजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2115733, "chapter_id": 3489, "verse_number": "८४", "content_sanskrit": "याजेन श्रपितं हविरुपयाजेन मन्त्रितम् ।\nकथं कामं न सन्दध्यात् पृषति प्रेहि तिष्ठ वा \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2115734, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2115735, "chapter_id": 3489, "verse_number": "८५", "content_sanskrit": "एवमुक्त्वा तु याजेन हुते हविषि संस्कृते ।\nउत्तस्थौ पावकात् तस्मात् कुमारो देवसन्निभः \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2115736, "chapter_id": 3489, "verse_number": "८६", "content_sanskrit": "ज्वालावर्णो घोररूपः किरीटी वर्म चोत्तमम् ।\nबिभ्रत् सखड्गः सशरो धनुषा विनदन् मुहुः \t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2115737, "chapter_id": 3489, "verse_number": "८७", "content_sanskrit": "अध्यारोहद् दृढरथं तेन स प्रययौ तदा ।\nततः प्रणेदुः पाञ्चालाः प्रहृष्टाः साधुसाध्विति \t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2115738, "chapter_id": 3489, "verse_number": "८९", "content_sanskrit": "भयापहो राजपुत्रः पाञ्चालानां यशस्करः ।\nराज्ञः शोकापहो जात एष द्रोणवधाय वै \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2115739, "chapter_id": 3489, "verse_number": "९०", "content_sanskrit": "इत्युवाच महद्भूतमदृश्यं खेचरं तदा ।\nकुमारी चापि पाञ्चाली अर्जुनार्थे विनिर्मिता \t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2115740, "chapter_id": 3489, "verse_number": "९१", "content_sanskrit": "सुभगा दर्शनीयाङ्गी वेदिमध्यात् समुत्थिता ।\nमानुषं विग्रहं कृत्वा श्रीः साक्षाद् देववर्णिनी \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2115741, "chapter_id": 3489, "verse_number": "९२", "content_sanskrit": "नीलोत्पलसमो गन्धो यस्याः क्रोशात् प्रवायति ।\nया बिभर्ति परं रूपं यस्या नास्ति समा भुवि \t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2115742, "chapter_id": 3489, "verse_number": "९३", "content_sanskrit": "सदृशी पाण्डुपुत्रस्य अर्जुनस्यातिभद्रिका ।\nऊचुः प्रहृष्टमनसो राजभक्तिपुरस्कृताः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2115743, "chapter_id": 3489, "verse_number": "९४", "content_sanskrit": "तां चापि जातां सुश्रोणीं वागुवाचाशरीरिणी ।\nसर्वयोषिद्वरा कृष्णा क्षयं क्षत्रं निनीषति \t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2115744, "chapter_id": 3489, "verse_number": "९५", "content_sanskrit": "सुरकार्यमिदं लोके करिष्यति सुमध्यमा ।\nअस्याः हेतोः क्षत्रियाणां महदुत्पत्स्यते भयम् \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2115745, "chapter_id": 3489, "verse_number": "९७", "content_sanskrit": "तच्छ्रुत्वा सर्वपाञ्चालाः प्रणेदुः सिंहसङ्घवत् ।\nतच्छ्रुत्वा द्रुपदो राजा हर्षादश्रूण्यवर्तयत् \t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2115746, "chapter_id": 3489, "verse_number": "९८", "content_sanskrit": "परिष्वज्य सुतां कृष्णां स्नुषा पाण्डोरिति ब्रुवन् ।\nअङ्कमारोप्य पाञ्चालीं राजा हर्षमवाप सः \t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2115747, "chapter_id": 3489, "verse_number": "९९", "content_sanskrit": "तयोस्तु नामनी चक्रुर्द्विजाः सम्पूर्णमानसाः ।\nधृष्टत्वादप्रधृष्यत्वाद् द्युम्नाद्युत्सम्भवादपि \t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2115748, "chapter_id": 3489, "verse_number": "१००", "content_sanskrit": "धृष्टद्युम्नः कुमारोऽयं द्रुपदस्य भवत्विति ।\nकृष्णेत्येवाब्रुवन् कृष्णां कृष्णाऽभूत् सा हि वर्णतः \t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2115749, "chapter_id": 3489, "verse_number": "१०१", "content_sanskrit": "तथा तन्मिथुनं जज्ञे द्रुपदस्य महामखे ।\nधृष्टद्युम्नस्तु पाञ्चालः सिंहनादेन नादयन् \t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2115750, "chapter_id": 3489, "verse_number": "१०२", "content_sanskrit": "सोऽध्यारोहद् रथवरं तेन सम्प्रययौ गृहम् ।\nकृष्णा च शिबिकां प्राप्य प्रविवेश निवेशनम् \t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2115751, "chapter_id": 3489, "verse_number": "१०३", "content_sanskrit": "द्रोणं सम्पूज्य विधिवद् गुरुरित्येव धर्मतः ।\nपरिदाय सुतं शिष्यं धृष्टद्युम्नं तु सोमकः \t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2115752, "chapter_id": 3489, "verse_number": "१०४", "content_sanskrit": "अस्यास्त्राणि प्रसीदेति प्रब्रवीत् प्रियवादनः ।\nमहाप्रभावो ब्रह्मर्षिर्ज्ञात्वा तस्य तु सम्भवम् \t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2115753, "chapter_id": 3489, "verse_number": "१०५", "content_sanskrit": "उपाकरोदस्त्रहेतोर्भारद्वाजः प्रतापवान् ।\nअमोक्षणीयं दैवं हि भावि मत्वा महामतिः ।\nतथा तत्कृतवान् द्रोण आत्मकीर्त्यर्थकारणात् \t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2115754, "chapter_id": 3489, "verse_number": "१६८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टषष्ठ्यधिकशततमोऽध्यायः ॥१६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2115755, "chapter_id": 3489, "verse_number": "१", "content_sanskrit": "॥ इति चैत्ररथपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2115756, "chapter_id": 3489, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]