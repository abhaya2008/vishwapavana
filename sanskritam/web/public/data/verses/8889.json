[{"id": 40003459, "chapter_id": 8889, "verse_number": "1", "content_sanskrit": "सान्त्व्यमाना तु रामेण मैथिली जनकात्मजा। वनवासनिमित्ताय भर्तारमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40003460, "chapter_id": 8889, "verse_number": "2", "content_sanskrit": "सा तमुत्तमसंविग्ना सीता विपुलवक्षसम्। प्रणयाच्चाभिमानाच्च परिचिक्षेप राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40003461, "chapter_id": 8889, "verse_number": "3", "content_sanskrit": "किं त्वाऽमन्यत वैदेहः पिता मे मिथिलाधिपः। राम जामातरं प्राप्य स्त्रियं पुरुषविग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40003462, "chapter_id": 8889, "verse_number": "4", "content_sanskrit": "अनृतं बत लोकोऽयमज्ञानाद्यदि वक्ष्यति। तेजो नास्ति परं रामे तपतीव दिवाकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40003463, "chapter_id": 8889, "verse_number": "5", "content_sanskrit": "किं हि कृत्वा विषण्णस्त्वं कुतो वा भयमस्ति ते। यत्परित्यक्तुकामस्त्वं मामनन्यपरायणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40003464, "chapter_id": 8889, "verse_number": "6", "content_sanskrit": "द्युमत्सेनसुतं वीर सत्यवन्तमनुव्रताम्। सावित्रीमिव मां विद्धि त्वमात्मवशवर्तिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40003465, "chapter_id": 8889, "verse_number": "7", "content_sanskrit": "न त्वहं मनसाऽप्यन्यं द्रष्टाऽस्मि त्वदृतेऽनघ। त्वया राघव गच्छेयं यथाऽन्या कुलपांसिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40003466, "chapter_id": 8889, "verse_number": "8", "content_sanskrit": "स्वयं तु भार्यां कौमारीं चिरमध्युषितां सतीम्। शैलूष इव मां राम परेभ्यो दातुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40003467, "chapter_id": 8889, "verse_number": "9", "content_sanskrit": "यस्य पथ्यं च रामाऽत्थ यस्य चार्थेऽवरुध्यसे। त्वं तस्य भव वश्यश्च विधेयश्च सदाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40003468, "chapter_id": 8889, "verse_number": "10", "content_sanskrit": "स मामनादाय वनं न त्वं प्रस्थातुमर्हसि। तपो वा यदि वाऽरण्यं स्वर्गो वा स्यात्सह मे त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40003469, "chapter_id": 8889, "verse_number": "11", "content_sanskrit": "न च मे भविता तत्र कश्चित्पथि परिश्रमः। पृष्ठतस्तव गच्छन्त्या विहारशयनेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40003470, "chapter_id": 8889, "verse_number": "12", "content_sanskrit": "कुशकाशशरेषीका ये च कण्टकिनो द्रुमाः। तूलाजिनसमस्पर्शा मार्गे मम सह त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40003471, "chapter_id": 8889, "verse_number": "13", "content_sanskrit": "महावातसमुद्धूतं यन्मामपकरिष्यति। रजो रमण तन्मन्ये परार्थ्यमिव चन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40003472, "chapter_id": 8889, "verse_number": "14", "content_sanskrit": "शाद्वलेषु यथा शिश्ये वनान्ते वनगोचर। कुथास्तरणतल्पेषु किं स्यात्सुखतरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40003473, "chapter_id": 8889, "verse_number": "15", "content_sanskrit": "पत्रं मूलं फलं यत्त्वमल्पं वा यदि वा बहु। दास्यसि स्वयमाहृत्य तन्मेऽमृतरसोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40003474, "chapter_id": 8889, "verse_number": "16", "content_sanskrit": "न मातुर्न पितुस्तत्र स्मरिष्यामि न वेश्मनः। आर्तवान्युपभुञ्जाना पुष्पाणि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40003475, "chapter_id": 8889, "verse_number": "17", "content_sanskrit": "न च तत्र ततः किञ्चिद्द्रष्टुमर्हसि विप्रियम्। मत्कृते न च ते शोको न भविष्यामि दुर्भरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40003476, "chapter_id": 8889, "verse_number": "18", "content_sanskrit": "य स्त्वया सह स स्वर्गो निरयो यस्त्वया विना। इति जानन्परां प्रीतिं गच्छ राम मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40003477, "chapter_id": 8889, "verse_number": "19", "content_sanskrit": "अथ मामेवमव्यग्रां वनं नैव नयिष्यति। विषमद्यैव पास्यामि मा विशं द्विषतां गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40003478, "chapter_id": 8889, "verse_number": "20", "content_sanskrit": "पश्चादपि हि दुःखेन मम नैवास्ति जीवितम्। उज्झितायास्त्वया नाथ तदैव मरणं वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40003479, "chapter_id": 8889, "verse_number": "21", "content_sanskrit": "इमं हि सहितुं शोकं मुहूर्तमपि नोत्सहे। किं पुनर्दशवर्षाणि त्रीणि चैकं च दुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40003480, "chapter_id": 8889, "verse_number": "22", "content_sanskrit": "इति सा शोकसन्तप्ता विलप्य करुणं बहु। चुक्रोश पतिमायस्ता भृशमालिङ्ग्य सस्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40003481, "chapter_id": 8889, "verse_number": "23", "content_sanskrit": "सा विद्धा बहुभिर्वाक्यैर्दिग्धैरिव गजाङ्गना। चिरसन्नियतं बाष्पं मुमोचाग्निमिवारणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40003482, "chapter_id": 8889, "verse_number": "24", "content_sanskrit": "तस्या स्फटिकसङ्काशं वारि सन्तापसम्भवम्। नेत्राभ्यां परिसुस्राव पङ्कजाभ्यामिवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40003483, "chapter_id": 8889, "verse_number": "25", "content_sanskrit": "तच्चैवामलचन्द्राभं मुखमायतलोचनम्। पर्यशुष्यत बाष्पेण जलोद्धृतमिवाम्बुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40003484, "chapter_id": 8889, "verse_number": "26", "content_sanskrit": "तां परिष्वज्य बाहुभ्यां विसंज्ञामिव दुःखिताम्। उवाच वचनं रामः परिविश्वासयंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40003485, "chapter_id": 8889, "verse_number": "27", "content_sanskrit": "न देवि तव दुःखेन स्वर्गमप्यभिरोचये। न हि मेऽस्ति भयं किञ्चित्स्वयम्भोरिव सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40003486, "chapter_id": 8889, "verse_number": "28", "content_sanskrit": "तव सर्वमभिप्रायमविज्ञाय शुभानने। वासं न रोचयेऽरण्ये शक्तिमानपि रक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40003487, "chapter_id": 8889, "verse_number": "29", "content_sanskrit": "यत्सृष्टाऽसि मया सार्धं वनवासाय मैथिलि। न विहातुं मया शक्या कीर्तिरात्मवता यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40003488, "chapter_id": 8889, "verse_number": "30", "content_sanskrit": "धर्मस्तु गजनासोरु सद्भिराचरितः पुरा। तं चाहमनुवर्तेऽद्य यथा सूर्यं सुवर्चला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40003489, "chapter_id": 8889, "verse_number": "31", "content_sanskrit": "न खल्वहं न गच्छेयं वनं जनकनन्दिनि। वचनं तन्नयति मां पितु स्सत्योपबृंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40003490, "chapter_id": 8889, "verse_number": "32", "content_sanskrit": "एष धर्मस्तु सुश्रोणि पितुर्मातुश्च वश्यता। अतश्च तं व्यतिक्रम्य नाहं जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40003491, "chapter_id": 8889, "verse_number": "33", "content_sanskrit": "अस्वाधीनं कथं दैवं प्रकारैरभिराध्यते। स्वाधीनं समतिक्रम्य मातरं पितरं गुरुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40003492, "chapter_id": 8889, "verse_number": "34", "content_sanskrit": "यत्त्रयं तत्त्रयो लोकाः पवित्रं तत्समं भुवि। नान्यदस्ति शुभापाङ्गे तेनेदमभिराध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40003493, "chapter_id": 8889, "verse_number": "35", "content_sanskrit": "न सत्यं दानमानौ वा न यज्ञाश्चाप्तदक्षिणाः। तथा बलकरा स्सीते यथा सेवा पितुर्हिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40003494, "chapter_id": 8889, "verse_number": "36", "content_sanskrit": "स्वर्गो धनं वा धान्यं वा विद्याः पुत्रास्सुखानि च। गुरुवृत्त्यनुरोधेन न किञ्चिदपि दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40003495, "chapter_id": 8889, "verse_number": "37", "content_sanskrit": "देवगन्धर्वगोलोकान्ब्रह्मलोकां स्तथाऽपरान्। प्राप्नुवन्ति महात्मानो मातापितृपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40003496, "chapter_id": 8889, "verse_number": "38", "content_sanskrit": "स मां पिता यथा शास्ति सत्यधर्मपथे स्थितः। तथा वर्तितुमिच्छामि स हि धर्मस्सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40003497, "chapter_id": 8889, "verse_number": "39", "content_sanskrit": "मम सन्ना मतिस्सीते त्वां नेतुं दण्डकावनम्। वसिष्यामीति सा त्वं मामनुयातुं सुनिश्चिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40003498, "chapter_id": 8889, "verse_number": "40", "content_sanskrit": "सा हि सृष्टाऽनवद्याङ्गि वनाय मदिरेक्षणे। अनुगच्छस्व मां भीरु सहधर्मचरी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40003499, "chapter_id": 8889, "verse_number": "41", "content_sanskrit": "सर्वथा सदृशं सीते मम स्वस्य कुलस्य च। व्यवसायमनुक्रान्ता कान्ते त्वमतिशोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40003500, "chapter_id": 8889, "verse_number": "42", "content_sanskrit": "आरभस्व शुभश्रोणि वनवासक्षमाः क्रियाः। नेदानीं त्वदृते सीते स्वर्गोऽपि मम रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40003501, "chapter_id": 8889, "verse_number": "43", "content_sanskrit": "ब्राह्मणेभ्यश्च रत्नानि भिक्षुकेभ्यश्च भोजनम्। देहि चाशंसमानेभ्य स्सन्त्वरस्व च मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40003502, "chapter_id": 8889, "verse_number": "44", "content_sanskrit": "भूषणानि महार्हाणि वरवस्त्राणि यानि च। रमणीयाश्च ये केचित्क्रीडार्थाश्चाप्युपस्कराः ॥ शयनीयानि यानानि मम चान्यानि यानि च। देहि स्वभृत्यवर्गस्य ब्राह्मणानामनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40003503, "chapter_id": 8889, "verse_number": "45", "content_sanskrit": "भूषणानि महार्हाणि वरवस्त्राणि यानि च। रमणीयाश्च ये केचित्क्रीडार्थाश्चाप्युपस्कराः ॥ शयनीयानि यानानि मम चान्यानि यानि च। देहि स्वभृत्यवर्गस्य ब्राह्मणानामनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40003504, "chapter_id": 8889, "verse_number": "46", "content_sanskrit": "अनुकूलं तु सा भर्तुर्ज्ञात्वा गमनमात्मनः। क्षिप्रं प्रमुदिता देवी दातुमेवोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]