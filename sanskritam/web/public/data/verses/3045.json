[{"id": 2095833, "chapter_id": 3045, "verse_number": "१३-१७५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nअहिंसा वैदिकं कर्म ध्यानमिन्द्रियसंयमः।\nतपोऽथ गुरुशुश्रूषा किं श्रेयः पुरुषं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095834, "chapter_id": 3045, "verse_number": "१३-१७५-२x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095835, "chapter_id": 3045, "verse_number": "१३-१७५-२", "content_sanskrit": "सर्वाण्येतानि धर्मस्य पृथग्द्वाराणि नित्यशः।\nशृणु संकीर्त्यमानानि षडेव भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095836, "chapter_id": 3045, "verse_number": "१३-१७५-३", "content_sanskrit": "हन्त निःश्रेयसं जन्तोरहं वक्ष्याम्यनुत्तमम्।\nअहिंसापाश्रयं धर्मं दान्तो विद्वान्समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095837, "chapter_id": 3045, "verse_number": "१३-१७५-४", "content_sanskrit": "त्रिदण्डं सर्वभूतेषु निधाय पुरुषः शुचिः।\nकामक्रोधौ च संयम्य ततः सिद्धिमवाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095838, "chapter_id": 3045, "verse_number": "१३-१७५-५", "content_sanskrit": "अहिंसकानि भूतानि दण्डेन विनिहन्ति यः।\nआत्मनः सुखमन्विच्छन्स प्रेत्य न सुखी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095839, "chapter_id": 3045, "verse_number": "१३-१७५-६", "content_sanskrit": "आत्मोपमस्तु भूतेषु यो वै भवति पूरुषः।\nत्यक्तदण्डो जितक्रोधः स प्रेत्य सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095840, "chapter_id": 3045, "verse_number": "१३-१७५-७", "content_sanskrit": "सर्वभूतात्मभूतस्य सर्वभूतानि पश्यतः।\nदेवाऽपि मार्गे मुह्यन्ति ह्यपदस्य पदेषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095841, "chapter_id": 3045, "verse_number": "१३-१७५-८", "content_sanskrit": "न तत्परस्य संदध्यात्प्रतिकूलं यदात्मनः।\nएष साङ्ग्राहिको धर्मः कामादन्यः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095842, "chapter_id": 3045, "verse_number": "१३-१७५-९", "content_sanskrit": "प्रख्यापने च दाने च सुखदुःखे प्रियाप्रिये।\nआत्मौपम्येन पुरुषः प्रमाणमधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095843, "chapter_id": 3045, "verse_number": "१३-१७५-१०", "content_sanskrit": "यथा परः प्रक्रमते परेषु\nतथा परे प्रक्रमन्ते परस्मिन्।\nनिषेवते स्वसमां जीवलोके\nयथा धर्मो नैपुणेनोपदिष्टः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095844, "chapter_id": 3045, "verse_number": "१३-१७५-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095845, "chapter_id": 3045, "verse_number": "१३-१७५-११", "content_sanskrit": "इत्युक्त्वा तं सुरगुरुधर्मराजं युधिष्ठिरम्।\nदिवामचक्रमे धीमान्पश्यतामेव नस्तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095846, "chapter_id": 3045, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चसप्तत्यधिकशततमोऽध्यायः॥ १७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]