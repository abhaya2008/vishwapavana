[{"id": 2010654, "chapter_id": 1216, "verse_number": "१-२१७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010655, "chapter_id": 1216, "verse_number": "१-२१७-१", "content_sanskrit": "ततो राज्ञां चैरराप्तैः प्रवृत्तिरुपनीयत।\nपाण्डवैरुपसंपन्ना द्रौपदी पतिभिः शुभा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010656, "chapter_id": 1216, "verse_number": "१-२१७-२", "content_sanskrit": "येन तद्धनुरादाय लक्ष्यं विद्धं महात्मना।\nसोऽर्जुनो जयतां श्रेष्ठो महाबाणधनुर्धरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010657, "chapter_id": 1216, "verse_number": "१-२१७-३", "content_sanskrit": "यः शल्यं मद्रराजं वै प्रोत्क्षिप्यापातयद्बली।\nत्रासयामास संक्रुद्धो वृक्षेण पुरुषान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010658, "chapter_id": 1216, "verse_number": "१-२१७-४", "content_sanskrit": "न चास्य संभ्रमः कश्चिदासीत्तत्र महात्मनः।\nस भीमो भीमसंस्पर्शः शत्रुसेनाङ्गपातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010659, "chapter_id": 1216, "verse_number": "१-२१७-५", "content_sanskrit": "योऽसावत्यक्रमीद्युध्यन्युद्धे दुर्योधनं तथा।\nस राजा पाण्डवश्रेष्ठः पुण्यभाग्बुद्धिवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010660, "chapter_id": 1216, "verse_number": "१-२१७-६", "content_sanskrit": "दुर्योधनस्यावरजैर्यौ युध्येतां प्रतीपवत्।\nतौ यमौ वृत्तसंपन्नौ संपन्नबलविक्रमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010661, "chapter_id": 1216, "verse_number": "१-२१७-७", "content_sanskrit": "ब्रह्मरूपधराञ्श्रुत्वा प्रशान्तान्पाण्डुनन्दनान्।\nकौन्तेयान्मनुजेन्द्राणां विस्मयः समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010662, "chapter_id": 1216, "verse_number": "१-२१७-८", "content_sanskrit": "पौरा हि सर्वे राजन्याः समपद्यन्त विस्मिताः।\nसपुत्रा हि पुरा कुन्ती दग्धा जतुगृहे श्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010663, "chapter_id": 1216, "verse_number": "१-२१७-९", "content_sanskrit": "सर्वभूमिपतीनां च राष्ट्राणां च यशस्विनी।\nपुनर्जातानिव च तांस्तेऽमन्यन्त नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010664, "chapter_id": 1216, "verse_number": "१-२१७-१०", "content_sanskrit": "धिगकुर्वंस्तदा भीष्मं धृतराष्ट्रं च कौरवम्।\nकर्मणाऽतिनृशंसेन पुरोचनकृतेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010665, "chapter_id": 1216, "verse_number": "१-२१७-११", "content_sanskrit": "धार्मिकान्वृत्तसंपन्नान्मातुः प्रियहिते रतान्।\nयदा तानीदृशान्पार्थानुत्सादयितुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010666, "chapter_id": 1216, "verse_number": "१-२१७-१२", "content_sanskrit": "ततः स्वयंवरे वृत्ते धार्तराष्ट्राश्च भारत।\nमन्त्रयन्ति ततः सर्वे कर्णसौबलदूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010667, "chapter_id": 1216, "verse_number": "१-२१७-१३x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010668, "chapter_id": 1216, "verse_number": "१-२१७-१३", "content_sanskrit": "कश्चिच्छत्रुः कर्शनीयः पीडनीयस्तथाऽपरः।\nउत्सादनीयाः कौन्तेयाः सर्वक्षत्रस्य मे मताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010669, "chapter_id": 1216, "verse_number": "१-२१७-१४", "content_sanskrit": "एवं पराजिताः सर्वे यदि यूयं गमिष्यथ।\nअकृत्वा संविदं कांचिन्मनस्तप्स्यत्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010670, "chapter_id": 1216, "verse_number": "१-२१७-१५", "content_sanskrit": "अयं देशश्च कालश्च पाण्डवाहरणाय नः।\nन चेदेवं करिष्यध्वं लोके हास्या भविष्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010671, "chapter_id": 1216, "verse_number": "१-२१७-१६", "content_sanskrit": "यमेते संश्रिता वस्तुं कामयन्ते च भूमिपम्।\nसोऽल्पवीर्यबलो राजा द्रुपदो वै मतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010672, "chapter_id": 1216, "verse_number": "१-२१७-१७", "content_sanskrit": "यावदेतान्न जानन्ति जीवतो वृष्णिपुङ्गवाः।\nचैद्यश्च पुरुषव्याघ्रः शिशुपालः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010673, "chapter_id": 1216, "verse_number": "१-२१७-१८", "content_sanskrit": "एकीभावं गतो राज्ञा द्रुपदेन महात्मना।\nदुराधर्षतरा राजन्भविष्यन्ति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010674, "chapter_id": 1216, "verse_number": "१-२१७-१९", "content_sanskrit": "यावच्चञ्चलतां सर्वे प्राप्नुवन्ति नराधिपाः।\nतावदेव व्यवस्यामः पाण्डवानां वधं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010675, "chapter_id": 1216, "verse_number": "१-२१७-२०", "content_sanskrit": "मुक्ता जतुगृहाद्भीमादाशीविषमुखादिव।\nपुनस्ते यदि मुच्यन्ते महन्नो भयमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010676, "chapter_id": 1216, "verse_number": "१-२१७-२१", "content_sanskrit": "तेषामिहोपयातानामेषां तु चिरवासिनाम्।\nअन्तरे दुष्करं स्थातुं गजयोर्महतोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010677, "chapter_id": 1216, "verse_number": "१-२१७-२२", "content_sanskrit": "हनध्वं प्रगृहीतानि बलानि बलिनां वराः।\nयावन्नः कुरुसेनायां पतन्ति पतगा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010678, "chapter_id": 1216, "verse_number": "१-२१७-२३", "content_sanskrit": "तावत्सर्वाभिसारेण पुरमेतद्विहन्यताम्।\nएतन्मम मतं चैव प्राप्तकालं नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010679, "chapter_id": 1216, "verse_number": "१-२१७-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010680, "chapter_id": 1216, "verse_number": "१-२१७-२४", "content_sanskrit": "शकुनेर्वचनं श्रुत्वा भाषमाणस्य दुर्मतेः।\nसोमदत्तिरिदं वाक्यं जगाद परमं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010681, "chapter_id": 1216, "verse_number": "१-२१७-२५", "content_sanskrit": "प्रकृतीः सप्त वै ज्ञात्वा आत्मनश्च परस्य च।\nतथा देशं च कालं च षड्विधान्स नयोद्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010682, "chapter_id": 1216, "verse_number": "१-२१७-२६", "content_sanskrit": "स्थानं वृद्धिं क्षयं चैव भूमिं मित्राणि विक्रमम्।\nप्रसमीक्ष्याभियुञ्जीत परं व्यसनपीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010683, "chapter_id": 1216, "verse_number": "१-२१७-२७", "content_sanskrit": "ततोऽहं पाण्डवान्मन्ये मित्रकोशसमन्वितान्।\nबलस्थान्विक्रमस्थांश्च स्वकृतैः प्रकृतिप्रियान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010684, "chapter_id": 1216, "verse_number": "१-२१७-२८", "content_sanskrit": "वपुषा हि तु भूतानां नेत्राणि हृदयानि च।\nश्रोत्रं मधुरया वाचा रमयत्यर्जुनो नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010685, "chapter_id": 1216, "verse_number": "१-२१७-२९", "content_sanskrit": "न तु केवलदैवेन प्रजा भावेन भेजिरे।\nयद्बभूव मनःकान्तं कर्मणा स चकार तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010686, "chapter_id": 1216, "verse_number": "१-२१७-३०", "content_sanskrit": "न ह्ययुक्तं न चासक्तं नानृतं न च विप्रियम्।\nभाषितं चारुभाषस्य जज्ञे पार्थस्य भारती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2010687, "chapter_id": 1216, "verse_number": "१-२१७-३१", "content_sanskrit": "तानेवंगुणसंपन्नान्संपन्नान्राजलक्षणैः।\nन तान्पश्यामि ये शक्ताः समुच्छेत्तुं यथा बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2010688, "chapter_id": 1216, "verse_number": "१-२१७-३२", "content_sanskrit": "प्रभावशक्तिर्विपुला मन्त्रशक्तिश्च पुष्कला।\nतथैवोत्साहशक्तिश्च पार्थेष्वप्यधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2010689, "chapter_id": 1216, "verse_number": "१-२१७-३३", "content_sanskrit": "मौलमित्रबलानां च कालज्ञो वै युधिष्ठिरः।\nसाम्ना दानेन भेदेन दण्डेनेति युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2010690, "chapter_id": 1216, "verse_number": "१-२१७-३४", "content_sanskrit": "अमित्रांश्च ततो जेतुनं न रोषेणेति मे मतिः।\nपरिक्रीय धनैः शत्रुं मित्राणि च बलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2010691, "chapter_id": 1216, "verse_number": "१-२१७-३५", "content_sanskrit": "मूलं च सुकृतं कृत्वा भुङ्क्ते भूमिं च पाण्डवः।\nअशक्यान्पाण्डवान्मन्ये देवैरपि सवासवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2010692, "chapter_id": 1216, "verse_number": "१-२१७-३६", "content_sanskrit": "येषामर्थे सदा युक्तौ कृष्णसंकर्षणावुभौ।\nश्रेयश्च यदि मन्यद्वं मन्मतं यदि वा मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2010693, "chapter_id": 1216, "verse_number": "१-२१७-३७", "content_sanskrit": "संविदं पाण्डवैः सर्वैः कृत्वा याम यथागतम्।\nगोपुराट्टालकैरुच्चैरुपतल्पशतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2010694, "chapter_id": 1216, "verse_number": "१-२१७-३८", "content_sanskrit": "गुप्तं पुरवरश्रेष्ठमेतदद्भिश्च संवृतम्।\nतृणधान्येन्धरसैस्तथा यन्त्रायुधौषधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2010695, "chapter_id": 1216, "verse_number": "१-२१७-३९", "content_sanskrit": "युक्तं बहुकवाटैश्च द्रव्यागारसुवेदिकैः।\nभीमोच्छ्रितमहाचक्रं बृहदट्टालसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2010696, "chapter_id": 1216, "verse_number": "१-२१७-४०", "content_sanskrit": "दृढप्राकारनिर्यूहं शतघ्नीशतसंकुलम्।\nऐष्टको दारवो वप्रो मानुषश्चेति यः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2010697, "chapter_id": 1216, "verse_number": "१-२१७-४१", "content_sanskrit": "प्राकारकर्तृभिर्वीरैर्नृगर्भस्तत्र पूजितः।\nतदेतन्नरगर्भेण पाण्डरेण विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2010698, "chapter_id": 1216, "verse_number": "१-२१७-४२", "content_sanskrit": "सालेनानेकतालेन सर्वतः संवृतं पुरम्।\nअनुरक्ताः प्रकृतयो द्रुपदस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2010699, "chapter_id": 1216, "verse_number": "१-२१७-४३", "content_sanskrit": "दानमानार्जिताः सर्वे बाह्याभ्यन्तरगाश्च ये।\nप्रतिरुद्धानिमाञ्ज्ञात्वा राजभिर्भीमविक्रमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2010700, "chapter_id": 1216, "verse_number": "१-२१७-४४", "content_sanskrit": "उपयास्यन्ति दाशार्हाः समुदग्रोच्छ्रितायुधाः।\nतस्मात्संन्धिं वयं कृत्वा धार्तराष्ट्रस्य पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2010701, "chapter_id": 1216, "verse_number": "१-२१७-४५", "content_sanskrit": "स्वराष्ट्रमेव गच्छामो यद्याप्तं वचनं मम।\nएतन्मम मतं सर्वैः क्रियतां यदि रोचते।\nएतद्धि सुकृतं मन्ये क्षेमं चापि महीभिताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2010702, "chapter_id": 1216, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि सप्तदशाधिकद्विशततमोऽध्यायः॥ २१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]