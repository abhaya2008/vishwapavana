[{"id": 7002904000, "chapter_id": 22904, "verse_number": "९-१८९-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nकथयिष्ये महाराज हेमहस्तिरथं तव ।\nयस्य प्रदानाद्भवनं वैष्णवं याति मानवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002904001, "chapter_id": 22904, "verse_number": "९-१८९-२", "content_sanskrit": "पर्वकालं समासाद्य संक्रांतौ ग्रहणेऽपि वा ।\nकुर्याद्देवरथाकारं रथं मणिविभूषितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002904002, "chapter_id": 22904, "verse_number": "९-१८९-३", "content_sanskrit": "वलभीभिर्विचित्राभिश्चतुश्चक्रसमन्वितम् ।\nचतुर्भिर्हेममातंगैर्युक्तं हेमविभूषितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002904003, "chapter_id": 22904, "verse_number": "९-१८९-४", "content_sanskrit": "ध्वजे च गरुडं कुर्यात्कूबराग्रे विनायकम् ।\nलोकपालाष्टकोपेतं ब्रह्मार्कशिवसंयुतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002904004, "chapter_id": 22904, "verse_number": "९-१८९-५", "content_sanskrit": "मध्ये नारायणोपेतं लक्ष्मीपुष्टिसमन्वितम् ।\nकृष्णाजिनतिलद्रोणं कृत्वा तं स्थापयेद्रथम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002904005, "chapter_id": 22904, "verse_number": "९-१८९-६", "content_sanskrit": "नानाफलसमायुक्तमुपरिष्टाद्वितानकम् ।\nकौशेयवस्त्रसंवीतमम्लानकुसुमार्चितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002904006, "chapter_id": 22904, "verse_number": "९-१८९-७", "content_sanskrit": "कुर्यात्पंचपलादूर्ध्वमाशताच्च नरोत्तम ।\nततः स्नात्वा समभ्यर्च्य पितॄन्देवान्यथाविधि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002904007, "chapter_id": 22904, "verse_number": "९-१८९-८", "content_sanskrit": "त्रिःप्रदक्षिणमावृत्य गृहीतकुसुमांजलिः ।\nइममुच्चारयेन्मंत्रं सर्वसौख्यप्रदायकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002904008, "chapter_id": 22904, "verse_number": "९-१८९-९", "content_sanskrit": "नमोनमः शंकरपद्मजार्कलोकेशविद्याधरवासुदेवैः ।\nत्वं सेव्यसे वेदपुराणयज्ञैस्तेजो हि नः स्यंदन पाहि तस्मात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002904009, "chapter_id": 22904, "verse_number": "९-१८९-१०", "content_sanskrit": "यत्तत्पदं परमगुह्यतमं पुराणमानंदहेतुगणरूपविमुक्तबन्धाः ।\nयोगैकमानसदृशो मुनयः समाधौ पश्यंति तत्त्वमसि नाथ रथेति रूढः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002904010, "chapter_id": 22904, "verse_number": "९-१८९-११", "content_sanskrit": "यस्मात्त्वमेव भवसागरसंप्लुतानामानंदभांडचितमध्यगपानपात्रम् ।\nतस्मादघौघशमनेन कुरु प्रसादं चामीकरेभरथ माधव संप्रदानात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002904011, "chapter_id": 22904, "verse_number": "९-१८९-१२", "content_sanskrit": "इत्थं प्रणम्य कनकेभरथप्रदानं यः कारयेत्सकलपापविमुक्तदेहः ।\nविद्याधरामरमुनींद्रगणाभिजुष्टं प्राप्नोत्यसौ पदमतींद्रियमिंदुमौलेः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002904012, "chapter_id": 22904, "verse_number": "९-१८९-१३", "content_sanskrit": "कृतदुरितवितानातुष्टिसद्वह्निपालव्यतिकरकृतदेहोद्वेगभानोऽपि बंधून् ।\nनयति च पितृपौत्रान्रौरवादप्यशेषात्कृतगजरथदानः शाश्वतं सद्म विष्णोः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]