[{"id": 7000099000, "chapter_id": 20099, "verse_number": "९९-१", "content_sanskrit": "अथैकोनशततमोऽध्यायः ऋणप्रमोचनतीर्थवर्णनम् ब्रह्मोवाच ऋणप्रमोचनं नाम तीर्थं वेदविदो विदुः ।\nतस्य स्वरूपं वक्ष्यामि श्रृणु नारद तन्मनाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000099001, "chapter_id": 20099, "verse_number": "९९-२", "content_sanskrit": "आसीत्पृथुश्रवा नाम प्रियः कक्षीवतः सुतः ।\nन दारसंग्रहं लेभे वैराग्यान्नाग्निपूजनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000099002, "chapter_id": 20099, "verse_number": "९९-३", "content_sanskrit": "कनीयांस्तु समर्थोऽपि परिवित्तिभयान्मुने ।\nनाकरोद्दारकर्मादि नैवाग्नीनामुपासनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000099003, "chapter_id": 20099, "verse_number": "९९-४", "content_sanskrit": "तत प्रोचुः पितृगणाः पुत्र कक्षीवतः शुभम् ।\nज्येष्ठं चैव कनिष्ठं च पृथक्पृथगिदं वचः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000099004, "chapter_id": 20099, "verse_number": "९९-५", "content_sanskrit": "पितर ऊचुः ऋणत्रयापनोदाय क्रियतां दारसंग्रहः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000099005, "chapter_id": 20099, "verse_number": "९९-६", "content_sanskrit": "नेत्युवाच ततो ज्येष्ठः किमृणं केन युज्यते ।\nकनीयांस्तु पितॄन्प्राह न योग्यो दारसंग्रहः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000099006, "chapter_id": 20099, "verse_number": "९९-७", "content_sanskrit": "ज्येष्ठे सति महाप्राज्ञः परिवित्तिभयादिति ।\nतावुभौ पुनरप्येवमूचुस्ते वै पितामहाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000099007, "chapter_id": 20099, "verse_number": "९९-८", "content_sanskrit": "पितर ऊचुः यातामुभौ गौतमीं तु पुण्यां कक्षीवतः सुतौ ।\nकुरुतां गौतमीस्तनानं सर्वाभीष्टप्रदायकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000099008, "chapter_id": 20099, "verse_number": "९९-९", "content_sanskrit": "गच्छतां गौतमीं गङ्गां लोकत्रितयपावनीम् ।\nस्नानं च तर्पणं तस्यां कुरुतां श्रद्धयाऽन्वितौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000099009, "chapter_id": 20099, "verse_number": "९९-१०", "content_sanskrit": "दृष्ट्वाऽवनामिता ध्याता गौतमी सर्वकामदा ।\nन देशकालजात्यादिनियमोऽत्रावगाहने ।\nज्येष्ठोऽनृणस्ततो भूयात्परिवित्तिर्न चेतरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000099010, "chapter_id": 20099, "verse_number": "९९-११", "content_sanskrit": "ब्रह्मोवाच ततः पृथुश्रवा ज्येष्ठः कृत्वा स्नानं सतर्पणम् ।\nत्रयाणामपि लोकानं काक्षीवतोऽनृणोऽभवत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000099011, "chapter_id": 20099, "verse_number": "९९-१२", "content_sanskrit": "ततः प्रभृति तत्तीर्थमृणमोचनमुच्यते ।\nश्रौतस्मार्तऋणेभ्यश्च इतरेभ्यश्च नारद ।\nतत्र स्नानेन दानेन ऋणी मुक्तः सुखी भवेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]