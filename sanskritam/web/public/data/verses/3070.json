[{"id": 2096616, "chapter_id": 3070, "verse_number": "१३-२००-१", "content_sanskrit": "युधिष्ठिर उवाच।\nदानेन वर्ततेत्याह तपसा चैव भारत।\nतदेतन्मे मनोदुःशं व्यपोह त्वं पितामह।\nकिंस्वित्पृथिव्यां ह्येतन्मे भवाञ्शंसितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096617, "chapter_id": 3070, "verse_number": "१३-२००-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096618, "chapter_id": 3070, "verse_number": "१३-२००-२", "content_sanskrit": "शृणु यैर्धर्मनिरतैस्तपसा भावितात्मभिः।\nलोका ह्यसंशयं प्राप्ता दानपुण्यरतैर्नृपैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096619, "chapter_id": 3070, "verse_number": "१३-२००-३", "content_sanskrit": "सत्कृतश्च तथाऽऽत्रेयः शिष्येभ्यो ब्रह्म निर्गुणम्।\nउपदिश्य तदा राजन्गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096620, "chapter_id": 3070, "verse_number": "१३-२००-४", "content_sanskrit": "शिबिरोशीनरः प्राणान्प्रियस्य तनयस्य च।\nब्राह्मणार्थमुपाकृत्य नाकपृष्ठमितो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096621, "chapter_id": 3070, "verse_number": "१३-२००-५", "content_sanskrit": "प्रतर्दनः काशिपतिः प्रदाय तनयं स्वकम्।\nब्राह्मणायातुलां कीर्तिमिह चामुत्र चाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096622, "chapter_id": 3070, "verse_number": "१३-२००-६", "content_sanskrit": "रन्तिदेवश्च सांकृत्यो वसिष्ठाय महात्मने।\nअर्घ्यं प्रदाय विधिवल्लेभे लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096623, "chapter_id": 3070, "verse_number": "१३-२००-७", "content_sanskrit": "दिव्यं शतशलाकं च यज्ञार्थं काञ्चनं शुभम्।\nछत्रं देवावृधो दत्त्वा ब्राह्मणायास्थितो दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096624, "chapter_id": 3070, "verse_number": "१३-२००-८", "content_sanskrit": "भगवानम्बरीषश्च ब्राह्मणायामितौजसे।\nप्रदाय सकलं राष्ट्रं सुरोलकमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096625, "chapter_id": 3070, "verse_number": "१३-२००-९", "content_sanskrit": "सावित्रः कुण्डलं दिव्यं यानं च जनमेजयः।\nब्राह्मणाय च गा दत्त्वा गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096626, "chapter_id": 3070, "verse_number": "१३-२००-१०", "content_sanskrit": "वृषादर्भिश्च राजर्षी रत्नानि विविधानि च।\nरम्यांश्चावसथान्दत्त्वा द्विजेभ्यो दिवमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096627, "chapter_id": 3070, "verse_number": "१३-२००-११", "content_sanskrit": "निमी राष्ट्रं च वैदर्भिः कन्यां दत्त्वा महात्मने।\nअगस्त्याय गतः स्वर्गं सपुत्रपशुबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096628, "chapter_id": 3070, "verse_number": "१३-२००-१२", "content_sanskrit": "जामदग्न्यश्च विप्राय भूमिं दत्त्वा महायशाः।\nरामोऽक्षयांस्तथा लोकाञ्जगाम मनसोऽधिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096629, "chapter_id": 3070, "verse_number": "१३-२००-१३", "content_sanskrit": "अवर्षति च पर्जन्ये सर्वभूतानि देवराट्।\nवसिष्ठो जीवयामास येन यातोऽक्षयां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096630, "chapter_id": 3070, "verse_number": "१३-२००-१४", "content_sanskrit": "रामो दाशरथिश्चैव हुत्वा यज्ञेषु वै वसु।\nसगतो ह्यक्षयाँल्लोकान्यस्य लोके महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096631, "chapter_id": 3070, "verse_number": "१३-२००-१५", "content_sanskrit": "कक्षसेनश्च राजर्षिर्वसिष्ठाय महात्मने।\nन्यासं यथावत्संन्यस्य जगामि सुमहायशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096632, "chapter_id": 3070, "verse_number": "१३-२००-१६", "content_sanskrit": "करंधमस्य पौत्रस्तु मरुत्तोऽविक्षितः सुतः।\nकन्यामाङ्गिरसे दत्त्वा दिवामाशु जगाम सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096633, "chapter_id": 3070, "verse_number": "१३-२००-१७", "content_sanskrit": "ब्रह्मदत्तश्च पाञ्चाल्यो राजा धर्मभृतांवरः।\nनिधिं शङ्खमनुज्ञाप्य जगाम परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096634, "chapter_id": 3070, "verse_number": "१३-२००-१८", "content_sanskrit": "राजा मित्रसहश्चैव वसिष्ठाय महात्मने।\nमदयन्तीं प्रियां भार्यां दत्त्वा च त्रिदिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096635, "chapter_id": 3070, "verse_number": "१३-२००-१९", "content_sanskrit": "मनोः पुत्रश्च सुद्युम्नो लिखिताय महात्मने।\nदण्डमुद्धृत्य धर्मेण गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096636, "chapter_id": 3070, "verse_number": "१३-२००-२०", "content_sanskrit": "सहस्रचित्यो राजर्षिः प्राणानिष्टान्महायशाः।\nब्राह्मणार्थे परित्यज्य गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096637, "chapter_id": 3070, "verse_number": "१३-२००-२१", "content_sanskrit": "सर्वकामैश्च सम्पूर्णं दत्त्वा वेश्म हिरण्मयम्।\nमौद्गल्याय गतः स्वर्गं शतद्युम्नो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096638, "chapter_id": 3070, "verse_number": "१३-२००-२२", "content_sanskrit": "भक्ष्यभोज्यस्य च कृतान्राशयः पर्वतोपमान्।\nशाण्डिल्याय पुरा दत्त्वा सुमन्युर्दिवमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096639, "chapter_id": 3070, "verse_number": "१३-२००-२३", "content_sanskrit": "नाम्ना च द्युतिमान्नाम साल्वराजो महाद्युतिः।\nदत्त्वा राज्यमृचीकाय गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096640, "chapter_id": 3070, "verse_number": "१३-२००-२४", "content_sanskrit": "मदिराश्वश्च राजर्षिर्दत्त्वा कन्यां सुमध्यमाम्।\nहिरण्यहस्ताय गतो लोकान्देवैरधिष्ठितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096641, "chapter_id": 3070, "verse_number": "१३-२००-२५", "content_sanskrit": "लोमपादश्च राजर्षिः शान्तां दत्त्वा सुतां प्रभुः।\nऋश्यशृङ्गाय विपुलैः सर्वैः कामैरयुज्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096642, "chapter_id": 3070, "verse_number": "१३-२००-२६", "content_sanskrit": "कौत्साय दत्त्वा कन्यां तु हंसीं नाम यशस्विनीम्।\nगतोऽक्षयानतो लोकान्राजर्षिश्च भगीरथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096643, "chapter_id": 3070, "verse_number": "१३-२००-२७", "content_sanskrit": "दत्त्वा शतसहस्रं तु गवां राजा भगीरथः।\nस वत्सानां कोहलाय गतो लोकाननुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096644, "chapter_id": 3070, "verse_number": "१३-२००-२८", "content_sanskrit": "एते चान्ये च बहवो दानेन तपसा च ह।\nयुधिष्ठिर गताः स्वर्गं निवर्तन्ते पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096645, "chapter_id": 3070, "verse_number": "१३-२००-२९", "content_sanskrit": "तेषां प्रतिष्ठिता कीर्तिर्यावत्स्थास्यति मेदिनी।\nगृहस्थैर्दानतपसा यैर्लोका वै विनिर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096646, "chapter_id": 3070, "verse_number": "१३-२००-३०", "content_sanskrit": "शिष्टानां चरितं ह्येतत्कीर्तितं मे युधिष्ठिर।\nदानयज्ञप्रजासर्गैरेते हि दिवमास्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096647, "chapter_id": 3070, "verse_number": "१३-२००-३१", "content_sanskrit": "दत्त्वा तु सततं तेऽस्तु कौरवाणां धुरन्धर।\nदानयज्ञक्रियायुक्ता बुद्धिर्धर्मोपचायिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096648, "chapter_id": 3070, "verse_number": "१३-२००-३२", "content_sanskrit": "यत्र ते नृपशार्दूल सन्देहो वै भविष्यति।\nश्वः प्रभाते हि वक्ष्यामि सन्ध्या हि समुपस्थिता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096649, "chapter_id": 3070, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विशततमोऽध्यायः॥ २०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]