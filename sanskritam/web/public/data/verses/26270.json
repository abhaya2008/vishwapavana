[{"id": 7006270000, "chapter_id": 26270, "verse_number": "३-२४-१", "content_sanskrit": "हतेषु तेषु रोषान्धो निश्वसञ्छून्यकेश्वरः ।\nकुजलाशमिति प्रोचे युयुत्साव्याकुलाशयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006270001, "chapter_id": 26270, "verse_number": "३-२४-२", "content_sanskrit": "भद्र सेनापतेऽस्माकमभद्रं समुपागतम् ।\nकरङ्काद्यश्चमूनाथाः कन्दलद्भुजविक्रमाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006270002, "chapter_id": 26270, "verse_number": "३-२४-३", "content_sanskrit": "सर्पिणीमायया सर्वगीर्वाणमदभञ्जनाः ।\nपापीयस्या तया गूढमायया विनिपातिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006270003, "chapter_id": 26270, "verse_number": "३-२४-४", "content_sanskrit": "बलाहकप्रभृतयः सप्त ये सैनिकाधिपाः ।\nतानुदग्रभुजासत्त्वान्प्राहिणु प्रधनं प्रति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006270004, "chapter_id": 26270, "verse_number": "३-२४-५", "content_sanskrit": "त्रिशतं चाक्षौहिणीनां प्रस्थापय सहैव तैः ।\nते मर्दयित्वा ललितासैन्यं मायापरायणाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006270005, "chapter_id": 26270, "verse_number": "३-२४-६", "content_sanskrit": "अये विजयमाहार्य संप्राप्स्यन्ति ममान्तिकम् ।\nकीकसगर्भसंजातास्ते प्रचण्डपराक्रमाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006270006, "chapter_id": 26270, "verse_number": "३-२४-७", "content_sanskrit": "बलाहकमुखाः सप्त भ्रातरो जयिनः सदा ।\nतेषामवश्यं विजयो भविष्यति रणाङ्गणे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006270007, "chapter_id": 26270, "verse_number": "३-२४-८", "content_sanskrit": "इति भण्डासुरेणोक्तः कुटिलाक्षः समाह्वयत् ।\nबलाहकमुखान्सप्त सेनानाथान्मदोत्कटान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006270008, "chapter_id": 26270, "verse_number": "३-२४-९", "content_sanskrit": "बलाहकः प्रथमतस्तस्मा त्सूचीमुखोऽपरः ।\nअन्यः फालमुखश्चैव विकर्णो विकटाननः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006270009, "chapter_id": 26270, "verse_number": "३-२४-१०", "content_sanskrit": "करालायुः करटकः सप्तैते वीर्यशालिनः ।\nभण्डासुरं नमस्कृत्य युद्धकौतूहलोल्वणाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006270010, "chapter_id": 26270, "verse_number": "३-२४-११", "content_sanskrit": "कीकसासूनवः सर्वे भ्रातरोऽन्योन्यमावृताः ।\nअन्योन्यसुसहायाश्च निर्जगमुर्नगरान्तरात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006270011, "chapter_id": 26270, "verse_number": "३-२४-१२", "content_sanskrit": "त्रिशाताक्षौहिणीसेनासेनान्योऽन्वगमंस्तदा ।\nउल्लिखन्ति केतुजालैरंबरे घनमण्डलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006270012, "chapter_id": 26270, "verse_number": "३-२४-१३", "content_sanskrit": "घोरसंग्रामिणीपादा घातैर्मर्दितभूतला ।\nपिबन्ति धूलिकाजालैरशेषानपि सागरान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006270013, "chapter_id": 26270, "verse_number": "३-२४-१४", "content_sanskrit": "भेरीनिः साणतंपोट्टपणवानकनिस्वनैः ।\nनभोगुणमयं विश्वमादधानाः पदेपदे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006270014, "chapter_id": 26270, "verse_number": "३-२४-१५", "content_sanskrit": "त्रिशताक्षौहिणीसेनां तां गृहीत्वा मदेद्धताः ।\nप्रवेष्टुमिव विश्वस्मिन्कैकसेयाः प्रतस्थिरे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006270015, "chapter_id": 26270, "verse_number": "३-२४-१६", "content_sanskrit": "धृतरोषारुणाः सूर्यमण्डलो द्दीप्तकङ्कटाः ।\nउद्दीप्तशस्त्रभरणाश्चेलुर्द्दीप्तोर्ध्वकेशिनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006270016, "chapter_id": 26270, "verse_number": "३-२४-१७", "content_sanskrit": "सप्त लोकान्प्रमथितुं प्रोषिताः पूर्वमुद्धताः ।\nभण्डासुरेण महता जगद्विजयकारिणा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006270017, "chapter_id": 26270, "verse_number": "३-२४-१८", "content_sanskrit": "सप्तलोकविमर्देन तेन दृष्ट्वा महाबलाः ।\nप्रोषिता ललितासैन्यं जेतुकामेन दुर्धिया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006270018, "chapter_id": 26270, "verse_number": "३-२४-१९", "content_sanskrit": "ते पतन्तो रणतलमुच्चलच्छत्रपाणयः ।\nशक्तिसेनामभिमुखं सक्रोधमभिदुद्रुवुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006270019, "chapter_id": 26270, "verse_number": "३-२४-२०", "content_sanskrit": "मुहुः किलकिलाराबैर्घोषयन्तो दिशो दश ।\nदेव्यास्तु सैनिकं यत्र तत्र ते जगमुरुद्धताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006270020, "chapter_id": 26270, "verse_number": "३-२४-२१", "content_sanskrit": "सैन्यं च ललितादेव्याः सन्नद्धं शास्त्रभीषणम् ।\nअभ्यमित्रीणमभवद्बद्धभ्रुकुटिनिष्ठुरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006270021, "chapter_id": 26270, "verse_number": "३-२४-२२", "content_sanskrit": "पाशिन्यो मुसलिन्यश्च चक्रिण्यश्चापरा मुने ।\nमुद्गरिण्यः पट्टिशिन्यः कोदण्डिन्यस्तथापराः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006270022, "chapter_id": 26270, "verse_number": "३-२४-२३", "content_sanskrit": "अनेकाःशक्तयस्तीव्रा ललितासैन्यसंगताः ।\nपिबन्त्य इव दैत्याब्धिं सान्निपेतुः सहस्रशः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006270023, "chapter_id": 26270, "verse_number": "३-२४-२४", "content_sanskrit": "आयातायात हे दुष्टाः पापिन्यो वनिताधमाः ।\nमायापरिग्रहैर्दूरं मोहयन्त्यो जडाशयान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006270024, "chapter_id": 26270, "verse_number": "३-२४-२५", "content_sanskrit": "नेष्यामो भवतीरद्य प्रेतनाथनिकेतनम् ।\nश्वसद्भुजगसंकाशैर्बाणैर त्यन्तभीषणैः ।\nइति शक्तीर्भर्त्सयन्तो दानवाश्चक्रुराहवम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006270025, "chapter_id": 26270, "verse_number": "३-२४-२६", "content_sanskrit": "काचिच्चिच्छेद दैत्येन्द्रं कण्ठे पट्टिशपातनात् ।\nतद्गलोद्गलितो रक्तपूर ऊर्ध्वमुखोऽभवत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006270026, "chapter_id": 26270, "verse_number": "३-२४-२७", "content_sanskrit": "तत्र लग्ना बहुतरा गृध्रा मण्डलतां गताः ।\nतैरेव प्रेतनाथस्य च्छत्रच्छविरुदञ्चिता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006270027, "chapter_id": 26270, "verse_number": "३-२४-२८", "content_sanskrit": "काचिच्छक्तिः मुरारातिं मुक्तशक्त्यायुधं रणे ।\nलूनतच्छक्तिनैकेन बाणेन व्यलुनीत च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006270028, "chapter_id": 26270, "verse_number": "३-२४-२९", "content_sanskrit": "एका तु गजमारूढा कस्यचिद्दैत्यदुर्मतेः ।\nउरःस्थले स्वकरिणा वप्राघातमशिक्षयत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006270029, "chapter_id": 26270, "verse_number": "३-२४-३०", "content_sanskrit": "काचित्प्रतिभटारूढं दन्तिनं कुंभसीमनि ।\nखड्गेन सहसा हत्वा गजस्य स्वप्रियं व्यधात् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006270030, "chapter_id": 26270, "verse_number": "३-२४-३१", "content_sanskrit": "करमुक्तेन चक्रेण कस्यचिद्देववैरिणः ।\nधनुर्दण्डं द्विधा कृत्वा स्वभ्रुवोः प्रतिमां तनेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006270031, "chapter_id": 26270, "verse_number": "३-२४-३२", "content_sanskrit": "शक्तिरन्या शरैः शातैः शातयित्वा विरोधिनः ।\nकृपाणपद्मा रोमाल्यां स्वकीयायां मुदं व्यधात् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006270032, "chapter_id": 26270, "verse_number": "३-२४-३३", "content_sanskrit": "काचिन्मुद्गरपातेन चूर्णयित्वा विरोधिनः ।\nरथ्यक्रनितंबस्य स्वस्य तेनातनोन्मुदम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006270033, "chapter_id": 26270, "verse_number": "३-२४-३४", "content_sanskrit": "रथकूबरमुग्रेण कस्यचिद्दानवप्रभोः ।\nखड्गेन छिन्दती स्वस्य प्रियमुव्यास्ततान ह ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006270034, "chapter_id": 26270, "verse_number": "३-२४-३५", "content_sanskrit": "अभ्यन्तरं शक्तिसेना दैत्यानां प्रविवेश ह ।\nप्रविवेश च दैत्यानां सेना शक्तिबलान्तरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006270035, "chapter_id": 26270, "verse_number": "३-२४-३६", "content_sanskrit": "नीरक्षीरवदत्यन्ताश्लेषं शक्तिसुरद्विषाम् ।\nसंकुलाकारतां प्राप्तो युद्धकालेऽभवत्तदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006270036, "chapter_id": 26270, "verse_number": "३-२४-३७", "content_sanskrit": "शक्तीनां खड्गपातेन लूनशुण्डारदद्वयाः ।\nदैत्यानां करिणो मत्ता महाक्रोडा इवाभवन् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006270037, "chapter_id": 26270, "verse_number": "३-२४-३८", "content_sanskrit": "एवं प्रवृत्ते समरे वीराणां च भयङ्करे ।\nअशक्ये स्मर्तुमप्यन्तं कातरत्ववतां नृणाम् ।\nभीषणानां भीषणे च शस्त्रव्यापारदुर्गमे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006270038, "chapter_id": 26270, "verse_number": "३-२४-३९", "content_sanskrit": "बलाहको महागृध्रं वज्रतीक्ष्णमुखादिकम् ।\nकालदण्डोपमं जङ्घाकाण्डे चण्डपराक्रमम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006270039, "chapter_id": 26270, "verse_number": "३-२४-४०", "content_sanskrit": "संहारगुप्तनामानं पूर्वमग्रे समुत्थितम् ।\nधूमवद्धूसराकारं पक्षक्षेपभयङ्करम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006270040, "chapter_id": 26270, "verse_number": "३-२४-४१", "content_sanskrit": "आरुह्य विविधंयुद्धं कृतवान्युद्धदुर्मदः ।\nपक्षौ वितत्य क्रोशार्धं स स्थितो भीमनिःस्वनैः ।\nअङ्गारकुण्डवच्चञ्चुं विदार्याभक्षयच्चमूम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006270041, "chapter_id": 26270, "verse_number": "३-२४-४२", "content_sanskrit": "संहारगुप्तं स महागृध्रः क्रूरविलोचनः ।\nबलाहकमुवाहोच्चैराकृष्टधनुषं रणे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006270042, "chapter_id": 26270, "verse_number": "३-२४-४३", "content_sanskrit": "बलाहको वपुर्धुन्वन्गृध्रपृष्ठकृतस्थितिः ।\nसपक्षकूटशैलस्थो बलाहक इवाभवत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006270043, "chapter_id": 26270, "verse_number": "३-२४-४४", "content_sanskrit": "सूचीमुखश्च दैत्येन्द्रः सूचीनिष्ठुरपक्षतिम् ।\nकाकवाहनमारुह्य कठिनं समरं व्यधात् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006270044, "chapter_id": 26270, "verse_number": "३-२४-४५", "content_sanskrit": "मत्तः पर्वतशृङ्गाभश्चञ्चूदण्डं समुद्वहन् ।\nकालदण्डप्रमाणेन जङ्घाकाण्डेन भीषणः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006270045, "chapter_id": 26270, "verse_number": "३-२४-४६", "content_sanskrit": "पुष्कलावर्तकसमा जंबालसदृशद्यतिः ।\nक्रोशमात्रायतौ पक्षावुभावपि समुद्वहन् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006270046, "chapter_id": 26270, "verse_number": "३-२४-४७", "content_sanskrit": "सूचीमुखाधिष्ठितोऽसौ करटः कटुवासितः ।\nमर्दयञ्चञ्चुघातेन शक्तीनां मण्डलं महत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006270047, "chapter_id": 26270, "verse_number": "३-२४-४८", "content_sanskrit": "अथो फलमुखः फालं गृहीत्वा निजमायुधम् ।\nकङ्कमारुह्य समरे चकाशे गिरिसन्निभम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006270048, "chapter_id": 26270, "verse_number": "३-२४-४९", "content_sanskrit": "विकर्णाख्यश्च दैत्येन्द्रश्चमूभर्ता महाबलः ।\nभेरुण्डपतनारूढः प्रचण्डयुद्धमातनोत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006270049, "chapter_id": 26270, "verse_number": "३-२४-५०", "content_sanskrit": "विकटानननामानं विलसत्पट्टिशायुधम् ।\nउवाह समरे चण्डः कुक्कुटोऽतिभयङ्करः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006270050, "chapter_id": 26270, "verse_number": "३-२४-५१", "content_sanskrit": "गर्जन्कण्ठस्थरोमाणि हर्षयञ्ज्वलदीक्षणः ।\nपश्यन्पुरः शक्तिसैन्यं चचाल चरणायुधः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006270051, "chapter_id": 26270, "verse_number": "३-२४-५२", "content_sanskrit": "करालाक्षश्च भूभर्ता षष्ठोऽत्यन्तगरिष्ठदः ।\nवज्रनिष्ठुरघोषश्च प्राचलत्प्रेतवाहनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006270052, "chapter_id": 26270, "verse_number": "३-२४-५३", "content_sanskrit": "श्मशानमन्त्रशूरेणतेन संसाधितः पुरा ।\nप्रेतो भूतसमाविष्टस्तमुवाह रणाजिरे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006270053, "chapter_id": 26270, "verse_number": "३-२४-५४", "content_sanskrit": "अवाङ्मुखो दीर्घबाहुः प्रसारितपदद्वयः ।\nप्रोतो वाहनतां प्राप्तःकरालाक्षमथावहत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006270054, "chapter_id": 26270, "verse_number": "३-२४-५५", "content_sanskrit": "अन्यः करटको नाम दैत्यसेनाशिखामणिः ।\nसर्दयामास शक्तीनां सैन्यं वेतालवाहनः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006270055, "chapter_id": 26270, "verse_number": "३-२४-५६", "content_sanskrit": "योजनायतमूर्तिः सन्वेतालः क्रूरलोचनः ।\nश्मशानभूमौ वेतालो मन्त्रेणानेन साधितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006270056, "chapter_id": 26270, "verse_number": "३-२४-५७", "content_sanskrit": "मर्दयामास पृतनां शक्तीनां तेन देशितः ।\nतस्य वेतालवर्यस्य वर्तमानोंससीमनि ।\nबहुधायुध्यत तदा शक्तिभिः सह दानवः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006270057, "chapter_id": 26270, "verse_number": "३-२४-५८", "content_sanskrit": "एवमेते खलात्मानः सप्त सप्तार्णवोपमाः ।\nशक्तीनां सैनिकं तत्र व्याकुलीचक्रुरुद्धताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006270058, "chapter_id": 26270, "verse_number": "३-२४-५९", "content_sanskrit": "ते सप्त पूर्वं तपसा सवितारमतोषयन् ।\nतेन दत्तो वरस्तेषां तपस्तुष्टेन भास्वता ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006270059, "chapter_id": 26270, "verse_number": "३-२४-६०", "content_sanskrit": "कैकसेया महाभागा भवतां तपसाधुना ।\nपरितुष्टोऽस्मि भद्रं वो भवन्तो वृणतां वरम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006270060, "chapter_id": 26270, "verse_number": "३-२४-६१", "content_sanskrit": "इत्युक्ते दिननाथेन कैकसेयास्तपः कृशाः ।\nप्रार्थयामासुरत्यर्थं दुर्दान्तं वरमीदृशम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006270061, "chapter_id": 26270, "verse_number": "३-२४-६२", "content_sanskrit": "रणेषु सन्निधातव्यमस्माकं नेत्रकुक्षिषु ।\nभवता घोरतेजोभिर्दहता प्रतिरोधिनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006270062, "chapter_id": 26270, "verse_number": "३-२४-६३", "content_sanskrit": "त्वया यदा सन्निहितं तपनास्माकमक्षिषु ।\nतदाक्षिविषयः सर्वो निश्चेष्टो भवतात्प्रभो ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006270063, "chapter_id": 26270, "verse_number": "३-२४-६४", "content_sanskrit": "त्वत्सान्निध्यसमिद्धेन नेत्रेणास्माकमीक्षिताः ।\nस्तब्धशस्त्रा भविष्यन्ति प्रतिरोधकसैनिकाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006270064, "chapter_id": 26270, "verse_number": "३-२४-६५", "content_sanskrit": "ततः स्तब्धेषु शस्त्रेषु वीक्षणादेव नः प्रभो ।\nनिश्चेष्टा रिपवोऽस्माभिर्हन्तव्याः सुकरत्वतः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006270065, "chapter_id": 26270, "verse_number": "३-२४-६६", "content_sanskrit": "इति पूर्वं वरः प्राप्तः कैकसेयौर्दिवाकरात् ।\nवरदानेन ते तत्र युद्धे चेरुर्मधोद्धताः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006270066, "chapter_id": 26270, "verse_number": "३-२४-६७", "content_sanskrit": "अथ सूर्यसमाविष्टनेत्रैस्तेस्तु निरीक्षिताः ।\nशक्तयः स्तब्धशस्त्रौघा विफलोत्सा हतां गताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006270067, "chapter_id": 26270, "verse_number": "३-२४-६८", "content_sanskrit": "कीकसातनयैस्तैस्तु सप्तभिः सत्त्वशालिभिः ।\nविष्टंभितास्त्रशस्त्राणां शक्तीनां नोद्यमोऽभवत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006270068, "chapter_id": 26270, "verse_number": "३-२४-६९", "content_sanskrit": "उद्यमे क्रियभाणेऽपि शस्त्रस्तम्भेन भूयसा ।\nअभिभूताः सनिश्वासं शक्तयो जोषमासत ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006270069, "chapter_id": 26270, "verse_number": "३-२४-७०", "content_sanskrit": "अथ ते वासरं प्राप्य नानाप्रहरणोद्यताः ।\nव्यमर्दयञ्छक्तिसैन्यं दैत्याः स्वस्वामिदेशिताः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006270070, "chapter_id": 26270, "verse_number": "३-२४-७१", "content_sanskrit": "शक्तयस्तास्तु सैन्येन निर्व्यापारा निरायुधाः ।\nअक्षुभ्यन्त शरैस्तेषां वज्रकङ्कटभोदिभिः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006270071, "chapter_id": 26270, "verse_number": "३-२४-७२", "content_sanskrit": "शक्तयो दैत्यशस्त्रौधैर्विद्धगात्राः सृतामृजः ।\nसुपल्लवा रणे रेजुः कङ्कोललतिका इव ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006270072, "chapter_id": 26270, "verse_number": "३-२४-७३", "content_sanskrit": "हाहाकारं वितन्वत्यः प्रपन्ना ललितेश्वरीम् ।\nचुक्रुशुः शक्तयः सर्वास्तैः स्तंभितनिजायुधाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006270073, "chapter_id": 26270, "verse_number": "३-२४-७४", "content_sanskrit": "अथ देव्याज्ञया दण्डनाथा प्रत्यङ्गरक्षिणी ।\nतिरस्करणिका देवी समुत्तस्थौ रणाजिरे ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006270074, "chapter_id": 26270, "verse_number": "३-२४-७५", "content_sanskrit": "तमोलिप्ताह्वयं नाम विमानं सर्वतोमुखम् ।\nमहामाया समारुह्य शक्तीनामभयं व्यधात् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006270075, "chapter_id": 26270, "verse_number": "३-२४-७६", "content_sanskrit": "तमालश्यामलाकारा श्यामकञ्चुकधारिणी ।\nश्यामच्छाये तमोलिप्ते श्यामयुक्ततुरङ्गमे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006270076, "chapter_id": 26270, "verse_number": "३-२४-७७", "content_sanskrit": "वासन्ती मोहनाभिख्यं धनुरादाय सस्वनम् ।\nसिंहनादं विनद्येषूनवर्षत्सर्पसन्निभान् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006270077, "chapter_id": 26270, "verse_number": "३-२४-७८", "content_sanskrit": "कृष्णरूपभुजङ्ग भानधोमुसलसंनिभान् ।\nमोहनास्त्रविनिष्ठ्यूतान्बाणान्दैत्या न सेहिरे ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006270078, "chapter_id": 26270, "verse_number": "३-२४-७९", "content_sanskrit": "इतस्ततो मर्द्यमाना महामायाशिलीमुखैः ।\nप्रकोपं परमं प्राप्ता बलाहकमुखाः खलाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006270079, "chapter_id": 26270, "verse_number": "३-२४-८०", "content_sanskrit": "अथो तिरस्करण्यंबा दण्डनाथानिदेशतः ।\nअन्धाभिधं महास्त्रं सा मुमोच द्विषतां गणे ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006270080, "chapter_id": 26270, "verse_number": "३-२४-८१", "content_sanskrit": "बलाहकाद्यास्ते सप्त दिननाथवरोद्धताः ।\nअन्धास्त्रेण निजं नेत्रं दधिरे च्छादितं यथा ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006270081, "chapter_id": 26270, "verse_number": "३-२४-८२", "content_sanskrit": "तिरस्करणिकादेव्या महामोहनधन्वनः ।\nउद्गतेनान्धबाणेन चक्षुस्तेषां व्यधीयत ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006270082, "chapter_id": 26270, "verse_number": "३-२४-८३", "content_sanskrit": "अन्धीकृताश्च ते सप्त न तु प्रैक्षन्त किञ्चन ।\nतद्वीक्षणस्य विरहाच्छस्त्रस्तम्भः क्षयं गतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006270083, "chapter_id": 26270, "verse_number": "३-२४-८४", "content_sanskrit": "पुनः ससिंहनादं ताः प्रोद्यतायुधपाणयः ।\nचक्रुः समरसन्नाहं दैत्यानां प्रजिघांसया ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006270084, "chapter_id": 26270, "verse_number": "३-२४-८५", "content_sanskrit": "तिरस्करणिकां देवीमग्रे कृत्वा महाबलाम् ।\nसदुपायप्रसङ्गेन भृशं तुष्टा रणं व्यधुः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006270085, "chapter_id": 26270, "verse_number": "३-२४-८६", "content_sanskrit": "साधुसाधु महाभागे तिरस्करणिकांबिके ।\nस्थाने कृततिरस्कारा द्विपामेषां दुरात्मनाम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006270086, "chapter_id": 26270, "verse_number": "३-२४-८७", "content_sanskrit": "त्वं हि दुर्जननेत्राणां तिरस्कारमहौषधी ।\nत्वया बद्धदृशानेन दैत्यचक्रेण भूयते ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006270087, "chapter_id": 26270, "verse_number": "३-२४-८८", "content_sanskrit": "देवकार्यमिदं देवि त्वया सम्यगनुष्टितम् ।\nअस्मादृशामजय्येषु यदेषु व्यसनं कृतम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006270088, "chapter_id": 26270, "verse_number": "३-२४-८९", "content_sanskrit": "तत्त्वयैव दुराचारानेतान्सप्त महासुरान् ।\nनिहतांल्ललिता श्रुत्वा सन्तोषं परमाप्स्यति ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006270089, "chapter_id": 26270, "verse_number": "३-२४-९०", "content_sanskrit": "एवं त्वया विरचिते दण्डिनीप्रीति माप्स्यति ।\nमन्त्रिण्यपि महाभागायास्यत्येव परां मुदम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006270090, "chapter_id": 26270, "verse_number": "३-२४-९१", "content_sanskrit": "तस्मात्त्वमेव सप्तैतान्निगृहण रणाजिरे ।\nएषां सैन्यं तु निखिलं नाशयाम उदायुधाः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006270091, "chapter_id": 26270, "verse_number": "३-२४-९२", "content_sanskrit": "इत्युक्त्वा प्रेरिता ताभिः शक्तिभियुर्द्धकौतुकान् ।\nतमोलिप्तेन यानेन बलाहकबलं ययौ ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006270092, "chapter_id": 26270, "verse_number": "३-२४-९३", "content_sanskrit": "तामायान्तीं समावेक्ष्य ते सप्ताथ सुराधमाः ।\nपुनरेव च सावित्रं वरं सस्मरुरञ्जसा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006270093, "chapter_id": 26270, "verse_number": "३-२४-९४", "content_sanskrit": "प्रविष्टमपि सावित्रं नाशकं तन्निरोधने ।\nतिरस्कृतं तु नेत्रस्थं तिरस्करणितेजसा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006270094, "chapter_id": 26270, "verse_number": "३-२४-९५", "content_sanskrit": "वरदानास्त्ररोषान्धं महाबलपराक्रमम् ।\nअस्त्रेण च रुषा चान्धं बलाहकमहासुरम् ।\nआकृष्य केशेष्वसिना चकर्तान्तर्धिदेवता ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006270095, "chapter_id": 26270, "verse_number": "३-२४-९६", "content_sanskrit": "तस्य वाहनगृध्रस्य लुनाना पत्रिणा शिरः ।\nसूचीमुखस्याभिमुखं तिरस्करणिका व्रजत् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006270096, "chapter_id": 26270, "verse_number": "३-२४-९७", "content_sanskrit": "तस्य पट्टिशपातेन विलूय कठिनं शिरः ।\nअन्येषामपि पञ्चानां पञ्चत्वमकरोच्छनैः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006270097, "chapter_id": 26270, "verse_number": "३-२४-९८", "content_sanskrit": "तैः सप्तदैत्यमुण्डैश्चग्रथितान्योन्यकेशकैः ।\nहारदाम गले कृत्वा ननादान्तर्धिदेवता ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006270098, "chapter_id": 26270, "verse_number": "३-२४-९९", "content_sanskrit": "समस्तमपि तत्सैन्यं शक्तयः क्रोधसूर्च्छिताः ।\nहत्वा तद्रक्तसलिलैर्बह्वीः प्रावाहयन्नदीः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006270099, "chapter_id": 26270, "verse_number": "३-२४-१००", "content_sanskrit": "तत्राश्चर्यमभूद्भूरि माहामायांबिकाकृतम् ।\nबलाहकादिसेनान्यां दृष्टिरोधनवैभवात् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006270100, "chapter_id": 26270, "verse_number": "३-२४-१०१", "content_sanskrit": "हतशिष्टाः कतिपया बहुवित्राससङ्कुलाः ।\nशरणं जग्मुरत्यार्त्ताः क्रन्दन्तं शून्यकेश्वरम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006270101, "chapter_id": 26270, "verse_number": "३-२४-१०२", "content_sanskrit": "दण्डिनीं च महामायां प्रशंसन्ति मुहुर्मुहुः ।\nप्रसादमपरं चक्षुस्तस्या आदायपिप्रियुः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006270102, "chapter_id": 26270, "verse_number": "३-२४-१०३", "content_sanskrit": "साधुसाध्विति तत्रस्थाः शक्तयः कम्पमौलयः ।\nतिरस्करणिकां देवीमश्लाघन्त पदेपदे ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]