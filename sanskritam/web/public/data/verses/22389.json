[{"id": 7002389000, "chapter_id": 22389, "verse_number": "१-५१-१", "content_sanskrit": "वासुदेव उवाच ।\nमाघस्य शुक्लपक्षे तु पञ्चम्यां मत्कुलोद्वह ।\nएकभक्तं सदाख्यातं षष्ट्यां नक्तमुदाहृतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002389001, "chapter_id": 22389, "verse_number": "१-५१-२", "content_sanskrit": "सप्तम्यामुपवासं तु केचिदिच्छन्ति सुव्रत ।\nषष्ठ्यां केचिद्वदन्तीह सप्तम्यां पारणं किल ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002389002, "chapter_id": 22389, "verse_number": "१-५१-३", "content_sanskrit": "कृतोपवासः षष्ठ्यां तु पूजयेद्भास्करं बुधः ।\nरक्तचन्दनमिश्रैस्तु करवीरैश्च सुव्रत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002389003, "chapter_id": 22389, "verse_number": "१-५१-४", "content_sanskrit": "गुग्गुलेन महाबाहो संयावेन च सुव्रत ।\nपूजयेद्देवदेवेशं शङ्करं भास्करं रविम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002389004, "chapter_id": 22389, "verse_number": "१-५१-५", "content_sanskrit": "एवं हि चतुरो मासान्माघादीन्पूजयेद्रविम् ।\nआत्मनश्चापि शुध्यर्थं प्राशनं गोमयस्य च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002389005, "chapter_id": 22389, "verse_number": "१-५१-६", "content_sanskrit": "स्नानं च गोमयेनेह कर्तव्यं चात्मशुद्धये ।\nब्राह्मणान्दिव्यभौमांश्च भोजयेच्चापि शक्तितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002389006, "chapter_id": 22389, "verse_number": "१-५१-७", "content_sanskrit": "ज्येष्ठादिष्वथ मासेषु श्वेतचन्दनमुच्यते ।\nश्वेतानि चापि पुष्पाणि शुभगन्धान्वितानि वै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002389007, "chapter_id": 22389, "verse_number": "१-५१-८", "content_sanskrit": "कृष्णागरुस्तथा धूपो नैवेद्यं पायसं स्मृतम् ।\nतेनैव ब्राह्मणांस्तुष्टान्भोजयेच्च महामते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002389008, "chapter_id": 22389, "verse_number": "१-५१-९", "content_sanskrit": "प्राशयेत्पञ्चगव्यं तु स्नानं तेनैव पुत्रक ।\nकार्तिकादिषु मासेषु अगस्तिकुसुमैः स्मृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002389009, "chapter_id": 22389, "verse_number": "१-५१-१०", "content_sanskrit": "पूजयेन्नरशार्दूल धूपैश्चैवापराजितैः ।\nनैवेद्यं गुडपूपास्तु तथा चेक्षुरसं स्मृतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002389010, "chapter_id": 22389, "verse_number": "१-५१-११", "content_sanskrit": "तेनैव ब्राह्मणांस्तात भोजयस्व स्वशक्तितः ।\nकुशोदकं प्राशयेथाः स्नानं च कुरु शुद्धये ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002389011, "chapter_id": 22389, "verse_number": "१-५१-१२", "content_sanskrit": "तृतीये पारणास्यान्ते माघे मासि महामते ।\nभोजनं तत्र दानं च द्विगुणं समुदाहृतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002389012, "chapter_id": 22389, "verse_number": "१-५१-१३", "content_sanskrit": "देवदेवस्य पूजा च कर्तव्या शक्तितो बुधैः ।\nरथस्य चापि दानं तु रथयात्रा तु सुव्रत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002389013, "chapter_id": 22389, "verse_number": "१-५१-१४", "content_sanskrit": "व्रतस्य प्राप्तिहेतोर्वै कर्तव्या विभवे सति ।\nदानं स्वर्णरथस्येह यथोक्तं विभवे सति ।\nइत्येषा कथिता पुत्र रथाह्वा सप्तमी शुभा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002389014, "chapter_id": 22389, "verse_number": "१-५१-१५", "content_sanskrit": "महासप्तमी विख्याता महापुण्या महोदया ।\nयामुपोष्य धनं पुत्रान्कीर्तिं विद्यामवाप्नुयात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002389015, "chapter_id": 22389, "verse_number": "१-५१-१६", "content_sanskrit": "तथाखिलं कुवलयं चन्द्रेण च समोर्चिषा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]