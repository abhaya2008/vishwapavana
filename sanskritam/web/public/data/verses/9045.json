[{"id": 5000045000, "chapter_id": 9045, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000045001, "chapter_id": 9045, "verse_number": "१-४५-१", "content_sanskrit": "विश्वामित्रवचः श्रुत्वा राघवः सहलक्ष्मणः।\nविस्मयं परमं गत्वा विश्वामित्रमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000045002, "chapter_id": 9045, "verse_number": "१-४५-२", "content_sanskrit": "अत्यद्भुतमिदं ब्रह्मन् कथितं परमं त्वया।\nगङ्गावतरणं पुण्यं सागरस्यापि पूरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000045003, "chapter_id": 9045, "verse_number": "१-४५-३", "content_sanskrit": "क्षणभूतेव नौ रात्रिः संवृत्तेयं परंतप।\nइमां चिन्तयतोः सर्वां निखिलेन कथां तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000045004, "chapter_id": 9045, "verse_number": "१-४५-४", "content_sanskrit": "तस्य सा शर्वरी सर्वा मम सौमित्रिणा सह।\nजगाम चिन्तयानस्य विश्वामित्र कथां शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000045005, "chapter_id": 9045, "verse_number": "१-४५-५", "content_sanskrit": "ततः प्रभाते विमले विश्वामित्रं तपोधनम्।\nउवाच राघवो वाक्यं कृताह्निकमरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000045006, "chapter_id": 9045, "verse_number": "१-४५-६", "content_sanskrit": "गता भगवती रात्रिः श्रोतव्यं परमं श्रुतम्।\nतराम सरितां श्रेष्ठां पुण्यां त्रिपथगां नदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000045007, "chapter_id": 9045, "verse_number": "१-४५-७", "content_sanskrit": "नौरेषा हि सुखास्तीर्णा ऋषीणां पुण्यकर्मणाम्।\nभगवन्तमिह प्राप्तं ज्ञात्वा त्वरितमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000045008, "chapter_id": 9045, "verse_number": "१-४५-८", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा राघवस्य महात्मनः।\nसन्तारं कारयामास सर्षिसङ्घस्य कौशिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000045009, "chapter_id": 9045, "verse_number": "१-४५-९", "content_sanskrit": "उत्तरं तीरमासाद्य सम्पूज्यर्षिगणं ततः।\nगङ्गाकूले निविष्टास्ते विशालां ददृशुः पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000045010, "chapter_id": 9045, "verse_number": "१-४५-१०", "content_sanskrit": "ततो मुनिवरस्तूर्णं जगाम सहराघवः।\nविशालां नगरीं रम्यां दिव्यां स्वर्गोपमां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000045011, "chapter_id": 9045, "verse_number": "१-४५-११", "content_sanskrit": "अथ रामो महाप्राज्ञो विश्वामित्रं महामुनिम्।\nपप्रच्छ प्राञ्जलिर्भूत्वा विशालामुत्तमां पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000045012, "chapter_id": 9045, "verse_number": "१-४५-१२", "content_sanskrit": "कतमो राजवंशोऽयं विशालायां महामुने।\nश्रोतुमिच्छामि भद्रं ते परं कौतूहलं हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000045013, "chapter_id": 9045, "verse_number": "१-४५-१३", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा रामस्य मुनिपुङ्गवः।\nआख्यातुं तत्समारेभे विशालायाः पुरातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000045014, "chapter_id": 9045, "verse_number": "१-४५-१४", "content_sanskrit": "श्रूयतां राम शक्रस्य कथां कथयतः श्रुताम्।\nअस्मिन् देशे हि यद् वृत्तं शृणु तत्त्वेन राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000045015, "chapter_id": 9045, "verse_number": "१-४५-१५", "content_sanskrit": "पूर्वं कृतयुगे राम दितेः पुत्रा महाबलाः।\nअदितेश्च महाभागा वीर्यवन्तः सुधार्मिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000045016, "chapter_id": 9045, "verse_number": "१-४५-१६", "content_sanskrit": "ततस्तेषां नरव्याघ्र बुद्धिरासीन्महात्मनाम्।\nअमरा विजराश्चैव कथं स्यामो निरामयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000045017, "chapter_id": 9045, "verse_number": "१-४५-१७", "content_sanskrit": "तेषां चिन्तयतां तत्र बुद्धिरासीद् विपश्चिताम्।\nक्षीरोदमथनं कृत्वा रसं प्राप्स्याम तत्र वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000045018, "chapter_id": 9045, "verse_number": "१-४५-१८", "content_sanskrit": "ततो निश्चित्य मथनं योक्त्रं कृत्वा च वासुकिम्।\nमन्थानं मन्दरं कृत्वा ममन्थुरमितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000045019, "chapter_id": 9045, "verse_number": "१-४५-१९", "content_sanskrit": "अथ वर्षसहस्रेण योक्त्रसर्पशिरांसि च।\nवमन्तोऽतिविषं तत्र ददंशुर्दशनैः शिलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000045020, "chapter_id": 9045, "verse_number": "१-४५-२०", "content_sanskrit": "उत्पपाताग्निसंकाशं हालाहलमहाविषम्।\nतेन दग्धं जगत् सर्वं सदेवासुरमानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000045021, "chapter_id": 9045, "verse_number": "१-४५-२१", "content_sanskrit": "अथ देवा महादेवं शङ्करं शरणार्थिनः।\nजग्मुः पशुपतिं रुद्रं त्राहि त्राहीति तुष्टुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000045022, "chapter_id": 9045, "verse_number": "१-४५-२२", "content_sanskrit": "एवमुक्तस्ततो देवैर्देवदेवेश्वरः प्रभुः।\nप्रादुरासीत् ततोऽत्रैव शङ्खचक्रधरो हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000045023, "chapter_id": 9045, "verse_number": "१-४५-२३", "content_sanskrit": "उवाचैनं स्मितं कृत्वा रुद्रं शूलधरं हरिः।\nदैवतैर्मथ्यमाने तु यत्पूर्वं समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000045024, "chapter_id": 9045, "verse_number": "१-४५-२४", "content_sanskrit": "तत् त्वदीयं सुरश्रेष्ठ सुराणामग्रतो हि यत्।\nअग्रपूजामिह स्थित्वा गृहाणेदं विषं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000045025, "chapter_id": 9045, "verse_number": "१-४५-२५", "content_sanskrit": "इत्युक्त्वा च सुरश्रेष्ठस्तत्रैवान्तरधीयत।\nदेवतानां भयं दृष्ट्वा श्रुत्वा वाक्यं तु शार्ङ्गिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000045026, "chapter_id": 9045, "verse_number": "१-४५-२६", "content_sanskrit": "हालाहलं विषं घोरं संजग्राहामृतोपमम्।\nदेवान् विसृज्य देवेशो जगाम भगवान् हरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000045027, "chapter_id": 9045, "verse_number": "१-४५-२७", "content_sanskrit": "ततो देवासुराः सर्वे ममन्थू रघुनन्दन।\nप्रविवेशाथ पातालं मन्थानः पर्वतोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000045028, "chapter_id": 9045, "verse_number": "१-४५-२८", "content_sanskrit": "ततो देवाः सगन्धर्वास्तुष्टुवुर्मधुसूदनम्।\nत्वं गतिः सर्वभूतानां विशेषेण दिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000045029, "chapter_id": 9045, "verse_number": "१-४५-२९", "content_sanskrit": "पालयास्मान् महाबाहो गिरिमुद्धर्तुमर्हसि।\nइति श्रुत्वा हृषीकेशः कामठं रूपमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000045030, "chapter_id": 9045, "verse_number": "१-४५-३०", "content_sanskrit": "पर्वतं पृष्ठतः कृत्वा शिष्ये तत्रोदधौ हरिः।\nपर्वताग्रं तु लोकात्मा हस्तेनाक्रम्य केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000045031, "chapter_id": 9045, "verse_number": "१-४५-३१", "content_sanskrit": "देवानां मध्यतः स्थित्वा ममन्थ पुरुषोत्तमः।\nअथ वर्षसहस्रेण आयुर्वेदमयः पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000045032, "chapter_id": 9045, "verse_number": "१-४५-३२", "content_sanskrit": "उदतिष्ठत् सुधर्मात्मा सदण्डः सकमण्डलुः।\nपूर्वं धन्वन्तरिर्नाम अप्सराश्च सुवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000045033, "chapter_id": 9045, "verse_number": "१-४५-३३", "content_sanskrit": "अप्सु निर्मथनादेव रसात् तस्माद् वरस्त्रियः।\nउत्पेतुर्मनुजश्रेष्ठ तस्मादप्सरसोऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000045034, "chapter_id": 9045, "verse_number": "१-४५-३४", "content_sanskrit": "षष्टिः कोट्योऽभवंस्तासामप्सराणां सुवर्चसाम्।\nअसंख्येयास्तु काकुत्स्थ यास्तासां परिचारिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000045035, "chapter_id": 9045, "verse_number": "१-४५-३५", "content_sanskrit": "न ताः स्म प्रतिगृह्णन्ति सर्वे ते देवदानवाः।\nअप्रतिग्रहणादेव ता वै साधारणाः स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000045036, "chapter_id": 9045, "verse_number": "१-४५-३६", "content_sanskrit": "वरुणस्य ततः कन्या वारुणी रघुनन्दन।\nउत्पपात महाभागा मार्गमाणा परिग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000045037, "chapter_id": 9045, "verse_number": "१-४५-३७", "content_sanskrit": "दितेः पुत्रा न तां राम जगृहुर्वरुणात्मजाम्।\nअदितेस्तु सुता वीर जगृहुस्तामनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000045038, "chapter_id": 9045, "verse_number": "१-४५-३८", "content_sanskrit": "असुरास्तेन दैतेयाः सुरास्तेनादितेः सुताः।\nहृष्टाः प्रमुदिताश्चासन् वारुणीग्रहणात् सुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000045039, "chapter_id": 9045, "verse_number": "१-४५-३९", "content_sanskrit": "उच्चैःश्रवा हयश्रेष्ठो मणिरत्नं च कौस्तुभम्।\nउदतिष्ठन्नरश्रेष्ठ तथैवामृतमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000045040, "chapter_id": 9045, "verse_number": "१-४५-४०", "content_sanskrit": "अथ तस्य कृते राम महानासीत् कुलक्षयः।\nअदितेस्तु ततः पुत्रा दितिपुत्रानयोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000045041, "chapter_id": 9045, "verse_number": "१-४५-४१", "content_sanskrit": "एकतामगमन् सर्वे असुरा राक्षसैः सह।\nयुद्धमासीन्महाघोरं वीर त्रैलोक्यमोहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000045042, "chapter_id": 9045, "verse_number": "१-४५-४२", "content_sanskrit": "यदा क्षयं गतं सर्वं तदा विष्णुर्महाबलः।\nअमृतं सोऽहरत् तूर्णं मायामास्थाय मोहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000045043, "chapter_id": 9045, "verse_number": "१-४५-४३", "content_sanskrit": "ये गताभिमुखं विष्णुमक्षरं पुरुषोत्तमम्।\nसम्पिष्टास्ते तदा युद्धे विष्णुना प्रभविष्णुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000045044, "chapter_id": 9045, "verse_number": "१-४५-४४", "content_sanskrit": "अदितेरात्मजा वीरा दितेः पुत्रान् निजघ्निरे।\nअस्मिन् घोरे महायुद्धे दैतेयादित्ययोर्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000045045, "chapter_id": 9045, "verse_number": "१-४५-४५", "content_sanskrit": "निहत्य दितिपुत्रांस्तु राज्यं प्राप्य पुरंदरः।\nशशास मुदितो लोकान् सर्षिसङ्घान् सचारणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000045046, "chapter_id": 9045, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे पञ्चचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]