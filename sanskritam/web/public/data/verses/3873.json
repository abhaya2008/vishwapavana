[{"id": 2133175, "chapter_id": 3873, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133176, "chapter_id": 3873, "verse_number": "१", "content_sanskrit": "चिन्तयित्वा तदाश्चर्यं स्त्रिया प्रोक्तमशेषतः ।\nविनिन्दन् स स्वमात्मानमागस्कृत इवाबभौ \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133177, "chapter_id": 3873, "verse_number": "२", "content_sanskrit": "चिन्तयानः स्वधर्मस्य सूक्ष्मं गतिमवाप्नुयात् ।\nश्रद्दधानेन वै भाव्यं गच्छामि मिथिलामहम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133178, "chapter_id": 3873, "verse_number": "३", "content_sanskrit": "कृतात्मा धर्मवित् तस्यां व्याधो निवसते किल ।\nतं गच्छाम्यहमद्यैव धर्मं प्रष्टुं तपोधनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133179, "chapter_id": 3873, "verse_number": "समाप्तिः", "content_sanskrit": "इति सञ्चित्य मनसा श्रद्दधानः स्त्रिया वचः ।\nबलाकाप्रत्ययेनासौ धर्म्यैश्च वचनैः शुभैः ।\nसम्प्रतस्थे स मिथिलां कौतूहलसमन्वितः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133180, "chapter_id": 3873, "verse_number": "५", "content_sanskrit": "अतिक्रामन्नरण्यानि ग्रामांश्च नगराणि च ।\nततो जगाम मिथिलां जनकेन सुरक्षिताम् ।\nधर्मसेतुसमाकीर्णां यज्ञोत्सववतीं शुभाम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133181, "chapter_id": 3873, "verse_number": "६", "content_sanskrit": "गोपुराट्टालकवतीं हर्म्यप्राकारशोभनाम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133182, "chapter_id": 3873, "verse_number": "७", "content_sanskrit": "प्रविश्य नगरीं रम्यां विमानैर्बहुभिर्युताम् ।\nपुष्पैश्च(पण्यैश्च) बहुभिर्युक्तां सुविभक्तमहापथाम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133183, "chapter_id": 3873, "verse_number": "८", "content_sanskrit": "अश्वै रथैस्तथा यानै(नागै)र्योधैश्च बहुभिर्युताम् ।\nहृष्टपुष्टजनाकीर्णां नित्योत्सवसमाकुलाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133184, "chapter_id": 3873, "verse_number": "९", "content_sanskrit": "सोऽपश्यद् बहुवृत्तान्तां ब्राह्मणः समतिक्रमन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133185, "chapter_id": 3873, "verse_number": "१०", "content_sanskrit": "धर्मव्याधमपृच्छच्च स चास्य कथितो द्विजैः ।\nअपश्यत् तत्र गत्वा तं सूनामध्ये व्यवस्थितम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133186, "chapter_id": 3873, "verse_number": "११", "content_sanskrit": "मार्गमाहिषमांसानि विक्रीणन्तं तपस्विनम् ।\nआकुलत्वात् तु सेतूनामेकान्ते संस्थितो द्विजः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133187, "chapter_id": 3873, "verse_number": "१२", "content_sanskrit": "स तु ज्ञात्वा द्विजं प्राप्तं सहसा सम्भ्रमोत्थितः ।\nआजगाम यतो विप्रः स्थित एकान्तआसने\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133188, "chapter_id": 3873, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133189, "chapter_id": 3873, "verse_number": "१३", "content_sanskrit": "अभिवादये त्वां भगवन् स्वागतं ते द्विजोत्तम ।\nअहं व्याधो हि भद्रं ते किं करोमि प्रशाधि माम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133190, "chapter_id": 3873, "verse_number": "१४", "content_sanskrit": "एकपत्न्या यदुक्तोऽसि गच्छ त्वं मिथिलामिति ।\nजानाम्येतदहं सर्वं यदर्थं त्वमिहागतः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133191, "chapter_id": 3873, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133192, "chapter_id": 3873, "verse_number": "१५", "content_sanskrit": "श्रुत्वा च तस्य तद्वाक्यं स विप्रो भृशविस्मितः ।\nद्वितीयमिदमाश्चर्यमित्यचिन्तयत द्विजः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133193, "chapter_id": 3873, "verse_number": "", "content_sanskrit": "अदेशस्थं हि ते स्थानमिति व्याधोऽब्रवीदिदम् ।\nगृहं गच्छाव भगवन् यदि ते रोचतेऽनघ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133194, "chapter_id": 3873, "verse_number": "", "content_sanskrit": "मार्कण्डेय उवच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133195, "chapter_id": 3873, "verse_number": "१६", "content_sanskrit": "बाढमित्येव तं विप्रो हृष्टो वचनमब्रवीत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133196, "chapter_id": 3873, "verse_number": "१७", "content_sanskrit": "अग्रतस्तु द्विजं कृत्वा स जगाम गृहं प्रति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133197, "chapter_id": 3873, "verse_number": "१८", "content_sanskrit": "प्रविश्य च गृहं रम्यमासनेनाभिपूजितः ।\nअर्घ्येण च स वै तेन व्याधेन द्विजसत्तमः ।\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133198, "chapter_id": 3873, "verse_number": "१९", "content_sanskrit": "पाद्यमाचमनीयञ्च प्रतिगृह्य द्विजोत्तमः ।\nततः सुखोपविष्टस्तं व्याधं वचनमब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133199, "chapter_id": 3873, "verse_number": "२०", "content_sanskrit": "कर्मैतद् वै न सदृशं भवतः प्रतिभाति मे ।\nअनुतप्ये भृशं तात तव घोरेण कर्मणा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133200, "chapter_id": 3873, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133201, "chapter_id": 3873, "verse_number": "२१", "content_sanskrit": "कुलोचितमिदं कर्म पितृपैतामहं परम् ।\nवर्तमानस्य मे धर्मे स्वे मन्युं मा कृथा द्विज \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133202, "chapter_id": 3873, "verse_number": "२२", "content_sanskrit": "विधात्रा विहितं पूर्वं कर्म स्वमनुपालयन् ।\nप्रयत्नाच्च गुरू वृद्धौ शुश्रूषेऽहं द्विजोत्तम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133203, "chapter_id": 3873, "verse_number": "२३", "content_sanskrit": "सत्यं वदे नाभ्यसूये यथाशक्ति ददामि च ।\nदेवतातिथिभृत्यानामवशिष्टेन वर्तये\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133204, "chapter_id": 3873, "verse_number": "२४", "content_sanskrit": "न कुत्सयाम्यहं किञ्चिन्न गर्हे बलवत्तरम् ।\nकृतमन्वेति कर्तारं पुरा कर्म द्विजोत्तम\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133205, "chapter_id": 3873, "verse_number": "२५", "content_sanskrit": "कृषिगोरक्ष्यवाणिज्यमिह लोकस्य जीवनम् ।\nदण्डनीतिस्त्रयी विद्या तेन लोको भवत्युत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133206, "chapter_id": 3873, "verse_number": "२६", "content_sanskrit": "कर्म शूद्रे कृषिर्वैश्ये सङ्ग्रामः क्षत्रिये स्मृतः ।\nब्रह्मचर्यं तपो मन्त्राः सत्यं च ब्राह्मणे सदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133207, "chapter_id": 3873, "verse_number": "२७", "content_sanskrit": "राजा प्रशास्ति धर्मेण स्वकर्मनिरताः प्रजाः ।\nविकर्माणश्च ये केचित् तान्युनक्ति स्वकर्मसु\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2133208, "chapter_id": 3873, "verse_number": "२८", "content_sanskrit": "भेतव्यं हि सदा राज्ञः प्रजानामधिपा हि ते ।\nवारयन्ति विकर्मस्थं नृपा मृगमिवेषुभिः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2133209, "chapter_id": 3873, "verse_number": "२९", "content_sanskrit": "जनकस्येह विप्रर्षे विकर्मस्थो न विद्यते ।\nस्वकर्मनिरता वर्णाश्चत्वारोऽपि द्विजोत्तम\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2133210, "chapter_id": 3873, "verse_number": "३०", "content_sanskrit": "स एष जनको राजा दुर्वृत्तमपि चेत् सुतम् ।\nदण्ड्यं दण्डे निक्षिपति तथा न ग्लाति धार्मिकम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2133211, "chapter_id": 3873, "verse_number": "३१", "content_sanskrit": "सुयुक्तचारो नृपतिः सर्वं धर्मेण पश्यति ।\nश्रीश्च राज्यं च दण्डश्च क्षत्रियाणां द्विजोत्तम \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2133212, "chapter_id": 3873, "verse_number": "३२", "content_sanskrit": "राजानो हि स्वधर्मेण श्रियमिच्छन्ति भूयसीम् ।\nसर्वेषामेव वर्णानां त्राता राजा भवत्युत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2133213, "chapter_id": 3873, "verse_number": "३३", "content_sanskrit": "परेण हि हतान् ब्रह्मन् वराहमहिषानहम् ।\nन स्वयं हन्मि विप्रर्षे विक्रीणामि सदा त्वहम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2133214, "chapter_id": 3873, "verse_number": "३४", "content_sanskrit": "न भक्षयामि मांसानि ऋतुगामी तथा ह्यहम् ।\nसदोपवासी च तथा नक्तभोजी सदा द्विज\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2133215, "chapter_id": 3873, "verse_number": "३५", "content_sanskrit": "अशीलश्चापि पुरुषो भूत्वा भवति शीलवान् ।\nप्राणिहिंसारतश्चापि भवते धार्मिकः पुनः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2133216, "chapter_id": 3873, "verse_number": "३६", "content_sanskrit": "व्यभिचारान्नरेन्द्राणां धर्मः सङ्कीर्यते महान् ।\nअधर्मो वर्धते चापि सङ्कीर्यन्ते ततः प्रजाः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2133217, "chapter_id": 3873, "verse_number": "३७", "content_sanskrit": "कुरुण्डा वामनाः कुब्जाः स्थूलशीर्षास्तथैव च ।\nक्लीबाश्चान्धाश्च बधिरा जायन्ते लम्बचूचुकाः ।\nपार्थिवानामधर्मत्वात् प्रजानामभवः सदा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2133218, "chapter_id": 3873, "verse_number": "३८", "content_sanskrit": "स एष राजा जनकः प्रजा धर्मेण पश्यति\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2133219, "chapter_id": 3873, "verse_number": "३९", "content_sanskrit": "अनुगृह्णन् प्रजाः सर्वा स्वधर्मनिरताः सदा ।\nपात्येव राजा जनकः पितृवद् द्विजसत्तम\t॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2133220, "chapter_id": 3873, "verse_number": "४०", "content_sanskrit": "ये चैव मां प्रशंसन्ति ये च निन्दन्ति मानवाः ।\nसर्वासु परिणीतेन कर्मणा तोषयाम्यहम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2133221, "chapter_id": 3873, "verse_number": "४१", "content_sanskrit": "ये जीवन्ति स्वधर्मेण संयुञ्जन्ते च पार्थिवाः ।\nन किञ्चिदुपजीवन्ति दान्ता उत्थानशीलिनः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2133222, "chapter_id": 3873, "verse_number": "४२", "content_sanskrit": "शक्त्याऽन्नदानं सततं तितिक्षा धर्मनित्यता ।\nयथार्हं प्रतिपूजा च सर्वभूतेषु वै सदा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2133223, "chapter_id": 3873, "verse_number": "४३", "content_sanskrit": "त्यागान्नान्यत्र मर्त्यानां गुणास्तिष्ठन्ति पूरुषे ।\nमृषावादं परिहरेत् कुर्यात् प्रियमयाचितः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2133224, "chapter_id": 3873, "verse_number": "४४", "content_sanskrit": "न च कामान्न संरम्भान्न द्वेषाद् धर्ममुत्सृजेत् ।\nप्रिये नातिभृशं हृष्येदप्रिये न च सञ्ज्वरेत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2133225, "chapter_id": 3873, "verse_number": "४५", "content_sanskrit": "न मुह्येदर्थकृच्छ्रेषु न च धर्मं परित्यजेत् ।\nकर्म चेत् किञ्चिदन्यत्स्यादितरन्न तदाचरेत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2133226, "chapter_id": 3873, "verse_number": "४६", "content_sanskrit": "यत्कल्याणमभिध्यायेत् तत्रात्मानं नियोजयेत् ।\nन पापे प्रतिपापः स्यात्साधुरेव सदा भवेत् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2133227, "chapter_id": 3873, "verse_number": "४७", "content_sanskrit": "आत्मनैव हतः पापो यः पापं कर्तुमिच्छति ।\nकर्म चैतदसाधूनां वृजिनं नाम साधुवत् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2133228, "chapter_id": 3873, "verse_number": "४८", "content_sanskrit": "न धर्मोऽस्तीति मन्वानाः शुचीनवहसन्ति ये ।\nअश्रद्दधन्तो धर्मस्य ते नश्यन्ति न संशयः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2133229, "chapter_id": 3873, "verse_number": "४९", "content_sanskrit": "महाधृतिरिवाध्मातुः पापो भवति नित्यदा ।\nसाधुः सन्नतिमानेषु सर्वत्र द्विजसत्तम\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2133230, "chapter_id": 3873, "verse_number": "५०", "content_sanskrit": "मूढानामवलिप्तानामसारं भावितं भवेत्।\nदर्शयत्यन्तरात्मानं दिवा रूपमिवांशुमान्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2133231, "chapter_id": 3873, "verse_number": "५१", "content_sanskrit": "न लोके राजते मूर्खः केवलात्मप्रशंसया ।\nअपि चेह प्रजाहीनः कृतविद्यः प्रकाशते\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2133232, "chapter_id": 3873, "verse_number": "५२", "content_sanskrit": "अब्रुवन् कस्यचिन्निन्दामात्मपूजामवर्णयन् ।\nन कश्चिद् गुणसम्पन्नः प्रकाशो भुवि दृश्यते\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2133233, "chapter_id": 3873, "verse_number": "५३", "content_sanskrit": "विकर्मणा तप्यमानः पापाद् विपरिमुच्यते ।\nन तत् कुर्यां पुनरिति द्वितीयात् परिमुच्यते ।\nकरिष्ये धर्ममेवेति तृतीयात् परिमुच्यते \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2133234, "chapter_id": 3873, "verse_number": "५४", "content_sanskrit": "कर्मणा येन केनेह पापात्मा द्विजसत्तम ।\nएवं श्रुतिरियं ब्रह्मन् धर्मेषु प्रतिदृश्यते\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2133235, "chapter_id": 3873, "verse_number": "५५", "content_sanskrit": "पापान्यबुद्ध्वेह पुरा कृतानि\nप्राग् धर्मशीलोऽपि विहन्ति पश्चात् ।\nधर्मो ब्रह्मन् नुदते पूरुषाणां\nयत् कुर्वते पापमिह प्रमादात्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2133236, "chapter_id": 3873, "verse_number": "५६", "content_sanskrit": "पापं कृत्वा हि मन्येत नाहमस्मीति पूरुषः ।\nचिकीर्षेदेव कल्याणं श्रद्दधानोऽनसूयकः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2133237, "chapter_id": 3873, "verse_number": "५७", "content_sanskrit": "वसनस्येव छिद्राणि साधूनां विवृणोति यः ।\nअपश्यन्नात्मनो दोषान् स पापः प्रेत्य नश्यति\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2133238, "chapter_id": 3873, "verse_number": "५८", "content_sanskrit": "पापं चेत् पुरुषः कृत्वा कल्याणमभिपद्यते ।\nमुच्यते सर्वपापेभ्यो महाभ्रेणेव चन्द्रमाः \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2133239, "chapter_id": 3873, "verse_number": "५९", "content_sanskrit": "यथाऽऽदित्यः समुद्यन् वै तमः पूर्वं व्यपोहति ।\nएवं कल्याणमातिष्ठन् सर्वपापैः प्रमुच्यते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2133240, "chapter_id": 3873, "verse_number": "६०", "content_sanskrit": "पापानां विद्ध्यधिष्ठानं लोभमेव द्विजोत्तम ।\nतस्मात् तौ विदुषा विप्र वर्जनीयौ विशेषतः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2133241, "chapter_id": 3873, "verse_number": "६१", "content_sanskrit": "लुब्धाः पापं व्यवस्यन्ति नरा नातिबहुश्रुताः ।\nअधर्मा धर्मरूपेण तृणैः कूपा इवावृताः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2133242, "chapter_id": 3873, "verse_number": "६२", "content_sanskrit": "येषां पञ्च पवित्राणि प्रलापा धर्मसंश्रिताः ।\nसर्वं हि विद्यते तेषु शिष्टाचारः सुदुर्लभः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2133243, "chapter_id": 3873, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2133244, "chapter_id": 3873, "verse_number": "६३", "content_sanskrit": "स तु विप्रो महाप्राज्ञो धर्मव्याधमपृच्छत ।\nशिष्टाचारं कथमहं विद्यामिति नरोत्तम\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2133245, "chapter_id": 3873, "verse_number": "६४", "content_sanskrit": "पञ्च कानि पवित्राणि शिष्टाचारेषु नित्यदा ।\nत्वत्तो महामते व्याध तद् ब्रवीहि यथातथम् \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2133246, "chapter_id": 3873, "verse_number": "", "content_sanskrit": "व्याधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2133247, "chapter_id": 3873, "verse_number": "६५", "content_sanskrit": "यज्ञो दानं तपो वेदाः सत्यं च द्विजसत्तम ।\nपञ्चैतानि पवित्राणि शिष्टाचारेषु सर्वदा\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2133248, "chapter_id": 3873, "verse_number": "६६", "content_sanskrit": "कामक्रोधौ वशे कृत्वा दम्भं लोभमनार्जवम् ।\nधर्म इत्येव सन्तुष्टास्ते शिष्टाः शिष्टसम्मताः \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2133249, "chapter_id": 3873, "verse_number": "६७", "content_sanskrit": "न तेषां विद्यतेऽवृत्तं यज्ञस्वाध्यायशीलिनाम् ।\nआचारपालनं चैव द्वितीयं शिष्टलक्षणम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2133250, "chapter_id": 3873, "verse_number": "६८", "content_sanskrit": "गुरुशुश्रूषणं सत्यमक्रोधो दानमेव च ।\nएतच्चतुष्टयं ब्रह्मन् शिष्टाचारेषु नित्यदा\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2133251, "chapter_id": 3873, "verse_number": "६९", "content_sanskrit": "शिष्टाचारे मनः कृत्वा प्रतिष्ठाप्य च सर्वशः ।\nयामयं लभते वृत्तिं सा न शक्या ह्यतोऽन्यथा\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2133252, "chapter_id": 3873, "verse_number": "७०", "content_sanskrit": "वेदस्योपनिषत्सत्यं सत्यस्योपनिषद् दमः ।\nदमस्योपनिषत् त्यागः शिष्टाचारेषु नित्यदा\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2133253, "chapter_id": 3873, "verse_number": "७१", "content_sanskrit": "ये तु धर्मानसूयन्ते बुद्धिमोहान्विता नराः ।\nअपथा गच्छतां तेषामनुयाता च पीड्यते\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2133254, "chapter_id": 3873, "verse_number": "७२", "content_sanskrit": "ये तु शिष्टाः सुनियताः श्रुतित्यागपरायणाः ।\nधर्मपन्थानमारूढाः सत्यधर्मपरायणाः \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2133255, "chapter_id": 3873, "verse_number": "७३", "content_sanskrit": "नियच्छन्ति परां बुद्धिं शिष्टाचारान्विता जनाः ।\nउपाध्यायमते युक्ताः स्थित्या धर्मार्थदर्शिनः \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2133256, "chapter_id": 3873, "verse_number": "७४", "content_sanskrit": "नास्तिकान् भिन्नमर्यादान् क्रूरान् पापमतौ स्थितान् ।\nत्यज तान् ज्ञानमाश्रित्य धार्मिकानुपसेव्य च \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2133257, "chapter_id": 3873, "verse_number": "७५", "content_sanskrit": "कामलोभग्रहाकीर्णां पञ्चेन्द्रियजलां नदीम् ।\nनावं धृतिमयीं कृत्वा जन्मदुर्गाणि सन्तर \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2133258, "chapter_id": 3873, "verse_number": "७६", "content_sanskrit": "क्रमेण सञ्चितो धर्मो बुद्धियोगमयो महान् ।\nशिष्टाचारे भवेत् साधू रागः शुक्लेव वाससि\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2133259, "chapter_id": 3873, "verse_number": "७७", "content_sanskrit": "अहिंसा सत्यवचनं सर्वभूतहितं परम् ।\nअहिंसा परमो धर्मः स च सत्ये प्रतिष्ठितः \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2133260, "chapter_id": 3873, "verse_number": "७८", "content_sanskrit": "सत्ये कृत्वा प्रतिष्ठां तु प्रवर्तन्ते प्रवृत्तयः ।\nसत्यमेव गरीयस्तु शिष्टाचारनिषेवितम् ।\nआचारश्च सतां धर्मः सन्तश्चाचारलक्षणाः \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2133261, "chapter_id": 3873, "verse_number": "७९", "content_sanskrit": "यो यथाप्रकृतिर्जन्तुः स स्वां प्रकृतिमश्नुते ।\nपापात्मा क्रोधकामादीन् दोषानाप्नोत्यनात्मवान्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2133262, "chapter_id": 3873, "verse_number": "८०", "content_sanskrit": "आरम्भो न्याययुक्तो यः स हि धर्म इति स्मृतः ।\nअनाचारस्त्वधर्मेति एतच्छिष्टानुशासनम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2133263, "chapter_id": 3873, "verse_number": "८१", "content_sanskrit": "अक्रुद्ध्यन्तोऽनसूयन्तो निरहङ्कारमत्सराः ।\nऋजवः शमसम्पन्नाः शिष्टाचारा भवन्ति ते\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2133264, "chapter_id": 3873, "verse_number": "८२", "content_sanskrit": "त्रैविद्यवृद्धाः शुचयो वृत्तवन्तो मनस्विनः ।\nगुरुशुश्रूषवो दान्ताः शिष्टाचारा भवन्त्युत\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2133265, "chapter_id": 3873, "verse_number": "८३", "content_sanskrit": "तेषामदीनसत्त्वानां दुष्कराचारकर्मणाम् ।\nस्वैः कर्मभिः सत्कृतानां घोरत्वं सम्प्रणश्यति\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2133266, "chapter_id": 3873, "verse_number": "८४", "content_sanskrit": "तं सदाचारमाश्चर्यं पुराणं शाश्वतं ध्रुवम् ।\nधर्मं धर्मेण पश्यन्तः स्वर्गं यान्ति मनीषिणः \t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2133267, "chapter_id": 3873, "verse_number": "८५", "content_sanskrit": "आस्तिका मानहीनाश्च द्विजातिजनपूजकाः ।\nश्रुतवृत्तोपसम्पन्नाः सन्तः स्वर्गनिवासिनः \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2133268, "chapter_id": 3873, "verse_number": "८६", "content_sanskrit": "वेदोक्तः परमो धर्मो धर्मशास्त्रेषु चापरः ।\nशिष्टाचारश्च शिष्टानां त्रिविधं धर्मलक्षणम्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2133269, "chapter_id": 3873, "verse_number": "८७", "content_sanskrit": "पा(धा)रणं चापि विद्यानां तीर्थानामवगाहनम् ।\nक्षमा सत्यार्जवं शौचं सतामाचारदर्शनम्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2133270, "chapter_id": 3873, "verse_number": "८८", "content_sanskrit": "सर्वभूतदयावन्तो अहिंसानिरताः सदा ।\nपरुषं च न भाषन्ते सदा सन्तो द्विजप्रियाः \t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2133271, "chapter_id": 3873, "verse_number": "८९", "content_sanskrit": "शुभानामशुभानां च कर्मणां फलसञ्चये ।\nविपाकमभिजानन्ति ते शिष्टाः शिष्टसम्मताः \t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2133272, "chapter_id": 3873, "verse_number": "९०", "content_sanskrit": "न्यायोपेता गुणोपेताः सर्वलोकहितैषिणः ।\nसन्तः स्वर्गजितः शुक्लाः सन्निविष्टाश्च सत्पथे\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2133273, "chapter_id": 3873, "verse_number": "९१", "content_sanskrit": "दातारः संविभक्तारो दीनानुग्रहकारिणः ।\nसर्वभूतदयावन्तस्ते शिष्टाः शिष्टसम्मताः । \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2133274, "chapter_id": 3873, "verse_number": "९२", "content_sanskrit": "सर्वपूज्याः श्रुतधनास्तथैव च तपस्विनः ।\nदानशिष्टाः सुखाँल्लोकानाप्नुवन्तीह च श्रियम्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2133275, "chapter_id": 3873, "verse_number": "९३", "content_sanskrit": "पीडया च कळत्रस्य भृत्यानां च समाहिताः ।\nअतिशक्त्या प्रयच्छन्ति सन्तः सद्भिः समागताः \t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2133276, "chapter_id": 3873, "verse_number": "९४", "content_sanskrit": "एवं सन्तो वर्तमानास्त्वेधन्ते शाश्वतीः समाः \t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2133277, "chapter_id": 3873, "verse_number": "९५", "content_sanskrit": "अहिंसा सत्यवचनमानृशंस्यमथार्जवम् ।\nअद्रोहो नाभिमानश्च ह्रीस्तितिक्षा दमः शमः \t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2133278, "chapter_id": 3873, "verse_number": "९६", "content_sanskrit": "धीमन्तो धृतिमन्तश्च भूतानामनुकम्पकाः ।\nअकामद्वेषसंयुक्तास्ते सन्तो लोकसाक्षिणः \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2133279, "chapter_id": 3873, "verse_number": "९७", "content_sanskrit": "न चैव द्रुह्येद् दद्याच्च सत्यं चैव सदा वदेत्\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2133280, "chapter_id": 3873, "verse_number": "९८", "content_sanskrit": "सर्वत्र च दयावन्तः सन्तः करुणवेदिनः\nगच्छन्तीह सुसन्तुष्टा धर्मपन्थानमुत्तमम्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2133281, "chapter_id": 3873, "verse_number": "९९", "content_sanskrit": "शिष्टाचारा महात्मानो येषां धर्मः सुनिश्चितः \t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2133282, "chapter_id": 3873, "verse_number": "१००", "content_sanskrit": "कामक्रोधपरित्यागः शिष्टाचारनिषेवणम्\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2133283, "chapter_id": 3873, "verse_number": "१०१", "content_sanskrit": "कर्म च श्रुतसम्पन्नं सतां मार्गमनुत्तमम् ।\nशिष्टाचारं निषेवन्ते नित्यं धर्ममनुव्रताः \t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2133284, "chapter_id": 3873, "verse_number": "१०२", "content_sanskrit": "प्रज्ञाप्रासादमारुह्य मुच्यन्ते महतो भयात् ।\nप्रेक्षन्तो लोकवृत्तानि विविधानि द्विजोत्तम । अतिपुण्यान्नदानानि तानि द्विजवरोत्तम\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2133285, "chapter_id": 3873, "verse_number": "१०३", "content_sanskrit": "एतत् ते सर्वमाख्यातं यथाप्रज्ञं यथाश्रुतम् ।\nशिष्टाचारगुणं ब्रह्मन्पुरस्कृत्य द्विजर्षभ\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2133286, "chapter_id": 3873, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि मार्कण्डेयसमास्यापर्वणि पतिव्रतोपाख्याने चतुर्नवत्यधिकशततमोध्यायः॥१९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2133287, "chapter_id": 3873, "verse_number": "१९", "content_sanskrit": "॥ मार्कण्डेयसमास्यापर्वणि एकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}]