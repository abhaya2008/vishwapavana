[{"id": 2063614, "chapter_id": 2354, "verse_number": "८-७५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063615, "chapter_id": 2354, "verse_number": "८-७५-१", "content_sanskrit": "इति स्म कृष्णवचनात्प्रत्युच्चार्य युधिष्ठिरम्।\nबभूव विमनाः पार्थः किञ्चित्कृत्वेव पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063616, "chapter_id": 2354, "verse_number": "८-७५-२", "content_sanskrit": "ततोऽब्रवीद्वासुदेवः प्रहसन्निव पाण्डवम्।\nकथं नाम भवेदेतद्यदि त्वं पार्थ धर्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063617, "chapter_id": 2354, "verse_number": "८-७५-३", "content_sanskrit": "असिना तीक्ष्णधारणे हन्या धर्मे व्यस्थितम्।\nत्वमित्युक्त्वाथ राजानमेवं कश्मलमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063618, "chapter_id": 2354, "verse_number": "८-७५-४", "content_sanskrit": "हत्वा तु नृपतिं पार्थ करिष्यसि किमुत्तरम्।\nएवं हि दुर्विदो धर्मो मन्दप्रज्ञैर्विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063619, "chapter_id": 2354, "verse_number": "८-७५-५", "content_sanskrit": "स भवान्धर्मभीरुत्वाद्धवं यायान्महत्तमः।\nनरकं घोररूपं च भ्रातुर्ज्येतुस्य वै वथात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063620, "chapter_id": 2354, "verse_number": "८-७५-६", "content_sanskrit": "स त्वं धर्मभृतां श्रेष्ठं राजानं धर्मसंहितम्।\nप्रसादय कुरुश्रेष्ठमेतदत्र मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063621, "chapter_id": 2354, "verse_number": "८-७५-७", "content_sanskrit": "प्रसाद्य भक्त्या राजानं प्रीते चैव युधिष्ठिरे।\nप्रयावस्त्वरितौ योद्धुं सूतपुत्ररथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063622, "chapter_id": 2354, "verse_number": "८-७५-८", "content_sanskrit": "हत्वा तु समरे कर्णं त्वमद्य निशितैः शरैः।\nविपुलां प्रीतिमाधत्स्व धर्मपुत्रस्य मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063623, "chapter_id": 2354, "verse_number": "८-७५-९", "content_sanskrit": "एतदत्र महाबाहो प्राप्तकालं मतं मम।\nएवं कृते कृतं चैव तव कार्यं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063624, "chapter_id": 2354, "verse_number": "८-७५-१०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063625, "chapter_id": 2354, "verse_number": "८-७५-१०", "content_sanskrit": "ततोऽर्जुनो महाराज लज्जपा वै समन्वितः।\nधर्तराजस्य चरणौ प्रपद्य शिरसा नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063626, "chapter_id": 2354, "verse_number": "८-७५-११", "content_sanskrit": "उवाच भरतश्रेष्ठं प्रसीदेति पुनः पुनः।\nक्षमस्व राजन्यत्प्रोक्तस्त्वं मया धर्मभीरुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063627, "chapter_id": 2354, "verse_number": "८-७५-१२", "content_sanskrit": "पादयोः पतितं दृष्ट्वा धर्मराजो युधिष्ठिरः।\nधनञ्जयममित्रघ्नं रुदन्तं भरतर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063628, "chapter_id": 2354, "verse_number": "८-७५-१३", "content_sanskrit": "उत्थाप्य भ्रातरं राजा धर्मराजो धनञ्जयम्।\nसमाश्लिष्य च सस्नेहं प्ररुरोद महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063629, "chapter_id": 2354, "verse_number": "८-७५-१४", "content_sanskrit": "रुदित्वा सुचिरं कालं भ्रातरौ सुमहाद्युती।\nकृतशौचौ महाराज प्रीतिमन्तौ बभूवतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063630, "chapter_id": 2354, "verse_number": "८-७५-१५", "content_sanskrit": "तत आश्लिष्य तं प्रेम्णा मूर्ध्नि चाघ्राय पाण्डवः।\nप्रीत्या परमया युक्तो विस्मयंश्च पुनःपुनः।\nअब्रवीत्तं महेष्वासं धर्मराजो धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063631, "chapter_id": 2354, "verse_number": "८-७५-१६", "content_sanskrit": "कर्णेन मे महाबाहो सर्वसैन्यस्य पश्यतः।\nकवचं च ध्वजं चैव धनुः शक्तिर्हयाः शराः।\nशरैः कृत्ता महेष्वास यतमानस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063632, "chapter_id": 2354, "verse_number": "८-७५-१७", "content_sanskrit": "सोऽहं दृष्ट्वा रणे तस्य कर्ण कर्णस्य फल्गुन।\nव्यवसीदामि दुःखेन न तु मे जीवितं प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063633, "chapter_id": 2354, "verse_number": "८-७५-१८", "content_sanskrit": "न चेदद्य हि तं वीरं निहनिष्यसि संयुगे।\nप्राणानेव परित्यक्ष्ये जीवितार्थो हि को मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063634, "chapter_id": 2354, "verse_number": "८-७५-१९", "content_sanskrit": "एवमुक्तः प्रत्युवाच विजयो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063635, "chapter_id": 2354, "verse_number": "८-७५-२०", "content_sanskrit": "सत्येन ते शपे राजंस्त्वत्पादेन तथैव च।\nभीमेन च नरश्रेष्ठ यमाभ्यां च महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063636, "chapter_id": 2354, "verse_number": "८-७५-२१", "content_sanskrit": "`अहमेनं नरश्रेष्ठ सामात्यं च महीपते।\nयथाद्य समरे कर्णं हनिष्यामि हतोपि वा।\nमहीतले पतिष्यामि सत्येनायुधमालभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063637, "chapter_id": 2354, "verse_number": "८-७५-२२", "content_sanskrit": "एवमाभाष्य राजानमब्रवीन्माधवं वचः।\nअद्य कर्णं रणे कृष्ण सूदयिष्ये न संशयः।\nत्वमनुध्याहि भद्रं ते वधं तस्य दुरात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063638, "chapter_id": 2354, "verse_number": "८-७५-२३", "content_sanskrit": "एवमुक्तोऽब्रवीत्पार्थं केशवो राजसत्तम।\nशक्तोऽसि भरतश्रेष्ठ यत्नं कर्तुं यदात्थ माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063639, "chapter_id": 2354, "verse_number": "८-७५-२४", "content_sanskrit": "एष चापि हि मे कामो नित्यमेव महारथ।\nकथं भवान्रणे कर्णं निहन्यादिति सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063640, "chapter_id": 2354, "verse_number": "८-७५-२५", "content_sanskrit": "एवमुक्तस्ततो राजन्पार्थो वचनमब्रवीत्।\nहन्यते द्वैरथे भूयो युज्यन्तां वै रथोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063641, "chapter_id": 2354, "verse_number": "८-७५-२६", "content_sanskrit": "उपावृत्ताश्च तुरगाः शिक्षिताश्चाश्वसादिभिः।\nरथोपकरणैः सर्वैः सत्वरं यातु मे रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063642, "chapter_id": 2354, "verse_number": "८-७५-२७", "content_sanskrit": "एवमुक्तो महाराज फल्गुनेन महात्मना।\nउवाच दारुकं कृष्णः कुरु सर्वं यदब्रवीत्।\nअर्जुनो भारतश्रेष्ठः श्रेष्ठः सर्वधनुष्मताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063643, "chapter_id": 2354, "verse_number": "८-७५-२८", "content_sanskrit": "आज्ञप्तस्त्वथ कृष्णेन दारुको राजसत्तम।\nयोजयामास च रथं वैयाघ्नं शत्रुतापनम्।\nसज्जं निवेदयामास पाण्डवस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063644, "chapter_id": 2354, "verse_number": "८-७५-२९", "content_sanskrit": "युक्तं तु रथमास्थाय दारुकेण महात्मना।\nउपस्थितं रथं दृष्ट्वा पद्मनाभो रणान्तकृत्।\nभूयश्चोवाच मतिमान्माधवो धर्मनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063645, "chapter_id": 2354, "verse_number": "८-७५-३०", "content_sanskrit": "युधिष्ठिरेमं बीभत्सुं त्वं सान्त्वयितुमर्हसि।\nअनुज्ञातुं च कर्णस्य वधायाद्य दुरात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063646, "chapter_id": 2354, "verse_number": "८-७५-३१", "content_sanskrit": "श्रुत्वा ह्यावां महासंख्ये त्वां कर्णशरपीडितम्।\nप्रवृत्तिं ज्ञातुमायाताविहावां पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063647, "chapter_id": 2354, "verse_number": "८-७५-३२", "content_sanskrit": "दिष्ट्यासि राजन्विरुजो दिष्ट्या न ग्रहणं गतः।\nपरिसान्त्वय बीभत्सुं जयमाशाधि चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063648, "chapter_id": 2354, "verse_number": "८-७५-३३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063649, "chapter_id": 2354, "verse_number": "८-७५-३३", "content_sanskrit": "एह्येहि पार्थ बीभत्सो मां परिष्वज पाण्डव।\nवक्तव्यमुक्तोस्म्यहितं त्वया क्षान्तं च तन्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063650, "chapter_id": 2354, "verse_number": "८-७५-३४", "content_sanskrit": "अहं त्वामनुजानामि जहि कर्णं धनञ्जय।\nमन्युं च मा कृथाः पार्थ यन्मयोक्तोऽसि दारुणं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063651, "chapter_id": 2354, "verse_number": "८-७५-३५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063652, "chapter_id": 2354, "verse_number": "८-७५-३५", "content_sanskrit": "ततो धनञ्जयो राजञ्शिरसा प्रणतस्तदा।\nपादौ जग्राह पाणिभ्यां भ्रातुर्ज्येष्ठस्य मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063653, "chapter_id": 2354, "verse_number": "८-७५-३६", "content_sanskrit": "तमुत्थाप्य ततो राजा परिष्वज्य च पीडितम्।\nमूर्ध्नुपाघ्राय चैवैनमिदं पुनरुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2063654, "chapter_id": 2354, "verse_number": "८-७५-३७", "content_sanskrit": "धनञ्जय महाबाहो मानितोऽस्मि दृढं त्वया।\nमाहात्म्यं विजयं चैवं भूयः प्राप्नुहि शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2063655, "chapter_id": 2354, "verse_number": "८-७५-३८x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2063656, "chapter_id": 2354, "verse_number": "८-७५-३८", "content_sanskrit": "अद्य तं पापकर्माणं सानुबन्धं रणे शरैः।\nनयाम्यन्तं समासाद्य राधेयं बलगर्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2063657, "chapter_id": 2354, "verse_number": "८-७५-३९", "content_sanskrit": "येन त्वं पीडितो बाणैर्दृढमायम्य कार्मुकम्।\nतस्याद्य कर्मणः कर्णः फलमाप्स्यति दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2063658, "chapter_id": 2354, "verse_number": "८-७५-४०", "content_sanskrit": "अद्य त्वामुपयास्यामि कर्णं हत्वा महीपते।\nसभाजये त्वामाक्रन्दादिति सत्यं ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2063659, "chapter_id": 2354, "verse_number": "८-७५-४१", "content_sanskrit": "नाहत्वा विनिषर्तिष्ये कर्णमद्य रणाजिरात्।\nइति सत्येन ते पादौ स्पृशामि जगतीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2063660, "chapter_id": 2354, "verse_number": "८-७५-४२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2063661, "chapter_id": 2354, "verse_number": "८-७५-४२", "content_sanskrit": "इति ब्रुवाणं सुमनाः किरीटिनं\nयुधिष्ठिरः प्राह वचो बृहत्तरम्।\nयशोऽक्षयं जीवितमीप्सितं ते\nजयं सदा वीर्यमरिक्षयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2063662, "chapter_id": 2354, "verse_number": "८-७५-४३", "content_sanskrit": "प्रयाहि वृद्धिं च दिशन्तु देवता\nयथाहमिच्छामि तवास्तु तत्तथा।\nप्रयाहि शीघ्रं जहि कर्णमाहवे\nपुरन्दरो वृत्रमिवात्मवृद्वये॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2063663, "chapter_id": 2354, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे पञ्चसप्ततितमोऽध्यायः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]