[{"id": 2101322, "chapter_id": 3182, "verse_number": "१४-३८-१", "content_sanskrit": "ब्रह्मोवाच।\nरजोऽहं वः प्रवक्ष्यामि याथातथ्येन सत्तमाः।\nनिबोधत महाभागा गुणवृत्तं च राजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101323, "chapter_id": 3182, "verse_number": "१४-३८-२", "content_sanskrit": "संतापो रूपमायासः सुखदुःखे हिमातपौ।\nऐश्वर्यं विग्रहः सिद्धिर्हेतुवादोऽरतिः क्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101324, "chapter_id": 3182, "verse_number": "१४-३८-३", "content_sanskrit": "बलं शौर्यं मदो रोषो व्यायामकलहावपि।\nईर्ष्येप्सा पैशुनं युद्धं ममत्वं परिपालनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101325, "chapter_id": 3182, "verse_number": "१४-३८-४", "content_sanskrit": "वधबन्धपरिक्लेशाः क्रयो विक्रय एव च।\nनिकृन्त च्छिन्धि भिन्धीति परवर्मावकर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101326, "chapter_id": 3182, "verse_number": "१४-३८-५", "content_sanskrit": "उग्रं दारुणमाक्रोशः परवित्तानुरागिता।\nलोकचिन्ताऽनुचिन्ता च मत्सरः परिभाषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101327, "chapter_id": 3182, "verse_number": "१४-३८-६", "content_sanskrit": "वृथाशास्त्रं मृषावादो विकल्पपरिभाषणम्।\nनिन्दा स्तुतिः प्रशंसा च प्रतापः परिधर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101328, "chapter_id": 3182, "verse_number": "१४-३८-७", "content_sanskrit": "परिचर्या च शुश्रूषा सेवा तृष्णा व्यपाश्रयः॥\nव्यूहो नयः प्रमादश्च परिवादः परिग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101329, "chapter_id": 3182, "verse_number": "१४-३८-८", "content_sanskrit": "संस्कारा ये च लोकेषु प्रवर्तन्ते पृथक्पृथक्।\nनृषु नारीषु भूतेषु द्रव्येषु शरणेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101330, "chapter_id": 3182, "verse_number": "१४-३८-९", "content_sanskrit": "संतापोऽप्रत्ययश्चैव व्रतानि नियमाश्च ये।\nप्रधानमाशीर्युक्तं च सततं मे भवत्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101331, "chapter_id": 3182, "verse_number": "१४-३८-१०", "content_sanskrit": "स्वाहाकारो नमस्कारः स्वधाकारो वषट्क्रिया।\nयाजनाध्यापने चोभे यजनाध्ययने अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101332, "chapter_id": 3182, "verse_number": "१४-३८-११", "content_sanskrit": "दानं प्रतिग्रहश्चैव प्रायश्चित्तानि मङ्गलम्।\nइदं मे स्यादिदं मे स्यात्स्नेहो गुणसमुद्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101333, "chapter_id": 3182, "verse_number": "१४-३८-१२", "content_sanskrit": "अभिद्रोहस्तथा माया निकृतिर्मान एव च।\nस्तैन्यं हिंसा जुगुप्सा च परितापः प्रजागरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101334, "chapter_id": 3182, "verse_number": "१४-३८-१३", "content_sanskrit": "दम्भो दर्पोऽथ रागश्च भक्तिः प्रीतिः प्रमोदनम्।\nद्यूतं च जनवादश्च सम्बन्धाः स्त्रीकृताश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101335, "chapter_id": 3182, "verse_number": "१४-३८-१४", "content_sanskrit": "नृत्यवादित्रगीतानां प्रसङ्गा ये च केचन।\nसर्व एते गुणा विप्रा राजसाः सम्प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101336, "chapter_id": 3182, "verse_number": "१४-३८-१५", "content_sanskrit": "भूतभव्यभविष्याणां भावानां भुवि भावनाः।\nत्रिवर्गनिरता नित्यं धर्मोऽर्थः काम इत्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101337, "chapter_id": 3182, "verse_number": "१४-३८-१६", "content_sanskrit": "कामवृत्ताः प्रमोदन्ते सर्वकामसमृद्धिभिः।\nअर्वाक्स्रोतस इत्येते मनुष्या रजसा वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101338, "chapter_id": 3182, "verse_number": "१४-३८-१७", "content_sanskrit": "अस्मिँलोके प्रमोदन्ते जायमानाः पुनःपनः।\nप्रेत्यभाविकमीहन्ते हलौकिकमेव च।\nददति प्रतिगृह्णन्ति तर्पयन्त्यथ जुह्वति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101339, "chapter_id": 3182, "verse_number": "१४-३८-१८", "content_sanskrit": "रजोगुणा वो बहुधानुकीर्तिता\nयथावदुक्तं गुणवृत्तमेव च।\nनरोपि यो वेद गुणानिमान्सदा\nस राजसैः सर्वगुणैर्विमुच्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101340, "chapter_id": 3182, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि अष्टत्रिंशोऽध्यायः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]