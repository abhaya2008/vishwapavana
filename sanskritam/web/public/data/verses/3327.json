[{"id": 2107819, "chapter_id": 3327, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2107820, "chapter_id": 3327, "verse_number": "१", "content_sanskrit": "अग्नेरथ वचः श्रुत्वा तद् रक्षः प्रजहार ताम् ।\nब्रह्मन् वराहरूपेण मनोमारुतरंहसा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2107821, "chapter_id": 3327, "verse_number": "२", "content_sanskrit": "निवसंश्चैव तत्कुक्षौ स वै भृगुकुलोद्वहः ।\nरोषान्मातुश्च्युतः कुक्षेश्च्यवनस्तेन सोऽभवत्\t ॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2107822, "chapter_id": 3327, "verse_number": "३", "content_sanskrit": "तं दृष्ट्वा मातुरुदराच्च्युतमादित्यवर्चसम् ।\nतद् रक्षो भस्मसाद् भूतं पपात परिमुच्य ताम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2107823, "chapter_id": 3327, "verse_number": "४", "content_sanskrit": "सा तमादाय सुश्रोणी ससार भृगुनन्दनम् ।\nच्यवनं भार्गवं ब्रह्मन् पुलोमा दुःखमूर्च्छिता \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2107824, "chapter_id": 3327, "verse_number": "५", "content_sanskrit": "तां ददर्श स्वयं ब्रह्मा सर्वलोकपितामहः ।\nरुदन्तीं बाष्पपूर्णाक्षीं भृगोर्भार्यामनिन्दिताम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2107825, "chapter_id": 3327, "verse_number": "६", "content_sanskrit": "सान्त्वयामास भगवान् वधूं ब्रह्मा पितामहः ।\nअश्रुबिन्दूद्भवा तस्याः प्रावर्तत महानदी \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2107826, "chapter_id": 3327, "verse_number": "७", "content_sanskrit": "अनुवर्त्म सृता तस्या भृगोः पत्न्या यशस्विनः ।\nतस्या मार्गं द्रुतवतीं दृष्ट्वा तु सरितं तदा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2107827, "chapter_id": 3327, "verse_number": "८", "content_sanskrit": "नाम तस्यास्तदा नद्याश्चक्रे लोकपितामहः\nवधूसरेति भगवान् च्यवनस्याश्रमं प्रति \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2107828, "chapter_id": 3327, "verse_number": "९", "content_sanskrit": "स एष च्यवनो जज्ञे भृगोः पुत्रः प्रतापवान् ।\nतं ददर्श पिता तत्र च्यवनं तां च भामिनीम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2107829, "chapter_id": 3327, "verse_number": "१०", "content_sanskrit": "स पुलोमां ततो भार्यां पप्रच्छ कुपितो भृगुः ।\nकेनासि रक्षसे तस्मै कथितेह जिहीर्षवे \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2107830, "chapter_id": 3327, "verse_number": "११", "content_sanskrit": "न हि त्वां वेद तद्रक्षो मद्भार्यां चारुहासिनीम् ।\nतत्त्वमाख्याहि तं ह्यद्य शप्तुमिच्छाम्यहं रुषा ।\nबिभेति को न शापान्मे कस्य चाऽयं व्यतिक्रमः\t ॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2107831, "chapter_id": 3327, "verse_number": "", "content_sanskrit": "पुलोमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2107832, "chapter_id": 3327, "verse_number": "१२", "content_sanskrit": "अग्निना भगवंस्तस्मै रक्षसेऽहं निवेदिता ।\nततो मामनयद् रक्षः क्रोशन्तीं कुररीमिव \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2107833, "chapter_id": 3327, "verse_number": "१३", "content_sanskrit": "साऽहं तव सुतस्यास्य तेजसाऽथापि मोक्षिता ।\nभस्मीभूतं तु तद्रक्षो मामुत्सृज्य पपात वै \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2107834, "chapter_id": 3327, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2107835, "chapter_id": 3327, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रुत्वा पुलोमाया भृगुः परममन्युमान्\nशशापाग्निमतिक्रुद्धः सर्वभक्षो भविष्यसि \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2107836, "chapter_id": 3327, "verse_number": "३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आदिपर्वणि षष्ठोऽध्यायः ॥६॥\n॥ पौलोमपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]