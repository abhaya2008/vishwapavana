[{"id": 2104428, "chapter_id": 3253, "verse_number": "१४-१०९-१", "content_sanskrit": "युधिष्ठिर उवाच।\nअन्नदानफलं श्रुत्वा प्रीतोस्मि मधुसूदन।\nभोजनस्य विधिं वक्तुं देवदेव त्वमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2104429, "chapter_id": 3253, "verse_number": "१४-१०९-२x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2104430, "chapter_id": 3253, "verse_number": "१४-१०९-२", "content_sanskrit": "बोजनस्य द्विजातीनां विधानं शृणु पाण्डव।\nस्नातः शुचिः शुचौ देशे निर्जने हुतपावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2104431, "chapter_id": 3253, "verse_number": "१४-१०९-३", "content_sanskrit": "मण्डलं कारयित्वा च चतुरश्रं द्विजोत्तमः।\nक्षत्रियश्चेत्ततो वृत्तं वैश्योऽर्धेन्दुसमाकृतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2104432, "chapter_id": 3253, "verse_number": "१४-१०९-४", "content_sanskrit": "आर्द्रपादस्तु भुञ्जीयात्प्राङ्मुखश्चासने शुचौ।\nपादाभ्यां धरणीं स्पृष्ट्वा पादेनैकेन वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2104433, "chapter_id": 3253, "verse_number": "१४-१०९-५", "content_sanskrit": "नैकवासास्तु भुञ्जीयान्न चान्तर्धाय वा द्विजः।\nन भिन्नपात्रे भुञ्जीत पर्णपृष्ठे तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2104434, "chapter_id": 3253, "verse_number": "१४-१०९-६", "content_sanskrit": "अन्नं पूर्वं नमस्कुर्यात्प्रहृष्टेनान्तरात्मना।\nनान्यदालोकयेदन्नान्न जुगुप्सेन तत्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2104435, "chapter_id": 3253, "verse_number": "१४-१०९-७", "content_sanskrit": "जुगुप्सितं च यच्चान्नं राक्षसा एव भुञ्जते।\nपाणिना जलमुद्धृत्य कुर्यादन्नं प्रदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2104436, "chapter_id": 3253, "verse_number": "१४-१०९-८", "content_sanskrit": "अपेयं तद्विजानीयात्पीत्वा चान्द्रायणं चरेत्।\nपरिवेषजलादन्यत्पेयमेव तु मन्त्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2104437, "chapter_id": 3253, "verse_number": "१४-१०९-९", "content_sanskrit": "पञ्च प्राणाहुतीः कुर्यात्समन्त्रं तु पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2104438, "chapter_id": 3253, "verse_number": "१४-१०९-१०", "content_sanskrit": "यथा रसं न जानाति जिह्वा प्रामाहुतौ नृप।\nतथा समाहितः कुर्यात्प्राणाहुतिमतन्द्रिकतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2104439, "chapter_id": 3253, "verse_number": "१४-१०९-११", "content_sanskrit": "विदित्वाऽन्नमथान्नादं पञ्च प्राणांश्च पाण्डव।\nयः कुर्यादाहुतीः पञ्च तेनेष्टाः पञ्चवायवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2104440, "chapter_id": 3253, "verse_number": "१४-१०९-१२", "content_sanskrit": "अतोऽन्यथा तु भुञ्जानो ब्राह्मणो ज्ञानदुर्बलः।\nतेनान्नेनासुरान्प्रेतान्राक्षसांस्तर्पयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2104441, "chapter_id": 3253, "verse_number": "१४-१०९-१३", "content_sanskrit": "वक्त्रप्रमाणान्पिण्डांश्च ग्रसेदेकैकशः पुनः।\nवक्त्राधिकं तु यत्पिण्डमात्मोच्छिष्टं तदुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2104442, "chapter_id": 3253, "verse_number": "१४-१०९-१४", "content_sanskrit": "पिण्डावशिष्टमन्यच्च वक्त्रान्निस्सृतमेव च।\nअभोज्यं तद्विजानीयाद्भुक्त्वा चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2104443, "chapter_id": 3253, "verse_number": "१४-१०९-१५", "content_sanskrit": "स्वमुच्छिष्टं तु यो भुङ्क्ते यो भुङ्क्ते मुक्तभोजनम्।\nचान्द्रायणं चरेन्कृच्छ्रं प्राजापत्यमथापि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2104444, "chapter_id": 3253, "verse_number": "१४-१०९-१६", "content_sanskrit": "स्त्रीपात्रभुङ्नरः पापः स्त्रीणामुच्छिष्टभुक्तथा।\nतया सह च यो भुङ्क्ते स भुङ्क्ते मद्यमेव हि।\nन तस्य निष्कृतिर्दृष्टा मुनिभिस्तत्वदर्शिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2104445, "chapter_id": 3253, "verse_number": "१४-१०९-१७", "content_sanskrit": "पिबतः पतिते तोये भोजने मुखनिस्सृते।\nअभोज्यं तद्विजानीयाद्भुक्त्वा चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2104446, "chapter_id": 3253, "verse_number": "१४-१०९-१८", "content_sanskrit": "पीतशेषं तु तन्नाम न पेयं पाण्डुनन्दन।\nपिबेद्यदि हि तन्मोहाद्द्विजश्चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2104447, "chapter_id": 3253, "verse_number": "१४-१०९-१९", "content_sanskrit": "पानीयानि पिबेद्यते तत्पात्रं द्विजसत्तमः।\nअनुच्छिष्टं भवेत्तावद्यावद्भूमौ न निक्षिपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2104448, "chapter_id": 3253, "verse_number": "१४-१०९-२०", "content_sanskrit": "मौनी वाऽप्यथवा भूमौ नावलोक्य दिशस्तथा।\nभुञ्जीत विधिवद्विप्रो न चोच्छिष्टं प्रदापयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2104449, "chapter_id": 3253, "verse_number": "१४-१०९-२१", "content_sanskrit": "सदा चात्यशनं नाद्यान्नातिहीनं च कर्हिचित्।\nयथाऽन्नेन व्यथा न स्यात्तथा भुञ्जीत नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2104450, "chapter_id": 3253, "verse_number": "१४-१०९-२२", "content_sanskrit": "उदक्यामपि चण्डालं श्वानं सूकरमेव वा।\nभुञ्जानो यदि वा पश्येत्तदन्नं च परित्यजेत्।\nभुञ्जानो ह्यत्यजन्मोहाद्द्विजश्चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2104451, "chapter_id": 3253, "verse_number": "१४-१०९-२३", "content_sanskrit": "केशकीटोपपन्नं च मुखमारुतवीजितम्।\nअभोज्यं तद्विजानीयाद्भुक्त्वा चान्द्रायणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2104452, "chapter_id": 3253, "verse_number": "१४-१०९-२४", "content_sanskrit": "उत्थाय च पुनः स्पृष्टं पादस्पृष्टं च लङ्घितम्।\nअन्नं तद्राक्षसं विद्यात्तस्मात्तत्परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2104453, "chapter_id": 3253, "verse_number": "१४-१०९-२५", "content_sanskrit": "राक्षसोच्छिष्टभुग्विप्रः सप्त पूर्वान्परानपि।\nनरके रौरवे घोर स पितॄन्पातयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2104454, "chapter_id": 3253, "verse_number": "१४-१०९-२६", "content_sanskrit": "तस्मिन्नाचमनं कुर्याद्यस्मिन्पात्रे स भुक्तवान्।\nयद्युत्तिष्ठत्यनाचान्तो भुक्तवानासनात्ततः।\nस्नानं सद्यः प्रकुर्वीत सोन्यथाऽप्रयतो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2104455, "chapter_id": 3253, "verse_number": "१४-१०९-२७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2104456, "chapter_id": 3253, "verse_number": "१४-१०९-२७", "content_sanskrit": "तृणमुष्टिविधानं च तृणमाहात्म्यमेव च।\nइक्षोः सोमसमुद्भूतिं वक्तुमर्हसि मानदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2104457, "chapter_id": 3253, "verse_number": "१४-१०९-२८x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2104458, "chapter_id": 3253, "verse_number": "१४-१०९-२८", "content_sanskrit": "पितरो वृषभा ज्ञेयो गावो लोकस्य मातरः।\nतासां तु पूजया राजन्पूजिताः पितृदेवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2104459, "chapter_id": 3253, "verse_number": "१४-१०९-२९", "content_sanskrit": "सभा प्रपा गृहाश्चापि देवतायतनानि च।\nशुद्ध्यन्ति शकृता यासांकिं भूतमधिकं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2104460, "chapter_id": 3253, "verse_number": "१४-१०९-३०", "content_sanskrit": "ग्रासमुष्टिं परगवे दद्यात्संवत्सरं तु यः।\nअकृत्वा स्वयमाहारं प्राप्तस्तत्सार्वकालिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2104461, "chapter_id": 3253, "verse_number": "१४-१०९-३१", "content_sanskrit": "गावो मे मातरः सर्वाः पितरश्चैव गोवृषाः।\nग्रासमुष्टिं मया दत्तं प्रतिगृह्णीत मातरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2104462, "chapter_id": 3253, "verse_number": "१४-१०९-३२", "content_sanskrit": "इत्युक्त्वाऽनेन मन्त्रेण गायत्र्या वा समाहितः।\nअभिमन्त्र्य ग्रासमुष्टिं तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2104463, "chapter_id": 3253, "verse_number": "१४-१०९-३३", "content_sanskrit": "यत्कृतं दुष्कृतं तेन ज्ञानतोऽज्ञानतोपि वा।\nतस्य नश्यति तत्सर्वं दुःखप्नं च विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2104464, "chapter_id": 3253, "verse_number": "१४-१०९-३४", "content_sanskrit": "तिलाः पिवित्राः पापघ्ना नारायणसमुद्भवाः।\nतिलाञ्श्राद्धे प्रशंसनति दानमेतदनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2104465, "chapter_id": 3253, "verse_number": "१४-१०९-३५", "content_sanskrit": "तिलान्दद्यात्तिलान्भक्ष्यात्तिलानप्रातरुपस्पृशेत्।\nतिलंतिलमिति ब्रूयात्तिलाः पापहरा हि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2104466, "chapter_id": 3253, "verse_number": "१४-१०९-३६", "content_sanskrit": "क्रीत्वा प्रतिगृहीत्वा वा न विक्रेया द्विजातिभिः।\nभोजनाभ्यञ्जनाद्दानाद्योन्यत्तु कुरुते तिलैः।\nकृमिर्भूत्वा श्वविष्ठायां पितृभिः सह मज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2104467, "chapter_id": 3253, "verse_number": "१४-१०९-३७", "content_sanskrit": "तिलान्नपीडयेद्विप्रो यन्त्रचक्रे स्वयं नृप।\nपीडयन्हि द्विजो मोहान्नरकं याति रौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2104468, "chapter_id": 3253, "verse_number": "१४-१०९-३८", "content_sanskrit": "इक्षुवंशोद्भवः सोमः सोमवंशोद्भवा द्विजाः।\nइक्षुं न पीडयेत्तस्मादिक्षुघात्यात्मघातकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2104469, "chapter_id": 3253, "verse_number": "१४-१०९-३९", "content_sanskrit": "इक्षुदण्डसहस्राणामेकैकेन युधिष्ठिर।\nब्रह्महत्यामवाप्नोति द्विजश्चेद्यन्त्रपीडकः।\nतस्मान्न पीडयेदिक्षुं यन्त्रचक्रे द्विजोत्तमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2104470, "chapter_id": 3253, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि नवाधिकशततमोऽध्यायः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]