[{"id": 2103178, "chapter_id": 3237, "verse_number": "१४-९३-१", "content_sanskrit": "जनमेजय उवाच।\nयज्ञे सक्ता नृपतयस्तपःसका महर्षयः।\nशान्तिव्यवस्थिता विप्राः शमे दम इति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103179, "chapter_id": 3237, "verse_number": "१४-९३-२", "content_sanskrit": "तस्माद्यज्ञफलैस्तुल्यं न किञ्चिदिह दृश्यते।\nइति मे वर्तते बुद्धिस्तथा चैतदसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103180, "chapter_id": 3237, "verse_number": "१४-९३-३", "content_sanskrit": "यज्ञैरिष्ट्वा तु बहवो राजानो द्विजसत्तमाः।\nइह कीर्ति परां प्राप्य प्रेत्य स्वर्गमितो गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103181, "chapter_id": 3237, "verse_number": "१४-९३-४", "content_sanskrit": "देवराजः सहस्राक्षः क्रतुभिर्भूरिदक्षिणैः।\nदेवराज्यं महातेजाःक प्राप्तवानखिलं विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103182, "chapter_id": 3237, "verse_number": "१४-९३-५", "content_sanskrit": "अतो युधिष्ठिरो राजा भीमार्जुनपुरःसरः।\nसदृशो देवराजेन समृद्ध्या विक्रमेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103183, "chapter_id": 3237, "verse_number": "१४-९३-६", "content_sanskrit": "अथ कस्मात्स नकुलो गर्हयामास तं क्रतुम्।\nअश्वमेधं महायज्ञं राज्ञस्तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103184, "chapter_id": 3237, "verse_number": "१४-९३-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103185, "chapter_id": 3237, "verse_number": "१४-९३-७", "content_sanskrit": "यज्ञस्य विधिमग्र्यं वै फलं चापि नराधिप।\nगदतः शृणु मे राजन्यथावदिह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103186, "chapter_id": 3237, "verse_number": "१४-९३-८", "content_sanskrit": "पुरा शक्रस्य यजतः सर्व ऊचुर्महर्षयः।\nऋत्विक्षु कर्मव्यग्रेषु वितते यज्ञकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103187, "chapter_id": 3237, "verse_number": "१४-९३-९", "content_sanskrit": "हूयमाने तथा वह्नौ होत्रा गुणसमन्विते।\nदेवष्वाहूयमानेषु स्थितेषु परमर्षिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103188, "chapter_id": 3237, "verse_number": "१४-९३-१०", "content_sanskrit": "सुप्रतीतैस्तथा विप्रैः स्वागमैः सुस्वरैर्नृप।\nअश्रान्तैश्चापि लघुभिरध्वर्युवृषभैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103189, "chapter_id": 3237, "verse_number": "१४-९३-११", "content_sanskrit": "आलम्भसमये तस्मिन्गृहीतेषु पशुष्वथ।\nमहर्षयो महाराज बभूवुः कृपयाऽन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103190, "chapter_id": 3237, "verse_number": "१४-९३-१२", "content_sanskrit": "ततो दीनान्पशून्दृष्ट्वा ऋषयस्ते तपोधनाः।\nऊचुः शक्रं समागम्य नायं यज्ञविधिः शुभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103191, "chapter_id": 3237, "verse_number": "१४-९३-१३", "content_sanskrit": "अपरिज्ञानमेतत्ते महान्तं धर्ममिच्छतः।\nसन्ति यज्ञे बहुगुणा विधिदृष्टाः पुरंदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103192, "chapter_id": 3237, "verse_number": "१४-९३-१४", "content_sanskrit": "धर्मोपघातकस्त्वेष समारंभस्तव प्रभो।\nनायं धर्मकृतो यज्ञो न हिंसा धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103193, "chapter_id": 3237, "verse_number": "१४-९३-१५", "content_sanskrit": "आगमेनैव ते यज्ञं कुर्वन्तु यदि चेच्छसि।\nविधिदृष्टेन यज्ञेन धर्मस्ते सुमहान्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103194, "chapter_id": 3237, "verse_number": "१४-९३-१६", "content_sanskrit": "यज्ञं बीजैः सहस्राक्ष त्रिवर्षपरमोषितेः।\nएष धर्मो महाञ्शक्र चिन्तयानोसि गम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103195, "chapter_id": 3237, "verse_number": "१४-९३-१७", "content_sanskrit": "शतक्रतुस्तु तद्वाक्यमृषिभिस्तत्त्वदर्शिभिः।\nउक्तं न प्रतिजग्राह मानमोहवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103196, "chapter_id": 3237, "verse_number": "१४-९३-१८", "content_sanskrit": "तेषां विवादः सुमहाञ्शक्रयज्ञे तपस्विनाम्।\nजङ्गमैः स्थावरैर्वाऽपि यष्टव्यमिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103197, "chapter_id": 3237, "verse_number": "१४-९३-१९", "content_sanskrit": "ते तु खिन्ना विवादेन ऋषयस्तत्त्वदर्शिनः।\nअभिसंधाय शक्रेण पप्रच्छुर्नृपतिं वसुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103198, "chapter_id": 3237, "verse_number": "१४-९३-२०", "content_sanskrit": "धर्मसंशयमापन्नान्सत्यं ब्रूहि महामते।\nमहाभाग कथं यज्ञेष्वागमो नृपसत्तम।\nयष्टव्यं पशुभिर्मेध्यैरथो बीजैरजैरिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103199, "chapter_id": 3237, "verse_number": "१४-९३-२१", "content_sanskrit": "तच्छ्रुत्वा तु वसुस्तेषामविचार्य बलाबलम्।\nयथोपनीतैर्यष्टव्यमिति प्रोवाच पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103200, "chapter_id": 3237, "verse_number": "१४-९३-२२", "content_sanskrit": "एवमुक्त्वा स नृपतिः प्रविवेश रसातलम्।\nउक्त्वेह वितथं राजंश्चेदीनामीश्वरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103201, "chapter_id": 3237, "verse_number": "१४-९३-२३", "content_sanskrit": "तस्मान्नि वाच्यं ह्येकेन बहुज्ञेनापि संशये।\nप्रजापतिमपाहाय स्वयंभुवमृते प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103202, "chapter_id": 3237, "verse_number": "१४-९३-२४", "content_sanskrit": "तेन दत्तानि दानानि पापेनाशुद्धबुद्धिना।\nतानि सर्वाण्यनादृत्य नश्यन्ति विपुलान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103203, "chapter_id": 3237, "verse_number": "१४-९३-२५", "content_sanskrit": "तस्याधर्मप्रवृत्तस्य हिंसकस्य दुरात्मनः।\nदानेन कीर्तिर्भवति न प्रेत्येह च दुर्मतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103204, "chapter_id": 3237, "verse_number": "१४-९३-२६", "content_sanskrit": "अन्यायोपगतं द्रव्यमभीक्ष्णं यो ह्यपण्डितः।\nधर्माभिकाङ्क्षी त्यजति न स धर्मफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103205, "chapter_id": 3237, "verse_number": "१४-९३-२७", "content_sanskrit": "धर्मवैतंसिको यस्तु पापात्मा पुरुषाधमः।\nददाति दानं विप्रेभ्यो लोकविश्वासकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103206, "chapter_id": 3237, "verse_number": "१४-९३-२८", "content_sanskrit": "पापेन कर्मणा विप्रो धनं प्राप्य निरङ्कुशः।\nरागमोहान्वितः सोन्ते कलुषां गतिमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103207, "chapter_id": 3237, "verse_number": "१४-९३-२९", "content_sanskrit": "अपि संचयबुद्धिर्हि लोभमोहवशं गतः।\nयज्ञं करोति भूतानि पापेनाशुद्धबुद्धिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103208, "chapter_id": 3237, "verse_number": "१४-९३-३०", "content_sanskrit": "एवं लब्ध्वा धनं मोहाद्यो हि दद्याद्यजेत वा।\nन तस्य स फलं प्रेत्य भुंक्ते पापधनागमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103209, "chapter_id": 3237, "verse_number": "१४-९३-३१", "content_sanskrit": "उञ्छं मूलं फलं शाकमुदपात्रं तपोधनाः।\nदानं विभवतो दत्त्वा नराः स्वर्यान्ति धार्मिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103210, "chapter_id": 3237, "verse_number": "१४-९३-३२", "content_sanskrit": "एष धर्मो महायोगो दानं भूतदया तथा।\nब्रह्मचर्यं तथा सत्यमनुक्रोशो धृतिः क्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103211, "chapter_id": 3237, "verse_number": "१४-९३-३३", "content_sanskrit": "सनातनस्य धर्मस्य फलमेतत्सनातनम्।\nश्रूयन्ते हि पुरावृत्ता विश्वामित्रादयो नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103212, "chapter_id": 3237, "verse_number": "१४-९३-३४", "content_sanskrit": "विश्वामित्रोसितश्चैवं जनसश्च महीपतिः।\nकक्षसेनार्ष्टिसेनौ च सिन्धुद्वीपश्च पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103213, "chapter_id": 3237, "verse_number": "१४-९३-३५", "content_sanskrit": "एते चान्ये च बहवः सिद्धिं परमिकां गताः।\nनृपाः सत्यैश्च दानैश्च न्यायलब्धैस्तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103214, "chapter_id": 3237, "verse_number": "१४-९३-३६", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा ये चाश्रितास्तपः।\nदानधर्माग्निना शुद्धास्ते स्वर्गं यान्ति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103215, "chapter_id": 3237, "verse_number": "", "content_sanskrit": "॥ इती श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि त्रिनवतितमोऽध्यायः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]