[{"id": 7000491000, "chapter_id": 20491, "verse_number": "३-३८-१", "content_sanskrit": "नारद उवाच ।\nवाराणस्याश्च माहात्म्यं तस्यां तीर्थानि च प्रभो ।\nकथितानि समासेन तीर्थान्यन्यानि संशृणु॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000491001, "chapter_id": 20491, "verse_number": "३-३८-२", "content_sanskrit": "ततो गयां समासाद्य ब्रह्मचारी समाहितः ।\nअश्वमेधमवाप्नोति गमनादेव भारत॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000491002, "chapter_id": 20491, "verse_number": "३-३८-३", "content_sanskrit": "यत्राक्षय्यवटो नाम त्रिषु लोकेषु विश्रुतः ।\nपितॄणां तत्र वै दत्तमक्षयं भवति प्रभो॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000491003, "chapter_id": 20491, "verse_number": "३-३८-४", "content_sanskrit": "महानद्यामुपस्पृश्य तर्पयेत्पितृदेवताः ।\nअक्षयान्प्राप्नुयाल्लोकान्कुलं चैव समुद्धरेत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000491004, "chapter_id": 20491, "verse_number": "३-३८-५", "content_sanskrit": "ततो ब्रह्मसरो गच्छेद्ब्रह्मारण्योपसेवितम् ।\nपुंडरीकमवाप्नोति प्रभातमिव शर्वरी॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000491005, "chapter_id": 20491, "verse_number": "३-३८-६", "content_sanskrit": "सरसि ब्रह्मणा तत्र यूपश्रेष्ठः समुच्छ्रितः ।\nयूपं प्रदक्षिणं कृत्वा वाजपेयफलं लभेत्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000491006, "chapter_id": 20491, "verse_number": "३-३८-७", "content_sanskrit": "ततो गच्छेत राजेंद्र धेनुकं लोकविश्रुतम् ।\nएकारात्रोषितो राजन्प्रयच्छेत्तिलधेनुकाम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000491007, "chapter_id": 20491, "verse_number": "३-३८-८", "content_sanskrit": "सर्वपापविशुद्धात्मा सोमलोकं व्रजेद्ध्रुवम् ।\nतत्र चिह्नं महाराज अद्यापि हि न संशयः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000491008, "chapter_id": 20491, "verse_number": "३-३८-९", "content_sanskrit": "कपिला सहवत्सा वै पर्वते विचरत्युतः ।\nसवत्सायाः पदान्यस्या दृश्यंतेऽद्यापि भारत॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000491009, "chapter_id": 20491, "verse_number": "३-३८-१०", "content_sanskrit": "तेषूपस्पृश्य राजेंद्र पदेषु नृपसत्तम ।\nयत्किंचिदशुभं पापं तत्प्रणश्यति भारत॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000491010, "chapter_id": 20491, "verse_number": "३-३८-११", "content_sanskrit": "ततो गृध्रवटं गच्छेत्स्थानं देवस्य शूलिनः ।\nस्नायात्तु भस्मना तत्र संगम्य वृषभध्वजम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000491011, "chapter_id": 20491, "verse_number": "३-३८-१२", "content_sanskrit": "ब्राह्मणेन भवेच्चीर्णं व्रतं द्वादशवार्षिकम् ।\nइतरेषां तु वर्णानां सर्वपापं प्रणश्यति॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000491012, "chapter_id": 20491, "verse_number": "३-३८-१३", "content_sanskrit": "गच्छेत तत उद्यंतं पर्वतं गीतनादितम् ।\nसावित्रं तु पदं तत्र दृश्यते भरतर्षभ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000491013, "chapter_id": 20491, "verse_number": "३-३८-१४", "content_sanskrit": "तत्र संध्यामुपासीत ब्राह्मणः संशितव्रतः ।\nउपास्ताहि भवेत्संध्या तेन द्वादशवार्षिकी॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000491014, "chapter_id": 20491, "verse_number": "३-३८-१५", "content_sanskrit": "योनिद्वारं च तत्रैव विश्रुतं भरतर्षभ ।\nतत्राभिगम्य मुच्येत पुरुषो योनिसंकटात्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000491015, "chapter_id": 20491, "verse_number": "३-३८-१६", "content_sanskrit": "शुक्लकृष्णावुभौ पक्षौ गयायां यो वसेन्नरः ।\nपुनात्यासप्तमं राजन्कुलं नास्त्यत्र संशयः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000491016, "chapter_id": 20491, "verse_number": "३-३८-१७", "content_sanskrit": "एष्टव्या बहवः पुत्रा यद्यप्येको गयां व्रजेत् ।\nयजेत वाश्वमेधेन नीलं वा वृषमुत्सृजेत्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000491017, "chapter_id": 20491, "verse_number": "३-३८-१८", "content_sanskrit": "ततः फल्गुं व्रजेद्राजंस्तीर्थसेवी नराधिप ।\nअश्वमेधमवाप्नोति सिद्धिं च परमां व्रजेत्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000491018, "chapter_id": 20491, "verse_number": "३-३८-१९", "content_sanskrit": "ततो गच्छेत राजेंद्र धर्मपृष्ठं समाहितः ।\nयत्र धर्मो महाराज नित्यमास्ते युधिष्ठिर॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000491019, "chapter_id": 20491, "verse_number": "३-३८-२०", "content_sanskrit": "धर्म्मं तत्राभिसंगम्य वाजिमेधफलं लभेत् ।\nततो गच्छेत राजेंद्र ब्रह्मणस्तीर्थमुत्तमम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000491020, "chapter_id": 20491, "verse_number": "३-३८-२१", "content_sanskrit": "तत्राभिगम्य ब्रह्माणमर्चयेन्नियतव्रतः ।\nराजसूयाश्वमेधाभ्यां फलं प्राप्नोति भारत॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000491021, "chapter_id": 20491, "verse_number": "३-३८-२२", "content_sanskrit": "ततो राजगृहं गच्छेत्तीर्थसेवी नराधिप ।\nउपस्पृश्य ततस्तत्र कक्षीवानिव मोदते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000491022, "chapter_id": 20491, "verse_number": "३-३८-२३", "content_sanskrit": "यक्षिण्या नैत्यकं तत्र प्रागग्निपुरुषः शुचिः ।\nयक्षिण्यास्तु प्रसादेन मुच्यते ब्रह्महत्यया॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000491023, "chapter_id": 20491, "verse_number": "३-३८-२४", "content_sanskrit": "मणिनागं ततो गच्छेद्गोसहस्रफलं लभेत् ।\nनैत्यकं भुंजते यस्तु मणिनागस्य मानवः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000491024, "chapter_id": 20491, "verse_number": "३-३८-२५", "content_sanskrit": "दष्टस्याशीविषेणास्य न विषं क्रमते नृप ।\nतत्रोष्य रजनीमेकां सर्वपापैः प्रमुच्यते॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000491025, "chapter_id": 20491, "verse_number": "३-३८-२६", "content_sanskrit": "ततो गच्छेत ब्रह्मर्षेर्गौतमस्य वनं नृप ।\nअहल्याया ह्रदे स्नात्वा व्रजेत परमां गतिम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000491026, "chapter_id": 20491, "verse_number": "३-३८-२७", "content_sanskrit": "अभिगम्य श्रियं राजन्विंदते श्रियमुत्तमाम् ।\nतत्रोदपानो धर्म्मज्ञ त्रिषु लोकेषु विश्रुतः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000491027, "chapter_id": 20491, "verse_number": "३-३८-२८", "content_sanskrit": "तत्राभिषेकं कुर्वीत वाजिमेधमवाप्नुयात् ।\nजनकस्य तु राजर्षेः कूपस्त्रिदशपूजितः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000491028, "chapter_id": 20491, "verse_number": "३-३८-२९", "content_sanskrit": "तत्राभिषेकं कृत्वा च विष्णुलोकमवाप्नुयात् ।\nततोऽविनाशनं गच्छेत्सर्वपापप्रमोचनम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000491029, "chapter_id": 20491, "verse_number": "३-३८-३०", "content_sanskrit": "वाजिमेधमवाप्नोति सोमलोकं च गच्छति ।\nगंडकीं च समासाद्य सर्वतीर्थजलोद्भवाम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000491030, "chapter_id": 20491, "verse_number": "३-३८-३१", "content_sanskrit": "वाजपेयमवाप्नोति सूर्यलोकं च गच्छति ।\nततो ध्रुवस्य धर्मज्ञ समाविश्य तपोवनम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000491031, "chapter_id": 20491, "verse_number": "३-३८-३२", "content_sanskrit": "गुह्यकेषु महाभाग मोदते नात्र संशयः ।\nकर्मदां तु समासाद्य नदीं सिद्धनिषेविताम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000491032, "chapter_id": 20491, "verse_number": "३-३८-३३", "content_sanskrit": "पुंडरीकमवाप्नोति सोमलोकं च गच्छति ।\nततो विशालामासाद्य नदीं त्रैलोक्यविश्रुताम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000491033, "chapter_id": 20491, "verse_number": "३-३८-३४", "content_sanskrit": "अग्निष्टोममवाप्नोति स्वर्गलोकं च गच्छति ।\nअथ माहेश्वरीं धारां समासाद्य नराधिप॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000491034, "chapter_id": 20491, "verse_number": "३-३८-३५", "content_sanskrit": "अश्वमेधमवाप्नोति कुलं चैव समुद्धरेत् ।\nदिवौकसां पुष्करिणीं समासाद्य नरः शुचिः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000491035, "chapter_id": 20491, "verse_number": "३-३८-३६", "content_sanskrit": "न दुर्गतिमवाप्नोति वाजपेयं च विंदति ।\nअथ माहेशपदं गच्छेद्ब्रह्मचारी समाहितः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000491036, "chapter_id": 20491, "verse_number": "३-३८-३७", "content_sanskrit": "माहेश्वरपदे स्नात्वा वाजिमेधफलं लभेत् ।\nतत्र कोटिस्तु तीर्थानां विश्रुता भरतर्षभ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000491037, "chapter_id": 20491, "verse_number": "३-३८-३८", "content_sanskrit": "कूर्मरूपेण राजेंद्र असुरेण दुरात्मना ।\nह्रियमाणा हृता राजन्विष्णुना प्रभविष्णुना॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000491038, "chapter_id": 20491, "verse_number": "३-३८-३९", "content_sanskrit": "तत्राभिषेकं कुर्वीत तीर्थकोट्यां नराधिप ।\nपुंडरीकमवाप्नोति विष्णुलोकं च गच्छति॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000491039, "chapter_id": 20491, "verse_number": "३-३८-४०", "content_sanskrit": "ततो गच्छेन्नरश्रेष्ठ स्थानं नारायणस्य च ।\nसदा सन्निहितो यत्र हरिर्वसति भारत॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000491040, "chapter_id": 20491, "verse_number": "३-३८-४१", "content_sanskrit": "यत्र ब्रह्मादयो देवा ऋषयश्च तपोधनाः ।\nआदित्यावसवोरुद्रा जनार्दनमुपासते॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000491041, "chapter_id": 20491, "verse_number": "३-३८-४२", "content_sanskrit": "शालग्राम इति ख्यातो विष्णोरद्भुतकर्मणः ।\nअभिगम्य त्रिलोकेशं वरदं विष्णुमच्युतम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000491042, "chapter_id": 20491, "verse_number": "३-३८-४३", "content_sanskrit": "अश्वमेधमवाप्नोति विष्णुलोकं च गच्छति ।\nतत्रोदपानो धर्मज्ञ सर्वपापप्रमोचनः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000491043, "chapter_id": 20491, "verse_number": "३-३८-४४", "content_sanskrit": "समुद्रास्तत्रचत्वारः कूपे सन्निहिताः सदा ।\nतत्रोपस्पृश्य राजेंद्र न दुर्गतिमवाप्नुयात्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000491044, "chapter_id": 20491, "verse_number": "३-३८-४५", "content_sanskrit": "अभिगम्य महादेवं वरदं विष्णुमव्ययम् ।\nविराजते यथा सोम ऋणैर्मुक्तो युधिष्ठिर॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000491045, "chapter_id": 20491, "verse_number": "३-३८-४६", "content_sanskrit": "जातिस्मरं उपस्पृश्य शुचिः प्रयतमानसः ।\nजातिस्मरत्वं प्राप्नोति स्नात्वा तत्र न संशयः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000491046, "chapter_id": 20491, "verse_number": "३-३८-४७", "content_sanskrit": "वटेश्वरपुरं गत्वा अर्चयित्वा च केशवम् ।\nईप्सितांल्लभते लोकानुपवासान्न संशयः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000491047, "chapter_id": 20491, "verse_number": "३-३८-४८", "content_sanskrit": "ततस्तु वामनं गत्वा सर्वपापप्रणाशनम् ।\nअभिवाद्य हरिं देवं न दुर्गतिमवाप्नुयात्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000491048, "chapter_id": 20491, "verse_number": "३-३८-४९", "content_sanskrit": "भरतस्याश्रमं गत्वा सर्वपापप्रमोचनम् ।\nकौशिकीं तत्र सेवेत महापातकनाशिनीम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000491049, "chapter_id": 20491, "verse_number": "३-३८-५०", "content_sanskrit": "राजसूयस्य यज्ञस्य फलं प्राप्नोतिमानवः ।\nततो गच्छेत धर्मज्ञ चंपकारण्यमुत्तमम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000491050, "chapter_id": 20491, "verse_number": "३-३८-५१", "content_sanskrit": "तत्रोष्य रजनीमेकां गोसहस्रफलं लभेत् ।\nअथ गोविंदमासाद्य तीर्थं परमसम्मतम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000491051, "chapter_id": 20491, "verse_number": "३-३८-५२", "content_sanskrit": "उपोष्य रजनीमेकामग्निष्टोमफलं लभेत् ।\nतत्र विश्वेश्वरं दृष्ट्वा देव्या सह महाद्युतिम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000491052, "chapter_id": 20491, "verse_number": "३-३८-५३", "content_sanskrit": "मित्रावरुणयोर्लोकान्प्राप्नुयाद्भरतर्षभ ।\nत्रिरात्रोपोषितस्तत्र अग्निष्टोमफलं लभेत्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000491053, "chapter_id": 20491, "verse_number": "३-३८-५४", "content_sanskrit": "कन्यावसथमासाद्य नियतो नियताशनः ।\nमनोः प्रजापतेर्लोकानाप्नोति भरतर्षभ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000491054, "chapter_id": 20491, "verse_number": "३-३८-५५", "content_sanskrit": "कन्यायां ये प्रयच्छंति दानमण्वपि भारत ।\nतदक्षयमिति प्राहुरृषयः संशितव्रताः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000491055, "chapter_id": 20491, "verse_number": "३-३८-५६", "content_sanskrit": "निष्ठावासं समासाद्य त्रिषु लोकेषु विश्रुतम् ।\nअश्वमेधमवाप्नोति विष्णुलोकं च गच्छति॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000491056, "chapter_id": 20491, "verse_number": "३-३८-५७", "content_sanskrit": "ये तु दानं प्रयच्छंति निष्ठायाः संगमे नराः ।\nते यांति नरशार्दूल ब्रह्मलोकमनामयम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000491057, "chapter_id": 20491, "verse_number": "३-३८-५८", "content_sanskrit": "तत्राश्रमो वसिष्ठस्य त्रिषु लोकेषु विश्रुतः ।\nतत्राभिषेकं कुर्वाणो वाजपेयमवाप्नुयात्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000491058, "chapter_id": 20491, "verse_number": "३-३८-५९", "content_sanskrit": "देवकूटं समासाद्य देवर्षिगणसेवितम् ।\nअश्वमेधमवाप्नोति कुलं चैव समुद्धरेत्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000491059, "chapter_id": 20491, "verse_number": "३-३८-६०", "content_sanskrit": "ततो गच्छेत राजेंद्र कौशिकस्य मुनेर्ह्रदम् ।\nतत्र सिद्धिं परां प्राप विश्वामित्रोऽथ कौशिकः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000491060, "chapter_id": 20491, "verse_number": "३-३८-६१", "content_sanskrit": "यत्र मासं वसेद्धीरः कौशिक्यां भरतर्षभ ।\nअश्वमेधस्य यत्पुण्यं तन्मासेनाधिगच्छति॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000491061, "chapter_id": 20491, "verse_number": "३-३८-६२", "content_sanskrit": "सर्वतीर्थवरं चैव यो वसेत महाह्रदम् ।\nन दुर्गतिमवाप्नोति विंद्याद्बहुसुवर्णकम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000491062, "chapter_id": 20491, "verse_number": "३-३८-६३", "content_sanskrit": "कुमारमभिगम्याथ वीराश्रमनिवासिनम् ।\nअश्वमेधमवाप्नोति शक्रलोकं स गच्छति॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000491063, "chapter_id": 20491, "verse_number": "३-३८-६४", "content_sanskrit": "नंदिन्यां च समासाद्य कूपं त्रिदशसेवितम् ।\nनरमेधस्य यत्पुण्यं तत्प्राप्नोति कुरूद्वह॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000491064, "chapter_id": 20491, "verse_number": "३-३८-६५", "content_sanskrit": "कालिकासंगमे स्नात्वा कौशिक्यारुणयोर्यतः ।\nत्रिरात्रोपोषितो विद्वान्सर्वपापैः प्रमुच्यते॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000491065, "chapter_id": 20491, "verse_number": "३-३८-६६", "content_sanskrit": "उर्वशीतीर्थमासाद्य तथा सोमाश्रमं बुधः ।\nकुंभकर्णाश्रमे स्नात्वा पूज्यते भुवि मानवः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000491066, "chapter_id": 20491, "verse_number": "३-३८-६७", "content_sanskrit": "तथा कोकामुखे स्नात्वा ब्रह्मचारी समाहितः ।\nजातिस्मरत्वं प्राप्नोति दृष्टमेतत्पुरातनैः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000491067, "chapter_id": 20491, "verse_number": "३-३८-६८", "content_sanskrit": "सकृन्नदीं समासाद्य कृतार्थो भवति द्विजः ।\nसर्वपापविशुद्धात्मा स्वर्गलोकं च गच्छति॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000491068, "chapter_id": 20491, "verse_number": "३-३८-६९", "content_sanskrit": "ऋषभद्वीपमासाद्य सेव्य क्रौंचनिषूदनम् ।\nसरस्वत्यामुपस्पृश्य विमानस्थो विराजते॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000491069, "chapter_id": 20491, "verse_number": "३-३८-७०", "content_sanskrit": "औद्यानकं महाराज तीर्थं मुनिनिषेवितम् ।\nतत्राभिषेकं कुर्वीत सर्वपापैः प्रमुच्यते॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000491070, "chapter_id": 20491, "verse_number": "३-३८-७१", "content_sanskrit": "ब्रह्मतीर्थं समासाद्य पुण्यं ब्रह्मर्षिसेवितम् ।\nवाजपेयमवाप्नोति नरो नास्त्यत्र संशयः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000491071, "chapter_id": 20491, "verse_number": "३-३८-७२", "content_sanskrit": "ततश्चंपां समासाद्य भागीरथ्यां कृतोदकः ।\nदंडार्पणं समासाद्य गोसहस्रफलं लभेत्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000491072, "chapter_id": 20491, "verse_number": "३-३८-७३", "content_sanskrit": "लाविढिकां ततो गच्छेत्पुण्यां पुण्यनिषेविताम् ।\nवाजपेयमवाप्नोति विमानस्थश्च पूज्यते॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]