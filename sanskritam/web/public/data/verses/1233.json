[{"id": 2011408, "chapter_id": 1233, "verse_number": "१-२३४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011409, "chapter_id": 1233, "verse_number": "१-२३४-१", "content_sanskrit": "तं प्रयान्तं महाबाहुं कौरवाणां यशस्करम्।\nअनुजग्मुर्महात्मानो ब्राह्मणा वेदपारगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011410, "chapter_id": 1233, "verse_number": "१-२३४-२", "content_sanskrit": "वेदवेदाङ्गविद्वासस्तथैवाध्यात्मचिन्तकाः।\nभैक्षाश्च भगवद्भक्ताः सूताः पौराणिकाश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011411, "chapter_id": 1233, "verse_number": "१-२३४-३", "content_sanskrit": "कथकाश्चापरे राजञ्श्रमणाश्च वनौकसः।\nदिव्याख्यानानि ये चापि पठन्ति मधुरं द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011412, "chapter_id": 1233, "verse_number": "१-२३४-४", "content_sanskrit": "एतैश्चान्यैश्च बहुभिः सहायैः पाण्डुनन्दनः।\nवृतः श्लक्ष्णकथैः प्रायान्मरुद्भिरिव वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011413, "chapter_id": 1233, "verse_number": "१-२३४-५", "content_sanskrit": "रमणीयानि चित्राणि वनानि च सरांसि च।\nसरितः सागरांश्चैव देशानपि च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011414, "chapter_id": 1233, "verse_number": "१-२३४-६", "content_sanskrit": "पुण्यान्यपि च तीर्थानि ददर्श भरतर्षभः।\nस गङ्गाद्वारमाश्रित्य निवेशमकरोत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011415, "chapter_id": 1233, "verse_number": "१-२३४-७", "content_sanskrit": "तत्र तस्याद्भुतं कर्म शृणु त्वं जनमेजय।\nकृतवान्यद्विशुद्धात्मा पाण्डूनां प्रवरो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011416, "chapter_id": 1233, "verse_number": "१-२३४-८", "content_sanskrit": "निविष्टे तत्र कौन्तेये ब्राह्मणेषु च भारत।\nअग्निहोत्राणि विप्रास्ते प्रादुश्चक्रुरनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011417, "chapter_id": 1233, "verse_number": "१-२३४-९", "content_sanskrit": "तेषु प्रबोध्यमानेषु ज्वलितेषु हुतेषु च।\nकृतपुष्पोपहारेषु तीरान्तरगतेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011418, "chapter_id": 1233, "verse_number": "१-२३४-१०", "content_sanskrit": "कृताभिषेकैर्विद्वद्भिर्नियतैः सत्पथे स्थितैः।\nशुशुभेऽतीव तद्राजन्गङ्गाद्वारं महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011419, "chapter_id": 1233, "verse_number": "१-२३४-११", "content_sanskrit": "तथा पर्याकुले तस्मिन्निवेशे पाण्डवर्षभः।\nअभिषेकाय कौन्तेयो गङ्गामवततार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011420, "chapter_id": 1233, "verse_number": "१-२३४-१२", "content_sanskrit": "तत्राभिषेकं कृत्वा स तर्पयित्वा पितामहान्।\nउत्तितीर्षुर्जलाद्राजन्नग्निकार्यचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011421, "chapter_id": 1233, "verse_number": "१-२३४-१३", "content_sanskrit": "अपकृष्टो महाबाहुर्नागराजस्य कन्यया।\nअन्तर्जले महाराज उलूप्या कामयानया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011422, "chapter_id": 1233, "verse_number": "१-२३४-१४", "content_sanskrit": "ददर्श पाण्डवस्तत्र पावकं सुसमाहितः।\nकौरव्यस्याथ नागस्य भवने परमार्चिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011423, "chapter_id": 1233, "verse_number": "१-२३४-१५", "content_sanskrit": "तत्राग्निकार्यं कृतवान्कुन्तीपुत्रो धनञ्जयः।\nअशङ्कमानेन हुतस्तेनातुष्यद्धुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011424, "chapter_id": 1233, "verse_number": "१-२३४-१६", "content_sanskrit": "अग्निकार्यं स कृत्वा तु नागराजसुतां तदा।\nप्रसहन्निव कौन्तेय इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011425, "chapter_id": 1233, "verse_number": "१-२३४-१७", "content_sanskrit": "किमिदं साहसं भीरु कृतवत्यसि भामिनि।\nकश्चायं सुभगे देशः का च त्वं कस्य वात्मजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011426, "chapter_id": 1233, "verse_number": "१-२३४-१८x", "content_sanskrit": "उलूप्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011427, "chapter_id": 1233, "verse_number": "१-२३४-१८", "content_sanskrit": "ऐरावतकुले जातः कौरव्यो नाम पन्नगः।\nतस्यास्मि दुहिता राजन्नुलूपी नाम पन्नगी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011428, "chapter_id": 1233, "verse_number": "१-२३४-१९", "content_sanskrit": "साऽहं त्वामभिषेकार्थमवतीर्णं समुद्गाम्।\nदृष्ट्वैव पुरुषव्याघ्र कन्दर्पेणाभिमूर्च्छिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011429, "chapter_id": 1233, "verse_number": "१-२३४-२०", "content_sanskrit": "तां मामनङ्गग्लपितां त्वत्कृते कुरुनन्दन।\nअनन्यां नन्दयस्वाद्य प्रदानेनात्मनोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011430, "chapter_id": 1233, "verse_number": "१-२३४-२१x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011431, "chapter_id": 1233, "verse_number": "१-२३४-२१", "content_sanskrit": "ब्रह्मचर्यमिदं भद्रे मम द्वादशमासिकम्।\nधर्मराजेन चादिष्टं नाहमस्मि स्वयं वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011432, "chapter_id": 1233, "verse_number": "१-२३४-२२", "content_sanskrit": "तव चापि प्रियं कर्तुमिच्छामि जलचारिणि।\nअनृतं नोक्तपूर्वं च मया किंचन कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011433, "chapter_id": 1233, "verse_number": "१-२३४-२३", "content_sanskrit": "कथं च नानृतं मे स्यात्तव चापि प्रियं भवेत्।\nन च पीड्येत मे धर्मस्तथा कुर्या भुजङ्गमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011434, "chapter_id": 1233, "verse_number": "१-२३४-२४x", "content_sanskrit": "उलूप्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011435, "chapter_id": 1233, "verse_number": "१-२३४-२४", "content_sanskrit": "जानाम्यहं पाण्डवेय यथा चरसि मेदिनीम्।\nयथा च ते ब्रह्मचर्यमिदमादिष्टवान्गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011436, "chapter_id": 1233, "verse_number": "१-२३४-२५", "content_sanskrit": "परस्परं वर्तमानान्द्रुपदस्यात्मजां प्रति।\nयो नोऽनुप्रविशेन्मोहात्स वै द्वादशमासिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011437, "chapter_id": 1233, "verse_number": "१-२३४-२६", "content_sanskrit": "वने चरेद्ब्रह्मचर्यमिति वः समयः कृतः।\nतदिदं दौपदीहेतोरन्योन्यस्य प्रवासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011438, "chapter_id": 1233, "verse_number": "१-२३४-२७", "content_sanskrit": "कृतवांस्तत्र धर्मार्थमत्र धर्मो न दुष्यति।\nपरित्राणं च कर्तव्यमार्तानां पृथुलोचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011439, "chapter_id": 1233, "verse_number": "१-२३४-२८", "content_sanskrit": "कृत्वा मम परित्राणं तव धर्मो न लुप्यते।\nयदि वाप्यस्य धर्मस्य सूक्ष्मोऽपि स्याद्व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011440, "chapter_id": 1233, "verse_number": "१-२३४-२९", "content_sanskrit": "स च ते धर्म एव स्याद्दत्वा प्राणान्ममार्जुन।\nभक्तां च भज मां पार्थ सतामेतन्मतं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011441, "chapter_id": 1233, "verse_number": "१-२३४-३०", "content_sanskrit": "न करिष्यसि चेदेवं मृतां मामुपधारय।\nप्राणदानान्महाबाहो चर धर्ममनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011442, "chapter_id": 1233, "verse_number": "१-२३४-३१", "content_sanskrit": "शरणं च प्रपन्नास्मि त्वामद्य पुरुषोत्तम।\nदीनाननाथान्कौन्तेय परिरक्षसि नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011443, "chapter_id": 1233, "verse_number": "१-२३४-३२", "content_sanskrit": "साऽहं शऱणमभ्येमि रोरवीमि च दुःखिता।\nयाचे त्वां चाभिकामाहं तस्मात्कुरु मम प्रियम्।\nस त्वमात्मप्रदानेन सकामां कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011444, "chapter_id": 1233, "verse_number": "१-२३४-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011445, "chapter_id": 1233, "verse_number": "१-२३४-३३", "content_sanskrit": "एवमुक्तस्तु कौन्तेयः पन्नगेश्वरकन्यया।\nकृतवांस्तत्तथा सर्वं धर्ममुद्दिश्य कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011446, "chapter_id": 1233, "verse_number": "१-२३४-३४", "content_sanskrit": "स नागभवने रात्रिं तामुषित्वा प्रतापवान्।\nपुत्रमुत्पादयामास स तस्यां सुमनोहरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011447, "chapter_id": 1233, "verse_number": "१-२३४-३५", "content_sanskrit": "इरावन्तं महाभागं महाबलपराक्रमम्।\nउदितेऽभ्युत्थितः सूर्ये कौरव्यस्य निवेशनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011448, "chapter_id": 1233, "verse_number": "१-२३४-३६", "content_sanskrit": "आगतस्तु पुनस्तत्र गङ्गाद्वारं तया सह।\nपरित्यज्य गता साध्वी उलूपी निजमन्दिरं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011449, "chapter_id": 1233, "verse_number": "१-२३४-३७", "content_sanskrit": "दत्त्वा वरमजेयत्वं जले सर्वत्र भारत।\nसाध्या जलचराः सर्वे भविष्यन्ति न संशयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011450, "chapter_id": 1233, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अर्जुनवनवासपर्वणि चतुस्त्रिंशदधिकद्विशततमोऽध्यायः॥ २३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]