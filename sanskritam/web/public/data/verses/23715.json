[{"id": 7003715000, "chapter_id": 23715, "verse_number": "१-४-२३-१", "content_sanskrit": "कलाधर उवाच ।\nकांबोजेषु हयो भूत्वा कांतिशाली सुहृन्मम ।\nअयासीदौपवाह्यत्वं भवतो राजपुंगव ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003715001, "chapter_id": 23715, "verse_number": "१-४-२३-२", "content_sanskrit": "अहं च गंधमृगतां गतः स्वांगप्रसूतिना ।\nसुगंधिना मदेनास्य संचारं चाचरं गिरेः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003715002, "chapter_id": 23715, "verse_number": "१-४-२३-३", "content_sanskrit": "धर्मात्मन्मृगयाव्याजादागतेन त्वयाधुना ।\nआवां शोणाद्रिनाथस्य प्रापितौ हि प्रदक्षिणाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003715003, "chapter_id": 23715, "verse_number": "१-४-२३-४", "content_sanskrit": "वाहारोहणदोषेण तवासीदीदृशी दशा ।\nपादप्रचारपुण्येन प्राप्तं नौ प्राक्तनं पदम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003715004, "chapter_id": 23715, "verse_number": "१-४-२३-५", "content_sanskrit": "राजेंद्र तव संबंधादस्मात्तिर्यक्त्वबंधनात् ।\nमुक्तावावां स्वकं धाम प्राप्तौ स्वस्त्यस्तु ते सदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003715005, "chapter_id": 23715, "verse_number": "१-४-२३-६", "content_sanskrit": "इत्युदीर्य निजं धाम यियासंतं कलाधरम् ।\nकांतिशालिनं च राजा जगाद रचितांजलिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003715006, "chapter_id": 23715, "verse_number": "१-४-२३-७", "content_sanskrit": "एवं युवां शोणशैलशंकरस्य प्रभावतः ।\nशापार्णवं समुत्तीर्णौ कथं मे पुनरुच्छ्रयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003715007, "chapter_id": 23715, "verse_number": "१-४-२३-८", "content_sanskrit": "भ्राम्यतीव मम स्वांतमाधाय तदवेक्षणम् ।\nनिर्यांतीव मम प्राणास्तत्र दैवं बलोत्तरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003715008, "chapter_id": 23715, "verse_number": "१-४-२३-९", "content_sanskrit": "कलाधरकांतिशालिनावूचतुः ।\nअवधारय निस्तारं कथयाव तवास्यदम् ।\nसमाहितेन मनसा निर्धूतनिखिलाधिना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003715009, "chapter_id": 23715, "verse_number": "१-४-२३-१०", "content_sanskrit": "जगत्सर्गस्थितिध्वंसविधानानुग्रहेश्वरे ।\nअरुणाद्रीश्वरे चित्तं निधेहि करुणानिधौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003715010, "chapter_id": 23715, "verse_number": "१-४-२३-११", "content_sanskrit": "प्रत्यक्षितं त्वयेदानीमस्य देवस्य वैभवम् ।\nतिरश्चोरावयोरेतदीदृशत्वं वितन्वतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003715011, "chapter_id": 23715, "verse_number": "१-४-२३-१२", "content_sanskrit": "कुरु प्रदक्षिणां पादचारी मृगमदादृतैः ।\nकल्हारैः पूजयेशानं देवं मृगमदप्रियम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003715012, "chapter_id": 23715, "verse_number": "१-४-२३-१३", "content_sanskrit": "यावती तव संपत्तिस्तावतीमखिलां विभो ।\nप्राकारगोपुरागारनवीकाराय कल्पय ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003715013, "chapter_id": 23715, "verse_number": "१-४-२३-१४", "content_sanskrit": "अचिरादेव सिद्धिस्ते भविष्यति गरीयसी ।\nमनुमांधातृनाभागभगीरथवदाधिका ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003715014, "chapter_id": 23715, "verse_number": "१-४-२३-१५", "content_sanskrit": "नंदिकेश्वर उवाच ।\nइत्थं निशम्य च तयोर्निजमेव धाम विद्याभृतोः सपदि संश्रुतयोर्नरेन्द्रः ।\nनिःसंशयेन मनसा निरतस्तदानीं भक्तिं बबंध भगवत्यरुणाद्रिनाथे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003715015, "chapter_id": 23715, "verse_number": "१-४-२३-१६", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्य उत्तरार्धे कलाधरकांतिशालिवृत्तांतवर्णनंनाम त्रयोविंशतितमोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]