[{"id": 50006188, "chapter_id": 11328, "verse_number": "1", "content_sanskrit": "॥ पूर्वपक्षयुक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006189, "chapter_id": 11328, "verse_number": "2", "content_sanskrit": "सुशक्यता शश्वदतिप्रसिद्धिर्विवेकविन्यासविचारसञ्ज्ञाः। 【पाठभेदः: BG—शश्वदतिप्रसिद्धिविवेकविन्यासविचारसञ्ज्ञाः।】 नानाप्रवृत्तिः कृतकृत्यता च विपक्षतर्काः समतीतपादे॥ १२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006190, "chapter_id": 11328, "verse_number": "3", "content_sanskrit": "॥ सिद्धान्तयुक्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006191, "chapter_id": 11328, "verse_number": "4", "content_sanskrit": "महाफलत्वं प्रविविक्तता च सन्धिग्रहः साधनमाप्तकृत्यम्। विशेषकार्यं कृतिसंस्थितिश्च सुयुक्तयो निर्णयगाः स्वपक्षे॥ १२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]