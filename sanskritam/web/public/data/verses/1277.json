[{"id": 2013491, "chapter_id": 1277, "verse_number": "२-१८-१", "content_sanskrit": "राक्षस्युवाच॥\nजरा नामास्मि भद्रं ते राक्षसी कामरूपिणी।\nतव वेश्मनि राजेन्द्र पूजिता न्यवसं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013492, "chapter_id": 1277, "verse_number": "२-१८-२", "content_sanskrit": "गृहे गृहे मनुष्याणां नित्यं तिष्ठामि राक्षसी।\nगृहदेवीति नाम्ना वै पुरा सृष्टा स्वयंम्भुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013493, "chapter_id": 1277, "verse_number": "२-१८-३", "content_sanskrit": "दानवानां विनाशाय स्थापिता दिव्यरूपिणी।\nयो मां भक्त्या लिखेत्कुड्ये सपुत्रां यौवनान्विताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013494, "chapter_id": 1277, "verse_number": "२-१८-४", "content_sanskrit": "गृहे तस्य भवेद्वृद्धिरन्यथा क्षयमाप्नुयात्।\nत्वद्गृहे तिष्ठमानाऽहं पूजिताऽहं सदा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013495, "chapter_id": 1277, "verse_number": "२-१८-५", "content_sanskrit": "लिखिता चैव कुड्येषु पुत्रैर्बहुभिरावृता।\nगन्धपुष्पैस्तथा धूपैर्भक्ष्यभोज्यैः सुपूजिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013496, "chapter_id": 1277, "verse_number": "२-१८-६", "content_sanskrit": "साऽहं प्रत्युपकारार्थं चिन्तयन्त्यनिशं नृप।\nतवेमे पुत्रशकले दृष्टवत्यस्मि धार्मिका।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013497, "chapter_id": 1277, "verse_number": "२-१८-७", "content_sanskrit": "संश्लिषिते मया दैवात्कुमारः समपद्यत।\nतव भाग्यान्महाराज हेतुमात्रमहं त्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013498, "chapter_id": 1277, "verse_number": "२-१८-८", "content_sanskrit": "मेरुं वा खादितुं शक्ता किं पुनस्तव बालकम्।\nगृहसम्पूजनात्तुष्ट्या मया प्रत्यर्पितस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013499, "chapter_id": 1277, "verse_number": "२-१८-९", "content_sanskrit": "मम नाम्ना च लोकेऽस्मिन्ख्यात एव भविष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013500, "chapter_id": 1277, "verse_number": "२-१८-९x", "content_sanskrit": "कृष्ण उवाच।\nएवमुक्त्वा तु सा राजंस्तत्रैवान्तरधीयत।\nस सङ्गृह्य कुमारं तं प्रविवेश गृहं नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013501, "chapter_id": 1277, "verse_number": "२-१८-१०", "content_sanskrit": "तस्य बालस्य यत्कृत्यं तच्चकार नृपस्तदा।\nआज्ञापयच्च राक्षस्या मगधेषु महोत्सवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013502, "chapter_id": 1277, "verse_number": "२-१८-११", "content_sanskrit": "तस्य नामाकरोच्चैव पितामहसमः पिता।\nजरया सन्धितो यस्माज्जरासन्धो भवत्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013503, "chapter_id": 1277, "verse_number": "२-१८-१२", "content_sanskrit": "सोऽवर्धत महातेजा मागधाधिपतेः सुतः।\nप्रमाणबलसम्पन्नो हुताहुतिरिवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013504, "chapter_id": 1277, "verse_number": "२-१८-१३", "content_sanskrit": "एवं स ववृधे राजन्कुमारः पुष्करेक्षणः।\nकालेन महता चापि यौवनस्थो बभूव ह॥\nमातापित्रोर्नन्दकरः शुक्लपक्षे यथा शशी॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013505, "chapter_id": 1277, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि अष्टादशोऽध्यायः॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]