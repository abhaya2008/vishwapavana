[{"id": 2085130, "chapter_id": 2810, "verse_number": "१२-३१५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085131, "chapter_id": 2810, "verse_number": "१२-३१५-१", "content_sanskrit": "धर्माधर्मविमुक्तं यद्विमुक्तं सर्वसंशयात्।\nजन्ममृत्युविमुक्तं च विमुक्तं पुण्यपापयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085132, "chapter_id": 2810, "verse_number": "१२-३१५-२", "content_sanskrit": "यच्छिवं नित्यमभयं नित्यमक्षरमव्ययम्।\nशुचि नित्यमनायासं तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085133, "chapter_id": 2810, "verse_number": "१२-३१५-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085134, "chapter_id": 2810, "verse_number": "१२-३१५-३", "content_sanskrit": "अत्र ते वर्तयिष्यामि इतिहासं पुरातनम्।\nयाज्ञवल्क्यस्य संवादं जनकस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085135, "chapter_id": 2810, "verse_number": "१२-३१५-४", "content_sanskrit": "याज्ञवल्क्यमृषिश्रेष्ठं दैवरातिर्महायशाः।\nपप्रच्छ जनको राजा प्रश्नं प्रश्नविदांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085136, "chapter_id": 2810, "verse_number": "१२-३१५-५x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085137, "chapter_id": 2810, "verse_number": "१२-३१५-५", "content_sanskrit": "कतीन्द्रियाणि विप्रर्षे कति प्रकृतयः स्मृताः।\nकिमव्यक्तं परं ब्रह्म तस्माच्च परतस्तु किम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085138, "chapter_id": 2810, "verse_number": "१२-३१५-६", "content_sanskrit": "प्रभवं चाप्ययं चैव कालसङ्ख्यां तथैव च।\nवक्तुमर्हसि विप्रेन्द्र त्वदनुग्रहकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085139, "chapter_id": 2810, "verse_number": "१२-३१५-७", "content_sanskrit": "अज्ञानात्परिपृच्छामि त्वं हि ज्ञानमयो निधिः।\nतदहं श्रोतुमिच्छामि सर्वमेतदसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085140, "chapter_id": 2810, "verse_number": "१२-३१५-८x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085141, "chapter_id": 2810, "verse_number": "१२-३१५-८", "content_sanskrit": "श्रूयतामवनीपाल यदेतदनुपृच्छसि।\nयोगानां परमं ज्ञानं साङ्ख्यानां च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085142, "chapter_id": 2810, "verse_number": "१२-३१५-९", "content_sanskrit": "त तवाविदितं किंचिन्मां तु जिज्ञासते भवान्।\nपृष्टेन चापि वक्तव्यमेष धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085143, "chapter_id": 2810, "verse_number": "१२-३१५-१०", "content_sanskrit": "अष्टौ प्रकृतयः प्रोक्ता विकाराश्चापि षोडश।\nआसां तु सप्त व्यक्तानि प्राहुरध्यात्मचिन्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085144, "chapter_id": 2810, "verse_number": "१२-३१५-११", "content_sanskrit": "अव्यक्तं च महांश्चैव तथाऽहंकार एव च।\nपृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085145, "chapter_id": 2810, "verse_number": "१२-३१५-१२", "content_sanskrit": "एताः प्रकृतयस्त्वष्टौ विकारानपि मे शृणु।\nश्रोत्रं त्वक्चैव चक्षुश्च जिह्वा घ्राणं च पञ्चमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085146, "chapter_id": 2810, "verse_number": "१२-३१५-१३", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धस्तथैव च।\nवाक्च हस्तौ च पादौ च पायुर्मेढ्रं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085147, "chapter_id": 2810, "verse_number": "१२-३१५-१४", "content_sanskrit": "एते विशेषा राजेन्द्रा महाभूतेषु पञ्चसु।\nबुद्धीन्द्रियाण्यथैतानि सविशेषाणि मैथिल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085148, "chapter_id": 2810, "verse_number": "१२-३१५-१५", "content_sanskrit": "मनः षोडशकं प्राहुरध्यात्मगतिचिन्तकाः।\nत्वं चैवान्ये च विद्वांसस्तत्त्वबुद्धिविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085149, "chapter_id": 2810, "verse_number": "१२-३१५-१६", "content_sanskrit": "अव्यक्ताच्च महानात्मा समुत्पद्यति पार्थिव।\nप्रथमं सर्गमित्येतदाहुः प्राधानिकं बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085150, "chapter_id": 2810, "verse_number": "१२-३१५-१७", "content_sanskrit": "महतश्चाप्यहंकार उत्पद्यति नराधिप।\nद्वितीयं सर्गमित्याहुरेतद्बुद्ध्यात्मकं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085151, "chapter_id": 2810, "verse_number": "१२-३१५-१८", "content_sanskrit": "अहंकाराच्च संभूतं मनो भूतगुणात्मकम्।\nतृतीयः सर्ग इत्येष आहंकारिक उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085152, "chapter_id": 2810, "verse_number": "१२-३१५-१९", "content_sanskrit": "मनसस्तु समुद्भूता महाभूता नराधिप।\nचतुर्थं सर्गमित्येतन्मानसं चिन्तनात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085153, "chapter_id": 2810, "verse_number": "१२-३१५-२०", "content_sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धस्तथैव च।\nपञ्चमं सर्गमित्याहुर्भौतिकं भूतचिन्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085154, "chapter_id": 2810, "verse_number": "१२-३१५-२१", "content_sanskrit": "श्रोत्रं त्वक्चैव चक्षुश्च जिह्वा घ्राणं च पञ्चमम्।\nसर्गं तु षष्ठमित्याहुर्बहुचिन्तात्मकं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085155, "chapter_id": 2810, "verse_number": "१२-३१५-२२", "content_sanskrit": "अधः श्रोत्रेन्द्रियग्राम उत्पद्यदि नराधिप।\nसप्तमं सर्गमित्याहुरेतदैन्द्रियकं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085156, "chapter_id": 2810, "verse_number": "१२-३१५-२३", "content_sanskrit": "ऊर्ध्वं स्रोतस्तथा तिर्यगुत्पद्यति नराधिप।\nअष्टमं सर्गमित्याहुरेतदार्जवकं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085157, "chapter_id": 2810, "verse_number": "१२-३१५-२४", "content_sanskrit": "तिर्यक्स्रोतस्त्वधःस्रोत उत्पद्यति नराधिप।\nनवमं सर्गमित्याहुरेतदार्जवकं बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085158, "chapter_id": 2810, "verse_number": "१२-३१५-२५", "content_sanskrit": "एते वै नव सर्गा हि तत्त्वानि च नराधिप।\nचतुर्विशतिरुक्तानि यथाश्रुतिनिदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2085159, "chapter_id": 2810, "verse_number": "१२-३१५-२६", "content_sanskrit": "अत ऊर्ध्वं महाराज गुणस्यैतस्य तत्त्वतः।\nमहात्मभिरनुप्रोक्तां कालसङ्ख्यां निबोध मे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2085160, "chapter_id": 2810, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चदशाधिकत्रिशततमोऽध्यायः॥ ३१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]