[{"id": 2101048, "chapter_id": 3171, "verse_number": "१४-२७-१", "content_sanskrit": "ब्राह्मण उवाच।\nएकः शास्ता न द्वितीयोस्ति शास्ता\nयो हृच्छयस्तमहमनु ब्रवीमि।\nतेनैव युक्तः प्रवणादिवोदकं\nयथा नियुक्तोस्मि तथा वहामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101049, "chapter_id": 3171, "verse_number": "१४-२७-२", "content_sanskrit": "एको गुरुर्नास्ति ततो द्वितीयो\nयो हृच्छयस्तमहमनु ब्रवीमि।\nतेनानुशिष्टा गुरुणा सदैव\nपुरा हता दानवाः सर्व एव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101050, "chapter_id": 3171, "verse_number": "१४-२७-३", "content_sanskrit": "एको बन्धुर्नास्ति ततो द्वितीयो\nयो हृच्छयस्तमहमनु ब्रवीमि।\nतेनानुशिष्टा बान्धवा बन्धुमन्तः\nसप्तर्षयः पार्थ दिवि प्रभान्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101051, "chapter_id": 3171, "verse_number": "१४-२७-४", "content_sanskrit": "एकः श्रोता नास्ति ततो द्वितीयो\nयो हृच्छयस्तमहमनु ब्रवीमि।\nतस्मिन्गुरौ गुरुवासं निरुष्यट\nशक्रो गतः सर्वलोकामरत्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101052, "chapter_id": 3171, "verse_number": "१४-२७-५", "content_sanskrit": "एको द्वेष्टा नास्ति ततो द्वितीयो\nयो हृच्छयस्तमहमनु ब्रवीमि।\nतेनानुशिष्टा गुरुणा सदैव\nलोके द्विष्टाः पन्नगाः सर्व एव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101053, "chapter_id": 3171, "verse_number": "१४-२७-६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nप्रजापतौ पन्नगानां देवर्षीणां च संविदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101054, "chapter_id": 3171, "verse_number": "१४-२७-७", "content_sanskrit": "देवर्षयश्च नागाश्चाप्यसुराश्च प्रजापतिम्।\nपर्यपृच्छन्नुपासीनं श्रेयोः नः प्रोच्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101055, "chapter_id": 3171, "verse_number": "१४-२७-८", "content_sanskrit": "तेषां प्रोवाच भगवाञ्श्रेयः समनुपृच्छताम्।\nओमित्येकाक्षरं ब्रह्म ते श्रुत्वा प्राद्रवन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101056, "chapter_id": 3171, "verse_number": "१४-२७-९", "content_sanskrit": "तेषां प्रद्रवमाणानामुपदेशं च शृण्वताम्।\nसर्पाणां दंशने भावः प्रवृत्तः पूर्वमे तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101057, "chapter_id": 3171, "verse_number": "१४-२७-१०", "content_sanskrit": "असुराणां प्रवृत्तस्तु दंभभावः स्वभावजः।\nदानं देवा व्यवसिता दममेव महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101058, "chapter_id": 3171, "verse_number": "१४-२७-११", "content_sanskrit": "एकं शास्तारमासाद्य शब्देनैकेन संस्कृताः।\nनानाव्यवसिताः सर्वे सर्पदेवर्षिदानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101059, "chapter_id": 3171, "verse_number": "१४-२७-१२", "content_sanskrit": "शृणोत्ययं प्रोच्यमानं गृह्णाति च यथातथम्।\nपृच्छतस्तदतो भूयो गुरुरन्यो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101060, "chapter_id": 3171, "verse_number": "१४-२७-१३", "content_sanskrit": "तस्य चानुमते कर्म ततः पश्चात्प्रवर्तते।\nगुरुर्बन्धुश्च शास्ता च द्वेष्टा च हृदि संश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101061, "chapter_id": 3171, "verse_number": "१४-२७-१४", "content_sanskrit": "पापेन विचरँल्लोके पापचारी भवत्ययम्।\nशुभेन विचरँल्लोके शुभचारी भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101062, "chapter_id": 3171, "verse_number": "१४-२७-१५", "content_sanskrit": "कामचारी तु कामेन य हन्द्रियसुखे रतः।\nब्रह्मचारी सदैवैष य इन्द्रियजये रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101063, "chapter_id": 3171, "verse_number": "१४-२७-१६", "content_sanskrit": "अपेतव्रतकर्मा तु केवलं ब्रह्मणि स्थितः।\nब्रह्मभूतश्चरँल्लोके ब्रह्मचारी भवत्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101064, "chapter_id": 3171, "verse_number": "१४-२७-१७", "content_sanskrit": "ब्रह्मैव समिधस्तस्य ब्रह्माग्निर्ब्रह्मसंस्तरः।\nआपो ब्रह्म गुरुर्ब्रह्म स ब्रह्मणि समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101065, "chapter_id": 3171, "verse_number": "१४-२७-१८", "content_sanskrit": "एतदेवेदृशं सूक्ष्मं ब्रह्मचर्यं विदुर्बुधाः।\nविदित्वा चान्वपद्यन्त क्षेत्रज्ञेनानुदर्शिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101066, "chapter_id": 3171, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि सप्तविंशोऽध्यायः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]