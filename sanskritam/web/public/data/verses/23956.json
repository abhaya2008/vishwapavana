[{"id": 7003956000, "chapter_id": 23956, "verse_number": "३-१-१९-१", "content_sanskrit": "श्रीसूत उवाच ।\nतारकब्रह्मणस्तस्य तीर्थे स्नात्वा द्विजोत्तमाः ।\nलक्ष्मणस्य ततस्तीर्थमभिगच्छेत्समाहितः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003956001, "chapter_id": 23956, "verse_number": "३-१-१९-२", "content_sanskrit": "श्रीलक्ष्मणस्य तीर्थे तु स्नात्वा पापैर्विमोचिताः ।\nमुक्तिं प्रयांति विमलामपुनर्भवलक्षणाम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003956002, "chapter_id": 23956, "verse_number": "३-१-१९-३", "content_sanskrit": "स्नानाल्लक्ष्मणतीर्थे तु दारिद्र्यं नश्यतेखिलम् ।\nआयुष्मान्गुणवान्विद्वान्पुत्रश्चैवास्य जायते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003956003, "chapter_id": 23956, "verse_number": "३-१-१९-४", "content_sanskrit": "कूले लक्ष्मणतीर्थस्य तन्मन्त्रं जपते तु यः ।\nस सर्वशास्त्रवेत्ता स्याच्चतुर्वेदविदप्यसौ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003956004, "chapter_id": 23956, "verse_number": "३-१-१९-५", "content_sanskrit": "तस्य कूले महल्लिंगं स्थापयामास लक्ष्मणः ।\nतत्र तीर्थे तु यः स्नात्वा सेवते लक्ष्मणेश्वरम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003956005, "chapter_id": 23956, "verse_number": "३-१-१९-६", "content_sanskrit": "इह दारिद्र्यरोगाभ्यां संसाराच्च विमुच्यते ।\nस्नात्वा लक्ष्मणतीर्थे तु सेवित्वा लक्ष्मणेश्वरम् ।\nबलभद्रः पुरा विप्रा मुमुचे ब्रह्महत्यया॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003956006, "chapter_id": 23956, "verse_number": "३-१-१९-७", "content_sanskrit": "ऋषय ऊचुः ।\nब्रह्महत्या कथमभूद्रौहिणेयस्य सूतज ।\nकथं चात्र विनष्टा सा तन्नो ब्रूहि महामुने॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003956007, "chapter_id": 23956, "verse_number": "३-१-१९-८", "content_sanskrit": "श्रीसूत उवाच ।\nशेषावतारो भगवान्बलभद्रः पुरा द्विजाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003956008, "chapter_id": 23956, "verse_number": "३-१-१९-९", "content_sanskrit": "कुरूणां पांडवानां च युद्धोद्योगं विलोक्य तु ।\nबंधूनां स वधं सोढुमसमर्थो हलायुधः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003956009, "chapter_id": 23956, "verse_number": "३-१-१९-१०", "content_sanskrit": "विचारमेवमकरोद्बलभद्रो महामतिः ।\nयद्यहं कुरुराजस्य करिष्यामि सहायताम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003956010, "chapter_id": 23956, "verse_number": "३-१-१९-११", "content_sanskrit": "कोपः स्यात्पांडुपुत्राणां मय्यवार्यः सुदारुणः ।\nउपकारं करिष्यामि पांडवानामहं यदि॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003956011, "chapter_id": 23956, "verse_number": "३-१-१९-१२", "content_sanskrit": "दुर्योधनस्य कोपः स्यादिति बुद्ध्वा हलायुधः ।\nतीर्थयात्राच्छलेनासौ मध्यस्थः प्रययौ तदा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003956012, "chapter_id": 23956, "verse_number": "३-१-१९-१३", "content_sanskrit": "प्रभासमभिगम्याथ स्नात्वा संकल्पपूर्वकम् ।\nदेवानृषीन्पितृगणांस्तर्पयामास वारिणा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003956013, "chapter_id": 23956, "verse_number": "३-१-१९-१४", "content_sanskrit": "सरस्वतीं ततः प्रायात्प्रतीच्यभिमुखां हली ।\nपृथूदकं बिंदुसरो मुक्तिदं ब्रह्मतीर्थकम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003956014, "chapter_id": 23956, "verse_number": "३-१-१९-१५", "content_sanskrit": "गंगां च यमुनां सिंधुं शतद्रूं च सुदर्शनम् ।\nसंप्राप्य बलभद्रोऽयं स्नात्वा तीर्थेषु धर्मतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003956015, "chapter_id": 23956, "verse_number": "३-१-१९-१६", "content_sanskrit": "प्रपेदे नैमिषारण्यं मुनींद्रैरभिसेवितम् ।\nआगतं तं विलोक्याथ नैमिषीयास्तपस्विनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003956016, "chapter_id": 23956, "verse_number": "३-१-१९-१७", "content_sanskrit": "दीर्घसत्रे स्थिताः सम्यङ्नियता धर्मतत्पराः ।\nअभ्युद्गम्य यदुश्रेष्ठं प्रणम्योत्थाय चासनात्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003956017, "chapter_id": 23956, "verse_number": "३-१-१९-१८", "content_sanskrit": "अपूजयन्विष्टराद्यैः कंदमूलफलैस्तदा ।\nआसनं परिगृह्यायं पूजितः सपुरःसरः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003956018, "chapter_id": 23956, "verse_number": "३-१-१९-१९", "content_sanskrit": "उच्चासने स्थितं सूतमनमंतमनुत्थितम् ।\nअकृतांजलिमासीनं व्यासशिष्यं विलोक्य सः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003956019, "chapter_id": 23956, "verse_number": "३-१-१९-२०", "content_sanskrit": "विप्रांश्चानमतो दृष्ट्वा विलोक्यात्मानमागतम् ।\nचुक्रोध रोहिणीसूनुः सूतं पौराणिकोत्तमम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003956020, "chapter_id": 23956, "verse_number": "३-१-१९-२१", "content_sanskrit": "मध्ये मुनीनां सूतोऽयं कस्मान्निंद्योऽनुलोमजः ।\nउच्चासने समध्यास्ते न युक्तमिदमंजसा॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003956021, "chapter_id": 23956, "verse_number": "३-१-१९-२२", "content_sanskrit": "अवमत्य भृशं चास्मान्धर्मसंरक्षकानयम् ।\nआस्तेऽनुत्थाय निर्भीतिर्न च प्रणमते तथा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003956022, "chapter_id": 23956, "verse_number": "३-१-१९-२३", "content_sanskrit": "पठित्वायं पुराणानि द्वैपायनसकाशतः ।\nसेतिहासानि सर्वाणि धर्मशास्त्राण्यनेकशः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003956023, "chapter_id": 23956, "verse_number": "३-१-१९-२४", "content_sanskrit": "न मां दृष्ट्वा प्रणमते नैव त्यजति चासनम् ।\nद्वैपायनस्य महतः शिष्याः पैलादयो द्विजाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003956024, "chapter_id": 23956, "verse_number": "३-१-१९-२५", "content_sanskrit": "एवंविधमधर्मं ते नैव कुर्युर्यथा त्वयम् ।\nतस्मादेनं वधिष्यामि दुरात्मानमचेतनम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003956025, "chapter_id": 23956, "verse_number": "३-१-१९-२६", "content_sanskrit": "दुष्टानां निग्रहार्थं हि भूर्लोकमहमागमम् ।\nमया हतो हि दुष्टात्मा शुद्धिमेष्यत्यसंशयम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003956026, "chapter_id": 23956, "verse_number": "३-१-१९-२७", "content_sanskrit": "इत्युक्त्वा भगवान्रामो मुसली प्रबलो हली ।\nपाणिस्थेन कुशाग्रेण तच्छिरः प्राच्छिनद्रुषा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003956027, "chapter_id": 23956, "verse_number": "३-१-१९-२८", "content_sanskrit": "तत्रत्या मुनयः सर्वे हा कष्टमिति चुक्रुशुः ।\nअवादिषुस्तदा रामं मुनयो ब्रह्मवादिनः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003956028, "chapter_id": 23956, "verse_number": "३-१-१९-२९", "content_sanskrit": "रामाधर्मः कृतः कष्टस्त्वया संकर्षण प्रभो ।\nअस्य सूतस्य चास्माभिर्दत्तं ब्रह्मासनं महत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003956029, "chapter_id": 23956, "verse_number": "३-१-१९-३०", "content_sanskrit": "अक्षयं चायुरस्माभिरस्य दत्तं हलायुध ।\nभवताऽजानतैवाद्य कृतो ब्रह्मवधो महान्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003956030, "chapter_id": 23956, "verse_number": "३-१-१९-३१", "content_sanskrit": "योगेश्वरस्य भवतो नास्ति कश्चिन्नियामकः ।\nअस्यास्तु ब्रह्महत्याया यत्कर्त्तव्यं विचार्य तत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003956031, "chapter_id": 23956, "verse_number": "३-१-१९-३२", "content_sanskrit": "प्रायश्चित्तं भवानेव लोकसंग्रहणाय तु ।\nकुरुष्व भगवन्राम नान्येन प्रेरितः कुरु ।\nइत्युक्तो भगवान्रामस्तानुवाच मुनीन्प्रति॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003956032, "chapter_id": 23956, "verse_number": "३-१-१९-३३", "content_sanskrit": "राम उवाच ।\nप्रायश्चित्तं चरिष्याभि पापशोधकमास्तिकाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003956033, "chapter_id": 23956, "verse_number": "३-१-१९-३४", "content_sanskrit": "लोकसंग्रहणार्थाय नान्यकामनयाऽधुना ।\nयादृशो नियमोऽस्माभिः कर्तव्यः पापशांतये॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003956034, "chapter_id": 23956, "verse_number": "३-१-१९-३५", "content_sanskrit": "तादृशं नियमं त्वद्य भवतः प्रब्रुवंतु नः ।\nभवद्भिरस्य सूतस्य यदायुर्दत्तमक्षयम् ।\nइंद्रियाणि च सत्त्वं च करिष्ये योगमायया॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003956035, "chapter_id": 23956, "verse_number": "३-१-१९-३६", "content_sanskrit": "मुनय ऊचुः ।\nपराक्रमस्य तेस्त्रस्य मृत्योर्नश्च यथा प्रभो ।\nस्यात्सत्यवचनं राम तद्भवान्कर्तुमर्हति॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003956036, "chapter_id": 23956, "verse_number": "३-१-१९-३७", "content_sanskrit": "राम उवाच ।\nआत्मा वै पुत्ररूपेण भवतीति श्रुतिस्सदा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003956037, "chapter_id": 23956, "verse_number": "३-१-१९-३८", "content_sanskrit": "उद्घोषयति विप्रेंद्रास्तस्मादस्य शरीरतः ।\nपुत्रो भवतु दीर्घायुः सत्त्वेंद्रिय बलोर्जितः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003956038, "chapter_id": 23956, "verse_number": "३-१-१९-३९", "content_sanskrit": "कथयिष्यति युष्माकं पुराणादीनि सोऽन्वहम् ।\nसंभविष्यति सर्वज्ञो योगमायाबलान्मम॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003956039, "chapter_id": 23956, "verse_number": "३-१-१९-४०", "content_sanskrit": "इत्युक्त्वा रौहिणेयस्तान्पुनः प्रश्रितमब्रवीत् ।\nमनोभिलषितं किं वा युष्माकं करवाण्यहम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003956040, "chapter_id": 23956, "verse_number": "३-१-१९-४१", "content_sanskrit": "तद्ब्रूत मुनयो यूयं करिष्यामि न संशयः ।\nअज्ञानान्मत्कृतस्यास्य पापस्यापि निवर्तकम् ।\nप्रायश्चित्तं भवन्तो मे प्रब्रूत मुनिसत्तमाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003956041, "chapter_id": 23956, "verse_number": "३-१-१९-४२", "content_sanskrit": "मुनय ऊचुः ।\nइल्वलस्यात्मजः कश्चिद्दानवो बल्वलाभिधः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003956042, "chapter_id": 23956, "verse_number": "३-१-१९-४३", "content_sanskrit": "स दूषयति नो यागं रामेहागत्य पर्वणि ।\nदुष्टं तं दानवं पापं जहि लोकैककण्टकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003956043, "chapter_id": 23956, "verse_number": "३-१-१९-४४", "content_sanskrit": "अनेन पूजा ह्यस्माकं कृता स्याद्भवताधुना ।\nअस्थिविण्मूत्ररक्तानि सुरामांसानि च क्रतौ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003956044, "chapter_id": 23956, "verse_number": "३-१-१९-४५", "content_sanskrit": "सदाभिवर्षतेऽस्माकमत्रागत्य स दानवः ।\nअस्मिन्भारतभूभागे यानि तीर्थानि संति हि॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003956045, "chapter_id": 23956, "verse_number": "३-१-१९-४६", "content_sanskrit": "तेषु स्नाह्यब्दमेकं त्वं सर्वेषु सुसमाहितः ।\nतेन ते पापशांतिः स्यान्नात्र कार्या विचारणा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003956046, "chapter_id": 23956, "verse_number": "३-१-१९-४७", "content_sanskrit": "श्रीसूत उवाच ।\nपर्वकाले तु विप्रेंद्राः समावृत्ते मुनिक्रतौ ।\nमहाभीमो रजोवर्षो झंझावातश्च भीषणः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003956047, "chapter_id": 23956, "verse_number": "३-१-१९-४८", "content_sanskrit": "प्रादुर्बभूव विप्रेंद्राः पूयरक्तैश्च वर्षणम् ।\nततो विष्ठामया वृष्टिर्बल्वलेन कृताप्यभूत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003956048, "chapter_id": 23956, "verse_number": "३-१-१९-४९", "content_sanskrit": "असुरं यज्ञशालायां शूलपाणिमथ क्षणात् ।\nअपश्यद्बलभद्रोऽसौ महाबलपराक्रमम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003956049, "chapter_id": 23956, "verse_number": "३-१-१९-५०", "content_sanskrit": "तमालोक्य महादेहं दग्धाद्रिप्रतिमं तदा ।\nप्रतप्तताम्रसंकाशश्मश्रुदंष्ट्रोत्कटाननम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003956050, "chapter_id": 23956, "verse_number": "३-१-१९-५१", "content_sanskrit": "चिंतयामास मुसलं रामः परविदारणम् ।\nसीरं च दानवहरं गदां दैत्यविदारिणीम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003956051, "chapter_id": 23956, "verse_number": "३-१-१९-५२", "content_sanskrit": "यान्यायुधानि तं रामं चिंतितान्युपतस्थिरे ।\nसीराग्रेण तमाकृष्य बल्वलं खेचरं तदा॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003956052, "chapter_id": 23956, "verse_number": "३-१-१९-५३", "content_sanskrit": "मुसलेन निजघ्ने स कुपितो मूर्ध्नि वेगतः ।\nपपात भुवि संक्षुण्णललाटो रक्तमुद्वमन्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003956053, "chapter_id": 23956, "verse_number": "३-१-१९-५४", "content_sanskrit": "बल्वलो दीनकथनो गिरिर्वज्रहतो यथा ।\nस्तुत्वाथ मुनयो रामं प्रोच्चार्य विमलाशिषः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003956054, "chapter_id": 23956, "verse_number": "३-१-१९-५५", "content_sanskrit": "अभ्यषिंचञ्च्छुभैस्तोयैर्वृत्रशत्रुं यथा सुराः ।\nमालां ददुर्वैजयन्तीं श्रीमदंबुज शोभिताम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003956055, "chapter_id": 23956, "verse_number": "३-१-१९-५६", "content_sanskrit": "माधवाय शुभे वस्त्रे भूषणानि शुभानि च ।\nधारयंस्तानि सर्वाणि रौहिणेयो महाबलः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003956056, "chapter_id": 23956, "verse_number": "३-१-१९-५७", "content_sanskrit": "पुष्पितानोकहोपेतः कैलास इव पर्वतः ।\nअनुज्ञातोऽथ मुनिभिः सर्वतीर्थेषु स द्विजाः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003956057, "chapter_id": 23956, "verse_number": "३-१-१९-५८", "content_sanskrit": "एकमब्दं चरन्सस्नौ नियमाचारसंयुतः ।\nततः संवत्सरे पूर्णे कालिंदीभेदनो बलः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003956058, "chapter_id": 23956, "verse_number": "३-१-१९-५९", "content_sanskrit": "समाप्ततीर्थयात्रः सन्पुरीं गन्तुं प्रचक्रमे ।\nततस्तमोमयीं छायां पृष्ठतोनुगतां कृशाम्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003956059, "chapter_id": 23956, "verse_number": "३-१-१९-६०", "content_sanskrit": "अपश्यद्बलदेवोयं महानादविराविणीम् ।\nअथ वार्ता स शुश्राव समुद्भूतां तदांबरे॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003956060, "chapter_id": 23956, "verse_number": "३-१-१९-६१", "content_sanskrit": "रामराम महाबाहो रौहिणेय सितप्रभ ।\nतीर्थाभिगमनेनाद्य चरितेन त्वयाऽनघ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003956061, "chapter_id": 23956, "verse_number": "३-१-१९-६२", "content_sanskrit": "न नष्टा ब्रह्महत्या ते निःशेषं रोहिणीसुत ।\nइति वार्तां समाकर्ण्य चिंतयामास वै बलः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003956062, "chapter_id": 23956, "verse_number": "३-१-१९-६३", "content_sanskrit": "प्रायश्चित्तं मया चीर्णमेकाब्दं तीर्थ सेवया ।\nतथापि ब्रह्महत्या सा न नष्टेति श्रुतं वचः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003956063, "chapter_id": 23956, "verse_number": "३-१-१९-६४", "content_sanskrit": "किं कुर्म इति संचिंत्य नैमिषारण्यमभ्यगात् ।\nतत्र गत्वा मुनीनां तन्न्यवेदयदरिंदमः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003956064, "chapter_id": 23956, "verse_number": "३-१-१९-६५", "content_sanskrit": "यच्छ्रुतं गगने वाक्यं या च दृष्टा तमोमयी ।\nन्यवेदयत तत्सर्वं मुनीनां रोहिणीसुतः ।\nतच्छ्रुत्वा मुनयः सर्वे रामं वाक्यमथाब्रुवन्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003956065, "chapter_id": 23956, "verse_number": "३-१-१९-६६", "content_sanskrit": "मुनय ऊचुः ।\nयदि राम न नष्टा ते ब्रह्महत्या तु कृत्स्नशः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003956066, "chapter_id": 23956, "verse_number": "३-१-१९-६७", "content_sanskrit": "तर्हि गच्छ महाभाग गंधमादनपर्वतम् ।\nमहादुःख प्रशमनं महारोगविनाशनम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003956067, "chapter_id": 23956, "verse_number": "३-१-१९-६८", "content_sanskrit": "रामसेतौ महापुण्ये गन्धमादनपर्वते ।\nअस्ति लक्ष्मणतीर्थाख्यं सरः पापविनाशनम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003956068, "chapter_id": 23956, "verse_number": "३-१-१९-६९", "content_sanskrit": "स्नानं कुरुष्व तत्र त्वं तल्लिंगं च नमस्कुरु ।\nनिःशेषं तेन नष्टा स्याद्ब्रह्महत्या न संशयः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003956069, "chapter_id": 23956, "verse_number": "३-१-१९-७०", "content_sanskrit": "श्रीसूत उवाच ।\nएवमुक्तस्तदा रामो गन्धमादनपर्वतम् ।\nगत्वा लक्ष्मणतीर्थं च प्राप्तवान्मुनिपुंगवाः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003956070, "chapter_id": 23956, "verse_number": "३-१-१९-७१", "content_sanskrit": "स्नात्वा संकल्पपूर्वं तु तत्र तीर्थे हलायुधः ।\nब्राह्मणेभ्यो ददौ वित्तं धान्यं गाश्च वसुन्धराम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003956071, "chapter_id": 23956, "verse_number": "३-१-१९-७२", "content_sanskrit": "तस्मिन्नवसरे तत्र राममाहाशरीरवाक् ।\nनिःशेषं राम नष्टा ते ब्रह्महत्याधुना त्विह॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003956072, "chapter_id": 23956, "verse_number": "३-१-१९-७३", "content_sanskrit": "संदेहो नात्र कर्तव्यः सुखं याहि पुरीं निजाम् ।\nतच्छ्रुत्वा बलभद्रोऽथ तत्तीर्थं प्रशशंस ह॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003956073, "chapter_id": 23956, "verse_number": "३-१-१९-७४", "content_sanskrit": "ततस्तत्रत्यतीर्थेषु स्नात्वा सर्वेषु माधवः ।\nधनुष्कोटौ तथा स्नात्वा रामनाथं निषेव्य च ।\nद्वारकां स्वपुरीं प्रायान्नष्टपातकसंचयः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003956074, "chapter_id": 23956, "verse_number": "३-१-१९-७५", "content_sanskrit": "श्रीसूत उवाच ।\nएवं वः कथितं विप्राः श्रीलक्ष्मणसरोऽमलम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003956075, "chapter_id": 23956, "verse_number": "३-१-१९-७६", "content_sanskrit": "पुण्यं पवित्रं पापघ्नं ब्रह्महत्यादिशोधकम् ।\nयः पठेदिममध्यायं शृणुयाद्वा समाहितः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003956076, "chapter_id": 23956, "verse_number": "३-१-१९-७७", "content_sanskrit": "स याति मुक्तिं विप्रेंद्राः पुनरावृत्तिवर्जिताम्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]