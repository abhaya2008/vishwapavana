[{"id": 6000110000, "chapter_id": 10110, "verse_number": null, "content_sanskrit": "अथ पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000110001, "chapter_id": 10110, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.001.m4a", "display_order": 2}, {"id": 6000110002, "chapter_id": 10110, "verse_number": "५-१५-१", "content_sanskrit": "भरतस्यात्मजः सुमतिर्नामाऽभिहितो यमु ह वाव केचित्पाषण्डिनो विलोक्य ऋषभपदवी-मनुवर्तमानमनार्या अवेदसमाम्नातां देवतां स्वमनीषया पापीयसीं कलौ कल्पयिष्यन्ति॥ ५/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.002.m4a", "display_order": 3, "topics": [{"text": "भरतवंशकथनम्", "range": "१–६"}]}, {"id": 6000110003, "chapter_id": 10110, "verse_number": "५-१५-२", "content_sanskrit": "तस्माद्गृध्रसेनायां देवपादिर्नाम पुत्रोऽभवत्॥ ५/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.003.m4a", "display_order": 4}, {"id": 6000110004, "chapter_id": 10110, "verse_number": "५-१५-३", "content_sanskrit": "अथासुर्यां तत्तनयो देवद्युम्नः ततो धेनुमत्यां सुतः परमेष्ठी, तस्य सुवर्चलायां प्रतीह उपजातो य आत्मविद्यायां स्वयमखिलायां संसिद्धो महापुरुषमनुसस्मार॥ ५/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.004.m4a", "display_order": 5}, {"id": 6000110005, "chapter_id": 10110, "verse_number": "५-१५-४", "content_sanskrit": "प्रतीहात्सुवर्चलायां प्रतिहर्तादयस्‍त्रय आसन् इज्याकोविदाः सूनवः, प्रतिहर्तुः स्तुत्यां व्योमभूमानावजनिषाताम्॥ ५/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.005.m4a", "display_order": 6}, {"id": 6000110006, "chapter_id": 10110, "verse_number": "५-१५-५", "content_sanskrit": "व्योम्न ऋषिकुल्यायामुद्गीथः, ततः प्रस्तोता देवकुल्यायां, प्रस्तोतुर्विरुरुत्सायां हृदयज आसीद्विभुः विभो रत्यां च पृथुषेणसः तस्मान्नक्त आकूत्यां जज्ञे, नक्ताद्रतिपुत्रो गयो राजर्षिप्रवर उदारश्रवा अजायत साक्षाद्भगवतो विष्णोर्जगदभिरक्षया गृहीतसत्त्वस्य कलात्मवत्ताभिलक्षणेन महापुरुषतां प्राप्तः॥ ५/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.006.m4a", "display_order": 7}, {"id": 6000110007, "chapter_id": 10110, "verse_number": "५-१५-६", "content_sanskrit": "स वै स्वधर्मेण प्रजापालनपोषणप्रीणनोपलालनानुशासनलक्षणेनेज्यादिना च भगवति महापुरुषे परब्रह्मणि सर्वात्मनाऽर्पितपरमार्थलक्षणेन ब्रह्मविच्चरणानुसेवयाऽऽपादितभगवद्भक्तियोगेन चाभीक्ष्णशः परिभावितविशुद्धसत्व उपरतानात्म्ये स्वात्मनि स्वयमुपलभ्यमानब्रह्मानुभावोऽपि निरभिमान एवावनिमजुगुपत्॥ ५/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.007.m4a", "display_order": 8}, {"id": 6000110008, "chapter_id": 10110, "verse_number": null, "content_sanskrit": "तस्येमां गाथां पाण्डवेय पुराविद उपगायन्ति-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.008.m4a", "display_order": 9}, {"id": 6000110009, "chapter_id": 10110, "verse_number": "५-१५-७", "content_sanskrit": "गयं नृपं कः प्रतियाति कर्मभिर्यज्वाऽभिमानी बहुविद्धर्मगोप्ता।\nसदागतश्रीः सदसस्पतिः सतां सत्सेवकोऽन्यो भगवत्कलामृते॥ ५/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.009.m4a", "display_order": 10, "topics": [{"text": "विशेषतो गयचरित्रवर्णनम्", "range": "२–१४"}]}, {"id": 6000110010, "chapter_id": 10110, "verse_number": "५-१५-८", "content_sanskrit": "यमभ्यषिञ्चन्परया मुदा सतीः सत्याशिषो दक्षकन्याः सरिद्भिः।\nयस्य प्रजानां दुदुहे धराऽऽशिषो यथेप्सिता वै गुणवत्स्नुतोधाः॥ ५/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.010.m4a", "display_order": 11}, {"id": 6000110011, "chapter_id": 10110, "verse_number": "५-१५-९", "content_sanskrit": "छन्दांस्यकामस्य च यस्य कामान् दुदूहुराजह्रुरथो बलिं नृपाः।\nप्रत्याहृता युधि धर्मे च विप्रा यस्याशिषः षष्ठमंशं प्रजाश्च॥ ५/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.011.m4a", "display_order": 12}, {"id": 6000110012, "chapter_id": 10110, "verse_number": "५-१५-१०", "content_sanskrit": "यस्याध्वरे भगवानध्वरात्मा मघोनि माद्यत्युरुसोमपीथे।\nश्रद्धा विशुद्धा चलभक्तियोगसमर्पितेज्या फलमाजहार॥ ५/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.012.m4a", "display_order": 13}, {"id": 6000110013, "chapter_id": 10110, "verse_number": "५-१५-११", "content_sanskrit": "यत्प्रीणनाद्बर्हिषि देवतिर्यङ्मनुष्यवीरुत्तृणमाविरिञ्चात्।\nप्रीयेत सद्यः स हि विश्व एष प्रीतः स्वयं प्रीतिमगाद्गयस्य॥ ५/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.013.m4a", "display_order": 14}, {"id": 6000110014, "chapter_id": 10110, "verse_number": "५-१५-१२", "content_sanskrit": "गयाज्जयन्त्यां चित्ररथः स्वस्तिरवरोधन इति त्रयः पुत्रा बभूवुः चित्ररथादूर्जायां सम्राडजनिष्ट॥ ५/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.014.m4a", "display_order": 15}, {"id": 6000110015, "chapter_id": 10110, "verse_number": "५-१५-१३", "content_sanskrit": "तत उत्कलायां मरीचिः मरीचेर्बिन्दुमत्यां बिन्दुमानुदपद्यत।\nतस्मात्सुषेणायां मधुर्नामाभवत्।\nमधोः सुमनस्यां वीरव्रतः ततो व्रजायां मन्युप्रमन्यू जज्ञाते।\nमन्योः सत्यायां भुवनस्ततो दोषायां त्वष्टा अजनिष्ट, त्वष्टुर्विरजो विरोचनायां, विरजस्य शतजित्प्रवरं पुत्रशतं कन्या च विषूच्यां किल जाता॥ ५/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.015.m4a", "display_order": 16}, {"id": 6000110016, "chapter_id": 10110, "verse_number": null, "content_sanskrit": "तत्रायं श्लोकः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.016.m4a", "display_order": 17}, {"id": 6000110017, "chapter_id": 10110, "verse_number": "५-१५-१४", "content_sanskrit": "प्रैयव्रतं वंशमिमं विरजश्चरमोद्भवः।\nअकरोदत्यलं कीर्त्या विष्णुः सुरगणं यथा॥ ५/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_015/BhP_05.015.017.m4a", "display_order": 18}, {"id": 6000110018, "chapter_id": 10110, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे पञ्चदशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]