[{"id": 2024737, "chapter_id": 1530, "verse_number": "३-१६८-०x", "content_sanskrit": "वैशपायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024738, "chapter_id": 1530, "verse_number": "३-१६८-१", "content_sanskrit": "यथागतं गते शक्रे भ्रातृभिः सह संगतः।\nकृष्णया चैव बीभत्सुर्धर्मराजमपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024739, "chapter_id": 1530, "verse_number": "३-१६८-२", "content_sanskrit": "अभिवादयमानं तं मूर्ध्न्युपाघ्राय पाण्डवम्।\nहर्षगद्गदया वाचा प्रहृष्टोऽर्जुनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024740, "chapter_id": 1530, "verse_number": "३-१६८-३", "content_sanskrit": "कथमर्जुन कालोऽयं स्वर्गे रव्यतिगतस्तव।\nकथं चास्त्राण्यवाप्तानि देवराजश्च तोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024741, "chapter_id": 1530, "verse_number": "३-१६८-४", "content_sanskrit": "सम्यग्वा ते गृहीतानि कच्चिदस्त्राणि पाण्डव।\nकच्चित्सुराधिपः प्रीतो रुद्रश्चास्त्राण्यदात्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024742, "chapter_id": 1530, "verse_number": "३-१६८-५", "content_sanskrit": "यथा दृष्टश्च ते शक्रो भगवान्वा पिनाकधृत्।\nयथैवास्त्राण्यवाप्तानि यथैवाराधिताश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024743, "chapter_id": 1530, "verse_number": "३-१६८-६", "content_sanskrit": "यथोक्तवांस्त्वां भगवाञ्शतक्रतुररिंदम।\nकृतप्रियस्त्वयाऽस्मीति तस्य ते किं प्रियं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024744, "chapter_id": 1530, "verse_number": "३-१६८-७", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण महाद्युते।\nयथा तुष्टो महादेवो देवराजस्तथाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024745, "chapter_id": 1530, "verse_number": "३-१६८-८", "content_sanskrit": "यच्चापि वज्रपाणेस्तु प्रियं कृतमरिंदम।\nएतदाख्याहि मे सर्वमखिलेन धनंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024746, "chapter_id": 1530, "verse_number": "३-१६८-९x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024747, "chapter_id": 1530, "verse_number": "३-१६८-९", "content_sanskrit": "शृणु हन्त महाराज विधिना येन दृष्टवान्।\nशतक्रतुमहं देवं भगवन्तं च शंकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024748, "chapter_id": 1530, "verse_number": "३-१६८-१०", "content_sanskrit": "विद्यामधीत्य तां राजंस्त्वयोक्तामरिमर्दन।\nभवता च समादिष्टस्तपसे प्रस्थितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024749, "chapter_id": 1530, "verse_number": "३-१६८-११", "content_sanskrit": "भृगुतुन्दमथो गत्वा काम्यकादास्थितस्तपः।\nएकरात्रोषितः कंचिदपश्यं ब्राह्मणं पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024750, "chapter_id": 1530, "verse_number": "३-१६८-१२", "content_sanskrit": "स मामपृच्छत्कौन्तेय क्वासि गन्ता ब्रवीहि मे।\nतस्मा अवितथं सर्वमब्रवं कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024751, "chapter_id": 1530, "verse_number": "३-१६८-१३", "content_sanskrit": "स तथ्यं मम तच्छ्रुत्वा ब्राह्मणो राजसत्तम।\nअपूजयत मां राजन्प्रीतिमांश्चाभवन्मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024752, "chapter_id": 1530, "verse_number": "३-१६८-१४", "content_sanskrit": "ततो मामब्रवीत्प्रीतस्तप आतिष्ठ भारत।\nतपस्वी नचिरेण त्वं द्रक्ष्यसे विबुधाधिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024753, "chapter_id": 1530, "verse_number": "३-१६८-१५", "content_sanskrit": "ततोऽहं वचनात्तस्य गिरिमारुह्य शैशिरम्।\nतपोऽतप्यं महाराज मासं मूलफलाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024754, "chapter_id": 1530, "verse_number": "३-१६८-१६", "content_sanskrit": "द्वितीयश्चापि मे मासो जलं भक्षयतो गतः।\nनिराहारस्तृतीयेऽथ मासे पाण्डवनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024755, "chapter_id": 1530, "verse_number": "३-१६८-१७", "content_sanskrit": "ऊर्ध्वबाहुश्चतुर्थं तु मासमस्मि स्थितस्तदा।\nन च मे हीयते प्राणस्तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024756, "chapter_id": 1530, "verse_number": "३-१६८-१८", "content_sanskrit": "पञ्चमे त्वथ संप्राप्ते प्रथमे दिवसे गते।\nवराहसंस्थितं भूतं मत्समीपं समागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024757, "chapter_id": 1530, "verse_number": "३-१६८-१९", "content_sanskrit": "निघ्नन्प्रोथेन पृथिवीं विलिखंश्चरणैरपि।\nसंमार्जञ्जठरेणोर्वीं विवर्तंश्च मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024758, "chapter_id": 1530, "verse_number": "३-१६८-२०", "content_sanskrit": "अनु तस्यापरं भूतं महत्कैरातसंस्थितम्।\nधनुर्बाणासिमत्प्राप्तं स्त्रीगणानुगतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024759, "chapter_id": 1530, "verse_number": "३-१६८-२१", "content_sanskrit": "ततोऽहं धनुरादाय तथाऽक्षय्ये महेषुधी।\nअताडयं शरेणाथ तद्भूतं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024760, "chapter_id": 1530, "verse_number": "३-१६८-२२", "content_sanskrit": "युपत्तं किरातस्तु विकृष्य बलवद्धनुः।\nअभ्याजघ्ने दृढतरं कम्पयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024761, "chapter_id": 1530, "verse_number": "३-१६८-२३", "content_sanskrit": "सतु मामब्रवीद्राजन्मम पूर्वपरिग्रहः।\nमृगयाधर्ममुत्सृज्य किमर्थं ताडितस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024762, "chapter_id": 1530, "verse_number": "३-१६८-२४", "content_sanskrit": "एष ते निशितैर्बाणैर्दर्पं हन्मि स्थिरो भव।\nसंघर्षवान्महाकायस्ततो मामभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024763, "chapter_id": 1530, "verse_number": "३-१६८-२५", "content_sanskrit": "ततो गिरिमिवात्यर्थमावृणोन्मां महाशरैः।\nतं चाहं शरवर्षेण महता समवाकिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024764, "chapter_id": 1530, "verse_number": "३-१६८-२६", "content_sanskrit": "ततः शरैर्दीप्तमुखैर्यन्त्रितैरनु यन्त्रितैः।\nप्रत्यविध्यमहं तं तु वज्रैरिव शिलोच्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024765, "chapter_id": 1530, "verse_number": "३-१६८-२७", "content_sanskrit": "तस्य तच्छतधा रूपमभवच्च सहस्रधा।\nतानि चास्य शरीराणि शरैरहमताडयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024766, "chapter_id": 1530, "verse_number": "३-१६८-२८", "content_sanskrit": "पुनस्तानि शरीराणि एकीभूतानि भारत।\nअदृश्यन्त महाराज तान्यहं व्यधमं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024767, "chapter_id": 1530, "verse_number": "३-१६८-२९", "content_sanskrit": "अणुर्बृहच्छिरा भूत्वा बृहच्चाणुशिराः पुनः।\nएकीभूतस्तदा राजन्सोऽभ्यवर्तत मां युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024768, "chapter_id": 1530, "verse_number": "३-१६८-३०", "content_sanskrit": "यदाऽभिभवितुं बाणैर्न च शक्नोमि तं रणे।\nततो महास्त्रमातिष्ठं वायव्यं भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024769, "chapter_id": 1530, "verse_number": "३-१६८-३१", "content_sanskrit": "न चैनमशकं हन्तुं तदद्भुतमिवाभवत्।\nतस्मिन्प्रतिहते चास्त्रे विस्मयो मे महानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024770, "chapter_id": 1530, "verse_number": "३-१६८-३२", "content_sanskrit": "तत्रापि च महाराज सविशेषमहं ततः।\nअस्त्रपूगेन महता रणे भूतमवाकिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024771, "chapter_id": 1530, "verse_number": "३-१६८-३३", "content_sanskrit": "स्थूणाकर्णमथो जालं शरवर्षं शरोल्वणम्।\nशलभास्त्रमश्मवर्षं समास्थायाहमभ्ययाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024772, "chapter_id": 1530, "verse_number": "३-१६८-३४", "content_sanskrit": "जग्रास प्रसभं तानि सर्वाण्यस्त्राणि मे नृप।\nतेषु सर्वेषु जग्धेषु ब्रह्मास्त्रं महदादिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024773, "chapter_id": 1530, "verse_number": "३-१६८-३५", "content_sanskrit": "ततः प्रज्वलितैर्बाणैः सर्वतश्चोपचीयत।\nउपचीयमानश्च तदा महास्त्रेण व्यवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024774, "chapter_id": 1530, "verse_number": "३-१६८-३६", "content_sanskrit": "ततः संतापिता लोका मत्प्रसूतेन तेजसा।\nक्षणएन हि दिशः स्वं च सर्वतो हि विदीपितं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024775, "chapter_id": 1530, "verse_number": "३-१६८-३७", "content_sanskrit": "तदप्यस्त्रं महातेजाः क्षणेनैव व्यशामयत्।\nब्र्हमास्त्रे तु हते राजन्भयं मां महदाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024776, "chapter_id": 1530, "verse_number": "३-१६८-३८", "content_sanskrit": "ततोऽहं धनुरादाय तथाऽक्षय्ये महेषुधी।\nसहसाऽभ्यहनं भूतं तान्यप्यस्त्राण्यभक्षयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024777, "chapter_id": 1530, "verse_number": "३-१६८-३९", "content_sanskrit": "एतेष्वस्त्रेषु भूतेन भक्षितेष्वायुधेषु च।\nमम तस् च भूतस्य बाहुयुद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024778, "chapter_id": 1530, "verse_number": "३-१६८-४०", "content_sanskrit": "व्यायामं मुष्टिभिः कृत्वा तलैरभिसमाहतौ।\nअपायच्च तद्भूतमहं चापातयं महीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024779, "chapter_id": 1530, "verse_number": "३-१६८-४१", "content_sanskrit": "ततः प्रहस्य तद्भूतं तत्रैवान्तरधीयत।\nसह स्त्रीभिर्महाराज पश्यतो मेऽद्भुतोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2024780, "chapter_id": 1530, "verse_number": "३-१६८-४२", "content_sanskrit": "मुख्यं कृत्वा स भगवांस्ततोऽन्यद्रूपमात्मनः।\nदिव्यमेव महाराज वरानोऽद्भुतमम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2024781, "chapter_id": 1530, "verse_number": "३-१६८-४३", "content_sanskrit": "हित्वा किरातरूपं च भगवांस्त्रिदशेश्वरः।\nस्वरूपं दिव्यमास्थाय तस्यौ महेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2024782, "chapter_id": 1530, "verse_number": "३-१६८-४४", "content_sanskrit": "सोऽदृश्यत ततः साक्षाद्भगवान्गोवृषध्वजः।\nधनुर्गृह्यतदा पाणौ बहुरूपः पिनाकधृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2024783, "chapter_id": 1530, "verse_number": "३-१६८-४५", "content_sanskrit": "स मामभ्येत्य समरे तथैवाभिमुखं स्थितम्।\nशूलपाणिरथोवाच तुष्टोस्मीति परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2024784, "chapter_id": 1530, "verse_number": "३-१६८-४६", "content_sanskrit": "ततस्तद्धनुरादाय तूणौ चाक्षय्यसायकौ।\nप्रादान्ममैव भगवान्वरयस्वेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2024785, "chapter_id": 1530, "verse_number": "३-१६८-४७", "content_sanskrit": "तुष्टोस्मि तव कौन्तेय ब्रूहि किं करवाणि ते।\nमनोगतं वीर यत्ते तद्ब्रूहि वितराम्यहम्।\nअमरत्वमपाहाय ब्रूहि यत्ते मनोगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2024786, "chapter_id": 1530, "verse_number": "३-१६८-४८", "content_sanskrit": "ततः प्राञ्डलिरेवाहमस्त्रेषु कृतमानसः।\nप्रणम्य शिरसा शर्वं ततो वचनमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2024787, "chapter_id": 1530, "verse_number": "३-१६८-४९", "content_sanskrit": "भगवानमे प्रसन्नश्चेदीप्सितोऽयं वरो मम।\nअस्त्राणीच्छाम्यहं ज्ञातुं यानि देवेषु कानिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2024788, "chapter_id": 1530, "verse_number": "३-१६८-५०", "content_sanskrit": "ददानीत्येव भगवानब्रवीत्र्यम्बकश्च माम्।\nरौद्रमस्त्रं मदीयं त्वामुपस्थास्यति पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2024789, "chapter_id": 1530, "verse_number": "३-१६८-५१", "content_sanskrit": "प्रददौ च मम प्रीतः सोऽस्त्रं पाशुपतं प्रभुः।\nउवाच च महादेवो दत्त्वा मेऽस्त्रं सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2024790, "chapter_id": 1530, "verse_number": "३-१६८-५२", "content_sanskrit": "न प्रयोज्यंभवेदेतन्मानुषेषु कथंचन।\n[जगद्विनिर्दहेदेवमल्पतेजसि पातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2024791, "chapter_id": 1530, "verse_number": "३-१६८-५३", "content_sanskrit": "पीड्यमानन बलवत्प्रयोज्यंस्याद्धनंजय।\nअस्त्राणां प्रतिघाते च सर्वथैव प्रयोजयेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2024792, "chapter_id": 1530, "verse_number": "३-१६८-५४", "content_sanskrit": "ततोऽप्रतिहतं दिव्यं सर्वास्त्रप्रतिषेधनम्।\nमूर्तिमन्मे स्थितं पार्श्वे प्रसन्ने गोवृषध्वजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2024793, "chapter_id": 1530, "verse_number": "३-१६८-५५", "content_sanskrit": "उत्सादनममित्राणां परसेनानिकर्तनम्।\nदुरासदं दुष्प्रसहं सुरदानवराक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2024794, "chapter_id": 1530, "verse_number": "३-१६८-५६", "content_sanskrit": "अनुज्ञातस्त्वहं तेन तत्रैव समुपाविशम्।\nप्रेक्षतश्चैवमे देवस्तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2024795, "chapter_id": 1530, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि निवातकवचयुद्धपर्वणि अष्टषष्ट्यधिकशततमोऽध्यायः ॥ १६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]