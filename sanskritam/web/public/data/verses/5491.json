[{"id": 2209977, "chapter_id": 5491, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209978, "chapter_id": 5491, "verse_number": "१", "content_sanskrit": "मागधेनार्चितो राजन् पाण्डवश्वेतवाहनः ।\nदक्षिणां दिशमास्थाय चारयामास तं हयम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209979, "chapter_id": 5491, "verse_number": "२", "content_sanskrit": "ततः स पुनरावृत्य हयः कामचरो बली ।\nआससाद पुरीं रम्यां चेदीनां शुक्तिसाह्वयाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209980, "chapter_id": 5491, "verse_number": "३", "content_sanskrit": "शरभेणार्चितस्तत्र शिशुपालात्मजेन सः ।\nयुद्धपूर्वेण मानेन पूजया च महाबलः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209981, "chapter_id": 5491, "verse_number": "४", "content_sanskrit": "ततोऽर्चितो ययौ राजन् तदा स तुरगोत्तमः ।\nकाशीन् मद्रान् कोसलांश्च किरातानथ तङ्कणान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209982, "chapter_id": 5491, "verse_number": "५", "content_sanskrit": "तत्र पूजां यथान्यायं प्रतिगृह्य स पाण्डवः ।\nपुनरागत्य कौन्तेयो दशार्णानचरत् तदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209983, "chapter_id": 5491, "verse_number": "६", "content_sanskrit": "तत्र चित्राङ्गदो नाम बलवान् वसुधाधिपः ।\nतेन युद्धमभूत् तस्य विजयस्यातिभैरवम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209984, "chapter_id": 5491, "verse_number": "७", "content_sanskrit": "तं चापि वशमानीय किरीटी पुरुषर्षभः ।\nनिषादराज्ञो विषयमेकलव्यस्य जग्मिवान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209985, "chapter_id": 5491, "verse_number": "८", "content_sanskrit": "एकलव्यसुतश्चैनं युद्धेन जगृहे तदा ।\nतत्र चक्रे निषादैश्च सङ्ग्रामं रोमहर्षणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209986, "chapter_id": 5491, "verse_number": "९", "content_sanskrit": "ततस्तमपि कौन्तेयः समरेष्वपराजितः ।\nजिगाय समरे वीरो यज्ञविघ्नार्थमुद्यतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209987, "chapter_id": 5491, "verse_number": "१०", "content_sanskrit": "स तं जित्वा महाराज नैषादिं पाकशासनिः ।\nअर्चितः प्रययौ भूयो दक्षिणं सलिलार्णवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209988, "chapter_id": 5491, "verse_number": "११", "content_sanskrit": "तत्रापि द्रमिळैरान्ध्रै रौर्द्रैर्माहिषकैरपि ।\nतथा गोल्लगिरेयैश्च युद्धमासीत् किरीटिनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209989, "chapter_id": 5491, "verse_number": "१२", "content_sanskrit": "तुरगस्य वशेनाथ सुराष्ट्रानभितो ययौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209990, "chapter_id": 5491, "verse_number": "१३", "content_sanskrit": "गोकर्णमथ चासाद्य प्रभासमपि जग्मिवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209991, "chapter_id": 5491, "verse_number": "१४", "content_sanskrit": "ततो द्वारवतीं रम्यां वृष्णिवीराभिरक्षिताम् ।\nआससाद हयः श्रीमान् कुरुराजस्य याज्ञियः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209992, "chapter_id": 5491, "verse_number": "१५", "content_sanskrit": "तमुन्मथ्य हयश्रेष्ठं यादवानां कुमारकाः ।\nप्रययुस्तांस्तदा राजन्नुग्रसेनो न्यवारयत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209993, "chapter_id": 5491, "verse_number": "१६", "content_sanskrit": "ततः पुराद् विनिष्क्रम्य वृष्ण्यन्धकपतिस्तदा ।\nसहितो वासुदेवेन मातुलेन किरीटिना ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209994, "chapter_id": 5491, "verse_number": "१७", "content_sanskrit": "तौ समेत्य नरश्रेष्ठं विधिवत् प्रीतिपूर्वकम् ।\nपरया भरतश्रेष्ठ पूजया समवस्थितौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209995, "chapter_id": 5491, "verse_number": "१८", "content_sanskrit": "ततस्ताभ्यामनुज्ञातो ययौ येन हयो गतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209996, "chapter_id": 5491, "verse_number": "१९", "content_sanskrit": "ततः पश्चिमदेशेन समुद्रान्तं तदा हयः ।\nक्रमेण व्यचरत् स्फीतं ततः पञ्चनदं ययौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209997, "chapter_id": 5491, "verse_number": "२०", "content_sanskrit": "तस्मादपि स कौरव्य गान्धारविषयं हयः ।\nविचचार यथाकामं कौन्तेयानुगतस्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209998, "chapter_id": 5491, "verse_number": "२१", "content_sanskrit": "तत्र गान्धारराजेन युद्धमासीन्महात्मनः ।\nघोरं शकुनिपुत्रेण पूर्ववैरानुकारिणा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209999, "chapter_id": 5491, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसम्भरणे गान्धारदेशप्रवेशो नाम पञ्चाशीतितमोऽध्यायः ॥८५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]