[
  {
    "id": 10631901,
    "chapter_id": 6419,
    "verse_number": "19.1",
    "content_sanskrit": "व्यवहितेन सम्बन्धं वदन् अध्यायान्तरम् अवतारयति-\nदैवीति ।\nदैवी सूचिता, “राक्षसीं आसुरीं चैव प्रकृतिं मोहिनीम्&quot; इत्यादौ इति शेषः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1
  },
  {
    "id": 10631902,
    "chapter_id": 6419,
    "verse_number": "19.2",
    "content_sanskrit": "प्रकृतीनां विस्तरेण दर्शनं कुत्र उपयोगि इति आशङ्क्य, विभज्य उपयोगं आह -\nसंसारेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2
  },
  {
    "id": 10631903,
    "chapter_id": 6419,
    "verse_number": "19.3",
    "content_sanskrit": "अतीते च अध्याये “कर्मानुबन्धीनि अधश्च मूलानि अनुसन्ततानि&quot; इत्यत्र कर्मव्यङ्ग्याः वासनाः संसारस्य अवान्तरमूलत्वेन उक्ताः । ताः मनुष्यदेहे प्राग्भवीयकर्मानुसारेण व्यज्यमानाः सात्त्विकादिभेदेन दैव्यादिप्रकृतित्रयत्वेन विभक्ताः विस्तितीर्षुः भगवान् उक्तवान् इत्याह -\nभगवानिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3
  },
  {
    "id": 10631904,
    "chapter_id": 6419,
    "verse_number": "19.4",
    "content_sanskrit": "अभीरुता - शास्त्रोपदिष्टे अर्थे सन्देहं हित्वा अनुष्ठाननिष्ठत्वम् । परवञ्चना - परस्य व्याजेन वशीकरणम् । माया - हृदये अन्यथा कृत्वा बहिः अन्यथा व्यवहरणम् । अनृतं - अयथादृष्टकथनम् । आदिपदेन विप्रलम्भादिग्रहः उक्तं अर्थं सङ्क्षिप्य आह -\nशुद्धेति ।\nएषा इति अभयाद्या ज्ञानादिस्थित्यन्ता त्रिधा उक्ता इति यावत् ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4
  },
  {
    "id": 10631905,
    "chapter_id": 6419,
    "verse_number": "19.5",
    "content_sanskrit": "तामेव सात्त्विकीं प्रकृतिं प्रकटयति -\nयत्रेति ।\nज्ञाने कर्मणि वा अधिकृतानां अभीरुताद्या या प्रकृतिः सा तेषां तत्र सात्त्विकी सम्पत् इत्यर्थः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5
  },
  {
    "id": 10631906,
    "chapter_id": 6419,
    "verse_number": "19.6",
    "content_sanskrit": "महाभाग्यानां अत्युत्तमा दैवी सम्पत् उक्ता । सम्प्रति सर्वेषां यथासम्भवं सम्पदं व्यपदिशति -\nदानमिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6
  },
  {
    "id": 10631907,
    "chapter_id": 6419,
    "verse_number": "19.7",
    "content_sanskrit": "बाह्यकरणविशेषे कारणम् आह -\nअन्तःकरणस्येति ।\nदेवयज्ञादिः इति आदिशब्देन पितृयज्ञो भूतयज्ञो मनुष्ययज्ञश्च इति त्रयम् उक्तम् । बह्मयज्ञस्य स्वाध्यायेन पृथक्करणात्\n॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7
  },
  {
    "id": 10631908,
    "chapter_id": 6419,
    "verse_number": "19.8",
    "content_sanskrit": "दैवीं सम्पदमभिजातस्य विशेषणान्तराणि दर्शयति -\nकिं चेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8
  },
  {
    "id": 10631909,
    "chapter_id": 6419,
    "verse_number": "19.9",
    "content_sanskrit": "त्यागशब्देन दानं कस्मात् न उच्यते ? तत्र आह -\nपूर्वमिति ।\nलज्जा - अकार्यनिवृत्तिहेतुगर्हानिमित्ता मनोवृत्तिः\n॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9
  },
  {
    "id": 10631910,
    "chapter_id": 6419,
    "verse_number": "19.10",
    "content_sanskrit": "दैवी सम्पदं प्राप्तस्य विशेषणान्तराणि अपि सन्ति इति आह -\nकिञ्चेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10
  },
  {
    "id": 10631911,
    "chapter_id": 6419,
    "verse_number": "19.11",
    "content_sanskrit": "व्यावर्त्यं कीर्तयति -\nनेति ।\nअध्यात्माधिकारात् इति शेषः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11
  },
  {
    "id": 10631912,
    "chapter_id": 6419,
    "verse_number": "19.12",
    "content_sanskrit": "क्षमाऽक्रोधयोः एकार्थत्वेन पौनरुक्त्यं आशङ्क्य परिहरति -\nउत्पन्नायाम् इति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12
  },
  {
    "id": 10631913,
    "chapter_id": 6419,
    "verse_number": "19.13",
    "content_sanskrit": "तयोः एवं विशेषात् अपौनरुक्त्यं फलति इति आह -\nइत्थम् इति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13
  },
  {
    "id": 10631914,
    "chapter_id": 6419,
    "verse_number": "19.14",
    "content_sanskrit": "वृत्तिविशेषमेव विशदयति -\nयेनेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14
  },
  {
    "id": 10631915,
    "chapter_id": 6419,
    "verse_number": "19.15",
    "content_sanskrit": "शौचस्य द्वैविध्यमेव प्रकटयति -\nमृज्जलेत्यादिना ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15
  },
  {
    "id": 10631916,
    "chapter_id": 6419,
    "verse_number": "19.16",
    "content_sanskrit": "नैर्मल्यमेव स्फोरयति -\nमायेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16
  },
  {
    "id": 10631917,
    "chapter_id": 6419,
    "verse_number": "19.17",
    "content_sanskrit": "उक्तम् उपसंहरति -\nएवमिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17
  },
  {
    "id": 10631918,
    "chapter_id": 6419,
    "verse_number": "19.18",
    "content_sanskrit": "अतिमानित्वाभावमेव व्यनक्ति -\nआत्मनः इति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18
  },
  {
    "id": 10631919,
    "chapter_id": 6419,
    "verse_number": "19.19",
    "content_sanskrit": "कस्य एतानि विशेषणानि इति अपेक्षायां आह -\nभवन्तीति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19
  },
  {
    "id": 10631920,
    "chapter_id": 6419,
    "verse_number": "19.20",
    "content_sanskrit": "साधकस्य मनुष्यदेहस्थस्यैव कथं दैवीं सम्पदं अभिलक्ष्य जातत्वम् ? इति आशङ्क्य आह -\nदैवीति\n॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20
  },
  {
    "id": 10631921,
    "chapter_id": 6419,
    "verse_number": "19.21",
    "content_sanskrit": "आदेयत्वेन दैवीं सम्पदं उक्त्वा हेयत्वेन आसुरीं सम्पदं आह -\nअथेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21
  },
  {
    "id": 10631922,
    "chapter_id": 6419,
    "verse_number": "19.22",
    "content_sanskrit": "उत्सेकः - मदः महदवधीरणाहेतुः । आत्मनि उत्कृष्टत्वाध्यारोपः अतिमानः । क्रोधस्तु कोपापरपर्यायः स्वपरापकारप्रवृत्तिहेतुः नेत्रादिविकारलिङ्गः अन्तःकरणवृत्तिविशेषः । परुषः निष्ठुरः प्रत्यक्षरूक्षवाक् , तस्य भावः पारुष्यम् । तत् उदाहरति -\nयथेति ।\nतां अभिजातस्य दम्भादीनि अज्ञानान्तानि भवन्ति इति अनुषज्यते\n॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22
  },
  {
    "id": 10631923,
    "chapter_id": 6419,
    "verse_number": "19.23",
    "content_sanskrit": "कार्यं फलविभागः । आसुरी इति उपलक्षणं राक्षसी चेति द्रष्टव्यं इत्याह -\nतथेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23
  },
  {
    "id": 10631924,
    "chapter_id": 6419,
    "verse_number": "19.24",
    "content_sanskrit": "फलविभागे सम्पदोः एवं उक्ते, प्रतीत्य अर्जुनस्य अभिप्रायं, भगवतो वचनं इत्याह -\nतत्रेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24
  },
  {
    "id": 10631925,
    "chapter_id": 6419,
    "verse_number": "19.25",
    "content_sanskrit": "तत्र आभिजात्यं हेतुं करोति -\nपाण्डवेति\n॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25
  },
  {
    "id": 10631926,
    "chapter_id": 6419,
    "verse_number": "19.26",
    "content_sanskrit": "निर्दयानां रक्षसां सम्पत् तृतीया अस्ति, सा कस्मात् न उक्ता इति आशङ्क्य आसुर्यां अन्तर्भावात् इत्याह -\nद्वाविति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26
  },
  {
    "id": 10631927,
    "chapter_id": 6419,
    "verse_number": "19.27",
    "content_sanskrit": "भूतानां द्वैविध्ये मानत्वेन उदूगीथब्राह्मणम् उदाहरति -\nद्वया हेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27
  },
  {
    "id": 10631928,
    "chapter_id": 6419,
    "verse_number": "19.28",
    "content_sanskrit": "सम्पद्द्वययुतेभ्यः अतिरिक्तानां अपि प्राणिभेदानां सम्भवात् कुतः भूतानां द्वित्वनियतिः ? इति आशङ्क्य आह -\nसर्वेषामिति\n॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28
  },
  {
    "id": 10631929,
    "chapter_id": 6419,
    "verse_number": "19.29",
    "content_sanskrit": "ननु अध्यायशेषेण आसुरसम्पद्दर्शनं अयुक्तं, तस्याः त्याज्यत्वेनपङ्कप्रक्षालनन्यायावतारात् इति आशङ्क्य आह -\nप्रत्यक्षीकरणेनेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29
  },
  {
    "id": 10631930,
    "chapter_id": 6419,
    "verse_number": "19.30",
    "content_sanskrit": "वर्जनीयां आसुरीं सम्पदं विवृणोति -\nप्रवृत्तिं चेति ।\nतां विहितां प्रवृत्तिं न जानन्ति इत्यर्थः । तां च निषिद्धां क्रियां न जानन्ति इति सम्बन्धः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30
  },
  {
    "id": 10631931,
    "chapter_id": 6419,
    "verse_number": "19.31",
    "content_sanskrit": "न शौचम् इत्यादेः तात्पर्यं आह -\nअनाचारा इति ।\nशौचसत्ययोः आचारान्तर्भावेऽपि बाह्मणपरिव्राजकन्यायेन पृथक् उपादानम्\n॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31
  },
  {
    "id": 10631932,
    "chapter_id": 6419,
    "verse_number": "19.32",
    "content_sanskrit": "आसुराणां जनानां विशेषणान्तराण्यपि सन्ति इत्याह -\nकिं चेति ।\nविद्यते इत्याहुः इति पूर्वेण सबन्धः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32
  },
  {
    "id": 10631933,
    "chapter_id": 6419,
    "verse_number": "19.33",
    "content_sanskrit": "शास्त्रैकगम्यम् अदृष्टं निमित्तीकृत्यप्रकृत्यधिष्ठात्रात्मकेन ब्रह्मणा रहितं जगत् इष्यते चेत् , कथं तदुत्पत्तिः इति आशङ्क्य आह -\nकिं चेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33
  },
  {
    "id": 10631934,
    "chapter_id": 6419,
    "verse_number": "19.34",
    "content_sanskrit": "किमन्यत् इत्यादेः आक्षेपस्य तात्पर्यं आह -\nन किञ्चिदिति\n॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34
  },
  {
    "id": 10631935,
    "chapter_id": 6419,
    "verse_number": "19.35",
    "content_sanskrit": "यथा उक्ता दृष्टिः ब्रह्मदृष्टिवत् इष्टैव इति आशङ्क्य आह -\nएतामिति ।\nप्राक् उपदिष्टां एतां लोकायतिकदृष्टिं अवलम्ब्य इति यावत् ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35
  },
  {
    "id": 10631936,
    "chapter_id": 6419,
    "verse_number": "19.36",
    "content_sanskrit": "नष्टस्वभावत्वं एव स्पष्टयति -\nविभ्रष्टेति ।\nविषयबुद्धेः अल्पत्वं दृष्टमात्रोद्देशेन प्रवृत्तत्वम् । जगतः प्राणिजातस्य इति यावत्\n॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36
  },
  {
    "id": 10631937,
    "chapter_id": 6419,
    "verse_number": "19.37",
    "content_sanskrit": "तानेव दुराचारान् आसुरान् प्रकारान्तरेण विशिनष्टि -\nते चेति\n॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37
  },
  {
    "id": 10631938,
    "chapter_id": 6419,
    "verse_number": "19.38",
    "content_sanskrit": "तानेव विधान्तरेण विशिनष्टि -\nकिं चेति ।\nचिन्तां - आत्मीययोगक्षेमोपायालोचनात्मिकां अपरिमेयविषयत्वात् परिमातुं अशक्यां आश्रिताः इति सम्बन्धः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38
  },
  {
    "id": 10631939,
    "chapter_id": 6419,
    "verse_number": "19.39",
    "content_sanskrit": "एषः कामोपभोगः परं अयनं सुखस्य इति एतावत् , पारत्रिकं तु नास्ति सुखं इति निश्चयवन्तः इत्याह -\nएतावदिति\n॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39
  },
  {
    "id": 10631940,
    "chapter_id": 6419,
    "verse_number": "19.40",
    "content_sanskrit": "आसुरानेव पुनः विशिनष्टि -\nआशेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40
  },
  {
    "id": 10631941,
    "chapter_id": 6419,
    "verse_number": "19.41",
    "content_sanskrit": "अशक्योपायार्थविषयाः अनवगतोपायार्थविषयाः वा प्रार्थनाः आशाः, ताः पाशः इव पाशाः, तेषां शतैः बद्धाः इव, श्रेयसः प्रच्याव्य इतः ततः नीयमानाः इत्याह -\nआशा एवेति\n॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41
  },
  {
    "id": 10631942,
    "chapter_id": 6419,
    "verse_number": "19.42",
    "content_sanskrit": "तेषां अभिप्रायोऽपि विवेकविरोधी इत्याह -\nईदृशश्चेति ।\nद्रव्यं गोहिरण्यादि । इदं - अन्यत् बुद्धौ प्रार्थ्यमानत्वेन विपरिवर्तमानं इति एतत्\n॥ १३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42
  },
  {
    "id": 10631943,
    "chapter_id": 6419,
    "verse_number": "19.43",
    "content_sanskrit": "यथोक्ते मदभिप्राये प्रतिबन्धकः शत्रुः अपि न सम्भवति इत्याह -\nअसाविति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43
  },
  {
    "id": 10631944,
    "chapter_id": 6419,
    "verse_number": "19.44",
    "content_sanskrit": "त्वत्तो विहीनानां त्वया परिभवेऽपि, त्वत्तुल्यानां शत्रूणां परिभवो निश्चितो न भवति इति आशङ्क्य आह -\nसर्वथेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44
  },
  {
    "id": 10631945,
    "chapter_id": 6419,
    "verse_number": "19.45",
    "content_sanskrit": "ऐश्वर्यातिरेकेऽपि कुतः तेषां भोगसामर्थ्यम् इति आशङ्क्य आह -\nअहमिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45
  },
  {
    "id": 10631946,
    "chapter_id": 6419,
    "verse_number": "19.46",
    "content_sanskrit": "सिद्धत्वमेव स्फुटयति -\nसम्पन्न इति ।\nबलवान् - ओजस्वी । सुखी - रोगरहितः\n॥ १४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46
  },
  {
    "id": 10631947,
    "chapter_id": 6419,
    "verse_number": "19.47",
    "content_sanskrit": "विद्यावृत्तधनाभिजनैः मत्तुल्यः नास्ति इत्याह -\nआढ्यः इति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47
  },
  {
    "id": 10631948,
    "chapter_id": 6419,
    "verse_number": "19.48",
    "content_sanskrit": "तथापि यागदानाभ्यां तत्फलेन वा कश्चित् अधिकः भविष्यति इति आशङ्क्य आह -\nकिञ्चेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48
  },
  {
    "id": 10631949,
    "chapter_id": 6419,
    "verse_number": "19.49",
    "content_sanskrit": "न च तेषां एषः अभिप्रायः साधीयान् इत्याह -\nइत्येवमिति\n॥ १५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49
  },
  {
    "id": 10631950,
    "chapter_id": 6419,
    "verse_number": "19.50",
    "content_sanskrit": "उक्तप्रकारविपर्ययेण कृत्याकृत्यविवेकविकलानां किं स्यात् ? इति अपेक्षायां आह -\nअनेकेति ।\nकामाः - विषयाः, तेषां भोगेषु - तत्प्रयुक्तेषु उपभोगेषु इति यावत्\n॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50
  },
  {
    "id": 10631951,
    "chapter_id": 6419,
    "verse_number": "19.51",
    "content_sanskrit": "ननु तेषामपि केषाञ्चित् वैदिके कर्मणि यागदानादौ प्रवृत्तिप्रतिपत्तेः अयुक्तं वैतरण्यादौ पतनं इति चेत् , तत्र आह -\nआत्मेति\n॥ १७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51
  },
  {
    "id": 10631952,
    "chapter_id": 6419,
    "verse_number": "19.52",
    "content_sanskrit": "आसुरीसम्पदं अभिजातैः अधर्मजातमेव सञ्चीयते, प्रवृत्तैरपि वैदिके कर्मणि, नैव पुण्यं इति उक्तम् । ब्रह्मज्ञानात् पुनः आसुराः दूरादेव उद्विजन्ते इति आह -\nअहङ्कारमिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52
  },
  {
    "id": 10631953,
    "chapter_id": 6419,
    "verse_number": "19.53",
    "content_sanskrit": "अहङ्कारमेव स्फोरयति -\nविद्यमानैरिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53
  },
  {
    "id": 10631954,
    "chapter_id": 6419,
    "verse_number": "19.54",
    "content_sanskrit": "अध्यारोपितवैशिष्ट्यविषयत्वात् अहङ्कारस्य अविद्यामूलत्वेन अविद्यात्मत्वं आह -\nअविद्याख्य इति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54
  },
  {
    "id": 10631955,
    "chapter_id": 6419,
    "verse_number": "19.55",
    "content_sanskrit": "विवेकिभिः तस्य अतियत्नादेव हेयत्वं सूचयति -\nकष्टतम इति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55
  },
  {
    "id": 10631956,
    "chapter_id": 6419,
    "verse_number": "19.56",
    "content_sanskrit": "तदेव स्पष्टयति -\nसर्वेति ।\nतं संश्रिताः इति सम्बन्धः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56
  },
  {
    "id": 10631957,
    "chapter_id": 6419,
    "verse_number": "19.57",
    "content_sanskrit": "कर्याकरणसामर्थ्यं उक्तविशेषणं बलम् । अहङ्कार एव महदवधीरणापर्यन्तत्वेन परिणतः दर्पः । तं व्याकरोति -\nनामेत्यादिना ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57
  },
  {
    "id": 10631958,
    "chapter_id": 6419,
    "verse_number": "19.58",
    "content_sanskrit": "अन्यांश्च दोषान् मात्सर्यादीन् । न केवलं उक्तमेव तेषां विशेषणम् , किन्तु कष्टतमं अस्ति विशेषणान्तरं इति आह -\nकिञ्चेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58
  },
  {
    "id": 10631959,
    "chapter_id": 6419,
    "verse_number": "19.59",
    "content_sanskrit": "यद्यपि ईश्वरं प्रति द्वेषः तेषां सम्भाव्यते, तथापि कथं स्वदेहे परदेहेषु च तं प्रति द्वेषः ? न हि तत्र भोक्तारं अन्तरेण ईश्वरस्य अवस्थानम् इति आशङ्क्य आह-\nतद्बुद्धीति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59
  },
  {
    "id": 10631960,
    "chapter_id": 6419,
    "verse_number": "19.60",
    "content_sanskrit": "तेषां ईश्वरं प्रति द्वेषमेव प्रकटयति -\nमच्छासनेति ।\nईश्वरस्य शासनं - श्रुतिसमृतिरूपं तदतिवर्तित्वं - तदुक्तार्थज्ञानानुष्ठानपराङ्मुखत्वम्\n॥ १८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60
  },
  {
    "id": 10631961,
    "chapter_id": 6419,
    "verse_number": "19.61",
    "content_sanskrit": "तेषां उक्तविशेषणवतां आसुराणां किं स्यात् इति तत् आह -\nतानिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61
  },
  {
    "id": 10631962,
    "chapter_id": 6419,
    "verse_number": "19.62",
    "content_sanskrit": "भगवतः नैर्घृण्यप्रसङ्गं प्रत्यादिशति -\nअधर्मेति\n॥ १९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62
  },
  {
    "id": 10631963,
    "chapter_id": 6419,
    "verse_number": "19.63",
    "content_sanskrit": "ननु तेषामपि क्रमेण बहूनां जन्मनां अन्ते श्रेयः भविष्यति ? न इति आह -\nआसुरीमिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63
  },
  {
    "id": 10631964,
    "chapter_id": 6419,
    "verse_number": "19.64",
    "content_sanskrit": "तेषां ईश्वरप्राप्तिशङ्काभावे कथं तन्निषेधः स्यात् ? इति आशङ्क्य आह -\nमामित्यादिना ।\nयस्मात् आसुरी सम्पत् अनर्थपरम्परया सर्वपुरुषार्थपरिपन्थिनी, तस्मात् यावत् पुरुषः स्वतन्त्रः न काञ्चित् पारवश्यकरीं योनिम् आपन्नः, तावदेव तेन असौ परिहरणीया इति समुदायार्थः\n॥ २० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64
  },
  {
    "id": 10631965,
    "chapter_id": 6419,
    "verse_number": "19.65",
    "content_sanskrit": "कथं आसुरी सम्पत् अनन्तभेदवती पुरुषायुषेणापि परिहर्तुं शक्येत इति आशङ्क्य आह -\nसर्वस्या इति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65
  },
  {
    "id": 10631966,
    "chapter_id": 6419,
    "verse_number": "19.66",
    "content_sanskrit": "सङ्क्षेपोक्तिफलं आह -\nयस्मिन्निति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66
  },
  {
    "id": 10631967,
    "chapter_id": 6419,
    "verse_number": "19.67",
    "content_sanskrit": "कामादौ त्रिविधे सर्वस्य आसुरसम्पद्भेदस्य अन्तर्भावेऽपि, कथं असौ परिह्रियते ? तत्र आह -\nयत्परिहारेणेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67
  },
  {
    "id": 10631968,
    "chapter_id": 6419,
    "verse_number": "19.68",
    "content_sanskrit": "कामादिपरिहारेण आसुरीसम्पद्भेदपरिहारेऽपि कथं सर्वानर्थपरिवर्जनं इति आशङ्क्य आह -\nयन्मूलमिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68
  },
  {
    "id": 10631969,
    "chapter_id": 6419,
    "verse_number": "19.69",
    "content_sanskrit": "कथं आत्मनः नित्यस्य नाशशङ्का ? इति, तत्र आह -\nकस्मैचिदिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69
  },
  {
    "id": 10631970,
    "chapter_id": 6419,
    "verse_number": "19.70",
    "content_sanskrit": "त्रिविधमपि सामान्यतः दर्शितं आकाङ्क्षाद्वारा विशेषतः दर्शयति -\nकिं तदिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70
  },
  {
    "id": 10631971,
    "chapter_id": 6419,
    "verse_number": "19.71",
    "content_sanskrit": "तस्मात् इति व्याचष्टे -\nयत इति ।\nकामादित्यागे सति, अनर्थाचरणश्रेयःप्रतिबन्धनिवृत्ती स्यातां इति भावः\n॥ २१ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71
  },
  {
    "id": 10631972,
    "chapter_id": 6419,
    "verse_number": "19.72",
    "content_sanskrit": "न केवलं श्रेयः समाचरन् आसुरीं च सम्पदं वर्जयन् मोक्षमेव सम्यग्धीद्वारा लभते किन्तु लौकिकमपि सुखं इतिअपेः अर्थः\n॥ २२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72
  },
  {
    "id": 10631973,
    "chapter_id": 6419,
    "verse_number": "19.73",
    "content_sanskrit": "आसुर्याः सम्पदः वर्जने श्रेयसश्च करणे किं कारणम् ? तत् आह -\nसर्वस्येति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73
  },
  {
    "id": 10631974,
    "chapter_id": 6419,
    "verse_number": "19.74",
    "content_sanskrit": "तस्य कारणत्वं साधयति -\nशास्त्रेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74
  },
  {
    "id": 10631975,
    "chapter_id": 6419,
    "verse_number": "19.75",
    "content_sanskrit": "उक्तं उपजीव्य अनन्तरश्लोकं प्रवर्तयति -\nअत इति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75
  },
  {
    "id": 10631976,
    "chapter_id": 6419,
    "verse_number": "19.76",
    "content_sanskrit": "शिष्यते - अनुशिष्यते बोध्यते अनेन अपूर्वः अर्थः इति शास्त्रम् । तच्च विधिनिषेधात्मकम् इति उपेत्य व्याचष्टे -\nकर्तव्येति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76
  },
  {
    "id": 10631977,
    "chapter_id": 6419,
    "verse_number": "19.77",
    "content_sanskrit": "कामस्य करणं कामकारः, तस्मात् हेतोः इति उपेत्य कामाधीना शास्त्रविमुखस्य प्रवृत्तिः इति आह -\nकामेति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77
  },
  {
    "id": 10631978,
    "chapter_id": 6419,
    "verse_number": "19.78",
    "content_sanskrit": "कामाधीनप्रवृत्तेः सदा पुमर्थयोग्यस्य सर्वपुरुषार्थसिद्धिः इत्याह -\nनापीति\n॥ २३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78
  },
  {
    "id": 10631979,
    "chapter_id": 6419,
    "verse_number": "19.79",
    "content_sanskrit": "शास्त्रात् ऋते कर्मणः निष्फलत्वे फलितं आह -\nतस्मादिति ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79
  },
  {
    "id": 10631980,
    "chapter_id": 6419,
    "verse_number": "19.80",
    "content_sanskrit": "कर्तव्याकर्तव्यौ धर्माधर्मौ तत्र शास्त्रस्य प्रमाणत्वेऽपि मम किं कर्तव्यं इति आशङ्क्य आह -\nअत इति ।\nस्वकर्म - क्षत्रियस्य युद्धादि । इतिशब्दः अध्यायसमाप्त्यर्थः । तत् अनेन अध्यायेन प्रागभवीयकर्मवासनानुसारेण अभिव्यज्यमानसात्त्विकादिप्रकृतित्रयविभागेन दैवी आसुरी इति सम्पद्द्वयं आदानहानाभ्यां उपदिश्य कामक्रोधलोभान् अपहाय पुरुषर्थिना शास्त्रश्रवणेन तदुक्तकारिणा भवितव्यमिति निर्धारितम्\n॥ २४ ॥\nइति श्रीमत्परमहंस - परिव्राजकाचार्य - श्रीमच्छुद्धानन्दपूज्यपादशिष्यानन्दज्ञान - वि रचिते श्रीमद्भगवद्गीताशाङ्करभाष्यव्याख्याने षोडशोऽध्यायः\n॥ १६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80
  }
]