[{"id": 50013359, "chapter_id": 11509, "verse_number": "1", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50013360, "chapter_id": 11509, "verse_number": "2", "content_sanskrit": "स एष भगवान् राजन्नकरोद् विततं यशः। पुरा रुद्रस्य देवस्य मयेनानन्तमायिना॥ ७/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50013361, "chapter_id": 11509, "verse_number": "3", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50013362, "chapter_id": 11509, "verse_number": "4", "content_sanskrit": "कस्मिन् कर्मणि देवस्य यशोऽभूज्जगदीशितुः। यथा चोपचिता कीर्तिः कृण्णेनानेन कथ्यताम्॥ ७/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50013363, "chapter_id": 11509, "verse_number": "5", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50013364, "chapter_id": 11509, "verse_number": "6", "content_sanskrit": "निर्जिता असुरा देवैर्युध्यनेनोपबृंहितैः। मायिनां परमाचार्यं मयं शरणमभ्ययुः॥ ७/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50013365, "chapter_id": 11509, "verse_number": "7", "content_sanskrit": "स निर्ममे पुरस्तिस्रो हैमरौप्यायसीर्विभुः। दुर्लक्ष्यापायसंयोगा दुर्लक्ष्योरुपरिच्छदाः॥ ७/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50013366, "chapter_id": 11509, "verse_number": "8", "content_sanskrit": "ताभिस्तेऽसुरसेनान्यो लोकान् त्रीन् सेश्वरान् नृप। स्मरन्तो नाशयाञ्चक्रुः पूर्ववैरमलक्षिताः॥ ७/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50013367, "chapter_id": 11509, "verse_number": "9", "content_sanskrit": "ततस्ते सेश्वरा लोका उपासाद्योचिरे विभुम्। त्राहि नस्तावकान् देव विनष्टान् त्रिपुरालयैः॥ ७/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50013368, "chapter_id": 11509, "verse_number": "10", "content_sanskrit": "अथानुगृह्य भगवान् मा भैष्टेति सुरान् विभुः। शरं धनुषि सन्धाय पुर्यामस्त्रं व्यमुञ्चत॥ ७/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50013369, "chapter_id": 11509, "verse_number": "11", "content_sanskrit": "ततोऽग्निवर्णा इषव उत्पेतुः सूर्यमण्डलात्। यथा मयूखसन्दोहा नादृश्यन्त पुरो यतः॥ ७/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50013370, "chapter_id": 11509, "verse_number": "12", "content_sanskrit": "तैः स्पृष्टा व्यसवः सर्वे निपेतुस्त्रिपुरौकसः। तानानीय महायोगी मयः कूपरसेऽक्षिपत्॥ ७/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50013371, "chapter_id": 11509, "verse_number": "13", "content_sanskrit": "सिद्धामृतरसस्पृष्टा वज्रधारा महौजसः। उत्तस्थुर्मेघपटलाद् वैद्युता इव वह्नयः॥ ७/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50013372, "chapter_id": 11509, "verse_number": "14", "content_sanskrit": "विलोक्य भग्नसङ्कल्पं विमनस्कं वृषध्वजम्। तदाऽयं भगवान् विष्णुस्तत्रोपायमकल्पयत्॥ ७/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50013373, "chapter_id": 11509, "verse_number": "15", "content_sanskrit": "वत्स आसीत् तदा ब्रह्मा स्वयं विष्णुरयं हि गौः। प्रविश्य त्रिपुरं काले रसकूपामृतं पपौ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50013374, "chapter_id": 11509, "verse_number": "16", "content_sanskrit": "तेऽसुरा ह्यपि पश्यन्तो न न्यषेधन् विमोहिताः॥ ७/११/१२॥ तद् विज्ञाय महायोगी रसपालानिदं जगौ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50013375, "chapter_id": 11509, "verse_number": "17", "content_sanskrit": "स्मरन् विशोकः शोकार्तान् स्मरन् दैवगतिं च ताम्॥ ७/११/१३॥ देवोऽसुरो नरोऽन्यो वा नेश्वरोऽस्तीह कश्चन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50013376, "chapter_id": 11509, "verse_number": "18", "content_sanskrit": "आत्मनोऽन्यस्य वा दिष्टंदैवेनापोहितुं द्वयोः॥ ७/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50013377, "chapter_id": 11509, "verse_number": "19", "content_sanskrit": "अथासौ शक्तिभिः स्वाभिः शम्भोः प्राधनिकं व्यधात्। धर्मज्ञानविरक्त्यृद्धितपोविद्याक्रियादिभिः॥ ७/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50013378, "chapter_id": 11509, "verse_number": "20", "content_sanskrit": "रथं सूतं ध्वजं वाहं धनुर्वर्म शरादि यत्। सन्नद्धो रथमास्थाय सशरं धनुराददे॥ ७/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50013379, "chapter_id": 11509, "verse_number": "21", "content_sanskrit": "शरं धनुषि सन्धाय धूर्जटिर्जगदीश्वरः। भगवत्तेजसा गुप्तो ददाह त्रिपुरं नृप॥ ७/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50013380, "chapter_id": 11509, "verse_number": "22", "content_sanskrit": "दिवि दुन्दुभयो नेदुर्विमानशतसङ्कुले। देवर्षिपितृसिद्धेशा जयेति कुसुमोत्करैः। अवाकिरन् जगुर्हृष्टा ननृतुश्चाप्सरोगणाः॥ ७/११/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50013381, "chapter_id": 11509, "verse_number": "23", "content_sanskrit": "एवं दग्ध्वा पुरस्तिस्रो भगवान् पुरहा नृप। ब्रह्मादिभिः स्तूयमानः स्वधाम प्रत्यपद्यत॥ ७/११/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50013382, "chapter_id": 11509, "verse_number": "24", "content_sanskrit": "एवंविधान्यस्य हरेः स्वमायया विडम्बमानस्य नृलोकमात्मनः। वीर्याणि गीतान्यृषिभिर्जगद्गुरोर्लोकं पुनानान्यपरं वदामि किम्॥ ७/११/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50013383, "chapter_id": 11509, "verse_number": "25", "content_sanskrit": "इति श्रीमद्भागवते सप्तमस्कन्धे एकादशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]