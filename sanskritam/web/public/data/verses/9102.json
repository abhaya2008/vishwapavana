[{"id": 5000102000, "chapter_id": 9102, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000102001, "chapter_id": 9102, "verse_number": "२-२५-१", "content_sanskrit": "सा विनीय तमायासमुपस्पृश्य जलं शुचि।\nचकार माता रामस्य मङ्गलानि मनस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000102002, "chapter_id": 9102, "verse_number": "२-२५-२", "content_sanskrit": "न शक्यसे वारयितुं गच्छेदानीं रघूत्तम।\nशीघ्रं च विनिवर्तस्व वर्तस्व च सतां क्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000102003, "chapter_id": 9102, "verse_number": "२-२५-३", "content_sanskrit": "यं पालयसि धर्मं त्वं प्रीत्या च नियमेन च।\nस वै राघवशार्दूल धर्मस्त्वामभिरक्षतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000102004, "chapter_id": 9102, "verse_number": "२-२५-४", "content_sanskrit": "येभ्यः प्रणमसे पुत्र देवेष्वायतनेषु च।\nते च त्वामभिरक्षन्तु वने सह महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000102005, "chapter_id": 9102, "verse_number": "२-२५-५", "content_sanskrit": "यानि दत्तानि तेऽस्त्राणि विश्वामित्रेण धीमता।\nतानि त्वामभिरक्षन्तु गुणैः समुदितं सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000102006, "chapter_id": 9102, "verse_number": "२-२५-६", "content_sanskrit": "पितृशुश्रूषया पुत्र मातृशुश्रूषया तथा।\nसत्येन च महाबाहो चिरं जीवाभिरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000102007, "chapter_id": 9102, "verse_number": "२-२५-७", "content_sanskrit": "समित्कुशपवित्राणि वेद्यश्चायतनानि च।\nस्थण्डिलानि च विप्राणां शैला वृक्षाः क्षुपा ह्रदाः।\nपतङ्गाः पन्नगाः सिंहास्त्वां रक्षन्तु नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000102008, "chapter_id": 9102, "verse_number": "२-२५-८", "content_sanskrit": "स्वस्ति साध्याश्च विश्वे च मरुतश्च महर्षिभिः।\nस्वस्ति धाता विधाता च स्वस्ति पूषा भगोऽर्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000102009, "chapter_id": 9102, "verse_number": "२-२५-९", "content_sanskrit": "लोकपालाश्च ते सर्वे वासवप्रमुखास्तथा।\nऋतवः षट् च ते सर्वे मासाः संवत्सराः क्षपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000102010, "chapter_id": 9102, "verse_number": "२-२५-१०", "content_sanskrit": "दिनानि च मुहूर्ताश्च स्वस्ति कुर्वन्तु ते सदा।\nश्रुतिः स्मृतिश्च धर्मश्च पातु त्वां पुत्र सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000102011, "chapter_id": 9102, "verse_number": "२-२५-११", "content_sanskrit": "स्कन्दश्च भगवान् देवः सोमश्च सबृहस्पतिः।\nसप्तर्षयो नारदश्च ते त्वां रक्षन्तु सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000102012, "chapter_id": 9102, "verse_number": "२-२५-१२", "content_sanskrit": "ते चापि सर्वतः सिद्धा दिशश्च सदिगीश्वराः।\nस्तुता मया वने तस्मिन् पान्तु त्वां पुत्र नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000102013, "chapter_id": 9102, "verse_number": "२-२५-१३", "content_sanskrit": "शैलाः सर्वे समुद्राश्च राजा वरुण एव च।\nद्यौरन्तरिक्षं पृथिवी वायुश्च सचराचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000102014, "chapter_id": 9102, "verse_number": "२-२५-१४", "content_sanskrit": "नक्षत्राणि च सर्वाणि ग्रहाश्च सह दैवतैः।\nअहोरात्रे तथा संध्ये पान्तु त्वां वनमाश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000102015, "chapter_id": 9102, "verse_number": "२-२५-१५", "content_sanskrit": "ऋतवश्चापि षट् चान्ये मासाः संवत्सरास्तथा।\nकलाश्च काष्ठाश्च तथा तव शर्म दिशन्तु ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000102016, "chapter_id": 9102, "verse_number": "२-२५-१६", "content_sanskrit": "महावनेऽपि चरतो मुनिवेषस्य धीमतः।\nतथा देवाश्च दैत्याश्च भवन्तु सुखदाः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000102017, "chapter_id": 9102, "verse_number": "२-२५-१७", "content_sanskrit": "राक्षसानां पिशाचानां रौद्राणां क्रूरकर्मणाम्।\nक्रव्यादानां च सर्वेषां मा भूत् पुत्रक ते भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000102018, "chapter_id": 9102, "verse_number": "२-२५-१८", "content_sanskrit": "प्लवगा वृश्चिका दंशा मशकाश्चैव कानने।\nसरीसृपाश्च कीटाश्च मा भूवन् गहने तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000102019, "chapter_id": 9102, "verse_number": "२-२५-१९", "content_sanskrit": "महाद्विपाश्च सिंहाश्च व्याघ्रा ऋक्षाश्च दंष्ट्रिणः।\nमहिषाः शृङ्गिणो रौद्रा न ते द्रुह्यन्तु पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000102020, "chapter_id": 9102, "verse_number": "२-२५-२०", "content_sanskrit": "नृमांसभोजना रौद्रा ये चान्ये सर्वजातयः।\nमा च त्वां हिंसिषुः पुत्र मया सम्पूजितास्त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000102021, "chapter_id": 9102, "verse_number": "२-२५-२१", "content_sanskrit": "आगमास्ते शिवाः सन्तु सिध्यन्तु च पराक्रमाः।\nसर्वसम्पत्तयो राम स्वस्तिमान् गच्छ पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000102022, "chapter_id": 9102, "verse_number": "२-२५-२२", "content_sanskrit": "स्वस्ति तेऽस्त्वान्तरिक्षेभ्यः पार्थिवेभ्यः पुनः पुनः।\nसर्वेभ्यश्चैव देवेभ्यो ये च ते परिपन्थिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000102023, "chapter_id": 9102, "verse_number": "२-२५-२३", "content_sanskrit": "शुक्रः सोमश्च सूर्यश्च धनदोऽथ यमस्तथा।\nपान्तु त्वामर्चिता राम दण्डकारण्यवासिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000102024, "chapter_id": 9102, "verse_number": "२-२५-२४", "content_sanskrit": "अग्निर्वायुस्तथा धूमो मन्त्राश्चर्षिमुखच्युताः।\nउपस्पर्शनकाले तु पान्तु त्वां रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000102025, "chapter_id": 9102, "verse_number": "२-२५-२५", "content_sanskrit": "सर्वलोकप्रभुर्ब्रह्मा भूतकर्तृ तथर्षयः।\nये च शेषाः सुरास्ते तु रक्षन्तु वनवासिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000102026, "chapter_id": 9102, "verse_number": "२-२५-२६", "content_sanskrit": "इति माल्यैः सुरगणान् गन्धैश्चापि यशस्विनी।\nस्तुतिभिश्चानुरूपाभिरानर्चायतलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000102027, "chapter_id": 9102, "verse_number": "२-२५-२७", "content_sanskrit": "ज्वलनं समुपादाय ब्राह्मणेन महात्मना।\nहावयामास विधिना राममङ्गलकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000102028, "chapter_id": 9102, "verse_number": "२-२५-२८", "content_sanskrit": "घृतं श्वेतानि माल्यानि समिधश्चैव सर्षपान्।\nउपसम्पादयामास कौसल्या परमाङ्गना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000102029, "chapter_id": 9102, "verse_number": "२-२५-२९", "content_sanskrit": "उपाध्यायः स विधिना हुत्वा शान्तिमनामयम्।\nहुतहव्यावशेषेण बाह्यं बलिमकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000102030, "chapter_id": 9102, "verse_number": "२-२५-३०", "content_sanskrit": "मधुदध्यक्षतघृतैः स्वस्तिवाच्यं द्विजांस्ततः।\nवाचयामास रामस्य वने स्वस्त्ययनक्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000102031, "chapter_id": 9102, "verse_number": "२-२५-३१", "content_sanskrit": "ततस्तस्मै द्विजेन्द्राय राममाता यशस्विनी।\nदक्षिणां प्रददौ काम्यां राघवं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000102032, "chapter_id": 9102, "verse_number": "२-२५-३२", "content_sanskrit": "यन्मङ्गलं सहस्राक्षे सर्वदेवनमस्कृते।\nवृत्रनाशे समभवत् तत् ते भवतु मङ्गलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000102033, "chapter_id": 9102, "verse_number": "२-२५-३३", "content_sanskrit": "यन्मङ्गलं सुपर्णस्य विनताकल्पयत् पुरा।\nअमृतं प्रार्थयानस्य तत् ते भवतु मङ्गलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000102034, "chapter_id": 9102, "verse_number": "२-२५-३४", "content_sanskrit": "अमृतोत्पादने दैत्यान् घ्नतो वज्रधरस्य यत्।\nअदितिर्मङ्गलं प्रादात् तत् ते भवतु मङ्गलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000102035, "chapter_id": 9102, "verse_number": "२-२५-३५", "content_sanskrit": "त्रिविक्रमान् प्रक्रमतो विष्णोरतुलतेजसः।\nयदासीन्मङ्गलं राम तत् ते भवतु मङ्गलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000102036, "chapter_id": 9102, "verse_number": "२-२५-३६", "content_sanskrit": "ऋषयः सागरा द्वीपा वेदा लोका दिशश्च ते।\nमङ्गलानि महाबाहो दिशन्तु शुभमङ्गलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000102037, "chapter_id": 9102, "verse_number": "२-२५-३७", "content_sanskrit": "इति पुत्रस्य शेषाश्च कृत्वा शिरसि भामिनी।\nगन्धैश्चापि समालभ्य राममायतलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000102038, "chapter_id": 9102, "verse_number": "२-२५-३८", "content_sanskrit": "औषधीं च सुसिद्धार्थां विशल्यकरणीं शुभाम्।\nचकार रक्षां कौसल्या मन्त्रैरभिजजाप च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000102039, "chapter_id": 9102, "verse_number": "२-२५-३९", "content_sanskrit": "उवाचापि प्रहृष्टेव सा दुःखवशवर्तिनी।\nवाङ्मात्रेण न भावेन वाचा संसज्जमानया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000102040, "chapter_id": 9102, "verse_number": "२-२५-४०", "content_sanskrit": "आनम्य मूर्ध्नि चाघ्राय परिष्वज्य यशस्विनी।\nअवदत् पुत्रमिष्टार्थो गच्छ राम यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000102041, "chapter_id": 9102, "verse_number": "२-२५-४१", "content_sanskrit": "अरोगं सर्वसिद्धार्थमयोध्यां पुनरागतम्।\nपश्यामि त्वां सुखं वत्स संधितं राजवर्त्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000102042, "chapter_id": 9102, "verse_number": "२-२५-४२", "content_sanskrit": "प्रणष्टदुःखसंकल्पा हर्षविद्योतितानना।\nद्रक्ष्यामि त्वां वनात् प्राप्तं पूर्णचन्द्रमिवोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000102043, "chapter_id": 9102, "verse_number": "२-२५-४३", "content_sanskrit": "भद्रासनगतं राम वनवासादिहागतम्।\nद्रक्ष्यामि च पुनस्त्वां तु तीर्णवन्तं पितुर्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000102044, "chapter_id": 9102, "verse_number": "२-२५-४४", "content_sanskrit": "मङ्गलैरुपसम्पन्नो वनवासादिहागतः।\nवध्वाश्च मम नित्यं त्वं कामान् संवर्ध याहि भोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000102045, "chapter_id": 9102, "verse_number": "२-२५-४५", "content_sanskrit": "मयार्चिता देवगणाः शिवादयो\nमहर्षयो भूतगणाः सुरोरगाः।\nअभिप्रयातस्य वनं चिराय ते\nहितानि कांक्षन्तु दिशश्च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000102046, "chapter_id": 9102, "verse_number": "२-२५-४६", "content_sanskrit": "अतीव चाश्रुप्रतिपूर्णलोचना\nसमाप्य च स्वस्त्ययनं यथाविधि।\nप्रदक्षिणं चापि चकार राघवं\nपुनः पुनश्चापि निरीक्ष्य सस्वजे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000102047, "chapter_id": 9102, "verse_number": "२-२५-४७", "content_sanskrit": "तया हि देव्या च कृतप्रदक्षिणो\nनिपीड्य मातुश्चरणौ पुनः पुनः।\nजगाम सीतानिलयं महायशाः\nस राघवः प्रज्वलितस्तया श्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000102048, "chapter_id": 9102, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे पञ्चविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]