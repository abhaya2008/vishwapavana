[{"id": 35000000, "chapter_id": 8138, "verse_number": "1.1", "content_sanskrit": "शब्दब्रह्म यदेकं यच्चैतन्यं च सर्वभूतानाम् । यत्परिणामस्त्रिभुवनमखिलमिदं जयति सा वाणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 35000001, "chapter_id": 8138, "verse_number": "1.2", "content_sanskrit": "इयममरदत्तवररुचिभागुरिगोपालितादिशास्त्रेभ्यः । अभिधानरत्नमाला कविकण्ठविभूषणार्थमुद्ध्रियते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 35000002, "chapter_id": 8138, "verse_number": "1.3", "content_sanskrit": "स्वः स्वर्गः सुरसद्म त्रिदशावासस्त्रिविष्टपं त्रिदिवम् । द्यौर्गौरमर्त्यभुवनं नाकः स्यादूर्ध्वलोकश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 35000003, "chapter_id": 8138, "verse_number": "1.4", "content_sanskrit": "आदित्यास्त्रिदशाः सुराः सुमनसः स्वर्गौकसो देवता गीर्वाणा ऋभवोऽमराश्च मरुतो वृन्दारका निर्जराः । अस्वप्ना विबुधास्त्रिविष्टपसदो लेखाः सुपर्वाण इत्याख्याता अमृताशना अनिमिषा देवास्तथा दैवतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 35000004, "chapter_id": 8138, "verse_number": "1.5", "content_sanskrit": "असुरा दानवा दैत्या दैतेयाः सुरशत्रवः । पूर्वदेवाः शुक्रशिष्याः पातालनिलयाः स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 35000005, "chapter_id": 8138, "verse_number": "1.6", "content_sanskrit": "ब्रह्मा स्रष्टा परमेष्ठी धाता पद्मभूः सुरज्येष्ठः । वेधा विधिविरिञ्चो हिरण्यगर्भः शतानन्दः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 35000006, "chapter_id": 8138, "verse_number": "1.7", "content_sanskrit": "शम्भुः स्वयम्भूर्द्रुहिणश्चतुर्वक्त्रः प्रजापतिः । पितामहो जगत्कर्ता विरञ्चिः कमलासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 35000007, "chapter_id": 8138, "verse_number": "1.8", "content_sanskrit": "वाग्वाणी भारती भाषा गीर्गीर्ब्राह्मी सरस्वती । ओङ्कारः प्रणवः प्रोक्तस्त्रयो वेदास्त्रयी स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 35000008, "chapter_id": 8138, "verse_number": "1.9", "content_sanskrit": "वेदः श्रुतिस्तथाम्नायः स्वाध्यायश्छन्द आगमः । वेदान्तश्च रहस्यं च बुधैरुपनिषन्मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 35000009, "chapter_id": 8138, "verse_number": "1.10", "content_sanskrit": "ऊहस्तर्कोऽनुमानोक्तिर्मीमांसा स्याद्विचारणा । स्मृताः कृतान्तराद्धान्तसिद्धान्तसमयाः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 35000010, "chapter_id": 8138, "verse_number": "1.11", "content_sanskrit": "ईशानः शशिशेखरः पशुपतिः शूली शिवः शङ्करः शर्वः शम्भुरुमापतिश्च गिरिशः श्रीकण्ठ उग्रो हरः । सर्वज्ञस्त्रिपुरान्तकस्त्रिनयनो रुद्रः कपर्दी भवो भूतेशः परमेश्वरोऽन्धकरिपुर्दक्षाध्वरध्वंसकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 35000011, "chapter_id": 8138, "verse_number": "1.12", "content_sanskrit": "स्थाणुः स्रष्टा धूर्जटिर्वामदेवः कामध्वंसी व्योमकेशः कपाली । नीलग्रीवो वह्निरेताः पिनाकी भीमो भर्गः कृत्तिवासा वृषाङ्कः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 35000012, "chapter_id": 8138, "verse_number": "1.13", "content_sanskrit": "अहिर्बुध्नो विरूपाक्षः शिपिविष्टो गणाधिपः । गङ्गाधरो महादेवो मृडः स्यान्नीललोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 35000013, "chapter_id": 8138, "verse_number": "1.14", "content_sanskrit": "पिनाकं स्यादजगवं प्रमथास्तु गणाः स्मृताः । कपर्दोऽस्य जटाबन्धस्तण्डुः स्यान्नन्दिकेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 35000014, "chapter_id": 8138, "verse_number": "1.15", "content_sanskrit": "रुद्राणी शर्वाणी काली कात्यायनी भवानी च । आर्याम्बिका मृडानी हैमवती पार्वती गौरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 35000015, "chapter_id": 8138, "verse_number": "1.16", "content_sanskrit": "उमा भगवती दुर्गा चण्डी दाक्षायणी शिवा । अपर्णा स्यान्महादेवी गिरिजा मेनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 35000016, "chapter_id": 8138, "verse_number": "1.17", "content_sanskrit": "ब्रह्माण्याद्याः स्मृताः सप्त देवतामातरो बुधैः । चामुण्डा कर्णमोटी च चर्चा स्याद्भैरवी तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 35000017, "chapter_id": 8138, "verse_number": "1.18", "content_sanskrit": "हेरम्बो लम्बोदर आखुरथो गणपतिश्च गजवदनः । परशुधर एकदन्तो विनायको विघ्नराजश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 35000018, "chapter_id": 8138, "verse_number": "1.19", "content_sanskrit": "गौरीपुत्रः षण्मुखः शक्तिपाणिः क्रौञ्चारातिः कार्त्तिकेयो विशाखः । स्कन्दः स्वामी तारकारिः कुमारः सेनानीः स्यादग्निभूर्बाहुलेयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 35000019, "chapter_id": 8138, "verse_number": "1.20", "content_sanskrit": "गाङ्गेयो ब्रह्मचारी च गुहो बर्हिणवाहनः । महासेनो महातेजाः शरजन्मा च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 35000020, "chapter_id": 8138, "verse_number": "1.21", "content_sanskrit": "विष्णुः कृष्णः केशवो मञ्जुकेशी श्रीवत्साङ्कः श्रीपतिः पीतवासाः । विष्वक्सेनो विश्वरूपो मुरारिः शौरिः शार्ङ्गी पद्मनाभो मुकुन्दः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 35000021, "chapter_id": 8138, "verse_number": "1.22", "content_sanskrit": "गोविन्दो धरणिधरः सुपर्णकेतुर्वैकुण्ठो जलशयनश्चतुर्भुजश्च । दैत्यारिर्मधुमथनो रथाङ्गपाणिर्दाशार्हः क्रतुपुरुषो वृषाकपिः स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 35000022, "chapter_id": 8138, "verse_number": "1.23", "content_sanskrit": "जनार्दनाधोक्षजवासुदेवं दामोदरं श्रीधरमच्युतं च । उपेन्द्रमिन्द्रावरजं च बभ्रुं हरिं हृषीकेशमुदाहरन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 35000023, "chapter_id": 8138, "verse_number": "1.24", "content_sanskrit": "आत्मभूः पुण्डरीकाक्षः श्रीवत्सो विष्टरश्रवाः । नारायणो जगन्नाथो वनमाली गदाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 35000024, "chapter_id": 8138, "verse_number": "1.25", "content_sanskrit": "सनातनो जिनः शम्भुर्विर्धावेधा गदाग्रजः । कैटभारिरजो जिष्णुः कंसजित्पुरुषोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 35000025, "chapter_id": 8138, "verse_number": "1.26", "content_sanskrit": "चक्रं सुदर्शनं चापं शार्ङ्गं कौमोदकी गदा । खड्गोऽस्य नन्दकः शङ्खः पाञ्चजन्यः प्रकीर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 35000026, "chapter_id": 8138, "verse_number": "1.27", "content_sanskrit": "कौस्तुभो वक्षसि मणिः श्रीवत्सोऽस्य च लाञ्छनम् । वसुदेवस्तु कथितो बुधैरानकदुन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 35000027, "chapter_id": 8138, "verse_number": "1.28", "content_sanskrit": "बलदेवो बलभद्रो मुशली नीलाम्बरः प्रलम्बघ्नः । सीरी च सात्वतः स्यातालध्वज एककुण्डलोऽनन्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 35000028, "chapter_id": 8138, "verse_number": "1.29", "content_sanskrit": "सङ्कर्षणो रौहिणेयः कालिन्दीकर्षणो बलः । रेवतीरमणो रामः कामपालो हलायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 35000029, "chapter_id": 8138, "verse_number": "1.30", "content_sanskrit": "विहङ्गराजो गरुडो गरुत्मान् तार्क्ष्यः सुपर्णोतनयः सुपर्णः । स्याद्वैनतेयः पवनाशनाशः सुरेन्द्रजित्कश्यपनन्दनश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 35000030, "chapter_id": 8138, "verse_number": "1.31", "content_sanskrit": "लक्ष्मीः श्रीः कमला पद्मा पद्मवासा हरिप्रिया । क्षीरोदतनया मा च शब्दज्ञैरिन्दिरा स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 35000031, "chapter_id": 8138, "verse_number": "1.32", "content_sanskrit": "प्रद्युम्नो मकरध्वजो मनसिजः सङ्कल्पजन्माङ्गजः पञ्चेषुः कुसुमायुधश्च मदनो मारः स्मरो मन्मथः । कन्दर्पो झषकेतनो रतिपतिः श्रीनन्दनो हृच्छयः कामः शम्बरसूदनो मधुसखः शृङ्गारयोनिः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 35000032, "chapter_id": 8138, "verse_number": "1.33", "content_sanskrit": "दर्पकः शूपकारातिरनङ्गो विषमायुधः । आत्मभूर्मनसिशयः पुष्पधन्वा मनोभवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 35000033, "chapter_id": 8138, "verse_number": "1.34", "content_sanskrit": "मापत्यमिरजश्चैव कामपत्नी रतिः स्मृता । अनिरुद्धश्च तत्सूनुरुषारमण इष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}, {"id": 35000034, "chapter_id": 8138, "verse_number": "1.35", "content_sanskrit": "आदित्यः सविता सहस्रकिरणः प्रद्योतनो भास्करस्तिग्मांशुस्तरणिस्तथा दिनमणिर्भास्वान्विवस्वान्हरिः । मार्तण्डस्तपनो विकर्तन इनः पूषा पतङ्गो भगः सूर्यो गोपतिरर्यमा दिनकरः सूरोंऽशुमाली रविः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35, "avatarnika": ""}, {"id": 35000035, "chapter_id": 8138, "verse_number": "1.36", "content_sanskrit": "मिहिरो विरोचनोऽर्कस्तिमिररिपुर्द्युमणिरंशुमानंशुः । हरिदश्वः सप्ताश्वः प्रभाकरो भानुमान्भानुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36, "avatarnika": ""}, {"id": 35000036, "chapter_id": 8138, "verse_number": "1.37", "content_sanskrit": "ब्रध्नो हंसः खगो मित्रश्चित्रभानुरहर्पतिः । कर्मसाक्षी जगच्चक्षुर्द्वादशात्मा त्रयीतनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37, "avatarnika": ""}, {"id": 35000037, "chapter_id": 8138, "verse_number": "1.38", "content_sanskrit": "रोचिः शोचिरभीशुः प्रद्योतगभस्तिरश्मिघृणिकिरणाः । रुचिरुग्दीधितिदीप्तियुतिप्रभाभाविभाभासः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38, "avatarnika": ""}, {"id": 35000038, "chapter_id": 8138, "verse_number": "1.39", "content_sanskrit": "उस्रधामवसुकेतुमरीचिप्रग्रहोपभृतिवृष्णिमयूखाः । अंशुभानुकरपादविरोका गाव इत्यभिहितास्तु समानाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39, "avatarnika": ""}, {"id": 35000039, "chapter_id": 8138, "verse_number": "1.40", "content_sanskrit": "तिग्मं तीक्ष्णं खरं तीव्रं चण्डमुष्णं पटु स्मृतम् । आतपः कथ्यते रौद्रं निदाघो घर्म उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40, "avatarnika": ""}, {"id": 35000040, "chapter_id": 8138, "verse_number": "1.41", "content_sanskrit": "परिधिः परिवेषः स्यान्मण्डलं चोपसूर्यकम् । उच्यते राहुसंस्पर्श उपराग उपप्लवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41, "avatarnika": ""}, {"id": 35000041, "chapter_id": 8138, "verse_number": "1.42", "content_sanskrit": "इन्दुश्चन्द्रश्चन्द्रमा ओषधीशः सोमो राजा रोहिणीवल्लभोऽब्जः । ऋक्षेशः स्यादत्रिनेत्रप्रसूतः प्रालेयांशुः श्वेतरोचिः शशाङ्कः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42, "avatarnika": ""}, {"id": 35000042, "chapter_id": 8138, "verse_number": "1.43", "content_sanskrit": "द्विजराजो रजनिकरः पीयूषरुचिर्निशीथिनीनाथः । जैवातृको मृगाङ्को विधुश्च दाक्षायणीरमणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43, "avatarnika": ""}, {"id": 35000043, "chapter_id": 8138, "verse_number": "1.44", "content_sanskrit": "चन्द्रिका कौमुदी ज्योत्स्ना तथा चन्द्रातपः स्मृतः । मण्डलं बिम्बमाख्यातं हृदये लाञ्छनं मृगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44, "avatarnika": ""}, {"id": 35000044, "chapter_id": 8138, "verse_number": "1.45", "content_sanskrit": "अङ्कश्चिह्न्यमभिज्ञानं लाञ्छनं लक्ष्म लक्षणम् । कलङ्कश्चेति विज्ञेया नातिनानार्थवाचकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45, "avatarnika": ""}, {"id": 35000045, "chapter_id": 8138, "verse_number": "1.46", "content_sanskrit": "वक्रमङ्गारकं भौमं लोहिताङ्गं धरात्मजम् । रौहिणेयं बुधं सौम्यमाहुश्चान्द्रमसायनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46, "avatarnika": ""}, {"id": 35000046, "chapter_id": 8138, "verse_number": "1.47", "content_sanskrit": "वाचस्पतिराङ्गिरसो वृहस्पतिः कथ्यते गुरुर्जीवः । धिषणस्त्रिदशाचार्यश्चित्रशिखण्डिप्रसूतश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47, "avatarnika": ""}, {"id": 35000047, "chapter_id": 8138, "verse_number": "1.48", "content_sanskrit": "उशना शुक्रः काव्यो दैत्यगुरुर्भार्गवः कविर्धिष्ण्यः । असितः क्रोडः पङ्गुश्छायातनयः शनैश्चरः शौरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48, "avatarnika": ""}, {"id": 35000048, "chapter_id": 8138, "verse_number": "1.49", "content_sanskrit": "स्वर्भानुः सैंहिकेयश्च तमो राहुर्विधुन्तुदः । केतवः शिखिनः प्रोक्ता आर्द्रालुब्धक उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49, "avatarnika": ""}, {"id": 35000049, "chapter_id": 8138, "verse_number": "1.50", "content_sanskrit": "सप्तर्षयस्तु विद्वद्भिः स्मृताश्चित्रशिखण्डिनः । कृत्तिका बहुला प्रोक्ताः पक्षस्तु बहुलोऽसितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50, "avatarnika": ""}, {"id": 35000050, "chapter_id": 8138, "verse_number": "1.51", "content_sanskrit": "भं नक्षत्रं तारकं तारका च ज्योतिस्तारा धिष्ण्यमृक्षं तथोडु । पुष्यस्तिष्यः स्याद्धनिष्ठा श्रविष्ठा दाक्षायण्यः कीर्तिताश्चन्द्रदाराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51, "avatarnika": ""}, {"id": 35000051, "chapter_id": 8138, "verse_number": "1.52", "content_sanskrit": "इन्द्रो दुश्च्यवनो हरिः सुरपतिः सङ्क्रन्दनो वासवो वृत्रारिर्बलसूदनः शतमखो वृद्धश्रवाः कौशिकः । जिष्णुर्वज्रधरः सहस्रनयनो वास्तोष्पतिर्गोपतिः पर्जन्यो मघवा वृषा हरिहयः प्राचीनबर्हिः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52, "avatarnika": ""}, {"id": 35000052, "chapter_id": 8138, "verse_number": "1.53", "content_sanskrit": "पुरुहूतः पृतनाषाट् पुरन्दरः पूर्वदिक्पतिः स्वाराट् । आखण्डलस्तुराषाट् सुत्रामा गोत्रभित्सुनासीरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53, "avatarnika": ""}, {"id": 35000053, "chapter_id": 8138, "verse_number": "1.54", "content_sanskrit": "शक्रः स्यादुग्रधन्वा च हरिवान्पाकशासनः । दिवस्पतिर्बिडौजाश्च मरुत्वान्मेघवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54, "avatarnika": ""}, {"id": 35000054, "chapter_id": 8138, "verse_number": "1.55", "content_sanskrit": "इन्द्राणी पौलोमी शची जयन्तश्च तत्सुतो ज्ञेयः । अमरावती च नगरी नन्दनमुद्यानमिन्द्रस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55, "avatarnika": ""}, {"id": 35000055, "chapter_id": 8138, "verse_number": "1.56", "content_sanskrit": "पविरशनिः शतधारं वज्रं कुलिशं च भवति दम्भोलिः । गौर्भिदुरं व्याघामः स्वरुरिन्द्रप्रहरणं तथा शम्बः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56, "avatarnika": ""}, {"id": 35000056, "chapter_id": 8138, "verse_number": "1.57", "content_sanskrit": "स्फूर्जथुर्वज्रनिर्घोषो वज्रज्वालाऽतिभीः स्मृता । ऋजु रोहितमिच्छन्ति बुधाः शक्रशरासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57, "avatarnika": ""}, {"id": 35000057, "chapter_id": 8138, "verse_number": "1.58", "content_sanskrit": "अभ्रमब्दो घनो मेघः स्तनयित्नुः पयोधरः । धाराधरो धूमयोनिर्जीमूतश्च बलाहकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58, "avatarnika": ""}, {"id": 35000058, "chapter_id": 8138, "verse_number": "1.59", "content_sanskrit": "धारासम्पात आसारो वातास्तं वारिसीकरः । दुर्दिनं मेघतिमिरं करकः स्याद्धनोपलः । चलन्नवाभ्रमाला च बुधैः कादम्बिनी स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59, "avatarnika": ""}, {"id": 35000059, "chapter_id": 8138, "verse_number": "1.60", "content_sanskrit": "शम्पा चपला क्षणिका शतह्रदा ह्लादिनी तडिद्विद्युत् । सौदामिन्यचिरांशुः प्राज्ञैरैरावती च विज्ञेया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60, "avatarnika": ""}, {"id": 35000060, "chapter_id": 8138, "verse_number": "1.61", "content_sanskrit": "ऐरावतोऽभ्रमातङ्गः स चैरावण उच्यते । उच्चैःश्रवास्तु देवाश्वो मातलिः शक्रसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61, "avatarnika": ""}, {"id": 35000061, "chapter_id": 8138, "verse_number": "1.62", "content_sanskrit": "सप्तार्चिर्बहुलः शिखी हुतवहो वैश्वानरोऽग्निर्वसुर्वह्निर्वायुसखः सितेतरगतिः स्वाहाप्रियः पावकः । अर्चिष्मान् ज्वलनः कृशानुरनलो धूमध्वजो हव्यवाट् बर्हिर्ज्योतिरुषर्बुधश्च दहनः स्याच्चित्रभानुः शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62, "avatarnika": ""}, {"id": 35000062, "chapter_id": 8138, "verse_number": "1.63", "content_sanskrit": "कृपीटयोनिर्दमुनाः कृष्णवर्त्माशुशुक्षणिः । विभावसुरपांपित्तं जातवेदास्तनूनपात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63, "avatarnika": ""}, {"id": 35000063, "chapter_id": 8138, "verse_number": "1.64", "content_sanskrit": "वीतिहोत्रो वृहद्भानुराश्रयाशो धनञ्जयः । हिरण्यरेतास्तमोघ्नो रोहिताश्वो हुताशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64, "avatarnika": ""}, {"id": 35000064, "chapter_id": 8138, "verse_number": "1.65", "content_sanskrit": "अर्चिः कीला ज्वाला वर्चस्तेजस्त्विषस्तथा ज्योतिः । हेतिर्द्युतिदीप्तिरुचः शिखाप्रभारश्मयः समानार्थाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65, "avatarnika": ""}, {"id": 35000065, "chapter_id": 8138, "verse_number": "1.66", "content_sanskrit": "स्मृतः प्रकाश आलोक उद्द्योतश्च समास्त्रयः । अग्नायी कथ्यते स्वाहा धूम्या स्याद्धूमसंहतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66, "avatarnika": ""}, {"id": 35000066, "chapter_id": 8138, "verse_number": "1.67", "content_sanskrit": "ऊष्मा वाष्पः स्फुलिङ्गश्च कणा जिह्वास्तथार्चिषः । अलातमुल्मुकं ज्ञेयमुल्का ज्वालास्य निर्गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67, "avatarnika": ""}, {"id": 35000067, "chapter_id": 8138, "verse_number": "1.68", "content_sanskrit": "भवति हिरण्या कनका रक्ता कृष्णा सुप्रभा चान्या । अतिरक्ता बहुरूपेति सप्त सप्तार्चिषो जिह्वाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68, "avatarnika": ""}, {"id": 35000068, "chapter_id": 8138, "verse_number": "1.69", "content_sanskrit": "एधस्तर्पणमिन्धनमेधः समिदिध्म इत्यभिन्नार्थाः । भूतिर्भसितं भस्म क्षारं रक्षा च निर्दिष्टा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69, "avatarnika": ""}, {"id": 35000069, "chapter_id": 8138, "verse_number": "1.70", "content_sanskrit": "वनवह्निर्दवो दावो मेघवह्निर्हरिंमदः । और्वः समुद्रवह्निः स्याद्वाडवो वडवामुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70, "avatarnika": ""}, {"id": 35000070, "chapter_id": 8138, "verse_number": "1.71", "content_sanskrit": "शमनः समवर्ती च प्रेतपतिः पितृपतिश्च कीनाशः । वैवस्वतः कृतान्तः कालिन्दीसोदरः कालः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71, "avatarnika": ""}, {"id": 35000071, "chapter_id": 8138, "verse_number": "1.72", "content_sanskrit": "अन्तको धर्मराजश्च यमो दण्डधरो हरिः । दक्षिणाशापतिः सद्भिः श्राद्धदेवश्च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72, "avatarnika": ""}, {"id": 35000072, "chapter_id": 8138, "verse_number": "1.73", "content_sanskrit": "यातूनि यातुधानाः क्रव्यादा राक्षसाश्च रक्षांसि । नक्तञ्चरनैर्ऋतकौणपास्तथा नैकषेयाः स्युः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73, "avatarnika": ""}, {"id": 35000073, "chapter_id": 8138, "verse_number": "1.74", "content_sanskrit": "वरुणं यादसां नाथं पाशपाणिं प्रचेतसम् । जलाधिदैवतं प्राहुः प्रत्यगाशापतिं बुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74, "avatarnika": ""}, {"id": 35000074, "chapter_id": 8138, "verse_number": "1.75", "content_sanskrit": "पवनः श्वसनो वायुर्मरुदनिलो मारुतो जगत्प्राणः । पृषदश्वः पवमानः प्रभञ्जनः स्पर्शनो वातः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75, "avatarnika": ""}, {"id": 35000075, "chapter_id": 8138, "verse_number": "1.76", "content_sanskrit": "नभस्वान्मातरिश्वा च समीरश्च समीरणः । सदागतिर्गन्धवहो हरिः प्रोक्तो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76, "avatarnika": ""}, {"id": 35000076, "chapter_id": 8138, "verse_number": "1.77", "content_sanskrit": "कङ्झावातः सवृष्टिः स्याद्वात्या वातस्य मण्डली । आमोदः स्यात्परिमलः सौरभ्यं च सुगन्धिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77, "avatarnika": ""}, {"id": 35000077, "chapter_id": 8138, "verse_number": "1.78", "content_sanskrit": "ऐलविलः पौलस्त्यो वैश्रवणः किन्नरेश्वरो धनदः । श्रीदः श्रीकण्ठसखो मनुष्यधर्मा धनाध्यक्षः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78, "avatarnika": ""}, {"id": 35000078, "chapter_id": 8138, "verse_number": "1.79", "content_sanskrit": "उत्तराशापतिर्यक्षः कुबेरो नरवाहनः । गुह्यको राजराजश्च धनी पुण्यजनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79, "avatarnika": ""}, {"id": 35000079, "chapter_id": 8138, "verse_number": "1.80", "content_sanskrit": "द्युम्नं द्रव्यं द्रविणं राः सारं स्वापतेयमर्थः स्वम् । ऋक्थं पृक्थं वित्तं धनं हिरण्यं च वसु विभवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80, "avatarnika": ""}, {"id": 35000080, "chapter_id": 8138, "verse_number": "1.81", "content_sanskrit": "अकुप्यं रूप्यहेमाख्यं कुप्यमन्यद्धनं भवेत् । गोमहिष्यादिकं सर्वं बुधैर्जीवधनं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81, "avatarnika": ""}, {"id": 35000081, "chapter_id": 8138, "verse_number": "1.82", "content_sanskrit": "निक्षेपः स्यादुपनिधिः कथ्यते शेवधिर्निधिः । किन्नरः स्यात्किम्पुरुषो मयुरश्वमुखस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82, "avatarnika": ""}, {"id": 35000082, "chapter_id": 8138, "verse_number": "1.83", "content_sanskrit": "उद्यानं स्याच्चैत्ररथं विमानं चास्य पुष्पकम् । अलका नगरी ज्ञेया पुत्रस्तु नलकूबरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83, "avatarnika": ""}, {"id": 35000083, "chapter_id": 8138, "verse_number": "1.84", "content_sanskrit": "विश्वकृद्विश्वकर्मा च त्वष्टा स्याद्देववर्धकिः । नासत्यावश्विनौ दस्रौ प्रोक्तौ देवचिकित्सकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84, "avatarnika": ""}, {"id": 35000084, "chapter_id": 8138, "verse_number": "1.85", "content_sanskrit": "शौद्धोदनिर्दशबलो बुद्धः शाक्यस्तथागतः सुगतः । मारजिद्दद्वयवादी समन्तभद्रो जिनश्च सिद्धार्थः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85, "avatarnika": ""}, {"id": 35000085, "chapter_id": 8138, "verse_number": "1.86", "content_sanskrit": "जिनेन्द्रो वीतरागोऽर्हन् केवली च त्रिकालवित् । अलक्ष्मीर्निर्ऋतिर्ज्ञेया नियतिर्विधिरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86, "avatarnika": ""}, {"id": 35000086, "chapter_id": 8138, "verse_number": "1.87", "content_sanskrit": "यक्षराक्षसगन्धर्वसिद्धकिन्नरगुह्यकाः । विद्याधराप्सरोभूतपिशाचा देवयोनयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87, "avatarnika": ""}, {"id": 35000087, "chapter_id": 8138, "verse_number": "1.88", "content_sanskrit": "घृताची मेनका रम्भा उर्वशी च तिलोत्तमा । सुकेशी मञ्जुघोषाद्याः कथ्यन्तेऽप्सरसो बुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88, "avatarnika": ""}, {"id": 35000088, "chapter_id": 8138, "verse_number": "1.89", "content_sanskrit": "हेलाविलासबिब्बोकलीलाललितविभ्रमाः । स्त्रीणां शृङ्गारचेष्टाः स्युर्हावपर्यायवाचकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89, "avatarnika": ""}, {"id": 35000089, "chapter_id": 8138, "verse_number": "1.90", "content_sanskrit": "बाह्यार्थालम्बनो यस्तु विकारो मानसो भवेत् । स भावः कथ्यते सद्भिस्तस्योत्कर्षो रसः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90, "avatarnika": ""}, {"id": 35000090, "chapter_id": 8138, "verse_number": "1.91", "content_sanskrit": "रतिर्हासश्च शोकश्च क्रोधोत्साहौ भयं तथा । जुगुप्साविस्मयशमाः स्थायिभावाः प्रकीर्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91, "avatarnika": ""}, {"id": 35000091, "chapter_id": 8138, "verse_number": "1.92", "content_sanskrit": "शृङ्गारहास्यकरुणा रौद्रवीरभयानकाः । बीभत्साद्भुतशान्ताश्च नव नाट्ये रसाः स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92, "avatarnika": ""}, {"id": 35000092, "chapter_id": 8138, "verse_number": "1.93", "content_sanskrit": "गीतं गानमिति प्रोक्तं वाद्यमातोद्यमिष्यते । नृत्यं तु ताण्डवं लास्यं त्रितयं नाट्यमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93, "avatarnika": ""}, {"id": 35000093, "chapter_id": 8138, "verse_number": "1.94", "content_sanskrit": "तालः कालक्रियामानं लयः साम्यमुदाहृतम् । अङ्गहारोऽङ्गविक्षेपः सूच्योऽर्थोऽभिनयः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94, "avatarnika": ""}, {"id": 35000094, "chapter_id": 8138, "verse_number": "1.95", "content_sanskrit": "प्रेक्षार्थं गीतवाद्यं तु सङ्गीतमभिधीयते । आदावेव तु यन्नाट्यं पूर्वरङ्गः स उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95, "avatarnika": ""}, {"id": 35000095, "chapter_id": 8138, "verse_number": "1.96", "content_sanskrit": "प्रोक्ता घोषवती वीणा विपञ्ची परिवादिनी । वल्लकी चेति तद्भेदास्तन्त्रीभेदसमुद्भवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96, "avatarnika": ""}, {"id": 35000096, "chapter_id": 8138, "verse_number": "1.97", "content_sanskrit": "रङ्गः स्यान्नर्तनस्थानं मृदङ्गो मुरजः स्मृतः । आनकः पटहो ज्ञेयो डिण्डिमः पणवस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97, "avatarnika": ""}, {"id": 35000097, "chapter_id": 8138, "verse_number": "1.98", "content_sanskrit": "कोणो वादनदण्डः स्याद्भेरी दुन्दुभिरिष्यते । नाट्ये राज्ञी स्मृता देवी कुमारो भर्तृदारकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98, "avatarnika": ""}, {"id": 35000098, "chapter_id": 8138, "verse_number": "1.99", "content_sanskrit": "भाव इत्युच्यते विद्वान् भावुको भगिनीपतिः । आवुकस्तु पिता ज्ञेय आर्यो मारिष उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99, "avatarnika": ""}, {"id": 35000099, "chapter_id": 8138, "verse_number": "1.100", "content_sanskrit": "आशाः ककुभः काष्ठा हरितश्च दिशः समाख्याताः । इन्द्रानलयमनैर्ऋतवरुणमरुद्धनदरुद्रदिक्पालाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100, "avatarnika": ""}, {"id": 35000100, "chapter_id": 8138, "verse_number": "1.101", "content_sanskrit": "ऐन्द्री पूर्वा प्राची याम्या दिग्दक्षिणा तथाऽवाची । स्याद्वारुणी प्रतीची कौबेरी चोत्तरोदीची ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101, "avatarnika": ""}, {"id": 35000101, "chapter_id": 8138, "verse_number": "1.102", "content_sanskrit": "अन्तराला दिशश्चान्या विदिशः प्रदिशः स्मृताः । उपरिष्टादुपर्युर्ध्वं तथाधस्तादवागधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102, "avatarnika": ""}, {"id": 35000102, "chapter_id": 8138, "verse_number": "1.103", "content_sanskrit": "प्राचीनं प्राक् स्मृतं प्राज्ञैरुदीचीनमुदक् तथा । प्रत्यक् चैव प्रतीचीनमपाचीनमपागिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103, "avatarnika": ""}, {"id": 35000103, "chapter_id": 8138, "verse_number": "1.104", "content_sanskrit": "ऐरावतः पुण्डरीकः कुमुदाञ्जनवामनाः । पुष्पदन्तः सार्वभौमः सुप्रतीकश्च दिग्गजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104, "avatarnika": ""}, {"id": 35000104, "chapter_id": 8138, "verse_number": "1.105", "content_sanskrit": "दिष्टः कालस्तथानेहास्तद्भेदाः स्युः कलादयः । अहोरात्रं च विद्वद्भिः कथ्यते षष्टिनाडिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105, "avatarnika": ""}, {"id": 35000105, "chapter_id": 8138, "verse_number": "1.106", "content_sanskrit": "दिवसो दिवा दिनं द्युः प्रोक्तमहर्वासरस्तथा घस्रः । प्रहरो यामः सन्ध्ये रजनीदिनयोः प्रवेशनिष्कासौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106, "avatarnika": ""}, {"id": 35000106, "chapter_id": 8138, "verse_number": "1.107", "content_sanskrit": "क्षपा त्रियामा क्षणदा निशीथिनी निशा च दोषा रजनी च यामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107, "avatarnika": ""}, {"id": 35000107, "chapter_id": 8138, "verse_number": "1.108", "content_sanskrit": "वसतिर्वासतेयी च श्यामा रात्रिश्च कथ्यते । गणरात्रो निशा बह्व्यश्चिररात्रस्ततः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108, "avatarnika": ""}, {"id": 35000108, "chapter_id": 8138, "verse_number": "1.109", "content_sanskrit": "सायं दिवाबसानं स्यात्प्रदोषो रजनीमुखम् । निशीथो मध्यमा रात्रिः प्रोक्ता सा च महानिशा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109, "avatarnika": ""}, {"id": 35000109, "chapter_id": 8138, "verse_number": "1.110", "content_sanskrit": "अवतमसमन्धतमसं संतमसं ध्वान्तमन्धकारं च । तिमिरं तमस्तमिस्रां तमिस्रमिच्छन्ति भूछायाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110, "avatarnika": ""}, {"id": 35000110, "chapter_id": 8138, "verse_number": "1.111", "content_sanskrit": "कल्यमुषः प्रत्यूषं प्रगे प्रभातं भवेद्विभातं च । दिवसमुखं गोसर्गः प्रातर्व्युष्टं च निर्दिष्टम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111, "avatarnika": ""}, {"id": 35000111, "chapter_id": 8138, "verse_number": "1.112", "content_sanskrit": "शशिनि सिनीवाली स्याद्दृष्टे नष्टे कुहूरमावास्या । अनुमतिरूने राका सम्पूर्णे पूर्णमासी च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112, "avatarnika": ""}, {"id": 35000112, "chapter_id": 8138, "verse_number": "1.113", "content_sanskrit": "त्रिंशदहोरात्रः स्यान्मासस्ताभ्यामृतुर्वसन्ताद्याः । ग्रीष्मः प्रावृट् शरदा हेमन्तः शिशिर इति ते षट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113, "avatarnika": ""}, {"id": 35000113, "chapter_id": 8138, "verse_number": "1.114", "content_sanskrit": "चैत्रादिमासा मधुमाधवौ द्वौ ततः परं शुक्रशुची क्रमेण । नभोनभस्यौ कथिताविषोर्जों सहःसहस्यौ च तपस्तपस्यौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114, "avatarnika": ""}, {"id": 35000114, "chapter_id": 8138, "verse_number": "1.115", "content_sanskrit": "मासेन मनुष्याणां पित्र्यमहोरात्रमेकमिच्छन्ति । अब्देन तु देवानां ब्राह्मं देवयुगसहस्राभ्याम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115, "avatarnika": ""}, {"id": 35000115, "chapter_id": 8138, "verse_number": "1.116", "content_sanskrit": "हायनाब्दशरद्वर्षसंवत्सरसमाः समाः । निदाघः कथ्यते ग्रीष्मो वर्षाः प्रावृट् तपात्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116, "avatarnika": ""}, {"id": 35000116, "chapter_id": 8138, "verse_number": "1.117", "content_sanskrit": "संवर्तः परिवर्तः क्षयो युगान्तो जगद्विनाशश्च । कल्पान्तः समसुप्तिः संहारः स्यान्महाप्रलयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117, "avatarnika": ""}, {"id": 35000117, "chapter_id": 8138, "verse_number": "1.118", "content_sanskrit": "सान्दृष्टिकं फलं सद्य उदर्कः फलमुत्तरम् । तत्कालं तु तदात्वं स्यादुत्तरः काल आयतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118, "avatarnika": ""}, {"id": 35000118, "chapter_id": 8138, "verse_number": "1.119", "content_sanskrit": "दितिरदितिर्दनुकद्रूनिकषाविनताश्च मातरः प्रोक्ताः । दैत्यसुरदानवोरगपिशिताशनपक्षिराजानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119, "avatarnika": ""}, {"id": 35000119, "chapter_id": 8138, "verse_number": "1.120", "content_sanskrit": "चन्द्रार्कविवेकवाक्येन पुष्पदन्तौ प्रकीर्तितौ । जायापती च विद्वद्भिर्जम्पती दम्पती तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120, "avatarnika": ""}, {"id": 35000120, "chapter_id": 8138, "verse_number": "1.121", "content_sanskrit": "द्यावाभूमी च रोदस्यौ रोदसी रोदसीति च । कशिपुर्भोजनाच्छादावौशीरं शयनासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121, "avatarnika": ""}, {"id": 35000121, "chapter_id": 8138, "verse_number": "1.122", "content_sanskrit": "श्वः श्रेयसं स्यात्कल्याणं श्वोवसीयं शिवं शुभम् । भविकं भावुकं श्रेयो भव्यं भद्रं च मङ्गलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122, "avatarnika": ""}, {"id": 35000122, "chapter_id": 8138, "verse_number": "1.123", "content_sanskrit": "प्रमोदप्रमदौ हर्षः प्रीतिरुत्कर्ष उद्धवः । सम्मदो मुत्तथानन्दः शर्म जोषं च शं सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123, "avatarnika": ""}, {"id": 35000123, "chapter_id": 8138, "verse_number": "1.124", "content_sanskrit": "कैवल्यं निर्वाणं निःश्रेयसममृतमक्षरं ब्रह्म । अपुनर्भवोऽपवर्गो मुक्तिर्मोक्षो महानन्दः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124, "avatarnika": ""}, {"id": 35000124, "chapter_id": 8138, "verse_number": "1.125", "content_sanskrit": "सनातनं ध्रुवं नित्यं शाश्वतं स्यादनश्वरम् । धर्मः पुण्यं वृषः श्रेयः सुकृतं च समं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125, "avatarnika": ""}, {"id": 35000125, "chapter_id": 8138, "verse_number": "1.126", "content_sanskrit": "इष्टानिष्टफलं प्राज्ञैः स्मृतं दैवमयानयम् । भागधेयं तथा भाग्यं विपाको भवितव्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126, "avatarnika": ""}, {"id": 35000126, "chapter_id": 8138, "verse_number": "1.127", "content_sanskrit": "उपलिङ्गमरिष्टं स्यादुपसर्ग उपद्रवस्तथोत्पातः । ईतिरजन्यं च बुधैर्डमरो डिम्बश्च विप्लवः कथितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127, "avatarnika": ""}, {"id": 35000127, "chapter_id": 8138, "verse_number": "1.128", "content_sanskrit": "अर्चा पूजा सपर्या स्यादुपहारो बलिः स्मृतः । प्रणिधानं समाधानं समाधिश्च समाश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128, "avatarnika": ""}, {"id": 35000128, "chapter_id": 8138, "verse_number": "1.129", "content_sanskrit": "वरिवस्या परिचर्या शुश्रूषोपासना परीष्टिः स्यात् । सेवा भक्तिरुपास्तिः प्रसादनाराधनोपचाराश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129, "avatarnika": ""}, {"id": 35000129, "chapter_id": 8138, "verse_number": "1.130", "content_sanskrit": "प्रतिबिम्बं प्रतिरूपं प्रतिमानं प्रतिकृति प्रतिच्छन्दम् । प्रतिकायं च प्रतिनिधिमाहुः प्रतियातनां प्रतिच्छायाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130, "avatarnika": ""}, {"id": 35000130, "chapter_id": 8138, "verse_number": "1.131", "content_sanskrit": "अर्चा तु प्रतिमा प्रोक्ता हरिणी स्याद्धिरण्मयी । अन्यलोहमयी प्राज्ञैः सूर्मी स्थूणा च कथ्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131, "avatarnika": ""}, {"id": 35000131, "chapter_id": 8138, "verse_number": "1.132", "content_sanskrit": "शुचिर्मेध्यं पवित्रं च पुण्यं पावनमुच्यते । विमलं विशदं वीभ्रमुज्ज्वलं स्यादनाविलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132, "avatarnika": ""}, {"id": 35000132, "chapter_id": 8138, "verse_number": "1.133", "content_sanskrit": "भुवनं विष्टपं लोको जगदेकार्थवाचकाः । अमृतं त्रिदशाहारः सुधा पीयूषमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133, "avatarnika": ""}, {"id": 35000133, "chapter_id": 8138, "verse_number": "1.134", "content_sanskrit": "असवो जीवितं प्राणा जीवो जीवा च कथ्यते । क्षेत्रज्ञः पुरुषो ह्यात्मा संसारी चेतनो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134, "avatarnika": ""}, {"id": 35000134, "chapter_id": 8138, "verse_number": "1.135", "content_sanskrit": "मन्दारपारिजातकहरिचन्दनकल्पवृक्षसन्तानाः । पञ्चैते सुरतरवो मेरुः सुरपर्वतो ज्ञेयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135, "avatarnika": ""}, {"id": 35000135, "chapter_id": 8138, "verse_number": "1.136", "content_sanskrit": "शक्रक्रीडाचलो मेरुः सुमेरुर्हेमपर्वतः । रत्नसानुरिति ख्यातो हेमाद्रिस्त्रिदशालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136, "avatarnika": ""}, {"id": 35000136, "chapter_id": 8138, "verse_number": "1.137", "content_sanskrit": "नभो मरुद्वर्त्म वियद्विहायस्तारापथः पुष्करमन्तरिक्षम् । व्योमाम्बरं विष्णुपदं च खं द्यौर्विहायसा स्याद्गगनं तथा द्युः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137, "avatarnika": ""}, {"id": 35000137, "chapter_id": 8138, "verse_number": "1.138", "content_sanskrit": "ह्रादो नादः शब्दः स्वानो ध्वानः स्वरो रवो घोषः । अभिधानव्याहारोदीरणकथनादयस्तु तद्भेदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138, "avatarnika": ""}, {"id": 35000138, "chapter_id": 8138, "verse_number": "1.139", "content_sanskrit": "कोलाहलः कलकलस्तुमुलो व्याकुलो रवः । उच्चावचमिति प्रोक्तमनिबद्धं तु यद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139, "avatarnika": ""}, {"id": 35000139, "chapter_id": 8138, "verse_number": "1.140", "content_sanskrit": "उच्चैस्तरो ध्वनिस्तारो मन्द्रो गम्भीर उच्यते । कलश्च मधुरोऽव्यक्तो विक्रुष्टो निष्ठुरो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140, "avatarnika": ""}, {"id": 35000140, "chapter_id": 8138, "verse_number": "1.141", "content_sanskrit": "सान्त्वं स्यान्मधुरं वाक्यं प्रियं सत्यं च सूनृतम् । ख्यातं म्लिष्टमविस्पष्टमबद्धं वियुतार्थकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141, "avatarnika": ""}, {"id": 35000141, "chapter_id": 8138, "verse_number": "1.142", "content_sanskrit": "तूर्णोदितं निरस्तं स्याद् ग्रस्तं लुप्तपदं स्मृतम् । अम्बूकृतं सनिष्ठीवं ग्राम्यमश्लीलमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142, "avatarnika": ""}, {"id": 35000142, "chapter_id": 8138, "verse_number": "1.143", "content_sanskrit": "भिन्नकण्ठो ध्वनिर्थीरैः काकुरित्यभिधीयते । समासप्रायमाख्यातं पदजातं च तण्डकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143, "avatarnika": ""}, {"id": 35000143, "chapter_id": 8138, "verse_number": "1.144", "content_sanskrit": "ऋतं सत्यं समीचीनं सम्यक् तथ्यं यथातथम् । अलीकं वितथं मिथ्या मृषा स्यादनृतं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144, "avatarnika": ""}, {"id": 35000144, "chapter_id": 8138, "verse_number": "1.145", "content_sanskrit": "अर्थवादः प्रशंसा च स्तोत्रमीडा स्तुतिर्नुतिः । विकत्थनं स्तवः श्लाघा वर्णना च निगद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145, "avatarnika": ""}, {"id": 35000145, "chapter_id": 8138, "verse_number": "1.146", "content_sanskrit": "चटु चाटु प्रियं वाक्यं हृद्यार्थं हृदयङ्गमम् । वार्त्तोदन्तः प्रवृत्तिश्च वृत्तान्तश्च समाः स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146, "avatarnika": ""}, {"id": 35000146, "chapter_id": 8138, "verse_number": "1.147", "content_sanskrit": "अनादिवार्त्ता ह्यैतिह्यं किंवदन्ती जनश्रुतिः । कौलीनं जनवादः स्याद्विगानं वचनीयता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147, "avatarnika": ""}, {"id": 35000147, "chapter_id": 8138, "verse_number": "1.148", "content_sanskrit": "अपवाद उपक्रोशो निर्वादावर्णवादपरिवादाः । एकार्थाः कथ्यन्ते गर्हा निन्दा जुगुप्सा च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148, "avatarnika": ""}, {"id": 35000148, "chapter_id": 8138, "verse_number": "1.149", "content_sanskrit": "शाप आक्रोश आक्षेपः क्षारणा स्याद्विरूक्षणम् । स्मृताः सोल्लुण्ठसोत्प्रास सोपहासाः समास्त्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149, "avatarnika": ""}, {"id": 35000149, "chapter_id": 8138, "verse_number": "1.150", "content_sanskrit": "अनुलापो मुहुर्भाषा प्रलापोऽनर्थकं वचः । काक्वा वर्णनमुल्लापः संलापो भाषणं मिथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150, "avatarnika": ""}, {"id": 35000150, "chapter_id": 8138, "verse_number": "1.151", "content_sanskrit": "मर्मरः शुष्कपर्णानां विस्फारो धनुषां ध्वनिः । वृंहितं वारणानां च हेषा ह्रेषा च वाजिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151, "avatarnika": ""}, {"id": 35000151, "chapter_id": 8138, "verse_number": "1.152", "content_sanskrit": "आख्या संज्ञाभिधाह्वानं नामधेयं च नाम च । आख्यायिका कथाख्यानं प्रह्वलीका प्रहेलिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152, "avatarnika": ""}, {"id": 35000152, "chapter_id": 8138, "verse_number": "1.153", "content_sanskrit": "विदुराभ्रेडितं प्राज्ञा द्विस्त्रिर्व्याहरणं च यत् । कीर्तिः श्लोको यशोऽभिख्यासमाख्यास्तुल्यलक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153, "avatarnika": ""}, {"id": 35000153, "chapter_id": 8138, "verse_number": "1.154", "content_sanskrit": "प्रश्नः स्यादनुयोगः पर्यनुयोगो भवेदुपालम्भः । आकारणमाह्वानं कथयन्त्यभिमन्त्रणं प्राज्ञाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154, "avatarnika": ""}, {"id": 35000154, "chapter_id": 8138, "verse_number": "1.155", "content_sanskrit": "तत्रभवान् भगवानिति शब्दो वृद्धैः प्रयुज्यते पूज्ये । पादा इति नामान्ते देवो भट्टारको वापि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155, "avatarnika": ""}]