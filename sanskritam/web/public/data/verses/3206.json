[{"id": 2102199, "chapter_id": 3206, "verse_number": "१४-६२-१", "content_sanskrit": "वैशम्पायन उवाच।\nएतच्छ्रुत्वा तु पुत्रस्य वचः शूरात्मजस्तदा।\nविहाय शोकं धर्मात्मा ददौ श्राद्धमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102200, "chapter_id": 3206, "verse_number": "१४-६२-२", "content_sanskrit": "तथैव वासुदेवश्च स्वस्त्रीयस्य महात्मनः।\nदयितस्यि पितुर्नित्यमकरोदौर्ध्वदेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102201, "chapter_id": 3206, "verse_number": "१४-६२-३", "content_sanskrit": "षष्टिं शतसहस्राणि ब्राह्मणानां महौजसाम्।\nविधिवद्भोजयामास भोज्यं सर्वगुणान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102202, "chapter_id": 3206, "verse_number": "१४-६२-४", "content_sanskrit": "आच्छाद्य च महाबाहुर्धनतृष्णामपानुदत्।\nब्राह्मणानां तदा कृष्णस्तदभूद्रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102203, "chapter_id": 3206, "verse_number": "१४-६२-५", "content_sanskrit": "सुवर्णं चैव गाश्चैव शयनाच्छादनानि च।\nदीयमानं तदा विप्रः प्रभूतमिति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102204, "chapter_id": 3206, "verse_number": "१४-६२-६", "content_sanskrit": "वासुदेवोऽथ दाशार्हो बलेदेवः ससात्यकिः।\nअभिमन्योस्तदा श्राद्धमकुर्वन्सत्यकस्तदा।\nअतीव दुःखसंतप्ता न शमं चोपलेभिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102205, "chapter_id": 3206, "verse_number": "१४-६२-७", "content_sanskrit": "तथैव पाण्डवा वीरा नगरे नागसह्वये।\nनोपागच्छन्त वै शान्तिमभिमन्युविनाकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102206, "chapter_id": 3206, "verse_number": "१४-६२-८", "content_sanskrit": "सुबहूनि च राजेन्द्र दिवसानि विराटजा।\nनाभुङ्क्त पतिदुःखार्ता तदभूत्करुणं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102207, "chapter_id": 3206, "verse_number": "१४-६२-९", "content_sanskrit": "धियमाणे तु तस्मिंस्तु गर्भे कुक्षिस्थ एव च।\nआजगाम ततो व्यासो ज्ञात्वा दिव्येन चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102208, "chapter_id": 3206, "verse_number": "१४-६२-१०", "content_sanskrit": "समागम्याब्रवीमान्पृथां पृथुललोचनाम्।\nउत्तरां च महातेजाःइ शोकः संत्यज्यतामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102209, "chapter_id": 3206, "verse_number": "१४-६२-११", "content_sanskrit": "जनिष्यते महातेजाः पुत्रस्तव यशस्विनि।\nप्रभावाद्वासुदेवस्य मम व्याहरणादपि।\nपाण्डवानामयं चान्ते पालयिष्यति मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102210, "chapter_id": 3206, "verse_number": "१४-६२-१२", "content_sanskrit": "धनञ्जयं च सम्प्रेक्ष्य धर्मराजस्य शृण्वतः।\nव्यासो वाक्यमुवाचेदं हर्षयन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102211, "chapter_id": 3206, "verse_number": "१४-६२-१३", "content_sanskrit": "पौत्रस्तव महाभागो जनिष्यति महामनाः।\nपृथ्वीं सागरपर्यन्तां पालयिष्यति धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102212, "chapter_id": 3206, "verse_number": "१४-६२-१४", "content_sanskrit": "तस्माच्छोकं कुरुश्रेष्ठ जहि त्वमरिकर्शन।\nविचार्यमत्र न हि ते सत्यमेतद्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102213, "chapter_id": 3206, "verse_number": "१४-६२-१५", "content_sanskrit": "यच्चापि वृष्णिवीरेणि कृष्णेन कुरुनन्दन।\nपुरोक्तं तत्तथा भावि मा तेऽत्रास्तु विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102214, "chapter_id": 3206, "verse_number": "१४-६२-१६", "content_sanskrit": "विबुधानां गतो लोकानक्षयानात्मनिर्जितान्।\nन स शोच्यस्त्वया वीरो न चान्यैः कुरुभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102215, "chapter_id": 3206, "verse_number": "१४-६२-१७", "content_sanskrit": "एवं पितामहेनोक्तो धर्मात्मा स धनञ्जयः।\nत्यक्त्वा शोकं महाराज हृष्टरूपोऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102216, "chapter_id": 3206, "verse_number": "१४-६२-१८", "content_sanskrit": "पिताऽपि तव धर्मेज्ञ गर्भे तस्मिन्महामते।\nअवर्धत यथाकामं शुक्लपक्षे यथा शसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102217, "chapter_id": 3206, "verse_number": "१४-६२-१९", "content_sanskrit": "ततः संचोदयामास व्यासो धर्मात्मजं नृपम्।\nअश्वमेधं प्रति तदा ततः सोऽन्तर्हितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102218, "chapter_id": 3206, "verse_number": "१४-६२-२०", "content_sanskrit": "धर्मराजोपि मेधावी श्रुत्वा व्यासस्य तद्वचः।\nवित्तोपनयने तात चकार गमने मतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102219, "chapter_id": 3206, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि द्विषष्टितमोऽध्यायः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]