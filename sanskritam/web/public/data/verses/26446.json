[{"id": 7006446000, "chapter_id": 26446, "verse_number": "२-१०६-१", "content_sanskrit": "वैशम्पायन उवाच\nशम्बरस्तु ततः क्रुद्धः सूतमाह विशाम्पते ।\nशत्रुप्रमुखतो वीर रथं मे वाहय द्रुतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006446001, "chapter_id": 26446, "verse_number": "२-१०६-२", "content_sanskrit": "यावदेनं शरैर्हन्मि मम विप्रियकारकम् ।\nततो भर्तृवचः श्रुत्वा सूतस्तत्प्रियकारकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006446002, "chapter_id": 26446, "verse_number": "२-१०६-३", "content_sanskrit": "रथं संचोदयामास चामीकरविभूषितम् ।\nतं दृष्ट्वा रथमायान्तं प्रद्युम्नः फुल्ललोचनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006446003, "chapter_id": 26446, "verse_number": "२-१०६-४", "content_sanskrit": "संदधे चापमादाय शरं कनकभूषितम् ।\nतेनाहनत् सुसंक्रुद्धः कोपयञ्शम्बरं रणे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006446004, "chapter_id": 26446, "verse_number": "२-१०६-५", "content_sanskrit": "हृदये ताडितस्तेन देवशत्रुः सुविक्लवः ।\nरथशक्तिं समाश्रित्य तस्थौ सोऽथ विचेतनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006446005, "chapter_id": 26446, "verse_number": "२-१०६-६", "content_sanskrit": "स चेतनां पुनः प्राप्य धनुरादाय शम्बरः ।\nविव्याध कार्ष्णिं कुपितः सप्तभिर्निशितैः शरैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006446006, "chapter_id": 26446, "verse_number": "२-१०६-७", "content_sanskrit": "तानप्राप्ताञ्शरान् सोऽथ सप्तभिः सप्तधाच्छिनत्।\nशम्बरं च जघानाथ सप्तत्या निशितैः शरैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006446007, "chapter_id": 26446, "verse_number": "२-१०६-८", "content_sanskrit": "पुनः शरसहस्रेण कङ्कबर्हिणवाससा ।\nअहनच्छम्बरं क्रोधाद् धाराभिरिव पर्वतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006446008, "chapter_id": 26446, "verse_number": "२-१०६-९", "content_sanskrit": "प्रदिशो विदिशश्चैव शरधारासमावृताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006446009, "chapter_id": 26446, "verse_number": "२-१०६-१०", "content_sanskrit": "अन्धकारीकृतं व्योम दिनकर्ता न दृश्यते ।\nततोऽन्धकारमुत्सार्य वैद्युतास्त्रेण शम्बरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006446010, "chapter_id": 26446, "verse_number": "२-१०६-११", "content_sanskrit": "प्रद्युम्नस्य रथोपस्थे शरवर्षं मुमोच ह ।\nतदस्त्रजालं प्रद्युम्नः शरेणानतपर्वणा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006446011, "chapter_id": 26446, "verse_number": "२-१०६-१२", "content_sanskrit": "चिच्छेद बहुधा राजन्दर्शयन् पाणिलाघवम्।\nहते तस्मिन् महावर्षे शराणां कार्ष्णिना तदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006446012, "chapter_id": 26446, "verse_number": "२-१०६-१३", "content_sanskrit": "द्रुमवर्षं मुमोचाथ मायया कालशम्बरः ।\nद्रुमवर्षोच्छ्रितं दृष्ट्वा प्रद्युम्नः क्रोधमूर्च्छितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006446013, "chapter_id": 26446, "verse_number": "२-१०६-१४", "content_sanskrit": "आग्नेयास्त्रं मुमोचाथ तेन वृक्षाननाशयत् ।\nभस्मीभूते वृक्षवर्षे शिलासंघातमुत्सृजत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006446014, "chapter_id": 26446, "verse_number": "२-१०६-१५", "content_sanskrit": "प्रद्युम्नस्तं तु वायव्यैः प्रोत्सारयत संयुगे ।\nततो मायां परां चक्रे देवशत्रुः प्रतापवान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006446015, "chapter_id": 26446, "verse_number": "२-१०६-१६", "content_sanskrit": "सिंहान्व्याघ्रान् वराहांश्च तरक्षूनृक्षवानरान् ।\nवारणान् वारिदप्रख्यान्हयानुष्ट्रान्विशाम्पते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006446016, "chapter_id": 26446, "verse_number": "२-१०६-१७", "content_sanskrit": "मुमोच धनुरायम्य प्रद्युम्नस्य रथोपरि ।\nगान्धर्वास्त्रेण चिच्छेद सर्वांस्तान्खण्डशस्तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006446017, "chapter_id": 26446, "verse_number": "२-१०६-१८", "content_sanskrit": "प्रद्युम्नेन तु सा माया हता तां वीक्ष्य शम्बरः ।\nअन्यां मायां मुमोचाथ शम्बरः क्रोधमूर्च्छितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006446018, "chapter_id": 26446, "verse_number": "२-१०६-१९", "content_sanskrit": "गजेन्द्रान् भिन्नवदनान् षष्टिहायनयौवनान् ।\nमहामात्रोत्तमारूढान् कल्पितान् रणकोविदान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006446019, "chapter_id": 26446, "verse_number": "२-१०६-२०", "content_sanskrit": "तामापतन्तीं मायां तु कार्ष्णिः कमललोचनः ।\nसैंहीं मायां समुत्स्रष्टुं चक्रे बुद्धिं महामनाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006446020, "chapter_id": 26446, "verse_number": "२-१०६-२१", "content_sanskrit": "सा सृष्टा सिंहमाया तु रौक्मिणेयेन धीमता ।\nमाया नागवती नष्टा आदित्येनेव शर्वरी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006446021, "chapter_id": 26446, "verse_number": "२-१०६-२२", "content_sanskrit": "निहतां हस्तिमायां तु तां समीक्ष्य महासुरः ।\nअन्यां सम्मोहिनीं मायां सोऽसृजद् दानवोत्तमः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006446022, "chapter_id": 26446, "verse_number": "२-१०६-२३", "content_sanskrit": "तां दृष्ट्वा मोहिनीं नाम मायां मयविनिर्मिताम् ।\nसंज्ञास्त्रेण तु प्रद्युम्नो नाशयामास वीर्यवान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006446023, "chapter_id": 26446, "verse_number": "२-१०६-२४", "content_sanskrit": "शम्बरस्तु ततः क्रुद्धो हतया मायया तदा ।\nसैंहीं मायां महातेजाः सोऽसृजद् दानवेश्वरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006446024, "chapter_id": 26446, "verse_number": "२-१०६-२५", "content_sanskrit": "सिंहानापततो दृष्ट्वा रौक्मिणेयः प्रतापवान् ।\nअस्त्रं गान्धर्वमादाय शरभानसृजत् तदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006446025, "chapter_id": 26446, "verse_number": "२-१०६-२६", "content_sanskrit": "तेऽष्टापदा बलोदग्रा नखदंष्ट्रायुधा रणे ।\nसिंहान् विद्रावयामासुर्वायुर्जलधरानिव ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006446026, "chapter_id": 26446, "verse_number": "२-१०६-२७", "content_sanskrit": "सिंहान् विद्रवतो दृष्ट्वा माययाष्टापदेन वै ।\nशम्बरश्चिन्तयामास कथमेनं निहन्मि वै ।\nअहो मूर्खस्वभावोऽहं यन्मया न हतः शिशुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006446027, "chapter_id": 26446, "verse_number": "२-१०६-२८", "content_sanskrit": "प्राप्तयौवनदेहस्तु कृतास्त्रश्चापि दुर्मतिः ।\nतत् कथं निहनिष्यामि शत्रुं रणशिरःस्थितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006446028, "chapter_id": 26446, "verse_number": "२-१०६-२९", "content_sanskrit": "माया सा तिष्ठते तीव्रा पन्नगी नाम भीषणा ।\nदत्ता मे देवदेवेन हरेणासुरघातिना ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006446029, "chapter_id": 26446, "verse_number": "२-१०६-३०", "content_sanskrit": "तां सृजामि महामायामाशीविषसमाकुलाम् ।\nतया दह्येत दुष्टात्मा ह्येष मायामयो बली ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006446030, "chapter_id": 26446, "verse_number": "२-१०६-३१", "content_sanskrit": "सा सृष्टा पन्नगी माया विषज्वालासमाकुला ।\nतया पन्नगमय्या तु सरथं सहवाजिनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006446031, "chapter_id": 26446, "verse_number": "२-१०६-३२", "content_sanskrit": "ससूत स हि प्रद्युम्नं बबन्ध शरबन्धनैः ।\nबध्यमानं तदा दृष्ट्वा आत्मानं वृष्णिवंशजः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006446032, "chapter_id": 26446, "verse_number": "२-१०६-३३", "content_sanskrit": "मायां संचिन्तयामास सौपर्णीं सर्पनाशिनीम् ।\nसा चिन्तिता महामाया प्रद्युम्नेन महात्मना ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006446033, "chapter_id": 26446, "verse_number": "२-१०६-३४", "content_sanskrit": "सुपर्णा विचरन्ति स्म सर्पा नष्टा महाविषाः ।\nभग्नायां सर्पमायायां प्रशंसन्ति सुरासुराः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006446034, "chapter_id": 26446, "verse_number": "२-१०६-३५", "content_sanskrit": "साधु वीर महाबाहो रुक्मिण्यानन्दवर्धन ।\nयत्त्वया धर्षिता माया तेन स्म परितोषिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006446035, "chapter_id": 26446, "verse_number": "२-१०६-३६", "content_sanskrit": "हतायां सर्पमायायां शम्बरोऽचिन्तयत् पुनः ।\nअस्ति मे कालदण्डाभो मुद्गरो हेमभूषितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006446036, "chapter_id": 26446, "verse_number": "२-१०६-३७", "content_sanskrit": "तमप्रतिहतं युद्धे देवदानवमानवैः ।\nपुरा यो मम पार्वत्या दत्तः परमतुष्टया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006446037, "chapter_id": 26446, "verse_number": "२-१०६-३८", "content_sanskrit": "गृहाण शम्बरेमं त्वं मुद्गरं हेमभूषितम् ।\nमया सृष्टं स्वदेहे वै तपः परमदुश्चरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006446038, "chapter_id": 26446, "verse_number": "२-१०६-३९", "content_sanskrit": "मायान्तकरणं नाम सर्वासुरविनाशनम् ।\nअनेन दानवौ रौद्रौ बलिनौ कामरूपिणौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006446039, "chapter_id": 26446, "verse_number": "२-१०६-४०", "content_sanskrit": "शुम्भश्चैव निशुम्भश्च सगणौ सूदितौ मया ।\nप्राणसंशयमापन्ने त्वया मोक्ष्यः स शत्रवे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006446040, "chapter_id": 26446, "verse_number": "२-१०६-४१", "content_sanskrit": "इत्युक्त्वा पार्वती देवी तत्रैवान्तरधीयत ।\nतदहं मुद्गरं श्रेष्ठं मोचयिष्यामि शत्रवे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006446041, "chapter_id": 26446, "verse_number": "२-१०६-४२", "content_sanskrit": "तस्य विज्ञाय चित्तं तु देवराजोऽभ्यभाषत ।\nगच्छ नारद शीघ्रं त्वं प्रद्युम्नस्य रथं प्रति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006446042, "chapter_id": 26446, "verse_number": "२-१०६-४३", "content_sanskrit": "सम्बोधय महाबाहुं पूर्वजातिं च मोक्षय ।\nवैष्णवास्त्रं प्रयच्छास्मै वधार्थं शम्बरस्य च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006446043, "chapter_id": 26446, "verse_number": "२-१०६-४४", "content_sanskrit": "अभेद्यं कवचं चास्य प्रयच्छासुरसूदने ।\nएवमुक्तो मघवता नारदः प्रययौ त्वरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006446044, "chapter_id": 26446, "verse_number": "२-१०६-४५", "content_sanskrit": "आकाशेऽधिष्ठितोऽवोचन्मकरध्वजकेतनम् ।\nकुमार पश्य मां प्राप्तं देवगन्धर्वनारदम् ।\nप्रेषितं देवराजेन तव सम्बोधनाय वै ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006446045, "chapter_id": 26446, "verse_number": "२-१०६-४६", "content_sanskrit": "स्मर त्वं पूर्वकं भावं कामदेवोऽसि मानद ।\nहरकोपानलाद् दग्धस्तेनानङ्ग इहोच्यसे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006446046, "chapter_id": 26446, "verse_number": "२-१०६-४७", "content_sanskrit": "त्वं वृष्णिवंशजातोऽसि रुक्मिण्या गर्भसम्भवः ।\nजातोऽसि केशवेन त्वं प्रद्युम्न इति कीर्त्यसे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006446047, "chapter_id": 26446, "verse_number": "२-१०६-४८", "content_sanskrit": "आहृत्य शम्बरेण त्वमिहानीतोऽसि मानद ।\nसप्तरात्रे त्वसम्पूर्णे सूतिकागारमध्यतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006446048, "chapter_id": 26446, "verse_number": "२-१०६-४९", "content_sanskrit": "वधार्थं शम्बरस्य त्वं ह्रियमाणो ह्युपेक्षितः ।\nकेशवेन महाबाहो देवकार्यार्थसिद्धये ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006446049, "chapter_id": 26446, "verse_number": "२-१०६-५०", "content_sanskrit": "यैषा मायावती नाम भार्या वै शम्बरस्य तु ।\nरतिं तां विद्धि कल्याणीं तव भार्यां पुरातनीम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006446050, "chapter_id": 26446, "verse_number": "२-१०६-५१", "content_sanskrit": "तव संरक्षणार्थाय शम्बरस्य गृहेऽवसत् ।\nमायां शरीरजां तस्य मोहनार्थं दुरात्मनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006446051, "chapter_id": 26446, "verse_number": "२-१०६-५२", "content_sanskrit": "रतेः सम्पादनार्थाय प्रेषयत्यनिशं तदा ।\nएवं प्रद्युम्न बुद्ध्वा वै तत्र भार्या प्रतिष्ठिता ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006446052, "chapter_id": 26446, "verse_number": "२-१०६-५३", "content_sanskrit": "हत्वा तं शम्बरं वीर वैष्णवास्त्रेण संयुगे ।\nगृह्य मायावतीं भार्यां द्वारकां गन्तुमर्हसि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006446053, "chapter_id": 26446, "verse_number": "२-१०६-५४", "content_sanskrit": "गृहाण वैष्णवं चास्त्रं कवचं च महाप्रभम् ।\nशक्रेण तव संगृह्य प्रेषितं शत्रुसूदन ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006446054, "chapter_id": 26446, "verse_number": "२-१०६-५५", "content_sanskrit": "शृणु मे ह्यपरं वाक्यं क्रियतामविशङ्कया ।\nअस्य देवरिपोस्तात मुद्गरो नित्यमूर्जितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006446055, "chapter_id": 26446, "verse_number": "२-१०६-५६", "content_sanskrit": "पार्वत्यां परितुष्टायां दत्तः शत्रुनिबर्हणः ।\nअमोघश्चैव संग्रामे देवदानवमानवैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006446056, "chapter_id": 26446, "verse_number": "२-१०६-५७", "content_sanskrit": "तदस्त्रप्रविघातार्थं देवीं त्वं स्मर्तुमर्हसि ।\nस्तव्या चैव नमस्या च महादेवी रणोत्सुकैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006446057, "chapter_id": 26446, "verse_number": "२-१०६-५८", "content_sanskrit": "तत्र वै क्रियतां यत्नः संग्रामे रिपुणा सह ।\nइत्युक्त्वा नारदो वाक्यं प्रययौ यत्र वासवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]