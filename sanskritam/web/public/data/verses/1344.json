[{"id": 2016363, "chapter_id": 1344, "verse_number": "२-८५-१", "content_sanskrit": "वैशम्पायन उवाच॥\nउपोह्यमाने द्यूते तु राजानः सर्व एव ते।\nधृतराष्ट्रं पुरस्कृत्य विविशुस्तां सभां ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016364, "chapter_id": 1344, "verse_number": "२-८५-२", "content_sanskrit": "भीष्मो द्रोणः कृपश्चैव विदुरश्च महामतिः।\nनातिप्रीतेन मनसा तेऽन्ववर्तन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016365, "chapter_id": 1344, "verse_number": "२-८५-३", "content_sanskrit": "ते द्वन्द्वशः पृथच्कैव सिंहग्रीवा महौजसः।\nसिंहासनानि भूरिणी विचित्राणि च भेजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016366, "chapter_id": 1344, "verse_number": "२-८५-४", "content_sanskrit": "शुशुभे सा सभा राजन्राजभिस्तैः समागतैः।\nदेवैरिव महाभागैः समवेतैस्त्रिविष्टपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016367, "chapter_id": 1344, "verse_number": "२-८५-५", "content_sanskrit": "सर्वे वेदविदः शूराः सर्वे भास्वरमूर्तयः।\nप्रवर्तत महाराज सुहृद्द्यूतमनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016368, "chapter_id": 1344, "verse_number": "२-८५-६x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016369, "chapter_id": 1344, "verse_number": "२-८५-६", "content_sanskrit": "अयं बुहधनो राजन्सागरावर्तसम्भवः।\nमणिर्हारोत्तरः श्रीमान्कनकोत्तमभूषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016370, "chapter_id": 1344, "verse_number": "२-८५-७", "content_sanskrit": "एतद्राजन्मम धनं प्रतिपाणोऽस्ति कस्तव।\nयेन मां त्वं महाराज धनेन प्रतिदीव्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016371, "chapter_id": 1344, "verse_number": "२-८५-८x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016372, "chapter_id": 1344, "verse_number": "२-८५-८", "content_sanskrit": "सन्ति मे मणयश्चैव धनानि सुबहूनि च।\nमत्सरश्च न मेऽर्थेषु जयस्वैनं दुरोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016373, "chapter_id": 1344, "verse_number": "२-८५-९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016374, "chapter_id": 1344, "verse_number": "२-८५-९", "content_sanskrit": "ततो जग्राह शकुनिस्तानक्षानक्षतत्त्ववित्।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016375, "chapter_id": 1344, "verse_number": "२-८५-१०x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016376, "chapter_id": 1344, "verse_number": "२-८५-१०", "content_sanskrit": "मत्त कैतकेनैव यज्जितोऽस्मि दुरोदरे।\nशकुने हन्त दीव्यामो ग्लहमानाः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016377, "chapter_id": 1344, "verse_number": "२-८५-११", "content_sanskrit": "सन्ति निष्कसहस्रस्य भाण्डिन्यो भरिताः शुभाः।\nकोशो हिरण्यमक्षय्यं जातरूपमनेकशः।\nएतद्राजन्मम धनं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016378, "chapter_id": 1344, "verse_number": "२-८५-१२x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016379, "chapter_id": 1344, "verse_number": "२-८५-१२", "content_sanskrit": "कौरवाणां कुलकरं ज्येष्ठं पाण्डवमच्युतम्।\nइत्युक्तः शकुनिः प्राह जितमित्येव तं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016380, "chapter_id": 1344, "verse_number": "२-८५-१३x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016381, "chapter_id": 1344, "verse_number": "२-८५-१३", "content_sanskrit": "अयं सहस्रसमितो वैयाघ्रः सुप्रतिष्ठितः।\nसुचक्रोपस्करः श्रीमान्किङ्किणीजालमण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016382, "chapter_id": 1344, "verse_number": "२-८५-१४", "content_sanskrit": "संह्रादनो राजरथो य इहास्मानुपावहत्।\nजौत्रो रथवरः पुण्यो मेघसागरनिः स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016383, "chapter_id": 1344, "verse_number": "२-८५-१५", "content_sanskrit": "अष्टौ यं कुररच्छायाः सदश्वा राष्ट्रसंमताः।\nवहन्ति नैषां मुच्येत पदाद्भूमिमुपस्पृशन्।\nएतद्राजन्धनं मह्यं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016384, "chapter_id": 1344, "verse_number": "२-८५-१६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016385, "chapter_id": 1344, "verse_number": "२-८५-१६", "content_sanskrit": "एवं श्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016386, "chapter_id": 1344, "verse_number": "२-८५-१७x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016387, "chapter_id": 1344, "verse_number": "२-८५-१७", "content_sanskrit": "शतं दासीसहस्राणि तरुण्यो हेमभद्रिकाः।\nकम्बुकेयूरधारिण्यो निष्ककण्ठ्यः स्वलङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016388, "chapter_id": 1344, "verse_number": "२-८५-१८", "content_sanskrit": "महार्हमाल्याभरणाः सुवस्त्राश्चन्दनोक्षिताः।\nमणीन्हेम च बिभ्रत्यश्चतुःषष्टिविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016389, "chapter_id": 1344, "verse_number": "२-८५-१९", "content_sanskrit": "अनुसेवां चरन्तीमाः कुशला नृत्तसामसु।\nस्नातकानाममात्यानां राज्ञां च मम शासनात्।\nएतद्राजन्मम धनं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016390, "chapter_id": 1344, "verse_number": "२-८५-२०x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016391, "chapter_id": 1344, "verse_number": "२-८५-२०", "content_sanskrit": "एतच्छुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016392, "chapter_id": 1344, "verse_number": "२-८५-२१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016393, "chapter_id": 1344, "verse_number": "२-८५-२१", "content_sanskrit": "एतावन्ति च दासानां सहस्राण्युत सन्ति मे।\nप्रदक्षिणानुलोमाश्च प्रावारवसनाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016394, "chapter_id": 1344, "verse_number": "२-८५-२२", "content_sanskrit": "प्राज्ञा मेधाविनो दान्ता युवानो मृष्टकुण्डलाः।\nपात्रीहस्ता दिवारात्रमतिथीन्भोजयन्त्युत।\nएतद्राजन्मम धनं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016395, "chapter_id": 1344, "verse_number": "२-८५-२३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016396, "chapter_id": 1344, "verse_number": "२-८५-२३", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016397, "chapter_id": 1344, "verse_number": "२-८५-२४x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016398, "chapter_id": 1344, "verse_number": "२-८५-२४", "content_sanskrit": "सहस्रसङ्ख्या नगा मे मत्तास्तिष्ठन्ति सौबल।\nहेमकक्षाः कृतापीडाः पद्मिनो हेममालिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016399, "chapter_id": 1344, "verse_number": "२-८५-२५", "content_sanskrit": "सुदान्ता राजवहनाः सर्वशब्दक्षमा युधि।\nईषादन्ता महाकायाः सर्वे चाष्टकरेणवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016400, "chapter_id": 1344, "verse_number": "२-८५-२६", "content_sanskrit": "सर्वे च पुरभेत्तारो नवमेघनिभा गजाः।\nएतद्राजन्मम धनं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016401, "chapter_id": 1344, "verse_number": "२-८५-२७x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016402, "chapter_id": 1344, "verse_number": "२-८५-२७", "content_sanskrit": "इत्येवंवादिनं पार्थं प्रहसन्निव सौबलः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2016403, "chapter_id": 1344, "verse_number": "२-८५-२८x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2016404, "chapter_id": 1344, "verse_number": "२-८५-२८", "content_sanskrit": "रथास्तावन्त एवेमे हेमदण्डाः पताकिनः।\nहयैर्विनीतैः सम्पन्ना रथिभिश्चित्रयोधिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2016405, "chapter_id": 1344, "verse_number": "२-८५-२९", "content_sanskrit": "एकैको ह्यत्र लभते सहस्रपरमां भृतिम्।\nयुध्यतोऽयुध्यतो वापि वेतनं मासकालिकम्।\nएतद्राजन्म धनं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2016406, "chapter_id": 1344, "verse_number": "२-८५-३०x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2016407, "chapter_id": 1344, "verse_number": "२-८५-३०", "content_sanskrit": "इत्येवमुक्ते वचने कृतवैरो दुरात्मवान्।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2016408, "chapter_id": 1344, "verse_number": "२-८५-३१x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2016409, "chapter_id": 1344, "verse_number": "२-८५-३१", "content_sanskrit": "अश्वांस्तित्तिरिकल्माषान्गान्धर्वान्हेममालिनः।\nददौ चित्ररथस्तुष्टो यांस्तान्गाण्डीवधन्वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2016410, "chapter_id": 1344, "verse_number": "२-८५-३२", "content_sanskrit": "युद्धे जितः पराभूतः प्रीतिपूर्वमरिन्दमः।\nएतद्राजन्मम धनं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2016411, "chapter_id": 1344, "verse_number": "२-८५-३३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2016412, "chapter_id": 1344, "verse_number": "२-८५-३३", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2016413, "chapter_id": 1344, "verse_number": "२-८५-३४x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2016414, "chapter_id": 1344, "verse_number": "२-८५-३४", "content_sanskrit": "रथानां शकटानां च श्रेष्ठानां चायुतानि मे।\nयुक्तान्येव हि तिष्ठन्ति वाहैरुच्चावचैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2016415, "chapter_id": 1344, "verse_number": "२-८५-३५", "content_sanskrit": "एवं वर्णस्य वर्णस्य समुच्चीय सहस्रशः।\nयथा समुदिता वीराः सर्वे वीरपराक्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2016416, "chapter_id": 1344, "verse_number": "२-८५-३६", "content_sanskrit": "क्षीरं पिबन्तस्तिष्ठन्ति भुञ्जानाः शालितण्डुलान्।\nषष्टिस्तानि सहस्राणि सर्वे विपुलवक्षसः।\nएतद्राजन्मम धनं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2016417, "chapter_id": 1344, "verse_number": "२-८५-३७x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2016418, "chapter_id": 1344, "verse_number": "२-८५-३७", "content_sanskrit": "एतच्छ्रत्वा व्यवसितो निकृति समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2016419, "chapter_id": 1344, "verse_number": "२-८५-३८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2016420, "chapter_id": 1344, "verse_number": "२-८५-३८", "content_sanskrit": "ताम्रलोहैः परिवृता निधयो ये चतुः शताः।\nपञ्चद्रौणिक एकैकः सुवर्णस्याहतस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2016421, "chapter_id": 1344, "verse_number": "२-८५-३९", "content_sanskrit": "जातरूपस्य मुख्यस्य नार्घो यस्य हि भारत।\nएतद्राजन्मम धनं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2016422, "chapter_id": 1344, "verse_number": "२-८५-४०x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2016423, "chapter_id": 1344, "verse_number": "२-८५-४०", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभापतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2016424, "chapter_id": 1344, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि पञ्चाशीतितमोऽध्यायः॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]