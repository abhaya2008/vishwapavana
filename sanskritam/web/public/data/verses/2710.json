[{"id": 2080454, "chapter_id": 2710, "verse_number": "१२-२१५-०x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080455, "chapter_id": 2710, "verse_number": "१२-२१५-१", "content_sanskrit": "रजसा साध्यते मोहस्तमश्च भरतर्षभ।\nक्रोधलोभौ भयं दर्प एतेषां सादनाच्छुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080456, "chapter_id": 2710, "verse_number": "१२-२१५-२", "content_sanskrit": "परमं परमात्मानं देवमक्षयमव्ययम्।\nविष्णुमव्यक्तसंस्थानं विदुस्तं देवसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080457, "chapter_id": 2710, "verse_number": "१२-२१५-३", "content_sanskrit": "तस्य मायापिनद्धाङ्गा ज्ञान भ्रष्टा निराशिषः।\nमानवा ज्ञानसंमोहात्ततः कामं प्रयान्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080458, "chapter_id": 2710, "verse_number": "१२-२१५-४", "content_sanskrit": "कामात्क्रोधमवाप्याथ लोभमोहौ च मानवाः।\nमानदर्पावहंकारमहंकारात्ततः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080459, "chapter_id": 2710, "verse_number": "१२-२१५-५", "content_sanskrit": "क्रियाभिः स्नेहसंबन्धः स्नेहाच्छोकमनन्तरम्।\nअथ दुःखसमारम्भा जराजन्मकृतक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080460, "chapter_id": 2710, "verse_number": "१२-२१५-६", "content_sanskrit": "जन्मतो गर्भवासं तु शुक्रशोणितसंभवम्।\nपुरीषमूत्रविक्लेदं शोणितप्रभवाविलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080461, "chapter_id": 2710, "verse_number": "१२-२१५-७", "content_sanskrit": "तृष्णाभिभूतस्तैर्वद्धस्तानेवाभिपरिप्लवन्।\n` तथा नरकगर्तस्थस्तृष्णारज्जुभिराचितः।\nपुण्यपापप्रणुन्नाङ्गो जायते स यथा कृमिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080462, "chapter_id": 2710, "verse_number": "१२-२१५-८", "content_sanskrit": "मशकैर्मत्कुणैर्दष्टस्तथा चित्रवधार्दितः।\nनानाव्याधिभिराकीर्णः कथंचिद्यौवनं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080463, "chapter_id": 2710, "verse_number": "१२-२१५-९", "content_sanskrit": "कूर्मोत्सृजति भूयश्च रज्जुः स्वस्वमुखेप्सया।\nयोषितं नरकं गृह्य जन्मकर्मवशानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080464, "chapter_id": 2710, "verse_number": "१२-२१५-१०", "content_sanskrit": "पुरक्षेत्रनिमित्तं यद्दुःखं वक्तुं न शक्यते।\nकस्तत्र निन्दकश्चैव नरके पच्यते भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080465, "chapter_id": 2710, "verse_number": "१२-२१५-११", "content_sanskrit": "वार्धक्यमनुलङ्घेत तत्र कर्मारभेत्पुनः।\nभगवान्संस्तुतः पश्चात्किं प्रवक्ष्यामि ते भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080466, "chapter_id": 2710, "verse_number": "१२-२१५-१२", "content_sanskrit": "संसारतन्त्रवाहिन्यस्तत्र बुद्ध्येत योषितः।\nप्रकृत्याः क्षेत्रभूतास्ता नराः क्षेत्रज्ञलक्षणाः।\nतस्मादेवाविशेषेण नरोऽतीयाद्विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080467, "chapter_id": 2710, "verse_number": "१२-२१५-१३", "content_sanskrit": "कृत्या ह्येता घोररूपा मोहयन्त्यविचक्षणान्।\nरजस्यन्तर्हिता मूर्तिरिन्द्रियाणां सनातनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080468, "chapter_id": 2710, "verse_number": "१२-२१५-१४", "content_sanskrit": "तस्मात्तर्षात्मकाद्रागाद्बीजाज्जायन्ति जन्तवः।\nस्वदेहजानस्वसंज्ञान्यद्वदङ्गात्कृमींस्त्यजेत्।\nस्वसंज्ञानस्वकांस्तद्वत्सुतसंज्ञान्कृमींस्त्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080469, "chapter_id": 2710, "verse_number": "१२-२१५-१५", "content_sanskrit": "शुक्रतो रसतश्चैव देहाज्जायन्ति जन्तवः।\nस्वभावात्कर्मयोगाद्वा तानुपेक्षेत बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080470, "chapter_id": 2710, "verse_number": "१२-२१५-१६", "content_sanskrit": "रजस्तमसि पर्यस्तं सत्वं च रजसि स्थितम्।\nज्ञानाधिष्ठानमज्ञानं बुद्ध्यंहंकारलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080471, "chapter_id": 2710, "verse_number": "१२-२१५-१७", "content_sanskrit": "तद्बीजं देहिनामाद्दुस्तद्बीजं जीवसंज्ञितम्।\nकर्मणा कालयुक्तेन संसारपरिवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080472, "chapter_id": 2710, "verse_number": "१२-२१५-१८", "content_sanskrit": "रमत्ययं यथा स्वप्ने मनसा देहवानिव।\nकर्मगर्भैर्गुणैर्देही गर्भे तदुपलभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080473, "chapter_id": 2710, "verse_number": "१२-२१५-१९", "content_sanskrit": "कर्मणा बीजभूतेन चोद्यते यद्यदिन्द्रियम्।\nजायते तदहंकाराद्रागयुक्तेन चेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080474, "chapter_id": 2710, "verse_number": "१२-२१५-२०", "content_sanskrit": "शब्दरागाच्छ्रोत्रमस्य जायते भावितात्मनः।\nरूपरागात्तथा चक्षुर्घ्राणं गन्धजिघृक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080475, "chapter_id": 2710, "verse_number": "१२-२१५-२१", "content_sanskrit": "संस्पर्शेभ्यस्तथा वायुः प्राणापानव्यपाश्रयः।\nव्यानोदानौ समानश्च पञ्चधा देहयापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080476, "chapter_id": 2710, "verse_number": "१२-२१५-२२", "content_sanskrit": "संजातैर्जायते गात्रैः कर्मजैर्ब्रह्मणा वृतः।\nदुःखाद्यन्तैर्दुःखमध्यैर्नरः शारीरमानसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080477, "chapter_id": 2710, "verse_number": "१२-२१५-२३", "content_sanskrit": "दुःखं विद्यादुपादानादभिमानाच्च वर्धते।\nत्यागात्तेभ्यो निरोधः स्यान्निरोधज्ञो विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080478, "chapter_id": 2710, "verse_number": "१२-२१५-२४", "content_sanskrit": "इन्द्रियाणां रजस्येव प्रलयप्रभवावुभौ।\nपरीक्ष्य संचरेद्विद्वान्यथावच्छास्त्रचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080479, "chapter_id": 2710, "verse_number": "१२-२१५-२५", "content_sanskrit": "ज्ञानेन्द्रियाणीन्द्रियार्थान्नोपसर्पन्त्यतर्षुलम्।\nज्ञानैश्च करणैर्देही न देहं पुननर्हति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080480, "chapter_id": 2710, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चदशाधिकद्विशततमोऽध्यायः॥ २१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]