[{"id": 7004250000, "chapter_id": 24250, "verse_number": "५-२-२८-१", "content_sanskrit": "श्रीदेवदेव उवाच ।\nअष्टाविंशतिकं विद्धि विख्यातं च जटेश्वरम् ।\nयस्य दर्शनमात्रेण मुक्तो भवति मानवः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004250001, "chapter_id": 24250, "verse_number": "५-२-२८-२", "content_sanskrit": "पुरा राथंतरे कल्पे वीरधन्वा महीपतिः ।\nधर्मात्मा च यशस्वी च बभूव भुवि विश्रुतः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004250002, "chapter_id": 24250, "verse_number": "५-२-२८-३", "content_sanskrit": "स कदाचिद्वनं गत्वा मृगहेतोर्वरानने ।\nव्यापादयन्मृगगणान्धनुषा क्रोधविह्वलः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004250003, "chapter_id": 24250, "verse_number": "५-२-२८-४", "content_sanskrit": "जगाम तत्र यत्रासन्भ्रातरः पंच सुव्रताः ।\nसंवर्तस्य सुता देवि मृगरूपेण संस्थिताः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004250004, "chapter_id": 24250, "verse_number": "५-२-२८-५", "content_sanskrit": "ते कदाचिद्वने पंच दृष्ट्वा हरिणपोतकान् ।\nश्वसतो जातमात्रांश्च कौतूहलसमन्विताः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004250005, "chapter_id": 24250, "verse_number": "५-२-२८-६", "content_sanskrit": "एकैकं जगृहुस्तत्र मृतास्ते त्वतिदुःखिताः ।\nततः सर्वे च ते पंच ययुर्वै पितुरंतिकम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004250006, "chapter_id": 24250, "verse_number": "५-२-२८-७", "content_sanskrit": "प्रायश्चित्तं समीहंतः संवर्त्तं सांसदैर्वृतम् ।\nऊचुस्ते वचनं चेदं मृगहिंसाश्रितं तदा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004250007, "chapter_id": 24250, "verse_number": "५-२-२८-८", "content_sanskrit": "जातमात्रा मृगाः पंच अस्माभिर्निहताः प्रभो ।\nअकामतस्ततोऽस्माकं प्रायश्चित्तं विधीयताम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004250008, "chapter_id": 24250, "verse_number": "५-२-२८-९", "content_sanskrit": "ऊचे स शुद्धिमाप्नोति प्रायश्चित्ते कृते सति ।\nअनधीत्य धर्मशास्त्रं प्रायश्चित्तं ददाति यः ।\nप्रायश्चित्ती भवेत्पूतः किल्विषं दातरि व्रजेत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004250009, "chapter_id": 24250, "verse_number": "५-२-२८-१०", "content_sanskrit": "धर्म शास्त्रसमारूढा वेदखड्गधरा द्विजाः ।\nक्रीडार्थमपि यद्ब्रूयुः स धर्मः परमः स्मृतः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004250010, "chapter_id": 24250, "verse_number": "५-२-२८-११", "content_sanskrit": "ब्रह्मच्छिद्रं जपच्छिद्रं यच्छिद्रं यज्ञकर्मणि ।\nअच्छिद्रं जायते सर्वं ब्राह्मणैरुपपादितम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004250011, "chapter_id": 24250, "verse_number": "५-२-२८-१२", "content_sanskrit": "अच्छिद्रमिति यद्वाक्यं वदंति क्षितिदेवताः ।\nप्रणश्यत्यखिलं पापमग्निष्टोमफलं भवेत्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004250012, "chapter_id": 24250, "verse_number": "५-२-२८-१३", "content_sanskrit": "इत्येवं वदति श्रेष्ठे संवर्ते द्विजसत्तमे ।\nसमागताश्च मुनयो भृग्वत्र्यंगिरसादयः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004250013, "chapter_id": 24250, "verse_number": "५-२-२८-१४", "content_sanskrit": "तेषामर्थे यथावृत्तं कथयामासुरेव ते ।\nसंवर्तस्य सुता दीना भक्तिनम्राः पुनःपुनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004250014, "chapter_id": 24250, "verse_number": "५-२-२८-१५", "content_sanskrit": "तेऽप्यूचुर्धर्मशास्त्राणि विहितानि यथार्थतः ।\nप्रायश्चित्तं यथोद्दिष्टं देशकालविभागतः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004250015, "chapter_id": 24250, "verse_number": "५-२-२८-१६", "content_sanskrit": "अशीतिर्यस्य वर्षाणि बालो वाप्यूनषोडशः ।\nप्रायश्चित्तार्द्धमर्हंति स्त्रियो वै व्याधितस्य च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004250016, "chapter_id": 24250, "verse_number": "५-२-२८-१७", "content_sanskrit": "देशं कालं वयः शक्तिं पापं चावेक्ष्य यत्नतः ।\nप्रायश्चित्तं प्रकल्प्यं स्यादिति धर्मो व्यवस्थितः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004250017, "chapter_id": 24250, "verse_number": "५-२-२८-१८", "content_sanskrit": "इदानीं मृगचर्माणि परिधाय धृतव्रताः ।\nचरध्वं पंच वर्षाणि ततः शुद्धा भविष्यथ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004250018, "chapter_id": 24250, "verse_number": "५-२-२८-१९", "content_sanskrit": "एवमुक्तास्तु ते बाला मृगधर्मोपजीविनः ।\nवनं विविशुरव्यग्रा ध्यायंतो ब्रह्म शाश्वतम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004250019, "chapter_id": 24250, "verse_number": "५-२-२८-२०", "content_sanskrit": "ततो वर्षे ह्यतिक्रांते वीरधन्वा महीपतिः ।\nतत्राजगाम यस्मिंस्ते चरंति मृगरूपिणः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004250020, "chapter_id": 24250, "verse_number": "५-२-२८-२१", "content_sanskrit": "ते चाप्येकतरोर्मूले मृगधर्मोपजीविनः ।\nजपंतः संस्थितास्ते हि राज्ञा दृष्टा मृगा इति॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004250021, "chapter_id": 24250, "verse_number": "५-२-२८-२२", "content_sanskrit": "मत्वा विद्धास्तु नाःराचैर्मृतास्ते ब्रह्मवादिनः ।\nतान्दृष्ट्वा च मृतान्राजा ब्राह्मणान्संशितव्रतान् ।\nभयेन वेपमानस्तु देवराताश्रमं ययौ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004250022, "chapter_id": 24250, "verse_number": "५-२-२८-२३", "content_sanskrit": "तत्रापृच्छद्ब्रह्मवध्या मम जाता महामुने ।\nआमूलांतं वधांतस्य कथयित्वा नराधिपः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004250023, "chapter_id": 24250, "verse_number": "५-२-२८-२४", "content_sanskrit": "भृशं शोकपरीतात्मा रुरोद भृशदुःखितः ।\nस ऋषिर्देवकल्पस्तु रुदंतं नृपसत्तमम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004250024, "chapter_id": 24250, "verse_number": "५-२-२८-२५", "content_sanskrit": "उवाच मा भैर्नृपते अपनेष्यामि पातकम् ।\nपाताले सुतलाख्ये तु निमज्जंती यथा धरा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004250025, "chapter_id": 24250, "verse_number": "५-२-२८-२६", "content_sanskrit": "उद्धृता देवदेवेन विष्णुना क्रोडमूर्त्तिना ।\nतद्वद्भवंतं राजेंद्र ब्रह्महत्यापरिप्लुतम् ।\nउद्धरिष्यति देवोऽसौ स्वयमेव जनार्दनः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004250026, "chapter_id": 24250, "verse_number": "५-२-२८-२७", "content_sanskrit": "एवमुक्तस्ततो राजा दुरितो वाक्यमब्रवीत॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004250027, "chapter_id": 24250, "verse_number": "५-२-२८-२८", "content_sanskrit": "किमनेन द्विजेनैव निष्प्रभेण दुरात्मना ।\nउद्धर्तुं नैव शक्नोति स्वयमेव द्विजाधमः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004250028, "chapter_id": 24250, "verse_number": "५-२-२८-२९", "content_sanskrit": "इत्युक्त्वा खङ्गेनैव जघान तम् ।\nमृतं दृष्ट्वा द्विजं राजा क्रोधेन कलुषीकृतः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004250029, "chapter_id": 24250, "verse_number": "५-२-२८-३०", "content_sanskrit": "तस्मिन्नेव वने देवि पापसंघेन मोहितः ।\nजघान कपिलां दोग्ध्रीं सवत्सां गालवस्य च॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004250030, "chapter_id": 24250, "verse_number": "५-२-२८-३१", "content_sanskrit": "क्षुधार्त्तश्च तृषार्त्तश्च बाल्यान्मोहाच्च साहसात् ।\nक्रूरा बुद्धिः समभवज्जटीभूतं च पातकम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004250031, "chapter_id": 24250, "verse_number": "५-२-२८-३२", "content_sanskrit": "जटीभूतेन पापेन बभ्राम गहने वने ।\nस कदाचित्तुरंगेण हृतो दूरं महद्वनम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004250032, "chapter_id": 24250, "verse_number": "५-२-२८-३३", "content_sanskrit": "व्याघ्रसिंहगजाकीर्णं मृगशंबरसेवितम् ।\nएकाकी तत्र राजासावश्वं मुक्त्वा तरोरधः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004250033, "chapter_id": 24250, "verse_number": "५-२-२८-३४", "content_sanskrit": "कुशोपरि तदा तत्र सुष्वाप च स निर्भयम् ।\nतत्र व्याधाः समचरन्दृष्ट्वा सुप्तं च निर्भयम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004250034, "chapter_id": 24250, "verse_number": "५-२-२८-३५", "content_sanskrit": "ते गतास्त्वरिता व्याधाः स्वभर्तुः कथनाय वै ।\nस्वामिना तेन निर्दिष्टा निग्रहीतुं प्रचक्रमुः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004250035, "chapter_id": 24250, "verse_number": "५-२-२८-३६", "content_sanskrit": "तावद्राज्ञः शरीरात्तु श्वेताऽभरणभूषिता ।\nउत्थाय चक्रमादाय तया म्लेच्छाश्च पातिताः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004250036, "chapter_id": 24250, "verse_number": "५-२-२८-३७", "content_sanskrit": "दस्यून्निहत्य सा देवी तत्रैवादर्शनं गता॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004250037, "chapter_id": 24250, "verse_number": "५-२-२८-३८", "content_sanskrit": "अथ राजा तया मुक्तः प्रतिबुद्धोऽथ तत्क्षणात् ।\nम्लेच्छांश्च निहतान्दृष्ट्वा चिंतयामास पार्थिवः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004250038, "chapter_id": 24250, "verse_number": "५-२-२८-३९", "content_sanskrit": "गोवध्या ब्रह्मवध्या च वने ह्यस्मिन्सुदारुणा ।\nकथं मया नृशंसेन प्राप्ता पापपरंपरा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004250039, "chapter_id": 24250, "verse_number": "५-२-२८-४०", "content_sanskrit": "एवं स चिंतयित्वाथ निःश्वस्य च पुनःपुनः ।\nतमेवाश्वं समारुह्य वामदेवाश्रमं ययौ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004250040, "chapter_id": 24250, "verse_number": "५-२-२८-४१", "content_sanskrit": "मुनिना वामदेवेन दृष्टो राजा तथाविधः ।\nजटीभूतेन पापेन पीडितो दुःखितस्तदा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004250041, "chapter_id": 24250, "verse_number": "५-२-२८-४२", "content_sanskrit": "वामदेव उवाच ।\nअयं स पुरुषव्याघ्रो वीरधन्वा महीपतिः ।\nसोमवंशसमुत्पन्नो दशां कष्टां समागतः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004250042, "chapter_id": 24250, "verse_number": "५-२-२८-४३", "content_sanskrit": "उद्धरिष्यामि राजानमेनं पुरुषसत्तमम् ।\nइत्यालोच्य तदा विप्रो वामदेवो महातपाः ।\nप्रत्युवाच महीपालं वीरधन्वानमातुरम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004250043, "chapter_id": 24250, "verse_number": "५-२-२८-४४", "content_sanskrit": "भोभो राजन्महीपाल वीरधन्वेति विश्रुतः ।\nविदूरथस्य तनयो विख्यातो भुवनत्रये॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004250044, "chapter_id": 24250, "verse_number": "५-२-२८-४५", "content_sanskrit": "प्राग्भवे व्याधरूपेण निहिथा विपिने मृगान् ।\nदृढं जागरणं रात्रावामलक्यास्तरोरधः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004250045, "chapter_id": 24250, "verse_number": "५-२-२८-४६", "content_sanskrit": "फाल्गुनामलपक्षे त्वामलक्येकादशी शुभा ।\nपुष्यर्क्षयोगिनी तस्यां जामदग्न्यप्रदक्षिणा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004250046, "chapter_id": 24250, "verse_number": "५-२-२८-४७", "content_sanskrit": "पूजा लोकैः कृता दृष्टा विस्मयेन त्वया पुरा ।\nअकामादुपवासोऽभूत्तस्यां जागरणं पुनः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004250047, "chapter_id": 24250, "verse_number": "५-२-२८-४८", "content_sanskrit": "तत्प्रभावादभू राजा महाबलपराक्रमः ।\nतया संरक्षितो राजन्म्लेच्छवर्गाद्वनेऽधुना॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004250048, "chapter_id": 24250, "verse_number": "५-२-२८-४९", "content_sanskrit": "निहताः शत्रवः सर्वे तयैव शुभमाप्स्यसि ।\nपूर्वकर्मविपाकेन ब्रह्महत्या समागता॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004250049, "chapter_id": 24250, "verse_number": "५-२-२८-५०", "content_sanskrit": "ज्ञाता तपःप्रभावेन मया योगबलेन च ।\nजटीभूतं शरीरं ते पापसंघेन पार्थिव॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004250050, "chapter_id": 24250, "verse_number": "५-२-२८-५१", "content_sanskrit": "इदानीं पालयिष्यामि शृणु मे वचनं परम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004250051, "chapter_id": 24250, "verse_number": "५-२-२८-५२", "content_sanskrit": "इत्युक्तो वामदेवेन् मुनिना स महीपतिः ।\nप्रणम्य प्रयतो भूत्वा पप्रच्छ च पुनःपुनः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004250052, "chapter_id": 24250, "verse_number": "५-२-२८-५३", "content_sanskrit": "कथं यास्यंति मे हत्या गोब्राह्मणसमुद्भवाः ।\nउपदेशप्रदानेन प्रसादं कर्तुमर्हसि॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004250053, "chapter_id": 24250, "verse_number": "५-२-२८-५४", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा वाम देवो महामुनिः ।\nकथयामास माहात्म्यं लिंगस्यास्य यशस्विनि॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004250054, "chapter_id": 24250, "verse_number": "५-२-२८-५५", "content_sanskrit": "महाकालवनं गच्छ महाराज ममाज्ञया ।\nतत्रास्ते देवदेवोऽपि जगद्व्यापी जटेश्वरः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004250055, "chapter_id": 24250, "verse_number": "५-२-२८-५६", "content_sanskrit": "पापसंघप्रहर्त्ता च सर्ववेदेषु पठ्यते ।\nदेवस्यानरकेशस्य उत्तरे स व्यवस्थितः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004250056, "chapter_id": 24250, "verse_number": "५-२-२८-५७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा वामदेवस्य पार्थिवः ।\nआजगाम त्वरायुक्तो महाकालवनोत्तमे॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004250057, "chapter_id": 24250, "verse_number": "५-२-२८-५८", "content_sanskrit": "तत्र दृष्ट्वा जगद्वंद्यं देवदेवं जटेश्वरम् ।\nस्तुतिं चकार राजेंद्रो भक्त्या परमया पुनः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004250058, "chapter_id": 24250, "verse_number": "५-२-२८-५९", "content_sanskrit": "शिवाय ते नमो नित्यं विश्वकाय नमोनमः ।\nनमो दिव्याय गुह्याय गूढव्रतशरीरिणे॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004250059, "chapter_id": 24250, "verse_number": "५-२-२८-६०", "content_sanskrit": "नमो जटाय रामाय माययाक्रांतकारिणे ।\nनमोस्तु बहुरूपाय नमो नीलाभरूपिणे॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004250060, "chapter_id": 24250, "verse_number": "५-२-२८-६१", "content_sanskrit": "नमो भोगाय धूम्राय नमोऽस्तु गगनात्मने ।\nनमो वह्निसमूहाय नमस्ते निर्मलाकर॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004250061, "chapter_id": 24250, "verse_number": "५-२-२८-६२", "content_sanskrit": "नमो महांधकारार्क नमस्ते शत्रुघातिने ।\nनमः संसारपाराय दिव्यरूपशरीरिणे ।\nनमः कनकवर्णाय नमो मोहितमोहिने॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004250062, "chapter_id": 24250, "verse_number": "५-२-२८-६३", "content_sanskrit": "नमः सुरूपाय सुरार्चिताय नमो विरूपाय प्रकृतेः पराय ।\nनमोनमो रूपनिराश्रयाय श्यामासुरूपाय नमोनमस्ते॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004250063, "chapter_id": 24250, "verse_number": "५-२-२८-६४", "content_sanskrit": "इति स्तुतस्तदा देवि महादेवो महेश्वरः ।\nजटावेष्टितसर्वांगो लिंगमध्याच्च निस्सृतः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004250064, "chapter_id": 24250, "verse_number": "५-२-२८-६५", "content_sanskrit": "भस्मचर्चितसर्वांगो भोगिभोगांगदोज्वलः ।\nहिमराशिनिभाकारो राजताचलनिर्मलः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004250065, "chapter_id": 24250, "verse_number": "५-२-२८-६६", "content_sanskrit": "मुक्तालतानिभाभिस्तु जटाभिर्भूषितो विभुः ।\nकपिलाभिः करालाभिर्विकटाभिश्च वेष्टितः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004250066, "chapter_id": 24250, "verse_number": "५-२-२८-६७", "content_sanskrit": "भोगींद्रफणबद्धाभिः सितपीतादिभिस्तथा ।\nनदीरूपाभिरूताभिः शोभितोऽसौ जटेश्वरः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004250067, "chapter_id": 24250, "verse_number": "५-२-२८-६८", "content_sanskrit": "राजानं प्रत्युवाचेदं वचनं पर्वतात्मजे ।\nस्तोत्रेणानेन राजेंद्र तुष्टोऽहं तोषितस्त्वया॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004250068, "chapter_id": 24250, "verse_number": "५-२-२८-६९", "content_sanskrit": "जटीभूतं च ते पापं गतं मद्दर्शनेन वै ।\nतस्मात्स्थानं परं गच्छ मदीयं शाश्वतं मुदा॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004250069, "chapter_id": 24250, "verse_number": "५-२-२८-७०", "content_sanskrit": "इत्युक्तो देवदेवेन वीरधन्वा महीपतिः ।\nजगाम परमं स्थानं दाहप्रलयवर्जितम्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004250070, "chapter_id": 24250, "verse_number": "५-२-२८-७१", "content_sanskrit": "कामगेन विमानेन स्तूयमानो गणैः प्रिये ।\nपापसंघेन मुक्तोऽसौ जटीभूतेशदर्शनात्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004250071, "chapter_id": 24250, "verse_number": "५-२-२८-७२", "content_sanskrit": "लिंगश्चातः समाख्यातो नाम्ना देवो जटेश्वरः ।\nजटेश्वरं वरारोहे ये पश्यंति सुभक्तितः ।\nतेषां पापं जटीभूतं तत्क्षणादेव नश्यति॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004250072, "chapter_id": 24250, "verse_number": "५-२-२८-७३", "content_sanskrit": "येऽर्चयंति सदा देवि देवदेवं जटेश्वरम् ।\nतेषां बलं प्रभावश्च सौभाग्यं च भविष्यति॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004250073, "chapter_id": 24250, "verse_number": "५-२-२८-७४", "content_sanskrit": "येप्यन्ये देवगन्धर्वा यक्षराक्षस मानवाः ।\nलिंगं च पूजयिष्यंतिं विधिवद्भक्तिभावतः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004250074, "chapter_id": 24250, "verse_number": "५-२-२८-७५", "content_sanskrit": "तेऽपि कामानवाप्स्यन्ति यांश्च कांश्च सुदुर्लभान् ।\nऐश्वर्यं धर्ममतुलं दीर्घमायुररो गताम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004250075, "chapter_id": 24250, "verse_number": "५-२-२८-७६", "content_sanskrit": "निःसपत्नत्वमतुलं यच्चान्यत्तदवाप्नुयात् ।\nपापिनः क्रूरकर्माणो येऽपि लिंगं समाश्रिताः ।\nतेपि पापविनिर्मुक्ता भविष्यंति गत ज्वराः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004250076, "chapter_id": 24250, "verse_number": "५-२-२८-७७", "content_sanskrit": "जटेश्वरं प्रपश्यंति भक्त्या ये च दिनेदिने ।\nते धर्मधनसौभाग्यैर्भविष्यंति समन्विताः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004250077, "chapter_id": 24250, "verse_number": "५-२-२८-७८", "content_sanskrit": "व्याधितो व्याधिना मुक्तो दुःखी दुःखात्प्रमुच्यते ।\nदर्शनात्तु भवेत्सद्यः सर्वपातकवर्जितः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004250078, "chapter_id": 24250, "verse_number": "५-२-२८-७९", "content_sanskrit": "जटेश्वरस्य माहात्म्यं ये पठिष्यंति पार्वति ।\nश्रोष्यंति येऽपि मद्भक्त्या प्रयताः श्रद्धयान्विताः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004250079, "chapter_id": 24250, "verse_number": "५-२-२८-८०", "content_sanskrit": "ते सर्वकामानाप्स्यंति गतिमंते च मत्पुरे ।\nया नारी दुर्भगा सापि सौभाग्यं लभते सदा॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004250080, "chapter_id": 24250, "verse_number": "५-२-२८-८१", "content_sanskrit": "गुर्विणी लभते पुत्रमरोगं श्रुतिभूषणम् ।\nशिशुग्रहाश्च नश्यंति नापमृत्युभयं भवेत्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004250081, "chapter_id": 24250, "verse_number": "५-२-२८-८२", "content_sanskrit": "मांगल्यमिदमायुष्यं धर्मकामाश्रयं महत् ।\nदुःस्वप्नजं भयं घोरं पापजं याति संक्षयम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004250082, "chapter_id": 24250, "verse_number": "५-२-२८-८३", "content_sanskrit": "दुर्भुक्तं दुर्जनस्पर्शं यच्चाल्पायुःकरं भवेत् ।\nलिंगाख्यानकथां श्रुत्वा विनश्यति न संशयः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004250083, "chapter_id": 24250, "verse_number": "५-२-२८-८४", "content_sanskrit": "श्राद्धेषु यः पठेदेतां जटेश्वरकथां शुभाम् ।\nतदक्षयं भवेच्छ्राद्धं पितॄणां प्रीतिवर्द्धनम्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004250084, "chapter_id": 24250, "verse_number": "५-२-२८-८५", "content_sanskrit": "एष ते कथितो देवि प्रभावः पापनाशनः ।\nजटेश्वरस्य देवस्य शृणु रामेश्वरं शिवम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]