[{"id": 900008473, "chapter_id": 8639, "verse_number": "20.1", "content_sanskrit": "माभूदन्यैकगतता ब्रह्मैकगतताऽपि वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008474, "chapter_id": 8639, "verse_number": "20.2", "content_sanskrit": "अर्भकौकस्त्वादिरूपं सर्वगतत्वादिकं तु ब्रह्मणि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008475, "chapter_id": 8639, "verse_number": "20.3", "content_sanskrit": "पूर्वपादान्त्योत्तरपादाद्ययोश्चाधिकरणयोर्नावान्तरसङ्गत्यपेक्षेत्युक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008476, "chapter_id": 8639, "verse_number": "20.4", "content_sanskrit": "पूर्वपक्षस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008477, "chapter_id": 8639, "verse_number": "20.5", "content_sanskrit": "उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008478, "chapter_id": 8639, "verse_number": "20.6", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008479, "chapter_id": 8639, "verse_number": "20.7", "content_sanskrit": "आत्मशब्दादित्युक्तौ तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008480, "chapter_id": 8639, "verse_number": "20.8", "content_sanskrit": "तृतीये तु परपक्षे साधकाभावोक्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008481, "chapter_id": 8639, "verse_number": "20.9", "content_sanskrit": "तत्र चशब्दो न केवलं टीकोक्तरीत्या.."