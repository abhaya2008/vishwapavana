[{"id": 2110486, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110487, "chapter_id": 3390, "verse_number": "१", "content_sanskrit": "ततः काव्यो भृगुश्रेष्ठः समन्युरुपगम्य च ।\nप्रविश्यान्तःपुरं शुक्रो वन्दितो वृषपर्वणा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110488, "chapter_id": 3390, "verse_number": "२", "content_sanskrit": "वृषपर्वाणमासीनमित्युवाचाविचारयन् ।\nनाधर्मश्चरितो राजन् सद्यः फलति गौरिव \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110489, "chapter_id": 3390, "verse_number": "३", "content_sanskrit": "पुत्रेषु या नप्तृषु वा न चेदात्मनि पश्यति ।\nफलत्येव ध्रुवं पापं गुरुभुक्तमिवोदरे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110490, "chapter_id": 3390, "verse_number": "४", "content_sanskrit": "अधीयानं हितं राजन् क्षान्तं दान्तं जितेन्द्रियम् ।\nयदघातयथा कचं विप्रमाङ्गिरसं तथा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110491, "chapter_id": 3390, "verse_number": "५", "content_sanskrit": "अपापशीलं धर्मज्ञं शुश्रूषुं मद्गृहागतम् ।\nशर्मिष्ठया देवयानी क्रूरमुक्ता बहु प्रभो \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110492, "chapter_id": 3390, "verse_number": "६", "content_sanskrit": "विप्रकृत्य च संरम्भात् कूपे क्षिप्ता मनस्विनी ।\nसा न कल्येत वासाय तया वा रहितः कथम् \t॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110493, "chapter_id": 3390, "verse_number": "७", "content_sanskrit": "वसेयमिह तस्माच्च त्यजेयं विषयं तव ।\nवृषपर्वन् निबोधेदं त्यक्ष्यामि त्वां सबान्धवम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110494, "chapter_id": 3390, "verse_number": "८", "content_sanskrit": "मा शोच वृषपर्वंस्त्वं मा क्रुधस्त्वं विशाम्पते ।\nस्थातुं ते विषये राजन् न शक्ष्यामि विना तया ।\nअस्या गतिर्गतिर्मह्यं प्रियमस्याः प्रियं मम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110495, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वृषपर्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110496, "chapter_id": 3390, "verse_number": "९", "content_sanskrit": "यदि ब्रह्मन् घातयामि यदि चोपदिशाम्यहम् ।\nशर्मिष्ठया देवयानीं ततो गच्छाम्यसद्गतिम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110497, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110498, "chapter_id": 3390, "verse_number": "१०", "content_sanskrit": "अहो मामभिजानासि दैत्य मिथ्याप्रलापिनम् ।\nतथेममात्मनो दोषं मयि कर्तुं चिकीर्षसि \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110499, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वृषपर्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110500, "chapter_id": 3390, "verse_number": "११", "content_sanskrit": "नाधर्मं न मृषोक्तं वा त्वयि जानामि भार्गव ।\nत्वयि सत्यं च धर्मं च विजानामि प्रसीद मे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110501, "chapter_id": 3390, "verse_number": "१२", "content_sanskrit": "यद्यस्मानपहाय त्वमितो गच्छसि भार्गव ।\nसमुद्रं सम्प्रवेक्ष्यामि नान्यदस्ति परायणम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110502, "chapter_id": 3390, "verse_number": "१३", "content_sanskrit": "यद्येव देवान् गच्छेस्त्वं मां च त्यक्त्वा ग्रहाधिप ।\nसर्वत्यागं ततः कृत्वा प्रविशामि हुताशनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110503, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110504, "chapter_id": 3390, "verse_number": "१४", "content_sanskrit": "समुद्रं प्रविश त्वं वा अग्निं प्रज्वलितं तथा ।\nदुहितुर्नाप्रियं सोढुं शक्तोऽहं दयिता हि मे \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110505, "chapter_id": 3390, "verse_number": "१५", "content_sanskrit": "प्रसाद्यतां देवयानी जीवितं ह्यत्र मे स्थितम् ।\nप्रसन्ना देवयानी चेत् प्रियं नान्यतरं मम ।\nयोगक्षेमरतस्तेऽहमिन्द्रस्येव बृहस्पतिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110506, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वृषपर्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110507, "chapter_id": 3390, "verse_number": "१६", "content_sanskrit": "यत्किंचिदसुरेन्द्राणां वसु विद्येत भार्गव ।\nमम हस्तिगवाश्वं वा तस्य त्वं मम चेश्वरः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110508, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110509, "chapter_id": 3390, "verse_number": "१७", "content_sanskrit": "यत्किञ्चिदस्ति द्रविणं दैत्येन्द्राणामिहासुर ।\nतस्येश्वरोऽहं यदि चेद् देवयानी प्रसाद्यताम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110510, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110511, "chapter_id": 3390, "verse_number": "१८", "content_sanskrit": "श्रुत्वा शुक्रस्य वचनं वृषपर्वा सबान्धवः ।\nदेवयानीं प्रसीदेति पपात भुवि पादयोः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110512, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110513, "chapter_id": 3390, "verse_number": "१९", "content_sanskrit": "यदि त्वमीश्वरस्तात राज्ञो वित्तस्य भार्गव ।\nनाभिजानामि तत्तेऽहं राजा तु वदतु स्वयम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110514, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वृषपर्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110515, "chapter_id": 3390, "verse_number": "२०", "content_sanskrit": "स्तुत्यो वन्द्यश्च सततं मया तातश्च ते शुभे ।\nयत्काममभिकामाऽसि देवयानि शुचिस्मिते ।\nतत् तेऽहं सम्प्रदास्यामि यदि चेदपि दुर्लभम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110516, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110517, "chapter_id": 3390, "verse_number": "२१", "content_sanskrit": "दासीं कन्यासहस्रेण शर्मिष्ठामभिकामये ।\nअनुगच्छेत् तु सा मह्यं यत्र दास्यति मे पिता\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110518, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वृषपर्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2110519, "chapter_id": 3390, "verse_number": "२२", "content_sanskrit": "उत्तिष्ठ हंसगतिके शर्मिष्ठां शीघ्रमानय ।\nयच्च कामयते कर्तुं देवयानी करोतु तत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2110520, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2110521, "chapter_id": 3390, "verse_number": "२३", "content_sanskrit": "ततो धात्री गृहं गत्वा शर्मिष्ठां वाक्यमब्रवीत् ।\nउत्तिष्ठ भद्रे शर्मिष्ठे ज्ञातीनां सुखमावह \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2110522, "chapter_id": 3390, "verse_number": "२४", "content_sanskrit": "त्यजति ब्राह्मणः शिष्यान् देवयान्या प्रचोदितः ।\nसा यं कामयते कामं देवयानी कुरुष्व तत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2110523, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2110524, "chapter_id": 3390, "verse_number": "२५", "content_sanskrit": "यं सा कामयते कामं करवाण्यहमद्य तम् ।\nमा क्वेवोपगमेच्छुक्रो देवयान्या प्रचोदितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2110525, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2110526, "chapter_id": 3390, "verse_number": "२६", "content_sanskrit": "ततः कन्यासहस्रेण वृता शिबिकया तदा ।\nपितुर्नियोगात् त्वरिता निश्चकाम पुरोत्तमात् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2110527, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2110528, "chapter_id": 3390, "verse_number": "२७", "content_sanskrit": "अहं दासीसहस्रेण दासी ते परिचारिका ।\nअनु त्वां तत्र यास्यामि यत्र दास्यति ते पिता\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2110529, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2110530, "chapter_id": 3390, "verse_number": "२८", "content_sanskrit": "स्तुवतो दुहिता चाहं वन्दिनः प्रतिगृह्णतः ।\nस्तूयमानस्य दुहिता कथं दासी भविष्यसि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2110531, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "शर्मिष्ठा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2110532, "chapter_id": 3390, "verse_number": "२९", "content_sanskrit": "येन केन चिदार्तानां ज्ञातीनां यत् सुखावहम् ।\nसर्वमादृत्य कर्तव्यमेष धर्मः सनातनः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2110533, "chapter_id": 3390, "verse_number": "३०", "content_sanskrit": "एवं कृत्वा करिष्यामि यन्मां वक्ष्यसि शोभने ।\nअतस्त्वामनुयास्यामि यत्र दास्यति ते पिता\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2110534, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2110535, "chapter_id": 3390, "verse_number": "३१", "content_sanskrit": "प्रतिश्रुते दासभावे दुहित्रा वृषपर्वणः ।\nदेवयानी नृपश्रेष्ठ पितरं तमथाब्रवीत् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2110536, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "देवयानी–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2110537, "chapter_id": 3390, "verse_number": "३२", "content_sanskrit": "प्रविशाम पुरं तात तुष्टाऽस्मि द्विजसत्तम ।\nअमोघं तव विज्ञानमस्ति विद्याबलं च ते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2110538, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2110539, "chapter_id": 3390, "verse_number": "३३", "content_sanskrit": "एवमुक्तो दुहित्रा स भृगुश्रेष्ठो महातपाः ।\nप्रविवेश पुरं हृष्टः पूजितः सर्वदानवैः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2110540, "chapter_id": 3390, "verse_number": "६९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनसप्ततितमोऽध्यायः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2110541, "chapter_id": 3390, "verse_number": "१७", "content_sanskrit": "॥ सम्भवपर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2110542, "chapter_id": 3390, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]