[{"id": 2095675, "chapter_id": 3042, "verse_number": "१३-१७२-१", "content_sanskrit": "[वैशम्पायन उवाच।\nशरतल्पगतं भीष्मं वृद्धं कुरुपितामहम्।\nउपगम्य महाप्राज्ञः पर्यपृच्छद्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095676, "chapter_id": 3042, "verse_number": "१३-१७२-२", "content_sanskrit": "अङ्गानां रूपसौभाग्यं प्रियं चैव कथं भवेत्।\nधर्मार्थकामसंयुक्तः सुखभागी कथं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095677, "chapter_id": 3042, "verse_number": "१३-१७२-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095678, "chapter_id": 3042, "verse_number": "१३-१७२-३", "content_sanskrit": "मार्गशीर्षस्य मासस्य चन्द्रे मूलेन संयुते।\nपादौ मूलेन राजेन्द्रि जङ्घायामथ रोहिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095679, "chapter_id": 3042, "verse_number": "१३-१७२-४", "content_sanskrit": "अश्विन्यां सक्थिनी चैव ऊरू चाषाढयोस्तथा।\nगुह्यं तु फाल्गुनी विद्यात्कृत्तिका कटिकास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095680, "chapter_id": 3042, "verse_number": "१३-१७२-५", "content_sanskrit": "नाभिं भाद्रपदे विद्याद्रेवत्यामक्षिमण्डलम्।\nपृष्ठमेव धनिष्ठासु अनुराधोत्तरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095681, "chapter_id": 3042, "verse_number": "१३-१७२-६", "content_sanskrit": "बाहुभ्यां तु विशाखासु हस्तौ हस्तेन निर्दिशेत्।\nपुनर्वस्वङ्गुली राजन्नाश्लेषासु नखास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095682, "chapter_id": 3042, "verse_number": "१३-१७२-७", "content_sanskrit": "ग्रीवां ज्येष्ठा च राजेन्द्र श्रवणेन तु कर्णयोः।\nमुखं पुष्येण दानेन दन्तोष्ठौ स्वातिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095683, "chapter_id": 3042, "verse_number": "१३-१७२-८", "content_sanskrit": "हासं शतभिषां चैव मघां चैवाथ नासिकाम्।\nनेत्रे मृगशिरो विद्याल्ललाटे मित्रमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095684, "chapter_id": 3042, "verse_number": "१३-१७२-९", "content_sanskrit": "भरण्यां तु शिरो विद्यात्केशानार्द्रां नराधिप।\nसमाप्ते तु घृतं दद्याद्ब्राह्मणे वेदपारगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095685, "chapter_id": 3042, "verse_number": "१३-१७२-१०", "content_sanskrit": "सुभगो दर्शनीयश्च ज्ञानभाग्यथ जानते।\nजायते परिपूर्णाङ्गः पौर्णमास्येव चन्द्रमाः॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095686, "chapter_id": 3042, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्विसप्तत्यधिकशततमोऽध्यायः॥ १७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]