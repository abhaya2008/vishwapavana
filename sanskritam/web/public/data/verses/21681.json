[{"id": 7001681000, "chapter_id": 21681, "verse_number": "१-६७-१", "content_sanskrit": "सनत्कुमार उवाच ।\nअथ वक्ष्ये देवपूजां साधकाभीष्टसिद्धिदाम् ।\nत्रिकोणं चतुरस्रं वा वामभागे प्रकल्प्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001681001, "chapter_id": 21681, "verse_number": "१-६७-२", "content_sanskrit": "सम्पूज्या स्रेण संक्षाल्य हृदाधारं निधाय च ।\nतत्राग्निमण्डलं चेद्वा पात्रं संक्षाल्य चास्रतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001681002, "chapter_id": 21681, "verse_number": "१-६७-३", "content_sanskrit": "आधारे नामसं स्थाप्य तत्र चेद्रविमंडलम् ।\nक्लिममातृका पूलमुञ्चरन्पूरपेज्जलैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001681003, "chapter_id": 21681, "verse_number": "१-६७-४", "content_sanskrit": "चत्रेंजुमंडलं प्रार्च्य तीर्थान्यावाह्य पूर्ववत् ।\nगोमुद्रयामृतीकृत्य कवचेनावगुंठयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001681004, "chapter_id": 21681, "verse_number": "१-६७-५", "content_sanskrit": "संक्षाल्यास्रेण प्रणवं तदुपर्यष्टधा जपेत् ।\nसामान्यार्घमिदं प्रोक्तं सर्वसिद्धिकरं नृणाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001681005, "chapter_id": 21681, "verse_number": "१-६७-६", "content_sanskrit": "तज्जलं र्किचिदुदूधृत्य प्रोक्षिण्या साधकोत्तमः ।\nआत्मानं यागवस्तूनि तेन संप्रोक्षयेत्पुथक् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001681006, "chapter_id": 21681, "verse_number": "१-६७-७", "content_sanskrit": "आत्मवामाग्रतः कुर्यात्षट्ट्कोणांतस्रिकोणकम् ।\nचतुरस्रेण संवेष्ट्य संक्षाल्यार्घोदकेन च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001681007, "chapter_id": 21681, "verse_number": "१-६७-८", "content_sanskrit": "ततस्तु साधकश्रेष्टः स्तंभयेच्छंखमुद्रया ।\nआग्नेयादिषु कोणेषु हृदाद्यंगचतुष्टयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001681008, "chapter_id": 21681, "verse_number": "१-६७-९", "content_sanskrit": "नेत्रं मध्ये दिक्षु चास्रं त्रिकोणे पूजयेत्ततः ।\nमूलखंडत्रयेनाथाधारशक्तिं तु मध्यगाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001681009, "chapter_id": 21681, "verse_number": "१-६७-१०", "content_sanskrit": "एवं संपूज्य विधिवदस्रंसंक्षालितं हृदा ।\nप्रतिष्टाप्य त्रिपदिकां पूजयेन्मनुनामुना ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001681010, "chapter_id": 21681, "verse_number": "१-६७-११", "content_sanskrit": "मं वह्निमण्डला येति ततो देशकलात्मने ।\nअमुकार्ध्येति पात्रांते सनापहृदयोंऽतिमे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001681011, "chapter_id": 21681, "verse_number": "१-६७-१२", "content_sanskrit": "चतुर्विंशतिवर्णोऽयमाधारस्यार्चने मनुः ।\nस्वमंत्रक्षालितं शरंवं संस्याप्याय समर्चयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001681012, "chapter_id": 21681, "verse_number": "१-६७-१३", "content_sanskrit": "तारः कार्म्ममहांस्ते तु ततो जलचराय च ।\nवर्म फट् हृदयं पांचजन्याय हृदयं मनेः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001681013, "chapter_id": 21681, "verse_number": "१-६७-१४", "content_sanskrit": "तत्रार्कमण्डलायेति द्वादशांते कलारमने ।\nअमुकार्ध्येति पात्रांते नमोंतस्त्र्यक्षिवर्णवान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001681014, "chapter_id": 21681, "verse_number": "१-६७-१५", "content_sanskrit": "सम्पूज्य तेन तत्रार्चेद्द्वादशार्ककलाः क्रमात् ।\nततः शुद्धजलैर्मूलं विलोममातृकां पठन् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001681015, "chapter_id": 21681, "verse_number": "१-६७-१६", "content_sanskrit": "शङ्खमापूरयेत्तस्मिन्पूजयेन्मनुनामुना ।\nॐ सोममण्डलायेति षोडशांते कलात्मने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001681016, "chapter_id": 21681, "verse_number": "१-६७-१७", "content_sanskrit": "अमुकार्ध्यामृतायेति हृन्मनुश्चार्ध्यपूजने ।\nतत्र षोडशसंख्याका यजेञ्चंद्रमसः कलाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001681017, "chapter_id": 21681, "verse_number": "१-६७-१८", "content_sanskrit": "ततस्तु तीर्थान्यावाह्य गङ्गे चेत्यादिपूर्ववत् ।\nगोमुद्रयामृतीकृत्याच्छादयेन्मत्स्ममुद्रया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001681018, "chapter_id": 21681, "verse_number": "१-६७-१९", "content_sanskrit": "कवचेनावगुंठ्याथ रक्षेदस्त्रेण तत्पुनः ।\nचिंतयित्वेष्टदेवं च ततो मुद्राः प्रदर्शयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001681019, "chapter_id": 21681, "verse_number": "१-६७-२०", "content_sanskrit": "शङ्खमौशलचकाख्याः परमीकरणं ततः ।\nमहामुद्रां योनिमुद्रां दर्शयेत्क्रमतः सुधीः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001681020, "chapter_id": 21681, "verse_number": "१-६७-२१", "content_sanskrit": "गारुडी गालिनी चैव मुख्ये मुद्रे प्रकीर्तिते ।\nगन्धपुष्पादिभिस्तत्र पूजयेद्देवतां स्मरन् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001681021, "chapter_id": 21681, "verse_number": "१-६७-२२", "content_sanskrit": "अष्टकृत्वो जपेन्मूलं प्रणवं चाष्टधा तथा ।\nशंखाद्दक्षिणदिग्भागे प्रोक्षणीपात्रमादिशेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001681022, "chapter_id": 21681, "verse_number": "१-६७-२३", "content_sanskrit": "प्रोक्षण्यां तज्जलं किंचित्कृत्वात्मानं त्रिधा ततः ।\nआत्मतत्त्वात्मने हृञ्च विद्यातत्त्वात्मने नमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001681023, "chapter_id": 21681, "verse_number": "१-६७-२४", "content_sanskrit": "शिवतत्त्वात्मने हृञ्च इत्येतैर्मनुभिस्त्रिभिः ।\nप्रोक्षेत्पुष्पाक्षतैश्चापि मण्डलं विधिवत्सुधीः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001681024, "chapter_id": 21681, "verse_number": "१-६७-२५", "content_sanskrit": "अथवा मूलगायत्र्या पूजाद्रव्याणि प्रोक्षयेत् ।\nपाद्यार्ध्याचमनूयार्थं मधुपर्कार्थमप्युत ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001681025, "chapter_id": 21681, "verse_number": "१-६७-२६", "content_sanskrit": "पात्राण्याधारयुक्तानि स्थापयेद्विधिना पुरः ।\nपाद्यं श्यामाकदूर्वाब्जविष्णुक्रांतजलैः स्मृतम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001681026, "chapter_id": 21681, "verse_number": "१-६७-२७", "content_sanskrit": "अर्ध्यं पुष्पाक्षतयवैः कुशाग्रतिलसर्षपैः ।\nगंधदूर्वादलैः प्रोक्तं ततश्चाचमनीयकम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001681027, "chapter_id": 21681, "verse_number": "१-६७-२८", "content_sanskrit": "जातीफलं च कंकोलं लवंगं च जलान्वितम् ।\nक्षौद्राज्यदधिसंमिश्रं मधुपर्कसमीरितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001681028, "chapter_id": 21681, "verse_number": "१-६७-२९", "content_sanskrit": "एकस्मिन्नथवा पात्रे पाद्यादीनि प्रकल्पयेत् ।\nशंकरार्कार्चने शंखमयेनैव प्रशस्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001681029, "chapter_id": 21681, "verse_number": "१-६७-३०", "content_sanskrit": "श्वेताकृष्णारुणापीताश्यामारक्तासितासिताः ।\nरक्तांबराभयकराध्येयास्स्पुः पीठशक्तयः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001681030, "chapter_id": 21681, "verse_number": "१-६७-३१", "content_sanskrit": "स्वर्णादिलिखिते यंत्रे शालग्रामे मणौ तथा ।\nविधिना स्थापितायां वा प्रतिमायां प्रपूजयेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001681031, "chapter_id": 21681, "verse_number": "१-६७-३२", "content_sanskrit": "अंगुष्टादिवितस्त्यंतमाना स्वर्णादिधातुभिः ।\nनिर्मिता शुभदा गेहे पूजनाय दिने दिने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001681032, "chapter_id": 21681, "verse_number": "१-६७-३३", "content_sanskrit": "वक्रां दग्धां खंडितां च भिन्नमूर्द्धदृशं पुनः ।\nस्पष्टां वाप्यन्त्यजाद्यैश्च प्रतिमां नैव पूजयेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001681033, "chapter_id": 21681, "verse_number": "१-६७-३४", "content_sanskrit": "बाणादिलिंगे वाभ्यर्चेत्सर्वलक्षणलक्षिते ।\nमूलेन मूर्तिं संकल्प्य ध्यात्वा देवं यथोदितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001681034, "chapter_id": 21681, "verse_number": "१-६७-३५", "content_sanskrit": "आवाहा पूजयेतस्यां परिवारगणैः सह ।\nशालग्रामे स्थापितायां नावाहनविसर्जने ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001681035, "chapter_id": 21681, "verse_number": "१-६७-३६", "content_sanskrit": "पुष्पांजलिं समादाय ध्यात्वा मंत्रमुदीरयेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001681036, "chapter_id": 21681, "verse_number": "१-६७-३७", "content_sanskrit": "आत्मसंस्थमजं शुद्धं त्वामहं परमेश्वर ।\nअरण्यामिव हव्याशं मूर्तावावाहयाम्यहम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001681037, "chapter_id": 21681, "verse_number": "१-६७-३८", "content_sanskrit": "तवेयं हि महामूर्तिस्तस्यां त्वां सर्वगं प्रभो ।\nभक्तिरेवहसमाकृष्टं दीपवत्स्थापयाम्यहम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001681038, "chapter_id": 21681, "verse_number": "१-६७-३९", "content_sanskrit": "सर्वांतर्यामिणे देवं सर्वबीजमय शुभम् ।\nरवात्मस्थाय परं शुद्धमासनं कल्पयाव्यहम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001681039, "chapter_id": 21681, "verse_number": "१-६७-४०", "content_sanskrit": "अनन्या तव देवेश मूर्तिशक्तिरियं प्रभो ।\nसांनिध्यं कुरु तस्यां त्वं भक्तानुग्राहकारक ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001681040, "chapter_id": 21681, "verse_number": "१-६७-४१", "content_sanskrit": "अज्ञानाजुच मत्तत्त्वाद्वैकल्यात्साधनस्य च ।\nयद्यपूर्णं भवेत्कल्पं कतथाप्यभिमुखो भव ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001681041, "chapter_id": 21681, "verse_number": "१-६७-४२", "content_sanskrit": "दृशा पूयूषवर्षिण्या पूरयन्यज्ञविष्टरे ।\nमूर्तौ वा यज्ञसंपूर्त्यै स्थितो भव महेश्वर ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001681042, "chapter_id": 21681, "verse_number": "१-६७-४३", "content_sanskrit": "अभक्तवाङ्मनश्चक्षुः श्रोत्रदूरायितद्युते ।\nस्वतेजः पंजरेणाशु वेष्टितो भव सर्वतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001681043, "chapter_id": 21681, "verse_number": "१-६७-४४", "content_sanskrit": "यस्य दर्शनामिच्छंति देवाः स्वाभीष्टसिद्धये ।\nतस्मै ते परमेशाय स्वागतं स्वागतं च मे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001681044, "chapter_id": 21681, "verse_number": "१-६७-४५", "content_sanskrit": "कृतार्थोऽनुगृहीतोऽस्मि सफलं जीवितं मम ।\nआगतो देवदेवेशः सुखागतमिदं पुनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001681045, "chapter_id": 21681, "verse_number": "१-६७-४६", "content_sanskrit": "यद्भक्तिलेप्तसंपर्कात्परमानंदसंभवः ।\nतस्मै मे परणाब्जाय पाद्यं शुद्धाय कल्प्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001681046, "chapter_id": 21681, "verse_number": "१-६७-४७", "content_sanskrit": "वेदानामपि वेदाय देवानां देवतात्मने ।\nआचामं कल्पयामीश शुद्धानां शुद्धिहेतवे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001681047, "chapter_id": 21681, "verse_number": "१-६७-४८", "content_sanskrit": "तापत्रयहर दिव्यं परमानन्दलक्षणम् ।\nतापत्रयविनिर्मुक्त्यै तवार्घ्यं कल्पयाम्यहम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001681048, "chapter_id": 21681, "verse_number": "१-६७-४९", "content_sanskrit": "सर्वकालुष्यहीनाय परिपूर्णसुखात्मने ।\nमधुपर्कमिदं देव कल्पयामि प्रसीद मे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001681049, "chapter_id": 21681, "verse_number": "१-६७-५०", "content_sanskrit": "अवच्छिष्टोऽप्यशुचिर्वापि यस्य स्मरणमात्रतः ।\nशुद्धिमाप्नोति तस्मै ते पुनराचमनीयकम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001681050, "chapter_id": 21681, "verse_number": "१-६७-५१", "content_sanskrit": "स्नेहं गृहाण स्नेहेन लोकनाथ महाशय ।\nसर्वलोकेषु शुद्धात्मन्ददामि स्नेहमुत्तमम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001681051, "chapter_id": 21681, "verse_number": "१-६७-५२", "content_sanskrit": "परमानंदबोधाब्धिनिमग्ननिजमूर्तये ।\nसांगोपांगमिदं स्नानं कल्पयाम्यहमीश ते ।\nसहस्रं वा शतं वापि यथाशक्त्यादरेण च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001681052, "chapter_id": 21681, "verse_number": "१-६७-५३", "content_sanskrit": "गन्धपुष्पादिकैरीश मनुनां चाभिषिंचेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001681053, "chapter_id": 21681, "verse_number": "१-६७-५४", "content_sanskrit": "मायाचि त्रपटच्छन्ननिजगुह्योरुतेजसे ।\nनिरावरणविज्ञान वासस्ते कल्पयाम्यहम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001681054, "chapter_id": 21681, "verse_number": "१-६७-५५", "content_sanskrit": "यमाश्रित्य म हामाया जगत्संमोहिनी सदा ।\nतस्मै ते परमेशाय कल्पयाम्युत्तरीयकम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001681055, "chapter_id": 21681, "verse_number": "१-६७-५६", "content_sanskrit": "रक्तं शक्त्यर्कविघ्नेषु पीतंविष्णौ सितं शिवे ।\nतैलादिदूषितं जीर्णं सच्छिद्रं मलिनं त्यजेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001681056, "chapter_id": 21681, "verse_number": "१-६७-५७", "content_sanskrit": "यस्य शक्तित्रयेणदं संप्रीतमखिलं जगत् ।\nयज्ञसूत्राय तस्मै ते यज्ञसूत्रं प्रकल्पये ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001681057, "chapter_id": 21681, "verse_number": "१-६७-५८", "content_sanskrit": "स्वभावसुन्दरांगाय नानाशक्त्याश्रयाय ते ।\nभूषणानि विचित्राणि कल्पयाम्यमरार्चित ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001681058, "chapter_id": 21681, "verse_number": "१-६७-५९", "content_sanskrit": "परमानन्दसौरभ्यपरिपूर्णदिगंतरम् ।\nगृहाण परम गंध कृपया परमेश्वर ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001681059, "chapter_id": 21681, "verse_number": "१-६७-६०", "content_sanskrit": "तुरीयवनसंभूतं नानागुणमनोहरम् ।\nअमंदसौरभपुष्पं गृह्यतामिदमुत्तमम् ।\nजपाक्षतार्कधत्तूरान्विष्णौ नैवार्पयेत्क्वचित् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001681060, "chapter_id": 21681, "verse_number": "१-६७-६१", "content_sanskrit": "केतकीं कुटजं कुंदं बंधूकं केसरं जपाम् ।\nमालतीपुष्पक चैव नार्पयेत्तु महेश्वरे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001681061, "chapter_id": 21681, "verse_number": "१-६७-६२", "content_sanskrit": "मातुलिंगं च तगरं रवौ नैवार्पयेत्क्वचित् ।\nशक्तौ दूर्वार्कमंदारान् गणेशे तुलसीं त्यजेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001681062, "chapter_id": 21681, "verse_number": "१-६७-६३", "content_sanskrit": "सरोजिनीदमनकौ तथा मरुबकः कुशः ।\nविष्णुक्रांता नागवल्ली दूर्वापामार्गदाडिमौ ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001681063, "chapter_id": 21681, "verse_number": "१-६७-६४", "content_sanskrit": "धात्री मुनियुतानां च पत्रैर्देवार्चनं चरेत् ।\nकदली बदरी धात्री तिंतिणी बीजपूरकम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001681064, "chapter_id": 21681, "verse_number": "१-६७-६५", "content_sanskrit": "आम्रदाडिमजंबीरजंबूपनसभूरुहाः ।\nएतेषां तु फलैः कुर्याद्देवतापूजनं बुधः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001681065, "chapter_id": 21681, "verse_number": "१-६७-६६", "content_sanskrit": "शुष्कैस्तु नार्चयेद्देवं पत्रैः पुष्पैः फलैरपि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001681066, "chapter_id": 21681, "verse_number": "१-६७-६७", "content_sanskrit": "धात्री खदिरबित्वानां तमालस्य दलानि च ।\nछिन्नभिन्नान्यपि मुने न दूष्याणि जगुर्बुधाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001681067, "chapter_id": 21681, "verse_number": "१-६७-६८", "content_sanskrit": "पद्ममामलकं तिष्टेच्छुद्धं चैव दिनत्रयम् ।\nसर्वदा तुलसी शुद्धा बिल्वपत्राणि वै तथा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001681068, "chapter_id": 21681, "verse_number": "१-६७-६९", "content_sanskrit": "पलाशकाशकुसुमैस्तमालतुलसीदलैः ।\nछात्रीदलैश्च दूर्वाभिर्नार्चयेज्जगदंबिकाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001681069, "chapter_id": 21681, "verse_number": "१-६७-७०", "content_sanskrit": "नार्पयेत्कुसुमं पत्रं फलं देवे ह्यधोमुखम् ।\nपुष्पपत्रादिकं विप्र यथोत्पन्नं तथार्पयेत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001681070, "chapter_id": 21681, "verse_number": "१-६७-७१", "content_sanskrit": "वनस्पतिरसं दिव्यं गंधाढ्यं सुमनोहरम् ।\nआघ्रेयं देवदेवेश धूपं भक्त्या गृहाम मे ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001681071, "chapter_id": 21681, "verse_number": "१-६७-७२", "content_sanskrit": "सुप्रकाशं महादीपं सर्वदा तिमिरापहम् ।\nघृतवर्तिसमायुक्तं गृहाण मम सत्कृतम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001681072, "chapter_id": 21681, "verse_number": "१-६७-७३", "content_sanskrit": "अन्नं चतुर्विधं स्वादु रसैः षड्भिः समन्वितम् ।\nभक्त्या गृहाण मे देव नैवेद्यंतुष्टिदंसदा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001681073, "chapter_id": 21681, "verse_number": "१-६७-७४", "content_sanskrit": "नागवल्लीदलं श्रेष्टं पूगखदिरचूर्णयुक् ।\nकर्पूरादिसुगंधाढ्यं यद्दत्तं तद्गृहाण मे ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001681074, "chapter_id": 21681, "verse_number": "१-६७-७५", "content_sanskrit": "दद्यात्पुष्पाञ्जलिं पश्चात्कुर्यादावरणार्चनम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001681075, "chapter_id": 21681, "verse_number": "१-६७-७६", "content_sanskrit": "यदाशाभिमुखो भूत्वा पूजनं तु समाचरेत् ।\nसैव प्राची तु विज्ञेया ततोऽन्या विदिशो दश ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001681076, "chapter_id": 21681, "verse_number": "१-६७-७७", "content_sanskrit": "केशरेष्वग्निकोणादि हृदयादीनि पूजयेत् ।\nनेत्रमग्रे दिक्षु चास्त्रं अंगमंत्रैर्यथाक्रमम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001681077, "chapter_id": 21681, "verse_number": "१-६७-७८", "content_sanskrit": "शुक्लश्वेतसितश्यामकृष्णरक्तार्चिषः क्रमात् ।\nवराभयकरा ध्येयाः स्वस्वदिक्ष्वं गशक्तयः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001681078, "chapter_id": 21681, "verse_number": "१-६७-७९", "content_sanskrit": "अमुकावरणांते तु देवता इति संवदेत् ।\nसालंकारास्ततः पश्चात्सांगाः सपरिचारिकाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001681079, "chapter_id": 21681, "verse_number": "१-६७-८०", "content_sanskrit": "सवाहनाः सायुधाश्च ततः सर्वो पचारकैः ।\nसंपूजितास्तर्पिताश्च वरदाः संत्विदं पठेत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001681080, "chapter_id": 21681, "verse_number": "१-६७-८१", "content_sanskrit": "मूलांते च समुञ्चार्य दिवतायै निवेदयेत् ।\nअभीष्टसिद्धिं मे देहि शरणागतवत्सल ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001681081, "chapter_id": 21681, "verse_number": "१-६७-८२", "content_sanskrit": "भक्तया समर्पये तुभ्यममुकावरणार्चनम् ।\nइत्युञ्चार्य क्षिपेत्पुष्पाञ्जलिं देवस्य मस्तके ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001681082, "chapter_id": 21681, "verse_number": "१-६७-८३", "content_sanskrit": "ततस्त्वभ्यर्च्यनीयाः स्युः कल्पोक्ताश्चावृतीः क्रमात् ।\nसायुधांस्तत इंद्राद्यान्स्वस्वदिक्षु प्रपूजयेत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001681083, "chapter_id": 21681, "verse_number": "१-६७-८४", "content_sanskrit": "इद्रो वह्निर्यमो रक्षो वरुणः पवनो विधुः ।\nईशानोऽथ विधिश्चैवमधस्तात्पन्न गाधिपः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001681084, "chapter_id": 21681, "verse_number": "१-६७-८५", "content_sanskrit": "ऐरावतस्तथा मेषो महिषः प्रेतस्तिमिर्मृगः ।\nवाजी वृषो हंसकूर्मौ वाहनानि विदुर्बुधाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001681085, "chapter_id": 21681, "verse_number": "१-६७-८६", "content_sanskrit": "वज्रं शक्तिं दंडखङ्गौ पाशां कुशगदा अपि ।\nत्रिशूलं पद्मचक्रे च क्रमादिंद्रादिहेतयः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001681086, "chapter_id": 21681, "verse_number": "१-६७-८७", "content_sanskrit": "समाप्यावरणार्चां तु देवतारार्तिकं चरेत् ।\nशंखतोयं परिक्षिप्योद्वाहुर्नृत्यन् पतेत्क्षितौ ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001681087, "chapter_id": 21681, "verse_number": "१-६७-८८", "content_sanskrit": "दंडवञ्चाप्यथोत्थाय प्रार्थयित्वा निजेश्वरम् ।\nदक्षिणे स्थंडिलं कृत्वा तत्र संस्कारमाचरेत् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001681088, "chapter_id": 21681, "verse_number": "१-६७-८९", "content_sanskrit": "मूलेनेक्षणमस्त्रेण प्रोक्षणं ताडनं पुनः ।\nकुशैस्तद्वर्मणाभ्युक्ष्य पूज्य तत्र न्यसेद्वसुम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001681089, "chapter_id": 21681, "verse_number": "१-६७-९०", "content_sanskrit": "प्रदाप्य तत्र जुहुयाद्ध्यात्वा चैवेष्टदेवताम् ।\nमहाव्याहृतिभिर्यस्तु समस्ताभिश्चतुष्टयम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001681090, "chapter_id": 21681, "verse_number": "१-६७-९१", "content_sanskrit": "जुहुयात्सर्पिषा भक्तैस्तिलैर्वा पायसेन वा ।\nसघृतैः साधकश्रेष्टः पञ्चविंशतिसंख्यया ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001681091, "chapter_id": 21681, "verse_number": "१-६७-९२", "content_sanskrit": "पुनर्व्याहृतिभिघिर्हुत्वा गंधाद्यैः पुनरर्चयेत् ।\nदेवं संयोजयेन्मूर्तौ ततो वह्निं विसर्जयेत् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001681092, "chapter_id": 21681, "verse_number": "१-६७-९३", "content_sanskrit": "भो भो वह्ने महाशक्ते सर्वकर्मप्रसाधक ।\nकर्मांतरेऽपि संप्राप्ते सान्निध्यं कुरु सादरम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001681093, "chapter_id": 21681, "verse_number": "१-६७-९४", "content_sanskrit": "विसृज्याग्निदेवतायै दद्यादाचमनीयकम् ।\nअवशिष्टेन हविषा गंधपुष्पाक्षतान्वितम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001681094, "chapter_id": 21681, "verse_number": "१-६७-९५", "content_sanskrit": "देवतापार्षदेभ्योऽपि पूर्वोक्तेभ्यो बलिं ददेत् ।\nये रौद्रा रौद्रकर्माणो रौद्रस्थाननिवासिनः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001681095, "chapter_id": 21681, "verse_number": "१-६७-९६", "content_sanskrit": "योगिन्यो ह्युग्ररूपाश्च गणानामधिपास्च ये ।\nविघ्नभूतास्तथा चान्ये दिग्विदिक्षु समाश्रिताःग ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001681096, "chapter_id": 21681, "verse_number": "१-६७-९७", "content_sanskrit": "सर्वे ते प्रीतमनसः प्रतिगृह्णंत्विमं बलिम् ।\nइत्यष्टदिक्षु दत्वा च पुनर्भूतबलिं चरेत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001681097, "chapter_id": 21681, "verse_number": "१-६७-९८", "content_sanskrit": "पानीयममृतीकृत्य मुद्रया धेनुसंज्ञया ।\nदेवतायाः करे दद्यात्पुनश्चाचमनीयकम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001681098, "chapter_id": 21681, "verse_number": "१-६७-९९", "content_sanskrit": "देवमुद्वास्य मूर्तिस्थं पुनस्तत्रैव योजयेत् ।\nनैवेद्यं च ततो दद्यात्तत्तदुच्छिष्टभोजिने ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001681099, "chapter_id": 21681, "verse_number": "१-६७-१००", "content_sanskrit": "महेश्वरस्य चंडेशो विष्वक्सेनस्तथा हरेः ।\nचंडांशुस्तरणेर्वक्ततुंडश्चापि गणेशितुः ।\nशक्तेरुच्छिष्टचांडाली प्रोक्ता उच्छिष्टभोजिनः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001681100, "chapter_id": 21681, "verse_number": "१-६७-१०१", "content_sanskrit": "ततो ऋष्यादिकं स्मृत्वा कृत्वा मूलषडंगकम् ।\nजप्त्वा मंत्रं यथाशक्ति देवतायै निवेदयेत् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001681101, "chapter_id": 21681, "verse_number": "१-६७-१०२", "content_sanskrit": "गुह्यातिगुह्यगोप्ता त्वं गृहाणास्मत्कृतं जपम् ।\nसिद्धिर्भवतु मे देव त्वत्प्रसादात्त्वयि स्थिता ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001681102, "chapter_id": 21681, "verse_number": "१-६७-१०३", "content_sanskrit": "ततः पराङ्मुखं चार्घं कृत्वा पुष्पैः प्रपूजयेत् ।\nदोर्भ्यां पभ्द्यां च जानुभ्यामुरसा शिरसादृशा ।\nमनसा वचसा चेति प्रणामोऽष्टांग ईरितः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001681103, "chapter_id": 21681, "verse_number": "१-६७-१०४", "content_sanskrit": "बाहुभ्यां च सजानुभ्यां शिरसा वचसापि वा ।\nपंचांगकः प्रणामः स्यात्पूजायां प्रवरावुभौ ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001681104, "chapter_id": 21681, "verse_number": "१-६७-१०५", "content_sanskrit": "नत्वा च दंडवन्मंत्री ततः कुर्यात्प्रदक्षिणाः ।\nविष्णुसोमार्कविघ्नानां वेदार्धेंद्वद्रिवह्नयः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001681105, "chapter_id": 21681, "verse_number": "१-६७-१०६", "content_sanskrit": "ततः स्तोत्रादिकं मंत्री प्रपठेद्भक्तिपूर्वकम् ।\nइतः पूर्णं प्राणबुद्धिदेहधर्माधिकारतः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001681106, "chapter_id": 21681, "verse_number": "१-६७-१०७", "content_sanskrit": "जाग्रत्स्वप्नसुषुप्त्यंतेऽवस्थासु मनसा वदेत् ।\nवाचा हस्ताभ्यां च पद्भ्यामुदरेण ततः परम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001681107, "chapter_id": 21681, "verse_number": "१-६७-१०८", "content_sanskrit": "शिष्णांते यत्स्मृतं पश्चाद्यदुक्तं यत्कृतं ततः ।\nतत्सर्वं च ततो ब्रह्मर्पणं भवतु ठद्वयम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001681108, "chapter_id": 21681, "verse_number": "१-६७-१०९", "content_sanskrit": "मां मदीयं च सकलं विष्णवे च समर्पये ।\nतारं तत्सदतो ब्रह्मर्पणमस्तु मनुर्मतः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001681109, "chapter_id": 21681, "verse_number": "१-६७-११०", "content_sanskrit": "प्रणवाद्योऽष्टवस्वर्णो ह्यनेनात्मानमर्पयेत् ।\nअज्ञानाद्वा प्रमादाद्वा वैकल्यात्साधनस्य च ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001681110, "chapter_id": 21681, "verse_number": "१-६७-१११", "content_sanskrit": "यन्न्यूनमतिरिक्तं वा तत्सर्वं क्षन्तुमर्हसि ।\nद्रव्यहीनं क्रियाहीनं मंत्रहीनं मयान्यथा ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001681111, "chapter_id": 21681, "verse_number": "१-६७-११२", "content_sanskrit": "कृतं यत्तत्क्षमस्वेश कृपया त्वं दयानिधे ।\nयन्मया क्रियते कर्म जाग्रत्स्वप्रसुषुप्तिषु ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001681112, "chapter_id": 21681, "verse_number": "१-६७-११३", "content_sanskrit": "तत्सर्वं तावकी पूजा भूयाद्‌भूत्यै च मे प्रभो ।\nभूमौ स्खलितपादानां भूमिरेवावलंबनम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001681113, "chapter_id": 21681, "verse_number": "१-६७-११४", "content_sanskrit": "त्वयि जातापराधानां त्वमेव शरणं प्रभो ।\nअन्यथा शरणं नास्ति त्वमेव शरणं मम ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001681114, "chapter_id": 21681, "verse_number": "१-६७-११५", "content_sanskrit": "तस्मात्कारुण्यभावेन क्षमस्व परमेश्वर ।\nअपराधसहस्राणि क्रियंतेऽहर्न्निशं मया ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001681115, "chapter_id": 21681, "verse_number": "१-६७-११६", "content_sanskrit": "दासोऽयमिति मां मत्वा क्षमस्व जगतां पते ।\nआवाहनं न जानामि न जानामि विसर्जनम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001681116, "chapter_id": 21681, "verse_number": "१-६७-११७", "content_sanskrit": "पूजां चैव न जानामि त्वं गतिः परमेश्वर ।\nसंप्रार्थ्यैवं ततो मंत्री मूलांते श्लोकमुञ्चरेत् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001681117, "chapter_id": 21681, "verse_number": "१-६७-११८", "content_sanskrit": "गच्छ गच्छ परं स्थानं जगदीश जगन्मय ।\nयन्न ब्रह्मादयो देवा जानंति च सदाशिवः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001681118, "chapter_id": 21681, "verse_number": "१-६७-११९", "content_sanskrit": "इति पुष्पांजलिं दत्वा ततः संहारमुद्रया ।\nनिधाय देवं सांगं च स्वीयदृत्सरसीरुहे ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001681119, "chapter_id": 21681, "verse_number": "१-६७-१२०", "content_sanskrit": "सुषुम्णावर्त्मना पुष्पमाघ्रायोद्वासयेद् बुधः ।\nशंखचक्रशिलालिंगविघ्नसूर्यद्वयं तथा ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001681120, "chapter_id": 21681, "verse_number": "१-६७-१२१", "content_sanskrit": "शक्तित्रयं न चैकत्र पूजयेद्दुःखकारणम् ।\nअकालमृत्युहरणं सर्वव्याधिविनाशन् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001681121, "chapter_id": 21681, "verse_number": "१-६७-१२२", "content_sanskrit": "सर्वपापक्षयकरं विष्णुपादोदकं शुभम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001681122, "chapter_id": 21681, "verse_number": "१-६७-१२३", "content_sanskrit": "तत्तद्भक्तैर्गृही तव्यं तन्नैवेद्यनिवेदितम् ।\nअग्राह्यं शिवनिर्माल्यं पत्रं पुष्पं फलं जलम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001681123, "chapter_id": 21681, "verse_number": "१-६७-१२४", "content_sanskrit": "शालग्रामशिलास्पर्शात्सर्वं याति पवित्रताम् ।\nपूजा पंचविधा तत्र कथिता नारदाखिलैः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7001681124, "chapter_id": 21681, "verse_number": "१-६७-१२५", "content_sanskrit": "आतुरी सौतिकी त्रासी साधना भाविनी तथा ।\nदौर्बोधी च क्रमादासां लक्षणानि श्रृणुष्व मे ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7001681125, "chapter_id": 21681, "verse_number": "१-६७-१२६", "content_sanskrit": "रोगादियुक्तो न स्रायान्न जपेन्न च पूजयेत् ।\nविलोक्य पूजां देवस्य मूर्तिं वा सूर्य्यमंडलम् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7001681126, "chapter_id": 21681, "verse_number": "१-६७-१२७", "content_sanskrit": "प्रणम्याथ स्मरन्मंत्रमर्पयेत्कुमांजलिम् ।\nरोगे निवृत्ते स्नात्वाथ नत्वा संपूञ्चेद्गुरुम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7001681127, "chapter_id": 21681, "verse_number": "१-६७-१२८", "content_sanskrit": "त्वत्प्रसादाज्जगन्नाथ जगत्पूज्य दयानिधे ।\nपूजाविच्छेददोषो मे मास्त्विति प्रार्थयेच्च तम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7001681128, "chapter_id": 21681, "verse_number": "१-६७-१२९", "content_sanskrit": "द्विजानपि च संपूज्य यथाशक्त्या प्रतोष्य च ।\nतेभ्यश्चाशिषमादाय देवं प्राग्वत्ततोऽर्चयेत् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7001681129, "chapter_id": 21681, "verse_number": "१-६७-१३०", "content_sanskrit": "आतुरी कथिता ह्येषा सोतिक्यथ निगद्यते ।\nसूतकं द्विविधं प्रोक्तं जाताख्यं मृतसंज्ञकम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7001681130, "chapter_id": 21681, "verse_number": "१-६७-१३१", "content_sanskrit": "तत्र स्नात्वा मानसीं तु कृत्वा संध्यां समाहितः ।\nमनसैव यजेद्देवं मनसैव जपेन्मनुम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7001681131, "chapter_id": 21681, "verse_number": "१-६७-१३२", "content_sanskrit": "निवृत्ते सूतके प्राग्वत्संपूज्य च गुरुं द्विजान् ।\nतेभ्यश्चाशिषमादाय ततो नित्यक्रमं चरेत् ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7001681132, "chapter_id": 21681, "verse_number": "१-६७-१३३", "content_sanskrit": "एषा तु सौतिकी प्रोक्ता त्रासी चाथ निगद्यते ।\nदुष्टेभ्यस्त्रासमापन्नो यथालब्धोपचारंकैः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7001681133, "chapter_id": 21681, "verse_number": "१-६७-१३४", "content_sanskrit": "मानसैर्वै यजेद्देवं त्रासी सा परिकीर्तिता ।\nपूजासाधनवस्तूनाम सामर्थ्ये तु सर्वतः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7001681134, "chapter_id": 21681, "verse_number": "१-६७-१३५", "content_sanskrit": "पुष्पैः पत्रैः फलैर्वापि मनसा वा यजेद्विभुम् ।\nसाधनाभाविनी ह्येषा दौर्बोधीं श्रृणु नारद ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7001681135, "chapter_id": 21681, "verse_number": "१-६७-१३६", "content_sanskrit": "स्त्रियो वृद्धास्तथा बाला मूर्खास्तैस्तु यथाक्रमम् ।\nयथाज्ञानकृता सा तु दौर्बोधीति प्रकीर्तिता ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7001681136, "chapter_id": 21681, "verse_number": "१-६७-१३७", "content_sanskrit": "एवं यथाकथंचित्तु पूजां कुर्याद्धि साधकः ।\nदेवपूजाविहीनो यः स गच्छेन्नरकं ध्रुवम् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7001681137, "chapter_id": 21681, "verse_number": "१-६७-१३८", "content_sanskrit": "वैश्वदेवादिकं कृत्वा भोजयेद्द्विजसत्तमान् ।\nदेवे निवेदितं पश्चाद्भुंमजीत स्वगणैः स्वयम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7001681138, "chapter_id": 21681, "verse_number": "१-६७-१३९", "content_sanskrit": "आचम्याननशुद्धिं च कृत्वा तिष्टेत् कियत्क्षणम् ।\nपुराणमितिहासं च श्रृणुयात्स्वजनैः सह ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7001681139, "chapter_id": 21681, "verse_number": "१-६७-१४०", "content_sanskrit": "समर्थः सर्वकल्पेषु योऽनुकल्पं समाचरेत् ।\nन सांगशयिकं तस्य दुर्मतेर्जायते फलम् ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}]