[{"id": 5000513000, "chapter_id": 9513, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षडधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000513001, "chapter_id": 9513, "verse_number": "६-१०६-१", "content_sanskrit": "सारथिः स रथं हृष्टः परसैन्यप्रधर्षणम्।\nगन्धर्वनगराकारं समुच्छ्रितपताकिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000513002, "chapter_id": 9513, "verse_number": "६-१०६-२", "content_sanskrit": "युक्तं परमसम्पन्नैर्वाजिभिर्हेममालिभिः।\nयुद्धोपकरणैः पूर्णं पताकाध्वजमालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000513003, "chapter_id": 9513, "verse_number": "६-१०६-३", "content_sanskrit": "ग्रसन्तमिव चाकाशं नादयन्तं वसुंधराम्।\nप्रणाशं परसैन्यानां स्वसैन्यस्य प्रहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000513004, "chapter_id": 9513, "verse_number": "६-१०६-४", "content_sanskrit": "रावणस्य रथं क्षिप्रं चोदयामास सारथिः।\nतमापतन्तं सहसा स्वनवन्तं महाध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000513005, "chapter_id": 9513, "verse_number": "६-१०६-५", "content_sanskrit": "रथं राक्षसराजस्य नरराजो ददर्श ह।\nकृष्णवाजिसमायुक्तं युक्तं रौद्रेण वर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000513006, "chapter_id": 9513, "verse_number": "६-१०६-६", "content_sanskrit": "दीप्यमानमिवाकाशे विमानं सूर्यवर्चसम्।\nतडित्पताकागहनं दर्शितेन्द्रायुधप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000513007, "chapter_id": 9513, "verse_number": "६-१०६-७", "content_sanskrit": "शरधारा विमुञ्चन्तं धाराधरमिवाम्बुदम्।\nस दृष्ट्वा मेघसंकाशमापतन्तं रथं रिपोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000513008, "chapter_id": 9513, "verse_number": "६-१०६-८", "content_sanskrit": "गिरेर्वज्राभिमृष्टस्य दीर्यतः सदृशस्वनम्।\nविस्फारयन् वै वेगेन बालचन्द्रानतं धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000513009, "chapter_id": 9513, "verse_number": "६-१०६-९", "content_sanskrit": "उवाच मातलिं रामः सहस्राक्षस्य सारथिम्।\nमातले पश्य संरब्धमापतन्तं रथं रिपोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000513010, "chapter_id": 9513, "verse_number": "६-१०६-१०", "content_sanskrit": "यथापसव्यं पतता वेगेन महता पुनः।\nसमरे हन्तुमात्मानं तथानेन कृता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000513011, "chapter_id": 9513, "verse_number": "६-१०६-११", "content_sanskrit": "तदप्रमादमातिष्ठ प्रत्युद‍्गच्छ रथं रिपोः।\nविध्वंसयितुमिच्छामि वायुर्मेघमिवोत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000513012, "chapter_id": 9513, "verse_number": "६-१०६-१२", "content_sanskrit": "अविक्लवमसम्भ्रान्तमव्यग्रहृदयेक्षणम्।\nरश्मिसंचारनियतं प्रचोदय रथं द्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000513013, "chapter_id": 9513, "verse_number": "६-१०६-१३", "content_sanskrit": "कामं न त्वं समाधेयः पुरंदररथोचितः।\nयुयुत्सुरहमेकाग्रः स्मारये त्वां न शिक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000513014, "chapter_id": 9513, "verse_number": "६-१०६-१४", "content_sanskrit": "परितुष्टः स रामस्य तेन वाक्येन मातलिः।\nप्रचोदयामास रथं सुरसारथिरुत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000513015, "chapter_id": 9513, "verse_number": "६-१०६-१५", "content_sanskrit": "अपसव्यं ततः कुर्वन् रावणस्य महारथम्।\nचक्रसम्भूतरजसा रावणं व्यवधूनयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000513016, "chapter_id": 9513, "verse_number": "६-१०६-१६", "content_sanskrit": "ततः क्रुद्धो दशग्रीवस्ताम्रविस्फारितेक्षणः।\nरथप्रतिमुखं रामं सायकैरवधूनयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000513017, "chapter_id": 9513, "verse_number": "६-१०६-१७", "content_sanskrit": "धर्षणामर्षितो रामो धैर्यं रोषेण लम्भयन्।\nजग्राह सुमहावेगमैन्द्रं युधि शरासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000513018, "chapter_id": 9513, "verse_number": "६-१०६-१८", "content_sanskrit": "शरांश्च सुमहावेगान् सूर्यरश्मिसमप्रभान्।\nतदुपोढं महद् युद्धमन्योन्यवधकांक्षिणोः।\nपरस्पराभिमुखयोर्दृप्तयोरिव सिंहयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000513019, "chapter_id": 9513, "verse_number": "६-१०६-१९", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः।\nसमीयुर्द्वैरथं द्रष्टुं रावणक्षयकांक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000513020, "chapter_id": 9513, "verse_number": "६-१०६-२०", "content_sanskrit": "समुत्पेतुरथोत्पाता दारुणा रोमहर्षणाः।\nरावणस्य विनाशाय राघवस्योदयाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000513021, "chapter_id": 9513, "verse_number": "६-१०६-२१", "content_sanskrit": "ववर्ष रुधिरं देवो रावणस्य रथोपरि।\nवाता मण्डलिनस्तीव्रा व्यपसव्यं प्रचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000513022, "chapter_id": 9513, "verse_number": "६-१०६-२२", "content_sanskrit": "महद‍्गृध्रकुलं चास्य भ्रममाणं नभस्थले।\nयेन येन रथो याति तेन तेन प्रधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000513023, "chapter_id": 9513, "verse_number": "६-१०६-२३", "content_sanskrit": "संध्यया चावृता लङ्का जपापुष्पनिकाशया।\nदृश्यते सम्प्रदीप्तेव दिवसेऽपि वसुंधरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000513024, "chapter_id": 9513, "verse_number": "६-१०६-२४", "content_sanskrit": "सनिर्घाता महोल्काश्च सम्प्रपेतुर्महास्वनाः।\nविषादयंस्ते रक्षांसि रावणस्य तदाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000513025, "chapter_id": 9513, "verse_number": "६-१०६-२५", "content_sanskrit": "रावणश्च यतस्तत्र प्रचचाल वसुंधरा।\nरक्षसां च प्रहरतां गृहीता इव बाहवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000513026, "chapter_id": 9513, "verse_number": "६-१०६-२६", "content_sanskrit": "ताम्राः पीताः सिताः श्वेताः पतिताः सूर्यरश्मयः।\nदृश्यन्ते रावणस्याग्रे पर्वतस्येव धातवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000513027, "chapter_id": 9513, "verse_number": "६-१०६-२७", "content_sanskrit": "गृध्रैरनुगताश्चास्य वमन्त्यो ज्वलनं मुखैः।\nप्रणेदुर्मुखमीक्षन्त्यः संरब्धमशिवं शिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000513028, "chapter_id": 9513, "verse_number": "६-१०६-२८", "content_sanskrit": "प्रतिकूलं ववौ वायू रणे पांसून् समुत्किरन्।\nतस्य राक्षसराजस्य कुर्वन् दृष्टिविलोपनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000513029, "chapter_id": 9513, "verse_number": "६-१०६-२९", "content_sanskrit": "निपेतुरिन्द्राशनयः सैन्ये चास्य समन्ततः।\nदुर्विषह्यस्वरा घोरा विना जलधरोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000513030, "chapter_id": 9513, "verse_number": "६-१०६-३०", "content_sanskrit": "दिशश्च प्रदिशः सर्वा बभूवुस्तिमिरावृताः।\nपांसुवर्षेण महता दुर्दर्शं च नभोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000513031, "chapter_id": 9513, "verse_number": "६-१०६-३१", "content_sanskrit": "कुर्वन्त्यः कलहं घोरं सारिकास्तद्रथं प्रति।\nनिपेतुः शतशस्तत्र दारुणा दारुणारुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000513032, "chapter_id": 9513, "verse_number": "६-१०६-३२", "content_sanskrit": "जघनेभ्यः स्फुलिङ्गाश्च नेत्रेभ्योऽश्रूणि संततम्।\nमुमुचुस्तस्य तुरगास्तुल्यमग्निं च वारि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000513033, "chapter_id": 9513, "verse_number": "६-१०६-३३", "content_sanskrit": "एवंप्रकारा बहवः समुत्पाता भयावहाः।\nरावणस्य विनाशाय दारुणाः सम्प्रजज्ञिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000513034, "chapter_id": 9513, "verse_number": "६-१०६-३४", "content_sanskrit": "रामस्यापि निमित्तानि सौम्यानि च शिवानि च।\nबभूवुर्जयशंसीनि प्रादुर्भूतानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000513035, "chapter_id": 9513, "verse_number": "६-१०६-३५", "content_sanskrit": "निमित्तानीह सौम्यानि राघवः स्वजयाय वै।\nदृष्ट्वा परमसंहृष्टो हतं मेने च रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000513036, "chapter_id": 9513, "verse_number": "६-१०६-३६", "content_sanskrit": "ततो निरीक्ष्यात्मगतानि राघवो\nरणे निमित्तानि निमित्तकोविदः।\nजगाम हर्षं च परां च निर्वृतिं\nचकार युद्धे ह्यधिकं च विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000513037, "chapter_id": 9513, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षडुत्तरशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]