[{"id": 6000306000, "chapter_id": 10306, "verse_number": null, "content_sanskrit": "पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000306001, "chapter_id": 10306, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.001.m4a", "display_order": 2}, {"id": 6000306002, "chapter_id": 10306, "verse_number": "११-५-१", "content_sanskrit": "भगवन्तं हरिं प्रायो न भजन्त्यात्मवित्तमाः।\nतेषामशान्तकामानां का निष्ठाऽविजितात्मनाम्॥ ११/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.002.m4a", "display_order": 3, "topics": [{"text": "चमसेन निमिं प्रति भगवद्भक्तिहीनानां निष्ठाकथनम्", "range": "१–१८"}]}, {"id": 6000306003, "chapter_id": 10306, "verse_number": null, "content_sanskrit": "चमस उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.003.m4a", "display_order": 4}, {"id": 6000306004, "chapter_id": 10306, "verse_number": "११-५-२", "content_sanskrit": "मुखबाहूरुपादेभ्यः पुरुषस्याश्रमैः सह।\nचत्वारो जज्ञिरे वर्णा गुणैर्विप्रादयः पृथक्॥ ११/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.004.m4a", "display_order": 5}, {"id": 6000306005, "chapter_id": 10306, "verse_number": "११-५-३", "content_sanskrit": "य एषां पुरुषं साक्षादात्मप्रभवमीश्वरम्।\nन भजन्त्यवजानन्ति स्थानभ्रष्टाः पतन्त्यधः॥ ११/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.005.m4a", "display_order": 6}, {"id": 6000306006, "chapter_id": 10306, "verse_number": "११-५-४", "content_sanskrit": "दूरे हरिकथाः केचिद् दूरे चाच्युतकीर्तनाः।\nस्‍त्रियः शूद्रादयश्चैव तेऽनुकम्प्या भवादृशाम्॥ ११/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.006.m4a", "display_order": 7}, {"id": 6000306007, "chapter_id": 10306, "verse_number": "११-५-५", "content_sanskrit": "विप्रो राजन्यवैश्यौ च हरेः प्राप्ताः पदान्तिकम्।\nश्रौतेन जन्मना वाऽपि मुह्यन्त्याम्नायवादिनः॥ ११/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.007.m4a", "display_order": 8}, {"id": 6000306008, "chapter_id": 10306, "verse_number": "११-५-६", "content_sanskrit": "कर्मण्यकोविदाः स्तब्धा मूर्खाः पण्डितमानिनः।\nवदन्ति चाटुकान् मूढा यया माध्व्या गिरोत्सुकाः॥ ११/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.008.m4a", "display_order": 9}, {"id": 6000306009, "chapter_id": 10306, "verse_number": "११-५-७", "content_sanskrit": "रजसा घोरसंकल्पाः कामुका अभिमन्यवः।\nदाम्भिका मानिनः पापा विहसन्त्यच्युतप्रियान्॥ ११/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.009.m4a", "display_order": 10}, {"id": 6000306010, "chapter_id": 10306, "verse_number": "११-५-८", "content_sanskrit": "वदन्ति तेऽन्योन्यमुपासितश्रियो गृहेषु मैथुन्यपरेषु चाशिषः।\nयजन्त्यसृष्टान्नविधानदक्षिणा वृत्त्यै परं घ्नन्ति पशूनतद्विदः॥ ११/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.010.m4a", "display_order": 11}, {"id": 6000306011, "chapter_id": 10306, "verse_number": "११-५-९", "content_sanskrit": "श्रिया विभूत्याऽभिजनेन विद्यया त्यागेन रूपेण बलेन कर्मणा।\nजातस्मयेनान्धधियः सहेश्वरान् सतोऽवमन्यन्ति हरिप्रियान् खलाः॥ ११/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.011.m4a", "display_order": 12}, {"id": 6000306012, "chapter_id": 10306, "verse_number": "११-५-१०", "content_sanskrit": "सर्वेषु शश्वत् तनुभृत्स्ववस्थितं यथा स्वमात्मानमभीष्टमीश्वरम्।\nवेदोपगीतं च न शृण्वतेऽबुधा मनोरथानां प्रवदन्ति वार्तया॥ ११/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.012.m4a", "display_order": 13}, {"id": 6000306013, "chapter_id": 10306, "verse_number": "११-५-११", "content_sanskrit": "लोके व्यवायामिषमद्यसेवा नित्यास्तु जन्तोर्न हि तत्र चोदना।\nव्यवस्थितिस्तेषु विहाय यज्ञान् सुराग्रहैरासुरवृत्तिरिष्टा॥ ११/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.013.m4a", "display_order": 14}, {"id": 6000306014, "chapter_id": 10306, "verse_number": "११-५-१२", "content_sanskrit": "धनं हि धर्मैकफलं यतोऽस्य ज्ञानं सविज्ञानमनुप्रशान्तिः।\nगृहेषु युञ्जन्ति कलेवरस्य मृत्युं न पश्यन्ति दुरन्तवीर्यम्॥ ११/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.014.m4a", "display_order": 15}, {"id": 6000306015, "chapter_id": 10306, "verse_number": "११-५-१३", "content_sanskrit": "यद् घ्राणभक्षो विहितः सुरायास्तथा पशोरालभनं न हिंसा।\nएवं व्यवायः प्रजया न रत्यै इमं विशुद्धं न विदुः स्वधर्मम्॥ ११/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.015.m4a", "display_order": 16}, {"id": 6000306016, "chapter_id": 10306, "verse_number": "११-५-१४", "content_sanskrit": "ये त्वनेवंविदोऽसन्तस्तथा सदभिमानिनः।\nपशून् द्रुह्यन्ति विस्रब्धान् प्रेत्य खादन्ति ते च तान्॥ ११/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.016.m4a", "display_order": 17}, {"id": 6000306017, "chapter_id": 10306, "verse_number": "११-५-१५", "content_sanskrit": "द्विषन्तः परकायेषु स्वात्मानं हरिमीश्वरम्।\nमृतके सानुबन्धेऽस्मिन् बद्धस्नेहाः पतन्त्यधः॥ ११/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.017.m4a", "display_order": 18}, {"id": 6000306018, "chapter_id": 10306, "verse_number": "११-५-१६", "content_sanskrit": "ये कैवल्यमसम्प्राप्ता ये चातीताश्च मूढताम्।\nत्रैवर्गिकाभिजन्मानमात्मानं पातयन्ति ते॥ ११/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.018.m4a", "display_order": 19}, {"id": 6000306019, "chapter_id": 10306, "verse_number": "११-५-१७", "content_sanskrit": "ये तत्रात्महनोऽशान्ता अज्ञाने ज्ञानमानिनः।\nसीदन्त्यकृतकृत्या वै कालध्वस्तमनोरथाः॥ ११/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.019.m4a", "display_order": 20}, {"id": 6000306020, "chapter_id": 10306, "verse_number": "११-५-१८", "content_sanskrit": "हित्वाऽत्यायासरचितगृहापत्यसुहृच्छ्रियः।\nतमो विशन्त्यनुच्छ्वासं वासुदेवपराङ्मुखाः॥ ११/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.020.m4a", "display_order": 21}, {"id": 6000306021, "chapter_id": 10306, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.021.m4a", "display_order": 22}, {"id": 6000306022, "chapter_id": 10306, "verse_number": "११-५-१९", "content_sanskrit": "कस्मिन् काले स भगवान् किंवर्णः कीदृशो नृभिः।\nनाम्ना वा केन विधिना पूज्यते तदिहोच्यताम्॥ ११/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.022.m4a", "display_order": 23, "topics": [{"text": "करभाजनेन प्रतियुगं भगवत्पूजाविधिकथनम्", "range": "१९–४३"}]}, {"id": 6000306023, "chapter_id": 10306, "verse_number": null, "content_sanskrit": "करभाजन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.023.m4a", "display_order": 24}, {"id": 6000306024, "chapter_id": 10306, "verse_number": "११-५-२०", "content_sanskrit": "कृतं त्रेता द्वापरं च कलिरित्येषु केशवः।\nनानावर्णाभिधाकारो नानैव विधिनेज्यते॥ ११/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.024.m4a", "display_order": 25}, {"id": 6000306025, "chapter_id": 10306, "verse_number": "११-५-२१", "content_sanskrit": "कृते शुक्लश्चतुर्बाहुर्जटिलो वल्कलाम्बरः।\nकृष्णाजिनोपवीताक्षान् बिभ्रद् दण्डकमण्डलू॥ ११/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.025.m4a", "display_order": 26}, {"id": 6000306026, "chapter_id": 10306, "verse_number": "११-५-२२", "content_sanskrit": "मनुष्यास्तु तदा शान्ता निर्वैराः सुहृदः समाः।\nयजन्ति तपसा देवं शमेन च दमेन च॥ ११/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.026.m4a", "display_order": 27}, {"id": 6000306027, "chapter_id": 10306, "verse_number": "११-५-२३", "content_sanskrit": "हंसः सुपर्णो वैकुण्ठो धर्मो योगेश्वरोऽमलः।\nईश्वरः पुरुषोऽव्यक्तः परमात्मेति गीयते॥ ११/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.027.m4a", "display_order": 28}, {"id": 6000306028, "chapter_id": 10306, "verse_number": "११-५-२४", "content_sanskrit": "त्रेतायां रक्तवर्णोऽसौ चतुर्बाहुस्‍त्रिमेखलः।\nहिरण्यकेशस्‍त्रय्यात्मा स्रुक्स्रुवाद्युपलक्षणः॥ ११/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.028.m4a", "display_order": 29}, {"id": 6000306029, "chapter_id": 10306, "verse_number": "११-५-२५", "content_sanskrit": "तं तदा मनुजा देवं सर्वदेवमयं हरिम्।\nयजन्ति विद्यया त्रय्या धर्मिष्ठा ब्रह्मवादिनः॥ ११/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.029.m4a", "display_order": 30}, {"id": 6000306030, "chapter_id": 10306, "verse_number": "११-५-२६", "content_sanskrit": "विष्णुर्यज्ञः पृश्निगर्भः सर्वदेव उरुक्रमः।\nवृषाकपिर्जयन्तश्च उरुगाय इतीर्यते॥ ११/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.030.m4a", "display_order": 31}, {"id": 6000306031, "chapter_id": 10306, "verse_number": "११-५-२७", "content_sanskrit": "द्वापरे भगवान् श्यामः पीतवासा निजायुधः।\nश्रीवत्सादिभिरङ्कैश्च लक्षणैरुपलक्षितः॥ ११/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.031.m4a", "display_order": 32}, {"id": 6000306032, "chapter_id": 10306, "verse_number": "११-५-२८", "content_sanskrit": "तं तथा पुरुषं मर्त्या महाराजोपलक्षणम्।\nयजन्ति वेदतन्त्राभ्यां परं जिज्ञासवो नृप॥ ११/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.032.m4a", "display_order": 33}, {"id": 6000306033, "chapter_id": 10306, "verse_number": "११-५-२९", "content_sanskrit": "नमस्ते वासुदेवाय नमः सङ्कर्षणाय च।\nप्रद्युम्नायानिरुद्धाय तुभ्यं भगवते नमः॥ ११/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.033.m4a", "display_order": 34}, {"id": 6000306034, "chapter_id": 10306, "verse_number": "११-५-३०", "content_sanskrit": "नारायणाय ऋषये पुरुषाय महात्मने।\nविश्वेश्वराय रामाय सर्वभूतात्मने नमः॥ ११/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.034.m4a", "display_order": 35}, {"id": 6000306035, "chapter_id": 10306, "verse_number": "११-५-३१", "content_sanskrit": "इति द्वापर उर्वीश स्तुवन्ति जगदीश्वरम्।\nनानातन्त्रविधानेन कलावपि यथा शृणु॥ ११/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.035.m4a", "display_order": 36}, {"id": 6000306036, "chapter_id": 10306, "verse_number": "११-५-३२", "content_sanskrit": "कृष्णवर्णं कलौ कृष्णं साङ्गोपाङ्गं सपार्षदम्।\nयज्ञैः संकीर्तनप्रायैर्यजन्ति हि सुमेधसः॥ ११/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.036.m4a", "display_order": 37}, {"id": 6000306037, "chapter_id": 10306, "verse_number": "११-५-३३", "content_sanskrit": "ध्येयं सदा परिभवघ्नमभीष्टदोहं तीर्थास्पदं शिवविरिञ्चिनुतं शरण्यम्।\nभृत्यार्तिहं प्रणतपालभवाब्धिपोतं वन्दामहे पुरुष ते चरणारविन्दम्॥ ११/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.037.m4a", "display_order": 38}, {"id": 6000306038, "chapter_id": 10306, "verse_number": "११-५-३४", "content_sanskrit": "त्यक्त्वा सुदुस्त्यजसुरेप्सितराज्यलक्ष्मीं धर्मिष्ठ आर्यवचसा यदगादरण्यम्।\nमायामृगं दयितयेप्सितमन्वधावद् वन्दामहे पुरुष ते चरणारविन्दम्॥ ११/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.038.m4a", "display_order": 39}, {"id": 6000306039, "chapter_id": 10306, "verse_number": "११-५-३५", "content_sanskrit": "एवं युगानुरूपोऽसौ भगवान् युगवर्तिभिः।\nमनुजैरिज्यते राजन् श्रेयसामीश्वरो हरिः॥ ११/५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.039.m4a", "display_order": 40}, {"id": 6000306040, "chapter_id": 10306, "verse_number": "११-५-३६", "content_sanskrit": "कलिं सम्भाजयन्त्यार्या गुणज्ञाः सारभागिनः।\nतत्र सङ्कीर्तनादेव सर्वः स्वार्थोऽभिलभ्यते॥ ११/५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.040.m4a", "display_order": 41}, {"id": 6000306041, "chapter_id": 10306, "verse_number": "११-५-३७", "content_sanskrit": "न ह्यतःपरमो लाभो देहिनां भ्राम्यतामिह।\nयतो विन्देत परमां शान्तिं नश्येत संसृतिः॥ ११/५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.041.m4a", "display_order": 42}, {"id": 6000306042, "chapter_id": 10306, "verse_number": "११-५-३८", "content_sanskrit": "कृतादिषु प्रजा राजन् कलाविच्छन्ति सम्भवम्।\nयत्र संकीर्तनान्नॄणां हरिर्दास्यत्यसम्भवम्॥ ११/५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.042.m4a", "display_order": 43}, {"id": 6000306043, "chapter_id": 10306, "verse_number": "११-५-३९", "content_sanskrit": "कलौ तथा भविष्यन्ति नारायणपरायणाः।\nक्‍वचित् क्‍वचिन्महाराज द्रुमिलेषु च भूयशः॥ ११/५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.043.m4a", "display_order": 44}, {"id": 6000306044, "chapter_id": 10306, "verse_number": "११-५-४०", "content_sanskrit": "ताम्रपर्णी नदी यत्र कृतमाला पयस्विनी।\nकावेरी च महापुण्या प्रतीची च महानदी॥ ११/५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.044.m4a", "display_order": 45}, {"id": 6000306045, "chapter_id": 10306, "verse_number": null, "content_sanskrit": "ये पिबन्ति जलं तासां मनुजा मनुजेश्वर।\nप्रायो भक्ता भगवति वासुदेवेऽमलाशयाः॥ ११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.045.m4a", "display_order": 46}, {"id": 6000306046, "chapter_id": 10306, "verse_number": "११-५-४१", "content_sanskrit": "देवर्षिभूताप्तनृणां पूजाकरा नृप॥ ११/५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.046.m4a", "display_order": 47}, {"id": 6000306047, "chapter_id": 10306, "verse_number": "११-५-४२", "content_sanskrit": "देवर्षिभूताप्तनृणां पितॄणां न किङ्करो नायमृणी च राजन्।\nसर्वात्मना यः शरणं शरण्यं गतो मुकुन्दं परिचर्यया च॥ ११/५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.047.m4a", "display_order": 48}, {"id": 6000306048, "chapter_id": 10306, "verse_number": "११-५-४३", "content_sanskrit": "स्वपादमूलं भजतः प्रियस्य त्यक्तान्यभावस्य हरिः परेशः।\nविकर्म यच्चोत्पतितं कथञ्चिद् धुनोति सर्वं हृदि सन्निविष्टः॥ ११/५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.048.m4a", "display_order": 49}, {"id": 6000306049, "chapter_id": 10306, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.049.m4a", "display_order": 50}, {"id": 6000306050, "chapter_id": 10306, "verse_number": "११-५-४४", "content_sanskrit": "धर्मान् भागवतानित्थं श्रुत्वा स मिथिलेश्वरः।\nजायन्तेयान् मुनीन् प्रीतः सोपाध्यायो ह्यपूजयत्॥ ११/५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.050.m4a", "display_order": 51, "topics": [{"text": "नारदेन वसुदेवं प्रति उपदेशोपसंहारः", "range": "४४–५३"}]}, {"id": 6000306051, "chapter_id": 10306, "verse_number": "११-५-४५", "content_sanskrit": "ते चान्तर्दधिरे सिद्धाः सर्वलोकस्य पश्यतः।\nराजा धर्मानुपातिष्ठन्नवाप परमां गतिम्॥ ११/५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.051.m4a", "display_order": 52}, {"id": 6000306052, "chapter_id": 10306, "verse_number": "११-५-४६", "content_sanskrit": "त्वमप्येतान् महाभाग धर्मान्भागवतान् श्रुतान्।\nआस्थितः श्रद्धया युक्तो निःसङ्गो यास्यसे परम्॥ ११/५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.052.m4a", "display_order": 53}, {"id": 6000306053, "chapter_id": 10306, "verse_number": "११-५-४७", "content_sanskrit": "युवयोः खलु दम्पत्योर्यशसा पूरितं जगत्।\nपुत्रतामगमद् यद् वां भगवानीश्वरो हरिः॥ ११/५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.053.m4a", "display_order": 54}, {"id": 6000306054, "chapter_id": 10306, "verse_number": "११-५-४८", "content_sanskrit": "दर्शनालिङ्गनालापैः सशय्यासनभोजनैः।\nआत्मा वां पावितः कृष्णे पुत्रस्नेहं प्रकुर्वतोः॥ ११/५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.054.m4a", "display_order": 55}, {"id": 6000306055, "chapter_id": 10306, "verse_number": "११-५-४९", "content_sanskrit": "वैरेण यं नृपतयः शिशुपालपौण्ड्रसाल्वादयो गतिविलासविलोकनाद्यैः।\nध्यायन्त आकृतधियः शयनासनादौ तत्साम्यमापुरनुरक्तधियः पुनः किम्॥ ११/५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.055.m4a", "display_order": 56}, {"id": 6000306056, "chapter_id": 10306, "verse_number": "११-५-५०", "content_sanskrit": "माऽपत्यबुद्धिमकृथाः कृष्णे सर्वात्मनीश्वरे।\nमायामनुष्यभावेन गूढैश्वर्ये परेऽव्यये॥ ११/५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.056.m4a", "display_order": 57}, {"id": 6000306057, "chapter_id": 10306, "verse_number": "११-५-५१", "content_sanskrit": "भूभारासुरराजन्यहन्तवे गुप्तये सताम्।\nअवतीर्णोऽस्य निर्वृत्त्यै यशो लोके वितन्वति॥ ११/५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.057.m4a", "display_order": 58}, {"id": 6000306058, "chapter_id": 10306, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.058.m4a", "display_order": 59}, {"id": 6000306059, "chapter_id": 10306, "verse_number": "११-५-५२", "content_sanskrit": "एतच्छ्रुत्वा महाभागो वसुदेवोऽतिविस्मितः।\nदेवकी च महाभागा जहतुर्मोहमात्मनः॥ ११/५/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.059.m4a", "display_order": 60}, {"id": 6000306060, "chapter_id": 10306, "verse_number": "११-५-५३", "content_sanskrit": "इतिहासमिमं पुण्यं धारयेद् यः समाहितः।\nस विधूयेह शमलं ब्रह्मभूयाय कल्पते॥ ११/५/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_005/BhP_11.005.060.m4a", "display_order": 61}, {"id": 6000306061, "chapter_id": 10306, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]