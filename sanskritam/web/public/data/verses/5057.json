[{"id": 2190651, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190652, "chapter_id": 5057, "verse_number": "१", "content_sanskrit": "धर्ममर्थं च कामं च वेदाः शंसन्ति भारत ।\nकस्य लाभो विशिष्टोऽत्र तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190653, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190654, "chapter_id": 5057, "verse_number": "२", "content_sanskrit": "अत्र ते वर्तयिष्यामि इतिहासं पुरातनम् ।\nकुण्डधारेण यत् प्रीत्या भक्तायोपकृतं पुरा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190655, "chapter_id": 5057, "verse_number": "३", "content_sanskrit": "अधनो ब्राह्मणः कश्चित् कामाद्धर्ममवैक्षत ।\nयज्ञार्थं स ततोऽर्थार्थी तपोऽतप्यत दारुणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190656, "chapter_id": 5057, "verse_number": "४", "content_sanskrit": "स निश्चयमथो कृत्वा पूजयामास देवताः ।\nभक्त्या न चैवाध्यगच्छद्धनं सम्पूज्य देवताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190657, "chapter_id": 5057, "verse_number": "५", "content_sanskrit": "ततश्चिन्तां पुनः प्राप्तः कतमद् दैवतं नु तत् ।\nयन्मे द्रुतं प्रसीदेत मानुषैरजडीकृतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190658, "chapter_id": 5057, "verse_number": "६", "content_sanskrit": "अथ सौम्येन वपुषा देवानुचरमन्तिके ।\nप्रत्यपश्यज्जलधरं कुण्डधारमवस्थितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190659, "chapter_id": 5057, "verse_number": "७", "content_sanskrit": "दृष्ट्वैव तं महात्मानं तस्य भक्तिरजायत ।\nअयं मे धास्यति श्रेयो वपुरेतद्धि तादृशम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190660, "chapter_id": 5057, "verse_number": "८", "content_sanskrit": "सन्निकृष्टश्च देवस्य न चान्यैर्मानुषैर्वृतः ।\nएष मे दास्यति धनं प्रभूतं शीघ्रमेव च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190661, "chapter_id": 5057, "verse_number": "९", "content_sanskrit": "ततो धूपैश्च गन्धैश्च माल्यैरुच्चावचैरपि ।\nबलिभिर्विविधैश्चापि पूजयामास तं द्विजः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190662, "chapter_id": 5057, "verse_number": "१०", "content_sanskrit": "ततः स्वल्पेन कालेन तुष्टो जलधरस्तदा ।\nतस्योपकारे नियतामिमां वाचमुवाच ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190663, "chapter_id": 5057, "verse_number": "११", "content_sanskrit": "ब्रह्मघ्ने च सुरापे च चोरे भग्नव्रते तथा ।\nनिष्कृतिर्विहिता सद्भिः कृतघ्ने नास्ति निष्कृतिः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190664, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "आशायास्तनयोऽधर्मः क्रोधोऽसूयासुतः स्मृतः ।\nपुत्रो लोभो निकृत्यास्तु कृतघ्नो नार्हति प्रजाम्\t॥१२ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190665, "chapter_id": 5057, "verse_number": "१३", "content_sanskrit": "ततः स ब्राह्मणः स्वप्ने कुण्डधारस्य तेजसा ।\nअपश्यत् सर्वभूतानि कुशेषु शयितस्तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190666, "chapter_id": 5057, "verse_number": "१४", "content_sanskrit": "शमेन तपसा चैव भक्त्या च निरुपस्कृतः ।\nशुद्धात्मा ब्राह्मणो रात्रौ निदर्शनमपश्यत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190667, "chapter_id": 5057, "verse_number": "१५", "content_sanskrit": "मणिभद्रं स तत्रस्थं देवतानां महाद्युतिम् ।\nअपश्यत महात्मानं व्यादिशन्तं युधिष्ठिर\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190668, "chapter_id": 5057, "verse_number": "१६", "content_sanskrit": "तत्र देवाः प्रयच्छन्ति राज्यानि च धनानि च ।\nशुभैः कर्मभिरारब्धाः प्रच्छिदन्त्यशुभेषु च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190669, "chapter_id": 5057, "verse_number": "१७", "content_sanskrit": "पश्यतामथ यक्षाणां कुण्डधारो महाद्युतिः ।\nनिष्पत्य पतितो भूमौ देवानां भरतर्षभ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190670, "chapter_id": 5057, "verse_number": "१८", "content_sanskrit": "ततस्तु देववचनान्मणिभद्रो महायशाः ।\nउवाच पतितं भूमौ कुण्डधार किमिष्यते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190671, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "कुण्डधारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190672, "chapter_id": 5057, "verse_number": "१९", "content_sanskrit": "यदि प्रसन्ना देवा मे भक्तोऽयं ब्राह्मणो मम ।\nअस्यानुग्रहमिच्छामि कृतं किञ्चित् सुखोदयम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2190673, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2190674, "chapter_id": 5057, "verse_number": "२०", "content_sanskrit": "ततस्तं मणिभद्रस्तु पुनर्वचनमब्रवीत् ।\nदेवानामेव वचनात्कुण्डधारं महाद्युतिम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2190675, "chapter_id": 5057, "verse_number": "२१", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ भद्रं ते कृतकार्यः सुखी भव ।\nयावद्धनं प्रार्थयते ब्राह्मणोऽयं सखा तव॥\nदेवानां शासनात्तावदसङ्ख्येयं ददाम्यहम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2190676, "chapter_id": 5057, "verse_number": "२२", "content_sanskrit": "विचार्य कुण्डधारस्तु मानुष्यं चलमध्रुवम् ।\nतपसे मतिमाधत्त ब्राह्मणस्य यशस्विनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2190677, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "कुण्डधारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2190678, "chapter_id": 5057, "verse_number": "२३", "content_sanskrit": "नाहं धनानि याचामि ब्राह्मणाय धनप्रद ।\nअन्यमेवाहमिच्छामि भक्तायानुग्रहं कृतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2190679, "chapter_id": 5057, "verse_number": "२४", "content_sanskrit": "पृथिवीं रत्नपूर्णां वा महद्वा धनसञ्चयम् ।\nभक्ताय नाहमिच्छामि भवेदेष तु धार्मिकः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2190680, "chapter_id": 5057, "verse_number": "२५", "content_sanskrit": "धर्मेऽस्य रमतां बुद्धिर्धर्मं चैवोपजीवतु ।\nधर्मप्रधानो भवतु ममैषोऽनुग्रहो मतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2190681, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "मणिभद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2190682, "chapter_id": 5057, "verse_number": "२६", "content_sanskrit": "यदा धर्मफलं राज्यं सुखानि विविधानि च ।\nफलान्येवायमश्नातु कायक्लेशविवर्जितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2190683, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2190684, "chapter_id": 5057, "verse_number": "२७", "content_sanskrit": "ततस्तदेव बहुशः कुण्डधारो महायशाः ।\nअभ्यासमकरोद्धर्मे ततस्तुष्टास्य देवताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2190685, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "मणिभद्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2190686, "chapter_id": 5057, "verse_number": "२८", "content_sanskrit": "प्रीतास्ते देवताः सर्वा द्विजस्यास्य तथैव च ।\nभविष्यत्येष धर्मात्मा धर्मे चाधास्यते मतिः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2190687, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2190688, "chapter_id": 5057, "verse_number": "२९", "content_sanskrit": "ततः प्रीतो जलधरः कृतकार्यो युधिष्ठिर ।\nईप्सितं मनसो लब्ध्वा वरमन्यैः सुदुर्लभम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2190689, "chapter_id": 5057, "verse_number": "३०", "content_sanskrit": "ततोऽपश्यत चीराणि सूक्ष्माणि द्विजसत्तमः ।\nपार्श्वतोऽभ्यागतो न्यस्तान्यथ निर्वेदमागतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2190690, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2190691, "chapter_id": 5057, "verse_number": "३१", "content_sanskrit": "अयं न सुकृतं वेत्ति को न्वन्यो वेत्स्यते कृतम् ।\nगच्छामि वनमेवाहं वरं धर्मेण जीवितुम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2190692, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2190693, "chapter_id": 5057, "verse_number": "३२", "content_sanskrit": "निर्वेदाद् देवतानां च प्रसादात् स द्विजोत्तमः ।\nवनं प्रविश्य सुमहत्तप आरब्धवांस्तदा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2190694, "chapter_id": 5057, "verse_number": "३३", "content_sanskrit": "देवतातिथिशेषेण फलमूलाशनो द्विजः ।\nधर्मे चापि महाराज रतिरस्याभ्यजायत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2190695, "chapter_id": 5057, "verse_number": "३४", "content_sanskrit": "त्यक्त्वा मूलफलं सर्वं पर्णाहारोऽभवद् द्विजः ।\nपर्णं त्यक्त्वा जलाहारस्तदासीद् द्विजसत्तमः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2190696, "chapter_id": 5057, "verse_number": "३५", "content_sanskrit": "वायुभक्षस्ततः पश्चाद् बहून् वर्षगणानभूत् ।\nन चास्य क्षीयते प्राणस्तदद्भुतमिवाभवत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2190697, "chapter_id": 5057, "verse_number": "३६", "content_sanskrit": "धर्मे च श्रद्दधानस्य तपस्युग्रे च वर्ततः ।\nकालेन महता तस्य दिव्या दृष्टिरजायत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2190698, "chapter_id": 5057, "verse_number": "३७", "content_sanskrit": "तस्य बुद्धिः प्रादुरासीद् यदि दद्यां महद्धनम् ।\nतुष्टः कस्मैचिदेवाहं न मिथ्या वाग् भवेन्मम\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2190699, "chapter_id": 5057, "verse_number": "३८", "content_sanskrit": "ततः प्रहृष्टवदनो भूय आरब्धवांस्तपः ।\nभूयश्चाचिन्तयत् सिद्धो यत् परं सोऽभ्यपद्यत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2190700, "chapter_id": 5057, "verse_number": "३९", "content_sanskrit": "यदि दद्यामहं राज्यं तुष्टो वै यस्य कस्यचित् ।\nस भवेदचिराद्राजा न मिथ्या वाग्भवेन्मम\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2190701, "chapter_id": 5057, "verse_number": "४०", "content_sanskrit": "तस्य साक्षात् कुण्डधारो दर्शयामास भारत ।\nब्राह्मणस्य तपोयोगात् सौहृदेनाभिचोदितः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2190702, "chapter_id": 5057, "verse_number": "४१", "content_sanskrit": "समागम्य स तेनाथ पूजां चक्रे यथाविधि ।\nब्राह्मणः कुण्डधारस्य विस्मितश्चाभवन्नृप\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2190703, "chapter_id": 5057, "verse_number": "४२", "content_sanskrit": "ततोऽब्रवीत्कुण्डधारो दिव्यं ते चक्षुरुत्तमम् ।\nपश्य राज्ञां गतिं विप्र लोकांश्चावेक्ष चक्षुषा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2190704, "chapter_id": 5057, "verse_number": "४३", "content_sanskrit": "ततो राज्ञां सहस्राणि मग्नानि निरये तदा ।\nदूरादपश्यद् विप्रः स दिव्ययुक्तेन चक्षुषा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2190705, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "कुण्डधारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2190706, "chapter_id": 5057, "verse_number": "४४", "content_sanskrit": "मां पूजयित्वा भावेन यदि त्वं दुःखमाप्नुयाः ।\nकृतं मया भवेत् किं ते कश्च तेऽनुग्रहो भवेत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2190707, "chapter_id": 5057, "verse_number": "४५", "content_sanskrit": "पश्य पश्य च भूयस्त्वं कामानिच्छेत् कथं नरः ।\nस्वर्गद्वारं हि संरुद्धं मानुषेषु विशेषतः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2190708, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2190709, "chapter_id": 5057, "verse_number": "४६", "content_sanskrit": "ततोऽपश्यत् स कामं च क्रोधं लोभं भयं मदम् ।\nनिद्रां तन्द्रीं तथालस्यमावृत्य पुरुषान् स्थितान्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2190710, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "कुण्डधारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2190711, "chapter_id": 5057, "verse_number": "४७", "content_sanskrit": "एतैर्लोकाः सुसंरुद्धा देवानां मानुषाद् भयम् ।\nतथैव देववचनाद् विघ्नं कुर्वन्ति सर्वशः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2190712, "chapter_id": 5057, "verse_number": "४८", "content_sanskrit": "न देवैरननुज्ञातः कश्चिद् भवति धार्मिकः ।\nएष शक्तोऽसि तपसा राज्यं दातुं धनानि च\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2190713, "chapter_id": 5057, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2190714, "chapter_id": 5057, "verse_number": "४९", "content_sanskrit": "ततः पपात शिरसा ब्राह्मणस्तोयधारिणे ।\nउवाच चैनं धर्मात्मा महान् मेऽनुग्रहः कृतः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2190715, "chapter_id": 5057, "verse_number": "५०", "content_sanskrit": "कामलोभानुबन्धेन पुरा ते यदसूयितम् ।\nमया स्नेहमविज्ञाय तत्र मे क्षन्तुमर्हसि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2190716, "chapter_id": 5057, "verse_number": "५१", "content_sanskrit": "क्षान्तमेव मयेत्युक्त्वा कुण्डधारो द्विजर्षभम् ।\nसम्परिष्वज्य बाहुभ्यां तत्रैवान्तरधीयत\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2190717, "chapter_id": 5057, "verse_number": "५२", "content_sanskrit": "ततः सर्वानिमाँल्लोकान् ब्राह्मणोऽनुचचार ह ।\nकुण्डधारप्रसादेन तपसा योजितः पुरा\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2190718, "chapter_id": 5057, "verse_number": "५३", "content_sanskrit": "विहायसा च गमनं तथा सङ्कल्पितार्थता ।\nधर्माच्छक्त्या तथा योगाद्या चैव परमा गतिः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2190719, "chapter_id": 5057, "verse_number": "५४", "content_sanskrit": "देवता ब्राह्मणाः सन्तो यक्षा मानुषचारणाः ।\nधार्मिकान् पूजयन्तीह न धनाढ्यान्न कामिनः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2190720, "chapter_id": 5057, "verse_number": "५५", "content_sanskrit": "सुप्रसन्ना हि ते देवा यत्ते धर्मे रता मतिः ।\nधने सुखकला काचिद्धर्मे तु परमं सुखम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2190721, "chapter_id": 5057, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे कुण्डधाराख्याने षडधिकशततमोऽध्यायः ॥१०६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]