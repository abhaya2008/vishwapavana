[{"id": 2210147, "chapter_id": 5496, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210148, "chapter_id": 5496, "verse_number": "१", "content_sanskrit": "स प्रविश्य यथान्यायं पाण्डवानां निवेशनम् ।\nपितामहीमभ्यवदत् साम्ना परमवल्गुना ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210149, "chapter_id": 5496, "verse_number": "२", "content_sanskrit": "तथा चित्राङ्गदा देवी कौरवस्यात्मजाऽपि च ।\nपृथां कृष्णां च सहिते विनयेनाभिजग्मतुः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210150, "chapter_id": 5496, "verse_number": "३", "content_sanskrit": "सुभद्रां च यथान्यायं याश्चान्याः कुरुयोषितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210151, "chapter_id": 5496, "verse_number": "४", "content_sanskrit": "ददौ कुन्ती ततस्ताभ्यां रत्नानि विविधानि च ।\nद्रौपदी च सुभद्रा च याश्चाप्यन्याः कुरुस्त्रियः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210152, "chapter_id": 5496, "verse_number": "५", "content_sanskrit": "ऊषतुस्तत्र ते देव्यौ महार्हशयनासने ।\nसुपूजिते स्वयं कुन्त्या पार्थस्य प्रियकाम्यया ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210153, "chapter_id": 5496, "verse_number": "६", "content_sanskrit": "स च राजा महावीर्यः पूजितो बभ्रुवाहनः ।\nधृतराष्ट्रं महीपालमुपतस्थे यथाविधि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210154, "chapter_id": 5496, "verse_number": "७", "content_sanskrit": "युधिष्ठिरं च राजानं भीमादींश्चापि पाण्डवान् ।\nउपगम्य महातेजा विनयेनाभ्यवादयत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210155, "chapter_id": 5496, "verse_number": "८", "content_sanskrit": "स तैः प्रेम्णा परिष्वक्तः पूजितश्च यथाविधि ।\nधनं चास्मै ददुर्भूरि प्रीयमाणा महारथाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210156, "chapter_id": 5496, "verse_number": "९", "content_sanskrit": "तथैव स महीपालः कृष्णं चक्रगदाधरम् ।\nप्रद्युम्नवद् हृषीकेशं विनयेनोपजग्मिवान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210157, "chapter_id": 5496, "verse_number": "१०", "content_sanskrit": "तस्मै कृष्णो ददौ राज्ञे राजार्हमभिपूजितम् ।\nरथं हेमपरिष्कारं दिव्याश्वयुजमुत्तमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210158, "chapter_id": 5496, "verse_number": "११", "content_sanskrit": "धर्मराजश्च भीमश्च यमजौ फल्गुनस्तथा ।\nपृथक् पृथगथैवैनं महार्थैरभ्यपूजयन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210159, "chapter_id": 5496, "verse_number": "१२", "content_sanskrit": "ततस्तृतीये दिवसे सत्यवत्याः सुतो मुनिः ।\nयुधिष्ठिरं समानीय वाग्मी वचनमब्रवीत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210160, "chapter_id": 5496, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210161, "chapter_id": 5496, "verse_number": "१३", "content_sanskrit": "अद्यप्रभृति कौन्तेय यज्ञस्य समयो हि ते ।\nमुहूर्तो याज्ञियः प्राप्तः चोदयन्त्येव याजकाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210162, "chapter_id": 5496, "verse_number": "१४", "content_sanskrit": "अहीनो नाम राजेन्द्र क्रतुस्तेऽयं विकल्पवान् ।\nबहुत्वात् काञ्चनस्यास्य ख्यातो बहुसुवर्णकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210163, "chapter_id": 5496, "verse_number": "१५", "content_sanskrit": "एवमेव महाराज दक्षिणां त्रिगुणां कुरु ।\nत्रित्वं व्रजतु ते राजन् ब्राह्मणा ह्यत्र कारणम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210164, "chapter_id": 5496, "verse_number": "१६", "content_sanskrit": "त्रीनश्वमेधानत्र त्वं सम्प्राप्य बहुदक्षिणान् ।\nज्ञातिहत्याकृतं पापं प्रहास्यसि नराधिप ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210165, "chapter_id": 5496, "verse_number": "१७", "content_sanskrit": "पवित्रं परमं ह्येतत् पावनानां च पावनम् ।\nयदश्वमेधावभृथं प्राप्स्यसे कुरुनन्दन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210166, "chapter_id": 5496, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210167, "chapter_id": 5496, "verse_number": "१८", "content_sanskrit": "इत्युक्तः स तु तेजस्वी व्यासेनामितबुद्धिना ।\nदीक्षां विवेश धर्मात्मा वाजिमेधाप्तये तदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210168, "chapter_id": 5496, "verse_number": "१९", "content_sanskrit": "नराधिपः प्रायजत वाजिमेधं महाक्रतुम् ।\nविधिवद् दक्षिणं राजा सर्वयज्ञगुणान्वितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210169, "chapter_id": 5496, "verse_number": "२०", "content_sanskrit": "तत्र वेदविदो राजन् चक्रुः कर्माणि याजकाः ।\nपरिक्रामन्ति शास्त्रज्ञा यथावद् द्विजसत्तमाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210170, "chapter_id": 5496, "verse_number": "२१", "content_sanskrit": "न तेषां स्खलितं तत्र नासीदपहुतं तदा ।\nक्रमयुक्तं च युक्तं च चक्रुस्तत्र द्विजर्षभाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210171, "chapter_id": 5496, "verse_number": "२२", "content_sanskrit": "कृत्वा प्रवर्ग्यं धर्मज्ञा यथावद् द्विजसत्तमाः ।\nचक्रुस्ते विधिवद् राजन् तथैवाभिषवं द्विजाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210172, "chapter_id": 5496, "verse_number": "२३", "content_sanskrit": "अभिषूय ततो राजन् सोमं सोमपसत्तमाः ।\nसवनान्यानुपूर्व्येण चक्रुः शास्त्रानुसारिणः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210173, "chapter_id": 5496, "verse_number": "२४", "content_sanskrit": "न तत्र कृपणः कश्चिन्न दरिद्रो बभूव ह ।\nक्षुधितो दुःखितो वाऽपि प्राकृतो वाऽपि मानवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210174, "chapter_id": 5496, "verse_number": "२५", "content_sanskrit": "भोजनं भोजनार्थिभ्यो दापयामास सर्वदा ।\nभीमसेनो महातेजाः सततं राजशासनात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210175, "chapter_id": 5496, "verse_number": "२६", "content_sanskrit": "संस्तरे कुशलाश्चापि सर्वकर्माणि याजकाः ।\nदिवसे दिवसे चक्रुर्यथाशास्त्रार्थचक्षुषः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210176, "chapter_id": 5496, "verse_number": "२७", "content_sanskrit": "नाषडङ्गविदत्रासीत् सदस्यो नाबहुश्रुतः ।\nनाव्रतो नानुपाध्यायो न च वादाक्षमो द्विजः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210177, "chapter_id": 5496, "verse_number": "२८", "content_sanskrit": "यूपोच्छ्रये ततः प्राप्ते षड् बैल्वान् भरतर्षभ ।\nखादिरान् बिल्वसहितान् तावतः सर्ववर्णिनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210178, "chapter_id": 5496, "verse_number": "२९", "content_sanskrit": "देवदारुमयौ द्वौ तु यूपौ कुरुपतेः क्रतौ ।\nश्लेष्मात्मकमयं चैकं याजकाः समकारयन् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210179, "chapter_id": 5496, "verse_number": "३०", "content_sanskrit": "सर्वानेतान् यथाशास्त्रं याजकाः समयोजयन् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210180, "chapter_id": 5496, "verse_number": "३१", "content_sanskrit": "शोभार्थं चापरान् यूपान् काञ्चनान् भरतर्षभ ।\nस भीमः कारयामास धर्मराजस्य शासनात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210181, "chapter_id": 5496, "verse_number": "३२", "content_sanskrit": "ते व्यराजन्त राजर्षेर्वासोभिरुपशोभिताः ।\nनरेन्द्राभिगता देवैर्यथा सप्तर्षयो दिवि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210182, "chapter_id": 5496, "verse_number": "३३", "content_sanskrit": "इष्टकाः काञ्चनाश्चात्र चयनार्थं कृता भवन् ।\nशुशुभे चयनं तस्य दक्षस्येव प्रजापतेः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210183, "chapter_id": 5496, "verse_number": "३४", "content_sanskrit": "चतुश्चैत्यः स तस्यासीदष्टादशकरात्मकः ।\nस रुग्मपक्षो निचितस्त्रिगुणो गरुडाकृतिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210184, "chapter_id": 5496, "verse_number": "३५", "content_sanskrit": "ततो नियुक्ताः पशवो यथाशास्त्रं मनीषिभिः ।\nतं तं देवं समुद्दिश्य पक्षिणः पशवश्च ये ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210185, "chapter_id": 5496, "verse_number": "३६", "content_sanskrit": "ऋषभाः शास्त्रपठितास्तथा जलचराश्च ये ।\nसर्वांस्तानभ्ययुञ्जंस्ते तत्राग्निचयकर्मणि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210186, "chapter_id": 5496, "verse_number": "३७", "content_sanskrit": "यूपेषु नियतं चासीत् पशूनां त्रिशतं तथा ।\nअश्वरत्नोत्तमं राज्ञः कौन्तेयस्य महात्मनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210187, "chapter_id": 5496, "verse_number": "३८", "content_sanskrit": "स यज्ञः शुशुभे तस्य साक्षाद् देवर्षिसङ्कुलः ।\nगन्धर्वगणसङ्कीर्णः शोभितोऽप्सरसां गणैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210188, "chapter_id": 5496, "verse_number": "३९", "content_sanskrit": "स किम्पुरुषगीतैश्च किन्नरैरुपशोभितः ।\nसिद्धविप्रनिवासैश्च समन्तादभिशोभितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210189, "chapter_id": 5496, "verse_number": "४०", "content_sanskrit": "तस्मिन् सदसि नित्यास्तु व्यासशिष्या द्विजोत्तमाः ।\nसर्वशास्त्रप्रणेतारः कुशला यज्ञकर्मणि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210190, "chapter_id": 5496, "verse_number": "४१", "content_sanskrit": "नारदश्च बभूवात्र तुम्बुरुश्च महाद्युतिः ।\nविश्वावसुश्चित्रसेनस्तथाऽन्ये गीतकोविदाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210191, "chapter_id": 5496, "verse_number": "४२", "content_sanskrit": "गन्धर्वा गीतकुशला नृत्तेषु च विशारदाः ।\nरमयन्ति स्म तान् विप्रान् यज्ञकर्मान्तरेष्वथ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210192, "chapter_id": 5496, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि यूपस्तम्भस्थापनं नाम नवतितमोऽध्यायः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]