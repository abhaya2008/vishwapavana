[{"id": 2016750, "chapter_id": 1350, "verse_number": "२-९१-१", "content_sanskrit": "द्रौपद्युवाच॥\nपुरस्तात्करणीयं मे न कृतं कार्यमुत्तरम्।\nविह्वलाऽस्मि कृताऽनेन कर्षता बलिना बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016751, "chapter_id": 1350, "verse_number": "२-९१-२", "content_sanskrit": "अभिवादं करोम्येषां कुरूणां कुरुसंसदि।\nन मे स्यादपराधोऽयं तदिदं न कृतं मया॥\nवैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016752, "chapter_id": 1350, "verse_number": "२-९१-३", "content_sanskrit": "सा तेन च समाधूता दुःखेन च तपस्विनी।\nपतिता विललापेदं सभायामतथोचिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016753, "chapter_id": 1350, "verse_number": "२-९१-४x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016754, "chapter_id": 1350, "verse_number": "२-९१-४", "content_sanskrit": "स्वयंवरे यास्मि नृपैदृष्टा रङ्गे समागतैः।\nन दृष्टपूर्वा चान्यत्र साऽहमद्य सभां गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016755, "chapter_id": 1350, "verse_number": "२-९१-५", "content_sanskrit": "यां न वायुर्न चादित्यो दृष्टवन्तौ पुरा गृहे।\nसाऽहमद्य सभामध्ये दृष्टास्मि जनसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016756, "chapter_id": 1350, "verse_number": "२-९१-६", "content_sanskrit": "यां न मृष्यन्ति वातेन स्पृश्यमानां गृहे पुरा।\nस्पृश्यमानां सहन्तेऽद्य पाण्डवास्तां दूरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016757, "chapter_id": 1350, "verse_number": "२-९१-७", "content_sanskrit": "मृष्यन्ति कुरवश्चेमे मन्ये कालस्य पर्ययम्।\nस्नुषां दुहितरं चैव क्लिश्यमानामनर्हतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016758, "chapter_id": 1350, "verse_number": "२-९१-८", "content_sanskrit": "किंन्वतः कृपणं भूयो यदहं स्त्री सती शुभा।\nसभामध्यं विगाहेऽद्य क्व नु धर्मो महीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016759, "chapter_id": 1350, "verse_number": "२-९१-९", "content_sanskrit": "धर्म्यं स्त्रियं सभां पूर्वे न नयन्तीति नः श्रुतम्।\nस नष्टः कौरवेयेषु पूर्वो धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016760, "chapter_id": 1350, "verse_number": "२-९१-१०", "content_sanskrit": "कथं हि भार्या पाण्डुनां पार्षतस्य स्वसा सती।\nवासुदेवस्य च सखी पार्थिवानां सभामियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016761, "chapter_id": 1350, "verse_number": "२-९१-११", "content_sanskrit": "तामिमां धर्मराजस्य भार्यां सदृशवर्णजाम्।\nब्रूत दासीमदासीं वा तत्करिष्यामि कौरवाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016762, "chapter_id": 1350, "verse_number": "२-९१-१२", "content_sanskrit": "अयं मां सुदृढं क्षुद्रः कौरवाणां यशोहरः.\nक्लिश्नाति नाहं तत्सोढुं क्षुद्रः कौरवाणां यशोहरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016763, "chapter_id": 1350, "verse_number": "२-९१-१३", "content_sanskrit": "जितां वाऽप्यजितां वापि मन्यध्वं मां यथा नृपाः।\nतथा प्रत्युक्तमिच्छामि तत्करिष्यामि कौरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016764, "chapter_id": 1350, "verse_number": "२-९१-१४x", "content_sanskrit": "भीष्म उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016765, "chapter_id": 1350, "verse_number": "२-९१-१४", "content_sanskrit": "उक्तवानस्मि कल्याणि धर्मस्य परमा गतिः।\nलोके न शक्यते ज्ञातुमपि विज्ञैर्महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016766, "chapter_id": 1350, "verse_number": "२-९१-१५", "content_sanskrit": "बलवांश्च यथा धर्मं लोके पश्यति पुरुषः॥\nस धर्मो धर्मवेलायां भवत्यभिहतः परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016767, "chapter_id": 1350, "verse_number": "२-९१-१६", "content_sanskrit": "न विवेक्तुं च ते प्रश्नमिमं शक्नोमि निश्चयात्।\nसूक्ष्मत्वाद्गहनत्वाच्च कार्यस्यास्य च गौरवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016768, "chapter_id": 1350, "verse_number": "२-९१-१७", "content_sanskrit": "नूनमन्तः कुलस्यास्य भविता न चिरादिव।\nतथा हि कुरवः सर्वे लोभमोहपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016769, "chapter_id": 1350, "verse_number": "२-९१-१८", "content_sanskrit": "कुलेषु जाताः कल्याणि व्यसनैराहता भृशम्।\nधर्म्यान्मार्गान्न च्यवन्ते येषां नस्त्वं बधूः स्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016770, "chapter_id": 1350, "verse_number": "२-९१-१९", "content_sanskrit": "उपपन्नं च पाञ्चालि तवेदं वृत्तमीदृशम्।\nयत्कृच्छ्रमपि सम्प्राप्ता धर्ममेवान्ववेक्षसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016771, "chapter_id": 1350, "verse_number": "२-९१-२०", "content_sanskrit": "एते द्रोणादयश्चैव वृद्धा धर्मविदो जनाः।\nशून्यैः शरीरैस्तिष्ठन्ति गतासव इवानताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016772, "chapter_id": 1350, "verse_number": "२-९१-२१", "content_sanskrit": "युधिष्ठिरस्तु प्रश्नोऽस्मिन्प्रमाणमिति मे मतिः।\nअजितां वा जितां वेति स्वयं व्याख्यातुमर्हति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016773, "chapter_id": 1350, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि एकनवतितमोऽध्यायः॥९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]