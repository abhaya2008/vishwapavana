[{"id": 7002274000, "chapter_id": 22274, "verse_number": "३१९-१", "content_sanskrit": "ईश्वर उवाच ।\nवागीश्वरीपूजनञ्च प्रवदामि समण्डलम् ।\nऊहकं कालसंयुक्तं मनुं वर्णसमायुतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002274001, "chapter_id": 22274, "verse_number": "३१९-२", "content_sanskrit": "निषाद ईश्वरं कार्य्यं मनुना चन्द्रसूर्यवत् ।\nअक्षरन्न हिदेयं स्यात् ध्यायेत् कुन्देन्दुसन्निभां ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002274002, "chapter_id": 22274, "verse_number": "३१९-३", "content_sanskrit": "पञ्चाशद्वर्णमालान्तु मुक्तास्रग्दामभूषिताम् ।\nवरदाभयाक्षसूत्रपुस्तकाढ्यां त्रिलोचनां ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002274003, "chapter_id": 22274, "verse_number": "३१९-४", "content_sanskrit": "लक्षं जपेन्मस्तकान्तं स्कन्धान्तं वर्णमालिकां ।\nअकारादिक्षकारान्तां विशन्तीं मानवत् स्मरेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002274004, "chapter_id": 22274, "verse_number": "३१९-५", "content_sanskrit": "कुर्य्याद् गुरुश्च दीक्षार्थं मन्त्रग्राहे तु मण्डलम् ।\nसूर्य्याग्रमिन्दुभक्तन्तु भागाभ्यां कमलं हितं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002274005, "chapter_id": 22274, "verse_number": "३१९-६", "content_sanskrit": "वीथिका पदिका कार्य्या पद्मान्यष्टौ चतुष्पदे ।\nवीथिका पदिका वाह्ये द्वाराणि द्विपदानि तु ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002274006, "chapter_id": 22274, "verse_number": "३१९-७", "content_sanskrit": "उपद्वाराणि तद्वच्च कोणवान्धं द्विपट्टिकम् ।\nसितानि नव पद्मानि कर्णिका कनकप्रभा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002274007, "chapter_id": 22274, "verse_number": "३१९-८", "content_sanskrit": "केशराणि विचित्राणि कोणात्रक्तेन पूरयेत् ।\nव्योमरेखान्तरं कृष्णं द्वाराणीन्द्रेभमानतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002274008, "chapter_id": 22274, "verse_number": "३१९-९", "content_sanskrit": "मध्ये सरस्वतीं पद्मेवागीशी पूर्व्वपद्मके ।\nहृत्लेखा चित्रवागीशी गायत्री विश्वरुपया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002274009, "chapter_id": 22274, "verse_number": "३१९-१०", "content_sanskrit": "शाङ्करी मतिर्धुतिश्च पूर्व्वाद्या ह्रीं स्ववीजकाः ।\nध्येया सरस्वतीवच्च कपिलाज्येन होमकः ।\nसंस्कृतप्राकृतकविः काव्यशास्त्रादिविद्भवेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]