[{"id": 2005513, "chapter_id": 1108, "verse_number": "१-१०९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005514, "chapter_id": 1108, "verse_number": "१-१०९-१", "content_sanskrit": "हते चित्राङ्गदे भीष्मो बाले भ्रातरि कौरव।\nपालयामास तद्राज्यं सत्यवत्या मते स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005515, "chapter_id": 1108, "verse_number": "१-१०९-२", "content_sanskrit": "तथा विचित्रवीर्यं तु वर्तमानं सुखेऽतुले।\nसंप्राप्तयौवनं दृष्ट्वा भ्रातरं धीमतां वरः।\nभीष्मो विचित्रवीर्यस्य विवाहायाकरोन्मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005516, "chapter_id": 1108, "verse_number": "१-१०९-३", "content_sanskrit": "अथ काशिपतेर्भीष्मः कन्यास्तिस्रोऽप्सरोपमाः।\nशुश्राव सहिता राजन्वृण्वाना वै स्वयंवरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005517, "chapter_id": 1108, "verse_number": "१-१०९-४", "content_sanskrit": "ततः स रथिनां श्रेष्ठो रथेनैकेन शत्रुजित्।\nजगामानुमते मातुः पुरीं वाराणसीं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005518, "chapter_id": 1108, "verse_number": "१-१०९-५", "content_sanskrit": "तत्र राज्ञः समुदितान्सर्वतः समुपागतान्।\nददर्श कन्यास्ताश्वै भीष्मः शान्तनुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005519, "chapter_id": 1108, "verse_number": "१-१०९-६", "content_sanskrit": "तासां कामेन संमत्ताः सहिताः काशिकोसलाः।\nवङ्गाः पुण्ड्राः कलिङ्गाश्च ते जग्मुस्तां पुरीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005520, "chapter_id": 1108, "verse_number": "१-१०९-७", "content_sanskrit": "कीर्त्यमानेषु राज्ञां तु तदा नामसु सर्वशः।\nएकाकिनं तदा भीष्मं वृद्धं शान्तनुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005521, "chapter_id": 1108, "verse_number": "१-१०९-८", "content_sanskrit": "सोद्वेगा इव तं दृष्ट्वा कन्याः परमशोभनाः।\nअपाक्रामन्त ताः सर्वा वृद्ध इत्येव चिन्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005522, "chapter_id": 1108, "verse_number": "१-१०९-९", "content_sanskrit": "वृद्धः परमधर्मात्मा वलीपलितधारणः।\nकिकारणमिहायातो निर्लज्जो भरतर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005523, "chapter_id": 1108, "verse_number": "१-१०९-१०", "content_sanskrit": "मिथ्याप्रतिज्ञो लोकेषु किं वदिष्यति भारत।\nब्रह्मचारीति भीष्मो हि वृथैव प्रथितो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005524, "chapter_id": 1108, "verse_number": "१-१०९-११", "content_sanskrit": "इत्येवं प्रबुवन्तस्ते हसन्ति स्म नृपाधमाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005525, "chapter_id": 1108, "verse_number": "१-१०९-११x", "content_sanskrit": "वैशम्पायन उवाच।\nक्षत्रियाणां वचः श्रुत्वा भीष्मश्चुक्रोध भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005526, "chapter_id": 1108, "verse_number": "१-१०९-१२", "content_sanskrit": "भीष्मस्तदा स्वयं कन्या वरयामास ताः प्रभुः।\nउवाच च महीपालान्राजञ्जलदनिःस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005527, "chapter_id": 1108, "verse_number": "१-१०९-१३", "content_sanskrit": "रथमारोप्य ताः कन्या भीष्मः प्रहरतां वरः।\nआहूय दानं कन्यानां गुणवद्भ्यः स्मृतं बुधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005528, "chapter_id": 1108, "verse_number": "१-१०९-१४", "content_sanskrit": "अलङ्कृत्य यथाशक्ति प्रदाय च धनान्यपि।\nप्रयच्छन्त्यपरे कन्यां मिथुनेन गवामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005529, "chapter_id": 1108, "verse_number": "१-१०९-१५", "content_sanskrit": "वित्तेन कथितेनान्ये बलेनान्येऽनुमान्य च।\nप्रमत्तामुपयन्त्यन्ये स्वयमन्ये च विन्दते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005530, "chapter_id": 1108, "verse_number": "१-१०९-१६", "content_sanskrit": "आर्षं विधिं पुरस्कृत्य दारान्विन्दन्ति चापरे।\nअष्टमं तमथो वित्त विवाहं कविभिर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005531, "chapter_id": 1108, "verse_number": "१-१०९-१७", "content_sanskrit": "स्वयंवरं तु राजन्याः प्रशंसन्त्युपयान्ति च।\nप्रमथ्य तु हृतामाहुर्ज्यायसीं धर्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005532, "chapter_id": 1108, "verse_number": "१-१०९-१८", "content_sanskrit": "ता इमाः पृथिवीपाला जिहीर्षामि बलादितः।\nते यतध्वं परं शक्त्या विजयायेतराय वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005533, "chapter_id": 1108, "verse_number": "१-१०९-१९", "content_sanskrit": "स्थितोऽहं पृथिवीपाला युद्धाय कृतनिश्चयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005534, "chapter_id": 1108, "verse_number": "१-१०९-१९x", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्त्वा महीपालान्काशिराजं च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005535, "chapter_id": 1108, "verse_number": "१-१०९-२०", "content_sanskrit": "सर्वाः कन्याः स कौरव्यो रथमारोप्य च स्वकम्।\nआमन्त्र्य च स तान्प्रायाच्छीघ्रं कन्याः प्रगृह्य ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005536, "chapter_id": 1108, "verse_number": "१-१०९-२१", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे समुत्पेतुरमर्षिताः।\nसंस्पृशन्तः स्वकान्बाहून्दशन्तो दशनच्छदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005537, "chapter_id": 1108, "verse_number": "१-१०९-२२", "content_sanskrit": "तेषामाभरणान्याशु त्वरितानां विमुञ्चताम्।\nआमुञ्चतां च वर्माणि संभ्रमः सुमहानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005538, "chapter_id": 1108, "verse_number": "१-१०९-२३", "content_sanskrit": "ताराणामिव संपातो बभूव जनमेजय।\nभूषणानां च सर्वेषां कवचानां च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005539, "chapter_id": 1108, "verse_number": "१-१०९-२४", "content_sanskrit": "सवर्मभिर्भूषणैश्च प्रकीर्यद्बिरितस्ततः।\nसक्रोधामर्षजिह्मभ्रूकषायीकृतलोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005540, "chapter_id": 1108, "verse_number": "१-१०९-२५", "content_sanskrit": "सूतोपक्लृप्तान् रुचिरान्सदश्वैरुपकल्पितान्।\nरथानास्थाय ते वीराः सर्वप्रहरणान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005541, "chapter_id": 1108, "verse_number": "१-१०९-२६", "content_sanskrit": "प्रयान्तमथ कौरव्यमनुसस्रुरुदायुधाः।\nततः समभवद्युद्धं तेषां तस्य च भारत।\nएकस्य च बहूनां च तुमुलं रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005542, "chapter_id": 1108, "verse_number": "१-१०९-२७", "content_sanskrit": "ते त्विषून्दशसाहस्रांस्तस्मिन्युगपदाक्षिपन्।\nअप्राप्तांश्चैव तानाशु भीष्मः सर्वांस्तथाऽन्तरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005543, "chapter_id": 1108, "verse_number": "१-१०९-२८", "content_sanskrit": "अच्छिनच्छरवर्षेण महता लोमवाहिना।\nततस्ते पार्थिवाः सर्वे सर्वतः परिवार्य तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005544, "chapter_id": 1108, "verse_number": "१-१०९-२९", "content_sanskrit": "ववृषुः शरवर्षेण वर्षेणेवाद्रिमम्बुदाः।\nस तं बाणमयं वर्षं शरैरावार्य सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005545, "chapter_id": 1108, "verse_number": "१-१०९-३०", "content_sanskrit": "ततः सर्वान्महीपालान्पर्यविध्यत्त्रिभिस्त्रिभिः।\nएकैकस्तु ततो भीष्मं राजन्विव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005546, "chapter_id": 1108, "verse_number": "१-१०९-३१", "content_sanskrit": "स च तान्प्रतिविव्याध द्वाभ्यां द्वाभ्यां पराक्रमन्।\nतद्युद्धमासीत्तुमुलं घोरं देवासुरोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005547, "chapter_id": 1108, "verse_number": "१-१०९-३२", "content_sanskrit": "पश्यतां लोकवीराणां शरशक्तिसमाकुलम्।\nस धनूंषि ध्वजाग्राणि वर्माणि च शिरांसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005548, "chapter_id": 1108, "verse_number": "१-१०९-३३", "content_sanskrit": "चिच्छेद समरे भीष्मः शतशोथ सहस्रशः।\nतस्यातिपुरुषं कर्म लाघवं रथचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005549, "chapter_id": 1108, "verse_number": "१-१०९-३४", "content_sanskrit": "रक्षणं चात्मनः संख्ये शत्रवोऽप्यभ्यपूजयन्।\nअक्षतः क्षपयित्वान्यानसङ्ख्येयपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005550, "chapter_id": 1108, "verse_number": "१-१०९-३५", "content_sanskrit": "आनिनाय स काश्यस्य सुताः सागरगासुतः।\nतान्विनिर्जित्य तु रणे सर्वशस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005551, "chapter_id": 1108, "verse_number": "१-१०९-३६", "content_sanskrit": "कन्याभिः सहितः प्रायाद्भारतो भारतान्प्रति।\nततस्तं पृष्ठतो राजञ्शाल्वराजो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005552, "chapter_id": 1108, "verse_number": "१-१०९-३७", "content_sanskrit": "अभ्यगच्छदमेयात्मा भीष्मं शान्तनवं रणे।\nवारणं जघने भिन्दन्दन्ताभ्यामपरो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005553, "chapter_id": 1108, "verse_number": "१-१०९-३८", "content_sanskrit": "वासितामनुसंप्राप्तो यूथपो बलिनां वरः।\nस्त्रीकामस्तिष्ठतिष्ठेति भीष्ममाह स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005554, "chapter_id": 1108, "verse_number": "१-१०९-३९", "content_sanskrit": "साल्वराजो महाबाहुरमर्षेण प्रचोदितः।\nततः स पुरुषव्याघ्रो भीष्मः परबलार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005555, "chapter_id": 1108, "verse_number": "१-१०९-४०", "content_sanskrit": "तद्वाक्याकुलितः क्रोधाद्विधूमोग्निरिव ज्वलन्।\nविततेषुधनुष्पाणिर्विकुञ्चितललाटभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005556, "chapter_id": 1108, "verse_number": "१-१०९-४१", "content_sanskrit": "क्षत्रधर्मं समास्थाय व्यपेतभयसंभ्रमः।\nनिवर्तयामास रथं साल्वं प्रति महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005557, "chapter_id": 1108, "verse_number": "१-१०९-४२", "content_sanskrit": "निवर्तमानं तं दृष्ट्वा राजानः सर्व एव ते।\nप्रेक्षकाः समपद्यन्त भीष्मसाल्वसमागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2005558, "chapter_id": 1108, "verse_number": "१-१०९-४३", "content_sanskrit": "तौ वृषाविव नर्दन्तौ बलिनौ वासितान्तरे।\nअन्योन्यमभिवर्तेतां बलविक्रमशालिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2005559, "chapter_id": 1108, "verse_number": "१-१०९-४४", "content_sanskrit": "ततो भीष्मं शान्तनवं शरैः शतसहस्रशः।\nसाल्वराजो नरश्रेष्ठः समवाकिरदाशुगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2005560, "chapter_id": 1108, "verse_number": "१-१०९-४५", "content_sanskrit": "पूर्वमभ्यर्दितं दृष्ट्वा भीष्मं साल्वेन ते नृपाः।\nविस्मिताः समपद्यन्त साधुसाध्विति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2005561, "chapter_id": 1108, "verse_number": "१-१०९-४६", "content_sanskrit": "लाघवं तस्य ते दृष्ट्वा समरे सर्वपार्थिवाः।\nअपूजयन्त संहृष्टा वाग्भिः साल्वं नराधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2005562, "chapter_id": 1108, "verse_number": "१-१०९-४७", "content_sanskrit": "क्षत्रियाणां ततो वाचः श्रुत्वा परपुञ्जयः।\nक्रुद्धः शान्तनवो भीष्मस्तिष्ठतिष्ठेत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2005563, "chapter_id": 1108, "verse_number": "१-१०९-४८", "content_sanskrit": "सारथिं चाब्रवीत्क्रुद्धो याहि यत्रैष पार्थिवः।\nयावदेनं निहन्म्यद्य भुजङ्गमिव पक्षिराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2005564, "chapter_id": 1108, "verse_number": "१-१०९-४९", "content_sanskrit": "ततोऽस्त्रं वारुणं सम्यग्योजयामास कौरवः।\nतेनाश्वांश्चतुरोऽमृद्गात्साल्वराजस्य भूपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2005565, "chapter_id": 1108, "verse_number": "१-१०९-५०", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य साल्वराजस्य कौरवः।\nभीष्मो नृपतिशार्दूल न्यवधीत्तस्य सारथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2005566, "chapter_id": 1108, "verse_number": "१-१०९-५१", "content_sanskrit": "अस्त्रेण चास्याथैन्द्रेण न्यवधीत्तुरगोत्तमान्।\nकन्याहेतोर्नरश्रेष्ठ भीष्मः शान्तनवस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2005567, "chapter_id": 1108, "verse_number": "१-१०९-५२", "content_sanskrit": "जित्वा विसर्जयामास जीवन्तं नृपसत्तमम्।\nततः साल्वः स्वनगरं प्रययौ भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2005568, "chapter_id": 1108, "verse_number": "१-१०९-५३", "content_sanskrit": "स्वराज्यमन्वशाच्चैव धर्मेण नृपतिस्तदा।\nराजानो ये च तत्रासन्स्वयंवरदिदृक्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2005569, "chapter_id": 1108, "verse_number": "१-१०९-५४", "content_sanskrit": "स्वान्येव तेऽपि राष्ट्राणि जग्मुः परपुरञ्जयाः।\nएवं विजित्य ताः कन्या भीष्मः प्रहरतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2005570, "chapter_id": 1108, "verse_number": "१-१०९-५५", "content_sanskrit": "प्रययौ हास्तिनपुरं यत्र राजा स कौरवः।\nविचित्रवीर्यो धर्मात्मा प्रशास्ति वसुधामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2005571, "chapter_id": 1108, "verse_number": "१-१०९-५६", "content_sanskrit": "यथा पितास्य कौरव्यः शान्तनुर्नृपसत्तमः।\nसोऽचिरेणैव कालेन अत्यक्रामन्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2005572, "chapter_id": 1108, "verse_number": "१-१०९-५७", "content_sanskrit": "वनानि सरितश्चैव शैलांश्च विनिधान्द्रुमान्।\nअक्षतः क्षपयित्वाऽरीन्सङ्ख्येऽसङ्ख्येयविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2005573, "chapter_id": 1108, "verse_number": "१-१०९-५८", "content_sanskrit": "आनयामास काश्यस्य सुताः सागरगासुतः।\nस्नुषा इव स धर्मात्मा भगिनीरिव चानुजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2005574, "chapter_id": 1108, "verse_number": "१-१०९-५९", "content_sanskrit": "यथा दुहितश्चैव परिगृह्य ययौ कुरून्।\nआनिन्ये स महाबाहुर्भ्रातुः प्रियचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2005575, "chapter_id": 1108, "verse_number": "१-१०९-६०", "content_sanskrit": "ताः सर्वगुणसंपन्ना भ्राता भ्रात्रे यवीयसे।\nभीष्मो विचित्रवीर्याय प्रददौ विक्रमाहृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2005576, "chapter_id": 1108, "verse_number": "१-१०९-६१", "content_sanskrit": "एवं धर्मेण धर्मज्ञः कृत्वा कर्मातिमानुषम्।\nभ्रातुर्विचित्रवीर्यस्य विवाहायोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2005577, "chapter_id": 1108, "verse_number": "१-१०९-६२", "content_sanskrit": "सत्यवत्या सह मिथः कृत्वा निश्चयमात्मवान्।\nविवाहं कारयिष्यन्तं भीष्मं काशिपतेः सुता।\nज्येष्ठा तासामिदं वाक्यमब्रवीद्धसती तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2005578, "chapter_id": 1108, "verse_number": "१-१०९-६३", "content_sanskrit": "मया सौभपतिः पूर्वं मनसा हि वृतः पतिः।\nतेन चास्मि वृता पूर्वमेष कामश्च मे पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2005579, "chapter_id": 1108, "verse_number": "१-१०९-६४", "content_sanskrit": "मया वरयितव्योऽभूत्साल्वस्तस्मिन्स्वयंवरे।\nएतद्विज्ञाय धर्मज्ञ धर्मतत्त्वं समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2005580, "chapter_id": 1108, "verse_number": "१-१०९-६५", "content_sanskrit": "एवमुक्तस्तया भीष्मः कन्यया विप्रसंसदि।\nचिन्तामभ्यगमद्वीरो युक्तां तस्यैव कर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2005581, "chapter_id": 1108, "verse_number": "१-१०९-६६", "content_sanskrit": "अन्यसक्ता त्वियं कन्या ज्येष्ठा त्वम्बा मया जिता।\nवाचा दत्ता मनोदत्ता कृतमङ्गलवाचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2005582, "chapter_id": 1108, "verse_number": "१-१०९-६७", "content_sanskrit": "निर्दिष्टा तु परस्यैव सा त्याज्या परचिन्तिनी।\nइत्युक्त्वा चानुमान्यैव भ्रातरं स्ववशानुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2005583, "chapter_id": 1108, "verse_number": "१-१०९-६८", "content_sanskrit": "विनिश्चित्य स धर्मज्ञो ब्राह्मणैर्वेदपारगैः।\nअनुजज्ञे तदा ज्येष्ठामम्बां काशिपतेः सुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2005584, "chapter_id": 1108, "verse_number": "१-१०९-६९", "content_sanskrit": "अम्बिकाम्बालिके भार्ये प्रादाद्भ्रात्रे यवीयसे।\nभीष्मो विचित्रवीर्याय विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2005585, "chapter_id": 1108, "verse_number": "१-१०९-७०", "content_sanskrit": "तयोः पाणी गृहीत्वा तु रूपयौवनदर्पितः।\nविचित्रवीर्यो धर्मात्मा नाम्बामैच्छत्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2005586, "chapter_id": 1108, "verse_number": "१-१०९-७१", "content_sanskrit": "अम्बामन्यस्य कीर्त्यन्तीमब्रवीच्चारुदर्शनाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2005587, "chapter_id": 1108, "verse_number": "१-१०९-७१x", "content_sanskrit": "विचित्रवीर्य उवाच।\nपापस्य फलमेवैष कामोऽसाधुर्निरर्थकः।\nपरतन्त्रोपभोगो मामार्य नाऽऽयोक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2005588, "chapter_id": 1108, "verse_number": "१-१०९-७२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2005589, "chapter_id": 1108, "verse_number": "१-१०९-७२", "content_sanskrit": "प्रातिष्ठच्छान्तनोर्वंशस्तात यस्य त्वमन्वयः।\nअकामवृत्तो धर्मात्मन्साधु मन्ये मतं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2005590, "chapter_id": 1108, "verse_number": "१-१०९-७३", "content_sanskrit": "इत्युक्त्वाम्बां समालोक्य विधिवद्वाक्यमब्रवीत्।\nविसृष्टा ह्यसि गच्छ त्वं यथाकाममनिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2005591, "chapter_id": 1108, "verse_number": "१-१०९-७४", "content_sanskrit": "नानियोज्ये समर्थोऽहं नियोक्तुं भ्रातरं प्रियम्।\nअन्यबावगतां चापि को नारीं वासयेद्गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2005592, "chapter_id": 1108, "verse_number": "१-१०९-७५", "content_sanskrit": "अतस्त्वां न नियोक्ष्यामि अन्यकामासि गम्यताम्।\nअहमप्यूर्ध्वरेता वै निवृत्तो दारकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2005593, "chapter_id": 1108, "verse_number": "१-१०९-७६", "content_sanskrit": "न संबन्धस्तदावाभ्यां भविता वै कथंचन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2005594, "chapter_id": 1108, "verse_number": "१-१०९-७६x", "content_sanskrit": "वैशम्पायन उवाच।\nइत्युक्ता सा गता तत्र सखीभिः परिवारिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2005595, "chapter_id": 1108, "verse_number": "१-१०९-७७", "content_sanskrit": "निर्दिष्टा हि शनै राजन्साल्वराजपुरं प्रति।\nअथाम्बा साल्वंमागम्य साऽब्रवीत्प्रतिपूज्य तं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2005596, "chapter_id": 1108, "verse_number": "१-१०९-७८", "content_sanskrit": "पुरा निर्दिष्टभावा त्वामागतास्मि वरानन।\nदेवव्रतं समुत्सृज्य सानुजं भरतर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2005597, "chapter_id": 1108, "verse_number": "१-१०९-७९", "content_sanskrit": "प्रतिगृह्णीष्व भद्रं ते विधिवन्मां समुद्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2005598, "chapter_id": 1108, "verse_number": "१-१०९-८०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2005599, "chapter_id": 1108, "verse_number": "१-१०९-८०", "content_sanskrit": "तयैवमुक्तः साल्वोपि प्रहसन्निदमब्रवीत्।\nनिर्जिताऽसीह भीष्मेण मां विनिर्जित्य राजसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2005600, "chapter_id": 1108, "verse_number": "१-१०९-८१", "content_sanskrit": "अन्येन निर्जितां भद्रे विसृष्टां तेन चालयात्।\nन गृह्णामि वरारोहे तत्र चैव तु गम्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2005601, "chapter_id": 1108, "verse_number": "१-१०९-८२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2005602, "chapter_id": 1108, "verse_number": "१-१०९-८२", "content_sanskrit": "इत्युक्ता सा समागम्य कुरुराज्यमनुत्तमम्।\nअम्बाब्रवीत्ततो भीष्मं त्वयाऽहं सहसा हृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2005603, "chapter_id": 1108, "verse_number": "१-१०९-८३", "content_sanskrit": "क्षत्रधर्ममवेक्षस्व त्वं भर्ता मम धर्मतः।\nयां यः स्वयंवरे कन्यां निर्जयेच्छौर्यसंपदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2005604, "chapter_id": 1108, "verse_number": "१-१०९-८४", "content_sanskrit": "राज्ञः सर्वान्विनिर्जित्य स तामुद्वाहयेद्ध्रुवम्।\nअतस्त्वमेव भर्ता मे त्वयाऽहं निर्जिता यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2005605, "chapter_id": 1108, "verse_number": "१-१०९-८५", "content_sanskrit": "तस्माद्वहस्व मां भीष्म निर्जितां संसदि त्वया।\nऊर्ध्वरेता ह्यहमिति प्रत्युवाच पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2005606, "chapter_id": 1108, "verse_number": "१-१०९-८६", "content_sanskrit": "भीष्मं सा चाब्रवीदम्बा यथाजैषीस्तथा कुरु।\nएवमन्वगमद्भीष्मं षट्समाः पुष्करेक्षणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2005607, "chapter_id": 1108, "verse_number": "१-१०९-८७", "content_sanskrit": "ऊर्ध्वरेतास्त्वहं भद्रे विवाहविमुखोऽभवम्।\nतमेव साल्वं गच्छ त्वं यः पुरा मनसा वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2005608, "chapter_id": 1108, "verse_number": "१-१०९-८८", "content_sanskrit": "अन्यसक्तं किमर्थं त्वमात्मानमवदः पुरा।\nअन्यसक्तां वधूं कन्यां वासयेत्स्वगृहे न हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2005609, "chapter_id": 1108, "verse_number": "१-१०९-८९", "content_sanskrit": "नाहमुद्वाहयिष्ये त्वां मम भ्रात्रे यवीयसे।\nविचित्रवीर्याय शुभे यथेष्टं गम्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2005610, "chapter_id": 1108, "verse_number": "१-१०९-९०", "content_sanskrit": "भूयः साल्वं समभ्येत्य राजन्गृह्णीष्व मामिति।\nनाहं गृह्णाम्यन्यजितामिति साल्वनिराकृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2005611, "chapter_id": 1108, "verse_number": "१-१०९-९१", "content_sanskrit": "ऊर्ध्वरेतास्त्वहमिति भीष्मेण च निराकृता।\nअम्बा भीष्मं पुनः साल्वं भीष्मं साल्वं पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2005612, "chapter_id": 1108, "verse_number": "१-१०९-९२", "content_sanskrit": "गमनागमनेनैवमनैषीत्षट् समा नृप।\nअश्रुभिर्भूमिमुक्षन्ती शोचन्ती सा मनस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2005613, "chapter_id": 1108, "verse_number": "१-१०९-९३", "content_sanskrit": "पीनोन्नतकुचद्वन्द्वा विशालजघनेक्षणा।\nश्रोणीभरालसगमा राकाचन्द्रनिभानना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2005614, "chapter_id": 1108, "verse_number": "१-१०९-९४", "content_sanskrit": "वर्षत्कादम्बिनीमूर्ध्नि स्फुरन्ती चञ्चलेव सा।\nसा ततो द्वादश समा बाहुदामभितो नदीम्।\nपार्श्वे हिमवतो रम्ये तपो घोरं समाददे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2005615, "chapter_id": 1108, "verse_number": "१-१०९-९५", "content_sanskrit": "संक्षिप्तकरणा तत्र तप आस्थाय सुव्रता।\nपादाङ्गुष्ठेन साऽतिष्ठदकम्पन्त ततः सुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2005616, "chapter_id": 1108, "verse_number": "१-१०९-९६", "content_sanskrit": "तस्यास्तत्तु तपो दृष्ट्वा सुराणां क्षोभकारकम्।\nविस्मितश्चैव हृष्टश्च तस्यानुग्रहबुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2005617, "chapter_id": 1108, "verse_number": "१-१०९-९७", "content_sanskrit": "अनन्तसेनो भगवान्कुमारो वरदः प्रभुः।\nमानयन्राजपुत्रीं तां ददौ तस्यै शुभां स्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2005618, "chapter_id": 1108, "verse_number": "१-१०९-९८", "content_sanskrit": "एषा पुष्करिणी दिव्या यथावत्समुपस्थिता।\nअम्बे त्वच्छोकशमनी माला भुवि भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2005619, "chapter_id": 1108, "verse_number": "१-१०९-९९", "content_sanskrit": "एतां चैव मया दत्तां मालां यो धारयिष्यति।\nसोऽस्य भीष्मस्य निधने कारणं वै भविष्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2005620, "chapter_id": 1108, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि नवाधिकशततमोऽध्यायः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}]