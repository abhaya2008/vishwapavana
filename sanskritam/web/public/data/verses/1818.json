[{"id": 2037800, "chapter_id": 1818, "verse_number": "५-६३-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037801, "chapter_id": 1818, "verse_number": "५-६३-१", "content_sanskrit": "सदृशानां मनुष्येषु सर्वेषां तुल्यजन्मनाम्।\nकथमेकान्ततस्तेषां पार्थानां मन्यसे जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037802, "chapter_id": 1818, "verse_number": "५-६३-२", "content_sanskrit": "वयं च तेऽपि तुल्या वै वीर्येण च पराक्रमैः ।\nसमेन वयसा चैव प्रातिभेन श्रुतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037803, "chapter_id": 1818, "verse_number": "५-६३-३", "content_sanskrit": "अस्त्रेण योधयुग्या च शीघ्रत्वे कौशले तथा।\nसर्वे स्म समजातीयाः सर्वे मानुषयोनयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037804, "chapter_id": 1818, "verse_number": "५-६३-४", "content_sanskrit": "पितामह विजानीषे पार्थेषु विजयं कथम्।\nनाहं भवति न द्रोणे न कृपे न च बाह्लिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037805, "chapter_id": 1818, "verse_number": "५-६३-५", "content_sanskrit": "अन्येषु च नरेन्द्रेषु पराक्रम्य समारभे।\nअहं वैकर्तनः कर्णो भ्राता दुःशासनश्च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037806, "chapter_id": 1818, "verse_number": "५-६३-६", "content_sanskrit": "पाण्डवान्समरे पञ्च हनिष्यामः शितैः शरैः ।\nततो राजन्महायज्ञैर्विविधैर्भूरिदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037807, "chapter_id": 1818, "verse_number": "५-६३-७", "content_sanskrit": "ब्राह्मणांस्तर्पयिष्यामि गोभिरश्वैर्धनेन च ।\nयदा परिकरिष्यन्ति ऐणेयानिव तन्तुना ।\nअतरित्रानिव जले बाहुभिर्मामका रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037808, "chapter_id": 1818, "verse_number": "५-६३-८", "content_sanskrit": "पश्यन्तस्ते परांस्तत्र रथनागसमाकुलान्।\nतदा दर्पं विमोक्ष्यन्ति पाण्डवाः स च केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037809, "chapter_id": 1818, "verse_number": "५-६३-९", "content_sanskrit": "`सुखान्यवाप्य सहिताः कृत्वा कर्म सुदुस्तरम्।\nविस्रब्धास्तु भविष्यामः प्राप्ते काले गतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037810, "chapter_id": 1818, "verse_number": "५-६३-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037811, "chapter_id": 1818, "verse_number": "५-६३-१०", "content_sanskrit": "अथाब्रवीन्महाराजो धृतराष्ट्रः सुदुर्मनाः ।\nविदुरं विदुषां श्रेष्ठं सर्वपार्थिवसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037812, "chapter_id": 1818, "verse_number": "५-६३-११x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037813, "chapter_id": 1818, "verse_number": "५-६३-११", "content_sanskrit": "मोहितो मृत्युपाशेन कालस्य वशमागतः।\nतात कर्णेन सहितः पुत्रो दुर्योधनो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037814, "chapter_id": 1818, "verse_number": "५-६३-१२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037815, "chapter_id": 1818, "verse_number": "५-६३-१२", "content_sanskrit": "इह निःश्रेयसं प्राहुर्वृद्धा निश्चितदर्शिनः ।\nब्राह्मणस्य विशेषेण दमो धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037816, "chapter_id": 1818, "verse_number": "५-६३-१३", "content_sanskrit": "तस्य दानं क्षमा सिद्धिर्यथावदुपपद्यते ।\nदमो दानं तपो ज्ञानमधीतं चानुवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037817, "chapter_id": 1818, "verse_number": "५-६३-१४", "content_sanskrit": "दमस्तेजो वर्धयति पवित्रं दम उत्तमम् ।\nविपाप्मा वृद्धतेजास्तु पुरुषो विन्दते महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037818, "chapter_id": 1818, "verse_number": "५-६३-१५", "content_sanskrit": "क्रव्याद्भ्य इव भूतानामदान्तेभ्यः सदा भयम् ।\nयेषां च प्रतिषेधार्थं क्षत्रं सृष्टं स्वयंभुवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037819, "chapter_id": 1818, "verse_number": "५-६३-१६", "content_sanskrit": "आश्रमेषु चतुर्ष्वाहुर्दममेवोत्तमं व्रतम्।\nतस्य लिङ्गं प्रवक्ष्यामि येषां समुदयो दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037820, "chapter_id": 1818, "verse_number": "५-६३-१७", "content_sanskrit": "क्षमा धृतिरहिंसा च समता सत्यमार्जवम् ।\nइन्द्रियाभिजयो धैर्यं मार्दवं ह्रीरचापलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037821, "chapter_id": 1818, "verse_number": "५-६३-१८", "content_sanskrit": "अकार्पण्यमसंरम्भः सन्तोषं श्रद्दधानता ।\nएतानि यस्य राजेन्द्र स दान्तः पुरुषः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037822, "chapter_id": 1818, "verse_number": "५-६३-१९", "content_sanskrit": "कामो लोभश्च दर्पश्च मन्युर्निद्रा विकत्थनम्।\nमान ईर्ष्यां च शोकश्च नैतद्दान्तो निषेवते।\nअजिह्ममशठं शुद्धमेतद्दान्तस्य लक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037823, "chapter_id": 1818, "verse_number": "५-६३-२०", "content_sanskrit": "अलोलुपस्तथाऽल्पेप्सुः कामानामविचिन्तिता ।\nसमुद्रकल्पः परुषः स दान्तः परिकीर्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037824, "chapter_id": 1818, "verse_number": "५-६३-२१", "content_sanskrit": "सुवृत्तः शीलसंपन्नः प्रसन्नात्माऽत्मविद्बुधः ।\nप्राप्येह लोके संमानं सुगतिं प्रेत्य गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037825, "chapter_id": 1818, "verse_number": "५-६३-२२", "content_sanskrit": "अभयं यस्य भूतेभ्यः सर्वेषामभयं यतः।\nस वै परिणतप्रज्ञः प्रख्यातो मनुजोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037826, "chapter_id": 1818, "verse_number": "५-६३-२३", "content_sanskrit": "सर्वभूतहितो मैत्रस्तस्मान्नोद्विजते जनः।\nसमुद्र इव गम्भीरः प्रज्ञातृप्तः प्रशाम्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037827, "chapter_id": 1818, "verse_number": "५-६३-२४", "content_sanskrit": "कर्मणाऽचरितं पूर्वं सद्भिराचरितं च यत्।\nतदेवास्थाय मोदन्ते दान्ताः शमपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037828, "chapter_id": 1818, "verse_number": "५-६३-२५", "content_sanskrit": "नैष्कर्म्यं वा समास्थाय ज्ञानतृप्तो जितेन्द्रियः।\nकालाकाङ्क्षी चरँल्लोके ब्रह्मभूयाय कल्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037829, "chapter_id": 1818, "verse_number": "५-६३-२६", "content_sanskrit": "शकुनीनामिवाकाशे पदं नैवोपलभ्यते।\nएवं प्रज्ञानतृप्तस्य मुनेर्वर्त्म न दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037830, "chapter_id": 1818, "verse_number": "५-६३-२७", "content_sanskrit": "उत्सृज्यैव गृहान्यस्तु मोक्षमेवाभिमन्यते ।\nलोकास्तेजोमयास्तस्य कल्पन्ते शाश्वता दिवि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2037831, "chapter_id": 1818, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि त्रिषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]