[{"id": 2083596, "chapter_id": 2783, "verse_number": "१२-२८०-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083597, "chapter_id": 2783, "verse_number": "१२-२८८-१", "content_sanskrit": "वृत्रस्य तु महाराज ज्वराविष्टस्य सर्वशः।\nअभवन्यानि लिङ्गानि शरीरे तानि मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083598, "chapter_id": 2783, "verse_number": "१२-२८८-२", "content_sanskrit": "ज्वलितास्योऽभवद्धोरो वैवर्ण्यं चागमत्परम्।\nगात्रकम्पश्च सुमहाञ्श्वासश्चाप्यभवन्महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083599, "chapter_id": 2783, "verse_number": "१२-२८८-३", "content_sanskrit": "रोमहर्षश्च तीव्रोऽभून्निःश्वासश्च महान्नृप।\nशिवा चाशिवसंकाशा तस्य वक्रात्सुदारुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083600, "chapter_id": 2783, "verse_number": "१२-२८८-४", "content_sanskrit": "निष्पपात महाघोरा स्मृतिर्नष्टास्य भारत।\nउत्काश्च ज्वलितास्तस्य दीप्ताः पार्श्वे प्रपेदिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083601, "chapter_id": 2783, "verse_number": "१२-२८८-५", "content_sanskrit": "गृध्राः कङ्का बलाकाश्च वाचोऽमुञ्चन्सुदारुणाः।\nवृत्रस्योपरि संहृष्टाश्चक्रवत्परिबभ्रमुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083602, "chapter_id": 2783, "verse_number": "१२-२८८-६", "content_sanskrit": "ततस्तं रथमास्थाय देवाप्यायित आहवे।\nवज्रोद्यतकरः शक्रस्तं दैत्यं प्रत्यवैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083603, "chapter_id": 2783, "verse_number": "१२-२८८-७", "content_sanskrit": "अमानुषमथो नादं स मुमोच महासुरः।\nव्यजृम्भच्चैव राजेन्द्र तीव्रज्वरसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083604, "chapter_id": 2783, "verse_number": "१२-२८८-८", "content_sanskrit": "अथास्य जृम्भतः शक्रस्ततो वज्रमवासृजत्।\nस वज्रः सुमहातेजा कालान्तकयमोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083605, "chapter_id": 2783, "verse_number": "१२-२८८-९", "content_sanskrit": "क्षिप्रमेव महाकायं वृत्रं दैत्यमपातयत्।\nततो नादः समभवत्पुनरेव समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083606, "chapter_id": 2783, "verse_number": "१२-२८८-१०", "content_sanskrit": "वृत्रं विनिहितं दृष्ट्वा देवानां भरतर्षभ।\nवृत्रं तु हत्वा मघवा दानवारिर्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083607, "chapter_id": 2783, "verse_number": "१२-२८८-११", "content_sanskrit": "वज्रेण विष्णुयुक्तेन दिवमेव समाविशत्।\nअथ वृत्रस्य कौरव्य शरीरादभिनिःसृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083608, "chapter_id": 2783, "verse_number": "१२-२८८-१२", "content_sanskrit": "ब्रह्महत्या महाघोरा रौद्रा लोकभयावहा।\nकरालदशना भीमा विकृता कृष्णपिङ्गला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083609, "chapter_id": 2783, "verse_number": "१२-२८८-१३", "content_sanskrit": "प्रकीर्णमूर्धजा चैव घोरनेत्रा च भारत।\nकपालमालिनी चैव कृत्येव भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083610, "chapter_id": 2783, "verse_number": "१२-२८८-१४", "content_sanskrit": "रुधिरार्द्रा च धर्मज्ञ चीरवल्कलवासिनी।\nसाऽभिनिष्क्रम्य राजेन्द्र तादृग्रृपा भयावहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083611, "chapter_id": 2783, "verse_number": "१२-२८८-१५", "content_sanskrit": "वज्रिणं मृगयामास तदा भरतसत्तम।\nकस्यचित्त्वथ कालस्य वृत्रहा कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083612, "chapter_id": 2783, "verse_number": "१२-२८८-१६", "content_sanskrit": "स्वर्गायाभिमुखः प्रायाल्लोकानां हितकाम्यया।\nसा विनिःसरमाणं तु दृष्ट्वा शक्रं महौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083613, "chapter_id": 2783, "verse_number": "१२-२८८-१७", "content_sanskrit": "कण्ठे जग्राह देवेन्द्रं सुलग्ना चाभवत्तदा।\nस हि तस्मिन्समुत्पन्ने ब्रह्मवध्याकृते भये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083614, "chapter_id": 2783, "verse_number": "१२-२८८-१८", "content_sanskrit": "नलिन्या विसमध्यस्थ उवासाब्दगणान्बहून्।\nअनुसृत्य तु यत्नात्स तया वै ब्रह्महत्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083615, "chapter_id": 2783, "verse_number": "१२-२८८-१९", "content_sanskrit": "तदा गृहीतः कौरव्य निस्तेजाः समपद्यत।\nतस्या व्यपोहने शक्रः परं यत्नं चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083616, "chapter_id": 2783, "verse_number": "१२-२८८-२०", "content_sanskrit": "न चाशकत्तां देवेन्द्रो ब्रह्मवध्यां व्यपोहितुम्।\nगृहीत एव तु तया देवेन्द्रो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083617, "chapter_id": 2783, "verse_number": "१२-२८८-२१", "content_sanskrit": "पितामहमुपागम्य शिरसा प्रत्यपूजयत्।\nज्ञात्वा गृहीतं शक्रं स द्विजप्रवरवध्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083618, "chapter_id": 2783, "verse_number": "१२-२८८-२२", "content_sanskrit": "ब्रह्मा स चिन्तयामास तदा भरतसत्तम।\nतामुवाच महाबाहो ब्रह्मवध्यां पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083619, "chapter_id": 2783, "verse_number": "१२-२८८-२३", "content_sanskrit": "स्वरेण मधुरेणाथ सान्त्वयन्निव भारत।\nमुच्यतां त्रिदशेन्द्रोयं मत्प्रियं कुरु भामिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083620, "chapter_id": 2783, "verse_number": "१२-२८८-२४", "content_sanskrit": "ब्रूहि किं ते करोम्यद्य कामं किं त्वमिहेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083621, "chapter_id": 2783, "verse_number": "१२-२८८-२५x", "content_sanskrit": "ब्रह्महत्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083622, "chapter_id": 2783, "verse_number": "१२-२८८-२५", "content_sanskrit": "त्रिलोकपूजिते देवे प्रीते त्रैलोक्यकर्तरि।\nकृतमेव हि मन्यामि निवासं तु विधत्स्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083623, "chapter_id": 2783, "verse_number": "१२-२८८-२६", "content_sanskrit": "त्वया कृतेयं मर्यादा लोकसंरक्षणार्थिना।\nस्थापना वै सुमहती त्वया देव प्रवर्तिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083624, "chapter_id": 2783, "verse_number": "१२-२८८-२७", "content_sanskrit": "प्रीते तु त्वयि धर्मज्ञ सर्वलोकेश्वर प्रभो।\nशक्रादपगमिष्यामि निवासं संविधत्स्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083625, "chapter_id": 2783, "verse_number": "१२-२८८-२८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2083626, "chapter_id": 2783, "verse_number": "१२-२८८-२८", "content_sanskrit": "तथेति तां प्राह तदा ब्रह्मवध्यां पितामहः।\nउपायतः स शक्रस्य ब्रह्मवध्यां व्यपोहितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083627, "chapter_id": 2783, "verse_number": "१२-२८८-२९", "content_sanskrit": "ततः स्वयंभुवा ध्यातस्तत्र वह्निर्महात्मना।\nब्रह्माणमुपसंगम्य ततो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083628, "chapter_id": 2783, "verse_number": "१२-२८८-३०", "content_sanskrit": "प्राप्तोऽस्मि भगवन्देव त्वत्सकाशमनिन्दित्।\nयत्कर्तव्यं मया देव तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083629, "chapter_id": 2783, "verse_number": "१२-२८८-३१x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083630, "chapter_id": 2783, "verse_number": "१२-२८८-३१", "content_sanskrit": "बहुधा विभजिष्यामि ब्रह्मवध्यामिमामहम्।\nशक्रस्याद्य विमोक्षार्थं चतुर्भागं प्रतीच्छ वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083631, "chapter_id": 2783, "verse_number": "१२-२८८-३२x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083632, "chapter_id": 2783, "verse_number": "१२-२८८-३२", "content_sanskrit": "मम मोक्षस्य कोऽन्तो वै ब्रह्मन्ध्यायस्व वै प्रभो।\nएतदिच्छामि विज्ञातुं तत्वतो लोकपूजित॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083633, "chapter_id": 2783, "verse_number": "१२-२८८-३३x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083634, "chapter_id": 2783, "verse_number": "१२-२८८-३३", "content_sanskrit": "यस्त्वां ज्वलन्तमासाद्य स्वयं वै मानवः क्वचित्।\nबीजौषधिरसैर्वह्ने न यक्ष्यति तमोवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2083635, "chapter_id": 2783, "verse_number": "१२-२८८-३४", "content_sanskrit": "तमेषा यास्यति क्षिप्रं तत्रैव च निवत्स्यति।\nब्रह्मवध्या हव्यवाह व्येतु ते मानसो ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2083636, "chapter_id": 2783, "verse_number": "१२-२८८-३५", "content_sanskrit": "इत्युक्तः प्रतिजग्राह तद्वचो हव्यकव्यभुक्।\nपितामहस्य भगवांस्तथा च तदभूत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2083637, "chapter_id": 2783, "verse_number": "१२-२८८-३६", "content_sanskrit": "ततो वृक्षौषधितृणं समाहूय पितामहः।\nइममर्थं महाराज वक्तुं समुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2083638, "chapter_id": 2783, "verse_number": "१२-२८८-३७", "content_sanskrit": "`इयं पुत्रादनुप्राप्ता ब्रह्महत्या महाभया।\nपुरुहूतं चतुर्थांशमस्या यूयं प्रतीच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2083639, "chapter_id": 2783, "verse_number": "१२-२८८-३८", "content_sanskrit": "ततो वृक्षौषधितृणं तथैवोक्तं यथातथम्।\nव्यथितं वह्निवद्राजन्ब्रह्माणमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2083640, "chapter_id": 2783, "verse_number": "१२-२८८-३९", "content_sanskrit": "अस्माकं ब्रह्मवध्यायाः कोऽन्तो लोकपितामह।\nस्वभावनिहतानस्मान्न पुनर्हन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2083641, "chapter_id": 2783, "verse_number": "१२-२८८-४०", "content_sanskrit": "वयमग्निं तथा शीतं वर्षं च पवनेरितम्।\nसहामः सततं देव तथा च्छेदनभेदने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2083642, "chapter_id": 2783, "verse_number": "१२-२८८-४१", "content_sanskrit": "ब्रह्मवध्यामिमामद्य भवतः शासनाद्वयम्।\nग्रहीष्यामस्त्रिलोकेश मोक्षं चिन्तयतां भवान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2083643, "chapter_id": 2783, "verse_number": "१२-२८८-४२x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2083644, "chapter_id": 2783, "verse_number": "१२-२८८-४२", "content_sanskrit": "पर्वकाले तु संप्राप्ते यो वै छेदनभेदनम्।\nकरिष्यति नरो मोहात्तमेषाऽनुगमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2083645, "chapter_id": 2783, "verse_number": "१२-२८८-४३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2083646, "chapter_id": 2783, "verse_number": "१२-२८८-४३", "content_sanskrit": "ततो वृक्षौषधितृणमेवमुक्तं महात्मना।\nब्रह्माणमभिसंपूज्य जगामाशु यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2083647, "chapter_id": 2783, "verse_number": "१२-२८८-४४", "content_sanskrit": "आहूयाप्सरसो देवस्ततो लोकपितामहः।\nवाचा मधुरया प्राह सान्त्वयन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2083648, "chapter_id": 2783, "verse_number": "१२-२८८-४५", "content_sanskrit": "इयमिन्द्रादनुप्राप्ता ब्रह्मवध्या वराङ्गनाः।\nचतुर्थमस्या भागांशं मयोक्ताः संप्रतीच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2083649, "chapter_id": 2783, "verse_number": "१२-२८८-४६x", "content_sanskrit": "अप्सरस ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2083650, "chapter_id": 2783, "verse_number": "१२-२८८-४६", "content_sanskrit": "ग्रहणे कृतबुद्धीनां देवेश तव शासनात्।\nमोक्षं समयतोऽस्माकं चिन्तयस्व पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2083651, "chapter_id": 2783, "verse_number": "१२-२८८-४७x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2083652, "chapter_id": 2783, "verse_number": "१२-२८८-४७", "content_sanskrit": "रजस्वलासु नारीषु यो वै मैथुनमाचरेत्।\nतमेषा यास्यति क्षिप्रं व्येतु वो मानसो ज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2083653, "chapter_id": 2783, "verse_number": "१२-२८८-४८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2083654, "chapter_id": 2783, "verse_number": "१२-२८८-४८", "content_sanskrit": "तथेति हृष्टमनस इत्युक्त्वाऽऽप्सरसां गणाः।\nस्वानि स्थानानि संप्राप्य रेमिरे भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2083655, "chapter_id": 2783, "verse_number": "१२-२८८-४९", "content_sanskrit": "ततस्त्रिलोककृद्देवः पुनरेव महातपाः।\nअथः संचिन्तयामास ध्यातास्ताश्चाप्यथागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2083656, "chapter_id": 2783, "verse_number": "१२-२८८-५०", "content_sanskrit": "तास्तु सर्वाः समागम्य ब्रह्माणममितौजसम्।\nइदमूचुर्वचो राजन्प्रणिपत्य पितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2083657, "chapter_id": 2783, "verse_number": "१२-२८८-५१", "content_sanskrit": "इमाः स्म देव संप्राप्तास्त्वत्सकाशमरिंदम्।\nशासनात्तव लोकेश समाज्ञापय नः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2083658, "chapter_id": 2783, "verse_number": "१२-२८८-५२x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2083659, "chapter_id": 2783, "verse_number": "१२-२८८-५२", "content_sanskrit": "इयं वृत्रादनुप्राप्ता पुरुहूतं महाभया।\nब्रह्मवध्या चतुर्थांशमस्या यूयं प्रतीच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2083660, "chapter_id": 2783, "verse_number": "१२-२८८-५३x", "content_sanskrit": "आप ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2083661, "chapter_id": 2783, "verse_number": "१२-२८८-५३", "content_sanskrit": "एवं भवतु लोकेश यथा वदसि नः प्रभो।\nमोक्षं समयतोऽस्माकं संचिन्तयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2083662, "chapter_id": 2783, "verse_number": "१२-२८८-५४", "content_sanskrit": "त्वं हि देवेश सर्वस्य जगतः परमा गतिः।\nकोऽन्यः प्रसाद्यो हि भवेद्यः कृच्छ्रान्नः समुद्धरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2083663, "chapter_id": 2783, "verse_number": "१२-२८८-५५x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2083664, "chapter_id": 2783, "verse_number": "१२-२८८-५५", "content_sanskrit": "अल्पा इति मतिं कृत्वा यो नरो बुद्धिमोहितः।\nश्लेष्ममूत्रपुरीषाणि युष्मासु प्रतिमोक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2083665, "chapter_id": 2783, "verse_number": "१२-२८८-५६", "content_sanskrit": "तमियं यास्यति क्षिप्रं तत्रैव च निवत्स्यति।\nतथा वो भविता मोक्ष इति सत्यं ब्रवीमि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2083666, "chapter_id": 2783, "verse_number": "१२-२८८-५७", "content_sanskrit": "ततो विमुच्य देवेन्द्रं ब्रह्मवध्या युधिष्ठिर।\nयथा निसृष्टं तं वासमगमद्देवशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2083667, "chapter_id": 2783, "verse_number": "१२-२८८-५८", "content_sanskrit": "एवं शक्रेण संप्राप्ता ब्रह्मवध्या जनाधिप।\nपितामहमनुज्ञाप्य सोऽश्वमेधमकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2083668, "chapter_id": 2783, "verse_number": "१२-२८८-५९", "content_sanskrit": "श्रूयते च महाराज संप्राप्ता वासवेन वै।\nब्रह्मवध्या ततः शुद्धिं हयमेधेन लब्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2083669, "chapter_id": 2783, "verse_number": "१२-२८८-६०", "content_sanskrit": "समवाप्य श्रियं देवो हत्वाऽरींश्च सहस्रशः।\nप्रहर्षमतुलं लेभे वासवः पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2083670, "chapter_id": 2783, "verse_number": "१२-२८८-६१", "content_sanskrit": "वृत्रस्य रुधिराच्चैव बुद्बुदाः पार्थ जज्ञिरे।\nद्विजातिभिरभक्ष्यास्ते दीक्षितैश्च तपोधनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2083671, "chapter_id": 2783, "verse_number": "१२-२८८-६२", "content_sanskrit": "सर्वावस्थं त्वमप्येषां द्विजातीनां प्रियं कुरु।\nइमे हि भूतले देवाः प्रथिताः कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2083672, "chapter_id": 2783, "verse_number": "१२-२८८-६३", "content_sanskrit": "एवं शक्रेण कौरव्य बुद्धिसौक्ष्म्यान्महासुरः।\nउपायपूर्वं निहतो वृत्रो ह्यमिततेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2083673, "chapter_id": 2783, "verse_number": "१२-२८८-६४", "content_sanskrit": "एवं त्वमपि कौन्तेय पृथिव्यामपराजितः।\nभविष्यसि यथा देवः शतक्रतुरमित्रहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2083674, "chapter_id": 2783, "verse_number": "१२-२८८-६५", "content_sanskrit": "ये तु शक्रकथां दिव्यामिमां पर्वसुपर्वसु।\nविप्रमध्ये वदिष्यन्ति न ते प्राप्स्यन्ति किल्विषं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2083675, "chapter_id": 2783, "verse_number": "१२-२८८-६६", "content_sanskrit": "इत्येतद्वृत्रमाश्रित्य शक्रस्यात्यद्भुतं महत्।\nकथितं कर्म ते तात किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2083676, "chapter_id": 2783, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि अष्टाशीत्यधिकद्विशततमोऽध्यायः॥ २८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]