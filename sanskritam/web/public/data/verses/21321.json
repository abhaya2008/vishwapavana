[{"id": 7001321000, "chapter_id": 21321, "verse_number": "४-११-१", "content_sanskrit": "ऋषय ऊचुः ।\nसूतसूत महाभाग धन्यस्त्वं शिवसक्तधीः ।\nमहाबलस्य लिंगस्य श्रावितेयं कथाद्भुता॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001321001, "chapter_id": 21321, "verse_number": "४-११-२", "content_sanskrit": "उत्तरस्यां दिशायां च शिवलिंगानि यानि च ।\nतेषां माहात्म्यमनघ वद त्वं पापनाशकम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001321002, "chapter_id": 21321, "verse_number": "४-११-३", "content_sanskrit": "सूत उवाच ।\nशृणुतादरतो विप्रा औत्तराणां विशेषतः ।\nमाहात्म्यं शिवलिंगानां प्रवदामि समासतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001321003, "chapter_id": 21321, "verse_number": "४-११-४", "content_sanskrit": "गोकर्णं क्षेत्रमपरं महापातकनाशनम् ।\nमहावनं च तत्रास्ति पवित्रमतिविस्तरम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001321004, "chapter_id": 21321, "verse_number": "४-११-५", "content_sanskrit": "तत्रास्ति चन्द्रभालाख्यं शिवलिंगमनुत्तमम् ।\nरावणेन समानीतं सद्भक्त्या सर्वसिद्धिदम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001321005, "chapter_id": 21321, "verse_number": "४-११-६", "content_sanskrit": "तस्य तत्र स्थितिर्वैद्यनाथस्येव मुनीश्वराः ।\nसर्वलोकहितार्थाय करुणासागरस्य च॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001321006, "chapter_id": 21321, "verse_number": "४-११-७", "content_sanskrit": "स्नानं कृत्वा तु गोकर्णे चन्द्रभालं समर्च्य च ।\nशिवलोकमवाप्नोति सत्यंसत्यं न संशयः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001321007, "chapter_id": 21321, "verse_number": "४-११-८", "content_sanskrit": "चन्द्रभालस्य लिंगस्य महिमा परमाद्भुतः ।\nन शक्यो वर्णितुं व्यासाद्भक्तस्नेहितरस्य हि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001321008, "chapter_id": 21321, "verse_number": "४-११-९", "content_sanskrit": "चन्द्रभालमहादेव लिंगस्य महिमा महान् ।\nयथाकथंचित्संप्रोक्तः परलिंगस्य वै शृणु॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001321009, "chapter_id": 21321, "verse_number": "४-११-१०", "content_sanskrit": "दाधीचं शिवलिंगं तु मिश्रर्षिवरतीर्थके ।\nदधीचिना मुनीशेन सुप्रीत्या च प्रतिष्ठितम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001321010, "chapter_id": 21321, "verse_number": "४-११-११", "content_sanskrit": "तत्र गत्वा च तत्तीर्थे स्नात्वा सम्यग्विधानतः ।\nशिवलिंगं समर्चेद्वै दाधीचेश्वरमादरात्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001321011, "chapter_id": 21321, "verse_number": "४-११-१२", "content_sanskrit": "दाधीचमूर्तिस्तत्रैव समर्च्या विधिपूर्वकम् ।\nशिवप्रीत्यर्थमेवाशु तीर्थयात्रा फलार्थिभिः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001321012, "chapter_id": 21321, "verse_number": "४-११-१३", "content_sanskrit": "एवं कृते मुनिश्रेष्ठाः कृतकृत्यो भवेन्नरः ।\nइह सर्वसुखं भुक्त्वा परत्र गतिमाप्नुयात्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001321013, "chapter_id": 21321, "verse_number": "४-११-१४", "content_sanskrit": "नैमिषारण्यतीर्थे तु निखिलर्षिप्रतिष्ठितम् ।\nऋषीश्वरमिति ख्यातं शिवलिंगं सुखप्रदम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001321014, "chapter_id": 21321, "verse_number": "४-११-१५", "content_sanskrit": "तद्दर्शनात्पूजनाच्च जनानां पापिनामपि ।\nभुक्तिमुक्तिश्च तेषां तु परत्रेह मुनीश्वराः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001321015, "chapter_id": 21321, "verse_number": "४-११-१६", "content_sanskrit": "हत्याहरणतीर्थे तु शिवलिंगमघापहम् ।\nपूजनीयं विशेषेण हत्याकोटिविनाशनम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001321016, "chapter_id": 21321, "verse_number": "४-११-१७", "content_sanskrit": "देवप्रयागतीर्थे तु ललितेश्वरनामकम् ।\nशिवलिंगं सदा पूज्यं नरैस्सर्वाघनाशनम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001321017, "chapter_id": 21321, "verse_number": "४-११-१८", "content_sanskrit": "नयपालाख्यपुर्य्यां तु प्रसिद्धायां महीतले ।\nलिंगं पशुपतीशाख्यं सर्वकामफलप्रदम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001321018, "chapter_id": 21321, "verse_number": "४-११-१९", "content_sanskrit": "शिरोभागस्वरूपेण शिवलिंगं तदस्ति हि ।\nतत्कथां वर्णयिष्यामि केदारेश्वरवर्णने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001321019, "chapter_id": 21321, "verse_number": "४-११-२०", "content_sanskrit": "तदारान्मुक्तिनाथाख्यं शिवलिंगं महाद्भुतम् ।\nदर्शनादर्चनात्तस्य भुक्तिर्मुक्तिश्च लभ्यते॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]