[{"id": 7000616000, "chapter_id": 20616, "verse_number": "५-७५-१", "content_sanskrit": "पार्वत्युवाच ।\nवृंदावनरहस्यं च बहुधा कथितं विभो ।\nकेन पुण्यविशेषेण नारदः प्रकृतिं गतः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000616001, "chapter_id": 20616, "verse_number": "५-७५-२", "content_sanskrit": "ईश्वर उवाच ।\nएकदाश्चर्यवृत्तांतं मया जिज्ञासितं पुरा ।\nब्रह्मणा कथितं गुह्यं श्रुतं कृष्णमुखांबुजात्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000616002, "chapter_id": 20616, "verse_number": "५-७५-३", "content_sanskrit": "नारदः पृष्टवान्मह्यं तदाहं प्राप्तवानिदम् ।\nअहं वक्तुं न शक्नोमि तन्माहात्म्यं कथंचन॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000616003, "chapter_id": 20616, "verse_number": "५-७५-४", "content_sanskrit": "किं कुर्वे शपनं तस्य स्मृत्वा सीदामि मानसे ।\nइति श्रुत्वा मम वचो दुर्मनाः सोऽभवद्यदा॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000616004, "chapter_id": 20616, "verse_number": "५-७५-५", "content_sanskrit": "तदा ब्रह्माणमाहूय अहमादिष्टवान्प्रिये ।\nत्वया यत्कथितं मह्यं नारदाय वदस्व तत्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000616005, "chapter_id": 20616, "verse_number": "५-७५-६", "content_sanskrit": "ब्रह्मा तदा ममवचो निशम्य सह नारदः ।\nजगाम कृष्णसविधं नत्वा पृच्छत्तदेव तु॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000616006, "chapter_id": 20616, "verse_number": "५-७५-७", "content_sanskrit": "ब्रह्मोवाच ।\nकिमिदं द्वात्रिंशद्वनं वृंदारण्यं विशांपते ।\nश्रोतुमिच्छामि भगवन्यदियोग्योऽस्मि मे वद॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000616007, "chapter_id": 20616, "verse_number": "५-७५-८", "content_sanskrit": "श्रीभगवानुवाच ।\nइदं वृंदावनं रम्यं मम धामैव केवलम् ।\nयत्रेमे पशवः साक्षाद्वृक्षाः कीटा नरामराः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000616008, "chapter_id": 20616, "verse_number": "५-७५-९", "content_sanskrit": "ये वसंति ममांत्ये ते मृता यांति ममांतिकम् ।\nअत्र या गोपपत्न्यश्च निवसंति ममालये॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000616009, "chapter_id": 20616, "verse_number": "५-७५-१०", "content_sanskrit": "योगिन्यस्तास्तु एवं हि मम देवाः परायणाः ।\nपंचयोजनमेवं हि वनं मे देवरूपकम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000616010, "chapter_id": 20616, "verse_number": "५-७५-११", "content_sanskrit": "कालिंदीयं सुषुम्नाख्या परमामृतवाहिनी ।\nयत्र देवाश्च भूतानि वर्त्तंते सूक्ष्मरूपतः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000616011, "chapter_id": 20616, "verse_number": "५-७५-१२", "content_sanskrit": "सर्वतो व्यापकश्चाहं न त्यक्ष्यामि वनं क्वचित् ।\nआविर्भावस्तिरोभावो भवेदत्र युगेयुगे॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000616012, "chapter_id": 20616, "verse_number": "५-७५-१३", "content_sanskrit": "तेजोमयमिदं स्थानमदृश्यं चर्मचक्षुषाम् ।\nरहस्यं मे प्रभावं च पश्य वृंदावनं युगे॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000616013, "chapter_id": 20616, "verse_number": "५-७५-१४", "content_sanskrit": "ब्रह्मादीनां देवतानां न दृश्यं तत्कथंचन ।\nईश्वर उवाच ।\nतच्छ्रुत्वा नारदो नत्वा कृष्णं ब्रह्माणमेव च॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000616014, "chapter_id": 20616, "verse_number": "५-७५-१५", "content_sanskrit": "आजगाम ह भूर्लोके मिश्रकं नैमिषं वनम् ।\nतत्रासौ सत्कृतश्चापि शौनकाद्यैर्मुनीश्वरैः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000616015, "chapter_id": 20616, "verse_number": "५-७५-१६", "content_sanskrit": "पृष्टश्चाप्यागतो ब्रह्मन्कुतस्त्वमधुना वद ।\nतच्छ्रुत्वा नारदः प्राह गोलोकादागतोऽस्म्यहम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000616016, "chapter_id": 20616, "verse_number": "५-७५-१७", "content_sanskrit": "श्रुत्वा कृष्णमुखांभोजाद्वृंदावनरहस्यकम् ।\nनारद उवाच ।\nतत्र नानाविधाः प्रश्नाः कृताश्चैव पुनः पुनः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000616017, "chapter_id": 20616, "verse_number": "५-७५-१८", "content_sanskrit": "समस्ता मनवस्तत्र योगाश्चैव मया श्रुताः ।\nतानेव कथयिष्यामि यथाप्रश्नं च तत्त्वतः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000616018, "chapter_id": 20616, "verse_number": "५-७५-१९", "content_sanskrit": "शौनकादय ऊचुः ।\nवृंदारण्यरहस्यं हि यदुक्तं ब्रह्मणा त्वयि ।\nतदस्माकं समाचक्ष्व यद्यस्मासु कृपा तव॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000616019, "chapter_id": 20616, "verse_number": "५-७५-२०", "content_sanskrit": "नारद उवाच ।\nकदाचित्सरयूतीरे दृष्टोऽस्माभिश्च गौतमः ।\nमनस्वी च महादुःखी चिंताकुलितचेतनः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000616020, "chapter_id": 20616, "verse_number": "५-७५-२१", "content_sanskrit": "मां दृष्ट्वा गौतमो देवः पपात धरणीतले ।\nउत्तिष्ठ वत्सवत्सेति तमुवाचाहमेव हि॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000616021, "chapter_id": 20616, "verse_number": "५-७५-२२", "content_sanskrit": "कथं भवान्मनस्वीति प्रोच्य तां यदि रोचते ।\nगौतम उवाच ।\nश्रुतं तव मुखादेव कृष्णतत्त्वं च तादृशम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000616022, "chapter_id": 20616, "verse_number": "५-७५-२३", "content_sanskrit": "द्वारकाख्यं माथुराख्यं रहस्यं बहुशो मया ।\nवृंदावनरहस्यं तु न श्रुतं त्वन्मुखांबुजात्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000616023, "chapter_id": 20616, "verse_number": "५-७५-२४", "content_sanskrit": "यतो मे मनसः स्थैर्य्यं भविष्यति च सद्गुरो ।\nनारद उवाच ।\nइदं तु परमं गुह्यं रहस्यातिरहस्यकम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000616024, "chapter_id": 20616, "verse_number": "५-७५-२५", "content_sanskrit": "पुरा मे ब्रह्मणा प्रोक्तं तादृग्वृंदावनोद्भवम् ।\nरहस्यं वद देवेश वृंदारण्यस्य मे पितः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000616025, "chapter_id": 20616, "verse_number": "५-७५-२६", "content_sanskrit": "इतिजिज्ञासितं श्रुत्वा क्षणं मौनी स चाभवत् ।\nततो माऽह महाविष्णुं गच्छ वत्स प्रभुं मम॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000616026, "chapter_id": 20616, "verse_number": "५-७५-२७", "content_sanskrit": "मयापि तत्र गंतव्यं त्वया सह न संशयः ।\nइत्युक्त्वा मां गृहीत्वा च गतो विष्णोश्च धामनि॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000616027, "chapter_id": 20616, "verse_number": "५-७५-२८", "content_sanskrit": "महाविष्णौ च कथितं मयोक्तं यत्तदेव हि ।\nतच्छ्रुत्वा च महाविष्णुः स्वयं भुवमथादिशत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000616028, "chapter_id": 20616, "verse_number": "५-७५-२९", "content_sanskrit": "त्वमेवादेशतो मह्यं नीत्वा वै नारदं मुनिम् ।\nस्नानाय विनियुंक्ष्वामुं सरस्यमृतसंज्ञके॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000616029, "chapter_id": 20616, "verse_number": "५-७५-३०", "content_sanskrit": "महाविष्णुसमादिष्टः स्वयंभूर्मां तथाकरोत् ।\nतत्रामृतसरश्चाहं प्रविश्य स्नानमाचरम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000616030, "chapter_id": 20616, "verse_number": "५-७५-३१", "content_sanskrit": "तत्क्षणात्तत्सरः पारे योषितां सविधेऽभवम् ।\nसर्वलक्षणसपन्ना योषिद्रूपातिविस्मिता॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000616031, "chapter_id": 20616, "verse_number": "५-७५-३२", "content_sanskrit": "मां दृष्ट्वा ताः समायांतीमपृच्छंश्च मुहुर्मुहुः ।\nस्त्रिय ऊचुः ।\nका त्वं कुतः समायाता कथयात्मविचेष्टितम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000616032, "chapter_id": 20616, "verse_number": "५-७५-३३", "content_sanskrit": "तासां प्रियकथां श्रुत्वा मयोक्तं तन्निशामय ।\nकुतः कोऽहं समायातः कथं वा योषिदाकृतिः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000616033, "chapter_id": 20616, "verse_number": "५-७५-३४", "content_sanskrit": "स्वप्नवद्दृश्यते सर्वं किं वा मुग्धोऽस्मि भूतले ।\nतच्छ्रुत्वा मद्वचो देवी प्रोवाच मधुरस्वनैः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000616034, "chapter_id": 20616, "verse_number": "५-७५-३५", "content_sanskrit": "वृंदानाम्नी पुरी चेयं कृष्णचंद्रप्रिया सदा ।\nअहं च ललितादेवी तुर्यातीता च निष्कला॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000616035, "chapter_id": 20616, "verse_number": "५-७५-३६", "content_sanskrit": "इत्युक्त्वा च महादेवी करुणा सांद्रमानसा ।\nमां प्रत्याह पुनर्देवी समागच्छ मया सह॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000616036, "chapter_id": 20616, "verse_number": "५-७५-३७", "content_sanskrit": "अन्याश्च योषितः सर्वाः कृष्णपादपरायणाः ।\nताश्च मां प्रवदंत्येवं समागच्छानया सह॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000616037, "chapter_id": 20616, "verse_number": "५-७५-३८", "content_sanskrit": "ततोनुकृष्णचंद्रस्य चतुर्दशाक्षरो मनुः ।\nकृपया कथितस्तस्या देव्याश्चापि महात्मनः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000616038, "chapter_id": 20616, "verse_number": "५-७५-३९", "content_sanskrit": "तत्क्षणादेव तत्साम्यमलभं विविधोपमा ।\nताभिः सह गतास्तत्र यत्र कृष्णः सनातनः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000616039, "chapter_id": 20616, "verse_number": "५-७५-४०", "content_sanskrit": "केवलं सच्चिदानंदः स्वयंयोषिन्मयः प्रभुः ।\nयोषिदानंदहृदयो दृष्ट्वा मां प्राब्रवीन्मुहुः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000616040, "chapter_id": 20616, "verse_number": "५-७५-४१", "content_sanskrit": "समागच्छ प्रिये कांते भक्त्या मां परिरंभय ।\nरेमे वर्षप्रमाणेन तत्र चैव द्विजोत्तम॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000616041, "chapter_id": 20616, "verse_number": "५-७५-४२", "content_sanskrit": "तदोक्तं रमणेशेन तां देवीं राधिकां प्रति ।\nइयं मे प्रकृतिस्तत्र चासीन्नारदरूपधृक्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000616042, "chapter_id": 20616, "verse_number": "५-७५-४३", "content_sanskrit": "नीत्वामृतसरो रम्यं स्नानार्थं संनियोजय ।\nतया मे रमणस्यांते गदितं प्रियभाषितम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000616043, "chapter_id": 20616, "verse_number": "५-७५-४४", "content_sanskrit": "अहं च ललितादेवी राधिकाया च गीयते ।\nअहं च वासुदेवाख्यो नित्यं कामकलात्मकः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000616044, "chapter_id": 20616, "verse_number": "५-७५-४५", "content_sanskrit": "सत्यं योषित्स्वरूपोऽहं योषिच्चाहं सनातनी ।\nअहं च ललितादेवी पुंरूपा कृष्णविग्रहा॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000616045, "chapter_id": 20616, "verse_number": "५-७५-४६", "content_sanskrit": "आवयोरंतरं नास्ति सत्यंसत्यं हि नारद ।\nएवं यो वेत्ति मे तत्त्वं समयं च तथा मनुम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000616046, "chapter_id": 20616, "verse_number": "५-७५-४७", "content_sanskrit": "स समाचारसंकेतं ललिता वत्स मे प्रियः ।\nइदं वृंदावनं नाम रहस्यं मम वै गृहम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000616047, "chapter_id": 20616, "verse_number": "५-७५-४८", "content_sanskrit": "न प्रकाश्यं कदा कुत्र वक्तव्यं न पशौ क्वचित् ।\nततोऽनुराधिकादेवी मां नीत्वा तत्सरोवरे॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000616048, "chapter_id": 20616, "verse_number": "५-७५-४९", "content_sanskrit": "स्थित्वा सा कृष्णचंद्रस्य चरणांते गता पुनः ।\nततो निमज्जनादेव नारदोऽहमुपागतः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000616049, "chapter_id": 20616, "verse_number": "५-७५-५०", "content_sanskrit": "वीणाहस्तो गानपरस्तद्रहस्यं मुहुर्मुदा ।\nस्वयंभुवं नमस्कृत्य तत्रागां विष्णुपार्षदम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000616050, "chapter_id": 20616, "verse_number": "५-७५-५१", "content_sanskrit": "स्वयंभुवा तथा दृष्टं नोक्तं किंचित्तदा पुनः ।\nइति ते कथितं वत्स सुगोप्यं च मया त्वयि॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000616051, "chapter_id": 20616, "verse_number": "५-७५-५२", "content_sanskrit": "त्वयापि कृष्णचंद्रस्य केवलं धामचित्कलम् ।\nगोपनीयं प्रयत्नेन मातुर्जारैव प्रियम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000616052, "chapter_id": 20616, "verse_number": "५-७५-५३", "content_sanskrit": "यथा प्रोक्तं मया शिष्ये गौतमे सरहस्यकम् ।\nतथा भवत्सु कार्त्स्न्येन कथितं चातिगोपितम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000616053, "chapter_id": 20616, "verse_number": "५-७५-५४", "content_sanskrit": "यत्र कुत्र कदाचित्तु प्रकाश्यं मुनिपुंगवाः ।\nतदा शापो भवेद्विप्राः कृष्णचंद्रस्य निश्चितम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000616054, "chapter_id": 20616, "verse_number": "५-७५-५५", "content_sanskrit": "इमं कृष्णस्य लीलाभिर्युतमध्यायमुत्तमम् ।\nयः पठेच्छृणुयाद्वापि स याति परमं पदम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]