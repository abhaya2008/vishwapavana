[{"id": 7002995000, "chapter_id": 22995, "verse_number": "२-४२-१", "content_sanskrit": "नारायण उवाच ।\nउक्तं स्वाहास्वधाख्यानं प्रशस्तं मधुरं परम् ।\nवक्ष्यामि दक्षिणाख्यानं सावधानं निशामय ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002995001, "chapter_id": 22995, "verse_number": "२-४२-२", "content_sanskrit": "गोपी सुशीला गोलोके पुराऽऽसीत्प्रेयसी हरेः ।\nराधाप्रधाना सध्रीची धन्या मान्या मनोहरा ।\nअतीव सुन्दरी रामा सुभगा सुदती सती ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002995002, "chapter_id": 22995, "verse_number": "२-४२-३", "content_sanskrit": "विद्यावती गुणवती सती रूपवती तथा ।\nकलावती कोमलांगी कान्ता कमललोचना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002995003, "chapter_id": 22995, "verse_number": "२-४२-४", "content_sanskrit": "सुश्रोणी सुस्तनी श्यामा न्यग्रोधपरिमण्डला ।\nईषद्धास्यप्रसन्नास्या रत्नालङ्कारभूषिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002995004, "chapter_id": 22995, "verse_number": "२-४२-५", "content_sanskrit": "श्वेतचम्पकवर्णाभा बिम्बोष्ठी मृगलोचना ।\nकामशास्त्रसुनिष्णाता कामिनी कलहंसगा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002995005, "chapter_id": 22995, "verse_number": "२-४२-६", "content_sanskrit": "भावानुरक्ता भावज्ञा कृष्णस्य प्रियभामिनी ।\nरसज्ञा रसिका रासे रासेशस्य रसोत्सुका ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002995006, "chapter_id": 22995, "verse_number": "२-४२-७", "content_sanskrit": "उवास दक्षिणे क्रोडे राधायाः पुरतः पुरा ।\nसंबभूवानम्रमुखो भयेन मधुसूदनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002995007, "chapter_id": 22995, "verse_number": "२-४२-८", "content_sanskrit": "दृष्ट्वा राधां च पुरतो गोपीनां प्रवरां वराम् ।\nमानिनीं रक्तवदनां रक्तपङ्कजलोचनाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002995008, "chapter_id": 22995, "verse_number": "२-४२-९", "content_sanskrit": "कोपेन कम्पिताङ्गी च कोपनां कोपदर्शनाम् ।\nकोपेन निष्ठुरं वक्तुमुद्यतां स्फुरिताधराम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002995009, "chapter_id": 22995, "verse_number": "२-४२-१०", "content_sanskrit": "आगच्छन्तीं च वेगेन विज्ञाय तदनन्तरम् ।\nविरोधभीतो भगवानन्तर्द्धानं जगाम सः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002995010, "chapter_id": 22995, "verse_number": "२-४२-११", "content_sanskrit": "पलायन्तं च तं शान्तं सत्त्वाधारं सुविग्रहम् ।\nविलोक्य कम्पिता गोपी सुशीलाऽन्तर्दधौ भिया ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002995011, "chapter_id": 22995, "verse_number": "२-४२-१२", "content_sanskrit": "विलोक्य सङ्कटं तत्र गोपीनां लक्षकोटयः ।\nबद्धाञ्जलिपुटा भीता भक्तिनम्रात्मकन्धराः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002995012, "chapter_id": 22995, "verse_number": "२-४२-१३", "content_sanskrit": "रक्ष रक्षेत्युक्तवत्यो हे देवीति पुनः पुनः ।\nययुर्भयेन शरणं तस्याश्चरणपङ्कजे॥ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002995013, "chapter_id": 22995, "verse_number": "२-४२-१४", "content_sanskrit": "त्रिलक्षकोटयो गोपाः सुदामादय एव च ।\nययुर्भयेन शरणं तत्पादाब्जे च नारद ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002995014, "chapter_id": 22995, "verse_number": "२-४२-१५", "content_sanskrit": "पलायन्तं च कान्तं वै विज्ञाय परमेश्वरी ।\nपलायन्तीं सहचरीं सुशीलां च शशाप सा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002995015, "chapter_id": 22995, "verse_number": "२-४२-१६", "content_sanskrit": "अद्यप्रभृति गोलोकं सा चेदायाति गोपिका ।\nसद्यो गमनमात्रेण भस्मसाच्च भविष्यति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002995016, "chapter_id": 22995, "verse_number": "२-४२-१७", "content_sanskrit": "इत्येवमुक्त्वा तत्रैव देवदेवीश्वरी रुषा ।\nरासेश्वरी रासमध्ये रासेशं चाजुहाव ह॥ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002995017, "chapter_id": 22995, "verse_number": "२-४२-१८", "content_sanskrit": "नालोक्य पुरतः कृष्णं राधा विरहकातरा ।\nयुगकोटिसमं मेने क्षणभेदेन सुव्रता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002995018, "chapter_id": 22995, "verse_number": "२-४२-१९", "content_sanskrit": "हे कृष्ण हे प्राणनाथागच्छ प्राणाधिकप्रिय ।\nप्राणाधिष्ठातृदेवेह प्राणा यान्ति त्वया विना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002995019, "chapter_id": 22995, "verse_number": "२-४२-२०", "content_sanskrit": "स्त्रीगर्वः पतिसौभाग्याद्वर्द्धते च दिने दिने ।\nसुस्त्री चेद्विभवो यस्मात्ते भजेद्धर्मतः सदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002995020, "chapter_id": 22995, "verse_number": "२-४२-२१", "content_sanskrit": "पतिर्बन्धुः कुलस्त्रीणामधिदेवः सदा गतिः ।\nपरं सम्पत्स्वरूपश्च सुखरूपश्च मूर्त्तिमान्॥ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002995021, "chapter_id": 22995, "verse_number": "२-४२-२२", "content_sanskrit": "धर्मदः सुखदः शश्वत्प्रीतिदः शान्तिदः सदा ।\nसम्मानदो मानदश्च मान्यो वै मानखण्डनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002995022, "chapter_id": 22995, "verse_number": "२-४२-२३", "content_sanskrit": "सारात्सारतमः स्वामी बन्धूनां बन्धुवर्द्धनः ।\nन च भर्त्तुः समो बन्धुः सर्वबन्धुषु दृश्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002995023, "chapter_id": 22995, "verse_number": "२-४२-२४", "content_sanskrit": "भरणादेव भर्ताऽयं पालनात्पतिरुच्यते ।\nशरीरेशाच्च स स्वामी कामदः कान्त एव च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002995024, "chapter_id": 22995, "verse_number": "२-४२-२५", "content_sanskrit": "बन्धुश्च सुखबन्धाच्च प्रीतिदानात्प्रियः परः ।\nऐश्वर्य्यदानादीशश्च प्राणेशात्प्राणनायकः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002995025, "chapter_id": 22995, "verse_number": "२-४२-२६", "content_sanskrit": "रतिदानाच्च रमणः प्रियो नास्ति प्रियात्परः ।\nपुत्रस्तु स्वामिनः शुक्राज्जायते तेन स प्रियः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002995026, "chapter_id": 22995, "verse_number": "२-४२-२७", "content_sanskrit": "शतपुत्रात्परःस्वामी कुलजानां प्रियः सदा ।\nअसत्कुलप्रसूता या कान्तं विज्ञातुमक्षमा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002995027, "chapter_id": 22995, "verse_number": "२-४२-२८", "content_sanskrit": "स्नानं च सर्वतीर्थेषु सर्वयज्ञेषु दीक्षणम् ।\nप्रादक्षिण्यं पृथिव्याश्च सर्वाणि च तपांसि वै ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002995028, "chapter_id": 22995, "verse_number": "२-४२-२९", "content_sanskrit": "सर्वाण्येव व्रतादीनि महादानानि यानि च ।\nउपोषणानि पुण्यानि यान्यन्यानि च विश्वतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002995029, "chapter_id": 22995, "verse_number": "२-४२-३०", "content_sanskrit": "गुरुसेवाविप्रसेवादेवसेवादिकं च यत ।\nस्वामिनः पादसेवायाः कलां नार्हन्ति षोडशीम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002995030, "chapter_id": 22995, "verse_number": "२-४२-३१", "content_sanskrit": "गुरुविप्रेष्टदेवेषु सर्वेभ्यश्च पतिर्गुरुः ।\nविद्यादाता यथा पुंसां कुलजानां तथा प्रियः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002995031, "chapter_id": 22995, "verse_number": "२-४२-३२", "content_sanskrit": "गोपीत्रिलक्षकोटीनां गोपानां च तथैव च ।\nब्रह्माण्डानामसंख्यानां तत्रस्थानां तथैव च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002995032, "chapter_id": 22995, "verse_number": "२-४२-३३", "content_sanskrit": "रमादिगोपकान्तानामीश्वरी तत्प्रसादतः ।\nअहं न जाने तं कान्तं स्त्रीस्वभावो दुरत्ययः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002995033, "chapter_id": 22995, "verse_number": "२-४२-३४", "content_sanskrit": "इत्युक्त्वा राधिका कृष्णं तत्र दध्यौ सुभक्तितः ।\nआरात्संप्राप तं तेन विजहार च तत्र वै ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002995034, "chapter_id": 22995, "verse_number": "२-४२-३५", "content_sanskrit": "अथ सा दक्षिणादेवी ध्वस्ता गोलोकतो मुने ।\nसुचिरं च तपस्तप्त्वा विवेश कमलातनौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002995035, "chapter_id": 22995, "verse_number": "२-४२-३६", "content_sanskrit": "अथ देवादयः सर्वे यज्ञं कृत्वा सुदुष्करम् ।\nन लभन्ते फलं तेषां विषण्णाः प्रययुर्विधिम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002995036, "chapter_id": 22995, "verse_number": "२-४२-३७", "content_sanskrit": "विधिर्निवेदनं श्रुत्वा देवादीनां जगत्पतिः ।\nदध्यौ सुचिन्तितो भक्त्या तत्प्रत्यादेशमाप सः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002995037, "chapter_id": 22995, "verse_number": "२-४२-३८", "content_sanskrit": "नारायणश्च भगवान्महालक्ष्मीश्च देहतः ।\nमर्त्यलक्ष्मीं विनिष्कृष्य ब्रह्मणे दक्षिणां ददौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002995038, "chapter_id": 22995, "verse_number": "२-४२-३९", "content_sanskrit": "ब्रह्मा ददौ तां यज्ञाय पूर्णार्थं कर्मणां सताम् ।\nयज्ञः संपूज्य विधिवत्तां तुष्टाव रमां मुदा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002995039, "chapter_id": 22995, "verse_number": "२-४२-४०", "content_sanskrit": "तप्तकाञ्चनवर्णाभां चन्द्रकोटिसमप्रभाम् ।\nअतीव कमनीयां च सुन्दरीं सुमनोहराम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002995040, "chapter_id": 22995, "verse_number": "२-४२-४१", "content_sanskrit": "कमलास्यां कोमलाङ्गीं कमलायतलोचनाम् ।\nकमलासनसंपूज्यां कमलाङ्गःसमुद्रवाम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002995041, "chapter_id": 22995, "verse_number": "२-४२-४२", "content_sanskrit": "वह्निशुद्धांशुकाधानां बिम्बोष्ठीं सुदतीं सतीम् ।\nबिभ्रतीं कबरीभारं मालतीमाल्यभूषितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002995042, "chapter_id": 22995, "verse_number": "२-४२-४३", "content_sanskrit": "ईषद्धास्यप्रसन्नास्यां रत्नभूषणभूषिताम् ।\nसुवेषाढ्यां च सुस्नातां मुनिमानसमोहिनीम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002995043, "chapter_id": 22995, "verse_number": "२-४२-४४", "content_sanskrit": "कस्तूरीबिन्दुभिः सार्द्धं चन्दनैश्च सुगन्धिभिः ।\nसिन्दूरबिन्दुनाऽत्यन्तं मस्तकाधस्थलोज्ज्वलाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002995044, "chapter_id": 22995, "verse_number": "२-४२-४५", "content_sanskrit": "सुप्रशस्तनितम्बाढ्यां बृहच्छ्रोणिपयोधराम् ।\nकामदेवाधाररूपां कामबाणप्रपीडिताम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002995045, "chapter_id": 22995, "verse_number": "२-४२-४६", "content_sanskrit": "तां दृष्ट्वा रमणीयां च यज्ञो मूर्च्छामवाप ह ।\nपत्नीं तामेव जग्राह विधिबोधितमार्गतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002995046, "chapter_id": 22995, "verse_number": "२-४२-४७", "content_sanskrit": "दिव्यं वर्षशतं चैव तां गृहीत्वाऽथ निर्जने ।\nयज्ञो रेमे मुदा युक्तो रामया रमया सह ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002995047, "chapter_id": 22995, "verse_number": "२-४२-४८", "content_sanskrit": "गर्भं दधार सा देवी दिव्यं द्वादशवत्सरम् ।\nततः सुषाव पुत्रं च फलं वै सर्वकर्मणाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002995048, "chapter_id": 22995, "verse_number": "२-४२-४९", "content_sanskrit": "कर्मणां फलदाता च दक्षिणा कर्मणां सताम् ।\nपरिपूर्णे कर्मणि च तत्पुत्रः फलदायकः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002995049, "chapter_id": 22995, "verse_number": "२-४२-५०", "content_sanskrit": "यज्ञो दक्षिणया सार्द्धं पुत्रेण च फलेन च ।\nकर्मणां फलदाता चेत्येवं वेदविदो विदुः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002995050, "chapter_id": 22995, "verse_number": "२-४२-५१", "content_sanskrit": "यज्ञश्च दक्षिणां प्राप्य पुत्रं च फलदायकम् ।\nफलं ददौ च सर्वेभ्यः कर्मठेभ्यो यदा मुने ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002995051, "chapter_id": 22995, "verse_number": "२-४२-५२", "content_sanskrit": "तदा देवादयस्तुष्टाः परिपूर्णमनोरथाः ।\nस्वस्थानं प्रययुः सर्वे धर्मवक्त्रादिदं श्रुतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002995052, "chapter_id": 22995, "verse_number": "२-४२-५३", "content_sanskrit": "कृत्वा कर्म च कर्ता तु तूर्णं दद्याच्च दक्षिणाम् ।\nतत्क्षणं फलमाप्नोति वेदैरुक्तमिदं मुने ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002995053, "chapter_id": 22995, "verse_number": "२-४२-५४", "content_sanskrit": "कर्ता कर्मणि पूर्णेऽपि तत्क्षणाद्यदि दक्षिणाम् ।\nन दद्याद्ब्राह्मणेभ्यश्च दैवेनाज्ञानतोऽथवा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002995054, "chapter_id": 22995, "verse_number": "२-४२-५५", "content_sanskrit": "मुहूर्त्ते समतीते च द्विगुणा सा भवेद्ध्रुवम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002995055, "chapter_id": 22995, "verse_number": "२-४२-५६", "content_sanskrit": "एकरात्रे व्यतीते तु भवेद्रसगुणा च सा ।\nत्रिरात्रे वै दशगुणा सप्ताहे द्विगुणा ततः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002995056, "chapter_id": 22995, "verse_number": "२-४२-५७", "content_sanskrit": "मासे लक्षगुणा प्रोक्ता ब्राह्मणानां च वर्द्धते ।\nसंवत्सरे व्यतीते तु सा त्रिकोटिगुणा भवेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002995057, "chapter_id": 22995, "verse_number": "२-४२-५८", "content_sanskrit": "कर्म्म तद्यजमानानां सर्वं वै निष्फलं भवेत् ।\nस च ब्रह्मस्वापहारी न कर्मार्होऽशुचिर्नरः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002995058, "chapter_id": 22995, "verse_number": "२-४२-५९", "content_sanskrit": "दरिद्रो व्याधियुक्तश्च तेन पापेन पातकी ।\nतद्गृहाद्याति लक्ष्मीश्च शापं दत्त्वा सुदारुणम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002995059, "chapter_id": 22995, "verse_number": "२-४२-६०", "content_sanskrit": "पितरो नैव गृह्णन्ति तद्दत्तं श्राद्धतर्पणम् ।\nएवं सुराश्च तत्पूजां तद्दत्तां पावकाहुतिम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002995060, "chapter_id": 22995, "verse_number": "२-४२-६१", "content_sanskrit": "दाता ददाति नो दानं ग्रहीता तन्न याचते ।\nउभौ तौ नरकं यातश्छिन्नरज्जुर्यथा घटः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002995061, "chapter_id": 22995, "verse_number": "२-४२-६२", "content_sanskrit": "नार्पयेद्यजमानश्चेद्याचितारं च दक्षिणाम् ।\nभवेद्ब्रह्मस्वापहारी कुम्भीपाकं व्रजेद्ध्रुवम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002995062, "chapter_id": 22995, "verse_number": "२-४२-६३", "content_sanskrit": "वर्षलक्षं वसेत्तत्र यमदूतेन ताडितः ।\nततो भवेत्स चण्डालो व्याधियुक्तो दरिद्रकः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002995063, "chapter_id": 22995, "verse_number": "२-४२-६४", "content_sanskrit": "पातयेत्पुरुषान्सप्त पूर्वान्वै पूर्वजन्मनः ।\nइत्येवं कथितं विप्र किं भूयः श्रोतुमिच्छसि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002995064, "chapter_id": 22995, "verse_number": "२-४२-६५", "content_sanskrit": "नारद उवाच ।\nयत्कर्म दक्षिणाहीनं को भुङ्क्ते तत्फलं मुने ।\nपूजाविधिं दक्षिणायाः पुरा यज्ञकृतं वद ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002995065, "chapter_id": 22995, "verse_number": "२-४२-६६", "content_sanskrit": "नारायण उवाच ।\nकर्मणोऽदक्षिणस्यैव कुत एव फलं मुने ।\nसदक्षिणे कर्मणि च फलमेव प्रवर्त्तते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002995066, "chapter_id": 22995, "verse_number": "२-४२-६७", "content_sanskrit": "या या कर्मणि सामग्री बलिर्भुङ्क्ते च तां मुने ।\nबलये तत्प्रदत्तं च वामनेन पुरा मुने ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002995067, "chapter_id": 22995, "verse_number": "२-४२-६८", "content_sanskrit": "अश्रोत्रियं श्राद्धवस्तु चाश्राद्धं दानमेव च ।\nवृषलीपतिविप्राणां पूजाद्रव्यादिकं च यत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002995068, "chapter_id": 22995, "verse_number": "२-४२-६९", "content_sanskrit": "ऋत्विजा न कृतं यज्ञमशुचेः पूजनं च यत् ।\nगुरावभक्तस्य कर्म बलिर्भुङ्क्ते न संशयः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002995069, "chapter_id": 22995, "verse_number": "२-४२-७०", "content_sanskrit": "दक्षिणायाश्च यद्ध्यानं स्तोत्रं पूजाविधिक्रमम् ।\nतत्सर्वं काण्वशाखोक्तं प्रवक्ष्यामि निशामय ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002995070, "chapter_id": 22995, "verse_number": "२-४२-७१", "content_sanskrit": "पुरा संप्राप्य तां यज्ञः कर्मदक्षां च दक्षिणाम् ।\nमुमोह तस्या रूपेण तुष्टुवे कामकातरः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002995071, "chapter_id": 22995, "verse_number": "२-४२-७२", "content_sanskrit": "यज्ञ उवाच ।\nपुरा गोलोकगोपी त्वं गोपीनां प्रवरा परा ।\nराधासमा तत्सखी च श्रीकृष्णप्रेयसी प्रिये ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002995072, "chapter_id": 22995, "verse_number": "२-४२-७३", "content_sanskrit": "कार्त्तिकीपूर्णिमायां तु रासे राधामहोत्सवे ।\nआविर्भूता दक्षिणांशात्कृष्णस्यातो हि दक्षिणा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002995073, "chapter_id": 22995, "verse_number": "२-४२-७४", "content_sanskrit": "पुरा त्वं च सुशीलाख्या शीलेन सुशुभेन च ।\nकृष्णदक्षांशवासाच्च राधाशापाच्च दक्षिणा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002995074, "chapter_id": 22995, "verse_number": "२-४२-७५", "content_sanskrit": "गोलोकात्त्वं परिध्वस्ता मम भाग्यादुपस्थिता ।\nकृपां कुरु त्वमेवाद्य स्वामिनं कुरु मां प्रिये ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002995075, "chapter_id": 22995, "verse_number": "२-४२-७६", "content_sanskrit": "कर्तॄणां कर्मणां देवी त्वमेव फलदा सदा ।\nत्वया विना च सर्वेषां सर्व कर्म च निष्फलम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002995076, "chapter_id": 22995, "verse_number": "२-४२-७७", "content_sanskrit": "फलशाखाविहीनश्च यथा वृक्षो महीतले ।\nत्वया विना तथा कर्म कर्तॄणां च न शोभते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002995077, "chapter_id": 22995, "verse_number": "२-४२-७८", "content_sanskrit": "ब्रह्मविष्णुमहेशाश्च दिक्पालादय एव च ।\nकर्मणश्च फलं दातुं न शक्ताश्च त्वया विना ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002995078, "chapter_id": 22995, "verse_number": "२-४२-७९", "content_sanskrit": "कर्मरूपी स्वयं ब्रह्मा फलरूपी महेश्वरः ।\nयज्ञरूपी विष्णुरहं त्वमेषां साररूपिणी ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002995079, "chapter_id": 22995, "verse_number": "२-४२-८०", "content_sanskrit": "फलदाता परं ब्रह्म निर्गुणः प्रकृतेः परः ।\nस्वयं कृष्णश्च भगवान्न च शक्तस्त्वया विना ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002995080, "chapter_id": 22995, "verse_number": "२-४२-८१", "content_sanskrit": "त्वमेव शक्तिः कान्ते मे शश्वज्जन्मनि जन्मनि ।\nसर्वकर्मणि शक्तोऽहं त्वया सह वरानने ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002995081, "chapter_id": 22995, "verse_number": "२-४२-८२", "content_sanskrit": "इत्युक्त्वा तत्पुरस्तस्थौ यज्ञाधिष्ठातृदेवकः ।\nतुष्टा बभूव सा देवी भेजे तं कमलाकला ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002995082, "chapter_id": 22995, "verse_number": "२-४२-८३", "content_sanskrit": "इदं च दक्षिणास्तोत्रं यज्ञकाले च यः पठेत् ।\nफलं च सर्वयज्ञानां लभते नात्र संशयः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002995083, "chapter_id": 22995, "verse_number": "२-४२-८४", "content_sanskrit": "राजसूये वाजपेये गोमेधे नरमेधके ।\nअश्वमेधे लांगले च विष्णुयज्ञे यशस्करे ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002995084, "chapter_id": 22995, "verse_number": "२-४२-८५", "content_sanskrit": "धनदे भूमिदे फल्गौ पुत्रेष्टौ गजमेधके ।\nलोहयज्ञे स्वर्णयज्ञे पटलव्याधिखण्डने ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002995085, "chapter_id": 22995, "verse_number": "२-४२-८६", "content_sanskrit": "शिवयजे रुद्रयज्ञे शक्रयज्ञे च बन्धके ।\nइष्टौ वरुणयागे च कन्दुके वैरिमर्दने ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002995086, "chapter_id": 22995, "verse_number": "२-४२-८७", "content_sanskrit": "शुचियागे धर्मयागे रेचने पापमोचने ।\nबन्धने कर्मयागे च मणियागे सुभद्रके ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002995087, "chapter_id": 22995, "verse_number": "२-४२-८८", "content_sanskrit": "एतेषां च समारम्भे इदं स्तोत्रं च यः पठेत् ।\nनिर्विघ्नेन च तत्कर्म साङ्गं भवति निश्चितम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002995088, "chapter_id": 22995, "verse_number": "२-४२-८९", "content_sanskrit": "इदं स्तोत्रं च कथितं ध्यानं पूजाविधानकम् ।\nशालग्रामे घटे वाऽपि दक्षिणां पूजयेत्सुधीः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002995089, "chapter_id": 22995, "verse_number": "२-४२-९०", "content_sanskrit": "लक्ष्मीदक्षांशसम्भूतां दक्षिणां कमलाकलाम् ।\nसर्वकर्मसु दक्षां च फलदां सर्वकर्मणाम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002995090, "chapter_id": 22995, "verse_number": "२-४२-९१", "content_sanskrit": "विष्णोःशक्तिस्वरूपां च सुशीलां शुभदां भजे ।\nध्यात्वाऽनेनैव वरदां सुधीर्मूलेन पूजयेत् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002995091, "chapter_id": 22995, "verse_number": "२-४२-९२", "content_sanskrit": "दत्त्वा पाद्यादिकं देव्यै वेदोक्तेन च नारद ।\nॐ श्रीं क्लीं ह्रीं दक्षिणायै स्वाहेति च विचक्षणः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002995092, "chapter_id": 22995, "verse_number": "२-४२-९३", "content_sanskrit": "पूजयेद्विधिवद्भक्त्या दक्षिणां सर्वपूजिताम् ।\nइत्येवं कथितं सर्वं दक्षिणाख्यानमुत्तमम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002995093, "chapter_id": 22995, "verse_number": "२-४२-९४", "content_sanskrit": "सुखदं प्रीतिदं चैव फलदं सर्वकर्मणाम् ।\nइदं च दक्षिणाख्यानं यः शृणोति समाहितः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002995094, "chapter_id": 22995, "verse_number": "२-४२-९५", "content_sanskrit": "अंगहीनं च तत्कर्म न भवेद्भारते भुवि ।\nअपुत्रो लभते पुत्रं निश्चितं च गुणान्वितम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002995095, "chapter_id": 22995, "verse_number": "२-४२-९६", "content_sanskrit": "भार्य्याहीनो लभेद्भार्य्यां सुशीलां सुन्दरीं पराम् ।\nवरारोहां पुत्रवतीं विनीतां प्रियवादिनीम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002995096, "chapter_id": 22995, "verse_number": "२-४२-९७", "content_sanskrit": "पतिव्रतां सुव्रतां च शुद्धां च कुलजां वराम् ।\nविद्याहीनो लभेद्विद्यां धनहीनो धनं लभेत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002995097, "chapter_id": 22995, "verse_number": "२-४२-९८", "content_sanskrit": "भूमिहीनो लभेद्भूमिं प्रजाहीनो लभेत्प्रजाः ।\nसङ्कटे बन्धुविच्छेदे विपत्तौ बन्धने तथा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002995098, "chapter_id": 22995, "verse_number": "२-४२-९९", "content_sanskrit": "मासमेकमिदं श्रुत्वा मुच्यते नात्र संशयः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]