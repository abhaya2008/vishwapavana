[{"id": 2172435, "chapter_id": 4675, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172436, "chapter_id": 4675, "verse_number": "१", "content_sanskrit": "विसृष्टास्वथ नारीषु धृतराष्ट्रोऽम्बिकासुतः ।\nविललाप महाराज दुःखाद् दुःखतरं गतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172437, "chapter_id": 4675, "verse_number": "२", "content_sanskrit": "सुदीर्घमपि निःश्वस्य करौ धून्वन् पुनः पुनः ।\nबहुशश्चिन्तयित्वा तु सञ्जयं वाक्यमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172438, "chapter_id": 4675, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172439, "chapter_id": 4675, "verse_number": "३", "content_sanskrit": "अहो बत महद्दुःखं यदहं पाण्डवान् रणे ।\nक्षेमिणश्चाव्ययांश्चैव त्वत्तः सूत शृणोम्यहम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172440, "chapter_id": 4675, "verse_number": "४", "content_sanskrit": "वज्रसारमयं नूनं हृदयं मम दुर्भिदम् ।\nयच्छ्रुत्वा निहतान् पुत्रान् दीर्यते न सहस्रधा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172441, "chapter_id": 4675, "verse_number": "५", "content_sanskrit": "चिन्तयित्वा वचस्तेषां बालक्रीडां च सञ्जय ।\nअद्य चैव हतान् पुत्रान् भृशं मे दूयते मनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172442, "chapter_id": 4675, "verse_number": "६", "content_sanskrit": "अन्धत्वाद् यदि तेषां तु न मे रूपनिदर्शनम् ।\nपुत्रस्नेहकृता प्रीतिः नित्यमेतेषु धारिता\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172443, "chapter_id": 4675, "verse_number": "७", "content_sanskrit": "बालभावमतिक्रान्तान् यौवनस्थांश्च तानहम् ।\nवृद्धिप्राप्तानहं श्रुत्वा हृष्ट आसं तदा भृशम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172444, "chapter_id": 4675, "verse_number": "८", "content_sanskrit": "तानद्य निहतान् श्रुत्वा हृतैश्वर्यान् हृतौजसः ।\nन लभे वै क्वचिच्छान्तिं पुत्राधिभिरभिप्लुतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172445, "chapter_id": 4675, "verse_number": "९", "content_sanskrit": "एह्येहि वत्स राजेन्द्र ममानाथस्य पुत्रक ।\nत्वया हीनो महाबाहो कां नु यास्याम्यहं गतिम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172446, "chapter_id": 4675, "verse_number": "१०", "content_sanskrit": "गतिर्भूत्वा महाराज ज्ञातीनां सुहृदां तथा ।\nअन्धं वृद्धं च मां वीर विहाय त्वं क्व गच्छसि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172447, "chapter_id": 4675, "verse_number": "११", "content_sanskrit": "या कृपा या च ते प्रीतिः या च राजसु मानिता ।\nकथं त्वं निहतः पार्थैः संयुगेष्वपराजितः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172448, "chapter_id": 4675, "verse_number": "१२", "content_sanskrit": "कथं त्वं पृथिवीपालांस्त्यक्त्वा तात समागतान् ।\nशेषेऽद्य निहतो भूमौ प्राकृतः कुनृपो यथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172449, "chapter_id": 4675, "verse_number": "१३", "content_sanskrit": "को नु मामुत्थितः काले तात तातेति वक्ष्यति ।\nमहाराजेति सततं लोकनाथेति चासकृत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172450, "chapter_id": 4675, "verse_number": "१४", "content_sanskrit": "परिष्वज्य तु कं कण्ठे स्नेहेन क्लिन्नलोचनः ।\nअनुशास्ताऽस्मि कौरव्य तत् साधु वद मे वचः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172451, "chapter_id": 4675, "verse_number": "१५", "content_sanskrit": "ननु नामाहमश्रौषं वचनं तव पुत्रक ।\nभूयसी मम सेना च तात पार्थस्य नो तथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172452, "chapter_id": 4675, "verse_number": "१६", "content_sanskrit": "भगदत्तः कृपः शल्य आवन्त्यौ च जयद्रथः ।\nभूरिश्रवाः सोमदत्तो महाराजश्च बाह्लिकः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172453, "chapter_id": 4675, "verse_number": "१७", "content_sanskrit": "अश्वत्थामा कृतवर्मा मागधश्च महाबलः ।\nबृहद्बलश्च काशीशः शकुनिश्चापि सौबलः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172454, "chapter_id": 4675, "verse_number": "१८", "content_sanskrit": "म्लेच्छाश्च बहुसाहस्राः शकाश्च यवनैः सह ।\nसुदक्षिणश्च काम्भोजः त्रिगर्ताधिपतिस्तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172455, "chapter_id": 4675, "verse_number": "१९", "content_sanskrit": "भीष्मः पितामहश्चैव भारद्वाजोऽथ गौतमः ।\nश्रुतायुश्चाश्रुतायुश्च शतायुश्चापि वीर्यवान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172456, "chapter_id": 4675, "verse_number": "२०", "content_sanskrit": "जलसन्धोऽप्यार्श्यशृङ्गी राक्षसश्चाप्यलायुधः ।\nअलम्बुसो वीरबाहुः सुबाहुश्च शतायुधः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172457, "chapter_id": 4675, "verse_number": "२१", "content_sanskrit": "एते चान्ये च बहवो राजानो राजसत्तम ।\nमदर्थं प्रहरिष्यन्ति प्राणांस्त्यक्त्वा महारणे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172458, "chapter_id": 4675, "verse_number": "२२", "content_sanskrit": "तेषां मध्ये स्थितो युद्धे भ्रातृभिः परिवारितः ।\nयोधयिष्याम्यहं पार्थान् पाञ्चालान् सृञ्जयांस्तथा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172459, "chapter_id": 4675, "verse_number": "२३", "content_sanskrit": "सोमकान् नृपशार्दूल द्रौपदेयांश्च संयुगे ।\nसात्यकिं कुन्तिभोजं च राक्षसं च घटोत्कचम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172460, "chapter_id": 4675, "verse_number": "२४", "content_sanskrit": "एकोऽप्येषां महाराज समर्थः सन्निवारणे ।\nसमरे पाण्डुयोधानां सङ्क्रुद्धो ह्यभिधावताम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172461, "chapter_id": 4675, "verse_number": "२५", "content_sanskrit": "किं पुनः सहितो वीरैः कृतवैरश्च पाण्डवैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172462, "chapter_id": 4675, "verse_number": "२६", "content_sanskrit": "अथवा सर्वपाञ्चालैः पाण्डवस्यानुसैनिकैः ।\nयोत्स्यामि सह राजेन्द्र हनिष्यामि च तान् मृधे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172463, "chapter_id": 4675, "verse_number": "२७", "content_sanskrit": "कर्णस्त्वेको मया सार्धं निहनिष्यति पाण्डवान् ।\nते वै नृपतयो वीराः स्थास्यन्ति मम शासने\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172464, "chapter_id": 4675, "verse_number": "२८", "content_sanskrit": "यश्च तेषां प्रणेता वै वासुदेवो महाबलः ।\nन स सन्नह्यते राजन्निति मामब्रवीद् वचः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172465, "chapter_id": 4675, "verse_number": "२९", "content_sanskrit": "एवं च वदतः सूत बहुशो मम सन्निधौ ।\nयुक्तितोऽप्यनुपश्यामि निहतान् पाण्डवान् मृधे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172466, "chapter_id": 4675, "verse_number": "३०", "content_sanskrit": "तेषां मध्ये स्थितो यत्र हन्यते मम पुत्रकः ।\nव्यायच्छमानः समरे किमन्यद् भागधेयतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172467, "chapter_id": 4675, "verse_number": "३१", "content_sanskrit": "भीष्मश्च निहतो यत्र लोकनाथः प्रतापवान् ।\nशिखण्डिनं समासाद्य मृगेन्द्र इव कुञ्जरम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172468, "chapter_id": 4675, "verse_number": "३२", "content_sanskrit": "द्रोणश्च ब्राह्मणो वृद्धः सर्वशस्त्रास्त्रपारगः ।\nकर्णश्च निहतः सङ्खे किमन्यद् भागधेयतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172469, "chapter_id": 4675, "verse_number": "३३", "content_sanskrit": "भूरिश्रवा हतो यत्र सोमदत्तश्च संयुगे ।\nबाह्लिकश्च महाराजः किमन्यद् भागधेयतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172470, "chapter_id": 4675, "verse_number": "३४", "content_sanskrit": "भगदत्तो हतो यत्र गजयुद्धविशारदः ।\nजयद्रथश्च निहतः किमन्यद् भागधेयतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172471, "chapter_id": 4675, "verse_number": "३५", "content_sanskrit": "सुदक्षिणो हतो यत्र जलसन्धश्च कौरवः ।\nश्रुतायुश्च शतायुश्च किमन्यद् भागधेयतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172472, "chapter_id": 4675, "verse_number": "३६", "content_sanskrit": "महाबलस्तथा पुण्ड्रः सर्वशस्त्रास्त्रपारगः ।\nनिहतः पाण्डवैः सङ्खे किमन्यद् भागधेयतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172473, "chapter_id": 4675, "verse_number": "३७", "content_sanskrit": "बृहद्बलो हतो यत्र मागधश्च महाबलः ।\nआवन्त्यौ निहतौ यत्र शकुनिश्चापि सौबलः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172474, "chapter_id": 4675, "verse_number": "३८", "content_sanskrit": "त्रिगर्तश्च महाबाहुः संशप्ताश्च महाबलाः ।\nनारायणा हता यत्र गोपालाः युद्धदुर्मदाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172475, "chapter_id": 4675, "verse_number": "३९", "content_sanskrit": "म्लेच्छाश्च बहुसाहस्राः किमन्यद् भागधेयतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172476, "chapter_id": 4675, "verse_number": "४०", "content_sanskrit": "अलम्बुसस्तथा शूरो राक्षसश्चाप्यलायुधः ।\nआर्श्यशृङ्गश्च निहतः किमन्यद् भागधेयतः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172477, "chapter_id": 4675, "verse_number": "४१", "content_sanskrit": "राजानो राजपुत्राश्च शूराः परिघबाहवः ।\nनानादेशसमावृत्ताः क्षत्रिया यत्र सञ्जय\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172478, "chapter_id": 4675, "verse_number": "४२", "content_sanskrit": "निहताः पाण्डवेयैस्तैः किमन्यद् भागधेयतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172479, "chapter_id": 4675, "verse_number": "४३", "content_sanskrit": "दुर्योधनो हतो यत्र पुत्राश्चास्य महात्मनः ।\nसोदराश्च महेष्वासाः किमन्यद् भागधेयतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172480, "chapter_id": 4675, "verse_number": "४४", "content_sanskrit": "यश्च भाग्यसमायुक्तः स शिवं प्राप्नुयाद् भुवि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172481, "chapter_id": 4675, "verse_number": "४५", "content_sanskrit": "अहं वियुक्तः स्वैर्भाग्यैः पुत्रैश्च सह सञ्जय ।\nकथमन्धो भविष्यामि वृद्धः शत्रुवशं गतः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172482, "chapter_id": 4675, "verse_number": "४६", "content_sanskrit": "नान्यदद्य परं मन्ये वनवासादृते प्रभो ।\nसोऽहं वनं गमिष्यामि निर्बन्धुर्ज्ञातिसङ्क्षये\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172483, "chapter_id": 4675, "verse_number": "४७", "content_sanskrit": "न हि मेऽन्यद् भवेच्छ्रेयो वनाभ्युपगमादृते ।\nएतामवस्थां प्राप्तस्य लूनपक्षस्य सञ्जय\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172484, "chapter_id": 4675, "verse_number": "४८", "content_sanskrit": "दुर्योधनो हतो यत्र शल्यश्च बलवान् युधि ।\nदुःशासनो विशस्तश्च विकर्णश्च महाबलः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172485, "chapter_id": 4675, "verse_number": "४९", "content_sanskrit": "कथं नु भीमसेनस्य श्रोष्येऽहं शब्दमुत्तमम् ।\nएकेन समरे येन हतं पुत्रशतं मम\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172486, "chapter_id": 4675, "verse_number": "५०", "content_sanskrit": "असकृद् वदतस्तस्य दुर्योधनवधेन च ।\nपुत्रशोकाभिसन्तप्तो न श्रोष्ये परुषा गिरः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2172487, "chapter_id": 4675, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2172488, "chapter_id": 4675, "verse_number": "५१", "content_sanskrit": "एवं स शोकसन्तप्तः पार्थिवो हतबान्धवः ।\nमुहुर्मुहुर्मुह्यमानः पुत्राधिभिरभिप्लुतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2172489, "chapter_id": 4675, "verse_number": "५२", "content_sanskrit": "विलप्य सुचिरं कालं धृतराष्ट्रोऽम्बिकासुतः ।\nदीर्घमुष्णं विनिश्वस्य चिन्तयित्वा पराभवम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2172490, "chapter_id": 4675, "verse_number": "५३", "content_sanskrit": "दुःखेन महता राजन् सन्तप्तो भरतर्षभ ।\nपुनर्गावल्गणिं सूतं पर्यपृच्छद् यथातथम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2172491, "chapter_id": 4675, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2172492, "chapter_id": 4675, "verse_number": "५४", "content_sanskrit": "भीष्मद्रौणौ हतौ श्रुत्वा सूतपुत्रं च पातितम् ।\nसेनापतिं महेष्वासं क(कि)मकुर्वत मामकाः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2172493, "chapter_id": 4675, "verse_number": "५५", "content_sanskrit": "यं यं सेनाप्रणेतारं युद्धे कुर्वन्ति मामकाः ।\nअचिरेणैव कालेन तं तं निघ्नन्ति पाण्डवाः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2172494, "chapter_id": 4675, "verse_number": "५६", "content_sanskrit": "रणमूर्ध्नि हतो भीष्मः पश्यतां वः किरीटिना ।\nएवमेव हतो द्रोणः सर्वेषामेव पश्यताम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2172495, "chapter_id": 4675, "verse_number": "५७", "content_sanskrit": "एवमेव हतः कर्णः सूतपुत्रः प्रतापवान् ।\nसराजकानां सर्वेषां पश्यतां वः किरीटिना\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2172496, "chapter_id": 4675, "verse_number": "५८", "content_sanskrit": "पूर्वमेवाहमुक्तोऽस्मि विदुरेण महात्मना ।\nदुर्योधनापराधेन प्रजेयं विनशिष्यति\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2172497, "chapter_id": 4675, "verse_number": "५९", "content_sanskrit": "केचिन्न सम्यक् पश्यन्ति मूढाः सम्यगवेक्ष्य च ।\nतदिदं मम मूढस्य तथा भूतं वचस्तु तत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2172498, "chapter_id": 4675, "verse_number": "६०", "content_sanskrit": "यदब्रवीन्मां धर्मात्मा विदुरो दीर्घदर्शिवान् ।\nतत् तथा समनुप्राप्तं वचनं दीर्घदर्शिनः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2172499, "chapter_id": 4675, "verse_number": "६१", "content_sanskrit": "दैवोपहतचित्तेन यन्मयानुष्ठितं पुरा ।\nअनयस्य फलं तस्य ब्रूहि गावल्गणे पुनः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2172500, "chapter_id": 4675, "verse_number": "६२", "content_sanskrit": "को वा मुखमनीकानामासीत् कर्णे निपातिते\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2172501, "chapter_id": 4675, "verse_number": "६३", "content_sanskrit": "अर्जुनं वासुदेवं च को वा प्रत्युद्ययौ रथी\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2172502, "chapter_id": 4675, "verse_number": "६४", "content_sanskrit": "केऽरक्षन् दक्षिणं चक्रं मद्रराजस्य संयुगे ।\nवामं वा योद्धुकामस्य के वा वीरस्य पृष्ठतः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2172503, "chapter_id": 4675, "verse_number": "६५", "content_sanskrit": "कथं च वः समेतानां मद्रराजो महाबलः ।\nनिहतः पाण्डवैः सङ्खे पुत्रा वा मम सञ्जय\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2172504, "chapter_id": 4675, "verse_number": "६६", "content_sanskrit": "ब्रूहि सर्वं यथातत्त्वं भारतानां महाक्षयम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2172505, "chapter_id": 4675, "verse_number": "६७", "content_sanskrit": "यथा स निहतः सङ्खे पुत्रो दुर्योधनो मम ।\nपाञ्चालाश्च यथा सर्वे निहताः स्वपदानुगाः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2172506, "chapter_id": 4675, "verse_number": "६८", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च द्रौपद्याः पञ्च चात्मजाः ।\nपाण्डवाश्च यथा मुक्ताः तथा तौ सात्वतौ युधि\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2172507, "chapter_id": 4675, "verse_number": "६९", "content_sanskrit": "कृपश्च कृतवर्मा च भारद्वाजात्मजस्तथा\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2172508, "chapter_id": 4675, "verse_number": "७०", "content_sanskrit": "यद्यथा यादृशं वृत्तं यथा चैवेह साम्प्रतम् ।\nनिखिलं श्रोतुमिच्छामि कुशलो ह्यसि सञ्जय\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2172509, "chapter_id": 4675, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2172510, "chapter_id": 4675, "verse_number": "२", "content_sanskrit": "शल्यवधपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]