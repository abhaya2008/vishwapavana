[{"id": 5000089000, "chapter_id": 9089, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000089001, "chapter_id": 9089, "verse_number": "२-१२-१", "content_sanskrit": "ततः श्रुत्वा महाराजः कैकेय्या दारुणं वचः।\nचिन्तामभिसमापेदे मुहूर्तं प्रतताप च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000089002, "chapter_id": 9089, "verse_number": "२-१२-२", "content_sanskrit": "किं नु मेऽयं दिवास्वप्नश्चित्तमोहोऽपि वा मम।\nअनुभूतोपसर्गो वा मनसो वाप्युपद्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000089003, "chapter_id": 9089, "verse_number": "२-१२-३", "content_sanskrit": "इति संचिन्त्य तद् राजा नाध्यगच्छत् तदासुखम्।\nप्रतिलभ्य ततः संज्ञां कैकेयीवाक्यतापितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000089004, "chapter_id": 9089, "verse_number": "२-१२-४", "content_sanskrit": "व्यथितो विक्लवश्चैव व्याघ्रीं दृष्ट्वा यथा मृगः।\nअसंवृतायामासीनो जगत्यां दीर्घमुच्छ्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000089005, "chapter_id": 9089, "verse_number": "२-१२-५", "content_sanskrit": "मण्डले पन्नगो रुद्धो मन्त्रैरिव महाविषः।\nअहो धिगिति सामर्षो वाचमुक्त्वा नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000089006, "chapter_id": 9089, "verse_number": "२-१२-६", "content_sanskrit": "मोहम् आपेदिवान् भूयः शोकोपहतचेतनः।\nचिरेण तु नृपः संज्ञां प्रतिलभ्य सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000089007, "chapter_id": 9089, "verse_number": "२-१२-७", "content_sanskrit": "कैकेयीमब्रवीत् क्रुद्धो निर्दहन्निव तेजसा।\nनृशंसे दुष्टचारित्रे कुलस्यास्य विनाशिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000089008, "chapter_id": 9089, "verse_number": "२-१२-८", "content_sanskrit": "किं कृतं तव रामेण पापे पापं मयापि वा।\nसदा ते जननीतुल्यां वृत्तिं वहति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000089009, "chapter_id": 9089, "verse_number": "२-१२-९", "content_sanskrit": "तस्यैवं त्वमनर्थाय किंनिमित्तमिहोद्यता।\nत्वं मयाऽऽत्मविनाशाय भवनं स्वं निवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000089010, "chapter_id": 9089, "verse_number": "२-१२-१०", "content_sanskrit": "अविज्ञानान्नृपसुता व्याला तीक्ष्णविषा यथा।\nजीवलोको यदा सर्वो रामस्याह गुणस्तवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000089011, "chapter_id": 9089, "verse_number": "२-१२-११", "content_sanskrit": "अपराधं कमुद्दिश्य त्यक्ष्यामीष्टमहं सुतम्।\nकौसल्यां च सुमित्रां च त्यजेयमपि वा श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000089012, "chapter_id": 9089, "verse_number": "२-१२-१२", "content_sanskrit": "जीवितं चात्मनो रामं न त्वेव पितृवत्सलम्।\nपरा भवति मे प्रीतिर्दृष्ट्वा तनयमग्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000089013, "chapter_id": 9089, "verse_number": "२-१२-१३", "content_sanskrit": "अपश्यतस्तु मे रामं नष्टं भवति चेतनम्।\nतिष्ठेल्लोको विना सूर्यं सस्यं वा सलिलं विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000089014, "chapter_id": 9089, "verse_number": "२-१२-१४", "content_sanskrit": "न तु रामं विना देहे तिष्ठेत्तु मम जीवितम्।\nतदलं त्यज्यतामेष निश्चयः पापनिश्चये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000089015, "chapter_id": 9089, "verse_number": "२-१२-१५", "content_sanskrit": "अपि ते चरणौ मूर्ध्ना स्पृशाम्येष प्रसीद मे।\nकिमर्थं चिन्तितं पापे त्वया परमदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000089016, "chapter_id": 9089, "verse_number": "२-१२-१६", "content_sanskrit": "अथ जिज्ञाससे मां त्वं भरतस्य प्रियाप्रिये।\nअस्तु यत्तत्त्वया पूर्वं व्याहृतं राघवं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000089017, "chapter_id": 9089, "verse_number": "२-१२-१७", "content_sanskrit": "स मे ज्येष्ठसुतः श्रीमान् धर्मज्येष्ठ इतीव मे।\nतत् त्वया प्रियवादिन्या सेवार्थं कथितं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000089018, "chapter_id": 9089, "verse_number": "२-१२-१८", "content_sanskrit": "तच्छ्रुत्वा शोकसंतप्ता संतापयसि मां भृशम्।\nआविष्टासि गृहे शून्ये सा त्वं परवशं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000089019, "chapter_id": 9089, "verse_number": "२-१२-१९", "content_sanskrit": "इक्ष्वाकूणां कुले देवि सम्प्राप्तः सुमहानयम्।\nअनयो नयसम्पन्ने यत्र ते विकृता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000089020, "chapter_id": 9089, "verse_number": "२-१२-२०", "content_sanskrit": "नहि किंचिदयुक्तं वा विप्रियं वा पुरा मम।\nअकरोस्त्वं विशालाक्षि तेन न श्रद्दधामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000089021, "chapter_id": 9089, "verse_number": "२-१२-२१", "content_sanskrit": "ननु ते राघवस्तुल्यो भरतेन महात्मना।\nबहुशो हि स्म बाले त्वं कथाः कथयसे मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000089022, "chapter_id": 9089, "verse_number": "२-१२-२२", "content_sanskrit": "तस्य धर्मात्मनो देवि वने वासं यशस्विनः।\nकथं रोचयसे भीरु नव वर्षाणि पञ्च च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000089023, "chapter_id": 9089, "verse_number": "२-१२-२३", "content_sanskrit": "अत्यन्तसुकुमारस्य तस्य धर्मे कृतात्मनः।\nकथं रोचयसे वासमरण्ये भृशदारुणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000089024, "chapter_id": 9089, "verse_number": "२-१२-२४", "content_sanskrit": "रोचयस्यभिरामस्य रामस्य शुभलोचने।\nतव शुश्रूषमाणस्य किमर्थं विप्रवासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000089025, "chapter_id": 9089, "verse_number": "२-१२-२५", "content_sanskrit": "रामो हि भरताद् भूयस्तव शुश्रूषते सदा।\nविशेषं त्वयि तस्मात् तु भरतस्य न लक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000089026, "chapter_id": 9089, "verse_number": "२-१२-२६", "content_sanskrit": "शुश्रूषां गौरवं चैव प्रमाणं वचनक्रियाम्।\nकस्तु भूयस्तरं कुर्यादन्यत्र पुरुषर्षभात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000089027, "chapter_id": 9089, "verse_number": "२-१२-२७", "content_sanskrit": "बहूनां स्त्रीसहस्राणां बहूनां चोपजीविनाम्।\nपरिवादोऽपवादो वा राघवे नोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000089028, "chapter_id": 9089, "verse_number": "२-१२-२८", "content_sanskrit": "सान्त्वयन् सर्वभूतानि रामः शुद्धेन चेतसा।\nगृह्णाति मनुजव्याघ्रः प्रियैर्विषयवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000089029, "chapter_id": 9089, "verse_number": "२-१२-२९", "content_sanskrit": "सत्येन लोकाञ् जयति द्विजान् दानेन राघवः।\nगुरूञ् छुश्रूषया वीरो धनुषा युधि शात्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000089030, "chapter_id": 9089, "verse_number": "२-१२-३०", "content_sanskrit": "सत्यं दानं तपस्त्यागो मित्रता शौचमार्जवम्।\nविद्या च गुरुशुश्रूषा ध्रुवाण्येतानि राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000089031, "chapter_id": 9089, "verse_number": "२-१२-३१", "content_sanskrit": "तस्मिन्नार्जवसम्पन्ने देवि देवोपमे कथम्।\nपापमाशंससे रामे महर्षिसमतेजसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000089032, "chapter_id": 9089, "verse_number": "२-१२-३२", "content_sanskrit": "न स्मराम्यप्रियं वाक्यं लोकस्य प्रियवादिनः।\nस कथं त्वत्कृते रामं वक्ष्यामि प्रियमप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000089033, "chapter_id": 9089, "verse_number": "२-१२-३३", "content_sanskrit": "क्षमा यस्मिंस्तपस्त्यागः सत्यं धर्मः कृतज्ञता।\nअप्यहिंसा च भूतानां तमृते कागतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000089034, "chapter_id": 9089, "verse_number": "२-१२-३४", "content_sanskrit": "मम वृद्धस्य कैकेयि गतान्तस्य तपस्विनः।\nदीनं लालप्यमानस्य कारुण्यं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000089035, "chapter_id": 9089, "verse_number": "२-१२-३५", "content_sanskrit": "पृथिव्यां सागरान्तायां यत् किंचिदधिगम्यते।\nतत् सर्वं तव दास्यामि मा च त्वं मन्युमाविश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000089036, "chapter_id": 9089, "verse_number": "२-१२-३६", "content_sanskrit": "अञ्जलिं कुर्मि कैकेयि पादौ चापि स्पृशामि ते।\nशरणं भव रामस्य माधर्मो मामिह स्पृशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000089037, "chapter_id": 9089, "verse_number": "२-१२-३७", "content_sanskrit": "इति दुःखाभिसंतप्तं विलपन्तमचेतनम्।\nघूर्णमानं महाराजं शोकेन समभिप्लुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000089038, "chapter_id": 9089, "verse_number": "२-१२-३८", "content_sanskrit": "पारं शोकार्णवस्याशु प्रार्थयन्तं पुनः पुनः।\nप्रत्युवाचाथ कैकेयी रौद्रा रौद्रतरं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000089039, "chapter_id": 9089, "verse_number": "२-१२-३९", "content_sanskrit": "यदि दत्त्वा वरौ राजन् पुनः प्रत्यनुतप्यसे।\nधार्मिकत्वं कथं वीर पृथिव्यां कथयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000089040, "chapter_id": 9089, "verse_number": "२-१२-४०", "content_sanskrit": "यदा समेता बहवस्त्वया राजर्षयः सह।\nकथयिष्यन्ति धर्मज्ञ तत्र किं प्रतिवक्ष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000089041, "chapter_id": 9089, "verse_number": "२-१२-४१", "content_sanskrit": "यस्याः प्रसादे जीवामि या च मामभ्यपालयत्।\nतस्याः कृता मया मिथ्या कैकेय्या इति वक्ष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000089042, "chapter_id": 9089, "verse_number": "२-१२-४२", "content_sanskrit": "किल्बिषं त्वं नरेन्द्राणां करिष्यसि नराधिप।\nयो दत्त्वा वरमद्यैव पुनरन्यानि भाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000089043, "chapter_id": 9089, "verse_number": "२-१२-४३", "content_sanskrit": "शैब्यः श्येनकपोतीये स्वमांसं पक्षिणे ददौ।\nअलर्कश्चक्षुषी दत्त्वा जगाम गतिमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000089044, "chapter_id": 9089, "verse_number": "२-१२-४४", "content_sanskrit": "सागरः समयं कृत्वा न वेलामतिवर्तते।\nसमयं मानृतं कार्षीः पूर्ववृत्तमनुस्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000089045, "chapter_id": 9089, "verse_number": "२-१२-४५", "content_sanskrit": "स त्वं धर्मं परित्यज्य रामं राज्येऽभिषिच्य च।\nसह कौसल्यया नित्यं रन्तुमिच्छसि दुर्मते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000089046, "chapter_id": 9089, "verse_number": "२-१२-४६", "content_sanskrit": "भवत्वधर्मो धर्मो वा सत्यं वा यदि वानृतम्।\nयत्त्वया संश्रुतं मह्यं तस्य नास्ति व्यतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000089047, "chapter_id": 9089, "verse_number": "२-१२-४७", "content_sanskrit": "अहं हि विषमद्यैव पीत्वा बहु तवाग्रतः।\nपश्यतस्ते मरिष्यामि रामो यद्यभिषिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000089048, "chapter_id": 9089, "verse_number": "२-१२-४८", "content_sanskrit": "एकाहमपि पश्येयं यद्यहं राममातरम्।\nअञ्जलिं प्रतिगृह्णन्तीं श्रेयो ननु मृतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000089049, "chapter_id": 9089, "verse_number": "२-१२-४९", "content_sanskrit": "भरतेनात्मना चाहं शपे ते मनुजाधिप।\nयथा नान्येन तुष्येयमृते रामविवासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000089050, "chapter_id": 9089, "verse_number": "२-१२-५०", "content_sanskrit": "एतावदुक्त्वा वचनं कैकेयी विरराम ह।\nविलपन्तं च राजानं न प्रतिव्याजहार सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000089051, "chapter_id": 9089, "verse_number": "२-१२-५१", "content_sanskrit": "श्रुत्वा तु राजा कैकेय्या वाक्यं परमशोभनम्।\nरामस्य च वने वासमैश्वर्यं भरतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000089052, "chapter_id": 9089, "verse_number": "२-१२-५२", "content_sanskrit": "नाभ्यभाषत कैकेयीं मुहूर्तं व्याकुलेन्द्रियः।\nप्रैक्षतानिमिषो देवीं प्रियामप्रियवादिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000089053, "chapter_id": 9089, "verse_number": "२-१२-५३", "content_sanskrit": "तां हि वज्रसमां वाचमाकर्ण्य हृदयाप्रियाम्।\nदुःखशोकमयीं श्रुत्वा राजा न सुखितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000089054, "chapter_id": 9089, "verse_number": "२-१२-५४", "content_sanskrit": "स देव्या व्यवसायं च घोरं च शपथं कृतम्।\nध्यात्वा रामेति निःश्वस्य च्छिन्नस्तरुरिवापतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000089055, "chapter_id": 9089, "verse_number": "२-१२-५५", "content_sanskrit": "नष्टचित्तो यथोन्मत्तो विपरीतो यथातुरः।\nहृततेजा यथा सर्पो बभूव जगतीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000089056, "chapter_id": 9089, "verse_number": "२-१२-५६", "content_sanskrit": "दीनयाऽऽतुरया वाचा इति होवाच कैकयीम्।\nअनर्थमिममर्थाभं केन त्वमुपदेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000089057, "chapter_id": 9089, "verse_number": "२-१२-५७", "content_sanskrit": "भूतोपहतचित्तेव ब्रुवन्ती मां न लज्जसे।\nशीलव्यसनमेतत् ते नाभिजानाम्यहं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000089058, "chapter_id": 9089, "verse_number": "२-१२-५८", "content_sanskrit": "बालायास्तत् त्विदानीं ते लक्षये विपरीतवत्।\nकुतो वा ते भयं जातं या त्वमेवंविधं वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000089059, "chapter_id": 9089, "verse_number": "२-१२-५९", "content_sanskrit": "राष्ट्रे भरतमासीनं वृणीषे राघवं वने।\nविरमैतेन भावेन त्वमेतेनानृतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000089060, "chapter_id": 9089, "verse_number": "२-१२-६०", "content_sanskrit": "यदि भर्तुः प्रियं कार्यं लोकस्य भरतस्य च।\nनृशंसे पापसंकल्पे क्षुद्रे दुष्कृतकारिणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000089061, "chapter_id": 9089, "verse_number": "२-१२-६१", "content_sanskrit": "किं नु दुःखमलीकं वा मयि रामे च पश्यसि।\nन कथंचिदृते रामाद् भरतो राज्यमावसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000089062, "chapter_id": 9089, "verse_number": "२-१२-६२", "content_sanskrit": "रामादपि हि तं मन्ये धर्मतो बलवत्तरम्।\nकथं द्रक्ष्यामि रामस्य वनं गच्छेति भाषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000089063, "chapter_id": 9089, "verse_number": "२-१२-६३", "content_sanskrit": "मुखवर्णं विवर्णं तु यथैवेन्दुमुपप्लुतम्।\nतां तु मे सुकृतां बुद्धिं सुहृद्भिः सह निश्चिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000089064, "chapter_id": 9089, "verse_number": "२-१२-६४", "content_sanskrit": "कथं द्रक्ष्याम्यपावृत्तां परैरिव हतां चमूम्।\nकिं मां वक्ष्यन्ति राजानो नानादिग्भ्यः समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000089065, "chapter_id": 9089, "verse_number": "२-१२-६५", "content_sanskrit": "बालो बतायमैक्ष्वाकश्चिरं राज्यमकारयत्।\nयदा हि बहवो वृद्धा गुणवन्तो बहुश्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000089066, "chapter_id": 9089, "verse_number": "२-१२-६६", "content_sanskrit": "परिप्रक्ष्यन्ति काकुत्स्थं वक्ष्यामीह कथं तदा।\nकैकेय्या क्लिश्यमानेन पुत्रः प्रव्राजितो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000089067, "chapter_id": 9089, "verse_number": "२-१२-६७", "content_sanskrit": "यदि सत्यं ब्रवीम्येतत् तदसत्यं भविष्यति।\nकिं मां वक्ष्यति कौसल्या राघवे वनमास्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000089068, "chapter_id": 9089, "verse_number": "२-१२-६८", "content_sanskrit": "किं चैनां प्रतिवक्ष्यामि कृत्वा विप्रियमीदृशम्।\nयदा यदा च कौसल्या दासीव च सखीव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000089069, "chapter_id": 9089, "verse_number": "२-१२-६९", "content_sanskrit": "भार्यावद् भगिनीवच्च मातृवच्चोपतिष्ठति।\nसततं प्रियकामा मे प्रियपुत्रा प्रियंवदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000089070, "chapter_id": 9089, "verse_number": "२-१२-७०", "content_sanskrit": "न मया सत्कृता देवी सत्कारार्हा कृते तव।\nइदानीं तत्तपति मां यन्मया सुकृतं त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000089071, "chapter_id": 9089, "verse_number": "२-१२-७१", "content_sanskrit": "अपथ्यव्यञ्जनोपेतं भुक्तमन्नमिवातुरम्।\nविप्रकारं च रामस्य सम्प्रयाणं वनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000089072, "chapter_id": 9089, "verse_number": "२-१२-७२", "content_sanskrit": "सुमित्रा प्रेक्ष्य वै भीता कथं मे विश्वसिष्यति।\nकृपणं बत वैदेही श्रोष्यति द्वयमप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000089073, "chapter_id": 9089, "verse_number": "२-१२-७३", "content_sanskrit": "मां च पञ्चत्वमापन्नं रामं च वनमाश्रितम्।\nवैदेही बत मे प्राणान् शोचन्ती क्षपयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000089074, "chapter_id": 9089, "verse_number": "२-१२-७४", "content_sanskrit": "हीना हिमवतः पार्श्वे किंनरेणेव किंनरी।\nनहि राममहं दृष्ट्वा प्रवसन्तं महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000089075, "chapter_id": 9089, "verse_number": "२-१२-७५", "content_sanskrit": "चिरं जीवितुमाशंसे रुदन्तीं चापि मैथिलीम्।\nसा नूनं विधवा राज्यं सपुत्रा कारयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000089076, "chapter_id": 9089, "verse_number": "२-१२-७६", "content_sanskrit": "सतीं त्वामहमत्यन्तं व्यवस्याम्यसतीं सतीम्।\nरूपिणीं विषसंयुक्तां पीत्वेव मदिरां नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000089077, "chapter_id": 9089, "verse_number": "२-१२-७७", "content_sanskrit": "अनृतैर्बत मां सान्त्वैः सान्त्वयन्ती स्म भाषसे।\nगीतशब्देन संरुध्य लुब्धो मृगमिवावधीः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000089078, "chapter_id": 9089, "verse_number": "२-१२-७८", "content_sanskrit": "अनार्य इति मामार्याः पुत्रविक्रायकं ध्रुवम्।\nविकरिष्यन्ति रथ्यासु सुरापं ब्राह्मणं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000089079, "chapter_id": 9089, "verse_number": "२-१२-७९", "content_sanskrit": "अहो दुःखमहो कृच्छ्रं यत्र वाचः क्षमे तव।\nदुःखमेवंविधं प्राप्तं पुरा कृतमिवाशुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000089080, "chapter_id": 9089, "verse_number": "२-१२-८०", "content_sanskrit": "चिरं खलु मया पापे त्वं पापेनाभिरक्षिता।\nअज्ञानादुपसम्पन्ना रज्जुरुद‍्बन्धनी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000089081, "chapter_id": 9089, "verse_number": "२-१२-८१", "content_sanskrit": "रममाणस्त्वया सार्धं मृत्युं त्वां नाभिलक्षये।\nबालो रहसि हस्तेन कृष्णसर्पमिवास्पृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000089082, "chapter_id": 9089, "verse_number": "२-१२-८२", "content_sanskrit": "तं तु मां जीवलोकोऽयं नूनमाक्रोष्टुमर्हति।\nमया ह्यपितृकः पुत्रः स महात्मा दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000089083, "chapter_id": 9089, "verse_number": "२-१२-८३", "content_sanskrit": "बालिशो बत कामात्मा राजा दशरथो भृशम्।\nस्त्रीकृते यः प्रियं पुत्रं वनं प्रस्थापयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000089084, "chapter_id": 9089, "verse_number": "२-१२-८४", "content_sanskrit": "वेदैश्च ब्रह्मचर्यैश्च गुरुभिश्चोपकर्शितः।\nभोगकाले महत्कृच्छ्रं पुनरेव प्रपत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000089085, "chapter_id": 9089, "verse_number": "२-१२-८५", "content_sanskrit": "नालं द्वितीयं वचनं पुत्रो मां प्रतिभाषितुम्।\nस वनं प्रव्रजेत्युक्तो बाढमित्येव वक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000089086, "chapter_id": 9089, "verse_number": "२-१२-८६", "content_sanskrit": "यदि मे राघवः कुर्याद् वनं गच्छेति चोदितः।\nप्रतिकूलं प्रियं मे स्यान्न तु वत्सः करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000089087, "chapter_id": 9089, "verse_number": "२-१२-८७", "content_sanskrit": "राघवे हि वनं प्राप्ते सर्वलोकस्य धिक्कृतम्।\nमृत्युरक्षमणीयं मां नयिष्यति यमक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000089088, "chapter_id": 9089, "verse_number": "२-१२-८८", "content_sanskrit": "मृते मयि गते रामे वनं मनुजपुङ्गवे।\nइष्टे मम जने शेषे किं पापं प्रतिपत्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000089089, "chapter_id": 9089, "verse_number": "२-१२-८९", "content_sanskrit": "कौसल्या मां च रामं च पुत्रौ च यदि हास्यति।\nदुःखान्यसहती देवी मामेवानुगमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000089090, "chapter_id": 9089, "verse_number": "२-१२-९०", "content_sanskrit": "कौसल्यां च सुमित्रां च मां च पुत्रैस्त्रिभिः सह।\nप्रक्षिप्य नरके सा त्वं कैकेयि सुखिता भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000089091, "chapter_id": 9089, "verse_number": "२-१२-९१", "content_sanskrit": "मया रामेण च त्यक्तं शाश्वतं सत्कृतं गुणैः।\nइक्ष्वाकुकुलमक्षोभ्यमाकुलं पालयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000089092, "chapter_id": 9089, "verse_number": "२-१२-९२", "content_sanskrit": "प्रियं चेद् भरतस्यैतद् रामप्रव्राजनं भवेत्।\nमा स्म मे भरतः कार्षीत् प्रेतकृत्यं गतायुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000089093, "chapter_id": 9089, "verse_number": "२-१२-९३", "content_sanskrit": "मृते मयि गते रामे वनं पुरुषपुङ्गवे।\nसेदानीं विधवा राज्यं सपुत्रा कारयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000089094, "chapter_id": 9089, "verse_number": "२-१२-९४", "content_sanskrit": "त्वं राजपुत्रि दैवेन न्यवसो मम वेश्मनि।\nअकीर्तिश्चातुला लोके ध्रुवः परिभवश्च मे।\nसर्वभूतेषु चावज्ञा यथा पापकृतस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000089095, "chapter_id": 9089, "verse_number": "२-१२-९५", "content_sanskrit": "कथं रथैर्विभुर्यात्वा गजाश्वैश्च मुहुर्मुहुः।\nपद‍्भ्यां रामो महारण्ये वत्सो मे विचरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000089096, "chapter_id": 9089, "verse_number": "२-१२-९६", "content_sanskrit": "यस्य चाहारसमये सूदाः कुण्डलधारिणः।\nअहंपूर्वाः पचन्ति स्म प्रसन्नाः पानभोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000089097, "chapter_id": 9089, "verse_number": "२-१२-९७", "content_sanskrit": "स कथं नु कषायाणि तिक्तानि कटुकानि च।\nभक्षयन् वन्यमाहारं सुतो मे वर्तयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 5000089098, "chapter_id": 9089, "verse_number": "२-१२-९८", "content_sanskrit": "महार्हवस्त्रसम्बद्धो भूत्वा चिरसुखोचितः।\nकाषायपरिधानस्तु कथं रामो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 5000089099, "chapter_id": 9089, "verse_number": "२-१२-९९", "content_sanskrit": "कस्येदं दारुणं वाक्यमेवंविधमपीरितम्।\nरामस्यारण्यगमनं भरतस्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 5000089100, "chapter_id": 9089, "verse_number": "२-१२-१००", "content_sanskrit": "धिगस्तु योषितो नाम शठाः स्वार्थपरायणाः।\nन ब्रवीमि स्त्रियः सर्वा भरतस्यैव मातरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 5000089101, "chapter_id": 9089, "verse_number": "२-१२-१०१", "content_sanskrit": "अनर्थभावेऽर्थपरे नृशंसे\nममानुतापाय निवेशितासि।\nकिमप्रियं पश्यसि मन्निमित्तं\nहितानुकारिण्यथवापि रामे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 5000089102, "chapter_id": 9089, "verse_number": "२-१२-१०२", "content_sanskrit": "परित्यजेयुः पितरोऽपि पुत्रान्\nभार्याः पतींश्चापि कृतानुरागाः।\nकृत्स्नं हि सर्वं कुपितं जगत् स्याद्\nदृष्ट्वैव रामं व्यसने निमग्नम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 5000089103, "chapter_id": 9089, "verse_number": "२-१२-१०३", "content_sanskrit": "अहं पुनर्देवकुमाररूप-\nमलंकृतं तं सुतमाव्रजन्तम्।\nनन्दामि पश्यन्निव दर्शनेन\nभवामि दृष्ट्वैव पुनर्युवेव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 5000089104, "chapter_id": 9089, "verse_number": "२-१२-१०४", "content_sanskrit": "विना हि सूर्येण भवेत् प्रवृत्ति-\nरवर्षता वज्रधरेण वापि।\nरामं तु गच्छन्तमितः समीक्ष्य\nजीवेन्न कश्चित्त्विति चेतना मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 5000089105, "chapter_id": 9089, "verse_number": "२-१२-१०५", "content_sanskrit": "विनाशकामामहिताममित्रा-\nमावासयं मृत्युमिवात्मनस्त्वाम्।\nचिरं बताङ्केन धृतासि सर्पी\nमहाविषा तेन हतोऽस्मि मोहात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 5000089106, "chapter_id": 9089, "verse_number": "२-१२-१०६", "content_sanskrit": "मया च रामेण सलक्ष्मणेन\nप्रशास्तु हीनो भरतस्त्वया सह।\nपुरं च राष्ट्रं च निहत्य बान्धवान्\nममाहितानां च भवाभिहर्षिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 5000089107, "chapter_id": 9089, "verse_number": "२-१२-१०७", "content_sanskrit": "नृशंसवृत्ते व्यसनप्रहारिणि\nप्रसह्य वाक्यं यदिहाद्य भाषसे।\nन नाम ते तेन मुखात् पतन्त्यधो\nविशीर्यमाणा दशनाः सहस्रधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 5000089108, "chapter_id": 9089, "verse_number": "२-१२-१०८", "content_sanskrit": "न किंचिदाहाहितमप्रियं वचो\nन वेत्ति रामः परुषाणि भाषितुम्।\nकथं तु रामे ह्यभिरामवादिनि\nब्रवीषि दोषान् गुणनित्यसम्मते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 5000089109, "chapter_id": 9089, "verse_number": "२-१२-१०९", "content_sanskrit": "प्रताम्य वा प्रज्वल वा प्रणश्य वा\nसहस्रशो वा स्फुटितां महीं व्रज।\nन ते करिष्यामि वचः सुदारुणं\nममाहितं केकयराजपांसने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 5000089110, "chapter_id": 9089, "verse_number": "२-१२-११०", "content_sanskrit": "क्षुरोपमां नित्यमसत्प्रियंवदां\nप्रदुष्टभावां स्वकुलोपघातिनीम्।\nन जीवितुं त्वां विषहेऽमनोरमां\nदिधक्षमाणां हृदयं सबन्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 5000089111, "chapter_id": 9089, "verse_number": "२-१२-१११", "content_sanskrit": "न जीवितं मेऽस्ति कुतः पुनः सुखं\nविनात्मजेनात्मवतां कुतो रतिः।\nममाहितं देवि न कर्तुमर्हसि\nस्पृशामि पादावपि ते प्रसीद मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 5000089112, "chapter_id": 9089, "verse_number": "२-१२-११२", "content_sanskrit": "स भूमिपालो विलपन्ननाथवत्\nस्त्रिया गृहीतो हृदयेऽतिमात्रया।\nपपात देव्याश्चरणौ प्रसारिता-\nवुभावसम्प्राप्य यथाऽऽतुरस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 5000089113, "chapter_id": 9089, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}]