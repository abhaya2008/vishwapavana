[{"id": 7002639000, "chapter_id": 22639, "verse_number": "६-१७-१", "content_sanskrit": "सूत उवाच ।\nपुनः प्रोवाच वेतालस्तदा ब्राह्मणरूपवान् ।\nशृणु भूप महाभाग कथां तव मनोरमाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002639001, "chapter_id": 22639, "verse_number": "६-१७-२", "content_sanskrit": "उज्जयिन्यां महाभाग महासेनो नृपोऽभवेत् ।\nतस्य राज्येऽवसद्विप्रो देवशर्मेति विश्रुतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002639002, "chapter_id": 22639, "verse_number": "६-१७-३", "content_sanskrit": "गुणाकरस्तस्य सुतो मद्यमांसपरायणः ।\nद्यूतेन संक्षयं वित्तं तस्य पापस्य चाभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002639003, "chapter_id": 22639, "verse_number": "६-१७-४", "content_sanskrit": "बांधवैः स परित्यक्तो बभ्राम वसुधातले ।\nकदाचिद्दैवयोगेन सिद्धाश्रममुपागमत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002639004, "chapter_id": 22639, "verse_number": "६-१७-५", "content_sanskrit": "कपर्दी नाम तं योगी कपालान्नैरपूजयत् ।\nज्ञात्वा पैशाचमन्नं स बुभुक्षुर्न गृहीतवान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002639005, "chapter_id": 22639, "verse_number": "६-१७-६", "content_sanskrit": "तदातिथ्यं तदर्थं स यक्षिणीं समुपाह्वयत् ।\nतया रात्रौ महानन्दं प्राप्तवान्स द्विजः शयी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002639006, "chapter_id": 22639, "verse_number": "६-१७-७", "content_sanskrit": "प्रातः काले तु संप्राप्ते कैलासं यक्षिणी गता ।\nस द्विजस्तद्वियोगेन योग्यंतिकमुपाययौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002639007, "chapter_id": 22639, "verse_number": "६-१७-८", "content_sanskrit": "कपर्दी प्रददौ तस्मै विद्यां यक्षिणिकर्षिणीम् ।\nचत्वारिंशद्दिनान्येव निशीथे जलमध्यगः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002639008, "chapter_id": 22639, "verse_number": "६-१७-९", "content_sanskrit": "स जजाप शुभं मन्त्रं न प्राप्ता कामचारिणी ।\nतदा योग्याज्ञया विप्रः स्वयं तु ममतां त्यजन् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002639009, "chapter_id": 22639, "verse_number": "६-१७-१०", "content_sanskrit": "प्राप्तवान्पितरौ नत्वा स्वगेहे निवसन्निशि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002639010, "chapter_id": 22639, "verse_number": "६-१७-११", "content_sanskrit": "प्रतिबोधिवनं प्राप्तस्तच्छिष्यत्वमुपाययौ ।\nपञ्चाग्निमध्ये स स्थित्वा तन्मंत्रमजपच्छुचिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002639011, "chapter_id": 22639, "verse_number": "६-१७-१२", "content_sanskrit": "न प्राप्ता योगिनी देवी तदा चिन्तातुरो ऽभवत् ।\nइत्युक्त्वा स वैतालो नृपतिं ज्ञानकोविदम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002639012, "chapter_id": 22639, "verse_number": "६-१७-१३", "content_sanskrit": "पुनराह कथं देवी न प्राप्ता यक्षिणी प्रिया ।\nश्रुत्वाह नृपतिर्विप्र वैतालं रुद्र किंकरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002639013, "chapter_id": 22639, "verse_number": "६-१७-१४", "content_sanskrit": "त्रिविधं कर्म भो विप्र सिद्ध्यर्थे साधकाय वै ।\nमनोवाग्विहितं कर्म परलोके सुखप्रदम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002639014, "chapter_id": 22639, "verse_number": "६-१७-१५", "content_sanskrit": "सुन्दरांगकृतं ज्ञेयं पुनर्वाक्कायसंभवम् ।\nकिञ्चित्सिद्धिप्रदं ज्ञेयमिह जन्मनि वीक्षितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002639015, "chapter_id": 22639, "verse_number": "६-१७-१६", "content_sanskrit": "परत्र च भुवर्लोके पिण्डदेहकृतं स्मृतम् ।\nमनःकायेन संभूतं पर जन्मनि राज्यदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002639016, "chapter_id": 22639, "verse_number": "६-१७-१७", "content_sanskrit": "मनोवाक्कायसंभूतमिह जन्मनि सिद्धिदम् ।\nपरत्र परमां सिद्धिं तत्कर्म प्रददाति हि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002639017, "chapter_id": 22639, "verse_number": "६-१७-१८", "content_sanskrit": "तस्मात्कर्तव्यमेवेह त्रिविधं कर्म साधकैः ।\nअन्यवित्त्तेन स द्विजः कृतवान्कर्म मन्त्रजम् ।\nअतोऽन्यजन्मनि प्राप्तो यक्षत्वं तत्परो द्विजः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002639018, "chapter_id": 22639, "verse_number": "६-१७-१९", "content_sanskrit": "सूत उवाच ।\nइत्युक्त्वा स तु वैतालः प्रसन्नवदनोऽभवत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002639019, "chapter_id": 22639, "verse_number": "६-१७-२०", "content_sanskrit": "साधु साध्विति तं प्रोच्य सद्वाक्यैः समपूजयत् ।\nइतिहासं पुनः प्राह परीक्षार्थे नृपाय सः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]