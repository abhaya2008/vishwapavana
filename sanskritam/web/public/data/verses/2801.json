[{"id": 2084589, "chapter_id": 2801, "verse_number": "१२-३०६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084590, "chapter_id": 2801, "verse_number": "१२-३०६-१", "content_sanskrit": "साङ्ख्ये योगे च मे तात विशेषं वक्तुमर्हसि।\nतव धर्मज्ञ सर्वं हि विदितं कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084591, "chapter_id": 2801, "verse_number": "१२-३०६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084592, "chapter_id": 2801, "verse_number": "१२-३०६-२", "content_sanskrit": "साङ्ख्याः साङ्ख्यं प्रशंसन्ति योगा योगं द्विजातयः।\nवदन्ति कारणं श्रेष्ठं स्वपक्षोद्भावनाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084593, "chapter_id": 2801, "verse_number": "१२-३०६-३", "content_sanskrit": "अनीश्वरः कथं मुच्येदित्येवं शत्रुसूदन।\nवदन्ति कारणश्रैष्ठ्यं योगाः सम्यङ्भनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084594, "chapter_id": 2801, "verse_number": "१२-३०६-४", "content_sanskrit": "वदन्ति कारणं चेदं साङ्ख्याः सम्यग्द्विजातयः।\nविज्ञायेह गतीः सर्वा विरक्तो विषयेषु यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084595, "chapter_id": 2801, "verse_number": "१२-३०६-५", "content_sanskrit": "ऊर्ध्वं च देहात्सुव्यक्तं विमुच्येदिति नान्यथा।\nएतदाहुर्महाप्राज्ञाः साङ्ख्यं वै मोक्षदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084596, "chapter_id": 2801, "verse_number": "१२-३०६-६", "content_sanskrit": "स्वपक्षे कारणं ग्राह्यं समर्थं वचनं हितम्।\nशिष्टानां हि मतं ग्राह्यं त्वद्विधैः शिष्टसंमतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084597, "chapter_id": 2801, "verse_number": "१२-३०६-७", "content_sanskrit": "प्रत्यक्षहेतवो योगाः साङ्ख्याः शास्त्रविनिश्चयाः।\nउभे चैते मते तत्त्वे मम तात युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084598, "chapter_id": 2801, "verse_number": "१२-३०६-८", "content_sanskrit": "उभे चैते मते ज्ञाने नृपते शिष्टसंमते।\nअनुष्ठिते यथाशास्त्रं नयेतां परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084599, "chapter_id": 2801, "verse_number": "१२-३०६-९", "content_sanskrit": "तुल्यं शौचं तयोरेकं दया भूतेषु चानघ।\nव्रतानां धारणं तुल्यं दर्शनं न समं तयोः।\n`तयोस्तु दर्शनं सम्यक्सूक्ष्माभावे प्रसज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084600, "chapter_id": 2801, "verse_number": "१२-३०६-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084601, "chapter_id": 2801, "verse_number": "१२-३०६-१०", "content_sanskrit": "यदि तुल्यं व्रतं शौचं दया चात्र फलं तथा।\nन तुल्यं दर्शनं कस्मात्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084602, "chapter_id": 2801, "verse_number": "१२-३०६-११x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084603, "chapter_id": 2801, "verse_number": "१२-३०६-११", "content_sanskrit": "रागं मोहं तथा स्नेहं कामं क्रोधं च केवलम्।\nयोगाच्छित्त्वा ततो दोषान्पञ्चैतान्प्राप्नुवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084604, "chapter_id": 2801, "verse_number": "१२-३०६-१२", "content_sanskrit": "यथा चानिमिषाः स्थूला जालं छित्त्वा पुनर्जलम्।\nप्राप्नुवन्ति तथा योगास्तत्पदं वीतकल्मषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084605, "chapter_id": 2801, "verse_number": "१२-३०६-१३", "content_sanskrit": "तथैव वागुरां छित्त्वा बलवन्तो यथा मृगाः।\nप्राप्नुयुर्विमलं मार्गं विमुक्ताः सर्वबन्धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084606, "chapter_id": 2801, "verse_number": "१२-३०६-१४", "content_sanskrit": "लोभजानि तथा राजन्बन्धनानि बलान्विताः।\nछित्त्वा योगात्परं मार्गं गच्छन्ति विमलं शिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084607, "chapter_id": 2801, "verse_number": "१२-३०६-१५", "content_sanskrit": "अबलाश्च मृगा राजन्वागुरासु यथा परे।\nविनश्यन्ति न संदेहस्तद्वद्योगबलादृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084608, "chapter_id": 2801, "verse_number": "१२-३०६-१६", "content_sanskrit": "बलहीनाश्च कौन्तेय यथा जालं गता झषाः।\nअन्तं गच्छन्ति राजेन्द्र योगास्तद्वत्सुदुर्बलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084609, "chapter_id": 2801, "verse_number": "१२-३०६-१७", "content_sanskrit": "यथा च शकुनाः सूक्ष्मं प्राप्य जालमरिंदम।\nतत्र सक्ता विपद्यन्ते मुच्यन्ते च बलान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084610, "chapter_id": 2801, "verse_number": "१२-३०६-१८", "content_sanskrit": "कर्मजैर्बन्धनैर्बद्धास्तद्वद्योगाः परंतप।\nअबला वै विनश्यन्ति मुच्यन्ते च बलान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084611, "chapter_id": 2801, "verse_number": "१२-३०६-१९", "content_sanskrit": "अल्पकश्च यथा राजन्वह्निः शाम्यति दुर्बलः।\nआक्रान्त इन्धनैः स्थूलैस्तद्वद्योगो बलः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084612, "chapter_id": 2801, "verse_number": "१२-३०६-२०", "content_sanskrit": "स एव च यदा राजन्वह्निर्जातबलः पुनः।\nसमीरणयुतः क्षिप्रं दहेत्कृत्स्नां महीमपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084613, "chapter_id": 2801, "verse_number": "१२-३०६-२१", "content_sanskrit": "तद्वज्जातबलो योगी दीप्ततेजा महाबलः।\nअन्तकाल इवादित्यः कृत्स्नं संशोषयेज्जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084614, "chapter_id": 2801, "verse_number": "१२-३०६-२२", "content_sanskrit": "दुर्बलश्च यथा राजन्स्रोतसा हियते नरः।\nबलहीनस्तथा योगो विषयैर्ह्रियतेऽवशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084615, "chapter_id": 2801, "verse_number": "१२-३०६-२३", "content_sanskrit": "तदेव च महास्रोतो विष्टम्भयति वारणः।\nतद्वद्योगबलं लब्ध्वा व्यूहते विषयान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084616, "chapter_id": 2801, "verse_number": "१२-३०६-२४", "content_sanskrit": "विशन्ति चावशाः पार्थ योगाद्योगबलान्विताः।\nप्रजापतीनृषीन्देवान्महाभूतानि चेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084617, "chapter_id": 2801, "verse_number": "१२-३०६-२५", "content_sanskrit": "न यमो नान्तकः क्रुद्धो न नृत्युर्भीमविक्रमः।\nईशते नृपते सर्वे योगस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084618, "chapter_id": 2801, "verse_number": "१२-३०६-२६", "content_sanskrit": "आत्मनां च सहस्राणि बहूनि भरतर्षभ।\nयोगः कुर्याद्बलं प्राप्य तैश्च सर्वैर्महीं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084619, "chapter_id": 2801, "verse_number": "१२-३०६-२७", "content_sanskrit": "प्राप्नुयाद्विषयान्कश्चित्पुनश्चोग्रं तपश्चरेत्।\nसंक्षिपेच्च पुनस्तात सूर्यस्तेतोगुणानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084620, "chapter_id": 2801, "verse_number": "१२-३०६-२८", "content_sanskrit": "बलस्थस्य हि योगस्य बन्धनेशस्य पार्थिव।\nविमोक्षे प्रभविष्णुत्वमुपपन्नमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084621, "chapter_id": 2801, "verse_number": "१२-३०६-२९", "content_sanskrit": "बलानि योगप्राप्तानि मयैतानि विशांपते।\nनिदर्शनार्थं सूक्ष्माणि वक्ष्यामि च पुनस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084622, "chapter_id": 2801, "verse_number": "१२-३०६-३०", "content_sanskrit": "आत्मनश्च समाधाने धारणां प्रति वा विभो।\nनिदर्शनानि सूक्ष्माणि शृणु मे भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084623, "chapter_id": 2801, "verse_number": "१२-३०६-३१", "content_sanskrit": "अप्रमत्तो यथा धन्वी लक्ष्यं हन्ति समाहितः।\nयुक्तः सम्यक्तथा योगी मोक्षं प्राप्नोत्यसशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084624, "chapter_id": 2801, "verse_number": "१२-३०६-३२", "content_sanskrit": "स्नेहपूर्णे यथा पात्रे मन आधाय निश्चलम्।\nपुरुषो युक्त आरोहेत्सोपानं युक्तमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084625, "chapter_id": 2801, "verse_number": "१२-३०६-३३", "content_sanskrit": "युक्तस्तथाऽयमात्मानं योगः षार्थिव निश्चलम्।\nकरोत्यमलमात्मानं भास्करोपमदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084626, "chapter_id": 2801, "verse_number": "१२-३०६-३४", "content_sanskrit": "यथा च नावं कौन्तेय कर्णधारः समाहितः।\nमहार्णवगतां शीघ्रं नयेत्पार्थिव पत्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084627, "chapter_id": 2801, "verse_number": "१२-३०६-३५", "content_sanskrit": "तद्वदात्मसमाधानं युक्त्वा योगेन तत्ववित्।\nदुर्गमं स्थानमाप्नोति हित्वा देहमिमं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084628, "chapter_id": 2801, "verse_number": "१२-३०६-३६", "content_sanskrit": "सारथिश्च यथा युक्त्वा सदश्वान्सुसमाहितः।\nदेशमिष्टं नयत्याशु धन्विनं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084629, "chapter_id": 2801, "verse_number": "१२-३०६-३७", "content_sanskrit": "तथैव नृपते योगी धारणासु समाहितः।\nप्राप्नोत्याशु परं स्थानं लक्षं मुक्त इवाशुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084630, "chapter_id": 2801, "verse_number": "१२-३०६-३८", "content_sanskrit": "आवेश्यात्मनि चात्मानं योगी तिष्ठति योचलः।\nपापं हन्ति पुनीतानां पदमाप्नोति सोऽजरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084631, "chapter_id": 2801, "verse_number": "१२-३०६-३९", "content_sanskrit": "नाभ्यां कण्ठे च शीर्षे च हृदि वक्षसि पार्श्वयोः।\nदर्शने श्रवणे चापि घ्राणे चामितविक्रम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084632, "chapter_id": 2801, "verse_number": "१२-३०६-४०", "content_sanskrit": "स्थानेष्वेतेषु यो योगी महाव्रतसमाहितः।\nआत्मना सूक्ष्ममात्मानं युङ्क्ते सम्यग्विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084633, "chapter_id": 2801, "verse_number": "१२-३०६-४१", "content_sanskrit": "स शीघ्रमचलप्रख्यं कर्म दग्ध्या शुभाशुभम्।\nउत्तमं योगमास्थाय यदीच्छति विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084634, "chapter_id": 2801, "verse_number": "१२-३०६-४२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084635, "chapter_id": 2801, "verse_number": "१२-३०६-४२", "content_sanskrit": "आहारान्कीदृशान्कृत्वा कानि जित्वा च भारत।\nयोगी बलमवाप्नोति तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084636, "chapter_id": 2801, "verse_number": "१२-३०६-४३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084637, "chapter_id": 2801, "verse_number": "१२-३०६-४३", "content_sanskrit": "कणानां भक्षणे युक्तः पिण्याकस्य च भारत।\nस्नेहानां वर्जने युक्तो योगी बलमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084638, "chapter_id": 2801, "verse_number": "१२-३०६-४४", "content_sanskrit": "भुञ्जानो यावकं रूक्षं दीर्घकालमरिंदम्।\nएकाहारो विशुद्धात्मा योगी बलमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084639, "chapter_id": 2801, "verse_number": "१२-३०६-४५", "content_sanskrit": "पक्षान्मासानृतूंश्चैतान्संवत्सरानहस्तथा।\nअपः पीत्वा पयोमिश्रा योगी बलमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084640, "chapter_id": 2801, "verse_number": "१२-३०६-४६", "content_sanskrit": "अखण्डमपि वा मांसं सततं मनुजेश्वर।\nउपोष्य सम्यक्शुद्धात्मा योगी बलमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2084641, "chapter_id": 2801, "verse_number": "१२-३०६-४७", "content_sanskrit": "कामं जित्वा तथा क्रोधं शीतोष्णे वर्षमेव च।\nभयं शोकं तथा श्वासं पौरुषान्विषयांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2084642, "chapter_id": 2801, "verse_number": "१२-३०६-४८", "content_sanskrit": "अरतिं दुर्जयां चैव घोरां तृष्णां च पार्थिव।\nस्पर्शं निद्रां तथा तन्द्रीं दुर्जयां नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2084643, "chapter_id": 2801, "verse_number": "१२-३०६-४९", "content_sanskrit": "दीपयन्ति महात्मानः सूक्ष्ममात्मानमात्मना।\nवीतरागा महाप्रज्ञा ध्यानाध्ययनसंपदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2084644, "chapter_id": 2801, "verse_number": "१२-३०६-५०", "content_sanskrit": "दुर्गस्त्वेप मतः पन्था ब्राह्मणानां विपश्चिताम्।\nन कश्चिद्व्रजति ह्यस्मिन्क्षेमेण भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2084645, "chapter_id": 2801, "verse_number": "१२-३०६-५१", "content_sanskrit": "यथा कश्चिद्वनं घोरं बहुसर्पसरीसृपम्।\nश्वभ्रवत्तोयहीनं च दुर्गमं बहुकण्टकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2084646, "chapter_id": 2801, "verse_number": "१२-३०६-५२", "content_sanskrit": "अभक्षमटवीप्रायं दावदग्धमहीरुहम्।\nपन्थानं तस्कराकीर्णं क्षेमेणाभिपतेद्युवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2084647, "chapter_id": 2801, "verse_number": "१२-३०६-५३", "content_sanskrit": "योगमार्गं तथाऽऽसाद्य यः कश्चिद्व्रजते द्विजः।\nक्षेमेणोपरमेन्मार्गाद्बहुदोषो हि स स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2084648, "chapter_id": 2801, "verse_number": "१२-३०६-५४", "content_sanskrit": "सुस्थेयं क्षुरधारासु निशितासु महीपते।\nधारणासु तु योगस्य दुःस्थेयमकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2084649, "chapter_id": 2801, "verse_number": "१२-३०६-५५", "content_sanskrit": "विपन्ना धारणास्तात नयन्ति न शुभां गतिम्।\nनेतृहीना यथा नावः पुरुषानर्णवे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2084650, "chapter_id": 2801, "verse_number": "१२-३०६-५६", "content_sanskrit": "यस्तु तिष्ठति कौन्तेय धारणासु यथाविधि।\nमरणं जन्म दुःखं च सुखं च स विमुञ्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2084651, "chapter_id": 2801, "verse_number": "१२-३०६-५७", "content_sanskrit": "नानाशास्त्रेषु निष्पन्नं योगेष्विदमुदाहृतम्।\nपरं योगस्य यत्कृत्यं निश्चितं तद्द्विजातिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2084652, "chapter_id": 2801, "verse_number": "१२-३०६-५८", "content_sanskrit": "परं हि तद्ब्रह्ममयं महात्म\nन्ब्रह्माणमीशं वरदं च विष्णुम्।\nभवं च धर्मं च ष़डाननं च\nषट्ब्रह्मपुत्रांश्च महान्भावान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2084653, "chapter_id": 2801, "verse_number": "१२-३०६-५९", "content_sanskrit": "तमश्च कष्टं सुमहद्रजश्च\nसत्वं विशुद्धं प्रकृतिं परां च।\nसिद्धिं च देवीं वरुणस्य पत्नीं\nतेजश्च कृत्स्नं सुमहच्च धैर्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2084654, "chapter_id": 2801, "verse_number": "१२-३०६-६०", "content_sanskrit": "ताराधिपं खे विमलं सतारं\nविश्वांश्च देवानुरगान्पितृंश्च।\nशैलांश्च कृत्स्नानुदधींश्च घोरा\nन्नदीश्च सर्वाः सवनान्घनांश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2084655, "chapter_id": 2801, "verse_number": "१२-३०६-६१", "content_sanskrit": "नागान्नगान्यक्षगणान्दिशश्च\nगन्धर्वसंघान्पुरुषान्स्त्रियश्च।\nपरात्परं प्राप्य महान्महात्मा\nविशेत योगी नचिराद्विमुक्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2084656, "chapter_id": 2801, "verse_number": "१२-३०६-६२", "content_sanskrit": "कथा च येयं नृपते प्रसक्ता\nदेवे महावीर्यतमौ शुभेयम्।\nयोगी स सर्वानभिभूय मर्त्या\nन्नारायणात्मा कुरुते महात्मा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2084657, "chapter_id": 2801, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षडधिकत्रिशततमोऽध्यायः॥ ३०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]