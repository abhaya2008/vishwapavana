[{"id": 7005817000, "chapter_id": 25817, "verse_number": "२९१-१", "content_sanskrit": "मत्स्यपुराणान्तर्गतसम्पूर्ण विषयवर्णनम् ।\nसूत उवाच ।\nएतद्वः कथितं सर्वं यदुक्तं विश्वरूपिणा ।\nमात्स्यं पुराणमखिलं धर्मकामार्थसाधनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005817001, "chapter_id": 25817, "verse_number": "२९१-२", "content_sanskrit": "यत्रादौ मनुसंवादो ब्रह्मण्डकथनन्तथा ।\nसांख्यं शारीरकं प्रोक्तं चतुर्मुखमुखोद्भवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005817002, "chapter_id": 25817, "verse_number": "२९१-३", "content_sanskrit": "देवासुराणामुत्पत्तिर्मारुतोत्पत्तिरेव च ।\nमदनद्वादशी तद्वल्लोकपालाभिपूजनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005817003, "chapter_id": 25817, "verse_number": "२९१-४", "content_sanskrit": "मन्वन्तराणामुद्देशो वैन्यराजाभिवर्णनम् ।\nसूर्यवैवस्वतोत्पत्तिः बुधस्यागमनं तथा ॥२९१४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005817004, "chapter_id": 25817, "verse_number": "२९१-५", "content_sanskrit": "पितृवंशानुकथनं श्राद्धकालस्तथैव च ।\nपितृतीर्थप्रवासश्च सोमोत्पतिस्तथैव च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005817005, "chapter_id": 25817, "verse_number": "२९१-६", "content_sanskrit": "कीर्तनं सोमवंशस्य ययातिचरितं तथा ।\nकार्तवीर्यस्य महात्म्यं वृष्णिवंशानुकीर्तनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005817006, "chapter_id": 25817, "verse_number": "२९१-७", "content_sanskrit": "भृगुशापस्तथा विष्णोर्द्दैत्यशापस्तथैव च ।\nकीर्तनं पुरुषेशस्य वंशो हौताशनस्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005817007, "chapter_id": 25817, "verse_number": "२९१-८", "content_sanskrit": "पुराणकीर्तनं तद्वत् क्रियायोगस्तथैव च ।\nव्रतं नक्षत्रसंख्याकं मार्तण्डशयनं तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005817008, "chapter_id": 25817, "verse_number": "२९१-९", "content_sanskrit": "कृष्णाष्टमीव्रतं तद्वद्रोहिणीचन्द्रसंज्ञितम् ।\nतडागविधिमाहात्म्यं पादपोत्सर्ग एव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005817009, "chapter_id": 25817, "verse_number": "२९१-१०", "content_sanskrit": "सौभाग्यशयनं तद्वदगस्त्यव्रतमेव च ।\nतथानन्ततृतीया तु रसकल्याणिनी तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005817010, "chapter_id": 25817, "verse_number": "२९१-११", "content_sanskrit": "आर्द्रानन्दकरी तद्वद्व्रतं सारस्वतं पुनः ।\nउपरागाभिषेकश्च सप्तमीस्नपनं पुनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005817011, "chapter_id": 25817, "verse_number": "२९१-१२", "content_sanskrit": "भीमाख्या द्वादशी तद्वदनङ्गशयनं तथा ।\nअशून्यशयनं तद्वत्तथैवाङ्गारकव्रतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005817012, "chapter_id": 25817, "verse_number": "२९१-१३", "content_sanskrit": "सप्तमी सप्तकं तद्वद्विशोक द्वादशी तथा ।\nमेरु प्रदानं दशधा ग्रहशान्तिस्तथैव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005817013, "chapter_id": 25817, "verse_number": "२९१-१४", "content_sanskrit": "ग्रहस्वरूपकथनं तथा शिवचतुर्दशी ।\nतथा सर्वफलत्यागः सूर्यवारव्रतं तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005817014, "chapter_id": 25817, "verse_number": "२९१-१५", "content_sanskrit": "संक्रान्तिस्नपनं तद्वद्विभूतिद्वादशीव्रतम् ।\nषष्टिव्रतानां माहात्म्यं तता स्नानविधिक्रमः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005817015, "chapter_id": 25817, "verse_number": "२९१-१६", "content_sanskrit": "प्रयागस्य तु माहात्म्यं सर्वतीर्थानुकीर्तनम् ।\nपैलाश्रमफलं तद्वद्द्वीपलोकानुकीर्तनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005817016, "chapter_id": 25817, "verse_number": "२९१-१७", "content_sanskrit": "ततान्तरिक्षचारश्च ध्रुवमाहात्म्यमेव च ।\nभुवनानि सुरेन्द्राणां त्रिपुराधोषणं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005817017, "chapter_id": 25817, "verse_number": "२९१-१८", "content_sanskrit": "पितृपिण्डदमाहात्म्यं मन्वन्तरविनिर्णयम् ।\nवज्राङ्गस्य तु संभूतिः तारकोत्पत्तिरेव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005817018, "chapter_id": 25817, "verse_number": "२९१-१९", "content_sanskrit": "तारकासुरमाहात्म्यं ब्रह्मदेवानुकीर्तनम् ।\nपार्वतीसम्भवस्तद्वत् तथा शिवतपोधनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005817019, "chapter_id": 25817, "verse_number": "२९१-२०", "content_sanskrit": "अनङ्गदेहदाहस्तु रतिशोकस्तथैव च ।\nगौरी तपोवनं तद्वद्विश्वनाथप्रसादनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005817020, "chapter_id": 25817, "verse_number": "२९१-२१", "content_sanskrit": "पार्वती ऋषिसंवादस्ततैवोद्वाहमङ्गलम् ।\nकुमारसम्भवस्तद्वत् कुमारविजयस्तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005817021, "chapter_id": 25817, "verse_number": "२९१-२२", "content_sanskrit": "तारकस्य वधो घोरो नरसिंहोपवर्णनम् ।\nपद्मोद्भव विसर्गस्तु तथैवान्धक-घातनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005817022, "chapter_id": 25817, "verse_number": "२९१-२३", "content_sanskrit": "वाराणस्यास्तु माहात्म्यं नर्मदायास्तथैव च ।\nप्रवरानुक्रमस्तद्वत् पितृगाथानुकीर्तनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005817023, "chapter_id": 25817, "verse_number": "२९१-२४", "content_sanskrit": "ततोभयमुखीदानं दानं कृष्णाजिनस्य च ।\nतथा सावित्र्युपाख्यानं राजधर्मास्तथैव च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005817024, "chapter_id": 25817, "verse_number": "२९१-२५", "content_sanskrit": "यात्रा निमित्तकथनं स्वप्नमङ्गल्यकीर्तनम् ।\nवामनस्य तु माहात्म्यं तथैवाथ वराहजम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005817025, "chapter_id": 25817, "verse_number": "२९१-२६", "content_sanskrit": "क्षीरोदमथनं तद्वत् कालकूटाभिशासनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005817026, "chapter_id": 25817, "verse_number": "२९१-२७", "content_sanskrit": "प्रासादलक्षणं तद्वत् मण्डपानान्तु लक्षणम् ।\nकल्पानुकीर्तनं तद्वद् ग्रन्थानुक्रमणीं तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005817027, "chapter_id": 25817, "verse_number": "२९१-२८", "content_sanskrit": "तुला दानादि बहुशो महादानानुकीर्तनम् ।\nकल्पानुकीर्तनं तद्वत् ग्रन्तानुक्रमणीं तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005817028, "chapter_id": 25817, "verse_number": "२९१-२९", "content_sanskrit": "एतत्पवित्रमायुष्यमेतत्कीर्तिविवर्धनम् ।\nएतत्पवित्रं कल्याणं महापापहरं शुभम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005817029, "chapter_id": 25817, "verse_number": "२९१-३०", "content_sanskrit": "अस्मात् पुराणादपि पादमेकं पठेत्तु यः सोऽपि विमुक्तपापः ।\nनारायणाख्यं पदमेति नूनमनङ्गवद्दिव्यसुखानि भुङ्क्ते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]