[{"id": 2101887, "chapter_id": 3199, "verse_number": "१४-५५-१", "content_sanskrit": "उदङ्क उवाच।\nअभिजानामि जगतः कर्तारं त्वां जनार्दन।\nनूनं भवत्प्रसादोऽयमिति मे नास्ति संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101888, "chapter_id": 3199, "verse_number": "१४-५५-२", "content_sanskrit": "चित्तं च सुप्रसन्नं मे त्वद्भावगतमच्युत।\nविनिवृत्तश्च मे कोप इति विद्धि परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101889, "chapter_id": 3199, "verse_number": "१४-५५-३", "content_sanskrit": "यदि त्वनुग्रहं कञ्चित्त्वत्तोऽर्हामि जनार्दन।\nद्रष्टुमिच्छामि ते रूपं वैष्णवं तन्निदर्शय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101890, "chapter_id": 3199, "verse_number": "१४-५५-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101891, "chapter_id": 3199, "verse_number": "१४-५५-४", "content_sanskrit": "ततः स तस्मै प्रीतात्मा दर्शयामास तद्वपुः।\nशाश्वतं वैष्णवं धीमान्ददृशे यद्धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101892, "chapter_id": 3199, "verse_number": "१४-५५-५", "content_sanskrit": "स ददर्श महात्मानं विश्वरूपं महाभुजम्।\nसहस्रसूर्यप्रतिमं दीप्तिमत्पावकोपमम्।\nसर्वमाकाशमावृत्य तिष्ठन्तं सर्वतोमुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101893, "chapter_id": 3199, "verse_number": "१४-५५-६", "content_sanskrit": "तद्दृष्ट्वा परमं रूपं विष्णोर्वैष्णवमद्भुतम्।\nविस्मयं च ययौ विप्रस्तं दृष्ट्वा परमेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101894, "chapter_id": 3199, "verse_number": "१४-५५-७x", "content_sanskrit": "उदङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101895, "chapter_id": 3199, "verse_number": "१४-५५-७", "content_sanskrit": "`नमोनमस्ते सर्वात्मन्नारायण परात्मक।\nपरमात्मन्पद्मनाभ पुण्डरीकाक्ष माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101896, "chapter_id": 3199, "verse_number": "१४-५५-८", "content_sanskrit": "हिरण्यगर्भरूपाय संसारोत्तारणाय च।\nपुरुषाय पुराणाय शान्तश्यामाय ते नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101897, "chapter_id": 3199, "verse_number": "१४-५५-९", "content_sanskrit": "अविद्यातिमिरादित्यं भवव्याधिमहौषधिम्।\nसंसारार्णवसारं त्वां प्रणमामि गतिर्भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101898, "chapter_id": 3199, "verse_number": "१४-५५-१०", "content_sanskrit": "सर्ववेदैकवेद्याय सर्ववेदमयाय च।\nवासुदेवाय नित्याय नमो भक्तप्रियाय ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101899, "chapter_id": 3199, "verse_number": "१४-५५-११", "content_sanskrit": "दयया दुःखमोहान्मां सुमुद्धर्तुमिहार्हसि।\nकर्मभिर्बहुभिः पापैर्बद्धं पाहि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101900, "chapter_id": 3199, "verse_number": "१४-५५-१२", "content_sanskrit": "विश्वकर्मन्नमस्तेऽस्तु विश्वात्मन्विश्वकसम्भव।\nपद्म्यां ते पृथिवी व्याप्ता शिरसा चावृतं नभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101901, "chapter_id": 3199, "verse_number": "१४-५५-१३", "content_sanskrit": "द्यावापृथिव्योर्यन्मध्यं जठरेण तवावृतम्।\nभुजाभ्यामावृताश्चाशास्त्वमिदं सर्वमच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101902, "chapter_id": 3199, "verse_number": "१४-५५-१४", "content_sanskrit": "संहरस्व पुनर्देव रूपमक्षय्यमुत्तमम्।\nपुनस्त्वां स्वेन रूपेण द्रष्टुमिच्छामि शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101903, "chapter_id": 3199, "verse_number": "१४-५५-१५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101904, "chapter_id": 3199, "verse_number": "१४-५५-१५", "content_sanskrit": "तमुवाच प्रसन्नात्मा गोविन्दो जनमेजय।\nवरं वृणीष्वेति तदा तमुदङ्कोऽब्रवीदिदम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101905, "chapter_id": 3199, "verse_number": "१४-५५-१६", "content_sanskrit": "पर्याप्त एष एवाद्य वरस्त्वत्तो महाद्युते।\nयत्ते रूपमिदं कृष्ण पश्यामि प्रभवाप्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101906, "chapter_id": 3199, "verse_number": "१४-५५-१७", "content_sanskrit": "तमब्रकवीत्पुनः कृष्णो मा त्वमत्र विचारय। अवश्यमेतत्कर्तव्यममोघं दर्शनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101907, "chapter_id": 3199, "verse_number": "१४-५५-१८x", "content_sanskrit": "उदङ्कक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101908, "chapter_id": 3199, "verse_number": "१४-५५-१८", "content_sanskrit": "अवश्यं करणीयं च यद्येतन्मन्यसे विभो।\nतोयमिच्छामि यत्रेष्टं मरुष्वेतद्धि दुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101909, "chapter_id": 3199, "verse_number": "१४-५५-१९", "content_sanskrit": "ततः संहृत्य तत्तेजः प्रोवाचोदङ्कमीश्वरः।\nएष्टव्ये सति चिन्त्योऽहमित्युक्त्वा द्वारकां ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101910, "chapter_id": 3199, "verse_number": "१४-५५-२०", "content_sanskrit": "ततः कदाचिद्भगवानुदङ्कस्तोयकाङ्क्षया।\nतृषितः परिचक्राम मरौ सस्मार चाच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101911, "chapter_id": 3199, "verse_number": "१४-५५-२१", "content_sanskrit": "ततो दिग्वाससं धीमान्मातङ्गं मलपङ्किनम्।\nअपश्यत मरौ तस्मिञ्श्वयूथपरिवारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101912, "chapter_id": 3199, "verse_number": "१४-५५-२२", "content_sanskrit": "भीषणं बद्धनिस्त्रिंशं बाणकार्मुकधारिणम्।\nतस्याधःस्रोतसोऽपश्यद्वारि भूरि द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101913, "chapter_id": 3199, "verse_number": "१४-५५-२३", "content_sanskrit": "स्मरन्नेव च तं प्राह मातङ्गः प्रहसन्निव।\nएह्युदङ्क प्रतीच्छस्व मत्तो वारि भृगूद्वह।\nकृपा हि मे सुमहती त्वां दृष्ट्वा तृट्समाश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101914, "chapter_id": 3199, "verse_number": "१४-५५-२४", "content_sanskrit": "इत्युक्तस्तेन स मुनिस्तत्तोयं नाभ्यनन्दन।\nचिक्षेप च स तं धीमान्वाग्भिरुग्राभिरच्युतम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101915, "chapter_id": 3199, "verse_number": "१४-५५-२५", "content_sanskrit": "पुनःपुनश्च मातङ्ग पिबस्वेति तमब्रवीत्।\nन चापिबत्स सक्रोधः क्षुभितेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101916, "chapter_id": 3199, "verse_number": "१४-५५-२६", "content_sanskrit": "स तथा निश्चयात्तेन प्रत्याख्यातो महात्मना।\nश्वभिः सह महाराज तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101917, "chapter_id": 3199, "verse_number": "१४-५५-२७", "content_sanskrit": "उदङ्कस्तं तथा दृष्ट्वा ततो व्रीडितमानसः।\nमेने प्रलब्धमात्मानं कृष्णेनामित्रघातिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101918, "chapter_id": 3199, "verse_number": "१४-५५-२८", "content_sanskrit": "अथ तेनैव मार्गेण शङ्कचक्रगदाधरः।\nआजगाम महाबाहुरुदङ्कश्चैनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101919, "chapter_id": 3199, "verse_number": "१४-५५-२९", "content_sanskrit": "न युक्तं तादृशं दातुं त्वया पुरुषसत्तम।\nसलिलं विप्रमुख्येभ्यो मातङ्गस्रोतसा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101920, "chapter_id": 3199, "verse_number": "१४-५५-३०", "content_sanskrit": "इत्युक्तवचनं तं तु महाबुद्धिर्जनार्दनः।\nउदङ्कं श्लक्ष्णया वाचा सान्त्वयन्निदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101921, "chapter_id": 3199, "verse_number": "१४-५५-३१", "content_sanskrit": "यादृशेनेह रूपेण योग्यं दातुं धृतेन वै।\nतादृशं खलु ते दत्तं यच्च त्वं नावबुध्यथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101922, "chapter_id": 3199, "verse_number": "१४-५५-३२", "content_sanskrit": "मया त्वदर्थमुक्तो वै वज्रपाणिः पुरंदरः।\nउदङ्कायामृतं देहि तोयरूपमिति प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101923, "chapter_id": 3199, "verse_number": "१४-५५-३३", "content_sanskrit": "स मामुवाच देवेन्द्र न मर्त्योऽमर्त्यतां व्रजेत्।\nअन्यमस्मै वरं देहीत्यसकृद्भृगुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2101924, "chapter_id": 3199, "verse_number": "१४-५५-३४", "content_sanskrit": "अमृतं देयमित्येव मयोक्तः स शचीपतिः।\nस मां प्रसाद्य देवेन्द्रः पुनरेवेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2101925, "chapter_id": 3199, "verse_number": "१४-५५-३५", "content_sanskrit": "यदि देयमवश्यं वै मातङ्गोऽहं महामते।\nभूत्वाऽमृतं प्रदास्यामि भार्गवाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2101926, "chapter_id": 3199, "verse_number": "१४-५५-३६", "content_sanskrit": "यद्येवं प्रतिगृह्णाति भार्गवोऽमृतमद्य वै।\nप्रदातुमेष गच्छामि भार्गवस्यामृतं विभो।\nप्रत्याख्यातस्त्वहं तेन दास्यामि न कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2101927, "chapter_id": 3199, "verse_number": "१४-५५-३७", "content_sanskrit": "स तथा समयं कृत्वा तेन रूपेण वासवः।\nउपस्थितस्त्वया चापि प्रत्याख्यातोऽमृतं ददत्।\nचाण्डालरूपी भगवान्सुमहांस्ते व्यतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2101928, "chapter_id": 3199, "verse_number": "१४-५५-३८", "content_sanskrit": "यत्तु शक्यं मया कर्तुं भूय एव तवेप्सितम्।\nतोयेप्सां तव दुर्धर्षां करिष्ये सफलामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2101929, "chapter_id": 3199, "verse_number": "१४-५५-३९", "content_sanskrit": "येष्वहःसु च ते ब्रह्मन्सलिलेप्सा भविष्यति।\nतदा मरौ भविष्यन्ति जलपूर्णाः पयोधराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2101930, "chapter_id": 3199, "verse_number": "१४-५५-४०", "content_sanskrit": "रसवच्च प्रदास्यन्ति तोयं ते भृगुनन्दन।\nउदङ्गमेघा इत्युक्ताः ख्यातिं यास्यन्ति चापि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2101931, "chapter_id": 3199, "verse_number": "१४-५५-४१", "content_sanskrit": "इत्युक्तः प्रीतिमान्विप्रः कृष्णेन स बभूव ह।\nअद्याप्युदङ्कमेघाश्च मरौ वर्षन्ति भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2101932, "chapter_id": 3199, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि पञ्चपश्चाशोऽध्यायः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]