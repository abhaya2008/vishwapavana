[{"id": 7000153000, "chapter_id": 20153, "verse_number": "१५३-१", "content_sanskrit": "भावतीर्थवर्णनम् ब्रह्मोवाच भावतीर्थमिति प्रोक्तं यत्र साक्षाद्‌भवः स्थितः ।\nअशेषजगदन्तस्थो भूतात्मा सच्छिदाकृतिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000153001, "chapter_id": 20153, "verse_number": "१५३-२", "content_sanskrit": "तत्रेमां श्रृणु वक्ष्यामि कथां पुण्यतमां शुभाम् ।\nसूर्यवंशकरः श्रीमान्क्षत्रियाणां धुरंधरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000153002, "chapter_id": 20153, "verse_number": "१५३-३", "content_sanskrit": "प्राचीनबर्हिराख्यातः सर्वधर्मेषु पारगः ।\nतिस्रः कोट्योऽर्धकोटिश्च वर्षाणां राज्य आस्थितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000153003, "chapter_id": 20153, "verse_number": "१५३-४", "content_sanskrit": "तस्येदृशं व्रतं चाऽऽसीद्यदहं यौवनच्युतः ।\nभवेयं प्रियया वाऽपि पुत्रैर्वा प्रियवस्तुभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000153004, "chapter_id": 20153, "verse_number": "१५३-५", "content_sanskrit": "वियुज्येयं ततो राज्यं त्यक्ष्येऽहं नात्र संशयः ।\nविवेकिनां कुलीनानामिदमेवोचितं नृणाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000153005, "chapter_id": 20153, "verse_number": "१५३-६", "content_sanskrit": "स्थीयते विजने क्वापि विरक्तैर्विभवक्षये ।\nतस्मिन्प्रशासति महीं न वियोगः प्रियैः क्वचित् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000153006, "chapter_id": 20153, "verse_number": "१५३-७", "content_sanskrit": "नाऽऽधिव्याधी न दुर्भिक्षं न बन्धुकलहो नृणाम् ।\nतस्मिञ्शासति राज्यं तु न च कश्चिद्वियुज्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000153007, "chapter_id": 20153, "verse_number": "१५३-८", "content_sanskrit": "ततः पुत्रार्थमकरोद्यज्ञं राजा महामतिः ।\nततः प्रसन्नो भगवान्वरं प्रादाद्यथेत्सितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000153008, "chapter_id": 20153, "verse_number": "१५३-९", "content_sanskrit": "गौतमीतीरसंस्थाय राज्ञे देवो महेश्वरः ।\nपुत्रं देहीति राजा वै भवं प्राह स भार्यया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000153009, "chapter_id": 20153, "verse_number": "१५३-१०", "content_sanskrit": "भवः प्राह नृपं प्रीत्या पश्य नेत्रं तृतीयकम् ।\nततः पश्यति राजेन्द्रे भवस्याक्षि तु मानद ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000153010, "chapter_id": 20153, "verse_number": "१५३-११", "content_sanskrit": "चक्षुर्दीप्त्याऽभवत्पुत्रो महीमा नाम विश्रुतः ।\nयेनाकारि स्तुतिः पुण्या महिम्न(?)इति विश्रुता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000153011, "chapter_id": 20153, "verse_number": "१५३-१२", "content_sanskrit": "किमलभ्यं भगवति प्रसन्ने त्रिपुरान्तके ।\nयं नित्यमनुवर्तन्ते हरिब्रह्मादयः सुराः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000153012, "chapter_id": 20153, "verse_number": "१५३-१३", "content_sanskrit": "प्राप्तपुत्रश्च नृपतिस्तीर्थश्रैष्ठ्यमयाचत ।\nमहापापमहारोगमहाव्यसनिनां नृणाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000153013, "chapter_id": 20153, "verse_number": "१५३-१४", "content_sanskrit": "नानाविपद्‌गणार्तानां सर्वाभिमतलब्धये ।\nप्रादाज्ज्यैष्ट्यं भवश्चापि भावतीर्थं तदुच्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000153014, "chapter_id": 20153, "verse_number": "१५३-१५", "content_sanskrit": "तत्र स्नानेन दानेन सर्वान्कामानवाप्नुयात् ।\nभवप्रसादादभवत्सुतः प्राचीनबर्हिषः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000153015, "chapter_id": 20153, "verse_number": "१५३-१६", "content_sanskrit": "महिमा गौतमीतीरे भावतीर्थं तदुच्यते ।\nतत्र सप्ततितीर्थानि पुण्यान्यखिलदानि च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]