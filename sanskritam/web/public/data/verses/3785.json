[{"id": 2129392, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "श्येनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129393, "chapter_id": 3785, "verse_number": "१", "content_sanskrit": "धर्मात्मानं त्वाहुरेकं राजन् सर्वे महीक्षितः ।\nस त्वं धर्मविरुद्धं हि कस्मात् कर्म चिकीर्षसि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129394, "chapter_id": 3785, "verse_number": "२", "content_sanskrit": "विहितं रक्षणं राजन् पीड्यमानस्य मे क्षुधा ।\nमा हिंसीर्धर्मलोभेन धर्ममुत्सृज्य मा नशीः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129395, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129396, "chapter_id": 3785, "verse_number": "३", "content_sanskrit": "सन्त्रस्तरूपस्त्राणार्थी त्वत्तो भीतो महाद्विज ।\nमत्सकाशमनुप्राप्तः प्राणगृध्नुरयं द्विजः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129397, "chapter_id": 3785, "verse_number": "४", "content_sanskrit": "एवमभ्यागतस्येह कपोतस्याभयार्थिनः ।\nअप्रदाने परोऽधर्मः किं त्वं श्येन प्रपश्यसि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129398, "chapter_id": 3785, "verse_number": "५", "content_sanskrit": "प्रस्पन्दमानः सम्भ्रान्तः कपोतः श्येन लक्ष्यते ।\nमत्सकाशं जीवितार्थे तस्य त्यागो विगर्हितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129399, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "श्येनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129400, "chapter_id": 3785, "verse_number": "६", "content_sanskrit": "आहारात् सर्वभूतानि सम्भवन्ति महीपते ।\nआहारेण विवर्धन्ते तेन जीवन्ति सर्वशः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129401, "chapter_id": 3785, "verse_number": "७", "content_sanskrit": "शक्यते दुस्त्यजेऽप्यर्थे चिररात्राय जीवितुम् ।\nन तु भोजनमुत्सृज्य शक्यं वर्तयितुं चिरम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129402, "chapter_id": 3785, "verse_number": "८", "content_sanskrit": "भक्षाद्विलोपितस्याद्य मम प्राणा विशांपते ।\nविसृज्य कायमेष्यन्ति पन्थानमपुनर्भवम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129403, "chapter_id": 3785, "verse_number": "९", "content_sanskrit": "प्रमृते मयि सर्वं मे पुत्रदारं मरिष्यति ।\nरक्षन् कपोतं राजंस्त्वं बहून् प्राणान् हनिष्यसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129404, "chapter_id": 3785, "verse_number": "१०", "content_sanskrit": "बहून् यो बाधते धर्मो न स धर्मः कुवर्त्म तत् ।\nअविरोधी तु यो धर्मः स धर्मः सद्भिरुच्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129405, "chapter_id": 3785, "verse_number": "११", "content_sanskrit": "विरोधिषु महीपाल निश्चित्य गुरुलाघवम् ।\nन बाधा विद्यते यत्र तं धर्मं समुपाचरेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129406, "chapter_id": 3785, "verse_number": "१२", "content_sanskrit": "गुरुलाघवमाज्ञाय धर्माधर्मविनिश्चये ।\nयतो भूयस्ततो राजन् कुरु धर्मविनिश्चयम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129407, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129408, "chapter_id": 3785, "verse_number": "१३", "content_sanskrit": "बहुकल्याणसंयुक्तं भाषसे विहगोत्तम ।\nसुपर्णः पक्षिराट् किं त्वं धर्मज्ञस्तु विभाव्यसे ।\nस तथा धर्मसंयुक्तं बहुचित्रं प्रभाषसे \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129409, "chapter_id": 3785, "verse_number": "१४", "content_sanskrit": "न तेऽस्त्यविदितं किञ्चिदिति त्वां लक्षयाम्यहम् ।\nशरणागतसंत्यागं कथं साध्विति मन्यसे \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129410, "chapter_id": 3785, "verse_number": "१५", "content_sanskrit": "आहारार्थं समारम्भः तव चायं विहङ्गम ।\nशक्यश्चाप्यन्यथा कर्तुमाहारोऽप्यधिकस्त्वया\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129411, "chapter_id": 3785, "verse_number": "१६", "content_sanskrit": "गोवृषो वा वराहो वा मृगो वा महिषोऽपि वा ।\nत्वदर्थमत्र क्रियतां यदन्यदभिकाङ्क्षसे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129412, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "श्येनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129413, "chapter_id": 3785, "verse_number": "१७", "content_sanskrit": "न वराहं न चोक्षाणं न मृगांश्च पृथग्विधान् ।\nभक्षयाम महाराज किं ममान्येन केनचित् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129414, "chapter_id": 3785, "verse_number": "१८", "content_sanskrit": "यस्तु मे देवविहितो भक्षः क्षत्रियपुङ्गव ।\nतमुत्सृज महाराज कपोतमिममेव मे \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129415, "chapter_id": 3785, "verse_number": "१९", "content_sanskrit": "श्येनाः कपोतान् खादन्ति श्रुतिरेषा सनातनी ।\nमा राजन् सारमज्ञात्वा कदलीस्कन्धमारुह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129416, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129417, "chapter_id": 3785, "verse_number": "२०", "content_sanskrit": "राष्ट्रं शिबीनामृद्धं वै शाधि पक्षिभिरर्चितः ।\nकृत्स्नमेतन्मया दत्तं राजवद् विहगोत्तम \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129418, "chapter_id": 3785, "verse_number": "२१", "content_sanskrit": "यद् वा कामयसे किञ्चित् श्येन सर्वं ददानि ते ।\nविनेमं पक्षिणं श्येन शरणार्थिनमागतम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129419, "chapter_id": 3785, "verse_number": "२२", "content_sanskrit": "येनेमं स्थापयेथास्त्वं कर्मणा पक्षिसत्तम ।\nतदाचक्ष्व करिष्यामि न हि दास्ये कपोतकम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2129420, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "श्येनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2129421, "chapter_id": 3785, "verse_number": "२३", "content_sanskrit": "उशीनर कपोते ते यदि स्नेहो नराधिप ।\nआत्मानं सुसमुत्कृत्य कपोततुलया धृतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2129422, "chapter_id": 3785, "verse_number": "२४", "content_sanskrit": "यदा समं कपोतेन तव मांसं नराधिप ।\nतदा प्रदेयं तन्मह्यं सा मे तुष्टिर्भविष्यति \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2129423, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2129424, "chapter_id": 3785, "verse_number": "२५", "content_sanskrit": "अनुग्रहमिमं मन्ये यन्मां श्येनाभियाचसे ।\nतस्मात् तेऽद्य प्रदास्यामि स्वमांसं तुलया धृतम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2129425, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2129426, "chapter_id": 3785, "verse_number": "२६", "content_sanskrit": "अथोत्कृत्य स्वमांसं तु राजा परमधर्मवित् ।\nतुलयामास कौन्तेय कपोतेन समं विभो \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2129427, "chapter_id": 3785, "verse_number": "२७", "content_sanskrit": "ध्रियमाणस्तु तुलया कपोतोऽत्यतिरिच्यते ।\nपुनश्चोत्कृत्य मांसानि राजा प्रादादुशीनरः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2129428, "chapter_id": 3785, "verse_number": "२८", "content_sanskrit": "न विद्यते यदा मांसं कपोतेन समं धृतम् ।\nततः प्रक्षीणमांसोऽसावारुरोह तुलां स्वयम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2129429, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "श्येनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2129430, "chapter_id": 3785, "verse_number": "२९", "content_sanskrit": "इन्द्रोऽहमस्मि धर्मज्ञ कपोतो हव्यवाडयम् ।\nजिज्ञासमानौ धर्मं त्वां यज्ञवाटमुपागतौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2129431, "chapter_id": 3785, "verse_number": "३०", "content_sanskrit": "यत्ते मांसानि गात्रेभ्यः समुत्कृत्तानि पार्थिव ।\nएषा ते शाश्वती कीर्तिर्लोकानभिभविष्यति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2129432, "chapter_id": 3785, "verse_number": "३१", "content_sanskrit": "यावल्लोके मनुष्यास्त्वां कथयिष्यन्ति पार्थिव ।\nतावत् कीर्तिश्च लोकाश्च स्थास्यन्ति तव सर्वदा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2129433, "chapter_id": 3785, "verse_number": "३२", "content_sanskrit": "इत्युक्त्वा तं दानपतिमिन्द्राग्नी तौ तदा नृपम् ।\nपूर्वदेहयुतं कृत्वा जग्मतुस्त्रिदशालयम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2129434, "chapter_id": 3785, "verse_number": "३३", "content_sanskrit": "तत् पाण्डवेय यजनं राज्ञस्तस्य महात्मनः ।\nपश्यस्वैतन्मया सार्धं पुण्यं पापप्रणाशनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2129435, "chapter_id": 3785, "verse_number": "३४", "content_sanskrit": "अत्रैव सततं देवा मुनयश्च तपोधनाः ।\nदृश्यन्ते ब्राह्मणा राजन् पुण्यवद्भिर्महात्मभिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2129436, "chapter_id": 3785, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्तविंशोत्तरशततमोऽध्यायः ॥१२७॥\n॥ तीर्थयात्रापर्वणि त्र्यशीतितमोऽध्यायः ॥८३॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]