[{"id": 7001473000, "chapter_id": 21473, "verse_number": "७-२-११-१", "content_sanskrit": "ईश्वर उवाच ।\nअथ वक्ष्यामि देवेशि भक्तानामधिकारिणाम् ।\nविदुषां द्विजमुख्यानां वर्णधर्मसमासतः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001473001, "chapter_id": 21473, "verse_number": "७-२-११-२", "content_sanskrit": "त्रिः स्नानं चाग्निकार्यं च लिंगार्चनमनुक्रमम् ।\nदानमीश्ररभावश्च दया सर्वत्र सर्वदा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001473002, "chapter_id": 21473, "verse_number": "७-२-११-३", "content_sanskrit": "सत्यं संतोषमास्तिक्यमहिंसा सर्वजंतुषु ।\nह्रीश्रद्धाध्ययनं योगस्सदाध्यापनमेव च॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001473003, "chapter_id": 21473, "verse_number": "७-२-११-४", "content_sanskrit": "व्याख्यानं ब्रह्मचर्यं च श्रवणं च तपः क्षमा ।\nशौचं शिखोपवीतं च उष्णीषं चोत्तरीयकम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001473004, "chapter_id": 21473, "verse_number": "७-२-११-५", "content_sanskrit": "निषिद्धासेवनं चैव भस्मरुद्राक्षधारणम् ।\nपर्वण्यभ्यर्चनं देवि चतुर्दश्यां विशेषतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001473005, "chapter_id": 21473, "verse_number": "७-२-११-६", "content_sanskrit": "पानं च ब्रह्मकूर्चस्य मासि मासि यथाविधि ।\nअभ्यर्चनं विशेषेण तेनैव स्नाप्य मां प्रिये॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001473006, "chapter_id": 21473, "verse_number": "७-२-११-७", "content_sanskrit": "सर्वक्रियान्न सन्त्यागः श्रद्धान्नस्य च वर्जनम् ।\nतथा पर्युषितान्नस्य यावकस्य विशेषतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001473007, "chapter_id": 21473, "verse_number": "७-२-११-८", "content_sanskrit": "मद्यस्य मद्यगन्धस्य नैवेद्यस्य च वर्जनम् ।\nसामान्यं सर्ववर्णानां ब्राह्मणानां विशेषतः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001473008, "chapter_id": 21473, "verse_number": "७-२-११-९", "content_sanskrit": "क्षमा शांतिश्च सन्तोषस्सत्यमस्तेयमेव च ।\nब्रह्मचर्यं मम ज्ञानं वैराग्यं भस्मसेवनम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001473009, "chapter_id": 21473, "verse_number": "७-२-११-१०", "content_sanskrit": "सर्वसंगनिवृत्तिश्च दशैतानि विशेषतः ।\nलिंगानि योगिनां भूयो दिवा भिक्षाशनं तथा॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001473010, "chapter_id": 21473, "verse_number": "७-२-११-११", "content_sanskrit": "वानप्रस्थाश्रमस्थानां समानमिदमिष्यते ।\nरात्रौ न भोजनं कार्यं सर्वेषां ब्रह्मचारिणाम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001473011, "chapter_id": 21473, "verse_number": "७-२-११-१२", "content_sanskrit": "अध्यापनं याजनं च क्षत्रियस्याप्रतिग्रहः ।\nवैश्यस्य च विशेषेण मया नात्र विधीयते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001473012, "chapter_id": 21473, "verse_number": "७-२-११-१३", "content_sanskrit": "रक्षणं सर्ववर्णानां युद्धे शत्रुवधस्तथा ।\nदुष्टपक्षिमृगाणां च दुष्टानां शातनं नृणाम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001473013, "chapter_id": 21473, "verse_number": "७-२-११-१४", "content_sanskrit": "अविश्वासश्च सर्वत्र विश्वासो मम योगिषु ।\nस्त्रीसंसर्गश्च कालेषु चमूरक्षणमेव च॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001473014, "chapter_id": 21473, "verse_number": "७-२-११-१५", "content_sanskrit": "सदा संचारितैश्चारैर्लोकवृत्तांतवेदनम् ।\nसदास्त्रधारणं चैव भस्मकंचुकधारणम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001473015, "chapter_id": 21473, "verse_number": "७-२-११-१६", "content_sanskrit": "राज्ञां ममाश्रमस्थानामेष धर्मस्य संग्रहः ।\nगोरक्षणं च वाणिज्यं कृषिर्वैश्यस्य कथ्यते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001473016, "chapter_id": 21473, "verse_number": "७-२-११-१७", "content_sanskrit": "शुश्रूषेतरवर्णानां धर्मः शूद्रस्य कथ्यते ।\nउद्यानकरणं चैव मम क्षेत्रसमाश्रयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001473017, "chapter_id": 21473, "verse_number": "७-२-११-१८", "content_sanskrit": "धर्मपत्न्यास्तु गमनं गृहस्थस्य विधीयते ।\nब्रह्मचर्यं वनस्थानां यतीनां ब्रह्मचारिणाम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001473018, "chapter_id": 21473, "verse_number": "७-२-११-१९", "content_sanskrit": "स्त्रीणां तु भर्तृशुश्रूषा धर्मो नान्यस्सनातनः ।\nममार्चनं च कल्याणि नियोगो भर्तुरस्ति चेत्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001473019, "chapter_id": 21473, "verse_number": "७-२-११-२०", "content_sanskrit": "या नारी भर्तृशुश्रूषां विहाय व्रततत्परा ।\nसा नारी नरकं याति नात्र कार्या विचारणा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001473020, "chapter_id": 21473, "verse_number": "७-२-११-२१", "content_sanskrit": "अथ भर्तृविहीनाया वक्ष्ये धर्मं सनातनम् ।\nव्रतं दानं तपः शौचं भूशय्यानक्तभोजनम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001473021, "chapter_id": 21473, "verse_number": "७-२-११-२२", "content_sanskrit": "ब्रह्मचर्यं सदा स्नानं भस्मना सलिलेन वा ।\nशांतिर्मौनं क्षमा नित्यं संविभागो यथाविधि॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001473022, "chapter_id": 21473, "verse_number": "७-२-११-२३", "content_sanskrit": "अष्टाभ्यां च चतुर्दश्यां पौर्णमास्यां विशेषतः ।\nएकादश्यां च विधिवदुपवासोममार्चनम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001473023, "chapter_id": 21473, "verse_number": "७-२-११-२४", "content_sanskrit": "इति संक्षेपतः प्रोक्तो मयाश्रमनिषेविणाम् ।\nब्रह्मक्षत्रविशां देवि यतीनां ब्रह्मचारिणाम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001473024, "chapter_id": 21473, "verse_number": "७-२-११-२५", "content_sanskrit": "तथैव वानप्रस्थानां गृहस्थानां च सुन्दरि ।\nशूद्राणामथ नारीणां धर्म एष सनातनः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001473025, "chapter_id": 21473, "verse_number": "७-२-११-२६", "content_sanskrit": "ध्येयस्त्वयाहं देवेशि सदा जाप्यः षडक्षरः ।\nवेदोक्तमखिलं धर्ममिति धर्मार्थसंग्रहः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001473026, "chapter_id": 21473, "verse_number": "७-२-११-२७", "content_sanskrit": "अथ ये मानवा लोके स्वेच्छया धृतविग्रहाः ।\nभावातिशयसंपन्नाः पूर्वसंस्कारसंयुताः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001473027, "chapter_id": 21473, "verse_number": "७-२-११-२८", "content_sanskrit": "विरक्ता वानुरक्ता वा स्त्र्यादीनां विषयेष्वपि ।\nपापैर्न ते विलिंपंते १ पद्मपत्रमिवांभसा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001473028, "chapter_id": 21473, "verse_number": "७-२-११-२९", "content_sanskrit": "तेषां ममात्मविज्ञानं विशुद्धानां विवेकिनाम् ।\nमत्प्रसादाद्विशुद्धानां दुःखमाश्रमरक्षणात्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001473029, "chapter_id": 21473, "verse_number": "७-२-११-३०", "content_sanskrit": "नास्ति कृत्यमकृत्यं च समाधिर्वा परायणम् ।\nन विधिर्न निषेधश्च तेषां मम यथा तथा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001473030, "chapter_id": 21473, "verse_number": "७-२-११-३१", "content_sanskrit": "तथेह परिपूर्णस्य साध्यं मम न विद्यते ।\nतथैव कृतकृत्यानां तेषामपि न संशयः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001473031, "chapter_id": 21473, "verse_number": "७-२-११-३२", "content_sanskrit": "मद्भक्तानां हितार्थाय मानुषं भावमाश्रिताः ।\nरुद्रलोकात्परिभ्रष्टास्ते रुद्रा नात्र संशयः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001473032, "chapter_id": 21473, "verse_number": "७-२-११-३३", "content_sanskrit": "ममानुशासनं यद्वद्ब्रह्मादीनां प्रवर्तकम् ।\nतथा नराणामन्येषां तन्नियोगः प्रवर्तकः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001473033, "chapter_id": 21473, "verse_number": "७-२-११-३४", "content_sanskrit": "ममाज्ञाधारभावेन सद्भावातिशयेन च ।\nतदालोकनमात्रेण सर्वपापक्षयो भवेत्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001473034, "chapter_id": 21473, "verse_number": "७-२-११-३५", "content_sanskrit": "प्रत्ययाश्च प्रवर्तंते प्रशस्तफलसूचकाः ।\nमयि भाववतां पुंसां प्रागदृष्टार्थगोचराः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001473035, "chapter_id": 21473, "verse_number": "७-२-११-३६", "content_sanskrit": "कंपस्वेदो ऽश्रुपातश्च कण्ठे च स्वरविक्रिया ।\nआनंदाद्युपलब्धिश्च भवेदाकस्मिकी मुहुः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001473036, "chapter_id": 21473, "verse_number": "७-२-११-३७", "content_sanskrit": "स तैर्व्यस्तैस्समस्तैर्वा लिंगैरव्यभिचारिभिः ।\nमंदमध्योत्तमैर्भावैर्विज्ञेयास्ते नरोत्तमाः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001473037, "chapter_id": 21473, "verse_number": "७-२-११-३८", "content_sanskrit": "यथायोग्निसमावेशान्नायो भवति केवलम् ।\nस तथैव मम सान्निध्यान्न ते केवलमानुषाः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001473038, "chapter_id": 21473, "verse_number": "७-२-११-३९", "content_sanskrit": "हस्तपादादिसाधर्म्याद्रुद्रान्मर्त्यवपुर्धरान् ।\nप्राकृतानिव मन्वानो नावजानीत पंडितः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001473039, "chapter_id": 21473, "verse_number": "७-२-११-४०", "content_sanskrit": "अवज्ञानं कृतं तेषु नरैर्व्यामूढचेतनैः ।\nआयुः श्रियं कुलं शीलं हित्वा निरयमावहेत्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001473040, "chapter_id": 21473, "verse_number": "७-२-११-४१", "content_sanskrit": "ब्रह्मविष्णुसुरेशानामपि तूलायते पदम् ।\nमत्तोन्यदनपेक्षाणामुद्धृतानां महात्मनाम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001473041, "chapter_id": 21473, "verse_number": "७-२-११-४२", "content_sanskrit": "अशुद्धं बौद्धमैश्वर्यं प्राकृतं पौरुषं तथा ।\nगुणेशानामतस्त्याज्यं गुणातीतपदैषिणाम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001473042, "chapter_id": 21473, "verse_number": "७-२-११-४३", "content_sanskrit": "अथ किं बहुनोक्तेन श्रेयः प्राप्त्यैकसाधनम् ।\nमयि चित्तसमासंगो येन केनापि हेतुना॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001473043, "chapter_id": 21473, "verse_number": "७-२-११-४४", "content_sanskrit": "उपमन्युरुवाच ।\nइत्थं श्रीकण्ठनाथेन शिवेन परमात्मना ।\nहिताय जगतामुक्तो ज्ञानसारार्थसंग्रहः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001473044, "chapter_id": 21473, "verse_number": "७-२-११-४५", "content_sanskrit": "विज्ञानसंग्रहस्यास्य वेदशास्त्राणि कृत्स्नशः ।\nसेतिहासपुराणानि विद्या व्याख्यानविस्तरः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001473045, "chapter_id": 21473, "verse_number": "७-२-११-४६", "content_sanskrit": "ज्ञानं ज्ञेयमनुष्ठेयमधिकारो ऽथ साधनम् ।\nसाध्यं चेति षडर्थानां संग्रहत्वेष संग्रहः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001473046, "chapter_id": 21473, "verse_number": "७-२-११-४७", "content_sanskrit": "गुरोरधिकृतं ज्ञानं ज्ञेयं पाशः पशुः पतिः ।\nलिंगार्चनाद्यनुष्ठेयं भक्तस्त्वधिकृतो ऽपि यः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001473047, "chapter_id": 21473, "verse_number": "७-२-११-४८", "content_sanskrit": "साधनं शिवमंत्राद्यं साध्यं शिवसमानता ।\nषडर्थसंग्रहस्यास्य ज्ञानात्सर्वज्ञतोच्यते॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001473048, "chapter_id": 21473, "verse_number": "७-२-११-४९", "content_sanskrit": "प्रथमं कर्म यज्ञादेर्भक्त्या वित्तानुसारतः ।\nबाह्येभ्यर्च्य शिवं पश्चादंतर्यागरतो भवेत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001473049, "chapter_id": 21473, "verse_number": "७-२-११-५०", "content_sanskrit": "रतिरभ्यंतरे यस्य न बाह्ये पुण्यगौरवात् ।\nन कर्म करणीयं हि बहिस्तस्य महात्मनाः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001473050, "chapter_id": 21473, "verse_number": "७-२-११-५१", "content_sanskrit": "ज्ञानामृतेन तृप्तस्य भक्त्या शैवशिवात्मनः ।\nनांतर्न च बहिः कृष्ण कृत्यमस्ति कदाचन॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001473051, "chapter_id": 21473, "verse_number": "७-२-११-५२", "content_sanskrit": "तस्मात्क्रमेण संत्यज्य बाह्यमाभ्यंतरं तथा ।\nज्ञानेन ज्ञेयमालोक्याज्ञानं चापि परित्यजेत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001473052, "chapter_id": 21473, "verse_number": "७-२-११-५३", "content_sanskrit": "नैकाग्रं चेच्छिवे चित्तं किं कृतेनापि कर्मणा ।\nएकाग्रमेव चेच्चित्तं किं कृतेनापि कर्मणा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001473053, "chapter_id": 21473, "verse_number": "७-२-११-५४", "content_sanskrit": "तस्मात्कर्माण्यकृत्वा वा कृत्वा वांतर्बहिःक्रमात् ।\nयेन केनाप्युपायेन शिवे चित्तं निवेशयेत्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001473054, "chapter_id": 21473, "verse_number": "७-२-११-५५", "content_sanskrit": "शिवे निविष्टचित्तानां प्रतिष्ठितधियां सताम् ।\nपरत्रेह च सर्वत्र निर्वृतिः परमा भवेत्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001473055, "chapter_id": 21473, "verse_number": "७-२-११-५६", "content_sanskrit": "इहोन्नमः शिवायेति मंत्रेणानेन सिद्धयः ।\nस तस्मादधिगंतव्यः परावरविभूतये॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]