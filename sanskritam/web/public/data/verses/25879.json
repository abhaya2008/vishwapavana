[{"id": 7005879000, "chapter_id": 25879, "verse_number": "१-६२-१", "content_sanskrit": "हरिरुवाच ।\nउदयात्तु समारभ्य राशौ भानुः स्थितो हर ।\nस्वराश्याद्यैर्व्रजेदह्नि षडभिः षटभिस्तथा निशि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005879001, "chapter_id": 25879, "verse_number": "१-६२-२", "content_sanskrit": "मीने मेषे च पञ्च स्युश्चतस्त्रो वृष कुम्योः।\nमकरे मिथुने तिस्त्रः पंच चापे च कर्कटे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005879002, "chapter_id": 25879, "verse_number": "१-६२-३", "content_sanskrit": "सिंहे च वृश्चिके षट् च सप्त कन्यातुलेतथा।\nएता लग्नप्रमाणेन घटिकाः परिकीर्त्तिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005879003, "chapter_id": 25879, "verse_number": "१-६२-४", "content_sanskrit": "रसपूर्वावसानेषु रसाब्धिष्वरिसागराः ।\nलङ्कोदया हि तद्वत्त लग्ना मेषादयोऽथ वा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005879004, "chapter_id": 25879, "verse_number": "१-६२-५", "content_sanskrit": "मेषलग्ने भवेद्वन्ध्या वृषे भवति कामिनी ।\nमिथुने सुभगा कन्या वेश्या भवति कर्कटे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005879005, "chapter_id": 25879, "verse_number": "१-६२-६", "content_sanskrit": "सिंहे चैवाल्पपुत्रा च कन्यायां रूपसंयुता ।\nतुलायां रूपमैश्वर्य्यं वश्चिके कर्कशा भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005879006, "chapter_id": 25879, "verse_number": "१-६२-७", "content_sanskrit": "सौभाग्यधनुषि स्याच्च मकरे नीचगामिनी ।\nकुम्भ चैवाल्पपुत्रा स्यान्मीने वैराग्यसंयुता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005879007, "chapter_id": 25879, "verse_number": "१-६२-८", "content_sanskrit": "तुला कर्कटको मेषो मकरश्चैव राशयः ।\nचरकार्य्याणि कुर्य्याच्च स्थिरकार्य्याणि चैव हि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005879008, "chapter_id": 25879, "verse_number": "१-६२-९", "content_sanskrit": "पञ्चाननो वृषः कुम्भा वृश्चिकः स्युः स्थिराणि ह।\nकन्या धनुश्च मीनश्च मिथुनं द्विस्वभावतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005879009, "chapter_id": 25879, "verse_number": "१-६२-१०", "content_sanskrit": "द्विस्वभावानि कर्माणि कुर्य्यादेषु विचक्षणः ।\nयात्रा चरेण कर्त्तव्या प्रवेष्टव्यं स्थिरेण तु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005879010, "chapter_id": 25879, "verse_number": "१-६२-११", "content_sanskrit": "देवस्थापनवैवाह्यं द्विस्वभावेन कारयेत् ।\nप्रतिपच्चाथ षष्ठी च नन्दा चैकादशी स्मृता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005879011, "chapter_id": 25879, "verse_number": "१-६२-१२", "content_sanskrit": "द्वितीया सप्तमी भद्रा द्वादशी वृषभध्वज ।\nजयाष्टमी तृतीया च स्मृता रुद्र त्रयोदशी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005879012, "chapter_id": 25879, "verse_number": "१-६२-१३", "content_sanskrit": "चतुर्थो नवमी रिक्ता सा वर्ज्याथ चतुर्दशी ।\nपञ्चमी दशमी पूर्णा पूर्णिमा च शुभाः स्मृताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005879013, "chapter_id": 25879, "verse_number": "१-६२-१४", "content_sanskrit": "चरः सौम्यो गुरुः क्षिप्रो मृदुः शुक्रो रविर्ध्रव।\nशनिश्च दारुणो ज्ञेयो भौम उग्रः शशी समः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005879014, "chapter_id": 25879, "verse_number": "१-६२-१५", "content_sanskrit": "चरक्षिप्रैः प्रयातव्यं प्रवेष्टव्यं मृद्रुध्रुवैः ।\nदारुणोग्रैश्च योद्धव्यं क्षत्त्रियैर्जयकाङ्क्षिभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005879015, "chapter_id": 25879, "verse_number": "१-६२-१६", "content_sanskrit": "नृपाभिषेकोऽग्निकार्य्यं सोमवारे प्रशस्यते ।\nसोमे तु लेपमानं च कुर्य्याच्चैव गृहादिकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005879016, "chapter_id": 25879, "verse_number": "१-६२-१७", "content_sanskrit": "सैनापत्यं शौर्ययुद्धं शस्त्राभ्यासः कुजे स्मृतः ।\nसिद्धिकार्य्यं च मन्त्रश्च यात्रा चैव बुधे स्मृता ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005879017, "chapter_id": 25879, "verse_number": "१-६२-१८", "content_sanskrit": "पठनं देवपूजा च वस्त्राद्याभरणं गुरौ ।\nकन्यादानं गजारोहः शुक्रे स्यात्समयः स्त्रियाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005879018, "chapter_id": 25879, "verse_number": "१-६२-१९", "content_sanskrit": "स्थाप्यं गृहप्रवेशश्च गजबन्धः शनौ शुभः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]