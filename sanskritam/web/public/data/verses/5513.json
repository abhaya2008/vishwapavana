[{"id": 2211719, "chapter_id": 5513, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2211720, "chapter_id": 5513, "verse_number": "१", "content_sanskrit": "इदं मे तत्त्वतो देव वक्तुमर्हस्यशेषतः ।\nहिंसामकृत्वा यो मर्त्यो ब्रह्महत्यामवाप्नुयात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2211721, "chapter_id": 5513, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2211722, "chapter_id": 5513, "verse_number": "२", "content_sanskrit": "ब्राह्मणं स्वयमाहूय भिक्षार्थं कृशवृत्तिनम् ।\nब्रूयान्नास्तीति यः पश्चात् तमाहुर्ब्रह्मघातकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2211723, "chapter_id": 5513, "verse_number": "३", "content_sanskrit": "मध्यस्थस्येह विप्रस्य योऽनूचानस्य भारत ।\nवृत्तिं हरति दुर्बुद्धिस्तमाहुर्ब्रह्मघातकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2211724, "chapter_id": 5513, "verse_number": "४", "content_sanskrit": "गोकुलस्य तृषार्तस्य जलान्ते वसुधाधिप ।\nउत्पादयति यो विघ्नं तमाहुर्ब्रह्मघातकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2211725, "chapter_id": 5513, "verse_number": "५", "content_sanskrit": "यः प्रवृत्तां श्रुतिं सम्यक् शास्त्रं वा मुनिभिः कृतम् ।\nदूषयत्यनभिज्ञाय तमाहुर्ब्रह्मघातकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2211726, "chapter_id": 5513, "verse_number": "६", "content_sanskrit": "आश्रमे वा वने वाऽपि ग्रामे वा नगरेऽपि वा ।\nअग्निं यः प्रक्षिपेत् क्रुद्धः तमाहुर्ब्रह्मघातकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2211727, "chapter_id": 5513, "verse_number": "७", "content_sanskrit": "चक्षुषा वा विहीनस्य पङ्गोर्वाऽपि जडस्य वा ।\nहरेद्वै यस्तु सर्वस्वं तमाहुर्ब्रह्मघातकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2211728, "chapter_id": 5513, "verse_number": "८", "content_sanskrit": "यावत्सारो भवेद् दीनस्तन्नाशे यस्य दुःस्थितिः ।\nतत्सर्वस्वं हरेद् यो वै तमाहुर्ब्रह्मघातकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2211729, "chapter_id": 5513, "verse_number": "९", "content_sanskrit": "क्रोधाद्वा यदि वा द्वेषादाक्रुष्टस्तर्जितोपि वा ।\nऋतौ स्त्रियं वा नोपेयात् तमाहुर्बह्मघातकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2211730, "chapter_id": 5513, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2211731, "chapter_id": 5513, "verse_number": "१०", "content_sanskrit": "सर्वेषामपि दानानां यत्तु दानं विशिष्यते ।\nअभोज्यान्नाश्च ये विप्रास्तान् ब्रवीहि सुरोत्तम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2211732, "chapter_id": 5513, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2211733, "chapter_id": 5513, "verse_number": "११", "content_sanskrit": "अन्नमेव प्रशंसन्ति देवा ब्रह्मपुरःसराः ।\nअन्नेन सदृशं दानं न भूतं न भविष्यति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2211734, "chapter_id": 5513, "verse_number": "१२", "content_sanskrit": "अन्नमूर्जस्करं लोके अन्नात् प्राणाः प्रतिष्ठिताः ।\nअभोज्यान्नान् मया राजन् वक्ष्यमाणान् निबोध मे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2211735, "chapter_id": 5513, "verse_number": "१३", "content_sanskrit": "दीक्षितस्य कदर्यस्य बद्धस्य निगलेन तु ।\nअभिशस्तस्य षण्डस्य पाकभेदकरस्य च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2211736, "chapter_id": 5513, "verse_number": "१४", "content_sanskrit": "चिकित्सकस्य दूतस्य तथा चोच्छिष्टभोजिनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2211737, "chapter_id": 5513, "verse_number": "१५", "content_sanskrit": "उग्रान्नं सूतकान्नं च शूद्रोच्छेषणमेव च ।\nद्विषदन्नं न भोक्तव्यं पतितान्नं च यच्छ्रुतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2211738, "chapter_id": 5513, "verse_number": "१६", "content_sanskrit": "तथा च पिशुनस्यान्नं यज्ञविक्रयिणस्तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2211739, "chapter_id": 5513, "verse_number": "१७", "content_sanskrit": "शैलूषीतन्तुवायान्नं कृतघ्नस्यान्नमेव च ।\nअम्बष्ठस्य निषादस्य रङ्गावतरकस्य च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2211740, "chapter_id": 5513, "verse_number": "१८", "content_sanskrit": "सुवर्णकर्तुर्वैणस्य शस्त्रविक्रयिणस्तथा ।\nसूतानां शौण्डिकानां च वैद्यस्य रजकस्य च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2211741, "chapter_id": 5513, "verse_number": "१९", "content_sanskrit": "स्त्रीजितस्य नृशंसस्य तथा माहिषकस्य च ।\nअनिर्दशानां प्रेतानां गणिकानां तथैव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2211742, "chapter_id": 5513, "verse_number": "२०", "content_sanskrit": "बन्दिनो द्यूतकर्तुश्च तथा द्यूतविदामपि ।\nपरिवित्तेश्च(स्य) यच्चान्नं परिवेत्तुस्तथैव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2211743, "chapter_id": 5513, "verse_number": "२१", "content_sanskrit": "यश्चाग्रेदिधिषुर्विप्रो दिधिषूपपतिस्तथा ।\nतयोरप्युभयोरन्नं राज्ञां चापि विवर्जयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2211744, "chapter_id": 5513, "verse_number": "२२", "content_sanskrit": "राजान्नं तेज आदत्ते शूद्रान्नं ब्रह्मवर्चसम् ।\nआयुः सुवर्णकारान्नं यशश्चर्मावकृन्तिनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2211745, "chapter_id": 5513, "verse_number": "२३", "content_sanskrit": "गणान्नं गणिकान्नं च लोकेभ्यः परिकृन्तति ।\nपूयं चिकित्सकस्यान्नं शुक्लं तु वृषलीपतेः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2211746, "chapter_id": 5513, "verse_number": "२४", "content_sanskrit": "विष्ठा वार्धुषिकस्यान्नं तस्मात् तत् परिवर्जयेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2211747, "chapter_id": 5513, "verse_number": "२५", "content_sanskrit": "तेषां त्वगस्थिरोमाणि भुङ्क्ते योऽन्नं तु भक्षयेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2211748, "chapter_id": 5513, "verse_number": "२६", "content_sanskrit": "अमात्यान्नमथैतेषां भुक्त्वा तु त्र्यक्षरं जपेत् ।\nमत्या भुक्त्वा सकृद् वाऽपि प्राजापत्यं चरेद् द्विजः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2211749, "chapter_id": 5513, "verse_number": "२७", "content_sanskrit": "दानानां च फलं यद्वै शृणु पाण्डव तत्त्वतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2211750, "chapter_id": 5513, "verse_number": "२८", "content_sanskrit": "जलदस्तृप्तिमाप्नोति सुखमक्षयमन्नदः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2211751, "chapter_id": 5513, "verse_number": "२९", "content_sanskrit": "तिलदस्तु प्रजामिष्टां दीपदश्चक्षुरुत्तमम् ।\nभूमिदो भूमिमाप्नोति दीर्घमायुर्हिरण्यदः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2211752, "chapter_id": 5513, "verse_number": "३०", "content_sanskrit": "गृहदोऽग्र्याणि वेश्मानि रूप्यदो रूपमुत्तमम् ।\nवासोदश्चन्द्रसालोक्यमश्विसालोक्यमश्वदः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2211753, "chapter_id": 5513, "verse_number": "३१", "content_sanskrit": "अनडुद्दः श्रियं जुष्टां गोदो गोलोकमश्नुते ।\nयानशय्याप्रदो भार्यामैश्वर्यमभयप्रदः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2211754, "chapter_id": 5513, "verse_number": "३२", "content_sanskrit": "धान्यदः शाश्वतं सौख्यं ब्रह्मदो ब्रह्मसाम्यताम् ।\nसर्वेषामेव दानानां ब्रह्मदानं विशिष्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2211755, "chapter_id": 5513, "verse_number": "३३", "content_sanskrit": "हिरण्यभूगवाश्वाजवस्त्रशय्यासनादिषु ।\nयोऽर्चितं प्रतिगृह्णाति ददात्यर्चितमेव च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2211756, "chapter_id": 5513, "verse_number": "३४", "content_sanskrit": "तावुभौ गच्छतः स्वर्गं नरकं तु विपर्यये ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2211757, "chapter_id": 5513, "verse_number": "३५", "content_sanskrit": "अनृतं न वदेद् विद्वांस्तपस्तप्त्वा न विस्मयेत् ।\nनार्तोऽप्यपवदेद् विप्रान् न दत्त्वा परिकीर्तयेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2211758, "chapter_id": 5513, "verse_number": "३६", "content_sanskrit": "यज्ञोऽनृतेन क्षरति तपः क्षरति विस्मयात् ।\nआयुर्विप्रापवादेन दानं तु परिकीर्तनात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2211759, "chapter_id": 5513, "verse_number": "३७", "content_sanskrit": "एकः प्रजायते जन्तुरेक एव प्रमीयते ।\nएकोऽनुभुङ्क्ते सुकृतमेकाश्चाप्नोति दुष्कृतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2211760, "chapter_id": 5513, "verse_number": "३८", "content_sanskrit": "मृतं शरीरमुत्सृज्य काष्ठलोहसमं क्षितौ ।\nविमुखा बान्धवा यान्ति धर्मस्तमनुगच्छति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2211761, "chapter_id": 5513, "verse_number": "३९", "content_sanskrit": "अनागतानि कार्याणि कर्तुं गणयते मनः ।\nशरीरकं समुद्वीक्ष्य स्मयते नूनमन्तकः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2211762, "chapter_id": 5513, "verse_number": "४०", "content_sanskrit": "तस्माद् धर्मसहायस्तु धर्मं सञ्चिनुयात् सदा ।\nधर्मेण हि सहायेन तमस्तरति दुस्तरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2211763, "chapter_id": 5513, "verse_number": "४१", "content_sanskrit": "येषां तटाकानि बहूदकानि\nसभाश्च कूपाश्च प्रतिश्रयाश्च ।\nअन्नप्रदानं मधुरा च वाणी\nयमस्य ते निर्विषया भवन्ति ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2211764, "chapter_id": 5513, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे भोज्याभोज्यादिसर्वदानकथनं नाम सप्ताधिकशततमोऽध्यायः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]