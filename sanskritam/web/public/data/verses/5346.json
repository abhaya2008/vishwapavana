[{"id": 2203798, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203799, "chapter_id": 5346, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश तेषां कर्मफलं प्रभो ।\nश्रोतुमिच्छाम्यहं देव प्रसादात् ते वरप्रद\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203800, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203801, "chapter_id": 5346, "verse_number": "२", "content_sanskrit": "वानप्रस्थगतं सर्वं फलपाकं शृणु प्रिये\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203802, "chapter_id": 5346, "verse_number": "३", "content_sanskrit": "अग्नियोगं व्रजन् ग्रीष्मे ततो द्वादशवार्षिकम् ।\nरुद्रलोके हि जायेत विधिदृष्टेन कर्मणा\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203803, "chapter_id": 5346, "verse_number": "४", "content_sanskrit": "उपवासव्रतं कुर्वन् वर्षाकाले दृढव्रतः ।\nसोमलोकेऽभिजायेत नरो द्वादशवार्षिकम्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203804, "chapter_id": 5346, "verse_number": "५", "content_sanskrit": "काष्ठवन्मौनमास्थाय नरो द्वादशवार्षिकम् ।\nमरुतां लोकमास्थाय तत्र भोगैश्च युज्यते\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203805, "chapter_id": 5346, "verse_number": "६", "content_sanskrit": "कुशशर्करसंयुक्ते स्थण्डिले संविशन् मुनिः ।\nयक्षलोकेऽभिजायेत सहस्राणि चतुर्दश\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203806, "chapter_id": 5346, "verse_number": "७", "content_sanskrit": "वर्षाणां भोगसंयुक्तो नरो द्वादशवार्षिकम् ।\nवीरासनगतो यस्तु कण्टकाफलकाश्रितः ।\nगन्धर्वेष्वभिजायेत सहस्राणि चतुर्दश\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203807, "chapter_id": 5346, "verse_number": "८", "content_sanskrit": "वीरस्थायी चोर्ध्वबाहुर्नरो द्वादशवार्षिकम् ।\nदेवलोकेऽभिजायेत दिव्यभोगसमन्वितः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203808, "chapter_id": 5346, "verse_number": "९", "content_sanskrit": "पादाङ्गुष्ठेन यस्तिष्ठेदूर्ध्वबाहुर्जितेन्द्रियः ।\nइन्द्रलोकेऽभिजायेत सहस्राणि चतुर्दश\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203809, "chapter_id": 5346, "verse_number": "१०", "content_sanskrit": "आहारनियमं कृत्वा मुनिर्द्वादशवार्षिकम् ।\nनागलोकेऽभिजायेत संवत्सरगणान् बहून्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203810, "chapter_id": 5346, "verse_number": "११", "content_sanskrit": "एवं दृढव्रता देवि वानप्रस्थाश्च कर्मभिः ।\nस्थानेषु तेषु तिष्ठन्ति तत्तद्भोगसमन्विताः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203811, "chapter_id": 5346, "verse_number": "१२", "content_sanskrit": "तेभ्यो भ्रष्टाः पुनर्देवि जायन्ते नृषु भोगिनः ।\nवर्णोत्तमकुलेष्वेव धनधान्यसमन्विताः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203812, "chapter_id": 5346, "verse_number": "१३", "content_sanskrit": "एतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203813, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203814, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "लोकान् वै विवराणां तु धर्ममिच्छामि मानद ।\nकृपया परयाऽऽविष्टस्तन्मे ब्रूहि महेश्वर\t ॥१४", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203815, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203816, "chapter_id": 5346, "verse_number": "१५", "content_sanskrit": "धर्मं च विवराणां त्वं शृणु भामिनि तत्परा\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203817, "chapter_id": 5346, "verse_number": "१६", "content_sanskrit": "व्रतोपवासशुद्धाङ्गास्तीर्थस्नानपरायणाः ।\nधृतिमन्तः क्षमायुक्ताः सत्यव्रतपरायणाः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203818, "chapter_id": 5346, "verse_number": "१७", "content_sanskrit": "पक्षमासोपवासैश्च कर्शिता धर्मदर्शिनः ।\nवर्षैः शीतातपैरेव कुर्वन्तः परमं तपः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2203819, "chapter_id": 5346, "verse_number": "१८", "content_sanskrit": "कालयोगेन गच्छन्ति शक्रलोकं शुचिस्मिते ।\nतत्र ते भोगसंयुक्ता दिव्यगन्धसमन्विताः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2203820, "chapter_id": 5346, "verse_number": "१९", "content_sanskrit": "दिव्यभूषणसंयुक्ता विमानवरसंयुताः ।\nविचरन्ति यथाकामं दिव्यस्त्रीगणसंयुताः ।\nएतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2203821, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2203822, "chapter_id": 5346, "verse_number": "२०", "content_sanskrit": "तेषां चक्रधराणां च धर्ममिच्छामि वै प्रभो\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2203823, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2203824, "chapter_id": 5346, "verse_number": "२१", "content_sanskrit": "हन्त ते कथयिष्यामि शृणु शाकटिकं शुभे\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2203825, "chapter_id": 5346, "verse_number": "२२", "content_sanskrit": "संवहन्तो धुरं दारैः शकटानां तु सर्वदा ।\nप्रार्थयन्ते यथा ग्राम्याः शकटैर्भैक्षचर्यया\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2203826, "chapter_id": 5346, "verse_number": "२३", "content_sanskrit": "तपोर्जनपरा धीरास्तपसा क्षीणकल्मषाः ।\nपर्यटन्तो दिशः सर्वाः कामक्रोधविवर्जिताः\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2203827, "chapter_id": 5346, "verse_number": "२४", "content_sanskrit": "स्ववशादेव ते मृत्युमभिकाङ्क्षन्ति नित्यशः ।\nइन्द्रलोके तथा तेषां निर्मिता भोगसञ्चयाः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2203828, "chapter_id": 5346, "verse_number": "२५", "content_sanskrit": "अमरैः सह ते यान्ति देववद् भोगसंयुताः ।\nवराप्सरोभिः संयुक्ताश्चिरकालमनिन्दिते\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2203829, "chapter_id": 5346, "verse_number": "२६", "content_sanskrit": "तेनैव कालयोगेन त्रिदिवं यान्ति शोभने ।\nतत्र प्रमुदिता भोगैर्विचरन्ति यथासुखम्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2203830, "chapter_id": 5346, "verse_number": "२७", "content_sanskrit": "एतत्ते कथितं देवि किं भूयः श्रोतुमिच्छसि\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2203831, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2203832, "chapter_id": 5346, "verse_number": "२८", "content_sanskrit": "वैखानसानां वै धर्मं श्रोतुमिच्छाम्यहं प्रभो\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2203833, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2203834, "chapter_id": 5346, "verse_number": "२९", "content_sanskrit": "ते वै वैखानसा नाम वानप्रस्थाः शुभेक्षणे ।\nतीव्रेण तपसा युक्ता दीप्तिमन्तः स्वतेजसा ।\nसत्यव्रतपरा धीरास्तेषां निष्कल्मषं तपः\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2203835, "chapter_id": 5346, "verse_number": "३०", "content_sanskrit": "अश्मकुट्टास्तथाऽन्ये च दन्तोलूखलिनस्तथा ।\nशीर्णपर्णाशिनश्चान्ये उञ्छयन्ति तथा परे\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2203836, "chapter_id": 5346, "verse_number": "३१", "content_sanskrit": "कपोतवृत्तयश्चान्ये कापोतीं वृत्तिमाश्रिताः ।\nपशुप्रचारनिरताः फेनपाश्च तथा परे\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2203837, "chapter_id": 5346, "verse_number": "३२", "content_sanskrit": "मृगवन्मृगचर्यायां सञ्चरन्ति तथा परे ।\nअब्भक्षा वायुभक्षाश्च निराहारास्तथैव च\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2203838, "chapter_id": 5346, "verse_number": "३३", "content_sanskrit": "सञ्चरन्ति तपो घोरं व्याधिमृत्युविवर्जिताः ।\nस्ववशादेव ते मृत्युमभिकाङ्क्षन्ति नित्यशः\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2203839, "chapter_id": 5346, "verse_number": "३४", "content_sanskrit": "इन्द्रलोके तथा तेषां निर्मिता भोगसञ्चयाः ।\nअमरैः सह ते यान्ति देववद् भोगसंयुताः\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2203840, "chapter_id": 5346, "verse_number": "३५", "content_sanskrit": "वराप्सरोभिः संयुक्ताश्चिरकालमनिन्दिते ।\nएतत्ते कथितं देवि भूयः श्रोतुं किमिच्छसि\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2203841, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2203842, "chapter_id": 5346, "verse_number": "३६", "content_sanskrit": "भगवन् श्रोतुमिच्छामि वालखिल्यांस्तपोधनान्\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2203843, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2203844, "chapter_id": 5346, "verse_number": "३७", "content_sanskrit": "धर्मचर्यां तथा देवि वालखिल्यगतां शृणु\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2203845, "chapter_id": 5346, "verse_number": "३८", "content_sanskrit": "मृगनिर्मोकवसना निर्द्वन्द्वास्ते तपोधनाः ।\nअङ्गुष्ठमात्राः सुश्रोणि स्वेष्वेवाङ्गेषु संयुताः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2203846, "chapter_id": 5346, "verse_number": "३९", "content_sanskrit": "ते मृत्युविषयातीतास्तपःसिद्धास्तपोबलाः ।\nजिताहाराः जितक्रोधाः सर्वभोगेषु निःस्पृहाः ।\nतपश्चरणमिच्छन्तो लोकार्थं परमोद्यताः\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2203847, "chapter_id": 5346, "verse_number": "४०", "content_sanskrit": "उद्यन्तं सततं सूर्यं स्तुवन्तो विविधैः स्तवैः ।\nभास्करस्येव किरणैः सहसा यान्ति नित्यदा ।\nद्योतयन्तो दिशः सर्वा धर्मज्ञाः सत्यवादिनः\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2203848, "chapter_id": 5346, "verse_number": "४१", "content_sanskrit": "तेष्वेव निर्मलं सत्यं लोकार्थं तु प्रतिष्ठितम् ।\nलोकोऽयं धार्यते देवि तेषामेव तपोबलात्\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2203849, "chapter_id": 5346, "verse_number": "४२", "content_sanskrit": "महात्मनां तु तपसा सत्येन च शुचिस्मिते ।\nक्षमया च महाभागे भूतानां संस्थितिं विदुः\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2203850, "chapter_id": 5346, "verse_number": "४३", "content_sanskrit": "प्रजार्थमपि लोकार्थं महद्भिः क्रियते तपः ।\nतपसा प्राप्यते सर्वं तपसा प्राप्यते फलम् ।\nदुष्प्रापमपि यल्लोके तपसा प्राप्यते हि तत्\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2203851, "chapter_id": 5346, "verse_number": "४४", "content_sanskrit": "पञ्चभूतस्थितिश्चैव लोकसृष्टिविवर्धनम् ।\nएतत्सर्वं समासेन तपोयोगाद् विनिर्मितम्\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2203852, "chapter_id": 5346, "verse_number": "४५", "content_sanskrit": "तस्मादन्ध ऋषिगणस्तपस्तेप इति प्रिये ।\nधर्मान्वेषी तपः कर्तुं यतते सततं प्रिये\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2203853, "chapter_id": 5346, "verse_number": "४६", "content_sanskrit": "अमरत्वं वशित्वं च तपसा प्रार्थयेत् सदा ।\nएतत्ते कथितं सर्वं शृण्वन्त्यास्ते श्रुतं प्रिये ।\nप्रियार्थमृषिसङ्घस्य प्रजानां हितकाम्यया\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2203854, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2203855, "chapter_id": 5346, "verse_number": "४७", "content_sanskrit": "एवं ब्रुवन्तं देवेशमृषयश्चापि तुष्टुवुः ।\nभूयः परमकं यत्नं तदाप्रभृति चक्रिरे॥\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2203856, "chapter_id": 5346, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे वानप्रस्थविधवादीनां धर्मफलकथनं नाम सप्तनवत्युत्तरशततमोऽध्यायः ॥ १९७ ॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]