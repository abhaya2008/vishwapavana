[{"id": 7001149000, "chapter_id": 21149, "verse_number": "२-२-४०-१", "content_sanskrit": "॥ नारद उचाच  ।\nविधे विधे महाप्राज्ञा शैवतत्त्वप्रदर्शक ।\nश्राविता रमणीप्राया शिवलीला महाद्भुता॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001149001, "chapter_id": 21149, "verse_number": "२-२-४०-२", "content_sanskrit": "वीरेण वीरभद्रेण दक्षयज्ञं विनाश्य वै ।\nकैलासाद्रौ गते तात किमभूत्तद्वदाधुना॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001149002, "chapter_id": 21149, "verse_number": "२-२-४०-३", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nअथ देवगणास्सर्वे मुनयश्च पराजिताः ।\nरुद्रानीकैर्विभिन्नांगा मम लोकं ययुस्तदा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001149003, "chapter_id": 21149, "verse_number": "२-२-४०-४", "content_sanskrit": "स्वयंभुवे नमस्कृत्य मह्यं संस्तूय भूरिशः ।\nतत्स्वक्लेशं विशेषेण कार्त्स्येनैव न्यवेदयन्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001149004, "chapter_id": 21149, "verse_number": "२-२-४०-५", "content_sanskrit": "तदाकर्ण्य ततोहं वै पुत्रशोकेन पीडितः ।\nअचिन्तयमतिव्यग्रो दूयमानेन चेतसा॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001149005, "chapter_id": 21149, "verse_number": "२-२-४०-६", "content_sanskrit": "किं कार्य्यं कार्यमद्याशु मया देवसुखावहम् ।\nयेन जीवतु दक्षासौ मखः पूर्णो भवेत्सुरः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001149006, "chapter_id": 21149, "verse_number": "२-२-४०-७", "content_sanskrit": "एवं विचार्य बहुधा नालभं शमहं मुने ।\nविष्णुं तदा स्मरन् भक्त्या ज्ञानमाप्तं तदोचितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001149007, "chapter_id": 21149, "verse_number": "२-२-४०-८", "content_sanskrit": "अथ देवैश्च मुनिभिर्विष्णोर्लोकमहं गतः ।\nनत्वा नुत्वा च विविधैस्स्तवैर्दुःखं न्यवेदयम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001149008, "chapter_id": 21149, "verse_number": "२-२-४०-९", "content_sanskrit": "यथाध्वरः प्रपूर्णः स्याद्देव यज्ञकरश्च सः ।\nसुखिनस्स्युस्सुरास्सर्वे मुनयश्च तथा कुरु॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001149009, "chapter_id": 21149, "verse_number": "२-२-४०-१०", "content_sanskrit": "देव देव रमानाथ विष्णो देवसुखावह ।\nवयं त्वच्छरणं प्राप्तास्सदेवमुनयो ध्रुवम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001149010, "chapter_id": 21149, "verse_number": "२-२-४०-११", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्याकर्ण्य वचो मे हि ब्रह्मणस्स रमेश्वरः ।\nप्रत्युवाच शिवं स्मृत्वा शिवात्मा दीनमानसः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001149011, "chapter_id": 21149, "verse_number": "२-२-४०-१२", "content_sanskrit": "॥ विष्णुरुवाच  ।\nतेजीयसि न सा भूता कृतागसि बुभूषताम् ।\nतत्र क्षेमाय बहुधा बुभूषा हि कृतागसाम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001149012, "chapter_id": 21149, "verse_number": "२-२-४०-१३", "content_sanskrit": "कृतपापास्सुरा सर्वे शिवे हि परमेश्वरे ।\nपराददुर्यज्ञभागं तस्य शंभोर्विधे यतः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001149013, "chapter_id": 21149, "verse_number": "२-२-४०-१४", "content_sanskrit": "प्रसादयध्यं सर्वे हि यूयं शुद्धेन चेतसा ।\nअथापरप्रसादं तं गृहीतांघ्रियुगं शिवम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001149014, "chapter_id": 21149, "verse_number": "२-२-४०-१५", "content_sanskrit": "यस्मिन् प्रकुपिते देवे विनश्यत्यखिलं जगत् ।\nसलोकपालयज्ञस्य शासनाज्जीवितं द्रुतम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001149015, "chapter_id": 21149, "verse_number": "२-२-४०-१६", "content_sanskrit": "तमाशु देवं प्रियया विहीनं च दुरुक्तिभिः ।\nक्षमापयध्वं हृद्विद्धं दक्षेण सुदुरात्मना॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001149016, "chapter_id": 21149, "verse_number": "२-२-४०-१७", "content_sanskrit": "अयमेव महोपायस्तच्छांत्यै केवलं विधे ।\nशंभोस्संतुष्टये मन्ये सत्यमेवोदितं मया॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001149017, "chapter_id": 21149, "verse_number": "२-२-४०-१८", "content_sanskrit": "नाहं न त्वं सुराश्चान्ये मुनयोपि तनूभृतः ।\nयस्य तत्त्वं प्रमाणं च न विदुर्बलवीर्ययोः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001149018, "chapter_id": 21149, "verse_number": "२-२-४०-१९", "content_sanskrit": "आत्मतंत्रस्य तस्यापि परस्य परमात्मनः ।\nक उपायं विधित्सेद्वै परं मूढं विरोधिनम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001149019, "chapter_id": 21149, "verse_number": "२-२-४०-२०", "content_sanskrit": "चलिष्येहमपि ब्रह्मन् सर्वैः सार्द्ध शिवालयम् ।\nक्षमापयामि गिरिशं कृतागाश्च शिवे धुवम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001149020, "chapter_id": 21149, "verse_number": "२-२-४०-२१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nइत्थमादिश्य विष्णुर्मां ब्रह्माणं सामरादिकम् ।\nसार्द्धं देवेर्मतिं चक्रे तद्गिरौ गमनाय सः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001149021, "chapter_id": 21149, "verse_number": "२-२-४०-२२", "content_sanskrit": "ययौ स्वधिष्ण्य निलयं शिवस्याद्रिवरं शुभम् ।\nकैलासं सामरमुनिप्रजेशादिमयो हरिः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001149022, "chapter_id": 21149, "verse_number": "२-२-४०-२३", "content_sanskrit": "अतिप्रियं प्रभोर्नित्यं सुजुष्टं किन्नरादिभिः ।\nनरेतरैरप्सरोभिर्योगसिद्धैमहोन्नतम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001149023, "chapter_id": 21149, "verse_number": "२-२-४०-२४", "content_sanskrit": "नानामणिमयैश्शृंगैः शोभमानं समंततः ।\nनानाधातुविचित्रं वै नानाद्रुमलताकुलम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001149024, "chapter_id": 21149, "verse_number": "२-२-४०-२५", "content_sanskrit": "नानामृगगणाकीर्णं नानापक्षिसमन्वितम् ।\nनानाजलप्रस्रवणैरमरैस्सिद्धयोषिताम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001149025, "chapter_id": 21149, "verse_number": "२-२-४०-२६", "content_sanskrit": "रमणैवाहरंतीनां नानाकंदर सानुभिः ।\nद्रुमजातिभिरन्याभी राजितं राजतप्रभम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001149026, "chapter_id": 21149, "verse_number": "२-२-४०-२७", "content_sanskrit": "व्याघ्रादिभिर्महासत्त्वैर्निर्घुष्टं क्रूरतोज्झितम् ।\nसर्वशोभान्वितं दिव्यं महाविस्मयकारकम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001149027, "chapter_id": 21149, "verse_number": "२-२-४०-२८", "content_sanskrit": "पर्यस्तं गंगया सत्या स्थानपुण्यतरोदया ।\nसर्वपावनसंकर्त्र्या विष्णुपद्या सुनिर्मलम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001149028, "chapter_id": 21149, "verse_number": "२-२-४०-२९", "content_sanskrit": "एवंविधं गिरिं दृष्ट्वा कैलासाख्यं शिवप्रियम् ।\nययुस्ते विस्मयं देवा विष्ण्वाद्यास्समुनीश्वराः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001149029, "chapter_id": 21149, "verse_number": "२-२-४०-३०", "content_sanskrit": "तस्समीपेऽलकां रम्यां ददृशुर्नाम ते पुरीम् ।\nकुबेरस्य महादिव्यां रुद्रमित्रस्य निर्जराः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001149030, "chapter_id": 21149, "verse_number": "२-२-४०-३१", "content_sanskrit": "वनं सौगंधिकं चापि ददृशुस्तत्समीपतः ।\nसर्वद्रुमान्वितं दिव्यं यत्र तन्नादमद्रुतम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001149031, "chapter_id": 21149, "verse_number": "२-२-४०-३२", "content_sanskrit": "तद्बाह्यतस्तस्य दिव्ये सरितावतिपावने ।\nनंदा चालकनंदा च दर्शनात्पापहारिके॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001149032, "chapter_id": 21149, "verse_number": "२-२-४०-३३", "content_sanskrit": "पपुः सुरस्त्रियो नित्यमवगूह्य स्वलोकतः ।\nविगाह्य पुंभिस्तास्तत्र क्रीडंति रतिकर्शिताः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001149033, "chapter_id": 21149, "verse_number": "२-२-४०-३४", "content_sanskrit": "हित्वा यक्षेश्वरपुरीं वनं सौगंधिकं च यत् ।\nगच्छंतस्ते सुरा आराद्ददृशुश्शांकरं वटम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001149034, "chapter_id": 21149, "verse_number": "२-२-४०-३५", "content_sanskrit": "पर्यक् कृताचलच्छायं पादोन विटपाय तम् ।\nशतयोजन कोत्सेधं निर्नीडं तापवर्ज्जितम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001149035, "chapter_id": 21149, "verse_number": "२-२-४०-३६", "content_sanskrit": "महापुण्यवतां दृश्यं सुरम्यं चातिपावनम् ।\nशंभुयोगस्थलं दिव्यं योगिसेव्यं महोत्तमम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001149036, "chapter_id": 21149, "verse_number": "२-२-४०-३७", "content_sanskrit": "मुमुक्षुशरणे तस्मिन् महायोगमये वटे ।\nआसीनं ददृशुस्सर्वे शिवं विष्ण्वादयस्सुराः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001149037, "chapter_id": 21149, "verse_number": "२-२-४०-३८", "content_sanskrit": "विधिपुत्रैर्महासिद्धैश्शिव भक्तिरतैस्सदा ।\nउपास्यमानं सुमुदा शांतैस्संशांतविग्रहैः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001149038, "chapter_id": 21149, "verse_number": "२-२-४०-३९", "content_sanskrit": "तथा सख्या कुबेरेण भर्त्रा गुह्यकरक्षसाम् ।\nसेव्यमानं विशेषेण स्वगणैर्ज्ञातिभिस्सदा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001149039, "chapter_id": 21149, "verse_number": "२-२-४०-४०", "content_sanskrit": "तापसाभीष्टसद्रूपं बिभ्रतं परमेश्वरम् ।\nवात्सल्याद्विश्वसुहृदं भस्मादिसुविराजितम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001149040, "chapter_id": 21149, "verse_number": "२-२-४०-४१", "content_sanskrit": "मुने तुभ्यं प्रवोचंतं पृच्छते ज्ञानमुत्तमम् ।\nकुशासने सूपविष्टं सर्वेषां शृण्वतां सताम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001149041, "chapter_id": 21149, "verse_number": "२-२-४०-४२", "content_sanskrit": "कृत्वोरौ दक्षिणे सव्यं चरणं चैव जानुनि ।\nबाहुप्रकोष्ठाक्षमालं स्थितं सत्तर्कमुद्रया॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001149042, "chapter_id": 21149, "verse_number": "२-२-४०-४३", "content_sanskrit": "एवंविधं शिवं दृष्ट्वा तदा विष्ण्वादयस्सुराः ।\nप्रणेमुस्त्वरितं सर्वे करौ बध्वा विनम्रकाः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001149043, "chapter_id": 21149, "verse_number": "२-२-४०-४४", "content_sanskrit": "उपलभ्यागतं रुद्रो मया विष्णुं सतां गतिः ।\nउत्थाय चक्रे शिरसाभिवंदनमपि प्रभुः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001149044, "chapter_id": 21149, "verse_number": "२-२-४०-४५", "content_sanskrit": "वंदितांघ्रिस्तदा सर्वैर्दिव्यैर्विष्ण्वादिभिश्शिवः ।\nननामाथ यथा विष्णुं कश्यपं लोकसद्गतिः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001149045, "chapter_id": 21149, "verse_number": "२-२-४०-४६", "content_sanskrit": "सुरसिद्धगणाधीशमहर्षिसु नमस्कृतम् ।\nसमुवाच सुरैर्विष्णुं कृतसन्नतिमादरात्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]