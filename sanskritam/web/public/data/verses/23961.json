[{"id": 7003961000, "chapter_id": 23961, "verse_number": "३-१-२४-१", "content_sanskrit": "श्रीसूत उवाच ।\nचक्रतीर्थे नरः स्नात्वा शिवतीर्थं ततो व्रजेत् ।\nयत्र हि स्नानमात्रेण महापातककोटयः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003961001, "chapter_id": 23961, "verse_number": "३-१-२४-२", "content_sanskrit": "तत्संसर्गाश्च नश्यंति तत्क्षणादेव तापसाः ।\nअत्र स्नात्वा ब्रह्महत्यां मुमुचे कालभैरवः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003961002, "chapter_id": 23961, "verse_number": "३-१-२४-३", "content_sanskrit": "ऋषय ऊचुः ।\nकालभैरवरुद्रस्य ब्रह्महत्या महामुने ।\nकिमर्थमभवत्सूत तन्नो वक्तुमिहार्हसि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003961003, "chapter_id": 23961, "verse_number": "३-१-२४-४", "content_sanskrit": "श्रीसूत उवाच ।\nवक्ष्यामि मुनयः सर्वे पुरावृत्तं विमुक्तिदम् ।\nयस्य श्रवणमात्रेण सर्वपापैः प्रमुच्यते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003961004, "chapter_id": 23961, "verse_number": "३-१-२४-५", "content_sanskrit": "प्रजापतेश्च विष्णोश्च बभूव कलहः पुरा ।\nकिंचित्कारणमुद्दिश्य समस्तजनसन्निधौ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003961005, "chapter_id": 23961, "verse_number": "३-१-२४-६", "content_sanskrit": "अहमेव जगत्कर्ता नान्यः कर्तास्ति कश्चन ।\nअहं सर्वप्रपंचानां निग्रहानुग्रहप्रदः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003961006, "chapter_id": 23961, "verse_number": "३-१-२४-७", "content_sanskrit": "मत्तो नास्त्यधिकः कश्चिन्मत्समो वा सुरेष्वपि ।\nएवं स मनुते ब्रह्मा देवानां सन्निधौ पुरा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003961007, "chapter_id": 23961, "verse_number": "३-१-२४-८", "content_sanskrit": "तदा नारायणः प्राह प्रहसन्द्विजपुंगवाः ।\nकिमर्थमेवं ब्रूषे त्वमहंकारेण सांप्रतम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003961008, "chapter_id": 23961, "verse_number": "३-१-२४-९", "content_sanskrit": "वाक्यमेवंविधं भूयो वक्तुं नार्हसि वै विधे ।\nअहमेव जगत्कर्ता यज्ञो नारायणो विभुः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003961009, "chapter_id": 23961, "verse_number": "३-१-२४-१०", "content_sanskrit": "मां विनास्य प्रपञ्चस्य जीवनं दुर्लभं भवेत् ।\nमत्प्रसादाज्जगत्सृष्टं त्वया स्थावरजंगमम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003961010, "chapter_id": 23961, "verse_number": "३-१-२४-११", "content_sanskrit": "विवादं कुर्वतोरेवं ब्रह्मविष्ण्वोर्जयैषिणोः ।\nदेवानां पुरतस्तत्र वेदाश्चत्वार आगताः ।\nप्रोचुर्वाक्यमिदं तथ्यं परमार्थप्रकाशकम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003961011, "chapter_id": 23961, "verse_number": "३-१-२४-१२", "content_sanskrit": "वेदा ऊचुः ।\nत्वं विष्णो न जगत्कर्ता न त्वं ब्रह्मन्प्रजापते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003961012, "chapter_id": 23961, "verse_number": "३-१-२४-१३", "content_sanskrit": "किं त्वीश्वरो जगत्कर्ता परात्परतरो विभुः ।\nतन्मायाशक्तिसंक्लृप्तमिदं स्थावरजंगमम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003961013, "chapter_id": 23961, "verse_number": "३-१-२४-१४", "content_sanskrit": "सर्वदेवाभिवंद्यो हि सांबः सत्यादिलक्षणः ।\nस्रष्टा च पालको हर्ता स एव जगतां प्रभुः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003961014, "chapter_id": 23961, "verse_number": "३-१-२४-१५", "content_sanskrit": "एवं समीरितं वेदैः श्रुत्वा वाक्यं शुभाक्षरम् ।\nब्रह्मा विष्णुस्तदा तत्र प्रोचतुर्द्विजपुंगवाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003961015, "chapter_id": 23961, "verse_number": "३-१-२४-१६", "content_sanskrit": "ब्रह्मविष्णू ऊचतुः ।\nपार्वत्यालिंगितः शंभुर्मूर्तिमान्प्रमथाधिपः ।\nकथं भवेत्परं ब्रह्म सर्वसंगविवर्जितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003961016, "chapter_id": 23961, "verse_number": "३-१-२४-१७", "content_sanskrit": "ताभ्यामितीरिते तत्र प्रणवः प्राह तौ तदा ।\nअरूपो रूपमादाय महता ध्वनिना द्विजाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003961017, "chapter_id": 23961, "verse_number": "३-१-२४-१८", "content_sanskrit": "प्रणव उवाच ।\nअसौ शंभुर्महादेवः पार्वत्या स्वातिरिक्तया ।\nसंक्रीडते कदाचिन्नो किं तु स्वात्मस्वरूपया॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003961018, "chapter_id": 23961, "verse_number": "३-१-२४-१९", "content_sanskrit": "असौ शंभुरनीशानः स्वप्रकाशो निरंजनः ।\nविश्वाधिको महादेवो विश्वाधिक इति श्रुतः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003961019, "chapter_id": 23961, "verse_number": "३-१-२४-२०", "content_sanskrit": "सर्वात्मा सर्वकर्तासौ स्वतन्त्रः सर्वभावनः ।\nब्रह्मन्नयं सृष्टिकाले त्वां नियुंक्ते रजोगुणैः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003961020, "chapter_id": 23961, "verse_number": "३-१-२४-२१", "content_sanskrit": "सत्त्वेन रक्षणे शंभुस्त्वां प्रेषयति केशव ।\nतमसा कालरुद्राख्यं संप्रेरयति संहृतौ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003961021, "chapter_id": 23961, "verse_number": "३-१-२४-२२", "content_sanskrit": "अतः स्वतन्त्रता विष्णो युवयोर्न कदाचन ।\nनापि प्रजापतेरस्ति किं तु शंभोः स्वतन्त्रता॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003961022, "chapter_id": 23961, "verse_number": "३-१-२४-२३", "content_sanskrit": "ब्रह्मन्विष्णो युवाभ्यां तु किमर्थं न महेश्वरः ।\nज्ञायते सर्वलोकानां कर्ता विश्वाधिकस्तथा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003961023, "chapter_id": 23961, "verse_number": "३-१-२४-२४", "content_sanskrit": "सापि शक्तिरुमा देवी न पृथक्छंकरात्सदा ।\nशंभोरानंदभूता सा देवी नागंतुकी स्मृता॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003961024, "chapter_id": 23961, "verse_number": "३-१-२४-२५", "content_sanskrit": "अतो विश्वाधिको रुद्रः स्वतंत्रो निर्विकल्पकः ।\nसर्वदेवैरयं वन्द्यो युवाभ्यामपि शंकरः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003961025, "chapter_id": 23961, "verse_number": "३-१-२४-२६", "content_sanskrit": "कर्ता नास्यास्ति रुद्रस्य नाधिकोऽस्माच्च विद्यते ।\nन तत्समोऽपि लोकेषु विद्यते शतशस्तथा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003961026, "chapter_id": 23961, "verse_number": "३-१-२४-२७", "content_sanskrit": "अतो मोहं न कुरुतं ब्रह्मविष्णो युवां वृथा ।\nइत्युक्तं प्रणवेनाथ श्रुत्वा ब्रह्मा च केशवः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003961027, "chapter_id": 23961, "verse_number": "३-१-२४-२८", "content_sanskrit": "मायया मोहितौ शंभोर्नैवाज्ञानममुंचताम् ।\nएतस्मिन्नंतरे ब्रह्मा प्रददर्श महाद्भुतम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003961028, "chapter_id": 23961, "verse_number": "३-१-२४-२९", "content_sanskrit": "व्याप्नुवद्गगनं सर्वमनंतादित्य सन्निभम् ।\nतेजोमण्डलमाकाशमध्यगं विश्वतोमुखम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003961029, "chapter_id": 23961, "verse_number": "३-१-२४-३०", "content_sanskrit": "तन्निरूपयितुं ब्रह्मा ससर्जोर्ध्वगतं मुखम् ।\nतपोबलविसृष्टेन पंचमेन मुखेन सः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003961030, "chapter_id": 23961, "verse_number": "३-१-२४-३१", "content_sanskrit": "निरूपयामास विभुस्तत्तेजोमण्डलं मुहुः ।\nतत्प्रजज्वाल कोपेन मुखं तेजोविलोकनात्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003961031, "chapter_id": 23961, "verse_number": "३-१-२४-३२", "content_sanskrit": "अनंतादित्यसंकाशं ज्वलत्तत्पंचमं शिरः ।\nदिधक्षुः प्रलये लोकान्वडवाग्निरिवाबभौ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003961032, "chapter_id": 23961, "verse_number": "३-१-२४-३३", "content_sanskrit": "व्यदृश्यत च तत्तेजः पुरुषो नीललोहितः ।\nदृष्ट्वा स्रष्टा तदा ब्रह्मा बभाषे परमेश्वरम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003961033, "chapter_id": 23961, "verse_number": "३-१-२४-३४", "content_sanskrit": "वेदाहं त्वां महादेव ललाटान्मे पुरा भवान् ।\nविनिर्गतोऽसि शंभो त्वं रुद्रनामा ममात्मजः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003961034, "chapter_id": 23961, "verse_number": "३-१-२४-३५", "content_sanskrit": "इति गर्वेण संयुक्तं वचः श्रुत्वा महेश्वरः ।\nकालभैरवनामानं पुरुषं प्राहिणोत्तदा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003961035, "chapter_id": 23961, "verse_number": "३-१-२४-३६", "content_sanskrit": "अयुद्ध्यत चिरं कालं ब्रह्मणा कालभैरवः ।\nमहादेवांशसंभूतः शूलटंकगदाधरः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003961036, "chapter_id": 23961, "verse_number": "३-१-२४-३७", "content_sanskrit": "युद्ध्वा तु सुचिरं कालं ब्रह्मणा कालभैरवः ।\nवदनं ब्रह्मणः शुभ्रं व्यलोकयत पंचमम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003961037, "chapter_id": 23961, "verse_number": "३-१-२४-३८", "content_sanskrit": "विलोक्योर्ध्वगतं वक्त्रं पञ्चमं भारतीपतेः ।\nगर्वेण महता युक्तं प्रजज्वालातिकोपितः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003961038, "chapter_id": 23961, "verse_number": "३-१-२४-३९", "content_sanskrit": "ततस्तत्पंचमं वक्त्रं भैरवः प्राच्छिनद्रुषा ।\nततो ममार ब्रह्माऽसौ कालभैरवहिंसितः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003961039, "chapter_id": 23961, "verse_number": "३-१-२४-४०", "content_sanskrit": "ईश्वरस्य प्रसादेन प्रपेदे जीवितं पुनः ।\nततो विलोकयामास शंकरं शशिभूषणम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003961040, "chapter_id": 23961, "verse_number": "३-१-२४-४१", "content_sanskrit": "वासुक्याद्यष्टभोगींद्रविभूषणविभूषितम् ।\nदृष्ट्वा वेधा महादेवं पार्वत्या सह शंकरम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003961041, "chapter_id": 23961, "verse_number": "३-१-२४-४२", "content_sanskrit": "लेभे माहेश्वरं ज्ञानं महादेवप्रसादतः ।\nततस्तुष्टाव गिरिशं वरेण्यं वरदं शिवम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003961042, "chapter_id": 23961, "verse_number": "३-१-२४-४३", "content_sanskrit": "ब्रह्मोवाच ।\nमह्यं प्रसीद गिरिश शशांककृतशेखर ।\nयन्मयापकृतं शंभो तत्क्षमस्व दयानिधे॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003961043, "chapter_id": 23961, "verse_number": "३-१-२४-४४", "content_sanskrit": "क्षमस्व मम गर्वं त्वं शंकरेति पुनःपुनः ।\nनमश्चकार सोमं तं सोमार्धकृतशेखरम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003961044, "chapter_id": 23961, "verse_number": "३-१-२४-४५", "content_sanskrit": "अथ देवः प्रसन्नोऽस्मै ब्रह्मणे स्वांशजाय तु ।\nमा भैरित्यब्रवीच्छंभुर्भैरवं चाभ्यभाषत॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003961045, "chapter_id": 23961, "verse_number": "३-१-२४-४६", "content_sanskrit": "ईश्वर उवाच ।\nएष सर्वस्य जगतः पूज्यो ब्रह्मा सनातनः ।\nहतस्यास्य विरिंचस्य धारय त्वं शिरोऽधुना॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003961046, "chapter_id": 23961, "verse_number": "३-१-२४-४७", "content_sanskrit": "ब्रह्महत्याविशुद्ध्यर्थं लोकसंग्रहकाम्यया ।\nभिक्षामट कपालेन भैरव त्वं ममाज्ञया॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003961047, "chapter_id": 23961, "verse_number": "३-१-२४-४८", "content_sanskrit": "उक्त्वैवं शंकरो विप्रास्तत्रैवांतरधीयत ।\nनीलकण्ठो महादेवो गिरिजार्द्धतनुस्ततः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003961048, "chapter_id": 23961, "verse_number": "३-१-२४-४९", "content_sanskrit": "भैरवं ग्राहयामास वदनं वेधसो द्विजाः ।\nचरस्व पापशुद्ध्यर्थं लोकसंग्रहणाय वै॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003961049, "chapter_id": 23961, "verse_number": "३-१-२४-५०", "content_sanskrit": "कपालधारी हस्तेन भिक्षां गृह्णातु भैरवः ।\nइतीरयित्वा गिरिशः कन्यां कांचिद्भयंकरीम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003961050, "chapter_id": 23961, "verse_number": "३-१-२४-५१", "content_sanskrit": "ब्रह्महत्याभिधां क्रूरां वडवानलसन्निभाम् ।\nतां प्रेरयित्वा गिरिशो भैरवं पुनरब्रवीत्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003961051, "chapter_id": 23961, "verse_number": "३-१-२४-५२", "content_sanskrit": "ईश्वर उवाच ।\nभैरवैतद्व्रतं त्वब्दं ब्रह्महत्याविशुद्धये ।\nचर त्वं सर्वतीर्थेषु स्नाहि शुद्ध्यर्थमात्मनः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003961052, "chapter_id": 23961, "verse_number": "३-१-२४-५३", "content_sanskrit": "ततो वाराणसीं गच्छ ब्रह्महत्याप्रशांतये ।\nवाराणसीप्रवेशेन ब्रह्महत्या तवाधमा॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003961053, "chapter_id": 23961, "verse_number": "३-१-२४-५४", "content_sanskrit": "पादशेषा विनष्टा स्याच्चतुर्थांशो न नश्यति ।\nतस्य नाशं प्रवक्ष्यामि तव भैरव तच्छुणु॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003961054, "chapter_id": 23961, "verse_number": "३-१-२४-५५", "content_sanskrit": "दक्षिणांभोनिधेस्तीरे गन्धमादनपर्वते ।\nसर्वप्राण्युपकाराय कृतं तीर्थं मया शुभम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003961055, "chapter_id": 23961, "verse_number": "३-१-२४-५६", "content_sanskrit": "शिवसंज्ञं महापुण्यं तत्र याहि त्वमादरात् ।\nतत्प्रवेशनमात्रेण ब्रह्महत्या तवाशुभा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003961056, "chapter_id": 23961, "verse_number": "३-१-२४-५७", "content_sanskrit": "शिवतीर्थस्य माहात्म्यान्निःशेषं नश्यति ध्रुवम् ।\nउक्त्वैवं भैरवं रुद्रः कैलासं प्रययौ क्षणात्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003961057, "chapter_id": 23961, "verse_number": "३-१-२४-५८", "content_sanskrit": "ततः कपालपाणिस्तु भैरवः शिवचोदितः ।\nदेवदानवयक्षादिलोकेषु विचचार सः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003961058, "chapter_id": 23961, "verse_number": "३-१-२४-५९", "content_sanskrit": "तं यांतमनुयाति स्म ब्रह्महत्यातिभीषणा ।\nभैरवः सर्वतीर्थानि पुण्यान्यायतनानि च॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003961059, "chapter_id": 23961, "verse_number": "३-१-२४-६०", "content_sanskrit": "चरित्वा लीलया देवस्ततो वाराणसीं ययौ ।\nवाराणसीं प्रविष्टे तु भैरवे शंकरांशजे॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003961060, "chapter_id": 23961, "verse_number": "३-१-२४-६१", "content_sanskrit": "चतुर्थांशं विना नष्टा ब्रह्महत्यातिकुत्सिता ।\nचतुर्थांशेन दुद्राव भैरवं शंकरांशजम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003961061, "chapter_id": 23961, "verse_number": "३-१-२४-६२", "content_sanskrit": "ततः स भैरवो देवः शूलपाणिः कपालधृक् ।\nशिवाज्ञया ययौ पश्चाद्गंधमादनपर्वतम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003961062, "chapter_id": 23961, "verse_number": "३-१-२४-६३", "content_sanskrit": "शिवतीर्थं ततो गत्वा भैरवः स्नातवान्द्विजाः ।\nस्नानमात्रेण तत्रास्य शिवतीर्थे महत्तरे॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003961063, "chapter_id": 23961, "verse_number": "३-१-२४-६४", "content_sanskrit": "निःशेषं विलयं याता ब्रह्महत्यातिभीषणा ।\nअस्मिन्नवसरे शंभुः प्रादुरासीत्तदग्रतः ।\nप्रादुर्भूतो महादेवो भैरवं वाक्यमब्रवीत्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003961064, "chapter_id": 23961, "verse_number": "३-१-२४-६५", "content_sanskrit": "ईश्वर उवाच ।\nनिःशेषं ब्रह्महत्या ते शिवतीर्थे निमज्जनात्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003961065, "chapter_id": 23961, "verse_number": "३-१-२४-६६", "content_sanskrit": "नष्टा भैरव नास्त्यत्र संदेहस्तव सुव्रत ।\nइदं कपालं काश्यां त्वं स्थापयस्व क्वचित्स्थले॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003961066, "chapter_id": 23961, "verse_number": "३-१-२४-६७", "content_sanskrit": "इत्युक्त्वा भगवाञ्छंभुस्तत्रैवांतरधीयत ।\nभैरवोऽपि तदा विप्रा ब्रह्महत्याविमोचितः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003961067, "chapter_id": 23961, "verse_number": "३-१-२४-६८", "content_sanskrit": "शिवतीर्थस्य माहात्म्याद्ययौ वाराणसीं पुरीम् ।\nकपालं स्थापयामास प्रदेशे कुत्रचिद्द्विजाः ।\nकपालतीर्थमित्याख्यामलभत्तत्स्थलं तदा॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003961068, "chapter_id": 23961, "verse_number": "३-१-२४-६९", "content_sanskrit": "श्रीसूत उवाच ।\nएवं प्रभावं तत्पुण्यं शिवतीर्थं विमुक्तिदम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003961069, "chapter_id": 23961, "verse_number": "३-१-२४-७०", "content_sanskrit": "महादुःखप्रशमनं महापातकनाशनम् ।\nनरकक्लेशशमनं स्वर्गदं मोक्षदं तथा॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003961070, "chapter_id": 23961, "verse_number": "३-१-२४-७१", "content_sanskrit": "शिवतीर्थस्य माहात्म्यं मया प्रोक्तं विमुक्तिदम् ।\nइदं पठन्सदा मर्त्यो दुःखग्रामाद्विमुच्यते॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]