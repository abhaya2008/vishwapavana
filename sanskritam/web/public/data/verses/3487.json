[{"id": 2115561, "chapter_id": 3487, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115562, "chapter_id": 3487, "verse_number": "१", "content_sanskrit": "एवमुक्त्वा तु सङ्क्रुद्धः पार्थो बकजिघांसया ।\nउपाधावद् बकश्चापि पार्थं पार्थिवसत्तम \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115563, "chapter_id": 3487, "verse_number": "२", "content_sanskrit": "महाकायो महावेगो दारयन्निव मेदिनीम् ।\nविरूपरूपः पिङ्गाक्षो भीमसेनमभिद्रवत् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115564, "chapter_id": 3487, "verse_number": "३", "content_sanskrit": "त्रिशिखां भ्रुकुटीं कृत्वा दष्ट्वा च दशनच्छदम् ।\nततः स भूयः सङ्क्रुद्धो वृक्षमादाय राक्षसः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115565, "chapter_id": 3487, "verse_number": "४", "content_sanskrit": "ताडयिष्यंस्तदा भीमं तरसाऽभ्यद्रवद् बली ।\nक्षिप्तं क्रुद्धेन तं वृक्षं प्रतिजग्राह वीर्यवान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115566, "chapter_id": 3487, "verse_number": "५", "content_sanskrit": "सव्येन पाणिना भीमः प्रहसन्निव भारत ।\nततः स पुनरुद्यम्य वृक्षान् बहुविधान् बली \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115567, "chapter_id": 3487, "verse_number": "६", "content_sanskrit": "प्राहिणोद् भीमसेनाय तस्मै तांश्चैव पाण्डव ।\nतद्वृक्षयुद्धमभवन्महीरुहविनाशनम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115568, "chapter_id": 3487, "verse_number": "७", "content_sanskrit": "सुघोरं वै महाराज बकपाण्डवयोस्तदा ।\nनाम विश्राव्य तु बकः समभिद्रुत्य पाण्डवम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115569, "chapter_id": 3487, "verse_number": "८", "content_sanskrit": "भुजाभ्यां परिजग्राह भीमसेनं महाबलम् ।\nभीमसेनोऽपि तद्रक्षः परिगृह्य महाभुजः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115570, "chapter_id": 3487, "verse_number": "९", "content_sanskrit": "विस्फुरन्तं महावेगं विचकर्ष बलाद् बली ।\nस कृष्यमाणो भीमेन कर्षमाणश्च पाण्डवम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115571, "chapter_id": 3487, "verse_number": "१०", "content_sanskrit": "समयुध्यत तीव्रेण क्लमेन पुरुषादकः ।\nतयोर्वेगेन महता पृथिवी समकम्पत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115572, "chapter_id": 3487, "verse_number": "११", "content_sanskrit": "पादापांश्च महाकायांश्चूर्णयामासतुस्तदा ।\nजग्राह भीमः पाणिभ्यां गृहीत्वा चैनमाक्षिपत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115573, "chapter_id": 3487, "verse_number": "१२", "content_sanskrit": "आक्षिप्तो भीमसेनेन पुनरेवोत्थितो हसन् ।\nआलिङ्ग्याविद्ध्य चैवैनं न्यहनद् वसुधातळे \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115574, "chapter_id": 3487, "verse_number": "१३", "content_sanskrit": "भीमो व्यसर्जयच्चैनं समाश्वासिहि चेत्यपि ।\nआस्फोटयामास बली उत्तिष्ठस्वेति चाब्रवीत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115575, "chapter_id": 3487, "verse_number": "१४", "content_sanskrit": "समुत्पत्य ततः क्रुद्धो रूपं कृत्वा महत्तरम् ।\nविरूपः सहसा तस्थौ तर्जयित्वा वृकोदरम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115576, "chapter_id": 3487, "verse_number": "१५", "content_sanskrit": "अहसद् भीमसेनोऽथ राक्षसं भीमदर्शनम् ।\nभीमसेनस्तु जग्राह ग्रीवायां भीमदर्शनम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115577, "chapter_id": 3487, "verse_number": "१६", "content_sanskrit": "भुजाभ्यां जानुनैकेन पृष्ठे समभिपीडयत् ।\nततः क्रुद्धो विसृज्यैनं स भीमस्तस्य रक्षसः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115578, "chapter_id": 3487, "verse_number": "१७", "content_sanskrit": "स्वां कटीमीषदुत्क्षिप्य बाहू चैव परामृशत् ।\nतस्य बाहू समादाय त्वरमाणो वृकोदरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115579, "chapter_id": 3487, "verse_number": "१८", "content_sanskrit": "उत्क्षिप्य चावधूयैनं पातयन् बलवान् भुवि ।\nतं तु वामेन पादेन क्रुद्धो भीमपराक्रमः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115580, "chapter_id": 3487, "verse_number": "१९", "content_sanskrit": "उरस्येनं समाजघ्ने भीमस्तु पतितं भुवि ।\nस सङ्क्रुद्धः समुत्पत्य भीममप्यहनद् भृशम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115581, "chapter_id": 3487, "verse_number": "२०", "content_sanskrit": "व्यात्ताननो दीप्तजिह्वो बाहुमुद्यम्य दक्षिणम् ।\nतेनाभिद्रुत्य क्रुद्धेन भीमो मूर्ध्नि समाहतः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115582, "chapter_id": 3487, "verse_number": "२१", "content_sanskrit": "मुष्टिना जानुना चैव वामे पार्श्वे समर्पितः ।\nएवं निहन्यमानः स राक्षसेन बलीयसा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115583, "chapter_id": 3487, "verse_number": "२२", "content_sanskrit": "रोषेण महताऽऽविष्टो भीमो भीमपराक्रमः ।\nस सङ्क्रुद्धः समुत्पत्य भीमो जग्राह राक्षसम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115584, "chapter_id": 3487, "verse_number": "२३", "content_sanskrit": "तावन्योन्यं पीडयन्तौ पुरुषादवृकोदरौ ।\nमत्ताविव महानागावन्योन्यं विचकर्षतुः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115585, "chapter_id": 3487, "verse_number": "२४", "content_sanskrit": "बाहुविक्षेपशब्दैश्च भीमराक्षसयोस्तदा ।\nवेत्रकीयपुरी सर्वा वित्रस्ता समपद्यत \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115586, "chapter_id": 3487, "verse_number": "२५", "content_sanskrit": "तयोर्वेगेन महता तत्र भूमिरकम्पत ।\nपादपान् वीरुधश्चैव चूर्णयामासतुश्च तौ \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115587, "chapter_id": 3487, "verse_number": "२६", "content_sanskrit": "समागतौ च तौ वीरावन्योन्यवधकाङ्क्षिणौ ।\nअश्मभिः पादवेगैश्च चूर्णयामासतुस्तदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115588, "chapter_id": 3487, "verse_number": "२७", "content_sanskrit": "अथ तं लोळयित्वा तु भीमसेनो महाबलः ।\nअगृह्णात् परिरभ्यैनं भुजाभ्यां भरतर्षभ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115589, "chapter_id": 3487, "verse_number": "२८", "content_sanskrit": "जानुभ्यां परिजग्राह भीमसेनो बकं बलात् ।\nविस्फुरन्तं महाकायं विचकर्ष महाबलः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115590, "chapter_id": 3487, "verse_number": "२९", "content_sanskrit": "विकृष्यमाणो भीमेन चकर्ष युधि पाण्डवम् ।\nसमयुज्यत तीव्रेण श्रमेण पुरुषादकः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115591, "chapter_id": 3487, "verse_number": "३०", "content_sanskrit": "क्षीयमाणं तु तं भीमो निरीक्ष्य पुरुषादकम् ।\nनिष्पीड्य भूमौ पद्भ्यां वै समाजघ्ने वृकोदरः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115592, "chapter_id": 3487, "verse_number": "३१", "content_sanskrit": "ततोऽस्य जानुना पृष्ठमवपीड्य बलादिव ।\nबाहुना परिजग्राह दक्षिणेन शिरोधराम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115593, "chapter_id": 3487, "verse_number": "३२", "content_sanskrit": "सव्येन च कटीदेशे वासस्यादाय पाण्डवः ।\nबभञ्ज तत् तदा रक्षो व्यनदद् भैरवं रवम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115594, "chapter_id": 3487, "verse_number": "३३", "content_sanskrit": "ततोऽस्य रुधिरं वक्त्रात् प्रसुस्राव विशाम्पते ।\nभज्यमानस्य भीमेन तस्य घोरस्य रक्षसः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2115595, "chapter_id": 3487, "verse_number": "३४", "content_sanskrit": "ततो भीमस्तमादाय गतासुं पुरुषादकम् ।\nनगरद्वारमासाद्य ह्युत्ससर्ज महाबलः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2115596, "chapter_id": 3487, "verse_number": "१६६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषट्षष्ठ्यधिकशततमोऽध्यायः ॥१६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2115597, "chapter_id": 3487, "verse_number": "७", "content_sanskrit": "॥ इति बकवधपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2115598, "chapter_id": 3487, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]