[{"id": 2017160, "chapter_id": 1357, "verse_number": "२-९८-१", "content_sanskrit": "वैशम्पायन उवाच॥\nततो व्यध्वगतं पार्थं प्रातिकामी युधिष्ठिरम्।\nउवाच वचनाद्राज्ञो धृतराष्ट्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017161, "chapter_id": 1357, "verse_number": "२-९८-२", "content_sanskrit": "उपास्तीर्णा सभा राजन्नक्षानुप्त्वा युधिष्ठिर।\nएहि पाण्डव दीव्येति पिता त्वाह नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017162, "chapter_id": 1357, "verse_number": "२-९८-३x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017163, "chapter_id": 1357, "verse_number": "२-९८-३", "content_sanskrit": "धातुर्नियोगाद्भूतानि प्राप्नुवन्ति शुभाशुभम्।\nन निवृत्तिस्तयोरस्ति देवतव्यं पुनर्यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017164, "chapter_id": 1357, "verse_number": "२-९८-४", "content_sanskrit": "अक्षद्यूते समाह्वानं नियोगात्स्थविरस्य च।\nजानन्नपि क्षयकरं नातिक्रमितुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017165, "chapter_id": 1357, "verse_number": "२-९८-५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017166, "chapter_id": 1357, "verse_number": "२-९८-५", "content_sanskrit": "असम्भवो हेममयस्य जन्तो-\nस्तथापि रामो लुलुभे मृगाय।\nप्रायः समासन्नपराभवाणां\nधियो विपर्यस्ततरा भवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017167, "chapter_id": 1357, "verse_number": "२-९८-६", "content_sanskrit": "इति ब्रुवन्निववृते भ्रातृभिः सह पाण्डवः।\nजानांश्च शकुनेर्मायां पार्थो द्यूतमियात्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017168, "chapter_id": 1357, "verse_number": "२-९८-७", "content_sanskrit": "विविशुस्ते सभां तां तु पुनरेव महारथाः।\nव्यथयन्ति स्म चेतांसि मुहृदां भरतर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017169, "chapter_id": 1357, "verse_number": "२-९८-८", "content_sanskrit": "यथोपजोषमासीनाः पुनर्द्यूतप्रवृत्तये।\nसर्वलोकविनाशाय दैवेनोपनिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017170, "chapter_id": 1357, "verse_number": "२-९८-९x", "content_sanskrit": "शकुनिरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017171, "chapter_id": 1357, "verse_number": "२-९८-९", "content_sanskrit": "अमुञ्चत्स्थविरो यद्वो धनं पूजितमेव तत्।\nमहाधनं ग्लहं त्वेकं शृणु भो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017172, "chapter_id": 1357, "verse_number": "२-९८-१०", "content_sanskrit": "वयं वा द्वादशाब्दानि युष्माभिर्द्यूतनिर्जिताः।\nप्रविशेम महारण्यं रौरवाजिनवाससः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017173, "chapter_id": 1357, "verse_number": "२-९८-११", "content_sanskrit": "त्रयोदशं च स्वजनैरज्ञाताः परिवत्सरम्।\nज्ञाताश्च पुनरन्यानि वने वर्षाणि द्वादश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017174, "chapter_id": 1357, "verse_number": "२-९८-१२", "content_sanskrit": "अस्माभिर्निर्जिता यूयं वने द्वादश वत्सरान्।\nवसध्वं कृष्णया सार्धमजिनैः प्रतिवासिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017175, "chapter_id": 1357, "verse_number": "२-९८-१३", "content_sanskrit": "त्रयोदशं च स्वजनैरज्ञाताः पिरवत्सरम्।\nज्ञाताश्च पुनरन्यानि वने वर्षाणि द्वादश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017176, "chapter_id": 1357, "verse_number": "२-९८-१४", "content_sanskrit": "त्रयोदशे च निर्वृत्ते पुनरेव यथोचितम्।\nस्वराज्यं प्रतिपत्तव्यमितरैरथवेतरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017177, "chapter_id": 1357, "verse_number": "२-९८-१५", "content_sanskrit": "अनेन व्यवसायेन सहास्माभिर्युधिष्ठिर।\nअक्षानुप्त्वा पुनर्द्यूतमेहि दीव्यस्व भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017178, "chapter_id": 1357, "verse_number": "२-९८-१६", "content_sanskrit": "अथ सभ्याः सभामध्ये समुच्छ्रितकरास्तदा।\nऊचुरुद्विग्नमनसः संवेगात्सर्व एव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017179, "chapter_id": 1357, "verse_number": "२-९८-१७x", "content_sanskrit": "सभ्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017180, "chapter_id": 1357, "verse_number": "२-९८-१७", "content_sanskrit": "अहो धिग्बान्धवा नैनं बोधयन्ति महद्भयम्।\nबुद्ध्या बुद्ध्येन्न वा बुद्ध्येदयं वै भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017181, "chapter_id": 1357, "verse_number": "२-९८-१८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017182, "chapter_id": 1357, "verse_number": "२-९८-१८", "content_sanskrit": "जनप्रवादान्सुबहूञ्शृण्वन्नपि नराधिपः।\nह्रिया च धर्मसंयोगात्पार्थो द्यूतमियात्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017183, "chapter_id": 1357, "verse_number": "२-९८-१९", "content_sanskrit": "जानन्नापि महाबुद्धिः पुनर्द्यूतमवर्तयत्।\nअप्यासन्नो विनाशः स्यात्कुरूणामितिचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017184, "chapter_id": 1357, "verse_number": "२-९८-२०x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017185, "chapter_id": 1357, "verse_number": "२-९८-२०", "content_sanskrit": "कथं वै मद्विधो राजा स्वधर्ममनुपालयन्।\nआहूतो विनिवर्तेत दीव्यामि शकुने त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017186, "chapter_id": 1357, "verse_number": "२-९८-२१x", "content_sanskrit": "शकुनिरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017187, "chapter_id": 1357, "verse_number": "२-९८-२१", "content_sanskrit": "गवाश्वं बहुधेनुकमपर्यन्तमजाविकम्।\nगजाः कोशो हिरण्यं च दासीदासाश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017188, "chapter_id": 1357, "verse_number": "२-९८-२२", "content_sanskrit": "हित्वा नो ग्लह एवैको वनवासाय पाण्डवाः।\nयूयं वयं वा विजिता वसेम वनमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017189, "chapter_id": 1357, "verse_number": "२-९८-२३", "content_sanskrit": "त्रयोदशं च वै वर्णमज्ञाताः स्वजनैस्तथा।\nअनेन व्यवसायेन दीव्याम पुरुषर्षभाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017190, "chapter_id": 1357, "verse_number": "२-९८-२४", "content_sanskrit": "समुत्क्षेपेण चैकेन वनवासाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017191, "chapter_id": 1357, "verse_number": "२-९८-२४x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017192, "chapter_id": 1357, "verse_number": "२-९८-२४", "content_sanskrit": "एवं दैवबलाविष्टो धर्मराजो युधिष्ठिरः।\nभीष्मद्रोणाऽऽवार्यमाणो विदुरेण च धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017193, "chapter_id": 1357, "verse_number": "२-९८-२५", "content_sanskrit": "युयुत्सुना कृपेणाथ सञ्जयेन च भारत।\nगान्धार्या पृथया चैव भीमार्जुनयमैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017194, "chapter_id": 1357, "verse_number": "२-९८-२६", "content_sanskrit": "विकर्णेन च वीरेण द्रौपद्या द्रौणिना तथा।\nसोमदत्तेन च तथा बाह्लीकेन च धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017195, "chapter_id": 1357, "verse_number": "२-९८-२७", "content_sanskrit": "वार्यमाणोपि सततं न च राजन्नियच्छति।\nएवं संवार्यमाणोपि कौन्तेयो हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017196, "chapter_id": 1357, "verse_number": "२-९८-२८", "content_sanskrit": "देवकार्यार्थसिद्ध्यर्थं मुहूर्तं कलिमाविशत्।\nअविष्टः कलिना राजञ्छकुनिं प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017197, "chapter_id": 1357, "verse_number": "२-९८-२९", "content_sanskrit": "एवं भवत्विति तदा वनवासाय दीव्यति।\nप्रतिजग्राह तं पार्थो ग्लहं जग्राह सौबलः॥\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017198, "chapter_id": 1357, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अनुद्यूतपर्वणि अष्टनवतितमोऽध्यायः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]