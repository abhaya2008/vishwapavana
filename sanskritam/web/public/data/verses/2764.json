[{"id": 2082741, "chapter_id": 2764, "verse_number": "१२-२६९-०x", "content_sanskrit": "जाजलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082742, "chapter_id": 2764, "verse_number": "१२-२६९-१", "content_sanskrit": "यथा प्रवर्तितो धर्मस्तुलां धारयता त्वया।\nस्वर्गद्वारं च वत्तिं च भूतानामवरोत्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082743, "chapter_id": 2764, "verse_number": "१२-२६९-२", "content_sanskrit": "कृष्या ह्यन्नं प्रभवति ततस्त्वमपि जिवसि।\nपशुभिश्चौषधीभिश्च मर्त्या जीवन्ति वाणिज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082744, "chapter_id": 2764, "verse_number": "१२-२६९-३", "content_sanskrit": "ततो यज्ञः प्रभवति नास्तिक्यमपि जल्पसि।\nन हि वर्तेदयं लोको वार्तामुत्सृज्य केवलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082745, "chapter_id": 2764, "verse_number": "१२-२६९-४x", "content_sanskrit": "तुलाधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082746, "chapter_id": 2764, "verse_number": "१२-२६९-४", "content_sanskrit": "वक्ष्यामि जाजले वृत्तिं नास्मि ब्राह्मण नास्तिकः।\nन यज्ञं च विनिन्दामि यज्ञवित्तु सुदुर्लभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082747, "chapter_id": 2764, "verse_number": "१२-२६९-५", "content_sanskrit": "नमो ब्राह्मण यज्ञाय ये च यज्ञविदो जनाः।\nस्वयज्ञं ब्राह्मणा हित्वा क्षत्रयज्ञमनुष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082748, "chapter_id": 2764, "verse_number": "१२-२६९-६", "content_sanskrit": "लुब्धैर्वित्तपरैर्ब्रह्मन्नास्तिकैः संप्रवर्तितम्।\nवेदवादानभिज्ञानां सत्याभासमिवानृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082749, "chapter_id": 2764, "verse_number": "१२-२६९-७", "content_sanskrit": "इदं देयमिदं देयमिति नान्यच्चिकीर्षति।\nअतः स्तैन्यं प्रभवति विकर्माणि च जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082750, "chapter_id": 2764, "verse_number": "१२-२६९-८", "content_sanskrit": "यदेव सुकृतं हव्यं तेन तुष्यन्ति देवताः।\nनमस्कारेण हविषा स्वाध्यायैरौषधैस्तथा।\nपूजा स्याद्देवतानां हि यथाशास्त्रनिदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082751, "chapter_id": 2764, "verse_number": "१२-२६९-९", "content_sanskrit": "इष्टापूर्तादसाधूनां विदुषां जायते प्रजा।\nलुब्धेभ्यो जायते लुब्धः समेभ्यो जायते समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082752, "chapter_id": 2764, "verse_number": "१२-२६९-१०", "content_sanskrit": "यजमाना यथाऽऽत्मानमृत्विजश्च तथा प्रजाः।\nयज्ञात्प्रजा प्रभवति नभसोऽम्भ इवामलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082753, "chapter_id": 2764, "verse_number": "१२-२६९-११", "content_sanskrit": "अग्नौ प्रास्ताहुतिर्ब्रह्मन्नादित्यमुपगच्छति।\nआदित्याज्जायते वृष्टिर्वृष्टेरन्नं ततः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082754, "chapter_id": 2764, "verse_number": "१२-२६९-१२", "content_sanskrit": "तस्मात्सुनिष्ठिताः पूर्वे सर्वान्कामांश्च लेभिरे।\nअकृष्टपच्या पृथिवी आशीर्भिर्वीररुधोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082755, "chapter_id": 2764, "verse_number": "१२-२६९-१३", "content_sanskrit": "न ते यज्ञेष्वात्मसु वा फलं पश्यन्ति किंचन।\nशङ्कमानाः फलं यज्ञे ये यजेरन्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082756, "chapter_id": 2764, "verse_number": "१२-२६९-१४", "content_sanskrit": "जानन्तः सर्वथा साधु लुब्धा वित्तप्रयोजनाः।\nस स्म पापकृतां लोकान्गुच्छेदशुभकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082757, "chapter_id": 2764, "verse_number": "१२-२६९-१५", "content_sanskrit": "प्रमाणमप्रमाणेन यः कुर्यादशुभं नरः।\nपापात्मा सोऽकृतप्रज्ञः सदैवेह द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082758, "chapter_id": 2764, "verse_number": "१२-२६९-१६", "content_sanskrit": "कर्तव्यमिति कर्तव्यं वेत्ति वै ब्राह्मणो भयम्।\nब्रह्मैव वर्तते लोके नैव कर्तव्यतां पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082759, "chapter_id": 2764, "verse_number": "१२-२६९-१७", "content_sanskrit": "विगुणं च पुनः कर्म ज्याय इत्यनुशुश्रुम्।\nसर्वभूतोपकारश्च फलभावे च संयमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082760, "chapter_id": 2764, "verse_number": "१२-२६९-१८", "content_sanskrit": "सत्ययज्ञा दमयज्ञा अलुब्धाश्चात्मवृत्तयः।\nउत्पन्नत्यागिनः सर्वे जना आसन्नमत्सराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082761, "chapter_id": 2764, "verse_number": "१२-२६९-१९", "content_sanskrit": "क्षेत्रक्षेत्रज्ञतत्त्वज्ञाः स्वयज्ञपरिनिष्ठिताः।\nब्राह्मं वेदमधीयन्तस्तोषयन्त्यपरानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082762, "chapter_id": 2764, "verse_number": "१२-२६९-२०", "content_sanskrit": "अखिलं दैवतं सर्वं ब्रह्म ब्रह्मणि संश्रितम्।\nतृप्यन्ति तृप्यतो देवास्तृप्ताऽतृप्तस्य जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082763, "chapter_id": 2764, "verse_number": "१२-२६९-२१", "content_sanskrit": "यथा सर्वरसैस्तृप्तो नाभिनन्दति किंचन।\nतथा प्रज्ञानतृप्तस्य नित्यतृप्तिः सुखोदया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082764, "chapter_id": 2764, "verse_number": "१२-२६९-२२", "content_sanskrit": "धर्माधारा धर्मसुखाः कृत्स्नव्यवसितास्तथा।\nअस्ति नस्तत्त्वतो भूय इति प्राज्ञस्त्ववेक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082765, "chapter_id": 2764, "verse_number": "१२-२६९-२३", "content_sanskrit": "ज्ञानविज्ञानिनः केचित्परं पारं तितीर्षवः।\nअतीव पुण्यदं पुण्यं पुण्याभिजनसंहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082766, "chapter_id": 2764, "verse_number": "१२-२६९-२४", "content_sanskrit": "यत्र गत्वा न शोचन्ति च च्यवन्ति व्यथन्ति च।\nते तु तद्ब्रह्मणः स्थानं प्राप्नुवन्तीह सात्विकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082767, "chapter_id": 2764, "verse_number": "१२-२६९-२५", "content_sanskrit": "नैव ते स्वर्गमिच्छन्ति न यजन्ति यशोधनाः।\nसतां वर्त्मानुवर्तन्ते यथाबलमहिंसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082768, "chapter_id": 2764, "verse_number": "१२-२६९-२६", "content_sanskrit": "वनस्पतीनोषधीश्च फलमूलानि ते विदुः।\nन चैतानृत्विजो लुब्धा याजयन्ति फलार्थिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082769, "chapter_id": 2764, "verse_number": "१२-२६९-२७", "content_sanskrit": "स्वमेव चार्थं कुर्वाणा यज्ञं चक्रुः पुनर्द्विजाः।\nपरिनिष्ठितकर्माणाः प्रजानुग्रहकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082770, "chapter_id": 2764, "verse_number": "१२-२६९-२८", "content_sanskrit": "तस्मात्तानृत्विजो लुब्धा याजयन्त्यशुभान्नरान्।\nप्रापयेयुः प्रजाः स्वर्गे स्वधर्माचरणेन वै।\nइति मे वर्तते बुद्धिः समा सर्वत्र जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082771, "chapter_id": 2764, "verse_number": "१२-२६९-२९", "content_sanskrit": "प्रयुञ्जते येन यज्ञे सदा प्राज्ञा द्विजर्षभाः।\nतेन ते देवयानेन पथा यान्ति महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082772, "chapter_id": 2764, "verse_number": "१२-२६९-३०", "content_sanskrit": "आवृत्तिस्तस्य चैकस्य नास्त्यावृत्तिर्मनीषिणाः।\nउभौ तौ देवयानेन गच्छतो जाजले यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082773, "chapter_id": 2764, "verse_number": "१२-२६९-३१", "content_sanskrit": "स्वयं चैषामनडुहो युञ्जन्ति च वहन्ति च।\nस्वयमुस्राश्च दुह्यन्ते मनःसंकल्पसिद्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082774, "chapter_id": 2764, "verse_number": "१२-२६९-३२", "content_sanskrit": "स्वयं यूपानुपादाय यजन्ते स्वाप्तदक्षिणाः।\nयस्तथा भावितात्मा स्यात्स गामालब्धुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082775, "chapter_id": 2764, "verse_number": "१२-२६९-३३", "content_sanskrit": "ओषधीभिस्तथा ब्रह्मन्यजेरंस्ते न तादृशाः।\nश्रद्धया गां पुरस्कृत्य तदृतं प्रब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2082776, "chapter_id": 2764, "verse_number": "१२-२६९-३४", "content_sanskrit": "निराशिषमनारम्भं निर्नमस्कारमस्तुतिम्।\nअक्षीणं क्षीणकर्माणं तं देवा ब्राह्मणं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2082777, "chapter_id": 2764, "verse_number": "१२-२६९-३५", "content_sanskrit": "न श्रावयन्न च यजन्न ददद्ब्राह्मणेषु च।\nकाम्यां वृत्तिं लिप्समानः कां गतिं याति जाजले।\nइदं तु दैवतं कृत्वा यथा यज्ञमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2082778, "chapter_id": 2764, "verse_number": "१२-२६९-३६x", "content_sanskrit": "जाजलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2082779, "chapter_id": 2764, "verse_number": "१२-२६९-३६", "content_sanskrit": "[न वै मुनीनां शृणुमः स्म तत्त्वं\nपृच्छामि ते वाणिज कष्टमेतत्।\nपूर्वेपूर्वे चास्य नावेक्षमाणा\nनातः परं तमृषयः स्थापयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2082780, "chapter_id": 2764, "verse_number": "१२-२६९-३७", "content_sanskrit": "यस्मिन्नेवात्मतीर्थेन पशवः प्राप्नुयुर्मखम्।]\nअथ स्म कर्मणा केन वाणिज प्राप्नुयात्सुखम्।\nशंस मे तन्महाप्राज्ञ भृशं वै श्रद्दधामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2082781, "chapter_id": 2764, "verse_number": "१२-२६९-३८x", "content_sanskrit": "तुलाधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2082782, "chapter_id": 2764, "verse_number": "१२-२६९-३८", "content_sanskrit": "उत यज्ञा उतायज्ञा मस्वं नार्हन्ति ते क्वचित्।\nआज्येन पयसा दध्ना सत्कृत्यामिक्षया त्वचा।\nबालैः शृङ्गेण पादेन संभरत्येव गौर्मखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2082783, "chapter_id": 2764, "verse_number": "१२-२६९-३९", "content_sanskrit": "पत्नीव्रतेन विधिना प्रकरोति नियोजयन्।\nइष्टं तु दैवतं कृत्वा यथा यज्ञमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2082784, "chapter_id": 2764, "verse_number": "१२-२६९-४०", "content_sanskrit": "पुरोडाशो हि सर्वेषां पशूनां मेध्य उच्यते।\nसर्वा नद्यः सरस्वत्यः सर्वे पुण्याः शिलोच्चयाः।\nजाजले तीर्थमात्मेव मा स्म देशातिथिर्भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2082785, "chapter_id": 2764, "verse_number": "१२-२६९-४१", "content_sanskrit": "एतानीदृशकान्धर्मानाचरन्निह जाजले।\nकारणैर्धर्ममन्विच्छन्स लोकानाप्नुते शुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2082786, "chapter_id": 2764, "verse_number": "१२-२६९-४२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2082787, "chapter_id": 2764, "verse_number": "१२-२६९-४२", "content_sanskrit": "एतानीदृशकान्धर्मांस्तुलाधारः प्रशंसति।\nउपपत्त्याऽभिसंपन्नान्नित्यं सद्भिर्निषेवितान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2082788, "chapter_id": 2764, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनसप्तत्यधिकद्विशततमोऽध्यायः॥ २६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]