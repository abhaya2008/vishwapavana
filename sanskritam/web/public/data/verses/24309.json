[{"id": 7004309000, "chapter_id": 24309, "verse_number": "५-३-३-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nसप्तकल्पक्षया घोरास्त्वया दृष्टा महामुने ।\nन चापीहास्ति भगवन्दीर्घायुरिह कश्चन॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004309001, "chapter_id": 24309, "verse_number": "५-३-३-२", "content_sanskrit": "त्वया ह्येकार्णवे सुप्तः पद्मनाभः सुरारिहा ।\nदृष्टः सहस्रचरणः सहस्रनयनोदरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004309002, "chapter_id": 24309, "verse_number": "५-३-३-३", "content_sanskrit": "त्वं किलानुग्रहात्तस्य दह्यमाने चराचरे ।\nन क्षयं समनुप्राप्तो वरदानान्महात्मनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004309003, "chapter_id": 24309, "verse_number": "५-३-३-४", "content_sanskrit": "किं त्वयाश्चर्यभूतं हि दृष्टं च भ्रमतानघ ।\nएतदाचक्ष्व भगवन्परं कौतूहलं हि मे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004309004, "chapter_id": 24309, "verse_number": "५-३-३-५", "content_sanskrit": "सम्प्राप्ते च महाघोरे युगस्यान्ते महाक्षये ।\nअनावृष्टिहते लोके पुरा वर्षशताधिके॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004309005, "chapter_id": 24309, "verse_number": "५-३-३-६", "content_sanskrit": "औषधीनां क्षये घोरे देवदानववर्जिते ।\nनिर्वीर्ये निर्वषट्कारे कलिना दूषिते भृशम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004309006, "chapter_id": 24309, "verse_number": "५-३-३-७", "content_sanskrit": "सरित्सरस्तडागेषु पल्वलोपवनेषु च ।\nसंशुष्केषु तदा ब्रह्मन्निराकारे युगक्षये॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004309007, "chapter_id": 24309, "verse_number": "५-३-३-८", "content_sanskrit": "जनं प्राप्ते महर्लोके ब्रह्मक्षत्रविशादयः ।\nऋषयश्च महात्मानो दिव्यतेजःसमन्विताः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004309008, "chapter_id": 24309, "verse_number": "५-३-३-९", "content_sanskrit": "स्थितानि कानि भूतानि गतान्येव महामुने ।\nएतत्सर्वं महाभाग कथयस्व पृथक्पृथक्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004309009, "chapter_id": 24309, "verse_number": "५-३-३-१०", "content_sanskrit": "भूतानि कानि विप्रेन्द्र कथं सिद्धिमवाप्नुयात् ।\nब्रह्मविष्ण्विन्द्ररुद्राणां काले प्राप्ते सुदारुणे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004309010, "chapter_id": 24309, "verse_number": "५-३-३-११", "content_sanskrit": "एवमुक्तस्ततः सोऽथ धर्मराजेन धीमता ।\nमार्कण्डः प्रत्युवाचेदमृषिसंघैः समावृतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004309011, "chapter_id": 24309, "verse_number": "५-३-३-१२", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nशृण्वन्तु ऋषयः सर्वे त्वया सह नरेश्वर ।\nमहत्पुराणं पूर्वोक्तं शंभुना वायुदैवते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004309012, "chapter_id": 24309, "verse_number": "५-३-३-१३", "content_sanskrit": "वायोः सकाशात्स्कन्देन श्रुतमेतत्पुरातनम् ।\nवसिष्ठः श्रुतवांस्तस्मात्पराशरस्ततः परम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004309013, "chapter_id": 24309, "verse_number": "५-३-३-१४", "content_sanskrit": "तस्माच्च जातूकर्ण्येन तस्माच्चैव महर्षिभिः ।\nएवं परम्पराप्रोक्तं शतसंख्यैर्द्विजोत्तमैः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004309014, "chapter_id": 24309, "verse_number": "५-३-३-१५", "content_sanskrit": "संहिता शतसाहस्री पुरोक्ता शंभुना किल ।\nआलोड्य सर्वशास्त्राणि वदार्थं तत्त्वतः पुरा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004309015, "chapter_id": 24309, "verse_number": "५-३-३-१६", "content_sanskrit": "युगरूपेण सा पश्चाच्चतुर्धा विनियोजिता ।\nमदप्रज्ञानुसारेण नराणां तु महर्षिभिः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004309016, "chapter_id": 24309, "verse_number": "५-३-३-१७", "content_sanskrit": "आराध्य पशुभर्तारं मया पूर्वं महेश्वरम् ।\nपुराणं श्रुतमेतद्धि तत्ते वक्ष्याम्यशेषतः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004309017, "chapter_id": 24309, "verse_number": "५-३-३-१८", "content_sanskrit": "यच्छ्रुत्वा मुच्यते जन्तुः सर्वपापैर्नरेश्वर ।\nमानसैः कर्मजैश्चैव सप्तजन्मसु संचितैः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004309018, "chapter_id": 24309, "verse_number": "५-३-३-१९", "content_sanskrit": "सप्तकल्पक्षया घोरा मया दृष्टाः पुनःपुनः ।\nप्रसादाद्देवदेवस्य विष्णोश्च परमेष्ठिनः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004309019, "chapter_id": 24309, "verse_number": "५-३-३-२०", "content_sanskrit": "द्वादशादित्यनिर्दग्धे जगत्येकार्णवीकृते ।\nश्रान्तोऽहं विभ्रमंस्तत्र तरन्बाहुभिरर्णवम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004309020, "chapter_id": 24309, "verse_number": "५-३-३-२१", "content_sanskrit": "अथाहं सलिले राजन्नादित्यसमरूपिणम् ।\nपुरा पुरुषमद्राक्षमनादिनिधनं प्रभुम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004309021, "chapter_id": 24309, "verse_number": "५-३-३-२२", "content_sanskrit": "शृङ्गं चैवाद्रिराजस्य भासयन्तं दिशो दश ।\nद्वितीयोऽन्यो मनुर्दृष्टः पुत्रपौत्रसमन्वितः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004309022, "chapter_id": 24309, "verse_number": "५-३-३-२३", "content_sanskrit": "अगाधे भ्रमते सोऽपि तमोभूते महार्णवे ।\nअविश्रमन्मुहूर्तं तु चक्रारूढ इव भ्रमन्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004309023, "chapter_id": 24309, "verse_number": "५-३-३-२४", "content_sanskrit": "अथाहं भयादुद्विग्नस्तरन्बाहुभिरर्णवम् ।\nतत्रस्थोऽहं महामत्स्यमपश्यं मदसंयुतम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004309024, "chapter_id": 24309, "verse_number": "५-३-३-२५", "content_sanskrit": "ततोऽब्रवीत्स मां दृष्ट्वा एह्येहीति च भारत ।\nपरं प्रधानः सर्वेषां मत्स्यरूपो महेश्वरः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004309025, "chapter_id": 24309, "verse_number": "५-३-३-२६", "content_sanskrit": "ततोऽहं त्वरया गत्वा तन्मुखे मनुजेश्वर ।\nसुश्रान्तो विगतज्ञानः परं निर्वेदमागतः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004309026, "chapter_id": 24309, "verse_number": "५-३-३-२७", "content_sanskrit": "ततोऽद्राक्षं समुद्रान्ते महदावर्तसंकुलाम् ।\nउद्यत्तरंगसलिलां फेनपुञ्जाट्टहासिनीम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004309027, "chapter_id": 24309, "verse_number": "५-३-३-२८", "content_sanskrit": "नदीं कामगमां पुण्यां झषमीनसमाकुलाम् ।\nनद्यास्तस्यास्तु मध्यस्था प्रमदा कामरूपिणी॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004309028, "chapter_id": 24309, "verse_number": "५-३-३-२९", "content_sanskrit": "नीलोत्पलदलश्यामा महत्प्रक्षोभवाहिनी ।\nदिव्यहाटकचित्राङ्गी कनकोज्ज्वलशोभिता॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004309029, "chapter_id": 24309, "verse_number": "५-३-३-३०", "content_sanskrit": "द्वाभ्यां संगृह्य जानुभ्यां महत्पोतं व्यवस्थिता ।\nतां मनुः प्रत्युवाचेदं का त्वं दिव्यवराङ्गने॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004309030, "chapter_id": 24309, "verse_number": "५-३-३-३१", "content_sanskrit": "तिष्ठसे केन कार्येण त्वमत्र सुरसुन्दरि ।\nसुरासुरगणे नष्टे भ्रमसे लीलयार्णवे॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004309031, "chapter_id": 24309, "verse_number": "५-३-३-३२", "content_sanskrit": "सरितः सागराः शैलाः क्षयं प्राप्ता ह्यनेकशः ।\nत्वमेका तु कथं साध्वि तिष्ठसे कारणं महत् ।\nश्रोतुमिच्छाम्यहं देवि कथयस्व ह्यशेषतः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004309032, "chapter_id": 24309, "verse_number": "५-३-३-३३", "content_sanskrit": "अबलोवाच ।\nईश्वराङ्गसमुद्भूता ह्यमृतानाम विश्रुता ।\nसरित्पापहरा पुण्या मामाश्रित्य भयं कुतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004309033, "chapter_id": 24309, "verse_number": "५-३-३-३४", "content_sanskrit": "साहं पोतमिमं तुभ्यं गृहीत्वा ह्यागता द्विज ।\nन ह्यस्य पोतस्य क्षयो यत्र तिष्ठति शंकरः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004309034, "chapter_id": 24309, "verse_number": "५-३-३-३५", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा विस्मयोत्फुल्ललोचनः ।\nमनुना सह राजेन्द्र पोतारूढो ह्यहं तदा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004309035, "chapter_id": 24309, "verse_number": "५-३-३-३६", "content_sanskrit": "कृताञ्जलिपुटो भूत्वा प्रणम्य शिरसा विभुम् ।\nव्यापिनं परमेशानमस्तौषमभयप्रदम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004309036, "chapter_id": 24309, "verse_number": "५-३-३-३७", "content_sanskrit": "सद्योजाताय देवाय वामदेवाय वै नमः ।\nभवे भवे नमस्तुभ्यं भक्तिगम्याय ते नमः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004309037, "chapter_id": 24309, "verse_number": "५-३-३-३८", "content_sanskrit": "भूर्भुवाय नमस्तुभ्यं रामज्येष्ठाय वै नमः ।\nनमस्ते भद्रकालाय कलिरूपाय वै नमः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004309038, "chapter_id": 24309, "verse_number": "५-३-३-३९", "content_sanskrit": "अचिन्त्याव्यक्तरूपाय महादेवाय धामने ।\nविद्महे देवदेवाय तन्नो रुद्र नमोनमः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004309039, "chapter_id": 24309, "verse_number": "५-३-३-४०", "content_sanskrit": "जगत्सृष्टिविनाशानां कारणाय नमोनमः ।\nएवं स्तुतो महादेवः पूर्वं सृष्टया मयानघ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004309040, "chapter_id": 24309, "verse_number": "५-३-३-४१", "content_sanskrit": "प्रसन्नो मावदत्पश्चाद्वरं वरय सुव्रत॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]