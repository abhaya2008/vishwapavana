[{"id": 5000230000, "chapter_id": 9230, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000230001, "chapter_id": 9230, "verse_number": "३-३४-१", "content_sanskrit": "ततः शूर्पणखां दृष्ट्वा ब्रुवन्तीं परुषं वचः।\nअमात्यमध्ये संक्रुद्धः परिपप्रच्छ रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000230002, "chapter_id": 9230, "verse_number": "३-३४-२", "content_sanskrit": "कश्च रामः कथंवीर्यः किंरूपः किंपराक्रमः।\nकिमर्थं दण्डकारण्यं प्रविष्टश्च सुदुस्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000230003, "chapter_id": 9230, "verse_number": "३-३४-३", "content_sanskrit": "आयुधं किं च रामस्य येन ते राक्षसा हताः।\nखरश्च निहतः संख्ये दूषणस्त्रिशिरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000230004, "chapter_id": 9230, "verse_number": "३-३४-४", "content_sanskrit": "तत्त्वं ब्रूहि मनोज्ञाङ्गि केन त्वं च विरूपिता।\nइत्युक्ता राक्षसेन्द्रेण राक्षसी क्रोधमूर्च्छिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000230005, "chapter_id": 9230, "verse_number": "३-३४-५", "content_sanskrit": "ततो रामं यथान्यायमाख्यातुमुपचक्रमे।\nदीर्घबाहुर्विशालाक्षश्चीरकृष्णाजिनाम्बरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000230006, "chapter_id": 9230, "verse_number": "३-३४-६", "content_sanskrit": "कन्दर्पसमरूपश्च रामो दशरथात्मजः।\nशक्रचापनिभं चापं विकृष्य कनकाङ्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000230007, "chapter_id": 9230, "verse_number": "३-३४-७", "content_sanskrit": "दीप्तान् क्षिपति नाराचान् सर्पानिव महाविषान्।\nनाददानं शरान् घोरान् विमुञ्चन्तं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000230008, "chapter_id": 9230, "verse_number": "३-३४-८", "content_sanskrit": "न कार्मुकं विकर्षन्तं रामं पश्यामि संयुगे।\nहन्यमानं तु तत्सैन्यं पश्यामि शरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000230009, "chapter_id": 9230, "verse_number": "३-३४-९", "content_sanskrit": "इन्द्रेणेवोत्तमं सस्यमाहतं त्वश्मवृष्टिभिः।\nरक्षसां भीमवीर्याणां सहस्राणि चतुर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000230010, "chapter_id": 9230, "verse_number": "३-३४-१०", "content_sanskrit": "निहतानि शरैस्तीक्ष्णैस्तेनैकेन पदातिना।\nअर्धाधिकमुहूर्तेन खरश्च सहदूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000230011, "chapter_id": 9230, "verse_number": "३-३४-११", "content_sanskrit": "ऋषीणामभयं दत्तं कृतक्षेमाश्च दण्डकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000230012, "chapter_id": 9230, "verse_number": "३-३४-१२", "content_sanskrit": "एका कथंचिन्मुक्ताहं परिभूय महात्मना।\nस्त्रीवधं शङ्कमानेन रामेण विदितात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000230013, "chapter_id": 9230, "verse_number": "३-३४-१३", "content_sanskrit": "भ्राता चास्य महातेजा गुणतस्तुल्यविक्रमः।\nअनुरक्तश्च भक्तश्च लक्ष्मणो नाम वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000230014, "chapter_id": 9230, "verse_number": "३-३४-१४", "content_sanskrit": "अमर्षी दुर्जयो जेता विक्रान्तो बुद्धिमान् बली।\nरामस्य दक्षिणो बाहुर्नित्यं प्राणो बहिश्चरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000230015, "chapter_id": 9230, "verse_number": "३-३४-१५", "content_sanskrit": "रामस्य तु विशालाक्षी पूर्णेन्दुसदृशानना।\nधर्मपत्नी प्रिया नित्यं भर्तुः प्रियहिते रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000230016, "chapter_id": 9230, "verse_number": "३-३४-१६", "content_sanskrit": "सा सुकेशी सुनासोरूः सुरूपा च यशस्विनी।\nदेवतेव वनस्यास्य राजते श्रीरिवापरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000230017, "chapter_id": 9230, "verse_number": "३-३४-१७", "content_sanskrit": "तप्तकाञ्चनवर्णाभा रक्ततुङ्गनखी शुभा।\nसीता नाम वरारोहा वैदेही तनुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000230018, "chapter_id": 9230, "verse_number": "३-३४-१८", "content_sanskrit": "नैव देवी न गन्धर्वी न यक्षी न च किंनरी।\nतथारूपा मया नारी दृष्टपूर्वा महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000230019, "chapter_id": 9230, "verse_number": "३-३४-१९", "content_sanskrit": "यस्य सीता भवेद् भार्या यं च हृष्टा परिष्वजेत्।\nअभिजीवेत् स सर्वेषु लोकेष्वपि पुरंदरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000230020, "chapter_id": 9230, "verse_number": "३-३४-२०", "content_sanskrit": "सा सुशीला वपुःश्लाघ्या रूपेणाप्रतिमा भुवि।\nतवानुरूपा भार्या सा त्वं च तस्याः पतिर्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000230021, "chapter_id": 9230, "verse_number": "३-३४-२१", "content_sanskrit": "तां तु विस्तीर्णजघनां पीनोत्तुङ्गपयोधराम्।\nभार्यार्थे तु तवानेतुमुद्यताहं वराननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000230022, "chapter_id": 9230, "verse_number": "३-३४-२२", "content_sanskrit": "विरूपितास्मि क्रूरेण लक्ष्मणेन महाभुज।\nतां तु दृष्ट्वाद्य वैदेहीं पूर्णचन्द्रनिभाननाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000230023, "chapter_id": 9230, "verse_number": "३-३४-२३", "content_sanskrit": "मन्मथस्य शराणां च त्वं विधेयो भविष्यसि।\nयदि तस्यामभिप्रायो भार्यात्वे तव जायते।\nशीघ्रमुद्ध्रियतां पादो जयार्थमिह दक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000230024, "chapter_id": 9230, "verse_number": "३-३४-२४", "content_sanskrit": "रोचते यदि ते वाक्यं ममैतद् राक्षसेश्वर।\nक्रियतां निर्विशङ्केन वचनं मम रावण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000230025, "chapter_id": 9230, "verse_number": "३-३४-२५", "content_sanskrit": "विज्ञायैषामशक्तिं च क्रियतां च महाबल।\nसीता तवानवद्याङ्गी भार्यात्वे राक्षसेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000230026, "chapter_id": 9230, "verse_number": "३-३४-२६", "content_sanskrit": "निशम्य रामेण शरैरजिह्मगै-\nर्हताञ्जनस्थानगतान् निशाचरान्।\nखरं च दृष्ट्वा निहतं च दूषणं\nत्वमद्य कृत्यं प्रतिपत्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000230027, "chapter_id": 9230, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]