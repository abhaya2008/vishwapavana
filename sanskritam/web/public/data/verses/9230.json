[{"id": 40015661, "chapter_id": 9230, "verse_number": "1", "content_sanskrit": "ततस्तेराक्षसास्तत्रगत्वारावणमन्दिरम् । न्यवेदयन्पुरींरुद्धांरामेणसहवानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40015662, "chapter_id": 9230, "verse_number": "2", "content_sanskrit": "रुद्धांतुनगरींश्रुत्वाजातक्रोधोनिशाचरः । विधानंद्विगुणंश्रुत्वाप्रासादंसोऽध्यरोहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40015663, "chapter_id": 9230, "verse_number": "3", "content_sanskrit": "सददर्शावृतांलङ्कांसशैलवनकाननाम् । असङ्ख्येयैर्हरिगणैःसर्वतोयुद्धकाङ्क्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40015664, "chapter_id": 9230, "verse_number": "4", "content_sanskrit": "सदृष्ट्वावानरैःसर्वांवसुधांकवलीकृताम् । कथंक्षपयितव्याःस्युरितिचिन्तापरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40015665, "chapter_id": 9230, "verse_number": "5", "content_sanskrit": "सचिन्तयित्वासुचिरंधैर्यमालम्ब्यरावणः । राघवंहरियूथांश्चददर्शायतलोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40015666, "chapter_id": 9230, "verse_number": "6", "content_sanskrit": "राघवःसहसैन्येनमुदितोनामपुप्लुवे । लङ्कांददर्शगुप्तांवैसर्वतोराक्षसैर्वृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40015667, "chapter_id": 9230, "verse_number": "7", "content_sanskrit": "दृष्ट्वादाशरथिर्लङ्कांचित्रध्वजपताकिनीम् । जगामसहसासीतांदूयमानेनचेतसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40015668, "chapter_id": 9230, "verse_number": "8", "content_sanskrit": "अत्रसामृगशावाक्षीमत्कृतेजनकात्मजा । पीड्यतेशोकसन्तप्ताकृशास्थण्डिलशायिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40015669, "chapter_id": 9230, "verse_number": "9", "content_sanskrit": "पीड्यमानांसधर्मात्मावैदेहीमनुचिन्तयन् । क्षिप्रमाज्ञापयामासवानरान्द्विषतांवधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40015670, "chapter_id": 9230, "verse_number": "10", "content_sanskrit": "एवमुक्तेतुवचनेरामेणाक्लिष्टकर्मणा । संघर्षमाणाःप्लवगाःसिम्हनादैरनादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40015671, "chapter_id": 9230, "verse_number": "11", "content_sanskrit": "शिखरैर्विकिरामैनांलङ्कांमुष्टिभिरेववा । इतिस्मदधिरेसर्वेमनांसिहरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40015672, "chapter_id": 9230, "verse_number": "12", "content_sanskrit": "उद्यम्यगिरिशृङ्गाणिशिखराणिमहान्तिच । तरूंश्चोत्पाट्यविविधांस्तिष्ठन्तिहरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40015673, "chapter_id": 9230, "verse_number": "13", "content_sanskrit": "प्रेक्षतोराक्षसेन्द्रस्यतान्यनीकानिभागशः । राघवप्रियकामार्थंलङ्कामारुरुहुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40015674, "chapter_id": 9230, "verse_number": "14", "content_sanskrit": "तेताम्रवक्त्राहेमाभारामार्थेत्यक्तजीविताः । लङ्कामेवाभ्यवर्तन्तसालतालशिलायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40015675, "chapter_id": 9230, "verse_number": "15", "content_sanskrit": "तेद्रुमैःपर्वताग्रैश्चमु