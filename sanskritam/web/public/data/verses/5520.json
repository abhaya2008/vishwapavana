[{"id": 2212163, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212164, "chapter_id": 5520, "verse_number": "१", "content_sanskrit": "एवं संवत्सरं पूर्णमेकभ(भु)क्तेन यः क्षिपेत् ।\nतस्य पुण्यफलं यद्वै तन्ममाचक्ष्व केशव ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212165, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212166, "chapter_id": 5520, "verse_number": "२", "content_sanskrit": "शृणु पाण्डव सत्यं मे वचनं पुण्यमुत्तमम् ।\nयदकृत्वाऽथवा कृत्वा नरः पापैः प्रमुच्यते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212167, "chapter_id": 5520, "verse_number": "३", "content_sanskrit": "एकभ(भु)क्तेन वर्तेत नरः संवत्सरं तु यः ।\nब्रह्मचारी ह्यधःशायी जितक्रोधो जितेन्द्रियः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212168, "chapter_id": 5520, "verse_number": "४", "content_sanskrit": "शुचिः स्नानरतो व्यग्रः सत्यवागनसूयकः ।\nअर्चयन्नेव मां नित्यं मद्गतेनान्तरात्मना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212169, "chapter_id": 5520, "verse_number": "५", "content_sanskrit": "सन्ध्ययोस्तु जपेन्नित्यं मद्गायत्रीं समाहितः ।\nनमो ब्रह्मण्यदेवायेत्यसकृन्मां प्रणम्य च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212170, "chapter_id": 5520, "verse_number": "६", "content_sanskrit": "विप्रमग्रासने कृत्वा यावकं भैक्षमेव वा ।\nभुक्त्वा तु वाग्यतो भूमावाचान्तस्य द्विजन्मनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212171, "chapter_id": 5520, "verse_number": "७", "content_sanskrit": "नमोऽस्तु वासुदेवायेत्युक्त्वा तु चरणौ स्पृशेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212172, "chapter_id": 5520, "verse_number": "८", "content_sanskrit": "मासे मासे समाप्ते तु भोजयित्वा द्विजान् शुचीन् ।\nसंवत्सरे ततः पूर्णे दद्यात्तु व्रतदक्षिणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212173, "chapter_id": 5520, "verse_number": "९", "content_sanskrit": "नवनीतमयीं गां वा तिलधेनुमथापि वा ।\nविप्रहस्तच्युतैस्तोयैः सहिरण्यैः समुक्षितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212174, "chapter_id": 5520, "verse_number": "१०", "content_sanskrit": "तस्य पुण्यफलं राजन् कथ्यमानं मया शृणु ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212175, "chapter_id": 5520, "verse_number": "११", "content_sanskrit": "दशजन्मकृतं पापं ज्ञानतोऽज्ञानतोऽपि वा ।\nतद् विनश्यति तस्याशु नात्र कार्या विचारणा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212176, "chapter_id": 5520, "verse_number": "१२", "content_sanskrit": "सर्वेषामुपवासानां यच्छ्रेयः सुमहत्फलम् ।\nयच्च निःश्रेयसं लोके तद्भवान् वक्तुमर्हति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212177, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212178, "chapter_id": 5520, "verse_number": "१३", "content_sanskrit": "शृणु राजन् मया पूर्वं यथा गीतं तु नारदे ।\nतथा ते कथयिष्यामि मद्भक्ताय युधिष्ठिर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212179, "chapter_id": 5520, "verse_number": "१४", "content_sanskrit": "यस्तु भक्त्या शुचिर्भूत्वा पञ्चम्यां मे नराधिप ।\nउपवासव्रतं कुर्यात् त्रिकालं चार्चयंस्तु माम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212180, "chapter_id": 5520, "verse_number": "१५", "content_sanskrit": "सर्वक्रतुफलं लब्ध्वा मम लोके महीयते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212181, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212182, "chapter_id": 5520, "verse_number": "१६", "content_sanskrit": "भगवन् देवदेवेश पञ्चमी नाम का तव ।\nतामहं श्रोतुमिच्छामि कथयस्व ममाच्युत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212183, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212184, "chapter_id": 5520, "verse_number": "१७", "content_sanskrit": "पर्वद्वयं च द्वादश्यौ श्रवणं च नराधिप ।\nतत्पञ्चमीति विख्यातं मत्प्रिया च विशेषतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212185, "chapter_id": 5520, "verse_number": "१८", "content_sanskrit": "तस्मात्तु ब्राह्मणश्रेष्ठैर्मन्निवेशितबुद्धिभिः ।\nउपवासस्तु कर्तव्यो मत्प्रियार्थं युधिष्ठिर ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212186, "chapter_id": 5520, "verse_number": "१९", "content_sanskrit": "द्वादश्यामेव वा कुर्याद् उपवासमशक्नुवन् ।\nतेनाहं परमां प्रीतिं यास्यामि नरपुङ्गव ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212187, "chapter_id": 5520, "verse_number": "२०", "content_sanskrit": "अहोरात्रेण द्वादश्यां मार्गशीर्षेण केशवम् ।\nउपोष्य पूजयेद् यो मां सोऽश्वमेधफलं लभेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212188, "chapter_id": 5520, "verse_number": "२१", "content_sanskrit": "द्वादश्यां पुष्यमासे तु नाम्ना नारायणं तु माम् ।\nउपोष्य पूजयेद् यो मां वाजपेयफलं लभेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212189, "chapter_id": 5520, "verse_number": "२२", "content_sanskrit": "द्वादश्यां फाल्गुने मासि गोविन्दाख्यमुपोष्य माम् ।\nअर्चयेद् यः समाप्नोति ह्यतिरात्रफलं नृप ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212190, "chapter_id": 5520, "verse_number": "२३", "content_sanskrit": "द्वादश्यां माघमासे तु मामुपोष्य तु माधवम् ।\nपूजयेद् यः समाप्नोति राजसूयफलं नृप ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212191, "chapter_id": 5520, "verse_number": "२४", "content_sanskrit": "द्वादश्यां मासि चैत्रे तु मां विष्णुं समुपोष्य यः ।\nपूजयन् फलमाप्नोति पौण्डरीकस्य यत्फलम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212192, "chapter_id": 5520, "verse_number": "२५", "content_sanskrit": "द्वादश्यां मासि वैशाखे मधुसूदनसञ्ज्ञितम् ।\nउपोष्य पूजयेद् यो मां सोऽग्निष्टोमस्य पाण्डव ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212193, "chapter_id": 5520, "verse_number": "२६", "content_sanskrit": "द्वादश्यां ज्येष्ठमासे तु मामुपोष्य त्रिविक्रमम् ।\nअर्चयेद् यः समाप्नोति गवां मेधफलं नृप ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212194, "chapter_id": 5520, "verse_number": "२७", "content_sanskrit": "आषाढे वामनाख्यं मां द्वादश्यां समुपोष्य यः ।\nनरमेधस्य स फलं प्राप्नुयान्नरसत्तमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212195, "chapter_id": 5520, "verse_number": "२८", "content_sanskrit": "द्वादश्यां श्रावणे मासि श्रीधराख्यमुपोष्य माम् ।\nपूजयेद् यः समाप्नोति पञ्चयज्ञफलं नृप ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212196, "chapter_id": 5520, "verse_number": "२९", "content_sanskrit": "मासि भाद्रपदे यो मां हृषीकेशाख्यमर्चयेत् ।\nउपोष्य स समाप्नोति सौत्रामणिफलं नृप ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212197, "chapter_id": 5520, "verse_number": "३०", "content_sanskrit": "द्वादश्यामाश्वयुङ्मासे पद्मनाभमुपोष्य माम् ।\nअर्चयेद् यः समाप्नोति गोसहस्रफलं नृप ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212198, "chapter_id": 5520, "verse_number": "३१", "content_sanskrit": "द्वादश्यां कार्तिके मासि मां दामोदरसञ्ज्ञितम् ।\nउपोष्य पूजयेद् यस्तु सर्वक्रतुफलं लभेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2212199, "chapter_id": 5520, "verse_number": "३२", "content_sanskrit": "केवलेनोपवासेन द्वादश्यां पाण्डुनन्दन ।\nयत्फलं पूर्वमुद्दिष्टं तस्यार्धं लभते फलम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2212200, "chapter_id": 5520, "verse_number": "३३", "content_sanskrit": "श्रावणेऽप्येवमेवं मां योऽर्चयेद् भक्तिमान् नरः ।\nमम सालोक्यमाप्नोति नात्र कार्या विचारणा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2212201, "chapter_id": 5520, "verse_number": "३४", "content_sanskrit": "मासे मासे समभ्यर्च्य क्रमशो मामतन्द्रितः ।\nपूर्णे संवत्सरे कुर्यात् पुनः संवत्सरार्चनम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2212202, "chapter_id": 5520, "verse_number": "३५", "content_sanskrit": "एवं द्वादशवर्षं यो मद्भक्तो मत्परायणः ।\nअविघ्नमर्चयानस्तु मम सालोक्यमाप्नुयात् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2212203, "chapter_id": 5520, "verse_number": "३६", "content_sanskrit": "अर्चयेत् प्रीतिमान् यो मां द्वादश्यां वेदसंहिताम् ।\nस पूर्वोक्तफलं राजन् लभते नात्र संशयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2212204, "chapter_id": 5520, "verse_number": "३७", "content_sanskrit": "गन्धं पुष्पं फलं तोयं पत्रं वा मूलमेव वा ।\nद्वादश्यां मम यो दद्यात् ततो नान्योऽस्ति मत्प्रियः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2212205, "chapter_id": 5520, "verse_number": "३८", "content_sanskrit": "एतेन विधिना सर्वे देवाः शक्रपुरोगमाः ।\nमद्भक्त्या नरशार्दूल स्वर्गभोगांस्तु भुञ्जते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2212206, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2212207, "chapter_id": 5520, "verse_number": "३९", "content_sanskrit": "एवं वदति देवेशे केशवे पाण्डुनन्दनः ।\nकृताञ्जलिपुटः स्तोत्रमिदं भक्त्याऽभ्युवाच ह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2212208, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2212209, "chapter_id": 5520, "verse_number": "४०", "content_sanskrit": "सर्वलोकेश देवेश हृषीकेश नमोऽस्तु ते ।\nसहस्रशिरसे तुभ्यं सहस्राक्ष नमोऽस्तु ते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2212210, "chapter_id": 5520, "verse_number": "४१", "content_sanskrit": "त्रयीमय त्रयीनाथ त्रयीस्तुत नमो नमः ।\nयज्ञात्मन् यज्ञसम्भूत यज्ञनाथ नमो नमः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2212211, "chapter_id": 5520, "verse_number": "४२", "content_sanskrit": "चतुर्मूर्ते चतुर्बाहो चतुर्व्यूह नमो नमः ।\nलोकात्मन् लोककृन्नाथ लोकावास नमो नमः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2212212, "chapter_id": 5520, "verse_number": "४३", "content_sanskrit": "सृष्टिसंहारकर्त्रे ते नरसिंह नमो नमः ।\nभक्तप्रिय नमस्तेऽस्तु भक्तवत्सल ते नमः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2212213, "chapter_id": 5520, "verse_number": "४४", "content_sanskrit": "ब्रह्मावास नमस्तेऽस्तु ब्रह्मनाथ नमो नमः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2212214, "chapter_id": 5520, "verse_number": "४५", "content_sanskrit": "रुद्ररूप नमस्तेऽस्तु रुद्रकर्मरताय ते ।\nपञ्चयज्ञ नमस्तेऽस्तु सर्वयज्ञ नमो नमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2212215, "chapter_id": 5520, "verse_number": "४६", "content_sanskrit": "सृष्टिसंहारकर्त्रे ते रुद्रप्रिय नमोऽस्तु ते ।\nकृष्ण प्रिय नमस्तेऽस्तु कृष्ण नाथ नमो नमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2212216, "chapter_id": 5520, "verse_number": "४७", "content_sanskrit": "योगावास नमस्तेऽस्तु योगिनाथ नमो नमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2212217, "chapter_id": 5520, "verse_number": "४८", "content_sanskrit": "हयवक्त्र नमस्तेऽस्तु चक्रपाणे नमो नमः ।\nपञ्चभूत नमस्तेऽस्तु पञ्चायुध नमो नमः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2212218, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2212219, "chapter_id": 5520, "verse_number": "४९", "content_sanskrit": "भक्तिगद्गदया वाचा स्तुवत्येवं युधिष्ठिरे ।\nगहीत्वा केशवो हस्ते प्रीतात्मा तं न्यवारयत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2212220, "chapter_id": 5520, "verse_number": "५०", "content_sanskrit": "निवार्य च पुनर्वाचा भक्तिनम्रं युधिष्ठिरम् ।\nवक्तुमेव नरश्रेष्ठ धर्मपुत्रं प्रचक्रमे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2212221, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2212222, "chapter_id": 5520, "verse_number": "५१", "content_sanskrit": "अन्यवत् किमिदं राजन् मां स्तौषि नरपुङ्गव ।\nतिष्ठ पृच्छ यथापूर्वं धर्मानेव युधिष्ठिर ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2212223, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2212224, "chapter_id": 5520, "verse_number": "५२", "content_sanskrit": "भगवंस्त्वत्प्रसादं तु स्मृत्वा स्मृत्वा पुनः पुनः ।\nन शान्तिरस्ति देवेश नृत्यतीव च मे मनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2212225, "chapter_id": 5520, "verse_number": "५३", "content_sanskrit": "इदं च मम सम्प्रश्नं वक्तुमर्हसि माधव ।\nकृष्णपक्षे तु द्वादश्यामर्चनीयः कथं भवान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2212226, "chapter_id": 5520, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2212227, "chapter_id": 5520, "verse_number": "५४", "content_sanskrit": "शृणु राजन् यथातत्त्वं तत्पूर्वं कथयामि ते ।\nपरमं कृष्णद्वादश्यामर्चनायां फलं मम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2212228, "chapter_id": 5520, "verse_number": "५५", "content_sanskrit": "एकादश्यामुपोष्याथ द्वादश्यामर्चयेत् तु माम् ।\nविप्रानपि यथालाभं भोजयेद् भक्तिमान् नरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2212229, "chapter_id": 5520, "verse_number": "५६", "content_sanskrit": "स गच्छेद् दक्षिणामूर्तिं मां वा नात्र विचारणा ।\nचन्द्रसालोक्यमथवा ग्रहनक्षत्रपूजितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2212230, "chapter_id": 5520, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि वैष्णवधर्मशास्त्रे एकादशीव्रतमाहात्म्यवर्णनं नाम चतुर्दशोत्तरशततमोऽध्यायः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]