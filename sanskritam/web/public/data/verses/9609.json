[{"id": 5000609000, "chapter_id": 9609, "verse_number": "७-७४-१", "content_sanskrit": "तथा तु करुणं तस्य द्विजस्य परिदेवनम् ।\nशुश्राव राघवः सर्वं दुःखशोकसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000609001, "chapter_id": 9609, "verse_number": "७-७४-२", "content_sanskrit": "स दुःखेन च सन्तप्तो मन्त्रिणस्तानुपाह्वयत् ।\nवसिष्ठं वामदेवं च भ्रातरौ सह नैगमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000609002, "chapter_id": 9609, "verse_number": "७-७४-३", "content_sanskrit": "ततो द्विजा वसिष्ठेन सार्धमष्टौ प्रवेशिताः ।\nराजानं देवसङ्काशं वर्धस्वेति ततो ऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000609003, "chapter_id": 9609, "verse_number": "७-७४-४", "content_sanskrit": "मार्कण्डेयो ऽथ मौद्गल्यो वामदेवश्च काश्यपः ।\nकात्यायनो ऽथ जाबालिर्गौतमो नारदस्तथा ।\nएते द्विजर्षभाः सर्वे आसनेषूपवेशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000609004, "chapter_id": 9609, "verse_number": "७-७४-५", "content_sanskrit": "महर्षीन्समनुप्राप्तानभिवाद्य कृताञ्जलिः ।\nमन्त्रिणो नैगमांश्चैव यथार्हमनुकूलतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000609005, "chapter_id": 9609, "verse_number": "७-७४-६", "content_sanskrit": "तेषां समुपविष्टानां सर्वेषां दीप्ततेजसाम् ।\nराघवः सर्वमाचष्टे द्विजो ऽयमुपरोधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000609006, "chapter_id": 9609, "verse_number": "७-७४-७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राज्ञो दीनस्य नारदः ।\nप्रत्युवाच शुभं वाक्यमृषीणां सन्निधौ नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000609007, "chapter_id": 9609, "verse_number": "७-७४-८", "content_sanskrit": "शृणु राजन्यथाकाले प्राप्तो बालस्य सङ्क्षयः ।\nश्रुत्वा कर्तव्यतां राजन्कुरुष्वरघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000609008, "chapter_id": 9609, "verse_number": "७-७४-९", "content_sanskrit": "पुरा कृतयुगे राजन्ब्राह्मणा वै तपस्विनः ।\nअब्राह्मणस्तदा राजन्न तपस्वी कथञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000609009, "chapter_id": 9609, "verse_number": "७-७४-१०", "content_sanskrit": "तस्मिन्युगे प्रज्वलिते ब्रह्मभूते त्वनावृते ।\nअमृत्यवस्तदा सर्वे जज्ञिरे दीर्घदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000609010, "chapter_id": 9609, "verse_number": "७-७४-११", "content_sanskrit": "ततस्त्रेतायुगं नाम मानवानां वपुष्मताम् ।\nक्षत्रियास्तत्र जायन्ते पूर्णेन तपसा ऽन्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000609011, "chapter_id": 9609, "verse_number": "७-७४-१२", "content_sanskrit": "वीर्येण तपसा चैव ते ऽधिकाः पूर्वजन्मनि ।\nमानवा ये महात्मानस्त्वत्र त्रेतायुगे युगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000609012, "chapter_id": 9609, "verse_number": "७-७४-१३", "content_sanskrit": "ब्रह्मक्षत्रं च तत्सर्वं यत्पूर्वमपरं च यत् ।\nयुगयोरुभयोरासीत्समवीर्यसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000609013, "chapter_id": 9609, "verse_number": "७-७४-१४", "content_sanskrit": "अपश्यंस्तु न ते सर्वे विशेषमधिकं ततः ।\nस्थापनं चक्रिरे तत्र चातुर्वर्ण्यस्य सम्मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000609014, "chapter_id": 9609, "verse_number": "७-७४-१५", "content_sanskrit": "तस्मिन्युगे प्रज्वलिते धर्मभूते ह्यनावृते ।\nअधर्मः पादमेकं तु पातयत्पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000609015, "chapter_id": 9609, "verse_number": "७-७४-१६", "content_sanskrit": "अधर्मेण हि संयुक्तस्तेजो मन्दं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000609016, "chapter_id": 9609, "verse_number": "७-७४-१७", "content_sanskrit": "आमिषं यच्च पूर्वेषां राजसं च मलं भृशम् ।\nअनृतं नाम तद्भूतं पादेन पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000609017, "chapter_id": 9609, "verse_number": "७-७४-१८", "content_sanskrit": "अनृतं पातयित्वा तु पादमेकमधर्मतः ।\nततः प्रादुष्कृतं पूर्वमायुषः परिनिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000609018, "chapter_id": 9609, "verse_number": "७-७४-१९", "content_sanskrit": "पतिते त्वनृते तस्मिन्नधर्मे च महीतले ।\nशुभान्येवाचरँल्लोकः सत्यधर्मपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000609019, "chapter_id": 9609, "verse_number": "७-७४-२०", "content_sanskrit": "त्रेतायुगे च वर्तन्ते ब्राह्मणाः क्षत्रियाश्च ये ।\nतपो ऽतप्यन्त ते सर्वे शुश्रूषामपरे जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000609020, "chapter_id": 9609, "verse_number": "७-७४-२१", "content_sanskrit": "स धर्मः परमस्तेषां वैश्यशूद्रं समागमत् ।\nपूजां च सर्ववर्णानां शूद्राश्चक्रुर्विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000609021, "chapter_id": 9609, "verse_number": "७-७४-२२", "content_sanskrit": "एतस्मिन्नन्तरे तेषामधर्मे चानृते च ह ।\nततः पूर्वे भृशं ह्रासमगमन्नृपसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000609022, "chapter_id": 9609, "verse_number": "७-७४-२३", "content_sanskrit": "ततः पादमधर्मस्स द्वितीयमवतारयत् ।\nततो द्वापरसञ्ज्ञा ऽस्य युगस्य समजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000609023, "chapter_id": 9609, "verse_number": "७-७४-२४", "content_sanskrit": "तस्मिन्द्वापरसञ्ज्ञे तु वर्तमाने युगक्षये ।\nअधर्मश्चानृतं चैव ववृधे पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000609024, "chapter_id": 9609, "verse_number": "७-७४-२५", "content_sanskrit": "तस्मिन्द्वापरसङ्ख्याते तपो वैश्यान्समाविशत् ।\nत्रिभ्यो युगेभ्यस्त्रीन्वर्णान्क्रमाद्वै तप आविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000609025, "chapter_id": 9609, "verse_number": "७-७४-२६", "content_sanskrit": "त्रिभ्यो युगेभ्यस्त्रीन्वर्णान्धर्मश्च परिनिष्ठितः ।\nन शुद्धो लभते धर्मं युगतस्तु नरर्षभ ।\nहीनवर्णो नृपश्रेष्ठ तप्यते सुमहत्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000609026, "chapter_id": 9609, "verse_number": "७-७४-२७", "content_sanskrit": "भविष्यच्छूद्रयोन्यां वै तपश्चर्या कलौ युगे ।\nअधर्मः परमो राजन्द्वापरे शूद्रजन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000609027, "chapter_id": 9609, "verse_number": "७-७४-२८", "content_sanskrit": "स वै विषयपर्यन्ते तव राजन्महातपाः ।\nअद्य तप्यति दुर्बुद्धिस्तेन बालवधो ह्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000609028, "chapter_id": 9609, "verse_number": "७-७४-२९", "content_sanskrit": "यो ह्यधर्ममकार्यं वा विषये पार्थिवस्य तु ।\nकरोति चाश्रीमूलं तत्पुरे वा दुर्मतिर्नरः ।\nक्षिप्रं च नरकं याति स च राजा न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000609029, "chapter_id": 9609, "verse_number": "७-७४-३०", "content_sanskrit": "अधीतस्य च तप्तस्य कर्मणः सुकृतस्य च ।\nषष्ठं भजति भागं तु प्रजा धर्मेण पालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000609030, "chapter_id": 9609, "verse_number": "७-७४-३१", "content_sanskrit": "षङ्भागस्य न भोक्ता ऽसौ रक्षते न प्रजाः कथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000609031, "chapter_id": 9609, "verse_number": "७-७४-३२", "content_sanskrit": "स त्वं पुरुषशार्दूल मार्गस्व विषयं स्वकम् ।\nदुष्कृतं यत्र पश्येथास्तत्र यत्नं समाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000609032, "chapter_id": 9609, "verse_number": "७-७४-३३", "content_sanskrit": "एवं चेद्धर्मवृद्धिश्च नृणां चायुर्विवर्धनम् ।\nभविष्यति नरश्रेष्ठ बालस्यास्य च जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000609033, "chapter_id": 9609, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे चतुःसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]