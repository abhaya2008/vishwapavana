[{"id": 7004201000, "chapter_id": 24201, "verse_number": "५-१-५०-१", "content_sanskrit": "सनत्कुमार उवाच ।\nपापनाशिनी विख्याता यथा शिप्रा पयस्विनी ।\nतथाहं संप्रवक्ष्यामि समासेन परंतप॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004201001, "chapter_id": 24201, "verse_number": "५-१-५०-२", "content_sanskrit": "पुरा कृतयुगे व्यास दमनोनाम वै नृपः ।\nकीकटेषु समाख्यातो राजा परमकोपनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004201002, "chapter_id": 24201, "verse_number": "५-१-५०-३", "content_sanskrit": "उत्पथी सर्वधर्माणां गोब्राह्मणविनिंदकः ।\nसुरापी हेमहारी मत्सरी गुरुतल्पगः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004201003, "chapter_id": 24201, "verse_number": "५-१-५०-४", "content_sanskrit": "प्रजासर्वस्वहर्ता च परदाराभिमर्शकः ।\nधूर्तको धूर्तंसंगी च पिशुनस्तस्कराकृतिः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004201004, "chapter_id": 24201, "verse_number": "५-१-५०-५", "content_sanskrit": "गोग्रहः पुरभेदी च बंदी बंदिजनप्रियः ।\nकुत्सितः कोपपूर्णश्च वेदशास्त्रविवर्जितः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004201005, "chapter_id": 24201, "verse_number": "५-१-५०-६", "content_sanskrit": "साधुसंगपरित्यागी दुष्टो दुष्टजनप्रियः ।\nकुलांगनापरित्यागी पण्यस्त्रीवृषलीपतिः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004201006, "chapter_id": 24201, "verse_number": "५-१-५०-७", "content_sanskrit": "धर्मनिंदाकरो नित्यमधर्मे रमते मतिः ।\nन हूयंते न पूज्यंते न श्रूयंते कथा बुधैः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004201007, "chapter_id": 24201, "verse_number": "५-१-५०-८", "content_sanskrit": "वेदा यज्ञाश्च देवानां मूर्तिः पद्भ्यां च ताड्यते ।\nएवं दुष्टतरो राजा न भूतो न भविष्यति॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004201008, "chapter_id": 24201, "verse_number": "५-१-५०-९", "content_sanskrit": "स एकदा वने घोरे मृगयावनगोचरः ।\nइतस्ततो भ्रममाणो व्याधैः परिवृतः खलः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004201009, "chapter_id": 24201, "verse_number": "५-१-५०-१०", "content_sanskrit": "न लब्ध्वा खेटकं किंचित्क्षुधार्तस्तृषितः खलः ।\nएकाकी विगतोऽसंगो महाकालवनांतिके॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004201010, "chapter_id": 24201, "verse_number": "५-१-५०-११", "content_sanskrit": "रात्रिः समागता तत्र घोरा घोरनि षेविता ।\nवृक्षमूलमुपावृत्य शयनार्थी क्षुधार्दितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004201011, "chapter_id": 24201, "verse_number": "५-१-५०-१२", "content_sanskrit": "तत्राश्वं विटपे बद्ध्वा स्वयमेव न्यषीदत ।\nतदैव काले वृक्षाद्वै सर्पः पपात मस्तके॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004201012, "chapter_id": 24201, "verse_number": "५-१-५०-१३", "content_sanskrit": "किमिदं कुत आश्चर्यं कृत्वा हस्तेन वारितः ।\nतेन वारयिता राजा दष्टोंऽगुष्ठे तदाऽहिना॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004201013, "chapter_id": 24201, "verse_number": "५-१-५०-१४", "content_sanskrit": "दष्टमात्रे च नृपतिर्व्यथितः क्षितिमागतः ।\nकियत्काले व्यथाविष्टो मुमोह क्षीणमंगलः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004201014, "chapter_id": 24201, "verse_number": "५-१-५०-१५", "content_sanskrit": "एतत्क्षणात्प्रेतभूतो घोरे नरकसंचये ।\nयमदूतैस्ताड्यमानो विविधास्त्रैः स्वकर्मजैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004201015, "chapter_id": 24201, "verse_number": "५-१-५०-१६", "content_sanskrit": "हर्षिताश्च गणाः सर्वे यमराजस्य किंकराः ।\nबद्ध्वा पाशैश्च तं निन्युः पापिष्ठं यममंदिरे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004201016, "chapter_id": 24201, "verse_number": "५-१-५०-१७", "content_sanskrit": "एतस्मिन्नंतरे व्यास क्रव्यादैः खादितं शवम् ।\nकिंचिच्छेषतरं प्रातर्वायसेनाभिलक्षितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004201017, "chapter_id": 24201, "verse_number": "५-१-५०-१८", "content_sanskrit": "तत्र गत्वानयन्मांसं तुंडेन वियदुद्गतः ।\nततोऽन्यैर्वायसैर्भग्नो भ्राम्यमाण इतस्ततः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004201018, "chapter_id": 24201, "verse_number": "५-१-५०-१९", "content_sanskrit": "तत्राटतो हि यत्रास्ते दिव्या शिप्रा पयस्विनी ।\nकिंचित्कर्मविपाकेन वायसास्यगतं पलम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004201019, "chapter_id": 24201, "verse_number": "५-१-५०-२०", "content_sanskrit": "पतितं वै जले तस्याः शिप्रायास्तस्य काय जम् ।\nतेन पुण्यप्रभावेन शिवोऽजायत तत्क्षणात्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004201020, "chapter_id": 24201, "verse_number": "५-१-५०-२१", "content_sanskrit": "त्रिनेत्रोथ जटाजृटी व्याघ्रांबरपरीवृतः ।\nशूलहस्तो वृषारूढो भालचंद्रो ह्युमापतिः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004201021, "chapter_id": 24201, "verse_number": "५-१-५०-२२", "content_sanskrit": "इत्याश्चर्यमयं रूपं दृष्ट्वा दूताश्च धर्षिताः ।\nतद्गणैस्ताडिता भग्ना धर्मराज्ञे शशंसिरे॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004201022, "chapter_id": 24201, "verse_number": "५-१-५०-२३", "content_sanskrit": "श्रूयतां भो महाराज धर्मराज नमोस्तु ते ।\nदूतानां यद्वचो रम्यं बह्वाश्चर्यमयं परम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004201023, "chapter_id": 24201, "verse_number": "५-१-५०-२४", "content_sanskrit": "कीकटाधिमतिर्मंदः पापिष्ठो वृषलीपतिः ।\nदमनो नाम राजाभूत्समस्ते क्षितिमंडले॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004201024, "chapter_id": 24201, "verse_number": "५-१-५०-२५", "content_sanskrit": "यानि कानि च पापानि ब्रह्महत्यासमानि च ।\nतानि सर्वाणि तेनापि कृतानि भुवि सत्तम॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004201025, "chapter_id": 24201, "verse_number": "५-१-५०-२६", "content_sanskrit": "मर्यादाभेदको मूढो वर्णाश्रमसुधर्मिणाम् ।\nकुसंगी द्यूतकोन्मादी बहुव्यंगभरः खलः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004201026, "chapter_id": 24201, "verse_number": "५-१-५०-२७", "content_sanskrit": "यमदंडपरः पापी अस्माकं हर्षवर्धनः ।\nस कथं शिवरूपी स्यात्किमाश्चर्यमतः परम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004201027, "chapter_id": 24201, "verse_number": "५-१-५०-२८", "content_sanskrit": "यावंतः पतिताः पूर्वे पापिनः सर्व एव हि ।\nकृष्णेन तारिताः सर्वे ब्रह्मपुत्रार्थिना तदा॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004201028, "chapter_id": 24201, "verse_number": "५-१-५०-२९", "content_sanskrit": "तदाप्रभृति सर्वाणि कुंडानि नरकस्य वै ।\nशुष्काणि चैव दृश्यंते ग्रीष्मांते वै ह्रदा यथा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004201029, "chapter_id": 24201, "verse_number": "५-१-५०-३०", "content_sanskrit": "न चैवार्तरवं किंचिच्छ्रूयते तव मंदिरे ।\nअस्माकं जीवनं नास्ति किमुपायं वदस्व नः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004201030, "chapter_id": 24201, "verse_number": "५-१-५०-३१", "content_sanskrit": "एक एवागतो लोके वृत्तिदो नो यमाधिप ।\nसोऽपि शिवत्वमापन्नः कस्मान्नो जीव्यते कथम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004201031, "chapter_id": 24201, "verse_number": "५-१-५०-३२", "content_sanskrit": "धर्मराजस्तदाश्रुत्य किंकराणां परं वचः ।\nचिरं ध्यात्वा स्वकानूचे देशकालोचितं वचः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004201032, "chapter_id": 24201, "verse_number": "५-१-५०-३३", "content_sanskrit": "धर्मराज उवाच ।\nश्रूयतां भो गणाः सर्वैः श्रुतिरेकाग्रमानसैः ।\nयेन पुण्यप्रभावेन पापिष्ठः शिवतां गतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004201033, "chapter_id": 24201, "verse_number": "५-१-५०-३४", "content_sanskrit": "भुवि पुण्यतमे देशे महाकालवने शुभे ।\nशिप्रानाम सरिच्छ्रेष्ठा सर्वपापहरा परा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004201034, "chapter_id": 24201, "verse_number": "५-१-५०-३५", "content_sanskrit": "येषां शिप्रोदक स्पर्शो जायते भुवि किंकराः ।\nन तेषां पातकं किंचिन्मृतः शिवपुरं व्रजेत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004201035, "chapter_id": 24201, "verse_number": "५-१-५०-३६", "content_sanskrit": "मनसा वपुषा वाचा पापानि विविधानि च ।\nतत्क्षणात्प्रलयं यांति शिप्रासरिन्निषेवणात्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004201036, "chapter_id": 24201, "verse_number": "५-१-५०-३७", "content_sanskrit": "शिप्राशिप्रेति यो ब्रूते यत्र कुत्रापि मानवः ।\nस एव शिवतां याति न जाने स्नानजं फलम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004201037, "chapter_id": 24201, "verse_number": "५-१-५०-३८", "content_sanskrit": "यत्र कीटपतंगाश्च शिप्रावारिचराश्च ये ।\nमृताः शिवपुरं यान्ति शिप्रानीरनिषेवणात्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004201038, "chapter_id": 24201, "verse_number": "५-१-५०-३९", "content_sanskrit": "कृत्वान्यत्र महापापं येऽन्ते शिप्रातटं श्रिताः ।\nमहापातकिनोऽप्येते मृता यांति शिवालयम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004201039, "chapter_id": 24201, "verse_number": "५-१-५०-४०", "content_sanskrit": "माधवे मासि संप्राप्ते निमज्जंति नरोत्तमाः ।\nन तेषां निरयं किंचिच्छिवरूपाश्चरंति ते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004201040, "chapter_id": 24201, "verse_number": "५-१-५०-४१", "content_sanskrit": "वायसेनाहृतं मांसं तस्य राज्ञः कृतागसः ।\nशिप्रागाधजले क्षिप्तं का तत्र परिदेवना॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004201041, "chapter_id": 24201, "verse_number": "५-१-५०-४२", "content_sanskrit": "वापीकूपतडागादि अधिकाधिकसत्फलम् ।\nतस्माद्दशगुणं पुण्यं नदीषु उपजायते॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004201042, "chapter_id": 24201, "verse_number": "५-१-५०-४३", "content_sanskrit": "तस्माद्दशगुणा तापी गोदा पुण्या ततोधिका ।\nतस्माद्दशगुणा रेवा गंगा पुण्या ततोऽधिका ।\nतस्माद्दशगुणा शिप्रा पवित्रा पापनाशिनी॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004201043, "chapter_id": 24201, "verse_number": "५-१-५०-४४", "content_sanskrit": "दमनस्य शरीरस्य मांसं शिप्रासमागतम् ।\nतेन पुण्यप्रभावेन शिवरूपधरोऽभ वत्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004201044, "chapter_id": 24201, "verse_number": "५-१-५०-४५", "content_sanskrit": "ईदृशा च नदी रम्या अवन्त्यां भुवि वर्तते ।\nवांछंति देवताः सर्वास्तस्या दुर्लभदर्शनम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004201045, "chapter_id": 24201, "verse_number": "५-१-५०-४६", "content_sanskrit": "धर्मराजवचः श्रुत्वा गणा विस्मय मागताः ।\nमनसा च निरातंकाः शिप्रां शरणमागताः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004201046, "chapter_id": 24201, "verse_number": "५-१-५०-४७", "content_sanskrit": "सनत्कुमार उवाच ।\nतदाप्रभृति विख्याता शिप्रेयं पापनाशिनी ।\nगीयते च पुराणेषु यस्या माहात्म्यमुत्तमम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004201047, "chapter_id": 24201, "verse_number": "५-१-५०-४८", "content_sanskrit": "दमनस्य च निर्मुक्तिः शिप्रामाहात्म्यमुत्तमम् ।\nयमदूतानां संवादं श्रुत्वा मुक्तिर्न संशयः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]