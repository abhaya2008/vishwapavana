[{"id": 2150215, "chapter_id": 4257, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150216, "chapter_id": 4257, "verse_number": "१", "content_sanskrit": "प्रत्यक्षमेतल्लोकानां सर्वेषामेव भामिनि ।\nयथाशक्त्या मया युद्धं कृतं वै पौरुषं महत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150217, "chapter_id": 4257, "verse_number": "२", "content_sanskrit": "न चैवमपि शक्तोऽस्मि भीष्मं शस्त्रभृतां वरम् ।\nविशेषयितुमत्यर्थमुत्तमास्त्राणि दर्शयन्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150218, "chapter_id": 4257, "verse_number": "३", "content_sanskrit": "एषा मे परमा शक्तिरेतन्मे परमं बलम् ।\nयथेष्टं गम्यतां भद्रे किमन्यद्वा करोमि ते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150219, "chapter_id": 4257, "verse_number": "४", "content_sanskrit": "भीष्ममेव प्रपद्यस्व न तेऽन्या विद्यते गतिः ।\nनिर्जितो ह्यस्मि भीष्मेण महास्त्राणि प्रमुञ्चता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150220, "chapter_id": 4257, "verse_number": "५", "content_sanskrit": "एवमुक्त्वा ततो रामो विनिःश्वस्य महामनाः ।\nतूष्णीमासीत् ततः कन्या प्रोवाच भृगुनन्दनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150221, "chapter_id": 4257, "verse_number": "६", "content_sanskrit": "भगवन्नेवमेवैतद् यथाऽऽह भगवांस्तथा ।\nअजेयो युधि भीष्मोऽयमपि देवैरुदारधीः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150222, "chapter_id": 4257, "verse_number": "७", "content_sanskrit": "यथाशक्ति यथोत्साहं मम कार्यं कृतं त्वया\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150223, "chapter_id": 4257, "verse_number": "८", "content_sanskrit": "अनिवार्यं रणे वीर्यमस्त्राणि विविधानि च ।\nन चैव शक्यते युद्धे विशेषयितुमन्ततः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150224, "chapter_id": 4257, "verse_number": "९", "content_sanskrit": "न चाहमेनं यास्यामि पुनर्भीष्मं कथञ्चन\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150225, "chapter_id": 4257, "verse_number": "१०", "content_sanskrit": "गमिष्यामि तु तत्राहं यत्र भीष्मं तपोधन ।\nसङ्गरे पातयिष्यामि स्वयमेव भृगूद्वह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150226, "chapter_id": 4257, "verse_number": "११", "content_sanskrit": "एवमुक्त्वा ययौ कन्या रोषव्याकुललोचना ।\nतपसे धृतसङ्कल्पा सा मे चिन्तयती वधम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150227, "chapter_id": 4257, "verse_number": "१२", "content_sanskrit": "ततो महेन्द्रसहितैर्मुनिभिर्भृगुसत्तमः ।\nयथागतं तथा सोऽगान्मामुपामन्त्र्य भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150228, "chapter_id": 4257, "verse_number": "१३", "content_sanskrit": "ततो रथं समारुह्य स्तूयमानो द्विजातिभिः ।\nप्रविश्य नगरं मात्रे सत्यवत्यै न्यवेदयम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150229, "chapter_id": 4257, "verse_number": "१४", "content_sanskrit": "यथावृत्तं महाराज सा च मां प्रत्यनन्दत ।\nपुरुषांश्चादिशं प्राज्ञान् कन्यावृत्तान्तकर्मणि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150230, "chapter_id": 4257, "verse_number": "१५", "content_sanskrit": "दिवसे दिवसे ह्यस्या गतिजल्पितचेष्टितम् ।\nप्रत्याहरंश्च मे युक्ताः स्थिताः प्रियहिते मम\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150231, "chapter_id": 4257, "verse_number": "१६", "content_sanskrit": "यदैव हि वनं प्रायात् सा कन्या तपसे धृता ।\nतथैव व्यथितो दीनो गतचेता इवाभवम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150232, "chapter_id": 4257, "verse_number": "१७", "content_sanskrit": "न हि मां क्षत्रियः कश्चिद् वीर्येण विजयेद् युधि ।\nऋते ब्रह्मविदस्तात तापसान् संशितव्रतान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150233, "chapter_id": 4257, "verse_number": "१८", "content_sanskrit": "अपि चैतन्मया राजन् नारदे विनिवेदितम् ।\nव्यासे चैव तथा कार्यं तौ चोभौ मामवोचताम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150234, "chapter_id": 4257, "verse_number": "१९", "content_sanskrit": "न विषादस्त्वया कार्यो भीष्म काशिसुतां प्रति ।\nदैवं पुरुषकारेण को निवर्तितुमुत्सहेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150235, "chapter_id": 4257, "verse_number": "२०", "content_sanskrit": "सा कन्या तु महाराज प्रविश्याश्रममण्डलम् ।\nयमुनातीरमाश्रित्य तपस्तेपेऽतिमानुषम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150236, "chapter_id": 4257, "verse_number": "२१", "content_sanskrit": "निराहारा कृशा रूक्षा जटिला मलपङ्किनी ।\nषण्मासान् वायुभक्षा च स्थाणुभूता तपोधना\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150237, "chapter_id": 4257, "verse_number": "२२", "content_sanskrit": "यमुनाजलमाश्रित्य संवत्सरमथापरम् ।\nउदवासं निराहारा पारयामास भामिनी\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150238, "chapter_id": 4257, "verse_number": "२३", "content_sanskrit": "शीर्णपर्णेन चैकेन धारयामास सा परम् ।\nसंवत्सरं तीव्रकोपात् पादाङ्गुष्ठाग्रविष्ठिता\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150239, "chapter_id": 4257, "verse_number": "२४", "content_sanskrit": "एवं द्वादशवर्षाणि तापयामास रोदसी ।\nनिवर्त्यमाना पित्रा च ज्ञातिभिर्नैव शक्यते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150240, "chapter_id": 4257, "verse_number": "२५", "content_sanskrit": "ततोऽगमद् वत्सभूमिं सिद्धचारणसेविताम् ।\nआश्रमं पुण्यशीलानां तापसानां महात्मनाम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150241, "chapter_id": 4257, "verse_number": "२६", "content_sanskrit": "तत्र पुण्येषु तीर्थेषु सा प्लुताङ्गी दिवानिशम् ।\nव्यचरत् काशिकन्या सा यथाकामं विचारिणी\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150242, "chapter_id": 4257, "verse_number": "२७", "content_sanskrit": "नन्दाश्रमे महाराज तथोलूकाश्रमे शुभे ।\nच्यवनस्याश्रमे चैव ब्रह्मणः स्थान एव च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150243, "chapter_id": 4257, "verse_number": "२८", "content_sanskrit": "प्रयागे देवयजने देवारण्येषु चैव ह ।\nभोगवत्यां महाराज कौशिकस्याश्रमे तथा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150244, "chapter_id": 4257, "verse_number": "२९", "content_sanskrit": "माण्डव्यस्याश्रमे राजन् दिलीपस्याश्रमे तथा ।\nरामाश्रमे च कौरव्य तथा गार्ग्यस्य चाश्रमे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150245, "chapter_id": 4257, "verse_number": "३०", "content_sanskrit": "एतेषु तीर्थेषु तदा काशिकन्या विशाम्पते ।\nआप्लावयत गात्राणि तीव्रमास्थाय वै तपः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150246, "chapter_id": 4257, "verse_number": "३१", "content_sanskrit": "तामब्रवीच्च कौरव्य मम माता जलोत्थिता\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150247, "chapter_id": 4257, "verse_number": "३२", "content_sanskrit": "किमर्थं क्लिश्यसे भद्रे तथ्यमेतद् वदस्व मे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150248, "chapter_id": 4257, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150249, "chapter_id": 4257, "verse_number": "३३", "content_sanskrit": "सैनामथाब्रवीद् राजन् कृताञ्जलिरनिन्दिता\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150250, "chapter_id": 4257, "verse_number": "३४", "content_sanskrit": "भीष्मेण समरे रामो निर्जितश्चारुलोचने ।\nकोऽन्यस्तमुत्सहेज्जेतुमुद्यतेषुं महीपतिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150251, "chapter_id": 4257, "verse_number": "३५", "content_sanskrit": "साऽहं भीष्मविनाशाय तपस्तप्स्ये सुदारुणम् ।\nविचरामि महीं देवि यथा हन्यामहं नृपम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150252, "chapter_id": 4257, "verse_number": "३६", "content_sanskrit": "एतद् व्रतफलं देहि परमस्मिन् यथा हि मे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150253, "chapter_id": 4257, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150254, "chapter_id": 4257, "verse_number": "३७", "content_sanskrit": "ततोऽब्रवीत् सागरगा जिह्मं चरसि भामिनि ।\nनैष कामोऽनवद्याङ्गि शक्यः प्राप्तुं त्वयाऽबले\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2150255, "chapter_id": 4257, "verse_number": "३८", "content_sanskrit": "यदि भीष्मविनाशाय काश्ये चरसि वै व्रतम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2150256, "chapter_id": 4257, "verse_number": "३९", "content_sanskrit": "व्रतस्था तु शरीरं त्वं यदि नाम विमोक्ष्यसि ।\nनदी भविष्यसि शुभे कुटिला वार्षिकोदका\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2150257, "chapter_id": 4257, "verse_number": "४०", "content_sanskrit": "दुस्तीर्था चानभिज्ञाता वार्षिकीनाऽष्टमासिकी ।\nभीष्मग्राहवती घोरा सर्वभूतभयङ्करी\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2150258, "chapter_id": 4257, "verse_number": "४१", "content_sanskrit": "एवमुक्त्वा ततो राजन् काशिकन्यां न्यवर्तत ।\nमाता मम महाभागा स्मयमानेव भामिनी\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2150259, "chapter_id": 4257, "verse_number": "४२", "content_sanskrit": "कदाचिदष्टमे मासि कदाचिद्दशमे तथा ।\nन प्राश्नीतोदकमपि तेपे सा वरवर्णिनी\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2150260, "chapter_id": 4257, "verse_number": "४३", "content_sanskrit": "सा वत्सभूमिं कौरव्य तीर्थलोभात् ततस्ततः ।\nपतिता परिधावन्ती पुनः काशिपतेः सुता\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2150261, "chapter_id": 4257, "verse_number": "४४", "content_sanskrit": "सा नदी वत्सभूम्यां तु प्रथिताऽम्बेति भारत ।\nवार्षिकी ग्राहबहुला दुस्तीर्था कुटिला तथा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2150262, "chapter_id": 4257, "verse_number": "४५", "content_sanskrit": "सा कन्या तपसा तेन देहार्धेन व्यजायत ।\nनदी च राजन् वत्सेषु कन्या चैवाभवत् तदा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2150263, "chapter_id": 4257, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टाशीत्युत्तरशततमोऽध्यायः ॥१८८॥\nअम्बोपाख्यानपर्वणि अष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]