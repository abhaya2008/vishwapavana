[{"id": 2017524, "chapter_id": 1364, "verse_number": "३-२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017525, "chapter_id": 1364, "verse_number": "३-२-१", "content_sanskrit": "प्रभातायां तु शर्वर्यां तेषामक्लिष्टकर्मणाम्।\nवनं यियासतां विप्रास्तस्थुर्भिक्षाभुजोऽग्रतः।\nतानुवाच ततो राजा कुन्तीपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017526, "chapter_id": 1364, "verse_number": "३-२-२", "content_sanskrit": "वयं हि हृतसर्वस्वा हृतराज्या हृतश्रियः।\nफलमूलामिषाहारा वनं यास्याम दुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017527, "chapter_id": 1364, "verse_number": "३-२-३", "content_sanskrit": "वनं च दोषबहुलं बहुव्यालसरीसृपम्।\nपरिक्लेशश्चवो मन्ये ध्रुवं तत्र भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017528, "chapter_id": 1364, "verse_number": "३-२-४", "content_sanskrit": "ब्राह्मणानां परिक्लेशो दैवतान्यपि सादयेत्।\nकिंपुनर्मामितो विप्रा निवर्तध्वं यथेष्टतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017529, "chapter_id": 1364, "verse_number": "३-२-५x", "content_sanskrit": "ब्राह्मणा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017530, "chapter_id": 1364, "verse_number": "३-२-५", "content_sanskrit": "गतिर्या भवतां राजंस्तां वयं गन्तुमुद्यताः।\nनार्हथास्मान्परित्यक्तुं भक्तान्सद्धर्मदर्शिन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017531, "chapter_id": 1364, "verse_number": "३-२-६", "content_sanskrit": "स्नेहकर्माणि भक्तेषु दैवतान्यपि कुर्वते।\nविशेषतो ब्राह्मणेषु सदाचारावलम्बिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017532, "chapter_id": 1364, "verse_number": "३-२-७x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017533, "chapter_id": 1364, "verse_number": "३-२-७", "content_sanskrit": "ममापि परमा भक्तिर्ब्राह्मणेषु सदा द्विजाः।\nसहायविपरिभ्रंशस्त्वयं सादयतीव माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017534, "chapter_id": 1364, "verse_number": "३-२-८", "content_sanskrit": "आहरेयुर्हि ये सर्वे फलमूलमृगांस्तथा।\nत इमे शोकजैर्दुःखैर्भ्रातरो मे विमोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017535, "chapter_id": 1364, "verse_number": "३-२-९", "content_sanskrit": "द्रौपद्या विप्रकर्षेण राज्यापहरणेन च।\nदुःखार्दितानिमान्क्लेशैर्नाहं योक्तुमिहोत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017536, "chapter_id": 1364, "verse_number": "३-२-१०x", "content_sanskrit": "ब्राह्मणा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017537, "chapter_id": 1364, "verse_number": "३-२-१०", "content_sanskrit": "अस्मत्पोषणजा चिन्ता मा भूत्ते हृदि पार्थिव।\nस्वयमाहृत्य वन्यानि त्वानुयास्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017538, "chapter_id": 1364, "verse_number": "३-२-११", "content_sanskrit": "अनुध्यानेन जप्येन विधास्यामः शिव तव।\nकथाभिश्चानुकूलाभिः सह रंस्यामहे वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017539, "chapter_id": 1364, "verse_number": "३-२-१२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017540, "chapter_id": 1364, "verse_number": "३-२-१२", "content_sanskrit": "एवमेतन्न संदेहो रमेयं ब्राह्मणैः सह।\nन्यूनभावात्तु पश्यामि प्रत्यादेशमिवात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017541, "chapter_id": 1364, "verse_number": "३-२-१३", "content_sanskrit": "कथं द्रक्ष्यामि वः सर्वान्स्वयमाहृत्य भोजिनः।\nमद्भक्त्या क्लिश्यतोऽनर्हान्धिक्पापान्धृतराष्ट्रजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017542, "chapter_id": 1364, "verse_number": "३-२-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017543, "chapter_id": 1364, "verse_number": "३-२-१४", "content_sanskrit": "इत्युक्त्वा नृपतिः शोचन्निषसाद महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017544, "chapter_id": 1364, "verse_number": "३-२-१५", "content_sanskrit": "तमध्यात्मरतो विद्वाञ्शौनको नाम वै द्विजः।\nयोगे साङ्ख्ये च कुशलो राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017545, "chapter_id": 1364, "verse_number": "३-२-१६", "content_sanskrit": "शोकस्थानसहस्राणि हर्षस्थानशतानि च।\nदिवसेदिवसे मूढमाविशन्ति न पण्डितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017546, "chapter_id": 1364, "verse_number": "३-२-१७", "content_sanskrit": "न हि ज्ञानविरुद्धेषु बहुदोषेषु कर्मसु।\nश्रेयोघातिषु सज्जन्ते बुद्धिमन्तो भवद्विधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017547, "chapter_id": 1364, "verse_number": "३-२-१८", "content_sanskrit": "अष्टाङ्गां बुद्धिमाहुर्यां सर्वाश्रेयोभिघातिनीम्।\nश्रुतिस्मृतिसमायुक्तां राजन्सा त्वय्यवस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017548, "chapter_id": 1364, "verse_number": "३-२-१९", "content_sanskrit": "`शुश्रूषा श्रवणं चैव ग्रहणं धारणं तथा।\nऊहापोहोऽर्थविज्ञानं तत्वज्ञानं च धीगुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017549, "chapter_id": 1364, "verse_number": "३-२-२०", "content_sanskrit": "अर्थकृच्छ्रेषु दुर्गेषु व्यापत्सु स्वजनेष्वपि।\nशारीरमानसैर्दुःखैर्न सीदन्ति भवद्विधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017550, "chapter_id": 1364, "verse_number": "३-२-२१", "content_sanskrit": "श्रूयतां चाभिधास्यामि जनकेन यथा पुरा।\nआत्मव्यवस्थानकरागीताः श्लोका महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017551, "chapter_id": 1364, "verse_number": "३-२-२२", "content_sanskrit": "मनोदेहसमुत्थाभ्यां दुःखाभ्यामर्दितं जगत्।\nतयोर्व्याससमासाभ्यांशमोपायमिमं शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017552, "chapter_id": 1364, "verse_number": "३-२-२३", "content_sanskrit": "व्याधेरनिष्टसंस्पर्शाच्छ्रमादिष्टविवर्जनात्।\nदुःखं चतुर्भिः शारीरं कारणैः संप्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017553, "chapter_id": 1364, "verse_number": "३-२-२४", "content_sanskrit": "तदा तत्प्रतिकाराच्च सततं चाविचिन्तनात्।\nआधिव्याधिप्रशमनं क्रियायोगबलेन तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017554, "chapter_id": 1364, "verse_number": "३-२-२५", "content_sanskrit": "मतिमन्तो व्यथोपेताः शमं प्रागेव कुर्वते।\nमानसस्य प्रियाख्यानैः संभोगोपनयैर्नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017555, "chapter_id": 1364, "verse_number": "३-२-२६", "content_sanskrit": "मानसेन हि दुःखेन शरीरमुपतप्यते।\nअयःपिण्डेन तप्तेन कुम्भसंस्थमिवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017556, "chapter_id": 1364, "verse_number": "३-२-२७", "content_sanskrit": "मानसं शमयेत्तस्माज्ज्ञानेनाग्निमिवाम्बुना।\nप्रशन्ते मानसे दुःखे शारीरमुपशाम्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017557, "chapter_id": 1364, "verse_number": "३-२-२८", "content_sanskrit": "मनसो दुःखमूलं तु स्नेह इत्युपलभ्यते।\nस्नेहात्तु सज्जते जन्तुर्दुःखयोगमुपैति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017558, "chapter_id": 1364, "verse_number": "३-२-२९", "content_sanskrit": "स्नेहमूलानि दुःखानि स्नेहजानि भयानि च।\nशोकहर्षौ तथायासः सर्वं स्नेहात्प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017559, "chapter_id": 1364, "verse_number": "३-२-३०", "content_sanskrit": "स्नेहात्कारुण्यरागौ च प्रजास्वीर्ष्यादयस्तथा।\nअश्रेयस्कावुभावेतौ पूर्वस्तत्र गुरुः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017560, "chapter_id": 1364, "verse_number": "३-२-३१", "content_sanskrit": "कोटराग्निर्यथाऽशेषं समूलं पादपं दहेत्।\nधर्मार्थिनं तथाऽल्पोपि रागदोषो विनाशयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017561, "chapter_id": 1364, "verse_number": "३-२-३२", "content_sanskrit": "विप्रयोगे न तु त्यागी दोषदर्शी समागमे।\nविरागं भजते जन्तुर्निर्वैरो निष्परिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017562, "chapter_id": 1364, "verse_number": "३-२-३३", "content_sanskrit": "तस्मात्स्नेहं स्वपक्षेभ्यो मित्रेभ्यो धनसंचयात्।\nस्वशरीरसमुत्थं च ज्ञानेन विनिवर्तयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017563, "chapter_id": 1364, "verse_number": "३-२-३४", "content_sanskrit": "ज्ञानान्वितेषु युक्तेषु शास्त्रज्ञेषु कृतात्मसु।\nन तेषु सज्जते स्नेहः पद्मपत्रेष्विवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017564, "chapter_id": 1364, "verse_number": "३-२-३५", "content_sanskrit": "रागाभिभूतः पुरुषः कामेन परिकृष्यते।\nइच्छा संजायते तस्य ततस्तृष्णा विवर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017565, "chapter_id": 1364, "verse_number": "३-२-३६", "content_sanskrit": "तृष्णा हि सर्वपापिष्ठा नित्योद्देगकरी नृणाम्।\nअधर्मबहुला चैव घोरा पापानुबन्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017566, "chapter_id": 1364, "verse_number": "३-२-३७", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः।\nयोसौ प्राणान्तिको रोगस्तां तृष्णांत्यजतः सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017567, "chapter_id": 1364, "verse_number": "३-२-३८", "content_sanskrit": "अनाद्यन्ता तु सा तृष्णा अन्तर्देहगता नृणाम्।\nविनाशयति भूतानि अयोनिज इवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017568, "chapter_id": 1364, "verse_number": "३-२-३९", "content_sanskrit": "यथैधः स्वसमुत्थेन वह्निना नाशमृच्छति।\nतथाऽकृतात्मा लोभेन सहजेन विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017569, "chapter_id": 1364, "verse_number": "३-२-४०", "content_sanskrit": "राजतः सलिलादग्नेश्चोरतः स्वजनादपि।\n`अर्थिभ्यः कालतस्तस्मान्नित्यमर्थवतां भयम्।\nभयमर्थवतां नित्यं मृत्योः प्राणभृतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017570, "chapter_id": 1364, "verse_number": "३-२-४१", "content_sanskrit": "यथा ह्याभिषमाकाशे पक्षिभिः श्वापदैर्भुवि।\nभक्ष्यते सलिले मत्स्यैस्तथा सर्वेण वित्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017571, "chapter_id": 1364, "verse_number": "३-२-४२", "content_sanskrit": "अर्थ एव हि केषांचिदनर्थं भजते नृणाम्।\nअर्थश्रेयसि चासक्तो न श्रेयो विन्दते नरः।\nतस्मादर्थागमाः सर्वे मनोमोहविवर्धनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017572, "chapter_id": 1364, "verse_number": "३-२-४३", "content_sanskrit": "कार्पण्यं दर्पमानौ च भयमुद्वेग एव च।\nअर्थजानि विदुः प्राज्ञा दुःखान्येतानि देहिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017573, "chapter_id": 1364, "verse_number": "३-२-४४", "content_sanskrit": "अर्थस्योपार्जने दुःखमार्जितानां च रक्षणे।\nनाशे दुःखं व्यये दुःखं घ्नन्ति चैवार्थकारणात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017574, "chapter_id": 1364, "verse_number": "३-२-४५", "content_sanskrit": "अर्था दुःखं परित्यक्तुं पालिताश्चैव शत्रवः।\nदुःखेन चाधिगम्यन्ते तेषां नाशं न चिन्तयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2017575, "chapter_id": 1364, "verse_number": "३-२-४६", "content_sanskrit": "असन्तोषपरा मूढाः संतोषं यान्ति पण्डिताः।\nअन्तो नास्ति पिपासायाः संतोषः परमं सुखम्।\nतस्मात्संतोषमेवेह परं पश्यन्ति पण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2017576, "chapter_id": 1364, "verse_number": "३-२-४७", "content_sanskrit": "अनित्यं यौवनं रूपं जीवितं रत्नसंचयः।\nऐश्वर्यं प्रियसंवासो गृद्ध्येत्तत्र न पण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2017577, "chapter_id": 1364, "verse_number": "३-२-४८", "content_sanskrit": "त्यजेत स च यांस्तस्मात्तज्जान्क्लेशान्सहेत च।\nन हि संचयवान्कश्चिद्दृश्यते निरुपद्रवः।\nअतश्च धार्मिकैः पुम्भिरनीहार्थः प्रशस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2017578, "chapter_id": 1364, "verse_number": "३-२-४९", "content_sanskrit": "धर्मार्थं यस्य वित्तेहा वरं तस्य नरीहता।\nप्रक्षालनाद्धि पङ्कस्य श्रेयो ह्यस्पर्शनं नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2017579, "chapter_id": 1364, "verse_number": "३-२-५०", "content_sanskrit": "युधिष्ठिरैवमर्थेषु न स्पृहां कर्तुमर्हसि।\nधर्मेण यदि ते कार्यं विमुक्तेच्छो भवार्थतः ॥ ३-२-५१xयुधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2017580, "chapter_id": 1364, "verse_number": "३-२-५१", "content_sanskrit": "नार्थोपभोगलिप्सार्थमियमर्थेप्सुता मम।\nभरणार्थं तु विप्राणां ब्रह्मन्काङ्क्षे न लोभतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2017581, "chapter_id": 1364, "verse_number": "३-२-५२", "content_sanskrit": "कथं ह्यस्मद्विधो ब्रह्मन्वर्तमानो गृहाश्रमे।\nभरणं पालनं चापि न कुर्यादनुयायिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2017582, "chapter_id": 1364, "verse_number": "३-२-५३", "content_sanskrit": "संविभागो हि भूतानां सर्वेषामेव दृश्यते।\nतथैवापचमानेभ्यः प्रदेयं गृहमेधिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2017583, "chapter_id": 1364, "verse_number": "३-२-५४", "content_sanskrit": "तृणानि भूमिरुदकं वाक्चतुर्थी च सूनृता।\nसतामेतानि गेहेषु नोच्छिद्यन्ते कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2017584, "chapter_id": 1364, "verse_number": "३-२-५५", "content_sanskrit": "देयमार्तस्य शयनं स्थितश्रान्तस्य चासनम्।\nतृषितस्य च पानीयं क्षुधितस्य च भोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2017585, "chapter_id": 1364, "verse_number": "३-२-५६", "content_sanskrit": "चक्षुर्दद्यान्मनो दद्याद्वाचं दद्याच्च सूनृताम्।\nउत्थाय चासनं दद्यादेष धर्मः सनातनः।\nप्रत्युत्थायाभिगमनं कुर्यान्न्यायेन चार्चनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2017586, "chapter_id": 1364, "verse_number": "३-२-५७", "content_sanskrit": "अग्निहोत्रमनड्वांश्च ज्ञातयोऽतिथिवान्धवाः।\nपुत्रा दाराश्च भृत्याश्च निर्दहेयुरपूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2017587, "chapter_id": 1364, "verse_number": "३-२-५८", "content_sanskrit": "आत्मार्थं पाचयेन्नान्नं न वृथा घातयेत्पशून्।\nन चैकः स्वयमश्नीयाद्विधिवर्जं न निर्वपेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2017588, "chapter_id": 1364, "verse_number": "३-२-५९", "content_sanskrit": "श्वभ्यश्च श्वपचेभ्यश्च वयोभ्यश्चावपेद्भुवि।\nवैश्वदेवं हि नामैतत्सायं प्रातश्च दीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2017589, "chapter_id": 1364, "verse_number": "३-२-६०", "content_sanskrit": "विघसाशी भवेत्तस्मान्नित्यं चामृतभोजनः।\nविघसो भुक्तशेषं तु यज्ञशेषं तथाऽमृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2017590, "chapter_id": 1364, "verse_number": "३-२-६१", "content_sanskrit": "चक्षुर्दद्यान्मनो दद्याद्वाचं दद्याच्च सूनृताम्।\nअनुव्रजेदुपासीत स यज्ञः पञ्चदक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2017591, "chapter_id": 1364, "verse_number": "३-२-६२", "content_sanskrit": "यो दद्यादपरिक्लिष्टमन्नमद्वनि वर्तते।\nश्रान्तायादृष्टपूर्वाय तस्य पुण्यफलं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2017592, "chapter_id": 1364, "verse_number": "३-२-६३", "content_sanskrit": "एवं यो वर्तते वृत्तिं वर्तमानो गृहाश्रमे।\nतस्य धर्मं परंप्राहुः कथं वा विप्र मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2017593, "chapter_id": 1364, "verse_number": "३-२-६४x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2017594, "chapter_id": 1364, "verse_number": "३-२-६४", "content_sanskrit": "अहो बत महत्कष्टं विपरीतमिदं जगत्।\nयेनापत्रपते साधुरसाधुस्तेन तुष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2017595, "chapter_id": 1364, "verse_number": "३-२-६५", "content_sanskrit": "शिश्नोदरकृतेऽप्राज्ञः करोति विषसं बहु।\nमोहरागवशाक्रान्त इन्द्रियार्थवशानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2017596, "chapter_id": 1364, "verse_number": "३-२-६६", "content_sanskrit": "ह्रियते बुध्यमानोपि नरो हारिभिरिन्द्रियैः।\nविमूढसंज्ञो दुष्टाश्वैरुद्धान्तैरिव सारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2017597, "chapter_id": 1364, "verse_number": "३-२-६७", "content_sanskrit": "षडिन्द्रियाणि विषयं समागच्छन्ति वै यदा।\nतद्रा प्रादुर्भवत्यषां पूर्वसंकल्पजं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2017598, "chapter_id": 1364, "verse_number": "३-२-६८", "content_sanskrit": "मनो यस्येन्द्रियस्येह विषयान्याति सेवितुम्।\nवस्यौत्सुक्यं संभवति प्रवृत्तिश्चोपजायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2017599, "chapter_id": 1364, "verse_number": "३-२-६९", "content_sanskrit": "ततः संकल्पवीर्येण कामेन विषयेषुभिः।\nविद्धः पतति लोभाग्नौज्योतिर्लोभात्पतङ्गवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2017600, "chapter_id": 1364, "verse_number": "३-२-७०", "content_sanskrit": "ततो दारैर्विहारैश्च मोहितश्च यथेप्सया।\nमहामोहमुखे मग्नो नात्मानमवबुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2017601, "chapter_id": 1364, "verse_number": "३-२-७१", "content_sanskrit": "एवं पतति संसारे तासुतास्विह योनिषु।\nअविद्याकर्मतृष्णाभिर्भ्राम्यमाणोऽथ चक्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2017602, "chapter_id": 1364, "verse_number": "३-२-७२", "content_sanskrit": "ब्रह्मादिषु तृणान्तेषु भूतेषु परिवर्तते।\nजले भुवि तथाऽऽकाशे जायमानः पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2017603, "chapter_id": 1364, "verse_number": "३-२-७३", "content_sanskrit": "अबुधानां गतिस्त्वेषा बुधानामपि मे शृणु।\nये धर्मे श्रेयसि रता विमोक्षरतयो जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2017604, "chapter_id": 1364, "verse_number": "३-२-७४", "content_sanskrit": "तदिदं वेदवचनं कुरु कर्म त्यजेति च।\nतस्माद्धर्मानिमान्सर्वान्नाभिमानात्समाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2017605, "chapter_id": 1364, "verse_number": "३-२-७५", "content_sanskrit": "इज्याध्ययनदानानि तपः सत्यं क्षमा दमः।\nअलोभ इतिमार्गोऽयं धर्ममस्याष्टविधः स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2017606, "chapter_id": 1364, "verse_number": "३-२-७६", "content_sanskrit": "अत्र पूर्वश्चतुर्वर्गः पितृयाणपथे स्थितः।\nकर्तव्यमिति यत्कार्यं नाभिमानात्समाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2017607, "chapter_id": 1364, "verse_number": "३-२-७७", "content_sanskrit": "उत्तरो देवयानस्तु सद्भिराचरितः सदा।\nअष्टाङ्गेनैव मार्गेण विशुद्धात्मा समाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2017608, "chapter_id": 1364, "verse_number": "३-२-७८", "content_sanskrit": "सम्यक्संकल्पसंबन्धात्सम्यक्चेन्द्रियनिग्रहात्।\nसम्यग्द्व्रतविशेषाच्च सम्यक्च गुरुसेवनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2017609, "chapter_id": 1364, "verse_number": "३-२-७९", "content_sanskrit": "सम्यगाहारयोगाच्च सम्यक्चाध्ययनागमात्।\nसम्यक्कर्मोपसंन्यासात्सम्यक्चित्तनिरोधनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2017610, "chapter_id": 1364, "verse_number": "३-२-८०", "content_sanskrit": "एवं कर्माणि कुर्वन्ति संसारविजिगीषवः।\nरागद्वेषविनिर्मुक्ता ऐश्वर्यवशमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2017611, "chapter_id": 1364, "verse_number": "३-२-८१", "content_sanskrit": "रुद्राः साध्यास्तथाऽऽदित्या वसवोऽथ तथाश्विनौ।\nयोगैश्वर्येण संयुक्ता धारयन्ति प्रजा इमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2017612, "chapter_id": 1364, "verse_number": "३-२-८२", "content_sanskrit": "तथा त्वमपि कौन्तेय शममास्थाय पुष्कलम्।\nतपसा सिद्धिमन्विच्छ योगसिद्धिं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2017613, "chapter_id": 1364, "verse_number": "३-२-८३", "content_sanskrit": "पितृमातृमयी सिद्धिः प्राप्ता कर्ममयी च ते।\nतपसा सिद्धिमन्विच्छ द्विजानां भरणाय वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2017614, "chapter_id": 1364, "verse_number": "३-२-८४", "content_sanskrit": "सिद्धा हि यद्यदिच्छन्ति कुर्वते तदनुग्रहम्।\nतस्मात्तपः समास्थाय कुरुष्वात्ममनोरथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2017615, "chapter_id": 1364, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि किर्मीरवधपर्वणि द्वितीयोऽध्यायः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]