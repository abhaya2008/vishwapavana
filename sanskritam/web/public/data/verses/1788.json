[{"id": 2036183, "chapter_id": 1788, "verse_number": "५-३३-०x", "content_sanskrit": "वैशंपानय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2036184, "chapter_id": 1788, "verse_number": "५-३३-१", "content_sanskrit": "द्वाःस्थं प्राह महाप्राज्ञो धृतराष्ट्रो महीपतिः ।\nविदुरं द्रष्टुमिच्छामि तमिहानय मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2036185, "chapter_id": 1788, "verse_number": "५-३३-२", "content_sanskrit": "प्रहितो धृतराष्ट्रेण दूतः क्षत्तारमब्रवीत् ।\nईश्वरस्त्वां महाराजो महाप्राज्ञ दिदृक्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2036186, "chapter_id": 1788, "verse_number": "५-३३-३", "content_sanskrit": "एवमुक्तस्तु विदुरः प्राप्य राजनिवेशनम् ।\nअब्रवीद्धृतराष्ट्राय द्वाःस्थं मां प्रतिवेदय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2036187, "chapter_id": 1788, "verse_number": "५-३३-४x", "content_sanskrit": "द्वाःस्थ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2036188, "chapter_id": 1788, "verse_number": "५-३३-४", "content_sanskrit": "विदुरोऽयमनुप्राप्तो राजेन्द्र तव शासनात्।\nद्रुष्टुमिच्छति ते पादौ किं करोतु प्रशाधि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2036189, "chapter_id": 1788, "verse_number": "५-३३-५x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2036190, "chapter_id": 1788, "verse_number": "५-३३-५", "content_sanskrit": "प्रवेशय महाप्रज्ञं विदुरं दीर्घदर्शिनम् ।\nअहं हि विदुरस्यास्य नाकल्पो जातु दर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2036191, "chapter_id": 1788, "verse_number": "५-३३-६x", "content_sanskrit": "द्वाःस्थ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2036192, "chapter_id": 1788, "verse_number": "५-३३-६", "content_sanskrit": "प्रविशान्तःपुरं क्षत्तर्महारादजस्य धीमतः।\nन हि ते दर्शनेऽकल्पो जातु राजाऽब्रवीद्धि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2036193, "chapter_id": 1788, "verse_number": "५-३३-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2036194, "chapter_id": 1788, "verse_number": "५-३३-७", "content_sanskrit": "ततः प्रविश्य विदुरो धृतराष्ट्रनिवेशनम् ।\nअब्रवीत्प्राञ्जलिर्वाक्यं चिन्तयानं नराधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2036195, "chapter_id": 1788, "verse_number": "५-३३-८", "content_sanskrit": "विदुरोऽहं महाप्राज्ञ संप्राप्तस्तव शासनात्।\nयदि किंचन कर्तव्यमयमस्मि प्रशाधि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2036196, "chapter_id": 1788, "verse_number": "५-३३-९x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2036197, "chapter_id": 1788, "verse_number": "५-३३-९", "content_sanskrit": "सञ्जयो विदुर प्राप्तो गर्हयित्वा च मां गतः।\nअजातशत्रोः श्वो वाक्यं सभामध्ये स वक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2036198, "chapter_id": 1788, "verse_number": "५-३३-१०", "content_sanskrit": "तस्याद्य कुरुवीरस्य न विज्ञातं वचो मया।\nतन्मे दहति गात्राणि तदकार्षीत्प्रजागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2036199, "chapter_id": 1788, "verse_number": "५-३३-११", "content_sanskrit": "आग्रतो दह्यमानस्य श्रेयो यदनुपश्यसि।\nतद्ब्रूहि त्वं हि नस्तात धर्मार्थकुशलो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2036200, "chapter_id": 1788, "verse_number": "५-३३-१२", "content_sanskrit": "यतः प्राप्तः सञ्जयः पाण्डवेभ्यो\nन मे यथावन्मनसः प्रशान्तिः ।\nसर्वेन्द्रियाण्यप्रकृतिं गतानि\nकिं वक्ष्यतीत्येव मेऽद्य प्रचिन्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2036201, "chapter_id": 1788, "verse_number": "५-३३-१३", "content_sanskrit": "` तन्मे ब्रूहि विदुर त्वं यथाव-\nन्मनीषितं सर्वमजातशत्रोः ।\nयथा न नस्तात हितं भवेच्च\nप्रजाश्च सर्वाः सुखिता भवेयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2036202, "chapter_id": 1788, "verse_number": "५-३३-१४x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2036203, "chapter_id": 1788, "verse_number": "५-३३-१४", "content_sanskrit": "अभियुक्तं बलवता दुर्बलं हीनसाधनम् ।\nहृतस्वं कामिनं चोरमाविशन्ति प्रजागराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2036204, "chapter_id": 1788, "verse_number": "५-३३-१५", "content_sanskrit": "कच्चिदेतैर्महादोषैर्न स्पृष्टोऽसि नराधिप।\nकच्चिच्च परवित्तेषु गृद्ध्यन्न परितप्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2036205, "chapter_id": 1788, "verse_number": "५-३३-१६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2036206, "chapter_id": 1788, "verse_number": "५-३३-१६", "content_sanskrit": "श्रोतुमिच्छामि ते धर्म्यं परं नैश्रेयसं वचः।\nअस्मिन्रादर्षिवंशे हि त्वमेकः प्राज्ञसंमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2036207, "chapter_id": 1788, "verse_number": "५-३३-१७x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2036208, "chapter_id": 1788, "verse_number": "५-३३-१७", "content_sanskrit": "राजा लक्षणसंपन्नस्त्रैलोक्यस्याधिपो भवेत्।\nप्रेष्यस्ते प्रेषितश्चैव धृतराष्ट्र युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2036209, "chapter_id": 1788, "verse_number": "५-३३-१८", "content_sanskrit": "विपरीततरश्च त्वं भागधेये न संमतः।\nअर्चिषां प्रक्षयाच्चैव धर्मात्मा धर्मकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2036210, "chapter_id": 1788, "verse_number": "५-३३-१९", "content_sanskrit": "आनृशंस्यादनुक्रोशाद्धर्मात्सत्यात्पराक्रमात्।\nगुरुत्वात्त्वयि संप्रेक्ष्य बहून्क्लेशांस्तितिक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2036211, "chapter_id": 1788, "verse_number": "५-३३-२०", "content_sanskrit": "दुर्योधने सौबले च कर्णे दुःशासने तथा।\nएतेष्वैश्वर्यमाधाय कथं त्वं भूतिमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2036212, "chapter_id": 1788, "verse_number": "५-३३-२१", "content_sanskrit": "आत्मज्ञानं समारम्भस्तितिक्षा धर्मनित्यता।\nयमर्थान्नापकर्षन्ति स वै पण्डित उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2036213, "chapter_id": 1788, "verse_number": "५-३३-२२", "content_sanskrit": "` एकस्माद्वृक्षाद्यज्ञपात्राणि राज-\nन्स्रुक्व द्रोणी पेठनीपीडने च।\nएतस्माद्राजन्ब्रुवतो मे निबोध\nएकस्माद्वै जायतेऽसच्च सच्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2036214, "chapter_id": 1788, "verse_number": "५-३३-२३", "content_sanskrit": "निषेवते प्रशस्तानि निन्दितानि न सेवते।\nअनास्तिकः श्रद्दधान एतत्पण्डितलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2036215, "chapter_id": 1788, "verse_number": "५-३३-२४", "content_sanskrit": "क्रोधो हर्षश्च दर्पश्च ह्रीः स्तम्भो मान्यमानिता।\nयमर्थान्नापकर्षन्ति स वै पण्डित उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2036216, "chapter_id": 1788, "verse_number": "५-३३-२५", "content_sanskrit": "यस्य कृत्यं न जानन्ति मन्त्रं वा मन्त्रितं परे।\nकृतमेवास्य जानन्ति स वै पण्डित उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2036217, "chapter_id": 1788, "verse_number": "५-३३-२६", "content_sanskrit": "यस्य कृत्यं न विघ्नन्ति शीतमुष्णं भयं रतिः।\nसमृद्धिरसमृद्धिर्वा स वै पण्डित उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2036218, "chapter_id": 1788, "verse_number": "५-३३-२७", "content_sanskrit": "यस्य संसारिणी प्रज्ञा धर्मार्थावनुवर्तते।\nकामादर्थं वृणीते यः स वै पण्डित उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2036219, "chapter_id": 1788, "verse_number": "५-३३-२८", "content_sanskrit": "यथाशक्ति चिकीर्षन्ति यथाशक्ति च कुर्वते।\nकिंचिदवमन्यन्ते नराः पण्डितबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2036220, "chapter_id": 1788, "verse_number": "५-३३-२९", "content_sanskrit": "क्षिप्रं विजानाति चिरं श्रृणोति\nविज्ञाय चार्यं भजते न कामात्।\nनासंपृष्टो व्युपयुङ्क्ते परार्थे\nतत्प्रज्ञानं प्रथमं पण्डितस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2036221, "chapter_id": 1788, "verse_number": "५-३३-३०", "content_sanskrit": "नाप्राप्यमभिवाञ्छन्ति नष्टं नेच्छन्ति शोचितुम्।\nआपत्सु च न मुह्यन्ति नराः पण्डितबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2036222, "chapter_id": 1788, "verse_number": "५-३३-३१", "content_sanskrit": "निश्चित्य यः प्रक्रमते नान्तर्वसति कर्मणः।\nअवन्ध्यकालो वश्यात्मा स वै पण्डित उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2036223, "chapter_id": 1788, "verse_number": "५-३३-३२", "content_sanskrit": "आर्यकर्मणि रज्यन्ते भूतिकर्माणि कुर्वते\nहितं च नाभ्यसूयन्ति पण्डिता भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2036224, "chapter_id": 1788, "verse_number": "५-३३-३३", "content_sanskrit": "न हृष्यत्यात्मसंमाने नावमानेन तप्यते।\nगाङ्गो ह्रद इवाक्षोभ्यो यः स पण्डित उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2036225, "chapter_id": 1788, "verse_number": "५-३३-३४", "content_sanskrit": "तत्त्वज्ञः सर्वभूतानां योगज्ञः सर्वकर्मणाम्।\nउपायज्ञो मनुष्याणां नरः पण्डित उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2036226, "chapter_id": 1788, "verse_number": "५-३३-३५", "content_sanskrit": "प्रवृत्तवाक् चित्रकथ ऊहवान्प्रतिभानवान्।\nआशु ग्रन्थस्य वक्ता च यः स पण्डित उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2036227, "chapter_id": 1788, "verse_number": "५-३३-३६", "content_sanskrit": "श्रुतं प्रज्ञानुगं यस्य प्रज्ञा चैव श्रुतानुगा ।\nअसंभिन्नार्यमर्यादः पण्डिताख्यां लभेत सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2036228, "chapter_id": 1788, "verse_number": "५-३३-३७", "content_sanskrit": "` अर्थं महान्तमासाद्य विद्यामेश्वर्यमेव च।\nविचरत्यसमुन्नद्धो यः स पण्डित उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2036229, "chapter_id": 1788, "verse_number": "५-३३-३८", "content_sanskrit": "अश्रुतश्च समुन्नद्धो दरिद्रश्च महामनाः ।\nअर्थांश्चाकर्मणा प्रेप्सुर्मूढ इत्युच्यते बुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2036230, "chapter_id": 1788, "verse_number": "५-३३-३९", "content_sanskrit": "स्वमर्थं यः परित्यज्य परार्थमनुतिष्ठति।\nमिथ्या चरति मित्रार्थे यश्च मूढः स उच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2036231, "chapter_id": 1788, "verse_number": "५-३३-४०", "content_sanskrit": "अकामान्कामयति यः कामयानान्परित्यजेत्।\nबलवन्तं च यो द्वेष्टि तमाहुर्मूढचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2036232, "chapter_id": 1788, "verse_number": "५-३३-४१", "content_sanskrit": "अमित्रं कुरुते मित्रं मित्रं द्वेष्टि हिनस्ति च ।\nकर्म चारभते दुष्टं तमाहुर्मूढचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2036233, "chapter_id": 1788, "verse_number": "५-३३-४२", "content_sanskrit": "संसारयति कृत्यानि सर्वत्र विचिकित्सते।\nचिरं करोति क्षिप्रार्थे स मूढो भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2036234, "chapter_id": 1788, "verse_number": "५-३३-४३", "content_sanskrit": "श्राद्धं पितृभ्यो न ददाति दैवतानि न चार्चति ।\nसुहृन्मित्रं न लभते तमाहुर्मूढचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2036235, "chapter_id": 1788, "verse_number": "५-३३-४४", "content_sanskrit": "अनाहूतः प्रविशति अपृष्टो बहु भाषते।\nअविश्वस्ते विश्वसिति मूढचेता नराधमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2036236, "chapter_id": 1788, "verse_number": "५-३३-४५", "content_sanskrit": "परं क्षिपति दोषेण वर्तमानः स्वयं तथा।\nयश्च क्रुध्यत्यनीशानः स च मूढतमो नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2036237, "chapter_id": 1788, "verse_number": "५-३३-४६", "content_sanskrit": "आत्मनो बलमाज्ञाय धर्मार्थपरिवर्जितम्।\nअलभ्यमिच्छन्नैष्कर्म्यान्मूढबुद्धिरिहोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2036238, "chapter_id": 1788, "verse_number": "५-३३-४७", "content_sanskrit": "अशिष्यं शास्ति यो राजन्यश्च शिष्यं न शास्ति च ।\nकदर्यं भजते यश्च तमाहुर्मूढचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2036239, "chapter_id": 1788, "verse_number": "५-३३-४८", "content_sanskrit": "एकः संपन्नमाश्नाति वस्ते वासश्च शोभनम् ।\nयोऽसंविभज्य भृत्येभ्यः को नृशंसतरस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2036240, "chapter_id": 1788, "verse_number": "५-३३-४९", "content_sanskrit": "एकः पापानि कुरुते फलं भुङ्क्ते महाजनः।\nभोक्तारो विप्रमुच्यन्ते कर्ता दोषेण लिप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2036241, "chapter_id": 1788, "verse_number": "५-३३-५०", "content_sanskrit": "एकं हन्यान्न वा हन्यादिषुर्मुक्तो धनुष्मता।\nबुद्धिर्बुद्धिमतोत्सृष्टा हन्याद्राष्ट्रं सराजकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2036242, "chapter_id": 1788, "verse_number": "५-३३-५१", "content_sanskrit": "एकया द्वे विनिश्चित्य त्रींश्चतुर्भिर्वशे कुरु।\nपञ्च जित्वा विदित्वा षट् सप्त हित्वा सुखी भवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2036243, "chapter_id": 1788, "verse_number": "५-३३-५२", "content_sanskrit": "एकं विषरसो हन्ति शस्त्रेणैकश्च वध्यते।\nसराष्ट्रं सप्रजं हन्ति राजानं मन्त्रपिप्लवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2036244, "chapter_id": 1788, "verse_number": "५-३३-५३", "content_sanskrit": "एकः स्वादु न भुञ्जीत एकश्चार्थान्न चिन्तयेत्।\nएको न गच्छेदध्वानं नैकः सुप्तेषु जागृयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2036245, "chapter_id": 1788, "verse_number": "५-३३-५४", "content_sanskrit": "एकमेवाद्वितीयं तद्यद्राजन्नावबुध्यसे।\nसत्यं स्वगस्य सोपानं पारावारस्य नौरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2036246, "chapter_id": 1788, "verse_number": "५-३३-५५", "content_sanskrit": "एकः क्षमावतां दोषो द्वितीयो नोपपद्यते।\nयदेनं क्षमया युक्तमशक्तं मन्यते जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2036247, "chapter_id": 1788, "verse_number": "५-३३-५६", "content_sanskrit": "सोऽस्य दोषो न मन्तव्यः क्षमा हि परमं बलम्।\nक्षमा गुणो ह्यशक्तानां शक्तानां भूषणं क्षमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2036248, "chapter_id": 1788, "verse_number": "५-३३-५७", "content_sanskrit": "क्षमा वशीकृतीर्लोके क्षमया किं न साध्यते।\nशान्तिखङ्गः करे यस्य किं करिष्यति दुर्जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2036249, "chapter_id": 1788, "verse_number": "५-३३-५८", "content_sanskrit": "अतृणे पतितो वह्निः स्वयमेवोपशाम्यति।\nअक्षमावान्परं दोषैरात्मानं चैव योजयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2036250, "chapter_id": 1788, "verse_number": "५-३३-५९", "content_sanskrit": "एको धर्मः परं श्रेयः क्षमैका शान्तिरुत्तमा ।\nविद्यैका परमा तृप्तिरहिंसैका सुखावहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2036251, "chapter_id": 1788, "verse_number": "५-३३-६०", "content_sanskrit": "द्वाविमौ ग्रसते भूमिः सर्पो बलिशयानिव।\nराजानं चाविरोद्धारं ब्राह्मणं चाप्रवासिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2036252, "chapter_id": 1788, "verse_number": "५-३३-६१", "content_sanskrit": "द्वे कर्मणी नरः कुर्वन्नस्मिँल्लोके विरोचते ।\nअब्रुवन्परुषं किंचिदसतोऽनर्चयंस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2036253, "chapter_id": 1788, "verse_number": "५-३३-६२", "content_sanskrit": "द्वाविमौ पुरुषव्याघ्र परप्रत्ययकारिणौ ।\nस्त्रियः कामितकामिन्यो मूर्खाः पूजितपूजकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2036254, "chapter_id": 1788, "verse_number": "५-३३-६३", "content_sanskrit": "द्वाविमौ कण्टकौ तीक्ष्णौ शरीरपरिशोषिणौ।\nयश्चाधनः कामयते यश्च कुप्यत्यनीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2036255, "chapter_id": 1788, "verse_number": "५-३३-६४", "content_sanskrit": "द्वावेव न विराजेते विपरीतेन कर्मणा ।\nगृहस्थश्च निरारम्भः कार्यवांश्चैव भिक्षुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2036256, "chapter_id": 1788, "verse_number": "५-३३-६५", "content_sanskrit": "द्वाविमौ पुरुषौ राजन्स्वर्गस्योपरि तिष्ठतः।\nप्रभुश्च क्षमया युक्तो दरिद्रश्च प्रदानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2036257, "chapter_id": 1788, "verse_number": "५-३३-६६", "content_sanskrit": "न्यायागतस्य द्रव्यस्य बोद्धव्यौ द्वावतिक्रमौ ।\nअपात्रे प्रतिपत्तिश्च पात्रे चात्प्रतिपादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2036258, "chapter_id": 1788, "verse_number": "५-३३-६७", "content_sanskrit": "द्वावभ्यसि निवेष्टव्यौ गले बध्वा दृढां शिलाम् ।\nधनवन्तमदातारं दरिद्रं चातपस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2036259, "chapter_id": 1788, "verse_number": "५-३३-६८", "content_sanskrit": "द्वाविमौ पुरुषव्याघ्र सूर्यमण्डलभेदिनौ।\nपरिव्राड्योगयुक्तश्च रणे चाभिमुखो हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2036260, "chapter_id": 1788, "verse_number": "५-३३-६९", "content_sanskrit": "त्रयो न्याया मनुष्याणां श्रूयन्ते भरतर्षभ ।\nकनीयान्मध्यमः श्रेष्ठ इति वेदविदो विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2036261, "chapter_id": 1788, "verse_number": "५-३३-७०", "content_sanskrit": "त्रिविधाः पुरुषा राजन्नुत्तमाधममध्यमाः ।\nनियोजयेद्यथावत्तांस्त्रिविधेष्वेव कर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2036262, "chapter_id": 1788, "verse_number": "५-३३-७१", "content_sanskrit": "त्रय एवाधना राजन्भार्या दासस्तथा सुतः।\nयत्ते समधिगच्छन्ति यस्यैते तस्य तद्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2036263, "chapter_id": 1788, "verse_number": "५-३३-७२", "content_sanskrit": "हरणं च परस्वानां परदाराभिमर्शनम् ।\nसुहृदश्च परित्यागस्त्रयो दोषाः क्षयावहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2036264, "chapter_id": 1788, "verse_number": "५-३३-७३", "content_sanskrit": "त्रिविधं नरकस्येदं द्वारं नाशनमात्मनः ।\nकामः क्रोधस्तथा लोभस्तस्मादेतत्रयं त्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2036265, "chapter_id": 1788, "verse_number": "५-३३-७४", "content_sanskrit": "वरप्रदानं राज्यं च पुत्रजन्म च भारत।\nशत्रोश्च मोक्षणं कृच्छ्रात्रीणि चैकं च तत्समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2036266, "chapter_id": 1788, "verse_number": "५-३३-७५", "content_sanskrit": "भक्तं च भजमानं च तवास्मीति च वादिनम् ।\nत्रीनेताञ्छरणं प्राप्तान्विषमेऽपि कन सन्त्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2036267, "chapter_id": 1788, "verse_number": "५-३३-७६", "content_sanskrit": "चत्वारि राज्ञा तु महाबलेन\nवर्ज्यान्याहुः पण्डितस्तानि विद्यात्।\nअल्पप्रज्ञैः सह मन्त्रं न कुर्या-\nन्न दीर्घसूत्रैरलसैश्चारणैश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2036268, "chapter_id": 1788, "verse_number": "५-३३-७७", "content_sanskrit": "चतवारि ते तात गृहे वसन्तु\nश्रियाऽभिजुष्टस्य गृहस्थधर्मे।\nवृद्धो ज्ञातिरवसन्नः कुलीनः\nसखा दरिद्रो भगिनी चानपत्या ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2036269, "chapter_id": 1788, "verse_number": "५-३३-७८", "content_sanskrit": "चत्वार्याह महाराज साद्यस्कानि बृहस्पतिः।\nपृच्छते त्रिदशेन्द्राय तानीमानि निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2036270, "chapter_id": 1788, "verse_number": "५-३३-७९", "content_sanskrit": "देवतानां च सङ्कल्पमनुभावं च धीमताम्।\nविनयं कृतविद्यानां विनाशं पापकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2036271, "chapter_id": 1788, "verse_number": "५-३३-८०", "content_sanskrit": "चत्वारि कर्माण्यभयंकराणि\nभयं प्रयच्छन्त्ययथाकृतानि ।\nमानाग्निहोत्रमुत मानमौनं\nमानेनाधीतमुत मानयज्ञः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2036272, "chapter_id": 1788, "verse_number": "५-३३-८१", "content_sanskrit": "पञ्चाग्नयो मनुष्येण परिचर्याः प्रयत्नतः।\nपिता माताग्निरात्मा च गुरुश्च भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2036273, "chapter_id": 1788, "verse_number": "५-३३-८२", "content_sanskrit": "पञ्चैव पूजयँल्लोके यशः प्राप्नोति केवलम्।\nदेवान्पितॄन्मनुष्यांश्च भिक्षूनतिथिपञ्चमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2036274, "chapter_id": 1788, "verse_number": "५-३३-८३", "content_sanskrit": "पञ्च त्वाऽनुगमिष्यन्ति यत्र यत्र गमिष्यसि।\nमित्राण्यमित्रा मध्यस्था उपजीव्योपजीविनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2036275, "chapter_id": 1788, "verse_number": "५-३३-८४", "content_sanskrit": "पञ्चेन्द्रियस्य मर्त्यस्य छिद्रं चेदेकमिन्द्रियम्।\nततोऽस्य स्रवति प्रज्ञा दृतेः पात्रादिवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2036276, "chapter_id": 1788, "verse_number": "५-३३-८५", "content_sanskrit": "षड्दोषाः पुरुषेणेह हातव्या भूतिमिच्छता।\nनिद्रा तन्द्री भयं क्रोध आलस्यं दीर्घसूत्रता ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2036277, "chapter_id": 1788, "verse_number": "५-३३-८६", "content_sanskrit": "षडिमान्पुरुषो जह्याद्भिन्नां नावमिवार्णवे।\nअप्रवक्तारमाचार्यमनधीयानमृत्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2036278, "chapter_id": 1788, "verse_number": "५-३३-८७", "content_sanskrit": "अरक्षितारं राजानं भार्यां चाप्रियवादिनीम् ।\nग्रामकामं च गोपालं वनकामं च नापितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2036279, "chapter_id": 1788, "verse_number": "५-३३-८८", "content_sanskrit": "षडेव तु गुणाः पुंसा न हातव्याः कदाचन।\nसत्यं दानमनालस्यमनसूया क्षमा धृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2036280, "chapter_id": 1788, "verse_number": "५-३३-८९", "content_sanskrit": "अर्थागमो नित्यमरोगिता च\nप्रिया च भार्या प्रियवादिनी च।\nवश्यश्च पुत्रोऽर्थकरी च विद्या\nषड्जीवलोकस्य सुखानि राजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2036281, "chapter_id": 1788, "verse_number": "५-३३-९०", "content_sanskrit": "षण्णामात्मनि नित्यानामैश्वर्यं योऽधिगच्छति।\nन स पापैः कुतोऽनर्थैर्युज्यते विजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2036282, "chapter_id": 1788, "verse_number": "५-३३-९१", "content_sanskrit": "षडिमे षट्सु जीवन्ति सप्तमो नोपलभ्यते।\nचोराः प्रमत्ते जीवन्ति व्याधितेषु चिकित्सकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2036283, "chapter_id": 1788, "verse_number": "५-३३-९२", "content_sanskrit": "प्रमदाः कामयानेषु यजमानेषु याजकाः ।\nराजा विवदमानेषु नित्यं मूर्खेषु पण्डिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2036284, "chapter_id": 1788, "verse_number": "५-३३-९३", "content_sanskrit": "षडिमानि विनश्यन्ति मुहूर्तमनवेक्षणात्।\nगावः सेवा कृषिर्भार्या विद्या वृषलसङ्गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2036285, "chapter_id": 1788, "verse_number": "५-३३-९४", "content_sanskrit": "षडेते ह्यवमन्यन्ते नित्यं पूर्वोपकारिणम् ।\nआचार्यं शिक्षिताः शिष्याः कृतदाराश्च मातरं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2036286, "chapter_id": 1788, "verse_number": "५-३३-९५", "content_sanskrit": "नारीं विगतकामास्तु कृतार्थाश्च प्रयोजकम् ।\nनावं निस्तीर्णकान्तारा नातुराश्च चिकित्सकं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2036287, "chapter_id": 1788, "verse_number": "५-३३-९६", "content_sanskrit": "आरोग्यमानृण्यमविप्रवासः\nसद्भिर्मनुष्यैः सह संप्रयोगः।\nस्वप्रत्यया वृत्तिरभीतवासः\nषट् जीवलोकस्य सुखानि राजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2036288, "chapter_id": 1788, "verse_number": "५-३३-९७", "content_sanskrit": "ईर्षुर्धृणी नसन्तुष्टः क्रोधनो नित्यशङ्कितः।\nपरभाग्योपजीवी च षडेते नित्यदुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2036289, "chapter_id": 1788, "verse_number": "५-३३-९८", "content_sanskrit": "सप्त दोषाः सदा राज्ञा हातव्या व्यसनोदयाः।\nप्रायशो यैर्विनश्यन्ति कृतमूला अपीश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2036290, "chapter_id": 1788, "verse_number": "५-३३-९९", "content_sanskrit": "स्त्रियोऽक्षा मृगया पानं वाक्पारुष्यं च पञ्चमम्।\nमहच्च दण्डपारुष्यमर्थदूषणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2036291, "chapter_id": 1788, "verse_number": "५-३३-१००", "content_sanskrit": "अष्टौ पूर्वनिमित्तानि नरस्य विनशिष्यतः।\nब्राह्मणान्प्रथमं द्वेष्टि ब्राह्मणैश्च विरुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2036292, "chapter_id": 1788, "verse_number": "५-३३-१०१", "content_sanskrit": "ब्राह्मणस्वानि चादत्ते ब्राह्मणांश्च जिघांसति।\nरमते निन्दया चैषां प्रशंसां नाभिनन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2036293, "chapter_id": 1788, "verse_number": "५-३३-१०२", "content_sanskrit": "नैनान्स्मरति कृत्येषु याचितश्चाभ्यसूयति।\nएतान्दोषान्नरः प्राज्ञो बुद्ध्या बुध्वा विसर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2036294, "chapter_id": 1788, "verse_number": "५-३३-१०३", "content_sanskrit": "अष्टाविमानि हर्षस्य नवनीतानि भारत।\nवर्तमानानि दृश्यन्ते तान्येव स्वसुखान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2036295, "chapter_id": 1788, "verse_number": "५-३३-१०४", "content_sanskrit": "समागमश्च सखिभिर्महांश्चैव धनागमः ।\nपुत्रेण च परिष्वङ्गः सन्निपातश्च मैथुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2036296, "chapter_id": 1788, "verse_number": "५-३३-१०५", "content_sanskrit": "समये च प्रियालापः स्वयूथ्येषु समुन्नतिः ।\nअभिप्रेतस्य लाभश्च पूजा च जनसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2036297, "chapter_id": 1788, "verse_number": "५-३३-१०६", "content_sanskrit": "अष्टौ गुमाः पुरुषं दीपयन्ति\nप्रज्ञा च कौल्यं च दमः श्रुतं च।\nपराक्रमश्चाबहुभाषिता च\nदानं यथाशक्ति कृतज्ञता च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2036298, "chapter_id": 1788, "verse_number": "५-३३-१०७", "content_sanskrit": "नवद्वारमिदं वेश्म त्रिस्थूणं पञ्चसाक्षिकम्।\nक्षेत्रज्ञाधिष्ठितं विद्वान्यो वेद स परः कविः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2036299, "chapter_id": 1788, "verse_number": "५-३३-१०८", "content_sanskrit": "दश धर्मं न जानन्ति धृतराष्ट्र निबोध तान्।\nमत्तः प्रमत्त उन्मत्तः श्रान्तः क्रुद्धो बुभुक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2036300, "chapter_id": 1788, "verse_number": "५-३३-१०९", "content_sanskrit": "त्वरमाणश्च लुब्धश्च भीतः कामी च ते दश।\nतस्मादेतेषु भावेषु न प्रसञ्जेत पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2036301, "chapter_id": 1788, "verse_number": "५-३३-११०", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nपुत्रार्थमसुरेन्द्रेण गीतं चैव सुधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2036302, "chapter_id": 1788, "verse_number": "५-३३-१११", "content_sanskrit": "यः काममन्यू प्रजहाति राजा\nपात्रे प्रतिष्ठापयते धनं च।\nविशेषविच्छ्रुतवान्क्षिप्रकारी\nतं सर्वलोकः कुरुते प्रमाणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2036303, "chapter_id": 1788, "verse_number": "५-३३-११२", "content_sanskrit": "जानाति विश्वासयितुं मनुष्यान्\nविज्ञातदोषेषु दधाति दण्डम्।\nजानाति मात्रां च तथा क्षमां च\nतं तादृशं श्रीर्जुषते समग्रा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2036304, "chapter_id": 1788, "verse_number": "५-३३-११३", "content_sanskrit": "सुदुर्बलं नावजानाति कंचि-\nद्युक्तो रिपुं सेवते बुद्धिपूर्वम्।\nन विग्रहं रोचयते बलस्थैः\nकाले च यो विक्रमते स धीरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2036305, "chapter_id": 1788, "verse_number": "५-३३-११४", "content_sanskrit": "प्राप्याप.. न व्यथते कदाचि-\nदुद्योगमान्वच्छति चाप्रमत्तः ।\nदुःखं च काले सहते महात्मा\nधुरन्धरस्तस्य जिताः सपत्नाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2036306, "chapter_id": 1788, "verse_number": "५-३३-११५", "content_sanskrit": "अनर्थकं विप्रवासं गृहेभ्यः\nपापैः सन्धिं परदाराभिमर्शम्।\nदम्भं स्तैन्यं पैशुनं मद्यमानं\nन सेवते यः स सुखी सदैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2036307, "chapter_id": 1788, "verse_number": "५-३३-११६", "content_sanskrit": "न संरम्भेणारभते त्रिवर्ग-\nमाकारितः शंसति तत्त्वमेव।\nन मित्रार्थे रोचयते विवादं\nनापूजितः कुप्यति चाप्यमूढः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2036308, "chapter_id": 1788, "verse_number": "५-३३-११७", "content_sanskrit": "न योऽभ्यसूयत्सयनुकम्पते च\nन दुर्बलः प्रातिभाव्यं करोति।\nनात्याह किंचित्क्षमते विवादं\nसर्वत्र तादृग्लभते प्रशंसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2036309, "chapter_id": 1788, "verse_number": "५-३३-११८", "content_sanskrit": "यो नोद्धतं कुरुते जातु वेषं\nन पौरुषेणापि विकत्थतेऽन्यान्।\nन मूर्च्छितः कटुकान्याह किंचि-\nत्प्रियं सदा तं कुरुते जनो हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2036310, "chapter_id": 1788, "verse_number": "५-३३-११९", "content_sanskrit": "न वैरमुद्दिपयति प्रशान्तं\nन दर्पमारोहति शान्तिमेति।\nन दुर्गतोऽस्मीति करोत्यकार्यं\nतमार्यशीलं परमाहुरार्याः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2036311, "chapter_id": 1788, "verse_number": "५-३३-१२०", "content_sanskrit": "न स्वे सुखे वै कुरुते प्रहर्षं\nनान्यस्य दुःखे भवति प्रहृष्टः।\nदत्त्वा न पश्चात्कुरुतेऽनुतापं\nस कथ्यते सत्पुरुषार्यशीलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2036312, "chapter_id": 1788, "verse_number": "५-३३-१२१", "content_sanskrit": "देशाचारान्समयाञ्जातिधर्मान्\nबुभूषते यः स परावरज्ञः।\nस यत्र तत्राभिगतः सदैव\nमहाजनस्याधिपत्यं करोति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2036313, "chapter_id": 1788, "verse_number": "५-३३-१२२", "content_sanskrit": "दम्भं मोहं मत्सरं पापकृत्यं\nराजद्विष्टं पैशुनं पूगवैरम्।\nमत्तोन्मत्तैर्दुर्जनैश्चापि वादं\nयः प्रज्ञावान्वर्जयेत्स प्रधानः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2036314, "chapter_id": 1788, "verse_number": "५-३३-१२३", "content_sanskrit": "दमं शौचं दैविकं मङ्गलानि\nप्रायश्चित्तान्विविधाँल्लोकवादान्।\nएतानि यः कुरुते नैत्यकानि\nतस्योत्थानं देवता राधयन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2036315, "chapter_id": 1788, "verse_number": "५-३३-१२४", "content_sanskrit": "समैर्विवाहं कुरुते न हीनैः\nसमैः सख्यं व्यवहारं कथां च।\nगुणैर्विशिष्टांश्च पुरो दधाति\nविपश्चितस्तस्य नयाः सुनीताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2036316, "chapter_id": 1788, "verse_number": "५-३३-१२५", "content_sanskrit": "मितं भुङ्क्ते संविभज्याश्रितेभ्यो\nमितं स्वपित्यमितं कर्म कृत्वा।\nददात्यमित्रेष्वपि याचितः सं-\nस्तमात्मवन्तं प्रजहत्यनर्थाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2036317, "chapter_id": 1788, "verse_number": "५-३३-१२६", "content_sanskrit": "चिकीर्षितं विप्रकृतं च यस्य\nनान्ये जनाः कर्म जानन्ति किंचित्।\nमन्त्रे गुप्ते सम्यगनुष्ठिते च\nनाल्पोऽप्यस्य च्यवते कश्चिदर्थः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2036318, "chapter_id": 1788, "verse_number": "५-३३-१२७", "content_sanskrit": "यः सर्वभूतप्रशमे निविष्टः\nसत्यो मृदुर्मानकृच्छुद्धभावः\nअतीव स ज्ञायते ज्ञातिमध्ये\nमहामणिर्जात्य इव सप्रन्नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2036319, "chapter_id": 1788, "verse_number": "५-३३-१२८", "content_sanskrit": "य आत्मनाऽपत्रपते भृशं नरः\nस सर्वलोकस्य गुरुर्भवत्युत\nअनन्तजेजाः सुमनाः समाहितः\nस तेजसा सूर्य इवावभासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2036320, "chapter_id": 1788, "verse_number": "५-३३-१२९", "content_sanskrit": "वने जाताः शापदग्धस्य राज्ञः\nपाण्डोः पुत्राः पञ्च पञ्चेन्द्रकल्पाः ।\nत्वयैव बाला वर्धिताः शिक्षिताश्च\nतवादेशं पालयन्त्याम्बिकेय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2036321, "chapter_id": 1788, "verse_number": "५-३३-१३०", "content_sanskrit": "प्रदायैषामुचितं तातराज्यं\nसुखी पुत्रैः सहितो मोदमानः ।\nन देवानां नापि च मानुषाणां\nभविष्यसि त्वं गर्हणीयो नरेन्द्र ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2036322, "chapter_id": 1788, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि प्रजागरपर्वणि त्रयस्त्रिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}]