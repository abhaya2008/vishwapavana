[{"id": 2198628, "chapter_id": 5225, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198629, "chapter_id": 5225, "verse_number": "१", "content_sanskrit": "प्राचेतसस्य वचनं कीर्तयन्ति पुराविदः ।\nयस्याः किञ्चिन्नाददते ज्ञातयो न स विक्रयः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198630, "chapter_id": 5225, "verse_number": "२", "content_sanskrit": "अर्हणं तत्कुमारीणामानृशंस्यतमं च तत् ।\nसर्वं च प्रतिदेयं स्यात् कन्यायै तदशेषतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198631, "chapter_id": 5225, "verse_number": "३", "content_sanskrit": "पितृभिर्भ्रातृभिश्चैव श्वशुरैरथ देवरैः ।\nपूज्या लालयितव्याश्च बहुकल्याणमीप्सुभिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198632, "chapter_id": 5225, "verse_number": "४", "content_sanskrit": "यदि वै स्त्री न रोचेत पुमांसं न प्रमोदयेत् ।\nअमोदनात् पुनः पुंसः प्रजनं न प्रवर्धते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198633, "chapter_id": 5225, "verse_number": "५", "content_sanskrit": "पूज्या लालयितव्याश्च स्त्रियो नित्यं जनाधिप ।\nअपूजिताश्च यत्रैताः सर्वास्तत्राफलाः क्रियाः ।\nतदैव तत्कुलं नास्ति यदा शोचन्ति जामयः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198634, "chapter_id": 5225, "verse_number": "६", "content_sanskrit": "जामीशप्तानि गेहानि निकृत्तानीव कृत्यया ।\nनैव भान्ति न वर्धन्ते श्रिया हीनानि पार्थिव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198635, "chapter_id": 5225, "verse_number": "७", "content_sanskrit": "स्त्रियः पुंसां परिददे मनुर्जिगमिषुर्दिवम् ।\nअबलाः स्वल्पकौपीनाः सुहृदः सत्यजिष्णवः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198636, "chapter_id": 5225, "verse_number": "८", "content_sanskrit": "ईर्ष्यवो मानकामाश्च चण्डा असुहृदोऽबुधाः ।\nस्त्रियो माननमर्हन्ति ता मानयत मानवाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198637, "chapter_id": 5225, "verse_number": "९", "content_sanskrit": "स्त्रीप्रत्ययो हि वो धर्मो रतिभोगाश्च केवलाः ।\nपरिचर्यान्नसंस्कारास्तदायत्ता भवन्तु वः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198638, "chapter_id": 5225, "verse_number": "१०", "content_sanskrit": "उत्पादनमपत्यस्य जातस्य परिपालनम् ।\nप्रीत्यर्थं लोकयात्रा च पश्यत स्त्रीनिबन्धनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198639, "chapter_id": 5225, "verse_number": "११", "content_sanskrit": "सम्मान्यमानाश्चैताभिः सर्वकार्याण्यवाप्स्यथ ।\nविदेहराजदुहिता चात्र श्लोकमगायत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198640, "chapter_id": 5225, "verse_number": "१२", "content_sanskrit": "नास्ति यज्ञः स्त्रियः कश्चिन्न श्राद्धं नोपवासकम् ।\nधर्मस्तु भर्तृशुश्रूषा तया स्वर्गं जयत्युत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198641, "chapter_id": 5225, "verse_number": "१३", "content_sanskrit": "पिता रक्षति कौमारे भर्ता रक्षति यौवने ।\nपुत्रास्तु स्थविरीभावे न स्त्री स्वातन्त्र्यमर्हति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198642, "chapter_id": 5225, "verse_number": "१४", "content_sanskrit": "श्रिय एताः स्त्रियो नाम सत्कार्या भूतिमिच्छता ।\nलालिता निगृहीता च स्त्री श्रीर्भवति भारत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198643, "chapter_id": 5225, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे स्त्रीप्रशंसनं नाम सप्तषष्टितमोऽध्यायः ॥७६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]