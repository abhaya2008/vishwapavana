[{"id": 2017774, "chapter_id": 1368, "verse_number": "३-६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017775, "chapter_id": 1368, "verse_number": "३-६-१", "content_sanskrit": "गते तु विदुरे राजन्नाश्रमं पाण्डवान्प्रति।\nधृतराष्ट्रो महाप्राज्ञः पर्यतप्यत दुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017776, "chapter_id": 1368, "verse_number": "३-६-२", "content_sanskrit": "[विदुरस्य प्रभावं च सन्धिविग्रहकारितम्।\nविवृद्धिं च परां मत्वा पाण्डवानां भविष्यति ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017777, "chapter_id": 1368, "verse_number": "३-६-३", "content_sanskrit": "स सभाद्वारमागम्य विदुरस्मारमोहितः।\nसमक्षं पार्थिवेनद्राणां विसंज्ञः प्रापतद्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017778, "chapter_id": 1368, "verse_number": "३-६-४", "content_sanskrit": "स तु लब्ध्वा चिरात्संज्ञां समुत्थाय महीतलात्।\nसमीपोपस्थितं राजा संजयं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017779, "chapter_id": 1368, "verse_number": "३-६-५", "content_sanskrit": "भ्राता मम सुहृच्चैव साक्षाद्धर्म इवापरः।\nतस्य स्मृत्याऽद्य सुभृशं हृदयं दीर्यतीवमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017780, "chapter_id": 1368, "verse_number": "३-६-६", "content_sanskrit": "तमानय स्वधर्मज्ञं मम भ्रातरमाशु वै।\nइति ब्रुवन्स नृपतिः कृपणं पर्यदेवयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017781, "chapter_id": 1368, "verse_number": "३-६-७", "content_sanskrit": "पश्चात्तापाभिसंतप्तो विदुरस्मारमोहितः।\nभ्रातृश्नेहादिदं राजा संजयं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017782, "chapter_id": 1368, "verse_number": "३-६-८", "content_sanskrit": "गच्छ संजय जानीहि भ्रातरं विदुरं मम।\nयदि जीवति रोषेण मया पापेन निर्धुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017783, "chapter_id": 1368, "verse_number": "३-६-९", "content_sanskrit": "न हि तेन मम भ्रात्रा सुसूक्ष्ममपि किंचन।\nव्यलीकं कृतपूर्वं वै प्राज्ञेनामितबुद्धिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017784, "chapter_id": 1368, "verse_number": "३-६-१०", "content_sanskrit": "स व्यलीकं कथं प्राप्तो मत्तः परमबुद्धिमान्।\nन जह्माज्जीवितं प्राज्ञ तं गच्छानय संजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017785, "chapter_id": 1368, "verse_number": "३-६-११", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राज्ञस्तमनुमान्य च।\nसंजयो बाढमित्युक्त्वा प्राद्रवत्काम्यकं प्रति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017786, "chapter_id": 1368, "verse_number": "३-६-१२", "content_sanskrit": "सोऽचिरेण समासाद्य तद्वनं यत्र पाण्डवाः।\nरौरवाजिनसंवीतं ददर्शाथ युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017787, "chapter_id": 1368, "verse_number": "३-६-१३", "content_sanskrit": "विदुरेण सहासीनं ब्राह्मणैश्च सहस्रशः।\nभ्रातृभिश्चाभिसंगुप्तं देवैरिव पुरंदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017788, "chapter_id": 1368, "verse_number": "३-६-१४", "content_sanskrit": "युधिष्ठिरमुपागम्य पूजयामास संजयः।\nभीमार्जुनयमाश्चापि तद्युक्तं प्रतिपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017789, "chapter_id": 1368, "verse_number": "३-६-१५", "content_sanskrit": "राज्ञा पृष्टः स कुशलं सुखासीनश्च संजयः।\nशशंसागमने हेतुमिदं चैवाब्रवीद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017790, "chapter_id": 1368, "verse_number": "३-६-१६x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017791, "chapter_id": 1368, "verse_number": "३-६-१६", "content_sanskrit": "राजा स्मरति ते क्षत्तर्धृतराष्ट्रोऽम्बिकासुतः।\nतं पश्य गत्वा त्वं क्षिप्रं संजीवय च पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017792, "chapter_id": 1368, "verse_number": "३-६-१७", "content_sanskrit": "सोऽनुमान्य नरश्रेष्ठान्पाण्डवान्कुरुनन्दनान्।\nनियोगाद्राजसिंहस्य गन्तुमर्हसि सत्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017793, "chapter_id": 1368, "verse_number": "३-६-१८", "content_sanskrit": "एवमुक्तस्तु विदुरो धीमान्स्वजनवत्सलः।\nयुधिष्ठिरस्यानुमते पुनरायाद्गजाह्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017794, "chapter_id": 1368, "verse_number": "३-६-१९", "content_sanskrit": "तमब्रवीन्महातेजा धृतराष्ट्रोऽम्बिकासुतः।\nदिष्ट्या प्राप्तोसि धर्मज्ञ दिष्ट्या स्मरसि मेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017795, "chapter_id": 1368, "verse_number": "३-६-२०", "content_sanskrit": "अद्य चाहं दिवारात्रौ त्वत्कृते भरतर्षभ।\nप्रजागरे प्रपश्यामि विचित्रं देहमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017796, "chapter_id": 1368, "verse_number": "३-६-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017797, "chapter_id": 1368, "verse_number": "३-६-२१", "content_sanskrit": "सोङ्कमानीय विदुरं मूर्धन्याघ्राय चैव ह।\nक्षम्यतामिति चोवाचयदुक्तोसि मयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017798, "chapter_id": 1368, "verse_number": "३-६-२२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017799, "chapter_id": 1368, "verse_number": "३-६-२२", "content_sanskrit": "क्षान्तमेव मया राजन्गुरुर्मे परमो भवान्।\nतथाऽहमागतः शीघ्रं त्वद्दर्शनपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017800, "chapter_id": 1368, "verse_number": "३-६-२३", "content_sanskrit": "भवन्ति हि नरव्याघ्र पुरुषा धर्मचेतनाः।\nदीनानुकम्पिनो राजन्नात्र कार्या विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017801, "chapter_id": 1368, "verse_number": "३-६-२४", "content_sanskrit": "पाण्डोः पुत्रा यादृशास्ते तादृशा मे सुतास्तव।\nदीना इतीव मे बुद्धिरभिपन्नाऽद्य तान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017802, "chapter_id": 1368, "verse_number": "३-६-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017803, "chapter_id": 1368, "verse_number": "३-६-२५", "content_sanskrit": "अन्योन्यमनुनीयैवं भ्रातरौ द्वौ महाद्युती।\nविदुरो धृतराष्ट्रश्च लेभाते परमां मुदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017804, "chapter_id": 1368, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि किर्मीरवधपर्वणि षष्ठोऽध्यायः ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]