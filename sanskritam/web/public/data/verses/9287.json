[{"id": 5000287000, "chapter_id": 9287, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे पञ्चदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000287001, "chapter_id": 9287, "verse_number": "४-१५-१", "content_sanskrit": "अथ तस्य निनादं तं सुग्रीवस्य महात्मनः।\nशुश्रावान्तःपुरगतो वाली भ्रातुरमर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000287002, "chapter_id": 9287, "verse_number": "४-१५-२", "content_sanskrit": "श्रुत्वा तु तस्य निनदं सर्वभूतप्रकम्पनम्।\nमदश्चैकपदे नष्टः क्रोधश्चापादितो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000287003, "chapter_id": 9287, "verse_number": "४-१५-३", "content_sanskrit": "ततो रोषपरीताङ्गो वाली स कनकप्रभः।\nउपरक्त इवादित्यः सद्यो निष्प्रभतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000287004, "chapter_id": 9287, "verse_number": "४-१५-४", "content_sanskrit": "वाली दंष्ट्राकरालस्तु क्रोधाद् दीप्ताग्निलोचनः।\nभात्युत्पतितपद्माभः समृणाल इव ह्रदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000287005, "chapter_id": 9287, "verse_number": "४-१५-५", "content_sanskrit": "शब्दं दुर्मर्षणं श्रुत्वा निष्पपात ततो हरिः।\nवेगेन च पदन्यासैर्दारयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000287006, "chapter_id": 9287, "verse_number": "४-१५-६", "content_sanskrit": "तं तु तारा परिष्वज्य स्नेहाद् दर्शितसौहृदा।\nउवाच त्रस्तसम्भ्रान्ता हितोदर्कमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000287007, "chapter_id": 9287, "verse_number": "४-१५-७", "content_sanskrit": "साधु क्रोधमिमं वीर नदीवेगमिवागतम्।\nशयनादुत्थितः काल्यं त्यज भुक्तामिव स्रजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000287008, "chapter_id": 9287, "verse_number": "४-१५-८", "content_sanskrit": "काल्यमेतेन संग्रामं करिष्यसि च वानर।\nवीर ते शत्रुबाहुल्यं फल्गुता वा न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000287009, "chapter_id": 9287, "verse_number": "४-१५-९", "content_sanskrit": "सहसा तव निष्क्रामो मम तावन्न रोचते।\nश्रूयतामभिधास्यामि यन्निमित्तं निवार्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000287010, "chapter_id": 9287, "verse_number": "४-१५-१०", "content_sanskrit": "पूर्वमापतितः क्रोधात् स त्वामाह्वयते युधि।\nनिष्पत्य च निरस्तस्ते हन्यमानो दिशो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000287011, "chapter_id": 9287, "verse_number": "४-१५-११", "content_sanskrit": "त्वया तस्य निरस्तस्य पीडितस्य विशेषतः।\nइहैत्य पुनराह्वानं शङ्कां जनयतीव मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000287012, "chapter_id": 9287, "verse_number": "४-१५-१२", "content_sanskrit": "दर्पश्च व्यवसायश्च यादृशस्तस्य नर्दतः।\nनिनादस्य च संरम्भो नैतदल्पं हि कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000287013, "chapter_id": 9287, "verse_number": "४-१५-१३", "content_sanskrit": "नासहायमहं मन्ये सुग्रीवं तमिहागतम्।\nअवष्टब्धसहायश्च यमाश्रित्यैष गर्जति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000287014, "chapter_id": 9287, "verse_number": "४-१५-१४", "content_sanskrit": "प्रकृत्या निपुणश्चैव बुद्धिमांश्चैव वानरः।\nनापरीक्षितवीर्येण सुग्रीवः सख्यमेष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000287015, "chapter_id": 9287, "verse_number": "४-१५-१५", "content_sanskrit": "पूर्वमेव मया वीर श्रुतं कथयतो वचः।\nअङ्गदस्य कुमारस्य वक्ष्याम्यद्य हितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000287016, "chapter_id": 9287, "verse_number": "४-१५-१६", "content_sanskrit": "अङ्गदस्तु कुमारोऽयं वनान्तमुपनिर्गतः।\nप्रवृत्तिस्तेन कथिता चारैरासीन्निवेदिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000287017, "chapter_id": 9287, "verse_number": "४-१५-१७", "content_sanskrit": "अयोध्याधिपतेः पुत्रौ शूरौ समरदुर्जयौ।\nइक्ष्वाकूणां कुले जातौ प्रथितौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000287018, "chapter_id": 9287, "verse_number": "४-१५-१८", "content_sanskrit": "सुग्रीवप्रियकामार्थं प्राप्तौ तत्र दुरासदौ।\nस ते भ्रातुर्हि विख्यातः सहायो रणकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000287019, "chapter_id": 9287, "verse_number": "४-१५-१९", "content_sanskrit": "रामः परबलामर्दी युगान्ताग्निरिवोत्थितः।\nनिवासवृक्षः साधूनामापन्नानां परा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000287020, "chapter_id": 9287, "verse_number": "४-१५-२०", "content_sanskrit": "आर्तानां संश्रयश्चैव यशसश्चैकभाजनम्।\nज्ञानविज्ञानसम्पन्नो निदेशे निरतः पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000287021, "chapter_id": 9287, "verse_number": "४-१५-२१", "content_sanskrit": "धातूनामिव शैलेन्द्रो गुणानामाकरो महान्।\nतत् क्षमो न विरोधस्ते सह तेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000287022, "chapter_id": 9287, "verse_number": "४-१५-२२", "content_sanskrit": "दुर्जयेनाप्रमेयेण रामेण रणकर्मसु।\nशूर वक्ष्यामि ते किंचिन्न चेच्छाम्यभ्यसूयितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000287023, "chapter_id": 9287, "verse_number": "४-१५-२३", "content_sanskrit": "श्रूयतां क्रियतां चैव तव वक्ष्यामि यद्धितम्।\nयौवराज्येन सुग्रीवं तूर्णं साध्वभिषेचय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000287024, "chapter_id": 9287, "verse_number": "४-१५-२४", "content_sanskrit": "विग्रहं मा कृथा वीर भ्रात्रा राजन् यवीयसा।\nअहं हि ते क्षमं मन्ये तेन रामेण सौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000287025, "chapter_id": 9287, "verse_number": "४-१५-२५", "content_sanskrit": "सुग्रीवेण च सम्प्रीतिं वैरमुत्सृज्य दूरतः।\nलालनीयो हि ते भ्राता यवीयानेष वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000287026, "chapter_id": 9287, "verse_number": "४-१५-२६", "content_sanskrit": "तत्र वा सन्निहस्थो वा सर्वथा बन्धुरेव ते।\nनहि तेन समं बन्धुं भुवि पश्यामि कंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000287027, "chapter_id": 9287, "verse_number": "४-१५-२७", "content_sanskrit": "दानमानादिसत्कारैः कुरुष्व प्रत्यनन्तरम्।\nवैरमेतत् समुत्सृज्य तव पार्श्वे स तिष्ठतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000287028, "chapter_id": 9287, "verse_number": "४-१५-२८", "content_sanskrit": "सुग्रीवो विपुलग्रीवो महाबन्धुर्मतस्तव।\nभ्रातृसौहृदमालम्ब्य नान्या गतिरिहास्ति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000287029, "chapter_id": 9287, "verse_number": "४-१५-२९", "content_sanskrit": "यदि ते मत्प्रियं कार्यं यदि चावैषि मां हिताम्।\nयाच्यमानः प्रियत्वेन साधु वाक्यं कुरुष्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000287030, "chapter_id": 9287, "verse_number": "४-१५-३०", "content_sanskrit": "प्रसीद पथ्यं शृणु जल्पितं हि मे\nन रोषमेवानुविधातुमर्हसि।\nक्षमो हि ते कोशलराजसूनुना\nन विग्रहः शक्रसमानतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000287031, "chapter_id": 9287, "verse_number": "४-१५-३१", "content_sanskrit": "तदा हि तारा हितमेव वाक्यं\nतं वालिनं पथ्यमिदं बभाषे।\nन रोचते तद् वचनं हि तस्य\nकालाभिपन्नस्य विनाशकाले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000287032, "chapter_id": 9287, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे पञ्चदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]