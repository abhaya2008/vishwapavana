[{"id": 40018494, "chapter_id": 9287, "verse_number": "1", "content_sanskrit": "महोदरेतुनिहतेमहापार्श्वोमहाबलः । सुग्रीवेणसमीक्ष्याथक्रोधात्सम्ररक्तलोचनः ॥ अङ्गदस्यचमूंभीमांक्षोभयामाससायकैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018495, "chapter_id": 9287, "verse_number": "2", "content_sanskrit": "सवानराणांमुख्यानामुत्तमाङ्गानिसर्वशः ॥ पातयामानकायेभ्यःफलंवृन्तादिवानिलः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018496, "chapter_id": 9287, "verse_number": "3", "content_sanskrit": "केषांचिदिषुभिर्बाहुन् स्कन्धांश्छिच्छेदराक्षसः च ॥ वानराणांसुङ्कृद्ध: पार्श्वंकेषांव्यदारयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018497, "chapter_id": 9287, "verse_number": "4", "content_sanskrit": "तेऽर्दिताबाणवर्षेणमहापार्श्वेनवानराः ॥ विषादविमुखाःसर्वेबभूवुर्गतचेतसः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018498, "chapter_id": 9287, "verse_number": "5", "content_sanskrit": "निरीक्ष्यबलमुद्विग्नमङ्गदोराक्षसार्दितम् ॥ वेगंचक्रेमहावेगमहाबाहुस्समुद्रइवपर्वणि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018499, "chapter_id": 9287, "verse_number": "6", "content_sanskrit": "आयसंपरिघंगृह्यसूर्यरमशिसमप्रभम् ॥ समरेवानरश्रेष्ठोमहापार्श्वेन्यपातयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018500, "chapter_id": 9287, "verse_number": "7", "content_sanskrit": "स तुतेनप्रहारेणमहापार्श्वोविचेतनः ॥ ससूतस्स्यन्दनात्तस्माद्विसंज्ञश्चापतद्भुवि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018501, "chapter_id": 9287, "verse_number": "8", "content_sanskrit": "स ऋक्षराजस्तेजस्वीनीलाञ्जनचयोपमः ॥ निष्पत्यसुमहावीर्यस्स्वाद्व्यूहन्मेघसन्निभात् । प्रगृह्यगिरिशृङ्गाभांक्रुद्धस्सविपुलांशिलाम् ॥ अश्वाञ्जघानतरसाबभञ्जतम् स्यन्दनं च तम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018502, "chapter_id": 9287, "verse_number": "9", "content_sanskrit": "स ऋक्षराजस्तेजस्वीनीलाञ्जनचयोपमः ॥ निष्पत्यसुमहावीर्यस्स्वाद्व्यूहन्मेघसन्निभात् । प्रगृह्यगिरिशृङ्गाभांक्रुद्धस्सविपुलांशिलाम् ॥ अश्वाञ्जघानतरसाबभञ्जतम् स्यन्दनं च तम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018503, "chapter_id": 9287, "verse_number": "10", "content_sanskrit": "मुहूर्ताल्लब्धसंज्ञस्तुमहापार्श्वोमहाबलः ॥ अङ्गदंबहुभिर्बाणैर्भूयस्तंप्रत्यविध्यत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018504, "chapter_id": 9287, "verse_number": "11", "content_sanskrit": "जाम्बवन्तंत्रिभिर्बाणैराजघानस्तनान्तरे ॥ ऋक्षराजंगवाक्षं च जघानबहुभिश्शरैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018505, "chapter_id": 9287, "verse_number": "12", "content_sanskrit": "जाम्बवन्तंगवाक्षं च स दृष्टवाशरपीडितौ ॥ जग्राहपरिघंघोरमङ्गदःक्रोधमूर्छितः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018506, "chapter_id": 9287, "verse_number": "13", "content_sanskrit": "तस्याङ्गदःप्रकुपितोराक्षसस्यतमायसम् ॥ दूरस्थितस्यपरिघंरविरश्मिसमप्रभम् । द्वावाभ्यांभुजाभ्यांसङ्गृह्यभ्रामयित्वा च वेगवान् ॥ महापार्श्वस्यचिक्षेपवधार्थंवालिनस्सुतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018507, "chapter_id": 9287, "verse_number": "14", "content_sanskrit": "तस्याङ्गदःप्रकुपितोराक्षसस्यतमायसम् ॥ दूरस्थितस्यपरिघंरविरश्मिसमप्रभम् । द्वावाभ्यांभुजाभ्यांसङ्गृह्यभ्रामयित्वा च वेगवान् ॥ महापार्श्वस्यचिक्षेपवधार्थंवालिनस्सुतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018508, "chapter_id": 9287, "verse_number": "15", "content_sanskrit": "स तुक्षिप्तोबलवतापरिघन्तस्यरक्षसः ॥ धनुश्चसशरंहस्ताछचिरस्त्रांचाप्यपातयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018509, "chapter_id": 9287, "verse_number": "16", "content_sanskrit": "तंसमासाद्यवेगेनवालिपुत्रःप्रतापवान् ॥ तलेनाभ्यहनत्क्रुद्धः कर्णमूले सकुण्डले ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018510, "chapter_id": 9287, "verse_number": "17", "content_sanskrit": "स तुक्रुद्धोमहावेगोमहापार्श्वोमहाद्युति ॥ करेणैकेनजग्राहसुमहान्तंपरश्वथम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018511, "chapter_id": 9287, "verse_number": "18", "content_sanskrit": "तंम्तैलधौतंविमलंशैलसारमयंदृढम् ॥ राक्षसःपरमक्रुद्धोवालिपुत्रेन्यपातयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018512, "chapter_id": 9287, "verse_number": "19", "content_sanskrit": "तेनवामांसफलकेभृशंप्रत्यवपादितम् ॥ अङ्गदोमोक्ष्यामाससरोषस्सपरश्वधम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018513, "chapter_id": 9287, "verse_number": "20", "content_sanskrit": "सवीरोवज्रसङ्काशमङ्गदोमुष्टिमात्मनः ॥ संवर्तयत्सुसङ्कृद्धःपितृतुल्यपराक्रमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018514, "chapter_id": 9287, "verse_number": "21", "content_sanskrit": "राक्षसस्यस्तनाभ्याशेमर्मज्ञोहृदयंप्रति ॥ इन्द्राशनिमस्पर्शं स मुष्टिंविन्यपातयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018515, "chapter_id": 9287, "verse_number": "22", "content_sanskrit": "तेनतस्यनिपातेनराक्षसस्यमहामृधे ॥ पफालहृदयंचास्य स पपातहतोभुवि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018516, "chapter_id": 9287, "verse_number": "23", "content_sanskrit": "स्मिन्निपतितेभूमौतत्सैन्यंसम्प्रचुक्षुभे ॥ अभवच्चमहान्क्रोधस्समरेरावणस्यतु ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018517, "chapter_id": 9287, "verse_number": "24", "content_sanskrit": "वानराणांश्चहृष्टानांसिंहनादःसुपुष्कलः ॥ स्पोटयन्निवशब्देनलङ्कांसाट्टालगोपुराम् । महेन्द्रेणेवदेवानांनादस्समभवन्महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018518, "chapter_id": 9287, "verse_number": "25", "content_sanskrit": "वानराणांश्चहृष्टानांसिंहनादःसुपुष्कलः ॥ स्पोटयन्निवशब्देनलङ्कांसाट्टालगोपुराम् । महेन्द्रेणेवदेवानांनादस्समभवन्महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]