[{"id": 7003636000, "chapter_id": 23636, "verse_number": "१-२-२३-१", "content_sanskrit": "नारद उवाच ।\nततश्च शैलजा देवी चिक्रीड सुभगा तदा ।\nदेवगंधर्वकन्याभिर्नगकिंनरसंभवाः ।\nमुनीनां चापि याः कन्यास्ताभिः सार्धं च शोभना ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003636001, "chapter_id": 23636, "verse_number": "१-२-२३-२", "content_sanskrit": "कदाचिदथ मेरुस्थो वासवः पांडुनंदन ।\nसस्मारा मां ययौ चाहं संस्मृतो वासवं तदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003636002, "chapter_id": 23636, "verse_number": "१-२-२३-३", "content_sanskrit": "मां दृष्ट्वा च सहस्राक्षः समुत्थायातिहर्षितः ।\nपूजयामास तां पूजां प्रतिगृह्याहमब्रुवम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003636003, "chapter_id": 23636, "verse_number": "१-२-२३-४", "content_sanskrit": "महासुर महोन्मादकालानल दिवस्पते ।\nकुशलं विद्यते कच्चिच्च नंदसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003636004, "chapter_id": 23636, "verse_number": "१-२-२३-५", "content_sanskrit": "पृष्टस्त्वेवं मया शक्रः प्रोवाच वचनं स्मयन् ।\nकुशलस्यांकुरस्तावत्संभूतो भुवनत्रये ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003636005, "chapter_id": 23636, "verse_number": "१-२-२३-६", "content_sanskrit": "तत्फलोदयसंपत्तौ तद्भवान्संस्मृतो मुने ।\nवेत्सि सर्वमतं त्वं वै तथापि परिनोदकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003636006, "chapter_id": 23636, "verse_number": "१-२-२३-७", "content_sanskrit": "निर्वृतिं परमां याति निवेद्यार्थं सुहृज्जने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003636007, "chapter_id": 23636, "verse_number": "१-२-२३-८", "content_sanskrit": "तद्भवाञ्छैलजां देवीं शैलंद्रं शैलवल्लभाम् ।\nहरं संभावय वरं यन्नान्यं रोचयंति ते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003636008, "chapter_id": 23636, "verse_number": "१-२-२३-९", "content_sanskrit": "ततस्तद्वाक्यमाकर्ण्य गतोऽहं शैलसत्तमम् ।\nओषधिप्रस्थनिलयं साक्षादिव दिवस्पतिम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003636009, "chapter_id": 23636, "verse_number": "१-२-२३-१०", "content_sanskrit": "तत्र हैमे स्वयं तेन महाभक्त्या निवेदिते ।\nमहासने पूजितोहमुपविष्टो महासुखम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003636010, "chapter_id": 23636, "verse_number": "१-२-२३-११", "content_sanskrit": "गृहीतार्घ्यं ततो मां च पप्रच्छ श्लक्ष्णया गिरा ।\nकुशलं तपसः शैलः शनैः फुल्लाननांबुजः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003636011, "chapter_id": 23636, "verse_number": "१-२-२३-१२", "content_sanskrit": "अहमप्यस्य तत्प्रोच्य प्रत्यवोचं गिरीश्वरम् ।\nत्वया शैलेंद्र पूर्वां वाप्यपरां च दिशं तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003636012, "chapter_id": 23636, "verse_number": "१-२-२३-१३", "content_sanskrit": "अवगाह्य स्थितवता क्रियते प्राणिपालना ।\nअहो धन्योसि विप्रेंद्राः साहाय्येन तवाचल ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003636013, "chapter_id": 23636, "verse_number": "१-२-२३-१४", "content_sanskrit": "तपोजपव्रतस्नानौः साध्यंत्यात्मनः परम् ।\nयज्ञांगसाधनैः कांश्चित्कंदादिफलदानतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003636014, "chapter_id": 23636, "verse_number": "१-२-२३-१५", "content_sanskrit": "त्वं समुद्धरसि विप्रान्किमतः प्रोच्यते तव ।\nअन्येऽपि जीव बहुधात्वामुपाश्रित्य भूधर ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003636015, "chapter_id": 23636, "verse_number": "१-२-२३-१६", "content_sanskrit": "मुदिताः प्रतिवर्तंते गृहस्थमिव प्राणिनः ।\nशीतमातपवर्षांश्च क्लेशान्नानाविधान्सहन् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003636016, "chapter_id": 23636, "verse_number": "१-२-२३-१७", "content_sanskrit": "उपाकरोषि जंतूनामेवंरूपा हि साधवः ।\nकिमतः प्रोच्यते तुभ्यं धन्यस्त्वं पृथिवीधर ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003636017, "chapter_id": 23636, "verse_number": "१-२-२३-१८", "content_sanskrit": "कंदरं यस्य चाध्यास्ते स्वयं तव महेश्वरः ।\nइत्युक्तवति वाक्यं च यथार्थं मयिफाल्गुन ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003636018, "chapter_id": 23636, "verse_number": "१-२-२३-१९", "content_sanskrit": "हिमशैलस्य महिषी मेना आगाद्दिदृक्षया ।\nअनुयाता दुहित्रा च स्वल्पाश्च परिचारिकाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003636019, "chapter_id": 23636, "verse_number": "१-२-२३-२०", "content_sanskrit": "लज्जयानतसर्वांगी प्रविवेश सदो महत् ।\nततो मां शैलमहिषी ववंदे प्रणिपत्य सा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003636020, "chapter_id": 23636, "verse_number": "१-२-२३-२१", "content_sanskrit": "वस्त्रनिर्गूढवदना पाणिपद्मकृतांजलिः ।\nतामहं सत्यरूपाभिराशीर्भिः समवर्धयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003636021, "chapter_id": 23636, "verse_number": "१-२-२३-२२", "content_sanskrit": "पतिव्रता शुभाचारा सुबगा वीरसूः शुभे ।\nसदा वीरवती चापि भव वंशोन्नतिप्रद ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003636022, "chapter_id": 23636, "verse_number": "१-२-२३-२३", "content_sanskrit": "ततोऽहं विस्मिताक्षीं च हिमवद्गिरिपुत्रिकाम् ।\nमृदुवाण्या प्रत्यवोचमेहि बाले ममांतिकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003636023, "chapter_id": 23636, "verse_number": "१-२-२३-२४", "content_sanskrit": "ततो देवी जगन्माता बालबावं स्वकं मयि ।\nदर्शयंती स्वपितरं कंठे गृह्यांकमावि शत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003636024, "chapter_id": 23636, "verse_number": "१-२-२३-२५", "content_sanskrit": "उवाच वाचं तां मंदं मुनिं वंदय पुत्रिके ।\nमुनेः प्रसादतोऽवश्यं पतिमाप्स्यसि संमतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003636025, "chapter_id": 23636, "verse_number": "१-२-२३-२६", "content_sanskrit": "इत्युक्ता सा ततो बाला वस्त्रांतपि हितानना ।\nकिंचित्सहुंकृतोत्कंपं प्रोच्य नोवाच किंचन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003636026, "chapter_id": 23636, "verse_number": "१-२-२३-२७", "content_sanskrit": "ततो विस्मितचित्तोहमुपचारविदांवरः ।\nप्रत्यवोचं पुनर्देवीमेहि दास्यामि ते शुभे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003636027, "chapter_id": 23636, "verse_number": "१-२-२३-२८", "content_sanskrit": "रत्नक्रीडनकं रम्यं स्तापितं सुचिरं मया ।\nइत्युक्ता सा तदोत्थाय पितुरंकात्सवेगतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003636028, "chapter_id": 23636, "verse_number": "१-२-२३-२९", "content_sanskrit": "वंदमाना च मे पादौ मया नीतांक मात्मनः ।\nमन्यता तां जगत्पूज्यामुक्तं बाले तवोचितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003636029, "chapter_id": 23636, "verse_number": "१-२-२३-३०", "content_sanskrit": "न तत्पश्यामि यत्तुभ्यं दद्म्याशीः का तवोचिता ।\nइत्युक्ते मातृवात्सल्याच्छैलेन्द्र महिषी तदा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003636030, "chapter_id": 23636, "verse_number": "१-२-२३-३१", "content_sanskrit": "नोदयामास मां मंदमानशीःशंकिता तदा ।\nभगवन्वेत्सि सर्वं त्वमतीतानागतं प्रभो ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003636031, "chapter_id": 23636, "verse_number": "१-२-२३-३२", "content_sanskrit": "तदहं ज्ञातुमिच्छामि कीदृशोऽस्याः पतिर्भवेत् ।\nश्रुत्वेति सस्मितमुखः प्रावोचं नर्मवल्लभः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003636032, "chapter_id": 23636, "verse_number": "१-२-२३-३३", "content_sanskrit": "न जातोऽस्याः पतिर्भद्रे वर्तते च कुलक्षणः ।\nनग्नोऽतिनिर्धनः क्रोधीवृतः क्रूरैश्च सर्वदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003636033, "chapter_id": 23636, "verse_number": "१-२-२३-३४", "content_sanskrit": "श्रुत्वेति संभ्रमाविष्टो ध्वस्तवीर्यो हिमाचलः ।\nमां तदा प्रत्युवाचेदं साश्रुकण्ठो महागिरिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003636034, "chapter_id": 23636, "verse_number": "१-२-२३-३५", "content_sanskrit": "अहो विचित्रः सं सारो दुर्वेद्यो महतामपि ।\nप्रवरस्त्वपि शक्त्या यो नरेषु न कृपायते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003636035, "chapter_id": 23636, "verse_number": "१-२-२३-३६", "content_sanskrit": "यत्नेन महता तावत्पुण्यैर्बहुविधैरपि ।\nसाधयत्यात्मनो लोको मानुष्य मतिदुर्लभम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003636036, "chapter_id": 23636, "verse_number": "१-२-२३-३७", "content_sanskrit": "अध्रुवं तद्ध्रवत्वे च कथंचित्परिकल्प्यते ।\nतत्रापि दुर्लभानाम समानव्रतचारिणी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003636037, "chapter_id": 23636, "verse_number": "१-२-२३-३८", "content_sanskrit": "साध्वी महाकुलोत्पन्ना भार्याया स्यात्पतिव्रता ।\nतत्रापि दुर्लभं यच्च तया धर्मनिषेवणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003636038, "chapter_id": 23636, "verse_number": "१-२-२३-३९", "content_sanskrit": "सह वेदपुराणोक्तं जगत्त्रयहितावहम् ।\nएतत्सुदुर्लभं यच्च तस्यां चैव प्रजायते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003636039, "chapter_id": 23636, "verse_number": "१-२-२३-४०", "content_sanskrit": "तदपत्यमपत्यार्थं संसारे किल नारद ।\nएतेषां दुर्लभानां हि किंचित्प्राप्नोति पुण्यवान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003636040, "chapter_id": 23636, "verse_number": "१-२-२३-४१", "content_sanskrit": "सर्वमेतदवाप्नोति स कोपि यदिवा न वा ।\nकिंचित्केनापि हि न्यूनं संसारः कुरुते नरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003636041, "chapter_id": 23636, "verse_number": "१-२-२३-४२", "content_sanskrit": "अथ संसारिको दोषः स्वकृतं यत्र भुज्यते ।\nगार्हस्थ्यं च प्रशंसंति वेदाः सर्वेऽपि नारद ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003636042, "chapter_id": 23636, "verse_number": "१-२-२३-४३", "content_sanskrit": "नेति केचित्तत्र पुनः कथं ते यदि नो गृही ।\nअतो धात्रा च शास्त्रेषु सुतलाभः प्रशंसितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003636043, "chapter_id": 23636, "verse_number": "१-२-२३-४४", "content_sanskrit": "पुनश्चसृष्टिवृद्ध्यर्थं नरकत्राणनाय च ।\nतत्र स्त्रीणां समुत्पत्तिं विना सृष्टिर्न जायते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003636044, "chapter_id": 23636, "verse_number": "१-२-२३-४५", "content_sanskrit": "सा च जातिप्रकृत्यैव कृपणा दैन्यभागिनी ।\nतासामुपरि मावज्ञा भवेदिति च वेधसा ।\nशास्त्रेषूक्तमसंदिग्धं वाक्यमेतन्महात्फलम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003636045, "chapter_id": 23636, "verse_number": "१-२-२३-४६", "content_sanskrit": "दशपुत्रसमा कन्या दशपुत्रान्प्रवर्द्धयन् ।\nयत्फलं लभते मर्त्यस्तल्लभ्यं कन्ययैकया ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003636046, "chapter_id": 23636, "verse_number": "१-२-२३-४७", "content_sanskrit": "तस्मात्कन्या पितुः शोच्या सदा दुःखविवर्धिनी ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003636047, "chapter_id": 23636, "verse_number": "१-२-२३-४८", "content_sanskrit": "यापि स्यात्पूर्णसर्वार्था पतिपुत्रधनान्विता ।\nत्वयोक्तं च कृते ह्यस्यास्तद्वाक्यं मम शोकदम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003636048, "chapter_id": 23636, "verse_number": "१-२-२३-४९", "content_sanskrit": "केन दोषेण मे पुत्री न योग्या आशिषामता ।\nन जातोऽस्याः पतिः कस्माद्वर्तते वा कुलक्षणः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003636049, "chapter_id": 23636, "verse_number": "१-२-२३-५०", "content_sanskrit": "निर्धनश्च मुने कस्मात्सर्वेषां सर्वदः कुतः ।\nइति दुर्घटवाक्यं ते मनो मोहयतीव मे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003636050, "chapter_id": 23636, "verse_number": "१-२-२३-५१", "content_sanskrit": "इति तं पुत्रवात्सल्यात्सभार्यं शोकसंप्लुतम् ।\nअहमाश्वासयं वाग्भिः सत्याभिः पांडुनंदन ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003636051, "chapter_id": 23636, "verse_number": "१-२-२३-५२", "content_sanskrit": "मा शुचः शैलराज त्वं हर्षस्थानेऽतिपुण्यभाक् ।\nश्रृणु तद्वचनं मह्यं यन्मयोक्तं च ह्यर्थवत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003636052, "chapter_id": 23636, "verse_number": "१-२-२३-५३", "content_sanskrit": "जगन्माता त्वियं बाला पुत्री ते सर्वसिद्धिदा ।\nपुरा भवेऽभवद्भार्या सतीनाम्ना भवस्य या ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003636053, "chapter_id": 23636, "verse_number": "१-२-२३-५४", "content_sanskrit": "तदस्याः किमहं दद्मि रवेर्दीपमिवाल्पकः ।\nसंचिंत्येति महादेव्या नाशिषं दत्तवानहम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003636054, "chapter_id": 23636, "verse_number": "१-२-२३-५५", "content_sanskrit": "न जातोऽभवद्भार्या पतिश्चेति वर्तते च भवो हि सः ।\nन स जातो महादेवो भूतभव्यभवोद्भवः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003636055, "chapter_id": 23636, "verse_number": "१-२-२३-५६", "content_sanskrit": "शरण्यः शाश्वतः शास्ता शंकरः परमेश्वरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003636056, "chapter_id": 23636, "verse_number": "१-२-२३-५७", "content_sanskrit": "सर्वे देवा यत्पदमामनंति वेदैश्च सर्वैरपि यो न लभ्यः ।\nब्रह्मादिविश्वं ननु यस्य शैल बालस्य वा क्रीडनकं वदंति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003636057, "chapter_id": 23636, "verse_number": "१-२-२३-५८", "content_sanskrit": "स चामंगल्यशीलोऽपि मंगलां यतनो हरः ।\nनिर्धनः सर्वदश्चासौ वेद स्वं स्वयमेव सः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003636058, "chapter_id": 23636, "verse_number": "१-२-२३-५९", "content_sanskrit": "स च देवोऽचलः स्थाणुर्महादेवोऽजरो हरः ।\nभविष्यति पतिः सोऽस्यास्तत्किमर्थं तु शोचसि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]