[{"id": 2130435, "chapter_id": 3813, "verse_number": "", "content_sanskrit": "सौगन्धिकसरो विविक्षुं भीमं प्रति तद्रक्षिभिः क्रोधवशनामकै राक्षसैस्तच्चिकीर्षितप्रश्नः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130436, "chapter_id": 3813, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130437, "chapter_id": 3813, "verse_number": "१", "content_sanskrit": "स गत्वा नळिनीं रम्यां राक्षसैरभिरक्षिताम् ।\nकैलासशिखराभ्याशे ददर्श शुभकाननाम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130438, "chapter_id": 3813, "verse_number": "", "content_sanskrit": "नीलशाद्वलपर्यन्तां चित्रद्रुमपरिच्छदाम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130439, "chapter_id": 3813, "verse_number": "२", "content_sanskrit": "कुबेरभवनाभ्याशे जातां पर्वतनिर्झरैः ।\nसुरम्यां विपुलच्छायां नानाद्रुमलताकुलाम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130440, "chapter_id": 3813, "verse_number": "३", "content_sanskrit": "हरिताम्बुजसञ्च्छन्नां दिव्यां कनकपुष्कराम् ।\nविचित्रभूतां लोकस्य शुभामद्भुतदर्शनाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130441, "chapter_id": 3813, "verse_number": "", "content_sanskrit": "नानापक्षिगणाकीर्णां सूपतीर्थामकर्दमाम् ॥\nअतीव रम्यां सुजलां जातां पवर्तसानुषु ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130442, "chapter_id": 3813, "verse_number": "४", "content_sanskrit": "तत्रामृतरसं शीतं लघु कुन्तीसुतः शुभम् ।\nददर्श विमलं तोयं पिबंश्च बहु पाण्डवः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130443, "chapter_id": 3813, "verse_number": "५", "content_sanskrit": "तां तु पुष्करिणीं रम्यां दिव्यसौगन्धिकावृताम् ।\nजातरूपमयैः पद्मैश्छन्नां परमगन्धिभिः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130444, "chapter_id": 3813, "verse_number": "६", "content_sanskrit": "वैदूर्यवरनाळैश्च बहुचित्रैर्मनोरमैः ।\nहंसकारण्डवोद्धूतैः सृजद्भिरमलं रजः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130445, "chapter_id": 3813, "verse_number": "७", "content_sanskrit": "आक्रीडं राजराजस्य कुबेरस्य महात्मनः ।\nगन्धर्वैरप्यरोभिश्च देवैश्च परमार्चिताम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130446, "chapter_id": 3813, "verse_number": "८", "content_sanskrit": "सेवितामृषिभिर्दिव्यैर्यक्षैः किम्पुरुषैस्तथा ।\nराक्षसैः किन्नरैश्चापि गुप्तां वैश्रवणेन च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130447, "chapter_id": 3813, "verse_number": "९", "content_sanskrit": "तां च दृष्ट्वैव कौन्तेयो भीमसेनो महाबलः ।\nबभूव परमप्रीतो दिव्यं सम्प्रेक्ष्य तत्सरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130448, "chapter_id": 3813, "verse_number": "१०", "content_sanskrit": "तच्च क्रोधवशा नाम राक्षसा राजशासनात् ।\nरक्षन्ति शतसाहस्राश्चित्रायुधपरिच्छदाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130449, "chapter_id": 3813, "verse_number": "११", "content_sanskrit": "ते तु दृष्ट्वैव कौन्तेयमजिनैः प्रतिवासितम् ।\nरुग्माङ्गदधरं वीरं भीमं भीमपराक्रमम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130450, "chapter_id": 3813, "verse_number": "१२", "content_sanskrit": "सायुधं बद्धनिस्त्रिशंमशङ्कितमरिन्दमम् ।\nपुष्करेप्सुमुपायान्तमन्योन्यमभिचुक्रुशुः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130451, "chapter_id": 3813, "verse_number": "१३", "content_sanskrit": "अयं पुरुषशार्दूलः सायुधोऽजिनसंवृतः ।\nयच्चिकीर्षुरिह प्राप्तस्तत् सम्प्रष्टुमिहार्हथ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130452, "chapter_id": 3813, "verse_number": "१४", "content_sanskrit": "ततः सर्वे महाबाहुं समासाद्य वृकोदरम् ।\nतेजोयुक्तमपृच्छन्त कस्त्वमाख्यातुमर्हसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130453, "chapter_id": 3813, "verse_number": "१५", "content_sanskrit": "मुनिवेषधरश्चैव सायुधश्चैव लक्ष्यसे ।\nयदर्थमभिसम्प्राप्तस्तदाचक्ष्व महामते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130454, "chapter_id": 3813, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकोनपञ्चाशदधिकशततमोऽध्यायः ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130455, "chapter_id": 3813, "verse_number": "१०५", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि पञ्चाधिकशततमोऽध्यायः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]