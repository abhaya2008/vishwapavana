[{"id": 2169536, "chapter_id": 4626, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169537, "chapter_id": 4626, "verse_number": "१", "content_sanskrit": "विदार्य कर्णस्तां सेनां युधिष्ठिरमुपाद्रवत् ।\nरथहस्त्यश्वपत्तीनां सहस्रैः परिवारितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169538, "chapter_id": 4626, "verse_number": "२", "content_sanskrit": "नानायुधसहस्राणि प्रेषितान्यरिभिर्वृषः ।\nछित्त्वा बाणशतैरुग्रैस्तानविद्ध्यदसम्भ्रमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169539, "chapter_id": 4626, "verse_number": "३", "content_sanskrit": "निचकर्त शिरांस्येषां बाहूनूरूंश्च सूतजः ।\nते हता वसुधां पेतुर्मग्नाश्चान्ये विदुद्रुवुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169540, "chapter_id": 4626, "verse_number": "४", "content_sanskrit": "द्रविडान्ध्रनिषादास्तु पुनः सात्यकिचोदिताः ।\nअभ्यर्दयन् जिघांसन्तः पत्तयः कर्णमाहवे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169541, "chapter_id": 4626, "verse_number": "५", "content_sanskrit": "ते विबाहुविशस्त्राश्च प्रहताः कर्णसायकैः ।\nपेतुः पृथिव्यां युगपच्छिन्नं शालवनं यथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169542, "chapter_id": 4626, "verse_number": "६", "content_sanskrit": "एवं योधशतान्याजौ सहस्राण्ययुतानि च ।\nहतानीयुर्महीं देहैर्यशसापूरयन् दिशः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169543, "chapter_id": 4626, "verse_number": "७", "content_sanskrit": "अथ वैकर्तनं कर्णं रणे क्रुद्धमिवान्तकम् ।\nरुरुधुः पाण्डुपाञ्चाला व्याधिं मन्त्रौषधैरिव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169544, "chapter_id": 4626, "verse_number": "८", "content_sanskrit": "स तान् प्रमृद्याभ्यपतत् पुनरेव युधिष्ठिरम् ।\nमन्त्रौषधिक्रियातीतो व्याधिरत्युल्बणो यथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169545, "chapter_id": 4626, "verse_number": "९", "content_sanskrit": "स राजगृद्धिभी रुद्धः पाण्डुपाञ्चालकेकयैः ।\nनाशकत् तानतिक्रान्तुं मृत्युर्ब्रह्मविदो यथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169546, "chapter_id": 4626, "verse_number": "१०", "content_sanskrit": "ततो युधिष्ठिरः कर्णमदूरस्थं निवारितम् ।\nअब्रवीत् परवीरघ्नः क्रोधसंरक्तलोचनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169547, "chapter_id": 4626, "verse_number": "११", "content_sanskrit": "कर्ण कर्ण वृथा दुष्ट सूतपुत्र वचः शृणु ।\nसदा स्पर्धसि सङ्ग्रामे फल्गुनेन तरस्विना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169548, "chapter_id": 4626, "verse_number": "१२", "content_sanskrit": "तथास्मान् बाधसे नित्यं धार्तराष्ट्रमते स्थितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169549, "chapter_id": 4626, "verse_number": "१३", "content_sanskrit": "यद्बलं यच्च ते वीर्यं प्रद्वेषो यश्च पाण्डुषु ।\nतत्सर्वं दर्शयस्वाद्य पौरुषं महदास्थितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169550, "chapter_id": 4626, "verse_number": "१४", "content_sanskrit": "युद्धश्रद्धां स तेऽद्याहं विनेष्यामि महाहवे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169551, "chapter_id": 4626, "verse_number": "१५", "content_sanskrit": "एवमुक्त्वा महाराज कर्णं पाण्डुसुतस्तदा ।\nसुवर्णपुङ्खैर्दशभिर्विव्याधायस्मयैः शरैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169552, "chapter_id": 4626, "verse_number": "१६", "content_sanskrit": "तं सूतपुत्रो नवभिः प्रत्यविध्यदरिन्दमः ।\nवत्सदन्तैर्महेष्वासः प्रहसन्निव भारत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169553, "chapter_id": 4626, "verse_number": "१७", "content_sanskrit": "सोऽवज्ञाय तु निर्विद्धः सूतपुत्रेण मारिष ।\nप्रजज्वाल ततः क्रोधाद्धविषेव हुताशनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169554, "chapter_id": 4626, "verse_number": "१८", "content_sanskrit": "ततो विस्फार्य सुमहच्चापं हेमपरिष्कृतम् ।\nसमाधत्त शितं बाणं गिरीणामपि दारणम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169555, "chapter_id": 4626, "verse_number": "१९", "content_sanskrit": "ततः पूर्णायतं तीक्ष्णं यमदण्डनिभं शरम् ।\nमुमोच त्वरितो राजा सूतपुत्रजिघांसया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169556, "chapter_id": 4626, "verse_number": "२०", "content_sanskrit": "स तु वेगवता मुक्तो बाणो वज्राशनिस्वनः ।\nविवेश सहसा कर्णं सव्ये पार्श्वे महारथम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169557, "chapter_id": 4626, "verse_number": "२१", "content_sanskrit": "स तु तेन प्रहारेण पीडितः प्रमुमोह वै ।\nस्रस्तगात्रो महाबाहुर्धनुरुत्सृज्य तत्क्षणात्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169558, "chapter_id": 4626, "verse_number": "२२", "content_sanskrit": "गतासुरिव निश्चेताः शल्यस्याभिमुखोऽपतत् ।\nफल्गुनस्यादधत्कीर्तिं कर्णे नास्त्रममुञ्चत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169559, "chapter_id": 4626, "verse_number": "२३", "content_sanskrit": "राजापि भूयो नाजघ्ने कर्णं पार्थहितेप्सया\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169560, "chapter_id": 4626, "verse_number": "२४", "content_sanskrit": "ततो हाहाकृतं सर्वं धार्तराष्ट्रबलं महत् ।\nविवर्णमुखभूयिष्ठं कर्णं दृष्ट्वा तथागतम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169561, "chapter_id": 4626, "verse_number": "२५", "content_sanskrit": "सिंहनादश्च सञ्जज्ञे क्ष्वेडाः किलकिलास्तथा ।\nपाण्डवानां महाराज दृष्ट्वा राज्ञः पराक्रमम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169562, "chapter_id": 4626, "verse_number": "२६", "content_sanskrit": "प्रतिलभ्य तु राधेयः सञ्ज्ञां नातिचिरादिव ।\nदध्रे राजविनाशाय मनः क्रूरपराक्रमः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169563, "chapter_id": 4626, "verse_number": "२७", "content_sanskrit": "स हेमविकृतं चापं विस्फार्य विजयं महत् ।\nअवाकिरदमेयात्मा पाण्डवं निशितैः शरैः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169564, "chapter_id": 4626, "verse_number": "२८", "content_sanskrit": "ततः क्षुराभ्यां पाञ्चाल्यौ चक्ररक्षौ महात्मनः ।\nजघान चन्द्रदेवं च दण्डधारं च संयुगे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169565, "chapter_id": 4626, "verse_number": "२९", "content_sanskrit": "तावुभौ धर्मराजस्य प्रवीरौ परिपार्श्वतः ।\nरथाभ्याशे चकाशेते चन्द्रस्येव पुनर्वसू\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169566, "chapter_id": 4626, "verse_number": "३०", "content_sanskrit": "युधिष्ठिरः पुनः कर्णमविध्यत् त्रिंशता शरैः ।\nसुषेणं सत्यसेनं च त्रिभिस्त्रिभिरताडयत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169567, "chapter_id": 4626, "verse_number": "३१", "content_sanskrit": "शल्यं नवत्या विव्याध त्रिसप्तत्या च सूतजम् ।\nतांश्चास्य गोप्तॄन् विव्याध त्रिभिस्त्रिभिरजिह्मगैः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169568, "chapter_id": 4626, "verse_number": "३२", "content_sanskrit": "ततः प्रहस्याधिरथिर्विधुन्वानः स कार्मुकम् ।\nछित्त्वा भल्लेन राजानं विद्ध्वा षष्ट्या नदन् मुदा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169569, "chapter_id": 4626, "verse_number": "३३", "content_sanskrit": "ततः प्रवीराः पाण्डूनामभ्यधावन्युधिष्ठिरम् ।\nसूतपुत्रात् परीप्सन्तः कर्णमभ्यर्दयन् शरैः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169570, "chapter_id": 4626, "verse_number": "३४", "content_sanskrit": "सात्यकिश्चेकितानश्च युयुत्सुः पाण्ड्य एव च ।\nधृष्टद्युम्नः शिखण्डी च द्रौपदेयाः प्रभद्रकाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169571, "chapter_id": 4626, "verse_number": "३५", "content_sanskrit": "यमौ च भीमसेनश्च शिशुपालस्य चात्मजः ।\nकारूषा मत्स्यशूराश्च केकयाः काशिकोसलाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169572, "chapter_id": 4626, "verse_number": "३६", "content_sanskrit": "एते च त्वरिता वीरा वसुषेणमताडयन्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169573, "chapter_id": 4626, "verse_number": "३७", "content_sanskrit": "जनमेजयश्च पाञ्चाल्यः कर्णं विव्याध सायकैः ।\nवराहकर्णैर्नाराचैर्नालीकैर्निशितैः शरैः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169574, "chapter_id": 4626, "verse_number": "३८", "content_sanskrit": "वत्सदन्तैर्विपाठैश्च क्षुरप्रैश्चटकामुखैः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169575, "chapter_id": 4626, "verse_number": "३९", "content_sanskrit": "नानाप्रहरणैश्चोग्रै रथहस्त्यश्वसादिनः ।\nसर्वतोऽभ्यद्रवन् कर्णं परिवार्य जिघांसया\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169576, "chapter_id": 4626, "verse_number": "४०", "content_sanskrit": "स पाण्डवानां प्रवरैः सर्वतः समभिद्रुतः ।\nउदैरयद् ब्राह्ममस्त्रं शरैरापूरयन् दिशः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169577, "chapter_id": 4626, "verse_number": "४१", "content_sanskrit": "ततः शरमहाज्वालो वीर्योष्मा कर्णपावकः ।\nनिर्दहन् पाण्डववनं चारु पर्यचरद् रणे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169578, "chapter_id": 4626, "verse_number": "४२", "content_sanskrit": "स संवार्य महास्त्राणि महेष्वासो महात्मनाम् ।\nप्रहस्य पुरुषेन्द्रस्य शरैश्चिच्छेद कार्मुकम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169579, "chapter_id": 4626, "verse_number": "४३", "content_sanskrit": "ततः सन्धाय नवतिं निमेषान्नतपर्वणाम् ।\nबिभेद कवचं राज्ञो रणे कर्णः शितैः शरैः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169580, "chapter_id": 4626, "verse_number": "४४", "content_sanskrit": "तद्वर्म हेमविकृतं रत्नचित्रं बभौ पतत् ।\nसविद्युदभ्रं सवितुः श्लिष्टं वातहतं यथा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169581, "chapter_id": 4626, "verse_number": "४५", "content_sanskrit": "तदङ्गं पुरुषेन्द्रस्य भ्रष्टवर्म व्यरोचत ।\nरत्नैरलङ्कृतं दिव्यैर्व्यभ्रं निशि यथाम्बरम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2169582, "chapter_id": 4626, "verse_number": "४६", "content_sanskrit": "छिन्नवर्मा शरैः पार्थो रुधिरेण समुक्षितः ।\nक्रुद्धः सर्वायसीं शक्तिं चिक्षेपाधिरथिं प्रति\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2169583, "chapter_id": 4626, "verse_number": "४७", "content_sanskrit": "तां ज्वलन्तीमिवाकाशे शरैश्चिच्छेद सप्तभिः ।\nसा छिन्ना भूमिमपतन्महेष्वासस्य सायकैः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2169584, "chapter_id": 4626, "verse_number": "४८", "content_sanskrit": "ततो बाह्वोर्ललाटे च हृदि चैव युधिष्ठिरः ।\nचतुर्भिस्तोमरैः कर्णं ताडयित्वाऽनदन् मुदा\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2169585, "chapter_id": 4626, "verse_number": "४९", "content_sanskrit": "उद्भिन्नरुधिरः कर्णः क्रुद्धः सर्प इव श्वसन् ।\nध्वजं चिच्छेद भल्लेन त्रिभिर्विव्याध तं शरैः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2169586, "chapter_id": 4626, "verse_number": "५०", "content_sanskrit": "हत्वा सूतं च पार्थस्य पृष्ठगोपं च सायकैः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2169587, "chapter_id": 4626, "verse_number": "५१", "content_sanskrit": "इषुधी चास्य चिच्छेद रथं च तिलशोऽच्छिनत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2169588, "chapter_id": 4626, "verse_number": "५२", "content_sanskrit": "कालवालास्तु ये पार्थं दन्तवर्णावहन्हयाः ।\nतैर्युक्तं रथमास्थाय प्रायाद् राजा पराङ्मुखः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2169589, "chapter_id": 4626, "verse_number": "५३", "content_sanskrit": "एवं पार्थो व्यपायात् स निहतप्रार्ष्टिसारथिः ।\nअशक्नुवन् प्रमुखतः स्थातुं कर्णस्य दुर्मनाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2169590, "chapter_id": 4626, "verse_number": "५४", "content_sanskrit": "तमभिद्रुत्य राधेयः स्कन्धं संस्पृश्य पाणिना ।\nअब्रवीत्प्रहसन् राजन् कुत्सयन्निव पाण्डवम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2169591, "chapter_id": 4626, "verse_number": "५५", "content_sanskrit": "कथं नाम कुले जातः क्षत्रधर्मे व्यवस्थितः ।\nप्रजह्यात् समरे शत्रून् प्राणान् रक्षन् महाहवे\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2169592, "chapter_id": 4626, "verse_number": "५६", "content_sanskrit": "न भवान् क्षत्रधर्मेषु कुशलोऽसीति मे मतिः ।\nब्राह्मे बले भवान् युक्तः स्वाध्याये यज्ञकर्मणि\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2169593, "chapter_id": 4626, "verse_number": "५७", "content_sanskrit": "मा स्म युध्यस्व कौन्तेय मा च वीरान् समासदः ।\nमा चैनानप्रियं ब्रूहि मा च व्रज महारणम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2169594, "chapter_id": 4626, "verse_number": "५८", "content_sanskrit": "एवमुक्त्वा ततः पार्थं विसृज्य च महाबलः ।\nन्यहनत् पाण्डवीं सेनां वज्रहस्त इवासुरीम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2169595, "chapter_id": 4626, "verse_number": "५९", "content_sanskrit": "ततः प्रायाद् द्रुतं राजन् व्रीडन्निव जनेश्वरः ।\nअथ प्रयान्तं राजानमन्वयुस्ते तदाच्युतम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2169596, "chapter_id": 4626, "verse_number": "६०", "content_sanskrit": "चेदिपाण्डवपाञ्चालाः सात्यकिश्च महारथः ।\nद्रौपदेयास्तथा शूरा माद्रीपुत्रौ च पाण्डवौ\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2169597, "chapter_id": 4626, "verse_number": "६१", "content_sanskrit": "ततो युधिष्ठिरानीकं दृष्ट्वा कर्णः पराङ्मुखम् ।\nकुरुभिः सहितो वीरैः प्रहृष्टः पृष्ठतोऽन्वगात्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2169598, "chapter_id": 4626, "verse_number": "६२", "content_sanskrit": "शङ्खभेरीनिनादैश्च कार्मुकाणां च निस्वनैः ।\nबभूव धार्तराष्ट्राणां सिंहनादरवस्तदा\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2169599, "chapter_id": 4626, "verse_number": "६३", "content_sanskrit": "युधिष्ठिरस्तु कौरव्य रथमारुह्य सत्वरः ।\nश्रुतकीर्तेर्महाराज दृष्टवान् कर्णविक्रमम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2169600, "chapter_id": 4626, "verse_number": "६४", "content_sanskrit": "काल्यमानं बलं दृष्ट्वा धर्मराजो युधिष्ठिरः ।\nतान्योधानब्रवीत् क्रुद्धो निघ्नतैतान् कियानसौ\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2169601, "chapter_id": 4626, "verse_number": "६५", "content_sanskrit": "ततो राज्ञाभ्यनुज्ञाताः पाण्डवानां महारथाः ।\nभीमसेनमुखा सर्वे पुत्रांस्ते प्रत्युपाद्रवन्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2169602, "chapter_id": 4626, "verse_number": "६६", "content_sanskrit": "अभवत्तुमुलः शब्दो योधानां तत्र भारत ।\nहस्त्यश्वरथपत्तीनां शस्त्राणां च ततस्ततः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2169603, "chapter_id": 4626, "verse_number": "६७", "content_sanskrit": "उत्तिष्ठत प्रहरत प्रैताभिपततेति च ।\nइति ब्रुवाणा अन्योन्यं जघ्नुर्योधा रणाजिरे\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2169604, "chapter_id": 4626, "verse_number": "६८", "content_sanskrit": "अभ्रच्छायेव तत्रासीच्छरवृष्टिभिरम्बरे ।\nसमावृत्तैर्नरवरैर्निघ्नद्भिरितरेतरम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2169605, "chapter_id": 4626, "verse_number": "६९", "content_sanskrit": "विपताकाध्वजच्छत्रा व्यश्वसूतायुधा रणे ।\nविशीर्णावयवाः पेतुः क्षितौ क्षीणा हतेश्वराः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2169606, "chapter_id": 4626, "verse_number": "७०", "content_sanskrit": "प्रवणादिव शैलानां शिखराणि द्विपोत्तमाः ।\nसारोहा निहताः पेतुर्वज्रभिन्ना इवाद्रयः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2169607, "chapter_id": 4626, "verse_number": "७१", "content_sanskrit": "छिन्नभिन्नविपर्यस्तैर्वर्मालङ्कारविग्रहैः ।\nसारोहास्तुरगाः पेतुर्हतवीराः सहस्रशः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2169608, "chapter_id": 4626, "verse_number": "७२", "content_sanskrit": "विप्रविद्धायुधाङ्गाश्च द्विरदाश्वरथैर्हताः ।\nप्रतिवीरैश्च सम्मर्दे पत्तिसङ्घाः सहस्रशः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2169609, "chapter_id": 4626, "verse_number": "७३", "content_sanskrit": "विशालायतताम्राक्षैः पद्मेन्दुसदृशाननैः ।\nशिरोभिर्युद्धशौण्डानां सर्वतः संवृता मही\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2169610, "chapter_id": 4626, "verse_number": "७४", "content_sanskrit": "यथा भुवि तथा व्योम्नि निस्वनं शुश्रुवुर्जनाः ।\nविमानैरप्सरःसङ्घैर्गीतवादित्रनिस्वनैः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2169611, "chapter_id": 4626, "verse_number": "७५", "content_sanskrit": "हतान् अभिमुखान् वीरान् वीरैः शतसहस्रशः ।\nआरोप्यारोप्य गच्छन्ति विमानेष्वप्सरोगणाः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2169612, "chapter_id": 4626, "verse_number": "७६", "content_sanskrit": "तद् दृष्ट्वा महदाश्चर्यं प्रत्यक्षं स्वर्गलिप्सया ।\nप्रहृष्टमनसः शूराः क्षिप्रं जग्मुः परस्परम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2169613, "chapter_id": 4626, "verse_number": "७७", "content_sanskrit": "रथिनो रथिभिः सार्धं चित्रं युयुधुराहवे ।\nपत्तयः पत्तिभिर्नागा नागैः सह हयैर्हयाः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2169614, "chapter_id": 4626, "verse_number": "७८", "content_sanskrit": "एवं प्रवृत्ते सङ्ग्रामे गजवाजिजनक्षये ।\nसैन्ये च रजसा व्याप्ते स्वे स्वान् जघ्नुः परे परान्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2169615, "chapter_id": 4626, "verse_number": "७९", "content_sanskrit": "कचाकचि बभौ युद्धं दन्तादन्ति नखानखि ।\nमुष्टियुद्धं नियुद्धं च देहपाप्मविनाशनम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2169616, "chapter_id": 4626, "verse_number": "८०", "content_sanskrit": "तथा वर्तति सङ्ग्रामे गजवाजिजनक्षये ।\nनराश्वगजदेहेभ्यः प्रसृता लोहितापगा\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2169617, "chapter_id": 4626, "verse_number": "८१", "content_sanskrit": "गजाश्वनरदेहान् सा व्युवाह पतितान् बहून्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2169618, "chapter_id": 4626, "verse_number": "८२", "content_sanskrit": "नराश्वगजसम्बाधे नराश्वगजसादिनाम् ।\nलोहितोदा महाघोरा नदी लोहितकर्दमा\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2169619, "chapter_id": 4626, "verse_number": "८३", "content_sanskrit": "नराश्वगजदेहान् सा वहन्ती भीरुभीषणी\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2169620, "chapter_id": 4626, "verse_number": "८४", "content_sanskrit": "तस्याः परमपारं च व्रजन्ति विजयैषिणः ।\nगाधेन च प्लवन्तश्च निमज्ज्योन्मज्ज्य चापरे\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2169621, "chapter_id": 4626, "verse_number": "८५", "content_sanskrit": "ते तु लोहितदिग्धाङ्गा रक्तवर्मायुधाम्बराः ।\nसस्नुस्तस्यां पपुश्चान्ये सृङ्मम्लुश्च भरतर्षभ\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2169622, "chapter_id": 4626, "verse_number": "८६", "content_sanskrit": "रथानश्वान्नरान्नागानायुधाभरणानि च ।\nवसनान्यथ वर्माणि वध्यमानान् हतानपि\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2169623, "chapter_id": 4626, "verse_number": "८७", "content_sanskrit": "भूमिं खं द्यां दिशश्चैव प्रायः पश्याम लोहितम्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2169624, "chapter_id": 4626, "verse_number": "८८", "content_sanskrit": "लोहितस्य तु गन्धेन स्पर्शेन च रसेन च ।\nरूपेण चातिरिक्तेन शब्देन च विसर्पता\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2169625, "chapter_id": 4626, "verse_number": "८९", "content_sanskrit": "विषादः सुमहानासीत्प्रायः सैन्यस्य भारत\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2169626, "chapter_id": 4626, "verse_number": "९०", "content_sanskrit": "तत्तु विप्रहतं सैन्यं भीमसेनमुखास्तव ।\nभूयः समाद्रवन्वीराः सात्यकिप्रमुखा रथाः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2169627, "chapter_id": 4626, "verse_number": "९१", "content_sanskrit": "तेषामापततां वेगमविषह्य महात्मनाम् ।\nपुत्राणां ते महत्सैन्यमासीद् राजन् पराङ्मुखम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2169628, "chapter_id": 4626, "verse_number": "९२", "content_sanskrit": "तत्प्रकीर्णरथाश्वेभं नरवाजिसमाकुलम् ।\nविध्वस्तचर्मकवचं प्रविद्धायुधकार्मुकम्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2169629, "chapter_id": 4626, "verse_number": "९३", "content_sanskrit": "व्यद्रवत् तावकं सैन्यं लोड्यमानं समन्ततः ।\nसिंहार्दितं महारण्ये यथा गजकुलं तथा\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2169630, "chapter_id": 4626, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nषट्चत्वारिंशोऽध्यायः ॥४६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]