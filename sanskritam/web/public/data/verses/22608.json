[{"id": 7002608000, "chapter_id": 22608, "verse_number": "४-१३-१", "content_sanskrit": "सूत उवाच ।\nचतुर्हस्तं महायूपं हस्तषोडशनिर्मितम् ।\nवक्ष्ये तं च प्रतिष्ठां च रात्रौ त्रैरात्रिकं यजेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002608001, "chapter_id": 22608, "verse_number": "४-१३-२", "content_sanskrit": "वरुणं सितकुंभे च प्रपाकूपस्य पश्चिमे ।\nगायत्र्या स्नापयेत्पूर्व मापोहिष्ठेति वै क्रमात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002608002, "chapter_id": 22608, "verse_number": "४-१३-३", "content_sanskrit": "गंधद्वारेति गन्धं च अंशुना चेति तैलकम् ।\nमनोन्ना इति कुसुमं धूरसीति च धूपकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002608003, "chapter_id": 22608, "verse_number": "४-१३-४", "content_sanskrit": "कयानेति ददेद्वस्त्रं नैवेद्यं दीपचन्दनम् ।\nआदौ श्राद्धं न कर्तव्यं प्रतिष्ठांते विधीयते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002608004, "chapter_id": 22608, "verse_number": "४-१३-५", "content_sanskrit": "दंपतीभोजनं कुर्याद्वरयेदेकब्राह्मणम् ।\nमंडपे चाष्टहस्ते च कलशं तत्र विन्यसेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002608005, "chapter_id": 22608, "verse_number": "४-१३-६", "content_sanskrit": "पूजयेद्वरुणं देवं नारायणसमन्वितम् ।\nशिवं च पृथिवीं चैव स्वैः स्वैर्मन्त्रैर्यथाक्रमात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002608006, "chapter_id": 22608, "verse_number": "४-१३-७", "content_sanskrit": "ततः कुशकंडिकां कृत्वा स्थालीपाकविधानतः ।\nवरुणं च समभ्यर्च्य जुहुयादाहुतीर्दश ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002608007, "chapter_id": 22608, "verse_number": "४-१३-८", "content_sanskrit": "अन्येषां च स्रुवेणैव दद्यादेकाहुतिं क्रमात् ।\nवरुणस्योक्तवरुणं तत्त्वा यामि ततः परम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002608008, "chapter_id": 22608, "verse_number": "४-१३-९", "content_sanskrit": "वरुणस्योत्तंभनमसीति च आभ्यां देवांस्तथैव च ।\nयेनापावकचक्षसा पंचमं समुदाहृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002608009, "chapter_id": 22608, "verse_number": "४-१३-१०", "content_sanskrit": "रात्रस्य यूपमित्यादि परं च दशमस्तकम् ।\nततः स्विष्टकृतं कृत्वा सप्तजिह्वं चरुं नयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002608010, "chapter_id": 22608, "verse_number": "४-१३-११", "content_sanskrit": "इह वेत्यादिकं पंच ततः पंचाहुतिं हुनेत् ।\nशंभवे च पृथिव्यै च महा राजाय च क्रमात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002608011, "chapter_id": 22608, "verse_number": "४-१३-१२", "content_sanskrit": "चरुपाकेति नैवेद्यं बलिं चैवागुरूदनम् ।\nशंकराय च रुद्राय शर्वाय पशुपतये इति च ।\nउग्राय असनायेति भवाय तद नंतरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002608012, "chapter_id": 22608, "verse_number": "४-१३-१३", "content_sanskrit": "महादेवाय च पुनरीशानायेति च क्रमात् ।\nचरुपाकेति नैवेवं बलिं चैवागुरूदनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002608013, "chapter_id": 22608, "verse_number": "४-१३-१४", "content_sanskrit": "वाक्यपूर्वं सृजेत्तोयं तत्र वाक्करणं शृणु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002608014, "chapter_id": 22608, "verse_number": "४-१३-१५", "content_sanskrit": "दक्षिणां विधिवद् दद्याद्गां च दद्यात्पयस्विनीम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002608015, "chapter_id": 22608, "verse_number": "४-१३-१६", "content_sanskrit": "मंडपे क्षुद्रकूपे च प्रतिष्ठां शृणुत द्विजाः ।\nगणेशं वरुणं कुंभे विधिवत्पूजयेत्सुधीः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002608016, "chapter_id": 22608, "verse_number": "४-१३-१७", "content_sanskrit": "वेष्टयेद्रक्तसूत्रैश्च दद्यायूपं समुत्सृजेत् ।\nदक्षिणां विधिवद् दद्याद्विप्रान्सं पूजयेत्ततः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]