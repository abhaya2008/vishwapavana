[{"id": 7000586000, "chapter_id": 20586, "verse_number": "५-४५-१", "content_sanskrit": "शेष उवाच ।\nगुरुभाषितमाकर्ण्य वृषपर्वरिपुः स्वराट् ।\nज्ञात्वा रामस्य कार्यार्थमागतं पवनात्मजम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000586001, "chapter_id": 20586, "verse_number": "५-४५-२", "content_sanskrit": "भयं तत्याज मनसि वानरात्समुपस्थितम् ।\nजहर्ष चित्ते च भृशं वाचस्पतिमुवाच ह॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000586002, "chapter_id": 20586, "verse_number": "५-४५-३", "content_sanskrit": "इंद्र उवाच ।\nकथं कार्यं सुराधीश द्रोणोऽयं नीयते यदि ।\nदेवानां जीवनं भूयः कथं स्यादिति मे वद॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000586003, "chapter_id": 20586, "verse_number": "५-४५-४", "content_sanskrit": "इदानीं पवनोद्भूतं प्रसादय यथातथम् ।\nरामः प्रीतिं परां याति देवानां च सुखं भवेत्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000586004, "chapter_id": 20586, "verse_number": "५-४५-५", "content_sanskrit": "देवाधिपस्य वचनं श्रुत्वा वाचस्पतिस्तदा ।\nशक्रं तु पुरतः कृत्वा सर्वदेवैः परीवृतम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000586005, "chapter_id": 20586, "verse_number": "५-४५-६", "content_sanskrit": "जगाम तत्र यत्रास्ते हनूमान्निर्भयः कपिः ।\nगर्जति प्रसभं जित्वा सुरान्सर्वान्सुखासिनः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000586006, "chapter_id": 20586, "verse_number": "५-४५-७", "content_sanskrit": "ते गत्वा सन्निधौ तस्य बृहस्पतिपुरोगमाः ।\nपेतुस्ते चरणौ नत्वा समीरतनुजस्य हि॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000586007, "chapter_id": 20586, "verse_number": "५-४५-८", "content_sanskrit": "बृहस्पतिश्च तं वीरं जगाद प्रेरितोऽमुना ।\nसुराधीशेन लोकस्य गुरुणा वदतां वरः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000586008, "chapter_id": 20586, "verse_number": "५-४५-९", "content_sanskrit": "अजानद्भिः कृतं कर्म देवैस्तव पराक्रमम् ।\nश्रीरामचरणस्य त्वं सेवकोऽसि महामते॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000586009, "chapter_id": 20586, "verse_number": "५-४५-१०", "content_sanskrit": "किमर्थमयमारंभः कथमत्र समागमः ।\nतत्करिष्यामहे सर्वे सन्नतास्तव भाषितम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000586010, "chapter_id": 20586, "verse_number": "५-४५-११", "content_sanskrit": "रोषं त्यक्त्वा कृपां कृत्वा देवाधीशं विलोकय ।\nपवनात्मज दैत्यानां भयंकरवपुर्दधत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000586011, "chapter_id": 20586, "verse_number": "५-४५-१२", "content_sanskrit": "शेष उवाच ।\nइत्थं भाषितमाकर्ण्य देवानां स गुरोर्वचः ।\nउवाच देवान्सकलान्गुरुं चैव महयशाः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000586012, "chapter_id": 20586, "verse_number": "५-४५-१३", "content_sanskrit": "राज्ञो वीरमणेः संख्ये हताः शर्वेण भूरिशः ।\nभटास्तान्वै जीवयितुं द्रोणं नेष्यामि पर्वतम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000586013, "chapter_id": 20586, "verse_number": "५-४५-१४", "content_sanskrit": "तं ये निवारयिष्यंति स्ववीर्यबलदर्पिताः ।\nतान्नेष्यामि क्षणादेव यमस्य सदनं प्रति॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000586014, "chapter_id": 20586, "verse_number": "५-४५-१५", "content_sanskrit": "तस्माद्वदत मे यूयं द्रोणं वाथ तदौषधम् ।\nयेन संजीवयिष्यामि मृतान्वीरान्रणांगणे॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000586015, "chapter_id": 20586, "verse_number": "५-४५-१६", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य वायुसूनोर्महात्मनः ।\nते सर्वे प्रणतिं गत्वा ददुः संजीवनौषधम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000586016, "chapter_id": 20586, "verse_number": "५-४५-१७", "content_sanskrit": "ते प्रहृष्टा भयं त्यक्त्वा सुराः स्वर्गौकसः स्वयम् ।\nययुः सुरपतिं कृत्वा पुरः सौख्य समन्विताः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000586017, "chapter_id": 20586, "verse_number": "५-४५-१८", "content_sanskrit": "हनुमान्भेषजं तत्तु समादायागतो रणम् ।\nस्तुतः सर्वैः सुरगणैर्महाकर्मसमुत्सुकैः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000586018, "chapter_id": 20586, "verse_number": "५-४५-१९", "content_sanskrit": "तमागतं हनूमंतं वीक्ष्य सर्वेऽपि वैरिणः ।\nसाधुसाधुप्रशंसंतमद्भुतं मेनिरे कपिम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000586019, "chapter_id": 20586, "verse_number": "५-४५-२०", "content_sanskrit": "कपिः समागत्य महामुदायुतः ।\nपुरो भटं पुष्कलमागतं मृतम् ।\nशिवेन संरक्षितमुग्रमंडले ।\nश्रीरामचित्तं सविधे जगाम ह॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000586020, "chapter_id": 20586, "verse_number": "५-४५-२१", "content_sanskrit": "सुमतिं च समाहूय मंत्रिणं महतां मतम् ।\nउवाच जीवयाम्यद्य सर्वान्वीरान्रणे मृतान्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000586021, "chapter_id": 20586, "verse_number": "५-४५-२२", "content_sanskrit": "एवमुक्त्वा भेषजं तत्पुष्कलस्य महोरसि ।\nशिरः कायेन संधाय जगाद वचनं शुभम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000586022, "chapter_id": 20586, "verse_number": "५-४५-२३", "content_sanskrit": "यद्यहं मनसा वाचा कर्मणा राघवं पतिम् ।\nजानामि तर्हि एतेन भेषजेनाशु जीवतु॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000586023, "chapter_id": 20586, "verse_number": "५-४५-२४", "content_sanskrit": "इति वाक्यं यदा वक्ति तावत्पुष्कल उत्थितः ।\nरणांगणेऽदशद्रोषाद्दंतान्वीरशिरोमणिः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000586024, "chapter_id": 20586, "verse_number": "५-४५-२५", "content_sanskrit": "क्व गतो वीरभद्रोऽसौ मां संमूर्च्छ्य रणांगणे ।\nसद्योऽहं पातयाम्येनं क्वास्ति मे धनुरुत्तमम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000586025, "chapter_id": 20586, "verse_number": "५-४५-२६", "content_sanskrit": "इति तं भाषमाणं वै प्राह वीरं कपींद्रकः ।\nधन्योऽसि वीर यद्भूयो वदस्येनं रणांगणे॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000586026, "chapter_id": 20586, "verse_number": "५-४५-२७", "content_sanskrit": "त्वं हतो वीरभद्रेण रघुनाथप्रसादतः ।\nपुनः संजीवितोऽस्येहि शत्रुघ्नं याम मूर्च्छितम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000586027, "chapter_id": 20586, "verse_number": "५-४५-२८", "content_sanskrit": "इत्युक्त्वा प्रययौ तत्र संग्रामवरमूर्धनि ।\nश्वसन्नास्ते स शत्रुघ्नः शिवबाणप्रपीडितः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000586028, "chapter_id": 20586, "verse_number": "५-४५-२९", "content_sanskrit": "तत्र गत्वा समीपं तच्छत्रुघ्नस्य महात्मनः ।\nनिधाय भेषजं तस्य वक्षसि श्वासमागते॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000586029, "chapter_id": 20586, "verse_number": "५-४५-३०", "content_sanskrit": "उवाच हनुमांस्तं वै जीव शत्रुघ्नसत्तम ।\nमूर्च्छितोऽसि रणे कस्मान्महाबलपराक्रम॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000586030, "chapter_id": 20586, "verse_number": "५-४५-३१", "content_sanskrit": "यद्यहं ब्रह्मचर्यं च जन्मपर्यंतमुद्यतः ।\nपालयामि तदा वीरः शत्रुघ्नो जीवतु क्षणात्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000586031, "chapter_id": 20586, "verse_number": "५-४५-३२", "content_sanskrit": "उक्तमात्रेण तेनेदं जीवितः क्षणमात्रतः ।\nक्व शिवः क्व शिवो यातो विहायरणमंडलम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000586032, "chapter_id": 20586, "verse_number": "५-४५-३३", "content_sanskrit": "अनेके निहताः संख्ये श्रीरुद्रेण पिनाकिना ।\nते सर्वे जीविता वीराः कपीन्द्रेण महात्मना॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000586033, "chapter_id": 20586, "verse_number": "५-४५-३४", "content_sanskrit": "तदा सर्वे सुसन्नद्धा रोषपूरितमानसाः ।\nस्वेस्वे रथे स्थिताः शत्रून्प्रययुः क्षतविग्रहाः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000586034, "chapter_id": 20586, "verse_number": "५-४५-३५", "content_sanskrit": "पुष्कलो वीरभद्रं तु चंडं चैव कुशध्वजः ।\nनंदिनं हनुमान्वीरः शत्रुघ्नः संगरे शिवम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000586035, "chapter_id": 20586, "verse_number": "५-४५-३६", "content_sanskrit": "धनुर्विस्फारयंतं तं शत्रुघ्नं बलिनां वरम् ।\nसंग्रामे शिवमाहूय तिष्ठंतं प्रययौ नृपः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000586036, "chapter_id": 20586, "verse_number": "५-४५-३७", "content_sanskrit": "राजा वीरमणिर्वीरः शत्रुघ्नः समरे बली ।\nअन्योन्यं चक्रतुर्युद्धं मुनिविस्मयकारकम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000586037, "chapter_id": 20586, "verse_number": "५-४५-३८", "content_sanskrit": "राज्ञा च वीरमणिना रथा भग्नाः शताधिकाः ।\nशत्रुघ्नस्य नरेंद्रस्य तिलशः क्षणतो द्विज॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000586038, "chapter_id": 20586, "verse_number": "५-४५-३९", "content_sanskrit": "तदा प्रकुपितोऽत्यंतं शत्रुघ्नो रणमंडले ।\nआग्नेयास्त्रं मुमोचामुं दग्धुं सैन्यसमन्वितम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000586039, "chapter_id": 20586, "verse_number": "५-४५-४०", "content_sanskrit": "दाहकं तन्महद्दृष्ट्वा महास्त्रं शत्रुमोचितम् ।\nअत्यंतं कुपितो राजा वारुणास्त्रं समाददे॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000586040, "chapter_id": 20586, "verse_number": "५-४५-४१", "content_sanskrit": "वारुणास्त्रेण शीतार्तं वीक्ष्य रामानुजो बली ।\nवायव्यास्त्रं मुमोचास्मै तेन वायुर्महानभूत्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000586041, "chapter_id": 20586, "verse_number": "५-४५-४२", "content_sanskrit": "वायुना संहता मेघा ययुस्ते सर्वतोदिशम् ।\nइतस्ततो गताः सर्वे सैन्यं तत्सुखितं बभौ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000586042, "chapter_id": 20586, "verse_number": "५-४५-४३", "content_sanskrit": "सैन्ये पवनपीडार्ते नृपो वीरमतिर्महान् ।\nपर्वतास्त्रं रिपूद्धारि जग्राह च शरासने॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000586043, "chapter_id": 20586, "verse_number": "५-४५-४४", "content_sanskrit": "पर्वतैः स्तंभितो वायुर्न चासर्पत संगरे ।\nतद्वीक्ष्य रामावरजो वज्रास्त्रं तु समाददे॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000586044, "chapter_id": 20586, "verse_number": "५-४५-४५", "content_sanskrit": "वज्रास्त्रेण हताः सर्वे नगास्तु तिलशः कृताः ।\nचूर्णतां प्रापुरेतस्मिन्रणे वीरवरार्चिते॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000586045, "chapter_id": 20586, "verse_number": "५-४५-४६", "content_sanskrit": "वज्रास्त्रेण विदीर्णांगा वीराः शोणितशोभिताः ।\nबभूवुः समरप्रांते चित्रं समभवद्रणम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000586046, "chapter_id": 20586, "verse_number": "५-४५-४७", "content_sanskrit": "तदा प्रकुपितोऽत्यंतं राजा वीरमणिर्महान् ।\nब्रह्मास्त्रं चाप आधत्त वैरिदाहकमद्भुतम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000586047, "chapter_id": 20586, "verse_number": "५-४५-४८", "content_sanskrit": "शत्रुघ्नः शरमादाय सस्मार सुमनोहरम् ।\nअस्त्रं तद्योगिनीदत्तं सर्ववैरिविमोहनम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000586048, "chapter_id": 20586, "verse_number": "५-४५-४९", "content_sanskrit": "ब्रह्मास्त्रं तत्करभ्रष्टमागतं वैरिणं प्रति ।\nतावच्छत्रुघ्ननाम्ना तु तन्मुक्तं मोहनास्त्रकम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000586049, "chapter_id": 20586, "verse_number": "५-४५-५०", "content_sanskrit": "मोहनास्त्रेण तद्ब्राह्मं द्विधाछिन्नं क्षणादिह ।\nलग्नं राज्ञो हृदि क्षिप्रं मूर्च्छां संप्रापयन्नृपम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000586050, "chapter_id": 20586, "verse_number": "५-४५-५१", "content_sanskrit": "ते बाणाः शतशो मुक्ताः शत्रुघ्नेन महीभृता ।\nसर्वेपि मूर्च्छिता वीरा गणा रुद्रस्य ये पुनः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000586051, "chapter_id": 20586, "verse_number": "५-४५-५२", "content_sanskrit": "शिवस्य चरणोपस्थे मूढाः पेतुर्महीतले ।\nतदा शिवः प्रकुपितो रथे तिष्ठन्ययौ नृपम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000586052, "chapter_id": 20586, "verse_number": "५-४५-५३", "content_sanskrit": "शिवेन सहसा योद्धुं समायातो रणांगणे ।\nशत्रुघ्नः सज्जमात्तज्यं धनुः कृत्वा व्ययुद्ध्यत॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000586053, "chapter_id": 20586, "verse_number": "५-४५-५४", "content_sanskrit": "तयोः समभवद्युद्धं घोरं वैरिविदारणम् ।\nशस्त्रास्त्रैर्बहुधामुक्तैरादीपित दिगंतरम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000586054, "chapter_id": 20586, "verse_number": "५-४५-५५", "content_sanskrit": "अस्त्रप्रत्यस्त्रसंघातैस्ताडनप्रतिताडनैः ।\nदेवानामपि दैत्यानां नैतादृग्रणमंडलम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000586055, "chapter_id": 20586, "verse_number": "५-४५-५६", "content_sanskrit": "तदा व्याकुलितोऽत्यंतं शत्रुघ्नः शिवसंगरे ।\nसस्मार स्वामिनं तत्र पावनेरुपदेशतः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000586056, "chapter_id": 20586, "verse_number": "५-४५-५७", "content_sanskrit": "हा नाथ भ्रातरत्युग्रः शिवः प्राणापहारणम् ।\nकरोति धनुरुद्यम्य त्रायस्व रणमंडले॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000586057, "chapter_id": 20586, "verse_number": "५-४५-५८", "content_sanskrit": "अनेके दुःखपाथोधिं तीर्णा राम तवाख्यया ।\nमामप्युद्धर दुःखस्थं रामराम कृपानिधे॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000586058, "chapter_id": 20586, "verse_number": "५-४५-५९", "content_sanskrit": "इत्थं वक्ति यदा तावद्वीक्षितो रणमंडले ।\nनीलोत्पलदलश्यामो रामो राजीवलोचनः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000586059, "chapter_id": 20586, "verse_number": "५-४५-६०", "content_sanskrit": "मृगशृंगं कटौ धृत्वा दीक्षितं वपुरुद्वहन् ।\nतं दृष्ट्वा विस्मयं प्राप शत्रुघ्नः समरांगणे॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]