[{"id": 6000292000, "chapter_id": 10292, "verse_number": null, "content_sanskrit": "अथ षण्णवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000292001, "chapter_id": 10292, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.001.m4a", "display_order": 2}, {"id": 6000292002, "chapter_id": 10292, "verse_number": "१०-९६-१", "content_sanskrit": "ब्रह्मन् ब्रह्मण्यनिर्देश्ये निर्गुणे गुणवृत्तयः।\nकथं चरन्ति श्रुतयः साक्षात् सदसतः परे॥ १०/९६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.002.m4a", "display_order": 3, "topics": [{"text": "श्रुतिगीता", "range": "१–५१"}]}, {"id": 6000292003, "chapter_id": 10292, "verse_number": "१०-९६-२", "content_sanskrit": "बुद्धीन्द्रियमनःप्राणान् जनानामसृजत् प्रभुः।\nमात्रार्थं च भवार्थं च आत्मने कल्पनाय च॥ १०/९६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.003.m4a", "display_order": 4}, {"id": 6000292004, "chapter_id": 10292, "verse_number": "१०-९६-३", "content_sanskrit": "सैषा ह्युपनिषद् ब्राह्मी पूर्वेषां पूर्वजैर्धृता।\nश्रद्धया धारयेद् यस्तां क्षेमं गच्छेदकिञ्चनः॥ १०/९६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.004.m4a", "display_order": 5}, {"id": 6000292005, "chapter_id": 10292, "verse_number": "१०-९६-४", "content_sanskrit": "अत्र ते वर्णयिष्यामि गाथां नारायणोदिताम्।\nनारदस्य च संवादमृषेर्नारायणस्य च॥ १०/९६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.005.m4a", "display_order": 6}, {"id": 6000292006, "chapter_id": 10292, "verse_number": "१०-९६-५", "content_sanskrit": "एकदा नारदो लोकान् पर्यटन् भगवत्प्रियः।\nसनातनमृषिं द्रष्टुं ययौ नारायणाश्रमम्॥ १०/९६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.006.m4a", "display_order": 7}, {"id": 6000292007, "chapter_id": 10292, "verse_number": "१०-९६-६", "content_sanskrit": "योऽसौ भारतवर्षेऽस्मिन् क्षेमाय स्वस्तये नृणाम्।\nधर्मज्ञानशमोपेतः साकल्यादास्थितस्तपः॥ १०/९६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.007.m4a", "display_order": 8}, {"id": 6000292008, "chapter_id": 10292, "verse_number": "१०-९६-७", "content_sanskrit": "तत्रोपविष्टमृषिभिः कलापग्रामवासिभिः।\nपरीतं प्रणतोऽपृच्छदिदमेव कुरूद्वह॥ १०/९६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.008.m4a", "display_order": 9}, {"id": 6000292009, "chapter_id": 10292, "verse_number": "१०-९६-८", "content_sanskrit": "तस्मा अवोचद् भगवान् ऋषीणां शृण्वतामिमाम्।\nयो ब्रह्मवादः पूर्वेषां जनलोकनिवासिनाम्॥ १०/९६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.009.m4a", "display_order": 10}, {"id": 6000292010, "chapter_id": 10292, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.010.m4a", "display_order": 11}, {"id": 6000292011, "chapter_id": 10292, "verse_number": "१०-९६-९", "content_sanskrit": "स्वायम्भुवं ब्रह्मसत्रं जनलोकेऽभवत् पुरा।\nतत्रत्यानां मानसानां मुनीनामूर्ध्वरेतसाम्॥ १०/९६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.011.m4a", "display_order": 12}, {"id": 6000292012, "chapter_id": 10292, "verse_number": "१०-९६-१०", "content_sanskrit": "श्वेतद्वीपं गतवति त्वयि द्रष्टुं तमीश्वरम्।\nब्रह्मवादः सम्प्रवृत्तः श्रुतयो यत्र शेरते॥ १०/९६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.012.m4a", "display_order": 13}, {"id": 6000292013, "chapter_id": 10292, "verse_number": "१०-९६-११", "content_sanskrit": "तत्राप्ययमभूत् प्रश्नस्त्वं मां यदनुपृच्छसि।\nतुल्यश्रुततपःशीलास्तुल्यस्वीयारिमध्यमाः॥ १०/९६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.013.m4a", "display_order": 14}, {"id": 6000292014, "chapter_id": 10292, "verse_number": "१०-९६-१२", "content_sanskrit": "अपि चक्रुः प्रवचनमेकं शुश्रूषवोऽपरे॥ १०/९६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.014.m4a", "display_order": 15}, {"id": 6000292015, "chapter_id": 10292, "verse_number": null, "content_sanskrit": "सनन्दन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.015.m4a", "display_order": 16}, {"id": 6000292016, "chapter_id": 10292, "verse_number": "१०-९६-१३", "content_sanskrit": "स्वसृष्टमिदमापीय शयानं सहशक्तिभिः।\nतदन्ते बोधयाञ्चक्रुस्तल्लिङ्गैः श्रुतयः परम्॥ १०/९६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.016.m4a", "display_order": 17}, {"id": 6000292017, "chapter_id": 10292, "verse_number": "१०-९६-१४", "content_sanskrit": "यथा शयानं सम्राजं वन्दिनस्तत्पराक्रमैः।\nप्रत्यूषेऽभ्येत्य सुश्लोकैर्बोधयन्त्यनुजीविनः॥ १०/९६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.017.m4a", "display_order": 18}, {"id": 6000292018, "chapter_id": 10292, "verse_number": null, "content_sanskrit": "श्रुतय ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.018.m4a", "display_order": 19}, {"id": 6000292019, "chapter_id": 10292, "verse_number": "१०-९६-१५", "content_sanskrit": "जय जय जह्यजामजित दोषगृहीतगुणां त्वमसि यदात्मना समवरुद्धसमस्तभगः।\nअज जगदोकसामखिलशक्त्यबोधक ते क्‍वचिदजयाऽऽत्मनाऽनुचरतोऽनुचरेन्निगमः॥ १०/९६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.019.m4a", "display_order": 20}, {"id": 6000292020, "chapter_id": 10292, "verse_number": "१०-९६-१६", "content_sanskrit": "बृहदुपलब्धमेतदवशेषतया यत उदगास्तमस्यविकृतेऽविकृतः।\nअत ऋषयो दधुस्त्वयि मनोवचनाचरितं कथमयथा भवन्ति भुवि दत्तपदानि नृणाम्॥ १०/९६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.020.m4a", "display_order": 21}, {"id": 6000292021, "chapter_id": 10292, "verse_number": "१०-९६-१७", "content_sanskrit": "इति सूरयस्‍त्र्यधिपतेऽखिललोकमलक्षपणं तव कथामृताब्धिमवगाह्य तपांसि जहुः।\nकिमुत पुनः स्वधामविधुताशयकालगुणाः परम भजन्ति ये पदमजस्रसुखानुभवम्॥ १०/९६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.021.m4a", "display_order": 22}, {"id": 6000292022, "chapter_id": 10292, "verse_number": "१०-९६-१८", "content_sanskrit": "दृतय इवोच्छ्वसन्त्यसुहृदो यदि ते महदहमादयोऽण्डमसृजन् यदनुग्रहतः।\nपुरुषविधान्वयोऽत्र चरमोत्तममध्यमादिषु यस्तव सदसतः परं प्रथयेदविशेषमृतम्॥ १०/९६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.022.m4a", "display_order": 23}, {"id": 6000292023, "chapter_id": 10292, "verse_number": "१०-९६-१९", "content_sanskrit": "उदरमुपासते यर्हि वर्त्मनि सूक्ष्मदृशः परिसरपद्धतिं हृदयमारुणयो दहरम्।\nतत उदगाच्च नन्दनपथाऽथ शिरः परमं पुनरिह यत् समेत्य न पतन्ति कृतान्तमुखे॥ १०/९६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.023.m4a", "display_order": 24}, {"id": 6000292024, "chapter_id": 10292, "verse_number": "१०-९६-२०", "content_sanskrit": "स्वकृतविचित्रयोनिषु विशन्निव हेतुतया भरतमतश्चकास्स्यनलवत् स्वकृतानुकृतिः।\nअपि वितथास्वमूष्ववितथोरुविधं मनसि निकटधियो नयन्त्यभिविपत्य तव॥ १०/९६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.024.m4a", "display_order": 25}, {"id": 6000292025, "chapter_id": 10292, "verse_number": "१०-९६-२१", "content_sanskrit": "प्रक्रमवत् स्वसत्कृतं पुरुषेषु धीषु तु बहिरन्तरसच्चरणे।\nतव पुरुष वदन्त्यखिलशक्तिधृतः स्वकृतम्॥ १०/९६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.025.m4a", "display_order": 26}, {"id": 6000292026, "chapter_id": 10292, "verse_number": "१०-९६-२२", "content_sanskrit": "इति विमृशन्ति कवयो निगमावपनं भजन्त उपासते भवमध्यविनिःश्वसिताः।\nदुरवगमात्मतत्वनिगमायतवाङ्मनसश्चरितमहामृताब्धिपरिवर्तपरिश्रमणाः॥ १०/९६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.026.m4a", "display_order": 27}, {"id": 6000292027, "chapter_id": 10292, "verse_number": "१०-९६-२३", "content_sanskrit": "न परिलषन्ति केचिदपवर्गमपीश्वर ते चरणसरोजहंसकुलसङ्गविसृष्टगृहाः।\nत्वदनुपथं कुलायमिदमात्मसुहृत् प्रियवच्चरन्ति तथोन्मुखास्त्वयि हिते प्रिय आत्मनि च॥ १०/९६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.027.m4a", "display_order": 28}, {"id": 6000292028, "chapter_id": 10292, "verse_number": "१०-९६-२४", "content_sanskrit": "न च रमन्त्यहो असदुपासनयाऽऽत्महनो यदनुशया भ्रमन्त्यभवाः कुशरीरभृतः।\nनिभृतमोक्षहृदययोगयुजो हृदयं मुनय उपासते तदरयोऽपि ययुः॥ १०/९६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.028.m4a", "display_order": 29}, {"id": 6000292029, "chapter_id": 10292, "verse_number": "१०-९६-२५", "content_sanskrit": "स्मरणात्स्वनुराग तद् भवान् उरगेन्द्रभोगदण्डविषक्तधियो\nवयमपि ते समासमदृशोऽङ्घ्रिसरोजसुधाम्।\nक इह नु वेद वक्तुमपेतजन्मलयो यत उदगाद् ऋषिरनु देवगणा उभये॥ १०/९६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.029.m4a", "display_order": 30}, {"id": 6000292030, "chapter_id": 10292, "verse_number": "१०-९६-२६", "content_sanskrit": "तर्हि न सन्न चासदुभयं न च कालजवः किमपि न तत्र शास्‍त्रमपकृष्य शयीत यदा।\nजनिमसतः सतो मृतिमजात्मनि ये च भिदां विपणमृते स्मरन्त्युपविश ध्वनिमारुवतः॥ १०/९६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.030.m4a", "display_order": 31}, {"id": 6000292031, "chapter_id": 10292, "verse_number": "१०-९६-२७", "content_sanskrit": "त्रिगुणमयः पुमानिति यदबोधकृता त्वयि न भवेत् तदवबोधरसे।\nसदिव मनस्‍त्रिवृत् त्वयि भवत्यसतां मनुजादयो विमृशन्त्यशेषमिदमार्ततयाऽऽत्मविदः॥ १०/९६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.031.m4a", "display_order": 32}, {"id": 6000292032, "chapter_id": 10292, "verse_number": "१०-९६-२८", "content_sanskrit": "न हि विकृतं त्यजन्ति कनकस्य तदात्मतया स्वकृतमनुप्रविष्ट इदमात्मतया रसितम्।\nतव ये परिचरन्त्यखिलतत्वनिकेततया ननु ते पदाऽऽक्रमन्त्यविगणय्य शिरो निर्ऋतेः॥ १०/९६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.032.m4a", "display_order": 33}, {"id": 6000292033, "chapter_id": 10292, "verse_number": "१०-९६-२९", "content_sanskrit": "परिवयसे पशूनिव गिरा विबुधानपि तांस्त्वयि दृढसौहृदा ननु पुनन्ति न ते विमुखाः।\nत्वमेकः स्वराडखिलकारकशक्तिधरस्तव बलिमुद्वहन्ति समदन्ति च येऽनिमिषाः॥ १०/९६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.033.m4a", "display_order": 34}, {"id": 6000292034, "chapter_id": 10292, "verse_number": "१०-९६-३०", "content_sanskrit": "वर्षभुजोऽखिलक्षितिपतेरिव विश्वसृजो विदधति यत्र ये त्वधिकृता भवतश्चकिताः।\nस्थिरचरजातयः स्युरज ये त्वनिमित्तयुजो विरह उदीक्षयेत् यदि परस्य विमुक्तसतः॥ १०/९६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.034.m4a", "display_order": 35}, {"id": 6000292035, "chapter_id": 10292, "verse_number": "१०-९६-३१", "content_sanskrit": "न हि परमस्य कश्चिदपरोऽनपरस्य भवेत् व्ययत इवात्र यस्य च शून्यतुल सन्दधतः।\nअपरिमिता ध्रुवास्तनुभृतो यदि सर्व ततो न हि न शास्यतेति नियमो ब्रुवते च तथा॥ १०/९६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.035.m4a", "display_order": 36}, {"id": 6000292036, "chapter_id": 10292, "verse_number": "१०-९६-३२", "content_sanskrit": "अजन परिमुच्यतेऽत्र भवात् सततात् सममनुजानता ततमनन्तमदुष्टतया।\nन घटत उद्भवः प्रकृतिपूरुषयोरजयोरुभययुजोर्भवन्त्यसुभृतो जलबुद्बुदवत्॥ १०/९६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.036.m4a", "display_order": 37}, {"id": 6000292037, "chapter_id": 10292, "verse_number": "१०-९६-३३", "content_sanskrit": "त्वयि त इमे ततो विबुधनामगुणाः परमे अमृत इवार्णवे मधुनि लिल्युरशेषरसाः।\nनृषु तव मायया स्वगतया कुशलं त्वयि सुधियोऽङ्ग भेदमनुविधातुमनु प्रभवः।\nकथमनुवर्तिनां भवभयं तव भ्रुकुटी सृजति मुहुर्नृणाम्॥ १०/९६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.037.m4a", "display_order": 38}, {"id": 6000292038, "chapter_id": 10292, "verse_number": "१०-९६-३४", "content_sanskrit": "इह भवच्चरणेषु सुजातभुवो जितहृषीकवायुभिरुदात्तमहत्तुरगैः।\nय इह यतन्त्यमतिलोलमुपायविदो व्यसनशताब्धितारमपहाय गुरोश्चरणम्॥ १०/९६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.038.m4a", "display_order": 39}, {"id": 6000292039, "chapter_id": 10292, "verse_number": "१०-९६-३५", "content_sanskrit": "वणिज इवोच्छ्वसन्त्यकृतकर्णधरा जलधौ स्वजनसुतात्मदारधनधामधराः।\nसुखशान्तिमति त्वयि हि सन्ति न तानि नृणां विभव उद्यति श्रयत आत्मनि सर्वरसे॥ १०/९६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.039.m4a", "display_order": 40}, {"id": 6000292040, "chapter_id": 10292, "verse_number": "१०-९६-३६", "content_sanskrit": "इति सदजानतां मिथुनतो रतये चरतां सुखयति को न्विहाद्य विजने स्वनिरस्तभगे।\nभुवि पुण्यतीर्थसदना ह्यृषयो निविशन्त्यतस्तु भवतः पदाम्बुजं हृदाऽघभिदम्।\nदधति सकृन्मनस्त्वयि चिदात्मनि नित्यसुखे न पुनरुपासते पुरुषसार हरावसथम्॥ १०/९६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.040.m4a", "display_order": 41}, {"id": 6000292041, "chapter_id": 10292, "verse_number": "१०-९६-३७", "content_sanskrit": "इदमप्यथो वदन्ति चेन्ननु तर्का व्यभिचरन्ति क्‍वचित् क्‍वचिन्मृषा च।\nततो भयदृग्व्यवहितये विकल्प उषितोऽन्वहमन्धपरम्परया भ्रमति भारती च तवोरुवृत्तिभिरूढजवा॥ १०/९६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.041.m4a", "display_order": 42}, {"id": 6000292042, "chapter_id": 10292, "verse_number": "१०-९६-३८", "content_sanskrit": "न यदिदमग्र आस न भविष्यदतो निधनादनिमित्तकमन्तरा त्वयि विभाति मृषैकरसे।\nअत उपगीयते द्रविणजातिविकल्पपथैर्वितथमनोविलासमिदमित्यवयन्ति बुधाः॥ १०/९६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.042.m4a", "display_order": 43}, {"id": 6000292043, "chapter_id": 10292, "verse_number": "१०-९६-३९", "content_sanskrit": "उदगात् पुमाननुगीतगुणांश्च जुषन् भजति सरूपतां तदनु जहासि जिहासि ताम्।\nअहिरिव त्वचं परमात्तभगां महसि महीयसेऽष्टगुणोऽपरिमेयभगः॥ १०/९६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.043.m4a", "display_order": 44}, {"id": 6000292044, "chapter_id": 10292, "verse_number": "१०-९६-४०", "content_sanskrit": "यदि न समुच्चरन्ति यतयोऽपि हृदि कामजडात्दुरधिगमोऽसतां हृदि गतोऽस्मृतकण्ठमणिः।\nअनुतृप्तयोगिनामभयो भगवन् अनवगतान्तकादनधिरूढपदाद् भवतः॥ १०/९६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.044.m4a", "display_order": 45}, {"id": 6000292045, "chapter_id": 10292, "verse_number": "१०-९६-४१", "content_sanskrit": "तदवगमार्थसितासितयोर्गुणविगुणयोर्न हि देहभृतां सगिरः अनुययुरत्र हंसकुलगीतपरम्परया।\nन तुषावरणा इव रजांसि वान्ति वयसा सह यच्छ्रुतयस्त्वयि सफलं पतन्ति न पतन्ति बन्धनाः॥ १०/९६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.045.m4a", "display_order": 46}, {"id": 6000292046, "chapter_id": 10292, "verse_number": "१०-९६-४२", "content_sanskrit": "इत्येतद् ब्रह्मणः पुत्रा आश्रुत्यात्मानुशासनम्।\nसनन्दनमथानर्चुः हृदिज्ञात्वाऽऽत्मनो गतिम्॥ १०/९६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.046.m4a", "display_order": 47}, {"id": 6000292047, "chapter_id": 10292, "verse_number": "१०-९६-४३", "content_sanskrit": "इत्यशेषसमाम्नायपुराणोपनिषद्रसः।\nसमुद्धृतः पूर्वजैस्तैर्व्योमायनमहात्मभिः॥ १०/९६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.047.m4a", "display_order": 48}, {"id": 6000292048, "chapter_id": 10292, "verse_number": "१०-९६-४४", "content_sanskrit": "त्वं चैतद् ब्रह्मदायाद श्रद्धयाऽऽत्मानुशासनम्।\nधारयन् भजमे कामं कामानां निधनं नृणाम्॥ १०/९६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.048.m4a", "display_order": 49}, {"id": 6000292049, "chapter_id": 10292, "verse_number": "१०-९६-४५", "content_sanskrit": "एवं स गुरुणाऽऽदिष्टो गृहीत्वा श्रद्धयाऽऽत्मवान्।\nपूूर्णः सद्यस्ततो राजन् प्राह वीरव्रतो गुरुम्॥ १०/९६/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.049.m4a", "display_order": 50}, {"id": 6000292050, "chapter_id": 10292, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.050.m4a", "display_order": 51}, {"id": 6000292051, "chapter_id": 10292, "verse_number": "१०-९६-४६", "content_sanskrit": "नमस्तस्मै भगवते कृष्णायामलमूर्तये।\nयो धाता सर्वभूूतानामभयो यस्य ते कलाः॥ १०/९६/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.051.m4a", "display_order": 52}, {"id": 6000292052, "chapter_id": 10292, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.052.m4a", "display_order": 53}, {"id": 6000292053, "chapter_id": 10292, "verse_number": "१०-९६-४७", "content_sanskrit": "इत्याद्यमृषिमामन्त्र्य तच्छिष्यांश्चामलात्मकान्।\nततोऽगादाश्रमं साक्षात् पितुर्द्वैपायनस्य मे॥ १०/९६/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.053.m4a", "display_order": 54}, {"id": 6000292054, "chapter_id": 10292, "verse_number": "१०-९६-४८", "content_sanskrit": "सभाजितो भगवता कृतासनपरिग्रहः।\nतस्मै तद् वर्णयामास नारायणमुखाच्छ्रुतम्॥ १०/९६/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.054.m4a", "display_order": 55}, {"id": 6000292055, "chapter_id": 10292, "verse_number": "१०-९६-४९", "content_sanskrit": "तदेतद् वर्णितं राजन् यश्च प्रश्नः कृतस्त्वया।\nयेन ब्रह्मण्यनिर्देश्ये निर्गुणेऽपि मनश्चरेत्॥ १०/९६/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.055.m4a", "display_order": 56}, {"id": 6000292056, "chapter_id": 10292, "verse_number": "१०-९६-५०", "content_sanskrit": "यो ह्यात्मा जगदादिमध्यनिधनो योऽव्यक्तजीवेश्वरो\nयः सृष्ट्वेदमनुप्रविष्ट ऋषिणा चक्रे पुनः संहिताम्।\nयं सम्पद्य जहात्यजामनुशयी सुप्तः कुलायं यथा\nतं कैवल्यनिरस्तयोनिमभयं ध्यायेदजस्रं हरिम्॥ १०/९६/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_096/BhP_10.096.056.m4a", "display_order": 57}, {"id": 6000292057, "chapter_id": 10292, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे षण्णवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]