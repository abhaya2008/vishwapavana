[{"id": 2002160, "chapter_id": 1044, "verse_number": "१-४५-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002161, "chapter_id": 1044, "verse_number": "१-४५-१", "content_sanskrit": "एतस्मिन्नेव काले तु जरत्कारुर्महातपाः।\nचचार पृथिवीं कृत्स्नां यत्रसायंगृहो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002162, "chapter_id": 1044, "verse_number": "१-४५-२", "content_sanskrit": "चरन्दीक्षां महातेजा दुश्चरामकृतात्मभिः।\nतीर्थेष्वाप्लवनं कुर्वन्पुण्येषु विचचार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002163, "chapter_id": 1044, "verse_number": "१-४५-३", "content_sanskrit": "वायुभक्षो निराहारः शुष्यन्नहरहर्मुनिः।\nसं ददर्श पितॄन्गर्ते लम्बमानानधोमुखान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002164, "chapter_id": 1044, "verse_number": "१-४५-४", "content_sanskrit": "एकतन्त्ववशिष्टं वै वीरणस्तम्बमाश्रितान्।\nतं तन्तुं च शनैराखुमाददानं बिलेशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002165, "chapter_id": 1044, "verse_number": "१-४५-५", "content_sanskrit": "निराहारान्कृशान्दीनान्गर्ते स्वत्राणमिच्छतः।\nउपसृत्य स तान्दीनान्दीनरूपोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002166, "chapter_id": 1044, "verse_number": "१-४५-६", "content_sanskrit": "के भवन्तोऽवलम्बन्ते वीरमस्तम्बमाश्रिताः।\nदुर्बलं खादितैर्मूलैराखुना बिलवासिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002167, "chapter_id": 1044, "verse_number": "१-४५-७", "content_sanskrit": "वीरणस्तम्बके मूलं यदप्येकमिह स्थितम्।\nतद्भप्ययं शनैराखुरादत्ते दशनैः शितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002168, "chapter_id": 1044, "verse_number": "१-४५-८", "content_sanskrit": "छेत्स्यतेऽल्पावशिष्टत्वादेतदप्यचिरादिव।\nततस्तु पतितारोऽत्र गर्ते व्यक्तमधोमुखाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002169, "chapter_id": 1044, "verse_number": "१-४५-९", "content_sanskrit": "अत्र मे दुःखमुत्पन्नं दृष्ट्वा युष्मानधोमुखान्।\nकृच्छ्रामापदमापन्नान्प्रियं किं करवाणि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002170, "chapter_id": 1044, "verse_number": "१-४५-१०", "content_sanskrit": "तपसोऽस्य चतुर्थेन तृतीयेनाथ वा पुनः।\nअर्धेन वापि निस्तर्तुमापदं ब्रूत मा चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002171, "chapter_id": 1044, "verse_number": "१-४५-११", "content_sanskrit": "अथवापि समग्रेण तरन्तु तपसा मम।\nभवन्तः सर्व एवेह काममेवं विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002172, "chapter_id": 1044, "verse_number": "१-४५-१२x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002173, "chapter_id": 1044, "verse_number": "१-४५-१२", "content_sanskrit": "कुतो भवान्ब्रह्मचारी यो नस्त्रातुमिहेच्छसि।\nन तु विप्राग्र्य तपसा शक्यमेतद्व्यपोहितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002174, "chapter_id": 1044, "verse_number": "१-४५-१३", "content_sanskrit": "अस्ति नस्तात तपसः फलं प्रवदतां वर।\nसंतानप्रक्षयाद्ब्रह्मन्पतामो निरयेऽशुचौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002175, "chapter_id": 1044, "verse_number": "१-४५-१४", "content_sanskrit": "सन्तानं हि परो धर्मं एवमाह पितामहः।\nलम्बतामिह नस्तात न ज्ञानं प्रतिभाति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002176, "chapter_id": 1044, "verse_number": "१-४५-१५", "content_sanskrit": "येन त्वां नाभिजानीमो लोके विख्यातपौरुषम्।\nवृद्धो भवान्महाभागोयोनः शोच्यान्सुदुःखितान॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002177, "chapter_id": 1044, "verse_number": "१-४५-१६", "content_sanskrit": "शोचते चैव कारुण्याच्छृणु ये वै वयं द्विज।\nयायावरा नाम वयमृषयः संशितव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002178, "chapter_id": 1044, "verse_number": "१-४५-१७", "content_sanskrit": "लोकात्पुम्यादिह भ्रष्टाः सन्तानप्रक्षयान्मुने।\nप्रणष्टं नस्तपस्तीव्रं न हि नस्तन्तुरस्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002179, "chapter_id": 1044, "verse_number": "१-४५-१८", "content_sanskrit": "अस्तित्वेकोऽद्य नस्तन्तुः सोऽपि नास्ति यथा तथा।\nमन्दभाग्योऽल्पभाग्यानां तप एकं समास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002180, "chapter_id": 1044, "verse_number": "१-४५-१९", "content_sanskrit": "जरत्कारुरिति ख्यातो वेदवेदाङ्गपारगः।\nनियतात्मा महात्मा च सुव्रतः सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002181, "chapter_id": 1044, "verse_number": "१-४५-२०", "content_sanskrit": "तेन स्म तपसो लोभात्कृच्छ्रमापादिता वयम्।\nन तस्य भार्या पुत्रो वा बान्धवो वाऽस्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002182, "chapter_id": 1044, "verse_number": "१-४५-२१", "content_sanskrit": "तस्माल्लम्बामहे गर्ते नष्टसंज्ञा ह्यनाथवत्।\nस वक्तव्यस्त्वया दृष्टो ह्यस्माकं नाथवत्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002183, "chapter_id": 1044, "verse_number": "१-४५-२२", "content_sanskrit": "पितरस्तेऽवलम्बन्ते गर्ते दीना अधोमुखाः।\nसाधु दारान्कुरुष्वेति प्रजायस्वेति चाभि भोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002184, "chapter_id": 1044, "verse_number": "१-४५-२३", "content_sanskrit": "कुलतन्तुर्हि नः शिष्टः स एकैकस्तपोधन।\nयं तु पश्यसि नो ब्रह्मन्वीरणस्तम्बमाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002185, "chapter_id": 1044, "verse_number": "१-४५-२४", "content_sanskrit": "एषोऽस्माकं कुलस्तम्ब आस्ते स्वकुलवर्धनः।\nयानि पश्यसि वै ब्रह्मन्मूलानीहास्य वीरुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002186, "chapter_id": 1044, "verse_number": "१-४५-२५", "content_sanskrit": "एते नस्तन्तवस्तात कालेन परिभक्षिताः।\nयत्त्वेतत्पश्यसि ब्रह्मन्मूलमस्यार्धभक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002187, "chapter_id": 1044, "verse_number": "१-४५-२६", "content_sanskrit": "यत्र लम्बामहे गर्ते सोऽप्येकस्तप आस्थितः।\nयमाखुं पश्यसि ब्रह्मन्काल एष महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002188, "chapter_id": 1044, "verse_number": "१-४५-२७", "content_sanskrit": "स तं तपोरतं मन्दं शनैः क्षपयते तुदन्।\nजरत्कारुं तपोलुब्धं मन्दात्मानमचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002189, "chapter_id": 1044, "verse_number": "१-४५-२८", "content_sanskrit": "न हि नस्तत्तपस्तस्य तारयिष्यति सत्तम।\nछिन्नमूलान्परिभ्रष्टान्कालोपहतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002190, "chapter_id": 1044, "verse_number": "१-४५-२९", "content_sanskrit": "अधः प्रविष्टान्पश्यास्मान्यथा दुष्कृतिनस्तथा।\nअस्मासु पतितेष्वत्र सह सर्वैः सबान्धवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002191, "chapter_id": 1044, "verse_number": "१-४५-३०", "content_sanskrit": "छिन्नः कालेन सोऽप्यत्र गन्ता वै नरकं ततः।\nतपो वाऽप्यथ चा यज्ञो यच्चान्यत्पावनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002192, "chapter_id": 1044, "verse_number": "१-४५-३१", "content_sanskrit": "तत्सर्वं न समं तात संतत्येति सतां मतम्।\nस तात दृष्ट्वा ब्रूयास्तं जरत्कारुं तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002193, "chapter_id": 1044, "verse_number": "१-४५-३२", "content_sanskrit": "यथा दृष्टमिदं चात्र त्वयाऽऽख्येयमशेषतः।\nयथा दारान्प्रकुर्यात्स पुत्रानुत्पादयेद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002194, "chapter_id": 1044, "verse_number": "१-४५-३३", "content_sanskrit": "वा ब्रह्मंस्त्वया वाच्यः सोऽस्माकं नाथवत्तया।\nबान्धवानां हितस्येह यथा चात्मकुलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002195, "chapter_id": 1044, "verse_number": "१-४५-३४", "content_sanskrit": "कस्त्वं बन्धुमिवास्माकमनुशोचसि सत्तम।\nश्रोतुमिच्छाम सर्वेषां को भवानिह तिष्ठति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002196, "chapter_id": 1044, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि पञ्चचत्वारिंशोऽध्यायः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]