[{"id": 7003120000, "chapter_id": 23120, "verse_number": "४-५६-१", "content_sanskrit": "अथ षद्पञ्चाशत्तमोऽध्यायः ।\nनारद उवाच ।\nकिमपूर्वं श्रुतं ब्रह्मन्रहस्यं परमाद्भुतम् ।\nअनन्तचरितं धन्यमनन्तस्याच्युतस्य च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003120001, "chapter_id": 23120, "verse_number": "४-५६-२", "content_sanskrit": "कथं कृष्णो महाविष्णोर्दर्पभङ्ग चकार सः ।\nअन्येषां वा कथमहो तद्भवान्वक्तुमर्हति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003120002, "chapter_id": 23120, "verse_number": "४-५६-३", "content_sanskrit": "स्वतः श्रीकृष्णचरितमतीव मधुरं श्रुतौ ।\nअतीव मधुरं रम्यं काव्यं कविमुखात्ततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003120003, "chapter_id": 23120, "verse_number": "४-५६-४", "content_sanskrit": "नारायण उवाच ।\nमहाविष्णोरहंकारो बभूव सहसेति च ।\nसर्वं मल्लोमकूपेषु विश्वान्येवाऽहमीश्वरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003120004, "chapter_id": 23120, "verse_number": "४-५६-५", "content_sanskrit": "संहारभैरवी भुत्वा तं स जग्रास लीलया ।\nस्यिते मुर्धावशेषे च प्रसादं तं चकार सः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003120005, "chapter_id": 23120, "verse_number": "४-५६-६", "content_sanskrit": "सर्वात्मना ध्यायमानः स्तुतो भीतं कृपानिधिः ।\nतच्छरीरं सुसंपन्नं पुनरेव चकार सः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003120006, "chapter_id": 23120, "verse_number": "४-५६-७", "content_sanskrit": "ब्रह्मणः सहसा ब्रह्मन्निति दर्पो बभुव ह ।\nअहं त्रिजगतां धाता कर्ताऽहमीश्वरः स्वयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003120007, "chapter_id": 23120, "verse_number": "४-५६-८", "content_sanskrit": "मत्परः पूजितो नास्ति मत्परश्च जितेन्द्रियः ।\nइत्येवं मनसा कृत्वा बहुदर्पो बभूव ह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003120008, "chapter_id": 23120, "verse_number": "४-५६-९", "content_sanskrit": "तं ब्रहाणां समूहं च दर्शयामास तत्क्षणम् ।\nगोलोके स्वसमीपे च वसन्तं पुरतो विभोः ।\nचतुर्वक्त्रं पञ्चवक्त्रं षड्वक्त्रं च ततोऽधिकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003120009, "chapter_id": 23120, "verse_number": "४-५६-१०", "content_sanskrit": "शतवक्त्रं च प्रत्येकं ब्रह्माण्डौघं च लीलया ।\nत्यक्तुकामं स्वदेहं च व्रीडया नतकंधरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003120010, "chapter_id": 23120, "verse_number": "४-५६-११", "content_sanskrit": "पुनः प्रसादं कृपया तं चकार कृपानिधिः ।\nकालेन मोहिनीद्वारा तमपूज्यं चकार सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003120011, "chapter_id": 23120, "verse_number": "४-५६-१२", "content_sanskrit": "स्वकन्यां दर्शयित्वा तं सकामं च चकार ह ।\nपुनस्तद्दर्पभङ्गं च शिवद्वारा चकार सः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003120012, "chapter_id": 23120, "verse_number": "४-५६-१३", "content_sanskrit": "तत्याज लज्जया देहं पुनर्देहं दधार सः ।\nपुनश्चकार तं पूज्यं ब्रह्माणं ब्रह्मणः प्रभुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003120013, "chapter_id": 23120, "verse_number": "४-५६-१४", "content_sanskrit": "ज्ञानं ददौ महाज्ञानी ज्ञानानन्दः सनातनः ।\nविष्णोर्बभूव गर्वश्च जगत्पाताऽहमीश्वरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003120014, "chapter_id": 23120, "verse_number": "४-५६-१५", "content_sanskrit": "तमात्मविस्मृतं कृष्णश्चकार रामजन्मनि ।\nअहं विश्वं बिभर्मीति शेषो दर्पी बभूव ह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003120015, "chapter_id": 23120, "verse_number": "४-५६-१६", "content_sanskrit": "तद्दर्पं गरुडद्वारा चूर्णीभूतं चकार सः ।\nएकदा पूजितो नागैर्गरुडः कृष्णवाहनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003120016, "chapter_id": 23120, "verse_number": "४-५६-१७", "content_sanskrit": "न पूजितश्च शेषेण स्वदर्पेण पुरा मुने ।\nगरुडेन जितं कोधात्तमनन्तं मनस्विनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003120017, "chapter_id": 23120, "verse_number": "४-५६-१८", "content_sanskrit": "चकार मोक्षणं तस्य श्रीकृष्णश्च कृपानिधिः ।\nस्वयं शिवः स्वदर्पाच्च विवाहं न चकार सः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003120018, "chapter_id": 23120, "verse_number": "४-५६-१९", "content_sanskrit": "तं कृत्वा मायया मोहं कारयामास स्त्रीयुतम् ।\nपुनर्जहार तत्पत्नीं दक्षकन्यां महासतीम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003120019, "chapter_id": 23120, "verse_number": "४-५६-२०", "content_sanskrit": "वर्ष शुशोच तद्देहं क्रोडे कृत्वा च शंकरः ।\nनानास्थानं च बभ्राम रुदञ्छोकान्मुहुर्मुहुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003120020, "chapter_id": 23120, "verse_number": "४-५६-२१", "content_sanskrit": "जन्मान्तरे पुनः प्राप्य तां सतीं पार्वतीं मुदा ।\nविसस्मार च स्वज्ञानं दक्षशप्तः पुनः शिवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003120021, "chapter_id": 23120, "verse_number": "४-५६-२२", "content_sanskrit": "पुनश्चाऽऽङ्गीरसद्वारा स्मारयामास सत्वरम् ।\nएकदा सरथः शम्भुः प्रेरितस्त्रिपुरे पुरा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003120022, "chapter_id": 23120, "verse_number": "४-५६-२३", "content_sanskrit": "हत्वा दैत्यं शिवद्वारा त्रिपुरारिं चकार तम् ।\nसर्वं वरं च सर्वस्मै दातुं शंभुः कृपानिधिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003120023, "chapter_id": 23120, "verse_number": "४-५६-२४", "content_sanskrit": "स्वयं कल्पतरुर्भूत्वा प्रतिज्ञां च चकार सः ।\nवृकासुरोऽनुष्ठानं च कृत्वा वव्रे वरं विभुम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003120024, "chapter_id": 23120, "verse_number": "४-५६-२५", "content_sanskrit": "दास्यामि हस्तं यन्मूर्घ्नि भस्मसाद्भवतु क्षणात् ।\nजगाद जगतां नाथ ईप्सितं ते भविष्यति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003120025, "chapter_id": 23120, "verse_number": "४-५६-२६", "content_sanskrit": "इति लब्ध्वा वरं रुद्राद्गच्छन्तं शंकरं विभुम् ।\nहस्तं दातुं च तं मूर्ध्नि प्राधावत्सत्वरं पुरा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003120026, "chapter_id": 23120, "verse_number": "४-५६-२७", "content_sanskrit": "अतीव भीतः शंभुश्च जगाम शरणं हरिम् ।\nभगवांश्च शिवस्यार्थे दैत्यं भस्मीचकार सः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003120027, "chapter_id": 23120, "verse_number": "४-५६-२८", "content_sanskrit": "शिवं युद्धं च कुर्वन्तं बाणयुद्धे पुरा विभुः ।\nलीलया जृम्भणास्त्रेण जडीभूतं चकार सः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003120028, "chapter_id": 23120, "verse_number": "४-५६-२९", "content_sanskrit": "समागतं दक्षयज्ञे शंभुं दम्भेन लीलया ।\nवारयामास भगवान्हस्तं दत्त्वा च तद्गले ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003120029, "chapter_id": 23120, "verse_number": "४-५६-३०", "content_sanskrit": "केदारकन्यकाद्वारा शप्तो धर्मोऽतिदैवतः ।\nबभूवातिकृशो भीतः कुह्वामेव यथा शशी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003120030, "chapter_id": 23120, "verse_number": "४-५६-३१", "content_sanskrit": "तदा तस्याश्च शापान्ते सत्ये पूर्णो बभुव ह ।\nत्रिपाद्बभूव त्रेतायां द्वापरं च द्विपादिति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003120031, "chapter_id": 23120, "verse_number": "४-५६-३२", "content_sanskrit": "एकपाच्च कलौ सोऽपि कलेरन्ते पुनः क्षयः ।\nषोडशांशोऽतिक्लिष्टश्च सस्मार चनणं विभोः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003120032, "chapter_id": 23120, "verse_number": "४-५६-३३", "content_sanskrit": "तदा सत्ययुगारम्भे परिपूर्णोऽभवत्पुनः ।\nपुनर्युगानुरोधेन क्रमेण च पुनः क्षयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003120033, "chapter_id": 23120, "verse_number": "४-५६-३४", "content_sanskrit": "यमो माण्डवशापेन शूद्रयोनिमवाप ह ।\nतदा पुनः शताब्दान्ते पुनः शुद्धो बभूव ह ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003120034, "chapter_id": 23120, "verse_number": "४-५६-३५", "content_sanskrit": "साम्बो विमातृशापेन गलत्कुष्ठी बभूव सः ।\nतदा सूर्यव्रतं कृत्वा पुनः शुद्धो बभूव सः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003120035, "chapter_id": 23120, "verse_number": "४-५६-३६", "content_sanskrit": "चन्द्रो दर्पमदेनैव जहार च गुरोः प्रियाम् ।\nबभूव दर्पभङ्गोऽस्य यक्ष्मग्रस्तो बभूव सः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003120036, "chapter_id": 23120, "verse_number": "४-५६-३७", "content_sanskrit": "सूर्यो दर्पात्तेजसश्च हन्तुं शंकरकिंकरम् ।\nसुमालीत्यभिधं दैत्यं जगामाऽऽशु गिरिं प्रति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003120037, "chapter_id": 23120, "verse_number": "४-५६-३८", "content_sanskrit": "अहर्निशं दीप्तिकरं कुर्वन्तं विषयं रवेः ।\nसूर्येण भीतो दैत्यश्च शंकरं शरणं ययौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003120038, "chapter_id": 23120, "verse_number": "४-५६-३९", "content_sanskrit": "सूर्यं दृष्ट्वा शंकरश्च जग्राह शूलमेव च ।\nभीतो दुद्राव सूर्यश्च दृष्ट्वा तं शूलिनं मुने ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003120039, "chapter_id": 23120, "verse_number": "४-५६-४०", "content_sanskrit": "जघान काश्यां शूलेन शूलीकाशीश्वरो रविम् ।\nमूर्च्छां संप्राप्य शूलेन दर्पंभङ्गो बभूव ह ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003120040, "chapter_id": 23120, "verse_number": "४-५६-४१", "content_sanskrit": "सान्द्रान्धकारः सहसा जग्राह पृथिवीतलम् ।\nआशुतोषो महादेवो जीवयामास तत्क्षणम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003120041, "chapter_id": 23120, "verse_number": "४-५६-४२", "content_sanskrit": "तुष्टाव शंकरं सूर्यो लज्जितोऽपि भयेन च ।\nकृत्वा तमाशिषं तुष्टो ययौ गेहं कृपानिधिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003120042, "chapter_id": 23120, "verse_number": "४-५६-४३", "content_sanskrit": "विभुर्गरुत्मतो दर्पं बभञ्ज लीलया पुरा ।\nनिःश्वासैः प्रेरितस्यापि शिवस्य वृषभस्य च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003120043, "chapter_id": 23120, "verse_number": "४-५६-४४", "content_sanskrit": "आगच्छन्तं च वैकुण्ठं पृष्ठे कृत्वा शिवं पुरा ।\nद्रष्टुं समागतं भक्त्या देवं नारायणं परम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003120044, "chapter_id": 23120, "verse_number": "४-५६-४५", "content_sanskrit": "वह्निर्दपीं भृगोः शापात्सर्वभक्षो बभूव ह ।\nगुरोः स्वभार्याहिरणाद्दर्पश्चूर्णो बभूव ह ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003120045, "chapter_id": 23120, "verse_number": "४-५६-४६", "content_sanskrit": "दुर्वाससो दर्पभङ्गो बभूव ह्यम्बरीषतः ।\nसुदर्शनेन चक्रेण विष्णोर्दुर्विषहेण च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003120046, "chapter_id": 23120, "verse_number": "४-५६-४७", "content_sanskrit": "जयस्य विजयस्यापि दर्पभङ्गं चकार सः ।\nवैकुण्ठात्पतितस्यापि ब्रह्मशापच्छलेन च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003120047, "chapter_id": 23120, "verse_number": "४-५६-४८", "content_sanskrit": "नृसिंहेण हतः सोऽपि हिरण्यकशिपुर्यथा ।\nसूकरेण हिरण्याक्षो लीलया च रसातले ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003120048, "chapter_id": 23120, "verse_number": "४-५६-४९", "content_sanskrit": "रावणः कुम्भकर्णश्च निहतौ रामबाणतः ।\nजन्मान्तरे च लङ्कायां ब्रह्मणा प्रार्थितस्य च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003120049, "chapter_id": 23120, "verse_number": "४-५६-५०", "content_sanskrit": "शिशुपालो हि निहतः कृष्णबाणेन लीलया ।\nदन्तवक्रश्च सहसा परिपूर्णेऽत्र जन्मनि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003120050, "chapter_id": 23120, "verse_number": "४-५६-५१", "content_sanskrit": "सुराणां दर्पभङ्गं च दैत्यद्वारा चकार ह ।\nअसुराणां सुरद्वारा विरोधेन परस्परम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003120051, "chapter_id": 23120, "verse_number": "४-५६-५२", "content_sanskrit": "विधिद्वारा दर्पभङ्गं भवतश्च चकार सः ।\nभवानासीन्नारदश्च पुरा पुत्रः प्रजापतेः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003120052, "chapter_id": 23120, "verse_number": "४-५६-५३", "content_sanskrit": "गन्धर्वश्च पितुः शापाच्छूद्रीपुत्रस्ततः क्रमात् ।\nततः पुनर्नारदश्च प्रसादादधुना विभोः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003120053, "chapter_id": 23120, "verse_number": "४-५६-५४", "content_sanskrit": "मम साध्यं विश्वमिति कामदर्पो बभूव ह ।\nतं प्रमतं हरद्वारा भस्मसाच्च चकार सः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003120054, "chapter_id": 23120, "verse_number": "४-५६-५५", "content_sanskrit": "पुनः कृत्वा प्रसादं तं जीवयामास लीलया ।\nऐकान्तिकं च तद्भक्तं स च नास्त्रं करोति हि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003120055, "chapter_id": 23120, "verse_number": "४-५६-५६", "content_sanskrit": "चकार दर्पभङ्गं च दर्पिणो लक्ष्मणस्य च ।\nरणे शंकरशूलेन रावणप्रेरितेन च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003120056, "chapter_id": 23120, "verse_number": "४-५६-५७", "content_sanskrit": "पुनस्तं जीवयामास रामस्य स्तवनेन च ।\nस्वयं विस्मृतविष्णोश्च ब्रह्मशापेन नारद ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003120057, "chapter_id": 23120, "verse_number": "४-५६-५८", "content_sanskrit": "चकार दर्पभङ्गं च कार्तवीर्यार्जुनस्य च ।\nजामदग्न्यस्य शस्त्रेणामोघेन पर्शुना पुरा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003120058, "chapter_id": 23120, "verse_number": "४-५६-५९", "content_sanskrit": "विप्रपुत्रस्य मरणे हरणे कृष्णयोषिताम् ।\nकर्णेन सार्धं समरे पार्थदर्पं बभञ्ज सः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003120059, "chapter_id": 23120, "verse_number": "४-५६-६०", "content_sanskrit": "बाणस्य चोषाहरणे चिच्छेद च भुजान्विभुः ।\nभृगोश्च दक्षयज्ञे च दर्पभङ्गं चकार सः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003120060, "chapter_id": 23120, "verse_number": "४-५६-६१", "content_sanskrit": "पर्शुरामस्य रामस्य विवाहो पथि गच्छतः ।\nबभञ्ज दर्पं समरे रामद्वारा पुरा विभुः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003120061, "chapter_id": 23120, "verse_number": "४-५६-६२", "content_sanskrit": "सुमेरोः शृङ्गभृङ्गं च वायुद्वारा चकार सः ।\nसमुद्राणां दर्पभङ्गं चकारागस्त्यभक्षणात् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003120062, "chapter_id": 23120, "verse_number": "४-५६-६३", "content_sanskrit": "अकाले सृष्टिहरणे तत्पुत्रमरणे पुरा ।\nकोपयुक्तस्य वायोश्च दर्पभङ्गं चकार सः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003120063, "chapter_id": 23120, "verse_number": "४-५६-६४", "content_sanskrit": "उषाहरणयात्रायां द्वारकागमने हरेः ।\nबाणस्य च गवां हेतोवंरुणं च शशाप सः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003120064, "chapter_id": 23120, "verse_number": "४-५६-६५", "content_sanskrit": "कलहे गङ्गया वाण्या नारायणाग्रतः ।\nसरस्वतीं च तत्याज तस्या दर्पं बभञ्ज सः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003120065, "chapter_id": 23120, "verse_number": "४-५६-६६", "content_sanskrit": "दर्पयुक्तां च दुर्गां च त्यक्त्वा शंभुर्हिमालये ।\nकामं च भस्मसात्कृत्वा तपसे च ययौ विभुः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003120066, "chapter_id": 23120, "verse_number": "४-५६-६७", "content_sanskrit": "लज्जामवाप सा देवी तस्या दर्पं बभञ्ज सः ।\nसा ययौ तपसे विष्णोः प्राप्तिहेतोः शिवस्य च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003120067, "chapter_id": 23120, "verse_number": "४-५६-६८", "content_sanskrit": "भारते सुचिरं तप्त्वा देवी वीष्णोर्वरेण च ।\nचकार स्वामिनं शंभुं भगवन्तं सनातनम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003120068, "chapter_id": 23120, "verse_number": "४-५६-६९", "content_sanskrit": "महासौभाग्ययुक्ता सा बभूव शंकरप्रिया ।\nविश्वेषु सर्वदेवीषु पूज्या वन्द्या स्तुता सुरैः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003120069, "chapter_id": 23120, "verse_number": "४-५६-७०", "content_sanskrit": "दर्पयुक्ता महालक्ष्मीर्बभूव सा महामुने ।\nपराभूता पुरा देवी जयेन विजयेन च ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003120070, "chapter_id": 23120, "verse_number": "४-५६-७१", "content_sanskrit": "प्रविशन्तीं विभोर्द्वारं दत्तवा भक्ताय वाञ्छितम् ।\nनिवारिता सा द्वाराच्च तेन दौवारिकेण वै ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003120071, "chapter_id": 23120, "verse_number": "४-५६-७२", "content_sanskrit": "यदात्मनस्तिरस्कारं साभिमाना महासती ।\nस्मृत्वा हरेः पादपद्मं देहं त्यक्तुं समुद्यता ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003120072, "chapter_id": 23120, "verse_number": "४-५६-७३", "content_sanskrit": "तदा ब्रह्मा महेशश्च विष्णुर्धर्मश्च भास्करः ।\nचन्द्रश्च कामदेवश्च वैश्वानरो धनेश्वरः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003120073, "chapter_id": 23120, "verse_number": "४-५६-७४", "content_sanskrit": "ऋषयो मुनयश्चैव मनवो विघ्ननाशकाः ।\nमहेन्द्रो वरुणश्चैव जगत्प्राणो हुताशनः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003120074, "chapter_id": 23120, "verse_number": "४-५६-७५", "content_sanskrit": "समाययूरुदन्तस्ते पद्मायाः पुरतः पुरा ।\nतुष्टुवुश्च महालक्ष्मीं मूलप्रकृतिमीश्वरीम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003120075, "chapter_id": 23120, "verse_number": "४-५६-७६", "content_sanskrit": "देवा ऊचुः ।\nक्षमस्व भगवत्यम्ब क्षमाशीले परात्परे ।\nशुद्धसत्त्वस्वरुपे च कोपादिपरिवर्जिते ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003120076, "chapter_id": 23120, "verse_number": "४-५६-७७", "content_sanskrit": "उपमे सर्वसाध्वीनां देवीनां देवपूजिते ।\nत्वया विना जगत्सर्व मृततुल्यं च निष्फलम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003120077, "chapter_id": 23120, "verse_number": "४-५६-७८", "content_sanskrit": "सर्वसंपत्स्वरुपा त्वं सर्वेषां सर्वरूपिणी ।\nरासेश्वर्यधिदेवी त्वं त्वत्कलाः सर्वयोषितः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003120078, "chapter_id": 23120, "verse_number": "४-५६-७९", "content_sanskrit": "कैलासे पार्वती त्वं च क्षीरोदे सिन्धुकन्यका ।\nस्वर्गे च स्वर्गलक्ष्मीस्त्वं मर्त्यलक्ष्मीश्च भूतले ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003120079, "chapter_id": 23120, "verse_number": "४-५६-८०", "content_sanskrit": "वैकुण्ठे च महालक्ष्मीर्देवदेवी सरस्वती ।\nगङ्गा च तुलसी त्वं च वृन्दा वृन्दावने वने ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003120080, "chapter_id": 23120, "verse_number": "४-५६-८१", "content_sanskrit": "कृष्णप्राणाधिदेवी त्वं गोलोके राधिका स्वयम् ।\nरासे रासेश्वरी त्वं च वृन्दा वृन्दावने वने ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003120081, "chapter_id": 23120, "verse_number": "४-५६-८२", "content_sanskrit": "कृष्णप्रिया त्वं भाण्डीरे चन्द्रा चन्दनकानने ।\nविरजा चम्पकवने शतशृङ्गे च सुन्दरी ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003120082, "chapter_id": 23120, "verse_number": "४-५६-८३", "content_sanskrit": "पद्मावती पद्मवने मालती मालतीवने ।\nकृन्ददन्ती कुन्दवने सुशीला केतकीवने ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003120083, "chapter_id": 23120, "verse_number": "४-५६-८४", "content_sanskrit": "कदम्बमाला त्वं देवी कदम्बकाननेऽपि च ।\nराजलक्ष्मी राजगेहे गृहलक्ष्मीर्गृहे गृहे ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003120084, "chapter_id": 23120, "verse_number": "४-५६-८५", "content_sanskrit": "इत्युक्तवा देवताः सर्वे मुनयो मनवस्तथा ।\nरुरुदुर्नम्रवदनाः शुष्ककण्ठोष्ठतालुकाः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003120085, "chapter_id": 23120, "verse_number": "४-५६-८६", "content_sanskrit": "इति लक्ष्मीस्तवं पुण्यं सर्वदेवैः कृतं शुभम् ।\nयः पठेत्प्रातरुत्थाय स वै सर्वं लभेद्ध्रुवम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003120086, "chapter_id": 23120, "verse_number": "४-५६-८७", "content_sanskrit": "अभार्योलभते भार्यां विनीतां च सुतां सतीम् ।\nसुशीलां सुनदरीं रम्यामतिसुप्रियवादिनीम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003120087, "chapter_id": 23120, "verse_number": "४-५६-८८", "content_sanskrit": "पुत्रपौत्रवतीं शुद्धां कुलजां कोमलां वराम् ।\nअपुत्रो लभते पुत्रं वैष्णवं चिरजीविनम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003120088, "chapter_id": 23120, "verse_number": "४-५६-८९", "content_sanskrit": "परमैश्वर्ययुक्तं च विद्यावन्तं यशस्विनम् ।\nभ्रष्टराज्यो लभेद्राज्यं भ्रष्टश्रीर्लभते श्रियम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003120089, "chapter_id": 23120, "verse_number": "४-५६-९०", "content_sanskrit": "हतबन्धुर्लभेद्बन्धुं धनभ्रष्टो धनं लभेत् ।\nकीर्तिंहीनो लभेत्कीर्तिं प्रतिष्ठां च लभेद्ध्रुवम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003120090, "chapter_id": 23120, "verse_number": "४-५६-९१", "content_sanskrit": "सर्वमङ्गलदं स्तोत्रं शोकसंतापनाशनम् ।\nहर्षानन्दकरं शश्वद्धर्ममोक्षसुहृत्प्रदम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]