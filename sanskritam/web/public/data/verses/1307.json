[{"id": 2014767, "chapter_id": 1307, "verse_number": "२-४८-१", "content_sanskrit": "भीष्ण उवाच॥\nविष्णोः पुनर्महाभागः प्रादुर्भावो महात्मनः।\nदत्तात्रेय इति ख्यात ऋषिरासीन्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014768, "chapter_id": 1307, "verse_number": "२-४८-२", "content_sanskrit": "तेन नष्टेषु वेदेषु क्रियासु च मखेषु च।\nचातुर्वर्ण्ये च सङ्कीर्णे धर्मे शिथिलतां गते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014769, "chapter_id": 1307, "verse_number": "२-४८-३", "content_sanskrit": "अभवर्धति चाधर्मे सत्ये नष्टे स्थितेऽनृते।\nप्रजासु क्षीयमाणासु धर्मे चामूलतां पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014770, "chapter_id": 1307, "verse_number": "२-४८-४", "content_sanskrit": "सयज्ञाः सक्रिया वेदाः प्रत्यानीता हि तेन वै।\nचातुर्वर्ण्यमसङ्कीर्णं कृतं तेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014771, "chapter_id": 1307, "verse_number": "२-४८-५", "content_sanskrit": "स एव वै यदा प्रादाद्धैहयाधिपतेर्वरम्।\nतं हैहयानामधिपस्त्वर्जुनोऽभिप्रसादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014772, "chapter_id": 1307, "verse_number": "२-४८-६", "content_sanskrit": "वनं पर्यचरन्सम्यक्छुश्रूषुरनुसूयकः।\nनिर्ममो निरहङ्कारो दीर्घकालमतोषयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014773, "chapter_id": 1307, "verse_number": "२-४८-७", "content_sanskrit": "आराध्य दत्तात्रेयं हि अगृङ्णात्स वरानिमान्।\nआप्तादाप्ततरान्विप्राद्विद्वान्विद्वन्निषेवितात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014774, "chapter_id": 1307, "verse_number": "२-४८-८", "content_sanskrit": "ऋतेऽमरत्वं विप्रेण दत्तात्रेयेण धीमता।\nवरैश्चतुर्भिः प्रवृत इमान्वव्रे वरान्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014775, "chapter_id": 1307, "verse_number": "२-४८-९", "content_sanskrit": "श्रीमान्मनस्वी बलवान्सत्यवागनसूयकः।\nसहस्रबाहुर्भूयासमेषु मे प्रथमो वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014776, "chapter_id": 1307, "verse_number": "२-४८-१०", "content_sanskrit": "जरायुजाण्डजं सर्वं सर्वं चैव चराचरम्।\nशास्तुमिच्छामि धर्मेण द्वितीयस्त्वेष मे वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014777, "chapter_id": 1307, "verse_number": "२-४८-११", "content_sanskrit": "पितृन्देवानृषीन्विप्रान्यजेयं विपुलैर्मखैः।\nअमित्रांश्च शितैर्बाणैस्तृतीयो व्रर एष मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014778, "chapter_id": 1307, "verse_number": "२-४८-१२", "content_sanskrit": "यस्य नासीन्न भविता न चास्ति सदृशः पुमान्।\nइह वा दिवि वा लोके स मे हन्ता भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014779, "chapter_id": 1307, "verse_number": "२-४८-१३", "content_sanskrit": "सोऽर्जुनः कृतवीर्यस्य वरः पुत्रोऽभवद्युधि।\nस सहस्रं सहस्राणां माहिष्मत्यामवर्धत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014780, "chapter_id": 1307, "verse_number": "२-४८-१४", "content_sanskrit": "स भूमिमखिलां जित्वा द्वीपांश्चापि समुद्रिणः।\nनभसीवाज्वलत्सूर्यः पुण्यैः कर्मभिर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014781, "chapter_id": 1307, "verse_number": "२-४८-१५", "content_sanskrit": "इन्द्रद्वीपं कशेरुं च कामद्वीपं गभस्तितम्।\nगन्धर्ववरुणद्वीपं सौहृष्टममितप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014782, "chapter_id": 1307, "verse_number": "२-४८-१६", "content_sanskrit": "पूर्वैरजितपूर्वांश्च द्वीपनजयदर्जुनः।\nइदं तु कार्तवीर्यस्य बभूवासदृशं जनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014783, "chapter_id": 1307, "verse_number": "२-४८-१७", "content_sanskrit": "न पूर्वे नापरे तस्य गमिष्यन्ति गतिं नृपाः।\nयदर्णवे प्रयातस्य वस्त्रं न परिषिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014784, "chapter_id": 1307, "verse_number": "२-४८-१८", "content_sanskrit": "सौवर्णं सर्वमप्यासीद्विमानवरमुत्तमम्।\nचतुर्धा व्यभजद्राष्ट्रं तद्विभज्यान्वपालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014785, "chapter_id": 1307, "verse_number": "२-४८-१९", "content_sanskrit": "एकांशेनाहरत्सेनामेकांशेनावसद्गृहान्।\nयस्तु तस्य तृतीयांशो राज्ञोऽभूज्जनसङ्ग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014786, "chapter_id": 1307, "verse_number": "२-४८-२०", "content_sanskrit": "आप्तः परमकल्याणस्तेन यज्ञानकल्पयत्।\nये दस्यवो ग्रामचरा अरम्ये च वसन्ति ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014787, "chapter_id": 1307, "verse_number": "२-४८-२१", "content_sanskrit": "चतुर्थेन तु सोंऽशेन तान्सर्वान्प्रत्यषेधयत्।\nद्वाराणि नापिधीयन्ते पुरेषु नगरेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014788, "chapter_id": 1307, "verse_number": "२-४८-२२", "content_sanskrit": "स एव राष्ट्रपालोऽभूत्स्रीपालोऽभवदर्जुनः।\nस एवासीद्जापालः सः गोपालो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014789, "chapter_id": 1307, "verse_number": "२-४८-२३", "content_sanskrit": "शतं वर्षसहस्राणामनुशिष्यार्जुनो महीम्।\nदत्तात्रेयप्रसादेन एवं राज्यं चकार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014790, "chapter_id": 1307, "verse_number": "२-४८-२४", "content_sanskrit": "एवं बहूनि कर्माणि चक्रे लोकहिताय सः॥\nदत्तात्रेय इति ख्यातः प्रादुर्भावो ह्ययं हरेः।\nकथितो भरतश्रेष्ट शृणु भूयो महात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014791, "chapter_id": 1307, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि अष्टचतत्वारिंशोऽध्यायः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]