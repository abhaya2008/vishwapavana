[{"id": 2110355, "chapter_id": 3387, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110356, "chapter_id": 3387, "verse_number": "१", "content_sanskrit": "समावृत्तव्रतं तं तु निसृष्टं गुरुणा कचम् ।\nप्रस्थितं त्रिदशावासं देवयानीदमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110357, "chapter_id": 3387, "verse_number": "२", "content_sanskrit": "ऋषेरङ्गिरसः पौत्र वृत्तेनाभिजनेन च ।\nभ्राजसे विद्यया चैव तपसा च दमेन च \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110358, "chapter_id": 3387, "verse_number": "३", "content_sanskrit": "ऋषिर्यथाङ्गिरा मान्यः पितुर्मम महातपाः ।\nतथा मान्यश्च पूज्यश्च भूयो मम बृहस्पतिः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110359, "chapter_id": 3387, "verse_number": "४", "content_sanskrit": "एवं ज्ञात्वा विजानीहि यद् ब्रवीमि तपोधन ।\nव्रतस्थे नियमोपेते यथा वर्ताम्यहं त्वयि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110360, "chapter_id": 3387, "verse_number": "५", "content_sanskrit": "त्वं समावृत्तविद्यो मां भक्तां भजितुमर्हसि ।\nगृहाण पाणिं विधिवन्मम मन्त्रपुरस्सरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110361, "chapter_id": 3387, "verse_number": "", "content_sanskrit": "कचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110362, "chapter_id": 3387, "verse_number": "६", "content_sanskrit": "पूज्यो मान्यश्च भगवान् यथा तव पिता मम ।\nतथा त्वमनवद्याङ्गि पूजनीयतमा मम\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110363, "chapter_id": 3387, "verse_number": "७", "content_sanskrit": "आत्मप्राणैः प्रियतमा भार्गवस्य शुचिस्मिते ।\nत्वं भद्रे धर्मतः पूज्या गुरुपुत्री मता मम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110364, "chapter_id": 3387, "verse_number": "८", "content_sanskrit": "गुरोर्गरीयसी वृत्त्या तस्माद् गुरुतरी मम ।\nन मामर्हसि कल्याणि वक्तुमेवं शुचिस्मिते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110365, "chapter_id": 3387, "verse_number": "९", "content_sanskrit": "यथा मम गुरुर्नित्यं शुक्रो मान्यः पिता तव ।\nदेवयानि तथा त्वं हि नैवं वक्तुमिहार्हसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110366, "chapter_id": 3387, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110367, "chapter_id": 3387, "verse_number": "१०", "content_sanskrit": "गुरुपुत्रस्य पुत्रो मे ननु त्वमसि मे पितुः ।\nतस्मान्मान्यश्च पूज्यश्च ममापि त्वं द्विजोत्तम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110368, "chapter_id": 3387, "verse_number": "११", "content_sanskrit": "विशस्यमाने त्वसुरैः कच त्वयि पुनः पुनः ।\nतदाप्रभृति या प्रीतिस्तां त्वमेव स्मरस्व मे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110369, "chapter_id": 3387, "verse_number": "१२", "content_sanskrit": "सौहृदेनानुरक्तां च भक्तां भजितुमर्हसि ।\nन मामर्हसि धर्मज्ञ त्यक्तुं भक्तामनाथवत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110370, "chapter_id": 3387, "verse_number": "", "content_sanskrit": "कचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110371, "chapter_id": 3387, "verse_number": "१३", "content_sanskrit": "अनियोज्ये नियोक्तुं मां देवयानि न चार्हसि ।\nप्रसीद सुभ्रु त्वं मह्यं गुरोर्गुरुतरी शुभे \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110372, "chapter_id": 3387, "verse_number": "१४", "content_sanskrit": "यत्रोषितं विशालाक्षि त्वया चन्द्रनिभानने ।\nतत्राहमुषितो भद्रे कुक्षौ काव्यस्य भामिनि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110373, "chapter_id": 3387, "verse_number": "१५", "content_sanskrit": "मम त्वं भगिनी भद्रे मैवं वोचः शुभानने ।\nसुखमस्म्युषितो भद्रे न मन्युर्मम विद्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110374, "chapter_id": 3387, "verse_number": "१६", "content_sanskrit": "आपृच्छे त्वां गमिष्यामि शिवमाशास्व मे पथि ।\nअविरोधेन धर्मस्य स्मर्तव्योऽहं कथान्तरे ।\nअप्रमत्तोत्थिता नित्यमाराधय गुरुं मम ।\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110375, "chapter_id": 3387, "verse_number": "", "content_sanskrit": "देवयानी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110376, "chapter_id": 3387, "verse_number": "१७", "content_sanskrit": "धर्मकार्ये नियुञ्जाना कन्या सम्प्राप्तयौवना ।\nधर्ममेव प्रयुञ्जाना प्रत्याख्याता त्वयाऽनघ ।\nतस्मात् कच न ते विद्या सिद्धिमेषा गमिष्यति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110377, "chapter_id": 3387, "verse_number": "", "content_sanskrit": "कचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110378, "chapter_id": 3387, "verse_number": "१८", "content_sanskrit": "शुक्रपुत्रीति मत्वाऽहं प्रत्याख्यास्ये न दोषतः ।\nगुरुणा चाभ्यनुज्ञातो धर्मतः प्रब्रवीम्यहम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110379, "chapter_id": 3387, "verse_number": "१९", "content_sanskrit": "आर्षं धर्मं ब्रुवाणोऽहं देवयानि यथा त्वया ।\nशप्तोऽस्म्यनर्हः शापस्य कामतोऽद्य न धर्मतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110380, "chapter_id": 3387, "verse_number": "२०", "content_sanskrit": "तस्माद् भवत्या यः कामो न तथा सम्भविष्यति ।\nऋषिपुत्रो न ते कश्चिद् द्विजः पाणिं ग्रहीष्यति \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110381, "chapter_id": 3387, "verse_number": "२१", "content_sanskrit": "फलिष्यति च वै विद्या नेति यच्चात्थ मां तथा ।\nअध्यापयिष्यामि तु यं तस्य विद्या फलिष्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110382, "chapter_id": 3387, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110383, "chapter_id": 3387, "verse_number": "२२", "content_sanskrit": "एवमुक्त्वा द्विजश्रेष्ठो देवयानीं कचस्तदा ।\nत्रिदशेशालयं शीघ्रं जगाम द्विजसत्तमः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110384, "chapter_id": 3387, "verse_number": "२३", "content_sanskrit": "तमागतमभिप्रेत्य देवाश्चेन्द्रपुरोगमाः ।\nबृहस्पतिं सभाज्येदं कचमाहुर्मुदान्विताः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110385, "chapter_id": 3387, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110386, "chapter_id": 3387, "verse_number": "२४", "content_sanskrit": "यत्त्वमस्मद्धितं कर्म कृतवान् परमं महत् ।\nन ते यशो जरां गन्ता भागभाक् त्वं भविष्यसि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110387, "chapter_id": 3387, "verse_number": "१४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषट्षष्टितमोऽध्यायः ॥६६॥ ॥ सम्भवपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]