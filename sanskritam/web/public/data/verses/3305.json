[{"id": 2106268, "chapter_id": 3305, "verse_number": "१६-३४-१", "content_sanskrit": "वैशम्पायन उवाच।\nततो निशायां प्राप्तायां कृतसायाह्निकक्रियाः।\nव्यासमभ्यगमन्सर्वे ये तत्रासन्समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106269, "chapter_id": 3305, "verse_number": "१६-३४-२", "content_sanskrit": "धृतराष्ट्रस्तु धर्मात्मा पाण्डवैः सहितस्तदा।\nशुचिरेकमनाः सार्धमृषिभिस्तैरुपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106270, "chapter_id": 3305, "verse_number": "१६-३४-३", "content_sanskrit": "गान्धार्या सह नार्यस्तु सहिताः समुपाविशन्।\nपौरजानपदश्चापि जनः सर्वो यथा वयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106271, "chapter_id": 3305, "verse_number": "१६-३४-४", "content_sanskrit": "ततो व्यासो महातेजाः पुण्यं भागीरथीजलम्।\nअवतीर्याजुहावाथ सँर्वाल्लोकान्महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106272, "chapter_id": 3305, "verse_number": "१६-३४-५", "content_sanskrit": "पाण्डवानां च ये योधाः कौरवाणां च सर्वशः।\nराजानश्च महाभागा नानादेशनिवासिनः।\n`प्रतीक्ष्य तस्थुस्ते सर्वे तेषामागमनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106273, "chapter_id": 3305, "verse_number": "१६-३४-६", "content_sanskrit": "ततः सुतुमुलः शब्दो जलान्ते जनमेजय।\nप्रादुरासीद्यथायोगं कुरुपाण्डवसेनयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106274, "chapter_id": 3305, "verse_number": "१६-३४-७", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे भीष्मद्रोणपुरोगमाः।\nससैन्याः सलिलात्तस्मात्समुत्तस्थुः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106275, "chapter_id": 3305, "verse_number": "१६-३४-८", "content_sanskrit": "विराटद्रुपदौ चैव सहपुत्रौ ससैनिकौ।\nद्रौपदेयाश्च सौभद्रो राक्षसश्च घटोत्कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106276, "chapter_id": 3305, "verse_number": "१६-३४-९", "content_sanskrit": "कर्णदुर्योधनौ चैव शकुनिश्च महारथः।\nदुःशासनादयश्चैव धार्तराष्ट्रा महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106277, "chapter_id": 3305, "verse_number": "१६-३४-१०", "content_sanskrit": "जारासन्धिर्भगदत्तो जलसन्धश्च वीर्यवान्।\nभूरिश्रवाः शलः शल्यो वृषसेनश्च सानुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106278, "chapter_id": 3305, "verse_number": "१६-३४-११", "content_sanskrit": "लक्ष्मणो राजपुत्रश्च धृष्टद्युम्नस्सहात्मजः।\nशिखण्डिपुत्राः सर्वे च धृष्टकेतुश्च सानुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106279, "chapter_id": 3305, "verse_number": "१६-३४-१२", "content_sanskrit": "अचलो वृषकश्चैव राक्षसश्चाप्यलायुधः।\nबाह्लिकः सोमदत्तश्च चेकितानश्च पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106280, "chapter_id": 3305, "verse_number": "१६-३४-१३", "content_sanskrit": "एते चान्ये च बहवो बहुत्वाद्ये न कीर्तिताः।\nसर्वे भासुरदेहास्ते समुत्तस्थुर्जलात्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106281, "chapter_id": 3305, "verse_number": "१६-३४-१४", "content_sanskrit": "यस्य् वीरस्य यो वेषो यो ध्वजो यच्च वाहनम्।\nयद्वर्म यत्प्रहरणं तेन तेन स दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106282, "chapter_id": 3305, "verse_number": "१६-३४-१५", "content_sanskrit": "दिव्यांबरधराः सर्वे सर्वे भ्राजिष्णुकुण्डलाः।\nनिर्वैरा निरहङ्कारा विगतक्रोधमत्सराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106283, "chapter_id": 3305, "verse_number": "१६-३४-१६", "content_sanskrit": "गन्धर्वैरुपगीयन्तः स्तूयमानाश्च बन्दिभिः।\nदिव्यमाल्यस्रजोपेतास्तथा दिव्याप्सरोवृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106284, "chapter_id": 3305, "verse_number": "१६-३४-१७", "content_sanskrit": "धृतराष्ट्रस्य च तदा दिव्यं चक्षुर्नराधिप।\nमुनिः सत्यवतीपुत्रः प्रीतः प्रादात्तपोबलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106285, "chapter_id": 3305, "verse_number": "१६-३४-१८", "content_sanskrit": "दिव्यज्ञानबलोपेता गान्धारी च यशस्विनी।\nददर्श पुत्रांस्तान्सर्वान्ये चान्येऽपि मृघे हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106286, "chapter_id": 3305, "verse_number": "१६-३४-१९", "content_sanskrit": "तदद्भुतमचिन्त्यं च सुमहद्रोमहर्षमम्।\nविस्मितः स जनः सर्वो ददर्शानिमिषेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106287, "chapter_id": 3305, "verse_number": "१६-३४-२०", "content_sanskrit": "तदुत्सवमहोदग्रं हृष्टनारीनराकुलम्।\nआश्चर्यभूतं ददृशे चित्रं पटगतं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106288, "chapter_id": 3305, "verse_number": "१६-३४-२१", "content_sanskrit": "धृतराष्ट्रस्तु तान्सर्वान्पश्यन्दिव्येन चक्षुषा।\nमुमुदे भरतश्रेष्ठ प्रसादात्तस्य वै मुनेः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106289, "chapter_id": 3305, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि पुत्रदर्शनपर्वणि चतुस्त्रिंशोऽध्यायः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]