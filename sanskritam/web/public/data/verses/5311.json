[{"id": 2202474, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2202475, "chapter_id": 5311, "verse_number": "१", "content_sanskrit": "पितामह महाबाहो सर्वशास्त्रविदांवर ।\nश्रोतुमिच्छामि मर्त्यानां संसारविधिमुत्तमम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2202476, "chapter_id": 5311, "verse_number": "२", "content_sanskrit": "केन वृत्तेन राजेन्द्र वर्तमाना नरा भुवि ।\nप्राप्नुवन्त्युत्तमं स्वर्गं कथं च नरकं नृप\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2202477, "chapter_id": 5311, "verse_number": "३", "content_sanskrit": "मृतं शरीरमुत्सृज्य काष्ठलोष्टसमं जनाः ।\nप्रयान्त्यमुं लोकमितः को वै ताननुगच्छति\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2202478, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2202479, "chapter_id": 5311, "verse_number": "४", "content_sanskrit": "असावायाति भगवान् बृहस्पतिरुदारधीः ।\nपृच्छैनं सुमहाभागमेतद् गुह्यं सनातनम्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2202480, "chapter_id": 5311, "verse_number": "५", "content_sanskrit": "नैतदन्येन शक्यं हि वक्तुं केनचिदद्य वै ।\nवक्ता बृहस्पतिसमो न ह्यन्यो विद्यते क्वचित्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2202481, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2202482, "chapter_id": 5311, "verse_number": "६", "content_sanskrit": "तयोः संवदतोरेवं पार्थगाङ्गेययोस्तदा ।\nआजगाम विशुद्धात्मा भगवान् स बृहस्पतिः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2202483, "chapter_id": 5311, "verse_number": "७", "content_sanskrit": "ततो राजा समुत्थाय धृतराष्ट्रपुरोगमः ।\nपूजामनुपमां चक्रे सर्वे ते च सभासदः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2202484, "chapter_id": 5311, "verse_number": "८", "content_sanskrit": "ततो धर्मसुतो राजा भगवन्तं बृहस्पतिम् ।\nउपगम्य यथान्यायं प्रश्नं पप्रच्छ सुव्रतः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2202485, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2202486, "chapter_id": 5311, "verse_number": "९", "content_sanskrit": "भगवन् सर्वधर्मज्ञ सर्वशास्त्रविशारद ।\nमर्त्यस्य कः सहायो वै पिता माता सुतो गुरुः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2202487, "chapter_id": 5311, "verse_number": "१०", "content_sanskrit": "मृतं शरीरमुत्सृज्य काष्ठलोष्टसमं जनाः ।\nगच्छन्त्यमुं च लोकं च क एनमनुगच्छति\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2202488, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2202489, "chapter_id": 5311, "verse_number": "११", "content_sanskrit": "एकः प्रसूतो राजेन्द्र एक एव प्रमीयते ।\nएकस्तरति दुर्गाणि गच्छत्येकश्च दुर्गतिम्\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2202490, "chapter_id": 5311, "verse_number": "१२", "content_sanskrit": "असहायः पिता माता तथा भ्राता सुतो गुरुः ।\nज्ञातिसम्बन्धिवर्गश्च मित्रवर्गस्तथैव च\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2202491, "chapter_id": 5311, "verse_number": "१३", "content_sanskrit": "मृतं शरीरमुत्सृज्य काष्ठलोष्टसमं जनाः ।\nमुहूर्तमुपतिष्ठन्ति ततो यान्ति पराङ्मुखाः ।\nतैः शरीरिणमुत्सृष्टं धर्म एकोऽनुगच्छति\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2202492, "chapter_id": 5311, "verse_number": "१४", "content_sanskrit": "तस्माद् धर्मः सहायार्थे सेवितव्यः सदा नृभिः ।\nप्राणी धर्मसमायुक्तो गच्छते स्वर्गतिं पराम् ।\nतथैवाधर्मसंयुक्तो नरकायोपपद्यते\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2202493, "chapter_id": 5311, "verse_number": "१५", "content_sanskrit": "तस्मान्न्यायागतैरर्थैर्धर्मं सेवेत पण्डितः ।\nधर्म एको मनुष्याणां सहायः पारलौकिकः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2202494, "chapter_id": 5311, "verse_number": "१६", "content_sanskrit": "लोभान्मोहादनुक्रोशाद् भयाद् वाप्यबहुश्रुतः ।\nनरः करोत्यकार्याणि परार्थे लोभमोहितः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2202495, "chapter_id": 5311, "verse_number": "१७", "content_sanskrit": "धर्मश्चार्थश्च कामश्च त्रितयं जीविते फलम् ।\nएतत् त्रयमवाप्तव्यमधर्मपरिवर्जितम्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2202496, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2202497, "chapter_id": 5311, "verse_number": "१८", "content_sanskrit": "श्रुतं भगवतो वाक्यं धर्मयुक्तं परं हितम् ।\nशरीरविषयं ज्ञातुं बुद्धिस्तु मम जायते\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2202498, "chapter_id": 5311, "verse_number": "१९", "content_sanskrit": "मृतं शरीररहितं सूक्ष्ममव्यक्ततां गतम् ।\nअचक्षुर्विषयं प्राप्तं कथं धर्मोऽनुगच्छति\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2202499, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2202500, "chapter_id": 5311, "verse_number": "२०", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम् ।\nबुद्धिरात्मा च सहिता धर्मं पश्यन्ति नित्यशः\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2202501, "chapter_id": 5311, "verse_number": "२१", "content_sanskrit": "प्राणिनामिह सर्वेषां साक्षिभूता दिवानिशम् ।\nएतैश्च स ह धर्मोऽपि तं जीवमनुगच्छति\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2202502, "chapter_id": 5311, "verse_number": "२२", "content_sanskrit": "त्वगस्थिमांसं शुक्रं च शोणितं च महामते ।\nशरीरं वर्जितं चैतैर्जीवितेन विवर्जितम्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2202503, "chapter_id": 5311, "verse_number": "२३", "content_sanskrit": "ततो धर्मसमायुक्तः स जीवः सुखमेधते ।\nइह लोके परे चैव किम्भूयः कथयामि ते\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2202504, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2202505, "chapter_id": 5311, "verse_number": "२४", "content_sanskrit": "अनुदर्शितं भगवता यथा धर्मोऽनुगच्छति ।\nएतत्तु ज्ञातुमिच्छामि कथं रेतः प्रवर्तते\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2202506, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2202507, "chapter_id": 5311, "verse_number": "२५", "content_sanskrit": "अन्नमश्नन्ति ये देवाः शरीरस्था नरेश्वर ।\nपृथिवी वायुराकाशमापो ज्योतिर्मनस्तथा\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2202508, "chapter_id": 5311, "verse_number": "२६", "content_sanskrit": "ततस्तृप्तेषु राजेन्द्र तेषु भूतेषु पञ्चसु ।\nमनःषष्ठेषु शुद्धात्मन् रेतः सम्पद्यते महत्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2202509, "chapter_id": 5311, "verse_number": "२७", "content_sanskrit": "ततो गर्भः सम्भवति स्त्रीपुंसोः पार्थ सङ्गमे ।\nएतत्ते सर्वमाख्यातं किम्भूयः कथयामि ते\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2202510, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2202511, "chapter_id": 5311, "verse_number": "२८", "content_sanskrit": "आख्यातमेतद् भवता गर्भः सञ्जायते यथा ।\nयथा जातस्तु पुरुषः प्रपद्यति तदुच्यताम्\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2202512, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2202513, "chapter_id": 5311, "verse_number": "२९", "content_sanskrit": "आसन्नमात्रः सततं तैर्भूतैरभिभूयते ।\nविप्रमुक्तश्च तैर्भूतैः पुनर्यात्यपरां गतिम् ।\nस तु भूतसमायुक्तः प्राप्नुते जीव एव ह\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2202514, "chapter_id": 5311, "verse_number": "३०", "content_sanskrit": "ततोऽस्य कर्म पश्यन्ति शुभं वा यदि वाशुभम् ।\nदेवताः पञ्चभूतस्थाः किम्भूयः श्रोतुमिच्छसि\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2202515, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2202516, "chapter_id": 5311, "verse_number": "३१", "content_sanskrit": "त्वगस्थिमांसमुत्सृज्य तैश्च भूतैर्विवर्जितः ।\nजीवः स भगवन् क्वस्थः सुखदुःखे समश्नुते\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2202517, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "बृहस्पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2202518, "chapter_id": 5311, "verse_number": "३२", "content_sanskrit": "जीवो धर्मसमायुक्तः शीघ्रं रेतस्त्वमागतः ।\nस्त्रीणां तु पुष्पमासाद्य सूते कालेन भारत\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2202519, "chapter_id": 5311, "verse_number": "३३", "content_sanskrit": "यमस्य पुरुषैः क्लेशं यमस्य पुरुषैर्वधम् ।\nदुःखं संसारचक्रं च नरः क्लेशं च गच्छति\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2202520, "chapter_id": 5311, "verse_number": "३४", "content_sanskrit": "इहलोके च स प्राणी जन्मप्रभृति पार्थिव ।\nस्वकृतं कर्म वै भुङ्क्ते धर्मस्य फलमाश्रितः\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2202521, "chapter_id": 5311, "verse_number": "३५", "content_sanskrit": "यदि धर्मं यथाशक्ति जन्मप्रभृति सेवते ।\nततः स पुरुषो भूत्वा सेवते नित्यदा सुखम्\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2202522, "chapter_id": 5311, "verse_number": "३६", "content_sanskrit": "अथान्तरा तु धर्मस्य अधर्ममुपसेवते ।\nसुखस्यानन्तरं दुःखं स जीवोऽप्यधिगच्छति\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2202523, "chapter_id": 5311, "verse_number": "३७", "content_sanskrit": "अधर्मेण समायुक्तो यमस्य विषयं गतः ।\nमहद्दुःखं समासाद्य तिर्यग्योनौ प्रजायते\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2202524, "chapter_id": 5311, "verse_number": "३८", "content_sanskrit": "कर्मणा येन येनेह यस्यां योनौ प्रसूयते ।\nजीवो मोहसमायुक्तस्तन्मे निगदतः शृणु\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2202525, "chapter_id": 5311, "verse_number": "३९", "content_sanskrit": "यदेतदुच्यते शास्त्रे सेतिहासे सछन्दसि ।\nयमस्य विषयं घोरं मर्त्यलोकात् प्रपद्यते\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2202526, "chapter_id": 5311, "verse_number": "४०", "content_sanskrit": "अधीत्य चतुरो वेदान् द्विजो मोहसमन्वितः ।\nपतितात् प्रतिगृह्याथ खरयोनौ प्रजायते\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2202527, "chapter_id": 5311, "verse_number": "४१", "content_sanskrit": "खरो जीवति वर्षाणि दश पञ्च च भारत ।\nखरो मृतो बलीवर्दः सप्त वर्षाणि जीवति\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2202528, "chapter_id": 5311, "verse_number": "४२", "content_sanskrit": "बलीवर्दो मृतश्चापि जायते ब्रह्मराक्षसः ।\nब्रह्मरक्षस्तु त्रीन् मासान् जायते ब्राह्मणस्ततः\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2202529, "chapter_id": 5311, "verse_number": "४३", "content_sanskrit": "पतितं याजयित्वा तु कृमियोनौ प्रजायते ।\nतत्र जीवति वर्षाणि दश पञ्च च भारत\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2202530, "chapter_id": 5311, "verse_number": "४४", "content_sanskrit": "कृमिभावात् प्रमुक्तस्तु ततो जायति गर्दभः ।\nगर्दभः पञ्च वर्षाणि पञ्च वर्षाणि सूकरः ।\nश्वा वर्षमेकं भवति ततो जायति मानवः\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2202531, "chapter_id": 5311, "verse_number": "४५", "content_sanskrit": "उपाध्याये तु यः पापं शिष्यः कुर्यादबुद्धिमान् ।\nस जीव इह संसारांस्त्रीनाप्नोति न संशयः\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2202532, "chapter_id": 5311, "verse_number": "४६", "content_sanskrit": "प्राक् श्वा भवति राजेन्द्र ततः क्रव्यात् ततः खरः ।\nततः प्रेतः परिक्लिष्टः ततो जायेत ब्राह्मणः\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2202533, "chapter_id": 5311, "verse_number": "४७", "content_sanskrit": "मनसापि गुरोर्भार्यां यः शिष्यो याति पापकृत् ।\nसोऽधमान् याति संसारान् अधमेनेह कर्मणा\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2202534, "chapter_id": 5311, "verse_number": "४८", "content_sanskrit": "श्वयोनौ तु स सम्भूतस्त्रीणि वर्षाणि जीवति ।\nतत्रापि निधनं प्राप्तः कृमियोनौ प्रजायते\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2202535, "chapter_id": 5311, "verse_number": "४९", "content_sanskrit": "कृमिभावमवाप्नोति वर्षमेकं स जीवति ।\nततस्तु निधनं प्राप्य ब्रह्मयोनौ प्रजायते\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2202536, "chapter_id": 5311, "verse_number": "५०", "content_sanskrit": "यदि पुत्रसमं शिष्यं गुरुर्हन्यादकारणे ।\nआत्मनः कामकारेण सोऽपि हंसः प्रजायते\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2202537, "chapter_id": 5311, "verse_number": "५१", "content_sanskrit": "पितरं मातरं वापि यस्तु पुत्रोऽवमन्यते ।\nसोऽपि राजन् मृतो जन्तुः पूर्वं जायति गर्दभः\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2202538, "chapter_id": 5311, "verse_number": "५२", "content_sanskrit": "खरो जीवति मासांस्तु दश श्वा च चतुर्दश ।\nबिडालः सप्त मासांस्तु ततो जायति मानवः\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2202539, "chapter_id": 5311, "verse_number": "५३", "content_sanskrit": "मातापितरमाक्रुश्य सारिकः सम्प्रजायते ।\nताडयित्वा तु तावेव कच्छपः सम्प्रजायते\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2202540, "chapter_id": 5311, "verse_number": "५४", "content_sanskrit": "कच्छपो दश वर्षाणि त्रीणि वर्षाणि शल्यकः ।\nव्यालो भूत्वा तु षण्मासांस्ततो जायति मानुषः\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2202541, "chapter_id": 5311, "verse_number": "५५", "content_sanskrit": "भर्तृपिण्डमुपाश्नन् यो राजद्विष्टानि सेवते ।\nसोऽपि मोहसमापन्नो मृतो जायति वानरः\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2202542, "chapter_id": 5311, "verse_number": "५६", "content_sanskrit": "वानरो दश वर्षाणि त्रीणि वर्षाणि मूषकः ।\nश्वा भूत्वा चाथ षण्मासांस्ततो जायति मानुषः\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2202543, "chapter_id": 5311, "verse_number": "५७", "content_sanskrit": "न्यासापहर्ता तु नरो यमस्य विषयं गतः ।\nसंसाराणां शतं गत्वा क्रिमियोनौ प्रजायते\t ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2202544, "chapter_id": 5311, "verse_number": "५८", "content_sanskrit": "तत्र जीवति वर्षाणि दश पञ्च च भारत ।\nदुष्कृतस्य क्षयं गत्वा ततो जायति मानुषः\t ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2202545, "chapter_id": 5311, "verse_number": "५९", "content_sanskrit": "असूयको नरश्चापि मृतो जायति शार्ङ्गकः ।\nविश्वासहर्ता तु नरो मीनो जायति दुर्मतिः\t ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2202546, "chapter_id": 5311, "verse_number": "६०", "content_sanskrit": "भूत्वा मीनोऽष्टवर्षाणि मृगो जायति भारत ।\nमृगस्तु चतुरो मासांस्ततश्छागः प्रजायते\t ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2202547, "chapter_id": 5311, "verse_number": "६१", "content_sanskrit": "छागस्तु निधनं प्राप्य पूर्णे संवत्सरे ततः ।\nकीटः सञ्जायते जन्तुस्ततो जायति मानुषः\t ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2202548, "chapter_id": 5311, "verse_number": "६२", "content_sanskrit": "धान्यान् यवान् तिलान् माषान् कुलत्थान् सर्षपान् चणान् ।\nकलायानथ मुद्गांश्च गोधूमानतसीस्तथा\t ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2202549, "chapter_id": 5311, "verse_number": "६३", "content_sanskrit": "यस्तु धान्यस्य हर्ता तु मोहाज्जन्तुरचेतनः ।\nस जायते महाराज मूषको निरपत्रपः\t ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2202550, "chapter_id": 5311, "verse_number": "६४", "content_sanskrit": "ततः प्रेत्य महाराज पुनर्जायति सूकरः ।\nसूकरो जातमात्रस्तु रोगेण म्रियते नृप\t ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2202551, "chapter_id": 5311, "verse_number": "६५", "content_sanskrit": "श्वा ततो जायते मूढः कर्मणा तेन पार्थिव ।\nश्वा भूत्वा पञ्च वर्षाणि जायते मानुषस्ततः\t ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2202552, "chapter_id": 5311, "verse_number": "६६", "content_sanskrit": "परदाराभिमर्शं तु कृत्वा जायति वै वृकः ।\nश्वा सृगालस्ततो गृध्रो व्यालः कङ्को बकस्तथा\t ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2202553, "chapter_id": 5311, "verse_number": "६७", "content_sanskrit": "भ्रातुर्भार्यां तु दुर्बुद्धिर्यो धर्षयति मोहितः ।\nपुंस्कोकिलत्वमाप्नोति सोऽपि संवत्सरं नृप\t ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2202554, "chapter_id": 5311, "verse_number": "६८", "content_sanskrit": "सखिभार्यां गुरोर्भार्यां राजभार्यां तथैव च ।\nप्रधर्षयित्वा कामाद् यो मृतो जायति सूकरः\t ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2202555, "chapter_id": 5311, "verse_number": "६९", "content_sanskrit": "सूकरः पञ्च वर्षाणि पञ्च वर्षाणि श्वाविधः ।\nपिपीलकस्तु षण्मासान् कीटः स्यान्मासमेव च ।\nएतानासाद्य संसारान् कृमियोनौ प्रजायते\t ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2202556, "chapter_id": 5311, "verse_number": "७०", "content_sanskrit": "तत्र जीवति मासांस्तु कृमियोनौ त्रयोदश ।\nततोऽधर्मक्षयं कृत्वा पुनर्जायति मानुषः\t ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2202557, "chapter_id": 5311, "verse_number": "७१", "content_sanskrit": "उपस्थिते विवाहे तु दाने यज्ञेऽपि वाभिभो ।\nमोहात् करोति यो विघ्नं स मृतो जायते कृमिः\t ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2202558, "chapter_id": 5311, "verse_number": "७२", "content_sanskrit": "कृमिर्जीवति वर्षाणि दश पञ्च च भारत ।\nअधर्मस्य क्षयं कृत्वा ततो जायति मानुषः\t ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2202559, "chapter_id": 5311, "verse_number": "७३", "content_sanskrit": "पूर्वं दत्त्वा तु यः कन्यां द्वितीये दातुमिच्छति ।\nसोऽपि राजन् मृतो जन्तुः कृमियोनौ प्रजायते\t ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2202560, "chapter_id": 5311, "verse_number": "७४", "content_sanskrit": "तत्र जीवति वर्षाणि त्रयोदश युधिष्ठिर ।\nअधर्मसङ्क्षये युक्तस्ततो जायति मानुषः\t ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2202561, "chapter_id": 5311, "verse_number": "७५", "content_sanskrit": "देवकार्यमुपाकृत्य पितृकार्यमथापि च ।\nअनिर्वाप्य समश्नन् वै ततो जायति वायसः\t ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2202562, "chapter_id": 5311, "verse_number": "७६", "content_sanskrit": "वायसो दश वर्षाणि ततो जायति कुक्कुटः ।\nजायते लवकश्चापि मासं तस्मात्तु मानुषः\t ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2202563, "chapter_id": 5311, "verse_number": "७७", "content_sanskrit": "ज्येष्ठं पितृसमं चापि भ्रातरं योऽवमन्यते ।\nसोऽपि मृत्युमुपागम्य क्रौञ्चयोनौ प्रजायते\t ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2202564, "chapter_id": 5311, "verse_number": "७८", "content_sanskrit": "क्रौञ्चो जीवति मासांस्तु दश द्वौ सप्त पञ्च च ।\nततो निधनमापन्नो मानुषत्वमुपाश्नुते\t ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2202565, "chapter_id": 5311, "verse_number": "७९", "content_sanskrit": "वृषलो ब्राह्मणीं गत्वा कृमियोनौ प्रजायते ।\nतत्रापत्यं समुत्पाद्य ततो भवति मानुषः\t ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2202566, "chapter_id": 5311, "verse_number": "८०", "content_sanskrit": "कृतघ्नस्तु मृतो राजन् यमस्य विषयं गतः ।\nयमस्य विषये क्रुद्धैर्वधं प्राप्नोति दारुणम्\t ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2202567, "chapter_id": 5311, "verse_number": "८१", "content_sanskrit": "पट्टिसं मुद्गरं शूलमग्निकुम्भं च दारुणम् ।\nअसिपत्रवनं घोरं वालुकां कूटशाल्मलीम्\t ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2202568, "chapter_id": 5311, "verse_number": "८२", "content_sanskrit": "एताश्चान्याश्च बह्वीः स यमस्य विषयं गतः ।\nयातनाः प्राप्य तत्रोग्रास्ततो वध्यति भारत\t ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2202569, "chapter_id": 5311, "verse_number": "८३", "content_sanskrit": "संसारचक्रमासाद्य कृमियोनौ प्रजायते ।\nकृमिर्भवति वर्षाणि दश पञ्च च भारत ।\nततो गर्भं समासाद्य तत्रैव म्रियते शिशुः\t ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2202570, "chapter_id": 5311, "verse_number": "८४", "content_sanskrit": "ततो गर्भशतैर्जन्तुर्बहुभिः सम्प्रजायते ।\nसंसारांश्च बहून् गत्वा ततस्तिर्यक् प्रजायते\t ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2202571, "chapter_id": 5311, "verse_number": "८५", "content_sanskrit": "मृतो दुःखमनुप्राप्य बहुवर्षगणानिह ।\nअपुनर्भावसंयुक्तः तिर्यग्जन्तुषु जायते\t ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2202572, "chapter_id": 5311, "verse_number": "८६", "content_sanskrit": "अशस्त्रं पुरुषं हत्वा सशस्त्रः पुरुषाधमः ।\nअर्थार्थी यदि वा वैरी स मृतो जायते खरः\t ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2202573, "chapter_id": 5311, "verse_number": "८७", "content_sanskrit": "खरो जीवति वर्षे द्वे ततः शस्त्रेण वध्यते ।\nस मृतो मृगयोनौ तु नित्योद्विग्नोऽभिजायते\t ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2202574, "chapter_id": 5311, "verse_number": "८८", "content_sanskrit": "मृगो वध्यति शस्त्रेण गते संवत्सरे तु सः ।\nहतो मृगस्ततो मीनः सोऽपि जालेन बध्यते\t ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2202575, "chapter_id": 5311, "verse_number": "८९", "content_sanskrit": "मासे चतुर्थे सम्प्राप्ते श्वापदः सम्प्रजायते ।\nश्वापदो दश वर्षाणि द्वीपी वर्षाणि पञ्च च\t ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2202576, "chapter_id": 5311, "verse_number": "९०", "content_sanskrit": "ततस्तु निधनं प्राप्तः कालपर्यायचोदितः ।\nअधर्मस्य क्षयं कृत्वा ततो जायति मानुषः\t ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2202577, "chapter_id": 5311, "verse_number": "९१", "content_sanskrit": "स्त्रियं हत्वा तु दुर्बुद्धिर्यमस्य विषयं गतः ।\nबहून् क्लेशान् समासाद्य नरकानेकविंशतिम्\t ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2202578, "chapter_id": 5311, "verse_number": "९२", "content_sanskrit": "ततः पश्चान्महाराज कृमियोनौ प्रजायते ।\nकृमिर्विंशतिवर्षाणि भूत्वा जायति मानुषः\t ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2202579, "chapter_id": 5311, "verse_number": "९३", "content_sanskrit": "भोजनं चोरयित्वा तु मक्षिका जायते नरः ।\nमक्षिकासङ्घवशगो बहून् मासान् भवत्युत ।\nततः पापक्षयं कृत्वा मानुषत्वमवाप्नुते\t ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2202580, "chapter_id": 5311, "verse_number": "९४", "content_sanskrit": "वाद्यं हृत्वा तु पुरुषो मशकः सम्प्रजायते ।\nतथा पिण्याकसंमिश्रमशनं चोरयेन्नरः ।\nजायते श्वभ्रनियतो दारुणो मूषको नरः\t ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2202581, "chapter_id": 5311, "verse_number": "९५", "content_sanskrit": "लवणं चोरयित्वा तु चीरीवाकः प्रजायते ।\nदधि हृत्वा बकश्चापि प्लवो मत्स्यानसंस्कृतान्\t ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2202582, "chapter_id": 5311, "verse_number": "९६", "content_sanskrit": "चोरयित्वा पयश्चापि बलाका सम्प्रजायते ।\nयस्तु चोरयते तैलं तैलपायी प्रजायते ।\nचोरयित्वा तु दुर्बुद्धिर्मधु दंशः प्रजायते\t ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2202583, "chapter_id": 5311, "verse_number": "९७", "content_sanskrit": "अयो हृत्वा तु दुर्बुद्धिर्वायसो जायते नरः ।\nपायसं चोरयित्वा तु तित्तिरित्वमवाप्नुते\t ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2202584, "chapter_id": 5311, "verse_number": "९८", "content_sanskrit": "हृत्वा पैष्टमपूपं च कुम्भोलूकः प्रजायते ।\nफलं वा मूलकं हृत्वा जायेत् पिपीलिकः\t ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2202585, "chapter_id": 5311, "verse_number": "९९", "content_sanskrit": "कांस्यं हृत्वा तु दुर्बुद्धिर्हारीतो जायते नरः ।\nराजतं भाजनं हृत्वा कपोतः सम्प्रजायते\t ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2202586, "chapter_id": 5311, "verse_number": "१००", "content_sanskrit": "हृत्वा तु काञ्चनं भाण्डं कृमियोनौ प्रजायते ।\nक्रौञ्चः कार्पासिकं हृत्वा मृतो जायेत मानुषः\t ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2202587, "chapter_id": 5311, "verse_number": "१०१", "content_sanskrit": "पत्रोर्णं चोरयित्वा तु कृकलत्वं निगच्छति ।\nकौशिकं तु ततो हृत्वा नरो जायति वर्तकः \t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2202588, "chapter_id": 5311, "verse_number": "१०२", "content_sanskrit": "अंशुकं चोरयित्वा तु कपोतः सम्प्रजायते ।\nचोरयित्वा दुकूलं तु मृतो हंसः प्रजायते \t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2202589, "chapter_id": 5311, "verse_number": "१०३", "content_sanskrit": "चोरयित्वा नरः पट्टं त्वाविकं वापि भारत ।\nक्षौमं च वस्त्रमादाय शशो जन्तुः प्रजायते\t ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2202590, "chapter_id": 5311, "verse_number": "१०४", "content_sanskrit": "वर्णान् हृत्वा तु पुरुषो मृतो जायति बर्हिणः ।\nहृत्वा रक्तानि वस्त्राणि जायते जीवजीवकः\t ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2202591, "chapter_id": 5311, "verse_number": "१०५", "content_sanskrit": "वर्णकादींस्तथा गन्धांश्चोरयित्वा तु मानवः ।\nछुच्छुन्दरित्वमाप्नोति राजन् लोभपरायणः\t ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2202592, "chapter_id": 5311, "verse_number": "१०६", "content_sanskrit": "विश्वासेन तु निक्षिप्तं यो निह्नवति मानवः ।\nस गतासुर्नरस्तादृङ्मत्स्ययोनौ प्रजायते\t ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2202593, "chapter_id": 5311, "verse_number": "१०७", "content_sanskrit": "मत्स्ययोनिमनुप्राप्य मृतो जायति मानुषः ।\nमानुषत्वमनुप्राप्य क्षीणायुरुपपद्यते\t ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2202594, "chapter_id": 5311, "verse_number": "१०८", "content_sanskrit": "पापानि तु नरः कृत्वा तिर्यग्जायति भारत ।\nन चात्मनः प्रमाणं ते धर्मं जानाति कञ्चन\t ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2202595, "chapter_id": 5311, "verse_number": "१०९", "content_sanskrit": "ये पापानि नराः कृत्वा निरस्यन्ति व्रतैः सदा ।\nसुखदुःखसमायुक्ता व्याधितास्ते भवन्त्युत\t ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2202596, "chapter_id": 5311, "verse_number": "११०", "content_sanskrit": "असंवासाः प्रजायन्ते म्लेच्छाश्चापि न संशयः ।\nनराः पापसमाचारा लोभमोहसमन्विताः\t ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2202597, "chapter_id": 5311, "verse_number": "१११", "content_sanskrit": "वर्जयन्ति च पापानि जन्मप्रभृति ये नराः ।\nअरोगा रूपवन्तस्ते धनिनश्च भवन्त्युत\t ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2202598, "chapter_id": 5311, "verse_number": "११२", "content_sanskrit": "स्त्रियोऽप्येतेन कल्पेन कृत्वा पापमवाप्नुयुः ।\nएतेषामेव जन्तूनां पत्नीत्वमुपयान्ति ताः\t ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2202599, "chapter_id": 5311, "verse_number": "११३", "content_sanskrit": "परस्वहरणे दोषाः सर्व एव प्रकीर्तिताः ।\nएतद्वै लेशमात्रेण कथितं ते मयाऽनघ ।\nअपरस्मिन् कथायोगे भूयः श्रोष्यसि भारत\t ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2202600, "chapter_id": 5311, "verse_number": "११४", "content_sanskrit": "एतन्मया महाराज ब्रह्मणो वदतः पुरा ।\nसुरर्षीणां श्रुतं मध्ये पृष्टश्चापि यथातथम्\t ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2202601, "chapter_id": 5311, "verse_number": "११५", "content_sanskrit": "मयाऽपि तव कार्त्स्न्येन यथावदनुवर्णितम् ।\nएतच्छ्रुत्वा महाराज धर्मे कुरु मनः सदा\t ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2202602, "chapter_id": 5311, "verse_number": "", "content_sanskrit": "॥इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे संसारचक्रनिरूपणं नाम द्विषष्ट्युत्तरशततमोऽध्यायः ॥१६२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}]