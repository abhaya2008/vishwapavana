[{"id": 2145489, "chapter_id": 4133, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145490, "chapter_id": 4133, "verse_number": "१", "content_sanskrit": "सदृशानां मनुष्येषु सर्वेषां तुल्यजन्मनाम् ।\nकथमेकान्ततस्तेषां पार्थानां मन्यसे जयम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145491, "chapter_id": 4133, "verse_number": "२", "content_sanskrit": "वयं च तेऽपि तुल्या वै वीर्येण च पराक्रमैः ।\nसमेन वयसा चैव प्रज्ञया च श्रुतेन च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145492, "chapter_id": 4133, "verse_number": "३", "content_sanskrit": "अस्त्रेषु रथचर्यासु शीघ्रत्वे कौशले तथा ।\nसर्वे स्म समजातीयाः सर्वे स्म समयोनयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145493, "chapter_id": 4133, "verse_number": "४", "content_sanskrit": "पितामह विजानीषे पार्थेषु विजयं कथम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145494, "chapter_id": 4133, "verse_number": "५", "content_sanskrit": "नाहं भवति न द्रोणे न कृपे न च बाह्लिके ।\nअन्येषु च नरेन्द्रेषु पराक्रम्य समारभे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145495, "chapter_id": 4133, "verse_number": "६", "content_sanskrit": "अहं वैकर्तनः कर्णो भ्राता दुःशासनश्च मे ।\nपाण्डवान् समरे पञ्च हनिष्यामः शितैः शरैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145496, "chapter_id": 4133, "verse_number": "७", "content_sanskrit": "ततो राजन् महायज्ञैर्विविधैर्भूरिदक्षिणैः ।\nब्राह्मणांस्तर्पयिष्यामि गोभिरश्वैर्धनेन च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145497, "chapter_id": 4133, "verse_number": "८", "content_sanskrit": "यदा परिकरिष्यन्ति ऐणेयानिव तन्तुना ।\nअतरित्रानिव जले बाहुभिर्मामका रणे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145498, "chapter_id": 4133, "verse_number": "९", "content_sanskrit": "पश्यतस्ते परांस्तत्र रथनागसमाकुलान् ।\nतदा दर्पं विमोक्ष्यन्ति पाण्डवाः स च केशवः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145499, "chapter_id": 4133, "verse_number": "१०", "content_sanskrit": "सुखान्यवाप्य सहिताः कृत्वा कर्म सुदुष्करम् ।\nविस्रब्धास्तु भविष्यामः प्राप्ते काले गतज्वराः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145500, "chapter_id": 4133, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145501, "chapter_id": 4133, "verse_number": "११", "content_sanskrit": "अथाब्रवीन्महाराजो धृतराष्ट्रः सुदुर्मनाः ।\nविदुरं विदुषां श्रेष्ठं सर्वपार्थिवसन्निधौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145502, "chapter_id": 4133, "verse_number": "१२", "content_sanskrit": "मोहितो मृत्युपाशेन कालस्य वशमागतः ।\nतात कर्णेन सहितः पुत्रो दुर्योधनो मम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145503, "chapter_id": 4133, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145504, "chapter_id": 4133, "verse_number": "१३", "content_sanskrit": "इह निश्रेयसं प्राहुर्वृद्धा निश्चयदर्शिनः ।\nब्राह्मणस्य विशेषेण दमो धर्मः सनातनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145505, "chapter_id": 4133, "verse_number": "१४", "content_sanskrit": "तस्य दानं क्षमा सिद्धिर्यथावदुपपद्यते ।\nदमो दानं तपो ज्ञानमधीतं चानुवर्तते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145506, "chapter_id": 4133, "verse_number": "१५", "content_sanskrit": "दमस्तेजो वर्धयति पवित्रं दम उत्तमम् ।\nविप्रात्मा वृद्धतेजास्तु पुरुषो विन्दते महत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145507, "chapter_id": 4133, "verse_number": "१६", "content_sanskrit": "क्रव्याद्भ्य इव भूतानामदान्तेभ्यः सदा भयम् ।\nतेषां च प्रतिषेधार्थं क्षत्रं सृष्टं स्वयम्भुवा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145508, "chapter_id": 4133, "verse_number": "१७", "content_sanskrit": "आश्रमेषु चतुर्ष्वाहुर्दममेवोत्तमं व्रतम् ।\nतस्य लिङ्गं प्रवक्ष्यामि येषां समुदयो दमः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145509, "chapter_id": 4133, "verse_number": "१८", "content_sanskrit": "क्षमा धृतिरहिंसा च समता सत्यमार्जवम् ।\nइन्द्रियाभिजयो धैर्यं मार्दवं ह्रीरचापलम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145510, "chapter_id": 4133, "verse_number": "१९", "content_sanskrit": "अकार्पण्यमसंरम्भः सन्तोषः श्रद्दधानता ।\nएतानि यस्य राजेन्द्र स दान्तः पुरुषः स्मृतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145511, "chapter_id": 4133, "verse_number": "२०", "content_sanskrit": "कामो लोभश्च दर्पश्च मन्युर्निद्रा विकत्थनम् ।\nमान ईर्ष्या च शोकश्च नैतद् दान्तो निषेवते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145512, "chapter_id": 4133, "verse_number": "२१", "content_sanskrit": "अजिह्ममशठं शुद्धम् एतद् दान्तस्य लक्षणम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145513, "chapter_id": 4133, "verse_number": "२२", "content_sanskrit": "अलोलुपस्तथाऽल्पेप्सुः कामानामविचिन्तकः ।\nसमुद्रकल्पः पुरुषः स दान्तः परिकीर्तितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145514, "chapter_id": 4133, "verse_number": "२३", "content_sanskrit": "सुवृत्तः शीलसम्पन्नः प्रसन्नात्माऽऽत्मविद् बुधः ।\nप्राप्येह लोके सम्मानं स्वर्गतिं प्रेत्य गच्छति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145515, "chapter_id": 4133, "verse_number": "२४", "content_sanskrit": "अभयं यस्य भूतेभ्यः सर्वेषामभयं यतः ।\nस वै परिणतप्रज्ञः प्रख्यातो मनुजोत्तमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145516, "chapter_id": 4133, "verse_number": "२५", "content_sanskrit": "सर्वभूतहितो मैत्रः तस्मान्नोद्विजते जनः ।\nसमुद्र इव गम्भीरः प्रज्ञातृप्तः प्रशाम्यति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145517, "chapter_id": 4133, "verse_number": "२६", "content_sanskrit": "कर्मणाऽऽचरितं पूर्वं सद्भिराचरितं च यत् ।\nतदेवास्थाय मोदन्ते दान्ताः शमपरायणाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145518, "chapter_id": 4133, "verse_number": "२७", "content_sanskrit": "नैष्कर्म्यं वा समास्थाय ज्ञानतृप्तो जितेन्द्रियः ।\nकालाकाङ्क्षी चरँल्लोके ब्रह्मभूयाय कल्पते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2145519, "chapter_id": 4133, "verse_number": "२८", "content_sanskrit": "शकुनीनामिवाकाशे पदं नैवोपलभ्यते ।\nएवं प्रज्ञानतृप्तस्य मुनेर्वर्त्म न दृश्यते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2145520, "chapter_id": 4133, "verse_number": "२९", "content_sanskrit": "उत्सृज्य वा गृहान् यस्तु मोक्षमेवाभिमन्यते ।\nलोकास्तेजोमयास्तस्य कल्प्यन्ते शाश्वता दिवि\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2145521, "chapter_id": 4133, "verse_number": "३०", "content_sanskrit": "कश्चिच्छाकुनिको राजन् पूर्वमासीदिति श्रुतिः ।\nशकुनीनां वधार्थाय पाशान् भूमावयोजयत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2145522, "chapter_id": 4133, "verse_number": "३१", "content_sanskrit": "तस्मिन् यौ शकुनौ बद्धौ युगपत् सहचारिणौ ।\nतावुपादाय तं पाशं जग्मतुः खचरावुभौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2145523, "chapter_id": 4133, "verse_number": "३२", "content_sanskrit": "तौ विहायसमाक्रान्तौ दृष्ट्वा शाकुनिकस्तदा ।\nअन्वधावदनिर्विण्णो येन येन स्म गच्छतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2145524, "chapter_id": 4133, "verse_number": "३३", "content_sanskrit": "तथा तमनुधावन्तं मृगयुं शकुनार्थिनम् ।\nआश्रमस्थो मुनिः कश्चिद् ददर्शाथ कृताह्निकः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2145525, "chapter_id": 4133, "verse_number": "३४", "content_sanskrit": "तावन्तरिक्षगौ शीघ्रमनुयान्तं महीचरम् ।\nश्लोकेनानेन कौरव्य पप्रच्छ स मुनिस्तदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2145526, "chapter_id": 4133, "verse_number": "३५", "content_sanskrit": "विचित्रमिदमाश्चर्यं मृगयो प्रतिभाति मे ।\nप्लवमानौ हि खचरौ पदातिरनुधावति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2145527, "chapter_id": 4133, "verse_number": "", "content_sanskrit": "शाकुनिकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2145528, "chapter_id": 4133, "verse_number": "३६", "content_sanskrit": "पाशमेकमुभावेतौ सहितौ हरतो मम ।\nयत्र वै विवदिष्येते तत्र मे वशमेष्यतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2145529, "chapter_id": 4133, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2145530, "chapter_id": 4133, "verse_number": "३७", "content_sanskrit": "तौ विवादमनुप्राप्तौ शकुनौ मृत्युसन्धितौ ।\nविगृह्य पाशं दुर्बुद्धी पृथिव्यां सन्निपेततुः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2145531, "chapter_id": 4133, "verse_number": "३८", "content_sanskrit": "तौ युद्ध्यमानौ संरब्धौ मृत्युपाशवशानुगौ ।\nउपसृत्य प्रमत्तौ तौ जग्राह मृगयुस्तदा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2145532, "chapter_id": 4133, "verse_number": "३९", "content_sanskrit": "एवं ये ज्ञातयोऽर्थेषु मिथो गच्छन्ति विग्रहम् ।\nते मृत्युवशमायान्ति शकुनाविव विग्रहात्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2145533, "chapter_id": 4133, "verse_number": "४०", "content_sanskrit": "सम्भोजनं सङ्कथनं सम्प्रश्नोऽथ समागमः ।\nएतानि ज्ञातिकार्याणि न विरोधः कदाचन\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2145534, "chapter_id": 4133, "verse_number": "४१", "content_sanskrit": "ये स्म काले सुमनसः सर्वे वृद्धानुपासते ।\nसिंहगुप्तमिवारण्यमप्रधृष्या भवन्ति ते\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2145535, "chapter_id": 4133, "verse_number": "४२", "content_sanskrit": "ये तु सन्निधिमासाद्य दीना इव समासते ।\nश्रियं ते सम्प्रयच्छन्ति द्विषद्भ्यो भरतर्षभ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2145536, "chapter_id": 4133, "verse_number": "४३", "content_sanskrit": "धूमायान्ते व्यपेतानि ज्वलन्ति सहितानि च ।\nधृतराष्ट्रोल्मुकानीव ज्ञातयो भरतर्षभ\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2145537, "chapter_id": 4133, "verse_number": "४४", "content_sanskrit": "इदमन्यत् प्रवक्ष्यामि यथा दृष्टं गिरौ मया ।\nश्रुत्वा तदपि कौरव्य यथा श्रेयस्तथा कुरु\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2145538, "chapter_id": 4133, "verse_number": "४५", "content_sanskrit": "वयं किरातैः सहिता गच्छामो गिरिमुत्तमम् ।\nब्राह्मणैर्देवकल्पैश्च विद्याविनयसाधनैः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2145539, "chapter_id": 4133, "verse_number": "४६", "content_sanskrit": "कुञ्जभूतं गिरिं सर्वमभितो गन्धमादनम् ।\nदीप्यमानौषधिगणं सिद्धगन्धर्वसेवितम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2145540, "chapter_id": 4133, "verse_number": "४७", "content_sanskrit": "तत्रापश्याम वै सर्वे मधु स्फीतञ्च माक्षिकम् ।\nमहाप्रपाते विषमे निविष्टं कुम्भसम्मितम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2145541, "chapter_id": 4133, "verse_number": "४८", "content_sanskrit": "आशीविषै रक्ष्यमाणं कुबेरदयितं भृशम् ।\nयत् प्राश्य पुरुषो मर्त्योऽप्यमरत्वं निगच्छति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2145542, "chapter_id": 4133, "verse_number": "४९", "content_sanskrit": "अचक्षुर्लभते चक्षुर्वृद्धो भवति वै युवा ।\nइति ते कथयन्ति स्म ब्राह्मणा जम्भसाधकाः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2145543, "chapter_id": 4133, "verse_number": "५०", "content_sanskrit": "ततः किरातास्तं दृष्ट्वा प्रार्थयन्तो महीपते ।\nविनेशुर्विषमे तस्मिन् ससर्पे गिरिगह्वरे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2145544, "chapter_id": 4133, "verse_number": "५१", "content_sanskrit": "तथैव तव पुत्रोऽयं पृथिवीमेक इच्छति ।\nमधु पश्यति सम्मोहात् प्रपातं नानुपश्यति\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2145545, "chapter_id": 4133, "verse_number": "५२", "content_sanskrit": "दुर्योधनो योद्धुमनाः समरे सव्यसाचिना ।\nन च पश्यामि तेजोऽस्य विक्रमं वा तथाविधम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2145546, "chapter_id": 4133, "verse_number": "५३", "content_sanskrit": "एकेन रथमास्थाय पृथिवी येन निर्जिता ।\nभीष्मद्रोणप्रभृतयः सन्त्रस्ताः साधुयायिनः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2145547, "chapter_id": 4133, "verse_number": "५४", "content_sanskrit": "विराटनगरे भग्नाः किं वा तेऽत्र निदर्शनम् ।\nप्रतीक्षमाणो यो वीरः क्षमते निकृतिं तव\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2145548, "chapter_id": 4133, "verse_number": "५५", "content_sanskrit": "द्रुपदो मत्स्यराजश्च सङ्क्रुद्धश्च धनञ्जयः ।\nन शेषयेयुः समरे वायुयुक्ता इवाग्नयः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2145549, "chapter_id": 4133, "verse_number": "५६", "content_sanskrit": "अङ्के कुरुष्व राजानं धृतराष्ट्र युधिष्ठिरम् ।\nयुध्यतोर्हि द्वयोर्युद्धे नैकान्तेन भवेज्जयः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2145550, "chapter_id": 4133, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुःषष्टितमोऽध्यायः ॥६४॥\nव्यासाभिगमनपर्वणि सप्तदशोऽध्यायः ॥१७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]