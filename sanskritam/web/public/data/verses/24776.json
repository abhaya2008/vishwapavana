[{"id": 7004776000, "chapter_id": 24776, "verse_number": "६-२३८-१", "content_sanskrit": "ब्रह्मोवाच ।\nतपः शृणुष्व विप्रेंद्र विस्तरेण महामते ।\nयस्य श्रवणमात्रेण चातुर्मास्येऽ घनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004776001, "chapter_id": 24776, "verse_number": "६-२३८-२", "content_sanskrit": "षोडशैरुपचारैश्च विष्णोः पूजा सदा तपः ।\nततः सुप्ते जगन्नाथे महत्तप उदाहृतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004776002, "chapter_id": 24776, "verse_number": "६-२३८-३", "content_sanskrit": "करणं पंचयज्ञानां सततं तप एव हि ।\nतन्निवेद्य हरौ चैव चातुर्मास्ये महत्तपः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004776003, "chapter_id": 24776, "verse_number": "६-२३८-४", "content_sanskrit": "ऋतुयानं गृहस्थस्य तप एव सदैव हि ।\nचातुर्मास्ये हरिप्रीत्यै तन्निषेव्यं महत्तपः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004776004, "chapter_id": 24776, "verse_number": "६-२३८-५", "content_sanskrit": "सत्यवादस्तपो नित्यं प्राणिनां भुवि दुर्लभम् ।\nसुप्ते देवपतौ कुर्वन्ननंतफलभाग्भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004776005, "chapter_id": 24776, "verse_number": "६-२३८-६", "content_sanskrit": "अहिंसादिगुणानां च पालनं सततं तपः ।\nचातुर्मास्ये त्यक्तवैरं महत्तप उदारधीः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004776006, "chapter_id": 24776, "verse_number": "६-२३८-७", "content_sanskrit": "तप एव महन्मर्त्यः पंचायतनपूजनम् ।\nचातुर्मास्ये विशेषेण हरिप्रीत्या समाचरेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004776007, "chapter_id": 24776, "verse_number": "६-२३८-८", "content_sanskrit": "नारद उवाच ।\nपंचायतनसंज्ञेयं कस्योक्ता सा कथं भवेत् ।\nकथं पूजा च कर्तव्या विस्तरेणाशु तद्वद ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004776008, "chapter_id": 24776, "verse_number": "६-२३८-९", "content_sanskrit": "ब्रह्मोवाच ।\nप्रातर्मध्याह्नपूजायां मध्ये पूज्यो रविः सदा ।\nरात्रौ मध्ये भवेच्चंद्रस्तद्वर्णकुसुमैः शुभैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004776009, "chapter_id": 24776, "verse_number": "६-२३८-१०", "content_sanskrit": "वह्निकोणे तु हेरंबं सर्वविघ्नोपशांतये ।\nरक्तचंदन पुष्पैश्च चातुर्मास्ये विशेषतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004776010, "chapter_id": 24776, "verse_number": "६-२३८-११", "content_sanskrit": "नैरृतं दलमास्थाय भगवान्दुष्टदर्पहा ।\nगृहस्थस्य सदा शत्रुविनाशं विदधाति सः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004776011, "chapter_id": 24776, "verse_number": "६-२३८-१२", "content_sanskrit": "नैरृत्यकोणगं विष्णुं पूजयेत्सर्वदा बुधः ।\nसुगन्धचंदनैः पुष्पैर्नैवेद्यैश्चातिशोभनैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004776012, "chapter_id": 24776, "verse_number": "६-२३८-१३", "content_sanskrit": "गोत्रजा वायुकोणे तु पूजनीया सदा बुधैः ।\nपुत्रपौत्रप्रवृद्ध्यर्थं सुमनोभिर्मनोहरैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004776013, "chapter_id": 24776, "verse_number": "६-२३८-१४", "content_sanskrit": "ऐशाने भगवान्रुद्रः श्वेतपुष्पैः सदाऽर्चितः ।\nअपमृत्युविनाशाय सर्वदोषापनुत्तये ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004776014, "chapter_id": 24776, "verse_number": "६-२३८-१५", "content_sanskrit": "जागर्ति महिमा यस्य ब्रह्माद्यैर्नैव लिख्यते ।\nपंचायतनमेतद्धि पूज्यते गृहमेधिभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004776015, "chapter_id": 24776, "verse_number": "६-२३८-१६", "content_sanskrit": "तप एतत्सदा कार्यं चातुर्मास्ये महाफलम् ।\nपर्वकालेषु सर्वेषु दानं देयं तपः सदा ।\nचातुर्मास्ये विशेषेण तदनंतं प्रजायते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004776016, "chapter_id": 24776, "verse_number": "६-२३८-१७", "content_sanskrit": "शौचं तु द्विविधं ग्राह्यं बाह्यमाभ्यंतरं सदा ।\nजलशौचं तथा बाह्यं श्रद्धया चांतरं भवेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004776017, "chapter_id": 24776, "verse_number": "६-२३८-१८", "content_sanskrit": "इद्रियाणां ग्रहः कार्यस्तपसो लक्षणं परम् ।\nनिवृत्त्येंद्रियलौल्यं च चातुर्मास्ये महत्तपः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004776018, "chapter_id": 24776, "verse_number": "६-२३८-१९", "content_sanskrit": "इन्द्रियाश्वान्सन्नियम्य सततं सुखमेधते ।\nनरके पात्यते प्राणैस्तैरेवोत्पथगामिभिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004776019, "chapter_id": 24776, "verse_number": "६-२३८-२०", "content_sanskrit": "ममतारूपिणीं ग्राहीं दुष्टां निर्भर्त्स्य निग्रहेत् ।\nतप एव सदा पुंसां चातुर्मास्येऽधिगौरवम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004776020, "chapter_id": 24776, "verse_number": "६-२३८-२१", "content_sanskrit": "काम एष महाशत्रुस्तमेकं निर्जयेद्दृढम् ।\nजितकामा महात्मानस्तैर्जितं निखिलं जगत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004776021, "chapter_id": 24776, "verse_number": "६-२३८-२२", "content_sanskrit": "एतच्च तपसो मूलं तपसो मूलमेव तत् ।\nसर्वदा कामविजयः संकल्पविजयस्तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004776022, "chapter_id": 24776, "verse_number": "६-२३८-२३", "content_sanskrit": "तदेव हि परं ज्ञानं कामो येन प्रजायते ।\nमहत्तपस्तदेवाहुश्चातुमास्ये फलोत्तमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004776023, "chapter_id": 24776, "verse_number": "६-२३८-२४", "content_sanskrit": "लोभः सदा परित्याज्यः पापं लोभे समास्थितम् ।\nतपस्तस्यैव विजयश्चातुर्मास्ये विशेषतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004776024, "chapter_id": 24776, "verse_number": "६-२३८-२५", "content_sanskrit": "मोहः सदाऽविवेकश्च वर्जनीयः प्रयत्नतः ।\nतेन त्यक्तो नरो ज्ञानी न ज्ञानी मोहसंश्रयात ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004776025, "chapter_id": 24776, "verse_number": "६-२३८-२६", "content_sanskrit": "मद एव मनुष्याणां शरीरस्थो महारिपुः ।\nसदा स एव निग्राह्यः सुप्ते देवे विशेषतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004776026, "chapter_id": 24776, "verse_number": "६-२३८-२७", "content_sanskrit": "मानः सर्वेषु भूतेषु वसत्येव भयावहः ।\nक्षमया तं विनिर्जित्य चातुर्मास्ये गुणाधिकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004776027, "chapter_id": 24776, "verse_number": "६-२३८-२८", "content_sanskrit": "मात्सर्यं निर्जयेत्प्राज्ञो महापातककारणम् ।\nचातुर्मास्ये जितं तेन त्रैलोक्यममरैः सह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004776028, "chapter_id": 24776, "verse_number": "६-२३८-२९", "content_sanskrit": "अहंकारसमाक्रांता मुनयो विजितेंद्रियाः ।\nधर्ममार्गं परित्यज्य कुर्वत्युन्मार्गजां क्रियाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004776029, "chapter_id": 24776, "verse_number": "६-२३८-३०", "content_sanskrit": "अहंकारं परित्यज्य सततं सुखमाप्नुयात् ।\nचातुर्मास्ये विशेषेण तस्य त्यागे महाफलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004776030, "chapter_id": 24776, "verse_number": "६-२३८-३१", "content_sanskrit": "एतद्धि तपसो मूलं यदेतन्मनसस्त्यजेत् ।\nत्यक्तेष्वेतेषु सर्वेषु पर ब्रह्ममयो भवेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004776031, "chapter_id": 24776, "verse_number": "६-२३८-३२", "content_sanskrit": "प्रथमं कायशुद्ध्यर्थं प्राजापत्यं समाचरेत् ।\nशयने देवदेवस्य विशेषेण महत्तपः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004776032, "chapter_id": 24776, "verse_number": "६-२३८-३३", "content_sanskrit": "हरेस्तु शयने नित्यमेकांतरमु पोषणम् ।\nयः करोति नरो भक्त्या न स गच्छेद्यमालयम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004776033, "chapter_id": 24776, "verse_number": "६-२३८-३४", "content_sanskrit": "हरिस्वापे नरो नित्यमेकभक्तं समाचरेत् ।\nदिवसेदिवसे तस्य द्वादशाहफलं लभेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004776034, "chapter_id": 24776, "verse_number": "६-२३८-३५", "content_sanskrit": "चातुर्मास्ये नरो यस्तु शाकाहारपरो यदि ।\nपुण्यं क्रतुसहस्राणां जायते नात्र संशयः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004776035, "chapter_id": 24776, "verse_number": "६-२३८-३६", "content_sanskrit": "चातुर्मास्ये नरो नित्यं चांद्राय णव्रतं चरेत् ।\nएकैकमासे तत्पुण्यं वर्णितुं नैव शक्यते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004776036, "chapter_id": 24776, "verse_number": "६-२३८-३७", "content_sanskrit": "सुप्ते देवे च पाराकं यः करोति विशुद्धधीः ।\nनारी वा श्रद्धया युक्ता शतजन्माघ नाशनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004776037, "chapter_id": 24776, "verse_number": "६-२३८-३८", "content_sanskrit": "कृच्छ्रसेवी भवेद्यस्तु सुप्ते देवे जनार्दने ।\nपापराशिं विनिर्धूय वैकुण्ठे गणतां व्रजेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004776038, "chapter_id": 24776, "verse_number": "६-२३८-३९", "content_sanskrit": "तप्तकृच्छ्रपरो यस्तु सुप्ते देवे जनार्दने ।\nकीर्तिं संप्राप्य वा पुत्रं विष्णुसायुज्यतां व्रजेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004776039, "chapter_id": 24776, "verse_number": "६-२३८-४०", "content_sanskrit": "दुग्धाहारपरो यस्तु चातुर्मास्येऽभिजायते ।\nतस्य पापसहस्राणि विलयं यांति देहिनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004776040, "chapter_id": 24776, "verse_number": "६-२३८-४१", "content_sanskrit": "मितान्नाशनकृद्धीरश्चातुर्मास्ये नरो यदि ।\nनिर्धूय सकलं पापं वैकुण्ठपदमाप्नुयात् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004776041, "chapter_id": 24776, "verse_number": "६-२३८-४२", "content_sanskrit": "एकान्नाशनकृन्मर्त्यो न रोगैरभि भूयते ।\nअक्षारलवणाशी च चातुर्मास्ये न पापभाक् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004776042, "chapter_id": 24776, "verse_number": "६-२३८-४३", "content_sanskrit": "कृताहारो महापापैर्निर्मुक्तो जायते ध्रुवम् ।\nहरिमुद्दिश्य मासेषु चतुर्षु च न संशयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004776043, "chapter_id": 24776, "verse_number": "६-२३८-४४", "content_sanskrit": "कन्दमूलाशनकरः पूर्वजान्सह चात्मना ।\nउद्धृत्य नरकाद्घोराद्याति विष्णुसलोकताम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004776044, "chapter_id": 24776, "verse_number": "६-२३८-४५", "content_sanskrit": "नित्यांबुप्राशनकरश्चातुर्मास्ये यदा भवेत् ।\nदिनेदिनेऽश्वमेधस्य फलमाप्नोत्यसंशयम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004776045, "chapter_id": 24776, "verse_number": "६-२३८-४६", "content_sanskrit": "शीतवृष्टिसहो यस्तु चातुर्मास्ये नरो भवेत् ।\nहरिप्रीत्यै जगन्नाथस्तस्यात्मानं प्रयच्छति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004776046, "chapter_id": 24776, "verse_number": "६-२३८-४७", "content_sanskrit": "महापाराकसंज्ञं तु महत्तप उदाहृतम् ।\nमासैकमुपवासेन सर्वं पूर्णं प्रजायते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004776047, "chapter_id": 24776, "verse_number": "६-२३८-४८", "content_sanskrit": "देवस्वापदिनादौ तु यावत्पवित्रद्वादशी ।\nपवित्रद्वादशीपूर्वं यावच्छ्रवणद्वादशी ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004776048, "chapter_id": 24776, "verse_number": "६-२३८-४९", "content_sanskrit": "महापाराकमेतद्धि द्वितीयं परिकीर्तितम् ।\nश्रवणद्वादशीपूर्वं प्राप्ता चाश्विनद्वादशी ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004776049, "chapter_id": 24776, "verse_number": "६-२३८-५०", "content_sanskrit": "महापाराक तृतीयं प्राज्ञैश्च समुदाहृतम् ।\nआश्विनद्वादशी चादौ प्राप्ता देवसुबोधिनी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004776050, "chapter_id": 24776, "verse_number": "६-२३८-५१", "content_sanskrit": "महापाराकमेतद्धि चतुर्थं परिकथ्यते ।\nएतेषामेकमपि च नारी वा पुरुषोऽपि वा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004776051, "chapter_id": 24776, "verse_number": "६-२३८-५२", "content_sanskrit": "यः करोति नरो भक्त्या स च विष्णुः सनातनः ।\nइदं च सर्वतपसां महत्तप उदाहृतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004776052, "chapter_id": 24776, "verse_number": "६-२३८-५३", "content_sanskrit": "दुष्करं दुर्लभं लोके चातुर्मास्ये मखाधिकम् ।\nदिवसेदिवसे तस्य यज्ञायुतफलं स्मृतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004776053, "chapter_id": 24776, "verse_number": "६-२३८-५४", "content_sanskrit": "महत्तप इदं येन कृतं जगति दुर्लभम् ।\nइदमेव महापुण्यमिदमेव महत्सुखम् ।\nइदमेव परं श्रेयो महापाराकसेवनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004776054, "chapter_id": 24776, "verse_number": "६-२३८-५५", "content_sanskrit": "नारायणो वसेद्देहे ज्ञानं तस्य प्रजायते ।\nजीवन्मुक्तः स भवति महापातककारकः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004776055, "chapter_id": 24776, "verse_number": "६-२३८-५६", "content_sanskrit": "तावद्गर्जंति पापानि नरकास्तावदेव हि ।\nतावन्मायासहस्राणि यावन्मासो पवासकः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004776056, "chapter_id": 24776, "verse_number": "६-२३८-५७", "content_sanskrit": "चातुर्मास्युपवासी यो यस्य प्रांगणिको भवेत् ।\nसोऽपि हत्यासहस्राणि त्यक्त्वा निष्कल्मषो भवेत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004776057, "chapter_id": 24776, "verse_number": "६-२३८-५८", "content_sanskrit": "य इदं श्रावयेन्मर्त्यो यः पठेत्सततं स्वयम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004776058, "chapter_id": 24776, "verse_number": "६-२३८-५९", "content_sanskrit": "सोऽपि वाचस्पतिसमः फलं प्राप्नोत्यसंशयम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004776059, "chapter_id": 24776, "verse_number": "६-२३८-६०", "content_sanskrit": "इदं पुराणं परमं पवित्रं शृण्वन्गृणन्पापविशुद्धिहेतु ।\nनारायणं तं मनसा विचिन्त्य मृतोऽभिगच्छत्यमृतं सुराधिकम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004776060, "chapter_id": 24776, "verse_number": "६-२३८-६१", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां षष्ठे नागरखण्डे हाटकेश्वरक्षेत्रमाहात्म्ये शेषशाय्युपाख्याने ब्रह्मनारदसंवादे चातुर्मास्यमाहात्म्ये तपोमहिमावर्णनं नामाष्टत्रिंशदुत्तरद्विशततमोऽध्यायः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]