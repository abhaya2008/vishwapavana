[{"id": 40022551, "chapter_id": 9398, "verse_number": "1", "content_sanskrit": "तदद्भुततमं वाक्यं श्रुत्वागस्त्यस्य राघवः । गौरवाद्विस्मयाच्चैव पुनः प्रष्टुं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022552, "chapter_id": 9398, "verse_number": "2", "content_sanskrit": "भगवंस्तद्वनं घोरं तपस्तप्यति यत्र सः । श्वेतो वैदर्भको राजा कथं स्यादमृगद्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022553, "chapter_id": 9398, "verse_number": "3", "content_sanskrit": "तद्वनं स कथ राजा शून्यं मनुजवर्जितम् । तपश्चर्तुं प्रविष्टः स श्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022554, "chapter_id": 9398, "verse_number": "4", "content_sanskrit": "रामस्य वचनं श्रुत्वा कौतूहलसमन्वितम् । वाक्यं परमतेजस्वी वक्तुमेवोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022555, "chapter_id": 9398, "verse_number": "5", "content_sanskrit": "पुरा कृतयुगे राम मनुर्दण्डधरः प्रभुः । तस्य पुत्रो महानासीदिक्ष्वाकुः कुलनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022556, "chapter_id": 9398, "verse_number": "6", "content_sanskrit": "तं पुत्रं पूर्वंकं राज्ये निक्षिप्य भुवि दुर्जयम् । पृथिव्यां राजवंशानां भव कर्तेत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022557, "chapter_id": 9398, "verse_number": "7", "content_sanskrit": "तथैवेति प्रतिज्ञातं पितुः पुत्रेण राघव । ततः परमसन्तुष्टो मनुः पुत्रमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022558, "chapter_id": 9398, "verse_number": "8", "content_sanskrit": "प्रीतो ऽस्मि परमोदार त्वं कर्ता ऽसि न संशयः । दण्डेन च प्रजा रक्ष मा च दण्डमकारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022559, "chapter_id": 9398, "verse_number": "9", "content_sanskrit": "अपराधिषु यो दण्डः पात्यते मानवेषु वै । स दण्डो विधिवन्मुक्तः स्वर्गं नयति पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022560, "chapter_id": 9398, "verse_number": "10", "content_sanskrit": "तस्माद्दण्डे महाबाहो यत्नवान्भव पुत्रक । धर्मो हि परमो लोके कुर्वतस्ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022561, "chapter_id": 9398, "verse_number": "11", "content_sanskrit": "इति तं बहु सन्दिश्य मनुः पुत्रं समाधिना । जगाम त्रिदिवं हृष्टो ब्रह्मलोकं सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022562, "chapter_id": 9398, "verse_number": "12", "content_sanskrit": "प्रयाते त्रिदिवं तस्मिन्निक्ष्वाकुरमितप्रभः । जनयिष्ये कथं पुत्रानिति चिन्तापरो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022563, "chapter_id": 9398, "verse_number": "13", "content_sanskrit": "कर्मभिर्बहुरूपैश्च तैस्तैर्मनुसुतस्सुतान् । जनयामास धर्मात्मा शतं देवसुतोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022564, "chapter_id": 9398, "verse_number": "14", "content_sanskrit": "तेषामवरजस्तात सर्वेषां रघुनन्दन । मूढश्चाकृतविद्यश्च न शुश्रूषति पूर्वजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022565, "chapter_id": 9398, "verse_number": "15", "content_sanskrit": "नाम तस्य च दण्डेति पिता चक्रे ऽल्पमेधसः । अवश्यं दण्डपतनं शरीरे ऽस्य भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022566, "chapter_id": 9398, "verse_number": "16", "content_sanskrit": "अपश्यमानस्तं देशं घोरं पुत्रस्य राघव । विन्ध्यशैवलयोर्मध्ये राज्यं प्रादादरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022567, "chapter_id": 9398, "verse_number": "17", "content_sanskrit": "स दण्डस्तत्र राजाभूद्रम्ये पर्वतरोधसि । पुरं चाप्रतिमं राम न्यवेशयदनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022568, "chapter_id": 9398, "verse_number": "18", "content_sanskrit": "पुरस्य चाकरोन्नाम मधुमन्तमिति प्रभो । पुरोहितं तूशनसं वरयामास सुव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022569, "chapter_id": 9398, "verse_number": "19", "content_sanskrit": "एवं स राजा तद्राज्यमकरोत्सपुरोहितः । प्रहृष्टमनुजाकीर्णं देवराजं यथा वृषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022570, "chapter_id": 9398, "verse_number": "20", "content_sanskrit": "ततः स राजा मनुजेन्द्रपुत्रः सार्धं च तेनोशनसा तदानीम् । चकार राज्यं सुमहान्महात्मा शक्रो दिवीवोशनसा समेतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]