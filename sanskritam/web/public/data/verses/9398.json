[{"id": 5000398000, "chapter_id": 9398, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे एकोनषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000398001, "chapter_id": 9398, "verse_number": "५-५९-१", "content_sanskrit": "एतदाख्याय तत् सर्वं हनूमान् मारुतात्मजः।\nभूयः समुपचक्राम वचनं वक्तुमुत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000398002, "chapter_id": 9398, "verse_number": "५-५९-२", "content_sanskrit": "सफलो राघवोद्योगः सुग्रीवस्य च सम्भ्रमः।\nशीलमासाद्य सीताया मम च प्रीणितं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000398003, "chapter_id": 9398, "verse_number": "५-५९-३", "content_sanskrit": "आर्यायाः सदृशं शीलं सीतायाः प्लवगर्षभाः।\nतपसा धारयेल्लोकान् क्रुद्धा वा निर्दहेदपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000398004, "chapter_id": 9398, "verse_number": "५-५९-४", "content_sanskrit": "सर्वथातिप्रकृष्टोऽसौ रावणो राक्षसेश्वरः।\nयस्य तां स्पृशतो गात्रं तपसा न विनाशितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000398005, "chapter_id": 9398, "verse_number": "५-५९-५", "content_sanskrit": "न तदग्निशिखा कुर्यात् संस्पृष्टा पाणिना सती।\nजनकस्य सुता कुर्याद् यत् क्रोधकलुषीकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000398006, "chapter_id": 9398, "verse_number": "५-५९-६", "content_sanskrit": "जाम्बवत्प्रमुखान् सर्वाननुज्ञाप्य महाकपीन्।\nअस्मिन् नेवंगते कार्ये भवतां च निवेदिते।\nन्याय्यं स्म सह वैदेह्या द्रष्टुं तौ पार्थिवात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000398007, "chapter_id": 9398, "verse_number": "५-५९-७", "content_sanskrit": "अहमेकोऽपि पर्याप्तः सराक्षसगणां पुरीम्।\nतां लङ्कां तरसा हन्तुं रावणं च महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000398008, "chapter_id": 9398, "verse_number": "५-५९-८", "content_sanskrit": "किं पुनः सहितो वीरैर्बलवद्भिः कृतात्मभिः।\nकृतास्त्रैः प्लवगैः शक्तैर्भवद्भिर्विजयैषिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000398009, "chapter_id": 9398, "verse_number": "५-५९-९", "content_sanskrit": "अहं तु रावणं युद्धे ससैन्यं सपुरःसरम्।\nसहपुत्रं वधिष्यामि सहोदरयुतं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000398010, "chapter_id": 9398, "verse_number": "५-५९-१०", "content_sanskrit": "ब्राह्ममस्त्रं च रौद्रं च वायव्यं वारुणं तथा।\nयदि शक्रजितोऽस्त्राणि दुर्निरीक्ष्याणि संयुगे।\nतान्यहं निहनिष्यामि विधमिष्यामि राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000398011, "chapter_id": 9398, "verse_number": "५-५९-११", "content_sanskrit": "भवतामभ्यनुज्ञातो विक्रमो मे रुणद्धि तम्।\nमयातुला विसृष्टा हि शैलवृष्टिर्निरन्तरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000398012, "chapter_id": 9398, "verse_number": "५-५९-१२", "content_sanskrit": "देवानपि रणे हन्यात् किं पुनस्तान् निशाचरान्।\nभवतामननुज्ञातो विक्रमो मे रुणद्धि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000398013, "chapter_id": 9398, "verse_number": "५-५९-१३", "content_sanskrit": "सागरोऽप्यतियाद् वेलां मन्दरः प्रचलेदपि।\nन जाम्बवन्तं समरे कम्पयेदरिवाहिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000398014, "chapter_id": 9398, "verse_number": "५-५९-१४", "content_sanskrit": "सर्वराक्षससङ्घानां राक्षसा ये च पूर्वजाः।\nअलमेकोऽपि नाशाय वीरो वालिसुतः कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000398015, "chapter_id": 9398, "verse_number": "५-५९-१५", "content_sanskrit": "प्लवगस्योरुवेगेन नीलस्य च महात्मनः।\nमन्दरोऽप्यवशीर्येत किं पुनर्युधि राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000398016, "chapter_id": 9398, "verse_number": "५-५९-१६", "content_sanskrit": "सदेवासुरयक्षेषु गन्धर्वोरगपक्षिषु।\nमैन्दस्य प्रतियोद्धारं शंसत द्विविदस्य वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000398017, "chapter_id": 9398, "verse_number": "५-५९-१७", "content_sanskrit": "अश्विपुत्रौ महावेगावेतौ प्लवगसत्तमौ।\nएतयोः प्रतियोद्धारं न पश्यामि रणाजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000398018, "chapter_id": 9398, "verse_number": "५-५९-१८", "content_sanskrit": "मयैव निहता लङ्का दग्धा भस्मीकृता पुरी।\nराजमार्गेषु सर्वेषु नाम विश्रावितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000398019, "chapter_id": 9398, "verse_number": "५-५९-१९", "content_sanskrit": "जयत्यतिबलो रामो लक्ष्मणश्च महाबलः।\nराजा जयति सुग्रीवो राघवेणाभिपालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000398020, "chapter_id": 9398, "verse_number": "५-५९-२०", "content_sanskrit": "अहं कोसलराजस्य दासः पवनसम्भवः।\nहनूमानिति सर्वत्र नाम विश्रावितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000398021, "chapter_id": 9398, "verse_number": "५-५९-२१", "content_sanskrit": "अशोकवनिकामध्ये रावणस्य दुरात्मनः।\nअधस्ताच्छिंशपामूले साध्वी करुणमास्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000398022, "chapter_id": 9398, "verse_number": "५-५९-२२", "content_sanskrit": "राक्षसीभिः परिवृता शोकसंतापकर्शिता।\nमेघरेखापरिवृता चन्द्ररेखेव निष्प्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000398023, "chapter_id": 9398, "verse_number": "५-५९-२३", "content_sanskrit": "अचिन्तयन्ती वैदेही रावणं बलदर्पितम्।\nपतिव्रता च सुश्रोणी अवष्टब्धा च जानकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000398024, "chapter_id": 9398, "verse_number": "५-५९-२४", "content_sanskrit": "अनुरक्ता हि वैदेही रामे सर्वात्मना शुभा।\nअनन्यचित्ता रामेण पौलोमीव पुरन्दरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000398025, "chapter_id": 9398, "verse_number": "५-५९-२५", "content_sanskrit": "तदेकवासःसंवीता रजोध्वस्ता तथैव च।\nसा मया राक्षसीमध्ये तर्ज्यमाना मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000398026, "chapter_id": 9398, "verse_number": "५-५९-२६", "content_sanskrit": "राक्षसीभिर्विरूपाभिर्दृष्टा हि प्रमदावने।\nएकवेणीधरा दीना भर्तृचिन्तापरायणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000398027, "chapter_id": 9398, "verse_number": "५-५९-२७", "content_sanskrit": "अधःशय्या विवर्णाङ्गी पद्मिनीव हिमोदये।\nरावणाद् विनिवृत्तार्था मर्तव्यकृतनिश्चया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000398028, "chapter_id": 9398, "verse_number": "५-५९-२८", "content_sanskrit": "कथंचिन्मृगशावाक्षी विश्वासमुपपादिता।\nततः सम्भाषिता चैव सर्वमर्थं प्रकाशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000398029, "chapter_id": 9398, "verse_number": "५-५९-२९", "content_sanskrit": "रामसुग्रीवसख्यं च श्रुत्वा प्रीतिमुपागता।\nनियतः समुदाचारो भक्तिर्भर्तरि चोत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000398030, "chapter_id": 9398, "verse_number": "५-५९-३०", "content_sanskrit": "यन्न हन्ति दशग्रीवं स महात्मा दशाननः।\nनिमित्तमात्रं रामस्तु वधे तस्य भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000398031, "chapter_id": 9398, "verse_number": "५-५९-३१", "content_sanskrit": "सा प्रकृत्यैव तन्वङ्गी तद्वियोगाच्च कर्शिता।\nप्रतिपत्पाठशीलस्य विद्येव तनुतां गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000398032, "chapter_id": 9398, "verse_number": "५-५९-३२", "content_sanskrit": "एवमास्ते महाभागा सीता शोकपरायणा।\nयदत्र प्रतिकर्तव्यं तत् सर्वमुपकल्प्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000398033, "chapter_id": 9398, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे एकोनषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]