[{"id": 2120525, "chapter_id": 3585, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120526, "chapter_id": 3585, "verse_number": "१", "content_sanskrit": "एतस्मिन्नेव काले तु भीमसेनोऽपि वीर्यवान् ।\nधर्मराजमनुज्ञाप्य ययौ प्राचीं दिशं प्रति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120527, "chapter_id": 3585, "verse_number": "२", "content_sanskrit": "महता बलचक्रेण परराष्ट्रविमर्दिना ।\nवृतो भरतशार्दूल द्विषच्छोकविवर्धनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120528, "chapter_id": 3585, "verse_number": "३", "content_sanskrit": "स गत्वा नरशार्दूल पाञ्चालानां पुरं महत् ।\nपाञ्चालान् विविधोपायैः सान्त्वयामास पाण्डवः ।\nकिञ्चित् करं समादाय विदेहानां पुरं ययौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120529, "chapter_id": 3585, "verse_number": "४", "content_sanskrit": "ततः स कण्टकीं वीरो विदेहांश्च नरर्षभः ।\nविजित्याल्पेन कालेन दशार्णानजयत् प्रभुः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120530, "chapter_id": 3585, "verse_number": "५", "content_sanskrit": "तत्र दाशार्णको राजा सुधर्मा रोमहर्षणः ।\nअद्भुतं कर्म भीमेन युधि चक्रे निरायुधम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120531, "chapter_id": 3585, "verse_number": "६", "content_sanskrit": "भीमसेनस्तु तद् दृष्ट्वा तस्य कर्म परन्तपः ।\nअधिसेनापतिं चक्रे सुधर्माणं महाबलम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120532, "chapter_id": 3585, "verse_number": "७", "content_sanskrit": "ततः प्राचीं दिशं भीमो ययौ भीमपराक्रमः ।\nबलेन महता राजन् कम्पयन्निव मेदिनीम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120533, "chapter_id": 3585, "verse_number": "८", "content_sanskrit": "सोऽश्वमेधेश्वरं राजन् रोचमानं सहानुगम् ।\nजिगाय स तदा वीरो बलेन बलिनां वरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120534, "chapter_id": 3585, "verse_number": "९", "content_sanskrit": "स तं निर्जित्य कौन्तेयो नातितीव्रेण कर्मणा ।\nपूर्वदेशं महावीर्यो विजिग्ये कुरुनन्दनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120535, "chapter_id": 3585, "verse_number": "१०", "content_sanskrit": "ततो दक्षिणमासाद्य पुळिन्दनगरं प्रति ।\nसुकुमारं करे चक्रे सुमित्रं च नराधिपम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120536, "chapter_id": 3585, "verse_number": "११", "content_sanskrit": "ततः स धर्मराजस्य शासनात् कुरुनन्दनः ।\nशिशुपालं महावीर्यमभ्ययाज्जनमेजय\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120537, "chapter_id": 3585, "verse_number": "१२", "content_sanskrit": "चेदिराजोऽपि तच्छ्रुत्वा पाण्डवस्य चिकीर्षितम् ।\nउपनिष्क्रम्य नगरात् प्रत्यगृह्णात् परन्तपः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120538, "chapter_id": 3585, "verse_number": "१३", "content_sanskrit": "तौ समेत्य महाराज कुरुचेदिवृषावुभौ ।\nउभयोरात्मकुलयोः कौशलं पर्यपृच्छताम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120539, "chapter_id": 3585, "verse_number": "१४", "content_sanskrit": "ततो निवेद्य तद्राज्यं चेदिराजो विशाम्पते ।\nउवाच भीमं प्रहसन् किमिदं कुरुषेऽनघ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120540, "chapter_id": 3585, "verse_number": "१५", "content_sanskrit": "तस्य भीमस्तदाचख्यौ धर्मराजचिकीर्षितम् ।\nस च तत् प्रतिगृह्यैव तथा चक्रे नराधिपः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120541, "chapter_id": 3585, "verse_number": "१६", "content_sanskrit": "तत्र भीमस्तदा राजन्नुषित्वा त्रिदशक्षपाः ।\nसत्कृतः शिशुपालेन ययौ सबलवाहनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120542, "chapter_id": 3585, "verse_number": "१७", "content_sanskrit": "ततः कुणिन्दविषये श्रेणिमन्तमथाजयत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120543, "chapter_id": 3585, "verse_number": "१८", "content_sanskrit": "कोसलाधिपतिं चैव बृहद्बलमरिन्दमम् ।\nअयोध्यायां महीपालं दीर्घप्रज्ञं महाबलम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120544, "chapter_id": 3585, "verse_number": "१९", "content_sanskrit": "अजयत् पाण्डवश्रेष्ठः सततं भूरिदक्षिणम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120545, "chapter_id": 3585, "verse_number": "२०", "content_sanskrit": "गोपालं चैव कौन्तेयो ह्यन्तपालं तथोत्तमम् ।\nमल्लानामधिपं चैव पार्थिवं चाजयत् प्रभुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120546, "chapter_id": 3585, "verse_number": "२१", "content_sanskrit": "ततो हिमवतः पार्श्वे देशान् बहुविधान् बहून् ।\nसर्वानल्पेन यत्नेन वशे चक्रे बलाद् बली\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120547, "chapter_id": 3585, "verse_number": "२२", "content_sanskrit": "एवं बहुविधान् देशान् विजित्य पुरुषर्षभः ।\nकुन्तळानभितो जिग्ये कुक्षिमन्तं च पर्वतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120548, "chapter_id": 3585, "verse_number": "२३", "content_sanskrit": "पाण्डवः सुमहावीर्यो बलेन बलिनां वरः ।\nकाशिराजं समेयाय सुबन्धुमनिवर्तिनम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120549, "chapter_id": 3585, "verse_number": "२४", "content_sanskrit": "वशे चक्रे महाबाहुर्भीमो भीमपराक्रमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120550, "chapter_id": 3585, "verse_number": "२५", "content_sanskrit": "ततः सुपार्श्वमभितस्तथा राजपतिं क्रथम् ।\nयुध्यमानं बलात् सङ्खे विजिग्ये पाण्डवर्षभः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120551, "chapter_id": 3585, "verse_number": "२६", "content_sanskrit": "ततः काशिपतीन् मत्स्यान् मालवानिह पाण्डवः ।\nअनवद्यां गयां चैव पशुभूमिं च सर्वशः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2120552, "chapter_id": 3585, "verse_number": "२७", "content_sanskrit": "निर्जित्य च महाबाहुरटवीशं च पर्वतम् ।\nगोपतेयांश्च निर्जित्य प्रययावुत्तरामुखः ।\nवत्सभूमिं च कौन्तेयो विजिग्ये बलवान् बलान्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2120553, "chapter_id": 3585, "verse_number": "२८", "content_sanskrit": "गर्गाणामधिपं चैव निषादाधिपतिं तथा ।\nविजिग्ये भूमिपालांश्च मणिमत्प्रमुखान् बहून्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2120554, "chapter_id": 3585, "verse_number": "२९", "content_sanskrit": "ततो दक्षिणमद्रांश्च भोजवन्तं च पाण्डवः ।\nतरसैवाजयद् भीमो नातितीव्रेण कर्मणा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120555, "chapter_id": 3585, "verse_number": "३०", "content_sanskrit": "शर्मकान् धर्मकांश्चैव सान्त्वेनैवाजयत् प्रभुः ।\nवैदेहं चापि राजानं जनकं जगतीपतिम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120556, "chapter_id": 3585, "verse_number": "३१", "content_sanskrit": "विजिग्ये पुरुषव्याघ्रो नातितीव्रेण कर्मणा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120557, "chapter_id": 3585, "verse_number": "३२", "content_sanskrit": "वैदेहस्थस्तु कौन्तेय इन्द्रपर्वतमन्तिकात् ।\nकिराताधिपतीन् सप्त व्यजयत् तत्र पाण्डवः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120558, "chapter_id": 3585, "verse_number": "३३", "content_sanskrit": "ततः सुह्मान् प्रसुह्मांश्च समक्षांश्चापि वीर्यवान् ।\nविजित्य युधि कौन्तेयो मागधानुपयाद् बली\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120559, "chapter_id": 3585, "verse_number": "३४", "content_sanskrit": "दण्डं च दण्डधारं च विजित्य पृथिवीपतिः ।\nतैरेव सहितः सर्वैर्गिरिव्रजमुपाद्रवत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120560, "chapter_id": 3585, "verse_number": "३५", "content_sanskrit": "जारासन्धिं सान्त्वयित्वा करे च विनिवेश्य ह ।\nतैरेव सहितः पार्थः कर्णमभ्यद्रवद् बली\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120561, "chapter_id": 3585, "verse_number": "३६", "content_sanskrit": "स कम्पयन्निव महीं बलेन चतुरङ्गिणा ।\nयुयुधे पाण्डवश्रेष्ठः कर्णेनामित्रकर्शिना\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2120562, "chapter_id": 3585, "verse_number": "३७", "content_sanskrit": "स कर्णं युधि निर्जित्य वशे कृत्वा च भारत ।\nततो विजिग्ये बलवान् राज्ञः पर्वतवासिनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2120563, "chapter_id": 3585, "verse_number": "३८", "content_sanskrit": "अथ मोदं गिरिपतिं राजानं च महौजसम् ।\nपाण्डवो बाहुवीर्येण निजघान महामृधे ।\nततः पुण्ड्राधिपं वीरं वासुदेवाख्यमाययौ\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2120564, "chapter_id": 3585, "verse_number": "३९", "content_sanskrit": "इदानीं वृष्णिवीरेण न योत्स्यामीति पौण्ड्रकः ।\nकृष्णस्य भुजसन्त्रासात् करमाशु ददौ नृपः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2120565, "chapter_id": 3585, "verse_number": "४०", "content_sanskrit": "कौशिकं कच्छनिलयं राजानं च महौजसम् ।\nउभौ बलवृतौ वीरावुभौ भीमपराक्रमौ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2120566, "chapter_id": 3585, "verse_number": "४१", "content_sanskrit": "निर्जित्याजौ महावीर्यो वङ्गराजमुपाद्रवत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2120567, "chapter_id": 3585, "verse_number": "४२", "content_sanskrit": "समुद्रसेनं निर्जित्य चन्द्रसेनं च पार्थिवम् ।\nताम्रलिप्तं च राजानं काचं वङ्गाधिपं तथा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2120568, "chapter_id": 3585, "verse_number": "४३", "content_sanskrit": "अङ्गानामधिपं चैव ये च सागरवासिनः ।\nसर्वान् म्लेच्छगणांश्चैव विजिग्ये भरतर्षभः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2120569, "chapter_id": 3585, "verse_number": "४४", "content_sanskrit": "एवं बहुविधान् देशान् विजित्य पवनात्मजः ।\nवसूंस्तेभ्य उपादाय लौहित्यमगमद् वशी\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2120570, "chapter_id": 3585, "verse_number": "४६", "content_sanskrit": "स सर्वान् म्लेच्छनृपतीन् सागरानूपवासिनः ।\nकरमाहारयामास रत्नानि विविधानि च\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2120571, "chapter_id": 3585, "verse_number": "४६", "content_sanskrit": "चन्दनागुरुवस्त्राणि मणिमुक्तमनुत्तमम् ।\nकाञ्चनं रजतं वस्त्रं विद्रुमं च महाधनम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2120572, "chapter_id": 3585, "verse_number": "४७", "content_sanskrit": "स कोटिशतसङ्ख्येन धनेन महता वृतः ।\nअभ्यवर्षदमेयात्मा धनवर्षेण पाण्डवः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2120573, "chapter_id": 3585, "verse_number": "४८", "content_sanskrit": "इन्द्रप्रस्थमथागम्य भीमो भीमपराक्रमः ।\nनिवेदयामास तदा धर्मराजाय तद्धनम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2120574, "chapter_id": 3585, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि सप्तविंशोऽध्यायः ॥२७॥ दिग्विजयपर्वणि तृतीयोऽध्यायः ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2120575, "chapter_id": 3585, "verse_number": "", "content_sanskrit": "— ०  —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]