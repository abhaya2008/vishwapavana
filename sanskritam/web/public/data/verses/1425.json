[{"id": 2020394, "chapter_id": 1425, "verse_number": "३-६३-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020395, "chapter_id": 1425, "verse_number": "३-६३-१", "content_sanskrit": "उत्सृज्य दमयन्तीं तु नलो राजा विशांपते।\nददर्श दावं दह्यन्तं महान्तं गहने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020396, "chapter_id": 1425, "verse_number": "३-६३-२", "content_sanskrit": "तत्र सुश्राव शब्दंवै मध्ये भूतस्य कस्यचित्।\nअभिधाव नलेत्युच्चैः पुण्यश्लोकेति चासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020397, "chapter_id": 1425, "verse_number": "३-६३-३", "content_sanskrit": "मा भैरिति नलश्चोक्त्वा मध्यमग्नेः प्रविश्य तम्।\nदद्रश नागराजानं शयानं कुण्डलीकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020398, "chapter_id": 1425, "verse_number": "३-६३-४", "content_sanskrit": "स नागः प्रञ्जलिर्भूत्वा वेपमानो नलं तदा।\nउवाच मां विद्धिराजन्नागं कर्कोटकं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020399, "chapter_id": 1425, "verse_number": "३-६३-५", "content_sanskrit": "मया प्रलब्धो ब्रह्मर्षिरनागाः सुमहातपाः।\nतेन मन्युपरीतेन शप्तोस्मि मनुजाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020400, "chapter_id": 1425, "verse_number": "३-६३-६", "content_sanskrit": "तिष्ठ त्वं स्थावर इव यावदेति नलः क्वचित्।\nइतो नेतासि तत्स त्वं शापान्मोक्ष्यसि मत्कृतात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020401, "chapter_id": 1425, "verse_number": "३-६३-७", "content_sanskrit": "तस्य शापान्न शक्नोमि पदाद्विचलितुं पदम्।\nउपदेक्ष्यामि ते श्रेयस्त्रातुमर्हति मां भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020402, "chapter_id": 1425, "verse_number": "३-६३-८", "content_sanskrit": "सखा च ते भविष्यामि मत्समो नास्ति पन्नगः।\nलघुश्च ते भविष्यामि शीघ्रमादाय गच्छ माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020403, "chapter_id": 1425, "verse_number": "३-६३-९", "content_sanskrit": "एवमुक्त्वा स नागेन्द्रो बभूवाङ्गुष्ठमात्रकः।\nदं गृहीत्वा नलः प्रायाद्देशं दावविवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020404, "chapter_id": 1425, "verse_number": "३-६३-१०", "content_sanskrit": "आकाशदेशमासाद्य विमुक्तं कृष्णवर्त्मना।\nउत्स्रष्टुकामं तं नागः पुनः कर्कोटकोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020405, "chapter_id": 1425, "verse_number": "३-६३-११", "content_sanskrit": "पदानि गणयन्गच्छ स्वानि नैषध कानिचित्।\nतत्रतेऽहं महाबाहो श्रेयो धास्यामि यत्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020406, "chapter_id": 1425, "verse_number": "३-६३-१२", "content_sanskrit": "ततः संख्यातुमारब्धमदशद्दशमे पदे।\nतस्य दष्टस्य तद्रूपं क्षिप्रमन्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020407, "chapter_id": 1425, "verse_number": "३-६३-१३", "content_sanskrit": "स दृष्ट्वा विस्मितस्तस्थावात्मानं विकृतं नलः।\nस्वरूपधारिणं नागं ददर्श स महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020408, "chapter_id": 1425, "verse_number": "३-६३-१४", "content_sanskrit": "ततः कर्कोटको नागः सान्त्वयन्नलमब्रवीत्।\nमया तेऽन्तर्हितं रूपं न त्वां विद्युर्जना इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020409, "chapter_id": 1425, "verse_number": "३-६३-१५", "content_sanskrit": "यत्कृते चासि निकृतो दुःखेन महता नल।\nविषेण स मदीयेन त्वयि दुःखं निवत्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020410, "chapter_id": 1425, "verse_number": "३-६३-१६", "content_sanskrit": "विषेण संवृतैर्गात्रैर्यावत्त्वां न विमोक्ष्यति।\nतावत्तु त्वां महाराज क्लेशेऽस्मिन्स नियोक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020411, "chapter_id": 1425, "verse_number": "३-६३-१७", "content_sanskrit": "अनागा येन निकृतस्त्वमनर्हो जनाधिप।\nक्रोधादसूययित्वा तं रक्षा मे भवतः कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020412, "chapter_id": 1425, "verse_number": "३-६३-१८", "content_sanskrit": "न ते भयं नरव्याघ्र दंष्ट्रिभ्यः शत्रुतोपि वा।\nब्रह्मवित्त्वं च भविता मत्प्रसादान्नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020413, "chapter_id": 1425, "verse_number": "३-६३-१९", "content_sanskrit": "राजन्विषनिमित्ता च न ते पीडा भविष्यति।\nसंग्रामेषु न राजेन्द्रशश्वज्जयमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020414, "chapter_id": 1425, "verse_number": "३-६३-२०", "content_sanskrit": "गच्छ राजन्नितः सूतो बाहुकोऽहमिति ब्रुवन्।\nसमीपमृतुपर्णस्य स हि वेदाक्षनैपुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020415, "chapter_id": 1425, "verse_number": "३-६३-२१", "content_sanskrit": "अयोध्यां नगरीं रम्यामद्य वै निषधेश्वर।\nस तेऽक्षहृदयं दाता राजाऽश्वहृदयेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020416, "chapter_id": 1425, "verse_number": "३-६३-२२", "content_sanskrit": "इक्ष्वाकुकुलजः श्रीमान्मित्रं चैव भविष्यति।\nभविष्यसि यदाऽक्षज्ञः श्रेयसा योक्ष्यसे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020417, "chapter_id": 1425, "verse_number": "३-६३-२३", "content_sanskrit": "संयोक्ष्यसे स्वदारैस्त्वं मा स्म शोके मनः कृथाः।\nराज्येन तनयाभ्यां च सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020418, "chapter_id": 1425, "verse_number": "३-६३-२४", "content_sanskrit": "स्वं रूपं च यदा द्रष्टुमिच्छेथास्त्वं नराधिप।\nसंस्मर्तव्यस्तदा तेऽहंवासश्चदं विवासयेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020419, "chapter_id": 1425, "verse_number": "३-६३-२५", "content_sanskrit": "अनेन वाससाच्छन्नः स्वं रूपं प्रतिपत्स्यसे।\nइत्युक्त्वा प्रददौ तस्मै दिव्यं वासोयुगं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020420, "chapter_id": 1425, "verse_number": "३-६३-२६", "content_sanskrit": "एवं नलं च संदिश्य वासो दत्ताव च कौरव।\nनागराजस्ततो राजंस्तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020421, "chapter_id": 1425, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि त्रिषष्टितमोऽध्यायः ॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]