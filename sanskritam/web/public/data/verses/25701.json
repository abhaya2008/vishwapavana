[{"id": 7005701000, "chapter_id": 25701, "verse_number": "१७४-१", "content_sanskrit": "सुरसैन्यविस्तारवर्णनम् ।\nमत्स्य उवाच ।\nश्रुतस्ते दैत्यसैन्यस्य विस्तरो रविनन्दन! ।\nसुराणामपि सैन्यस्य विस्तरं वैष्णवं श्रृणु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005701001, "chapter_id": 25701, "verse_number": "१७४-२", "content_sanskrit": "आदित्या वसवो रुद्रा अश्विनौ च महाबलौ ।\nसबलाः सानुगाश्चैव सन्नह्यन्त यथाक्रमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005701002, "chapter_id": 25701, "verse_number": "१७४-३", "content_sanskrit": "पुरुहूतस्तु पुरतो लोकपालाः सहस्रदृक् ।\nग्रामणीः सर्वदेवानामारुरोह सुरद्विपम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005701003, "chapter_id": 25701, "verse_number": "१७४-४", "content_sanskrit": "मध्ये चास्य रथः सर्व पक्षि प्रवररंहसः ।\nसुचारु चक्र चरणो हेमवज्र परिष्कृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005701004, "chapter_id": 25701, "verse_number": "१७४-५", "content_sanskrit": "देव गन्धर्व यक्षौघै रनुयातः सहस्रशः ।\nदीप्तिमद्भिः सदस्यैश्च ब्रह्मर्षिभिरभिष्टुतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005701005, "chapter_id": 25701, "verse_number": "१७४-६", "content_sanskrit": "वज्रविस्फूर्जितोद्भूतैः विद्युदिन्द्रायुधो दितैः ।\nयुक्तो बलाहकगणैः पर्वतैरिव कामगैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005701006, "chapter_id": 25701, "verse_number": "१७४-७", "content_sanskrit": "यमारूढः स भगवान् पर्येति सकलं जगत् ।\nहविर्धानेषु गायन्ति विप्रा मखमुखे स्थिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005701007, "chapter_id": 25701, "verse_number": "१७४-८", "content_sanskrit": "स्वर्गे शक्रानुयातेषु देवतूर्य निनादिषु ।\nसुन्दर्यः परिनृत्यन्ति शतशोऽप्सरसाङ्गणे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005701008, "chapter_id": 25701, "verse_number": "१७४-९", "content_sanskrit": "केतुना नागराजेन राजमानो यथा रविः ।\nयुक्तो हयसहस्रेण मतो मारुतरंहसा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005701009, "chapter_id": 25701, "verse_number": "१७४-१०", "content_sanskrit": "सस्यन्दन वरो भाति गुप्तो मातलिना तदा ।\nकृत्स्नः परिवृतो मेरुर्भास्करस्येव तेजसा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005701010, "chapter_id": 25701, "verse_number": "१७४-११", "content_sanskrit": "यमस्तु दण्डमुद्यम्य कालयुक्तश्च मुद्गरम् ।\nतस्थौ सुरगणानीके दैत्यान्नादेन भीषयन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005701011, "chapter_id": 25701, "verse_number": "१७४-१२", "content_sanskrit": "चतुर्भिः सागरैर्युक्तो लेलिहानैश्च पन्नगैः ।\nशङ्कमुक्ताङ्गदधरो बिभ्रत्तोयमयं वपुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005701012, "chapter_id": 25701, "verse_number": "१७४-१३", "content_sanskrit": "कालपाशान् समाविध्यन् हयैः शशिकरोपमैः ।\nवाय्वीरितैर्जलाकारैः कुर्वन् लीलाः सहस्रशः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005701013, "chapter_id": 25701, "verse_number": "१७४-१४", "content_sanskrit": "पाण्डुरोद्धूत वसनः प्रचलन् रुचिराङ्गदः ।\nमणिश्यामोत्तमवपुर्हरिभारार्पितो वरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005701014, "chapter_id": 25701, "verse_number": "१७४-१५", "content_sanskrit": "वरुणः पाशघृङ्मध्ये देवानीकस्य तस्थिवान् ।\nयुद्धवेलामभिलषन् भिन्नवेल इवार्णवः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005701015, "chapter_id": 25701, "verse_number": "१७४-१६", "content_sanskrit": "यक्षराक्षससैन्येन गुह्यकानां गणैरपि ।\nयुक्तश्च शङ्खपद्माभ्यां निधीनामधिपः प्रभुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005701016, "chapter_id": 25701, "verse_number": "१७४-१७", "content_sanskrit": "राजराजेश्वरः श्रीमान् गदापाणिरदृश्यत ।\nविमानयोधी धनदो विमाने पुष्पके स्थितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005701017, "chapter_id": 25701, "verse_number": "१७४-१८", "content_sanskrit": "स राजराजः शुशुभे युद्धार्थी नरवाहनः ।\nउक्षापमास्थितः सङ्ख्ये साक्षादिव शिवः स्वयम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005701018, "chapter_id": 25701, "verse_number": "१७४-१९", "content_sanskrit": "पूर्वपक्षः सहस्राक्षः पितृराजस्तु दक्षिणः ।\nवरुणः पश्चिमं पक्षमुत्तरं नरवाहनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005701019, "chapter_id": 25701, "verse_number": "१७४-२०", "content_sanskrit": "चतुर्षु युक्ताश्चत्वारो लोकपाला महाबलाः ।\nस्वासु दिक्षुस्वरक्षन्त तस्य देवबलस्य ते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005701020, "chapter_id": 25701, "verse_number": "१७४-२१", "content_sanskrit": "सूर्यः सप्ताश्वयुक्तेन रथेनामितगामिना ।\nश्रिया जाज्वल्यमानेन दीप्यमानैश्च रश्मिभिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005701021, "chapter_id": 25701, "verse_number": "१७४-२२", "content_sanskrit": "उदयास्तग चक्रेण मेरुपर्वत गामिना ।\nत्रिदिवद्वारचक्रेण तपता लोकमव्ययम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005701022, "chapter_id": 25701, "verse_number": "१७४-२३", "content_sanskrit": "सहस्ररश्मि युक्तेन भ्राजमानेन तेजसा ।\nचचार मध्ये लोकानां द्वादशात्मा दिनेश्वरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005701023, "chapter_id": 25701, "verse_number": "१७४-२४", "content_sanskrit": "सोमः श्वेतहये भाति स्यन्दने शीत रश्मिवान् ।\nहिमवत्तोयपूर्णाभि र्भाभिराह्लादयञ्जगत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005701024, "chapter_id": 25701, "verse_number": "१७४-२५", "content_sanskrit": "तमृक्षपूगानुगतं शिशिरांशुं द्विजेश्वरम् ।\nशशच्छायाङ्कित तनुं नैशस्य तमसः क्षयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005701025, "chapter_id": 25701, "verse_number": "१७४-२६", "content_sanskrit": "ज्योतिषामीश्वरं व्योम्नि रसानां रसदं प्रभुम् ।\nओषधीनां सहस्राणां निधानममृतस्य च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005701026, "chapter_id": 25701, "verse_number": "१७४-२७", "content_sanskrit": "जगतः प्रथमं भागं सौम्यं सत्यमयं रथम् ।\nददृशुर्दानवाः सोमं हिमप्रहरणं स्थितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005701027, "chapter_id": 25701, "verse_number": "१७४-२८", "content_sanskrit": "यः प्राणः सर्वभूतानां पञ्चधा भिद्यते नृषु ।\nसप्तधातुगतो लोकां स्त्रीन्दधार चचार च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005701028, "chapter_id": 25701, "verse_number": "१७४-२९", "content_sanskrit": "यमाहुरग्निकर्तारं सर्वप्रभवमीश्वरम् ।\nसप्तस्वरगतोयश्च नित्यङ्गीर्भिरुदीर्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005701029, "chapter_id": 25701, "verse_number": "१७४-३०", "content_sanskrit": "यं वदन्त्युत्तमं भूतं यं वदन्त्यशरीरिणम् ।\nयमाहुराकाशगमं शीघ्रगं शब्दयोगिनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005701030, "chapter_id": 25701, "verse_number": "१७४-३१", "content_sanskrit": "स वायुः सर्वभूतायुरुद्भूतः स्वेन तेजसाववौ प्रव्यथयन् दैत्यान् प्रतिलोमं स तोयदः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005701031, "chapter_id": 25701, "verse_number": "१७४-३२", "content_sanskrit": "मरुतो दिव्यगन्धर्वैर्विद्याधरगणैः सह ।\nचिक्रीडु रसिभिः शुभ्रै निर्मुक्तै रिव पन्नगैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005701032, "chapter_id": 25701, "verse_number": "१७४-३३", "content_sanskrit": "सृजन्तः सर्पपतयस्तीव्र तोयमयं विषम् ।\nशरभूता दिवीन्द्राणाञ्चेरुर्व्यात्तानना दिवि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005701033, "chapter_id": 25701, "verse_number": "१७४-३४", "content_sanskrit": "पर्वतैश्च शिलाश्रृङ्गैः शतशश्चैव पादपैः ।\nउपतस्थुः सुरगणाः प्रहर्तुं दानवे बले ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005701034, "chapter_id": 25701, "verse_number": "१७४-३५", "content_sanskrit": "यः सदेवो हृषीकेशः पद्मनाभस्त्रिविक्रमः ।\nयुगान्ते कृष्णवर्णाभो विश्वस्य जगतः प्रभुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005701035, "chapter_id": 25701, "verse_number": "१७४-३६", "content_sanskrit": "सर्वयोनिः स मधुहा हव्यभुक् क्रतुसंस्थितः ।\nभूम्यपो व्योमभूतात्मा श्यामः शान्तिकरोऽरिहा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005701036, "chapter_id": 25701, "verse_number": "१७४-३७", "content_sanskrit": "अरिघ्नममरादीनाञ्चक्रं गृह्य गदाधरः ।\nअर्कं नगादिवोद्यन्तमुद्यम्योत्तम तेजसा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005701037, "chapter_id": 25701, "verse_number": "१७४-३८", "content_sanskrit": "सव्येनालम्ब्य महतीं सर्वासुरविनाशिनीम् ।\nकरेण कालीं वपुषा शत्रुकालप्रदाङ्गदाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005701038, "chapter_id": 25701, "verse_number": "१७४-३९", "content_sanskrit": "अन्यैर्भुजैः प्रदीप्ताभैर्भुजगारि ध्वजः प्रभुः ।\nदधारायुध जातानि शार्ङ्गादीनि महाबलः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005701039, "chapter_id": 25701, "verse_number": "१७४-४०", "content_sanskrit": "सकश्यपस्यात्मभुवं द्विजं भुजगभोजनम् ।\nपवनाधिकसम्पातं गगनक्षोभणं खगम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005701040, "chapter_id": 25701, "verse_number": "१७४-४१", "content_sanskrit": "भुजगेन्द्रेण वदने निविष्टेन विराजितम् ।\nअमृतारम्भनिर्मुक्तं मन्दराद्रिमिवोच्छ्रितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005701041, "chapter_id": 25701, "verse_number": "१७४-४२", "content_sanskrit": "देवासुरविमर्देषु बहुशो दृढविक्रमम् ।\nमहेन्द्रेणामृतस्यार्थे वज्रेण कृत लक्षणम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005701042, "chapter_id": 25701, "verse_number": "१७४-४३", "content_sanskrit": "शिखिनं बलिनञ्चैव तप्त कुण्डल भूषणम् ।\nविचित्रपत्र वसनं धातुमन्तमिवाचलम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005701043, "chapter_id": 25701, "verse_number": "१७४-४४", "content_sanskrit": "स्फीत क्रोडावलम्बेन शीतांशु समतेजसा ।\nभोगिभोगावसिक्तेन मणिरत्नेन भास्वता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005701044, "chapter_id": 25701, "verse_number": "१७४-४५", "content_sanskrit": "पक्षाभ्याञ्चारुपत्राभ्यामावृत्य दिवि लीलया ।\nयुगान्ते सेन्द्र चापाभ्यान्तोयदाभ्यमिवाम्बरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005701045, "chapter_id": 25701, "verse_number": "१७४-४६", "content_sanskrit": "नीललोहितपीताभिः पताकाभिरलङ्कृतम् ।\nकेतुवेषप्रतिच्छन्नं महाकायनिकेतनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005701046, "chapter_id": 25701, "verse_number": "१७४-४७", "content_sanskrit": "अरुणावरजं श्रीमानारुह्य समरे विभुः ।\nसुवर्णस्वर्णवपुषा सुपर्णं खेचरोत्तमम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005701047, "chapter_id": 25701, "verse_number": "१७४-४८", "content_sanskrit": "तमन्वयुर्देवगणा मुनयश्च समाहिताः ।\nगीर्भिः परममन्त्राभिस्तुष्टुवुश्च जनार्दनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005701048, "chapter_id": 25701, "verse_number": "१७४-४९", "content_sanskrit": "तद्वैश्रवण संश्लिष्टं वैवस्वत पुरःसरम् ।\nद्विजराजपतिक्षिप्तं देवराजविराजितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005701049, "chapter_id": 25701, "verse_number": "१७४-५०", "content_sanskrit": "चन्द्रप्रभाभिर्विपुलं युद्धाय समवर्तत ।\nस्वस्त्यस्तु देवेभ्य इति बृहस्पतिरभाषत॥स्वस्त्यस्तु दानवानीके उशना वाक्यमाददे ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]