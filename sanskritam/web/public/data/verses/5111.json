[{"id": 2193350, "chapter_id": 5111, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2193351, "chapter_id": 5111, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा गुरोर्वाक्यं व्यासशिष्या महौजसः ।\nअन्योन्यं हृष्टमनसः परिषस्वजिरे तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2193352, "chapter_id": 5111, "verse_number": "२", "content_sanskrit": "उक्ताः स्मो यद् भगवता तदात्रायति संहिताम् ।\nतन्नो मनसि संरूढंकरिष्यामस्तथा च तत्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2193353, "chapter_id": 5111, "verse_number": "३", "content_sanskrit": "अन्योन्यं च सभाज्यैवंसुप्रीतमनसः पुनः।\nविज्ञापयन्ति स्म गुरुं पुनर्वाक्यविशारदाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2193354, "chapter_id": 5111, "verse_number": "४", "content_sanskrit": "शैलादस्मान्महीं गन्तुं काङ्क्षितं नो महामुने ।\nवेदाननेकधा कर्तुं यदि ते रुचितं विभो॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2193355, "chapter_id": 5111, "verse_number": "५", "content_sanskrit": "शिष्याणां वचनं श्रुत्वा पराशरसुतः प्रभुः ।\nप्रत्युवाच ततो वाक्यं धर्मार्थसहितं हितम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2193356, "chapter_id": 5111, "verse_number": "६", "content_sanskrit": "क्षितिं वा देवलोकं वा गम्यतां यदि रोचते ।\nअप्रमादश्च वः कार्यो ब्रह्म हि प्रचुरच्छलम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2193357, "chapter_id": 5111, "verse_number": "७", "content_sanskrit": "तेऽनुज्ञातास्ततः सर्वे गुरुणासत्यवादिना।\nजग्मुः प्रदक्षिणं कृत्वा व्यासं मूर्ध्नाभिवाद्य च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2193358, "chapter_id": 5111, "verse_number": "८", "content_sanskrit": "अवतीर्य महीं तेऽथ चातुर्होत्रमकल्पयन् ।\nसंयाजयन्तोविप्रांश्च राजन्यांश्च विशस्तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2193359, "chapter_id": 5111, "verse_number": "९", "content_sanskrit": "पूज्यमाना द्विजैर्नित्यं मोदमानागृहे रताः ।\nयाजनाध्यापनरताः श्रीमन्तो लोकविश्रुताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2193360, "chapter_id": 5111, "verse_number": "१०", "content_sanskrit": "अवतीर्णेषु शिष्येषुव्यासः पुत्रसहायवान् ।\nतूष्णीं ध्यानपरो धीमानेकान्ते समुपाविशत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2193361, "chapter_id": 5111, "verse_number": "११", "content_sanskrit": "तं ददर्शाश्रमपदे नारदः सुमहातपाः ।\nअथैनमब्रवीत् काले मधुराक्षरया गिरा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2193362, "chapter_id": 5111, "verse_number": "१२", "content_sanskrit": "भो भो महर्षे वासिष्ठ ब्रह्मघोषो न वर्तते ।\nएको ध्यानपरस्तूष्णीं किमास्सेचिन्तयन्निव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2193363, "chapter_id": 5111, "verse_number": "१३", "content_sanskrit": "ब्रह्मघोषैर्विरहितः पर्वतोऽयं न शोभते ।\nरजसातमसा चैव सोमः सोपप्लवो यथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2193364, "chapter_id": 5111, "verse_number": "१४", "content_sanskrit": "न भ्राजते यथापूर्वंनिषादानामिवालयः ।\nदेवर्षिगणजुष्टोऽपि वेदध्वनिनिराकृतः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2193365, "chapter_id": 5111, "verse_number": "१५", "content_sanskrit": "ऋषयश्च हि देवाश्च गन्धर्वाश्च महौजसः ।\nविमुक्ताब्रह्मघोषेण न भ्राजन्ते यथा पुरा॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2193366, "chapter_id": 5111, "verse_number": "१६", "content_sanskrit": "नारदस्य वचः श्रुत्वा कृष्णद्वैपायनोऽब्रवीत् ।\nमहर्षे यत्त्वया प्रोक्तं वेदवादविचक्षण\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2193367, "chapter_id": 5111, "verse_number": "१७", "content_sanskrit": "एतन्मनोनुकूलं मे भवानर्हति भाषितुम् ।\nसर्वज्ञः सर्वदर्शी च सर्वत्र च कुतूहली॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2193368, "chapter_id": 5111, "verse_number": "१८", "content_sanskrit": "त्रिषु लोकेषु यद्वृत्तं सर्वं तव मते स्थितम् ।\nतदाज्ञापय विप्रर्षेब्रूहि किं करवाणि ते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2193369, "chapter_id": 5111, "verse_number": "१९", "content_sanskrit": "यन्मया समनुष्ठेयं ब्रह्मर्षे तदुदाहर ।\nवियुक्तस्येह शिष्यैर्मे नातिहृष्टमिदं मनः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2193370, "chapter_id": 5111, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2193371, "chapter_id": 5111, "verse_number": "२०", "content_sanskrit": "अनाम्नायमला वेदा ब्राह्मणस्याव्रतं मलम् ।\nमलं पृथिव्या वाहीकाःस्त्रीणां कौतूहलं मलम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2193372, "chapter_id": 5111, "verse_number": "२१", "content_sanskrit": "अधीयतां भवान् वेदान् सार्धं पुत्रेण धीमता ।\nविधुन्वन्ब्रह्मघोषेण रक्षोभयकृतं तमः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2193373, "chapter_id": 5111, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2193374, "chapter_id": 5111, "verse_number": "२२", "content_sanskrit": "नारदस्य वचः श्रुत्वा व्यासः परमधर्मवित्।\nतथेत्युवाचसंहृष्टो वेदाभ्यासे दृढव्रतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2193375, "chapter_id": 5111, "verse_number": "२२", "content_sanskrit": "उवाच च महाप्राज्ञं नारदं पुनरेव हि \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2193376, "chapter_id": 5111, "verse_number": "२३", "content_sanskrit": "मलं पृथिव्या बाह्लीका इत्युक्तमधुना त्वया ।\nकीदृशाश्चैव बाह्लीका ब्रूहि मे वदतां वर\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2193377, "chapter_id": 5111, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2193378, "chapter_id": 5111, "verse_number": "२४", "content_sanskrit": "अस्यां पृथिव्यां चत्वारो देशाः पापजनैर्वृताः ।\nयुगन्धरस्तु प्रथमस्तथा भूतिलकः स्मृतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2193379, "chapter_id": 5111, "verse_number": "२५", "content_sanskrit": "अच्युतश्छल इत्युक्तस्तृतीयः पापकृत्तमः ।\nचतुर्थस्तु महापापो बाह्लीक इति सञ्ज्ञितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2193380, "chapter_id": 5111, "verse_number": "२६", "content_sanskrit": "मृगोष्ट्रगर्दभक्षीरं पिबन्त्यस्य युगन्धरे ।\nएवकर्णास्तु दृश्यन्ते जना वै ह्यच्युतस्थले\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2193381, "chapter_id": 5111, "verse_number": "२७", "content_sanskrit": "मेहन्ति च मलं पापा विसृजन्ति जलेषु वै ।\nनित्यं भूतिलकेत्यन्नं तज्जलं च पिबन्ति च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2193382, "chapter_id": 5111, "verse_number": "२८", "content_sanskrit": "हरिबाह्यास्तु बाह्लीका न स्मरन्ति हरिं क्वचित् ।\nऐहलौकिकमोक्षं ते मांसशोणितवर्धनाः ।\nवृथा जाता भविष्यन्ति बाह्लीका इति विश्रुताः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2193383, "chapter_id": 5111, "verse_number": "२९", "content_sanskrit": "पुष्कराहारनिरताः पिशाचाः यदभाषते ।\nमुसुण्ठीं परिगृह्योग्रां तच्छ्रुणुष्व महामुने\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2193384, "chapter_id": 5111, "verse_number": "३०", "content_sanskrit": "ब्राह्मणीं बहुपुत्रां तां पुष्करे स्नातुमागताम् ।\nयुगन्धरे पयः पीत्वा ह्युचिता ह्यच्युतस्थळे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2193385, "chapter_id": 5111, "verse_number": "३१", "content_sanskrit": "तथा भूतिलके स्नात्वा बाह्लीकांश्च निरीक्ष्य वै ।\nआगताऽसि तथा स्नातुं कथं स्वर्गं न गच्छसि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2193386, "chapter_id": 5111, "verse_number": "३२", "content_sanskrit": "इत्युक्त्वा ब्राह्मणीभाण्डं पोथयित्वा मुसुण्ठिना ।\nउवाच क्रोधताम्राक्षी पिशाची तीर्थपालिका\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2193387, "chapter_id": 5111, "verse_number": "३३", "content_sanskrit": "एतत् तु ते दिवावृत्तं परावृत्य परीक्ष्य च ।\nगच्छ बाह्लीकसंसर्गादशुचित्वं न संशयः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2193388, "chapter_id": 5111, "verse_number": "३४", "content_sanskrit": "यद् द्विषन्ति महात्मानं न स्मरन्ति जनार्दनम् ।\nन तेषां पुण्यतीर्थेषु गतिः संसर्गिणामपि \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2193389, "chapter_id": 5111, "verse_number": "३५", "content_sanskrit": "उद्युक्ता ब्राह्मणी भीता प्रतियाता सुतैः सह ।\nस्वदेहस्था जजापैवं सपुत्रा ध्यानतत्परा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2193390, "chapter_id": 5111, "verse_number": "३६", "content_sanskrit": "अनन्तस्य हरेः शुद्धं नाम वै द्वादशाक्षरम् ।\nवत्सरत्रितये पूर्णे ब्राह्मणी पुनरागता \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2193391, "chapter_id": 5111, "verse_number": "३७", "content_sanskrit": "सपुत्रा पुष्करद्वारं पिशाच्याह तथागतम् ।\nनमस्ते ब्राह्मणि शुभे पूताऽहं तव दर्शनात्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2193392, "chapter_id": 5111, "verse_number": "३८", "content_sanskrit": "कुरु तीर्थाभिषेकं च सपुत्रा पापवर्जिता ।\nहरेर्नाम्ना च मां साध्वी जलेन स्पष्ट्रुमर्हसि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2193393, "chapter_id": 5111, "verse_number": "३९", "content_sanskrit": "इत्युक्ता ब्राह्मणी हृष्टा पुत्रैः सह शुभव्रता ।\nजलेन प्रोक्षयामास द्वादशाक्षरसंयुतम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2193394, "chapter_id": 5111, "verse_number": "४०", "content_sanskrit": "तत्क्षणादभवच्छुद्धा पिशाची दिव्यरूपिणी ।\nअप्सरा ह्यभवद् दिव्या गता स्वर्लोकमुत्तमम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2193395, "chapter_id": 5111, "verse_number": "४१", "content_sanskrit": "ब्राह्मणी चैव कालेन वासुदेवपरायणा ।\nसपुत्रा चागता स्थानमच्युतस्य शुभं परम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2193396, "chapter_id": 5111, "verse_number": "४२", "content_sanskrit": "एतत् ते कथितं विद्वन् मुने कालोऽयमागतः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2193397, "chapter_id": 5111, "verse_number": "४३", "content_sanskrit": "गमिष्येऽहं महाप्राज्ञ आगमिष्यामि वै पुनः ।\nइत्युक्त्वा स जगामाथ नारदो वदतांवरः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2193398, "chapter_id": 5111, "verse_number": "४४", "content_sanskrit": "द्वैपयनस्तु भगवांस्तच्छ्रुत्वा मुनिसत्तमात् ।\nशुकेन सह पुत्रेण वेदाभ्यासमथाकरोत् ।\nस्वरेणोच्चैः स शैक्षेण लोकानापूरयन्निव\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2193399, "chapter_id": 5111, "verse_number": "४५", "content_sanskrit": "तयोरभ्यसतोरेवं नानाधर्मप्रवादिनोः ।\nवातोऽतिमात्रं प्रववौ समुद्रानिलवेजितः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2193400, "chapter_id": 5111, "verse_number": "४६", "content_sanskrit": "ततोऽनध्याय इति तं व्यासः पुत्रमवारयत् ।\nशुको वारितमात्रस्तु कौतूहलसमन्वितः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2193401, "chapter_id": 5111, "verse_number": "४७", "content_sanskrit": "अपृच्छत् पितरं ब्रह्मन्कुतो वायुरभूदयम् ।\nआख्यातुमर्हति भवान् वायोः सर्वं विचेष्टितम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2193402, "chapter_id": 5111, "verse_number": "४८", "content_sanskrit": "शुकस्यैतद् वचः श्रुत्वा व्यासः परमविस्मितः।\nअनध्यायनिमित्तेऽस्मिन्निदं वचनमब्रवीत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2193403, "chapter_id": 5111, "verse_number": "४९", "content_sanskrit": "दिव्यं ते चक्षुरुत्पन्नं स्वस्थंते निर्मलं मनः ।\nतमसा रजसा चापि त्यक्तः सत्त्वेव्यवस्थितः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2193404, "chapter_id": 5111, "verse_number": "५०", "content_sanskrit": "आदर्शे स्वामिव छायां पश्यस्यात्मानमात्मना ।\nन्यस्यात्मनि स्वयं वेदान्बुद्ध्या समनुचिन्तय\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2193405, "chapter_id": 5111, "verse_number": "५१", "content_sanskrit": "देवयानचरो विष्णोः पितृयानश्च तामसः ।\nद्वावेतौ प्रेत्य पन्थानौ दिवं चाधश्च गच्छतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2193406, "chapter_id": 5111, "verse_number": "५२", "content_sanskrit": "पृथिव्यामन्तरिक्षे च यत्र संवान्ति वायवः ।\nसप्तैते वायुमार्गा वैतान्निबोधानुपूर्वशः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2193407, "chapter_id": 5111, "verse_number": "५३", "content_sanskrit": "तत्र देवगणाः साध्याः समभूवन्महाबलाः ।\nतेषामप्यभवत् पुत्रः समानो नाम दुर्जयः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2193408, "chapter_id": 5111, "verse_number": "५४", "content_sanskrit": "उदानस्तस्य पुत्रोऽभूद्व्यानस्तस्याभवत् सुतः ।\nअपानश्च ततो ज्ञेयः प्राणश्चापि ततः परम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2193409, "chapter_id": 5111, "verse_number": "५५", "content_sanskrit": "अनपत्योऽभवत् प्राणो दुर्धर्षः शत्रुतापनः ।\nपृथक्कर्माणि तेषां तु प्रवक्ष्यामि यथातथम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2193410, "chapter_id": 5111, "verse_number": "५६", "content_sanskrit": "प्राणिनां सर्वतो वायुश्चेष्टा वर्तयते पृथक् ।\nप्राणनाच्चैव भूतानांप्राण इत्यभिधीयते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2193411, "chapter_id": 5111, "verse_number": "५७", "content_sanskrit": "प्रेरयत्यभ्रसङ्घातान्धूमजांश्चोष्मजांश्च यः ।\nप्रथमः प्रथमे मार्गे प्रवहो नाम सोऽनिलः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2193412, "chapter_id": 5111, "verse_number": "५८", "content_sanskrit": "अम्बरे स्नेहमभ्रेभ्यस्तडिद्भ्यश्चोत्तमद्युतिः ।\nआवहो नाम संवाति द्वितीयः श्वसनोनदन्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2193413, "chapter_id": 5111, "verse_number": "५९", "content_sanskrit": "उदयं ज्योतिषां शश्वत् सोमादीनां करोति यः ।\nअन्तर्देहेषुचोदानं यं वदन्ति महर्षयः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2193414, "chapter_id": 5111, "verse_number": "६०", "content_sanskrit": "यश्चतुर्भ्यः समुद्रेभ्यो वायुर्धारयते जलम् ।\nउद्धृत्याददतेचापो जीमूतेभ्योऽम्बरेऽनिलः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2193415, "chapter_id": 5111, "verse_number": "६१", "content_sanskrit": "योऽद्भिःसंयोज्य जीमूतान् पर्जन्याय प्रयच्छति ।\nउद्वहो नाम वर्षिष्ठस्त्रितीयः स सदागतिः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2193416, "chapter_id": 5111, "verse_number": "६२", "content_sanskrit": "समुह्यमानाबहुधा येन नीलाः पृथग्घनाः ।\nवर्षमोक्षकृतारम्भास्ते भवन्तिघनाघनाः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2193417, "chapter_id": 5111, "verse_number": "६३", "content_sanskrit": "संहता येन चाविद्धा भवन्ति नदतां नदाः ।\nरक्षणार्थाय सम्भूतामेघत्वमुपयान्ति च\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2193418, "chapter_id": 5111, "verse_number": "६४", "content_sanskrit": "योऽसौ वहतिदेवानां विमानानि विहायसा ।\nचतुर्थः संवहो नाम वायुः स गिरिमर्दनः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2193419, "chapter_id": 5111, "verse_number": "६५", "content_sanskrit": "येन वेगवता रुग्णा रूक्षेणारुजता रसान् ।\nवायुना विहता मेघास्ते भवन्ति बलाहकाः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2193420, "chapter_id": 5111, "verse_number": "६६", "content_sanskrit": "दारुणोत्पातसञ्चारो नभसः स्तनयित्नुमान् ।\nपञ्चमः स महावेगोविवहो नाम मारुतः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2193421, "chapter_id": 5111, "verse_number": "६७", "content_sanskrit": "यस्मिन् पारिप्लवेदिव्या वहन्त्यापो विहायसा ।\nपुण्यं चाकाशगङ्गायास्तोयं विष्टभ्य तिष्ठति\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2193422, "chapter_id": 5111, "verse_number": "६८", "content_sanskrit": "दूरात् प्रतिहतो यस्मिन्नेकरश्मिर्दिवाकरः ।\nयोनिरंशुसहस्रस्य येनभाति वसुन्धरा\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2193423, "chapter_id": 5111, "verse_number": "६९", "content_sanskrit": "यस्मादाप्यायते सोमो निधिर्दिव्योऽमृतस्य च ।\nषष्ठः परिवहो नाम स वायुर्जवतांवरः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2193424, "chapter_id": 5111, "verse_number": "७०", "content_sanskrit": "सर्वप्राणभृतां प्राणान्योऽन्तकाले निरस्यति ।\nयस्य वर्त्मानुवर्तेते मृत्युवैवस्वतावुभौ\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2193425, "chapter_id": 5111, "verse_number": "७१", "content_sanskrit": "सम्यगन्वीक्षतां बुद्ध्या शान्तयाध्यात्मनित्यया ।\nध्यानाभ्यासाभिरामाणां योऽमृतत्वायकल्पते\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2193426, "chapter_id": 5111, "verse_number": "७२", "content_sanskrit": "यं समासाद्य वेगेन दिशामन्तं प्रपेदिरे ।\nदक्षस्य दश पुत्राणां सहस्राणि प्रजापतेः॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2193427, "chapter_id": 5111, "verse_number": "७३", "content_sanskrit": "येन स्पृष्टः पराभूतो यात्येव न निवर्तते ।\nपरावहो नाम परो वायुः स दुरतिक्रमः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2193428, "chapter_id": 5111, "verse_number": "७४", "content_sanskrit": "एवमेतेऽदितेः पुत्रा मारुताः परमाद्भुताः ।\nअनारमन्तः संवान्ति सर्वगाः सर्वधारिणः॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2193429, "chapter_id": 5111, "verse_number": "७५", "content_sanskrit": "एतत्तु महदाश्चर्यं यदयं पर्वतोत्तमः ।\nकम्पितः सहसा तेन वायुनाभिप्रवायता\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2193430, "chapter_id": 5111, "verse_number": "७६", "content_sanskrit": "विष्णोर्निःश्वासवातोऽयं यदा वेगसमीरितः ।\nसहसोदीर्यते तात जगत् प्रव्यथते तदा\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2193431, "chapter_id": 5111, "verse_number": "७७", "content_sanskrit": "तस्माद् ब्रह्मविदो ब्रह्म नाधीयन्तेऽतिवायति ।\nवायोर्वायुभवे ह्युक्तं ब्रह्म तत् पीडितं भवेत्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2193432, "chapter_id": 5111, "verse_number": "७८", "content_sanskrit": "एतावदुक्त्वा वचनं पराशरसुतः प्रभुः ।\nउक्त्वा पुत्रमधीष्वेति व्योमगङ्गामयात्तदा\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2193433, "chapter_id": 5111, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे षष्ट्युत्तरशततमोऽध्यायः ॥१६०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]