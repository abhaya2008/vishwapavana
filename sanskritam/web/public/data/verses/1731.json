[{"id": 2033833, "chapter_id": 1731, "verse_number": "४-५४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033834, "chapter_id": 1731, "verse_number": "४-५४-१", "content_sanskrit": "तथा व्यूढेष्वनीकेषु कौरवेयैर्महारथैः ।\nउपायादर्जुनंस्तूर्णं रथघोषेण नादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033835, "chapter_id": 1731, "verse_number": "४-५४-२", "content_sanskrit": "ददृशुस्ते ध्वजाग्रं वै शुश्रुवुश्च रथस्वनम् ।\nदोधूयमानस्य भृशं गाण्डीवस्य च निस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033836, "chapter_id": 1731, "verse_number": "४-५४-३", "content_sanskrit": "त्रिकोशमात्रं गत्वा तु पाण्डवः श्वेतवाहनः ।\nसंनामुखमभिप्रेक्ष्य पार्थो वैराटिमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033837, "chapter_id": 1731, "verse_number": "४-५४-४", "content_sanskrit": "राजानं नात्र पश्यामि रथानीके व्यवस्थितम्।\nदक्षिणं पक्षमादाय कुरुवो यान्त्युदङ्भुंखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033838, "chapter_id": 1731, "verse_number": "४-५४-५", "content_sanskrit": "उत्सृज्यैतद्रथानीकं महेष्वासाभिरक्षितम्।\nगवाग्रमभितो याहि यावत्पश्यामि मे रिपुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033839, "chapter_id": 1731, "verse_number": "४-५४-६", "content_sanskrit": "गवाग्रमभितो गत्वा गाश्चैवाशु निवर्तय ।\nयावदेते निवर्तन्ते कुरवो जवमास्थिताः ।\nतावदेव पशून्सर्वान्निवर्तिष्ये तवाभिभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033840, "chapter_id": 1731, "verse_number": "४-५४-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033841, "chapter_id": 1731, "verse_number": "४-५४-७", "content_sanskrit": "इत्युक्त्वा समरे पार्थो वैराटिमपराजितः ।\nसव्यं पक्षमनुप्राप्य जवेनाश्वानचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033842, "chapter_id": 1731, "verse_number": "४-५४-८", "content_sanskrit": "ततोऽभ्यवादयत्पार्थो भीष्मं शान्तनवं कृपम्।\nद्वाभ्यांद्वाभ्यां तथाऽऽचार्यं द्रोणं प्रथमतः क्रमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033843, "chapter_id": 1731, "verse_number": "४-५४-९", "content_sanskrit": "द्रोणं कृपं च भीष्मं च पृषत्कैरभ्यवादयत्।\nततस्तत्सर्वमालोक्य द्रोणो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033844, "chapter_id": 1731, "verse_number": "४-५४-१०", "content_sanskrit": "महारथमनुप्राप्तं दृष्ट्वा गाण्डीवधन्विनम् ।\nन कश्चिद्योद्भिमिच्छेत न च गुप्तं स्वजीवितम् ।\nअयं वीरश्च शूरश्च दुर्धर्षश्चैव संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033845, "chapter_id": 1731, "verse_number": "४-५४-११", "content_sanskrit": "एतद्ध्वजाग्रं पार्थस्य दूरतः प्रतिदृश्यते।\nमेघःक सविद्युत्स्तनितो रोरवीति च वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033846, "chapter_id": 1731, "verse_number": "४-५४-१२", "content_sanskrit": "आस्थाय च रथं याति गाण्डीवं विक्षिपन्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033847, "chapter_id": 1731, "verse_number": "४-५४-१३", "content_sanskrit": "अश्वानां स्तनतां शब्दो वहतां पाकशासनिम्।\nरथस्याम्बुधरस्येव श्रूयते भृशदारुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033848, "chapter_id": 1731, "verse_number": "४-५४-१४", "content_sanskrit": "दारयन्निव तेजस्वी वसुधां वासवात्मजः ।\nएष दृष्ट्वा रथानीकमस्माकमरिमर्दनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033849, "chapter_id": 1731, "verse_number": "४-५४-१५", "content_sanskrit": "श्रीमान्वदान्यो धृतिमान्तत्करोति च पाण्डवः ॥\nइमौ बाणावनुप्राप्तौ पादयोः प्रत्युपस्थितौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033850, "chapter_id": 1731, "verse_number": "४-५४-१६", "content_sanskrit": "रथस्याग्रे निखातौ मे चित्रपुङ्खावजिह्मगौ ॥\nइमौ चाप्यपरौ बाणावभितः कर्णमूलयोः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033851, "chapter_id": 1731, "verse_number": "४-५४-१७", "content_sanskrit": "संस्पृशन्तावतिक्रान्तौ पृष्ट्वेवानामयं भृशम् ॥\nचिरदृष्टोऽयमस्माभिर्धर्मज्ञो बान्धवप्रियः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033852, "chapter_id": 1731, "verse_number": "४-५४-१८", "content_sanskrit": "अतीव ज्वलते लक्ष्म्या पाण्डुपुत्रः प्रतापवान् ॥\nनिरुष्य च वने वामं कृत्वा कर्म सुदुष्करम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033853, "chapter_id": 1731, "verse_number": "४-५४-१९", "content_sanskrit": "अभिवादयते पार्थः पूजयन्मामरिंदमः ॥\nअमर्षेण हि संपूर्णो दुःखेन प्रतिबोधितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033854, "chapter_id": 1731, "verse_number": "४-५४-२०", "content_sanskrit": "अद्येमां भारतीं सेनामेको नाशयते ध्रुवम् ॥\nद्व्यधिकं दशमुष्य वत्सराणां स्वजनेनाविदितस्त्रयोदशं च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033855, "chapter_id": 1731, "verse_number": "४-५४-२१", "content_sanskrit": "ज्वलते रथमास्थितः किरीटी तम इव रात्रिजमभ्युदस्य सूर्यः ॥\nरथी शरी चारुमाली निषङ्गी शङ्खी पताकी कवची किरीटी।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033856, "chapter_id": 1731, "verse_number": "४-५४-२२", "content_sanskrit": "खङ्गी च धन्वी च विराजतेऽयं शिखीव यज्ञेषु घृतेन सिक्तः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033857, "chapter_id": 1731, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि चतुःपञ्चाशोऽध्यायः ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]