[{"id": 2030508, "chapter_id": 1666, "verse_number": "३-३०४-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030509, "chapter_id": 1666, "verse_number": "३-३०४-१", "content_sanskrit": "किं तद्गुह्यं न चाख्यातं कर्णायेहोष्णरश्मिना।\nकीदृशेकुण्डले ते च कवचं रचैव कीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030510, "chapter_id": 1666, "verse_number": "३-३०४-२", "content_sanskrit": "कुतश्च कवचं तस्यं कुण्डलेचैव सत्तम।\nएतदिच्छाम्यहं श्रोतुं तन्मे ब्रूहि तपोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030511, "chapter_id": 1666, "verse_number": "३-३०४-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030512, "chapter_id": 1666, "verse_number": "३-३०४-३", "content_sanskrit": "अहं राजन्ब्रवीम्येतत्तस्य गुह्यं विभावसोः।\nयादृशे कुण्डले ते च कवचं वैव यादृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030513, "chapter_id": 1666, "verse_number": "३-३०४-४", "content_sanskrit": "कुन्तिभोजं पुरा राजन्ब्राह्मणः पर्युपस्थितः।\nतिग्मतेजा महान्प्रांशुः श्मश्रुदण्डजटाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030514, "chapter_id": 1666, "verse_number": "३-३०४-५", "content_sanskrit": "दर्सनीयोऽनवद्याङ्गस्तेजसा प्रज्वलन्निव।\nमधुपिङ्गो मधुरवाक्तपःस्वाध्यायभूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030515, "chapter_id": 1666, "verse_number": "३-३०४-६", "content_sanskrit": "स राजानं कुन्तिभोजमब्रवीत्सुमहातपाः।\nभिक्षामिच्छामि वै भोक्तुं तव गेहे विमत्सर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030516, "chapter_id": 1666, "verse_number": "३-३०४-७", "content_sanskrit": "न मे व्यलीकं कर्तव्यं त्वया वा तव चानुगैः।\nएवं वत्स्यामि ते गेहे यदि ते रोचतेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030517, "chapter_id": 1666, "verse_number": "३-३०४-८", "content_sanskrit": "यथाकामं च गच्छेयमागच्छेयं तथैव च।\nशय्यासने च मे राजन्नापराध्येत कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030518, "chapter_id": 1666, "verse_number": "३-३०४-९", "content_sanskrit": "तमब्रवीत्कुन्तिभोजः प्रीतियुक्तमिदं वचः।\nएवमस्तु परंचेति पुनश्चैवमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030519, "chapter_id": 1666, "verse_number": "३-३०४-१०", "content_sanskrit": "मम कन्या महाप्राज्ञ पृथा नाम यशस्विनी।\nशीलवृत्तान्विता साध्वी नियताऽनवमानिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030520, "chapter_id": 1666, "verse_number": "३-३०४-११", "content_sanskrit": "उपस्थास्यति सा त्वां वै पूजयाऽनवमत्य च।\nतस्याश्च शीलवृत्तेन तुष्टिं समुपयास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030521, "chapter_id": 1666, "verse_number": "३-३०४-१२", "content_sanskrit": "एवमुक्त्वा तु तं विप्रमभिपूज्य यथाविधि।\nउवाच कन्यामभ्येत्य पृथां पृथुललोचनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030522, "chapter_id": 1666, "verse_number": "३-३०४-१३", "content_sanskrit": "अयं वत्से महाभागो ब्राह्मणो वस्तुमिच्छति।\nमम गेहे मया चास्य तथेत्येवं प्रतिश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030523, "chapter_id": 1666, "verse_number": "३-३०४-१४", "content_sanskrit": "त्वयि वत्से परायत्तं ब्राह्मणस्याभिराधनम्।\nतन्मे वाक्यममिथ्या त्वं कर्तुमर्हसि कर्हिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030524, "chapter_id": 1666, "verse_number": "३-३०४-१५", "content_sanskrit": "अयं तपस्वी भगवान्स्वाध्यायनियतो द्विजः।\nयद्यद्ब्रूयान्महातेजास्तत्तद्देयमात्सरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030525, "chapter_id": 1666, "verse_number": "३-३०४-१६", "content_sanskrit": "ब्राह्मणा हि परं तेजो ब्राह्मणा हि परं तपः।\nब्राह्मणानां नमस्कारैः सूर्यो दिवि विराजते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030526, "chapter_id": 1666, "verse_number": "३-३०४-१७", "content_sanskrit": "अमानयन्हि दाण्डक्यो वातापिश्च महासुरः।\nनिहतो ब्रह्मदण्डेन तालजङ्घस्तथैव च।\n`वैन्ध्याद्रिश्च समुद्रश्च नद्दुषश्च विहिंसितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030527, "chapter_id": 1666, "verse_number": "३-३०४-१८", "content_sanskrit": "सोयं वत्से महाभार आहितस्त्वयि सांप्रतम्।\nत्वं सदा नियता कुर्या ब्राह्मणस्याभिराधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030528, "chapter_id": 1666, "verse_number": "३-३०४-१९", "content_sanskrit": "जानामि प्रणिधानं ते बाल्यात्प्रभृति नन्दिनि।\nब्राह्मणेष्विह सर्वेषु गुरुबन्धुषु चैव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030529, "chapter_id": 1666, "verse_number": "३-३०४-२०", "content_sanskrit": "तथा प्रेष्येषु सर्वेषु मित्रसंबन्धिमातृषु।\nमयि चैव यथावत्त्वंसर्वमावृत्य वर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030530, "chapter_id": 1666, "verse_number": "३-३०४-२१", "content_sanskrit": "न ह्यतुष्टो जनोऽस्तीह पुरे चान्तःपुरे च ते।\nसम्यग्वृत्त्याऽनवद्याङ्गि तव भृत्यजनेष्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030531, "chapter_id": 1666, "verse_number": "३-३०४-२२", "content_sanskrit": "संदेष्टव्यां तु मन्ये त्वां द्विजातिं कोपनं प्रति।\nपृथे बालेति कृत्वा वै सुता चासिममेति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030532, "chapter_id": 1666, "verse_number": "३-३०४-२३", "content_sanskrit": "वृष्णीनां च कुले जाता शूरस् दयिता सुता।\nदत्ता प्रीतिमता मह्यं पित्रा बाला पुरास्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030533, "chapter_id": 1666, "verse_number": "३-३०४-२४", "content_sanskrit": "वसुदेवस् भगिनी सुतानां प्रवरा मम।\nअग्र्यमग्रे प्रतिज्ञाय तेनासि दुहिता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030534, "chapter_id": 1666, "verse_number": "३-३०४-२५", "content_sanskrit": "तादृशे हि कुले जाता कुले मम विवर्धिता।\nसुखात्सुखमनुप्राप्ता ह्रदाद्ध्रदमिवापगा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030535, "chapter_id": 1666, "verse_number": "३-३०४-२६", "content_sanskrit": "दौष्कुलेया विशेषेण कथंचित्प्रग्रहं गताः।\nबालभावाद्विकुर्वन्ति प्रायशः प्रमदाः शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030536, "chapter_id": 1666, "verse_number": "३-३०४-२७", "content_sanskrit": "पृथे राजकुले जन्म रूपं चापि तवाद्भुतम्।\nतेन तेनासि संपन्ना समुपेता च भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030537, "chapter_id": 1666, "verse_number": "३-३०४-२८", "content_sanskrit": "सा त्वं दर्पं परित्यज्य दम्भं मानं च भामिनि।\nआराध्यवरदं विप्रं श्रेयसा योक्ष्यसे पृथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030538, "chapter_id": 1666, "verse_number": "३-३०४-२९", "content_sanskrit": "एवं प्राप्स्यसि कल्याणि कल्याणमनघे ध्रुवम्।\nकोपिते च द्विजश्रेष्ठे कुत्स्नं दह्येत मे कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030539, "chapter_id": 1666, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कुण्डलाहरणपर्वणि चतुरधिकत्रिशततमोऽध्यायः ॥ ३०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]