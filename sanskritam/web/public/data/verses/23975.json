[{"id": 7003975000, "chapter_id": 23975, "verse_number": "३-१-३८-१", "content_sanskrit": "ऋषय ऊचुः ।\nसूत कद्रुः कथं मुक्ता क्षीरकुंडनिमज्जनात् ।\nछलं कथं कृतवती सपत्न्यां पापनिश्चया॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003975001, "chapter_id": 23975, "verse_number": "३-१-३८-२", "content_sanskrit": "कस्य पुत्री च सा कद्रूः सपत्नीसा च कस्य वै ।\nकिमर्थमजयत्कद्रूः स्वसपत्नीं छलेन तु ।\nएतन्नः श्रद्दधानानां ब्रूहि सूत कृपानिधे॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003975002, "chapter_id": 23975, "verse_number": "३-१-३८-३", "content_sanskrit": "श्रीसूत उवाच ।\nशृणुध्वं मुनयः सर्वे इतिहासं महाफलम् ।\nपुरा कृतयुगे विप्राः प्रजापतिसुते उभे॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003975003, "chapter_id": 23975, "verse_number": "३-१-३८-४", "content_sanskrit": "कद्रूश्च विनता चेति भगिन्यौ संबभूवतुः ।\nभार्ये ते कश्यपस्यास्तां कद्रूश्च विनता तथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003975004, "chapter_id": 23975, "verse_number": "३-१-३८-५", "content_sanskrit": "विनता सुषुवे पुत्रावरुणं गरुडं तथा ।\nभर्त्तुः सकाशात्कद्रूश्च लेभे सर्पान्बहून्सुतान्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003975005, "chapter_id": 23975, "verse_number": "३-१-३८-६", "content_sanskrit": "अनंतवासुकिमुखान्विषदर्पसमन्वितान् ।\nएकदा तु भगिन्यौ ते कद्रूश्च विनता तथा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003975006, "chapter_id": 23975, "verse_number": "३-१-३८-७", "content_sanskrit": "अपश्यतां समायांतमुच्चैःश्रवसमं तिकात् ।\nविलोक्य कद्रूस्तुरगं विनतामिदमब्रवीत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003975007, "chapter_id": 23975, "verse_number": "३-१-३८-८", "content_sanskrit": "श्वेतोऽश्ववालो नीलो वा विनते ब्रूहि तत्त्वतः ।\nइत्युक्त्वा विनता विप्राः कद्रूं तामिदमब्र वीत् ।\nतुरंगः श्वेतवालो मे प्रतिभाति सुमध्यमे ।\nकिं वा त्वं मन्यसे कद्रूरिति तां विनताऽब्रवीत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003975008, "chapter_id": 23975, "verse_number": "३-१-३८-९", "content_sanskrit": "पृष्ट्वैवं विनतां कद्रूर्बभाषे स्वमतं च सा ।\nकृष्णवालमहं मन्ये हयमेनमनिंदिते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003975009, "chapter_id": 23975, "verse_number": "३-१-३८-१०", "content_sanskrit": "ततः पराजये कृत्वा दासीभावं पणं मिथः ।\nव्यतिष्ठेतां महाभागे सपत्न्यौ ते द्विजोत्तमाः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003975010, "chapter_id": 23975, "verse_number": "३-१-३८-११", "content_sanskrit": "ततः कद्रूर्निजसुतान्वासुकिप्रमुखानहीन् ।\nतस्या नाहं यथा दासी तथा कुरुत पुत्रकाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003975011, "chapter_id": 23975, "verse_number": "३-१-३८-१२", "content_sanskrit": "तस्याभीप्सितसिद्ध्यर्थमित्यवोचद्भृशा तुरा ।\nयुष्माभिरुच्चैःश्रवसो बालः प्रच्छाद्यतामिति॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003975012, "chapter_id": 23975, "verse_number": "३-१-३८-१३", "content_sanskrit": "नांगीचक्रुर्मतं तस्या नागाः कद्रू रुषा तदा ।\nअशपत्कुपिता पुत्राञ्ज्वलंती रोषमूर्च्छि ता॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003975013, "chapter_id": 23975, "verse_number": "३-१-३८-१४", "content_sanskrit": "पारीक्षितस्य सर्वेऽद्धा यूयं सत्रे मरिष्यथ ।\nइति शापे कृते मात्रा त्रस्तः कर्कोटकस्तदा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003975014, "chapter_id": 23975, "verse_number": "३-१-३८-१५", "content_sanskrit": "प्रणम्य पादयोः कद्रूं दीनो वचनम ब्रवीत् ।\nअहमुच्चैःश्रवोवालं विधास्याम्यंजनप्रभम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003975015, "chapter_id": 23975, "verse_number": "३-१-३८-१६", "content_sanskrit": "मा भीरंब त्वया कार्येत्यवादीच्छापविक्लवः ।\nश्वेतमुच्चैःश्रवोवालं ततः कर्कोटको रगः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003975016, "chapter_id": 23975, "verse_number": "३-१-३८-१७", "content_sanskrit": "छादयित्वा स्वभोगेन व्यतनोदंजनद्युतिम् ।\nअथ ते विनताकद्र्वौ दास्ये कृतपणे उभे॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003975017, "chapter_id": 23975, "verse_number": "३-१-३८-१८", "content_sanskrit": "देवराजहयं द्रष्टुं संरंभादभ्यगच्छ ताम् ।\nशशांकशंखमाणिक्यमुक्तैरावतकारणम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003975018, "chapter_id": 23975, "verse_number": "३-१-३८-१९", "content_sanskrit": "युगांतकालशयनं योगनिद्राकृतो हरेः ।\nअतीत्य कद्रूविनते समुद्रं सरितां पतिम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003975019, "chapter_id": 23975, "verse_number": "३-१-३८-२०", "content_sanskrit": "ददृशतुर्हयं गत्वा देवराजस्य वाहनम् ।\nकृष्णवालं हयं दृष्ट्वा विनता दुःखिताऽभवत्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003975020, "chapter_id": 23975, "verse_number": "३-१-३८-२१", "content_sanskrit": "दुःखितां विनतां कद्रूर्दासीकृत्ये न्ययुंक्त सा ।\nएतस्मिन्नंतरे तार्क्ष्योऽप्यंडमुद्भिद्य वह्निवत्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003975021, "chapter_id": 23975, "verse_number": "३-१-३८-२२", "content_sanskrit": "प्रादुर्बभूव विप्रेंद्रा गिरिमात्रशरीरवान् ।\nदृष्ट्वा तद्देहमाहात्म्यमभूत्त्रस्तं जगत्त्रयम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003975022, "chapter_id": 23975, "verse_number": "३-१-३८-२३", "content_sanskrit": "ततस्तं तुष्टुवुर्देवा गरुडं पक्षिणां वरम् ।\nदृष्ट्वा तद्देहमाहात्म्यं त्रस्तं स्याद्भुवनत्रयम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003975023, "chapter_id": 23975, "verse_number": "३-१-३८-२४", "content_sanskrit": "इत्यालोच्योपसंहृत्य देहमत्यंतभीषणम् ।\nअरुणं पृष्ठमारोप्य मातुरंतिकमभ्यगात्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003975024, "chapter_id": 23975, "verse_number": "३-१-३८-२५", "content_sanskrit": "अथाह विनतां कद्रूः प्रणतामतिविह्वलाम् ।\nचेटि नागालयं गंतुमुद्योगो मम वर्तते॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003975025, "chapter_id": 23975, "verse_number": "३-१-३८-२६", "content_sanskrit": "त्वत्पुत्रो गरुडोतो मां मत्पुत्रांश्च वहत्विति ।\nततश्च विनता पुत्रं गरुडं प्रत्यभाषत॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003975026, "chapter_id": 23975, "verse_number": "३-१-३८-२७", "content_sanskrit": "अहं कद्रूमिमां वक्ष्ये त्वं सर्पान्वह तत्सुतान् ।\nतथेति गरुडो मातुः प्रत्यगृह्णद्वचो द्विजाः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003975027, "chapter_id": 23975, "verse_number": "३-१-३८-२८", "content_sanskrit": "अवहद्विनता कद्रूं सर्वांस्तान्गरुडोऽवहत् ।\nरविसामीप्यगाः सर्पास्तत्करैराहतास्तदा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003975028, "chapter_id": 23975, "verse_number": "३-१-३८-२९", "content_sanskrit": "अस्तौषीद्वज्रिणं कद्रूः सुतानां तापशांतये ।\nसर्वतापं जलासारैर्देवराजोऽप्यशामयत॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003975029, "chapter_id": 23975, "verse_number": "३-१-३८-३०", "content_sanskrit": "नीयमानास्तदा सर्पा गरुडेन बलीयसा ।\nगत्वा तं देशमचिरादवदन्विनतासुतम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003975030, "chapter_id": 23975, "verse_number": "३-१-३८-३१", "content_sanskrit": "वयं द्वीपांतरं गंतुं सर्वे द्रष्टुं कृतत्वराः ।\nवह त्वमस्मान्गरुड चेटीसुत ततः क्षणात्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003975031, "chapter_id": 23975, "verse_number": "३-१-३८-३२", "content_sanskrit": "ततो मातर मप्राक्षीद्विनतां गरुडो द्विजाः ।\nअहं कस्माद्वहामीमांस्त्वं चेमां वहसे सदा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003975032, "chapter_id": 23975, "verse_number": "३-१-३८-३३", "content_sanskrit": "चेटीपुत्रेति मामेते कि भणंति सरीसृपाः ।\nसर्वमेतद्वद त्वं मे मातस्तत्त्वेन पृच्छतः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003975033, "chapter_id": 23975, "verse_number": "३-१-३८-३४", "content_sanskrit": "पृष्टैवं जननी तेन गरुडं प्राब्रवीत्सुतम् ।\nभगिन्या क्रूरया पुत्र च्छलेनाहं पराजिता॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003975034, "chapter_id": 23975, "verse_number": "३-१-३८-३५", "content_sanskrit": "तस्या दासी भवाम्यद्य चेटीपुत्रस्ततो भवान् ।\nअतस्त्वं वहसे सर्पान्वहाम्येनामहं सदा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003975035, "chapter_id": 23975, "verse_number": "३-१-३८-३६", "content_sanskrit": "इत्यादि सर्ववृत्तांतमादितोऽस्मै न्यवेदयत् ।\nअथ तां गरुडोऽवा दीन्मातरं विनतासुतः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003975036, "chapter_id": 23975, "verse_number": "३-१-३८-३७", "content_sanskrit": "अस्माद्दास्याद्विमोक्षार्थं किं कार्यं ते मयाधुना ।\nइति पृष्टा सुतेनाथ विनता तमभाषत॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003975037, "chapter_id": 23975, "verse_number": "३-१-३८-३८", "content_sanskrit": "सर्पान्पृच्छस्व गरुड मम मातृविमोक्षणे ।\nयुष्माकं मातुः किं कार्यं मयेति वदताधुना॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003975038, "chapter_id": 23975, "verse_number": "३-१-३८-३९", "content_sanskrit": "इति मात्रा समुदितो गरुडः पन्नगान्प्रति ।\nगत्वाऽपृच्छद्विज श्रेष्ठास्तेऽप्येनमवदंस्तदा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003975039, "chapter_id": 23975, "verse_number": "३-१-३८-४०", "content_sanskrit": "यदा हरिष्यसे शीघ्रं सुधां त्वममरालयात् ।\nदास्यान्मुक्ता भवेन्माता वैनतेय तवाद्य हि॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003975040, "chapter_id": 23975, "verse_number": "३-१-३८-४१", "content_sanskrit": "ततो मातरमागम्य गरुडः प्रणतोऽब्रवीत् ।\nसुधामंब ममानेतुं गच्छतो भक्ष्यमर्पय॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003975041, "chapter_id": 23975, "verse_number": "३-१-३८-४२", "content_sanskrit": "इतीरिता सुतं प्राह माता तं विनता सुतम् ।\nसमुद्रमध्ये वर्तंते शबराः कतिचित्सुत॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003975042, "chapter_id": 23975, "verse_number": "३-१-३८-४३", "content_sanskrit": "तान्भक्षयित्वा शबरानमृतं त्वमिहानय ।\nतत्र कश्चिद्द्विजः कामी शवरीसंगकौतुकी॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003975043, "chapter_id": 23975, "verse_number": "३-१-३८-४४", "content_sanskrit": "त्यज तं ब्राह्मणं कंठं दहंतं ब्रह्मतेजसा ।\nपक्षादीनि तवांगानि पांतु देवा मरुन्मुखाः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003975044, "chapter_id": 23975, "verse_number": "३-१-३८-४५", "content_sanskrit": "इति स्वमातुराशीर्भिर्गरुडो वर्धितो ययौ ।\nशबरालयमभ्येत्य तस्य भक्षय तो मुखम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003975045, "chapter_id": 23975, "verse_number": "३-१-३८-४६", "content_sanskrit": "आवृतं प्राविशन्व्याधा वयांसीव दरीं गिरेः ।\nअथ स ब्राह्मणोऽप्यागात्तत्कंठं मुनिपुंगवाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003975046, "chapter_id": 23975, "verse_number": "३-१-३८-४७", "content_sanskrit": "कण्ठं दहन्तं विप्रं तमुवाच विनतासुतः ।\nविप्र पापोऽप्यवध्यो हि निर्याहि त्वमतो बहिः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003975047, "chapter_id": 23975, "verse_number": "३-१-३८-४८", "content_sanskrit": "एवमुक्तस्तदा विप्रो गरुडं प्रत्यभाषत ।\nकिराती मम भार्यापि निर्गंतव्या मया सह॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003975048, "chapter_id": 23975, "verse_number": "३-१-३८-४९", "content_sanskrit": "एवमस्त्विति तं विप्रमुवाच पतगेश्वरः ।\nततः स गरुडो विप्रमुज्जगार सभार्यकम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003975049, "chapter_id": 23975, "verse_number": "३-१-३८-५०", "content_sanskrit": "विप्रोऽप्यभीप्सितान्देशान्निषाद्या सह निर्ययौ ।\nशबरान्भक्षयित्वाऽथ गरुडः पक्षिणां वरः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003975050, "chapter_id": 23975, "verse_number": "३-१-३८-५१", "content_sanskrit": "आत्मनः पितरं वेगात्कश्यपं समुपेयिवान् ।\nकुत्र यासीति तत्पृष्टो गरुडस्तम भाषत॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003975051, "chapter_id": 23975, "verse_number": "३-१-३८-५२", "content_sanskrit": "मातुर्दास्यविमोक्षाय सुधामाहर्तुमागमम् ।\nबहून्किराताञ्जग्ध्वापि तृप्तिर्मम न जायते॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003975052, "chapter_id": 23975, "verse_number": "३-१-३८-५३", "content_sanskrit": "अपर्यंतक्षुधा ब्रह्मन्बाधते मामह र्निशम् ।\nतन्निवृत्तिप्रदं भक्ष्यं ममार्पय तपोधन॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003975053, "chapter_id": 23975, "verse_number": "३-१-३८-५४", "content_sanskrit": "येनाहं शक्नुयां तात सुधामाहर्तुमोजसा ।\nइतीरितः सुतं प्राह कश्यपो विनतोद्भवम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003975054, "chapter_id": 23975, "verse_number": "३-१-३८-५५", "content_sanskrit": "कश्यप उवाच ।\nमुनिर्विभावसुर्नाम्ना पुरासीत्तस्य सानुजः ।\nसुप्रतीक इति भ्राता तावुभौ वंशवैरिणौ॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003975055, "chapter_id": 23975, "verse_number": "३-१-३८-५६", "content_sanskrit": "अन्योन्यं शेपतुर्विप्रा महाक्रोधसमाकुलौ ।\nगजोऽभवत्सुप्रतीकः कूर्मोऽभूच्च विभावसुः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003975056, "chapter_id": 23975, "verse_number": "३-१-३८-५७", "content_sanskrit": "एवं वित्तविवादात्तौ शेपतुर्भ्रातरौ मिथः ।\nगजः षड्यो जनोच्छ्रायो द्विगुणायामसंयुतः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003975057, "chapter_id": 23975, "verse_number": "३-१-३८-५८", "content_sanskrit": "कूर्मस्त्रियोजनोच्छ्रयो दशयोजनविस्तृतः ।\nबद्धवैरावुभावेतौ सरस्यस्मिन्विहंगम॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003975058, "chapter_id": 23975, "verse_number": "३-१-३८-५९", "content_sanskrit": "पूर्ववैरमनुस्मृत्य युध्येते जेतुमिच्छया ।\nउभौ तौ भक्षयित्वा त्वं सुधामाहर तृप्तिमान्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003975059, "chapter_id": 23975, "verse_number": "३-१-३८-६०", "content_sanskrit": "एवं पित्रेरितः पक्षी गत्वा तद्गजकच्छपौ ।\nसमुद्धत्य महाकायौ महाबलपराक्रमौ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003975060, "chapter_id": 23975, "verse_number": "३-१-३८-६१", "content_sanskrit": "वहन्नखाभ्यां संतीर्थं विऌअंबाभिधमभ्यगात् ।\nतत्रागतं समालोक्य पक्षिराजं द्विजोसमाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003975061, "chapter_id": 23975, "verse_number": "३-१-३८-६२", "content_sanskrit": "तत्तीरजो महावृक्षो रोहिणाख्यो महोच्छ्रयः ।\nवैनतेयमिदं प्राह महाबलपराक्रमम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003975062, "chapter_id": 23975, "verse_number": "३-१-३८-६३", "content_sanskrit": "एनामारुह मच्छाखां शतयोजनमायताम् ।\nस्थित्वात्र गजकूर्मौ त्वं भक्षयस्व खगोत्तम॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003975063, "chapter_id": 23975, "verse_number": "३-१-३८-६४", "content_sanskrit": "इत्युक्तस्तरुणा पक्षी स तत्रास्ते मनोजवः ।\nतद्भारात्सा तरोः शाखा भग्नाऽभूद्द्विजसत्तमाः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003975064, "chapter_id": 23975, "verse_number": "३-१-३८-६५", "content_sanskrit": "वालखिल्यमुनींस्तस्मिल्लंबमानानधोमुखान् ।\nदृष्ट्वा तत्पातशंकावांस्तां शाखां गरुडोऽग्रहीत्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003975065, "chapter_id": 23975, "verse_number": "३-१-३८-६६", "content_sanskrit": "गजकूर्मो च तां शाखां गृहीत्वा यांतमं बरे ।\nपिता तस्याब्रवीत्तत्र गरुडं विनतासुतम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003975066, "chapter_id": 23975, "verse_number": "३-१-३८-६७", "content_sanskrit": "त्यजेमां निर्जने शैले शाखां तं विनतोद्भव ।\nइत्युक्तः स तथा गत्वा शाखां निष्पुरुषे नगे॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003975067, "chapter_id": 23975, "verse_number": "३-१-३८-६८", "content_sanskrit": "विन्यस्याभक्षयत्पक्षी तौ तदा गजकच्छपौ ।\nअथोत्पातः समभवत्तस्मिन्नवसरे दिवि॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003975068, "chapter_id": 23975, "verse_number": "३-१-३८-६९", "content_sanskrit": "दृष्ट्वोत्पातं बलारातिः पप्रच्छ स्वपुरोहितम् ।\nउत्पातकारणं जीव किमत्रेति पुनःपुनः ।\nबृहस्पतिस्तदा शक्रं प्रोवाच द्विजसत्तमाः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003975069, "chapter_id": 23975, "verse_number": "३-१-३८-७०", "content_sanskrit": "बृहस्पतिरुवाच ।\nकाश्यपो हि मुनिः पूर्वमयजत्क्रतुना हरे॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003975070, "chapter_id": 23975, "verse_number": "३-१-३८-७१", "content_sanskrit": "सर्वान्नृषीन्सुरान्सिद्धान्यक्षान्गंधर्वकिन्नरान् ।\nयज्ञसंभारसिद्ध्यर्थं प्रेषयामास स द्विजाः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003975071, "chapter_id": 23975, "verse_number": "३-१-३८-७२", "content_sanskrit": "वालखिल्यान्ससंभारान्ह्रस्वानंगुष्ठमात्रकान् ।\nमज्जतो गोष्पदजले दृष्ट्वा हसितवान्भवान्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003975072, "chapter_id": 23975, "verse_number": "३-१-३८-७३", "content_sanskrit": "भवतावमताः क्रुद्धा वालखिल्यास्तदा हरे ।\nजुहुवुर्यज्ञवह्नौ ते क्रोधेन ज्वलिताननाः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003975073, "chapter_id": 23975, "verse_number": "३-१-३८-७४", "content_sanskrit": "देवेंद्रभयदः शत्रुः कश्यपस्य सुतोऽस्त्विति ।\nतस्य पुत्रोऽद्य गरुडः सुधाहरणकौतुकी॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003975074, "chapter_id": 23975, "verse_number": "३-१-३८-७५", "content_sanskrit": "समागच्छति तद्धेतुरयमुत्पात आगतः ।\nइत्युक्तः सोऽब्रवीदिंद्रो देवानग्निपुरोगमान्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003975075, "chapter_id": 23975, "verse_number": "३-१-३८-७६", "content_sanskrit": "सुधामाहर्तुमायाति पक्षी सा रक्ष्यतामिति ।\nइतींद्रप्रेरिता देवा ररक्षुः सायुधाः सुधाम्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003975076, "chapter_id": 23975, "verse_number": "३-१-३८-७७", "content_sanskrit": "पक्षिराजस्तदाभ्यागाद्देवानायुधधारिणः ।\nमहाबलं ते गरुडं दृष्ट्वाऽकम्पंत वै सुराः॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003975077, "chapter_id": 23975, "verse_number": "३-१-३८-७८", "content_sanskrit": "गरुडस्य सुराणां च ततो युद्धमभून्महत् ।\nअखंडि पक्षितुण्डेन भौवनोऽमृतपालकः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003975078, "chapter_id": 23975, "verse_number": "३-१-३८-७९", "content_sanskrit": "तदा निजघ्नुगर्रुडं देवाः शस्त्रैरनेकशः ।\nअतीव गरुडो देवैर्बाधितः शस्त्रपाणिभिः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003975079, "chapter_id": 23975, "verse_number": "३-१-३८-८०", "content_sanskrit": "पक्षाभ्यामाक्षिपद्दूरे देवानग्निपुरोगमान् ।\nतत्पक्षविक्षिता देवास्तदा परमकोपनाः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003975080, "chapter_id": 23975, "verse_number": "३-१-३८-८१", "content_sanskrit": "नाराचान्भिंदि पालांश्च नानाशस्त्राणि चाक्षिपन् ।\nततस्तु गरुडो वेगाद्देवदृष्टिविलोपिनीम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003975081, "chapter_id": 23975, "verse_number": "३-१-३८-८२", "content_sanskrit": "धूलिमुत्थापयामास पक्षाभ्यां विनतासुतः॥ वायुना  ।\nशमयामासुस्तान्पांसूंस्त्रिदशोत्तमाः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003975082, "chapter_id": 23975, "verse_number": "३-१-३८-८३", "content_sanskrit": "रुद्रान्वसूंस्तथादित्यान्मरुतोऽन्यान्सुरांस्तथा ।\nगरुडः पक्षतुंडाभ्यां व्यथितानकरोद्द्विजाः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003975083, "chapter_id": 23975, "verse_number": "३-१-३८-८४", "content_sanskrit": "पलायितेषु देवेषु सोऽद्राक्षीज्ज्वलनं पुरः ।\nज्वलंतं परितस्त्वग्निं शमापयितुमुद्ययौ॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003975084, "chapter_id": 23975, "verse_number": "३-१-३८-८५", "content_sanskrit": "स सहस्रमुखो भूत्वा तैः पिबञ्छतशो नदीः ।\nतमग्निं नाशयामास तैः पयोभिस्त्वरान्वितः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003975085, "chapter_id": 23975, "verse_number": "३-१-३८-८६", "content_sanskrit": "सितधारं भ्रमच्चक्रं सुधारक्षकमंतिके ।\nदृष्ट्वा तदरिरंध्रेण संक्षिप्तांगोतराविशत्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003975086, "chapter_id": 23975, "verse_number": "३-१-३८-८७", "content_sanskrit": "ततो ददर्श द्वौ सर्पो व्यक्तास्यौ भीषणाकृती ।\nयाभ्यां दृष्टोपि भस्म स्यात्तौ सर्पौ गरुडस्तदा॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003975087, "chapter_id": 23975, "verse_number": "३-१-३८-८८", "content_sanskrit": "आच्छिद्य पक्षतुंडाभ्यां गृहीत्वाऽमृतमुद्ययौ ।\nयंत्रमुत्पाट्य चोद्यंतं गरुडं प्राह माधवः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003975088, "chapter_id": 23975, "verse_number": "३-१-३८-८९", "content_sanskrit": "तव तुष्टोऽस्मि पक्षीश वरं वरय सुव्रत ।\nअथ पक्षी तमाह स्म कमलानायकं हरिम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003975089, "chapter_id": 23975, "verse_number": "३-१-३८-९०", "content_sanskrit": "तवोपरि स्थितिर्मे स्यान्मा भूतां च जरामृती ।\nतथास्त्विति हरिः प्राह वरं मद्व्रियतामिति॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003975090, "chapter_id": 23975, "verse_number": "३-१-३८-९१", "content_sanskrit": "इत्युक्तस्तं हरिः प्राह मम त्वं वाहनं भव ।\nस्यंदनोपरि केतुश्च मम त्वं विनतासुत॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003975091, "chapter_id": 23975, "verse_number": "३-१-३८-९२", "content_sanskrit": "तथास्त्विति खगोप्याह कमलापतिमच्युतम् ।\nहृतामृतं खगं श्रुत्वा तत आखंडलो जवात्॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003975092, "chapter_id": 23975, "verse_number": "३-१-३८-९३", "content_sanskrit": "अभिद्रुत्याशु कुलिशं पक्षे चिक्षेप पक्षिणः ।\nततो विहस्य गरुडः पाकशासनमब्रवीत्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003975093, "chapter_id": 23975, "verse_number": "३-१-३८-९४", "content_sanskrit": "कुलिशस्य निपातान्मे न हरे कापि वेदना ।\nसफलो वज्रपातस्ते भूयाच्च सुरनायक॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003975094, "chapter_id": 23975, "verse_number": "३-१-३८-९५", "content_sanskrit": "इतीरयन्पत्रमेकं व्यसृजत्पक्षतस्तदा ।\nशोभनं पर्णमस्येति सुपर्ण इति सोभ वत्॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003975095, "chapter_id": 23975, "verse_number": "३-१-३८-९६", "content_sanskrit": "तस्मिन्सुपर्णे हेमाभे सर्वे विस्मयमाययुः ।\nततस्तु गरुडः शक्रमब्रवीद्द्विजपुंगवाः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003975096, "chapter_id": 23975, "verse_number": "३-१-३८-९७", "content_sanskrit": "भवता साकमखिलं जगदेतच्चराचरम् ।\nदेवेंद्र सततं वोढुममोघा शक्तिरस्ति मे॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003975097, "chapter_id": 23975, "verse_number": "३-१-३८-९८", "content_sanskrit": "नाखण्डलसहस्रं मे रणे लभ्यं हरे भवेत् ।\nइति ब्रुवाणं गरुडमब्रवीत्पाकशासनः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003975098, "chapter_id": 23975, "verse_number": "३-१-३८-९९", "content_sanskrit": "किं तेऽमृतेन कार्यं स्याद्दीयताममृतं मम ।\nइमां सुधां भवान्दद्याद्येभ्यो हि विनतोद्भव॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003975099, "chapter_id": 23975, "verse_number": "३-१-३८-१००", "content_sanskrit": "तेऽधुनाऽमृतपानेन जरामरणवर्जिताः ।\nअस्मद्भ्योऽधिकवीर्याः स्युर्बाधेरंस्त्रिदशांस्तथा॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003975100, "chapter_id": 23975, "verse_number": "३-१-३८-१०१", "content_sanskrit": "इति ब्रुवंतं देवेन्द्रं गरुडोऽप्यब्रवीद्द्विजाः ।\nयत्रैतत्स्थापयिष्यामि तत्रागत्य भवानिदम्॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003975101, "chapter_id": 23975, "verse_number": "३-१-३८-१०२", "content_sanskrit": "गृह्णातु झटितीत्युक्तो गरुडं प्राह वृत्रहा ।\nप्रीतोऽहं तव दास्यामि वरं वृणु महामते॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003975102, "chapter_id": 23975, "verse_number": "३-१-३८-१०३", "content_sanskrit": "इत्युक्तवन्तं गरुडः पाकशासनमब्रवीत् ।\nदास्ये छलप्रयोक्तारो मम मातुः सरीसृपाः॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003975103, "chapter_id": 23975, "verse_number": "३-१-३८-१०४", "content_sanskrit": "भक्ष्या भवंतु नित्यं मे पाकशासन वृत्रहन् ।\nइति तेनेरितः शकस्तथास्त्वित्यवदच्च तम्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003975104, "chapter_id": 23975, "verse_number": "३-१-३८-१०५", "content_sanskrit": "अथायं गरुडो विप्रा धारयन्नमृतं ययौ ।\nयांतं तमनुयाति स्म गरुडं पाकशासनः॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003975105, "chapter_id": 23975, "verse_number": "३-१-३८-१०६", "content_sanskrit": "वेगेन स द्विजश्रेष्ठाः सुधाहरणकौतुकी ।\nमातुरभ्याशमागत्य सर्पान्प्राह स पक्षिराट्॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003975106, "chapter_id": 23975, "verse_number": "३-१-३८-१०७", "content_sanskrit": "कुशेषु न्यस्यते सर्पास्सुधैवमधुना मया ।\nस्नात्वा तद्भुङ्ध्वममृतं शुचयः सुसमाहिताः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003975107, "chapter_id": 23975, "verse_number": "३-१-३८-१०८", "content_sanskrit": "मोक्षोऽपि मम मातुः स्याद्दासीभावाद्धि पन्नगाः ।\nतथास्त्वित्यवदन्सर्पा गरुडं विनतासुतम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003975108, "chapter_id": 23975, "verse_number": "३-१-३८-१०९", "content_sanskrit": "मुक्ता तदैव विनता दासीभावाद्द्विजोत्तमाः ।\nसर्पास्तेऽमृतभक्षार्थं स्नातुं सर्वे ययुस्तदा॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003975109, "chapter_id": 23975, "verse_number": "३-१-३८-११०", "content_sanskrit": "तस्मिन्नवसरे शक्रस्तामादाय सुधां ययौ ।\nस्नात्वागत्य भुजंगास्ते तत्रादृष्ट्वा तदा सुधाम्॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003975110, "chapter_id": 23975, "verse_number": "३-१-३८-१११", "content_sanskrit": "जिह्वाभिर्लिलिहुर्द र्भानेषु न्यस्ता सुधेति हि ।\nतदाप्रभृति सर्पाणां जिह्वा दर्भाग्रपाटिताः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003975111, "chapter_id": 23975, "verse_number": "३-१-३८-११२", "content_sanskrit": "द्विधाभवन्मुनिश्रेष्ठा द्विजिह्वास्तेन ते स्मृताः ।\nसुधासंयोगतो दर्भाः प्रय युश्च पवित्रताम्॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003975112, "chapter_id": 23975, "verse_number": "३-१-३८-११३", "content_sanskrit": "मोचयित्वा च गरुडो दासीभावात्स्वमातरम् ।\nशशापकुपितः कद्रूं छद्मना जितमातरम्॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003975113, "chapter_id": 23975, "verse_number": "३-१-३८-११४", "content_sanskrit": "कद्रूस्त्वं जननीं यन्मे छलेन जितवत्यसि ।\nभर्तुस्त्वं परिचर्यायामतो नार्हा भविष्यसि॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003975114, "chapter_id": 23975, "verse_number": "३-१-३८-११५", "content_sanskrit": "शप्त्वैवं गरुडः कद्रूं प्रययौ स यथेच्छया ।\nकद्रूश्च विनता चोभे ययतुर्भर्तुरंतिकम्॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003975115, "chapter_id": 23975, "verse_number": "३-१-३८-११६", "content_sanskrit": "कश्यपो विमुखस्तत्र कद्रूं कोपादथाब्रवीत् ।\nयस्माच्छलेन विनतां कद्रूर्निर्जितवत्यसि॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003975116, "chapter_id": 23975, "verse_number": "३-१-३८-११७", "content_sanskrit": "अतो मत्परिचर्यायां न योग्यासि दुरात्मिके ।\nस्त्रियं वा पुरुषं वापि नारी वा पुरुषोऽपि वा॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003975117, "chapter_id": 23975, "verse_number": "३-१-३८-११८", "content_sanskrit": "छलाद्विजयते योऽसौ स महापातकी भवेत् ।\nछलाद्विजयिना सार्धं संभाष्य ब्रह्महा भवेत्॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003975118, "chapter_id": 23975, "verse_number": "३-१-३८-११९", "content_sanskrit": "स्तेयी सुरापी विज्ञेयो गुरुदाररतश्च सः ।\nसंसर्गदोषदुष्टश्च मुनिभिः परिकीर्त्यते॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003975119, "chapter_id": 23975, "verse_number": "३-१-३८-१२०", "content_sanskrit": "त्वया संभाषणाद्दोषो मम स्यान्नरकप्रदः ।\nतस्मात्प्रयाहि कद्रूस्त्वं मत्समीपाद्धि दारुणे॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003975120, "chapter_id": 23975, "verse_number": "३-१-३८-१२१", "content_sanskrit": "छलजेत्रा सपंक्तौ यो भुंजीत मनुजो भुवि ।\nतेन संभाषणात्सद्यः पतेद्धि नरकार्णवे॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003975121, "chapter_id": 23975, "verse_number": "३-१-३८-१२२", "content_sanskrit": "विलोक्य च्छलजेतारं तस्य पापस्य शांतये ।\nआदित्यं वा जलं वापि पावकं वा विलोकयेत्॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003975122, "chapter_id": 23975, "verse_number": "३-१-३८-१२३", "content_sanskrit": "छलजेता यत्र तिष्ठेदाश्रमेऽपि गृहेऽपिवा ।\nवस्तव्यं न हि तत्रान्यैर्वसन्नरकमश्नुते॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003975123, "chapter_id": 23975, "verse_number": "३-१-३८-१२४", "content_sanskrit": "अतो निर्याहि निर्याहि मम त्वं दृष्टिमार्गतः ।\nस्वाश्रमात्सरलामेनां विनतां जितवत्यसि॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003975124, "chapter_id": 23975, "verse_number": "३-१-३८-१२५", "content_sanskrit": "इति धिक्कृत्य सहसा कद्रूं तां कश्यपस्तदा ।\nविनतां स्वच्छशीलां तां स्वीचकार महामतिः॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003975125, "chapter_id": 23975, "verse_number": "३-१-३८-१२६", "content_sanskrit": "कद्रूरित्थं सपरुषं कथिता कश्यपेन सा ।\nरुदंती भृशदुःखार्ता पादयोस्तस्य चापतत्॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003975126, "chapter_id": 23975, "verse_number": "३-१-३८-१२७", "content_sanskrit": "पतितां पादयोर्दृष्ट्वा कश्यपो मुनिपुंगवः ।\nन जग्राहैव कद्रूं तां स्मरन्पापं तया कृतम्॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003975127, "chapter_id": 23975, "verse_number": "३-१-३८-१२८", "content_sanskrit": "ततः प्रणम्य विनता कश्यपं वाक्यमब्रवीत् ।\nभगवन्भगिनीमेनां स्वीकुरुष्व कृपानिधे॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7003975128, "chapter_id": 23975, "verse_number": "३-१-३८-१२९", "content_sanskrit": "अज्ञानान्मुग्धया पापं कद्र्वा यदधुना कृतम् ।\nक्षंतुमर्हसि तत्सर्वं दयाशीला हि साधवः॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7003975129, "chapter_id": 23975, "verse_number": "३-१-३८-१३०", "content_sanskrit": "जनन्या गरुडस्यैव कथितः कश्यपो मुनिः ।\nउवाच विनते नैनां विना पापस्य निष्कृतिम्॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7003975130, "chapter_id": 23975, "verse_number": "३-१-३८-१३१", "content_sanskrit": "ग्रहीष्यामि दुराचारां त्रिस्त्वां शपथयाम्यहम् ।\nकश्यपस्य वचः श्रुत्वा विनता पुनरब्रवीत्॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7003975131, "chapter_id": 23975, "verse_number": "३-१-३८-१३२", "content_sanskrit": "भगिन्या मम पापस्य ब्रह्मंस्त्वं ब्रूहि निष्कृतिम् ।\nयेनेयं परिचर्यायां तव योग्या भविष्यति॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7003975132, "chapter_id": 23975, "verse_number": "३-१-३८-१३३", "content_sanskrit": "तयैवमुदितो विप्रा मारीचः कश्यपस्तदा ।\nध्यात्वा मुहूर्तं मनसा पश्चादिदमभाषत॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7003975133, "chapter_id": 23975, "verse_number": "३-१-३८-१३४", "content_sanskrit": "दक्षिणांबुनिधेस्तीरे फुल्लग्रामे विमुक्तिदे ।\nअस्ति क्षीरसरोनाम तीर्थं पापविनाशनम्॥ १६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7003975134, "chapter_id": 23975, "verse_number": "३-१-३८-१३५", "content_sanskrit": "तत्तीर्थस्नानमात्रेण दोषश्चास्या विनश्यति ।\nप्रायश्चित्तायुतेनापि तत्तीर्थे मज्जनं विना॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7003975135, "chapter_id": 23975, "verse_number": "३-१-३८-१३६", "content_sanskrit": "न नश्यत्येष दोषो ऽस्यास्तदेषा यातु तत्सरः ।\nभर्त्रैवमुदिते कद्रूस्तं प्रणम्य द्विजोत्तमम्॥ १३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7003975136, "chapter_id": 23975, "verse_number": "३-१-३८-१३७", "content_sanskrit": "तत्क्षणात्प्रययौ क्षीरं सरः पुत्रसहायिनी ।\nसा कद्रूः पुत्र सहिता गत्वा कतिपयैर्दिनैः॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7003975137, "chapter_id": 23975, "verse_number": "३-१-३८-१३८", "content_sanskrit": "प्राप्य क्षीरसरः पुण्यं प्रयता विजितेंद्रिया ।\nसस्नौ नियमपूर्वं च संकल्प्य क्षीरकुंडके॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7003975138, "chapter_id": 23975, "verse_number": "३-१-३८-१३९", "content_sanskrit": "उपोष्य त्रिदिनं सस्नौ तस्मिन्क्षीरसरोजले ।\nचतुर्थे दिवसे तस्यां कुर्वत्यां स्नानमादरात् ।\nअदेहा व्योमगावाणी समुत्तस्थौ द्विजोत्तमाः॥ १४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7003975139, "chapter_id": 23975, "verse_number": "३-१-३८-१४०", "content_sanskrit": "अशरीरिण्युवाच ।\nकद्रूस्त्वं मज्जनादत्र च्छलजेतृत्वदोषतः॥ १४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7003975140, "chapter_id": 23975, "verse_number": "३-१-३८-१४१", "content_sanskrit": "विमुक्ता भर्तृशुश्रूषायोग्या चासि न संशयः ।\nशापोपि गरुडोक्तस्ते लयं यातोऽत्र मज्जनात्॥ १४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7003975141, "chapter_id": 23975, "verse_number": "३-१-३८-१४२", "content_sanskrit": "गच्छ भर्तृसकाशं त्वं सोऽपि त्वां स्वीकरिष्यति ।\nइत्युक्त्वा विररामाथ व्योमवागशरीरिणी॥ १४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7003975142, "chapter_id": 23975, "verse_number": "३-१-३८-१४३", "content_sanskrit": "तस्यै वाचे नमस्कृत्य कद्रूः सा प्रीतमानसा ।\nतीर्थं प्रदक्षिणीकृत्य नत्वा पुत्रसमन्विता॥ १४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7003975143, "chapter_id": 23975, "verse_number": "३-१-३८-१४४", "content_sanskrit": "प्रययौ भर्तुरभ्याशं तच्छुश्रूषणकौतुकात् ।\nआगतातां समालोक्य स्नातां क्षीरसरोजले॥ १४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7003975144, "chapter_id": 23975, "verse_number": "३-१-३८-१४५", "content_sanskrit": "ज्ञात्वा विधूतपापां च कश्यपः स समाधिना ।\nअंगीचकार पत्नीं तामात्मशुश्रूषणोचि ताम्॥ १४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7003975145, "chapter_id": 23975, "verse_number": "३-१-३८-१४६", "content_sanskrit": "एवं वः कथितं विप्राः कद्रूपापविमोक्षणम् ।\nमज्जनान्मुक्तिदं पुंसां पुण्ये क्षीरसरोजले॥ १४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7003975146, "chapter_id": 23975, "verse_number": "३-१-३८-१४७", "content_sanskrit": "यः शृणोतीममध्यायं पठते वापि मानवः ।\nस क्षीरकुंडस्नानस्य लभते फलमुत्तमम्॥ १४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7003975147, "chapter_id": 23975, "verse_number": "३-१-३८-१४८", "content_sanskrit": "अश्वमेधादियज्ञानां समग्रं फलमश्नुते ।\nगंगादिसर्वतीर्थेषु स स्नातो भवति ध्रुवम्॥ १४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7003975148, "chapter_id": 23975, "verse_number": "३-१-३८-१४९", "content_sanskrit": "यः पठेदिममध्यायं क्षीरकुंडप्रशंसनम् ।\nगोसहस्रप्रदातॄणां प्राप्नोत्यविकलं फलम्॥ १५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}]