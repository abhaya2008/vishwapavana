[{"id": 6000317000, "chapter_id": 10317, "verse_number": null, "content_sanskrit": "षोडशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000317001, "chapter_id": 10317, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.001.m4a", "display_order": 2}, {"id": 6000317002, "chapter_id": 10317, "verse_number": "११-१६-१", "content_sanskrit": "त्वं ब्रह्म परमं साक्षादनाद्यन्तमपावृतम्।\nसर्वेषामपि भावानां प्राणः स्थित्यप्ययोद्भवः॥ ११/१६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.002.m4a", "display_order": 3, "topics": [{"text": "हरेर्विभूतिरूपवर्णनम्", "range": "१–४४"}]}, {"id": 6000317003, "chapter_id": 10317, "verse_number": "११-१६-२", "content_sanskrit": "उच्चावचेषु भूतेषु दुर्ज्ञेयमकृतात्मभिः।\nउपासते त्वां भगवन् याथातथ्येन ब्राह्मणाः॥ ११/१६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.003.m4a", "display_order": 4}, {"id": 6000317004, "chapter_id": 10317, "verse_number": "११-१६-३", "content_sanskrit": "येषु येषु च भावेषु यथा त्वां परमर्षयः।\nउपासीनाः प्रपद्यन्ते संसिद्धिं तद् वदस्व मे॥ ११/१६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.004.m4a", "display_order": 5}, {"id": 6000317005, "chapter_id": 10317, "verse_number": "११-१६-४", "content_sanskrit": "गूढश्चरसि भूतेषु भूतात्मा भूतभावनः।\nन त्वां पश्यन्ति भूतानि पश्यन्तं मोहितानि ते॥ ११/१६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.005.m4a", "display_order": 6}, {"id": 6000317006, "chapter_id": 10317, "verse_number": "११-१६-५", "content_sanskrit": "याः काश्च भूमौ दिवि वै रसायां विभूतयो दिक्षु महाविभूतेः।\nता मह्यमाख्याह्यनुभावितास्ते नमामि ते तीर्थपदाङ्घ्रिपद्मम्॥ ११/१६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.006.m4a", "display_order": 7}, {"id": 6000317007, "chapter_id": 10317, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.007.m4a", "display_order": 8}, {"id": 6000317008, "chapter_id": 10317, "verse_number": "११-१६-६", "content_sanskrit": "एवमेतदहं पृष्टः प्रश्नं प्रश्नविदां वर।\nयुयुत्सुना विशसने सपत्नैरर्जुनेन वै॥ ११/१६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.008.m4a", "display_order": 9}, {"id": 6000317009, "chapter_id": 10317, "verse_number": "११-१६-७", "content_sanskrit": "ज्ञात्वा ज्ञातिवधं गर्ह्यमधर्म्यं राज्यहैतुकम्।\nततो निवृत्तो हन्ताऽहं हतोऽयमिति लौकिकः॥ ११/१६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.009.m4a", "display_order": 10}, {"id": 6000317010, "chapter_id": 10317, "verse_number": "११-१६-८", "content_sanskrit": "स तदा पुरुषव्याघ्रो युक्त्या मे प्रतिबोधितः।\nअभ्यभाषत मामेवं यथा त्वं रणमूर्धनि॥ ११/१६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.010.m4a", "display_order": 11}, {"id": 6000317011, "chapter_id": 10317, "verse_number": "११-१६-९", "content_sanskrit": "अहमात्मोद्धवामीषां भूतानां सुहृदीश्वरः।\nअहं सर्वाणि भूतानि तेषां स्थित्युद्भवाप्ययः॥ ११/१६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.011.m4a", "display_order": 12}, {"id": 6000317012, "chapter_id": 10317, "verse_number": "११-१६-१०", "content_sanskrit": "अहं गतिर्गतिमतां कालः कलयतामहम्।\nगुणानामप्यहं सौम्यं गुणिन्यौत्पत्तिको गुणः॥ ११/१६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.012.m4a", "display_order": 13}, {"id": 6000317013, "chapter_id": 10317, "verse_number": "११-१६-११", "content_sanskrit": "गुणिनामप्यहं सूत्रं महतां च महानहम्।\nसूक्ष्माणामप्यहं जीवो दुर्जयानामहं मनः॥ ११/१६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.013.m4a", "display_order": 14}, {"id": 6000317014, "chapter_id": 10317, "verse_number": "११-१६-१२", "content_sanskrit": "हिरण्यगर्भो देवानां मन्त्राणां प्रणवस्‍त्रिवृत्।\nअक्षराणामकारोऽस्मि पदानि च्छन्दसामहम्॥ ११/१६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.014.m4a", "display_order": 15}, {"id": 6000317015, "chapter_id": 10317, "verse_number": "११-१६-१३", "content_sanskrit": "इन्द्रोऽहं सर्वदेवानां वसूनामस्मि हव्यवाट्।\nआदित्यानामहं विष्णू रुद्राणां नीललोहितः॥ ११/१६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.015.m4a", "display_order": 16}, {"id": 6000317016, "chapter_id": 10317, "verse_number": "११-१६-१४", "content_sanskrit": "ब्रह्मर्षीणां भृगुरहं राजर्षीणामहं मनुः।\nदेवर्षीणां नारदोऽहं हविर्धान्यस्मि धेनुषु॥ ११/१६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.016.m4a", "display_order": 17}, {"id": 6000317017, "chapter_id": 10317, "verse_number": "११-१६-१५", "content_sanskrit": "सिद्धेश्वराणां कपिलः सुपर्णोऽहं पतत्रिणाम्।\nप्रजापतीनां दक्षोऽहं पितॄणामहमर्यमा॥ ११/१६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.017.m4a", "display_order": 18}, {"id": 6000317018, "chapter_id": 10317, "verse_number": "११-१६-१६", "content_sanskrit": "मां विद्ध्युद्धव दैत्यानां प्रह्लादमसुरेश्वरम्।\nसोमं नक्षत्रौषधीनां धनेशं यक्षरक्षसाम्॥ ११/१६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.018.m4a", "display_order": 19}, {"id": 6000317019, "chapter_id": 10317, "verse_number": "११-१६-१७", "content_sanskrit": "ऐरावतं गजेन्द्राणां यादसां वरुणं प्रभुम्।\nतपतां द्युमतां सूर्यं मनुष्याणां च भूपतिम्॥ ११/१६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.019.m4a", "display_order": 20}, {"id": 6000317020, "chapter_id": 10317, "verse_number": "११-१६-१८", "content_sanskrit": "उच्चैःश्रवास्तुरङ्गाणां धातूनामस्मि काञ्चनम्।\nयमः संयमतां चाहं सर्पाणामस्मि वासुकिः॥ ११/१६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.020.m4a", "display_order": 21}, {"id": 6000317021, "chapter_id": 10317, "verse_number": "११-१६-१९", "content_sanskrit": "नागेन्द्राणामनन्तोऽहं मृगेन्द्रः शृङ्गिदंष्ट्रिणाम्।\nआश्रमाणां तुरीयोऽहं वर्णानां प्रथमोऽनघ॥ ११/१६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.021.m4a", "display_order": 22}, {"id": 6000317022, "chapter_id": 10317, "verse_number": "११-१६-२०", "content_sanskrit": "तीर्थानां स्रोतसां गङ्गा समुद्रः सरसामहम्।\nआयुधानां धनुरहं त्रिपुरघ्नो धनुष्मताम्॥ ११/१६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.022.m4a", "display_order": 23}, {"id": 6000317023, "chapter_id": 10317, "verse_number": "११-१६-२१", "content_sanskrit": "गिरीणामस्म्यहं मेरुर्गहनानां हिमालयः।\nवनस्पतीनामश्वत्थ ओषधीनामहं यवः॥ ११/१६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.023.m4a", "display_order": 24}, {"id": 6000317024, "chapter_id": 10317, "verse_number": "११-१६-२२", "content_sanskrit": "पुरोधसां वसिष्ठोऽहं ब्रह्मिष्ठानां बृहस्पतिः।\nस्कन्दोऽहं सर्वसेनान्यामग्रण्यां भगवानजः॥ ११/१६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.024.m4a", "display_order": 25}, {"id": 6000317025, "chapter_id": 10317, "verse_number": "११-१६-२३", "content_sanskrit": "यज्ञानां ब्रह्मयज्ञोऽहं व्रतानामविहिंसनम्।\nवाय्वग्न्यर्काम्बुवागात्मा शुचीनामप्यहं शुचिः॥ ११/१६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.025.m4a", "display_order": 26}, {"id": 6000317026, "chapter_id": 10317, "verse_number": "११-१६-२४", "content_sanskrit": "योगानामात्मसंरोधो मन्त्रोऽस्मि विजिगीषताम्।\nआन्वीक्षिकी कौशलानां विकल्पः ख्यातिवादिनाम्॥ ११/१६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.026.m4a", "display_order": 27}, {"id": 6000317027, "chapter_id": 10317, "verse_number": "११-१६-२५", "content_sanskrit": "स्‍त्रीणां तु शतरूपाऽहं पुंसां स्वायम्भुवो मनुः।\nनारायणो मुनीनां च कुमारो ब्रह्मचारिणाम्॥ ११/१६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.027.m4a", "display_order": 28}, {"id": 6000317028, "chapter_id": 10317, "verse_number": "११-१६-२६", "content_sanskrit": "धर्माणामस्मि संत्यागः क्षेमाणामबहिर्मतिः।\nगुह्यानां सततं मौनं मिथुनानां पुमानहम्॥ ११/१६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.028.m4a", "display_order": 29}, {"id": 6000317029, "chapter_id": 10317, "verse_number": "११-१६-२७", "content_sanskrit": "संवत्सरोऽस्म्यनिमिषामृतूनां मधुमाधवौ।\nमासानां मार्गशीर्षोऽहं नक्षत्राणां तथाऽभिजित्॥ ११/१६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.029.m4a", "display_order": 30}, {"id": 6000317030, "chapter_id": 10317, "verse_number": "११-१६-२८", "content_sanskrit": "अहं युगानां च कृतं धीराणां देवलोऽसितः।\nद्वैपायनोऽस्मि व्यासानां कवीनां काव्य आत्मवान्॥ ११/१६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.030.m4a", "display_order": 31}, {"id": 6000317031, "chapter_id": 10317, "verse_number": "११-१६-२९", "content_sanskrit": "वासुदेवो भगवतां त्वं तु भागवतेष्वहम्।\nकिम्पुरुषाणां च हनूमान् विद्याध्राणां सुदर्शनः॥ ११/१६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.031.m4a", "display_order": 32}, {"id": 6000317032, "chapter_id": 10317, "verse_number": "११-१६-३०", "content_sanskrit": "रत्नानां पद्मरागोऽस्मि पद्मकोशस्तु पेशसाम्।\nकुशोऽस्मि दर्भजातीनां गव्यमाज्यं हविष्ष्वहम्॥ ११/१६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.032.m4a", "display_order": 33}, {"id": 6000317033, "chapter_id": 10317, "verse_number": "११-१६-३१", "content_sanskrit": "व्यवसायिनामहं लक्ष्मीः कितवानां छलग्रहः।\nतितिक्षाऽस्मि तितिक्षूणां सत्त्वं सत्त्ववतामहम्॥ ११/१६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.033.m4a", "display_order": 34}, {"id": 6000317034, "chapter_id": 10317, "verse_number": "११-१६-३२", "content_sanskrit": "ओजः सहोबलवतां कर्माहं विद्धि सात्त्वताम्।\nसात्त्वतां नवमूर्तीनामादिमूर्तिरहं पुरा॥ ११/१६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.034.m4a", "display_order": 35}, {"id": 6000317035, "chapter_id": 10317, "verse_number": "११-१६-३३", "content_sanskrit": "विश्वावसुः पूर्वचित्तिर्गन्धर्वाप्सरसामहम्।\nभूधराणामहं स्थैर्यं गन्धमात्रमहं भुवः॥ ११/१६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.035.m4a", "display_order": 36}, {"id": 6000317036, "chapter_id": 10317, "verse_number": "११-१६-३४", "content_sanskrit": "अपां रसश्च परमस्तेजिष्ठानां विभावसुः।\nप्रभा सूर्येन्दुताराणां शब्दोऽहं नभसः परः॥ ११/१६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.036.m4a", "display_order": 37}, {"id": 6000317037, "chapter_id": 10317, "verse_number": "११-१६-३५", "content_sanskrit": "ब्रह्मण्यानां बलिरहं वीराणामहमर्जुनः।\nभूतानां स्थितिरुत्पत्तिरहं वै प्रतिसङ्क्रमः॥ ११/१६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.037.m4a", "display_order": 38}, {"id": 6000317038, "chapter_id": 10317, "verse_number": "११-१६-३६", "content_sanskrit": "गत्युक्त्युत्सर्गोपादानमानन्दस्पर्शलक्षणम्।\nआस्वादश्रुत्यवघ्राणमहं सर्वेन्द्रियेन्द्रियम्॥ ११/१६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.038.m4a", "display_order": 39}, {"id": 6000317039, "chapter_id": 10317, "verse_number": "११-१६-३७", "content_sanskrit": "पृथिवी वायुराकाश आपो ज्योतिरहं महान्। विकारः पुरुषोऽव्यक्तं रजः सत्त्वं तमः परः।\nअहमेतत्प्रसङ्ख्यानं ज्ञानं तत्वविनिश्चयः॥ ११/१६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.039.m4a", "display_order": 40}, {"id": 6000317040, "chapter_id": 10317, "verse_number": "११-१६-३८", "content_sanskrit": "मयेश्वरेण जीवेन गुणेन गुणिना विना।\nसर्वात्मनापि सर्वेण न भावो विद्यते क्‍वचित्॥ ११/१६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.040.m4a", "display_order": 41}, {"id": 6000317041, "chapter_id": 10317, "verse_number": "११-१६-३९", "content_sanskrit": "सङ्ख्यानं परमाणूनां कालेन क्रियते मया।\nन तथा मे विभूतीनां सृजतोऽण्डानि कोटिशः॥ ११/१६/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.041.m4a", "display_order": 42}, {"id": 6000317042, "chapter_id": 10317, "verse_number": "११-१६-४०", "content_sanskrit": "तेजः श्रीः कान्तिरैश्वर्यं ह्रीस्त्यागः सौभगं भगः।\nवीर्यं तितिक्षा विज्ञानं यत्र यत्र स मेंऽशकः॥ ११/१६/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.042.m4a", "display_order": 43}, {"id": 6000317043, "chapter_id": 10317, "verse_number": "११-१६-४१", "content_sanskrit": "एतास्ते कीर्तिताः सर्वाः सङ्क्षेपेण विभूतयः।\nमनोविकारा एवैते तथा वाचाऽभिधीयते॥ ११/१६/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.043.m4a", "display_order": 44}, {"id": 6000317044, "chapter_id": 10317, "verse_number": "११-१६-४२", "content_sanskrit": "वाचं यच्छ मनो यच्छ प्राणं यच्छेन्द्रियाणि च।\nआत्मानमात्मना यच्छ न भूयः कल्प्यसेऽध्वने॥ ११/१६/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.044.m4a", "display_order": 45}, {"id": 6000317045, "chapter_id": 10317, "verse_number": "११-१६-४३", "content_sanskrit": "यो वै वाङ्मनसी सम्यङ् न संयच्छेद् धिया यतिः।\nतस्य व्रतं तपो ज्ञानं स्रवत्यामघटाम्बुवत्॥ ११/१६/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.045.m4a", "display_order": 46}, {"id": 6000317046, "chapter_id": 10317, "verse_number": "११-१६-४४", "content_sanskrit": "तस्माद् वचोमनःप्राणान् नियच्छेन्मत्परायणः।\nमद्भक्तियुक्तया बुद्ध्या ततः परिसमाप्यते॥ ११/१६/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_016/BhP_11.016.046.m4a", "display_order": 47}, {"id": 6000317047, "chapter_id": 10317, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे षोडशाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]