[{"id": 2145350, "chapter_id": 4130, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145351, "chapter_id": 4130, "verse_number": "१", "content_sanskrit": "ब्रूहि सञ्जय यच्छेषं वासुदेवादनन्तरम् ।\nयदर्जुन उवाच त्वां परं कौतूहलं हि मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145352, "chapter_id": 4130, "verse_number": "२", "content_sanskrit": "यदब्रूतां महात्मानौ वासुदेवधनञ्जयौ ।\nतन्मे ब्रूहि महाप्राज्ञ शुश्रूषे वचनं तव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145353, "chapter_id": 4130, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145354, "chapter_id": 4130, "verse_number": "३", "content_sanskrit": "शृणु राजन् यथा दृष्टौ मया कृष्णधनञ्जयौ ।\nऊचतुश्चापि यद् वीरौ तत् ते वक्ष्यामि भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145355, "chapter_id": 4130, "verse_number": "४", "content_sanskrit": "पादाङ्गुलीरभिप्रेक्षन् प्रयतोऽहं कृताञ्जलिः ।\nशुद्धान्तं प्राविशं राजन्नाख्यातुं नरदेवयोः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145356, "chapter_id": 4130, "verse_number": "५", "content_sanskrit": "नैवाभिमन्युर्न यमौ तं देशमभियाति वै ।\nयत्र कृष्णौ च कृष्णा च सत्यभामा च भामिनी\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145357, "chapter_id": 4130, "verse_number": "६", "content_sanskrit": "उभौ मध्वासवक्षीबावुभौ चन्दनरूषितौ ।\nस्रग्विणौ वरवस्त्रौ तौ दिव्याभरणभूषितौ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145358, "chapter_id": 4130, "verse_number": "७", "content_sanskrit": "नैकरत्नविचित्रं तु काञ्चनं महदासनम् ।\nविविधास्तरणास्तीर्णं यत्रासातामरिन्दमौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145359, "chapter_id": 4130, "verse_number": "८", "content_sanskrit": "अर्जुनोत्सङ्गागौ पादौ केशवस्योपलक्षये ।\nअर्जुनस्य च कृष्णायां सत्यायां च महात्मनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145360, "chapter_id": 4130, "verse_number": "९", "content_sanskrit": "काञ्चनं पादपीठं तु पार्थो मे प्रादिशत् तदा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145361, "chapter_id": 4130, "verse_number": "१०", "content_sanskrit": "तदहं पाणिना स्पृष्ट्वा ततो भूमावुपाविशम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145362, "chapter_id": 4130, "verse_number": "११", "content_sanskrit": "ऊर्ध्वरेखातळौ पादौ पार्थस्य शुभलक्षणौ ।\nपादपीठादपहृतौ तत्रापश्यमहं शुभौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145363, "chapter_id": 4130, "verse_number": "१२", "content_sanskrit": "श्यामौ बृहन्तौ तरुणौ सालस्कन्धाविवोद्गतौ ।\nएकासनगतौ दृष्ट्वा भयं मां महदाविशत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145364, "chapter_id": 4130, "verse_number": "१३", "content_sanskrit": "इन्द्रविष्णुसमावेतौ मन्दात्मा नावबुद्ध्यते ।\nसंश्रयाद् द्रोणभीष्माभ्यां कर्णस्य च विकत्थनात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145365, "chapter_id": 4130, "verse_number": "१४", "content_sanskrit": "निदेशस्थाविमौ यस्य मानसस्तस्य सेत्स्यते ।\nसङ्कल्पो धर्मराजस्य निश्चयो मे तदाऽभवत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145366, "chapter_id": 4130, "verse_number": "१५", "content_sanskrit": "सत्कृतश्चान्नपानाभ्यामाच्छन्नो लब्धसत्क्रियः ।\nअञ्जलिं मूर्ध्नि सन्धाय तौ सन्देशमचोदयम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145367, "chapter_id": 4130, "verse_number": "१६", "content_sanskrit": "धनुर्बाणोचितेनैकपाणिना शुभलक्षणम् ।\nपादमानमयन् पार्थः केशवं समचोदयत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145368, "chapter_id": 4130, "verse_number": "१७", "content_sanskrit": "इन्द्रकेतुरिवोत्थाय सर्वाभरणभूषितः ।\nइन्द्रवीर्योपमः कृष्णः संविष्टो माऽभ्यभाषत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145369, "chapter_id": 4130, "verse_number": "१८", "content_sanskrit": "वाचं स वदतां श्रेष्ठो ह्लादिनीं वचनक्षमाम् ।\nत्रासनीं धार्तराष्ट्राणां मृदुपूर्वां सुदारुणाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145370, "chapter_id": 4130, "verse_number": "१९", "content_sanskrit": "वाचं तां वचनार्हस्य शिक्षाक्षरसमन्विताम् ।\nअश्रौषमहमिष्टार्थां पश्चाद् हृदयशोषिणीम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145371, "chapter_id": 4130, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145372, "chapter_id": 4130, "verse_number": "२०", "content_sanskrit": "सञ्जयेदं वचो ब्रूया धृतराष्ट्रं मनीषिणम् ।\nशृण्वतः कुरुमुख्यस्य द्रोणस्यापि च शृण्वतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145373, "chapter_id": 4130, "verse_number": "२१", "content_sanskrit": "यजध्वं विपुलैर्यज्ञैर्विप्रेभ्यो दत्तदक्षिणाः ।\nपुत्रैर्दारैश्च मोदध्वं महद् वो भयमागतम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145374, "chapter_id": 4130, "verse_number": "२२", "content_sanskrit": "अर्थान् त्यजत पात्रेभ्यः सुतान् प्राप्नुत कामजान् ।\nप्रियं प्रियेभ्यश्चरत राजा हि त्वरते जये\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145375, "chapter_id": 4130, "verse_number": "२३", "content_sanskrit": "ऋणमेतत् प्रवृद्धं मे हृदयान्नापसर्पति ।\nयद् गोविन्देति चुक्रोश कृष्णा मां दूरवासिनम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145376, "chapter_id": 4130, "verse_number": "२४", "content_sanskrit": "तेजोमयं दुराधर्षं गाण्डीवं यस्य कार्मुकम् ।\nमद्द्वितीयेन तेनेह वैरं वः सव्यसाचिना\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145377, "chapter_id": 4130, "verse_number": "२५", "content_sanskrit": "मद्द्वितीयं पुनः पार्थं कः प्रार्थयितुमिच्छति ।\nयो न कालपरीतो वाप्यपि साक्षात् पुरन्दरः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145378, "chapter_id": 4130, "verse_number": "२६", "content_sanskrit": "बाहुभ्यामुद्वहेद् भूमिं दहेत् क्रुद्ध इमाः प्रजाः ।\nपातयेद् त्रिदिवाद् देवान् योऽर्जुनं समरे जयेत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145379, "chapter_id": 4130, "verse_number": "२७", "content_sanskrit": "देवासुरमनुष्येषु यक्षगन्धर्वभोगिषु ।\nन तं पश्याम्यहं युद्धे पाण्डवं योऽभ्ययाद् रणे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2145380, "chapter_id": 4130, "verse_number": "२८", "content_sanskrit": "यत् तद् विराटनगरे श्रूयते महदद्भुतम् ।\nएकस्य च बहूनां च पर्याप्तं तन्निदर्शनम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2145381, "chapter_id": 4130, "verse_number": "२९", "content_sanskrit": "एकेन पाण्डुपुत्रेण विराटनगरे यदा ।\nभग्नाः पलायन्त दिशः पर्याप्तं तन्निदर्शनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2145382, "chapter_id": 4130, "verse_number": "३०", "content_sanskrit": "बलं वीर्यं च तेजश्च शीघ्रता लघुहस्तता ।\nअविषादश्च धैर्यं च पार्थान्नान्यत्र विद्यते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2145383, "chapter_id": 4130, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2145384, "chapter_id": 4130, "verse_number": "३१", "content_sanskrit": "इत्यब्रवीद् हृषीकेशः पार्थमुद्धर्षयन् गिरा ।\nगर्जन् समयवर्षीव गगने पाकशासनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2145385, "chapter_id": 4130, "verse_number": "३२", "content_sanskrit": "वासुदेववचः श्रुत्वा कुन्तीपुत्रो धनञ्जयः ।\nउवाच काले दुर्धर्षो वासुदेवस्य शृण्वतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2145386, "chapter_id": 4130, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2145387, "chapter_id": 4130, "verse_number": "३३", "content_sanskrit": "पितामहं शान्तनवं धृतराष्ट्रं च सञ्जय ।\nद्रोणं कृपं च कर्णं च महाराजं च बाह्लिकम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2145388, "chapter_id": 4130, "verse_number": "३४", "content_sanskrit": "द्रौणिं च सोमदत्तं च शकुनिं चापि सौबलम् ।\nदुःशासनं शलं चैव पुरुमित्रं विविंशतिम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2145389, "chapter_id": 4130, "verse_number": "३५", "content_sanskrit": "विकर्णं चित्रसेनं च जयत्सेनं च पार्थिवम् ।\nविन्दानुविन्दावावन्त्यौ दुर्मुखं चापि पौरवम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2145390, "chapter_id": 4130, "verse_number": "३६", "content_sanskrit": "सैन्धवं दुःसहं चैव भूरिश्रवसमेव च ।\nभगदत्तं च राजानं जलसन्धं च पौरवम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2145391, "chapter_id": 4130, "verse_number": "३७", "content_sanskrit": "ये चाप्यन्ये पार्थिवास्तत्र योद्धुं\nसमागताः कौरवाणां प्रियार्थम् ।\nमुमूर्षवः पाण्डवाग्नौ प्रदीप्ते\nसमानीता धार्तराष्ट्रेण सूत\t॥ ३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2145392, "chapter_id": 4130, "verse_number": "३८", "content_sanskrit": "यथान्यायं कुशलं वन्दनं च\nसमागता मद्वचनेन वाच्याः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2145393, "chapter_id": 4130, "verse_number": "३९", "content_sanskrit": "इदं ब्रूयाः सञ्जय राजमध्ये\nसुयोधनं पापकृतां प्रधानम् ।\nअमर्षणं दुर्मतिं राजपुत्रं\nपापात्मानं धार्तराष्ट्रं सुलुब्धम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2145394, "chapter_id": 4130, "verse_number": "४०", "content_sanskrit": "सर्वं ममैतद् वचनं समग्रं\nसहामात्यं सञ्जय श्रावयेथाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2145395, "chapter_id": 4130, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2145396, "chapter_id": 4130, "verse_number": "४१", "content_sanskrit": "एवं परिष्वज्य धनञ्जयो मां\nततोऽर्थवद् धर्मवच्चापि वाक्यम् ।\nप्रोवाचेदं वासुदेवं समीक्ष्य\nपार्थो धीमाँल्लोहितान्तायताक्षः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2145397, "chapter_id": 4130, "verse_number": "४२", "content_sanskrit": "यथाश्रुतं ते वदतो महात्मनो\nयदुप्रवीरस्य वचः समाहितम् ।\nतथैव वाच्यं भवताऽपि मद्वचः\nसमागतेषु क्षितिपेषु सर्वशः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2145398, "chapter_id": 4130, "verse_number": "४३", "content_sanskrit": "शराग्निधूमे रथनेमिनादिते\nधनुःस्रुवेणास्त्रबलापहारिणा ।\nयथा न होमः क्रियते महामृधे\nतथा समेत्य प्रयतध्वमादृताः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2145399, "chapter_id": 4130, "verse_number": "४४", "content_sanskrit": "न चेत् प्रयच्छध्वममित्रघातिनो\nयुधिष्ठिरस्यांशमभीप्सितं स्वकम् ।\nनयामि वः साश्वपदातिकुञ्जरान्\nदिशं पितॄणामशिवां शितैः शरैः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2145400, "chapter_id": 4130, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2145401, "chapter_id": 4130, "verse_number": "४५", "content_sanskrit": "ततोऽहमामन्त्र्य तदा धनञ्जयं\nचतुर्भुजं चैव नमस्य सत्वरः ।\nजवेन सम्प्राप्त इहामरद्युते\nतवान्तिकं प्रापयितुं वचो महत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2145402, "chapter_id": 4130, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकषष्टितमोऽध्यायः ॥६१॥\nव्यासाभिगमनपर्वणि चतुर्दशोऽध्यायः ॥१४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]