[{"id": 7006177000, "chapter_id": 26177, "verse_number": "२-५-१", "content_sanskrit": "ऋषिरुवाच दैत्यानां दानवानां च गन्धर्वोरगरक्षसाम् ।\nसर्पभूतापिशा चानां वसूनां पक्षिवीरुधाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006177001, "chapter_id": 26177, "verse_number": "२-५-२", "content_sanskrit": "उत्पत्तिं निधनं चैव विस्तारात्कथयस्व नः ।\nएवमुक्तस्तदा सूतः प्रत्युवाचर्षिसत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006177002, "chapter_id": 26177, "verse_number": "२-५-३", "content_sanskrit": "सूत उवाच दितेः पुत्रद्वयं जज्ञे कन्या चैका महाबला ।\nकश्यपस्यात्मजौ तौ तु सर्वेभ्यः पूर्वजौ स्मृतौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006177003, "chapter_id": 26177, "verse_number": "२-५-४", "content_sanskrit": "सौत्येऽहन्यतिरा त्रस्य कश्यपस्याश्वमेधिकाः ।\nहिरण्यकशिपुर्नाम प्रथितं पृथगासनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006177004, "chapter_id": 26177, "verse_number": "२-५-५", "content_sanskrit": "दित्या गर्भाद्विनिः सृत्य तत्रासीनः समन्ततः ।\nहिरण्य कशिपुस्तस्मात्कर्मणा तेन स समृतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006177005, "chapter_id": 26177, "verse_number": "२-५-६", "content_sanskrit": "ऋषय ऊचुः हिरण्यकशिपोर्जन्म नाम चैव महात्मनः ।\nप्रभावं चैव दैत्यस्य विस्ताराद्ब्रूहि नः प्रभो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006177006, "chapter_id": 26177, "verse_number": "२-५-७", "content_sanskrit": "सूत उवाच कश्यपस्याश्वमेधोऽभूत्पुण्ये वै पुष्करे तदा ।\nऋषिभिदेंवताभिश्च गन्धर्वैरुपशोभितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006177007, "chapter_id": 26177, "verse_number": "२-५-८", "content_sanskrit": "उत्सृष्टे स्वे च विधिना आख्यानादौ यथाविधि ।\nआसनान्युपकॢप्तानि सौवर्णानि तु पञ्च वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006177008, "chapter_id": 26177, "verse_number": "२-५-९", "content_sanskrit": "कुलस्पदापि? त्रीण्यत्र कूर्चः फलकमेव च ।\nमुख्यर्त्विजस्तु चत्वारस्तेषां तान्युपकल्पयन् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006177009, "chapter_id": 26177, "verse_number": "२-५-१०", "content_sanskrit": "कॢप्त तत्रासनं चैकं होतुरर्थे हिरण्यम् ।\nनिषसाद सगर्भोऽत्र तत्रासीनः शशंस च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006177010, "chapter_id": 26177, "verse_number": "२-५-११", "content_sanskrit": "आख्यानमानुपूर्व्येण महर्षिः कश्यपो यथा ।\nतं दृष्ट्वा ऋषयस्तस्य नाम कुर्वन्ति वर्द्धितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006177011, "chapter_id": 26177, "verse_number": "२-५-१२", "content_sanskrit": "हिरण्यकशिपुस्तस्मात्कर्मणा तेन स स्मृतः ।\nहिरण्यक्षोऽनुजस्तस्य सिंहिका तस्य चानुजा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006177012, "chapter_id": 26177, "verse_number": "२-५-१३", "content_sanskrit": "राहोः सा जननी देवी विप्र चित्तेः परिग्रहः ।\nहिरण्यकशिपुर्दैत्यश्चचार परमं तपः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006177013, "chapter_id": 26177, "verse_number": "२-५-१४", "content_sanskrit": "शतं वर्षसहस्राणां निराहारो ह्यधःशिराः ।\nवरयामास ब्रह्माणं तुष्टं दैत्यो वरेण तु ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006177014, "chapter_id": 26177, "verse_number": "२-५-१५", "content_sanskrit": "सर्वामरत्वमवधं सर्वभूतेभ्य एव हि ।\nयोगद्देवान् विनिर्जित्य सर्वदेवत्वमास्थितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006177015, "chapter_id": 26177, "verse_number": "२-५-१६", "content_sanskrit": "कारयेऽहमिहैश्वर्यं बलवीर्यसमन्वितः ।\nदानवास्त्वसुराश्चैव देवाश्च सह चारणैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006177016, "chapter_id": 26177, "verse_number": "२-५-१७", "content_sanskrit": "भवन्तु वशगाः सर्वे मत्समीपानुभोजनाः ।\nआर्द्रशुष्कैरवध्यश्च दिवा रात्रौ तथैव च ।\nएवमुक्तस्तदा ब्रह्मानुजज्ञे सांतरं वरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006177017, "chapter_id": 26177, "verse_number": "२-५-१८", "content_sanskrit": "ब्रह्मोवाच ।\nमहानयं वरस्तात वृतो दितिसुत त्वया ।\nएही दानीं प्रतिज्ञानं भविष्यत्येवमेव तु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006177018, "chapter_id": 26177, "verse_number": "२-५-१९", "content_sanskrit": "दत्त्वा चाभिमतं तस्मै तत्रेवान्तरधादथ ।\nसोऽपि दैत्यस्तदा सर्वं जगत्स्थावरजङ्गमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006177019, "chapter_id": 26177, "verse_number": "२-५-२०", "content_sanskrit": "महिम्ना व्याप्य संतस्थे बहुमूर्त्तिरमित्रजित् ।\nस एव तपति व्योम्नि चन्द्रसूर्यत्वमास्थितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006177020, "chapter_id": 26177, "verse_number": "२-५-२१", "content_sanskrit": "स एव वायुर्भूत्वा च ववौ जगति सर्वदा ।\nस गोपालोऽविपालश्च कर्षकश्च स एव ह ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006177021, "chapter_id": 26177, "verse_number": "२-५-२२", "content_sanskrit": "स ज्ञाता सर्वलोकेषु मन्त्रव्याख्याकरस्तथा ।\nनेता गोप्ता गोपयिता दीक्षितो याजकः स तु ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006177022, "chapter_id": 26177, "verse_number": "२-५-२३", "content_sanskrit": "तस्य देवाः सुराः सर्वे तदासन्सोमपायिनः ।\nएवंप्रभावो दैत्योऽसावतो भूयो निबोधत ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006177023, "chapter_id": 26177, "verse_number": "२-५-२४", "content_sanskrit": "तस्मै सर्वे नमस्कारं कुर्वन्तीज्यः स एव च ।\nहिरण्यकशिपोर्दैत्यैः श्लोको गीतः पुरा त्विह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006177024, "chapter_id": 26177, "verse_number": "२-५-२५", "content_sanskrit": "हिरण्यकशिपू राजा यां यामाशां निरैक्षत ।\nतस्यै तस्यै तदा देवा नमश्चक्रुर्महर्षिभिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006177025, "chapter_id": 26177, "verse_number": "२-५-२६", "content_sanskrit": "तस्यासीन्नरसिंहस्तु मृत्युर्विष्णुः पुरा किल ।\nनरात्तु यस्माज्जन्मास्य नरमूर्त्तिश्च यत्प्रभुः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006177026, "chapter_id": 26177, "verse_number": "२-५-२७", "content_sanskrit": "तस्मात्स नरसिंहो वै गीयते वेदवादिभिः ।\nसागरस्य च वेलायामुच्छ्रित स्तपसो विभुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006177027, "chapter_id": 26177, "verse_number": "२-५-२८", "content_sanskrit": "शरीरं तस्य देवस्य ह्यासीद्देवमयं प्रभो ।\nनाम्ना सुदर्शनं चैव विश्रुतश्च महाबलः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006177028, "chapter_id": 26177, "verse_number": "२-५-२९", "content_sanskrit": "ततः स बाहुयुद्धेन दैत्येन्द्रं तं महाबलम् ।\nनखैर्बिभद संक्रुद्धो नार्द्राः शुष्का नखा इति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006177029, "chapter_id": 26177, "verse_number": "२-५-३०", "content_sanskrit": "हिरण्याक्षसुताः पञ्च विक्रान्ताः सुमहाबलाः ।\nशंबरः शकुनिश्चैव कालनाभस्तथैव च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006177030, "chapter_id": 26177, "verse_number": "२-५-३१", "content_sanskrit": "महानाभः सुविक्रान्तो सुत संतापनस्तथा ।\nहिरण्यक्षसुता ह्येते देवैरपि दुरासदाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006177031, "chapter_id": 26177, "verse_number": "२-५-३२", "content_sanskrit": "तेषां पुत्राश्च पौत्राश्च दैतेयाः सगणाः स्मृताः ।\nस शतानि सहस्राणि निहतास्तारकामये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006177032, "chapter_id": 26177, "verse_number": "२-५-३३", "content_sanskrit": "हिरण्यकशिपोः पुत्राश्चत्वारः सुमहाबलाः ।\nप्रह्लादः पूर्वजस्तेषामनुह्ना दस्तथापरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006177033, "chapter_id": 26177, "verse_number": "२-५-३४", "content_sanskrit": "संह्रादश्चैव ह्रादश्च ह्रादपुत्रौ निबोधत ।\nसुंदो निसुन्दश्च तथा ह्रादपुतौ बभूवतुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006177034, "chapter_id": 26177, "verse_number": "२-५-३५", "content_sanskrit": "ब्रह्यघ्नौ तौ महावीरौ मूकस्तु ह्राददायकः ।\nमारीचः सुन्दपुत्रस्तु ताडकायामजायत ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006177035, "chapter_id": 26177, "verse_number": "२-५-३६", "content_sanskrit": "दण्डके निहतः सोऽथ राघवेण बलीयसा ।\nमूको विनिहतश्चापि कैराते सव्यसाचिना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006177036, "chapter_id": 26177, "verse_number": "२-५-३७", "content_sanskrit": "संह्रादस्य तु दैत्यस्य निवातकवचाः कुले ।\nउत्पन्ना महता चैव तपसा भाविताः स्वयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006177037, "chapter_id": 26177, "verse_number": "२-५-३८", "content_sanskrit": "अरयो देवतानां ते जंभस्य शतदुन्दुभिः ।\nतथा दक्षो सुरश्चण्डश्चत्वारो देत्यनायकाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006177038, "chapter_id": 26177, "verse_number": "२-५-३९", "content_sanskrit": "बाष्कलस्य सुता ह्येते काल नेमेः सुताञ्छृणु ।\nब्रह्मजित्क्रतुजिच्चैव देवान्तकनरान्तकौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006177039, "chapter_id": 26177, "verse_number": "२-५-४०", "content_sanskrit": "कालनेमिसुता ह्येते शभोस्तु शृणुत प्रजाः ।\nराजाजश्चैव गोमश्च शंभोः पुत्रौ प्रकीर्त्तितौ ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006177040, "chapter_id": 26177, "verse_number": "२-५-४१", "content_sanskrit": "विरोजनस्य पुत्रश्च बलिरेकः प्रतापवान् ।\nबलेः पुत्रशतं जज्ञे राजानः सर्व एव ते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006177041, "chapter_id": 26177, "verse_number": "२-५-४२", "content_sanskrit": "तेषां प्रधानाश्चत्वारो विक्रान्ताः सुमहाबलाः ।\nसहस्रबाहुः श्रेष्ठोऽभूद्बाणो राजा प्रतापवान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006177042, "chapter_id": 26177, "verse_number": "२-५-४३", "content_sanskrit": "कुंभगर्त्तो दयो भोजः कुञ्चिरित्येवमा दयः ।\nशकुनी पूतना चैव कन्ये द्वे तु बलेः स्मृते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006177043, "chapter_id": 26177, "verse_number": "२-५-४४", "content_sanskrit": "बलेः पुत्राश्च पौत्राश्च शतशोऽथ सहस्रशः ।\nबालेया नाम विख्याता गणा विक्रान्तपौरुषाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006177044, "chapter_id": 26177, "verse_number": "२-५-४५", "content_sanskrit": "बाणस्य चैन्द्रधन्वा तु लोहिन्यामुदपद्यत ।\nदितिर्विहितपुत्रा वै तोषयामास कश्यपम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006177045, "chapter_id": 26177, "verse_number": "२-५-४६", "content_sanskrit": "तां कश्यपः प्रसन्नात्मा सम्यगाराधितस्त्वथ ।\nवरेण छन्दयामास सा च वव्रे वरं तत ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006177046, "chapter_id": 26177, "verse_number": "२-५-४७", "content_sanskrit": "अथ तस्यै वरं प्रादात्प्रार्थितो भगवान्पुनः ।\nउक्ते वरे तु मा तुष्टा दितिस्तं समभाषत ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006177047, "chapter_id": 26177, "verse_number": "२-५-४८", "content_sanskrit": "मारीचं कण्यपं देवी भर्त्तारं प्राञ्जलिस्तदा ।\nहतपुत्रास्मि भगवन्नादित्यैस्तव सूनुभिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006177048, "chapter_id": 26177, "verse_number": "२-५-४९", "content_sanskrit": "शक्रहन्तारमिच्छमि पुत्रं दीर्घतपोऽर्जितम् ।\nसाहं तपश्चरिष्यामि गर्भमाधातुमर्हसि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006177049, "chapter_id": 26177, "verse_number": "२-५-५०", "content_sanskrit": "पुत्रमिन्द्रवधे युक्तं त्वं मै वै दातुमर्हसि ।\nतस्यास्तद्वचनं श्रुत्वा मारीचः कश्यपस्तदा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006177050, "chapter_id": 26177, "verse_number": "२-५-५१", "content_sanskrit": "प्रत्युवाच महातेजा दितिं परमदुः खितः ।\nएवं भवतु गर्भे तु शुचिर्भव तपोधने ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006177051, "chapter_id": 26177, "verse_number": "२-५-५२", "content_sanskrit": "जनयिष्यसि पुत्रं त्वं शक्रहन्तारमाहवे ।\nपूर्णं वर्षसहस्रं तु शुचिर्यदि भविष्यसि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006177052, "chapter_id": 26177, "verse_number": "२-५-५३", "content_sanskrit": "पुत्रं त्रिलोकप्रवरं मन्मथं जनयिष्यसि ।\nएवमुक्त्वा महातेजास्तथा समभावत्तदा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006177053, "chapter_id": 26177, "verse_number": "२-५-५४", "content_sanskrit": "तामालभ्य स्वभवनं जगाम भगवानृषिः ।\nगते भर्त्तरि सा देवी दितिः परमहर्षिता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006177054, "chapter_id": 26177, "verse_number": "२-५-५५", "content_sanskrit": "कुशप्लवनमासाद्य तपस्तेपे सुदारुणम् ।\nशक्रस्तु समुपश्रुत्य संवादं तं तयोः प्रभुः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006177055, "chapter_id": 26177, "verse_number": "२-५-५६", "content_sanskrit": "कुशप्लवनमागम्य दितिं वाक्यमभाषत ।\nशुश्रूषां ते करिष्यामि मानुज्ञां दातुमर्हसि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006177056, "chapter_id": 26177, "verse_number": "२-५-५७", "content_sanskrit": "समिधश्चाहरिष्यामि पुष्पाणि च फलानि च ।\nयथा त्वं मन्यसे वत्स सुश्रूषाभिरतो भव ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006177057, "chapter_id": 26177, "verse_number": "२-५-५८", "content_sanskrit": "सर्वकर्मसु निष्णात आत्मनो हितमाचर ।\nवरं श्रुत्वा तु त द्वाक्यं मातुः शक्रः प्रहर्षितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006177058, "chapter_id": 26177, "verse_number": "२-५-५९", "content_sanskrit": "शुश्रूषाभिरतो भूत्वा कलुषेणान्तरात्मना ।\nशुश्रूषते तु तां शक्रः सर्वकालमनुव्रतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006177059, "chapter_id": 26177, "verse_number": "२-५-६०", "content_sanskrit": "फलपुष्पाण्युपादाय समिधश्च दृढव्रतः ।\nगात्रसंवाहनं काले श्रमापनयने तथा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006177060, "chapter_id": 26177, "verse_number": "२-५-६१", "content_sanskrit": "शक्रः सर्वेषु कालेषु दितिं परिचचार ह ।\nकिञ्चिच्छिष्टे व्रते देवी तुष्टा शक्रमुवाच ह ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006177061, "chapter_id": 26177, "verse_number": "२-५-६२", "content_sanskrit": "प्रतीताहं ते सुरश्रेष्ठ दशवर्षाणि पुत्रक ।\nअवशिष्ठानि भद्रं ते भ्रातरं द्रक्ष्यसे ततः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006177062, "chapter_id": 26177, "verse_number": "२-५-६३", "content_sanskrit": "तमहं त्वत्कृते पुत्र सह धास्ये जयैषिणम् ।\nत्रैलोक्यविजयं पुत्र भोक्ष्यसे सह तेन वै ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006177063, "chapter_id": 26177, "verse_number": "२-५-६४", "content_sanskrit": "नाहं पुत्राभिजानामि मद्भक्तिगतमानसम् ।\nएवमुक्त्वा दितिः शक्रं मध्यं प्राप्ते दिवाकरे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006177064, "chapter_id": 26177, "verse_number": "२-५-६५", "content_sanskrit": "निद्रयापहृता दवी शिरः कृत्वा तु जानुनि ।\nकेशान्कृत्वा तु पादस्थान्सा सुष्वाप च देवता ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006177065, "chapter_id": 26177, "verse_number": "२-५-६६", "content_sanskrit": "अधस्ताद्यत्तु नाभेर्वै सर्वं तदशुचि स्मृतम् ।\nततस्तामशुचिं ज्ञात्वा सोंतरं तदमन्यत ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006177066, "chapter_id": 26177, "verse_number": "२-५-६७", "content_sanskrit": "दृष्ट्वा तु कारणं सर्वं तस्य बुद्धिरजायत ।\nगर्भं निहन्तु वै देव्या स हि दोषोऽत्र दृश्यते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006177067, "chapter_id": 26177, "verse_number": "२-५-६८", "content_sanskrit": "ततो विवेश दित्या वै ह्युपस्थेनोदरं वृषा ।\nप्रविश्य चापि तं दृष्ट्वा गभमिन्द्रो महौजसम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006177068, "chapter_id": 26177, "verse_number": "२-५-६९", "content_sanskrit": "भीतस्तं सप्तधा गभ बिभेद रिपुमात्मनः ।\nम गर्भो भिद्यमानस्तु वज्रणशतपर्वणा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006177069, "chapter_id": 26177, "verse_number": "२-५-७०", "content_sanskrit": "रुरोद सुस्वरं भीमं वेपमानः पुनः पुनः ।\nमारोद मारोद इति गर्भं शक्रोऽभ्यभाषत ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006177070, "chapter_id": 26177, "verse_number": "२-५-७१", "content_sanskrit": "तं गर्भं सप्तधा कृत्वा ह्येकैकं सप्तधा पुनः ।\nकुलिशेन बिभेदेन्द्रस्ततो दितिरबुध्यता ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006177071, "chapter_id": 26177, "verse_number": "२-५-७२", "content_sanskrit": "न हन्तव्यो न हन्तव्य इत्येवं दितिरब्रवीत् ।\nनिष्पपात ततो वज्री मातुर्वचनगौरवात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006177072, "chapter_id": 26177, "verse_number": "२-५-७३", "content_sanskrit": "प्राञ्जलिर्वज्रसहितो दितिं शक्रोऽभ्यभाषत ।\nअशुचिर्देवि सुप्तासि पादयोर्गतमूर्द्धजा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006177073, "chapter_id": 26177, "verse_number": "२-५-७४", "content_sanskrit": "तदं तरमनुप्राप्य गर्भं हेतारमाहवे ।\nभिन्नवानहमेतं ते बहुधा क्षन्तुमर्हसि ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006177074, "chapter_id": 26177, "verse_number": "२-५-७५", "content_sanskrit": "तस्मिंस्तु विफले गर्भे दितिः परमदुःखिता ।\nसहस्राक्षं दुराधर्षं वाक्यं सानुनयाब्रवीत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006177075, "chapter_id": 26177, "verse_number": "२-५-७६", "content_sanskrit": "ममापराधाद्गर्भोऽयं यदि ते विफलीकृतः ।\nनापराधोऽस्ति देवेश तव पुत्र महाबल ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006177076, "chapter_id": 26177, "verse_number": "२-५-७७", "content_sanskrit": "शत्रोर्वधे न दोषोऽस्ति भेतव्यं न च ते विभो ।\nप्रियं तु कृतमिच्छामि श्रेयो गर्भस्य मे कुतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006177077, "chapter_id": 26177, "verse_number": "२-५-७८", "content_sanskrit": "भवन्तु मम पुत्राणां सप्त स्थानानि वै दिवि ।\nवातस्कन्धानिमान्सप्त चरन्तु मम पुत्रकाः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006177078, "chapter_id": 26177, "verse_number": "२-५-७९", "content_sanskrit": "मरुतस्ते तु विख्याता गतास्ते सप्तसप्तकाः ।\nपृथिव्यां प्रथमस्कन्धो द्वितीयश्चापि भास्करे ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006177079, "chapter_id": 26177, "verse_number": "२-५-८०", "content_sanskrit": "सोमे तृतीयो विज्ञेयश्चतुर्थो ज्योतिषां गणे ।\nग्रहेषु पञ्चमस्चैव षष्ठः सप्तर्षिमण्डले ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006177080, "chapter_id": 26177, "verse_number": "२-५-८१", "content_sanskrit": "ध्रुवे तु सप्तमश्चैव वातस्कन्धाश्चसप्त ये ।\nतानेते विचरन्त्वद्य कालेकाले ममात्मजाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006177081, "chapter_id": 26177, "verse_number": "२-५-८२", "content_sanskrit": "वातस्कन्धाधिपा भूत्वा चरन्तु मम पुत्रकाः ।\nपृथिव्यां प्रथमस्कन्ध आ मेघेब्यो य आवहः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006177082, "chapter_id": 26177, "verse_number": "२-५-८३", "content_sanskrit": "चरन्तु मम पुत्रास्ते सप्त ये प्रथमे गणे ।\nद्वितीयश्चापि मेघेभ्य आसूर्यात्प्रवहस्ततः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006177083, "chapter_id": 26177, "verse_number": "२-५-८४", "content_sanskrit": "वातस्कन्धो हि विज्ञेयो द्वितीयश्चरतां गणः ।\nसूर्यादूर्ध्वमधः सोमादुद्वहोऽथ स वै स्मृतः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006177084, "chapter_id": 26177, "verse_number": "२-५-८५", "content_sanskrit": "वातस्कन्धस्तृतीयश्च पुत्राणां चरता गणः ।\nसोमादूर्द्ध्वमधर्क्षेभ्यश्चतुर्थ संवहस्तु सः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006177085, "chapter_id": 26177, "verse_number": "२-५-८६", "content_sanskrit": "चतुर्थो मम पुत्राणां गणस्तु चरतां विभो ।\nऋक्षेभ्यश्च तथैवोर्द्ध्वमा ग्रहाद्विवहस्तु यः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006177086, "chapter_id": 26177, "verse_number": "२-५-८७", "content_sanskrit": "वातस्कन्धः पञ्चमस्तु पुत्राणां चरतां गणः ।\nग्रहेभ्य ऊर्द्ध्वमार्षिभ्यः षष्ठो ह्यनुवहश्च यः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006177087, "chapter_id": 26177, "verse_number": "२-५-८८", "content_sanskrit": "वातस्कन्धस्तत्र मम पुराणां चरता गणः ।\nऋषिभ्य ऊर्द्ध्वमाध्रौवं सप्तमो यः प्रकीर्त्तितः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006177088, "chapter_id": 26177, "verse_number": "२-५-८९", "content_sanskrit": "वातस्कन्धः परिवहस्तत्र तिष्ठन्तु मे सुताः ।\nएतान्सर्वाश्चरन्त्वन्ते कालेकाले ममात्मजाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006177089, "chapter_id": 26177, "verse_number": "२-५-९०", "content_sanskrit": "त्वत्कृतेन च नाम्ना वै भवतु मरुतस्त्विमे ।\nततस्तेषां तु नामानि मत्पुत्राणां शतक्रतो ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006177090, "chapter_id": 26177, "verse_number": "२-५-९१", "content_sanskrit": "तद्विधैः कर्मभिश्चैव समवेहि पृथक्पृथक् ।\nशक्रज्योतिस्तथा सत्यः सत्यज्योतिस्तथापरः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006177091, "chapter_id": 26177, "verse_number": "२-५-९२", "content_sanskrit": "चित्रज्योतिश्च ज्योतिष्मान् सुतपश्चैत्य एव च ।\nप्रथमोऽयं गणः प्रोक्तो द्वितीयं तु निबोधत ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006177092, "chapter_id": 26177, "verse_number": "२-५-९३", "content_sanskrit": "ऋतजित्सत्यजिश्चैव सुषेणः सेनजित्तथा ।\nसुतमित्रो ह्यमित्रश्च सुरमित्रस्तथापरः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006177093, "chapter_id": 26177, "verse_number": "२-५-९४", "content_sanskrit": "गण एष द्वितीयस्तु तृतीयं च निबोधत ।\nधातुश्च धनदश्चैव ह्युग्रो भीमस्तथैव च ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006177094, "chapter_id": 26177, "verse_number": "२-५-९५", "content_sanskrit": "वरुणश्च तृतीयं च मया प्रोक्तं निबोधत ।\nअभियुक्ताक्षिकश्चैव साह्वायश्च गणः स्मृतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006177095, "chapter_id": 26177, "verse_number": "२-५-९६", "content_sanskrit": "ईदृक्चैव तथान्यादृक्समरिद्द्रुमवृचक्षकाः ।\nमितश्च समितश्चैव पञ्चमश्च तथा गणः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006177096, "chapter_id": 26177, "verse_number": "२-५-९७", "content_sanskrit": "ईदृक्च पुरुषश्चैव नान्यादृक्समचेतनः ।\nसंमितः समवृत्तिश्च प्रतिहर्ता च षड्गणाः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006177097, "chapter_id": 26177, "verse_number": "२-५-९८", "content_sanskrit": "यज्ञैश्चित्वास्तुवन्सर्वे तथान्ये मानुषा विशः ।\nदैत्यदेवाः समाख्याताः सप्तैते सप्तसप्तकाः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006177098, "chapter_id": 26177, "verse_number": "२-५-९९", "content_sanskrit": "एते ह्येकोनपञ्चाशन्मरुतो नामतः स्मृताः ।\nप्रसंख्यातास्तदा ताभ्यां दित्या शक्रेण चैव वै ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006177099, "chapter_id": 26177, "verse_number": "२-५-१००", "content_sanskrit": "कृत्वा चैतानि नामानि दितिरिन्द्रमुवाच ह ।\nवातस्कन्धांश्चरन्त्वेते भ्रतरो मम पुत्रकाः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006177100, "chapter_id": 26177, "verse_number": "२-५-१०१", "content_sanskrit": "विचरन्तु च भद्रं ते देवैः सह ममात्मजाः ।\nतस्यास्तद्वचनं श्रुत्वा महस्राक्षः पुरन्दरः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006177101, "chapter_id": 26177, "verse_number": "२-५-१०२", "content_sanskrit": "उवाच प्राञ्जलिर्भूत्वा मातर्भवतु तत्तथा ।\nसर्व मेतद्यथोक्तं ते भविष्यति न संशयः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006177102, "chapter_id": 26177, "verse_number": "२-५-१०३", "content_sanskrit": "एवंभूता महात्मानः कुमारा लोकसंमताः ।\nदेवैः सह भविष्यन्ति यज्ञभाजस्तवात्म जाः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006177103, "chapter_id": 26177, "verse_number": "२-५-१०४", "content_sanskrit": "तस्मात्ते मरुतो देवाः सर्वे चेन्द्रानुजा वराः ।\nविज्ञेयाश्चामराः सर्वे दितिपुत्रास्तरस्विनः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006177104, "chapter_id": 26177, "verse_number": "२-५-१०५", "content_sanskrit": "एवं तौ निश्चयं कृत्वा मातापुत्रौ तपोवने ।\nजग्मतुस्त्रिदिवं त्दृष्टौ शक्रमाभूद्गतज्वरः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006177105, "chapter_id": 26177, "verse_number": "२-५-१०६", "content_sanskrit": "मरुतां च शुभं जन्म शृणुयाद्यः पठेच्च वा ।\nवादे विजयमाप्नोति लब्धात्मा च भवत्युत ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}]