[{"id": 2136106, "chapter_id": 3952, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136107, "chapter_id": 3952, "verse_number": "१", "content_sanskrit": "सखा दशरथस्यासीज्जटायुररुणात्मजः ।\nगृध्रराजो महावीरः सम्पातिः यस्य सोदरः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136108, "chapter_id": 3952, "verse_number": "२", "content_sanskrit": "स ददर्श तदा सीतां रावणाङ्कगतां स्नुषाम् ।\nसक्रोधोऽभ्यद्रवत्पक्षी रावणं राक्षसेश्वरम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136109, "chapter_id": 3952, "verse_number": "३", "content_sanskrit": "अथैनमब्रवीद् गृध्रो मुञ्च मुञ्चेति मैथिलीम् ।\nध्रियमाणे मयि कथं हरिष्यसि निशाचर \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136110, "chapter_id": 3952, "verse_number": "४", "content_sanskrit": "न हि मे मोक्ष्यसे जीवन् यदि नोत्सृजसे वधूम् ।\nउक्त्वैवं राक्षसेन्द्रं तं चकर्त नखरैर्भृशम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136111, "chapter_id": 3952, "verse_number": "५", "content_sanskrit": "पक्षतुण्डप्रहारैश्च शतशो जर्जरीकृतम् ।\nचक्षार रुधिरं भूरि गिरिः प्रस्रवणैरिव \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136112, "chapter_id": 3952, "verse_number": "६", "content_sanskrit": "स वध्यमानो गृध्रेण रामप्रियहितैषिणा ।\nखड्गमादाय चिच्छेद भुजौ तस्य पतत्त्रिणः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136113, "chapter_id": 3952, "verse_number": "७", "content_sanskrit": "निहत्य गृध्रराजं स भिन्नाभ्रशिखरोपमम् ।\nऊर्ध्वमाचक्रमे सीतां गृहीत्वाऽङ्केन राक्षसः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136114, "chapter_id": 3952, "verse_number": "८", "content_sanskrit": "यत्र यत्र तु वैदेही पश्यत्याश्रममण्डलम् ।\nसरो वा सरितो वापि तत्र मुञ्चति भूषणम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136115, "chapter_id": 3952, "verse_number": "९", "content_sanskrit": "सा ददर्श गिरिप्रस्थे पञ्च वानरपुङ्गवान् ।\nतत्र वासो महद् दिव्यमुत्ससर्ज मनस्विनी \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136116, "chapter_id": 3952, "verse_number": "१०", "content_sanskrit": "तत् तेषां वानरेन्द्राणां पपात पवनोद्धतम् ।\nमध्ये सुपीतं पञ्चानां विद्युन्मेघान्तरे यथा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136117, "chapter_id": 3952, "verse_number": "११", "content_sanskrit": "अचिरेणातिचक्राम खेचरः खे चरन्निव ।\nददर्शाथ पुरीं रम्यां बहुद्वारां मनोरमाम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136118, "chapter_id": 3952, "verse_number": "१२", "content_sanskrit": "प्राकारवप्रसम्बाधां निर्मितां विश्वकर्मणा ।\nप्रविवेश पुरीं लङ्कां ससीतो राक्षसेश्वरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136119, "chapter_id": 3952, "verse_number": "१३", "content_sanskrit": "एवं हृतायां वैदेह्यां रामो हत्वा महामृगम् ।\nनिवृत्तो ददृशे धीमान् भ्रातरं लक्ष्मणं तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136120, "chapter_id": 3952, "verse_number": "", "content_sanskrit": "श्रीरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136121, "chapter_id": 3952, "verse_number": "१४", "content_sanskrit": "कथमुत्सृज्य वैदेहीं वने राक्षससेविते । \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136122, "chapter_id": 3952, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136123, "chapter_id": 3952, "verse_number": "समाप्तिः", "content_sanskrit": "इति तं भ्रातरं दृष्ट्वा प्राप्तोऽसीति व्यगर्हयत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136124, "chapter_id": 3952, "verse_number": "१६", "content_sanskrit": "मृगरूपधरेणाथ रक्षसा सोऽपकर्षणम् ।\nभ्रातुरागमनं चैव चिन्तयन् पर्यतप्यत ।\nगर्हयन्नेव रामस्तु त्वरितस्तं समासदत् । \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136125, "chapter_id": 3952, "verse_number": "", "content_sanskrit": "श्रीरामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136126, "chapter_id": 3952, "verse_number": "१७", "content_sanskrit": "अपि जीवति वैदेही नेति पश्यामि लक्ष्मण \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136127, "chapter_id": 3952, "verse_number": "१८", "content_sanskrit": "तस्य तत्सर्वमाचख्यौ सीताया लक्ष्मणो वचः ।\nयदुक्तवत्यसदृशं वैदेही पश्चिमं वचः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136128, "chapter_id": 3952, "verse_number": "१९", "content_sanskrit": "दह्यमानेन तु हृदा रामोऽभ्यपतदाश्रमम् ।\nस ददर्श तदा गृध्रं निहतं पर्वतोपमम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136129, "chapter_id": 3952, "verse_number": "२०", "content_sanskrit": "राक्षसं शङ्कमानस्तं विकृष्य बलवद्धनुः ।\nअभ्यधावत काकुत्स्थस्ततस्तं सहलक्ष्मणः ।\nस तावुवाच तेजस्वी सहितौ रामलक्ष्मणौ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136130, "chapter_id": 3952, "verse_number": "", "content_sanskrit": "जटायुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136131, "chapter_id": 3952, "verse_number": "२१", "content_sanskrit": "गृध्रराजोऽस्मि भद्रं वां सखा दशरथस्य वै \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136132, "chapter_id": 3952, "verse_number": "२२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सङ्गृह्य धनुषी शुभे ।\nकोऽयं पितरमस्माकं नाम्नाऽऽहेत्यूचतुश्च तौ ।\nततो ददृशतुस्तौ तं छिन्नपक्षद्वयं खगम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136133, "chapter_id": 3952, "verse_number": "२३", "content_sanskrit": "तयोः शशंस गृध्रस्तु सीतार्थे रावणाद् वधम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136134, "chapter_id": 3952, "verse_number": "२४", "content_sanskrit": "अपृच्छद् राघवो गृध्रं रावणः कां दिशं गतः।\nतस्य गृध्रः शिरःकम्पैराचचक्षे ममार च \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136135, "chapter_id": 3952, "verse_number": "२५", "content_sanskrit": "दक्षिणामिति काकुत्स्थो विदित्वास्य तदिङ्गितम् ।\nसंस्कारं लम्भयामास सखायं पूजयन् पितुः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136136, "chapter_id": 3952, "verse_number": "२६", "content_sanskrit": "ततो दृष्ट्वाऽऽश्रमपदं व्यपविद्धबृसीमठम् ।\nविध्वस्तकलशं शून्यं गोमायुशतसङ्कुलम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136137, "chapter_id": 3952, "verse_number": "२७", "content_sanskrit": "दुःखशोकसमाविष्टौ वैदेहीहरणार्दितौ ।\nजग्मतुर्दण्डकारण्यं दक्षिणेन परन्तपौ \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136138, "chapter_id": 3952, "verse_number": "२८", "content_sanskrit": "वने महति तस्मिंस्तु रामः सौमित्रिणा सह ।\nददर्श मृगयूथानि द्रवमाणानि सर्वशः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136139, "chapter_id": 3952, "verse_number": "२९", "content_sanskrit": "शब्दं च घोरं सत्त्वानां दावाग्नेरिव वर्धनः(तः)।\nअपश्येतां मुहूर्ताच्च कबन्धं घोरदर्शनम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136140, "chapter_id": 3952, "verse_number": "३०", "content_sanskrit": "मेघपर्वतसङ्काशं शालस्कन्धं महाभुजम् ।\nउरोगतविशालाक्षं महोदरमहामुखम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136141, "chapter_id": 3952, "verse_number": "३१", "content_sanskrit": "यदृच्छयाथ तद्रक्षः करे जग्राह लक्ष्मणम् ।\nविषादमगमत् सद्यः सौमित्रिरथ भारत \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136142, "chapter_id": 3952, "verse_number": "३२", "content_sanskrit": "स राममभिसम्प्रेक्ष्य कृष्यते येन तन्मुखम् ।\nविषण्णश्चाब्रवीद् रामं पश्यावस्थामिमां मम \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136143, "chapter_id": 3952, "verse_number": "३३", "content_sanskrit": "हरणं चैव वैदेह्या मम चायमुपप्लवः ।\nराज्यभ्रंशश्च भवतस्तातस्य मरणं तथा \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136144, "chapter_id": 3952, "verse_number": "३४", "content_sanskrit": "नाहं त्वां सह वैदेह्या समेतं कोसलागतम् ।\nद्रक्ष्यामि पृथिवीराज्ये पितृपैतामहे स्थितम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136145, "chapter_id": 3952, "verse_number": "३५", "content_sanskrit": "द्रक्ष्यन्त्यार्यस्य धन्या ये कुशलाजशमीदलैः।\nअभिषिक्तस्य वदनं सोमं शान्तघनं यथा \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136146, "chapter_id": 3952, "verse_number": "३६", "content_sanskrit": "एवं बहुविधं धीमान् विललाप स लक्ष्मणः ।\nतमुवाचाथ काकुत्स्थः सम्भ्रमेष्वप्यसम्भ्रमः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136147, "chapter_id": 3952, "verse_number": "३७", "content_sanskrit": "मा विषीद नरव्याघ्र नैष कश्चिन्मयि स्थिते ।\nछिन्ध्यस्य दक्षिणं बाहुं छिन्नः सव्यो मया भुजः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136148, "chapter_id": 3952, "verse_number": "३८", "content_sanskrit": "शक्तो धर्षयितुं वीर सुमित्रानन्दवर्धन\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136149, "chapter_id": 3952, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136150, "chapter_id": 3952, "verse_number": "३९", "content_sanskrit": "इत्येवं वदता तस्य भुजो रामेण पातितः ।\nखड्गेन भृशतीक्ष्णेन निकृत्तस्तिलकाण्डवत् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136151, "chapter_id": 3952, "verse_number": "४०", "content_sanskrit": "ततोऽस्य दक्षिणं बाहुं खड्गेनाजघ्निवान् बली ।\nसौमित्रिरपि सम्प्रेक्ष्य भ्रातरं राघवं स्थितम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136152, "chapter_id": 3952, "verse_number": "४१", "content_sanskrit": "पुनर्जघान पार्श्वे वै तद्रक्षो लक्ष्मणो भृशम् ।\nगतासुरपतद् भूमौ कबन्धः सुमहांस्ततः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136153, "chapter_id": 3952, "verse_number": "४२", "content_sanskrit": "तस्य देहात् विनिःसृत्य पुरुषो दिव्यदर्शनः ।\nददृशे दिवमास्थाय दिवि सूर्य इव ज्वलन् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136154, "chapter_id": 3952, "verse_number": "४३", "content_sanskrit": "पप्रच्छ रामस्तं वाग्मी कस्त्वं प्रब्रूहि पृच्छतः ।\nकामया किमिदं चित्रमाश्चर्यं प्रतिभाति मे \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136155, "chapter_id": 3952, "verse_number": "४४", "content_sanskrit": "तस्याचचक्षे गन्धर्वो विश्वावसुरहं नृप ।\nप्राप्तो ब्राह्मणशापेन योनिं राक्षससेविताम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2136156, "chapter_id": 3952, "verse_number": "४५", "content_sanskrit": "रावणेन हृता सीता राज्ञा लङ्काधिवासिना ।\nसुग्रीवमभिगच्छस्व स ते साह्यं करिष्यति \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2136157, "chapter_id": 3952, "verse_number": "४६", "content_sanskrit": "एषा पम्पा शिवजला हंसकारण्डवैर्यु(वायु)ता ।\nऋष्यमूकस्य शैलस्य सन्निकर्षे तटाकिनी \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2136158, "chapter_id": 3952, "verse_number": "४७", "content_sanskrit": "वसते तत्र सुग्रीवश्चतुर्भिः सचिवैः सह ।\nभ्राता वानरराजस्य वालिनो हेममालिनः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2136159, "chapter_id": 3952, "verse_number": "४८", "content_sanskrit": "तेन त्वं सह सङ्गम्य दुःखमूलं निवेदय ।\nसमानशीलो भवतः साहाय्यं स करिष्यति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2136160, "chapter_id": 3952, "verse_number": "५०", "content_sanskrit": "इत्युक्त्वान्तर्हितो दिव्यः पुरुषः स महाप्रभः ।\nविस्मयं जग्मतुश्चोभौ प्रवीरौ रामलक्ष्मणौ \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2136161, "chapter_id": 3952, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अष्टषष्ट्यधिकद्विशततमोऽध्यायः ॥२६८॥\nरामोपाख्यानपर्वणि कबन्धहनने अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]