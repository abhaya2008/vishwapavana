[{"id": 2021831, "chapter_id": 1452, "verse_number": "३-९०-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021832, "chapter_id": 1452, "verse_number": "३-९०-१", "content_sanskrit": "धनंजयेन चाप्युक्तं यत्तच्छृणु युधिष्ठिर।\nयुधिष्ठिरं भ्रातरं मे योजयेर्धर्म्यया धिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021833, "chapter_id": 1452, "verse_number": "३-९०-२", "content_sanskrit": "त्वं हि धर्मान्परान्वेत्थ तपांसि च तपोधन।\nश्रीमतां चापि जानासि धर्मं राज्ञां सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021834, "chapter_id": 1452, "verse_number": "३-९०-३", "content_sanskrit": "स भवान्परमं वेद रपावनं पुरुषं प्रति।\nतेन संयोजयेथास्त्वं तीर्थपुण्येन पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021835, "chapter_id": 1452, "verse_number": "३-९०-४", "content_sanskrit": "यथा तीर्थानि गच्छेत गाश्च दद्यात्स पार्थिवः।\nतथा सर्वात्मना कार्यमिति मामर्जुनोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021836, "chapter_id": 1452, "verse_number": "३-९०-५", "content_sanskrit": "भवता चानुगुप्तोऽसौ चरेत्तीर्थानि सर्वशः।\nरक्षोभ्यो रक्षितव्यश्च दुर्गेषु विषमेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021837, "chapter_id": 1452, "verse_number": "३-९०-६", "content_sanskrit": "दधीच इव देवेन्द्रं यथा चाप्यङ्गिरा रविम्।\nतथा रक्षस्व कौन्तेयान्राक्षसेभ्यो द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021838, "chapter_id": 1452, "verse_number": "३-९०-७", "content_sanskrit": "यातुधाना हि बहवो राक्षसाः पर्वतोपमाः।\nत्वयाऽभिगुप्तान्कौन्तेयान्न विवर्तेयुरन्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021839, "chapter_id": 1452, "verse_number": "३-९०-८", "content_sanskrit": "सोऽहमिन्द्रस्य वचनान्नियोगादर्जुनस्य च।\nरक्षमाणो भयेभ्यस्त्वां चरिष्यामि त्वा सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021840, "chapter_id": 1452, "verse_number": "३-९०-९", "content_sanskrit": "द्विस्तीर्थानि मया पूर्वं दृष्टानि कुरुनन्दन।\nइदं तृतीयं द्रक्ष्यामि तान्येव भवता सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021841, "chapter_id": 1452, "verse_number": "३-९०-१०", "content_sanskrit": "इयं राजर्षिभिर्याता पुण्यकृद्भिर्युधिष्ठिर।\nमन्वादिभिर्महाराज तीर्थयात्रा भयापहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021842, "chapter_id": 1452, "verse_number": "३-९०-११", "content_sanskrit": "नानृजुर्नाकृतात्मा च नाविद्यो न च पापकृत्।\nस्नाति तीर्थेषु कौरव्य न च वक्रमतिर्नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021843, "chapter_id": 1452, "verse_number": "३-९०-१२", "content_sanskrit": "त्वं तु धर्ममतिर्नित्यं धर्मज्ञः सत्यसंगरः।\nविमुक्तः सर्वपापेभ्यो भूय एव भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021844, "chapter_id": 1452, "verse_number": "३-९०-१३", "content_sanskrit": "यथा भगीरथो राजा राजानश्च गयादयः।\nयथा ययातिः कौन्तेय तथा त्वमपि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021845, "chapter_id": 1452, "verse_number": "३-९०-१४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021846, "chapter_id": 1452, "verse_number": "३-९०-१४", "content_sanskrit": "न हर्षात्संप्रपश्यामि वाक्यस्यास्योत्तरं क्वचित्।\nयन्मां स्मरति देवेशः किं नामाभ्यधिकं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021847, "chapter_id": 1452, "verse_number": "३-९०-१५", "content_sanskrit": "भवता संगमो यस् भ्राता चैव धनंजयः।\nवासवः स्मरते यस् को नामाभ्यधिकस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021848, "chapter_id": 1452, "verse_number": "३-९०-१६", "content_sanskrit": "यच्च मां भगवानाह तीर्थानां गमनं प्रति।\nधौम्यस्य वचनादेषा बुद्धिः पूर्वं कृतैव मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021849, "chapter_id": 1452, "verse_number": "३-९०-१७", "content_sanskrit": "तद्यदा मन्यसे ब्रह्मन्गमनं तीर्तदर्शने।\nतदैव गन्तास्मि तीर्तान्येष मे निश्चयः परः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021850, "chapter_id": 1452, "verse_number": "३-९०-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021851, "chapter_id": 1452, "verse_number": "३-९०-१८", "content_sanskrit": "गमने कृतबुद्धिं तं पाण्डवं लोमशोऽब्रवीत्।\nलघुर्भव महाराज लघुः स्वैरं गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021852, "chapter_id": 1452, "verse_number": "३-९०-१९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021853, "chapter_id": 1452, "verse_number": "३-९०-१९", "content_sanskrit": "भिक्षाभुजो निवर्तन्तां ब्राह्मणा यतयश्च ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021854, "chapter_id": 1452, "verse_number": "३-९०-२०", "content_sanskrit": "क्षुत्तृडध्वश्रमायासशीतार्तिमसहिष्णवः।\nते सर्वे विनिवर्तन्तां ये च मृष्टभुजो द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021855, "chapter_id": 1452, "verse_number": "३-९०-२१", "content_sanskrit": "पक्वान्नलेह्यपानानां मांसानां च विकल्पकाः।\nतेऽपि सर्वे निवर्तन्तां ये च सूदानुयायिनः।\nमया यथोचिताऽऽजीव्यौः संविभक्ताश्च वृत्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021856, "chapter_id": 1452, "verse_number": "३-९०-२२", "content_sanskrit": "ये चाप्यनुगताः पौरा राजभक्तिपुरःसराः।\nधृतराष्ट्रं महाराजमभिगच्छन्तु ते च वै।\nस दास्यति यथाकालमुचिता यस्य या भृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021857, "chapter_id": 1452, "verse_number": "३-९०-२३", "content_sanskrit": "स चेद्यथोचितां वृत्तिं न दद्यान्मनुजेश्वरः।\nअस्मत्प्रियहितार्थायपाञ्चाल्यो वः प्रदास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021858, "chapter_id": 1452, "verse_number": "३-९०-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021859, "chapter_id": 1452, "verse_number": "३-९०-२४", "content_sanskrit": "ततो भूयिष्ठशः पौरा गुरौ भारे समाहिते।\nविप्राश्च यतयो मुख्या जग्मुर्नागपुरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021860, "chapter_id": 1452, "verse_number": "३-९०-२५", "content_sanskrit": "तान्सर्वान्धर्मराजस्य प्रेम्णा राजाऽम्बिकासुतः।\nप्रतिजग्राह विधिवद्धनैश्च समतर्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2021861, "chapter_id": 1452, "verse_number": "३-९०-२६", "content_sanskrit": "ततः कुन्तीसुतो राजा लघुभिर्ब्राह्मणैः सह।\nलोमशेन च सुप्रीतस्त्रिरात्रं काम्यकेऽवसत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2021862, "chapter_id": 1452, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि नवतितमोऽध्यायः ॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]