[{"id": 7006037000, "chapter_id": 26037, "verse_number": "१-२२१-१", "content_sanskrit": "ब्रह्मोवाच ।\nधर्मसारमहं वक्ष्ये संक्षेपाच्छुणु शङ्कर ।\nभुक्तिमुक्तिप्रदं सूक्ष्मं सर्वपापविनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006037001, "chapter_id": 26037, "verse_number": "१-२२१-२", "content_sanskrit": "श्रुतं धर्मं बलं धैर्यं सुखमुत्साहमेव च ।\nशोको हरति वै नॄणां तस्माच्छोकं परित्यजेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006037002, "chapter_id": 26037, "verse_number": "१-२२१-३", "content_sanskrit": "कर्मदाराः कर्मलोकाः कर्मसम्बन्धिबान्धवाः। ।\nकर्माणि प्रेरयन्तीह पुरुषं सुखदुः खयोः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006037003, "chapter_id": 26037, "verse_number": "१-२२१-४", "content_sanskrit": "दानमे परो धर्मो दानात्सर्वमवाप्यते ।\nदानाःत्स्वर्गश्च राज्यञ्च दद्याद्दनं ततो नरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006037004, "chapter_id": 26037, "verse_number": "१-२२१-५", "content_sanskrit": "एकतो दानमेवाहुः समग्रवरदक्षिणम् ।\nएकतो भयभीतस्य प्राणिनः प्राणरक्षणम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006037005, "chapter_id": 26037, "verse_number": "१-२२१-६", "content_sanskrit": "तपसा ब्रह्मचर्येण यज्ञैः स्नानेन वा पुन ।\nधर्मस्य नाशका ये च ते वै निरयगामिनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006037006, "chapter_id": 26037, "verse_number": "१-२२१-७", "content_sanskrit": "ये च होमजपस्नानदेवतार्चनतत्पराः ।\nसत्यक्षमादयायुक्तास्ते नराः स्वर्गगामिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006037007, "chapter_id": 26037, "verse_number": "१-२२१-८", "content_sanskrit": "न दाता सुखदुः खानां न च हर्तास्ति कश्चन। ।\nभुञ्जते स्वकृतान्येव दुः खानि च सुखानि च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006037008, "chapter_id": 26037, "verse_number": "१-२२१-९", "content_sanskrit": "धर्मार्थं जीवितं येषां दुर्गाण्यतितरन्ति ते ।\nसन्तुष्टः को न शक्नोति फलमूलैश्च वर्तितुम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006037009, "chapter_id": 26037, "verse_number": "१-२२१-१०", "content_sanskrit": "सर्व एव हि सौख्येन सङ्कटान्यवगाहते ।\nइदमेव हि लोभस्य कार्यं स्या दतिदुष्करम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006037010, "chapter_id": 26037, "verse_number": "१-२२१-११", "content_sanskrit": "लोभात्क्रोधः प्रभवति लोभाद्द्रोहः प्रवर्तते ।\nलोभान्मोहश्च माया च मानो मत्सर एव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006037011, "chapter_id": 26037, "verse_number": "१-२२१-१२", "content_sanskrit": "रागद्वेषानृतक्रोधलोममोहमदोज्झितः ।\nयः स शान्तः परं लोकं याति पापविवर्जितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006037012, "chapter_id": 26037, "verse_number": "१-२२१-१३", "content_sanskrit": "देवता मुनयो नागा गन्धर्वा गुह्यका हर ।\nधार्मिकं पूजयन्तीह न धनाढ्यं न कामिनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006037013, "chapter_id": 26037, "verse_number": "१-२२१-१४", "content_sanskrit": "अनन्तबलवीर्येण प्रज्ञया पौरुषेण वा ।\nअलभ्यं लभते मर्त्यस्तत्र का परिवेदना ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006037014, "chapter_id": 26037, "verse_number": "१-२२१-१५", "content_sanskrit": "सर्वसत्त्वदयालुत्वं सर्वेन्द्रियविनिग्रहः ।\nसर्वत्रानित्यबुद्धित्वं श्रेयः परमिदं स्मृतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006037015, "chapter_id": 26037, "verse_number": "१-२२१-१६", "content_sanskrit": "पश्यन्निवाग्रतो मृत्युं यो धर्मं नाचरेन्नरः ।\nअजागलस्तनस्येव तस्य जन्म निरर्थकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006037016, "chapter_id": 26037, "verse_number": "१-२२१-१७", "content_sanskrit": "भ्रूणहा ब्रह्महा गोघ्नः पितृहा गुरुतल्पगः ।\nभूमिं सर्वगुणोपेतां दत्त्वा पापैः प्रमुच्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006037017, "chapter_id": 26037, "verse_number": "१-२२१-१८", "content_sanskrit": "न गोदानात्परं दानं किञ्चिदस्तीति मे मतिः ।\nया गौर्न्यायार्जिता दत्ता कृत्स्नं तारयते कुलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006037018, "chapter_id": 26037, "verse_number": "१-२२१-१९", "content_sanskrit": "नान्नदानात्परं दानं किञ्चिदस्ति वृषध्वज ।\nअन्नेन धार्यते सर्वं चराचरमिदं जगत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006037019, "chapter_id": 26037, "verse_number": "१-२२१-२०", "content_sanskrit": "कन्यादानं वृषोत्सर्गस्तीर्थसेवा श्रुतं थ ।\nहस्त्यश्वरथदानानि मणिरत्नवसुन्धराः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006037020, "chapter_id": 26037, "verse_number": "१-२२१-२१", "content_sanskrit": "अन्नदानस्य सर्वाणि कलां नार्हन्ति षोडशीम् ।\nअन्नात्प्राणा बलं तेजश्चान्नाद्वीर्यं धृतिः स्मृतिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006037021, "chapter_id": 26037, "verse_number": "१-२२१-२२", "content_sanskrit": "कूपवापीतडागादीनारामांश्चैव कारयेत् ।\nत्रिसप्तकुलमुद्धृत्य विष्णुलोके महीयते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006037022, "chapter_id": 26037, "verse_number": "१-२२१-२३", "content_sanskrit": "साधूनां दर्शनं पुण्यं तीर्थादपि विशिष्यत। ।\nकालेन तीर्थं फलति सद्यः साधुसमागमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006037023, "chapter_id": 26037, "verse_number": "१-२२१-२४", "content_sanskrit": "सत्यं दमस्तपः शौचं सन्तोषश्च क्षमार्म् ।\nज्ञानं शमो दया दानमेष धर्मः सनातनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]