[{"id": 7002893000, "chapter_id": 22893, "verse_number": "९-१७८-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nभगवाञ्छंकरः पूर्वं कृतोद्वाहो मया सह ।\nरममाणस्तया सार्द्धं बहुवर्षगणान्स्थितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002893001, "chapter_id": 22893, "verse_number": "९-१७८-२", "content_sanskrit": "ततः सुरगणाः सर्वे परं त्रासमुपागताः ।\nतयोरपत्यस्य भयात्तमेव शरणं गताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002893002, "chapter_id": 22893, "verse_number": "९-१७८-३", "content_sanskrit": "वैश्वानरमुखा देवा महादेवं त्रिलोचनम् ।\nप्रसन्नश्चाभवत्तेषां विबुधानां त्रिलोचनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002893003, "chapter_id": 22893, "verse_number": "९-१७८-४", "content_sanskrit": "ईश्वर उवाच ।\nकिं भीतास्त्रिदशाः सर्वे कं वरं च ददामि वः ।\nमयि प्रसन्ने विबुधा दुर्लभं हि न किंचन ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002893004, "chapter_id": 22893, "verse_number": "९-१७८-५", "content_sanskrit": "देवा ऊचुः ।\nभगवंस्तव संयोगात्पार्वत्या सह शंकर ।\nमोघो भवतु देवेश भीताः स्म तनयस्य ते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002893005, "chapter_id": 22893, "verse_number": "९-१७८-६", "content_sanskrit": "अनपत्यश्च देवेश भव भूतपते सदा ।\nअशक्ताः स्म वयं सर्वे भवदोजो विधारणे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002893006, "chapter_id": 22893, "verse_number": "९-१७८-७", "content_sanskrit": "श्रीभगवानुवाच ।\nअतः प्रभृत्यहं देवा ऊर्ध्वरेता व्यवस्थितः ।\nस्थाणुवच्च स्थितश्चास्मि नाम चैतद्भविष्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002893007, "chapter_id": 22893, "verse_number": "९-१७८-८", "content_sanskrit": "ततः क्रुद्धा उमा तेषां देवानां वाक्यमब्रवीत् ।\nवितथं पुत्रजं सौख्यं भवद्भिर्मे कृतं सुराः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002893008, "chapter_id": 22893, "verse_number": "९-१७८-९", "content_sanskrit": "यस्मात्तस्माद्भवंतोऽपि न पुत्राञ्जनयिष्यथ ।\nततः प्रभृति वै देवाः प्रसूयंते न भूपते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002893009, "chapter_id": 22893, "verse_number": "९-१७८-१०", "content_sanskrit": "दत्त्वा शापं ततो देवी देवानामाह शंकरम् ।\nपुत्रजन्म मया प्राप्तं न तावज्जगतः पते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002893010, "chapter_id": 22893, "verse_number": "९-१७८-११", "content_sanskrit": "अपुत्रस्य गतिर्नास्ति इतीयं श्रूयते श्रुतिः ।\nतदादिश महाभाग लोकद्वयहितं प्रभो ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002893011, "chapter_id": 22893, "verse_number": "९-१७८-१२", "content_sanskrit": "भगवानुवाच ।\nअपुत्रः पुरुषो यश्च नारी वा पर्वतात्मजे ।\nसौवर्णस्तेन दातव्यः कल्पवृक्षो गुणान्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002893012, "chapter_id": 22893, "verse_number": "९-१७८-१३", "content_sanskrit": "कृत्रिमं वापि गृह्णीयाद्वृक्षं वा स्थावरादिकम् ।\nजातपुत्रोऽथ वा पुत्रः पुत्रत्वे परिकल्पयेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002893013, "chapter_id": 22893, "verse_number": "९-१७८-१४", "content_sanskrit": "तेन पुत्रवतां लोका देवि तस्य न संशयः ।\nकल्पवृक्षस्तु कर्तव्यः शुद्धकांचनसंभवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002893014, "chapter_id": 22893, "verse_number": "९-१७८-१५", "content_sanskrit": "बहुशाखः सुवर्णांगोप्यनेककुसुमान्वितः ।\nमहास्कंधस्वरूपश्च रत्नालंकृतविग्रहः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002893015, "chapter_id": 22893, "verse_number": "९-१७८-१६", "content_sanskrit": "फलानि तस्य दिव्यानि सौवर्णानि प्रकल्पयेत् ।\nकुर्याविंशत्पलादूर्द्ध्वं शक्त्या वा नृपसत्तम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002893016, "chapter_id": 22893, "verse_number": "९-१७८-१७", "content_sanskrit": "दानमेतत्प्रदातव्यं राजतं चैवमुत्तमम् ।\nप्रवालांकुरसंछन्नं मुक्तादामावलंबितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002893017, "chapter_id": 22893, "verse_number": "९-१७८-१८", "content_sanskrit": "चतुष्कोणेषु कुर्वीत चतुरः कांचनद्रुमान् ।\nसुवर्णस्य प्रमाणं च कथयामि वरानने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002893018, "chapter_id": 22893, "verse_number": "९-१७८-१९", "content_sanskrit": "सहस्रेण तदर्द्धेन तस्याप्यर्द्धेन वा पुनः ।\nनद्यास्तीरे गृहे वापि देवतायतने तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002893019, "chapter_id": 22893, "verse_number": "९-१७८-२०", "content_sanskrit": "प्रागुदक्प्रवणे देशे मंडपं तत्र कारयेत् ।\nदशहस्तप्रमाणेन दशहस्ताश्च वेदिकाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002893020, "chapter_id": 22893, "verse_number": "९-१७८-२१", "content_sanskrit": "हस्तमात्रप्रमाणेन कुंडमेकं सुशोभनम् ।\nआग्नेय्यां कारयेद्राजन्मेखलामुपलेपनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002893021, "chapter_id": 22893, "verse_number": "९-१७८-२२", "content_sanskrit": "तत्र वै ब्राह्मणा योज्या ऋग्यजुःसामपाठकाः ।\nउपदेष्टा च तत्रैव तृतीयः पंचमोऽथ वा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002893022, "chapter_id": 22893, "verse_number": "९-१७८-२३", "content_sanskrit": "सर्वाभरणसंपन्नास्ताम्रपत्रद्वयान्विताः ।\nअनुलिप्ताश्चंदनेन वस्त्रमाल्यादिभूषिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002893023, "chapter_id": 22893, "verse_number": "९-१७८-२४", "content_sanskrit": "गुडप्रस्थोपरिष्टाच्च स्थापयेत्कल्पपादपम् ।\nब्रह्मविष्णुशिवोपेतं पंचशाखं सभास्करम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002893024, "chapter_id": 22893, "verse_number": "९-१७८-२५", "content_sanskrit": "कामदेवमधस्ताच्च सकलत्र प्रयोजयेत् ।\nसंतानं सह गायत्र्या पूर्वतो लवणोपरि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002893025, "chapter_id": 22893, "verse_number": "९-१७८-२६", "content_sanskrit": "मंदारं दक्षिणे पार्श्वे श्रिया सह तथा घृते ।\nपश्चिमे पारिजातं तु उमया सह पादपम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002893026, "chapter_id": 22893, "verse_number": "९-१७८-२७", "content_sanskrit": "सुरभीसंयुतं तद्वत्तिलेषु हरिचंदनम् ।\nकौशेयवस्त्रसंयुक्तानिक्षुमाल्यफलान्वितान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002893027, "chapter_id": 22893, "verse_number": "९-१७८-२८", "content_sanskrit": "तथाष्टौ पूर्णकलशान्समंतात्परिकल्पयेत् ।\nअग्निप्रणयनं कृत्वा अधिवास्य च पादपान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002893028, "chapter_id": 22893, "verse_number": "९-१७८-२९", "content_sanskrit": "धान्यानि चैव सर्वाणि समंतात्परिकल्पयेत् ।\nनाना भक्ष्याणि नैवेद्यं सर्वं तत्र नियोजयेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002893029, "chapter_id": 22893, "verse_number": "९-१७८-३०", "content_sanskrit": "दीपमाला विचित्राश्च ज्वालयेत समंततः ।\nमंत्रेण योजयित्वा ता मयोक्तेन वरानने ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002893030, "chapter_id": 22893, "verse_number": "९-१७८-३१", "content_sanskrit": "कामदस्त्वं हि देवानां कामवृक्षस्ततः स्मृतः ।\nमया संपूजितो भक्त्या पूरयस्व मनोरथान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002893031, "chapter_id": 22893, "verse_number": "९-१७८-३२", "content_sanskrit": "एवं संपूज्य विधिना जागरं तत्र कारयेत् ।\nशंखवादित्रनिर्घोषैर्वेदध्वनिविमिश्रितैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002893032, "chapter_id": 22893, "verse_number": "९-१७८-३३", "content_sanskrit": "होमं च ब्राह्मणाः कुर्युर्मद्गतेनांतरात्मना ।\nआघारावाज्यभागौ तु पूर्वं हुत्वा विचक्षणः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002893033, "chapter_id": 22893, "verse_number": "९-१७८-३४", "content_sanskrit": "तल्लिंगैः स्थापितान्देवान्होमेनाप्याययेत्ततः ।\nमहाव्याहृतिभिश्चैव होमं कुर्युस्ततः परम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002893034, "chapter_id": 22893, "verse_number": "९-१७८-३५", "content_sanskrit": "अयुतेन भवेत्सिद्धिर्यज्ञस्य वरवर्णिनि ।\nततः प्रभाते चोत्थाय स्नात्वा शुक्लांबरः शुचिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002893035, "chapter_id": 22893, "verse_number": "९-१७८-३६", "content_sanskrit": "दद्यात्पर्वसमीपे तु कल्पवृक्षं सद क्षिणम् ।\nत्रिःप्रदक्षिणमावृत्य मंत्रमेतमुदीरयेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002893036, "chapter_id": 22893, "verse_number": "९-१७८-३७", "content_sanskrit": "नमस्ते कल्पवृक्षाय विततार्थप्रदाय च ।\nविश्वंभराय देवाय नमस्ते विश्वमूर्तये ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002893037, "chapter_id": 22893, "verse_number": "९-१७८-३८", "content_sanskrit": "यस्मात्त्वमेव विश्वात्मा ब्रह्मस्थाणुदिवाकराः ।\nमूर्तामूर्तपरं बीजमतः पाहि सनातन ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002893038, "chapter_id": 22893, "verse_number": "९-१७८-३९", "content_sanskrit": "एवमामन्त्र्य तं दृष्ट्वा गुरवे कल्पपादपम् ।\nचतुर्भ्यश्चापि ऋत्विग्भ्यः सामंतादीन्प्रकल्पयेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002893039, "chapter_id": 22893, "verse_number": "९-१७८-४०", "content_sanskrit": "अनेन विधिना यस्तु दानमेतत्प्रयच्छति ।\nतस्य पुण्यफलं देवि शृणुष्व गदतो मम ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002893040, "chapter_id": 22893, "verse_number": "९-१७८-४१", "content_sanskrit": "विमानवरमारुह्य सूर्यतेजःसमप्रभम् ।\nअप्सरोगणसंकीर्णं किंकिणीजालमालितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002893041, "chapter_id": 22893, "verse_number": "९-१७८-४२", "content_sanskrit": "याति लोकं सुरेशस्य सर्वबाधाविवर्जि तम् ।\nपुनः कर्मक्षितावेत्य जायते श्रोत्रिये कुले ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002893042, "chapter_id": 22893, "verse_number": "९-१७८-४३", "content_sanskrit": "यज्वा शूरोऽपि विद्वांश्च नरो भवति धार्मिकः ।\nपुनरंते प्राप्नुयाद्वै लोकं देवस्य शार्ङ्गिणः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]