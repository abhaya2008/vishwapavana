[{"id": 40003409, "chapter_id": 8887, "verse_number": "1", "content_sanskrit": "स एवं ब्रुवतीं सीतां धर्मज्ञो धर्मवत्सलः। न नेतुं कुरुते बुद्धिं वने दुःखानि चिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40003410, "chapter_id": 8887, "verse_number": "2", "content_sanskrit": "सान्त्वयित्वा पुनस्तां तु बाष्पदूषितलोचनाम्। निवर्तनार्थे धर्मात्मा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40003411, "chapter_id": 8887, "verse_number": "3", "content_sanskrit": "सीते महाकुलीनाऽसि धर्मे च निरता सदा। इहाऽचर स्वधर्मं त्वं मे यथा मनसस्सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40003412, "chapter_id": 8887, "verse_number": "4", "content_sanskrit": "सीते यथा त्वां वक्ष्यामि तथा कार्यं त्वयाऽबले। वने हि बहवो दोषा वदतस्तान्निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40003413, "chapter_id": 8887, "verse_number": "5", "content_sanskrit": "सीते विमुच्यतामेषा वनवासकृता मतिः। बहुदोषं हि कान्तारं वनमित्यभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40003414, "chapter_id": 8887, "verse_number": "6", "content_sanskrit": "हितबुद्ध्या खलु वचो मयैतदभिधीयते। सदा सुखं न जानामि दुःखमेव सदा वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40003415, "chapter_id": 8887, "verse_number": "7", "content_sanskrit": "गिरिनिर्झरसम्भूता गिरिकन्दर वासिनाम्। सिंहानां निनदा दुःखा श्श्रोतुं दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40003416, "chapter_id": 8887, "verse_number": "8", "content_sanskrit": "क्रीडमानाश्च विस्रब्धा मत्ता श्शून्ये महामृगाः। दृष्ट्वा समभिवर्तन्ते सीते दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40003417, "chapter_id": 8887, "verse_number": "9", "content_sanskrit": "सग्राहा स्सरितश्चैव पङ्कवत्यस्सु दुस्तराः। मत्तैरपि गजैर्नित्यमतो दुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40003418, "chapter_id": 8887, "verse_number": "10", "content_sanskrit": "लताकण्टकसङ्कीर्णाः कृकवाकूपनादिताः। निरपाश्च सुदुर्गाश्च मार्गा दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40003419, "chapter_id": 8887, "verse_number": "11", "content_sanskrit": "सुप्यते पर्णशय्यासु स्वयं भग्नासु भूतले। रात्रिषु श्रमखिन्नेन तस्माद्दुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40003420, "chapter_id": 8887, "verse_number": "12", "content_sanskrit": "अहोरात्रं च सन्तोषः कर्तव्यो नियतात्मना। फलैर्वृक्षावपतितै स्सीते दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40003421, "chapter_id": 8887, "verse_number": "13", "content_sanskrit": "उपवासश्च कर्तव्यो यथा प्राणेन मैथिलि। जटाभारश्च कर्तव्यो वल्कलाम्बरधारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40003422, "chapter_id": 8887, "verse_number": "14", "content_sanskrit": "देवतानां पित्रूणां कर्तव्यं विधिपूर्वकम्। प्राप्तानामतिथीनां च नित्यशः प्रतिपूजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40003423, "chapter_id": 8887, "verse_number": "15", "content_sanskrit": "कार्यस्त्रिरभिषेकश्च काले काले च नित्यशः। चरता नियमेनैव तस्माद्धुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40003424, "chapter_id": 8887, "verse_number": "16", "content_sanskrit": "उपहारश्च कर्तव्यः कुसुमै स्स्वयमाहृतैः। आर्षेण विधिना वेद्यां बाले दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40003425, "chapter_id": 8887, "verse_number": "17", "content_sanskrit": "यथालब्धेन कर्तव्यः सन्तोषस्तेन मैथिलि। यताहारैर्वनचरै र्नित्यं दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40003426, "chapter_id": 8887, "verse_number": "18", "content_sanskrit": "अतीव वातास्तिमिरं बुभुक्षा चात्र नित्यशः। भयानि च महान्त्यत्र ततो दुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40003427, "chapter_id": 8887, "verse_number": "19", "content_sanskrit": "सरीसृपाश्च बहवो बहुरूपाश्च भामिनि। चरन्ति पृथिवीं दर्पात्ततो दुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40003428, "chapter_id": 8887, "verse_number": "20", "content_sanskrit": "नदी निलयना स्सर्पा नदीकुटिलगामिनः। तिषठ्न्त्यावृत्य पन्थानं ततो दुःखतरं वनम्।।.2.28.20।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40003429, "chapter_id": 8887, "verse_number": "21", "content_sanskrit": "पतङ्गा वृश्चिकाः कीटा दंशाश्च मशकै स्सह। बाधन्ते नित्यमबले सर्वं दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40003430, "chapter_id": 8887, "verse_number": "22", "content_sanskrit": "द्रुमाः कण्टकिनश्चैव कुशा: काशाश्च भामिनि। वने व्याकुलशाखाग्रास्तेन दुःखतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40003431, "chapter_id": 8887, "verse_number": "23", "content_sanskrit": "कायक्लेशाश्च बहवो भयानि विविधानि च। अरण्यवासे वसतो दुःखमेव ततो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40003432, "chapter_id": 8887, "verse_number": "24", "content_sanskrit": "क्रोधलोभौ विमोक्तव्यौ कर्तव्या तपसे मतिः। न भेतव्यं च भेतव्ये नित्यं दुःखमतो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40003433, "chapter_id": 8887, "verse_number": "25", "content_sanskrit": "तदलं ते वनं गत्वा क्षमं न हि वनं तव। विमृशन्निह पश्यामि बहुदोषतरं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40003434, "chapter_id": 8887, "verse_number": "26", "content_sanskrit": "वनन्तु नेतुं न कृता मतिस्तदा बभूव रामेण यदा महात्मना। न तस्य सीता वचनं चकार त त्ततोऽब्रवीद्राममिदं सुदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]