[{"id": 7000492000, "chapter_id": 20492, "verse_number": "३-३९-१", "content_sanskrit": "नारद उवाच ।\nअथ संध्यां समासाद्य स विद्यांतीर्थमुत्तमम् ।\nउपस्पृश्य नरो विद्वान्भवेन्नास्त्यत्र संशयः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000492001, "chapter_id": 20492, "verse_number": "३-३९-२", "content_sanskrit": "रामस्य च प्रसादेन तीर्थराजं कृतं पुरा ।\nतल्लौहित्यं समासाद्य विंद्याद्बहुसुवर्णकम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000492002, "chapter_id": 20492, "verse_number": "३-३९-३", "content_sanskrit": "करतोयां समासाद्य त्रिरात्रोपोषितो नरः ।\nअश्वमेधमवाप्नोति शक्रलोकं च गच्छति॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000492003, "chapter_id": 20492, "verse_number": "३-३९-४", "content_sanskrit": "गंगायास्त्वथ राजेंद्र सागरस्य च संगमे ।\nअश्वमेधं दशगुणं प्रवदंति मनीषणः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000492004, "chapter_id": 20492, "verse_number": "३-३९-५", "content_sanskrit": "गंगायास्तु परं द्वीपं प्राप्य यः स्नाति भारत ।\nत्रिरात्रोपोषितो राजन्सर्वकाममवाप्नुयात्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000492005, "chapter_id": 20492, "verse_number": "३-३९-६", "content_sanskrit": "ततो वैतरणीं गत्वा नदीं पापप्रमोचनीम् ।\nविरजं तीर्थमासाद्य विराजति यथा शशी॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000492006, "chapter_id": 20492, "verse_number": "३-३९-७", "content_sanskrit": "प्रभावे च कुलं पूत्वा सर्वपापं व्यपोहति ।\nगोसहस्रफलं लब्ध्वा पुनाति स्वकुलं नरः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000492007, "chapter_id": 20492, "verse_number": "३-३९-८", "content_sanskrit": "शोणस्य ज्योतिरथ्याश्च संगमे निवसञ्छुचिः ।\nतर्पयित्वा पितॄन्देवानग्निष्टोमफलं लभेत्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000492008, "chapter_id": 20492, "verse_number": "३-३९-९", "content_sanskrit": "शोणस्य नर्मदायाश्च प्रभवे कुरुपुंगव ।\nवंशगुल्ममुपस्पृश्य वाजिमेधफलं लभेत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000492009, "chapter_id": 20492, "verse_number": "३-३९-१०", "content_sanskrit": "ऋषभं तीर्थमासाद्य कोशलायां नराधिप ।\nवाजिमेधमवाप्नोति त्रिरात्रोपोषितो नरः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000492010, "chapter_id": 20492, "verse_number": "३-३९-११", "content_sanskrit": "कोशलायां समासाद्य कालतीर्थमुपस्पृशेत् ।\nवृषभैकादशगुणं लभते नात्र संशयः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000492011, "chapter_id": 20492, "verse_number": "३-३९-१२", "content_sanskrit": "पुष्पवत्यामुपस्पृश्य त्रिरात्रोपोषितो नरः ।\nगोसहस्रफलं विंद्यात्कुलं चैव समुद्धरेत्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000492012, "chapter_id": 20492, "verse_number": "३-३९-१३", "content_sanskrit": "ततो बदारिकातीर्थे स्नात्वा प्रयतमानसः ।\nदीर्घायुष्यमवाप्नोति स्वर्गलोकं च गच्छति॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000492013, "chapter_id": 20492, "verse_number": "३-३९-१४", "content_sanskrit": "ततो महेंद्रमासाद्य जामदग्न्यनिषेवितम् ।\nरामतीर्थे नरः स्नात्वा वाजिमेधफलं लभेत्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000492014, "chapter_id": 20492, "verse_number": "३-३९-१५", "content_sanskrit": "मतंगस्य तु केदारं तत्रैव भरतर्षभ ।\nतत्र स्नात्वा नरो राजन्गोसहस्रफलं लभेत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000492015, "chapter_id": 20492, "verse_number": "३-३९-१६", "content_sanskrit": "श्रीपर्वतं समासाद्य नदीतीरमुपस्पृशेत् ।\nअश्वमेधमवाप्नोति परां सिद्धिं च गच्छति॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000492016, "chapter_id": 20492, "verse_number": "३-३९-१७", "content_sanskrit": "श्रीपर्वते महादेवो देव्या सह महाद्युतिः ।\nन्यवसत्परमप्रीतो ब्रह्मा च त्रिदशैर्वृतः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000492017, "chapter_id": 20492, "verse_number": "३-३९-१८", "content_sanskrit": "तत्र देवह्रदे स्नात्वा शुचिः प्रयतमानसः ।\nअश्वमेधमवाप्नोति परां सिद्धिं च गच्छति॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000492018, "chapter_id": 20492, "verse_number": "३-३९-१९", "content_sanskrit": "ऋषभं पर्वतं गत्वा भांडेषु सुरपूजितम् ।\nवाजपेयमवाप्नोति नाकपृष्ठे च मोदते॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000492019, "chapter_id": 20492, "verse_number": "३-३९-२०", "content_sanskrit": "ततो गच्छेत कावेरीं वृतामृप्सरसां गणैः ।\nतत्र स्नात्वा नरो राजन्गोसहस्रफलं लभेत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000492020, "chapter_id": 20492, "verse_number": "३-३९-२१", "content_sanskrit": "तत्र तीर्थे समुद्रस्य कन्यातीर्थमुपस्पृशेत् ।\nतत्रोपस्पृश्य राजेंद्र सर्वपापैः प्रमुच्यते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000492021, "chapter_id": 20492, "verse_number": "३-३९-२२", "content_sanskrit": "अथ गोकमर्णमासाद्य त्रिषुलोकेषु विश्रुतम् ।\nसमुद्रमध्ये राजेंद्र सर्वलोकनमस्कृतम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000492022, "chapter_id": 20492, "verse_number": "३-३९-२३", "content_sanskrit": "यत्र ब्रह्मादयो देवा मुनयश्च तपोधनाः ।\nभूतयक्षाः पिशाचाश्च किन्नराः समहोरगाः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000492023, "chapter_id": 20492, "verse_number": "३-३९-२४", "content_sanskrit": "सिद्धचारणगंधर्वा मानुषाः पन्नगास्तथा ।\nसरितः सागराः शैला उपासंते उमापतिम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000492024, "chapter_id": 20492, "verse_number": "३-३९-२५", "content_sanskrit": "तत्रेशानं समभ्यर्च्य त्रिरात्रोपोषितो नरः ।\nदशाश्वमेधमाप्नोति गाणपत्यं च विंदति॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000492025, "chapter_id": 20492, "verse_number": "३-३९-२६", "content_sanskrit": "उपोष्य द्वादशरात्रं कृतार्थो जायते नरः ।\nतस्मिन्नेव तु गायत्र्याः स्थानं त्रैलोक्यविश्रुतम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000492026, "chapter_id": 20492, "verse_number": "३-३९-२७", "content_sanskrit": "त्रिरात्रमुषितस्तत्र गोसहस्रफलं लभेत् ।\nनिदर्शनं च प्रत्यक्षं ब्राह्मणानां नराधिप॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000492027, "chapter_id": 20492, "verse_number": "३-३९-२८", "content_sanskrit": "गायत्रीं पठते यस्तु योनिसंकरजो द्विजः ।\nगाथा वा गीतिका वाणी तस्य संपद्यते नृप॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000492028, "chapter_id": 20492, "verse_number": "३-३९-२९", "content_sanskrit": "अब्राह्मणस्य पठतः सावित्री तूपनश्यति ।\nसंवर्तस्य तु विप्रर्षे वापीमासाद्य दुर्ल्लभाम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000492029, "chapter_id": 20492, "verse_number": "३-३९-३०", "content_sanskrit": "रूपस्य भागी भवति सुभगश्चाभिजायते ।\nततो वेणां समासाद्य तर्पयेत्पितृदेवताः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000492030, "chapter_id": 20492, "verse_number": "३-३९-३१", "content_sanskrit": "मयूरहंससंयुक्तं विमानं लभते नरः ।\nततो गोदावरीं प्राप्य नित्यसिद्धनिषेविताम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000492031, "chapter_id": 20492, "verse_number": "३-३९-३२", "content_sanskrit": "गवामयमवाप्नोति वायुलोकं च गच्छति ।\nवेणायाः संगमे स्नात्वा वाजपेयफलं लभेत्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000492032, "chapter_id": 20492, "verse_number": "३-३९-३३", "content_sanskrit": "वरदासंगमं स्नात्वा गोसहस्रफलं लभेत् ।\nब्रह्मस्थूणां समासाद्य त्रिरात्रोपोषितो नरः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000492033, "chapter_id": 20492, "verse_number": "३-३९-३४", "content_sanskrit": "गोसहस्रफलं विंद्यात्स्वर्गलोकं च गच्छति ।\nकुब्जावनं समासाद्य ब्रह्मचारी समाहितः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000492034, "chapter_id": 20492, "verse_number": "३-३९-३५", "content_sanskrit": "त्रिरात्रोपोषितः स्नात्वा गोसहस्रफलं लभेत् ।\nततो देवह्रदे स्नात्वा कृष्णवेणा जलोद्भवे॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000492035, "chapter_id": 20492, "verse_number": "३-३९-३६", "content_sanskrit": "ज्योतिर्मात्र ह्रदे चैव तथा कन्याश्रमे नृप ।\nयत्र क्रतुशतैरिष्ट्वा देवराजो दिवं गतः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000492036, "chapter_id": 20492, "verse_number": "३-३९-३७", "content_sanskrit": "अग्निष्टोमशतं विंद्याद्गमनादेव तत्र तु ।\nसर्वदेवह्रदे स्नात्वा गोसहस्रफलं लभेत्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000492037, "chapter_id": 20492, "verse_number": "३-३९-३८", "content_sanskrit": "जातिमात्र ह्रदे स्नात्वा भवेज्जातिस्मरो नरः ।\nशरभंगाश्रमं गत्वा शुकस्य च महात्मनः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000492038, "chapter_id": 20492, "verse_number": "३-३९-३९", "content_sanskrit": "पितृदेवार्चनरतो गोसहस्रफलं लभेत् ।\nदंडकारण्यमासाद्य महाराज उपस्पृशेत्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000492039, "chapter_id": 20492, "verse_number": "३-३९-४०", "content_sanskrit": "शरभंगाश्रमं गत्वा शुकस्य च महात्मनः ।\nन दुर्गतिमवाप्नोति पुनाति स्वकुलं नरः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000492040, "chapter_id": 20492, "verse_number": "३-३९-४१", "content_sanskrit": "ततः सूर्यारकं गच्छेज्जमदग्निनिषेवितम् ।\nरामतीर्थं नरः स्नात्वा विंद्याद्बहुसुवर्णकम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000492041, "chapter_id": 20492, "verse_number": "३-३९-४२", "content_sanskrit": "सप्तगोदावरीं स्नात्वा नियतो नियताशनः ।\nमहापुण्यमवाप्नोति देवलोकं च गच्छति॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000492042, "chapter_id": 20492, "verse_number": "३-३९-४३", "content_sanskrit": "ततो देवपथं गच्छेन्नियतो नियताशनः ।\nदेवसत्रस्य यत्पुण्यं तदवाप्नोति मानवः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000492043, "chapter_id": 20492, "verse_number": "३-३९-४४", "content_sanskrit": "तुंगकारण्यमासाद्य ब्रह्मचारी जितेंद्रियः ।\nवेदानध्यापयत्तत्र मुनीन्सारस्वतः पुरा॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000492044, "chapter_id": 20492, "verse_number": "३-३९-४५", "content_sanskrit": "तत्र वेदान्प्रणष्टांस्तु मुनेरांगिरसः सुतः ।\nउपविष्टो महर्षीणामुत्तरीयेषु भारत॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000492045, "chapter_id": 20492, "verse_number": "३-३९-४६", "content_sanskrit": "ओंकारेण यथान्यायंसम्यगुच्चारितेन ह ।\nयेन यत्पूर्वमभ्यस्तं तस्य तत्समुपस्थितम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000492046, "chapter_id": 20492, "verse_number": "३-३९-४७", "content_sanskrit": "ऋषयस्तत्र देवाश्च वरुणोऽग्निप्रजापतिः ।\nहरिर्नारायणो देवो महादेवस्तथैव च॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000492047, "chapter_id": 20492, "verse_number": "३-३९-४८", "content_sanskrit": "पितामहश्च भगवान्देवैस्सह महाद्युतिः ।\nभृगुं नियोजयामास याजनार्थे महाद्युतिम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000492048, "chapter_id": 20492, "verse_number": "३-३९-४९", "content_sanskrit": "ततः स चक्रे भगवानृषीणां विधिवत्तदा ।\nसर्वेषां पुनराधानं देवदृष्टेन कर्मणा॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000492049, "chapter_id": 20492, "verse_number": "३-३९-५०", "content_sanskrit": "आज्यभागेन वै तत्र तर्पितास्तु यथाविधि ।\nदेवास्त्रिभुवनं याता ऋषयश्च यथासुखम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000492050, "chapter_id": 20492, "verse_number": "३-३९-५१", "content_sanskrit": "तदरण्यं प्रविष्टस्य तुंगकं राजसत्तम ।\nपापं विनश्यते सद्यः स्त्रिया वै पुरुषस्य वा॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000492051, "chapter_id": 20492, "verse_number": "३-३९-५२", "content_sanskrit": "तत्र मासं वसेद्धीरो नियतो नियताशनः ।\nब्रह्मलोकं व्रजेद्राजन्पुनीते च कुलं पुनः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000492052, "chapter_id": 20492, "verse_number": "३-३९-५३", "content_sanskrit": "मेधावनं समासाद्य पितृदेवांश्च तर्पयेत् ।\nअग्निष्टोममवाप्नोति स्मृतिं मेधां च विंदति॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000492053, "chapter_id": 20492, "verse_number": "३-३९-५४", "content_sanskrit": "तत्र कालंजरं गत्वा गोसहस्रफलं लभेत् ।\nआत्मानं साधयेत्तत्र गिरौ कालंजरे नृप॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000492054, "chapter_id": 20492, "verse_number": "३-३९-५५", "content_sanskrit": "स्वर्गलोके महीयेत नरो नास्त्यत्र संशयः ।\nततो गिरिवरश्रेष्ठे चित्रकूटे विशांपते॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000492055, "chapter_id": 20492, "verse_number": "३-३९-५६", "content_sanskrit": "मंदाकिनीं समासाद्य नदीं पापविमोचनीम् ।\nअत्राभिषेकं कुर्वाणः पितृदेवार्चने रतः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000492056, "chapter_id": 20492, "verse_number": "३-३९-५७", "content_sanskrit": "अश्वमेधमवाप्नोति गतिं च परमां व्रजेत् ।\nततो गच्छेत राजेंद्र गुहस्थानमनुत्तमम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000492057, "chapter_id": 20492, "verse_number": "३-३९-५८", "content_sanskrit": "यत्र देवो महासेनो नित्यं सन्निहितो नृप ।\nपुमांस्तत्र नरःश्रेष्ठ गमनादेव सिध्यति॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000492058, "chapter_id": 20492, "verse_number": "३-३९-५९", "content_sanskrit": "कोटितीर्थे नरः स्नात्वा गोसहस्रफलं लभेत् ।\nप्रदक्षिणमुपावृत्य यशःस्थानं व्रजेन्नरः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000492059, "chapter_id": 20492, "verse_number": "३-३९-६०", "content_sanskrit": "अभिगम्य महादेवं विराजति यथा शशी ।\nतत्र कूपो महाराज विश्रुतो भरतर्षभ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000492060, "chapter_id": 20492, "verse_number": "३-३९-६१", "content_sanskrit": "समुद्रा यत्र चत्वारो निवसंति युधिष्ठिर ।\nततोपस्पृश्य राजेंद्र कृत्वा चापि प्रदक्षिणम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000492061, "chapter_id": 20492, "verse_number": "३-३९-६२", "content_sanskrit": "नियतात्मा नरः पूतो गच्छेत परमां गतिम् ।\nततो गच्छेत्कुरुश्रेष्ठ शृंगवेरपुरं महत्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000492062, "chapter_id": 20492, "verse_number": "३-३९-६३", "content_sanskrit": "यत्र तीर्णो महाप्राज्ञो रामो दाशरथिः पुरा ।\nगंगायां तु नरः स्नात्वा ब्रह्मचारी जितेंद्रियः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000492063, "chapter_id": 20492, "verse_number": "३-३९-६४", "content_sanskrit": "विधूतपाप्मा भवति वाजपेयं च विंदति ।\nततो मुंजवटं गछेत्स्थानं देवस्य धीमतः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000492064, "chapter_id": 20492, "verse_number": "३-३९-६५", "content_sanskrit": "अभिगम्य महादेवमभ्यर्च्य च नराधिप ।\nप्रदक्षिणमुपावृत्य गाणपत्यमवाप्नुयात्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000492065, "chapter_id": 20492, "verse_number": "३-३९-६६", "content_sanskrit": "ततो गच्छेत राजेंद्र प्रयागमृषिसंस्तुतम् ।\nयत्र ब्रह्मादयो देवा दिशश्च सदिगीश्वराः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000492066, "chapter_id": 20492, "verse_number": "३-३९-६७", "content_sanskrit": "लोकपालाश्च सिद्धाश्च निरताः पितरस्तथा ।\nसनत्कुमारप्रमुखास्तथैव च महर्षयः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000492067, "chapter_id": 20492, "verse_number": "३-३९-६८", "content_sanskrit": "तथा नागाः सुपर्णाश्च सिद्धाः शुक्रधरास्तथा ।\nसरितः सागराश्चैव गंधर्वाप्सरसस्तथा॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000492068, "chapter_id": 20492, "verse_number": "३-३९-६९", "content_sanskrit": "हरिश्च भगवानास्ते प्रजापतिपुरस्कृतः ।\nतत्र त्रीण्यपि कुंडानि तयोर्मध्येन जाह्नवी॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000492069, "chapter_id": 20492, "verse_number": "३-३९-७०", "content_sanskrit": "प्रयागात्समतिक्रांता सर्वतीर्थपुरस्कृता ।\nतपनस्य सुता तत्र त्रिषु लोकेषु विश्रुता॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000492070, "chapter_id": 20492, "verse_number": "३-३९-७१", "content_sanskrit": "यमुनागंगया सार्द्धं संगता लोकभाविनी ।\nगंगायमुनयोर्मध्ये पृथिव्या जघनं स्मृतम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000492071, "chapter_id": 20492, "verse_number": "३-३९-७२", "content_sanskrit": "प्रयागं जघनस्यांतमुपस्थमृषयो विदुः ।\nप्रयागं सुप्रतिष्ठानं कंबलाश्वतरावुभौ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000492072, "chapter_id": 20492, "verse_number": "३-३९-७३", "content_sanskrit": "तीर्थं भोगवती चैव वेदी प्रोक्ता प्रजापतेः ।\nतत्र वेदाश्च यज्ञाश्च मूर्त्तिमंतो युधिष्ठिर॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000492073, "chapter_id": 20492, "verse_number": "३-३९-७४", "content_sanskrit": "प्रजापतिमुपासंत ऋषयश्च महानघाः ।\nयजंते क्रतुभिर्देवांस्तथा चक्रधरा नृप॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000492074, "chapter_id": 20492, "verse_number": "३-३९-७५", "content_sanskrit": "ततः पुण्यतमं नास्ति त्रिषु लोकेषु भारत ।\nप्रयागं सर्वतीर्थेभ्यः प्रभावेणाधिकं प्रभो॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000492075, "chapter_id": 20492, "verse_number": "३-३९-७६", "content_sanskrit": "श्रवणात्तस्य तीर्थस्य नामसंकीर्तनादपि ।\nमूर्धका नमनाद्वापि सर्वपापैः प्रमुच्यते॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000492076, "chapter_id": 20492, "verse_number": "३-३९-७७", "content_sanskrit": "तत्राभिषेकं यः कुर्यात्संगमे संशितव्रतः ।\nपुण्यं सुमहदाप्नोति राजसूयाश्वमेधयोः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000492077, "chapter_id": 20492, "verse_number": "३-३९-७८", "content_sanskrit": "एषा यजनभूमिर्हि देवानामपि तत्कथा ।\nदत्तं तत्र स्वल्पमपि महद्भवति भारत॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000492078, "chapter_id": 20492, "verse_number": "३-३९-७९", "content_sanskrit": "न देववचनात्तात न लोकवचनादपि ।\nमतिरुत्क्रमणीया ते प्रयागमरणं प्रति॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000492079, "chapter_id": 20492, "verse_number": "३-३९-८०", "content_sanskrit": "दशतीर्थसहस्राणि षष्टिकोट्यस्तथापराः ।\nयेषां सान्निध्यमत्रैव कीर्त्तितं कुरुनंदन॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000492080, "chapter_id": 20492, "verse_number": "३-३९-८१", "content_sanskrit": "चतुर्विद्ये च यत्पुण्यं सत्यवादिषु चैव यत् ।\nस्नातएवतदाप्नोतिगंगायामुनसंगमे॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000492081, "chapter_id": 20492, "verse_number": "३-३९-८२", "content_sanskrit": "ततो भोगवती नाम वासुकेस्तीर्थमुत्तमम् ।\nतत्राभिषेकं यः कुर्यात्सोऽश्वमेधमवाप्नुयात्॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000492082, "chapter_id": 20492, "verse_number": "३-३९-८३", "content_sanskrit": "तत्र हंसप्रपतनं तीर्थं त्रैलोक्यविश्रुतम् ।\nदशाश्वमेधिकं चैव गंगायां कुरुनंदन॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000492083, "chapter_id": 20492, "verse_number": "३-३९-८४", "content_sanskrit": "कुरुक्षेत्रसमा गंगा यत्र तत्रावगाहिता ।\nविशेषो वै कनखले प्रयागं परमं महत्॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000492084, "chapter_id": 20492, "verse_number": "३-३९-८५", "content_sanskrit": "यद्यकार्यशतं कृत्वा कृतं गंगावसेवनम् ।\nसर्वं तत्तस्य गंगापो दहत्यग्निरिवेंधनम्॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000492085, "chapter_id": 20492, "verse_number": "३-३९-८६", "content_sanskrit": "सर्वं दहति गंगापस्तूलराशिमिवानलः ।\nसर्वं कृतयुगे पुण्यं त्रेतायां पुष्करं स्मृतम्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000492086, "chapter_id": 20492, "verse_number": "३-३९-८७", "content_sanskrit": "द्वापरे तु कुरुक्षेत्रं गंगा कलियुगे स्मृता ।\nपुष्करे तु तपस्तप्येद्दानं दद्यान्महालये॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000492087, "chapter_id": 20492, "verse_number": "३-३९-८८", "content_sanskrit": "मलये त्वग्निमारोहेद्भृगुतुंगे त्वनाशनम् ।\nपुष्करे तु कुरुक्षेत्रे गंगापो मध्यगेषु च॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000492088, "chapter_id": 20492, "verse_number": "३-३९-८९", "content_sanskrit": "सद्यस्तारयते जंतुः सप्तसप्तावरांस्तथा ।\nपुनाति कीर्त्तिता पापं दृष्ट्वा पुण्यं प्रयच्छति॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000492089, "chapter_id": 20492, "verse_number": "३-३९-९०", "content_sanskrit": "अवगाढा च पीत्वा च पुनात्यासप्तमं कुलम् ।\nयावदस्थि मनुष्यस्य गंगायाः स्पृशते जलम्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000492090, "chapter_id": 20492, "verse_number": "३-३९-९१", "content_sanskrit": "तावत्स पुरुषो राजन्स्वर्गलोके महीयते ।\nयथा पुण्यानि तीर्थानि पुण्यान्यायतनानि च॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000492091, "chapter_id": 20492, "verse_number": "३-३९-९२", "content_sanskrit": "उपास्य पुण्यं लब्ध्वा च भवति परलोकभाक् ।\nन गंगा सदृशं तीर्थं न देवः केशवात्परः॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000492092, "chapter_id": 20492, "verse_number": "३-३९-९३", "content_sanskrit": "ब्राह्मणेभ्यः परं नास्ति एवमाह पितामहः ।\nयत्र गंगा महाराज स देशस्तत्र योजनम्॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000492093, "chapter_id": 20492, "verse_number": "३-३९-९४", "content_sanskrit": "सिद्धक्षेत्रं च विज्ञेयं गंगातीरसमाश्रितम् ।\nइदं सत्यं द्विजातीनां साधूनां मानसेषु च॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000492094, "chapter_id": 20492, "verse_number": "३-३९-९५", "content_sanskrit": "मुक्तिं चैव जपेत्कर्णे शिष्टस्यानुगतस्य च ।\nइदं धर्म्यमिदं मेध्यमिदं स्वर्ग्यमिदं सुखम्॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000492095, "chapter_id": 20492, "verse_number": "३-३९-९६", "content_sanskrit": "इदं पुण्यतमं रम्यं पावनं धर्ममुत्तमम् ।\nमहीशीर्षमिदं गुह्यं सर्वपापप्रमोचनम्॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000492096, "chapter_id": 20492, "verse_number": "३-३९-९७", "content_sanskrit": "अधीत्य द्विजमध्ये च निर्मलत्वमवाप्नुयात् ।\nश्रीमत्स्वर्ग्यं महापुण्यं सपत्नशमनं शिवम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000492097, "chapter_id": 20492, "verse_number": "३-३९-९८", "content_sanskrit": "मेधाजननमग्र्यं वै तीर्थवंशानुकीर्त्तनम् ।\nअपुत्रो लभते पुत्रमधनो धनमाप्नुयात्॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000492098, "chapter_id": 20492, "verse_number": "३-३९-९९", "content_sanskrit": "महीं विजयते राजा वैश्यो धनमवाप्नुयात् ।\nशूद्रो यातीप्सितान्कामान्ब्राह्मणः पारगः पठन्॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000492099, "chapter_id": 20492, "verse_number": "३-३९-१००", "content_sanskrit": "यश्चेदं शृणुयान्नित्यं तीर्थपुण्यं सदा शुचि ।\nजातिस्मरत्वमाप्नोति नाकपृष्ठे च मोदते॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000492100, "chapter_id": 20492, "verse_number": "३-३९-१०१", "content_sanskrit": "गम्यान्यपि च तीर्थानि कीर्तितान्यगमान्यपि ।\nमनसाप्यभिगच्छेत सर्वतीर्थमनीषया॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000492101, "chapter_id": 20492, "verse_number": "३-३९-१०२", "content_sanskrit": "एतानि वसुभिः साध्यैरादित्यैर्मरुदश्विभिः ।\nऋषिभिर्देवकल्पैश्च कृतानि सुकृतैषिभिः॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000492102, "chapter_id": 20492, "verse_number": "३-३९-१०३", "content_sanskrit": "एवं त्वमपि कौरव्य विधिनानेन सुव्रत ।\nव्रज तीर्थानि नियतः पुण्यं पुण्येन वर्द्धते॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000492103, "chapter_id": 20492, "verse_number": "३-३९-१०४", "content_sanskrit": "भावितैः करणैः पूर्वमास्तिक्याछ्रुतिदर्शनात् ।\nप्राप्यंते तानि तीर्थानि सद्भिः शिष्टानुदर्शिभिः॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000492104, "chapter_id": 20492, "verse_number": "३-३९-१०५", "content_sanskrit": "नाकृतो नाकृतात्मा च नाशुचिर्न च तस्करः ।\nस्नाति तीर्थेषु कौरव्य न च वक्रमतिर्नरः॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000492105, "chapter_id": 20492, "verse_number": "३-३९-१०६", "content_sanskrit": "त्वया तु सम्यग्वृत्तेन नित्यं धर्मार्थदर्शिना ।\nपितरस्तर्पितास्तात सर्वे च प्रपितामहाः ।\nपितामहपुरोगाश्च देवाः सर्षिगणास्तथा॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000492106, "chapter_id": 20492, "verse_number": "३-३९-१०७", "content_sanskrit": "वसिष्ठ उवाच ।\nत्वं च धर्मेण धर्मज्ञ नित्यमेवाभितोषिताः ।\nदिलीपकीर्तिं महतीं प्राप्स्यसे भुवि शाश्वतीम्॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000492107, "chapter_id": 20492, "verse_number": "३-३९-१०८", "content_sanskrit": "नारद उवाच ।\nएवमुक्त्वाभ्यनुज्ञाप्य वसिष्ठो भगवानृषिः ।\nप्रीतः प्रीतेनमनसा तत्रैवांतरधीयत॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000492108, "chapter_id": 20492, "verse_number": "३-३९-१०९", "content_sanskrit": "दिलीपः कुरुशार्दूल शास्त्रतत्त्वार्थदर्शनात् ।\nवसिष्ठवचनाच्चैव पृथिवीमनुचक्रमे॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000492109, "chapter_id": 20492, "verse_number": "३-३९-११०", "content_sanskrit": "एवमेषा महाभाग प्रतिष्ठाने प्रतिष्ठिता ।\nतीर्थयात्रा महापुण्या सर्वपापप्रमोचनी॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000492110, "chapter_id": 20492, "verse_number": "३-३९-१११", "content_sanskrit": "अनेन विधिना यस्तु पृथिवीं पर्यटिष्यति ।\nअश्वमेधशतं साग्रं फलं प्रेत्यैष भोक्ष्यते॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000492111, "chapter_id": 20492, "verse_number": "३-३९-११२", "content_sanskrit": "ततश्चाष्टगुणं पार्थ प्राप्स्यसे धर्ममुत्तमम् ।\nदिलीपः पार्थ नृपतिर्यथापूर्वमवाप्तवान्॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000492112, "chapter_id": 20492, "verse_number": "३-३९-११३", "content_sanskrit": "नेता च त्वमृषीन्यस्मात्तस्मात्तेष्टगुणं फलम् ।\nरक्षोगणविकीर्णानि तीर्थान्येतानि भारत॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000492113, "chapter_id": 20492, "verse_number": "३-३९-११४", "content_sanskrit": "न गतिर्विद्यतेऽन्यस्य त्वामृते कुरुनंदन ।\nइदं देवर्षिचरितं सर्वतीर्थानुसंश्रितम्॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000492114, "chapter_id": 20492, "verse_number": "३-३९-११५", "content_sanskrit": "यः पठेत्कल्यमुत्थाय सर्वपापैः प्रमुच्यते ।\nऋषिमुख्याः सदा यत्र वाल्मीकिस्त्वथ कश्यपः॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000492115, "chapter_id": 20492, "verse_number": "३-३९-११६", "content_sanskrit": "आत्रेयस्त्वथ कौंडिन्यो विश्वामित्रोऽथ गौतमः ।\nअसितो देवलश्चैव मार्कंडेयोऽथ गालवः॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000492116, "chapter_id": 20492, "verse_number": "३-३९-११७", "content_sanskrit": "भरद्वाजस्य शिष्यश्च मुनिरुद्दालकस्तथा ।\nशौनकः सह पुत्रेण व्यासश्च तपतां वरः॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000492117, "chapter_id": 20492, "verse_number": "३-३९-११८", "content_sanskrit": "दुर्वासाश्च मुनिश्रेष्ठो जाबालिश्च महातपाः ।\nएते ऋषिवराः सर्वे त्वत्प्रतीक्ष्यास्तपोधनाः॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000492118, "chapter_id": 20492, "verse_number": "३-३९-११९", "content_sanskrit": "एभिः सह महाभाग तीर्थान्येतान्यनुव्रज ।\nप्राप्स्यसे महतीं कीर्तिं यथा राजा महाभिषः॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000492119, "chapter_id": 20492, "verse_number": "३-३९-१२०", "content_sanskrit": "यथा ययातिर्धर्मात्मा यथा राजा पुरूरवाः ।\nतथा त्वं कुरुशार्दूल स्वेन धर्मेण शोभसे॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000492120, "chapter_id": 20492, "verse_number": "३-३९-१२१", "content_sanskrit": "यथा भगीरथो राजा यथा रामश्च विश्रुतः ।\nयथा वै वृत्रहा सर्वान्सपत्नानदहत् पुरा॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000492121, "chapter_id": 20492, "verse_number": "३-३९-१२२", "content_sanskrit": "त्रैलोक्यं पालयामास देवराट्विगतज्वरः ।\nतथा शत्रुक्षयं कृत्वा त्वं प्रजाः पालयिष्यसि॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000492122, "chapter_id": 20492, "verse_number": "३-३९-१२३", "content_sanskrit": "स्वधर्मेणार्जितामुर्वीं प्राप्य राजीवलोचन ।\nख्यातिं यास्यसि वीर्येण कार्त्तवीर्यार्जुनो यथा॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000492123, "chapter_id": 20492, "verse_number": "३-३९-१२४", "content_sanskrit": "सूत उवाच ।\nएवमाभाष्य राजानं नारदो भगवानृषिः ।\nअनुज्ञाप्य महाराजं तत्रैवांतरधीयत॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000492124, "chapter_id": 20492, "verse_number": "३-३९-१२५", "content_sanskrit": "युधिष्ठिरोऽपि धर्मात्मा ऋषिभिः सह सुव्रतः ।\nजगामाखिलतीर्थानि सादरः पृथिवीपतिः॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000492125, "chapter_id": 20492, "verse_number": "३-३९-१२६", "content_sanskrit": "मयोक्तामृषयः सर्वे तीर्थयात्राश्रयां कथाम् ।\nयः पठेच्छृणुयाद्वापि स मुक्तः सर्वपातकैः॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000492126, "chapter_id": 20492, "verse_number": "३-३९-१२७", "content_sanskrit": "मयोक्तमखिलं तत्त्वं किं भूयः श्रोतुमिच्छथ ।\nऋषीणां पुण्यकीर्तीनां नावक्तव्यं ममास्ति वै॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]