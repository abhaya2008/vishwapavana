[{"id": 7000295000, "chapter_id": 20295, "verse_number": "१-४९-१", "content_sanskrit": "नारद उवाच ।\nकेनाचारेण विप्रस्य ब्रह्मतेजो विवर्धते ।\nकेनाचारेण तस्यैव ब्राह्मं तेजो विनश्यति॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000295001, "chapter_id": 20295, "verse_number": "१-४९-२", "content_sanskrit": "ब्रह्मोवाच ।\nशयनीयात्समुत्थाय रात्र्यंशे द्विजसत्तमः ।\nदेवांश्चैव स्मरेन्नित्यं तथा पुण्यवतो ध्रुवम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000295002, "chapter_id": 20295, "verse_number": "१-४९-३", "content_sanskrit": "गोविंदं माधवं कृष्णं हरिं दामोदरं तथा ।\nनारायणं जगन्नाथं वासुदेवमजं विभुम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000295003, "chapter_id": 20295, "verse_number": "१-४९-४", "content_sanskrit": "सरस्वतीं महालक्ष्मीं सावित्रीं वेदमातरम् ।\nब्रह्माणं भास्करं चन्द्रं दिक्पालांश्च ग्रहांस्तथा॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000295004, "chapter_id": 20295, "verse_number": "१-४९-५", "content_sanskrit": "शङ्करं च शिवं शंभुमीश्वरं च महेश्वरम् ।\nगणेशं च तथा स्कन्दं गौरीं भागीरथीं शिवाम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000295005, "chapter_id": 20295, "verse_number": "१-४९-६", "content_sanskrit": "पुण्यश्लोको नलो राजा पुण्यश्लोको जनार्दनः ।\nपुण्यश्लोका च वैदेही पुण्यश्लोको युधिष्ठिरः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000295006, "chapter_id": 20295, "verse_number": "१-४९-७", "content_sanskrit": "अश्वत्थामा बलिर्व्यासो हनूमांश्च विभीषणः ।\nकृपः परशुरामश्च सप्तैते चीरजीविनः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000295007, "chapter_id": 20295, "verse_number": "१-४९-८", "content_sanskrit": "एतान्यस्तु स्मरेन्नित्यं प्रातरुत्थाय मानवः ।\nब्रह्महत्यादिभिः पापैर्मुच्यते नात्र संशयः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000295008, "chapter_id": 20295, "verse_number": "१-४९-९", "content_sanskrit": "सकृदुच्चरिते तात सर्वयज्ञफलं लभेत् ।\nगवां शतसहस्राणां दानस्य फलमश्नुते॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000295009, "chapter_id": 20295, "verse_number": "१-४९-१०", "content_sanskrit": "ततश्चापि शुचौ देशे मलमूत्रं परित्यजेत् ।\nदक्षिणाभिमुखो रात्रौ दिवा कुर्यादुदङ्मुखः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000295010, "chapter_id": 20295, "verse_number": "१-४९-११", "content_sanskrit": "परतो दंतकाष्ठं च तृणैरुदुंबरादिभिः ।\nअतः परं च संध्यायां संयतश्च द्विजो भवेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000295011, "chapter_id": 20295, "verse_number": "१-४९-१२", "content_sanskrit": "पूर्वाह्णे रक्तवर्णां तु मध्याह्ने शुक्लवर्णिकाम् ।\nसायं सरस्वतीं कृष्णां द्विजो ध्यायेद्यथाविधि॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000295012, "chapter_id": 20295, "verse_number": "१-४९-१३", "content_sanskrit": "ततः समाचरेत्स्नानं यथाज्ञानेन यत्नतः ।\nअंगं प्रक्षालयित्वा तु मृद्भिः संलेपयेत्ततः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000295013, "chapter_id": 20295, "verse_number": "१-४९-१४", "content_sanskrit": "शिरोदेशे ललाटे च नासिकायां हृदि भ्रुवोः ।\nबाह्वोः पार्श्वे तथा नाभौ जान्वोरङ्घ्रिद्वये तथा॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000295014, "chapter_id": 20295, "verse_number": "१-४९-१५", "content_sanskrit": "एका लिंगे गुदे तिस्रस्तथा वामकरे दश ।\nउभयोः सप्त दातव्या मृदः शुद्धिमभीप्सता॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000295015, "chapter_id": 20295, "verse_number": "१-४९-१६", "content_sanskrit": "अश्वक्रांते रथक्रांते विष्णुक्रांते वसुंधरे ।\nमृत्तिके हर मे पापं यन्मया पूर्वसंचितम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000295016, "chapter_id": 20295, "verse_number": "१-४९-१७", "content_sanskrit": "अनेनैव तु मंत्रेण मृत्तिकां यस्तनौ क्षिपेत् ।\nसर्वपापक्षयस्तस्य शुचिर्भवति मानवः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000295017, "chapter_id": 20295, "verse_number": "१-४९-१८", "content_sanskrit": "ततस्तु वेदपूर्वेण स्नानं कुर्याद्विचक्षणः ।\nनदे नद्यां तथा कूपे पुष्करिण्यां तटाकके॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000295018, "chapter_id": 20295, "verse_number": "१-४९-१९", "content_sanskrit": "जलराशौ च वप्रे च घटस्नानं तथोत्तरम् ।\nकारयेद्विधिवन्मर्त्यः सर्वपापक्षयाय च॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000295019, "chapter_id": 20295, "verse_number": "१-४९-२०", "content_sanskrit": "प्रातःस्नानं महापुण्यं सर्वपापप्रणाशनम् ।\nयः कुर्यात्सततं विप्रो विष्णुलोके महीयते॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000295020, "chapter_id": 20295, "verse_number": "१-४९-२१", "content_sanskrit": "प्रातः संध्यासमीपे च यावद्दंडचतुष्टयम् ।\nतावत्पानीयममृतं पितॄणामुपतिष्ठते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000295021, "chapter_id": 20295, "verse_number": "१-४९-२२", "content_sanskrit": "परतो घटिकायुग्मं यावद्यामैकमाह्निकम् ।\nमधुतुल्यं जलं तस्मिन्पितॄणां प्रीतिवर्धनम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000295022, "chapter_id": 20295, "verse_number": "१-४९-२३", "content_sanskrit": "ततस्तु सार्द्धयामैकं जलं क्षीरमयं स्मृतम् ।\nक्षीरमिश्रं जलं तावद्यावद्दण्डचतुष्टयम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000295023, "chapter_id": 20295, "verse_number": "१-४९-२४", "content_sanskrit": "अतः परं च पानीयं यावद्धि प्रहरत्रयम् ।\nतत्परं लोहितं प्रोक्तं यावदस्तंगतो रविः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000295024, "chapter_id": 20295, "verse_number": "१-४९-२५", "content_sanskrit": "चतुर्थप्रहरे स्नाने रात्रौ वा तर्पयेत्पितॄन् ।\nतत्तोयं रक्षसामेव ग्रहणेन विना स्मृतम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000295025, "chapter_id": 20295, "verse_number": "१-४९-२६", "content_sanskrit": "पानीयं सर्वसिर्द्ध्य्थं पुरैव निर्मितं मया ।\nरक्षार्थं तस्य तोयस्य यक्षाश्चैव धुरंधराः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000295026, "chapter_id": 20295, "verse_number": "१-४९-२७", "content_sanskrit": "न प्राप्नुवंति पितरो ये च लोकांतरं गताः ।\nदुष्प्राप्यं सलिलं तेषामृते स्वान्मर्त्यवासिनः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000295027, "chapter_id": 20295, "verse_number": "१-४९-२८", "content_sanskrit": "तस्माच्छिष्यैश्च पुत्रैश्च पौत्रदौहित्रकादिभिः ।\nबंधुवर्गैस्तथा चान्यैस्तर्पणीयं पितृव्रतैः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000295028, "chapter_id": 20295, "verse_number": "१-४९-२९", "content_sanskrit": "नारद उवाच ।\nजलस्य दैवतं ब्रूहि तर्पणस्य विधिं मयि ।\nयथा जानामि देवेश तत्वतो वक्तुमर्हसि॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000295029, "chapter_id": 20295, "verse_number": "१-४९-३०", "content_sanskrit": "ब्रह्मोवाच ।\nजलस्य देवता विष्णुःस र्वलोकेषु गीयते ।\nजलपूतो भवेद्यस्तु विष्णुस्तच्छंकरो भवेत्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000295030, "chapter_id": 20295, "verse_number": "१-४९-३१", "content_sanskrit": "जलं गंडूषमात्रं तु पीत्वा पूतो भवेन्नरः ।\nविशेषात्कुशसंसर्गात्पीयूषादधिकं जलम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000295031, "chapter_id": 20295, "verse_number": "१-४९-३२", "content_sanskrit": "सर्वदेवालयो दर्भो मयायं निर्मितः पुरा ।\nकुशमूले भवेद्ब्रह्मा कुशमध्ये तु केशवः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000295032, "chapter_id": 20295, "verse_number": "१-४९-३३", "content_sanskrit": "कुशाग्रे शंकरं विद्धि कुश एते प्रतिष्ठिताः ।\nकुशहस्तः सदा मेध्यः स्तोत्रं मंत्रं पठेद्यदि॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000295033, "chapter_id": 20295, "verse_number": "१-४९-३४", "content_sanskrit": "सर्वं शतगुणं प्रोक्तं तीर्थे साहस्रमुच्यते ।\nकुशाः काशास्तथा दूर्वा यवपत्राणि व्रीहयः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000295034, "chapter_id": 20295, "verse_number": "१-४९-३५", "content_sanskrit": "बल्वजाः पुंडरीकाश्च कुशास्सप्त प्रकीर्तिताः ।\nआनुपूर्व्येण मेध्याः स्युः कुशा लोके प्रतिष्ठिताः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000295035, "chapter_id": 20295, "verse_number": "१-४९-३६", "content_sanskrit": "विना मंत्रेण यत्स्नानं सर्वं तन्निष्फलं भवेत् ।\nअमृतात्स्वादुतामेति संस्पर्शाच्च तिलस्य च॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000295036, "chapter_id": 20295, "verse_number": "१-४९-३७", "content_sanskrit": "तस्माच्च तर्पयेन्नित्यं पितॄंस्तिलजलैर्बुधः ।\nदशभिश्च तिलैस्तावत्पितॄणां प्रीतिरुत्तमा॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000295037, "chapter_id": 20295, "verse_number": "१-४९-३८", "content_sanskrit": "अग्निस्तंभभयाद्देवा न चेच्छन्त्यतिविस्तरम् ।\nस्नात्वा यस्तर्पयेन्नित्यं तिलमिश्रोदकैः पितॄन्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000295038, "chapter_id": 20295, "verse_number": "१-४९-३९", "content_sanskrit": "नीलपंडविमोक्षेण त्वमावास्या तिलोदकैः ।\nवर्षासु दीपदानेन पितॄणामनृणो भवेत्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000295039, "chapter_id": 20295, "verse_number": "१-४९-४०", "content_sanskrit": "वत्सरैकममायां तु तर्पयेद्यस्तिलैः पितृन् ।\nविनायकत्वमाप्नोति सर्वदेवैः प्रपूज्यते॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000295040, "chapter_id": 20295, "verse_number": "१-४९-४१", "content_sanskrit": "युगाद्यासु च सर्वासु यस्तिलैस्तर्पयेत्पितॄन् ।\nउक्तं यद्वाप्यमायां तु तस्माच्छतगुणाधिकम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000295041, "chapter_id": 20295, "verse_number": "१-४९-४२", "content_sanskrit": "अयने विषुवे चैव राकामायां तथैव च ।\nतर्पयित्वा पितृव्यूहं स्वर्गलोके महीयते॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000295042, "chapter_id": 20295, "verse_number": "१-४९-४३", "content_sanskrit": "तथा मन्वंतराख्यायामन्यस्यां पुण्यसंस्थितौ ।\nग्रहणे चंद्रसूर्यस्य पुण्यतीर्थे गयादिषु॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000295043, "chapter_id": 20295, "verse_number": "१-४९-४४", "content_sanskrit": "तर्पयित्वा पितॄन्याति माधवस्य निकेतनम् ।\nतस्मात्पुण्याहकं प्राप्य तर्पयेत्पितृसंचयम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000295044, "chapter_id": 20295, "verse_number": "१-४९-४५", "content_sanskrit": "तर्पणं देवतानां च पूर्वं कृत्वा समाहितः ।\nअधिकारी भवेत्पश्चात्पितॄणां तर्पणे बुधः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000295045, "chapter_id": 20295, "verse_number": "१-४९-४६", "content_sanskrit": "श्राद्धे भोजनकाले च पाणिनैकेन दापयेत् ।\nउभाभ्यां तर्पणे दद्याद्विधिरेष सनातनः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000295046, "chapter_id": 20295, "verse_number": "१-४९-४७", "content_sanskrit": "दक्षिणाभिमुखो भूत्वा शुचिस्तु तर्पयेत्पितॄन् ।\nतृप्यतामिति वाक्येन नामगोत्रेण वै पुनः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000295047, "chapter_id": 20295, "verse_number": "१-४९-४८", "content_sanskrit": "अकृष्णैर्यत्तिलैर्मोहात्तर्पयेत्पितृसंचयम् ।\nभूम्यां ददाति यदपो दाता चैव जले स्थितः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000295048, "chapter_id": 20295, "verse_number": "१-४९-४९", "content_sanskrit": "वृथा तद्दीयते दानं नोपतिष्ठति कस्यचित् ।\nस्थले स्थित्वा जले यस्तु प्रयच्छेदुदकं नरः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000295049, "chapter_id": 20295, "verse_number": "१-४९-५०", "content_sanskrit": "नोपतिष्ठेत्पितॄणां तु सलिलं तन्निरर्थकम् ।\nआर्द्रवासा जले यस्तु कुर्यादुदकतर्पणम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000295050, "chapter_id": 20295, "verse_number": "१-४९-५१", "content_sanskrit": "पितरस्तस्य तृप्यंति सहदेवैस्सदानघ ।\nरजकैः क्षालितं वस्त्रमशुद्धं कवयो विदुः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000295051, "chapter_id": 20295, "verse_number": "१-४९-५२", "content_sanskrit": "हस्तप्रक्षालने चैव पुनर्वस्त्रं तु शुध्यति ।\nशुष्कवासाः शुचौ देशे स्थाने यत्तर्पयेत्पितॄन्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000295052, "chapter_id": 20295, "verse_number": "१-४९-५३", "content_sanskrit": "ततो दशगुणेनैव तुष्यंति पितरो ध्रुवम् ।\nस्नानं संध्यां च पाषाणे खड्गे वा ताम्रभाजने॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000295053, "chapter_id": 20295, "verse_number": "१-४९-५४", "content_sanskrit": "तर्पणं कुरुते यस्तु प्रत्येकं च शताधिकम् ।\nरौप्यांगुलीयं तर्जन्यां धृत्वा यत्तर्पयेत्पितॄन्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000295054, "chapter_id": 20295, "verse_number": "१-४९-५५", "content_sanskrit": "सर्वं च शतसाहस्रगुणं भवति नान्यथा ।\nतथैवानामिकायां तु धृत्वा स्वर्णांगुलीं बुधः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000295055, "chapter_id": 20295, "verse_number": "१-४९-५६", "content_sanskrit": "तर्पयेत्पितृसंदोहं लक्षकोटिगुणं भवेत् ।\nअंगुष्ठदेशिनी मध्ये सव्यहस्तस्य खड्गकम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000295056, "chapter_id": 20295, "verse_number": "१-४९-५७", "content_sanskrit": "धृत्वानामिकया रत्नमंजलेरक्षयंफलं ।\nस्नानार्थमभिगच्छंतं देवाः पितृगणैः सह॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000295057, "chapter_id": 20295, "verse_number": "१-४९-५८", "content_sanskrit": "वायुभूतानुगच्छंति तृषार्ताः सलिलार्थिनः ।\nनिराशास्ते निवर्तंते वस्त्रनिष्पीडनेन च॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000295058, "chapter_id": 20295, "verse_number": "१-४९-५९", "content_sanskrit": "तस्मान्न पीडयेद्वस्त्रमकृत्वा पितृतर्पणम् ।\nतिस्रःकोट्योऽर्धकोटी च यानि लोमानि मानुषे॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000295059, "chapter_id": 20295, "verse_number": "१-४९-६०", "content_sanskrit": "स्रवंति सर्वतीर्थानि तस्मान्न परिपीडयेत् ।\nदेवाः पिबंति शिरसि श्मश्रुतः पितरस्तथा॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000295060, "chapter_id": 20295, "verse_number": "१-४९-६१", "content_sanskrit": "चक्षुषोरपि गंधर्वा अधस्तात्सर्वजंतवः ।\nदेवाः पितृगणाः सर्वे गंधर्वा जंतवस्तथा॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000295061, "chapter_id": 20295, "verse_number": "१-४९-६२", "content_sanskrit": "स्नानमात्रेण तुष्यंति स्नानात्पापं न विद्यते ।\nनित्यस्नानं च यः कुर्यात्स नरः पुरुषोत्तमः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000295062, "chapter_id": 20295, "verse_number": "१-४९-६३", "content_sanskrit": "सर्वपापैर्विनिर्मुक्तो नाकलोकेमहीयते ।\nस्नानं तर्पणपर्यंतं देवा महर्षयो विदुः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000295063, "chapter_id": 20295, "verse_number": "१-४९-६४", "content_sanskrit": "अतः परं च देवानां पूजनं कारयेद्बुधः ।\nगणेशं पूजयेद्यस्तु विघ्नस्तस्य न जायते॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000295064, "chapter_id": 20295, "verse_number": "१-४९-६५", "content_sanskrit": "आरोग्यार्थं च सूर्यं च धर्ममोक्षाय माधवम् ।\nशिवं च कृत्यकामार्थं सर्वकामाय चंडिकाम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000295065, "chapter_id": 20295, "verse_number": "१-४९-६६", "content_sanskrit": "देवांस्तु पूजयित्वा तु वैश्वदेवबलिं चरेत् ।\nवह्निकार्यं ततः कृत्वा यज्ञं ब्राह्मणतर्पणम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000295066, "chapter_id": 20295, "verse_number": "१-४९-६७", "content_sanskrit": "देवानां सर्वसत्वानां पुनस्त्रिविष्टपं व्रजेत् ।\nगतागतं स्थिरं कृत्वा कामान्मोक्षं सुखं दिवम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000295067, "chapter_id": 20295, "verse_number": "१-४९-६८", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन नित्यं कर्माणि कारयेत् ।\nनारद उवाच ।\nकिमर्थं च जलं तात देवाः पितृगणैः सह॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000295068, "chapter_id": 20295, "verse_number": "१-४९-६९", "content_sanskrit": "न प्राप्नुवंति सर्वज्ञ लभंते मानवा यथा ।\nब्रह्मोवाच ।\nपुरा सृष्टं मया तोयं सर्वदेवमयामृतम्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000295069, "chapter_id": 20295, "verse_number": "१-४९-७०", "content_sanskrit": "तस्यैव रक्षणार्थं च रक्षा यक्षा धनुर्धराः ।\nघ्नंति ते पितरं देवमस्मद्वाक्यान्न मानुषम्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000295070, "chapter_id": 20295, "verse_number": "१-४९-७१", "content_sanskrit": "पशवः पक्षिणः कीटा मर्त्यलोके व्यवस्थिताः ।\nमर्त्यजाताश्च देवा ये तथैव मानुषा ध्रुवम्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000295071, "chapter_id": 20295, "verse_number": "१-४९-७२", "content_sanskrit": "तर्पयित्वा गुरुं नित्यं सुरलोके प्रतिष्ठिताः ।\nअस्नायी च मलं भुंक्ते अजपी पूयशोणितम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000295072, "chapter_id": 20295, "verse_number": "१-४९-७३", "content_sanskrit": "अकृत्वा तर्पणं नित्यं पितृहा चोपजायते ।\nब्रह्महत्यासमं पापं देवानामप्यपूजने॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000295073, "chapter_id": 20295, "verse_number": "१-४९-७४", "content_sanskrit": "सन्ध्याकृत्यमकृत्वा च सूर्यं हंति च पापकृत् ।\nनारद उवाच ।\nब्राह्मणस्य सदाचारक्रमं ब्रूहि च कर्मणाम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000295074, "chapter_id": 20295, "verse_number": "१-४९-७५", "content_sanskrit": "इतरेषां च वर्णानां प्रवृत्तमखिलं वद ।\nब्रह्मोवाच ।\nआचाराल्लभते चायुराचाराल्लभते सुखम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000295075, "chapter_id": 20295, "verse_number": "१-४९-७६", "content_sanskrit": "आचारात्स्वर्गं मोक्षं च आचारो हंत्यलक्षणम् ।\nअनाचारो हि पुरुषो लोके भवति निंदितः॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000295076, "chapter_id": 20295, "verse_number": "१-४९-७७", "content_sanskrit": "दुःखभागी च सततं व्याधितोल्पायुरेव च ।\nनरके नियतं वासो ह्यनाचारान्नरस्य च॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000295077, "chapter_id": 20295, "verse_number": "१-४९-७८", "content_sanskrit": "आचाराच्च परं लोकमाचारं शृणु तत्त्वतः ।\nगोमयेन गृहे नित्यं प्रकुर्यादुपलेपनम्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000295078, "chapter_id": 20295, "verse_number": "१-४९-७९", "content_sanskrit": "प्रक्षालयेत्ततः पीठं काष्ठं पात्रं शिलातलम् ।\nभस्मना कांस्यपात्रं तु ताम्रमम्लेनशुद्ध्यति॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000295079, "chapter_id": 20295, "verse_number": "१-४९-८०", "content_sanskrit": "शिलापात्रं तु तैलेन फालंगो वालकेन तु ।\nस्वर्णरौप्यादिपात्रं तु जलमात्रेण शुध्यति॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000295080, "chapter_id": 20295, "verse_number": "१-४९-८१", "content_sanskrit": "अग्निना लोहपात्रं तु पाकप्रक्षालनेन तु ।\nखननाद्दाहनाच्चैव उपलेपन धावनात्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000295081, "chapter_id": 20295, "verse_number": "१-४९-८२", "content_sanskrit": "पर्जन्यवर्षणाच्चैव भूरमेध्या विशुध्यति ।\nतैजस्सानां मणीनां च सर्वस्याश्ममयस्य च॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000295082, "chapter_id": 20295, "verse_number": "१-४९-८३", "content_sanskrit": "भस्मभिर्मृत्तिकाभिश्च शुद्धिरुक्ता मया पुरा ।\nशय्या भार्या शिशुर्वस्त्रमुपवीतं कमंडलुः॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000295083, "chapter_id": 20295, "verse_number": "१-४९-८४", "content_sanskrit": "आत्मनः कथिताश्शुद्धा न परेषां कदाचन ।\nन भुंजीतैकवस्त्रेण न स्नायादेकवाससा॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000295084, "chapter_id": 20295, "verse_number": "१-४९-८५", "content_sanskrit": "न धारयेत्परस्यैवं स्नानवस्त्रं कदाचन ।\nसंस्कारं केशदंतानां प्रातरेव समाचरेत्॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000295085, "chapter_id": 20295, "verse_number": "१-४९-८६", "content_sanskrit": "गुरूणां च नमस्कारं नित्यमेव समाचरेत् ।\nहस्तपादे मुखे चैव पंचार्द्रो भोजनं चरेत्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000295086, "chapter_id": 20295, "verse_number": "१-४९-८७", "content_sanskrit": "पंचार्द्रकस्तु भुंजानः शतं वर्षाणि जीवति ।\nदेवतानां गुरोराज्ञां स्नातकाचार्ययोरपि॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000295087, "chapter_id": 20295, "verse_number": "१-४९-८८", "content_sanskrit": "नाक्रामेत्कामतश्छायां विप्रस्य दीक्षितस्य च ।\nगोगणं देवतं विप्रं घृतं मधु चतुष्पथम्॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000295088, "chapter_id": 20295, "verse_number": "१-४९-८९", "content_sanskrit": "प्रदक्षिणं प्रकुर्वीत प्रख्यातांश्च वनस्पतीन् ।\nगोविप्रावग्निविप्रौ च विप्रौ द्वौ दंपती तथा॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000295089, "chapter_id": 20295, "verse_number": "१-४९-९०", "content_sanskrit": "तयोर्मध्ये न गच्छेत स्वर्गस्थोपि पतेद्ध्रुवम् ।\nउच्छिष्टो न स्पृशेदग्निं ब्राह्मणं दैवतं गुरुम्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000295090, "chapter_id": 20295, "verse_number": "१-४९-९१", "content_sanskrit": "स्वशीर्षं पुष्पवृक्षं च यज्ञवृक्षमधार्मिकम् ।\nत्रीणि तेजांसि नोच्छिष्ट उदीक्षेत कदाचन॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000295091, "chapter_id": 20295, "verse_number": "१-४९-९२", "content_sanskrit": "सूर्याचंद्रमसावेवं नक्षत्राणि च सर्वशः ।\nनेक्षेद्विप्रं गुरुं देवं राजानं यतिनां वरम्॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000295092, "chapter_id": 20295, "verse_number": "१-४९-९३", "content_sanskrit": "योगिनं देवकर्माणं धर्माणां कथकं द्विजम् ।\nनदीनां च प्रतीरे च पत्युश्च सरितां तथा॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000295093, "chapter_id": 20295, "verse_number": "१-४९-९४", "content_sanskrit": "यज्ञवृक्षस्य मूले च उद्याने पुष्पवाटके ।\nशरीरस्य मलत्यागं न कुर्याज्जीवने तथा॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000295094, "chapter_id": 20295, "verse_number": "१-४९-९५", "content_sanskrit": "विप्रस्यायतने गोष्ठे रम्ये राजपथेषु च ।\nन क्षौरं कारयेद्धीरः कुजस्याह्नि कदाचन॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000295095, "chapter_id": 20295, "verse_number": "१-४९-९६", "content_sanskrit": "मलं न धारयेद्दंते नखं न वदने क्षिपेत् ।\nतैलाभ्यंगं न कुर्वीत वासरे रविभौमयोः॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000295096, "chapter_id": 20295, "verse_number": "१-४९-९७", "content_sanskrit": "स्वगात्रासनयोर्वाद्यं गुरोरेकासनादनम् ।\nन हरेच्छ्रोत्रियस्वं च देवस्यापि गुरोरपि॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000295097, "chapter_id": 20295, "verse_number": "१-४९-९८", "content_sanskrit": "राज्ञस्तपस्विनां चैव पंगोरंधस्य योषितः ।\nपंथा देयो ब्राह्मणाय गोभ्यो राजभ्य एव च॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000295098, "chapter_id": 20295, "verse_number": "१-४९-९९", "content_sanskrit": "रोगिणे भारतप्ताय गुर्विण्यै दुर्बलाय च ।\nविवादं न च कुर्वीत नृप विप्र चिकित्सकैः॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000295099, "chapter_id": 20295, "verse_number": "१-४९-१००", "content_sanskrit": "ब्राह्मणं गुरुपत्नीं च दूरतः परिवर्जयेत् ।\nपतितं कुष्ठसंयुक्तं चांडालं च गवाशिनम्॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000295100, "chapter_id": 20295, "verse_number": "१-४९-१०१", "content_sanskrit": "निर्धूतं ज्ञानहीनं च दूरतः परिवर्जयेत् ।\nस्त्रियं दुष्टां च दुर्वृत्तामपवाद प्रदायिनीम्॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000295101, "chapter_id": 20295, "verse_number": "१-४९-१०२", "content_sanskrit": "कुकर्मकारिणीं दुष्टां सदैव कलहप्रियाम् ।\nप्रमत्तामधिकांगीञ्च निर्लज्जां बाह्यचारिणीम्॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000295102, "chapter_id": 20295, "verse_number": "१-४९-१०३", "content_sanskrit": "व्ययशीलामनाचारां दूरतः परिवर्जयेत् ।\nमलिनां नाभिवंदेत गुरुपत्नीं कदाचन॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000295103, "chapter_id": 20295, "verse_number": "१-४९-१०४", "content_sanskrit": "न स्पृशेत्तां च मेधावी स्पृष्ट्वा स्नानेन शुद्ध्यति ।\nस तया सह केलिं च वर्जयेच्च सदैव हि॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000295104, "chapter_id": 20295, "verse_number": "१-४९-१०५", "content_sanskrit": "शृणुयाच्च वचो नूनं न पश्येच्च गुरोः स्त्रियम् ।\nवधूं पुत्रस्य भ्रातुश्च स्वपुत्रीं युवतीं ध्रुवम्॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000295105, "chapter_id": 20295, "verse_number": "१-४९-१०६", "content_sanskrit": "अन्यां च गुरुपत्नीं च नेक्षेत्स्पर्शं न कारयेत् ।\nताभिः सह कथालापं तथा भ्रूभंगदर्शनम्॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000295106, "chapter_id": 20295, "verse_number": "१-४९-१०७", "content_sanskrit": "कलहं निस्त्रपां वाणीं सदैव परिवर्जयेत् ।\nन दद्याच्च सदा पादं तुषांगारास्थिभस्मसु॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000295107, "chapter_id": 20295, "verse_number": "१-४९-१०८", "content_sanskrit": "कार्पासास्थिषु निर्माल्ये चितिकाष्ठे चितौ गुरौ ।\nशुष्कं मीनं न भक्षेत पूतिगंधिममेध्यकम्॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000295108, "chapter_id": 20295, "verse_number": "१-४९-१०९", "content_sanskrit": "विघसं चान्यदुच्छिष्टं पाकार्थं च परस्य च ।\nन स्थातव्यं न गंतव्यं क्षणमप्यसता सह॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000295109, "chapter_id": 20295, "verse_number": "१-४९-११०", "content_sanskrit": "न तिष्ठेच्च क्षणं धीरो दीपच्छाये कलिद्रुमे ।\nअस्पृश्यैस्सह चालापं पतितैः कुपितैः सह॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000295110, "chapter_id": 20295, "verse_number": "१-४९-१११", "content_sanskrit": "न कुर्यात्क्षणमात्रं तु कृत्वा गच्छेच्च रौरवम् ।\nकनिष्ठं नाभिवंदेत पितृव्यं मातुलं तथा॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000295111, "chapter_id": 20295, "verse_number": "१-४९-११२", "content_sanskrit": "उत्थाय चासनं दद्यात्कृतांजल्यग्रतः स्थितः ।\nतैलाभ्यक्तं तथोच्छिष्टमार्द्रवस्त्रं च रोगिणम्॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000295112, "chapter_id": 20295, "verse_number": "१-४९-११३", "content_sanskrit": "पारावारगतोद्विग्नं वहंतं नाभिवादयेत् ।\nयज्ञस्यांतर्गतं नष्टं क्रीडंतं स्त्रीजनैः सह॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000295113, "chapter_id": 20295, "verse_number": "१-४९-११४", "content_sanskrit": "बालक्रीडागतं चापि पुष्पयुक्तं कुशैर्युतम् ।\nशिरः प्रावृत्य कर्णौ वा अप्सु मुक्तशिखोपि वा॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000295114, "chapter_id": 20295, "verse_number": "१-४९-११५", "content_sanskrit": "अकृत्वा पादयोः पूजां नाचामेद्दक्षिणामुखः ।\nउपवीतविहीनश्च नग्नको मुक्तकच्छकः॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000295115, "chapter_id": 20295, "verse_number": "१-४९-११६", "content_sanskrit": "एकवस्त्रपिधानश्च आचांतो नैव शुध्यति ।\nमध्यमाभिर्मुखं पूर्वं तिसृभिः समुपस्पृशेत्॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000295116, "chapter_id": 20295, "verse_number": "१-४९-११७", "content_sanskrit": "अंगुष्ठदेशिनीभ्यां च नासां च तदनंतरम् ।\nअंगुष्ठानामिकाभ्यां च चक्षुषी समुपस्पृशेत्॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000295117, "chapter_id": 20295, "verse_number": "१-४९-११८", "content_sanskrit": "कनिष्ठांगुष्ठतश्श्रोत्रे नाभिमंगुष्ठकेन तु ।\nतलेन हृदयं न्यस्य सर्वाभिर्मस्तकोपरि॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000295118, "chapter_id": 20295, "verse_number": "१-४९-११९", "content_sanskrit": "बाहूचाग्रेण संस्पृश्य ततः शुद्धो भवेन्नरः ।\nअनेनाचमनं कृत्वा मानवः प्रयतो भवेत्॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000295119, "chapter_id": 20295, "verse_number": "१-४९-१२०", "content_sanskrit": "सर्वपापैर्विनिर्मुक्तः स्वर्गं चाक्षयमश्नुते ।\nप्राणस्त्रिपुटशृंग्या च व्यानोपानश्च मुद्रया॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000295120, "chapter_id": 20295, "verse_number": "१-४९-१२१", "content_sanskrit": "समानस्तु समस्ताभिरुदानस्तर्जनीं विना ।\nनागः कूर्मश्च कृकरो देवदत्तो धनंजयः॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000295121, "chapter_id": 20295, "verse_number": "१-४९-१२२", "content_sanskrit": "उपप्रीणंतु ते प्रीता येभ्यो भूमौ प्रदीयते ।\nशयनं चार्द्रपादेन शुष्कपादेन भोजनम्॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000295122, "chapter_id": 20295, "verse_number": "१-४९-१२३", "content_sanskrit": "नांधकारे च शयनं भोजनं नैव कारयेत् ।\nपश्चिमे दक्षिणे चैव न कुर्याद्दंतधावनम्॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000295123, "chapter_id": 20295, "verse_number": "१-४९-१२४", "content_sanskrit": "उत्तरे पश्चिमे चैव न स्वपेद्धि कदाचन ।\nस्वप्नादायुः क्षयं याति ब्रह्महा पुरुषो भवेत्॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000295124, "chapter_id": 20295, "verse_number": "१-४९-१२५", "content_sanskrit": "न कुर्वीत ततः स्वप्नं शस्तं च पूर्वदक्षिणम् ।\nआयुष्यं प्राङ्मुखो भुंक्तेऽयशस्यं दक्षिणामुखः॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000295125, "chapter_id": 20295, "verse_number": "१-४९-१२६", "content_sanskrit": "श्रियं प्रत्यङ्मुखो भुंक्ते यशो भुङ्क्त उदङ्मुखः ।\nप्राच्यां नरो लभेदायुर्याम्यां प्रेतत्वमश्नुते॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000295126, "chapter_id": 20295, "verse_number": "१-४९-१२७", "content_sanskrit": "वारुणे च भवेद्रोगी आयुर्वित्तं तथोत्तरे ।\nदेवानामेकभुक्तं तु द्विभुक्तं स्यान्नरस्य च॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000295127, "chapter_id": 20295, "verse_number": "१-४९-१२८", "content_sanskrit": "त्रिभुक्तं प्रेतदैत्यस्य चतुर्थं कौणपस्य तु ।\nनिरामिषं हविर्देवा मत्स्यमांसादि मानुषाः॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7000295128, "chapter_id": 20295, "verse_number": "१-४९-१२९", "content_sanskrit": "पूतिपर्युषितं दुष्टमन्ये भुंजंत्यनावृताः ।\nस्वर्गस्थितानामिह जीवलोके चत्वारि तेषां हृदये च संति॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7000295129, "chapter_id": 20295, "verse_number": "१-४९-१३०", "content_sanskrit": "दानं प्रशस्तं मधुरा च वाणी देवार्चनं ब्राह्मणतर्पणं च ।\nकार्पण्यवृत्तिस्वजनेषु निंदा कुचेलता नीचजनेषु भक्तिः॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7000295130, "chapter_id": 20295, "verse_number": "१-४९-१३१", "content_sanskrit": "अतीव रोषः कटुका च वाणी नरस्य चिह्नं नरकागतस्य ।\nनवनीतोपमा वाणी करुणा कोमलं मनः॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7000295131, "chapter_id": 20295, "verse_number": "१-४९-१३२", "content_sanskrit": "धर्मबीजप्रसूतानामेतत्प्रत्यक्ष लक्षणम् ।\nदयादरिद्रहृदयं वचः क्रकच कर्कशम्॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7000295132, "chapter_id": 20295, "verse_number": "१-४९-१३३", "content_sanskrit": "पापबीजप्रसूतानामेतत्प्रत्यक्ष लक्षणम् ।\nश्रावयेच्छृणुयाद्वापि सदाचारादिकं नरः॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7000295133, "chapter_id": 20295, "verse_number": "१-४९-१३४", "content_sanskrit": "आचारादेः फलं लब्ध्वा पापात्पूतोऽच्युतो दिवि॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}]