[{"id": 2016475, "chapter_id": 1347, "verse_number": "२-८८-१", "content_sanskrit": "शकुनिरुवाच॥\nबहुवित्तं पराजैषीः पाण्डवानां युधिष्ठिर।\nआचक्ष्व वित्तं कौन्तेय यदि तेऽस्त्यपराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016476, "chapter_id": 1347, "verse_number": "२-८८-२x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016477, "chapter_id": 1347, "verse_number": "२-८८-२", "content_sanskrit": "मम वित्तमसङ्ख्येयं यदहं वेद सौबल।\nअथ त्वं शकुने कस्माद्वित्तं समनुपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016478, "chapter_id": 1347, "verse_number": "२-८८-३", "content_sanskrit": "अयुतं प्रयुतं चैव शङ्कुं पद्मं तथार्बुदम्।\nखर्वं शङ्खं निखर्वं च महापद्मं च कोटयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016479, "chapter_id": 1347, "verse_number": "२-८८-४", "content_sanskrit": "मध्यं चैव परार्धं च सपरं चात्र पण्यताम्।\nएतन्मम धनं राजंस्तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016480, "chapter_id": 1347, "verse_number": "२-८८-५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016481, "chapter_id": 1347, "verse_number": "२-८८-५", "content_sanskrit": "एतच्छुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016482, "chapter_id": 1347, "verse_number": "२-८८-६x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016483, "chapter_id": 1347, "verse_number": "२-८८-६", "content_sanskrit": "गवाश्वं बहुधेनूकमसङ्ख्येयमजाविकम्।\nयत्किञ्चिदनु पर्णाशां प्राक् सिन्धोरपि सौबल।\nएतन्मम धनं सर्वं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016484, "chapter_id": 1347, "verse_number": "२-८८-७x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016485, "chapter_id": 1347, "verse_number": "२-८८-७", "content_sanskrit": "एतच्छुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016486, "chapter_id": 1347, "verse_number": "२-८८-८x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016487, "chapter_id": 1347, "verse_number": "२-८८-८", "content_sanskrit": "पुरं जनपदो भूमिरब्राह्मणधनैः सह।\nअब्राह्मणाश्च पुरुषा राजञ्शिष्टं धनं मम।\nएतद्राजन्मम धनं तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016488, "chapter_id": 1347, "verse_number": "२-८८-९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016489, "chapter_id": 1347, "verse_number": "२-८८-९", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016490, "chapter_id": 1347, "verse_number": "२-८८-१०x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016491, "chapter_id": 1347, "verse_number": "२-८८-१०", "content_sanskrit": "राजपुत्रा इमे राजञ्छोमन्ते यैर्विभूषिताः।\nकुम्डलानि च निष्काश्च सर्वं राजविभूषणम्।\nएतन्मम धनं राजंस्तेन दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016492, "chapter_id": 1347, "verse_number": "२-८८-११x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016493, "chapter_id": 1347, "verse_number": "२-८८-११", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016494, "chapter_id": 1347, "verse_number": "२-८८-१२x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016495, "chapter_id": 1347, "verse_number": "२-८८-१२", "content_sanskrit": "श्यामो युवा लोहिताक्षः सिंहस्कन्धो महाभुजः।\nनकुलो ग्लह एवैकी विद्ध्येतन्मम तद्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016496, "chapter_id": 1347, "verse_number": "२-८८-१३x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016497, "chapter_id": 1347, "verse_number": "२-८८-१३", "content_sanskrit": "प्रियस्ते नकुलो राजन्राजपुत्रो युधिष्ठिर।\nअस्माकं वशतां प्राप्तो भूयः केनेह दीव्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016498, "chapter_id": 1347, "verse_number": "२-८८-१४x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016499, "chapter_id": 1347, "verse_number": "२-८८-१४", "content_sanskrit": "एवमुक्त्वा तु तानक्षाञ्शकुनिः प्रत्यदीव्यत।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016500, "chapter_id": 1347, "verse_number": "२-८८-१५x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016501, "chapter_id": 1347, "verse_number": "२-८८-१५", "content_sanskrit": "अयं धर्मान्सहदेवोऽनुशास्ति\nलोके ह्यस्मिन्पण्डिताख्यां गतश्च।\nअनर्हता राजपुत्रेण तेन\nदीव्याम्यहं चाप्रियवत्प्रियेण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016502, "chapter_id": 1347, "verse_number": "२-८८-१६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016503, "chapter_id": 1347, "verse_number": "२-८८-१६", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016504, "chapter_id": 1347, "verse_number": "२-८८-१७x", "content_sanskrit": "शकुनिरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016505, "chapter_id": 1347, "verse_number": "२-८८-१७", "content_sanskrit": "माद्रीपुत्रौ प्रियौ राजंस्तवेमौ विजितौ मया।\nगरीयांसौ तु मन्ये भीमसेनधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016506, "chapter_id": 1347, "verse_number": "२-८८-१८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016507, "chapter_id": 1347, "verse_number": "२-८८-१८", "content_sanskrit": "अधर्मं चरसे नूनं यो नावेक्षसि वै नयम्।\nयो नः सुमनसां मूढ विभेदं कर्तुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016508, "chapter_id": 1347, "verse_number": "२-८८-१९x", "content_sanskrit": "शकुनिरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016509, "chapter_id": 1347, "verse_number": "२-८८-१९", "content_sanskrit": "गर्ते मत्तः प्रपतते प्रमत्तः स्थाणुमृच्छति।\nज्येष्ठो राजन्व्ररिष्ठोऽसि नमस्ते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016510, "chapter_id": 1347, "verse_number": "२-८८-२०", "content_sanskrit": "स्वप्ने तानि न दृश्यन्ते जाग्रतो वा युधिष्ठिर।\nकितवा यानि दीव्यन्तः प्रलपन्त्युत्कटा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016511, "chapter_id": 1347, "verse_number": "२-८८-२१x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016512, "chapter_id": 1347, "verse_number": "२-८८-२१", "content_sanskrit": "यो नः सङ्ख्ये नौरिव पारनेता\nजेता रिपूणां राजपुत्रस्तरस्वी।\nअनर्हता लोकवीरेण तेन\nदीव्याम्यहं शकुने फाल्गुनेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016513, "chapter_id": 1347, "verse_number": "२-८८-२२x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016514, "chapter_id": 1347, "verse_number": "२-८८-२२", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2016515, "chapter_id": 1347, "verse_number": "२-८८-२३x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2016516, "chapter_id": 1347, "verse_number": "२-८८-२३", "content_sanskrit": "अयं मया पाण्डवानां धनिर्धरः\nपराजितः पाण्डवः सव्यसाची।\nभीमेन राजन्दयितेन दीव्य\nयत्कैतवं पाण्डव तेऽवशिष्टम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2016517, "chapter_id": 1347, "verse_number": "२-८८-२४x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2016518, "chapter_id": 1347, "verse_number": "२-८८-२४", "content_sanskrit": "यो नो नेता यो युधि नः प्रणेता\nयथा वज्री दानवशत्रुरेकः।\nतिर्यक्प्रेक्षी सन्नतभ्रूर्महात्मा\nसिंहस्कन्धो यश्च सदाऽत्यमर्षी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2016519, "chapter_id": 1347, "verse_number": "२-८८-२५", "content_sanskrit": "बलेन तुल्यो यस्यप पुमान्न विद्यते\nगदाभृतामग्र्य इहारिमर्दनः।\nअनर्हता राजपुत्रेण तेन\nदीव्याम्यहं भीमसेनेन राजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2016520, "chapter_id": 1347, "verse_number": "२-८८-२६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2016521, "chapter_id": 1347, "verse_number": "२-८८-२६", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2016522, "chapter_id": 1347, "verse_number": "२-८८-२७x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2016523, "chapter_id": 1347, "verse_number": "२-८८-२७", "content_sanskrit": "बहुवित्तं पराजैषीर्भ्रातॄंश्च सहयद्विपान्।\nआचक्ष्व वित्तं कौन्तेय यदि तेऽस्त्यपराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2016524, "chapter_id": 1347, "verse_number": "२-८८-२८x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2016525, "chapter_id": 1347, "verse_number": "२-८८-२८", "content_sanskrit": "अहं विशिष्टः सर्वेषां भ्रातॄणां दयितस्तथा।\nकुर्यामहं जितः कर्म स्वयमात्मन्युपल्पुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2016526, "chapter_id": 1347, "verse_number": "२-८८-२९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2016527, "chapter_id": 1347, "verse_number": "२-८८-२९", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2016528, "chapter_id": 1347, "verse_number": "२-८८-३०x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2016529, "chapter_id": 1347, "verse_number": "२-८८-३०", "content_sanskrit": "एतत्पापिष्ठमकरोर्यदात्मानं पराजयेः।\nशिष्टे सति धने राजन्पाप आत्मपराजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2016530, "chapter_id": 1347, "verse_number": "२-८८-३१x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2016531, "chapter_id": 1347, "verse_number": "२-८८-३१", "content_sanskrit": "एवमुक्त्वा मताक्षस्तान् ग्लहे सर्वानवस्थितान्।\nपराजयल्लोकवीरानुक्त्वा राज्ञां पृथक् पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2016532, "chapter_id": 1347, "verse_number": "२-८८-३२x", "content_sanskrit": "शकुनिरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2016533, "chapter_id": 1347, "verse_number": "२-८८-३२", "content_sanskrit": "अस्ति ते वै प्रिया राजन् ग्लह एकोऽपराजितः।\nपणस्व कृष्णां पाञ्चालीं तयात्मानं पुनर्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2016534, "chapter_id": 1347, "verse_number": "२-८८-३३x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2016535, "chapter_id": 1347, "verse_number": "२-८८-३३", "content_sanskrit": "नैव ह्रस्वा न महती न कृशा नातिरोहिणी।\nनीलकुञ्चितकशी च तया दीव्याम्यहं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2016536, "chapter_id": 1347, "verse_number": "२-८८-३४", "content_sanskrit": "शारदोत्पलपत्राक्ष्या शारदोत्पलगन्धया।\nशारदोत्पलसेविन्या रूपेण श्रीसमानया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2016537, "chapter_id": 1347, "verse_number": "२-८८-३५", "content_sanskrit": "तथैव स्यादानुशंस्यात्तथ स्याद्रूपसम्पदा।\nतथा स्याच्छीलसम्पत्त्या यामिच्छेत्पुरुषः स्त्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2016538, "chapter_id": 1347, "verse_number": "२-८८-३६", "content_sanskrit": "सर्वैर्गुणैर्हि सम्पन्नामनुकूलां प्रियंवदाम्।\nयादृशीं धर्मकामार्थसिद्धिमिच्छेन्नरः स्त्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2016539, "chapter_id": 1347, "verse_number": "२-८८-३७", "content_sanskrit": "चरमं संविशति या प्रथमं प्रतिबुध्यते।\nआगोपालाविपालेभ्यः सर्वं वेद कृताकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2016540, "chapter_id": 1347, "verse_number": "२-८८-३८", "content_sanskrit": "आभाति पद्मवद्वक्त्रं सस्वेदं मल्लिकेव च।\nवेदीमध्या दीर्घकेशी ताम्रास्या नातिलोमशा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2016541, "chapter_id": 1347, "verse_number": "२-८८-३९", "content_sanskrit": "तयैवंविधया राजन्पाञ्चाल्याहं सुमध्यमा।\nग्लहं दीव्यामि चार्वङ्ग्या द्रौपद्या हन्त सौबल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2016542, "chapter_id": 1347, "verse_number": "२-८८-४०x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2016543, "chapter_id": 1347, "verse_number": "२-८८-४०", "content_sanskrit": "एवमुक्ते तु वचने धर्मराजेन धीमता।\nधिग्धिगित्येव वृद्धानां सभ्यानां निः सृता गिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2016544, "chapter_id": 1347, "verse_number": "२-८८-४१", "content_sanskrit": "चुक्षुभे सा सभा राजन्राज्ञां सञ्जत्रिरे शुचः।\nभीष्मद्रोणकृपादीनां स्वेदश्च समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2016545, "chapter_id": 1347, "verse_number": "२-८८-४२", "content_sanskrit": "शिरो गृहीत्वा विदुरो गतसत्व इवाभवत्।\nआस्ते ध्यायन्नधोवक्त्रो निः श्वसन्निव पन्नगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2016546, "chapter_id": 1347, "verse_number": "२-८८-४३", "content_sanskrit": "बाह्लीकः सोमदत्तश्च प्रातिपेयश्च सञ्जयः।\nद्रौणिर्भूरिश्रवाश्चैव युयुत्सुर्धृतराष्ट्रजः।\nआसुर्वीक्ष्य त्वधोवक्त्रा निश्वसन्त इवोरगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2016547, "chapter_id": 1347, "verse_number": "२-८८-४४", "content_sanskrit": "धृतराष्ट्रस्तु संहृष्टः पर्यपृच्छत्पुनः पुनः।\nकिं जितं किं जितमिति ह्याकारं नाभ्यरक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2016548, "chapter_id": 1347, "verse_number": "२-८८-४५", "content_sanskrit": "जहर्ष कर्णोऽतिभृशं सह दुःशासनादिभिः।\nइतरेषां तु सभ्यानां नेत्रेभ्यः प्रापतञ्जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2016549, "chapter_id": 1347, "verse_number": "२-८८-४६", "content_sanskrit": "सौबलस्त्वभिघायैव जितकाशी मदोत्कटः।\nजितमित्येव तानक्षान्पुररेवान्वपद्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2016550, "chapter_id": 1347, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि अष्टाशीतितमोऽध्यायः॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]