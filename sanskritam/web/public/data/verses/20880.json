[{"id": 7000880000, "chapter_id": 20880, "verse_number": "६-२२३-१", "content_sanskrit": "शौनक उवाच ।\nसूतसूत महाभाग धन्योसि त्वं भवांबुधौ ।\nयन्नोऽत्यर्थं निमग्नानां पाययस्वमृतोत्करम् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000880001, "chapter_id": 20880, "verse_number": "६-२२३-२", "content_sanskrit": "साधोऽत्र भवनिस्तार वांछतां नः समादिश ।\nमंत्ररत्नं भावशुद्धं यन्मयं सचराचरम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000880002, "chapter_id": 20880, "verse_number": "६-२२३-३", "content_sanskrit": "सूत उवाच ।\nशृणु शौनक वक्ष्यामि मंत्ररत्नं महाद्भुतम् ।\nयद्दिलीपाय गदितं वसिष्ठेन महात्मना ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000880003, "chapter_id": 20880, "verse_number": "६-२२३-४", "content_sanskrit": "एकदा तु दिलीपेन पृष्टमेतद्गुरुं प्रति ।\nवसिष्ठं द्विजशार्दूलं प्रणिपत्य यथा त्वया ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000880004, "chapter_id": 20880, "verse_number": "६-२२३-५", "content_sanskrit": "दिलीप उवाच ।\nभगवन्भवता प्रोक्तास्सर्वधर्माविशेषतः ।\nवर्णाश्रमयुता धर्मा नित्यनैमित्तिकाः क्रियाः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000880005, "chapter_id": 20880, "verse_number": "६-२२३-६", "content_sanskrit": "राजधर्म्माश्च यज्ञाश्च तीर्थदानव्रतादिकम् ।\nश्रुता मया मुनिःश्रेष्ठ अक्षय्य स्वर्गभोगदाः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000880006, "chapter_id": 20880, "verse_number": "६-२२३-७", "content_sanskrit": "अधुना श्रोतुमिच्छामि मोक्षमार्गं सनातनम् ।\nदिष्ट्याहं येन गच्छामि तद्ब्रह्मन्वक्तुमर्हसि ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000880007, "chapter_id": 20880, "verse_number": "६-२२३-८", "content_sanskrit": "को मंत्रं सर्वमंत्राणां भवरोगैकभेषजम् ।\nसर्वेषामेव देहीनां को हि मोक्षप्रदः परः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000880008, "chapter_id": 20880, "verse_number": "६-२२३-९", "content_sanskrit": "तत्समाख्याहि तत्त्वेन मयि वात्सल्यगौरवात् ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000880009, "chapter_id": 20880, "verse_number": "६-२२३-१०", "content_sanskrit": "वसिष्ठ उवाच ।\nसाधुपृष्टं त्वया राजन्सर्वलोकहितैषिणा ।\nवक्ष्यामि परमं गुह्यमेकं संसारतारकम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000880010, "chapter_id": 20880, "verse_number": "६-२२३-११", "content_sanskrit": "पुरा महर्षयः सर्वे यज्ञदानपराः शुभाः ।\nपप्रच्छुर्ब्रह्मणः पुत्रं नारदं मुनिसत्तमम् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000880011, "chapter_id": 20880, "verse_number": "६-२२३-१२", "content_sanskrit": "महर्षय ऊचुः ।\nभगवन्केन मंत्रेण गच्छामः परमं पदम् ।\nतन्नो ब्रूहि महाभाग प्रसादं कर्तुमर्हसि ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000880012, "chapter_id": 20880, "verse_number": "६-२२३-१३", "content_sanskrit": "नारद उवाच ।\nपितामहं पुरा सर्वे योगिनः सनकादयः ।\nपप्रच्छुरेकमेकांते मोक्षमार्गं सुदुर्ल्लभम् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000880013, "chapter_id": 20880, "verse_number": "६-२२३-१४", "content_sanskrit": "ब्रह्मोवाच ।\nशृणुध्वं योगिनः सर्वे रहस्यमिदमद्भुतम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000880014, "chapter_id": 20880, "verse_number": "६-२२३-१५", "content_sanskrit": "न जानंति सुराः सर्वे ऋषयश्च तपोधनाः ।\nसर्गादौ प्रोक्तवान्देवो मह्यं नारायणोऽव्ययः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000880015, "chapter_id": 20880, "verse_number": "६-२२३-१६", "content_sanskrit": "ईश्वर्या सह देव्या च सम्यक्संपूजितो मया ।\nततः प्रसन्नो भगवान्मम नारायणोऽव्ययः ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000880016, "chapter_id": 20880, "verse_number": "६-२२३-१७", "content_sanskrit": "प्राजापत्यं ददौ मह्यं श्रुतिजं सर्ववाङ्मयम् ।\nप्रकाशकानि मंत्राणि व्यापकाव्यापकानि च ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000880017, "chapter_id": 20880, "verse_number": "६-२२३-१८", "content_sanskrit": "ततस्तमब्रुवं देवं पुराणपुरुषोत्तमम् ।\nभगवन्केन मंत्रेण संसारोत्तारणं नृणाम् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000880018, "chapter_id": 20880, "verse_number": "६-२२३-१९", "content_sanskrit": "तन्ममाचक्ष्व तत्त्वेन सर्वलोकहिताय वै ।\nको मन्त्रः सर्वमन्त्राणां पुरश्चरणवर्जितः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000880019, "chapter_id": 20880, "verse_number": "६-२२३-२०", "content_sanskrit": "सकृदुच्चारणान्नृणां ददाति परमं पदम् ।\nश्रीभगवानुवाच ।\nसाधुपृष्टं महाभाग सर्वलोकहितैषिणा ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000880020, "chapter_id": 20880, "verse_number": "६-२२३-२१", "content_sanskrit": "तस्माद्वक्ष्यामि ते गुह्यं येन मामाप्नुयुर्नराः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000880021, "chapter_id": 20880, "verse_number": "६-२२३-२२", "content_sanskrit": "सर्वेषामेव मंत्राणां मंत्ररत्नं शुभावहम् ।\nसकृत्स्मरणमात्रेण ददाति परमं पदम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000880022, "chapter_id": 20880, "verse_number": "६-२२३-२३", "content_sanskrit": "मंत्ररत्नद्वयं न्यासं प्रयतिः शरणागतिः ।\nलक्ष्मीनारायणमिति मन्त्रः सर्वफलप्रदः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000880023, "chapter_id": 20880, "verse_number": "६-२२३-२४", "content_sanskrit": "नामानि मंत्ररत्नस्य पर्य्यायेण निबोधत ।\nतस्योच्चारणमात्रेण परितुष्टोस्मि नित्यशः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000880024, "chapter_id": 20880, "verse_number": "६-२२३-२५", "content_sanskrit": "कुलजो वा तपस्वी वा वेदवेदांगपारगः ।\nयज्ञदानपरो वापि सर्वतीर्थोपसेवकः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000880025, "chapter_id": 20880, "verse_number": "६-२२३-२६", "content_sanskrit": "व्रती वा सत्यवादी वा यतिर्वा ज्ञानवानपि ।\nमन्त्राधिकारी न भवेत्तं प्रयत्नेन वर्जयेत् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000880026, "chapter_id": 20880, "verse_number": "६-२२३-२७", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्या स्त्रियः शूद्रास्तथेतराः ।\nतस्याधिकारिणः सर्वे मम भक्तास्तु ते यदि ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000880027, "chapter_id": 20880, "verse_number": "६-२२३-२८", "content_sanskrit": "अनन्यशरणानां च तथैवानन्यसेविनाम् ।\nअनन्यसाधकानां च वक्तव्यो मन्त्र उत्तमः ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000880028, "chapter_id": 20880, "verse_number": "६-२२३-२९", "content_sanskrit": "आर्तानामाशु फलदस्सकृदेव कृतो ह्यसौ ।\nदृप्तानामपि जन्तूनां देहान्तरनिवारणः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000880029, "chapter_id": 20880, "verse_number": "६-२२३-३०", "content_sanskrit": "आर्त्तो जिज्ञासुरर्थार्थी ज्ञानी वापि प्रजापतिः ।\nसकृन्मां शरणं याति ततः कामानवाप्नुयात् ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000880030, "chapter_id": 20880, "verse_number": "६-२२३-३१", "content_sanskrit": "नादीक्षिताय वक्तव्यं नाभक्ताय च मानिने ।\nनास्तिकाय न लुब्धाय न श्रद्धाविमुखाय च ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000880031, "chapter_id": 20880, "verse_number": "६-२२३-३२", "content_sanskrit": "न चाशुश्रूषवे वाच्यं नासंवत्सरवासिने ।\nकामक्रोधविमुक्तस्तु दंभलोभविवर्जितः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000880032, "chapter_id": 20880, "verse_number": "६-२२३-३३", "content_sanskrit": "मां च यो व्यभिचारेण भक्तियोगेन सेवते ।\nवक्तव्य तस्य विधिवन्मंत्ररत्नमनुत्तमम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000880033, "chapter_id": 20880, "verse_number": "६-२२३-३४", "content_sanskrit": "देशकालादिनियमानरिमित्रादि शोधनम् ।\nन्यासमुद्रादिकं तस्य पुरश्चरणसंयुतम् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000880034, "chapter_id": 20880, "verse_number": "६-२२३-३५", "content_sanskrit": "मच्चक्रांकितदेहत्वं मदीयाराधनं तथा ।\nमयि सन्यस्तकर्मत्वं मदनन्यशरण्यतता ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000880035, "chapter_id": 20880, "verse_number": "६-२२३-३६", "content_sanskrit": "मयि सर्वफलन्यासो महाविश्वासपूर्वकम् ।\nअनन्यसाधनो यत्नस्त्वकिंचनत्वमात्मनः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000880036, "chapter_id": 20880, "verse_number": "६-२२३-३७", "content_sanskrit": "अवैष्णवानां संभाषा वंदनादि विवर्जनम् ।\nअनन्यदेवतानां च वन्दनं पूजनं तथा ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000880037, "chapter_id": 20880, "verse_number": "६-२२३-३८", "content_sanskrit": "एवमाद्यादि नियमां प्रपन्नस्य प्रकीर्तिताः ।\nइत्यादिगुणयुक्तस्य वक्तव्यं मंत्रमुत्तमम् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000880038, "chapter_id": 20880, "verse_number": "६-२२३-३९", "content_sanskrit": "तस्य नारायणश्चाहमृषिर्विष्णुः सनातनः ।\nदेवता च श्रिया सार्द्धमहं वात्सल्यसागरः ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000880039, "chapter_id": 20880, "verse_number": "६-२२३-४०", "content_sanskrit": "सर्वलोकेश्वरः श्रीमान्सुशीलः सुभगस्तथा ।\nसर्वज्ञः सर्वशक्तिश्च सदापूर्णमनोरथः ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000880040, "chapter_id": 20880, "verse_number": "६-२२३-४१", "content_sanskrit": "सर्वगः सर्वबंधुश्च कृपापीयूषसागरः ।\nश्रीमन्नारायणश्चाहं देवता समुदाहृतः ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000880041, "chapter_id": 20880, "verse_number": "६-२२३-४२", "content_sanskrit": "छंदस्तु देवी गायत्री पंचविंशाक्षरात्मिका ।\nद्विस्सप्तषट्त्रिपंचद्विषडंगानि नियोजयेत् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000880042, "chapter_id": 20880, "verse_number": "६-२२३-४३", "content_sanskrit": "लक्ष्म्या मदनपायिन्या मां ध्यायेद्विश्वरूपिणम् ।\nचक्रशंखगदापद्मपाणिनं दिव्यरूपिणम् ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000880043, "chapter_id": 20880, "verse_number": "६-२२३-४४", "content_sanskrit": "वामांकस्थश्रिया सार्द्धं पूजयेत्प्रयतं शुचिः ।\nअनेन मंत्ररत्नेन गंधपुष्पनिवेदनैः ।\nसकृत्संपूज्यमानोऽपि संतुष्टोस्मि प्रजापते ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000880044, "chapter_id": 20880, "verse_number": "६-२२३-४५", "content_sanskrit": "ब्रह्मोवाच ।\nसम्यगुक्तं त्वया नाथ रहस्यमिदमुत्तमम् ।\nमंत्ररत्नप्रभावश्च सर्वसिद्धिप्रदो नृणाम् ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000880045, "chapter_id": 20880, "verse_number": "६-२२३-४६", "content_sanskrit": "पिता त्वं सर्वलोकानां माता त्वं गुरुरेव च ।\nत्वं च स्वामी सखा भ्राता गतिस्त्वं शरणं सुहृत् ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000880046, "chapter_id": 20880, "verse_number": "६-२२३-४७", "content_sanskrit": "अहं तु तव देवेश दासश्शिष्यस्तथा सुहृत् ।\nतस्मान्मम दयासिंधो प्रोक्तवानिदमुत्तमम् ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000880047, "chapter_id": 20880, "verse_number": "६-२२३-४८", "content_sanskrit": "अधुना मंत्ररत्नस्य दीक्षां सम्यग्विधानतः ।\nब्रूहि सर्वत्र तत्वेन लोकानां हितकाम्यया ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000880048, "chapter_id": 20880, "verse_number": "६-२२३-४९", "content_sanskrit": "श्रीभगवानुवाच ।\nशणु वत्स प्रवक्ष्यामि मंत्र दीक्षाविधिं परम् ।\nआचार्यं संश्रयेत्पूर्वं मदाश्रयणसिद्धये ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000880049, "chapter_id": 20880, "verse_number": "६-२२३-५०", "content_sanskrit": "आचार्यो वेदसंपन्नो विष्णुभक्तो विमत्सरः ।\nमंत्रज्ञो मन्त्रभक्तश्च सदा मंत्राश्रयः शुचिः ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000880050, "chapter_id": 20880, "verse_number": "६-२२३-५१", "content_sanskrit": "सत्संप्रदायसंयुक्तो ब्रह्मविद्याविशारदः ।\nअनन्यसाधनश्चैव तथानन्यप्रयोजनः ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000880051, "chapter_id": 20880, "verse_number": "६-२२३-५२", "content_sanskrit": "ब्राह्मणो वीतरागश्च क्रोधलोभविवर्जितः ।\nसद्वृत्तौ शासिता चैव मुमुक्षुः परमात्मवित् ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000880052, "chapter_id": 20880, "verse_number": "६-२२३-५३", "content_sanskrit": "एवमादिगुणेपेत आचार्यः स मुदा सुहृत् ।\nआचाराञ्शासयेद्यस्तु स आचार्य इतीरितः ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000880053, "chapter_id": 20880, "verse_number": "६-२२३-५४", "content_sanskrit": "यस्त्वाचार्यपराधीनस्सद्वृत्तौ शास्यते यदि ।\nशासने स्थिरवृत्तश्च शिष्यः सद्भिरुदाहृतः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000880054, "chapter_id": 20880, "verse_number": "६-२२३-५५", "content_sanskrit": "एवं लक्षणसंयुक्तं शिष्यं सर्वगुणान्वितम् ।\nअध्यापयेद्विधानेन मन्त्ररत्ननुत्तमम् ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000880055, "chapter_id": 20880, "verse_number": "६-२२३-५६", "content_sanskrit": "द्वादश्यां श्रवणे वापि कर्हिचिद्वैष्णवे दिने ।\nसदाचार्योपसंप्रीतौ तत्र दीक्षां समाचेत् ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000880056, "chapter_id": 20880, "verse_number": "६-२२३-५७", "content_sanskrit": "सुदर्शनं पांचजन्यं सुवर्णेन प्रकारयेत् ।\nरौप्येण वापि ताम्रेण कांस्येनापि प्रकारयेत् ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000880057, "chapter_id": 20880, "verse_number": "६-२२३-५८", "content_sanskrit": "स्नाप्य पंचामृतैः शुद्धैरर्चयेत्पुरतो मम ।\nअर्च्चयेद्गंधपुष्पाद्यैस्तन्मंत्रेण विधानतः ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000880058, "chapter_id": 20880, "verse_number": "६-२२३-५९", "content_sanskrit": "तत्र संस्थापयेदग्नि स्वगृह्योक्त विधानतः ।\nआचार्यो जुहुयादाज्यं मंत्रेणाथ द्विजोत्तमः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000880059, "chapter_id": 20880, "verse_number": "६-२२३-६०", "content_sanskrit": "अष्टोत्तरसहस्रं वा शतमष्टोत्तरं तु वा ।\nजुहुयान्मंत्ररत्नेन तथान्यैर्वैष्णवैः शुभैः ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000880060, "chapter_id": 20880, "verse_number": "६-२२३-६१", "content_sanskrit": "मंत्रैः पुरुषसूक्ताद्यैर्जुहुयाघृतपायसम् ।\nतस्मिन्नग्नौ क्षिपेच्चक्रं शंखं च द्विजत्तमः ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000880061, "chapter_id": 20880, "verse_number": "६-२२३-६२", "content_sanskrit": "षडक्षरेण जुहुयादाज्यं विंशतिसंख्यया ।\nप्रतप्तं चक्रमादाय मंत्रैणैव तथा गुरुः ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000880062, "chapter_id": 20880, "verse_number": "६-२२३-६३", "content_sanskrit": "शंखेनैवांकनं कुर्याद्बाह्वोर्दक्षिणसव्ययोः ।\nहोमशेषं समाप्याथ पुनः पूजां समाचरेत् ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000880063, "chapter_id": 20880, "verse_number": "६-२२३-६४", "content_sanskrit": "ततः कलशमादाय पवित्रोदकपूरितम् ।\nमंत्रेणैवाभिमंत्र्याथ तस्य मूर्ध्न्यभिषेचयेत् ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000880064, "chapter_id": 20880, "verse_number": "६-२२३-६५", "content_sanskrit": "सितवस्त्रधरं सम्यगाचांतं विनयान्वितम् ।\nऊर्द्ध्वपुण्ड्रधरं शिष्यं मंत्रमध्यापयेद्गुरुः ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000880065, "chapter_id": 20880, "verse_number": "६-२२३-६६", "content_sanskrit": "मंत्रार्थश्च प्रवक्तव्यो वृत्तिश्चैव विशेषतः ।\nलब्धमंत्रस्तदाचार्यं पूजयेद्भूषणादिभिः ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000880066, "chapter_id": 20880, "verse_number": "६-२२३-६७", "content_sanskrit": "अनेन विधिना मंत्रं योऽधीते वैष्णवाद्गुरोः ।\nततः स वैष्णवं याति नान्यथा सुरसत्तम ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000880067, "chapter_id": 20880, "verse_number": "६-२२३-६८", "content_sanskrit": "नारद उवाच ।\nएवमुक्त्त्वा विधातारं देवदेवो हरिः पिता ।\nस्वचक्रेणांकयित्वा तु तस्मै मंत्रं ददौ स्वयम् ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000880068, "chapter_id": 20880, "verse_number": "६-२२३-६९", "content_sanskrit": "सर्वलोकेश्वरो देवो ब्रह्मा मम पिता प्रभुः ।\nममापि विधिवन्मंत्रं स ददौ मुनिसत्तमाः ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000880069, "chapter_id": 20880, "verse_number": "६-२२३-७०", "content_sanskrit": "तस्माद्यूयं मुनिश्रेष्ठा धारयित्वा सुदर्शनम् ।\nनारायणपदं द्वंद्वं गच्छध्वं शरणं द्विजाः ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000880070, "chapter_id": 20880, "verse_number": "६-२२३-७१", "content_sanskrit": "वसिष्ठ उवाच ।\nइत्युक्त्वा मुनयः सर्वे नारदेन सुरर्षिणा ।\nद्वयाधिकारिणः सर्वे याता विष्णोः परं पदम् ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000880071, "chapter_id": 20880, "verse_number": "६-२२३-७२", "content_sanskrit": "तस्मात्त्वमपि राजर्षे विष्णुसायुज्यमिच्छसि ।\nदीक्षामार्गविधानेन धारयित्वा सुदर्शनम् ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000880072, "chapter_id": 20880, "verse_number": "६-२२३-७३", "content_sanskrit": "नारायणपदद्वंद्वं तदेकं शरणं व्रज ।\nसर्वलोकेश्वरः साक्षाद्ब्रह्मा त्रिभुवनेश्वरः ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000880073, "chapter_id": 20880, "verse_number": "६-२२३-७४", "content_sanskrit": "ममापि नारदस्यापि प्रोक्तवान्मंत्रमुत्तमम् ।\nशौनकादि महर्षीणां नैमिषारण्यवासिनाम् ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000880074, "chapter_id": 20880, "verse_number": "६-२२३-७५", "content_sanskrit": "नारदः प्रददौ मंत्रं प्रपत्तिं शरणागतिम् ।\nएतद्गुह्यतमं राजन्न जानंति महर्षयः ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000880075, "chapter_id": 20880, "verse_number": "६-२२३-७६", "content_sanskrit": "देवाताश्च न जानंति सिद्धा साध्याश्च दानवाः ।\nमयापि प्रापितो मंत्रं शक्तिपुत्रः पराशरः ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000880076, "chapter_id": 20880, "verse_number": "६-२२३-७७", "content_sanskrit": "इदं रहस्यं परमं लक्ष्मीनारायणं द्वयम् ।\nराजंस्तवापि वक्ष्यामि प्रपत्ति शरणागतिम् ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000880077, "chapter_id": 20880, "verse_number": "६-२२३-७८", "content_sanskrit": "द्वयात्परतरं मन्त्रं नास्ति सत्यं ब्रवीमि ते ।\nअस्मात्परतरं धर्म्मं नास्ति लोकेषु किंचन ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000880078, "chapter_id": 20880, "verse_number": "६-२२३-७९", "content_sanskrit": "सत्यं सत्यं पुनः सत्यं ब्रह्मणा कथितं पुरा ।\nनारायणात्परो देवो नास्ति मुक्तिप्रदो नृणाम् ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000880079, "chapter_id": 20880, "verse_number": "६-२२३-८०", "content_sanskrit": "तत्सेवैव भवेन्मोक्षः सर्वकर्म निकृंतनः ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]