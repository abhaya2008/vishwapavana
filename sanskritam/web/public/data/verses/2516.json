[{"id": 2071820, "chapter_id": 2516, "verse_number": "१२-२१-०x", "content_sanskrit": "देवस्थान उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071821, "chapter_id": 2516, "verse_number": "१२-२१-१", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nइन्द्रेण समये पृष्टो यदुवाच बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071822, "chapter_id": 2516, "verse_number": "१२-२१-२", "content_sanskrit": "संतोषो वै स्वर्गसमः संतोषः परमं सुखम्।\nतुष्टेर्न किंचित्परतः सा सम्यक्प्रतितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071823, "chapter_id": 2516, "verse_number": "१२-२१-३", "content_sanskrit": "यदा संहरते कामान्कूर्मोऽङ्गानीव सर्वशः।\nतदाऽऽत्मज्योतिरचिरात्स्वात्मन्येव प्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071824, "chapter_id": 2516, "verse_number": "१२-२१-४", "content_sanskrit": "न विभेति यदा चायं यदा चास्मान्न बिभ्यति।\nकामद्वेषौ च जयति तदाऽऽत्मानं च पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071825, "chapter_id": 2516, "verse_number": "१२-२१-५", "content_sanskrit": "यदाऽसौ सर्वभूतानां न द्रुह्यति न काङ्क्षति।\nकर्मणा मनसा वाचा ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071826, "chapter_id": 2516, "verse_number": "१२-२१-६", "content_sanskrit": "एवं कौन्तेय भूतानि तंतं धर्मं तथातथा।\nतदाऽऽत्मना प्रपश्यन्ति तस्माद्वुध्यस्व भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071827, "chapter_id": 2516, "verse_number": "१२-२१-७", "content_sanskrit": "अन्ये साम प्रशंसन्ति व्यायाममपरे जनाः।\nनैकं न चापरं केचिदुभयं च तथाऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071828, "chapter_id": 2516, "verse_number": "१२-२१-८", "content_sanskrit": "यज्ञमेके प्रशंसन्ति संन्यासमपरे जनाः।\n`नैकं न चापरं केचिदुभयं च तथाऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071829, "chapter_id": 2516, "verse_number": "१२-२१-९", "content_sanskrit": "दानमेके प्रशंसन्ति केचिच्चैव प्रतिग्रहम्।\nकेचित्सर्वं परित्यज्य तूष्णीं ध्यायन्त आसते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071830, "chapter_id": 2516, "verse_number": "१२-२१-१०", "content_sanskrit": "राज्यमेके प्रशंसन्ति प्रजानां परिपालनम्।\nहत्वा छित्त्वा च भित्त्वा च केचिदेकान्तशीलिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071831, "chapter_id": 2516, "verse_number": "१२-२१-११", "content_sanskrit": "एतत्सर्वं समालोक्य बुधानामेव निश्चयः।\nअद्रोहेणैव भूतानां यो धर्मः स सतां मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071832, "chapter_id": 2516, "verse_number": "१२-२१-१२", "content_sanskrit": "अद्रोहः सत्यवचनं संविभागो दया दमः।\nप्रजनं स्वेषु दारेषु मार्दवं हीरचापलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071833, "chapter_id": 2516, "verse_number": "१२-२१-१३", "content_sanskrit": "एवं धर्मं प्रधानेष्टं मनुः स्वायंभुवोऽब्रवीत्।\nतस्मादेतत्प्रयत्नेन कौन्तेय प्रतिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071834, "chapter_id": 2516, "verse_number": "१२-२१-१४", "content_sanskrit": "यो हि राज्ये स्थितः शश्वद्वशी तुल्यप्रियाप्रियः।\nक्षत्रियो यज्ञशिष्टाशी राजा शास्त्रार्थतत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071835, "chapter_id": 2516, "verse_number": "१२-२१-१५", "content_sanskrit": "असाधुनिग्रहरतः साधूनां प्रग्रहे रतः।\nधर्मवर्त्मनि संस्थाप्य प्रजा वर्तेत धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071836, "chapter_id": 2516, "verse_number": "१२-२१-१६", "content_sanskrit": "पुत्रसंक्रामितश्रीश्च वने वन्येन वर्तयेत्।\nविधानमाश्रमाणां वै कुर्यात्कर्माण्यतन्द्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071837, "chapter_id": 2516, "verse_number": "१२-२१-१७", "content_sanskrit": "य एवं वर्तते राजन्स राजा धर्मनिश्चितः।\nतस्यायं च परश्चैव लोकः स्यात्संफलोदयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071838, "chapter_id": 2516, "verse_number": "१२-२१-१८", "content_sanskrit": "निर्वाणं हि सुदुष्प्राप्यं बहुविघ्नं च मे मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071839, "chapter_id": 2516, "verse_number": "१२-२१-१९", "content_sanskrit": "एवं धर्ममनुक्रान्ताः सत्यदानतपः पराः।\nआनृशंस्यगुणैर्युक्ताः कामक्रोधविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071840, "chapter_id": 2516, "verse_number": "१२-२१-२०", "content_sanskrit": "प्रजानां पालने युक्ता धर्ममुत्तममास्थिताः।\nगोब्राह्मणार्थे युध्यन्तः प्राप्ता गतिमनुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071841, "chapter_id": 2516, "verse_number": "१२-२१-२१", "content_sanskrit": "एवं रुद्राः सवसवस्तथाऽऽदित्याः परंतप।\nसाध्या राजर्षिसङ्घाश्च धर्ममेतं समाश्रिताः।\nअप्रमत्तास्ततः स्वर्गं प्राप्ताः पुण्यैः स्वकर्मभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071842, "chapter_id": 2516, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकविंशोऽध्यायः॥ २१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]