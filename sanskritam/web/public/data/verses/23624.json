[{"id": 7003624000, "chapter_id": 23624, "verse_number": "१-२-११-१", "content_sanskrit": "कूर्म उवाच ।\nशांडिल्य इति विख्यातः पुराहमभवं द्विजः ।\nबालभावे मया भूप क्रीडमानेन निर्मितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003624001, "chapter_id": 23624, "verse_number": "१-२-११-२", "content_sanskrit": "पुरा प्रावृषि पांशूत्थं शिवायतनमुच्छ्रितम् ।\nजलार्द्रवालुकाप्रायं प्रांशुप्राकारशोभितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003624002, "chapter_id": 23624, "verse_number": "१-२-११-३", "content_sanskrit": "पंचायतनविन्यासमनोहरतरं नृप ।\nविनायकशिवासूर्यमधुसूदनमूर्तिमत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003624003, "chapter_id": 23624, "verse_number": "१-२-११-४", "content_sanskrit": "पीतमृत्स्वर्णकलशं ध्वजमालाविभूषितम् ।\nकाष्ठतोरणविन्यस्तं दोलकेन विभूषितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003624004, "chapter_id": 23624, "verse_number": "१-२-११-५", "content_sanskrit": "दृढप्रांशुसमुद्भूतसोपानश्रेणिभासुरम् ।\nसर्वाश्चर्यमयं दिव्यं वयस्यैः संवृतेन मे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003624005, "chapter_id": 23624, "verse_number": "१-२-११-६", "content_sanskrit": "तत्र जागेश्वरं लिंगं गृत्वाथ विनिवेशितम् ।\nबाल्यादुपलरूपं तद्वर्षावारिविशुद्विमत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003624006, "chapter_id": 23624, "verse_number": "१-२-११-७", "content_sanskrit": "बकपुष्पैस्तथान्यैश्च केदारोत्थैः समाहृतैः ।\nकोमलैरपरैः पुष्पैर्वृतिवल्लीसमुद्भवैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003624007, "chapter_id": 23624, "verse_number": "१-२-११-८", "content_sanskrit": "कूष्मांडैश्चैव वर्णाद्यैरुन्मत्तकुसुमायुतैः ।\nमंदारैर्बिल्वपत्रैश्च दूर्वाद्यैश्च नवांकुरैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003624008, "chapter_id": 23624, "verse_number": "१-२-११-९", "content_sanskrit": "पूजा विरचिता रम्या शंभोरिति मया नृप ।\nततस्तांडवमारब्धमनपेक्षितसत्क्रियम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003624009, "chapter_id": 23624, "verse_number": "१-२-११-१०", "content_sanskrit": "शिवस्य पुरतो बाल्याद्गीतं च स्वस्वर्जितम् ।\nअकार्षं सकृदेवाहं बाल्ये शिशुगणावृतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003624010, "chapter_id": 23624, "verse_number": "१-२-११-११", "content_sanskrit": "ततो मृतोऽहं जातश्च विप्रो जातिस्मरो नृप ।\nवैदिशे नगरेऽकार्षं शिवपूजां विशेषतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003624011, "chapter_id": 23624, "verse_number": "१-२-११-१२", "content_sanskrit": "शिवदीक्षामुपागम्यानुगृहीतः शिवागमैः ।\nशिवप्रासाद आधाय लिंगं श्रद्धासमन्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003624012, "chapter_id": 23624, "verse_number": "१-२-११-१३", "content_sanskrit": "कल्पकोटिं वसेत्स्वर्गेयः करोति शिवालयम् ।\nयावंति परमाणूनि शिवस्यायतने नृप ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003624013, "chapter_id": 23624, "verse_number": "१-२-११-१४", "content_sanskrit": "भवंति तावद्वर्षाणि करकः शिवसद्मनि ।\nइति पौराणवाक्यानि स्मरञ्छैलं शिवालयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003624014, "chapter_id": 23624, "verse_number": "१-२-११-१५", "content_sanskrit": "अकारिषमहं रम्यं विश्वकर्मविधानतः ।\nमृन्मयं काष्ठनिष्पन्नं पाक्वेष्टं शैलमेव वा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003624015, "chapter_id": 23624, "verse_number": "१-२-११-१६", "content_sanskrit": "कृतमायतनं दद्यात्क्रमाद्दशगुणं फलम् ।\nभस्मशायी त्रिषवणो भिक्षान्नकृतभोजनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003624016, "chapter_id": 23624, "verse_number": "१-२-११-१७", "content_sanskrit": "जटाधरस्तपस्यंश्च शिवाराधनतत्परः ।\nइत्थं मे कुर्वतो जातं पुनर्भूप प्रमापणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003624017, "chapter_id": 23624, "verse_number": "१-२-११-१८", "content_sanskrit": "जातो जाति स्मरस्तत्र कारिता तृतीयेहं भवांतरे ।\nसार्वभौमो महीपालः प्रतिष्ठाने पुरोत्तमे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003624018, "chapter_id": 23624, "verse_number": "१-२-११-१९", "content_sanskrit": "जयदत्त इति ख्यातः सूर्यवंशसमुद्भवः ।\nततो मया बहुविधाः प्रासादाः कारिता नृप ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003624019, "chapter_id": 23624, "verse_number": "१-२-११-२०", "content_sanskrit": "तस्मिन्भवांतरे शंभोराराधनपरेण च ।\nततो निरूपिता जाता बकपुष्पपुरस्सराः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003624020, "chapter_id": 23624, "verse_number": "१-२-११-२१", "content_sanskrit": "सौवर्णै राजतै रत्ननिर्मितैः कुसुमैर्नृप ।\nतथाविधेऽन्नदानादि करोमि नृपसत्तम ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003624021, "chapter_id": 23624, "verse_number": "१-२-११-२२", "content_sanskrit": "केवलं शिवलिंगानां पूजां पुष्पैः करोम्यहम् ।\nततो मे भगवाञ्छंभुः संतुष्टोऽथ वरं ददौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003624022, "chapter_id": 23624, "verse_number": "१-२-११-२३", "content_sanskrit": "अजरामरतां राजंस्तेनैव वपुषावृतः ।\nततस्तथाविधं प्राप्यानन्यसाधारणं वरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003624023, "chapter_id": 23624, "verse_number": "१-२-११-२४", "content_sanskrit": "विचरामि महीमेतां मदांध इव वारणः ।\nशिवभक्तिं विहायाथ नृपोऽहं मदनातुरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003624024, "chapter_id": 23624, "verse_number": "१-२-११-२५", "content_sanskrit": "प्रधर्षयितुमारब्धः स्त्रियः परपरिग्रहाः ।\nआयुषस्तपसः कीर्तेस्तेजसो यशसः श्रियः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003624025, "chapter_id": 23624, "verse_number": "१-२-११-२६", "content_sanskrit": "विनाशकारणं मुख्यं परदारप्रधर्षणम् ।\nसकर्णः श्रुतिहीनोऽसौ पश्यन्नंधो वदञ्जडः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003624026, "chapter_id": 23624, "verse_number": "१-२-११-२७", "content_sanskrit": "अचेतनश्चेतनावान्मूर्खो विद्वानपि स्फुटम् ।\nतदा भवति भूपाल पुरुषः क्षणमात्रतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003624027, "chapter_id": 23624, "verse_number": "१-२-११-२८", "content_sanskrit": "यदैव हरिणाक्षीणां गोचरं याति चक्षुषाम् ।\nमृतस्य निरये वासो जीवतश्चेश्वराद्भयम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003624028, "chapter_id": 23624, "verse_number": "१-२-११-२९", "content_sanskrit": "एवं लोकद्वयं हंत्री परदारप्रधर्षणा ।\nजरामरणहीनोहमिति निश्चयमास्थितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003624029, "chapter_id": 23624, "verse_number": "१-२-११-३०", "content_sanskrit": "ऐहिकामुष्मिकभयं विहायांह ततः परम् ।\nप्रधर्षयितुमारब्धस्तदा भूप परस्त्रियः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003624030, "chapter_id": 23624, "verse_number": "१-२-११-३१", "content_sanskrit": "अथ मां संपरिज्ञाय मर्यादारहितं यमः ।\nवरप्रदानादीशस्य तदंतिकसुपाययौ ।\nव्यजिज्ञपन्मदीयं च शंभोर्धर्मव्यतिक्रमम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003624031, "chapter_id": 23624, "verse_number": "१-२-११-३२", "content_sanskrit": "यम उवाच ।\nनाहं तवानुभावेन गुप्तस्यास्य विनिग्रहम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003624032, "chapter_id": 23624, "verse_number": "१-२-११-३३", "content_sanskrit": "शक्रोमि पापिनो देव मन्नियोगेऽन्यमादिश ।\nजगदाधारूपा हि त्वयेशोक्ताः पतिव्रताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003624033, "chapter_id": 23624, "verse_number": "१-२-११-३४", "content_sanskrit": "गावो विप्राः सनिगमा अलुब्धा दानशीलिनः ।\nसत्यनिष्ठा इति स्वामिंस्तेषां मुख्यतमा सती ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003624034, "chapter_id": 23624, "verse_number": "१-२-११-३५", "content_sanskrit": "तास्तेन धर्षिता लुप्तं मदीयं धर्मशासनम् ।\nवरदानप्रमत्तेन तवैव परिभूय माम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003624035, "chapter_id": 23624, "verse_number": "१-२-११-३६", "content_sanskrit": "जयदत्तेन देवेश प्रतिष्ठानाधिवासिना ।\nइमां धर्मस्य भगवान्गिरमाकर्ण्य कोपितः ।\nशशाप मां समानीय वेपमानं कृतांजलिम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003624036, "chapter_id": 23624, "verse_number": "१-२-११-३७", "content_sanskrit": "ईश्वर उवाच ।\nयस्माद्दुष्टसमाचार धर्षितास्ते पतिव्रताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003624037, "chapter_id": 23624, "verse_number": "१-२-११-३८", "content_sanskrit": "कामार्तेन मया शप्तस्तस्मात्कूर्मः क्षणाद्भव ।\nततः प्रणम्य विज्ञप्तः शापतापहरो मया ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003624038, "chapter_id": 23624, "verse_number": "१-२-११-३९", "content_sanskrit": "प्राह षष्टितमे कल्पे विशापो भविता गणः ।\nमदीय इति संप्रोच्य जगामादर्शनं शिवः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003624039, "chapter_id": 23624, "verse_number": "१-२-११-४०", "content_sanskrit": "अहं कूर्मस्तदा जातो दशयोजनविस्तृतः ।\nसमुद्रसलिले नीतस्त्वयाहं यज्ञसाधने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003624040, "chapter_id": 23624, "verse_number": "१-२-११-४१", "content_sanskrit": "पुरस्ताद्यायजूकेन स्मरंस्तच्च बिभेमि ते ।\nदग्धस्त्वयाहं पृष्ठेत्र व्रणान्येतानि पश्य मे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003624041, "chapter_id": 23624, "verse_number": "१-२-११-४२", "content_sanskrit": "चयनानि बहून्यत्र कल्पसूत्रविधानतः ।\nपृष्ठोपरि कृतान्यासन्निंद्रद्युम्न तदा त्वया ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003624042, "chapter_id": 23624, "verse_number": "१-२-११-४३", "content_sanskrit": "भूयः संतापिता यज्ञैः पृथिवी पृथिवीपते ।\nसुस्राव सर्वतीर्थानां सारं साऽभून्महीनदी ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003624043, "chapter_id": 23624, "verse_number": "१-२-११-४४", "content_sanskrit": "तस्यां च स्नानमात्रेण सर्वपापैः प्रमुच्यते ।\nततो नैमित्तिके कस्मिन्नपि प्रलय आगतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003624044, "chapter_id": 23624, "verse_number": "१-२-११-४५", "content_sanskrit": "प्लवमानमिदं राजन्मानसं शतयोजनम् ।\nषट्पंचाशत्प्रमाणेन कल्पा मम पुरा नृप ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003624045, "chapter_id": 23624, "verse_number": "१-२-११-४६", "content_sanskrit": "व्यतीता इह चत्वारः शेषे मोक्षस्ततः परम् ।\nएवमायुरिदं दीर्घमेवं शापाच्च कूर्मता ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003624046, "chapter_id": 23624, "verse_number": "१-२-११-४७", "content_sanskrit": "ममाभूदीश्वरस्यैव सतीधर्मद्रुहो नृप ।\nब्रूहि किं क्रियतां शत्रोरपि ते गृहगामिनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003624047, "chapter_id": 23624, "verse_number": "१-२-११-४८", "content_sanskrit": "मम पृष्ठिश्चिरं भूप त्वया दग्धाग्निनाऽपुरा ।\nअहं ज्वलंतीमिव तां पश्याम्यद्यापि सत्रिणा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003624048, "chapter_id": 23624, "verse_number": "१-२-११-४९", "content_sanskrit": "इदं विमानमायातं त्वया कस्मान्निराकृतम् ।\nदेवदूतसमायुक्तं भुंक्ष्व भोगान्निजार्जितान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003624049, "chapter_id": 23624, "verse_number": "१-२-११-५०", "content_sanskrit": "इंद्रद्युम्न उवाच ।\nचतुर्मुखेन तेनाहं स्वर्गान्निर्वासितः स्वयम् ।\nविलक्ष्योन प्रयास्यामि पाताधिक्यादिदूषिते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003624050, "chapter_id": 23624, "verse_number": "१-२-११-५१", "content_sanskrit": "तस्माद्विवेकवैराग्यमविद्यापापनाशनम् ।\nआलिंग्याहं यतिष्यामि प्राप्य बोधं विमुक्तये ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003624051, "chapter_id": 23624, "verse_number": "१-२-११-५२", "content_sanskrit": "तन्मे गृहगतस्याद्य यथातिथ्यकरो भवान् ।\nतदादिश यथाऽपारपारदः कोपि मे गुरुः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003624052, "chapter_id": 23624, "verse_number": "१-२-११-५३", "content_sanskrit": "कूर्म उवाच ।\nलोमशोनाम दीर्घायुर्मत्तोऽप्यस्ति महामुनिः ।\nमया कलापग्रामे स पूर्वं दृष्टः क्वचिन्नृप ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003624053, "chapter_id": 23624, "verse_number": "१-२-११-५४", "content_sanskrit": "इंद्रद्युम्न उवाच ।\nतस्मादागच्छ गच्छामस्तमेव सहितावयम् ।\nप्राहुः पूततमां तीर्थादपि सत्संगतिं बुधाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003624054, "chapter_id": 23624, "verse_number": "१-२-११-५५", "content_sanskrit": "इत्थं निशम्य नृपतेर्वचनं तदानीं सर्वेऽपि ते षडथ तं मुनिमुख्यमाशु ।\nचित्ते विधाय मुदिताः प्रययुर्द्विजेंद्रं जिज्ञासवः सुचिरजीवितहेतुमस्य ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]