[{"id": 2170701, "chapter_id": 4646, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2170702, "chapter_id": 4646, "verse_number": "१", "content_sanskrit": "युधिष्ठिरेणैवमुक्तः कौन्तेयः श्वेतवाहनः ।\nअसिं जग्राह सङ्क्रुद्धो जिघांसुर्भरतर्षभम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2170703, "chapter_id": 4646, "verse_number": "२", "content_sanskrit": "तस्य कोपं समुद्वीक्ष्य चित्तज्ञः केशवस्तदा ।\nउवाच किमिदं पार्थ गृहीतः खड्ग इत्युत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2170704, "chapter_id": 4646, "verse_number": "३", "content_sanskrit": "नेह पश्यामि योद्धव्यं तव किञ्चिद्धनञ्जय ।\nनेहागता धार्तराष्ट्राः सर्वे भीमेन वारिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2170705, "chapter_id": 4646, "verse_number": "४", "content_sanskrit": "उपागतोऽसि कौन्तेय राजा द्रष्टव्य इत्यपि ।\nस राजा भवता दृष्टः कुशली च युधिष्ठिरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2170706, "chapter_id": 4646, "verse_number": "५", "content_sanskrit": "तं दृष्ट्वा नृपशार्दूलं शार्दूलसमविक्रमम् ।\nहर्षकाले तु सम्प्राप्ते किमिदं मोहकारितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2170707, "chapter_id": 4646, "verse_number": "६", "content_sanskrit": "न तं पश्यामि कौन्तेय यस्ते वध्यो भविष्यति ।\nप्रहर्तुमिच्छसे कस्मात् किं वा ते चित्तविभ्रमः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2170708, "chapter_id": 4646, "verse_number": "७", "content_sanskrit": "कस्माद्भवान् महाखड्गं परिगृह्णाति सत्वरम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2170709, "chapter_id": 4646, "verse_number": "८", "content_sanskrit": "तत्त्वा पृच्छामि कौन्तेय किमिदं ते चिकीर्षितम् ।\nपरामृशसि यत्क्रुद्धः खड्गमद्भुतविक्रम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2170710, "chapter_id": 4646, "verse_number": "९", "content_sanskrit": "एवमुक्तस्तु कृष्णेन प्रेक्षमाणो युधिष्ठिरम् ।\nअर्जुनः प्राह गोविन्दं क्रुद्धः सर्प इव श्वसन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2170711, "chapter_id": 4646, "verse_number": "१०", "content_sanskrit": "दद गाण्डीवमन्यस्मा इति मां योऽभिचोदयेत् ।\nछिन्द्यामहं शिरस्तस्य इत्युपांशुव्रतं मम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2170712, "chapter_id": 4646, "verse_number": "११", "content_sanskrit": "तदुक्तोऽहमदीनात्मन् राज्ञामितपराक्रम ।\nसमक्षं तव गोविन्द न तत्क्षन्तुमिहोत्सहे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2170713, "chapter_id": 4646, "verse_number": "१२", "content_sanskrit": "तस्मादेनं वधिष्यामि राजानं धर्मभीरुकः ।\nप्रतिज्ञां पालयिष्यामि हत्वेमं यदुसत्तम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2170714, "chapter_id": 4646, "verse_number": "१३", "content_sanskrit": "एतदर्थं मया खड्गो गृहीतो यदुनन्दन\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2170715, "chapter_id": 4646, "verse_number": "१४", "content_sanskrit": "सोऽहं युधिष्ठिरं हत्वा सत्यस्यानृण्यतां गतः ।\nविशोको विज्वरश्चापि भविष्यामि जनार्दन\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2170716, "chapter_id": 4646, "verse_number": "१५", "content_sanskrit": "किं वा त्वं मन्यसे प्राप्तमस्मिन् काले समुत्थिते ।\nत्वमस्य जगतस्तात वेत्थ सर्वं गतागतम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2170717, "chapter_id": 4646, "verse_number": "१६", "content_sanskrit": "तत्तथा प्रकरिष्यामि यथा मां वक्ष्यते भवान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2170718, "chapter_id": 4646, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2170719, "chapter_id": 4646, "verse_number": "१७", "content_sanskrit": "धिग् धिगित्येव गोविन्दः पार्थमुक्त्वाब्रवीत् पुनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2170720, "chapter_id": 4646, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2170721, "chapter_id": 4646, "verse_number": "१८", "content_sanskrit": "इदानीं पार्थ जानामि न वृद्धाः सेवितास्त्वया ।\nअकाले पुरुषव्याघ्र संरम्भक्रिययानया\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2170722, "chapter_id": 4646, "verse_number": "१९", "content_sanskrit": "न हि धर्मविभागज्ञः कुर्यादेवं धनञ्जय\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2170723, "chapter_id": 4646, "verse_number": "२०", "content_sanskrit": "अकार्याणां च कार्याणां संयोगं यः करोति वै ।\nकार्याणामक्रियाणां च स पार्थ पुरुषाधमः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2170724, "chapter_id": 4646, "verse_number": "२१", "content_sanskrit": "यथा त्वं पाण्डवाद्येह धर्मभीरुरपण्डितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2170725, "chapter_id": 4646, "verse_number": "२२", "content_sanskrit": "अनुसृत्य तु ये धर्मं कवयः समुपासते ।\nसमासविस्तरविदां न तेषां वेत्थ निश्चयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2170726, "chapter_id": 4646, "verse_number": "२३", "content_sanskrit": "अनिश्चयज्ञो हि नरः कार्याकार्यविनिश्चये ।\nअवशो मुह्यते पार्थ यथा त्वं मूढ एव तु\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2170727, "chapter_id": 4646, "verse_number": "२४", "content_sanskrit": "न हि कार्यमकार्यं वा सुखं ज्ञातुं कथञ्चन ।\nश्रुतेन ज्ञायते सर्वं तच्च त्वं नावबुध्यसे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2170728, "chapter_id": 4646, "verse_number": "२५", "content_sanskrit": "अविज्ञानाद् भवान् यच्च धर्मं रक्षितुमिच्छति ।\nप्राणिनां हि वधं पार्थ धार्मिको नावबुध्यते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2170729, "chapter_id": 4646, "verse_number": "२६", "content_sanskrit": "प्राणिनामवधस्तात सर्वज्यायान् मतो मम ।\nअनृतं तु भवेद् वाच्यं न च हिंस्यात् कथञ्चन\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2170730, "chapter_id": 4646, "verse_number": "२७", "content_sanskrit": "स कथं भ्रातरं ज्येष्ठं राजानं धर्मकोविदम् ।\nहन्याद् भवान् नरश्रेष्ठ प्राकृतोऽन्यः पुमानिव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2170731, "chapter_id": 4646, "verse_number": "२८", "content_sanskrit": "अयुध्यमानस्य वधस्तथाशस्त्रस्य भारत ।\nपराङ्मुखस्य द्रवतः शरणं वाभिगच्छतः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2170732, "chapter_id": 4646, "verse_number": "२९", "content_sanskrit": "कृताञ्जलेः प्रपन्नस्य (प्रमत्तस्य तथैव च ।\nन वधः पूज्यते सद्भिस्तच्च सर्वं गुरौ तव)\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2170733, "chapter_id": 4646, "verse_number": "३०", "content_sanskrit": "त्वया चैव व्रतं पार्थ बालेनैव कृतं पुरा ।\nतस्मादधर्मसंयुक्तं मौढ्यात् कर्म व्यवस्यसि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2170734, "chapter_id": 4646, "verse_number": "३१", "content_sanskrit": "स गुरुं पार्थ कस्मात्त्वं हन्या धर्ममनुस्मरन् ।\nअसम्प्रधार्य धर्माणां गतिं सूक्ष्मां दुरन्वयाम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2170735, "chapter_id": 4646, "verse_number": "३२", "content_sanskrit": "इदं धर्मरहस्यं च वक्ष्यामि भरतर्षभ ।\nयद् ब्रूयात् तव भीष्मो वा धर्मज्ञो वा युधिष्ठिरः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2170736, "chapter_id": 4646, "verse_number": "३३", "content_sanskrit": "विदुरो वा तथा क्षत्ता कुन्ती वापि यशस्विनी ।\nतत्ते वक्ष्यामि तत्त्वेन तन्निबोध धनञ्जय\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2170737, "chapter_id": 4646, "verse_number": "३४", "content_sanskrit": "सत्यस्य वचनं साधु न सत्याद् विद्यते परम् ।\nसुदुर्विदं हि तत्वेन तत्सत्यमिति मे मतिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2170738, "chapter_id": 4646, "verse_number": "३५", "content_sanskrit": "भवेत् सत्यमवक्तव्यं वक्तव्यमनृतं भवेत् ।\nयत्रानृतं भवेत् सत्यं सत्यं चाप्यनृतं भवेत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2170739, "chapter_id": 4646, "verse_number": "३६", "content_sanskrit": "विवाहकाले रतिसम्प्रयोगे\nप्राणात्यये सर्वधनापहारे ।\nविप्रस्य चार्थे ह्यनृतं वदेत\nपञ्चानृतान्याहुरपातकानि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2170740, "chapter_id": 4646, "verse_number": "३७", "content_sanskrit": "सर्वस्वस्यापहारे तु वक्तव्यमनृतं भवेत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2170741, "chapter_id": 4646, "verse_number": "३८", "content_sanskrit": "प्राणात्यये विवाहे च वक्तव्यमनृतं भवेत् ।\nतत्रानृतं भवेत् सत्यं सत्यं चाप्यनृतं भवेत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2170742, "chapter_id": 4646, "verse_number": "३९", "content_sanskrit": "तादृशं मन्यतेऽबालो यत्र सत्यमनिश्चितम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2170743, "chapter_id": 4646, "verse_number": "४०", "content_sanskrit": "सत्यानृते विनिश्चित्य ततो भवति धर्मवित्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2170744, "chapter_id": 4646, "verse_number": "४१", "content_sanskrit": "किमाश्चर्यं कृतप्रज्ञः पुरुषोऽपि सुदारुणः ।\nसुमहत्प्राप्नुयात् पुण्यं बलाकोऽन्धवधादिव\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2170745, "chapter_id": 4646, "verse_number": "४२", "content_sanskrit": "प्रभवार्थाय भूतानां धर्मप्रवचनं स्मृतम् ।\nयत् स्यादहिंसासंयुक्तं स धर्म इति निश्चयः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2170746, "chapter_id": 4646, "verse_number": "४३", "content_sanskrit": "अहिंसार्थाय भूतानां धर्मप्रवचनं नृप ।\nयश्चात्राधारसंयुक्तः स धर्म इति निश्चितः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2170747, "chapter_id": 4646, "verse_number": "४४", "content_sanskrit": "किमाश्चर्यं पुनर्मूढो धर्मकामोऽप्यपण्डितः ।\nसुमहत्प्राप्नुयात् पापमापगास्विव कौशिकः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2170748, "chapter_id": 4646, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2170749, "chapter_id": 4646, "verse_number": "४५", "content_sanskrit": "आचक्ष्व भगवन्नेतद् यथा विद्यामहं तथा ।\nबलाकान्धाभिसम्बद्धं नदीनां कौशिकस्य च\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2170750, "chapter_id": 4646, "verse_number": "", "content_sanskrit": "कृष्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2170751, "chapter_id": 4646, "verse_number": "४६", "content_sanskrit": "मृगव्याधोऽभवत् कश्चिद् बलाको नाम भारत ।\nयात्रार्थं पुत्रदारस्य मृगान् हन्ति न कामतः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2170752, "chapter_id": 4646, "verse_number": "४७", "content_sanskrit": "वृद्धौ च मातापितरौ बिभर्त्यन्यांश्च संश्रितान् ।\nस्वधर्मनिरतो नित्यं सत्यवागनसूयकः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2170753, "chapter_id": 4646, "verse_number": "४८", "content_sanskrit": "स कदाचिन्मृगं लिप्सुर्नान्वविन्दत् प्रयत्नवान् ।\nअपः पिबन्तं ददृशे श्वापदं घ्राणचक्षुषम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2170754, "chapter_id": 4646, "verse_number": "४९", "content_sanskrit": "अदृष्टपूर्वमपि तत्सत्त्वं तेन हतं तदा ।\nअन्धे हते ततो व्योम्नः पुष्पवर्षमवापतत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2170755, "chapter_id": 4646, "verse_number": "५०", "content_sanskrit": "अप्सरोगीतवादित्रैर्नादितं च मनोरमम् ।\nविमानमागमत् स्वर्गान्मृगव्याधनिनीषया\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2170756, "chapter_id": 4646, "verse_number": "५१", "content_sanskrit": "तद्भूतं सर्वभूतानामभावाय किलार्जुन ।\nतपस्तप्त्वा वरं प्राप्तं कृतमन्धं स्वयम्भुवा\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2170757, "chapter_id": 4646, "verse_number": "५२", "content_sanskrit": "तद्धत्वा सर्वभूतानामभावकृतनिश्चयम् ।\nततो बलाकः स्वरगादेवं धर्मः सुदुर्विदः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2170758, "chapter_id": 4646, "verse_number": "५३", "content_sanskrit": "कौशिकोऽप्यभवद् विप्रस्तपस्वी न बहुश्रुतः ।\nनदीनां सङ्गमे ग्रामाददूरे स किलावसत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2170759, "chapter_id": 4646, "verse_number": "५४", "content_sanskrit": "सत्यं मया सदा वाच्यमिति तस्याभवद् व्रतम् ।\nसत्यवादीति विख्यातः स तदासीद्धनञ्जय\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2170760, "chapter_id": 4646, "verse_number": "५५", "content_sanskrit": "अथ दस्युभयात् केचित् तदा तद्वनमाविशन् ।\nतत्रापि दस्यवः क्रूरा व्यमार्गन्त प्रयत्नतः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2170761, "chapter_id": 4646, "verse_number": "५६", "content_sanskrit": "अथ कौशिकमभ्येत्य प्राहुस्तं सत्यवादिनम् ।\nकतरेन पथा याता भगवन् बहवो जनाः ।\nसत्येन पृष्टः प्रब्रूहि यदि तान्वेत्थ शंस नः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2170762, "chapter_id": 4646, "verse_number": "५७", "content_sanskrit": "स पृष्टः कौशिकः सत्यं वचनं तानुवाच ह ।\nबहुवृक्षलतागुल्ममेतद् वनमुपाश्रिताः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2170763, "chapter_id": 4646, "verse_number": "समाप्तिः", "content_sanskrit": "इति तान् ख्यापयामास स तेभ्यः पार्थ कौशिकः ।\nततस्ते तान् समासाद्य क्रूरा जघ्नुरिति श्रुतिः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2170764, "chapter_id": 4646, "verse_number": "५९", "content_sanskrit": "तेनाधर्मेण महता सुदुरुक्तेन कौशिकः ।\nगतः स कष्टं नरकं सूक्ष्मधर्मेष्वकोविदः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2170765, "chapter_id": 4646, "verse_number": "६०", "content_sanskrit": "अप्रभूतश्रुतो मूढो धर्माणामविभागवित्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2170766, "chapter_id": 4646, "verse_number": "६१", "content_sanskrit": "वृद्धानपृष्ट्वा सन्देहम् अन्धः श्वभ्रमिवर्च्छति ।\nतत्र तल्लक्षणादेशः कश्चिदेव भविष्यति\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2170767, "chapter_id": 4646, "verse_number": "६२", "content_sanskrit": "दुष्करं परमज्ञानं तर्केणात्र व्यवस्यति ।\nश्रुतिर्धर्म इति ह्येके वदन्ति बहवो जनाः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2170768, "chapter_id": 4646, "verse_number": "", "content_sanskrit": "(यत्स्यादहिंसासंयुक्तं स धर्म इति निश्चयः ।\nअहिंसार्थाय भूतानां धर्मप्रवचनं कृतम्\t॥६३॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2170769, "chapter_id": 4646, "verse_number": "६४", "content_sanskrit": "धारणाद्धर्ममित्याहुः धर्मो धारयति प्रजाः ।\nयः स्याद्धारणसंयुक्तः स धर्म इति निश्चयः ।\nतत्वेन तत् प्रसूयामि न हि सर्वं विधीयते \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2170770, "chapter_id": 4646, "verse_number": "", "content_sanskrit": "(येऽन्यायेन जिहीर्षन्तो धनमिच्छन्ति कस्यचित् ।\nअकूजनेन चेन्मोक्षो नात्र कूजेत् कथञ्चन\t॥६५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2170771, "chapter_id": 4646, "verse_number": "६६", "content_sanskrit": "अवश्यं कूजितव्यं वा शङ्केरन् वाप्यकूजतः ।\nश्रेयस्तत्रानृतं वक्तुं सत्यादिति विनिश्चितम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2170772, "chapter_id": 4646, "verse_number": "६७", "content_sanskrit": "यः कार्येभ्यो व्रतं कृत्वा कर्मणा नोपपादयेत् ।\nन तत्फलमवाप्नोति एवमाहुर्मनीषिणः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2170773, "chapter_id": 4646, "verse_number": "६८", "content_sanskrit": "प्राणात्यये विवाहे वा सर्वज्ञातिधनक्षये ।\nनर्मण्यभिप्रवृत्ते वा प्रवक्तव्यं मृषा भवेत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2170774, "chapter_id": 4646, "verse_number": "६९", "content_sanskrit": "अधर्मं नात्र पश्यन्ति धर्मतत्त्वार्थदर्शिनः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2170775, "chapter_id": 4646, "verse_number": "७०", "content_sanskrit": "यः(यत्) स्तेनैः सह सम्बन्धान्मुच्यते शपथैरपि ।\nश्रेयस्तत्रानृतं वक्तुं तत्सत्यमविचारितम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2170776, "chapter_id": 4646, "verse_number": "७१", "content_sanskrit": "न च तेभ्यो धनं देयं शक्ये सति कथञ्चन ।\nपापेभ्यो हि धनं दत्तं दातारमपि पीडयेत्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2170777, "chapter_id": 4646, "verse_number": "७२", "content_sanskrit": "तस्माद्धर्मार्थमनृतमुक्त्वा नानृतवाग्भवेत्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2170778, "chapter_id": 4646, "verse_number": "७३", "content_sanskrit": "एष ते लक्षणोद्देशः समुद्दिष्टो यथाविधि\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2170779, "chapter_id": 4646, "verse_number": "७४", "content_sanskrit": "यथाधर्मं यथाबुद्धि मया पार्थ हितार्थिना ।\nएतच्छ्रुत्वा ब्रूहि पार्थ यदि वध्यो युधिष्ठिरः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2170780, "chapter_id": 4646, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2170781, "chapter_id": 4646, "verse_number": "७५", "content_sanskrit": "यथा ब्रूयान्महाप्राज्ञो यथा ब्रूयान्महामतिः ।\nहितं चैव यथास्माकं तथैतद्वचनं तव\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2170782, "chapter_id": 4646, "verse_number": "७६", "content_sanskrit": "भवान्मातृसमोऽस्माकं तथा पितृसमोऽपि च ।\nगतिश्च परमा कृष्ण त्वमेव च परायणम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2170783, "chapter_id": 4646, "verse_number": "७७", "content_sanskrit": "न हि ते त्रिषु लोकेषु विद्यतेऽविदितं क्वचित् ।\nतस्माद्भवान् परं धर्मं वेद सर्वं यथातथम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2170784, "chapter_id": 4646, "verse_number": "७८", "content_sanskrit": "अवध्यं पाण्डवं मन्ये धर्मराजं युधिष्ठिरम् ।\nतस्मिन् समयसंयोगे ब्रूहि किञ्चिदनुग्रहम्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2170785, "chapter_id": 4646, "verse_number": "७९", "content_sanskrit": "इदं चापरमत्रैव शृणु कृत्स्नं विवक्षितम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2170786, "chapter_id": 4646, "verse_number": "८०", "content_sanskrit": "जानासि दाशार्ह मम व्रतं त्वं\nयो मां ब्रूयात्कश्चन मानुषेषु ।\nअन्यस्मै त्वं गाण्डिवं देहि पार्थ\nयस्त्वत्तोऽस्त्रैर्वीर्यतो वा विशिष्टः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2170787, "chapter_id": 4646, "verse_number": "८१", "content_sanskrit": "हन्यामहं केशव तं प्रसह्य\nभीमो हन्यात् तूबरकेति चोक्तः ।\nतन्मे राजा प्रोक्तवांस्ते समक्षं\nधनुर्देहीत्यसकृद् वृष्णिसिंह\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2170788, "chapter_id": 4646, "verse_number": "८२", "content_sanskrit": "तं चेद्धन्यां केशव जीवलोके\nस्थाता कालं नाहमप्यल्पमात्रम् ।\nध्यात्वा नूनं ह्येनसा चापि युक्तो\nवधं राज्ञो भ्रष्टवीर्यो विचेताः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2170789, "chapter_id": 4646, "verse_number": "८३", "content_sanskrit": "सा च प्रतिज्ञा मम लोकप्रबुद्धा\nभवेत्सत्या धर्मभृतां वरिष्ठ ।\nयथा जीवेत् पाण्डवोऽहं च कृष्ण\nतथा बुद्धिं दातुमद्यार्हसि त्वम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2170790, "chapter_id": 4646, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2170791, "chapter_id": 4646, "verse_number": "८४", "content_sanskrit": "राजा श्रान्तो जगतो विक्षतश्च\nकर्णेन सङ्खे निशितैर्बाणसङ्घैः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2170792, "chapter_id": 4646, "verse_number": "८५", "content_sanskrit": "यश्चानिशं सूतपुत्रेण वीर\nशरैर्भृशं ताडितो युध्यमानः ।\nअतस्त्वमेतेन सरोषमुक्तो\nदुःखान्विते नेदमयुक्तरूपम्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2170793, "chapter_id": 4646, "verse_number": "८६", "content_sanskrit": "अकोपितो ह्येष यदि स्म सङ्खे\nकर्णं न हन्यादिति चाब्रवीच्च ।\nजानाति तं पाण्डव एष चापि\nपापं लोके कर्णमसह्यमन्यैः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2170794, "chapter_id": 4646, "verse_number": "८७", "content_sanskrit": "ततस्त्वमुक्तो भृशरोषितेन\nराज्ञा समक्षं परुषाणि पार्थ\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2170795, "chapter_id": 4646, "verse_number": "८८", "content_sanskrit": "तस्मात् पार्थ त्वां परुषाण्यवोचत्\nकर्णोऽब्रवीद् यत् पुरा द्यूतकाले\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2170796, "chapter_id": 4646, "verse_number": "८९", "content_sanskrit": "तस्मिन् हते कुरवो निर्जिताः स्युः\nएवंबुद्धिः पार्थिवो धर्मपुत्रः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2170797, "chapter_id": 4646, "verse_number": "९०", "content_sanskrit": "ततो वधं नार्हति धर्मपुत्र-\nस्त्वया प्रतिज्ञार्जुन पालनीया ।\nजीवन्नयं येन मृतो भवेद्धि\nतन्मे निबोधेह तवानुरूपम्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2170798, "chapter_id": 4646, "verse_number": "९१", "content_sanskrit": "यदा मानं लभते माननार्हः\nतदा स वै जीवति जीवलोके\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2170799, "chapter_id": 4646, "verse_number": "९२", "content_sanskrit": "यदावमानं लभते महान्तं\nतदा जीवन्मृत इत्युच्यते सः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2170800, "chapter_id": 4646, "verse_number": "९३", "content_sanskrit": "सम्मानितः पार्थिवोऽयं सदैव\nत्वया सभीमेन तथा यमाभ्याम् ।\nवृद्धैश्च लोके पुरुषप्रवीरैः\nतस्यावमानं कलया त्वं प्रयुङ्क्ष्व\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2170801, "chapter_id": 4646, "verse_number": "९४", "content_sanskrit": "त्वमित्यत्रभवन्तं त्वं ब्रूहि पार्थ युधिष्टिरम् ।\nत्वमित्युक्तो हि निहतो गुरुर्भवति भारत\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2170802, "chapter_id": 4646, "verse_number": "९५", "content_sanskrit": "एवमाचर कौन्तेय धर्मराजे युधिष्ठिरे ।\nअधर्मयुक्तं त्वंयोगं कुरुष्वैनं कुरूद्वह\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2170803, "chapter_id": 4646, "verse_number": "९६", "content_sanskrit": "आथर्वाङ्गिरसी ह्येषा श्रुतीनामुत्तमा श्रुतिः ।\nअविचार्यैव कार्यैषा श्रेयःकामैर्नरैः सदा\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2170804, "chapter_id": 4646, "verse_number": "९७", "content_sanskrit": "अवधेन वधः प्रोक्तो यद्गुरुस्त्वमिति प्रभुः ।\nतद् ब्रूहि त्वं यन्मयोक्तं धर्मराजस्य धर्मवित्\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2170805, "chapter_id": 4646, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nधर्मराजार्जुनसंवादे कृष्णवाक्यं नाम षट्षष्टितमोऽध्यायः ॥६६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]