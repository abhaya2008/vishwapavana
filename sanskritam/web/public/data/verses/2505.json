[{"id": 2071336, "chapter_id": 2505, "verse_number": "१२-१०-०x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071337, "chapter_id": 2505, "verse_number": "१२-१०-१", "content_sanskrit": "श्रोत्रियस्येव ते राजन्मन्दकस्याविपश्चितः।\nअनुवाकहता बुद्धिर्नैषा तत्त्वार्थदर्शिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071338, "chapter_id": 2505, "verse_number": "१२-१०-२", "content_sanskrit": "आलस्ये कृतचित्तस्य राजधर्मानसूयतः।\nविनाशे धार्तराष्ट्राणां किं फलं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071339, "chapter_id": 2505, "verse_number": "१२-१०-३", "content_sanskrit": "क्षमाऽनुकम्पा कारुण्यमानृशंस्यं न विद्यते।\nक्षात्रमाचरतो मार्गमपि बन्धोस्त्वदन्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071340, "chapter_id": 2505, "verse_number": "१२-१०-४", "content_sanskrit": "यदीमां भवतो बुद्धिं विद्याम वयमीदृशीम्।\nशस्त्रं नैव ग्रहीष्यामो न वधिष्याम कंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071341, "chapter_id": 2505, "verse_number": "१२-१०-५", "content_sanskrit": "भैक्षमेवाचरिष्याम शरीरस्याविमोक्षणात्।\nन चेदं दारुणं युद्धमभविष्यन्महीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071342, "chapter_id": 2505, "verse_number": "१२-१०-६", "content_sanskrit": "प्राणस्यान्नमिदं सर्वमिति वै कवयो विदुः।\nस्थावरं जङ्गमं चैव सर्वं प्राणस्य भोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071343, "chapter_id": 2505, "verse_number": "१२-१०-७", "content_sanskrit": "आददानस्य चेद्राज्यं ये केचित्परिपन्थिनः।\nहन्तव्यास्त इति प्राज्ञाः क्षत्रधर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071344, "chapter_id": 2505, "verse_number": "१२-१०-८", "content_sanskrit": "ते सदोषा हताऽस्माभिरन्नस्य परिपन्थिनः।\nतान्हत्वा भुङ्क्ष्व धर्मेण युधिष्ठिर महीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071345, "chapter_id": 2505, "verse_number": "१२-१०-९", "content_sanskrit": "यथा हि पुरुषः खात्वा कूपमप्राप्य चोदकम्।\nपङ्कदिग्धो निवर्तेत् कर्मेदं नस्तथोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071346, "chapter_id": 2505, "verse_number": "१२-१०-१०", "content_sanskrit": "यथाऽऽरुह्य महावृक्षमपहृत्य ततो मधु।\nअप्राश्य निधनं गच्छेत्कर्मेदं नस्तथोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071347, "chapter_id": 2505, "verse_number": "१२-१०-११", "content_sanskrit": "यथा महान्तमध्वानमाशया पुरुषः पतन्।\nस निराशो निवर्तेत कर्मैतन्नस्तथोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071348, "chapter_id": 2505, "verse_number": "१२-१०-१२", "content_sanskrit": "यथा शत्रून्घातयित्वा पुरुषः कुरुनन्दन।\nआत्मानं घातयेत्पश्चात्कर्मेदं नस्तथोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071349, "chapter_id": 2505, "verse_number": "१२-१०-१३", "content_sanskrit": "यथान्नं क्षुधितो लब्ध्वा न भुञ्जीयाद्यदृच्छया।\nकामी च कामिनीं लब्ध्वा कर्मेदं नस्तथोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071350, "chapter_id": 2505, "verse_number": "१२-१०-१४", "content_sanskrit": "वयमेवात्र गर्ह्या हि यद्वयं मन्दचेतसम्।\nत्वां राजन्ननुगच्छामो ज्येष्ठोऽयमिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071351, "chapter_id": 2505, "verse_number": "१२-१०-१५", "content_sanskrit": "वयं हि बाहुबलिनः कृतविद्या मनस्विनः।\nक्लीबस्य वाक्ये तिष्ठामो यथैवाशक्तयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071352, "chapter_id": 2505, "verse_number": "१२-१०-१६", "content_sanskrit": "अगतीकगतीनस्मान्नष्टार्थनर्थसिद्धये।\nकथं वै नानुपश्येयुर्जनाः पश्यत यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071353, "chapter_id": 2505, "verse_number": "१२-१०-१७", "content_sanskrit": "आपत्काले हि संन्यासः कर्तव्य इति शिष्यते।\nजरयाऽभिपरीतेन शत्रुभिर्व्यंसितेन वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071354, "chapter_id": 2505, "verse_number": "१२-१०-१८", "content_sanskrit": "तस्मादिह कृतप्रज्ञास्त्यागं न परिचक्षते।\nधर्मव्यतिक्रमं चैव मन्यन्ते सूक्ष्मदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071355, "chapter_id": 2505, "verse_number": "१२-१०-१९", "content_sanskrit": "कथं तस्मात्समुत्पन्नास्तन्निष्ठास्तदुपाश्रयाः।\nतदेव निन्दां भाषेयुर्धाता तत्र न गर्ह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071356, "chapter_id": 2505, "verse_number": "१२-१०-२०", "content_sanskrit": "श्रिया विहीनैरधनैर्नास्तिकैः संप्रवर्तितम्।\nवेदवादस्य विज्ञानं सत्याभासमिवानृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071357, "chapter_id": 2505, "verse_number": "१२-१०-२१", "content_sanskrit": "शक्यं तु मौनमास्थाय बिभ्रताऽऽत्मानमात्मना।\nधर्मच्छझ समास्थाय च्यवितुं न तु जीवितुम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071358, "chapter_id": 2505, "verse_number": "१२-१०-२२", "content_sanskrit": "शक्यं पुनररण्येषु सुखमेकेन जीवितुम्।\nअबिभ्रता पुत्रपौत्रान्देवर्षीनतिथीन्पितॄन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071359, "chapter_id": 2505, "verse_number": "१२-१०-२३", "content_sanskrit": "नेमे मृगाः स्वर्गजितो न वराहा न पक्षिणः।\nअथान्येन प्रकारेण पुण्यमाहुर्न ते जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071360, "chapter_id": 2505, "verse_number": "१२-१०-२४", "content_sanskrit": "यदि संन्यासतः सिद्धिं राजा कश्चिदवाप्नुयात्।\nपर्वताश्च दुमाश्चैव क्षिप्तं सिद्धिमवाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071361, "chapter_id": 2505, "verse_number": "१२-१०-२५", "content_sanskrit": "एते हि नित्यसंन्यासा दृश्यन्ते निरुपद्रवाः।\nअपरिग्रहवन्तश्च सततं ब्रह्मचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2071362, "chapter_id": 2505, "verse_number": "१२-१०-२६", "content_sanskrit": "अथ चेदात्मभाग्येषु नान्येषां सिद्धिमश्र्नुते।\nतस्मात्कर्मैव कर्तव्यं नास्ति सिद्धिरकर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2071363, "chapter_id": 2505, "verse_number": "१२-१०-२७", "content_sanskrit": "औदकाः सृष्टयश्चैव जन्तवः सिद्धिमाप्नुयुः।\nतेषामात्मैव भर्तव्यो नान्यः कश्चन विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2071364, "chapter_id": 2505, "verse_number": "१२-१०-२८", "content_sanskrit": "अवेक्षस्व यथा स्वैः कर्मभिर्व्यापृतं जगत्।\nतस्मात्कर्मैव कर्तव्यं न्प्रस्ति सिद्धिरकर्मणः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2071365, "chapter_id": 2505, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि दशमोऽध्यायः॥ १०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]