[{"id": 7003477000, "chapter_id": 23477, "verse_number": "११७-१", "content_sanskrit": "अथ द्वात्रिंशदपराधाः ।\nश्रीवराह उवाच।\nशृणु भद्रे महाश्चर्यमाहारविधिनिश्चयम् ।\nआहारं चाप्यनाहारं तच्छृणुष्व वसुन्धरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003477001, "chapter_id": 23477, "verse_number": "११७-२", "content_sanskrit": "भुञ्जानो याति चाश्नाति मम योगाय माधवि।\nअशुभं कर्म कृत्वापि पुरुषो धर्ममाश्रितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003477002, "chapter_id": 23477, "verse_number": "११७-३", "content_sanskrit": "आहारं चैव धर्मज्ञ उपभुञ्जीत नित्यशः ।\nसर्वे चात्रैव कर्मण्या व्रीहयः शालयस्तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003477003, "chapter_id": 23477, "verse_number": "११७-४", "content_sanskrit": "अकर्मण्यानि वक्ष्यामि येन भोज्यंति मां प्रति ।\nतेन वै भुक्तमार्गेण अपराधो महौजसः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003477004, "chapter_id": 23477, "verse_number": "११७-५", "content_sanskrit": "प्रथमं चापराधान्नं न रोचेत मम प्रिये।\nभुक्त्वा तु परकीयान्नं तत्परस्तन्निवर्त्तनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003477005, "chapter_id": 23477, "verse_number": "११७-६", "content_sanskrit": "द्वितीयस्त्वपराधोऽयं धर्मविघ्नाय वै भवेत् ।\nगत्वा मैथुनसंयागं  यो  नु मां स्पृशते नरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003477006, "chapter_id": 23477, "verse_number": "११७-७", "content_sanskrit": "तृतीयमपराधं तु कल्पयामि वसुंधरे ।\nदृष्ट्वा रजस्वलां नारीमस्माकं यः प्रपद्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003477007, "chapter_id": 23477, "verse_number": "११७-८", "content_sanskrit": "चतुर्थमपराधं तु दृष्टं नैव क्षपाम्यहम् ।\nस्पृष्ट्वा तु मृतकं चैव असंस्कारकृतं तु वै ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003477008, "chapter_id": 23477, "verse_number": "११७-९", "content_sanskrit": "पंचमं चापराधं च न क्षमामि वसुंधरे ।\nदृष्ट्वा तु मृतकं यस्तु नाचम्य स्पृशते तु माम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003477009, "chapter_id": 23477, "verse_number": "११७-१०", "content_sanskrit": "षष्ठं तं  चापराधं वै न क्षमामि वसुंधरे ।\nममार्चनस्य काले तु पुरीषं यस्तु गच्छति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003477010, "chapter_id": 23477, "verse_number": "११७-११", "content_sanskrit": "सप्तमं चापराधं तु कल्पयामि वसुंधरे ।\nयस्तु नीलेन वस्त्रेण प्रावृतो मां प्रपद्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003477011, "chapter_id": 23477, "verse_number": "११७-१२", "content_sanskrit": "अष्टमं चापराधं च कल्पयामि वसुन्धरे ।\nममैवार्च्चनकाले तु यस्त्वसमं प्रभाषते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003477012, "chapter_id": 23477, "verse_number": "११७-१३", "content_sanskrit": "नवमं चापराधं तं न रोचामि वसुन्धरे ।\nअविधानं तु यः स्पृश्य मामेव प्रतिपद्यते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003477013, "chapter_id": 23477, "verse_number": "११७-१४", "content_sanskrit": "दशमश्चापराधोऽयं मम चाप्रियकारकः ।\nक्रुद्धस्तु यानि कर्माणि कुरुते कर्मकारकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003477014, "chapter_id": 23477, "verse_number": "११७-१५", "content_sanskrit": "एकादशापराधं तु कल्पयामि वसुंधरे ।\nअकर्मण्यानि पुण्यानि यस्तु मामुपकल्पयेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003477015, "chapter_id": 23477, "verse_number": "११७-१६", "content_sanskrit": "द्वादशं चापराधं तं कल्पयामि वसुंधरे ।\nयस्तु रक्तेन वस्त्रेण कौसुम्भेनोपगच्छति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003477016, "chapter_id": 23477, "verse_number": "११७-१७", "content_sanskrit": "त्रयोदशं चापराधं कल्पयामि वसुन्धरे ।\nअन्धकारे च मां देवि यः स्पृशेत कदाचन ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003477017, "chapter_id": 23477, "verse_number": "११७-१८", "content_sanskrit": "चतुर्द्दशापराधं तु कल्पयामि वसुन्धरे ।\nयस्तु कृष्णेन वस्त्रेण मम कर्माणि कारयेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003477018, "chapter_id": 23477, "verse_number": "११७-१९", "content_sanskrit": "अपराधं पंचदशं कल्पयामि वसुंधरे ।\nअधौतेन तु वस्त्रेण यस्तु मामुपकल्पयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003477019, "chapter_id": 23477, "verse_number": "११७-२०", "content_sanskrit": "षोडशं त्वपराधानां कल्पयामि वरानने ।\nस्वयमन्नं तु यो ह्ययादज्ञानादपि माधवि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003477020, "chapter_id": 23477, "verse_number": "११७-२१", "content_sanskrit": "अपराधं सप्तदशं कल्पयामि वसुन्धरे ।\nयस्तु मात्स्यानि मांसानि भक्षयित्वा प्रपद्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003477021, "chapter_id": 23477, "verse_number": "११७-२२", "content_sanskrit": "अष्टादशापराधं च कल्पयामि वसुंधरे ।\nजालपादं भक्षयित्वा यस्तु मामुपसर्पति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003477022, "chapter_id": 23477, "verse_number": "११७-२३", "content_sanskrit": "एकोनविंशापराधं कल्पयामि वसुंधरे ।\nयस्तु मे दीपकं स्पृष्ट्वा मामेव प्रतिपद्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003477023, "chapter_id": 23477, "verse_number": "११७-२४", "content_sanskrit": "विंशकं चापराधं तं कल्पयामि वरानने ।\nश्मशानं यस्तु वै गत्वा मामेव प्रतिपद्यते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003477024, "chapter_id": 23477, "verse_number": "११७-२५", "content_sanskrit": "एकविंशापराधं तं कल्पयामि वसुन्धरे ।\nपिण्याकं भक्षयित्वा तु यो मामेवाभिगच्छति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003477025, "chapter_id": 23477, "verse_number": "११७-२६", "content_sanskrit": "द्वाविंशं चापराधं तं कल्पयामि प्रिये सदा ।\nयस्तु वाराह मांसानि प्रापणेनोपपादयेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003477026, "chapter_id": 23477, "verse_number": "११७-२७", "content_sanskrit": "अपराधं त्रयोविंशं कल्पयामि वसुन्धरे ।\nसुरां पीत्वा तु यो मर्त्यः कदाचिदुपसर्पति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003477027, "chapter_id": 23477, "verse_number": "११७-२८", "content_sanskrit": "अपराधं चतुर्विंशं कल्पयामि वसुन्धरे ।\nयः कुसुम्भं च मे शाकं भक्षयित्वोपचक्रमे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003477028, "chapter_id": 23477, "verse_number": "११७-२९", "content_sanskrit": "अपराधं पंचविंशं कल्पयामि वसुन्धरे ।\nपरप्रावरणेनैव यस्तु मामुपसर्पति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003477029, "chapter_id": 23477, "verse_number": "११७-३०", "content_sanskrit": "अपराधेषु षड्विंशं कल्पयामि वसुन्धरे ।\nनवान्नं यस्तु भक्षेत न देवान्न पितॄन्यजेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003477030, "chapter_id": 23477, "verse_number": "११७-३१", "content_sanskrit": "सप्तविंशं चापराधं कल्पयामि गुणान्विते ।\nउपानहौ च प्रपदे तथा वापीं च गच्छति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003477031, "chapter_id": 23477, "verse_number": "११७-३२", "content_sanskrit": "अपराधं त्वष्टविंशं कल्पयामि गुणान्विते ।\nशरीरं मर्द्दयित्वा तु यो मामाप्नोति माधवि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003477032, "chapter_id": 23477, "verse_number": "११७-३३", "content_sanskrit": "एकोनविंशापराधो न स स्वर्गेषु गच्छति ।\nअजीर्णेन समाविष्टो यस्तु मामुपगच्छति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003477033, "chapter_id": 23477, "verse_number": "११७-३४", "content_sanskrit": "त्रिंशकं चापराधं तं कल्पयामि यशस्विनि ।\nगन्धपुष्पाण्यदत्त्वा तु यस्तु धूपं प्रयच्छते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003477034, "chapter_id": 23477, "verse_number": "११७-३५", "content_sanskrit": "एकत्रिंशं चापराधं  कल्पयामि मनस्विनि ।\nविना भेर्यादिशब्देन द्वारस्योद्धाटनं मम ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003477035, "chapter_id": 23477, "verse_number": "११७-३६", "content_sanskrit": "महापराधं जनीयाद्द्वात्रिंशं तं मम प्रिये ।\nअन्यच्च शृणु वक्ष्यामि दृढव्रतमनुत्तमम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003477036, "chapter_id": 23477, "verse_number": "११७-३७", "content_sanskrit": "कृत्वा चावश्यकं कर्म मम लोकं च गच्छति ।\nनित्ययुक्तश्च शास्त्रज्ञो मम कर्मपरायणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003477037, "chapter_id": 23477, "verse_number": "११७-३८", "content_sanskrit": "अहिंसापरमश्चैव सर्वभूतदयापरः ।\nसामान्यश्च शुचिर्दक्षो मम नित्यं पथि स्थितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003477038, "chapter_id": 23477, "verse_number": "११७-३९", "content_sanskrit": "निगृह्य चेन्द्रियग्राममपराधविवर्जितः ।\nउदारो धार्मिकश्चैव स्वदारेषु सुनिष्ठितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003477039, "chapter_id": 23477, "verse_number": "११७-४०", "content_sanskrit": "शास्त्रज्ञः कुशलश्चैव मम कर्मपरायणः ।\nचातुर्वर्ण्यस्य मे भद्रे सन्मार्गेषु व्यवस्थितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003477040, "chapter_id": 23477, "verse_number": "११७-४१", "content_sanskrit": "आचार्यभक्ता देवेषु भक्ता भर्तरि वत्सला ।\nसंसारेष्वपि वर्त्तन्ती गच्छन्ती त्वग्रतो यदि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003477041, "chapter_id": 23477, "verse_number": "११७-४२", "content_sanskrit": "मम लोकस्थिता सा वै भर्त्तारं प्रसमीक्षते ।\nपुरुषो यदि मद्भक्तः स्त्रियं त्यक्त्वा च गच्छति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003477042, "chapter_id": 23477, "verse_number": "११७-४३", "content_sanskrit": "स ततोऽत्र प्रतीक्षेत भार्यां भर्त्तरि वत्सलाम् ।\nअन्यच्च ते प्रवक्ष्यामि कर्मणां  कर्म चोत्तमम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003477043, "chapter_id": 23477, "verse_number": "११७-४४", "content_sanskrit": "ऋषयो मां न पश्यन्ति मम कर्मपथे स्थिताः ।\nद्रष्टव्या मम लोकेषु ऋषयोऽपि वरानने ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003477044, "chapter_id": 23477, "verse_number": "११७-४५", "content_sanskrit": "किं पुनर्मानुषा ये च मम कर्मव्यवस्थिताः ।\nअन्यदेवेषु ये भक्ता मूढा वै पापचेतसः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003477045, "chapter_id": 23477, "verse_number": "११७-४६", "content_sanskrit": "मम मायाविमूढास्तु न प्रपद्यन्ति माधवि ।\nमां तु ये वै प्रपद्यन्ते मोक्षकामा वसुन्धरे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003477046, "chapter_id": 23477, "verse_number": "११७-४७", "content_sanskrit": "तानहं भावसंसिद्धान्बुद्ध्वा संविभजामि वै ।\nयेन त्वं परया शक्त्या धारितासि मया धरे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003477047, "chapter_id": 23477, "verse_number": "११७-४८", "content_sanskrit": "तेनेदं कथितं देवि आख्यानं धर्मसंयुतम् ।\nपिशुनाय न दातव्यं न च मूर्खाय माधवि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003477048, "chapter_id": 23477, "verse_number": "११७-४९", "content_sanskrit": "ततो न चोपदिष्टाय न शठाय प्रदापयेत ।\nनादीक्षिताय दातव्यं नोपसर्प्याय यत्नतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003477049, "chapter_id": 23477, "verse_number": "११७-५०", "content_sanskrit": "शठाय च न दातव्यं नास्तिकाय न माधवि ।\nवर्जयित्वा भागवतं मम कर्मपरायणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003477050, "chapter_id": 23477, "verse_number": "११७-५१", "content_sanskrit": "एतत्ते कथितं देवि मम धर्मं महौजसम् ।\nसर्वलोकहितार्थाय किमन्यत्परिपृच्छसि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]