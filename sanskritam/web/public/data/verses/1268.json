[{"id": 2013040, "chapter_id": 1268, "verse_number": "२-९-१", "content_sanskrit": "नारद उवाच॥\nयुधिष्ठिर सभा दिव्या वरुणस्यामितप्रभा।\nप्रमाणेन यथा याम्या शुभप्राकारतोरणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013041, "chapter_id": 1268, "verse_number": "२-९-२", "content_sanskrit": "अन्तः सलिलमास्थाय विहिता विश्वकर्मणा।\nदिव्यै रत्नमयैर्वृक्षैः फलपुष्पप्रदैर्युता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013042, "chapter_id": 1268, "verse_number": "२-९-३", "content_sanskrit": "नीलपीतैः सिताः श्यामैः सितैर्लोहितकैरपि।\nअवतानैस्तथा गुल्मैर्मञ्जरीजालधारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013043, "chapter_id": 1268, "verse_number": "२-९-४", "content_sanskrit": "तथा शकुनयस्तस्यां विचित्रा मधुरस्वराः।\nअनिर्देश्या वपुष्मन्तः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013044, "chapter_id": 1268, "verse_number": "२-९-५", "content_sanskrit": "सा सभा सुखसंस्पर्शा न शीता न च धर्मदा।\nवेश्मासनवती रम्या सिता वरुणपालिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013045, "chapter_id": 1268, "verse_number": "२-९-६", "content_sanskrit": "यस्यामास्ते स वरुणो वारुण्या च समन्वितः।\nदिव्यरत्नाम्बरधरो दिव्याभरणभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013046, "chapter_id": 1268, "verse_number": "२-९-७", "content_sanskrit": "द्वितीयेन तु नाम्ना वै गौरीति भुवि विश्रुता।\nपत्न्या सवरुणो देवः प्रमोदति सुखी सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013047, "chapter_id": 1268, "verse_number": "२-९-८", "content_sanskrit": "स्रग्विणो दिव्यगन्धाश्च दिव्यगन्धानुलेपनाः।\nआदित्यास्तत्र वरुणं जलेश्वरमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013048, "chapter_id": 1268, "verse_number": "२-९-९", "content_sanskrit": "वासुकिस्तक्षकश्चैव नागश्चैरावतस्तथा।\nकृष्णश्च लोहितश्चैव पद्मश्चित्रश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013049, "chapter_id": 1268, "verse_number": "२-९-१०", "content_sanskrit": "कम्बलाश्वतरौ नागौ धृतराष्ट्रबलाहकौ।\nमणिमान्कुण्डधारश्च कर्कोटकधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013050, "chapter_id": 1268, "verse_number": "२-९-११", "content_sanskrit": "पाणिमान्कुण्डधारश्च बलवान्पृथिवीपते।\nप्रह्रादो मुषिकादश्च तथैव जनमेजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013051, "chapter_id": 1268, "verse_number": "२-९-१२", "content_sanskrit": "पताकिनो मण्डलिनः फणवन्तश्च सर्वशः।\nअर्थो धर्मश्च कामश्च वसुः कपिल एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013052, "chapter_id": 1268, "verse_number": "२-९-१३", "content_sanskrit": "अनन्तश्च महानागो यं दृष्ट्वा जलजेश्वरः।\nअभ्यर्चयति सत्कारैरासनेन च तं विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013053, "chapter_id": 1268, "verse_number": "२-९-१४", "content_sanskrit": "वासुकिप्रमुखाश्चैव सर्वे प्राञ्जलयः स्थिताः।\nअनुज्ञाताश्च शेषेण यथार्हमुपविश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013054, "chapter_id": 1268, "verse_number": "२-९-१५", "content_sanskrit": "एते चान्ये च बहवः सर्पास्तस्यां युधिष्ठिर।\nवैनतेयश्च गरुडो ये चास्य परिचारिणः।\nउपासते महात्मानं वरुणं विगतक्लमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013055, "chapter_id": 1268, "verse_number": "२-९-१६", "content_sanskrit": "बलिर्वैरोचनो राजा नरकः पृथिवीञ्जयः।\nसंह्रादो विप्रचित्तिश्च कालखञ्जाश्च दानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013056, "chapter_id": 1268, "verse_number": "२-९-१७", "content_sanskrit": "सुहनुर्दुर्मुखः शङ्खः सुमनाः सुमतिस्ततः।\nघटोदरो महापार्श्वः क्रथनः पिठरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013057, "chapter_id": 1268, "verse_number": "२-९-१८", "content_sanskrit": "विश्वरूपः स्वरूपश्च विरूपोऽथ महाशिराः।\nदशग्रीवश्च वाली च मेघवासा दशावरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013058, "chapter_id": 1268, "verse_number": "२-९-१९", "content_sanskrit": "टिट्टिभो विटभूतश्च संह्रादश्चेन्द्रतापनः।\nदैत्यदानवसङ्घाश्च सर्वे रुचिरकुण्डलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013059, "chapter_id": 1268, "verse_number": "२-९-२०", "content_sanskrit": "स्रग्विणो मौलिनश्चैव तथा दिव्यपरिच्छदाः।\nसर्वे लब्धवराः शूराः सर्वे विगतमृत्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013060, "chapter_id": 1268, "verse_number": "२-९-२१", "content_sanskrit": "ते तस्यां वरुणं देवं धर्मपाशधरं सदा।\nउपासते महात्मानं सर्वे सुचरितव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013061, "chapter_id": 1268, "verse_number": "२-९-२२", "content_sanskrit": "तथा समुद्राश्चत्वारो नदी भागीरथी च सा।\nकालिन्दी विदिशा वेणा नर्दमा वेगवाहिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013062, "chapter_id": 1268, "verse_number": "२-९-२३", "content_sanskrit": "विपाशा च शतद्रुश्च चन्द्रभागा सरस्वती।\nइरावती वितस्ता च सिन्धुर्देवनदी तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013063, "chapter_id": 1268, "verse_number": "२-९-२४", "content_sanskrit": "गोदावरी कृष्णवेणी कावेरी च सरिद्वरा।\nकिम्पुना च विशल्या च तथा वैतरणी नदी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013064, "chapter_id": 1268, "verse_number": "२-९-२५", "content_sanskrit": "तृतीया ज्येष्ठिला चैव शोणश्चापि महानदः।\nचर्मण्वती तथा चैव पर्णाशा च महानदी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013065, "chapter_id": 1268, "verse_number": "२-९-२६", "content_sanskrit": "सरयूर्वारवत्याऽथ लाङ्गली च सरिद्वरा।\nकरतोया तथाऽऽत्रेयी लौहित्यश्च महानदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013066, "chapter_id": 1268, "verse_number": "२-९-२७", "content_sanskrit": "लङ्घती गोमती चैव सन्ध्या त्रिस्रोतसी तथा।\nएताश्चन्याश्च राजेन्द्र सुतीर्था लोकविश्रुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013067, "chapter_id": 1268, "verse_number": "२-९-२८", "content_sanskrit": "सरितः सर्वतश्चान्यास्तीर्थानि च सरांसि च।\nकूपाश्च सप्रस्रवणा देहवन्तो युधिष्ठिर।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013068, "chapter_id": 1268, "verse_number": "२-९-२९", "content_sanskrit": "पल्वलानि तटाकानि देहवन्त्यथ भारत।\nदिशस्तथा मही चैव तथा सर्वे महीधराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013069, "chapter_id": 1268, "verse_number": "२-९-३०", "content_sanskrit": "उपासते महात्मानं सर्वे जलचरास्तथा।\nगीतवादित्रवन्तश्च गन्धर्वाप्सरसां गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013070, "chapter_id": 1268, "verse_number": "२-९-३१", "content_sanskrit": "स्तुवन्तो वरुणं तस्यां सर्व एव समासते।\nमहीधरा रत्नवन्तो रसा ये च प्रतिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013071, "chapter_id": 1268, "verse_number": "२-९-३२", "content_sanskrit": "कथयन्तः सुमधुराः कथास्तत्र समासते।\nवारुणश्च तथा मन्त्री सुनाभः पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013072, "chapter_id": 1268, "verse_number": "२-९-३३", "content_sanskrit": "पुत्रपौत्रैः परिवृतो गोनाम्ना पुष्करेण च।\nसर्वे विग्रहवन्तस्ते तमीश्वरमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013073, "chapter_id": 1268, "verse_number": "२-९-३४", "content_sanskrit": "एषा मया सम्पतता वारुणी भरतर्षभ।\nदृष्टपूर्वा सभा रम्या कुबेरस्य सभां शृणु॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013074, "chapter_id": 1268, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि नवमोऽध्यायः॥ ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]