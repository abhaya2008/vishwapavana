[{"id": 900003779, "chapter_id": 8305, "verse_number": "1.1", "content_sanskrit": "ॐ नमो भगवते वासुदेवाय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003780, "chapter_id": 8305, "verse_number": "1.2", "content_sanskrit": "इति सम्प्रश्नसम्पुष्टो विप्राणां रौमहर्षणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003781, "chapter_id": 8305, "verse_number": "1.3", "content_sanskrit": "जगृहे पौरुषं रूपं भगवान् महदादिभिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003782, "chapter_id": 8305, "verse_number": "1.4", "content_sanskrit": "इति ब्रुवाणं संस्तूय मुनीनां दीर्घसत्रिणाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003783, "chapter_id": 8305, "verse_number": "1.5", "content_sanskrit": "अथ तं सुखमासीन उपासीनं बृहच्छ्रवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003784, "chapter_id": 8305, "verse_number": "1.6", "content_sanskrit": "एवं निशम्य भगवान् देवर्षेर्जन्म कर्म च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003785, "chapter_id": 8305, "verse_number": "1.7", "content_sanskrit": "निर्गते नारदे सूत भगवान्बादरायणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003786, "chapter_id": 8305, "verse_number": "1.8", "content_sanskrit": "पुत्रशोकातुराः सर्वे पाण्डवाः सह कृष्णया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003787, "chapter_id": 8305, "verse_number": "1.9", "content_sanskrit": "व्यासाद्यैरीश्वरेहाज्ञैः कृष्णेनाद्भुतकर्मणा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003788, "chapter_id": 8305, "verse_number": "1.10", "content_sanskrit": "हत्वा स्वरिक्तस्पृध आततायिनो युधिष्ठिरो धर्मभृतां गवि स्थितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003789, "chapter_id": 8305, "verse_number": "1.11", "content_sanskrit": "अश्वत्थाम्ना विसृष्टेन ब्रह्मशीर्ष्णोरुतेजसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003790, "chapter_id": 8305, "verse_number": "1.12", "content_sanskrit": "विदुरस्तीर्थयात्रायां मैत्रेयादात्मनो गतिम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003791, "chapter_id": 8305, "verse_number": "1.13", "content_sanskrit": "सम्प्रस्थिते द्वारकायां जिष्णौ बन्धुदिदृक्षया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003792, "chapter_id": 8305, "verse_number": "1.14", "content_sanskrit": "एवं कृष्णसखः कृष्णो भ्रात्रा राज्ञा विकल्पितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003793, "chapter_id": 8305, "verse_number": "1.15", "content_sanskrit": "वासुदेवाङ्घ्र्यभिध्यानपरिबृंहितरंहसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003794, "chapter_id": 8305, "verse_number": "1.16", "content_sanskrit": "ततः परीक्षद् द्विजवर्यशिक्षया महीं महाभागवतः शशास ह", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003795, "chapter_id": 8305, "verse_number": "1.17", "content_sanskrit": "तत्र गोमिथुनं राजा हन्यमानमनाथवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003796, "chapter_id": 8305, "verse_number": "1.18", "content_sanskrit": "यौ वै द्रौण्यस्त्रविल्पुष्टो न मातुरुदरे मृतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003797, "chapter_id": 8305, "verse_number": "1.19", "content_sanskrit": "महीपतिस्त्वथ तत्कर्म गर्ह्यं विचिन्तयन्नात्मकृतं सुदुर्मनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003798, "chapter_id": 8305, "verse_number": "1.20", "content_sanskrit": "तत्राभव(गम)द्भगवान्व्यासपुत्रो यदृच्छया गामटमानोऽनपेक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]