[{"id": 2057251, "chapter_id": 2241, "verse_number": "७-१६८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057252, "chapter_id": 2241, "verse_number": "७-१६८-१", "content_sanskrit": "सहदेवमथायान्तं द्रोणप्रेप्तुं विशाम्पते।\nकर्णो वैकर्तनो युद्धे वारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057253, "chapter_id": 2241, "verse_number": "७-१६८-२", "content_sanskrit": "सहदेवस्तु राधेयं विद्ध्वा नवभिराशुगैः।\nपुनर्विव्याध दशभिर्विशिखैर्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057254, "chapter_id": 2241, "verse_number": "७-१६८-३", "content_sanskrit": "तं कर्णः प्रतिविव्याध शतेन नतपर्वणाम्।\nसज्यं चास्य धनुः शीघ्रं चिच्छेद लघुहस्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057255, "chapter_id": 2241, "verse_number": "७-१६८-४", "content_sanskrit": "ततोऽन्यद्धनुरादाय माद्रीपुत्रः प्रतापवान।\nकर्णं विव्याध विंशत्या तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057256, "chapter_id": 2241, "verse_number": "७-१६८-५", "content_sanskrit": "तस्य कर्णो हयान्हत्वा शरैः सन्नतपर्वभिः।\nसारथिं चास्य भल्लेन द्रुतं निन्ये यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057257, "chapter_id": 2241, "verse_number": "७-१६८-६", "content_sanskrit": "विरथः सहदेवस्तु खङ्गं चर्म समाददे।\nतदप्यस्य शरैः कर्णो व्यधमत्प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057258, "chapter_id": 2241, "verse_number": "७-१६८-७", "content_sanskrit": "अथ गुर्वीं महाघोरां हेमचित्रां महागदाम्।\nप्रेषयामास सङ्क्रुद्धो वैकर्तनरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057259, "chapter_id": 2241, "verse_number": "७-१६८-८", "content_sanskrit": "तामापतन्तीं सहसा सहदेवप्रचोदिताम्।\nव्यष्टम्भयच्छरैः कर्णो भूमौ चैनामपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057260, "chapter_id": 2241, "verse_number": "७-१६८-९", "content_sanskrit": "गदां विनिहतां दृष्ट्वा सहदेवस्त्वरान्वितः।\nशक्तिं चिक्षेप कर्णाय तामप्यस्याच्छिनच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057261, "chapter_id": 2241, "verse_number": "७-१६८-१०", "content_sanskrit": "ससम्भ्रमं ततस्तूर्णमवप्लुत्य रथोत्तमात्।\nसहदेवो महाराज दृष्ट्वा कर्णं व्यवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057262, "chapter_id": 2241, "verse_number": "७-१६८-११", "content_sanskrit": "रथचक्रं प्रगृह्याजौ मुमोचाधिरथं प्रति।\nतदापतद्वै सहसा कालचक्रमिवोद्यतम्।\nशरैरनेकसाहस्रैराच्छिनत्सूतनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057263, "chapter_id": 2241, "verse_number": "७-१६८-१२", "content_sanskrit": "तस्मिंस्तु निहते चक्रे सूतजेन महात्मना।\nईषादण्डकयोक्रांश्च युगानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057264, "chapter_id": 2241, "verse_number": "७-१६८-१३", "content_sanskrit": "हस्त्यङ्गानि तथाश्वांश्च मृतांश्च पुरुषान्बहून्।\nचिक्षेप कर्णमुद्दिश्य कर्णस्तान्व्यधमच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057265, "chapter_id": 2241, "verse_number": "७-१६८-१४", "content_sanskrit": "स निरायुधमात्मानं ज्ञात्वा माद्रवतीसुतः।\nवार्यमाणस्तु विशिखैः सहदेवो रणं जहौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057266, "chapter_id": 2241, "verse_number": "७-१६८-१५", "content_sanskrit": "तमभिद्रुत्य राधेयो मुहूर्ताद्भरतर्षभ।\nअब्रवीत्प्रहसन्वाक्यं सहदेवं विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057267, "chapter_id": 2241, "verse_number": "७-१६८-१६", "content_sanskrit": "मा युध्यस्व रणेऽधीर विशिष्टै रथिभिः सह।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057268, "chapter_id": 2241, "verse_number": "७-१६८-१७", "content_sanskrit": "सदृशैर्युध्य माद्रेय वचो मे मा विशङ्किथाः॥\nअथैनं धनुषोग्रेण तुदन्भूयोऽब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057269, "chapter_id": 2241, "verse_number": "७-१६८-१८", "content_sanskrit": "एषोऽर्जुनो रणे तूर्णं युध्यते कुरुभिः सह।\nतत्र गच्छस्व माद्रेय गृहं वा यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057270, "chapter_id": 2241, "verse_number": "७-१६८-१९", "content_sanskrit": "एवमुक्त्वा तु तं कर्णो रथेन रथिनां वरः।\nप्रायात्पाञ्चालपाण्डूनां सैन्यानि प्रदहन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057271, "chapter_id": 2241, "verse_number": "७-१६८-२०", "content_sanskrit": "वधं प्राप्तं तु माद्रेयं नावधीत्समरेऽरिहा।\nकुन्त्याःस्मृत्वा वचो राजन्सत्यसन्धो महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057272, "chapter_id": 2241, "verse_number": "७-१६८-२१", "content_sanskrit": "सहदेवस्ततो राजन्विमनाः शरपीडितः।\nकर्णवाक्शरतप्तश्च जीवितान्निरविद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057273, "chapter_id": 2241, "verse_number": "७-१६८-२२", "content_sanskrit": "आरुरोह रथं चापि पाञ्चाल्यस्य महात्मनः।\nजनमेजयस्य समरे त्वरायुक्तो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057274, "chapter_id": 2241, "verse_number": "७-१६८-२३", "content_sanskrit": "विराटं सहसेनं तु द्रोणार्थे द्रुतमागतम्।\nमद्रराजः शरौघेण च्छादयामास धन्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057275, "chapter_id": 2241, "verse_number": "७-१६८-२४", "content_sanskrit": "तयोः समभवद्युद्धं समरे दृढधन्विनोः।\nयादृशं ह्यभवद्राजञ्जम्भवासवयोः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057276, "chapter_id": 2241, "verse_number": "७-१६८-२५", "content_sanskrit": "मद्रराजो महाराज विराटं वाहिनीपतिम्।\nआजघ्ने त्वरितस्तूर्णं शतेन नतपर्वणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057277, "chapter_id": 2241, "verse_number": "७-१६८-२६", "content_sanskrit": "प्रतिविव्याध तं राजन्नवभिर्निशितै शरैः।\nपुनश्चैनं त्रिसप्तत्या भूयश्चैव शतेन तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057278, "chapter_id": 2241, "verse_number": "७-१६८-२७", "content_sanskrit": "तस्य मद्राधिपो हत्वा चतुरो रथवाजिनः।\nसूतं ध्वजं च समरे शराभ्यां सन्न्यपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057279, "chapter_id": 2241, "verse_number": "७-१६८-२८", "content_sanskrit": "हताश्वात्तुं रथात्तूर्णमवप्लुत्य महारथः।\nतस्थौ विष्फारयंश्चापं विमुञ्चंश्च शिताञ्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057280, "chapter_id": 2241, "verse_number": "७-१६८-२९", "content_sanskrit": "शतानीकस्ततो दृष्ट्वा भ्रातरं हतवाहनम्।\nरथेनाभ्यपतत्तूर्णं सर्वलोकस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057281, "chapter_id": 2241, "verse_number": "७-१६८-३०", "content_sanskrit": "शतानीकमथायान्तं मद्राराजो महामृधे।\nविशिखैर्बहुभिर्विद्ध्वा ततो निन्ये यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057282, "chapter_id": 2241, "verse_number": "७-१६८-३१", "content_sanskrit": "तस्मिंस्तु निहते वीरे विराटो रथसत्तमः।\nआरुरोह रथं तूर्णं तमेव ध्वजमालिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057283, "chapter_id": 2241, "verse_number": "७-१६८-३२", "content_sanskrit": "ततो विष्फार्य नयने क्रोधाद्द्विगुणविक्रमः।\nमद्रराजरथं तूर्णं छादयामास पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057284, "chapter_id": 2241, "verse_number": "७-१६८-३३", "content_sanskrit": "ततो मद्राधिपः क्रुद्धः शरेणानतपर्वणा।\nआजघानोरसि दृढं विराटं वाहिनीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057285, "chapter_id": 2241, "verse_number": "७-१६८-३४", "content_sanskrit": "सोऽतिविद्धो महाराज रथोपस्थ उपाविशत्।\nकश्मलं चाविशत्तीव्रं विराटो भरतर्षभ।\nसारथिस्तमपोवाह समरे शरविक्षतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057286, "chapter_id": 2241, "verse_number": "७-१६८-३५", "content_sanskrit": "ततः सा महती सेना प्राद्रवन्निशि भारत।\nवध्यमाना शरशतैः शल्येनाहवशोभिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057287, "chapter_id": 2241, "verse_number": "७-१६८-३६", "content_sanskrit": "तां दृष्ट्वा विद्रुतां सेनां वासुदेवधनञ्जयौ।\nप्रयातौ तत्र राजेन्द्र यत्र शल्यो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057288, "chapter_id": 2241, "verse_number": "७-१६८-३७", "content_sanskrit": "तौ तु प्रत्युद्ययौ राजन्राक्षसेन्द्रो ह्यलायुधः।\nअष्टचक्रसमायुक्तमास्थाय प्रवरं रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057289, "chapter_id": 2241, "verse_number": "७-१६८-३८", "content_sanskrit": "तुरङ्गममुखैर्युक्तं पिशाचैर्घोरदर्शनैः।\nलोहितार्द्रपताकं तं रक्तमाल्यविभूषितम्।\nकार्ष्णायसमयं घोरमृक्षचर्मसमावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057290, "chapter_id": 2241, "verse_number": "७-१६८-३९", "content_sanskrit": "रौद्रेण चित्रपक्षेण विवृताक्षेण कूजता।\nध्वजेनोच्छ्रितदण्डेन गृध्रराजेन राजता।\nस बभौ राक्षसो राजन्भिन्नाञ्जनचयोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057291, "chapter_id": 2241, "verse_number": "७-१६८-४०", "content_sanskrit": "रुरोधार्जुनमायान्तं प्रभञ्जनमिवाद्रिराट्।\nकिरन्बाणगणान्राजञ्शतशोऽर्जुनमूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057292, "chapter_id": 2241, "verse_number": "७-१६८-४१", "content_sanskrit": "अतितीव्रं महाद्युद्धं नरराक्षसयोस्तदा।\nद्रष्टॄणां प्रीतिजननं सर्वेषां तत्र भारत।\nगृध्रकाकबलोलूककङ्कगोमायुहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057293, "chapter_id": 2241, "verse_number": "७-१६८-४२", "content_sanskrit": "तमर्जुनः शतेनैव पत्रिणां समताडयत्।\nनवभिश्च शितैर्बाणैर्ध्वजं चिच्छेद भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2057294, "chapter_id": 2241, "verse_number": "७-१६८-४३", "content_sanskrit": "सारथिं च त्रिभिर्बाणैस्त्रिभिरेव त्रिवेणुकम्।\nधनुरेकेन चिच्छेद चतुर्भिश्चतुरो हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2057295, "chapter_id": 2241, "verse_number": "७-१६८-४४", "content_sanskrit": "पुनः सज्यं कृतं चापं तदप्यस्य द्विधाऽच्छिनत्।\nविरथस्योद्यतं खङ्गं शरेणास्य द्विधाऽकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2057296, "chapter_id": 2241, "verse_number": "७-१६८-४५", "content_sanskrit": "अथैनं निशितैर्बाणैश्चतुर्भिर्भरतर्षभ।\nपार्थोऽविध्यद्राक्षसेन्द्रं स विद्वः प्राद्रवद्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2057297, "chapter_id": 2241, "verse_number": "७-१६८-४६", "content_sanskrit": "तं विजित्यार्जुनस्तूर्णं द्रोणान्तिकमुपाययौ।\nकिऱञ्शरगणान्राजन्नरवारणवाजिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2057298, "chapter_id": 2241, "verse_number": "७-१६८-४७", "content_sanskrit": "वध्यमाना महाराज पाण्डवेन यशस्विना।\nसैनिका न्यपतन्नुर्व्यां वातनुन्ना इव द्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2057299, "chapter_id": 2241, "verse_number": "७-१६८-४८", "content_sanskrit": "तेषु तूत्साद्यमानेषु फल्गुनेन महात्मना।\nसम्प्राद्रवद्बलं सर्वं पुत्राणां ते विशाम्पते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2057300, "chapter_id": 2241, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे अष्टषष्ट्यधिकशततमोऽध्यायः॥ १६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]