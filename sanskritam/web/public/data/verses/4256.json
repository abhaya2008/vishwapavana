[{"id": 2150167, "chapter_id": 4256, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150168, "chapter_id": 4256, "verse_number": "१", "content_sanskrit": "ततो हलहलाशब्दो दिवि राजन् महानभूत् ।\nप्रस्वापनं भीष्म स्राक्षीरिति कौरवनन्दन\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150169, "chapter_id": 4256, "verse_number": "२", "content_sanskrit": "अयोजयमहं तत्र तदस्त्रं भृगुनन्दने ।\nप्रस्वापं मां प्रयुञ्जानं नारदो वाक्यमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150170, "chapter_id": 4256, "verse_number": "३", "content_sanskrit": "एते वियति कौरव्य दिवि देवगणाः स्थिताः ।\nते त्वां निवारन्त्यद्य प्रस्वापं मा प्रयूयुजः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150171, "chapter_id": 4256, "verse_number": "४", "content_sanskrit": "रामस्तपस्वी ब्रह्मण्यो ब्राह्मणश्च गुरुश्च ते ।\nतस्यावमानं कौरव्य मा स्म कार्षीः कथञ्चन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150172, "chapter_id": 4256, "verse_number": "५", "content_sanskrit": "ततोऽपश्यं दिविष्ठान् वै तानष्टौ ब्रह्मवादिनः ।\nते मां स्मयन्तो राजेन्द्र शनकैरिदमब्रुवन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150173, "chapter_id": 4256, "verse_number": "६", "content_sanskrit": "यदाह भरतश्रेष्ठ नारदस्तत् तथा कुरु ।\nएतद्धि परमं श्रेयो लोकानां भरतर्षभ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150174, "chapter_id": 4256, "verse_number": "७", "content_sanskrit": "ततोऽहं प्रतिसंहृत्य तदस्त्रं स्वापनं मृधे ।\nब्रह्मास्त्रं दीपयाञ्चक्रे तस्मिन् युधि यथाविधि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150175, "chapter_id": 4256, "verse_number": "८", "content_sanskrit": "ततो रामो रुषितो राजसिंह\nदृष्ट्वा तदस्त्रं विनिवर्तितं वै ।\nजितोऽस्मि भीष्मेण सुमन्दबुद्धिः\nइत्येव वाक्यं सहसा व्यमुञ्चत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150176, "chapter_id": 4256, "verse_number": "९", "content_sanskrit": "ततोऽपश्यत् पितरं जामदग्न्यः\nपितुस्तथा पितरं चास्य चान्यान् ।\nते तत्र चैनं परिवार्य तस्थुः\nऊचुश्चैनं सान्त्वपूर्वं तदानीम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150177, "chapter_id": 4256, "verse_number": "१०", "content_sanskrit": "मा स्मैवं साहसं तात पुनः कार्षीः कथञ्चन ।\nभीष्मेण संयुगं गन्तुं क्षत्रियेण विशेषतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150178, "chapter_id": 4256, "verse_number": "११", "content_sanskrit": "क्षत्रियस्य तु धर्मोऽयं यद् युद्धं भृगुनन्दन ।\nस्वाध्यायो व्रतचर्या च ब्राह्मणानां परं धनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150179, "chapter_id": 4256, "verse_number": "१२", "content_sanskrit": "इदं निमित्तं कस्मिंश्चिद् अस्माभिरुपमन्त्रितम् ।\nशस्त्रधारणमत्युग्रं तच्च कार्यं कृतं त्वया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150180, "chapter_id": 4256, "verse_number": "१३", "content_sanskrit": "वत्स पर्याप्तमेतावद् भीष्मेण सह संयुगे ।\nविमर्दस्ते महाबाहो व्यपयाहि रणादितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150181, "chapter_id": 4256, "verse_number": "१४", "content_sanskrit": "पर्याप्तमेतद् भद्रं ते तव कार्मुकधारणम् ।\nविसर्जयैतद् दुर्धर्ष तपस्तप्यस्व भार्गव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150182, "chapter_id": 4256, "verse_number": "१५", "content_sanskrit": "एवं भीष्मः शान्तनवो देवैः सर्वैर्निवारितः ।\nनिवर्तस्व रणादस्माद् इति चैव प्रचोदितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150183, "chapter_id": 4256, "verse_number": "१६", "content_sanskrit": "रामेण सह मा योत्सीर्गुरुणेति पुनः पुनः ।\nन हि रामो रणे जेतुं त्वया न्याय्यः कुरूद्वह\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150184, "chapter_id": 4256, "verse_number": "१७", "content_sanskrit": "मानं कुरुष्व राजेन्द्र ब्राह्मणस्य रणाजिरे ।\nवयं तु गुरवस्तुभ्यं तस्मात् त्वां वारयामहे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150185, "chapter_id": 4256, "verse_number": "१८", "content_sanskrit": "भीष्मो वसूनामन्यतमो दिष्ट्या जीवसि पुत्रक ।\nगाङ्गेयः शन्तनोः पुत्रो वसुरेष महायशाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150186, "chapter_id": 4256, "verse_number": "१९", "content_sanskrit": "कथं त्वद्य त्वया जेतुं रामः शक्यो निवर्त वै ।\nअर्जुनः पाण्डवश्रेष्ठः पुरन्दरसुतो बली\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150187, "chapter_id": 4256, "verse_number": "२०", "content_sanskrit": "नरः प्रजापतिर्वीरः पूर्वदेवः सनातनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150188, "chapter_id": 4256, "verse_number": "२१", "content_sanskrit": "सव्यसाचीति विख्यातः त्रिषु लोकेषु सत्यवान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150189, "chapter_id": 4256, "verse_number": "२२", "content_sanskrit": "भीष्ममृत्युर्यथाकालं विहितो वै स्वयम्भुवा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150190, "chapter_id": 4256, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150191, "chapter_id": 4256, "verse_number": "२३", "content_sanskrit": "एवमुक्तः स पितृभिः पितॄन् रामोऽब्रवीदिदम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150192, "chapter_id": 4256, "verse_number": "२४", "content_sanskrit": "नाहं युधि निवर्तेयमिति मे व्रतमाहितम् ।\nन निवर्तितपूर्वश्च कदाचिद् रणमूर्धनि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150193, "chapter_id": 4256, "verse_number": "२५", "content_sanskrit": "निवर्त्यतामापगेयः कामं युद्धात् पितामहाः ।\nन त्वहं विनिवर्तिष्ये युद्धादस्मात् कथञ्चन\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150194, "chapter_id": 4256, "verse_number": "२६", "content_sanskrit": "ततस्ते मुनयो राजन्नृचीकप्रमुखास्तदा ।\nनारदेनैव सहिताः समागम्येदमब्रुवन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150195, "chapter_id": 4256, "verse_number": "२७", "content_sanskrit": "निवर्तस्व रणात् तात मानयस्व द्विजोत्तमम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150196, "chapter_id": 4256, "verse_number": "२८", "content_sanskrit": "नेत्यवोचमहं तांश्च क्षत्रधर्मव्यपेक्षया\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150197, "chapter_id": 4256, "verse_number": "२९", "content_sanskrit": "मम व्रतमिदं लोके नाहं युद्धात् कदाचन ।\nविमुखो विनिवर्तेयं पृष्ठतोऽभ्याहतः शरैः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150198, "chapter_id": 4256, "verse_number": "३०", "content_sanskrit": "नाहं लोभान्न कार्पण्यान्न भयान्नार्थकारणात् ।\nत्यजेयं शाश्वतं धर्ममिति मे निश्चिता मतिः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150199, "chapter_id": 4256, "verse_number": "३१", "content_sanskrit": "ततस्ते मुनयः सर्वे नारदप्रमुखा नृप ।\nभागीरथी च मे माता रणमध्यं प्रपेदिरे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150200, "chapter_id": 4256, "verse_number": "३२", "content_sanskrit": "तथैवात्तशरो धन्वी तथैव दृढविक्रमः ।\nस्थितोऽहमाहवे योद्धुं ततस्ते राममब्रुवन्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150201, "chapter_id": 4256, "verse_number": "३३", "content_sanskrit": "समेत्य सहिता भूयः समरे भृगुनन्दनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150202, "chapter_id": 4256, "verse_number": "३४", "content_sanskrit": "नवनीतं हि हृदयं विप्राणां शाम्य भार्गव ।\nराम राम निवर्तस्व युद्धादस्माद् द्विजोत्तम\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150203, "chapter_id": 4256, "verse_number": "३५", "content_sanskrit": "अवध्यो हि त्वया भीष्मस्त्वं च भीष्मस्य भार्गव\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150204, "chapter_id": 4256, "verse_number": "३६", "content_sanskrit": "एवं ब्रुवन्तस्ते सर्वे प्रतिरुद्ध्य रणाजिरम् ।\nवारयाञ्चक्रिरे शस्त्रं पितरो भृगुनन्दनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150205, "chapter_id": 4256, "verse_number": "३७", "content_sanskrit": "ततोऽहं पुनरेवाथ तानष्टौ ब्रह्मवादिनः ।\nअद्राक्षं दीप्यमानान् वै ग्रहानष्टाविवोदितान्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150206, "chapter_id": 4256, "verse_number": "३८", "content_sanskrit": "ते मां सप्रणयं वाक्यमब्रुवन् समरे स्थितम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2150207, "chapter_id": 4256, "verse_number": "३९", "content_sanskrit": "प्रैहि रामं महाबाहो गुरुं लोकहितं कुरु\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2150208, "chapter_id": 4256, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2150209, "chapter_id": 4256, "verse_number": "४०", "content_sanskrit": "दृष्ट्वा निवर्तितं रामं सुहृद्वाक्येन तेन वै ।\nलोकानां च हितं कुर्वन्नहमप्याददे वचः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2150210, "chapter_id": 4256, "verse_number": "४१", "content_sanskrit": "ततोऽहं राममासाद्य ववन्दे भृशविक्षतः ।\nरामश्चाप्युत्स्मयन् प्रेम्णा मामुवाच महातपाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2150211, "chapter_id": 4256, "verse_number": "४२", "content_sanskrit": "त्वत्समो नास्ति लोकेऽस्मिन् क्षत्रियः पृथिवीचरः ।\nगम्यतां भीष्म युद्धेऽस्मिंस्तोषितोऽहं भृशं त्वया\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2150212, "chapter_id": 4256, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2150213, "chapter_id": 4256, "verse_number": "४३", "content_sanskrit": "मम चैव समक्षं तां कन्यामाहूय भार्गवः ।\nउक्तवान् दीनया वाचा मध्ये तेषां तपस्विनाम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2150214, "chapter_id": 4256, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्ताशीत्युत्तरशततमोऽध्यायः ॥१८७॥\nअम्बोपाख्यानपर्वणि सप्तदशोऽध्यायः ॥१७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]