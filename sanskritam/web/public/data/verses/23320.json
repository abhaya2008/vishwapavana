[{"id": 7003320000, "chapter_id": 23320, "verse_number": "२-१५-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nभूयोऽपि शिवमाहात्म्यं समाचक्ष्व महामते ।\nसर्वज्ञो ह्यसि भूताना मधिनाथ महागुण ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003320001, "chapter_id": 23320, "verse_number": "२-१५-२", "content_sanskrit": "शैलादिरुवाच  ।\nशिवमाहात्म्यमेकाग्रः श्रृणु वक्ष्यामि ते मुने ।\nबहुभिर्बहुधा शब्दैः कीर्तितं मुनिसत्तमैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003320002, "chapter_id": 23320, "verse_number": "२-१५-३", "content_sanskrit": "सदसद्रूपमित्याहुः सदसत्पतिरित्यपि ।\nतं शिवं मुनयः केचित्प्रवदंति च सूरयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003320003, "chapter_id": 23320, "verse_number": "२-१५-४", "content_sanskrit": "भूतभावविकारेण द्वितीयेन स उच्यते ।\nव्यक्तं तेन विहीनत्वादव्यक्तमसदित्यपि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003320004, "chapter_id": 23320, "verse_number": "२-१५-५", "content_sanskrit": "उभे ते शिवरूपे हि शिवादन्यं न विद्यते ।\nतयोः पतित्वाच्च शिवः सदसत्पतिरुच्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003320005, "chapter_id": 23320, "verse_number": "२-१५-६", "content_sanskrit": "क्षराक्षरात्मकं प्राहुः क्षराक्षरपरं तथा ।\nशिवं महेश्वरं केचिन्मुनयस्तत्त्वचिंतकाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003320006, "chapter_id": 23320, "verse_number": "२-१५-७", "content_sanskrit": "उक्तमक्षरमव्यक्तं व्यक्तं क्षरमुदाहृतम् ।\nरूपे ते शंकरस्यैव तस्मान्न पर उच्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003320007, "chapter_id": 23320, "verse_number": "२-१५-८", "content_sanskrit": "तयोः परः शिवः शांतः क्षराक्षरपरो बुधैः ।\nउच्यते परमार्थेन महादेवो महेश्वरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003320008, "chapter_id": 23320, "verse_number": "२-१५-९", "content_sanskrit": "समस्तव्यक्तरूपं तु ततः स्मृत्वा स मुच्यते ।\nसमष्टिव्यष्टिरूपं तु समष्टिव्यष्टिकारणम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003320009, "chapter_id": 23320, "verse_number": "२-१५-१०", "content_sanskrit": "वदंति केचिदाचार्याः शिवं परमकारणम् ।\nसमष्टिं विदुरव्यक्तं व्यक्तं मुनीश्वराः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003320010, "chapter_id": 23320, "verse_number": "२-१५-११", "content_sanskrit": "रूपे ते गदिते शंभोर्नास्त्यन्यद्वस्तुसंभवम् ।\nतयोः कारमभावेन शिवो हि परमेश्वरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003320011, "chapter_id": 23320, "verse_number": "२-१५-१२", "content_sanskrit": "उच्यते योगशास्त्रज्ञैः समष्टिव्यष्टिकारणम् ।\nक्षेत्रक्षेत्रज्ञरूपी च शिवः कैश्चिदुदाहृतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003320012, "chapter_id": 23320, "verse_number": "२-१५-१३", "content_sanskrit": "परमात्मा परं ज्योतिर्भगवान्परमेश्वरः ।\nचतुर्विशतितत्त्वानि समष्टिव्यष्टिकारणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003320013, "chapter_id": 23320, "verse_number": "२-१५-१४", "content_sanskrit": "प्राहुः क्षेत्रज्ञशब्देन भोक्तारं पुरुषं तथा ।\nक्षेत्रक्षेत्रविदावेते रूपे तस्य स्वयंभुवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003320014, "chapter_id": 23320, "verse_number": "२-१५-१५", "content_sanskrit": "न किंचिच्च शिवादन्यदिति प्राहुर्मनीषिणः ।\nअपरब्रह्मरूपं तं परब्रह्मात्मकं शिवम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003320015, "chapter_id": 23320, "verse_number": "२-१५-१६", "content_sanskrit": "केचिदाहुर्महादेवमनादि निधनं प्रभुम् ।\nभूतेंद्रियांतः करणप्रधानविषयात्मकम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003320016, "chapter_id": 23320, "verse_number": "२-१५-१७", "content_sanskrit": "अपरं ब्रह्म निर्दिष्टं परं ब्रह्म चिदात्मकम् ।\nब्रह्मणी ते महेशस्य शिवस्यास्य स्वयंभुवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003320017, "chapter_id": 23320, "verse_number": "२-१५-१८", "content_sanskrit": "शंकरस्य परस्यैव शिवादन्यन्न विद्यते ।\nविद्याविद्यास्वरूपी च शंकरः कैश्चिदुच्यते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003320018, "chapter_id": 23320, "verse_number": "२-१५-१९", "content_sanskrit": "धाता विधाता लोकानामादिदेवो महेश्वरः ।\nविद्येति च तमेवाहुरविद्येति मुनीश्वराः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003320019, "chapter_id": 23320, "verse_number": "२-१५-२०", "content_sanskrit": "प्रपंचजातमखिलं ते स्वरूपे स्वयंभुवः ।\nभ्रांतिर्विद्या परं चेति शिवरूपमनुत्तमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003320020, "chapter_id": 23320, "verse_number": "२-१५-२१", "content_sanskrit": "अवापुर्मुनयो योगात्केचिदागमवेदिनः ।\nअर्थेषु बहुरूपेषु विज्ञानं भ्रांतिरुच्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003320021, "chapter_id": 23320, "verse_number": "२-१५-२२", "content_sanskrit": "आत्माकारेण संवित्तिर्बुधैर्विद्येति कीर्त्यते ।\nविकल्परहितं तत्त्वं परमित्यभिधीयते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003320022, "chapter_id": 23320, "verse_number": "२-१५-२३", "content_sanskrit": "तृतीयरूपमीशस्य नान्यत्किंचन सर्वतः ।\nव्यक्ताव्यक्तज्ञरूपीति शिवः कैश्चिन्निगद्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003320023, "chapter_id": 23320, "verse_number": "२-१५-२४", "content_sanskrit": "विधाता सर्व लोकानां धाता च परमेश्वरः ।\nत्रयोविंशतितत्त्वानि व्यक्तशब्देन सूरयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003320024, "chapter_id": 23320, "verse_number": "२-१५-२५", "content_sanskrit": "वदंत्यव्यक्तशब्देन प्रकृतिः च परां तथा ।\nकथयंति ज्ञशब्देन पुरुषं गुमभोगिनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003320025, "chapter_id": 23320, "verse_number": "२-१५-२६", "content_sanskrit": "तत्त्रयं शांकरं रूपं नान्यत्किंचिदशांकरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]