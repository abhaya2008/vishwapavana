[{"id": 2048151, "chapter_id": 2062, "verse_number": "६-१११-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048152, "chapter_id": 2062, "verse_number": "६-१११-१", "content_sanskrit": "सात्यकिं दंशितं युद्धे भीष्मायाभ्युद्यतं रणे।\nआर्श्यशृङ्गिर्महेष्वासो वारयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048153, "chapter_id": 2062, "verse_number": "६-१११-२", "content_sanskrit": "माधवस्तु सुसंक्रुद्धो राक्षसं नवभिः शरैः ।\nआजघान रणे राजन्प्रहसन्निव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048154, "chapter_id": 2062, "verse_number": "६-१११-३", "content_sanskrit": "तथैव राक्षसो राजन्माधवं नवभिः शरैः ।\nअर्दयामास राजेन्द्र संक्रुद्धः शिनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048155, "chapter_id": 2062, "verse_number": "६-१११-४", "content_sanskrit": "शैनेयः शरसङ्घं तु प्रेषयामास संयुगे ।\nराक्षसाय सुसंक्रुद्धो माधवः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048156, "chapter_id": 2062, "verse_number": "६-१११-५", "content_sanskrit": "ततो रक्षो महाबाहुं सात्यकिं सत्यविक्रमम् ।\nविव्याध विशिखैस्तीक्ष्णैः सिंहनाद ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048157, "chapter_id": 2062, "verse_number": "६-१११-६", "content_sanskrit": "माधवस्तु भृशं विद्धो राक्षसेन रणे तदा।\nधैर्यमालम्ब्य तेजस्वी जहास च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048158, "chapter_id": 2062, "verse_number": "६-१११-७", "content_sanskrit": "भगदत्तस्ततः क्रुद्धो माधवं निशितैः शरैः ।\nताडयामास समरे तोत्रैरिव महागजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048159, "chapter_id": 2062, "verse_number": "६-१११-८", "content_sanskrit": "विहाय राक्षसं युद्धे शैनेयो रथिनां वरः ।\nप्राग्ज्योतिषाय चिक्षेप शरान्संनतपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048160, "chapter_id": 2062, "verse_number": "६-१११-९", "content_sanskrit": "तस्य प्राग्ज्योतिषो राजा माधवस्य महद्धनुः ।\nचिच्छेद शतधारेण भल्लेन कृतहस्तवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048161, "chapter_id": 2062, "verse_number": "६-१११-१०", "content_sanskrit": "अथान्यद्धनुरादाय वेगवत्परवीरहा ।\nभगदत्तं रणे क्रुद्धं विव्याध निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048162, "chapter_id": 2062, "verse_number": "६-१११-११", "content_sanskrit": "सोऽतिविद्धो महेष्वासः सृक्किणी परिसंलिहन् ।\nशक्तिं कनकवैडूर्यभूषितामायसीं दृढाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048163, "chapter_id": 2062, "verse_number": "६-१११-१२", "content_sanskrit": "यमदण्डोपमां घोरां चिक्षेप परमाहवे।\nतामापतन्तीं सहसा तस्य बाहुबलेरिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048164, "chapter_id": 2062, "verse_number": "६-१११-१३", "content_sanskrit": "सात्यकिः समरे राजन्द्विधा चिच्छेद सायकैः ।\nततः पपात सहसा सहोल्केव हतप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048165, "chapter_id": 2062, "verse_number": "६-१११-१४", "content_sanskrit": "शक्तिं विनिहतां दृष्ट्वा पुत्रस्तव विशांपते ।\nमहता रथवंशेन वारयामास माधवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048166, "chapter_id": 2062, "verse_number": "६-१११-१५", "content_sanskrit": "तथा परिवृतं दृष्ट्वा वार्ष्णेयानां महारथम्।\nदुर्योधनो भृशं क्रुद्धो भ्रातॄन्सर्वानुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048167, "chapter_id": 2062, "verse_number": "६-१११-१६", "content_sanskrit": "तथा कुरुत कौरव्या यथाः वः सात्यको युधि ।\nन जीवन्प्रतिनिर्याति महतोऽस्माद्रथव्रजात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048168, "chapter_id": 2062, "verse_number": "६-१११-१७", "content_sanskrit": "तस्मिन्हते हतं मन्ये पाण्डवानां महद्बलम् ।\nतथेति च वचस्तस्य परिगृह्य महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048169, "chapter_id": 2062, "verse_number": "६-१११-१८", "content_sanskrit": "शैनेयं योधयामासर्भीष्मायाभ्युद्यतं रणे।\n`अभिमन्युं तदाऽऽयान्तं भीष्मस्याभ्युद्यतं वधे।\nकाम्भोजराजो बलवान्वारयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048170, "chapter_id": 2062, "verse_number": "६-१११-१९", "content_sanskrit": "आर्जुनिं नृपतिर्विद्ध्वा शरैः सन्नतपर्वभिः।\nपुनरेव चतुःषष्ट्या राजन्विव्याध तं नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048171, "chapter_id": 2062, "verse_number": "६-१११-२०", "content_sanskrit": "सुदक्षिणस्तु समरे पुनर्विव्याध तं पञ्चभिः ।\nसारथिं चास्य नवभिरिच्छन्भीष्मस्य जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048172, "chapter_id": 2062, "verse_number": "६-१११-२१", "content_sanskrit": "तद्युद्धमासीत्सुमहत्तयोस्तत्र समागमे।\nयदाभ्यधावद्गाङ्गेयं शिखण्डी शत्रुकर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048173, "chapter_id": 2062, "verse_number": "६-१११-२२", "content_sanskrit": "विराटद्रुपदौ वृद्धौ वारयनतौ महाचमूम् ।\nभीष्मं च युधि संरब्धावाद्रवन्तौ महारथौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048174, "chapter_id": 2062, "verse_number": "६-१११-२३", "content_sanskrit": "अश्वत्थामा रणे क्रुद्धः समियाद्रथसत्तमः।\nततः प्रववृते युद्धं तयोस्तस्य च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048175, "chapter_id": 2062, "verse_number": "६-१११-२४", "content_sanskrit": "विराटो दशभिर्भल्लैराजघान परंतप ।\nयतमानं महेष्वासं द्रौणिमाहवशोभिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048176, "chapter_id": 2062, "verse_number": "६-१११-२५", "content_sanskrit": "द्रुपदश्च त्रिभिर्बाणैर्विव्याध निशितैस्तदा।\nगुरुपुत्रं समासाद्य प्रहरन्तौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048177, "chapter_id": 2062, "verse_number": "६-१११-२६", "content_sanskrit": "अश्वत्थामा ततस्तौ तु विव्याध बहुभिः शरैः।\nविराटद्रुपदौ वीरौ भीष्मं प्रति समुद्यतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048178, "chapter_id": 2062, "verse_number": "६-१११-२७", "content_sanskrit": "तत्राद्भुतमपश्याम वृद्धयोश्चरितं महत्।\nयद्द्रौणिसायकान्घोरान्प्रत्यवारयतां युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048179, "chapter_id": 2062, "verse_number": "६-१११-२८", "content_sanskrit": "सहदेवं तथाऽऽयान्तं कृपः शारद्वतोऽभ्ययात्।\nयथा नागो वने नागं मत्तो मत्तमुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048180, "chapter_id": 2062, "verse_number": "६-१११-२९", "content_sanskrit": "कृपश्च समरे शूरो माद्रीपुत्रं महारथम् ।\nआजघान शरैस्तूर्णं सप्तत्या रुक्मभूषणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048181, "chapter_id": 2062, "verse_number": "६-१११-३०", "content_sanskrit": "तस्य माद्रीसुतश्चापं द्विधा चिच्छेद सायकैः ।\nअथैनं छिन्नधन्वानं विव्याध नवभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048182, "chapter_id": 2062, "verse_number": "६-१११-३१", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय समरे भारसाधनम् ।\nमाद्रीपुत्रं सुसंहृष्टो दशभिर्निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048183, "chapter_id": 2062, "verse_number": "६-१११-३२", "content_sanskrit": "आजघानोरसि क्रुद्ध इच्छन्भीष्मस्य जीवितम् ।\nतथैव पाण्डवो राजञ्छारद्वतममर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048184, "chapter_id": 2062, "verse_number": "६-१११-३३", "content_sanskrit": "आजघानोरसि क्रुद्धो भीष्मस्य वधकाङ्क्षया ।\nतयोर्युद्धं समभवद्धोररूपं भयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048185, "chapter_id": 2062, "verse_number": "६-१११-३४", "content_sanskrit": "नकुलं तु रणे क्रुद्धो विकर्णः शत्रुतापनः ।\nविव्याध सायकैः षष्ट्या रक्षन्भीष्मं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048186, "chapter_id": 2062, "verse_number": "६-१११-३५", "content_sanskrit": "नकुलोऽपि भृशं विद्धस्तव पुत्रेण धीमता।\nविकर्णं सप्तसप्तत्या निर्बिभेद शिलीमुखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048187, "chapter_id": 2062, "verse_number": "६-१११-३६", "content_sanskrit": "तत्र तौ नरशार्दूलौ भीष्महेतोः परंतपौ ।\nअन्योन्यं जघ्नुतुर्वीरौ गोष्ठे गोवृषभाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048188, "chapter_id": 2062, "verse_number": "६-१११-३७", "content_sanskrit": "घटोत्कचं रणे यान्तं निघ्नन्तं तव वाहिनीम् ।\nदुर्मुखः समरे प्रायाद्भीष्यहेतोः पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048189, "chapter_id": 2062, "verse_number": "६-१११-३८", "content_sanskrit": "हैडिम्बस्तु रणे राजन्दुर्मुखं शत्रुतापनम् ।\nआजघानोरसि क्रुद्धः शरेणानतपर्वणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048190, "chapter_id": 2062, "verse_number": "६-१११-३९", "content_sanskrit": "भीमसेनसुतं चापि दुर्मुखः सुमुखैः शरैः।\nषष्ट्या वीरो नदन्हृष्टो विव्याध रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048191, "chapter_id": 2062, "verse_number": "६-१११-४०", "content_sanskrit": "धृष्टद्युम्नं तथाऽऽयान्तं भीष्मस्य वधकाङ्क्षिणम् ।\nहार्दिक्यो वारयामास रथश्रेष्ठं महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048192, "chapter_id": 2062, "verse_number": "६-१११-४१", "content_sanskrit": "हार्दिक्यः पार्षतं चापि विद्ध्वा पञ्चभिरायसैः ।\nपुनः पञ्चाशता तूर्णं तिष्ठतिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048193, "chapter_id": 2062, "verse_number": "६-१११-४२", "content_sanskrit": "आजघान महाबाहुः पार्षतं तं महारथम् ।\nतं चैव पार्षतो राजन्हार्दिक्यं नवभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048194, "chapter_id": 2062, "verse_number": "६-१११-४३", "content_sanskrit": "विव्याध निशितैस्तीक्ष्णैः कङ्कपत्रैरजिह्नगैः ।\nतयोः समभवद्युद्धं भीष्महेतोर्महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048195, "chapter_id": 2062, "verse_number": "६-१११-४४", "content_sanskrit": "अन्योन्यातिशये युक्तं यथा वृत्रमहेन्द्रयोः ।\nभीमसेनं तथाऽऽयान्तं भीष्मं प्रति महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048196, "chapter_id": 2062, "verse_number": "६-१११-४५", "content_sanskrit": "भूरिश्रवाभ्ययात्तूर्णं तिष्ठतिष्ठेति चाब्रवीत् ।\nसौमदत्तिरथो भीममाजघान स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048197, "chapter_id": 2062, "verse_number": "६-१११-४६", "content_sanskrit": "नाराचेन सुतीक्ष्णेन रुक्मपुङ्खेन संयुगे।\nउरःस्थेन बभौ तेन भीमसेनः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048198, "chapter_id": 2062, "verse_number": "६-१११-४७", "content_sanskrit": "स्कन्दशक्त्या यथा क्रौञ्चः पुरा नृपतिसत्तम।\nतौ शरान्सूर्यसंकाशान्कर्मारपरिमार्जितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2048199, "chapter_id": 2062, "verse_number": "६-१११-४८", "content_sanskrit": "अन्योन्यस्य रणे क्रुद्धौ चिक्षिपते नरर्षभौ ।\nभीमो भीष्मवधाकाङ्क्षी सौमदत्तिं महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2048200, "chapter_id": 2062, "verse_number": "६-१११-४९", "content_sanskrit": "तथा भीष्मजये गृध्नुः सौमदत्तिस्तू पाण्डवम् ।\nकृतप्रतिकृते यत्तौ योधयामासतू रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2048201, "chapter_id": 2062, "verse_number": "६-१११-५०", "content_sanskrit": "युधिष्ठिरं तु कौन्तेयं महत्या सेनया वृत्तम्।\nभीष्माभिमुखमायान्तं भारद्वाजो न्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2048202, "chapter_id": 2062, "verse_number": "६-१११-५१", "content_sanskrit": "द्रोणस्य रथनिर्घोषं पर्जन्यनिनदोपमम् ।\nश्रुत्वा प्रभद्रका राजन्समकम्पन्त मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2048203, "chapter_id": 2062, "verse_number": "६-१११-५२", "content_sanskrit": "सा सेना महती राजन्पाण्डुपुत्रस्य संयुगे।\nद्रोणेन वारिता यत्ता न चचाल पदात्पदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2048204, "chapter_id": 2062, "verse_number": "६-१११-५३", "content_sanskrit": "चेकितान रणे यत्तं भीष्मं प्रति जनेश्वर ।\nचित्रसेनस्तव सुतः क्रुद्धरूपमवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2048205, "chapter_id": 2062, "verse_number": "६-१११-५४", "content_sanskrit": "भीष्महेतोः पराक्रान्तश्चित्रसेनः पराक्रमी ।\nचेकितानं परं शक्त्या योधयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2048206, "chapter_id": 2062, "verse_number": "६-१११-५५", "content_sanskrit": "तथैव चेकितानोऽपि चित्रसेनमवारयत् ।\nतद्युद्धमासीत्सुमहत्तयोस्तत्र समागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2048207, "chapter_id": 2062, "verse_number": "६-१११-५६", "content_sanskrit": "अर्जुनो वार्यमाणस्तु बहुशस्तत्र भारत ।\nविमुखीकृत्य पुत्रं ते सेनां तव ममर्द ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2048208, "chapter_id": 2062, "verse_number": "६-१११-५७", "content_sanskrit": "दुःशासनोऽपि परया शक्त्या पार्थमवारयत्।\nकथं भीष्मं न नो हन्यादिति निश्चित्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2048209, "chapter_id": 2062, "verse_number": "६-१११-५८", "content_sanskrit": "सा वध्यमाना समरे पुत्रस्य तव वाहिनी ।\nलोड्यते रथिभिः श्रेष्ठैस्तत्रतत्रैव भारत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2048210, "chapter_id": 2062, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशदिवसयुद्धे एकादशाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-१११-५८ लोड्यते आकुलीक्रियते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]