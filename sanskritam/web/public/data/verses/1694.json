[{"id": 2031939, "chapter_id": 1694, "verse_number": "४-१७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031940, "chapter_id": 1694, "verse_number": "४-१७-१", "content_sanskrit": "एवमुक्ताऽनवद्याङ्गी कीचकेन दुरात्मना ।\nद्रौपदी तमुवाचेदं सैरन्ध्रीवेषधारिणी ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031941, "chapter_id": 1694, "verse_number": "४-१७-२", "content_sanskrit": "अप्रार्थनीयामिहं मां सूतपुत्राभिमन्यसे।\nनिहीनवर्णां सैरेन्ध्रीं बीभत्सां केशकारिणीम् ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031942, "chapter_id": 1694, "verse_number": "४-१७-३", "content_sanskrit": "परदाराऽस्मि भद्रं ते न युक्तं तव सांप्रतम्।\nदयिताः प्राणिनां दारा धर्मं समनुचिन्तय ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031943, "chapter_id": 1694, "verse_number": "४-१७-४", "content_sanskrit": "परदारे न ते बुद्धिर्जातु कार्या कथंचन ।\nविवर्जनं ह्यकार्याणामेतत्सुपुरुषव्रतम् ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031944, "chapter_id": 1694, "verse_number": "४-१७-५", "content_sanskrit": "मिथ्याभिगृध्नो हि नरः पापात्मा मोहमास्थितः ।\nअयशः प्राप्नुयाद्धोरं महद्वा प्राप्नुयाद्भयम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031945, "chapter_id": 1694, "verse_number": "४-१७-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031946, "chapter_id": 1694, "verse_number": "४-१७-६", "content_sanskrit": "एवमुक्तस्तु सैरन्ध्र्या कीचकः काममोहितः।\nजानन्नपि सुदुर्बुद्धिः परदाराभिमर्शने ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031947, "chapter_id": 1694, "verse_number": "४-१७-७", "content_sanskrit": "दोषान्बहून्प्राणहरान्सर्वलोकविगर्हितान् ।\nप्रोवाचेदं सुदुर्बुद्धिर्द्रौपदीमजितेन्द्रियः ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031948, "chapter_id": 1694, "verse_number": "४-१७-८", "content_sanskrit": "नार्हस्येवं वरारोहे प्रत्याख्यातुं वरानने ।\nमां मन्मथसमाविष्टं त्वत्कृते चारुहासिनि ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031949, "chapter_id": 1694, "verse_number": "४-१७-९", "content_sanskrit": "प्रत्याख्याय च मां भीरु वशगं प्रियवादिनम् ।\nनूनं त्वमसितापाङ्गि पश्चात्तापं करिष्यसि ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031950, "chapter_id": 1694, "verse_number": "४-१७-१०", "content_sanskrit": "अहं हि सुभ्रु राज्यस्य कृत्स्नस्यास्य सुमध्यमे ।\nप्रभुर्वासयिता चैव वीर्ये चाप्रतिमः क्षितौ ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031951, "chapter_id": 1694, "verse_number": "४-१७-११", "content_sanskrit": "पृथिव्यां मत्समो नास्ति कश्चिदन्यः पुमानिह ।\nरूपयौवनसौभाग्यैर्भोगैश्चानुत्तमैः शुभैः ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031952, "chapter_id": 1694, "verse_number": "४-१७-१२", "content_sanskrit": "सर्वकामसमृद्धेषु भोगेष्वनुपमेष्विह।\nभोक्तव्येषु च कल्याणि कस्माद्दास्ये रता ह्यसि ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031953, "chapter_id": 1694, "verse_number": "४-१७-१३", "content_sanskrit": "मया दत्तमिदं राज्यं स्वामिन्यसि शुभानने।\nभजस्व मां वरारोहे भुङ्क्ष्वं भोगाननुत्तमान् ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031954, "chapter_id": 1694, "verse_number": "४-१७-१४", "content_sanskrit": "एवमुक्ता तु सा साध्वी कीचकेनाशुभं वचः।\nकीचकं प्रत्युवाचेदं गर्हयन्त्यस्य तद्वचः ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031955, "chapter_id": 1694, "verse_number": "४-१७-१५x", "content_sanskrit": "सैरन्ध्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031956, "chapter_id": 1694, "verse_number": "४-१७-१५", "content_sanskrit": "मा सूतपुत्र मुह्यस्व माऽद्य त्यक्ष्यस्व जीवितम्।\nजानीहि पञ्चभिर्घोरैर्नित्यं मामभिरक्षिताम् ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031957, "chapter_id": 1694, "verse_number": "४-१७-१६", "content_sanskrit": "न चाप्यहं त्वया लभ्या गन्धर्वाः पतयो मम।\nते त्वां निहन्युः कुपिताः साध्वलं मा व्यनीनशः ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031958, "chapter_id": 1694, "verse_number": "४-१७-१७", "content_sanskrit": "अशक्यरूपं पुरुषैरध्वानं गन्तुमिच्छसि ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031959, "chapter_id": 1694, "verse_number": "४-१७-१८", "content_sanskrit": "यथा निश्चेतनो बालः कूलस्थः कूलमुत्तरम्।\nतर्तुमिच्छति मन्दात्मा तथा त्वं कर्तुमिच्छसि ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031960, "chapter_id": 1694, "verse_number": "४-१७-१९", "content_sanskrit": "अन्तर्महीं वा यदि वोर्ध्वमुत्पतेः समुद्रपारं यदि वा प्रधावसि।\nतथापि तेषां न विमोक्षमर्हसि प्रमाथिनो देवसुता हि खेचराः ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031961, "chapter_id": 1694, "verse_number": "४-१७-२०", "content_sanskrit": "त्वं कालरात्रीमिव कश्चिदातुरः किं मां दृढं पार्थयसेऽद्य कीचक।\nकिं मातुरङ्के शयितो यथा शिशुश्चन्द्रं जिघृक्षुरिव मन्यसे हि माम् ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031962, "chapter_id": 1694, "verse_number": "४-१७-२१", "content_sanskrit": "तेषां प्रियां प्रार्थयतो न ते भुवि गत्वा दिवं वा शरणं भविष्यति।\nन वर्तते कीचक ते दृशा शुभं या तेन संजीवनमर्थयेत सा ॥ २१ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031963, "chapter_id": 1694, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि कीचकवधपर्वणि सप्तदशोऽध्यायः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]