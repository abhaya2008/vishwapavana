[{"id": 7003293000, "chapter_id": 23293, "verse_number": "१-९६-१", "content_sanskrit": "ऋषय ऊचुः  ।\nकथं देवो महादेवो विश्वसंहारकारकः  ।\nशरभाख्यं महाघोरं विकृतं रूपमास्थितः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003293001, "chapter_id": 23293, "verse_number": "१-९६-२", "content_sanskrit": "किंकिं धैर्यं कृतं तेन ब्रूहि सर्वलमशेषतः  ।\nसूत उवाच  ।\nएवमभ्यर्थितो देवैर्मतिं चक्रे कृपालयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003293002, "chapter_id": 23293, "verse_number": "१-९६-३", "content_sanskrit": "यत्तेजस्तु नृसिंहाख्यं संहर्त्तु परमेश्वरः  ।\nतदर्थं स्मृतवान् रुद्रोवीरभद्रं महाबलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003293003, "chapter_id": 23293, "verse_number": "१-९६-४", "content_sanskrit": "आत्मनो भैरवं रूपं महाप्रलयकारकम्  ।\nआजगाम पुरा सद्यो गणानामग्रतो हसन् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003293004, "chapter_id": 23293, "verse_number": "१-९६-५", "content_sanskrit": "साट्टहासैर्गणवरैरुत्पतद्भिरितस्ततः  ।\nनृसिंहरूपैरत्युग्रैः कोटिभिः परिवारितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003293005, "chapter_id": 23293, "verse_number": "१-९६-६", "content_sanskrit": "तावद्बिरभितो वीरैर्नृत्यद्भिश्च मुदान्वितैः  ।\nक्रीडद्भिश्च महाधीरैर्ब्रह्माद्यैः कुंदुकैरिव ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003293006, "chapter_id": 23293, "verse_number": "१-९६-७", "content_sanskrit": "अदृष्टपूर्वैरन्यैश्च वेष्टितो वीरवंदितः  ।\nकल्पांतज्वलनज्वालो विलसल्लोचनत्रयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003293007, "chapter_id": 23293, "verse_number": "१-९६-८", "content_sanskrit": "आत्तशस्त्रो जटाजूटे ज्वलद्बालेन्दुमंडितः  ।\nबालेंदुद्वितयाकारतीक्ष्णदंष्ट्रांकुरद्वयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003293008, "chapter_id": 23293, "verse_number": "१-९६-९", "content_sanskrit": "आखंडलधनुःखंडसंनिभभ्रूलतायुतः  ।\nमहाप्रचंडहुंकारबधिरीकृतदिङ्मुखः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003293009, "chapter_id": 23293, "verse_number": "१-९६-१०", "content_sanskrit": "नीलमेघांजनाकारभीषणश्मश्रुरद्भुतः  ।\nवादखंडमखंडाभ्यां भ्रामयंस्त्रिशिखं मुहुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003293010, "chapter_id": 23293, "verse_number": "१-९६-११", "content_sanskrit": "वीरभद्रोपि भगवान् वीरशक्तिविजृंभितः  ।\nस्वयं विज्ञापयामास किमत्र स्मृतिकारणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003293011, "chapter_id": 23293, "verse_number": "१-९६-१२", "content_sanskrit": "आज्ञापय जगत्स्वामिन् प्रसादः क्रियतां मयि  ।\nश्रीभगवानुवाच  ।\nअकाले भयमुत्पन्नं देवानामपि भैरव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003293012, "chapter_id": 23293, "verse_number": "१-९६-१३", "content_sanskrit": "ज्वलितः स नृसिंहाग्निः शमयैनं दुरासदम्  ।\nसांत्वयन् बोधयादौ तं तेन किं नोपशाम्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003293013, "chapter_id": 23293, "verse_number": "१-९६-१४", "content_sanskrit": "ततो मत्परमं भावं भैरवं संप्रदर्शय  ।\nसूक्ष्मं सूक्ष्मेण संहृत्य स्थूलं स्थूलेन तेजसा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003293014, "chapter_id": 23293, "verse_number": "१-९६-१५", "content_sanskrit": "वक्त्रमानय कृत्तिं च वीरभद्र ममाज्ञया  ।\nइत्यादिष्टो गणाध्यक्षः प्रशांतवपुरास्थितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003293015, "chapter_id": 23293, "verse_number": "१-९६-१६", "content_sanskrit": "जगाम रंहसा तत्र यत्रास्ते नरकेसरी  ।\nततस्तं बोधयामास वीरभद्रो हरो हरिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003293016, "chapter_id": 23293, "verse_number": "१-९६-१७", "content_sanskrit": "उवाच वाक्यमीशानः पितापुत्रमिवौरसम्  ।\nश्रीवीरभद्र उवाच  ।\nजगत्सुखाय भगवन्नवतीर्णोसि माधव ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003293017, "chapter_id": 23293, "verse_number": "१-९६-१८", "content_sanskrit": "स्थित्यर्थेन च युक्तेसिपरेण परमेष्ठिना  ।\nजंतुचक्रं भगवता रक्षितं मत्स्यरूपिणा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003293018, "chapter_id": 23293, "verse_number": "१-९६-१९", "content_sanskrit": "पुच्छेनैव समाबध्य भ्रमन्नेकार्णवे पुरा  ।\nबिभर्षि कूर्मरूपेण वाराहेणोद्धृता मही ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003293019, "chapter_id": 23293, "verse_number": "१-९६-२०", "content_sanskrit": "अनेन हरिरूपेण हिरण्यकशिपुर्हतः  ।\nवामनेन बलिर्बद्धस्त्वया विक्रमता पुनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003293020, "chapter_id": 23293, "verse_number": "१-९६-२१", "content_sanskrit": "त्वमेव सर्वभूतानां प्रभावः प्रभुरव्ययः  ।\nयदायदा हि लोकस्य दुःखं किंचित्प्रजायते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003293021, "chapter_id": 23293, "verse_number": "१-९६-२२", "content_sanskrit": "तदातदावतीर्णस्त्वं करिष्यसि निरामयम्  ।\nनाधिकस्त्वत्समोप्यस्तिहरे शिवपरायण ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003293022, "chapter_id": 23293, "verse_number": "१-९६-२३", "content_sanskrit": "त्वया धर्माश्च वेदाश्च शुभे मार्गे प्रतिष्ठिताः  ।\nयदर्थमवतारोयं निहतः सोपि केशव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003293023, "chapter_id": 23293, "verse_number": "१-९६-२४", "content_sanskrit": "अत्यंतघोरं भगवन्नरसिंह वपुस्तव  ।\nउपसंहर विश्वात्मंस्त्वमेव मम सन्निधौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003293024, "chapter_id": 23293, "verse_number": "१-९६-२५", "content_sanskrit": "सूत उवाच  ।\nइत्युक्तो वीरभद्रेण नृसिंहः शांतया गिरा  ।\nततोधिकं महाघोरं कोपं प्रज्वालयद्धरिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003293025, "chapter_id": 23293, "verse_number": "१-९६-२६", "content_sanskrit": "श्रीनृसिंह उवाच  ।\nआगतोसि यतस्तत्र गच्छ त्वं मा हितं वद  ।\nइदानीं संहरिष्यामि जगदेतच्चराचरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003293026, "chapter_id": 23293, "verse_number": "१-९६-२७", "content_sanskrit": "संहर्त्तुर्न हि संहारः स्वतो वा परतोपि वा  ।\nशासितं मम सर्वत्र शास्ता कोपि न विद्यते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003293027, "chapter_id": 23293, "verse_number": "१-९६-२८", "content_sanskrit": "मत्प्रसादेन सकलं समर्यादं प्रवर्तते  ।\nअहं हि सर्वशक्तीनां प्रवर्तकनिवर्त्तकः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003293028, "chapter_id": 23293, "verse_number": "१-९६-२९", "content_sanskrit": "यद्यद्विभूतिमत्सत्त्वं श्रीमदूर्जितमेव वा   ।\nतत्तद्विद्धि गणाध्यक्ष मम तेजोविजृंभितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003293029, "chapter_id": 23293, "verse_number": "१-९६-३०", "content_sanskrit": "देवतापरमार्थज्ञा ममैव परमं विदुः  ।\nमदंशाः शक्तिसंपन्ना ब्रह्मशक्रादयः सुराः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003293030, "chapter_id": 23293, "verse_number": "१-९६-३१", "content_sanskrit": "मन्नाभिपंकजाज्जातः पुरा ब्रह्मा चतुर्मुखः  ।\nतल्ललाटसमुत्पन्नो भगवान्वृषभध्वजः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003293031, "chapter_id": 23293, "verse_number": "१-९६-३२", "content_sanskrit": "रजसाधिष्ठितः स्रष्टा रुद्रस्तामस उच्यते  ।\nअहं नियंता सर्वस्य मत्परं नास्ति दैवतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003293032, "chapter_id": 23293, "verse_number": "१-९६-३३", "content_sanskrit": "विश्वाधिकः स्वतंत्रश्च कर्ता हर्ताखिलेश्वरः  ।\nइदं तु मत्परं तेजः कः पुनः श्रोतुमिच्छति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003293033, "chapter_id": 23293, "verse_number": "१-९६-३४", "content_sanskrit": "अतो मां शरणं प्राप्य गच्छ त्वं विगतज्वरः  ।\nअवेहि परमं भावमिदं भूतमहेश्वरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003293034, "chapter_id": 23293, "verse_number": "१-९६-३५", "content_sanskrit": "कालेस्म्यहं कालविनाशहेतुर्लोकान् समाहर्त्तुमहं प्रवृत्तः  ।\nमृत्योर्मृत्युं विद्धि मां वीरभद्र जीवंत्येते मत्प्रसादेन देवाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003293035, "chapter_id": 23293, "verse_number": "१-९६-३६", "content_sanskrit": "सूत उवाच  ।\nसाहंकारमिदं श्रुत्वा हरेरमितविक्रमः  ।\nविहस्योवाच सावज्ञं ततो विस्फुरिताधरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003293036, "chapter_id": 23293, "verse_number": "१-९६-३७", "content_sanskrit": "श्रीवीरभद्र उवाच  ।\nकिं न जानासि विश्वेशं संहर्तारं पिनाकिनम् ।\nअसद्वादो विवादश्च विनाशस्त्वयि केवलः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003293037, "chapter_id": 23293, "verse_number": "१-९६-३८", "content_sanskrit": "तवान्योन्यावताराणि कानि शेषाणि सांप्रतम्  ।\nकृतानियेन केनापि कथाशेषो भविष्यति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003293038, "chapter_id": 23293, "verse_number": "१-९६-३९", "content_sanskrit": "दोषं त्वं पश्य एतत्त्वमवस्थामीदृशीं गतः  ।\nतेन संहारदक्षेण क्षणात्संक्षयमेष्यसि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003293039, "chapter_id": 23293, "verse_number": "१-९६-४०", "content_sanskrit": "प्रकृतिस्त्वं पुमान् रुद्रस्त्वयि वीर्यं समाहितम्  ।\nत्वन्नाभिपंकजाज्जातः पंचवक्त्रः पितामहः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003293040, "chapter_id": 23293, "verse_number": "१-९६-४१", "content_sanskrit": "सृष्ट्यर्थेन जगत्पूर्वं शंकरं नीललोहितम्  ।\nललाटे चिंतयामास तपस्युग्रे व्यवस्थितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003293041, "chapter_id": 23293, "verse_number": "१-९६-४२", "content_sanskrit": "तल्ललाटादभूच्छंभोः सृष्ट्यर्थं तन्न दूषणम्  ।\nअंशोहं देवदेवस्य महाभैरवरूपिणः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003293042, "chapter_id": 23293, "verse_number": "१-९६-४३", "content_sanskrit": "त्वत्संहारे नियुक्तोस्मि विनयेन बलेन च  ।\nएवं रक्षो विदार्यैव त्वं शक्तिकलया युतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003293043, "chapter_id": 23293, "verse_number": "१-९६-४४", "content_sanskrit": "अहंकारावलेपेन गर्जसि त्वमतंद्रितः  ।\nउपकारो ह्यसाधूनामपकाराय केवलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003293044, "chapter_id": 23293, "verse_number": "१-९६-४५", "content_sanskrit": "यदि सिंह महेशानं स्वपुनर्भूत मन्यसे  ।\nन त्वं स्रष्टा न संहर्ता न स्वतंत्रो हि कुत्रचित् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003293045, "chapter_id": 23293, "verse_number": "१-९६-४६", "content_sanskrit": "कुलालचक्रवच्छक्त्या प्रेरितोसि पिनाकिना  ।\nअद्यापि तव निक्षिप्तं कपालं कूर्मरूपिणः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003293046, "chapter_id": 23293, "verse_number": "१-९६-४७", "content_sanskrit": "हरहारलतामध्ये मुग्ध कस्मान्न बुध्यसे  ।\nविस्मृतं किं तदंशेन दंष्ट्रोत्पातनपीडितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003293047, "chapter_id": 23293, "verse_number": "१-९६-४८", "content_sanskrit": "वाराहविग्रहस्तेऽद्य साक्रोशं तारकारिणा  ।\nदग्धोसि यस्य शूलाग्रे विष्वक्सेनच्छलाद्भवान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003293048, "chapter_id": 23293, "verse_number": "१-९६-४९", "content_sanskrit": "दक्षयज्ञे शिरश्छिन्नं मया ते यज्ञरूपिणः  ।\nअद्यापि तव पुत्रस्य ब्रह्मणः पंचमंशिरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003293049, "chapter_id": 23293, "verse_number": "१-९६-५०", "content_sanskrit": "छिन्नं तमेनाभिसंधं तदंशं तस्य तद्वलम्  ।\nनिर्जितस्त्वं दधीचेन संग्रामे समरुद्गणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003293050, "chapter_id": 23293, "verse_number": "१-९६-५१", "content_sanskrit": "कंडूयमाने शिरसि कथं तद्विस्मृतं त्वया  ।\nचक्रं विक्रमतो यस्य चक्रपाणे तव प्रियम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003293051, "chapter_id": 23293, "verse_number": "१-९६-५२", "content_sanskrit": "कुतः प्राप्तं कृतं केन त्वया तदपि विस्मृतम्  ।\nते मया सकला लोका गृहीतास्त्वं पयोनिधौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003293052, "chapter_id": 23293, "verse_number": "१-९६-५३", "content_sanskrit": "निद्रापरवशः शेषे स कथं सात्त्विको भवान्  ।\nत्वदादिस्तंबपर्यंतं रुद्रशक्तिविजृंभितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003293053, "chapter_id": 23293, "verse_number": "१-९६-५४", "content_sanskrit": "शक्तिमानभितस्त्वं च ह्यनलस्त्वं च मोहितः  ।\nतत्तेजसोपि महात्म्यं युवां द्रष्टुं न हि क्षमौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003293054, "chapter_id": 23293, "verse_number": "१-९६-५५", "content_sanskrit": "स्थूला ये हि प्रपश्यंति तद्विष्णोः परमं पदम्  ।\nद्यावापृथिव्या इंद्राग्नियमस्य वरुणस्य च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003293055, "chapter_id": 23293, "verse_number": "१-९६-५६", "content_sanskrit": "ध्वांतोदरे शशांकस्य जनित्वा परमेश्वरः  ।\nकालोसि त्वं महाकालः कालकालो महेश्वरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003293056, "chapter_id": 23293, "verse_number": "१-९६-५७", "content_sanskrit": "अतस्त्वमुग्रकलया मृत्योर्मृत्युर्भविष्यसि  ।\nस्थिरधन्वा क्षयो वीरो वीरो विश्वाधिकः प्रभुः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003293057, "chapter_id": 23293, "verse_number": "१-९६-५८", "content_sanskrit": "उपहस्ता ज्वरं भीमो मृगपक्षिहिरण्मयः  ।\nशास्ताशेषस्य जगतो न त्वं नैवचतुर्मुखः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003293058, "chapter_id": 23293, "verse_number": "१-९६-५९", "content_sanskrit": "इत्थं सर्वं समालोक्य संहारात्मानमात्मना  ।\nनो चेदिदानीं क्रोधस्य महाभैरवरूपिणः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003293059, "chapter_id": 23293, "verse_number": "१-९६-६०", "content_sanskrit": "वज्राशनिरिव स्थाणोस्त्वेवं मृत्युः पतिष्यति  ।\nसूत उवाच  ।\nइत्युक्तो वीरभद्रेण नृसिंहः क्रोधविह्वलः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003293060, "chapter_id": 23293, "verse_number": "१-९६-६१", "content_sanskrit": "ननाद तनुवेगेन तं गृहीतुं प्रचक्रमे  ।\nअत्रांतरे महाघोरं विपक्षभयकारणम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003293061, "chapter_id": 23293, "verse_number": "१-९६-६२", "content_sanskrit": "गगनव्यापि दुर्धर्षशैववतेजः समुद्भवम्  ।\nवीरभद्रस्य तद्रूपं तत्क्षणादेव दृश्यते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003293062, "chapter_id": 23293, "verse_number": "१-९६-६३", "content_sanskrit": "न तद्धिरण्मयं सौम्यं न सौरं नाग्निसंभवम्  ।\nन तडिच्चंद्रसदृशमनौपम्यं महेश्वरम्।। ९६ ६३", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003293063, "chapter_id": 23293, "verse_number": "१-९६-६४", "content_sanskrit": "तदा तेजांसि सर्वाणि तस्मिन् लीनानि शांकरे  ।\nततोव्यक्तो महातेजा व्यक्ते संभवतस्ततः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003293064, "chapter_id": 23293, "verse_number": "१-९६-६५", "content_sanskrit": "रुद्रसाधारणं चैव चिह्नित विकृताकृति  ।\nततः संहारूपेण सुव्यक्तः परमेश्वरः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003293065, "chapter_id": 23293, "verse_number": "१-९६-६६", "content_sanskrit": "पश्यतां सर्वदेवानां जयशब्दादिमंगलैः  ।\nसहस्रबाहुर्जटिलश्चंद्रार्धकृतशेखरः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003293066, "chapter_id": 23293, "verse_number": "१-९६-६७", "content_sanskrit": "स मृगार्धशरीरेण पक्षाभ्यां चंचुना द्विजाः  ।\nअतितीक्ष्णमहादंष्ट्रो वज्रतुल्यनखायुधः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003293067, "chapter_id": 23293, "verse_number": "१-९६-६८", "content_sanskrit": "कंठे कालो महाबाहुश्चतुष्पाद्वह्निसंभवः  ।\nयुगांतोद्यतजीमूतभीमगंभीरनिःस्वनः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003293068, "chapter_id": 23293, "verse_number": "१-९६-६९", "content_sanskrit": "समं कुपितवृत्ताग्निव्यावृत्तनयनत्रयः  ।\nस्पष्टदंष्ट्रोधरोष्ठश्च हुंकारेण युतो हरः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003293069, "chapter_id": 23293, "verse_number": "१-९६-७०", "content_sanskrit": "हरिस्तद्दर्शनादेव विनष्टबलविक्रमः  ।\nबिभ्रदौर्म्यं सहस्रांशोरधः खद्योतविभ्रमम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003293070, "chapter_id": 23293, "verse_number": "१-९६-७१", "content_sanskrit": "अथ विभ्रम्य पक्षाभ्यां नाभिपादेभ्युदारयन्  ।\nपादावाबध्य पुच्छेन बाहुभ्यां बाहुमंडलम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003293071, "chapter_id": 23293, "verse_number": "१-९६-७२", "content_sanskrit": "भिन्दन्नुरसि बाहुभ्यां निजग्राह हरो हरिम्  ।\nततो जगाम गगनं देवैः सह महर्षिभिः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003293072, "chapter_id": 23293, "verse_number": "१-९६-७३", "content_sanskrit": "सहसैव भयाद्विष्णुं विहगश्च यथोरगम्  ।\nउत्क्षिप्योत्क्षिप्य संगृह्य निपात्य च निपात्य च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003293073, "chapter_id": 23293, "verse_number": "१-९६-७४", "content_sanskrit": "उड्डीयोड्डीय भगवान् पक्षाघातविमोहितम्  ।\nहरिं हरन्तं वृषभं विश्वेशानं तमीश्वरम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003293074, "chapter_id": 23293, "verse_number": "१-९६-७५", "content_sanskrit": "अनुयांति सुराः सर्वे नमोवाक्येन तुष्टुवुः  ।\nनीयमानः परवशो दीनवक्त्रः कृतांजलिः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003293075, "chapter_id": 23293, "verse_number": "१-९६-७६", "content_sanskrit": "तुष्टाव परमेशानं हरिस्तं ललिताक्षरैः  ।\nश्रीनृसिंह उवाच  ।\nनमोरुद्राय शर्वाय महाग्रासाय विष्णवे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003293076, "chapter_id": 23293, "verse_number": "१-९६-७७", "content_sanskrit": "नम उग्राय भीमाय नमः क्रोधाय मन्यवे  ।\nनमो भवाय शर्वाय शंकराय शिवाय ते ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003293077, "chapter_id": 23293, "verse_number": "१-९६-७८", "content_sanskrit": "कालकालाय कालाय महाकालाय मृत्यवे  ।\nवीराय वीरभद्राय क्षयद्वीराय शूलिने ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003293078, "chapter_id": 23293, "verse_number": "१-९६-७९", "content_sanskrit": "महादेवाय महते पशूनां पतये नमः  ।\nएकाय नीलकंठाय श्रीकण्ठाय पिनाकिने ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003293079, "chapter_id": 23293, "verse_number": "१-९६-८०", "content_sanskrit": "नमोनंताय सूक्ष्माय नमस्ते मृत्युमन्यवे  ।\nपराय परमेशाय परात्परतराय ते ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003293080, "chapter_id": 23293, "verse_number": "१-९६-८१", "content_sanskrit": "परात्पराय विश्वाय नमस्ते विश्वमूर्त्तये  ।\nनमो विष्णुकलत्राय विष्णुक्षेत्राय भानवे ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003293081, "chapter_id": 23293, "verse_number": "१-९६-८२", "content_sanskrit": "कैवर्ताय किराताय महाव्याधाय शाश्वते  ।\nभैरवाय शरण्याय महाबैरवरूपिणे ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003293082, "chapter_id": 23293, "verse_number": "१-९६-८३", "content_sanskrit": "नमो नृसिंहसंहर्त्रे कामकालपुरारये  ।\nमहापाशौघसंहर्त्रे विष्णुमायांतकारिणे ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003293083, "chapter_id": 23293, "verse_number": "१-९६-८४", "content_sanskrit": "त्र्यंबकाय त्र्यक्षराय शिपिविष्टाय मीढुषे  ।\nमृत्युंजयाय शर्वाय सर्वज्ञाय मखारये ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003293084, "chapter_id": 23293, "verse_number": "१-९६-८५", "content_sanskrit": "मखेशाय वरेण्याय नमस्ते वह्निरूपिणे  ।\nमहाघ्राणाय जिह्वाय प्राणापानप्रवर्त्तिने ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003293085, "chapter_id": 23293, "verse_number": "१-९६-८६", "content_sanskrit": "त्रिगुणाय त्रिशूलाय गुणातीताय योगिने  ।\nसंसाराय प्रवाहाय महायंत्रप्रवर्तिने ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003293086, "chapter_id": 23293, "verse_number": "१-९६-८७", "content_sanskrit": "नमश्चंद्राग्निसूर्याय मुक्तिवैचित्र्यहेतवे  ।\nवरदायावताराय सर्वकारणहेतवे ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003293087, "chapter_id": 23293, "verse_number": "१-९६-८८", "content_sanskrit": "कपालिने करालाय पतये पुण्यकीर्त्तये  ।\nअमोघायाग्निनेत्राय लकुलीशाय शंभवे ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003293088, "chapter_id": 23293, "verse_number": "१-९६-८९", "content_sanskrit": "भिषक्तमाय मुंडाय दंडिने योगरूपिणे  ।\nमेघवाहाय देवाय पार्वतीपतये नमः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003293089, "chapter_id": 23293, "verse_number": "१-९६-९०", "content_sanskrit": "अव्यक्ताय विशोकाय स्थिराय स्थिरधन्विने  ।\nस्थाणवे कृत्तिवासाय नमः पंचार्थहेतवे ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003293090, "chapter_id": 23293, "verse_number": "१-९६-९१", "content_sanskrit": "वरदायैकपादाय नमश्चंद्रार्धमौलिने  ।\nनमस्तेऽध्वरराजाय वयसां पतये नमः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003293091, "chapter_id": 23293, "verse_number": "१-९६-९२", "content_sanskrit": "योगीश्वराय नित्याय सत्याय परमेष्ठिने  ।\nसर्वात्मने नमस्तुभ्यं नमः सर्वेश्वराय ते ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003293092, "chapter_id": 23293, "verse_number": "१-९६-९३", "content_sanskrit": "एकद्वित्रिचतुः पंचकृत्वस्तेऽस्तु नमोनमः  ।\nदशकृत्वस्तु साहस्रकृत्वस्ते च नमोनमः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003293093, "chapter_id": 23293, "verse_number": "१-९६-९४", "content_sanskrit": "नमोपरिमितं कृत्वानंतकृत्वो नमोनमः  ।\nनमोनमो नमो भूयः पुनर्भूयो नमोनमः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003293094, "chapter_id": 23293, "verse_number": "१-९६-९५", "content_sanskrit": "सूत उवाच  ।\nनाम्नामष्टशतेनैवं स्तुत्वामृतमयेन तु  ।\nपुनस्तु पार्थयामास नृसिंहः शरभेश्वरम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003293095, "chapter_id": 23293, "verse_number": "१-९६-९६", "content_sanskrit": "यदायदा ममाज्ञानमत्यहंकारदूषितम् ।\nतदातदापनेतव्यं त्वयैव परमेश्वरः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003293096, "chapter_id": 23293, "verse_number": "१-९६-९७", "content_sanskrit": "एवं विज्ञापयन्प्रीतः शंकरं नरकेसरी  ।\nनन्वशक्तो भवान् विष्णो जीवितांतं पराजितः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003293097, "chapter_id": 23293, "verse_number": "१-९६-९८", "content_sanskrit": "तद्वक्त्रशेषमात्रांतं कृत्वा सर्वस्य विग्रहम्  ।\nशुक्तिशित्यं तदा मंगं वीरभद्रः क्षणात्ततः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003293098, "chapter_id": 23293, "verse_number": "१-९६-९९", "content_sanskrit": "देवा ऊचुः  ।\nअथ ब्रह्मादयः सर्वे वीरभद्रत्वया दृशा  ।\nजीविताः स्मो वयं देवाः पर्जन्येनेव पादपाः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003293099, "chapter_id": 23293, "verse_number": "१-९६-१००", "content_sanskrit": "यस्य भीषा दहत्याग्निरुदेति च रविः स्वयम्  ।\nवातो वाति च सोसित्वं मृत्युर्धावति पंचमः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003293100, "chapter_id": 23293, "verse_number": "१-९६-१०१", "content_sanskrit": "यदव्यक्तं परं व्योम कलातीतं सदाशिवम्  ।\nभगवंस्त्वामेव भवं वदंति ब्रह्मवादिनः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003293101, "chapter_id": 23293, "verse_number": "१-९६-१०२", "content_sanskrit": "के वयमेव धातुक्ये वेदने परमेश्वरः  ।\nन विद्धि परमं धाम रूपलावण्यवर्णने ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003293102, "chapter_id": 23293, "verse_number": "१-९६-१०३", "content_sanskrit": "उपसर्गेषु सर्वेषु त्रायस्वास्मान् गणाधिप ।\nएकादशात्मन् भगवान्वर्तते रूपवान् हरः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003293103, "chapter_id": 23293, "verse_number": "१-९६-१०४", "content_sanskrit": "ईदृशान् तेऽवताराणि दृष्ट्वा शिव बहूंस्तमः  ।\nकदाचित्संदिहेन्नास्मांस्त्वच्चिन्तास्तमया तथा ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003293104, "chapter_id": 23293, "verse_number": "१-९६-१०५", "content_sanskrit": "गुंजागिरिवरतटामितरूपाणि सर्वशः  ।\nअभ्यसंहर गम्यं ते न नीतव्यं परापरा ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003293105, "chapter_id": 23293, "verse_number": "१-९६-१०६", "content_sanskrit": "द्वे तनू तव रुद्रस्य वेदज्ञा ब्राह्मणा विदुः  ।\nघोराप्यन्या शिवाप्यन्या ते प्रत्येकमनेकधा ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003293106, "chapter_id": 23293, "verse_number": "१-९६-१०७", "content_sanskrit": "इहास्मान्पाहि भगवन्नित्याहतमहाबलः  ।\nभवता हि जगत्सर्वं व्याप्तं स्वेनैव तेजसा ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003293107, "chapter_id": 23293, "verse_number": "१-९६-१०८", "content_sanskrit": "ब्रह्मविष्ण्वींद्रचंद्रादि वयं च प्रमुखाः सुराः  ।\nसुरासुराः संप्रसूतास्त्वत्तः सर्वे महेश्वर ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003293108, "chapter_id": 23293, "verse_number": "१-९६-१०९", "content_sanskrit": "ब्रह्मा च इंद्रो विष्णुश्च यमाद्या न सुरासुरान्  ।\nततो निगृह्य च हरिं सिंह इत्युपचेतसम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003293109, "chapter_id": 23293, "verse_number": "१-९६-११०", "content_sanskrit": "यतो बिभर्षि सकलं विभज्य तनुमष्टधा  ।\nअतोस्मान्पाहि भगवन्सुरादानैरभीप्सितैः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003293110, "chapter_id": 23293, "verse_number": "१-९६-१११", "content_sanskrit": "उवाच तान् सुरान्देवो महर्षिश्च पुरातनान्  ।\nयथा जलं जलं क्षिप्तं क्षीरं क्षीरे घृतं घृते ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003293111, "chapter_id": 23293, "verse_number": "१-९६-११२", "content_sanskrit": "एक एव तदा विष्णुः शिवलीनो न चान्यथा  ।\nएष एव नृसिंहात्मा सदर्पश्च महाबलः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003293112, "chapter_id": 23293, "verse_number": "१-९६-११३", "content_sanskrit": "जगत्संहारकारेण प्रवृत्तो नरकेसरी  ।\nयाजनीयो नमस्तस्मै मद्भक्तिसिद्धिकांक्षिभिः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003293113, "chapter_id": 23293, "verse_number": "१-९६-११४", "content_sanskrit": "एतावदुक्त्वा भगवान्वीरभद्रो महाबलः  ।\nअपश्यन् सर्वभूतानां तत्रैवांतरधीयत ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003293114, "chapter_id": 23293, "verse_number": "१-९६-११५", "content_sanskrit": "नृसिंहकृत्तिवसनस्तदाप्रभृति शंकरः  ।\nवक्त्रं तन्मुण्डमालायां नायकत्वेन कल्पितम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003293115, "chapter_id": 23293, "verse_number": "१-९६-११६", "content_sanskrit": "ततो देवा निरातंकाः कीर्तयंतः कथामिमाम्  ।\nविस्मयोत्फुल्लनयना जम्मुः सर्वे यथागतम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003293116, "chapter_id": 23293, "verse_number": "१-९६-११७", "content_sanskrit": "य इदं परमाख्यानं पुण्यं वेदैः समन्वितम्  ।\nपठित्वा श्रृणुते चैव सर्वदुःखविनाशनम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003293117, "chapter_id": 23293, "verse_number": "१-९६-११८", "content_sanskrit": "धन्यं यशस्यमायुष्मारोग्यं पुष्टिवर्धनम्  ।\nसर्वविघ्नप्रशमनं सर्वव्याधिविनाशनम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003293118, "chapter_id": 23293, "verse_number": "१-९६-११९", "content_sanskrit": "अपमृत्युप्रशमनं महाशांतिकरं शुभम्  ।\nअरिचक्रप्रशमनं सर्वाधिप्रविनाशनम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003293119, "chapter_id": 23293, "verse_number": "१-९६-१२०", "content_sanskrit": "ततो दुःस्वप्नशमनं सर्वभूतनिवारणम्  ।\nविषग्रहक्षयकरं पुत्रपौत्रादिवर्धनम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003293120, "chapter_id": 23293, "verse_number": "१-९६-१२१", "content_sanskrit": "योगसिद्धिप्रदं सम्यक्‌ शिवज्ञानप्रकाशकम्  ।\nशेषलोकस्य सोपानं वांछितार्थैकसाधनम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003293121, "chapter_id": 23293, "verse_number": "१-९६-१२२", "content_sanskrit": "विष्णुमायानिरसनं देवतापरमार्थदम्  ।\nवांछसिद्धिप्रदं चैव ऋद्धिप्रज्ञादिसाधनम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003293122, "chapter_id": 23293, "verse_number": "१-९६-१२३", "content_sanskrit": "इदं तु शरभाकारं परं रूपं पिनाकिनः  ।\nप्रकाशीतव्यं भक्तेषु चिरेषुद्यमितेषु च ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003293123, "chapter_id": 23293, "verse_number": "१-९६-१२४", "content_sanskrit": "तैरेव पठितव्यं च श्रोतव्यं च शिवात्मभिः  ।\nशिवोत्सवेषु सर्वेषु चतुर्दश्यष्टमीषु च ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003293124, "chapter_id": 23293, "verse_number": "१-९६-१२५", "content_sanskrit": "पठेत्प्रतिष्ठाकालेषु शिवसन्निधिकारणम्  ।\nचोरव्याघ्राहिसिंहांतकृतो राजभयेषु च ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003293125, "chapter_id": 23293, "verse_number": "१-९६-१२६", "content_sanskrit": "अत्रान्योत्पातभूकंपदावाग्निपांसुवृष्टिषु  ।\nउल्कापाते महावाते विना वृष्ट्यातिवृष्टिषु ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7003293126, "chapter_id": 23293, "verse_number": "१-९६-१२७", "content_sanskrit": "अतस्तत्र पठेद्विद्वाञ्छिवभक्तो दृढव्रतः  ।\nयः पठेच्छृणुयाद्वापि स्तवं सर्वमनुत्तमम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7003293127, "chapter_id": 23293, "verse_number": "१-९६-१२८", "content_sanskrit": "स रुद्रत्वं समासाद्य रुद्रस्यानुचरो भवेत् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}]