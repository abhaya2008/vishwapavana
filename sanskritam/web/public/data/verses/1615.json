[{"id": 2028369, "chapter_id": 1615, "verse_number": "३-२५३-०x", "content_sanskrit": "दानवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028370, "chapter_id": 1615, "verse_number": "३-२५३-१", "content_sanskrit": "भोः सुयोधन राजेन्द्र भरतानां कुलोद्वह।\nशूरैः परिवृतो नित्यं तथैव च महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028371, "chapter_id": 1615, "verse_number": "३-२५३-२", "content_sanskrit": "अकार्षीः साहसमिदं कस्मात्प्रायोपवेशनम्।\nआत्मत्यागी ह्यधो याति वाच्यतां चायशस्करीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028372, "chapter_id": 1615, "verse_number": "३-२५३-३", "content_sanskrit": "न हि कार्यविरुद्धेषु बहुपापेषु कर्मसु।\nमूलघातिषु सज्जन्ते बुद्धिमन्तो भवद्विधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028373, "chapter_id": 1615, "verse_number": "३-२५३-४", "content_sanskrit": "नियच्छैनां मतिं राजन्धर्मार्थसुखनाशिनीम्।\nयशःप्रतापवीर्यघ्नीं शत्रूणां हर्षवर्धनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028374, "chapter_id": 1615, "verse_number": "३-२५३-५", "content_sanskrit": "श्रूयतां तु प्रभो तत्त्वं दिव्यतां चात्मनो नृप।\nनिर्माणं च रशरीरस्य ततो धैर्यमवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028375, "chapter_id": 1615, "verse_number": "३-२५३-६", "content_sanskrit": "पुरा त्व तपसाऽस्माभिर्लब्धो राजन्महेश्वरात्।\nपूर्वकायश्च ते सर्वो निर्मितो वज्रसंचयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028376, "chapter_id": 1615, "verse_number": "३-२५३-७", "content_sanskrit": "अस्त्रैरभेद्यः शस्त्रैश्चाप्यधःकायश्च तेऽनघ।\nकृतः पुष्पमयो देव्या रूपतस्त्रीमनोहरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028377, "chapter_id": 1615, "verse_number": "३-२५३-८", "content_sanskrit": "एवमीश्वरसंयुक्तस्तव देहो नृपोत्तम।\nदेव्या च राजशार्दूल दिव्यस्त्वं हि न मानुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028378, "chapter_id": 1615, "verse_number": "३-२५३-९", "content_sanskrit": "क्षत्रियाश्च महावीर्या भगदत्तपुरोगमाः।\nदिव्यास्त्रविदुषः शूराः क्षपयिष्यन्ति ते रिपून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028379, "chapter_id": 1615, "verse_number": "३-२५३-१०", "content_sanskrit": "तदलं ते विषादेन भयं तव न विद्यते।\nसहायार्थं च ते वीराः संभूता बुवि दानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028380, "chapter_id": 1615, "verse_number": "३-२५३-११", "content_sanskrit": "भीष्मद्रोणकृपादींश्च प्रवेक्ष्यन्त्यपरेऽसुराः।\nयैराविष्टा घृणां त्यक्त्वा योत्स्यन्ते तव वैरिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028381, "chapter_id": 1615, "verse_number": "३-२५३-१२", "content_sanskrit": "नैव पुत्रान्न च भ्रातॄन्न पितॄन्न च बान्धवान्।\nनैव शिष्यान्न च ज्ञातीन्न बालान्त्यविरान्न च।\nयुधि संप्रहरिष्यन्तो मोक्ष्यन्ति कुरुसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028382, "chapter_id": 1615, "verse_number": "३-२५३-१३", "content_sanskrit": "निःस्नेहा दानवाविष्टाः समाक्रान्तेऽन्तरात्मनि।\nप्रहरिष्यन्ति बन्धुभ्यः स्नेहमुत्सृज्य दूरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028383, "chapter_id": 1615, "verse_number": "३-२५३-१४", "content_sanskrit": "हृष्टाः पुरुषशार्दूलाः कलुषीकृतमानसाः।\nअनभिज्ञातमूलाश्च दैवाच्च विधिनिर्मितात्।\nव्याभाषमाणाश्चान्योन्यं न मे जीवन्विमोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028384, "chapter_id": 1615, "verse_number": "३-२५३-१५", "content_sanskrit": "सर्वे शस्त्रास्त्रमोक्षेण पौरुषे समवस्थिताः।\nश्लाघमानाः कुरुश्रेष्ठ करिष्यन्ति जनक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028385, "chapter_id": 1615, "verse_number": "३-२५३-१६", "content_sanskrit": "तेपि पञ्च महात्मानः प्रतियोत्सन्ति पाण्डवाः।\nवधं चैषां करिष्यन्ति दैवयुक्ता महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028386, "chapter_id": 1615, "verse_number": "३-२५३-१७", "content_sanskrit": "दैत्यरक्षोगणाश्चैव संभूताः क्षत्रयोनिषु।\nयोत्स्यन्ति युधि विक्रम्य शत्रुभिस्तव पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028387, "chapter_id": 1615, "verse_number": "३-२५३-१८", "content_sanskrit": "गदाभिर्मुसलैः शूलैः शस्त्रैरुच्चावचैस्तथा।\n`प्रहरिष्यनति ते वीरास्तवारिषु महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028388, "chapter_id": 1615, "verse_number": "३-२५३-१९", "content_sanskrit": "यच्च तेऽन्तर्गतं वीर भयमर्जुनसंभवम्।\nतत्रापि विहितोऽस्माभिर्वधोपायोऽर्जुनस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028389, "chapter_id": 1615, "verse_number": "३-२५३-२०", "content_sanskrit": "हतस्य नरकस्यात्मा कर्णमूर्तिमुपाश्रितः।\nतद्वैरं संस्मरन्वीर योत्स्यते केशवार्जुनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028390, "chapter_id": 1615, "verse_number": "३-२५३-२१", "content_sanskrit": "स ते विक्रमशौण्डीरो रणे पार्थं विजेष्यति।\nकर्णः प्रहरतांश्रेष्ठः सर्वांश्चारीन्महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028391, "chapter_id": 1615, "verse_number": "३-२५३-२२", "content_sanskrit": "ज्ञात्वैतच्छद्मना वज्री रक्षार्थं सव्यसाचिनः।\nकुण्डले कवचं चैव कर्णस्यापहरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028392, "chapter_id": 1615, "verse_number": "३-२५३-२३", "content_sanskrit": "तस्मादस्माभिरप्यत्र दैत्याः शतसहस्रशः।\nनियुक्ता राक्षसाश्चैव ये ते संशप्तका इति।\nप्रख्यातास्तेऽर्जुनं वीरं युधि हिंस्यन्ति मा शुचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028393, "chapter_id": 1615, "verse_number": "३-२५३-२४", "content_sanskrit": "असपत्ना त्वया हीयं भोक्तव्या वसुधा नृप।\nमा विषादं गमस्तस्मान्नैतत्त्वय्युपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028394, "chapter_id": 1615, "verse_number": "३-२५३-२५", "content_sanskrit": "विनष्टे त्वयि चास्माकं पक्षो हीयेत कौरव।\nगच्छ वीर न ते बुद्धिरन्या कार्या कथंचन।\nत्वमस्माकं गतिर्नित्यं देवतानां च पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028395, "chapter_id": 1615, "verse_number": "३-२५३-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028396, "chapter_id": 1615, "verse_number": "३-२५३-२६", "content_sanskrit": "एवमुक्त्वा परिष्वज्य दैत्यास्तं राजकुञ्जरम्।\nसमाश्वास्य च दुर्धर्षं पुत्रवद्दानवर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028397, "chapter_id": 1615, "verse_number": "३-२५३-२७", "content_sanskrit": "स्थिरां कृत्वा बुद्धिमस्य प्रियाण्युक्त्वा च भारत।\nगम्यतामित्यनुज्ञाय जयमाप्नुहि चेत्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028398, "chapter_id": 1615, "verse_number": "३-२५३-२८", "content_sanskrit": "तैर्विसृष्टं महाबाहुं कृत्या सैवानयत्पुरः।\nतमेव देशं यत्रासौ तदा प्रायमुपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028399, "chapter_id": 1615, "verse_number": "३-२५३-२९", "content_sanskrit": "प्रतिनिक्षिप्यतं वीरं कृत्या समभिपूज्य च।\nअनुज्ञाता च राज्ञा सा तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028400, "chapter_id": 1615, "verse_number": "३-२५३-३०", "content_sanskrit": "गतायामथ तस्यां तु राजा दुर्योधनस्तदा।\nस्वप्नभूतमिदं सर्वमचिन्तयत भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028401, "chapter_id": 1615, "verse_number": "३-२५३-३१", "content_sanskrit": "`संमृश्य तानि वाक्यानि दानवोक्तानि दुर्मतेः।\nविजेष्यामि रणे पाण्डूनिति चास्याभवनमतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028402, "chapter_id": 1615, "verse_number": "३-२५३-३२", "content_sanskrit": "कर्णं संशप्तकांश्चैव पार्थस्यामित्रघातिनः।\nअमन्यत वधे युक्तान्समर्थांश्च सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028403, "chapter_id": 1615, "verse_number": "३-२५३-३३", "content_sanskrit": "एवमाशा दृढा तस् धार्तराष्ट्रस् दुर्मतेः।\nविनिर्जये पाण्डवानामभवद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028404, "chapter_id": 1615, "verse_number": "३-२५३-३४", "content_sanskrit": "कर्णोऽप्याविष्टचित्तात्मा नरकस्यान्तरात्मना।\nअर्जुनस्य वधे क्रूरां करोति स्म तदा मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028405, "chapter_id": 1615, "verse_number": "३-२५३-३५", "content_sanskrit": "संशप्तकाश्च ते वीरा राक्षसाविष्टचेतसः।\nरजस्तमोभ्यामाक्रान्ताः फाल्गुनस्य वधैषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028406, "chapter_id": 1615, "verse_number": "३-२५३-३६", "content_sanskrit": "भीष्मद्रोणकृपाद्याश्च दानवाक्रान्तचेतसः।\nन तथा पाण्डुपुत्राणां स्नेहवन्तोऽभवंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2028407, "chapter_id": 1615, "verse_number": "३-२५३-३७", "content_sanskrit": "न चाचचक्षे कस्मैचिदेतद्राजा सुयोधनः।\n`कृत्ययाऽऽनाय्यकथितं यदस्य निशि दानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2028408, "chapter_id": 1615, "verse_number": "३-२५३-३८", "content_sanskrit": "दुर्योधनं निशन्ते च कर्णो वैकर्तनोऽब्रवीत्।\nस्मयन्निवाञ्जलिं कृत्वा पार्थिवं हेतुमद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2028409, "chapter_id": 1615, "verse_number": "३-२५३-३९", "content_sanskrit": "न मृतो जयते शत्रूञ्जीवन्भद्राणि पश्यति।\nमृतस्य भद्राणि कुतः कौरवेय कुतो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2028410, "chapter_id": 1615, "verse_number": "३-२५३-४०", "content_sanskrit": "न कालाऽद्य विषादस्य भयस्य मरणस्य वा।\nपरिष्वज्याब्रवीच्चैवनं भुजाभ्यां स महाभुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2028411, "chapter_id": 1615, "verse_number": "३-२५३-४१", "content_sanskrit": "उत्तिष्ठ राजन्किं शेषे कस्माच्छोचसि शत्रुहन्।\nशत्रून्प्रताप्य वीर्येण स कथं मर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2028412, "chapter_id": 1615, "verse_number": "३-२५३-४२", "content_sanskrit": "अथवा ते भयं जातं दृष्ट्वाऽर्जुनपराक्रमम्।\nसत्यंते प्रतिजानामि वधिष्यामि रणेऽर्जुनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2028413, "chapter_id": 1615, "verse_number": "३-२५३-४३", "content_sanskrit": "गते त्रयोदशे वर्षे सत्येनायुधमालभे।\nआनयिष्याम्यहं पार्तान्वशं तव जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2028414, "chapter_id": 1615, "verse_number": "३-२५३-४४", "content_sanskrit": "एवमुक्तस्तु कर्णेन दैत्यानां वचनात्तथा।\nप्रणिपातेन चाप्येषामुदतिष्ठत्सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2028415, "chapter_id": 1615, "verse_number": "३-२५३-४५", "content_sanskrit": "दैत्यानां तद्वचः श्रुत्वा हृदि कृत्वा स्थिरां मतिम्।\nततो मनुजशार्दूलो योजयामास वाहिनीम्।\nरथनागाश्वफलिलां पदातिजनसंकुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2028416, "chapter_id": 1615, "verse_number": "३-२५३-४६", "content_sanskrit": "गङ्गौघप्रतिमा चास्य प्रयाणे शुशुभे चमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2028417, "chapter_id": 1615, "verse_number": "३-२५३-४७", "content_sanskrit": "श्वेतच्छत्रैः पताकाभिश्चामरैश्च सुपाण्डुरैः।\nरथैर्नागैः पदातैश्च शुशुभेऽतीव संकुला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2028418, "chapter_id": 1615, "verse_number": "३-२५३-४८", "content_sanskrit": "व्यपेताभ्रघने काले द्यौरिवासीत्तु शारदी।\n`हंसपङ्क्तिसमाकीर्णा भ्रमत्सारसशोभिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2028419, "chapter_id": 1615, "verse_number": "३-२५३-४९", "content_sanskrit": "जयाशीर्भिर्द्विजेन्द्रैः स स्तूयमानोऽधिराजवत्।\nगृह्णन्नञ्जलिमालाश्च धार्तराष्ट्रो जनाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2028420, "chapter_id": 1615, "verse_number": "३-२५३-५०", "content_sanskrit": "सुयोधनो ययावग्रे श्रिया परमया ज्वलम्।\nकर्णेन सार्धं राजेन्द्र सौबलेन च देविना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2028421, "chapter_id": 1615, "verse_number": "३-२५३-५१", "content_sanskrit": "दुःशासनादयश्चास्य भ्रातरः सर्व एव ते।\nभूरिश्रवाः सोमदत्तो माराजश्च बाह्लिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2028422, "chapter_id": 1615, "verse_number": "३-२५३-५२", "content_sanskrit": "रथैर्नानाविधाकारैर्हयैर्गजवरैस्तथा।\nप्रयान्तं नृपसिंहं तमनुजग्मुः कुरूद्वहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2028423, "chapter_id": 1615, "verse_number": "३-२५३-५३", "content_sanskrit": "`प्रहृष्टमनसः सर्वे दुर्योधनपुरोगमाः ॥\nकालेनाल्पेन राजेन्द्र स्वपुरं विविशुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2028424, "chapter_id": 1615, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि त्रिपञ्चाशदधिकद्विशततमोऽध्यायः ॥ २५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]