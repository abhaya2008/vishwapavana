[{"id": 2013535, "chapter_id": 1279, "verse_number": "२-२०-१", "content_sanskrit": "वासुदेव उवाच॥\nपतितौ हंसडिभिकौ कंसश्च सगणो हतः।\nजरासन्धस्य निधने कालोऽयं समुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013536, "chapter_id": 1279, "verse_number": "२-२०-२", "content_sanskrit": "न शक्योऽसौ रणे जेतुं सर्वैरपि सुरासुरैः।\nप्राणयुद्धेन जेतव्यः स इत्युपलभामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013537, "chapter_id": 1279, "verse_number": "२-२०-३", "content_sanskrit": "मयि नीतिर्बलं भीमे रक्षिता चावयोर्जयः।\nमागधं साधयिष्याम इष्टिं त्रय इवाग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013538, "chapter_id": 1279, "verse_number": "२-२०-४", "content_sanskrit": "त्रिभिरासादितोऽस्माभिर्विजने स नराधिपः।\nन सन्देहो यथा युद्धमेकेनाप्युपयास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013539, "chapter_id": 1279, "verse_number": "२-२०-५", "content_sanskrit": "अवमानाच्च लोभाच्च बाहुवीर्याच्च दर्पितः।\nभीमसेनेन युद्धाय ध्रुवमप्युपयास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013540, "chapter_id": 1279, "verse_number": "२-२०-६", "content_sanskrit": "अलं तस्य महाबाहुर्भीमसेनो महाबलः।\nलोकस्य समुदीर्णस्य निधनायान्तको यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013541, "chapter_id": 1279, "verse_number": "२-२०-७", "content_sanskrit": "यदि भीमबलं वेत्सि यदि ते प्रत्ययो मयि।\nभीमसेनार्जुनौ शीघ्रं न्यासभूतौ प्रयच्छ मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013542, "chapter_id": 1279, "verse_number": "२-२०-८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013543, "chapter_id": 1279, "verse_number": "२-२०-८", "content_sanskrit": "एवमुक्तो भगवता प्रत्युवाच युधिष्ठिरः।\nभीमार्जुनौ समालोक्य सम्प्रहृष्टमुखौ स्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013544, "chapter_id": 1279, "verse_number": "२-२०-९x", "content_sanskrit": "युधिष्ठर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013545, "chapter_id": 1279, "verse_number": "२-२०-९", "content_sanskrit": "अच्युताच्युत मामैवं व्याहरामित्रकर्शन।\nपाण्डवानां भवान्नाथो भवन्तं चाश्रिता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013546, "chapter_id": 1279, "verse_number": "२-२०-१०", "content_sanskrit": "यथा वदसि गोविन्द सर्वं तदुपपद्यते।\nनहि त्वमग्रतस्तेषां येषां लक्ष्मीः पराङ्मुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013547, "chapter_id": 1279, "verse_number": "२-२०-११", "content_sanskrit": "येषामभिमुखी लक्ष्मीस्तेषां कृष्ण त्वमग्रतः।\nनिहतश्च जरासन्धो मोक्षिताश्च महीक्षितः। २-२--११c राजसूयश्च मे लब्धो निदेशे त्व तिष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013548, "chapter_id": 1279, "verse_number": "२-२०-१२", "content_sanskrit": "क्षिप्रमेव यथा त्वेतत्कार्यं समुपपद्यते।\nअप्रमत्तो जगन्नाथ तथा कुरु समुपपद्यते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013549, "chapter_id": 1279, "verse_number": "२-२०-१३", "content_sanskrit": "त्रिभिर्भवद्भिर्हि विना नाहं जीवितुमुत्सहे।\nधर्मकामार्थरहितो रोगार्त इव दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013550, "chapter_id": 1279, "verse_number": "२-२०-१४", "content_sanskrit": "न शौरिणा विना पार्थो न शौरिः पाण्डवं विना।\nनाजेयोस्त्यनयोऽर्लोके कृष्णयोरिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013551, "chapter_id": 1279, "verse_number": "२-२०-१५", "content_sanskrit": "अयं च बलिनां श्रेष्ठः श्रीमानपि वृकोदरः।\nयुवाभ्यां सहितो वीर किं न कुर्यान्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013552, "chapter_id": 1279, "verse_number": "२-२०-१६", "content_sanskrit": "सुप्रणीतो बलौघो हि कुरुते कार्यमुत्तमम्।\nअन्धं बलं जडं प्राहुः प्रणेतव्यं विचक्षणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013553, "chapter_id": 1279, "verse_number": "२-२०-१७", "content_sanskrit": "यतो हि निम्नं भवति नयन्ति हि ततो जलम्।\nयतश्छिद्रं ततश्चापि नयन्ते धीवरा जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013554, "chapter_id": 1279, "verse_number": "२-२०-१८", "content_sanskrit": "तस्मान्नयविधानज्ञं पुरुषं लोकविश्रुतम्।\nवयमाश्रित्य गोविन्दं यतामः कार्यसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013555, "chapter_id": 1279, "verse_number": "२-२०-१९", "content_sanskrit": "एवं प्रज्ञानयबलं क्रियोपायसमन्वितम्।\nपुरस्कृर्वीत कार्येषु कृष्णकार्यार्थसिद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013556, "chapter_id": 1279, "verse_number": "२-२०-२०", "content_sanskrit": "एवमेव यदुश्रेष्ठ यावत्कार्याथिसिद्धये।\nअर्जुनः कृष्णमन्वेतु भीमोऽन्वेतु धनञ्जयम्।\nनयो जयो बलं चैव विक्रमे सिद्धिमेष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013557, "chapter_id": 1279, "verse_number": "२-२०-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013558, "chapter_id": 1279, "verse_number": "२-२०-२१", "content_sanskrit": "एवमुक्तास्ततः सर्वे भ्रातरो विपुलौजसः।\nवार्ष्णेयः पाण्डवेयौ च प्रतस्थुर्मागधं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013559, "chapter_id": 1279, "verse_number": "२-२०-२२", "content_sanskrit": "वर्चस्विनां ब्राह्मणानां स्नातकानां परिच्छदैः।\nआच्छाद्य सुहृदां वाक्यैर्मनोज्ञैरभिनन्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013560, "chapter_id": 1279, "verse_number": "२-२०-२३", "content_sanskrit": "माधवः पाण्डवेयौ च प्रतस्थुर्व्रतधारिणः।\nअमर्षादभितप्तानां ज्ञात्यर्थं मुख्यतेजसाम्।\nरविसोमाग्निवपुषां दीप्तमासीत्तदा वपुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013561, "chapter_id": 1279, "verse_number": "२-२०-२४", "content_sanskrit": "इतं मेने जरासन्धं दृष्ट्वा भीमपुरोगमौ।\nएककार्यसमुद्यन्तौ कृष्णौ युद्धेऽपराजितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013562, "chapter_id": 1279, "verse_number": "२-२०-२५", "content_sanskrit": "ईशौ हितौ महात्मानौ सर्वकार्यप्रवर्तिनौ।\nधर्मकामार्थलोकानां कार्याणां च प्रवर्तकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013563, "chapter_id": 1279, "verse_number": "२-२०-२६", "content_sanskrit": "कुरुभ्यः प्रस्थितास्ते तु मध्येन कुरुजाङ्गलम्।\nरम्यं पद्मसरो गत्वा कालकूडमतीत्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013564, "chapter_id": 1279, "verse_number": "२-२०-२७", "content_sanskrit": "गण्डकीं च महाशोणं सदानीरां तथैव च।\nएकपर्वतके नद्यः क्रमेणैत्याव्रजन्त ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013565, "chapter_id": 1279, "verse_number": "२-२०-२८", "content_sanskrit": "उत्तीर्य सरयूं रम्यां दृष्ट्वा पूर्वांश्च कोसलान्।\nअतीत्य जग्मुर्मिथिलां मालां चर्मण्वतीं नदीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013566, "chapter_id": 1279, "verse_number": "२-२०-२९", "content_sanskrit": "अतीत्य गङ्गां शोणं च त्रयस्ते प्राङ्मुखास्तदा।\nकुशचीरच्छदा जग्मुर्मागधं क्षेत्रमच्युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013567, "chapter_id": 1279, "verse_number": "२-२०-३०", "content_sanskrit": "ते शश्वद्गोधनाकीर्णमम्बुमन्तं शुभद्रुमम्।\nगोरथं गिरिमासाद्य ददृशुर्मागधं पुरम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013568, "chapter_id": 1279, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि जरासन्धवधपर्वणि विंशोऽध्यायः॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]