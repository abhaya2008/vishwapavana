[{"id": 2177090, "chapter_id": 4743, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177091, "chapter_id": 4743, "verse_number": "१", "content_sanskrit": "द्वारदेशे ततो द्रौणिमवस्थितमवेक्ष्य तौ ।\nअकुर्वतां भोजकृपौ किं सञ्जय वदस्व मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177092, "chapter_id": 4743, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177093, "chapter_id": 4743, "verse_number": "२", "content_sanskrit": "कृतवर्माणमामन्त्र्य कृपं च स महारथः ।\nद्रौणिर्मन्युपरीतात्मा शिबिरद्वारमासदत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177094, "chapter_id": 4743, "verse_number": "३", "content_sanskrit": "तत्र भूतं महाकायं चन्द्राग्निसमवर्चसम् ।\nसोऽपश्यद् द्वारमावृत्य तिष्ठन्तं रोमहर्षणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177095, "chapter_id": 4743, "verse_number": "४", "content_sanskrit": "वसानं चर्म वैयाघ्रं वसारुधिरविस्रवम् ।\nकृष्णाजिनोत्तरासङ्गं नागयज्ञोपवीतिनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177096, "chapter_id": 4743, "verse_number": "५", "content_sanskrit": "बाहुभिः स्वायतैर्भीमैर्नानाप्रहरणोद्यतैः ।\nबद्धाङ्गदमहासर्पं ज्वालामालाकुलाननम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177097, "chapter_id": 4743, "verse_number": "६", "content_sanskrit": "दंष्ट्राकरालवदनं व्यादितास्यं भयावहम् ।\nनयनानां सहस्रैश्च विविधैरभिभूषितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177098, "chapter_id": 4743, "verse_number": "७", "content_sanskrit": "नैव तस्य वपुः शक्यं प्रवक्तुं वेष एव वा ।\nसर्वथा तु तदालोक्य स्फुटेयुरपि पर्वताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177099, "chapter_id": 4743, "verse_number": "८", "content_sanskrit": "तस्यास्य नासिकायाश्च श्रवणाभ्यां च भारत ।\nतेभ्यश्चाक्षिसहस्रेभ्यः प्रादुरासन् महार्चिषः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177100, "chapter_id": 4743, "verse_number": "९", "content_sanskrit": "तथा तेजोमरीचिभ्यः शङ्खचक्रगदायुधाः ।\nप्रादुरासन् हृषीकेशाः शतशोऽथ सहस्रशः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177101, "chapter_id": 4743, "verse_number": "१०", "content_sanskrit": "तदत्यद्भुतमालोक्य सर्वभूतभयङ्करम् ।\nद्रौणिरव्यथितो दिव्यैरस्त्रशस्त्रैरवाकिरत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177102, "chapter_id": 4743, "verse_number": "११", "content_sanskrit": "द्रौणिमुक्तान् शितान् बाणान् तद्भूतं महदग्रसत् ।\nउदधेरिव वार्योघान् पावको बडवामुखः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177103, "chapter_id": 4743, "verse_number": "१२", "content_sanskrit": "अग्रसत् तांस्तथाभूतान् द्रौणिना प्रहितान् शरान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177104, "chapter_id": 4743, "verse_number": "१३", "content_sanskrit": "अश्वत्थामा च सम्प्रेक्ष्य तान् शरौघान् निरर्थकान् ।\nरथशक्तिं मुमोचास्मै दीप्तामग्निशिखोपमाम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177105, "chapter_id": 4743, "verse_number": "१४", "content_sanskrit": "सा तदाहत्य दीप्ताग्र्या रथशक्तिरदीर्यत ।\nयुगान्ते सूर्यमाहत्य महोल्केव दिवश्च्युता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177106, "chapter_id": 4743, "verse_number": "१५", "content_sanskrit": "अथ हेमप्रभं दिव्यं खड्गमाकाशवर्चसम् ।\nकोशात् समुद्बबर्हाशु बिलाद्दीप्तमिवोरगम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177107, "chapter_id": 4743, "verse_number": "१६", "content_sanskrit": "स तं खड्गवरं धीमान् भूताय प्राहिणोत् तदा ।\nस तदासाद्य वै भूतं बिलं नकुलवद् ययौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177108, "chapter_id": 4743, "verse_number": "१७", "content_sanskrit": "ततः स कुपितो द्रौणिरिन्द्रकेतुनिभां गदाम् ।\nज्वलन्तीं प्राहिणोत् तस्मै भूतं तामपि चाग्रसत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177109, "chapter_id": 4743, "verse_number": "१८", "content_sanskrit": "ततः सर्वायुधाभावे वीक्षमाणस्ततस्ततः ।\nअपश्यत् कृतमाकाशम् अनाकाशं जनार्दनैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177110, "chapter_id": 4743, "verse_number": "१९", "content_sanskrit": "तदद्भुतमिदं दृष्ट्वा द्रोणपुत्रो निरायुधः ।\nअचिन्तयत् सुसन्त्रस्तः कृपभोजवचः स्मरन्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177111, "chapter_id": 4743, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177112, "chapter_id": 4743, "verse_number": "२०", "content_sanskrit": "ब्रुवतामप्रियं पथ्यं सुहृदां न शृणोति यः ।\nस शोचत्यापदं प्राप्य यथाऽहमवमत्य तौ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177113, "chapter_id": 4743, "verse_number": "२१", "content_sanskrit": "शास्त्रदृष्टमवज्ञाय समतीत्य जिघांसति ।\nस पथः प्रच्युतो धर्म्याद् विपथे प्रतिहन्यते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177114, "chapter_id": 4743, "verse_number": "२२", "content_sanskrit": "गोब्राह्मणनृपस्त्रीषु सख्युभ्रातुर्गुरोस्तथा ।\nवृद्धबालजडान्धेषु सुप्तभीतोत्थितेषु च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177115, "chapter_id": 4743, "verse_number": "२३", "content_sanskrit": "मत्तोन्मत्तप्रमत्तेषु न च शस्त्रं प्रयोजयेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177116, "chapter_id": 4743, "verse_number": "२४", "content_sanskrit": "इत्येवं गुरुभिः पूर्वमुपदिष्टं नृणां सदा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177117, "chapter_id": 4743, "verse_number": "२५", "content_sanskrit": "सोऽहमुत्क्रम्य पन्थानं शास्त्रदृष्टं सनातनम् ।\nअमार्गेणैवमारब्धो घोरां तरितुमापदम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177118, "chapter_id": 4743, "verse_number": "२६", "content_sanskrit": "तां चापदं घोरतरां प्रवदन्ति मनीषिणः ।\nयदुद्यम्य महत्कृत्यं भयादिह निवर्तते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177119, "chapter_id": 4743, "verse_number": "२७", "content_sanskrit": "अशक्यं चैव कः कर्तुं शक्तः शक्तिबलादिह ।\nन हि दैवाद् गरीयो वै मानुष्यं किञ्चिदिष्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177120, "chapter_id": 4743, "verse_number": "२८", "content_sanskrit": "मानुष्यं कुर्वतः कर्म यदि दैवान्न सिद्ध्यति ।\nस पथः प्रच्युतो धर्म्याद् विपथे प्रतिहन्यते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177121, "chapter_id": 4743, "verse_number": "२९", "content_sanskrit": "प्रतिज्ञातं ह्यविज्ञानं प्रवदन्ति मनीषिणः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177122, "chapter_id": 4743, "verse_number": "३०", "content_sanskrit": "यदारभ्य क्रियां काञ्चिद् भयादिह निवर्तते ।\nतदिदं दुष्प्रणीतेन भयं मां समुपस्थितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177123, "chapter_id": 4743, "verse_number": "३१", "content_sanskrit": "न हि द्रोणसुतः सङ्खे निवर्तेत कथञ्चन ।\nइदं च सुमहद्भूतं दैवदण्डमिवोद्यतम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177124, "chapter_id": 4743, "verse_number": "३२", "content_sanskrit": "न चैतदभिजानामि चिन्तयन्नपि सर्वथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177125, "chapter_id": 4743, "verse_number": "३३", "content_sanskrit": "ध्रुवं येयमधर्मेण प्रहिता कलुषा मतिः ।\nतस्याः फलमिदं घोरं प्रतिघाताय दृश्यते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177126, "chapter_id": 4743, "verse_number": "३४", "content_sanskrit": "तदिदं दैवविहितं मम सङ्खे निवर्तनम् ।\nनान्यत्र दैवादुद्यन्तुम् इह शक्यं कथञ्चन\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177127, "chapter_id": 4743, "verse_number": "३५", "content_sanskrit": "सोऽहमद्य महादेवं प्रपद्ये शरणं प्रभुम् ।\nदैवदण्डमिदं घोरं स हि मे नाशयिष्यति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177128, "chapter_id": 4743, "verse_number": "३६", "content_sanskrit": "कपर्दिनं प्रपद्येऽहं देवदेवमुमापतिम् ।\nकपालमालिनं रुद्रं भगनेत्रहरं हरम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177129, "chapter_id": 4743, "verse_number": "३७", "content_sanskrit": "स हि देवोऽत्यगाद् देवांस्तपसा नियमेन तु ।\nतस्माच्छरणमभ्येष्ये गिरिशं शूलपाणिनम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177130, "chapter_id": 4743, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसौप्तिकपर्वणि द्रोणेर्महद्भूतदर्शनं नाम षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]