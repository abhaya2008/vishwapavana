[{"id": 2061453, "chapter_id": 2314, "verse_number": "८-३५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061454, "chapter_id": 2314, "verse_number": "८-३५-१", "content_sanskrit": "मारिषाधिरथेः श्रुत्वा वाचो युद्धाभिनन्दिनः।\nशल्योऽब्रवीत्पुनः कर्णं निदर्शनमुदाहरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061455, "chapter_id": 2314, "verse_number": "८-३५-२", "content_sanskrit": "जातोऽहं यज्वनां वंशे सङ्ग्रामेष्वनिवर्तिनाम्।\nराज्ञां मूर्धाभिषिक्तानां स्वयं धर्मपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061456, "chapter_id": 2314, "verse_number": "८-३५-३", "content_sanskrit": "यथैव मत्तो मद्येन त्वं तथा लक्ष्यसे वृष।\nतथाऽद्य त्वां प्रमाद्यन्तं चिकित्सेयं सुहृत्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061457, "chapter_id": 2314, "verse_number": "८-३५-४", "content_sanskrit": "इमां काकोपमां कर्ण प्रोच्यमानां निबोध मे।\nश्रुत्वा यथेष्टं कुर्यास्त्वं निहीन कुलपांसन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061458, "chapter_id": 2314, "verse_number": "८-३५-५", "content_sanskrit": "नाहमात्मनि किञ्चिद्वै किल्बिषं कर्ण संस्मरे।\nयेन मां त्वं महाबाहो हन्तुमिच्चस्यनागसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061459, "chapter_id": 2314, "verse_number": "८-३५-६", "content_sanskrit": "अवश्यं तु मया वाच्यं बुद्ध्वा तव हिताहितम्।\nविशेषतो रथस्थेन राज्ञश्चैव हितैषिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061460, "chapter_id": 2314, "verse_number": "८-३५-७", "content_sanskrit": "समं च विषमं चैव रथिनश्च बलाबलम्।\nश्रमः खेदश्च सततं हयानां रथिना सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061461, "chapter_id": 2314, "verse_number": "८-३५-८", "content_sanskrit": "आयुधस्य परिज्ञानं रुतं च मृगपक्षिणाम्।\nसारं चैवाप्यासरं च शल्यानां च प्रतिक्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061462, "chapter_id": 2314, "verse_number": "८-३५-९", "content_sanskrit": "अस्त्रयोगं च युद्वं च निमित्तानि तथैव च।\nसर्वमेतन्मया ज्ञेयं रथस्यास्य कुटुम्बिना।\nअतस्त्वां कथये कर्ण निदर्शनमिदं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061463, "chapter_id": 2314, "verse_number": "८-३५-१०", "content_sanskrit": "वैश्यः किल समुद्रान्ते प्रभूतधनधान्यवान्।\nयज्वा दानपतिः क्षान्तः स्वकर्मस्थोऽभवच्छुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061464, "chapter_id": 2314, "verse_number": "८-३५-११", "content_sanskrit": "बहुपुत्रः प्रियापत्यः सर्वभूतानुकम्पकः।\nराज्ञो धर्मप्रधानस्य राष्ट्रे वसति निर्भयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061465, "chapter_id": 2314, "verse_number": "८-३५-१२", "content_sanskrit": "पुत्राणां तस्य बालानां कुमाराणां यशस्विनाम्।\nकाको बहूनामभवदुच्छिष्टकृतभोजनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061466, "chapter_id": 2314, "verse_number": "८-३५-१३", "content_sanskrit": "तस्मैसदा प्रयच्छन्ति वैश्यपुत्राः कुमारकाः।\nमांसोदनं दधि क्षीरं पायसं मधुसर्पिषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061467, "chapter_id": 2314, "verse_number": "८-३५-१४", "content_sanskrit": "स चोच्छिष्टभृतः काको वैश्यपुत्रैः कुमारकैः।\nसदृशान्पक्षिणो दृप्तः श्रेयससश्चावमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061468, "chapter_id": 2314, "verse_number": "८-३५-१५", "content_sanskrit": "अथ हंसाः समुद्रान्ते प्रजग्मुरतिपातिनः।\nगरुडस्य गतौ तुल्याश्चक्राङ्गा हृष्टचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061469, "chapter_id": 2314, "verse_number": "८-३५-१६", "content_sanskrit": "कुमरारकास्तदा हंसान्दृष्ट्वा काकमथाब्रुवन्।\nभवानेव विशिष्टोऽसि पतत्रिभ्यो विहङ्गम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061470, "chapter_id": 2314, "verse_number": "८-३५-१७", "content_sanskrit": "एतेऽतिपातिनः पश्य विहङ्गान्वियदाश्रितान्।\nएहि त्वमपि शक्तो हि कस्मान्न पतितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061471, "chapter_id": 2314, "verse_number": "८-३५-१८", "content_sanskrit": "प्रतार्यमाणस्तैः सर्वैरल्पबुद्धिभइरण्डजः।\nतद्वचः सत्यमित्येव मौर्ख्याद्दर्पाच्च जज्ञिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061472, "chapter_id": 2314, "verse_number": "८-३५-१९", "content_sanskrit": "तान्सोनुपत्य जिज्ञासुः क एषां श्रेष्ठभागिति।\nउच्छिष्टदर्पितः काको बहूनामेकपातिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061473, "chapter_id": 2314, "verse_number": "८-३५-२०", "content_sanskrit": "तेषां यं प्रवरं मेने हंसानां दूरपातिनाम्।\nस तमाह्वत दुर्बुद्धिः पताव इति पक्षिणम्।\nतच्छ्रुत्वा प्राहसन्हंसा ये तत्रासन्समागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061474, "chapter_id": 2314, "verse_number": "८-३५-२१", "content_sanskrit": "भाषतो बहु काकस्य बालिश्यात्पततां वराः।\nइदमूचुः स्म चक्राङ्गावचः काकं विङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061475, "chapter_id": 2314, "verse_number": "८-३५-२२x", "content_sanskrit": "हंसा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061476, "chapter_id": 2314, "verse_number": "८-३५-२२", "content_sanskrit": "वयं हंसाश्चरामेमां पृथिवीं मानसौकसः।\nपक्षिणां च वयं नित्यं दूरपातेन पूजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061477, "chapter_id": 2314, "verse_number": "८-३५-२३", "content_sanskrit": "कथं हंसं नु बलिनं चक्राङ्गं दूरपातिनम्।\nकाको भूत्वा निपतने समाह्वयसि दुर्मते।\nकथं त्वं पतिता काक सहास्माभिर्ब्रवीहि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061478, "chapter_id": 2314, "verse_number": "८-३५-२४", "content_sanskrit": "अथ हंसवचो मूढः कुत्सयित्वा पुनः पुनः।\nप्रजगादोत्तरं काकः कत्थनो जातिलाघवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061479, "chapter_id": 2314, "verse_number": "८-३५-२५x", "content_sanskrit": "काक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061480, "chapter_id": 2314, "verse_number": "८-३५-२५", "content_sanskrit": "शतमेकं च पातानां पतिताऽस्मि न संशयः।\nशतयोजनमेकैकं विचित्रं विविधं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061481, "chapter_id": 2314, "verse_number": "८-३५-२६", "content_sanskrit": "उड्डीनमवडीनं च प्रडीनं डीनमेव च।\nनिडीनमथ संडीनं तिर्यक्डीनगतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061482, "chapter_id": 2314, "verse_number": "८-३५-२७", "content_sanskrit": "विडीनं परिडीनं च पराडीनं सुडीनकम्।\nअभिडीनं महाडीनं निर्डीनमतिडीनकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061483, "chapter_id": 2314, "verse_number": "८-३५-२८", "content_sanskrit": "अवडीनं प्रडीनं च संडीनं डीनडीनकम्।\nसंडीनोड्डीनडीनं च पुनर्डीनविडीनकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061484, "chapter_id": 2314, "verse_number": "८-३५-२९", "content_sanskrit": "संपातं समुदीषं च ततोऽन्यद्व्यतिरिक्तकम्।\nगतागतं प्रतिगतं बह्वीश्च निकुलीनकाः।\nकर्ताऽस्मि मिषतां वोऽद्य ततो द्रक्षयथ मे बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061485, "chapter_id": 2314, "verse_number": "८-३५-३०", "content_sanskrit": "तेषामन्यतमेनाहं पतिष्यामि विहायसम्।\nप्रदिशध्वं यथान्यायं केन हंसाः पताम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061486, "chapter_id": 2314, "verse_number": "८-३५-३१", "content_sanskrit": "ते वै ध्रुवं विनिश्चित्य सम्पतध्वं मया सह।\nपातैरेभिः खलु खगाः पतितुं खे निराश्रये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061487, "chapter_id": 2314, "verse_number": "८-३५-३२", "content_sanskrit": "एवमुक्ते तु काकेन प्रहस्यैको विहंगमः।\nउवाच काकं राधेय वचनं तन्निबोध मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061488, "chapter_id": 2314, "verse_number": "८-३५-३३x", "content_sanskrit": "हंस उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061489, "chapter_id": 2314, "verse_number": "८-३५-३३", "content_sanskrit": "शतमेकं च पातानां त्वं काक पतिता ध्रुवम्।\nएकमेव तु यं पातं विदुः सर्वे विहङ्गमाः।\nतमहं पतिता काक नान्यं जानामि कञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061490, "chapter_id": 2314, "verse_number": "८-३५-३४x", "content_sanskrit": "काक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061491, "chapter_id": 2314, "verse_number": "८-३५-३४", "content_sanskrit": "पत त्वमपि तत्राशु येन पातेन मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061492, "chapter_id": 2314, "verse_number": "८-३५-३५", "content_sanskrit": "अथ काकं प्रजहसुर्ये तत्रासन्समागताः।\nकथमेकेन पातेन हंसः पातशतं जयेत्।\nएकेन वायस त्वैनं पातेनाभिभविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061493, "chapter_id": 2314, "verse_number": "८-३५-३६", "content_sanskrit": "हंसश्चोत्पतितः काको बलवानाशुविक्रमः।\nप्रपेततुः स्पर्धया च ततस्तौ हंसवायसौ।\nउपर्युपरि वेगेन समुद्रं मकरालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061494, "chapter_id": 2314, "verse_number": "८-३५-३७", "content_sanskrit": "हंसस्त्वेकेन पातेन काकः पातशतेन च।\nस्पर्धिनौ सहितौ तूर्णं खमास्थाय तरस्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061495, "chapter_id": 2314, "verse_number": "८-३५-३८", "content_sanskrit": "हंसस्तु मृदुनैकेन विक्रान्तुमुपचक्रमे।\nपूर्वमेव तु वै काकः स तं तूर्णं प्रचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2061496, "chapter_id": 2314, "verse_number": "८-३५-३९", "content_sanskrit": "नात्यहीयत काकश्च मुहूर्तमिव सूतज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2061497, "chapter_id": 2314, "verse_number": "८-३५-४०", "content_sanskrit": "काकोपि हंसं चापल्याच्छीघ्रतां प्रतिदर्शयन्।\nवेगेनातीत्य तरसा पुनरेति मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2061498, "chapter_id": 2314, "verse_number": "८-३५-४१", "content_sanskrit": "तुण्डेनाभ्यहनच्चैनं कुर्वन्नामापसव्यतः।\nरोरूयन्निव चाप्येनं समाह्वयति वै मुहुः।\nविसिस्मापयिषुः पातैर्दर्शयन्नात्मनः क्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2061499, "chapter_id": 2314, "verse_number": "८-३५-४२", "content_sanskrit": "अथ तानि विचित्राणि पतितानीतराणि च।\nदृष्ट्वा प्रमुदिताः काका विनेदुरधिकैः स्वरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2061500, "chapter_id": 2314, "verse_number": "८-३५-४३", "content_sanskrit": "हंसाश्चापहसन्ति स्म प्रवदन्ति प्रियाणि च।\nकुर्वाणा विविधान्रावानिच्छन्तो जयमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2061501, "chapter_id": 2314, "verse_number": "८-३५-४४", "content_sanskrit": "उत्पत्योत्पत्य च प्राहुर्मुहूर्तमिति चेति च।\nवृक्षाग्रेभ्यः स्थलेभ्यश्च निपतन्त्युत्पतन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2061502, "chapter_id": 2314, "verse_number": "८-३५-४५", "content_sanskrit": "अवमत्य च हंसं तमिदं काकोऽब्रवीद्वचः।\nयोऽसावुत्पतितो हंसः सोऽसावेव प्रहीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2061503, "chapter_id": 2314, "verse_number": "८-३५-४६", "content_sanskrit": "अथ हंसस्तु तच्छ्रुत्वा भाषितं पततांवरः।\nविगाह्य हंसो विक्षोभ्य प्रापतत्पश्चिमां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2061504, "chapter_id": 2314, "verse_number": "८-३५-४७", "content_sanskrit": "उपर्युपरि वेगेन सागरं मकरालयम्।\nबहुसत्वसमाकीर्णं वीचीभिर्भीमदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2061505, "chapter_id": 2314, "verse_number": "८-३५-४८", "content_sanskrit": "अथाचिरेण राधेय काको वेगादहीयत।\nततोऽतीव परिश्रान्तः कथञ्चिद्वंसमन्वगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2061506, "chapter_id": 2314, "verse_number": "८-३५-४९", "content_sanskrit": "भीश्चैनमाविशत्तीव्रं काकं कर्ण विचेतसम्।\nद्वीपान्द्रुमान्वितान्पश्यन्विश्रमार्थं श्रमातुरः।\nनिपतेयं क्कनु श्रान्त इति तस्मिञ्जलार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2061507, "chapter_id": 2314, "verse_number": "८-३५-५०", "content_sanskrit": "अवगाह्य समुद्रोऽपि बहुसत्वगणालयः।\nमहान्भूतशतोद्भूसी नभसस्तु विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2061508, "chapter_id": 2314, "verse_number": "८-३५-५१", "content_sanskrit": "गाम्भीर्यार्द्वि समुद्रस्य न विशेषं कुलाधम।\nदिशश्च नाम्भसां कर्ण समुद्रस्था विदुर्जनाः।\nविपश्चितोप्यपारत्वात्किं पुनः कर्ण वायसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2061509, "chapter_id": 2314, "verse_number": "८-३५-५२", "content_sanskrit": "अथ हंसोप्यतिक्रामन्मुहूर्तमिव दूरतः।\nअतिक्रम्य च चक्राङ्गः काकं तं समुदैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2061510, "chapter_id": 2314, "verse_number": "८-३५-५३", "content_sanskrit": "शनकैः परिहीनं तं परिश्रान्तमचेतसम्।\nअवेक्षमाणस्तं काकं प्रत्यागम्य हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2061511, "chapter_id": 2314, "verse_number": "८-३५-५४", "content_sanskrit": "तं प्रहस्य च चक्राङ्गः काकं मन्दगतिं तदा।\nहीयमानमथो दृष्ट्वा हंसः प्राह यथार्थवत्।\nउज्जिहीर्षुर्निमज्जन्तं स्मरन्सत्पुरुषव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2061512, "chapter_id": 2314, "verse_number": "८-३५-५५", "content_sanskrit": "बहूनि पतितानि त्वमाचक्षाणो मुहुर्मुहुः।\nपतस्यव्याहरन्खेदं ततो गर्ह्यं प्रभाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2061513, "chapter_id": 2314, "verse_number": "८-३५-५६", "content_sanskrit": "जलं नाम पतितं काक यत्त्वं पतसि साम्प्रतम्।\nजलं स्पृशसि पक्षाभ्यां तुण्डेन च पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2061514, "chapter_id": 2314, "verse_number": "८-३५-५७", "content_sanskrit": "प्रब्रूहि कतमोऽयं ते पातो वर्तति वायस।\nएह्येहि काक शीघ्रं त्वमेष त्वां परिपालये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2061515, "chapter_id": 2314, "verse_number": "८-३५-५८", "content_sanskrit": "स पक्षाभ्यां स्पृशन्नार्तस्तुण्डेन च जलं तदा।\nकाको दृढं परिश्रान्तः सहसा निपपात ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2061516, "chapter_id": 2314, "verse_number": "८-३५-५९", "content_sanskrit": "सागराम्भसि तं दृष्ट्वा पततन्तं दीनचेतसम्।\nम्रियमाणमिदं वाक्यं हंसः काकमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2061517, "chapter_id": 2314, "verse_number": "८-३५-६०", "content_sanskrit": "शतमेकं च पातानां पताम्यहमिति स्म ह।\nश्लाघन्नात्मानमद्य त्वं काक भाषितवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2061518, "chapter_id": 2314, "verse_number": "८-३५-६१", "content_sanskrit": "स त्वमेकशतं पातं पतन्नभ्यधिको मया।\nकथमेवं परिश्रान्तः पतितोऽसि महार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2061519, "chapter_id": 2314, "verse_number": "८-३५-६२", "content_sanskrit": "प्रत्युवाच ततः काकः सीदमान इदं वचः।\nउपरीतं तदा हंसं प्रसमीक्ष्य प्रसादयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2061520, "chapter_id": 2314, "verse_number": "८-३५-६३", "content_sanskrit": "उच्छिष्टान्नेन पुष्टोऽहं दर्पोत्सिक्तः कुसत्वतः।\nसुपर्ण इव चात्मानं ज्ञातवान्पुत्रलाघवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2061521, "chapter_id": 2314, "verse_number": "८-३५-६४", "content_sanskrit": "शरणं त्वां प्रपन्नोऽहमुदकान्तमवाप्नुयाम्।\nहंसेदानीं परिश्रान्तमापदो मां समुद्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2061522, "chapter_id": 2314, "verse_number": "८-३५-६५", "content_sanskrit": "यदि नाम पुनर्जीवन्गच्छेयं स्वं निवेशनम्।\nनैनं पुनर्हीनमपि क्षेप्ताऽहं खे विचारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2061523, "chapter_id": 2314, "verse_number": "८-३५-६६", "content_sanskrit": "तमेवं करुणं दीनं विलपन्तमचेतसम्।\nकाककाकेति वाशन्तं निमज्जन्तं महार्णवे।\nकृपयाऽभिपरीतो वै कृपां चक्रे दुरात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2061524, "chapter_id": 2314, "verse_number": "८-३५-६७", "content_sanskrit": "अथ तं पततं दीनं जलक्लिन्नमचेतनम्।\nपद्भ्यामुत्क्षिप्य वेपन्तं पृष्ठमारो पयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2061525, "chapter_id": 2314, "verse_number": "८-३५-६८", "content_sanskrit": "स हंसः पृष्ठमारोप्य काकं कर्ण विचेतसम्।\nअविस्मयंस्तदा कर्ण पुनरेव समानयत्।\nतमेव देशं तरसा स्पर्धया पेततुर्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2061526, "chapter_id": 2314, "verse_number": "८-३५-६९", "content_sanskrit": "उत्सृज्य त्वब्रवीन्मैवं पुनः कार्यं त्वयेति ह।\nस्थाप्य चैनं पुनर्द्वीपे समाश्वस्य च विक्लवम्।\nगतो यथेप्सितं देशं हंसो मन इवाशुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2061527, "chapter_id": 2314, "verse_number": "८-३५-७०", "content_sanskrit": "एवमुच्छिष्टपुष्टः स काकोऽहंसपराजितः।\nबलं वीर्यं महत्कर्ण त्यक्त्वा क्षान्तिमुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2061528, "chapter_id": 2314, "verse_number": "८-३५-७१", "content_sanskrit": "उच्छिष्टभोजनः काको यथा वैश्यकुले पुरा।\nएवं त्वमुच्छिष्टभृतो धार्तराष्ट्रैर्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2061529, "chapter_id": 2314, "verse_number": "८-३५-७२", "content_sanskrit": "सदृशाञ्श्रेयसश्चापि सर्वान्कर्णावमन्यसे।\nद्रोणद्रौणिकृपैर्गुप्तो भीष्मेणान्यैश्च कौरवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2061530, "chapter_id": 2314, "verse_number": "८-३५-७३", "content_sanskrit": "विराटनगरे पार्थमेकं किं नावधीस्तदा।\nयत्र व्यस्ताः समस्ताश्च निर्जिताः स्थ किरीटिना\nसृगाला इव सिंहेन क्व ते वीर्यं तदा गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2061531, "chapter_id": 2314, "verse_number": "८-३५-७४", "content_sanskrit": "भ्रातरं निहतं दृष्ट्वा समरे सव्यसाचिना।\nपश्यतां कुरवीराणां प्रथमं त्वं पलायितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2061532, "chapter_id": 2314, "verse_number": "८-३५-७५", "content_sanskrit": "तथा द्वैतवने कर्ण गन्धर्वैः समभिद्रुतान्।\nकुरून्सदारानुत्सृज्य त्वमेवाग्रे पलायितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2061533, "chapter_id": 2314, "verse_number": "८-३५-७६", "content_sanskrit": "हत्वा जित्वा च गन्धर्वांश्चित्रसेनमुखान्रणे।\nकर्ण दुर्योधनं पार्थः सभ्रातृकममोक्षयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2061534, "chapter_id": 2314, "verse_number": "८-३५-७७", "content_sanskrit": "पुनः प्रभावः पार्थस्य पुराणः केशवस्य च।\nकथितः कर्ण रामेण सभायां कुरुसंसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2061535, "chapter_id": 2314, "verse_number": "८-३५-७८", "content_sanskrit": "सततं च त्वमश्रौषीर्वचनं द्रोणभीष्मयोः।\nअवध्यौ वदतोः कृष्णौ सन्निधौ च महीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2061536, "chapter_id": 2314, "verse_number": "८-३५-७९", "content_sanskrit": "कियन्तं तत्र वक्ष्यामि येनयेन धनञ्जयः।\nत्वत्तोऽतिरिक्तः सर्वेभ्यो भूतेभ्यो ब्राह्मणो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2061537, "chapter_id": 2314, "verse_number": "८-३५-८०", "content_sanskrit": "इदानीमेव द्रष्टासि प्रधाने स्यन्दने स्थितौ।\nपुत्रं च वसुदेवस्य कुन्तीपुत्रं च पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2061538, "chapter_id": 2314, "verse_number": "८-३५-८१", "content_sanskrit": "यथाऽश्रयत चक्राङ्गं वायसो बुद्धिमास्थितः।\nतथाश्रयस्व वार्ष्णेयं पाण्डवं च धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2061539, "chapter_id": 2314, "verse_number": "८-३५-८२", "content_sanskrit": "यदा त्वं युधि विक्रान्तौ वासुदेवधनञ्जयौ।\nद्रष्टास्येकरथे कर्ण तदा नैवं वदिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2061540, "chapter_id": 2314, "verse_number": "८-३५-८३", "content_sanskrit": "यदा शरशतैः पार्थो दर्पं तव वधिष्यति।\nतदा त्वमन्तरं द्रष्टा आत्मनश्चार्जुनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2061541, "chapter_id": 2314, "verse_number": "८-३५-८४", "content_sanskrit": "देवासुरमनुष्येषु प्रख्यातौ यौ नरोत्तमौ।\nतौ मावमंस्था मौर्ख्यात्त्वं स्वद्योत इव रोचनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2061542, "chapter_id": 2314, "verse_number": "८-३५-८५", "content_sanskrit": "सूर्याचन्द्रमसौ यद्वत्तद्वदजुनकेशवौ।\nप्रकाश्येनाभिविख्यातौ त्वं तु खद्योतवन्नृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2061543, "chapter_id": 2314, "verse_number": "८-३५-८६", "content_sanskrit": "एवं विद्वन्मावमंस्थाः सूतपुत्राच्युतार्जुनौ।\nनरसिंहौ नरश्वा त्वं जोषमास्स्व विकत्थसे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2061544, "chapter_id": 2314, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि पञ्चत्रिंशोऽध्यायः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]