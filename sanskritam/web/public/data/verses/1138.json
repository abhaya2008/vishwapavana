[{"id": 2007046, "chapter_id": 1138, "verse_number": "१-१३९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007047, "chapter_id": 1138, "verse_number": "१-१३९-१", "content_sanskrit": "दुर्योधनस्तु पापात्मा भीममाशीविषहदे।\nप्रक्षिप्य कृतकृत्यं स्वमात्मानं मन्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007048, "chapter_id": 1138, "verse_number": "१-१३९-२", "content_sanskrit": "प्रभातायां रजन्यां च प्रविवेश पुरं ततः।\nब्रुवाणो भीमसेनस्तु यातो ह्यग्रत एव नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007049, "chapter_id": 1138, "verse_number": "१-१३९-३", "content_sanskrit": "युधिष्ठिरस्तु धर्मात्मा ह्यविदन्पापमात्मनि।\nस्वेनानुमानेन परं साधुं समनुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007050, "chapter_id": 1138, "verse_number": "१-१३९-४", "content_sanskrit": "सोऽभ्युपेत्य तदा पार्थो मातरं भ्रातृवत्सलः।\nअभिवाद्याब्रवीत्कुन्तीमम्ब भीम इहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007051, "chapter_id": 1138, "verse_number": "१-१३९-५", "content_sanskrit": "क्व गतो भविता मातर्नेह पश्यामि तं शुभे।\nउद्यानानि वनं चैव विचितानि समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007052, "chapter_id": 1138, "verse_number": "१-१३९-६", "content_sanskrit": "तदर्थं न च तं वीरं दृष्टवन्तो वृकोदरम्।\nमन्यमानास्ततः सर्वे यातो नः पूर्वमेव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007053, "chapter_id": 1138, "verse_number": "१-१३९-७", "content_sanskrit": "आगताः स्म महाभागे व्याकुलेनान्तरात्मना।\nइहागम्य क्व नु गतस्त्वया वा प्रेषितः क्व नु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007054, "chapter_id": 1138, "verse_number": "१-१३९-८", "content_sanskrit": "कथयस्व महाबाहुं भीमसेनं यशस्विनि।\nनहि मे शुध्यते भावस्तं वीरं प्रति शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007055, "chapter_id": 1138, "verse_number": "१-१३९-९", "content_sanskrit": "यतः प्रसुप्तं मन्येऽहं भीम् नेति हतस्तु सः।\nइत्युक्ता च ततः कुन्ती धर्मराजेन धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007056, "chapter_id": 1138, "verse_number": "१-१३९-१०", "content_sanskrit": "हाहेति कृत्वा संभ्रान्ता प्रत्युवाच युधिष्ठिरम्।\nन पुत्र भीमं पश्यामि न मामभ्येत्यसाविति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007057, "chapter_id": 1138, "verse_number": "१-१३९-११", "content_sanskrit": "शीघ्रमन्वेषणे यत्नं कुरु तस्यानुजैः सह।\nद्रुतं गत्वा पुरोद्यानं विचिन्वन्तिस्म पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007058, "chapter_id": 1138, "verse_number": "१-१३९-१२", "content_sanskrit": "भीमभीमेति ते वाचा पाण्डवाः समुदैरयन्।\nविचिन्वन्तोऽथ ते सर्वे न स्म पश्यन्ति भ्रातरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007059, "chapter_id": 1138, "verse_number": "१-१३९-१३", "content_sanskrit": "आगताः स्वगृहं भूय इदमूचुः पृथां तदा।\nन दृश्यते महाबाहुरम्ब भीमो वने चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007060, "chapter_id": 1138, "verse_number": "१-१३९-१४", "content_sanskrit": "विचितानि च सर्वाणि ह्युद्यानानि नदीस्तथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007061, "chapter_id": 1138, "verse_number": "१-१३९-१४x", "content_sanskrit": "वैशम्पायन उवाच।\nततो विदुरमानाय्य कुन्ती सा स्वं निवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007062, "chapter_id": 1138, "verse_number": "१-१३९-१५", "content_sanskrit": "उवाच बलवान्क्षत्तर्भीमसेनो न दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007063, "chapter_id": 1138, "verse_number": "१-१३९-१६", "content_sanskrit": "उद्यानान्निर्गताः सर्वे भ्रातरो भ्रातृभिः सह।\nतत्रैकस्तु महाबाहुर्भीमो नाभ्येति मामिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007064, "chapter_id": 1138, "verse_number": "१-१३९-१७", "content_sanskrit": "न च प्रीणयते चक्षुः सदा दुर्योधनस्य सः।\nक्रूरोऽसौ दुर्मतिः क्षुद्रो राज्यलुब्धोऽनपत्रपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007065, "chapter_id": 1138, "verse_number": "१-१३९-१८", "content_sanskrit": "निहन्यादपि तं वीरं जातमन्युः सुयोधनः।\nतेन मे व्याकुलं चित्तं हृदयं दह्यतीव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007066, "chapter_id": 1138, "verse_number": "१-१३९-१९x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007067, "chapter_id": 1138, "verse_number": "१-१३९-१९", "content_sanskrit": "मैवं वदस्व कल्याणि शेषसंरक्षणं कुरु।\nप्रत्यादिष्टो हि दुष्टात्मा शेषेऽपि प्रहरेत्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007068, "chapter_id": 1138, "verse_number": "१-१३९-२०", "content_sanskrit": "दीर्घायुषस्तव सुता यथोवाच महामुनिः।\nआगमिष्यति ते पुत्रः प्रीतिं चोत्पादयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007069, "chapter_id": 1138, "verse_number": "१-१३९-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007070, "chapter_id": 1138, "verse_number": "१-१३९-२१", "content_sanskrit": "एवमुक्त्वा ययौ विद्वान्विदुरः स्वं निवेशनम्।\nकुन्ती चिन्तापरा भूत्वा सहासीना सुतैर्गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007071, "chapter_id": 1138, "verse_number": "१-१३९-२२", "content_sanskrit": "ततोऽष्टमे तु दिवसे प्रत्यबुध्यत पाण्डवः।\nतस्मिंस्तदा रसे जीर्णे सोऽप्रमेयबलो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007072, "chapter_id": 1138, "verse_number": "१-१३९-२३", "content_sanskrit": "तं दृष्ट्वा प्रतिबुध्यन्तं पाण्डवं ते भुजङ्गमाः।\nसान्त्वयामासुरव्यग्रा वचनं चेदमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007073, "chapter_id": 1138, "verse_number": "१-१३९-२४", "content_sanskrit": "यत्ते पीतो महाबाहो रसोऽयं वीर्यसंभृतः।\nतस्मान्नागायुतबलो रणेऽधृष्यो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007074, "chapter_id": 1138, "verse_number": "१-१३९-२५", "content_sanskrit": "गच्छाद्य त्वं च स्वगृहं स्नातो दिव्यैरिमैर्जलैः।\nभ्रातरस्तेऽनुतप्यन्ति त्वां विना कुरुपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007075, "chapter_id": 1138, "verse_number": "१-१३९-२६", "content_sanskrit": "ततः स्नातो महाबाहुः शुचिशुक्लाम्बरस्रजः।\nततो नागस्य भवने कृतकौतुकमङ्गलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007076, "chapter_id": 1138, "verse_number": "१-१३९-२७", "content_sanskrit": "ओषधीभिर्विषघ्नीभिः सुरभीभिर्विशेषतः।\nभुक्तवान्परमान्नं च नागैर्दत्तं महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007077, "chapter_id": 1138, "verse_number": "१-१३९-२८", "content_sanskrit": "पूजितो भुजगैर्वीर आशीर्भिश्चाभिनन्दितः।\nदिव्याभरणसंछन्नो नागानामन्त्र्य पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007078, "chapter_id": 1138, "verse_number": "१-१३९-२९", "content_sanskrit": "उदतिष्ठत्प्रहृष्टात्मा नागलोकादरिन्दमः।\nउत्क्षिप्य च तदा नागैर्जलाज्जलरुहेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007079, "chapter_id": 1138, "verse_number": "१-१३९-३०", "content_sanskrit": "तस्मिन्नेव वनोद्देशे स्थापितः कुरुनन्दनः।\nते चान्तर्दधिरे नागाः पाण्डवस्यैव पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007080, "chapter_id": 1138, "verse_number": "१-१३९-३१", "content_sanskrit": "तत उत्थाय कौन्तेयो भीमसेनो महाबलः।\nआजगाम महाबाहुर्मातुरन्तिकमञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007081, "chapter_id": 1138, "verse_number": "१-१३९-३२", "content_sanskrit": "ततोऽभिवाद्य जननीं ज्येष्ठं भ्रातरमेव च।\nकनीयसः समाघ्राय शिरस्स्वरिविमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007082, "chapter_id": 1138, "verse_number": "१-१३९-३३", "content_sanskrit": "तैश्चापि संपरिष्वक्तः सह मात्रा नरर्षभैः।\nअन्योन्यगतसौहार्दाद्दिष्ट्या दिष्ट्येति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007083, "chapter_id": 1138, "verse_number": "१-१३९-३४", "content_sanskrit": "ततस्तत्सर्वमाचष्ट दुर्योधनविचेष्टितम्।\nभ्रातॄणां भीमसेनश्च महाबलपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007084, "chapter_id": 1138, "verse_number": "१-१३९-३५", "content_sanskrit": "नागलोके च यद्वृत्तं गुणदोषमशेषतः।\nतच्च सर्वमशेषेण कथयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007085, "chapter_id": 1138, "verse_number": "१-१३९-३६", "content_sanskrit": "ततो युधिष्ठिरो राजा भीममाह वचोऽर्थवत्।\nतूष्णीं भव न ते जल्प्यमिदं कार्यं कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007086, "chapter_id": 1138, "verse_number": "१-१३९-३७", "content_sanskrit": "इतःप्रभृति कौन्तेयं रक्षतान्योन्यमादृताः।\nएवमुक्त्वा महाबाहुर्धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007087, "chapter_id": 1138, "verse_number": "१-१३९-३८", "content_sanskrit": "भ्रातृभिः सहितः सर्वैरप्रमत्तोऽभवत्तदा।\nयदा त्ववगतास्ते वै पाण्डवास्तस्य कर्म तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007088, "chapter_id": 1138, "verse_number": "१-१३९-३९", "content_sanskrit": "नत्वेव बहुलं चक्रुः प्रयता मन्त्ररक्षणे।\nधर्मात्मा विदुरस्तेषां प्रददौ मतिमान्मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007089, "chapter_id": 1138, "verse_number": "१-१३९-४०", "content_sanskrit": "दुर्योधनोऽपि तं दृष्ट्वा पाण्डवं पुनरागतम्।\nनिश्वसंश्चिन्तयंश्चैवमहन्यहनि तप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007090, "chapter_id": 1138, "verse_number": "१-१३९-४१", "content_sanskrit": "कुमारान्क्रीडमानांस्तान्दृष्ट्वा राजातिदुर्मदान्।\nगुरुं शिक्षार्थमन्विष्य गौतमं तान्न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007091, "chapter_id": 1138, "verse_number": "१-१३९-४२", "content_sanskrit": "शरस्तम्बे समुद्भूतं वेदशास्त्रार्थपारगम्।\nराज्ञा निवेदितास्तस्मै ते च सर्वे च निष्ठिताः।\nअधिजग्मुश्च कुरवो धनुर्वेदं कृपात्तु ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007092, "chapter_id": 1138, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि ऊनचत्वारिंशदधिकशततमोऽध्यायः॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]