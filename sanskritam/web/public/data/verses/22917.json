[{"id": 7002917000, "chapter_id": 22917, "verse_number": "९-२०२-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअथातः संप्रवक्ष्यामि रत्नाचलमनुत्तमम् ।\nयत्प्रदानान्नरो याति लोकान्सप्तर्षिसेवितान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002917001, "chapter_id": 22917, "verse_number": "९-२०२-२", "content_sanskrit": "मुक्ताफलसहस्रेण पर्वतः स्यादनुत्तमः ।\nमध्यमः पञ्चशतिकस्त्रिशतेनावरः स्मृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002917002, "chapter_id": 22917, "verse_number": "९-२०२-३", "content_sanskrit": "अल्पवित्तस्तु कुर्वीत मुक्ताफलशतेन च ।\nचतुर्थांशेन विष्कंभपर्वताः स्युः समंततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002917003, "chapter_id": 22917, "verse_number": "९-२०२-४", "content_sanskrit": "पूर्वेणवज्रगोमेदैर्दक्षिणेनेंद्रनीलकैः ।\nपुष्परागयुतः कार्यो विद्वद्भिर्गंधमादनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002917004, "chapter_id": 22917, "verse_number": "९-२०२-५", "content_sanskrit": "वैडूर्यविद्रुमैः पश्चात्सावित्रो विपुलाचलः ।\nपद्मरागं ससौवर्णमुत्तरेणापि विन्यसेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002917005, "chapter_id": 22917, "verse_number": "९-२०२-६", "content_sanskrit": "धान्यपर्वतवच्छेषमत्रापि परिकल्पयेत् ।\nतद्वदावाहनं कृत्वा वृक्षान्देवांश्च कांचनाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002917006, "chapter_id": 22917, "verse_number": "९-२०२-७", "content_sanskrit": "पूजयेत्पुष्पनैवेद्यैः प्रभाते तु विसर्जनम् ।\nपूर्ववद्गुरुऋत्विग्भ्यां इमान्मंत्रानुदीरयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002917007, "chapter_id": 22917, "verse_number": "९-२०२-८", "content_sanskrit": "यथा देवगणाः सर्वे सर्वरत्नेष्ववस्थिताः ।\nत्वं च रत्नमयो नित्यमतः पाहि महाचल ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002917008, "chapter_id": 22917, "verse_number": "९-२०२-९", "content_sanskrit": "यस्माद्रत्नप्रदानेन तुष्टिमेति जनार्दनः ।\nपूजारत्नप्रदानेन तस्मान्नः पाहि सर्वदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002917009, "chapter_id": 22917, "verse_number": "९-२०२-१०", "content_sanskrit": "अनेन विधिना यस्तु दद्याद्रत्नमयं गिरिम् ।\nस याति वैष्णवं लोकममरेश्वरपूजितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002917010, "chapter_id": 22917, "verse_number": "९-२०२-११", "content_sanskrit": "यावत्कल्पशतं साग्रमुषित्वेह नराधिप ।\nरूपारोग्यगुणोपेतः सप्तद्वीपाधिपो भवेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002917011, "chapter_id": 22917, "verse_number": "९-२०२-१२", "content_sanskrit": "ब्रह्महत्यादिकं किंचिदत्र चामुत्र वा कृतम् ।\nतत्सर्वं नाशमायाति गिरिर्वज्रहतो यथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002917012, "chapter_id": 22917, "verse_number": "९-२०२-१३", "content_sanskrit": "मुक्तामयं कनकविद्रुमभक्तिचित्रं चंचन्महामणिमरीचिचयोपपन्नम् ।\nरत्नाचलं द्विजवराय निवेदयित्वा भास्वत्प्रभामभिभवेत्सुरलोकलोके ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]