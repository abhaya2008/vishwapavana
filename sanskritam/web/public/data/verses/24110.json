[{"id": 7004110000, "chapter_id": 24110, "verse_number": "४-५९-१", "content_sanskrit": "अगस्त्य उवाच ।\nसर्वज्ञ हृदयानंद गौरीचुंबितमूर्धज ।\nतारकांतक षड्वक्त्र तारिणे भद्रकारिणे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004110001, "chapter_id": 24110, "verse_number": "४-५९-२", "content_sanskrit": "सर्वज्ञाननिधे तुभ्यं नमः सर्वज्ञसूनवे ।\nसर्वथा जितमाराय कुमाराय महात्मने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004110002, "chapter_id": 24110, "verse_number": "४-५९-३", "content_sanskrit": "कामारिमर्धनारीशं वीक्ष्य कामकृतं किल ।\nयो जिगाय कुमारोपि मारं तस्मै नमोस्तु ते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004110003, "chapter_id": 24110, "verse_number": "४-५९-४", "content_sanskrit": "यदुक्तं भवता स्कंद मायाद्विजवपुर्हरिः ।\nकाश्यां पंचनदं तीर्थमध्यासातीव पावनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004110004, "chapter_id": 24110, "verse_number": "४-५९-५", "content_sanskrit": "भूर्भुवःस्वः प्रदेशेषु काशीपरमपावनम् ।\nतत्रापि हरिणाज्ञायि तीर्थं पंचनदं परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004110005, "chapter_id": 24110, "verse_number": "४-५९-६", "content_sanskrit": "कुतः पंचनदं नाम तस्य तीर्थस्य षण्मुख ।\nकुतश्च सर्वतीर्थेभ्यस्तदासीत्पावनं परम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004110006, "chapter_id": 24110, "verse_number": "४-५९-७", "content_sanskrit": "कथं च भगवान्विष्णुरंतरात्मा जगत्पतिः ।\nसर्वेषां जगतां पाता कर्ता हर्ता च लीलया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004110007, "chapter_id": 24110, "verse_number": "४-५९-८", "content_sanskrit": "अरूपो रूपमापन्नो ह्यव्यक्तो व्यक्ततां गतः ।\nनिराकारोपि साकारो निष्प्रपंचः प्रपंचभाक् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004110008, "chapter_id": 24110, "verse_number": "४-५९-९", "content_sanskrit": "अजन्मानेकजन्मा च त्वनामास्फुटनामभृत् ।\nनिरालंबोऽखिलालंबो निर्गुणोपि गुणास्पदम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004110009, "chapter_id": 24110, "verse_number": "४-५९-१०", "content_sanskrit": "अहृषीकोहृषीकेशो प्यनंघ्रिरपिसर्वगः ।\nउपसंहृत्य रूपं स्वं सर्वव्यापी जनार्दनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004110010, "chapter_id": 24110, "verse_number": "४-५९-११", "content_sanskrit": "स्थितः सर्वात्मभावेन तीर्थे पंचनदे परे ।\nएतदाख्याहि षड्वक्त्र पंचवक्त्राद्यथा श्रुतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004110011, "chapter_id": 24110, "verse_number": "४-५९-१२", "content_sanskrit": "स्कंद उवाच ।\nकथयामि कथामेतां नमस्कृत्य महेश्वरम् ।\nसर्वाघौघ प्रशमनीं सर्वश्रेयोविधायिनीम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004110012, "chapter_id": 24110, "verse_number": "४-५९-१३", "content_sanskrit": "यथा पंचनदं तीर्थं काश्यां प्रथितिमागतम् ।\nयन्नामग्रहणादेव पापं याति सहस्रधा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004110013, "chapter_id": 24110, "verse_number": "४-५९-१४", "content_sanskrit": "प्रयागोपि च तीर्थेशो यत्र साक्षात्स्वयं स्थितः ।\nपापिनां पापसंघातं प्रसह्य निजतेजसा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004110014, "chapter_id": 24110, "verse_number": "४-५९-१५", "content_sanskrit": "हरंति सर्वतीर्थानि प्रयागस्य बलेन हि ।\nतानि सर्वाणि तीर्थानि माघे मकरगे रवौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004110015, "chapter_id": 24110, "verse_number": "४-५९-१६", "content_sanskrit": "प्रत्यब्दं निर्मलानि स्युस्तीर्थराज समागमात् ।\nप्रयागश्चापि तीर्थेंद्रः सर्वतीर्थार्पितं मलम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004110016, "chapter_id": 24110, "verse_number": "४-५९-१७", "content_sanskrit": "महाघिनां महाघं च हरेत्पांचनदाद्बलात् ।\nयं संचयति पापौघमावर्षं तीर्थनायकः ।\nतमेकमज्जनादूर्जे त्यजेत्पंचनदे ध्रुवम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004110017, "chapter_id": 24110, "verse_number": "४-५९-१८", "content_sanskrit": "यथा पंचनदोत्पत्तिस्तथा च कथयाम्यहम् ।\nनिशामय महाभाग मित्रावरुणनंदन ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004110018, "chapter_id": 24110, "verse_number": "४-५९-१९", "content_sanskrit": "पुरा वेदशिरा नाम मुनिरासीन्महातपाः ।\nभृगुवंश समुत्पन्नो मूर्तो वेद इवापरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004110019, "chapter_id": 24110, "verse_number": "४-५९-२०", "content_sanskrit": "तपस्यतस्तस्य मुनेः पुरोदृग्गोचरं गता ।\nशुचिरप्सरसां श्रेष्ठा रूपलावण्यशालिनी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004110020, "chapter_id": 24110, "verse_number": "४-५९-२१", "content_sanskrit": "तस्या दर्शनमात्रेण परिक्षुब्धं मुनेर्मनः ।\nचस्कंद स मुनिस्तूर्णं साथ भीता वराप्सराः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004110021, "chapter_id": 24110, "verse_number": "४-५९-२२", "content_sanskrit": "दूरादेव नमस्कृत्य तमृषिं साभ्यभाषत ।\nअतीव वेपमानांगी शुचिस्तच्छापभीतितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004110022, "chapter_id": 24110, "verse_number": "४-५९-२३", "content_sanskrit": "नापराध्नोम्यहं किंचिन्महोग्रतपसांनिधे ।\nक्षंतव्यं मे क्षमाधार क्षमारूपास्तपस्विनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004110023, "chapter_id": 24110, "verse_number": "४-५९-२४", "content_sanskrit": "मुनीनां मानसं प्रायो यत्पद्मादपि तन्मृदु ।\nस्त्रियः कठोरहृदयाः स्वरूपेणैव सत्तम ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004110024, "chapter_id": 24110, "verse_number": "४-५९-२५", "content_sanskrit": "इति श्रुत्वा वचस्तस्याः शुचेरप्सरसो मुनिः ।\nविवेकसेतुना स्तंभीन्महारोषनदीरयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004110025, "chapter_id": 24110, "verse_number": "४-५९-२६", "content_sanskrit": "उवाच च प्रसन्नात्मा शुचे शुचिरसि ध्रुवम् ।\nन मेऽल्पोपि हि दोषोत्र न ते दोषोस्ति सुंदरि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004110026, "chapter_id": 24110, "verse_number": "४-५९-२७", "content_sanskrit": "वह्निस्वरूपा ललना नवनीत समः पुमान् ।\nअनभिज्ञा वदंतीति विचारान्महदंतरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004110027, "chapter_id": 24110, "verse_number": "४-५९-२८", "content_sanskrit": "स्निह्येदुद्धृतसारोपि वह्नेः संस्पर्शमाप्य वै ।\nचित्रं स्त्र्याख्या समादानात्पुमान्स्निह्यति दूरतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004110028, "chapter_id": 24110, "verse_number": "४-५९-२९", "content_sanskrit": "अतः शुचे न भेतव्यं त्वया शुचि मनोगते ।\nअतर्कितोपस्थितया त्वया च स्खलितं मया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004110029, "chapter_id": 24110, "verse_number": "४-५९-३०", "content_sanskrit": "स्खलनान्न तथा हानिरकामात्तपसो मुनेः ।\nयथा क्षणांधीकरणाद्धानिः कोपरयादरेः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004110030, "chapter_id": 24110, "verse_number": "४-५९-३१", "content_sanskrit": "कोपात्तपः क्षयं याति संचितं यत्सुकृच्छ्रतः ।\nयथाभ्रपटलं प्राप्य प्रकाशः पुष्पवंतयोः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004110031, "chapter_id": 24110, "verse_number": "४-५९-३२", "content_sanskrit": "अनर्थकारिणः क्रोधात्क्वार्थानांपरिजृभणम् ।\nक्व वा खलजनोत्सेधात्साधूनां परिवर्धनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004110032, "chapter_id": 24110, "verse_number": "४-५९-३३", "content_sanskrit": "अमर्षे कर्षति मनो मनोभू संभवः कुतः ।\nविधुंतुदे तुदत्युच्चैर्विधुं कुत्रास्ति कौमुदी ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004110033, "chapter_id": 24110, "verse_number": "४-५९-३४", "content_sanskrit": "ज्वलतो रोषदावाग्नेः क्व वा शांतितरोः स्थितिः ।\nदृष्टा केनापि किं क्वापि सिंहात्कलभसुस्थता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004110034, "chapter_id": 24110, "verse_number": "४-५९-३५", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन प्रतीपः प्रतिघातुकः ।\nचतुर्वर्गस्य देहस्य परिहेयो विपश्चिता ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004110035, "chapter_id": 24110, "verse_number": "४-५९-३६", "content_sanskrit": "इदानीं शृणु कल्याणि कर्तव्यं यत्त्वया शुचे ।\nअमोघबीजा हि वयं तद्बीजमुररी कुरु ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004110036, "chapter_id": 24110, "verse_number": "४-५९-३७", "content_sanskrit": "एतस्मिन्रक्षिते वीर्ये परिस्कन्ने त्वदीक्षणात्॥ त्वया तव भवित्रेकं कन्यारत्नं महाशुचि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004110037, "chapter_id": 24110, "verse_number": "४-५९-३८", "content_sanskrit": "इत्युक्ता तेन मुनिना पुनर्जातेव साप्सराः ।\nमहाप्रसाद इत्युक्त्वा मुनेः शुक्रमजीगिलत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004110038, "chapter_id": 24110, "verse_number": "४-५९-३९", "content_sanskrit": "अथ कालेन दिव्यस्त्री कन्यारत्नमजीजनत् ।\nअतीव नयनानंदि निधानं रूपसंपदाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004110039, "chapter_id": 24110, "verse_number": "४-५९-४०", "content_sanskrit": "तस्यैव वेदशिरस आश्रमे तां निधाय सा ।\nशुचिरप्सरसां श्रेष्ठा जगाम च यथेप्सितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004110040, "chapter_id": 24110, "verse_number": "४-५९-४१", "content_sanskrit": "तां च वेदशिराः कन्यां स्नेहेन समवर्धयत् ।\nक्षीरेण स्वाश्रमस्थाया हरिण्या हरिणीक्षणाम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004110041, "chapter_id": 24110, "verse_number": "४-५९-४२", "content_sanskrit": "मुनिर्नाम ददौ तस्यै धूतपापेति चार्थवत् ।\nयन्नामोच्चारणेनापि कंपते पातकावली ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004110042, "chapter_id": 24110, "verse_number": "४-५९-४३", "content_sanskrit": "सर्वलक्षणशोभाढ्यां सर्वावयव सुंदरीम् ।\nमुनिस्तत्याज नोत्संगात्क्षणमात्रमपि क्वचित् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004110043, "chapter_id": 24110, "verse_number": "४-५९-४४", "content_sanskrit": "दिनेदिने वर्धमानां तां पश्यन्मुमुदे भृशम् ।\nक्षीरनीरधिवद्रम्यां निशि चांद्रमसीं कलाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004110044, "chapter_id": 24110, "verse_number": "४-५९-४५", "content_sanskrit": "अथाष्टवार्षिकीं दृष्ट्वा तां कन्यां स मुनीश्वरः ।\nकस्मै देयेति संचित्य तामेव समपृच्छत ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004110045, "chapter_id": 24110, "verse_number": "४-५९-४६", "content_sanskrit": "वेदशिरा उवाच ।\nअयि पुत्रि महाभागे धूतपापे शुभेक्षणे ।\nकस्मै दद्यावराय त्वां त्वमेवाख्याहि तं वरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004110046, "chapter_id": 24110, "verse_number": "४-५९-४७", "content_sanskrit": "अतिस्नेहार्द्रचित्तस्य जनेतुश्चेति भाषितम् ।\nनिशम्य धूतपापा सा प्रोवाच विनतानना ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004110047, "chapter_id": 24110, "verse_number": "४-५९-४८", "content_sanskrit": "धूतपापोवाच ।\nजनेतर्यद्यहं देया सुंदराय वराय ते ।\nतदा तस्मै प्रयच्छ त्वं यमहं कथयामि ते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004110048, "chapter_id": 24110, "verse_number": "४-५९-४९", "content_sanskrit": "तुभ्यं च रोचते तात शृणोत्ववहितो भवान् ।\nसर्वेभ्योतिपवित्रो यो यः सर्वेषां नमस्कृतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004110049, "chapter_id": 24110, "verse_number": "४-५९-५०", "content_sanskrit": "सर्वे यमभिलष्यंति यस्मात्सर्वसुखोदयः ।\nकदाचिद्यो न नश्येत यः सदैवानुवर्तते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004110050, "chapter_id": 24110, "verse_number": "४-५९-५१", "content_sanskrit": "इहामुत्रापि यो रक्षेन्महापदुदयाद्ध्रुवम् ।\nसर्वे मनोरथा यस्मात्परिपूर्णा भवंति हि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004110051, "chapter_id": 24110, "verse_number": "४-५९-५२", "content_sanskrit": "दिनेदिने च सौभाग्यं वर्धते यस्य सन्निधौ ।\nनैरंतर्येण यत्सेवां कुर्वतो न भयं क्वचित् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004110052, "chapter_id": 24110, "verse_number": "४-५९-५३", "content_sanskrit": "यन्नामग्रहणादेव केपि वाधां न कुर्वते ।\nयदाधारेण तिष्ठंति भुवनानि चतुर्दश ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004110053, "chapter_id": 24110, "verse_number": "४-५९-५४", "content_sanskrit": "एवमाद्या गुणा यस्य वरस्य वरचेष्टितम् ।\nतस्मै प्रयच्छ मां तात मम तेपीहशर्मणे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004110054, "chapter_id": 24110, "verse_number": "४-५९-५५", "content_sanskrit": "एतच्छ्रुत्वापि ता तस्या भृशं मुदमवाप ह ।\nधन्योस्मि धन्या मे पूर्वे येषामैषा सुतान्वये ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004110055, "chapter_id": 24110, "verse_number": "४-५९-५६", "content_sanskrit": "ध्रुवा हि धूतपापासौ यस्या ईदृग्विधा मतिः ।\nईदृग्विधैर्गुणगणैर्गरिम्णा कोत्र वै भवेत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004110056, "chapter_id": 24110, "verse_number": "४-५९-५७", "content_sanskrit": "अथवा स कथं लभ्यो विना पुण्यभरोदयम् ।\nइति क्षणं समाधाय मनः स मुनिपुंगवः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004110057, "chapter_id": 24110, "verse_number": "४-५९-५८", "content_sanskrit": "ज्ञानेन तं समालोच्य वरमीदृग्गुणोदयम् ।\nधन्यां कन्यां बभाषेथ शृणु वत्से शुभैषिणि ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004110058, "chapter_id": 24110, "verse_number": "४-५९-५९", "content_sanskrit": "पितोवाच ।\nवरस्य ये त्वया प्रोक्ता गुणा एते विचक्षणे ।\nएषां गुणानामाधारो वरोस्तीति विनिश्चितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004110059, "chapter_id": 24110, "verse_number": "४-५९-६०", "content_sanskrit": "परं स सुखलभ्यो न नितरां सुभगाकृतिः ।\nतपः पणेन स क्रय्यः सुतीर्थविपणौ क्वचित् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004110060, "chapter_id": 24110, "verse_number": "४-५९-६१", "content_sanskrit": "तीर्थभारैः स सुलभो न कौलीन्येन कन्यके ।\nन वेदशास्त्राभ्यसनैर्न चैश्वर्यबलेन वै ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004110061, "chapter_id": 24110, "verse_number": "४-५९-६२", "content_sanskrit": "न सौंदर्येण वपुषा न बुद्ध्या न पराक्रमैः ।\nएकयैव मनः शुद्ध्या करणानां जयेन च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004110062, "chapter_id": 24110, "verse_number": "४-५९-६३", "content_sanskrit": "महातपः सहायेन दमदानदयायुजा ।\nलभ्यते स महाप्राज्ञो नान्यथा सदृशः पतिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004110063, "chapter_id": 24110, "verse_number": "४-५९-६४", "content_sanskrit": "इति श्रुत्वाथ सा कन्या पितरं प्रणिपत्य च ।\nअनुज्ञां प्रार्थयामास तपसे कृतनिश्चया ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004110064, "chapter_id": 24110, "verse_number": "४-५९-६५", "content_sanskrit": "स्कंद उवाच ।\nकृतानुज्ञा जनेत्रा सा क्षेत्रे परमपावने ।\nतपस्तताप परमं यदसाध्यं तपस्विभिः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004110065, "chapter_id": 24110, "verse_number": "४-५९-६६", "content_sanskrit": "क्व सा बालातिमृद्वंगी क्व च तत्तादृशं तपः ।\nकठोरवर्ष्मसंसाध्यमहो सच्चेतसो धृतिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004110066, "chapter_id": 24110, "verse_number": "४-५९-६७", "content_sanskrit": "धारासारा सुवर्षासु महावातवतीष्वलम् ।\nशिलासु सावकाशासु सा बह्वीरनयन्निशाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004110067, "chapter_id": 24110, "verse_number": "४-५९-६८", "content_sanskrit": "श्रुत्वा गर्जरवं घोरं दृष्ट्वा विद्युच्चमत्कृतीः ।\nआसारसीकरैः क्लिन्ना न चकंपे मनाक्च सा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004110068, "chapter_id": 24110, "verse_number": "४-५९-६९", "content_sanskrit": "तडित्स्फुरंतीत्वसकृत्तमिस्रासु तपोवने ।\nयातायातं करोतीव द्रष्टुं तत्तपसः स्थितिम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004110069, "chapter_id": 24110, "verse_number": "४-५९-७०", "content_sanskrit": "तपर्तुरेव साक्षाच्च कुमारी कैतवात्किल ।\nपंचाग्नीन्परिधायात्र तपस्यति तपोवने ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004110070, "chapter_id": 24110, "verse_number": "४-५९-७१", "content_sanskrit": "जलाभिलाषिणी बाला न मनागपि सा पिबत् ।\nकुशाग्रतोयपृषतं पंचाग्निपरितापिता ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004110071, "chapter_id": 24110, "verse_number": "४-५९-७२", "content_sanskrit": "रोमांच कंचुकवती वेपमानतनुच्छदा ।\nपर्यक्षिपत्क्षपाः क्षामा तपसा हैमनीश्च सा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004110072, "chapter_id": 24110, "verse_number": "४-५९-७३", "content_sanskrit": "निशीथिनीषु शिशिरे श्रयंती सारसं रसम् ।\nमेने सा सारसैः केयमुद्यताद्येति पद्मिनी ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004110073, "chapter_id": 24110, "verse_number": "४-५९-७४", "content_sanskrit": "मनस्विनामपि मनोरागतां सृजते मधौ ।\nतदोष्ठपल्लवाद्रागो जह्रे माकंदपल्लवैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004110074, "chapter_id": 24110, "verse_number": "४-५९-७५", "content_sanskrit": "वसंते निवसंती सा वने बालाचलंमनः ।\nचक्रे तपस्यपि श्रुत्वा कोकिला काकलीरवम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004110075, "chapter_id": 24110, "verse_number": "४-५९-७६", "content_sanskrit": "बंधुजीवेऽधररुचिं कलहंसे कलागतीः ।\nनिक्षेपमिव सा क्षिप्त्वा शरद्यासीत्तपोरता ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004110076, "chapter_id": 24110, "verse_number": "४-५९-७७", "content_sanskrit": "अपास्तभोगसंपर्का भोगिनां वृत्तिमाश्रिता ।\nक्षुदुद्बोधनिरोधाय धूतपापा तपस्विनी ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004110077, "chapter_id": 24110, "verse_number": "४-५९-७८", "content_sanskrit": "शाणेन मणिवल्लीढा कृशाप्यायादनर्घताम् ।\nतथापि तपसा क्षामा दिदीपे तत्तनुस्तराम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004110078, "chapter_id": 24110, "verse_number": "४-५९-७९", "content_sanskrit": "निरीक्ष्य तां तपस्यंतीं विधिः संशुद्धमानसाम् ।\nउपेत्योवाच सुप्रज्ञे प्रसन्नोस्मि वरं वृणु ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004110079, "chapter_id": 24110, "verse_number": "४-५९-८०", "content_sanskrit": "सा चतुर्वक्त्रमालोक्य हंसयानोपरिस्थितम् ।\nप्रणम्य प्रांजलिः प्रीता प्रोवाचाथ प्रजापतिम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004110080, "chapter_id": 24110, "verse_number": "४-५९-८१", "content_sanskrit": "धूतपापोवाच ।\nपितामह वरो मह्यं यदि देयो वरप्रद ।\nसर्वेभ्यः पावनेभ्योपि कुरु मामतिपावनीम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004110081, "chapter_id": 24110, "verse_number": "४-५९-८२", "content_sanskrit": "स्रष्टा तदिष्टमाकर्ण्य नितरां तुष्टमानसः ।\nप्रत्युवाचाथ तां बालां विमलां विमलेषिणीम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004110082, "chapter_id": 24110, "verse_number": "४-५९-८३", "content_sanskrit": "ब्रह्मोवाच ।\nधूतपापे पवित्राणि यानि संत्यत्र सर्वतः ।\nतेभ्यः पवित्रमतुलं त्वमेधि वरतो मम ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004110083, "chapter_id": 24110, "verse_number": "४-५९-८४", "content_sanskrit": "तिस्रः कोट्योऽर्धकोटी च संति तीर्थानि कन्यके ।\nदिवि भुव्यंतरिक्षे च पावनान्युत्तरोत्तरम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004110084, "chapter_id": 24110, "verse_number": "४-५९-८५", "content_sanskrit": "तानि सर्वाणि तीर्थानि त्वत्तनौ प्रतिलोम वै ।\nवसंतु मम वाक्येन भव सर्वातिपावनी ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004110085, "chapter_id": 24110, "verse_number": "४-५९-८६", "content_sanskrit": "इत्युक्त्वांतर्दधे वेधाः सापि निर्धूतकल्मषा ।\nधूतपापोटजं प्राप्ताथो वेदशिरसः पितुः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004110086, "chapter_id": 24110, "verse_number": "४-५९-८७", "content_sanskrit": "कदाचित्तां समालोक्य खेलंतीमुटजाजिरे ।\nधर्मस्तत्तपसाकृष्टः प्रार्थयामास कन्यकाम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004110087, "chapter_id": 24110, "verse_number": "४-५९-८८", "content_sanskrit": "धर्म उवाच ।\nपृथुश्रोणि विशालाक्षि क्षामोदरि शुभानने ।\nक्रीतः स्वरूपसंपत्त्या त्वयाहं देहि मे रहः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004110088, "chapter_id": 24110, "verse_number": "४-५९-८९", "content_sanskrit": "नितरां बाधते कामस्त्वत्कृते मां सुलोचने ।\nअज्ञातनाम्ना सा तेन प्रार्थितेत्यसकृद्ग्रहः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004110089, "chapter_id": 24110, "verse_number": "४-५९-९०", "content_sanskrit": "उवाच सा पिता दाता तं प्रार्थय सुदुर्मते ।\nपितृप्रदेया यत्कन्या श्रुतिरेषा सनातनी ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004110090, "chapter_id": 24110, "verse_number": "४-५९-९१", "content_sanskrit": "निशम्येति वचो धर्मो भाविनोर्थस्य गौरवात् ।\nपुनर्निबंधयांचक्रे ऽपधृतिर्धृतिशालिनीम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004110091, "chapter_id": 24110, "verse_number": "४-५९-९२", "content_sanskrit": "धर्म उवाच ।\nन प्रार्थयेहं सुभगे पितरं तव सुंदरि ।\nगांधर्वेण विवाहेन कुरु मे त्वं समीहितम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004110092, "chapter_id": 24110, "verse_number": "४-५९-९३", "content_sanskrit": "इति निर्बंधवद्वाक्यं सा निशम्य कुमारिका ।\nपितुः कन्याफलंदित्सुः पुनराहेति तं द्विजम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004110093, "chapter_id": 24110, "verse_number": "४-५९-९४", "content_sanskrit": "अरे जडमते मा त्वं पुनर्ब्रूहीति याह्यतः ।\nइत्युक्तोपि कुमार्या स नातिष्ठन्मदनातुरः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004110094, "chapter_id": 24110, "verse_number": "४-५९-९५", "content_sanskrit": "ततः शशाप तं बाला प्रबला तपसो बलात् ।\nजडोसि नितरां यस्माज्जलाधारो नदो भव ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004110095, "chapter_id": 24110, "verse_number": "४-५९-९६", "content_sanskrit": "इति शप्तस्तया सोथ तां शशाप क्रुधान्वितः ।\nकठोरहृदये त्वं तु शिला भव सुदुर्मते ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004110096, "chapter_id": 24110, "verse_number": "४-५९-९७", "content_sanskrit": "स्कंद उवाच ।\nइत्यन्योन्यस्य शापेन मुने धर्मो नदोऽभवत् ।\nअविमुक्ते महाक्षेत्रे ख्यातो धर्मनदो महान् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004110097, "chapter_id": 24110, "verse_number": "४-५९-९८", "content_sanskrit": "साप्याह पितरं त्रस्ता स्वशिलात्वस्य कारणम् ।\nध्यानेन धर्मं विज्ञाय मुनिः कन्यामथाब्रवीत् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004110098, "chapter_id": 24110, "verse_number": "४-५९-९९", "content_sanskrit": "मा भैः पुत्रि करिष्यामि तव सर्वं शुभोदयम् ।\nतच्छापो नान्यथा भूयाच्चंद्रकांतशिला भव ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004110099, "chapter_id": 24110, "verse_number": "४-५९-१००", "content_sanskrit": "चंद्रोदयमनुप्राप्य द्रवीभूततनुस्ततः ।\nधुनी भव सुते साध्वि धूतपापेति विश्रुता ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004110100, "chapter_id": 24110, "verse_number": "४-५९-१०१", "content_sanskrit": "स च धर्मनदः कन्ये तव भर्ता सुशोभनः ।\nतैर्गुणैः परिपूर्णांगो ये गुणाः प्रार्थितास्त्वया ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004110101, "chapter_id": 24110, "verse_number": "४-५९-१०२", "content_sanskrit": "अन्यच्च शृणु सद्बुद्धे ममापि तपसो बलात् ।\nद्वैरूप्यं भवतोर्भावि प्राकृतं च द्रवं च वै ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004110102, "chapter_id": 24110, "verse_number": "४-५९-१०३", "content_sanskrit": "इत्याश्वास्य पिता कन्यां धूतपापां परंतप ।\nचंद्रकांतशिलाभूतामनुजग्राह बुद्धिमान् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004110103, "chapter_id": 24110, "verse_number": "४-५९-१०४", "content_sanskrit": "तदारभ्य मुने काश्यां ख्यातो धर्मनदो ह्रदः ।\nधर्मो द्रवस्वरूपेण महापातकनाशनः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004110104, "chapter_id": 24110, "verse_number": "४-५९-१०५", "content_sanskrit": "धुनी च धूतपापा सा सर्वतीर्थमयी शुभा ।\nहरेन्महाघसंघातान्कूलजानिव पादपान् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004110105, "chapter_id": 24110, "verse_number": "४-५९-१०६", "content_sanskrit": "तत्र धर्मनदे तीर्थे धूतपापा समन्विते ।\nयदा न स्वर्धुनी तत्र तदा ब्रध्नस्तपो व्यधात् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004110106, "chapter_id": 24110, "verse_number": "४-५९-१०७", "content_sanskrit": "गभस्तिमाली भगवान्गभस्तीश्वर सन्निधौ ।\nशीलयन्मंगलां गौरीं तप उग्रं चचार ह ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004110107, "chapter_id": 24110, "verse_number": "४-५९-१०८", "content_sanskrit": "नाम्ना मयूखादित्यस्य तीर्थे तत्र तपस्यतः ।\nकिरणेभ्यः प्रववृते महास्वेदोतिखेदतः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004110108, "chapter_id": 24110, "verse_number": "४-५९-१०९", "content_sanskrit": "किरणेभ्यः प्रवृत्ताया महास्वेदस्य संततिः ।\nततः सा किरणानाम जाता पुण्या तरंगिणी ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004110109, "chapter_id": 24110, "verse_number": "४-५९-११०", "content_sanskrit": "महापापांधतमसं किरणाख्या तरंगिणी ।\nध्वंसयेत्स्नानमात्रेण मिलिता धूतपापया ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004110110, "chapter_id": 24110, "verse_number": "४-५९-१११", "content_sanskrit": "आदौ धर्मनदः पुण्यो मिश्रितो धूतपापया ।\nयया धूतानि पापानि सर्वतीर्थीकृतात्मना ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004110111, "chapter_id": 24110, "verse_number": "४-५९-११२", "content_sanskrit": "ततोपि मिलितागत्य किरणा रविणैधिता ।\nयन्नामस्मरणादेव महामोहोंधतां व्रजेत् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004110112, "chapter_id": 24110, "verse_number": "४-५९-११३", "content_sanskrit": "किरणा धूतपापे च तस्मिन्धर्मनदे शुभे ।\nस्रवंत्यौ पापसंहर्त्र्यौ वाराणस्यां शुभद्रवे ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004110113, "chapter_id": 24110, "verse_number": "४-५९-११४", "content_sanskrit": "ततो भागीरथी प्राप्ता तेन दैलीपिना सह ।\nभागीरथी समायाता यमुना च सरस्वती ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004110114, "chapter_id": 24110, "verse_number": "४-५९-११५", "content_sanskrit": "किरणा धूतपापा च पुण्यतोया सरस्वती ।\nगंगा च यमुना चैव पंचनद्योत्र कीर्तिताः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004110115, "chapter_id": 24110, "verse_number": "४-५९-११६", "content_sanskrit": "अतः पंचनदं नाम तीर्थं त्रैलोक्यविश्रुतम् ।\nतत्राप्लुतो न गृह्णीयाद्देहं ना पांचभौतिकम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004110116, "chapter_id": 24110, "verse_number": "४-५९-११७", "content_sanskrit": "अस्मिन्पंचनदीनां च संभेदेघौघभेदिनि ।\nस्नानमात्रात्प्रयात्येव भित्त्वा ब्रह्मांडमंडपम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004110117, "chapter_id": 24110, "verse_number": "४-५९-११८", "content_sanskrit": "तीर्थानि संति भूयांसि काश्यामत्र पदेपदे ।\nन पंचनदतीर्थस्य कोट्यंशेन समान्यपि ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004110118, "chapter_id": 24110, "verse_number": "४-५९-११९", "content_sanskrit": "प्रयागे माघमासे तु सम्यक्स्नातस्य यत्फलम् ।\nतत्फलं स्याद्दिनैकेन काश्यां पंचनदे ध्रुवम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004110119, "chapter_id": 24110, "verse_number": "४-५९-१२०", "content_sanskrit": "स्नात्वा पंचनदे तीर्थे कृत्वा च पितृतर्पणम् ।\nबिंदुमाधवमभ्यर्च्य न भूयो जन्मभाग्भवेत् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004110120, "chapter_id": 24110, "verse_number": "४-५९-१२१", "content_sanskrit": "यावत्संख्यास्तिलादत्ताः पितृभ्यो जलतर्पणे ।\nपुण्ये पंचनदे तीर्थे तृप्तिः स्यात्तावदाब्दिकी ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004110121, "chapter_id": 24110, "verse_number": "४-५९-१२२", "content_sanskrit": "श्रद्धया यैः कृतं श्राद्धं तीथें पंचनदे शुभे ।\nतेषां पितामहा मुक्ता नानायोनि गता अपि ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004110122, "chapter_id": 24110, "verse_number": "४-५९-१२३", "content_sanskrit": "यमलोके पितृगणैर्गाथेयं परिगीयते ।\nमहिमानं पांचनदं दृष्ट्वा श्राद्धविधानतः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004110123, "chapter_id": 24110, "verse_number": "४-५९-१२४", "content_sanskrit": "अस्माकमपि वंश्योत्र कश्चिच्छ्राद्धं करिष्यति ।\nकाश्यां पंचनदं प्राप्य येन मुच्यामहे वयम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004110124, "chapter_id": 24110, "verse_number": "४-५९-१२५", "content_sanskrit": "इयं गाथा प्रतिदिनं श्राद्धदेवस्य सन्निधौ ।\nपितृभिः परिगीयेत काश्यां पंचनदं प्रति ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004110125, "chapter_id": 24110, "verse_number": "४-५९-१२६", "content_sanskrit": "तत्र पंचनदे तीर्थे यत्किंचिद्दीयते वसु ।\nकल्पक्षयेपि न भवेत्तस्य पुण्यस्य संक्षयः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004110126, "chapter_id": 24110, "verse_number": "४-५९-१२७", "content_sanskrit": "वंध्यापि वर्षपर्यंतं स्नात्वा पंचनदे ह्रदे ।\nसमर्च्य मंगलां गौंरीं पुत्रं जनयति ध्रुवम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004110127, "chapter_id": 24110, "verse_number": "४-५९-१२८", "content_sanskrit": "जलैः पांचनदैः पुण्यैर्वाससा पारिशोधितैः ।\nमहाफलमवाप्नोति स्नपयित्वेष्टदेवताम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004110128, "chapter_id": 24110, "verse_number": "४-५९-१२९", "content_sanskrit": "पंचामृतानां कलशैरष्टोत्तरशतोन्मितैः ।\nतुलितोधिकतां यातो बिंदुः पंचनदांभसः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004110129, "chapter_id": 24110, "verse_number": "४-५९-१३०", "content_sanskrit": "पंचकूर्चेन पीतेन यात्र शुद्धिरुदाहृता ।\nसा शुद्धिः श्रद्धया प्राश्य बिंदुं पांचनदांभसः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004110130, "chapter_id": 24110, "verse_number": "४-५९-१३१", "content_sanskrit": "भवेदवभृथस्नानाद्राजसूयाश्वमेधयोः ।\nयत्फलं तच्छतगुणं स्नानात्पांचनदांभसा ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004110131, "chapter_id": 24110, "verse_number": "४-५९-१३२", "content_sanskrit": "राजसूयाश्वमेधौ च भवेतां स्वर्गसाधनम् ।\nआब्रह्मघटिकाद्वंद्वं मुक्त्यै पांचनदाप्लुतिः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004110132, "chapter_id": 24110, "verse_number": "४-५९-१३३", "content_sanskrit": "स्वर्गराज्याभिषेकोपि न तथा संमतः सताम् ।\nअभिषेकः पांचनदो यथानल्पसुखप्रदः ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004110133, "chapter_id": 24110, "verse_number": "४-५९-१३४", "content_sanskrit": "वरं वाराणसीं प्राप्य भृत्यः पंचनदोक्षिणाम् ।\nनान्यत्र सेवकीभूत भूपकोटिर्नरेश्वरः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004110134, "chapter_id": 24110, "verse_number": "४-५९-१३५", "content_sanskrit": "यैर्न पंचनदे स्नातं कार्तिके पापहारिणि ।\nतेऽद्यापि गर्भे तिष्ठंति पुनस्ते गर्भवासिनः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004110135, "chapter_id": 24110, "verse_number": "४-५९-१३६", "content_sanskrit": "कृते धर्मनदं नाम त्रेतायां धूतपापकम् ।\nद्वापरे बिंदुतीर्थं च कलौ पंचनदं स्मृतम् ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004110136, "chapter_id": 24110, "verse_number": "४-५९-१३७", "content_sanskrit": "शतं समास्तपस्तप्त्वा कृते यत्प्राप्यते फलम् ।\nतत्कार्तिके पंचनदे सकृत्स्नानेन लभ्यते ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004110137, "chapter_id": 24110, "verse_number": "४-५९-१३८", "content_sanskrit": "इष्टापूर्तेषु धर्मेषु यावजन्मकृतेषु यत् ।\nअन्यत्र स्यात्फलं तत्स्यादूर्जे धर्मनदाप्लवात् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004110138, "chapter_id": 24110, "verse_number": "४-५९-१३९", "content_sanskrit": "न धूतपाप सदृशं तीर्थं क्वापि महीतले ।\nयदेकस्नानतो नश्येदघं जन्मत्रयार्जितम् ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004110139, "chapter_id": 24110, "verse_number": "४-५९-१४०", "content_sanskrit": "बिंदुतीर्थे नरो दत्त्वा कांचनं कृष्णलोन्मितम् ।\nन दरिद्रो भवेत्क्वापि न स्वर्णेन वियुज्यते ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004110140, "chapter_id": 24110, "verse_number": "४-५९-१४१", "content_sanskrit": "गोभूतिलहिरण्याश्व वासोन्नस्रग्विभूषणम् ।\nयत्किंचिद्बिंदुतीर्थेत्र दत्त्वाक्षयमवाप्नुयात् ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004110141, "chapter_id": 24110, "verse_number": "४-५९-१४२", "content_sanskrit": "एकामप्याहुतिं दत्त्वा समिद्धेग्नौ विधानतः ।\nपुण्ये धर्मनदे तीर्थे कोटिहोमफलं लभेत् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004110142, "chapter_id": 24110, "verse_number": "४-५९-१४३", "content_sanskrit": "न पंचनदतीर्थस्य महिमानमनंतकम् ।\nकोपि वर्णयितुं शक्तश्चतुर्वर्ग शुभौकसः ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004110143, "chapter_id": 24110, "verse_number": "४-५९-१४४", "content_sanskrit": "श्रुत्वाख्यानमिदं पुण्यं श्रावयित्वापि भक्तितः ।\nसर्वपापविशुद्धात्मा विष्णुलोके महीयते ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004110144, "chapter_id": 24110, "verse_number": "४-५९-१४५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थें काशीखंड उत्तरार्धे पंचनदाविर्भावो नामैकोनषष्टितमोऽध्यायः ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}]