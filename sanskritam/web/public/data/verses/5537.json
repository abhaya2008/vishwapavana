[{"id": 2212794, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2212795, "chapter_id": 5537, "verse_number": "१", "content_sanskrit": "एवमेतत् करिष्यामि यथाऽऽत्थ पृथिवीपते ।\nभूयश्चैवानुशास्योऽहं भवता पार्थिवर्षभ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2212796, "chapter_id": 5537, "verse_number": "२", "content_sanskrit": "भीष्मे स्वर्गमनुप्राप्ते गते च मधुसूदने ।\nविदुरे सञ्जये चैव कोऽन्यो मां वक्तुमर्हति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2212797, "chapter_id": 5537, "verse_number": "३", "content_sanskrit": "यस्तु मामनुशास्त्येवं भवानद्य हिते स्थितः ।\nकर्तास्मि तन्महीपाल निर्वृतो भव भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2212798, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2212799, "chapter_id": 5537, "verse_number": "४", "content_sanskrit": "एवमुक्तः स राजर्षिर्धर्मराजेन भारत ।\nकौन्तेयं समनुज्ञातुमियेष भरतर्षभ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2212800, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2212801, "chapter_id": 5537, "verse_number": "५", "content_sanskrit": "पुत्र विश्रम्यतां तावन्ममापि बलवान् श्रमः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2212802, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2212803, "chapter_id": 5537, "verse_number": "६", "content_sanskrit": "इत्युक्त्वा प्राविशद् राजा गान्धार्या भवनं तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2212804, "chapter_id": 5537, "verse_number": "७", "content_sanskrit": "तमासनगतं देवी गान्धारी धर्मचारिणी ।\nउवाच काले कालज्ञा प्रजापतिसमं पतिम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2212805, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2212806, "chapter_id": 5537, "verse_number": "८", "content_sanskrit": "अनुज्ञातः स्वयं तेन व्यासेनापि महर्षिणा ।\nयुधिष्ठिरस्यानुमते कदाऽरण्यं गमिष्यसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2212807, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2212808, "chapter_id": 5537, "verse_number": "९", "content_sanskrit": "गान्धार्यहमनुज्ञातः स्वयं पित्रा महात्मना ।\nयुधिष्ठिरस्यानुमतेर्गन्तास्मि नचिरादिव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2212809, "chapter_id": 5537, "verse_number": "१०", "content_sanskrit": "अहं तु तव पुत्राणां तेषां दुर्द्यूतदेविनाम् ।\nसर्वेषां दातुमिच्छामि प्रेत्यभावानुगं वसु\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2212810, "chapter_id": 5537, "verse_number": "११", "content_sanskrit": "सर्वप्रकृतिसान्निध्यं कारयित्वा स्ववेश्मनि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2212811, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2212812, "chapter_id": 5537, "verse_number": "१२", "content_sanskrit": "इत्युक्त्वा प्रेषयामास धर्मराजाय पार्थिव ।\nस च तद्वचनात् सर्वं समानिन्ये महीपतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2212813, "chapter_id": 5537, "verse_number": "१३", "content_sanskrit": "ततो निष्क्रम्य नृपतिस्तस्मादन्तःपुरात् तदा ।\nसर्वं सुहृज्जनं चैव सर्वाः प्रकृतयस्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2212814, "chapter_id": 5537, "verse_number": "१४", "content_sanskrit": "समवेतांश्च तान् सर्वान् पौरजानपदानथ ।\nब्राह्मणांश्च महीपालान् नानादेशसमागतान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2212815, "chapter_id": 5537, "verse_number": "१५", "content_sanskrit": "ततः प्राह महातेजा धृतराष्ट्रो महीपतिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2212816, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2212817, "chapter_id": 5537, "verse_number": "१६", "content_sanskrit": "शृण्वन्त्वेकाग्रमनसो ब्राह्मणाः कुरुजाङ्गलाः ।\nक्षत्रियाश्चैव वैश्याश्च शूद्राश्चैव समागताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2212818, "chapter_id": 5537, "verse_number": "१७", "content_sanskrit": "भवन्तः कुरवश्चैव बहुकालं सहोषिताः ।\nपरस्परस्य सुहृदः परस्परहिते रताः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2212819, "chapter_id": 5537, "verse_number": "१८", "content_sanskrit": "यदिदानीमहं ब्रूयामस्मिन् काल उपस्थिते ।\nतथा भवद्भिः कर्तव्यमविचार्य वचो मम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2212820, "chapter_id": 5537, "verse_number": "१९", "content_sanskrit": "अरण्यगमने बुद्धिं गान्धारीसहितस्य मे ।\nव्यासस्यानुमते राज्ञस्तथा कुन्तीसुतस्य च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2212821, "chapter_id": 5537, "verse_number": "२०", "content_sanskrit": "भवन्तोऽप्यनुजानन्तु मा वो भूयाद् विचारणा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2212822, "chapter_id": 5537, "verse_number": "२१", "content_sanskrit": "अस्माकं भवतां चैव येयं प्रीतिर्हि शाश्वती ।\nन चान्येष्वपि देशेषु राज्ञामिति मतिर्मम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2212823, "chapter_id": 5537, "verse_number": "२२", "content_sanskrit": "श्रान्तोऽस्मि वयसाऽनेन तथा पुत्रैर्विनाकृतः ।\nउपवासकृशश्चास्मि गान्धारीसहितोऽनघः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2212824, "chapter_id": 5537, "verse_number": "२३", "content_sanskrit": "युधिष्ठिरगते राज्ये प्राप्तश्चास्मि फलं महत् ।\nमन्ये दुर्योधनैश्वर्याद् विशिष्टं बहुभिर्गुणैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2212825, "chapter_id": 5537, "verse_number": "२४", "content_sanskrit": "मम त्वन्धस्य वृद्धस्य हतपुत्रस्य का गतिः ।\nऋते वनं महाभागाः तदनुज्ञातुमर्हथ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2212826, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2212827, "chapter_id": 5537, "verse_number": "२५", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सर्वे ते कुरुजाङ्गलाः ।\nबाष्पसन्दिग्धवचना रुरुदुर्भरतर्षभ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2212828, "chapter_id": 5537, "verse_number": "२६", "content_sanskrit": "तांस्तु विब्रुवतः किञ्चित् दुःखशोकपरायणान् ।\nपुनरेव महाराजो धृतराष्ट्रोऽब्रवीदिदम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2212829, "chapter_id": 5537, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2212830, "chapter_id": 5537, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि त्रयोदशोऽध्यायः ॥१३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]