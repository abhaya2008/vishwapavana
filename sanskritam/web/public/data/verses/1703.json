[{"id": 2032513, "chapter_id": 1703, "verse_number": "४-२६-०x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032514, "chapter_id": 1703, "verse_number": "४-२६-१", "content_sanskrit": "तथा भद्रे करिष्यामि यथा त्वं भीरु भाषसे।\nअदृश्यमानस्तस्याहं तमिस्रायां सकुण्डलम् ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032515, "chapter_id": 1703, "verse_number": "४-२६-२", "content_sanskrit": "नागो बिल्वमिवाक्रम्य पोथयिष्यामि तच्छिरः।\nअलभ्यामिच्छतस्तस्य कीचकस्य दुरात्मनः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032516, "chapter_id": 1703, "verse_number": "४-२६-३", "content_sanskrit": "मया यदुक्तं पाञ्चालि धर्मराजसुतं प्रति।\nकोपादृते किमन्यत्तु नानुवर्तेत को नृपम् ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032517, "chapter_id": 1703, "verse_number": "४-२६-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032518, "chapter_id": 1703, "verse_number": "४-२६-४", "content_sanskrit": "एवमुक्तवा महाबाहुस्तत्र पाण्डवनन्दनः।\nअर्धरात्रे तदोत्थाय सत्ववान्भीमविक्रमः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032519, "chapter_id": 1703, "verse_number": "४-२६-५", "content_sanskrit": "अवदातेन मृदुना पटेनाच्छादितस्तथा ।\nद्रौपदीं पृष्ठतः कृत्वा यत्रासीन्नर्तनालयः ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032520, "chapter_id": 1703, "verse_number": "४-२६-६", "content_sanskrit": "स भीमः प्रथमं गत्वा तमिस्रायामुपाविशत् ।\nमृगं सिंह इवादृश्यः प्रत्याकाङ्क्षत्स कीचकम् ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032521, "chapter_id": 1703, "verse_number": "४-२६-७", "content_sanskrit": "कीचकस्तु शिरःस्नातो निशायां समलंकृतः।\nसङ्केतमगमत्तूर्णं शून्यागारमपावृतम् ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032522, "chapter_id": 1703, "verse_number": "४-२६-८", "content_sanskrit": "तदेव नर्तनागारं पाञ्चाली यदभाषत।\nतां मन्यमानः संकेते सैरन्ध्रीं काममोहितः ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032523, "chapter_id": 1703, "verse_number": "४-२६-९", "content_sanskrit": "प्रविश्य नर्तनागारं ततस्तं पुरुषर्षभम्।\nपूर्वागतं भीमसेनं दृप्तमप्रतिमजसम् ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032524, "chapter_id": 1703, "verse_number": "४-२६-१०", "content_sanskrit": "शयानं शयने तत्र मृत्युं मूढः परामृशत्।\nजाज्वल्यमानं कोपेन कृष्णाधर्षणजेन च ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032525, "chapter_id": 1703, "verse_number": "४-२६-११", "content_sanskrit": "एकान्ते भीममासाद्य कीचकः कालचोदितः।\nहर्षोन्मथितचित्तात्मा स्मयमानोऽभ्यभाषत ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032526, "chapter_id": 1703, "verse_number": "४-२६-१२", "content_sanskrit": "प्रहितं ते मया भद्रे बहुवित्तं शुचिस्मिते।\nत्वयि तिष्ठतु तत्सर्वं यथाऽसि स्वयमागता ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032527, "chapter_id": 1703, "verse_number": "४-२६-१३", "content_sanskrit": "अकस्मान्मां प्रशंसन्ति सदा गृहगताः स्त्रियः।\nबलवान्दर्शनीयश्च नान्यस्ते सदृशः पुमान् ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032528, "chapter_id": 1703, "verse_number": "४-२६-१४", "content_sanskrit": "अहं रूपेण संपन्नः स्नातो गुरुविभूषितः।\nनित्यमेव प्रियः स्त्रीणां सौभाग्यात्प्रियदर्शनः ।\nरूपस्य तन्मया प्राप्तं फलं कमललोचने ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032529, "chapter_id": 1703, "verse_number": "४-२६-१५x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2032530, "chapter_id": 1703, "verse_number": "४-२६-१५", "content_sanskrit": "दिष्ट्या त्वं दर्शनीयोसि दिष्ट्याऽऽत्मानं प्रशंससि॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2032531, "chapter_id": 1703, "verse_number": "४-२६-१६", "content_sanskrit": "त्वयाऽपीदृग्गुणा नारी रूपशीलसमन्विता।\nअदृष्टपूर्वा पश्य त्वं यतो जानासि सूतज।\nद्रक्ष्यसि त्वं मुहूर्तेन यथेयं स्त्री गुणान्विता ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2032532, "chapter_id": 1703, "verse_number": "४-२६-१७", "content_sanskrit": "उपरंस्यसि कामाच्च शीघ्रं त्वं स्प्रष्टुमर्हसि ।\nईदृशस्तु त्वया स्पर्शः स्पृष्टपूर्वो न कर्हिचित् ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2032533, "chapter_id": 1703, "verse_number": "४-२६-१८", "content_sanskrit": "स्पर्शं वेत्सि विदग्धस्त्वं कामधर्मविचक्षणः।\nस्त्रीणां प्रीतिकरो नान्यस्त्वत्समः पुरुषस्त्विह ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2032534, "chapter_id": 1703, "verse_number": "४-२६-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2032535, "chapter_id": 1703, "verse_number": "४-२६-१९", "content_sanskrit": "इत्युक्त्वा तं महाबाहुर्भीमो भीमपराक्रमः।\nसहसोत्पत्य कौन्तेयः प्रहस्येदमुवाच ह ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2032536, "chapter_id": 1703, "verse_number": "४-२६-२०", "content_sanskrit": "अद्य त्वां भगिनी पापं कृष्यमाणं मया भुवि ।\nद्रक्ष्यतेऽद्रिप्रतीकाशं सिंहेनेव महागजम् ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2032537, "chapter_id": 1703, "verse_number": "४-२६-२१", "content_sanskrit": "निराबाधा त्वयि हते सैरन्ध्री विचरिष्यति।\nसुखमेव चरिष्यन्ति सैरन्ध्र्याः पतयः सदा ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2032538, "chapter_id": 1703, "verse_number": "४-२६-२२", "content_sanskrit": "ततो जग्राह केशेषु माल्यवत्सु सुगन्धिषु ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2032539, "chapter_id": 1703, "verse_number": "४-२६-२३", "content_sanskrit": "गृहीत्वा कीचकं भीमो विरराज महाबलः।\nगृहीत्वा ग्रासकामस्तु सिंहः क्षुद्रमृगं यथा ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2032540, "chapter_id": 1703, "verse_number": "४-२६-२४", "content_sanskrit": "स केशेषु परामृष्टो बलेन बलिनां वरः।\nआक्षिप्य केशान्वेगेन बाह्वोर्जग्राह पाण्डवम् ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2032541, "chapter_id": 1703, "verse_number": "४-२६-२५", "content_sanskrit": "बाहुयुद्धं तयोरासीत्क्रुद्धयोर्नरसिंहयोः।\nवसन्ते वासिताहेतोर्बलिनोर्नागयोरिव ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2032542, "chapter_id": 1703, "verse_number": "४-२६-२६", "content_sanskrit": "कीचकानां तु मुख्यस्य नराणामुत्तमस्य च।\nवालिसुग्रीवयोर्भ्रात्रोः पुरेव कपिसिंहयोः ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2032543, "chapter_id": 1703, "verse_number": "४-२६-२७", "content_sanskrit": "शार्दूलाविव गर्जन्तौ तार्क्ष्यनागाविवोद्यतौ।\nसमयत्नौ समक्रोधौ पतितौ भीमकीचकौ ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2032544, "chapter_id": 1703, "verse_number": "४-२६-२८", "content_sanskrit": "गजाविव मदोन्मत्तौ नदन्तौ पतितौ क्षितौ।\nवृषभाविव वल्मीकं मृद्गन्तौ समविक्रमौ ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2032545, "chapter_id": 1703, "verse_number": "४-२६-२९", "content_sanskrit": "ईषदागलितं चापि क्रोधाच्चावाङ्मुखं स्थितम् ।\nकीचको बलवान्भीमं जानुभ्यां पातयद्भुवि ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2032546, "chapter_id": 1703, "verse_number": "४-२६-३०", "content_sanskrit": "पातितो भीमसेनस्तु कीचकेन बलीयसा।\nउत्पपाताथ वेगेन दण्डाहत इवोरगः ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2032547, "chapter_id": 1703, "verse_number": "४-२६-३१", "content_sanskrit": "स्पर्धया च बलोन्मत्तौ तावुभौ भीमकीचकौ।\nनिश्शब्दं पर्यकर्षेतामन्योन्यस्य विनिर्जये ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2032548, "chapter_id": 1703, "verse_number": "४-२६-३२", "content_sanskrit": "ततस्तद्भवनश्रेष्ठं प्राकम्पत तदा भृशम्।\nतौ क्रोधवशमापन्नावन्योन्यमभिजघ्नतुः ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2032549, "chapter_id": 1703, "verse_number": "४-२६-३३", "content_sanskrit": "तलाभ्यां भीमसेनेन वक्षस्यभिहतो बली।\nकीचको रोषरक्ताक्षो न चचाल पदात्पदम् ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2032550, "chapter_id": 1703, "verse_number": "४-२६-३४", "content_sanskrit": "मुहूर्तमशकत्सोढुं वेगं तस्य महात्मनः।\nकीचको भीमसेनेन पश्चात्पश्चादहीयत ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2032551, "chapter_id": 1703, "verse_number": "४-२६-३५", "content_sanskrit": "तं हीयमानं विज्ञाय भीमसेनो महाबलः ।\nवक्षस्यानीय वेगेन प्रममाथ विचेतसम् ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2032552, "chapter_id": 1703, "verse_number": "४-२६-३६", "content_sanskrit": "क्रोधाविष्टो विनिश्चस्य पुनश्चैनं वृकोदरः ।\nजग्राह जयतांश्रेष्ठः केशेष्वेव भृशं तदा ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2032553, "chapter_id": 1703, "verse_number": "४-२६-३७", "content_sanskrit": "गृहीत्वा कीचकं भीमो विरराज महाबलः ।\nआमिषार्थे गृहीत्वैव शार्दूलो मृगयूथपम् ॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2032554, "chapter_id": 1703, "verse_number": "४-२६-३८", "content_sanskrit": "पुनश्चातिबलस्तत्र कीचको बलदर्पितः ।\nव्यायच्छन्नेव दुर्धर्षः पाण्डवेन तरस्विना ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2032555, "chapter_id": 1703, "verse_number": "४-२६-३९", "content_sanskrit": "मुष्टिना भीमसेनेन शिरस्यभिहतो भृशम्।\nकीचको वृत्तरक्ताक्षो गतासुरपतद्भुवि ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2032556, "chapter_id": 1703, "verse_number": "४-२६-४०", "content_sanskrit": "आस्ये पाणी च पादौ च शिरोग्रीवां सकुण्डलाम् ।\nकाये प्रवेशयामास मृदित्वाऽङ्गानि सर्वशः ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2032557, "chapter_id": 1703, "verse_number": "४-२६-४१", "content_sanskrit": "स तं मथितसर्वाङ्गं मांसपिण्डमथाकरोत् ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2032558, "chapter_id": 1703, "verse_number": "४-२६-४२", "content_sanskrit": "तत्राग्निं स्वयमुज्ज्वाल्य पाणिसंघर्षजं बली।\nकष्णायै दर्शयामास भीमसेनो महाबलः ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2032559, "chapter_id": 1703, "verse_number": "४-२६-४३", "content_sanskrit": "उवाच च महातेजा द्रौपदीं योषितां वराम्।\nत्वयि कामुकमत्यन्तं पापिनं पारदारिकम्।\nपश्यैनमेहि पाञ्चालि कामुकोऽयं मया हतः ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2032560, "chapter_id": 1703, "verse_number": "४-२६-४४", "content_sanskrit": "प्रार्थयन्ते सुकेशान्ते ये त्वां शीलसमन्विताम् ।\nएवं स्वपन्ति ते भीरु शेतेऽयं कीचको यथा।\nयस्त्वामभ्यहनद्भद्रे पदा भूमौ निपात्य च ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2032561, "chapter_id": 1703, "verse_number": "४-२६-४५", "content_sanskrit": "एवमुक्त्वा महाबाहुर्गन्धर्वेण हतं तदा।\nविज्ञापनार्थमन्येषां विरराम महाहवम् ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2032562, "chapter_id": 1703, "verse_number": "४-२६-४६", "content_sanskrit": "तथा स कीचकं हत्वा गत्वा रोषस्य निष्कृतिम्।\nआमन्त्र्य द्रौपदीं पश्चात्क्षिप्रमायान्महानसम् ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2032563, "chapter_id": 1703, "verse_number": "४-२६-४७", "content_sanskrit": "स्नात्वाऽनुलेपनं कृत्वा व्यापूर्य च मनोरथम्।\nसुखोपविष्टः शयने भीमो भीमपराक्रमः ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2032564, "chapter_id": 1703, "verse_number": "४-२६-४८", "content_sanskrit": "ततः कृष्णा यदा मेने गतं भीमं महानसम् ।\nकीचकं घातयित्वा च द्रौपदी योषितां वरा।\nप्रहृष्टा गतसंत्रासा सभापालानुवाच ह ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2032565, "chapter_id": 1703, "verse_number": "४-२६-४९", "content_sanskrit": "कीचको निहतः शेते गन्धर्वैः पतिभिर्मम।\nपरस्त्रीकामसंतप्तं समागच्छन्त पश्यत ॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2032566, "chapter_id": 1703, "verse_number": "४-२६-५०", "content_sanskrit": "तच्छ्रुत्वा भाषितं तस्या नर्तनागाररक्षिणः ।\nसहसैव समुत्तस्थुरुल्कामादाय सर्वशः ॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2032567, "chapter_id": 1703, "verse_number": "४-२६-५१", "content_sanskrit": "तस्यास्तं निहतं श्रुत्वा कीचकस्य सहोदराः।\nततो गत्वा तु तद्वेश्म कीचकं विनिपातितम्।\nगतासुं ददृशुर्भूमौ रुधिरेण समुक्षितम् ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2032568, "chapter_id": 1703, "verse_number": "४-२६-५२", "content_sanskrit": "पार्ष्णिपामिशिरोहीनं दृष्ट्वा ते विस्मिताऽभवन् ॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2032569, "chapter_id": 1703, "verse_number": "४-२६-५३", "content_sanskrit": "क्वास्य ग्रीवा क्व चरमौ क्व पामी क्व शिरः क्व दृक् ।\nइति स्म ते परीक्षन्ते गन्धर्वेण हतं तदा ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2032570, "chapter_id": 1703, "verse_number": "४-२६-५४", "content_sanskrit": "अमानुषं कृतं कर्म तं दृष्ट्वा विनिपातितम् ।\nनिरीक्षन्ते ततः सर्वे परं विस्मयमागताः ॥ ५४ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2032571, "chapter_id": 1703, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि कीचकवधपर्वणि षड्विंशोऽध्यायः ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]