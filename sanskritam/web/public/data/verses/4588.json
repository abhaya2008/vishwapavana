[{"id": 2167006, "chapter_id": 4588, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167007, "chapter_id": 4588, "verse_number": "१", "content_sanskrit": "श्रुत्वा कर्णं हतं युद्धे पुत्रांश्चैव निपातितान् ।\nनरेन्द्रः किञ्चिदाश्वस्तो द्विजश्रेष्ठ किमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167008, "chapter_id": 4588, "verse_number": "२", "content_sanskrit": "प्राप्तवान् परमं दुःखं पुत्रव्यसनजं महत् ।\nतस्मिन् यदुक्तवान् काले तन्ममाचक्ष्व पृच्छतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167009, "chapter_id": 4588, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167010, "chapter_id": 4588, "verse_number": "३", "content_sanskrit": "श्रुत्वा कर्णस्य निधनमश्रद्धेयमिवाद्भुतम् ।\nभूतसम्मोहनं भीमं मेरोः पर्यसनं यथा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167011, "chapter_id": 4588, "verse_number": "४", "content_sanskrit": "चित्तमोहमिवायुक्तं भार्गवस्य महात्मनः ।\nपराजयमिवेन्द्रस्य द्विषद्भ्यो भीमकर्मणः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167012, "chapter_id": 4588, "verse_number": "५", "content_sanskrit": "दिवः प्रपतनं भानोरुर्व्यामिव महाद्युतेः ।\nसंशोषणमिवाचिन्त्यं समुद्रस्याक्षयाम्भसः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167013, "chapter_id": 4588, "verse_number": "६", "content_sanskrit": "महीवियद्दिगम्बूनां सर्वनाशमिवाद्भुतम् ।\nकर्मणोरिव वैफल्यमुभयोः पुण्यपापयोः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167014, "chapter_id": 4588, "verse_number": "७", "content_sanskrit": "सञ्चिन्त्य निपुणं बुद्ध्या धृतराष्ट्रो जनेश्वरः ।\nनेदमस्तीति सञ्चिन्त्य कर्णस्य समरे वधम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167015, "chapter_id": 4588, "verse_number": "८", "content_sanskrit": "प्राणिनामेवमात्मत्वात् स्यादपीति विचार्य च ।\nशोकाग्निना दह्यमानो दह्यमान इवाशये\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167016, "chapter_id": 4588, "verse_number": "९", "content_sanskrit": "विस्रस्ताङ्गः श्वसन् दीनो हा हेत्युक्त्वा सुदुःखितः ।\nविललाप महाराज धृतराष्ट्रोऽम्बिकासुतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167017, "chapter_id": 4588, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167018, "chapter_id": 4588, "verse_number": "१०", "content_sanskrit": "सञ्जयातिरथिर्वीरः सिंहद्विरदविक्रमः ।\nवृषभप्रतिमस्कन्धो वृषभाक्षगतिस्वरः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167019, "chapter_id": 4588, "verse_number": "११", "content_sanskrit": "वृषभो वृषभस्येव यो युद्धे न निवर्तते ।\nशत्रोरपि महेन्द्रस्य सिंहसंहननो युवा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167020, "chapter_id": 4588, "verse_number": "१२", "content_sanskrit": "यस्य ज्यातळशब्देन शरवृष्टिरयेण च ।\nरथाश्वनरमातङ्गा न च तिष्ठन्ति संयुगे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167021, "chapter_id": 4588, "verse_number": "१३", "content_sanskrit": "यमाश्रित्य महाबाहुं द्विषत्सङ्घघ्नमच्युतम् ।\nदुर्योधनोऽकरोद् वैरं पाण्डुपुत्रैर्महारथैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167022, "chapter_id": 4588, "verse_number": "१४", "content_sanskrit": "स कथं रथिनां श्रेष्ठः कर्णः पार्थेन संयुगे ।\nनिहतः पुरुषव्याघ्रः प्रसह्यामितविक्रमः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167023, "chapter_id": 4588, "verse_number": "१५", "content_sanskrit": "यो नामन्यत वै नित्यमच्युतं सधनञ्जयम् ।\nन वृष्णीन् नाहितानन्यान् स्वबाहुबलमाश्रितः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167024, "chapter_id": 4588, "verse_number": "१६", "content_sanskrit": "शार्ङ्गगाण्डीवधन्वानौ सहितावपराजितौ ।\nअहं दिव्याद् रथादेकः पातयिष्यामि संयुगे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167025, "chapter_id": 4588, "verse_number": "समाप्तिः", "content_sanskrit": "इति यः सततं मन्दमवोचल्लोभमोहितम् ।\nदुर्योधनमवाचीनं राज्यकामुकमातुरम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167026, "chapter_id": 4588, "verse_number": "१८", "content_sanskrit": "योऽजयत् सर्वकाम्भोजान् अम्बष्ठान् केकयैः सह ।\nगान्धारान् मद्रकान् मात्स्यांस्त्रिगर्तान् तङ्कणान् शकान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167027, "chapter_id": 4588, "verse_number": "१९", "content_sanskrit": "पाञ्चालांश्च विदेहांश्च कुणिन्दान् काशिकोसलान् ।\nसुह्मानङ्गांश्च वङ्गांश्च निषादान् पुण्ड्रकीकटान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167028, "chapter_id": 4588, "verse_number": "२०", "content_sanskrit": "वत्सान् कलिङ्गान् दरदान् अश्मकान् ऋषिकानपि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167029, "chapter_id": 4588, "verse_number": "२१", "content_sanskrit": "यो जित्वा समरे शूरान् चक्रे बलिभृतः पुरा ।\nशरव्रातैः सुनिशितैः सुतीक्ष्णैः कङ्कपत्रिभिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167030, "chapter_id": 4588, "verse_number": "२२", "content_sanskrit": "दुर्योधनस्य वृद्ध्यर्थं वर्तते यो जयाय च ।\nसेनागोपश्च स कथं शत्रुभिः परमास्त्रवित्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167031, "chapter_id": 4588, "verse_number": "२३", "content_sanskrit": "घातितः पाण्डवैः शूरैः समर्थैः वीर्यशालिभिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167032, "chapter_id": 4588, "verse_number": "२४", "content_sanskrit": "वृषो महेन्द्रो देवेषु वृषः कर्णो नरेष्वपि ।\nतृतीयमन्यं लोकेस्मिन् वृषं नैवानुशुश्रुम\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167033, "chapter_id": 4588, "verse_number": "२५", "content_sanskrit": "(शबरान् परहूणांश्च प्रहूणान् सरलानपि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167034, "chapter_id": 4588, "verse_number": "२६", "content_sanskrit": "म्लेच्छराष्ट्राधिपांश्चैव दुर्गानाटविकांस्तथा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167035, "chapter_id": 4588, "verse_number": "", "content_sanskrit": "जित्वैतान् समरे वीरः सुतीक्ष्णैः कङ्कपत्रिभिः ।\nकरमाहारयामास जित्वा सर्वानरींस्तथा\t॥२७॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167036, "chapter_id": 4588, "verse_number": "२८", "content_sanskrit": "उच्चैःश्रवा वरोऽश्वानां राज्ञां वैश्रवणो वरः ।\nवरो महेन्द्रो देवानां कर्णः प्रहरतां वरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167037, "chapter_id": 4588, "verse_number": "२९", "content_sanskrit": "योऽजितः पार्थिवैः शूरैः समर्थैर्वीर्यशालिभिः ।\nदुर्योधनस्य वृद्ध्यर्थं कृत्स्नामुर्वीमथाजयत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167038, "chapter_id": 4588, "verse_number": "३०", "content_sanskrit": "यं लब्ध्वा मागधो राजा सान्त्वमानोऽथ सौहृदैः ।\nअरौत्सीत् क्षत्रमतुलमृते कौरवयादवान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167039, "chapter_id": 4588, "verse_number": "३१", "content_sanskrit": "तं श्रुत्वा निहतं कर्णं द्वैरथे सव्यसाचिना ।\nशोकार्णवे निमग्नोऽहमप्लवः सागरे यथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167040, "chapter_id": 4588, "verse_number": "३२", "content_sanskrit": "नृवृषं निहतं श्रुत्वा द्वैरथे रथिनां वरम् ।\nशोकार्णवे निमग्नोऽहमप्लवः सागरे यथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167041, "chapter_id": 4588, "verse_number": "३३", "content_sanskrit": "ईदृशैर्यदहं दुःखैर्न विनश्यामि सञ्जय ।\nवज्राद् दृढतरं मन्ये हृदयं मम दुर्भिदम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167042, "chapter_id": 4588, "verse_number": "३४", "content_sanskrit": "ज्ञातिसम्बन्धिमित्राणामिमं श्रुत्वा पराभवम् ।\nको मदन्यः पुमान् लोके न जह्यात् सूत जीवितम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167043, "chapter_id": 4588, "verse_number": "", "content_sanskrit": "(विषमग्निं प्रपातं वा पर्वताग्रादहं वृणे ।\nमहाप्रस्थानगमनं जलं प्रायोपवेशनम्\t॥३५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167044, "chapter_id": 4588, "verse_number": "३६", "content_sanskrit": "न हि शक्ष्यामि दुःखानि सोढुं कष्टानि सञ्जय\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167045, "chapter_id": 4588, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nअष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]