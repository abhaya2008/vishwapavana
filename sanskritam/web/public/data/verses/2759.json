[{"id": 2082528, "chapter_id": 2759, "verse_number": "१२-२६४-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082529, "chapter_id": 2759, "verse_number": "१२-२६४-१", "content_sanskrit": "विनीय दुःखमबला साऽऽत्मनैवायतेक्षणा।\nउवाच प्राञ्जलिर्भूत्वा तमेवावर्जिता तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082530, "chapter_id": 2759, "verse_number": "१२-२६४-२", "content_sanskrit": "त्वया सृष्टा कथं नारी मादृशी वदतां वर।\nरौद्रकर्माभिजायेत सर्वप्राणिभयंकरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082531, "chapter_id": 2759, "verse_number": "१२-२६४-३", "content_sanskrit": "विभेम्यहमधर्मस्य धर्म्यमादिश कर्म मे।\nत्वं मां भीतामवेक्षस्व शिवेनेश्वरचक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082532, "chapter_id": 2759, "verse_number": "१२-२६४-४", "content_sanskrit": "बालान्वृद्धान्वयस्थांश्च न हरेयमनागसः।\nप्राणिनः प्राणिनामीश नमस्तेऽस्तु प्रसीद मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082533, "chapter_id": 2759, "verse_number": "१२-२६४-५", "content_sanskrit": "प्रियान्पुत्रान्वयस्यांश्च भ्रातॄन्मातॄः पितृनपि।\nअपध्यास्यन्ति यद्येवं मृतास्तेभ्यो विभेम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082534, "chapter_id": 2759, "verse_number": "१२-२६४-६", "content_sanskrit": "कृपणाश्रुपरिक्लेदो दहेन्मां शाश्वतीः समाः।\nतेभ्योऽहं बलवद्भीता शरणं त्वामुपागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082535, "chapter_id": 2759, "verse_number": "१२-२६४-७", "content_sanskrit": "यमस्य भवने देव पात्यन्ते पापकर्मिणः।\nप्रसादये त्वां वरद प्रसादं कुरु मे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082536, "chapter_id": 2759, "verse_number": "१२-२६४-८", "content_sanskrit": "एतदिच्छाम्यहं कामं त्वत्तो लोकपितामह।\nइच्छेयं त्वत्प्रसादाच्च तपस्तप्तुं महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082537, "chapter_id": 2759, "verse_number": "१२-२६४-९x", "content_sanskrit": "पितामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082538, "chapter_id": 2759, "verse_number": "१२-२६४-९", "content_sanskrit": "त्वं हिं संहारबुद्ध्या मे चिन्तिता रुषितेन च।\nतस्मात्संहर सर्वास्त्वं प्रजा मा च विचारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082539, "chapter_id": 2759, "verse_number": "१२-२६४-१०", "content_sanskrit": "एतदेवमवश्यं हि भविता नैतदन्यथा।\nक्रियतामनवद्याङ्गि यथोक्तं मद्वचोऽनघे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082540, "chapter_id": 2759, "verse_number": "१२-२६४-११", "content_sanskrit": "एवमुक्ता महाबाहो मृत्युः परपुरंजय।\nन व्याजहार तस्थौ च प्रह्वा भगवदुन्मुखी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082541, "chapter_id": 2759, "verse_number": "१२-२६४-१२", "content_sanskrit": "पुनः पुनरथोक्ता सा गतसत्त्वेव भामिनी।\nतूष्णीमासीत्ततो देवो लोकानामीश्वरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082542, "chapter_id": 2759, "verse_number": "१२-२६४-१३", "content_sanskrit": "प्रससाद किल ब्रह्मा स्वयमेवात्मनाऽऽत्मनि।\nस्मयमानश्च लोकेशो लोकान्सर्वानवैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082543, "chapter_id": 2759, "verse_number": "१२-२६४-१४", "content_sanskrit": "निवृत्तरोषे तस्मिंस्तु भगवत्यपराजिते।\nसा कन्याऽथ जगामास्य समीपादिति नःश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082544, "chapter_id": 2759, "verse_number": "१२-२६४-१५", "content_sanskrit": "अपसृत्याप्रतिश्रुत्य प्रजासंहरणं तदा।\nत्वरमाणेव राजेन्द्र मृत्युर्धेनुकमभ्यगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082545, "chapter_id": 2759, "verse_number": "१२-२६४-१६", "content_sanskrit": "सा तत्र परमं देवी तपोऽचरत दुश्चरम्।\nसमा ह्येकपदे तस्थौ दशपद्मानि पञ्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082546, "chapter_id": 2759, "verse_number": "१२-२६४-१७", "content_sanskrit": "तां तथा कुर्वतीं तत्र तपः परमदुश्चरम्।\nपुनरेव महातेजा ब्रह्मा वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082547, "chapter_id": 2759, "verse_number": "१२-२६४-१८", "content_sanskrit": "कुरुष्व मे वचो मृत्यो तदनादृत्य सत्वरा।\nतथैवैकपदे तात पुनरन्यानि सप्त सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082548, "chapter_id": 2759, "verse_number": "१२-२६४-१९", "content_sanskrit": "तस्थौ पद्मानि षट् चैव पञ्च द्वे चैव मानद।\nभूयः पद्मायुतं तात मृगैः सह चचार सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082549, "chapter_id": 2759, "verse_number": "१२-२६४-२०", "content_sanskrit": "द्वे चायुते नरश्रेष्ठ वाय्वाहारा महामते।\nपुनरेव ततो राजन्मौनमातिष्ठदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082550, "chapter_id": 2759, "verse_number": "१२-२६४-२१", "content_sanskrit": "अप्सु वर्षसहस्राणि सप्त चैकं च पार्थिव।\nततो जगाम सा कन्या कौशिकीं नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082551, "chapter_id": 2759, "verse_number": "१२-२६४-२२", "content_sanskrit": "तत्र वायुजलाहारा चचार नियमं पुनः।\nततो ययौ महाभागा गङ्गां मेरुं च केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082552, "chapter_id": 2759, "verse_number": "१२-२६४-२३", "content_sanskrit": "तस्थौ दार्विव निश्चेष्टा प्रजानां हितकाम्यया।\nततो हिमवतो मूर्ध्निं यत्र देवाः समीजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082553, "chapter_id": 2759, "verse_number": "१२-२६४-२४", "content_sanskrit": "तत्राङ्गुष्ठेन राजेन्द्र निखर्वमचरत्तपः।\nतस्थौ पितामहं चैव तोषयामास यत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082554, "chapter_id": 2759, "verse_number": "१२-२६४-२५", "content_sanskrit": "ततस्तामब्रवीत्तत्र लोकानां प्रपितामहः।\nकिमिदं वर्तसे पुत्रि क्रियतां मम तद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082555, "chapter_id": 2759, "verse_number": "१२-२६४-२६", "content_sanskrit": "ततोऽब्रवीत्पुनर्मृत्युर्भगवन्तं पितामहम्।\nन हरेयं प्रजा देव पुनस्त्वाऽहं प्रसादये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082556, "chapter_id": 2759, "verse_number": "१२-२६४-२७", "content_sanskrit": "तामधर्मभयाद्भीतां पुनरेव प्रयाचतीम्।\nतदाऽब्रवीद्देवदेवो निगृह्येदं वचस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082557, "chapter_id": 2759, "verse_number": "१२-२६४-२८", "content_sanskrit": "अधर्मो नास्ति ते मृत्यो संयच्छेमाः प्रजाः शुभे।\nमयाऽप्युक्तं मृषा भद्रे भविता नेह किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082558, "chapter_id": 2759, "verse_number": "१२-२६४-२९", "content_sanskrit": "धर्मः सनातनश्च त्वामिहैवानुप्रवेक्ष्यति।\nअहं च विबुधाश्चैव त्वद्धिते निरताः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082559, "chapter_id": 2759, "verse_number": "१२-२६४-३०", "content_sanskrit": "इमन्यं च ते कामं ददानि मनसेप्सितम्।\nन त्वां दोषेण यास्यन्ति व्याधिसंपीडिताः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082560, "chapter_id": 2759, "verse_number": "१२-२६४-३१", "content_sanskrit": "पुरुषेषु च रूपेण पुरुषस्त्वं भविष्यसि।\nस्त्रीषु स्त्रीरूपिणी चैव तृतीयेषु नपुंसकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082561, "chapter_id": 2759, "verse_number": "१२-२६४-३२", "content_sanskrit": "सैवमुक्ता महाराज कृताञ्जलिरुवाच ह।\nपुनरेव महात्मानं नेति देवेशमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082562, "chapter_id": 2759, "verse_number": "१२-२६४-३३", "content_sanskrit": "तामब्रवीत्तदा देवो मृत्यो संहर मानवान्।\nअधर्मस्ते न भविता यथा ध्यास्याम्यहं शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2082563, "chapter_id": 2759, "verse_number": "१२-२६४-३४", "content_sanskrit": "`त्वं हि शक्ता च युक्ता च पूर्वोत्पन्ना च भामिनि।\nअनुशिष्टा च निर्दोषा तस्मात्त्वं कुरु मे मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2082564, "chapter_id": 2759, "verse_number": "१२-२६४-३५", "content_sanskrit": "यानश्रुबिन्दून्पतितानपश्यं\nये पाणिभ्यां धारितास्ते पुरस्तात्।\nते व्याधयो मानवान्घोररूपाः\nप्राप्ते काले पीडयिष्यन्ति मृत्यो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2082565, "chapter_id": 2759, "verse_number": "१२-२६४-३६", "content_sanskrit": "सर्वेषां त्वं प्राणिनामन्तकाले\nकामक्रोधौ सहितौ योजयेथाः।\nएवं धर्मस्त्वामुपैष्यत्यमोघो\nन चाधर्मं लप्स्यसे तुल्यवृत्तिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2082566, "chapter_id": 2759, "verse_number": "१२-२६४-३७", "content_sanskrit": "एवं धर्मं पालयिष्यस्यथो त्वं\nन चात्मानं मञ्जयिष्यस्यधर्मे।\nतस्मात्कामं रोचयाभ्यागतं त्वं\nसा त्वं साधो संहरस्वेह जन्तून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2082567, "chapter_id": 2759, "verse_number": "१२-२६४-३८", "content_sanskrit": "सा वै तदा मृत्युसंज्ञा कृतास्त्री\nशापाद्भीता बाढमित्यब्रवीत्तम्।\nअथो प्राणान्प्राणिनामन्तकाले\nकामक्रोधौ प्राप्य नित्यं निहन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2082568, "chapter_id": 2759, "verse_number": "१२-२६४-३९", "content_sanskrit": "मृत्योर्ये ते व्याधयश्चाश्चुपाता\nमनुष्याणां युज्यते यैः शरीरम्।\nसर्वेषां वै प्राणिनां प्राणनान्ते\nतस्माच्छोकं मा कृथा बुद्ध्य बुद्ध्या॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2082569, "chapter_id": 2759, "verse_number": "१२-२६४-४०", "content_sanskrit": "सर्वे देवाः प्राणिनां प्राणनान्ते\nगत्वा वृत्ताः सन्निवृत्तास्तथैव।\nएवं सर्वे मानवाः प्राणनान्ते\nगत्वा वृत्ता देववद्राजसिंह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2082570, "chapter_id": 2759, "verse_number": "१२-२६४-४१", "content_sanskrit": "वायुर्भीमो भीमनादो महौजाः\nसर्वेषां च प्राणिनां प्राणभूतः।\nअनावृत्तिर्देहिनां देहपाते\nतस्माद्वायुर्देवदेवो विशिष्टः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2082571, "chapter_id": 2759, "verse_number": "१२-२६४-४२", "content_sanskrit": "सर्वे देवा मर्त्यसंज्ञाविशिष्टाः\nसर्वे मर्त्या देवसंज्ञाविशिष्टाः।\nतस्मात्पुत्रं मा शुचो राजसिंह\nपुत्रः स्वर्गं प्राप्यते मोदते हे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2082572, "chapter_id": 2759, "verse_number": "१२-२६४-४३", "content_sanskrit": "एवं मृत्युर्देवसृष्टा प्रजानां\nप्राप्ते काले संहरन्ती यथावत्।\nतस्याश्चैव व्याधयस्तेऽश्रुपाताः\nप्राप्ते काले संहरन्तीह जन्तून्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2082573, "chapter_id": 2759, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुष्षष्ट्यधिकद्विशततमोऽध्यायः॥ २६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]