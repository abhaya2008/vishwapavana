[{"id": 2105774, "chapter_id": 3286, "verse_number": "१६-१५-१", "content_sanskrit": "वैशम्पायन उवाच।\nविदुरेणैवमुक्तस्तु धृतराष्ट्रो जनाधिपः।\nप्रीतिमानभवद्राजन्राज्ञो जिष्णोश्च कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105775, "chapter_id": 3286, "verse_number": "१६-१५-२", "content_sanskrit": "ततोऽभिरूपान्भीष्माय ब्राह्मणानृषिसत्तमान्।\nपुत्रार्थे सुहृदां चैव स समीक्ष्य सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105776, "chapter_id": 3286, "verse_number": "१६-१५-३", "content_sanskrit": "कारयित्वाऽन्नपानानि यानान्याच्छादनानि च।\nसुवर्णमणिरत्नानि दासीदासपरिच्छदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105777, "chapter_id": 3286, "verse_number": "१६-१५-४", "content_sanskrit": "कंबलानि च रत्नानि ग्रामान्क्षेत्रं तथा धनम्।\nसालङ्कारान्गजानश्वान्कन्याश्चैव वरस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105778, "chapter_id": 3286, "verse_number": "१६-१५-५", "content_sanskrit": "आदिश्यादिश्य सर्वेभ्यो ददौ स नृपसत्तमः।\nद्रोणं संकीर्त्य भीष्मं च सोमदत्तं च बाह्लिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105779, "chapter_id": 3286, "verse_number": "१६-१५-६", "content_sanskrit": "दुर्योधनं च राजानं पुत्रांश्चैव पृथक्पृथक्।\nजयद्रथपुरोगांश्च सुहृदश्चापि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105780, "chapter_id": 3286, "verse_number": "१६-१५-७", "content_sanskrit": "स श्राद्धयज्ञो ववृते बहुगोधनदक्षिणः।\nअनेकधनरत्नौघो युधिष्ठिरमते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105781, "chapter_id": 3286, "verse_number": "१६-१५-८", "content_sanskrit": "अनिशं यत्र पुरुषा गणका लेखकास्तदा।\nयुधिष्ठिरस्य वचनादपृच्छन्त स्म तं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105782, "chapter_id": 3286, "verse_number": "१६-१५-९", "content_sanskrit": "आज्ञापय किमेतेभ्यः प्रदेयं दीयतामिति।\nतदुपस्थितमेवात्र वचनान्ते ददुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105783, "chapter_id": 3286, "verse_number": "१६-१५-१०", "content_sanskrit": "शते देये दशशतं सहस्रं चायुतं तथा।\nदीयते वचनाद्राज्ञः कुन्तीपुत्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105784, "chapter_id": 3286, "verse_number": "१६-१५-११", "content_sanskrit": "एवं स वसुधाराभिर्वर्षमाणो नृपांबुदः।\nतप्रयामास विप्रांस्तान्वर्षन्भूमिमिवांबुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105785, "chapter_id": 3286, "verse_number": "१६-१५-१२", "content_sanskrit": "ततोऽन्तन्तरमेवात्र सर्ववर्णान्महामते।\nअन्नपानरसौघेण प्लावयामास पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105786, "chapter_id": 3286, "verse_number": "१६-१५-१३", "content_sanskrit": "सवस्त्रधनरत्नौघो मृदङ्गनिनदस्वनः।\nगवाश्वमकरावर्तो नानारत्नमहाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105787, "chapter_id": 3286, "verse_number": "१६-१५-१४", "content_sanskrit": "ग्रामाग्रहारद्वीपाढ्यो मणिहेमजलार्णवः।\nजगत्संप्लावयामास धृतराष्ट्रोडुपोद्धतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105788, "chapter_id": 3286, "verse_number": "१६-१५-१५", "content_sanskrit": "एवं स पुत्रपौत्राणां पितॄणामात्मनस्तथा।\nगान्धार्याश्च महाराज प्रददावौर्द्वदेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105789, "chapter_id": 3286, "verse_number": "१६-१५-१६", "content_sanskrit": "परिश्रान्तो यदासीत्स ददद्दानान्यनेकशः।\nनिवर्तयामास तदा दानयज्ञं नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105790, "chapter_id": 3286, "verse_number": "१६-१५-१७", "content_sanskrit": "एवं स राजा कौरव्यश्चक्रे दानमहाक्रतुम्।\nनटनर्तकलास्याढ्यं बह्वन्नरसदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105791, "chapter_id": 3286, "verse_number": "१६-१५-१८", "content_sanskrit": "दशाहमेवं दानानि दत्त्वा राजांऽबिकासुतः।\nबभूव पुत्रपौत्राणामनृणो भरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105792, "chapter_id": 3286, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि पञ्चदशोऽध्यायः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]