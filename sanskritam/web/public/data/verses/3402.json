[{"id": 2111029, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111030, "chapter_id": 3402, "verse_number": "१", "content_sanskrit": "कतरस्त्वेतयोः पूर्वं देवानामेति सात्म्यताम् ।\nउभयोर्धावतो राजन् सूर्याचन्द्रमसोरिव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111031, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111032, "chapter_id": 3402, "verse_number": "२", "content_sanskrit": "अनिकेतो गृहस्थेषु कामवृत्तेष्वसङ्गतः ।\nग्राम एव वसन् भिक्षुः तयोः पूर्वतरं गतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111033, "chapter_id": 3402, "verse_number": "३", "content_sanskrit": "अप्राप्य दीर्घमायुस्तु यः प्राप्तो विकृतिं चरेत् ।\nतप्येत यदि तत् कृत्वा चरेत् सोऽन्यस्तपस्तथा \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111034, "chapter_id": 3402, "verse_number": "४", "content_sanskrit": "पापानां कर्मणां नित्यं बिभीयाद् यस्तु मानवः ।\nसुखमेवाचरन्नित्यं सोऽत्यन्तं सुखमश्नुते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111035, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "यद्वै नृशंसं तदसत्यमाहुर्यत् सेवते धर्ममनर्थबुद्धिः ।\nअस्वोऽप्यनीशश्च तथैव राजन् तदार्जवं स समाधिस्तदाढ्यम् \t॥५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111036, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111037, "chapter_id": 3402, "verse_number": "६", "content_sanskrit": "केनासि दूतः प्रहितोऽद्य राजन्\nयुवा स्रग्वी दर्शनीयः सुवर्चाः ।\nकुत आगतः कतरस्यां दिशि त्वम्\nउताहोस्वित् पार्थिव स्थानमस्ति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111038, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111039, "chapter_id": 3402, "verse_number": "७", "content_sanskrit": "इमं भौमं नरकं क्षीणपुण्यः\nप्रवेष्टुमुर्वीं गगनाद् विप्रहीणः ।\nविद्या चैवमतिमाना च बुद्धिः\nममाभवत् कर्म लोक्यं च सर्वम् ।\nउक्त्वाऽहं वः प्रपतिष्याम्यनन्तरं\nत्वरयन्ति मां ब्राह्मणा लोकपालाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111040, "chapter_id": 3402, "verse_number": "८", "content_sanskrit": "सतां सकाशे तु वृतः प्रपातः\nते सङ्गता गुणवन्तश्च सर्वे ।\nशक्राच्च लब्धो हि वरो मयैष\nपतिष्यता भूमितळे नरेन्द्र\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111041, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111042, "chapter_id": 3402, "verse_number": "९", "content_sanskrit": "पृच्छामि त्वां प्रपतन्तं प्रपातं\nयदि मे लोका पार्थिव तत्र सन्ति ।\nयद्यन्तरिक्षे यदि वा दिवि श्रिताः\nक्षेत्रज्ञं त्वां तस्य धर्मस्य मन्ये \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111043, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111044, "chapter_id": 3402, "verse_number": "१०", "content_sanskrit": "यावत् पृथिव्यां व्रीहियवं गवाश्वं\nसहारण्यैः पशुभिः पर्वतैश्च ।\nतावन्तो लोका दिवि संस्थितास्ते\nतथा विजानीहि नरेन्द्रसिंह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111045, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111046, "chapter_id": 3402, "verse_number": "११", "content_sanskrit": "तांस्ते ददामि मा प्रपत प्रपातं\nये मे लोका दिवि राजेन्द्र सन्ति ।\nयद्यन्तरिक्षे यदि वा दिवि श्रिताः\nतानाक्रमस्व क्षिप्रममित्रसाह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111047, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111048, "chapter_id": 3402, "verse_number": "१२", "content_sanskrit": "नास्मद्विधः क्षत्रियवंशजातः प्रतिग्रहे वर्तते क्षत्रमुख्य ।\nयथा प्रदेयं सततं द्विजेभ्यः तथाऽददं पूर्वमहं द्विजेभ्यः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111049, "chapter_id": 3402, "verse_number": "१३", "content_sanskrit": "नाब्राह्मणः कृपणं जातु जीवेद्\nदद्यान्न याचेदिति क्षत्रधर्मः ।\nसोऽहं यथा कृतपूर्वं चरेयं\nविवित्समानः किमुतात्र साधु\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111050, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "प्रतर्दनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111051, "chapter_id": 3402, "verse_number": "१४", "content_sanskrit": "पृच्छामि त्वां काशिराजोऽहमस्मि\nप्रतर्दनोऽहं यदि मे सन्ति लोकाः ।\nयद्यन्तरिक्षे यदि वा दिवि श्रिताः\nक्षेत्रज्ञं त्वां तस्य धर्मस्य मन्ये \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111052, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111053, "chapter_id": 3402, "verse_number": "१५", "content_sanskrit": "सन्त्येव लोका बहवस्ते नरेन्द्र\nएकैकशः सप्त सप्तैव ते च ।\nमधुच्युता घृतपृक्ता विशोकाः\nते तावन्तस्त्वां प्रतिपालयन्ति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111054, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "प्रतर्दनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111055, "chapter_id": 3402, "verse_number": "१६", "content_sanskrit": "तांस्ते ददामि मा प्रपत प्रपातं\nये मे लोकास्तव ते वै भवन्तु ।\nयद्यन्तरिक्षे यदि वा दिवि स्थिताः\nतानाक्रमस्व प्रददाम्यहं ते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111056, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111057, "chapter_id": 3402, "verse_number": "१७", "content_sanskrit": "न तुल्यतेजाः सुकृतं कामयेत \tयोगक्षेमं पार्थिव पार्थिवः सन् ।\nदैवादेशादापदं प्राप्य विद्वान् चरेन्नृशंसं नहि जातु राजा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111058, "chapter_id": 3402, "verse_number": "१८", "content_sanskrit": "धर्म्यं मार्गं चेतयामो यशस्यं\nकुर्यान्नृपो धर्ममवेक्षमाणः ।\nन मद्विधो धर्मबुद्धिः प्रजानन्\nकुर्यादेवं कृपणं मां यथाऽऽत्थ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111059, "chapter_id": 3402, "verse_number": "१९", "content_sanskrit": "कुर्यादेवं न कृतं यदन्यै-\nर्विवित्समानः किमुतात्र साधु ।\nधर्माधर्मौ सुविनिश्चित्य सम्यक्\nकार्याकार्येष्वप्रमत्तश्चरेद् यः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111060, "chapter_id": 3402, "verse_number": "२०", "content_sanskrit": "स वै धीरः सत्यसन्धः कृतात्मा\nराजा भवेल्लोकपालो महिम्ना ।\nयदा भवेत् संशयो धर्मकार्ये\nकामार्थौ वा यत्र विन्दन्ति सम्यक् ।\nकार्यं तत्र प्रथमं धर्मकार्यं\nयन्नो विरुद्ध्येदर्थकामौ स धर्मः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111061, "chapter_id": 3402, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111062, "chapter_id": 3402, "verse_number": "२१", "content_sanskrit": "ब्रुवाणमेवं नृपतिं ययातिं\nनृपोत्तमो वसुमनाश्चाब्रवीत् तम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111063, "chapter_id": 3402, "verse_number": "२९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायामादिपर्वणि\nएकाशीतितमोऽध्यायः ॥८१॥ ॥ सम्भवपर्वणि एकोनत्रिंशोऽध्यायः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]