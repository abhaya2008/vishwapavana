[{"id": 2147416, "chapter_id": 4188, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147417, "chapter_id": 4188, "verse_number": "१", "content_sanskrit": "स तु राजा पुनस्तस्याः कर्तुकामः स्वयंवरम् ।\nउपगम्याश्रमपदं गङ्गायामुनसङ्गमे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147418, "chapter_id": 4188, "verse_number": "२", "content_sanskrit": "गृहीतमाल्यदामां तां रथमारोप्य माधवीम् ।\nपूरुर्यदुश्च भगिनीम् आश्रमे पर्यधावताम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147419, "chapter_id": 4188, "verse_number": "३", "content_sanskrit": "नागयक्षमनुष्याणां पतत्रिमृगपक्षिणाम् ।\nशैलद्रुमवनौकानाम् आसीत् तत्र समागमः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147420, "chapter_id": 4188, "verse_number": "४", "content_sanskrit": "नानापुरुषदेश्यानामीश्वरैश्च समाकुलम् ।\nऋषिभिश्च महाभागैः समन्तादावृतं वनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147421, "chapter_id": 4188, "verse_number": "५", "content_sanskrit": "निर्दिश्यमानेषु तु सा वरेषु वरवर्णिनी ।\nवरानुत्क्रम्य सर्वांस्तान् वरं वृतवती वनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147422, "chapter_id": 4188, "verse_number": "६", "content_sanskrit": "अवतीर्य रथात् कन्या नमस्कृत्य च बन्धुषु ।\nउपगम्य वनं पुण्यं तपस्तेपे ययातिजा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147423, "chapter_id": 4188, "verse_number": "७", "content_sanskrit": "उपवासैश्च विविधैः दीक्षाभिर्नियमैस्तथा ।\nआत्मनो लघुतां कृत्वा बभूव मृगचारिणी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147424, "chapter_id": 4188, "verse_number": "८", "content_sanskrit": "वैडूर्याङ्कुरकल्पानि मृदूनि हरितानि च ।\nचरन्ती श्लक्ष्णशष्पाणि तिक्तानि मधुराणि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147425, "chapter_id": 4188, "verse_number": "९", "content_sanskrit": "स्रवन्तीनां च पुण्यानां सुरसानि शुचीनि च ।\nपिबन्ती वारिमुख्यानि शीतानि विमलानि च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147426, "chapter_id": 4188, "verse_number": "१०", "content_sanskrit": "वनेष्वमृतकल्पेषु सिंहविप्रोषितेषु च ।\nदवाग्निविप्रमुक्तेषु शून्येषु गहनेषु च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147427, "chapter_id": 4188, "verse_number": "११", "content_sanskrit": "चरन्ती हरिणैः सार्धं मृगीव वनचारिणी ।\nचचार विपुलं धर्मं ब्रह्मचर्येण संवृता\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147428, "chapter_id": 4188, "verse_number": "१२", "content_sanskrit": "ययातिरपि पूर्वेषां राज्ञां वृत्तमनुष्ठितः ।\nबहुवर्षसहस्रायुः युयुजे कालधर्मणा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147429, "chapter_id": 4188, "verse_number": "१३", "content_sanskrit": "पूरुर्यदुश्च द्वौ वंशे वर्धमानौ नरोत्तमौ ।\nताभ्यां प्रतिष्ठितो लोको परलोके च नाहुषः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147430, "chapter_id": 4188, "verse_number": "१४", "content_sanskrit": "न हीयते नरपतिः ययातिः स्वर्गमास्थितः ।\nमहर्षिकल्पो नृपतिः स्वर्गाग्य्रफलभुग्विभुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147431, "chapter_id": 4188, "verse_number": "१५", "content_sanskrit": "अथ वर्षसहस्रान्ते काले बहुगुणे गते ।\nराजर्षिषु निषण्णेषु महीयस्सु महर्धिषु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147432, "chapter_id": 4188, "verse_number": "१६", "content_sanskrit": "अवमेने नरान् सर्वान् देवान् ऋषिगणांस्तथा ।\nययातिर्मूढविज्ञानो विस्मयाविष्टचेतनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147433, "chapter_id": 4188, "verse_number": "१७", "content_sanskrit": "ततस्तं बुबुधे देवः शक्रो बलनिषूदनः ।\nते च राजर्षयः सर्वे धिग्धिगित्येवमब्रुवन्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147434, "chapter_id": 4188, "verse_number": "१८", "content_sanskrit": "विचारश्च समुत्पन्नो निरीक्ष्य नहुषात्मजम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147435, "chapter_id": 4188, "verse_number": "१९", "content_sanskrit": "कोन्वयं कस्य वा राज्ञः कथं वा स्वर्गमागतः ।\nकर्मणा केन सिद्धोऽयं क्व वाऽनेन तपश्चितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147436, "chapter_id": 4188, "verse_number": "२०", "content_sanskrit": "एवं विचारयन्तस्ते राजानं स्वर्गवासिनः ।\nदृष्ट्वा पप्रच्छुरन्योन्यं ययातिं नृपतिं प्रति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147437, "chapter_id": 4188, "verse_number": "२१", "content_sanskrit": "विमानपालाः शतशः स्वर्गद्वाराभिरक्षिणः ।\nपृष्टा आसनपालाश्च न जानीम इति ब्रुवन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147438, "chapter_id": 4188, "verse_number": "२२", "content_sanskrit": "सर्वे ते ह्यावृतज्ञाना नाभ्यजानन्त तं नृपम् ।\nस मुहूर्तादथ नृपो हतौजाश्चाभवत् तदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147439, "chapter_id": 4188, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनविंशोत्तरशततमोऽध्यायः ॥११९॥\nभगवद्यानपर्वणि पञ्चाशोऽध्यायः ॥५०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]