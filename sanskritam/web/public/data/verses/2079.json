[{"id": 2049118, "chapter_id": 2079, "verse_number": "७-१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049119, "chapter_id": 2079, "verse_number": "७-१-१", "content_sanskrit": "कर्णस्य वचनं श्रुत्वा राजा दुर्योधनस्तदा।\nसेनामध्यगतं द्रोणमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049120, "chapter_id": 2079, "verse_number": "७-१-२x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049121, "chapter_id": 2079, "verse_number": "७-१-२", "content_sanskrit": "वर्णश्रैष्ठ्यात्कुलोत्पत्त्या श्रुतेन वयसा धिया।\nवीर्याद्दाक्ष्यादधृष्यत्वादर्थज्ञानान्नयाज्जयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049122, "chapter_id": 2079, "verse_number": "७-१-३", "content_sanskrit": "तपसा च कृतज्ञत्वाद्वृद्धः सर्वगुणैरपि।\nयुक्तो भवत्सश्रो गोप्ता राज्ञामन्यो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049123, "chapter_id": 2079, "verse_number": "७-१-४", "content_sanskrit": "स भवान्पातु नः सर्वान्देवानिव शतक्रतुः।\nभवन्नेत्राः पराञ्जेतुमिच्छामो द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049124, "chapter_id": 2079, "verse_number": "७-१-५", "content_sanskrit": "रुद्राणामिव कापालिर्वसूनामिव पावकः।\nकुबेर इव यक्षाणां मरुतामिव वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049125, "chapter_id": 2079, "verse_number": "७-१-६", "content_sanskrit": "वसिष्ठ इव विप्राणां तेजसामिव भास्करः।\nपितॄणामिव धर्मेन्द्रो यादसामिव चाम्बुराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049126, "chapter_id": 2079, "verse_number": "७-१-७", "content_sanskrit": "नक्षत्राणामिव शशी दितिजानामिवोशनाः।\n`सर्वेषामिव लोकानां विश्वस्य च यथा क्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049127, "chapter_id": 2079, "verse_number": "७-१-८", "content_sanskrit": "विश्वोत्पत्तिस्थितिलये श्रेष्ठो नारायणः प्रभुः।\nएवं सेनाप्रणेतॄणां मम सेनापतिर्भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049128, "chapter_id": 2079, "verse_number": "७-१-९", "content_sanskrit": "अक्षौहिण्यो दशैका च वशगाः सन्तु तेऽनघ।\nताभिः शत्रून्प्रतिव्यूह्य जहीन्द्रो दानवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049129, "chapter_id": 2079, "verse_number": "७-१-१०", "content_sanskrit": "प्रयातु नो भवानग्रे देवानामिव पावकिः।\nअनुयास्यामहे त्वाऽऽजौ सौरभेया इवर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049130, "chapter_id": 2079, "verse_number": "७-१-११", "content_sanskrit": "उग्रधन्वा महेष्वासो दिव्यं विष्फारयन्धनुः।\nदृष्ट्वा भवन्तं सङ्ग्रामे नार्जुनः प्रहरिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049131, "chapter_id": 2079, "verse_number": "७-१-१२", "content_sanskrit": "ध्रुवं युधिष्ठिरं सङ्ख्ये सानुबन्धं सबान्धवम्।\nजेष्यामि पुरुषव्याघ्र भवान्सेनापतिर्यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049132, "chapter_id": 2079, "verse_number": "७-१-१३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049133, "chapter_id": 2079, "verse_number": "७-१-१३", "content_sanskrit": "एवमुक्ते ततो द्रोणं जयेत्यूचुर्नराधिपाः।\nसिंहनादेन महता हर्षयन्तस्तवात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049134, "chapter_id": 2079, "verse_number": "७-१-१४", "content_sanskrit": "सैनिकाश्च मुदा युक्ता वर्धयन्ति द्विजोत्तमम्।\nदुर्योधनं पुरस्कृत्य प्रार्थयन्तो महद्यशः।\nदुर्योधनं ततो राजन्द्रोणो वचनमब्रवीत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049135, "chapter_id": 2079, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि षष्ठोऽध्यायः॥ ६ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१-४ भवान्नेस्रं तेना येषां ते॥ ५-१-६ धर्मेन्द्रो यमः। अम्बुराट् वरुणः॥ ५-१-१० पावकिः स्कन्दः॥ ५-१-६ षष्टोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]