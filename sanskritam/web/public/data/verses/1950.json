[{"id": 2042549, "chapter_id": 1950, "verse_number": "५-१९५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042550, "chapter_id": 1950, "verse_number": "५-१९५-१", "content_sanskrit": "ततः प्रभाते विमले धार्तराष्ट्रेण चोदिताः।\nदुर्योधनेन राजानः प्रययुः पाण्डवान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042551, "chapter_id": 1950, "verse_number": "५-१९५-२", "content_sanskrit": "आप्लाव्य शुचयः सर्वे स्रग्विणः शुक्लवाससः।\nगृहीतशस्त्रा ध्वजिनः स्वस्ति वाच्य हुताग्नयः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042552, "chapter_id": 1950, "verse_number": "५-१९५-३", "content_sanskrit": "सर्वे ब्रह्मविदः शूराः सर्वे सुचरितव्रताः ।\nसर्वे कामकृतश्चैव सर्वे चाहवलक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042553, "chapter_id": 1950, "verse_number": "५-१९५-४", "content_sanskrit": "आहवेषु पराँल्लोकाञ्जिगीषन्तो महाबलाः ।\nएकाग्रमनसः सर्वे श्रद्दधानाः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042554, "chapter_id": 1950, "verse_number": "५-१९५-५", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ केकया बाह्लिकैः सह ।\nप्रययुः सर्व एवैते भारद्वाजपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042555, "chapter_id": 1950, "verse_number": "५-१९५-६", "content_sanskrit": "अश्वत्थामा शान्तनवः सैन्धवोऽथ जयद्रथः।\nदाक्षिणात्याः प्रतीच्याश्च पार्वतीयाश्च ने नृपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042556, "chapter_id": 1950, "verse_number": "५-१९५-७", "content_sanskrit": "गान्धारराजः शकुनिः प्राच्योदीच्याश्च सर्वशः ।\nशकाः किराता यवनाः शिबयोऽथ वसातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042557, "chapter_id": 1950, "verse_number": "५-१९५-८", "content_sanskrit": "स्वैः स्वैरनीकैः सहिताः परिवार्य महारथम् ।\nएते महारथाः सर्वे द्वितीये निर्ययुर्बले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042558, "chapter_id": 1950, "verse_number": "५-१९५-९", "content_sanskrit": "कृतवार्मा सहानीकस्त्रिगर्तश्च महारथः ।\nदुर्योधनश्च नृपतिर्भ्रातृभिः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042559, "chapter_id": 1950, "verse_number": "५-१९५-१०", "content_sanskrit": "शलो भूरिश्रवाः शल्यः कौसल्योऽथ बृहद्रथः ।\nएते पश्चादनुगता धार्तराष्ट्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042560, "chapter_id": 1950, "verse_number": "५-१९५-११", "content_sanskrit": "ते समेत्य यथान्यायं धार्तराष्ट्रा महाबलाः।\nकुरुक्षेत्रस्य पश्चार्धे व्यवातिष्ठन्त दंशिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042561, "chapter_id": 1950, "verse_number": "५-१९५-१२", "content_sanskrit": "दुर्योधनस्तु शिबिरं कारयामास भारत ।\nयथैव हास्तिनपुरं द्वितीयं समलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042562, "chapter_id": 1950, "verse_number": "५-१९५-१३", "content_sanskrit": "न विशेषं विजानन्ति पुरस्य शिबिरस्य वा ।\nकुशला अपि राजेन्द्र नरा नगरवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042563, "chapter_id": 1950, "verse_number": "५-१९५-१४", "content_sanskrit": "तादृशान्येव दुर्गाणि राज्ञामपि महीपतिः ।\nकारयामास कौरव्यः शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042564, "chapter_id": 1950, "verse_number": "५-१९५-१५", "content_sanskrit": "पञ्चयोजनमुत्सृज्य माण्डलं तद्रणाजिरम् ।\nसेनानिवेशास्ते राजन्नाविशञ्छतसङ्घशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042565, "chapter_id": 1950, "verse_number": "५-१९५-१६", "content_sanskrit": "तत्र ते पृथिवीपाला यथोत्साहं यथाबलम् ।\nविविशुः शिबिराण्यत्र द्रव्यवन्ति सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042566, "chapter_id": 1950, "verse_number": "५-१९५-१७", "content_sanskrit": "तेषां दुर्योधनो राजा ससैन्यानां महात्मनाम् ।\nव्यादिदेश स बाह्यानां भक्ष्यभोज्यमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042567, "chapter_id": 1950, "verse_number": "५-१९५-१८", "content_sanskrit": "सनागाश्वमनुण्याणां ये च शिल्पोपजीविनः ।\nये चान्येऽनुगतास्तत्र सूतमागधबन्दिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042568, "chapter_id": 1950, "verse_number": "५-१९५-१९", "content_sanskrit": "वणिजो गणिकाश्चारा ये चैव प्रेक्षका जनाः ।\nसर्वांस्तन्कौरवो राजा विधिवत्प्रत्यवैक्षत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042569, "chapter_id": 1950, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वमि पञ्चनवत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]