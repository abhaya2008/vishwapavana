[{"id": 2193194, "chapter_id": 5108, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2193195, "chapter_id": 5108, "verse_number": "१", "content_sanskrit": "स मोक्षमनुचिन्त्यैव शुकः पितरमभ्यगात्।\nप्राहाभिवाद्य च गुरुं श्रेयोर्थी विनयान्वितः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2193196, "chapter_id": 5108, "verse_number": "२", "content_sanskrit": "मोक्षधर्मेषु कुशलो भगवान् प्रब्रवीतु मे ।\nयथा मे मनसः शान्तिः परमा सम्भवेत् प्रभो\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2193197, "chapter_id": 5108, "verse_number": "३", "content_sanskrit": "श्रुत्वा पुत्रस्य वचनंपरमर्षिरुवाच तम् ।\nअधीष्वपुत्र मोक्षं वै धर्मांश्च विविधानपि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2193198, "chapter_id": 5108, "verse_number": "४", "content_sanskrit": "पितुर्नियोगाज्जग्राहशुको ब्रह्मविदां वरः ।\nयोगशास्त्रं च निखिलं कापिलं चैव भारत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2193199, "chapter_id": 5108, "verse_number": "५", "content_sanskrit": "स तंब्राह्म्या श्रिया युक्तं ब्रह्मतुल्यपराक्रमम् ।\nमेने पुत्रं यदा व्यासो मोक्षविद्याविशारदम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2193200, "chapter_id": 5108, "verse_number": "६", "content_sanskrit": "उवाच गच्छेति तदा जनकं मिथिलेश्वरम् ।\nस ते वक्ष्यति मोक्षार्थं निखिलेनविशेषतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2193201, "chapter_id": 5108, "verse_number": "७", "content_sanskrit": "पितुर्नियोगादगमन्मैथिलं जनकं नृपम् ।\nप्रष्टुं धर्मस्य निष्ठां वै मोक्षस्य च परायणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2193202, "chapter_id": 5108, "verse_number": "८", "content_sanskrit": "उक्तश्चमानुषेण त्वं पथा गच्छेत्यविस्मितः ।\nन प्रभावेण गन्तव्यमन्तरिक्षचरेण वै\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2193203, "chapter_id": 5108, "verse_number": "९", "content_sanskrit": "आर्जवेणैवगन्तव्यं न सुखान्वेषिणा पथा ।\nनान्वेष्टव्या विशेषास्तु विशेषा हि प्रसङ्गिनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2193204, "chapter_id": 5108, "verse_number": "१०", "content_sanskrit": "अहङ्कारो न कर्तव्यो याज्ये तस्मिन्नराधिपे ।\nस्थातव्यं च वशे तस्य स ते छेत्स्यति संशयम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2193205, "chapter_id": 5108, "verse_number": "११", "content_sanskrit": "स धर्मकुशलो राजा मोक्षशास्त्रविशारदः ।\nयाज्यो मम स यद् ब्रूयात्तत् कार्यमविशङ्कया\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2193206, "chapter_id": 5108, "verse_number": "१२", "content_sanskrit": "एवमुक्तः स धर्मात्मा जगाम मिथिलां मुनिः ।\nपद्भ्यां शक्तोऽन्तरिक्षेण क्रान्तुं भूमिंससागराम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2193207, "chapter_id": 5108, "verse_number": "१३", "content_sanskrit": "स गिरींश्चाप्यतिक्रम्य नदीस्तीर्त्वा सरांसि च ।\nबहुव्यालमृगाकीर्णा विविधाश्चाटवीस्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2193208, "chapter_id": 5108, "verse_number": "१४", "content_sanskrit": "मेरोर्हरेश्च द्वे वर्षेवर्षं हैमवतं तथा ।\nक्रमेणैव व्यतिक्रम्य भारतं वर्षमासदत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2193209, "chapter_id": 5108, "verse_number": "१५", "content_sanskrit": "स देशान्विविधान् पश्यंश्चीनहूणनिषेवितान्।\nआर्यावर्तमिमं देशमाजगाम महामुनिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2193210, "chapter_id": 5108, "verse_number": "१६", "content_sanskrit": "पितुर्वचनमाज्ञाय तमेवार्थं विचिन्तयन् ।\nअध्वानं सोऽतिचक्राम खचरः खे चरन्निव\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2193211, "chapter_id": 5108, "verse_number": "१७", "content_sanskrit": "पत्तनानि च रम्याणि स्फीतानि नगराणि च ।\nरत्नानि च विचित्राणि शुकः पश्यन्नपश्यति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2193212, "chapter_id": 5108, "verse_number": "१८", "content_sanskrit": "उद्यानानि च रम्याणि तथैवायतनानि च ।\nपुण्यानि चैव तीर्थानि सोऽतिक्रम्य तथाध्वनः\t॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2193213, "chapter_id": 5108, "verse_number": "१९", "content_sanskrit": "सोऽचिरेणैव कालेन विदेहानाससाद ह ।\nरक्षितान्धर्मराजेन जनकेनमहात्मना\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2193214, "chapter_id": 5108, "verse_number": "२०", "content_sanskrit": "तत्र ग्रामान् बहून् पश्यन् बह्वन्नरसभोजनान्।\nपल्लीघोषान् समृद्धांश्च बहुगोकुलसङ्कुलान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2193215, "chapter_id": 5108, "verse_number": "२१", "content_sanskrit": "स्फीतांश्च शालियवसैर्हंससारससेवितान् ।\nपद्मिनीभिश्च शतशः श्रीमतीभिरलङ्कृतान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2193216, "chapter_id": 5108, "verse_number": "२२", "content_sanskrit": "स विदेहानतिक्रम्य समृद्धजनसेवितान् ।\nमिथिलोपवनं रम्यमाससाद महर्द्धिमत्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2193217, "chapter_id": 5108, "verse_number": "२३", "content_sanskrit": "हस्त्यश्वरथसङ्कीर्णं नरनारीसमाकुलम्।\nपश्यन्नपश्यन्निव तत् समतिक्रामदच्युतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2193218, "chapter_id": 5108, "verse_number": "२४", "content_sanskrit": "मनसा तं वहन् भारं तमेवार्थं विचिन्तयन् ।\nआत्मारामः प्रसन्नात्मामिथिलामाससाद ह\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2193219, "chapter_id": 5108, "verse_number": "२५", "content_sanskrit": "तस्या द्वारं समासाद्य द्वारपालैर्निवारितः ।\nस्थितो ध्यानपरो मुक्तोविदितः प्रविवेश ह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2193220, "chapter_id": 5108, "verse_number": "२६", "content_sanskrit": "स राजमार्गमासाद्य समृद्धजनसङ्कुलम् ।\nपार्थिवक्षयमासाद्य निःशङ्कः प्रविवेश ह\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2193221, "chapter_id": 5108, "verse_number": "२७", "content_sanskrit": "तत्रापि द्वारपालास्तमुग्रवाचो न्यषेधयन् ।\nतथैवच शुकस्तत्र निर्मन्युः समतिष्ठत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2193222, "chapter_id": 5108, "verse_number": "२८", "content_sanskrit": "न चातपाध्वसन्तप्तः क्षुत्पिपासाश्रमान्वितः ।\nप्रताम्यति ग्लायति वा नापैति च तथातपात्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2193223, "chapter_id": 5108, "verse_number": "२९", "content_sanskrit": "तेषां तु द्वारपालानामेकः शोकसमन्वितः ।\nमध्यङ्गतमिवादित्यं दृष्ट्वा शुकमवस्थितम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2193224, "chapter_id": 5108, "verse_number": "३०", "content_sanskrit": "पूजयित्वा यथान्यायमभिवाद्य कृताञ्जलिः ।\nप्रावेशयत्ततः कक्ष्यां द्वितीयांराजवेश्मनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2193225, "chapter_id": 5108, "verse_number": "३१", "content_sanskrit": "तत्रासीनः शुकस्तातमोक्षमेवानुचिन्तयन् ।\nछायायामातपे चैव समदर्शी महाद्युतिः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2193226, "chapter_id": 5108, "verse_number": "३२", "content_sanskrit": "तं मुहूर्तादिवागम्य राज्ञो मन्त्री कृताञ्जलिः ।\nप्रावेशयत्ततः कक्ष्यां तृतीयांराजवेश्मनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2193227, "chapter_id": 5108, "verse_number": "३३", "content_sanskrit": "तत्रान्तःपुरसम्बद्धं महच्चैत्ररथोपमम् ।\nसुविभक्तजलाक्रीडं रम्यं पुष्पितपादपम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2193228, "chapter_id": 5108, "verse_number": "३४", "content_sanskrit": "तद्दर्शयित्वा स शुकं मन्त्री काननमुत्तमम् ।\nअर्हमासनमादिश्य निश्चक्राम ततः पुनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2193229, "chapter_id": 5108, "verse_number": "३५", "content_sanskrit": "तं चारुवेषाः सुश्रोण्यस्तरुण्यः प्रियदर्शनाः।\nसूक्ष्मरक्ताम्बरधरास्तप्तकाञ्चनभूषणाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2193230, "chapter_id": 5108, "verse_number": "३६", "content_sanskrit": "संलापोल्लापकुशला नृत्तगीतविशारदाः ।\nस्मितपूर्वाभिभाषिण्यो रूपेणाप्सरसां समाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2193231, "chapter_id": 5108, "verse_number": "३७", "content_sanskrit": "कामोपचारकुशला भावज्ञाः सर्वकोविदाः ।\nपरं पञ्चाशतो नार्यो वारमुख्याः समाद्रवन्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2193232, "chapter_id": 5108, "verse_number": "३८", "content_sanskrit": "पाद्यादीनि प्रतिग्राह्य पूजया परयार्च्य च ।\nदेशकालोपपन्नेनसाध्वन्नेनाप्यतर्पयन्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2193233, "chapter_id": 5108, "verse_number": "३९", "content_sanskrit": "तस्य भुक्तवतस्तात तदन्तःपुरकाननम् ।\nसुरम्यं दर्शयामासुरेकैकश्येनभारत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2193234, "chapter_id": 5108, "verse_number": "४०", "content_sanskrit": "क्रीडन्त्यश्च हसन्त्यश्च गायन्त्यश्चैव ताः शुकम्।\nउदारसत्त्वं सत्त्वज्ञाःसर्वाः पर्यचरंस्तदा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2193235, "chapter_id": 5108, "verse_number": "४१", "content_sanskrit": "आरणेयस्तु शुद्धात्मात्रिसंदेहस्त्रिकर्मकृत् ।\nवश्येन्द्रियो जितक्रोधो न हृष्यति न कुप्यति\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2193236, "chapter_id": 5108, "verse_number": "४२", "content_sanskrit": "तस्मै शय्यासनं दिव्यं वरार्हंरत्नभूषितम् ।\nस्पर्ध्यास्तरणसंस्तीर्णं ददुस्ताः परमस्त्रियः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2193237, "chapter_id": 5108, "verse_number": "४३", "content_sanskrit": "पादशौचं तु कृत्वैव शुकः सन्ध्यामुपास्य च ।\nनिषसादासने पुण्ये तमेवार्थंविचिन्तयन्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2193238, "chapter_id": 5108, "verse_number": "४४", "content_sanskrit": "पूर्वरात्रे तु तत्रासौ भूत्वा ध्यानपरायणः ।\nमध्यरात्रे यथान्यायं निद्रामाहारयत्प्रभुः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2193239, "chapter_id": 5108, "verse_number": "४५", "content_sanskrit": "ततो मुहूर्तादुत्थाय कृत्वा शौचमनन्तरम् ।\nस्त्रीभिः परिवृतो धीमान् ध्यानमेवान्वपद्यत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2193240, "chapter_id": 5108, "verse_number": "४६", "content_sanskrit": "अनेन विधिना कार्ष्णिस्तदहःशेषमच्युतः ।\nतां च रात्रिं नृपकुलेवर्तयामास भारत\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2193241, "chapter_id": 5108, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे सप्तपञ्चाशोत्तरशततमोऽध्यायः ॥१५७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]