[{"id": 2046559, "chapter_id": 2034, "verse_number": "६-८३-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2046560, "chapter_id": 2034, "verse_number": "६-८३-१", "content_sanskrit": "बहूनि हि विचित्राणि द्वैरथानि स्म सञ्जय।\nपाण्डूनां मामकैः सार्धमश्रौषं तव जल्पतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2046561, "chapter_id": 2034, "verse_number": "६-८३-२", "content_sanskrit": "न चैव मामकं किंचिद्धृष्टं शंससि सञ्जय ।\nनित्यं पाण्डुसुतान्हृष्टानभग्नान्संप्रशंससि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2046562, "chapter_id": 2034, "verse_number": "६-८३-३", "content_sanskrit": "जीयमानान्विमनसो मामकान्विगतौजसः ।\nवदसे संयुगे सूत दिष्टमेतन्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046563, "chapter_id": 2034, "verse_number": "६-८३-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046564, "chapter_id": 2034, "verse_number": "६-८३-४", "content_sanskrit": "यथाशक्ति यथोत्साहं युद्धे चेष्टन्ति तावकाः।\nदर्शयानाः परं शक्त्या पौरुषं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046565, "chapter_id": 2034, "verse_number": "६-८३-५", "content_sanskrit": "गङ्गायाः सुरनद्या वै स्वादुभूतं यथोदकम् ।\nमहोदधिसमभ्याशे लवणत्वं निगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046566, "chapter_id": 2034, "verse_number": "६-८३-६", "content_sanskrit": "तथा तत्पौरुषं राजंस्तावकानां परंतप ।\nप्राप्य पाण्डुसुतान्वीरान्व्यर्थं भवति संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046567, "chapter_id": 2034, "verse_number": "६-८३-७", "content_sanskrit": "घटमानान्यथाशक्ति कुर्वाणान्कर्म दुष्करम् ।\nन दोषेण कुरुश्रेष्ठ कौरवान्गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046568, "chapter_id": 2034, "verse_number": "६-८३-८", "content_sanskrit": "तवापराधात्सुमहान्सपुत्रस्य विशांपते ।\nपृतिव्याः प्रक्षयो घोरो यमराष्ट्रविवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046569, "chapter_id": 2034, "verse_number": "६-८३-९", "content_sanskrit": "आत्मदोषात्समुत्पन्नं शोचितुं नार्हसे नृप ।\nन हि रक्षन्ति राजानः सर्वथाऽत्रापि जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046570, "chapter_id": 2034, "verse_number": "६-८३-१०", "content_sanskrit": "युद्धे सुकृतिनां लोकानिच्छन्तो वसुधाधिपाः।\nचमूं विगाह्य युद्ध्यन्ते नित्यं स्वर्गपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046571, "chapter_id": 2034, "verse_number": "६-८३-११", "content_sanskrit": "पूर्वाह्णे तु महाराज प्रावर्तत जनक्षयः।\nतं त्वमेकमना भूत्वा शृणु देवासुरोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046572, "chapter_id": 2034, "verse_number": "६-८३-१२", "content_sanskrit": "आवन्त्यौ तु महेष्वासौ महासेनौ महाबलौ ।\nयुधामन्युमभिप्रेक्ष्य समेयता रणोत्कटौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046573, "chapter_id": 2034, "verse_number": "६-८३-१३", "content_sanskrit": "तेषां प्रववृते युद्धं समुहद्रोणहर्षणम् ।\nयुधामन्युः सुसंक्रुद्धो भ्रातरौ देवरूपिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046574, "chapter_id": 2034, "verse_number": "६-८३-१४", "content_sanskrit": "विव्याध निशितैस्तूर्णं शरैः सन्नतपर्वभिः।\nतावेनं प्रत्यविध्येतां समरे चित्रयोधिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046575, "chapter_id": 2034, "verse_number": "६-८३-१५", "content_sanskrit": "युध्यतां हि तथा राजन्विशेषो न व्यदृश्यत ।\nयततां शत्रुनाशाय कृतप्रतिकृतैषिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046576, "chapter_id": 2034, "verse_number": "६-८३-१६", "content_sanskrit": "युधामन्युस्ततो राजन्ननुविन्दस्य सायकैः ।\nचतुर्भिश्चतुरो वाहाननयद्यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046577, "chapter_id": 2034, "verse_number": "६-८३-१७", "content_sanskrit": "भल्लाभ्यां च सुतीक्ष्णाभ्यां धनुः केतुं च मारिष ।\nचिच्छेद समरे राजंस्तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046578, "chapter_id": 2034, "verse_number": "६-८३-१८", "content_sanskrit": "त्यक्त्वाऽनुविन्दोऽथ रथं विन्दस्य रथमास्थितः।\nधनुर्गृहीत्वा परमं भारसाधनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046579, "chapter_id": 2034, "verse_number": "६-८३-१९", "content_sanskrit": "तावेकस्थौ रणे वीरावावन्त्यौ रथिनां वरौ।\nशरान्मुमुचतुस्तूर्णं युधामन्यौ महात्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046580, "chapter_id": 2034, "verse_number": "६-८३-२०", "content_sanskrit": "ताभ्यां मुक्ता महावेगाः शराः काञ्चनभूषणाः ।\nदिवाकरपथं प्राप्य च्छादयामासुरम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046581, "chapter_id": 2034, "verse_number": "६-८३-२१", "content_sanskrit": "युधामन्यू रणे क्रुद्धो भ्रातरौ तौ महारथौ ।\nववर्ष शरवर्षेण सारथिं चाप्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046582, "chapter_id": 2034, "verse_number": "६-८३-२२", "content_sanskrit": "तस्मिंस्तु पतिते भूमौ गतसत्वे तु सारथौ ।\nरथः प्रदुद्राव दिशः समुद्धान्तहयस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046583, "chapter_id": 2034, "verse_number": "६-८३-२३", "content_sanskrit": "तौ स जित्वा महाराज यज्ञसेनसुतः प्रभुः।\nपौरुषं ख्यापयंस्तूर्णं व्यधमत्तव वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046584, "chapter_id": 2034, "verse_number": "६-८३-२४", "content_sanskrit": "सा वध्यमाना समरे धार्तराष्ट्री महाचमूः ।\nवेगान्बहुविधांश्चक्रे विषं पीत्वेन मानवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046585, "chapter_id": 2034, "verse_number": "६-८३-२५", "content_sanskrit": "हैडिम्बो राक्षसेन्द्रस्तु भगदत्तं समाद्रवत्।\nरथेनादित्यवर्णेन सध्वजेन महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046586, "chapter_id": 2034, "verse_number": "६-८३-२६", "content_sanskrit": "ततः प्राग्ज्योतिषो राजा नागराजं समास्थितःक ।\nयथा वज्रधरः पूर्वं संग्रामे तारकामये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046587, "chapter_id": 2034, "verse_number": "६-८३-२७", "content_sanskrit": "तत्र देवाः सगन्धर्वा ऋषयश्च समागताः ।\nविशेषं न स्म विविदुर्हैडिम्बभगदत्तयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046588, "chapter_id": 2034, "verse_number": "६-८३-२८", "content_sanskrit": "यथा सुरपतिः शक्रस्त्रासयामास दानवान्।\nतथैव समरे राजा द्रावयामास पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046589, "chapter_id": 2034, "verse_number": "६-८३-२९", "content_sanskrit": "तेन विद्राव्यमाणास्ते पाण्डवाः सर्वतो दिशम्।\nत्रातारं नाभ्यगच्छन्तः स्वेष्वनीकेषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046590, "chapter_id": 2034, "verse_number": "६-८३-३०", "content_sanskrit": "भैमसेनिं रथस्थं तु तत्रापश्याम भारत ।\nशेषा विमनसो भूत्वा प्राद्रवन्त महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046591, "chapter_id": 2034, "verse_number": "६-८३-३१", "content_sanskrit": "निवृत्तेषु तु पाण्डूनां पुनः सैन्येषु भारत ।\nआसीन्निष्ठानको घोरस्तव सैन्यस्य संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046592, "chapter_id": 2034, "verse_number": "६-८३-३२", "content_sanskrit": "घटोत्कचस्ततो राजन्भगदत्तं महारणे।\nशरैः प्रच्छादयामास मेरुं गिरिमिवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046593, "chapter_id": 2034, "verse_number": "६-८३-३३", "content_sanskrit": "निहत्य ताञ्शरान्राजा राक्षसस्य धनुश्र्युतान्।\nभैमसेनिं रणे तूर्णं सर्वमर्मस्वताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046594, "chapter_id": 2034, "verse_number": "६-८३-३४", "content_sanskrit": "स ताड्यमानो बहुभिः शरैः सन्नतपर्वभिः ।\nन विव्यथे राक्षसन्द्रो भिद्यमान इवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046595, "chapter_id": 2034, "verse_number": "६-८३-३५", "content_sanskrit": "तस्य प्राग्ज्योतिषः क्रुद्धस्तोमरांश्च चतुर्दश ।\nप्रेषयामास समरे तांश्चिच्छेद स राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046596, "chapter_id": 2034, "verse_number": "६-८३-३६", "content_sanskrit": "स तांश्छित्त्वा महाबाहुस्तोमरान्निशितैः शरैः ।\nभगदत्तं च विव्याध सप्तत्या कङ्कपत्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046597, "chapter_id": 2034, "verse_number": "६-८३-३७", "content_sanskrit": "ततः प्राग्ज्योतिषो राजा प्रहसन्निव भारत।\nतस्याश्वांश्चतुरः सङ्ख्ये पातयामास सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046598, "chapter_id": 2034, "verse_number": "६-८३-३८", "content_sanskrit": "स हताश्वे रथे तिष्ठन्राक्षसेन्द्रः प्रतापवान् ।\nशक्तिं चिक्षेप वेगेन प्रग्ज्योतिषगजं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046599, "chapter_id": 2034, "verse_number": "६-८३-३९", "content_sanskrit": "तामापतन्तीं सहसा हेमदण्डां सुवेगिनीम् ।\nत्रिधा चिच्छेद नृपतिः सा व्यकीर्यत मेदिनीं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046600, "chapter_id": 2034, "verse_number": "६-८३-४०", "content_sanskrit": "शक्तिं विनिहतां दृष्ट्वा हैडिम्बः प्राद्रवद्भयात् ।\nयथेन्द्रस्य रणात्पूर्वं नमुचिर्दैत्यसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046601, "chapter_id": 2034, "verse_number": "६-८३-४१", "content_sanskrit": "तं विजित्य रणे शूरं विक्रान्तं ख्यातपौरुषम् ।\nअजय्यं समरे वीरं यमेन वरुणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046602, "chapter_id": 2034, "verse_number": "६-८३-४२", "content_sanskrit": "पाण्डवीं समरे सेनां संममर्द स कुञ्जरः ।\nयथा वनगजो राजन्मृद्गश्चरति पद्मिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046603, "chapter_id": 2034, "verse_number": "६-८३-४३", "content_sanskrit": "मद्रेश्वरस्तु समरे यमाभ्यां समसञ्जत ।\nस्वस्त्रीयौ छादयांचक्रे शरौघैः पाण्डुनन्दनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2046604, "chapter_id": 2034, "verse_number": "६-८३-४४", "content_sanskrit": "सहदेवस्तु समरे मातुलं दृश्य संगतम् ।\nअवारयच्छरौघेण मेघो यद्वद्दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2046605, "chapter_id": 2034, "verse_number": "६-८३-४५", "content_sanskrit": "छाद्यमानः शरौघेण हृष्टरूपतरोऽभवत् ।\nतयोश्चाप्यभवत्प्रीतिरतुला मातृकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2046606, "chapter_id": 2034, "verse_number": "६-८३-४६", "content_sanskrit": "ततः प्रहस्य समरे नकुलस्य महारथः।\n` ध्वजं चिच्छेद बाणेन धनुश्चैकेन मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2046607, "chapter_id": 2034, "verse_number": "६-८३-४७", "content_sanskrit": "अथैनं छिन्नधन्वानं छादयामास भारत।\nनिजघान रणे तं तु सूतं चास्य न्यपातयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2046608, "chapter_id": 2034, "verse_number": "६-८३-४८", "content_sanskrit": "ततः प्रसह्य समरे नकुलस्य महारथः ।\nअश्वांश्च चतुरो राजंश्चतुर्भिः सायकोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2046609, "chapter_id": 2034, "verse_number": "६-८३-४९", "content_sanskrit": "प्रेषयामास समरे यमस्य सदनं प्रति।\nहताश्वात्तु रथात्तूर्णमवप्लुत्य महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2046610, "chapter_id": 2034, "verse_number": "६-८३-५०", "content_sanskrit": "आरुरोह ततो यानं भ्रातुरेव यशस्विनः ।\nएकस्थौ तु रणे शूरौ दृढे विक्षिप्य कार्मुके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2046611, "chapter_id": 2034, "verse_number": "६-८३-५१", "content_sanskrit": "मद्रराजरथं तूर्णं च्छादयामासतुः क्षणात्।\nस च्छाद्यमानो बहुभिः शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2046612, "chapter_id": 2034, "verse_number": "६-८३-५२", "content_sanskrit": "स्वस्त्रीयाभ्यां नरव्याघ्रो नाकम्पत यथाऽचलः।\nप्रहसन्निव तां चापि शस्त्रवृष्टिं जघान ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2046613, "chapter_id": 2034, "verse_number": "६-८३-५३", "content_sanskrit": "सहदेवस्ततः क्रुद्धः शरमुद्गृह्य वीर्यवान्।\nमद्रराजमभिप्रेक्ष्य प्रेषयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2046614, "chapter_id": 2034, "verse_number": "६-८३-५४", "content_sanskrit": "स शरः प्रेषितस्तेन गरुडानिलवेगवान् ।\nमद्रराजं विनिर्भिद्य निपपात महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2046615, "chapter_id": 2034, "verse_number": "६-८३-५५", "content_sanskrit": "स गाढविद्धो व्यथितो रथोपस्थे महारथः ।\nनिषसाद महाराज कश्मलं च जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2046616, "chapter_id": 2034, "verse_number": "६-८३-५६", "content_sanskrit": "तं विसंज्ञं निपतितं सूतः संप्रेक्ष्य संयुगे।\nअपोवाह रथेनाजौ यमाभ्यामभिपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2046617, "chapter_id": 2034, "verse_number": "६-८३-५७", "content_sanskrit": "दृष्ट्वा मद्रेश्वररथं धार्तराष्ट्राः पराङ्भुखम्।\nसर्वे विमनसो भूत्वा नेदमस्तीत्यचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2046618, "chapter_id": 2034, "verse_number": "६-८३-५८", "content_sanskrit": "निर्जित्य मातुलं सङ्ख्ये माद्रीपुत्रौ महारथौ ।\nदध्यतुर्मुदितौ शङ्खौ सिंहनादं च नेदतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2046619, "chapter_id": 2034, "verse_number": "६-८३-५९", "content_sanskrit": "अभिदुद्रुवतुर्हृष्टौ तव सैन्यं विशांपते ।\nयथा दैत्यचमूं राजन्निन्द्रोपेन्द्राविवामरौ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2046620, "chapter_id": 2034, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि सप्तमदिवसयुद्धे त्र्यशीतितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-८३-१२ इरावन्तमभिप्रेक्ष्य इति झo पाठः ॥ ६-८३-१३ इरावांस्तु सुसंक्रुद्ध इति झo पाठः ॥ ६-८३-१६ इरावांस्तु ततं इति झo पाठः ॥ ६-८३-१९ इरावति महात्मनीति झo पाठः ॥ ६-८३-२१ इरावांस्तु रणे इति झo पाठः ॥ ६-८३-२३ नागराजसुतासुत इति झo पाठः । तत्र नागराजः कौरव्यस्तस्य सुता उलूपी तस्याः सुत इरावानित्यर्थः ॥ ६-८३-३१ निष्ठानकः सव्यथः कशब्दः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]