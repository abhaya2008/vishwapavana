[{"id": 7006149000, "chapter_id": 26149, "verse_number": "१-२-१०-१", "content_sanskrit": "सूत उवाच ।\nएवं प्रजासन्निवेशं श्रुत्वा वै शांशपायनिः ।\nपप्रच्छ नियतं सूतं पृथिव्युद धिविस्तरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006149001, "chapter_id": 26149, "verse_number": "१-२-१०-२", "content_sanskrit": "कति द्वीपा समुद्रा वा पवता वा कति स्मृताः ।\nकियंति चैव वर्षाणि तेषु नद्यश्च काः स्मृताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006149002, "chapter_id": 26149, "verse_number": "१-२-१०-३", "content_sanskrit": "महा भूतप्रमाणं च लोकालोकं तथैव च ।\nपर्यायं परिमाणं च गतिं चन्द्रार्कयोस्तथा ।\nएतत्प्रबूहि नः सर्वं विस्तरेण यथार्थतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006149003, "chapter_id": 26149, "verse_number": "१-२-१०-४", "content_sanskrit": "सूत उवाच ।\nहंत वोऽहं प्रवक्ष्यामि पृथिव्यायामविस्तरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006149004, "chapter_id": 26149, "verse_number": "१-२-१०-५", "content_sanskrit": "संख्यां चैव समुद्राणां द्वीपानां चैव विस्तरम् ।\nद्वीपभेदसहस्राणि सप्तस्वन्तर्गतानि च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006149005, "chapter_id": 26149, "verse_number": "१-२-१०-६", "content_sanskrit": "न शक्यंते क्रमेणेह वक्तुं यैः सततं जगत् ।\nसप्त द्वीपान्प्रवक्ष्यामि चन्द्रादित्यग्रहैः सह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006149006, "chapter_id": 26149, "verse_number": "१-२-१०-७", "content_sanskrit": "तेषां मनुष्या स्तर्क्केण प्रमाणानि प्रचक्षते ।\nअचिंत्याः खलु ये भावा न तांस्तर्केण साधयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006149007, "chapter_id": 26149, "verse_number": "१-२-१०-८", "content_sanskrit": "प्रकृतिभ्यः परं यच्च तदचिन्त्यं प्रचक्षते ।\nनववर्षं प्रवक्ष्यामि जंबूद्वीपं यथातथम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006149008, "chapter_id": 26149, "verse_number": "१-२-१०-९", "content_sanskrit": "विस्तरान्मण्डलाच्चैव योजनैस्तन्निबोधत ।\nशतमेकं सहस्राणां योजनाग्रात्समंततः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006149009, "chapter_id": 26149, "verse_number": "१-२-१०-१०", "content_sanskrit": "नानाजनपदाकीर्णः पुरैश्च विविधैश्शुभैः ।\nसिद्धचारणसंकीणः पर्वतैरुपशोभितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006149010, "chapter_id": 26149, "verse_number": "१-२-१०-११", "content_sanskrit": "सर्वधातुनिबद्धैश्च शिलाजाल समुद्भवैः ।\nपर्वतप्रभवाभिश्च नदीभिः सर्वतस्ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006149011, "chapter_id": 26149, "verse_number": "१-२-१०-१२", "content_sanskrit": "जंबूद्वीपः पृथुः श्रीमान् सर्वतः पृथुमंडलः ।\nनवभिश्चावृतः सर्वो भुवनैर्भूतभावनैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006149012, "chapter_id": 26149, "verse_number": "१-२-१०-१३", "content_sanskrit": "लवणेन समुद्रेण सर्वतः परिवारितः ।\nजंबूद्वीपस्य विस्तारात् समेन तु समंततः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006149013, "chapter_id": 26149, "verse_number": "१-२-१०-१४", "content_sanskrit": "प्रागायताः सूपर्वाणः षडिमे वर्षपर्वताः ।\nअवगाढा ह्युभयतः मसुद्रौ पूर्वपश्चिमौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006149014, "chapter_id": 26149, "verse_number": "१-२-१०-१५", "content_sanskrit": "हिमप्रायश्च हिमवान् हेमकूटश्च हेमवान् ।\nसर्वर्त्तुषु सुखश्चापि निषधः पर्वतो महान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006149015, "chapter_id": 26149, "verse_number": "१-२-१०-१६", "content_sanskrit": "चतुर्वर्णश्च सौवर्णो मेरुश्चारुतमः स्मृतः ।\nद्वात्रिंशच्च सहस्राणि विस्तीर्णः स च मूर्द्धनि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006149016, "chapter_id": 26149, "verse_number": "१-२-१०-१७", "content_sanskrit": "वृत्ताकृतिप्रमाणश्च चतुरस्रः समुच्छ्रितः ।\nनानावर्णास्तु पार्श्वेषु प्रजापतिगुणान्वितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006149017, "chapter_id": 26149, "verse_number": "१-२-१०-१८", "content_sanskrit": "नाभिबंधनसंभूतो ब्रह्मणोऽव्यक्तजन्मनः ।\nपूर्वतः श्र्वेतवर्णश्च ब्राह्मणस्तस्य तेन तत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006149018, "chapter_id": 26149, "verse_number": "१-२-१०-१९", "content_sanskrit": "पार्श्वमुत्तरतस्तस्य रक्तवर्मः स्वभावतः ।\nतेनास्य क्षत्र्रभावस्तु मेरोर्नानार्थकारणात् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006149019, "chapter_id": 26149, "verse_number": "१-२-१०-२०", "content_sanskrit": "पीतश्च दक्षिणेनासौ तेन वैश्यत्वमिष्यते ।\nभृंगपत्रनिभश्चापि पश्चिमेन समाचितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006149020, "chapter_id": 26149, "verse_number": "१-२-१०-२१", "content_sanskrit": "तेनास्य शूद्रभावः स्यादिति वर्णाः प्रकीर्त्तिताः ।\nवृत्तः स्वभावतः प्रोक्तो वर्णतः परिमाणतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006149021, "chapter_id": 26149, "verse_number": "१-२-१०-२२", "content_sanskrit": "नीलश्च वैदुर्यमयः श्वेतः घुक्लो हिरण्मयः ।\nमयुरबर्हवर्णस्तु शातकौंभश्च श्रृंगवान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006149022, "chapter_id": 26149, "verse_number": "१-२-१०-२३", "content_sanskrit": "एते पर्वतराजानः सिद्धचारणसेविताः ।\nतेषामंतरविष्कंभो नवसाहस्र उच्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006149023, "chapter_id": 26149, "verse_number": "१-२-१०-२४", "content_sanskrit": "मध्ये त्विलावृतं नाम महामेरोः समंतमः ।\nनवैवं तु सहस्राणि विस्तीर्णं सर्वतस्तु तत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006149024, "chapter_id": 26149, "verse_number": "१-२-१०-२५", "content_sanskrit": "मध्ये तस्य महामेरुर्विधूम इव पावकः ।\nवेद्यर्द्धं दक्षिणं मेरोरुत्तरार्द्धं तथोत्तरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006149025, "chapter_id": 26149, "verse_number": "१-२-१०-२६", "content_sanskrit": "वर्षाणि यानि षट् चैव तेषां ये वर्षपर्वताः ।\nद्वे द्वे सहस्रे विस्तीर्णा योजनानां समुच्छ्रयात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006149026, "chapter_id": 26149, "verse_number": "१-२-१०-२७", "content_sanskrit": "जंबूद्वीपस्य विस्तारात्तेषामायाम उच्यते ।\nयोजनानां सहस्राणि शतं द्वावायतौ गिरी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006149027, "chapter_id": 26149, "verse_number": "१-२-१०-२८", "content_sanskrit": "नीलश्च निषधश्चैव ताभ्यां हीनास्तु ये परे ।\nश्वेतश्च हेमकूटश्च हिमवाञ्छृंगवांस्तथा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006149028, "chapter_id": 26149, "verse_number": "१-२-१०-२९", "content_sanskrit": "नवती द्वे अशीती द्वे सहस्राण्यायतास्तु तेः ।\nतेषां मध्ये जनपदास्तानि वर्णाणि सप्त वै ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006149029, "chapter_id": 26149, "verse_number": "१-२-१०-३०", "content_sanskrit": "प्रपातविषमैस्तैस्तु पर्वतैरावृतानि तु ।\nसंततानि नदीभेदैरगम्यानि परस्परम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006149030, "chapter_id": 26149, "verse_number": "१-२-१०-३१", "content_sanskrit": "वसंति तेषु सत्त्वानि नानाजातीनि सर्वशः ।\nइदं हैमवतं वर्षं भारतं नाम विश्रुतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006149031, "chapter_id": 26149, "verse_number": "१-२-१०-३२", "content_sanskrit": "हेमकूटं परं ह्यस्मा न्नान्ना किंषुरुपं स्मृतम् ।\nनैषधं हेमकूटात्तु हरिवर्षं तदुच्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006149032, "chapter_id": 26149, "verse_number": "१-२-१०-३३", "content_sanskrit": "हरिवर्षात्परं चापि मेरोश्व तदिलावृतम् ।\nिलावृतात्परं नीलं सम्यकं नाम विश्रुतम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006149033, "chapter_id": 26149, "verse_number": "१-२-१०-३४", "content_sanskrit": "रम्यकात्परतः श्र्वेतं विश्रुतं तद्धिरण्मयम् ।\nहिरण्मयात्परं चैव श्रृंगवत्तः कुरु स्मृतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006149034, "chapter_id": 26149, "verse_number": "१-२-१०-३५", "content_sanskrit": "धनुःसंस्थे तु विज्ञेये द्वे वर्षे दक्षिणोत्तरे ।\nदीर्घाणि तत्र चत्वारि मध्यमं तदिलावृतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006149035, "chapter_id": 26149, "verse_number": "१-२-१०-३६", "content_sanskrit": "अर्वाक् च निषधस्याथ वेद्यर्द्धं दक्षिणं स्मृतम् ।\nपरं नीलवतो यच्च वेद्यर्द्धं तु तदुत्तरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006149036, "chapter_id": 26149, "verse_number": "१-२-१०-३७", "content_sanskrit": "वेद्यर्द्धे दक्षिणे त्रीणि त्रीणि वर्षाणि चोत्तरे ।\nतयोर्मध्ये तु विज्ञेयो मेरुर्मध्य इलावृतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006149037, "chapter_id": 26149, "verse_number": "१-२-१०-३८", "content_sanskrit": "दक्षिणेन तु नीलस्य निषधस्योत्तरेम तु ।\nउदगायेतो महाशैलो माल्यवान्नाम नामतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006149038, "chapter_id": 26149, "verse_number": "१-२-१०-३९", "content_sanskrit": "योजनानां सहस्रं तु आनील निषधायतः ।\nआयामतश्चतुस्त्रिंशत्सहस्राणि प्रकीर्तितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006149039, "chapter_id": 26149, "verse_number": "१-२-१०-४०", "content_sanskrit": "तस्य प्रतीच्यां विज्ञेयः पर्वतो गंधमादनः ।\nआयामतोऽथ विस्तारान्माल्यवा नितिविश्रुतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006149040, "chapter_id": 26149, "verse_number": "१-२-१०-४१", "content_sanskrit": "परिमंडलयोर्मेरुर्मध्ये कनकपर्वतः ।\nचतुर्वणः स सौवर्णः चतुरस्रः समुच्छ्रितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006149041, "chapter_id": 26149, "verse_number": "१-२-१०-४२", "content_sanskrit": "सुमेरुः शुशुभेशुभ्रो राजव त्समधिष्ठितः ।\nतरुणादित्यवर्णाभो विधूम इव पावकः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006149042, "chapter_id": 26149, "verse_number": "१-२-१०-४३", "content_sanskrit": "योजनानां सहस्राणि चतुरशीतरुच्छ्रितः ।\nप्रविष्टः षोडशाधस्ताद्विस्तृतः षोडशैव तु ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006149043, "chapter_id": 26149, "verse_number": "१-२-१०-४४", "content_sanskrit": "शरावसंस्थितत्वात्तु द्वात्रिंशन्मूर्ध्निविस्तृतः ।\nविस्तारात्रिगुणस्तस्य परिणाहः समंततः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006149044, "chapter_id": 26149, "verse_number": "१-२-१०-४५", "content_sanskrit": "मंडलेन प्रमाणेन त्र्यस्रे मानं तदिष्यते ।\nचत्वारिंशत्सहस्राणि योजनानां समंततः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006149045, "chapter_id": 26149, "verse_number": "१-२-१०-४६", "content_sanskrit": "अष्टाभिरधिकानि स्युस्त्र्यस्रे मानं प्रकीर्त्तितम् ।\nचतुरस्रेण मानेन परिणाहः समंततः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006149046, "chapter_id": 26149, "verse_number": "१-२-१०-४७", "content_sanskrit": "चतुः षष्टिसहस्राणि योजनानां विधीयते ।\nस पर्वतो महादिव्यो दिव्यौषधिसमन्वितः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006149047, "chapter_id": 26149, "verse_number": "१-२-१०-४८", "content_sanskrit": "भुवनैरावृतः सर्वो जातरूपमयैः शुभैः ।\nतत्र देवगणाः सर्वे गंधर्वोरगराक्षसाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006149048, "chapter_id": 26149, "verse_number": "१-२-१०-४९", "content_sanskrit": "शैलराजे प्रदृश्यंते शुभाश्चाप्सरसां गणाः ।\nस तु मेरुः परिवृतो भुवनैर्भूतभावनैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006149049, "chapter_id": 26149, "verse_number": "१-२-१०-५०", "content_sanskrit": "चत्वारो यस्य देशा वै चतुःपार्श्वेष्वधिष्ठिताः ।\nभद्राश्वा भरताश्वैव केतुमालाश्च पश्चिमाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006149050, "chapter_id": 26149, "verse_number": "१-२-१०-५१", "content_sanskrit": "उत्तराः कुरवश्चैव कृतपुण्यप्रतिश्रयाः ।\nगंधमादनपर्श्वे तु परैषाऽपरगंडिका ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006149051, "chapter_id": 26149, "verse_number": "१-२-१०-५२", "content_sanskrit": "सर्वर्त्तुरमणीया च नित्यं प्रमुदिता शिवा ।\nद्वात्रिंशत्तु सहस्राणि योजनैः पूर्वपश्चिमात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006149052, "chapter_id": 26149, "verse_number": "१-२-१०-५३", "content_sanskrit": "आयामतश्चतुस्त्रिंशत्सहस्राणि प्रमाणतः ।\nतत्र ते शुभकर्माणः केतुमालाः प्रतिष्ठिताः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006149053, "chapter_id": 26149, "verse_number": "१-२-१०-५४", "content_sanskrit": "तत्र काला नराः सर्वे महासत्त्वा महाबलाः ।\nस्त्रियश्चोत्पल पत्राभाः सर्वास्ताः प्रियदर्शनाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006149054, "chapter_id": 26149, "verse_number": "१-२-१०-५५", "content_sanskrit": "तत्र दिव्यो महावृक्षः पनसः पड्रसाश्रयः ।\nईश्वरो ब्रह्मणः पुत्रः कामचारी मनोजवः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006149055, "chapter_id": 26149, "verse_number": "१-२-१०-५६", "content_sanskrit": "तस्य पीत्वा फलरसं जीवंति च समायुतम् ।\nपार्श्वे माल्यवतश्चापि पूर्वेऽपूर्वा तु गंडिका ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006149056, "chapter_id": 26149, "verse_number": "१-२-१०-५७", "content_sanskrit": "आयामादथ विस्ताराद्यथैषापरगंडिका ।\nभद्राश्वास्तत्र विज्ञेया नित्यं मुदितमानसाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006149057, "chapter_id": 26149, "verse_number": "१-२-१०-५८", "content_sanskrit": "भद्रशालवनं चात्र कालाम्रस्तु महाद्रुमः ।\nतत्र ते पुरुषाः स्वेता महोत्साहा बलान्विताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006149058, "chapter_id": 26149, "verse_number": "१-२-१०-५९", "content_sanskrit": "स्त्रियः कुमुदवर्णाभाः सुन्दर्यः प्रियदर्शनाः ।\nचन्द्रप्रभाश्चंद्रवर्णाः पूर्णचन्द्र निभाननाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006149059, "chapter_id": 26149, "verse_number": "१-२-१०-६०", "content_sanskrit": "चंद्रशीतलगात्र्यस्ताः स्त्रिय उत्पलगंधिकाः ।\nदशवर्षसहस्राणि तेषामायुरनामयम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006149060, "chapter_id": 26149, "verse_number": "१-२-१०-६१", "content_sanskrit": "कालाम्रस्य रसं पीत्वा सर्वे च स्थिरयौवनाः ।\nदक्षिणेन तु श्वेतस्य नीलस्यैवोत्तरेण च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006149061, "chapter_id": 26149, "verse_number": "१-२-१०-६२", "content_sanskrit": "वर्षं रमणकं नाम जायंते तत्र मानवाः ।\nरतिप्रधाना विमला जरादौर्गंध्यवर्जिताः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006149062, "chapter_id": 26149, "verse_number": "१-२-१०-६३", "content_sanskrit": "शुक्लाऽभिजनसंपन्नाः सर्वे च प्रियदर्शनाः ।\nतत्रापि सुमहान्वृक्षो न्यग्रोधो रोहितो महान् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006149063, "chapter_id": 26149, "verse_number": "१-२-१०-६४", "content_sanskrit": "तस्यापि ते फलरसं पिबंतो वर्त्तयंति वै ।\nदशवर्षसहस्राणि शतानि दश पंच च ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006149064, "chapter_id": 26149, "verse_number": "१-२-१०-६५", "content_sanskrit": "जीवंति ते महाभागाः सदा त्दृष्टा नरोत्तमाः ।\nदक्षिणे वै श्रृंगवतः श्वेतस्याप्युत्तरेण च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006149065, "chapter_id": 26149, "verse_number": "१-२-१०-६६", "content_sanskrit": "वर्षं हैरण्वतं नाम यत्र हैरण्वती नदी ।\nमहाबलाः सुतेजस्का जायंते तत्र मानवाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006149066, "chapter_id": 26149, "verse_number": "१-२-१०-६७", "content_sanskrit": "यक्षा वीरा महासत्त्वा धनिनः प्रियदर्शनाः ।\nएकादशसहस्राणि वर्षाणां ते महौजसः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006149067, "chapter_id": 26149, "verse_number": "१-२-१०-६८", "content_sanskrit": "आयुः प्रमाणं जीवंति शतानि दश पंच च ।\nयस्मिन्वर्षे महावृक्षो लकुचः षड्रसाश्रयः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006149068, "chapter_id": 26149, "verse_number": "१-२-१०-६९", "content_sanskrit": "तस्य पीत्वा फलरसं ते जीवंति निरामयाः ।\nत्रीणि श्रृंगवतः श्रृंगाण्युच्छ्रितानि महांति च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006149069, "chapter_id": 26149, "verse_number": "१-२-१०-७०", "content_sanskrit": "एकं मणिमयं तेषामेकं चैव हिरण्मयम् ।\nसर्वरत्नमयं चैकं भवनैरुपशोभितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006149070, "chapter_id": 26149, "verse_number": "१-२-१०-७१", "content_sanskrit": "उत्तरे वै श्रृंगावतः समुद्रस्य च दक्षिणे ।\nकुरवस्तत्र तद्वर्षं पुण्यं सिद्धनिषेवितम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006149071, "chapter_id": 26149, "verse_number": "१-२-१०-७२", "content_sanskrit": "तत्र वृक्षा मधु फला नित्यपुष्पफलोपगाः ।\nवस्त्राणि च प्रसूयंते फलेष्वाभरणानि च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006149072, "chapter_id": 26149, "verse_number": "१-२-१०-७३", "content_sanskrit": "सर्वकामप्रदास्तत्र केचिद्वक्षा मनोरमाः ।\nगंधवर्णरसो पेतं प्रक्षरंति मधूत्तमम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006149073, "chapter_id": 26149, "verse_number": "१-२-१०-७४", "content_sanskrit": "अपरे क्षीरिणो नाम वृक्षास्तत्र मनोरमाः ।\nये क्षरंति सदा क्षीरं षड्रसं ह्यमृतोपमम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006149074, "chapter_id": 26149, "verse_number": "१-२-१०-७५", "content_sanskrit": "सर्वा मणिमयी भूमिः सूक्ष्मकांचनवालुका ।\nसर्वर्तुसुखसंपन्ना न्निष्पंका नीरजा शुभा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006149075, "chapter_id": 26149, "verse_number": "१-२-१०-७६", "content_sanskrit": "देवलोकच्युतास्तत्र जायंते मानवाः शुभाः ।\nशुक्लाभिजनसंपन्नाः सर्वे च स्थिरयौवनाः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006149076, "chapter_id": 26149, "verse_number": "१-२-१०-७७", "content_sanskrit": "मिथुनानि प्रसूयंते स्त्रियश्चाप्सरसः समाः ।\nतेषां ते क्षीरिणां क्षीरं पिबंति ह्यमृतो पमम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006149077, "chapter_id": 26149, "verse_number": "१-२-१०-७८", "content_sanskrit": "मिथुनं जायते सद्यः समं चैव विवर्द्धते ।\nसमं शीलं च रूपं च प्रियता चैव तत्समा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006149078, "chapter_id": 26149, "verse_number": "१-२-१०-७९", "content_sanskrit": "अन्योन्यमनुरक्ताश्च चक्रवाकसधर्मिणः ।\nअनामया ह्यशोकाश्च नित्यं सुखनिषेविणः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006149079, "chapter_id": 26149, "verse_number": "१-२-१०-८०", "content_sanskrit": "त्रयोदशसहस्राणि शतानि दश पंच च ।\nजीवंति ते महावीर्या न चान्यस्त्रीनिषेविणः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]