[{"id": 7003313000, "chapter_id": 23313, "verse_number": "२-८-१", "content_sanskrit": "सुत उवाच  ।\nअष्टाक्षरो द्विजश्रेष्ठा नमो नारायणेति च ।\nद्वादशाक्षरमंत्रश्च परमः परमात्मनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003313001, "chapter_id": 23313, "verse_number": "२-८-२", "content_sanskrit": "मंत्र षडक्षरो विप्राः सर्ववेदार्थसंचयः ।\nयश्चोंनमः शिवायेति मंत्रः सर्वार्थसाधकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003313002, "chapter_id": 23313, "verse_number": "२-८-३", "content_sanskrit": "तथा शिवतरायेति दिव्यः पंचाक्षरः शुभः ।\nमयस्कराय चेत्येवं नमस्ते शंकराय च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003313003, "chapter_id": 23313, "verse_number": "२-८-४", "content_sanskrit": "सप्ताक्षरोयं रुद्रस्य प्रधानपुरुषस्य वै ।\nब्रह्मा च भगवान्विष्णुः सर्वे देवाः सवासवाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003313004, "chapter_id": 23313, "verse_number": "२-८-५", "content_sanskrit": "मंत्रैरेतैर्द्विजश्रेष्ठा मुनयश्च यजंति तम् ।\nशंकरं देवदेवशं मयस्करमजोद्भवम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003313005, "chapter_id": 23313, "verse_number": "२-८-६", "content_sanskrit": "शिवं च शंकरं रुद्रं देवदेवमुमापतिम् ।\nप्राहुर्नमः शिवायोति नमस्ते शंकराय च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003313006, "chapter_id": 23313, "verse_number": "२-८-७", "content_sanskrit": "मयस्कराय रुद्राय तथा शिवतराय च ।\nजप्त्वा मुच्येत वै विप्रो ब्रह्महत्यादिभिः क्षणात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003313007, "chapter_id": 23313, "verse_number": "२-८-८", "content_sanskrit": "पुरा कश्चिद्द्विजः शक्तो धुंधुमूक इति श्रुतः ।\nआसीत्तृतीये त्रेतायामावर्त्ते च मनोः प्रभोः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003313008, "chapter_id": 23313, "verse_number": "२-८-९", "content_sanskrit": "मेघवाहनकल्पे वै ब्रह्मणः परमात्मनः ।\nमेघो भूत्वा महादेवं कृत्तिवाससमीश्वरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003313009, "chapter_id": 23313, "verse_number": "२-८-१०", "content_sanskrit": "बहुमानेन वै रुद्रं देवदेवो जनार्दनः ।\nखिन्नोऽतिभाराद्रुद्रस्य निःश्वासोच्छ्वासवर्जितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003313010, "chapter_id": 23313, "verse_number": "२-८-११", "content_sanskrit": "विज्ञाप्य शितिकंठाय तपश्चक्रेंबुजेक्षणः ।\nतपसा परमैश्वर्यं बलं चैव तथाद्भुतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003313011, "chapter_id": 23313, "verse_number": "२-८-१२", "content_sanskrit": "लब्धवान्परमेशानाच्छंकरात्परमात्मनः ।\nतस्मात्कल्पस्तदा चासीन्मेघवाहनसंज्ञया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003313012, "chapter_id": 23313, "verse_number": "२-८-१३", "content_sanskrit": "तस्मिन्कल्पे मुनेः शापद्धुंधुमूकसमुद्भवः ।\nधुंधुमूकात्मजस्तेन दुरात्मा च बभूव सः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003313013, "chapter_id": 23313, "verse_number": "२-८-१४", "content_sanskrit": "धुंधुमूकः पुरासक्तो भार्यया सह मोहितः ।\nतस्यां वै स्थापितो गर्भः कामासक्तेन चेतसा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003313014, "chapter_id": 23313, "verse_number": "२-८-१५", "content_sanskrit": "अमावास्यामहन्येव मुहूर्ते रुद्रदैवते ।\nअंतर्वत्नी तदा भार्या भुक्ता तेन यथासुखमा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003313015, "chapter_id": 23313, "verse_number": "२-८-१६", "content_sanskrit": "असूत सा च तनयं विशल्याख्या प्रयत्नतः ।\nरुद्रे मुहुर्ते मंदेन वीक्षिते मुनिसत्तमाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003313016, "chapter_id": 23313, "verse_number": "२-८-१७", "content_sanskrit": "मातुः पितुस्तथारिष्टं स संजातस्तथात्मनः ।\nऋषी तमूचतुर्विप्रा धुंधुमूकं मिथस्तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003313017, "chapter_id": 23313, "verse_number": "२-८-१८", "content_sanskrit": "मित्रावरुणानामनौ दुष्पुत्र इति सत्तमौ ।\nवसिष्ठः प्राह नीचोऽपि प्रभावाद्वै बृहस्पतेः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003313018, "chapter_id": 23313, "verse_number": "२-८-१९", "content_sanskrit": "पुत्रस्तवासौ दुर्बुद्धिरपि मुच्यति किल्बिषात् ।\nदुःखितो धुंदुमूकोऽसौ दृष्ट्वा पुत्रमस्थितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003313019, "chapter_id": 23313, "verse_number": "२-८-२०", "content_sanskrit": "जातकर्मादिकं कृत्वा विधिवत्स्वयमेव च ।\nअध्यापयामास च तं विधिनैव द्विजोत्तमाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003313020, "chapter_id": 23313, "verse_number": "२-८-२१", "content_sanskrit": "तेनाधीनं यथान्यायं धौंधुमूकेन सुव्रताः ।\nकृतोद्वाहस्तदा गत्वा गुरुशुश्रुषणे रतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003313021, "chapter_id": 23313, "verse_number": "२-८-२२", "content_sanskrit": "अनेनैव मुनिश्रेष्ठा धौंधुमूकेन दुर्मदात् ।\nभुक्त्वान्यां वृषलीं दृष्ट्वा स्वभार्यावाद्दिवानिशम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003313022, "chapter_id": 23313, "verse_number": "२-८-२३", "content_sanskrit": "एकशय्यासनगतो धौंधुमूको द्विजाधमः ।\nतथा चचार दुर्बुद्धिस्त्यक्त्वा धर्मगतिं पराम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003313023, "chapter_id": 23313, "verse_number": "२-८-२४", "content_sanskrit": "माध्वी पीता तया सार्धं तेन रागविवृद्धये ।\nकेनापि कारणेनैव तामुद्दिस्य द्विजोत्तमाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003313024, "chapter_id": 23313, "verse_number": "२-८-२५", "content_sanskrit": "निहता सा च पापेन वृषली गतमंगला ।\nततस्तस्यास्तदा तस्य भ्रातृभिर्निहतः पिता ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003313025, "chapter_id": 23313, "verse_number": "२-८-२६", "content_sanskrit": "माता च तस्य दुर्बुद्धेर्धौन्धुमूकस्य शोभना ।\nभार्या च तस्य दुर्बुद्धेः श्यालास्ते चापि सुव्रताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003313026, "chapter_id": 23313, "verse_number": "२-८-२७", "content_sanskrit": "राज्ञा क्षणादहो नष्ट कुलं तस्याश्च तस्य च ।\nगत्वासौ धौंधुमूकश्च येन केनापि लीलया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003313027, "chapter_id": 23313, "verse_number": "२-८-२८", "content_sanskrit": "दृष्ट्वा तु तं मुनिश्रेष्ठं रुद्रजाप्यपरायणम् ।\nलब्ध्वा पाशुपतं तद्वै पुरा देवान्महेश्वरात् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003313028, "chapter_id": 23313, "verse_number": "२-८-२९", "content_sanskrit": "लब्ध्वा पंचाक्षरं चैव षडक्षरमनुत्तमम् ।\nपुनः पंचाक्षरं चैव जप्त्वा लक्षं पृथक् पृथक् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003313029, "chapter_id": 23313, "verse_number": "२-८-३०", "content_sanskrit": "व्रतं कृत्वा च विधिना दिव्यं द्वादशमासिकम् ।\nकालधर्मं गतः कल्पे पूजितश्च यमेन वै ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003313030, "chapter_id": 23313, "verse_number": "२-८-३१", "content_sanskrit": "उद्धृता च तथा माता पिता श्यालाश्च सुव्रताः ।\nपत्नी च सुभगा जाता सुस्मिता च पतिव्रता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003313031, "chapter_id": 23313, "verse_number": "२-८-३२", "content_sanskrit": "ताभिर्विमानामारुह्य देवैः सेंद्रैरभिष्टुतः ।\nगाणपत्यमनु प्राप्य रुद्रस्य दयितोऽभवत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003313032, "chapter_id": 23313, "verse_number": "२-८-३३", "content_sanskrit": "तस्मादष्टाक्षरांन्मंत्रात्तथा वै द्वादशाक्षरात् ।\nभवेत्कोटिगुणं पुण्यं नात्र कार्या विचारणा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003313033, "chapter_id": 23313, "verse_number": "२-८-३४", "content_sanskrit": "तस्माज्जपेद्धियो नित्यं प्रागुक्तेन विधानतः ।\nशक्तिबीजसमायुक्तं स याति परमां गतिम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003313034, "chapter_id": 23313, "verse_number": "२-८-३५", "content_sanskrit": "एतद्वः कथितं सर्वं कथासर्वस्वमुत्तमम् ।\nयः पठेच्छृणुयाद्वापि श्रावयेद्वा द्विजोत्तमान् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003313035, "chapter_id": 23313, "verse_number": "२-८-३६", "content_sanskrit": "स याति ब्रह्मलोकं तु रुद्रजाप्यमनुत्तमम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]