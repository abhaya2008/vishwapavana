[{"id": 2168753, "chapter_id": 4616, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168754, "chapter_id": 4616, "verse_number": "१", "content_sanskrit": "एवं स भगवान् देवः सर्वलोकपितामहः ।\nसारथ्यमकरोत् तत्र ब्रह्मा रुद्रोऽभवद् रथी\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168755, "chapter_id": 4616, "verse_number": "२", "content_sanskrit": "रथिनोऽभ्यधिको वीरः कर्तव्यो रथसारथिः ।\nतस्मात्त्वं पुरुषव्याघ्र नियच्छ तुरगान् युधि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168756, "chapter_id": 4616, "verse_number": "३", "content_sanskrit": "यथा देवगणैस्तत्र वृतो यत्नात् पितामहः ।\nतथाऽस्माभिर्भवान्यत्नात् कर्णादभ्यधिको वृतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168757, "chapter_id": 4616, "verse_number": "४", "content_sanskrit": "यथा देवैर्महाराज ईश्वरादधिको वृतः ।\nतथा भवानपि क्षिप्रं रुद्रस्येव पितामहः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168758, "chapter_id": 4616, "verse_number": "५", "content_sanskrit": "नियच्छ तुरगान् युद्धे राधेयस्य महाद्युते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168759, "chapter_id": 4616, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168760, "chapter_id": 4616, "verse_number": "६", "content_sanskrit": "ममाप्येतन्नरश्रेष्ठ बहुशो नरसिंहयोः ।\nकथ्यमानं श्रुतं दिव्यमाख्यानमतिमानुषम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168761, "chapter_id": 4616, "verse_number": "७", "content_sanskrit": "यथा च चक्रे सारथ्यं भवस्य प्रपितामहः ।\nयथाऽसुराश्च निहता इषुणैकेन भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168762, "chapter_id": 4616, "verse_number": "८", "content_sanskrit": "कृष्णस्य चापि विदितं सर्वमेतत्पुरा ह्यभूत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168763, "chapter_id": 4616, "verse_number": "९", "content_sanskrit": "यथा पितामहो जज्ञे भगवान् सारथिस्तदा ।\nअनागतमतिक्रान्तं वेद कृष्णोऽपि तत्त्वतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168764, "chapter_id": 4616, "verse_number": "१०", "content_sanskrit": "एतदर्थं विदित्वाऽपि सारथ्यमुपजग्मिवान् ।\nस्वयम्भूरिव रुद्रस्य कृष्णः पार्थस्य भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168765, "chapter_id": 4616, "verse_number": "११", "content_sanskrit": "यदि हन्याच्च कौन्तेयं सूतपुत्रः कथञ्चन ।\nदृष्ट्वा पार्थं हि निहतं स्वयं योत्स्यति केशवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168766, "chapter_id": 4616, "verse_number": "१२", "content_sanskrit": "शङ्खचक्रगदापाणिर्धक्ष्यते तव वाहिनीम् ।\nन चापि तस्य क्रुद्धस्य वार्ष्णेयस्य महात्मनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168767, "chapter_id": 4616, "verse_number": "१३", "content_sanskrit": "स्थास्यते प्रत्यनीकेषु क्वचिदत्र नृपस्तव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168768, "chapter_id": 4616, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168769, "chapter_id": 4616, "verse_number": "१४", "content_sanskrit": "तं तथा भाषमाणं तु मद्रराजमरिन्दमः ।\nप्रत्युवाच महाबाहुरदीनात्मा सुतस्तव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168770, "chapter_id": 4616, "verse_number": "१५", "content_sanskrit": "मावमंस्था महाबाहो कर्णं वैकर्तनं रणे ।\nसर्वशस्त्रभृतां श्रेष्ठं सर्वशास्त्रार्थपारगम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168771, "chapter_id": 4616, "verse_number": "१६", "content_sanskrit": "यस्य ज्यातलनिर्घोषं श्रुत्वा भयकरं महत् ।\nपाण्डवेयानि सैन्यानि विद्रवन्ति दिशो दश\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168772, "chapter_id": 4616, "verse_number": "१७", "content_sanskrit": "प्रत्यक्षं ते महाबाहो यथा रात्रौ घटोत्कचः ।\nमायाशतानि कुर्वाणो हतो मायापुरस्कृतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168773, "chapter_id": 4616, "verse_number": "१८", "content_sanskrit": "न चातिष्ठत बीभत्सुः प्रत्यनीके कथञ्चन ।\nएतांश्च दिवसान् सर्वान् भयेन महता वृतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168774, "chapter_id": 4616, "verse_number": "१९", "content_sanskrit": "भीमसेनश्च बलवान् धनुष्कोट्याभिचोदितः ।\nउक्तश्च सञ्ज्ञया राजन् मूढ औदरिको यथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168775, "chapter_id": 4616, "verse_number": "२०", "content_sanskrit": "माद्रीपुत्रौ तथा शूरौ येन जित्वा महारणे ।\nकमप्यर्थं पुरस्कृत्य न हतौ युधि मारिष\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168776, "chapter_id": 4616, "verse_number": "२१", "content_sanskrit": "येन वृष्णिप्रवीरस्तु सात्यकिः सात्वतां वरः ।\nनिर्जित्य समरे शूरो विरथश्च बलात्कृतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168777, "chapter_id": 4616, "verse_number": "२२", "content_sanskrit": "सृञ्जयाश्चेतरे सर्वे धृष्टद्युम्नपुरोगमाः ।\nअसकृन्निर्जिताः सङ्खे स्मयमानेन संयुगे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168778, "chapter_id": 4616, "verse_number": "२३", "content_sanskrit": "तं कथं पाण्डवा युद्धे विजेष्यन्ति महारथम् ।\nयो हन्यात् समरे क्रुद्धो वज्रहस्तं पुरन्दरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168779, "chapter_id": 4616, "verse_number": "२४", "content_sanskrit": "त्वं च सर्वास्त्रविद् वीरः सर्वविद्यास्त्रपारगः ।\nबाहुवीर्येण ते तुल्यः पृथिव्यां नास्ति कश्चन\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168780, "chapter_id": 4616, "verse_number": "२५", "content_sanskrit": "त्वं शल्यभूतः शत्रूणामविषह्यः पराक्रमे ।\nततस्त्वमुच्यसे राजन् शल्य इत्यरिसूदन\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168781, "chapter_id": 4616, "verse_number": "२६", "content_sanskrit": "तव बाहुबलं प्राप्य न शेकुः सर्वसात्वताः ।\nतव बाहुबलाद् राजन् किं नु कृष्णो बलाधिकः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168782, "chapter_id": 4616, "verse_number": "२७", "content_sanskrit": "यथाहि कृष्णेन बलं धार्यं वै फल्गुने हते ।\nतथा कर्णात्ययीभावे त्वया धार्यं महद् बलम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168783, "chapter_id": 4616, "verse_number": "२८", "content_sanskrit": "किमर्थं समरे सैन्यं वासुदेवो न्यवारयत् ।\nकिमर्थं च भवान् सैन्यं न हनिष्यति मारिष\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168784, "chapter_id": 4616, "verse_number": "२९", "content_sanskrit": "त्वत्कृतां पदवीं गन्तुमिच्छेयं युधि मारिष ।\nसोदराणां च वीराणां सर्वेषां च महीक्षिताम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168785, "chapter_id": 4616, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168786, "chapter_id": 4616, "verse_number": "३०", "content_sanskrit": "यन्मां ब्रवीषि गान्धारे अग्रे सैन्यस्य मानद ।\nविशिष्टं देवकीपुत्रात् प्रीतिमानस्म्यहं त्वयि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168787, "chapter_id": 4616, "verse_number": "३१", "content_sanskrit": "एष सारथ्यमातिष्ठे राधेयस्य यशस्विनः ।\nयुध्यतः पाण्डवाग्र्येण यथा त्वं वीर मन्यसे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168788, "chapter_id": 4616, "verse_number": "३२", "content_sanskrit": "समयश्च हि मे वीर कश्चिद् वैकर्तनं प्रति ।\nउत्सृजेयं यथाश्रद्धमहं वाचोऽस्य सन्निधौ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168789, "chapter_id": 4616, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168790, "chapter_id": 4616, "verse_number": "३३", "content_sanskrit": "तथेति राजन् पुत्रस्ते सह कर्णेन मारिष ।\nअब्रवीद् मद्रराजानं सर्वक्षत्रस्य सन्निधौ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168791, "chapter_id": 4616, "verse_number": "३४", "content_sanskrit": "सारथ्यस्याभ्युपगमात् शल्येनाश्वासितस्तदा ।\nदुर्योधनस्तदा हृष्टः कर्णं तमभिषस्वजे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168792, "chapter_id": 4616, "verse_number": "३५", "content_sanskrit": "अब्रवीच्च पुनः कर्णं स्तूयमानः सुतस्तव ।\nजहि पार्थान् रणे सर्वान् महेन्द्रो दानवानिव\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168793, "chapter_id": 4616, "verse_number": "३६", "content_sanskrit": "स शल्येनाभ्युपगते हयानां सन्नियच्छने ।\nकर्णो हृष्टात्मना भूयो दुर्योधनमभाषत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168794, "chapter_id": 4616, "verse_number": "३७", "content_sanskrit": "नातिहृष्टमना ह्येष मद्रराजोऽभिभाषते ।\nराजन् मधुरया वाचा पुनरेनं ब्रवीहि वै\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168795, "chapter_id": 4616, "verse_number": "३८", "content_sanskrit": "ततो राजा महाप्राज्ञः सर्वास्त्रकुशलो बली ।\nदुर्योधनोऽब्रवीच्छल्यं मद्रराजं महीपतिम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168796, "chapter_id": 4616, "verse_number": "३९", "content_sanskrit": "पूरयन्निव घोषेण मेघगम्भीरया गिरा ।\nशल्य कर्णोर्ऽजुनेनाद्य योद्धव्यमिति मन्यते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2168797, "chapter_id": 4616, "verse_number": "४०", "content_sanskrit": "तस्य त्वं पुरुषव्याघ्र नियच्छ तुरगान् युधि ।\nकर्णो हत्वेतरान् सर्वान् फल्गुनं हन्तुमिच्छति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2168798, "chapter_id": 4616, "verse_number": "४१", "content_sanskrit": "तस्याभीषुग्रहे राजन् प्रयाचे त्वां पुनः पुनः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2168799, "chapter_id": 4616, "verse_number": "४२", "content_sanskrit": "पार्थस्य सचिवः कृष्णो यथाऽभीषुग्रहो वरः ।\nतथा त्वमपि राधेयं सर्वतः परिपालय\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2168800, "chapter_id": 4616, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2168801, "chapter_id": 4616, "verse_number": "४३", "content_sanskrit": "ततः शल्यः परिष्वज्य सुतं ते वाक्यमब्रवीत् ।\nदुर्योधनममित्रघ्नं प्रीतो मद्राधिपस्तदा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2168802, "chapter_id": 4616, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2168803, "chapter_id": 4616, "verse_number": "४४", "content_sanskrit": "एवं चेन्मन्यसे राजन् गान्धारे प्रियदर्शन ।\nतस्मात्ते यत्प्रियं किञ्चित् तत्सर्वं करवाण्यहम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2168804, "chapter_id": 4616, "verse_number": "४५", "content_sanskrit": "यत्रास्मि भरतश्रेष्ठ योग्यः कर्मणि कर्हिचित् ।\nतत्र सर्वात्मना युक्तो वक्ष्ये कार्यं परन्तप\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2168805, "chapter_id": 4616, "verse_number": "४६", "content_sanskrit": "यत्तु कर्णमहं ब्रूयां हितकामः प्रियाप्रिये ।\nमम तत्क्षमतां सर्वं भवान् कर्णश्च सर्वशः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2168806, "chapter_id": 4616, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2168807, "chapter_id": 4616, "verse_number": "४७", "content_sanskrit": "ईशानस्य यथा ब्रह्मा यथा पार्थस्य केशवः ।\nतथा नित्यं हिते युक्तो मद्रराज भवस्व नः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2168808, "chapter_id": 4616, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2168809, "chapter_id": 4616, "verse_number": "४८", "content_sanskrit": "आत्मनिन्दात्मपूजा च परनिन्दा परस्तवः ।\nअनाचरितमार्याणां वृत्तमेतच्चतुर्विधम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2168810, "chapter_id": 4616, "verse_number": "४९", "content_sanskrit": "यत्तु विद्वन् प्रवक्ष्यामि प्रत्ययार्थमहं तव ।\nआत्मनः स्तवसंयुक्तं तन्निबोध यथातथम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2168811, "chapter_id": 4616, "verse_number": "५०", "content_sanskrit": "अहं शक्रस्य सारथ्ये योग्यो मातलिवत्प्रभो ।\nअप्रमादात् प्रयोगाच्च ज्ञानविद्याचिकित्सनैः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2168812, "chapter_id": 4616, "verse_number": "५१", "content_sanskrit": "ततः पार्थेन सङ्ग्रामे युध्यमानस्य तेऽनघ ।\nवाहयिष्यामि तुरगान् विज्वरो भव सूतज\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2168813, "chapter_id": 4616, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nषट्स्त्रिंशोऽध्यायः ॥३६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]