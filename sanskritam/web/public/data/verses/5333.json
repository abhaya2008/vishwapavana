[{"id": 2203318, "chapter_id": 5333, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203319, "chapter_id": 5333, "verse_number": "१", "content_sanskrit": "सारमुद्धृत्य युष्माभिः साधुधर्म उदाहृतः ।\nधर्मगुह्यमिदं मत्तः शृणुध्वं सर्व एव ह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203320, "chapter_id": 5333, "verse_number": "२", "content_sanskrit": "येषां धर्माश्रिता बुद्धिः श्रद्दधानाश्च ये नराः ।\nतेषां स्यादुपदेष्टव्यः सरहस्यो महाफलः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203321, "chapter_id": 5333, "verse_number": "३", "content_sanskrit": "निरुद्विग्नस्तु यो दद्यान्मासमेकं गवाह्निकम् ।\nएकभक्तं तथाऽश्नीयाच्छ्रूयतां तस्य यत्फलम्\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203322, "chapter_id": 5333, "verse_number": "४", "content_sanskrit": "इमा गावो महाभागाः पवित्रं परमं स्मृताः ।\nत्रीन् लोकान् धारयन्ति स्म सदेवासुरमानुषान्\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203323, "chapter_id": 5333, "verse_number": "५", "content_sanskrit": "तासु चैव महापुण्यं शुश्रूषा च महाफलम् ।\nअहन्यहनि धर्मेण युज्यते वै गवाह्निकः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203324, "chapter_id": 5333, "verse_number": "६", "content_sanskrit": "मया ह्येता ह्यनुज्ञाताः पूर्वमासन् कृते युगे ।\nततोऽहमनुनीतो वै ब्रह्मणा पद्मयोनिना\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203325, "chapter_id": 5333, "verse_number": "७", "content_sanskrit": "तस्माद् व्रजस्थानगतस्तिष्ठत्युपरि मे वृषः ।\nरमेऽहं सह गोभिश्च तस्मात् पूज्याः सदैव ताः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203326, "chapter_id": 5333, "verse_number": "८", "content_sanskrit": "महाप्रभावा वरदा वरान् दद्युरुपासिताः ।\nता गावोऽस्यानुमन्यन्ते सर्वकर्मसु यत्फलम्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203327, "chapter_id": 5333, "verse_number": "९", "content_sanskrit": "तस्य तत्र चतुर्भागो यो ददाति गवाह्निकम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203328, "chapter_id": 5333, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे महादेवरहस्यं नाम चतुरशीत्युत्तरशततमोऽध्यायः ॥१८४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]