[{"id": 5000501000, "chapter_id": 9501, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे चतुर्नवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000501001, "chapter_id": 9501, "verse_number": "६-९४-१", "content_sanskrit": "तानि नागसहस्राणि सारोहाणि च वाजिनाम्।\nरथानां त्वग्निवर्णानां सध्वजानां सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000501002, "chapter_id": 9501, "verse_number": "६-९४-२", "content_sanskrit": "राक्षसानां सहस्राणि गदापरिघयोधिनाम्।\nकाञ्चनध्वजचित्राणां शूराणां कामरूपिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000501003, "chapter_id": 9501, "verse_number": "६-९४-३", "content_sanskrit": "निहतानि शरैर्दीप्तैस्तप्तकाञ्चनभूषणैः।\nरावणेन प्रयुक्तानि रामेणाक्लिष्टकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000501004, "chapter_id": 9501, "verse_number": "६-९४-४", "content_sanskrit": "दृष्ट्वा श्रुत्वा च सम्भ्रान्ता हतशेषा निशाचराः।\nराक्षस्यश्च समागम्य दीनाश्चिन्तापरिप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000501005, "chapter_id": 9501, "verse_number": "६-९४-५", "content_sanskrit": "विधवा हतपुत्राश्च क्रोशन्त्यो हतबान्धवाः।\nराक्षस्यः सह संगम्य दुःखार्ताः पर्यदेवयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000501006, "chapter_id": 9501, "verse_number": "६-९४-६", "content_sanskrit": "कथं शूर्पणखा वृद्धा कराला निर्णतोदरी।\nआससाद वने रामं कंदर्पसमरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000501007, "chapter_id": 9501, "verse_number": "६-९४-७", "content_sanskrit": "सुकुमारं महासत्त्वं सर्वभूतहिते रतम्।\nतं दृष्ट्वा लोकवध्या सा हीनरूपा प्रकामिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000501008, "chapter_id": 9501, "verse_number": "६-९४-८", "content_sanskrit": "कथं सर्वगुणैर्हीना गुणवन्तं महौजसम्।\nसुमुखं दुर्मुखी रामं कामयामास राक्षसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000501009, "chapter_id": 9501, "verse_number": "६-९४-९", "content_sanskrit": "जनस्यास्याल्पभाग्यत्वाद् वलिनी श्वेतमूर्धजा।\nअकार्यमपहास्यं च सर्वलोकविगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000501010, "chapter_id": 9501, "verse_number": "६-९४-१०", "content_sanskrit": "राक्षसानां विनाशाय दूषणस्य खरस्य च।\nचकाराप्रतिरूपा सा राघवस्य प्रधर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000501011, "chapter_id": 9501, "verse_number": "६-९४-११", "content_sanskrit": "तन्निमित्तमिदं वैरं रावणेन कृतं महत्।\nवधाय सीता साऽऽनीता दशग्रीवेण रक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000501012, "chapter_id": 9501, "verse_number": "६-९४-१२", "content_sanskrit": "न च सीतां दशग्रीवः प्राप्नोति जनकात्मजाम्।\nबद्धं बलवता वैरमक्षयं राघवेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000501013, "chapter_id": 9501, "verse_number": "६-९४-१३", "content_sanskrit": "वैदेहीं प्रार्थयानं तं विराधं प्रेक्ष्य राक्षसम्।\nहतमेकेन रामेण पर्याप्तं तन्निदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000501014, "chapter_id": 9501, "verse_number": "६-९४-१४", "content_sanskrit": "चतुर्दश सहस्राणि रक्षसां भीमकर्मणाम्।\nनिहतानि जनस्थाने शरैरग्निशिखोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000501015, "chapter_id": 9501, "verse_number": "६-९४-१५", "content_sanskrit": "खरश्च निहतः संख्ये दूषणस्त्रिशिरास्तथा।\nशरैरादित्यसंकाशैः पर्याप्तं तन्निदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000501016, "chapter_id": 9501, "verse_number": "६-९४-१६", "content_sanskrit": "हतो योजनबाहुश्च कबन्धो रुधिराशनः।\nक्रोधान्नादं नदन् सोऽथ पर्याप्तं तन्निदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000501017, "chapter_id": 9501, "verse_number": "६-९४-१७", "content_sanskrit": "जघान बलिनं रामः सहस्रनयनात्मजम्।\nवालिनं मेरुसंकाशं पर्याप्तं तन्निदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000501018, "chapter_id": 9501, "verse_number": "६-९४-१८", "content_sanskrit": "ऋष्यमूके वसंश्चैव दीनो भग्नमनोरथः।\nसुग्रीवः प्रापितो राज्यं पर्याप्तं तन्निदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000501019, "chapter_id": 9501, "verse_number": "६-९४-१९", "content_sanskrit": "धर्मार्थसहितं वाक्यं सर्वेषां रक्षसां हितम्।\nयुक्तं विभीषणेनोक्तं मोहात् तस्य न रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000501020, "chapter_id": 9501, "verse_number": "६-९४-२०", "content_sanskrit": "विभीषणवचः कुर्याद् यदि स्म धनदानुजः।\nश्मशानभूता दुःखार्ता नेयं लङ्का भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000501021, "chapter_id": 9501, "verse_number": "६-९४-२१", "content_sanskrit": "कुम्भकर्णं हतं श्रुत्वा राघवेण महाबलम्।\nअतिकायं च दुर्मर्षं लक्ष्मणेन हतं तदा।\nप्रियं चेन्द्रजितं पुत्रं रावणो नावबुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000501022, "chapter_id": 9501, "verse_number": "६-९४-२२", "content_sanskrit": "मम पुत्रो मम भ्राता मम भर्ता रणे हतः।\nइत्येष श्रूयते शब्दो राक्षसीनां कुले कुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000501023, "chapter_id": 9501, "verse_number": "६-९४-२३", "content_sanskrit": "रथाश्वनागाश्च हतास्तत्र तत्र सहस्रशः।\nरणे रामेण शूरेण हताश्चापि पदातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000501024, "chapter_id": 9501, "verse_number": "६-९४-२४", "content_sanskrit": "रुद्रो वा यदि वा विष्णुर्महेन्द्रो वा शतक्रतुः।\nहन्ति नो रामरूपेण यदि वा स्वयमन्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000501025, "chapter_id": 9501, "verse_number": "६-९४-२५", "content_sanskrit": "हतप्रवीरा रामेण निराशा जीविते वयम्।\nअपश्यन्त्यो भयस्यान्तमनाथा विलपामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000501026, "chapter_id": 9501, "verse_number": "६-९४-२६", "content_sanskrit": "रामहस्ताद् दशग्रीवः शूरो दत्तमहावरः।\nइदं भयं महाघोरं समुत्पन्नं न बुद्‍ध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000501027, "chapter_id": 9501, "verse_number": "६-९४-२७", "content_sanskrit": "तं न देवा न गन्धर्वा न पिशाचा न राक्षसाः।\nउपसृष्टं परित्रातुं शक्ता रामेण संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000501028, "chapter_id": 9501, "verse_number": "६-९४-२८", "content_sanskrit": "उत्पाताश्चापि दृश्यन्ते रावणस्य रणे रणे।\nकथयन्ति हि रामेण रावणस्य निबर्हणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000501029, "chapter_id": 9501, "verse_number": "६-९४-२९", "content_sanskrit": "पितामहेन प्रीतेन देवदानवराक्षसैः।\nरावणस्याभयं दत्तं मनुष्येभ्यो न याचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000501030, "chapter_id": 9501, "verse_number": "६-९४-३०", "content_sanskrit": "तदिदं मानुषं मन्ये प्राप्तं निःसंशयं भयम्।\nजीवितान्तकरं घोरं रक्षसां रावणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000501031, "chapter_id": 9501, "verse_number": "६-९४-३१", "content_sanskrit": "पीड्यमानास्तु बलिना वरदानेन रक्षसा।\nदीप्तैस्तपोभिर्विबुधाः पितामहमपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000501032, "chapter_id": 9501, "verse_number": "६-९४-३२", "content_sanskrit": "देवतानां हितार्थाय महात्मा वै पितामहः।\nउवाच देवतास्तुष्ट इदं सर्वा महद्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000501033, "chapter_id": 9501, "verse_number": "६-९४-३३", "content_sanskrit": "अद्यप्रभृति लोकांस्त्रीन् सर्वे दानवराक्षसाः।\nभयेन प्रभृता नित्यं विचरिष्यन्ति शाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000501034, "chapter_id": 9501, "verse_number": "६-९४-३४", "content_sanskrit": "दैवतैस्तु समागम्य सर्वैश्चेन्द्रपुरोगमैः।\nवृषध्वजस्त्रिपुरहा महादेवः प्रतोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000501035, "chapter_id": 9501, "verse_number": "६-९४-३५", "content_sanskrit": "प्रसन्नस्तु महादेवो देवानेतद् वचोऽब्रवीत्।\nउत्पत्स्यति हितार्थं वो नारी रक्षःक्षयावहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000501036, "chapter_id": 9501, "verse_number": "६-९४-३६", "content_sanskrit": "एषा देवैः प्रयुक्ता तु क्षुद् यथा दानवान् पुरा।\nभक्षयिष्यति नः सर्वान् राक्षसघ्नी सरावणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000501037, "chapter_id": 9501, "verse_number": "६-९४-३७", "content_sanskrit": "रावणस्यापनीतेन दुर्विनीतस्य दुर्मतेः।\nअयं निष्टानको घोरः शोकेन समभिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000501038, "chapter_id": 9501, "verse_number": "६-९४-३८", "content_sanskrit": "तं न पश्यामहे लोके यो नः शरणदो भवेत्।\nराघवेणोपसृष्टानां कालेनेव युगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000501039, "chapter_id": 9501, "verse_number": "६-९४-३९", "content_sanskrit": "नास्ति नः शरणं किंचिद् भये महति तिष्ठताम्।\nदावाग्निवेष्टितानां हि करेणूनां यथा वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000501040, "chapter_id": 9501, "verse_number": "६-९४-४०", "content_sanskrit": "प्राप्तकालं कृतं तेन पौलस्त्येन महात्मना।\nयत एव भयं दृष्टं तमेव शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000501041, "chapter_id": 9501, "verse_number": "६-९४-४१", "content_sanskrit": "इतीव सर्वा रजनीचरस्त्रियः\nपरस्परं सम्परिरभ्य बाहुभिः।\nविषेदुरार्तातिभयाभिपीडिता\nविनेदुरुच्चैश्च तदा सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000501042, "chapter_id": 9501, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे चतुर्नवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]