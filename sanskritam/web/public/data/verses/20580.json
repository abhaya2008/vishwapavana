[{"id": 7000580000, "chapter_id": 20580, "verse_number": "५-३९-१", "content_sanskrit": "शेष उवाच ।\nनिनदत्सुमृदंगेषु वीणानादेषु सर्वतः ।\nमुक्तो वाहस्ततो देव पुरं देवविनिर्मितम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000580001, "chapter_id": 20580, "verse_number": "५-३९-२", "content_sanskrit": "यत्र स्फाटिक कुड्यानां रचनाभिर्गृहा नृणाम् ।\nहसंति विंध्यं विमलं पर्वतं नागसेवितम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000580002, "chapter_id": 20580, "verse_number": "५-३९-३", "content_sanskrit": "राजतानि गृहाण्यत्र दृश्यंते प्रकृतेरपि ।\nविचित्रमणिसन्नद्धा नानामाणिक्यगोपुराः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000580003, "chapter_id": 20580, "verse_number": "५-३९-४", "content_sanskrit": "पद्मिन्यो यत्र लोकानां गेहे गेहे मनोहराः ।\nहरंति चित्तानि नृणां मुखपद्मकलेक्षिताः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000580004, "chapter_id": 20580, "verse_number": "५-३९-५", "content_sanskrit": "पद्मरागमणिर्यत्र गेहे गेहे सुभूमिषु ।\nबद्धः संलक्ष्यते विप्र तदोष्ठस्पर्धया नु किम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000580005, "chapter_id": 20580, "verse_number": "५-३९-६", "content_sanskrit": "क्रीडाशैलाः प्रत्यगारं नीलरत्नविनिर्मिताः ।\nकुर्वंति शंकां मेघस्य मयूराणां कलापिनाम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000580006, "chapter_id": 20580, "verse_number": "५-३९-७", "content_sanskrit": "हंसा यत्र नृणां गेहे स्फाटिकेषु नियंत्रिताः ।\nकुर्वंति मेघान्नो भीतिं मानसं न स्मरंति च॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000580007, "chapter_id": 20580, "verse_number": "५-३९-८", "content_sanskrit": "निरंतरं शिवस्थाने ध्वस्तं चंद्रिकया तमः ।\nशुक्लकृष्णविभेदो न पक्षयोस्तत्र वै नृणाम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000580008, "chapter_id": 20580, "verse_number": "५-३९-९", "content_sanskrit": "तत्र वीरमणी राजा धार्मिकेष्वग्रणीर्महान् ।\nराज्यं करोति विपुलं सर्वभोगसमन्वितम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000580009, "chapter_id": 20580, "verse_number": "५-३९-१०", "content_sanskrit": "तस्य पुत्रो महाशूरो नाम्ना रुक्मांगदो बली ।\nवनिताभिर्गतो रम्यदेहाभिः क्रीडितुं वनम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000580010, "chapter_id": 20580, "verse_number": "५-३९-११", "content_sanskrit": "तासां मंजीरसंरावः कंकणानां रवस्तथा ।\nमनो हरति कामस्य किमन्यस्य कथात्र भोः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000580011, "chapter_id": 20580, "verse_number": "५-३९-१२", "content_sanskrit": "वनं जगाम सुमहत्सुपुष्पनगसंयुतम् ।\nसदाशिवकृतस्थानमृतुषट्कैर्विराजितम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000580012, "chapter_id": 20580, "verse_number": "५-३९-१३", "content_sanskrit": "चंपका यत्र बहुशः फुल्लकोरकशोभिताः ।\nकुर्वंति कामिनां तत्र हृच्छयार्तिं विलोकिताः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000580013, "chapter_id": 20580, "verse_number": "५-३९-१४", "content_sanskrit": "चूताः फलादिभिर्नम्रा मंजरीकोटिसंयुताः ।\nनागाः पुन्नागवृक्षाश्च शालास्तालास्तमालकाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000580014, "chapter_id": 20580, "verse_number": "५-३९-१५", "content_sanskrit": "कोकिलानां समारावा यत्र च श्रुतिगोचराः ।\nसदा मधुपझंकार गतनिद्राः सुमल्लिकाः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000580015, "chapter_id": 20580, "verse_number": "५-३९-१६", "content_sanskrit": "दाडिमानां समूहाश्च कर्णिकारैः समन्विताः ।\nकेतकीकानकीवन्यवृक्षराजिविराजिताः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000580016, "chapter_id": 20580, "verse_number": "५-३९-१७", "content_sanskrit": "तस्मिन्वने प्रमदसंयुतचित्तवृत्तिर्गायन्कलं मधुरवाग्विचिकीर्षयोच्चैः ।\nउद्यत्कुचाभिरभितो वनिताभिरागाच्छोभानिधान वपुरुद्गतभीर्विवेश॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000580017, "chapter_id": 20580, "verse_number": "५-३९-१८", "content_sanskrit": "काश्चित्तं नृत्यविद्याभिस्तोषयंति स्म शोभनम् ।\nकाश्चिद्गानकलाभिश्च काश्चिद्वाक्चतुरोचितैः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000580018, "chapter_id": 20580, "verse_number": "५-३९-१९", "content_sanskrit": "भ्रूसंज्ञया पराः काश्चित्तोषयामासुरुन्मदाः ।\nपरिरंभणचातुर्यैस्तं हृष्टं विदधुः स्त्रियः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000580019, "chapter_id": 20580, "verse_number": "५-३९-२०", "content_sanskrit": "ताभिः पुष्पोच्चयं कृत्वा भूषयामास ताः स्त्रियः ।\nवाण्या कोमलया शंसन्रेमे कामवपुर्धरः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000580020, "chapter_id": 20580, "verse_number": "५-३९-२१", "content_sanskrit": "एवं प्रवृत्ते समये राजराजस्य धीमतः ।\nप्रायात्तद्वनदेशं स हयः परमशोभनः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000580021, "chapter_id": 20580, "verse_number": "५-३९-२२", "content_sanskrit": "तं स्वर्णपत्ररचितैकललाटदेशं ।\nगंगासमं घुसृणकुंकुम पिंजरांगम् ।\nगत्यासमं पवनवेगतिरस्करिण्या ।\nदृष्ट्वा स्त्रियः परमकौतुकधामदेहम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000580022, "chapter_id": 20580, "verse_number": "५-३९-२३", "content_sanskrit": "ऊचुः पतिं कमलमध्यपिशंगवर्णा ।\nस्ताम्राधरप्रतिभयाहतविद्रुमाभाः ।\nदंतव्रजप्रमितहास्यसुशोभिवक्त्राः ।\nकामस्य बाणनयनादिविमोहनाभाः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000580023, "chapter_id": 20580, "verse_number": "५-३९-२४", "content_sanskrit": "स्त्रिय ऊचुः ।\nकांतकोयं महानर्वास्वर्णपत्रैकशोभितः ।\nकस्य वा भाति शोभाढ्यो गृहाण स्वबलादिमम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000580024, "chapter_id": 20580, "verse_number": "५-३९-२५", "content_sanskrit": "शेष उवाच ।\nतदुक्तं वच आकर्ण्य लीलाललितलोचनः ।\nजग्राह हयमेकेन करपद्मेन लीलया॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000580025, "chapter_id": 20580, "verse_number": "५-३९-२६", "content_sanskrit": "वाचयित्वा स्वर्णपत्रं स्पष्टवर्णसमन्वितम् ।\nजहास महिलामध्ये जगाद वचनं पुनः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000580026, "chapter_id": 20580, "verse_number": "५-३९-२७", "content_sanskrit": "रुक्मांगद उवाच ।\nपृथिव्यां नास्ति मे पित्रा समः शौर्येण च श्रिया ।\nतस्मिन्कथं विधत्ते स उत्सेकं रामभूमिपः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000580027, "chapter_id": 20580, "verse_number": "५-३९-२८", "content_sanskrit": "यस्य रक्षां प्रकुरुते सदा रुद्रः पिनाकधृक् ।\nयं देवा दानवा यक्षा नमंति मणिमौलिभिः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000580028, "chapter_id": 20580, "verse_number": "५-३९-२९", "content_sanskrit": "कुरुताद्वाजिमेधं वै जनको मे महाबलः ।\nया त्वेष वाजिशालायां बध्नंतु मम वै भटाः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000580029, "chapter_id": 20580, "verse_number": "५-३९-३०", "content_sanskrit": "इति वाक्यं समाकर्ण्य महिलास्ता मनोहराः ।\nप्रहर्षवदना जाताः कांतं तु परिरेभिरे॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000580030, "chapter_id": 20580, "verse_number": "५-३९-३१", "content_sanskrit": "गृहीत्वा च हयं पुत्रो राज्ञो वीरमणेर्महान् ।\nपुरं पत्नीसमायुक्तो महोत्साहमवीविशत्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000580031, "chapter_id": 20580, "verse_number": "५-३९-३२", "content_sanskrit": "मृदंगध्वनिषु प्रोच्चैराहतेषु समंततः ।\nबंदिभिः संस्तुतः प्रागात्स्वपितुर्मंदिरं महत्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000580032, "chapter_id": 20580, "verse_number": "५-३९-३३", "content_sanskrit": "तस्मै स कथयामास हयं नीतं रघोः पतेः ।\nवाजिमेधाय निर्मुक्तं स्वच्छंदगतिमद्भुतम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000580033, "chapter_id": 20580, "verse_number": "५-३९-३४", "content_sanskrit": "रक्षितं शत्रुसूदेन महाबलसमेतिना ।\nतच्छ्रुत्वा वचनं तस्य नृपो वीरमणिर्महान्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000580034, "chapter_id": 20580, "verse_number": "५-३९-३५", "content_sanskrit": "नातिप्रशंसयामास तत्कर्म सुमहामतिः ।\nनीत्वा पुनः समायांतं चौरस्येव विचेष्टितम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000580035, "chapter_id": 20580, "verse_number": "५-३९-३६", "content_sanskrit": "कथयामास जामात्रे शिवायाद्भुतकर्मणे ।\nअर्धांगनाधरायांगभूषाय चंद्रधारिणे॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000580036, "chapter_id": 20580, "verse_number": "५-३९-३७", "content_sanskrit": "तेन संमंत्रयामास नृपो वीरमणिर्महान् ।\nपुत्रसृष्टं महत्कर्म विनिंद्यं महतां मतः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000580037, "chapter_id": 20580, "verse_number": "५-३९-३८", "content_sanskrit": "शिव उवाच ।\nराजन्पुत्रेण भवतः कृतं कर्म महाद्भुतम् ।\nयो जहार महावाहंरामचंद्रस्य धीमतः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000580038, "chapter_id": 20580, "verse_number": "५-३९-३९", "content_sanskrit": "अद्य युद्धं महद्भाति सुरासुरविमोहनम् ।\nशत्रुघ्नेन महाराज्ञा वीरकोट्येकरक्षिणा॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000580039, "chapter_id": 20580, "verse_number": "५-३९-४०", "content_sanskrit": "मया यो ध्रियते स्वांते जिह्वया प्रोच्यते हि यः ।\nतस्य रामस्ययज्ञांगं जहार तव पुत्रकः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000580040, "chapter_id": 20580, "verse_number": "५-३९-४१", "content_sanskrit": "परमत्र महांल्लाभो भविष्यतितरां रणे ।\nयद्रामचरणांभोजं द्रक्ष्यामः स्वीयसेवितम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000580041, "chapter_id": 20580, "verse_number": "५-३९-४२", "content_sanskrit": "अत्र यत्नो महान्कार्यो हयस्य परिरक्षणे ।\nनयिष्यंति बलाद्वाहं मया रक्षितमप्यमुम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000580042, "chapter_id": 20580, "verse_number": "५-३९-४३", "content_sanskrit": "तस्मादिमं महाराज राज्येन सह सन्नतः ।\nवाजिनं भोजनं दत्वा प्रेक्षस्वांघ्रियुगं ततः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000580043, "chapter_id": 20580, "verse_number": "५-३९-४४", "content_sanskrit": "इति वाक्यं समाकर्ण्य शिवस्य स नृपोत्तमः ।\nउवाच तं सुरेंद्रादिवंद्यपादांबुजद्वयम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000580044, "chapter_id": 20580, "verse_number": "५-३९-४५", "content_sanskrit": "वीरमणिरुवाच ।\nक्षत्रियाणामयं धर्मो यत्प्रतापस्य रक्षणम् ।\nतदसौ क्रांतुमुद्युक्तः क्रतुना हयसंज्ञिना॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000580045, "chapter_id": 20580, "verse_number": "५-३९-४६", "content_sanskrit": "तस्माद्रक्ष्यः स्वप्रतापो येनकेनापि मानिना ।\nयावच्छक्यं कर्म कृत्वा शरीरव्ययकारिणा॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000580046, "chapter_id": 20580, "verse_number": "५-३९-४७", "content_sanskrit": "सर्वं कृतं सुतेनेदं गृहीतोऽश्व पुनर्यतः ।\nकोपितं रामभूपालं समयार्हं कुरु प्रभो॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000580047, "chapter_id": 20580, "verse_number": "५-३९-४८", "content_sanskrit": "क्षत्त्रियाणामिदं कर्म कर्तव्यार्हं भवेन्नहि ।\nयदकस्माद्रिपोः पादौ प्रणमेद्भयविह्वलः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000580048, "chapter_id": 20580, "verse_number": "५-३९-४९", "content_sanskrit": "रिपवो विहसंत्येनं कातरोऽयं नृपाधमः ।\nक्षुद्रः प्राकृतवन्नीचो नतवान्भयविह्वलः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000580049, "chapter_id": 20580, "verse_number": "५-३९-५०", "content_sanskrit": "तस्माद्भवान्यथायोग्यं योद्धव्ये समुपस्थिते ।\nयद्विधेयं विचार्यैव कर्तव्यं भक्तरक्षणम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000580050, "chapter_id": 20580, "verse_number": "५-३९-५१", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य चंद्रचूडोवदद्वचः ।\nप्रहसन्मेघगंभीरवाण्या संमोहयन्मनः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000580051, "chapter_id": 20580, "verse_number": "५-३९-५२", "content_sanskrit": "यदि देवास्त्रयस्त्रिंशत्कोटयः समुपस्थिताः ।\nतथापि त्वत्तः केनाश्वो गृह्यते मम रक्षितुः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000580052, "chapter_id": 20580, "verse_number": "५-३९-५३", "content_sanskrit": "यदि रामः समागत्य स्वात्मानं दर्शयिष्यति ।\nतदाहं चरणौ तस्य प्रणमामि सुकोमलौ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000580053, "chapter_id": 20580, "verse_number": "५-३९-५४", "content_sanskrit": "स्वामिना न हि योद्धव्यं महान नय उच्यते ।\nअन्ये वीरास्तृणप्रायाः किंचित्कर्तुं न वै क्षमाः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000580054, "chapter_id": 20580, "verse_number": "५-३९-५५", "content_sanskrit": "तस्माद्युद्ध्यस्व राजेंद्र रक्षके मयि सुस्थिते ।\nको गृह्णाति बलाद्वाहं त्रिलोकी यदि संगता॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000580055, "chapter_id": 20580, "verse_number": "५-३९-५६", "content_sanskrit": "शेष उवाच ।\nएतद्वचः परं श्रुत्वा चंद्रचूडस्य भूमिपः ।\nजहर्ष मानसेऽत्यंतं युद्धकर्मणि कौतुकी॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]