[{"id": 2023434, "chapter_id": 1500, "verse_number": "३-१३८-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023435, "chapter_id": 1500, "verse_number": "३-१३८-१", "content_sanskrit": "चङ्क्रम्यमाणः स तदा यवक्रीरकुतोभयः।\nजगाम माधवे मासि रैभ्याश्रमपदं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023436, "chapter_id": 1500, "verse_number": "३-१३८-२", "content_sanskrit": "स ददर्शाश्रमे रम्ये पुष्पतद्रुमभूषिते।\nविचरन्तीं स्नुषां तस्य किन्नरीमिव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023437, "chapter_id": 1500, "verse_number": "३-१३८-३", "content_sanskrit": "यवक्रीस्तामुवाचेदमुपतिष्ठस्व मामिनि।\nनिर्लज्जो लज्जया युक्तां कामेन हृतचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023438, "chapter_id": 1500, "verse_number": "३-१३८-४", "content_sanskrit": "सा तस्य शीलमाज्ञाय तस्माच्छापाच्च बिभ्यती।\nतेजस्वितां च रैभ्यस् तथेत्युक्त्वा जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023439, "chapter_id": 1500, "verse_number": "३-१३८-५", "content_sanskrit": "तत एकान्तमानीय लज्जयामास भारत।\nआजगाम तदा रैभ्यः स्वमाश्रममरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023440, "chapter_id": 1500, "verse_number": "३-१३८-६", "content_sanskrit": "रुदतीं च स्नुषां दृष्ट्वा भार्यामार्ता परावसोः।\nसान्त्वयञ्श्लक्ष्णया वाचा पर्यपृच्छद्युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023441, "chapter_id": 1500, "verse_number": "३-१३८-७", "content_sanskrit": "सा तस्मै सर्वमाचष्ट यवक्रीभाषितं शुभा।\nप्रत्युक्तं च यवक्रीतं प्रेक्षापूर्वं तथाऽऽत्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023442, "chapter_id": 1500, "verse_number": "३-१३८-८", "content_sanskrit": "शृण्वानस्यैव रैभ्यस्य यवक्रेस्तद्विचेष्टनम्।\nदहन्निव तदा चेतः क्रोधः समभवन्महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023443, "chapter_id": 1500, "verse_number": "३-१३८-९", "content_sanskrit": "स तदा मन्युनाऽऽविष्टस्तपस्वी कोपनो भृशम्।\nअवलुप्य जटामेकां जुहावाग्नौ सुसंस्कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023444, "chapter_id": 1500, "verse_number": "३-१३८-१०", "content_sanskrit": "ततः समभवन्नारी तस्या रूपेण संमिता।\nअवलुप्यापरां चापि जुहावाग्नौ जटां पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023445, "chapter_id": 1500, "verse_number": "३-१३८-११", "content_sanskrit": "ततः समभवद्रक्षो दीप्तास्यं घोरदर्शनम्।\nअब्रूतां तौ तदा रैभ्यं किं कार्यं करवामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023446, "chapter_id": 1500, "verse_number": "३-१३८-१२", "content_sanskrit": "तावब्रवीदृषिः क्रुद्धो यवक्रीर्वध्यतामिति।\nजग्मतृस्तौ तथेत्युक्त्वा यवक्रीतजिघांसया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023447, "chapter_id": 1500, "verse_number": "३-१३८-१३", "content_sanskrit": "ततस्तं समुपास्थाय कृत्या सृष्टा महात्मना।\nकमण्डलुं जहारास्य मोहयित्वा तु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023448, "chapter_id": 1500, "verse_number": "३-१३८-१४", "content_sanskrit": "उच्छिष्टं तु यवक्रीतमपकृष्टकमण्डलुम्।\nतत उद्यतशूलः स राक्षसः समुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023449, "chapter_id": 1500, "verse_number": "३-१३८-१५", "content_sanskrit": "तमाद्रवन्तं संप्रेक्ष्य शूलहस्तं जिघांसया।\nयवक्रीः सहसोत्थाय प्राद्रवद्यत्रवै सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023450, "chapter_id": 1500, "verse_number": "३-१३८-१६", "content_sanskrit": "जलहीनं सरो दृष्ट्वा यवक्रीस्त्वरितः पुनः।\nजगाम सरितः सर्वास्ताश्चाप्यासन्विशोषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023451, "chapter_id": 1500, "verse_number": "३-१३८-१७", "content_sanskrit": "स काल्यमानो घोरेण शूलहस्तेन रक्षसा।\nअग्निहोत्रे पितुर्भीतः सहसा प्रविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023452, "chapter_id": 1500, "verse_number": "३-१३८-१८", "content_sanskrit": "स वै प्रविशमानस्तु शुद्रेणान्धेन रक्षिणा।\nनिगृहीतो बलाद्द्वारि सोऽवातिष्ठत पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023453, "chapter_id": 1500, "verse_number": "३-१३८-१९", "content_sanskrit": "निगृहीतं तु शूद्रेण यवक्रीतं स राक्षसः।\nताडयामास शूलेन स भिन्नहृदयोऽपतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023454, "chapter_id": 1500, "verse_number": "३-१३८-२०", "content_sanskrit": "यवक्रीतं स हत्वा तु राक्षसो रैभ्यमागमत्।\nअनुज्ञातस्तु रैभ्येण तया नार्या सहावसत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023455, "chapter_id": 1500, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि अष्टत्रिंशदधिकशततमोऽध्यायः ॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]