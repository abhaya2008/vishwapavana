[{"id": 2130021, "chapter_id": 3803, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130022, "chapter_id": 3803, "verse_number": "१", "content_sanskrit": "धर्मज्ञो बलवान् शूरः सत्यो राक्षसपुङ्गवः ।\nभक्तोऽस्मानौरसः पुत्रो नेतुमर्हसि मातरम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130023, "chapter_id": 3803, "verse_number": "२", "content_sanskrit": "तव भीम सुतेनाहं नीतो भीमपराक्रम ।\nअक्षतः सह पाञ्चाल्या गच्छेयं गन्धमादनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130024, "chapter_id": 3803, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130025, "chapter_id": 3803, "verse_number": "३", "content_sanskrit": "भ्रातुर्वचनमाज्ञाय भीमसेनो घटोत्कचम् ।\nचिन्तयामास बलवान् महाबलपराक्रमम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130026, "chapter_id": 3803, "verse_number": "४", "content_sanskrit": "घटोत्कचश्च धर्मात्मा स्मृतमात्रः पितुस्तदा ।\nकृताञ्जलिरुपातिष्ठदभिवाद्याथ पाण्डवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130027, "chapter_id": 3803, "verse_number": "५", "content_sanskrit": "उवाच भीमसेनं स पितरं सत्यविक्रमः ।\nआज्ञापय महाबाहो सर्वं कर्तास्म्यसंशयम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130028, "chapter_id": 3803, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130029, "chapter_id": 3803, "verse_number": "६", "content_sanskrit": "तच्छ्रुत्वा भीमसेनस्तु राक्षसं परिषस्वजे ।\nचिन्तया समनुप्राप्तमित्युवाच वृकोदरः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130030, "chapter_id": 3803, "verse_number": "७", "content_sanskrit": "हैडिम्बेय परिश्रान्ता तव माताऽपराजित ।\nत्वं च कामगमस्तात बलवान् वह तां खग\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130031, "chapter_id": 3803, "verse_number": "८", "content_sanskrit": "स्कन्धमारोप्य भद्रं ते मध्येऽस्माकं विहायसा ।\nगच्छ नीचिकया गत्या यथा चैनां न पीडयेः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130032, "chapter_id": 3803, "verse_number": "", "content_sanskrit": "घटोत्कचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130033, "chapter_id": 3803, "verse_number": "९", "content_sanskrit": "धर्मराजं च धौम्यं च कृष्णां च यमजौ तथा ।\nएकोऽप्यहमलं वोढुं किमुताद्य सहायवान् ।\nमन्दं मन्दं गमिष्यामि वहन् द्रुपदनन्दिनीम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130034, "chapter_id": 3803, "verse_number": "", "content_sanskrit": "अन्ये च शतशः शूरा विहङ्गाः कामरूपिणः ।\nसर्वान् वो ब्राह्मणैः सार्धं वक्ष्यन्ति सहितानथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130035, "chapter_id": 3803, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130036, "chapter_id": 3803, "verse_number": "१०", "content_sanskrit": "एवमुक्त्वा ततः कृष्णामुवाह स घटोत्कचः ।\nपाण्डूनां मध्यगो वीरः पाण्डवानपि चापरे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130037, "chapter_id": 3803, "verse_number": "११", "content_sanskrit": "लोमशः सिद्धमार्गेण जगामानुपमद्युतिः ।\nस्वेनैव स प्रभावेण द्वितीय इव भास्करः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130038, "chapter_id": 3803, "verse_number": "१२", "content_sanskrit": "ब्राह्मणांश्चापि तान् सर्वान् समुपादाय राक्षसाः ।\nनियोगाद् राक्षसेन्द्रस्य जग्मुर्भीमपराक्रमाः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130039, "chapter_id": 3803, "verse_number": "१३", "content_sanskrit": "एवं सुरमणीयानि वनान्युपवनानि च ।\nआलोकयन्तस्ते जग्मुर्विशालां बदरीं प्रति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130040, "chapter_id": 3803, "verse_number": "१४", "content_sanskrit": "ते त्वाशुगतिभिर्वीरा राक्षसैस्तैर्महाजवैः ।\nउह्यमाना ययुः शीघ्रं दीर्घमध्वानमल्पवत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130041, "chapter_id": 3803, "verse_number": "१५", "content_sanskrit": "देशान् म्लेच्छजनाकीर्णान् नानारत्नाकरायुतान् ।\nददृशुर्गिरिपादांश्च नानाधातुसमाचितान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130042, "chapter_id": 3803, "verse_number": "१६", "content_sanskrit": "आसेवितान् किम्पुरुषैर्गन्धर्वैश्च समन्ततः ।\nविद्याधरसमाकीर्णान् युतान् वानरकिन्नरैः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130043, "chapter_id": 3803, "verse_number": "१७", "content_sanskrit": "मयूरैश्चमरैश्चैव वानरै रुरुभिस्तथा ।\nवराहैर्गवयैश्चैव महिषैश्च समावृतान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130044, "chapter_id": 3803, "verse_number": "१८", "content_sanskrit": "नदीजालसमाकीर्णान् नानापक्षियुतान् बहून् ।\nनानाविधमृगैर्जुष्टान् वानरैश्चोपशोभितान् ।\nसमदैश्चापि विहगैः पादपैरन्वितांस्तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130045, "chapter_id": 3803, "verse_number": "१९", "content_sanskrit": "तेऽवतीर्य बहून् देशानुत्तरांश्च कुरूनपि \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130046, "chapter_id": 3803, "verse_number": "२०", "content_sanskrit": "ददृशुर्विविधाश्चर्यं कैलासं पर्वतोत्तमम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130047, "chapter_id": 3803, "verse_number": "२१", "content_sanskrit": "तस्याभ्याशे तु ददृशुर्नरनारायणाश्रमम् ।\nउपेतं पादपैर्दिव्यैः सदापुष्पफलोपगैः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130048, "chapter_id": 3803, "verse_number": "२२", "content_sanskrit": "ददृशुस्तां च बदरीं वृत्तस्कन्धां मनोरमाम् ।\nस्निग्धामविरळच्छायां श्रिया परमया युताम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130049, "chapter_id": 3803, "verse_number": "२३", "content_sanskrit": "पत्रैः स्निग्धैरविरळैरुपेतां मृदुभिः शुभाम् ।\nविशालशाखां विस्तीर्णामतिद्युतिसमन्विताम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130050, "chapter_id": 3803, "verse_number": "२४", "content_sanskrit": "फलैरुपचितैर्दिव्यैराचितां स्वादुर्भिर्भृशम् ।\nमधुस्रवैः सदा दिव्यां महर्षिगणसेविताम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130051, "chapter_id": 3803, "verse_number": "२५", "content_sanskrit": "मदप्रमुदितैर्नित्यं नानाद्विजगणैर्युताम् ।\nअदंशमशके देशे बहुमूलफलोदके\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130052, "chapter_id": 3803, "verse_number": "२६", "content_sanskrit": "नीलशाद्वलसञ्छन्ने देवगन्धर्वसेविते ।\nसुसमीकृतभूभागे स्वभावविहिते शुभे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130053, "chapter_id": 3803, "verse_number": "२७", "content_sanskrit": "जातां हिममृदुस्पर्शे देशेऽपहतकण्टके ।\nतामुपेत्य महात्मानः सह तैर्ब्राह्मणर्षभैः ।\nअवतेरुस्ततः सर्वे राक्षसस्कन्धतः शनैः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130054, "chapter_id": 3803, "verse_number": "२८", "content_sanskrit": "ततस्तमाश्रमं रम्यं नरनारायणाश्रितम् ।\nददृशुः पाण्डवा राजन् सहिता द्विजपुङ्गवैः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130055, "chapter_id": 3803, "verse_number": "२९", "content_sanskrit": "तमसा रहितं पुण्यमनामृष्टं रवेः करैः ।\nक्षुत्तृट्शीतोष्णदोषैश्च वर्जितं शोकनाशनम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130056, "chapter_id": 3803, "verse_number": "३०", "content_sanskrit": "महर्षिगणसम्बाधं ब्राह्म्या लक्ष्म्या समन्वितम् ।\nदुष्प्रवेशं महाराज नरैर्धर्मबहिष्कृतैः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130057, "chapter_id": 3803, "verse_number": "३१", "content_sanskrit": "बलिहोमार्चितं दिव्यं सुसम्मृष्टानुलेपनम् ।\nदिव्यपुष्पोपहारैश्च सर्वतोऽभिविराजितम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130058, "chapter_id": 3803, "verse_number": "३२", "content_sanskrit": "विशालैरग्निशरणैः स्रुग्भाण्डैराचितं शुभैः ।\nमहद्भिस्तोयकलशैः कठिनैश्चोपशोभितम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130059, "chapter_id": 3803, "verse_number": "३३", "content_sanskrit": "शरण्यं सर्वभूतानां ब्रह्मघोषनिनादितम् ।\nदिव्यमाश्रयणीयं तमाश्रमं श्रमनाशनम् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130060, "chapter_id": 3803, "verse_number": "३४", "content_sanskrit": "श्रिया युतमनिर्देश्यं देवचर्योपशोभितम् ।\nफलमूलाशनैर्दान्तैश्चारुकृष्णाजिनाम्बरैः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130061, "chapter_id": 3803, "verse_number": "३५", "content_sanskrit": "सूर्यवैश्वानरसमैस्तपसा भावितात्मभिः ।\nमहर्षिभिर्मोक्षपरैर्यतिभिर्नियतेन्द्रियैः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2130062, "chapter_id": 3803, "verse_number": "३६", "content_sanskrit": "ब्रह्मभूतैर्महाभागैरुपेतं ब्रह्मवादिभिः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2130063, "chapter_id": 3803, "verse_number": "३७", "content_sanskrit": "सोऽभ्यगच्छन्महातेजास्तानृषीन् प्रयतः शुचिः ।\nभ्रातृभिः सहितो धीमान् धर्मपुत्रो युधिष्ठिरः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2130064, "chapter_id": 3803, "verse_number": "३८", "content_sanskrit": "दिव्यज्ञानोपपन्नास्ते दृष्ट्वा प्राप्तं युधिष्ठिरम् ।\nअभ्यगच्छन्त सुप्रीताः सर्व एव महर्षयः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2130065, "chapter_id": 3803, "verse_number": "३९", "content_sanskrit": "आशीर्वादान् प्रयुञ्जानाः स्वाध्यायनिरता भृशम् ।\nप्रीतास्ते तस्य सत्कारं विधिना पावकोपमाः ।\nउपाजह्रुश्च सलिलं पुष्पमूलफलं शुचि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2130066, "chapter_id": 3803, "verse_number": "४०", "content_sanskrit": "स तैः प्रीत्याऽथ सत्कारमुपनीतं महर्षिभिः ।\nप्रयतः प्रतिगृह्याथ धर्मपुत्रो युधिष्ठिरः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2130067, "chapter_id": 3803, "verse_number": "४१", "content_sanskrit": "तं शक्रसदनप्रख्यं दिव्यगन्धं मनोरमम् ।\nप्रीतः स्वर्गोपमं पुण्यं पाण्डवः सह कृष्णया\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2130068, "chapter_id": 3803, "verse_number": "४२", "content_sanskrit": "विवेश शोभया युक्तं भ्रातृभिश्च सहानघ ।\nब्राह्मणैर्वेदवेदाङ्गपारगैश्च सहस्रशः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2130069, "chapter_id": 3803, "verse_number": "४३", "content_sanskrit": "तत्रापश्यत धर्मात्मा देवदेवर्षिपूजितम् ।\nनरनारायणस्थानं भागीरथ्योपशोभितम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2130070, "chapter_id": 3803, "verse_number": "४४", "content_sanskrit": "मधुस्रवफलं दिव्यं ब्रह्मर्षिगणसेवितम् ।\nतदुपेत्य महात्मानस्तेऽवसन् ब्राह्मणैः सह \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2130071, "chapter_id": 3803, "verse_number": "४५", "content_sanskrit": "मुदा युक्ता महात्मानो रेमिरे तत्र ते तदा ।\nआलोकयन्तो मैनाकं नानाद्विजगणायुतम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2130072, "chapter_id": 3803, "verse_number": "४६", "content_sanskrit": "हिरण्यशिखरं चैव तच्च बिन्दुसरः शिवम् ।\nभागीरथीं च शीतामसजलां शीवाम् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2130073, "chapter_id": 3803, "verse_number": "४७", "content_sanskrit": "दिव्यपुष्पसमाकीर्णां मनःप्रीतिविवर्धिनीम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2130074, "chapter_id": 3803, "verse_number": "४८", "content_sanskrit": "वीक्षमाणा महात्मानो विशालां बदरीमनु\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2130075, "chapter_id": 3803, "verse_number": "४९", "content_sanskrit": "तस्मिन् देवर्षिचरिते देशे परमदुर्गमे ।\nभागीरथीपुण्यजले तर्पयाञ्चक्रिरे तदा ।\nदेवानृषींश्च कौन्तेयाः परमं शौचमास्थिताः।\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2130076, "chapter_id": 3803, "verse_number": "५०", "content_sanskrit": "तत्र ते तर्पयन्तश्च जपन्तश्च कुरूद्वहाः ।\nब्राह्मणैः सहिता वीरा ह्यवसन् पुरुषर्षभाः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2130077, "chapter_id": 3803, "verse_number": "५१", "content_sanskrit": "कृष्णायास्तत्र पश्यन्तः क्रीडितान्यमरप्रभाः ।\nविचित्राणि नरव्याघ्रा रेमिरे तत्र पाण्डवाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2130078, "chapter_id": 3803, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्विचत्वारिंशदधिकशततमोऽध्यायः ॥ १४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2130079, "chapter_id": 3803, "verse_number": "", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि अष्टनवतितमोऽध्यायः ॥९८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]