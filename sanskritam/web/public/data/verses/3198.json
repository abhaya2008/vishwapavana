[{"id": 2101860, "chapter_id": 3198, "verse_number": "१४-५४-१", "content_sanskrit": "उदङ्क उवाच।\nब्रूहि केशव तत्त्वेन त्वमध्यात्ममनिन्दितम्।\nश्रुत्वा श्रेयोऽभिधास्यामि शापं वा ते जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101861, "chapter_id": 3198, "verse_number": "१४-५४-२x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101862, "chapter_id": 3198, "verse_number": "१४-५४-२", "content_sanskrit": "तमो रजश्च सत्वं च विद्धि भावान्मदाश्रयान्।\n`स्थितिसृष्टिलयाध्यक्षो विष्णुब्रह्मेशसंज्ञितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101863, "chapter_id": 3198, "verse_number": "१४-५४-३", "content_sanskrit": "कदाचित्तमसा रुद्रो विष्णुः सत्त्वगुणे स्थितः।\nरजस्यपि तथा ब्रह्मा स्वगुणान्यगुणानुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101864, "chapter_id": 3198, "verse_number": "१४-५४-४", "content_sanskrit": "प्रणवात्मा च शब्दादींस्त्रिगुणात्मा चराचरम्।\nतथा रुद्रान्वसून्वाऽपि विद्धि मत्प्रभवान्द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101865, "chapter_id": 3198, "verse_number": "१४-५४-५", "content_sanskrit": "मयि सर्वाणि भूतानि सर्वभूतेषु चाप्यहम्।\nस्थित इत्यभिजानीहि मा ते भूदत्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101866, "chapter_id": 3198, "verse_number": "१४-५४-६", "content_sanskrit": "तथा दैत्यगणान्सर्वान्यक्षगन्धर्वराक्षसान्।\nनागानप्सरसश्चैव विद्धि मत्प्रभवान्द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101867, "chapter_id": 3198, "verse_number": "१४-५४-७", "content_sanskrit": "सदसच्चैव यत्प्राहुरव्यक्तं व्यक्तमेव च।\nअक्षरं च क्षरं चैव सर्वमेतन्मदात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101868, "chapter_id": 3198, "verse_number": "१४-५४-८", "content_sanskrit": "ये चाश्रमेषु वै धर्माश्चतुर्षु विहिता मुने।\nवैदिकानि च कर्माणि विद्धि सर्वं मदात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101869, "chapter_id": 3198, "verse_number": "१४-५४-९", "content_sanskrit": "असच्च सच्चैव च यद्विश्वं सदसतः परम्।\nततः परतरं नास्ति देवदेवात्सनातनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101870, "chapter_id": 3198, "verse_number": "१४-५४-१०", "content_sanskrit": "ओंकारप्रभवान्वेदान्विद्धि मां त्वं भृगूद्वह।\nयूपं सोमं चरुं होमं त्रिदशाप्यायनं मखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101871, "chapter_id": 3198, "verse_number": "१४-५४-११", "content_sanskrit": "होतारमपि हव्यं च विद्धिं मां भृगुनन्दन।\nअध्वर्युः कल्पकृच्चापि हविः परमसंस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101872, "chapter_id": 3198, "verse_number": "१४-५४-१२", "content_sanskrit": "उद्गाता चापि मां स्तौति गीतघोषैर्महाध्वरे।\nप्रायश्चित्तेषु मां ब्रह्मञ्शान्तिमङ्गलवाचकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101873, "chapter_id": 3198, "verse_number": "१४-५४-१३", "content_sanskrit": "स्तुवन्ति विश्वकर्माणं सततं द्विजसत्तम।\nमम विद्धि सुतं धर्ममग्रजं द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101874, "chapter_id": 3198, "verse_number": "१४-५४-१४", "content_sanskrit": "मानसं दयितं विप्र सर्वभूतदयात्मकम्।\nतत्राहं वर्तमानैश्च निवृत्तैश्चैव मानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101875, "chapter_id": 3198, "verse_number": "१४-५४-१५", "content_sanskrit": "बह्वीः संसरमाणो वै योनीर्वर्तामि सत्तम।\nलोकसरंक्षणार्थाय धर्मसंस्थापनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101876, "chapter_id": 3198, "verse_number": "१४-५४-१६", "content_sanskrit": "तैस्तैर्वेषैश्च रूपैश्च त्रिषु लोकेषु भार्गव।\nअहं विष्णुरहं ब्रह्मा शक्रोऽथ प्रभवाप्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101877, "chapter_id": 3198, "verse_number": "१४-५४-१७", "content_sanskrit": "भूतग्रामस्य सर्वस्य स्रष्टा संहार एव च।\nअधर्मे वर्तमानानां सर्वेषामहमच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101878, "chapter_id": 3198, "verse_number": "१४-५४-१८", "content_sanskrit": "धर्मस्य सेतुं बध्नामि चलिते चलिते युगे।\nतास्ता योनीः प्रविश्याहं प्रजानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101879, "chapter_id": 3198, "verse_number": "१४-५४-१९", "content_sanskrit": "यदा त्वहं देवयोनौ वर्तामि भृगुनन्दन।\nतदाऽहं देववत्सर्वमाचरामि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101880, "chapter_id": 3198, "verse_number": "१४-५४-२०", "content_sanskrit": "यदा गन्धर्वयोनौ तु वर्तामि भृगुनन्दन।\nतदा गन्धर्ववच्चेष्टा सर्वाश्चेष्टामि भार्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101881, "chapter_id": 3198, "verse_number": "१४-५४-२१", "content_sanskrit": "नागयोनौ यदा चैव तदा वर्तामि नागवत्।\nयक्षराक्षसयोन्योस्तु यथावद्विचराम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101882, "chapter_id": 3198, "verse_number": "१४-५४-२२", "content_sanskrit": "मानुष्ये वर्तमाने तु कृपणं याचिता मया।\nन च ते जातसम्मोहा वचोऽगृह्णन्त मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101883, "chapter_id": 3198, "verse_number": "१४-५४-२३", "content_sanskrit": "भयं च महदुद्दिश्य त्रासिताः कुरवो मया।\nक्रुद्धेन भूत्वा तु पुर्यथावदनुदर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101884, "chapter_id": 3198, "verse_number": "१४-५४-२४", "content_sanskrit": "तेऽधर्मेणेह संयुक्ताः परीताःक कालधर्मणा।\nधर्मेण निहता युद्धे गताः स्वर्गं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101885, "chapter_id": 3198, "verse_number": "१४-५४-२५", "content_sanskrit": "लोकेषु पाण्डवाश्चैव गताः ख्यातिं द्विजोत्तम।\nएतत्ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101886, "chapter_id": 3198, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि चतुःपञ्चाशोऽध्यायः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]