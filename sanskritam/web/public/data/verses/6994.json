    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20129564,
    "chapter_id": 6994,
    "verse_number": "11.49",
    "content_sanskrit": "उरुद्वृत्तः स एव स्याद्वामश्चैवापसर्पितः । कार्यस्त्रिकविवर्त्तश्च दक्षिणः स्पन्दितो भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20129565,
    "chapter_id": 6994,
    "verse_number": "11.50",
    "content_sanskrit": "शकटास्यो भवेद्वामस्तदेवास्फोटनं भवेत् । एतदास्पन्दितं नाम व्यायामे युद्धमण्डलम् ॥",
