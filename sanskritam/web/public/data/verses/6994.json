    "avatarnika": ""
  },
  {
    "id": 20129568,
    "chapter_id": 6994,
    "verse_number": "11.53",
    "content_sanskrit": "आद्यो भ्रमरकश्चैव त्रिकं च परिवर्तयेत् । पृष्ठापसर्पी वामश्चेत्यावर्तं मण्डलं भवेत् ॥",
