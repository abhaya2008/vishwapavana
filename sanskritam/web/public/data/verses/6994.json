    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20129576,
    "chapter_id": 6994,
    "verse_number": "11.61",
    "content_sanskrit": "वामो भ्रमरकः कार्य आद्य आस्कन्दितो भवेत् । तेनैवास्फोटनं कुर्यादेतदड्डितमण्डलम् ॥",
