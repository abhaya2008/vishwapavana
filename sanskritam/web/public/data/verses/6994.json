  {
    "id": 20129539,
    "chapter_id": 6994,
    "verse_number": "11.24",
    "content_sanskrit": "पार्श्वक्रान्तः पुनश्चाद्यो भुजङ्गत्रासितस्तथा । अतिक्रान्तः पुनर्वामो दण्डपादश्च दक्षिणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
