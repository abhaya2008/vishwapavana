  },
  {
    "id": 20129572,
    "chapter_id": 6994,
    "verse_number": "11.57",
    "content_sanskrit": "पादैस्तु भूमिसंयुक्तैः सूचीविद्धैस्तथैव च । एडकाक्रीडितैश्चैव तूर्णैस्त्रिकविवर्तितैः ॥",
