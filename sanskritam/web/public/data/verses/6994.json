    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20129567,
    "chapter_id": 6994,
    "verse_number": "11.52",
    "content_sanskrit": "पृष्ठापसर्पी वामश्च स च चाषगतिर्भवेत् । आस्पन्दितः पुनर्दक्षः शकटास्यश्च वामकः ॥",
