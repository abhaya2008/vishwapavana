    "avatarnika": ""
  },
  {
    "id": 20129569,
    "chapter_id": 6994,
    "verse_number": "11.54",
    "content_sanskrit": "समपादं बुधः कृत्वा स्थानं हस्तौ प्रसारयेत् । निरन्तरावूर्ध्वतलावावेष्ट्योद्वेष्ट्य चैव हि ॥",
