    "chapter_id": 6994,
    "verse_number": "11.71",
    "content_sanskrit": "एतानि खण्डानि समण्डलानि युद्धे नियुद्धे च परिक्रमे च । लीलाङ्गमाधुर्यपुरस्कृतानि कार्याणि वाद्यानुगतानि तज्ज्ञैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
