  {
    "id": 20129575,
    "chapter_id": 6994,
    "verse_number": "11.60",
    "content_sanskrit": "आद्यः पृष्ठापसर्पी च स च चाषगतिर्भवेत् । अड्डितश्च पुनर्वाम आद्यश्चैवापसर्पितः ॥",
