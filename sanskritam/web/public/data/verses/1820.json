[{"id": 2037863, "chapter_id": 1820, "verse_number": "५-६५-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037864, "chapter_id": 1820, "verse_number": "५-६५-१", "content_sanskrit": "दुर्योधन विजानीहि यत्त्वां वक्ष्यामि पुत्रक।\nउत्पथं मन्यसे मार्गमनभिज्ञ इवाध्वगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037865, "chapter_id": 1820, "verse_number": "५-६५-२", "content_sanskrit": "पञ्चानां पाण्डुपुत्राणां यत्तेजः प्रजिहीर्षसि।\nपञ्चानामिव भूतानां महतां लोकधारिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037866, "chapter_id": 1820, "verse_number": "५-६५-३", "content_sanskrit": "युधिष्ठिरं हि कौन्तेयं परं धर्ममिहास्थितम्।\nपरां गतिमसंप्रेत्य न त्वं जेतुमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037867, "chapter_id": 1820, "verse_number": "५-६५-४", "content_sanskrit": "भीमसेनं च कौन्तेयं यस्य नास्ति समो बले।\nरणान्तकं तर्जयसे महावातमिव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037868, "chapter_id": 1820, "verse_number": "५-६५-५", "content_sanskrit": "सर्वशस्त्रभृतां श्रेष्ठं मेरुं सिखरिणामिव।\nयुधि गाण्डिवधन्वानं को नु युध्येत बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037869, "chapter_id": 1820, "verse_number": "५-६५-६", "content_sanskrit": "धृष्टद्युम्नश्च पाञ्चाल्यः कमिवाद्य न शातयेत्।\nशत्रुमध्ये शरान्मुञ्चन्देवराडशनीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037870, "chapter_id": 1820, "verse_number": "५-६५-७", "content_sanskrit": "सात्यकिश्चापि दुर्धर्षः संमतोऽन्धकवृष्णिषु।\nध्वंसयिष्यति ते सेनां पाण्डवेयहिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037871, "chapter_id": 1820, "verse_number": "५-६५-८", "content_sanskrit": "यः पुनः प्रतिमानेन त्रील्लोकानतिरिच्यते ।\nतं कृष्णं पुण्डरीकाक्षं को नु युद्ध्येत बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037872, "chapter_id": 1820, "verse_number": "५-६५-९", "content_sanskrit": "एकतो ह्यस्य दाराश्च ज्ञातयश्च सबान्धवाः।\nआत्मा च पृथिवी चेयमेकतश्च धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037873, "chapter_id": 1820, "verse_number": "५-६५-१०", "content_sanskrit": "वासुदेवोऽपि दुर्धर्षो यतात्मा यत्र पाण्डवः ।\nअविषह्यं पृथिव्यापि तद्बलं यत्र केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037874, "chapter_id": 1820, "verse_number": "५-६५-११", "content_sanskrit": "तिष्ठ तात सतां वाक्ये सुहृदामर्थवादिनाम्।\nवृद्धं शान्तनवं भीष्मं तितिक्षस्व पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037875, "chapter_id": 1820, "verse_number": "५-६५-१२", "content_sanskrit": "मां च ब्रुवाणं शुश्रूष कुरूणामर्थदर्शिनम् ।\nद्रोणं कृपं विकर्णं च महाराजं च बाह्लिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037876, "chapter_id": 1820, "verse_number": "५-६५-१३", "content_sanskrit": "एते ह्यपि यतैवाहं मन्तुमर्हसि तांस्तथा।\nसर्वे धर्मविदो ह्येते तुल्यस्नेहाश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037877, "chapter_id": 1820, "verse_number": "५-६५-१४", "content_sanskrit": "यत्तद्विराटनगरे सह भ्रातृभिरग्रतः।\nउत्सृज्य गाः सुसन्त्रस्तं बलं ते समशीर्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037878, "chapter_id": 1820, "verse_number": "५-६५-१५", "content_sanskrit": "यच्चैव नगरे तस्मिञ्श्रूयते महदद्भुतम्।\nएकस्य च बहूनां च पर्याप्तं तन्निदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037879, "chapter_id": 1820, "verse_number": "५-६५-१६", "content_sanskrit": "अर्जुनस्तत्तथाकार्षीत्किं पुनः सर्व एव ते।\nस भ्रातॄनभिजानीहि वृत्त्या तं प्रतिपादय ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037880, "chapter_id": 1820, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि पञ्चषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]