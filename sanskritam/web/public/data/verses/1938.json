[{"id": 2042158, "chapter_id": 1938, "verse_number": "५-१८३-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042159, "chapter_id": 1938, "verse_number": "५-१८३-१", "content_sanskrit": "ततोऽहं निशि राजेन्द्र प्रणम्य शिरसा तदा।\nब्राह्मणानां पितॄणां च देवतानां च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042160, "chapter_id": 1938, "verse_number": "५-१८३-२", "content_sanskrit": "नक्तंचराणां भूतानां राजन्यानां विशांपते।\nशयनं प्राप्य रहिते मनसा समचिन्तयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042161, "chapter_id": 1938, "verse_number": "५-१८३-३", "content_sanskrit": "जामदग्न्येन मे युद्धमिदं परमदारुणम् ।\nअहानि च बहून्यद्य वर्तते सुमहात्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042162, "chapter_id": 1938, "verse_number": "५-१८३-४", "content_sanskrit": "न च रामं महावीर्यं शक्नोमि रणमूर्धनि ।\nविजेतुं समरे विप्रं जामदग्न्यं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042163, "chapter_id": 1938, "verse_number": "५-१८३-५", "content_sanskrit": "यदि शक्यो मया जेतुं जामदग्न्यः प्रतापवान् ।\nदैवतानि प्रसन्नानि दर्शयन्तु निशां मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042164, "chapter_id": 1938, "verse_number": "५-१८३-६", "content_sanskrit": "ततो निशि च राजेन्द्र प्रसुप्तः शरविक्षतः ।\nदक्षिणेनेह पार्श्वेन प्रभातसमये तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042165, "chapter_id": 1938, "verse_number": "५-१८३-७", "content_sanskrit": "ततोऽहं विप्रमुख्यैस्तैर्यैरस्मि पतितो रथात्।\nउत्थापितो धृतश्चैव मा भैरिति च सान्त्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042166, "chapter_id": 1938, "verse_number": "५-१८३-८", "content_sanskrit": "त एव मां महाराज स्वप्ने दर्शनमेत्य वै ।\nपरिवार्याब्रुवन्वाक्यं तन्निबोध कुरूद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042167, "chapter_id": 1938, "verse_number": "५-१८३-९", "content_sanskrit": "उत्तिष्ठ मा भैर्गाङ्गेय न भयं तेऽस्ति किंचन।\nरक्षामहे त्वां कौरव्य स्वशरीरं हि नो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042168, "chapter_id": 1938, "verse_number": "५-१८३-१०", "content_sanskrit": "न त्वां रामो रणे जेता जामदग्न्यः कथंचन ।\nत्वमेव समरे रामं विजेता भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042169, "chapter_id": 1938, "verse_number": "५-१८३-११", "content_sanskrit": "इदमस्त्रं सुदयितं प्रत्यभिज्ञास्यते भवान् ।\nविदितं हि तवाप्येतत्पूर्वस्मिन्देहधारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042170, "chapter_id": 1938, "verse_number": "५-१८३-१२", "content_sanskrit": "प्राजापत्यं विश्वकृतं प्रस्वापं नाम भारत ।\nन हीदं वेद रामोऽपि पृथिव्यां वा पुमान्क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042171, "chapter_id": 1938, "verse_number": "५-१८३-१३", "content_sanskrit": "तत्स्मरस्व महाबाहो भृशं संयोजयस्व च।\nउपस्थास्यति राजेन्द्र स्वयमेव तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042172, "chapter_id": 1938, "verse_number": "५-१८३-१४", "content_sanskrit": "येन सर्वान्महावीर्यान्प्रशासिष्यसि कौरव ।\nन च रामः क्षयं गन्ता तेनास्त्रेण नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042173, "chapter_id": 1938, "verse_number": "५-१८३-१५", "content_sanskrit": "एनसा न तु संयोगं प्राप्स्यसे जातु मानद ।\nस्वप्स्यते जामदग्न्योऽसौ त्वद्बाणबलपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042174, "chapter_id": 1938, "verse_number": "५-१८३-१६", "content_sanskrit": "ततो जित्वा त्वमेवैनं पुनरुत्थापयिष्यसि।\nअस्त्रेण दयितेनाजौ भीष्म संबोधनेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042175, "chapter_id": 1938, "verse_number": "५-१८३-१७", "content_sanskrit": "एवं कुरुष्व कौरव्य प्रभाते रथमास्थितः।\nप्रसुप्तं वा मृतं वेति तुल्यं मन्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042176, "chapter_id": 1938, "verse_number": "५-१८३-१८", "content_sanskrit": "न च रामेण मर्तव्यं कदाचिदपि पार्थिव।\nततः समुत्पन्नमिदं प्रस्वापं युज्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042177, "chapter_id": 1938, "verse_number": "५-१८३-१९", "content_sanskrit": "इत्युक्त्वान्तर्हिता राजन्सर्व एव द्विजोत्तमाः ।\nअष्टौ सदृशरूपास्ते सर्वे भासुरमूर्तयः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042178, "chapter_id": 1938, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि त्र्यशीत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]