[{"id": 2143928, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2143929, "chapter_id": 4102, "verse_number": "१", "content_sanskrit": "ब्रूहि भूयो महाबुद्धे धर्मार्थसहितं वचः ।\nशृण्वतो नास्ति मे तृप्तिर्विचित्राणीह भाषसे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2143930, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2143931, "chapter_id": 4102, "verse_number": "२", "content_sanskrit": "सर्वतीर्थेषु वा स्नानं सर्वभूतेषु चार्जवम् ।\nउभे त्वेते समे स्यातामार्जवं वा विशिष्यते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2143932, "chapter_id": 4102, "verse_number": "३", "content_sanskrit": "आर्जवं प्रतिपद्यस्व पुत्रेषु स्वेषु तेषु च ।\nइह कीर्तिं परां प्राप्य प्रेत्य स्वर्गमवाप्नुहि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2143933, "chapter_id": 4102, "verse_number": "४", "content_sanskrit": "यावत् कीर्तिर्मनुष्यस्य पुण्या लोके प्रगीयते ।\nतावत् स पुरुषव्याघ्र स्वर्गलोके महीयते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2143934, "chapter_id": 4102, "verse_number": "५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nविरोचनस्य संवादं केशिन्यर्थे सुधन्वना\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2143935, "chapter_id": 4102, "verse_number": "६", "content_sanskrit": "स्वयंवरे स्थिता कन्या केशिनी नाम नामतः ।\nरूपेणाप्रतिमा राजन् विशिष्टपतिकाम्यया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2143936, "chapter_id": 4102, "verse_number": "७", "content_sanskrit": "विरोचनोऽथ दैतेयः तदा तत्राजगाम ह ।\nप्राप्तुमिच्छंस्ततस्तत्र दैत्येन्द्रं प्राह केशिनी\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2143937, "chapter_id": 4102, "verse_number": "८", "content_sanskrit": "किं ब्राह्मणाः स्विच्छ्रेयांसो दितिजाः स्विद् विरोचन ।\nअथ केन स्म पर्यङ्कं सुधन्वा नाधिरोहति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2143938, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विरोचनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2143939, "chapter_id": 4102, "verse_number": "९", "content_sanskrit": "प्राजापत्या वयं श्रेष्ठाः सर्वे केशिनि सत्तमाः ।\nअस्माकं खल्विमे लोकाः के देवाः के द्विजातयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2143940, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "केशिनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2143941, "chapter_id": 4102, "verse_number": "१०", "content_sanskrit": "इहैवावां प्रतीक्षाव उपस्थाने विरोचन ।\nसुधन्वा प्रातरागन्ता पश्येयं वां समागतौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2143942, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विरोचनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2143943, "chapter_id": 4102, "verse_number": "११", "content_sanskrit": "तथा भद्रे करिष्यामि यथा त्वं भीरु भाषसे ।\nसुधन्वानं च मां चैव प्रातर्द्रष्टासि सङ्गतौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2143944, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2143945, "chapter_id": 4102, "verse_number": "१२", "content_sanskrit": "अतीतायां च शर्वर्यामुदिते सूर्यमण्डले ।\nअथाजगाम तं देशं सुधन्वा राजसत्तम\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2143946, "chapter_id": 4102, "verse_number": "१३", "content_sanskrit": "विरोचनो यत्र विभो केशिन्या सहितः स्थितः ।\nसुधन्वा तं समागच्छत् प्राह्लादिं केशिनी तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2143947, "chapter_id": 4102, "verse_number": "१४", "content_sanskrit": "समागतं द्विजं दृष्ट्वा केशिनी भरतर्षभ ।\nप्रत्युत्थायासनं तस्मै पाद्यमर्घ्यं ददौ पुनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2143948, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "सुधन्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2143949, "chapter_id": 4102, "verse_number": "समाप्तिः", "content_sanskrit": "इति होवाच वचनं विरोचनमनुत्तमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2143950, "chapter_id": 4102, "verse_number": "१६", "content_sanskrit": "आस्स्व तल्पे हि सौवर्णे प्राह्लादे ब्राह्मणस्त्वहम् ।\nअन्वालभे हिरण्मयं प्राह्लादेदं वरासनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2143951, "chapter_id": 4102, "verse_number": "१७", "content_sanskrit": "एकत्वमुपसम्पन्नो न त्वासेयं त्वया सह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2143952, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विरोचनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2143953, "chapter_id": 4102, "verse_number": "१८", "content_sanskrit": "तवार्हते तु फलकं कूर्चं वाऽप्यथवा बृसी ।\nहरन्तु फलकं कूर्चं तथा बृस्यस्तृणानि च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2143954, "chapter_id": 4102, "verse_number": "१९", "content_sanskrit": "सुधन्वन् न त्वमर्होऽसि मया सह समासनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2143955, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "सुधन्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2143956, "chapter_id": 4102, "verse_number": "२०", "content_sanskrit": "पितापुत्रौ सहासीतां द्वौ विप्रौ क्षत्रियावपि ।\nवैश्यौ द्वौ चैव शूद्रौ च न त्वन्यावितरेतरम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2143957, "chapter_id": 4102, "verse_number": "२१", "content_sanskrit": "पिता हि ते समासीनमुपोपासीत मामधः ।\nबालः सुखोषितो गेहे न त्वं किञ्चन बुध्यसे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2143958, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विरोचनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2143959, "chapter_id": 4102, "verse_number": "२२", "content_sanskrit": "हिरण्यं च गवाश्वं च यद्वित्तमसुरेषु नः ।\nसुधन्वन् विपणे तेन प्रश्नं पृच्छाव ये विदुः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2143960, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "सुधन्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2143961, "chapter_id": 4102, "verse_number": "२३", "content_sanskrit": "हिरण्यं च गवाश्वं च तवैवास्तु विरोचन ।\nप्राणयोस्तु पणं कृत्वा प्रश्नं पृच्छाव ये विदुः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2143962, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विरोचनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2143963, "chapter_id": 4102, "verse_number": "२४", "content_sanskrit": "आवां कुत्र गमिष्यावः प्राणयोर्विपणे कृते ।\nन तु देवेष्वहं स्थाता न मनुष्येषु कर्हिचित्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2143964, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "सुधन्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2143965, "chapter_id": 4102, "verse_number": "२५", "content_sanskrit": "पितरं ते गमिष्यावः प्राणयोर्विपणे कृते ।\nपुत्रस्यापि स हेतोर्हि प्रह्लादो नानृतं वदेत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2143966, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2143967, "chapter_id": 4102, "verse_number": "२६", "content_sanskrit": "एवं कृतपणौ क्रुद्धौ तदा तत्रैव जग्मतुः ।\nविरोचनसुधन्वानौ प्रह्लादो यत्र तिष्ठति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2143968, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2143969, "chapter_id": 4102, "verse_number": "२७", "content_sanskrit": "इमौ तौ सम्प्रदृश्येते याभ्यां न चरितं सह ।\nआशीविषाविव क्रुद्धावेकमार्गाविहागतौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2143970, "chapter_id": 4102, "verse_number": "२८", "content_sanskrit": "किं वां सहैव चरथो न पुरा चरथः सह ।\nविरोचनैतत् पृच्छामि किं ते सख्यं सुधन्वना\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2143971, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विरोचनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2143972, "chapter_id": 4102, "verse_number": "२९", "content_sanskrit": "न मे सुधन्वना सख्यं प्राणयोर्विपेअणावहे ।\nतत् त्वां पृच्छावहे तात मा प्रश्नमनृतं वदेः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2143973, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2143974, "chapter_id": 4102, "verse_number": "३०", "content_sanskrit": "उदकं मधुपर्कं चाप्यानयन्तु सुधन्वने ।\nब्रह्मन्नभ्यर्चनीयोऽसि श्वेता गौः पीवरीकृता\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2143975, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "सुधन्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2143976, "chapter_id": 4102, "verse_number": "३१", "content_sanskrit": "उदकं मधुपर्कं च प्रश्नवाचाऽर्पितं मम\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2143977, "chapter_id": 4102, "verse_number": "३२", "content_sanskrit": "प्रह्लाद त्वं तु मे तथ्यं प्रश्नं प्रब्रूहि पृच्छतः ।\nकिं ब्राह्मणाः स्विच्छ्रेयांस उताहोस्विद् विरोचनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2143978, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2143979, "chapter_id": 4102, "verse_number": "३३", "content_sanskrit": "न कल्माषो न कपिलो न कृष्णो न च लोहितः ।\nअणीयान् क्षुरधारायाः को धर्मं वक्तुमर्हसि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2143980, "chapter_id": 4102, "verse_number": "३४", "content_sanskrit": "पुत्र एको मम ब्रह्मन् त्वं च साक्ष्ये व्यवस्थितः ।\nतयोर्विवदतोः प्रश्नं कथमस्मद्विधो वदेत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2143981, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "सुधन्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2143982, "chapter_id": 4102, "verse_number": "३५", "content_sanskrit": "यद्यतत्वं तु वक्तासि यदि वाऽपि न वक्ष्यसि ।\nप्रह्लाद प्रश्नमतुलं मूर्धा ते विफलिष्यति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2143983, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2143984, "chapter_id": 4102, "verse_number": "३६", "content_sanskrit": "आदित्येन सहायान्तं प्रह्लादो हंसमब्रवीत् ।\nधृतराष्ट्रं महाप्राज्ञं सर्वज्ञं सर्वदर्शिनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2143985, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2143986, "chapter_id": 4102, "verse_number": "३७", "content_sanskrit": "पुत्रो वाऽन्यो भवेद् ब्रह्मन् साक्ष्ये चापि भवेत् स्थितः ।\nतयोर्विवदतोर्हंस कथं धर्मः प्रवर्तते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2143987, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "हंसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2143988, "chapter_id": 4102, "verse_number": "३८", "content_sanskrit": "गां वै दद्यात् त्वौरसाय यद्वाऽन्यत् स्यात् प्रियं धनम् ।\nद्वयोर्विवदतोस्तथ्यं वाच्यं च मतिमंस्त्वया\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2143989, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2143990, "chapter_id": 4102, "verse_number": "३९", "content_sanskrit": "अथ यो नैव प्रब्रूयात् सत्यं वा यदि वाऽनृतम् ।\nहंस तत्वेन पृच्छामि दुर्विवेक्तास्मि किं वदे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2143991, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "हंसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2143992, "chapter_id": 4102, "verse_number": "४०", "content_sanskrit": "पृष्टो धर्मं न विब्रूयाद् गोकर्णशिथिलं चरन् ।\nधर्माद् भ्रश्यति राजंस्तु नास्य लोकोऽस्ति न प्रजाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2143993, "chapter_id": 4102, "verse_number": "४१", "content_sanskrit": "धर्म एतान् संरुजति यथा नद्यनुकूलजान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2143994, "chapter_id": 4102, "verse_number": "४२", "content_sanskrit": "ये धर्ममनुपश्यन्तः तूष्णीं ध्यायन्त आसते ।\nश्रेष्ठोऽर्धं तु हरेत् तत्र भवेत् पादश्च कर्तरि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2143995, "chapter_id": 4102, "verse_number": "४३", "content_sanskrit": "पादस्तेषु सभासत्सु यत्र निन्द्यो न निन्द्यते\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2143996, "chapter_id": 4102, "verse_number": "४४", "content_sanskrit": "अनेना भवति श्रेष्ठो मुच्यन्ते च सभासदः ।\nकर्तारमेनो गच्छेच्च निन्द्यो यत्र हि निन्द्यते\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2143997, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2143998, "chapter_id": 4102, "verse_number": "४५", "content_sanskrit": "मोहाद्वा चैव कामाद्वा मिथ्यावादं यदि ब्रुवन् ।\nधृतराष्ट्र तत् त्वं पृच्छामि दुर्विवक्ता तु किं वसेत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2143999, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "हंसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2144000, "chapter_id": 4102, "verse_number": "४६", "content_sanskrit": "यां रात्रिमधिविन्ना स्त्री यां चैवाक्षपराजितः ।\nयां च भाराभितप्ताङ्गो दुर्विवक्ता तु तां वसेत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2144001, "chapter_id": 4102, "verse_number": "४७", "content_sanskrit": "नगरे प्रतिरुद्धः सन् बहिर्द्वारो बुभुक्षितः ।\nअमित्रान् भूयसः पश्यन् दुर्विवक्ता तु तां वसेत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2144002, "chapter_id": 4102, "verse_number": "४८", "content_sanskrit": "यां च रात्रिमभिद्रुग्धो यां च पुत्रे प्रिये मृते ।\nसर्वस्वेन च यो हीनो दुर्विवक्ता तु तां वसेत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2144003, "chapter_id": 4102, "verse_number": "४९", "content_sanskrit": "पञ्च पश्वनृतं हन्ति दश हन्ति गवानृते ।\nशतमश्वानृते हन्ति सहस्रं पुरुषानृते\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2144004, "chapter_id": 4102, "verse_number": "५०", "content_sanskrit": "हन्ति जातानजातांश्च हिरण्यार्थेऽनृतं वदन् ।\nसर्वं भूम्यनृते हन्ति मा स्म भूम्यनृतं वदेः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2144005, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2144006, "chapter_id": 4102, "verse_number": "५१", "content_sanskrit": "मत्तः श्रेयानङ्गिरा वै सुधन्वा त्वद् विरोचन ।\nमाताऽस्य श्रेयसी मातुस्तस्मात् त्वं तेन वै जितः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2144007, "chapter_id": 4102, "verse_number": "५२", "content_sanskrit": "विरोचन सुधन्वाऽयं प्राणानामीश्वरस्तव ।\nसुधन्वन् पुत्रमिच्छामि त्वया दत्तं विरोचनम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2144008, "chapter_id": 4102, "verse_number": "", "content_sanskrit": "सुधन्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2144009, "chapter_id": 4102, "verse_number": "५३", "content_sanskrit": "यद्धर्ममवृणीथास्त्वं न कामादनृतं वदीः ।\nपुनर्ददामि ते पुत्रं तस्मात् प्रह्लाद दुर्लभम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2144010, "chapter_id": 4102, "verse_number": "५४", "content_sanskrit": "एष प्रह्लाद पुत्रस्ते मया दत्तो विरोचनः ।\nपादप्रक्षालनं कुर्यात् कुमार्याः सन्निधौ मम\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2144011, "chapter_id": 4102, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुस्त्रिंशोऽध्यायः ॥३४॥ प्रजागरपर्वणि तृतीयोऽध्यायः ॥३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]