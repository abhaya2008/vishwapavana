[{"id": 2020014, "chapter_id": 1418, "verse_number": "३-५६-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020015, "chapter_id": 1418, "verse_number": "३-५६-१", "content_sanskrit": "एवं स समयं कृत्वा द्वापरेण कलिः सह।\nआजगाम ततस्तत्र यत्रराजा स नैषधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020016, "chapter_id": 1418, "verse_number": "३-५६-२", "content_sanskrit": "स नित्यमन्तरप्रेक्षी निषधेष्ववसच्चिरम्।\nअथास्य द्वादशे वर्षे ददर्श कलिरन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020017, "chapter_id": 1418, "verse_number": "३-५६-३", "content_sanskrit": "कृत्वा मूत्रमुपस्पृश्य संध्यामन्वास्त नैषधः।\nअकृत्वा पादयोः शौचं तत्रैनं कलिराविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020018, "chapter_id": 1418, "verse_number": "३-५६-४", "content_sanskrit": "स समाविश्य च नलं समीपं पुष्करस्य च।\nगत्वा पुष्करमाहेदमेहि दीव्य नलेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020019, "chapter_id": 1418, "verse_number": "३-५६-५", "content_sanskrit": "अक्षद्यूते नलं जेता भवान्हि सहितो मया।\nनिषधान्प्रतिपद्यस्व जित्वा राज्यं नलं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020020, "chapter_id": 1418, "verse_number": "३-५६-६", "content_sanskrit": "एवमुक्तस्तु कलिना पुष्करो नलमभ्ययात्।\nकलिश्चैव वृषो भूत्वा तं वै पुष्करमन्वयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020021, "chapter_id": 1418, "verse_number": "३-५६-७", "content_sanskrit": "आसाद्य तु नलं वीरं पुष्करः परवीरहा।\nदीव्यावेत्यब्रवीद्धाता वृषेणेति मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020022, "chapter_id": 1418, "verse_number": "३-५६-८", "content_sanskrit": "न चक्षमे ततो राजा समाह्वानं महामनाः।\nवैदर्भ्याः प्रेक्षमाणायाः प्राप्तकालममन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020023, "chapter_id": 1418, "verse_number": "३-५६-९", "content_sanskrit": "`ततः स राज्ञा सहसा देवितुं संप्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020024, "chapter_id": 1418, "verse_number": "३-५६-१०", "content_sanskrit": "भ्रात्रा देवाभिभूतेन दैवाविष्टो जनाधिपः।\nहिरण्यस्य सुवर्णस्य यानयुग्यस् वाससाम्।\nआविष्टः कलिना द्यूते जीयते स्म नलस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020025, "chapter_id": 1418, "verse_number": "३-५६-११", "content_sanskrit": "तमक्षमदसंमत्तं सुहृदां न तु कश्चन।\nनिवारणेऽभवच्छक्तो दीव्यमानमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020026, "chapter_id": 1418, "verse_number": "३-५६-१२", "content_sanskrit": "ततः पौरजनाः सर्वे मन्त्रिभिः सह भारत।\nराजानं द्रष्टुमागच्छन्निवारयितुमातुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020027, "chapter_id": 1418, "verse_number": "३-५६-१३", "content_sanskrit": "ततः सूत उपागम्य दमयन्त्यै न्यवेदयत्।\nएष पौरजनो देवि द्वारि तिष्ठति कार्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020028, "chapter_id": 1418, "verse_number": "३-५६-१४", "content_sanskrit": "निवेद्यतां नैषधाय सर्वाः प्रकृतयः स्थिताः।\nअमृष्यमाणा व्यसनं राज्ञो धर्मार्थदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020029, "chapter_id": 1418, "verse_number": "३-५६-१५", "content_sanskrit": "ततः सा बाष्पकलया वाचा दुखेन कर्शिता।\nउवाच नैषधं भैमी शोकोपहतचेतना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020030, "chapter_id": 1418, "verse_number": "३-५६-१६", "content_sanskrit": "राजन्पौरजनो द्वारि त्वां दिदृक्षुरवस्थितः।\n`वृद्धैर्ब्राह्मणमुख्यैश्च वणिग्भिश्च समन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020031, "chapter_id": 1418, "verse_number": "३-५६-१७", "content_sanskrit": "आगतं सहितं राजंस्त्वत्प्रसादावलम्बनम्।\nतं द्रष्टुमर्हसीत्येवं पुनः पुनरभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020032, "chapter_id": 1418, "verse_number": "३-५६-१८", "content_sanskrit": "तां तथा रुचिरापाङ्गीं विलपन्तीं तथाविधाम्।\nआविष्टः कलिना राजा नाभ्यभाषत किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020033, "chapter_id": 1418, "verse_number": "३-५६-१९", "content_sanskrit": "ततस्ते मन्त्रिणः सर्वे ते चैव पुरवासिनः।\nनायमस्तीति दुःखार्ता व्रीडिता जग्मुरालयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020034, "chapter_id": 1418, "verse_number": "३-५६-२०", "content_sanskrit": "तथा तदभवद्द्यूतं पुष्करस्य नलस्य च।\nयुधिष्ठिर बहून्मासान्पुण्यश्लोकस्त्वजीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020035, "chapter_id": 1418, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि षट्पञ्चाशोऽध्यायः ॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]