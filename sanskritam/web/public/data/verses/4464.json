[{"id": 2159509, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159510, "chapter_id": 4464, "verse_number": "१", "content_sanskrit": "अथ संशप्तकैः सार्धं युद्ध्यमाने धनञ्जये ।\nअभिमन्यौ हते चापि बाले बलवतां वरे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159511, "chapter_id": 4464, "verse_number": "२", "content_sanskrit": "महर्षिसत्तमे याते युधिष्ठिरपुरोगमाः ।\nपाण्डवाः किमथाऽकार्षुः शोकेन हतचेतसः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159512, "chapter_id": 4464, "verse_number": "३", "content_sanskrit": "कथं संशप्तकेभ्यो वा निवृत्तो वानरध्वजः ।\nकेन वा कथितस्तस्य प्रशान्तः सुतपावकः\nएतन्मे शंस तत्त्वेन सर्वमेवेह सञ्जय\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159513, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159514, "chapter_id": 4464, "verse_number": "४", "content_sanskrit": "शृणु राजन् यथा तेभ्यो निवृत्तः कृष्णसारथिः ।\nततः सर्वाणि सैन्यानि दहन् कृष्णगतिर्यथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159515, "chapter_id": 4464, "verse_number": "५", "content_sanskrit": "सम्प्रयातेऽस्तमादित्ये सन्ध्याकाल उपस्थिते ।\nआयान्तमात्मशिबिरं निमित्तैरघशंसिभिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159516, "chapter_id": 4464, "verse_number": "६", "content_sanskrit": "यच्चासीन्मानसं तस्य यच्च कृष्णेन भाषितम् ।\nयथा च कथितस्तस्य निहतः सुतपावकः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159517, "chapter_id": 4464, "verse_number": "७", "content_sanskrit": "विस्तरेणैव मे सर्वं ब्रुवतः शृणु मारिष \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159518, "chapter_id": 4464, "verse_number": "८", "content_sanskrit": "तस्मिन्नहनि निर्वृत्ते घोरे प्राणभृतां क्षये ।\nआदित्येऽस्तं गते श्रीमान् सन्ध्याकाल उपस्थिते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159519, "chapter_id": 4464, "verse_number": "९", "content_sanskrit": "व्यपयातेषु सैन्येषु वासाय भरतर्षभः ।\nहत्वा संशप्तकव्रातान् दिव्यैरस्त्रैः कपिध्वजः\nआयात् स्वशिबिरं जिष्णुर्जैत्रमास्थाय तं रथम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159520, "chapter_id": 4464, "verse_number": "१०", "content_sanskrit": "गच्छन्नेव च गोविन्दं सन्नकण्ठोऽभ्यभाषत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159521, "chapter_id": 4464, "verse_number": "११", "content_sanskrit": "किन्नु मे हृदयं त्रस्तं वाक्यं सज्जति केशव ।\nस्पन्दन्तेऽङ्गान्यनिष्टानि गात्रैः सीदामि चाच्युत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159522, "chapter_id": 4464, "verse_number": "१२", "content_sanskrit": "अनिष्टं चैव मे श्लिष्टं हृदयान्नापसर्पति ।\nभूम्यां दिवि तथाऽत्युग्रा उत्पातास्त्रासयन्ति माम्\nबहुप्रकारा दृश्यन्ते सर्व एवाघशंसिनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159523, "chapter_id": 4464, "verse_number": "१३", "content_sanskrit": "अपि स्वस्ति भवेद् राज्ञः सामात्यस्य गुरोर्मम॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159524, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2159525, "chapter_id": 4464, "verse_number": "१४", "content_sanskrit": "व्यक्तं शिवं सहभ्रातुः सामात्यस्य भविष्यति ।\nमा शुचः किञ्चिदेवान्यत् तत्रानिष्टं भविष्यति\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2159526, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2159527, "chapter_id": 4464, "verse_number": "१५", "content_sanskrit": "ततः सन्ध्यामुपास्यैव वीरौ वीरावसादने ।\nकथयन्तौ रणे वृत्तं प्रयातौ रथमास्थितौ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2159528, "chapter_id": 4464, "verse_number": "१६", "content_sanskrit": "ततः स्वशिबिरं प्राप्तौ हतामित्रौ हतद्विषौ ।\nवासुदेवार्जुनौ चैव कृत्वा कर्म सुदुष्करम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2159529, "chapter_id": 4464, "verse_number": "१७", "content_sanskrit": "ध्वस्ताकारं समालक्ष्य संवीक्ष्य परवीरहा ।\nबीभत्सुरब्रवीत् कृष्णमस्वस्थहृदयस्तदा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2159530, "chapter_id": 4464, "verse_number": "१८", "content_sanskrit": "नाद्य नर्दन्ति तूर्याणि मङ्गलानि जनार्दन ।\nमिश्रा दुन्दुभिनिर्घोषैः शङ्खा आडम्बरैः सह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2159531, "chapter_id": 4464, "verse_number": "१९", "content_sanskrit": "वीणा न साधु वाद्यन्ते शम्याताळरवैः सह ।\nमङ्गलानि च गीतानि नाद्य गान्ति पठन्ति च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2159532, "chapter_id": 4464, "verse_number": "२०", "content_sanskrit": "स्तुतिमङ्गलसंयुक्ता ममानीकेषु वन्दिनः ।\nयोधाश्चापि च मां दृष्ट्वा निवर्तन्ते ह्यधोमुखाः\nकर्माणि च यथापूर्वं कृत्वा नाभिवदन्ति माम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2159533, "chapter_id": 4464, "verse_number": "२१", "content_sanskrit": "अपि स्वस्ति भवेदद्य भ्रातृभ्यो मम माधव \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2159534, "chapter_id": 4464, "verse_number": "२२", "content_sanskrit": "न हि शुद्ध्यति मे भावो दृष्ट्वा स्वजनमाकुलम् ।\nअपि पाञ्चालराजस्य विराटस्य च मानद\nसर्वेषां चैव योधानां सामग्र्यं स्यान्ममाच्युत\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2159535, "chapter_id": 4464, "verse_number": "२३", "content_sanskrit": "न च माऽभ्येति सौभद्रः प्रहृष्टैर्भ्रातृभिः सह ।\nरणादायान्तमुचितं प्रत्युद्याति हसन्निव\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2159536, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2159537, "chapter_id": 4464, "verse_number": "२४", "content_sanskrit": "एवं सङ्कथयन्तौ तौ प्रविष्टौ शिबिरं स्वकम् ।\nददृशाते भृशास्वस्थान् पाण्डवान् नष्टचेतसः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2159538, "chapter_id": 4464, "verse_number": "२५", "content_sanskrit": "दृष्ट्वा भ्रातॄंश्च पुत्रांश्च विमना वानरध्वजः ।\nअपश्यंस्तत्र सौभद्रमिदं वचनमब्रवीत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2159539, "chapter_id": 4464, "verse_number": "२६", "content_sanskrit": "मुखवर्णोऽप्रसन्नो वः सर्वेषामेव दृश्यते ।\nन चाभिमन्युं पश्यामि नच मामभिनन्दथ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2159540, "chapter_id": 4464, "verse_number": "२७", "content_sanskrit": "श्रुतो यथा मे द्रोणेन पद्मव्यूहो विनिर्मितः ।\nन च वस्तस्य भेत्ताऽस्ति अभिमन्युमृते शिशुम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2159541, "chapter_id": 4464, "verse_number": "२८", "content_sanskrit": "नोपदिष्टश्च मे तस्य भित्त्वाऽनीकस्य निर्गमः ।\nकच्चिन्न बालो युष्माभिः परानीकं प्रवेशितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2159542, "chapter_id": 4464, "verse_number": "२९", "content_sanskrit": "भित्त्वाऽनीकं नरव्याघ्रः परेषां बहुभिर्युधि ।\nकच्चिन्न निहतः शेते सौभद्रः परवीरहा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2159543, "chapter_id": 4464, "verse_number": "३०", "content_sanskrit": "लोहिताक्षं महाबाहुं जातं सिंहमिवाद्रिषु ।\nउपेन्द्रसदृशं ब्रूत कथमायोधने हतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2159544, "chapter_id": 4464, "verse_number": "३१", "content_sanskrit": "सुकुमारं महोत्साहं वासवस्यात्मजात्मजम् ।\nसदा मम प्रियं ब्रूत कथमायोधने हतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2159545, "chapter_id": 4464, "verse_number": "३२", "content_sanskrit": "वार्ष्णेयदयितं शूरं मया सततलालितम् ।\nअम्बायाश्च प्रियं नित्यं कोऽवधीत् कालचोदितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2159546, "chapter_id": 4464, "verse_number": "३३", "content_sanskrit": "सदृशो वृष्णिसिंहस्य केशवस्य महात्मनः ।\nविक्रमश्रुतमाहात्म्यैः कथमायोधने हतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2159547, "chapter_id": 4464, "verse_number": "३४", "content_sanskrit": "सुभद्रायाः प्रियं नित्यं द्रौपद्याः केशवस्य च ।\nयदि पुत्रं न पश्यामि यास्यामि यमसादनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2159548, "chapter_id": 4464, "verse_number": "३५", "content_sanskrit": "महोत्साहं महावीर्यं दीर्घराजीवलोचनम् ।\nयदि पुत्रं न पश्यामि यास्यामि यमसादनम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2159549, "chapter_id": 4464, "verse_number": "३६", "content_sanskrit": "मृदुकुञ्चितकेशान्तं बालं बालमृगेक्षणम् ।\nमत्तद्विरदविक्रान्तं सालपोतमिवोद्गतम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2159550, "chapter_id": 4464, "verse_number": "३७", "content_sanskrit": "स्मिताभिभाषिणं दान्तं गुरुप्रेष्यकरं सदा ।\nबालं चाबालकर्माणं प्रियोद्यं वीतमत्सरम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2159551, "chapter_id": 4464, "verse_number": "३८", "content_sanskrit": "भक्तानुकम्पिनं दान्तं न च दीनानुसारिणम् ।\nकृतज्ञं ज्ञानसम्पन्नं कृतास्त्रमनिवर्तिनम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2159552, "chapter_id": 4464, "verse_number": "३९", "content_sanskrit": "युद्धाभिनन्दिनं नित्यं द्विषतामघवर्धनम् ।\nस्वेषां प्रियहिते युक्तं पितॄणां जयगृद्धिनम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2159553, "chapter_id": 4464, "verse_number": "४०", "content_sanskrit": "न च पूर्वप्रहर्तारं सङ्ग्रामे नष्टसम्भ्रमम् ।\nयदि पुत्रं न पश्यामि यास्यामि यमसादनम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2159554, "chapter_id": 4464, "verse_number": "४१", "content_sanskrit": "सुनसं सुललाटं तं सुभ्व्रक्षिदशनच्छदम् ।\nअपश्यतस्तद्वदनं का शान्तिर्हृदयस्य मे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2159555, "chapter_id": 4464, "verse_number": "४२", "content_sanskrit": "तन्त्रीस्वनसुखं रम्यं पुंस्कोकिलसमध्वनिम् ।\nअशृण्वतः स्वनं तस्य का शान्तिर्हृदयस्य मे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2159556, "chapter_id": 4464, "verse_number": "४३", "content_sanskrit": "रूपं चाप्रतिरूपं तत् त्रिदशैरपि दुर्लभम् ।\nअपश्यतो हि वीरस्य का शान्तिर्हृदयस्य मे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2159557, "chapter_id": 4464, "verse_number": "४४", "content_sanskrit": "अभिवादनदक्षं तं पितॄणां वचने रतम् ।\nनह्यहं यदि पश्यामि का शान्तिर्हृदयस्य मे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2159558, "chapter_id": 4464, "verse_number": "४५", "content_sanskrit": "सुकुमारः सदा वीरो महार्हशयनोचितः ।\nभूमावनाथवच्छेते नूनं नाथवतां वरः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2159559, "chapter_id": 4464, "verse_number": "४६", "content_sanskrit": "शयानं समुपासन्ते यं पुरा परमस्त्रियः ।\nतमद्य विप्रविद्धाङ्गम् उपासन्तेऽशिवाः शिवाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2159560, "chapter_id": 4464, "verse_number": "४७", "content_sanskrit": "यः पुरा बोद्ध्यते सुप्तः सूतमागधवन्दिभिः ।\nतमद्य बोधयिष्यन्ति श्वापदा विकृतैः खरैः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2159561, "chapter_id": 4464, "verse_number": "४८", "content_sanskrit": "छत्रच्छायासमुचितं तस्य तद् वदनं शुभम् ।\nनूनमद्य रजोध्वस्तं रणे रेणुः करिष्यति\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2159562, "chapter_id": 4464, "verse_number": "४९", "content_sanskrit": "हा पुत्रकावितृप्तस्य सततं पुत्रदर्शने ।\nमन्दपुण्यस्य कालेन यथा मे नीयसे बलात्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2159563, "chapter_id": 4464, "verse_number": "५०", "content_sanskrit": "साऽद्य संयमनी नूनं सतां सुकृतिनां गतिः ।\nस्वभाभिर्मण्डिता रम्या त्वयाऽत्यर्थं विराजिता\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2159564, "chapter_id": 4464, "verse_number": "५१", "content_sanskrit": "नूनं वैवस्वतश्च त्वां वरुणश्च प्रियातिथिम् ।\nशतक्रतुर्धनेशश्च प्राप्तमर्चन्त्यभीरुकम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2159565, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2159566, "chapter_id": 4464, "verse_number": "५२", "content_sanskrit": "एवं विलप्य बहुलं भिन्नपोतो वणिग् यथा ।\nदुःखेन महताऽऽविष्टो युधिष्ठिरमपृच्छत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2159567, "chapter_id": 4464, "verse_number": "५३", "content_sanskrit": "कथं त्वयि च भीमे च धृष्टद्युम्ने च जीवति ।\nसात्यके शक्रविक्रान्ते सौभद्रो निहतः परैः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2159568, "chapter_id": 4464, "verse_number": "५४", "content_sanskrit": "कञ्चित् स कदनं कृत्वा परेषां पाण्डुनन्दनः ।\nस्वर्गतोऽभिमुखः सङ्खे युद्ध्यमानो महारथैः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2159569, "chapter_id": 4464, "verse_number": "५५", "content_sanskrit": "स नूनं बहुभिर्युक्तैर्युद्ध्यमानो नरर्षभैः ।\nअसहायः सहायार्थं मामनुध्यातवान् ध्रुवम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2159570, "chapter_id": 4464, "verse_number": "५६", "content_sanskrit": "पीड्यमानः शरैर्बालः तात साध्वभिधाव माम् ।\nइति विप्रलपन् मन्ये नृशंसैर्बहुभिर्हतः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2159571, "chapter_id": 4464, "verse_number": "५७", "content_sanskrit": "अथवा मत्प्रसूतश्च स्वस्रीयो माधवस्य च ।\nसुभद्रायां च सम्भूतः स नैवं वक्तुमर्हति\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2159572, "chapter_id": 4464, "verse_number": "५८", "content_sanskrit": "वज्रायसाश्मभिस्तुल्यं हृदयं सुदृढं मम ।\nअपश्यतो दीर्घबाहुं रक्ताक्षं यन्न दीर्यते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2159573, "chapter_id": 4464, "verse_number": "५९", "content_sanskrit": "कथं बाले महेष्वासे नृशंसा मर्मभेदिनः ।\nस्वस्रीये वासुदेवस्य मम पुत्रेऽक्षिपन् शरान्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2159574, "chapter_id": 4464, "verse_number": "६०", "content_sanskrit": "यो मां नित्यमदीनात्मा प्रत्युद्गम्याभिनन्दति ।\nउपयान्तं रिपून् हत्वा सोऽद्य मां किं न पश्यति\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2159575, "chapter_id": 4464, "verse_number": "६१", "content_sanskrit": "नूनं स पातितः शेते धरण्यां रुधिरोक्षितः ।\nशोभयन् मेदिनीं गात्रैः आदित्य इव पातितः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2159576, "chapter_id": 4464, "verse_number": "६२", "content_sanskrit": "सुभद्रामभिशोचामि या पुत्रमपलायिनम् ।\nरणे विनिहतं श्रुत्वा शोकार्ता चातिनंक्ष्यति\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2159577, "chapter_id": 4464, "verse_number": "६३", "content_sanskrit": "श्रुत्वा निपतितं शूरम् अनघं कृतलाघवम् ।\nसुभद्रा वक्ष्यते किं मामभिमन्युमपश्यती\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2159578, "chapter_id": 4464, "verse_number": "६४", "content_sanskrit": "द्रौपदीं चापि दुःखार्तां किं वा वक्ष्यामि तामहम्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2159579, "chapter_id": 4464, "verse_number": "६५", "content_sanskrit": "हृष्टानां धार्तराष्ट्राणां सिंहनादो मया श्रुतः ।\nयुयुत्सुश्चापि कृष्णेन श्रुतो वीरानुपालभन्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2159580, "chapter_id": 4464, "verse_number": "६६", "content_sanskrit": "अशक्नुवन्तः पार्थस्य बालं हत्वा महारथाः ।\nकिन्न लज्जन्त्यधर्मज्ञाः पार्थिवा दृश्यतां बलम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2159581, "chapter_id": 4464, "verse_number": "६७", "content_sanskrit": "किं तयोर्विप्रियं कृत्वा केशवार्जुनयोर्मृधे ।\nसिंहवन्नदत प्रीताः शोककाल उपस्थिते\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2159582, "chapter_id": 4464, "verse_number": "६८", "content_sanskrit": "आगमिष्यति वः क्षिप्रं फलं पापस्य कर्मणः ।\nअधर्मो हि कृतस्तीव्रः कथं स्यादफलश्चिरम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2159583, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2159584, "chapter_id": 4464, "verse_number": "समाप्तिः", "content_sanskrit": "इति तान् परिभाषन् वै कुन्त्याः पुत्रो महाद्युतिः ।\nअपायाच्छस्त्रमुत्सृज्य कोपाद् दुःखसमन्वितः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2159585, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2159586, "chapter_id": 4464, "verse_number": "७०", "content_sanskrit": "किमर्थमेतन्नाख्यातं त्वया पार्थ रणे मम ।\nअधक्ष्यं तानहं सर्वांस्तत्र क्रूरान् महारथान्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2159587, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2159588, "chapter_id": 4464, "verse_number": "७१", "content_sanskrit": "पुत्रशोकार्दितं पार्थं ध्यायन्तं साश्रुलोचनम् ।\nनिगृह्य वासुदेवस्तं पुत्राधिभिरभिप्लुतम् ।\nमैवमित्यब्रवीत् कृष्णः तीव्रशोकसमन्वितम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2159589, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2159590, "chapter_id": 4464, "verse_number": "७२", "content_sanskrit": "सर्वेषामेव पन्था वै शूराणां कुरुनन्दन ।\nक्षत्रियाणां विशेषेण येषां नः शस्त्रजीविका\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2159591, "chapter_id": 4464, "verse_number": "७३", "content_sanskrit": "एषा वै युद्ध्यमानानां शूराणां कुरुनन्दन ।\nविहिता धर्मशास्त्रज्ञैर् गतिर्मतिमतां वर\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2159592, "chapter_id": 4464, "verse_number": "७४", "content_sanskrit": "ध्रुवं युद्धे हि मरणं शूराणामनिवर्तिनाम् ।\nगतः पुण्यकृताँल्लोकान् अभिमन्युर्न संशयः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2159593, "chapter_id": 4464, "verse_number": "७५", "content_sanskrit": "एतद् वै सर्ववीराणां काङ्क्षितं भरतर्षभ ।\nसङ्ग्रामेऽभिमुखा मृत्युं प्राप्नुयामेति मानद\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2159594, "chapter_id": 4464, "verse_number": "७६", "content_sanskrit": "स तु वीरान् रणे हत्वा राजपुत्रान् महाबलान् ।\nवीराणां काङ्क्षितं मृत्युं सम्प्राप्तोऽभिमुखो रणे\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2159595, "chapter_id": 4464, "verse_number": "७७", "content_sanskrit": "मा शुचो पुरुषव्याघ्र पूर्वैरेष सनातनः ।\nधर्मकृद्भिः कृतो धर्मः क्षत्रियाणां रणे क्षयः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2159596, "chapter_id": 4464, "verse_number": "७८", "content_sanskrit": "इमे ते भ्रातरः सर्वे दीना वै भ्रातृवत्सलाः ।\nत्वयि शोकसमाविष्टे नृपाश्च सुहृदस्तव\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2159597, "chapter_id": 4464, "verse_number": "७९", "content_sanskrit": "एतान् वै वचसा साम्ना समाश्वासय मानद ।\nविदितं वेदितव्यं ते न शोकं कर्तुमर्हसि\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2159598, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2159599, "chapter_id": 4464, "verse_number": "८०", "content_sanskrit": "एवमाश्वासितः पार्थः कृष्णेनाद्भुतकर्मणा ।\nततोऽब्रवीत् तदा भ्रातॄन् सर्वान् पार्थः सगद्गदम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2159600, "chapter_id": 4464, "verse_number": "८१", "content_sanskrit": "स दीर्घबाहुः पृथ्वंसो दीर्घराजीवलोचनः ।\nअभिमन्युर्यथावृत्तः श्रोतुमिच्छाम्यहं तथा\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2159601, "chapter_id": 4464, "verse_number": "८२", "content_sanskrit": "सनागस्यन्दनहयान् सङ्ग्रामे निहतान् मया ।\nक्षिप्रं द्रक्ष्यन्ति ते नूनं मम पुत्रस्य वैरिणः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2159602, "chapter_id": 4464, "verse_number": "८३", "content_sanskrit": "कथं च वः कृतास्त्राणां सर्वेषां शस्त्रपाणिनाम् ।\nसौभद्रो निधनं गच्छेद् वज्रिणाऽपि समागतः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2159603, "chapter_id": 4464, "verse_number": "८४", "content_sanskrit": "यद्येवमहमज्ञास्यम् अशक्तान् मम रक्षणे ।\nपुत्रस्य पाण्डुपाञ्चाला मयागुप्तो भवेत्तु सः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2159604, "chapter_id": 4464, "verse_number": "८५", "content_sanskrit": "कथं च वो रथस्थानां शरवर्षाणि मुञ्चताम् ।\nसौभद्रो निधनं नीतः कदर्थीकृत्य वः परैः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2159605, "chapter_id": 4464, "verse_number": "८६", "content_sanskrit": "अहो वः पौरुषं नास्ति न च वोऽस्ति पराक्रमः ।\nयत्राभिमन्युः समरे पश्यतां वो निपातितः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2159606, "chapter_id": 4464, "verse_number": "८७", "content_sanskrit": "आत्मानमेव गर्हेयं यदहं वै सुदुर्बलान् ।\nयुष्मानाज्ञाय निर्यातो भीरूनकृतनिश्रमान्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2159607, "chapter_id": 4464, "verse_number": "८८", "content_sanskrit": "आहोस्विद् भूषणार्थानि वर्मचास्त्रायुधानि वः ।\nवाचश्च वदतां सत्सु मम पुत्रमरक्षताम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2159608, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2159609, "chapter_id": 4464, "verse_number": "८९", "content_sanskrit": "एवमुक्त्वा ततो वाक्यमतिष्ठद् वै वरासिमान् ।\nन स्माशक्यत बीभत्सुं केनचित् प्रसमीक्षितुम्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2159610, "chapter_id": 4464, "verse_number": "९०", "content_sanskrit": "तमन्तकमिव क्रुद्धं निःश्वसन्तं पुनःपुनः ।\nमहेन्द्रमिव तिष्ठन्तं वज्रोद्यतमहाभुजम्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2159611, "chapter_id": 4464, "verse_number": "९१", "content_sanskrit": "पुत्रशोकाभिसन्तप्तमश्रुपूर्णमुखं तदा ।\nन भाषितुं शक्नुवन्ति द्रष्टुं वाऽपि तदाऽर्जुनम्\nअन्यत्र वासुदेवाद्धि ज्येष्ठाद् वै पाण्डुनन्दनात्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2159612, "chapter_id": 4464, "verse_number": "९२", "content_sanskrit": "सर्वावस्थास्वपि हितावर्जुनस्य मनोनुगौ ।\nबहुमानात् प्रियत्वाच्च तावेनं वक्तुमर्हतः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2159613, "chapter_id": 4464, "verse_number": "९३", "content_sanskrit": "ततस्तं पुत्रशोकेन भृशं पीडितमानसम् ।\nराजीवलोचनं क्रुद्धं राजा वचनमब्रवीत्\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2159614, "chapter_id": 4464, "verse_number": "९४", "content_sanskrit": "त्वयि याते महाबाहो संशप्तकवधं प्रति ।\nयतते राजभिः सार्धमाचार्यो ग्रहणे मम\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2159615, "chapter_id": 4464, "verse_number": "९५", "content_sanskrit": "व्यूढानीकं ततो द्रोणं यतमानं महामृधे ।\nप्रतिव्यूह्य सहानीकाः प्रत्यरुंद्ध्म वयं बलम्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2159616, "chapter_id": 4464, "verse_number": "९६", "content_sanskrit": "स वार्यमाणः सङ्ग्रामे मयि चापि सुरक्षिते ।\nअस्मानप्यहनत् क्रुद्धः पीडयन्निशितैः शरैः\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2159617, "chapter_id": 4464, "verse_number": "९७", "content_sanskrit": "ते पीड्यमाना द्रोणेन द्रोणानीकं न शक्नुमः ।\nप्रतिवीक्षितुमप्याजौ भेत्तुं हि कुत एव नः\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2159618, "chapter_id": 4464, "verse_number": "९८", "content_sanskrit": "वयं त्वप्रतिमं वीर्ये सर्वे सौभद्रमात्मजम् ।\nद्रोणानीकमिदं भिन्धि द्वारं सञ्जनयस्व नः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2159619, "chapter_id": 4464, "verse_number": "९९", "content_sanskrit": "स तथा चोदितोऽस्माभिः सदश्व इव वीर्यवान् ।\nअसह्यमपि तं भारं वोढुमेवोपचक्रमे\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2159620, "chapter_id": 4464, "verse_number": "१००", "content_sanskrit": "तव चैवोपदेशेन वीर्येण च समन्वितः ।\nप्राविशत् तद् बलं बालः सुपर्ण इव सागरम्\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2159621, "chapter_id": 4464, "verse_number": "१०१", "content_sanskrit": "तेऽन्वयाम वयं वीरं सात्वतीपुत्रमाहवे ।\nप्रवेष्टुकामास्तेनैव येन स प्राविशच्चमूम्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2159622, "chapter_id": 4464, "verse_number": "१०२", "content_sanskrit": "ततः सैन्धवको राजा क्षुद्रस्तात जयद्रथः ।\nवरदानेन रुद्रस्य सर्वान् नः प्रत्यवारयत्\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2159623, "chapter_id": 4464, "verse_number": "१०३", "content_sanskrit": "ततो द्रोणः कृपः कर्णो द्रौणिश्च सबृहद्बलः ।\nकृतवर्मा च तं वीरं षड्रथाः पर्यवारयन्\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2159624, "chapter_id": 4464, "verse_number": "१०४", "content_sanskrit": "परिवार्य च तैः क्षुद्रैः युधि बालो महारथैः ।\nयतमानः परं शक्त्या बहुभिर्विरथीकृतः\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2159625, "chapter_id": 4464, "verse_number": "१०५", "content_sanskrit": "ततो दौःशासनिः पापः तथा तैर्विरथीकृतम् ।\nसंशयं परमं प्राप्तं दिष्टान्तेनाभ्ययोजयत्\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2159626, "chapter_id": 4464, "verse_number": "१०६", "content_sanskrit": "गदाहस्तोऽभ्ययात् तूर्णं जिघांसुरपराजितम्\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2159627, "chapter_id": 4464, "verse_number": "१०७", "content_sanskrit": "गदिनं त्वथ तं दृष्ट्वा वासवस्यात्मजात्मजः ।\nस जग्राह गदां वीरो गदायुद्धविशारदः\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2159628, "chapter_id": 4464, "verse_number": "१०८", "content_sanskrit": "गदामण्डलमार्गस्थौ सर्वक्षत्रस्य पश्यतः ।\nतौ सम्प्रजह्रतुर्वीरावन्योन्यस्यान्तरैषिणौ\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2159629, "chapter_id": 4464, "verse_number": "१०९", "content_sanskrit": "तावन्योन्यं गदाग्राभ्यां ताडितौ युद्धदुर्मदौ ।\nइन्द्रध्वजाविवोत्सृष्टौ गतसत्त्वौ महीं गतौ\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2159630, "chapter_id": 4464, "verse_number": "११०", "content_sanskrit": "स तु हत्वा सहस्राणि द्विपाश्वरथपत्तिनाम् ।\nराजपुत्रशतं चाग्र्यं वीरांश्चालक्षितान् बहून्\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2159631, "chapter_id": 4464, "verse_number": "१११", "content_sanskrit": "अष्टौ रथसहस्राणि नवदन्तिशतानि च ।\nबृहद्बलं च राजानं स्वर्गेण समयोजयत्\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2159632, "chapter_id": 4464, "verse_number": "११२", "content_sanskrit": "गतः सुकृतिनां लोकान् ये च स्वर्गजितां शुभाः ।\nअदीनस्त्रासयन् शत्रून् नन्दयित्वा च बान्धवान्॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2159633, "chapter_id": 4464, "verse_number": "११३", "content_sanskrit": "असकृन्नाम विश्राव्य पितॄणां मातुलस्य च ।\nवीरो दिष्टान्तमापन्नः शोचयन् बान्धवान् बहून्\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2159634, "chapter_id": 4464, "verse_number": "११४", "content_sanskrit": "ततः स्म शोकसन्तप्ता भवताऽद्य समेयुषः \t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2159635, "chapter_id": 4464, "verse_number": "११५", "content_sanskrit": "एतावदेव निर्वृत्तमस्माकं शोकवर्धनम् ।\nस चैवं पुरुषव्याघ्रः स्वर्गलोकमवाप्तवान्\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2159636, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2159637, "chapter_id": 4464, "verse_number": "११६", "content_sanskrit": "ततोऽर्जुनो वचः श्रुत्वा धर्मराजेन भाषितम् ।\nहा पुत्र इति निश्वस्य व्यथितो न्यपतद् भुवि\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2159638, "chapter_id": 4464, "verse_number": "११७", "content_sanskrit": "विषण्णवदनाः सर्वे परिगृह्य धनञ्जयम् ।\nनेत्रैरनिमिषैर्दीनाः प्रत्यवेक्षन् परस्परम्\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2159639, "chapter_id": 4464, "verse_number": "११८", "content_sanskrit": "प्रतिलभ्य ततः सञ्ज्ञां वासविः क्रोधमूर्च्छितः ।\nकम्पमानो ज्वरेणेव निःश्वसंश्च पुनःपुनः\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2159640, "chapter_id": 4464, "verse_number": "११९", "content_sanskrit": "पाणिं पाणौ विनिष्पिष्य दन्तान् कटकटाप्य च ।\nत्रिशिखां भ्रुकुटीं कृत्वा क्रोधसंरक्तलोचनः\nउन्मत्त इव रोषेण स्मयन् वचनमब्रवीत्\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2159641, "chapter_id": 4464, "verse_number": "१२०", "content_sanskrit": "सत्यं वः प्रतिजानामि श्वो हन्तास्मि जयद्रथम् ।\nन चेद् वधभयात् त्रस्तो धार्तराष्ट्रान् प्रहास्यति\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2159642, "chapter_id": 4464, "verse_number": "१२१", "content_sanskrit": "न च मां शरणं गच्छेत् कृष्णं वा पुरुषोत्तमम् ।\nभवन्तं वा महाराज श्वो हन्तास्मि जयद्रथम्\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2159643, "chapter_id": 4464, "verse_number": "१२२", "content_sanskrit": "मयि विस्मृतसौहार्दं दुर्योधनहिते रतम् ।\nपापं बालवधे हेतुं श्वो हन्तास्मि जयद्रथम्\t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2159644, "chapter_id": 4464, "verse_number": "१२३", "content_sanskrit": "रक्षमाणाश्च तं सङ्खे ये मां योत्स्यन्ति केचन ।\nराजन् द्रोणमुखांस्तांस्तान् वारयिष्याम्यहं शरैः\t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2159645, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "एवं यदि न सङ्ग्रामे कुर्यां श्वः पुरुषोत्तम ।\nमा स्म पुण्यकृतां लोकान् प्राप्नुयांच्छूरसम्मतान् ।१२४।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2159646, "chapter_id": 4464, "verse_number": "१२५", "content_sanskrit": "ये लोका मातृघातिनां ये लोकाः पितृघातिनाम् ।\nये गुरोर्दारगामीनां पिशुनानां च या गतिः\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2159647, "chapter_id": 4464, "verse_number": "१२६", "content_sanskrit": "पायसं पयसाऽन्नं वा शाकं कृसरमेव वा ।\nसंयावापूपमांसानि ये च लोका वृथाऽश्नताम्\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2159648, "chapter_id": 4464, "verse_number": "१२७", "content_sanskrit": "साधून् निन्दयतां चापि ये चापि परिवादिनाम् ।\nये च निक्षेपहारीणां ये च विश्वासघातिनाम्\t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2159649, "chapter_id": 4464, "verse_number": "१२८", "content_sanskrit": "भुक्तपूर्वां स्त्रियं चापि निन्दतामघशंसिनाम् ।\nब्राह्मणान् निघ्नतां ये च ये च गोघातिनामपि॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2159650, "chapter_id": 4464, "verse_number": "१२९", "content_sanskrit": "अदत्वा देवताभ्यश्च अतिथिभ्यस्तथैव च ।\nतानिहैवोपगच्छेयं न चेद् हन्यां जयद्रथम्\t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2159651, "chapter_id": 4464, "verse_number": "१३०", "content_sanskrit": "वेदाध्ययनमत्यर्थं शासितं द्विजसत्तमः ।\nकालद्रव्यमितिं कृत्वा योऽध्यापयति मूढधीः\t॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2159652, "chapter_id": 4464, "verse_number": "१३१", "content_sanskrit": "भृतकः स तु विज्ञेयः सर्वकर्मबहिष्कृतः ।\nतस्य या गतिरुद्दिष्टा तत्पङ्क्त्या भुञ्जतस्तदा\t॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2159653, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "अवमन्यमानो यान् याति वृद्धान् साधून् गुरूंस्तथा ।\nसंस्पृशन् ब्राह्मणं गां च पदाऽग्निं चापि यो व्रजेत्\t॥१३२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2159654, "chapter_id": 4464, "verse_number": "१३३", "content_sanskrit": "योऽप्सु मूत्रं पुरीषं वा श्लेष्माणं वाऽपि मुञ्चति ।\nगच्छेयं तां गतिं कृच्छ्रां न चेद्धन्मि जयद्रथम्\t॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2159655, "chapter_id": 4464, "verse_number": "१३४", "content_sanskrit": "नग्नस्य स्नायमानस्य या च वन्ध्यातिथेर्गतिः ।\nउत्क्रोशकानृतानां च वञ्चकानां च या गतिः\t॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2159656, "chapter_id": 4464, "verse_number": "१३५", "content_sanskrit": "सूचकात्मापहारीणां या च मिथ्याभिशंसिनाम् ।\nभृत्यैः सन्दृश्यमानानां पुत्रदाराश्रितैस्तथा\t॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2159657, "chapter_id": 4464, "verse_number": "१३६", "content_sanskrit": "असंविभज्य क्षुद्राणां या गतिर्मृष्टमश्नताम् ।\nतां गच्छेयं गतिं घोरां न चेद्धन्मि जयद्रथम्\t॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2159658, "chapter_id": 4464, "verse_number": "१३७", "content_sanskrit": "संश्रितं चापि यस्त्यक्त्वा साधुसद्वचने रतम् ।\nनैनं भरति दुष्टात्मा निन्दते चोपकारिणम्\t॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2159659, "chapter_id": 4464, "verse_number": "१३८", "content_sanskrit": "अर्हते प्रातिवेश्याय श्राद्धं यो न ददाति ह ।\nअनर्हते च यो दद्याद् वृषलीपतयेऽपि च\t॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2159660, "chapter_id": 4464, "verse_number": "१३९", "content_sanskrit": "मद्यपो भिन्नमर्यादः कृतघ्नो भर्तृनिन्दकः ।\nतेषां गतिमियां क्षिप्रं न चेद्धन्मि जयद्रथम्\t॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2159661, "chapter_id": 4464, "verse_number": "१४०", "content_sanskrit": "धर्मादपेता ये चान्ये ये चात्रापरिकीर्तिताः ।\nये मया कीर्तिताश्चात्र तेषां गतिमवाप्नुयाम्\t॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2159662, "chapter_id": 4464, "verse_number": "१४१", "content_sanskrit": "यदि व्युष्टामिमां रात्रिं श्वो न हन्यां जयद्रथम् ।\nइमां चाप्यपरां भूयः प्रतिज्ञां मे निबोधत\t॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2159663, "chapter_id": 4464, "verse_number": "१४२", "content_sanskrit": "इहैवंच प्रवेक्ष्यामि ज्वलितं जातवेदसम् ।\nगाण्डीवहस्तो राज्ञां च समक्षं पृथिवीपते\t॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2159664, "chapter_id": 4464, "verse_number": "१४३", "content_sanskrit": "अनस्तमित आदित्ये न चेद् हन्मि जयद्रथम् ।\nयद्यस्मिन्नहते पापे सूर्यास्तमुख यास्यति\t॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2159665, "chapter_id": 4464, "verse_number": "१४४", "content_sanskrit": "असुरसुरमनुष्याः पक्षिणो वोरगा वा\nपितृरजनिचरा वा ब्रह्मदेवर्षयो वा ।\nचरमचरमपीदं यत् परं चापि तस्मात्\nतदपि मम रिपुं तं रक्षितुं नेह शक्ताः\t॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 2159666, "chapter_id": 4464, "verse_number": "१४५", "content_sanskrit": "यदि विशति रसातळं तदग्र्यं\nवियदपि देवपुरं दितेः पुरं वा ।\nनिशितशरवरैरहं प्रसँह्य\nशृणुत हि सिन्धुपतेः शिरो हरिष्ये\t॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 2159667, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 2159668, "chapter_id": 4464, "verse_number": "१४६", "content_sanskrit": "एवमुक्त्वा विचिक्षेप गाण्डीवं सव्यदक्षिणम् ।\nतस्य सर्वमतिक्रम्य धनुःशब्दोऽस्पृशद् दिवम्\t॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 2159669, "chapter_id": 4464, "verse_number": "१४७", "content_sanskrit": "अर्जुनेन प्रतिज्ञाते पाञ्चजन्यं जनार्दनः ।\nप्रदध्मौ तत्र सङ्क्रुद्धो देवदत्तं धनञ्जयः\t॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 2159670, "chapter_id": 4464, "verse_number": "१४८", "content_sanskrit": "स पाञ्चजन्योऽच्युतवक्त्रवायुना\nभृशं सुपूर्णोदरनिःसृतध्वनिः ।\nजगत् सपाताळवियद्दिगीश्वरं\nप्रकम्पयामास युगात्यये यथा\t॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 2159671, "chapter_id": 4464, "verse_number": "१४९", "content_sanskrit": "ततो वादित्रनिर्घोषाः प्रादुरासन् सहस्रशः ।\nसिंहनादाश्च पाण्डूनां प्रतिज्ञाते महात्मना\t॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 2159672, "chapter_id": 4464, "verse_number": "१५०", "content_sanskrit": "अनृत्यदिव गाण्डीवं शरास्तूणीगता मुदा ।\nनिराक्रामन्निव तदा स्वयमेव मृधैषिणः\t॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}, {"id": 2159673, "chapter_id": 4464, "verse_number": "१५१", "content_sanskrit": "भीमसेनस्तु संहृष्टः प्रत्यभाषत भारत ।\nधनञ्जयमभिप्रेक्ष्य हर्षगद्गदया गिरा\t॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 165}, {"id": 2159674, "chapter_id": 4464, "verse_number": "१५२", "content_sanskrit": "प्रतिज्ञोद्भवशब्देन कृष्णशङ्खस्वनेन च ।\nनिहतो धार्तराष्ट्रोऽयं सानुबन्धः सुयोधनः\t॥१५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 166}, {"id": 2159675, "chapter_id": 4464, "verse_number": "१५३", "content_sanskrit": "अथ मृदिततमाग्र्यदाममाल्यं\nतव सुतशोकमयं च रोषजातम् ।\nव्यपनुदति महाप्रभावमेतन्-\nनरवर वाक्यमिदं महार्थमिष्टम्\t॥१५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 167}, {"id": 2159676, "chapter_id": 4464, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 168}, {"id": 2159677, "chapter_id": 4464, "verse_number": "१५४", "content_sanskrit": "अथ शङ्खैश्च भेरीभिः पणवैः सैनिकास्तथा ।\nससूतमागधा जिष्णुं स्तुतिभिः समपूजयन्\t॥१५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 169}, {"id": 2159678, "chapter_id": 4464, "verse_number": "१५५", "content_sanskrit": "तदा भीमं बलं सर्वं तेन नादेन मोहितम् ।\nतावकं तन्महाराज विषण्णं समपद्यत\t॥१५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 170}, {"id": 2159679, "chapter_id": 4464, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि एकोनसप्ततितमोऽध्यायः ॥ ६९ ॥\nप्रतिज्ञापर्वणि प्रथमोऽध्यायः ॥ १ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 171}]