[{"id": 2147877, "chapter_id": 4199, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147878, "chapter_id": 4199, "verse_number": "१", "content_sanskrit": "विदुरेणैवमुक्ते तु केशवः परवीरहा ।\nदुर्योधनं धार्तराष्ट्रमभ्यभाषत वीर्यवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147879, "chapter_id": 4199, "verse_number": "२", "content_sanskrit": "एकोऽहमिति यन्मोहान्मन्यसे मां सुयोधन ।\nपरिभूय सुदुर्बुद्धे ग्रहीतुं मां चिकीर्षसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147880, "chapter_id": 4199, "verse_number": "३", "content_sanskrit": "इहैव पाण्डवाः सर्वे तथैवान्धकवृष्णयः ।\nइहादित्याश्च रुद्राश्च वसवश्च महर्षिभिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147881, "chapter_id": 4199, "verse_number": "४", "content_sanskrit": "एवमुक्त्वा जहासोच्चैः केशवः परवीरहा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147882, "chapter_id": 4199, "verse_number": "५", "content_sanskrit": "तस्य संस्मयतः शौरेर्विद्युद्रूपा महात्मनः ।\nयुगपच्च विनिष्पेतुः साक्षात् सर्वाश्च देवताः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147883, "chapter_id": 4199, "verse_number": "६", "content_sanskrit": "अङ्गुष्ठमात्रास्त्रिदशा मुमुचुः पावकार्चिषः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147884, "chapter_id": 4199, "verse_number": "७", "content_sanskrit": "तस्य ब्रह्मा ललाटस्थो रुद्रो वक्षसि चाभवत् ।\nलोकपाला भुजेष्वासन्नग्निरास्यादजायत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147885, "chapter_id": 4199, "verse_number": "८", "content_sanskrit": "आदित्याश्चैव साध्याश्च वसवोऽथाश्विनावपि ।\nमरुतश्च सहेन्द्रेण विश्वे देवास्तथैव च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147886, "chapter_id": 4199, "verse_number": "९", "content_sanskrit": "बभूवुश्चैव यक्षाश्च गन्धर्वोरगराक्षसाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147887, "chapter_id": 4199, "verse_number": "१०", "content_sanskrit": "प्रादुरास्तां तदा दोर्भ्यां सङ्कर्षणधनञ्जयौ ।\nदक्षिणे चार्जुनो धन्वी हली रामश्च सव्यतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147888, "chapter_id": 4199, "verse_number": "११", "content_sanskrit": "भीमो युधिष्ठिरश्चैव माद्रीपुत्रौ च पृष्ठतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147889, "chapter_id": 4199, "verse_number": "१२", "content_sanskrit": "अन्धका वृष्णयश्चैव प्रद्युम्नप्रमुखास्ततः ।\nअर्चिष्यभूवन् कृष्णस्य समुद्यतमहायुधाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147890, "chapter_id": 4199, "verse_number": "१३", "content_sanskrit": "शङ्खचक्रगदाशक्तिशार्ङ्गलाङ्गलनन्दकाः ।\nअदृश्यन्तोद्यतान्येव सर्वप्रहरणानि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147891, "chapter_id": 4199, "verse_number": "१४", "content_sanskrit": "नाना बाहुषु कृष्णस्य दीप्यमानानि सर्वशः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147892, "chapter_id": 4199, "verse_number": "१५", "content_sanskrit": "नेत्राभ्यां नासिकाभ्यां च श्रोत्राभ्यां च समन्ततः ।\nप्रादुरासन् महारौद्राः सधूमाः पावकार्चिषः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147893, "chapter_id": 4199, "verse_number": "१६", "content_sanskrit": "रोमकूपेषु च तथा सूर्यस्येव मरीचयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147894, "chapter_id": 4199, "verse_number": "१७", "content_sanskrit": "ते दृष्ट्वा परमात्मानं केशवस्य महात्मनः ।\nन्यमीलयन्त नेत्राणि राजानस्त्रस्तचेतसः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147895, "chapter_id": 4199, "verse_number": "१८", "content_sanskrit": "ऋते द्रोणं च भीष्मं च विदुरं च महामतिम् ।\nसञ्जयं च महाभागं ऋषींश्चैव तपोधनान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147896, "chapter_id": 4199, "verse_number": "१९", "content_sanskrit": "प्रादात् तेषां स भगवान् दिव्यं चक्षुर्जनार्दनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147897, "chapter_id": 4199, "verse_number": "२०", "content_sanskrit": "तत्राश्चर्यमभूद् राजन् धृतराष्ट्रः स्वचक्षुषी ।\nलब्धवान् वासुदेवस्य विश्वरूपदिदृक्षया\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147898, "chapter_id": 4199, "verse_number": "२१", "content_sanskrit": "लब्धचक्षुषमासीनं धृतराष्ट्रं नराधिपाः ।\nविस्मिता ऋषिभिः सार्धं तुष्टुवुर्मधुसूदनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147899, "chapter_id": 4199, "verse_number": "२२", "content_sanskrit": "तद् दृष्ट्वा महदाश्चर्यं माधवस्य सभातळे ।\nदेवदुन्दुभयो नेदुः पुष्पवर्षं पपात च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147900, "chapter_id": 4199, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147901, "chapter_id": 4199, "verse_number": "२३", "content_sanskrit": "त्वमेव पुण्डरीकाक्ष सर्वस्य जगतः प्रभुः ।\nतस्मान्मे यादवश्रेष्ठ प्रसादं कर्तुमर्हसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147902, "chapter_id": 4199, "verse_number": "२४", "content_sanskrit": "देवदेव महायोगिन् वासुदेव जनार्दन ।\nभगवन् मम नेत्राभ्यामन्तर्धानं वृणे पुनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147903, "chapter_id": 4199, "verse_number": "२५", "content_sanskrit": "भवन्तं दृष्टवानस्मि नान्यं द्रष्टुमिहोत्सहे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147904, "chapter_id": 4199, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147905, "chapter_id": 4199, "verse_number": "२६", "content_sanskrit": "ततोब्रवीन्महाबाहुर्धृतराष्ट्रं जनार्दनः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147906, "chapter_id": 4199, "verse_number": "२७", "content_sanskrit": "अदृश्यमाने नेत्रे द्वे भवेतां कुरुनन्दन\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147907, "chapter_id": 4199, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147908, "chapter_id": 4199, "verse_number": "२८", "content_sanskrit": "चचाल च मही कृत्स्ना सागरश्चापि चुक्षुभे ।\nविस्मयं परमं जग्मुः पार्थिवा भरतर्षभ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2147909, "chapter_id": 4199, "verse_number": "२९", "content_sanskrit": "ततः स पुरुषव्याघ्रः सञ्जहार वपुः स्वकम् ।\nतां दिव्यामद्भुतां चित्राम् ऋद्धिमत्तामरिन्दमः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2147910, "chapter_id": 4199, "verse_number": "३०", "content_sanskrit": "ततः सात्यकिमादाय पाणौ विदुरमेव च ।\nऋषिभिस्तैरनुज्ञातो निर्ययौ मधुसूदनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2147911, "chapter_id": 4199, "verse_number": "३१", "content_sanskrit": "ऋषयोऽन्तर्हिता जग्मुः ततस्ते नारदादयः ।\nतस्मिन् कोलाहले वृत्ते तदद्भुतमिवाभवत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2147912, "chapter_id": 4199, "verse_number": "३२", "content_sanskrit": "तं प्रस्थितमभिप्रेक्ष्य कौरवाः सह राजभिः ।\nअनुजग्मुर्नरव्याघ्रं देवा इव शतक्रतुम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2147913, "chapter_id": 4199, "verse_number": "३३", "content_sanskrit": "अचिन्तयन्नमेयात्मा सर्वं तद्राजमण्डलम् ।\nनिश्चक्राम ततः शौरिः सधूम इव पावकः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2147914, "chapter_id": 4199, "verse_number": "३४", "content_sanskrit": "ततो रथेन शुभ्रेण महता किङ्किणीकिना ।\nहेमजालविचित्रेण लघुना मेघनादिना\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2147915, "chapter_id": 4199, "verse_number": "३५", "content_sanskrit": "सूपस्करेण शुभ्रेण वैयाघ्रेण वरूथिना ।\nसैन्यसुग्रीवयुक्तेन प्रत्यदृश्यत दारुकः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2147916, "chapter_id": 4199, "verse_number": "३६", "content_sanskrit": "तथैव रथमास्थाय कृतवर्मा महारथः ।\nवृष्णीनां सम्मतो वीरो हार्दिक्यः समदृश्यत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2147917, "chapter_id": 4199, "verse_number": "३७", "content_sanskrit": "उपस्थितरथं शौरिं प्रयास्यन्तमरिन्दमम् ।\nधृतराष्ट्रो महाराजः पुनरेवाभ्यभाषत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2147918, "chapter_id": 4199, "verse_number": "३८", "content_sanskrit": "यावद्बलं मे पुत्रेषु पश्यस्येतज्जनार्दन ।\nप्रत्यक्षं ते न ते किञ्चित् परोक्षं शत्रुसूदन\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2147919, "chapter_id": 4199, "verse_number": "३९", "content_sanskrit": "कुरूणां शममिच्छन्तं यतमानं च केशव ।\nविदित्वैतामवस्थां मे नाभिशङ्कितुमर्हसि\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2147920, "chapter_id": 4199, "verse_number": "४०", "content_sanskrit": "न मे पापोऽस्त्यभिप्रायः पाण्डवान् प्रति केशव ।\nज्ञातमेव हि ते वाक्यं यन्मयोक्तः सुयोधनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2147921, "chapter_id": 4199, "verse_number": "४१", "content_sanskrit": "जानन्ति कुरवः सर्वे राजानश्चैव पार्थिवाः ।\nशमे प्रयतमानं मां सर्वयत्नेन माधव\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2147922, "chapter_id": 4199, "verse_number": "४२", "content_sanskrit": "ततोऽब्रवीन्महाबाहुर्धृतराष्ट्रं जनेश्वरम् ।\nद्रोणं पितामहं भीष्मं क्षत्तारं बाह्लिकं कृपम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2147923, "chapter_id": 4199, "verse_number": "४३", "content_sanskrit": "प्रत्यक्षमेतद् भवतां यद् वृत्तं कुरुसंसदि ।\nयथा चाशिष्टवन्मन्दो रोषादसकृदुत्थितः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2147924, "chapter_id": 4199, "verse_number": "४४", "content_sanskrit": "वदत्यनीशमात्मानं धृतराष्ट्रो महीपतिः ।\nआपृच्छे भवतः सर्वान् गमिष्यामि युधिष्ठिरम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2147925, "chapter_id": 4199, "verse_number": "४५", "content_sanskrit": "आमन्त्र्य प्रस्थितं शौरिं रथस्थं पुरुषर्षभ ।\nअनुजग्मुर्महेष्वासाः प्रवीरा भरतर्षभाः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2147926, "chapter_id": 4199, "verse_number": "४६", "content_sanskrit": "भीष्मो द्रोणः कृपः क्षत्ता धृतराष्ट्रोऽथ बाह्लिकः ।\nअश्वत्थामा विकर्णश्च युयुत्सुश्च महारथः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2147927, "chapter_id": 4199, "verse_number": "४७", "content_sanskrit": "ततो रथेन शुभ्रेण महता किङ्किणीकिना ।\nकुरूणां पश्यतां द्रष्टुं स्वसारं स्वपितुर्ययौ\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2147928, "chapter_id": 4199, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रिंशोत्तरशततमोऽध्यायः ॥१३०॥\nभगवद्यानपर्वणि एकषष्टितमोऽध्यायः ॥६१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]