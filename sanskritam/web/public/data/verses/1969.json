[{"id": 2043332, "chapter_id": 1969, "verse_number": "६-१८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043333, "chapter_id": 1969, "verse_number": "६-१८-१", "content_sanskrit": "ततो मुहूर्तात्तुमुलः शब्दो हृदयकम्पनः।\nअश्रूयत महाराज योधानां प्रयुयुत्सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043334, "chapter_id": 1969, "verse_number": "६-१८-२", "content_sanskrit": "शङ्खदुन्दुभिघोषैश्च वारणानां च बृंहितैः ।\nनोमिघोषै रथानां च दीर्यतीव वसुन्धरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043335, "chapter_id": 1969, "verse_number": "६-१८-३", "content_sanskrit": "हयानां हेषमाणानां योधानां चैव गर्जताम्।\nक्षणेनैव नभो भूमिः शब्देनापूरितं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043336, "chapter_id": 1969, "verse_number": "६-१८-४", "content_sanskrit": "पुत्राणां तव दुर्धर्ष पाण्डवानां तथैव च ।\nसमकम्पन्त सैन्यानि परस्परसमागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043337, "chapter_id": 1969, "verse_number": "६-१८-५", "content_sanskrit": "तत्र नागा रथाश्चैव जाम्बूनदविभूषिताः ।\nभ्राजमाना व्यदृश्यन्त मेघा इव सविद्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043338, "chapter_id": 1969, "verse_number": "६-१८-६", "content_sanskrit": "ध्वजा बहुविधाकारास्तावकानां नराधिप ।\nकाञ्चनाङ्गदिनो रेजुर्ज्वलिता इव पावकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043339, "chapter_id": 1969, "verse_number": "६-१८-७", "content_sanskrit": "स्वेषां चैव परेषां च समदृश्यन्त भारत।\nमहेन्द्रकेतवः शुभ्रा महेन्द्रसदनेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043340, "chapter_id": 1969, "verse_number": "६-१८-८", "content_sanskrit": "काञ्चनैः कवचैर्वीरा ज्वलनार्कसमप्रभैः।\nसन्नद्धाः समदृश्यन्त ज्वलनार्कसमप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043341, "chapter_id": 1969, "verse_number": "६-१८-९", "content_sanskrit": "कुरुयोधवरा राजन्विचित्रायुधकार्मुकाः ।\nउद्यतैरायुथैश्चित्रैस्तलबद्धाः पताकिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043342, "chapter_id": 1969, "verse_number": "६-१८-१०", "content_sanskrit": "ऋषभाक्षा महेष्वासाश्चमूमुखगता बभुः ।\nपृष्ठगोपास्तु भीष्मस्य पुत्रास्तव नराधिप ।\nदुःशासनो दुर्विषहो दुर्मुखो दुःसहस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043343, "chapter_id": 1969, "verse_number": "६-१८-११", "content_sanskrit": "विविंशतिश्चित्रसेनो विकर्णश्च महारथः ।\nसत्यव्रतः पुरुमित्रो जयो भूरिश्रवाः शलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043344, "chapter_id": 1969, "verse_number": "६-१८-१२", "content_sanskrit": "रथा विंशतिसाहस्रास्तथैषामनुयायिनः।\nअभीषाहाः शूरसेनाः शिबयोऽथ वसातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043345, "chapter_id": 1969, "verse_number": "६-१८-१३", "content_sanskrit": "शाल्वा मत्स्यास्तथाम्बष्ठास्त्रैगर्ताः केकयास्तथा।\nसौवीराः कैतवाः प्राच्याः प्रतीच्येदीच्यवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043346, "chapter_id": 1969, "verse_number": "६-१८-१४", "content_sanskrit": "द्वादशैते जनपदाः सर्वे शूरास्तनुत्यजः ।\nमहता रथवंशेन ते ररक्षुः पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043347, "chapter_id": 1969, "verse_number": "६-१८-१५", "content_sanskrit": "अनीकं दशसाहस्रं कुञ्जराणां तरस्विनाम् ।\nमागधो यत्र नृपतिस्तद्रथानीकमन्वयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043348, "chapter_id": 1969, "verse_number": "६-१८-१६", "content_sanskrit": "रथानां चक्ररक्षाश्च पादरक्षाश्च दन्तिनाम्।\nअभवन्वाहिनीमध्ये शतानामयुतानि षट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043349, "chapter_id": 1969, "verse_number": "६-१८-१७", "content_sanskrit": "पादाताश्चाग्रतो गच्छन्धनुश्चर्मासिपाणयः ।\nअनेकशतसाहस्रा नखरप्रासयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043350, "chapter_id": 1969, "verse_number": "६-१८-१८", "content_sanskrit": "अक्षौहिण्यो दशैका च तव पुत्रस्य भारत।\nअदृश्यत महाराज गङ्गेव यमुनान्तरा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043351, "chapter_id": 1969, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि अष्टादशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]