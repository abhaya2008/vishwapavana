[{"id": 40004296, "chapter_id": 8912, "verse_number": "1", "content_sanskrit": "स तं वृक्षं समासाद्य सन्ध्यामन्वास्यपश्चिमाम्। रामो रमयतां श्रेष्ठ इति होवाच लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40004297, "chapter_id": 8912, "verse_number": "2", "content_sanskrit": "अद्येयं प्रथमा रात्रिर्याता जनपदाद्बहिः। या सुमन्त्रेण रहिता तां नोत्कण्ठितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40004298, "chapter_id": 8912, "verse_number": "3", "content_sanskrit": "जागर्तव्यमतन्द्रिभ्यामद्यप्रभृति रात्रिषु। योगक्षेमौ हि सीताया वर्तेते लक्ष्मणावयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40004299, "chapter_id": 8912, "verse_number": "4", "content_sanskrit": "रात्रिं कथञ्चिदेवेमां सौमित्रे वर्तयामहे। अपावर्तामहे भूमावास्तीर्य स्वयमार्जितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40004300, "chapter_id": 8912, "verse_number": "5", "content_sanskrit": "स तु संविश्य मेदिन्यां महार्हशयनोचितः। इमाः सौमित्रये रामो व्याजहार कथाः शुभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40004301, "chapter_id": 8912, "verse_number": "6", "content_sanskrit": "ध्रुवमद्य महाराजो दुःखं स्वपिति लक्ष्मण। कृतकामा तु कैकेयी तुष्टा भवितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40004302, "chapter_id": 8912, "verse_number": "7", "content_sanskrit": "सा हि देवी महाराजं कैकेयी राज्यकारणात्। अपि न च्यावयेत्प्राणान् दृष्ट्वा भरतमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40004303, "chapter_id": 8912, "verse_number": "8", "content_sanskrit": "अनाथश्च हि वृद्धश्च मया चैव विनाकृतः। किं करिष्यति कामात्मा कैकेयी वशमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40004304, "chapter_id": 8912, "verse_number": "9", "content_sanskrit": "इदं व्यसनमालोक्य राज्ञश्च मतिविभ्रमम्। काम एवार्थधर्माभ्यां गरीयानिति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40004305, "chapter_id": 8912, "verse_number": "10", "content_sanskrit": "को ह्यविद्वानपि पुमान् प्रमदायाः कृते त्यजेत्। छन्दानुवर्तिनं पुत्रं तातो मामिव लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40004306, "chapter_id": 8912, "verse_number": "11", "content_sanskrit": "सुखी बत सभार्यश्च भरतः केकयीसुतः। मुदितान् कोसलानेको यो भोक्ष्यत्यधिराजवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40004307, "chapter_id": 8912, "verse_number": "12", "content_sanskrit": "स हि सर्वस्य राज्यस्य मुखमेकं भविष्यति। ताते च वयसाऽतीते मयि चारण्यमास्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40004308, "chapter_id": 8912, "verse_number": "13", "content_sanskrit": "अर्थधर्मौ परित्यज्य य काममनुवर्तते। एवमापद्यते क्षिप्रं राजा दशरथो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40004309, "chapter_id": 8912, "verse_number": "14", "content_sanskrit": "मन्ये दशरथान्ताय मम प्रव्राजनाय च। कैकेयी सौम्य सम्प्राप्ता राज्याय भरतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40004310, "chapter_id": 8912, "verse_number": "15", "content_sanskrit": "अपीदानीं तु कैकेयी सौभाग्यमदमोहिता। कौसल्यां च सुमित्रां च सम्प्रबाधेत मत्कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40004311, "chapter_id": 8912, "verse_number": "16", "content_sanskrit": "मा स्म मत्कारणाद्देवी सुमित्रा दुःखमावसेत्। अयोध्यामित एव त्वं काल्ये प्रविश लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40004312, "chapter_id": 8912, "verse_number": "17", "content_sanskrit": "अहमेको गमिष्यामि सीतया सह दण्डकान्। अनाथाया हि नाथस्त्वं कौशल्याया भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40004313, "chapter_id": 8912, "verse_number": "18", "content_sanskrit": "क्षुद्रकर्मा हि कैकेयी द्वेष्यमन्याय्यमाचरेत्। परिदद्याहि धर्मज्ञे भरते मम मातरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40004314, "chapter_id": 8912, "verse_number": "19", "content_sanskrit": "नूनं जात्यन्तरे कस्मिन् स्त्रियः पुत्रैर्वियोजिताः। जनन्या मम सौमित्रे तस्मादेतदुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40004315, "chapter_id": 8912, "verse_number": "20", "content_sanskrit": "मया हि चिरपुष्टेन दुखसंवर्धितेन च। विप्रयुज्यत कौशल्या फलकाले धिगस्तु माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40004316, "chapter_id": 8912, "verse_number": "21", "content_sanskrit": "मा स्म सीमन्तिनी काचिज्जनयेत्पुत्रमीदृशम्। सौमित्रे योऽहमम्बाया दद्मि शोकमनन्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40004317, "chapter_id": 8912, "verse_number": "22", "content_sanskrit": "मन्ये प्रीतिविशिष्टा सा मत्तो लक्ष्मण शारिका। यस्यास्तच्छ्रूयते वाक्यं शुक पादमरेर्दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40004318, "chapter_id": 8912, "verse_number": "23", "content_sanskrit": "शोचन्त्या अल्पभाग्याया न किञ्चिदुपकुर्वता। पुत्रेण किमपुत्राया मया कार्यमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40004319, "chapter_id": 8912, "verse_number": "24", "content_sanskrit": "अल्पभाग्या हि मे माता कौशल्या रहिता मया। शेते परमदुःखार्ता पतिता शोकसागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40004320, "chapter_id": 8912, "verse_number": "25", "content_sanskrit": "एको ह्यहमयोध्यां च पृथिवीं चापि लक्ष्मण। तरेयमिषुभिः क्रुद्धो ननु वीर्यमकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40004321, "chapter_id": 8912, "verse_number": "26", "content_sanskrit": "अधर्मभयभीतश्च परलोकस्य चानघ। तेन लक्ष्मण नाद्याह मात्मानमभिषेचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40004322, "chapter_id": 8912, "verse_number": "27", "content_sanskrit": "एतदन्यश्च करुणं विलप्य विजने वने। अश्रुपूर्णमुखो रामो निशि तूष्णीमुपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40004323, "chapter_id": 8912, "verse_number": "28", "content_sanskrit": "विलप्योपरतं रामं गतार्चिषमिवानलम्। समुद्रमिव निर्वेगमाश्वासयत लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40004324, "chapter_id": 8912, "verse_number": "29", "content_sanskrit": "ध्रुवमद्य पुरी राजन्नयोध्यायुधिनां वर। निष्प्रभा त्वयि निष्क्रान्ते गतचन्द्रेव शर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40004325, "chapter_id": 8912, "verse_number": "30", "content_sanskrit": "नैतदौपयिकं राम यदिदं परितप्यते। विषादयसि सीतां च मां चैव पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40004326, "chapter_id": 8912, "verse_number": "31", "content_sanskrit": "न च सीता त्वया हीना न चाहमपि राघव। मुहूर्तमपि जीवावो जलान्मत्स्याविनोद्धृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40004327, "chapter_id": 8912, "verse_number": "32", "content_sanskrit": "नहि तातं न शत्रुघ्नं न सुमित्रां परन्तप। द्रष्टुमिच्छेयमद्याहं स्वर्गं चापि त्वया विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40004328, "chapter_id": 8912, "verse_number": "33", "content_sanskrit": "ततस्तत्र सुखासीनौ नातिदूरे निरीक्ष्य ताम्। न्यग्रोधे सुकृतां शय्यां भेजाते धर्मवत्सलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40004329, "chapter_id": 8912, "verse_number": "34", "content_sanskrit": "स लक्ष्मणस्योत्तमपुष्कलं वचो निशम्य चैवं वनवासमादरात्। समाः समस्ता विदधे परन्तपः प्रपद्य धर्मं सुचिराय राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40004330, "chapter_id": 8912, "verse_number": "35", "content_sanskrit": "ततस्तु तस्मिन् विजने वने तदा महाबलौ राघववंशवर्धनौ। न तौ भयं सम्भ्रममभ्युपेयतु र्यथैव सिंहौ गिरिसानुगोचरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]