[{"id": 7003495000, "chapter_id": 23495, "verse_number": "१३५-१", "content_sanskrit": "अथ जालपादभक्षणापराधप्रायश्चित्तम् ।\nश्रीवराह उवाच ।\nरक्तवस्त्रेण संयुक्तो यो हि मामुपसर्पति ।\nतस्यापि शृणु सुश्रोणि कर्म संसारमोक्षणम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003495001, "chapter_id": 23495, "verse_number": "१३५-२", "content_sanskrit": "रजस्वलासु नारीषु रजो यत्तत्प्रवर्त्तते ।\nतेनासौ रजसा पुष्टो कर्मदोषेण जानतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003495002, "chapter_id": 23495, "verse_number": "१३५-३", "content_sanskrit": "वर्षाणि दश पञ्चैव वसते तत्र निश्चयात् ।\nरजो भूत्वा महाभागे रक्तवस्त्रपरायणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003495003, "chapter_id": 23495, "verse_number": "१३५-४", "content_sanskrit": "प्रायश्चितं प्रवक्ष्यामि तस्य कायविशोधनम् ।\nयेन शुध्यन्ति ते भूमे पुरुषाः शास्त्रनिश्चिताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003495004, "chapter_id": 23495, "verse_number": "१३५-५", "content_sanskrit": "एकाहारं ततः कृत्वा दिनानि दश सप्त च ।\nवायुभक्षस्त्रीण्यहानि दिनमेकं जलाशनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003495005, "chapter_id": 23495, "verse_number": "१३५-६", "content_sanskrit": "एवं स मुच्यते भूमे मम विप्रियकारकः ।\nप्रायश्चित्तं ततः कृत्वा ममासौ रोचते सह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003495006, "chapter_id": 23495, "verse_number": "१३५-७", "content_sanskrit": "एतत्ते कथितं भूमे रक्तवस्त्रविभूषिते ।\nप्रायश्चित्तं महाभागे सर्वसंसारमोक्षणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003495007, "chapter_id": 23495, "verse_number": "१३५-८", "content_sanskrit": "यस्तु मामन्धकारेषु विना दीपेन सुन्दरि ।\nस्पृशते च विना शास्त्रं त्वरमाणो विमोहितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003495008, "chapter_id": 23495, "verse_number": "१३५-९", "content_sanskrit": "पतनं तस्य वक्ष्यामि शृणुष्व त्वं वसुन्धरे ।\nतेन क्लेशं समासाद्य क्लिश्यते च नराधमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003495009, "chapter_id": 23495, "verse_number": "१३५-१०", "content_sanskrit": "अन्धो भूत्वा महाभागे एकं जन्म तमोमयः ।\nसर्वाशी सर्वभक्षश्च मानवः सोऽभिजायते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003495010, "chapter_id": 23495, "verse_number": "१३५-११", "content_sanskrit": "अनन्यमानसो भूत्वा भूमे ह्येतत्प्रसाधयेत् ।\nप्रायश्चित्तं प्रवक्ष्यामि अन्धकारे तु यः पुरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003495011, "chapter_id": 23495, "verse_number": "१३५-१२", "content_sanskrit": "संस्पृशेत्सोऽपि धर्मात्मा येन लोकं मम व्रजेत् ।\nअक्ष्णोराच्छादनं कृत्वा दिनानि दश पञ्च च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003495012, "chapter_id": 23495, "verse_number": "१३५-१३", "content_sanskrit": "एकाहारं ततः कृत्वा दिनविंशं समाहितः ।\nयस्य कस्यापि मासस्य एकामेव च द्वादशीम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003495013, "chapter_id": 23495, "verse_number": "१३५-१४", "content_sanskrit": "एकाहारस्ततो भूत्वा निषीदेच्च जलाशनः ।\nततो यवान्नं भुञ्जीत गोमूत्रेण तु पाचितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003495014, "chapter_id": 23495, "verse_number": "१३५-१५", "content_sanskrit": "प्रायश्चित्तेन चैतेन मुच्यते पातकात्ततः ।\nयः पुनः कृष्णवस्त्रेण मम कर्मपरायणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003495015, "chapter_id": 23495, "verse_number": "१३५-१६", "content_sanskrit": "देवि कर्माणि कुर्वीत तस्य वै पातनं शृणु ।\nघुणो वै पञ्चवर्षाणि लाजवास्तुसमाश्रयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003495016, "chapter_id": 23495, "verse_number": "१३५-१७", "content_sanskrit": "पञ्च वर्षाणि नकुलो दश वर्षाणि कच्छपः ।\nएवं भ्रमति संसारे मम कर्मपरायणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003495017, "chapter_id": 23495, "verse_number": "१३५-१८", "content_sanskrit": "पारावतेषु जायेत नव वर्षाणि पञ्च च ।\nजातो ममापराधेन स्थितः पारावतो भुवि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003495018, "chapter_id": 23495, "verse_number": "१३५-१९", "content_sanskrit": "मम तिष्ठति पार्श्वेषु यत्रैवाहं प्रतिष्ठितः ।\nप्रायश्चित्तं प्रवक्ष्यामि तस्य संसारमोक्षणे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003495019, "chapter_id": 23495, "verse_number": "१३५-२०", "content_sanskrit": "येनासौ लभते सिद्धिं कृष्णवस्त्रापराधतः ।\nसप्ताहं यावकं भुक्त्वा त्रिरात्रं सक्तुपिण्डिकाम्॥ 135.२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003495020, "chapter_id": 23495, "verse_number": "१३५-२१", "content_sanskrit": "त्रीणि पिण्डांस्त्रिरात्रं तु एवं मुच्येत किल्बिषात् ।\nय एतेन विधानेन देवि कर्माणि कारयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003495021, "chapter_id": 23495, "verse_number": "१३५-२२", "content_sanskrit": "शुचिर्भागवतो भूत्वा मम मार्गानुसारतः ।\nन स गच्छति संसारं मम लोकं स गच्छति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003495022, "chapter_id": 23495, "verse_number": "१३५-२३", "content_sanskrit": "वाससा चाप्यधौतेन यो मे कर्माणि कारयेत् ।\nशुचिर्भागवतो भूत्वा मम मार्गानुसारकः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003495023, "chapter_id": 23495, "verse_number": "१३५-२४", "content_sanskrit": "तस्य दोषं प्रवक्ष्यामि अपराधं वसुन्धरे ।\nपतन्ति येन संसारं वाससोच्छिष्टकारिणः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003495024, "chapter_id": 23495, "verse_number": "१३५-२५", "content_sanskrit": "देवि भूत्वा गजो मत्तस्तिष्ठत्येकं नरो भुवि ।\nउष्ट्रश्चैकं भवेज्जन्म जन्म चैकं वृकस्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003495025, "chapter_id": 23495, "verse_number": "१३५-२६", "content_sanskrit": "गोमायुरेकं जन्मापि जन्म चैकं हयस्तथा ।\nसारङ्गस्त्वेकजन्मा वै मृगो भवति वै ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003495026, "chapter_id": 23495, "verse_number": "१३५-२७", "content_sanskrit": "सप्तजन्मान्तरं पश्चात्ततो भवति मानुषः ।\nमद्भक्तश्च गुणज्ञश्च मम कर्मपरायणः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003495027, "chapter_id": 23495, "verse_number": "१३५-२८", "content_sanskrit": "दक्षो निरपराधश्च अहङ्कारविवर्जितः ।\nधरण्युवाच ।\nश्रुतमेतन्मया देव यत्त्वया समुदाहृतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003495028, "chapter_id": 23495, "verse_number": "१३५-२९", "content_sanskrit": "संसारं वाससोच्छिष्टा येन गच्छन्ति मानुषाः ।\nप्रायश्चित्तं च मे ब्रूहि सर्वकर्मसुखावहम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003495029, "chapter_id": 23495, "verse_number": "१३५-३०", "content_sanskrit": "किल्बिषाद्येन मुच्यन्ते तव कर्मपरायणाः ।\nश्रीवराह उवाच ।\nशृणु तत्त्वेन मे देवि कथ्यमानं मयाऽनघे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003495030, "chapter_id": 23495, "verse_number": "१३५-३१", "content_sanskrit": "प्रायश्चित्तं प्रवक्ष्यामि मम कर्मपरायणः ।\nयावकेन त्रीण्यहानि पिण्याकेन दिनत्रयम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003495031, "chapter_id": 23495, "verse_number": "१३५-३२", "content_sanskrit": "पर्णभक्षस्त्रीण्यहानि पयोभक्षो दिनत्रयम् ।\nपायसेन त्रिरात्रं तु वायुभक्षो दिनत्रयम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003495032, "chapter_id": 23495, "verse_number": "१३५-३३", "content_sanskrit": "एवं कृत्वा महाभागे वाससोच्छिष्टकारिणः ।\nअपराधं न विन्देरन्संसारं न प्रयान्ति च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003495033, "chapter_id": 23495, "verse_number": "१३५-३४", "content_sanskrit": "श्वानोच्छिष्टं तु यो दद्यान्मम कर्मपरायणः ।\nपापं तस्य प्रवक्ष्यामि संसारे च महद्भयम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003495034, "chapter_id": 23495, "verse_number": "१३५-३५", "content_sanskrit": "श्वानो वै सप्त जन्मानि गोमायुः सप्त वै तथा ।\nउलूकः सप्तवर्षाणि पश्चाज्जायेत मानुषः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003495035, "chapter_id": 23495, "verse_number": "१३५-३६", "content_sanskrit": "विशुद्धात्मा श्रुतिज्ञश्च मद्भक्तश्चैव जायते ।\nगृहे भागवतोत्कृष्टे अपराधविवर्जितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003495036, "chapter_id": 23495, "verse_number": "१३५-३७", "content_sanskrit": "शृणु तत्त्वेन वसुधे प्रायश्चित्तं महौजसम् ।\nतरन्ति मानुषा येन त्यक्त्वा संसारसागरम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003495037, "chapter_id": 23495, "verse_number": "१३५-३८", "content_sanskrit": "मूलभक्षो दिनत्रय्यां फलाहारो दिनत्रयम् ।\nशाकभक्षो दिनत्रय्यां पयोभक्षो दिनत्रयम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003495038, "chapter_id": 23495, "verse_number": "१३५-३९", "content_sanskrit": "दध्याहारो दिनत्रय्यां पायसेन दिनत्रयम् ।\nवाय्वाहारो दिनत्रय्यां स्नानं कृत्वा दृढव्रतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003495039, "chapter_id": 23495, "verse_number": "१३५-४०", "content_sanskrit": "एवं दिनान्येकविंशत्कृत्वा वै शुभलक्षणम् ।\nअपराधं न विन्देत मम लोकं स गच्छति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003495040, "chapter_id": 23495, "verse_number": "१३५-४१", "content_sanskrit": "भुक्त्वा वराहमांसं तु यश्च मामिह सर्पति ।\nपातनं तस्य वक्ष्यामि यथा भवति सुन्दरि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003495041, "chapter_id": 23495, "verse_number": "१३५-४२", "content_sanskrit": "वराहो दश वर्षाणि कृत्वानुचरते वने ।\nव्याधो भूत्वा महाभागे समाः पञ्च च सप्त च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003495042, "chapter_id": 23495, "verse_number": "१३५-४३", "content_sanskrit": "ततश्च मूषको भूत्वा वर्षाणि च चतुर्दश ।\nऊनविंशतिवर्षाणि यातुधानश्च जायते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003495043, "chapter_id": 23495, "verse_number": "१३५-४४", "content_sanskrit": "सल्लकी चाष्टवर्षाणि जायते भवने बहु ।\nव्याघ्रस्त्रिंशच्च वर्षाणि जायते पिशिताशनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003495044, "chapter_id": 23495, "verse_number": "१३५-४५", "content_sanskrit": "एवं संसारितां गत्वा वराहामिषभक्षकः ।\nजायते विपुले सिद्धे कुले भागवते तथा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003495045, "chapter_id": 23495, "verse_number": "१३५-४६", "content_sanskrit": "हृषीकेशवचः श्रुत्वा  सर्वं सम्पूर्णलक्षणम् ।\nशिरसा चाञ्जलिं कृत्वा वाक्यं चेदमुवाच ह ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003495046, "chapter_id": 23495, "verse_number": "१३५-४७", "content_sanskrit": "एतन्मे परमं गुह्यं तव भक्तसुखावहम् ।\nवराहमांसभक्षस्तु येन मुच्येत किल्बिषात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003495047, "chapter_id": 23495, "verse_number": "१३५-४८", "content_sanskrit": "तरन्ति मानुषा येन तिर्यक्संसारसागरात् ।\nगोमयेन दिनं पञ्च कणाहारेण सप्त वै ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003495048, "chapter_id": 23495, "verse_number": "१३५-४९", "content_sanskrit": "पानीयं तु ततो भुक्ता तिष्ठेत्सप्तदिनं ततः ।\nअक्षारलवणं सप्त सक्तुभिश्च तथा त्रयः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003495049, "chapter_id": 23495, "verse_number": "१३५-५०", "content_sanskrit": "तिलभक्षो दिनान्सप्त पाषाणस्य च भक्षकः ।\nपयो भुक्त्वा दिनं सप्त कारयेद्बुद्धिमान्मनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003495050, "chapter_id": 23495, "verse_number": "१३५-५१", "content_sanskrit": "क्षान्तं दान्तं तथा कृत्वा अहङ्कारविवर्ज्जितः ।\nदिनान्येकोनपञ्चाशच्चरेत्कृतविनिश्चयः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003495051, "chapter_id": 23495, "verse_number": "१३५-५२", "content_sanskrit": "विमुक्तः सर्वपापेभ्यः ससंज्ञो विगतज्वरः ।\nकृत्वा मम च कर्माणि मम लोकं स गच्छति ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003495052, "chapter_id": 23495, "verse_number": "१३५-५३", "content_sanskrit": "जालपादं भक्षयित्वा यस्तु मामुपसर्पति।\nजालपादस्ततो भूत्वा वर्षाणि दश पञ्च च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003495053, "chapter_id": 23495, "verse_number": "१३५-५४", "content_sanskrit": "कुम्भीरो दश वर्षाणि पञ्च वर्षाणि सूकरः ।\nतावद्भ्रमति संसारे मम चैवापराधतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003495054, "chapter_id": 23495, "verse_number": "१३५-५५", "content_sanskrit": "कृत्वा तु दुष्करं कर्म जायते विपुले कुले ।\nशुद्धो भागवतश्रेष्ठो ह्यपराधविवर्जितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003495055, "chapter_id": 23495, "verse_number": "१३५-५६", "content_sanskrit": "सर्वकर्माण्यतिक्रम्य मम लोकं स गच्छति ।\nप्रायश्चितं प्रवक्ष्यामि जालपादस्य भक्षणे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003495056, "chapter_id": 23495, "verse_number": "१३५-५७", "content_sanskrit": "तरन्ति मनुजा येन घोरसंसारसागरात् ।\nयावकान्नं दिनत्रय्यां वायुभक्षो दिनत्रयम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003495057, "chapter_id": 23495, "verse_number": "१३५-५८", "content_sanskrit": "फलभक्षो दिनत्रय्यां तिलभक्षो दिनत्रयम् ।\nअक्षारलवणान्नाशी पुनस्तत्र दिनत्रयम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003495058, "chapter_id": 23495, "verse_number": "१३५-५९", "content_sanskrit": "दशपञ्च दिनान्येवं प्रायश्चित्तं समाचरेत् ।\nजालपादापराधस्य एवं कुर्वीत शोधनम्।\nविनीतात्मा शुचिर्भूत्वा य इच्छेत्सुशुभां गतिम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]