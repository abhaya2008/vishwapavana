[{"id": 7003683000, "chapter_id": 23683, "verse_number": "१-३-४-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथाभ्यधत्त विजया प्रणम्य जगदम्बिकाम् ।\nसांत्वयन्ती स्तुतिशतैरुपायैः शिवदर्शनैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003683001, "chapter_id": 23683, "verse_number": "१-३-४-२", "content_sanskrit": "देवि त्वमविनाभूता सदा देवेन शंभुना ।\nप्राणेश्वरी त्वमेकासि शक्तिस्तस्य परात्मनः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003683002, "chapter_id": 23683, "verse_number": "१-३-४-३", "content_sanskrit": "तथा मायां त्वमात्मीयां संदर्शयितुमीहसे ।\nपृथग्भावमिवेशानः प्रकाशयति न स्वयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003683003, "chapter_id": 23683, "verse_number": "१-३-४-४", "content_sanskrit": "आदेशं प्रतिगृह्यैव समुपेतासि पार्वति ।\nअलंघनीया सेवाज्ञा शांभवी सर्वदा त्वया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003683004, "chapter_id": 23683, "verse_number": "१-३-४-५", "content_sanskrit": "विधातव्यं तपः प्राप्तं स्थानेस्मिच्छिवकल्पिते ।\nनिवृत्त्य निखिलान्कामाच्छंमुमाश्रितया त्वया ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003683005, "chapter_id": 23683, "verse_number": "१-३-४-६", "content_sanskrit": "अन्यथापि जगद्रक्षा त्वदधीना जगन्मयि ।\nधर्मसंरक्षणं भूयः शिवेन सहितं तव ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003683006, "chapter_id": 23683, "verse_number": "१-३-४-७", "content_sanskrit": "निष्कलं शिवमत्यंतं ध्यायंत्यात्मन्यवस्थितम् ।\nवियोगदुःखं कञ्चित्त्वं न स्मरिष्यसि पार्वति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003683007, "chapter_id": 23683, "verse_number": "१-३-४-८", "content_sanskrit": "भक्तानां तव मुख्यानां तवैवाचारसंग्रहः ।\nउपदेशितया लोके प्रथतां धर्मवत्सले ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003683008, "chapter_id": 23683, "verse_number": "१-३-४-९", "content_sanskrit": "इति तस्या वचः श्रुत्वा गौरी सुस्थिरमानसा ।\nतपः कर्त्तुं समारेभे कंपा नद्यास्तटे शुभे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003683009, "chapter_id": 23683, "verse_number": "१-३-४-१०", "content_sanskrit": "विमुच्य विविधा भूषा रुद्राक्षगणभूषिता ।\nविसृज्य दिव्यं वसनं पर्यधाद्वल्कले शुभे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003683010, "chapter_id": 23683, "verse_number": "१-३-४-११", "content_sanskrit": "अलकैः सहसा शिल्पमनयच्च कपर्दृताम् ।\nअलिंपत तनूं सर्वां भस्मना मुक्तकुंकुमा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003683011, "chapter_id": 23683, "verse_number": "१-३-४-१२", "content_sanskrit": "मृगेषु कृतसंतोषा शिलोंछीकृतवृत्तिषु ।\nजजाप नियमोपेता शिवपंचाक्षरं परम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003683012, "chapter_id": 23683, "verse_number": "१-३-४-१३", "content_sanskrit": "कृत्वा त्रिषवणं स्नानं कम्पा पयसि निर्मले ।\nकृत्वा च सैकतं लिंगं पूजयामास सादरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003683013, "chapter_id": 23683, "verse_number": "१-३-४-१४", "content_sanskrit": "वृक्षप्ररोपणैर्दानैरशेषातिथिपूजनैः ।\nश्रांतिं हरंती जीवानां देवी धर्ममपालयत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003683014, "chapter_id": 23683, "verse_number": "१-३-४-१५", "content_sanskrit": "ग्रीष्मे पंचाग्निमध्यस्था वर्षासु स्थंडिलेशया ।\nहेमन्ते जलमध्यस्था शिशिरे चाकरोत्तपः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003683015, "chapter_id": 23683, "verse_number": "१-३-४-१६", "content_sanskrit": "पुण्यात्मनां महर्षीणां दर्शनार्थमुपेयुषाम् ।\nविस्मयं जनयामास पूजयामास सादरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003683016, "chapter_id": 23683, "verse_number": "१-३-४-१७", "content_sanskrit": "कदाचित्स्वयमुच्चित्य वनांतात्पल्लवान्वितम् ।\nपुष्पोत्करं विशेषेण शोधितुं समुपाविशत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003683017, "chapter_id": 23683, "verse_number": "१-३-४-१८", "content_sanskrit": "कृत्वा च सैकतं लिंगं कंपारोधसि पावने ।\nसंपूजयितुमारेभे न्यासावाहनपूर्वकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003683018, "chapter_id": 23683, "verse_number": "१-३-४-१९", "content_sanskrit": "सूर्यमभ्यर्च्य विधिवद्रक्तैः पुष्पैश्च चंदनैः ।\nपंचावरणसंयुक्तं क्रमादानर्च शंकरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003683019, "chapter_id": 23683, "verse_number": "१-३-४-२०", "content_sanskrit": "धूपैर्दीपश्च नैवेद्यैर्भक्तिभावसमन्वितैः ।\nअपरोक्षितमीशानमालुलोके पुरोहितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003683020, "chapter_id": 23683, "verse_number": "१-३-४-२१", "content_sanskrit": "अथ देवः शिवः साक्षात्संशोधयितुमंबिकाम् ।\nकंपानद्याः प्रवाहेण महता पर्यवेष्टयत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003683021, "chapter_id": 23683, "verse_number": "१-३-४-२२", "content_sanskrit": "अतिवृद्धं प्रवाहं तं कम्पायाः समुपस्थितम् ।\nआलोक्य नियमासीनामाहुः सख्यस्तदांबिकाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003683022, "chapter_id": 23683, "verse_number": "१-३-४-२३", "content_sanskrit": "उत्तिष्ठ देवि बहुलः प्रवाहोऽयं विजृंभते ।\nदिशां मुखानि संपूर्य तरसा प्लावयिष्यति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003683023, "chapter_id": 23683, "verse_number": "१-३-४-२४", "content_sanskrit": "इति तद्वचनं श्रुत्वा ध्यायंती मीलितेक्षणा ।\nउन्मील्य वेगमतुलं नद्यास्तं समवैक्षत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003683024, "chapter_id": 23683, "verse_number": "१-३-४-२५", "content_sanskrit": "अचिंतयच्च सा देवी पूजाविघ्नसमाकुला ।\nकिं करोमि न शक्नोमि हातुमारब्धमर्चनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003683025, "chapter_id": 23683, "verse_number": "१-३-४-२६", "content_sanskrit": "श्रेयः प्राप्तुमविघ्नेन प्रायः पुण्यात्मनां भुवि ।\nघटते धर्मसंयोगो मनोरथफलप्रदः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003683026, "chapter_id": 23683, "verse_number": "१-३-४-२७", "content_sanskrit": "सैकतं लिंगमतुलप्रवाहाल्लयमेष्यति ।\nलिंगनाशे विमोक्तव्यः सद्भक्तैः प्राणसंग्रहः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003683027, "chapter_id": 23683, "verse_number": "१-३-४-२८", "content_sanskrit": "प्रवाहोऽयं समायाति शिवमायाविनिर्मितः ।\nविशोधयितुमात्मानं भक्तियुक्तं निजे पदे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003683028, "chapter_id": 23683, "verse_number": "१-३-४-२९", "content_sanskrit": "आलिंग्य सुदृढं दोर्भ्यामेतल्लिंगमनाकुलम् ।\nअहं वत्स्यामि याताशु सख्यो यूयं विदूरतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003683029, "chapter_id": 23683, "verse_number": "१-३-४-३०", "content_sanskrit": "इत्युक्ता सैकतं लिगं गाढमालिंग्य सांबिका ।\nन मुमोच प्रवाहेन वेष्ट्यमानापि वेगतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003683030, "chapter_id": 23683, "verse_number": "१-३-४-३१", "content_sanskrit": "स्तनचूचुकनिर्मग्नमुद्रादर्शितलांछनम् ।\nमहालिंगं स्वसंयुक्तं प्रणनाम तदादरात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003683031, "chapter_id": 23683, "verse_number": "१-३-४-३२", "content_sanskrit": "निमीलितेक्षणा ध्याननिष्ठैकहृदया स्थिता ।\nपुलकांचितसर्वांगी सा स्मरंती सदाशिवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003683032, "chapter_id": 23683, "verse_number": "१-३-४-३३", "content_sanskrit": "कंपस्वेदपरित्राणलज्जाप्रणयकेलिदात् ।\nक्षणमप्यचला लिंगान्न वियोगमपेक्षते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003683033, "chapter_id": 23683, "verse_number": "१-३-४-३४", "content_sanskrit": "अथ तामब्रवीत्कापि दैवी वागशरीरिणी ।\nविमुंच बालिके लिंगं प्रवाहोऽयं गतो महान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003683034, "chapter_id": 23683, "verse_number": "१-३-४-३५", "content_sanskrit": "त्वयार्चितमिदं लिंगं सैकतं स्थिरवैभवम् ।\nभविष्यति महाभागे वरदं सुरपूजितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003683035, "chapter_id": 23683, "verse_number": "१-३-४-३६", "content_sanskrit": "तपश्चर्यां तवालोक्य रचितं धर्मपालनम् ।\nलिंगं चैतन्नमस्कृत्य कृतार्थाः संतु मानवाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003683036, "chapter_id": 23683, "verse_number": "१-३-४-३७", "content_sanskrit": "अहं हि तैजसं रूपमास्थाय वसुधातले ।\nवसामि चात्र सिद्ध्यर्थमरुणाचलसंज्ञया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003683037, "chapter_id": 23683, "verse_number": "१-३-४-३८", "content_sanskrit": "रुणद्धि सर्वलोकेभ्यः परुषं पापसंचयम् ।\nरुणो न विद्यते यस्मिन्दृष्टे तेनारुणाचलः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003683038, "chapter_id": 23683, "verse_number": "१-३-४-३९", "content_sanskrit": "ऋषयः सिद्धगंधर्वा महात्मानश्च योगिनः ।\nमुक्त्वा कैलासशिखरं मेरुं चैनमुपासते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003683039, "chapter_id": 23683, "verse_number": "१-३-४-४०", "content_sanskrit": "मदंश जातयोः पूर्वं युध्यतोर्ब्रह्मकृष्णयोः ।\nअहं मोहमपाकर्त्तुं तेजोरूपो व्यवस्थितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003683040, "chapter_id": 23683, "verse_number": "१-३-४-४१", "content_sanskrit": "ब्रह्मणा हंसरूपेण विष्णुना क्रोडरूपिणा ।\nअदृष्टशेखरपदः प्रणतो भक्तियोगतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003683041, "chapter_id": 23683, "verse_number": "१-३-४-४२", "content_sanskrit": "ततः प्रसन्नः प्रत्यक्षस्तस्यां वरमभीप्सितम् ।\nप्रादां जगत्त्रयस्यास्य संरक्षायां तु कौशलम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003683042, "chapter_id": 23683, "verse_number": "१-३-४-४३", "content_sanskrit": "प्रार्थितश्च पुनस्ताभ्यामरुणाचलसंज्ञया ।\nअनैषि तैजसं रूपमहं स्थावरलिंगताम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003683043, "chapter_id": 23683, "verse_number": "१-३-४-४४", "content_sanskrit": "गत्वा पृच्छ महाभागं मद्भक्तिं गौतमं मुनिम् ।\nअरुणाचलमाहात्म्यं श्रुत्वा तत्र तपश्चर ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003683044, "chapter_id": 23683, "verse_number": "१-३-४-४५", "content_sanskrit": "तत्र ते दर्शयिष्यामि तैजसं रूपमात्मनः ।\nसर्वपापनिवृत्त्यर्थं सर्वलोकहिताय च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003683045, "chapter_id": 23683, "verse_number": "१-३-४-४६", "content_sanskrit": "इति वाचं समाकर्ण्य निष्कलात्कथितां शिवात् ।\nतथेति सहसा देवी गंतुं समुपचक्रमे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003683046, "chapter_id": 23683, "verse_number": "१-३-४-४७", "content_sanskrit": "अथ देवानृषीन्सर्वान्पश्चात्सेवार्थमागतान् ।\nअवादीदंबिकालोक्य स्नेहपूर्णेन चक्षुषा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003683047, "chapter_id": 23683, "verse_number": "१-३-४-४८", "content_sanskrit": "तिष्ठतात्रैव वै देवा मुनयश्च दृढव्रताः ।\nनियमांश्चाधितिष्ठंतः कंपारोधसि पावने ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003683048, "chapter_id": 23683, "verse_number": "१-३-४-४९", "content_sanskrit": "सर्वपापक्षयकरं सर्वसौभाग्यवर्द्धनम् ।\nपूज्यतां सैकतं लिंगं कुचकंकणलांछनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003683049, "chapter_id": 23683, "verse_number": "१-३-४-५०", "content_sanskrit": "अहं च निष्कलं रूपमास्थायैतद्दिवानिशम् ।\nआराधयामि मंत्रेण शोणेश्वरं वरप्रदम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003683050, "chapter_id": 23683, "verse_number": "१-३-४-५१", "content_sanskrit": "मत्तपश्चरणाल्लोके मद्धर्मपरिपालनात् ।\nमल्लिंगदर्शनाच्चैव सिध्यंत्विष्टविभूतयः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003683051, "chapter_id": 23683, "verse_number": "१-३-४-५२", "content_sanskrit": "सर्वकामप्रदानेन कामाक्षीमिति कामतः ।\nमां प्रणम्यात्र मद्भक्ता लभंतां वांछितं वरम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003683052, "chapter_id": 23683, "verse_number": "१-३-४-५३", "content_sanskrit": "अहं हि देवदेवस्य शंभोरव्याहतो जनः ।\nआदेशं पालयिष्यामि गत्वारुणमहीधरम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003683053, "chapter_id": 23683, "verse_number": "१-३-४-५४", "content_sanskrit": "तत्र गत्वा तपस्तीव्रं कृत्वा शंभुं प्रसाद्य च ।\nमां तु लब्धवरां यूयं पश्चाद्रक्ष्यथ संगताः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003683054, "chapter_id": 23683, "verse_number": "१-३-४-५५", "content_sanskrit": "इति सर्वान्विसृज्याशु सद्भक्तान्पादसेविनः ।\nअरुणाद्रिं गता बाला तपसे शंकराज्ञया ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003683055, "chapter_id": 23683, "verse_number": "१-३-४-५६", "content_sanskrit": "नित्याभिसेविताऽकारि सखीभिरभियोगतः ।\nआससादारुणाद्रीशं दिव्यदुंदुभिनादितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003683056, "chapter_id": 23683, "verse_number": "१-३-४-५७", "content_sanskrit": "अंतस्तेजोमयं शांतमरुणाचलनायकम् ।\nअप्सरोनृत्यगीतैश्च पूजितं पुष्पवृष्टिभिः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003683057, "chapter_id": 23683, "verse_number": "१-३-४-५८", "content_sanskrit": "प्रणम्य स्थावरं लिंगं कौतूहलसमन्विता ।\nसिद्धानां योगिनां सार्थमृषीणां चान्ववैक्षत ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003683058, "chapter_id": 23683, "verse_number": "१-३-४-५९", "content_sanskrit": "अत्रिर्भृगुर्भरद्वाजः कश्यपश्चांगिरास्तथा ।\nकुत्सश्च गौतमश्चान्ये सिद्धविद्याधरामराः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003683059, "chapter_id": 23683, "verse_number": "१-३-४-६०", "content_sanskrit": "तपः कुर्वंति सततमपेक्षितवराप्तये ।\nगंगाद्याः सरितश्चान्याः परितः पर्युपासते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003683060, "chapter_id": 23683, "verse_number": "१-३-४-६१", "content_sanskrit": "दिव्यलिंगमिदं पूज्यमरुणाद्रिरिति स्मृतम् ।\nवंदस्वेति सुरैः प्रोक्ता प्रणनाम पुनःपुनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003683061, "chapter_id": 23683, "verse_number": "१-३-४-६२", "content_sanskrit": "अभ्यर्थिता पुनः सर्वैरातिथ्यार्थे महर्षिभिः ।\nशिवाज्ञया गौतमो मे द्रष्टव्य इति सावदत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003683062, "chapter_id": 23683, "verse_number": "१-३-४-६३", "content_sanskrit": "अयमत्रर्षिभिर्भक्तैर्निर्दिष्टं तमथाभ्यगात् ।\nस मुनिः शिवभक्तानां प्रथमस्तपसां निधिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003683063, "chapter_id": 23683, "verse_number": "१-३-४-६४", "content_sanskrit": "वनांतरं गतेः प्रातः समित्कुशफलाहृतेः ।\nअतिथीनाश्रमं प्राप्तानर्चथेति दृढव्रतान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003683064, "chapter_id": 23683, "verse_number": "१-३-४-६५", "content_sanskrit": "शिष्यानादिश्य धर्मात्मा गतश्च विपिनांतरम् ।\nअथ सा गौतमं द्रष्टुमागता पर्णशालिकाम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003683065, "chapter_id": 23683, "verse_number": "१-३-४-६६", "content_sanskrit": "क्व गतो मुनिरित्युक्तैरित आयास्यति क्षणात् ।\nशिष्यैरभ्यर्थितेत्युक्त्वा फलमूलैस्सुगंधिभिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003683066, "chapter_id": 23683, "verse_number": "१-३-४-६७", "content_sanskrit": "अभ्युत्थानेनासनेन पाद्येनार्घेण सूनृतैः ।\nवचनैः फलमृलेन सार्चिता शिष्यसंपदा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003683067, "chapter_id": 23683, "verse_number": "१-३-४-६८", "content_sanskrit": "क्षणं क्षमस्वसूनुस्तामन्ये जग्मुस्तदन्तिकम् ।\nदेव्यां प्रविष्टमात्रायां महर्षेराश्रमो महान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003683068, "chapter_id": 23683, "verse_number": "१-३-४-६९", "content_sanskrit": "अभवत्कल्पबहुलो मणिप्रासादसंकुलः ।\nवनांतरादुपावृत्त्य समित्कुशफलाहरः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003683069, "chapter_id": 23683, "verse_number": "१-३-४-७०", "content_sanskrit": "अपश्यत्स्वाश्रमं दूरे विमानशतशोभितम् ।\nकिमेतदिति साश्चर्यं चिंतयन्मुनिपुंगवः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003683070, "chapter_id": 23683, "verse_number": "१-३-४-७१", "content_sanskrit": "गौर्याः समागमं सर्वमपश्यज्ज्ञानचक्षुषा ।\nशीघ्रं निवर्तमानोऽसौ द्रष्टुं तां लोकमातरम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003683071, "chapter_id": 23683, "verse_number": "१-३-४-७२", "content_sanskrit": "शिष्यैः शीघ्रचरैर्वृत्तमावेदितमथाशृणोत् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003683072, "chapter_id": 23683, "verse_number": "१-३-४-७३", "content_sanskrit": "अथ महर्षिरुपागतकौतुको निजतपःफलमेव तदागमम् ।\nशिवदयाकलितं परिचिन्तयन्नभजदाश्रममाश्रितवत्सलः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003683073, "chapter_id": 23683, "verse_number": "१-३-४-७४", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्ये पूर्वार्धे पार्वत्याः कंपाया अरुणाचले गौतमाश्रमागमनंनाम चतुर्थोऽध्यायः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]