[{"id": 6000280000, "chapter_id": 10280, "verse_number": null, "content_sanskrit": "अथ चतुरशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000280001, "chapter_id": 10280, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.001.m4a", "display_order": 2}, {"id": 6000280002, "chapter_id": 10280, "verse_number": "१०-८४-१", "content_sanskrit": "एवं युधिष्ठिरो राजा जरासन्धवधं प्रभो।\nकृष्णस्य चानुभावं तं श्रुत्वा प्रीतस्तमब्रवीत्॥ १०/८४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.002.m4a", "display_order": 3, "topics": [{"text": "राजसूयवर्णनम्", "range": "१–१६"}]}, {"id": 6000280003, "chapter_id": 10280, "verse_number": null, "content_sanskrit": "युधिष्ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.003.m4a", "display_order": 4}, {"id": 6000280004, "chapter_id": 10280, "verse_number": "१०-८४-२", "content_sanskrit": "यस्य त्रिलोकगुरवः सर्वलोकमहेश्वराः।\nवहन्ति दुर्लभं लब्ध्वा शिरसैवानुशासनम्॥ १०/८४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.004.m4a", "display_order": 5}, {"id": 6000280005, "chapter_id": 10280, "verse_number": "१०-८४-३", "content_sanskrit": "स भवानरविन्दाक्ष दीनानामीशमानिनाम्।\nधत्तेऽनुशासनं भूमंस्तदत्यन्तविडम्बनम्॥ १०/८४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.005.m4a", "display_order": 6}, {"id": 6000280006, "chapter_id": 10280, "verse_number": "१०-८४-४", "content_sanskrit": "न ह्येकस्याद्वितीयस्य ब्रह्मणः परमात्मनः।\nकर्मभिर्वर्धते तेजो ह्रसते च यथा रवेः॥ १०/८४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.006.m4a", "display_order": 7}, {"id": 6000280007, "chapter_id": 10280, "verse_number": "१०-८४-५", "content_sanskrit": "न च तेऽजित भक्तानां ममाहमिति माधव।\nत्वं तवेति च नानाधीः पशूनामिव वैकृता॥ १०/८४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.007.m4a", "display_order": 8}, {"id": 6000280008, "chapter_id": 10280, "verse_number": "१०-८४-६", "content_sanskrit": "इत्युक्त्वा याज्ञिये काले वव्रे युक्तान् स ऋत्विजः।\nकृष्णानुमोदितः पार्थो ब्राह्मणान्ब्रह्मवादिनः॥ १०/८४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.008.m4a", "display_order": 9}, {"id": 6000280009, "chapter_id": 10280, "verse_number": "१०-८४-७", "content_sanskrit": "द्वैपायनो भरद्वाजः सुमन्तुर्गौतमोऽसितः।\nवसिष्ठश्च्यवनः कण्वो मैत्रेयः कवषस्‍त्रितः॥ १०/८४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.009.m4a", "display_order": 10}, {"id": 6000280010, "chapter_id": 10280, "verse_number": "१०-८४-८", "content_sanskrit": "विश्वामित्रो वामदेवः सुमतिर्जैमिनिः क्रतुः।\nपैलः पराशरो गर्गो वैशम्पायन एव च॥ १०/८४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.010.m4a", "display_order": 11}, {"id": 6000280011, "chapter_id": 10280, "verse_number": "१०-८४-९", "content_sanskrit": "अथर्वा काश्यपो धौम्यो रामो भार्गव आसुरिः।\nवीतिहोत्रो मधुच्छन्दा वीरसेनोऽकृतव्रणः॥ १०/८४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.011.m4a", "display_order": 12}, {"id": 6000280012, "chapter_id": 10280, "verse_number": "१०-८४-१०", "content_sanskrit": "उपाहूतास्तथा चान्ये द्रोणभीष्मकृपादयः।\nधृतराष्ट्रः सहसुतो विदुरश्च महामतिः॥ १०/८४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.012.m4a", "display_order": 13}, {"id": 6000280013, "chapter_id": 10280, "verse_number": "१०-८४-११", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा यज्ञदिदृक्षवः।\nतत्रेयुः सर्वराजानो राज्ञां प्रकृतयो नृप॥ १०/८४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.013.m4a", "display_order": 14}, {"id": 6000280014, "chapter_id": 10280, "verse_number": "१०-८४-१२", "content_sanskrit": "ततस्तद् देवयजनं ब्राह्मणाः स्वर्णलाङ्गलैः।\nकृष्ट्वा तत्र यथान्यायं दीक्षयाञ्चक्रिरे नृपम्॥ १०/८४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.014.m4a", "display_order": 15}, {"id": 6000280015, "chapter_id": 10280, "verse_number": "१०-८४-१३", "content_sanskrit": "हैमः किलोपकरणो वरुणस्य यथा पुरा।\nइन्द्रादयो लोकपाला विरिञ्चभवसंयुताः॥ १०/८४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.015.m4a", "display_order": 16}, {"id": 6000280016, "chapter_id": 10280, "verse_number": "१०-८४-१४", "content_sanskrit": "सगणाः सिद्धगन्धर्वा विद्याधरमहोरगाः।\nमुनयो यक्षरक्षांसि खगाः किन्नरचारणाः॥ १०/८४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.016.m4a", "display_order": 17}, {"id": 6000280017, "chapter_id": 10280, "verse_number": "१०-८४-१५", "content_sanskrit": "राजानश्च समाहूता राजपत्न्यश्च सर्वशः।\nराजसूयं समीयुः स्म राज्ञः पाण्डुसुतस्य वै॥ १०/८४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.017.m4a", "display_order": 18}, {"id": 6000280018, "chapter_id": 10280, "verse_number": "१०-८४-१६", "content_sanskrit": "मेनिरे कृष्णभक्तस्य सूपपन्नमविस्मिताः।\nअयाजयन् महाराज याजका देववर्चसः॥ १०/८४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.018.m4a", "display_order": 19}, {"id": 6000280019, "chapter_id": 10280, "verse_number": "१०-८४-१७", "content_sanskrit": "राजसूयेन विधिवत् प्रचेतसमिवामराः।\nसौत्येऽहन्यवनीपालो याजकान् सदसस्पतीन्॥ १०/८४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.019.m4a", "display_order": 20, "topics": [{"text": "अग्रपूजावसरे शिशुपालवधश्च", "range": "१७–५३"}]}, {"id": 6000280020, "chapter_id": 10280, "verse_number": "१०-८४-१८", "content_sanskrit": "अपूजयन्महाभागान् यथावत् सुसमाहितः।\nसदस्याग्रार्हणार्हं वै विमृशन्तः सभासदः॥ १०/८४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.020.m4a", "display_order": 21}, {"id": 6000280021, "chapter_id": 10280, "verse_number": "१०-८४-१९", "content_sanskrit": "नाध्यगच्छन्ननैकान्त्यात् सहदेवस्तदाऽब्रवीत्।\nअर्हति ह्यच्युतः श्रैष्ठ्यं भगवान् सात्त्वतां पतिः॥ १०/८४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.021.m4a", "display_order": 22}, {"id": 6000280022, "chapter_id": 10280, "verse_number": "१०-८४-२०", "content_sanskrit": "एष वै देवताः सर्वा देशकालधनादयः।\nयदात्मकमिदं विश्वं क्रतवश्च यदात्मकाः॥ १०/८४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.022.m4a", "display_order": 23}, {"id": 6000280023, "chapter_id": 10280, "verse_number": "१०-८४-२१", "content_sanskrit": "अग्निराहुतयो मन्त्राः साङ्ख्यं योगश्च यत्परः।\nएक एवाद्वितीयोऽसावैतदात्म्यमिदं जगत्॥ १०/८४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.023.m4a", "display_order": 24}, {"id": 6000280024, "chapter_id": 10280, "verse_number": "१०-८४-२२", "content_sanskrit": "आत्मनाऽऽत्माश्रयः सभ्याः सृजत्यवति हन्त्यजः।\nविविधानीह कर्माणि जनयन् ह्यनपेक्षया॥ १०/८४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.024.m4a", "display_order": 25}, {"id": 6000280025, "chapter_id": 10280, "verse_number": "१०-८४-२३", "content_sanskrit": "ईहते यदयं सर्वं श्रेयो धर्मादिलक्षणम्।\nतस्मात् कृष्णाय महते दीयतां परमार्हणम्॥ १०/८४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.025.m4a", "display_order": 26}, {"id": 6000280026, "chapter_id": 10280, "verse_number": "१०-८४-२४", "content_sanskrit": "एवं चेत् सर्वभूतानामात्मनश्चार्हणं भवेत्।\nसर्वभूतात्मभूताय कृष्णायानन्यदर्शिने॥ १०/८४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.026.m4a", "display_order": 27}, {"id": 6000280027, "chapter_id": 10280, "verse_number": "१०-८४-२५", "content_sanskrit": "देयं शान्ताय पूर्णाय दत्तस्यानन्त्यमिच्छता॥ १०/८४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.027.m4a", "display_order": 28}, {"id": 6000280028, "chapter_id": 10280, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.028.m4a", "display_order": 29}, {"id": 6000280029, "chapter_id": 10280, "verse_number": "१०-८४-२६", "content_sanskrit": "इत्युक्त्वा सहदेवोऽभूत् तूष्णीं कृष्णानुभाववित्।\nतच्छ्रुत्वा तुष्टुवुः सर्वे साधु साध्विति सत्तमाः॥ १०/८४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.029.m4a", "display_order": 30}, {"id": 6000280030, "chapter_id": 10280, "verse_number": "१०-८४-२७", "content_sanskrit": "श्रुत्वाऽनुजेरितं राजा ज्ञात्वा हार्दं सभासदाम्।\nसमर्हयद् हृषीकेशं प्रीतः प्रणयविह्वलः॥ १०/८४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.030.m4a", "display_order": 31}, {"id": 6000280031, "chapter_id": 10280, "verse_number": "१०-८४-२८", "content_sanskrit": "तत्पादाववनिज्यापः शिरसा लोकपावनीः।\nसभार्यः सानुजामात्यः सकुटुम्बोऽवहन्मुदा॥ १०/८४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.031.m4a", "display_order": 32}, {"id": 6000280032, "chapter_id": 10280, "verse_number": "१०-८४-२९", "content_sanskrit": "वासोभिः पीतकौशेयैर्भूषणैश्च महाधनैः।\nअर्हयित्वाऽश्रुपूर्णाक्षो नाशकत् समवेक्षितुम्॥ १०/८४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.032.m4a", "display_order": 33}, {"id": 6000280033, "chapter_id": 10280, "verse_number": "१०-८४-३०", "content_sanskrit": "इत्थं सभाजितं वीक्ष्य सर्वे प्राञ्जलयो जनाः।\nनमो जयेति नेमुस्तं खात् पेतुः पुष्पवृष्टयः॥ १०/८४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.033.m4a", "display_order": 34}, {"id": 6000280034, "chapter_id": 10280, "verse_number": "१०-८४-३१", "content_sanskrit": "इत्थं निशम्य दमघोषसुतः स्वपीठादुत्थाय कृष्णगुणवर्णनजातमन्युः।\nउत्क्षिप्य बाहुमिदमाह सदस्यमर्षात् संश्रावयन् भगवते परुषाण्यभीतः॥ १०/८४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.034.m4a", "display_order": 35}, {"id": 6000280035, "chapter_id": 10280, "verse_number": "१०-८४-३२", "content_sanskrit": "ईशो दुरत्ययः काल इति सत्यवती श्रुतिः।\nवृद्धानामपि यद् बुद्धिर्बालवाक्यैर्विभिद्यते॥ १०/८४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.035.m4a", "display_order": 36}, {"id": 6000280036, "chapter_id": 10280, "verse_number": "१०-८४-३३", "content_sanskrit": "यूयं पात्रविदां श्रेष्ठा मा मन्ध्वं बालभाषितम्।\nसदसस्पतयः सर्वे कृष्णो यत् सम्मतोऽर्हणे॥ १०/८४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.036.m4a", "display_order": 37}, {"id": 6000280037, "chapter_id": 10280, "verse_number": "१०-८४-३४", "content_sanskrit": "तपोविद्याव्रतधरान् ज्ञानविध्वस्तकल्मषान्।\nपरमर्षीन् ब्रह्मनिष्ठान् लोकपालांश्च पूजितान्॥ १०/८४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.037.m4a", "display_order": 38}, {"id": 6000280038, "chapter_id": 10280, "verse_number": "१०-८४-३५", "content_sanskrit": "सदसस्पतीनतिव्रज्य गोपोऽयं कुलपांसनः।\nयथा काकः पुरोडाशं सपर्यां कथमर्हति॥ १०/८४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.038.m4a", "display_order": 39}, {"id": 6000280039, "chapter_id": 10280, "verse_number": "१०-८४-३६", "content_sanskrit": "वर्णाश्रमकुलापेतः सर्वधर्मबहिष्कृतः।\nस्वैरवर्ती गुणैर्हीनः सपर्यां कथमर्हति॥ १०/८४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.039.m4a", "display_order": 40}, {"id": 6000280040, "chapter_id": 10280, "verse_number": "१०-८४-३७", "content_sanskrit": "ययातिनैषां हि कुलं शप्तं सद्भिर्विगर्हितम्।\nवृथा पानरतं मत्तं सपर्यां कथमर्हति॥ १०/८४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.040.m4a", "display_order": 41}, {"id": 6000280041, "chapter_id": 10280, "verse_number": "१०-८४-३८", "content_sanskrit": "ब्रह्मर्षिसेवितान् देशान् हित्वैतेऽब्रह्मवर्चसः।\nसमुद्रं दुर्गमाश्रित्य बाधन्ते दस्यवः प्रजाः॥ १०/८४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.041.m4a", "display_order": 42}, {"id": 6000280042, "chapter_id": 10280, "verse_number": "१०-८४-३९", "content_sanskrit": "एवमादीन्यभद्राणि बभाषे नष्टमङ्गलः।\nनोवाच किञ्चिद् भगवान् यथा सिंहः शिवारुतम्॥ १०/८४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.042.m4a", "display_order": 43}, {"id": 6000280043, "chapter_id": 10280, "verse_number": "१०-८४-४०", "content_sanskrit": "भगवन्निन्दनं श्रुत्वा दुःसहं तत्सभासदः।\nकर्णौ पिधाय निर्जग्मुः शपन्तश्चेदिपं रुषा॥ १०/८४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.043.m4a", "display_order": 44}, {"id": 6000280044, "chapter_id": 10280, "verse_number": "१०-८४-४१", "content_sanskrit": "निन्दां भगवतः शृण्वन् तत्परस्य जनस्य च।\nततो नापैति यः सोऽपि यात्यधः सुकृताच्च्युतः॥ १०/८४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.044.m4a", "display_order": 45}, {"id": 6000280045, "chapter_id": 10280, "verse_number": "१०-८४-४२", "content_sanskrit": "ततः पाण्डुसुताः क्रुद्धा मत्स्यकैकेयसृञ्जयाः।\nउदायुधाः समुत्तस्थुः शिशुपालजिघांसवः॥ १०/८४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.045.m4a", "display_order": 46}, {"id": 6000280046, "chapter_id": 10280, "verse_number": "१०-८४-४३", "content_sanskrit": "ततश्चैद्यस्त्वसम्भ्रान्तो जगृहे खड्गचर्मणी।\nभर्त्सयन् कृष्णपक्षीयान् राज्ञः सदसि भारत॥ १०/८४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.046.m4a", "display_order": 47}, {"id": 6000280047, "chapter_id": 10280, "verse_number": "१०-८४-४४", "content_sanskrit": "तावदुत्थाय भगवांस्तान् निवार्य स्वयं रुषा।\nशिरः क्षुरान्तचक्रेण जहारापततो रिपोः॥ १०/८४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.047.m4a", "display_order": 48}, {"id": 6000280048, "chapter_id": 10280, "verse_number": "१०-८४-४५", "content_sanskrit": "शब्दः कोलाहलोऽथासीच्छिशुपाले हते महान्।\nतत्राततायिनो भूपा दुद्रुवुर्जीवितैषिणः॥ १०/८४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.048.m4a", "display_order": 49}, {"id": 6000280049, "chapter_id": 10280, "verse_number": "१०-८४-४६", "content_sanskrit": "चैद्यदेहोत्थितं ज्योतिर्वासुदेवमुपाविशत्।\nपश्यतां सर्वभूतानामुल्केव भुवि खाच्च्युता॥ १०/८४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.049.m4a", "display_order": 50}, {"id": 6000280050, "chapter_id": 10280, "verse_number": "१०-८४-४७", "content_sanskrit": "जन्मत्रयानुगुणितवैरसंरब्धया धिया।\nध्यायंस्तन्मयतां यातो भावो हि भवकारणम्॥ १०/८४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.050.m4a", "display_order": 51}, {"id": 6000280051, "chapter_id": 10280, "verse_number": "१०-८४-४८", "content_sanskrit": "वर्णितं तदुपाख्यानं मया ते बहुविस्तरम्।\nवैकुण्ठवासिनोर्जन्म विप्रशापात् पुनः पुनः॥ १०/८४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.051.m4a", "display_order": 52}, {"id": 6000280052, "chapter_id": 10280, "verse_number": "१०-८४-४९", "content_sanskrit": "ऋत्विग्भ्यः ससदस्येभ्यो दक्षिणां विपुलामदात्।\nसर्वान् सम्पूज्य विधिवच्चक्रेऽवभृथमेकराट्॥ १०/८४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.052.m4a", "display_order": 53}, {"id": 6000280053, "chapter_id": 10280, "verse_number": "१०-८४-५०", "content_sanskrit": "साधयित्वा क्रतुं राज्ञः कृष्णो योगेश्वरेश्वरः।\nहत्वा च चेदिपं तत्र विजहार यथासुखम्॥ १०/८४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.053.m4a", "display_order": 54}, {"id": 6000280054, "chapter_id": 10280, "verse_number": "१०-८४-५१", "content_sanskrit": "राजसूयावभृथ्येन स्नातो राजा युधिष्ठिरः।\nब्रह्मक्षत्रसभामध्ये शुशुभे सुरराडिव॥ १०/८४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.054.m4a", "display_order": 55}, {"id": 6000280055, "chapter_id": 10280, "verse_number": "१०-८४-५२", "content_sanskrit": "राज्ञा सभाजिताः सर्वे सुरमानवखेचराः।\nकृष्णं क्रतुं च शंसन्तः स्वधामानि मुदा ययुः॥ १०/८४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.055.m4a", "display_order": 56}, {"id": 6000280056, "chapter_id": 10280, "verse_number": "१०-८४-५३", "content_sanskrit": "य इदं कीर्तयेद्विष्णुं कर्म चैद्यवधादिकम्।\nराज्ञां मोक्षविधानञ्च सर्वपापैः प्रमुच्यते॥ १०/८४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_084/BhP_10.084.056.m4a", "display_order": 57}, {"id": 6000280057, "chapter_id": 10280, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे चतुरशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]