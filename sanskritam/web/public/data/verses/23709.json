[{"id": 7003709000, "chapter_id": 23709, "verse_number": "१-४-१७-१", "content_sanskrit": "सूत उवाच ।\nइति श्रुत्वास्य वचनं मार्कंडेयोऽभ्यभाषत ।\nमार्कंडेय उवाच ।\nश्रुतमेव मया देव श्रोतव्यं भवतो मुखात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003709001, "chapter_id": 23709, "verse_number": "१-४-१७-२", "content_sanskrit": "तथापि कौतुकेनाहमाक्रांतो मुनयोऽप्यमी ।\nगौर्या कथं तपस्तप्तं महादेव्यात्र कथ्यताम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003709002, "chapter_id": 23709, "verse_number": "१-४-१७-३", "content_sanskrit": "नंदिकेश्वर उवाच ।\nकथयामि तदप्येतद्यथाऽधिगतमात्मना ।\nशृणु त्वमवधानेन मार्कंडेय महामते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003709003, "chapter_id": 23709, "verse_number": "१-४-१७-४", "content_sanskrit": "ननु जानासि तत्पूर्वं यथा दाक्षायणी शिवः ।\nउपयेमे सतीं नाम सतीनामधिदेवताम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003709004, "chapter_id": 23709, "verse_number": "१-४-१७-५", "content_sanskrit": "यथा च सा क्रुधा भर्तुर्द्रुहि दक्षप्रजापतौ ।\nयोगादहासीदात्मीयं वपुरित्यपि ते श्रुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003709005, "chapter_id": 23709, "verse_number": "१-४-१७-६", "content_sanskrit": "तदा हराज्ञानिघ्नेन वीरभद्रेण यत्कृतम् ।\nअध्वरध्वंसनं दक्षस्यापि ते विदितं महत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003709006, "chapter_id": 23709, "verse_number": "१-४-१७-७", "content_sanskrit": "अश्रौषीस्तस्य दक्षस्य गणैः शीर्षासखंडनम् ।\nब्रह्माच्युतेंद्रमुख्यानां देवानामपि शिक्षणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003709007, "chapter_id": 23709, "verse_number": "१-४-१७-८", "content_sanskrit": "दंतघातं रवेः पाणिपाटनं जातवेदसः ।\nअदितिप्रभृतीनां च दिव्यस्त्रीणां पराभवम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003709008, "chapter_id": 23709, "verse_number": "१-४-१७-९", "content_sanskrit": "सा च देवी पुनर्जन्म लेभे हिमवतो गृहे ।\nउमेति पार्वतीत्याख्यां द्वितीयां विभ्रती पुनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003709009, "chapter_id": 23709, "verse_number": "१-४-१७-१०", "content_sanskrit": "देवः स्थाणुवने तां च परिचर्यापरं रहः ।\nअरुरोचयिषुः काममधाक्षीत्कालवह्निना ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003709010, "chapter_id": 23709, "verse_number": "१-४-१७-११", "content_sanskrit": "जितेंद्रियं च तं देवं क्वापि यातं गणैः सह ।\nतपोभिस्तोषयामास गौरी शिखरवासिनी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003709011, "chapter_id": 23709, "verse_number": "१-४-१७-१२", "content_sanskrit": "उपयम्याथ तां देवो वृत्तांतैश्चित्तखंडिभिः ।\nरमयामास चैकांते मोदस्वेति विलासिनीम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003709012, "chapter_id": 23709, "verse_number": "१-४-१७-१३", "content_sanskrit": "वैधव्यखिन्नया रत्या प्रार्थिता शैलनंदिनी ।\nकामपीठे तपस्यंती कामं प्रत्युददीपयत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003709013, "chapter_id": 23709, "verse_number": "१-४-१७-१४", "content_sanskrit": "पुनश्च मेनया मात्रा पित्रा च हिमभूभृता ।\nआनीता भवनं भर्त्रा साकं चिरमरंस्त सा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003709014, "chapter_id": 23709, "verse_number": "१-४-१७-१५", "content_sanskrit": "तदा शुंभनिशुंभाख्यौ लेभाते वेधसो वरम् ।\nदेवदानवमर्त्येषु मास्तु नौ पुरुषान्मृतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003709015, "chapter_id": 23709, "verse_number": "१-४-१७-१६", "content_sanskrit": "इति तद्वचनं श्रुत्वा जातत्रासैः सुपर्वभिः ।\nअभ्यर्थितोऽवदद्देवो रहश्चक्रधरादिभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003709016, "chapter_id": 23709, "verse_number": "१-४-१७-१७", "content_sanskrit": "माभैष्ट भद्र कालेन तथा प्रतिविधीयते ।\nयथा निषूदितौ स्यातां तादृशौ दानवाविति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003709017, "chapter_id": 23709, "verse_number": "१-४-१७-१८", "content_sanskrit": "दत्ताभयान्मुकुंदादीन्विसृज्यांधकसूदनः ।\nअंतःपुरगतो रेमे देव्या सह यथा पुरा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003709018, "chapter_id": 23709, "verse_number": "१-४-१७-१९", "content_sanskrit": "कदाचिन्मर्मलक्ष्येण प्रीत्या कालीति निंदिता ।\nतस्य प्रीत्यै कालिका च त्वचमेवाजहान्निजाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003709019, "chapter_id": 23709, "verse_number": "१-४-१७-२०", "content_sanskrit": "यत्रोत्क्षिप्तवती चर्म स्वेच्छया परमेश्वरी ।\nमहाकाशीप्रपाताख्यं तदभूत्क्षेत्रमुत्तमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003709020, "chapter_id": 23709, "verse_number": "१-४-१७-२१", "content_sanskrit": "सा च त्वक्कौशिकी नाम्ना काली विंध्याद्रिवासिनी ।\nतपस्यंती वृषस्यंतौ तो जघान महासुरौ ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003709021, "chapter_id": 23709, "verse_number": "१-४-१७-२२", "content_sanskrit": "देवी च गौरी शिखरे तस्मिन्नेव मनोहरे ।\nतपोभिर्लब्धगौरीत्वाद्भर्त्तारं समतोषयत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003709022, "chapter_id": 23709, "verse_number": "१-४-१७-२३", "content_sanskrit": "क्रमेण दौर्हृदवती भूत्वा प्रासूत पार्वती ।\nगजाननं च हेरंबं सेनान्यं च षडाननम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003709023, "chapter_id": 23709, "verse_number": "१-४-१७-२४", "content_sanskrit": "तौ चागमविदः प्राहुर्नारायणचतुर्मुखौ ।\nपूर्वापराधशुद्ध्यर्थं देवीगर्भसमुद्भवौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003709024, "chapter_id": 23709, "verse_number": "१-४-१७-२५", "content_sanskrit": "वर्धमानौ च तौ बालौ पित्रोरालोकमानयोः ।\nमग्नयोरिव वर्षाब्धौ प्रेमग्रंथिरभूद्दृढा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003709025, "chapter_id": 23709, "verse_number": "१-४-१७-२६", "content_sanskrit": "जातु वीणानिनादेन कदाचिच्चित्रलेखनैः ।\nविजह्रतुश्शिवौ स्वैरमेकदा मंडनैर्मिथः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003709026, "chapter_id": 23709, "verse_number": "१-४-१७-२७", "content_sanskrit": "जातु विद्यागमालापैः कदाचिच्चित्रवस्तुभिः ।\nएकदा लोकवृत्तांतैर्दंपतिभ्यां विनोदितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003709027, "chapter_id": 23709, "verse_number": "१-४-१७-२८", "content_sanskrit": "पुष्पावचयनैर्जातु कदाचिद्वारिखेलनैः ।\nअदीव्यतां च रागार्द्रौ दोलाकेलिभिरेकदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003709028, "chapter_id": 23709, "verse_number": "१-४-१७-२९", "content_sanskrit": "मैनाकेनार्चितौ जातु मेनया जातु पूजितौ ।\nजात्वर्हितौ हिमवता दंपती तौ विनोदितौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003709029, "chapter_id": 23709, "verse_number": "१-४-१७-३०", "content_sanskrit": "जातु द्यूतविनोदेन गतिगोष्ठ्या कदाचन ।\nएकदा दानलीलाभिः शिवौ चिक्रीडतुश्चिरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003709030, "chapter_id": 23709, "verse_number": "१-४-१७-३१", "content_sanskrit": "द्यूतनिर्जितमाच्छिद्य पत्युरुत्संगतां गतम् ।\nवलयीकृतमेणांकं ताटंकीकृतवत्युमा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003709031, "chapter_id": 23709, "verse_number": "१-४-१७-३२", "content_sanskrit": "इति तौ पितरौ चराचराणां निवसंतौ कनकाचलादिकेषु ।\nरुचिरेषु पदेषु कामभोगानतिहृद्यान्सुचिरं किलान्वभूताम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003709032, "chapter_id": 23709, "verse_number": "१-४-१७-३३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्य उत्तरार्धे शिवपार्वतीविहारवर्णनंनाम सप्तदशोऽध्यायः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]