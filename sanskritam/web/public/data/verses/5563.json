[{"id": 2213604, "chapter_id": 5563, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213605, "chapter_id": 5563, "verse_number": "१", "content_sanskrit": "ततस्ते पुरुषश्रेष्ठाः समाजग्मुः परस्परम् ।\nविगतक्रोधमात्सर्याः सर्वे विगतकल्मषाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213606, "chapter_id": 5563, "verse_number": "२", "content_sanskrit": "विधिं परममास्थाय ब्रह्मर्षिविहितं शुभम् ।\nसंहृष्टमनसः सर्वे देवलोक इवामराः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213607, "chapter_id": 5563, "verse_number": "३", "content_sanskrit": "पुत्रः पित्रा च मात्रा च भार्याश्च पतिभिः सह ।\nभ्रात्रा भ्राता सखा चैव सख्या राजन् समागताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213608, "chapter_id": 5563, "verse_number": "४", "content_sanskrit": "पाण्डवास्तु महेष्वासं कर्णं सौभद्रमेव च ।\nसम्प्रहर्षात् समाजग्मुर्द्रौपदेयांश्च सर्वशः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213609, "chapter_id": 5563, "verse_number": "५", "content_sanskrit": "ततस्ते प्रीयमाणा वै कर्णेन सह पाण्डवाः ।\nसमेत्य पृथिवीपाल सौहृदे च स्थिताऽभवन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213610, "chapter_id": 5563, "verse_number": "६", "content_sanskrit": "परस्परं समागम्य योधास्ते भरतर्षभ ।\nमुनेः प्रसादात् ते ह्येवं क्षत्रिया नष्टमन्यवः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213611, "chapter_id": 5563, "verse_number": "७", "content_sanskrit": "असौहृदं परित्यज्य सौहृदे पर्यवस्थिताः ।\nएवं समागताः सर्वे गुरुभिर्बान्धवैः सह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213612, "chapter_id": 5563, "verse_number": "८", "content_sanskrit": "पुत्रैश्च पुरुषव्याघ्राः कुरवोऽन्ये च पार्थिवाः ।\nतां रात्रिमखिलामेवं विहृत्य प्रीतमानसाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213613, "chapter_id": 5563, "verse_number": "९", "content_sanskrit": "मेनिरे परितोषेण नृपाः स्वर्गसदो यथा ।\nनात्र शोको भयं त्रासो नारतिर्नायशोऽभवत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213614, "chapter_id": 5563, "verse_number": "१०", "content_sanskrit": "परस्परं समागम्य योधानां भरतर्षभ ।\nसमागतास्ताः पितृभिर्भ्रातृभिः पतिभिः सुतैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213615, "chapter_id": 5563, "verse_number": "११", "content_sanskrit": "मुदं परमिकां प्राप्य नार्यो दुःखमथात्यजन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213616, "chapter_id": 5563, "verse_number": "१२", "content_sanskrit": "देवलोकं गता ये च ये च ब्रह्मसदो गताः ।\nये चापि वारुणं लोकं ये च गोलोकमाश्रिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213617, "chapter_id": 5563, "verse_number": "१३", "content_sanskrit": "तथा वैवस्वतं लोकं ये च यक्षानुपागताः ।\nराक्षसांश्च पिशाचांश्च कुरूंश्चापि तथोत्तरान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213618, "chapter_id": 5563, "verse_number": "१४", "content_sanskrit": "विचित्राश्च गतीरन्ये ये प्राप्ताः कर्मभिर्नराः ।\n(सर्वे ते तद्वयोरूपवेषास्तत्र समभ्ययुः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213619, "chapter_id": 5563, "verse_number": "१५", "content_sanskrit": "एकां रात्रिं विहृत्यैवं ते वीरास्ताश्च योषितः ।\nआमन्त्र्यान्योन्यमाश्लिष्य ततो जग्मुर्यथागतम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213620, "chapter_id": 5563, "verse_number": "१६", "content_sanskrit": "ततो विसर्जयामास लोकांस्तान् मुनिपुङ्गवः ।\nक्षणेनान्तर्हिताश्चैव प्रेक्षतामेव तेऽभवन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213621, "chapter_id": 5563, "verse_number": "१७", "content_sanskrit": "अवगाह्य महात्मानः पुण्यां भागीरथीं नदीम् ।\nसरथाः सध्वजाश्चैव स्वानि वेश्मानि भेजिरे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213622, "chapter_id": 5563, "verse_number": "१८", "content_sanskrit": "देवलोकं ययुः केचित् केचिद् ब्रह्मसदस्तथा ।\nकेचिच्च वारुणं लोकं केचित् कौबेरमाप्नुवन्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213623, "chapter_id": 5563, "verse_number": "१९", "content_sanskrit": "ततो वैवस्वतं लोकं केचिच्चैवाप्नुवन्नृपाः ।\nराक्षसानां पिशाचानां केचिच्चाप्युत्तरान् कुरून्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213624, "chapter_id": 5563, "verse_number": "२०", "content_sanskrit": "विचित्रगतयः सर्वे यानवाप्यामरैः सह ।)\nआजग्मुस्ते महात्मानः सवाहाः सपदानुगाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213625, "chapter_id": 5563, "verse_number": "२१", "content_sanskrit": "गतेषु तेषु सर्वेषु सलिलस्थो महामुनिः ।\nधर्मशीलो महातेजाः कुरूणां हितकृत्तदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213626, "chapter_id": 5563, "verse_number": "२२", "content_sanskrit": "ततः प्रोवाच ताः सर्वाः क्षत्रिया निहतेश्वराः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213627, "chapter_id": 5563, "verse_number": "२३", "content_sanskrit": "यायाः पतिकृतान् लोकानिच्छन्ति परमस्त्रियः ।\nता जाह्नवीजलं क्षिप्रमवगाहन्त्वतन्द्रिताः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213628, "chapter_id": 5563, "verse_number": "२४", "content_sanskrit": "ततस्तस्य वचः श्रुत्वा श्रद्दधाना वराङ्गनाः ।\nश्वशुरं समनुज्ञाप्य विविशुर्जाह्नवीजलम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213629, "chapter_id": 5563, "verse_number": "२५", "content_sanskrit": "विमुक्ता मानुषैर्देहैस्ततस्ता भर्तृभिः सह ।\nसमाजग्मुस्तदा साध्व्यः सर्वा एव विशाम्पते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213630, "chapter_id": 5563, "verse_number": "२६", "content_sanskrit": "एवं क्रमेण सर्वास्ताः शीलवत्यः पतिव्रताः ।\nप्रविश्य तोयं निर्मुक्ता जग्मुर्भर्तृसलोकताम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213631, "chapter_id": 5563, "verse_number": "२७", "content_sanskrit": "दिव्यरूपसमायुक्ता दिव्याभरणभूषिताः ।\nदिव्यमाल्याम्बरधरा यथाऽऽसां पतयस्तथा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213632, "chapter_id": 5563, "verse_number": "२८", "content_sanskrit": "ताः शीलगुणसम्पन्नाः विमानस्था गतक्लमाः ।\nसर्वाः सर्वगुणोपेताः स्वस्थानं प्रतिपेदिरे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213633, "chapter_id": 5563, "verse_number": "२९", "content_sanskrit": "यस्य यस्य तु यः कामस्तस्मिन् काले बभूव ह ।\nतं तं विसृष्टवान् व्यासो वरदो धर्मवत्सलः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213634, "chapter_id": 5563, "verse_number": "३०", "content_sanskrit": "तच्छ्रुत्वा नरदेवानां पुनरागमनं नराः ।\nजहृषुर्मुदिताश्चासन्नानादेशगता अपि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2213635, "chapter_id": 5563, "verse_number": "३१", "content_sanskrit": "ते नष्टभयसङ्कल्पा नरा विगतकल्मषाः ।\nबभूवुः पौरवाः सर्वे तद् दृष्ट्वाऽऽश्चर्यमुत्तमम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2213636, "chapter_id": 5563, "verse_number": "३२", "content_sanskrit": "(प्रियैः समागमं तेषां यः सम्यक् शृणुयान्नरः ।\nप्रियाणि लभते नित्यमिह च प्रेत्य चैव सः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2213637, "chapter_id": 5563, "verse_number": "३३", "content_sanskrit": "इष्टबान्धवसंयोगमनायासमनामयम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2213638, "chapter_id": 5563, "verse_number": "३४", "content_sanskrit": "यश्चैतच्छ्रावयेद् विद्वान् विदुषो धर्मवित्तमः ।\nस यशः प्राप्नुयाल्लोके परत्र च शुभां गतिम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2213639, "chapter_id": 5563, "verse_number": "३५", "content_sanskrit": "स्वाध्याययुक्ता मनुजास्तपोयुक्ताश्च भारत ।\nसाध्वाचारा दमोपेता दाननिर्धूतकल्मषाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2213640, "chapter_id": 5563, "verse_number": "३६", "content_sanskrit": "ऋजवः शुचयः शान्ता हिंसानृतविवर्जिताः ।\nआस्तिकाः श्रद्दधानाश्च धृतिमन्तश्च मानवाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2213641, "chapter_id": 5563, "verse_number": "३७", "content_sanskrit": "श्रुत्वाऽऽश्चर्यमिदं पर्व ह्यवाप्स्यन्ति परां गतिम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2213642, "chapter_id": 5563, "verse_number": "", "content_sanskrit": "पुनस्ते दर्शनं प्राप्ताः पुनश्च परिकीर्तिताः ।\nपुनः पुनः प्रयच्छन्ति शृण्वतामभयं सदा\t॥३८॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2213643, "chapter_id": 5563, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nएकोनचत्वारिंशोऽध्यायः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2213644, "chapter_id": 5563, "verse_number": "", "content_sanskrit": "पुत्रदर्शनपर्वणि षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]