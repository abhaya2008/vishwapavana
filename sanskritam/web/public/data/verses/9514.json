[{"id": 5000514000, "chapter_id": 9514, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्ताधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000514001, "chapter_id": 9514, "verse_number": "६-१०७-१", "content_sanskrit": "ततः प्रवृत्तं सुक्रूरं रामरावणयोस्तदा।\nसुमहद् द्वैरथं युद्धं सर्वलोकभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000514002, "chapter_id": 9514, "verse_number": "६-१०७-२", "content_sanskrit": "ततो राक्षससैन्यं च हरीणां च महद‍्बलम्।\nप्रगृहीतप्रहरणं निश्चेष्टं समवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000514003, "chapter_id": 9514, "verse_number": "६-१०७-३", "content_sanskrit": "सम्प्रयुद्धौ तु तौ दृष्ट्वा बलवन्नरराक्षसौ।\nव्याक्षिप्तहृदयाः सर्वे परं विस्मयमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000514004, "chapter_id": 9514, "verse_number": "६-१०७-४", "content_sanskrit": "नानाप्रहरणैर्व्यग्रैर्भुजैर्विस्मितबुद्धयः।\nतस्थुः प्रेक्ष्य च संग्रामं नाभिजग्मुः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000514005, "chapter_id": 9514, "verse_number": "६-१०७-५", "content_sanskrit": "रक्षसां रावणं चापि वानराणां च राघवम्।\nपश्यतां विस्मिताक्षाणां सैन्यं चित्रमिवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000514006, "chapter_id": 9514, "verse_number": "६-१०७-६", "content_sanskrit": "तौ तु तत्र निमित्तानि दृष्ट्वा राघवरावणौ।\nकृतबुद्धी स्थिरामर्षौ युयुधाते ह्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000514007, "chapter_id": 9514, "verse_number": "६-१०७-७", "content_sanskrit": "जेतव्यमिति काकुत्स्थो मर्तव्यमिति रावणः।\nधृतौ स्ववीर्यसर्वस्वं युद्धेऽदर्शयतां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000514008, "chapter_id": 9514, "verse_number": "६-१०७-८", "content_sanskrit": "ततः क्रोधाद् दशग्रीवः शरान् संधाय वीर्यवान्।\nमुमोच ध्वजमुद्दिश्य राघवस्य रथे स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000514009, "chapter_id": 9514, "verse_number": "६-१०७-९", "content_sanskrit": "ते शरास्तमनासाद्य पुरंदररथध्वजम्।\nरथशक्तिं परामृश्य निपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000514010, "chapter_id": 9514, "verse_number": "६-१०७-१०", "content_sanskrit": "ततो रामोऽपि संक्रुद्धश्चापमाकृष्य वीर्यवान्।\nकृतप्रतिकृतं कर्तुं मनसा सम्प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000514011, "chapter_id": 9514, "verse_number": "६-१०७-११", "content_sanskrit": "रावणध्वजमुद्दिश्य मुमोच निशितं शरम्।\nमहासर्पमिवासह्यं ज्वलन्तं स्वेन तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000514012, "chapter_id": 9514, "verse_number": "६-१०७-१२", "content_sanskrit": "रामश्चिक्षेप तेजस्वी केतुमुद्दिश्य सायकम्।\nजगाम स महीं छित्त्वा दशग्रीवध्वजं शरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000514013, "chapter_id": 9514, "verse_number": "६-१०७-१३", "content_sanskrit": "स निकृत्तोऽपतद् भूमौ रावणस्यन्दनध्वजः।\nध्वजस्योन्मथनं दृष्ट्वा रावणः स महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000514014, "chapter_id": 9514, "verse_number": "६-१०७-१४", "content_sanskrit": "सम्प्रदीप्तोऽभवत् क्रोधादमर्षात् प्रदहन्निव।\nस रोषवशमापन्नः शरवर्षं ववर्ष ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000514015, "chapter_id": 9514, "verse_number": "६-१०७-१५", "content_sanskrit": "रामस्य तुरगान् दीप्तैः शरैर्विव्याध रावणः।\nते दिव्या हरयस्तत्र नास्खलन्नापि बभ्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000514016, "chapter_id": 9514, "verse_number": "६-१०७-१६", "content_sanskrit": "बभूवुः स्वस्थहृदयाः पद्मनालैरिवाहताः।\nतेषामसम्भ्रमं दृष्ट्वा वाजिनां रावणस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000514017, "chapter_id": 9514, "verse_number": "६-१०७-१७", "content_sanskrit": "भूय एव सुसंक्रुद्धः शरवर्षं मुमोच ह।\nगदाश्च परिघांश्चैव चक्राणि मुसलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000514018, "chapter_id": 9514, "verse_number": "६-१०७-१८", "content_sanskrit": "गिरिशृङ्गाणि वृक्षांश्च तथा शूलपरश्वधान्।\nमायाविहितमेतत् तु शस्त्रवर्षमपातयत्।\nसहस्रशस्तदा बाणानश्रान्तहृदयोद्यमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000514019, "chapter_id": 9514, "verse_number": "६-१०७-१९", "content_sanskrit": "तुमुलं त्रासजननं भीमं भीमप्रतिस्वनम्।\nतद् वर्षमभवद् युद्धे नैकशस्त्रमयं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000514020, "chapter_id": 9514, "verse_number": "६-१०७-२०", "content_sanskrit": "विमुच्य राघवरथं समन्ताद् वानरे बले।\nसायकैरन्तरिक्षं च चकार सुनिरन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000514021, "chapter_id": 9514, "verse_number": "६-१०७-२१", "content_sanskrit": "मुमोच च दशग्रीवो निःसङ्गेनान्तरात्मना।\nव्यायच्छमानं तं दृष्ट्वा तत्परं रावणं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000514022, "chapter_id": 9514, "verse_number": "६-१०७-२२", "content_sanskrit": "प्रहसन्निव काकुत्स्थः संदधे निशितान् शरान्।\nस मुमोच ततो बाणान् शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000514023, "chapter_id": 9514, "verse_number": "६-१०७-२३", "content_sanskrit": "तान् दृष्ट्वा रावणश्चक्रे स्वशरैः खं निरन्तरम्।\nताभ्यां नियुक्तेन तदा शरवर्षेण भास्वता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000514024, "chapter_id": 9514, "verse_number": "६-१०७-२४", "content_sanskrit": "शरबद्धमिवाभाति द्वितीयं भास्वदम्बरम्।\nनानिमित्तोऽभवद् बाणो नानिर्भेत्ता न निष्फलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000514025, "chapter_id": 9514, "verse_number": "६-१०७-२५", "content_sanskrit": "अन्योन्यमभिसंहत्य निपेतुर्धरणीतले।\nतथा विसृजतोर्बाणान् रामरावणयोर्मृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000514026, "chapter_id": 9514, "verse_number": "६-१०७-२६", "content_sanskrit": "प्रायुध्येतामविच्छिन्नमस्यन्तौ सव्यदक्षिणम्।\nचक्रतुश्च शरैर्घोरैर्निरुच्छ्वासमिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000514027, "chapter_id": 9514, "verse_number": "६-१०७-२७", "content_sanskrit": "रावणस्य हयान् रामो हयान् रामस्य रावणः।\nजघ्नतुस्तौ तदान्योन्यं कृतानुकृतकारिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000514028, "chapter_id": 9514, "verse_number": "६-१०७-२८", "content_sanskrit": "एवं तु तौ सुसंक्रुद्धौ चक्रतुर्युद्धमुत्तमम्।\nमुहूर्तमभवद् युद्धं तुमुलं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000514029, "chapter_id": 9514, "verse_number": "६-१०७-२९", "content_sanskrit": "तौ तथा युध्यमानौ तु समरे रामरावणौ।\nददृशुः सर्वभूतानि विस्मितेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000514030, "chapter_id": 9514, "verse_number": "६-१०७-३०", "content_sanskrit": "अर्दयन्तौ तु समरे तयोस्तौ स्यन्दनोत्तमौ।\nपरस्परमभिक्रुद्धौ परस्परमभिद्रुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000514031, "chapter_id": 9514, "verse_number": "६-१०७-३१", "content_sanskrit": "परस्परवधे युक्तौ घोररूपौ बभूवतुः।\nमण्डलानि च वीथीश्च गतप्रत्यागतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000514032, "chapter_id": 9514, "verse_number": "६-१०७-३२", "content_sanskrit": "दर्शयन्तौ बहुविधां सूतौ सारथ्यजां गतिम्।\nअर्दयन् रावणं रामो राघवं चापि रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000514033, "chapter_id": 9514, "verse_number": "६-१०७-३३", "content_sanskrit": "गतिवेगं समापन्नौ प्रवर्तननिवर्तने।\nक्षिपतोः शरजालानि तयोस्तौ स्यन्दनोत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000514034, "chapter_id": 9514, "verse_number": "६-१०७-३४", "content_sanskrit": "चेरतुः संयुगमहीं सासारौ जलदाविव।\nदर्शयित्वा तदा तौ तु गतिं बहुविधां रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000514035, "chapter_id": 9514, "verse_number": "६-१०७-३५", "content_sanskrit": "परस्परस्याभिमुखौ पुनरेव च तस्थतुः।\nधुरं धुरेण रथयोर्वक्त्रं वक्त्रेण वाजिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000514036, "chapter_id": 9514, "verse_number": "६-१०७-३६", "content_sanskrit": "पताकाश्च पताकाभिः समीयुः स्थितयोस्तदा।\nरावणस्य ततो रामो धनुर्मुक्तैः शितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000514037, "chapter_id": 9514, "verse_number": "६-१०७-३७", "content_sanskrit": "चतुर्भिश्चतुरो दीप्तान् हयान् प्रत्यपसर्पयत्।\nस क्रोधवशमापन्नो हयानामपसर्पणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000514038, "chapter_id": 9514, "verse_number": "६-१०७-३८", "content_sanskrit": "मुमोच निशितान् बाणान् राघवाय दशाननः।\nसोऽतिविद्धो बलवता दशग्रीवेण राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000514039, "chapter_id": 9514, "verse_number": "६-१०७-३९", "content_sanskrit": "जगाम न विकारं च न चापि व्यथितोऽभवत्।\nचिक्षेप च पुनर्बाणान् वज्रसारसमस्वनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000514040, "chapter_id": 9514, "verse_number": "६-१०७-४०", "content_sanskrit": "सारथिं वज्रहस्तस्य समुद्दिश्य दशाननः।\nमातलेस्तु महावेगाः शरीरे पतिताः शराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000514041, "chapter_id": 9514, "verse_number": "६-१०७-४१", "content_sanskrit": "न सूक्ष्ममपि सम्मोहं व्यथां वा प्रददुर्युधि।\nतया धर्षणया क्रुद्धो मातलेर्न तथाऽऽत्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000514042, "chapter_id": 9514, "verse_number": "६-१०७-४२", "content_sanskrit": "चकार शरजालेन राघवो विमुखं रिपुम्।\nविंशतिं त्रिंशतिं षष्टिं शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000514043, "chapter_id": 9514, "verse_number": "६-१०७-४३", "content_sanskrit": "मुमोच राघवो वीरः सायकान् स्यन्दने रिपोः।\nरावणोऽपि ततः क्रुद्धो रथस्थो राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000514044, "chapter_id": 9514, "verse_number": "६-१०७-४४", "content_sanskrit": "गदामुसलवर्षेण रामं प्रत्यर्दयद् रणे।\nतत् प्रवृत्तं पुनर्युद्धं तुमुलं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000514045, "chapter_id": 9514, "verse_number": "६-१०७-४५", "content_sanskrit": "गदानां मुसलानां च परिघाणां च निःस्वनैः।\nशराणां पुङ्खवातैश्च क्षुभिताः सप्त सागराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000514046, "chapter_id": 9514, "verse_number": "६-१०७-४६", "content_sanskrit": "क्षुब्धानां सागराणां च पातालतलवासिनः।\nव्यथिता दानवाः सर्वे पन्नगाश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000514047, "chapter_id": 9514, "verse_number": "६-१०७-४७", "content_sanskrit": "चकम्पे मेदिनी कृत्स्ना सशैलवनकानना।\nभास्करो निष्प्रभश्चासीन्न ववौ चापि मारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000514048, "chapter_id": 9514, "verse_number": "६-१०७-४८", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः।\nचिन्तामापेदिरे सर्वे सकिंनरमहोरगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000514049, "chapter_id": 9514, "verse_number": "६-१०७-४९", "content_sanskrit": "स्वस्ति गोब्राह्मणेभ्यस्तु लोकास्तिष्ठन्तु शाश्वताः।\nजयतां राघवः संख्ये रावणं राक्षसेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000514050, "chapter_id": 9514, "verse_number": "६-१०७-५०", "content_sanskrit": "एवं जपन्तोऽपश्यंस्ते देवाः सर्षिगणास्तदा।\nरामरावणयोर्युद्धं सुघोरं रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000514051, "chapter_id": 9514, "verse_number": "६-१०७-५१", "content_sanskrit": "गन्धर्वाप्सरसां सङ्घा दृष्ट्वा युद्धमनूपमम्।\nगगनं गगनाकारं सागरः सागरोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000514052, "chapter_id": 9514, "verse_number": "६-१०७-५२", "content_sanskrit": "रामरावणयोर्युद्धं रामरावणयोरिव।\nएवं ब्रुवन्तो ददृशुस्तद् युद्धं रामरावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000514053, "chapter_id": 9514, "verse_number": "६-१०७-५३", "content_sanskrit": "ततः क्रोधान्महाबाहू रघूणां कीर्तिवर्धनः।\nसंधाय धनुषा रामः शरमाशीविषोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000514054, "chapter_id": 9514, "verse_number": "६-१०७-५४", "content_sanskrit": "रावणस्य शिरोऽच्छिन्दच्छ्रीमज्ज्वलितकुण्डलम्।\nतच्छिरः पतितं भूमौ दृष्टं लोकैस्त्रिभिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000514055, "chapter_id": 9514, "verse_number": "६-१०७-५५", "content_sanskrit": "तस्यैव सदृशं चान्यद् रावणस्योत्थितं शिरः।\nतत् क्षिप्तं क्षिप्रहस्तेन रामेण क्षिप्रकारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000514056, "chapter_id": 9514, "verse_number": "६-१०७-५६", "content_sanskrit": "द्वितीयं रावणशिरश्छिन्नं संयति सायकैः।\nछिन्नमात्रं च तच्छीर्षं पुनरेव प्रदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000514057, "chapter_id": 9514, "verse_number": "६-१०७-५७", "content_sanskrit": "तदप्यशनिसंकाशैश्छिन्नं रामस्य सायकैः।\nएवमेव शतं छिन्नं शिरसां तुल्यवर्चसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000514058, "chapter_id": 9514, "verse_number": "६-१०७-५८", "content_sanskrit": "न चैव रावणस्यान्तो दृश्यते जीवितक्षये।\nततः सर्वास्त्रविद् वीरः कौसल्यानन्दवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000514059, "chapter_id": 9514, "verse_number": "६-१०७-५९", "content_sanskrit": "मार्गणैर्बहुभिर्युक्तश्चिन्तयामास राघवः।\nमारीचो निहतो यैस्तु खरो यैस्तु सदूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000514060, "chapter_id": 9514, "verse_number": "६-१०७-६०", "content_sanskrit": "क्रौञ्चावटे विराधस्तु कबन्धो दण्डकावने।\nयैः साला गिरयो भग्ना वाली च क्षुभितोऽम्बुधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000514061, "chapter_id": 9514, "verse_number": "६-१०७-६१", "content_sanskrit": "त इमे सायकाः सर्वे युद्धे प्रात्ययिका मम।\nकिं नु तत् कारणं येन रावणे मन्दतेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000514062, "chapter_id": 9514, "verse_number": "६-१०७-६२", "content_sanskrit": "इति चिन्तापरश्चासीदप्रमत्तश्च संयुगे।\nववर्ष शरवर्षाणि राघवो रावणोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000514063, "chapter_id": 9514, "verse_number": "६-१०७-६३", "content_sanskrit": "रावणोऽपि ततः क्रुद्धो रथस्थो राक्षसेश्वरः।\nगदामुसलवर्षेण रामं प्रत्यर्दयद् रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000514064, "chapter_id": 9514, "verse_number": "६-१०७-६४", "content_sanskrit": "तत् प्रवृत्तं महद् युद्धं तुमुलं रोमहर्षणम्।\nअन्तरिक्षे च भूमौ च पुनश्च गिरिमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000514065, "chapter_id": 9514, "verse_number": "६-१०७-६५", "content_sanskrit": "देवदानवयक्षाणां पिशाचोरगरक्षसाम्।\nपश्यतां तन्महद् युद्धं सर्वरात्रमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000514066, "chapter_id": 9514, "verse_number": "६-१०७-६६", "content_sanskrit": "नैव रात्रिं न दिवसं न मुहूर्तं न च क्षणम्।\nरामरावणयोर्युद्धं विराममुपगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000514067, "chapter_id": 9514, "verse_number": "६-१०७-६७", "content_sanskrit": "दशरथसुतराक्षसेन्द्रयोस्तयो-\nर्जयमनवेक्ष्य रणे स राघवस्य।\nसुरवररथसारथिर्महात्मा\nरणरतराममुवाच वाक्यमाशु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000514068, "chapter_id": 9514, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमद्युद्धकाण्डे सप्ताधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]