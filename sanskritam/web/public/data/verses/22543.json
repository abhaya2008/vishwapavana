[{"id": 7002543000, "chapter_id": 22543, "verse_number": "१-२०५-१", "content_sanskrit": "व्यास उवाच ।\nपुनर्निबोध मे भीष्म गदतः परमं विधिम् ।\nयेन पूजयते नित्यं महादेवं दिवा करम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002543001, "chapter_id": 22543, "verse_number": "१-२०५-२", "content_sanskrit": "प्रभूतं निर्मलं तेज आराध्य परमं सुखम् ।\nपूर्वमंतस्तथाग्नेय्यां नैरृत्यां पवनालये ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002543002, "chapter_id": 22543, "verse_number": "१-२०५-३", "content_sanskrit": "क्रमेण यावदीशानं हृदि बीजं च विन्यसेत् ।\nभास्करासनमेतत्तु न्यस्तव्यं तत्त्वदर्शिभिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002543003, "chapter_id": 22543, "verse_number": "१-२०५-४", "content_sanskrit": "उपरिष्टात्ततस्तस्य हृदयेन तु पंकजम् ।\nअष्टपत्रं केशरालं पंचवर्णसकेशरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002543004, "chapter_id": 22543, "verse_number": "१-२०५-५", "content_sanskrit": "दीप्तादि पूर्वमारभ्य आमहादेवगोचरम् ।\nशक्त्यष्टकं न्यसेन्मंत्रैरादितः सर्वतोमुखीम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002543005, "chapter_id": 22543, "verse_number": "१-२०५-६", "content_sanskrit": "अबीजैः केसराग्रेषु क्रमेणैव च पूजयेत् ।\nततस्त्वावाहयेद्भानुं स्थापयेत्कर्णिकोपरि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002543006, "chapter_id": 22543, "verse_number": "१-२०५-७", "content_sanskrit": "तस्योपहृत्य तं चान्यं वेदितव्यं खपुष्करम् ।\nतेनैवावाहनं चार्च्य स्थापनं चार्धमेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002543007, "chapter_id": 22543, "verse_number": "१-२०५-८", "content_sanskrit": "पाद्यमाचमनं स्थानं वस्त्रगंधादिभूषणम् ।\nविधिना वीरपुष्पाणि नैवेद्यं धूपमेव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002543008, "chapter_id": 22543, "verse_number": "१-२०५-९", "content_sanskrit": "कर्तव्यं श्रद्धया भक्त्या एवं तुष्यति भास्करः ।\nमहापातकिनोऽप्याशु लभंते चिंतितं फलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002543009, "chapter_id": 22543, "verse_number": "१-२०५-१०", "content_sanskrit": "आदित्यं पूजयित्वा तु पश्चादंगानि पूजयेत् ।\nदीप्तायां हृदयं न्यस्य भवान्या शिरसो न्यसेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002543010, "chapter_id": 22543, "verse_number": "१-२०५-११", "content_sanskrit": "दिग्विदिक्षु न्यसेदस्त्रमिंद्रादि दिशोत्तरांतिकम् ।\nकर्णिकायां न्यसेन्नेत्रं स्वबीजेन तु वार्चयेत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002543011, "chapter_id": 22543, "verse_number": "१-२०५-१२", "content_sanskrit": "पुष्पैर्गंधैश्च धूपैश्च हृदयानि क्रमेण तु ।\nपूजयित्वा तु विधिवद्गर्भं पश्चात्तु मंत्रवित् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002543012, "chapter_id": 22543, "verse_number": "१-२०५-१३", "content_sanskrit": "बाह्यतः पूर्वतो मंदं दक्षिणेन बुधं तथा ।\nविषाणं पश्चिमे पूज्य उत्तरेण तु भार्गवम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002543013, "chapter_id": 22543, "verse_number": "१-२०५-१४", "content_sanskrit": "आग्नेय्यां च कुजं पूज्य नैरृत्यां भानुदेहजम् ।\nवायव्यां पूजयेत्कृष्णमैशान्यां विकचं नृप ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002543014, "chapter_id": 22543, "verse_number": "१-२०५-१५", "content_sanskrit": "इन्द्रादिलोकपालांश्च ततोऽष्टौ पूजयेद्बुधः ।\nसुगंधैर्विविधैः पुष्पैर्धूपैश्चैव मनोरमैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002543015, "chapter_id": 22543, "verse_number": "१-२०५-१६", "content_sanskrit": "क्रमेण पूजयेद्भानुं लोकपालैर्ग्रहैः सह ।\nमंत्रैः कुरुकुलश्रेष्ठ य इच्छेच्छ्रेय आत्मनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002543016, "chapter_id": 22543, "verse_number": "१-२०५-१७", "content_sanskrit": "अनेन विधिना यत्र देवः संपूज्यते रविः ।\nन चौराग्निभयं तत्र न चापि नरकाद्भयम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002543017, "chapter_id": 22543, "verse_number": "१-२०५-१८", "content_sanskrit": "वर्षोपलविषादिभ्यो भयं तत्र न विद्यते ।\nसुखमारोग्यमानंदं सुभिक्षमचलां श्रियम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002543018, "chapter_id": 22543, "verse_number": "१-२०५-१९", "content_sanskrit": "तेजोबिंबांतमध्यस्थ आदित्यः परमार्थतः ।\nयष्टव्यः साधकैर्नित्यं न रथो न च वाजिनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002543019, "chapter_id": 22543, "verse_number": "१-२०५-२०", "content_sanskrit": "इत्येष विधिराख्यातो मया भीष्म तवाखिलः ।\nयेन पूजयते नित्यं महादेवो दिवाकरम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002543020, "chapter_id": 22543, "verse_number": "१-२०५-२१", "content_sanskrit": "इत्थं पूज्य विवस्वन्तं हृद्बीजेन विसर्जयेत् ।\nय एवं पूजयेद्भानुं स याति परमां गतिम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]