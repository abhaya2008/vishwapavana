[{"id": 6000069000, "chapter_id": 10069, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000069001, "chapter_id": 10069, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.001.m4a", "display_order": 2}, {"id": 6000069002, "chapter_id": 10069, "verse_number": "४-५-१", "content_sanskrit": "इत्यध्वरे दक्षमनूद्य शत्रुहन् क्षितावुदीचीं निषसाद शान्तवाक्।\nस्पृष्ट्वा जलं पीतदुकूलसंवृता निमील्य दृग् योगपथं समाविशत्॥ ४/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.002.m4a", "display_order": 3, "topics": [{"text": "योगमार्गेण सतीदेहत्यागः", "range": "१–७"}]}, {"id": 6000069003, "chapter_id": 10069, "verse_number": "४-५-२", "content_sanskrit": "कृत्वा समानावनिलौ जितासना सोदानमुत्थाप्य च नाभिचक्रतः।\nशनैर्हृदि स्थाप्य धियोरसि स्थितं कण्ठाद् भ्रुवोर्मध्यमनिन्दिताऽनयत्॥ ४/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.003.m4a", "display_order": 4}, {"id": 6000069004, "chapter_id": 10069, "verse_number": "४-५-३", "content_sanskrit": "एवं स्वदेहं महतां महीयसा मुहुः समारोपितमङ्कमादरात्।\nजिहासती दक्षरुषा मनस्विनी दधार गात्रेष्वनिलाग्निधारणम्॥ ४/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.004.m4a", "display_order": 5}, {"id": 6000069005, "chapter_id": 10069, "verse_number": "४-५-४", "content_sanskrit": "ततः स्वभर्तुश्चरणाम्बुजासवं जगद्गुरोश्चिन्तयती न चापरम्।\nददर्श देहे हतकल्मषा सती सद्यः प्रजज्वाल समाधिजाग्निना॥ ४/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.005.m4a", "display_order": 6}, {"id": 6000069006, "chapter_id": 10069, "verse_number": "४-५-५", "content_sanskrit": "तत् पश्यतां खे भुवि चाद्भुतं महद् हाहेति वादः सुमहानजायत।\nहन्त प्रिया देवतमस्य देवी जहावसून् केन सती प्रकोपिता॥ ४/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.006.m4a", "display_order": 7}, {"id": 6000069007, "chapter_id": 10069, "verse_number": "४-५-६", "content_sanskrit": "अहो त्वनात्म्यं महदस्य पश्यत प्रजापतेर्यस्य चराचराः प्रजाः।\nजहावसून् यद्विमताऽऽत्मजा सती मनस्विनी मानमभीक्ष्णमर्हती॥ ४/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.007.m4a", "display_order": 8}, {"id": 6000069008, "chapter_id": 10069, "verse_number": "४-५-७", "content_sanskrit": "सोऽयं दुर्मर्षहृदयो ब्रह्मबन्धुर्लोकेऽपकीर्तिं महतीमवाप्स्यति।\nयदङ्गजां स्वां पुरुषद्विडुद्यतां न प्रत्यषेधन्मृतयेऽपराधतः॥ ४/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.008.m4a", "display_order": 9}, {"id": 6000069009, "chapter_id": 10069, "verse_number": "४-५-८", "content_sanskrit": "दक्षस्तु दृष्ट्वा दुहितुः स्वनिमित्तं विनाशनम्।\nबह्वतप्यत घोरेण मयाऽसाधु कृतं बत॥ ४/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.009.m4a", "display_order": 10, "topics": [{"text": "दक्षेण स्वकृतापराधस्य पश्चात्तापः", "range": "८–१३"}]}, {"id": 6000069010, "chapter_id": 10069, "verse_number": "४-५-९", "content_sanskrit": "धिङ् मामविजितात्मानं निर्गुणं निरपत्रपम्।\nयोऽहं स्वीकृत्य मृतकं व्यर्थमेनो महीयसि॥ ४/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.010.m4a", "display_order": 11}, {"id": 6000069011, "chapter_id": 10069, "verse_number": "४-५-१०", "content_sanskrit": "वदत्येवमजे सत्या दृष्ट्वाऽसुत्यागमद्भुतम्।\nदक्षं सुपार्षदा हन्तुमुदतिष्ठन्नुदायुधाः॥ ४/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.011.m4a", "display_order": 12}, {"id": 6000069012, "chapter_id": 10069, "verse_number": "४-५-११", "content_sanskrit": "तेषामापततां वेगं निशाम्य भगवान् भृगुः।\nयज्ञघ्नघ्नेन यजुषा दक्षिणाग्नौ जुहाव ह॥ ४/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.012.m4a", "display_order": 13}, {"id": 6000069013, "chapter_id": 10069, "verse_number": "४-५-१२", "content_sanskrit": "अध्वर्युणा हूयमाने देवा उत्पेतुरोजसा।\nऋभवो नाम तपसा सोमं प्राप्ताः सहस्रशः॥ ४/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.013.m4a", "display_order": 14}, {"id": 6000069014, "chapter_id": 10069, "verse_number": "४-५-१३", "content_sanskrit": "तैरलातायुधैः सर्वे प्रमथाः सहगुह्यकाः।\nहन्यमाना दिशो भेजुरुशद्भिर्ब्रह्मतेजसा॥ ४/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_005/BhP_04.005.014.m4a", "display_order": 15}, {"id": 6000069015, "chapter_id": 10069, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]