[{"id": 7003342000, "chapter_id": 23342, "verse_number": "२-३७-१", "content_sanskrit": "सनत्कुमारा उवाच  ।\nअथातः संप्रवक्ष्यामि तिलधेनुविधिक्रमम् ।\nपूर्वोक्तमंडपे कुर्याच्छिवपूजां तु पश्चिमे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003342001, "chapter_id": 23342, "verse_number": "२-३७-२", "content_sanskrit": "तस्याग्रे मध्यतो भूमौ पद्ममालिख्य शोभनम् ।\nवस्त्रैराच्छादितं पद्मं तन्मध्ये विन्यसेच्छुभम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003342002, "chapter_id": 23342, "verse_number": "२-३७-३", "content_sanskrit": "तिलपुष्पं तु कृत्वाथ हेमपद्मं विनिक्षिपेत् ।\nत्रिंशन्निष्केम कर्तव्यं तदर्धार्धेन वा पुनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003342003, "chapter_id": 23342, "verse_number": "२-३७-४", "content_sanskrit": "पंचनिष्केण कर्तव्यं तदर्धान वा पुनः ।\nतमाराध्य विधानेन गंधपुष्पादिभिः क्रमात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003342004, "chapter_id": 23342, "verse_number": "२-३७-५", "content_sanskrit": "पद्मस्योत्तरदिग्भागे विप्रानेकादशन्यसेत् ।\nतानभ्यर्च्य विधानेन गंधपुष्पादिभिः क्रमात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003342005, "chapter_id": 23342, "verse_number": "२-३७-६", "content_sanskrit": "आच्छादनोत्तरासंगं विप्रेभ्यो दापयेत्क्रमात् ।\nउष्णीषं च प्रदातव्यं कुंडलेच विभूषिते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003342006, "chapter_id": 23342, "verse_number": "२-३७-७", "content_sanskrit": "हेमांगुलीयकं दत्त्वा ब्राह्मणेभ्यो विधानतः ।\nएकं दश च वस्त्राणिं तेषामग्रे प्रकीर्य च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003342007, "chapter_id": 23342, "verse_number": "२-३७-८", "content_sanskrit": "तेषु वस्त्रेषु निःक्षिप्यतिलाद्यानि पृथक्पृथक् ।\nकांस्यपात्रं शतपलं विभिद्यैकादशांशकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003342008, "chapter_id": 23342, "verse_number": "२-३७-९", "content_sanskrit": "इक्षुदंडं च दातव्यं ब्राह्मणेभ्यो विशेषतः ।\nगोश्रृगे तु हिरण्येन द्विनीष्केण तु कारयेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003342009, "chapter_id": 23342, "verse_number": "२-३७-१०", "content_sanskrit": "रजतेन तु कर्तव्याः खुरा निष्कद्वयेन तु ।\nएवं पृथक्पृथग् दत्त्वा तत्तिलेषु विनिक्षिपेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003342010, "chapter_id": 23342, "verse_number": "२-३७-११", "content_sanskrit": "रुद्रैकादशमंत्रैस्तु रुद्रेभ्यो दापयेत्तदा ।\nपद्मस्य पूर्वदिग्भागे विप्रान्द्वादश पूजितान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003342011, "chapter_id": 23342, "verse_number": "२-३७-१२", "content_sanskrit": "एतेनैव तु मार्गेण तेषु श्रद्धासमन्वितः ।\nद्वादशाधित्यमंत्रैश्च दापयेदेवमेव च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003342012, "chapter_id": 23342, "verse_number": "२-३७-१३", "content_sanskrit": "पूर्ववद्दक्षिणे भागे विप्रान्षोडश संस्थितान् ।\nमूर्ति विघ्नेशमंत्रैश्च दापयेत्पूर्ववत्पुनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003342013, "chapter_id": 23342, "verse_number": "२-३७-१४", "content_sanskrit": "यजमानेन कर्तव्यं सर्वमेतद्यथाक्रमम् ।\nकेवलं रुद्रदानं वा अदित्येभ्योऽथख वा पुनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003342014, "chapter_id": 23342, "verse_number": "२-३७-१५", "content_sanskrit": "मूर्त्यादीनां च वा देयं यथाविभवविस्तरम् ।\nपद्मं विन्यस्य राजासौ शेषं वा कारयेन्नृपः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003342015, "chapter_id": 23342, "verse_number": "२-३७-१६", "content_sanskrit": "दक्षिणा च प्रदातव्या पंचनिष्केण भूषणम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]