[{"id": 900001645, "chapter_id": 8244, "verse_number": "1.1", "content_sanskrit": "ॐ उषा वा अश्वस्य मेध्यस्य शिरः सूर्यश्चक्षुर्वातः प्राणो व्यात्तमग्निर्वैश्वानरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001646, "chapter_id": 8244, "verse_number": "1.2", "content_sanskrit": "नैवेह किञ्चनाग्र आसीत् मृत्युनैवेदमावृतमासीद् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001647, "chapter_id": 8244, "verse_number": "1.3", "content_sanskrit": "द्वया ह प्राजापत्या देवाश्चासुराश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001648, "chapter_id": 8244, "verse_number": "1.4", "content_sanskrit": "आत्मैवेदमग्र आसीत् पुरुषविधः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001649, "chapter_id": 8244, "verse_number": "1.5", "content_sanskrit": "तद्धेदं तर्ह्यव्याकृतमासीत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001650, "chapter_id": 8244, "verse_number": "1.6", "content_sanskrit": "यत्सप्तान्नानि मेधया तपसाऽजनयत् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001651, "chapter_id": 8244, "verse_number": "1.7", "content_sanskrit": "त्रयं वा इदं नाम रूपं कर्म तेषां नाम्नां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]