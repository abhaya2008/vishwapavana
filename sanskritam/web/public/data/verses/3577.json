[{"id": 2119897, "chapter_id": 3577, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119898, "chapter_id": 3577, "verse_number": "१", "content_sanskrit": "जातस्य भारते वंशे तथा कुन्त्याः सुतस्य च ।\nया वै युक्ता मतिः सेयम् अर्जुनेन प्रदर्शिता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119899, "chapter_id": 3577, "verse_number": "२", "content_sanskrit": "न मृत्योः समयं विद्म रात्रौ वा यदि वा दिवा ।\nनचापि कञ्चिदमरमयुद्धेनापि शुश्रुमः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119900, "chapter_id": 3577, "verse_number": "३", "content_sanskrit": "एतावदेव पुरुषैः कार्यं हृदयतोषणम् ।\nनयेनाबाधदृष्टेन यदुपक्रमते परान् ।\nविनयस्यानपायस्य संयोगे नापराक्रमः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119901, "chapter_id": 3577, "verse_number": "४", "content_sanskrit": "संशयो जायते साम्ये साम्यं तु न भवेद् द्वयोः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119902, "chapter_id": 3577, "verse_number": "५", "content_sanskrit": "ते वयं नयमास्थाय शत्रुदेशसमीपगाः ।\nकथमन्तं न गच्छेम वृक्षस्येव नदीरयाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119903, "chapter_id": 3577, "verse_number": "६", "content_sanskrit": "पररन्ध्रे पराक्रान्तः स्वरन्ध्रावरणे स्थितः ।\nव्यूढानीकस्तु बलवानुपेयाद् बलमुत्तमम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119904, "chapter_id": 3577, "verse_number": "७", "content_sanskrit": "अनभिव्यक्तसम्बन्धाः प्रविष्टाः शत्रुसंसदि ।\nअनवद्यानसम्बन्धान् दृष्ट्वा शत्रून् समीपतः ।\nशत्रुदेशमपाक्रम्य तं कामं प्राप्नुयामहे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119905, "chapter_id": 3577, "verse_number": "८", "content_sanskrit": "एको ह्येव श्रियं नित्यं बिभर्ति भरतर्षभ ।\nअन्तरात्मेव भूतानां तत्क्षये च बलक्षयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119906, "chapter_id": 3577, "verse_number": "९", "content_sanskrit": "अथ चेत् तं निहत्याजौ शेषेणापि समाहताः ।\nप्राप्नुयाम ततः स्वर्गं ज्ञातित्राणपरायणाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119907, "chapter_id": 3577, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119908, "chapter_id": 3577, "verse_number": "१०", "content_sanskrit": "कृष्ण कोऽयं जरासन्धः किंवीर्यः किंपराक्रमः ।\nयत् त्वां स्पृष्ट्वाऽग्निसदृशं न दग्धः शलभो यथा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119909, "chapter_id": 3577, "verse_number": "", "content_sanskrit": "कृष्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119910, "chapter_id": 3577, "verse_number": "११", "content_sanskrit": "शृणु राजन् जरासन्धो यद्वीर्यो यत्पराक्रमः ।\nयथा ह्युपेक्षितोऽस्माभिर्बहुशः कृतकिल्बिषः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119911, "chapter_id": 3577, "verse_number": "१२", "content_sanskrit": "अक्षोहिणीनां तिसॄणामासीत् परमदर्पितः ।\nराजा बृहद्रथो नाम मगधाधिपतिर्नृप\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119912, "chapter_id": 3577, "verse_number": "१३", "content_sanskrit": "रूपवान् वीर्यसम्पन्नः श्रीमानतुळविक्रमः ।\nस राज्यं कारयामास मगधेषु गिरिव्रजे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119913, "chapter_id": 3577, "verse_number": "१४", "content_sanskrit": "नित्यं दीक्षाकृशतनुः शतक्रतुरिवापरः ।\nतेजसा सूर्यसदृशः क्षमया पृथिवीसमः ।\nयश्चान्तकसमः कोपे श्रिया वैश्रवणोपमः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119914, "chapter_id": 3577, "verse_number": "१५", "content_sanskrit": "तस्याभिजनसंयुक्तैर्गणैश्च भरतर्षभ ।\nव्याप्तेयं पृथिवी सर्वा सूर्यस्येव गभस्तिभिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119915, "chapter_id": 3577, "verse_number": "१६", "content_sanskrit": "स काशिराजस्य सुते समाजे भरतर्षभ ।\nउपयेमे महावीर्यो रूपद्रविणसम्मते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119916, "chapter_id": 3577, "verse_number": "१७", "content_sanskrit": "तयोश्चकार समयं मिथः स पुरुषर्षभ ।\nनातिवर्तिष्य इत्येवं पत्नीभ्यां सन्निधौ तदा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119917, "chapter_id": 3577, "verse_number": "१८", "content_sanskrit": "स ताभ्यां शुशुभे राजा पत्नीभ्यां मनुजाधिप ।\nप्रियाभ्यामनुरूपाभ्यां करेणुभ्यामिव द्विपः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119918, "chapter_id": 3577, "verse_number": "१९", "content_sanskrit": "तयोर्मध्यगतश्चापि रराज वसुधाधिपः ।\nगङ्गायमुनयोर्मध्ये मूर्तिमानिव सागरः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119919, "chapter_id": 3577, "verse_number": "२०", "content_sanskrit": "विषयेषु निमग्नस्य तस्य यौवनमत्यगात् ।\nनच वंशकरं पुत्रमासादयति पार्थिवः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119920, "chapter_id": 3577, "verse_number": "२१", "content_sanskrit": "मङ्गलैर्बहुभिर्होमैः पुत्रकामाभिरिष्टिभिः ।\nनाससाद नृपश्रेष्ठः पुत्रं कुलविवर्धनम् ।\nस भार्याभ्यां च सहितो निर्वेदमगमद् भृशम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119921, "chapter_id": 3577, "verse_number": "२२", "content_sanskrit": "राज्यं चापि परित्यज्य तपोवनमथाश्रयत् ।\nसह पौरैः प्रकृतिभिर्नृपभक्त्या विशाम्पते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119922, "chapter_id": 3577, "verse_number": "२३", "content_sanskrit": "अथ काक्षीवतः पुत्रं गौतमस्य महात्मनः ।\nशुश्राव तपसि श्रेष्ठमुदारं चण्डकौशिकम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119923, "chapter_id": 3577, "verse_number": "२४", "content_sanskrit": "यदृच्छयाऽऽगतं तं तु वृक्षमूलमुपाश्रितम् ।\nपत्नीभ्यां सहितो राजा सर्वयत्नैरतोषयत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119924, "chapter_id": 3577, "verse_number": "२५", "content_sanskrit": "बृहद्रथं च स ऋषिर्यथावत् प्रत्यनन्दत ।\nउपविष्टश्च तेनाथ अनुज्ञातो महात्मना\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119925, "chapter_id": 3577, "verse_number": "२६", "content_sanskrit": "तमपृच्छत् तदा विप्रः किमागमनमित्यथ ।\nपौरैरनुगतस्येह पत्नीभ्यां सहितस्य च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119926, "chapter_id": 3577, "verse_number": "२७", "content_sanskrit": "तमुवाच मुनिं राजा भगवन् नास्ति मे सुतः ।\nतादृशस्य च राज्येन वृद्धत्वे किं प्रयोजनम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119927, "chapter_id": 3577, "verse_number": "२८", "content_sanskrit": "सोऽहं तपश्चरिष्यामि पत्नीभ्यां सहितो वने ।\nनाप्रजस्य मुने कीर्तिः स्वर्गश्च न क्षयो भवेत् ।\nएवमुक्तस्य राज्ञा तु मुनेः कारुण्यमागतम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119928, "chapter_id": 3577, "verse_number": "", "content_sanskrit": "चण्डकौशिकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119929, "chapter_id": 3577, "verse_number": "२९", "content_sanskrit": "परितुष्टोऽस्मि ते राजन् वरं वरय सुव्रत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119930, "chapter_id": 3577, "verse_number": "", "content_sanskrit": "कृष्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119931, "chapter_id": 3577, "verse_number": "३०", "content_sanskrit": "ततः सभार्यः प्रणतस्तमुवाच बृहद्रथः ।\nपुत्रदर्शननैराश्याद् बाष्पगद्गदया गिरा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119932, "chapter_id": 3577, "verse_number": "३१", "content_sanskrit": "भगवन् राज्यमुत्सृज्य प्रस्थितस्य तपोवनम् ।\nकिं वरेणाल्पभाग्यस्य किं राज्येनाप्रजस्य मे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119933, "chapter_id": 3577, "verse_number": "३२", "content_sanskrit": "एतच्छ्रुत्वा मुनिर्ध्यानमगमत् क्षुभितेन्द्रियः ।\nतस्यैव चाम्रवृक्षस्य च्छायायां समुपाविशत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119934, "chapter_id": 3577, "verse_number": "३३", "content_sanskrit": "तस्योपविष्टस्य मुनेरुत्सङ्गे निपपात ह ।\nअमारुतमनाविद्धमेकमाम्रफलं किल\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119935, "chapter_id": 3577, "verse_number": "३४", "content_sanskrit": "तत् प्रगृह्य मुनिश्रेष्ठो हृदयेनाभिमन्त्र्य च ।\nराज्ञे ददावप्रतिमं पुत्रसम्प्राप्तिकारकम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119936, "chapter_id": 3577, "verse_number": "३५", "content_sanskrit": "उवाच च महाप्राज्ञस्तं राजानं महामुनिः ।\nगच्छ राजन् कृतार्थोऽसि निवर्तस्व जनाधिप\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2119937, "chapter_id": 3577, "verse_number": "३६", "content_sanskrit": "एष ते तनयो राजन् मा तप्सीस्त्वं तपो वने ।\nप्रजाः पालय धर्मेण एष धर्मो महीक्षिताम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2119938, "chapter_id": 3577, "verse_number": "३७", "content_sanskrit": "यजस्व विविधैर्यज्ञैरिन्द्रं तर्पय चेन्दुना ।\nपुत्रं राज्ये प्रतिष्ठाप्य तत आश्रममाव्रज ।\nअष्टौ वरान् प्रयच्छामि तव पुत्रस्य पार्थिव\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2119939, "chapter_id": 3577, "verse_number": "३८", "content_sanskrit": "ब्रह्मण्यतामजेयत्वं युद्धेषु च तथा रतिम् ।\nप्रियातिथेयतां चैव दीनानामन्ववेक्षणम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2119940, "chapter_id": 3577, "verse_number": "३९", "content_sanskrit": "तथा बलं च सुमहल्लोके कीर्तिं च शाश्वतीम् ।\nअनुरागं प्रजानां च ददौ तस्मै स कौशिकः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2119941, "chapter_id": 3577, "verse_number": "४०", "content_sanskrit": "अनुज्ञातः स ऋषिणा पत्नीभ्यां सहितो नृपः ।\nपौरैरनुगतश्चापि विवेश स्वपुरं पुनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2119942, "chapter_id": 3577, "verse_number": "४१", "content_sanskrit": "यथासमयमाज्ञाय तदा स नृपसत्तमः ।\nद्वाभ्यामेकं फलं प्रादात् पत्नीभ्यां भरतर्षभ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2119943, "chapter_id": 3577, "verse_number": "४२", "content_sanskrit": "मुनेश्च बहुमानेन कालस्य च विपर्ययात् ।\nततश्चाम्रं द्विधा कृत्वा भक्षयामासतुः शुभे\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2119944, "chapter_id": 3577, "verse_number": "४३", "content_sanskrit": "भावित्वादपि चार्थस्य सत्यवाक्यात् तथा मुनेः ।\nतयोः समभवद् गर्भः फलप्राशनसम्भवः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2119945, "chapter_id": 3577, "verse_number": "४४", "content_sanskrit": "दृष्ट्वा नरपतिः श्रीमान् परां मुदमवाप ह ।\nकाले तु समनुप्राप्ते यथासमयमागते ।\nप्रजायेतामुभे राजन् शरीरशकलावुभौ\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2119946, "chapter_id": 3577, "verse_number": "४५", "content_sanskrit": "एकाक्षिबाहुचरणार्धोदरमुखस्फिजौ ।\nदृष्ट्वा शरीरशकलौ दुःखेनापततां स्त्रियौ\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2119947, "chapter_id": 3577, "verse_number": "४६", "content_sanskrit": "उत्पन्ने सहसा तत्र ते भगिन्यौ तदाऽबले ।\nसजीवे प्राणिशकले तत् प्रजाते सुदुःखिते\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2119948, "chapter_id": 3577, "verse_number": "४७", "content_sanskrit": "तयोर्धात्र्यौ सुसंवीते कृत्वा ते गर्भसम्प्लवे ।\nनिष्क्रम्यान्तःपुरद्वारात् समुत्सृज्याशु जग्मतुः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2119949, "chapter_id": 3577, "verse_number": "४८", "content_sanskrit": "दुकूलाभ्यां सुसञ्छन्ने पाण्डराभ्यामुभे तदा ।\nअज्ञाते कस्यचित्त्वेव जहतुस्ते चतुष्पथे\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2119950, "chapter_id": 3577, "verse_number": "४९", "content_sanskrit": "ततो विविशतुस्ते च पुनरन्तःपुरं तदा ।\nकथयामासतुरुभे पत्नीभ्यां ते पृथक् पृथक्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2119951, "chapter_id": 3577, "verse_number": "५०", "content_sanskrit": "ते चतुष्पथनिक्षिप्ते जरा नामाथ राक्षसी ।\nजग्राह मनुजव्याघ्र मांसशोणितभोजना\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2119952, "chapter_id": 3577, "verse_number": "५१", "content_sanskrit": "कर्तुकामा सुखवहे शकले पार्थ राक्षसी ।\nसंयोजयामास तदा विधानबलचोदिता\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2119953, "chapter_id": 3577, "verse_number": "५२", "content_sanskrit": "ते समानीतमात्रेण शकले भरतर्षभ ।\nएकमूर्तिगते वीर कुमारः समपद्यत\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2119954, "chapter_id": 3577, "verse_number": "५३", "content_sanskrit": "ततः सा राक्षसी राजन् विस्मयोत्फुल्ललोचना ।\nन शशाक समुद्धर्तुं वज्रसारमयं शिशुम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2119955, "chapter_id": 3577, "verse_number": "५४", "content_sanskrit": "बालस्ताम्रतळां मुष्टिं कृत्वाऽऽस्ये तु निधाय सः ।\nप्राक्रोशदतिसंरम्भात् सतोय इव तोयदः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2119956, "chapter_id": 3577, "verse_number": "५५", "content_sanskrit": "तेन शब्देन वित्रस्तः सहसाऽन्तःपुरे जनः ।\nनिर्जगाम महाराजन् राज्ञा सह परन्तप\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2119957, "chapter_id": 3577, "verse_number": "५६", "content_sanskrit": "तेऽबले च परिम्लाते पयःपूर्णपयोधरे ।\nनिष्फले पुत्रलाभाय सहसैवाभ्यगच्छताम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2119958, "chapter_id": 3577, "verse_number": "५७", "content_sanskrit": "ते च दृष्ट्वा तथाभूते राज्ञस्तस्येष्टसन्ततिम् ।\nतं च बालं सुबलिनं चिन्तयामास राक्षसी\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2119959, "chapter_id": 3577, "verse_number": "५८", "content_sanskrit": "नार्हामि विषये राज्ञो वसन्ती पुत्रगृद्धिनः ।\nबालं पुत्रमुपादातुं धार्मिकस्य महात्मनः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2119960, "chapter_id": 3577, "verse_number": "५९", "content_sanskrit": "सा तं बालमुपादाय मेघलेखेव भास्करम् ।\nसा कृत्वा मानुषं रूपमुवाच मनुजाधिपम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2119961, "chapter_id": 3577, "verse_number": "६०", "content_sanskrit": "बृहद्रथ सुतस्तेऽयं मद्दत्तः प्रतिगृह्यताम् ।\nतव पत्नीद्वये जातो द्विजातिवरदानतः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2119962, "chapter_id": 3577, "verse_number": "६१", "content_sanskrit": "धात्रीजनपरित्यक्तो मयाऽयं परिरक्षितः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2119963, "chapter_id": 3577, "verse_number": "", "content_sanskrit": "कृष्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2119964, "chapter_id": 3577, "verse_number": "६२", "content_sanskrit": "ततस्ते भरतश्रेष्ठ काशिराजसुते उभे ।\nतं बालमभिलभ्याशु प्रस्रवैरभिषिञ्चताम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2119965, "chapter_id": 3577, "verse_number": "६३", "content_sanskrit": "ततः स राजा संहृष्टः सर्वं तदुपलभ्य वै ।\nअपृच्छन्नवहेमाभां राक्षसीं तामराक्षसीम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2119966, "chapter_id": 3577, "verse_number": "६४", "content_sanskrit": "का त्वं कमलगर्भाभे मम पुत्रप्रदायिनी ।\nकामं प्रब्रूहि कल्याणि देवता प्रतिभासि मे\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2119967, "chapter_id": 3577, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि एकोनविंशतितमोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2119968, "chapter_id": 3577, "verse_number": "१९", "content_sanskrit": "मन्त्रपर्वणि एकोनविंशतितमोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2119969, "chapter_id": 3577, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]