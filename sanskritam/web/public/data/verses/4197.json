[{"id": 2147745, "chapter_id": 4197, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147746, "chapter_id": 4197, "verse_number": "१", "content_sanskrit": "कृष्णस्य तु वचः श्रुत्वा धृतराष्ट्रो जनेश्वरः ।\nविदुरं सर्वधर्मज्ञं त्वरमाणोऽभ्यभाषत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147747, "chapter_id": 4197, "verse_number": "२", "content_sanskrit": "गच्छ तात महाप्राज्ञ गान्धारीं दीर्घदर्शिनीम् ।\nआनयेह तया सार्धमनुनेष्यामि दुर्मतिम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147748, "chapter_id": 4197, "verse_number": "३", "content_sanskrit": "यदि सा न दुरात्मानं शमयेद् दुष्टचेतसम् ।\nअपि कृष्णस्य सुहृदः तिष्ठेम वचने वयम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147749, "chapter_id": 4197, "verse_number": "४", "content_sanskrit": "अपि लोभाभिभूतस्य पन्थानमनुदर्शयेत् ।\nदुर्बुद्धेर्दुःसहायस्य समक्षं ब्रुवती वचः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147750, "chapter_id": 4197, "verse_number": "५", "content_sanskrit": "अपि नो व्यसनं घोरं दुर्योधनकृतं महत् ।\nशमयेच्चिररात्राय योगक्षेमवदव्ययम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147751, "chapter_id": 4197, "verse_number": "६", "content_sanskrit": "राज्ञस्तु वचनं श्रुत्वा विदुरो दीर्घदर्शिनीम् ।\nआनयामास गान्धारीं धृतराष्ट्रस्य शासनात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147752, "chapter_id": 4197, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147753, "chapter_id": 4197, "verse_number": "७", "content_sanskrit": "एष गान्धारि पुत्रस्ते दुरात्मा शासनातिगः ।\nऐश्वर्यलोभादैश्वर्यं जीवितं च प्रहास्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147754, "chapter_id": 4197, "verse_number": "८", "content_sanskrit": "अशिष्टवदमर्यादः पापैः सह दुरात्मभिः ।\nसभाया निर्गतो मूढो व्यतिक्रम्य सुहृद्वचः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147755, "chapter_id": 4197, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147756, "chapter_id": 4197, "verse_number": "९", "content_sanskrit": "सा भर्तृवचनं श्रुत्वा राजपुत्री यशस्विनी ।\nअन्विच्छन्ती महच्छ्रेयो गान्धारी वाक्यमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147757, "chapter_id": 4197, "verse_number": "१०", "content_sanskrit": "आनयैनं सुतं क्षिप्रं राज्यकामुकमातुरम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147758, "chapter_id": 4197, "verse_number": "११", "content_sanskrit": "न हि राज्यमशिष्टेन शक्यं धर्मार्थलोपिना ।\nआप्तुमाप्तं तथाऽपीदमविनीतेन सर्वथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147759, "chapter_id": 4197, "verse_number": "१२", "content_sanskrit": "त्वमेवात्र भृशं गर्ह्यो धृतराष्ट्र सुतप्रियः ।\nयो जानन् पापतामस्य तत्प्रज्ञामनुवर्तसे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147760, "chapter_id": 4197, "verse_number": "१३", "content_sanskrit": "स एष काममन्युभ्यां प्रलब्धो मोहमास्थितः ।\nअशक्योऽद्य त्वया राजन् विनिवर्तयितुं बलात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147761, "chapter_id": 4197, "verse_number": "१४", "content_sanskrit": "राष्ट्रप्रदाने मूढस्य बालिशस्य दुरात्मनः ।\nदुर्योधनस्य लुब्धस्य धृतराष्ट्रोऽश्नुते फलम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147762, "chapter_id": 4197, "verse_number": "१५", "content_sanskrit": "कथं हि स्वजने भेदमुपेक्षेत महीपतिः ।\nभिन्नं हि स्वजनेन त्वां प्रहसिष्यन्ति शत्रवः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147763, "chapter_id": 4197, "verse_number": "१६", "content_sanskrit": "यो हि शक्यो महाराज साम्ना भेदेन वा पुनः ।\nनिस्तर्तुमापदः स्वेषु दण्डं कस्तत्र पातयेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147764, "chapter_id": 4197, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147765, "chapter_id": 4197, "verse_number": "१७", "content_sanskrit": "शासनाद् धृतराष्ट्रस्य दुर्योधनममर्षणम् ।\nमातुश्च वचनात् क्षत्ता सभां प्रावेशयत् पुनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147766, "chapter_id": 4197, "verse_number": "१८", "content_sanskrit": "स मातुर्वचनाकाङ्क्षी प्रविवेश पुनः सभाम् ।\nअतिताम्रेक्षणः क्रोधान्निःश्वसन्निव पन्नगः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147767, "chapter_id": 4197, "verse_number": "१९", "content_sanskrit": "तं प्रविष्टमभिप्रेक्ष्य पुत्रमुत्पथमास्थितम् ।\nविगर्हमाणा गान्धारी शमार्थं वाक्यमब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147768, "chapter_id": 4197, "verse_number": "२०", "content_sanskrit": "दुर्योधन निबोधेदं वचनं मम पुत्रक ।\nहितं ते सानुबन्धस्य तथाऽऽयत्यां सुखोदयम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147769, "chapter_id": 4197, "verse_number": "२१", "content_sanskrit": "दुर्योधन यदाह त्वां पिता भरतसत्तमः ।\nभीष्मो द्रोणः कृपः क्षत्ता सुहृदां कुरु तद्वचः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147770, "chapter_id": 4197, "verse_number": "२२", "content_sanskrit": "भीष्मस्य तु पितुश्चैव मम चापचितिः कृता ।\nभवेद् द्रोणमुखानां च सुहृदां शाम्यता त्वया\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147771, "chapter_id": 4197, "verse_number": "२३", "content_sanskrit": "न हि राज्यं महाप्राज्ञ स्वेन कामेन शक्यते ।\nअवाप्तुं रक्षितुं वाऽपि भोक्तुं भरतसत्तम\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147772, "chapter_id": 4197, "verse_number": "२४", "content_sanskrit": "न ह्यवश्येन्द्रियो राज्यमश्नीयाद् दीर्घमन्तरम् ।\nविजितात्मा तु मेधावी स राज्यमभिपालयेत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147773, "chapter_id": 4197, "verse_number": "२५", "content_sanskrit": "कामक्रोधौ हि पुरुषमर्थेभ्यो व्यपकर्षतः ।\nतौ तु शत्रू विनिर्जित्य राजा विजयते महीम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147774, "chapter_id": 4197, "verse_number": "२६", "content_sanskrit": "लोकेश्वराभिभूतं हि महदेतद् दुरात्मभिः ।\nराज्यं नामेप्सितं स्थानं न शक्यमभिरक्षितुम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147775, "chapter_id": 4197, "verse_number": "२७", "content_sanskrit": "इन्द्रियाणि महत् प्रेप्सुर्नियच्छेदर्थधर्मयोः ।\nइन्द्रियैर्नियतैर्बुद्धिर्वर्धतेऽग्निरिवेन्धनैः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147776, "chapter_id": 4197, "verse_number": "२८", "content_sanskrit": "अविधेयानि हीमानि व्यापादयितुमप्यलम् ।\nअविधेया इवादान्ता हयाः पथिषु सारथिम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2147777, "chapter_id": 4197, "verse_number": "२९", "content_sanskrit": "अविजित्य य आत्मानममात्यान् विजिगीषते ।\nअजितात्माऽजितामात्यः सोऽवशः परिहीयते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2147778, "chapter_id": 4197, "verse_number": "३०", "content_sanskrit": "आत्मानमेव प्रथमं द्वेष्यरूपेण योजयेत् ।\nततोऽमात्यानमित्रांश्च न मोघं विजिगीषते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2147779, "chapter_id": 4197, "verse_number": "३१", "content_sanskrit": "वश्येन्द्रियं जितामात्यं धृतदण्डं विकारिषु ।\nपरीक्ष्यकारिणं वीरमत्यर्थं श्रीर्निषेवते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2147780, "chapter_id": 4197, "verse_number": "३२", "content_sanskrit": "क्षुद्राक्षेणेव जालेन झषावपिहितावुभौ ।\nकामक्रोधौ शरीरस्थौ प्रज्ञानं तौ विलुम्पतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2147781, "chapter_id": 4197, "verse_number": "३३", "content_sanskrit": "याभ्यां हि देवाः स्वर्यातुः स्वर्गस्यापिदधुर्मुखम् ।\nबिभ्यतोऽनुपरागस्य कामक्रोधौ स्म वर्धितौ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2147782, "chapter_id": 4197, "verse_number": "३४", "content_sanskrit": "कामं क्रोधं च लोभं च डम्भं दर्पं च भूमिप ।\nसम्यग्विजेतुं यो वेद स महीमभिजायते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2147783, "chapter_id": 4197, "verse_number": "३५", "content_sanskrit": "सततं निग्रहे युक्त इन्द्रियाणां भवेन्नृपः ।\nईप्सन्नर्थं च धर्मं च द्विषतां च पराभवम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2147784, "chapter_id": 4197, "verse_number": "३६", "content_sanskrit": "कामाभिभूतः क्रोधाद्वा यो मिथ्या प्रतिपद्यते ।\nस्वेषु चान्येषु वा तस्य न सहाया भवन्त्युत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2147785, "chapter_id": 4197, "verse_number": "३७", "content_sanskrit": "एकीभूतैर्महाप्राज्ञैः शूरैररिनिबर्हणैः ।\nपाण्डवैः पृथिवीं तात भोक्ष्यसे सहितः सुखी\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2147786, "chapter_id": 4197, "verse_number": "३८", "content_sanskrit": "यथा भीष्मः शान्तनवो द्रोणश्चापि महायशाः ।\nआहतुस्तात तत् सत्यमजेयौ कृष्णपाण्डवौ\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2147787, "chapter_id": 4197, "verse_number": "३९", "content_sanskrit": "प्रपद्यस्व महाबाहुं कृष्णमक्लिष्टकारिणम् ।\nप्रसन्नो हि सुखाय स्यादुभयोरेव केशवः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2147788, "chapter_id": 4197, "verse_number": "४०", "content_sanskrit": "सुहृदामर्थकामानां यो न तिष्ठति शासने ।\nप्राज्ञानां कृतविद्यानां स नरः शत्रुनन्दनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2147789, "chapter_id": 4197, "verse_number": "४१", "content_sanskrit": "न युद्धे तात कल्याणं न धर्मार्थौ कुतः सुखम् ।\nन चापि विजयो नित्यं मा युद्धे चेत आदधाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2147790, "chapter_id": 4197, "verse_number": "४२", "content_sanskrit": "भीष्मेण हि महाप्राज्ञ पित्रा ते बाह्लिकेन च ।\nदत्तोंऽशः पाण्डुपुत्राणां भेदाद् भीतैररिन्दम\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2147791, "chapter_id": 4197, "verse_number": "४३", "content_sanskrit": "तस्य चैतत् प्रदानस्य फलमद्यानुपश्यसि ।\nयद् भुङ्क्षे पृथिवीं कृत्स्नां शूरैर्निहतकण्टकाम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2147792, "chapter_id": 4197, "verse_number": "४४", "content_sanskrit": "प्रयच्छ पाण्डुपुत्राणां यथोचितमरिन्दम ।\nयदीच्छसि सहामात्यो भोक्तुमर्धमहीमिमाम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2147793, "chapter_id": 4197, "verse_number": "४५", "content_sanskrit": "अलमर्धं पृथिव्यास्ते सहामात्यस्य जीवितुम् ।\nसुहृदां वचने तिष्ठन् यशः प्राप्स्यसि भारत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2147794, "chapter_id": 4197, "verse_number": "४६", "content_sanskrit": "श्रीमद्भिरात्मवद्भिस्तैः बुद्धिमद्भिर्जितेन्द्रियैः ।\nपाण्डवैर्विग्रहस्तात भ्रंशयेन्महतः सुखात्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2147795, "chapter_id": 4197, "verse_number": "४७", "content_sanskrit": "निगृह्य सुहृदां मन्युं शाधि राज्यं यथोचितम् ।\nस्वमंशं पाण्डुपुत्रेभ्यः प्रदाय पुरुषर्षभ\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2147796, "chapter_id": 4197, "verse_number": "४८", "content_sanskrit": "अलं महान् निकारोऽयं त्रयोदशसमाः कृताः ।\nशमयैनं महाप्राज्ञ कामक्रोधसमेधितम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2147797, "chapter_id": 4197, "verse_number": "४९", "content_sanskrit": "न चैष शक्तः पार्थानां यस्त्वदर्थमभीप्सति ।\nसूतपुत्रो दृढक्रोधो भ्राता दुःशासनश्च ते\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2147798, "chapter_id": 4197, "verse_number": "५०", "content_sanskrit": "भीष्मे द्रोणे कृपे कर्णे भीमसेने धनञ्जये ।\nधृष्टद्युम्ने च सङ्क्रुद्धे न स्युः सर्वा प्रजा ध्रुवम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2147799, "chapter_id": 4197, "verse_number": "५१", "content_sanskrit": "अमर्षवशमापन्नो मा कुरुस्तात जीवनः ।\nसर्वा हि पृथिवी तात मा गमत् त्वत्कृते वधम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2147800, "chapter_id": 4197, "verse_number": "५२", "content_sanskrit": "यच्च त्वं मन्यसे मूढ भीष्मद्रोणकृपाः परान् ।\nयोत्स्यन्ते सर्वशक्त्येति नैतदद्योपपद्यते\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2147801, "chapter_id": 4197, "verse_number": "५३", "content_sanskrit": "समं हि राज्यं प्रीतिश्च स्थानं च विदितात्मनाम् ।\nपाण्डवेष्वथ युष्मासु धर्मस्त्वभ्यधिकस्ततः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2147802, "chapter_id": 4197, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2147803, "chapter_id": 4197, "verse_number": "५४", "content_sanskrit": "राजपिण्डभयादेते यदि हास्यन्ति जीवितम् ।\nन हि शक्ष्यन्ति राजानं युधिष्ठिरमुदीक्षितुम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2147804, "chapter_id": 4197, "verse_number": "५५", "content_sanskrit": "न लोभादर्थसम्पत्तिर्नराणामिह दृश्यते ।\nतदलं तात लोभेन प्रशाम्य भरतर्षभ\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2147805, "chapter_id": 4197, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टाविंशोत्तरशततमोऽध्यायः ॥१२८॥\nभगवद्यानपर्वणि एकोनषष्टितमोऽध्यायः ॥५९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]