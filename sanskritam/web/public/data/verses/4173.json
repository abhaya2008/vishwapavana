[{"id": 2146967, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146968, "chapter_id": 4173, "verse_number": "१", "content_sanskrit": "गरुडस्तत्र शुश्राव यथावृत्तं महाबलः ।\nआयुःप्रदानं शक्रेण सुमुखस्य तु भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146969, "chapter_id": 4173, "verse_number": "२", "content_sanskrit": "पक्षवातेन महता रुद्ध्वा त्रिभुवनं खगः ।\nसुपर्णः परमक्रुद्धो वासवं समुपाद्रवत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146970, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146971, "chapter_id": 4173, "verse_number": "३", "content_sanskrit": "भगवन् किमिवाज्ञानात् सुधां प्रति भये मम ।\nकामकारवरं दत्त्वा पुनश्चलितवानसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146972, "chapter_id": 4173, "verse_number": "४", "content_sanskrit": "निसर्गात् सर्वभूतानां सर्वभूतेश्वरेण मे ।\nआहारो विहितो धात्रा किमर्थं वार्यते त्वया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146973, "chapter_id": 4173, "verse_number": "५", "content_sanskrit": "वृतश्चैष महानागः स्थापितः समयश्च मे ।\nअनेन च मया देव भर्तव्यः प्रसवो महान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146974, "chapter_id": 4173, "verse_number": "६", "content_sanskrit": "एतस्मिंस्त्वन्यथा भूते नान्यं हिंसितुमुत्सहे ।\nक्रीडसे कामकारेण देवराज यथेप्सितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146975, "chapter_id": 4173, "verse_number": "७", "content_sanskrit": "सोऽहं प्राणान् विमोक्ष्यामि तथा परिजनो मम ।\nये च भृत्या मम गृहे प्रीतिमान् भव वासव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146976, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146977, "chapter_id": 4173, "verse_number": "८", "content_sanskrit": "श्रुत्वा सुपर्णवचनं सुमुखो दुर्मुखस्तदा ।\nत्यक्त्वा रूपं विवर्णस्तु सर्परूपधरोऽभवत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146978, "chapter_id": 4173, "verse_number": "९", "content_sanskrit": "गत्वा विष्णुसमीपं तु पादपीठं समाश्लिषत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146979, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146980, "chapter_id": 4173, "verse_number": "१०", "content_sanskrit": "न मत्कृतं वैनतेय न मां क्रोद्धुं त्वमर्हसि ।\nदत्ताभयः स सुमुखो विष्णुना प्रभविष्णुना\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146981, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146982, "chapter_id": 4173, "verse_number": "११", "content_sanskrit": "श्रुत्वा पुरन्दरेणोक्तमुवाच विनतासुतः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146983, "chapter_id": 4173, "verse_number": "१२", "content_sanskrit": "एतच्चैवाहमर्हामि भूयश्च बलवृत्रहन् ।\nत्रैलोक्यस्येश्वरो योऽहं परभृत्यत्वमागतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146984, "chapter_id": 4173, "verse_number": "१३", "content_sanskrit": "त्वयि तिष्ठति देवेश न विष्णुः कारणं मम ।\nत्रैलोक्यराजराज्यं हि त्वयि वासव शाश्वतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146985, "chapter_id": 4173, "verse_number": "१४", "content_sanskrit": "ममापि दक्षस्य सुता जननी काश्यपः पिता ।\nअहमप्युत्सहे लोकान् समन्ताद् वोढुमोजसा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146986, "chapter_id": 4173, "verse_number": "१५", "content_sanskrit": "असँह्यं सर्वभूतानां ममापि विपुलं बलम् ।\nमयापि सुमहत् कर्म कृतं दैतेयविग्रहे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146987, "chapter_id": 4173, "verse_number": "१६", "content_sanskrit": "श्रुतश्रीः श्रुतसेनश्च विवस्वान् रोचनामुखः ।\nप्रसहः कालकाङ्क्षश्च मयाऽपि दितिजा हताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146988, "chapter_id": 4173, "verse_number": "१७", "content_sanskrit": "यत्तु ध्वजस्थानगतो यत्नात् परिचराम्यहम् ।\nवहामि चैवानुजं ते तेन मामवमन्यसे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146989, "chapter_id": 4173, "verse_number": "१८", "content_sanskrit": "कोऽन्यो भारसहो ह्यस्ति कोऽन्योऽस्ति बलवत्तरः ।\nमया यो हि विशिष्टः सन् वहामीमं सबान्धवम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146990, "chapter_id": 4173, "verse_number": "१९", "content_sanskrit": "अवज्ञाय तु यत् तेऽहं भोजनादवरोपितः ।\nतेन मे गौरवं नष्टं त्वत्तश्चास्माच्च वासव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146991, "chapter_id": 4173, "verse_number": "२०", "content_sanskrit": "अदित्या य इमे जाता बलविक्रमशालिनः ।\nत्वमेषां किल सर्वेषां विशेषाद् बलवत्तरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146992, "chapter_id": 4173, "verse_number": "२१", "content_sanskrit": "सोऽहं पक्षैकदेशेन वहामि त्वां पराक्रमात् ।\nविमृश त्वं शनैस्तात को न्वत्र बलवानिति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146993, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146994, "chapter_id": 4173, "verse_number": "२२", "content_sanskrit": "स तस्य वचनं श्रुत्वा खगस्योदर्कदारुणम् ।\nअक्षोभ्यं क्षोभयंस्तार्क्ष्यमुवाच रथचक्रभृत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146995, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146996, "chapter_id": 4173, "verse_number": "२३", "content_sanskrit": "गरुत्मन् मन्यसे त्मानं बलवन्तं सुदुर्बलम् ।\nअलमस्मत्समक्षं ते स्तोतुमात्मानमण्डज\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146997, "chapter_id": 4173, "verse_number": "२४", "content_sanskrit": "त्रैलोक्यमपि मे कृत्स्नमशक्तं देहधारणे ।\nअहमेवात्मनाऽऽत्मानं वहामि त्वां च धारये\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146998, "chapter_id": 4173, "verse_number": "२५", "content_sanskrit": "न त्वं वहसि मां दोर्भ्यां मोघं तव विकत्थनम् ।\nइमं तावन्ममैकं त्वं बाहुं सव्येतरं वह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146999, "chapter_id": 4173, "verse_number": "२६", "content_sanskrit": "यद्येनं धारयस्येकं सफलं ते विकत्थनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2147000, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2147001, "chapter_id": 4173, "verse_number": "२७", "content_sanskrit": "इत्युक्त्वा भगवांस्तस्य स्कन्धे बाहुं समासजत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2147002, "chapter_id": 4173, "verse_number": "२८", "content_sanskrit": "आरोपितं समुद्वोढुं भुजं तं नाशकद् बलात् ।\nनिपपात स भारार्तो विह्वलो नष्टचेतनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2147003, "chapter_id": 4173, "verse_number": "२९", "content_sanskrit": "यावान् हि भारः कृत्स्नायाः पृथिव्याः पर्वतैः सह ।\nएकस्या देहशाखायाः तावद् भारममन्यत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2147004, "chapter_id": 4173, "verse_number": "३०", "content_sanskrit": "न चैनं पीडयामास बलेन पुरुषोत्तमः ।\nततो हि जीवितं तस्य न व्यनीनशदच्युतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2147005, "chapter_id": 4173, "verse_number": "३१", "content_sanskrit": "विपक्षः स्रस्तकायश्च विचेता विह्वलः खगः ।\nमुमोच पत्राणि तदा गुरुभारप्रपीडितः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2147006, "chapter_id": 4173, "verse_number": "३२", "content_sanskrit": "स विष्णुं शिरसा पक्षी प्रणम्य विनतासुतः ।\nविचेता विह्वलो दीनः किञ्चिद् वचनमब्रवीत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2147007, "chapter_id": 4173, "verse_number": "३३", "content_sanskrit": "भगवँल्लोकसारस्य सदृशेन वपुष्मता ।\nभुजेन स्वैरमुक्तेन निष्पिष्टोऽस्मि महीतळे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2147008, "chapter_id": 4173, "verse_number": "३४", "content_sanskrit": "क्षन्तुमर्हसि मे देव विह्वलस्याल्पचेतसः ।\nबलदाहविदग्धस्य पक्षिणो ध्वजवासिनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2147009, "chapter_id": 4173, "verse_number": "३५", "content_sanskrit": "न हि ज्ञातं बलं देव मया ते परमं विभो ।\nतेन मन्ये ह्यहं वीर्यमात्मनो न समं परैः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2147010, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2147011, "chapter_id": 4173, "verse_number": "३६", "content_sanskrit": "ततश्चक्रे स भगवान् प्रसादं वै गरुत्मतः ।\nमैवं भूय इति स्नेहात् तदा चैनमुवाच ह\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2147012, "chapter_id": 4173, "verse_number": "३७", "content_sanskrit": "पादाङ्गुष्ठेन चिक्षेप सुमुखं गरुडोरसि ।\nततः प्रभृति राजेन्द्र सह सर्पेण वर्तते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2147013, "chapter_id": 4173, "verse_number": "३८", "content_sanskrit": "एवं विष्णुबलाक्रान्तो गर्वनाशमुपागमत् ।\nगरुडो बलवान् राजन् वैनतेयो महायशाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2147014, "chapter_id": 4173, "verse_number": "३९", "content_sanskrit": "तथा त्वमपि गान्धारे यावत् पाण्डुसुतान् रणे ।\nनासादयसि तान् वीरान् तावज्जीवसि पुत्रक\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2147015, "chapter_id": 4173, "verse_number": "४०", "content_sanskrit": "भीमः प्रहरतां श्रेष्ठो वायुपुत्रो महाबलः ।\nधनञ्जयश्चेन्द्रसुतो निहन्यात् तावकान् रणे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2147016, "chapter_id": 4173, "verse_number": "४१", "content_sanskrit": "विष्णुर्वायुश्च शक्रश्च धर्मस्तावश्विनावुभौ ।\nएते देवास्त्वया केन हेतुना वीक्षितुं क्षमाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2147017, "chapter_id": 4173, "verse_number": "४२", "content_sanskrit": "तदलं ते विरोधेन शमं गच्छ नृपात्मज ।\nवासुदेवेन तीर्थेन कुलं रक्षितुमर्हसि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2147018, "chapter_id": 4173, "verse_number": "४३", "content_sanskrit": "प्रत्यक्षदर्शी सर्वस्य नारदोऽयं महातपाः ।\nमाहात्म्यस्य तदा विष्णोः सोऽयं चक्रगदाधरः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2147019, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2147020, "chapter_id": 4173, "verse_number": "४४", "content_sanskrit": "दुर्योधनस्तु तच्छ्रुत्वा निःश्वसन् भ्रुकुटीमुखः ।\nराधेयमभिसम्प्रेक्ष्य जहास स्वनवत् तदा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2147021, "chapter_id": 4173, "verse_number": "४५", "content_sanskrit": "कदर्थीकृत्य तद्वाक्यम् ऋषेः कण्वस्य दुर्मतिः ।\nऊरुं गजकराकारं ताडयन्निदमब्रवीत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2147022, "chapter_id": 4173, "verse_number": "४६", "content_sanskrit": "यथैवेश्वरसृष्टोऽस्मि तद्भावि या च मे गतिः ।\nतथा महर्षे वर्तामि किं प्रलापः करिष्यति\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2147023, "chapter_id": 4173, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2147024, "chapter_id": 4173, "verse_number": "४७", "content_sanskrit": "ततः कण्वोऽब्रवीत् क्रुद्धो दुर्योधनमपण्डितम् ।\nयस्मादूरुं ताडयसि ऊरौ मृत्युर्भविष्यति\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2147025, "chapter_id": 4173, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुरधिकशततमोऽध्यायः ॥१०४॥\nभगवद्यानपर्वणि पञ्चत्रिंशोऽध्यायः ॥३५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]