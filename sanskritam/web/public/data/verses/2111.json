[{"id": 2050723, "chapter_id": 2111, "verse_number": "७-३८-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050724, "chapter_id": 2111, "verse_number": "७-३८-१", "content_sanskrit": "तथा प्रमथमानं तं महेष्वासानजिह्मगैः।\nआर्जुनिं मामकाः सङ्ख्ये के त्वेनं समवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050725, "chapter_id": 2111, "verse_number": "७-३८-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050726, "chapter_id": 2111, "verse_number": "७-३८-२", "content_sanskrit": "शृणु राजन्कुमारस्य रणे विक्रीडितं महत्।\nबिभित्सतो रथानीकं भारद्वाजेन रक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050727, "chapter_id": 2111, "verse_number": "७-३८-३", "content_sanskrit": "मद्रेशं सादितं दृष्ट्वा सौभद्रेणाशुगै रणे।\nशल्यादवरजः क्रुद्ध क्रिन्बाणान्समभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050728, "chapter_id": 2111, "verse_number": "७-३८-४", "content_sanskrit": "स विद्ध्वा दशभिर्बाणैः साश्वयन्तारमार्जुनिम्।\nउदक्रोशन्महाशब्दं तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050729, "chapter_id": 2111, "verse_number": "७-३८-५", "content_sanskrit": "तस्यार्जुनिः शिरोग्रीवं पाणिपादं धनुर्हयान्।\nछत्रं ध्वजं नियन्तारं त्रिवेणुं चाप्युपस्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050730, "chapter_id": 2111, "verse_number": "७-३८-६", "content_sanskrit": "चक्रं युगं च तूणीरं ह्यनुकर्षं सायकैः।\nपताकां चक्रगोप्तारौ सर्वोपकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050731, "chapter_id": 2111, "verse_number": "७-३८-७", "content_sanskrit": "लघुहस्तः प्रचिच्छेद ददृशे तं न कश्चन।\nस पपात क्षितौ क्षीणः प्रविद्धाभरणाम्बरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050732, "chapter_id": 2111, "verse_number": "७-३८-८", "content_sanskrit": "वायुनेव महाचैत्यः समूलं चित्रवेदिकः।\nअनुगास्तस्य वित्रस्ताः प्राद्रवन्सर्वतो दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050733, "chapter_id": 2111, "verse_number": "७-३८-९", "content_sanskrit": "आर्जुनेः कर्म तद्दृष्ट्वा सम्प्रणेदुः समन्ततः।\nनादेन सर्वभूतानि साधुसाध्विति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050734, "chapter_id": 2111, "verse_number": "७-३८-१०", "content_sanskrit": "शल्यभ्रातर्यथारुग्णे बहुशस्तस्य सैनिकाः।\nकुलाधिवासनामानि श्रावयन्तोऽर्जुनात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050735, "chapter_id": 2111, "verse_number": "७-३८-११", "content_sanskrit": "अभ्यधावन्त सङ्क्रुद्धा विविधायुधपाणयः।\nरथैरश्वैर्गजैश्चान्ये पद्भिश्चान्ये बलोत्कटाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050736, "chapter_id": 2111, "verse_number": "७-३८-१२", "content_sanskrit": "बाणशब्देन महता रथनेमिस्वनेन च।\nहुंकारैः क्ष्वेडितोत्कृष्टैः सिंहनादैः सगर्जितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050737, "chapter_id": 2111, "verse_number": "७-३८-१३", "content_sanskrit": "ज्यातलत्रस्वनैरन्ये गर्जन्तोऽर्जुननन्दनम्।\nब्रुवन्तश्च न नो जीवन्मोक्ष्यसे जीवितादिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050738, "chapter_id": 2111, "verse_number": "७-३८-१४", "content_sanskrit": "तांस्तथा ब्रुवतो दृष्ट्वा सौभद्रः प्रहसन्निव।\nयो योस्मै प्राहरत्पूर्वं तं तं विव्याध पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050739, "chapter_id": 2111, "verse_number": "७-३८-१५", "content_sanskrit": "सन्दर्शयिष्यन्नस्त्राणि विचित्राणि लघूनि च।\nआर्जुनिः समरे शूरो मृदुपूर्वमयुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050740, "chapter_id": 2111, "verse_number": "७-३८-१६", "content_sanskrit": "वासुदेवादुपात्तं यदस्त्रं यच्च धनञ्जयात्।\nअदर्शयत तत्कार्ष्णिः कृष्णाभ्यामविशेषवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050741, "chapter_id": 2111, "verse_number": "७-३८-१७", "content_sanskrit": "दूरमस्य गुरुं भारं साध्वसं च पुनः पुनः।\nसन्दधद्विसृजंश्चेषून्निर्विशेषमदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050742, "chapter_id": 2111, "verse_number": "७-३८-१८", "content_sanskrit": "चापमण्डलमेवास्य विस्फुरद्दिक्ष्वदृश्यत।\nसुदीप्तस्य शरत्काले सवितुर्मण्डलं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050743, "chapter_id": 2111, "verse_number": "७-३८-१९", "content_sanskrit": "ज्याशब्दः शुश्रुवे तस्य तलशब्दश्च दारुणः।\nमहाशनिमुचः काले पयोदस्येव निःस्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050744, "chapter_id": 2111, "verse_number": "७-३८-२०", "content_sanskrit": "हीमानमर्षी सौभद्रो मानकृत्प्रियदर्शनः।\nसम्मिमानयिषुर्वीरानिष्वस्त्रैश्चाप्ययुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2050745, "chapter_id": 2111, "verse_number": "७-३८-२१", "content_sanskrit": "मृदुर्भूत्वा महाराज दारुणः समपद्यत।\nवर्षाभ्यतीतो भगवाञ्शरदीव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2050746, "chapter_id": 2111, "verse_number": "७-३८-२२", "content_sanskrit": "शरान्विचित्रान्सुबहून्रुक्मपुङ्खाञ्शिलाशितान्।\nमुमोच शतशः क्रुद्धो गभस्तीनिव भास्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2050747, "chapter_id": 2111, "verse_number": "७-३८-२३", "content_sanskrit": "क्षुरप्रैर्वत्सदन्तैश्च विपाठेश्च महायशाः।\nनाराचैरर्धचन्द्राभैर्भल्लैरञ्जलिकैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2050748, "chapter_id": 2111, "verse_number": "७-३८-२४", "content_sanskrit": "अवाकिरद्रथानीकं भारद्वाजस्य पश्यतः।\nततस्तत्सैन्यमभवद्विमुखं शरपीडितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2050749, "chapter_id": 2111, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रयोदशदिवसयुद्धे अष्टत्रिंशोऽध्यायः॥ ३८ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-३८-५ तल्पं इति पाठे रथगतशय्याम्॥ ५-३८-१० अधिवासो निवासः॥ ५-३८-१६ अविशेषवत्तुल्यमित्यर्थः॥ ५-३८-१७ अस्य निरस्य॥ ५-३८-३८ अष्टत्रिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]