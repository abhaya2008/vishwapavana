[{"id": 7000674000, "chapter_id": 20674, "verse_number": "६-१७-१", "content_sanskrit": "नारद उवाच ।\nअथ जालंधरोऽपश्यत्कबंधचयभीषणम् ।\nरणं रुधिरमांसौघ मज्जा मेदोऽस्थिदुर्गमम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000674001, "chapter_id": 20674, "verse_number": "६-१७-२", "content_sanskrit": "तत्र जालंधरो दैत्यः प्रियाहरणदुःखितः ।\nरणे विलोकयामास वृषस्थं पार्वतीपतिम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000674002, "chapter_id": 20674, "verse_number": "६-१७-३", "content_sanskrit": "घोराहिभोगेनविभूषितांगं जटाकलापे शशिभूषणांकितम् ।\nनेत्राग्निकीलोपरिशोभितांगं विना रणं संप्रददर्श सिंधुजः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000674003, "chapter_id": 20674, "verse_number": "६-१७-४", "content_sanskrit": "शीघ्रं स्वरथमारुह्य समुद्रतनयस्तदा ।\nसंरुष्टः प्राह तं शुंभं तापसो न हतस्त्वया॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000674004, "chapter_id": 20674, "verse_number": "६-१७-५", "content_sanskrit": "प्राह जालंधरं शुंभस्तपस्तेन महत्कृतम् ।\nहंतुं न शक्यतेऽस्माभिर्हरः संग्रामदुर्जयः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000674005, "chapter_id": 20674, "verse_number": "६-१७-६", "content_sanskrit": "इतिशुंभोक्तमाकर्ण्यसिंधुजःक्रोधमूर्च्छितः ।\nहरं पद्मसहस्रेण दैत्यसैन्येन संवृतम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000674006, "chapter_id": 20674, "verse_number": "६-१७-७", "content_sanskrit": "गृहीत्वा कालकेदारं धनुर्जालंधरो ययौ ।\nबाणांस्तीक्ष्णानतिस्थूलान्लोहस्तंभान्तथा बहून्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000674007, "chapter_id": 20674, "verse_number": "६-१७-८", "content_sanskrit": "मुमोच युधि दुर्धर्षो वर्षन्मेघ इवागमे ।\nआयांतं रुरुधुः सिंधुसूनुं शंभुगणा युधि॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000674008, "chapter_id": 20674, "verse_number": "६-१७-९", "content_sanskrit": "ततो रुद्रेण रौद्रैश्च शरौघैस्ताडितो रुषा ।\nरुद्रबाणैस्तदा तस्य कवचं भुवि पातितम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000674009, "chapter_id": 20674, "verse_number": "६-१७-१०", "content_sanskrit": "विवर्मापि बभौ सोऽथ मेघमुक्तो यथाचलः ।\nपुनर्जालंधरस्यांगं शंभुना कीलितं शरैः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000674010, "chapter_id": 20674, "verse_number": "६-१७-११", "content_sanskrit": "रुधिरं बहु सुस्राव जालंधरशरीरतः ।\nतेनाशु रुधिरौघेण प्लाविता सकला मही॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000674011, "chapter_id": 20674, "verse_number": "६-१७-१२", "content_sanskrit": "ततो देवा भयं जग्मुर्दानवाश्च चकंपिरे ।\nत्यक्त्वा ते प्रमथा वीरा रणभूमिं प्रदुद्रुवुः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000674012, "chapter_id": 20674, "verse_number": "६-१७-१३", "content_sanskrit": "नद्या इव परा मूर्त्तिः प्रसृता सर्वतोऽपि च ।\nअथाहार्णवजो रुद्रं धनुर्धर वरो ह्यसि॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000674013, "chapter_id": 20674, "verse_number": "६-१७-१४", "content_sanskrit": "इदानीं तत्करिष्यामि येन गच्छसि संक्षयम् ।\nइत्युक्त्वा कालकेदारं सशरं प्रतिगृह्य तत्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000674014, "chapter_id": 20674, "verse_number": "६-१७-१५", "content_sanskrit": "शीघ्रं संपूरयामास शरैर्नानाविधैः शिवम् ।\nशिवः सहस्रकोटीभिः पूरितांगो रणे बभौ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000674015, "chapter_id": 20674, "verse_number": "६-१७-१६", "content_sanskrit": "विहंगमैर्यथाकाशं वृक्षैरिव महागिरिः ।\nदैत्यमुक्तैस्तुतैर्बाणैर्दृष्ट्वा व्याप्तं महेश्वरम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000674016, "chapter_id": 20674, "verse_number": "६-१७-१७", "content_sanskrit": "वीरभद्रस्तथा कोपाज्जालंधरमधावत ।\nअपीडयदमेयात्मा समुद्रतनयं बली॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000674017, "chapter_id": 20674, "verse_number": "६-१७-१८", "content_sanskrit": "जालंधरोऽथ संक्रुद्धो विध्यन्बाणैः सहस्रशः ।\nधनुः शरान्रथं छत्रं सारथिं तिलशः शरैः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000674018, "chapter_id": 20674, "verse_number": "६-१७-१९", "content_sanskrit": "चकार वीरभद्रस्य सिंधुसूनुः प्रतापवान् ।\nवीरभद्रोऽथ विरथो हतवान्गदयाब्धिजम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000674019, "chapter_id": 20674, "verse_number": "६-१७-२०", "content_sanskrit": "तथैव गदया सोऽपि तं हत्वापातयद्भुवि ।\nगदाप्रहारपतितमालोक्यातिविमूर्च्छितम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000674020, "chapter_id": 20674, "verse_number": "६-१७-२१", "content_sanskrit": "मणिभद्रोऽथ समरे जालंधरमधावत ।\nअतिक्रुद्धं तमायांतं दृष्ट्वा दैत्यो महारणे॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000674021, "chapter_id": 20674, "verse_number": "६-१७-२२", "content_sanskrit": "शरैर्व्यस्तोपकरणं स चकार नदीसुतः ।\nअथ मूर्च्छां परित्यज्य उत्तस्थौ सिंहवन्नदन्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000674022, "chapter_id": 20674, "verse_number": "६-१७-२३", "content_sanskrit": "वीरभद्रस्ततः कोपान्मणिभद्रः प्रतापवान् ।\nजघ्नतुः पर्वताभ्यां तौ व्योमस्थं तटिनीसुतम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000674023, "chapter_id": 20674, "verse_number": "६-१७-२४", "content_sanskrit": "तदंगे पतितौ दृष्ट्वा पर्वतौ विनिनद्य च ।\nजघान मुष्टिपातेन वीरभद्रो नदीसुतम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000674024, "chapter_id": 20674, "verse_number": "६-१७-२५", "content_sanskrit": "मणिभद्रश्चरणयोर्धृत्वा सागरनंदनम् ।\nस्यंदनाद्भ्रामयामास तदद्भुतमिवाभवत्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000674025, "chapter_id": 20674, "verse_number": "६-१७-२६", "content_sanskrit": "मणिभद्र गृहीतोऽपि दैत्यराट्स महाबलः ।\nहत्वा चरणघातेन मणिभद्रमपातयत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000674026, "chapter_id": 20674, "verse_number": "६-१७-२७", "content_sanskrit": "जालंधरो महाबाहुर्वीरभद्रं च मुष्टिना ।\nअथागतः परिवृतो गणैर्वै नंदिकेश्वरः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000674027, "chapter_id": 20674, "verse_number": "६-१७-२८", "content_sanskrit": "शुंभस्तमागतं दृष्ट्वा रुरोध सह सैनिकैः ।\nद्वंद्वयुद्धैरथाजग्मुर्गणा दैत्यैः परस्परम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000674028, "chapter_id": 20674, "verse_number": "६-१७-२९", "content_sanskrit": "शुंभः शिलादजं राहुर्महाकालं रणे ययौ ।\nकोलाहलं निशुंभोऽथ केतुः कालमधावत॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000674029, "chapter_id": 20674, "verse_number": "६-१७-३०", "content_sanskrit": "शैलोदरो गुहं जंभो माल्यवंतं महाबलः ।\nमहापार्श्वो ययौ चंडं चंडीशो रोमकंटकम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000674030, "chapter_id": 20674, "verse_number": "६-१७-३१", "content_sanskrit": "विकटास्योऽथ वै भृंगिमुरुनेत्रो विनायकम् ।\nएवं दैत्येश्वरैः सार्द्धं गणानामधिपा ययुः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000674031, "chapter_id": 20674, "verse_number": "६-१७-३२", "content_sanskrit": "अथ शुंभायुधैर्बाणैः प्रहतश्च शिलादजः ।\nचूर्णीचकाराद्रिशृंगैः कपितुंडो महत्तरैः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000674032, "chapter_id": 20674, "verse_number": "६-१७-३३", "content_sanskrit": "शुंभस्तेनार्दितः शक्त्या शिलादं च जघान तम् ।\nमहाकालो जघानाथ तं राहुं रणमूर्द्धनि॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000674033, "chapter_id": 20674, "verse_number": "६-१७-३४", "content_sanskrit": "शक्त्याथ तस्य हतवान्स्यंदनं स महाद्रिणा ।\nकोलाहलो हतः शक्त्या निशुंभेन प्रतापवान्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000674034, "chapter_id": 20674, "verse_number": "६-१७-३५", "content_sanskrit": "शक्तिं गृहीत्वा ह्यहनद्रथं सारथिना सह ।\nविरथेनाथ दैत्येन भृशं क्रुद्धेन संयुगे॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000674035, "chapter_id": 20674, "verse_number": "६-१७-३६", "content_sanskrit": "कोलाहलो सुरेंद्रेण सहस्रफणिना हतः ।\nतं हत्वा चातिवेगेन रथं चान्यमुपागतः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000674036, "chapter_id": 20674, "verse_number": "६-१७-३७", "content_sanskrit": "फणिचक्रहतः संख्ये क्षणान्मूर्च्छां विहाय च ।\nस्वरथात्शीघ्रमुत्तीर्य गृहीत्वा खड्गचर्मणी॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000674037, "chapter_id": 20674, "verse_number": "६-१७-३८", "content_sanskrit": "सर्वं चक्रे निशुंभस्य स रथाद्यसिना पृथक् ।\nपुनः स्वरथमारुह्य दैत्यं बाणैरताडयत्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000674038, "chapter_id": 20674, "verse_number": "६-१७-३९", "content_sanskrit": "निशुंभोऽप्यतिरोषाच्च तत्पराक्रमविस्मितः ।\nशक्त्या महाबलस्तस्य रथं साश्वं न्यषूदयत्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000674039, "chapter_id": 20674, "verse_number": "६-१७-४०", "content_sanskrit": "कोलाहलो रणे धावन्निशुंभं विरथो बली ।\nगतः स सरथं चक्रे विरथं भुजबंधनात्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000674040, "chapter_id": 20674, "verse_number": "६-१७-४१", "content_sanskrit": "केतुपुच्छं गृहीत्वा च भ्रामयामास चांबरे ।\nकालश्चिक्षेप सोऽप्यद्रिं स चिच्छेद गिरिं जवात्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000674041, "chapter_id": 20674, "verse_number": "६-१७-४२", "content_sanskrit": "तं नगं चूर्णितं दृष्ट्वा ताडयामास मुष्टिना ।\nकालश्चूर्णितसर्वांगः केतुना प्राद्रवद्भयात्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000674042, "chapter_id": 20674, "verse_number": "६-१७-४३", "content_sanskrit": "शैलोदरस्तथा स्कंदं जघान गदयोरसि ।\nषडाननोऽपि तं शक्त्या हत्वा भूमावपातयत्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000674043, "chapter_id": 20674, "verse_number": "६-१७-४४", "content_sanskrit": "शक्तिप्रहारेण मृतं दानवं वीक्ष्य षण्मुखः ।\nजगर्ज तत्र वैचित्र्यं यथा क्रौंचे विदारिते॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000674044, "chapter_id": 20674, "verse_number": "६-१७-४५", "content_sanskrit": "माल्यवानथ बाणौघैर्जंभमभ्यर्दयद्रणे ।\nजंभोऽपि सायकैस्तीक्ष्णैर्भित्त्वा तं मूर्च्छितं जहौ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000674045, "chapter_id": 20674, "verse_number": "६-१७-४६", "content_sanskrit": "महापार्श्वो रथं धृत्वा बाणौघैर्वाजिवर्जितम् ।\nलीलयैव च खे नीत्वा व्यश्वं चंडमपातयत्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000674046, "chapter_id": 20674, "verse_number": "६-१७-४७", "content_sanskrit": "व्यश्वं रथं विलोक्याथ ततश्चंडोऽग्रहीद्गजम् ।\nआपतंतं महापार्श्वं चंडस्तं गदयाहनत्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000674047, "chapter_id": 20674, "verse_number": "६-१७-४८", "content_sanskrit": "अचिंत्यैव गदापातं सोऽसुरो भृशदारुणः ।\nप्रहत्य मुष्टिना चंडं पातयामास भूतले॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000674048, "chapter_id": 20674, "verse_number": "६-१७-४९", "content_sanskrit": "चंडीशशस्त्राभिहतो रोमकंठो महासुरः ।\nचंडीशं पादयोर्धृत्वा रथमूर्ध्नि न्यपातयत्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000674049, "chapter_id": 20674, "verse_number": "६-१७-५०", "content_sanskrit": "पपात सहसा भूमौ ययौ तं भीषणेक्षणः ।\nउरुनेत्रेण समरे हतो लंबोदरः शरैः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000674050, "chapter_id": 20674, "verse_number": "६-१७-५१", "content_sanskrit": "दंतेनोरसि तं हत्वा पातयामास भूतले ।\nऊरुनेत्रः क्षणाच्छांतिमागत्याशु रथं क्षणात्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000674051, "chapter_id": 20674, "verse_number": "६-१७-५२", "content_sanskrit": "जघान मुद्गरेणासौ मूर्ध्नि सिंदूरमंडिते ।\nगणेश्वरः पट्टिशेन जघानोरसि दानवम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000674052, "chapter_id": 20674, "verse_number": "६-१७-५३", "content_sanskrit": "तन्मुखादथ निष्क्रांतो नवशीर्षोऽसुरो महान् ।\nअष्टादशभुजो राजन्सोऽप्यधावत शांकरिम्॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000674053, "chapter_id": 20674, "verse_number": "६-१७-५४", "content_sanskrit": "नवशीर्षोरुनेत्राभ्यां रणे रुद्धो विनायकः ।\nजर्जरीकृतदेहोऽपि जग्राह परशुं रुषा॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000674054, "chapter_id": 20674, "verse_number": "६-१७-५५", "content_sanskrit": "तेन चिच्छेद शस्त्राणि तयोराजौ गणेश्वरः ।\nरुद्धं गणेश्वरं दृष्ट्वा ताभ्यां संख्येऽथ षण्मुखः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000674055, "chapter_id": 20674, "verse_number": "६-१७-५६", "content_sanskrit": "शीघ्रमागत्य सेनानीर्जघान नवशीर्षकम् ।\nनवशीर्षं रणे हत्वा उरुनेत्रमधावत॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000674056, "chapter_id": 20674, "verse_number": "६-१७-५७", "content_sanskrit": "स्कंदः स्वशक्तिघातेन पातयामास तं नृप ।\nपश्यञ्जालंधरः स्कंदं ययौ सैन्येन संवृतः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000674057, "chapter_id": 20674, "verse_number": "६-१७-५८", "content_sanskrit": "पुत्रप्रीत्यासुरान्हंतुं सगणः शंकरोऽपि च ।\nततो घोरतरं युद्धमभूदद्भुतसैन्ययोः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000674058, "chapter_id": 20674, "verse_number": "६-१७-५९", "content_sanskrit": "हरसिंधुजयोर्युद्धे गतप्राणेव रोदसी ।\nअथ जालंधरः क्रुद्धो बाणं संधाय दारुणम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000674059, "chapter_id": 20674, "verse_number": "६-१७-६०", "content_sanskrit": "सहस्रशतसंख्याकैः पत्रैः सर्वत्र भूषितम् ।\nदैत्येंद्रस्तेन बाणेन ललाटेताडयच्छिवम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000674060, "chapter_id": 20674, "verse_number": "६-१७-६१", "content_sanskrit": "ममज्जापुंखमर्यादं ललाटे शंकरस्य च ।\nभाले शशांकवच्छंभोः स रराज महाप्रभः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000674061, "chapter_id": 20674, "verse_number": "६-१७-६२", "content_sanskrit": "यथादित्यो हि घर्मांते संध्याकालेंबुदागमे ।\nअथ रुद्रो महाबाणं जग्राह ज्वलनोपमम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000674062, "chapter_id": 20674, "verse_number": "६-१७-६३", "content_sanskrit": "यस्य वेगे तु पवनः फले यस्याग्निभास्करौ ।\nकालो ग्रंथिषु सर्वेषु शरे देवी धरा स्थिता॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000674063, "chapter_id": 20674, "verse_number": "६-१७-६४", "content_sanskrit": "हरस्तेन शरेणाशु विव्याध हृदि सिंधुजम् ।\nतेन बाणप्रहारेण रुधिरौघपरिप्लुतः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000674064, "chapter_id": 20674, "verse_number": "६-१७-६५", "content_sanskrit": "पपात शरभिन्नांगो वज्राहत इवाचलः ।\nतदा दैत्याः समाक्रंदन्जगर्जुः प्रमथास्तथा॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000674065, "chapter_id": 20674, "verse_number": "६-१७-६६", "content_sanskrit": "सिंधुजं मूर्छितं दृष्ट्वा रुरुधुर्दानवाः शिवम् ।\nरक्षार्थमुद्यताः केचित्केचित्तं परितः स्थिताः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000674066, "chapter_id": 20674, "verse_number": "६-१७-६७", "content_sanskrit": "यावज्जालंधरो मूर्छां प्राप्तो वारिधिनंदनः ।\nतावद्रुद्रेण नाराचैर्हता जालंधरी चमूः॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000674067, "chapter_id": 20674, "verse_number": "६-१७-६८", "content_sanskrit": "चिराज्जालंधरस्त्यक्त्वा मूर्छां सैन्यं हतं नृप ।\nदृष्ट्वा भयान्वितः सेनां विकीर्णां च तथा रणे॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000674068, "chapter_id": 20674, "verse_number": "६-१७-६९", "content_sanskrit": "ततः काव्यं स सस्मार मनसा परमं गुरुम् ।\nस्मृतस्तेन त्वरन्प्राप्तः कविर्जालंधरं प्रति॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000674069, "chapter_id": 20674, "verse_number": "६-१७-७०", "content_sanskrit": "स्वस्ति कृत्वा जगादाथ भार्गवः सिंधुनंदनम् ।\nकिं करोमि महाराज तव कार्यं महाबल॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000674070, "chapter_id": 20674, "verse_number": "६-१७-७१", "content_sanskrit": "नारद उवाच ।\nइति काव्यवचः श्रुत्वा भार्गवं बहु मानयन् ।\nनत्वा गुरुमुवाचाथ राजा जालंधरस्तथा॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000674071, "chapter_id": 20674, "verse_number": "६-१७-७२", "content_sanskrit": "राजोवाच ।\nजीवयैतान्मृताञ्छुक्र दैत्यान्सर्वान्समंततः ।\nइत्युक्तः सिंधुजेनाजौ सैन्यं तत्र व्यलोकयत्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000674072, "chapter_id": 20674, "verse_number": "६-१७-७३", "content_sanskrit": "पंचविंशत्सहस्राणि योजनानां प्रमाणतः ।\nदैत्यांगरथसंकीर्णमुपर्युपरि पार्थिव॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000674073, "chapter_id": 20674, "verse_number": "६-१७-७४", "content_sanskrit": "उच्छ्रये पंचनवतियोजनानां महीं चिताम् ।\nयोधवाहनदेहाद्यैरिव पूर्णां धरां ततः॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000674074, "chapter_id": 20674, "verse_number": "६-१७-७५", "content_sanskrit": "मंत्रोदकेन चाभ्युक्ष्य दैत्यानुत्थापयत्कविः ।\nयावद्रुद्रो जटाजूटं बबंध भुजगैर्दृढम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000674075, "chapter_id": 20674, "verse_number": "६-१७-७६", "content_sanskrit": "तावत्काव्येन तत्सैन्यं मंत्रेणोत्थापितं नृप ।\nव्याघ्रान्यथा केसरिणो गजेंद्राः शूकरान्यथा॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000674076, "chapter_id": 20674, "verse_number": "६-१७-७७", "content_sanskrit": "आगतान्दानवान्दृष्ट्वा चिंतयामास शंकरः ।\nकिमेतदिह संजातं मृतान्सृजति कुत्रचित्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000674077, "chapter_id": 20674, "verse_number": "६-१७-७८", "content_sanskrit": "ददर्श चिंतयन्काव्य इति तस्मिन्रणे भवः ।\nजीवयंतं रणे दैत्यान्धावंतं वेगवत्तरम्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000674078, "chapter_id": 20674, "verse_number": "६-१७-७९", "content_sanskrit": "ततः क्रुद्धो महादेवः शुक्रं हंतुं मनो दधे ।\nत्रिशूलिनमनुज्ञाय रहश्चोवाच तं कविः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000674079, "chapter_id": 20674, "verse_number": "६-१७-८०", "content_sanskrit": "ब्राह्मणोऽहं कथं हंसि सर्वविद्याविशारदम् ।\nब्रह्महत्या मयि हते तव रुद्र भविष्यति॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000674080, "chapter_id": 20674, "verse_number": "६-१७-८१", "content_sanskrit": "इति श्रुत्वा कवेर्वाक्यं शूलं तत्याज शंकरः ।\nस्मृत्वा तत्पूर्ववृत्तांतं यल्लग्नं ब्रह्मणः शिरः॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000674081, "chapter_id": 20674, "verse_number": "६-१७-८२", "content_sanskrit": "ब्राह्मणो न हि हंतव्यो हरन्प्राणानपि प्रियान् ।\nअयं तु जीवयन्दैत्यान्निग्राह्यः सर्वथा मया॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000674082, "chapter_id": 20674, "verse_number": "६-१७-८३", "content_sanskrit": "तस्मादेनं क्षिपाम्याशु स्त्रीयोनौ दैत्यजीवनम् ।\nएवमुक्तवतः शंभोस्तृतीयनयनाद्द्रुतम्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000674083, "chapter_id": 20674, "verse_number": "६-१७-८४", "content_sanskrit": "कृत्या विवासा चात्युग्रा मुक्तकेशी महोदरा ।\nस्थूललंबस्तनी योनी दंष्ट्रालोचनभीषणा॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000674084, "chapter_id": 20674, "verse_number": "६-१७-८५", "content_sanskrit": "आज्ञापयेति स तया प्रोक्तस्तामब्रवीच्छिवः ।\nकृत्ये त्वं दानवाचार्यं स्वयोनौ क्षिप दुर्मतिम्॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000674085, "chapter_id": 20674, "verse_number": "६-१७-८६", "content_sanskrit": "यावज्जालंधरं हन्मि तावदेनं भगे वह ।\nहते जालंधरे दैत्ये पश्चान्निस्तीर्य मोचय॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000674086, "chapter_id": 20674, "verse_number": "६-१७-८७", "content_sanskrit": "हरेणोक्तेति सा कृत्या भार्गवं समधावत ।\nपपात भूमौ तां दृष्ट्वा कविर्दैत्याः प्रदुद्रुवुः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000674087, "chapter_id": 20674, "verse_number": "६-१७-८८", "content_sanskrit": "केशेष्वाकृष्य धुन्वाना नग्नमालिंग्य भार्गवम् ।\nयोनौ दधार सा कृत्या हसंती जयनंदन॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000674088, "chapter_id": 20674, "verse_number": "६-१७-८९", "content_sanskrit": "भगे क्षिप्तं गुरुं दृष्ट्वा यावज्जालंधरोऽसुरः ।\nसंदधे मार्गणांस्तावत्सा कृत्यादृश्यतां गता॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]