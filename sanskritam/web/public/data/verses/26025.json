[{"id": 7006025000, "chapter_id": 26025, "verse_number": "१-२०९-१", "content_sanskrit": "सूत उवाच ।\nश्रीरुक्था गेन सा ज्ञेया उत्युक्था स्त्री गुरुद्यम् ।\nमो नारी रो मृगी मध्या मगौ कन्या प्रतिष्ठया ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006025001, "chapter_id": 26025, "verse_number": "१-२०९-२", "content_sanskrit": "भो गौ पङ्क्तिः सुप्रातिष्ठा तनुमध्या तयौ समृता ।\nनयाभ्यां बालललिता गायत्रीच्छन्द एव हि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006025002, "chapter_id": 26025, "verse_number": "१-२०९-३", "content_sanskrit": "मसगैर्मदलेखा स्यादुष्णिक्छन्दः स्मृतं बुधैः ।\nभौ गौ चित्रपदा ख्याता विद्युन्माला ममौ गगौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006025003, "chapter_id": 26025, "verse_number": "१-२०९-४", "content_sanskrit": "माणवकं भात्तलगा म्नौ गौ हंसरुतं स्मृतम् ।\nसमानिका रजगला जरला गः प्रमाणिका ।\nआभ्यामन्यद्वितानं स्यादनुष्टुप्छन्द ईरितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006025004, "chapter_id": 26025, "verse_number": "१-२०९-५", "content_sanskrit": "रनसैः स्याद्धलमुखी नौ मः शिशुभृता भवेत् ।\nबृहतीछन्द इत्युक्तं स्मौ जगौ स विराजितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006025005, "chapter_id": 26025, "verse_number": "१-२०९-६", "content_sanskrit": "पणवं स्यान्मनयगैर्मयूरसारिणी भवेत् ।\nरजाभ्याञ्च रगाभ्याञ्च रुक्मवती भमौ सगौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006025006, "chapter_id": 26025, "verse_number": "१-२०९-७", "content_sanskrit": "मत्ता मभसगैर्युक्ता नरजा गो मनोरमा ।\nपङ्क्तिच्छन्दः समाख्यातं जसता गावुपस्थितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006025007, "chapter_id": 26025, "verse_number": "१-२०९-८", "content_sanskrit": "तौ जो गाविन्द्रवज्रा स्याज्जतज्गा गुपपूर्विका ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006025008, "chapter_id": 26025, "verse_number": "१-२०९-९", "content_sanskrit": "उपजातयोऽन्याद्यन्ताः सुमुखी नजजा लगौ ।\nभभभा गौ दोधकं स्याच्छालिनी मतता गगौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006025009, "chapter_id": 26025, "verse_number": "१-२०९-१०", "content_sanskrit": "अब्धिलोकैश्च विच्छेदो वातोर्ंमो ममता गगौ ।\nश्रीर्भतौ ननगाः प्रोक्ता पञ्चभिः षडूभिरेव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006025010, "chapter_id": 26025, "verse_number": "१-२०९-११", "content_sanskrit": "मगना नो गो भ्रमरविलासितमुदाहृतम् ।\nरथोद्धतार्नौ रलगाः स्वागता रनभा गगौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006025011, "chapter_id": 26025, "verse_number": "१-२०९-१२", "content_sanskrit": "वृत्ता ननौ सगौ गः स्यान्नौ रलौ गः समद्रिका ।\nरजरा ल्गौ श्येनिका स्याज्जसता गौ शिखण्डितम् ।\nत्रिष्टुप्छन्दः समाख्यातं पिङ्गलेन महात्मना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006025012, "chapter_id": 26025, "verse_number": "१-२०९-१३", "content_sanskrit": "रनौ भसौ चन्द्रवर्त्म वंशस्थं स्याज्जतौ जरौ ।\nततो जराविन्द्रवंशा वेदसैस्तोटकं स्मृतम् ।\nन्भौ भ्रौ द्रुतविलम्बितं पुटश्च स्यान्ननौ मयौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006025013, "chapter_id": 26025, "verse_number": "१-२०९-१४", "content_sanskrit": "वसुवेदैश्च विरतिर्मुदितवदना त्वियम् ।\nननररैः समाख्याता नयना यस्तथा भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006025014, "chapter_id": 26025, "verse_number": "१-२०९-१५", "content_sanskrit": "सा तु कुसुमविचित्रा जलोद्धतगती रसैः ।\nजसौ जसौ च पादेषु चतूरैः स्त्रग्विणी मता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006025015, "chapter_id": 26025, "verse_number": "१-२०९-१६", "content_sanskrit": "भुजङ्गप्रयातं वृत्तं चतुभिर्यैः प्रकीर्तिम ।\nप्रयंवदा नभज्रैश्च मणिमाला तयौ तयौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006025016, "chapter_id": 26025, "verse_number": "१-२०९-१७", "content_sanskrit": "गुहवक्त्रैश्च सन्निद्रा ललिता स्यात्तभौ जर। ।\nप्रमिताक्षरा सजससैरुज्ज्वला तु ननौ भरौ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006025017, "chapter_id": 26025, "verse_number": "१-२०९-१८", "content_sanskrit": "ममौ ययौ वैश्वदेवी पञ्चाश्वैश्च यतिर्भवेत। ।\nमभौ समौ जलधरमालाब्ध्यन्त्यैर्यतिभवेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006025018, "chapter_id": 26025, "verse_number": "१-२०९-१९", "content_sanskrit": "नौ ततौ गः क्षमावृत्तं तुरगैश्च रसैर्यतिः ।\nप्रहर्षिणी मनौ ज्रौ गा वह्निभिर्दशभिर्यतिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006025019, "chapter_id": 26025, "verse_number": "१-२०९-२०", "content_sanskrit": "जभौ सजौ गो रुचिरा चतुर्भिश्च ग्रहैर्ति ।\nमत्तमयूरं मतयाः सगौ देवग्रहैर्यतिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006025020, "chapter_id": 26025, "verse_number": "१-२०९-२१", "content_sanskrit": "मञ्जुभाषिणी सज्सा ज्गौ सुनन्दिनी सजसा मगौ ।\nननौ ततौ चन्द्रिका गः सप्तभिश्च रसैर्यतिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006025021, "chapter_id": 26025, "verse_number": "१-२०९-२२", "content_sanskrit": "असम्बाधा मतनसा गगौ बाणग्रहैर्यतिः ।\nननराः सो लधुगुरुः स्वरैः प्रोक्तापराजिता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006025022, "chapter_id": 26025, "verse_number": "१-२०९-२३", "content_sanskrit": "ननौ भनौ प्रहरणकलिकेयं लगौ तथा ।\nवसन्ततिलका सिंहोन्नता तभ्जा जगौ गुरुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006025023, "chapter_id": 26025, "verse_number": "१-२०९-२४", "content_sanskrit": "भजौ सनौ गगाविन्दुवदनाथ सुकेशरम् ।\nनरना रलगाः पादे शर्करी प्रतिपादिता ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006025024, "chapter_id": 26025, "verse_number": "१-२०९-२५", "content_sanskrit": "चतुर्दशलघुः स्याच्च श्रेष्ठा शशिकला सग। ।\nरसग्रहयतिः स्रक्स्रा वसुशैलयतिस्तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006025025, "chapter_id": 26025, "verse_number": "१-२०९-२६", "content_sanskrit": "स्यान्मणिगुणनिकरो मालिनी ननमा ययौ ।\nवसुस्वरयतिः स्याच्च नजौ भज्राः प्रभद्रकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006025026, "chapter_id": 26025, "verse_number": "१-२०९-२७", "content_sanskrit": "एला सयौ ननौ यःस्याच्चित्रलेखास्वराष्टकैः ।\nमरौ मयौ यश्च भवेदुक्तेयमति शर्करी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006025027, "chapter_id": 26025, "verse_number": "१-२०९-२८", "content_sanskrit": "स्वरात्खं वृषभगजजृम्भितं भ्रनना नगौ ।\nनजभजरा वाणिनी गः पिङ्गलेनाष्टिरीरिता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006025028, "chapter_id": 26025, "verse_number": "१-२०९-२९", "content_sanskrit": "रसरुद्रैः शिखरिणी यमौ नसभला गुरुः ।\nवसुग्रयतिः पृथ्वी जसौ जसयला गुरुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006025029, "chapter_id": 26025, "verse_number": "१-२०९-३०", "content_sanskrit": "दशस्वरैर्वंशपत्रपतितं भ्रौन्नभा लगौ ।\nषड्वेदाश्वैश्च हरिणी नसमा रसला गुरुः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006025030, "chapter_id": 26025, "verse_number": "१-२०९-३१", "content_sanskrit": "मन्दाक्रान्तब्धिषड्नगैर्मभनास्ततगा गुरु। ।\nनर्दटकं नजभजा जलौ गो यतिरेव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006025031, "chapter_id": 26025, "verse_number": "१-२०९-३२", "content_sanskrit": "सप्तर्त्वब्धिः कोकिलकमत्यष्टिः स्याच्च पूर्वत ।\nभूतर्त्वश्वैः कुसुमितलता म्तौ न्यौ ययौ धृतिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006025032, "chapter_id": 26025, "verse_number": "१-२०९-३३", "content_sanskrit": "रसर्त्वश्वैर्यमौ न्सौ रौ मेघविस्फूर्जिता रग। ।\nशार्दूलविक्रीडितं मः सूर्यश्वैः सज्सतास्तगौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006025033, "chapter_id": 26025, "verse_number": "१-२०९-३४", "content_sanskrit": "छन्दो ह्यतिधृतिः प्रोक्तमत ऊर्ध्वं कृतिर्भवत ।\nसप्ताश्वर्तुः सुवदना भ्रौ मनौ यभला गुरुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006025034, "chapter_id": 26025, "verse_number": "१-२०९-३५", "content_sanskrit": "वृत्तं रजौ रजौ पादे रजौ गो लः कृतिर्भवेत् ।\nत्रिसप्तकैः स्नग्धरा स्यात्प्रकृतिर्म्नभनैस्त्रियैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006025035, "chapter_id": 26025, "verse_number": "१-२०९-३६", "content_sanskrit": "दिगर्कैर्भद्रकं भ्रौ न्रौ नरना गो यथाकति ।\nनजौ भश्वाश्वललितं जभौ जभलगा भवेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006025036, "chapter_id": 26025, "verse_number": "१-२०९-३७", "content_sanskrit": "मत्ताक्रीडञ्चाष्टबाणदशकैर्मौ तनौ ननौ ।\nनलौ गुरुश्च विकृतिश्छिन्ना संकृतिरुच्यते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006025037, "chapter_id": 26025, "verse_number": "१-२०९-३८", "content_sanskrit": "पञ्चाश्वार्कैर्भतौ तन्वी नसभा भनयाणाः ।\nक्रौञ्चपदा बाणशरवसुशैलैर्भमौ सभौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006025038, "chapter_id": 26025, "verse_number": "१-२०९-३९", "content_sanskrit": "नौ नौ गोऽतिकृतिः प्रोक्ता च्छन्दो ह्युत्कृतिरुचते ।\nवस्वीशाश्वैर्ममतनैः स्याद्भुजङ्गविजृम्भितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006025039, "chapter_id": 26025, "verse_number": "१-२०९-४०", "content_sanskrit": "ननरसैर्लगयुक्तैश्च अपवाहाख्यकं यतिः ।\nगुहैः षड्भी रसैर्बाणैर्मोनाः षट्सगगा गणाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006025040, "chapter_id": 26025, "verse_number": "१-२०९-४१", "content_sanskrit": "चण्डवृत्तिप्रपातोऽसौ दण्डको नौ ततोरः ।\nरफेवृद्धान्तकादस्य व्यालजीमूतकादयः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]