[{"id": 2062920, "chapter_id": 2339, "verse_number": "८-६०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062921, "chapter_id": 2339, "verse_number": "८-६०-१", "content_sanskrit": "हस्तिभिस्तु महामात्रास्तव पुत्रेण चोदिताः।\nधृष्टद्युम्नं घ्नतेत्याशु क्रुद्धाः पार्षतमभ्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062922, "chapter_id": 2339, "verse_number": "८-६०-२", "content_sanskrit": "प्राच्याश्च दाक्षिणात्याश्च प्रवरा गजयोधिनः।\nअङ्गा वङ्गाश्च पुण्ड्राश्च मागधास्ताम्रलिप्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062923, "chapter_id": 2339, "verse_number": "८-६०-३", "content_sanskrit": "मेकलाः कोशला मद्रा दशार्णा निषधास्तथा।\nगजयुद्धेषु कुशलाः कलिङ्गैः सह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062924, "chapter_id": 2339, "verse_number": "८-६०-४", "content_sanskrit": "शरतोमरनाराचैर्वृष्टिमन्त इवाम्बुदाः।\nसिषिचुस्ते ततः सर्वे पाञ्चालबलमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062925, "chapter_id": 2339, "verse_number": "८-६०-५", "content_sanskrit": "तानभिद्रवतो नागान्मदवेगसमुद्धतान्।\nविपाठक्षुरनाराचैर्धृष्टद्युम्नो ह्यवीवृषत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062926, "chapter_id": 2339, "verse_number": "८-६०-६", "content_sanskrit": "एकैकं दशभिः ष़ड्भिरष्टाभिरपि पार्षतः।\nद्विरदानभिविव्याध क्षिप्रं गिरिनिभाञ्शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062927, "chapter_id": 2339, "verse_number": "८-६०-७", "content_sanskrit": "प्रच्छाद्यमानं द्विरदैर्मेघैरिव दिवाकरम्।\nपर्ययुः पाण्डुपाञ्चाला नदन्तो ह्यात्तकार्मुकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062928, "chapter_id": 2339, "verse_number": "८-६०-८", "content_sanskrit": "तान्नागानभिवर्षन्तो ज्यातलत्रविनादिनः।\nवीरनृत्यं प्रनृत्यन्तः शूरतालप्रचोदितैः।\nनकुलः सहदेवश्च द्रौपदेयाः प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062929, "chapter_id": 2339, "verse_number": "८-६०-९", "content_sanskrit": "सात्यकिश्च शिखण्डी च चेकितानश्च वीर्यवान्।\nसमन्तात्सिषिचुर्वीरा मेघास्तोयैरिवाचलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062930, "chapter_id": 2339, "verse_number": "८-६०-१०", "content_sanskrit": "ते म्लेच्छैः प्रेषिता नागा नरानश्वान्रथानपि।\nहस्तैराक्षिप्य ममृदुः पद्भिश्चाप्यतिमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062931, "chapter_id": 2339, "verse_number": "८-६०-११", "content_sanskrit": "बिभिदुश्च विषाणाग्रैः समाक्षिप्य च चिक्षिपुः।\nविषाणलग्नाश्चाप्यन्ये परिपेतुर्विभीषणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062932, "chapter_id": 2339, "verse_number": "८-६०-१२", "content_sanskrit": "प्रमुखे वर्तमानं तु द्विपमङ्गस्य सात्यकिः।\nनाराचेनोग्रवेगेन भित्त्वा मर्माण्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062933, "chapter_id": 2339, "verse_number": "८-६०-१३", "content_sanskrit": "तस्यावर्जितकायस्य द्विरदादुत्पतिष्यतः।\nनाराचेनाहनद्वक्षः सात्यकिः सोऽपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062934, "chapter_id": 2339, "verse_number": "८-६०-१४", "content_sanskrit": "पुण्ड्रस्यापततो नागं चलन्तमिव पर्वतम्।\nसहदेवः प्रसन्नाग्रैर्नाराचैरहनत्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062935, "chapter_id": 2339, "verse_number": "८-६०-१५", "content_sanskrit": "विपताकं वियन्तारं विवर्मध्वजजीवितम्।\nतं कृत्वा द्विरदं भूयः सहदेवोऽङ्गमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062936, "chapter_id": 2339, "verse_number": "८-६०-१६", "content_sanskrit": "सहदेवं तु नकुलो वारयित्वाङ्गमार्दयत्।\nनाराचैर्यमदण्डाभैस्त्रिभिर्नागं शतेन तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062937, "chapter_id": 2339, "verse_number": "८-६०-१७", "content_sanskrit": "दिवाकरकप्रख्यानङ्गश्चिक्षेप तोमरान्।\nनकुलाय शतान्यष्टौ त्रिधैकैकं तु सोऽच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062938, "chapter_id": 2339, "verse_number": "८-६०-१८", "content_sanskrit": "तथाऽर्धचन्द्रेण शिरस्तस्य चिच्छेद पाण्डवः।\nस पपात हतो म्लेच्छस्तेनैव सह दन्तिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062939, "chapter_id": 2339, "verse_number": "८-६०-१९", "content_sanskrit": "अथाङ्गपुत्रे निहते हस्तिशिक्षाविशारदे।\nअङ्गाः क्रुद्धा महामात्रा नागैर्नकुलमभ्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062940, "chapter_id": 2339, "verse_number": "८-६०-२०", "content_sanskrit": "चलत्पताकैः सुमुखैर्हेमकक्ष्यातनुच्छदैः।\nमिमर्दिषन्तस्त्वरिताः प्रदीप्तैरिव पर्वतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062941, "chapter_id": 2339, "verse_number": "८-६०-२१", "content_sanskrit": "मेकलोत्कलकालिङ्गा निषधास्ताम्रलिप्तकाः।\nशरतोमरवर्षाणि विमुञ्चन्तो जिघांसवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062942, "chapter_id": 2339, "verse_number": "८-६०-२२", "content_sanskrit": "तैश्छाद्यमानं नकुलं निशाकरमिवाम्बुदैः।\nपरिपेतुः सुसंरब्धाः पाण्डुपाञ्चालसात्यकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062943, "chapter_id": 2339, "verse_number": "८-६०-२३", "content_sanskrit": "ततस्तदभवद्युद्धं रथिनां हस्तिभिः सह।\nसृजतां शरवर्षाणि तोमरांश्च सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062944, "chapter_id": 2339, "verse_number": "८-६०-२४", "content_sanskrit": "नागानां प्रास्फुटन्कुम्भा मर्माणि च नखानि च।\nदन्ताश्चैवातिविद्धानां नाराचैर्हेमभूषणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062945, "chapter_id": 2339, "verse_number": "८-६०-२५", "content_sanskrit": "तेषामष्टौ महानागांश्चतुःषष्ट्या सुतेजनैः।\nनाराचैः सहदेवस्तान्पातयामास सादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062946, "chapter_id": 2339, "verse_number": "८-६०-२६", "content_sanskrit": "अञ्जोगतिभिरायम्य प्रयत्नाद्धनुरुत्तमम्।\nनाराचैरहनन्नागान्नकुलः कुलनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062947, "chapter_id": 2339, "verse_number": "८-६०-२७", "content_sanskrit": "ततः पाञ्चालशैनेयौ द्रौपदेयाः प्रभद्रकाः।\nशिखण्डी च महानागान्सिषिचुः शरवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062948, "chapter_id": 2339, "verse_number": "८-६०-२८", "content_sanskrit": "ते पाण्डुयोधाम्बुधरैः शत्रुद्विरदपर्वताः।\nबाणवर्षैर्हताः पेतुर्वज्रवर्षैरिवाचलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062949, "chapter_id": 2339, "verse_number": "८-६०-२९", "content_sanskrit": "एवं हत्वा तव गजांस्ते पाण्डुरथकुञ्जराः।\nद्रुतं सेनां च वर्षन्तो भिन्नकूलामिवापगाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062950, "chapter_id": 2339, "verse_number": "८-६०-३०", "content_sanskrit": "तां ते सेनां समालोड्य पाण्डुपुत्रस्य सैनिकाः।\nविक्षोभयित्वा च पुनः कर्णं समभिदुद्रुवुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062951, "chapter_id": 2339, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे षष्टितमोऽध्यायः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]