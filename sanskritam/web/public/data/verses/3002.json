[{"id": 2093667, "chapter_id": 3002, "verse_number": "१३-१३२-१", "content_sanskrit": "वसिष्ठ उवाच।\nअपि चेदं पुरा राम श्रुतं मे ब्रह्मदर्शनम्।\nपितामहस्य यद्वृत्तं ब्रह्मणः परमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093668, "chapter_id": 3002, "verse_number": "१३-१३२-२", "content_sanskrit": "देवस्य महतस्तात वारुणीं बिभ्रतस्तनुम्।\nऐश्वर्ये वारुणेवाऽथ रुद्रस्येशस्य वै प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093669, "chapter_id": 3002, "verse_number": "१३-१३२-३", "content_sanskrit": "आजग्मुर्मुनयः सर्वे देवाश्चाग्निपुरोगमाः।\nयज्ञाङ्गानि च सर्वाणि वषट्कारश्च मूर्तिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093670, "chapter_id": 3002, "verse_number": "१३-१३२-४", "content_sanskrit": "मूर्तिमन्ति च सामानि यजूंषि च सहस्रशः।\nऋग्वेदश्चागमत्तत्र पदक्रमविभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093671, "chapter_id": 3002, "verse_number": "१३-१३२-५", "content_sanskrit": "लक्षणानि स्वरास्तोभा निरुक्ताः स्वरभक्तयः।\nओंकारश्छन्दसां नेत्रं निग्रहप्रग्रहौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093672, "chapter_id": 3002, "verse_number": "१३-१३२-६", "content_sanskrit": "वेदाश्च सोपनिषदो विद्या सावित्र्यथापि च।\nभूतं भव्यं भविष्यच्च दधार भगवाञ्शिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093673, "chapter_id": 3002, "verse_number": "१३-१३२-७", "content_sanskrit": "संजुहावात्मनाऽऽत्मानं स्वयमेव तदा प्रभो।\nयज्ञं च शोभयामास बहुरूपं पिनाकधृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093674, "chapter_id": 3002, "verse_number": "१३-१३२-८", "content_sanskrit": "द्यौर्नभः पृथिवी खं च तथा चैवैष भूपतिः।\nसर्वविद्येश्वरः श्रीमानेष चापि विभावसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093675, "chapter_id": 3002, "verse_number": "१३-१३२-९", "content_sanskrit": "एष ब्रह्मा शिवो रुद्रो वरुणोऽग्निः प्रजापतिः।\nकीर्त्यते भगवान्देवः सर्वभूतपतिः शिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093676, "chapter_id": 3002, "verse_number": "१३-१३२-१०", "content_sanskrit": "तस्य यज्ञः पशुपतेस्तपः क्रतव एव च।\nदीक्षा दीप्तव्रता देवी दिशश्च सदिगीश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093677, "chapter_id": 3002, "verse_number": "१३-१३२-११", "content_sanskrit": "देवपत्न्यश्च कन्याश्च देवानां चैव मातरः।\nआजग्मुः सहितास्तत्र तदा भृगुकुलोद्वह।\nयज्ञं पशुपतेः प्रीता वरुणस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093678, "chapter_id": 3002, "verse_number": "१३-१३२-१२", "content_sanskrit": "स्वयंभुवस्तु ता दृष्ट्वा रेतः समपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093679, "chapter_id": 3002, "verse_number": "१३-१३२-१३", "content_sanskrit": "तस्य शुक्रस्य निष्यन्दान्पांसून्सङ्गृह्य भूमितः।\nप्रास्यत्पूषा कराभ्यां वै तस्मिन्नेव हुताशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093680, "chapter_id": 3002, "verse_number": "१३-१३२-१४", "content_sanskrit": "ततस्तस्मिन्सम्प्रवृत्ते सत्रे ज्वलितपावके।\nब्रह्मणो जुह्वतस्तत्र प्रादुर्भावो बभूवह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093681, "chapter_id": 3002, "verse_number": "१३-१३२-१५", "content_sanskrit": "स्कन्नमात्रं च तच्छुक्रं स्रुवेण परिगृह्य सः।\nआज्यवन्मन्त्रतश्चापि सोऽजुहोद्भृगुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093682, "chapter_id": 3002, "verse_number": "१३-१३२-१६", "content_sanskrit": "ततः स जनयामास भूतग्रामं च वीर्यवान्।\nतस्य तत्तेजसस्तस्माज्जज्ञे लोकेषु तैजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093683, "chapter_id": 3002, "verse_number": "१३-१३२-१७", "content_sanskrit": "तमसस्तामसा भावा व्यापि सत्वं तथोभयम्।\nस गुणस्तेजसो नित्यं तमस्याकाशमेव च।\nसर्वभूतेषु च तथा सत्वं तेजस्तथोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093684, "chapter_id": 3002, "verse_number": "१३-१३२-१८", "content_sanskrit": "शुक्रे हुतेऽग्नौ तस्मिंस्तु प्रादुरासंस्त्रयः प्रभो।\nपुरुषा वपुषा युक्ताः स्वैः स्वैः प्रसवजैर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093685, "chapter_id": 3002, "verse_number": "१३-१३२-१९", "content_sanskrit": "भर्जनाद्भृगुरित्येवमङ्गारेभ्योऽङ्गिराऽभवत्।\nअङ्गारसंश्रयाच्चैव कविरित्यपरोऽभवत्।\nसह ज्वालाभइरुत्पन्नो भृगुस्तस्माद्भृगुः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093686, "chapter_id": 3002, "verse_number": "१३-१३२-२०", "content_sanskrit": "मरीचिभ्यो मरीचिस्तु मारीचः कश्यपो ह्यभूत्।\nअङ्गोरभ्योऽङ्गिरास्तात वालखिल्याः कुशोच्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093687, "chapter_id": 3002, "verse_number": "१३-१३२-२१", "content_sanskrit": "अत्रैवात्रेति च विभो जातमत्रिं वदन्त्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093688, "chapter_id": 3002, "verse_number": "१३-१३२-२२", "content_sanskrit": "तथा भस्मव्यपोहेभ्यो ब्रह्मर्षिगणसम्मताः।\nवैखानसाः समुत्पन्नास्तपः श्रुतगुणेप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093689, "chapter_id": 3002, "verse_number": "१३-१३२-२३", "content_sanskrit": "अश्रुतोऽस्य समुत्पन्नावश्विनौ रूपसम्मतौ।\nशेषाः प्रजानां पतयः स्रोतोभ्यस्तस्य जज्ञिरे।\nऋषयो रोमकूपेभ्यः स्वेदाच्छन्दो बलान्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093690, "chapter_id": 3002, "verse_number": "१३-१३२-२४", "content_sanskrit": "एतस्मात्कारणादाहुरग्निः सर्वास्तु देवताः।\nऋषयः श्रुतसम्पन्ना वेदप्रामाण्यदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093691, "chapter_id": 3002, "verse_number": "१३-१३२-२५", "content_sanskrit": "यानि दारूणि निर्यासास्ते मासाः पक्षसंज्ञिताः।\nअहोरात्रा मुहूर्ताश्च वीतज्योतिश्च वारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093692, "chapter_id": 3002, "verse_number": "१३-१३२-२६", "content_sanskrit": "रौद्रं लोहितमित्याहुर्लोहितात्कनकं स्मृतम्।\nतन्मैत्रमिति विज्ञेयं धूमाच्च वसवः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093693, "chapter_id": 3002, "verse_number": "१३-१३२-२७", "content_sanskrit": "अर्चिषो याश्च ते रुद्रास्तथाऽऽदित्या महाप्रभाः।\nउद्दीप्तास्ते तथाऽङ्गारा ये धिष्ण्येषु दिवि स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093694, "chapter_id": 3002, "verse_number": "१३-१३२-२८", "content_sanskrit": "अग्निर्नाथश्च लोकस्य तत्परं ब्रह्म तद्भुवम्।\nसर्वकामदमित्याहुस्तत्र हव्यमुपावहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093695, "chapter_id": 3002, "verse_number": "१३-१३२-२९", "content_sanskrit": "ततोऽब्रवीन्महादेवो वरुणः पवनात्मकः।\nमम सत्रमिदं दिव्यमहं गृहपतिस्त्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093696, "chapter_id": 3002, "verse_number": "१३-१३२-३०", "content_sanskrit": "त्रीणि पूर्वाण्यपत्यानि मम तानि न संशयः।\nइति जानीत खगमा मम यज्ञफलं हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093697, "chapter_id": 3002, "verse_number": "१३-१३२-३१x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093698, "chapter_id": 3002, "verse_number": "१३-१३२-३१", "content_sanskrit": "मदङ्गेभ्यः प्रसूतानि मदाश्रयकृतानि च।\nममैव तान्मपत्यानि मम शुक्लं हुतं हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093699, "chapter_id": 3002, "verse_number": "१३-१३२-३२", "content_sanskrit": "अथाब्रवील्लोकगुरुर्ब्रह्मा लोकपितामहः।\nममैव तान्यपत्यानि मम शुक्लं हुतं हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093700, "chapter_id": 3002, "verse_number": "१३-१३२-३३", "content_sanskrit": "अहं वक्ता च मन्त्रस्य होता शुक्रस्य चैव ह।\nयस्य बीजं फलं तस्य शुक्रं चेत्कारणं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2093701, "chapter_id": 3002, "verse_number": "१३-१३२-३४", "content_sanskrit": "ततोऽब्रुवन्देवगणाः पितामहमुपेत्य वै।\nकृताञ्जलिपुटाः सर्वे शिरोभिरभिवन्द्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2093702, "chapter_id": 3002, "verse_number": "१३-१३२-३५", "content_sanskrit": "वयं च भगवन्सर्वे जगच्च सचराचरम्।\nतवैव प्रसवाः सर्वे तस्मादग्निर्विभावसुः।\nवरुणश्चेश्वरो देवो लभतां काममीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2093703, "chapter_id": 3002, "verse_number": "१३-१३२-३६", "content_sanskrit": "निसर्गाद्ब्रह्मणश्चापि वरुणो यादसाम्पतिः।\nजग्राह वै भृगु पूर्वमपत्यं सूर्यवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2093704, "chapter_id": 3002, "verse_number": "१३-१३२-३७", "content_sanskrit": "ईश्वरोऽङ्गिरसं चाग्नेरपत्यार्थमकल्पयत्।\nपितामहस्त्वपत्यं वैकविं जग्राह तत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2093705, "chapter_id": 3002, "verse_number": "१३-१३२-३८", "content_sanskrit": "तदा स वारुणिः ख्यातो भृगुः प्रसवकर्मकृत्।\nआग्नेयस्त्वङ्गिराः श्रीमान्कविर्ब्राह्मो महायशाः।\nभार्गवाङ्गिरसौ लोके लोकसन्तानलक्षणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2093706, "chapter_id": 3002, "verse_number": "१३-१३२-३९", "content_sanskrit": "एते विप्रवराः सर्वे प्रजानां पतयस्त्रयः।\nसर्वं सन्तानमेतेषामिदमित्युपधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2093707, "chapter_id": 3002, "verse_number": "१३-१३२-४०", "content_sanskrit": "भृगोस्तु पुत्राः सप्तासन्सर्वे तुल्या भृगोर्गुणैः।\nच्यवनो वज्रशीर्षश्च शुचिरौर्वस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2093708, "chapter_id": 3002, "verse_number": "१३-१३२-४१", "content_sanskrit": "शुक्रो वरेण्यश्च विभुः सवनश्चेति सप्त ते।\nभार्गवा वारुणाः सर्वे येषां वंशे भवानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2093709, "chapter_id": 3002, "verse_number": "१३-१३२-४२", "content_sanskrit": "अषअटौ चाङ्गिरसः पुत्रा वारुणास्तेऽप्यवारुणाः।\nबृहस्पतिरुचथ्यश्च वयस्यः शान्तिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2093710, "chapter_id": 3002, "verse_number": "१३-१३२-४३", "content_sanskrit": "घोरो विरूपः संवर्तः सुधन्वा चाष्टमः स्मृतः।\nएतेऽष्टौ वह्निजाः सर्वे ज्ञाननिष्ठा निरामयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2093711, "chapter_id": 3002, "verse_number": "१३-१३२-४४", "content_sanskrit": "ब्राह्मणाश्च कवेः पुत्रा वारुणास्तेऽप्युदाहृताः।\nअष्टौ प्रसवजैर्युक्ता गुणैर्ब्रह्मविदः शुभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2093712, "chapter_id": 3002, "verse_number": "१३-१३२-४५", "content_sanskrit": "कविः काव्यश्च विष्णुश्च बुद्धिमानुशना तथा।\nभृगुश्च वरुणश्चैव काश्यपोऽग्निश्च धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2093713, "chapter_id": 3002, "verse_number": "१३-१३२-४६", "content_sanskrit": "अष्टौ कविसुता ह्येते सर्वमेभिर्जगत्ततम्।\nप्रजापतय एते हि प्रजानां यैरिमाः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2093714, "chapter_id": 3002, "verse_number": "१३-१३२-४७", "content_sanskrit": "एवमङ्गिरसश्चैव कवेश्च प्रसवान्वयैः।\nभृगोश्च भृगुशार्दूल वंशजैः सततं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2093715, "chapter_id": 3002, "verse_number": "१३-१३२-४८", "content_sanskrit": "वरुणश्चादितो विप्र जग्राह प्रभुरीश्वरः।\nकविं तात भृगुं चापि तस्मात्तौ वारुणौ स्मृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2093716, "chapter_id": 3002, "verse_number": "१३-१३२-४९", "content_sanskrit": "जग्राहाङ्गिरसं देवः शिखी तस्माद्भुताशनः।\nतस्मादाङ्गिरसा ज्ञेयाः सर्व एव तदन्वयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2093717, "chapter_id": 3002, "verse_number": "१३-१३२-५०", "content_sanskrit": "ब्रह्मा पितामहः पूर्वं देवताभिः प्रसादितः।\nइमे नः सन्तरिष्यन्ति प्रजाभिर्जगदीश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2093718, "chapter_id": 3002, "verse_number": "१३-१३२-५१", "content_sanskrit": "सर्वे प्रजानां पतयः सर्वे चातितपस्विनः।\nत्वत्प्रसादादिमं लोकं धारयिष्यन्ति शाश्वतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2093719, "chapter_id": 3002, "verse_number": "१३-१३२-५२", "content_sanskrit": "तथैव वंशकर्तारस्तव तेजोविवर्धनाः।\nभवेयुर्वेदविदुषः सर्वे च कृतिनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2093720, "chapter_id": 3002, "verse_number": "१३-१३२-५३", "content_sanskrit": "देवपक्षचराः सौम्याः प्राजापत्या महर्षयः।\nअनन्तं ब्रह्म सत्यं च तपश्च परमं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2093721, "chapter_id": 3002, "verse_number": "१३-१३२-५४", "content_sanskrit": "सर्वे हि वयमेते च तवैव प्रसवाः प्रभो।\nदेवानां ब्राह्मणानां च त्वं हि कर्ता पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2093722, "chapter_id": 3002, "verse_number": "१३-१३२-५५", "content_sanskrit": "मारीचमादितः कृत्वा सर्वे चैवाथ भार्गवाः।\nअपत्यानीति सम्प्रेक्ष्य क्षमयाम पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2093723, "chapter_id": 3002, "verse_number": "१३-१३२-५६", "content_sanskrit": "अथ स्वेनैव रूपेणि प्रजनिष्यन्ति वै प्रजाः।\nस्थापयिष्यन्ति चात्मानं युगादिनिधने तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2093724, "chapter_id": 3002, "verse_number": "१३-१३२-५७", "content_sanskrit": "इत्युक्तः स तदा तैस्तु ब्रह्मा लोकपितामहः।\nततेत्येवाब्रवीत्प्रीतस्तेऽपि जग्मुर्यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2093725, "chapter_id": 3002, "verse_number": "१३-१३२-५८", "content_sanskrit": "एवमेतत्पुरावृत्तं तस्य यज्ञे महात्मनः।\nदेवश्रेष्ठस्य लोकादौ वारुणीं बिभ्रतस्तनुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2093726, "chapter_id": 3002, "verse_number": "१३-१३२-५९", "content_sanskrit": "अग्निर्ब्रह्म पशुपतिः शर्वो रुद्रः प्रजापतिः।\nअग्नेरपत्यमेतद्वै सुवर्णमिति धारणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2093727, "chapter_id": 3002, "verse_number": "१३-१३२-६०", "content_sanskrit": "अग्न्यभावे च कुरुते वह्निस्थानेषु काञ्चनम्।\nजामदग्न्यप्रमाणज्ञो वेदश्रुतिनिदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2093728, "chapter_id": 3002, "verse_number": "१३-१३२-६१", "content_sanskrit": "कुशस्तम्बे जुहोत्यग्निं सुवर्णे तत्र च स्थिते।\nवल्मीकस्य वपायां च कर्णे वाजस्य दक्षिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2093729, "chapter_id": 3002, "verse_number": "१३-१३२-६२", "content_sanskrit": "शकटोर्व्या परस्याप्सु ब्राह्मणस्य करे तथा।\nहुते प्रीतिकरीमृद्धिं भगवांस्तत्र मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2093730, "chapter_id": 3002, "verse_number": "१३-१३२-६३", "content_sanskrit": "तस्मादग्निपराः सर्वे देवता इति शुश्रुम।\nब्रह्मणो हि प्रभूतोऽग्निरग्नेरपि च काञ्चनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2093731, "chapter_id": 3002, "verse_number": "१३-१३२-६४", "content_sanskrit": "तस्माद्ये वै प्रयच्छन्ति सुवर्णं धर्मदर्शिनः।\nदेवतास्ते प्रयच्छन्ति समस्ता इति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2093732, "chapter_id": 3002, "verse_number": "१३-१३२-६५", "content_sanskrit": "तस्य वा तपसो लोकान्गच्छतः परमां गतिम्।\nस्वर्लोके राजराज्येन सोभिषिच्येत भार्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2093733, "chapter_id": 3002, "verse_number": "१३-१३२-६६", "content_sanskrit": "आदित्योदयने प्राप्ते विधिमन्त्रपुरस्कृतम्।\nददाति काञ्चनं यो वाः दुःस्वप्नं प्रतिहन्ति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2093734, "chapter_id": 3002, "verse_number": "१३-१३२-६७", "content_sanskrit": "ददात्युदितमात्रे यस्यस्य पाप्मा विधूयते।\nमध्याह्ने ददतो रुक्मं हन्ति पापमनागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2093735, "chapter_id": 3002, "verse_number": "१३-१३२-६८", "content_sanskrit": "ददाति पस्चिमां सन्ध्यां यः सुवर्णं यतव्रतः।\nब्रह्मवाय्वग्निसोमानां सालोक्यमुपयाति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2093736, "chapter_id": 3002, "verse_number": "१३-१३२-६९", "content_sanskrit": "सेन्द्रेषु चैव लोकेषु प्रतिष्ठा विन्दते शुभाम्।\nइह लोके यशः प्राप्य शान्तपाप्मा च मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2093737, "chapter_id": 3002, "verse_number": "१३-१३२-७०", "content_sanskrit": "ततः सम्पद्यतेऽन्येषु लोकेष्वप्रतिमः सदा।\nअनावृतगतिश्चैव कामचारो भवत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2093738, "chapter_id": 3002, "verse_number": "१३-१३२-७१", "content_sanskrit": "न च क्षरति तेभ्यश्च यशश्चैवाप्नुते महत्।\nसुवर्णमक्षयं दत्त्वा लोकांश्चाप्नोति पुष्कलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2093739, "chapter_id": 3002, "verse_number": "१३-१३२-७२", "content_sanskrit": "यस्तु सञ्जनयित्वाऽग्निमादित्योदयनं प्रति।\nदद्याद्वै व्रतमुद्दिश्य सर्वकामान्समश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2093740, "chapter_id": 3002, "verse_number": "१३-१३२-७३", "content_sanskrit": "अग्निरित्येव तत्प्राहुः प्रदानं च सुखावहम्।\nयथेष्टगुणसंवृत्तं प्रवर्तकमिति स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2093741, "chapter_id": 3002, "verse_number": "१३-१३२-७४", "content_sanskrit": "एषा सुवर्णस्योत्पत्तिः कथिता ते मयाऽनघ।\nकार्तिकेयस्य च विभो तद्विद्धि भृगुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2093742, "chapter_id": 3002, "verse_number": "१३-१३२-७५", "content_sanskrit": "कार्तिकेयस्तु संवृद्धः कालेन महता तदा।\nदेवैः सेनापतित्वेन वृतः सेन्द्रैर्भृगूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2093743, "chapter_id": 3002, "verse_number": "१३-१३२-७६", "content_sanskrit": "जघान तारकं चापि दैत्यमन्यांस्तथाऽसुरान्।\nत्रिदशेन्द्राज्ञया ब्रह्मँल्लोकानां हितकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2093744, "chapter_id": 3002, "verse_number": "१३-१३२-७७", "content_sanskrit": "सुवर्णदाने च मया कथितास्ते गुणा विभो।\nतस्मात्सुवर्णं विप्रेभ्यः प्रयच्छ तदतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2093745, "chapter_id": 3002, "verse_number": "१३-१३२-७८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2093746, "chapter_id": 3002, "verse_number": "१३-१३२-७८", "content_sanskrit": "इत्युक्तः स वसिष्ठेन जामदग्न्यः प्रतापवान्।\nददौ सुवर्णं विप्रभ्यो व्यमुच्यत च किल्बिषात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2093747, "chapter_id": 3002, "verse_number": "१३-१३२-७९", "content_sanskrit": "एतत्ते सर्वमाख्यातं सुवर्णस्य महीपते।\nप्रदानस्य फलं चैव जन्म चास्य युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2093748, "chapter_id": 3002, "verse_number": "१३-१३२-८०", "content_sanskrit": "तस्मात्त्वमपि विप्रेभ्यः प्रयच्छ कनकं बहुः।\nददत्सुवर्णं नृपते किल्बिषाद्विप्रमोक्ष्यसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2093749, "chapter_id": 3002, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्वात्रिंशदधिकशततमोऽध्यायः॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]