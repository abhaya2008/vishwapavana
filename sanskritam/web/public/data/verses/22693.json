[{"id": 7002693000, "chapter_id": 22693, "verse_number": "८-४-१", "content_sanskrit": "सूत उवाच ।\nभृगुवर्य शृणु त्वं वै वंशं परिहरस्य च ।\nजित्वा बौद्धान्परिहरोऽथर्ववेदपरायणः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002693001, "chapter_id": 22693, "verse_number": "८-४-२", "content_sanskrit": "शक्तिं सर्वमयीं नित्यां ध्यात्वा प्रेमपरोऽभवत् ।\nप्रसन्ना सा तदा देवी सार्धयोजनमायतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002693002, "chapter_id": 22693, "verse_number": "८-४-३", "content_sanskrit": "नगरं चित्रकूटाद्रौ चकार कलिनिर्जरम् ।\nकलिर्यत्र भवेद्बद्धो नगरेऽस्मिन्सुरप्रिये ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002693003, "chapter_id": 22693, "verse_number": "८-४-४", "content_sanskrit": "अतः कलिंजरो नाम्ना प्रसिद्धोऽभून्महीतले ।\nद्वादशाब्दं कृतं राज्यं तेन पूर्वप्रदेशके ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002693004, "chapter_id": 22693, "verse_number": "८-४-५", "content_sanskrit": "गौरवर्मा तस्य सुतः कृतं राज्यं पितुः समम् ।\nस्वानुजं घोरवर्माणं तत्रास्थाप्य मुदान्वितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002693005, "chapter_id": 22693, "verse_number": "८-४-६", "content_sanskrit": "गौडदेशं समागम्य तत्र राज्यमकारयत् ।\nसुपर्णो नाम नृपतिस्ततोऽभूद्गौरवर्मणः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002693006, "chapter_id": 22693, "verse_number": "८-४-७", "content_sanskrit": "पितुस्तुल्यं कृतं राज्यं रूपणस्तत्सुतोऽभवत् ।\nपितुस्तुल्यं कृतं राज्यं कारवर्मा सुतोऽभवत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002693007, "chapter_id": 22693, "verse_number": "८-४-८", "content_sanskrit": "शको नाम ततो राजा महालक्ष्मीं सनातनीम् ।\nत्रिवर्षांते च सा देवी कामाक्षीरूपधारिणी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002693008, "chapter_id": 22693, "verse_number": "८-४-९", "content_sanskrit": "स्वभक्तपालना चैव तत्र वासमकारयत् ।\nशतार्द्धाब्दं कृतं राज्यं तेन वै कामवर्मणा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002693009, "chapter_id": 22693, "verse_number": "८-४-१०", "content_sanskrit": "मिथुनं जनयामास भोगो भोगवती हि सा ।\nविक्रमायैव नृपतिः सुतां भोगवतीं ददौ ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002693010, "chapter_id": 22693, "verse_number": "८-४-११", "content_sanskrit": "स्वराज्यं च स्वपुत्राय प्रददौ भोगवर्मणे ।\nपितुस्तुल्यं कृतं राज्यं कालिवर्मा सुतोऽवत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002693011, "chapter_id": 22693, "verse_number": "८-४-१२", "content_sanskrit": "महोत्सवं महाकाल्याः कृतवान्स च भूपतिः ।\nतस्मै प्रसन्ना वरदा काली भूत्वा स्वयं स्थिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002693012, "chapter_id": 22693, "verse_number": "८-४-१३", "content_sanskrit": "कलिका बहुपुष्पाणां सा चकार स्वहर्षतः ।\nताभिर्भवं च नगरं संजातं च मनोहरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002693013, "chapter_id": 22693, "verse_number": "८-४-१४", "content_sanskrit": "कलिकाता पुरी नाम्ना प्रसिद्धाभून्महीतले ।\nकौशिकस्तस्य तनयः पितुस्तुल्यं कृतं पदम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002693014, "chapter_id": 22693, "verse_number": "८-४-१५", "content_sanskrit": "कात्यायनस्तस्य सुतः पितुस्तुल्यं कृतं पदम् ।\nतस्य पुत्रो हेमवतः पितुस्तुल्यं कृतं पदम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002693015, "chapter_id": 22693, "verse_number": "८-४-१६", "content_sanskrit": "शिववर्मा च तत्पुत्रः पितुस्तुल्यं कृतं पदम् ।\nभववर्मा च तत्पुत्रः पितुस्तुल्यं कृतं पदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002693016, "chapter_id": 22693, "verse_number": "८-४-१७", "content_sanskrit": "रुद्रवर्मा च तत्पुत्रः कृतं राज्यं पितुः समम् ।\nभोजवर्मा च तत्पुत्रस्त्यक्त्वा वै पैतृकं पदम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002693017, "chapter_id": 22693, "verse_number": "८-४-१८", "content_sanskrit": "भोजराष्ट्रं वनोद्देशे कारयामास वीर्यवान् ।\nपितुस्तुल्यं कृतं राज्यं गववर्मा नृपोभवत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002693018, "chapter_id": 22693, "verse_number": "८-४-१९", "content_sanskrit": "पितुस्तुल्यं कृतं राज्यं विंध्यवर्मा नृपोऽभवत् ।\nस्वानुजाय स्वकं राज्यं दत्त्वा वंगमुपाययौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002693019, "chapter_id": 22693, "verse_number": "८-४-२०", "content_sanskrit": "पितुस्तुल्यं कृतं राज्यं सुखसेनस्ततोऽभवत् ।\nपितुस्तुल्यं कृतं राज्यं बलाकस्तस्य चात्मजः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002693020, "chapter_id": 22693, "verse_number": "८-४-२१", "content_sanskrit": "दशवर्षं कृतं राज्यं लक्ष्मणस्तत्सुतोऽभवत् ।\nपितुस्तुल्यं कृतं राज्यं माधवस्तत्सुतोऽभवत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002693021, "chapter_id": 22693, "verse_number": "८-४-२२", "content_sanskrit": "पितुस्तुल्यं कृतं राज्यं वेशवस्तत्सुतोऽ भवत् ।\nपितुस्तुल्यं कृतं राज्यं सुरसेनस्ततोऽभवत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002693022, "chapter_id": 22693, "verse_number": "८-४-२३", "content_sanskrit": "पितुस्तुल्यं कृतं राज्यं ततो नारायणोऽभवत् ।\nपितुस्तुल्यं कृतं राज्यं शांतिवर्मा सुतोभवत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002693023, "chapter_id": 22693, "verse_number": "८-४-२४", "content_sanskrit": "गंगाकूले शांतिपुरं रचितं तेन धीमता ।\nनिवासं कृतवान्भूपः पितुस्तुल्यं कृतं पदम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002693024, "chapter_id": 22693, "verse_number": "८-४-२५", "content_sanskrit": "नदीवर्मा तस्य सुतो गंगादत्तवरो बली ।\nचकार नगरीं रम्यां नदीहां गौडराष्ट्रगाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002693025, "chapter_id": 22693, "verse_number": "८-४-२६", "content_sanskrit": "गंगया च तदाहूतोभिज्ञो विद्याधरः स्वयम् ।\nतेनैव रक्षिता चासीत्पुरी वेदपरायणा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002693026, "chapter_id": 22693, "verse_number": "८-४-२७", "content_sanskrit": "विंशद्वर्षं कृतं राज्यं तेन राज्ञा महात्मना ।\nगंगावंशस्ततो जातो विश्रुतोऽभून्महीतले ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002693027, "chapter_id": 22693, "verse_number": "८-४-२८", "content_sanskrit": "शार्ङ्गदेवस्तस्य सुतो बलवान्हरिपूजकः ।\nगौडदेशमुपागम्य हरिध्यानपरोभवत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002693028, "chapter_id": 22693, "verse_number": "८-४-२९", "content_sanskrit": "दशवर्षं कृतं राज्यं गंगादेवस्तु तत्सुतः ।\nविंशद्वर्षं कृतं राज्यं चानंगस्तस्य भूपतिः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002693029, "chapter_id": 22693, "verse_number": "८-४-३०", "content_sanskrit": "तनयो बलवांश्चासीद्गौडदेशमहीपतिः ।\nपितुस्तुल्यं कृतं राज्य ततो राजेश्वरोऽभवत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002693030, "chapter_id": 22693, "verse_number": "८-४-३१", "content_sanskrit": "पितुस्तुल्यं कृतं राज्यं नृसिंह स्तनयोऽभवत् ।\nपितुस्तुल्यं कृतं राज्यं कलिवर्मा सुतोऽभवत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002693031, "chapter_id": 22693, "verse_number": "८-४-३२", "content_sanskrit": "राष्ट्रदेशमुपागम्य जित्वा तस्य नृपं बली ।\nमहावतीं पुरीं रम्यामध्यास्य सुखितोऽभवत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002693032, "chapter_id": 22693, "verse_number": "८-४-३३", "content_sanskrit": "पितुस्तुल्यं कृतं राज्यं धृतिवर्मा सुतोऽभवत् ।\nपितुस्तुल्यं कृतं राज्यं तस्य पुत्रो महीपतिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002693033, "chapter_id": 22693, "verse_number": "८-४-३४", "content_sanskrit": "जयचंद्राज्ञया भूप उर्वीमायामिति स्मृताम् ।\nनगरीं कारयामास तत्र वासमकारयत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002693034, "chapter_id": 22693, "verse_number": "८-४-३५", "content_sanskrit": "कुरुक्षेत्रे हताः सर्वे क्षत्रियाश्चंद्रवंशिनः ।\nतदा महीपती राजा महावत्यधिपोऽभवत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002693035, "chapter_id": 22693, "verse_number": "८-४-३६", "content_sanskrit": "विंशद्वर्षं कृतं राज्यं सहोद्दीनेन वै ततः ।\nकुरुक्षेत्रे मृतिं प्राप्ताः सुयोधनकलांशकाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002693036, "chapter_id": 22693, "verse_number": "८-४-३७", "content_sanskrit": "घोरवर्मा तु नृपतिः सुतः परिहरस्य वै ।\nकलिंजरे कृतं राज्यं शार्दूलस्तत्सुतोऽभवत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002693037, "chapter_id": 22693, "verse_number": "८-४-३८", "content_sanskrit": "तदन्वये च ये भूपाः शार्दूलीयाः प्रकीर्तिताः ।\nभूपानां बहुधा राष्ट्रं शार्दूलान्वयसंभवम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002693038, "chapter_id": 22693, "verse_number": "८-४-३९", "content_sanskrit": "बभूव सर्वतो भूमौ महामायाप्रसादतः ।\nइति ते कथितं विप्र पावकीयमहीभुजाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002693039, "chapter_id": 22693, "verse_number": "८-४-४०", "content_sanskrit": "कुलं सकलपापघ्नं यथैव शशिसूर्ययोः ।\nपुनरन्यत्प्रवक्ष्यामि यथा जातः स्वयं हरिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]