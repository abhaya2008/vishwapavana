[{"id": 7003214000, "chapter_id": 23214, "verse_number": "१-१७-१", "content_sanskrit": "सूत उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003214001, "chapter_id": 23214, "verse_number": "१-१७-२", "content_sanskrit": "एवं संक्षेपतः प्रोक्तः सद्यादीनां समुद्भवः  ।\nयः पठेच्छृणुयाद्वापि श्रावयेद्वा द्विजोत्तमान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003214002, "chapter_id": 23214, "verse_number": "१-१७-३", "content_sanskrit": "स याति ब्रह्मसायुज्यं प्रसादात्परमेष्ठिनः  ।\nऋषय ऊचुः  ।\nकथं लिंगमभूल्लिंगे समभ्यर्च्यः स शंकरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003214003, "chapter_id": 23214, "verse_number": "१-१७-४", "content_sanskrit": "किं लिंगं कस्तथा लिंगी सूत वक्तुमिहार्हसि  ।\nरोमहर्षण उवाच  ।\nएवं देवाश्च ऋषयः प्रणिपत्य पितामहम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003214004, "chapter_id": 23214, "verse_number": "१-१७-५", "content_sanskrit": "अपृच्छन् भगवाँल्लिंगं कथमासीदिति स्वयम्  ।\nलिंगे महेश्वरो रुद्रः समभ्यर्च्यः कथं त्विति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003214005, "chapter_id": 23214, "verse_number": "१-१७-६", "content_sanskrit": "किं लिंगं कस्तथा लिंगी सोप्याह च पितामहः  ।\nपितामह उवाच  ।\nप्रधानं लिंगमाख्यातं लिंगी च परमेश्वरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003214006, "chapter_id": 23214, "verse_number": "१-१७-७", "content_sanskrit": "रक्षार्थमंबुधौ मह्यं विष्णोस्त्वासीत्सुरोत्तमाः  ।\nवैमानिके गते सर्गे जनलोकं सहर्षिभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003214007, "chapter_id": 23214, "verse_number": "१-१७-८", "content_sanskrit": "स्थितिकाले तदा पूर्णे ततः प्रत्याहृते तथा  ।\nचतुर्युगसहस्रांते सत्यलोकं गते सुराः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003214008, "chapter_id": 23214, "verse_number": "१-१७-९", "content_sanskrit": "विनाधिपत्यं समतां गतेऽन्ते ब्रह्मणो मम  ।\nशुष्के च स्थावरे सर्वे त्वनावृष्ट्या च सर्वशः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003214009, "chapter_id": 23214, "verse_number": "१-१७-१०", "content_sanskrit": "पशवो मानुषा वृक्षाः पिशाचाः पिशिताशनाः  ।\nगंधर्वाद्याः क्रमेणैव निर्दग्धा भानुभानुभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003214010, "chapter_id": 23214, "verse_number": "१-१७-११", "content_sanskrit": "एकार्णवे महाघोरे तमोभूते समंततः  ।\nसुष्वापांभसि योगात्मा निर्मलो निरुपप्लवः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003214011, "chapter_id": 23214, "verse_number": "१-१७-१२", "content_sanskrit": "सहस्रशीर्षा विश्वात्मा सहस्राक्षः सहस्रपात्  ।\nसहस्रबाहुः सर्वज्ञः सर्वदेवभवोद्भवः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003214012, "chapter_id": 23214, "verse_number": "१-१७-१३", "content_sanskrit": "हिरण्यगर्भो रजसा तमसा शंकरः स्वयम्  ।\nसत्त्वेन सर्वगो विष्णुः सर्वात्मत्वे महेश्वरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003214013, "chapter_id": 23214, "verse_number": "१-१७-१४", "content_sanskrit": "कालात्मा कालनाभस्तु शुक्लः कृष्णस्तु निर्गुणः  ।\nनारायणो महाबाहुः सर्वात्मा सदसन्मयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003214014, "chapter_id": 23214, "verse_number": "१-१७-१५", "content_sanskrit": "तथाभूतमहं दृष्ट्वा शयानं पंकजेक्षणम्  ।\nमायया मोहितस्तस्य तमवोचममर्षितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003214015, "chapter_id": 23214, "verse_number": "१-१७-१६", "content_sanskrit": "कस्त्वं वदेति हस्तेन समुत्थाप्य सनातनम्  ।\nतदा हस्तप्रहारेण तीव्रेण स दृढेन तु ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003214016, "chapter_id": 23214, "verse_number": "१-१७-१७", "content_sanskrit": "प्रबुद्धोहीयशयनात्समासीनः क्षणं वशी  ।\nददर्श निद्राविक्लिन्न नीरजामललोचनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003214017, "chapter_id": 23214, "verse_number": "१-१७-१८", "content_sanskrit": "मामग्रे संस्थितं भासाध्यासितो भगवान् हरिः  ।\nआह चोत्थाय भगवान् हसन्मां मधुरं सकृत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003214018, "chapter_id": 23214, "verse_number": "१-१७-१९", "content_sanskrit": "स्वागतंस्वागतं वत्स पितामह महाद्युते  ।\nतस्य तद्वचनं श्रुत्वा स्मितपूर्वं सुरर्षभाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003214019, "chapter_id": 23214, "verse_number": "१-१७-२०", "content_sanskrit": "रजसा बद्धवैरश्च तमवोचं जनार्दनम्  ।\nभाषसे वत्सवत्सेति सर्गसंहारकारणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003214020, "chapter_id": 23214, "verse_number": "१-१७-२१", "content_sanskrit": "मामिहांतः स्मितं कृत्वा गुरुः शिष्यमिवानघ  ।\nकर्तारं जगतां साक्षात्प्रकृतेश्च प्रवर्तकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003214021, "chapter_id": 23214, "verse_number": "१-१७-२२", "content_sanskrit": "सनातनमजं विष्णुं विरिंचिं विश्वसंभवम्  ।\nविश्वात्मानं विधातारं धातारं पंकजेक्षणम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003214022, "chapter_id": 23214, "verse_number": "१-१७-२३", "content_sanskrit": "किमर्थं भाषसे मोहाद्वक्तुमर्हासि सत्वरम्  ।\nसोपि मामाह जगतां कर्ताहमिति लोकय ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003214023, "chapter_id": 23214, "verse_number": "१-१७-२४", "content_sanskrit": "भर्ता हर्ता भवानंगादवतीर्णो ममाव्ययात्  ।\nविस्मृतोऽसि जगन्नाथं नारायणमनामयम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003214024, "chapter_id": 23214, "verse_number": "१-१७-२५", "content_sanskrit": "पुरुषं परमात्मानं पुरुहूतं पुरुष्टुतम्  ।\nविष्णुमच्युतमीशानं विश्वस्य प्रभवोद्भवम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003214025, "chapter_id": 23214, "verse_number": "१-१७-२६", "content_sanskrit": "तवापराधो नास्त्यत्र मम मायाकृतं त्विदम्  ।\nश्रृणु सत्यं चतुर्वक्त्र सर्वदेवेश्वरो ह्ययम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003214026, "chapter_id": 23214, "verse_number": "१-१७-२७", "content_sanskrit": "कर्ता नेता च हर्ता च न मयास्ति समो विभुः  ।\nअहमेव परं ब्रह्म परं तत्त्वं पितामह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003214027, "chapter_id": 23214, "verse_number": "१-१७-२८", "content_sanskrit": "अहमेव परं ज्योतिः परमात्मा त्वहं विभुः  ।\nयद्यदृष्टं श्रुतं सर्वं जगत्यस्मिंश्चराचरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003214028, "chapter_id": 23214, "verse_number": "१-१७-२९", "content_sanskrit": "तत्तद्विद्धि चतुर्वक्त्र सर्वं मन्मयमित्यथ  ।\nमया सृष्टं पुराव्यक्तं चतुर्विशतिकं स्वयम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003214029, "chapter_id": 23214, "verse_number": "१-१७-३०", "content_sanskrit": "नित्यांता ह्यणवो बद्धाः सृष्टाः क्रोधोद्भवादयः  ।\nप्रसादाद्धि भवानंडान्यनेकानीह लीलया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003214030, "chapter_id": 23214, "verse_number": "१-१७-३१", "content_sanskrit": "सृष्टा बुद्धिर्मया तस्यामहंकारस्त्रिधा ततः  ।\nतन्मात्रापंचकं तस्मान्मनः षष्ठेन्द्रियाणि च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003214031, "chapter_id": 23214, "verse_number": "१-१७-३२", "content_sanskrit": "आकाशादीनि भूतानि भौतिकानि च लीलया  ।\nइत्युक्तवति तस्मिंश्च मयि चापि वचस्तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003214032, "chapter_id": 23214, "verse_number": "१-१७-३३", "content_sanskrit": "आवयोश्चाभवद्युद्धं सुघोरं रोमहर्षणम्  ।\nप्रलयार्णवमध्ये तु रजसा बद्धवैरयोः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003214033, "chapter_id": 23214, "verse_number": "१-१७-३४", "content_sanskrit": "एतस्मिन्नन्तरे लिंगमभवच्चावयोः पुरः  ।\nविवादशमनार्थं हि प्रबोधार्थं च भास्वरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003214034, "chapter_id": 23214, "verse_number": "१-१७-३५", "content_sanskrit": "ज्वालामालासहस्राढ्यं कालानलशतोपमम्  ।\nक्षयवृद्धिविनिर्मुक्तमादिमध्यांतवर्जितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003214035, "chapter_id": 23214, "verse_number": "१-१७-३६", "content_sanskrit": "अनौपम्यमनिर्देश्यमव्यक्तं विश्वसंभवम्  ।\nतस्य ज्वालासहस्रेण मोहितो भगवान् हरिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003214036, "chapter_id": 23214, "verse_number": "१-१७-३७", "content_sanskrit": "मोहितं प्राह मामत्र परिक्षावोऽग्निसंभवम्  ।\nअधोगमिष्याम्यनलस्तंभस्यानुपमस्य च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003214037, "chapter_id": 23214, "verse_number": "१-१७-३८", "content_sanskrit": "भवानूर्द्ध्वं प्रयत्नेन गंतुमर्हसि सत्वरम्  ।\nएवं व्याहृत्य विश्वात्मा स्वरूपमकरोत्तदा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003214038, "chapter_id": 23214, "verse_number": "१-१७-३९", "content_sanskrit": "वाराहमहमप्याशु हंसत्वं प्राप्तवान्सुराः  ।\nतदाप्रभृति मामाहुर्हंसं हंसो विराडिति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003214039, "chapter_id": 23214, "verse_number": "१-१७-४०", "content_sanskrit": "हंसहंसेति यो ब्रूयान्मां हंसः स भविष्यति  ।\nसुश्वेतो ह्यनलाक्षश्च विश्वतः पक्षसंयुतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003214040, "chapter_id": 23214, "verse_number": "१-१७-४१", "content_sanskrit": "मनोनिलजवो भूत्वा गतोहं चोर्ध्वतः सुराः  ।\nनारायणोपि विश्वात्मा नीलांजनचयोपमम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003214041, "chapter_id": 23214, "verse_number": "१-१७-४२", "content_sanskrit": "दशयोजनविस्तीर्णं शतयोजनमायतम्  ।\nमेरुपर्वतवर्ष्माणं गौरतीक्ष्णाग्रदंष्ट्रिणम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003214042, "chapter_id": 23214, "verse_number": "१-१७-४३", "content_sanskrit": "कालादित्यसमाभासं दीर्घघोणं महास्वनम्  ।\nह्रस्वपादं विचित्रांगं जैत्रं दृढमनौपमम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003214043, "chapter_id": 23214, "verse_number": "१-१७-४४", "content_sanskrit": "वाराहमसितं रूपमास्थाय गतवानधः ।\nएवं वर्षसहस्रं तु त्वरन्विष्णुरधोगतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003214044, "chapter_id": 23214, "verse_number": "१-१७-४५", "content_sanskrit": "नापश्यदल्पमप्यस्य मूलं लिंगस्य सूकरः  ।\nतावत्कालं गतोह्यूर्द्ध्वमहमप्यरिसूदनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003214045, "chapter_id": 23214, "verse_number": "१-१७-४६", "content_sanskrit": "सत्वरं सर्वयत्नेन तस्यान्तं ज्ञातुमिच्छया  ।\nश्रांतो ह्यदृष्ट्वा तस्यांतमहङ्कारादधोगतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003214046, "chapter_id": 23214, "verse_number": "१-१७-४७", "content_sanskrit": "तथैव भगवान् विष्णुः श्रांतः संत्रस्तलोचनः  ।\nसर्वदेवभवस्तूर्णमुत्थितः सः महावपुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003214047, "chapter_id": 23214, "verse_number": "१-१७-४८", "content_sanskrit": "समागतो मया सार्धं प्रणिपत्य महामनाः  ।\nमायया मोहितः शंभोस्तस्थौ संविग्नमानसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003214048, "chapter_id": 23214, "verse_number": "१-१७-४९", "content_sanskrit": "पृष्ठतः पार्श्वतश्चैव चाग्रतः परमेश्वरम्  ।\nप्रणिपत्य मया सार्धं सस्मार किमिदं त्विति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003214049, "chapter_id": 23214, "verse_number": "१-१७-५०", "content_sanskrit": "तदा समभवत्तत्र नादो वै शब्दलक्षणः  ।\nओमोमिति सुरश्रेष्ठाः सुव्यक्तः प्लुतलक्षणः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003214050, "chapter_id": 23214, "verse_number": "१-१७-५१", "content_sanskrit": "किमिदं त्विति संचित्य मया तिष्ठन्महास्वनम्  ।\nलिंगस्य दक्षिणे भागे तदापश्यत्सनातनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003214051, "chapter_id": 23214, "verse_number": "१-१७-५२", "content_sanskrit": "आद्यवर्णमकारं तु उकारं चोत्तरे ततः  ।\nमकारं मध्यतश्चैव नादांतं तस्य चोमिति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003214052, "chapter_id": 23214, "verse_number": "१-१७-५३", "content_sanskrit": "सूर्यमंडलवद्दृष्ट्वा वर्णमाद्यं तु दक्षिणे  ।\nउत्तरे पावकप्रख्यमुकारं पुरुषर्षभः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003214053, "chapter_id": 23214, "verse_number": "१-१७-५४", "content_sanskrit": "शीतांशुमंडलप्रख्यं मकारं मध्यमं तथा  ।\nतस्योपरि तदापश्यच्छुद्धस्फटिकवत् प्रभुम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003214054, "chapter_id": 23214, "verse_number": "१-१७-५५", "content_sanskrit": "तुरीयातीतममृतं निष्कलं निरुपप्लवम्  ।\nनिर्द्वंद्वं केवलं शून्यं बाह्याभ्यंतरवर्जितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003214055, "chapter_id": 23214, "verse_number": "१-१७-५६", "content_sanskrit": "सबाह्याभ्यंतरं चैव सबाह्याभ्यंतरस्थितम्  ।\nआदिमध्यांतरहितमानंदस्यापि कारणम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003214056, "chapter_id": 23214, "verse_number": "१-१७-५७", "content_sanskrit": "मात्रास्तिस्रस्त्वर्धमात्रं नादाख्यं ब्रह्मसंज्ञितम्  ।\nऋग्यजुःसामवेदा वै मात्रारूपेण माधवः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003214057, "chapter_id": 23214, "verse_number": "१-१७-५८", "content_sanskrit": "वेदशब्देभ्य एवेशं विश्वात्मानमचिंतयत्  ।\nतदाभवदृषिर्वेद ऋषेः सारतमं शुभम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003214058, "chapter_id": 23214, "verse_number": "१-१७-५९", "content_sanskrit": "तेनैव ऋषिणा विष्णुर्ज्ञातवान्परमेश्वरम्।। देव उवाच  ।\nचिंतया रहितो रुद्रो वाचो यन्मनसा सह ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003214059, "chapter_id": 23214, "verse_number": "१-१७-६०", "content_sanskrit": "अप्राप्य तं निवर्तंते वाच्यस्त्वेकाक्षरेण सः ।\nएकाक्षरेण तद्वाच्यमृतं परमकारणम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003214060, "chapter_id": 23214, "verse_number": "१-१७-६१", "content_sanskrit": "सत्यमानंदममृतं परं ब्रह्म परात्परम्  ।\nएकाक्षरादकाराख्यो भगवान्कनकांडजः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003214061, "chapter_id": 23214, "verse_number": "१-१७-६२", "content_sanskrit": "एकाक्षरादुकाराख्यो हरिः परमकारणम्  ।\nएकाक्षरान्मकाराख्यो भगवान्नीललोहितः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003214062, "chapter_id": 23214, "verse_number": "१-१७-६३", "content_sanskrit": "सर्गकर्ता त्वकाराख्यो ह्युकाराख्यस्तु मोहकः  ।\nमकाराख्यास्तयोर्नित्यमनुग्रहकरोऽभवत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003214063, "chapter_id": 23214, "verse_number": "१-१७-६४", "content_sanskrit": "मकाराख्यो विभुर्बीजी ह्यकारो बीजमुच्यते  ।\nउकाराख्यो हरिर्योनिः प्रधानपुरुषेश्वरः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003214064, "chapter_id": 23214, "verse_number": "१-१७-६५", "content_sanskrit": "बीजी च बीजं तद्योनिर्नादाख्यश्च महेश्वरः  ।\nबीजी विभज्य चात्मानं स्वेच्छया तु व्यवस्थितः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003214065, "chapter_id": 23214, "verse_number": "१-१७-६६", "content_sanskrit": "अस्य लिंगादभूद्बीजमकारो बीजिनः प्रभोः  ।\nउकारयोनौ निक्षिप्तमवर्धत समंततः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003214066, "chapter_id": 23214, "verse_number": "१-१७-६७", "content_sanskrit": "सौवर्णमभवच्चांडमावेष्ट्याद्यं तदक्षरम्  ।\nअनेकाब्दं तथा चाप्सु दिव्यमंडं व्यवस्थितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003214067, "chapter_id": 23214, "verse_number": "१-१७-६८", "content_sanskrit": "ततो वर्षसहस्रांते द्विधा कृतमजोद्भवम्  ।\nअंडमप्सु स्थितं साक्षादाद्याख्येनेश्वरेण तु ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003214068, "chapter_id": 23214, "verse_number": "१-१७-६९", "content_sanskrit": "तस्यांडस्य शुभं हैमं कपालं चोर्द्ध्वसंस्थितम्  ।\nजज्ञे यद्द्यौस्तदपरं पृथिवी पंचलक्षणा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003214069, "chapter_id": 23214, "verse_number": "१-१७-७०", "content_sanskrit": "तस्मादंडोद्भवो जज्ञे त्वकाराख्यश्चतुर्मुखः  ।\nस स्रष्टा सर्वलोकानां स एव त्रिविधः प्रभुः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003214070, "chapter_id": 23214, "verse_number": "१-१७-७१", "content_sanskrit": "एवमोमोमिति प्रोक्तमित्याहुर्यजुषां वराः  ।\nयजुषां वचनं श्रुत्वा ऋचः सामानि सादरम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003214071, "chapter_id": 23214, "verse_number": "१-१७-७२", "content_sanskrit": "एवमेव हरे ब्रह्मन्नित्याहुः श्रुतयस्तदा  ।\nततो विज्ञाय देवेशं यथावच्छ्रुतिसंभवैः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003214072, "chapter_id": 23214, "verse_number": "१-१७-७३", "content_sanskrit": "मंत्रैर्महेश्वरं देवं तुष्टाव सुमहोदयम्  ।\nआवयोः स्तुतिसंतुष्टो लिंगे तस्मिन्निरंजनः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003214073, "chapter_id": 23214, "verse_number": "१-१७-७४", "content_sanskrit": "दिव्यं शब्दमयं रूपमास्थाय प्रहसन् स्थितः  ।\nअकारस्तस्य मूर्द्धा तु ललाटं दीर्घमुच्यते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003214074, "chapter_id": 23214, "verse_number": "१-१७-७५", "content_sanskrit": "इकारो दक्षिणं नेत्रमीकारो वामलोचनम्  ।\nउकारो दक्षिणं श्रोत्रमूकारो वाममुच्यते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003214075, "chapter_id": 23214, "verse_number": "१-१७-७६", "content_sanskrit": "ऋकारो दक्षिणं तस्य कपोलं परमेष्ठिनः  ।\nवामं कपोलमॄकारो लृलॄ नासापुटे उभे ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003214076, "chapter_id": 23214, "verse_number": "१-१७-७७", "content_sanskrit": "एकारमोष्ठमूर्द्ध्वश्च एकारस्त्वधरो विभोः  ।\nओकारश्च तथौकारो दंतपंक्तिद्वयं क्रमात् १७.७६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003214077, "chapter_id": 23214, "verse_number": "१-१७-७८", "content_sanskrit": "अमस्तु तालुनी तस्य देवदेवस्य धीमतः  ।\nकादिपंचाक्षराण्यस्य पंच हस्तानि दक्षिणे ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003214078, "chapter_id": 23214, "verse_number": "१-१७-७९", "content_sanskrit": "चादिपंचाक्षराण्येवं पंच हस्तानि वामतः  ।\nटादिपंचाक्षरं पादस्तादिपंचाक्षरं तथा ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003214079, "chapter_id": 23214, "verse_number": "१-१७-८०", "content_sanskrit": "पकारमुदरं तस्य फकारः पार्श्वमुच्यते  ।\nबकारो वामपार्श्वं वै भकारं स्कंधमस्य तत् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003214080, "chapter_id": 23214, "verse_number": "१-१७-८१", "content_sanskrit": "मकारं हृदयं शंभोर्महादेवस्य योगिनः  ।\nयकारादिसकारांतं विभोर्वै सप्त धातवः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003214081, "chapter_id": 23214, "verse_number": "१-१७-८२", "content_sanskrit": "हकार आत्मरूपं वै क्षकारः क्रोध उच्यते  ।\nतं दृष्ट्वा उमया सार्द्धं भगवंतं महेश्वरम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003214082, "chapter_id": 23214, "verse_number": "१-१७-८३", "content_sanskrit": "प्रणम्य भगवान् विष्णुः पुनश्चापश्यदूर्द्ध्वतः  ।\nॐकारप्रभवं मंत्रं कलापञ्चक संयुतम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003214083, "chapter_id": 23214, "verse_number": "१-१७-८४", "content_sanskrit": "शुद्धस्फटिकसंकाशं सुभाष्टत्रिंशदक्षरम्  ।\nमेधाकरमभूद्भूयः सर्वधर्मार्थसाधकम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003214084, "chapter_id": 23214, "verse_number": "१-१७-८५", "content_sanskrit": "गायत्रीप्रभवं मंत्रं हरितं वश्यकारकम्  ।\nचतुर्विशतिवर्णाढ्यं चतुष्कलमनुत्तमम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003214085, "chapter_id": 23214, "verse_number": "१-१७-८६", "content_sanskrit": "अथर्वमसितं मंत्रं कलाष्टकसमायुतम्  ।\nअभिचारिकमत्यर्थ त्रयस्त्रिंशच्छुभाक्षरम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003214086, "chapter_id": 23214, "verse_number": "१-१७-८७", "content_sanskrit": "यजुर्वेदसमायुक्तं पंचत्रिंशच्छुभाक्षरम्  ।\nकलाष्टकसमायुक्तं सुश्वेतं शांतिकं तथा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003214087, "chapter_id": 23214, "verse_number": "१-१७-८८", "content_sanskrit": "त्रयोदशकलायुक्तं बालाद्यैः सह लोहितम्  ।\nसमोद्भवं जगत्याद्यं वृद्धिसंहारकारणम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003214088, "chapter_id": 23214, "verse_number": "१-१७-८९", "content_sanskrit": "वर्णाः षडधिकाः षष्टिरस्य मंत्रवरस्य तु  ।\nपंच मंत्रांस्तथा लब्ध्वा जजाप भगवान् हरिः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003214089, "chapter_id": 23214, "verse_number": "१-१७-९०", "content_sanskrit": "अथ दृष्ट्वा कलावर्णमृग्यजुःसामरूपिणम्  ।\nईशानमीशमुकुटं पुरुषास्यं पुरातनम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003214090, "chapter_id": 23214, "verse_number": "१-१७-९१", "content_sanskrit": "अघोरहृदयं हृद्यं वामगुह्यं सदाशिवम्  ।\nसद्यः पादं महादेवं महाभोगीन्द्रभूषणम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003214091, "chapter_id": 23214, "verse_number": "१-१७-९२", "content_sanskrit": "विश्वतः पादवदनं विश्वतोक्षिकरं शिवम्  ।\nब्रह्मणोधिपतिं सर्गस्थितिसंहारकारणम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003214092, "chapter_id": 23214, "verse_number": "१-१७-९३", "content_sanskrit": "तुष्टाव पुनरिष्टाभिर्वाग्भिर्वरदमीश्वरम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]