[{"id": 2214340, "chapter_id": 5582, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2214341, "chapter_id": 5582, "verse_number": "१", "content_sanskrit": "नेह पश्यामि विबुधा राधेयममितौजसम् ।\nभ्रातरौ च महात्मानौ युधामन्यूत्तमौजसौ\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2214342, "chapter_id": 5582, "verse_number": "२", "content_sanskrit": "जुहुवुर्ये शरीराणि रणवह्नौ महारथाः ।\nराजानो राजपुत्राश्च ये मदर्थे हता रणे\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2214343, "chapter_id": 5582, "verse_number": "३", "content_sanskrit": "क्व ते महारथाः सर्वे शार्दूलसमविक्रमाः ।\nतैरप्ययं जितो लोकः कच्चित् पुरुषसत्तमैः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2214344, "chapter_id": 5582, "verse_number": "४", "content_sanskrit": "यदि लोकानिमान् प्राप्तास्ते च सर्वे महारथाः ।\nस्थितं वित्त हि मां देवाः सहितं तैर्महात्मभिः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2214345, "chapter_id": 5582, "verse_number": "५", "content_sanskrit": "कच्चिन्न तैरवाप्तोऽयं नृपैर्लोकोऽक्षयः शुभः ।\nन तैरहं विना वत्स्ये भ्रातृभिर्ज्ञातिभिस्तथा\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2214346, "chapter_id": 5582, "verse_number": "६", "content_sanskrit": "मातुर्हि वचनं श्रुत्वा तदा सलिलकर्मणि ।\nकर्णस्य क्रियतां तोयमिति तप्यामि तेन वै\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2214347, "chapter_id": 5582, "verse_number": "७", "content_sanskrit": "इदं च परितप्यामि पुनःपुनरहं सुराः ।\nयन्मातुः सदृशौ पादौ तस्याहममितात्मनः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2214348, "chapter_id": 5582, "verse_number": "८", "content_sanskrit": "दृष्ट्वैव तं नानुगतः कर्णं परबलार्दनम् ।\nन ह्यस्मान् कर्णसहितान् जयेच्छक्रोऽपि संयुगे\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2214349, "chapter_id": 5582, "verse_number": "९", "content_sanskrit": "तमहं यत्रतत्रस्थं द्रष्टुमिच्छामि सूर्यजम् ।\nअविज्ञातो मया योसौ घातितः सव्यसाचिना\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2214350, "chapter_id": 5582, "verse_number": "१०", "content_sanskrit": "भीमं च भीमविक्रान्तं प्राणेभ्योऽपि प्रियं मम ।\nअर्जुनं चेन्द्रसङ्काशं यमौ चैव यमोपमौ\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2214351, "chapter_id": 5582, "verse_number": "११", "content_sanskrit": "द्रष्टुमिच्छामि तां चाहं पाञ्चालीं धर्मचारिणीम् ।\nन चेह स्थातुमिच्छामि सत्यमेवं ब्रवीमि वः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2214352, "chapter_id": 5582, "verse_number": "१२", "content_sanskrit": "किं मे भ्रातृविहीनस्य स्वर्गेण सुरसत्तमाः ।\nयत्र ते मम स स्वर्गो नायं स्वर्गो मतो मम\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2214353, "chapter_id": 5582, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2214354, "chapter_id": 5582, "verse_number": "१३", "content_sanskrit": "यदि वै तत्र ते श्रद्धा गम्यतां तत्र माचिरम् ।\nप्रिये हि तव वर्तामो देवराजस्य शासनात्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2214355, "chapter_id": 5582, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2214356, "chapter_id": 5582, "verse_number": "१४", "content_sanskrit": "इत्युक्त्वा तं ततो देवा देवदूतमुपादिशन् ।\nयुधिष्ठिरस्य सुहृदो दर्शयेति परन्तप\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2214357, "chapter_id": 5582, "verse_number": "१५", "content_sanskrit": "ततः कुन्तीसुतो राजा देवदूतश्च जग्मतुः ।\nसहितौ राजशार्दूल यत्र ते पुरुषर्षभाः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2214358, "chapter_id": 5582, "verse_number": "१६", "content_sanskrit": "अग्रतो देवदूतश्च ययौ राजा च पृष्ठतः ।\nपन्थानमशुभं दुर्गं सेवितं पापकर्मभिः\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2214359, "chapter_id": 5582, "verse_number": "१७", "content_sanskrit": "तमसा संवृतं घोरं केशकङ्कालसङ्कुलम् ।\nयुक्तं पापकृतां गन्धैर्मांसशोणितकर्दमम्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2214360, "chapter_id": 5582, "verse_number": "१८", "content_sanskrit": "दंशोत्पातकभल्लूकमक्षिकामशकावृतम् ।\nइतश्चेतश्च कुणपैः समन्तात् परिवारितम्\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2214361, "chapter_id": 5582, "verse_number": "१९", "content_sanskrit": "अस्थिकेशसमाकीर्णं कृमिकीटसमाकुलम् ।\nज्वलनेन प्रदीप्तेन समन्तात् परिवेष्टितम्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2214362, "chapter_id": 5582, "verse_number": "२०", "content_sanskrit": "अयोमुखैश्च काकोलैर्गृध्रैश्च समभिद्रुतम् ।\nसूचीमुखैस्तथा प्रेतैर्विन्ध्यशैलोपमैर्वृतम्\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2214363, "chapter_id": 5582, "verse_number": "२१", "content_sanskrit": "मेदोरुधिरयुक्तैश्च च्छिन्नबाहूरुपाणिभिः ।\nनिकृत्तोदरपादैश्च तत्र तत्र प्रवेशितैः\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2214364, "chapter_id": 5582, "verse_number": "२२", "content_sanskrit": "स तत्कुणपदुर्गन्धमशिवं रोमहर्षणम् ।\nजगाम राजा धर्मात्मा मध्ये बहु विचिन्तयन्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2214365, "chapter_id": 5582, "verse_number": "२३", "content_sanskrit": "ददर्शोष्णोदकैः पूर्णं नदीं चापि सुदुर्गमाम् ।\nअसिपत्रवनं चैव निशितं क्षुरसंवृतम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2214366, "chapter_id": 5582, "verse_number": "२४", "content_sanskrit": "करम्भवालुकास्तप्ता आयसीश्च शिलाः पृथक् ।\nलोहकुम्भीश्च तैलस्य क्वाथ्यमानाः समन्ततः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2214367, "chapter_id": 5582, "verse_number": "२५", "content_sanskrit": "कूटशाल्मलिकं चापि दुःस्पर्शं तीक्ष्णकण्टकम् ।\nददर्शान्याश्च कौन्तेयो यातनाः पापकर्मिणाम्\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2214368, "chapter_id": 5582, "verse_number": "२६", "content_sanskrit": "स तं दुर्गन्धमालक्ष्य देवदूतमुवाच ह ।\nकियदध्वानमस्माभिर्गन्तव्यमिममीदृशम्\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2214369, "chapter_id": 5582, "verse_number": "२७", "content_sanskrit": "क्व च ते भ्रातरो मह्यं तन्ममाख्यातुमर्हसि ।\nदेशोऽयं कश्च देवानामेतदिच्छामि वेदितुम्\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2214370, "chapter_id": 5582, "verse_number": "२८", "content_sanskrit": "स सन्निववृते श्रुत्वा धर्मराजस्य भाषितम् ।\nदेवदूतोऽब्रवीच्चैनमेतावद्गमनं तव\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2214371, "chapter_id": 5582, "verse_number": "२९", "content_sanskrit": "निवर्तितव्यो हि मया तथाऽस्म्युक्तो दिवौकसैः ।\nयदि श्रान्तोसि राजेन्द्र त्वमथागन्तुमर्हसि\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2214372, "chapter_id": 5582, "verse_number": "३०", "content_sanskrit": "युधिष्ठिरस्तु निर्विण्णस्तेन गन्धेन मूर्छितः ।\nनिवर्तने धृतमनाः पर्यावर्तत भारत\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2214373, "chapter_id": 5582, "verse_number": "३१", "content_sanskrit": "स सन्निवृत्तो धर्मात्मा दुःखशोकसमाहतः ।\nशुश्राव तत्र वदतां दीना वाचः समन्ततः\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2214374, "chapter_id": 5582, "verse_number": "३२", "content_sanskrit": "भो भो धर्मज राजर्षे पुण्याभिजन पाण्डव ।\nअनुग्रहार्थमस्माकं तिष्ठ तावन्मुहूर्तकम्\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2214375, "chapter_id": 5582, "verse_number": "३३", "content_sanskrit": "आयाति त्वयि दुर्धर्षे वाति पुण्यः समीरणः ।\nतव गन्धानुगस्तात येनास्मान् सुखमागमत्\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2214376, "chapter_id": 5582, "verse_number": "३४", "content_sanskrit": "ते वयं पार्थ दीर्घस्य कालस्य पुरुषर्षभ ।\nसुखमासादयिष्यामस्त्वां दृष्ट्वा राजसत्तम\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2214377, "chapter_id": 5582, "verse_number": "३५", "content_sanskrit": "सन्तिष्ठस्व महाबाहो मुहूर्तमिह भारत ।\nत्वयि तिष्ठति कौरव्य यातनाऽस्मान्न बाधते\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2214378, "chapter_id": 5582, "verse_number": "३६", "content_sanskrit": "एवं बहुविधा वाचः कृपणा वेदनावताम् ।\nतस्मिन् देशे स शुश्राव समन्ताद् वदतां नृप\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2214379, "chapter_id": 5582, "verse_number": "३७", "content_sanskrit": "तेषां तु वचनं श्रुत्वा दयावान् दीनभाषिणाम् ।\nअहो कृच्छ्रमिति प्राह तस्थौ स च युधिष्ठिरः\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2214380, "chapter_id": 5582, "verse_number": "३८", "content_sanskrit": "स ता गिरः पुरस्ताद् वै श्रुतपूर्वाः पुनःपुनः ।\nग्लानानां दुःखितानां च नाभ्यजानत पाण्डवः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2214381, "chapter_id": 5582, "verse_number": "३९", "content_sanskrit": "अबुद्ध्यमानस्ता वाचो धर्मपुत्रो युधिष्ठिरः ।\nउवाच के भवन्तो वै किमर्थमिह तिष्ठथ\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2214382, "chapter_id": 5582, "verse_number": "४०", "content_sanskrit": "इत्युक्तास्ते ततः सर्वे समन्तादवभाषिरे ।\nकर्णोऽहं भीमसेनोऽहमर्जुनोऽहमिति प्रभो\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2214383, "chapter_id": 5582, "verse_number": "४१", "content_sanskrit": "नकुलः सहदेवोऽहं धृष्टद्युम्नोऽहमित्युत ।\nद्रौपदी द्रौपदेयाश्च इत्येवं ते विचुक्रशुः\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2214384, "chapter_id": 5582, "verse_number": "४२", "content_sanskrit": "ता वाचः स तदा श्रुत्वा तद्देशसदृशीर्नृप ।\nततो विममृशे राजा किन्त्विदं दैवकारितम्\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2214385, "chapter_id": 5582, "verse_number": "४३", "content_sanskrit": "किन्तु तत्कलुषं कर्म कृतमेभिर्महात्मभिः ।\nकर्णेन द्रौपदेयैर्वा पाञ्चाल्या वा सुमध्यया\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2214386, "chapter_id": 5582, "verse_number": "४४", "content_sanskrit": "य इमे पापगन्धेऽस्मिन् देशे सन्ति सुदारुणे ।\nनाहं जानामि सर्वेषां दुष्कृतं पुण्यकर्मणाम्\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2214387, "chapter_id": 5582, "verse_number": "४५", "content_sanskrit": "किं कृत्वा धृतराष्ट्रस्य पुत्रो राजा सुयोधनः ।\nतथा श्रिया युतः पापैः सह सर्वैः पदानुगैः\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2214388, "chapter_id": 5582, "verse_number": "४६", "content_sanskrit": "महेन्द्र इव लक्ष्मीवानास्ते परमपूजितः ।\nकस्येदानीं विकारोऽयं य इमे नरकं गताः\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2214389, "chapter_id": 5582, "verse_number": "४७", "content_sanskrit": "सर्वे धर्मविदः शूरा सत्यागमपरायणाः ।\nक्षत्रधर्मरताः सन्तो यज्वानो भूरिदक्षिणाः\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2214390, "chapter_id": 5582, "verse_number": "४८", "content_sanskrit": "किन्नु सुप्तोस्मि जागर्मि चेतयामि न चेतये ।\nअहो चित्तविकारोऽयं स्याद्वा मे चित्तविभ्रमः\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2214391, "chapter_id": 5582, "verse_number": "४९", "content_sanskrit": "एवं बहुविधं राजा विममर्श युधिष्ठिरः ।\nदुःखशोकसमाविष्टश्चिन्ताव्याकुलितेन्द्रियः\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2214392, "chapter_id": 5582, "verse_number": "५०", "content_sanskrit": "क्रोधमाहारयच्चैव तीव्रं धर्मसुतो नृपः ।\nदेवांश्च गर्हयामास धर्मं चैव युधिष्ठिरः\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2214393, "chapter_id": 5582, "verse_number": "५१", "content_sanskrit": "स तीव्रशोकसन्तप्तो देवदूतमुवाच ह ।\nगम्यतां यत्र येषां त्वं दूतस्तेषामुपान्तिकम्\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2214394, "chapter_id": 5582, "verse_number": "५२", "content_sanskrit": "न ह्यहं तत्र यास्यामि स्थितोस्मीति निवेद्यताम् ।\nमत्संश्रयादिमे दूनाः सुखिनो भ्रातरो हि मे\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2214395, "chapter_id": 5582, "verse_number": "५३", "content_sanskrit": "इत्युक्तः स तदा दूतः पाण्डुपुत्रेण धीमता ।\nजगाम तत्र यत्रास्ते देवराजः शतक्रतुः\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2214396, "chapter_id": 5582, "verse_number": "५४", "content_sanskrit": "निवेदयामास च तद्धर्मराजचिकीर्षितम् ।\nयथोक्तं धर्मपुत्रेण सर्वमेव जनाधिप\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2214397, "chapter_id": 5582, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् स्वर्गारोहणपर्वणि\nधर्मराजस्य नरकदर्शनं नाम द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]