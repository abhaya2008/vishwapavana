[{"id": 2096003, "chapter_id": 3049, "verse_number": "१३-१७९-१", "content_sanskrit": "युधिष्ठिर उवाच।\nअकामाश्च सकामाश्च ये हताः स्म महामृधे।\nकां योनिं प्रतिपन्नास्ते तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096004, "chapter_id": 3049, "verse_number": "१३-१७९-२", "content_sanskrit": "दुःखं प्राणपरित्यागः पुरुषाणां महामृधे।\nजानामि चाहं धर्मज्ञ प्राणत्यागं सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096005, "chapter_id": 3049, "verse_number": "१३-१७९-३", "content_sanskrit": "समृद्दे वाऽसमृद्धे वा शुभे वा यदि वाऽशुभे।\n`संसारेऽस्मिन्सदाजाताः प्राणिनोऽभिरताःकथम्\nकारणं तत्र मे ब्रूहि सर्वज्ञो ह्यसि मे मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096006, "chapter_id": 3049, "verse_number": "१३-१७९-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096007, "chapter_id": 3049, "verse_number": "१३-१७९-४", "content_sanskrit": "समृद्धे वाऽसमृद्धे वा शुभे वा यदि वाऽशुभे।\nसंसारेऽस्मिन्समे जाताः प्राणिनः पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096008, "chapter_id": 3049, "verse_number": "१३-१७९-५", "content_sanskrit": "निरता येन भावेन तत्र मे शृणु कारणम्।\nसम्यक्चायमनुप्रश्नस्त्वयोक्तस्तु युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096009, "chapter_id": 3049, "verse_number": "१३-१७९-६", "content_sanskrit": "अत्र ते वर्तयिष्यामि पुरावृत्तमिदं नृप।\nद्वैपायनस्य संवादं कीटस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096010, "chapter_id": 3049, "verse_number": "१३-१७९-७", "content_sanskrit": "ब्रह्मिभूतश्चरन्विप्रः कृष्णद्वैपायनः पुरा।\nददर्श कीटं धावन्तं शीघ्रं शकटवर्त्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096011, "chapter_id": 3049, "verse_number": "१३-१७९-८", "content_sanskrit": "गतिज्ञः सर्वभूतानां रुतज्ञश्च शरीरिणाम्।\nसर्वज्ञस्त्वरितं दृष्ट्वा कीटं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096012, "chapter_id": 3049, "verse_number": "१३-१७९-९", "content_sanskrit": "कीट संत्रस्तरूपोऽसि त्वरितश्चैव लक्ष्यसे।\nक्व च वासस्तदाचक्ष्व कुतस्ते भयमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096013, "chapter_id": 3049, "verse_number": "१३-१७९-१०x", "content_sanskrit": "कीट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096014, "chapter_id": 3049, "verse_number": "१३-१७९-१०", "content_sanskrit": "शकटव्रजस्य महतो घोषं श्रुत्वा भयं मम।\nआगतं वै महाबुद्धे स्वन एष हि दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096015, "chapter_id": 3049, "verse_number": "१३-१७९-११", "content_sanskrit": "श्रूयते तु स मा हन्यादिति ह्यस्मादपक्रमे।\nश्वसतां च शृणोम्येनं गोवृषाणां प्रतोद्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096016, "chapter_id": 3049, "verse_number": "१३-१७९-१२", "content_sanskrit": "वहतां सुमहाभारं सन्निकर्षे स्वनं प्रभो।\nनृणां च संवाहयतां श्रूयन्ते विविधाः स्वनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096017, "chapter_id": 3049, "verse_number": "१३-१७९-१३", "content_sanskrit": "वोढुमस्मद्विधेनैव न शक्यः कीटयोनिना।\nतस्मादतिक्रमाम्येष भयादस्मात्सुदारुणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096018, "chapter_id": 3049, "verse_number": "१३-१७९-१४", "content_sanskrit": "दुःखं हि मृत्युर्भूतानां जीवितं च सुदुर्लभम्।\nअतो भीतः पलायामि गच्छेयं नापदं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096019, "chapter_id": 3049, "verse_number": "१३-१७९-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096020, "chapter_id": 3049, "verse_number": "१३-१७९-१५", "content_sanskrit": "इत्युक्तः स तु सं प्राह कुतः कीट सुखं तव।\nमरणं ते सुखं मन्ये तिर्यग्योनौ हि वर्तसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096021, "chapter_id": 3049, "verse_number": "१३-१७९-१६", "content_sanskrit": "शब्दं स्पर्शं रसं गन्धं भोगांश्चोच्चावचान्बहून्।\nनाभिजानासि कीट त्वं श्रेयो मरणमेव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096022, "chapter_id": 3049, "verse_number": "१३-१७९-१७x", "content_sanskrit": "कीट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096023, "chapter_id": 3049, "verse_number": "१३-१७९-१७", "content_sanskrit": "सर्वत्र निरतो जीव इहापि च सुखं मम।\nचेतयामि महाप्राज्ञ तस्मादिच्छामि जीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096024, "chapter_id": 3049, "verse_number": "१३-१७९-१८", "content_sanskrit": "इहापि विषयः सर्वो यथादेहं प्रवर्तितः।\nमनुष्यास्तिर्यगाश्चैव पृथग्भोगा विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096025, "chapter_id": 3049, "verse_number": "१३-१७९-१९", "content_sanskrit": "अहमासं मनुष्यो वै शूद्रो बहुधनः प्रभो।\nअब्रह्मण्यो नृशंसश्च कदर्यो बुद्धिजीवनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096026, "chapter_id": 3049, "verse_number": "१३-१७९-२०", "content_sanskrit": "वाक्श्लक्ष्णो ह्यकृतप्रज्ञो द्वेष्टा विश्वस्य कर्मणः।\nमिथोगुप्तनिधिर्नित्यं परस्वहरणे रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096027, "chapter_id": 3049, "verse_number": "१३-१७९-२१", "content_sanskrit": "भृत्यातिथिजनश्चापि गृहेऽपर्यशितो मया।\nमात्सर्यात्स्वादुकामेन नृशंसेन बुभुक्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096028, "chapter_id": 3049, "verse_number": "१३-१७९-२२", "content_sanskrit": "देवार्थं पितृयज्ञार्थं न च श्राद्धं कृतं मया।\nन दत्तमन्नकामेषु दत्तमन्नं लुनामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096029, "chapter_id": 3049, "verse_number": "१३-१७९-२३", "content_sanskrit": "गुप्तं शरणमाश्रित्य भयेषु शरणागतान्।\nत्यक्त्वाऽकस्मान्निशायां च न दत्तमभयं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096030, "chapter_id": 3049, "verse_number": "१३-१७९-२४", "content_sanskrit": "धनं धान्यं प्रियान्दारान्यानं वासस्तथाऽद्भुतम्।\nश्रियं दृष्ट्वा मनुष्याणामसूयामि निरर्थकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096031, "chapter_id": 3049, "verse_number": "१३-१७९-२५", "content_sanskrit": "ईर्ष्युः परसुखं दृष्ट्वा अन्यस्य न बुभूषकः।\nत्रिवर्गहन्ता चान्येषामात्मकामानुवर्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096032, "chapter_id": 3049, "verse_number": "१३-१७९-२६", "content_sanskrit": "नृशंसगुणभूयिष्ठं पुरा कर्म कृतं मया।\nस्मृत्वा तदनुतप्येऽहं हित्वा प्रियमिवात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096033, "chapter_id": 3049, "verse_number": "१३-१७९-२७", "content_sanskrit": "शुभानां नाभिजानामि कृतानां कर्मणां फलम्।\nमाता च पूजिता वृद्धा ब्राह्मणश्चार्चितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096034, "chapter_id": 3049, "verse_number": "१३-१७९-२८", "content_sanskrit": "सकृज्जातिगुणोपेतः सङ्गत्या गृहमागतः।\nअतिथिः पूजितो ब्रह्मंस्तेन मां नाजहात्स्मृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096035, "chapter_id": 3049, "verse_number": "१३-१७९-२९", "content_sanskrit": "कर्मणामेव चैवाहं सुखाशामिव लक्षये।\nतच्छ्रोतुमहमिच्छामि त्वत्तः श्रेयस्तपोधन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096036, "chapter_id": 3049, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनाशीत्यधिकशततमोऽध्यायः॥ १७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]