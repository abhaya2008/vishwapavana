[{"id": 2053468, "chapter_id": 2180, "verse_number": "७-१०७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2053469, "chapter_id": 2180, "verse_number": "७-१०७-१", "content_sanskrit": "बृहत्क्षत्रमथायान्तं केकयं दृढविक्रमम्।\nक्षेमधूर्तिर्महाराज विव्याधोरसि मार्गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2053470, "chapter_id": 2180, "verse_number": "७-१०७-२", "content_sanskrit": "बृहत्क्षत्रस्तु तं राजा नवत्या नतपर्वणाम्।\nआजघ्ने त्वरितो राजन्द्रोणानीकबिभित्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2053471, "chapter_id": 2180, "verse_number": "७-१०७-३", "content_sanskrit": "क्षेमधूर्तिस्तु सङ्क्रुद्धः केकयस्य महात्मनः।\nधनुश्चिच्छेद भल्लेन पीतेन निशितेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2053472, "chapter_id": 2180, "verse_number": "७-१०७-४", "content_sanskrit": "अथैनं छिन्नधन्वानं शरेणानतपर्वणा।\nविव्याध समरे तूर्णं प्रवरं सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2053473, "chapter_id": 2180, "verse_number": "७-१०७-५", "content_sanskrit": "अथान्यद्धनुरादाय बृहत्क्षत्रो हसन्निव।\nव्यश्वसूतरथं चक्रे क्षमदूर्तिं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2053474, "chapter_id": 2180, "verse_number": "७-१०७-६", "content_sanskrit": "ततोऽपरेण भल्लेन पीतेन निशितेन च।\nजहार नृपतेः कायाच्छिरोऽज्वलितकुण़्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2053475, "chapter_id": 2180, "verse_number": "७-१०७-७", "content_sanskrit": "तच्छिन्नं सहसा तस्य शिरः कुञ्चितमूर्धजम्।\nसकिरीटं महीं प्राप्य बभौ ज्योतिरिवाम्बरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2053476, "chapter_id": 2180, "verse_number": "७-१०७-८", "content_sanskrit": "तं निहत्य रणे हृष्टो बृहत्क्षत्रो महारथः।\nसहसाऽभ्यपतत्सैन्यं तावकं पार्थकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2053477, "chapter_id": 2180, "verse_number": "७-१०७-९", "content_sanskrit": "धृष्टकेतुं तथाऽऽयान्तं द्रोणहेतोः पराक्रमी।\nवीरधन्वा महेष्वासो वारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2053478, "chapter_id": 2180, "verse_number": "७-१०७-१०", "content_sanskrit": "तौ परस्परमासाद्य शरदंष्ट्रौ तरस्विनौ।\nशरैरनेकसाहस्रेरन्योन्यमभिजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2053479, "chapter_id": 2180, "verse_number": "७-१०७-११", "content_sanskrit": "तावुभौ नरशार्दूलौ युयुधाते परस्परम्।\nमहावने तीव्रमदौ वारणाविव यूथपौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2053480, "chapter_id": 2180, "verse_number": "७-१०७-१२", "content_sanskrit": "गिरिगह्वरमासाद्य शार्दूलाविव रोषितौ।\nयुयुधाते महावीर्यौ परस्परजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2053481, "chapter_id": 2180, "verse_number": "७-१०७-१३", "content_sanskrit": "तद्युद्धमासीत्तुमुलं प्रेक्षणीयं विशाम्पते।\nसिद्धचारणसङ्घानां विस्मयाद्भुतदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2053482, "chapter_id": 2180, "verse_number": "७-१०७-१४", "content_sanskrit": "वीरधन्वा ततः क्रुद्धो धृष्टकेतोः शरासनम्।\nद्विधा चिच्छेद भल्लेन प्रहसन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2053483, "chapter_id": 2180, "verse_number": "७-१०७-१५", "content_sanskrit": "तदुत्सृज्य धनुच्छिन्नं चेदिराजो महारथः।\nशक्तिं जग्राह विपुलां हेमदण्डामयस्मयीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2053484, "chapter_id": 2180, "verse_number": "७-१०७-१६", "content_sanskrit": "तां तु शक्तिं महावीर्यां दोर्भ्यामायस्य भारत।\nचिक्षेप सहसा यत्तो वीरधन्वरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2053485, "chapter_id": 2180, "verse_number": "७-१०७-१७", "content_sanskrit": "तया तु वीरघातिन्या शक्त्या त्वभिहतो भृशम्।\nनिर्भिन्नहृदयस्तूर्णं निपपात रथान्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2053486, "chapter_id": 2180, "verse_number": "७-१०७-१८", "content_sanskrit": "तस्मिन्विनिहते वीरे त्रैगर्तानां महारथे।\nबलं तेऽभज्यत विभो पाण्डवेयैः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2053487, "chapter_id": 2180, "verse_number": "७-१०७-१९", "content_sanskrit": "सहदेवे ततः षष्टिं सायकान्दुर्मुखोऽक्षिपत्।\nननाद च महानादं तर्जयन्पाण्डवं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2053488, "chapter_id": 2180, "verse_number": "७-१०७-२०", "content_sanskrit": "माद्रेयस्तु ततः क्रुद्धो दुर्मुखं च शितैः शरैः।\nभ्राता भ्रातरमायत्तो विव्याध प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2053489, "chapter_id": 2180, "verse_number": "७-१०७-२१", "content_sanskrit": "तं रणे रभसं दृष्ट्वा सहदेवं महाबलम्।\nदुर्मुखो नवभिर्बाणैस्ताडयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2053490, "chapter_id": 2180, "verse_number": "७-१०७-२२", "content_sanskrit": "दुर्मुखस्य तु भल्लेन च्छित्त्वा केतुं महाबलः।\nजघान चतुरो वाहांश्चतुर्भिर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2053491, "chapter_id": 2180, "verse_number": "७-१०७-२३", "content_sanskrit": "अथापरेण भल्लेन पीतेन निशितेन ह।\nचिच्छेद सारथेः कायाच्छिरो ज्वलितकुण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2053492, "chapter_id": 2180, "verse_number": "७-१०७-२४", "content_sanskrit": "क्षुरप्रेण च तीक्ष्णेन कौरव्यस्य महद्धनुः।\nसहदेवो रणे छित्त्वा तं च विव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2053493, "chapter_id": 2180, "verse_number": "७-१०७-२५", "content_sanskrit": "हताश्वं तु रथं त्यक्त्वा दुर्मुखो विमनास्तदा।\nआरुरोह रथं राजन्निरमित्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2053494, "chapter_id": 2180, "verse_number": "७-१०७-२६", "content_sanskrit": "सहदेवस्ततः क्रुद्धो निरमित्रं महाहवे।\nजघान पृथुधारेण भल्लेन परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2053495, "chapter_id": 2180, "verse_number": "७-१०७-२७", "content_sanskrit": "स पपात रथोपस्थान्निरमित्रो जनेश्वरः।\nत्रिगर्तराजस्य सुतो व्यथयंस्तव वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2053496, "chapter_id": 2180, "verse_number": "७-१०७-२८", "content_sanskrit": "तं तु हत्वा महाबाहुः सहदेवो व्यरोचत।\nयथा दाशरथी रामः खरं हत्वा महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2053497, "chapter_id": 2180, "verse_number": "७-१०७-२९", "content_sanskrit": "हाहाकारो महानासीत्त्रिगर्तानां जनेश्वर।\nराजपुत्रं हतं दृष्ट्वा निरमित्रं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2053498, "chapter_id": 2180, "verse_number": "७-१०७-३०", "content_sanskrit": "नकुलस्ते सुतं राजन्विकर्णं पृथुलोचनम्।\nमुहूर्ताज्जितवाँल्लोके तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2053499, "chapter_id": 2180, "verse_number": "७-१०७-३१", "content_sanskrit": "सात्यकिं व्याघ्रदत्तस्तु शरैः सन्नतपर्वभिः।\nचक्रेऽदृश्यं साश्वसूतं सध्वजं पृतनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2053500, "chapter_id": 2180, "verse_number": "७-१०७-३२", "content_sanskrit": "तान्निवार्य शराञ्शूरः शैनेयः कृतहस्तवत्।\nसाश्वसूतध्वजं बाणैर्व्याघ्रदत्तमपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2053501, "chapter_id": 2180, "verse_number": "७-१०७-३३", "content_sanskrit": "कुमारे निहते तस्मिन्मागधस्य सुते प्रभो।\nमागधाः सर्वतो यत्ता युयुधानमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2053502, "chapter_id": 2180, "verse_number": "७-१०७-३४", "content_sanskrit": "विसृजन्तः शरांश्चैव तोमरांश्च सहस्रशः।\nमिण्डिपालांस्तथा प्रासान्मुद्रान्मुसलानपि॥\nअयोधयन्रणे शूराः सात्वतं युद्धदुर्मदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2053503, "chapter_id": 2180, "verse_number": "७-१०७-३५", "content_sanskrit": "तांस्तु सर्वान्स बलवान्सात्यकिर्युद्धदुर्मदः।\nनातिकृच्छ्राद्धसन्नेव विजिग्ये पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2053504, "chapter_id": 2180, "verse_number": "७-१०७-३६", "content_sanskrit": "मागधान्द्रवतो दृष्ट्वा हतशेषान्समन्ततः।\nबलं तेऽभज्यत विभो युयुधानशरार्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2053505, "chapter_id": 2180, "verse_number": "७-१०७-३७", "content_sanskrit": "नाशयित्वा रणे सैन्यं त्वदीयं तु समन्ततः।\nविधुन्वानो धनुःश्रेष्ठं व्यभ्राजत महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2053506, "chapter_id": 2180, "verse_number": "७-१०७-३८", "content_sanskrit": "भज्यमानं बलं राजन्सात्वतेन महात्मना।\nनाभ्यवर्तत युद्धाय त्रासितं दीर्घबाहुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2053507, "chapter_id": 2180, "verse_number": "७-१०७-३९", "content_sanskrit": "ततो द्रोणो भृशं क्रुद्धः सहसोद्वृत्य चक्षुषी।\nसात्यकिं सत्यकर्माणं स्वयमेवाभिदुद्रुवे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2053508, "chapter_id": 2180, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे सप्ताधिकशततमोऽध्यायः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]