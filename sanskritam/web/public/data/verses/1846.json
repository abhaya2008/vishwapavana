[{"id": 2038706, "chapter_id": 1846, "verse_number": "५-९१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038707, "chapter_id": 1846, "verse_number": "५-९१-१", "content_sanskrit": "पृथामामन्त्र्य गोविन्दः कृत्वा चाभिप्रदक्षिणम् ।\nदुर्योधनगृहं शौरिरभ्यगच्छदरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038708, "chapter_id": 1846, "verse_number": "५-९१-२", "content_sanskrit": "लक्ष्म्या परमया युक्तं पुरन्दरगृहोपमम् ।\nविचित्रैरासनैर्युक्तं प्रविवेश जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038709, "chapter_id": 1846, "verse_number": "५-९१-३", "content_sanskrit": "तस्य कक्ष्या व्यतिक्रम्य तिस्रो द्वाःस्थैरवारितः ।\nततोऽभ्रघनसङ्काशं गिरिकूटमिवोच्छ्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038710, "chapter_id": 1846, "verse_number": "५-९१-४", "content_sanskrit": "श्रिया ज्वलन्तं प्रासादमारुरोह महायशाः ।\nतत्र राजसहस्रैश्च कुरुभिश्चाभिसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038711, "chapter_id": 1846, "verse_number": "५-९१-५", "content_sanskrit": "धार्तराष्ट्रं महाबाहुं ददर्शासीनमासने ।\nदुःशासनं च कर्णं च शकुनिं चापि सौबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038712, "chapter_id": 1846, "verse_number": "५-९१-६", "content_sanskrit": "दुर्योधनसमीपे तानासनस्थान्ददर्श सः।\nअभ्यागच्छति दाशार्हे धार्तराष्ट्रो महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038713, "chapter_id": 1846, "verse_number": "५-९१-७", "content_sanskrit": "उदतिष्ठत्सहामात्यः पूजयन्मधुसूदनम् ।\nसमेत्य धार्तराष्ट्रेण महामात्येन केशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038714, "chapter_id": 1846, "verse_number": "५-९१-८", "content_sanskrit": "राजभिस्तत्र वार्ष्णेयः समागच्छद्यथावयः ।\nतत्र जाम्बूनदमयं पर्यङ्कं सुपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038715, "chapter_id": 1846, "verse_number": "५-९१-९", "content_sanskrit": "विविधास्तरणास्तीर्णमभ्युपाविशदच्युतः ।\nतस्मिन्गां मधुपर्कं चाप्युदकं च जनार्दने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038716, "chapter_id": 1846, "verse_number": "५-९१-१०", "content_sanskrit": "निवेदयामास तदा गृहान्राज्यं च कौरवः । ५-९१-१०b` आसनं सर्वतोभद्रं सर्वरत्नविभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038717, "chapter_id": 1846, "verse_number": "५-९१-११", "content_sanskrit": "कृष्णार्थमेवं संसिद्धं धार्तराष्ट्रस्य शासनात्।\nतत्र गोविन्दमासीनं प्रसन्नादित्यवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038718, "chapter_id": 1846, "verse_number": "५-९१-१२", "content_sanskrit": "उपासाञ्चक्रिरे सर्वे कुरवो राजभिः सह।\nततो दुर्योधनो राजा वार्ष्णेयं जयतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038719, "chapter_id": 1846, "verse_number": "५-९१-१३", "content_sanskrit": "न्यमन्त्रयद्भोजनेन नाभ्यनन्दच्च केशवः ।\nततो दुर्योधनः कृष्णमब्रवीत्कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038720, "chapter_id": 1846, "verse_number": "५-९१-१४", "content_sanskrit": "मृदुपूर्वं शठोदर्कं कर्णमाभाष्य कौरवः ।\nकस्मादन्नानि पापानि वासांसि शयनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038721, "chapter_id": 1846, "verse_number": "५-९१-१५", "content_sanskrit": "त्वदर्थमुपनीतानि नाग्रहीस्त्वं जनार्दन ।\nउभयोश्च ददत्साह्यमुभयोश्च हिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038722, "chapter_id": 1846, "verse_number": "५-९१-१६", "content_sanskrit": "संबन्धी दयितश्चासि धृतराष्ट्रस्य माधव ।\nत्वं हि गोविन्द धर्मार्थौ वेत्थ तत्त्वेन सर्वशः ।\nतत्र कारणमिच्छामि श्रोतुं चक्रगदाधर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038723, "chapter_id": 1846, "verse_number": "५-९१-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038724, "chapter_id": 1846, "verse_number": "५-९१-१७", "content_sanskrit": "स एवमुक्तो गोविन्दः प्रत्युवाच महामनाः ।\nउद्यन्मेघस्वनःक काले प्रगृह्य विपुलं भुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038725, "chapter_id": 1846, "verse_number": "५-९१-१८", "content_sanskrit": "अलघूकृतमग्रस्तमनिरस्तमसंकुलम् ।\nराजीवनेत्रो राजानं हेतुमद्वाक्यमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038726, "chapter_id": 1846, "verse_number": "५-९१-१९", "content_sanskrit": "कृतार्था भुञ्जते दूताः पूजां गृह्णन्ति चैव ह।\nकृतर्थं मां सहामात्यं समर्चिष्यसि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038727, "chapter_id": 1846, "verse_number": "५-९१-२०", "content_sanskrit": "एवमुक्तः प्रत्युवाच धार्तराष्ट्रो जनार्दनम् ।\nन युक्तं भवताऽस्मासु प्रतिपत्तुमसांप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038728, "chapter_id": 1846, "verse_number": "५-९१-२१", "content_sanskrit": "कृतार्थं वाऽकृतार्थं वा त्वां वयं मधुसूदन।\nयतामहे पूजयितुं दाशार्ह न च शक्नुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038729, "chapter_id": 1846, "verse_number": "५-९१-२२", "content_sanskrit": "न च तत्कारणं विद्मो यस्मान्नो मधुसूदन ।\nपूजां कृतां प्रीयमाणो नामंस्थाः पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038730, "chapter_id": 1846, "verse_number": "५-९१-२३", "content_sanskrit": "वैरं नो नास्ति भवता गोविन्द न च विग्रहः ।\nस भवान्प्रसमीक्ष्यैतन्नेदृशं वक्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038731, "chapter_id": 1846, "verse_number": "५-९१-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038732, "chapter_id": 1846, "verse_number": "५-९१-२४", "content_sanskrit": "एवमुक्तः प्रत्युवाच धार्तराष्ट्रं जनार्दनः।\nअभिवीक्ष्य सहामात्यं दाशार्हः प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038733, "chapter_id": 1846, "verse_number": "५-९१-२५", "content_sanskrit": "नाहं कामान्न संरम्भान्न द्वेषान्नार्थकारणात् ।\nन हेतुवादाल्लोभाद्वा धर्मं जह्यां कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038734, "chapter_id": 1846, "verse_number": "५-९१-२६", "content_sanskrit": "संप्रीतिभोज्यान्यन्नानि आपद्भोज्यानि वा पुनः ।\nन च संप्रीयते राजन्न चैवापद्गता वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038735, "chapter_id": 1846, "verse_number": "५-९१-२७", "content_sanskrit": "`द्विषदन्नं न भोक्तव्यं द्विषन्तं नैव भोजयेत् ।\nपाण्डवान्द्विषसे राजन्मम प्राणा हि पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2038736, "chapter_id": 1846, "verse_number": "५-९१-२८", "content_sanskrit": "अकस्माद्द्विषसे राजञ्जन्मप्रभृति पाण्डवान् ।\nप्रियानुवर्तिनो भ्रातॄन्सर्वैः समुदितान्गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2038737, "chapter_id": 1846, "verse_number": "५-९१-२९", "content_sanskrit": "अकस्माच्चैव पार्थानां द्वेषणं नोपपद्यते।\nधर्मे स्थिताः पाण्डवेयाः कस्तान्किं वक्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2038738, "chapter_id": 1846, "verse_number": "५-९१-३०", "content_sanskrit": "यस्तान्द्वेष्टि स मां द्वेष्टि यस्ताननु समामनु ।\nऐकात्म्यं मां गतं विद्धि पाण्डवैर्धर्मचारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2038739, "chapter_id": 1846, "verse_number": "५-९१-३१", "content_sanskrit": "कामक्रोधानुवर्ती हि यो मोहाद्विरुरुत्सति।\nगुणवन्तं च यो द्वेष्टि तमाहुः पुरुषाधमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2038740, "chapter_id": 1846, "verse_number": "५-९१-३२", "content_sanskrit": "यः कल्याणगुणाञ्ज्ञातीन्मोहाल्लोभाद्दिदृक्षते ।\nसोजितात्माऽजितक्रोधो न चिरं तिष्ठति श्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2038741, "chapter_id": 1846, "verse_number": "५-९१-३३", "content_sanskrit": "अथ यो गुणसंपन्नान्हृदयस्याप्रियानपि।\nप्रियेण कुरुते वश्यांश्चिरं यशसि तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2038742, "chapter_id": 1846, "verse_number": "५-९१-३४", "content_sanskrit": "सर्वमेतन्न भोक्तव्यमन्नं दुष्टाभिसंहितम्।\nक्षुत्तुरेकस्य भोक्तव्यमिति मे धीयते मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2038743, "chapter_id": 1846, "verse_number": "५-९१-३५", "content_sanskrit": "एवमुक्त्वा महाबाहुर्दुर्योधनममर्षणम् ।\nनिश्चक्राम ततः शुभ्राद्धार्तराष्ट्रनिवेशनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2038744, "chapter_id": 1846, "verse_number": "५-९१-३६", "content_sanskrit": "निर्याय च महाबाहुर्वासुदेवो महामनाः ।\nनिवेशाय ययौ वेश्य विदुरस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2038745, "chapter_id": 1846, "verse_number": "५-९१-३७", "content_sanskrit": "तमभ्यगच्छद्द्रोणश्च कृपो भीष्मोऽथ बाह्लिकः ।\nकुरवश्च महाबाहुं विदुरस्य गृहे स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2038746, "chapter_id": 1846, "verse_number": "५-९१-३८", "content_sanskrit": "त ऊचुर्माधवं वीरं कुरवो मधुसूदनम् ।\nनिवेदयामो वार्ष्णेय सरत्नांस्ते गृहान्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2038747, "chapter_id": 1846, "verse_number": "५-९१-३९", "content_sanskrit": "तानुवाच महातेजाः कौरवान्मधुसूदनः ।\nसर्वे भवन्ते गच्छन्तु सर्वा मेऽपचितिः कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2038748, "chapter_id": 1846, "verse_number": "५-९१-४०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2038749, "chapter_id": 1846, "verse_number": "५-९१-४०", "content_sanskrit": "यातेषु कुरुषु क्षत्ता दाशार्हमपराजितम्।\nअभ्यर्चयामास तदा सर्वकामैः प्रयत्नवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2038750, "chapter_id": 1846, "verse_number": "५-९१-४१", "content_sanskrit": "ततः क्षत्राऽन्नपानानि शुचीनि गुणवन्ति च।\nउपाहरदनेकानि केशवाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2038751, "chapter_id": 1846, "verse_number": "५-९१-४२", "content_sanskrit": "तैतर्पयित्वा प्रथमं ब्राह्मणान्मधुसूदनः ।\nवेदविद्भ्यो ददौ कृष्णः परमद्रविणान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2038752, "chapter_id": 1846, "verse_number": "५-९१-४३", "content_sanskrit": "`भुक्तवत्सु द्विजाग्र्येषु निषण्णेषु वरासने ।\nशुचिः सुप्रयतो भून्वा विदुरोऽन्नमुपारत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2038753, "chapter_id": 1846, "verse_number": "५-९१-४४", "content_sanskrit": "श्रद्धया परया युक्त इदं वचनमब्रवीत्।\nसंवृतैस्तुष्य गोविन्द एतन्नः धनम्।\nअन्यथा हि विशेषेण कस्त्वामर्चितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2038754, "chapter_id": 1846, "verse_number": "५-९१-४५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2038755, "chapter_id": 1846, "verse_number": "५-९१-४५", "content_sanskrit": "ततोऽनुयायिभिः सार्धं मरुद्भिरिव वासवः।\nविदुरान्नानि बुभुजे शुचीनि गुणवन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2038756, "chapter_id": 1846, "verse_number": "५-९१-४६", "content_sanskrit": "तं भुक्तवन्तं विविधाः सुशब्दाः सूतमागधाः ।\nअभितुष्टुवुरासीनं दाशार्हमपराजितम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2038757, "chapter_id": 1846, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि एकनवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]