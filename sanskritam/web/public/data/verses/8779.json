[{"id": 900010180, "chapter_id": 8779, "verse_number": "6.1", "content_sanskrit": "यत्पदं वेदसंवेद्यं कटाक्षेणापि वीक्षितुम् । न क्षमंते विमतयस्तमुपासे श्रियः पतिम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900010181, "chapter_id": 8779, "verse_number": "6.2", "content_sanskrit": "श्रुतिशतपरिगीतः शुद्धभावैर्गृहीतः । कमलनिलयतातः कंजनेत्रः प्रतीतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900010182, "chapter_id": 8779, "verse_number": "6.3", "content_sanskrit": "एको नारायण आसीन्न ब्रह्मा न च शंकरः वासुदेवो वा इदमग्र आसोन्न ब्रह्मा न च शंकरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900010183, "chapter_id": 8779, "verse_number": "6.4", "content_sanskrit": "भेदपराण्येव खलु ब्रह्मसूत्राणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900010184, "chapter_id": 8779, "verse_number": "6.5", "content_sanskrit": "कथमेकत्वमनयोर्घटते विपरीतयोः ॥ प्रत्यक्षेण विरोधोऽयमुभयोरुपलम्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]