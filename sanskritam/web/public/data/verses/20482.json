[{"id": 7000482000, "chapter_id": 20482, "verse_number": "३-२९-१", "content_sanskrit": "नारदौवाच ।\nततो गच्छेत राजेंद्र कालिंदीतीर्थमुत्तमम् ।\nतत्र स्नात्वा नरो राजन्न दुर्गतिमवाप्नुयात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000482001, "chapter_id": 20482, "verse_number": "३-२९-२", "content_sanskrit": "पुष्करे तु कुरुक्षेत्रे ब्रह्मावर्त्ते पृथूदके ।\nअविमुक्ते सुवर्णाख्ये यत्फलं लभते नरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000482002, "chapter_id": 20482, "verse_number": "३-२९-३", "content_sanskrit": "तत्फलं समवाप्नोति यमुनायां नरोत्तम ।\nस्वर्गभोगेतिरागो वै येषां मनसि वर्तते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000482003, "chapter_id": 20482, "verse_number": "३-२९-४", "content_sanskrit": "यमुनायां विशेषेण स्नानदानेन सत्तम ।\nआयुरारोग्यसंपत्तौ रूपयौवनता गुणे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000482004, "chapter_id": 20482, "verse_number": "३-२९-५", "content_sanskrit": "येषां मनोरथस्तैस्तु न त्याज्यं यमुनाजलम् ।\nये बिभ्यति नरकादेर्दारिद्र्योऽत्र संति च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000482005, "chapter_id": 20482, "verse_number": "३-२९-६", "content_sanskrit": "सर्वथा तैः प्रयत्नेन तत्र कार्यं निमज्जनम् ।\nदारिद्र्य पाप दौर्भाग्य पंक प्रक्षालनाय वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000482006, "chapter_id": 20482, "verse_number": "३-२९-७", "content_sanskrit": "ऋते वै यामुनं तोयं न चान्योस्ति युधिष्ठिर ।\nश्रद्धाहीनानि कर्माणि मतान्यर्धफलानि वै ।\nफलं ददाति संपूर्णं यामुनं स्नानमात्रतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000482007, "chapter_id": 20482, "verse_number": "३-२९-८", "content_sanskrit": "अकामो वा सकामो वा यामुने सलिले नृप ।\nइहामुत्र च दुःखानि मज्जनान्नैव पश्यति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000482008, "chapter_id": 20482, "verse_number": "३-२९-९", "content_sanskrit": "पक्षद्वये यथा चंद्र क्षीःयते वर्द्धते तथा ।\nपातकं नश्यते तत्र स्नानात्पुण्यं विवर्द्धते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000482009, "chapter_id": 20482, "verse_number": "३-२९-१०", "content_sanskrit": "यथाब्धौ सुखमायांति रत्नानि विविधानि च ।\nआयुर्वित्तं कलत्राणि संपदः संभवंति च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000482010, "chapter_id": 20482, "verse_number": "३-२९-११", "content_sanskrit": "कामधेनुर्यथा कामं चिंतामणिर्विचिंतितम् ।\nददाति यमुनास्नानं तद्वत्सर्वं मनोरथम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000482011, "chapter_id": 20482, "verse_number": "३-२९-१२", "content_sanskrit": "कृते तपः परं ज्ञानं त्रेतायां यजनं तथा ।\nद्वापरे च कलौ दानं कालिंदी सर्वदा शुभा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000482012, "chapter_id": 20482, "verse_number": "३-२९-१३", "content_sanskrit": "सर्वेषां सर्ववर्णानामाश्रमाणां च भूपते ।\nयामुने मज्जनं धर्मं धाराभिः खलु वर्षति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000482013, "chapter_id": 20482, "verse_number": "३-२९-१४", "content_sanskrit": "अस्मिन्वै भारते वर्षे कर्मभूमौ विशेषतः ।\nकालिंद्यस्नायिनां नॄणां निष्फलं जन्मकीर्त्तितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000482014, "chapter_id": 20482, "verse_number": "३-२९-१५", "content_sanskrit": "नैश्वर्यं गगने यद्वच्चांद्रे ऽमायां तु मंडले ।\nतद्वन्न भाति सत्कर्म यमुनामज्जनं विना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000482015, "chapter_id": 20482, "verse_number": "३-२९-१६", "content_sanskrit": "व्रतैर्दानैस्तपोभिश्च न तथा प्रीयते हरिः ।\nतत्र मज्जनमात्रेण यथा प्रीणाति केशवः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000482016, "chapter_id": 20482, "verse_number": "३-२९-१७", "content_sanskrit": "न समं विद्यते किंचित्तेजः सौरेण तेजसा ।\nतद्वन्न यमुनास्नानं समानाः क्रतुजाः क्रियाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000482017, "chapter_id": 20482, "verse_number": "३-२९-१८", "content_sanskrit": "प्रीतये वासुदेवस्य सर्वपापापनुत्तये ।\nकालिंद्या मज्जनं कुर्य्यात्स्वर्गलाभाय मानवः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000482018, "chapter_id": 20482, "verse_number": "३-२९-१९", "content_sanskrit": "किं रक्षितेन देहेन सुपुष्टेन बलीयसा ।\nअध्रुवेण सुदेहेन यमुना मज्जनं विना ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000482019, "chapter_id": 20482, "verse_number": "३-२९-२०", "content_sanskrit": "अस्थिस्तंभं स्नायुबंधं मांसक्षतज लेपनम् ।\nचर्मावनद्ध दुर्गंधं पूर्णं मूत्रपुरीषयोः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000482020, "chapter_id": 20482, "verse_number": "३-२९-२१", "content_sanskrit": "जराशोक विपद्व्याप्तं रोगमंदिरमातुरम् ।\nरागमूलमनित्यं च सर्वदोषसमाश्रयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000482021, "chapter_id": 20482, "verse_number": "३-२९-२२", "content_sanskrit": "परोपकारपापार्ति परद्रोहपरेर्षिकम् ।\nलोलुपं पिशुनं क्रूरं कृतघ्नं क्षणिकं तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000482022, "chapter_id": 20482, "verse_number": "३-२९-२३", "content_sanskrit": "निष्ठुरं दुर्धरं दुष्टं दोषत्रयविदूषितम् ।\nअशुचितापि दुर्गंधि तापत्रयविमोहितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000482023, "chapter_id": 20482, "verse_number": "३-२९-२४", "content_sanskrit": "निसर्गतो ऽधर्मरतं तृष्णाशतसमाकुलम् ।\nकामक्रोधमहालोभ नरकद्वारसंस्थितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000482024, "chapter_id": 20482, "verse_number": "३-२९-२५", "content_sanskrit": "कृमिवर्चस्तु भस्मादि परिणामगुणावहम् ।\nईदृक्शरीरं व्यर्थं हि यमुनामज्जनं विना ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000482025, "chapter_id": 20482, "verse_number": "३-२९-२६", "content_sanskrit": "बुद्बुदा इव तोयेषु प्रत्यंडा इव पक्षिषु ।\nजायंते मरणायैव यमुनास्नान वर्जिताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000482026, "chapter_id": 20482, "verse_number": "३-२९-२७", "content_sanskrit": "अवैष्णवो हतो विप्रो हतं श्राद्धमपिंडकम् ।\nअब्रह्मण्यं हतं क्षत्रमनाचार हतं कुलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000482027, "chapter_id": 20482, "verse_number": "३-२९-२८", "content_sanskrit": "सदंभश्च हतो धर्म्मः क्रोधेनैव हतं तपः ।\nअदृढं च हतं ज्ञानं प्रमादेन हतं श्रुतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000482028, "chapter_id": 20482, "verse_number": "३-२९-२९", "content_sanskrit": "परभक्त्या हता नारी ब्रह्मचारी स्त्रिया हतः ।\nअदीप्तेऽग्नौ हतो होमो हता भक्तिः समायिका ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000482029, "chapter_id": 20482, "verse_number": "३-२९-३०", "content_sanskrit": "उपजीव्या हता कन्या स्वार्थे पाकक्रिया हता ।\nशूद्र भक्षो हतो योगः कृपणस्य हतं धनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000482030, "chapter_id": 20482, "verse_number": "३-२९-३१", "content_sanskrit": "अनभ्यासहता विद्या हतो बोधो विरोधकृत् ।\nजीवितार्थं हतं तीर्थं जीवनार्थं हतं व्रतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000482031, "chapter_id": 20482, "verse_number": "३-२९-३२", "content_sanskrit": "असत्या च हता वाणी तथा पैशुन्यवादिनी ।\nषट्कर्णगो हतो मंत्रो व्यग्रचित्तो हतो जपः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000482032, "chapter_id": 20482, "verse_number": "३-२९-३३", "content_sanskrit": "हतमश्रोत्रिये दानं हतो लोकश्च नास्तिकः ।\nअश्रद्धया हतं सर्वं यत्कृतं पारलौकिकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000482033, "chapter_id": 20482, "verse_number": "३-२९-३४", "content_sanskrit": "इह लोको हतो नॄणां दरिद्राणां यथा नृप ।\nमनुष्याणां हतं जन्म कालिदीमज्जनं विना ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000482034, "chapter_id": 20482, "verse_number": "३-२९-३५", "content_sanskrit": "उपपातक सर्वाणि पातकानि महांति च ।\nभस्मी भवंति सर्वाणि यमुनामज्जनान्नृप ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000482035, "chapter_id": 20482, "verse_number": "३-२९-३६", "content_sanskrit": "वेपंते सर्वपापानि यमुनायां गते नरे ।\nनाशके सर्वपापानां यदि स्नास्यति वारिणि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000482036, "chapter_id": 20482, "verse_number": "३-२९-३७", "content_sanskrit": "पावका इव दीप्यंते यमुनायां नरोत्तमाः ।\nविमुक्ताः सर्वपापेभ्यो मेघेभ्य इव चंद्रमाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000482037, "chapter_id": 20482, "verse_number": "३-२९-३८", "content_sanskrit": "आर्द्र शुष्कलघुस्थूलं वाङ्मनः कर्मभिः कृतम् ।\nतत्र स्नानं दहेत्पापं पावकः समिधो यथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000482038, "chapter_id": 20482, "verse_number": "३-२९-३९", "content_sanskrit": "प्रामादिकं च यत्पापं ज्ञानाज्ञानकृतं च यत् ।\nस्नानमात्रेण नश्येत यमुनायां नृपोत्तम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000482039, "chapter_id": 20482, "verse_number": "३-२९-४०", "content_sanskrit": "निष्पापास्त्रिदिवं यांति पापिष्ठा यांति शुद्धताम् ।\nसंदेहो नात्र कर्तव्यः स्नाने वै यमुनाजले ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000482040, "chapter_id": 20482, "verse_number": "३-२९-४१", "content_sanskrit": "सर्वेऽधिकारिणो ह्यत्र विष्णुभक्तौ तथा नृप ।\nसर्वेषां सर्वदा देवी यमुना पापनाशिका ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000482041, "chapter_id": 20482, "verse_number": "३-२९-४२", "content_sanskrit": "एष एव परो मंत्र एतच्च परमं तपः ।\nप्रायश्चित्तं परं चैव यमुनास्नानमुत्तमम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000482042, "chapter_id": 20482, "verse_number": "३-२९-४३", "content_sanskrit": "नृणां जन्मांतराभ्यासात्कालिंदी मज्जने मतिः ।\nअध्यात्मज्ञानकौशल्यं जन्माभ्यासाद्यथा नृप ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000482043, "chapter_id": 20482, "verse_number": "३-२९-४४", "content_sanskrit": "संसारकर्दमालेप प्रक्षालन विशारदम् ।\nपावनं पावनानां च यमुनास्नानमुत्तमम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000482044, "chapter_id": 20482, "verse_number": "३-२९-४५", "content_sanskrit": "स्नातास्तत्र च ये राजन्सर्वकामफलप्रदे ।\nशुभांश्च भुंजते भोगांश्चंद्र सूर्यग्रहोपमान् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000482045, "chapter_id": 20482, "verse_number": "३-२९-४६", "content_sanskrit": "यमुना मोक्षदा प्रोक्ता मथुरासंगता यदि ।\nमथुरायां च कालिंदी पुण्याधिकविवर्द्धिनी ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000482046, "chapter_id": 20482, "verse_number": "३-२९-४७", "content_sanskrit": "अन्यत्र यमुना पुण्या महापातकहारिणी ।\nविष्णुभक्तिप्रदा देवी मथुरा संगता भवेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000482047, "chapter_id": 20482, "verse_number": "३-२९-४८", "content_sanskrit": "भक्तिभावेन संयुक्ता कालिंद्यां यदि मज्जयेत् ।\nकल्पकोटिसहस्राणि वसते सन्निधौ हरेः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000482048, "chapter_id": 20482, "verse_number": "३-२९-४९", "content_sanskrit": "मुक्तिं प्रयांति मनुजाः नूनं सांख्येन वर्जिताः ।\nपितरस्तस्य तृप्यंति तृप्ताः कल्पशतैर्दिवि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000482049, "chapter_id": 20482, "verse_number": "३-२९-५०", "content_sanskrit": "ये पिबंति नरा राजन्यमुनासलिलं शुभम् ।\nपंचगव्यसहस्रैस्तु सेवितैः किं प्रयोजनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000482050, "chapter_id": 20482, "verse_number": "३-२९-५१", "content_sanskrit": "कोटितीर्थसहस्रैस्तु सेवितैः किं प्रयोजनम् ।\nतत्र दानं च होमश्च सर्वं कोटिगुणं भवेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]