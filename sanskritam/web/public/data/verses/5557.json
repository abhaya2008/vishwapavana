[{"id": 2213390, "chapter_id": 5557, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213391, "chapter_id": 5557, "verse_number": "१", "content_sanskrit": "एवं सा रजनी तेषामाश्रमे पुण्यकर्मणाम् ।\nशिवा नक्षत्रविद्योता व्यतियाता कुरूद्वह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213392, "chapter_id": 5557, "verse_number": "२", "content_sanskrit": "तत्र तत्र कथाश्चासन् तेषां धर्मार्थलक्षणाः ।\nविचित्रपदसञ्चारा नानाश्रुतिभिरन्विताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213393, "chapter_id": 5557, "verse_number": "३", "content_sanskrit": "पाण्डवास्त्वभितो मातुर्धरण्यां सुषुपुस्तदा ।\nउत्सृज्य सुमहार्हाणि शयनानि नराधिप\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213394, "chapter_id": 5557, "verse_number": "४", "content_sanskrit": "यदाहारोऽभवद् राजा धृतराष्ट्रो महामनाः ।\nतदाहारा नृवीरास्ते न्यवसंस्तां निशां तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213395, "chapter_id": 5557, "verse_number": "५", "content_sanskrit": "व्यतीतायां तु शर्वर्यां कृतपौर्वाह्निकक्रियः ।\nभ्रातृभिः सहितो राजा ददर्शाश्रममण्डलम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213396, "chapter_id": 5557, "verse_number": "६", "content_sanskrit": "सान्तःपुरपरीवारः सभृत्यः सपुरोहितः ।\nयथामुखं यथोद्देशं धृतराष्ट्राभ्यनुज्ञया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213397, "chapter_id": 5557, "verse_number": "७", "content_sanskrit": "ददर्श तत्र वेदीश्च सम्प्रज्वलितपावकाः ।\nकृताभिषेकैर्मुनिभिर्हुताग्निभिरुपस्थिताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213398, "chapter_id": 5557, "verse_number": "८", "content_sanskrit": "वनेषु पुष्पनिकरैराज्यधूमोद्गमैरपि ।\nब्राह्मेण वपुषा युक्ता युक्ता मुनिगणस्य ताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213399, "chapter_id": 5557, "verse_number": "९", "content_sanskrit": "मृगयूथैरनुद्विग्नैस्तत्रतत्र समाश्रितैः ।\nअशङ्कितैः पक्षिगणैः प्रगीतैरिव च प्रभो\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213400, "chapter_id": 5557, "verse_number": "१०", "content_sanskrit": "केकाभिर्नीलकण्ठानां दात्यूहानां च कूजितैः ।\nकोकिलानां कुहुरवैः सुखैः श्रुतिमनोहरैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213401, "chapter_id": 5557, "verse_number": "११", "content_sanskrit": "प्राधीतद्विजघोषैश्च क्वचित्क्वचिदलङ्कृतम् ।\nफलमूलसमाहारैर्महद्भिश्चोपशोभितम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213402, "chapter_id": 5557, "verse_number": "", "content_sanskrit": "(ततः स राजा प्रददौ तापसार्थमुपाहृतान् ।\nकलशान् काञ्चनान् राजन् तथैवौदुम्बरानपि\t॥१२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213403, "chapter_id": 5557, "verse_number": "१३", "content_sanskrit": "अजिनानि प्रवेणीश्च स्रुक्स्रुवं च महीपतिः ।\nकमण्डलूंश्च स्थालीश्च पिठराणि च भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213404, "chapter_id": 5557, "verse_number": "१४", "content_sanskrit": "भाजनानि च लौहानि पात्रीश्च विविधा नृप ।\nयद्यदिच्छति यावच्च यदन्यदपि काङ्क्षितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213405, "chapter_id": 5557, "verse_number": "१५", "content_sanskrit": "एवं स राजा धर्मात्मा परीत्याश्रममण्डलम् ।\nवसु विश्राण्य तत्सर्वं पुनरायान्महीपतिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213406, "chapter_id": 5557, "verse_number": "१६", "content_sanskrit": "कृताह्निकं च राजानं धृतराष्ट्रं महीपतिम् ।\nददर्शासीनमव्यग्रं गान्धारीसहितं तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213407, "chapter_id": 5557, "verse_number": "१७", "content_sanskrit": "मातरं चाविदूरस्थां शिष्यवत्प्रणतां स्थिताम् ।\nकुन्तीं ददर्श धर्मात्मा शिष्टाचारसमन्विताम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213408, "chapter_id": 5557, "verse_number": "१८", "content_sanskrit": "स तमभ्यर्च्य राजानं नाम संश्राव्य चात्मनः ।\nनिषीदेत्यभ्यनुज्ञातो बृस्यामुपविवेश ह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213409, "chapter_id": 5557, "verse_number": "१९", "content_sanskrit": "भीमसेनादयश्चैव पाण्डवा भरतर्षभ ।\nअभिवाद्योपसङ्गृह्य निषेदुः पार्थिवाज्ञया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213410, "chapter_id": 5557, "verse_number": "२०", "content_sanskrit": "स तैः परिवृतो राजा शुशुभेऽतीव कौरवः ।\nबिभ्रद् ब्राह्मीं श्रियं दीप्तां देवैरिव बृहस्पतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213411, "chapter_id": 5557, "verse_number": "२१", "content_sanskrit": "तथा तेषूपविष्टेषु समाजग्मुर्महर्षयः ।\nशतयूपप्रभृतयः कुरुक्षेत्रनिवासिनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213412, "chapter_id": 5557, "verse_number": "२२", "content_sanskrit": "व्यासश्च भगवान् विप्रो देवर्षिगणसेवितः ।\nवृतः शिष्यैर्महातेजा दर्शयामास पार्थिवम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213413, "chapter_id": 5557, "verse_number": "२३", "content_sanskrit": "ततः स राजा कौरव्यः कुन्तीपुत्रश्च धर्मराट् ।\nभीमसेनादयश्चैव प्रत्युत्थायाभ्यवादयन्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213414, "chapter_id": 5557, "verse_number": "२४", "content_sanskrit": "समागतस्ततो व्यासः शतयूपादिभिर्वृतः ।\nधृतराष्ट्रं महीपालमास्यतामित्यभाषत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213415, "chapter_id": 5557, "verse_number": "२५", "content_sanskrit": "वरं तु विष्टरं कौश्यं कृष्णाजिनकुशोत्तरम् ।\nप्रतिपेदे तदा व्यासस्तदर्थमुपकल्पितम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213416, "chapter_id": 5557, "verse_number": "", "content_sanskrit": "(ते च सर्वे द्विजश्रेष्ठा विष्टरेषु समन्ततः ।\nद्वैपायनाभ्यनुज्ञाता निषेदुर्विपुलौजसः\t॥२६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213417, "chapter_id": 5557, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213418, "chapter_id": 5557, "verse_number": "२७", "content_sanskrit": "तथा तेषूपविष्टेषु व्यासो वेदविदां वरः ।\nकिमुवाच महातेजा धृतराष्ट्रं स पाण्डवम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213419, "chapter_id": 5557, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213420, "chapter_id": 5557, "verse_number": "२८", "content_sanskrit": "ततः समुपविष्टेषु पाण्डवेषु महात्मसु ।\nव्यासः सत्यवतीपुत्रः प्रोवाचामन्त्र्य पार्थिवम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2213421, "chapter_id": 5557, "verse_number": "२९", "content_sanskrit": "धृतराष्ट्र महाबाहो कच्चित्ते वर्तते तपः ।\nकच्चिन्मनस्ते प्रीणाति वनवासे नराधिप\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2213422, "chapter_id": 5557, "verse_number": "३०", "content_sanskrit": "कच्चिद्धृदि न ते शोको राजन् पुत्रविनाशजः ।\nकच्चिज्ज्ञानानि सर्वाणि सुप्रसन्नानि तेऽनघ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2213423, "chapter_id": 5557, "verse_number": "३१", "content_sanskrit": "कच्चिद् बुद्धिं दृढां कृत्वा चरस्यारण्यकं विधिम् ।\nकच्चिद् वधूश्च गान्धारी न शोकेनाभिभूयते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2213424, "chapter_id": 5557, "verse_number": "३२", "content_sanskrit": "महाप्रज्ञा बुद्धिमती देवी धर्मार्थदर्शिनी ।\nआगमापायतत्त्वज्ञा कच्चिदेषा न शोचति\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2213425, "chapter_id": 5557, "verse_number": "३३", "content_sanskrit": "कच्चित्कुन्ती च राजंस्त्वां शुश्रूषत्यनहङ्कृता ।\nया परित्यज्य स्वं पुत्रं गुरुशुश्रूषणे रता\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2213426, "chapter_id": 5557, "verse_number": "३४", "content_sanskrit": "कच्चिद्धर्मसुतो राजा त्वया प्रत्यभिनन्दितः ।\nभीमार्जुनयमाश्चैव कच्चिदेतेऽपि सान्त्विताः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2213427, "chapter_id": 5557, "verse_number": "३५", "content_sanskrit": "कच्चिन्नन्दसि दृष्ट्वैतान् कच्चित्ते निर्मलं मनः ।\nकच्चिच्च शुद्धभावोऽसि जातज्ञानो नराधिप\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2213428, "chapter_id": 5557, "verse_number": "३६", "content_sanskrit": "एतद्धि त्रितयं श्रेष्ठं सर्वभूतेषु भारत ।\nनिर्वैरता महाराज सत्यमक्रोध एव च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2213429, "chapter_id": 5557, "verse_number": "३७", "content_sanskrit": "कच्चित्ते न च मोहोस्ति वनवासेन भारत ।\nस्वदत्ते वन्यमन्नं वा उपवासोऽपि वा भवेत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2213430, "chapter_id": 5557, "verse_number": "३८", "content_sanskrit": "विदितं चापि राजेन्द्र विदुरस्य महात्मनः ।\nगमनं विधिनाऽनेन धर्मस्य सुमहात्मनः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2213431, "chapter_id": 5557, "verse_number": "३९", "content_sanskrit": "माण्डव्यशापाद्धि स वै धर्मो विदुरतां गतः ।\nमहाबुद्धिर्महायोगी महात्मा सुमहामनाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2213432, "chapter_id": 5557, "verse_number": "४०", "content_sanskrit": "बृहस्पतिर्वा देवेषु शुक्रो वाऽप्यसुरेषु च ।\nन तथा बुद्धिसम्पन्नो यथा स पुरुषर्षभः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2213433, "chapter_id": 5557, "verse_number": "४१", "content_sanskrit": "तपोबलव्ययं कृत्वा सुचिरात् सम्भृतं तदा ।\nमाण्डव्येनर्षिणा धर्मो ह्यभिभूतः सनातनः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2213434, "chapter_id": 5557, "verse_number": "४२", "content_sanskrit": "नियोगाद् ब्राह्मणः पूर्वं मया स्वेन बलेन च ।\nवैचित्रवीर्यके क्षेत्रे जातः स सुमहामतिः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2213435, "chapter_id": 5557, "verse_number": "४३", "content_sanskrit": "भ्राता तव महाराज देवदेवः सनातनः ।\nधारणाच्छ्रेयसो ज्ञानात् यं धर्मं कवयो विदुः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2213436, "chapter_id": 5557, "verse_number": "४४", "content_sanskrit": "सत्येन संवर्धयति यो दमेन शमेन च ।\nअहिंसया च दानेन तपसा च सनातनः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2213437, "chapter_id": 5557, "verse_number": "४५", "content_sanskrit": "येन योगबलाद् जातः कुरुराजो युधिष्ठिरः ।\nधर्म इत्येष नृपते प्राज्ञेनामितबुद्धिना\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2213438, "chapter_id": 5557, "verse_number": "४६", "content_sanskrit": "यथा वह्निर्यथा वायुर्यथाऽऽपः पृथिवी यथा ।\nयथाऽऽकाशं तथा धर्म इह चामुत्र च स्थितः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2213439, "chapter_id": 5557, "verse_number": "४७", "content_sanskrit": "सर्वगश्चैव राजेन्द्र सर्वं व्याप्य चराचरम् ।\nदृश्यते देवदेवैः स सिद्धैर्निर्मुक्तकल्मषैः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2213440, "chapter_id": 5557, "verse_number": "४८", "content_sanskrit": "यो हि धर्मः स विदुरो विदुरो यः स पाण्डवः ।\nस एष राजन् दृश्यस्ते पाण्डवः प्रेष्यवत् स्थितः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2213441, "chapter_id": 5557, "verse_number": "४९", "content_sanskrit": "प्रविष्टः स महात्मानं भ्राता ते बुद्धिसम्मतः ।\nदृष्ट्वा महात्मा कौन्तेयं महायोगबलान्वितः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2213442, "chapter_id": 5557, "verse_number": "५०", "content_sanskrit": "त्वां चापि श्रेयसा योक्ष्ये नचिराद् भरतर्षभ ।\nसंशयच्छेदनार्थाय प्राप्तं मां विद्धि पुत्रक\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2213443, "chapter_id": 5557, "verse_number": "५१", "content_sanskrit": "न कृतं यैः पुरा कश्चित् कर्म लोके महर्षिभिः ।\nआश्चर्यभूतं तपसः फलं तद् दर्शयामि वः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2213444, "chapter_id": 5557, "verse_number": "५२", "content_sanskrit": "किमिच्छसि महीपाल मत्तः प्राप्तुमभीप्सितम् ।\nद्रष्टुं स्प्रष्टुमथ श्रोतुं तत्कर्तास्मि तवानघ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2213445, "chapter_id": 5557, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nवेदव्यासवचनं नाम त्रयस्त्रिंशोऽध्यायः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2213446, "chapter_id": 5557, "verse_number": "३३", "content_sanskrit": "आश्रमवासपर्वणि त्रयस्त्रिंशोऽध्यायः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2213447, "chapter_id": 5557, "verse_number": "", "content_sanskrit": "॥ समाप्तम् आश्रमवासपर्व ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]