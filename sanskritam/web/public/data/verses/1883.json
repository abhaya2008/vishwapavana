[{"id": 2039881, "chapter_id": 1883, "verse_number": "५-१२८-०x", "content_sanskrit": "वैशम्पायन उवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039882, "chapter_id": 1883, "verse_number": "५-१२८-१", "content_sanskrit": "ततः प्रहस्य दाशार्हः क्रोधपर्याकुलेक्षणः ।\nदुर्योधनमिदं वाक्यमब्रवीत्कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039883, "chapter_id": 1883, "verse_number": "५-१२८-२", "content_sanskrit": "लप्स्यसे वीरशयनं काममेतदवाप्स्यसि।\nस्थिरो भव सहामात्यो विमर्दो भविता महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039884, "chapter_id": 1883, "verse_number": "५-१२८-३", "content_sanskrit": "यच्चैतन्मन्यसे मूढ न मे कश्चिद्व्यतिक्रमः।\nपाण्डवेष्विति तत्सर्वं निबोध त्वं नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039885, "chapter_id": 1883, "verse_number": "५-१२८-४", "content_sanskrit": "श्रियां संतप्यमानेन पाण्डवानां महात्मनाम् ।\nत्वया दुर्मन्त्रितं द्यूतं सौबलेन च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039886, "chapter_id": 1883, "verse_number": "५-१२८-५", "content_sanskrit": "कथं च ज्ञातयस्तात श्रेयांसः साधुसंमताः ।\nतथाऽन्याय्यमुपस्थातुं जिह्मेनाजिह्मचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039887, "chapter_id": 1883, "verse_number": "५-१२८-६", "content_sanskrit": "अक्षद्यूतं महाप्रज्ञ सतां मतिविनाशनम् ।\nअसतां तत्र जायन्ते भेदाश्च व्यसनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039888, "chapter_id": 1883, "verse_number": "५-१२८-७", "content_sanskrit": "तदिदं व्यसनं घोरं त्वया द्यूतमुखं कृतम् ।\nअसमीक्ष्य सदाचारान्सार्धं पापानुबन्धनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039889, "chapter_id": 1883, "verse_number": "५-१२८-८", "content_sanskrit": "कश्चान्यो भ्रातृभार्यां वै विप्रकर्तृं तथार्हति।\nआनीय च सभां व्यक्तं यथोक्ता द्रौपदी त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039890, "chapter_id": 1883, "verse_number": "५-१२८-९", "content_sanskrit": "कुलीना शीलसंपन्ना प्राणेभ्योऽपि गरीयसी ।\nमहिषी पाण्डुपुत्राणां तथा विनिकृता त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039891, "chapter_id": 1883, "verse_number": "५-१२८-१०", "content_sanskrit": "जानन्ति कुरवः सर्वे यथोक्ताः कुरुसंसदि ।\nदुःशासनेन कौन्तेयाः प्रव्रजन्तः परन्तपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039892, "chapter_id": 1883, "verse_number": "५-१२८-११", "content_sanskrit": "सम्यग्वृत्तेष्वलुब्धेषु सततं धर्मचारिषु ।\nस्वेषु बन्धुषु कः साधुश्चरेदेवमसांप्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039893, "chapter_id": 1883, "verse_number": "५-१२८-१२", "content_sanskrit": "नृशंसानामनार्याणां तथा परुषभाषणम् ।\nकर्णदुःशासनाभ्यां च त्वया च बहुशः कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039894, "chapter_id": 1883, "verse_number": "५-१२८-१३", "content_sanskrit": "सह मात्रा प्रदग्धुं तान्बालकान्वारणावते ।\nआस्थितः परमो यत्नो न समृद्धश्च तत्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039895, "chapter_id": 1883, "verse_number": "५-१२८-१४", "content_sanskrit": "ऊषुश्च सुचिरं कालं प्रच्छन्नाः पाण्डवास्तदा।\nमात्रा सहैकचक्रायां ब्राह्मणस्य निवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039896, "chapter_id": 1883, "verse_number": "५-१२८-१५", "content_sanskrit": "विषेण सर्पबन्धैश्च यतिताः पाण्डवास्त्वया ।\nसर्वोपायैर्विनाशाय न समृद्धं च तत्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039897, "chapter_id": 1883, "verse_number": "५-१२८-१६", "content_sanskrit": "एवंबुद्धिः पाण्डवेषु मिथ्यावृत्तिः सदा भवान् ।\nकथं ते नापराधोऽस्ति पाण्डवेषु महात्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039898, "chapter_id": 1883, "verse_number": "५-१२८-१७", "content_sanskrit": "`एवंवृत्तः कथं राज्ये स्थातुमर्हसि पापकृत्।\nस राज्याच्च सुखाच्चैव हास्यसे कुलपांसन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039899, "chapter_id": 1883, "verse_number": "५-१२८-१८", "content_sanskrit": "यच्चैभ्यो याचमानेभ्यः पित्र्यमंशं न दित्सति ।\nतच्च पाप प्रदाताऽसि भ्रष्टैश्वर्यो निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039900, "chapter_id": 1883, "verse_number": "५-१२८-१९", "content_sanskrit": "कृत्वा बहून्यकार्याणि पाण्डवेषु नृशंसवत्।\nमिथ्यावृत्तिरनार्यः सन्नद्य विप्रतिपद्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039901, "chapter_id": 1883, "verse_number": "५-१२८-२०", "content_sanskrit": "मातापितृभ्यां भीष्मेण द्रोणेन विदुरेण च।\nशाम्येति मुहुरुक्तोसि न च शाम्यसि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039902, "chapter_id": 1883, "verse_number": "५-१२८-२१", "content_sanskrit": "शमे हि सुमहाँल्लाभस्तव पार्थस्य चोभयोः ।\nन च रोचयसे राजन्किमन्यद्बुद्धिलाघवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039903, "chapter_id": 1883, "verse_number": "५-१२८-२२", "content_sanskrit": "न शर्म प्राप्स्यसे राजन्नुत्क्रम्य सुहृदां वचः।\nअधर्म्यमयशस्यं च क्रियते पार्थिव त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039904, "chapter_id": 1883, "verse_number": "५-१२८-२३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039905, "chapter_id": 1883, "verse_number": "५-१२८-२३", "content_sanskrit": "एवं ब्रुवति दाशार्हे दुर्योधनममर्षणम् ।\nदुःशासन इदं वाक्यमब्रवीत्करुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039906, "chapter_id": 1883, "verse_number": "५-१२८-२४", "content_sanskrit": "न चेत्सन्धास्यसे राजन्स्वेन कामेन पाण्डवैः।\nबद्ध्वा किल त्वां दास्यन्ति कुन्तीपुत्राय कौरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039907, "chapter_id": 1883, "verse_number": "५-१२८-२५", "content_sanskrit": "वैकर्तनं त्वां च मां च त्रीनेतान्मनुजर्षभ ।\nपाण्डवेभ्यः प्रदास्यन्ति भीष्मो द्रोणः पिता च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039908, "chapter_id": 1883, "verse_number": "५-१२८-२६", "content_sanskrit": "भ्रातुरेतद्वचः श्रुत्वा धार्तराष्ट्रः सुयोधनः ।\nक्रुद्धः प्रातिष्ठतोत्थाय महानाग इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039909, "chapter_id": 1883, "verse_number": "५-१२८-२७", "content_sanskrit": "विदुरं च सोमदत्तं च महाराजं च बाह्लिकम्।\nकृपं च सोमदत्तं च भीष्मं द्रोणं जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039910, "chapter_id": 1883, "verse_number": "५-१२८-२८", "content_sanskrit": "सर्वानेताननादृत्य दुर्मतिर्निरपत्रपः।\nअशिष्टवदमर्यादो मानी मान्यावमानिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2039911, "chapter_id": 1883, "verse_number": "५-१२८-२९", "content_sanskrit": "तं प्रस्थितमभिप्रेक्ष्य भ्रातरो मनुजर्षभम्।\nअनुजग्मुः सहामात्या राजानश्चापि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2039912, "chapter_id": 1883, "verse_number": "५-१२८-३०", "content_sanskrit": "सभायामुत्थितं क्रुद्धं प्रस्थितं भ्रातृभिः सह।\nदुर्योधनमभिप्रेक्ष्य भीष्मः शान्तनवोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2039913, "chapter_id": 1883, "verse_number": "५-१२८-३१", "content_sanskrit": "धर्मार्थावभिसन्त्यज्य संरम्भं योऽनुमन्यते ।\nहसन्ति व्यसने तस्य दुर्हृदो नचिरादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2039914, "chapter_id": 1883, "verse_number": "५-१२८-३२", "content_sanskrit": "दुरात्मा राजपुत्रोऽयं धार्तराष्ट्रोऽनुपायवित्।\nमिथ्याभिमानी राज्यस्य क्रोधलोभवशानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2039915, "chapter_id": 1883, "verse_number": "५-१२८-३३", "content_sanskrit": "कालपक्वमिदं मन्ये सर्वं क्षत्रं जनार्दन ।\nसर्वे ह्यनुसृता मोहात्पार्थिवाः सह मन्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2039916, "chapter_id": 1883, "verse_number": "५-१२८-३४", "content_sanskrit": "भीष्मस्याथ वचः श्रुत्वा दाशार्हः पुष्करेक्षणः ।\nभीष्मद्रोणमुखान्सर्वानभ्यभाषत वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2039917, "chapter_id": 1883, "verse_number": "५-१२८-३५", "content_sanskrit": "सर्वेषां कुरुवृद्धानां महानयमतिक्रमः ।\nप्रसह्य मन्दमैश्वर्ये न नियच्छन्ति यन्नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2039918, "chapter_id": 1883, "verse_number": "५-१२८-३६", "content_sanskrit": "तत्र कार्यमहं मन्ये कालप्राप्तमरिन्दमाः ।\nक्रियमाणे भवेच्छ्रेयस्तत्सर्वं श्रृणुतानघाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2039919, "chapter_id": 1883, "verse_number": "५-१२८-३७", "content_sanskrit": "प्रत्यक्षमेतद्भवतां यद्वक्ष्यामि हितं वचः ।\nभवतामानुकूल्येन यदि रोचेत भारताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2039920, "chapter_id": 1883, "verse_number": "५-१२८-३८", "content_sanskrit": "पुत्रो वै भोजराजस्य दुराचारो ह्यनात्मवान् ।\nजीवतः पितुरैश्वर्यं हृत्वा मृत्युवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2039921, "chapter_id": 1883, "verse_number": "५-१२८-३९", "content_sanskrit": "उग्रसेनसुतः कंसः परित्यक्तः स बान्धवैः।\nज्ञातीनां हितकामेन मया शस्तो महामृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2039922, "chapter_id": 1883, "verse_number": "५-१२८-४०", "content_sanskrit": "आहुकः पुनरस्माभिर्ज्ञातिभिश्चापि सत्कृतः ।\nउग्रसेनः कृतो राजा भोजराजन्यवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2039923, "chapter_id": 1883, "verse_number": "५-१२८-४१", "content_sanskrit": "संसमेकं परित्यज्य कुलार्थे सर्वयादवाः।\nसंभूय सुखमेधन्ते भारतान्धकवृष्णयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2039924, "chapter_id": 1883, "verse_number": "५-१२८-४२", "content_sanskrit": "अपि चाप्यवदद्राजन्परमेष्ठी प्रजापतिः ।\nव्यूढे देवासुरे युद्धेऽभ्युद्यतेष्वायुधेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2039925, "chapter_id": 1883, "verse_number": "५-१२८-४३", "content_sanskrit": "द्वैधीभूतेषु लोकेषु विनश्यत्सु च भारत ।\nअब्रवीत्तु तदा देवो भगवाँल्लोकभावनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2039926, "chapter_id": 1883, "verse_number": "५-१२८-४४", "content_sanskrit": "पराभविष्यन्त्यसुरा दैतेया दानवैः सह ।\nआदित्या वसवो रुद्रा भविष्यन्ति दिवौसकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2039927, "chapter_id": 1883, "verse_number": "५-१२८-४५", "content_sanskrit": "देवासुरमनुष्याश्च गन्धर्वोरगराक्षसाः ।\nअस्मिन्युद्धे सुसंक्रुद्धा हनिष्यन्ति परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2039928, "chapter_id": 1883, "verse_number": "५-१२८-४६", "content_sanskrit": "` वर्तमानं जगत्सर्वं मुहूर्तान्न भविष्यति।\nइति मत्वाऽब्रवीद्धर्मं परमेष्ठी प्रजापतिः ।\nवरुणाय प्रयच्छैतान्बद्ध्वा दैतेयदानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2039929, "chapter_id": 1883, "verse_number": "५-१२८-४७", "content_sanskrit": "एवमुक्तस्ततो धर्मो नियोगात्परमेष्ठिनः।\nवरुणाय ददौ सर्वान्बद्ध्वा दैतेयदानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2039930, "chapter_id": 1883, "verse_number": "५-१२८-४८", "content_sanskrit": "तान्बद्ध्वा धर्मपाशैश्च स्वैश्च पाशैर्जलेश्वरः ।\nवरुणः सागरे यत्तो नित्यं रक्षति दानवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2039931, "chapter_id": 1883, "verse_number": "५-१२८-४९", "content_sanskrit": "तथा दुर्योधनं कर्णं शकुनिं चापि सौबलम् ।\nबद्ध्वा दुःशासनं चापि पाण्डवेभ्यः प्रयच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2039932, "chapter_id": 1883, "verse_number": "५-१२८-५०", "content_sanskrit": "त्यजेत्कुलार्थे पुरुषं ग्रामस्यार्थे कुलं त्यजेत्।\nग्रामं जनपदस्यार्थे आत्मार्थे पृथिवीं त्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2039933, "chapter_id": 1883, "verse_number": "५-१२८-५१", "content_sanskrit": "राजन्दुर्योधनं बद्ध्वा ततः संशाम्य पाण्डवैः ।\nत्वत्कृते न विनश्येयुः क्षत्रियाः क्षत्रियर्षभ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2039934, "chapter_id": 1883, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि अष्टाविंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]