[{"id": 7003563000, "chapter_id": 23563, "verse_number": "२०३-१", "content_sanskrit": "अथ पापसमूहानुक्रमवर्णनम् ।\nऋषिपुत्र उवाच ।\nअन्यान्यपि च पापानि चित्रगुप्तो दिदेश ह ।\nव्यामिश्रान्कथ्यमानांश्च शृणुध्वं तान्महौजसः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003563001, "chapter_id": 23563, "verse_number": "२०३-२", "content_sanskrit": "शीलसंयमहीनानां कृष्णपक्षानुगामिनाम् ।\nमहापापैरुपेतानां कथ्यतां तत्पराभवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003563002, "chapter_id": 23563, "verse_number": "२०३-३", "content_sanskrit": "राजद्विष्टा गुरुद्विष्टाः सर्वे ते वै विगर्हिताः ।\nअविश्वास्या ह्यसम्भाष्याः कुक्षिमात्रपरायणाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003563003, "chapter_id": 23563, "verse_number": "२०३-४", "content_sanskrit": "हिंसाविहारिणः क्रूराः सूचकाः कार्यदूषकाः ।\nगवेडकस्य वधकाः महिषाजादिकस्य च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003563004, "chapter_id": 23563, "verse_number": "२०३-५", "content_sanskrit": "दावाग्निं ये च मुंचन्ति ये च सौकरिकास्तथा ।\nतत्र कालमसंख्येयं पच्यन्ते पापकारिणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003563005, "chapter_id": 23563, "verse_number": "२०३-६", "content_sanskrit": "कर्मक्षयाद्यदा भूयो मानुष्यं प्राप्नुवन्ति ते ।\nअल्पायुषो भवन्तीह व्याधिग्रस्ताश्च नित्यशः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003563006, "chapter_id": 23563, "verse_number": "२०३-७", "content_sanskrit": "गर्भ एव विपद्यन्ते म्रियन्ते बालकास्तथा ।\nपरिरिंगरताः केचिन्म्रियन्ते पुरुषाधमाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003563007, "chapter_id": 23563, "verse_number": "२०३-८", "content_sanskrit": "काष्ठवंशे च शस्त्रे च वायुना ज्वलनेन च ।\nतोयेन वा पाशबन्धैः पतनेन विषेण वा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003563008, "chapter_id": 23563, "verse_number": "२०३-९", "content_sanskrit": "मातापितृवधं कष्टं मित्रसम्बन्धिबन्धुजम् ।\nबहुशः प्राप्नुवन्त्येते विद्रवं चाप्यभीक्ष्णशः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003563009, "chapter_id": 23563, "verse_number": "२०३-१०", "content_sanskrit": "प्राणातिपातनं ते वै प्राप्नुवन्ति यथा तथा ।\nलोहकाः कारुकाश्चैव गर्भाणां विनिहिंसकाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003563010, "chapter_id": 23563, "verse_number": "२०३-११", "content_sanskrit": "मूलकर्मकरा ये च गरदाः पुरदाहकाः ।\nये च पञ्जरकर्त्तारो ये च शूलोपघातकाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003563011, "chapter_id": 23563, "verse_number": "२०३-१२", "content_sanskrit": "पिशुनाः कलहाश्चैव ये च मिथ्याविदूषकाः ।\nगोकुञ्जरखरोष्ट्राणां चर्मका मांसभेदकाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003563012, "chapter_id": 23563, "verse_number": "२०३-१३", "content_sanskrit": "उद्वेजनकराश्चण्डाः पच्यन्ते नरकेषु ते ।\nतत्र कालं तु सम्प्राप्य यातनाश्च सुदुःसहाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003563013, "chapter_id": 23563, "verse_number": "२०३-१४", "content_sanskrit": "कर्मक्षयो यदा भूयो मानुष्यं प्राप्नुवन्ति ते ।\nहीनाङ्गाः सुदरिद्राश्च भवंति पुरुषाधमाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003563014, "chapter_id": 23563, "verse_number": "२०३-१५", "content_sanskrit": "श्रवणच्छेदनं चैव नासाच्छेदनमेव च ।\nछेदनं हस्तपादानां प्राप्नुवंति स्वकर्मणा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003563015, "chapter_id": 23563, "verse_number": "२०३-१६", "content_sanskrit": "शारीरं मानसं दुःखं प्राप्नुवन्ति पुनःपुनः ।\nगलवेदनास्तथोग्राश्च तथा मस्तकवेदनाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003563016, "chapter_id": 23563, "verse_number": "२०३-१७", "content_sanskrit": "कुक्ष्यामयं तथा तीव्रं प्राप्नुवंति नराधमाः ।\nजडान्ध बधिरा मूकाः पंगवः पादसर्पिणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003563017, "chapter_id": 23563, "verse_number": "२०३-१८", "content_sanskrit": "एकपक्षहताः काणाः कुनखाश्चामयाविनः ।\nकुब्जाः खञ्जास्तथा हीना विकलाश्च घटोदराः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003563018, "chapter_id": 23563, "verse_number": "२०३-१९", "content_sanskrit": "गलत्कुष्ठाः श्वित्रकुष्ठा भवन्ति स्वैश्च कर्मभिः ।\nवाताण्डाश्चाण्डहीनाश्च प्रमेहमधुमेहिनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003563019, "chapter_id": 23563, "verse_number": "२०३-२०", "content_sanskrit": "योनिशूलाक्षिशूलाश्च श्वास  हृद्गुह्यशूलिनः ।\nपिण्डकावर्त्तभेदैश्च प्लीहगुल्मादिरोगिणः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003563020, "chapter_id": 23563, "verse_number": "२०३-२१", "content_sanskrit": "बहुभिर्दारुणैर्घोरैर्व्याधिभिः समनुद्गताः ।\nइत्येतान्हिंसकान्क्रूरान्घातयन्तु सुदारुणान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003563021, "chapter_id": 23563, "verse_number": "२०३-२२", "content_sanskrit": "मिथ्याप्रलापिनो दूतान्पाचयन्तु यथाक्रमम् ।\nकर्कशाः पुरुषाः सत्या ये च योषानिरर्थकाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003563022, "chapter_id": 23563, "verse_number": "२०३-२३", "content_sanskrit": "एषां चतुर्विधा भाषा या मिथ्याप्यभिधीयते ।\nहास्यरूपेण या भाषा चित्ररूपेण वा पुनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003563023, "chapter_id": 23563, "verse_number": "२०३-२४", "content_sanskrit": "अरहस्यं रहस्यं वा पैशुन्येन तु निन्दनात् ।\nउद्वेगजनना वापि कटुका लोकगर्हिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003563024, "chapter_id": 23563, "verse_number": "२०३-२५", "content_sanskrit": "स्नेहक्षयकरां रूक्षां भिन्नवृत्तविभूषिताम् ।\nकदलीगर्भनिस्सारां मर्मस्पृक्कटुकाक्षराम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003563025, "chapter_id": 23563, "verse_number": "२०३-२६", "content_sanskrit": "स्वरहीनामसंख्येयां भाषंते च निरर्थकम् ।\nअयंत्रितमुखा ये च ये निबद्धाः प्रलापिनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003563026, "chapter_id": 23563, "verse_number": "२०३-२७", "content_sanskrit": "दूषयन्ति हि जल्पन्तोऽनृजवो निष्ठुराः शठाः ।\nनिर्दया गतलज्जाश्च मूर्खा मर्मविभेदिनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003563027, "chapter_id": 23563, "verse_number": "२०३-२८", "content_sanskrit": "न मर्षयंति येऽन्येषां कीर्त्यमानाञ्छुभान्गुणान् ।\nदुर्वाचः परुषांश्चण्डान्बन्धयध्वं नराधमान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003563028, "chapter_id": 23563, "verse_number": "२०३-२९", "content_sanskrit": "ततस्तिर्यक्प्रजायन्ते बहुधा कीट पक्षिणः ।\nलोके दोषकराश्चैव लोकद्विष्टास्तथा परे॥ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003563029, "chapter_id": 23563, "verse_number": "२०३-३०", "content_sanskrit": "तत्र कालं चिरं घोरं पच्यन्ते पापकारिणः ।\nकर्मक्षयो यदा भूयो मानुष्यं प्राप्नुवन्ति ते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003563030, "chapter_id": 23563, "verse_number": "२०३-३१", "content_sanskrit": "परिभूता अविज्ञाता नष्टचित्ता अकीर्त्तयः ।\nअनर्च्याश्चाप्यनर्हाश्च स्वपक्षे ह्यवमानिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003563031, "chapter_id": 23563, "verse_number": "२०३-३२", "content_sanskrit": "त्यक्त्वा मित्राणि मित्रेषु ज्ञातिभिश्च निराकृताः ।\nलोकदोषकराश्चैव लोकद्वेष्याश्च ये नराः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003563032, "chapter_id": 23563, "verse_number": "२०३-३३", "content_sanskrit": "अन्यैरपि कृतं पापं तेषां पतति मस्तके ।\nवज्रं शस्त्रं विषं वापि देहाद्देहनिपातनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003563033, "chapter_id": 23563, "verse_number": "२०३-३४", "content_sanskrit": "मिथ्याप्रलापिनामेषामुक्ता क्लेशपरम्परा ।\nस्तेयहारं प्रहारं च नीतिहारं तथैव च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003563034, "chapter_id": 23563, "verse_number": "२०३-३५", "content_sanskrit": "स्तेयकर्माणि कुर्वन्ति प्रसह्य हरणानि च ।\nकरचण्डाशिनो ये च राजशब्दोपजीविनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003563035, "chapter_id": 23563, "verse_number": "२०३-३६", "content_sanskrit": "पीडयन्ति जनान् सर्वान्कृपणान्ग्रामकूटकान् ।\nसुवर्णमणिमुक्तानां कूटकर्मानुकारकाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003563036, "chapter_id": 23563, "verse_number": "२०३-३७", "content_sanskrit": "समये कृतहर्त्तारो लोकपीडाकरा नराः ।\nअनादिबुद्धयश्चान्ये स्वार्थातिशयकारिणः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003563037, "chapter_id": 23563, "verse_number": "२०३-३८", "content_sanskrit": "भूतनिष्ठाभियोगज्ञा व्यवहारेष्वनर्थकाः ।\nभेदकाराश्च धातूनां रजतस्य च कारकाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003563038, "chapter_id": 23563, "verse_number": "२०३-३९", "content_sanskrit": "न्यासार्थहारका ये च सम्मोहनकराश्च ये ।\nये तथोपाधिकाः क्षुद्राः पच्यन्ते तेषु तेष्वथ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003563039, "chapter_id": 23563, "verse_number": "२०३-४०", "content_sanskrit": "निरयेष्व प्रतिष्ठेषु दारुणेषु ततस्ततः।\nतत्र कालं तु सुचिरं पच्यन्तां पापकारिणः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003563040, "chapter_id": 23563, "verse_number": "२०३-४१", "content_sanskrit": "कर्मक्षयो यदा तेषां मानुष्यं प्राप्नुवन्ति ते।\nतत्र तत्रोपपद्यन्ते यत्र यत्र महद्भयम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003563041, "chapter_id": 23563, "verse_number": "२०३-४२", "content_sanskrit": "यस्मिंश्चौरभयं देशे क्षुद्भयं राजतो भयम् ।\nआपद्भ्योऽपि भयं यत्र व्याधिमृत्युभयं तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003563042, "chapter_id": 23563, "verse_number": "२०३-४३", "content_sanskrit": "ईतयो यत्र देशेषु लुब्धेषु नगरेषु च ।\nक्षयाः कालोपसर्गा वा जायन्ते तत्र ते नराः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003563043, "chapter_id": 23563, "verse_number": "२०३-४४", "content_sanskrit": "बहुदुःखपरिक्लिष्टा गर्भवासेन पीडिताः ।\nएकहस्ता द्विहस्ता वा कूटाश्च विकृतोदराः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003563044, "chapter_id": 23563, "verse_number": "२०३-४५", "content_sanskrit": "शिराविवृतगात्राश्च हीनाङ्गा वातरोगिणः ।\nअश्रुपातितनेत्राश्च भार्या न प्राप्नुवन्ति ते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003563045, "chapter_id": 23563, "verse_number": "२०३-४६", "content_sanskrit": "तेषामपत्यं न भवेत्तद्रूपं च सुलक्षणम् ।\nअतिह्रस्वं विवर्णं च विकृतं भ्रान्तलोचनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003563046, "chapter_id": 23563, "verse_number": "२०३-४७", "content_sanskrit": "संसारे च यथा पक्वं कृपणं भैरवस्वनम् ।\nमहतः परिवारस्य तुष्टश्चोच्छिष्टभोजकः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003563047, "chapter_id": 23563, "verse_number": "२०३-४८", "content_sanskrit": "रूपतो गुणतो हीनो बलतः शीलतस्तथा ।\nराजभृत्या भवन्त्येते पृथिवीपरिचारकाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003563048, "chapter_id": 23563, "verse_number": "२०३-४९", "content_sanskrit": "अनालया निरामर्षा वेद नाभिः सुसंवृताः ।\nसमकार्यसजात्यानां मित्रसम्बन्धिनां तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003563049, "chapter_id": 23563, "verse_number": "२०३-५०", "content_sanskrit": "कर्मान्तकारका ह्येते तृणीभूता भवन्ति ते ।\nअनर्थो राजदण्डो वा नित्यमुत्पाद्यते वधः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003563050, "chapter_id": 23563, "verse_number": "२०३-५१", "content_sanskrit": "कर्मकल्याणकृच्छ्रेषु भृशं चापि विमुह्यति ।\nकर्षकाः पशुपालाश्च वाणिज्यस्योपजीवकाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003563051, "chapter_id": 23563, "verse_number": "२०३-५२", "content_sanskrit": "यद्यत्कुर्वन्ति ते कर्म सर्वत्र क्षयभागिनः ।\nसत्यमन्विष्यमाणाश्च नैव ते कीर्त्तिभागिनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003563052, "chapter_id": 23563, "verse_number": "२०३-५३", "content_sanskrit": "यत्किञ्चिदशुभं कर्म तस्मिन्देशे समुच्छ्रितम् ।\nतस्य देशस्य नैवास्ति वर्जयित्वातुरान्नरान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003563053, "chapter_id": 23563, "verse_number": "२०३-५४", "content_sanskrit": "सुवृष्ट्यामपि तेषां वै क्षेत्रं तं तु विवर्जयेत् ।\nअशनिर्वा पतेत्तत्र क्षेत्रं वापि विनश्यति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003563054, "chapter_id": 23563, "verse_number": "२०३-५५", "content_sanskrit": "न सुखं नापि निर्वाणं तेषां मानुषता भवेत् ।\nउत्पद्यते नृशंसानां तीव्रः क्लेशः सुदारुणः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003563055, "chapter_id": 23563, "verse_number": "२०३-५६", "content_sanskrit": "स्तेयकर्मप्रयुक्तानां मुक्त्वा क्लेशपरम्पराम् ।\nपरदारप्रसक्तानामिमां शृणुत यातनाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003563056, "chapter_id": 23563, "verse_number": "२०३-५७", "content_sanskrit": "तिर्यङ्मानुषदेहेषु यान्ति विक्षिप्तमानसाः ।\nविहरन्ति ह्यधर्मेषु धर्मचारित्रदूषकाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003563057, "chapter_id": 23563, "verse_number": "२०३-५८", "content_sanskrit": "तांस्तेनैव प्रदानेन संग्रहेत्तु ग्रहेण वा ।\nमूलकर्मप्रयोगेण राष्ट्रस्यातिक्रमेण वा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003563058, "chapter_id": 23563, "verse_number": "२०३-५९", "content_sanskrit": "प्रसह्य वा प्रकृत्या वै ये चरन्ति कुलाङ्गनाः ।\nवर्णसङ्करकर्त्तारः कुलधर्मादिदूषकाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003563059, "chapter_id": 23563, "verse_number": "२०३-६०", "content_sanskrit": "शीलशौचादिसम्पन्नं ये जनं धर्मलक्षणम् ।\nधर्षयन्ति च ये पापाः श्रूयतां तत्पराभवः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003563060, "chapter_id": 23563, "verse_number": "२०३-६१", "content_sanskrit": "निरयं पापभूयिष्ठा अनुभूय महाभयम् ।\nबहुवर्षसहस्राणि कमर्णा तेन दुष्कृताः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003563061, "chapter_id": 23563, "verse_number": "२०३-६२", "content_sanskrit": "कर्मक्षये यदा भूयो मानुष्यं यान्ति दारुणम् ।\nसङ्कीर्णयोनिजाः क्षुद्रा भवन्ति पुरुषाधमाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003563062, "chapter_id": 23563, "verse_number": "२०३-६३", "content_sanskrit": "वेश्यालङ्घककूटानां शौण्डिकानां तथैव च ।\nदुष्टपाषण्डनारीणां नैकमैथुनगामिनाम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003563063, "chapter_id": 23563, "verse_number": "२०३-६४", "content_sanskrit": "निर्ल्लज्जपुण्ड्रकाः केचिद्बद्धपौरुषगण्डकाः ।\nस्त्रीबन्धकाः स्त्रीविनाशाः स्त्रीवेषाः स्त्रीविहारिणः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003563064, "chapter_id": 23563, "verse_number": "२०३-६५", "content_sanskrit": "स्त्रीणां चानुप्रवृद्धा ये स्त्रीभोगपरिभोगिनः ।\nतद्दैवतास्तन्नियमास्तद्वेषास्तत्प्रभाषिताः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003563065, "chapter_id": 23563, "verse_number": "२०३-६६", "content_sanskrit": "तद्भावास्तत्कथालापास्तद्भोगाः परिभोगिनः ।\nविप्रलोभं च दानेषु प्राप्नुवन्ति नराधमाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003563066, "chapter_id": 23563, "verse_number": "२०३-६७", "content_sanskrit": "सौभाग्यपरमासक्ता नरा बीभत्सदर्शनाः ।\nअबुद्धैः सह संवासं प्रियं चाविप्रियं तथा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003563067, "chapter_id": 23563, "verse_number": "२०३-६८", "content_sanskrit": "शारीरं मानसं दुःखं प्राप्नुवन्ति नराधमाः ।\nकृमिभिर्भक्षणं चैव तप्ततैलोपसेचनम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003563068, "chapter_id": 23563, "verse_number": "२०३-६९", "content_sanskrit": "अग्निक्षारनदीभ्यां तु प्राप्नुवन्ति न संशयः।\n&nbsp;परदारप्रसक्तानां भयं भवति निग्रहः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003563069, "chapter_id": 23563, "verse_number": "२०३-७०", "content_sanskrit": "सर्वं च निखिलं कार्यं यन्मया समुदाहृतम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]