[{"id": 2147440, "chapter_id": 4189, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147441, "chapter_id": 4189, "verse_number": "१", "content_sanskrit": "अथ प्रचलितः स्थानाद् आसनाच्च परिच्युतः ।\nकम्पितेनैव मनसा धर्षितः शोकवह्निना\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147442, "chapter_id": 4189, "verse_number": "२", "content_sanskrit": "म्लानस्रग् भ्रष्टविज्ञानः प्रभ्रष्टमकुटाङ्गदः ।\nविघूर्णस्रस्तसर्वाङ्गः प्रभ्रष्टाभरणाम्बरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147443, "chapter_id": 4189, "verse_number": "३", "content_sanskrit": "अदृश्यमानस्तान् पश्यन् अपश्यंश्च पुनः पुनः ।\nशून्यः शून्येन मनसा प्रापतत् स महीतळम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147444, "chapter_id": 4189, "verse_number": "४", "content_sanskrit": "किं मया मनसा ध्यातमशुभं स्वर्गदूषणम् ।\nयेनाहं चालितः स्थानादिति राजा व्यचिन्तयत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147445, "chapter_id": 4189, "verse_number": "५", "content_sanskrit": "ते तु तत्रैव राजानः सिद्धाश्चाप्सरसस्तथा ।\nअपश्यन्त निरालम्बं ययातिं स्वर्गतश्च्युतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147446, "chapter_id": 4189, "verse_number": "६", "content_sanskrit": "अथैत्य पुरुषः कश्चित् क्षीणपुण्यं निपातितम् ।\nययातिमब्रवीद् राजन् देवराजस्य शासनात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147447, "chapter_id": 4189, "verse_number": "७", "content_sanskrit": "अतीव मदमत्तस्त्वं न कञ्चिन्नावमन्यसे ।\nमानेन भ्रष्टः स्वर्गस्ते नार्हस्त्वं पार्थिवात्मज\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147448, "chapter_id": 4189, "verse_number": "८", "content_sanskrit": "न च प्रज्ञायसे गच्छ पतस्वेति तमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147449, "chapter_id": 4189, "verse_number": "९", "content_sanskrit": "पतेयं सत्स्विति वचः त्रिरुक्त्वा नहुषात्मजः ।\nपतिष्यंश्चिन्तयामास गतिं गतिमतां वरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147450, "chapter_id": 4189, "verse_number": "१०", "content_sanskrit": "एतस्मिन्नेव काले तु नैमिशे पार्थिवर्षभान् ।\nचतुरोऽपश्यत नृपः तेषां मध्ये पपात सः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147451, "chapter_id": 4189, "verse_number": "११", "content_sanskrit": "प्रतर्दनो वसुमनाः शिबिरौशीनरोऽष्टकः ।\nवाजपेयेन यज्ञेन तर्पयन्ति सुरेश्वरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147452, "chapter_id": 4189, "verse_number": "१२", "content_sanskrit": "तेषामध्वरजं धूमं स्वर्गद्वारमुपस्थितम् ।\nययातिरुपजिघ्रन् वै निपपात महीं प्रति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147453, "chapter_id": 4189, "verse_number": "१३", "content_sanskrit": "भूमौ स्वर्गे च सम्बद्धां नदीं धूममयीमिव ।\nगङ्गां गामिव गच्छन्तीमालम्ब्य जगतीपतिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147454, "chapter_id": 4189, "verse_number": "१४", "content_sanskrit": "श्रीमत्स्ववभृथाग्र्येषु चतुर्षु प्रियबन्धुषु ।\nमध्ये निपतितो राजा लोकपालोपमेषु सः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147455, "chapter_id": 4189, "verse_number": "१५", "content_sanskrit": "चतुर्षु हुतकल्पेषु राजसिंहमहाग्निषु ।\nपपात मध्ये राजर्षिः ययातिः पुण्यसङ्क्षये\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147456, "chapter_id": 4189, "verse_number": "१६", "content_sanskrit": "तमाहुः पार्थिवाः सर्वे दीप्यमानमिव श्रिया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147457, "chapter_id": 4189, "verse_number": "१७", "content_sanskrit": "को भवान् कस्य वा बन्धुः देशस्य नगरस्य वा ।\nयक्षो वाऽप्यथवा देवो गन्धर्वो राक्षसोऽपि वा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147458, "chapter_id": 4189, "verse_number": "१८", "content_sanskrit": "न हि मानुषरूपोऽसि को वाऽर्थः काङ्क्षितस्त्वया\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147459, "chapter_id": 4189, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147460, "chapter_id": 4189, "verse_number": "१९", "content_sanskrit": "ययातिरस्मि राजर्षिः क्षीणपुण्यश्च्युतो दिवः ।\nपतेयं सत्स्विति ध्यायन् भवत्सु पतितस्ततः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147461, "chapter_id": 4189, "verse_number": "", "content_sanskrit": "राजानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147462, "chapter_id": 4189, "verse_number": "२०", "content_sanskrit": "सत्यमेतद् भवतु ते काङ्क्षितं पुरुषर्षभ ।\nसर्वेषां नः क्रतुफलं धर्मश्च प्रतिगृह्यताम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147463, "chapter_id": 4189, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147464, "chapter_id": 4189, "verse_number": "२१", "content_sanskrit": "नाहं प्रतिग्रहघनो ब्राह्मणः क्षत्रियो ह्यहम् ।\nन च मे प्रवणा बुद्धिः परपुण्यविनाशने\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147465, "chapter_id": 4189, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147466, "chapter_id": 4189, "verse_number": "२२", "content_sanskrit": "एतस्मिन्नेव काले तु मृगचर्याक्रमागताम् ।\nमाधवीं प्रेक्ष्य राजानस्त्वभिवाद्येदमब्रुवन्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147467, "chapter_id": 4189, "verse_number": "२३", "content_sanskrit": "किमागमनकृत्यं ते किं कुर्मः शासनं तव ।\nआज्ञाप्या हि वयं सर्वे तव पुत्रास्तपोधने\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147468, "chapter_id": 4189, "verse_number": "२४", "content_sanskrit": "तेषां तद् भाषितं श्रुत्वा माधवी परया मुदा ।\nपितरं समुपागच्छद् ययातिं सा ववन्द च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147469, "chapter_id": 4189, "verse_number": "२५", "content_sanskrit": "स्पृष्ट्वा मूर्धनि तान् पुत्रान् तापसी वाक्यमब्रवीत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147470, "chapter_id": 4189, "verse_number": "२६", "content_sanskrit": "दौहित्रास्तव राजेन्द्र मम पुत्रा न ते पराः ।\nइमे त्वां तारयिष्यन्ति दृष्टमेतत् पुरातनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147471, "chapter_id": 4189, "verse_number": "२७", "content_sanskrit": "अहं ते दुहिता राजन् माधवी मृगचारिणी ।\nमयाऽप्युपचितो धर्मः ततोऽर्धं प्रतिगृह्यताम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2147472, "chapter_id": 4189, "verse_number": "२८", "content_sanskrit": "यस्माद् राजन् नराः सर्वे अपत्यफलभागिनः ।\nतस्मादिच्छन्ति दौहित्रान् यथा त्वं वसुधाधिप\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2147473, "chapter_id": 4189, "verse_number": "२९", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे शिरसा जननीं तदा ।\nअभिवाद्य नमस्कृत्य मातामहमथाब्रुवन्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2147474, "chapter_id": 4189, "verse_number": "३०", "content_sanskrit": "उच्चैरनुपमैः स्निग्धैः स्वरैरापूर्य मेदिनीम् ।\nमातामहं नृपतयस्तारयन्तो दिवश्च्युतम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2147475, "chapter_id": 4189, "verse_number": "३१", "content_sanskrit": "राजधर्मगुणोपेताः सत्यधर्मपरायणाः ।\nदौहित्रास्ते वयं राजन् दिवमारोह पार्थिव\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2147476, "chapter_id": 4189, "verse_number": "३२", "content_sanskrit": "अथाकस्मादुपगतो गालवोऽप्याह पार्थिवम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2147477, "chapter_id": 4189, "verse_number": "३३", "content_sanskrit": "तपसो मेऽष्टभागेन स्वर्गमारोहतां भवान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2147478, "chapter_id": 4189, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि विंशोत्तरशततमोऽध्यायः ॥१२०॥ भगवद्यानपर्वणि एकपञ्चाशोऽध्यायः ॥५१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]