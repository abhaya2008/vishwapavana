[{"id": 2080057, "chapter_id": 2704, "verse_number": "१२-२०९-०x", "content_sanskrit": "`* युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080058, "chapter_id": 2704, "verse_number": "१२-२०९-१", "content_sanskrit": "पितामह महाप्राज्ञ केशवस्य महात्मनः।\nवक्तुमर्हसि तत्त्वेन माहात्म्यं पुनरेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080059, "chapter_id": 2704, "verse_number": "१२-२०९-२", "content_sanskrit": "न तृप्याम्यहमप्येनं पश्यञ्शृण्वंश्च भारत।\nएवं कृष्णं महाबाहो तस्मादेतद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080060, "chapter_id": 2704, "verse_number": "१२-२०९-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080061, "chapter_id": 2704, "verse_number": "१२-२०९-३", "content_sanskrit": "शृणु राजन्कथामेतां वैष्णवीं पापनाशनीम्।\nनारदो मां पुरा प्राह यामहं ते वदामि ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080062, "chapter_id": 2704, "verse_number": "१२-२०९-४", "content_sanskrit": "देवर्षिर्नारदः पूर्वं तत्वं वेत्स्यामि वै हरेः।\nइति संचिन्त्य मनसा दध्यौ ब्रह्म सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080063, "chapter_id": 2704, "verse_number": "१२-२०९-५", "content_sanskrit": "हिमालये शुभे दिव्ये दिव्यं वर्षशतं किल।\nअनुच्छ्वसन्निराहारः संयतात्मा जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080064, "chapter_id": 2704, "verse_number": "१२-२०९-६", "content_sanskrit": "ततोऽन्तरिक्षे वागासीत्तं मुनिप्रवरं प्रति।\nमेघगम्भीरनिर्घोषा दिव्या वाह्याऽशरीरिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080065, "chapter_id": 2704, "verse_number": "१२-२०९-७", "content_sanskrit": "किमर्थं त्वं समापन्नो ध्यानं मुनिवरोत्तम।\nअहं ददामि ते ज्ञानं धर्माद्यं वा वृणीष्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080066, "chapter_id": 2704, "verse_number": "१२-२०९-८", "content_sanskrit": "तच्छ्रुत्वा मुनिरालोच्य संभ्रमाविष्टमानसः।\nकिंनु स्यादिति संचिन्त्य वाक्यमाहापरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080067, "chapter_id": 2704, "verse_number": "१२-२०९-९", "content_sanskrit": "कस्त्वं भवानण्डं बिभेद मध्ये\nसमास्थितो वाक्यमुदीरयन्माम्।\nन रूपमन्यत्तव दृश्यते वै\nईदृग्विधस्त्वं समधिष्ठितोऽसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080068, "chapter_id": 2704, "verse_number": "१२-२०९-१०", "content_sanskrit": "पुनस्तमाह स मुनिमनन्तोऽहं बृहत्तरः।\nन मां मूढा विजानन्ति ज्ञानिनो मां विदन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080069, "chapter_id": 2704, "verse_number": "१२-२०९-११", "content_sanskrit": "तं प्रत्याह मुनिः श्रीमान्प्रणतो विनयान्वितः।\nभवन्तं ज्ञातुमिच्छामि तव तत्वं ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080070, "chapter_id": 2704, "verse_number": "१२-२०९-१२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा नारदं प्राह लोकपः।\nज्ञानेन मां विजानीहि नान्यथा शक्तिरस्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080071, "chapter_id": 2704, "verse_number": "१२-२०९-१३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080072, "chapter_id": 2704, "verse_number": "१२-२०९-१३", "content_sanskrit": "कीदृग्विधं तु तज्ज्ञानं येन जानामि ते तनुम्।\nअनन्त तन्मे ब्रूहि त्वं यद्यनुग्रहवानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080073, "chapter_id": 2704, "verse_number": "१२-२०९-१४x", "content_sanskrit": "लोकपाल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080074, "chapter_id": 2704, "verse_number": "१२-२०९-१४", "content_sanskrit": "विकल्पहीनं विपुलं तस्य चूरं शिवं परम्।\nज्ञानं तत्तेन जानासि साधनं प्रति ते मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080075, "chapter_id": 2704, "verse_number": "१२-२०९-१५", "content_sanskrit": "अत्रावृत्य स्थितं ह्येतत्तच्छुद्धमितरन्मृषा।\nएतत्ते सर्वमाख्यातं संक्षेपान्मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080076, "chapter_id": 2704, "verse_number": "१२-२०९-१६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080077, "chapter_id": 2704, "verse_number": "१२-२०९-१६", "content_sanskrit": "त्वमेव तव यत्तत्वं ब्रूहि लोकगुरो मम।\nभवन्तं ज्ञातुमिच्छामि कीदृग्भूतस्त्वमव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080078, "chapter_id": 2704, "verse_number": "१२-२०९-१७", "content_sanskrit": "ततः प्रहस्य भगवान्मेघगम्भीरया गिरा।\nप्राहेशः सर्वभूतानां न मे चास्यं श्रुतिर्न च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080079, "chapter_id": 2704, "verse_number": "१२-२०९-१८", "content_sanskrit": "न घ्राणजिह्वे दृक्चैव त्वचा नास्ति तथा मुने।\nकथं वक्ष्यामि चात्मानमशरीरस्तथाप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080080, "chapter_id": 2704, "verse_number": "१२-२०९-१९", "content_sanskrit": "तज्ज्ञात्वा विस्मयाविष्टो मुनिराह प्रणम्य तम्।\nयेन त्वं पूर्वमात्मानमनन्तोऽहं बृहत्तरः।\nशतोऽहमिति मां प्रीतः प्रोक्तवानसि तत्कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080081, "chapter_id": 2704, "verse_number": "१२-२०९-२०", "content_sanskrit": "पुनस्तमाह भगवांस्तवाप्यक्षाणि सन्ति वै।\nत्वमेनं ब्रूहि चात्मानं यदि शक्नोषि नारद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080082, "chapter_id": 2704, "verse_number": "१२-२०९-२१", "content_sanskrit": "आत्मा यथा तव मुने विदितस्तु भविष्यति।\nमां च जानासि तेन त्वमेकं साधनमावयोः।\nइत्युक्त्वा भगवान्देवस्ततो नोवाच किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080083, "chapter_id": 2704, "verse_number": "१२-२०९-२२", "content_sanskrit": "नारदोऽप्युत्स्मयन्खिन्नः क्व गतोऽसाविति प्रभुः।\nस्थित्वा स दीर्घकालं च मुनिर्व्यामूढमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080084, "chapter_id": 2704, "verse_number": "१२-२०९-२३", "content_sanskrit": "आह मां भगवान्देवस्त्वनन्तोऽहं बृहत्तरः।\nतेनाहमिति सर्वस्य को वानन्तो बृहत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080085, "chapter_id": 2704, "verse_number": "१२-२०९-२४", "content_sanskrit": "केयमुर्वी ह्यनन्ताख्या बृहती नूनमेव सा।\nयस्यां जानन्ति भूतानि विलीनानि ततस्ततः।\nएनां पृच्छामि तरुणीं सैषा नूनमुवाच माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080086, "chapter_id": 2704, "verse_number": "१२-२०९-२५", "content_sanskrit": "इत्येवं स मुनिः श्रीमान्कृत्वा निश्चयमात्मनः।\nस भूतलं समाविश्य प्रणिपत्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080087, "chapter_id": 2704, "verse_number": "१२-२०९-२६", "content_sanskrit": "आश्चर्यासि च धन्यासि वृहती त्वं वसुन्धरे।\nत्वामत्र वेत्तुमिच्छामि याग्दृभूताऽसि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080088, "chapter_id": 2704, "verse_number": "१२-२०९-२७", "content_sanskrit": "तच्छ्रुत्वा धरणी देवी स्मयमानाऽब्रवीदिदम्।\nनाहं हि बृहती विप्र न चानन्ता च सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080089, "chapter_id": 2704, "verse_number": "१२-२०९-२८", "content_sanskrit": "कारणं मम यो गन्धो गन्धात्मानं ब्रवीहि तम्।\nततो मुनिस्तद्धि तत्वं प्रणिपत्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080090, "chapter_id": 2704, "verse_number": "१२-२०९-२९", "content_sanskrit": "कारणं मे जलं मत्तो बृहत्तरतमं हि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080091, "chapter_id": 2704, "verse_number": "१२-२०९-३०", "content_sanskrit": "स समुद्रं मुनिर्गत्वा प्रणिपत्येदमब्रवीत्।\nआश्चर्योसि च धन्योसि ह्यनन्तोसि बृहत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080092, "chapter_id": 2704, "verse_number": "१२-२०९-३१", "content_sanskrit": "भवन्तं वेत्तुमिच्छामि कीदृग्भूतस्त्यमव्यय।\nतच्छ्रुत्वा सरितानाथः समुद्रो मुनिमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080093, "chapter_id": 2704, "verse_number": "१२-२०९-३२", "content_sanskrit": "कारणं मेऽत्र संपृच्छ रसात्मानं बृहत्तरम्।\nततो बृहत्तरं विद्वंस्त्वं पृच्छ मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080094, "chapter_id": 2704, "verse_number": "१२-२०९-३३", "content_sanskrit": "ततो मुनिर्यथायोगं जलं तत्वमवेक्ष्य तत्।\nजलात्मानं प्रणम्याह जलतत्वस्थितो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080095, "chapter_id": 2704, "verse_number": "१२-२०९-३४", "content_sanskrit": "आश्चर्योसि च धन्योसि ह्यनन्तोसि बृहत्तरः।\nभवन्तं श्रोतुमिच्छामिकीदृग्भूतस्त्वमव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080096, "chapter_id": 2704, "verse_number": "१२-२०९-३५", "content_sanskrit": "ततो रसात्म--मुनिमाह पुनः पुनः।\nममापि कारणं पृच्छ तेजोरूपं विभावसुम्।\nनाहं बृहत्तरो ब्रह्मन्नाप्यनन्तश्च सत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080097, "chapter_id": 2704, "verse_number": "१२-२०९-३६", "content_sanskrit": "ततोऽग्निं प्रणिपत्याह मुनिर्विस्मितमानसः।\nयज्ञात्मानं महावासं सर्वभूतनमस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080098, "chapter_id": 2704, "verse_number": "१२-२०९-३७", "content_sanskrit": "आश्चर्योसि च धन्योसि ह्यनन्तश्च बृहत्तरः।\nभवन्तं वेत्तुमिच्छामि कीदृग्भूतस्त्वमव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080099, "chapter_id": 2704, "verse_number": "१२-२०९-३८", "content_sanskrit": "ततः प्रहस्य भगवान्मुनिं स्विष्टकृदब्रवीत्।\nनाहं बृहत्तरो ब्रह्मन्नाप्यनन्तश्च सत्तम।\nकारणं मम रूपं यत्तं पृच्छ मुनिसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080100, "chapter_id": 2704, "verse_number": "१२-२०९-३९", "content_sanskrit": "ततो योगक्रमेणैव प्रतीतं तं प्रविश्य सः।\nरूपात्मानं प्रणम्याह नारदो वदतांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080101, "chapter_id": 2704, "verse_number": "१२-२०९-४०", "content_sanskrit": "आश्चर्योसि च धन्योसि ह्यनन्तोसि बृहत्तरः।\nभवन्तं वेत्तुमिच्छामि कीदृग्भूतस्त्वमव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080102, "chapter_id": 2704, "verse_number": "१२-२०९-४१", "content_sanskrit": "उत्स्मयित्वा तु रूपात्मा तं मुनिं प्रत्युवाच ह।\nवायुर्मे कारणं ब्रह्मंस्तं पृच्छ मुनिसत्तम।\nमत्तो बहुतरः श्रीमाननन्तश्च महाविलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080103, "chapter_id": 2704, "verse_number": "१२-२०९-४२", "content_sanskrit": "स मारुतं प्रणम्याह भगवान्मुनिसत्तमः।\nयोगसिद्धो महायोगी ज्ञानविज्ञानपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080104, "chapter_id": 2704, "verse_number": "१२-२०९-४३", "content_sanskrit": "आश्चर्योसि च धन्योसि ह्यनन्तोसि बृहत्तरः।\nभवन्तं वेत्तुमिच्छामि कीदृग्भूतस्त्वमव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080105, "chapter_id": 2704, "verse_number": "१२-२०९-४४", "content_sanskrit": "ततो वायुर्हि संप्राह नारदं मुनिसत्तमम्।\nकारणं पृच्छ भगवन्स्पर्शात्मानं ममाद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2080106, "chapter_id": 2704, "verse_number": "१२-२०९-४५", "content_sanskrit": "मत्तो बृहत्तरः श्रीमाननन्तश्च तथैव सः।\nततोस्य वचनं श्रुत्वा स्पर्शात्मानमुवाच सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2080107, "chapter_id": 2704, "verse_number": "१२-२०९-४६", "content_sanskrit": "आश्चर्योसि च धन्योसि ह्यनन्तोसि बृहत्तरः।\nभवन्तं वेत्तुमिच्छामि कीदृग्भूतस्त्वमव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2080108, "chapter_id": 2704, "verse_number": "१२-२०९-४७", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा स्पर्शात्मा मुनिमब्रवीत्।\nनाहं वृहत्तरो ब्रह्मन्नाप्यनन्तश्च सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2080109, "chapter_id": 2704, "verse_number": "१२-२०९-४८", "content_sanskrit": "कारणं मम चैवेममाकाशं च बृहत्तरम्।\nतं पृच्छ मुनिशार्दूल सर्वव्यापिनमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2080110, "chapter_id": 2704, "verse_number": "१२-२०९-४९", "content_sanskrit": "तच्छ्रुत्वा नारदः श्रीमान्वाक्यं वाक्यविशारदः।\nआकाशं समुपागम्य प्रणम्याह कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2080111, "chapter_id": 2704, "verse_number": "१२-२०९-५०", "content_sanskrit": "आश्चर्योसि न धन्योसि ह्यनन्तोसि बृहत्तरः।\nभवन्तं वेत्तुमिच्छामि कीदृग्भूतस्त्वमव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2080112, "chapter_id": 2704, "verse_number": "१२-२०९-५१", "content_sanskrit": "आकाशस्तमुवाचेदं प्रहसन्मुनिसत्तमम्।\nनाहं बृहत्तरो ब्रह्मञ्शब्दो वै कारणं मम।\nतं पृच्छ मुनिशार्दूल स वै मत्तो बृहत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2080113, "chapter_id": 2704, "verse_number": "१२-२०९-५२", "content_sanskrit": "ततो ह्याविश्य चाकाशं शब्दात्मानमुवाच ह।\nस्वरव्यञ्जनसंयुक्तं नानाहेतुविभूषितम्।\nवेदाख्यं परमं गुह्यं वेदकारणमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2080114, "chapter_id": 2704, "verse_number": "१२-२०९-५३", "content_sanskrit": "आश्चर्योसि च धन्योसि ह्यनन्तोसि बृहत्तरः।\nभवन्तं श्रोतुमिच्छामि कीदृग्भूतस्त्वमव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2080115, "chapter_id": 2704, "verse_number": "१२-२०९-५४", "content_sanskrit": "वेदात्मा प्रत्युवाचेदं नारदं मुनिपुङ्गवम्।\nमया कारणभूतेन सर्ववेत्ता पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2080116, "chapter_id": 2704, "verse_number": "१२-२०९-५५", "content_sanskrit": "ब्रह्मणो बुद्धिसंस्थानमास्थितोऽहं महामुने।\nतस्माद्वृहत्तरो मत्तः पद्मयोनिर्महामतिः।\nतं पृच्छ मुनिशार्दूल सर्वकारणकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2080117, "chapter_id": 2704, "verse_number": "१२-२०९-५६", "content_sanskrit": "ब्रह्मलोकं ततो गत्वा नारदो मुनिपुङ्गवैः।\nसेव्यमानं महात्मानं लोकपालैर्मरुद्गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2080118, "chapter_id": 2704, "verse_number": "१२-२०९-५७", "content_sanskrit": "समुद्रैश्च सरिद्भिश्च भूततत्वैः सभूधरैः।\nगन्धर्वैरप्सरोभिश्च ज्योतिषां च गणैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2080119, "chapter_id": 2704, "verse_number": "१२-२०९-५८", "content_sanskrit": "स्तुतिस्तोमग्रहस्तोभैस्तथा वेदैर्मुनीश्वरैः।\nउपास्यमानं ब्रह्माणं लोकनाथं परात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2080120, "chapter_id": 2704, "verse_number": "१२-२०९-५९", "content_sanskrit": "हिरण्यगर्भं विश्वेशं चतुर्वक्रेण भूषितम्।\nप्रणम्य प्राञ्जलिः प्रह्वस्तमाह मुनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2080121, "chapter_id": 2704, "verse_number": "१२-२०९-६०", "content_sanskrit": "आश्चर्योसि च धन्योसि ह्यनन्तोसि बृहत्तरः।\nभवन्तं वेत्तुमिच्छामि कीदृग्भूतस्त्वमव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2080122, "chapter_id": 2704, "verse_number": "१२-२०९-६१", "content_sanskrit": "तच्छ्रुत्वा भगवान्ब्रह्मा सर्वलोकपितामहः।\nउत्स्मयन्मुनिमाहेदं कर्ममूलस्य लोपकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2080123, "chapter_id": 2704, "verse_number": "१२-२०९-६२", "content_sanskrit": "नाहं बृहत्तरो ब्रह्मन्नाप्यनन्तश्च सत्तम।\nलोकानां मम सर्वेषां नाथभूतो बृहत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2080124, "chapter_id": 2704, "verse_number": "१२-२०९-६३", "content_sanskrit": "नन्दगोपकुले गोपकुमारैः परिवारितः।\nसमस्तजगतां गोप्ता गोपवेषेण संस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2080125, "chapter_id": 2704, "verse_number": "१२-२०९-६४", "content_sanskrit": "मद्रूपं च समास्थाय जगत्सृष्टिं करोति सः।\nऐशानमास्थितः श्रीमान्हन्ति नित्यं हि पाति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2080126, "chapter_id": 2704, "verse_number": "१२-२०९-६५", "content_sanskrit": "विष्णुः स्वरूपरूपोऽसौ कारणं स हरिर्मम।\nतं पृच्छ मुनिशार्दूल स चानन्तो बृहत्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2080127, "chapter_id": 2704, "verse_number": "१२-२०९-६६", "content_sanskrit": "ततोऽवतीर्य भगवान्ब्रह्मलोकान्महामुनिः।\nनन्दगोपकुले विष्णुमेनं कृष्णं जगत्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2080128, "chapter_id": 2704, "verse_number": "१२-२०९-६७", "content_sanskrit": "बालक्रीडनकासक्तं वत्सजालविभूषितम्।\nपाययित्वाथ बध्नन्तं धूलिधूम्राननं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2080129, "chapter_id": 2704, "verse_number": "१२-२०९-६८", "content_sanskrit": "गाहमानैर्हसद्भिश्च नृत्यद्भिश्च समन्ततः।\nपाणिवादनकैश्चैव संवृतं वेणुवादकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2080130, "chapter_id": 2704, "verse_number": "१२-२०९-६९", "content_sanskrit": "प्रणिपत्याब्रवीदेनं नारदो भगवान्मुनिः।\nआश्चर्योसि च धन्योसि ह्यनन्तश्च बृहत्तरः।\nवेत्ताऽसि चाव्ययश्चासि वेत्तुमिच्छामि यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2080131, "chapter_id": 2704, "verse_number": "१२-२०९-७०", "content_sanskrit": "ततः प्रहस्य भगवान्नारदं प्रत्युवाच ह।\nमत्तः परतरं नास्ति मत्तः सर्वं प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2080132, "chapter_id": 2704, "verse_number": "१२-२०९-७१", "content_sanskrit": "मतो बृहत्तरं नान्यदहमेव बृहत्तरः।\nआकाशे च स्थितः पूर्वमुक्तवानहमेव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2080133, "chapter_id": 2704, "verse_number": "१२-२०९-७२", "content_sanskrit": "न मां वेत्ति जनः कश्चिन्माया मम दुरत्यया।\nभक्त्या त्वनन्यया युक्ता मां विजानन्ति योगिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2080134, "chapter_id": 2704, "verse_number": "१२-२०९-७३", "content_sanskrit": "प्रियोसि मम भक्तोसि मम तत्वं विलोकय।\nददामि तव तज्ज्ञानं येन तत्वं प्रपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2080135, "chapter_id": 2704, "verse_number": "१२-२०९-७४", "content_sanskrit": "अन्येषां चैव भक्तानां मम योगरतात्मनाम्।\nददामि दिव्यं ज्ञानं च येन तत्वं प्रपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2080136, "chapter_id": 2704, "verse_number": "१२-२०९-७५", "content_sanskrit": "अन्येषां चैव भक्तानां मम योगरतात्मनाम्।\nददामि दिव्यं ज्ञानं च तेन ते यान्ति मत्पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2080137, "chapter_id": 2704, "verse_number": "१२-२०९-७६", "content_sanskrit": "एवमुक्त्वा ययौ कृष्णो नन्दगोपगृहं हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2080138, "chapter_id": 2704, "verse_number": "१२-२०९-७७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2080139, "chapter_id": 2704, "verse_number": "१२-२०९-७७", "content_sanskrit": "एतत्ते कथितं राजन्विष्णुतत्वमनुत्तमम्।\nभजस्वैनं विशालाक्षं जपन्कृष्णेति सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2080140, "chapter_id": 2704, "verse_number": "१२-२०९-७८", "content_sanskrit": "मोहयन्मां तथा त्वां च शृणोत्येष मयेरितान्।\nधर्मात्मा च महाबाहो भक्तान्रक्षति नान्यथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2080141, "chapter_id": 2704, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नवाधिकद्विशततमोऽध्यायः॥ २०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]