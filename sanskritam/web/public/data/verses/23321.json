[{"id": 7003321000, "chapter_id": 23321, "verse_number": "२-१६-१", "content_sanskrit": "सनत्कुमार उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003321001, "chapter_id": 23321, "verse_number": "२-१६-२", "content_sanskrit": "पुनरेव महाबुद्धे श्रोतुमिच्छामि तत्त्वतः ।\nबहुभिर्बहुधा शब्दैः शब्दितानि मुनीश्वरैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003321002, "chapter_id": 23321, "verse_number": "२-१६-३", "content_sanskrit": "शैलादिरुवाच  ।\nपुनः पुनः प्रवक्ष्यामि शिवरूपाणि ते मुने ।\nबहुभिर्बहुधा शब्दैः शब्दितानि मुनीश्वरैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003321003, "chapter_id": 23321, "verse_number": "२-१६-४", "content_sanskrit": "क्षेत्रज्ञः प्रकृतिर्व्यक्तं कालात्मेति मुनीश्वरैः ।\nउच्यते कैश्चिदाचार्यैरागमार्णवपारगैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003321004, "chapter_id": 23321, "verse_number": "२-१६-५", "content_sanskrit": "क्षेत्रज्ञं पुरुषं प्राहुः प्रधानं प्रकृतिं बुधाः ।\nविकारजातं निःशेषं प्रकृतेर्व्यक्तमित्यपि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003321005, "chapter_id": 23321, "verse_number": "२-१६-६", "content_sanskrit": "प्रधानव्यक्तयोः कालः परिणामैककारणम् ।\nतच्चतुष्टयमीशस्य रूपाणां हि चतुष्टयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003321006, "chapter_id": 23321, "verse_number": "२-१६-७", "content_sanskrit": "हिरण्यगर्भं पुरुषं प्रधानं व्यक्तरूपिणम् ।\nकथयंति शिवं केचिदाचार्याः परमेश्वरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003321007, "chapter_id": 23321, "verse_number": "२-१६-८", "content_sanskrit": "हिरण्यगर्भः कर्तास्य भोक्ता विश्वस्य पूरुषः ।\nविकारजातं व्यक्ताख्यं प्रधानं कारणं परम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003321008, "chapter_id": 23321, "verse_number": "२-१६-९", "content_sanskrit": "तेषां चतुष्टयं बुद्धेः शिवरूपचतुष्टयम् ।\nप्रोच्यते शंकरादन्यदस्ति वस्तु न किंचन ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003321009, "chapter_id": 23321, "verse_number": "२-१६-१०", "content_sanskrit": "पिंडजातिस्वरूपी तु कथ्यते कौश्चिदीश्वरः ।\nचराचरशंरीरामि पिंडाख्याखिलान्यपि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003321010, "chapter_id": 23321, "verse_number": "२-१६-११", "content_sanskrit": "सामान्यानि समस्तानि महासामान्यमेव च ।\nकथ्यंते जातिशब्देन तानि रूपाणि धीमतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003321011, "chapter_id": 23321, "verse_number": "२-१६-१२", "content_sanskrit": "विराट्र हिरण्यगर्भात्मा कैश्चिदीशो निगद्यते ।\nहिरण्यगर्भो लोकानां हेतुर्लोकात्मको विराट् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003321012, "chapter_id": 23321, "verse_number": "२-१६-१३", "content_sanskrit": "सूत्राव्याकृतरूपं तं शिवं शंसंति केचन ।\nअव्याकृतं प्रधानं हि तद्रूपं परमेष्ठनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003321013, "chapter_id": 23321, "verse_number": "२-१६-१४", "content_sanskrit": "लोका येनैव तिष्ठंति सूत्रे मणिगणा इव ।\nतत्सूत्रमिति विज्ञेयं रूपमद्भुतविक्रमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003321014, "chapter_id": 23321, "verse_number": "२-१६-१५", "content_sanskrit": "अंतर्यामी परः कैश्चित्कैश्चिदीशः प्रकीर्त्यते ।\nस्वयंज्योतिः स्वयंवेद्यः शिवः शंभुर्महेश्वरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003321015, "chapter_id": 23321, "verse_number": "२-१६-१६", "content_sanskrit": "सर्वेषामेव भूतानामंतर्यामी शिवः स्मृतः ।\nसर्वेषामेव भूतानां परत्वात्पर उच्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003321016, "chapter_id": 23321, "verse_number": "२-१६-१७", "content_sanskrit": "परमात्मा शिवः शंभुः शंकरः परमेश्वरः ।\nप्राज्ञतैजसविश्वाख्यं तस्य रूपत्रयं विदुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003321017, "chapter_id": 23321, "verse_number": "२-१६-१८", "content_sanskrit": "सुषुप्तिस्वप्नजाग्रंतमवस्थात्रयमेव तत् ।\nविराट् हिरण्यगर्भाख्यमव्याकृतपदाह्वयम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003321018, "chapter_id": 23321, "verse_number": "२-१६-१९", "content_sanskrit": "तुरीयस्य शिवस्यास्य अवस्थात्रयगामिनः ।\nहिरण्यगर्भः पुरुषः कालइत्येव कीर्तिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003321019, "chapter_id": 23321, "verse_number": "२-१६-२०", "content_sanskrit": "तिस्रोऽवस्था जगत्सृष्टिस्थितिसंहारहेतवः ।\nभवविष्णुविरिंचाख्यमवस्थात्रयमीशितुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003321020, "chapter_id": 23321, "verse_number": "२-१६-२१", "content_sanskrit": "आराध्य भक्त्या मुक्तिं च प्राप्नुवंति शरीरिणः ।\nकर्ता क्रिया च कार्यं च करणं चेति सूरिभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003321021, "chapter_id": 23321, "verse_number": "२-१६-२२", "content_sanskrit": "शंभोश्चत्वारि रूपाणि कीर्त्यंते परमेष्ठिनः ।\nप्रमाता च प्रमाणं च प्रमेयं प्रमितिस्तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003321022, "chapter_id": 23321, "verse_number": "२-१६-२३", "content_sanskrit": "चत्वार्येतानि रूपाणि शिवस्यैव न संशयः ।\nईश्वराव्याकृतप्राणविराट्भूतेंद्रियात्मकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003321023, "chapter_id": 23321, "verse_number": "२-१६-२४", "content_sanskrit": "शिवस्यैव विकारोऽयं समुद्रस्येव वीचयः ।\nईश्वरं जगतामाहुर्निमित्तं कारणं तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003321024, "chapter_id": 23321, "verse_number": "२-१६-२५", "content_sanskrit": "अव्याकृतं प्रधानं हि तदुक्तं वेदवादिभिः ।\nहिरण्यगर्भः प्राणाख्यो विराट् लोकात्मकः स्मृतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003321025, "chapter_id": 23321, "verse_number": "२-१६-२६", "content_sanskrit": "महा भूतानि भूतानि कार्याणि इन्द्रियाणि च ।\nशिवस्यैतानि रूपाणि शंसंति मुनिसत्तमाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003321026, "chapter_id": 23321, "verse_number": "२-१६-२७", "content_sanskrit": "परमात्मा शिवादन्यो नास्तीति कवयोविदुः ।\nशिवजातानि तत्त्वानि पंचविंशन्मनीषिभिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003321027, "chapter_id": 23321, "verse_number": "२-१६-२८", "content_sanskrit": "उक्तानि न तदन्यानि सलिलादूर्मिवृंदवत् ।\nपंचविंशत्पदार्थेभ्यः शिवतत्त्वं परं विदुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003321028, "chapter_id": 23321, "verse_number": "२-१६-२९", "content_sanskrit": "तानि तस्मादनन्यानि सुवर्णकटकादिवत् ।\nसदाशिवेश्वराद्यानि तत्त्वानि शिवतत्त्वतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003321029, "chapter_id": 23321, "verse_number": "२-१६-३०", "content_sanskrit": "जातानि न तदन्यानि मृद्द्रव्यं कुंभभेदवत् ।\nमाया विद्या क्रिया शक्तिर्ज्ञानशक्तिः क्रियामयी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003321030, "chapter_id": 23321, "verse_number": "२-१६-३१", "content_sanskrit": "जाताः शिवान्न संदेहः किरणा इव सूर्यतः ।\nसर्वात्मकं शिवं देवं सर्वाश्रयविधायिनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003321031, "chapter_id": 23321, "verse_number": "२-१६-३२", "content_sanskrit": "भजस्व सर्वभावेन श्रेयश्चेत्प्राप्तुमिच्छसि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]