[{"id": 5000118000, "chapter_id": 9118, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000118001, "chapter_id": 9118, "verse_number": "२-४१-१", "content_sanskrit": "तस्मिंस्तु पुरुषव्याघ्रे निष्क्रामति कृताञ्जलौ।\nआर्तशब्दो हि संजज्ञे स्त्रीणामन्तःपुरे महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000118002, "chapter_id": 9118, "verse_number": "२-४१-२", "content_sanskrit": "अनाथस्य जनस्यास्य दुर्बलस्य तपस्विनः।\nयो गतिः शरणं चासीत् स नाथः क्व नु गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000118003, "chapter_id": 9118, "verse_number": "२-४१-३", "content_sanskrit": "न क्रुध्यत्यभिशस्तोऽपि क्रोधनीयानि वर्जयन्।\nक्रुद्धान् प्रसादयन् सर्वान् समदुःखः क्व गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000118004, "chapter_id": 9118, "verse_number": "२-४१-४", "content_sanskrit": "कौसल्यायां महातेजा यथा मातरि वर्तते।\nतथा यो वर्ततेऽस्मासु महात्मा क्व नु गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000118005, "chapter_id": 9118, "verse_number": "२-४१-५", "content_sanskrit": "कैकेय्या क्लिश्यमानेन राज्ञा संचोदितो वनम्।\nपरित्राता जनस्यास्य जगतः क्व नु गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000118006, "chapter_id": 9118, "verse_number": "२-४१-६", "content_sanskrit": "अहो निश्चेतनो राजा जीवलोकस्य संक्षयम्।\nधर्म्यं सत्यव्रतं रामं वनवासे प्रवत्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000118007, "chapter_id": 9118, "verse_number": "२-४१-७", "content_sanskrit": "इति सर्वा महिष्यस्ता विवत्सा इव धेनवः।\nरुरुदुश्चैव दुःखार्ताः सस्वरं च विचुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000118008, "chapter_id": 9118, "verse_number": "२-४१-८", "content_sanskrit": "स तमन्तःपुरे घोरमार्तशब्दं महीपतिः।\nपुत्रशोकाभिसंतप्तः श्रुत्वा चासीत् सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000118009, "chapter_id": 9118, "verse_number": "२-४१-९", "content_sanskrit": "नाग्निहोत्राण्यहूयन्त नापचन् गृहमेधिनः।\nअकुर्वन् न प्रजाः कार्यं सूर्यश्चान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000118010, "chapter_id": 9118, "verse_number": "२-४१-१०", "content_sanskrit": "व्यसृजन् कवलान् नागा गावो वत्सान् न पाययन्।\nपुत्रां प्रथमजं लब्ध्वा जननी नाभ्यनन्दत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000118011, "chapter_id": 9118, "verse_number": "२-४१-११", "content_sanskrit": "त्रिशङ्कुर्लोहिताङ्गश्च बृहस्पतिबुधावपि।\nदारुणाः सोममभ्येत्य ग्रहाः सर्वे व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000118012, "chapter_id": 9118, "verse_number": "२-४१-१२", "content_sanskrit": "नक्षत्राणि गतार्चींषि ग्रहाश्च गततेजसः।\nविशाखाश्च सधूमाश्च नभसि प्रचकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000118013, "chapter_id": 9118, "verse_number": "२-४१-१३", "content_sanskrit": "कालिकानिलवेगेन महोदधिरिवोत्थितः।\nरामे वनं प्रव्रजिते नगरं प्रचचाल तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000118014, "chapter_id": 9118, "verse_number": "२-४१-१४", "content_sanskrit": "दिशः पर्याकुलाः सर्वास्तिमिरेणेव संवृताः।\nन ग्रहो नापि नक्षत्रं प्रचकाशे न किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000118015, "chapter_id": 9118, "verse_number": "२-४१-१५", "content_sanskrit": "अकस्मान्नागरः सर्वो जनो दैन्यमुपागमत्।\nआहारे वा विहारे वा न कश्चिदकरोन्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000118016, "chapter_id": 9118, "verse_number": "२-४१-१६", "content_sanskrit": "शोकपर्यायसंतप्तः सततं दीर्घमुच्छ्वसन्।\nअयोध्यायां जनः सर्वश्चुक्रोश जगतीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000118017, "chapter_id": 9118, "verse_number": "२-४१-१७", "content_sanskrit": "बाष्पपर्याकुलमुखो राजमार्गगतो जनः।\nन हृष्टो लभ्यते कश्चित् सर्वः शोकपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000118018, "chapter_id": 9118, "verse_number": "२-४१-१८", "content_sanskrit": "न वाति पवनः शीतो न शशी सौम्यदर्शनः।\nन सूर्यस्तपते लोकं सर्वं पर्याकुलं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000118019, "chapter_id": 9118, "verse_number": "२-४१-१९", "content_sanskrit": "अनर्थिनः सुताः स्त्रीणां भर्तारो भ्रातरस्तथा।\nसर्वे सर्वं परित्यज्य राममेवान्वचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000118020, "chapter_id": 9118, "verse_number": "२-४१-२०", "content_sanskrit": "ये तु रामस्य सुहृदः सर्वे ते मूढचेतसः।\nशोकभारेण चाक्रान्ताः शयनं नैव भेजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000118021, "chapter_id": 9118, "verse_number": "२-४१-२१", "content_sanskrit": "ततस्त्वयोध्या रहिता महात्मना\nपुरन्दरेणेव मही सपर्वता।\nचचाल घोरं भयशोकदीपिता\nसनागयोधाश्वगणा ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000118022, "chapter_id": 9118, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे एकचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]