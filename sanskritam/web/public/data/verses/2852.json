[{"id": 2087301, "chapter_id": 2852, "verse_number": "१२-३५७-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087302, "chapter_id": 2852, "verse_number": "१२-३५७-१", "content_sanskrit": "श्रुतं भगवतस्तस्य माहात्म्यं परमात्मनः।\nजन्मधर्मगृहे चैव नरनारायणात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087303, "chapter_id": 2852, "verse_number": "१२-३५७-२", "content_sanskrit": "महावराहसृष्टा च पिण्डोत्पत्तिः पुरातनी।\nप्रवृत्तौ च निवृत्तौ च यो यथा परिकल्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087304, "chapter_id": 2852, "verse_number": "१२-३५७-३", "content_sanskrit": "तथा स नः श्रुतो ब्रह्मन्कथ्यमानस्त्वयाऽनघ।\nहव्यकव्यभुजो विष्णुरुदक्पूर्वे महोदधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087305, "chapter_id": 2852, "verse_number": "१२-३५७-४", "content_sanskrit": "यच्च तत्कथितं पूर्वं त्वया हयशिरो महत्।\nतच्च दृष्टं भगवता ब्रह्मणा परमेष्ठिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087306, "chapter_id": 2852, "verse_number": "१२-३५७-५", "content_sanskrit": "किं तदुत्पादितं पूर्वं हरिणा लोकधारिणा।\nरूपं प्रभावं महतामपूर्वं धीमतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087307, "chapter_id": 2852, "verse_number": "१२-३५७-६", "content_sanskrit": "दृष्ट्वा हि विवुधश्रेष्ठमपूर्वममितौजसम्।\nतदश्वशिरसं पुण्यं ब्रह्मा किमकरोन्मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087308, "chapter_id": 2852, "verse_number": "१२-३५७-७", "content_sanskrit": "एतन्नः संशयं ब्रह्मन्पुराणं ब्रह्मसंभवम्।\nकथयस्वोत्तममते महापुरुषसंश्रितम्।\nपाविताः स्म त्वया ब्रह्मन्पुण्याः कथय ताः कथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087309, "chapter_id": 2852, "verse_number": "१२-३५७-८x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087310, "chapter_id": 2852, "verse_number": "१२-३५७-८", "content_sanskrit": "कथयिष्यामि ते सर्वं पुराणं वेदसंमितम्।\nजगौ यद्भगवान्व्यासो राज्ञः पारिक्षितस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087311, "chapter_id": 2852, "verse_number": "१२-३५७-९", "content_sanskrit": "श्रुत्वाऽश्वशिरसो मूर्ति देवस्य हरिमेधसः।\nउत्पन्नसंशयो राजा एतदेवमचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087312, "chapter_id": 2852, "verse_number": "१२-३५७-१०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087313, "chapter_id": 2852, "verse_number": "१२-३५७-१०", "content_sanskrit": "यत्तद्दर्शितवान्ब्राह्म देवं हयशिरोधरम्।\nकिमर्थं तत्समभवद्वपुर्देवोपकल्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087314, "chapter_id": 2852, "verse_number": "१२-३५७-११x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087315, "chapter_id": 2852, "verse_number": "१२-३५७-११", "content_sanskrit": "यत्किंचिदिह लोके वै देहबद्धं विशांपते।\nसर्वं पञ्चभिराविष्टं भूतैरीश्वरबुद्धिजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087316, "chapter_id": 2852, "verse_number": "१२-३५७-१२", "content_sanskrit": "ईश्वरो हि जगत्स्रष्टा प्रभुर्नारायणो विराट्।\nभूतान्तरात्मा वरदः सगुणो निर्गुणोपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087317, "chapter_id": 2852, "verse_number": "१२-३५७-१३", "content_sanskrit": "भूतप्रलयमव्यक्तं शृणुष्व नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087318, "chapter_id": 2852, "verse_number": "१२-३५७-१४", "content_sanskrit": "धरण्यामथ लीनायामप्सु चैकार्णवे पुरा।\nज्योतिर्भूते जले चापि लीने ज्योतिषि चानिले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087319, "chapter_id": 2852, "verse_number": "१२-३५७-१५", "content_sanskrit": "वायौ चाकाशसंलीने आकाशे च मनोनुगे।\nव्यक्ते मनसि संलीने व्यक्ते चाव्यक्ततां गते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087320, "chapter_id": 2852, "verse_number": "१२-३५७-१६", "content_sanskrit": "अव्यक्ते पुरुषं याते पुंसि सर्वगतेऽपि च।\nतम एवाभवत्सर्वं न प्राज्ञायत किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087321, "chapter_id": 2852, "verse_number": "१२-३५७-१७", "content_sanskrit": "तमसो ब्रह्मसंभूतं तमोमूलमृतात्मकम्।\nतद्विश्वभावसंज्ञान्तं पौरुषीं तनुमाश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087322, "chapter_id": 2852, "verse_number": "१२-३५७-१८", "content_sanskrit": "सोऽनिरुद्ध इति प्रोक्तस्तत्प्रधानं प्रचक्षते।\nतदव्यक्तमिति ज्ञेयं त्रिगुणं नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087323, "chapter_id": 2852, "verse_number": "१२-३५७-१९", "content_sanskrit": "विद्यासहायवान्देवो विष्वक्सेनो हरिः प्रभुः।\n`आदिकर्ता स भूतानामप्रमेयो हरिः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087324, "chapter_id": 2852, "verse_number": "१२-३५७-२०", "content_sanskrit": "अप्स्वेव शयनं चक्रे निद्रायोगमुपागतः।\nजगतश्चिन्तयन्सृष्टिं चित्रां बहुगुणोद्भवाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087325, "chapter_id": 2852, "verse_number": "१२-३५७-२१", "content_sanskrit": "तस्य चिन्तयतः सृष्टिं महानात्मगुणः स्मृतः।\nअहंकारस्ततो जातो ब्रह्मा शुभचतुर्मुखः।\nहिरण्यगर्भो भगवान्सर्वलोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087326, "chapter_id": 2852, "verse_number": "१२-३५७-२२", "content_sanskrit": "पद्मेऽनिरुद्धात्संभूतस्तदा पद्मनिभेक्षणः।\nसहस्रपत्रे द्युतिमानुपविष्टः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087327, "chapter_id": 2852, "verse_number": "१२-३५७-२३", "content_sanskrit": "ददृशेऽद्भुतसंकाशो लोकानाप्याययन्प्रभुः।\nसत्वस्थः परमेष्ठी स ततो भूतगणान्सृजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087328, "chapter_id": 2852, "verse_number": "१२-३५७-२४", "content_sanskrit": "पूर्वमेव च पद्मस्य पत्रे सूर्यांशुसप्रभे।\nनारायणकृतौ बिन्दू अपामास्तां गुणोत्तरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087329, "chapter_id": 2852, "verse_number": "१२-३५७-२५", "content_sanskrit": "तावपश्यत्स भगवाननादिनिधनोऽच्युतः।\nएकस्तत्राभवद्विन्दुर्मध्वाभो रुचिरप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2087330, "chapter_id": 2852, "verse_number": "१२-३५७-२६", "content_sanskrit": "स तामसो मधुर्जातस्तदा नारायणाज्ञया।\nकठिनस्त्वपरो विन्दुः कैटभो राजसस्तु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2087331, "chapter_id": 2852, "verse_number": "१२-३५७-२७", "content_sanskrit": "तावभ्यधातवां श्रेष्ठौ तमोरजगुणान्वितौ।\nबलवन्तौ गदाहस्तौ पद्मनालानुसारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2087332, "chapter_id": 2852, "verse_number": "१२-३५७-२८", "content_sanskrit": "ददृशातेऽरविन्दस्थं ब्रह्माणममितप्रभवम्।\nसृजन्तं प्रथमं वेदांश्चतुरश्चारुविग्रहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2087333, "chapter_id": 2852, "verse_number": "१२-३५७-२९", "content_sanskrit": "ततो विग्रहवन्तस्तान्वेदान्दृष्ट्वाऽसुरोत्तमौ।\nसहसा जगृहतुर्वेदान्ब्रह्मणः पश्यतस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2087334, "chapter_id": 2852, "verse_number": "१२-३५७-३०", "content_sanskrit": "अथ तौ दानवश्रेष्ठौ वेदान्गृह्य सनातनान्।\nरसां विविशतुस्तूर्णमुदक्पूर्वे महोदधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2087335, "chapter_id": 2852, "verse_number": "१२-३५७-३१", "content_sanskrit": "ततो हृतेषु देवेषु ब्रह्मा कश्मलमाविशत्।\nततो वचनमीशानं प्राह वेदैर्विनाकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2087336, "chapter_id": 2852, "verse_number": "१२-३५७-३२x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2087337, "chapter_id": 2852, "verse_number": "१२-३५७-३२", "content_sanskrit": "वेदा मे परमं चक्षुर्वेदा मे परमं बलम्।\nवेदा मे परमं धाम वेदा मे ब्रह्म चोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2087338, "chapter_id": 2852, "verse_number": "१२-३५७-३३", "content_sanskrit": "मम वेदा हृताः सर्वे दानवाभ्यां बलादितः।\nअन्धकारा हि मे लोका जाता वेदैर्विना कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2087339, "chapter_id": 2852, "verse_number": "१२-३५७-३४", "content_sanskrit": "वेदानृते हि किं कुर्या लोकानां सृष्टिमुत्तमाम्।\nअहो बत महद्दुःखं वेदनाशनजं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2087340, "chapter_id": 2852, "verse_number": "१२-३५७-३५", "content_sanskrit": "प्राप्तं दुनोति हृदयं तीव्रं शोकपरायणम्।\nको हि शोकार्णवे मग्नं मामितोऽद्य समुद्धरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2087341, "chapter_id": 2852, "verse_number": "१२-३५७-३६", "content_sanskrit": "वदांस्तांश्चानयेन्नष्टान्कस्य चाहं प्रियो भवे।\nइत्येवं भाषमाणस्य ब्रह्मणो नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2087342, "chapter_id": 2852, "verse_number": "१२-३५७-३७", "content_sanskrit": "हरेः स्तोत्रार्थमुद्भूता बुद्धिर्बुद्धिमतां वर।\nततो जगौ परं जप्यं साञ्जलिप्रग्रहः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2087343, "chapter_id": 2852, "verse_number": "१२-३५७-३८x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2087344, "chapter_id": 2852, "verse_number": "१२-३५७-३८", "content_sanskrit": "ॐ नमस्ते ब्रह्महृदय नमस्ते मम पूर्वज।\nलोकाद्यभुवनश्रेष्ठ साङ्ख्ययोगनिधे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2087345, "chapter_id": 2852, "verse_number": "१२-३५७-३९", "content_sanskrit": "व्यक्ताव्यक्तकराचिन्त्य क्षेमं पन्थानमास्थितः।\nविश्वभुक्सर्वभूतानामन्तरात्मन्नयोनिज।\nअहं प्रसादजस्तुभ्यं लोकधाम स्वयंभुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2087346, "chapter_id": 2852, "verse_number": "१२-३५७-४०", "content_sanskrit": "त्वत्तो मे मानसं जन्म प्रथमं द्विजपूजितम्।\nचाक्षुषं वै द्वितीयं मे जन्म चासीत्पुरातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2087347, "chapter_id": 2852, "verse_number": "१२-३५७-४१", "content_sanskrit": "त्वत्प्रसादात्तु मे जन्म तृतीयं वाचिकं महत्।\nत्वत्तः श्रवणजं चापि चतुर्थं जन्म मे विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2087348, "chapter_id": 2852, "verse_number": "१२-३५७-४२", "content_sanskrit": "नासत्यं चापि मे जन्म त्वत्तः पञ्चममुच्यते।\nअण्डजं चापि मे जन्म त्वत्तः षष्ठं विनिर्मितं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2087349, "chapter_id": 2852, "verse_number": "१२-३५७-४३", "content_sanskrit": "इदं च सप्तमं जन्म पद्मजन्मेति वै प्रभो।\nसर्गेसर्गे ह्यहं पुत्रस्तव त्रिगुणवर्जित॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2087350, "chapter_id": 2852, "verse_number": "१२-३५७-४४", "content_sanskrit": "प्रथमः पुण्डरीकाक्षः प्रधानगुणकल्पितः।\nत्वमीश्वरः स्वभावश्च भूतानां त्वं प्रभावन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2087351, "chapter_id": 2852, "verse_number": "१२-३५७-४५", "content_sanskrit": "त्वया विनिर्मितोऽहं वै वेदचक्षुर्वयोतिग।\nते मे वेदा हृताश्चक्षुरन्धो जातोस्मि जागृहि।\nददस्व चक्षूंषि मम प्रियोऽहं ते प्रियोसि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2087352, "chapter_id": 2852, "verse_number": "१२-३५७-४६", "content_sanskrit": "एवं स्तुतः स भगवान्पुरुषः सर्वतोमुखः।\nजहौ निद्रामथ तदा वेदकार्यार्थमुह्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2087353, "chapter_id": 2852, "verse_number": "१२-३५७-४७", "content_sanskrit": "ऐश्वर्येण प्रयोगेण द्वितीयां तनुमास्थितः।\nसुनासिकेन कायेन भूत्वा चन्द्रप्रभस्तदा।\nकृत्वा हयशिरः शुभ्रं वेदानामालयं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2087354, "chapter_id": 2852, "verse_number": "१२-३५७-४८", "content_sanskrit": "तस्य मूर्धा समभवद्द्यौः सनक्षत्रतारकाः।\nकेशाश्चास्याभवन्दीर्घा रवेरंशुसमप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2087355, "chapter_id": 2852, "verse_number": "१२-३५७-४९", "content_sanskrit": "कर्णावाकाशपाताले ललाटं भूतधारिणी।\nगङ्गासरस्वती पुण्ये भ्रुवावास्तां महाद्युती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2087356, "chapter_id": 2852, "verse_number": "१२-३५७-५०", "content_sanskrit": "चक्षुषी सोमसूर्यौं ते नासा संध्या पुनः स्मृता।\nॐकारस्त्वथ संस्कारो विद्युज्जिह्वा च निर्मिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2087357, "chapter_id": 2852, "verse_number": "१२-३५७-५१", "content_sanskrit": "दन्ताश्च पितरो राजन्सोमपा इति विश्रुताः।\nगोलोको ब्रह्मलोकश्च ओष्ठावास्तां महात्मनः।\nग्रीवा चास्याभवद्राजन्कालरात्रिर्गुणोत्तरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2087358, "chapter_id": 2852, "verse_number": "१२-३५७-५२", "content_sanskrit": "एतद्धयशिरः कृत्वा नानामूर्तिभिरावृतम्।\nअन्तर्दधौ स विश्वेशो विवेश च रसां प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2087359, "chapter_id": 2852, "verse_number": "१२-३५७-५३", "content_sanskrit": "रसां पुनः प्रविष्टश्च योगं परममास्थितः।\nशैक्ष्यं स्वरं समास्थाय उद्गीतं प्रासृजत्स्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2087360, "chapter_id": 2852, "verse_number": "१२-३५७-५४", "content_sanskrit": "सस्वरः सानुनादी च सर्वशः स्निग्ध एव च।\nबभूवान्तर्जलगतः सर्वभूतगुणोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2087361, "chapter_id": 2852, "verse_number": "१२-३५७-५५", "content_sanskrit": "ततस्तावसुरौ कृत्वा वेदान्समयबन्धनान्।\nरसातले विनिक्षिप्य यतः शब्दस्ततो द्रुतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2087362, "chapter_id": 2852, "verse_number": "१२-३५७-५६", "content_sanskrit": "एतस्मिन्नन्तरे राजन्देवो हयशिरोधरः।\nजग्राह वेदानखिलान्रसालगतान्हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2087363, "chapter_id": 2852, "verse_number": "१२-३५७-५७", "content_sanskrit": "प्रादाच्च ब्रह्मणे भूयस्ततः स्वां प्रकृतिं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2087364, "chapter_id": 2852, "verse_number": "१२-३५७-५८", "content_sanskrit": "स्थापयित्वा हयशिरा उदक्पूर्वे महोदधौ।\nवेदानामालयश्चापि बभूवाश्वरिरास्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2087365, "chapter_id": 2852, "verse_number": "१२-३५७-५९", "content_sanskrit": "अथ किंचिदपश्यन्तौ दानवौ मधुकैटभौ।\nयत्र देवा विनिक्षिप्तास्तत्स्थानं शून्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2087366, "chapter_id": 2852, "verse_number": "१२-३५७-६०", "content_sanskrit": "तत उत्तममास्थाय वेगं बलवतां वरौ।\nपुनरुत्तस्थतुः शीघ्रं रसानामालयात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2087367, "chapter_id": 2852, "verse_number": "१२-३५७-६१", "content_sanskrit": "ददृशाते च पुरुषं तमेवादिकरं प्रभुम्।\nश्वेतं चन्द्रविशुद्धाभमनिरुद्धतनौ स्थितम्।ट\nभूयोप्यमितविक्रान्तं निद्रायोगमुपागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2087368, "chapter_id": 2852, "verse_number": "१२-३५७-६२", "content_sanskrit": "आत्मप्रमाणरचिते अपामुपरि कल्पिते।\nशयने नागभोगाढ्ये ज्वालामालासमावृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2087369, "chapter_id": 2852, "verse_number": "१२-३५७-६३", "content_sanskrit": "निष्कल्मषेण सत्वेन संपन्नं रुचिरप्रभम्।\nतं दृष्ट्वा दानवेन्द्रौ तौ महाहासममुञ्चताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2087370, "chapter_id": 2852, "verse_number": "१२-३५७-६४", "content_sanskrit": "ऊचतुश्च समाविष्टौ रजसा तमसा च तौ।\nअयं स पुरुषः श्वेतः शेते निद्रामुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2087371, "chapter_id": 2852, "verse_number": "१२-३५७-६५", "content_sanskrit": "अनेन नूनं वेदानां कृतमाहरणं रसात्।\nकस्यैष कोनु खल्वेष किंच स्वपिति भोगवान्।\nइच्युच्चारितवाक्यौ तौ बोधयामासतुर्हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2087372, "chapter_id": 2852, "verse_number": "१२-३५७-६६", "content_sanskrit": "युद्धार्थिनौ हि विज्ञाय विबुद्धः पुरुषोत्तमः।\nनिरीक्ष्य चासुरेन्द्रौ तौ ततो युद्धे मनोदधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2087373, "chapter_id": 2852, "verse_number": "१२-३५७-६७", "content_sanskrit": "अथ युद्धं समभवत्तयोर्नारायणस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2087374, "chapter_id": 2852, "verse_number": "१२-३५७-६८", "content_sanskrit": "रजस्तमोविष्टतनू तावुभौ मधुकैटभौ।\nब्रह्मणोपचितिं कुर्वञ्जधान मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2087375, "chapter_id": 2852, "verse_number": "१२-३५७-६९", "content_sanskrit": "ततस्तयोर्वधेनाशु वेदापहरणेन च।\nशोकापनयनं चक्रे ब्रह्मणः पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2087376, "chapter_id": 2852, "verse_number": "१२-३५७-७०", "content_sanskrit": "ततः परिवृतो ब्रह्मा हरिणा वेदसत्कृतः।\nनिर्ममे स तदा लोकान्कृत्स्नान्स्थावरजङ्गमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2087377, "chapter_id": 2852, "verse_number": "१२-३५७-७१", "content_sanskrit": "दत्त्वा पितामहायाग्र्यां मतिं लोकविसर्गिकीम्।\nतत्रैवान्तर्दधे देवो यत एवागतो हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2087378, "chapter_id": 2852, "verse_number": "१२-३५७-७२", "content_sanskrit": "तौ दानवौ हरिर्हत्वा कृत्वा हयशिरस्तनुम्।\nपुनः प्रवृत्तिधर्मार्थं तामेव विदधे तनुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2087379, "chapter_id": 2852, "verse_number": "१२-३५७-७३", "content_sanskrit": "एवमेष महाभागो बभूवाश्वशिरा हरिः।\nपौराणमेतत्प्रख्यातं रूपं वरदमैश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2087380, "chapter_id": 2852, "verse_number": "१२-३५७-७४", "content_sanskrit": "यो ह्येतद्ब्राह्मणो नित्यं शृणुयाद्धारयीत वा।\nन तस्याध्ययनं नाशमुपगच्छेत्कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2087381, "chapter_id": 2852, "verse_number": "१२-३५७-७५", "content_sanskrit": "आराध्य तपसोग्रेण देवं हयशिरोधरम्।\nपाञ्चालेन क्रमः प्राप्तो रामेण पथि देशिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2087382, "chapter_id": 2852, "verse_number": "१२-३५७-७६", "content_sanskrit": "एतद्धयशिरो राजन्नाख्यानं तव कीर्तितम्।\nपुराणं वेदसमितं यन्मां त्वं परिपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2087383, "chapter_id": 2852, "verse_number": "१२-३५७-७७", "content_sanskrit": "यांयामिच्छेत्तनुं देवः कर्तुं कार्यविधौ क्वचित्।\nतातां कुर्याद्विकुर्वाणः स्वयमात्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2087384, "chapter_id": 2852, "verse_number": "१२-३५७-७८", "content_sanskrit": "एष वेदनिधिः श्रीमानेष वै तपसोनिधिः।\nएष योगश्च साङ्ख्यं च ब्रह्म चाग्र्यं हविर्विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2087385, "chapter_id": 2852, "verse_number": "१२-३५७-७९", "content_sanskrit": "नारायणपरा वेदा याज्ञा नारायणात्मकाः।\nतपो नारायणपरं नारायणपरा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2087386, "chapter_id": 2852, "verse_number": "१२-३५७-८०", "content_sanskrit": "नारायणपरं सत्यमृतं नारायणात्मकम्।\nनारायणपरो धर्मः पुनरावृत्तिदुर्लभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2087387, "chapter_id": 2852, "verse_number": "१२-३५७-८१", "content_sanskrit": "प्रवृत्तिलक्षणश्चैव धर्मो नारायणात्मकः।\nनारायणात्मको गन्धो भूमौ श्रेष्ठतमः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2087388, "chapter_id": 2852, "verse_number": "१२-३५७-८२", "content_sanskrit": "अपां चापि गुणा राजन्रसा नारायणात्मकाः।\nज्योतिषां च परं रूपं स्मृतं नारायणात्मकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2087389, "chapter_id": 2852, "verse_number": "१२-३५७-८३", "content_sanskrit": "नारायणात्मकश्चापि स्पर्शो वायुगुणः स्मृतः।\nनारायणात्मकश्चैव शब्द आकाशसंभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2087390, "chapter_id": 2852, "verse_number": "१२-३५७-८४", "content_sanskrit": "मनश्चापि ततो भूतमव्यक्तगुणलक्षणम्।\nनारायणपरं कालो ज्योतिषामयनं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2087391, "chapter_id": 2852, "verse_number": "१२-३५७-८५", "content_sanskrit": "नारायणपरा कीर्तिः श्रीश्च लक्ष्णीश्च देवताः।\nनारायणपरं साङ्ख्यं योगो नारायणात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2087392, "chapter_id": 2852, "verse_number": "१२-३५७-८६", "content_sanskrit": "कारणं पुरुषो ह्येषां प्रधानं चापि कारणम्।\nस्वभावश्चैव कर्माणि दैवं येषां च कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2087393, "chapter_id": 2852, "verse_number": "१२-३५७-८७", "content_sanskrit": "अधिष्ठानं तथा कर्ता करणं च पृथग्विधम्।\nविविधा च तथा चेष्टा दैवं चैवात्र पञ्चमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2087394, "chapter_id": 2852, "verse_number": "१२-३५७-८८", "content_sanskrit": "पञ्चकारणसंख्यातो निष्ठा सर्वत्र वै हरिः।\nतत्त्वं विज्ञासमानानां हेतुभिः सर्वतोमुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2087395, "chapter_id": 2852, "verse_number": "१२-३५७-८९", "content_sanskrit": "तत्त्वमेको महायोगी हनिर्नारायणः प्रभुः।\nब्रह्मादीनां सलोकानामृषीणां च महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2087396, "chapter_id": 2852, "verse_number": "१२-३५७-९०", "content_sanskrit": "साङ्ख्यानां योगिनां चापि यतीनामात्मवेदिनाम्।\nमनीषितं विजानाति केशवो न तु तस्य ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2087397, "chapter_id": 2852, "verse_number": "१२-३५७-९१", "content_sanskrit": "ये केचित्सर्वलोकेषु दैवं पित्र्यं च कुर्वते।\nदानानि च प्रयच्छन्ति तप्यन्ते च तपो महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2087398, "chapter_id": 2852, "verse_number": "१२-३५७-९२", "content_sanskrit": "सर्वेषामाश्रयो विष्णुरैश्वरं विधिमास्थितः।\nसर्वभूतकृतावासो वासुदेवेति चोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2087399, "chapter_id": 2852, "verse_number": "१२-३५७-९३", "content_sanskrit": "अयं हि नित्यः परमो महर्षि\nर्महाविभूतिर्गुणवान्गुणाख्यः।\nगुणैश्च संयोगमुपैति शीघ्रं\nकालो यथर्तावृतुसंप्रयुक्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2087400, "chapter_id": 2852, "verse_number": "१२-३५७-९४", "content_sanskrit": "नैवास्य विन्दन्ति गतिं महात्मनो\nन चागतिं कश्चिदिहानुपश्यति।\nज्ञानात्मकाः संयमिनो महर्षयः।\nपश्यन्ति नित्यं पुरुषं गुणाधिकम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2087401, "chapter_id": 2852, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये सप्तपञ्चाशदधिकत्रिशततमोऽध्यायः॥ ३५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]