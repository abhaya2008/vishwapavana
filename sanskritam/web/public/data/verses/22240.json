[{"id": 7002240000, "chapter_id": 22240, "verse_number": "२८५-१", "content_sanskrit": "धन्वन्तरिरुवाच ।\nसिद्धयोगान् पुनर्वक्ष्ये मृतसञ्जीवनीकरान् ।\nआत्रेयभाषितान् दिव्यान् सर्वव्याधिविमर्दनान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002240001, "chapter_id": 22240, "verse_number": "२८५-२", "content_sanskrit": "आत्रेय उवाच ।\nविल्वादिपञ्चमूलस्य क्काथः स्याद्वातिके ज्वरे ।\nपावनं पिप्पलीमूलं गुडूची विष्वजोऽथ वा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002240002, "chapter_id": 22240, "verse_number": "२८५-३", "content_sanskrit": "आमलक्यभ्या कृष्णा वह्निः सर्वज्वरान्तकः ।\nविल्वाग्निमन्थश्योनाककाश्मर्य्यः पारला स्थिरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002240003, "chapter_id": 22240, "verse_number": "२८५-४", "content_sanskrit": "त्रिकण्टकं पृश्निपर्णी वृहती कण्टकारिकाः ।\nज्वराविपाकपार्श्वार्त्तिकाशनुत् कुशमृलकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002240004, "chapter_id": 22240, "verse_number": "२८५-५", "content_sanskrit": "गुडूची पर्पटी मुस्तं किरातं विश्वभेषजम् ।\nवातपित्तज्वरे देयं पञ्चभद्रमिदं स्मृतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002240005, "chapter_id": 22240, "verse_number": "२८५-६", "content_sanskrit": "त्रिवृद्विशालकटुकात्रिफलारग्बधैः कृतः ।\nसंस्कारो भेदनक्काथः पेथः सर्वज्वरापहः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002240006, "chapter_id": 22240, "verse_number": "२८५-७", "content_sanskrit": "देवदारुबलावासात्रिफलाव्योषपद्मकैः ।\nसविडङ्गैः सितातुल्यं तच्चूर्णं पञ्चकाशजित् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002240007, "chapter_id": 22240, "verse_number": "२८५-८", "content_sanskrit": "दशमूलीशटीरास्नापिप्पलीविल्वपौष्करैः ।\nश्रृङ्गीतामलकीभार्गीगुडूचीनागवल्लिभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002240008, "chapter_id": 22240, "verse_number": "२८५-९", "content_sanskrit": "यवाग्रं विधिना सिद्धं कषायं वा पिवेन्नरः ।\nकाशहृद्ग्रहणीपार्श्वहिक्काश्वासप्रशान्तये ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002240009, "chapter_id": 22240, "verse_number": "२८५-१०", "content_sanskrit": "मधुकं मधुना युक्तं पिप्पलीं शर्करान्वितां ।\nनागरं गुड़संयुक्तं हिक्काघ्नं लावणत्रयम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002240010, "chapter_id": 22240, "verse_number": "२८५-११", "content_sanskrit": "कारव्यजाजीमरिचं द्राक्षा वृक्षाम्लदाड़िमम् ।\nसौवर्च्चलं गुड़ं क्षौद्रं सर्वारोचननाशनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002240011, "chapter_id": 22240, "verse_number": "२८५-१२", "content_sanskrit": "श्रृह्गवेररसञ्चैव मधुना सह पाययेत् ।\nअरुचिश्वासकाशघ्नं प्रतिश्यायकफान्तकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002240012, "chapter_id": 22240, "verse_number": "२८५-१३", "content_sanskrit": "वटं श्रृङ्गी शिलालोध्रदाड़िमं मधुकं मधु ।\nपिवेत् तण्डुलतोयेन च्छर्दितृष्णानिवारणम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002240013, "chapter_id": 22240, "verse_number": "२८५-१४", "content_sanskrit": "गुडुची वासकं लोध्रं पिप्पलीक्षौद्रसंयुतम् ।\nकफान्वितञ्जयेद्रक्तं तृष्णआकासज्वरापहम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002240014, "chapter_id": 22240, "verse_number": "२८५-१५", "content_sanskrit": "वासकस्य रसस्तद्वत् समधुस्ताम्रजो रसः ।\nशिरीषपुष्पसुरसभावितं मरिचं हितं ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002240015, "chapter_id": 22240, "verse_number": "२८५-१६", "content_sanskrit": "सर्व्वार्त्तिनुन्मसूरोऽथ पित्तमुक् तण्डुलीयकं ।\nनिर्ग्गुण्डी शारिवा शेलुरह्कोलश्च विषापहः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002240016, "chapter_id": 22240, "verse_number": "२८५-१७", "content_sanskrit": "महौषधं मृतां क्षुद्रां पुष्करं ग्रन्थिकोद्भवं ।\nपिवेत् कणायुतं क्काथं मूर्च्छायाञ्च मदेषु च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002240017, "chapter_id": 22240, "verse_number": "२८५-१८", "content_sanskrit": "हिङ्गुसौवर्च्चलव्योषैर्द्विपलांशैर्घृताढकं ।\nचतुर्गुणे गवां मूत्रे सिद्धमुन्मादनाशनं ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002240018, "chapter_id": 22240, "verse_number": "२८५-१९", "content_sanskrit": "शङ्खपुष्पीवचाकुष्ठैः सिद्धं ब्राह्मीरसैर्युतं ।\nपुराणआं हन्त्यपस्मारं सोन्मादं मेध्यमुत्तमं ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002240019, "chapter_id": 22240, "verse_number": "२८५-२०", "content_sanskrit": "पञ्चगव्यं घृतं तद्वत् कुष्ठनुच्चाभ्यायुतं ।\nपटोलत्रिफलानिम्बगुडु वीधावणीवृषैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002240020, "chapter_id": 22240, "verse_number": "२८५-२१", "content_sanskrit": "सकरञ्जैर्घृतं सिद्धं कुष्ठनुद्वज्र्कं स्मृतं ।\nनिम्बं पटोलं व्याघ्री च गुडुची वासकं तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002240021, "chapter_id": 22240, "verse_number": "२८५-२२", "content_sanskrit": "कुर्य्याद्दशपलान् भागान् एकैकस्य सकुट्टितान् ।\nजलद्रोणए विपक्तव्यं यावत्पादावशेषितं ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002240022, "chapter_id": 22240, "verse_number": "२८५-२३", "content_sanskrit": "घृतप्रस्थम्प्चेत्तेन त्रिफलागर्भसंयुतं ।\nपञ्चतिक्तमिति ख्यातं सर्पिः कुष्ठविनाशनं ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002240023, "chapter_id": 22240, "verse_number": "२८५-२४", "content_sanskrit": "अशीतिं वातजान् रोगान् चत्वारिंशच्च पैत्तिकान् ।\nविंशतिं श्लैष्मिकान् कासपीनसार्शोव्रणादिकान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002240024, "chapter_id": 22240, "verse_number": "२८५-२५", "content_sanskrit": "हन्त्यन्यान् योगराजोषऽयं यथार्कस्तिमिरं खलु ।\nत्रिफलायाः कषायेन् भृङ्गराजरसेन च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002240025, "chapter_id": 22240, "verse_number": "२८५-२६", "content_sanskrit": "ब्रणप्रक्षालनङ्कुर्यादुपदंशप्रशान्तये ।\nपटोलदलचूर्णेन दाडिमत्वग्रजोऽथ वा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002240026, "chapter_id": 22240, "verse_number": "२८५-२७", "content_sanskrit": "गुण्डयेच्च गजेनापि त्रिफलाचूर्णकेन च ।\nत्रिफलायोरजोयष्टिमार्कवोत्पलमारिचै ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002240027, "chapter_id": 22240, "verse_number": "२८५-२८", "content_sanskrit": "ससैन्धवैः पचेत्तैलमभ्यह्गाच्छर्द्दिकापहं ।\nसक्षीरान् मार्कवरसान् द्विप्रस्थमधुकोत्पलैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002240028, "chapter_id": 22240, "verse_number": "२८५-२९", "content_sanskrit": "पचेत्तु तैलकुडवं तन्नस्यं पलितापहं ।\nनिम्बम्पटोलं त्रिफला गुडूची खदिरं वृषं ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002240029, "chapter_id": 22240, "verse_number": "२८५-३०", "content_sanskrit": "भूनिम्बपाठात्रिफलागुडूचीरक्तचन्दनं ।\nयोगद्वयं ज्वरं हन्ति कुष्ठविस्फोटकादिकं ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002240030, "chapter_id": 22240, "verse_number": "२८५-३१", "content_sanskrit": "पटोलामृतभूनिम्बवासारिष्टकपर्पटैः ।\nखदिरान्तयुतैः क्काथो विस्फोटज्वरशान्तिकृत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002240031, "chapter_id": 22240, "verse_number": "२८५-३२", "content_sanskrit": "दशमूली च्छिन्नरुहा पथ्या दारु पुनर्नवा ।\nज्वर्रावद्रधिशोथेषु शिग्रुविश्वजिता हिताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002240032, "chapter_id": 22240, "verse_number": "२८५-३३", "content_sanskrit": "मधूकं निम्बपत्राणि लेपः स्याद् व्रणशोधनः ।\nत्रिफला खदिरो दार्वी न्यग्रोधातिबलाकुशाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002240033, "chapter_id": 22240, "verse_number": "२८५-३४", "content_sanskrit": "निम्बमूलकपत्राणां कषायाः शोधने हिताः ।\nकरञ्जारिष्टनिर्गुण्डीरसो हन्याद् व्रणक्रिमीन् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002240034, "chapter_id": 22240, "verse_number": "२८५-३५", "content_sanskrit": "धातकीचन्दनबलासमह्गामधुकोत्पलैः ।\nदार्वीमेदोन्वितैर्लेपः ससर्पिर्व्रणरोपणः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002240035, "chapter_id": 22240, "verse_number": "२८५-३६", "content_sanskrit": "गुग्गुलुत्रिफलाव्योषसमांशैर्घृतयोगतः ।\nनाडी दुष्टवणं शूलम्भगन्दरमुखं हरेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002240036, "chapter_id": 22240, "verse_number": "२८५-३७", "content_sanskrit": "हरितकीं मूत्रसिद्धां सतैललवणान्वितां ।\nप्रातः प्रातश्च सेवेत् कफवातामयापहां ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002240037, "chapter_id": 22240, "verse_number": "२८५-३८", "content_sanskrit": "त्रिककटुत्रिफलाक्काथं९ सक्षारलवणं पिवेत् ।\nकफवातात्मकेष्वेव विंरेकः कफवृद्धिनुत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002240038, "chapter_id": 22240, "verse_number": "२८५-३९", "content_sanskrit": "पिप्पलीपिप्पलीमूलवचाचित्रकनागरैः ।\nक्काथितं वा पिवेत्पेयमामवातविनाशनं ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002240039, "chapter_id": 22240, "verse_number": "२८५-४०", "content_sanskrit": "रास्नां गुडुचीमेरण्डदेवदारुमहौषधं ।\nपिवेत् सर्वाड्गिके वाते सामे सन्ध्यस्थिमज्जगे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002240040, "chapter_id": 22240, "verse_number": "२८५-४१", "content_sanskrit": "दशमूलकषायं वा पिवेद्वा नागराम्भसा ।\nसुण्ठीगोक्षुरकक्काथः प्रातः प्रातर्न्निषेवितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002240041, "chapter_id": 22240, "verse_number": "२८५-४२", "content_sanskrit": "सामवातकटीशूलपाचनो रुक्प्रणाशनः ।\nसमूलपत्रशाखायाः प्रसारण्याश्च तैलकं ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002240042, "chapter_id": 22240, "verse_number": "२८५-४३", "content_sanskrit": "गुडुच्याः सुरसः कल्कः चूर्णं वा क्काथमेव च ।\nप्रभूतकालमासेव्य मुच्यते वातशोणितात् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002240043, "chapter_id": 22240, "verse_number": "२८५-४४", "content_sanskrit": "पिप्पली वर्द्धमानं वा सेव्यं पथ्या गुडेन् वा ।\nपटोलत्रिफलातीव्रकटुकामृतसाधितं ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002240044, "chapter_id": 22240, "verse_number": "२८५-४५", "content_sanskrit": "पक्वं पीत्वा जयत्याशु सदाहं वातशोणितं ।\nगुग्गुलं कोष्णशीते तु गुडुची त्रिफलाम्भ्सा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002240045, "chapter_id": 22240, "verse_number": "२८५-४६", "content_sanskrit": "बलापुनर्न्नवैरण्डवृहतीद्वयगोक्षुरैः ।\nसहिङ्गु लवणैः पीतं सद्यो वातरुजापहं ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002240046, "chapter_id": 22240, "verse_number": "२८५-४७", "content_sanskrit": "कार्षिकं पिप्पलीलमूलं पञ्चैव लवणानि च ।\nपिप्पली चित्रकं शुण्ठी त्रिफ्ला त्रिवृता वचा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002240047, "chapter_id": 22240, "verse_number": "२८५-४८", "content_sanskrit": "द्वौ क्षारौ शाद्वला दन्ती स्वर्णक्षीरी विषाणिका ।\nकोलप्रमाणां गुटिकां पिवेत् सौवीरकायुतां ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002240048, "chapter_id": 22240, "verse_number": "२८५-४९", "content_sanskrit": "शोथावपाके त्रिवृता प्रवृद्धे चोदरादिके ।\nक्षीरं शोथहरं दारु वर्षाभूर्नागरैः शुभम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002240049, "chapter_id": 22240, "verse_number": "२८५-५०", "content_sanskrit": "सेकस्तथार्कवर्षाभूनिम्बक्काथेन शोथजित् ।\nव्योषगर्भं पलाशस्य त्रिगुणे भस्मवारिणि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002240050, "chapter_id": 22240, "verse_number": "२८५-५१", "content_sanskrit": "साधितं पिवतः सर्पिः पतत्यर्शो न संशयः ।\nविश्वक्सेनावनिर्ग्गुण्डीसाधितं चापि लावणं ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002240051, "chapter_id": 22240, "verse_number": "२८५-५२", "content_sanskrit": "विड़ङ्गानलसिन्धूत्थरास्नाग्रक्षारदारुभिः ।\nतैलञ्चतुर्गुणं सिद्धं कटुद्रव्यं जलेन वा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002240052, "chapter_id": 22240, "verse_number": "२८५-५३", "content_sanskrit": "गणअडमालापहं तैलमभ्यङ्गात् गलगण्डनुत् ।\nशटीकुनागबलयक्काथः क्षीरससे युतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002240053, "chapter_id": 22240, "verse_number": "२८५-५४", "content_sanskrit": "पयस्यापिप्पलीवासाकल्कं सिद्धंक्षये हितम् ।\nवचाविड़भयाशुण्ठीहिङ्गुकुष्ठाग्निदीप्यकान् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002240054, "chapter_id": 22240, "verse_number": "२८५-५५", "content_sanskrit": "द्वित्रिषट्चतुरेकांशसप्तपञ्चाशिकाः क्रमात् ।\nचूर्णं पीतं हन्ति गुल्मं उदरं शूलकासनुत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002240055, "chapter_id": 22240, "verse_number": "२८५-५६", "content_sanskrit": "पाठानिकुम्भत्रिकटुत्रिफलाग्निषु साधितम् ।\nमूत्रेण चूर्णगुटिका गुल्मप्लीहादिमर्द्दनी ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002240056, "chapter_id": 22240, "verse_number": "२८५-५७", "content_sanskrit": "वासानिम्बपटोलानि त्रिफला वातपित्तनुत् ।\nलिह्यात् क्षौद्रेण विड़ङ्गं चूर्णं कृमिविनाशनम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002240057, "chapter_id": 22240, "verse_number": "२८५-५८", "content_sanskrit": "विड़ङ्गसैन्धवक्षारमृत्रेनापि हरीतकी ।\nशल्लकीवदरीजम्बुपियालाम्रार्जुनत्वचः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002240058, "chapter_id": 22240, "verse_number": "२८५-५९", "content_sanskrit": "पीताः क्षीरेण मध्वक्ताः पृथक्शोणितवारणाः ।\nविल्वाम्रधातकीपाठाशुण्ठीमोचरसाः समाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002240059, "chapter_id": 22240, "verse_number": "२८५-६०", "content_sanskrit": "पीता रुन्धन्त्यतीसारं गुड़तक्रेण दुर्जयम् ।\nचाङ्गेरीकोलदध्यम्बुनागरक्षारसंयुतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002240060, "chapter_id": 22240, "verse_number": "२८५-६१", "content_sanskrit": "घृततयुक्क्काथितं पेयं गुदभ्रंसे रुजापहम् ।\nविड़ङ्गातिविषामुस्तं दारुपाठाकलिङ्गकम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002240061, "chapter_id": 22240, "verse_number": "२८५-६२", "content_sanskrit": "मरीचेन समायुक्तं शोथातीसारनाशनम् ।\nशर्करासिन्धुशुण्ठीभिः कृष्णामधुगुड़ेन वा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002240062, "chapter_id": 22240, "verse_number": "२८५-६३", "content_sanskrit": "द्वे द्वे खादेद्धरीतक्यौ जीवेद्वर्षशतं सुखी ।\nत्रिफला पिप्पलीयुक्ता समध्वाज्या तथैव सा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002240063, "chapter_id": 22240, "verse_number": "२८५-६४", "content_sanskrit": "चूर्णमामलकं तेन सुरसेन तु भावितम् ।\nमध्वाज्यशर्करायुक्तं लिढ्वा स्त्रीशः पयः पिवेत् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002240064, "chapter_id": 22240, "verse_number": "२८५-६५", "content_sanskrit": "मासपिप्पलिशालीनां यवगोधूमयोस्तथा ।\nचूर्णभागैः समांशैश्च पचेत् पिप्पलिकां शुभां ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002240065, "chapter_id": 22240, "verse_number": "२८५-६६", "content_sanskrit": "तां भक्षयित्वा च पिवेत् शर्करामधुरं पयः ।\nनवश्चटकवज्जम्भेद् दशवारान् स्त्रियं ध्रुवम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002240066, "chapter_id": 22240, "verse_number": "२८५-६७", "content_sanskrit": "समङ्गाधातकीपुष्पलोध्रनीलोत्पलानि च ।\nएतत् क्षीरेण दातव्यं स्त्रीणां प्रदरनाशनं ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002240067, "chapter_id": 22240, "verse_number": "२८५-६८", "content_sanskrit": "वीजङ्कौरण्टकञ्चापि मधुकं श्वेतचन्दनं ।\nपद्मोत्पलस्य मूलानि मधुकं शर्करातिलान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002240068, "chapter_id": 22240, "verse_number": "२८५-६९", "content_sanskrit": "द्रवमाणेषु गर्भेषु गर्भस्थापनमुत्तमं ।\nदेवदारु नभः कुष्ठं नलदं विश्वभेषजं ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002240069, "chapter_id": 22240, "verse_number": "२८५-७०", "content_sanskrit": "लेपः काञ्जिकसम्पिष्टस्तैलयुक्तः शिरोर्त्तिनुत् ।\nवस्त्रपूतं क्षिपेत् कोष्णं सिन्धूत्थं कर्णशूलनुत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002240070, "chapter_id": 22240, "verse_number": "२८५-७१", "content_sanskrit": "लशुनार्द्रकशिग्रूणां कदल्या वा रसः पृथक् ।\nबलाशतावरीरास्नामृताः मैरीयकैः पिवेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002240071, "chapter_id": 22240, "verse_number": "२८५-७२", "content_sanskrit": "त्रिफलासहितं सर्पिस्तिमिरघ्नमनुत्तमं ।\nत्रिफलाव्योषसिन्धूत्थैर्घृतं सिद्धं पिवेन्नरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002240072, "chapter_id": 22240, "verse_number": "२८५-७३", "content_sanskrit": "चाक्षुष्यम्भेदनं हृद्यं दीपनं कफरोगनुत् ।\nनीलोत्पलस्य किञ्जल्कं गोशकृद्रससंयुतं ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002240073, "chapter_id": 22240, "verse_number": "२८५-७४", "content_sanskrit": "गुटिकाञ्जनमेतत् स्यात् दिनरात्र्यन्धयोर्हितं ।\nयष्टिमधुवचाकृष्णावीजानं गुटजस्य च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002240074, "chapter_id": 22240, "verse_number": "२८५-७५", "content_sanskrit": "कल्केनालोड्य निम्बस्य कषायो वमनायसः ।\nस्निग्धस्विन्नयवन्तोयं प्रदातव्यं विरेचनम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002240075, "chapter_id": 22240, "verse_number": "२८५-७६", "content_sanskrit": "अन्य्था योजितं कुर्य्यात् मन्दाग्निं गौरवारुचिं ।\nपथ्यासैन्धवकृष्णानां चूर्णमुष्णाम्बुना पिवेत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002240076, "chapter_id": 22240, "verse_number": "२८५-७७", "content_sanskrit": "विरेकः सर्व्वरोगघनः श्रेष्ठो नाराचसंज्ञकः ।\nसिद्धयोगा मुनिभ्यो ये आत्रेयेण प्रदर्शिताः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002240077, "chapter_id": 22240, "verse_number": "२८५-७८", "content_sanskrit": "सर्वरोगहराः सर्वयोगाग्र्याः सुश्रुतेन हि ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]