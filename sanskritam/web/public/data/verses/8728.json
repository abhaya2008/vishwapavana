[{"id": 900009128, "chapter_id": 8728, "verse_number": "18.1", "content_sanskrit": "यत्तूक्तं मणावस्माच्छब्दादयमर्थो बोद्धव्य इतीच्छारूपः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009129, "chapter_id": 8728, "verse_number": "18.2", "content_sanskrit": "न चास्माच्छब्दादयं साक्षात्प्रत्येत्वितीच्छा शक्तिः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}]