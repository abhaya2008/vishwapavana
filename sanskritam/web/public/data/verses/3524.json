[{"id": 2117245, "chapter_id": 3524, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117246, "chapter_id": 3524, "verse_number": "१", "content_sanskrit": "दुर्योधन तव प्रज्ञा न सम्यगिति मे मतिः ।\nन ह्युपायेन शक्यास्ते पाण्डवाः कुरुनन्दन \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117247, "chapter_id": 3524, "verse_number": "२", "content_sanskrit": "पूर्वमेव तु ते सर्वैरुपायैर्यतितास्त्वया ।\nनिगृहीतुं त्वया वीराः शकिता न तु भारत \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117248, "chapter_id": 3524, "verse_number": "३", "content_sanskrit": "इहैव वर्तमानास्ते समीपे तव पार्थिव ।\nअजातपक्षाः शिशवो न शक्यास्तव बाधितुम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117249, "chapter_id": 3524, "verse_number": "४", "content_sanskrit": "जातपक्षा विदेशस्था विवृद्धाः सर्व एव ते ।\nनोपायसाध्याः कौन्तेया ममैषा मतिरच्युत्ता \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117250, "chapter_id": 3524, "verse_number": "५", "content_sanskrit": "न च ते व्यसनैः शक्या योक्तुं दृष्टगुणा हि ते ।\nशक्ताः खल्वीप्सवश्चैव पितृपैतामहं पदम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117251, "chapter_id": 3524, "verse_number": "६", "content_sanskrit": "परस्परेभ्यो भेदश्च नाधातुं तत्र शक्यते ।\nएकस्यां हि तथा पत्न्यां न भिद्यन्ते कथञ्चन \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117252, "chapter_id": 3524, "verse_number": "७", "content_sanskrit": "न चापि कृष्णा शक्येत तेभ्यो भेदयितुं परैः ।\nपरिन्यूनान् वृतवती किमुताद्य प्रजावृतः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117253, "chapter_id": 3524, "verse_number": "८", "content_sanskrit": "ईप्सितश्च गुणः स्त्रीणामेकस्या बहुभर्तृता ।\nतं च प्राप्तवती कृष्णा सा न भेदयितुं क्षमा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117254, "chapter_id": 3524, "verse_number": "९", "content_sanskrit": "आर्यवृत्तश्च पाञ्चाल्यः स च राजा दृढव्रतः ।\nन सन्त्यक्ष्यति कौन्तेयान् राज्यदानैरपि ध्रुवम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117255, "chapter_id": 3524, "verse_number": "१०", "content_sanskrit": "तथाऽस्य पुत्रो गुणवाननुरक्तश्च पाण्डवान् ।\nतस्मान्नोपायसाध्यांस्तानहं मन्ये कथञ्चन \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117256, "chapter_id": 3524, "verse_number": "११", "content_sanskrit": "इदमद्य क्षमं कर्तुमस्माकं भरतर्षभ ।\nयावन्न कृतमूलाश्च पाण्डवेया विशाम्पते \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117257, "chapter_id": 3524, "verse_number": "१२", "content_sanskrit": "तावत् प्रहरणीयास्ते रोचतां तत्र विक्रमः ।\nअस्मत्पक्षो महानद्य यावत् पाञ्चालको लघुः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117258, "chapter_id": 3524, "verse_number": "१३", "content_sanskrit": "तावत् प्रहरणं तेषां क्रियतामिति रोचये ।\nबाहनानि प्रभूतानि मित्राणि बहुळानि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117259, "chapter_id": 3524, "verse_number": "१४", "content_sanskrit": "यावन्न तेषां गान्धारे तावदेवाशु विक्रम ।\nयावच्च राजा पाञ्चाल्यो नोद्यमे कुरुते मनः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117260, "chapter_id": 3524, "verse_number": "१५", "content_sanskrit": "कुन्तीपुत्रैर्महावीर्यैस्तावदेवाशु विक्रम ।\nसदा च वैरी द्रुपदः सततं निकृतस्त्वया \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117261, "chapter_id": 3524, "verse_number": "१६", "content_sanskrit": "यावन्न बाधते मित्रै रोचतां तत्र विक्रमः ।\nयावन्नायाति वार्ष्णेयः कर्षन् यादववाहिनीम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117262, "chapter_id": 3524, "verse_number": "१७", "content_sanskrit": "राज्यार्थे पाण्डवेयानां तावादेवाशु विक्रम ।\nवसूनि विविधान् भोगान् राज्यमेव च केवलम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117263, "chapter_id": 3524, "verse_number": "१८", "content_sanskrit": "नासाध्यमस्ति कृष्णस्य पाण्डवार्थे महीपते ।\nविक्रमेण मही प्राप्ता भरतेन महात्मना \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117264, "chapter_id": 3524, "verse_number": "१९", "content_sanskrit": "विक्रमेणैव लोकांस्त्रीन् प्राप्तवान् पाकशासनः ।\nविक्रमं च प्रशंसन्ति क्षत्रियस्य विशाम्पते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117265, "chapter_id": 3524, "verse_number": "२०", "content_sanskrit": "स्वको हि धर्मः शूराणां विक्रमः पार्थिवर्षभ ।\nते बलेन वयं राजन् महता चतुरङ्गिणा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117266, "chapter_id": 3524, "verse_number": "२१", "content_sanskrit": "प्रमथ्य द्रुपदं शीघ्रमानयामेह पाण्डवान् ।\nन हि साम्ना न भेदेन नच दानेन पाण्डवाः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117267, "chapter_id": 3524, "verse_number": "२२", "content_sanskrit": "शक्याः साधयितुं तस्माद् विक्रमेणैव तान् जहि ।\nविक्रमेणैव जित्वेमामखिलां भुङ्क्ष्व मेदिनीम् ।\nनान्यमत्र प्रपश्यामि कार्योपायं जनाधिप \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117268, "chapter_id": 3524, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117269, "chapter_id": 3524, "verse_number": "२३", "content_sanskrit": "श्रुत्वा स राधेयवचो धृतराष्ट्रः प्रतापवान् ।\nअभिपूज्य ततः पश्चादिदं वचनमब्रवीत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117270, "chapter_id": 3524, "verse_number": "२४", "content_sanskrit": "उपपन्नं महाप्राज्ञे कृतास्त्रे सूतनन्दने ।\nत्वयि विक्रमसम्पन्नमिदं वचनमीदृशम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117271, "chapter_id": 3524, "verse_number": "२५", "content_sanskrit": "भूय एव तु भीष्मश्च द्रोणो विदुर एव च ।\nयुवां च कुरुतां बुद्धिं भवेद् यावत् सुखोदयः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117272, "chapter_id": 3524, "verse_number": "४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्र्यधिकद्विशततमोऽध्यायः ॥२०३॥ इति विदुरागमनपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117273, "chapter_id": 3524, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]