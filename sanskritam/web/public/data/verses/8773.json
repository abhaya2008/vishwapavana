[{"id": 900010074, "chapter_id": 8773, "verse_number": "1.1", "content_sanskrit": "अनन्तगुणसम्पूर्ण सर्वदोषविवर्जितम् । मूलरामं सदा वन्दे चतुरानन पूजितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900010075, "chapter_id": 8773, "verse_number": "1.2", "content_sanskrit": "अत्र निर्दोष- ग्रहणेन पारतन्त्र्यराहित्यादीनि अनन्तानि लक्षणानि सूचितानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900010076, "chapter_id": 8773, "verse_number": "1.3", "content_sanskrit": "पारतन्त्र्यस्य प्रसिद्धसाधारणदोषस्य ग्रहणेन दोषतया प्रामाणिकत्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900010077, "chapter_id": 8773, "verse_number": "1.4", "content_sanskrit": "विस्पष्टवचनाभाववचनं प्रौढिमात्रतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900010078, "chapter_id": 8773, "verse_number": "1.5", "content_sanskrit": "तदेवमादिषु विस्पष्टतया निरवकाशतया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900010079, "chapter_id": 8773, "verse_number": "1.6", "content_sanskrit": "न च प्रामाणिकप्रतियोगिकात्यन्ताभावे किमपि प्रमाणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900010080, "chapter_id": 8773, "verse_number": "1.7", "content_sanskrit": "न च प्रामाणिकप्रतियोगिकात्यन्ताभावे किमपि प्रमाणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900010081, "chapter_id": 8773, "verse_number": "1.8", "content_sanskrit": "अथ घटत्वं पटनिष्ठात्यन्ताभावप्रतियोगि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900010082, "chapter_id": 8773, "verse_number": "1.9", "content_sanskrit": "अज्ञता चाल्पशक्तित्वं दुःखित्वं स्वल्पकर्तृता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900010083, "chapter_id": 8773, "verse_number": "1.10", "content_sanskrit": "न ते महित्वमन्वश्नुवन्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900010084, "chapter_id": 8773, "verse_number": "1.11", "content_sanskrit": "अत्यन्ताभावस्य नित्यत्वात्कालभेदेन विरोधपरिहारासंभवेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900010085, "chapter_id": 8773, "verse_number": "1.12", "content_sanskrit": "उदाहृतं सौधम् निर्वचनं पररीत्यैव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900010086, "chapter_id": 8773, "verse_number": "1.13", "content_sanskrit": "यदत्र अभिहितम् अयुक्तं चेदं लक्षणम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900010087, "chapter_id": 8773, "verse_number": "1.14", "content_sanskrit": "यच्चोक्तम् 'अभावप्रतीतावनाहार्यारोपस्य कारणत्वे देवानां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900010088, "chapter_id": 8773, "verse_number": "1.15", "content_sanskrit": "ननु चास्याभावस्य दोषारोपपूर्वकप्रतीत्यनुपहिता स्वाभाविकी..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900010089, "chapter_id": 8773, "verse_number": "1.16", "content_sanskrit": "यदत्रोक्तं 'न चाभावबुद्धेरभावाधिकरणे प्रतियोगिप्रतीति-सापेक्षत्वाभावे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900010090, "chapter_id": 8773, "verse_number": "1.17", "content_sanskrit": "यदप्युक्तं 'अनुभूयमानारोपस्थले प्रामाणिकस्याप्यारोपोपगमेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900010091, "chapter_id": 8773, "verse_number": "1.18", "content_sanskrit": "यत्कारुण्यैकबलतो लब्धात्मेयं कृतिर्मम श्रीशे समर्पयन्त्वेनां सत्याभिज्ञगुरूत्तमाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]