[{"id": 7003916000, "chapter_id": 23916, "verse_number": "२-९-११-१", "content_sanskrit": "स्कन्द उवाच ।\nब्रह्मरुद्रौ महेन्द्रादीन्संधानायाऽसुरैः सह ।\nआज्ञाप्य जग्मतुः स्वंस्वं धाम देवा रसां मुने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003916001, "chapter_id": 23916, "verse_number": "२-९-११-२", "content_sanskrit": "समयोचितभाषाविद्वासवो नीतियुक्तिभिः ।\nप्रलोभ्य फलभागेन सन्धिं चक्रेऽसुरैः सह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003916002, "chapter_id": 23916, "verse_number": "२-९-११-३", "content_sanskrit": "ततो देवासुरगणा मिलिता वारिधेस्तटे ।\nमहौषधीरुपानीय बहुशो निदधुर्द्रुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003916003, "chapter_id": 23916, "verse_number": "२-९-११-४", "content_sanskrit": "मन्दराद्रिमुपेत्याऽथ नानौषधिविराजितम् ।\nमूलादुत्पाट्य ते सर्वे नेतुमब्धिं समुद्यताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003916004, "chapter_id": 23916, "verse_number": "२-९-११-५", "content_sanskrit": "एकादशसहस्राणि योजनानां भुवि स्थितम् ।\nनोद्धर्तुमशकंस्ते तं तदानीं तुष्टुवुर्हरिम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003916005, "chapter_id": 23916, "verse_number": "२-९-११-६", "content_sanskrit": "एतद्विदित्वा भगवान्संकर्षणमहीश्वरम् ।\nअजिज्ञपत्तमुद्धर्तुं बद्धमूलं महीधरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003916006, "chapter_id": 23916, "verse_number": "२-९-११-७", "content_sanskrit": "फूत्कारमात्रेणैकेन स तु सद्यस्तमीश्वरः ।\nबहिश्चिक्षेप तत्स्थानाद्योजनद्वितयान्तरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003916007, "chapter_id": 23916, "verse_number": "२-९-११-८", "content_sanskrit": "अत्याश्चर्यं तदालोक्य हृष्टाः सर्वे सुरासुराः ।\nतदन्तिकमुपाजग्मुर्द्धावन्तश्च कृतारवाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003916008, "chapter_id": 23916, "verse_number": "२-९-११-९", "content_sanskrit": "बलिनो यत्नवन्तोपि परिघोपमबाहवः ।\nउद्धृत्य नेतुं नो शेकुर्विषण्णा विफलश्रमाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003916009, "chapter_id": 23916, "verse_number": "२-९-११-१०", "content_sanskrit": "ज्ञात्वा सुरगणान्खिन्नान्भगवान्सर्वदर्शनः ।\nतार्क्ष्यमाज्ञापयामास नेतुं तमुदधिं द्रुतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003916010, "chapter_id": 23916, "verse_number": "२-९-११-११", "content_sanskrit": "सहावरणमप्यण्डं लीलया धर्त्तुमीश्वरः ।\nमनोवेगः स तत्रेत्य निजत्रोट्यैव तं गिरिम् ।\nउत्पाट्य सागरतटे निधाय हरिमाययौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003916011, "chapter_id": 23916, "verse_number": "२-९-११-१२", "content_sanskrit": "ततः संहृष्टमनसः सर्वे कश्यपनन्दनाः ।\nवासुकिं चाह्वयामासुः सुधाभागप्रतिज्ञया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003916012, "chapter_id": 23916, "verse_number": "२-९-११-१३", "content_sanskrit": "स तत्रागादथो सर्वे तेऽब्धिं मन्थितुमुद्यताः ।\nतानपान्निधिरागत्य मूर्त्तिमानब्रवीद्वचः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003916013, "chapter_id": 23916, "verse_number": "२-९-११-१४", "content_sanskrit": "यदि दास्यथ मे यूयममृतांशं सुरासुराः ।\nसोढास्मि विपुलं तर्हि मन्दरभ्रमणार्द्दनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003916014, "chapter_id": 23916, "verse_number": "२-९-११-१५", "content_sanskrit": "तथेति ते प्रतिज्ञाय क्षिप्त्वादावोषधीलताः ।\nपरिविव्युर्न्नागराजं तस्मिन्काञ्चनपर्वते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003916015, "chapter_id": 23916, "verse_number": "२-९-११-१६", "content_sanskrit": "ततो देवा हृदि हरिं सस्मरुः कार्यसिद्धये ।\nस्मृतमात्रः स तत्राऽगादच्युतः सर्वदर्शनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003916016, "chapter_id": 23916, "verse_number": "२-९-११-१७", "content_sanskrit": "तमालोक्यामरगणा मुदिताः फणिनां पतेः ।\nपुरोभागं गृहीत्वैव तस्थुस्तेनानुमोदिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003916017, "chapter_id": 23916, "verse_number": "२-९-११-१८", "content_sanskrit": "देवतापक्षपातित्वं सूचयन्स्वस्य च प्रभुः ।\nयत्र देवास्तत्र तस्थौ ततो दैत्यास्तु चुक्रुधुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003916018, "chapter_id": 23916, "verse_number": "२-९-११-१९", "content_sanskrit": "तपोविद्यावयोज्येष्ठा अधोभागममङ्गलम् ।\nकथं तिरश्चो गृह्णीमो नेदृङ्मूर्खा वयं त्विति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003916019, "chapter_id": 23916, "verse_number": "२-९-११-२०", "content_sanskrit": "सह देवैस्ततो विष्णुः स्वयं तान्मानयन्निव ।\nप्रहस्य दत्त्वा प्राग्भागं सुरान्पुच्छमजिग्रहत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003916020, "chapter_id": 23916, "verse_number": "२-९-११-२१", "content_sanskrit": "महाहिविषफूत्कारदाहादमररक्षणम् ।\nचरित्रमेतच्छ्रीभर्तुरिति दैत्या न ते विदुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003916021, "chapter_id": 23916, "verse_number": "२-९-११-२२", "content_sanskrit": "तत उत्तोलयामासुः स्वर्णसान्वालिभास्वरम् ।\nमन्दरं काश्यपेयास्ते चर्मिकाबद्धकच्छकाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003916022, "chapter_id": 23916, "verse_number": "२-९-११-२३", "content_sanskrit": "द्वाविंशतिसहस्राणि योजनानां तमुच्छ्रितम् ।\nअम्भोनिधौ निदधिरे क्रोशन्तोत्यर्थमुत्सुकाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003916023, "chapter_id": 23916, "verse_number": "२-९-११-२४", "content_sanskrit": "धार्यमाणोप्यनाधारस्तैरद्रिरतिगौरवात् ।\nययावधस्तलं सद्यस्तदासंस्तेऽतिविह्वलाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003916024, "chapter_id": 23916, "verse_number": "२-९-११-२५", "content_sanskrit": "तदा स भगवान्साक्षात्सर्वथा भक्तकार्यकृत् ।\nस्तूयमानोमरैरद्रिमुद्दघ्रे कमठाकृतिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003916025, "chapter_id": 23916, "verse_number": "२-९-११-२६", "content_sanskrit": "उत्थितं तमवेक्ष्याशु सर्वे फुल्लहृदाननाः ।\nबभूवुश्च स्थिरः सोऽभूत्कूर्मपृष्ठेतिविस्तृते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003916026, "chapter_id": 23916, "verse_number": "२-९-११-२७", "content_sanskrit": "ततो ममन्थुस्तरसा यावद्बलमपांनिधिम् ।\nश्रमफूत्कारवदना देवादयोऽदयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003916027, "chapter_id": 23916, "verse_number": "२-९-११-२८", "content_sanskrit": "भ्राम्यमाणात्ततस्त्वद्रेर्बहवोन्यपतन्दुमाः ।\nऊर्द्ध्वद्रुघर्षजो वह्निस्तत्स्थ सिंहादिमादहत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003916028, "chapter_id": 23916, "verse_number": "२-९-११-२९", "content_sanskrit": "तत्र नाना जलचरा विनिपिष्टा महाद्रिणा ।\nविलयं समुपाजग्मुः शतशः क्षीरवारिधौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003916029, "chapter_id": 23916, "verse_number": "२-९-११-३०", "content_sanskrit": "सांवर्त्तकमहामेघसङ्घगर्ज्जितवन्महान् ।\nआसीन्मंथननादश्च प्रतिध्वनिविवर्द्धितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003916030, "chapter_id": 23916, "verse_number": "२-९-११-३१", "content_sanskrit": "अत्याकर्षणखिन्नाङ्गवासुकर्म्मुखकृत्कृतैः ।\nहतौजसोऽतिखिन्नाश्च दैत्या निङ्गालवद्बभुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003916031, "chapter_id": 23916, "verse_number": "२-९-११-३२", "content_sanskrit": "अविषह्यं विषाग्निं च मर्षन्ति बहुधा मुहुः ।\nलम्बन्ते स्माहिराजस्य सहस्रं वदनान्यधः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003916032, "chapter_id": 23916, "verse_number": "२-९-११-३३", "content_sanskrit": "दधार सहसा तानि भगवन्प्रेरितो विभुः ।\nसंकर्षणो महातेजाः सहमानो विषानलम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003916033, "chapter_id": 23916, "verse_number": "२-९-११-३४", "content_sanskrit": "सहस्रमेकं वर्षाणां मथ्यमानात्पयोनिधेः ।\nहालाहलं विषमभूदुत्सर्पद्विदिशो दिशः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003916034, "chapter_id": 23916, "verse_number": "२-९-११-३५", "content_sanskrit": "यदाहुः कालकूटाख्यं सर्वलोकातिदाहकम् ।\nतेन दन्दह्यमानाङ्गास्ते तु चक्रुः पलायनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003916035, "chapter_id": 23916, "verse_number": "२-९-११-३६", "content_sanskrit": "ततो ब्रह्मा प्रजेशाश्च देवाः सर्वेप्युमापतिम् ।\nप्रार्थयंस्तस्य पानार्थं स्तुवन्तः स्तुतिभिर्मुने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003916036, "chapter_id": 23916, "verse_number": "२-९-११-३७", "content_sanskrit": "भगवानथ तं प्राह सुराणामग्रजो भवान् ।\nभवतीत्यग्रजं वार्द्धेर्गृहाणेदं विषं शिव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003916037, "chapter_id": 23916, "verse_number": "२-९-११-३८", "content_sanskrit": "देवानां स भयं दृष्ट्वा करुणश्चाज्ञया हरेः ।\nआकर्षद्योगकलया विषं पाणितलेऽखिलम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003916038, "chapter_id": 23916, "verse_number": "२-९-११-३९", "content_sanskrit": "पपौ तत्कण्ठमध्ये च शोषयामास तत्क्षणम् ।\nनीलकण्ठ इति ख्यातः शंकराख्यश्च पऽभवत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003916039, "chapter_id": 23916, "verse_number": "२-९-११-४०", "content_sanskrit": "पास्यतस्तस्य पाणेर्ये पतिता भुविबिन्दवः ।\nतान्नागा वृश्चिकाद्याश्च जगृहुः काश्चनौषधीः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003916040, "chapter_id": 23916, "verse_number": "२-९-११-४१", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे श्रीवासुदेवमाहात्म्येऽमृतमन्थने विषोत्पत्तिर्नामैकादशोऽध्यायः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]