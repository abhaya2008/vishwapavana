[{"id": 2072872, "chapter_id": 2541, "verse_number": "१२-४६-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072873, "chapter_id": 2541, "verse_number": "१२-४६-१", "content_sanskrit": "शरतल्पे शयानस्तु भरतानां पितामहः।\nकथमुत्सृष्टवान्देहं कं च योगमधारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072874, "chapter_id": 2541, "verse_number": "१२-४६-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072875, "chapter_id": 2541, "verse_number": "१२-४६-२", "content_sanskrit": "शृणुष्वावहितो राजञ्शुचिर्भूत्वा समाहितः।\nभीष्मस्य कुरुशार्दूल देहोत्सर्गं महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072876, "chapter_id": 2541, "verse_number": "१२-४६-३", "content_sanskrit": "प्रवृत्तमात्रे त्वयनमुत्तरेण दिवाकरे।\n`शुक्लपक्षस्य चाष्टभ्यां माघमासस्य पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072877, "chapter_id": 2541, "verse_number": "१२-४६-४", "content_sanskrit": "प्राजापत्ये च नक्षत्रे मध्यं प्राप्ते दिवाकरे।\nसमावेशयदात्मानमात्मत्येव समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072878, "chapter_id": 2541, "verse_number": "१२-४६-५", "content_sanskrit": "विकीर्णांशुरिवादित्यो भीष्मः शरशतैश्चितः।\nशुशुभे परया लक्ष्म्या वृतो ब्राह्मणसत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072879, "chapter_id": 2541, "verse_number": "१२-४६-६", "content_sanskrit": "व्यासेन देवश्रवसा नारदेन सुरर्षिणा।\nदेवस्थानेन वात्स्येन तथाऽश्मकसुमन्तुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072880, "chapter_id": 2541, "verse_number": "१२-४६-७", "content_sanskrit": "तथा जैमिनिना चैव पैलेन च महात्मना।\nशाण्डिल्यदेवलाभ्यां च मैत्रेयेण च धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072881, "chapter_id": 2541, "verse_number": "१२-४६-८", "content_sanskrit": "असितेन वसिष्ठेन कौशिकेन महात्मना।\nहारितलोमशाभ्यां च तथाऽऽत्रेयेण धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072882, "chapter_id": 2541, "verse_number": "१२-४६-९", "content_sanskrit": "[बृहस्पतिश्च शुक्रश्च च्यवनश्च महामुनिः।\nसनत्कुमारः कपिलो चाल्मीकिस्तुम्बुरुः कुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072883, "chapter_id": 2541, "verse_number": "१२-४६-१०", "content_sanskrit": "मौद्गल्यो भार्गवो रामस्तृणबिन्दुर्महामुनिः।\nपिप्पलादोऽथ वायुश्च सवर्तः पुलहः कचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072884, "chapter_id": 2541, "verse_number": "१२-४६-११", "content_sanskrit": "काश्यपश्च पुलस्त्यश्च क्रतुर्दक्षः पराशरः।\nमरीचिरङ्गिराः काश्यो गौतमो गालवो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072885, "chapter_id": 2541, "verse_number": "१२-४६-१२", "content_sanskrit": "धौम्यो विभाण्डो माण्डव्योधौम्रः कृष्णानुभौतिकः।\nउलूकः परमो विप्रो मार्कण्डेयो महामुनिः।\nभास्करिः पूरणः कृष्णः सूतः परमधार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072886, "chapter_id": 2541, "verse_number": "१२-४६-१३", "content_sanskrit": "एतैश्चान्यैर्मुनिगणैर्महाभागैर्महात्मभिः।\nश्रद्धादमशमोपेतैर्वृतश्चन्द्र इव ग्रहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072887, "chapter_id": 2541, "verse_number": "१२-४६-१४", "content_sanskrit": "भीष्मस्तु पुरुषव्याघ्रः कर्मणा मनसा गिरा।\nशरतल्पगतः कृष्णं प्रदध्यौ प्राञ्जलिः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072888, "chapter_id": 2541, "verse_number": "१२-४६-१५", "content_sanskrit": "स्वरेण हृष्टपुष्टेन तुष्टाव मधुसूदनम्।\nयोगेश्वरं पझनाभं विष्णुं जिष्णुं जगत्पतिम्।\n`अनादिनिधनं विष्णुमात्मयोनिं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072889, "chapter_id": 2541, "verse_number": "१२-४६-१६", "content_sanskrit": "कृताञ्जलिपुटो भूत्वा वाग्विदां प्रवरः प्रभुः॥\nभीष्मः परमधर्मात्मा वासुदेवमथास्तुवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072890, "chapter_id": 2541, "verse_number": "१२-४६-१७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072891, "chapter_id": 2541, "verse_number": "१२-४६-१७", "content_sanskrit": "आरिराधयिषुः कृष्णं वाचं जिगदिषामि याम्।\nतया व्याससमासिन्या प्रीयतां पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072892, "chapter_id": 2541, "verse_number": "१२-४६-१८", "content_sanskrit": "शुचिं शुचिपदं हंसं तत्परं परमेष्ठिनम्।\nयुक्त्वा सर्वात्मनाऽऽत्मानं तं प्रपद्ये प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072893, "chapter_id": 2541, "verse_number": "१२-४६-१९", "content_sanskrit": "अनाद्यन्तं परं ब्रह्म न देवा नर्षयो विदुः।\nएकोऽयं वेद भगवान्धाता नारायणो हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072894, "chapter_id": 2541, "verse_number": "१२-४६-२०", "content_sanskrit": "नारायणादृषिगणास्तथा सिद्धमहोरगाः।\nदेवा देवर्षयश्चैव यं विदुर्दुःखभेषजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072895, "chapter_id": 2541, "verse_number": "१२-४६-२१", "content_sanskrit": "देवदानवगन्धर्वा यक्षराक्षसपन्नगाः।\nयं न जानन्ति को ह्येष कुतो वा भगवानिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072896, "chapter_id": 2541, "verse_number": "१२-४६-२२", "content_sanskrit": "`यमाहुर्जगतः कोशं यस्मिंश्च निहिताः प्रजाः।\nयस्मिँल्लोकाः स्फुरन्त्येते जाले शकुनयो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072897, "chapter_id": 2541, "verse_number": "१२-४६-२३", "content_sanskrit": "यस्मिन्विश्वानि भूतानि तिष्ठन्ति च विशन्ति च।\nगुणभूतानि भूतेशे सूत्रे मणिगणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072898, "chapter_id": 2541, "verse_number": "१२-४६-२४", "content_sanskrit": "`यं च विश्वस्य कर्तारं जगतस्तस्थुषां पतिम्\nवदन्ति जगतोऽध्यक्षमध्यात्मपरिचिन्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072899, "chapter_id": 2541, "verse_number": "१२-४६-२५", "content_sanskrit": "यस्मिन्नित्ये तते तन्तौ दृढे स्रगिव तिष्ठति।\nसदसद्ग्रथितं विश्वं विश्वाङ्गे विश्वकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072900, "chapter_id": 2541, "verse_number": "१२-४६-२६", "content_sanskrit": "हरिं सहस्रशिरसं सहस्रचरणेक्षणम्।\nसहस्रबाहुमकुटं सहस्रवदनोज्ज्वलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072901, "chapter_id": 2541, "verse_number": "१२-४६-२७", "content_sanskrit": "प्राहुर्नारायणं देवं यं विश्वस्य परायणम्।\nअणीयसामणीयांसं स्थविष्ठं च स्थवीयसाम्।\nगरीयसां गरिष्ठं च श्रेष्ठं च श्रेयसामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072902, "chapter_id": 2541, "verse_number": "१२-४६-२८", "content_sanskrit": "चं वाकेष्वनुवाकेषु निषत्सूपनिषत्सु च।\nगृणन्ति सत्यकर्माणं सत्यं सत्येषु सामसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072903, "chapter_id": 2541, "verse_number": "१२-४६-२९", "content_sanskrit": "चतुर्भिश्चतुरात्मानं सत्वस्थं सात्वतां पतिम्।\nयं दिव्यैर्देवमर्चन्ति गुह्यैः परमनामभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072904, "chapter_id": 2541, "verse_number": "१२-४६-३०", "content_sanskrit": "[यस्मिन्नित्यं तपस्तप्तं यदङ्गेष्वनुतिष्ठति।\nसर्वात्मा सर्ववित्सर्वः सर्वज्ञः सर्वभावनः॥ ]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072905, "chapter_id": 2541, "verse_number": "१२-४६-३१", "content_sanskrit": "यं देवं देवकी देवी वसुदेवादजीजनत्।\nभौमस्य ब्रह्मणो गुप्त्यै दीप्तमग्निमिवारणिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072906, "chapter_id": 2541, "verse_number": "१२-४६-३२", "content_sanskrit": "यमनन्यो व्यपेताशीरात्मानं वीतकल्मषम्।\nइष्ट्वानन्त्याय गोविन्दं पश्यत्यात्मानमात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072907, "chapter_id": 2541, "verse_number": "१२-४६-३३", "content_sanskrit": "`अप्रतर्क्यमविज्ञेयं हरिं नारायणं विभुम्।\nअतिवाय्विन्द्रकर्माणमतिसूर्याग्नितेजसम्।\nअतिबुद्धीन्द्रियात्मानं तं प्रपद्ये प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072908, "chapter_id": 2541, "verse_number": "१२-४६-३४", "content_sanskrit": "पुराणे पुरुषं प्रोक्तं ब्रह्मप्रोक्तं युगादिषु।\nक्षये संकर्षणं प्रोक्तं तमुपास्यमुपास्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072909, "chapter_id": 2541, "verse_number": "१२-४६-३५", "content_sanskrit": "यमेकं बहुधात्मानं प्रादुर्भूतमधोक्षजम्।\nनान्यभक्ताः क्रियावन्तो यजन्ते सर्वकामदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072910, "chapter_id": 2541, "verse_number": "१२-४६-३६", "content_sanskrit": "ऋतमेकाक्षरं ब्रह्म यत्तत्सदसतः परम्।\nअनादिमध्यपर्यन्तं न देवा नर्षयो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072911, "chapter_id": 2541, "verse_number": "१२-४६-३७", "content_sanskrit": "यं सुरासुरगन्धर्वाः सिद्धा ऋषिमहोरगाः।\nप्रयता नित्यमर्चन्ति परमं सुखभेषजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072912, "chapter_id": 2541, "verse_number": "१२-४६-३८", "content_sanskrit": "अनादिनिधनं देवमात्मयोनिं सनातनम्।\nअप्रेक्ष्यमनभिज्ञेयं हरिं नारायणं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072913, "chapter_id": 2541, "verse_number": "१२-४६-३९x", "content_sanskrit": "अथ भीष्मस्तवराजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072914, "chapter_id": 2541, "verse_number": "१२-४६-३९", "content_sanskrit": "हिरण्यवर्णं यं गर्भमदितिर्दैत्यनाशनम्।\nएकं द्वादशधा जज्ञे तस्मै सूर्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2072915, "chapter_id": 2541, "verse_number": "१२-४६-४०", "content_sanskrit": "शुक्ले देवान्पितॄन्कृष्णे तर्पयत्यमृतेन यः।\nयश्च राजा द्विजातीनां तस्मै सोमात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2072916, "chapter_id": 2541, "verse_number": "१२-४६-४१", "content_sanskrit": "`हुताशनमुखैर्देवैर्धार्यते सकलं जगत्।\nहविः प्रथमभोक्ता यस्तस्मै होत्रात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2072917, "chapter_id": 2541, "verse_number": "१२-४६-४२", "content_sanskrit": "महतस्तमसः पारे पुरुषं ह्यतितेजसम्।\nयं ज्ञात्वा मृत्युमत्येति तस्मै ज्ञेयात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2072918, "chapter_id": 2541, "verse_number": "१२-४६-४३", "content_sanskrit": "यं बृहन्तं बृहत्युक्थे यमग्नौ यं महाध्वरे।\nयं विप्रसङ्घा गायन्ति तस्मै वेदात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2072919, "chapter_id": 2541, "verse_number": "१२-४६-४४", "content_sanskrit": "पादाङ्गं संधिपर्वाणं स्वरव्यञ्जनभूषितम्।\nयमाहुरक्षरं विप्रास्तस्मै वागात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2072920, "chapter_id": 2541, "verse_number": "१२-४६-४५", "content_sanskrit": "[यज्ञाङ्गो यो वराहो वै भूत्वा गामुज्जहारह।\nलोकत्रयहितार्थाय तस्मै वीर्यात्मने नमः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2072921, "chapter_id": 2541, "verse_number": "१२-४६-४६", "content_sanskrit": "ऋग्यजुःसामधामानं दशार्धहविराकृतिम्।\nयं सप्ततन्तुं तन्वन्ति तस्मै यज्ञात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2072922, "chapter_id": 2541, "verse_number": "१२-४६-४७", "content_sanskrit": "[चतुर्भिश्च चतुर्भिश्च द्वाभ्यां पञ्चभिरेव च।\nहूयते च पुनर्द्वाभ्यां तस्मै होमात्मने नमः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2072923, "chapter_id": 2541, "verse_number": "१२-४६-४८", "content_sanskrit": "यः सुपर्णो यजुर्नाम च्छन्दोगात्रस्त्रिवृच्छिराः।\nरथन्तरबृहत्पक्षस्तस्मै स्तोत्रात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2072924, "chapter_id": 2541, "verse_number": "१२-४६-४९", "content_sanskrit": "यः सहस्रसवे सत्रे जज्ञे विश्वसृजामृषिः।\nहिरण्यपक्षः शकुनिस्तस्मै तार्क्ष्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2072925, "chapter_id": 2541, "verse_number": "१२-४६-५०", "content_sanskrit": "यश्चिनोति सतां सेतुमृतेनामृतयोनिना।\nधर्मार्थव्यवहाराङ्गैस्तस्मै सत्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2072926, "chapter_id": 2541, "verse_number": "१२-४६-५१", "content_sanskrit": "यं पृथग्धर्मचरणाः पृथग्धर्मफलैषिणः।\nपृथग्धर्मैः समर्चन्ति तस्मै धर्मात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2072927, "chapter_id": 2541, "verse_number": "१२-४६-५२", "content_sanskrit": "[यतः सर्वे प्रसूयन्ते ह्यनङ्गात्माङ्गदेहिनः।\nउन्मादः सर्वभूतानां तस्मै कामात्मने नमः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2072928, "chapter_id": 2541, "verse_number": "१२-४६-५३", "content_sanskrit": "यं तं व्यक्तस्थमव्यक्तं विचिन्वन्ति महर्षयः।\nक्षेत्रे क्षेत्रज्ञमासीनं तस्मै क्षेत्रात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2072929, "chapter_id": 2541, "verse_number": "१२-४६-५४", "content_sanskrit": "यं दृगात्मानमात्मस्थं वृतं षोडशभिर्गुणैः।\nप्राहुः सप्तदशंसाङ्ख्यास्तस्मै साङ्ख्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2072930, "chapter_id": 2541, "verse_number": "१२-४६-५५", "content_sanskrit": "यं विनिद्रा जितश्वासाः संतुष्टाः संयतेन्द्रियाः।\nज्योतिः पश्यन्ति युञ्जानास्तस्मै योगात्मेन नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2072931, "chapter_id": 2541, "verse_number": "१२-४६-५६", "content_sanskrit": "अपुण्यपुण्योपरमे यं पुनर्भवनिर्भयाः।\nशान्ताः संन्यासिनो यान्ति तस्मै मोक्षात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2072932, "chapter_id": 2541, "verse_number": "१२-४६-५७", "content_sanskrit": "यस्याग्रिरास्यं द्यौर्मूर्धा खं नाभिश्चरणौ क्षितिः।\nसूर्यश्चक्षुर्दिशः श्रोत्रं तस्मै लोकात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2072933, "chapter_id": 2541, "verse_number": "१२-४६-५८", "content_sanskrit": "युगेष्वावर्तते योंऽशैर्मासर्त्वयनहायनैः।\nसर्गप्रलययोः कर्ता तस्मै कालात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2072934, "chapter_id": 2541, "verse_number": "१२-४६-५९", "content_sanskrit": "योऽसौ युगसहस्रान्ते प्रदीप्तार्चिर्विभावसुः।\nसंभक्षयति भूतानि तस्मै घोरात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2072935, "chapter_id": 2541, "verse_number": "१२-४६-६०", "content_sanskrit": "संभक्ष्य सर्वभूतानि कृत्वा चैकार्णवं जगत्।\nबालः स्वपिति यश्चैकस्तस्मै मायात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2072936, "chapter_id": 2541, "verse_number": "१२-४६-६१", "content_sanskrit": "सहस्रशिरसे तस्मै पुरुषायामितात्मने।\nचतुःसमुद्रपयसि योगनिद्रात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2072937, "chapter_id": 2541, "verse_number": "१२-४६-६२", "content_sanskrit": "अजस्य नाभावध्येकं यस्मिन्विश्वं प्रतिष्ठितम्।\nपुष्करं पुष्कराक्षस्य तस्मै पझात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2072938, "chapter_id": 2541, "verse_number": "१२-४६-६३", "content_sanskrit": "यस्य केशेषु जीमूता नद्यः सर्वाङ्गसंधिषु।\nकुक्षौ समुद्राश्चत्वारस्तस्मै तोयात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2072939, "chapter_id": 2541, "verse_number": "१२-४६-६४", "content_sanskrit": "यस्मात्सर्गाः प्रवर्तन्ते सर्गप्रलयविक्रियाः।\nयस्मिंश्चैव प्रलीयन्ते तस्मै हेत्वात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2072940, "chapter_id": 2541, "verse_number": "१२-४६-६५", "content_sanskrit": "[यो निषण्णो भवेद्रात्रौ दिवा भवति विष्ठितः।\nइष्टानिष्टस्य च द्रष्टा तस्मै द्रष्ट्रात्मने नमः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2072941, "chapter_id": 2541, "verse_number": "१२-४६-६६", "content_sanskrit": "अकार्यः सर्वकार्येषु धर्मकार्यार्थमुद्यतः।\nवैकुण्ठस्य हि तद्रूपं तस्मै कार्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2072942, "chapter_id": 2541, "verse_number": "१२-४६-६७", "content_sanskrit": "ब्रह्म वक्तं भुजौ क्षत्रं कृत्स्नमूरूदरं विशः।\nपादौ यस्याश्रिताः शूद्रास्तस्मैवर्णात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2072943, "chapter_id": 2541, "verse_number": "१२-४६-६८", "content_sanskrit": "अन्नपानेन्धनमयो रसप्राणविवर्धनः।\nयो धारयति भूतानि तस्मै प्राणात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2072944, "chapter_id": 2541, "verse_number": "१२-४६-६९", "content_sanskrit": "[प्राणानां धारणार्थाय योऽन्नं भुङ्क्ते चतुर्विधम्।\nअन्तर्भूतः पचत्यग्निस्तस्मै पाकात्मने नमः॥ ]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2072945, "chapter_id": 2541, "verse_number": "१२-४६-७०", "content_sanskrit": "विषये वर्तमानानां यं तं वैषयिकैर्गुणैः।\nप्राहुर्विषयगोप्तारं तस्मै गोप्त्रात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2072946, "chapter_id": 2541, "verse_number": "१२-४६-७१", "content_sanskrit": "अप्रमेयशरीराय सर्वतो बुद्धिचक्षुषे।\nअपारपरिमाणाय तस्मै दिव्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2072947, "chapter_id": 2541, "verse_number": "१२-४६-७२", "content_sanskrit": "परः कालात्परो यज्ञात्परः सदसतश्च यः।\nअनादिरादिर्विश्वस्य तस्मै विश्वात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2072948, "chapter_id": 2541, "verse_number": "१२-४६-७३", "content_sanskrit": "वैद्युतो जाठरश्चैव पावकः शुचिरेव च।\nदहनः सर्वभक्षाणां तस्मै वह्न्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2072949, "chapter_id": 2541, "verse_number": "१२-४६-७४", "content_sanskrit": "रसातलगतः श्रीमार्ननन्तो भगवान्प्रभुः।\nजगद्धारयते योऽसौ तस्मै शेषात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2072950, "chapter_id": 2541, "verse_number": "१२-४६-७५", "content_sanskrit": "ज्वलनार्केन्दुताराणां ज्योतिषां दिव्यमूर्तिनाम्।\nयस्तेजयति तेजांसि तस्मै तेजात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2072951, "chapter_id": 2541, "verse_number": "१२-४६-७६", "content_sanskrit": "आत्मज्ञानमिदं ज्ञानं ज्ञात्वा पञ्चस्ववस्थितम्।\nयं ज्ञानेनाधिगच्छन्ति तस्मै ज्ञानात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2072952, "chapter_id": 2541, "verse_number": "१२-४६-७७", "content_sanskrit": "साङ्ख्यैर्योगैर्विनिश्चित्य साध्यैश्च परमर्षिभिः।\nयस्य तु ज्ञायते तत्वं तस्मै गुह्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2072953, "chapter_id": 2541, "verse_number": "१२-४६-७८", "content_sanskrit": "जटिने दण्डिने नित्यं लम्बोदरशरीरिणे।\nकमण्डलुनिषङ्गाय तस्मै ब्रह्मात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2072954, "chapter_id": 2541, "verse_number": "१२-४६-७९", "content_sanskrit": "[शूलिने त्रिदशेशाय त्र्यम्बकाय महात्मने।\nभस्मदिग्धोर्ध्वलिङ्गाय तस्मा रुद्रात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2072955, "chapter_id": 2541, "verse_number": "१२-४६-८०", "content_sanskrit": "चन्द्रार्धकृतशीर्षाय व्यालयज्ञोपवीतिने।\nपिनाकशूलहस्ताय तस्मै उग्रात्मने नमः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2072956, "chapter_id": 2541, "verse_number": "१२-४६-८१", "content_sanskrit": "यो जातो वसुदेवेन देवक्यां यदुनन्दनः।\nशङ्खचक्रगदापाणिर्वासुदेवात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2072957, "chapter_id": 2541, "verse_number": "१२-४६-८२", "content_sanskrit": "शिरःकपालमालाय व्याघ्रचर्मनिवासिने।\nभस्मदिग्धशरीराय तस्मै रुद्रात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2072958, "chapter_id": 2541, "verse_number": "१२-४६-८३", "content_sanskrit": "यो मोहयति भूतानि सर्वपाशानुबन्धनैः।\nसर्वस्य रक्षणार्थाय तस्मै मोहात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2072959, "chapter_id": 2541, "verse_number": "१२-४६-८४", "content_sanskrit": "चैतन्यं सर्वतो नित्यं सर्वप्राणिहृदि स्थितम्।\nसर्वातीततरं सूक्ष्मं तस्मै सूक्ष्मात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2072960, "chapter_id": 2541, "verse_number": "१२-४६-८५", "content_sanskrit": "पञ्चभूतात्मभूताय भूतादिनिधनाय च।\nअक्रोधद्रोहमोहाय तस्मै शान्तात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2072961, "chapter_id": 2541, "verse_number": "१२-४६-८६", "content_sanskrit": "यस्मिन्सर्वं यतः सर्वं यः सर्वं सर्वतश्च यः।\nयश्च सर्वमयो देवस्तस्मै सर्वात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2072962, "chapter_id": 2541, "verse_number": "१२-४६-८७", "content_sanskrit": "यः शेते क्षीरपर्यङ्के दिव्यनागविभूषिते।\nफणासहस्ररचिते तस्मै निद्रात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2072963, "chapter_id": 2541, "verse_number": "१२-४६-८८", "content_sanskrit": "विश्वे च मरुतश्चैव रुद्रादित्याश्विनावपि।\nवसवः सिद्धसाध्याश्च तस्मै देवात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2072964, "chapter_id": 2541, "verse_number": "१२-४६-८९", "content_sanskrit": "अव्यक्तं बुद्ध्यहंकारो मनोबुद्धीन्द्रियाणि च।\nतन्मात्राणि विशेषाश्च तस्मै तत्वात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2072965, "chapter_id": 2541, "verse_number": "१२-४६-९०", "content_sanskrit": "भूतं भव्यं भविष्यच्च भूतादिप्रभवाव्ययः।\nयोऽग्रजः सर्वभूतानां तस्मै भूतात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2072966, "chapter_id": 2541, "verse_number": "१२-४६-९१", "content_sanskrit": "यं हि सूक्ष्मं विचिन्वन्ति परं सूक्ष्मविदो जनाः।\nसूक्ष्मात्सूक्ष्मं च यद्ब्रह्म तस्मै सूक्ष्मात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2072967, "chapter_id": 2541, "verse_number": "१२-४६-९२", "content_sanskrit": "मत्स्यो भूत्वा विरिञ्चाय येन वेदाः समाहृताः।\nरसातलगतः शीघ्रं तस्मै मत्स्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2072968, "chapter_id": 2541, "verse_number": "१२-४६-९३", "content_sanskrit": "मन्दराद्रिर्धृतो येन प्राप्ते ह्यमृतमन्थने।\nअतिकर्कशदेहाय तस्मै कूर्मात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2072969, "chapter_id": 2541, "verse_number": "१२-४६-९४", "content_sanskrit": "वाराहं रूपमास्थाय महीं सवनपर्वताम्।\nउद्धरत्येकदंष्ट्रेण तस्मै क्रोडात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2072970, "chapter_id": 2541, "verse_number": "१२-४६-९५", "content_sanskrit": "नारसिंहवपुः कृत्वा सर्वलोकभयंकरम्।\nहिरण्यकशिपुं जघ्ने तस्मै सिंहात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2072971, "chapter_id": 2541, "verse_number": "१२-४६-९६", "content_sanskrit": "पिङ्गेक्षणसटं यस्य रूपं दंष्ट्रानखैर्युतम्।\nदानवेन्द्रान्तकरणं तस्मै दृप्तात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2072972, "chapter_id": 2541, "verse_number": "१२-४६-९७", "content_sanskrit": "यं न देवा न गन्धर्वा न दैत्या न च दानवाः।\nतत्वतो हि विजानन्ति तस्मै सूक्ष्मात्मने नमः॥]\nवामनं रूपमास्थाय बलिं संयम्य मायया।\nत्रैलोक्यं क्रान्तवान्यस्तु तस्मै क्रान्तात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2072973, "chapter_id": 2541, "verse_number": "१२-४६-९८", "content_sanskrit": "जमदग्निसुतो भूत्वा रामः शस्त्रभृतां वरः।\nमहीं निःक्षत्रियां चक्रे तस्मै रामात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2072974, "chapter_id": 2541, "verse_number": "१२-४६-९९", "content_sanskrit": "त्रिःसप्तकृत्वो यश्चैको धर्मे व्युत्क्रान्तिगौरवात्।\nजघान क्षत्रियान्सङ्ख्ये तस्मै क्रोधात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2072975, "chapter_id": 2541, "verse_number": "१२-४६-१००", "content_sanskrit": "[विभज्य पञ्चधाऽऽत्मानं वायुर्भूत्वा शरीरगः।\nयश्चेष्टयति भूतानि तस्मै वाय्वात्मने नमः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2072976, "chapter_id": 2541, "verse_number": "१२-४६-१०१", "content_sanskrit": "रामो दशिरथिर्भूत्वा पुलस्त्यकुलनन्दनम्।\nजघान रावणं सङ्ख्ये तस्मै क्षत्रात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2072977, "chapter_id": 2541, "verse_number": "१२-४६-१०२", "content_sanskrit": "यो हली मुसली श्रीमान्नीलाम्बरधरः स्थितः।\nरामाय रौहिणेयाय तस्मै भोगात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2072978, "chapter_id": 2541, "verse_number": "१२-४६-१०३", "content_sanskrit": "शङ्खिने चक्रिणे नित्यं शार्ङ्गिणे पीतवाससे।\nवनमालाधरायैव तस्मै कृष्णात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2072979, "chapter_id": 2541, "verse_number": "१२-४६-१०४", "content_sanskrit": "वसुदेवसुतः श्रीमान्क्रीडितो नन्दगोकुले।\nकंसस्य निधनार्थाय तस्मै क्रीडात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2072980, "chapter_id": 2541, "verse_number": "१२-४६-१०५", "content_sanskrit": "वासुदेवत्वमागम्य यदोर्वंशसमुद्भवः।\nभूभारहरणं चक्रे तस्मै कृष्णात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2072981, "chapter_id": 2541, "verse_number": "१२-४६-१०६", "content_sanskrit": "सारथ्यमर्जुनस्याजौ कुर्वन्गीतामृतं ददौ।\nलोकत्रयोपकाराय तस्मै ब्रह्मात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2072982, "chapter_id": 2541, "verse_number": "१२-४६-१०७", "content_sanskrit": "दानवांस्तु वशे कृत्वा पुनर्बुद्धत्वमागतः।\nसर्गस्य रक्षणार्थाय तस्मै बुद्धात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2072983, "chapter_id": 2541, "verse_number": "१२-४६-१०८", "content_sanskrit": "हनिष्यति कलौ प्राप्ते म्लेच्छांस्तुरगवाहनः।\nधर्मसंस्थापको यस्तु तस्मै कल्क्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2072984, "chapter_id": 2541, "verse_number": "१२-४६-१०९", "content_sanskrit": "तारान्वये कालनेमिं हत्वा दानवपुङ्गवम्।\nददौ राज्यं महेन्द्राय तस्मै साङ्ख्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2072985, "chapter_id": 2541, "verse_number": "१२-४६-११०", "content_sanskrit": "यः सर्वप्राणिनां देहे साक्षिभूतो ह्यवस्थितः।\nअक्षरः क्षरमाणानां तस्मै साक्ष्यात्मने नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2072986, "chapter_id": 2541, "verse_number": "१२-४६-१११", "content_sanskrit": "नमोस्तु ते महादेव नमस्ते भक्तवत्सल।\nसुब्रह्मण्य नमस्तेऽस्तु प्रसीद परमेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2072987, "chapter_id": 2541, "verse_number": "१२-४६-११२", "content_sanskrit": "अव्यक्तव्यक्तरूपेण व्याप्तं सर्वं त्वया विभो।\nनारायणं सहस्राक्षं सर्वलोकमहेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2072988, "chapter_id": 2541, "verse_number": "१२-४६-११३", "content_sanskrit": "हिरण्यनाभ यज्ञाङ्गममृतं विश्वतोमुखम्।\nसर्वदा सर्वकार्येषु नास्ति तेषाममङ्गलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2072989, "chapter_id": 2541, "verse_number": "१२-४६-११४", "content_sanskrit": "येषां हृदिस्थो देवेशो मङ्गलायतनं हरिः।\nमङ्गल भगवान्विष्णुर्मङ्गलं मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2072990, "chapter_id": 2541, "verse_number": "१२-४६-११५", "content_sanskrit": "मङ्गलं पुण़्डरीकाक्षो मङ्गलं गरुडध्वजः।\nविश्वकर्मन्नमस्तेऽस्तु विश्वात्मन्विश्वसंभव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2072991, "chapter_id": 2541, "verse_number": "१२-४६-११६", "content_sanskrit": "अपवर्गस्थभूतानां पञ्चानां परमास्थित।\nनमस्ते त्रिषु लोकेषु वमस्ते परतस्त्रिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2072992, "chapter_id": 2541, "verse_number": "१२-४६-११७", "content_sanskrit": "नमस्ते दिक्षु सर्वासु त्वं हि सर्वपरायणम्।\nनमस्ते भगवन्विष्णो त्येकानां प्रभवाव्यय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2072993, "chapter_id": 2541, "verse_number": "१२-४६-११८", "content_sanskrit": "त्वं हि कर्ता हृषीकेशः संहर्ता चापराजितः।\nतेन पश्यामि ते दिव्यान्भावान्हि त्रिषुवर्त्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2072994, "chapter_id": 2541, "verse_number": "१२-४६-११९", "content_sanskrit": "तच्च पश्यामि तत्वेन यत्ते रूपं सनातनम्।\nदिवं ते शिरसा व्याप्तं पद्भ्यां देवी वसुंधरा।\nविक्रमेण त्रयो लोकाः पुरुषोऽसि सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2072995, "chapter_id": 2541, "verse_number": "१२-४६-१२०", "content_sanskrit": "[दिशो भुजा रविश्चक्षुर्वीर्ये शुक्रः प्रतिष्ठितः।\nसप्तमार्गा निरुद्धास्ते वायोरमिततेजसः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2072996, "chapter_id": 2541, "verse_number": "१२-४६-१२१", "content_sanskrit": "व्यक्ताव्यक्तस्वरूपेण व्याप्तं सर्वं त्वया विभो।\nअव्यक्तं ब्राह्मणं रूपं व्यक्तमेतच्चराचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2072997, "chapter_id": 2541, "verse_number": "१२-४६-१२२", "content_sanskrit": "अतसीपुष्पसंकाशं पीतवाससमच्युतम्।\nये नमस्यन्ति गोविन्दं न तेषां विद्यते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2072998, "chapter_id": 2541, "verse_number": "१२-४६-१२३", "content_sanskrit": "[एकोऽपि कृष्णस्य कृतः प्रणामो\nदशाश्वमेधावभृथेन तुल्यः।\nदशाश्वमेधी पुनरेति जन्म\nकृष्णप्रणामी न पुनर्भवाय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2072999, "chapter_id": 2541, "verse_number": "१२-४६-१२४", "content_sanskrit": "कृष्णव्रताः कृष्णमनुस्मरन्तो\nरात्रौ च कृष्णं पुनरुत्थिता ये।\nते कृष्णदेहाः प्रविशन्ति कृष्ण\nमाज्यं यथा मन्त्रहुतं हुताशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2073000, "chapter_id": 2541, "verse_number": "१२-४६-१२५", "content_sanskrit": "नमो नरकसंत्रासरक्षामण्डलकारिणे।\nसंसारनिम्नगावर्ततरिकाष्ठाय विष्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2073001, "chapter_id": 2541, "verse_number": "१२-४६-१२६", "content_sanskrit": "नमो ब्रह्मण्यदेवाय गोब्राह्मणहिताय च।\nजगद्धिताय कृष्णाय गोविन्दाय नमोनमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2073002, "chapter_id": 2541, "verse_number": "१२-४६-१२७", "content_sanskrit": "प्राणकान्तारपाथेयं संसारोच्छेदभेषजम्।\nदुःखशोकपरित्राणं हरिरित्यक्षरद्वयम्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2073003, "chapter_id": 2541, "verse_number": "१२-४६-१२८", "content_sanskrit": "नारायणपरं ब्रह्म नारायणपरं तपः।\nनारायणपरं सत्यं नारायणपरं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2073004, "chapter_id": 2541, "verse_number": "१२-४६-१२९", "content_sanskrit": "यथा विष्णुमयं सत्यं यथा विष्णुमयं हविः।\nतथा विष्णुमयं सर्वं पाप्मा ने नश्यतां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2073005, "chapter_id": 2541, "verse_number": "१२-४६-१३०", "content_sanskrit": "तस्य यज्ञवराहस्य विष्णोरमिततेजसः।\nप्रणामं येऽपि कुर्वन्ति तेषामपि नमोनमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2073006, "chapter_id": 2541, "verse_number": "१२-४६-१३१", "content_sanskrit": "त्वां प्रपन्नाय भक्ताय गतिमिष्टां जिगीषवे।\nयच्छ्रेयः पुण्डरीकाक्ष तद्ध्यायस्व सुरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2073007, "chapter_id": 2541, "verse_number": "१२-४६-१३२", "content_sanskrit": "इति विद्यातपोयोनिरयोनिर्विष्णुरीडितः।\nवाग्यज्ञेनार्चितो देवः प्रीयतां मे जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2073008, "chapter_id": 2541, "verse_number": "१२-४६-१३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2073009, "chapter_id": 2541, "verse_number": "१२-४६-१३३", "content_sanskrit": "एतावदुक्त्वा वचनं भीष्मस्तद्रतमानसः।\nनम इत्येव कृष्णाय प्रणाममकरोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2073010, "chapter_id": 2541, "verse_number": "१२-४६-१३४", "content_sanskrit": "तस्मिन्नुपरते वाक्ये ततस्ते ब्रह्मवादिनः।\nभीष्मं वाग्भिर्वाष्पगलास्तमानर्चुर्महाद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2073011, "chapter_id": 2541, "verse_number": "१२-४६-१३५", "content_sanskrit": "तेऽस्तुवन्तश्च विप्रेन्द्राः केशवं पुरुषोत्तमम्।\nभीष्मं च शनकैः सर्वे प्रशशंसुः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2073012, "chapter_id": 2541, "verse_number": "१२-४६-१३६", "content_sanskrit": "अधिगम्य तु योगेन भक्तिं भीष्मस्य माधवः।\nत्रैलोक्यदर्शनं ज्ञानं दिव्यं दत्त्वा ययौ हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2073013, "chapter_id": 2541, "verse_number": "१२-४६-१३७", "content_sanskrit": "विदित्वा भक्तियोगं तं भीष्मस्य पुरुषोत्तमः।\nसहसोत्थाय तं हृष्टो यानमेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2073014, "chapter_id": 2541, "verse_number": "१२-४६-१३८", "content_sanskrit": "केशवः सात्यकिश्चैव रथेनकेन जग्मतुः।\nअपरेण महात्मानौ युधिष्ठिरधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2073015, "chapter_id": 2541, "verse_number": "१२-४६-१३९", "content_sanskrit": "भीमसेनो यमौ चोभौ रथमेकं समास्थिताः।\nकृपो युयुत्सुः सूतश्च सञ्जयश्चापरं रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2073016, "chapter_id": 2541, "verse_number": "१२-४६-१४०", "content_sanskrit": "ते रथैर्नगराकारैः प्रयाताः पुरुषर्षभाः।\nनेमिघोषेण महता कम्पयन्ते वसुंधराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2073017, "chapter_id": 2541, "verse_number": "१२-४६-१४१", "content_sanskrit": "ततो गिरः पुरुषवरस्तवेरितां\nद्विजेरिताः पथिषु मनाक् स शुश्रुवे।\nकृताञ्जलिं प्रणतमथापरं जनं\nस केशिहा मुदितमनास्थनन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2073018, "chapter_id": 2541, "verse_number": "१२-४६-१४२", "content_sanskrit": "इति स्मरन्पठति च शार्ङ्गधन्वनः\nशृणोतु वा यदुकुलनन्दनस्तवम्।\nस चक्रभृत्प्रतिहतसर्वाकिल्विषो\nजनार्दनं प्रविशति देहसंक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2073019, "chapter_id": 2541, "verse_number": "१२-४६-१४३", "content_sanskrit": "यं योगिनः प्राणवियोगकाले\nयत्नेन चित्ते विनिवेशयन्ति।\nस तं पुरस्ताद्धरिमीक्षमाणः\nप्राणाञ्जहौ प्राप्तफलो हि भीष्मः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2073020, "chapter_id": 2541, "verse_number": "१२-४६-१४४", "content_sanskrit": "स्ववराजः समाप्तोऽयं विष्णोरद्भुतकर्मणः।\nगाङ्गेयेन पुरा गीतो महापातकनाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2073021, "chapter_id": 2541, "verse_number": "१२-४६-१४५", "content_sanskrit": "इमं नरः स्तवराजं मुमुक्षुः\nपठञ्शुचिः कलुषितकल्मषापहम्।\nअतीत्य लोकान्मलिनः समामता\nन्पदं स गच्छत्यमृतं महात्मनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2073022, "chapter_id": 2541, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षट्चत्वारिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}]