[{"id": 2069809, "chapter_id": 2459, "verse_number": "१०-११-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069810, "chapter_id": 2459, "verse_number": "१०-११-१", "content_sanskrit": "स दृष्ट्वा निहतान्सङ्ख्ये पुत्रान्पात्रौन्सखींस्तथा।\nमहादुःखपरीतात्मा बभूव जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069811, "chapter_id": 2459, "verse_number": "१०-११-२", "content_sanskrit": "ततस्तस्य महाञ्शोकः प्रादुरासीन्महात्मनः।\nस्मरतः पुत्रपौत्रांस्तान्भ्रातॄन्सुहृद एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069812, "chapter_id": 2459, "verse_number": "१०-११-३", "content_sanskrit": "तमश्रुपरिपूर्णाक्षं वेपमानमचेतसम्।\nसुहृदो भृशसंविग्नाः सांत्वयाञ्चक्रिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069813, "chapter_id": 2459, "verse_number": "१०-११-४", "content_sanskrit": "`कृत्वा तु विधिवत्तेषां पुत्राणाममितौजसाम्।\nप्रेतकार्याणि सर्वेषां बभूव भृशदुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069814, "chapter_id": 2459, "verse_number": "१०-११-५", "content_sanskrit": "तस्मिन्मुहूर्ते जवनैर्वाजिभिर्हेममालिभिः।\nनकुलः कृष्णया सार्धमुपायात्परमार्तया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069815, "chapter_id": 2459, "verse_number": "१०-११-६", "content_sanskrit": "उपप्लाव्यं गता सा तु श्रुत्वा सुमहदप्रियम्।\nतदा विनाशं सर्वेषां पुत्राणां व्यथितेन्द्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069816, "chapter_id": 2459, "verse_number": "१०-११-७", "content_sanskrit": "कम्पमानेव कदली वातेनाभिसमीरिता।\nकृष्णा राजानमासाद्य शोकार्ता न्यपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069817, "chapter_id": 2459, "verse_number": "१०-११-८", "content_sanskrit": "न बभौ वदनं तस्या रुदन्त्याः शोककर्शितम्।\nफुल्लपद्मपलाशाक्ष्या मेघावृत इवोडुराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069818, "chapter_id": 2459, "verse_number": "१०-११-९", "content_sanskrit": "ततस्तां पतितां दृष्ट्वा संरम्भी सत्यविक्रमः।\nवाहुभ्यां परिजग्राह समुत्पत्य वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069819, "chapter_id": 2459, "verse_number": "१०-११-१०", "content_sanskrit": "सा समाश्वासिता तेन भीमसेनेन भामिनी।\nरुदती पाण्डवज्येष्ठमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069820, "chapter_id": 2459, "verse_number": "१०-११-११", "content_sanskrit": "दिष्ट्या राजन्नवाप्येमामखिलां भोक्ष्यसे महीम्।\nआत्मजान्क्षत्रधर्मेण सम्प्रदाय यमाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069821, "chapter_id": 2459, "verse_number": "१०-११-१२", "content_sanskrit": "दिष्ट्या सर्वास्त्रकुशलं मत्तमातङ्गामिनम्।\nअवाप्य पृथिवीं कृत्स्नां सौभद्रं न स्मरिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069822, "chapter_id": 2459, "verse_number": "१०-११-१३", "content_sanskrit": "आत्मजान्क्षत्रधर्मेण श्रुत्वा शूरान्निपातितान्।\nस्थितो राज्ये मया सार्धं विहरन्न स्मरिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069823, "chapter_id": 2459, "verse_number": "१०-११-१४", "content_sanskrit": "प्रसुप्तानां वधं श्रुत्वा द्रौणिना पापकर्मणा।\nशोको मां दहते गाढो हुताशन इवाश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069824, "chapter_id": 2459, "verse_number": "१०-११-१५", "content_sanskrit": "तस्य पापकृतो द्रौणेर्न चेदद्य दुरात्मनः।\nहियते सानुबन्धस्य युधि विक्रम्य जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069825, "chapter_id": 2459, "verse_number": "१०-११-१६", "content_sanskrit": "इहैव प्रायमासिष्ये तन्निबोधत पाण्डवाः।\nन चेत्फलमवाप्नोति द्रौणिः पापस्य कर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069826, "chapter_id": 2459, "verse_number": "१०-११-१७", "content_sanskrit": "एवमक्त्वा ततः कृष्णा पाण्डवं प्रत्युपाविशत्।\nयुधिष्ठिरं याज्ञसेनी धर्मराजं यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069827, "chapter_id": 2459, "verse_number": "१०-११-१८", "content_sanskrit": "दृष्ट्वोपविष्टां राजा तु पाण्डवो महिषीं प्रियाम्।\nप्रत्युवाच स धर्मात्मा द्रौपदीं चारुदर्शनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069828, "chapter_id": 2459, "verse_number": "१०-११-१९", "content_sanskrit": "क्षत्रधर्मेण धर्मज्ञे प्राप्तास्ते निधनं शुभे।\nपुत्रास्ते भ्रातरश्चैव तान्न शोचितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069829, "chapter_id": 2459, "verse_number": "१०-११-२०", "content_sanskrit": "स कल्याणि वनं दुर्गं दूरं द्रौणिरितो गतः।\nतस्य त्वं पातनं सङ्ख्ये कथं ज्ञास्यसि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069830, "chapter_id": 2459, "verse_number": "१०-११-२१x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069831, "chapter_id": 2459, "verse_number": "१०-११-२१", "content_sanskrit": "द्रोणपुत्रस्य सहजो मणिः शिरसि मे श्रुतः।\nनिहत्य सङ्ख्ये तं पापं पश्येयं मणिमाहृतम्।\nद्रौणेः शिरस उत्कृत्य जीवेयमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069832, "chapter_id": 2459, "verse_number": "१०-११-२२", "content_sanskrit": "इत्युक्त्वा पाण्डवं कृष्णा राजानं चारुदर्शना।\nभीमसेनकरे स्पृष्ट्वा कुपिता वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069833, "chapter_id": 2459, "verse_number": "१०-११-२३", "content_sanskrit": "त्रातुमर्हसि मां भीम क्षत्रधर्ममनुस्मरन्।\nजहि तं पापकर्माणं शम्बरं सघवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069834, "chapter_id": 2459, "verse_number": "१०-११-२४", "content_sanskrit": "न हि ते विक्रमे तुल्यः पुमानस्तीह कश्चन।\nश्रुतं तत्सर्वलोकेषु परमव्यसने तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069835, "chapter_id": 2459, "verse_number": "१०-११-२५", "content_sanskrit": "द्वीपोऽभूस्त्वं हि पार्थानां नगरे वारणावते।\nहिडिम्बदर्शने चैव तथां त्वमभवो गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069836, "chapter_id": 2459, "verse_number": "१०-११-२६", "content_sanskrit": "तथा विराटनगरे कीचकेन भृशार्दिताम्।\nमामप्युद्वृतवान्कृच्छ्रात्पौलोमीं मघवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069837, "chapter_id": 2459, "verse_number": "१०-११-२७", "content_sanskrit": "यथैतान्यकृथाः पार्थ महाकर्माणि वै पुरा।\nतथा द्रौणिममित्रघ्न विनिहत्य सुखी भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069838, "chapter_id": 2459, "verse_number": "१०-११-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069839, "chapter_id": 2459, "verse_number": "१०-११-२८", "content_sanskrit": "तस्या बहुविधं दुःखं निशम्य परिदेवितम्।\nन चामर्षत कौन्तेयो भीमसेनो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069840, "chapter_id": 2459, "verse_number": "१०-११-२९", "content_sanskrit": "स काञ्चनविचित्राङ्गमारुरोह महारथम्।\nआदाय रुचिरं चित्रं समार्गणगुणं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069841, "chapter_id": 2459, "verse_number": "१०-११-३०", "content_sanskrit": "नकुलं सारथिं कृत्वा द्रोणपुत्रवधे धृतः।\nविस्फार्य सशरं चापं तूर्णमश्वानचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069842, "chapter_id": 2459, "verse_number": "१०-११-३१", "content_sanskrit": "ते हयाः पुरुषव्याघ्र दीप्यमानाः स्वतेजसा।\nवहन्तः सहसा जग्मुर्हरयः शीघ्रगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069843, "chapter_id": 2459, "verse_number": "१०-११-३२", "content_sanskrit": "शिबिरात्स्वाद्गृहीत्वा स रथस्य पदमच्युतः।\n`द्रोणपुत्रगतेनाशु ययौ मार्गेण भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069844, "chapter_id": 2459, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि ऐषीकपर्वणि एकादशोऽध्यायः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]