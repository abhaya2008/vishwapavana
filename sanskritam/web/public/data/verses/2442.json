[{"id": 2068769, "chapter_id": 2442, "verse_number": "९-६०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068770, "chapter_id": 2442, "verse_number": "९-६०-१", "content_sanskrit": "तं पातितं ततो दृष्ट्वा महासालमिवोद्गतम्।\nप्रहृष्टमनसः सर्वे बभूवुस्तत्र पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068771, "chapter_id": 2442, "verse_number": "९-६०-२", "content_sanskrit": "उन्मत्तमिव मातङ्गं सिंहेन विनिपातितम्।\nददृशुर्हृष्टरोमाणः सर्वे ते चापि सोमकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068772, "chapter_id": 2442, "verse_number": "९-६०-३", "content_sanskrit": "ततो दुर्योधनं हत्वा भीमसेनः प्रतापवान्।\nपातितं कौरवेन्द्रं तमुपगम्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068773, "chapter_id": 2442, "verse_number": "९-६०-४", "content_sanskrit": "गौर्गौरिति पुरा मन्द द्रौपदीमेकवाससम्।\nयत्सभायां हसन्नस्मांस्तदा वदसि दुर्मते।\nतस्यावहासस्य फलमद्य त्वं समवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068774, "chapter_id": 2442, "verse_number": "९-६०-५", "content_sanskrit": "एवमुक्त्वा स वामेन पदा मौलिमुपास्पृशत्।\nशिरश्च राजसिंहस्य पादेन समलोडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068775, "chapter_id": 2442, "verse_number": "९-६०-६", "content_sanskrit": "तथैव क्रोधसंरक्तो भीमः परबलार्दनः।\nपुनरेवाब्रवीद्वाक्यं यत्तच्छृणु नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068776, "chapter_id": 2442, "verse_number": "९-६०-७", "content_sanskrit": "येऽस्मान्पुरा प्रनृत्यन्ति मूढा गौरिति गौरिति।\nतान्वयं प्रतिनृत्यामः पुनर्गौरिति गौरिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068777, "chapter_id": 2442, "verse_number": "९-६०-८", "content_sanskrit": "नास्माकं निकृतिर्वह्निर्नाक्षद्यूतं न वञ्चना।\nस्वबाहुबलमाश्रित्य प्रबाधामो वयं रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068778, "chapter_id": 2442, "verse_number": "९-६०-९", "content_sanskrit": "सोऽवाप्य वैरस्य चिरस्य पारं\nवृकोदरः प्राह शनैः प्रहस्य।\nयुधिष्ठिरं केशवसृञ्जयांश्च\nधनञ्जयं माद्रवतीसुतौ च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068779, "chapter_id": 2442, "verse_number": "९-६०-१०", "content_sanskrit": "रजस्वला द्रौपदीमानयन्ते\nये चाप्यकुर्वन्त सदस्यवस्त्राम्। ९-६०-१०cतान्पश्यध्वं पाण्डवैर्धार्तराष्ट्रान्\nरणे हतांस्तपसा याज्ञसेन्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068780, "chapter_id": 2442, "verse_number": "९-६०-११", "content_sanskrit": "ये नः पुरा षण्ढतिलानवोचन्\nक्रूरा राज्ञो धृतराष्ट्रस्य पुत्राः।\nते नो हताः सगणाः सानुबन्धाः\nकामं स्वर्गं नरकं वा व्रजामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068781, "chapter_id": 2442, "verse_number": "९-६०-१२", "content_sanskrit": "पुनश्च राज्ञः पतितस्य भूमौ\nस तां गदां स्कन्धगतां प्रगृह्य।\nवामेन पादेन शिरः प्रमृद्य\nदुर्योधनं नैकृतिकेत्यवोचत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068782, "chapter_id": 2442, "verse_number": "९-६०-१३", "content_sanskrit": "हृष्टेन राजन्कुरुपार्थिवस्य\nक्षुद्रात्मना भीमसेनेन पादम्।\nदृष्ट्वा कृतं मूर्धनि नाभ्यनन्दन्\nधर्मात्मानः सोमकानां प्रबर्हाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068783, "chapter_id": 2442, "verse_number": "९-६०-१४", "content_sanskrit": "तव पुत्रं तथा हत्वा कत्थमानं वृकोदरम्।\nनृत्यमानं च बहुशो धर्मराजोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068784, "chapter_id": 2442, "verse_number": "९-६०-१५", "content_sanskrit": "गतोऽसि वैरस्यानृण्यं प्रतिज्ञा पूरिता त्वया।\nशुभेनाथाशुभेनैव कर्मणा विरमाधुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068785, "chapter_id": 2442, "verse_number": "९-६०-१६", "content_sanskrit": "मा शिरोऽस्य पदाऽमर्दीर्मा धर्मस्तेऽतिगो भवेत्।\nराजा ज्ञातिर्हतश्चायं नैतन्न्याय्यं तवानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068786, "chapter_id": 2442, "verse_number": "९-६०-१७", "content_sanskrit": "एकादशचमूनाथं कुरूणामधिपं तथा।\nमास्प्राक्षीर्भीम पादेन राजानं ज्ञातिमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068787, "chapter_id": 2442, "verse_number": "९-६०-१८", "content_sanskrit": "हतबन्धुर्हतामात्यो भ्रष्टसैन्यो हतो मृधे।\nसर्वाकारेण शोच्योऽयं नावहास्योऽयमीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068788, "chapter_id": 2442, "verse_number": "९-६०-१९", "content_sanskrit": "विध्वस्तोऽयं हतामात्यो हतबन्धुर्हतात्मजः।\nउत्सन्नपिण्डो भ्राता च नैतन्न्याय्यं कृतं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068789, "chapter_id": 2442, "verse_number": "९-६०-२०", "content_sanskrit": "धार्मिको भीमसेनोऽसावित्याहुस्त्वां पुरा जनाः।\nस कस्माद्भीमसेन त्वं राजानमधितिष्ठसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068790, "chapter_id": 2442, "verse_number": "९-६०-२१", "content_sanskrit": "इत्युक्त्वा भीमसेनं तु साश्रुकण्ठो युधिष्ठिरः।\nउपसृत्याब्रवीद्दीनो दुर्योधनमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068791, "chapter_id": 2442, "verse_number": "९-६०-२२", "content_sanskrit": "तात मन्युर्न ते कार्यो नात्मा शोच्यस्त्वया तथा।\nनूनं पूर्वकृतं कर्म सुघोरमनुभूयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068792, "chapter_id": 2442, "verse_number": "९-६०-२३", "content_sanskrit": "धात्रोपदिष्टं विषमं नूनं फलमसंस्कृतम्।\nयद्वयं त्वां जिघांसामस्त्वं चास्मान्कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068793, "chapter_id": 2442, "verse_number": "९-६०-२४", "content_sanskrit": "आत्मनो ह्यपराधेन महद्व्यसनमीहशम्।\nप्राप्तवानसि यल्लोभान्मदाद्बाल्याच्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068794, "chapter_id": 2442, "verse_number": "९-६०-२५", "content_sanskrit": "घातयित्वा वयस्यांश्च भ्रातॄनथ पितॄंस्तथा।\nपुत्रान्पौत्रांस्तथा चान्यांस्ततोसि निधनं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068795, "chapter_id": 2442, "verse_number": "९-६०-२६", "content_sanskrit": "तवापराधादस्माभिर्भ्रातरस्ते निपातिताः।\nनिहता ज्ञातयश्चापि दिष्टं मन्ये दुरत्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068796, "chapter_id": 2442, "verse_number": "९-६०-२७", "content_sanskrit": "[आत्मा न शोचनीयस्ते श्लाघ्यो मृत्युस्तवानघ।\nवयमेवाधुना शोच्याः सर्वावस्थासु कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068797, "chapter_id": 2442, "verse_number": "९-६०-२८", "content_sanskrit": "कृपणं वर्तयिष्यामस्तैर्हीना बन्धुभिः प्रियैः।\nभ्रातॄणां चैव पुत्राणां तथा वै शोकविह्वलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068798, "chapter_id": 2442, "verse_number": "९-६०-२९", "content_sanskrit": "कथं द्रक्ष्यामि विधवा वधूः शोकपरिप्लुताः।\nत्वमेकः सुस्थितो राजन्स्वर्गे ते निलयो ध्रुवः।\nवयं नरकसंज्ञं वै दुःखं प्राप्स्याम दारुणम्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068799, "chapter_id": 2442, "verse_number": "९-६०-३०", "content_sanskrit": "स्नुषाश्च प्रस्नुषाश्चैव धृतराष्ट्रस्य विह्वलाः।\nगर्हयिष्यन्ति नो नूनं विधवाः शोककर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068800, "chapter_id": 2442, "verse_number": "९-६०-३१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068801, "chapter_id": 2442, "verse_number": "९-६०-३१", "content_sanskrit": "एवमुक्त्वा सुदुःखार्तो निशश्वास स पार्थिवः।\nविललाप चिरं चापि धर्मपुत्रो युधिष्ठिरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068802, "chapter_id": 2442, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि गदायुद्धपर्वणि षष्टितमोऽध्यायः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]