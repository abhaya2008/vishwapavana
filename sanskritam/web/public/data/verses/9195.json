[{"id": 40014378, "chapter_id": 9195, "verse_number": "1", "content_sanskrit": "इत्युक्ताराक्षसेन्द्रेणराक्षसास्तेमहाबलाः । ऊचुःप्रान्जलयःसर्वेरावणंराक्षसेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014379, "chapter_id": 9195, "verse_number": "2", "content_sanskrit": "द्विषत्पक्षमविज्ञायनीतिबाह्यास्त्वबुद्धयः । राजन्परिघशक्त्यृष्टिशूलपट्टिशकुन्तलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014380, "chapter_id": 9195, "verse_number": "3", "content_sanskrit": "इत्युक्ताराक्षसेन्द्रेणराक्षसास्तेमहाबलाः । ऊचुःप्रान्जलयःसर्वेरावणंराक्षसेश्वरम् ॥ द्विषत्पक्षमविज्ञायनीतिबाह्यास्त्वबुद्धयः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014381, "chapter_id": 9195, "verse_number": "4", "content_sanskrit": "राजन्परिघशक्त्यृष्टिशूलपट्टिशकुन्तलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014382, "chapter_id": 9195, "verse_number": "5", "content_sanskrit": "सुमहन्नोबलंकस्माद्विषादंभजतेभवान् । त्वयाभोगवतींगत्वानिर्जिताःपन्नगायुधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014383, "chapter_id": 9195, "verse_number": "6", "content_sanskrit": "कैलासशिखरावासीयक्षैर्बहुभिरावृतः । सुमहत्कदनंकृत्वावश्यस्तेधनदःकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014384, "chapter_id": 9195, "verse_number": "7", "content_sanskrit": "समहेश्वरसख्येनश्लाघमानस्त्वयाविभो । निर्जितःसमरेरोषाल्लोकपालोमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014385, "chapter_id": 9195, "verse_number": "8", "content_sanskrit": "विनिहत्यचयक्षौघान्विक्षोभ्यचविनिगृह्यच । त्वयाकैलासशिखराद्विमानमिदमाहृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014386, "chapter_id": 9195, "verse_number": "9", "content_sanskrit": "मयेनदानवेन्द्रेणत्वद्भयात्सख्यमिच्छता । दुहितातवभार्यार्थेदत्ताराक्षसपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014387, "chapter_id": 9195, "verse_number": "10", "content_sanskrit": "दानवेन्द्रोमधुर्नामवीर्योत्सिक्तोदुरासदः । विगृह्यवशमानीतःकुम्भीनस्याःसुखावहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014388, "chapter_id": 9195, "verse_number": "11", "content_sanskrit": "निर्जितास्तेमहाबाहोनागागत्वारसातलम् । वासुकिस्तक्षकःशङखोजटीचवशमाहृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014389, "chapter_id": 9195, "verse_number": "12", "content_sanskrit": "अक्षयाबलवन्तश्चशूरालब्धवराःपुनः । त्वयासंवत्सरंयुद्ध्वासमरेदानवाविभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014390, "chapter_id": 9195, "verse_number": "13", "content_sanskrit": "स्वबलंसमुपाश्रित्यनीतावशमरिन्दम । मायाश्चाधिगतास्तत्रबह्व्योवैराक्षसाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014391, "chapter_id": 9195, "verse_number": "14", "content_sanskrit": "शूराश्चबलवन्तश्चवरुणस्यसुतारणे । निर्जितास्तेमहाभागचतुर्विधबलानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014392, "chapter_id": 9195, "verse_number": "15", "content_sanskrit": "मृत्युदण्डमहाग्राहंशाल्मलिद्रुममण्डि