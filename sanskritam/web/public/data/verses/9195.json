398, "chapter_id": 9195, "verse_number": "21", "content_sanskrit": "अनेनहिमहाराजमहेश्वरमनुत्तमम् । इष्ट्वायज्ञंवरोलब्धोलोकेपरमदुर्लभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014399, "chapter_id": 9195, "verse_number": "22", "content_sanskrit": "शक्तितोमरमीनंचविनिकीर्णान्त्रशैवलम् । गजकछपसम्बाधमश्वमण्डूकसंकुलम् ॥ रुद्रादित्यमहाग्राहंमरुद्वसुमहोरगम् । रथश्वगजतोयौघंपदातिपुलिनंमहत् ॥ अनेनहिसमासाद्यदेवानांबलसागरम् । गृहीतोदैवतपतिर्लङ्कांचापिप्रवेशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014400, "chapter_id": 9195, "verse_number": "23", "content_sanskrit": "शक्तितोमरमीनंचविनिकीर्णान्त्रशैवलम् । गजकछपसम्बाधमश्वमण्डूकसंकुलम् ॥ रुद्रादित्यमहाग्राहंमरुद्वसुमहोरगम् । रथश्वगजतोयौघंपदातिपुलिनंमहत् ॥ अनेनहिसमासाद्यदेवानांबलसागरम् । गृहीतोदैवतपतिर्लङ्कांचापिप्रवेशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014401, "chapter_id": 9195, "verse_number": "24", "content_sanskrit": "शक्तितोमरमीनंचविनिकीर्णान्त्रशैवलम् । गजकछपसम्बाधमश्वमण्डूकसंकुलम् ॥ रुद्रादित्यमहाग्राहंमरुद्वसुमहोरगम् । रथश्वगजतोयौघंपदातिपुलिनंमहत् ॥ अनेनहिसमासाद्यदेवानांबलसागरम् । गृहीतोदैवतपतिर्लङ्कांचापिप्रवेशितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40014402, "chapter_id": 9195, "verse_number": "25", "content_sanskrit": "पितामहनियोगाच्चमुक्तःशम्बरवृत्रहा । गतस्त्रिविष्टपम्राजन्सर्वदेवनमस्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]