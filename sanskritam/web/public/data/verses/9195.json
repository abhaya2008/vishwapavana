[{"id": 5000195000, "chapter_id": 9195, "verse_number": "२-११८-१", "content_sanskrit": "सा त्वेवमुक्ता वैदेही त्वनसूया ऽनसूयया ।\nप्रतिपूज्य वचो मन्दं प्रवक्तुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000195001, "chapter_id": 9195, "verse_number": "२-११८-२", "content_sanskrit": "नैतदाश्चर्य्यमार्याया यन्मां त्वमनुभाषसे ।\nविदितं तु ममाप्येतद्यथा नार्य्या: पतिर्गुरु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000195002, "chapter_id": 9195, "verse_number": "२-११८-३", "content_sanskrit": "यद्यप्येष भवेद्भर्ता ममार्ये वृत्तवर्जित: ।\nअद्वैधमुपचर्तव्यस्तथाप्येष मया भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000195003, "chapter_id": 9195, "verse_number": "२-११८-४", "content_sanskrit": "किं पुनर्यो गुण: श्लाघ्य: सानुक्रोशो जितेन्द्रिय: ।\nस्थिरानुरागो धर्मात्मा मातृवत्पितृवत्प्रिय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000195004, "chapter_id": 9195, "verse_number": "२-११८-५", "content_sanskrit": "यां वृत्तिं वर्त्तते राम: कौसल्यायां महाबल: ।\nतामेव नृपनारीणामन्यासामपि वर्त्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000195005, "chapter_id": 9195, "verse_number": "२-११८-६", "content_sanskrit": "सकृद्दृष्टास्वपि स्त्रीषु नृपेण नृपवत्सल: ।\nमातृवद्वर्त्तते वीरो मानमुत्सृज्य धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000195006, "chapter_id": 9195, "verse_number": "२-११८-७", "content_sanskrit": "आगच्छन्त्याश्च विजनं वनमेवं भयावहम् ।\nसमाहितं मे श्वश्र्वा च हृदये तद्धृतं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000195007, "chapter_id": 9195, "verse_number": "२-११८-८", "content_sanskrit": "पाणिप्रदानकाले च यत्पुरा त्वग्निसन्निधौ ।\nअनुशिष्टा जनन्या ऽस्मि वाक्यं तदपि मे धृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000195008, "chapter_id": 9195, "verse_number": "२-११८-९", "content_sanskrit": "नवीकृतं च तत्सर्वं वाक्यैस्ते धर्मचारिणि ।\nपतिशुश्रूषणान्नार्य्यास्तपो नान्यद्विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000195009, "chapter_id": 9195, "verse_number": "२-११८-१०", "content_sanskrit": "सावित्री पतिशुश्रूषां कृत्वा स्वर्गे महीयते ।\nतथावृत्तिश्च याता त्वं पतिशुश्रूषया दिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000195010, "chapter_id": 9195, "verse_number": "२-११८-११", "content_sanskrit": "वरिष्ठा सर्वनारीणामेषा च दिवि देवता ।\nरोहिणी न विना चन्द्रं मुहूर्त्तमपि दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000195011, "chapter_id": 9195, "verse_number": "२-११८-१२", "content_sanskrit": "एवंविधाश्च प्रवरा: स्त्रियो भर्तृदृढव्रता: ।\nदेवलोके महीयन्ते पुण्येन स्वेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000195012, "chapter_id": 9195, "verse_number": "२-११८-१३", "content_sanskrit": "ततो ऽनसूया संहृष्टा श्रुत्वोक्तं सीतया वच: ।\nशिरस्याघ्राय चोवाच मैथिलीं हर्षयन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000195013, "chapter_id": 9195, "verse_number": "२-११८-१४", "content_sanskrit": "नियमैर्विविधैराप्तं तपो हि महदस्ति मे ।\nतत्संश्रित्य बलं सीते छन्दये त्वां शुचिस्मिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000195014, "chapter_id": 9195, "verse_number": "२-११८-१५", "content_sanskrit": "उपपन्नं मनोज्ञं च वचनं तव मैथिलि ।\nप्रीता चास्म्युचितं किं ते करवाणि ब्रवीहि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000195015, "chapter_id": 9195, "verse_number": "२-११८-१६", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा विस्मिता मन्दविस्मया\nकृतमित्यब्रवीत्सीता तपोबलसमन्विताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000195016, "chapter_id": 9195, "verse_number": "२-११८-१७", "content_sanskrit": "सा त्वेवमुक्ता धर्मज्ञा तया प्रीततरा ऽभवत् ।\nसफलं च प्रहर्षं ते हन्त सीते करोम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000195017, "chapter_id": 9195, "verse_number": "२-११८-१८", "content_sanskrit": "इदं दिव्यं वरं माल्यं वस्त्रमाभरणानि च ।\nअङ्गरागं च वैदेहि महार्हं चानुलेपनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000195018, "chapter_id": 9195, "verse_number": "२-११८-१९", "content_sanskrit": "मया दत्तमिदं सीते तव गात्राणि शोभयेत् ।\nअनुरूपमसंक्लिष्टं नित्यमेव भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000195019, "chapter_id": 9195, "verse_number": "२-११८-२०", "content_sanskrit": "अङ्गरागेण दिव्येन लिप्ताङ्गी जनकात्मजे ।\nशोभयिष्यसि भर्त्तारं यथा श्रीविष्णुमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000195020, "chapter_id": 9195, "verse_number": "२-११८-२१", "content_sanskrit": "सा वस्त्रमङ्गरागं च भूषणानि स्रजस्तथा ।\nमैथिली प्रतिजग्राह प्रीतिदानमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000195021, "chapter_id": 9195, "verse_number": "२-११८-२२", "content_sanskrit": "प्रतिगृह्य च तत् सीता प्रीतिदानं यशस्विनी ।\nश्लिष्टाञ्जलिपुटा तत्र समुपास्त तपोधनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000195022, "chapter_id": 9195, "verse_number": "२-११८-२३", "content_sanskrit": "तथा सीतासुपासीनामनसूया दृढव्रता ।\nवचनं प्रष्टुमारेभे काञ्चित् प्रियकथामनु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000195023, "chapter_id": 9195, "verse_number": "२-११८-२४", "content_sanskrit": "स्वयंवरे किल प्राप्ता त्वमनेन यशस्विना ।\nराघवेणेति मे सीते कथा श्रुतिमुपागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000195024, "chapter_id": 9195, "verse_number": "२-११८-२५", "content_sanskrit": "तां कथां श्रोतुमिच्छामि विस्तरेण च मैथिलि ।\nयथानुभूतं कार्त्स्न्येन तन्मे त्वं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000195025, "chapter_id": 9195, "verse_number": "२-११८-२६", "content_sanskrit": "एवमुक्ता तु सा सीता तां ततो धर्मचारिणीम् ।\nश्रूयतामिति चोक्त्वा वै कथयामास तां कथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000195026, "chapter_id": 9195, "verse_number": "२-११८-२७", "content_sanskrit": "मिथिलाधिपतिर्वीरो जनको नाम धर्मवित् ।\nक्षत्रधर्मे ह्यभिरतो न्यायत: शास्ति मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000195027, "chapter_id": 9195, "verse_number": "२-११८-२८", "content_sanskrit": "तस्य लाङ्गलहस्तस्य कर्षत: क्षेत्रमण्डलम् ।\nअहं किलोत्थिता भित्त्वा जगतीं नृपते: सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000195028, "chapter_id": 9195, "verse_number": "२-११८-२९", "content_sanskrit": "स मां दृष्ट्वा नरपतिर्मुष्टिविक्षेपतत्पर: ।\nपांसुकुण्ठितसर्वाङ्गीं जनको विस्मितो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000195029, "chapter_id": 9195, "verse_number": "२-११८-३०", "content_sanskrit": "अनपत्येन च स्नेहादङ्कमारोप्य च स्वयम् ।\nममेयं तनयेत्युक्त्वा स्नेहो मयि निपातित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000195030, "chapter_id": 9195, "verse_number": "२-११८-३१", "content_sanskrit": "अन्तरिक्षे च वागुक्ता प्रति मा ऽमानुषी किल ।\nएवमेतन्नरपते धर्मेण तनया तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000195031, "chapter_id": 9195, "verse_number": "२-११८-३२", "content_sanskrit": "तत: प्रहृष्टो धर्मात्मा पिता मे मिथिलाधिप: ।\nअवाप्तो विपुलामृद्धिं मामवाप्य नराधिप: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000195032, "chapter_id": 9195, "verse_number": "२-११८-३३", "content_sanskrit": "दत्ता चास्मीष्टवद्देव्यै ज्येष्ठायै पुण्यकर्मणा ।\nतया सम्भाविता चास्मि स्निग्धया मातृसौहृदात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000195033, "chapter_id": 9195, "verse_number": "२-११८-३४", "content_sanskrit": "पतिसंयोगसुलभं वयो दृष्ट्वा तु मे पिता ।\nचिन्तामभ्यगमद्दीनो वित्तनाशादिवाधन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000195034, "chapter_id": 9195, "verse_number": "२-११८-३५", "content_sanskrit": "सदृशाच्चापकृष्टाच्च लोके कन्यापिता जनात् ।\nप्रधर्षणमवाप्नोति शक्रेणापि समो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000195035, "chapter_id": 9195, "verse_number": "२-११८-३६", "content_sanskrit": "तां धर्षणामदूरस्थां दृष्ट्वा चात्मनि पार्थिव: ।\nचिन्तार्णवगत: पारं नाससादाप्लवो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000195036, "chapter_id": 9195, "verse_number": "२-११८-३७", "content_sanskrit": "अयोनिजां हि मां ज्ञात्वा नाध्यगच्छद्विचिन्तयन् ।\nसदृशं चानुरूपं च महीपाल: पतिं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000195037, "chapter_id": 9195, "verse_number": "२-११८-३८", "content_sanskrit": "तस्य बुद्धिरियं जाता चिन्तयानस्य सन्ततम् ।\nस्वयं वरं तनूजाया: करिष्यामीति धीमत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000195038, "chapter_id": 9195, "verse_number": "२-११८-३९", "content_sanskrit": "महायज्ञे तदा तस्य वरुणेन महात्मना ।\nदत्तं धनुर्वरं प्रीत्या तूणी चाक्षयसायकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000195039, "chapter_id": 9195, "verse_number": "२-११८-४०", "content_sanskrit": "असञ्चाल्यं मनुष्यैश्च यत्नेनापि च गौरवात् ।\nतन्न शक्ता नमयितुं स्वप्नेष्वपि नराधिपा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000195040, "chapter_id": 9195, "verse_number": "२-११८-४१", "content_sanskrit": "तद्धनु: प्राप्य मे पित्रा व्याहृतं सत्यवादिना ।\nसमवाये नरेन्द्राणां पूर्वमामन्त्र्य पार्थिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000195041, "chapter_id": 9195, "verse_number": "२-११८-४२", "content_sanskrit": "इदं च धनुरुद्यम्य सज्यं य: कुरुते नर: ।\nतस्य मे दुहिता भार्या भविष्यति न संशय: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000195042, "chapter_id": 9195, "verse_number": "२-११८-४३", "content_sanskrit": "तच्च दृष्ट्वा धनु: श्रेष्ठं गौरवाद्गिरिसन्निभम् ।\nअभिवाद्य नृपा जग्मुरशक्तास्तस्य तोलने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000195043, "chapter_id": 9195, "verse_number": "२-११८-४४", "content_sanskrit": "सुदीर्घस्य तु कालस्य राघवो ऽयं महाद्युति: ।\nविश्वामित्रेण सहितो यज्ञं द्रष्टुं समागत: ।\nलक्ष्मणेन सह भ्रात्रा राम: सत्यपराक्रम: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000195044, "chapter_id": 9195, "verse_number": "२-११८-४५", "content_sanskrit": "विश्वामित्रस्तु धर्मात्मा मम पित्रा सुपूजित: ।\nप्रोवाच पितरं तत्र भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000195045, "chapter_id": 9195, "verse_number": "२-११८-४६", "content_sanskrit": "सुतौ दशरथस्येमौ धनुर्दर्शनकांक्षिणौ ।\nधनुर्दर्शय रामाय राजपुत्राय दैविकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000195046, "chapter_id": 9195, "verse_number": "२-११८-४७", "content_sanskrit": "इत्युक्तस्तेन विप्रेण तद्धनु: समुपानयत् ।\nनिमेषान्तरमात्रेण तदानम्य स वीर्य्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000195047, "chapter_id": 9195, "verse_number": "२-११८-४८", "content_sanskrit": "ज्यां समारोप्य झटिति पूरयामास वीर्यवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000195048, "chapter_id": 9195, "verse_number": "२-११८-४९", "content_sanskrit": "तेन पूरयता वेगान्मध्ये भग्नं द्विधा धनु: ।\nतस्य शब्दो ऽभवद्भीम: पतितस्याशनेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000195049, "chapter_id": 9195, "verse_number": "२-११८-५०", "content_sanskrit": "ततो ऽहं तत्र रामाय पित्रा सत्याभिसन्धिना ।\nनिश्चिता दातुमुद्यम्य जलभाजनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000195050, "chapter_id": 9195, "verse_number": "२-११८-५१", "content_sanskrit": "दीयमानां न तु तदा प्रतिजग्राह राघव: ।\nअविज्ञाय पितुश्छन्दमयोध्याधिपते: प्रभो: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000195051, "chapter_id": 9195, "verse_number": "२-११८-५२", "content_sanskrit": "तत: श्वशुरमामन्त्र्य वृद्धं दशरथं नृपम् ।\nमम पित्रा त्वहं दत्ता रामाय विदितात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000195052, "chapter_id": 9195, "verse_number": "२-११८-५३", "content_sanskrit": "मम चैवानुजा साध्वी ऊर्मिला प्रियदर्शना ।\nभार्य्यार्थे लक्ष्मणस्यापि दत्ता पित्रा मम स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000195053, "chapter_id": 9195, "verse_number": "२-११८-५४", "content_sanskrit": "एवं दत्तास्मि रामाय तदा तस्मिन् स्वयम्वरे ।\nअनुरक्तास्मि धर्मेण पतिं वीर्यवतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000195054, "chapter_id": 9195, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे अष्टादशोत्तरशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]