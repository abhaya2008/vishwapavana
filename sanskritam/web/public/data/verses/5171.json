[{"id": 2195776, "chapter_id": 5171, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195777, "chapter_id": 5171, "verse_number": "१", "content_sanskrit": "कथं तौ भगवन् शक्यौ मया वारणकच्छपौ ।\nयुगपद् ग्रहीतुं तन्मे त्वमुपायं वक्तुमर्हसि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195778, "chapter_id": 5171, "verse_number": "", "content_sanskrit": "कश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195779, "chapter_id": 5171, "verse_number": "२", "content_sanskrit": "योद्धुकामे गजे तस्मिन् मुहूर्तं स जलेचरः ।\nउत्तिष्ठति जलात् तूर्णं योद्धुकामः पुनः पुनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195780, "chapter_id": 5171, "verse_number": "३", "content_sanskrit": "जलजं निर्जलं तात प्रमत्तं चैव वारणम् ।\nग्रहीष्यसि पतङ्गेश नान्यो योगोऽत्र विद्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195781, "chapter_id": 5171, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195782, "chapter_id": 5171, "verse_number": "४", "content_sanskrit": "इत्येवमुक्तो विहगस्तद् गत्वा वनमुत्तमम् ।\nददर्श वारणेन्द्रं तं मेघाचलसमप्रभम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195783, "chapter_id": 5171, "verse_number": "५", "content_sanskrit": "तां स नागो गिरेर्वीथिं सम्प्राप्त इव भारत ।\nस तं दृष्ट्वा महाभागः सम्प्रहृष्टतनूरुहः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195784, "chapter_id": 5171, "verse_number": "६", "content_sanskrit": "बिभक्षयिषतो राजन् दारुणस्य महात्मनः ।\nमातङ्गं कच्छपं चैव प्रहर्षः सुमहानभूत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195785, "chapter_id": 5171, "verse_number": "७", "content_sanskrit": "अथ वेगेन महता खेचरः स महाबलः ।\nसङ्कुच्य सर्वगात्राणि कृच्छ्रेणैवान्वपद्यत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195786, "chapter_id": 5171, "verse_number": "८", "content_sanskrit": "तथा गत्वा तमध्वानं वारणप्रवरो बली ।\nनिशस्वास महाश्वासः श्रमाद् विश्रमणाय च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195787, "chapter_id": 5171, "verse_number": "९", "content_sanskrit": "तस्य निश्वासवातेन मदगन्धेन चैव ह ।\nउदतिष्ठत् महाकूर्मो वारणप्रतिषेधकः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2195788, "chapter_id": 5171, "verse_number": "१०", "content_sanskrit": "तयोः सुतुमुलं युद्धं ददर्श पतगेश्वरः ।\nकच्छपेन्द्रद्विरदयोरिन्द्रप्रह्लादयोरिव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2195789, "chapter_id": 5171, "verse_number": "११", "content_sanskrit": "स्पृशन्तमग्रहस्तेन तोयं वारणयूथपम् ।\nदन्तैर्नखैश्च जलजो वारयामास भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2195790, "chapter_id": 5171, "verse_number": "१२", "content_sanskrit": "जलजं वारणोऽप्येवं चरणैः पुष्करेण च ।\nप्रत्यषेधन्निमज्जन्तमुन्मज्जन्तं तथैव च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2195791, "chapter_id": 5171, "verse_number": "१३", "content_sanskrit": "मुहूर्तमभवद् युद्धं तयोर्भीमप्रदर्शनम् ।\nअथ तस्माज्जलाद् राजन् कच्छपः स्थलमास्थितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2195792, "chapter_id": 5171, "verse_number": "१४", "content_sanskrit": "स तु नागः प्रभग्नोऽपि पिपासुर्न न्यवर्तत ।\nतोयगृध्नुः शनैस्तर्षादपासर्पत पृष्ठतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2195793, "chapter_id": 5171, "verse_number": "१५", "content_sanskrit": "तं दृष्ट्वा जलजस्तूर्णमपसर्पन्तमाहवात् ।\nअभिदुद्राव वेगेन वज्रपाणिरिवासुरम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2195794, "chapter_id": 5171, "verse_number": "१६", "content_sanskrit": "तं रोषात् स्थलमुत्तीर्णमसम्प्राप्तं गजोत्तमम् ।\nउभावेव समस्तौ तु जग्राह विनतासुतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2195795, "chapter_id": 5171, "verse_number": "१७", "content_sanskrit": "चरणेन तु सव्येन जग्राह स गजोत्तमम् ।\nप्रस्पन्दमानं बलवान् दक्षिणेन तु कच्छपम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2195796, "chapter_id": 5171, "verse_number": "१८", "content_sanskrit": "उत्पपात ततस्तूर्णं पन्नगेन्द्रनिषूदनः ।\nदिवं खं च समुत्पत्य पक्षाभ्यामपराजितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2195797, "chapter_id": 5171, "verse_number": "१९", "content_sanskrit": "तेन चोत्पतता तूर्णं सङ्गृहीतो नखैर्भृशम् ।\nवज्रगर्भैः सुनिशितैः प्राणांस्तूर्णं मुमोचतुः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2195798, "chapter_id": 5171, "verse_number": "२०", "content_sanskrit": "तौ गृह्य बलवांस्तूर्णं स्रस्तपादशिरोधरौ ।\nविवल्गन्निव खे क्रीडन् खेचरोऽभिजगाम ह\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2195799, "chapter_id": 5171, "verse_number": "२१", "content_sanskrit": "अत्तुकामस्ततो वीरः पृथिव्यां पृथिवीपते ।\nनिरैक्षत न चापश्यद् द्रुमं पर्याप्तमासितुम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2195800, "chapter_id": 5171, "verse_number": "२२", "content_sanskrit": "नैमिशं त्वथ सम्प्राप्य देवारण्यं महाद्युतिः ।\nअपश्यत द्रुमं कञ्चिच्छाखास्कन्धसमावृतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2195801, "chapter_id": 5171, "verse_number": "२३", "content_sanskrit": "हिमवच्छिखरप्रख्यं योजनद्वयमुच्छ्रितम् ।\nपरिणाहेन राजेन्द्र नल्वमात्रं समन्ततः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2195802, "chapter_id": 5171, "verse_number": "२४", "content_sanskrit": "तस्य शाखाऽभवत् काचिदायता पञ्चयोजनम् ।\nदृढमूला दृढस्कन्धा वज्रपत्रसमाचिता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2195803, "chapter_id": 5171, "verse_number": "२५", "content_sanskrit": "तत्रोपविष्टः सहसा वैनतेयो निगृह्य तौ ।\nअत्तुकामस्ततः शाखा तस्य वेगादवापतत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2195804, "chapter_id": 5171, "verse_number": "२६", "content_sanskrit": "तां पतन्तीमभिप्रेक्ष्य प्रेक्ष्य चार्षिगणानथ ।\nआसीनान् वसुभिः सार्धं सत्रेण जगतीपते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2195805, "chapter_id": 5171, "verse_number": "२७", "content_sanskrit": "वैखानसान्नाम यतीन् वालखिल्यगणानपि ।\nतस्य भीराविशत् तत्र पतगेन्द्रस्य भारत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2195806, "chapter_id": 5171, "verse_number": "२८", "content_sanskrit": "तान् दृष्ट्वा स यतींस्तत्र समासीनान् सुरैः सह ।\nतुण्डेन गृह्य तां शाखामुत्पपात खगेश्वरः ।\nतौ च पक्षी भुजङ्गाशो व्योम्नि क्रीडन्निवाव्रजत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2195807, "chapter_id": 5171, "verse_number": "२९", "content_sanskrit": "तं दृष्ट्वा गुरुसम्भारं प्रगृह्योत्पतितं खगम् ।\nऋषयस्तेऽब्रुवन् सर्वे गरुडोऽयमिति स्म ह ।\nन त्वन्यः क्षमते कश्चिद् यथाऽयं वीर्यवान् खगः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2195808, "chapter_id": 5171, "verse_number": "३०", "content_sanskrit": "असौ गच्छति धर्मात्मा गुरुभारसमन्वितः ।\nअयं क्रीडन्निवाकाशे तस्माद् गरुड एव सः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2195809, "chapter_id": 5171, "verse_number": "३१", "content_sanskrit": "एवं ते समयं सर्वे वसवश्च दिवौकसः ।\nअकार्षुः पक्षिराजस्य गरुडेत्येव नाम ह\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2195810, "chapter_id": 5171, "verse_number": "३२", "content_sanskrit": "स पक्षी पृथिवीं सर्वां परिधावंस्ततस्ततः ।\nमुमुक्षुः शाखिनः शाखां न स्म देशमपश्यत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2195811, "chapter_id": 5171, "verse_number": "३३", "content_sanskrit": "स वाचमशृणोद् दिव्यामुपर्युपरि जल्पतः ।\nदेवदूतस्य विस्पष्टामाभाष्य गरुडेति च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2195812, "chapter_id": 5171, "verse_number": "३४", "content_sanskrit": "वैनतेय कुविन्देषु समुद्रान्ते महाबल ।\nपात्यतां शाखिनः शाखा न हि ते धर्मनिश्चयाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2195813, "chapter_id": 5171, "verse_number": "३५", "content_sanskrit": "तच्छ्रुत्वा गरुडस्तूर्णं जगाम लवणाम्भसः ।\nउद्देशं यत्र ते मन्दाः कुविन्दाः पापकर्मिणः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2195814, "chapter_id": 5171, "verse_number": "३६", "content_sanskrit": "ततो गत्वा ततः शाखां मुमोच पततांवरः ।\nतया हता जनपदास्तदा षड्त्रिंशतो नृप\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2195815, "chapter_id": 5171, "verse_number": "३७", "content_sanskrit": "स देशो राजशार्दूल ख्यातः परमदारुणः ।\nशाखापतन इत्येव कुविन्दानां दुरात्मनाम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2195816, "chapter_id": 5171, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडोपाख्याने शाखामोक्षो नाम द्वाविंशोऽध्यायः ॥२२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]