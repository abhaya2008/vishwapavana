[{"id": 2005700, "chapter_id": 1112, "verse_number": "१-११३-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005701, "chapter_id": 1112, "verse_number": "१-११३-१", "content_sanskrit": "जामदग्न्येन रामेण पितुर्वधममृष्यता।\nराजा परशुना पूर्वं हैहयाधिपतिर्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005702, "chapter_id": 1112, "verse_number": "१-११३-२", "content_sanskrit": "शतानि दशबाहूनां निकृत्तान्यर्जुनस्य वै।\nलोकस्याचरितो धर्मस्तेनाति किल दुश्चरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005703, "chapter_id": 1112, "verse_number": "१-११३-३", "content_sanskrit": "पुनश्च धनुरादाय महास्त्राणि प्रमुञ्चता।\nनिर्दग्धं क्षत्रमसकृद्रथेन जयता महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005704, "chapter_id": 1112, "verse_number": "१-११३-४", "content_sanskrit": "एवमुच्चावचैरस्त्रैर्भार्गवेण महात्मना।\nत्रिःसप्तकृत्वः पृथिवी कृता निःक्षत्रिया पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005705, "chapter_id": 1112, "verse_number": "१-११३-५", "content_sanskrit": "एवं निःक्षत्रिये लोके कृते तेन महर्षिणा।\nततः संभूय सर्वाभिः क्षत्रियाभिः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005706, "chapter_id": 1112, "verse_number": "१-११३-६", "content_sanskrit": "उत्पादितान्यपत्यानि ब्राह्मणैर्वेदपारगैः।\nपाणिग्राहस्य तनय इति वेदेषु निश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005707, "chapter_id": 1112, "verse_number": "१-११३-७", "content_sanskrit": "धर्मं मनसि संस्थाप्य ब्राह्मणांस्ताः समभ्ययुः।\nलोकेऽप्याचरितो दृष्टः क्षत्रियाणां पुनर्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005708, "chapter_id": 1112, "verse_number": "१-११३-८", "content_sanskrit": "ततः पुनः समुदितं क्षत्रं समभवत्तदा।\nइमं चैवात्र वक्ष्येऽहमितिहासं पुरातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005709, "chapter_id": 1112, "verse_number": "१-११३-९", "content_sanskrit": "अथोचथ्य इति ख्यात आसीद्धीमानृषिः पुरा।\nममता नाम तस्यासीद्भार्या परमसंमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005710, "chapter_id": 1112, "verse_number": "१-११३-१०", "content_sanskrit": "उचथ्यस्य यवीयांस्तु पुरोधास्त्रिदिवौकसाम्।\nबृहस्पतिर्बृहत्तेजा ममतामन्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005711, "chapter_id": 1112, "verse_number": "१-११३-११", "content_sanskrit": "उवाच ममता तं तु देवरं वदतां वरम्।\nअन्तर्वत्नी त्वहं भ्रात्रा ज्येष्ठेनारम्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005712, "chapter_id": 1112, "verse_number": "१-११३-१२", "content_sanskrit": "अयं च मे महाभाग कुक्षावेव बृहस्पते।\nऔचथ्यो देवमत्रापि षडङ्गं प्रत्यधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005713, "chapter_id": 1112, "verse_number": "१-११३-१३", "content_sanskrit": "अमोघरेतास्त्वं चापि द्वयोर्नास्त्यत्र संभवः।\nतस्मादेवं गते त्वद्य उपारमितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005714, "chapter_id": 1112, "verse_number": "१-११३-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005715, "chapter_id": 1112, "verse_number": "१-११३-१४", "content_sanskrit": "एवमुक्तस्तदा सम्यक् बृहस्पतिरुदारधीः।\nकामात्मानं तदात्मानं न शशाक नियच्छितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005716, "chapter_id": 1112, "verse_number": "१-११३-१५", "content_sanskrit": "स बभूव ततः कामी तया सार्धमकामया।\nउत्सृजन्तं तु तं रेतः स गर्भस्थोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005717, "chapter_id": 1112, "verse_number": "१-११३-१६", "content_sanskrit": "भोस्तात मा गमः कामं द्वयोर्नास्तीह संभवः।\nअल्पावकाशो भगवन्पूर्वं चाहमिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005718, "chapter_id": 1112, "verse_number": "१-११३-१७", "content_sanskrit": "अमोघरेताश्च भवान्न पीडां कर्तुमर्हति।\nअश्रुत्वैव तु तद्वाक्यं गर्भस्थस्य बृहस्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005719, "chapter_id": 1112, "verse_number": "१-११३-१८", "content_sanskrit": "जगाम मैथुनायैव ममतां चारुलोचनाम्।\nशुक्रोत्सर्गं ततो बुद्ध्वा तस्या गर्भगतो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005720, "chapter_id": 1112, "verse_number": "१-११३-१९", "content_sanskrit": "पद्भ्यामारोधयन्मार्गं शुक्रस्य च बृहस्पतेः।\nस्थानमप्राप्तमथ तच्छुक्रं प्रतिहतं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005721, "chapter_id": 1112, "verse_number": "१-११३-२०", "content_sanskrit": "पपात सहसा भूमौ ततः क्रुद्धो बृहस्पतिः।\nतं दृष्ट्वा पतितं शुक्रं शशाप स रुषान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005722, "chapter_id": 1112, "verse_number": "१-११३-२१", "content_sanskrit": "उचथ्यपुत्रं गर्भस्थं निर्भर्त्स्य भगवानृषिः।\nयन्मां त्वमीदृशे काले सर्वभूतेप्सिते सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005723, "chapter_id": 1112, "verse_number": "१-११३-२२", "content_sanskrit": "एवमात्थ वचस्तस्मात्तमो दीर्घं प्रवेक्ष्यसि।\nस वै दीर्घतमा नाम शापादृषिरजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005724, "chapter_id": 1112, "verse_number": "१-११३-२३", "content_sanskrit": "बृहस्पतेर्बृहत्कीर्तेर्बृहस्पतिरिवौजसा।\nजात्यन्धो वेदवित्प्राज्ञः पत्नीं लेभे स विद्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005725, "chapter_id": 1112, "verse_number": "१-११३-२४", "content_sanskrit": "तरुणीं रुपसंपन्नां प्रद्वेषीं नाम ब्राह्मणीम्।\nस पुत्राञ्जनयामास गौतमादीन्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005726, "chapter_id": 1112, "verse_number": "१-११३-२५", "content_sanskrit": "ऋषेरुचथ्यस्य तदा सन्तानकुलवृद्धये।\nधर्मात्मा च महात्मा च वेदवेदाङ्गपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005727, "chapter_id": 1112, "verse_number": "१-११३-२६", "content_sanskrit": "गोधर्मं सौरभेयाच्च सोऽधीत्य निखिलं मुनिः।\nप्रावर्तत तदा कर्तुं श्रद्धावांस्तमशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005728, "chapter_id": 1112, "verse_number": "१-११३-२७", "content_sanskrit": "ततो वितथमर्यादं तं दृष्ट्वा मुनिसत्तमाः।\nक्रुद्धा मोहाभिभूतास्ते सर्वे तत्राश्रमौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005729, "chapter_id": 1112, "verse_number": "१-११३-२८", "content_sanskrit": "अहोऽयं भिन्नमर्यादो नाश्रमे वस्तुमर्हति।\nतस्मादेनं वयं सर्वे पापात्मानं त्यजामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005730, "chapter_id": 1112, "verse_number": "१-११३-२९", "content_sanskrit": "इत्यन्योन्यं समाभाष्य ते दीर्घतमसं मुनिम्।\nपुत्रलाभाच्च सा पत्नी न तुतोष पतिं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005731, "chapter_id": 1112, "verse_number": "१-११३-३०", "content_sanskrit": "प्रद्विषन्तीं पतिर्भार्यां किं मां द्वेक्षीति चाब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005732, "chapter_id": 1112, "verse_number": "१-११३-३०x", "content_sanskrit": "प्रद्वेष्युवाच।\nभार्याया भरणाद्भर्ता पालनाच्च पतिः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005733, "chapter_id": 1112, "verse_number": "१-११३-३१", "content_sanskrit": "अहं त्वद्भरणाशक्ता जात्यन्धं ससुतं तदा।\nनित्यकालं श्रमेणार्ता न भरेयं महातपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005734, "chapter_id": 1112, "verse_number": "१-११३-३२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005735, "chapter_id": 1112, "verse_number": "१-११३-३२", "content_sanskrit": "तस्मास्तद्वचनं श्रुत्वा ऋषिः कोपसमन्वितः।\nप्रत्युवाच ततः पत्नीं प्रद्वेषीं ससुतां तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005736, "chapter_id": 1112, "verse_number": "१-११३-३३", "content_sanskrit": "नीयतां क्षत्रियकुले धनार्थश्च भविष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005737, "chapter_id": 1112, "verse_number": "१-११३-३३x", "content_sanskrit": "प्रद्वेष्युवाच।\nत्वया दत्तं धनं विप्र नेच्छेयं दुःखकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005738, "chapter_id": 1112, "verse_number": "१-११३-३४", "content_sanskrit": "यथेष्टं कुरु विप्रेन्द्र न भेरयं पुरा यथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005739, "chapter_id": 1112, "verse_number": "१-११३-३४x", "content_sanskrit": "दीर्घतमा उवाच।\nअद्यप्रभृति मर्यादा मया लोके प्रतिष्ठिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005740, "chapter_id": 1112, "verse_number": "१-११३-३५", "content_sanskrit": "एक एव पतिर्नार्या यावज्जीवं परायणम्।\nमृते जीवति वा तस्मिन्नापरं प्राप्नुयान्नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005741, "chapter_id": 1112, "verse_number": "१-११३-३६", "content_sanskrit": "अभिगम्य परं नारी पतिष्यति न संशयः।\nअपतीनां तु नारीणामद्यप्रभृति पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005742, "chapter_id": 1112, "verse_number": "१-११३-३७", "content_sanskrit": "यद्यस्ति चेद्धनं सर्वं वृथाभोगा भवन्तु ताः।\nअकीर्तिः परिवादाश्च नित्यं तासां भवन्तु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005743, "chapter_id": 1112, "verse_number": "१-११३-३८", "content_sanskrit": "इति तद्वचनं श्रुत्वा ब्राह्मणी भृशकोपिता।\nगङ्गायां नीयतामेष पुत्रा इत्येवमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005744, "chapter_id": 1112, "verse_number": "१-११३-३९", "content_sanskrit": "लोभमोहाभिभूतास्ते पुत्रास्तं गौतमादयः।\nवद्ध्वोडुपे परिक्षिप्य गङ्गायां समवासृजन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2005745, "chapter_id": 1112, "verse_number": "१-११३-४०", "content_sanskrit": "कस्मादन्धश्च वृद्धश्च भर्तव्योऽयमिति स्म ते।\nचिन्तयित्वा ततः क्रूराः प्रतिजग्मुरथो गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2005746, "chapter_id": 1112, "verse_number": "१-११३-४१", "content_sanskrit": "सोऽनुस्रोतस्तदा विप्रः प्लवमानो यदृच्छया।\nजगाम सुबहून्देशानन्धस्तेनोडुपेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2005747, "chapter_id": 1112, "verse_number": "१-११३-४२", "content_sanskrit": "तं तु राजा बलिर्नाम सर्वधर्मविदां वरः।\nअपश्यन्मज्जनगतः स्रोतसाऽभ्याशमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2005748, "chapter_id": 1112, "verse_number": "१-११३-४३", "content_sanskrit": "जग्राह चैनं धर्मात्मा बलिः सत्यपराक्रमः।\nज्ञात्वा चैवं स वव्रेऽथ पुत्रार्थे भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2005749, "chapter_id": 1112, "verse_number": "१-११३-४४", "content_sanskrit": "तं पूजयित्वा राजर्षिर्विश्रान्तं मुनिमब्रवीत्।\nसन्तानार्थं महाभाग भार्यासु मम मानद।\nपुत्रान्धर्मार्थकुशलानुत्पादयितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2005750, "chapter_id": 1112, "verse_number": "१-११३-४५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2005751, "chapter_id": 1112, "verse_number": "१-११३-४६", "content_sanskrit": "एवमुक्तः स तेजस्वी तं तथेत्युक्तवानृषिः।\nतस्मैस राजा स्वां भार्यां सुदेष्णां प्राहिणोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2005752, "chapter_id": 1112, "verse_number": "१-११३-४६", "content_sanskrit": "अन्धं वृद्धं च तं मत्वा न सा देवी जगाम ह।\nस्वां तु धात्रेयिकां तस्मै वृद्धाय प्राहिणोत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2005753, "chapter_id": 1112, "verse_number": "१-११३-४७", "content_sanskrit": "तस्यां काक्षीवदादीन्स शूद्रयोनावृषिस्तदा।\nजनयामास धर्मात्मा पुत्रानेकादशैव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2005754, "chapter_id": 1112, "verse_number": "१-११३-४८", "content_sanskrit": "काक्षीवदादीन्पुत्रांस्तान्दृष्ट्वा सर्वानधीयतः।\nउवाच तमृषिं राजा ममेम इति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2005755, "chapter_id": 1112, "verse_number": "१-११३-४९", "content_sanskrit": "नेत्युवाच महर्षिस्तं ममेम इति चाब्रवीत्।\nशूद्रयोनौ मया हीमे जाताः काक्षीवदादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2005756, "chapter_id": 1112, "verse_number": "१-११३-५०", "content_sanskrit": "अन्धं वृद्धं च मां दृष्ट्वा सुदेष्णा महिषी तव।\nअवमन्य ददौ मूढा शूद्रां धात्रेयिकां मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2005757, "chapter_id": 1112, "verse_number": "१-११३-५१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2005758, "chapter_id": 1112, "verse_number": "१-११३-५१", "content_sanskrit": "ततः प्रसादयामास पुनस्तमृषिसत्तमम्।\nबलिः सुदेष्णां स्वां भार्यां तस्मै स प्राहिणोत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2005759, "chapter_id": 1112, "verse_number": "१-११३-५२", "content_sanskrit": "तां स दीर्घतमाङ्गेषु स्पृष्ट्वा देवीमथाब्रवीत्।\nभविष्यन्ति कुमारास्ते तेजसाऽऽदित्यवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2005760, "chapter_id": 1112, "verse_number": "१-११३-५३", "content_sanskrit": "अङ्गो वङ्गः कलिङ्गश्च पुण्ड्रः सुह्मश्च ते सुताः।\nतेषां देशाः समाख्याताः स्वनामकथिता भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2005761, "chapter_id": 1112, "verse_number": "१-११३-५४", "content_sanskrit": "अङ्गस्याङ्गोऽभवद्देशो वङ्गो वङ्गस्य च स्मृतः।\nकलिङ्गविषयश्चैव कलिङ्गस्य च स स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2005762, "chapter_id": 1112, "verse_number": "१-११३-५५", "content_sanskrit": "पुण्ड्रस्य पुण्ड्राः प्रख्याताः सुह्माः सुह्मस्य च स्मृताः।\nएवं बलेः पुरा वंशः प्रख्यातो वै महर्षिजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2005763, "chapter_id": 1112, "verse_number": "१-११३-५६", "content_sanskrit": "एवमन्ये महेष्वासा ब्राह्मणैः क्षत्रिया भुवि।\nजाताः परमधर्मज्ञा वीर्यवन्तो महाबलाः।\nएतच्छ्रुत्वा त्वमप्यत्र मातः कुरु यथेप्सितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2005764, "chapter_id": 1112, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि त्रयोदशाधिकशततमोऽध्यायः॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]