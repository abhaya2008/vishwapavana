[{"id": 900009074, "chapter_id": 8722, "verse_number": "12.1", "content_sanskrit": "ननु कथमन्विते शक्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009075, "chapter_id": 8722, "verse_number": "12.2", "content_sanskrit": "किं चेश्वरसङ्केतरूपायाः स्वाभाविकसम्बन्धरूपाया वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009076, "chapter_id": 8722, "verse_number": "12.3", "content_sanskrit": "किञ्चैवं शक्यघटसम्बन्धिगुरुत्वादेरपि घटपदात्प्रतीतिप्रसङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009077, "chapter_id": 8722, "verse_number": "12.4", "content_sanskrit": "किं चैवं जातावेव शक्तिः व्यक्तेस्त्वाकाङ्क्षादिवशाद्धीरिति स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009078, "chapter_id": 8722, "verse_number": "12.5", "content_sanskrit": "किं च त्वयाऽपि घटमिति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009079, "chapter_id": 8722, "verse_number": "12.6", "content_sanskrit": "तस्मादन्विते प्राथमिकी व्युत्पत्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009080, "chapter_id": 8722, "verse_number": "12.7", "content_sanskrit": "नन्वन्विताभिधाने घटमानयतीत्यादौ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009081, "chapter_id": 8722, "verse_number": "12.8", "content_sanskrit": "न चैवमपि क्रियापदेनानयनरूपे क्रियाविशेषेऽभिहिते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009082, "chapter_id": 8722, "verse_number": "12.9", "content_sanskrit": "न चैवमपि कारकपदजन्या क्रियासामान्यान्वितरूपविशिष्टधीः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009083, "chapter_id": 8722, "verse_number": "12.10", "content_sanskrit": "नन्वेवं चेत्किमनया सामान्यान्विते शक्त्या..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009084, "chapter_id": 8722, "verse_number": "12.11", "content_sanskrit": "नन्वेवमप्यानयनान्वितो घटो..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009085, "chapter_id": 8722, "verse_number": "12.12", "content_sanskrit": "ननु ज्ञानस्य यद्विषयत्वेन जनकत्वं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009086, "chapter_id": 8722, "verse_number": "12.13", "content_sanskrit": "तस्मात् पर्यायत्वापत्तिः, वैय्यर्थ्यापत्तिः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009087, "chapter_id": 8722, "verse_number": "12.14", "content_sanskrit": "अथ मतम्– अस्त्येवान्वये शक्तिः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009088, "chapter_id": 8722, "verse_number": "12.15", "content_sanskrit": "उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009089, "chapter_id": 8722, "verse_number": "12.16", "content_sanskrit": "अपि च परोक्षज्ञाने..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009090, "chapter_id": 8722, "verse_number": "12.17", "content_sanskrit": "किं च पदार्थांशे शक्तिज्ञानमपि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009091, "chapter_id": 8722, "verse_number": "12.18", "content_sanskrit": "एवं चान्विताभिधाने न केवलं पूर्वोक्तं षट्कम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009092, "chapter_id": 8722, "verse_number": "12.19", "content_sanskrit": "ननु षट्कान्तर्गता व्यक्तिप्रतिबन्दी न युक्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009093, "chapter_id": 8722, "verse_number": "12.20", "content_sanskrit": "एतेन जातिव्यक्त्योस्समानसंवित्संवेद्यतया..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009094, "chapter_id": 8722, "verse_number": "12.21", "content_sanskrit": "न च जातिविशिष्टव्यक्तौ शक्त्यभावे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900009095, "chapter_id": 8722, "verse_number": "12.22", "content_sanskrit": "नच व्यक्तेरन्यलभ्यत्वसम्भवेऽपि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900009096, "chapter_id": 8722, "verse_number": "12.23", "content_sanskrit": "ननु तथाऽपि ज्ञातकरणे सम्बन्धः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900009097, "chapter_id": 8722, "verse_number": "12.24", "content_sanskrit": "न चान्वयस्यापि प्रागुपस्थितौ पदार्थस्येवान्वयस्यापि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900009098, "chapter_id": 8722, "verse_number": "12.25", "content_sanskrit": "एतेन यथा प्रत्यक्षे विशिष्टज्ञाने ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900009099, "chapter_id": 8722, "verse_number": "12.26", "content_sanskrit": "किं च प्रमाणान्तरेऽपि प्रत्यक्षमर्यादानुसरणस्यावशकत्वे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]