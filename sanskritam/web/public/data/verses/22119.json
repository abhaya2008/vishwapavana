[{"id": 7002119000, "chapter_id": 22119, "verse_number": "१६४-१", "content_sanskrit": "नवग्रहहोमः ।\nपुष्कर उवाच ।\nश्रीकामः शान्तिकामो वा ग्रहयज्ञं समारभेत् ।\nवृष्ट्यायुःपुष्टिकामो वा तथैवाभिचरन् पुनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002119001, "chapter_id": 22119, "verse_number": "१६४-२", "content_sanskrit": "सूर्यः सोमो मङ्गलश्च बुधश्चाथ बृहस्पतिः ।\nशुक्रः शनैश्चरो राहुः केतुश्चेति ग्रहाः स्मृताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002119002, "chapter_id": 22119, "verse_number": "१६४-३", "content_sanskrit": "ताम्रकात्स्फटिकाद्रक्तचन्दनात्स्वर्णर्कादुभौ ।\nरजतादयसः शीशात्ग्रहाः कार्याः क्रमादिमे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002119003, "chapter_id": 22119, "verse_number": "१६४-४", "content_sanskrit": "सुवर्णैर्वायजेल्लिख्य गन्धमण्डलकेषु वा ।\nयथावर्णं प्रदेयानि वासांसि कुसुमानि च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002119004, "chapter_id": 22119, "verse_number": "१६४-५", "content_sanskrit": "गन्धाश्च वलयश्चैव धूपो देयस्तु गुग्गुलुः ।\nकर्तव्या मन्त्रयन्तश्च चरवः प्रतिदैवतं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002119005, "chapter_id": 22119, "verse_number": "१६४-६", "content_sanskrit": "आकृष्णेन इमं देवा अग्निर्मूर्धा दिवः ककुत् ।\nउद्बुद्ध्यस्वेति च ऋचो यथासङ्ख्यं प्रकीर्तिताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002119006, "chapter_id": 22119, "verse_number": "१६४-७", "content_sanskrit": "बृहस्पते अतियदर्यस्तथैवाल्पात्परिश्रुतः ।\nशन्नो देवीस्तथा काण्डात्केतुं कृन्वन्निमास्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002119007, "chapter_id": 22119, "verse_number": "१६४-८", "content_sanskrit": "अर्कः पालाशः खदिरो ह्यपामार्गोथ पिप्पलः ।\nउदुम्बरः शमी दूर्वा कुशाश्च समिधः क्रमात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002119008, "chapter_id": 22119, "verse_number": "१६४-९", "content_sanskrit": "एकैकस्यात्राष्टशतमष्टाविंशतिरेव वा ।\nहोतव्या मधुसर्पिर्भ्यां दध्ना चैव समन्विताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002119009, "chapter_id": 22119, "verse_number": "१६४-१०", "content_sanskrit": "गुडौदनं पायसं च हविष्यं क्षीरयष्टिकं ।\nदध्योदनं हविः पूपान्मांसं चित्रान्नमेव च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002119010, "chapter_id": 22119, "verse_number": "१६४-११", "content_sanskrit": "दद्याद्ग्रहक्रमदेतद्द्विजेभ्यो भोजनं बुधः ।\nशक्तितो वा यथालाभं सत्कृत्य विधिपूर्वकं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002119011, "chapter_id": 22119, "verse_number": "१६४-१२", "content_sanskrit": "धेनुः शङ्खस्तथानड्वान् हेम वासो हयस्तथा ।\nकृष्णा गौरायसश्छाग एता वै दक्षिणाः क्रमात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002119012, "chapter_id": 22119, "verse_number": "१६४-१३", "content_sanskrit": "यश्च यस्य यदा दूष्यः स तं यत्नेन पूजयेत् ।\nब्रह्मणैषां वरो दत्तः पूजिताः पूजितस्य च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002119013, "chapter_id": 22119, "verse_number": "१६४-१४", "content_sanskrit": "ग्रहाधीना नरेन्द्राणा मुछ्रयाः पतनानि च ।\nभावभावो च जगतस्तस्मात्पूज्यतमा ग्रहाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]