[{"id": 7004925000, "chapter_id": 24925, "verse_number": "७-१-१०८-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि वसूनां लिंगमुत्तमम् ।\nसोमेशादीशदिग्भागे पञ्चाशद्धनुषान्तरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004925001, "chapter_id": 24925, "verse_number": "७-१-१०८-२", "content_sanskrit": "स्थितं लिंगं महादेवि चतुर्वक्त्रं सुरप्रियम् ।\nप्रत्यूषेश्वरनामानं महापातकनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004925002, "chapter_id": 24925, "verse_number": "७-१-१०८-३", "content_sanskrit": "दर्शनात्तस्य देवस्य सप्तजन्मान्तरोद्भवम् ।\nपापं प्रणाशमायाति सत्यंसत्यं वरानने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004925003, "chapter_id": 24925, "verse_number": "७-१-१०८-४", "content_sanskrit": "देव्युवाच ।\nकोऽसौ प्रत्यूषनामेति कथं लिंगं प्रतिष्ठितम् ।\nकस्य पुत्रः स विख्यात एतन्मे वद शंकर ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004925004, "chapter_id": 24925, "verse_number": "७-१-१०८-५", "content_sanskrit": "ईश्वर उवाच ।\nदक्षो ब्रह्मसुतो देवि प्रजापतिरिति स्मृतः ।\nतस्य कन्याः पुरा षष्टिर्ददौ धर्माय वै दश ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004925005, "chapter_id": 24925, "verse_number": "७-१-१०८-६", "content_sanskrit": "तासां मध्ये महादेवि एका विश्वेति विश्रुता ।\nसा धर्माच्च महादेवि अष्टावजनयत्सुतान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004925006, "chapter_id": 24925, "verse_number": "७-१-१०८-७", "content_sanskrit": "आपो ध्रुवश्च सोमश्च धरश्चैवाऽनलोऽनिलः ।\nप्रत्यूषश्च प्रभासश्च वसवोऽष्टौ प्रकीर्तिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004925007, "chapter_id": 24925, "verse_number": "७-१-१०८-८", "content_sanskrit": "तेषां मध्ये सप्तमोऽसौ प्रत्यूष इति विश्रुतः ।\nस पुत्रकामो देवेशि प्रभासं क्षेत्रमागतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004925008, "chapter_id": 24925, "verse_number": "७-१-१०८-९", "content_sanskrit": "स ज्ञात्वा कामिकं क्षेत्रं प्रतिष्ठाप्य महेश्वरम् ।\nतपश्चचार विपुलं दिव्यं वर्षशतं प्रिये ।\nध्यायन्देवं महादेवं शान्तस्तद्गतमानसः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004925009, "chapter_id": 24925, "verse_number": "७-१-१०८-१०", "content_sanskrit": "ततस्तुष्टो महादेवस्तस्य भक्त्या निरञ्जनः ।\nददौ तस्य सुतं देवि देवलं योगिनां वरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004925010, "chapter_id": 24925, "verse_number": "७-१-१०८-११", "content_sanskrit": "ततः प्रभृति देवेशि तल्लिंगस्य प्रभावतः ।\nदेवलो भगवान्योगी प्रत्यूषस्याऽभवत्सुतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004925011, "chapter_id": 24925, "verse_number": "७-१-१०८-१२", "content_sanskrit": "अनेन कारणेनासौ प्रत्यूषेश्वरसंज्ञितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004925012, "chapter_id": 24925, "verse_number": "७-१-१०८-१३", "content_sanskrit": "यश्चानपत्यः पुरुषस्तं समाराधयिष्यति ।\nतस्यान्ववाये देवेशि संततिर्न विनश्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004925013, "chapter_id": 24925, "verse_number": "७-१-१०८-१४", "content_sanskrit": "यः प्रत्यूषे महादेवि प्रत्यूषेश्वरमुत्तमम् ।\nपूजयिष्यति सद्भक्त्या सततं नियतात्मवान् ।\nतस्यैष्यति क्षयं पापमपि ब्रह्मवधोद्भवम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004925014, "chapter_id": 24925, "verse_number": "७-१-१०८-१५", "content_sanskrit": "वृषस्तत्रैव दातव्यः सम्यग्यात्राफलेप्सुभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004925015, "chapter_id": 24925, "verse_number": "७-१-१०८-१६", "content_sanskrit": "माघे कृष्णचतुर्द्दश्यां जागृयात्तत्र वै निशि ।\nसर्वेषां दानयज्ञानां फलं जागरणाल्लभेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004925016, "chapter_id": 24925, "verse_number": "७-१-१०८-१७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखंडे प्रथमे प्रभाससक्षेत्रमाहात्म्ये प्रत्यूषेश्वरमाहात्म्यवर्णनंनामाष्टोत्तरशततमोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]