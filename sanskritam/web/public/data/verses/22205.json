[{"id": 7002205000, "chapter_id": 22205, "verse_number": "२५०-१", "content_sanskrit": "अग्निरुवाच ।\nपूर्णायतं द्विजः कृत्वा ततो मांसैर्गदायूधान् ।\nसुनिर्धौतं धनुः कृत्वा यज्ञभूमौ विधापयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002205001, "chapter_id": 22205, "verse_number": "२५०-२", "content_sanskrit": "ततो वाणं समागृह्य दंशितः सुसमाहितः ।\nबध्नीयाद्दृढां कक्षाञ्च दक्षिणाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002205002, "chapter_id": 22205, "verse_number": "२५०-३", "content_sanskrit": "विलक्षअयमपि तद्वाणं तत्र चैव सुसंस्थितं ।\nततः समुद्धरेद्वाणं तूणाद्दक्षिणपाणिना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002205003, "chapter_id": 22205, "verse_number": "२५०-४", "content_sanskrit": "तेनैव सहितं मध्ये शरं सङ्गृह्य धारयेत् ।\nवामहस्तेन वै कक्षां धनुस्तस्मात्समुद्धरेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002205004, "chapter_id": 22205, "verse_number": "२५०-५", "content_sanskrit": "अविषण्णमतिर्भूत्वा गुणे पुङ्खं निवेशयेत् ।\nसम्पीड्य सिंहकर्णेन पुङ्खेनापि समे दृढं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002205005, "chapter_id": 22205, "verse_number": "२५०-६", "content_sanskrit": "वामकर्णोपविष्टञ्च फलं वामस्य धारयेत् ।\nवर्णान् मध्यमया तत्र वामाङ्गुल्या च धारयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002205006, "chapter_id": 22205, "verse_number": "२५०-७", "content_sanskrit": "मनो लक्ष्यगतं कृत्वा मुष्टिना च विधानवित् ।\nदक्षिणे गात्रभागो तु कृत्वा वर्णं विमोक्षयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002205007, "chapter_id": 22205, "verse_number": "२५०-८", "content_sanskrit": "ललाटपुटसंस्थानं दण्डं लक्ष्ये निवेशयेत् ।\nआकृष्य ताड़येत्तत्र चन्द्रकं षोड़शङ्गुलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002205008, "chapter_id": 22205, "verse_number": "२५०-९", "content_sanskrit": "मुक्त्वा वाणं ततः पश्चादुल्काशिक्षस्तदा तया ।\nनिगृह्णीयानुमध्यमया ततोऽङ्गुल्या पुनः पुनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002205009, "chapter_id": 22205, "verse_number": "२५०-१०", "content_sanskrit": "अक्षिलक्ष्यं क्षिपेत्तूणाच्चतुरस्रञ्च दक्षिणम् ।\nचतुरस्रगतं वेध्यमभ्यसेच्चादितः स्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002205010, "chapter_id": 22205, "verse_number": "२५०-११", "content_sanskrit": "तस्मादनन्तरं तीक्ष्णं परवृत्तं गतञ्च यत् ।\nनिम्नमुन्नतवेधञ्च अभ्यसेत् क्षिप्रकन्ततः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002205011, "chapter_id": 22205, "verse_number": "२५०-१२", "content_sanskrit": "वेध्यस्थानेष्वथैतेषु सत्त्वस्य पुटकाद्धनुः ।\nहस्तावापशतैश्चित्रैस्तर्ज्जयेद्दुस्तरैरपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002205012, "chapter_id": 22205, "verse_number": "२५०-१३", "content_sanskrit": "तस्मिन् वेध्यगते विप्र द्वे वेध्ये दृढसंज्ञके ।\nद्वे वेध्ये दुष्करे वेध्ये द्वे तथा चित्रदुष्करे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002205013, "chapter_id": 22205, "verse_number": "२५०-१४", "content_sanskrit": "न तु निम्नञ्च तीक्ष्णञ्च दृढवेध्ये प्रकीर्त्तिते ।\nनिम्नं दुष्करमुद्दिष्टं वेध्यमूद्र्ध्वगतञ्च यत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002205014, "chapter_id": 22205, "verse_number": "२५०-१५", "content_sanskrit": "मस्तकायनमध्ये तु चित्रदुष्करसञ्ज्ञके ।\nएवं वेध्यगणङ्कृत्वा दक्षिणेनेतरेण च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002205015, "chapter_id": 22205, "verse_number": "२५०-१६", "content_sanskrit": "आरोहेत् प्रथमं वीरो जितलक्षस्ततो नरः ।\nएष एव विधिः प्रोक्तस्तत्र दृष्टः प्रयोक्तृभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002205016, "chapter_id": 22205, "verse_number": "२५०-१७", "content_sanskrit": "अधिकं भ्रमणं तस्य तस्माद् वेध्यात् प्रकीर्त्तितम् ।\nलक्ष्यं स योजयेत्तत्र पत्रिपत्रगतं दृढम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002205017, "chapter_id": 22205, "verse_number": "२५०-१८", "content_sanskrit": "भ्रान्तं प्रचलिचञ्चैव स्थिरं यच्च भवेदति ।\nसमन्तात्ताडयेद् भिन्द्याच्छेदयेद्व्यथयेदपि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002205018, "chapter_id": 22205, "verse_number": "२५०-१९", "content_sanskrit": "कर्म्मयोगविधानज्ञो ज्ञात्वैवं विधिमाचरेत् ।\nमनसा चक्षुषा दृष्ट्या योगरिक्षुर्यमं जयेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]