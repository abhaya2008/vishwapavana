[{"id": 7003517000, "chapter_id": 23517, "verse_number": "१५७-१", "content_sanskrit": "अथ मलयार्जुनतीर्थादिस्नानादिप्रशंसा ।\nश्रीवराह उवाच ।\nयमुनापारमुल्लङ्घ्य तत्रैव च महामुने ।\nमलयार्जुनकं तीर्थं कुण्डं तत्र च विद्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003517001, "chapter_id": 23517, "verse_number": "१५७-२", "content_sanskrit": "पर्यस्तं तत्र शकटं भिन्नभाण्डकुटीघटम् ।\nतत्र स्नानोपवासाभ्यामनन्तं फलमश्रुते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003517002, "chapter_id": 23517, "verse_number": "१५७-३", "content_sanskrit": "द्वादश्यां शुक्लपक्षस्य ज्येष्ठमासे वसुन्धरे ।\nतत्र स्नानेन दानेन महापातकनाशनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003517003, "chapter_id": 23517, "verse_number": "१५७-४", "content_sanskrit": "ज्येष्ठस्य शुक्लद्वादश्यां स्नात्वा सुनियतेन्द्रियः ।\nमथुरायां हरिं दृष्ट्वा प्राप्नोति परमां गतिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003517004, "chapter_id": 23517, "verse_number": "१५७-५", "content_sanskrit": "यमुनासलिले स्नातः शुचिर्भूत्वा जितेन्द्रियः ।\nसमभ्यर्च्याच्युतं सम्यक्प्राप्नोति परमां गतिम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003517005, "chapter_id": 23517, "verse_number": "१५७-६", "content_sanskrit": "अपि चास्मत्कुले जातः कालिन्दीसलिले प्लुतः ।\nअर्चयिष्यति गोविन्दं मथुरायामुपोषितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003517006, "chapter_id": 23517, "verse_number": "१५७-७", "content_sanskrit": "इति गायन्ति पितरः परलोकगताः सदा ।\nद्वादश्यां ज्येष्ठमासे तु समभ्यर्च्य जनार्दनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003517007, "chapter_id": 23517, "verse_number": "१५७-८", "content_sanskrit": "धन्योऽसौ पिण्डनिर्वापं यमुनायां करिष्यति ।\nतत्रैव तु महातीर्थे वने बहुलसंज्ञके ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003517008, "chapter_id": 23517, "verse_number": "१५७-९", "content_sanskrit": "तत्र स्नातो नरो देवि रुद्रलोके महीयते ।\nद्वादश्यां चैत्रमासे तु शुक्लपक्षे वसुन्धरे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003517009, "chapter_id": 23517, "verse_number": "१५७-१०", "content_sanskrit": "तत्र स्नातो नरो याति मम लोकं न संशयः ।\nअस्ति भाण्डह्रदं नाम परपारेषु दुर्ल्लभम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003517010, "chapter_id": 23517, "verse_number": "१५७-११", "content_sanskrit": "दृश्यन्तेऽहरहस्तत्र आदित्याः शुभकारिणः ।\nतत्र चार्कस्थले कुण्डे स्नानं यः कुरुते नरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003517011, "chapter_id": 23517, "verse_number": "१५७-१२", "content_sanskrit": "सर्वपापविनिर्मुक्तः सूर्यलोकं व्रजेन्नरः ।\nतत्राथ मुञ्चते प्राणान्मम लोकं स गच्छति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003517012, "chapter_id": 23517, "verse_number": "१५७-१३", "content_sanskrit": "अर्कस्थलसमीपे तु कूपं तु विमलोदकम् ।\nसप्तसामुद्रिकं नाम देवानामपि दुर्ल्लभम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003517013, "chapter_id": 23517, "verse_number": "१५७-१४", "content_sanskrit": "तत्र स्नानेन वसुधे स्वच्छन्दगमनालयः ।\nअथात्र मुंचते प्राणान्मम लोकं स गच्छति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003517014, "chapter_id": 23517, "verse_number": "१५७-१५", "content_sanskrit": "तत्र वीरस्थलं नाम क्षेत्रं गुह्यं परं मम ।\nआसन्नसलिलं चैव पद्मोत्पलविभूषितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003517015, "chapter_id": 23517, "verse_number": "१५७-१६", "content_sanskrit": "यस्तत्र कुरुते स्नानमेकरात्रोषितो नरः ।\nस मत्प्रसादात्सुश्रोणि वीरलोके महीयते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003517016, "chapter_id": 23517, "verse_number": "१५७-१७", "content_sanskrit": "अथाऽत्र मुञ्चते प्राणान्ममलोकं स गच्छति ।\nकुशस्थलं च तत्रैव पुण्यं पापहरं शुभम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003517017, "chapter_id": 23517, "verse_number": "१५७-१८", "content_sanskrit": "तत्र स्नातो नरो देवि ब्रह्मलोके महीयते।\nअथात्र मुंचते प्राणान्मम लोकं स गच्छति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003517018, "chapter_id": 23517, "verse_number": "१५७-१९", "content_sanskrit": "तत्र पुष्पस्थलं नाम शिवक्षेत्रमनुत्तमम् ।\nतत्र स्नानेन मनुजः शिवलोके महीयते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003517019, "chapter_id": 23517, "verse_number": "१५७-२०", "content_sanskrit": "ख्याता एते पञ्च देशा महापापविनाशनाः ।\nतेषु स्नानेषु वसुधे ब्रह्मणा सह मोदते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003517020, "chapter_id": 23517, "verse_number": "१५७-२१", "content_sanskrit": "तत्र गोपीश्वरो नाम महापातकनाशनः ।\nकृष्णस्य रमणार्थं हि सहस्राणि च षोडश ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003517021, "chapter_id": 23517, "verse_number": "१५७-२२", "content_sanskrit": "गोप्यो रूपाणि चक्रे च तत्र क्रीडनके हरिः ।\nयदा बालेन कृष्णेन भग्नार्जुनयुगं तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003517022, "chapter_id": 23517, "verse_number": "१५७-२३", "content_sanskrit": "शकटं च तदा भिन्नं घटभाण्डकुटीरकम् ।\nताभिस्तत्रैव गोविन्दं क्रीडन्तं च यदृच्छया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003517023, "chapter_id": 23517, "verse_number": "१५७-२४", "content_sanskrit": "परिष्वज्य हि धर्मेण व्याजेन च सुगोपितम् ।\nमातलिस्तत्र चागत्य देवैरुक्तं यथोदितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003517024, "chapter_id": 23517, "verse_number": "१५७-२५", "content_sanskrit": "गोपवेषधरं देवमभिषेकं चकार ह ।\nआनीय सप्त कलशान्रत्नौषधिपरिप्लुतान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003517025, "chapter_id": 23517, "verse_number": "१५७-२६", "content_sanskrit": "गोपीमण्डलपातेन स्नापितो हेमकुण्डलः ।\nगोप्यो गायन्ति नृत्यन्ति कृष्ण कृष्ण इति ब्रुवन् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003517026, "chapter_id": 23517, "verse_number": "१५७-२७", "content_sanskrit": "तत्र गोपीश्वरं देवं मातलिः स्थाप्य पूजितम् ।\nकूपं च स्थापयामास मांगल्यैः   कलशैः शुभैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003517027, "chapter_id": 23517, "verse_number": "१५७-२८", "content_sanskrit": "सप्तसामुद्रिकं नाम कूपं तु विमलोदकम् ।\nदेवस्याग्रे तु वसुधे गोपा यस्य महात्मनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003517028, "chapter_id": 23517, "verse_number": "१५७-२९", "content_sanskrit": "पितरश्चापि नन्दन्ति पानीयं पिण्डमेव च ।\nसप्तसामुद्रिके कूपे यः श्राद्धं संप्रदास्यति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003517029, "chapter_id": 23517, "verse_number": "१५७-३०", "content_sanskrit": "पितरस्तारितास्तेन कुलानां सप्तसप्ततिः ।\nसोमवारे त्वमायां वै पिण्डदानं करोति यः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003517030, "chapter_id": 23517, "verse_number": "१५७-३१", "content_sanskrit": "पितरस्तस्य तृप्यन्ति कोटिवर्षशतान्यलम् ।\nगोविन्दस्य च देवस्य तथा गोपीश्वरस्य च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003517031, "chapter_id": 23517, "verse_number": "१५७-३२", "content_sanskrit": "मध्ये तु मरणं यस्य शक्रस्यैति सलोकताम् ।\nतथा बहुलरुद्रस्य गोविन्दस्यैव मध्यतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003517032, "chapter_id": 23517, "verse_number": "१५७-३३", "content_sanskrit": "तद्वद्ब्रह्माणमाशास्य गोपीशस्यैव मध्यतः ।\nएतेषु स्नानदानेन पिण्डपातेन भामिनि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003517033, "chapter_id": 23517, "verse_number": "१५७-३४", "content_sanskrit": "नरस्तारयते पुंसां दश पूर्वान्दशापरान् ।\nएषु स्नातो नरो देवि देवैश्च सह मोदते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003517034, "chapter_id": 23517, "verse_number": "१५७-३५", "content_sanskrit": "तत्राथ मुञ्चते प्राणान्मम लोकं स गच्छति ।\nवसुपत्रं महातीर्थं   पुण्यं परममुत्तमम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003517035, "chapter_id": 23517, "verse_number": "१५७-३६", "content_sanskrit": "मथुरादक्षिणे पार्श्वे क्षेत्रं फाल्गुनकं तथा ।\nतत्र स्नात्वा च पीत्वा च परलोके महीयते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003517036, "chapter_id": 23517, "verse_number": "१५७-३७", "content_sanskrit": "तत्र फाल्गुनके चैव तीर्थे परमदुर्ल्लभे ।\nवृषभाञ्जनकं नाम क्षेत्रं मे दुर्ल्लभं महत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003517037, "chapter_id": 23517, "verse_number": "१५७-३८", "content_sanskrit": "तत्राभिषेकं यः कुर्यात्स देवैः सह मोदते ।\nतत्र यो मुञ्चते प्राणान्मम लोकं स गच्छति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003517038, "chapter_id": 23517, "verse_number": "१५७-३९", "content_sanskrit": "अस्ति तालवनं नाम धेनुकासुररक्षितम् ।\nमथुरापश्चिमे भागे अदूरादर्द्धयोजनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003517039, "chapter_id": 23517, "verse_number": "१५७-४०", "content_sanskrit": "तत्र कुण्डं स्वच्छजलं नीलोत्पलविभूषितम् ।\nतत्र स्नानेन दानेन वाञ्छितं फलमाप्नुयात्   ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003517040, "chapter_id": 23517, "verse_number": "१५७-४१", "content_sanskrit": "अस्ति संपीठकं नाम अस्मिन् क्षेत्रे परं मम ।\nतत्र कुण्डं विशालाक्षि प्रसन्नसलिलं शुभम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003517041, "chapter_id": 23517, "verse_number": "१५७-४२", "content_sanskrit": "तत्र स्नानं च ये कुर्युरेकरात्रोषिता नराः।\nअग्निष्टोम फलं चैव लभन्ते नात्र संशयः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003517042, "chapter_id": 23517, "verse_number": "१५७-४३", "content_sanskrit": "अथात्र मुञ्चते प्राणान्मम लोकं स गच्छति ।\nदेवकीगर्भसंभूतो वसुदेवगृहे शुभे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003517043, "chapter_id": 23517, "verse_number": "१५७-४४", "content_sanskrit": "तत्र पुण्येन हि मया रविराराधितः शुभः ।\nलब्धः प्राज्ञो मया पुत्रो रूपवांश्च गुणान्वितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003517044, "chapter_id": 23517, "verse_number": "१५७-४५", "content_sanskrit": "तत्रैवं तु ततो दृष्टः पद्महस्तो दिवाकरः ।\nमासि भाद्रपदे देवी तिग्मतेजा विभावसुः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003517045, "chapter_id": 23517, "verse_number": "१५७-४६", "content_sanskrit": "सप्तम्यां कृष्णपक्षस्य रविस्तिष्ठति सर्वदा ।\nतस्मिन्नहनि यः स्नानं कुर्यात्कुण्डे समाहितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003517046, "chapter_id": 23517, "verse_number": "१५७-४७", "content_sanskrit": "न तस्य दुर्ल्लभं लोके सर्वदाता दिवाकरः ।\nआदित्येऽहनि सम्प्राप्ते सप्तम्यां तु वसुन्धरे ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003517047, "chapter_id": 23517, "verse_number": "१५७-४८", "content_sanskrit": "नरो वाप्यथवा नारी प्राप्नोत्यविकलं फलम् ।\nतत्रैव तु तपस्तप्तं राज्ञा शन्तनुना पुरा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003517048, "chapter_id": 23517, "verse_number": "१५७-४९", "content_sanskrit": "आदित्यं तु पुरः स्थाप्य प्राप्तो भीष्मो महाबलः ।\nशन्तनुः प्राप्य तं पुत्रं गतो ऽसौ हस्तिनापुरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003517049, "chapter_id": 23517, "verse_number": "१५७-५०", "content_sanskrit": "तत्र स्नानेन दानेन वाञ्छितं फलमाप्नुयात् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]