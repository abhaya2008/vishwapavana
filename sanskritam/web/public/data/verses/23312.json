[{"id": 7003312000, "chapter_id": 23312, "verse_number": "२-७-१", "content_sanskrit": "ऋषय ऊचुः    ।\nकिंजपान्मुच्यते जंतुः सर्वलोकभयादिभिः ।\nसर्वपापविनिर्मुक्तः प्राप्नोति परमां गतिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003312001, "chapter_id": 23312, "verse_number": "२-७-२", "content_sanskrit": "अलक्ष्मींवाथ संत्यज्य गमिष्यति जपेन वै ।\nलक्ष्मीवासो भवेन्मर्त्यः सूत वक्तुमिहार्हसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003312002, "chapter_id": 23312, "verse_number": "२-७-३", "content_sanskrit": "सूत उवाच  ।\nपुरा पितामहेनोक्तं वसिष्ठाय महात्मने ।\nवक्ष्ये संक्षेपतः सर्वं सर्वलोकहिताय वै ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003312003, "chapter_id": 23312, "verse_number": "२-७-४", "content_sanskrit": "श्रृण्वंतु वचनं सर्वे प्रणिपत्य जनार्दनम् ।\nदेवदेवमजं विष्णुं कृष्णमच्युतमव्ययम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003312004, "chapter_id": 23312, "verse_number": "२-७-५", "content_sanskrit": "सर्वपापहरं शुद्धं मोक्षदं ब्रह्मवादिनम् ।\nमनसाकर्मणा वाचा यो विद्वान्पुण्यकर्मकृत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003312005, "chapter_id": 23312, "verse_number": "२-७-६", "content_sanskrit": "नारायणं जपेन्नित्यं प्रणम्य पुरुषोत्तमम् ।\nस्वपन्नारायणं देवं गच्छन्नारायणं तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003312006, "chapter_id": 23312, "verse_number": "२-७-७", "content_sanskrit": "भुंजन्नारायणं विप्रास्तिष्ठञ्जाग्रत्सनातनम् ।\nउन्मिषन्निमिषन्वापि नमो नारायणेति वै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003312007, "chapter_id": 23312, "verse_number": "२-७-८", "content_sanskrit": "भोज्यं पेयं च लेह्यं च नमो नारायणेति च ।\nअभिमंत्र्य स्पृशन्भुंक्ते स याति परमां गतिम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003312008, "chapter_id": 23312, "verse_number": "२-७-९", "content_sanskrit": "सर्वपापविनिर्मुक्तः प्राप्नोति च सतां गतिम् ।\nअलक्ष्मीश्च मया प्रोक्ता पत्नी या दुःसहस्य च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003312009, "chapter_id": 23312, "verse_number": "२-७-१०", "content_sanskrit": "नारायणपदं श्रुत्वा गच्छत्येव न संशयः ।\nया लक्ष्मीर्देवदेवस्य हरेः कृष्णस्य वल्लभा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003312010, "chapter_id": 23312, "verse_number": "२-७-११", "content_sanskrit": "गृहे क्षेत्रे तथावासे तनौवसति सुव्रताः ।\nआलोड्य सर्वशास्त्राणि विचार्य च पुनः पुनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003312011, "chapter_id": 23312, "verse_number": "२-७-१२", "content_sanskrit": "इतमेकं सुनिष्पन्नं ध्येयो नारायणः सदा ।\nकिं तस्य बहुभिर्मंत्रैः किं तस्य बहुभिर्व्रतैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003312012, "chapter_id": 23312, "verse_number": "२-७-१३", "content_sanskrit": "नमो नारायणायेति मंत्रः सर्वार्थसाधकः ।\nतस्मात्सर्वेषु कालेषु नमो नारायणेति च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003312013, "chapter_id": 23312, "verse_number": "२-७-१४", "content_sanskrit": "जपेत्स याति विप्रेंद्रा विष्णुलोकं सबांधवः ।\nअन्यच्च देवदेवस्य श्रृण्वंतु मुनिसत्तमाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003312014, "chapter_id": 23312, "verse_number": "२-७-१५", "content_sanskrit": "मंत्रो मया पुराभ्यस्तः सर्ववेदार्थसाधकः ।\nद्वादशाक्षरसंयुक्तो द्वादशात्मा पुरातनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003312015, "chapter_id": 23312, "verse_number": "२-७-१६", "content_sanskrit": "तस्यैवेह च माहात्म्यं संक्षेपात्प्रवदामि वः ।\nकश्चिद्द्विजो महाप्राज्ञस्तपस्तप्त्वा कथंचन ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003312016, "chapter_id": 23312, "verse_number": "२-७-१७", "content_sanskrit": "पुत्रमेकं तयोत्पाद्य संस्कारैश्च यथाक्रमम् ।\nयोजयित्वा यताकालं कृतोपनयनं पुनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003312017, "chapter_id": 23312, "verse_number": "२-७-१८", "content_sanskrit": "अध्यापयामास तदा स च नोवाच  ।\nचन ।\nन जिह्वा स्पंदते तस्य दुःखितोऽभूद्द्विजोत्तमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003312018, "chapter_id": 23312, "verse_number": "२-७-१९", "content_sanskrit": "वासुदेवेति नियतमैतरेयो वदत्यसौ ।\nपिता तस्य तथा चान्यां परिणीय यथाविधि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003312019, "chapter_id": 23312, "verse_number": "२-७-२०", "content_sanskrit": "पुत्रानुत्पादयामास तथैव विधिपूर्वकम् ।\nवेदानधीत्य संपन्ना बभूवुः सर्वसंमताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003312020, "chapter_id": 23312, "verse_number": "२-७-२१", "content_sanskrit": "ऐतरेयस्य सा माता दुःखिता शोकमूर्च्छिता ।\nउवाच  ।\nत्राः संपन्ना वेदवेदांगपारगाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003312021, "chapter_id": 23312, "verse_number": "२-७-२२", "content_sanskrit": "ब्राह्मणैः पूज्यमाना वै मोदयंति च मातरम् ।\nमम त्वं भाग्यहीनायाः पुत्रो जातो निराकृतिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003312022, "chapter_id": 23312, "verse_number": "२-७-२३", "content_sanskrit": "ममात्र निधनं श्रेयो न कथंचन जीवितम् ।\nइत्युक्तः स च निर्गम्य यज्ञवाटं जगाम वै ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003312023, "chapter_id": 23312, "verse_number": "२-७-२४", "content_sanskrit": "तस्मिन्याते द्विजानां तु न मंत्राः प्रतिपेदिरे ।\nऐतरेये स्थितेतत्र ब्राह्मणा मोहितास्तदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003312024, "chapter_id": 23312, "verse_number": "२-७-२५", "content_sanskrit": "ततो वाणी समुद्भूता वासुदेवेति कीर्तनात् ।\nऐतरेयस्य ते विप्राः प्रणिपत्य यतातथम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003312025, "chapter_id": 23312, "verse_number": "२-७-२६", "content_sanskrit": "पूजां चक्रुस्ततो यज्ञं स्वयमेव समागतम् ।\nततः समाप्य तं यज्ञमैतरेयो धनादिभिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003312026, "chapter_id": 23312, "verse_number": "२-७-२७", "content_sanskrit": "सर्ववेदान्सदस्याह स षडंगान् समाहिताः ।\nतुष्टुवुश्च तथा विप्रा ब्रह्माद्याश्च तथा द्विजाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003312027, "chapter_id": 23312, "verse_number": "२-७-२८", "content_sanskrit": "ससर्जुः पुष्पवर्षाणि खेचराः सिद्धचारणाः ।\nएवं समाप्य वै यज्ञमैतरेयो द्विजोत्तमाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003312028, "chapter_id": 23312, "verse_number": "२-७-२९", "content_sanskrit": "मातरं पूजयित्वा तु विष्णोः स्थानं जगाम ह ।\nएतद्वै कथितं सर्वं द्वादशाक्षरवैभवम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003312029, "chapter_id": 23312, "verse_number": "२-७-३०", "content_sanskrit": "पठतां श्रृण्वतां नित्यं महापातकनाशनम् ।\nजपेद्यः पुरुषो नित्यं द्वादशाक्षरमव्ययम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003312030, "chapter_id": 23312, "verse_number": "२-७-३१", "content_sanskrit": "स याति दिव्यमतुलं विष्णोस्तत्परमं पदम् ।\nअपि पापसमाचारो द्वादशाक्षरतत्परः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003312031, "chapter_id": 23312, "verse_number": "२-७-३२", "content_sanskrit": "प्राप्नोति परमं स्थानं नात्र कार्या विचारणा ।\nकिं पुनर्ये स्वधर्मस्था वासुदेवपरायणाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003312032, "chapter_id": 23312, "verse_number": "२-७-३३", "content_sanskrit": "दिव्यं स्थानं महात्मानः प्राप्नुवंतीति सुव्रताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]