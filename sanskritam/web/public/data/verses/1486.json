[{"id": 2022868, "chapter_id": 1486, "verse_number": "३-१२४-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022869, "chapter_id": 1486, "verse_number": "३-१२४-१", "content_sanskrit": "कस्य चित्त्वथ कालस्य त्रिदशावश्विनौ नृप।\nकृताभिषेकां विवृतां सुकन्यां तामपश्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022870, "chapter_id": 1486, "verse_number": "३-१२४-२", "content_sanskrit": "तां दृष्ट्वा दर्शनीयाङ्गीं देवराजसुतामिव।\nऊचतुः समभिद्रुत्य नासत्यावश्विनाविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022871, "chapter_id": 1486, "verse_number": "३-१२४-३", "content_sanskrit": "कस्य त्वमसि वामोरु वनेऽस्मिन्किं करोषि च।\nइच्छाव भद्रे ज्ञातुं त्वां तत्वमाख्याहि शोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022872, "chapter_id": 1486, "verse_number": "३-१२४-४", "content_sanskrit": "ततः सुकन्या संवीता तावुवाच सुरोत्तमौ।\nशर्यातितनयां वित्तं भार्यां मां च्यवनस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022873, "chapter_id": 1486, "verse_number": "३-१२४-५", "content_sanskrit": "`नाम्ना चाहं सुकन्येति नृलोकेऽस्मिन्प्रतिष्ठिता।\nसाऽहंसर्वात्मना नित्यं भर्तारमनुवर्तिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022874, "chapter_id": 1486, "verse_number": "३-१२४-६", "content_sanskrit": "अथाश्विनौ प्रहस्यैतामब्रूतां पुनरेव तु।\nकथं त्वमसि कल्याणि पित्रा दत्ताऽऽगता वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022875, "chapter_id": 1486, "verse_number": "३-१२४-७", "content_sanskrit": "भ्राजसेऽस्मिन्वने भीरु विद्युत्सौदामनी यथा।\nन देवेष्वपि तुल्यां हि त्वया पश्याव भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022876, "chapter_id": 1486, "verse_number": "३-१२४-८", "content_sanskrit": "अनाभरणसंपन्ना परमाम्बरवर्जिता।\nशोभयस्यधिकं भद्रे वनमप्यनलंकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022877, "chapter_id": 1486, "verse_number": "३-१२४-९", "content_sanskrit": "सर्वाभरणसंपनना परमाम्वरधारिणी।\nशोभेथास्त्वनवद्याङ्गि न त्वेवं मलपङ्किनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022878, "chapter_id": 1486, "verse_number": "३-१२४-१०", "content_sanskrit": "कस्मादेवंविधा भूत्वा जराजर्जरितं पतिम्।\nत्वमुपास्से ह कल्याणि कामभोगबहिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022879, "chapter_id": 1486, "verse_number": "३-१२४-११", "content_sanskrit": "असमर्थं परित्राणे पोषणे तु शुचिस्मिते।\nसा त्वं च्यवनमुत्सृज्यवरयस्वैकमावयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022880, "chapter_id": 1486, "verse_number": "३-१२४-१२", "content_sanskrit": "पत्यर्थं देवगर्भाभे मा वृथा यौवनं कृथाः।\nएवमुक्ता सुकन्याऽपि सुरौ ताविदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022881, "chapter_id": 1486, "verse_number": "३-१२४-१३", "content_sanskrit": "रताऽहं च्यवने पत्यौ मैवं मां पर्यशङ्कतम्।\nतावब्रूतां पुनस्त्वेनामावां देवभिषग्वरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022882, "chapter_id": 1486, "verse_number": "३-१२४-१४", "content_sanskrit": "युवानं रूपसंपन्नं करिष्यावः पतिं तव।\nततस्तस्यावयोश्चैव वृणीष्वान्यतमं पतिम्।\nएतेन समयेनैनमामन्त्रय पतिं शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022883, "chapter_id": 1486, "verse_number": "३-१२४-१५", "content_sanskrit": "सा तयोर्वचनाद्राजन्नुपसंगम्य भार्गवम्।\nउवाच वाक्यं यत्ताभ्यामुक्तं भृगुसुतं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022884, "chapter_id": 1486, "verse_number": "३-१२४-१६", "content_sanskrit": "तच्छ्रुत्वा च्यवनो भार्यामुवाच क्रियतामिति।\n`सा भर्त्रा समनुज्ञाता क्रियतामित्यथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022885, "chapter_id": 1486, "verse_number": "३-१२४-१७", "content_sanskrit": "श्रुत्वा तदश्विनौ वाक्यं तस्यास्तत्क्रियतामिति।\nऊचतू राजपुत्रीं तां पतिस्तव विशत्वपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022886, "chapter_id": 1486, "verse_number": "३-१२४-१८", "content_sanskrit": "ततोऽम्भश्च्यवनः शीघ्रं रूपार्थी प्रविवेश ह।\nअश्विनावपि तद्राजन्सरः प्राविशतां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022887, "chapter_id": 1486, "verse_number": "३-१२४-१९", "content_sanskrit": "ततो मुहूर्तादुत्तीर्णाः सर्वे ते सरसस्त्रयः।\nदिव्यरूपधराः सर्वे युवानो मृष्टकुण्डलाः।\nतुल्यवेषधराश्चैव मनसः प्रीतिवर्धनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022888, "chapter_id": 1486, "verse_number": "३-१२४-२०", "content_sanskrit": "तेऽब्रुवन्सहिताः सर्वे वृणीष्वान्यतमं शुभे।\nअस्माकमीप्सितं भद्रे पतित्वे वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022889, "chapter_id": 1486, "verse_number": "३-१२४-२१", "content_sanskrit": "`त्वमश्विनोरन्यतरं च्यवनं वा यशस्विनि।\nयत्र वाऽप्यभिकामाऽसि तं वृणीष्व सुशोभने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022890, "chapter_id": 1486, "verse_number": "३-१२४-२२", "content_sanskrit": "सा समीक्ष्य तु तान्सर्वांस्तुल्यरूपधरान्स्थितान्।\nनिश्चित्य मनसा बुद्ध्या देवी वव्रे स्वकं पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022891, "chapter_id": 1486, "verse_number": "३-१२४-२३", "content_sanskrit": "लब्ध्वा तु च्यवनो भार्यांवयोरूपं च वाञ्छितम्।\nहृष्टोऽब्रवीन्महातेजास्तौ नासत्याविदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022892, "chapter_id": 1486, "verse_number": "३-१२४-२४", "content_sanskrit": "यथाऽहं रूपसंपन्नो वयसा च समन्वितः।\nकृतो भवद्भ्यां वृद्धः सन्भार्यां च प्राप्तवानिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022893, "chapter_id": 1486, "verse_number": "३-१२४-२५", "content_sanskrit": "तस्माद्युवां करिष्यामि प्रीत्याऽहं सोमपीथिनौ।\nमिषतो देवराजस्य सत्यमेतद्ब्रवीमि वाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022894, "chapter_id": 1486, "verse_number": "३-१२४-२६", "content_sanskrit": "तच्छ्रुत्वा हृष्टमनसौ दिवं तौ प्रतिजग्मतुः।\nच्यवनश्च सुकन्या च सुराविव विजह्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022895, "chapter_id": 1486, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि चतुर्विंशत्यधिकशततमोऽध्यायः ॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]