[{"id": 2088385, "chapter_id": 2880, "verse_number": "१३-१०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nकर्मणां च समस्तानां फलिनां भरतर्षभ।\nफलानि महतां श्रेष्ट प्रब्रूहि परिपृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088386, "chapter_id": 2880, "verse_number": "१३-१०-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088387, "chapter_id": 2880, "verse_number": "१३-१०-२", "content_sanskrit": "हन्त ते कथयिष्यामि यन्मां पृच्छसि भारत।\nरहस्यं यदृषीणां तु तच्छृणुष्व युधिष्ठिर।\nया गतिः प्राप्यते येन प्रेत्यभावे चिरेप्सिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088388, "chapter_id": 2880, "verse_number": "१३-१०-३", "content_sanskrit": "येनयेन शरीरेण यद्यत्कर्म करोति यः।\nतेनतेन शरीरेण तत्तत्फलमुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088389, "chapter_id": 2880, "verse_number": "१३-१०-४", "content_sanskrit": "यस्यांयस्यामवस्थायां यत्करोति शुभाशुभम्।\nतस्यांतस्यामवस्थायां भुङ्क्ते जन्मनिजन्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088390, "chapter_id": 2880, "verse_number": "१३-१०-५", "content_sanskrit": "न नश्यति कृतं कर्म चित्तपञ्चेन्द्रियैरिह।\nते ह्यस्य साक्षिणो नित्यं षष्ठ आत्मा शुभाशुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088391, "chapter_id": 2880, "verse_number": "१३-१०-६", "content_sanskrit": "चक्षुर्दद्यान्मनो दद्याद्वाचं दद्याच्च सूनृताम्।\nअनुव्रजेदुपासीत स यज्ञः पञ्चदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088392, "chapter_id": 2880, "verse_number": "१३-१०-७", "content_sanskrit": "यो दद्यादपरिक्लिष्टमन्नमध्वनि वर्तते।\nश्रान्तायादृष्टपूर्वाय तस्य पुण्यफलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088393, "chapter_id": 2880, "verse_number": "१३-१०-८", "content_sanskrit": "स्थण्डिलेषु शयानानां गृहाणि शयनानि च।\nचीरवल्कलसंवीते वासांस्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088394, "chapter_id": 2880, "verse_number": "१३-१०-९", "content_sanskrit": "वाहनानि च यानानि योगात्मनि तपोधने।\nअग्नीनुपशयानस्य राज्ञः पौरुषमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088395, "chapter_id": 2880, "verse_number": "१३-१०-१०", "content_sanskrit": "रसानां प्रतिसंहारे सौभाग्यमनुगच्छति।\nआमिषप्रतिसंहारे पशून्पुत्रांश्च विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088396, "chapter_id": 2880, "verse_number": "१३-१०-११", "content_sanskrit": "अवाक्शिरास्तु यो लम्बेदुदवासं च यो वसेत्।\nमण्डूकशायी च नरो लभते चेप्सितां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088397, "chapter_id": 2880, "verse_number": "१३-१०-१२", "content_sanskrit": "पाद्यमासनमेवाथ दीपमन्नं प्रतिश्रयम्।\nदद्यादतिथिपूजार्थं स यज्ञः पञ्चदक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088398, "chapter_id": 2880, "verse_number": "१३-१०-१३", "content_sanskrit": "वीरासनं वीरशय्यां वीरस्थानमुपासतः।\nअक्षयास्तस्य वै लोकाः सर्वकामगमास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088399, "chapter_id": 2880, "verse_number": "१३-१०-१४", "content_sanskrit": "धनं लभेत दानेन मौनेनाज्ञां विशांपते।\nउपभोगांश्च तपसा ब्रह्मचर्येण जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088400, "chapter_id": 2880, "verse_number": "१३-१०-१५", "content_sanskrit": "रूपमैश्वर्यमारोग्यमहिंसाफलमश्नुते।\nफलमूलाशिनो राज्यं स्वर्गः पर्णाशिनां भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088401, "chapter_id": 2880, "verse_number": "१३-१०-१६", "content_sanskrit": "प्रायोपवेशिनो राजन्सर्वत्र सुखमुच्यते।\nगवाढ्यः शाकदीक्षायां स्वर्गगामी तृणाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088402, "chapter_id": 2880, "verse_number": "१३-१०-१७", "content_sanskrit": "स्त्रियस्त्रिषवणं स्नात्वा वायुं पीत्वा क्रतुं लभेत्।\nस्वर्गं सत्येन लभते दीक्षया कुलमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088403, "chapter_id": 2880, "verse_number": "१३-१०-१८", "content_sanskrit": "सलिलाशी भवेद्यस्तु सदाग्निः संस्कृतो द्विजः।\nमरुत्साधयतो राज्यं नाकपृष्ठमनाशिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088404, "chapter_id": 2880, "verse_number": "१३-१०-१९", "content_sanskrit": "उपवासं च दीक्षायामभिषेकं च पार्थिव।\nकृत्वा द्वादशवर्षाणि वीरस्थानाद्विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088405, "chapter_id": 2880, "verse_number": "१३-१०-२०", "content_sanskrit": "अधीत्य सर्ववेदान्वै सद्यो दुःखाद्विमुच्यते।\n`तत्पाठधारणात्स्वर्गमर्थज्ञानात्परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088406, "chapter_id": 2880, "verse_number": "१३-१०-२१", "content_sanskrit": "वितृष्णानां वेदजपात्स्वर्गमोक्षफलं स्मृतम्।\nमानसं हि चरन्धर्म स्वर्गलोकमुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088407, "chapter_id": 2880, "verse_number": "१३-१०-२२", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्या न जीर्यति जीर्यतः।\nयोसौप्राणान्तिकोरोगस्तांतृष्णां त्यजतः सुखं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2088408, "chapter_id": 2880, "verse_number": "१३-१०-२३", "content_sanskrit": "यथा धेनुसहस्रेषु वत्सो विन्दति मातरम्।\nएवं पूर्वकृतं कर्म कर्तारमनुगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2088409, "chapter_id": 2880, "verse_number": "१३-१०-२४", "content_sanskrit": "अचोद्यमानानि यथा पुष्पाणि च फलानि च।\nस्वकालं नातिवर्तन्ते तथा कर्म पुराकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2088410, "chapter_id": 2880, "verse_number": "१३-१०-२५", "content_sanskrit": "जीर्यन्ति जीर्यतः केशा दन्ता जीर्यन्ति जीर्यतः।\nचक्षुः श्रोत्रे च जीर्येते तृष्णैका न तु जीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2088411, "chapter_id": 2880, "verse_number": "१३-१०-२६", "content_sanskrit": "येन प्रीणन्ति पितरस्तेन प्रीतः प्रजापतिः।\nमाता च येन प्रीणाति पृथिवी तेन पूजिता।\nयेन प्रीणात्युपाध्यायस्तेन स्याद्ब्रह्म पूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2088412, "chapter_id": 2880, "verse_number": "१३-१०-२७", "content_sanskrit": "सर्वे तस्यादृता धर्मा यस्यैते त्रय आदृताः।\nअनादृतास्तु यस्यैते सर्वास्तस्याफलाः क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2088413, "chapter_id": 2880, "verse_number": "१३-१०-२८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088414, "chapter_id": 2880, "verse_number": "१३-१०-२८", "content_sanskrit": "भीष्मस्यैतद्वचः श्रुत्वा विस्मिताः कुरुपुङ्गवाः।\nआसन्प्रहृष्टमनसः प्रीतिमन्तोऽभवंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088415, "chapter_id": 2880, "verse_number": "१३-१०-२९", "content_sanskrit": "यन्मन्त्रे भवति वृथोपयुज्यमाने\nयत्सोमे भवति वृथाऽभिषूयमाणे।\nयच्चाग्नौ भवति वृथाऽभिहूयमाने\nतत्सर्वं भवति वृथाऽभिधीयमाने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088416, "chapter_id": 2880, "verse_number": "१३-१०-३०", "content_sanskrit": "इत्येतदृषिणा प्रोक्तमुक्तवानस्मि भारत।\nशुभाशुभफलप्राप्तौ किमतः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088417, "chapter_id": 2880, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि दशमोऽध्यायः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]