[{"id": 6000057000, "chapter_id": 10057, "verse_number": null, "content_sanskrit": "अथ सप्तविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000057001, "chapter_id": 10057, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.001.m4a", "display_order": 2}, {"id": 6000057002, "chapter_id": 10057, "verse_number": "३-२७-१", "content_sanskrit": "अथ ते सम्प्रवक्ष्यामि तत्त्वानां लक्षणं पृथक्।\nयद् विदित्वा विमुच्येत पुरुषः प्राकृतैर्गुणैः॥ ३/२७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.002.m4a", "display_order": 3, "topics": [{"text": "कपिलेन देवहूतिं प्रति तत्त्वलक्षणतदुत्पत्तिप्रकारादिकथनम्", "range": "१–५३"}]}, {"id": 6000057003, "chapter_id": 10057, "verse_number": "३-२७-२", "content_sanskrit": "ज्ञानं निःश्रेयसार्थाय पुरुषस्यात्मदर्शनम्।\nयदाहुर्वर्णये तत् ते हृदयग्रन्थिभेदनम्॥ ३/२७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.003.m4a", "display_order": 4}, {"id": 6000057004, "chapter_id": 10057, "verse_number": "३-२७-३", "content_sanskrit": "अनादिरात्मा पुरुषो निर्गुणः प्रकृतेः परः।\nप्रत्यग्धामा स्वयंज्योतिर्विश्वं येन समन्वितम्॥ ३/२७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.004.m4a", "display_order": 5}, {"id": 6000057005, "chapter_id": 10057, "verse_number": "३-२७-४", "content_sanskrit": "न जातो न म्रियेतात्मा स हि देहाद्युपाधिभिः।\nनिमित्तैरात्ततद्धर्मा यथा स्वप्ने तदीक्षिता॥ ३/२७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.005.m4a", "display_order": 6}, {"id": 6000057006, "chapter_id": 10057, "verse_number": "३-२७-५", "content_sanskrit": "स एव प्रकृतिं सूक्ष्मां देवीं गुणमयीं विभुः।\nयदृच्छयैवोपगतामभ्यपद्यत लीलया॥ ३/२७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.006.m4a", "display_order": 7}, {"id": 6000057007, "chapter_id": 10057, "verse_number": "३-२७-६", "content_sanskrit": "गुणैर्विचित्राः सृजतीं सरूपाः प्रकृतिं प्रजाः।\nविलोक्य मुमुहे सद्यः स इह ज्ञानगूहया॥ ३/२७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.007.m4a", "display_order": 8}, {"id": 6000057008, "chapter_id": 10057, "verse_number": "३-२७-७", "content_sanskrit": "एवं पराभिध्यानेन कर्तृत्वं प्रकृतेः पुमान्।\nकर्मसु क्रियमाणेषु गुणैरात्मनि मन्यते॥ ३/२७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.008.m4a", "display_order": 9}, {"id": 6000057009, "chapter_id": 10057, "verse_number": "३-२७-८", "content_sanskrit": "तदस्य संसृतिर्बन्धः पारतन्त्र्यं च तत्कृतम्।\nभवत्यकर्तुरीशस्य साक्षिणो निर्वृतात्मनः॥ ३/२७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.009.m4a", "display_order": 10}, {"id": 6000057010, "chapter_id": 10057, "verse_number": "३-२७-९", "content_sanskrit": "कार्यकारणकर्तृत्वे कारणं प्रकृतिं विदुः।\nभोक्तृत्वे सर्वजीवानां पुरुषं प्रकृतेः परम्॥ ३/२७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.010.m4a", "display_order": 11}, {"id": 6000057011, "chapter_id": 10057, "verse_number": null, "content_sanskrit": "देवहूतिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.011.m4a", "display_order": 12}, {"id": 6000057012, "chapter_id": 10057, "verse_number": "३-२७-१०", "content_sanskrit": "प्रकृतेः पुरुषस्यापि लक्षणं पुरुषोत्तम।\nब्रूहि कारणयोरस्य सदसच्च यदात्मकम्॥ ३/२७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.012.m4a", "display_order": 13}, {"id": 6000057013, "chapter_id": 10057, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.013.m4a", "display_order": 14}, {"id": 6000057014, "chapter_id": 10057, "verse_number": "३-२७-११", "content_sanskrit": "यत् तत् त्रिगुणमव्यक्तं नित्यं सदसदात्मकम्।\nप्रधानं प्रकृतिं प्राहुरविशेषं विशेषवत्॥ ३/२७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.014.m4a", "display_order": 15}, {"id": 6000057015, "chapter_id": 10057, "verse_number": "३-२७-१२", "content_sanskrit": "पञ्चभिः पञ्चभिर्ब्रह्म चतुर्भिर्दशभिस्तथा।\nएतच्चतुर्विंशतिकं गणं प्राधानिकं विदुः॥ ३/२७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.015.m4a", "display_order": 16}, {"id": 6000057016, "chapter_id": 10057, "verse_number": "३-२७-१३", "content_sanskrit": "महाभूतानि पञ्चैव भूरापोऽग्निर्मरुन्नभः।\nतन्मात्राणि च तावन्ति गन्धादीनि मतानि मे॥ ३/२७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.016.m4a", "display_order": 17}, {"id": 6000057017, "chapter_id": 10057, "verse_number": "३-२७-१४", "content_sanskrit": "इन्द्रियाणि दश श्रोत्रं त्वग्दृग्रसननासिकम्।\nवाक् करौ चरणौ मेढ्रं पायुर्दशम उच्यते॥ ३/२७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.017.m4a", "display_order": 18}, {"id": 6000057018, "chapter_id": 10057, "verse_number": "३-२७-१५", "content_sanskrit": "मनो बुद्धिरहङ्कारश्चित्तमित्यन्तरात्मनः।\nचतुर्धा लक्ष्यते भेदो वृत्त्या लक्षणरूपया॥ ३/२७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.018.m4a", "display_order": 19}, {"id": 6000057019, "chapter_id": 10057, "verse_number": "३-२७-१६", "content_sanskrit": "एतावानेव संख्यातो ब्रह्मणः सगुणस्य हि।\nसन्निवेशो मया प्रोक्तो यः कालः पञ्चविंशकः॥ ३/२७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.019.m4a", "display_order": 20}, {"id": 6000057020, "chapter_id": 10057, "verse_number": "३-२७-१७", "content_sanskrit": "प्रभावं पौरुषं प्राहुः कालमेके यतो भयम्।\nअहङ्कारविमूढस्य कर्तुः प्रकृतिमीयुषः॥ ३/२७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.020.m4a", "display_order": 21}, {"id": 6000057021, "chapter_id": 10057, "verse_number": "३-२७-१८", "content_sanskrit": "प्रकृतेर्गुणसाम्यस्य निर्विशेषस्य मानवि।\nचेष्टा यतः स भगवान् काल इत्युपलक्षितः॥ ३/२७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.021.m4a", "display_order": 22}, {"id": 6000057022, "chapter_id": 10057, "verse_number": "३-२७-१९", "content_sanskrit": "अन्तः पुरुषरूपेण कालरूपेण यो बहिः।\nसमन्वेत्येष सत्त्वानां भगवानात्ममायया॥ ३/२७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.022.m4a", "display_order": 23}, {"id": 6000057023, "chapter_id": 10057, "verse_number": "३-२७-२०", "content_sanskrit": "दैवात् क्षुभितधर्मिण्यां स्वस्यां योनौ परः पुमान्।\nआधत्त वीर्यं साऽसूत महत्तत्त्वं हिरण्मयम्॥ ३/२७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.023.m4a", "display_order": 24}, {"id": 6000057024, "chapter_id": 10057, "verse_number": "३-२७-२१", "content_sanskrit": "विश्वमात्मगतं व्यञ्जन् कूटस्थो जगदङ्कुरः।\nस्वतेजसाऽपिबत् तीव्रमात्मप्रस्वापनं तमः॥ ३/२७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.024.m4a", "display_order": 25}, {"id": 6000057025, "chapter_id": 10057, "verse_number": "३-२७-२२", "content_sanskrit": "यत् तत् सत्त्वगुणं स्वच्छं शान्तं भगवतः पदम्।\nयदाहुर्वासुदेवाख्यं चित्तं तन्महदात्मकम्॥ ३/२७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.025.m4a", "display_order": 26}, {"id": 6000057026, "chapter_id": 10057, "verse_number": "३-२७-२३", "content_sanskrit": "स्वच्छत्वमविकारित्वं शान्तत्वमिति चेतसः।\nवृत्तिभिर्लक्षणं प्रोक्तं यथाऽपां प्रकृतिः परा॥ ३/२७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.026.m4a", "display_order": 27}, {"id": 6000057027, "chapter_id": 10057, "verse_number": "३-२७-२४", "content_sanskrit": "महत्तत्त्वाद् विकुर्वाणाद् भगवद्वीर्यसम्भवात्।\nक्रियाशक्तिरहङ्कारस्‍त्रिविधः समपद्यत॥ ३/२७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.027.m4a", "display_order": 28}, {"id": 6000057028, "chapter_id": 10057, "verse_number": "३-२७-२५", "content_sanskrit": "वैकारिकस्तैजसश्च तामसश्च यतो भवः।\nमनसश्चेन्द्रियाणां च भूतानां महतामपि॥ ३/२७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.028.m4a", "display_order": 29}, {"id": 6000057029, "chapter_id": 10057, "verse_number": "३-२७-२६", "content_sanskrit": "वैकारिकोऽधिदैवं तु, बुद्धिः प्राणश्च तैजसः।\nतामसस्त्वर्थमात्रं च गुणव्यतिकरस्‍त्रिवृत्॥ ३/२७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.029.m4a", "display_order": 30}, {"id": 6000057030, "chapter_id": 10057, "verse_number": "३-२७-२७", "content_sanskrit": "सहस्रशिरसं साक्षाद् यमनन्तं प्रचक्षते।\nसङ्कर्षणाख्यं पुरुषं भूतेन्द्रियमनोमयम्॥ ३/२७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.030.m4a", "display_order": 31}, {"id": 6000057031, "chapter_id": 10057, "verse_number": "३-२७-२८", "content_sanskrit": "कर्तृत्वं करणत्वं च कार्यत्वं चेति लक्षणम्।\nशान्तघोरविमूढत्वमिति वा स्यादहंकृतेः॥ ३/२७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.031.m4a", "display_order": 32}, {"id": 6000057032, "chapter_id": 10057, "verse_number": "३-२७-२९", "content_sanskrit": "वैकारिकाद् विकुर्वाणान्मनस्तत्त्वमजायत।\nयत् सङ्कल्पविकल्पाभ्यां वर्तते कामसम्भवः॥ ३/२७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.032.m4a", "display_order": 33}, {"id": 6000057033, "chapter_id": 10057, "verse_number": "३-२७-३०", "content_sanskrit": "यद् विदुर्ह्यनिरुद्धाख्यं हृषीकाणामधीश्वरम्।\nशारदेन्दीवरश्यामं संराध्यं योगिभिः शनैः॥ ३/२७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.033.m4a", "display_order": 34}, {"id": 6000057034, "chapter_id": 10057, "verse_number": "३-२७-३१", "content_sanskrit": "तैजसात् तु विकुर्वाणाद् बुद्धितत्त्वमभूत् सति।\nद्रव्यस्फुरणविज्ञानमिन्द्रियाणामनुग्रहात्॥ ३/२७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.034.m4a", "display_order": 35}, {"id": 6000057035, "chapter_id": 10057, "verse_number": "३-२७-३२", "content_sanskrit": "संशयोऽथ विपर्यासो निश्चयः स्मृतिरेव च।\nस्वाप इत्युच्यते बुद्धेर्लक्षणं वृत्तिभिः पृथक्॥ ३/२७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.035.m4a", "display_order": 36}, {"id": 6000057036, "chapter_id": 10057, "verse_number": "३-२७-३३", "content_sanskrit": "तैजसानीन्द्रियाण्येव क्रियाज्ञानविभागशः।\nप्राणस्य च क्रियाशक्तिर्बुद्धेर्विज्ञानशक्तिता॥ ३/२७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.036.m4a", "display_order": 37}, {"id": 6000057037, "chapter_id": 10057, "verse_number": "३-२७-३४", "content_sanskrit": "तामसाच्च विकुर्वाणाद् भगवद्वीर्यचोदितात्।\nशब्दमात्रमभूत् तस्मान्नभः श्रोत्रं तु शब्दगम्॥ ३/२७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.037.m4a", "display_order": 38}, {"id": 6000057038, "chapter_id": 10057, "verse_number": "३-२७-३५", "content_sanskrit": "अर्थाश्रयत्वं शब्दस्य द्रष्टुर्लिङ्गत्वमेव च।\nतन्मात्रत्वं च नभसो लक्षणं कवयो विदुः॥ ३/२७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.038.m4a", "display_order": 39}, {"id": 6000057039, "chapter_id": 10057, "verse_number": "३-२७-३६", "content_sanskrit": "भूतानां छिद्रदातृत्वं बहिरन्तरमेव च।\nप्राणेन्द्रियात्मधिष्ण्यत्वं नभसो वृत्तिलक्षणम्॥ ३/२७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.039.m4a", "display_order": 40}, {"id": 6000057040, "chapter_id": 10057, "verse_number": "३-२७-३७", "content_sanskrit": "नभसः शब्दतन्मात्रात् कालगत्या विकुर्वतः।\nस्पर्शोऽभवत्ततो वायुस्त्वक्स्पर्शस्य च संग्रहः॥ ३/२७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.040.m4a", "display_order": 41}, {"id": 6000057041, "chapter_id": 10057, "verse_number": "३-२७-३८", "content_sanskrit": "मृदुत्वं कठिनत्वं च शैत्यमुष्णत्वमेव च।\nएतत् स्पर्शस्य स्पर्शत्वं तन्मात्रत्वं नभस्वतः॥ ३/२७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.041.m4a", "display_order": 42}, {"id": 6000057042, "chapter_id": 10057, "verse_number": "३-२७-३९", "content_sanskrit": "चालनं व्यूहनं प्राप्तिर्नेतृत्वं द्रव्यशब्दयोः।\nसर्वेन्द्रियाणामात्मत्वं वायोः कर्माभिलक्षणम्॥ ३/२७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.042.m4a", "display_order": 43}, {"id": 6000057043, "chapter_id": 10057, "verse_number": "३-२७-४०", "content_sanskrit": "वायोश्च स्पर्शतन्मात्राद् रूपं दैवेरितादभूत्।\nसमुत्थितं ततस्तेजश्चक्षू रूपोपलम्भनम्॥ ३/२७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.043.m4a", "display_order": 44}, {"id": 6000057044, "chapter_id": 10057, "verse_number": "३-२७-४१", "content_sanskrit": "द्रव्याकृतित्वं गुणता व्यक्तिसंस्थात्वमेव च।\nतेजस्त्वं तेजसः साध्वि रूपमात्रस्य वृत्तयः॥ ३/२७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.044.m4a", "display_order": 45}, {"id": 6000057045, "chapter_id": 10057, "verse_number": "३-२७-४२", "content_sanskrit": "द्योतनं पचनं पानमदनं हिममर्दनम्।\nतेजसो वृत्तयस्त्वेताः शोषणं क्षुत्तृडुद्भवः॥ ३/२७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.045.m4a", "display_order": 46}, {"id": 6000057046, "chapter_id": 10057, "verse_number": "३-२७-४३", "content_sanskrit": "रूपमात्राद् विकुर्वाणाद् तेजसो दैवचोदितात्।\nरसमात्रमभूत् तस्मादम्भो जिह्वा रसग्रहः॥ ३/२७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.046.m4a", "display_order": 47}, {"id": 6000057047, "chapter_id": 10057, "verse_number": "३-२७-४४", "content_sanskrit": "कषायो मधुरस्तिक्तः कट्वाम्ल इति नैकधा।\nभौतिकानां विकारेण रस एको विभिद्यते॥ ३/२७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.047.m4a", "display_order": 48}, {"id": 6000057048, "chapter_id": 10057, "verse_number": "३-२७-४५", "content_sanskrit": "क्लेदनं पिण्डनं तृप्तिः प्राणनाप्यायनोन्दनम्।\nतापापनोदो भूयस्त्वमम्भसो वृत्तयस्त्विमाः॥ ३/२७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.048.m4a", "display_order": 49}, {"id": 6000057049, "chapter_id": 10057, "verse_number": "३-२७-४६", "content_sanskrit": "रसमात्राद् विकुर्वाणादम्भसो दैवचोदितात्।\nगन्धमात्रमभूत् तस्मात् पृथ्वी घ्राणस्तु गन्धगः॥ ३/२७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.049.m4a", "display_order": 50}, {"id": 6000057050, "chapter_id": 10057, "verse_number": "३-२७-४७", "content_sanskrit": "करम्भपूतिसौरभ्यशान्तोग्राम्लादिभिः पृथक्।\nद्रव्यावयववैषम्याद् गन्ध एको विभिद्यते॥ ३/२७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.050.m4a", "display_order": 51}, {"id": 6000057051, "chapter_id": 10057, "verse_number": "३-२७-४८", "content_sanskrit": "भावनं ब्रह्मणः स्थानं धारणं सद्विशेषणम्।\nसर्वसत्त्वगुणोद्भेदः पृथिवीवृत्तिलक्षणम्॥ ३/२७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.051.m4a", "display_order": 52}, {"id": 6000057052, "chapter_id": 10057, "verse_number": "३-२७-४९", "content_sanskrit": "नभोगुणविशेषोऽर्थो यस्य तच्छ्रोत्रमुच्यते।\nवायोर्गुणविशेषोऽर्थो यस्य तत् स्पर्शनं विदुः॥ ३/२७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.052.m4a", "display_order": 53}, {"id": 6000057053, "chapter_id": 10057, "verse_number": "३-२७-५०", "content_sanskrit": "तेजोगुणविशेषोऽर्थो यस्य तच्चक्षुरुच्यते।\nअम्भोगुणविशेषोऽर्थो यस्य तद् रसनं विदुः॥ ३/२७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.053.m4a", "display_order": 54}, {"id": 6000057054, "chapter_id": 10057, "verse_number": "३-२७-५१", "content_sanskrit": "भूमेर्गुणविशेषोऽर्थो यस्य स घ्राण उच्यते।\nपरस्य दृश्यते धर्मो ह्यपरस्मिन् समन्वयात्॥ ३/२७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.054.m4a", "display_order": 55}, {"id": 6000057055, "chapter_id": 10057, "verse_number": "३-२७-५२", "content_sanskrit": "अतो विशेषो भावानां भूमावेवोपलक्ष्यते।\nएतान्यसंहत्य यदा महदादीनि सप्त वै॥ ३/२७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.055.m4a", "display_order": 56}, {"id": 6000057056, "chapter_id": 10057, "verse_number": "३-२७-५३", "content_sanskrit": "न शेकुः पुरुषं स्रष्टुं भोगायतनमञ्जसा।\nकालकर्मगुणोपेतो जगदादिरुपाविशत्॥ ३/२७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.056.m4a", "display_order": 57}, {"id": 6000057057, "chapter_id": 10057, "verse_number": "३-२७-५४", "content_sanskrit": "ततस्तेनानुविद्धेभ्यस्तत्त्वेभ्योऽण्डमचेतनम्।\nउत्थितं पुरुषो यस्मादुदतिष्ठदसौ विराट्॥ ३/२७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.057.m4a", "display_order": 58, "topics": [{"text": "ब्रह्माण्डविराट्पुरुषेन्द्रिय-तदधिष्ठानाभिमानि-विषयादिनिरूपणम्", "range": "५४–६४"}]}, {"id": 6000057058, "chapter_id": 10057, "verse_number": "३-२७-५५", "content_sanskrit": "एतदण्डं विशेषाख्यं क्रमवृद्धैर्दशोत्तरैः। तोयादिभिः परिवृतं प्रधानेनावृतं बहिः।\nयत्र लोकवितानोऽयं रूपं भगवतो हरेः॥ ३/२७/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.058.m4a", "display_order": 59}, {"id": 6000057059, "chapter_id": 10057, "verse_number": "३-२७-५६", "content_sanskrit": "हिरण्मयादाण्डकोशादुत्थाय सलिलेशयात्।\nसमाविश्य महादेवो बहुधा निर्बिभेद खम्॥ ३/२७/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.059.m4a", "display_order": 60}, {"id": 6000057060, "chapter_id": 10057, "verse_number": "३-२७-५७", "content_sanskrit": "निरभिद्यतास्य प्रथमं मुखं वाणी ततोऽभवत्।\nवाण्या वह्निरथो नासे घ्राणोऽतः प्राण एतयोः॥ ३/२७/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.060.m4a", "display_order": 61}, {"id": 6000057061, "chapter_id": 10057, "verse_number": "३-२७-५८", "content_sanskrit": "प्राणाद् वायुरभिद्येतामक्षिणी चक्षुरेतयोः।\nतस्मात् सूर्योऽन्वभिद्येतां कर्णौ श्रोत्रं ततो दिशः॥ ३/२७/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.061.m4a", "display_order": 62}, {"id": 6000057062, "chapter_id": 10057, "verse_number": "३-२७-५९", "content_sanskrit": "निर्बिभेद विराजस्त्वग् रोमश्मश्र्वादयस्ततः।\nततश्चौषधयः पश्चाच्छिश्नं निर्बिभिदे ततः॥ ३/२७/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.062.m4a", "display_order": 63}, {"id": 6000057063, "chapter_id": 10057, "verse_number": "३-२७-६०", "content_sanskrit": "रेतस्तस्मादाप आसन् निरभिद्यत वै गुदम्।\nगुदादपानोऽपानाच्च मृत्युर्लोकभयङ्करः॥ ३/२७/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.063.m4a", "display_order": 64}, {"id": 6000057064, "chapter_id": 10057, "verse_number": "३-२७-६१", "content_sanskrit": "हस्तौ च निरभिद्येतां बलं ताभ्यां ततः स्वराट्।\nपादौ च निरभिद्येतां गतिस्ताभ्यां ततो हरिः॥ ३/२७/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.064.m4a", "display_order": 65}, {"id": 6000057065, "chapter_id": 10057, "verse_number": "३-२७-६२", "content_sanskrit": "नाड्यश्च निरभिद्यन्त ताभ्यो लोहितमाहृतम्।\nनद्यस्ततः समभवन्नुदरं निरभिद्यत॥ ३/२७/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.065.m4a", "display_order": 66}, {"id": 6000057066, "chapter_id": 10057, "verse_number": "३-२७-६३", "content_sanskrit": "क्षुत्पिपासे ततः स्यातां समुद्रस्तु तयोरभूत्।\nअथास्य हृदयं भिन्नं हृदयान्मन उत्थितम्॥ ३/२७/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.066.m4a", "display_order": 67}, {"id": 6000057067, "chapter_id": 10057, "verse_number": "३-२७-६४", "content_sanskrit": "मनसश्चन्द्रमा जातो बुद्धिर्बुद्धेर्गिरांपतिः।\nअहङ्कारस्ततो रुद्रश्चित्तं चैत्त्यस्ततोऽभवत्॥ ३/२७/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.067.m4a", "display_order": 68}, {"id": 6000057068, "chapter_id": 10057, "verse_number": "३-२७-६५", "content_sanskrit": "एते ह्यभ्युत्थिता देवा नैवास्योत्थापनेऽशकन्।\nपुनराविविशुः खानि तमुत्थापयितुं क्रमात्॥ ३/२७/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.068.m4a", "display_order": 69, "topics": [{"text": "अन्वयव्यतिरेकाभ्यां क्षेत्रज्ञस्य विराड्देहोत्थापकत्वकर्थनम्", "range": "६५–७५"}]}, {"id": 6000057069, "chapter_id": 10057, "verse_number": "३-२७-६६", "content_sanskrit": "वह्निर्वाचा मुखं भेजे नोदतिष्ठत् ततो विराट्।\nघ्राणेन नासिकां वायुः नोदतिष्ठत् ततो विराट्॥ ३/२७/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.069.m4a", "display_order": 70}, {"id": 6000057070, "chapter_id": 10057, "verse_number": "३-२७-६७", "content_sanskrit": "अक्षिणी चक्षुषाऽऽदित्यो नोदतिष्ठत् ततो विराट्।\nश्रोत्रेण कर्णौ च दिशो नोदतिष्ठत् ततो विराट्॥ ३/२७/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.070.m4a", "display_order": 71}, {"id": 6000057071, "chapter_id": 10057, "verse_number": "३-२७-६८", "content_sanskrit": "त्वचं रोमभिरोषध्यो नोदतिष्ठत् ततो विराट्।\nरेतसा शिश्नमापस्तु नोदतिष्ठत् ततो विराट्॥ ३/२७/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.071.m4a", "display_order": 72}, {"id": 6000057072, "chapter_id": 10057, "verse_number": "३-२७-६९", "content_sanskrit": "गुदं मृत्युरपानेन नोदतिष्ठत् ततो विराट्।\nहस्ताविन्द्रो बलेनैव नोदतिष्ठत् ततो विराट्॥ ३/२७/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.072.m4a", "display_order": 73}, {"id": 6000057073, "chapter_id": 10057, "verse_number": "३-२७-७०", "content_sanskrit": "विष्णुर्गत्यैव चरणौ नोदतिष्ठत् ततो विराट्।\nनाडीर्नद्यो लोहितेन नोदतिष्ठत् ततो विराट्॥ ३/२७/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.073.m4a", "display_order": 74}, {"id": 6000057074, "chapter_id": 10057, "verse_number": "३-२७-७१", "content_sanskrit": "क्षुत्तृड्भ्यामुदरं सिन्धुर्नोदतिष्ठत् ततो विराट्।\nहृदयं मनसा चन्द्रो नोदतिष्ठत् ततो विराट्॥ ३/२७/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.074.m4a", "display_order": 75}, {"id": 6000057075, "chapter_id": 10057, "verse_number": "३-२७-७२", "content_sanskrit": "बुद्ध्या ब्रह्माऽपि हृदयं नोदतिष्ठत् ततो विराट्।\nरुद्रोऽभिमत्या हृदयं नोदतिष्ठत् ततो विराट्॥ ३/२७/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.075.m4a", "display_order": 76}, {"id": 6000057076, "chapter_id": 10057, "verse_number": "३-२७-७३", "content_sanskrit": "चित्तेन हृदयं चैत्त्यः क्षेत्रज्ञः प्राविशद् यदा।\nविराट् तदैव पुरुषः सलिलादुदतिष्ठत॥ ३/२७/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.076.m4a", "display_order": 77}, {"id": 6000057077, "chapter_id": 10057, "verse_number": "३-२७-७४", "content_sanskrit": "यथा प्रसुप्तं पुरुषं प्राणेन्द्रियमनोधियः।\nप्रभवन्ति विना येन नोत्थापयितुमोजसा॥ ३/२७/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.077.m4a", "display_order": 78}, {"id": 6000057078, "chapter_id": 10057, "verse_number": "३-२७-७५", "content_sanskrit": "तमस्मिन् प्रत्यगात्मानं धिया योगविपक्‍वया।\nभक्त्या विरक्त्या ज्ञानेन विविच्यात्मनि चिन्तयेत्॥ ३/२७/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_027/BhP_03.027.078.m4a", "display_order": 79}, {"id": 6000057079, "chapter_id": 10057, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे सप्तविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]