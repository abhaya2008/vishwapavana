[{"id": 2076274, "chapter_id": 2617, "verse_number": "१२-१२२-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076275, "chapter_id": 2617, "verse_number": "१२-१२२-१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nअङ्गेषु राजा द्युतिमान्वसुहोम इति श्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076276, "chapter_id": 2617, "verse_number": "१२-१२२-२", "content_sanskrit": "स राजा धर्मविन्नित्यं सह पत्न्या महातपाः।\nमुञ्जपृष्ठं जगामाथ देवर्षिगणसेवितम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076277, "chapter_id": 2617, "verse_number": "१२-१२२-३", "content_sanskrit": "तत्र शृङ्गे हिमवतो वसतिं समुपागमत्।\nयत्र मुञ्जवटे रामो जटाहरणमादिशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076278, "chapter_id": 2617, "verse_number": "१२-१२२-४", "content_sanskrit": "तदादि च महाप्राज्ञः ऋषिभिः संशितव्रतैः।\nमुञ्जपृष्ठ इति प्रोक्तः स देशो रुद्रसेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076279, "chapter_id": 2617, "verse_number": "१२-१२२-५", "content_sanskrit": "स तत्र बहुभिर्युक्तस्तदा श्रुतिमयैर्गुणैः।\nब्राह्मणानामनुमतो देवर्षिसदृशोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076280, "chapter_id": 2617, "verse_number": "१२-१२२-६", "content_sanskrit": "तं कदाचिददीनात्मा सखा शक्रस्य मानितः।\nअभ्यगच्छन्महीपालो मान्धाता शत्रुकर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076281, "chapter_id": 2617, "verse_number": "१२-१२२-७", "content_sanskrit": "सोपसृत्य तु मान्धाता वसुहोमं नराधिपम्।\nदृष्ट्वा प्रकृष्टतपसं विनयेनोपतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076282, "chapter_id": 2617, "verse_number": "१२-१२२-८", "content_sanskrit": "वसुहोमोऽपि राज्ञो वै गामर्ध्यं च न्यवेदयत्।\nसप्ताङ्गस्य तु राज्यस्य पप्रच्छ कुशलाव्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076283, "chapter_id": 2617, "verse_number": "१२-१२२-९", "content_sanskrit": "सद्भिराचरितं पूर्वं यथावदनुयायिनम्।\nअब्रवीद्वसुहोमस्तं राजन्किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076284, "chapter_id": 2617, "verse_number": "१२-१२२-१०", "content_sanskrit": "सोऽब्रवीत्परमप्रीतो मान्धाता राजसत्तमः।\nवसुहोमं महाप्राज्ञमासीनं कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076285, "chapter_id": 2617, "verse_number": "१२-१२२-११", "content_sanskrit": "बृहस्पतेर्मतं राजन्नघीतं सकलं त्वया।\nतथैवौशनसं शास्त्रं विज्ञातं ते नरोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076286, "chapter_id": 2617, "verse_number": "१२-१२२-१२", "content_sanskrit": "तदहं श्रोतुमिच्छामि दण्ड उत्पद्यते कथम्।\nकिं वाऽस्य पूर्वं जागर्ति किं वा परममुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076287, "chapter_id": 2617, "verse_number": "१२-१२२-१३", "content_sanskrit": "कथं क्षत्रियसंस्थश्च दण्डः संप्रत्यवस्थितः।\nब्रूहि मे तद्यथातत्वं ददाम्याचार्यवेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076288, "chapter_id": 2617, "verse_number": "१२-१२२-१४x", "content_sanskrit": "वसुहोम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076289, "chapter_id": 2617, "verse_number": "१२-१२२-१४", "content_sanskrit": "शृणु राजन्यथा दण्डः संभूतो लोकसंग्रहः।\nप्रजाविनयरक्षार्थं धर्मस्यात्मा सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076290, "chapter_id": 2617, "verse_number": "१२-१२२-१५", "content_sanskrit": "ब्रह्मा यियक्षुर्भगवान्सर्वलोकपितामहः।\nऋत्विजं नात्मनस्तुल्यं ददर्शेति हि नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076291, "chapter_id": 2617, "verse_number": "१२-१२२-१६", "content_sanskrit": "स गर्भं भगवान्देवो बहुवर्षाण्यधारयत्।\nअथ पूर्णे सहस्रे तु स गर्भः क्षुवतोऽपतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076292, "chapter_id": 2617, "verse_number": "१२-१२२-१७", "content_sanskrit": "स क्षुपो नाम संभूतः प्रजापतिररिंदम्।\nऋत्विगासीन्महाराज यज्ञे तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076293, "chapter_id": 2617, "verse_number": "१२-१२२-१८", "content_sanskrit": "तस्मिन्प्रवृत्ते सत्रे तु ब्रह्मणः पार्थिवर्षभ।\nइष्टरूपप्रचारत्वाद्दण्डः सोऽन्तर्हितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076294, "chapter_id": 2617, "verse_number": "१२-१२२-१९", "content_sanskrit": "तस्मिन्नन्तर्हिते चापि प्रजानां संकरोऽभवत्।\nनैव कार्यं न वा कार्यं भोज्याभोज्यं न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076295, "chapter_id": 2617, "verse_number": "१२-१२२-२०", "content_sanskrit": "पेयापेये कुतः सिद्धिर्हिसन्ति च परस्परम्।\nगम्यागम्यं तदा नासीत्स्वं परस्वं च वै समम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076296, "chapter_id": 2617, "verse_number": "१२-१२२-२१", "content_sanskrit": "परस्परं विलुम्पन्ति सारमेया यथाऽऽमिषम्।\nअबलान्बलिनो जघ्नुर्निर्मर्यादं प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076297, "chapter_id": 2617, "verse_number": "१२-१२२-२२", "content_sanskrit": "ततः पितामहो विष्णुं भगवन्तं सनातनम्।\nसंपूज्य वरदं देवं महादेवमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076298, "chapter_id": 2617, "verse_number": "१२-१२२-२३", "content_sanskrit": "अत्र त्वमनुकम्पां वै कर्तुमर्हसि शङ्कर।\nअयं विष्णुः सखा तुभ्यं धर्मस्य परिरक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076299, "chapter_id": 2617, "verse_number": "१२-१२२-२४", "content_sanskrit": "`त्वं हि सर्वविधानज्ञः सत्वानां त्वं गतिः परा।\nसंकरो न भवेदत्र यथा तद्वै विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076300, "chapter_id": 2617, "verse_number": "१२-१२२-२५", "content_sanskrit": "ततः स भगवान्ध्यात्वा तदा शूलवरायुधः।\n` देवदेवो महादेवः कारणं जगतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076301, "chapter_id": 2617, "verse_number": "१२-१२२-२६", "content_sanskrit": "ब्रह्मविष्ण्विन्द्रसहितः सर्वैश्च ससुरासुरैः।\nलोकसन्धारणार्थं च लोकसंकरनाशनम्।\nआत्मानमात्माना दण्डं ससृजे देवसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076302, "chapter_id": 2617, "verse_number": "१२-१२२-२७", "content_sanskrit": "तस्माच्च धर्मचरणान्नीतिं देवीं सरस्वतीम्।\nअसृजद्दण्डनीतिं वै त्रिषु लोकेषु विश्रुताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2076303, "chapter_id": 2617, "verse_number": "१२-१२२-२८", "content_sanskrit": "`यथाऽसौ नीयते दण्डः सततं पापकारिषु।\nदण्डस्य नयनात्सा हि दण्डनीतिरिहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2076304, "chapter_id": 2617, "verse_number": "१२-१२२-२९", "content_sanskrit": "भूयः स भगवान्ध्यात्वा चिरं शूलघरः प्रभुः।\n`असृजत्सर्वशास्त्राणि महादेवो महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2076305, "chapter_id": 2617, "verse_number": "१२-१२२-३०", "content_sanskrit": "दण्डनीतेः प्रयोगार्थं प्रमाणानि च सर्वशः।\nविद्याश्चतस्रः कूटस्थास्तासां भेदविकल्पनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2076306, "chapter_id": 2617, "verse_number": "१२-१२२-३१", "content_sanskrit": "अङ्गानि वेदाश्चत्वारो मीमांसा न्यायविस्तरः।\nपुराणं धर्मशास्त्रं च विद्या ह्येताश्चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2076307, "chapter_id": 2617, "verse_number": "१२-१२२-३२", "content_sanskrit": "आयुर्वेदो धनुर्वेदो गान्धर्वश्चेति ते त्रयः।\nअर्थशास्त्रं चतुर्थं तु विद्या ह्यष्टादशैव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2076308, "chapter_id": 2617, "verse_number": "१२-१२२-३३", "content_sanskrit": "दश चाष्टौ च विख्याता एता धर्मस्य संहिताः।\nएतासामेव विद्यानां व्यासमाह महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2076309, "chapter_id": 2617, "verse_number": "१२-१२२-३४", "content_sanskrit": "शतानि त्रीणि शास्त्राणां महातन्त्राणि सप्ततिम्।\nव्यास एव तु विद्यानां महादेवेन कीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2076310, "chapter_id": 2617, "verse_number": "१२-१२२-३५", "content_sanskrit": "तन्त्रं पाशुपतं नाम पञ्चरात्रं च विश्रुतम्।\nयोगशास्त्रं च साङ्ख्यं च तन्त्रं लोकायतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2076311, "chapter_id": 2617, "verse_number": "१२-१२२-३६", "content_sanskrit": "तन्त्रं ब्रह्मतुला नाम तर्कविद्या दिवौकसाम्।\nसुखदुःखार्थजिज्ञासा कारणं चेति विश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2076312, "chapter_id": 2617, "verse_number": "१२-१२२-३७", "content_sanskrit": "तर्कविद्यास्तथा चाष्टौ स चोक्तो न्यायविस्तरः।\nदश चाष्टौ च विज्ञेयाः पौराणा यज्ञसंहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2076313, "chapter_id": 2617, "verse_number": "१२-१२२-३८", "content_sanskrit": "पुराणाश्च प्रणीताश्च तावदेवेह संहिताः।\nधर्मशास्त्राणि तद्वच्च एकार्थानि च नान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2076314, "chapter_id": 2617, "verse_number": "१२-१२२-३९", "content_sanskrit": "एकार्थानि पुराणानि वेदाश्चैकार्यसंहिताः।\nनानार्थानि च सर्वाणि ततः शास्त्राणि शंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2076315, "chapter_id": 2617, "verse_number": "१२-१२२-४०", "content_sanskrit": "प्रोवाच भगवान्देवः कालज्ञानानि यानि च।\nचतुःषष्टिप्रमाणानि आयुर्वेदं च सोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2076316, "chapter_id": 2617, "verse_number": "१२-१२२-४१", "content_sanskrit": "अष्टादशविकल्पां तां दण्डनीतिं च शाश्वतीम्।\nगान्धर्वमितिहासं च नानाविस्तरमुक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2076317, "chapter_id": 2617, "verse_number": "१२-१२२-४२", "content_sanskrit": "इत्येताः शंकरप्रोक्ता विद्याः शब्दार्थसंहिताः।\nपुनर्भेदसहस्रं तु तासामेव तु विस्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2076318, "chapter_id": 2617, "verse_number": "१२-१२२-४३", "content_sanskrit": "ऋषिभिर्देवगन्धर्वैः सविकल्पः सविस्तरः।\nशश्वदभ्यस्यते लोके वेद एव तु सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2076319, "chapter_id": 2617, "verse_number": "१२-१२२-४४", "content_sanskrit": "वेदाश्चतस्रः संक्षिप्ता वेदवादाश्च ते स्मृताः।\nएतासां पारगो यश्च स चोक्तो वेदपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2076320, "chapter_id": 2617, "verse_number": "१२-१२२-४५", "content_sanskrit": "वेदानां पारगो रुद्रो विष्णुरिन्द्रो बृहस्पतिः।\nशक्रः स्वायंभुवश्चैव मनुः परमधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2076321, "chapter_id": 2617, "verse_number": "१२-१२२-४६", "content_sanskrit": "ब्रह्मा च परमो देवः सदा सर्वैः सुरासुरैः।\nसर्वस्यानुग्रहाच्चैव व्यासो वै वेदपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2076322, "chapter_id": 2617, "verse_number": "१२-१२२-४७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2076323, "chapter_id": 2617, "verse_number": "१२-१२२-४७", "content_sanskrit": "अहं शान्तनवो भीष्मः प्रसादान्माधवस्य च।\nशंकरस्य प्रसादाच्च ब्रह्मणश्च कुरूद्वह।\nवेदपारग इत्युक्तो याज्ञवल्क्यश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2076324, "chapter_id": 2617, "verse_number": "१२-१२२-४८", "content_sanskrit": "कल्पेकल्पे महाभागैर्ऋषिभिस्तत्त्वदर्शिभिः।\nऋषिपुत्रैर्ऋषिगणैर्भिद्यन्ते मिश्रकैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2076325, "chapter_id": 2617, "verse_number": "१२-१२२-४९", "content_sanskrit": "शिवेन ब्रह्मणा चैव विष्णुना च विकल्पिताः।\nआदिकल्पे पुनश्चैव भिद्यन्ते साधुभिः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2076326, "chapter_id": 2617, "verse_number": "१२-१२२-५०", "content_sanskrit": "इदानीमपि विद्वद्भिर्भिद्यन्ते च विकल्पकैः।\nपूर्वजन्मानुसारेण बहुधेयं सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2076327, "chapter_id": 2617, "verse_number": "१२-१२२-५१", "content_sanskrit": "भूयः स भगवान्ध्यात्वा चिरं शूलवरायुधः।\nतस्यतस्य निकायस्य चकारैकैकमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2076328, "chapter_id": 2617, "verse_number": "१२-१२२-५२", "content_sanskrit": "देवानामीश्वरं चक्रे दैवं दशशतेक्षणम्।\nयमं वैवस्वतं चापि पितॄणामकरोत्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2076329, "chapter_id": 2617, "verse_number": "१२-१२२-५३", "content_sanskrit": "अपां राज्ये सुराणां च विदधे वरुणं प्रभुम्।\nधनानां राक्षसानां च कुवेरमपि चेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2076330, "chapter_id": 2617, "verse_number": "१२-१२२-५४", "content_sanskrit": "पर्वतानां पतिं मेरुं सरितां च महोदधिम्।\nमृत्युं प्राणेश्वरमथो तेजसां च हुताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2076331, "chapter_id": 2617, "verse_number": "१२-१२२-५५", "content_sanskrit": "रुद्राणामपि चेशानं गोप्तारं विदधे प्रभुः।\nमहात्मानं महादेवं विशालाक्षं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2076332, "chapter_id": 2617, "verse_number": "१२-१२२-५६", "content_sanskrit": "`दश चैकश्च ये रुद्रास्तस्यैते मूर्तिसंभवाः।\nनानारूपधरो देवः स एव भगवाञ्शिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2076333, "chapter_id": 2617, "verse_number": "१२-१२२-५७", "content_sanskrit": "वसिष्ठमीशं विप्राणां वसूनां जातवेदसम्।\nतेजसां भास्करं चक्रे नक्षत्राणां निशाकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2076334, "chapter_id": 2617, "verse_number": "१२-१२२-५८", "content_sanskrit": "वीरुधां वसुमन्तं च भूतानां च प्रभुं वरम्।\nकुमारं द्वादशभुजं स्कन्दं राजानमादिशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2076335, "chapter_id": 2617, "verse_number": "१२-१२२-५९", "content_sanskrit": "कालं सर्वेशमकरोत्संहारविनयात्मकम्।\nमृत्योश्चतुर्विभागस्य दुःखस्य च सुखस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2076336, "chapter_id": 2617, "verse_number": "१२-१२२-६०", "content_sanskrit": "ईश्वरो देवदेवस्तु राजराजो नराधिपः।\nसर्वेषामेव रुद्राणां शूलपाणिरिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2076337, "chapter_id": 2617, "verse_number": "१२-१२२-६१", "content_sanskrit": "`ईश्वरश्चेतनः कर्ता पुरुषः कारणं शिवः।\nविष्णुर्ब्रह्मा शशी सूर्यः शक्रो देवाश्च सान्वयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2076338, "chapter_id": 2617, "verse_number": "१२-१२२-६२", "content_sanskrit": "सृजते ग्रसते चैतत्तमोभूतमिदं यथा।\nअप्रज्ञातं जगत्सर्वं यदा ह्येको महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2076339, "chapter_id": 2617, "verse_number": "१२-१२२-६३", "content_sanskrit": "तमेनं ब्रह्मणः पुत्रमनुजातं क्षुपं ददौ।\nप्रजानामधिपं श्रेष्ठं सर्वधर्मभृतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2076340, "chapter_id": 2617, "verse_number": "१२-१२२-६४", "content_sanskrit": "महादेवस्ततस्तस्मिन्वृत्ते यज्ञे समाहितः।\nदण़्डं धर्मस्य गोप्तारं विष्णवे सत्कृतं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2076341, "chapter_id": 2617, "verse_number": "१२-१२२-६५", "content_sanskrit": "विष्णुरङ्गिरसे प्रादादङ्गिरा मुनिसत्तमः।\nप्रादादिन्द्रमरीचिभ्या मरीचिर्भृगवे ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2076342, "chapter_id": 2617, "verse_number": "१२-१२२-६६", "content_sanskrit": "भृगुर्ददावृषिभ्यस्तु दण्डं धर्मसमाहितम्।\nऋषयो लोकपालेभ्यो लोकपालाः क्षुपाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2076343, "chapter_id": 2617, "verse_number": "१२-१२२-६७", "content_sanskrit": "क्षुपस्तु मनवे प्रादादादित्यतनयाय च।\nपुत्रेभ्यः श्राद्धदेवस्तु सूक्ष्मधर्मार्थकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2076344, "chapter_id": 2617, "verse_number": "१२-१२२-६८", "content_sanskrit": "विभज्य दण़्डः कर्तव्यो दण्डे तु नयमिच्छता।\nदुर्वाचा निग्रहो दण्डो हिरण्यं बाह्यतः क्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2076345, "chapter_id": 2617, "verse_number": "१२-१२२-६९", "content_sanskrit": "व्यङ्गत्वं च शरीरस्य वधो वाऽनल्पकारणात्।\nशरीरपीडा कार्या तु स्वदेशाच्च विवासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2076346, "chapter_id": 2617, "verse_number": "१२-१२२-७०", "content_sanskrit": "तं ददौ सूर्यपुत्राय मनवे रक्षणात्मकम्।\nआनुपूर्व्याच्च दण्डोऽयं प्रजा जागर्ति पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2076347, "chapter_id": 2617, "verse_number": "१२-१२२-७१", "content_sanskrit": "इन्द्रो जागर्ति भगवानिन्द्रादग्निर्विभावसुः।\nअग्नेर्जागर्ति वरुणो वरुणाच्च प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2076348, "chapter_id": 2617, "verse_number": "१२-१२२-७२", "content_sanskrit": "प्रजापतेस्ततो धर्मो जागर्ति विनयात्मकः।\nधर्माच्च ब्रह्मणः पुत्रो व्यवसायः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2076349, "chapter_id": 2617, "verse_number": "१२-१२२-७३", "content_sanskrit": "व्यवसायात्ततस्तेजो जागर्ति परिपालयत्।\nओषध्यस्तेजसस्तस्मादोषधीभ्यश्च पर्वताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2076350, "chapter_id": 2617, "verse_number": "१२-१२२-७४", "content_sanskrit": "पर्वतेभ्यश्च जागर्ति रसो रसगुणात्तथा।\nजागर्ति निर्ऋतिर्देवी ज्योतींषि निर्ऋतीमनु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2076351, "chapter_id": 2617, "verse_number": "१२-१२२-७५", "content_sanskrit": "वेदाः प्रतिष्ठा ज्योतिर्भ्यस्ततो हयशिराः प्रभुः।\nब्रह्मा पितामहस्तस्माज्जागर्ति प्रभुरव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2076352, "chapter_id": 2617, "verse_number": "१२-१२२-७६", "content_sanskrit": "पितामहान्महादेवो जागर्ति भगवाञ्शिवः।\nविश्वेदेवाः शिवाच्चापि विश्वेभ्य ऋषयस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2076353, "chapter_id": 2617, "verse_number": "१२-१२२-७७", "content_sanskrit": "ऋषिभ्यो भगवान्सोमः सोमाद्देवाः सनातनाः।\nदेवेभ्यो ब्राह्मणा लोके जाग्रतीत्युपधारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2076354, "chapter_id": 2617, "verse_number": "१२-१२२-७८", "content_sanskrit": "ब्राह्मणेभ्यश्च राजन्या लोकान्रक्षन्ति धर्मताः।\nस्थावरं जङ्गमं चैव क्षत्रियेभ्यः सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2076355, "chapter_id": 2617, "verse_number": "१२-१२२-७९", "content_sanskrit": "प्रजा जाग्रति लोकेऽस्मिन्दण्डो जागर्ति तासु च।\nसर्वसंक्षेपको दण़्डः पितामहसुतः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2076356, "chapter_id": 2617, "verse_number": "१२-१२२-८०", "content_sanskrit": "जागर्ति कालः पूर्वं च मध्ये चान्ते च भारत।\nईशः सर्वस्य कालो हि महादेवः प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2076357, "chapter_id": 2617, "verse_number": "१२-१२२-८१", "content_sanskrit": "देवदेवः शिवः सर्वो जागर्ति सततं प्रभुः।\nकपर्दी शंकरो रुद्रो भवः स्थाणुरुमापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2076358, "chapter_id": 2617, "verse_number": "१२-१२२-८२", "content_sanskrit": "इत्येष दण्डो व्याख्यातस्तथौषध्यस्तथापरे।\nभूमिपालो यथान्यायं वर्तेतानेन धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2076359, "chapter_id": 2617, "verse_number": "१२-१२२-८३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2076360, "chapter_id": 2617, "verse_number": "१२-१२२-८३", "content_sanskrit": "इतीदं वसुहोमस्य योऽऽत्मवाञ्शृणुयान्मतम्।\nश्रुत्वा सम्यक्प्रवर्तेत स लोकानाप्नुयान्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2076361, "chapter_id": 2617, "verse_number": "१२-१२२-८४", "content_sanskrit": "इति ते सर्वमाख्यातं यो दण्डो मनुजर्षभ।\nनियन्ता सर्वलोकस्य धर्माक्रान्तस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2076362, "chapter_id": 2617, "verse_number": "१२-१२२-८५", "content_sanskrit": "`वसुहोमाच्छ्रुतं राज्ञा मान्धात्रा भूभृता पुरा।\nमयापि कथितं राजन्नाख्यानं प्रथितं मया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2076363, "chapter_id": 2617, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्वाविंशत्यधिकशततमोऽध्यायः॥ १२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]