[{"id": 6000236000, "chapter_id": 10236, "verse_number": null, "content_sanskrit": "अथ चत्वारिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000236001, "chapter_id": 10236, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.001.m4a", "display_order": 2}, {"id": 6000236002, "chapter_id": 10236, "verse_number": "१०-४०-१", "content_sanskrit": "अथ व्रजन् राजपथेन माधवः स्‍त्रियं गृहीताङ्गविलेपभाजनाम्।\nविलोक्य कुब्जां युवतीं वराननां पप्रच्छ धात्रीं वचसा रसप्रदः॥ १०/४०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.002.m4a", "display_order": 3, "topics": [{"text": "कुब्जाया ऋज्वङ्गकरणम्", "range": "१–८"}]}, {"id": 6000236003, "chapter_id": 10236, "verse_number": "१०-४०-२", "content_sanskrit": "का त्वं वरोर्वेतदिहानुलेपनं कस्याङ्गने वा कथयस्व साधु नः।\nदेह्यावयोरङ्गविलेपमुत्तमं श्रेयस्ततस्ते नचिराद् भविष्यति॥ १०/४०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.003.m4a", "display_order": 4}, {"id": 6000236004, "chapter_id": 10236, "verse_number": null, "content_sanskrit": "सैरन्ध्य्रुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.004.m4a", "display_order": 5}, {"id": 6000236005, "chapter_id": 10236, "verse_number": "१०-४०-३", "content_sanskrit": "दास्यस्म्यहं ते सुरवर्य सम्मता त्रिवक्रनाम्नी ह्यनुलेपकर्मणि।\nमद्भावितं भोजपतेरतिप्रियं विना युवां कोऽन्यतमस्तदर्हति॥ १०/४०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.005.m4a", "display_order": 6}, {"id": 6000236006, "chapter_id": 10236, "verse_number": "१०-४०-४", "content_sanskrit": "रूपपेशलमाधुर्यहसितालापवीक्षितैः।\nधर्षितात्मा ददौ सान्द्रमुभयोरनुलेपनम्॥ १०/४०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.006.m4a", "display_order": 7}, {"id": 6000236007, "chapter_id": 10236, "verse_number": "१०-४०-५", "content_sanskrit": "ततस्तावङ्गरागेण स्ववर्णेतरशोभिना।\nसम्प्राप्तपरभागेन शुशुभातेऽनुरञ्जितौ॥ १०/४०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.007.m4a", "display_order": 8}, {"id": 6000236008, "chapter_id": 10236, "verse_number": "१०-४०-६", "content_sanskrit": "प्रसन्नो भगवान् कुब्जां त्रिवक्रां रुचिराननाम्।\nऋज्वीं कर्तुं मनश्चक्रे दर्शयन् दर्शने फलम्॥ १०/४०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.008.m4a", "display_order": 9}, {"id": 6000236009, "chapter_id": 10236, "verse_number": "१०-४०-७", "content_sanskrit": "पद्भ्यामाक्रम्य प्रपदे द्व्यङ्गुलोत्तानपाणिना।\nप्रगृह्य चिबुके ह्यास्यमुदनीनमदच्युतः॥ १०/४०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.009.m4a", "display_order": 10}, {"id": 6000236010, "chapter_id": 10236, "verse_number": "१०-४०-८", "content_sanskrit": "सा तदार्जुसमानाङ्गी बृहच्छ्रोणिपयोधरा।\nमुकुन्दस्पर्शनात् सद्यो बभूव प्रमदोत्तमा॥ १०/४०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.010.m4a", "display_order": 11}, {"id": 6000236011, "chapter_id": 10236, "verse_number": "१०-४०-९", "content_sanskrit": "ततो रूपगुणौदार्यसम्पन्ना प्राह केशवम्।\nउत्तरीयान्तमाकृष्य सस्मयं जातहृच्छया॥ १०/४०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.011.m4a", "display_order": 12, "topics": [{"text": "कंसधनुर्भङ्गकरणम्", "range": "९–१६"}]}, {"id": 6000236012, "chapter_id": 10236, "verse_number": "१०-४०-१०", "content_sanskrit": "एहि वीर गृहं यामो न त्वां त्यक्तुमिहोत्सहे।\nत्वयोन्मथितचित्तायाः प्रसीद पुरुषर्षभ॥ १०/४०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.012.m4a", "display_order": 13}, {"id": 6000236013, "chapter_id": 10236, "verse_number": "१०-४०-११", "content_sanskrit": "एवं स्‍त्रिया याच्यमानः कृष्णो रामस्य पश्यतः।\nमुखं वीक्ष्यानुगानां च प्रहसंस्तामुवाच ह॥ १०/४०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.013.m4a", "display_order": 14}, {"id": 6000236014, "chapter_id": 10236, "verse_number": "१०-४०-१२", "content_sanskrit": "एष्यामि ते गृहं सुभ्रु पुंसामाधिविकर्शनम्।\nसाधितार्थोऽगृहाणां नः पान्थानां त्वं परायणम्॥ १०/४०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.014.m4a", "display_order": 15}, {"id": 6000236015, "chapter_id": 10236, "verse_number": "१०-४०-१३", "content_sanskrit": "विसृज्य माध्व्या वाण्या तां व्रजन् मार्गे वणिक्पथैः।\nनानोपायनताम्बूलस्रग्गन्धैः साग्रजोऽर्चितः॥ १०/४०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.015.m4a", "display_order": 16}, {"id": 6000236016, "chapter_id": 10236, "verse_number": "१०-४०-१४", "content_sanskrit": "ततः पौरान् पृच्छमानो धनुषः स्थानमच्युतः।\nतस्मिन् प्रविष्टो ददृशे धनुरैन्द्रमिवाद्भुतम्॥ १०/४०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.016.m4a", "display_order": 17}, {"id": 6000236017, "chapter_id": 10236, "verse_number": "१०-४०-१५", "content_sanskrit": "पुरुषैर्बहुभिर्गुप्तमर्चितं परमर्द्धिमत्।\nवार्यमाणो नृभिः कृष्णः प्रसह्य धनुराददे॥ १०/४०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.017.m4a", "display_order": 18}, {"id": 6000236018, "chapter_id": 10236, "verse_number": "१०-४०-१६", "content_sanskrit": "करेण वामेन सलीलमुद्धृतं सज्यं च कृत्वा निमिषेण पश्यताम्।\nनृणां विकृष्य प्रबभञ्ज मध्यतो यथेक्षुदण्डं मदकर्युरुक्रमः॥ १०/४०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.018.m4a", "display_order": 19}, {"id": 6000236019, "chapter_id": 10236, "verse_number": "१०-४०-१७", "content_sanskrit": "धनुषो भज्यमानस्य शब्दः खं रोदसी दिशः।\nपूरयामास यं श्रुत्वा कंसस्‍त्रासमुपागमत्॥ १०/४०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.019.m4a", "display_order": 20, "topics": [{"text": "तद्रक्षिणां वधः", "range": "१७–२४"}]}, {"id": 6000236020, "chapter_id": 10236, "verse_number": "१०-४०-१८", "content_sanskrit": "तद्रक्षिणः सानुचराः कुपिता आततायिनः।\nग्रहीतुकामा आवव्रुर्गृह्यतां वध्यतामिति॥ १०/४०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.020.m4a", "display_order": 21}, {"id": 6000236021, "chapter_id": 10236, "verse_number": "१०-४०-१९", "content_sanskrit": "अथ तान् दुरभिप्रायान् विलोक्य बलकेशवौ।\nक्रुद्धौ धनुष आदाय शकले तांश्च जघ्नतुः॥ १०/४०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.021.m4a", "display_order": 22}, {"id": 6000236022, "chapter_id": 10236, "verse_number": "१०-४०-२०", "content_sanskrit": "बलं च कंसप्रहितं हत्वा शालामुखात् ततः।\nनिष्क्रम्य चेरतुर्हृष्टौ निरीक्ष्य पुरसम्पदः॥ १०/४०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.022.m4a", "display_order": 23}, {"id": 6000236023, "chapter_id": 10236, "verse_number": "१०-४०-२१", "content_sanskrit": "तयोस्तदद्भुतं वीर्यं निशम्य पुरवासिनः।\nतेजः प्रागल्भ्यरूपं च मेनिरे विबुधोत्तमौ॥ १०/४०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.023.m4a", "display_order": 24}, {"id": 6000236024, "chapter_id": 10236, "verse_number": "१०-४०-२२", "content_sanskrit": "तयोर्विचरतोः स्वैरमादित्योऽस्तमुपेयिवान्।\nकृष्णरामौ वृतौ गोपैः पुराच्छकटमीयतुः॥ १०/४०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.024.m4a", "display_order": 25}, {"id": 6000236025, "chapter_id": 10236, "verse_number": "१०-४०-२३", "content_sanskrit": "अवनिज्याङ्घ्रियुगलं भुक्त्वा क्षीरोपसेचनम्।\nऊषतुस्तां सुखं रात्रीं ज्ञात्वा कंसचिकीर्षितम्॥ १०/४०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.025.m4a", "display_order": 26}, {"id": 6000236026, "chapter_id": 10236, "verse_number": "१०-४०-२४", "content_sanskrit": "कंसस्तु धनुषो भङ्गं रक्षिणां स्वबलस्य च।\nवधं निशम्य गोविन्दरामविक्रीडितं परम्॥ १०/४०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.026.m4a", "display_order": 27}, {"id": 6000236027, "chapter_id": 10236, "verse_number": "१०-४०-२५", "content_sanskrit": "दीर्घप्रजागरो भीतो दुर्निमित्तानि दुर्मतिः।\nबहून्यचष्टोभयथा मृत्योर्दौत्यकराणि च॥ १०/४०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.027.m4a", "display_order": 28, "topics": [{"text": "कंसस्यारिष्टदर्शनम्", "range": "२५–३३"}]}, {"id": 6000236028, "chapter_id": 10236, "verse_number": "१०-४०-२६", "content_sanskrit": "अदर्शनं स्वशिरसः प्रतिरूपेषु सत्स्वपि।\nअसत्यपि द्वितीये च द्वैरूप्यं ज्योतिषां तथा॥ १०/४०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.028.m4a", "display_order": 29}, {"id": 6000236029, "chapter_id": 10236, "verse_number": "१०-४०-२७", "content_sanskrit": "छिद्रप्रतीतिश्छायायां प्राणघोषानुपश्रुतिः।\nस्वर्णप्रतीतिर्वृक्षेषु स्वपदानामदर्शनम्॥ १०/४०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.029.m4a", "display_order": 30}, {"id": 6000236030, "chapter_id": 10236, "verse_number": "१०-४०-२८", "content_sanskrit": "स्वप्ने प्रेतपरिष्वङ्गः खरयानं बिसादनम्।\nयायान्नलदमाल्येकस्तैलाभ्यङ्गो दिगम्बरः॥ १०/४०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.030.m4a", "display_order": 31}, {"id": 6000236031, "chapter_id": 10236, "verse_number": "१०-४०-२९", "content_sanskrit": "अन्यानि चेत्थम्भूतानि स्वप्नजागरितानि च।\nपश्यन् मरणसन्त्रस्तो निद्रां लेभे न चिन्तया॥ १०/४०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.031.m4a", "display_order": 32}, {"id": 6000236032, "chapter_id": 10236, "verse_number": "१०-४०-३०", "content_sanskrit": "व्युष्टायां निशि कौरव्य सूर्ये चाभिसमुत्थिते।\nकारयामास वै कंसो मल्लक्रीडामहोत्सवम्॥ १०/४०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.032.m4a", "display_order": 33}, {"id": 6000236033, "chapter_id": 10236, "verse_number": "१०-४०-३१", "content_sanskrit": "आनर्चुः पुरुषा रङ्गं तूर्यभेर्यश्च जघ्निरे।\nमञ्चाश्चालङ्कृताः स्रग्भिः पताकाचैलतोरणैः॥ १०/४०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.033.m4a", "display_order": 34}, {"id": 6000236034, "chapter_id": 10236, "verse_number": "१०-४०-३२", "content_sanskrit": "तेषु पौरा जानपदा ब्रह्मक्षत्त्रपुरोगमाः।\nयथोपजोषं विविशू राजानश्च कृतासनाः॥ १०/४०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.034.m4a", "display_order": 35}, {"id": 6000236035, "chapter_id": 10236, "verse_number": "१०-४०-३३", "content_sanskrit": "कंसः परिवृतोऽमात्यै राजमञ्च उपाविशत्।\nमण्डलेश्वरमध्यस्थो हृदयेन विदूयता॥ १०/४०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.035.m4a", "display_order": 36}, {"id": 6000236036, "chapter_id": 10236, "verse_number": "१०-४०-३४", "content_sanskrit": "वाद्यमानेषु तूर्येषु मल्लतालोत्तरेषु च।\nमल्लाः स्वलङ्कृता दृप्ताः सोपाध्यायाः समाविशन्॥ १०/४०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.036.m4a", "display_order": 37, "topics": [{"text": "परेऽहनि प्रातश्चचाणूरादीनां रङ्गप्रवेशः", "range": "३४–३६"}]}, {"id": 6000236037, "chapter_id": 10236, "verse_number": "१०-४०-३५", "content_sanskrit": "चाणूरो मुष्टिकः कूटः छलः कोसल एव च।\nत आसेदुरुपस्थानं वल्गुवाद्यप्रहर्षिताः॥ १०/४०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.037.m4a", "display_order": 38}, {"id": 6000236038, "chapter_id": 10236, "verse_number": "१०-४०-३६", "content_sanskrit": "नन्दगोपादयो गोपा भोजराजसमाहुताः।\nनिवेदितोपायनास्त एकस्मिन् मञ्च आविशन्॥ १०/४०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_040/BhP_10.040.038.m4a", "display_order": 39}, {"id": 6000236039, "chapter_id": 10236, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे चत्वारिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]