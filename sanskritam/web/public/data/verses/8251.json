[{"id": 900001869, "chapter_id": 8251, "verse_number": "8.1", "content_sanskrit": "दृप्तबालाकिर्हानूचानो गार्ग्य आस ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001870, "chapter_id": 8251, "verse_number": "8.2", "content_sanskrit": "स होवाच गार्ग्यो य एवासौ चन्द्रे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001871, "chapter_id": 8251, "verse_number": "8.3", "content_sanskrit": "", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001872, "chapter_id": 8251, "verse_number": "8.4", "content_sanskrit": "स होवाच गार्ग्यो य एवायमग्नौ पुरुष ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001873, "chapter_id": 8251, "verse_number": "8.5", "content_sanskrit": "स होवाच गार्ग्यो य एवायमप्सु पुरुष एतमेवाहं ब्रह्मोपास इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001874, "chapter_id": 8251, "verse_number": "8.6", "content_sanskrit": "स होवाचाजातशत्रुरेतावन्नू इत्येतावद्धीति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001875, "chapter_id": 8251, "verse_number": "8.7", "content_sanskrit": "स होवाचाजातशत्रुः प्रतिलोमं वै तद्यद्ब्राह्मणः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001876, "chapter_id": 8251, "verse_number": "8.8", "content_sanskrit": "स होवाचाजातशत्रुर्यत्रैष एतत्सुप्तोऽभूद्य एष विज्ञानमयः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001877, "chapter_id": 8251, "verse_number": "8.9", "content_sanskrit": "स यत्रैत् स्वप्नया चरति ते हास्य लोकास्तदुतेव महाराजो ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001878, "chapter_id": 8251, "verse_number": "8.10", "content_sanskrit": "अथ यदा सुषुप्तो भवति तदा न कस्यचन वेद ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001879, "chapter_id": 8251, "verse_number": "8.11", "content_sanskrit": "स यथोर्णनाभिस्तन्तुनोच्चरेद् यथाऽग्रे क्षुद्रा विस्फुलिङ्गा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001880, "chapter_id": 8251, "verse_number": "8.12", "content_sanskrit": "यो ह वै शिशुं साधानं सप्रत्याधानं सस्थूणं सदामं वेद ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001881, "chapter_id": 8251, "verse_number": "8.13", "content_sanskrit": "तमेताः सप्ताक्षितय उपतिष्ठन्ते तद्या इमा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900001882, "chapter_id": 8251, "verse_number": "8.14", "content_sanskrit": "तदेष श्लोको भवति अर्वाग्बिलश्चमस ऊर्ध्वबुध्नस्तस्मिन् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900001883, "chapter_id": 8251, "verse_number": "8.15", "content_sanskrit": "इमावेव गौतमभरद्वाजावयमेव गौतमोऽयं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900001884, "chapter_id": 8251, "verse_number": "8.16", "content_sanskrit": "द्वे वा ब्रह्मणो रूपे मूर्तं चैवामूर्तं च ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900001885, "chapter_id": 8251, "verse_number": "8.17", "content_sanskrit": "तदेतन्मूर्तं यदन्यद् वायोश्चान्तरिक्षाच्चैतन्मर्त्यमेतत्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900001886, "chapter_id": 8251, "verse_number": "8.18", "content_sanskrit": "अथामूर्तं वायुश्चान्तरिक्षं चैतदमृतमेतद् यदेतत् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900001887, "chapter_id": 8251, "verse_number": "8.19", "content_sanskrit": "अथाध्यात्मम् इदमेव मूर्तं यदन्यत् प्राणाच्च ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900001888, "chapter_id": 8251, "verse_number": "8.20", "content_sanskrit": "एतस्य हैतस्य पुरुषस्य रूपं यथा महारजनं वासो यथा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900001889, "chapter_id": 8251, "verse_number": "8.21", "content_sanskrit": "मूर्तामूर्तमेवाध्यात्मं प्राणा इत्युच्यन्ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900001890, "chapter_id": 8251, "verse_number": "8.22", "content_sanskrit": "सर्वज्ञौ च ततौ चैव नियतौ हरिणैव तौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900001891, "chapter_id": 8251, "verse_number": "8.23", "content_sanskrit": "मैत्रेयीति होवाच याज्ञवल्क्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900001892, "chapter_id": 8251, "verse_number": "8.24", "content_sanskrit": "ब्रह्म तं परादाद् योऽन्यत्रात्मनो ब्रह्म वेद ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900001893, "chapter_id": 8251, "verse_number": "8.25", "content_sanskrit": "स यथा दुन्दुभेर्हन्यमानस्य न बाह्याञ्च्छब्दाञ्च्छक्नुयाद् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900001894, "chapter_id": 8251, "verse_number": "8.26", "content_sanskrit": "स यथाऽऽर्द्रैधाग्नेरभ्याहितात् पृथग्धूमा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900001895, "chapter_id": 8251, "verse_number": "8.27", "content_sanskrit": "स यथा सर्वासामपां समुद्र एकायतनमेवं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900001896, "chapter_id": 8251, "verse_number": "8.28", "content_sanskrit": "स यथा सैन्धवखिल्य उदके प्रास्त उदकमेवानुविलीयेत ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900001897, "chapter_id": 8251, "verse_number": "8.29", "content_sanskrit": "सा होवाच मैत्रेय्यत्रैव मा भगवानमूमुहन्न प्रेत्य सञ्ज्ञास्तीति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900001898, "chapter_id": 8251, "verse_number": "8.30", "content_sanskrit": "मग्नस्य हि परेऽज्ञाने किन्न दुःखतरं भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900001899, "chapter_id": 8251, "verse_number": "8.31", "content_sanskrit": "पतिर्जाया प्रिया नैव स्वेच्छया तु भविष्यति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900001900, "chapter_id": 8251, "verse_number": "8.32", "content_sanskrit": "सर्वं विष्णौ स्थितं विष्णोर्जातं विष्णोर्वशे सदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900001901, "chapter_id": 8251, "verse_number": "8.33", "content_sanskrit": "सर्गे सर्गे तु यो नैव शब्दतोऽप्यन्यथा भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900001902, "chapter_id": 8251, "verse_number": "8.34", "content_sanskrit": "इयं पृथिवी सर्वेषां भूतानां मध्वस्यै पृथिव्यै सर्वाणि भूतानि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900001903, "chapter_id": 8251, "verse_number": "8.35", "content_sanskrit": "इदं वैतन्मधु दध्यङ्ग्ङाथर्वणोऽश्विभ्यामुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900001904, "chapter_id": 8251, "verse_number": "8.36", "content_sanskrit": "इदं वैतन्मधु दध्यङ्ग्ङाथर्वणोऽश्विभ्यामुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900001905, "chapter_id": 8251, "verse_number": "8.37", "content_sanskrit": "आत्मनामा परो विष्णुः सर्वगो यः प्रकीर्तितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900001906, "chapter_id": 8251, "verse_number": "8.38", "content_sanskrit": "स्वामित्वाद्राजशब्दोऽयमाधिक्यात्पालनात्तथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900001907, "chapter_id": 8251, "verse_number": "8.39", "content_sanskrit": "जीवे स्थितस्त्वात्मनामा सौवरः स्वरगः स्मृतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900001908, "chapter_id": 8251, "verse_number": "8.40", "content_sanskrit": "प्रत्यैरयतं प्रतिसमधत्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900001909, "chapter_id": 8251, "verse_number": "8.41", "content_sanskrit": "अथ वंशः पौतिमाष्यो गौपवनात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]