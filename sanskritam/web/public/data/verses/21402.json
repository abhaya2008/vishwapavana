[{"id": 7001402000, "chapter_id": 21402, "verse_number": "५-४९-१", "content_sanskrit": "मुनय ऊचुः ।\nउमाया भुवनेशान्यास्सूत सर्वार्थवित्तम ।\nअवतारं समाचक्ष्व यतो जाता सरस्वती॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001402001, "chapter_id": 21402, "verse_number": "५-४९-२", "content_sanskrit": "या गीयते परब्रह्ममूलप्रकृतिरीश्वरी ।\nनिराकारापि साकारा नित्या नन्दमथी सती॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001402002, "chapter_id": 21402, "verse_number": "५-४९-३", "content_sanskrit": "सूत उवाच ।\nतापसाः शृणुत प्रेम्णा चरित्रं परमं महत् ।\nयस्य विज्ञानमात्रेण नरो याति परां गतिम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001402003, "chapter_id": 21402, "verse_number": "५-४९-४", "content_sanskrit": "देवदानवयोर्युद्धमेकदासीत्परस्परम् ।\nमहामायाप्रभावेणामराणां विजयोऽभवत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001402004, "chapter_id": 21402, "verse_number": "५-४९-५", "content_sanskrit": "ततोऽवलिप्ता अमरास्स्वप्रशंसां वितेनिरे ।\nवयं धन्या वयं धन्या किं करिष्यंति नोऽसुराः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001402005, "chapter_id": 21402, "verse_number": "५-४९-६", "content_sanskrit": "ये प्रभावं समालोक्यास्माकं परमदुःसहम् ।\nभीता नागालयं याता यातयातेति वादिनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001402006, "chapter_id": 21402, "verse_number": "५-४९-७", "content_sanskrit": "अहो बलमहो तेजो दैत्यवंशक्षयंकरम् ।\nअहो भाग्यं सुमनसामेवं सर्वेऽभ्यवर्णयन्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001402007, "chapter_id": 21402, "verse_number": "५-४९-८", "content_sanskrit": "तत आविरभूत्तेजः कूटरूपन्तदैव हि ।\nअदृष्टपूर्वं तद्दृष्ट्वा विस्मिता अभवन्सुराः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001402008, "chapter_id": 21402, "verse_number": "५-४९-९", "content_sanskrit": "किमिदं किमिदं चेति रुद्धकण्ठास्समब्रुवन ।\nअजानन्तः परं श्यामानु भावं मानभञ्जनम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001402009, "chapter_id": 21402, "verse_number": "५-४९-१०", "content_sanskrit": "तत आज्ञापयद्देवान्देवानामधिनायकः ।\nयात यूयं परीक्षध्वं याथातथ्येन किन्विति॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001402010, "chapter_id": 21402, "verse_number": "५-४९-११", "content_sanskrit": "सुरेन्द्रप्रेरितो वायुर्महसः सन्निधिं गतः ।\nकस्त्वं भोरिति सम्बोध्यावोचदेनं च तन्महः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001402011, "chapter_id": 21402, "verse_number": "५-४९-१२", "content_sanskrit": "इति पृष्टस्तदा वायुर्महसातिगरीयसा ।\nवायुरस्मि जगत्प्राणस्साभिमानोऽब्रवीदिदम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001402012, "chapter_id": 21402, "verse_number": "५-४९-१३", "content_sanskrit": "जंगमाजंगमं सर्वमोतप्रोतमिदं जगत् ।\nमय्येव निखिलाधारे चालयाम्यखिलं जगत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001402013, "chapter_id": 21402, "verse_number": "५-४९-१४", "content_sanskrit": "तदोवाच महातेजः शक्तोऽसि यदि चालने ।\nधृतमेतत्तृणं वायो चालयस्व निजेच्छया॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001402014, "chapter_id": 21402, "verse_number": "५-४९-१५", "content_sanskrit": "ततः सर्वप्रयत्नेनाकरोद्यत्नं सदागतिः ।\nन चचाल यदा स्थानात्तदासौ लज्जितोऽभवत॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001402015, "chapter_id": 21402, "verse_number": "५-४९-१६", "content_sanskrit": "तूष्णीं भूत्वा ततो वायुर्जगामेन्द्रं सभां प्रति ।\nकथयामास तद् वृत्तं स्वकीयाभिभवान्वितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001402016, "chapter_id": 21402, "verse_number": "५-४९-१७", "content_sanskrit": "सर्वेशत्वं वयं सर्वे मृषैवात्मनि मन्महे ।\nन पारयामहे किंचिद्वि धातुं क्षुद्रवस्त्वपि॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001402017, "chapter_id": 21402, "verse_number": "५-४९-१८", "content_sanskrit": "ततश्च प्रेषयामास मरुत्वान्सकलान्सुरान् ।\nन शेकुस्ते यदा ज्ञातुं तदेन्द्रः स्वयमभ्यगात्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001402018, "chapter_id": 21402, "verse_number": "५-४९-१९", "content_sanskrit": "मघवन्तमथायान्तं दृष्ट्वा तेजोतिदुःसहम् ।\nबभूवान्तर्हितं सद्यो विस्मितोऽभूच्च वासवः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001402019, "chapter_id": 21402, "verse_number": "५-४९-२०", "content_sanskrit": "चरित्रमीदृशं यस्य तमेव शरणं श्रये ।\nइति संचिन्तयामास सहस्राक्षः पुनःपुनः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001402020, "chapter_id": 21402, "verse_number": "५-४९-२१", "content_sanskrit": "एतस्मिन्नंतरे तत्र निर्व्याजकरुणातनुः ।\nतेषामनुग्रहं कर्तुं हर्तुं गर्वं शिवांगना॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001402021, "chapter_id": 21402, "verse_number": "५-४९-२२", "content_sanskrit": "चैत्रशुक्लनवम्यां तु मध्याह्नस्थे दिवाकरे ।\nप्रादुरासीदुमा देवी सच्चिदानन्दरूपिणी॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001402022, "chapter_id": 21402, "verse_number": "५-४९-२३", "content_sanskrit": "महोमध्ये विराजन्ती भासयन्ती दिशो रुचा ।\nबोधयन्ती सुरान्सर्वान्ब्रह्मैवाहमिति स्फुटम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001402023, "chapter_id": 21402, "verse_number": "५-४९-२४", "content_sanskrit": "चतुर्भिर्दधती हस्तैर्वरपाशांकुशाभयान् ।\nश्रुतिभिस्सेविता रम्या नवयौवनगर्विता॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001402024, "chapter_id": 21402, "verse_number": "५-४९-२५", "content_sanskrit": "रक्ताम्बरपरीधाना रक्तमाल्यानुलेपना ।\nकोटिकंदर्प्पसंकाशा चन्द्रकोटिसमप्रभा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001402025, "chapter_id": 21402, "verse_number": "५-४९-२६", "content_sanskrit": "व्याजहार महामाया सर्वान्तर्य्यामिरूपिणी ।\nसाक्षिणी सर्वभूतानां परब्रह्मस्वरूपिणी॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001402026, "chapter_id": 21402, "verse_number": "५-४९-२७", "content_sanskrit": "उमोवाच ।\nन ब्रह्मा न सुरारातिर्न पुरारातिरीश्वरः ।\nमदग्रे गर्वितुं किंचित्का कथान्यसुपर्वणाम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001402027, "chapter_id": 21402, "verse_number": "५-४९-२८", "content_sanskrit": "परं ब्रह्म परं ज्योतिः प्रणवद्वन्द्वरूपिणी ।\nअहमेवास्मि सकलं मदन्यो नास्ति कश्चन॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001402028, "chapter_id": 21402, "verse_number": "५-४९-२९", "content_sanskrit": "निराकारापि साकारा सर्वतत्त्वस्वरूपिणी ।\nअप्रतर्क्यगुणा नित्या कार्यकारणरूपिणी॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001402029, "chapter_id": 21402, "verse_number": "५-४९-३०", "content_sanskrit": "कदाचिद्दयिताकारा कदाचित्पुरुषाकृतिः ।\nकदाचिदुभयाकारा सर्वाकाराहमीश्वरी॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001402030, "chapter_id": 21402, "verse_number": "५-४९-३१", "content_sanskrit": "विरञ्चिः सृष्टिकर्ताहं जगत्पाताहमच्युतः ।\nरुद्रः संहारकर्ताहं सर्वविश्वविमोहिनी॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001402031, "chapter_id": 21402, "verse_number": "५-४९-३२", "content_sanskrit": "कालिका कमलावाणी मुखास्सर्वा हि शक्तयः ।\nमदंशादेव संजातास्तथेमास्सकलाः कलाः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001402032, "chapter_id": 21402, "verse_number": "५-४९-३३", "content_sanskrit": "मत्प्रभावाज्जितास्सर्वे युष्माभिर्द्दितिनन्दनाः ।\nतामविज्ञाय मां यूयं वृथा सर्वेशमानिनः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001402033, "chapter_id": 21402, "verse_number": "५-४९-३४", "content_sanskrit": "यथा दारुमयीं योषां नर्तयत्यैन्द्रजालिकः ।\nतथैव सर्वभूतानि नर्तयाम्यहमीश्वरी॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001402034, "chapter_id": 21402, "verse_number": "५-४९-३५", "content_sanskrit": "मद्भयाद्वाति पवनः सर्वं दहति हव्यभुक् ।\nलोकपालाः प्रकुर्वंति स्वस्वकर्माण्यनारतम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001402035, "chapter_id": 21402, "verse_number": "५-४९-३६", "content_sanskrit": "कदाचिद्देववर्गाणां कदाचिद्दितिजन्म नाम् ।\nकरोमि विजयं सम्यक्स्वतन्त्रा निजलीलया॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001402036, "chapter_id": 21402, "verse_number": "५-४९-३७", "content_sanskrit": "अविनाशि परं धाम मायातीतं परात्परम् ।\nश्रुतयो वर्णयन्ते यत्त द्रूपन्तु ममैव हि॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001402037, "chapter_id": 21402, "verse_number": "५-४९-३८", "content_sanskrit": "सगुणं निर्गुणं चेति मद्रूपं द्विविधं मतम् ।\nमायाशबलितं चैकं द्वितीयन्तदनाश्रितम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001402038, "chapter_id": 21402, "verse_number": "५-४९-३९", "content_sanskrit": "एवं विज्ञाय मां देवास्स्वं स्वं गर्वं विहाय च ।\nभजत प्रणयोपेताः प्रकृतिं मां सनातनीम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001402039, "chapter_id": 21402, "verse_number": "५-४९-४०", "content_sanskrit": "इति देव्या वचः श्रुत्वा करुणागर्भितं सुराः ।\nतुष्टुवुः परमेशानीं भक्तिसंनतकन्धराः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001402040, "chapter_id": 21402, "verse_number": "५-४९-४१", "content_sanskrit": "क्षमस्व जगदीशानि प्रसीद परमेश्वरि ।\nमैवं भूयात्कदाचिन्नो गर्वो मातर्द्दयां कुरु॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001402041, "chapter_id": 21402, "verse_number": "५-४९-४२", "content_sanskrit": "ततःप्रभृति ते दैवा हित्वा गर्वं समाहिताः ।\nउमामाराधयामासुर्यथापूर्वं यथाविधि॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001402042, "chapter_id": 21402, "verse_number": "५-४९-४३", "content_sanskrit": "इति वः कथितो विप्रा उमाप्रादुर्भवो मया ।\nयस्य श्रवणमात्रेण परमं पदमश्नुते॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]