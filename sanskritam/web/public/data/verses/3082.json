[{"id": 2097131, "chapter_id": 3082, "verse_number": "१३-२१२-१", "content_sanskrit": "उमोवाच।\nदेवदेव नमस्तुभ्यं त्र्यक्ष भो वृषभध्वज।\nश्रुतं मे भगवन्सर्वं त्वत्प्रसादान्महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2097132, "chapter_id": 3082, "verse_number": "१३-२१२-२", "content_sanskrit": "सङ्गृहीतं मया तच्च तव वाक्यमनुत्तमम्।\nइदानीमस्ति संदेहो मानुषेष्विह कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2097133, "chapter_id": 3082, "verse_number": "१३-२१२-३", "content_sanskrit": "तुल्यप्राणशिरःकायो राजाऽयमिति मृश्यते।\nकेन कर्मविपाकेन सर्वप्राधान्यमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2097134, "chapter_id": 3082, "verse_number": "१३-२१२-४", "content_sanskrit": "स चापि दण्डयन्मर्त्यान्भर्त्सयन्विधमन्नपि।\nप्रेत्यभावे कथं लोकाँल्लभते पुण्यकर्मणा।\nराजवृत्तमहं तस्माच्छ्रोतुमिच्छामि मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2097135, "chapter_id": 3082, "verse_number": "१३-२१२-५x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2097136, "chapter_id": 3082, "verse_number": "१३-२१२-५", "content_sanskrit": "तदहं ते प्रवक्ष्यामि राजधर्मं शुभानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2097137, "chapter_id": 3082, "verse_number": "१३-२१२-६", "content_sanskrit": "राजायत्तं हि यत्सर्वं लोकवृत्तं शुभाशुभम्।\nमहतस्तपसो देवि फलं राज्यमिति स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2097138, "chapter_id": 3082, "verse_number": "१३-२१२-७", "content_sanskrit": "तपोदानमयं राज्यं परं स्थानं विधीयते।\nतस्माद्राज्ञः सदा मर्त्याः प्रणमन्ति यतस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2097139, "chapter_id": 3082, "verse_number": "१३-२१२-८", "content_sanskrit": "न्यायतस्त्वं महाभागे श्रोतुकामाऽसि भामिनि।\nतस्मात्तस्यैव चरितं जगत्पथ्यं शृणु प्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2097140, "chapter_id": 3082, "verse_number": "१३-२१२-९", "content_sanskrit": "अराजके पुरा त्वासीत्प्रजानां सङ्कुलं महत्।\nतदृष्ट्वा सङ्कुलं ब्रह्मा मनुं राज्ये न्यवेदयत्।\nतदाप्रभृति संदृष्टं राज्ञां वृत्तं शुभाशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2097141, "chapter_id": 3082, "verse_number": "१३-२१२-१०", "content_sanskrit": "तन्मे शृणु वरारोहे तस्य पथ्यं जगद्धितम्।\nयथा प्रेत्य लभेत्स्वर्गं यथा वीर्यं यशस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2097142, "chapter_id": 3082, "verse_number": "१३-२१२-११", "content_sanskrit": "पित्र्यं वा भूतपूर्वं वा स्वयमुत्पाद्य वा पुनः।\nराज्यधर्ममनुष्ठाय विधिवद्भोक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2097143, "chapter_id": 3082, "verse_number": "१३-२१२-१२", "content_sanskrit": "आत्मानमेव प्रथमं विनयैरुपपादयेत्।\nअनु भृत्यान्प्रजाः पश्चादित्येष विनयक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2097144, "chapter_id": 3082, "verse_number": "१३-२१२-१३", "content_sanskrit": "स्वामिनं चोषमां कृत्वा प्रजास्तद्वृत्तकाङ्क्षया।\nस्वयं विनयसम्पन्ना भवन्तीह शुभेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2097145, "chapter_id": 3082, "verse_number": "१३-२१२-१४", "content_sanskrit": "स्वस्मात्पूर्वतरा राजा विनयत्येव वै प्रजाः।\nअपहास्यो भवेत्तादृक्स्वदोषस्यानवेक्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2097146, "chapter_id": 3082, "verse_number": "१३-२१२-१५", "content_sanskrit": "विद्याभ्यासैर्वृद्धयोगैरात्मानं विनयं नयेत्।\nविद्या धर्मार्थफलिनी तद्विदो वृद्धसंज्ञिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2097147, "chapter_id": 3082, "verse_number": "१३-२१२-१६", "content_sanskrit": "इन्द्रियाणां जयो देवि अत ऊर्ध्वमुदाहृतः।\nअजये सुमहान्दोषो राजानं विनिपातयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2097148, "chapter_id": 3082, "verse_number": "१३-२१२-१७", "content_sanskrit": "पञ्चैव स्ववशे कृत्वा तदर्थान्पञ्च शोषयेत्।\nषडुत्सृज्य यथायोगं ज्ञानेन विनयेन च।\nसास्त्रचक्षुर्नयपरो भूत्वा भृत्यान्समाहरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2097149, "chapter_id": 3082, "verse_number": "१३-२१२-१८", "content_sanskrit": "वृत्तश्रुतकुलोपेतानुपधाबिः परीक्षितान्।\nअमात्यानुपधातीतान्सोपसर्पाञ्जितेन्द्रियान्।\nयोजयेत यथायोगं यथार्हं स्वेषु कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2097150, "chapter_id": 3082, "verse_number": "१३-२१२-१९", "content_sanskrit": "अमात्या बुद्धिसम्पन्ना राष्ट्रं बहुजनप्रियम्।\nदुराधर्षं पुरश्रेष्ठं कोशः कृच्छ्रसहः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2097151, "chapter_id": 3082, "verse_number": "१३-२१२-२०", "content_sanskrit": "अनुरक्तं बलं साम्नामद्वैधं मन्त्रमेव च।\nएताः प्रकृतयः स्वेषु स्वामी विनयतत्ववित्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2097152, "chapter_id": 3082, "verse_number": "१३-२१२-२१", "content_sanskrit": "प्रजानां रक्षणार्थाय सर्वमेतद्विनिर्मितम्।\nआभिः करणभूताभिः कुर्याल्लोकहितं नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2097153, "chapter_id": 3082, "verse_number": "१३-२१२-२२", "content_sanskrit": "आत्मरक्षा नरेन्द्रस्य प्रजारक्षार्थमिष्यते।\nतस्मात्सततमात्मानं संरक्षेदप्रमादवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2097154, "chapter_id": 3082, "verse_number": "१३-२१२-२३", "content_sanskrit": "भोजनाच्छादनस्नानाद्बहिर्निष्क्रमणादपि।\nनित्यं स्त्रीगणसंयोगाद्रक्षेदात्मानमात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2097155, "chapter_id": 3082, "verse_number": "१३-२१२-२४", "content_sanskrit": "स्वेभ्यश्चैव परेभ्यश्च शश्त्रादपि विषादपि।\nसततं पुत्रदारेभ्यो रक्षेदात्मानमात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2097156, "chapter_id": 3082, "verse_number": "१३-२१२-२५", "content_sanskrit": "सर्वेभ्य एव स्थानेभ्यो रक्षेदात्मानमात्मवान्।\nप्रजानां रक्षणार्थाय प्रजाहितकरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2097157, "chapter_id": 3082, "verse_number": "१३-२१२-२६", "content_sanskrit": "प्रजाकार्यं तु तत्कार्यं प्रजासौख्यं तु तत्सुखम्।\nप्रजाप्रियं प्रियं तस्य स्वहितं तु प्रजाहितम्।\nप्रजार्तं तस्य सर्वस्वमात्मार्थं न विधीयते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2097158, "chapter_id": 3082, "verse_number": "१३-२१२-२७", "content_sanskrit": "प्रकृतीनां हि रक्षार्थं रागद्वेषौ व्युदस्य च।\nउभयोः पक्षयोर्वादं श्रुत्वा चैव यथातथम्।\nतमर्थं विमृशेद्बुद्ध्या स्वयमातत्वदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2097159, "chapter_id": 3082, "verse_number": "१३-२१२-२८", "content_sanskrit": "तत्वविद्भिश्च बहुभिर्वृद्धैः सह नरोत्तमैः।\nकर्तारमपराधं च देशकालौ नयानयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2097160, "chapter_id": 3082, "verse_number": "१३-२१२-२९", "content_sanskrit": "ज्ञात्वा सम्यग्यथाशास्त्रं ततो दण्डं नयेन्नृषु।\nएवं कुर्वंल्लभेद्धर्मं पक्षपातविवर्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2097161, "chapter_id": 3082, "verse_number": "१३-२१२-३०", "content_sanskrit": "प्रत्यक्षाप्तोपदेशाभ्यामनुमानेन वा पुनः।\nबोद्धव्यं सततं राज्ञा देशवृत्तं शुभाशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2097162, "chapter_id": 3082, "verse_number": "१३-२१२-३१", "content_sanskrit": "चारैः कर्मप्रवृत्त्या च तद्विज्ञाय विचारयेत्।\nअशुभं निर्हरेत्सद्यो जोषयेच्छुभमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2097163, "chapter_id": 3082, "verse_number": "१३-२१२-३२", "content_sanskrit": "गर्ह्यान्विगर्हयेदेव पूज्यान्सम्पूजयेत्तथा।\nदण्ड्यांश्च दण्डयेद्देवि नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2097164, "chapter_id": 3082, "verse_number": "१३-२१२-३३", "content_sanskrit": "पञ्चावेक्षन्सदा मन्त्रं कुर्याद्बुद्धियुतैर्नरैः।\nकुलवृत्तश्रुतोपेतैर्नित्यं मन्त्रपरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2097165, "chapter_id": 3082, "verse_number": "१३-२१२-३४", "content_sanskrit": "कामकारेण वै मुख्यैर्न च मन्त्रमना भवेत्।\nराजा राष्ट्रहितापेक्षं सत्यधर्माणि कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2097166, "chapter_id": 3082, "verse_number": "१३-२१२-३५", "content_sanskrit": "सर्वोद्योगं स्वयं कुर्याद्दुर्गादिषु सदा नृषु।\nदेशवृद्धिकरान्भृत्यानप्रमादेन कारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2097167, "chapter_id": 3082, "verse_number": "१३-२१२-३६", "content_sanskrit": "देशक्षयकरान्सर्वानप्रियांश्च विवर्जयेत्।\nअहन्यहनि सम्पश्येदनुजीविगणं स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2097168, "chapter_id": 3082, "verse_number": "१३-२१२-३७", "content_sanskrit": "सुमुखः सुप्रियो दत्त्वा सम्यग्वृत्तं समाचरेत्।\nअधर्म्यं परुषं तीक्ष्णं वाक्यं वक्तुं न चार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2097169, "chapter_id": 3082, "verse_number": "१३-२१२-३८", "content_sanskrit": "असंविश्वास्य वचनं वक्तुं सत्सु न चार्हति।\nनरेनरे गुणान्दोषान्सम्यग्वेदितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2097170, "chapter_id": 3082, "verse_number": "१३-२१२-३९", "content_sanskrit": "स्वेङ्गितं वृणुयाद्धैर्यं न कुर्यात्क्षुद्रसंविदम्।\nपरेङ्गितज्ञो लोकेषु भूत्वा संसर्गमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2097171, "chapter_id": 3082, "verse_number": "१३-२१२-४०", "content_sanskrit": "स्वतश्च परतश्चैव परस्परभयादपि।\nअमानुषभयेभ्यश्च स्वाः प्रजाः पालयेन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2097172, "chapter_id": 3082, "verse_number": "१३-२१२-४१", "content_sanskrit": "लुब्धाः कठोराश्चाप्यस्य मानवा दस्युवृत्तयः।\nनिग्राह्या एव ते राज्ञा सङ्गृहीत्वा यतस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2097173, "chapter_id": 3082, "verse_number": "१३-२१२-४२", "content_sanskrit": "कुमारान्विनयोद्बोधैर्जन्मप्रभृति योजयेत्।\nतेषामात्मगुणोपेतं यौवराज्येन योजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2097174, "chapter_id": 3082, "verse_number": "१३-२१२-४३", "content_sanskrit": "प्रकृतीनां यथा न स्याद्राज्यभ्रंशो भवेद्भयम्।\nएतत्संचिन्तयेन्नित्यं तद्विधानं तथार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2097175, "chapter_id": 3082, "verse_number": "१३-२१२-४४", "content_sanskrit": "अराजकं क्षणमपि राज्यं न स्याद्धि शोभने।\nआत्मनोऽनुविधानाय यौवराज्यं सदेष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2097176, "chapter_id": 3082, "verse_number": "१३-२१२-४५", "content_sanskrit": "कुलजानां च वैद्यानां श्रोत्रियाणां तपस्विनाम्।\nअन्येषां वृत्तियुक्तानां विशेषं कर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2097177, "chapter_id": 3082, "verse_number": "१३-२१२-४६", "content_sanskrit": "आत्मार्थं राज्यतन्त्रार्थं कोशार्थं च समाचरेत्।\nदुर्गाद्राष्ट्रात्समुद्राच्च वणिग्भ्यः पुरुषात्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2097178, "chapter_id": 3082, "verse_number": "१३-२१२-४७", "content_sanskrit": "परात्मगुणसाराभ्यां भृत्यपोषणमाचरेत्।\nवाहनानां प्रकुर्वीत पोषणं योधकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2097179, "chapter_id": 3082, "verse_number": "१३-२१२-४८", "content_sanskrit": "सादरः सततं भूत्वा अवेक्षाव्रतमाचरेत्।\nचतुर्दा विभजेत्कोशं धर्मभृत्यात्मकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2097180, "chapter_id": 3082, "verse_number": "१३-२१२-४९", "content_sanskrit": "आपदर्थं च नीतिज्ञो देशकालवशेन तु।\nअनाथान्व्यथितान्वृद्धान्स्वे देशे पोषयेन्नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2097181, "chapter_id": 3082, "verse_number": "१३-२१२-५०", "content_sanskrit": "सन्धिं च विग्रहं चैव तद्विशेषांस्तथा पारन्।\nयथावत्संविमृश्यैव बुद्धिपूर्वं समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2097182, "chapter_id": 3082, "verse_number": "१३-२१२-५१", "content_sanskrit": "सर्वेषां सम्प्रियो भूत्वा मण्डलं सततं चरेत्।\nशुभेष्वपि च कार्येषु च चैकान्तः समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2097183, "chapter_id": 3082, "verse_number": "१३-२१२-५२", "content_sanskrit": "स्वतश्च परतश्चैव व्यसनानि विमृश्य सः।\nपरेणि धार्मिकान्योगान्नातीयाद्द्वेषलोभतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2097184, "chapter_id": 3082, "verse_number": "१३-२१२-५३", "content_sanskrit": "रक्ष्यत्वं वै प्रजाधर्मः क्षत्रधर्मस्तु रक्षणम्।\nकुनृपैः पीडितास्तस्मात्प्रजाः सर्वत्र पालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2097185, "chapter_id": 3082, "verse_number": "१३-२१२-५४", "content_sanskrit": "यात्राकालेऽनवेक्ष्यैव पश्चात्कोपफलोदयः।\nतद्युक्ताश्चापदश्चैव शासनादिति चिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2097186, "chapter_id": 3082, "verse_number": "१३-२१२-५५", "content_sanskrit": "व्यसनेभ्यो बलं रक्षेन्नयतो व्ययतोपि वा।\nप्रायशो वर्जयेद्युद्धं प्राणरक्षणकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2097187, "chapter_id": 3082, "verse_number": "१३-२१२-५६", "content_sanskrit": "कारणादेवि योद्धव्यं नात्मनः परदोषतः।\nसुयुद्धे प्राणमोक्षश्च तस्य धर्माय इष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2097188, "chapter_id": 3082, "verse_number": "१३-२१२-५७", "content_sanskrit": "अभियुक्तो बलवता कुर्यादापद्विधिं नृपः।\nअनुनीय तथा सर्वान्प्रजानां हितकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2097189, "chapter_id": 3082, "verse_number": "१३-२१२-५८", "content_sanskrit": "अन्यप्रकृतियुक्तानां राज्ञां वृत्तिविचारिणाम्।\nअन्यांश्चापत्प्रपन्नानां न तान्संयोक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2097190, "chapter_id": 3082, "verse_number": "१३-२१२-५९", "content_sanskrit": "शुभाशुभं यदा देवि व्रतं तूभयसाधनम्।\nआत्मैव तच्छुभं कुर्यादशुभं योजयेत्परान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2097191, "chapter_id": 3082, "verse_number": "१३-२१२-६०", "content_sanskrit": "एवमुद्देशतः प्रोक्तमलेपत्वं यथा भवेत्।\nएष देवि समासेन राजधर्मः प्रकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2097192, "chapter_id": 3082, "verse_number": "१३-२१२-६१", "content_sanskrit": "एवं संवर्तमानस्तु दण्डयन्भर्त्सयन्प्रजाः।\nनिष्कल्मषमवाप्नोति पद्मपत्रमिवाम्भसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2097193, "chapter_id": 3082, "verse_number": "१३-२१२-६२", "content_sanskrit": "एवं संवर्तमानस्य कालधर्मो यदा भवेत्।\nस्वर्गलोके तदा राजा त्रिदशैः सह तोष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2097194, "chapter_id": 3082, "verse_number": "१३-२१२-६३", "content_sanskrit": "द्विविधं राज्यवृत्तं च न्यायभाग्यसमन्वितम्।\nएवं न्यायानुगं वृत्तं कथितं ते शुभेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2097195, "chapter_id": 3082, "verse_number": "१३-२१२-६४", "content_sanskrit": "राज्यं न्यायानुगं तात बुद्धिशास्त्रानुगं भवेत्।\nधर्म्यं पथ्यं यशस्यं च स्वर्ग्यं चैव तथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2097196, "chapter_id": 3082, "verse_number": "१३-२१२-६५", "content_sanskrit": "राज्यं भाग्यानुगं नाम अयथावत्प्रदृश्यते।\nतत्तु शास्त्रविनिर्मुक्तं सतां कोपकरं भवेत्।\nअधर्म्यमयशस्यं च दुरन्तं च भवेद्ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2097197, "chapter_id": 3082, "verse_number": "१३-२१२-६६", "content_sanskrit": "यत्र स्वच्छन्दतः सर्वं क्रियते कर्म राजभिः।\nतत्र भाग्यवशाद्भृत्या लभन्ते न विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2097198, "chapter_id": 3082, "verse_number": "१३-२१२-६७", "content_sanskrit": "यत्र दण्ड्या न दण्ड्यन्ते पूज्यन्ते वा नराधमाः।\nयत्र सन्तोपि हन्यन्ते तत्र भाग्यानुगं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2097199, "chapter_id": 3082, "verse_number": "१३-२१२-६८", "content_sanskrit": "शुभाशुभं यथा यत्र विपरीतं प्रदृश्यते।\nराज्ञि चासुरपक्षे तु तत्र भाग्यानुगं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2097200, "chapter_id": 3082, "verse_number": "१३-२१२-६९", "content_sanskrit": "भाग्यानुगे तु राजानो वर्तमाना यथातथा।\nप्राप्याकीर्तिमनर्थं च इह लोके शुभेक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2097201, "chapter_id": 3082, "verse_number": "१३-२१२-७०", "content_sanskrit": "परत्र सुमहाघोरं तमः प्राप्य दुरत्ययम्।\nतिष्ठन्ति नरके देवि प्रलयान्तादिति स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2097202, "chapter_id": 3082, "verse_number": "१३-२१२-७१", "content_sanskrit": "मोक्षं दुष्कृतिनां चापि विद्यते कालपर्ययात्।\nनास्त्येव मोक्षणं देवि राज्ञां दुष्कृतिकारिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2097203, "chapter_id": 3082, "verse_number": "१३-२१२-७२", "content_sanskrit": "एतत्सर्वं समासेन राजवृत्तं शुभाशुभम्।\nकथितं ते महाभागे भूयः श्रोतुं किमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2097204, "chapter_id": 3082, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्वादशाधिकद्विशततमोऽध्यायः॥ २१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]