[{"id": 2095531, "chapter_id": 3038, "verse_number": "१३-१६८-१", "content_sanskrit": "`सनत्कुमार उवाच।\nइन्द्रियेभ्यो मनः पूर्वमहङ्कारस्ततः परम्।\nअहङ्कारात्परा बुद्धिर्बुद्धेः परतरं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095532, "chapter_id": 3038, "verse_number": "१३-१६८-२", "content_sanskrit": "महतः परमव्यक्तमव्यक्तात्पुरुषः परः।\nएतावदेतत्सांख्यानां दर्शनं देवसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095533, "chapter_id": 3038, "verse_number": "१३-१६८-३", "content_sanskrit": "अव्यक्तं बुद्ध्यहङ्कारौ महाभूतानि पञ्च च।\nमनस्तथा विशेषाश्च दश चैवेन्द्रियाणि च।\nएतास्तत्वचतुर्विंशन्महापुरुषसम्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095534, "chapter_id": 3038, "verse_number": "१३-१६८-४", "content_sanskrit": "बुद्ध्यामानेन देवेश चेतनेन महात्मना।\nसंयोगमेतयोर्नित्यमाहुरव्यक्तपुंसयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095535, "chapter_id": 3038, "verse_number": "१३-१६८-५", "content_sanskrit": "एकत्वं च बहुत्वं च सर्गप्रलयकोटिशः।\nतमःसंज्ञितमेतद्धि प्रवदन्ति त्रिशूलधृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095536, "chapter_id": 3038, "verse_number": "१३-१६८-६", "content_sanskrit": "समुत्पाट्य यथाव्यक्ताज्जीवा यान्ति पुनःपुनः।\nआदिरेष महानात्मा गुणानामिति नः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095537, "chapter_id": 3038, "verse_number": "१३-१६८-७", "content_sanskrit": "गुणस्थत्वाद्गुणं चैनमाहुरव्यक्तलक्षणम्।\nएतेनाध्युषितो व्यक्तस्त्रिगुणं चेतयत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095538, "chapter_id": 3038, "verse_number": "१३-१६८-८", "content_sanskrit": "अचेतनः प्रकृत्येषु न चान्यमनुबुध्यते।\nबुध्यमानो ह्यहंकारो नित्यं मानाप्रबोधनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095539, "chapter_id": 3038, "verse_number": "१३-१६८-९", "content_sanskrit": "विमलस्व विशुद्धस्य नीरुजस्य महात्मनः।\nविमलोदरशीलः स्याद्बुध्यमानाप्रबुद्धयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095540, "chapter_id": 3038, "verse_number": "१३-१६८-१०", "content_sanskrit": "द्रष्टा भवत्यभोक्ता च सत्वमूर्तिश्च निर्गुणः।\nबुध्यमानाप्रबुद्धाभ्यामन्य एव तु निर्गुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095541, "chapter_id": 3038, "verse_number": "१३-१६८-११", "content_sanskrit": "उपेक्षकः शुचिस्ताभ्यामुभाभ्यामयुतस्तथा।\nबुध्यमानो न बुध्येत बुद्धमेवं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095542, "chapter_id": 3038, "verse_number": "१३-१६८-१२", "content_sanskrit": "स एव बुद्धेरव्यक्तस्वभावत्वादचेतनः।\nसोहमेव न मेऽन्योस्ति य एवमभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095543, "chapter_id": 3038, "verse_number": "१३-१६८-१३", "content_sanskrit": "न मन्यते ममान्योस्ति येन चेतोस्म्यचेतनः।\nएवमेवाभिमन्येत बुध्यमानोप्यनात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095544, "chapter_id": 3038, "verse_number": "१३-१६८-१४", "content_sanskrit": "अहमेव न मेऽन्योस्ति न प्रबुद्धवशानुगः।\nअव्यक्तस्थो गुणानेष नित्यमेवाभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095545, "chapter_id": 3038, "verse_number": "१३-१६८-१५", "content_sanskrit": "तेनाधिष्ठिततत्वज्ञैर्महद्भिरभिधीयते।\nअहङ्कारेण संयुक्तस्ततस्ददभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095546, "chapter_id": 3038, "verse_number": "१३-१६८-१६", "content_sanskrit": "क्षेत्रं प्रविश्य दुर्बुद्धिर्बुद्ध्यमानो ह्यनात्मवान्।\nअहमेव सृजत्यन्यद्द्वितीयं लोकसारथिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095547, "chapter_id": 3038, "verse_number": "१३-१६८-१७", "content_sanskrit": "सर्वाभावैरहङ्कारैस्तृतीयं सर्गसंज्ञितम्।\nततो भूतान्यहङ्कारमहङ्कारो मनोऽसृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095548, "chapter_id": 3038, "verse_number": "१३-१६८-१८", "content_sanskrit": "सर्वस्नोतस्यभिमुखं सम्प्रावर्तत बुद्धिमान्।\nतथैव यज्ञे भूतेषु विषयार्थी पुनःपुनः।\nइन्द्रियैः सह शूलाङ्क पञ्च पञ्चभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095549, "chapter_id": 3038, "verse_number": "१३-१६८-१९", "content_sanskrit": "मनो वेद न चात्मानमङ्कारं प्रजापतिः।\nन वेद वाप्यहङ्कारो बुद्धिं बुद्धिमतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095550, "chapter_id": 3038, "verse_number": "१३-१६८-२०", "content_sanskrit": "एवमेते महाभाग नेतरे नयवादिनः।\nअहङ्कारेण संयुक्तः स्रोतस्यभिमुखः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095551, "chapter_id": 3038, "verse_number": "१३-१६८-२१", "content_sanskrit": "एवमेष विकारात्मा महापुरुषसञ्ज्ञकः।\nप्रतनोति जगत्कृत्स्नं पुनराददते सकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095552, "chapter_id": 3038, "verse_number": "१३-१६८-२२", "content_sanskrit": "ससंज्ञत्वाज्जगत्कृत्स्नमव्यक्तस्य हृदि स्थितम्।\nसंविशद्रजनीं कृत्स्नां निशान्ते दिवसागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095553, "chapter_id": 3038, "verse_number": "१३-१६८-२३", "content_sanskrit": "पुनरात्मा विजयते बहवो निर्गुणास्तथा।\nअज्ञानेन समायुक्तः सोव्यक्तेन तमोत्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095554, "chapter_id": 3038, "verse_number": "१३-१६८-२४", "content_sanskrit": "यदि ह्येषो नु मन्येत ममास्ति परतो वरः।\nस पुनः पुनरात्मानं न कुर्यादाक्षिपेत च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095555, "chapter_id": 3038, "verse_number": "१३-१६८-२५", "content_sanskrit": "एतमव्यक्तविषयं सूक्ष्मं मन्येत बुद्धिमान्।\nपञ्चविंशं महादेव महापुरुषवैकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2095556, "chapter_id": 3038, "verse_number": "१३-१६८-२६", "content_sanskrit": "प्रबुद्धौ बुद्धवानेतत्सृजमानमबुद्धवान्।\nगुणान्पुनश्च तानेव सोत्मनात्मनि निक्षिपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2095557, "chapter_id": 3038, "verse_number": "१३-१६८-२७", "content_sanskrit": "अव्यक्तस्य वशीभूतो योऽज्ञानस्य तमोत्मनः।\nबुध्यमानो ह्यबुद्धस्य बुद्धस्तदनुभुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2095558, "chapter_id": 3038, "verse_number": "१३-१६८-२८", "content_sanskrit": "उपेक्षकः शुचिर्व्यग्रः सोलिङ्गः सोव्रणोऽमलः।\nषड्विंशो भगवानास्ते बुद्धः शुद्धो निरामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2095559, "chapter_id": 3038, "verse_number": "१३-१६८-२९", "content_sanskrit": "अव्यक्तादिविशेषान्तमेतद्वैद्या वदन्त्युत।\nएतैरेव विहीनं तु केचिदाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2095560, "chapter_id": 3038, "verse_number": "१३-१६८-३०", "content_sanskrit": "निस्तत्वं बुध्यमानास्तु केचिदाहुर्महामते।\nकेचिदाहुर्महात्मानस्तत्वसंज्ञितमेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2095561, "chapter_id": 3038, "verse_number": "१३-१६८-३१", "content_sanskrit": "तत्वस्य श्रवणादेनं तत्वमेवं वदन्ति वै।\nसत्वसंश्रयणाच्चैव सत्ववन्तं महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2095562, "chapter_id": 3038, "verse_number": "१३-१६८-३२", "content_sanskrit": "एवमेष विकारात्मा बुध्यमानो महाभुज।\nअव्यक्तो भवते व्यक्तौ सत्वंसत्वं तथा गुणौ।\nविद्या च भवते विद्या भवेत्तु ग्रहसंज्ञितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2095563, "chapter_id": 3038, "verse_number": "१३-१६८-३३", "content_sanskrit": "य एवमनुबुद्ध्यन्ते योगसाङ्ख्याश्च तत्वतः।\nतेऽव्यक्तं शङ्करागाढं मुञ्चन्ते शास्त्रबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2095564, "chapter_id": 3038, "verse_number": "१३-१६८-३४", "content_sanskrit": "तेषामेतत्तु वदतां शास्त्रार्थं सूक्ष्मदर्शिनाम्।\nबुद्धिर्विस्तीर्यते सर्वं तैलबिन्दुरिवाम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2095565, "chapter_id": 3038, "verse_number": "१३-१६८-३५", "content_sanskrit": "विद्या तु सर्वविद्यानामवबोध इति स्मृतः।\nयेन विद्यामविद्यां च विन्दन्ति यतिसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2095566, "chapter_id": 3038, "verse_number": "१३-१६८-३६", "content_sanskrit": "सैषा त्रयी परा विद्या चतुर्थ्यान्वीक्षिकी स्मृता।\nयां बुद्ध्यमानो बुद्ध्येत बुद्ध्यात्मनि समं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2095567, "chapter_id": 3038, "verse_number": "१३-१६८-३७", "content_sanskrit": "अप्रबुद्धमथाव्यक्तमविद्यासंज्ञिकं स्मृतम्।\nविमोहितं तु शोकेन केवलेन समन्वितम्।\nएतद्बुद्ध्या भवेद्बुद्धः किमन्यद्बुद्धिलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2095568, "chapter_id": 3038, "verse_number": "१३-१६८-३८", "content_sanskrit": "ये त्वेतन्नावबुद्ध्यन्ते ते प्रबुद्धवशानुगाः।\nते पुनःपुनरव्यक्ताज्जनिष्यन्त्यबुधांत्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2095569, "chapter_id": 3038, "verse_number": "१३-१६८-३९", "content_sanskrit": "तमेव तुलयिष्यन्ति अबुद्धिवशवर्तिनः।\nये चाप्यन्ये तन्मनसस्तेप्येतत्फलभागिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2095570, "chapter_id": 3038, "verse_number": "१३-१६८-४०", "content_sanskrit": "विदित्वैनं न शोचन्ति योगोपेतार्थदर्शिनः।\nस्वातन्त्र्यं प्रतिलप्स्यन्ते केवलत्वं च भास्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2095571, "chapter_id": 3038, "verse_number": "१३-१६८-४१", "content_sanskrit": "अज्ञानबन्धनान्मुक्तास्तीर्णाः संसारबन्धनात्।\nअज्ञानसागरं घोरमगाधं तमसंज्ञकम्।\nयत्र मज्जन्ति भूतानि पुनःपुनररिंदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2095572, "chapter_id": 3038, "verse_number": "१३-१६८-४२", "content_sanskrit": "एषा विद्या तथाऽविद्या कथिता ते मयाऽर्थतः।\nयस्मिन्देयं च नो ग्राह्यं सांख्याः सांख्यं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2095573, "chapter_id": 3038, "verse_number": "१३-१६८-४३", "content_sanskrit": "तथा चैकत्वनानात्वमक्षरं क्षरमेव च।\nनिगदिष्यामि देवेश विमोक्षं त्रिविधं च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2095574, "chapter_id": 3038, "verse_number": "१३-१६८-४४", "content_sanskrit": "बुद्ध्यमानाप्रबुद्धाभ्यामबुद्धस्य प्रपञ्चनम्।\nभूय एव निबोध त्वं देवानां देवसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2095575, "chapter_id": 3038, "verse_number": "१३-१६८-४५", "content_sanskrit": "यच्च किञ्च श्रुतं न स्याद्दृष्टं चैव न किञ्चन।\nतच्च ते सम्प्रवक्ष्यामि एकाग्रः शृणु तत्परः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2095576, "chapter_id": 3038, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टषष्ट्यधिकशततमोऽध्यायः॥ १६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]