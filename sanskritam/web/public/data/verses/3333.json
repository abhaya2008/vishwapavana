[{"id": 2107965, "chapter_id": 3333, "verse_number": "", "content_sanskrit": "रुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2107966, "chapter_id": 3333, "verse_number": "१", "content_sanskrit": "कथं हिंसितवान् सर्पान् क्षत्रियो जनमेजयः ।\nसर्पा वा हिंसितास्तेन किमर्थम् ऋषिसत्तम \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2107967, "chapter_id": 3333, "verse_number": "२", "content_sanskrit": "किमर्थं मोक्षितास्तेन पन्नगाश्चैव शंस मे ।\nआस्तीकेन तदाचक्ष्व श्रोतुमिच्छाम्यशेषतः\t ॥ २॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2107968, "chapter_id": 3333, "verse_number": "", "content_sanskrit": "ऋषिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2107969, "chapter_id": 3333, "verse_number": "३", "content_sanskrit": "श्रोष्यसे त्वं रुरो वत्स आस्तीकचरितं महत् ।\nब्राह्मणानां कथयतामित्युक्त्वान्तरधीयत\t ॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2107970, "chapter_id": 3333, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2107971, "chapter_id": 3333, "verse_number": "४", "content_sanskrit": "रुरुस्त्वथ वनं सर्वं पर्यधावत् समन्ततः ।\nतमृषिं नष्टमन्विच्छन् संश्रान्तो न्यपतद् भुवि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2107972, "chapter_id": 3333, "verse_number": "५", "content_sanskrit": "स मोहं परमं गत्वा नष्टसञ्ज्ञ इवाभवत् ।\nतदृषेर्वचनं तद् वै चिन्तयानः पुनः पुनः\t ॥ ५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2107973, "chapter_id": 3333, "verse_number": "६", "content_sanskrit": "लब्धसञ्ज्ञो रुरुश्चायात् तच्चाचख्यौ पितुस्तदा ।\nपित्रे तु सर्वमाख्याय डुण्डुभस्य वचोऽर्थवत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2107974, "chapter_id": 3333, "verse_number": "७", "content_sanskrit": "अपृच्छत्पितरं भूयः सोऽस्तीकचरितं महत् ।\nयद् तदाख्यानमास्तीकं डुण्डुभेनाथ कीर्तितम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2107975, "chapter_id": 3333, "verse_number": "८", "content_sanskrit": "तत् कीर्त्यमानं भगवन् श्रोतुमर्हसि तत्वतः ।\nपिता चास्य तदाख्यानं पृष्टः सर्वं न्यवेदयत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2107976, "chapter_id": 3333, "verse_number": "९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि द्वादशोऽध्यायः ॥१२॥ ॥ पौलोमपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2107977, "chapter_id": 3333, "verse_number": "", "content_sanskrit": "॥ पौलोमपर्व समाप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]