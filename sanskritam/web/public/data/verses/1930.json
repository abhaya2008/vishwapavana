[{"id": 2041752, "chapter_id": 1930, "verse_number": "५-१७५-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041753, "chapter_id": 1930, "verse_number": "५-१७५-१", "content_sanskrit": "ततोऽहं समनुज्ञाप्य कालीं गन्धवतीं तदा।\nमन्त्रिणश्चर्त्विजश्चैव तथैव च पुरोहितान्।\nसमनुज्ञामिषं कन्यामम्बां ज्येष्ठां नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041754, "chapter_id": 1930, "verse_number": "५-१७५-२", "content_sanskrit": "अनुज्ञाता ययौ सा तु कन्या साल्वपतेः पुरम्।\nवृद्धैर्द्विजातिभिर्गुप्ता धात्र्या चानुगता तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041755, "chapter_id": 1930, "verse_number": "५-१७५-३", "content_sanskrit": "अतीत्य च तमध्वानमासमाद नराधिपम ।\nसा तमासाद्य राजानं साल्वं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041756, "chapter_id": 1930, "verse_number": "५-१७५-४", "content_sanskrit": "आगताहं महाबाहो त्वामुद्दिश्य महामते।\n`अभिनन्दस्व मां राजन्सदा प्रियहिते रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041757, "chapter_id": 1930, "verse_number": "५-१७५-५", "content_sanskrit": "प्रतिपादय मां राजन्धर्मादींश्चर धर्मतः ।\nत्वं हि मे मनसा ध्यातस्त्वया चाप्युपमन्त्रिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041758, "chapter_id": 1930, "verse_number": "५-१७५-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041759, "chapter_id": 1930, "verse_number": "५-१७५-६", "content_sanskrit": "तामब्रवीत्साल्वपतिः स्मयन्निव विशांपते।\nत्वयाऽन्यपूर्वया नाहं भार्यार्थी वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041760, "chapter_id": 1930, "verse_number": "५-१७५-७", "content_sanskrit": "गच्छ भद्रे पुनस्तत्र सकाशं भीष्मकस्य वै।\nनाहमिच्छामि भीष्मेण गृहीतां त्वां प्रसह्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041761, "chapter_id": 1930, "verse_number": "५-१७५-८", "content_sanskrit": "त्वं हि भीष्मेण निर्जित्य नीता प्रीतिमती तदा।\nपरामृश्य महायुद्धे निर्जित्य पृथिवीपतीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041762, "chapter_id": 1930, "verse_number": "५-१७५-९", "content_sanskrit": "नाहं त्वय्यन्यपूर्वायां भार्यार्थी वरवर्णिनि ।\nकथमस्मद्विधो राजा परपूर्वां प्रवेशयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041763, "chapter_id": 1930, "verse_number": "५-१७५-१०", "content_sanskrit": "नारीं विदितविज्ञानः परेषां धर्ममादिशन्।\nयथेष्टं गम्यतां भद्रे मा त्वां कालोऽत्यगादयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041764, "chapter_id": 1930, "verse_number": "५-१७५-११", "content_sanskrit": "अम्बा तमब्रवीद्राजन्ननङ्गशरपीडिता।\nनैवं वद महीपाल नैतदेवं कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041765, "chapter_id": 1930, "verse_number": "५-१७५-१२", "content_sanskrit": "नास्मि प्रीतिमती नीता भीष्मेणामित्रकर्शन ।\nबलान्नीतास्मि रुदती विद्राव्य पृथिवीपतीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041766, "chapter_id": 1930, "verse_number": "५-१७५-१३", "content_sanskrit": "भजस्व मां साल्वपते भक्तां बालामनागसम् ।\nभक्तानां हि परित्यागो न धर्मेषु प्रशस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041767, "chapter_id": 1930, "verse_number": "५-१७५-१४", "content_sanskrit": "साहमामन्त्र्य गाङ्गेयं समरेष्वनिवर्तिनम् ।\nअनुज्ञाता च तेनैव ततोऽहं भृशमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041768, "chapter_id": 1930, "verse_number": "५-१७५-१५", "content_sanskrit": "न स भीष्मो महाबाहुर्मामिच्छति विशांपते ।\nभ्रातृहेतोः समारम्भो भीष्मस्येति श्रुतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041769, "chapter_id": 1930, "verse_number": "५-१७५-१६", "content_sanskrit": "भगिन्यौ मम ये नीते अम्बिकाम्बालिके नृप।\nप्रादाद्विचित्रवीर्याय गाङ्गेयो हि यवीयसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041770, "chapter_id": 1930, "verse_number": "५-१७५-१७", "content_sanskrit": "यथा साल्वपते नान्यं वरं यामि कथंचन।\nत्वामृते पुरुषव्याघ्र तथा मूर्धानमालभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041771, "chapter_id": 1930, "verse_number": "५-१७५-१८", "content_sanskrit": "न चान्यपूर्वा राजेन्द्र त्वामहं समुपस्थिता।\nसत्यं ब्रवीमि साल्वैतत्सत्येनात्मानमालभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041772, "chapter_id": 1930, "verse_number": "५-१७५-१९", "content_sanskrit": "भजस्व मां विशालाक्ष स्वयं कन्यामुपस्थिताम्।\nअनन्यपूर्वां राजेन्द्र त्वत्प्रसादाभिकाङ्क्षिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041773, "chapter_id": 1930, "verse_number": "५-१७५-२०", "content_sanskrit": "तामेवं भाषमाणां तु साल्वः काशिपतेः सुताम्।\nअत्यजद्भरतश्रेष्ठ जीर्णां त्वचमिवोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041774, "chapter_id": 1930, "verse_number": "५-१७५-२१", "content_sanskrit": "एवं बहुविधैर्वाक्यैर्याच्यमानस्तया नृपः ।\nनाश्रद्दधत्साल्वपतिः कन्यायां भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041775, "chapter_id": 1930, "verse_number": "५-१७५-२२", "content_sanskrit": "ततः सा मन्युनाऽऽविष्टा ज्येष्ठा काशिपतेः सुता।\nअब्रवीत्साश्रुनयना बाष्पविप्लुतया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041776, "chapter_id": 1930, "verse_number": "५-१७५-२३", "content_sanskrit": "त्वया त्यक्ता गमिष्यामि यत्र तत्र विशांपते।\nतत्र मे गतयः सन्तु सन्तः सत्यं यथा ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041777, "chapter_id": 1930, "verse_number": "५-१७५-२४", "content_sanskrit": "एवं तां भाषमाणां तु कन्यां साल्वपतिस्तदा।\nपरितत्याज कौरव्य करुणं परिदेवतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041778, "chapter_id": 1930, "verse_number": "५-१७५-२५", "content_sanskrit": "गच्छ गच्छेति तां साल्वः पुनः पुनरभाषत।\nबिभेमि भीष्मात्सुश्रोणि त्वं च भीष्मपरिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041779, "chapter_id": 1930, "verse_number": "५-१७५-२६", "content_sanskrit": "एवमुक्ता तु सा तेन साल्वेनादीर्घदर्शिना ।\nनिश्चक्राम पुराद्दीना रुदती कुररी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041780, "chapter_id": 1930, "verse_number": "५-१७५-२७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041781, "chapter_id": 1930, "verse_number": "५-१७५-२७", "content_sanskrit": "निष्क्रामन्ती तु नगराच्चिन्तयामास दुःखिता ।\nपृथिव्यां नास्ति युवतिर्विषमस्थतरा मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041782, "chapter_id": 1930, "verse_number": "५-१७५-२८", "content_sanskrit": "बन्धुर्भिर्विप्रहीणास्मि साल्वेन च निराकृता ।\nन च शक्यं पुनर्गन्तुं मया वारणसाह्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041783, "chapter_id": 1930, "verse_number": "५-१७५-२९", "content_sanskrit": "अनुज्ञाता तु भीष्मेण साल्वमुद्दिश्य कारणम्।\nकिं नु गर्हाम्यथात्मानमथ भीष्मं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041784, "chapter_id": 1930, "verse_number": "५-१७५-३०", "content_sanskrit": "अथवा पितरं मूढं यो मेऽकार्षीत्स्वयंवरम् ।\nमयाऽयं स्वकृतो दोषो याऽहं भीष्मरथात्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041785, "chapter_id": 1930, "verse_number": "५-१७५-३१", "content_sanskrit": "प्रवृत्ते दारुणे युद्धे साल्वार्थं नापतं पुरा।\nतस्येयं फलनिर्वृत्तिर्यदापन्नाऽस्मि मूढवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041786, "chapter_id": 1930, "verse_number": "५-१७५-३२", "content_sanskrit": "धिग्भीष्मं धिक्क मे मन्दं पितरं मूढचेतसम् ।\nयेनाहं वीर्यशुल्केन पण्यस्त्रीव प्रचोदिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041787, "chapter_id": 1930, "verse_number": "५-१७५-३३", "content_sanskrit": "धिङ्मां धिक्साल्वराजानं धिग्धातारमथापि वा ।\nयेषां दुर्नीतभावेन प्राप्तास्म्यापदमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041788, "chapter_id": 1930, "verse_number": "५-१७५-३४", "content_sanskrit": "सर्वथा भागधेयानि स्वानि प्राप्नोति मानवः ।\nअनयस्यास्य तु मुखं भीष्मः शान्तनवो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041789, "chapter_id": 1930, "verse_number": "५-१७५-३५", "content_sanskrit": "सा भीष्मे प्रतिकर्तव्यमहं पश्यामि सांप्रतम् ।\nतपसा वा युधा वापि दुःखहेतुः स मे मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041790, "chapter_id": 1930, "verse_number": "५-१७५-३६", "content_sanskrit": "को नु भीष्मं युधा जेतुमुत्सहेत महीपतिः ।\nएवं सा परिनिश्चित्य जगाम नगराद्बहिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041791, "chapter_id": 1930, "verse_number": "५-१७५-३७", "content_sanskrit": "आश्रमं पुण्यशीलानां तापसानां महात्मनाम् ।\nततस्तामवसद्रात्रिं तापसैः परिवारिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041792, "chapter_id": 1930, "verse_number": "५-१७५-३८", "content_sanskrit": "आचख्यौ च यथावृत्तं सर्वमात्मनि भारत ।\nविस्तरेण महाबाहो निखिलेन शुचिस्मिता ।\nहरणं च विसर्गं च साल्वेन च विसर्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2041793, "chapter_id": 1930, "verse_number": "५-१७५-३९", "content_sanskrit": "ततस्तत्र महानासीद्ब्राह्मणः संशितव्रतः ।\nशैखावत्यस्तपोबृद्धः शास्त्रे चारण्यके गुरुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2041794, "chapter_id": 1930, "verse_number": "५-१७५-४०", "content_sanskrit": "आर्ता तामाह स मुनिः शैखावत्यो महातपाः ।\nनिःश्वसन्तीं सतीं बालां दुःखशोकपरायणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2041795, "chapter_id": 1930, "verse_number": "५-१७५-४१", "content_sanskrit": "एवं गते तु किं भद्रे शक्यं कर्तुं तपस्विभिः ।\nआश्रमस्थैर्महाभागे तपोयुक्तैर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2041796, "chapter_id": 1930, "verse_number": "५-१७५-४२", "content_sanskrit": "सा त्वेनमब्रवीद्राजन्क्रियतां मदनुग्रहः ।\nप्राव्राज्यमहमिच्छामि तपस्तप्स्यामि दुश्चरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2041797, "chapter_id": 1930, "verse_number": "५-१७५-४३", "content_sanskrit": "मयैव यानि कर्माणि पूर्वदेहे तु मूढया।\nकृतानि नूनं पापानि तेषामेतत्फलं ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2041798, "chapter_id": 1930, "verse_number": "५-१७५-४४", "content_sanskrit": "नोत्सहे तु पुनर्गन्तुं स्वजनं प्रति तापसाः ।\nप्रत्याख्याता निरानन्दा साल्वेन च निराकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2041799, "chapter_id": 1930, "verse_number": "५-१७५-४५", "content_sanskrit": "उपदिष्टमिहेच्छामि तापस्यं वीतकल्मषाः ।\nयुष्माभिर्देवसंकाशैः कृपा भवतु वो मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2041800, "chapter_id": 1930, "verse_number": "५-१७५-४६", "content_sanskrit": "स तामाश्वासयत्कन्यां दृष्टान्तागमहेतुभिः ।\nसान्त्वयामास कार्यं च प्रतिजज्ञे द्विजैः सह ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2041801, "chapter_id": 1930, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि पञ्चसप्तत्यधिकशत्तमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]