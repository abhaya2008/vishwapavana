[{"id": 2204932, "chapter_id": 5367, "verse_number": "१", "content_sanskrit": "भक्षयन्त्यपरे मांसं वर्जयन्त्यपरे विभो ।\nतन्मे वद महादेव भक्ष्याभक्ष्यस्य कारणम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204933, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204934, "chapter_id": 5367, "verse_number": "२", "content_sanskrit": "मांसस्य भक्षणे दोषो यश्चास्याभक्षणे गुणः ।\nतदहं कीर्तयिष्यामि तन्निबोध यथातथम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204935, "chapter_id": 5367, "verse_number": "३", "content_sanskrit": "इष्टं दत्तमधीतं च क्रतवश्च सदक्षिणाः ।\nअमांसभक्षणस्यैते कलां नार्हन्ति षोडशीम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204936, "chapter_id": 5367, "verse_number": "४", "content_sanskrit": "आत्मार्थं यः परप्राणान् हिंस्यात् स्वादुफलेप्सया ।\nव्यालगृध्रसृगालैश्च राक्षसैश्च समस्तु सः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204937, "chapter_id": 5367, "verse_number": "५", "content_sanskrit": "यो वृथा नित्यमांसाशी स पुमानधमो भवेत् ।\nततः कष्टतरं नास्ति स्वयमाहृत्य भक्षणात्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204938, "chapter_id": 5367, "verse_number": "६", "content_sanskrit": "स्वमांसं परमांसेन यो वर्धयितुमिच्छति ।\nउद्विग्नवासं लभते यत्रयत्रोपजायते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204939, "chapter_id": 5367, "verse_number": "७", "content_sanskrit": "सञ्छेदनं स्वमांसस्य यथा सञ्जनयेद् रुजम् ।\nतथैव परमांसेऽपि वेदितव्यं विजानता\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204940, "chapter_id": 5367, "verse_number": "८", "content_sanskrit": "यस्तु सर्वाणि मांसानि यावज्जीवं न भक्षयेत् ।\nस स्वर्गे विपुलं स्थानं लभते नात्र संशयः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204941, "chapter_id": 5367, "verse_number": "९", "content_sanskrit": "यस्तु वर्षशतं पूर्णं तप्यते परमं तपः ।\nयश्चापि वर्जयेन्मांसं सममेतन्न वा समम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204942, "chapter_id": 5367, "verse_number": "१०", "content_sanskrit": "न हि प्राणैः प्रियतमं लोके किञ्चन विद्यते ।\nतस्मात् प्राणिदया कार्या यथात्मनि तथा परे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204943, "chapter_id": 5367, "verse_number": "११", "content_sanskrit": "सर्वे यज्ञा न तत् कुर्युः सर्वे देवाश्च भामिनि ।\nयन्मांसरसमास्वाद्य पुनर्मांसानि विवर्जयेत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204944, "chapter_id": 5367, "verse_number": "१२", "content_sanskrit": "धर्मं यशस्यमायुष्यं स्वर्ग्यं स्वस्त्ययनं महत् ।\nइत्येवं मुनयः प्राहुर्मांसस्याभक्षणे गुणान् ।\nएवं बहुगुणं देवि नृणां मांसविवर्जनम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204945, "chapter_id": 5367, "verse_number": "१३", "content_sanskrit": "न शक्नुयाद् यदा जीवन् त्यक्तुं मांसं कथञ्चन ।\nत्रिपुण्यमासमात्रं वा वर्जनीयं विशेषतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204946, "chapter_id": 5367, "verse_number": "१४", "content_sanskrit": "न शक्नुयादपि तथा कौमुदीमासमेव च ।\nजन्मनक्षत्रतिथिषु सदा पर्वसु रात्रिषु ।\nवर्जनीयं तथा मांसं परत्र हितमिच्छता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204947, "chapter_id": 5367, "verse_number": "१५", "content_sanskrit": "अशक्तः कारणान्मर्त्यो भोक्तुमिच्छेद् विधिं शृणु ।\nअनेन खादन् विधिना कल्मषेण न लिप्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2204948, "chapter_id": 5367, "verse_number": "१६", "content_sanskrit": "हतानामुद्गतप्राणं क्रीत्वा न्यायेन भामिनि ।\nब्राह्मणातिथिपूजार्थं भोक्तव्यं हितमिच्छता\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2204949, "chapter_id": 5367, "verse_number": "१७", "content_sanskrit": "भैषज्यकारणाद् व्याधौ खादन् पापैर्न लिप्यते ।\nपितृशेषं तथैवाश्नन् मांसं नाशुभमृच्छति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2204950, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2204951, "chapter_id": 5367, "verse_number": "१८", "content_sanskrit": "गुरुपूजा कथं देव क्रियते धर्मचारिभिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2204952, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2204953, "chapter_id": 5367, "verse_number": "१९", "content_sanskrit": "गुरुपूजां प्रवक्ष्यामि यथावत् तव शोभने ।\nकृतज्ञानां परो धर्म इति वेदानुशासनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2204954, "chapter_id": 5367, "verse_number": "२०", "content_sanskrit": "तस्मात् स्वगुरवः पूज्यास्ते हि पूर्वोपकारिणः ।\nगुरूणां च गरीयांसस्त्रयो लोकेषु पूजिताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2204955, "chapter_id": 5367, "verse_number": "२१", "content_sanskrit": "उपाध्यायः पिता माता सम्पूज्यास्ते विशेषतः ।\nये पितुर्भ्रातरो ज्येष्ठा ये च तस्यानुजास्तथा ।\nपितुः पिता च सर्वे ते पूजनीयाः तथा पिता\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2204956, "chapter_id": 5367, "verse_number": "२२", "content_sanskrit": "मातुर्या भगिनी ज्येष्ठा मातुर्या च यवीयसी ।\nमातामही च धात्री च सर्वास्ता मातरः स्मृताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2204957, "chapter_id": 5367, "verse_number": "२३", "content_sanskrit": "उपाध्यायस्य यः पुत्रो यश्च तस्य भवेद् गुरुः ।\nऋत्विग्गुरुः पिता चेति गुरवः सम्प्रकीर्तिताः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2204958, "chapter_id": 5367, "verse_number": "२४", "content_sanskrit": "ज्येष्ठो भ्राता नरेन्द्रश्च मातुलः श्वशुरस्तथा ।\nभयत्राता च भर्ता च गुरवस्ते प्रकीर्तिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2204959, "chapter_id": 5367, "verse_number": "२५", "content_sanskrit": "इत्येष कथितः साध्वि गुरूणां सर्वसङ्ग्रहः ।\nअनुवृत्तिं च पूजां च तेषामपि निबोध मे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2204960, "chapter_id": 5367, "verse_number": "२६", "content_sanskrit": "अवध्यौ मातापितरावुपाध्यायस्तथैव च ।\nकथञ्चिन्नावमन्तव्या नरेण हितमिच्छता\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2204961, "chapter_id": 5367, "verse_number": "२७", "content_sanskrit": "येन प्रीणन्ति पितरस्तेन प्रीतः प्रजापतिः ।\nयेन प्रीणाति चेन्माता प्रीताः स्युर्देवमातरः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2204962, "chapter_id": 5367, "verse_number": "२८", "content_sanskrit": "येन प्रीणात्युपाध्यायो ब्रह्मा तेनाभिपूजितः ।\nअप्रीतेषु पुनस्तेषु नरो नरकमेति हि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2204963, "chapter_id": 5367, "verse_number": "२९", "content_sanskrit": "गुरूणां वैरनिर्बन्धो न कर्तव्यः कथञ्चन ।\nनरकं स गुरुप्रीत्या मनसाऽपि न गच्छति\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2204964, "chapter_id": 5367, "verse_number": "३०", "content_sanskrit": "न ब्रूयाद् विप्रियं तेषामनिष्टे न प्रवर्तयेत् ।\nविगृह्य न वदेत् तेषां समीपे स्पर्धया क्वचित्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2204965, "chapter_id": 5367, "verse_number": "३१", "content_sanskrit": "यद्यदिच्छन्ति ते कर्तुमस्वतन्त्रस्तदाचरेत् ।\nवेदानुशासनसमं गुरुशासनमिष्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2204966, "chapter_id": 5367, "verse_number": "३२", "content_sanskrit": "कलहांश्च विवादांश्च गुरुभिः सह वर्जयेत् ।\nकैतवं परिहासांश्च मन्युकामाश्रयाः कथाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2204967, "chapter_id": 5367, "verse_number": "३३", "content_sanskrit": "गुरूणां योऽनहंवादी करोत्याज्ञामतन्द्रितः ।\nन तस्मात् सर्वमर्त्येषु विद्यते पुण्यकृत्तमः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2204968, "chapter_id": 5367, "verse_number": "३४", "content_sanskrit": "असूयामपवादांश्च गुरूणां परिवर्जयेत् ।\nतेषां प्रियहितान्वेषी भूत्वा परिचरेत् सदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2204969, "chapter_id": 5367, "verse_number": "३५", "content_sanskrit": "न तद् यज्ञफलं कुर्यात् तपो वाऽऽचरितं महत् ।\nयत् कुर्यात् पुरुषस्येह गुरुपूजा सदा कृता\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2204970, "chapter_id": 5367, "verse_number": "३६", "content_sanskrit": "अनुवृत्तेर्विना धर्मो नास्ति सर्वाश्रमेष्वपि ।\nतस्मात् समादृतः काले गुरुवृत्तिं समाचरेत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2204971, "chapter_id": 5367, "verse_number": "३७", "content_sanskrit": "स्वमर्थं स्वशरीरं च गुर्वर्थे सन्त्यजेद् बुधः ।\nविवादं धनहेतोर्वा मोहाद्वा तैर्न रोचयेत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2204972, "chapter_id": 5367, "verse_number": "३८", "content_sanskrit": "ब्रह्मचर्यमहिंसा च दानानि विविधानि च ।\nगुरुभिः प्रतिषिद्धस्य सर्वमेतदपार्थकम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2204973, "chapter_id": 5367, "verse_number": "३९", "content_sanskrit": "उपाध्यायं पितरं मातरं च\nयेऽभिद्रुह्युर्मनसा कर्मणा वा ।\nतेषां पापं भ्रूणहत्याविशिष्टं\nतेभ्यो नान्यः पापकृदस्ति लोके \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2204974, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2204975, "chapter_id": 5367, "verse_number": "४०", "content_sanskrit": "उपवासविधिं तत्र तन्मे शंसितुमर्हसि\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2204976, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2204977, "chapter_id": 5367, "verse_number": "४१", "content_sanskrit": "शरीरमलशान्त्यर्थमिन्द्रियोच्छोषणाय च ।\nएकभुक्तोपवासैस्तु धारयन्ते व्रतं नराः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2204978, "chapter_id": 5367, "verse_number": "४२", "content_sanskrit": "लभन्ते विपुलं धर्मं तथाऽऽहारपरिक्षयात् ।\nबहूनामुपरोधं तु न कुर्यादात्मकारणात्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2204979, "chapter_id": 5367, "verse_number": "४३", "content_sanskrit": "जीवोपघातं च तथा धान्यं सञ्जीव्यमिष्यते ।\nतस्मात् पुण्यं लभेन्मर्त्यः स्वयमाहारकर्शनात् ।\nतद् गृहस्थैर्यथाशक्ति कर्तव्यमिति निश्चयः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2204980, "chapter_id": 5367, "verse_number": "४४", "content_sanskrit": "उपवासार्दिते काये आपदर्थं पयो जलम् ।\nभुञ्जन्न प्रतिघाती स्याद् ब्राह्मणाननुमान्य च\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2204981, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2204982, "chapter_id": 5367, "verse_number": "४५", "content_sanskrit": "ब्रह्मचर्यं कथं देव रक्षितव्यं विजानता\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2204983, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2204984, "chapter_id": 5367, "verse_number": "४६", "content_sanskrit": "तदहं ते प्रवक्ष्यामि शृणु देवि समाहिता\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2204985, "chapter_id": 5367, "verse_number": "४७", "content_sanskrit": "ब्रह्मचर्यं परं शौचं ब्रह्मचर्यं परं तपः ।\nकेवलं ब्रह्मचर्येण प्राप्यते परमं पदम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2204986, "chapter_id": 5367, "verse_number": "४८", "content_sanskrit": "सङ्कल्पाद् दर्शनाच्चैव तद्युक्तवचनादपि ।\nसंस्पर्शादथ संयोगात् पञ्चधा रक्षितं व्रतम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2204987, "chapter_id": 5367, "verse_number": "४९", "content_sanskrit": "व्रतवद् धारितं चैव ब्रह्मचर्यमकल्मषम् ।\nनित्यसंरक्षणं तस्य नैष्ठिकानां विधीयते ।\nतदिष्यते गृहस्थानां कालमुद्दिश्य कारणम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2204988, "chapter_id": 5367, "verse_number": "५०", "content_sanskrit": "जन्मनक्षत्रयोगेषु पुण्यवासेषु पर्वसु ।\nदेवताधर्मकार्येषु ब्रह्मचर्यव्रतं चरेत्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2204989, "chapter_id": 5367, "verse_number": "५१", "content_sanskrit": "ब्रह्मचर्यव्रतफलं लभेद् दारव्रती सदा ।\nशौचमायुस्तथाऽऽरोग्यं लभ्यते ब्रह्मचारिभिः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2204990, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2204991, "chapter_id": 5367, "verse_number": "५२", "content_sanskrit": "तीर्थचर्याव्रतं देव क्रियते धर्मकाङ्क्षिभिः ।\nकानि तीर्थानि लोकेश तन्मे शंसितुमर्हसि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2204992, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2204993, "chapter_id": 5367, "verse_number": "५३", "content_sanskrit": "हन्त ते कथयिष्यामि तीर्थस्नानविधिं प्रिये ।\nपावनार्थं च शौचार्थं ब्रह्मणा निर्मितं पुरा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2204994, "chapter_id": 5367, "verse_number": "५४", "content_sanskrit": "यास्तु लोके महानद्यस्ताः सर्वास्तीर्थसञ्ज्ञिताः ।\nतासां प्राक्स्रोतसः श्रेष्ठाः सङ्गमश्च परस्परम् ।\nतासां सागरसंयोगो वरिष्ठश्चेति विद्यते\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2204995, "chapter_id": 5367, "verse_number": "५५", "content_sanskrit": "तासामुभयतः कूलं यत्र तत्र मनीषिभिः ।\nदेवैर्वा सेवितं देवि तत्तीर्थं परमं स्मृतम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2204996, "chapter_id": 5367, "verse_number": "५६", "content_sanskrit": "समुद्रश्च महातीर्थं पावनं परमं शुभम् ।\nतस्य कूलगतास्तीर्था महद्भिश्च समाप्लुताः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2204997, "chapter_id": 5367, "verse_number": "५७", "content_sanskrit": "स्रोतसां पर्वतानां च जोषितानां महर्षिभिः ।\nअपि कूपतटाकं वा मुनिभिः सेवितं प्रिये\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2204998, "chapter_id": 5367, "verse_number": "५८", "content_sanskrit": "तत्तु तीर्थमिति ज्ञेयं प्रभावात्तु तपस्विनाम् ।\nतदाप्रभृति तीर्थत्वं लेभे लोकहिताय वै\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2204999, "chapter_id": 5367, "verse_number": "५९", "content_sanskrit": "एवं तीर्थोद्भवं विद्धि तस्य स्नानविधिं शृणु\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2205000, "chapter_id": 5367, "verse_number": "६०", "content_sanskrit": "तन्मना व्रतभूयिष्ठो गत्वा तीर्थाभिकाङ्क्षया ।\nउपवासत्रयं कुर्यादेकं वा नियमान्वितः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2205001, "chapter_id": 5367, "verse_number": "६१", "content_sanskrit": "पुण्यमासयुते काले पौर्णमास्यां यथाविधि ।\nबहिरेव शुचिर्भूत्वा तत्तीर्थं तन्मना विशेत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2205002, "chapter_id": 5367, "verse_number": "६२", "content_sanskrit": "त्रिराप्लुत्य जलाभ्याशे दत्त्वा ब्राह्मणदक्षिणाम् ।\nअभ्यर्च्य देवायतनं ततः प्रायाद् यथागतम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2205003, "chapter_id": 5367, "verse_number": "६३", "content_sanskrit": "एतद् विधानं सर्वेषां तीर्थं तीर्थं प्रति प्रिये ।\nसमीपतीर्थस्नानात् तु दूरतीर्थं सुपूजितम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2205004, "chapter_id": 5367, "verse_number": "६४", "content_sanskrit": "आदिप्रभृतिशुद्धस्य तीर्थस्नानं शुभं भवेत् ।\nतपोर्थं पापनाशार्थं शौचार्थं तीर्थगाहनम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2205005, "chapter_id": 5367, "verse_number": "६५", "content_sanskrit": "एवं पुण्येषु मासेषु तीर्थस्नानं शुभं भवेत् ।\nएतन्नैयमिकं सर्वं सुकृतं कथितं तव\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2205006, "chapter_id": 5367, "verse_number": "२१८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे भक्ष्याभक्ष्यकथनं गुरुसेवातीर्थस्नानप्रकरणं नाम अष्टादशोत्तरद्विशततमोऽध्यायः ॥२१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2205007, "chapter_id": 5367, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]