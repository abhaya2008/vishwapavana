[{"id": 7002911000, "chapter_id": 22911, "verse_number": "९-१९६-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअथातः संप्रवक्ष्यामि लवणाचलमुत्तमम् ।\nयत्प्रदानान्नरो लोकमाप्नोति शिवसंयुतम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002911001, "chapter_id": 22911, "verse_number": "९-१९६-२", "content_sanskrit": "उत्तमः षोडशद्रोणः कर्तब्यो लवणाचलः ।\nमध्यमः स्यात्तदर्धेन तदर्द्धेनाधमः स्मृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002911002, "chapter_id": 22911, "verse_number": "९-१९६-३", "content_sanskrit": "वित्तहीनो यथाशक्त्या द्रोणादर्धं तु कारयेत् ।\nचतुर्थांशेन विषयान्पर्वतान्कारयेत्पृथक् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002911003, "chapter_id": 22911, "verse_number": "९-१९६-४", "content_sanskrit": "विधानं पूर्ववत्कुर्याद्ब्रह्मादीनां च सर्वदा ।\nतद्वद्धेमतरून्सर्वांल्लोकपालनिवेशनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002911004, "chapter_id": 22911, "verse_number": "९-१९६-५", "content_sanskrit": "शिरांसि कामदेवादींस्तद्वत्तत्र निवेशयेत् ।\nकुर्याज्जागरमत्रापि दानमंत्रान्निबोध मे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002911005, "chapter_id": 22911, "verse_number": "९-१९६-६", "content_sanskrit": "सौभाग्यरससंभूतो यतोऽयं लवणोरसः ।\nदानात्मकत्वेन च मां पाहि पापान्नगोत्तम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002911006, "chapter_id": 22911, "verse_number": "९-१९६-७", "content_sanskrit": "तस्मादन्नरसाः सर्वे नोत्कृष्टा लवणं विना ।\nप्रियं च शिवयोर्नित्यं तस्माक्छांतिप्रदो भव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002911007, "chapter_id": 22911, "verse_number": "९-१९६-८", "content_sanskrit": "विष्णुदेह समुद्भूतं यस्मादारोग्यवर्धनम् ।\nयस्मात्पर्वतरूपेण पाहि संसारसागरात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002911008, "chapter_id": 22911, "verse_number": "९-१९६-९", "content_sanskrit": "अनेन विधिना यस्तु दद्याल्लवणपर्वतम् ।\nउमालोके वसेत्कल्पं ततो याति परां गतिम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002911009, "chapter_id": 22911, "verse_number": "९-१९६-१०", "content_sanskrit": "पुण्यक्षयादिहाभ्येत्य राजा भवति धार्मिकः ।\nपुत्रपौत्रैः परिवृतो जीवेच्च शरदां शतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002911010, "chapter_id": 22911, "verse_number": "९-१९६-११", "content_sanskrit": "कुर्वंति ये लवण पर्वतसंप्रदानं संप्राप्नुवंति दिवि ते सुमहद्विमानम् ।\nतत्राप्सरोगणसुरासुरसेव्यमानास्तिष्ठंति हृष्टमनसो दिवि वृद्धमानाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]