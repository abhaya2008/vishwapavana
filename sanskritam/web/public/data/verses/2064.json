[{"id": 2048257, "chapter_id": 2064, "verse_number": "६-११३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048258, "chapter_id": 2064, "verse_number": "६-११३-१", "content_sanskrit": "भगदत्तः कृपः शल्यः कृतवर्ता तथैव च।\nविन्दानुविन्दावावन्त्यौ सैन्धवश्च जयद्रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048259, "chapter_id": 2064, "verse_number": "६-११३-२", "content_sanskrit": "चित्रसेनो विकर्णश्च तथा दुर्मर्षणो युवा।\nदशैते तावका योधा भीमसेनमयोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048260, "chapter_id": 2064, "verse_number": "६-११३-३", "content_sanskrit": "महत्या सेनया युक्ता नानादेशसमुत्थया ।\nभीष्मस्य समरे राजन्प्रार्थयाना महद्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048261, "chapter_id": 2064, "verse_number": "६-११३-४", "content_sanskrit": "शल्यस्तु नवभिर्बाणैर्भीमसेनमताडयत् ।\nकृतवर्मा त्रिभिर्भाणैः कृपश्च नवभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048262, "chapter_id": 2064, "verse_number": "६-११३-५", "content_sanskrit": "चित्रसेनो विकर्णश्च भगदत्तश्च मारिष ।\nदशभिर्दशभिर्बाणैर्भीमसेनमताडयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048263, "chapter_id": 2064, "verse_number": "६-११३-६", "content_sanskrit": "सैन्धवश्च त्रिभिर्बाणैर्भीमसेनमडायत् ।\nविन्दानुविन्दावावन्त्यौ पञ्चभिः पञ्चभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048264, "chapter_id": 2064, "verse_number": "६-११३-७", "content_sanskrit": "दुर्मर्षणस्तु विंशत्या पाण्डवं निशितैः शरैः।\nस तान्सर्वान्महाराज राजमानान्पृथक्पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048265, "chapter_id": 2064, "verse_number": "६-११३-८", "content_sanskrit": "प्रवीरान्सर्वलोकस्य धार्तराष्ट्रान्महारथान् ।\nजघान समरे वीरः पाण्डवः परवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048266, "chapter_id": 2064, "verse_number": "६-११३-९", "content_sanskrit": "सप्तभिः शल्यमाविध्यत्कृतवर्माणमष्टभिः ।\nकृपस्य सशरं चापं मध्ये चिच्छेद भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048267, "chapter_id": 2064, "verse_number": "६-११३-१०", "content_sanskrit": "अथैनं च्छिन्नधन्वानं पुनर्विव्याध सप्तभिः ।\nविन्दानुविन्दौ च तथा त्रिभिस्त्रिभिरताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048268, "chapter_id": 2064, "verse_number": "६-११३-११", "content_sanskrit": "दुर्मर्षणं च विंशत्या चित्रसेनं च पञ्चभिः ।\nविकर्णं दशभिर्बाणैः पञ्चभिश्च जयद्रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048269, "chapter_id": 2064, "verse_number": "६-११३-१२", "content_sanskrit": "विद्ध्वा भीमोऽनदद्धृष्टः सैन्धवं च पुनस्त्रिभिः ।\nअथान्यद्धनुरादाय गौतमो रथिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048270, "chapter_id": 2064, "verse_number": "६-११३-१३", "content_sanskrit": "भीमं विव्याध संरब्धो दशभिर्निशितैः शरैः।\nस विद्धो दशभिर्बाणैस्तोत्रैरिव महाद्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048271, "chapter_id": 2064, "verse_number": "६-११३-१४", "content_sanskrit": "ततः क्रुद्धो महाराज भीमसेनः प्रतापवान् ।\nगौतमं ताडयामास शरैर्बहुभिराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048272, "chapter_id": 2064, "verse_number": "६-११३-१५", "content_sanskrit": "सैन्धवस्य तथाऽश्वांश्च सारथिं च त्रिभिः शरैः ।\nप्राहिणोन्मृत्युलोकाय कालान्तकसमद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048273, "chapter_id": 2064, "verse_number": "६-११३-१६", "content_sanskrit": "हताश्वात्तु रथात्तूर्णमवप्लुत्य महारथः ।\nशरांश्चिक्षेप निशितान्भीमसेनस्य संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048274, "chapter_id": 2064, "verse_number": "६-११३-१७", "content_sanskrit": "तस्य भीमो धनुर्मध्ये द्वाभ्यां चिच्छेद मारिष ।\nभल्लाभ्यां भरतश्रेष्ठ सैन्धवस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048275, "chapter_id": 2064, "verse_number": "६-११३-१८", "content_sanskrit": "स च्छिन्नधन्वा विरथो हताश्वो हतसारथिः ।\nचित्रसेनरथं राजन्नारुरोह त्वरान्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048276, "chapter_id": 2064, "verse_number": "६-११३-१९", "content_sanskrit": "अत्यद्भुतं रणे कर्म कृतवांस्तत्र पाण्डवः ।\nमहारथाञ्शरैर्विद्ध्वा वारयित्वा च मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048277, "chapter_id": 2064, "verse_number": "६-११३-२०", "content_sanskrit": "विरथं सैन्धवं चक्रे सर्वलोकस्य पश्यतः ।\nतदा न ममृषे शल्यो भीमसेस्य विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048278, "chapter_id": 2064, "verse_number": "६-११३-२१", "content_sanskrit": "स संधाय शरांस्तीक्ष्णान्करमारपरिमार्जितान् ।\nभीमं विव्याध समरे तिष्ठितिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048279, "chapter_id": 2064, "verse_number": "६-११३-२२", "content_sanskrit": "कृपश्च कृतवर्माच भगदत्तश्च वीर्यवान् ।\nविन्दानुविन्दावावन्त्यौ चित्रसेनश्च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048280, "chapter_id": 2064, "verse_number": "६-११३-२३", "content_sanskrit": "दुर्मर्षणो विकर्णश्च सिन्धुराजश्च वीर्यवान्।\nभीमं ते विव्यधुस्तूर्णं शल्यहेतोररिन्दमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048281, "chapter_id": 2064, "verse_number": "६-११३-२४", "content_sanskrit": "स च तान्प्रति विव्याध पञ्चभिः पञ्चभिः शरैःक ।\nशल्यं विव्याध सप्तत्या पुनश्च दशभिः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048282, "chapter_id": 2064, "verse_number": "६-११३-२५", "content_sanskrit": "तं शल्यो नवभिर्भित्त्वा पुनर्विव्याध पञ्चभिः ।\nसारथिं चास्य भल्लेन गाढं विव्याध मर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048283, "chapter_id": 2064, "verse_number": "६-११३-२६", "content_sanskrit": "विशोकं प्रेक्ष्य निर्भिन्नं भीमसेनः प्रतापवान् ।\nमद्रराजं त्रिभिर्बाणैर्बाह्वोरुरुसि चार्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048284, "chapter_id": 2064, "verse_number": "६-११३-२७", "content_sanskrit": "तथेतरान्महेष्वासांस्त्रिभिस्त्रिभिरजिह्मगैः ।\nताजयामास समरे सिंहवाद्विननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048285, "chapter_id": 2064, "verse_number": "६-११३-२८", "content_sanskrit": "ते हि यत्ता महेष्वासाः पाण्डवं युद्धकोविदम् ।\nत्रिभिस्त्रिभिरकुण्ठाग्रैर्भृशं मर्मस्वताडयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048286, "chapter_id": 2064, "verse_number": "६-११३-२९", "content_sanskrit": "सोऽतिविद्धो महेष्वासो भीमसेनो न विव्यथे ।\nपर्वतो वारिधाराभिर्वर्षमाणैरिवाम्बुदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048287, "chapter_id": 2064, "verse_number": "६-११३-३०", "content_sanskrit": "स तु क्रोधसमाविष्टः पाण्डवानां महारथः ।\nमद्रेश्वरं त्रिभिर्बाणैर्भृशं विद्ध्वा महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048288, "chapter_id": 2064, "verse_number": "६-११३-३१", "content_sanskrit": "कृपं च नवभिर्बाणैर्भृशं विद्ध्वा समन्ततः ।\nप्रग्ज्योतिषं शतैराजौ राजन्विव्याध सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048289, "chapter_id": 2064, "verse_number": "६-११३-३२", "content_sanskrit": "ततस्तु सशरं चापं सात्वतस्य महात्मनः ।\nक्षुरप्रेण सुतीक्ष्णेन चिच्छेद कृतहस्तवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048290, "chapter_id": 2064, "verse_number": "६-११३-३३", "content_sanskrit": "तथान्यद्धनुरादाय कृतवर्मा वृकोदरम् ।\nआजघान भ्रुवोर्मध्ये नाराचेन परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048291, "chapter_id": 2064, "verse_number": "६-११३-३४", "content_sanskrit": "भीमस्तु समरे विद्ध्वा शल्यं नवभिरायसैः ।\nभगदत्तं त्रिभिश्चैव कृतवर्माणमष्टभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048292, "chapter_id": 2064, "verse_number": "६-११३-३५", "content_sanskrit": "द्वाभ्यां द्वाभ्यां तु विव्याध गौतमप्रभृतीन्रथान् ।\nतेऽपि तं समरे राजन्विव्यधुर्निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048293, "chapter_id": 2064, "verse_number": "६-११३-३६", "content_sanskrit": "स तथा पीड्यमानोऽपि सर्वशस्त्रैर्महारथैः ।\nमत्वा तृणेन तांस्तुल्यान्विचचार गतव्यथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048294, "chapter_id": 2064, "verse_number": "६-११३-३७", "content_sanskrit": "ते चापि रथिनां श्रेष्ठा भीमाय निशिताञ्शरान् ।\nप्रेषयामासुरव्याग्राः शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048295, "chapter_id": 2064, "verse_number": "६-११३-३८", "content_sanskrit": "तस्य शक्तिं महावेगां भगदत्तो महारथः।\nचिक्षेप समरे वीरः स्वर्णदण्डां महमते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048296, "chapter_id": 2064, "verse_number": "६-११३-३९", "content_sanskrit": "तोमरं सैन्धवो राजा पट्टसं च महाभुजः ।\nशतघ्नीं च कृपो राजञ्छरं शल्यश्च संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048297, "chapter_id": 2064, "verse_number": "६-११३-४०", "content_sanskrit": "अथेतरे महेष्वासाः पञ्च पञ्च शिलीमुखान् ।\nभीमसेनं समुद्दिश्य प्रेषयमासुरोजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048298, "chapter_id": 2064, "verse_number": "६-११३-४१", "content_sanskrit": "तोमरं च द्विधा चक्रे क्षुरप्रेणानिलात्मजः ।\nपट्टसं च त्रिभिर्बाणैश्चिच्छेद तिलकाण्डवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048299, "chapter_id": 2064, "verse_number": "६-११३-४२", "content_sanskrit": "स बिभेद शतघ्नीं च नवभिः कङ्कपत्रिभिः ।\nमद्रराजप्रयुक्तं च शरं छित्त्वा महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048300, "chapter_id": 2064, "verse_number": "६-११३-४३", "content_sanskrit": "शक्तिं चिच्छेद सहसा भगदत्तेरितां रणे।\nतथेतराञ्शरान्घोराञ्शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048301, "chapter_id": 2064, "verse_number": "६-११३-४४", "content_sanskrit": "भीमसेनो रणश्लाघी त्रिधैकैकं समाच्छिनत्।\nतांश्च सर्वान्महेष्वासांस्त्रिभिस्त्रिभिरताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048302, "chapter_id": 2064, "verse_number": "६-११३-४५", "content_sanskrit": "ततो धनञ्जयस्तत्र वर्तमाने महारणे ।\nआजगाम रथेनाजौ भीमं दृष्ट्वा महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048303, "chapter_id": 2064, "verse_number": "६-११३-४६", "content_sanskrit": "निघ्नन्तं समरे शत्रून्योधयानं च सायकैः ।\nतौ तु तत्र महात्मानौ समेतौ वीक्ष्य पाण्डवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048304, "chapter_id": 2064, "verse_number": "६-११३-४७", "content_sanskrit": "न शशंसुर्जयं तत्र तावकाः पुरुषर्षभाः ।\nअथार्जुनो रणे भीमं योधयन्तं महारथान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2048305, "chapter_id": 2064, "verse_number": "६-११३-४८", "content_sanskrit": "भीष्मस्य निधनाकाङ्क्षी पुरस्कृत्य शिखण्डिनम्।\nआससाद रणे वीरांस्तावकान्दश भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2048306, "chapter_id": 2064, "verse_number": "६-११३-४९", "content_sanskrit": "ये स्म भीमं रणे राजन्योधयन्तो व्यवस्थिताः।\nबीभत्सुस्तानथाविध्यद्भीमस्य प्रियकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2048307, "chapter_id": 2064, "verse_number": "६-११३-५०", "content_sanskrit": "ततो दुर्योधनो राजा सुशर्माणमचोदयत् ।\nअर्जुनस्य वधार्थाय भीमसेनस्य चोभयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2048308, "chapter_id": 2064, "verse_number": "६-११३-५१", "content_sanskrit": "सुशर्मन्गच्छ शीघ्रं त्वं बलौघैः परिवारितः ।\nजहि पाण्डुसुतावेतौ धनञ्जयवृकोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2048309, "chapter_id": 2064, "verse_number": "६-११३-५२", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य त्रैगर्तः प्रस्थलाधिपः ।\nअभिद्रुत्य रणे भीममर्जुनं चैव धन्विनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2048310, "chapter_id": 2064, "verse_number": "६-११३-५३", "content_sanskrit": "रथैरनेकसाहस्रैः समन्तात्पर्यवारयत् ।\nततः प्रववृते युद्धमर्जुनस्य परैः सह ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2048311, "chapter_id": 2064, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशमदिवसयुद्धे त्रयोदशाधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-११३-२१ कर्मारं शस्त्रोल्लेखनयन्त्रम् ॥ ६-११३-३२ सात्वतस्य कृतवर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]