[{"id": 7004079000, "chapter_id": 24079, "verse_number": "४-२८-१", "content_sanskrit": "उमोवाच ।\nकिंचित्प्रष्टुमना नाथ स्वसंदेहापनुत्तये ।\nवद खेदो यदि न ते त्रिकालज्ञानकोविद ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004079001, "chapter_id": 24079, "verse_number": "४-२८-२", "content_sanskrit": "तदा भगीरथो राजा क्व क्व भागीरथी तदा ।\nयदा विष्णुस्तपस्तेपे चक्रपुष्करिणी तटे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004079002, "chapter_id": 24079, "verse_number": "४-२८-३", "content_sanskrit": "शिव उवाच ।\nसंदेहोऽत्र न कर्तव्यो विशालाक्षि सदामले ।\nश्रुतौ स्मृतौ पुराणेषु कालत्रयमुदीर्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004079003, "chapter_id": 24079, "verse_number": "४-२८-४", "content_sanskrit": "भूतं भावि भवच्चापि संशयं मा वृथा कृथाः ।\nइत्युक्त्वा पुनराहेशो गंगामाहात्म्यमुत्तमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004079004, "chapter_id": 24079, "verse_number": "४-२८-५", "content_sanskrit": "अगस्त्य उवाच ।\nपार्वतीनंदन पुनर्द्युनद्याः परितो वद ।\nमहिमोक्तो हरौ यद्वद्देवदेवेन वै तदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004079005, "chapter_id": 24079, "verse_number": "४-२८-६", "content_sanskrit": "स्कंद उवाच ।\nमुनऽत्र मैत्रावरुणे यथा देवेन भाषितम् ।\nशुणु त्रिपथगामिन्या माहात्म्यं पातकापहम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004079006, "chapter_id": 24079, "verse_number": "४-२८-७", "content_sanskrit": "त्रिस्रोतसं समासाद्य सकृत्पिंडान्ददाति यः ।\nउद्धृताः पितरस्तेन भवांभोधेस्तिलोदकैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004079007, "chapter_id": 24079, "verse_number": "४-२८-८", "content_sanskrit": "यावंतश्च तिला मर्त्यैर्गृहीता पितृकर्मणि ।\nतावद्वर्षसहस्राणि पितरः स्वर्गवासिनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004079008, "chapter_id": 24079, "verse_number": "४-२८-९", "content_sanskrit": "देवाः सपितरो यस्माद्गंगायां सर्वदा स्थिताः ।\nआवाहनं विसर्गं च तेषां तत्र ततो नहि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004079009, "chapter_id": 24079, "verse_number": "४-२८-१०", "content_sanskrit": "पितृवंशे मृता ये च मातृवंशे तथैव च ।\nगुरु श्वशुर बंधूनां ये चान्ये बांधवा मृताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004079010, "chapter_id": 24079, "verse_number": "४-२८-११", "content_sanskrit": "अजातदंता ये केचिद्ये च गर्भे प्रपीडिताः ।\nअग्निविद्युच्चोरहता व्याघ्रदंष्ट्रिभिरेव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004079011, "chapter_id": 24079, "verse_number": "४-२८-१२", "content_sanskrit": "उद्बंधन मृता ये च पतिता आत्मघातकाः ।\nआत्मविक्रयिणश्चोरा ये तथाऽयाज्ययाजकाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004079012, "chapter_id": 24079, "verse_number": "४-२८-१३", "content_sanskrit": "रसविक्रयिणो ये च ये चान्ये पापरोगिणः ।\nअग्निदा गरदाश्चैव गोघ्नाश्चैव स्ववंशजाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004079013, "chapter_id": 24079, "verse_number": "४-२८-१४", "content_sanskrit": "असिपत्रवने ये च कुंभीपाके च ये गताः ।\nरौरवेप्यंधतामिस्रे कालसूत्रे च ये गताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004079014, "chapter_id": 24079, "verse_number": "४-२८-१५", "content_sanskrit": "जात्यंतरसहस्रेषु भ्राम्यंते ये स्वकर्मभिः ।\nये तु पक्षिमृगादीनां कीटवृक्षादि वीरुधाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004079015, "chapter_id": 24079, "verse_number": "४-२८-१६", "content_sanskrit": "योनिं गतास्त्वसंख्याताः संख्यातानामशोभनाः ।\nप्रापिता यमलोकं तु सुघोरैर्यमकिंकरैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004079016, "chapter_id": 24079, "verse_number": "४-२८-१७", "content_sanskrit": "येऽबांधवा बांधवा वा येऽन्यजन्मनि बांधवाः ।\nयेपि चाज्ञातनामानो ये चापुत्राः स्वगोत्रजाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004079017, "chapter_id": 24079, "verse_number": "४-२८-१८", "content_sanskrit": "विषेण च मृता वै ये ये वै शृंगिभिराहताः ।\nकृतघ्नाश्च गुरुघ्नाश्च ये च मित्रद्रुहस्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004079018, "chapter_id": 24079, "verse_number": "४-२८-१९", "content_sanskrit": "स्त्री बालघातका ये च ये च विश्वासघातकाः ।\nअसत्यहिंसानिरता सदा पापरताश्च ये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004079019, "chapter_id": 24079, "verse_number": "४-२८-२०", "content_sanskrit": "अश्वविक्रयिणो ये च परद्रव्यहराश्च ये ।\nअनाथाः कृपणा दीना मानुष्यं प्राप्तुमक्षमाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004079020, "chapter_id": 24079, "verse_number": "४-२८-२१", "content_sanskrit": "तर्पिता जाह्नवीतोयैर्नरेण विधिना सकृत् ।\nप्रयांति स्वर्गतिं तेपि स्वर्गिणो मुक्तिमाप्नुयुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004079021, "chapter_id": 24079, "verse_number": "४-२८-२२", "content_sanskrit": "एतान्मंत्रान्समुच्चार्य यः कुर्यात्पितृतर्पणम् ।\nश्राद्धं पिंडप्रदानं च स विधिज्ञ इहोच्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004079022, "chapter_id": 24079, "verse_number": "४-२८-२३", "content_sanskrit": "कामप्रदानि तीर्थानि त्रैलोक्ये यानि कानिचित् ।\nतानि सर्वाणि सेवंते काश्यामुत्तरवाहिनीम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004079023, "chapter_id": 24079, "verse_number": "४-२८-२४", "content_sanskrit": "स्वःसिंधुः सर्वतः पुण्या ब्रह्महत्यापहारिणी ।\nकाश्यां विशेषतो विष्णो यत्र चोत्तरवाहिनी ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004079024, "chapter_id": 24079, "verse_number": "४-२८-२५", "content_sanskrit": "गायंति गाथामेतां वै दैवर्षिपितरोगणाः ।\nअपि दृग्गोचरा नः स्यात्काश्यामुत्तरवाहिनी ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004079025, "chapter_id": 24079, "verse_number": "४-२८-२६", "content_sanskrit": "यत्रत्यामृतसंतृप्तास्तापत्रितयवर्जिताः ।\nस्याम त्वमृतमेवाद्धा विश्वनाथप्रसादतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004079026, "chapter_id": 24079, "verse_number": "४-२८-२७", "content_sanskrit": "गंगैव केवला मुक्त्यै निर्णीता परितो हरे ।\nअविमुक्ते विशेषेण ममाधिष्ठानगौरवात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004079027, "chapter_id": 24079, "verse_number": "४-२८-२८", "content_sanskrit": "ज्ञात्वा कलियुगं घोरं गंगाभक्तिः सुगोपिता ।\nन विंदतिं जना गंगां मुक्तिमागैर्कदायिकाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004079028, "chapter_id": 24079, "verse_number": "४-२८-२९", "content_sanskrit": "अनेकजन्मनियुतं भ्राम्यमाणस्तु योनिषु ।\nनिर्वृतिं प्राप्नुयात्कोत्र जाह्नवीभजनं विना ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004079029, "chapter_id": 24079, "verse_number": "४-२८-३०", "content_sanskrit": "नराणामल्पबुद्धीनामेनो विक्षिप्तचेतसाम् ।\nगंगेव परमं विष्णो भेषजं भवरोगिणाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004079030, "chapter_id": 24079, "verse_number": "४-२८-३१", "content_sanskrit": "खंडस्फुटितसंस्कारं गंगातीरे करोति यः ।\nमम लोके चिरं कालं तस्याक्षय सुखं हरे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004079031, "chapter_id": 24079, "verse_number": "४-२८-३२", "content_sanskrit": "गंतुमुद्दिश्य यो गंगां परार्थस्वार्थमेव वा ।\nन गच्छति परं मोहात्स पतेत्पितृभिः सह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004079032, "chapter_id": 24079, "verse_number": "४-२८-३३", "content_sanskrit": "सर्वाणि येषां गांगेयैस्तोयैः कृत्यानि देहिनाम् ।\nभूमिस्था अपि ते मर्त्या अमर्त्या एव वै हरे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004079033, "chapter_id": 24079, "verse_number": "४-२८-३४", "content_sanskrit": "चरमेपि वयोभागे स्वःसिंधुं यो निषेवते ।\nकृत्वाप्येनांसि बहुशः सोपि यायाच्छुभां गतिम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004079034, "chapter_id": 24079, "verse_number": "४-२८-३५", "content_sanskrit": "यावदस्थि मनुष्याणां गंगातोयेषु तिष्ठति ।\nतावदब्दसहस्राणि स्वर्गलोके महीयते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004079035, "chapter_id": 24079, "verse_number": "४-२८-३६", "content_sanskrit": "विष्णुरुवाच ।\nदेवदेवजगन्नाथ जगतां हितकृत्प्रभो ।\nकीकसं चेत्पतेद्दैवाद्दुर्वृत्तस्य दुरात्मनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004079036, "chapter_id": 24079, "verse_number": "४-२८-३७", "content_sanskrit": "जले द्युनद्या निष्पापे कथं तस्य परा गतिः ।\nअपमृत्यु विपन्नस्य तदीश विनिवेद्यताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004079037, "chapter_id": 24079, "verse_number": "४-२८-३८", "content_sanskrit": "महेश्वर उवाच ।\nअत्रार्थे कथयिष्यामि पुरावृत्तमधोक्षज ।\nशृणुष्वैकमना विष्णो वाहीकस्य द्विजन्मनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004079038, "chapter_id": 24079, "verse_number": "४-२८-३९", "content_sanskrit": "पुरा कलिंगविषये द्विजो लवणविक्रयी ।\nसंध्यास्नानविहीनश्च वेदाक्षरविवर्जितः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004079039, "chapter_id": 24079, "verse_number": "४-२८-४०", "content_sanskrit": "वाहीको नामतो यज्ञसूत्रमात्रपरिग्रहः ।\nपरिग्रहश्च तस्यासीत्कौविंदी विधवा नवा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004079040, "chapter_id": 24079, "verse_number": "४-२८-४१", "content_sanskrit": "दुर्भिक्षपीडितेनाथ वृषलीपतिना विना ।\nप्राणाधारं तदा तेन देशाद्देशांतरं ययौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004079041, "chapter_id": 24079, "verse_number": "४-२८-४२", "content_sanskrit": "मध्येऽथ दंडकारण्यं क्षुत्क्षामः संगवर्जितः ।\nव्याघ्रेण घातितस्तत्र नरमांसप्रियेण सः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004079042, "chapter_id": 24079, "verse_number": "४-२८-४३", "content_sanskrit": "तस्य वामपदं गृध्रो गृहीत्वोदपतत्ततः ।\nमांसाशिनाऽन्य गृध्रेण तस्य युद्धमभूद्दिवि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004079043, "chapter_id": 24079, "verse_number": "४-२८-४४", "content_sanskrit": "गृध्रयोरामिषं गृध्न्वोः परस्परजयैषिणोः ।\nअवापतत्पादगुल्फं कंकचंचुपुटात्तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004079044, "chapter_id": 24079, "verse_number": "४-२८-४५", "content_sanskrit": "तस्य वाहीक विप्रस्य व्याघ्रव्यापादितस्य ह ।\nमध्ये गंगं दैवयोगादपतद्द्वंद्वकारिणोः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004079045, "chapter_id": 24079, "verse_number": "४-२८-४६", "content_sanskrit": "यदैव हतवान्द्वीपी तं वाहीकमरण्यगम् ।\nतस्मिन्नेव क्षणे बद्धः स पाशैः क्रूरकिंकरैः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004079046, "chapter_id": 24079, "verse_number": "४-२८-४७", "content_sanskrit": "कशाभिर्घातितोत्यंतमाराभिः परितोदितः ।\nवमन्रुधिरमास्येन नीतस्तैः स यमाग्रतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004079047, "chapter_id": 24079, "verse_number": "४-२८-४८", "content_sanskrit": "आपृच्छि धर्मराजेन चित्रगुप्तोथ मापते ।\nधर्माधर्मं विचार्यास्य कथयाशु द्विजन्मनः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004079048, "chapter_id": 24079, "verse_number": "४-२८-४९", "content_sanskrit": "वैवस्वतेन पृष्टोथ चित्रगुप्तो विचित्रधीः ।\nसर्वदा सर्वजंतूनां वेदिता सर्वकर्मणाम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004079049, "chapter_id": 24079, "verse_number": "४-२८-५०", "content_sanskrit": "जगाद यमुनाबंधुं वाहीकस्य द्विजन्मनः ।\nजन्मकर्मदिनारभ्य दुर्वृत्तस्य शुभेतरम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004079050, "chapter_id": 24079, "verse_number": "४-२८-५१", "content_sanskrit": "चित्रगुप्त उवाच ।\nगर्भाधानादिकं कर्म प्राक्कृतं नास्य केनचित् ।\nजातकर्मकृतं नास्य पित्राऽज्ञानवता हरे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004079051, "chapter_id": 24079, "verse_number": "४-२८-५२", "content_sanskrit": "गर्भैनः शमने हेतुः समस्तायुः सुखप्रदम् ।\nएकादशेह्नि नामास्य न कृतं विधिपूर्वकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004079052, "chapter_id": 24079, "verse_number": "४-२८-५३", "content_sanskrit": "ख्यातः स्याद्येन विधिना सर्वत्र विधिपावनम् ।\nनाकार्षीन्निर्गमं चास्य चतुर्थे मासि मंदधीः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004079053, "chapter_id": 24079, "verse_number": "४-२८-५४", "content_sanskrit": "जनकः शुभतिथ्यादौ विदेशगमनापहम् ।\nषष्ठेऽन्नप्राशनंमासि न कृतं विधिपूर्वकम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004079054, "chapter_id": 24079, "verse_number": "४-२८-५५", "content_sanskrit": "सर्वदा मिष्टमश्नाति कर्मणा येन भास्करे ।\nन चूडाकरणं चास्य कृतमब्दे यथाकुलम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004079055, "chapter_id": 24079, "verse_number": "४-२८-५६", "content_sanskrit": "कर्मणा येन केशाः स्युः स्निग्धाः कुसुमवर्षिणः ।\nनाकारि कर्णवेधोस्य जनित्रा समये शुभे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004079056, "chapter_id": 24079, "verse_number": "४-२८-५७", "content_sanskrit": "सुवर्णग्राहिणौ येन कर्णौ स्यातां च सुश्रुती ।\nमौंजीबंधोप्यभूदस्य व्यतीतेब्देऽष्टमे हरे ।\nब्रह्मचर्याभिवृद्ध्यै यो ब्रह्मग्रहणहेतुकः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004079057, "chapter_id": 24079, "verse_number": "४-२८-५८", "content_sanskrit": "मौंजीमोक्षणवार्तापि कृता नास्य जनुःकृता ।\nगार्हस्थ्यं प्राप्यते यस्मात्कर्मणोऽनंतरं वरम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004079058, "chapter_id": 24079, "verse_number": "४-२८-५९", "content_sanskrit": "यथाकथंचिदूढाऽथ पत्नी त्यक्तकुलाध्वगा ।\nवृषलीपतिना तेन परदारापहारिणा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004079059, "chapter_id": 24079, "verse_number": "४-२८-६०", "content_sanskrit": "आरभ्य पंचमाद्वर्षात्परस्वस्यापहारकः ।\nअभूदेष दुराचारो दुरोदरपरायणः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004079060, "chapter_id": 24079, "verse_number": "४-२८-६१", "content_sanskrit": "रुमायां वसताऽनेन हतागौरेकवार्षिकी ।\nएकदा दृढदंडेन लिहंती लवणं मृता ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004079061, "chapter_id": 24079, "verse_number": "४-२८-६२", "content_sanskrit": "जननीं पादपातेन बहुशोऽसावताडयत् ।\nकदाचिदपि नो वाक्यं पितुः कृतमनेन वै ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004079062, "chapter_id": 24079, "verse_number": "४-२८-६३", "content_sanskrit": "विषं भक्षितवानेष बहुशः कलहप्रियः ।\nजनोपतापशीलोसौ कृतोदरविदारणः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004079063, "chapter_id": 24079, "verse_number": "४-२८-६४", "content_sanskrit": "धत्तूरकरवीरादि बहुधोपविषाणि च ।\nक्रीडाकलहमात्रेण भक्षयच्चैष दुर्मतिः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004079064, "chapter_id": 24079, "verse_number": "४-२८-६५", "content_sanskrit": "दग्धोसावग्निना सौरे श्वभिश्च कवलीकृतः ।\nशृंगिभिः परितः प्रोतो विषाणाग्रैरसौ बहु ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004079065, "chapter_id": 24079, "verse_number": "४-२८-६६", "content_sanskrit": "दंदशूकैर्भृशं दष्टो दुष्टः शिष्टैर्विगर्हितः ।\nकाष्ठेष्टलोष्टैः पापिष्ठः कृतानिष्टः सदात्मनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004079066, "chapter_id": 24079, "verse_number": "४-२८-६७", "content_sanskrit": "आस्फालितं शिरोनेनासकृच्चापि दुरात्मना ।\nयदर्च्यते सदा सद्भिरुत्तमांगमनेकधा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004079067, "chapter_id": 24079, "verse_number": "४-२८-६८", "content_sanskrit": "असौ हि ब्राह्मणो मंदो गायत्रीमपिवेदन ।\nकामतो मत्स्यमांसानि जग्धान्येतेन दुर्धिया ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004079068, "chapter_id": 24079, "verse_number": "४-२८-६९", "content_sanskrit": "आत्मार्थं पायसमसौ पर्यपाक्षीदनेकधा ।\nलाक्षालवणमांसानां सपयोदधिसर्पिषाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004079069, "chapter_id": 24079, "verse_number": "४-२८-७०", "content_sanskrit": "विषलोहायुधानां च दासीगोवाजिनामपि ।\nविक्रेताऽसौ सदा मूढस्तथा वै केशचर्मणाम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004079070, "chapter_id": 24079, "verse_number": "४-२८-७१", "content_sanskrit": "शूद्रान्न परिपुष्टांगः पर्वण्यहनि मैथुनी ।\nपराङ्मुखो दैवपित्र्यकर्मण्येष दुरात्मवान् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004079071, "chapter_id": 24079, "verse_number": "४-२८-७२", "content_sanskrit": "पक्षिणो घातितानेन मृगाश्चापि परः शतम् ।\nअकारण द्रुमच्छेदी सदा निर्दयमानसः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004079072, "chapter_id": 24079, "verse_number": "४-२८-७३", "content_sanskrit": "उद्वेगजनको नित्यं निजबंधुजनेष्वपि ।\nअसत्यवादी सततं सदा हिंसापरायणः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004079073, "chapter_id": 24079, "verse_number": "४-२८-७४", "content_sanskrit": "अदत्तदानः पिशुनः शिश्नोदरपरायणः ।\nकिं बहूक्तेन रविज साक्षात्पातक मूर्तिमान् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004079074, "chapter_id": 24079, "verse_number": "४-२८-७५", "content_sanskrit": "रौरवेप्यंधतामिस्रे कुंभीपाकेऽतिरौरवे ।\nकालसूत्रे कृमिभुजि पूयशोणितकर्दमे ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004079075, "chapter_id": 24079, "verse_number": "४-२८-७६", "content_sanskrit": "असिपत्रवने घोरे यंत्रपीडे सुदंष्ट्रके ।\nअधोमुखे पूतिगंधे विष्ठागर्त्तेष्वभोजने ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004079076, "chapter_id": 24079, "verse_number": "४-२८-७७", "content_sanskrit": "सूचीभेद्येऽथ संदंशे लालापे क्षुरधारके ।\nप्रत्येकं नरके त्वेष पात्यतां कल्पसंख्यया ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004079077, "chapter_id": 24079, "verse_number": "४-२८-७८", "content_sanskrit": "धर्मराजः समाकर्ण्य चित्रगुप्तमुखादिति ।\nनिर्भर्त्स्य तं दुराचारं किंकरानादिदेश ह ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004079078, "chapter_id": 24079, "verse_number": "४-२८-७९", "content_sanskrit": "भ्रू संज्ञया हृतैर्नीतः स बद्ध्वा निरयालयम् ।\nआक्रंदरावो यत्रोच्चैः पापिनां रोमहर्षणः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004079079, "chapter_id": 24079, "verse_number": "४-२८-८०", "content_sanskrit": "ईश्वर उवाच ।\nयातनास्वतितीव्रासु वाहीके संस्थिते तदा ।\nतत्कालपुण्यफलदे गाङ्गेयांभसि निर्मले ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004079080, "chapter_id": 24079, "verse_number": "४-२८-८१", "content_sanskrit": "पतितं तद्धि गृध्रास्याद्वाहीकस्य द्विजन्मनः ।\nहरे विमानं तत्कालमापन्नं सुरसद्मतः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004079081, "chapter_id": 24079, "verse_number": "४-२८-८२", "content_sanskrit": "घंटावलंबितं दिव्यं दिव्यस्त्रीशतसंकुलम् ।\nआरुह्य देवयानं स दिव्यवेषधरो द्विजः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004079082, "chapter_id": 24079, "verse_number": "४-२८-८३", "content_sanskrit": "वीज्यमानोऽप्सरोवृंदैर्दिव्यगंधानुलेपनः ।\nजगाम स्वर्गभुवनं गंगास्थिपतनाद्धरे ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004079083, "chapter_id": 24079, "verse_number": "४-२८-८४", "content_sanskrit": "स्कंद उवाच ।\nवस्तुशक्तिविचारोयमद्भुतः कोपि कुंभज ।\nद्रवरूपेण काप्येषा शक्तिः सादाशिवी परा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004079084, "chapter_id": 24079, "verse_number": "४-२८-८५", "content_sanskrit": "करुणामृतपूर्णेन देवदेवेन शंभुना ।\nएषा प्रवर्तिता गंगा जगदुद्धरणाय वै ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004079085, "chapter_id": 24079, "verse_number": "४-२८-८६", "content_sanskrit": "यथान्याः सरितो लोके वारिपूर्णाः सहस्रशः ।\nतथैषानानुमंतव्या सद्भिस्त्रिपथगामिनी ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004079086, "chapter_id": 24079, "verse_number": "४-२८-८७", "content_sanskrit": "श्रुत्यक्षराणि निश्चित्य कारुण्याच्छंभुना मुने ।\nनिर्मिता तद्द्रवैरेषा गंगा गंगाधरेण वै ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004079087, "chapter_id": 24079, "verse_number": "४-२८-८८", "content_sanskrit": "योगोपनिषदामेतं सारमाकृष्य शंकरः ।\nकृपया सर्वजंतूनां चकार सरितां वराम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004079088, "chapter_id": 24079, "verse_number": "४-२८-८९", "content_sanskrit": "अकलानिधयो रात्र्यो विपुष्पाश्चैव पादपाः ।\nयथा तथैव ते देशा यत्र नास्त्यमरापगा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004079089, "chapter_id": 24079, "verse_number": "४-२८-९०", "content_sanskrit": "अनयाः संपदो यद्वन्मखा यद्वददक्षिणाः ।\nतद्वद्देशा दिशः सर्वा हीना गंगांभसा हरे ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004079090, "chapter_id": 24079, "verse_number": "४-२८-९१", "content_sanskrit": "व्योमांगणमनर्कं च नक्तेऽदीपं यथा गृहम ।\nअवेदा ब्राह्मणा यद्वद्गंगाहीनास्तथा दिशः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004079091, "chapter_id": 24079, "verse_number": "४-२८-९२", "content_sanskrit": "चांद्रायणसहस्रं तु यः कुर्याद्देहशोधनम् ।\nगंगामृतं पिबेद्यस्तु तयोर्गंगाबुपोऽधिकः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004079092, "chapter_id": 24079, "verse_number": "४-२८-९३", "content_sanskrit": "पादेनैकेन यस्तिष्ठेत्सहस्रं शरदां शतम् ।\nअब्दं गंगांबुपो यस्तु तयोर्गंगांबुपोऽधिकः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004079093, "chapter_id": 24079, "verse_number": "४-२८-९४", "content_sanskrit": "अवाक्छिराः प्रलंबेद्यः शतसंवत्सरान्नरः ।\nभीष्मसूवालुकातल्पशयस्तस्माद्वरो हरे ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004079094, "chapter_id": 24079, "verse_number": "४-२८-९५", "content_sanskrit": "पापतापाभितप्तानां भूतानामिह जाह्ववी ।\nपापतापहरा यद्वद्गंगा नान्यत्तथा कलौ ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004079095, "chapter_id": 24079, "verse_number": "४-२८-९६", "content_sanskrit": "तार्क्ष्यवीक्षणमात्रेण फणिनौ निर्विषा यथा ।\nनिष्प्रभाणि तथेनांसि भागीरथ्यवलोकनात् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004079096, "chapter_id": 24079, "verse_number": "४-२८-९७", "content_sanskrit": "गंगातटोद्भवां मृत्स्नां यो मौलौ बिभृयान्नरः ।\nबिभर्ति सोऽर्कबिंबं वै तमोनाशाय निश्चितम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004079097, "chapter_id": 24079, "verse_number": "४-२८-९८", "content_sanskrit": "व्यसनैरभिभूतस्य धनहीनस्य पापिनः ।\nगंगैव केवलं तस्य गतिरुक्ता न चान्यथा ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004079098, "chapter_id": 24079, "verse_number": "४-२८-९९", "content_sanskrit": "श्रुताभिलषिता दृष्टा स्पृष्टा पीताऽवगाहिता ।\nपुंसां वंशद्वयं गंगा तारयेन्नात्र संशयः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004079099, "chapter_id": 24079, "verse_number": "४-२८-१००", "content_sanskrit": "कीर्तनाद्दर्शनात्स्पर्शाद्गंगापानावगाहनात् ।\nदशोत्तरगुणा ज्ञेया पुण्यापुण्यर्द्धिनाशयोः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004079100, "chapter_id": 24079, "verse_number": "४-२८-१०१", "content_sanskrit": "न सुतैर्न च वा वित्तैर्नान्येनापि सुकर्मणा ।\nतत्फलं प्राप्यते मर्त्ये गंगामाप्य यदाप्यते ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004079101, "chapter_id": 24079, "verse_number": "४-२८-१०२", "content_sanskrit": "जात्यंधाः पंगवस्ते वै जीवंतोप्यथ ते मृताः ।\nसमर्था अपि ये गंगां न स्नायुर्मोक्षगर्भिणीम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004079102, "chapter_id": 24079, "verse_number": "४-२८-१०३", "content_sanskrit": "श्रुतिं निशामय हरे गंगामाहात्म्यभाषिणीम् ।\nविनिश्चितार्थां यां श्रुत्वा श्रयेद्गंगां नरोत्तमः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004079103, "chapter_id": 24079, "verse_number": "४-२८-१०४", "content_sanskrit": "इरावतीं मधुमतीं पयस्विनीममृतरूपामूर्जस्वतीम् ।\nत्रिदिवप्रसूतां गंगां श्रितासस्त्रिदिवं व्रजंति ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004079104, "chapter_id": 24079, "verse_number": "४-२८-१०५", "content_sanskrit": "ऋषिजुष्टां विष्णुपदीं पुराणां सुपुण्यधारां मनसा हि लोके ।\nसर्वात्मना जाह्नवीं ये प्रपन्नास्ते ब्रह्मणः सदनं संप्रयांति ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004079105, "chapter_id": 24079, "verse_number": "४-२८-१०६", "content_sanskrit": "लोकानिमान्नयति या जननीव पुत्रान्स्वर्गं सदा सर्वगुणोपपन्ना ।\nस्थानमिष्टं ब्राह्ममभीप्समानैर्गंगा सदैवात्मवशैरुपास्या ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004079106, "chapter_id": 24079, "verse_number": "४-२८-१०७", "content_sanskrit": "उस्रैर्जुष्टामिषतीं विश्वरूपामिरावतीं जनयित्रीं गुहस्य ।\nशिष्टैः सेव्याममृतां ब्रह्मकांतां गंगां श्रयेदात्मविशुद्धिकामः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004079107, "chapter_id": 24079, "verse_number": "४-२८-१०८", "content_sanskrit": "गंगायां तु नरः स्नात्वा ब्रह्मचारी समाहितः ।\nविधूतपापो भवति वाजपेयं च विंदति ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004079108, "chapter_id": 24079, "verse_number": "४-२८-१०९", "content_sanskrit": "अशुभैः कर्मभिर्ग्रस्तान्मज्जमानान्महार्णवे ।\nपततो निरये गंगा संश्रितानुद्धरेत्सदा ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004079109, "chapter_id": 24079, "verse_number": "४-२८-११०", "content_sanskrit": "ब्रह्मलोकस्तु लोकानां सर्वेषामुत्तमो यथा ।\nसरितां सरसां वापि वरिष्ठा जाह्नवी तथा ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004079110, "chapter_id": 24079, "verse_number": "४-२८-१११", "content_sanskrit": "अन्यत्र सम्यक्संकल्प्य तपः कृत्वा समा त्रयम् ।\nयत्फलं तद्भवेद्भक्त्या गंगायां घटिकाऽर्धतः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004079111, "chapter_id": 24079, "verse_number": "४-२८-११२", "content_sanskrit": "स्वर्गस्थस्य न सा प्रीतिर्भुंजतः सुखमक्षयम् ।\nया स्याद्गंगातटे पुंसां रात्रौ चंद्रोदये सति ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004079112, "chapter_id": 24079, "verse_number": "४-२८-११३", "content_sanskrit": "जरारोगाभिपन्नं तु कुणपं जाह्नवी जले ।\nधैर्येण तृणवत्त्यक्त्वा प्रविशेदमरावतीम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004079113, "chapter_id": 24079, "verse_number": "४-२८-११४", "content_sanskrit": "वार्योघैः सततं यस्याः प्लाव्यते शशिमंडलम् ।\nभूयोधिकतरां शोभां बिभर्ति तदहः क्षये ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004079114, "chapter_id": 24079, "verse_number": "४-२८-११५", "content_sanskrit": "आहुतस्य जले यस्याः सद्यो नश्यंति पातकम् ।\nमहतः श्रेयसः प्राप्तिस्तत्क्षणादेव जायते ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004079115, "chapter_id": 24079, "verse_number": "४-२८-११६", "content_sanskrit": "पितृभ्यः श्रद्धया यत्र दत्तास्त्वापः स्ववंशजैः ।\nप्रयच्छंति परां तृप्तिं शरदां त्रयमच्युत ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004079116, "chapter_id": 24079, "verse_number": "४-२८-११७", "content_sanskrit": "तारयेत्क्षितियान्मर्त्यानधःस्थांश्च सरीसृपान् ।\nस्वर्गे स्वर्गसदो विष्णोर्गं गा त्रिपथगा ततः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004079117, "chapter_id": 24079, "verse_number": "४-२८-११८", "content_sanskrit": "तीर्थानामुत्तमं तीर्थं सरितामुत्तमा सरित् ।\nस्वर्गदा सर्वजंतूनां महापातकिनामपि ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004079118, "chapter_id": 24079, "verse_number": "४-२८-११९", "content_sanskrit": "अध्युष्टाः कोटयो विष्णो संति तीर्थानि सर्वतः ।\nदिवि भुव्यंतरिक्षे च जाह्नव्यां तानि कृत्स्नशः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004079119, "chapter_id": 24079, "verse_number": "४-२८-१२०", "content_sanskrit": "ज्ञात्वाज्ञात्वा च गंगायां यः पंचत्वमवाप्नुयात् ।\nअनात्मघाती स्वर्गी स्यान्नरकान्स न पश्यति ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004079120, "chapter_id": 24079, "verse_number": "४-२८-१२१", "content_sanskrit": "गंगैव सर्वतीर्थानि गंगैव च तपोवनम् ।\nगंगैव सिद्धिक्षेत्रं हि नात्र कार्या विचारणा ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004079121, "chapter_id": 24079, "verse_number": "४-२८-१२२", "content_sanskrit": "यत्र कामफला वृक्षा मही यत्र हिरण्मयी ।\nजाह्नवी स्नायिनस्तत्र निवसंति घटोद्भव ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004079122, "chapter_id": 24079, "verse_number": "४-२८-१२३", "content_sanskrit": "धेनुं भागीरथी तीरे सुशीलां च पयस्विनीम् ।\nवासोरत्नैरलंकृत्वा ब्राह्मणाय ददाति यः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004079123, "chapter_id": 24079, "verse_number": "४-२८-१२४", "content_sanskrit": "यावंति तस्या लोमानि मुने तत्संततेरपि ।\nतावद्वर्षसहस्राणि स स्वर्गसुखभुग्भवेत् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}]