[{"id": 6000260000, "chapter_id": 10260, "verse_number": null, "content_sanskrit": "अथ चतुःषष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000260001, "chapter_id": 10260, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.001.m4a", "display_order": 2}, {"id": 6000260002, "chapter_id": 10260, "verse_number": "१०-६४-१", "content_sanskrit": "यानि योधैः प्रयुक्तानि शस्‍त्रास्‍त्राणि कुरूद्वह।\nअच्छिनत् केशवस्तीक्ष्णैः शरैरेकैकशस्‍त्रिभिः॥ १०/६४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.002.m4a", "display_order": 3, "topics": [{"text": "नरकासुरहननम्", "range": "१–३३"}]}, {"id": 6000260003, "chapter_id": 10260, "verse_number": "१०-६४-२", "content_sanskrit": "उह्यमानः सुपर्णेन पक्षाभ्यां निघ्नता गजान्।\nगरुत्मता हन्यमानास्तुण्डपक्षनखैर्गजाः॥ १०/६४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.003.m4a", "display_order": 4}, {"id": 6000260004, "chapter_id": 10260, "verse_number": "१०-६४-३", "content_sanskrit": "तुरङ्गमाश्च दुर्द्धर्षाः पेतुरुर्व्यां गतासवः।\nदृष्ट्वा विद्रावितं सैन्यं गरुडेनार्दितं स्वकम्॥ १०/६४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.004.m4a", "display_order": 5}, {"id": 6000260005, "chapter_id": 10260, "verse_number": "१०-६४-४", "content_sanskrit": "तं भौमः प्राहरच्छक्त्या वज्रेणेव हरिर्गिरिम्।\nतयाऽतिविद्धो गरुडो मालाविद्ध इव द्विपः॥ १०/६४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.005.m4a", "display_order": 6}, {"id": 6000260006, "chapter_id": 10260, "verse_number": "१०-६४-५", "content_sanskrit": "न किञ्चिदपि राजेन्द्र चचाल नरकाहवे।\nततः कार्मुकमादाय नरकः शरसञ्चयान्॥ १०/६४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.006.m4a", "display_order": 7}, {"id": 6000260007, "chapter_id": 10260, "verse_number": "१०-६४-६", "content_sanskrit": "मुमोच कृष्णे तान् सर्वानच्छिनत् केशवः शरैः।\nततोऽर्धचन्द्रं नरकं सुसन्धाय शरासने॥ १०/६४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.007.m4a", "display_order": 8}, {"id": 6000260008, "chapter_id": 10260, "verse_number": "१०-६४-७", "content_sanskrit": "आक्रष्टुकामं विज्ञाय तच्चापं केशवोऽच्छिनत्।\nततः कालायसमयीं गदां गुर्वीं धरासुतः॥ १०/६४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.008.m4a", "display_order": 9}, {"id": 6000260009, "chapter_id": 10260, "verse_number": "१०-६४-८", "content_sanskrit": "आददे तां क्षुरप्रेण चकर्त मधुसूदनः।\nततो निशातं परशुं भौमः परबलार्दनः॥ १०/६४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.009.m4a", "display_order": 10}, {"id": 6000260010, "chapter_id": 10260, "verse_number": "१०-६४-९", "content_sanskrit": "प्राहिणोद् विष्णवे तं च चिच्छेद श्रीधरोऽसिना।\nततः कृष्णाय चिक्षेप तोमरान् पञ्चसप्तति॥ १०/६४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.010.m4a", "display_order": 11}, {"id": 6000260011, "chapter_id": 10260, "verse_number": "१०-६४-१०", "content_sanskrit": "चकार सिंहनादं च नरकः परवीरहा। तांस्तोमरान् कुरुश्रेष्ठ शरेणैकेन केशवः।\nचिच्छेद यौगपद्येन तदद्भुतमिवाभवत्॥ १०/६४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.011.m4a", "display_order": 12}, {"id": 6000260012, "chapter_id": 10260, "verse_number": "१०-६४-११", "content_sanskrit": "शूलं भौमोऽच्युतं हन्तुमाददे वितथोद्यमः। तद्विसर्गात् पूर्वमेव नरकस्य शिरो हरिः।\nअपाहरद् गजस्थस्य चक्रेण क्षुरनेमिना॥ १०/६४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.012.m4a", "display_order": 13}, {"id": 6000260013, "chapter_id": 10260, "verse_number": "१०-६४-१२", "content_sanskrit": "सकुण्डलं चारुकिरीटभूषितं बभौ पृथिव्यां पतितं समुज्ज्वलत्।\nहाहेति साध्वित्यृषयः सुरेश्वरा माल्यैर्मुकुन्दं विकिरन्त ईडिरे॥ १०/६४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.013.m4a", "display_order": 14}, {"id": 6000260014, "chapter_id": 10260, "verse_number": "१०-६४-१३", "content_sanskrit": "हत्वा हरिर्नरकं दैत्यवर्यं मरुद्गणैः सहितो लोकपालैः।\nसमाहूतः पौरमुख्यैः सभार्यः प्राग्ज्योतिषं प्राविशद् द्रष्टुकामः॥ १०/६४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.014.m4a", "display_order": 15}, {"id": 6000260015, "chapter_id": 10260, "verse_number": "१०-६४-१४", "content_sanskrit": "तत्रापश्यद् यदुश्रेष्ठो विचित्रं मणिपर्वतम्।\nछत्रं च वारुणं हृद्यं सलिलस्रावि भारत॥ १०/६४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.015.m4a", "display_order": 16}, {"id": 6000260016, "chapter_id": 10260, "verse_number": "१०-६४-१५", "content_sanskrit": "शक्राय प्राहिणोद् भूयः केशवो मणिपर्वतम्।\nवरुणाय तथा च्छत्रं प्राहिणोद् दैत्यकिङ्करैः॥ १०/६४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.016.m4a", "display_order": 17}, {"id": 6000260017, "chapter_id": 10260, "verse_number": "१०-६४-१६", "content_sanskrit": "तान् विसृज्य हरिर्देवान् स्वयमेव जगत्पतिः।\nप्राविशद् भौमसदनं पुरन्दरपुरोपमम्॥ १०/६४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.017.m4a", "display_order": 18}, {"id": 6000260018, "chapter_id": 10260, "verse_number": "१०-६४-१७", "content_sanskrit": "ततो धरा कृष्णमुपेत्य कुण्डले प्रतप्तजाम्बूनदरत्नभास्वरे।\nपौत्रं च वीरं भगदत्तसञ्ज्ञितं निवेद्य मालामपि वैजयन्तीम्॥ १०/६४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.018.m4a", "display_order": 19}, {"id": 6000260019, "chapter_id": 10260, "verse_number": "१०-६४-१८", "content_sanskrit": "अस्तौषीदथ विश्वेशं देवी देववरार्चितम्।\nप्राञ्जलिः प्रणता राजन् भक्तिप्रवणया धिया॥ १०/६४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.019.m4a", "display_order": 20}, {"id": 6000260020, "chapter_id": 10260, "verse_number": null, "content_sanskrit": "पृथिव्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.020.m4a", "display_order": 21}, {"id": 6000260021, "chapter_id": 10260, "verse_number": "१०-६४-१९", "content_sanskrit": "नमस्ते देवदेवेश शङ्खचक्रगदाधर।\nभक्तेच्छोपात्तरूपाय परमात्मन् नमोऽस्तु ते॥ १०/६४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.021.m4a", "display_order": 22}, {"id": 6000260022, "chapter_id": 10260, "verse_number": "१०-६४-२०", "content_sanskrit": "नमः पङ्कजनाभाय नमः पङ्कजमालिने।\nनमः पङ्कजनेत्राय नमस्ते पङ्कजाङ्घ्रये॥ १०/६४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.022.m4a", "display_order": 23}, {"id": 6000260023, "chapter_id": 10260, "verse_number": "१०-६४-२१", "content_sanskrit": "नमो भगवते तुभ्यं वासुदेवाय विष्णवे।\nपुरुषायादिबीजाय पूर्णबोधाय ते नमः॥ १०/६४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.023.m4a", "display_order": 24}, {"id": 6000260024, "chapter_id": 10260, "verse_number": "१०-६४-२२", "content_sanskrit": "अजाय जनयित्रेऽस्य ब्रह्मणेऽनन्तशक्तये।\nचराचरात्मन् लोकेश परमात्मन् नमोऽस्तु ते॥ १०/६४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.024.m4a", "display_order": 25}, {"id": 6000260025, "chapter_id": 10260, "verse_number": "१०-६४-२३", "content_sanskrit": "त्वं वै सिसृक्षू रज उत्कटं प्रभो, तमो निरोधाय बिभर्षि संवृतम्।\nस्थानाय सत्वं जगतो जगत्प्रभो कालः प्रधानः पुरुषोऽस्यपारः॥ १०/६४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.025.m4a", "display_order": 26}, {"id": 6000260026, "chapter_id": 10260, "verse_number": "१०-६४-२४", "content_sanskrit": "अहं पयो ज्योतिरथोऽनिलो नभो मात्राणि देवा मन इन्द्रियाणि।\nकर्ताऽभिमानीत्यखिलं तु कारणं त्वय्यद्वितीये भगवन्नयं भ्रमः॥ १०/६४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.026.m4a", "display_order": 27}, {"id": 6000260027, "chapter_id": 10260, "verse_number": "१०-६४-२५", "content_sanskrit": "तस्यात्मजोऽयं तव पादपङ्कजं भीतः प्रपन्नार्तिहरं प्रसादितुम्।\nतत्पालयैनं कुरु हस्तपङ्कजं शिरस्यमुष्याखिलकल्मषापहम्॥ १०/६४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.027.m4a", "display_order": 28}, {"id": 6000260028, "chapter_id": 10260, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.028.m4a", "display_order": 29}, {"id": 6000260029, "chapter_id": 10260, "verse_number": "१०-६४-२६", "content_sanskrit": "इति भूम्याऽर्चितो वाग्भिर्भगवान् भक्तिनम्रया।\nप्रसन्नः प्रददौ तस्मै भगदत्ताय चाभयम्॥ १०/६४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.029.m4a", "display_order": 30}, {"id": 6000260030, "chapter_id": 10260, "verse_number": "१०-६४-२७", "content_sanskrit": "राज्ये नियोज्य तं वंश्ये तदमात्यांश्च तत्पदे।\nभौमावरोधकान्तानां श्रेणीः स प्राविशद्धरिः॥ १०/६४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.030.m4a", "display_order": 31}, {"id": 6000260031, "chapter_id": 10260, "verse_number": "१०-६४-२८", "content_sanskrit": "तत्र राजन्यकन्यानां षट्सहस्राधिकायुतम्।\nभौमाहृतानां विक्रम्य राजभ्यो ददृशे हरिः॥ १०/६४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.031.m4a", "display_order": 32}, {"id": 6000260032, "chapter_id": 10260, "verse_number": "१०-६४-२९", "content_sanskrit": "तं प्रविष्टं स्‍त्रियो वीक्ष्य ताः सर्वा नवयौवनाः।\nस्वलङ्कृता विचित्राङ्ग्यो नरवर्य विमोहिताः॥ १०/६४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.032.m4a", "display_order": 33}, {"id": 6000260033, "chapter_id": 10260, "verse_number": "१०-६४-३०", "content_sanskrit": "मनसा वव्रिरेऽभीष्टं पतिं दैवोपपादितम्।\nभूयात् पतिरयं मह्यं धाता तदनुमोदताम्॥ १०/६४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.033.m4a", "display_order": 34}, {"id": 6000260034, "chapter_id": 10260, "verse_number": "१०-६४-३१", "content_sanskrit": "इति सर्वेश्वरे कृष्णे ता नार्यो हृदयं दधुः।\nताः प्राहिणोद् द्वारवतीं सुमृष्टरुचिराम्बराः॥ १०/६४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.034.m4a", "display_order": 35}, {"id": 6000260035, "chapter_id": 10260, "verse_number": "१०-६४-३२", "content_sanskrit": "खरैरुष्ट्रैर्महाकोशान् रथांश्च द्रविणं महत्।\nऐरावतकुलेभांश्च चतुर्दन्तान् मदोत्कटान्॥ १०/६४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.035.m4a", "display_order": 36}, {"id": 6000260036, "chapter_id": 10260, "verse_number": "१०-६४-३३", "content_sanskrit": "भगदत्ताय दत्वैकं सुप्रतीकं ततोऽपरान्।\nपाण्डुरांश्च चतुःषष्टिं प्रेषयामास केशवः॥ १०/६४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_064/BhP_10.064.036.m4a", "display_order": 37}, {"id": 6000260037, "chapter_id": 10260, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे चतुःषष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]