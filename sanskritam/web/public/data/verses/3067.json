[{"id": 2096546, "chapter_id": 3067, "verse_number": "१३-१९७-१", "content_sanskrit": "[स्कन्द उवाच।\nममाप्यनुमतो धर्मस्तं शृणुध्वं समाहिताः।\nनीलषण्डस्य शृङ्गाभ्यां गृहीत्वा मृत्तिकां तु यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096547, "chapter_id": 3067, "verse_number": "१३-१९७-२", "content_sanskrit": "अभिषेकं त्र्यहं कुर्यात्तस्य धर्मं निबोधत।\nशोधयेदशुभं सर्वमाधिपत्यं परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096548, "chapter_id": 3067, "verse_number": "१३-१९७-३", "content_sanskrit": "यावच्च जायते मर्त्यस्तावच्छूरो भविष्यति।\nइदं चाप्यपरं गुह्यं सरहस्यं निबोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096549, "chapter_id": 3067, "verse_number": "१३-१९७-४", "content_sanskrit": "प्रगृह्यौदुम्बरं पात्रं पक्वान्नं मधुना सह।\nसोमस्योत्तिष्ठमानस्यि पौर्णमास्यां बलिं हरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096550, "chapter_id": 3067, "verse_number": "१३-१९७-५", "content_sanskrit": "तस्य धर्मफलं नित्यं श्रद्दधाना निबोधत।\nसाध्या रुद्रास्तथाऽऽदित्या विश्वेदेवास्तथाऽश्विनौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096551, "chapter_id": 3067, "verse_number": "१३-१९७-६", "content_sanskrit": "मरुतो वसवश्चैव प्रतिगृह्णन्ति तं बलिम्।\nसोमश्च वर्धते तेन समुद्रश्च महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096552, "chapter_id": 3067, "verse_number": "१३-१९७-७", "content_sanskrit": "एष धर्मो मयोद्दिष्टः सरहस्यः सुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096553, "chapter_id": 3067, "verse_number": "१३-१९७-८x", "content_sanskrit": "विष्णुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096554, "chapter_id": 3067, "verse_number": "१३-१९७-८", "content_sanskrit": "धर्मगुह्यानि सर्वाणि देवतानां महात्मनाम्।\nऋषीणां चैव गुह्यानि यः पठेदाह्निकं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096555, "chapter_id": 3067, "verse_number": "१३-१९७-९", "content_sanskrit": "शृणुयाद्वाऽनसूयुर्यः श्रद्दधानः समाहितः।\nनास्य विघ्नः प्रभवति भयं चास्य न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096556, "chapter_id": 3067, "verse_number": "१३-१९७-१०", "content_sanskrit": "ये च धर्माः शुभाः पुण्याः सरहस्या उदाहृताः।\nतेषां धर्मफलं तस्य यः पठेत जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096557, "chapter_id": 3067, "verse_number": "१३-१९७-११", "content_sanskrit": "नास्य पापं प्रभवति न च पापेन लिप्यते।\nपठेद्वा श्रावयेद्वाऽपि श्रुत्वा वा लभते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096558, "chapter_id": 3067, "verse_number": "१३-१९७-१२", "content_sanskrit": "भुञ्जते पितरो देवा हव्यं कव्यमथाक्षयम्।\nश्रावयंश्चापि विप्रेन्द्रान्पर्वसु प्रयतो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096559, "chapter_id": 3067, "verse_number": "१३-१९७-१३", "content_sanskrit": "ऋषीणां देवतानां च पितॄणां चैव नित्यदा।\nभवत्यभिमतः श्रीमान्धर्मेषु प्रयतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096560, "chapter_id": 3067, "verse_number": "१३-१९७-१४", "content_sanskrit": "कृत्वाऽपि पापकं कर्म महापातकवर्जितम्।\nरहस्यधर्मं श्रुत्वेमं सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096561, "chapter_id": 3067, "verse_number": "१३-१९७-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096562, "chapter_id": 3067, "verse_number": "१३-१९७-१५", "content_sanskrit": "एतद्धर्मरहस्यं वै देवतानां नराधिप।\nव्यासोद्दिष्टं मया प्रोक्तं सर्वदेवनमस्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096563, "chapter_id": 3067, "verse_number": "१३-१९७-१६", "content_sanskrit": "पृथिवी रत्नसंपूर्णा ज्ञानं चेदमनुत्तमम्।\nइदमेव ततः श्राव्यमिति मन्येत धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096564, "chapter_id": 3067, "verse_number": "१३-१९७-१७", "content_sanskrit": "नाश्रद्दधानाय न नास्तिकाय\nन नष्टधर्मायि न निर्घृणाय।\nन हेतुदुष्टाय गुरुद्विषे वा\nनानात्मभूताय निवेद्यमेतत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096565, "chapter_id": 3067, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तनवत्यधिकशततमोऽध्यायः॥ १९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]