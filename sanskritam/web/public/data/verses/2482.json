[{"id": 2070539, "chapter_id": 2482, "verse_number": "११-१४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070540, "chapter_id": 2482, "verse_number": "११-१४-१", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्या भीमसेनोऽथ भीतवत्।\nगान्धारीं प्रत्युवाचेदं वचः सानुनयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070541, "chapter_id": 2482, "verse_number": "११-१४-२", "content_sanskrit": "अधर्मो यदि वा धर्मस्त्रासात्तत्र मया कृतः।\nआत्मानं त्रातुकामेन तन्मे त्वं क्षन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070542, "chapter_id": 2482, "verse_number": "११-१४-३", "content_sanskrit": "न हि युद्धेन पुत्रस्ते धर्मेण स महाबलः।\nदुःशक्यः केनचिद्धर्तुमतो विषममाचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070543, "chapter_id": 2482, "verse_number": "११-१४-४", "content_sanskrit": "अधर्मेण जितः पूर्वं तेन चापि युधिष्ठिरः।\nनिकृताश्च सदैव स्म तो विषममाचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070544, "chapter_id": 2482, "verse_number": "११-१४-५", "content_sanskrit": "सैन्यस्यैकोऽवशिष्टोऽयं गदायुद्धे च वीर्यवान्।\nन त्यक्ष्यति हृतं राज्यमिति वै तत्कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070545, "chapter_id": 2482, "verse_number": "११-१४-६", "content_sanskrit": "एकपत्नीं च पाश्चालीमेकवस्त्रां रजस्वलाम्।\nभवत्या विदितं सर्वमुक्तवान्यत्सुतस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070546, "chapter_id": 2482, "verse_number": "११-१४-७", "content_sanskrit": "सुयोधनं त्वसंहृत्य न शक्या भूः ससागरा।\nकेवला भोक्तुमस्माभिरतश्चैतत्कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070547, "chapter_id": 2482, "verse_number": "११-१४-८", "content_sanskrit": "तच्चाप्यप्रियमस्माकं पुत्रस्ते समुपाचरत्।\nद्रौपद्या यत्सभामध्ये सव्यमूरुमदर्शयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070548, "chapter_id": 2482, "verse_number": "११-१४-९", "content_sanskrit": "तत्रैव वध्यः सोऽस्माकं दुराचारोऽप्ब ते सुतः।\nधर्मराजाज्ञया चैव स्थिताः स्म समये पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070549, "chapter_id": 2482, "verse_number": "११-१४-१०", "content_sanskrit": "वैरमुद्दीपितं राज्ञि पुत्रेण तव यन्महत्।\nक्लेशिताश्च वने नित्यं तत एतत्कृतं मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070550, "chapter_id": 2482, "verse_number": "११-१४-११", "content_sanskrit": "वैरस्यास्य गताः पारं हत्वा दुर्योधनं रणे।\nराज्यं युधिष्ठिरे प्राप्ते वयं च गतमन्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070551, "chapter_id": 2482, "verse_number": "११-१४-१२x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070552, "chapter_id": 2482, "verse_number": "११-१४-१२", "content_sanskrit": "न तस्यैवं वधस्तात यं प्रशंससि मे सुतम्।\nकृतवांश्चापि तत्सर्वं यदिदं भाषसे मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070553, "chapter_id": 2482, "verse_number": "११-१४-१३", "content_sanskrit": "हताश्वे नकुले यत्तु वृषसेनेन भारत।\nअपिबः शोणितं सङ्ख्ये दुःशासनशरीरजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070554, "chapter_id": 2482, "verse_number": "११-१४-१४", "content_sanskrit": "सद्भिर्विगर्हितं घोरमनार्यजनसेवितम्।\nक्रूरं कर्माकृथास्तस्मात्तदयुक्तं वृकोदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070555, "chapter_id": 2482, "verse_number": "११-१४-१५x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070556, "chapter_id": 2482, "verse_number": "११-१४-१५", "content_sanskrit": "हताश्वं नकुलं दृष्ट्वा वृषसेनेन संयुगे।\nशत्रूणां तु प्रहृष्टानां त्रासः सञ्जनितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070557, "chapter_id": 2482, "verse_number": "११-१४-१६", "content_sanskrit": "`स प्रतिज्ञामकरवं पिबाम्यसृगरेरिति।\nरुधिरं नातिचक्राम दन्तोष्ठादम्ब मा शुचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070558, "chapter_id": 2482, "verse_number": "११-१४-१७", "content_sanskrit": "[अन्यस्यापि न पातव्यं रुधिरं किंपुनः स्वकम्।\nयथैवात्मा तथा भ्राता विशेषो नास्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070559, "chapter_id": 2482, "verse_number": "११-१४-१८", "content_sanskrit": "वैवस्तितो हि तद्वेद यथावत्कुलनन्दिनि।\nमा कृथा हृदि तन्मातर्न तत्पीतं मयाऽनधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070560, "chapter_id": 2482, "verse_number": "११-१४-१९", "content_sanskrit": "केशपक्षपरामर्शे द्रौपद्या द्यूतकारिते।\nक्रोधाद्यदब्रवं चाहं तच्च मे हृदि वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070561, "chapter_id": 2482, "verse_number": "११-१४-२०", "content_sanskrit": "क्षत्रधर्माच्च्युतो राज्ञि भवेयं शाश्वतीः समाः।\nप्रतिज्ञां तामनिस्तीर्य ततस्तत्कृतवानहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070562, "chapter_id": 2482, "verse_number": "११-१४-२१", "content_sanskrit": "अनिगृह्य पुरा पुत्रानस्मस्वनपकारिषु।\nन ममार्हसि कल्याणि दोषेण परिशङ्कितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070563, "chapter_id": 2482, "verse_number": "११-१४-२२x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070564, "chapter_id": 2482, "verse_number": "११-१४-२२", "content_sanskrit": "वृद्धस्यास्य शतं पुत्रान्निघ्नंस्त्वमपराजितः।\nकस्मानाशेषयः कञ्चिद्येनाल्पमपराधितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070565, "chapter_id": 2482, "verse_number": "११-१४-२३", "content_sanskrit": "सन्तानमावयोस्तात वृद्धयोर्हृतराज्ययोः।\nनाशेषयः कथं यष्टिमेकां वृद्धयुगस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070566, "chapter_id": 2482, "verse_number": "११-१४-२४", "content_sanskrit": "शेषे ह्यवस्थिते तात पुत्राणामल्पकेऽपि च।\nमन्ददुःखं भवेदद्य यदि त्वं धर्ममाचरेः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070567, "chapter_id": 2482, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि चतुर्दशोऽध्यायः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]