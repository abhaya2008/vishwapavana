[{"id": 2108909, "chapter_id": 3362, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108910, "chapter_id": 3362, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा जरत्कारुः भृशं शोकपरायणः ।\nउवाच स्वान् पितॄन् दुःखाद् बाष्पसन्दिग्धया गिरा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108911, "chapter_id": 3362, "verse_number": "२", "content_sanskrit": "पूर्वे भवन्तः सर्वे वै पितरः सपितामहाः ।\nतद् ब्रूत यन्मया कार्यं भवतां प्रियकाम्यया\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108912, "chapter_id": 3362, "verse_number": "३", "content_sanskrit": "अहमेव जरत्कारुः किल्बिषी भवतां सुतः ।\nतं दण्डं धारयत मे दुष्कृतेरकृतात्मनः\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108913, "chapter_id": 3362, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108914, "chapter_id": 3362, "verse_number": "४", "content_sanskrit": "पुत्र दिष्ट्याऽसि सम्प्राप्त इमं देशं यदृच्छया ।\nकिमर्थं च त्वया ब्रह्मन् न कृतो दारसङ्ग्रहः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108915, "chapter_id": 3362, "verse_number": "५", "content_sanskrit": "धर्मार्थकामैस्तु सुखैः प्रहीना\nभिक्षाटना कर्पटबद्धगात्राः ।\nक्षुत्क्षामकण्ठा वसुधां भ्रमन्तो\nदारान् परित्यज्य गता नरा ये\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108916, "chapter_id": 3362, "verse_number": "६", "content_sanskrit": "न तु क्रतुशतैर्लोकान् स्वर्गं प्राप्स्यन्ति मानवाः ।\nतपोभिर्विविधैश्चापि यान् लोकान् पुत्रिणो गताः\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108917, "chapter_id": 3362, "verse_number": "", "content_sanskrit": "जरत्कारुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108918, "chapter_id": 3362, "verse_number": "७", "content_sanskrit": "ममायं पितरो नित्यं हृद्यर्थः परिवर्तते ।\nऊर्ध्वरेताः शरीरं वै प्रापयेयममुत्र ह\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108919, "chapter_id": 3362, "verse_number": "८", "content_sanskrit": "एवं दृष्ट्वा तु भवतः शकुन्तानिव लम्बितान् ।\nमया निवर्तिता बुद्धिर्ब्रह्मचर्यात् पितामहाः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108920, "chapter_id": 3362, "verse_number": "९", "content_sanskrit": "करिष्ये वः प्रियं कार्यं नियोज्यो नात्र संशयः ।\nसनामां यद्यहं कन्यामुपलप्स्ये कदाचन \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108921, "chapter_id": 3362, "verse_number": "१०", "content_sanskrit": "भविष्यति च या काचिद् भैक्षवत् स्वयमुद्यता ।\nप्रतिग्रहीता तामस्मि न भरेयं च तामहम्\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108922, "chapter_id": 3362, "verse_number": "११", "content_sanskrit": "एवंविधमहं कुर्यां निवेशं प्राप्नुयां यदि ।\nअन्यथा न करिष्येऽहं सत्यमेतत् पितामहाः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108923, "chapter_id": 3362, "verse_number": "१२", "content_sanskrit": "तत्र चोत्पत्स्यते जन्तुर्भवतां तारणाय वै ।\nसान्त्विताश्चाव्यथाश्चैव तिष्ठन्तु पितरो मम \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108924, "chapter_id": 3362, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108925, "chapter_id": 3362, "verse_number": "१३", "content_sanskrit": "एवमुक्त्वा तु स पितॄंश्चचार पृथिवीं मुनिः ।\nन च स्म लभते भार्यां वृद्धोऽयमिति शौनक \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108926, "chapter_id": 3362, "verse_number": "१४", "content_sanskrit": "यदा निर्वेदमापन्नः पितृभिश्चोदितस्तथा ।\nतदाऽरण्यं स गत्वोच्चैः चुक्रोश भृशदुःखितः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108927, "chapter_id": 3362, "verse_number": "१५", "content_sanskrit": "यानि भूतानि सन्तीह जङ्गमस्थावराणि च ।\nअन्तर्हितानि वा यानि तानि शृण्वन्तु मे वचः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108928, "chapter_id": 3362, "verse_number": "१६", "content_sanskrit": "उग्रे तपसि वर्तन्तं पितरश्चोदयन्ति माम् ।\nनिविशस्वेति दुःखार्तास्तेषां प्रियचिकीर्षया \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108929, "chapter_id": 3362, "verse_number": "१७", "content_sanskrit": "निवेशार्थ्यखिलां भूमिं कन्याभैक्षं चरामि भो ।\nदरिद्रो दुःखशीलश्च पितृभिः सुनियोजितः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108930, "chapter_id": 3362, "verse_number": "१९", "content_sanskrit": "यस्य कन्याऽस्ति भूतस्य गुणैः सम्यक् प्रकीर्तिता ।\nप्रयच्छतु स मे कन्यां चरतः सर्वतो दिशम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108931, "chapter_id": 3362, "verse_number": "२०", "content_sanskrit": "मम कन्या सनामा या भैक्षवच्चोद्यता भवेत् ।\nभरेयं चैव यां नाहं तां मे कन्यां प्रयच्छतु \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108932, "chapter_id": 3362, "verse_number": "२१", "content_sanskrit": "ततस्ते पन्नगा ये वै जरत्कारौ समाहिताः ।\nतामादाय प्रवृत्तिं ते वासुकेः प्रत्यवेदयन् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108933, "chapter_id": 3362, "verse_number": "२२", "content_sanskrit": "तेषां श्रुत्वाऽथ नागेन्द्रः तां कन्यां समलङ्कृताम् ।\nप्रगृह्यारण्यमगमत् समीपं तस्य पन्नगः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108934, "chapter_id": 3362, "verse_number": "२३", "content_sanskrit": "तां तस्मै भैक्षवत् कन्यां प्रादात् तत्र महात्मने ।\nनागेन्द्रो वासुकिर्ब्रह्मन् न स तां प्रत्यगृह्णत \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108935, "chapter_id": 3362, "verse_number": "२४", "content_sanskrit": "असनामेति वै कृत्वा भरणे चाविचारिते ।\nमोक्षभावे स्थितश्चापि मन्दीभूतः परिग्रहे \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108936, "chapter_id": 3362, "verse_number": "२५", "content_sanskrit": "ततो नाम स कन्यायाः पप्रच्छ भृगुनन्दन ।\nवासुके भरणं चास्या न कुर्यामित्युवाच ह \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108937, "chapter_id": 3362, "verse_number": "२९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वण्ये-कचत्वारिंशोऽध्यायः ॥४१॥ ॥ आस्तीकपर्वणि एकोनत्रिं शोऽध्यायः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]