[{"id": 2082823, "chapter_id": 2766, "verse_number": "१२-२७१-०x", "content_sanskrit": "`युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082824, "chapter_id": 2766, "verse_number": "१२-२७१-१", "content_sanskrit": "शरीरमापदश्चैव न विदन्त्यविहिंसकाः।\nकथं यात्रा शरीरस्य निरारम्भस्य सेत्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082825, "chapter_id": 2766, "verse_number": "१२-२७१-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082826, "chapter_id": 2766, "verse_number": "१२-२७१-२", "content_sanskrit": "यथा शरीरं न म्लायेन्नैव मृत्युवशं भवेत्।\nतथा कर्मसु वर्तेत समर्थो धर्ममाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082827, "chapter_id": 2766, "verse_number": "१२-२७१-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nप्रजानामनुकम्पार्थं गीतं राज्ञा विचख्युना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082828, "chapter_id": 2766, "verse_number": "१२-२७१-४", "content_sanskrit": "छिन्नस्थूणं वृपं दृष्ट्वा विरावं च गवां भृशम्।\nगोगृहे यज्ञवाटे च प्रेक्षमाणः स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082829, "chapter_id": 2766, "verse_number": "१२-२७१-५", "content_sanskrit": "स्वस्ति गोभ्योऽस्तु लोकेषु ततो निर्वचनं कृतम्।\nहिंसायां हि प्रवृत्तायामाशीरेषा तु कल्पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082830, "chapter_id": 2766, "verse_number": "१२-२७१-६", "content_sanskrit": "अव्यवस्थितमर्यादैर्विमूढैर्नास्तिकैर्नरैः।\nसंशयात्मभिरव्यक्तैर्हिंसा समनुदर्शिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082831, "chapter_id": 2766, "verse_number": "१२-२७१-७", "content_sanskrit": "सर्वकर्मग्वहिंसां हि धर्मात्मा मनुरब्रवीत्।\nकामकाराद्विहिंसन्ति बहिर्वेद्यां पशून्नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082832, "chapter_id": 2766, "verse_number": "१२-२७१-८", "content_sanskrit": "तस्मात्प्रमाणतः कार्यो धर्मः सूक्ष्मो विजानता।\nअहिंसा ह्येव सर्वेभ्यो धर्मेभ्यो ज्यायसी मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082833, "chapter_id": 2766, "verse_number": "१२-२७१-९", "content_sanskrit": "उपोष्य संशितो भूत्वा हित्वा वेदकृतां शुचिः।\nआचार इत्यनाचारः कृपणाः फलहेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082834, "chapter_id": 2766, "verse_number": "१२-२७१-१०", "content_sanskrit": "यदि च्छिन्दन्ति वृक्षांश्च यूपांश्चोद्दिश्य मानवाः।\nवृथा मांसानि खादन्ति नैप धर्मः प्रशस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082835, "chapter_id": 2766, "verse_number": "१२-२७१-११", "content_sanskrit": "सुरां मत्स्यान्मधु मांसमासवं कृसरौदनम्।\nधूर्तैः प्रवर्तितं ह्येतन्नैतद्वेदेषु कल्पितम्।\nकामान्मोहाच्च लोभाच्च लौल्यमेतत्प्रवर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082836, "chapter_id": 2766, "verse_number": "१२-२७१-१२", "content_sanskrit": "विष्णुमेवाभिजानन्ति सर्वयज्ञेषु ब्राह्मणाः।\nपायसैः सुमनोभिश्च तस्यैव यजनं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082837, "chapter_id": 2766, "verse_number": "१२-२७१-१३", "content_sanskrit": "यज्ञियाश्चैव ये वृक्षा वेदेषु परिकल्पिताः।\nयच्चापि किंचित्कर्तव्यमन्यच्चोक्षैः सुसंस्कृतम्।\nमहासत्वैः शुद्धभावैः सर्वं देवार्हमेव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082838, "chapter_id": 2766, "verse_number": "१२-२७१-१४x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082839, "chapter_id": 2766, "verse_number": "१२-२७१-१४", "content_sanskrit": "शरीरमापदश्चापि विवदन्त्यविहंसतः।\nकथं यात्रा शरीरस्य निरारम्भस्य सेत्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082840, "chapter_id": 2766, "verse_number": "१२-२७१-१५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082841, "chapter_id": 2766, "verse_number": "१२-२७१-१५", "content_sanskrit": "यथा शरीरं न ग्लायेन्नेयान्मृत्युवशं यथा।\nतथा कर्मसु वर्तेत समर्थो धर्ममाचरेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082842, "chapter_id": 2766, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकसप्तत्यधिकद्विशततमोऽध्यायः॥ २७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]