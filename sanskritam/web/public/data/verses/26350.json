[{"id": 7006350000, "chapter_id": 26350, "verse_number": "२-६-१", "content_sanskrit": "वैशम्पायन उवाच\nतत्र तस्यासतः कालः सुमहानत्यवर्तत ।\nगोव्रजे नन्दगोपस्य बल्लवत्वं प्रकुर्वतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006350001, "chapter_id": 26350, "verse_number": "२-६-२", "content_sanskrit": "दारकौ कृतनामानौ ववृधाते सुखं च तौ ।\nज्येष्ठः संकर्षणो नाम कनीयान् कृष्ण एव तु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006350002, "chapter_id": 26350, "verse_number": "२-६-३", "content_sanskrit": "मेघकृष्णस्तु कृष्णोऽभूद् देहान्तरगतो हरिः ।\nव्यवर्धत गवां मध्ये सागरस्य इवाम्बुदः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006350003, "chapter_id": 26350, "verse_number": "२-६-४", "content_sanskrit": "शकटस्य त्वधः सुप्तं कदाचित् पुत्रगृद्धिनी ।\nयशोदा तं समुत्सृज्य जगाम यमुनां नदीम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006350004, "chapter_id": 26350, "verse_number": "२-६-५", "content_sanskrit": "शिशुलीलां ततः कुर्वन्स हस्तचरणौ क्षिपन् ।\nरुरोद मधुरं कृष्णः पादावूर्ध्वं प्रसारयन् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006350005, "chapter_id": 26350, "verse_number": "२-६-६", "content_sanskrit": "स तत्रैकेन पादेन शकटं पर्यवर्तयत् ।\nन्युब्जं पयोधराकाङ्क्षी चकार च रुरोद च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006350006, "chapter_id": 26350, "verse_number": "२-६-७", "content_sanskrit": "एतस्मिन्नन्तरे प्राप्ता यशोदा भयविक्लवा ।\nस्नाता प्रस्रवदिग्धाङ्गी बद्धवत्सेव सौरभी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006350007, "chapter_id": 26350, "verse_number": "२-६-८", "content_sanskrit": "सा ददर्श विपर्यस्तं शकटं वायुना विना ।\nहाहेति कृत्वा त्वरिता दारकं जगृहे तदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006350008, "chapter_id": 26350, "verse_number": "२-६-९", "content_sanskrit": "न सा बुबोध तत्त्वेन शकटं परिवर्तितम् ।\nस्वस्ति मे दारकायेति प्रीता भीता च साभवत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006350009, "chapter_id": 26350, "verse_number": "२-६-१०", "content_sanskrit": "किं तु वक्ष्यति ते पुत्र पिता परमकोपनः ।\nत्वय्यधःशकटे सुप्ते अकस्माच्च विलोडिते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006350010, "chapter_id": 26350, "verse_number": "२-६-११", "content_sanskrit": "किं मे स्नानेन दुःस्नानं किं च मे गमने नदीम् ।\nपर्यस्ते शकटे पुत्र या त्वां पश्याम्यपावृतम् ॥ ११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006350011, "chapter_id": 26350, "verse_number": "२-६-१२", "content_sanskrit": "एतस्मिन्नन्तरे गोभिराजगाम वनेचरः ।\nकाषायवाससी बिभ्रन् नन्दगोपो व्रजान्तिकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006350012, "chapter_id": 26350, "verse_number": "२-६-१३", "content_sanskrit": "स ददर्श विपर्यस्तं भिन्नभाण्डघटीघटम् ।\nअपास्तधूर्विभिन्नाक्षं शकटं चक्रमौलिनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006350013, "chapter_id": 26350, "verse_number": "२-६-१४", "content_sanskrit": "भीतस्त्वरितमागत्य सहसा साधुलोचनः ।\nअपि मे स्वस्तिपुत्रायेत्यसकृद् वचनं वदन् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006350014, "chapter_id": 26350, "verse_number": "२-६-१५", "content_sanskrit": "पिबन्तं स्तनमालक्ष्य पुत्रं स्वस्थोऽब्रवीत्पुनः ।\nवृषयुद्धं विना केन पर्यस्तं शकटं मम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006350015, "chapter_id": 26350, "verse_number": "२-६-१६", "content_sanskrit": "प्रत्युवाच यशोदा तं भीता गद्गदभाषिणी ।\nन विजानाम्यहं केन शकटं परिवर्तितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006350016, "chapter_id": 26350, "verse_number": "२-६-१७", "content_sanskrit": "अहं नदी गता सौम्य चैलप्रक्षालनार्थिनी ।\nआगता च विपर्यस्तमपश्यं शकटं भुवि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006350017, "chapter_id": 26350, "verse_number": "२-६-१८", "content_sanskrit": "तयोः कथयतोरेवमब्रुवंस्तत्र दारकाः ।\nअनेन शिशुना यानमेतत् पादेन लोडितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006350018, "chapter_id": 26350, "verse_number": "२-६-१९", "content_sanskrit": "अस्माभिः सम्पतद्भिश्च दृष्टमेतद् यदृच्छया ।\nनन्दगोपस्तु तच्छ्रुत्वा विस्मयं परमं ययौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006350019, "chapter_id": 26350, "verse_number": "२-६-२०", "content_sanskrit": "प्रहृष्टश्चैव भीतश्च किमेतदिति चिन्तयन् ।\nन च ते श्रद्दधुर्गोपाः सर्वे मानुषबुद्धयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006350020, "chapter_id": 26350, "verse_number": "२-६-२१", "content_sanskrit": "आश्चर्यमिति ते सर्वे विस्मयोत्फुल्ललोचनाः ।\nस्वे स्थाने शकटं स्थाप्य चक्रबन्धमकारयन् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006350021, "chapter_id": 26350, "verse_number": "२-६-२२", "content_sanskrit": "वैशम्पायन उवाच\nकस्यचित्त्वथ कालस्य शकुनी वेषधारिणी ।\nधात्री कंसस्य भोजस्य पूतनेति परिश्रुता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006350022, "chapter_id": 26350, "verse_number": "२-६-२३", "content_sanskrit": "पूतना नाम शकुनी घोरा प्राणिभयंकरी ।\nआजगामार्द्धरात्रे वै पक्षौ क्रोधाद् विधुन्वती ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006350023, "chapter_id": 26350, "verse_number": "२-६-२४", "content_sanskrit": "ततोऽर्धरात्रसमये पूतना प्रत्यदृश्यत ।\nव्याघ्रगम्भीरनिर्घोषं व्याहरन्ती पुनः पुनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006350024, "chapter_id": 26350, "verse_number": "२-६-२५", "content_sanskrit": "निलिल्ये शकटस्याक्षे प्रस्रवोत्पीडवर्षिणी ।\nददौ स्तनं च कृष्णाय तस्मिन् सुप्ते जने निशि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006350025, "chapter_id": 26350, "verse_number": "२-६-२६", "content_sanskrit": "तस्याः स्तनं पपौ कृष्णः प्राणैः सह विनद्य च ।\nछिन्नस्तनी तु सहसा पपात शकुनी भुवि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006350026, "chapter_id": 26350, "verse_number": "२-६-२७", "content_sanskrit": "तेन शब्देन वित्रस्तास्ततो बुबुधिरे भयात् ।\nस नन्दगोपो गोपा वै यशोदा च सुविक्लवा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006350027, "chapter_id": 26350, "verse_number": "२-६-२८", "content_sanskrit": "ते तामपश्यन् पतितां विसंज्ञां विपयोधराम् ।\nपूतनां पतितां भूमौ वज्रेणेव विदारिताम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006350028, "chapter_id": 26350, "verse_number": "२-६-२९", "content_sanskrit": "इदं किं त्विति संत्रस्ताः कस्येदं कर्म चेत्यपि ।\nनन्दगोपं पुरस्कृत्य गोपास्ते पर्यवारयन् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006350029, "chapter_id": 26350, "verse_number": "२-६-३०", "content_sanskrit": "नाध्यगच्छन्त च तदा हेतुं तत्र कदाचन ।\nआश्चर्यमाश्चर्यमिति ब्रुवन्तोऽनुययुर्गृहान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006350030, "chapter_id": 26350, "verse_number": "२-६-३१", "content_sanskrit": "गतेषु तेषु गोपेषु विस्मितेषु यथागृहम् ।\nयशोदां नन्दगोपस्तु पप्रच्छ गतसम्भ्रमः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006350031, "chapter_id": 26350, "verse_number": "२-६-३२", "content_sanskrit": "कोऽयं विधिर्न जानामि विस्मयो मे महानयम् ।\nपुत्रस्य मे भयं तीव्रं भीरुत्वं समुपागतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006350032, "chapter_id": 26350, "verse_number": "२-६-३३", "content_sanskrit": "यशोदा त्वब्रवीद् भीता नार्य जानामि किं त्विदम् ।\nदारकेण सहानेन सुप्ता शब्देन बोधिता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006350033, "chapter_id": 26350, "verse_number": "२-६-३४", "content_sanskrit": "यशोदायामजानन्त्यां नन्दगोपः सबान्धवः ।\nकंसाद् भयं चकारोग्रं विस्मयं च जगाम ह ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]