[{"id": 2177913, "chapter_id": 4758, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177914, "chapter_id": 4758, "verse_number": "१", "content_sanskrit": "ततोऽमृतरसैर्वाक्यैर्ह्लादयन् पुरुषर्षभम् ।\nवैचित्रवीर्यं विदुरो यदुवाच निबोध तत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177915, "chapter_id": 4758, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177916, "chapter_id": 4758, "verse_number": "२", "content_sanskrit": "उत्तिष्ठ राजन् किं शेषे धारयात्मानमात्मना ।\nएषा वै सर्वसत्त्वानां लोकेश्वर परा गतिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177917, "chapter_id": 4758, "verse_number": "३", "content_sanskrit": "सर्वे क्षयान्ता निचयाः पतनान्ताः समुच्छ्रयाः ।\nसंयोगा विप्रयोगान्ता मरणान्तं च जीवितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177918, "chapter_id": 4758, "verse_number": "४", "content_sanskrit": "यथा शूरं च भीरुं च यमः कर्षति भारत ।\nतत् किं न योत्स्यन्ति हि ते क्षत्रियाः क्षत्रियर्षभ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177919, "chapter_id": 4758, "verse_number": "५", "content_sanskrit": "अयुध्यमानो म्रियते युध्यमानश्च जीवति ।\nकालं प्राप्य महाराज न कश्चिदतिवर्तते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177920, "chapter_id": 4758, "verse_number": "६", "content_sanskrit": "अभावादीनि भूतानि भावमध्यानि भारत ।\nअभावनिधनान्येव तत्र का परिदेवना\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177921, "chapter_id": 4758, "verse_number": "७", "content_sanskrit": "न शोचन् मृतिमन्वेति न शोचन् म्रियते नरः ।\nएवं संसाधिते लोके किमर्थमनुशोचसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177922, "chapter_id": 4758, "verse_number": "८", "content_sanskrit": "कालः कर्षति भूतानि सर्वाणि विविधान्युत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177923, "chapter_id": 4758, "verse_number": "९", "content_sanskrit": "यथा वायुस्तृणाग्राणि संवर्तयति सर्वशः ।\nतथा कालवशं यान्ति भूतानि भरतर्षभ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177924, "chapter_id": 4758, "verse_number": "१०", "content_sanskrit": "एकसार्थप्रयातानां सर्वेषां तत्र गामिनाम् ।\nयस्य कालः प्रयात्यग्रे तत्र का परिदेवना\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177925, "chapter_id": 4758, "verse_number": "११", "content_sanskrit": "न चाप्येतान् मृतान् युद्धे राजन् शोचितुमर्हसि ।\nप्रमाणं यदि शास्त्राणि गतास्ते परमां गतिम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177926, "chapter_id": 4758, "verse_number": "१२", "content_sanskrit": "सर्वे स्वाध्यायवन्तो हि सर्वे च चरितव्रताः ।\nसर्वे चाभिमुखाः क्षीणाः तत्र का परिदेवना\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177927, "chapter_id": 4758, "verse_number": "१३", "content_sanskrit": "अदर्शनादापतिताः पुनश्चादर्शनं गताः ।\nन ते तव न तेषां त्वं तत्र का परिदेवना\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177928, "chapter_id": 4758, "verse_number": "१४", "content_sanskrit": "हतो हि लभते स्वर्गं जित्वा वा लभते यशः ।\nउभयं नो बहुगुणं नास्ति निष्फलता रणे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177929, "chapter_id": 4758, "verse_number": "१५", "content_sanskrit": "तेषां कामदुघान् लोकान् इन्द्रः सङ्कल्पयिष्यति ।\nइन्द्रस्यातिथयो ह्येते भवन्ति पुरुषर्षभ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177930, "chapter_id": 4758, "verse_number": "१६", "content_sanskrit": "न यज्ञैर्दक्षिणावद्भिर्न तपोभिर्न विद्यया ।\nस्वर्गं याति तथा मर्त्यो यथा शूरो रणे हतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177931, "chapter_id": 4758, "verse_number": "१७", "content_sanskrit": "शरीराग्निषु ते शूरा जुहुवुर्वै शराहतीः ।\nहूयमानान् शरांश्चैव सेहुस्तेजस्विनो मिथः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177932, "chapter_id": 4758, "verse_number": "१८", "content_sanskrit": "एतद्राजंस्तवाऽऽचक्षे स्वर्गं पन्थानमुत्तमम् ।\nन युद्धादधिकं किञ्चित् क्षत्रियस्येह विद्यते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177933, "chapter_id": 4758, "verse_number": "१९", "content_sanskrit": "क्षत्रियास्ते महात्मानः शूराः समितिशोभनाः ।\nअमृतं परमं प्राप्ता न शोच्याः सर्व एव हि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177934, "chapter_id": 4758, "verse_number": "२०", "content_sanskrit": "आत्मानमात्मनाऽऽश्वास्य मा शुचः पुरुषर्षभ ।\nनाद्य शोकाभिभूतस्त्वं कार्यमुत्स्रष्टुमर्हसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177935, "chapter_id": 4758, "verse_number": "२१", "content_sanskrit": "मातापितृसहस्राणि पुत्रदारशतानि च ।\nसंसारेष्वनुभूतानि कस्य ते कस्य वा वयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2177936, "chapter_id": 4758, "verse_number": "२२", "content_sanskrit": "शोकस्थानसहस्राणि भयस्थानशतानि च ।\nदिवसे दिवसे मूढमाविशन्ति न पण्डितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2177937, "chapter_id": 4758, "verse_number": "२३", "content_sanskrit": "न कालस्य प्रियः कश्चिन्न द्वेष्यः कुरुसत्तम ।\nन मध्यस्थः क्वचित् कालः सर्वं कालः प्रकर्षति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2177938, "chapter_id": 4758, "verse_number": "२४", "content_sanskrit": "कालः पचति भूतानि कालः संहरते प्रजाः ।\nकालः सुप्तेषु जागर्ति कालो हि दुरतिक्रमः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2177939, "chapter_id": 4758, "verse_number": "२५", "content_sanskrit": "अनित्यं जीवितं रूपं यौवनं द्रव्यसञ्चयः ।\nआरोग्यं प्रियसंवादो गृध्येन्न ह्येषु पण्डितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2177940, "chapter_id": 4758, "verse_number": "२६", "content_sanskrit": "न हि जानपदं दुःखमेकः शोचितुमर्हसि ।\nअप्यभावेन युज्येत तच्चास्य न निवर्तते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2177941, "chapter_id": 4758, "verse_number": "२७", "content_sanskrit": "अशोचन् प्रतिकुर्वीत यदि पश्येत् पराक्रमम् ।\nभैषज्यमेतद् दुःखस्य यदेवं नानुचिन्तयेत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2177942, "chapter_id": 4758, "verse_number": "२८", "content_sanskrit": "चिन्त्यमानं हि नापैति भूयश्चापि विवर्धते ।\nअनिष्टसम्प्रयोगाच्च विप्रयोगात् प्रियस्य च\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2177943, "chapter_id": 4758, "verse_number": "२९", "content_sanskrit": "अलब्धलाभाः क्लिश्यन्ते लब्धलाभानुपातिनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2177944, "chapter_id": 4758, "verse_number": "३०", "content_sanskrit": "मनुष्याः मानसैर्दुःखैर्युज्यन्ते येऽल्पबुद्धयः ।\nनार्थो न धर्मो न सुखं यदेतदनुशोचसि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2177945, "chapter_id": 4758, "verse_number": "३१", "content_sanskrit": "तच्च नाप्नोति कार्यार्थं त्रिवर्गाच्चैव भ्रश्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2177946, "chapter_id": 4758, "verse_number": "३२", "content_sanskrit": "अन्योन्यबाधनावस्थां प्राप्य वैषयिका नराः ।\nअसन्तुष्टाः प्रमुह्यन्ति सन्तोषं यान्ति पण्डिताः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2177947, "chapter_id": 4758, "verse_number": "३३", "content_sanskrit": "प्रज्ञया मानसं दुःखं हन्याच्छारीरमौषधैः ।\nएतज्ज्ञानस्य सामर्थ्यं न बालैः समतामियात्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2177948, "chapter_id": 4758, "verse_number": "३४", "content_sanskrit": "शयानं चानुशयति तिष्ठन्तं चानुतिष्ठति ।\nअनुधावति धावन्तं कर्म पूर्वकृतं नरम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2177949, "chapter_id": 4758, "verse_number": "३५", "content_sanskrit": "यस्यां यस्यामवस्थायां यत् करोति शुभाशुभम् ।\nतस्यां तस्यामवस्थायां तत्तत् फलमवाप्नुयात्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177950, "chapter_id": 4758, "verse_number": "३६", "content_sanskrit": "येन येन शरीरेण यद्यत् कर्म करोति यः ।\nतेन तेन शरीरेण तत्फलं समुपाश्नुते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177951, "chapter_id": 4758, "verse_number": "३७", "content_sanskrit": "आत्मैव ह्यात्मनो बन्धुरात्मैव रिपुरात्मनः ।\nआत्मैव ह्यात्मनः साक्षी कृतस्याप्यकृतस्य च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2177952, "chapter_id": 4758, "verse_number": "३८", "content_sanskrit": "शुभेन कर्मणा सौख्यं दुःखं पापेन कर्मणा ।\nकृतं लभेत सर्वत्र नाकृतं विन्दते क्वचित्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2177953, "chapter_id": 4758, "verse_number": "३९", "content_sanskrit": "न हि ज्ञानविरुद्धेषु बहुपापेषु कर्मसु ।\nमूलघातिषु सञ्जाते बुद्धिमन्तो भवद्विधाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2177954, "chapter_id": 4758, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nधृतराष्ट्रशोकोत्पत्तिर्नाम द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2177955, "chapter_id": 4758, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]