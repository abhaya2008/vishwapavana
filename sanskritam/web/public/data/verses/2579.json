[{"id": 2074777, "chapter_id": 2579, "verse_number": "१२-८४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074778, "chapter_id": 2579, "verse_number": "१२-८४-१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nबृहस्पतेश्च संवादं शक्रस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074779, "chapter_id": 2579, "verse_number": "१२-८४-२x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074780, "chapter_id": 2579, "verse_number": "१२-८४-२", "content_sanskrit": "किंस्विदेकपढं ब्रह्मन्पुरुषः सम्यगाचरन्।\nप्रमाणं सर्वभूतानां यशश्चैवाप्नुयान्महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074781, "chapter_id": 2579, "verse_number": "१२-८४-३x", "content_sanskrit": "बृहस्पति उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074782, "chapter_id": 2579, "verse_number": "१२-८४-३", "content_sanskrit": "सान्त्वमेकपदं शक्र पुरुषः सम्यगाचरन्।\nप्रमाणं सर्वभूतानां यशश्चैवाप्नुयान्महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074783, "chapter_id": 2579, "verse_number": "१२-८४-४", "content_sanskrit": "एतदेकपदं शक्र सर्वलोकसुखावहम्।\nआचरन्सर्वभूतेषु प्रियो भवति सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074784, "chapter_id": 2579, "verse_number": "१२-८४-५", "content_sanskrit": "यो हि नाभाषते किंचित्सर्वदा भुकुटीमुखः।\nद्वेष्यो भवति भूतानां स सान्त्वमिह नाचरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074785, "chapter_id": 2579, "verse_number": "१२-८४-६", "content_sanskrit": "यस्तु सर्वमभिप्रेक्ष्य पूर्वमेवाभिभाषते।\nस्मितपूर्वाभिभाषी च तस्य लोकः प्रसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074786, "chapter_id": 2579, "verse_number": "१२-८४-७", "content_sanskrit": "दानमेव हि सर्वत्र सान्त्वेनानभिजल्पितम्।\nन प्रीणयति भूतानि निर्व्यञ्जनमिवाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074787, "chapter_id": 2579, "verse_number": "१२-८४-८", "content_sanskrit": "आददन्नपि भूतानां मधुरामीरयन्गिरम्।\nसर्वलोकमिमं शक्र सान्त्वेव कुरुते वशे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074788, "chapter_id": 2579, "verse_number": "१२-८४-९", "content_sanskrit": "तस्मात्सान्त्वं प्रयोक्तव्यं दण्डमाधित्सताऽपि हि।\nप्रीतिं च जनयत्येवं न चास्योद्विजते जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074789, "chapter_id": 2579, "verse_number": "१२-८४-१०", "content_sanskrit": "सुकृतस्य हि सान्त्वस्य श्लक्ष्णस्य मधुरस्य च।\nसम्यगासेव्यमानस्य तुल्यं जातु न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074790, "chapter_id": 2579, "verse_number": "१२-८४-११x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074791, "chapter_id": 2579, "verse_number": "१२-८४-११", "content_sanskrit": "इत्युक्तः कृतवान्सर्वं यथा शक्रः पुरोधसा।\nतथा त्वमपि कौन्तेय सम्यगेतत्समाचर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074792, "chapter_id": 2579, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि चतुरशीतितमोऽध्यायः॥ ८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]