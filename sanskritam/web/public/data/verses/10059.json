[{"id": 6000059000, "chapter_id": 10059, "verse_number": null, "content_sanskrit": "अथ एकोनत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000059001, "chapter_id": 10059, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.001.m4a", "display_order": 2}, {"id": 6000059002, "chapter_id": 10059, "verse_number": "३-२९-१", "content_sanskrit": "योगस्य लक्षणं वक्ष्ये सबीजस्य नृपात्मजे।\nमनो येनैव विधिना प्रसन्नं याति सत्पथम्॥ ३/२९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.002.m4a", "display_order": 3, "topics": [{"text": "कपिलेन देवहूतिं प्रति अष्टाङ्गयोगनिरूपणम्", "range": "१–२०"}]}, {"id": 6000059003, "chapter_id": 10059, "verse_number": "३-२९-२", "content_sanskrit": "स्वधर्माचरणं शक्त्या विधर्माच्च निवर्तनम्।\nदैवलब्धेन सन्तोष आत्मविच्चरणार्चनम्॥ ३/२९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.003.m4a", "display_order": 4}, {"id": 6000059004, "chapter_id": 10059, "verse_number": "३-२९-३", "content_sanskrit": "ग्राम्यधर्मनिवृत्तिश्च मोक्षधर्मरतिस्तथा।\nमितमेध्यादनं शश्वद् विविक्तक्षेत्रसेवनम्॥ ३/२९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.004.m4a", "display_order": 5}, {"id": 6000059005, "chapter_id": 10059, "verse_number": "३-२९-४", "content_sanskrit": "अहिंसा सत्यमस्तेयं यावदर्थपरिग्रहः।\nब्रह्मचर्यं तपः शौचं स्वाध्यायः पुरुषार्चनम्॥ ३/२९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.005.m4a", "display_order": 6}, {"id": 6000059006, "chapter_id": 10059, "verse_number": "३-२९-५", "content_sanskrit": "मौनं सदासनं स्थैर्यं प्राणानां च जयः शनैः।\nप्रत्याहारश्चेन्द्रियाणां विषयान्मनसा हृदि॥ ३/२९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.006.m4a", "display_order": 7}, {"id": 6000059007, "chapter_id": 10059, "verse_number": "३-२९-६", "content_sanskrit": "स्वधिष्ण्यानामेकदेशे मनसा प्राणधारणम्।\nवैकुण्ठलीलाभिध्यानं समाधानं तथाऽऽत्मनः॥ ३/२९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.007.m4a", "display_order": 8}, {"id": 6000059008, "chapter_id": 10059, "verse_number": "३-२९-७", "content_sanskrit": "एतैरन्यैश्च पथिभिर्मनो दुष्टमसत्पथम्।\nबुद्ध्या युञ्जीत शनकैर्जितप्राणो ह्यतन्द्रितः॥ ३/२९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.008.m4a", "display_order": 9}, {"id": 6000059009, "chapter_id": 10059, "verse_number": "३-२९-८", "content_sanskrit": "शुचौ देशे प्रतिष्ठाप्य विजितासन आसनम्।\nतस्मिन् स्वस्तिसमासीन ऋजुकायः समभ्यसेद्॥ ३/२९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.009.m4a", "display_order": 10}, {"id": 6000059010, "chapter_id": 10059, "verse_number": "३-२९-९", "content_sanskrit": "प्राणस्य शोधयेन्मार्गं पूरकुम्भकरेचकैः।\nप्रतिकूलेन वा चित्तं यथा स्थिरमचञ्चलम्॥ ३/२९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.010.m4a", "display_order": 11}, {"id": 6000059011, "chapter_id": 10059, "verse_number": "३-२९-१०", "content_sanskrit": "मनोऽचिरात् स्याद् विरजं जितश्वासस्य योगिनः।\nवाय्वग्निभ्यां यथा लोहं ध्मातं त्यजति वै मलम्॥ ३/२९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.011.m4a", "display_order": 12}, {"id": 6000059012, "chapter_id": 10059, "verse_number": "३-२९-११", "content_sanskrit": "प्राणायामैर्दहेद् दोषान् धारणाभिश्च किल्बिषान्।\nप्रत्याहारेण संसर्गान् ध्यानेनानीश्वरान् गुणान्॥ ३/२९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.012.m4a", "display_order": 13}, {"id": 6000059013, "chapter_id": 10059, "verse_number": "३-२९-१२", "content_sanskrit": "यदा मनः स्वं विरजं योगेन सुसमाहितम्।\nकाष्ठां भगवतो ध्यायेत् स्वनासाग्रावलोकनः॥ ३/२९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.013.m4a", "display_order": 14}, {"id": 6000059014, "chapter_id": 10059, "verse_number": "३-२९-१३", "content_sanskrit": "प्रसन्नवदनाम्भोजं पद्मगर्भारुणेक्षणम्।\nनीलोत्पलदलश्यामं शङ्खचक्रगदाधरम्॥ ३/२९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.014.m4a", "display_order": 15}, {"id": 6000059015, "chapter_id": 10059, "verse_number": "३-२९-१४", "content_sanskrit": "लसत्पङ्कजकिञ्जल्कपीतकौशेयवाससम्।\nश्रीवत्सवक्षसं भ्राजत्कौस्तुभामुक्तकन्धरम्॥ ३/२९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.015.m4a", "display_order": 16}, {"id": 6000059016, "chapter_id": 10059, "verse_number": "३-२९-१५", "content_sanskrit": "मत्तद्विरेफाकुलया परीतं वनमालया।\nपरार्घ्यहारवलयकिरीटाङ्गदनूपुरम्॥ ३/२९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.016.m4a", "display_order": 17}, {"id": 6000059017, "chapter_id": 10059, "verse_number": "३-२९-१६", "content_sanskrit": "काञ्चीगुणोल्लसच्छ्रोणिं हृदयाम्भोजविष्टरम्।\nदर्शनीयतमं शान्तं मनोनयनवर्धनम्॥ ३/२९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.017.m4a", "display_order": 18}, {"id": 6000059018, "chapter_id": 10059, "verse_number": "३-२९-१७", "content_sanskrit": "आपीच्यदर्शनं शश्वत् सर्वलोकनमस्कृतम्।\nसन्तं वयसि कैशोरे भक्तानुग्रहकातरम्॥ ३/२९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.018.m4a", "display_order": 19}, {"id": 6000059019, "chapter_id": 10059, "verse_number": "३-२९-१८", "content_sanskrit": "कीर्तन्यतीर्थयशसं पुण्यश्लोकयशस्करम्।\nध्यायेद् देवं समग्राङ्गं यावन्न च्यवते मनः॥ ३/२९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.019.m4a", "display_order": 20}, {"id": 6000059020, "chapter_id": 10059, "verse_number": "३-२९-१९", "content_sanskrit": "स्थितं व्रजन्तमासीनं शयानं वा गुहाशयम्।\nप्रेक्षणीयेहितं ध्यायेच्छुद्धभावेन चेतसा॥ ३/२९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.020.m4a", "display_order": 21}, {"id": 6000059021, "chapter_id": 10059, "verse_number": "३-२९-२०", "content_sanskrit": "तस्मिन् लब्धपदं चित्तं सर्वावयवसंस्थितम्।\nविलोक्यैकत्र संयुज्यादङ्गे भगवतो मुनिः॥ ३/२९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.021.m4a", "display_order": 22}, {"id": 6000059022, "chapter_id": 10059, "verse_number": "३-२९-२१", "content_sanskrit": "सञ्चिन्तयेद् भगवतश्चरणारविन्दं वज्राङ्कुशध्वजसरोरुहलाञ्छनाढ्यम्।\nउत्तुङ्गरक्तविलसन्नखचक्रवालज्योत्स्नाभिराहतमहद्धृदयान्धकारम्॥ ३/२९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.022.m4a", "display_order": 23, "topics": [{"text": "भगवतः पादादिसर्वावयवध्यानप्रकारः", "range": "२१–४४"}]}, {"id": 6000059023, "chapter_id": 10059, "verse_number": "३-२९-२२", "content_sanskrit": "यच्छौचनिःसृतसरित्प्रवरोदकेन तीर्थेन मूर्ध्न्यधिधृतेन शिवः शिवोऽभूत्।\nध्यातुर्मनःशमलशैलनिसृष्टवज्रं ध्यायेच्चिरं भगवतश्चरणारविन्दम्॥ ३/२९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.023.m4a", "display_order": 24}, {"id": 6000059024, "chapter_id": 10059, "verse_number": "३-२९-२३", "content_sanskrit": "ऊरू सुपर्णभुजयोरधिशोभमानावोजोनिधी स्वतसिकाकुसुमावभासौ।\nव्यालम्बिपीतवरवाससि वर्तमानकाञ्चीकलापपरिरम्भि नितम्बमम्ब॥ ३/२९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.024.m4a", "display_order": 25}, {"id": 6000059025, "chapter_id": 10059, "verse_number": "३-२९-२४", "content_sanskrit": "नाभिह्रदं भुवनकोशगुहोदरस्थं यत्रात्मयोनिधिषणाखिललोकपद्मम्।\nव्यूढं हरिन्मणिमुषः स्तनयोरमुष्य ध्यायेद् द्वयं विततहारमयूखगौरम्॥ ३/२९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.025.m4a", "display_order": 26}, {"id": 6000059026, "chapter_id": 10059, "verse_number": "३-२९-२५", "content_sanskrit": "वक्षोऽधिवासमृषभस्य महाविभूतेः पुंसां मनोनयननिर्वृतिमादधानम्।\nकण्ठं च कौस्तुभमणेरधिभूषणार्थं कुर्यान्मनस्यखिललोकनमस्कृतस्य॥ ३/२९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.026.m4a", "display_order": 27}, {"id": 6000059027, "chapter_id": 10059, "verse_number": "३-२९-२६", "content_sanskrit": "बाहूंश्च मन्दरगिरेः परिवर्तनेन निर्णिक्तबाहुवलयानधिलोकपालान्।\nसञ्चिन्तयेद् दशशतारमसह्यतेजः शङ्खं च तत्करसरोरुहराजहंसम्॥ ३/२९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.027.m4a", "display_order": 28}, {"id": 6000059028, "chapter_id": 10059, "verse_number": "३-२९-२७", "content_sanskrit": "कौमोदकीं भगवतो दयितां स्मरेत दिग्धामरातिभटशोणितकर्दमेन।\nमालां मधुव्रतवरूथगिरोपघुष्टां चैत्त्यस्य तत्त्वममलं मणिमस्य कण्ठे॥ ३/२९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.028.m4a", "display_order": 29}, {"id": 6000059029, "chapter_id": 10059, "verse_number": "३-२९-२८", "content_sanskrit": "भृत्यानुकम्पितधियेह गृहीतमूर्तेः सञ्चिन्तयेद् भगवतो वदनारविन्दम्।\nयद् विस्फुरन्मकरकुण्डलवल्गितेन विद्योतितामलकपोलमुदारहासम्॥ ३/२९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.029.m4a", "display_order": 30}, {"id": 6000059030, "chapter_id": 10059, "verse_number": "३-२९-२९", "content_sanskrit": "यच्छ्रीनिकेतमलिभिः परिसेव्यमानं भूत्या स्वया कुटिलकुन्तलवृन्दजुष्टम्।\nमीनद्वयश्रियमधिक्षिपदब्जनेत्रं ध्यायेन्मनोमयमतन्द्रित उल्लसद्‌भ्रु॥ ३/२९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.030.m4a", "display_order": 31}, {"id": 6000059031, "chapter_id": 10059, "verse_number": "३-२९-३०", "content_sanskrit": "तस्यावलोकमधिकं कृपयातिघोरतापत्रयोपशमनाय निसृष्टमक्ष्णोः।\nस्निग्धस्मितानुगुणितं विपुलप्रसादं ध्यायेच्चिरं विततभावनया गुहायाम्॥ ३/२९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.031.m4a", "display_order": 32}, {"id": 6000059032, "chapter_id": 10059, "verse_number": "३-२९-३१", "content_sanskrit": "हासं हरेरवनताखिललोकतीव्रशोकाश्रुसागरविशोषणमत्युदारम्।\nसंमोहनाय रचितं निजमाययाऽस्य भ्रूमण्डलं मनुसुते मकरध्वजस्य॥ ३/२९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.032.m4a", "display_order": 33}, {"id": 6000059033, "chapter_id": 10059, "verse_number": "३-२९-३२", "content_sanskrit": "ध्यानायनं रहसि तद् बहुलाधरोष्ठभासाऽरुणायिततनुद्विजकुन्दपङ्क्ति।\nध्यायेत् स्वहृत्कुहरकेऽवसितस्य विष्णोर्भक्त्यार्द्रयार्पितमना न पृथग् दिदृक्षेत्॥ ३/२९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.033.m4a", "display_order": 34}, {"id": 6000059034, "chapter_id": 10059, "verse_number": "३-२९-३३", "content_sanskrit": "एवं हरौ भगवति प्रतिलब्धभावो भक्त्या द्रवद्धृदय उत्पुलकप्रमोदः।\nऔत्कण्ठ्यबाष्पकलया मुहुरर्द्यमानस्तच्चापि चित्तबडिशं शनकैर्वियुङ्क्ते॥ ३/२९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.034.m4a", "display_order": 35}, {"id": 6000059035, "chapter_id": 10059, "verse_number": "३-२९-३४", "content_sanskrit": "मुक्ताश्रयं यर्हि निर्विषयं स्वचित्तं निर्वाणमृच्छति मनः सहसा यथार्चिः।\nआत्मानमत्र पुरुषोऽव्यवधानमेकमन्वीक्षते प्रतिनिवृत्तगुणप्रवाहः॥ ३/२९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.035.m4a", "display_order": 36}, {"id": 6000059036, "chapter_id": 10059, "verse_number": "३-२९-३५", "content_sanskrit": "सोऽप्येतया चरमया मनसो निवृत्त्या तस्मिन् महिम्नयवसितः सुखदुःखबाह्ये।\nहेतुत्वमप्यसति कर्तरि दुःखयोर्न स्वात्मन् विधत्त उपलब्धपरात्मकाष्ठः॥ ३/२९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.036.m4a", "display_order": 37}, {"id": 6000059037, "chapter_id": 10059, "verse_number": "३-२९-३६", "content_sanskrit": "देहं तु तं न चरमं स्थितमुज्झितं वा सिद्धो विपश्यति यतोऽध्यगमत्स्वरूपम्।\nदैवादुपेतमथ दैववशादपेतं वासो यथा परिकृतं मदिरामदान्धः॥ ३/२९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.037.m4a", "display_order": 38}, {"id": 6000059038, "chapter_id": 10059, "verse_number": "३-२९-३७", "content_sanskrit": "देहोऽपि दैववशगः खलु कर्म यावत् स्वारम्भकं प्रतिसमीक्षत एव सासुः।\nतं सप्रपञ्चमधिरूढसमाधियोगः स्वाप्नं पुनर्न भजते प्रतिबुद्धवत् सः॥ ३/२९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.038.m4a", "display_order": 39}, {"id": 6000059039, "chapter_id": 10059, "verse_number": "३-२९-३८", "content_sanskrit": "यथा पुत्राच्च वित्ताच्च पृथङ् मर्त्यः प्रतीयते।\nअप्यात्मत्वेनाभिमताद् देहादेः पुरुषस्तथा॥ ३/२९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.039.m4a", "display_order": 40}, {"id": 6000059040, "chapter_id": 10059, "verse_number": "३-२९-३९", "content_sanskrit": "यथोल्मुकाद् विस्फुलिङ्गाद् धूमाद् वाऽपि स्वसम्भवात्।\nअप्यात्मत्वेनाभिमताद् दाहकोऽग्निः पृथङ् मतः॥ ३/२९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.040.m4a", "display_order": 41}, {"id": 6000059041, "chapter_id": 10059, "verse_number": "३-२९-४०", "content_sanskrit": "भूतेन्द्रियान्तःकरणात् प्रधानाज्जीवसंज्ञितात्।\nआत्मा तथा पृथग् द्रष्टा भगवान् ब्रह्मसंज्ञितः॥ ३/२९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.041.m4a", "display_order": 42}, {"id": 6000059042, "chapter_id": 10059, "verse_number": "३-२९-४१", "content_sanskrit": "सर्वभूतेषु चात्मानं सर्वभूतानि चात्मनि।\nईक्षेतानन्यभावेन भूतेषु च तदात्मताम्॥ ३/२९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.042.m4a", "display_order": 43}, {"id": 6000059043, "chapter_id": 10059, "verse_number": "३-२९-४२", "content_sanskrit": "स्वयोनिषु यथा ज्योतिरेकं नाना प्रतीयते।\nयोनीनां गुणवैषम्यात् तथाऽऽत्मा प्रकृतौ स्थितः॥ ३/२९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.043.m4a", "display_order": 44}, {"id": 6000059044, "chapter_id": 10059, "verse_number": "३-२९-४३", "content_sanskrit": "तस्मादिमां स्वां प्रकृतिं देवीं सदसदात्मिकाम्।\nदुर्विभाव्यां पराभाव्य स्वरूपेणावतिष्ठते॥ ३/२९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.044.m4a", "display_order": 45}, {"id": 6000059045, "chapter_id": 10059, "verse_number": "३-२९-४४", "content_sanskrit": "अन्वयव्यतिरेकाच्च साक्ष्यात्मा व्यभिचारिणः।\nवैतथ्यं व्यभिचारं च निद्रान्तेऽस्यानुचिन्तयेत्॥ ३/२९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_029/BhP_03.029.045.m4a", "display_order": 46}, {"id": 6000059046, "chapter_id": 10059, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे एकोनत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]