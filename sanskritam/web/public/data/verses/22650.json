[{"id": 7002650000, "chapter_id": 22650, "verse_number": "६-२८-१", "content_sanskrit": "सूत उवाच ।\nअथ ते वर्णयिष्यामि कथां साधूपचारिताम् ।\nनृपोपदेशतः साधुः कृतार्थोऽभूद्वणिग्यथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002650001, "chapter_id": 22650, "verse_number": "६-२८-२", "content_sanskrit": "मणिपूरपती राजा चन्द्रचूडो महायशाः ।\nसह प्रजाभिरानर्च सत्यनारायणं प्रभुम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002650002, "chapter_id": 22650, "verse_number": "६-२८-३", "content_sanskrit": "अथ रत्नपुरस्थायी साधुर्लक्षपतिर्वणिक् ।\nधनैरापूर्य तरणीः सह गच्छन्नदीतटे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002650003, "chapter_id": 22650, "verse_number": "६-२८-४", "content_sanskrit": "ददर्श बहुलं लोकं नानाग्रामविलासिनम् ।\nमणिमुक्ताविरचितैर्वितानैस्समलंकृतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002650004, "chapter_id": 22650, "verse_number": "६-२८-५", "content_sanskrit": "वेदवादांश्च शुश्राव गीतवादित्रसंगतान् ।\nरम्यं स्थानं समालोक्य कर्णधारं समादिशत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002650005, "chapter_id": 22650, "verse_number": "६-२८-६", "content_sanskrit": "विश्रामयात्र तरणीरिति पश्यामि कौतुकम् ।\nभर्त्रादिष्टस्तथा चक्रे कर्णधारः सभृत्यकैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002650006, "chapter_id": 22650, "verse_number": "६-२८-७", "content_sanskrit": "तटसीम्नः समुत्तीर्य मल्ललीलाविलासिनः ।\nकर्णधारा नगा वीरा युयुधुर्मल्ललीलया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002650007, "chapter_id": 22650, "verse_number": "६-२८-८", "content_sanskrit": "स्वयमुत्तीर्य सामात्यो लोकान्पप्रच्छ सादरम् ।\nयज्ञस्थानं समालोक्य प्रशस्तं समुदो ययौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002650008, "chapter_id": 22650, "verse_number": "६-२८-९", "content_sanskrit": "किमत्र क्रियते सभ्या भवद्भिर्लोकपूजितैः ।\nसभ्या ऊचुश्च ते सर्वे सत्यनारायणो विभुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002650009, "chapter_id": 22650, "verse_number": "६-२८-१०", "content_sanskrit": "पूज्यते बंधुभिः सार्धं राज्ञा लोकानुकंपिना ।\nप्राप्तं निष्कटकं राज्यं सत्यनारायणार्चनात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002650010, "chapter_id": 22650, "verse_number": "६-२८-११", "content_sanskrit": "धनार्थी लभते द्रव्यं पुत्रार्थी सुतमुत्तमम् ।\nज्ञानार्थी लभते चक्षुर्निर्भयः स्याद्भयातुरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002650011, "chapter_id": 22650, "verse_number": "६-२८-१२", "content_sanskrit": "सर्वान्कामानवाप्नोति नरः सत्यसुरार्च नात् ।\nविधानं तु ततः श्रुत्वा चैलं बद्ध्वा गलेऽसकृत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002650012, "chapter_id": 22650, "verse_number": "६-२८-१३", "content_sanskrit": "दंडवत्प्रणिपत्याह कामं सभ्यानमोदयत् ।\nअनपत्योऽस्मि भगवन्वृथैश्वर्यो वृथोद्यमः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002650013, "chapter_id": 22650, "verse_number": "६-२८-१४", "content_sanskrit": "पुत्रं वा यदि वा कन्यां लभेयं त्वत्प्रसादतः ।\nपताकां कांचनीं कृत्वा पूजयिष्ये कृपानिधिम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002650014, "chapter_id": 22650, "verse_number": "६-२८-१५", "content_sanskrit": "श्रुत्वा सभ्या अब्रुवंस्ते कामनासिद्धिरस्तु ते ।\nहरिं प्रणम्य सभ्याश्च प्रसादं भुक्तवांस्तदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002650015, "chapter_id": 22650, "verse_number": "६-२८-१६", "content_sanskrit": "जगाम स्वालयं साधुर्मनसा चिंतयन्हरिम् ।\nस्वगृहे ह्यागते तस्मिन्नार्यो मंगलपाणयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002650016, "chapter_id": 22650, "verse_number": "६-२८-१७", "content_sanskrit": "मंगलानि विचित्राणि यथोचितमकारयन् ।\nविवेशांतःपुरे साधुर्महाकौतुकमंगलः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002650017, "chapter_id": 22650, "verse_number": "६-२८-१८", "content_sanskrit": "ऋतुस्नाता सती लीलावती पर्यचरत्पतिम् ।\nगर्भं धृतवती साध्वी समये सुषुवे तु सा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002650018, "chapter_id": 22650, "verse_number": "६-२८-१९", "content_sanskrit": "कन्यां कमललोलाक्षीं बांधवामोदकारिणीम् ।\nसाधुः परां मुदं लेभे विततार धनं बहु ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002650019, "chapter_id": 22650, "verse_number": "६-२८-२०", "content_sanskrit": "विप्रानाहूय वेदज्ञान्कारयामास मंगलम् ।\nलेखयित्वा जन्मपत्रीं नाम चक्रे कलावतीम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002650020, "chapter_id": 22650, "verse_number": "६-२८-२१", "content_sanskrit": "कलानिधिकले वासौ ववृधे सा कलावती ।\nअष्टवर्षा भवेद्गौरी नववर्षा च रोहिणी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002650021, "chapter_id": 22650, "verse_number": "६-२८-२२", "content_sanskrit": "दशवर्षा भवेत्कन्या ततः प्रौढा रजस्वला ।\nप्रौढां कालेन तां दृष्ट्वा विवाहार्थमचिन्तयत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002650022, "chapter_id": 22650, "verse_number": "६-२८-२३", "content_sanskrit": "नगरे कांचनपुरे वणिक्छंखपतिः श्रुतः ।\nकुलीनो रूपसंपत्तिशीलौदार्यगुणान्वितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002650023, "chapter_id": 22650, "verse_number": "६-२८-२४", "content_sanskrit": "वरयामास तं साधुर्दुहितुः सदृशं वरम् ।\nशुभे लग्ने बहुविधैर्मंगलैरग्निसन्निधौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002650024, "chapter_id": 22650, "verse_number": "६-२८-२५", "content_sanskrit": "वेदवादित्रनिनदैर्ददौ कन्यां यथाविधि ।\nमणिमुक्ताप्रवालानि वसनं भूषणानि च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002650025, "chapter_id": 22650, "verse_number": "६-२८-२६", "content_sanskrit": "महामोदमनाः साधुर्मंगलार्थं ददौ च ह ।\nप्रेम्णा निवासयामास गृहे जामातरं ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002650026, "chapter_id": 22650, "verse_number": "६-२८-२७", "content_sanskrit": "तं मेने पुत्रवत्साधुः स च तं पितृवत्सुधीः ।\nअतीते भूयसः काले सत्यनारायणार्चनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002650027, "chapter_id": 22650, "verse_number": "६-२८-२८", "content_sanskrit": "विस्मृत्य सह जामात्रा वाणिज्याय ययौ पुनः ।\nसूत उवाच ।\nअथ साधुः समादाय रत्नानि विविधानि च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002650028, "chapter_id": 22650, "verse_number": "६-२८-२९", "content_sanskrit": "नौकाः संस्थाप्य स ययौ देशाद्देशान्तरं प्रति ।\nनगरं नर्मदातीरे तत्र वासं चकार सः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002650029, "chapter_id": 22650, "verse_number": "६-२८-३०", "content_sanskrit": "कुर्वन्क्रयं विक्रयं च चिरं तस्थौ महामनाः ।\nकर्मणा मनसा वाचा न कृतं सत्यसेवनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002650030, "chapter_id": 22650, "verse_number": "६-२८-३१", "content_sanskrit": "ततः कर्मविपाकेन तापमापाचिराद्वणिक् ।\nकस्मिंश्चिद्दिवसे रात्रौ राज्ञो गेहे तमोवृतेः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002650031, "chapter_id": 22650, "verse_number": "६-२८-३२", "content_sanskrit": "ज्ञात्वा निद्रागतान्सर्वान्हृतं चौरैर्महाधनम् ।\nप्रभाते वाचितो राजा सूतमागधबंदिभिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002650032, "chapter_id": 22650, "verse_number": "६-२८-३३", "content_sanskrit": "प्रातःकृत्यं नृपः कृत्वा सदः संप्राविशच्च सः ।\nततस्तत्र समायातः किंकरो राजवल्लभः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002650033, "chapter_id": 22650, "verse_number": "६-२८-३४", "content_sanskrit": "उवाच स तदा वाक्यं शृणुष्व त्वं धरा पते ।\nमुक्तामालाश्च बहुधा रत्नानि विविधानि च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002650034, "chapter_id": 22650, "verse_number": "६-२८-३५", "content_sanskrit": "मुमुषुश्चौरा गतास्सर्वे न जानीमो वयं नृप ।\nइति विज्ञापितो राजा पुण्यश्लोक शिखामणिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002650035, "chapter_id": 22650, "verse_number": "६-२८-३६", "content_sanskrit": "उवाच क्रोधताम्राक्षो यूयं संयात मा चिरम् ।\nसचौरं द्रव्यमादाय मत्पार्श्वं त्वमुपानय ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002650036, "chapter_id": 22650, "verse_number": "६-२८-३७", "content_sanskrit": "नो चेद्धनिष्ये सगणानिति दूतान्समादिशत् ।\nनृपवाक्यं समाकर्ण्य प्रजग्मुस्ते च किंकराः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002650037, "chapter_id": 22650, "verse_number": "६-२८-३८", "content_sanskrit": "बहुयत्नैर्न संशोध्य द्रव्यं चोरसमन्वितम् ।\nएकीभूत्वा निशि तदा महाचिंतातुरोऽभवत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002650038, "chapter_id": 22650, "verse_number": "६-२८-३९", "content_sanskrit": "हन्ता मां सगणं राजा किं करोमि कुतः सुखम् ।\nनृपदंडाच्च मे मृत्युः प्रेतत्वाय भवेदिह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002650039, "chapter_id": 22650, "verse_number": "६-२८-४०", "content_sanskrit": "नर्मदायां च मरणं शिवलोकप्रदायकम् ।\nइत्येवं संमतं कृत्वा नर्मदायास्तटं ययुः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002650040, "chapter_id": 22650, "verse_number": "६-२८-४१", "content_sanskrit": "विदेशिनोऽस्य वणिजो ददर्श विपुलं धनम् ।\nमुक्ताहारं गले तस्य लुंठितं वणिजोऽस्य च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002650041, "chapter_id": 22650, "verse_number": "६-२८-४२", "content_sanskrit": "चौरोऽयमिति निश्चित्य तौ बबंधात्मरक्षणात् ।\nसधनं सह जामात्रा नृपान्तिकमुपानयत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002650042, "chapter_id": 22650, "verse_number": "६-२८-४३", "content_sanskrit": "प्रतिकूले हरौ तस्मिन्राज्ञापि न विचारितम् ।\nधनागारे धनं नीत्वा बध्नीत तौ सुदुर्मती ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002650043, "chapter_id": 22650, "verse_number": "६-२८-४४", "content_sanskrit": "कारागारे लोहमयैः शृंखलैरंगपादयोः ।\nइति राजाज्ञया दूतास्तथा चक्रुर्निबंधनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002650044, "chapter_id": 22650, "verse_number": "६-२८-४५", "content_sanskrit": "जामात्रा सहितः साधुर्विललाप भृशं मुहुः ।\nहा पुत्र तात तातेति जामातः क्व धनं गतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002650045, "chapter_id": 22650, "verse_number": "६-२८-४६", "content_sanskrit": "क्व स्थिता च सुता भार्या पश्य धातुर्विपर्ययम् ।\nनिमग्नौ दुःखजलधौ को वां पास्यति संकटात् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002650046, "chapter_id": 22650, "verse_number": "६-२८-४७", "content_sanskrit": "मया बहुतरं धातुर्विप्रियं हि पुराकृतम् ।\nतत्कर्मणः प्रभावोऽयं न जाने कस्य वा फलम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002650047, "chapter_id": 22650, "verse_number": "६-२८-४८", "content_sanskrit": "समं श्वशुरजामात्रौ द्वादशेषु विषादिनौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]