[{"id": 2069271, "chapter_id": 2450, "verse_number": "१०-२-०x", "content_sanskrit": "कृप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069272, "chapter_id": 2450, "verse_number": "१०-२-१", "content_sanskrit": "श्रुतं ते वचनं सर्वं हेतुयुक्तं मया विभो।\nममापि तु वचः किञ्चिच्छृणुष्वाद्य महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069273, "chapter_id": 2450, "verse_number": "१०-२-२", "content_sanskrit": "आबद्धा मानुषाः सर्वे निबद्धाः कर्मणोर्द्वयोः।\nदैवे पुरुषकारे च परं ताभ्यां न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069274, "chapter_id": 2450, "verse_number": "१०-२-३", "content_sanskrit": "न हि दैवेन सिध्यन्ति कार्याण्येकेन सत्तम।\nन चापि कर्मणैकेन द्वाभ्यां सिद्धिस्तु योगतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069275, "chapter_id": 2450, "verse_number": "१०-२-४", "content_sanskrit": "ताभ्यामुभाभ्यां सर्वार्था निबद्धा अधमोत्तमाः।\nप्रवृत्ताश्चैव दृश्यन्ते निवृत्ताश्चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069276, "chapter_id": 2450, "verse_number": "१०-२-५", "content_sanskrit": "पर्जन्यः पर्वते वर्षन्किन्नु साधयते फलम्।\nकृष्टे क्षेत्रे तथा वर्षन्किं न साधयते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069277, "chapter_id": 2450, "verse_number": "१०-२-६", "content_sanskrit": "उत्थानं चापि दैवस्य ह्यनुत्थानं च दैवतम्।\nव्यर्थं भवति सर्वत्र पूर्वस्तत्र विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069278, "chapter_id": 2450, "verse_number": "१०-२-७", "content_sanskrit": "सुवृष्टे च यथा देवे सम्यक् क्षेत्रे च कर्षिते।\nबीजं महागुणं भूयात्तथा सिद्धिर्हि मानुषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069279, "chapter_id": 2450, "verse_number": "१०-२-८", "content_sanskrit": "तयोर्दैवं तु दुश्चिन्त्यं स्ववशेनैव वर्तते।\nप्राज्ञाः पुरुषकारे तु वर्तन्ते देवमास्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069280, "chapter_id": 2450, "verse_number": "१०-२-९", "content_sanskrit": "ताभ्यां सर्वे हि कार्यार्था मनुष्याणां नरर्षभ।\nविचेष्टन्तः स्म दृश्यन्ते निवृत्तास्तु तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069281, "chapter_id": 2450, "verse_number": "१०-२-१०", "content_sanskrit": "कृतः पुरुषकारश्च सोऽपि दैवेन सिध्यति।\nतथास्य कर्मणः कर्तुरभिनिर्वर्तते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069282, "chapter_id": 2450, "verse_number": "१०-२-११", "content_sanskrit": "उत्थानं च मनुष्याणां दक्षाणां दैववर्जितम्।\nअभलं दृश्यते लोके सम्यगप्युपपादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069283, "chapter_id": 2450, "verse_number": "१०-२-१२", "content_sanskrit": "तत्रालसा मनुष्याणां ये भवन्त्यमनस्विनः।\nउत्थानं ते विगर्हन्ति प्राज्ञानां तन्न रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069284, "chapter_id": 2450, "verse_number": "१०-२-१३", "content_sanskrit": "प्रायशो हि कृतं कर्म नाफलं दृश्यते भुवि।\nअकृत्वा च पुनर्दुःखं कर्म पश्येन्महाफलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069285, "chapter_id": 2450, "verse_number": "१०-२-१४", "content_sanskrit": "चष्टामकुर्वंल्लभते यदि किञ्चिद्यदृच्छया।\nयो वा न लभते कृत्वा दुर्दर्शौ तावुभावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069286, "chapter_id": 2450, "verse_number": "१०-२-१५", "content_sanskrit": "शक्नोति जीवितुं दक्षो नालसः सुखमेधते।\nदृश्यन्ते जीवलोकेऽस्मिन्दक्षाः प्रायो हितैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069287, "chapter_id": 2450, "verse_number": "१०-२-१६", "content_sanskrit": "यदि दक्षः समारम्भात्कर्मणो नाश्नुते फलम्।\nनास्य वाच्यं भवेत्किञ्चिल्लब्धव्यं वाऽधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069288, "chapter_id": 2450, "verse_number": "१०-२-१७", "content_sanskrit": "नाकृत्वा कर्म लोके हि फलं विन्दति कर्हिचित्।\nस तु वक्तव्यतां याति द्वेष्यो भवति भूयशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069289, "chapter_id": 2450, "verse_number": "१०-२-१८", "content_sanskrit": "एवमेतदनादृत्य वर्तते यस्त्वतोऽन्यथा।\nस करोत्यात्मनोऽनर्थानेष बुद्धिमतां नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069290, "chapter_id": 2450, "verse_number": "१०-२-१९", "content_sanskrit": "हीनं पुरुषकारेण यदि दैवेन वा पुनः।\nकारणाभ्यामथैताभ्यामुत्थानमफलं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069291, "chapter_id": 2450, "verse_number": "१०-२-२०", "content_sanskrit": "हीनं पुरुषकारेण कर्म त्विह न सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069292, "chapter_id": 2450, "verse_number": "१०-२-२१", "content_sanskrit": "दैवतेभ्यो नमस्कृत्य यस्त्वर्थान्सम्यगीहते।\nदक्षो दाक्षिण्यसम्पन्नो न स मोघैर्विहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069293, "chapter_id": 2450, "verse_number": "१०-२-२२", "content_sanskrit": "सम्यगीहा पुनरियं या बृद्धानुपसेवते।\nआपृच्छति च यच्छ्रेयः करोति च हितं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069294, "chapter_id": 2450, "verse_number": "१०-२-२३", "content_sanskrit": "उत्थायोत्थाय हि सदा प्रष्टव्या वृद्धसम्मताः।\nते स्म योगे परं मूलं तन्मूला सिद्धिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069295, "chapter_id": 2450, "verse_number": "१०-२-२४", "content_sanskrit": "वृद्धानां वचनं श्रुत्वा योऽभ्युत्थानं प्रयोजयेत्।\nउत्थानस्य फलं सम्यक्तदा स लभतेऽचिरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069296, "chapter_id": 2450, "verse_number": "१०-२-२५", "content_sanskrit": "रागात्क्रोधाद्भयाल्लोभाद्योऽर्थानीहेत मानवः।\nअनीशश्चावमानी च स शीघ्रं भ्रश्यते श्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069297, "chapter_id": 2450, "verse_number": "१०-२-२६", "content_sanskrit": "सोयं दुर्योधनेनार्थो लुब्धेनादीर्घदर्शिना।\nअसमर्थः समारब्धो मूढत्वादविचिनन्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069298, "chapter_id": 2450, "verse_number": "१०-२-२७", "content_sanskrit": "हितबुद्धीननादृत्य सम्मन्त्र्यासाधुभिः सह।\nवार्यमाणोऽकरोद्वैरं पाण्डवैर्गुणवत्तरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069299, "chapter_id": 2450, "verse_number": "१०-२-२८", "content_sanskrit": "पूर्वमप्यतिदुःशीलो न धैर्यं कर्तुमर्हति।\nतपत्यर्थे विपन्ने हि मित्राणां न कृतं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069300, "chapter_id": 2450, "verse_number": "१०-२-२९", "content_sanskrit": "अनुवर्तामहे यत्तु तं वयं पापपूरुषम्।\nअस्मानप्यनयस्तस्मात्प्राप्तोऽयं दारुणो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069301, "chapter_id": 2450, "verse_number": "१०-२-३०", "content_sanskrit": "अेन तु ममाद्यापि व्यसनेनोपतापिता।\nबुद्धिश्चिन्तयते किञ्चित्स्वं श्रेयो नावबुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069302, "chapter_id": 2450, "verse_number": "१०-२-३१", "content_sanskrit": "मुह्यता तु मनुष्येण प्रष्टव्याः सुहृदो जनाः।\nतत्रास्य बुद्धिर्विनयस्तत्र श्रेयश्च पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069303, "chapter_id": 2450, "verse_number": "१०-२-३२", "content_sanskrit": "ततोऽस्य मूलं कार्याणां बुद्ध्या निश्चित्य वै बुधाः।\nतेऽत्र पृष्टा यथा ब्रूयुस्तत्कर्तव्यं तथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069304, "chapter_id": 2450, "verse_number": "१०-२-३३", "content_sanskrit": "ते वयं धृतराष्ट्रं च गान्धारीं च यशस्विनीम्।\nउपपृच्छामहे गत्वा विदुरं च महामतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069305, "chapter_id": 2450, "verse_number": "१०-२-३४", "content_sanskrit": "ते पृष्टास्तु वदेयुर्यच्छ्रेयो नः समनन्तरम्।\nतदस्माभिः पुनः कार्यमिति मे नैष्ठिकी मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069306, "chapter_id": 2450, "verse_number": "१०-२-३५", "content_sanskrit": "अनारम्भात्तु कार्याणां नार्थः सम्पद्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069307, "chapter_id": 2450, "verse_number": "१०-२-३६", "content_sanskrit": "कृते पुरुषकारे तु येषां कार्यं न सिध्यति।\nदैवेनोपहतास्ते तु नात्र कार्या विचारणा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069308, "chapter_id": 2450, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि द्वितीयोऽध्यायः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]