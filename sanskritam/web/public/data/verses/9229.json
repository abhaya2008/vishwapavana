[{"id": 5000229000, "chapter_id": 9229, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000229001, "chapter_id": 9229, "verse_number": "३-३३-१", "content_sanskrit": "ततः शूर्पणखा दीना रावणं लोकरावणम्।\nअमात्यमध्ये संक्रुद्धा परुषं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000229002, "chapter_id": 9229, "verse_number": "३-३३-२", "content_sanskrit": "प्रमत्तः कामभोगेषु स्वैरवृत्तो निरङ्कुशः।\nसमुत्पन्नं भयं घोरं बोद्धव्यं नावबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000229003, "chapter_id": 9229, "verse_number": "३-३३-३", "content_sanskrit": "सक्तं ग्राम्येषु भोगेषु कामवृत्तं महीपतिम्।\nलुब्धं न बहु मन्यन्ते श्मशानाग्निमिव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000229004, "chapter_id": 9229, "verse_number": "३-३३-४", "content_sanskrit": "स्वयं कार्याणि यः काले नानुतिष्ठति पार्थिवः।\nस तु वै सह राज्येन तैश्च कार्यैर्विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000229005, "chapter_id": 9229, "verse_number": "३-३३-५", "content_sanskrit": "अयुक्तचारं दुर्दर्शमस्वाधीनं नराधिपम्।\nवर्जयन्ति नरा दूरान्नदीपङ्कमिव द्विपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000229006, "chapter_id": 9229, "verse_number": "३-३३-६", "content_sanskrit": "ये न रक्षन्ति विषयमस्वाधीनं नराधिपाः।\nते न वृद्ध्या प्रकाशन्ते गिरयः सागरे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000229007, "chapter_id": 9229, "verse_number": "३-३३-७", "content_sanskrit": "आत्मवद्भिर्विगृह्य त्वं देवगन्धर्वदानवैः।\nअयुक्तचारश्चपलः कथं राजा भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000229008, "chapter_id": 9229, "verse_number": "३-३३-८", "content_sanskrit": "त्वं तु बालस्वभावश्च बुद्धिहीनश्च राक्षस।\nज्ञातव्यं तन्न जानीषे कथं राजा भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000229009, "chapter_id": 9229, "verse_number": "३-३३-९", "content_sanskrit": "येषां चाराश्च कोशश्च नयश्च जयतां वर।\nअस्वाधीना नरेन्द्राणां प्राकृतैस्ते जनैः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000229010, "chapter_id": 9229, "verse_number": "३-३३-१०", "content_sanskrit": "यस्मात् पश्यन्ति दूरस्थान् सर्वानर्थान् नराधिपाः।\nचारेण तस्मादुच्यन्ते राजानो दीर्घचक्षुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000229011, "chapter_id": 9229, "verse_number": "३-३३-११", "content_sanskrit": "अयुक्तचारं मन्ये त्वां प्राकृतैः सचिवैर्युतः।\nस्वजनं च जनस्थानं निहतं नावबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000229012, "chapter_id": 9229, "verse_number": "३-३३-१२", "content_sanskrit": "चतुर्दश सहस्राणि रक्षसां भीमकर्मणाम्।\nहतान्येकेन रामेण खरश्च सहदूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000229013, "chapter_id": 9229, "verse_number": "३-३३-१३", "content_sanskrit": "ऋषीणामभयं दत्तं कृतक्षेमाश्च दण्डकाः।\nधर्षितं च जनस्थानं रामेणाक्लिष्टकारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000229014, "chapter_id": 9229, "verse_number": "३-३३-१४", "content_sanskrit": "त्वं तु लुब्धः प्रमत्तश्च पराधीनश्च राक्षस।\nविषये स्वे समुत्पन्नं यद् भयं नावबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000229015, "chapter_id": 9229, "verse_number": "३-३३-१५", "content_sanskrit": "तीक्ष्णमल्पप्रदातारं प्रमत्तं गर्वितं शठम्।\nव्यसने सर्वभूतानि नाभिधावन्ति पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000229016, "chapter_id": 9229, "verse_number": "३-३३-१६", "content_sanskrit": "अतिमानिनमग्राह्यमात्मसम्भावितं नरम्।\nक्रोधनं व्यसने हन्ति स्वजनोऽपि नराधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000229017, "chapter_id": 9229, "verse_number": "३-३३-१७", "content_sanskrit": "नानुतिष्ठति कार्याणि भयेषु न बिभेति च।\nक्षिप्रं राज्याच्च्युतो दीनस्तृणैस्तुल्यो भवेदिह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000229018, "chapter_id": 9229, "verse_number": "३-३३-१८", "content_sanskrit": "शुष्ककाष्ठैर्भवेत् कार्यं लोष्ठैरपि च पांसुभिः।\nन तु स्थानात् परिभ्रष्टैः कार्यं स्याद् वसुधाधिपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000229019, "chapter_id": 9229, "verse_number": "३-३३-१९", "content_sanskrit": "उपभुक्तं यथा वासः स्रजो वा मृदिता यथा।\nएवं राज्यात् परिभ्रष्टः समर्थोऽपि निरर्थकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000229020, "chapter_id": 9229, "verse_number": "३-३३-२०", "content_sanskrit": "अप्रमत्तश्च यो राजा सर्वज्ञो विजितेन्द्रियः।\nकृतज्ञो धर्मशीलश्च स राजा तिष्ठते चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000229021, "chapter_id": 9229, "verse_number": "३-३३-२१", "content_sanskrit": "नयनाभ्यां प्रसुप्तो वा जागर्ति नयचक्षुषा।\nव्यक्तक्रोधप्रसादश्च स राजा पूज्यते जनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000229022, "chapter_id": 9229, "verse_number": "३-३३-२२", "content_sanskrit": "त्वं तु रावण दुर्बुद्धिर्गुणैरेतैर्विवर्जितः।\nयस्य तेऽविदितश्चारै रक्षसां सुमहान् वधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000229023, "chapter_id": 9229, "verse_number": "३-३३-२३", "content_sanskrit": "परावमन्ता विषयेषु सङ्गवान्\nन देशकालप्रविभागतत्त्ववित्।\nअयुक्तबुद्धिर्गुणदोषनिश्चये\nविपन्नराज्यो न चिराद् विपत्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000229024, "chapter_id": 9229, "verse_number": "३-३३-२४", "content_sanskrit": "इति स्वदोषान् परिकीर्तितांस्तथा\nसमीक्ष्य बुद्ध्या क्षणदाचरेश्वरः।\nधनेन दर्पेण बलेन चान्वितो\nविचिन्तयामास चिरं स रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000229025, "chapter_id": 9229, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे त्रयस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]