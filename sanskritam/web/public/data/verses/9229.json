"chapter_id": 9229, "verse_number": "81", "content_sanskrit": "देवदानवयक्षाणांगन्धर्वोरगरक्षसाम् । शत्रुमद्योद्धरिष्यामित्वामृषीणांचकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 40015643, "chapter_id": 9229, "verse_number": "82", "content_sanskrit": "विभीषणस्यचैश्वर्यंभविष्यतिहतेत्वयि । नचेत्सत्कृत्यवैदेहींप्रणिपत्यप्रदास्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 40015644, "chapter_id": 9229, "verse_number": "83", "content_sanskrit": "इत्येवंपरुषंवाक्यंब्रुवाणेहरिपुङ्गवे । अमर्षवशमापन्नोनिशाचरगणेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 40015645, "chapter_id": 9229, "verse_number": "84", "content_sanskrit": "ततस्सरोषताम्राक्षश्शशापसचिवांन्नोस्तदा । गृह्यतामेषदुर्मेधावध्यतामितिचासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 40015646, "chapter_id": 9229, "verse_number": "85", "content_sanskrit": "रावणस्यवच्शुत्वादीप्ताग्निसमतेजसा । जगृहुस्तंततोघोराश्चत्वारोरजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 40015647, "chapter_id": 9229, "verse_number": "86", "content_sanskrit": "ग्राहयामासतारेयस्स्वयमात्मनमात्मवान् । बलंदर्शयितुंवीरोयातुधानगणेतदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 40015648, "chapter_id": 9229, "verse_number": "87", "content_sanskrit": "सतान्बाहुद्वयासक्तानादायपतगानिव । प्रासादंशैलसङ्कामुत्पपाताङ्गदस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 40015649, "chapter_id": 9229, "verse_number": "88", "content_sanskrit": "तेन्तरिक्षाद्विनिर्धूतास्तस्यवेगेनराक्षसाः । भूमौनिपतिताःसर्वेराक्षसेन्द्रस्यपश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 40015650, "chapter_id": 9229, "verse_number": "89", "content_sanskrit": "ततःप्रासादशिखरंशैलशृङ्गमिवोन्नतम् । ददर्शराक्षसेन्द्रस्यवालिपुत्रःप्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 40015651, "chapter_id": 9229, "verse_number": "90", "content_sanskrit": "तत्पफालपदाक्रान्तंदशग्रीवस्यपश्यतः । पुराहिमवतश्शृङ्गंवज्रिणेवविदारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 40015652, "chapter_id": 9229, "verse_number": "91", "content_sanskrit": "भङ् क्त्वाप्रासादशिखरंनामविश्राव्यचात्मनः । विनद्यसुमहानादमुत्पपातविहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 40015653, "chapter_id": 9229, "verse_number": "92", "content_sanskrit": "व्यथयन्राक्षसान्सर्वान्हर्षयंश्चापिवानरान् । सवानराणांमध्येतुरामपार्श्वमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 40015654, "chapter_id": 9229, "verse_number": "93", "content_sanskrit": "रावणस्तुपरंचक्रेक्रोधंप्रासादधर्षणात् । विनाशंचात्मनःपश्यन्निश्श्वासपरमोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 40015655, "chapter_id": 9229, "verse_number": "94", "content_sanskrit": "रामस्तुबहुभिर्हृष्टर्निनदद्भिःप्लवङ्गमैः । वृतोरिपुवधाकाङ्क्षीयुद्धायैवाभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 40015656, "chapter_id": 9229, "verse_number": "95", "content_sanskrit": "सुषेणस्तुमहावीर्योगिरिकूटोपमोहरिः । बहुभिःसम्वृतस्तत्रवानरैःकामरूपिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 40015657, "chapter_id": 9229, "verse_number": "96", "content_sanskrit": "सचतुर्द्वाराणिसर्वाणिसुग्रीववचनात्कपिः । पर्यक्रामतदुर्धर्षोनक्षत्राणीवचन्द्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 40015658, "chapter_id": 9229, "verse_number": "97", "content_sanskrit": "तेषामक्षौहिणिशतंसमवेक्ष्यवनौकसाम् । लङ्कामुपनिविष्टानांसागरंचानिवर्तताम् ॥ राक्षसाविस्मयंजग्मुस्त्रासंजग्मुस्तथापरे । अपरेसमरोध्धर्षाद्धर्षमेवप्रपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 40015659, "chapter_id": 9229, "verse_number": "98", "content_sanskrit": "तेषामक्षौहिणिशतंसमवेक्ष्यवनौकसाम् । लङ्कामुपनिविष्टानांसागरंचानिवर्तताम् ॥ राक्षसाविस्मयंजग्मुस्त्रासंजग्मुस्तथापरे । अपरेसमरोध्धर्षाद्धर्षमेवप्रपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 40015660, "chapter_id": 9229, "verse_number": "99", "content_sanskrit": "कृत्स्नंहिकपिभिर्व्याप्तंप्राकारपरिखान्तरम् । ददृशूराक्षसादीनाःप्राकारंनानरीकृतम् ॥ हाहाकारंप्रकुर्वन्तिराक्षसाभयमोहिताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]