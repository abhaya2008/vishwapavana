[{"id": 2023064, "chapter_id": 1492, "verse_number": "३-१३०-०x", "content_sanskrit": "`वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023065, "chapter_id": 1492, "verse_number": "३-१३०-१", "content_sanskrit": "सोमकस्याश्रमे पुण्ये धर्मराजो युधिष्ठिरः।\nषड्रात्रमुष्य नियतो भ्रात्रादिभिररिंदमः।\nतस्मान्निर्गम्य सहसा दिशं प्रायात्तथोत्तराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023066, "chapter_id": 1492, "verse_number": "३-१३०-२", "content_sanskrit": "बहुदूरं ततो गत्वा वनं तत्र मनोहरम्।\nबहुपष्पफलाकीर्णं महानद्युपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023067, "chapter_id": 1492, "verse_number": "३-१३०-३", "content_sanskrit": "दृष्ट्वा पप्रच्छ राजाऽसौ लोमशं मुनिसत्तमम्।\nकिमिदं दृश्यते रम्यं वनं बहुमृगद्विजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023068, "chapter_id": 1492, "verse_number": "३-१३०-४", "content_sanskrit": "बहुपुष्पफलोपेतं मुनिसङ्घैर्निषेवितम्।\nस्रवन्त्या च समायुक्तं महत्या पुण्यतोयया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023069, "chapter_id": 1492, "verse_number": "३-१३०-५", "content_sanskrit": "ऋषीणामाश्रमाः पुण्या दृश्यन्ते विविधा मुने।\nकस्यायमाश्रमः पुण्यः कस्येमे मुनयोऽमलाः।\nएतदिच्छाम्यहं श्रोतुं वद त्वं वदतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023070, "chapter_id": 1492, "verse_number": "३-१३०-६x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023071, "chapter_id": 1492, "verse_number": "३-१३०-६", "content_sanskrit": "शृणु राजेनद्र भद्रं ते वनस्यास्य पुरातनम्।\nवृत्तान्तं निखिलेनाद्य प्रोच्यमानं मयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023072, "chapter_id": 1492, "verse_number": "३-१३०-७", "content_sanskrit": "मृकण्डुपुत्रो मेधावी मार्कण्डेयो महामुनिः।\nबाल एव महाबुद्धिः सर्वविद्याविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023073, "chapter_id": 1492, "verse_number": "३-१३०-८", "content_sanskrit": "मातापित्रोः प्रियं कुर्वंस्तपोर्थं वनमाविशत्।\nअत्राश्रमपदं कृत्वा तपस्तेपे सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023074, "chapter_id": 1492, "verse_number": "३-१३०-९", "content_sanskrit": "ग्रीष्मे पञ्चतपा भूत्वा वर्षास्वाकाशसंश्रयः।\nजलस्थः शिशिरे योगी बहुकालमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023075, "chapter_id": 1492, "verse_number": "३-१३०-१०", "content_sanskrit": "ऊर्ध्वबाहुर्निरालम्बः पादाङ्गुष्ठाग्रविष्ठितः।\nजितेन्द्रियो जितप्राणश्चिन्तयन्दृढमव्ययम्।\nअनाहारो जितक्रोधश्चिरमेवमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023076, "chapter_id": 1492, "verse_number": "३-१३०-११", "content_sanskrit": "एतस्मिन्नन्तरे राजन्ननावृष्टिः सुदारुणा।\nसंभूता सर्वसंहर्त्री तया दग्धं चराचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023077, "chapter_id": 1492, "verse_number": "३-१३०-१२", "content_sanskrit": "अनावृष्ट्यां प्रवृत्तायां सर्वे च निधनं गताः।\nकेचिदन्ये महात्मानो मुनयो द्विजपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023078, "chapter_id": 1492, "verse_number": "३-१३०-१३", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शूद्रा सर्वाश्च योषितः।\nपशुपक्षिमृगाः सर्वे क्षुत्पिपासासमाकुलाः।\nकृशाः शुष्कोष्ठकण्ठाश्च श्रान्ता भ्रान्ता विचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023079, "chapter_id": 1492, "verse_number": "३-१३०-१४", "content_sanskrit": "केनचित्पुण्यशेषेण मार्कण्डेयस्य धीमतः।\nआश्रमं शनकैः प्राप्ता मूर्च्छिताः सहसाऽपतन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023080, "chapter_id": 1492, "verse_number": "३-१३०-१५", "content_sanskrit": "समाधिविरतो योगी मार्कण्डेयो महातपाः।\nतद्वनं निबिडं दृष्ट्वा जनैः क्षुत्तृट्समाकलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023081, "chapter_id": 1492, "verse_number": "३-१३०-१६", "content_sanskrit": "दयार्द्रहृदयो योगी शिवं ध्यात्वा हृदम्बुजे।\nतेषां संरक्षणार्थाय वेदगन्धिस्वरेण सः।\nआजुहाव तदा गङ्गां तपोयोगेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023082, "chapter_id": 1492, "verse_number": "३-१३०-१७", "content_sanskrit": "गङ्गा समागता शीघ्रं तेनाहूताऽतिपावना।\nनाम्ना वेदनदीत्येव प्रख्याता लोकपावना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023083, "chapter_id": 1492, "verse_number": "३-१३०-१८", "content_sanskrit": "पर्जन्यश्च समाहूतः सुखं वर्षति भारत।\nसस्यानि च समृद्धानि फलमूलान्यनेकशः।\nसंभूतान्यत्रराजेनद्र सर्वे ते रक्षिता जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023084, "chapter_id": 1492, "verse_number": "३-१३०-१९", "content_sanskrit": "मार्कण्डेयं प्रशंसन्तो जनाः सर्वे द्विजात्तयः।\nचिरं सुखमवर्तन्त तेन संरक्षिता नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023085, "chapter_id": 1492, "verse_number": "३-१३०-२०", "content_sanskrit": "एवं विधाय रक्षां स सर्वेषां पुण्यकर्मणाम्।\nपुनश्चचार च तपः परमेश्वरतुष्टये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023086, "chapter_id": 1492, "verse_number": "३-१३०-२१", "content_sanskrit": "एवं बहुतिथे काले प्रादुरासीन्महेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023087, "chapter_id": 1492, "verse_number": "३-१३०-२२", "content_sanskrit": "दृष्ट्वा च सर्वदेवेशं चन्द्रमौलिमुमापतिम्।\nब्रह्मविष्ण्वादिभिर्देवैः सिद्धविद्याधरोरगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023088, "chapter_id": 1492, "verse_number": "३-१३०-२३", "content_sanskrit": "गन्धर्वयक्षप्रवरैः सकिन्नरपतत्रिभिः।\nस्तूयमानं महादेवमव्ययं निष्कलं शिवम्।\nप्रणनाम मुनिर्भक्त्या साष्टाङ्गं च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023089, "chapter_id": 1492, "verse_number": "३-१३०-२४", "content_sanskrit": "प्रणम्योत्थाय सहसा बद्धाञ्जलिपुटो मुनिः।\nतुष्टाव विविधैः स्तोत्रैर्महादेवं जगत्पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023090, "chapter_id": 1492, "verse_number": "३-१३०-२५", "content_sanskrit": "तमुवाच महादेवो मार्कण्डेयं महामुनिम्।\nवरं वरय भद्रं ते वरदोस्मि मुने तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023091, "chapter_id": 1492, "verse_number": "३-१३०-२६", "content_sanskrit": "एवं संबोधितस्तेन शिवेन परमात्मना।\nसगद्गदमिदं वाक्यमुवाच परमेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023092, "chapter_id": 1492, "verse_number": "३-१३०-२७", "content_sanskrit": "नान्यं वरं वृणे शंभो ---त्वत्पादपङ्कजे।\nभक्तिंह्यनन्यसुलभां स्व व्यभिचारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023093, "chapter_id": 1492, "verse_number": "३-१३०-२८", "content_sanskrit": "एवमुक्तोऽथ मुनिना भरतगीश्वरेश्वरः।\nपुनरेवाब्रवीद्वाक्यं मार्कण्डेय महामुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023094, "chapter_id": 1492, "verse_number": "३-१३०-२९", "content_sanskrit": "सम्यगाराधितः पित्रा तव पुत्रार्थमादरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023095, "chapter_id": 1492, "verse_number": "३-१३०-३०", "content_sanskrit": "शतायुर्निर्गुणः पुत्रः शुभः षोडशवार्षिकः।\nउभयोरन्यमिच्छ त्वमित्युक्तः सोऽब्रवीच्च माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023096, "chapter_id": 1492, "verse_number": "३-१३०-३१", "content_sanskrit": "निर्गुणो मास्तु देवेश शतायुः षोडशाब्दकः।\nसुगुणोऽस्तु सुतो मेऽद्य इति पित्रावृत पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023097, "chapter_id": 1492, "verse_number": "३-१३०-३२", "content_sanskrit": "त्वया तप्तेन तपसा तोषितोऽहं भृशं मुने।\nदीर्घमायुर्मया दत्तं मृत्युश्च प्रतिषेधितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023098, "chapter_id": 1492, "verse_number": "३-१३०-३३", "content_sanskrit": "इत्युक्त्वा भगवानीशस्तत्रैवान्तरधीयत।\nतस्यायमाश्रमः पुण्यस्तस्येमे मुनयोऽमलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023099, "chapter_id": 1492, "verse_number": "३-१३०-३४", "content_sanskrit": "अत्रैकरात्रमुषिताः सर्वे मृत्युं तरन्ति वै।\nअत्रैव भरतश्रेष्ठ प्रयतो वस भूमिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2023100, "chapter_id": 1492, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि त्रिंशदधिकशततमोऽध्यायः ॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]