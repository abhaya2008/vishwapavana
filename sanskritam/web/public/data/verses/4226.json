[{"id": 2149024, "chapter_id": 4226, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149025, "chapter_id": 4226, "verse_number": "१", "content_sanskrit": "तथा व्यूढेष्वनीकेषु युद्धाय ब्राह्मणर्षभ ।\nकिमकुर्वन्त कौरव्याः कालेनाभिप्रचोदिताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149026, "chapter_id": 4226, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149027, "chapter_id": 4226, "verse_number": "२", "content_sanskrit": "तथा व्यूढेष्वनीकेषु यत्तेषु भरतर्षभ ।\nधृतराष्ट्रो महाराज सञ्जयं वाक्यमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149028, "chapter_id": 4226, "verse_number": "३", "content_sanskrit": "एहि सञ्जय सर्वं मे आचक्ष्वानवशेषतः ।\nसेनानिवेशे यद् वृत्तं कुरुपाण्डवसेनयोः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149029, "chapter_id": 4226, "verse_number": "४", "content_sanskrit": "दिष्टमेव परं मन्ये पौरुषं चाप्यनर्थकम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149030, "chapter_id": 4226, "verse_number": "५", "content_sanskrit": "यदहं जानमानोऽपि युद्धदोषान् क्षयोदयान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149031, "chapter_id": 4226, "verse_number": "६", "content_sanskrit": "तथाऽपि निकृतिप्रज्ञं पुत्रं दुर्द्यूतदेविनम् ।\nन शक्नोमि नियन्तुं वा कर्तुं वा हितमात्मनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149032, "chapter_id": 4226, "verse_number": "७", "content_sanskrit": "भवत्येव हि मे सूत बुद्धिर्दोषानुदर्शिनी ।\nदुर्योधनं समासाद्य पुनः सा परिवर्तते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149033, "chapter_id": 4226, "verse_number": "८", "content_sanskrit": "एवं गते वै यद् भावि तद् भविष्यति सञ्जय ।\nक्षत्रधर्मः किल रणे तनुत्यागो हि पूजितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149034, "chapter_id": 4226, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149035, "chapter_id": 4226, "verse_number": "९", "content_sanskrit": "त्वद्युक्तोऽयमनुप्रश्नो महाराज यथेच्छसि ।\nन तु दुर्योधने दोषमिममासक्तुमर्हसि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149036, "chapter_id": 4226, "verse_number": "१०", "content_sanskrit": "शृणुष्वानवशेषेण वदतः पार्थिवर्षभ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149037, "chapter_id": 4226, "verse_number": "११", "content_sanskrit": "य आत्मनो दुश्चरितादशुभं प्राप्नुयान्नरः ।\nएनसा न स दैवं वा कालं वा गन्तुमर्हति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149038, "chapter_id": 4226, "verse_number": "१२", "content_sanskrit": "महाराज मनुष्येषु निन्द्यं यः सर्वमाचरेत् ।\nस वध्यः सर्वलोकस्य निन्दितानि समाचरन्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149039, "chapter_id": 4226, "verse_number": "१३", "content_sanskrit": "न्यक्कारा मनुजश्रेष्ठ पाण्डवैस्त्वत्प्रतीक्षया ।\nअनुभूता महाराज निकृतैः सहदैवतैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149040, "chapter_id": 4226, "verse_number": "१४", "content_sanskrit": "हयानां च गजानां च राज्ञां चामिततेजसाम् ।\nवैशसं समरे वृत्तं यत्तन्मे शृणु सर्वशः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149041, "chapter_id": 4226, "verse_number": "१५", "content_sanskrit": "स्थिरो भूत्वा महाप्राज्ञ सर्वलोकक्षयोदयम् ।\nयथाभूतं महायुद्धे श्रुत्वा मा विमना भव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149042, "chapter_id": 4226, "verse_number": "१६", "content_sanskrit": "न ह्येव कर्ता पुरुषः कर्मणोः शुभपापयोः ।\nअस्वतन्त्रो हि पुरुषः कार्यते दारुयन्त्रवत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149043, "chapter_id": 4226, "verse_number": "१७", "content_sanskrit": "केचिदीश्वरनिर्दिष्टाः केचिदेव यदृच्छया ।\nपूर्वकर्मभिरप्यन्ये त्रैधमेतद्धि भाष्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149044, "chapter_id": 4226, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तपञ्चाशोत्तरशततमोऽध्यायः ॥१५७॥\nभीष्माभिषेचनपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149045, "chapter_id": 4226, "verse_number": "", "content_sanskrit": "॥ समाप्तं भीष्माभिषेचनपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]