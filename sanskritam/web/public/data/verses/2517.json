[{"id": 2071843, "chapter_id": 2517, "verse_number": "१२-२२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071844, "chapter_id": 2517, "verse_number": "१२-२२-१", "content_sanskrit": "अस्मिन्नेवान्तरे वाक्यं पुनरेवार्जुनोऽब्रवीत्।\nनिर्विण्णमनसं ज्येष्ठमिदं भ्रातरमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071845, "chapter_id": 2517, "verse_number": "१२-२२-२", "content_sanskrit": "क्षत्रधर्मेण धर्मज्ञ प्राप्य राज्यं सुदुर्लभम्।\nजित्वा चारीन्नरश्रेष्ठ तप्यते किं भृशं भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071846, "chapter_id": 2517, "verse_number": "१२-२२-३", "content_sanskrit": "क्षत्रियाणां महाराज संग्रामे निधनं मतम्।\nविशिष्टं बहुभिर्यज्ञैः क्षत्रधर्ममनुस्मर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071847, "chapter_id": 2517, "verse_number": "१२-२२-४", "content_sanskrit": "ब्राह्मणानां तपस्त्यागः प्रेत्य धर्मविधिः स्मृतः।\nक्षत्रियाणां च निधनं संग्रामे विहितं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071848, "chapter_id": 2517, "verse_number": "१२-२२-५", "content_sanskrit": "क्षात्रधर्मो महारौद्रः शस्त्रनित्य इति स्मृतः।\nवधश्च भरतश्रेष्ठ काले शस्त्रेण संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071849, "chapter_id": 2517, "verse_number": "१२-२२-६", "content_sanskrit": "ब्राह्मणस्यापि चेद्राजन्क्षत्रधर्मेण वर्ततः।\nप्रशस्तं जीवितं लोके क्षत्रं हि ब्रह्मसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071850, "chapter_id": 2517, "verse_number": "१२-२२-७", "content_sanskrit": "न त्यागो न पुनर्यज्ञो न तपो मनुजेश्वर।\nक्षत्रियस्य विधीयन्ते न परस्वोपजीवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071851, "chapter_id": 2517, "verse_number": "१२-२२-८", "content_sanskrit": "स भवान्सर्वधर्मज्ञो धर्मात्मा भरतर्षभ।\nराजा मनीषी निपुणो लोके दृष्टपरावरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071852, "chapter_id": 2517, "verse_number": "१२-२२-९", "content_sanskrit": "त्यक्त्वा संतापजं शोकं दंशितो भव कर्मणि।\nक्षत्रियस्य विशेषेण हृदयं वज्रसन्निभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071853, "chapter_id": 2517, "verse_number": "१२-२२-१०", "content_sanskrit": "जित्वाऽरीन्क्षत्रधर्मेण प्राप्य राज्यमकण्टकम्।\nविजितात्मा मनुष्येन्द्र यज्ञदानपरो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071854, "chapter_id": 2517, "verse_number": "१२-२२-११", "content_sanskrit": "इन्द्रो वै ब्रह्मणः पुत्रः क्षत्रियः कर्मणाऽभवत्।\nज्ञातीनां पापवृत्तीनां जघान नवतीर्नव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071855, "chapter_id": 2517, "verse_number": "१२-२२-१२", "content_sanskrit": "तच्चास्य कर्म पूज्यं च प्रशस्यं च विशांपते।\nतेनेन्द्रत्वं समापेदे देवानामिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071856, "chapter_id": 2517, "verse_number": "१२-२२-१३", "content_sanskrit": "स त्वं यज्ञैर्महाराज यजस्व बहुदक्षिणैः।\nयथैवेन्द्रो मनुष्येन्द्र चिराय विगतज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071857, "chapter_id": 2517, "verse_number": "१२-२२-१४", "content_sanskrit": "मा त्वमेवं गते किंचिच्छोचेथाः क्षत्रियर्षभ।\nगतास्ते क्षत्रधर्मेण शस्त्रपूताः परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071858, "chapter_id": 2517, "verse_number": "१२-२२-१५", "content_sanskrit": "भवितव्यं तथा तच्च यद्वृत्तं भरतर्षभ।\nदिष्टं हि राजशार्दूल न शक्यमतिवर्तितुम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071859, "chapter_id": 2517, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्वाविंशोऽध्यायः॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]