[{"id": 2208048, "chapter_id": 5441, "verse_number": "", "content_sanskrit": "ब्राह्मणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208049, "chapter_id": 5441, "verse_number": "१", "content_sanskrit": "नेदमल्पात्मना शक्यं वेदितुं नाकृतात्मना ।\nबहु चाल्पं च सङ्क्षिप्तं विस्मितं च मनो मम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208050, "chapter_id": 5441, "verse_number": "२", "content_sanskrit": "उपायं तु मम ब्रूहि येनैषा लभ्यते मतिः ।\nतन्मन्ये कारणतमं यत एषा प्रवर्तते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208051, "chapter_id": 5441, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208052, "chapter_id": 5441, "verse_number": "३", "content_sanskrit": "अरणीं ब्राह्मणी विद्धि गुरुरस्योत्तरारणिः ।\nतपः श्रुतेऽथ मथिते ज्ञानाग्निर्जायते ततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208053, "chapter_id": 5441, "verse_number": "", "content_sanskrit": "ब्राह्मणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208054, "chapter_id": 5441, "verse_number": "४", "content_sanskrit": "यदिदं ब्रह्मणो लिङ्गं क्षेत्रज्ञ इति सञ्ज्ञितम् ।\nग्रहीतुं येन तच्छक्यं लक्षणं तस्य तद्वद ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208055, "chapter_id": 5441, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208056, "chapter_id": 5441, "verse_number": "५", "content_sanskrit": "अलिङ्गो निर्गुणश्चैव कारणं नास्य विद्महे ।\nउपायं तु प्रवक्ष्यामि येन गृध्येत मानवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208057, "chapter_id": 5441, "verse_number": "६", "content_sanskrit": "सम्यगप्युपदिष्टस्य अमृतस्येव तृप्यसे ।\nकर्मभुग् बुद्धिपूर्वः स्यात् ज्ञानलिङ्गैरधिष्ठितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208058, "chapter_id": 5441, "verse_number": "७", "content_sanskrit": "इदं कार्यमिदं नेति न मोक्षेषूपदिश्यते ।\nपश्यतः शृण्वतो बुद्धिः आत्मनैवोपजायते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208059, "chapter_id": 5441, "verse_number": "८", "content_sanskrit": "यावन्त इव शक्येरन् तावतोंशान् प्रकल्पयेत् ।\nव्यक्तानव्यक्तरूपांश्च शतशोऽथ सहस्रशः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208060, "chapter_id": 5441, "verse_number": "९", "content_sanskrit": "सर्वानुमानयुक्तांश्च सर्वान् प्रत्यक्षहेतुकान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208061, "chapter_id": 5441, "verse_number": "१०", "content_sanskrit": "यतः परं न विद्येत तर्ह्याकाशं भविष्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208062, "chapter_id": 5441, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208063, "chapter_id": 5441, "verse_number": "११", "content_sanskrit": "ततस्तु तस्या ब्राह्मण्या मतिः क्षेत्रज्ञसंशये ।\nक्षेत्रज्ञादेव परतः क्षेत्रज्ञोऽन्यः प्रवर्तते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208064, "chapter_id": 5441, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208065, "chapter_id": 5441, "verse_number": "१२", "content_sanskrit": "क्व नु सा ब्राह्मणी क्षुण्णा क्व चासौ ब्राह्मणर्षभः ।\nयथा सिद्धिरियं प्राप्ता तावुभौ वद मेऽच्युत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208066, "chapter_id": 5441, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208067, "chapter_id": 5441, "verse_number": "१३", "content_sanskrit": "मनो मे ब्राह्मणं विद्धि बुद्धिं मे ब्राह्मणीमथ ।\nक्षेत्रज्ञ इति यश्चोक्तः सोऽहमेव धनञ्जय ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208068, "chapter_id": 5441, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु तत्वरहस्यकथनं नाम पञ्चत्रिंशोऽध्यायः ॥३५॥\nअनुगीतापर्वणि विंशोऽध्यायः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]