[{"id": 7006224000, "chapter_id": 26224, "verse_number": "२-५२-१", "content_sanskrit": "जैमिनिरुवाच त्यक्त्वा पुत्रं स धर्मात्मा सगरः प्रेम तद्गतम् ।\nधर्मशीले तदा वाले चकारांशुमति प्रभुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006224001, "chapter_id": 26224, "verse_number": "२-५२-२", "content_sanskrit": "एतस्मिन्नेव काले तु सुमत्यास्तनया नृप ।\nववृधुः सघशः सर्वे परस्परमनुव्रताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006224002, "chapter_id": 26224, "verse_number": "२-५२-३", "content_sanskrit": "वज्रसंहननाः क्रूरा निर्दया निरपत्रपाः ।\nअधर्मशीला नितरामेकघर्माण एव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006224003, "chapter_id": 26224, "verse_number": "२-५२-४", "content_sanskrit": "एककार्याभिनिरताः क्रोधना मूढचेतसः ।\nअधृष्याः सर्वभूतानां जनोपद्रवकारिणः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006224004, "chapter_id": 26224, "verse_number": "२-५२-५", "content_sanskrit": "विनयाचा रसन्मार्गनिरपेक्षाः समन्ततः ।\nबबाधिरे जगत्सर्वमसुरा इव कामतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006224005, "chapter_id": 26224, "verse_number": "२-५२-६", "content_sanskrit": "विध्वस्तयज्ञसन्मार्गं भुवनं तैरुपद्रुतम् ।\nनिःस्वाध्याय वषट्कारं बभूवार्तं विशेषतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006224006, "chapter_id": 26224, "verse_number": "२-५२-७", "content_sanskrit": "विध्वस्यमाने सुभृशं सागरैर्वरदर्पितैः ।\nप्रक्षोभं परमं जग्मुर्देवासुरमहोरगाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006224007, "chapter_id": 26224, "verse_number": "२-५२-८", "content_sanskrit": "धरासा सागराक्रान्ता न चलापि तदा चला ।\nतपः समाधिभङ्गश्च प्रबभूव तपस्विनाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006224008, "chapter_id": 26224, "verse_number": "२-५२-९", "content_sanskrit": "हव्यकव्यपरिभ्रष्टास्त्रिदशाः पितृभिः सह ।\nदुःशेन महाताविष्टा विरिञ्जभवनं ययुः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006224009, "chapter_id": 26224, "verse_number": "२-५२-१०", "content_sanskrit": "तत्र गत्वा यथान्यायं देवाः शर्वपुरोगमाः ।\nशशंसुः सकलं तस्मै सागराणां विचेष्टितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006224010, "chapter_id": 26224, "verse_number": "२-५२-११", "content_sanskrit": "तच्छ्रत्वा वचनं तेषां ब्रह्मा लोकपितामहः ।\nक्षणमन्तर्मना भूत्वा जगाद सुरसत्तमः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006224011, "chapter_id": 26224, "verse_number": "२-५२-१२", "content_sanskrit": "देवाःशृणुत भद्रं वो वाणीमवहिता मम ।\nविनङ्क्ष्यन्त्यचिरेमैव सागरा नात्र संशयः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006224012, "chapter_id": 26224, "verse_number": "२-५२-१३", "content_sanskrit": "कालं कञ्चित्प्रतीक्षध्वं तेन सर्वं नियम्यते ।\nनिमित्तमात्रमन्यत्तु स एव सकलेशिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006224013, "chapter_id": 26224, "verse_number": "२-५२-१४", "content_sanskrit": "तस्माद्युष्मद्धितार्थाय यद्वक्ष्यामि सुरोत्तमाः ।\nसर्वैर्भवद्भिरधुना तत्कर्त्तव्यमतं द्रितैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006224014, "chapter_id": 26224, "verse_number": "२-५२-१५", "content_sanskrit": "विष्णोरंशेन भगवान्कपिलो जयतां वरः ।\nजातो जगद्धितार्थाय योगीन्द्रप्रवरो भुवि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006224015, "chapter_id": 26224, "verse_number": "२-५२-१६", "content_sanskrit": "अगस्त्यपीतसलिले दिव्यवर्षशतावधि ।\nध्यायन्नास्तेऽधुनांऽभोधावेकान्ते तत्र कुत्र चित् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006224016, "chapter_id": 26224, "verse_number": "२-५२-१७", "content_sanskrit": "गत्वा यूयं ममादेशात्कपिलं मुनिपुङ्गवम् ।\nध्यानाव सानमिच्छन्तस्तिष्ठध्वं तदुपह्वरे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006224017, "chapter_id": 26224, "verse_number": "२-५२-१८", "content_sanskrit": "समाधिविरतौ तस्य स्वाभिप्रायमशेषतः ।\nनत्वा तस्मै वदिष्यध्वं स वः श्रेयो विधास्यति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006224018, "chapter_id": 26224, "verse_number": "२-५२-१९", "content_sanskrit": "समाधिभङ्गश्च मुनेर्यथा स्यात्सागरैः कृतः ।\nकुरुध्वं च तथा यूयं प्रवृत्तिं विबुधोत्तमाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006224019, "chapter_id": 26224, "verse_number": "२-५२-२०", "content_sanskrit": "जैमिनिरुवाच इत्युक्तास्तेन विबुधास्तं प्रणम्य वितामहम् ।\nगत्वा तं विबुधश्रेष्टं ते कृताञ्जलयोऽब्रुवन् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006224020, "chapter_id": 26224, "verse_number": "२-५२-२१", "content_sanskrit": "देवा ऊचुः प्रसीद नो मुनिश्रेष्ठ वयं त्वां शरणं गताः ।\nउपद्रुतं जगत्सर्वंसागरैः संप्रणश्यति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006224021, "chapter_id": 26224, "verse_number": "२-५२-२२", "content_sanskrit": "त्वं किलाखिललोकानां स्थितिसहारकारणः ।\nविष्णोरंशेन योगीन्द्रस्वरूपी भुवि संस्थितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006224022, "chapter_id": 26224, "verse_number": "२-५२-२३", "content_sanskrit": "पुंसां तापत्रयार्त्तानामार्तिनाशाय केवलम् ।\nस्वेच्छया ते धृतो देहो न तु त्वं तपतां वरः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006224023, "chapter_id": 26224, "verse_number": "२-५२-२४", "content_sanskrit": "मनसैव जगत्सर्वं स्रष्टुं संहर्तुमेव च ।\nविधातुं स्वेच्छया ब्रह्मन्भवाञ्छक्रोत्यसंशयम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006224024, "chapter_id": 26224, "verse_number": "२-५२-२५", "content_sanskrit": "त्वं नो धाता विधाता च त्वं गुरुस्त्वं परायणम् ।\nपरित्राता त्वमस्माकं विनिवर्त्तय चापदम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006224025, "chapter_id": 26224, "verse_number": "२-५२-२६", "content_sanskrit": "शरणं भव विप्रेन्द्र विप्रेद्राणां विशेषतः ।\nसागरैर्दह्यमानानां लोकत्रयनिवासिनाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006224026, "chapter_id": 26224, "verse_number": "२-५२-२७", "content_sanskrit": "ननु वै सात्त्विकी चेष्टा भवतीह भवादृशाम् ।\nत्रातुमर्हसि तस्मात्त्वं लोकानस्मांश्च सुव्रत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006224027, "chapter_id": 26224, "verse_number": "२-५२-२८", "content_sanskrit": "न चेदकाले भगवन्विनङ्क्ष्यत्यखिलं जगत् ।\nजैमिनिरुवाच इत्युक्तः सकलैर्देवैरुन्मील्य नयने शनैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006224028, "chapter_id": 26224, "verse_number": "२-५२-२९", "content_sanskrit": "विलोक्य तानुवाचेदं कपिलः सूनृतं वचः ।\nस्वकर्मणैव निर्दग्धाः प्रविनङ्क्ष्यन्ति सागराः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006224029, "chapter_id": 26224, "verse_number": "२-५२-३०", "content_sanskrit": "काले प्राप्ते तु युष्माभिः सतावत्परिपाल्यताम् ।\nअहं तु कारणं तेषां विनाशाय दुरात्मनाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006224030, "chapter_id": 26224, "verse_number": "२-५२-३१", "content_sanskrit": "भविष्यामि सुरश्रेष्ठा भवतामर्थसिद्धये ।\nमम क्रोधाग्नि विप्लुष्टाः सागराः पापचेतसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006224031, "chapter_id": 26224, "verse_number": "२-५२-३२", "content_sanskrit": "भविष्यन्तु चिरेणैव कालोपहतबुद्धयः ।\nतस्माद्गतज्वरा देवा लोकाश्चैवाकुतोभयाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006224032, "chapter_id": 26224, "verse_number": "२-५२-३३", "content_sanskrit": "भवन्तु ते दुराचाराः क्षिप्रं यास्यन्ति संक्षयम् ।\nतद्यूयं निर्भया भूत्वा व्रजध्वं स्वां पुरीं प्रति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006224033, "chapter_id": 26224, "verse_number": "२-५२-३४", "content_sanskrit": "कालं कञ्चित्प्रतीक्षध्वं ततोऽभीष्टमवाप्स्यथ ।\nकपिलेनैवमुक्तास्ते देवाः सर्वे सवासवाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006224034, "chapter_id": 26224, "verse_number": "२-५२-३५", "content_sanskrit": "तं प्रणम्य ततो जग्मुः प्रतीताग्निदिवं प्रति ।\nएतस्मिन्नन्तरे राजा सगरः पृथिवीपतिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006224035, "chapter_id": 26224, "verse_number": "२-५२-३६", "content_sanskrit": "वाजिमेधं महायज्ञं कर्तुं चक्रे मनोरथम् ।\nआहृत्य सर्वसंभारान्वसिष्ठानुमते तदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006224036, "chapter_id": 26224, "verse_number": "२-५२-३७", "content_sanskrit": "और्वाद्यैः सहितो विप्रैर्यथावद्दीक्षितोऽभवत् ।\nदीक्षां प्रविष्टो नृपतिर्हयसंचारणाय वै ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006224037, "chapter_id": 26224, "verse_number": "२-५२-३८", "content_sanskrit": "पुत्रान्सर्वान्समाहूय संदिदेश महयशाः ।\nसंचारयित्वा तुरगं परीत्य पृथिवीतले ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006224038, "chapter_id": 26224, "verse_number": "२-५२-३९", "content_sanskrit": "क्षिप्रं ममान्तिकं पुत्राः पुनराहर्तुमर्हथ ।\nजैमिनिरुवाच ततस्ते पितुरादेशात्तमादाय तुरङ्गमम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006224039, "chapter_id": 26224, "verse_number": "२-५२-४०", "content_sanskrit": "परिचङ्क्रमयामासुः सकले क्षितिमण्डले ।\nविधिचोदनयैवाश्वः स भूमौ परिवर्तिततः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006224040, "chapter_id": 26224, "verse_number": "२-५२-४१", "content_sanskrit": "न तु दिग्विजयार्थाय करादानार्थमेव च ।\nपृथिवीभूभुजा तेन पूर्वमेव विनिर्जिता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006224041, "chapter_id": 26224, "verse_number": "२-५२-४२", "content_sanskrit": "नृपाश्चोदारवीर्येण करदाः समरे कृताः ।\nततस्ते राजतनया निस्तोये लवणांबुधौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006224042, "chapter_id": 26224, "verse_number": "२-५२-४३", "content_sanskrit": "भूतले विविशुर्हृष्टाः परिवार्य तुरङ्गमम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]