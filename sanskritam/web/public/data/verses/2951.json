[{"id": 2091688, "chapter_id": 2951, "verse_number": "१३-८१-१", "content_sanskrit": "भीष्म उवाच।\nप्राचेतसस्य वचनं कीर्तयन्ति पुराविदः।\nयस्याः किञ्चिन्नाददते ज्ञातयो न स विक्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091689, "chapter_id": 2951, "verse_number": "१३-८१-२", "content_sanskrit": "अर्हणं तत्कुमारीणामानृशंस्यं व्रतं च तत्।\nसर्वं च प्रतिदेयं स्यात्कन्यायै तदशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091690, "chapter_id": 2951, "verse_number": "१३-८१-३", "content_sanskrit": "पितृभिर्भ्रातृभिश्चापि श्वशुरैरथ देवरैः।\nपूज्या लालयितव्याश्च बहुकल्याणमीप्सुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091691, "chapter_id": 2951, "verse_number": "१३-८१-४", "content_sanskrit": "यदि वै स्त्री न रोचेत पुमांसं न प्रमोदयेत्।\nअप्रमोदात्पुनः पुंसः प्रजनो न प्रवर्धते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091692, "chapter_id": 2951, "verse_number": "१३-८१-५", "content_sanskrit": "पूज्या लालयितव्याश्च स्त्रियो नित्यं जनाधिप।\nस्त्रियो यत्र च पूज्यन्ते रमन्ते तत्र देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091693, "chapter_id": 2951, "verse_number": "१३-८१-६", "content_sanskrit": "अपूजिताश्च यत्रैताः सर्वास्तत्राफलाः क्रियाः।\nतदा चैतत्कुलं नास्ति यदा शोचन्ति जामयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091694, "chapter_id": 2951, "verse_number": "१३-८१-७", "content_sanskrit": "जामीशप्तानि गेहानि निकृत्तानीव कृत्यया।\nनैव भान्ति न वर्धन्ते श्रिया हीनानि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091695, "chapter_id": 2951, "verse_number": "१३-८१-८", "content_sanskrit": "स्त्रियः पुंसां परिददौ मनुर्जिगमिषुर्दिवम्।\nअबलाः स्वल्पकौपीनाः सुहृद सत्यजिष्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091696, "chapter_id": 2951, "verse_number": "१३-८१-९", "content_sanskrit": "ईर्षवो मानकामाश्च चण्डाश्च सुहृदोऽबुधाः।\nस्त्रियस्तु मानमर्हन्ति ता मानयत मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091697, "chapter_id": 2951, "verse_number": "१३-८१-१०", "content_sanskrit": "स्त्रीप्रत्ययो हि वै धर्मो रतिभोगाश्च केवलाः।\nपरिचर्या नमस्कारास्तदायत्ता भवन्तु वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091698, "chapter_id": 2951, "verse_number": "१३-८१-११", "content_sanskrit": "उत्पादनमपत्यस्य जातस्य परिपालनम्।\nप्रीत्यर्थं लोकयात्रायाः पश्यत स्त्रीनिबन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091699, "chapter_id": 2951, "verse_number": "१३-८१-१२", "content_sanskrit": "सम्मान्यमानाश्चैता हि सर्वकार्याष्यवाप्स्यथ।\nविदेहराजदुहिता चात्र श्लोकमगायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091700, "chapter_id": 2951, "verse_number": "१३-८१-१३", "content_sanskrit": "नास्ति यज्ञः स्त्रियाः कश्चिन्न श्राद्धं नोप्रवासकम्।\nधर्मः स्वभर्तृशुश्रूषा तया स्वर्गं जयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091701, "chapter_id": 2951, "verse_number": "१३-८१-१४", "content_sanskrit": "पिता रक्षति कौमारे भर्ता रक्षति यौवने।\nपुत्राश्च स्थाविरे भावे न स्त्री स्वातन्त्र्यमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091702, "chapter_id": 2951, "verse_number": "१३-८१-१५", "content_sanskrit": "श्रिय एताः स्त्रियो नाम सत्कार्या भूतिमिच्छता।\nलालिताऽनुगृहीता च श्रीः स्त्री भवति भारतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091703, "chapter_id": 2951, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकाशीतितमोऽध्यायः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]