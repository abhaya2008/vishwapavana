[{"id": 2087141, "chapter_id": 2848, "verse_number": "१२-३५३-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087142, "chapter_id": 2848, "verse_number": "१२-३५३-१", "content_sanskrit": "सौते सुमहदाख्यानं भवता परिकीर्तितम्।\nयच्छ्रुत्वा मुनयः सर्वे विस्मयं परमं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087143, "chapter_id": 2848, "verse_number": "१२-३५३-२", "content_sanskrit": "सर्वाश्रमाभिगमनं सर्वतीर्थावगाहनम्।\nन तथा फलदं सौते नारायणकथा यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087144, "chapter_id": 2848, "verse_number": "१२-३५३-३", "content_sanskrit": "पाविताङ्गाः स्म संवृत्ताः श्रुत्वेमामादितः कथाम्।\nनारायणाश्रयां पुण्यां सर्वपापप्रमोचनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087145, "chapter_id": 2848, "verse_number": "१२-३५३-४", "content_sanskrit": "दुर्दर्शो भगवान्देवः सर्वलोकनमस्कृतः।\nसब्रह्मकैः सुरैः कृत्स्नैरन्यैश्चैव महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087146, "chapter_id": 2848, "verse_number": "१२-३५३-५", "content_sanskrit": "दृष्टवान्नारदो यत्तु देवं नारायणं हरिम्।\nनूनमेनद्ध्यनुमतं तस्य देवस्य सूतज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087147, "chapter_id": 2848, "verse_number": "१२-३५३-६", "content_sanskrit": "यदृष्टवाञ्जगन्नाथमनिरुद्दतनौ स्थितम्।\nयत्प्राद्रवत्पुनर्भूयो नारदो देवसत्तमौ।\nनरनारायणौ द्रष्टुं कारणं तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087148, "chapter_id": 2848, "verse_number": "१२-३५३-७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087149, "chapter_id": 2848, "verse_number": "१२-३५३-७", "content_sanskrit": "तस्मिन्यज्ञे वर्तमाने राज्ञः पारिक्षितस्य वै।\nकर्मान्तरेषु विधिवद्वर्तमानेषु शौनक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087150, "chapter_id": 2848, "verse_number": "१२-३५३-८", "content_sanskrit": "कृष्णद्वैपायनं व्यासमृषिं वेदनिधिं प्रभुम्।\nपरिपप्रच्छ राजेन्द्रः पितामहपितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087151, "chapter_id": 2848, "verse_number": "१२-३५३-९x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087152, "chapter_id": 2848, "verse_number": "१२-३५३-९", "content_sanskrit": "श्वेतद्वीपान्निवृत्तेन नारदेन सुरर्षिणा।\nध्यायता भगवद्वाक्यं चेष्टितं किमतः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087153, "chapter_id": 2848, "verse_number": "१२-३५३-१०", "content_sanskrit": "बदर्याश्रममागम्य समागम्य च तावृषी।\nकियन्तं कालमवसत्कां कथां पृष्टवांश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087154, "chapter_id": 2848, "verse_number": "१२-३५३-११", "content_sanskrit": "इदं शतसहस्राद्धि भारताख्यानविस्तरात्।\nआमन्थ्य मतिमन्थेन ज्ञानोदधिमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087155, "chapter_id": 2848, "verse_number": "१२-३५३-१२", "content_sanskrit": "नवनीतं यथा दध्नो मलयाच्चन्दनं यथा।\nअरण्यकं च वेदेभ्य ओषधीभ्योऽमृतं यथा।\nसमुद्धृतमिदं ब्रह्मन्कथामृतमिदं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087156, "chapter_id": 2848, "verse_number": "१२-३५३-१३", "content_sanskrit": "तपोनिधे त्वयोक्तं हि नारायणकथाश्रयम्।\nस ईशो भगवान्देवः सर्वभूतात्मभावनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087157, "chapter_id": 2848, "verse_number": "१२-३५३-१४", "content_sanskrit": "अहो नारायणं तेजो दुर्दर्शं द्विजसत्तम।\nयत्राविशन्ति कल्पान्ते सर्वे ब्रह्मादयः सुराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087158, "chapter_id": 2848, "verse_number": "१२-३५३-१५", "content_sanskrit": "ऋषयश्च सगन्धर्वा यच्च किंचिच्चराचरम्।\nन ततोऽस्ति परं मन्ये पावतं दिवि चेह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087159, "chapter_id": 2848, "verse_number": "१२-३५३-१६", "content_sanskrit": "सर्वाश्रमाभिगमनं सर्वतीर्थावगाहनम्।\nन तथा फलदं चापि नारायणकथा यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087160, "chapter_id": 2848, "verse_number": "१२-३५३-१७", "content_sanskrit": "सर्वथा पाविताः स्मेह श्रुत्वेमामादितः कथाम्।\nहरेर्विश्वेश्वरस्येह सर्वपापप्रणाशनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087161, "chapter_id": 2848, "verse_number": "१२-३५३-१८", "content_sanskrit": "न चित्रं कृतवांस्तत्र यदार्यो मे धनंजयः।\nवासुदेवसहायो यः प्राप्तवाञ्जयमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087162, "chapter_id": 2848, "verse_number": "१२-३५३-१९", "content_sanskrit": "न चास्य किंचिदप्राप्यं मन्ये लोकेष्वपि त्रिषु।\nत्रैलोक्यनाथो विष्णुः स यथाऽसीत्साह्यकृत्सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087163, "chapter_id": 2848, "verse_number": "१२-३५३-२०", "content_sanskrit": "धन्याश्च सर्व एवासन्ब्रह्मंस्ते मम पूर्वजाः।\nहिताय श्रेयसे चैव येषामासीज्जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087164, "chapter_id": 2848, "verse_number": "१२-३५३-२१", "content_sanskrit": "तपसाऽप्यथ दुर्दर्शो भगवाँल्लोकपूजितः।\nयं दृष्टवन्तस्ते साक्षाच्छ्रीवत्साङ्कविभूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087165, "chapter_id": 2848, "verse_number": "१२-३५३-२२", "content_sanskrit": "तेभ्यो धन्यतरश्चैव नारदः परमेष्ठिजः।\n`दृष्टवान्यो हरिं देवं नारायणमजं विभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087166, "chapter_id": 2848, "verse_number": "१२-३५३-२३", "content_sanskrit": "न चाल्पतेजसमृषिं वेद्मि नारदमव्ययम्।\nश्वेतद्वीपं समासाद्य येन दृष्टः स्वयं हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087167, "chapter_id": 2848, "verse_number": "१२-३५३-२४", "content_sanskrit": "देवप्रसादानुगतं व्यक्तं तत्तस्य दर्शनम्।\nयद्दृष्टवांस्तदा देवमनिरूद्धतनौ स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087168, "chapter_id": 2848, "verse_number": "१२-३५३-२५", "content_sanskrit": "बदरीमाश्रमं यत्तु नारदः प्राद्रवत्पुनः।\nनरनारायणौ द्रष्टुं किं नु तत्कारणं मुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087169, "chapter_id": 2848, "verse_number": "१२-३५३-२६", "content_sanskrit": "श्वेतद्वीपान्निवृत्तश्च नारदः परमेष्ठिजः।\nबदरीमाश्रमं प्राप्य समागम्य च तावृषी।\nकियन्तं कालमवसत्प्रश्नान्कान्पृष्टवांश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2087170, "chapter_id": 2848, "verse_number": "१२-३५३-२७", "content_sanskrit": "श्वेतद्वीपादुपावृत्ते तस्मिन्वा सुमहात्मनि।\nकिमब्रूतां महात्मानौ नरनारायणावृषी।\nतदेतन्मे यथातत्त्वं सर्वमाख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2087171, "chapter_id": 2848, "verse_number": "१२-३५३-२८x", "content_sanskrit": "`सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2087172, "chapter_id": 2848, "verse_number": "१२-३५३-२८", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा कृष्णद्वैपायनस्तदा।\nशशास शिष्यमासीनं वैशम्पायनमन्तिके।\nतदस्मै सर्वमाचक्ष्व यन्मत्तः श्रुतवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2087173, "chapter_id": 2848, "verse_number": "१२-३५३-२९", "content_sanskrit": "गुरोर्वचनमाज्ञाय स तु विप्रर्षभस्तदा।\nआचचक्षे ततः सर्वमितिहासं पुरातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2087174, "chapter_id": 2848, "verse_number": "१२-३५३-३०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2087175, "chapter_id": 2848, "verse_number": "१२-३५३-३०", "content_sanskrit": "नमो भगवते तस्मै व्यासायामिततेजसे।\nयस्य प्रसादाद्वक्ष्यामि नारायणकथामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2087176, "chapter_id": 2848, "verse_number": "१२-३५३-३१", "content_sanskrit": "प्राप्य श्वेतं महाद्वीपं दृष्ट्वा च हरिमव्ययम्।\nनिवृत्तो नारदो राजस्तरसा मेरुमागमत्।\nहृदयेनोद्वहन्भारं यदुक्तं परमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2087177, "chapter_id": 2848, "verse_number": "१२-३५३-३२", "content_sanskrit": "पश्चादस्याभवद्राजन्नात्मनः साध्वसं महत्।\nयद्गत्वा दूरमध्वानं क्षेमी पुनरिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2087178, "chapter_id": 2848, "verse_number": "१२-३५३-३३", "content_sanskrit": "मेरोः प्रचक्राम ततः पर्वतं गन्धमादनम्।\nनिपपात च खात्तूर्णं विशालां बदरीमनु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2087179, "chapter_id": 2848, "verse_number": "१२-३५३-३४", "content_sanskrit": "ततः स ददृशे देवौ पुराणावृषिसत्तमौ।\nतपश्चरन्तौ सुमहदात्मनिष्ठौ महाव्रतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2087180, "chapter_id": 2848, "verse_number": "१२-३५३-३५", "content_sanskrit": "तेजसाऽभ्यधिकौ सूर्यात्सर्वलोकविरोचनात्।\nश्रीवत्सलक्षणौ पूज्यौ जटामण्डलधारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2087181, "chapter_id": 2848, "verse_number": "१२-३५३-३६", "content_sanskrit": "जालपादभुजौ तौ तु पादयोश्चक्रलक्षणौ।\nव्यूढोरस्कौ दीर्घभुजौ तथा मुष्कचतुष्किणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2087182, "chapter_id": 2848, "verse_number": "१२-३५३-३७", "content_sanskrit": "षष्टिदन्तावष्टदंष्ट्रौ मेघौघसदृशस्वनौ।\nस्वास्यौ पृथुललाटौ च सुभ्रूसुहनुनासिकौ।\nआतपत्रेण सदृशे शिरसी देवयोस्तयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2087183, "chapter_id": 2848, "verse_number": "१२-३५३-३८", "content_sanskrit": "एवं लक्षणसंपन्नौ महापुरुषसंज्ञितौ।\nतौ दृष्ट्वा नारदो हृष्टस्ताभ्यां च प्रतिपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2087184, "chapter_id": 2848, "verse_number": "१२-३५३-३९", "content_sanskrit": "स्वागतेनाभिभाष्याथ पृष्टश्चानामयं तथा।\nबभूवान्तर्गतमतिर्निरीक्ष्य पुरुषोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2087185, "chapter_id": 2848, "verse_number": "१२-३५३-४०", "content_sanskrit": "सदोगतास्तत्र ये वै सर्वभूतनमस्कृताः।\nश्वेतद्वीपे मया दृष्टास्तादृशावृषिसत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2087186, "chapter_id": 2848, "verse_number": "१२-३५३-४१", "content_sanskrit": "इति संचिन्त्य मनसा कृत्वा चाभिप्रदक्षिणाम्।\nस चोपविविशे तत्र पीठे कुशमये शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2087187, "chapter_id": 2848, "verse_number": "१२-३५३-४२", "content_sanskrit": "ततस्तौ तपसां वासौ यशसां तेजसामपि।\nऋषी शमदमोपेतौ कृत्वा पौर्वाह्णिकं विधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2087188, "chapter_id": 2848, "verse_number": "१२-३५३-४३", "content_sanskrit": "यश्चान्नारदमव्यग्रौ पाद्यार्ध्याभ्यामथार्चतः।\nपीठयोश्चोपविष्टौ तौ कृतातिथ्याह्निकौ नृपौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2087189, "chapter_id": 2848, "verse_number": "१२-३५३-४४", "content_sanskrit": "तेषु तत्रोपविष्टेषु स देशोऽभिव्यराजत।\nभ्राज्याहुतिमहाञ्वालैर्यज्ञवाटो यथाऽग्निभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2087190, "chapter_id": 2848, "verse_number": "१२-३५३-४५", "content_sanskrit": "अथ नारायणस्तत्र नारदं वाक्यमब्रवीत्।\nसुखोपविष्टं विश्रान्तं कृतातिथ्यं सुखस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2087191, "chapter_id": 2848, "verse_number": "१२-३५३-४६", "content_sanskrit": "अपीदानीं स भगवान्परमात्मा सनातनः।\nश्वेतद्वीपे त्वया दृष्ट आवयोः प्रकृतिः परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2087192, "chapter_id": 2848, "verse_number": "१२-३५३-४७x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2087193, "chapter_id": 2848, "verse_number": "१२-३५३-४७", "content_sanskrit": "दृष्टो मे पुरुषः श्रीमान्विश्वरूपधरोऽव्ययः।\nसर्वे लोका हि तत्रस्थास्तथा देवाः सहर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2087194, "chapter_id": 2848, "verse_number": "१२-३५३-४८", "content_sanskrit": "अद्यापि चैनं पश्यामि युवां पश्यन्सनातनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2087195, "chapter_id": 2848, "verse_number": "१२-३५३-४९", "content_sanskrit": "यैर्लक्षणैरुपेतः स हरिरव्यरक्तरूपधृत्।\nतैर्लक्षणैरुपेतौ हि व्यक्तरूपधरौ युवाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2087196, "chapter_id": 2848, "verse_number": "१२-३५३-५०", "content_sanskrit": "दृष्टौ युवां मया तत्र तस्य देवस्य पार्श्वतः।\nइहैव चागतोऽस्म्यद्य विसृष्टः परमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2087197, "chapter_id": 2848, "verse_number": "१२-३५३-५१", "content_sanskrit": "को हि नाम भवेत्तस्य तेजसा यशसा श्रिया।\nसदृशस्त्रिषु लोकेषु ऋते धर्मात्मजौ युवाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2087198, "chapter_id": 2848, "verse_number": "१२-३५३-५२", "content_sanskrit": "तेन मे कथितः कृत्स्नो धर्मः क्षेत्रज्ञसंज्ञितः।\nप्रादुर्भावाश्च कथिता भविष्या इह ये यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2087199, "chapter_id": 2848, "verse_number": "१२-३५३-५३", "content_sanskrit": "तत्र ये पुरुषाः श्वेताः पञ्चेन्द्रियविवर्जिताः।\nप्रतिबुद्धाश्च ते सर्वे भक्ताश्च पुरुषोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2087200, "chapter_id": 2848, "verse_number": "१२-३५३-५४", "content_sanskrit": "तेऽर्चयन्ति सदा देवं तैः सार्धं रमते च सः।\nप्रियभक्तो हि भगवान्परमात्मा द्विजप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2087201, "chapter_id": 2848, "verse_number": "१२-३५३-५५", "content_sanskrit": "रमते सोऽर्च्यमानो हि सदा भागवतप्रियः।\nविश्वभुक्सर्वगो देवो माधवो भक्तवत्सलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2087202, "chapter_id": 2848, "verse_number": "१२-३५३-५६", "content_sanskrit": "स कर्ता कारणं चैव कार्यं चातिबलद्युतिः।\nहेतुश्चाज्ञाविधानं च तत्त्वं चैव महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2087203, "chapter_id": 2848, "verse_number": "१२-३५३-५७", "content_sanskrit": "तपसा योज्य सोत्मानं श्वेतद्वीपात्परं हि यत्।\nतेज इत्यभिविख्यातं स्वयं भासावभासितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2087204, "chapter_id": 2848, "verse_number": "१२-३५३-५८", "content_sanskrit": "शान्तिः सा त्रिषु लोकेषु विहिता भावितात्मना।\nएतया शुभया बुद्ध्या नैष्ठिकं व्रतमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2087205, "chapter_id": 2848, "verse_number": "१२-३५३-५९", "content_sanskrit": "न तत्र सूर्यस्तपति न सोमोऽभिविराजते।\nन वायुर्वाति देवेशे तपश्चरति दुश्चरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2087206, "chapter_id": 2848, "verse_number": "१२-३५३-६०", "content_sanskrit": "वेदीमष्टनलोत्सेधां भूमावास्थाय विश्वकृत्।\nएकपादस्थितो देव ऊर्ध्वबाहुरुदङ्भुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2087207, "chapter_id": 2848, "verse_number": "१२-३५३-६१", "content_sanskrit": "साङ्गानावर्तयन्वेदांस्तपस्तेपे सुदुश्चरम्।\nयद्ब्रह्म ऋषयश्चैव स्वयं पशुपतिश्च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2087208, "chapter_id": 2848, "verse_number": "१२-३५३-६२", "content_sanskrit": "शेषाश्च विबुधश्रेष्ठा दैत्यदानवराक्षसाः।\nनागाः सुपर्णा गन्धर्वाः सिद्धा राजर्पयश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2087209, "chapter_id": 2848, "verse_number": "१२-३५३-६३", "content_sanskrit": "हव्यं कव्यं च सततं विधियुक्तं प्रयुञ्जते।\nकृत्स्नं तु तस्य देवस्य चरणावुपतिष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2087210, "chapter_id": 2848, "verse_number": "१२-३५३-६४", "content_sanskrit": "याः क्रियाः संप्रयुक्ताश्च एकान्तगतबुद्धिभिः।\nताः सर्वाः शिरसा देवः प्रतिगृह्णाति वै स्वयं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2087211, "chapter_id": 2848, "verse_number": "१२-३५३-६५", "content_sanskrit": "न तस्यान्यः प्रियतरः प्रतिबुद्धैर्महात्मभिः।\nविद्यते त्रिषु लोकेषु ततोऽस्यैकान्तिकं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2087212, "chapter_id": 2848, "verse_number": "१२-३५३-६६", "content_sanskrit": "इह चैवागतोऽस्म्यद्य विसृष्टः परमात्मना।\nएवं मे भगवान्देवः स्वयमाख्यातवान्हरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2087213, "chapter_id": 2848, "verse_number": "१२-३५३-६७", "content_sanskrit": "आसिष्ये तत्परो भूत्वा युवाभ्यां सह नित्यशः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2087214, "chapter_id": 2848, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये त्रिपञ्चाशदधिकत्रिशततमोऽध्यायः॥ ३५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]