[{"id": 7005919000, "chapter_id": 25919, "verse_number": "१-१०२-१", "content_sanskrit": "याज्ञवल्क्य उवाच ।\nवानप्रस्थाश्रमं वक्ष्ये तच्छृण्वन्तु महर्षयः ।\nपुत्रेषु भार्यां निः क्षिप्य वनं गच्छेत्सहैव वा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005919001, "chapter_id": 25919, "verse_number": "१-१०२-२", "content_sanskrit": "वानप्रस्थो ब्रह्मचारी साग्निः सोपासनःक्षमी।\nअफालकृष्टेनाग्नींश्च पितृदेवातिथींस्तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005919002, "chapter_id": 25919, "verse_number": "१-१०२-३", "content_sanskrit": "भृत्यांस्तु तर्पयेच्छ्मश्रुजटालोमभृदात्मवान् ।\nदान्तस्त्रिसवर्णस्नायी निवृत्तश्च प्रतिग्रहात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005919003, "chapter_id": 25919, "verse_number": "१-१०२-४", "content_sanskrit": "स्वाध्यायवान्ध्यानशीलः सर्वभूतहितेरतः (तिः) ।\nअह्नो मासस्य मध्ये वा कुर्य्याद्वार्थपरिग्रहम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005919004, "chapter_id": 25919, "verse_number": "१-१०२-५", "content_sanskrit": "कृतं त्यजेदाश्वयुजे युञ्जेत्कालं व्रतादिना।\nपक्षे मासेथवाश्नीयाद्दन्तोलूखलिको भवेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005919005, "chapter_id": 25919, "verse_number": "१-१०२-६", "content_sanskrit": "चान्द्रायणी स्वपेद्भूमौ कर्म कुर्य्यात्फलादिना ।\nग्रीष्मे पंचाग्निमध्यस्थो वर्षासु स्थण्डिलेशयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005919006, "chapter_id": 25919, "verse_number": "१-१०२-७", "content_sanskrit": "आर्द्रवासास्तु हेमन्ते योगाभ्यासाद्दिनं नयेत् ।\nयः कण्टकैर्वितुदति चन्दनैर्यश्च लिम्पति ।\nअक्रुद्धः परितुष्टश्च समस्तस्य च तस्य च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]