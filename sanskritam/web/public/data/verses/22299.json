[{"id": 7002299000, "chapter_id": 22299, "verse_number": "३४४-१", "content_sanskrit": "अग्निरुवाच ।\nअलङ्करणमर्थानामर्थालङ्कार इष्यते ।\nतं विना शब्दसौन्दर्य्यमपि नास्ति मनोहरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002299001, "chapter_id": 22299, "verse_number": "३४४-२", "content_sanskrit": "अर्थालङ्काररहिता विधवेव सरस्वती ।\nस्वरूपमथ सादृश्यमुतप्रेक्षातिशयावपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002299002, "chapter_id": 22299, "verse_number": "३४४-३", "content_sanskrit": "विभावना विरोधश्च हेतुश्च सममष्टधा ।\nस्वभाव एव भावानां स्वरूपमभिधीयते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002299003, "chapter_id": 22299, "verse_number": "३४४-४", "content_sanskrit": "निजमागन्तुकञ्चेति द्विविधं तदुदाहृतम् ।\nसांसिद्धिकं निजं नैमित्तिकमागन्तुकं तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002299004, "chapter_id": 22299, "verse_number": "३४४-५", "content_sanskrit": "सादृश्यं धर्म्मसामान्यमुपमा रूपकं तथा ।\nसहोक्त्यर्थान्तरन्यासाविति स्यात्तु चतुर्विधम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002299005, "chapter_id": 22299, "verse_number": "३४४-६", "content_sanskrit": "उपमा नाम सा यस्यामुपमानोपमेययोः ।\nसत्ता चान्तरसामान्ययोगित्वेपि विवक्षितं ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002299006, "chapter_id": 22299, "verse_number": "३४४-७", "content_sanskrit": "किञ्चिदादाय सारूप्यं लोकयात्रा प्रवर्त्तते ।\nसमासेनासमासेन सा द्विधा प्रतियोगिनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002299007, "chapter_id": 22299, "verse_number": "३४४-८", "content_sanskrit": "विग्रहादभिधानश्य ससभासाऽन्यथोत्तरा ।\nउपमाद्योतकपदेनोपमेयपदेन च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002299008, "chapter_id": 22299, "verse_number": "३४४-९", "content_sanskrit": "ताभ्याञ्च विग्रहात् त्रेधा ससमासान्तिमात् त्रिधा ।\nविशिष्यमाणा उपमा भवन्त्यष्टादश स्फुटाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002299009, "chapter_id": 22299, "verse_number": "३४४-१०", "content_sanskrit": "यत्र साधारणो धर्म्मः कथ्यते गम्यतेऽपि वा ।\nते धर्म्मवस्तुप्राधान्याद्धर्म्मवस्तूपमे उभे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002299010, "chapter_id": 22299, "verse_number": "३४४-११", "content_sanskrit": "तुल्यमेवोपमीयेते यत्रान्योन्येन धर्म्मणौ ।\nपरस्परोपमा सा स्यात् प्रसिद्धेरन्यथा तयो ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002299011, "chapter_id": 22299, "verse_number": "३४४-१२", "content_sanskrit": "विपरीतोपमा सा स्याद्व्यावृत्तेर्न्नियमोपमा ।\nअन्यत्राप्यनुवृत्तेस्तु भवेदनियमोपमा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002299012, "chapter_id": 22299, "verse_number": "३४४-१३", "content_sanskrit": "समुच्यतेपमातोऽन्यधर्म्मवाहुल्यकीर्त्तनात् ।\nवहोर्धर्म्मस्य साम्येपि वैलक्षण्यं विवक्षितं ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002299013, "chapter_id": 22299, "verse_number": "३४४-१४", "content_sanskrit": "यदुच्यतेऽतिरिक्तत्वं व्यतिरेकोपमा तु सा ।\nयत्रोपमा स्याद्वहुभिः सदृशैः सा बहूपमा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002299014, "chapter_id": 22299, "verse_number": "३४४-१५", "content_sanskrit": "धर्म्माः प्रत्युपमानञ्चेदन्ये मालोपमैव सा ।\nउपमानविकारेण लुलना विक्रियोपमा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002299015, "chapter_id": 22299, "verse_number": "३४४-१६", "content_sanskrit": "त्रैलोक्यासम्भवि किमप्यारोप्य प्रतियोगिनि ।\nकविनोपमीयते या प्रथते साद्भुतोपमा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002299016, "chapter_id": 22299, "verse_number": "३४४-१७", "content_sanskrit": "प्रतियोगिनमारोष्य तदभेदेन कीर्त्तनम् ।\nउपमेयस्य सा मोहोपमाऽसौ भ्रान्तिमद्वचः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002299017, "chapter_id": 22299, "verse_number": "३४४-१८", "content_sanskrit": "उभयोर्धर्म्मिणोस्तथ्यानिश्चयात् संशयोपमा ।\nउपमेयस्य संशय्य निश्चयान्निश्चयोपमा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002299018, "chapter_id": 22299, "verse_number": "३४४-१९", "content_sanskrit": "वाक्यार्थेनैव वाक्यार्थोपमा स्यादुपमानतः ।\nआत्मनोपमानादुपमा साधारण्यतिशायिनी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002299019, "chapter_id": 22299, "verse_number": "३४४-२०", "content_sanskrit": "उपमेयं यदन्यस्य तदन्यस्योपमा मता ।\nयद्युत्तरोत्तरं याति तदाऽसौ गगनोपमा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002299020, "chapter_id": 22299, "verse_number": "३४४-२१", "content_sanskrit": "प्रशंसा चैव निन्दा च कल्पिता सदृशो तथा ।\nकिञ्चिच्च सदृशी ज्ञेया उपमा पञ्चधा पुनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002299021, "chapter_id": 22299, "verse_number": "३४४-२२", "content_sanskrit": "उपमानेन यत्तत्त्वमुपमेयस्य रूप्यते ।\nगुणानां समतां दृष्ट्वा रूपकं नाम तद्विदुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002299022, "chapter_id": 22299, "verse_number": "३४४-२३", "content_sanskrit": "उपमैव तिरोभूतभेदा रूपकमेव वा ।\nसहोक्तिः सहभावेन कथनं तुल्यधर्म्मिणां ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002299023, "chapter_id": 22299, "verse_number": "३४४-२४", "content_sanskrit": "भवेदर्थान्तरन्यासः सादृश्येनोत्तरेण सः ।\nअन्यथोपस्थिता वृत्तिश्चेतन्स्येतरस्य च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002299024, "chapter_id": 22299, "verse_number": "३४४-२५", "content_sanskrit": "अन्यथा मन्यते यत्र तामुत्प्रेक्षआं प्रचक्षते ।\nलोकसीमानिवृत्तस्य वस्तुधर्म्मस्य कीर्त्तनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002299025, "chapter_id": 22299, "verse_number": "३४४-२६", "content_sanskrit": "भवेदतिशयो नाम सम्भवासम्भवाद् द्विधा ।\nगुणजातिक्रियादीनां यत्र वैकल्यदर्शनं ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002299026, "chapter_id": 22299, "verse_number": "३४४-२७", "content_sanskrit": "विशेषदर्शनायैव सा विशेषोक्तिरुच्यते ।\nप्रसिद्धहेतुव्यावृत्या यत् किञ्चित् कारणआन्तरम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002299027, "chapter_id": 22299, "verse_number": "३४४-२८", "content_sanskrit": "यत्र स्वाभाविकत्वं वा विभाव्यं सा विभावना ।\nसङ्गतीकरणं युक्त्या यदसंगच्छमानयोः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002299028, "chapter_id": 22299, "verse_number": "३४४-२९", "content_sanskrit": "विरोधपूर्वकत्वेन तद्विरोध इति स्मृतं ।\nसिसाधयिषितार्थस्य हेतुर्भवति साधकः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002299029, "chapter_id": 22299, "verse_number": "३४४-३०", "content_sanskrit": "कारको ज्ञापक इति द्विधा सोऽप्युपजायते ।\nप्रवर्त्तते कारकाख्यः प्राक् पश्चात् कार्य्यजन्मनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002299030, "chapter_id": 22299, "verse_number": "३४४-३१", "content_sanskrit": "पूर्व्वशेष इति ख्यातस्तयोरेव विशेषयोः ।\nकार्य्यकारणभावद्वा स्वभावाद्वा नियामकात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002299031, "chapter_id": 22299, "verse_number": "३४४-३२", "content_sanskrit": "ईपकाख्यस्य भेदोऽस्ति नदीपूरादिदर्शनात् ।\nअविनाभावनियमो ह्यविनाभावदर्शनात् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]