[{"id": 50024196, "chapter_id": 11838, "verse_number": "1", "content_sanskrit": "॥ मधुच्छन्दा वैश्वामित्रः। इन्द्रः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024197, "chapter_id": 11838, "verse_number": "2", "content_sanskrit": "इन्द्र॒मिद्गा॒थिनो॑ बृ॒हदिन्द्र॑म॒र्केभि॑र॒र्किण॑ः। इन्द्रं॒ वाणी॑रनूषत॥ ७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024198, "chapter_id": 11838, "verse_number": "3", "content_sanskrit": "इन्द्र॒ इद्धर्यो॒ः सचा॒ सम्मि॑श्ल॒ आ व॑चो॒युजा॑। इन्द्रो॑ व॒ज्री हि॑र॒ण्यय॑ः॥ ७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024199, "chapter_id": 11838, "verse_number": "4", "content_sanskrit": "इन्द्रो॑ दी॒र्घाय॒ चक्ष॑स॒ आ सूर्यं॑ रोहयद्दि॒वि। वि गोभि॒रद्रि॑मैरयत्॥ ७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024200, "chapter_id": 11838, "verse_number": "5", "content_sanskrit": "इन्द्र॒ वाजे॑षु नोऽव स॒हस्र॑प्रधनेषु च। उ॒ग्र उ॒ग्राभि॑रू॒तिभि॑ः॥ ७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024201, "chapter_id": 11838, "verse_number": "6", "content_sanskrit": "इन्द्रं॑ व॒यं म॑हाध॒न इन्द्र॒मर्भे॑ हवामहे। युजं॑ वृ॒त्रेषु॑ व॒ज्रिण॑म्॥ ७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024202, "chapter_id": 11838, "verse_number": "7", "content_sanskrit": "स नो॑ वृषन्न॒मुं च॒रुं सत्रा॑दाव॒न्नपा॑ वृधि। अ॒स्मभ्य॒मप्र॑तिष्कुतः॥ ७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024203, "chapter_id": 11838, "verse_number": "8", "content_sanskrit": "तु॒ञ्जेतु॑ञ्जे॒ य उत्त॑रे॒ स्तोमा॒ इन्द्र॑स्य व॒ज्रिण॑ः। न वि॑न्धे अस्य सुष्टु॒तिम्॥ ७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024204, "chapter_id": 11838, "verse_number": "9", "content_sanskrit": "वृषा॑ यू॒थेव॒ वंस॑गः कृ॒ष्टीरि॑य॒र्त्योज॑सा। ईशा॑नो॒ अप्र॑तिष्कुतः॥ ७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024205, "chapter_id": 11838, "verse_number": "10", "content_sanskrit": "य एक॑श्चर्षणी॒नां वसू॑नामिर॒ज्यति॑। इन्द्र॒ः पञ्च॑ क्षिती॒नाम्॥ ७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024206, "chapter_id": 11838, "verse_number": "11", "content_sanskrit": "इन्द्रं॑ वो वि॒श्वत॒स्परि॒ हवा॑महे॒ जने॑भ्यः। अ॒स्माक॑मस्तु॒ केव॑लः॥ ७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]