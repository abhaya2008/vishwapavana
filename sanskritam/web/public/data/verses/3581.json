[{"id": 2120165, "chapter_id": 3581, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2120166, "chapter_id": 3581, "verse_number": "१", "content_sanskrit": "किमर्थं वैरिणावास्तामुभौ तौ कृष्णमागधौ ।\nकथं च निर्जितः सङ्खे जरासन्धेन माधवः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2120167, "chapter_id": 3581, "verse_number": "२", "content_sanskrit": "कश्च कंसो मागधस्य यस्य हेतोः स वैरवान् ।\nएतदाचक्ष्व मे सर्वं वैशम्पायन तत्त्वतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2120168, "chapter_id": 3581, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2120169, "chapter_id": 3581, "verse_number": "३", "content_sanskrit": "यादवानामन्ववाये वसुदेवो महामतिः ।\nउदपद्यत वार्ष्णेयो ह्युग्रसेनश्च मन्त्रवित्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2120170, "chapter_id": 3581, "verse_number": "४", "content_sanskrit": "उग्रसेनस्य कंसस्तु बभूव बलवान् सुतः ।\nज्येष्ठो बहूनां कौरव्य सर्वशस्त्रविशारदः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2120171, "chapter_id": 3581, "verse_number": "५", "content_sanskrit": "जरासन्धस्य दुहिता तस्य भार्याऽतिविश्रुता ।\nराज्यशुल्केति दत्ता सा जरासन्धेन धीमता\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2120172, "chapter_id": 3581, "verse_number": "६", "content_sanskrit": "तदर्थमुग्रसेनस्य मधुरायां सुतस्तदा ।\nअभिषिक्तस्तदाऽमात्यैः सर्वैस्तीव्रपराक्रमः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2120173, "chapter_id": 3581, "verse_number": "७", "content_sanskrit": "ऐश्वर्यबलमत्तस्तु स तदा बलमोहितः ।\nनिगृह्य पितरं भुङ्क्ते तद्राज्यं मन्त्रिभिः सह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2120174, "chapter_id": 3581, "verse_number": "८", "content_sanskrit": "वसुदेवस्य तद्वाक्यं न शृणोति स मन्दधीः ।\nस तेन सह तद्राज्यं धर्मतः पर्यपालयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2120175, "chapter_id": 3581, "verse_number": "९", "content_sanskrit": "प्रीतिमान् स तु दैत्येन्द्रो वसुदेवस्य देवकीम् ।\nउवाह भार्यां स तदा दुहिता देवकस्य या\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2120176, "chapter_id": 3581, "verse_number": "१०", "content_sanskrit": "तस्यामुद्वाह्यमानायां रथेन जनमेजय ।\nउपारुरोह वार्ष्णेयं कंसो भूमिपतिस्तदा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2120177, "chapter_id": 3581, "verse_number": "११", "content_sanskrit": "ततोऽन्तरिक्षे वागासीद् देवदूतस्य कस्यचित् ।\nवसुदेवश्च शुश्राव तां वाचं पार्थिवश्च सः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2120178, "chapter_id": 3581, "verse_number": "१२", "content_sanskrit": "यामेतां हर्षमाणोऽद्य कंसोद्वहसि देवकीम् ।\nअस्या यश्चाष्टमो गर्भः स ते मृत्युर्भविष्यति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2120179, "chapter_id": 3581, "verse_number": "१३", "content_sanskrit": "सोऽवतीर्य ततो राजा खड्गमुद्धृत्य निर्मलम् ।\nइयेष तस्या मूर्धानं छेत्तुं परमदुर्मतिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2120180, "chapter_id": 3581, "verse_number": "१४", "content_sanskrit": "स सान्त्वयन् तदा कंसं हसन् क्रोधवशानुगम् ।\nराजन्ननुनयामास वसुदेवो महामतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2120181, "chapter_id": 3581, "verse_number": "१५", "content_sanskrit": "अहिंस्यां प्रमदामाहुः सर्वधर्मेषु पार्थिव ।\nस कस्मादबलां नारीं हन्तासीमामनागसीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2120182, "chapter_id": 3581, "verse_number": "१६", "content_sanskrit": "यच्च तेऽत्र भयं राजन् शक्यते बाधितुं मया ।\nइयं च शक्या पालयितुमयशस्यं च रक्षितुम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2120183, "chapter_id": 3581, "verse_number": "१७", "content_sanskrit": "अस्यास्त्वमष्टमं गर्भं जातमात्रं महीपते ।\nविध्वंसय तदा प्राप्तमेवं परिहृतं भवेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2120184, "chapter_id": 3581, "verse_number": "१८", "content_sanskrit": "एवं स राजा कथितो वसुदेवेन भारत ।\nतस्य तद्वचनं चक्रे शूरसेनपतिस्तदा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2120185, "chapter_id": 3581, "verse_number": "१९", "content_sanskrit": "ततस्तस्यां सम्बभूवुः कुमाराः सूर्यवर्चसः ।\nजाताञ्जातांस्तु तान् सर्वान् जघान मधुरेश्वरः ।\nअथ तस्यां समभवद् बलदेवस्तु सप्तमः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2120186, "chapter_id": 3581, "verse_number": "२०", "content_sanskrit": "याम्येन मायया तं तु यमो राजा विशाम्पते ।\nदेवक्या गर्भमतुलं रोहिण्या जठरेऽक्षिपत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2120187, "chapter_id": 3581, "verse_number": "२१", "content_sanskrit": "आकृष्य कर्षणात् सम्यक् सङ्कर्षण इति स्मृतः ।\nबलश्रेष्ठतया तस्य बलदेव इति स्मृतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2120188, "chapter_id": 3581, "verse_number": "२२", "content_sanskrit": "पुनस्तस्यां समभवदष्टमो मधुसूदनः ।\nतस्य गर्भस्य रक्षां तु चक्रे सोऽभ्यधिकं नृपः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2120189, "chapter_id": 3581, "verse_number": "२३", "content_sanskrit": "ततः काले रक्षणार्थं वसुदेवस्य सात्वतः ।\nउग्रः प्रयुक्तः कंसेन सचिवः क्रूरकर्मकृत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2120190, "chapter_id": 3581, "verse_number": "२४", "content_sanskrit": "जातमात्रं वासुदेवमपकृष्य पिता ततः ।\nउपजह्रे परिक्रीतां सुतां गोपस्य कस्यचित्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2120191, "chapter_id": 3581, "verse_number": "२५", "content_sanskrit": "मुमुक्षमाणस्तं शब्दं देवदूतस्य पार्थिवः ।\nजघान कंसस्तां कन्यां प्रहसन्ती जगाम सा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2120192, "chapter_id": 3581, "verse_number": "२६", "content_sanskrit": "आर्येत्युवाच तां शब्दं तस्मादार्येति कीर्तिता\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2120193, "chapter_id": 3581, "verse_number": "२७", "content_sanskrit": "एवं तं वञ्चयित्वा च राजानं स महामतिः ।\nवासुदेवं महात्मानं वर्धयामास गोकुले\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2120194, "chapter_id": 3581, "verse_number": "२८", "content_sanskrit": "वासुदेवोऽपि गोष्ठेषु ववृधेऽब्जमिवाम्भसि ।\nअज्ञायमानः कंसेन गूढोऽग्निरिव दारुषु\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2120195, "chapter_id": 3581, "verse_number": "२९", "content_sanskrit": "विप्रचक्रे तथा सर्वान् प्रबलान् मधुसूदनः ।\nवर्धमानो महाबाहुः तेजोबलसमन्वितः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2120196, "chapter_id": 3581, "verse_number": "३०", "content_sanskrit": "ततस्ते क्लिश्यमानास्तु पुण्डरीकाक्षमच्युतम् ।\nभयेन कामादपरे गणशः पर्यवारयन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2120197, "chapter_id": 3581, "verse_number": "३१", "content_sanskrit": "स तु लब्ध्वा बलं राजन्नुग्रसेनस्य सम्मतः ।\nवसुदेवात्मजः सर्वैर्भ्रातृभिः सहितं पुनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2120198, "chapter_id": 3581, "verse_number": "३२", "content_sanskrit": "निर्जित्य युधि भोजेन्द्रं हत्वा कंसं महाबलः ।\nअभिषिञ्चत्ततो राज्य उग्रसेनं विशाम्पते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2120199, "chapter_id": 3581, "verse_number": "३३", "content_sanskrit": "तच्छ्रुत्वा स जरासन्धो माधवेन हतं युधि ।\nशूरसेनाधिपं चक्रे कंसपुत्रं तदा नृप\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2120200, "chapter_id": 3581, "verse_number": "३४", "content_sanskrit": "स सैन्यं महदुत्थाप्य वसुदेवं प्रगृह्य च ।\nअभ्यषिञ्चत् सुतं तत्र सुताया जनमेजय\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2120201, "chapter_id": 3581, "verse_number": "३५", "content_sanskrit": "उग्रसेनं च वृष्णींश्च महाबलसमन्वितः ।\nस तत्र विप्रकुरुते जरासन्धः प्रतापवान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2120202, "chapter_id": 3581, "verse_number": "३६", "content_sanskrit": "एतद्वैरं कौरवेय जरासन्धस्य माधवे ।\nआशासितार्थो राजेन्द्र संरुरोध विनिर्जितान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2120203, "chapter_id": 3581, "verse_number": "३७", "content_sanskrit": "पार्थिवैस्तैर्नृपतिभिर्यक्ष्यमाणः समृद्धिमान् ।\nदेवश्रेष्ठं महादेवं कृत्तिवासं त्रियम्बकम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2120204, "chapter_id": 3581, "verse_number": "३८", "content_sanskrit": "एतत् सर्वं यथावृत्तं कथितं भरतर्षभ ।\nयथा तु स हतो राजा भीमसेनेन तच्छृणु\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2120205, "chapter_id": 3581, "verse_number": "३९", "content_sanskrit": "ततस्तं निश्चितात्मानं युद्धाय यदुनन्दनः ।\nउवाच वाग्मी राजानं जरासन्धमधोक्षजः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2120206, "chapter_id": 3581, "verse_number": "४०", "content_sanskrit": "त्रयाणां केन ते राजन् योद्धुं हि त्वरते मनः ।\nअस्मदन्यतमोऽद्येह सज्जीभवतु को युधि\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2120207, "chapter_id": 3581, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2120208, "chapter_id": 3581, "verse_number": "४१", "content_sanskrit": "एवमुक्तस्तु कृष्णेन युद्धं वव्रे महाद्युतिः ।\nजरासन्धस्ततो राजा भीमसेनेन मागधः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2120209, "chapter_id": 3581, "verse_number": "४२", "content_sanskrit": "न त्वया भीरुणा योत्स्ये युधि विक्लवचेतसा ।\nमधुरां स्वपुरीं त्यक्त्वा समुद्रं शरणं गतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2120210, "chapter_id": 3581, "verse_number": "४३", "content_sanskrit": "अयं तु वयसाऽतुल्यो नातिसत्त्वो न मे समः ।\nअर्जुनो नो भवेद् योद्धा भीमस्तुल्यबलो मम\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2120211, "chapter_id": 3581, "verse_number": "४४", "content_sanskrit": "इत्युक्त्वा भीमसेनाय प्रदाय महतीं गदाम् ।\nद्वितीयां स्वयमादाय निर्जगाम पुराद् बहिः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2120212, "chapter_id": 3581, "verse_number": "४५", "content_sanskrit": "अर्जुनं वासुदेवं च वर्जयामास मागधः ।\nमत्वा देवं गोप इति बालोऽर्जुन इति स्म ह\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2120213, "chapter_id": 3581, "verse_number": "४६", "content_sanskrit": "धारयन्तं गदां दृष्ट्वा बलं श्रुत्वा च निर्वृतः ।\nउपतस्थे जरासन्धं युयुत्सुं वै पुरोहितः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2120214, "chapter_id": 3581, "verse_number": "४७", "content_sanskrit": "कृतस्वस्त्ययनो राजन् ब्राह्मणेन यशस्विना ।\nसन्नह्यत जरासन्धः क्षत्रधर्ममनुव्रतः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2120215, "chapter_id": 3581, "verse_number": "४८", "content_sanskrit": "अवमुच्य किरीटं स केशान् समनुमृज्य च ।\nउपातिष्ठज्जरासन्धो वेलातिग इवार्णवः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2120216, "chapter_id": 3581, "verse_number": "४९", "content_sanskrit": "उवाच च महाबाहुर्भीमं भीमपराक्रमम् ।\nभीम योत्स्ये त्वया सार्धं श्रेयसा निर्जितं परम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2120217, "chapter_id": 3581, "verse_number": "५०", "content_sanskrit": "एवमुक्त्वा जरासन्धो भीमसेनमरिन्दमः ।\nप्रत्युद्ययौ महातेजाः शक्रं बलिरिवासुरः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2120218, "chapter_id": 3581, "verse_number": "५१", "content_sanskrit": "ततः सम्मन्त्र्य कृष्णेन कृतस्वस्त्ययनो बली ।\nभीमसेनो जरासन्धमाससाद युयुत्सया\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2120219, "chapter_id": 3581, "verse_number": "५२", "content_sanskrit": "ततस्तौ नरशार्दूलौ बाहुशस्त्रौ समीयतुः ।\nवीरौ परमसंहृष्टावन्योन्यजयकाङ्क्षिणौ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2120220, "chapter_id": 3581, "verse_number": "५३", "content_sanskrit": "करग्रहणपूर्वं तु कृत्वा पादाभिवन्दनम् ।\nकक्ष्यैः कक्षान् विधून्वानावास्फोटं तत्र चक्रतुः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2120221, "chapter_id": 3581, "verse_number": "५४", "content_sanskrit": "स्कन्धौ दोर्भ्यां समाहत्य बलिनौ च मुहुर्मुहुः ।\nअङ्गैरङ्गं समाश्लिष्य पुनरास्फोटनं विभो\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2120222, "chapter_id": 3581, "verse_number": "५५", "content_sanskrit": "चित्रहस्तादिकं कृत्वा कक्षाबन्धं च चक्रतुः ।\nगळगण्डाभिघातेन सस्फुलिङ्गेन चाशनिम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2120223, "chapter_id": 3581, "verse_number": "५६", "content_sanskrit": "बाहुपाशादिकं कृत्वा पादारोहशिरावुभौ ।\nउरोहस्तं ततश्चैव कर्णकुम्भौ प्रयुज्य तौ\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2120224, "chapter_id": 3581, "verse_number": "५७", "content_sanskrit": "करसम्पीडनं कृत्वा गर्जन्तौ वारणाविव ।\nनर्दन्तौ मेघसङ्काशौ बाहुप्रहरणावुभौ\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2120225, "chapter_id": 3581, "verse_number": "५८", "content_sanskrit": "तळेनाहन्यमानौ तु अन्योन्यं स्तब्धवीक्षणौ ।\nसिंहाविव सुसङ्क्रुद्धावाकृष्याकृष्य युध्यताम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2120226, "chapter_id": 3581, "verse_number": "५९", "content_sanskrit": "अङ्गेनाङ्गं समापीड्य बाहुभ्यां भुजयोरपि ।\nआवृत्य बाहुभिश्चापि उदरं च प्रचक्रतुः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2120227, "chapter_id": 3581, "verse_number": "६०", "content_sanskrit": "उभौ कट्यां सुपार्श्वे तु भञ्जन्तौ तु सुशिक्षितौ ।\nअधोहस्तं स्वकण्ठे तूरस्योपरि चाक्षिपन्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2120228, "chapter_id": 3581, "verse_number": "६१", "content_sanskrit": "सर्वातिक्रान्तमर्यादं पृष्ठभङ्गं च चक्रतुः ।\nसम्पूर्णमुख्यां बाहुभ्यां कर्णकुम्भं च चक्रतुः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2120229, "chapter_id": 3581, "verse_number": "६२", "content_sanskrit": "तृणपीडां यथाकामं पूर्णयोगं समुष्टिकम् ।\nएवमादीनि युद्धानि प्रकुर्वन्तौ परस्परम् \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2120230, "chapter_id": 3581, "verse_number": "६३", "content_sanskrit": "तयोर्युद्धं ततो द्रष्टुं समेताः पुरवासिनः ।\nब्राह्मणा वणिजाश्चैव क्षत्रियाश्च सहस्रशः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2120231, "chapter_id": 3581, "verse_number": "६४", "content_sanskrit": "शूद्राश्च नरशार्दूल स्त्रियो वृद्धाश्च सर्वशः ।\nनिरन्तरमभूत् तत्र जनौघैरभिसंवृतम् \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2120232, "chapter_id": 3581, "verse_number": "६५", "content_sanskrit": "तयोरथ भुजाघातान्निग्रहावग्रहात् तथा ।\nआसीत् सुभीमसन्नादो वज्रपर्वतयोरिव\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2120233, "chapter_id": 3581, "verse_number": "६६", "content_sanskrit": "उभौ परमसंहृष्टौ बलेन बलिनां वरौ ।\nअन्योन्यं वै करतळैर्योधयामासतुर्भृशम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2120234, "chapter_id": 3581, "verse_number": "६७", "content_sanskrit": "अन्योन्यस्यान्तरं प्रेप्सू परस्परजयैषिणौ ।\nशिरोभिरिव तौ मेषौ वृक्षैरिव निशाचरौ\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2120235, "chapter_id": 3581, "verse_number": "६८", "content_sanskrit": "पदैरिव शुभावश्वौ तुण्डाभ्यां तित्तिराविव ।\nतद् युद्धमुत्सार्य जनं भीममासीदुपाह्वये ।\nबलिनोः संयुगे राजन् वृत्रवासवयोरिव\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2120236, "chapter_id": 3581, "verse_number": "६९", "content_sanskrit": "आकर्षणं प्रकर्षणमुत्कर्षणनिकर्षणे ।\nविकर्षतां तथाऽन्योन्यं जानुभिश्च निजघ्नतुः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2120237, "chapter_id": 3581, "verse_number": "७०", "content_sanskrit": "ततः शब्देन महता भत्सयन्तौ परस्परम् ।\nपाषाणसङ्घातनिभैः प्रहारैरभिजघ्नतुः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2120238, "chapter_id": 3581, "verse_number": "७१", "content_sanskrit": "ततो भीमं जरासन्धो जघानोरसि मुष्टिना ।\nभीमोऽपि तं जरासन्धं वक्षस्यभिजघान ह\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2120239, "chapter_id": 3581, "verse_number": "७२", "content_sanskrit": "व्यूढोरस्कौ दीर्घभुजौ नियुद्धकुशलावुभौ ।\nबाहुभिः समसज्जेताम् आयसैः परिघैरिव\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2120240, "chapter_id": 3581, "verse_number": "७३", "content_sanskrit": "कार्त्तिकस्य तु मासस्य प्रवृत्तं प्रथमेऽहनि ।\nतदा तद्युद्धमभवद् दिनानि दश पञ्च च\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2120241, "chapter_id": 3581, "verse_number": "७४", "content_sanskrit": "अनारतं दिवारात्रमविश्रान्तमवर्तत ।\nघोरं विस्मापनतरमभूत् पञ्चदशेऽहनि\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2120242, "chapter_id": 3581, "verse_number": "७५", "content_sanskrit": "तद् युद्धमासीच्च तयोः समवेतं महात्मनोः ।\nचतुर्दश्यां निशायां तु संसृष्टो मागधः क्लमैः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2120243, "chapter_id": 3581, "verse_number": "७६", "content_sanskrit": "जरासन्धं तदा क्लान्तं दृष्ट्वा विद्वान् जनार्दनः ।\nउवाच भीमकर्माणं भीमं सम्बोधयन्निव\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2120244, "chapter_id": 3581, "verse_number": "७७", "content_sanskrit": "क्लान्तः शत्रुर्हि कौन्तेय शक्यः पीडयितुं भृशम् ।\nपीड्यमानो हि कार्त्स्न्येन जह्याज्जीवितमात्मनः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2120245, "chapter_id": 3581, "verse_number": "७८", "content_sanskrit": "तस्मात् त्वयैव कौन्तेय पीडनीयो जनाधिपः ।\nसमवेतेन युध्यस्व बाहुभ्यां भरतर्षभ\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2120246, "chapter_id": 3581, "verse_number": "७९", "content_sanskrit": "एवमुक्तः स कृष्णेन पाण्डवः परवीरहा ।\nजरासन्धस्य तद्रन्ध्रं ज्ञात्वा चक्रे वधे मतिम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2120247, "chapter_id": 3581, "verse_number": "८०", "content_sanskrit": "ततस्तमजितं जेतुं जरासन्धं वृकोदरः ।\nसंरम्भाद् बलिनां मुख्यो जग्राह कुरुनन्दन\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2120248, "chapter_id": 3581, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि त्रयोविंशोऽध्यायः ॥२३॥\nजरासन्धवधपर्वणि तृतीयोऽध्यायः ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2120249, "chapter_id": 3581, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]