[{"id": 2085184, "chapter_id": 2812, "verse_number": "१२-३१७-०x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085185, "chapter_id": 2812, "verse_number": "१२-३१७-१", "content_sanskrit": "तत्त्वानां सर्गसङ्ख्या च कालसङ्ख्या तथैव च।\nमया प्रोक्ताऽनुपूर्वेण संहारमपि मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085186, "chapter_id": 2812, "verse_number": "१२-३१७-२", "content_sanskrit": "यता संहरते जन्तून्ससर्ज च पुनः पुनः।\nअनादिनिधनो ब्रह्मा नित्यश्चाक्षर एव च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085187, "chapter_id": 2812, "verse_number": "१२-३१७-३", "content_sanskrit": "अहःक्षयमथो बुद्ध्वा निशि स्वप्नमनास्तथा।\nचोदयामास भगवानव्यक्तोऽहंकृतं नरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085188, "chapter_id": 2812, "verse_number": "१२-३१७-४", "content_sanskrit": "ततः शतसहस्रांशुरव्यक्तेनाभिचोदितः।\nकृत्वा द्वादशधाऽऽत्मानमादित्यो ज्वलदग्निवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085189, "chapter_id": 2812, "verse_number": "१२-३१७-५", "content_sanskrit": "चतुर्विधं प्रजाजातं निर्दहत्याशु तेजसा।\nजराय्वण्डस्वेदजातमुद्भिज्जं स नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085190, "chapter_id": 2812, "verse_number": "१२-३१७-६", "content_sanskrit": "एतदुन्मेषमात्रेण विनष्टं स्थाणुजङ्गमम्।\nकूर्मपृष्ठसमा भूमिर्भवत्यथ समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085191, "chapter_id": 2812, "verse_number": "१२-३१७-७", "content_sanskrit": "जगद्दग्ध्वाऽमितबलः केवलां जगर्ती ततः।\nअम्भसा बलिना क्षिप्रमापूरयति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085192, "chapter_id": 2812, "verse_number": "१२-३१७-८", "content_sanskrit": "ततः कालाग्निमासाद्य तदम्भो याति संक्षयम्।\nविनष्टेऽम्भसि राजेन्द्र जाज्वलत्यनलो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085193, "chapter_id": 2812, "verse_number": "१२-३१७-९", "content_sanskrit": "तमप्रमेयातिबलं ज्वलमानं विभावसुम्।\nऊष्माणं सर्वभूतानां सप्ताचिंपमथाञ्जसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085194, "chapter_id": 2812, "verse_number": "१२-३१७-१०", "content_sanskrit": "भक्षयामास भगवान्वायुरष्टात्मको बली।\nविचरन्नमितप्राणस्तिर्यगूर्ध्वमधस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085195, "chapter_id": 2812, "verse_number": "१२-३१७-११", "content_sanskrit": "तमप्रतिबलं भीममाकाशं ग्रसते पुनः।\nआकाशमप्यभिनदन्मनो ग्रसति चारिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085196, "chapter_id": 2812, "verse_number": "१२-३१७-१२", "content_sanskrit": "मनो ग्रसति सर्वात्मा सोहंकारः प्रजापतिः।\nअहंकारो महानात्मा भूतभव्यभविष्यवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085197, "chapter_id": 2812, "verse_number": "१२-३१७-१३", "content_sanskrit": "तमप्यनुपमात्मानं विश्वं शंभुः प्रजापतिः।\nअणिमा लघिमा प्राप्तिरीशानो ज्योतिरव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085198, "chapter_id": 2812, "verse_number": "१२-३१७-१४", "content_sanskrit": "सर्वतः पाणिपादं तत्सर्वतोक्षिशिरोमुखम्।\nसर्वतः श्रुतिमल्लोके सर्वमावृत्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085199, "chapter_id": 2812, "verse_number": "१२-३१७-१५", "content_sanskrit": "हृदयं सर्वभूतानां पर्वणाऽङ्गुष्ठमात्रकः।\nअणुग्रसत्यनन्तो हि महात्मा विश्वमीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085200, "chapter_id": 2812, "verse_number": "१२-३१७-१६", "content_sanskrit": "ततः समभवत्सर्वमक्षयाव्ययमव्रणम्।\nभूतभव्यभविष्याणां स्रष्टारमनघं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085201, "chapter_id": 2812, "verse_number": "१२-३१७-१७", "content_sanskrit": "एषोप्ययस्ते राजेन्द्र यथावत्समुदाहृतः।\nअध्यात्ममधिभूतं च श्रूयतां चाधिदैवतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085202, "chapter_id": 2812, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तदशाधिकत्रिशततमोऽध्यायः॥ ३१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]