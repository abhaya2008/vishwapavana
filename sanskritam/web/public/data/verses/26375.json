[{"id": 7006375000, "chapter_id": 26375, "verse_number": "२-३१-१", "content_sanskrit": "वैशम्पायन उवाच\nभर्तारं पतितं दृष्ट्वा क्षीणपुण्यमिव ग्रहम् ।\nकंसपत्न्यो हतं कंसं समन्तात् पर्यवारयन् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006375001, "chapter_id": 26375, "verse_number": "२-३१-२", "content_sanskrit": "तं महीशयने सुप्तं क्षितिनाथं गतायुषम् ।\nभार्याः स्म दृष्ट्वा शोचन्ति मृग्यो मृगपतिं यथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006375002, "chapter_id": 26375, "verse_number": "२-३१-३", "content_sanskrit": "हा हताः स्म महाबाहो हताशा हतबान्धवाः ।\nवीरपत्न्यो हते वीरे त्वयि वीरव्रतप्रिये ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006375003, "chapter_id": 26375, "verse_number": "२-३१-४", "content_sanskrit": "इमामवस्थां पश्यन्त्यः पश्चिमां तव नैष्ठिकीम् ।\nकृपणं राजशार्दूल विलपामः सबान्धवाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006375004, "chapter_id": 26375, "verse_number": "२-३१-५", "content_sanskrit": "छिन्नमूलाः स्म संवृत्ताः परित्यक्तास्त्वया विभो ।\nत्वयि पञ्चत्वमापन्ने नाथेऽस्माकं महाबले ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006375005, "chapter_id": 26375, "verse_number": "२-३१-६", "content_sanskrit": "को नः कोपपरीताङ्गी रतिसंसर्गलालसाः ।\nलता इव विचेष्टन्तीः शयनीयानि नेष्यति ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006375006, "chapter_id": 26375, "verse_number": "२-३१-७", "content_sanskrit": "इदं तेऽसदृशं सौम्य हृद्यनिःश्वासमारुतम् ।\nदहत्यर्को मुखं कान्तं निस्तोयमिव पङ्कजम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006375007, "chapter_id": 26375, "verse_number": "२-३१-८", "content_sanskrit": "इमे ते श्रवणे शून्ये न शोभेते विकुण्डले ।\nशिरोधरायां संलीने सततं कुण्डलप्रिये ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006375008, "chapter_id": 26375, "verse_number": "२-३१-९", "content_sanskrit": "क्व ते स मुकुटो वीर सर्वरत्नविभूषितः ।\nअत्यर्थं शिरसो लक्ष्मीं यो दधारार्कसप्रभाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006375009, "chapter_id": 26375, "verse_number": "२-३१-१०", "content_sanskrit": "अनेन हि कलत्रेण तवान्तःपुरशोभिना ।\nकथं दीनेन कर्तव्यं त्वयि लोकान्तरं गते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006375010, "chapter_id": 26375, "verse_number": "२-३१-११", "content_sanskrit": "ननु नाम स्त्रियः साध्व्यः प्रियभोगेष्ववञ्चिताः ।\nपतीनामपरित्याज्याः स त्वं नस्त्यज्य गच्छसि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006375011, "chapter_id": 26375, "verse_number": "२-३१-१२", "content_sanskrit": "अहो कालो महावीर्यो येन पर्ययकर्मणा ।\nकालतुल्यः सपत्नानां त्वं क्षिप्रमपनीयसे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006375012, "chapter_id": 26375, "verse_number": "२-३१-१३", "content_sanskrit": "वयं दुःखेष्वनुचिताः सुखेष्वेव त्वयैधिताः ।\nकथं वत्स्याम विधवा नाथ कार्पण्यमाश्रिताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006375013, "chapter_id": 26375, "verse_number": "२-३१-१४", "content_sanskrit": "स्त्रीणां चारित्रलुब्धानां पतिरेकः परा गतिः ।\nत्वं हि नः सा गतिश्छिन्ना कृतान्तेन बलीयसा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006375014, "chapter_id": 26375, "verse_number": "२-३१-१५", "content_sanskrit": "वैधव्येनाभिभूताः स्मः शोकसंतप्तमानसाः ।\nरोदितव्यह्रदे मग्नाः क्व गच्छामस्त्वया विना ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006375015, "chapter_id": 26375, "verse_number": "२-३१-१६", "content_sanskrit": "सह त्वया गतः कालस्त्वदङ्के क्रीडितं कृतम् ।\nक्षणेन तद्विहीनाः स्म अनित्या हि नृणां गतिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006375016, "chapter_id": 26375, "verse_number": "२-३१-१७", "content_sanskrit": "अहो बलविहीनाः स्म विपन्ने त्वयि मानद ।\nएकदुष्कृतकारिण्यः सर्वा वैधव्यलक्षणाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006375017, "chapter_id": 26375, "verse_number": "२-३१-१८", "content_sanskrit": "त्वया स्वर्गप्रतिच्छन्दैर्लालिताः स्म रतिप्रियाः ।\nत्वयि कामवशाः सर्वाः स नस्त्यज्य क्व गच्छसि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006375018, "chapter_id": 26375, "verse_number": "२-३१-१९", "content_sanskrit": "अस्माकं त्वमनाथानां नाथो ह्यसि सुरोपम ।\nआसां विलपमानानां कुररीणामिव प्रभो ।\nप्रतिवाक्यं जगन्नाथ दातुमर्हसि मानद ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006375019, "chapter_id": 26375, "verse_number": "२-३१-२०", "content_sanskrit": "एवमार्तकलत्रस्य शाम्यमानेषु बन्धुषु ।\nगमनं ते महाभाग दारुणं प्रतिभाति नः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006375020, "chapter_id": 26375, "verse_number": "२-३१-२१", "content_sanskrit": "नूनं कान्ततराः कान्त परलोके वरस्त्रियः ।\nयतस्त्वं प्रस्थितो वीर विहायेमं गृहे जनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006375021, "chapter_id": 26375, "verse_number": "२-३१-२२", "content_sanskrit": "किं नु ते कारणं वीर भार्यास्वेतासु भूरिद ।\nआर्तनादं रुदन्तीषु यन्मोहान्नावबुध्यसे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006375022, "chapter_id": 26375, "verse_number": "२-३१-२३", "content_sanskrit": "अहो निष्करुणा यात्रा नराणामौर्ध्वदेहिकी ।\nयत् परित्यज्य दारान्स्वान्निरपेक्षा व्रजन्ति हि॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006375023, "chapter_id": 26375, "verse_number": "२-३१-२४", "content_sanskrit": "अपतित्वं स्त्रियाः श्रेयो न तु शूरः पतिः स्त्रियाः ।\nस्वर्गस्त्रीणां प्रियाः शूरास्तेषामपि च ताः प्रियाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006375024, "chapter_id": 26375, "verse_number": "२-३१-२५", "content_sanskrit": "अहो क्षिप्रमदृश्येन नयता त्वां रणप्रियम् ।\nप्रहृतं नः कृतान्तेन सर्वासामन्तरात्मसु ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006375025, "chapter_id": 26375, "verse_number": "२-३१-२६", "content_sanskrit": "हत्वा जरासंधबलं जित्वा यक्षांश्च संयुगे ।\nकथं मानुषमात्रेण हतस्त्वं जगतीतले ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006375026, "chapter_id": 26375, "verse_number": "२-३१-२७", "content_sanskrit": "इन्द्रेण सह संग्रामं कृत्वा सायकविग्रहम् ।\nअमर्त्यैरजितो युद्धे मर्त्येनासि कथं हतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006375027, "chapter_id": 26375, "verse_number": "२-३१-२८", "content_sanskrit": "त्वया सागरमक्षोभ्यं विक्षोभ्य शरवृष्टिभिः ।\nरत्नसर्वस्वहरणं जित्वा पाशधरं कृतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006375028, "chapter_id": 26375, "verse_number": "२-३१-२९", "content_sanskrit": "त्वया पौरजनस्यार्थे मन्दं वर्षति वासवे ।\nसायकैर्जलदाञ्जित्वा बलाद् वर्षं प्रवर्तितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006375029, "chapter_id": 26375, "verse_number": "२-३१-३०", "content_sanskrit": "प्रतापावनताः सर्वे तव तिष्ठन्ति पार्थिवाः ।\nप्रेषयन्तो वरार्हाणि रत्नान्याच्छादनानि च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006375030, "chapter_id": 26375, "verse_number": "२-३१-३१", "content_sanskrit": "तवैव देवकल्पस्य दृष्टवीर्यस्य शत्रुभिः ।\nकथं प्राणान्तकं घोरमीदृशं भयमागतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006375031, "chapter_id": 26375, "verse_number": "२-३१-३२", "content_sanskrit": "प्राप्ताः स्मो विधवाशब्दं त्वयि नाथे निपातिते ।\nअप्रमत्ताः प्रमत्तेन कृतान्तेन निराकृताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006375032, "chapter_id": 26375, "verse_number": "२-३१-३३", "content_sanskrit": "यद्येवं नाथ गन्तव्यं यदि वा विस्मृता वयम् ।\nवाङ्मात्रेणापि यामीति वक्तव्ये कः परिश्रमः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006375033, "chapter_id": 26375, "verse_number": "२-३१-३४", "content_sanskrit": "प्रसीद नाथ भीताः स्म पादौ ते याम मूर्द्धभिः ।\nअलं दूरप्रवासेन निवर्तस्व नराधिप ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006375034, "chapter_id": 26375, "verse_number": "२-३१-३५", "content_sanskrit": "अहो वीर कथं शेषे निषण्णस्तृणपांसुषु ।\nशयानस्य हि ते भूमौ कस्मान्नोद्विजते वपुः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006375035, "chapter_id": 26375, "verse_number": "२-३१-३६", "content_sanskrit": "केन सुप्तप्रहारोऽयं दत्तोऽस्माकमतर्कितः ।\nप्रहृतं केन सर्वासु नारीष्वेवं सुदारुणम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006375036, "chapter_id": 26375, "verse_number": "२-३१-३७", "content_sanskrit": "रुदितानुशयो नार्या जीवन्त्याः परिदेवनम् ।\nकिं वयं सति गन्तव्ये सह भर्त्रा रुदामहे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006375037, "chapter_id": 26375, "verse_number": "२-३१-३८", "content_sanskrit": "एतस्मिन्नन्तरे दीना कंसमाता प्रवेपती ।\nक्व मे वत्सः क्व मे पुत्र इति रोरूयती भृशम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006375038, "chapter_id": 26375, "verse_number": "२-३१-३९", "content_sanskrit": "सापश्यन्निहतं पुत्रं निष्प्रभं शशिनं यथा ।\nहृदयेन विदीर्णेन भ्राम्यमाणा पुनः पुनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006375039, "chapter_id": 26375, "verse_number": "२-३१-४०", "content_sanskrit": "पुत्रं समभिवीक्षन्ती हा हतास्मीति वाशती ।\nस्नुषाणामार्तनादेन विललाप रुरोद च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006375040, "chapter_id": 26375, "verse_number": "२-३१-४१", "content_sanskrit": "सा तस्य वदनं दीनमुत्संगे पुत्रगृद्धिनी ।\nकृत्वा पुत्रेति कारुण्यं विललापार्तया गिरा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006375041, "chapter_id": 26375, "verse_number": "२-३१-४२", "content_sanskrit": "पुत्र शूरव्रते युक्त ज्ञातीनां नन्दिवर्द्धन ।\nकिमिदं त्वरितं वत्स प्रस्थानं कृतवानसि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006375042, "chapter_id": 26375, "verse_number": "२-३१-४३", "content_sanskrit": "प्रसुप्तश्चातिविवृते किं पुत्र नियमं विना ।\nवत्स नैवंविधा भूमौ शेरते कृतलक्षणाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006375043, "chapter_id": 26375, "verse_number": "२-३१-४४", "content_sanskrit": "रावणेन पुरा गीतः श्लोकोऽयं साधुसम्मतः ।\nबलज्येष्ठेन लोकेषु राक्षसानां समागमे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006375044, "chapter_id": 26375, "verse_number": "२-३१-४५", "content_sanskrit": "एवमूर्जितवीर्यस्य मम देवनिघातिनः ।\nबान्धवेभ्यो भयं घोरं दुर्निवार्यं भविष्यति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006375045, "chapter_id": 26375, "verse_number": "२-३१-४६", "content_sanskrit": "तथैव ज्ञातिलुब्धस्य मम पुत्रस्य धीमतः ।\nज्ञातिभ्यो भयमुत्पन्नं शरीरान्तकरं महत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006375046, "chapter_id": 26375, "verse_number": "२-३१-४७", "content_sanskrit": "सा पतिं भूपतिं वृद्धमुग्रसेनं विचेतसम् ।\nउवाच रुदती वाक्यं विवत्सा हरिणी यथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006375047, "chapter_id": 26375, "verse_number": "२-३१-४८", "content_sanskrit": "एह्येहि राजञ्छुद्धात्मन पश्य पुत्रं जनेश्वरम् ।\nशयानं वीरशयने वज्राहतमिवाचलम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006375048, "chapter_id": 26375, "verse_number": "२-३१-४९", "content_sanskrit": "अन्य कुर्मो महाराज निर्याणसदृशीं क्रियाम् ।\nप्रेतत्वमुपपन्नस्य गतस्य यमसादनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006375049, "chapter_id": 26375, "verse_number": "२-३१-५०", "content_sanskrit": "वीरभोग्यानि राज्यानि वयं चापि पराजिताः ।\nगच्छ विज्ञाप्यतां कृष्णः कंससत्कारकारणात् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006375050, "chapter_id": 26375, "verse_number": "२-३१-५१", "content_sanskrit": "मरणान्तानि वैराणि शान्ते शान्तिर्भविष्यति ।\nप्रेतकार्याणि कार्याणि मृतः किमपराध्यते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006375051, "chapter_id": 26375, "verse_number": "२-३१-५२", "content_sanskrit": "एवमुक्त्वा पतिं भोजं केशानारुज्य दुःखिता ।\nपुत्रस्य मुखमीक्षन्ती विललापैव सा भृशम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006375052, "chapter_id": 26375, "verse_number": "२-३१-५३", "content_sanskrit": "इमास्ते किं करिष्यन्ति भार्या राजन् सुखोषिताः ।\nत्वां पतिं सुपतिं प्राप्य या विपन्नमनोरथाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006375053, "chapter_id": 26375, "verse_number": "२-३१-५४", "content_sanskrit": "इमं ते पितरं वृद्धं कृष्णस्य वशवर्तिनम् ।\nकथं द्रक्ष्यामि शुष्यन्तं कासारसलिलं यथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006375054, "chapter_id": 26375, "verse_number": "२-३१-५५", "content_sanskrit": "अहं ते जननी पुत्र किमर्थं नाभिभाषसे ।\nप्रस्थितो दीर्घमध्वानं परित्यज्य प्रियं जनम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006375055, "chapter_id": 26375, "verse_number": "२-३१-५६", "content_sanskrit": "अहो वीराल्पभाग्यायाः कृतान्तेनाभिवर्तिना ।\nआच्छिद्य मम संदायो नीयसे नयकोविदः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006375056, "chapter_id": 26375, "verse_number": "२-३१-५७", "content_sanskrit": "दानमानगृहीतानि तृप्तान्येतानि तैर्गुणैः ।\nरुदन्ति तव भृत्यानां कुलानि कुलयूथप ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006375057, "chapter_id": 26375, "verse_number": "२-३१-५८", "content_sanskrit": "उत्तिष्ठ नरशार्दूल दीर्घबाहो महाबल ।\nत्राहि दीनं जनं सर्वं पुरमन्तःपुरं यथा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006375058, "chapter_id": 26375, "verse_number": "२-३१-५९", "content_sanskrit": "रुदतीनां भृशार्तानां कंसस्त्रीणां सुविस्तरम् ।\nजगामास्तं दिनकरः संध्यारागेण रञ्जितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]