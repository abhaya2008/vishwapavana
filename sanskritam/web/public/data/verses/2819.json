[{"id": 2085449, "chapter_id": 2819, "verse_number": "१२-३२४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085450, "chapter_id": 2819, "verse_number": "१२-३२४-१", "content_sanskrit": "ऐश्वर्यं वा महत्प्राप्य धनं वा भरतर्षभ।\nदीर्घमायुरवाप्याथ कथं मृत्युमतिक्रमेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085451, "chapter_id": 2819, "verse_number": "१२-३२४-२", "content_sanskrit": "तपसा वा सुमहता कर्मणा वा श्रुतेन वा।\nरसायनप्रयोगैर्वा कैर्नाप्नोति जरान्तकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085452, "chapter_id": 2819, "verse_number": "१२-३२४-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085453, "chapter_id": 2819, "verse_number": "१२-३२४-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nभिक्षोः पञ्चशिखस्येह संवादं जनकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085454, "chapter_id": 2819, "verse_number": "१२-३२४-४", "content_sanskrit": "वैदेहो जनको राजा महर्षि वेदवित्तमम्।\nयर्यपृच्छत्पञ्चशिखं छिन्नधर्मार्थसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085455, "chapter_id": 2819, "verse_number": "१२-३२४-५", "content_sanskrit": "केन वृत्तेन भगवन्नतिक्रामेज्जरान्तकौ।\nतपसा वाऽथवा बुद्ध्या कर्मणा वा श्रुतेन वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085456, "chapter_id": 2819, "verse_number": "१२-३२४-६", "content_sanskrit": "एवमुक्तः स वैदेहं प्रत्युवाचापरेक्षवित्।\nनिवृत्तिर्नैतयोरस्ति नातिवृत्तिः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085457, "chapter_id": 2819, "verse_number": "१२-३२४-७", "content_sanskrit": "न ह्यहानि निवर्तन्ते न मासा न पुनः क्षपाः।\nसोयं प्रपद्यतेऽध्वानं चिराय ध्रुवमध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085458, "chapter_id": 2819, "verse_number": "१२-३२४-८", "content_sanskrit": "सर्वभूतसमुच्छेदः स्रोतसेवोह्यते सदा।\nऊह्यमानं निमज्जन्तमप्लवे कालसागरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085459, "chapter_id": 2819, "verse_number": "१२-३२४-९", "content_sanskrit": "जरामृत्युमहाग्राहे न कश्चिदतिवर्तते।\nनैवास्य कश्चिद्भवति नासौ भवति कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085460, "chapter_id": 2819, "verse_number": "१२-३२४-१०", "content_sanskrit": "पथि संगतमेवेदं दारैरन्यैश्च बन्धुभिः।\nनायमत्यन्तसंवासो लब्धपूर्वो हि केनचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085461, "chapter_id": 2819, "verse_number": "१२-३२४-११", "content_sanskrit": "क्षिप्यन्ते तेनतेनैव निष्टनन्तः पुनः पुनः।\nकालेन जाता याता हि वायुनेवाभ्रसंचयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085462, "chapter_id": 2819, "verse_number": "१२-३२४-१२", "content_sanskrit": "जरामृत्यू हि भूतानां खादितारौ वृकाविव।\nबलिनां दुर्बलानां च ह्रस्वानां महतामपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085463, "chapter_id": 2819, "verse_number": "१२-३२४-१३", "content_sanskrit": "एवंभूतेषु भूतेषु नित्यभूताध्रवेषु च।\nकथं हि हृष्येज्जातेषु मृतेषु च न संज्वरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085464, "chapter_id": 2819, "verse_number": "१२-३२४-१४", "content_sanskrit": "कुतोऽहमागतः कोऽस्मि क्व गमिष्यामि कस्य वा।\nकस्मिन्स्थितः क्व भविता कस्मात्किमनुशोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085465, "chapter_id": 2819, "verse_number": "१२-३२४-१५", "content_sanskrit": "द्रष्टा स्वर्गस्य न ह्यस्ति तथैव नरकस्य च।\nआगमास्त्वनतिक्रम्य दद्याच्चैव यजेत च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085466, "chapter_id": 2819, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुविंशत्यधिकत्रिशततमोऽध्यायः॥ ३२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]