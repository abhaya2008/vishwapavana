[{"id": 40020270, "chapter_id": 9330, "verse_number": "1", "content_sanskrit": "सुमाली वरलब्धांस्तु ज्ञात्वा चैतान्निशाचरान् । उदतिष्ठद्भयं त्यक्त्वा सानुगः स रसातलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020271, "chapter_id": 9330, "verse_number": "2", "content_sanskrit": "मारीचश्च प्रहस्तश्च विरूपाक्षो महोदरः । उदतिष्ठन्सुसंरब्धाः सचिवास्तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020272, "chapter_id": 9330, "verse_number": "3", "content_sanskrit": "सुमाली सचिवैः सार्धं वृतो राक्षसपुङ्गवैः । अभिगम्य दशग्रीवं परिष्वज्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020273, "chapter_id": 9330, "verse_number": "4", "content_sanskrit": "दिष्ट्या ते वत्स सम्प्राप्तश्चिन्तितो ऽयं मनोरथः । यस्त्वं त्रिभुवनश्रेष्ठाल्लब्धवान्वरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020274, "chapter_id": 9330, "verse_number": "5", "content_sanskrit": "यत्कृते च वयं लङ्कां त्यकत्वा याता रसातलम् । तद्गतं नो महाबाहो महद्विष्णुकृतं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020275, "chapter_id": 9330, "verse_number": "6", "content_sanskrit": "असकृत्तद्भयाद्भीताः परित्यज्य स्वमालयम् । विद्रुताः सहिताः सर्वे प्रविष्टाः स्म रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020276, "chapter_id": 9330, "verse_number": "7", "content_sanskrit": "अस्मदीया च लङ्केयं नगरी राक्षसोचिता । निवेशिता तव भ्रात्रा धनाध्यक्षेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020277, "chapter_id": 9330, "verse_number": "8", "content_sanskrit": "यदि नामात्र शक्यं स्यात्साम्ना दानेन वानघ । तरसा वा महाबाहो प्रत्यानेतुं कृतं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020278, "chapter_id": 9330, "verse_number": "9", "content_sanskrit": "त्वं तु लङ्केश्वरस्तात भविष्यसि न संशयः । त्वया राक्षसवंशो ऽयं निमग्नो ऽपि समुद्धृतः । सर्वेषां नः प्रभुश्चैव भविष्यसि महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020279, "chapter_id": 9330, "verse_number": "10", "content_sanskrit": "अथाब्रवीद्दशग्रीवो मातामहमुपस्थितम् । वित्तेशो गुरुरस्माकं नार्हसे वक्तुमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020280, "chapter_id": 9330, "verse_number": "11", "content_sanskrit": "साम्नापि राक्षसेन्द्रेण प्रत्याख्यातो गरीयसा । किञ्चिन्नाह तदा रक्षो ज्ञात्वा तस्य चकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020281, "chapter_id": 9330, "verse_number": "12", "content_sanskrit": "कस्यचित्त्वथ कालस्य वसन्तं रावणं ततः । उक्तवन्तं तथा वाक्यं दशग्रीवं निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020282, "chapter_id": 9330, "verse_number": "13", "content_sanskrit": "प्रहस्तः प्रश्रितं वाक्यमिदमाह स कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020283, "chapter_id": 9330, "verse_number": "14", "content_sanskrit": "दशग्रीव महाबाहो नार्हस्त्वं वक्तुमीदृशम् । सौभ्रात्रं नास्ति शूराणां शृणु चेदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020284, "chapter_id": 9330, "verse_number": "15", "content_sanskrit": "अदितिश्च दितिश्चैव भगिन्यौ सहिते हि ते । भार्ये परमरूपिण्यौ कश्यपस्य प्रजापतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020285, "chapter_id": 9330, "verse_number": "16", "content_sanskrit": "अदितिर्जनयामास देवांस्त्रिभुवनेश्वरान् । दितिस्त्वजनयत्पुत्रान्कश्यपस्यात्मसम्भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020286, "chapter_id": 9330, "verse_number": "17", "content_sanskrit": "दैत्यानां किल धर्मज्ञ पुरीयं सवनार्णवा । सपर्वता मही वीर ते ऽभवन्प्रभविष्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020287, "chapter_id": 9330, "verse_number": "18", "content_sanskrit": "निहत्य तांस्तु समरे विष्णुना प्रभविष्णुना । देवानां वशमानीतं त्रैलोक्यमिदमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020288, "chapter_id": 9330, "verse_number": "19", "content_sanskrit": "नैतदेको भवानेव करिष्यति विपर्ययम् । सुरासुरैराचरितं तत्कुरुष्व वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020289, "chapter_id": 9330, "verse_number": "20", "content_sanskrit": "एवमुक्तो दशग्रीवः प्रहृष्टेनान्तरात्मना । चिन्तयित्वा मुहूर्तं वै बाढमित्येव सो ऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020290, "chapter_id": 9330, "verse_number": "21", "content_sanskrit": "स तु तेनैव हर्षेण तस्मिन्नहनि वीर्यवान् । वनं गतो दशग्रीवः सह तैः क्षणदाचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020291, "chapter_id": 9330, "verse_number": "22", "content_sanskrit": "त्रिकूटस्थः स तु तदा दशग्रीवो निशाचरः । प्रेषयामास दौत्येन प्रहस्तं वाक्यकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020292, "chapter_id": 9330, "verse_number": "23", "content_sanskrit": "प्रहस्त शीघ्रं गच्छ त्वं ब्रूहि नैर्ऋतपुङ्गवम् । वचसा मम वित्तेशं सामपूर्वमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020293, "chapter_id": 9330, "verse_number": "24", "content_sanskrit": "इयं लङ्का पुरी राजन्राक्षसानां महात्मनाम् । त्वया निवेशिता सौम्य नैतद्युक्तं तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020294, "chapter_id": 9330, "verse_number": "25", "content_sanskrit": "तद्भवान्यदि नो ह्यद्य दद्यादतुलविक्रम । कृता भवेन्मम प्रीतिर्धुर्मश्चैवानुपालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020295, "chapter_id": 9330, "verse_number": "26", "content_sanskrit": "स तु गत्वा पुरीं लङ्कां धनदेन सुरक्षिताम् । अब्रवीत्परमोदारं वित्तपालमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020296, "chapter_id": 9330, "verse_number": "27", "content_sanskrit": "प्रेषितो ऽहं तव भ्रात्रा दशग्रीवेण सुव्रत । त्वत्समीपं महाबाहो सर्वशस्त्रभृतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020297, "chapter_id": 9330, "verse_number": "28", "content_sanskrit": "तच्छ्रूयतां महाप्राज्ञ सर्वशास्त्रविशारद । वचनं मम वित्तेश यद्ब्रवीति दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020298, "chapter_id": 9330, "verse_number": "29", "content_sanskrit": "इयं किल पुरी रम्या सुमालिप्रमुखैः पुरा । भुक्तपूर्वा विशालाक्ष राक्षसैर्भीमविक्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020299, "chapter_id": 9330, "verse_number": "30", "content_sanskrit": "तेन विज्ञाप्यते सो ऽयं साम्प्रतं विश्रवात्मज । तदेषा दीयतां तात याचतस्तस्य सामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020300, "chapter_id": 9330, "verse_number": "31", "content_sanskrit": "प्रहस्तादभिसंश्रुत्य देवो वैश्रवणो वचः । प्रत्युवाच प्रहस्तं तं वाक्यं वाक्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020301, "chapter_id": 9330, "verse_number": "32", "content_sanskrit": "दत्ता ममेयं पित्रा तु लङ्का शून्या निशाचरैः । निवासिते च मे यक्षैर्दानमानादिभिर्गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020302, "chapter_id": 9330, "verse_number": "33", "content_sanskrit": "ब्रूहि गच्छ दशग्रीवं पुरं राज्यं च यन्मम । तवाप्येतन्महाबाहो भुङ्क्ष्व राज्यमकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020303, "chapter_id": 9330, "verse_number": "34", "content_sanskrit": "एवमुक्त्वा धनाध्यक्षो जगाम पितुरन्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020304, "chapter_id": 9330, "verse_number": "35", "content_sanskrit": "अभिवाद्य गुरुं प्राह रावणस्य यदीप्सितम् । एष तात दशग्रीवो दूतं प्रेषितवान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020305, "chapter_id": 9330, "verse_number": "36", "content_sanskrit": "दीयतां नगरी लङ्का पूर्वं रक्षोगणोषिता । मयात्र यदनुष्ठेयं तन्ममाचक्ष्व सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020306, "chapter_id": 9330, "verse_number": "37", "content_sanskrit": "ब्रह्मर्षिस्त्वेवमुक्तो ऽसौ विश्रवा मुनिपुङ्गवः । प्राञ्जलिं धनदं प्राह शृणु पुत्र वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020307, "chapter_id": 9330, "verse_number": "38", "content_sanskrit": "दशग्रीवो महाबाहुरुक्तवान्मम सन्निधौ । मया निर्भर्त्सितश्चासीद्बहुशोक्तः सुदुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020308, "chapter_id": 9330, "verse_number": "39", "content_sanskrit": "स क्रोधेन मया चोक्तो ध्वंसते च पुनः पुनः । श्रेयो ऽभियुक्तं धर्म्यं च शृणु पुत्र वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020309, "chapter_id": 9330, "verse_number": "40", "content_sanskrit": "वरप्रदानसम्मूढो मान्या ऽमान्यान् स दुर्मतिः । न वेत्ति मम शापाच्च प्रकृतिं दारुणां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020310, "chapter_id": 9330, "verse_number": "41", "content_sanskrit": "तस्माद्गच्छ महाबाहो कैलासं धरणीधरम् । निवेशय निवासार्थं त्यक्त्वा लङ्कां सहानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020311, "chapter_id": 9330, "verse_number": "42", "content_sanskrit": "तत्र मन्दाकिनी रम्या नदीनामुत्तमा नदी । काञ्चनैः सूर्यसङ्काशैः पङ्कजैः संवृतोदका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020312, "chapter_id": 9330, "verse_number": "43", "content_sanskrit": "कुमुदैरुत्पलैश्चैव तथा ऽन्यैश्च सुगन्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020313, "chapter_id": 9330, "verse_number": "44", "content_sanskrit": "तत्र देवाः सगन्धर्वाः साप्सरोरगकिंनराः । विहारशीलाः सततं रमन्ते सर्वदा ऽ ऽश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40020314, "chapter_id": 9330, "verse_number": "45", "content_sanskrit": "न हि क्षमं तवानेन वैरं धनद रक्षसा । जानीषे हि यथा ऽनेन लब्धः परमको वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40020315, "chapter_id": 9330, "verse_number": "46", "content_sanskrit": "एवमुक्तो गृहीत्वा ऽ ऽशु तद्वचः पितृगौरवात् । सदारपुत्रः सामान्यः सवाहनधनो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40020316, "chapter_id": 9330, "verse_number": "47", "content_sanskrit": "प्रहस्तो ऽथ दशग्रीवं गत्वा वचनमब्रवीत् । प्रहृष्टात्मा महात्मानं सहामात्यं सहानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 40020317, "chapter_id": 9330, "verse_number": "48", "content_sanskrit": "शून्या सा नगरी लङ्का त्यक्त्त्वैनां धनदो गतः । प्रविश्य तां सहास्माभिः स्वधर्मं प्रतिपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 40020318, "chapter_id": 9330, "verse_number": "49", "content_sanskrit": "एवमुक्तो दशग्रीवः प्रहस्तेन महाबलः । विवेश नगरीं लङ्कां भ्रातृभिः सबलानुगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 40020319, "chapter_id": 9330, "verse_number": "50", "content_sanskrit": "धनदेन परित्यक्तां सुविभक्तमहापथाम् । आरुरोह स देवारिः स्वर्गं देवाधिपो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 40020320, "chapter_id": 9330, "verse_number": "51", "content_sanskrit": "स चाभिषिक्तः क्षणदाचरैस्तदा निवेशयामास पुरीं दशाननः । निकामपूर्णा च बभूव सा पुरी निशाचरैर्नीलबलाहकोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 40020321, "chapter_id": 9330, "verse_number": "52", "content_sanskrit": "धनेश्वरस्त्वथ पितृवाक्यगौरवान्न्यवेशयच्छशिविमले गिरौ पुरीम् । स्वलङ्कृतैर्भवनवरैर्विभूषितां पुरन्दरस्वेव तदा ऽमरावतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]