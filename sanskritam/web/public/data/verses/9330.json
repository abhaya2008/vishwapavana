[{"id": 5000330000, "chapter_id": 9330, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000330001, "chapter_id": 9330, "verse_number": "४-५८-१", "content_sanskrit": "इत्युक्तः करुणं वाक्यं वानरैस्त्यक्तजीवितैः।\nसबाष्पो वानरान् गृध्रः प्रत्युवाच महास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000330002, "chapter_id": 9330, "verse_number": "४-५८-२", "content_sanskrit": "यवीयान् स मम भ्राता जटायुर्नाम वानराः।\nयमाख्यात हतं युद्धे रावणेन बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000330003, "chapter_id": 9330, "verse_number": "४-५८-३", "content_sanskrit": "वृद्धभावादपक्षत्वाच्छृण्वंस्तदपि मर्षये।\nनहि मे शक्तिरस्त्यद्य भ्रातुर्वैरविमोक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000330004, "chapter_id": 9330, "verse_number": "४-५८-४", "content_sanskrit": "पुरा वृत्रवधे वृत्ते स चाहं च जयैषिणौ।\nआदित्यमुपयातौ स्वो ज्वलन्तं रश्मिमालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000330005, "chapter_id": 9330, "verse_number": "४-५८-५", "content_sanskrit": "आवृत्याकाशमार्गेण जवेन स्वर्गतौ भृशम्।\nमध्यं प्राप्ते तु सूर्ये तु जटायुरवसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000330006, "chapter_id": 9330, "verse_number": "४-५८-६", "content_sanskrit": "तमहं भ्रातरं दृष्ट्वा सूर्यरश्मिभिरर्दितम्।\nपक्षाभ्यां छादयामास स्नेहात् परमविह्वलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000330007, "chapter_id": 9330, "verse_number": "४-५८-७", "content_sanskrit": "निर्दग्धपत्रः पतितो विन्ध्येऽहं वानरर्षभाः।\nअहमस्मिन् वसन् भ्रातुः प्रवृत्तिं नोपलक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000330008, "chapter_id": 9330, "verse_number": "४-५८-८", "content_sanskrit": "जटायुषस्त्वेवमुक्तो भ्रात्रा सम्पातिना तदा।\nयुवराजो महाप्रज्ञः प्रत्युवाचाङ्गदस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000330009, "chapter_id": 9330, "verse_number": "४-५८-९", "content_sanskrit": "जटायुषो यदि भ्राता श्रुतं ते गदितं मया।\nआख्याहि यदि जानासि निलयं तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000330010, "chapter_id": 9330, "verse_number": "४-५८-१०", "content_sanskrit": "अदीर्घदर्शिनं तं वै रावणं राक्षसाधमम्।\nअन्तिके यदि वा दूरे यदि जानासि शंस नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000330011, "chapter_id": 9330, "verse_number": "४-५८-११", "content_sanskrit": "ततोऽब्रवीन्महातेजा भ्राता ज्येष्ठो जटायुषः।\nआत्मानुरूपं वचनं वानरान् सम्प्रहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000330012, "chapter_id": 9330, "verse_number": "४-५८-१२", "content_sanskrit": "निर्दग्धपक्षो गृध्रोऽहं गतवीर्यः प्लवङ्गमाः।\nवाङ्मात्रेण तु रामस्य करिष्ये साह्यमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000330013, "chapter_id": 9330, "verse_number": "४-५८-१३", "content_sanskrit": "जानामि वारुणाँल्लोकान् विष्णोस्त्रैविक्रमानपि।\nदेवासुरविमर्दांश्च ह्यमृतस्य विमन्थनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000330014, "chapter_id": 9330, "verse_number": "४-५८-१४", "content_sanskrit": "रामस्य यदिदं कार्यं कर्तव्यं प्रथमं मया।\nजरया च हृतं तेजः प्राणाश्च शिथिला मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000330015, "chapter_id": 9330, "verse_number": "४-५८-१५", "content_sanskrit": "तरुणी रूपसम्पन्ना सर्वाभरणभूषिता।\nह्रियमाणा मया दृष्टा रावणेन दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000330016, "chapter_id": 9330, "verse_number": "४-५८-१६", "content_sanskrit": "क्रोशन्ती रामरामेति लक्ष्मणेति च भामिनी।\nभूषणान्यपविध्यन्ती गात्राणि च विधुन्वती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000330017, "chapter_id": 9330, "verse_number": "४-५८-१७", "content_sanskrit": "सूर्यप्रभेव शैलाग्रे तस्याः कौशेयमुत्तमम्।\nअसिते राक्षसे भाति यथा वा तडिदम्बुदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000330018, "chapter_id": 9330, "verse_number": "४-५८-१८", "content_sanskrit": "तां तु सीतामहं मन्ये रामस्य परिकीर्तनात्।\nश्रूयतां मे कथयतो निलयं तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000330019, "chapter_id": 9330, "verse_number": "४-५८-१९", "content_sanskrit": "पुत्रो विश्रवसः साक्षाद् भ्राता वैश्रवणस्य च।\nअध्यास्ते नगरीं लङ्कां रावणो नाम राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000330020, "chapter_id": 9330, "verse_number": "४-५८-२०", "content_sanskrit": "इतो द्वीपे समुद्रस्य सम्पूर्णे शतयोजने।\nतस्मिँल्लङ्का पुरी रम्या निर्मिता विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000330021, "chapter_id": 9330, "verse_number": "४-५८-२१", "content_sanskrit": "जाम्बूनदमयैर्द्वारैश्चित्रैः काञ्चनवेदिकैः।\nप्रासादैर्हेमवर्णैश्च महद्भिः सुसमाकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000330022, "chapter_id": 9330, "verse_number": "४-५८-२२", "content_sanskrit": "प्राकारेणार्कवर्णेन महता च समन्विता।\nतस्यां वसति वैदेही दीना कौशेयवासिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000330023, "chapter_id": 9330, "verse_number": "४-५८-२३", "content_sanskrit": "रावणान्तःपुरे रुद्धा राक्षसीभिः सुरक्षिता।\nजनकस्यात्मजां राज्ञस्तस्यां द्रक्ष्यथ मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000330024, "chapter_id": 9330, "verse_number": "४-५८-२४", "content_sanskrit": "लङ्कायामथ गुप्तायां सागरेण समन्ततः।\nसम्प्राप्य सागरस्यान्तं सम्पूर्णं शतयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000330025, "chapter_id": 9330, "verse_number": "४-५८-२५", "content_sanskrit": "आसाद्य दक्षिणं तीरं ततो द्रक्ष्यथ रावणम्।\nतत्रैव त्वरिताः क्षिप्रं विक्रमध्वं प्लवङ्गमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000330026, "chapter_id": 9330, "verse_number": "४-५८-२६", "content_sanskrit": "ज्ञानेन खलु पश्यामि दृष्ट्वा प्रत्यागमिष्यथ।\nआद्यः पन्थाः कुलिङ्गानां ये चान्ये धान्यजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000330027, "chapter_id": 9330, "verse_number": "४-५८-२७", "content_sanskrit": "द्वितीयो बलिभोजानां ये च वृक्षफलाशनाः।\nभासास्तृतीयं गच्छन्ति क्रौञ्चाश्च कुररैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000330028, "chapter_id": 9330, "verse_number": "४-५८-२८", "content_sanskrit": "श्येनाश्चतुर्थं गच्छन्ति गृध्रा गच्छन्ति पञ्चमम्।\nबलवीर्योपपन्नानां रूपयौवनशालिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000330029, "chapter_id": 9330, "verse_number": "४-५८-२९", "content_sanskrit": "षष्ठस्तु पन्था हंसानां वैनतेयगतिः परा।\nवैनतेयाच्च नो जन्म सर्वेषां वानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000330030, "chapter_id": 9330, "verse_number": "४-५८-३०", "content_sanskrit": "गर्हितं तु कृतं कर्म येन स्म पिशिताशिनः।\nप्रतिकार्यं च मे तस्य वैरं भ्रातृकृतं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000330031, "chapter_id": 9330, "verse_number": "४-५८-३१", "content_sanskrit": "इहस्थोऽहं प्रपश्यामि रावणं जानकीं तथा।\nअस्माकमपि सौपर्णं दिव्यं चक्षुर्बलं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000330032, "chapter_id": 9330, "verse_number": "४-५८-३२", "content_sanskrit": "तस्मादाहारवीर्येण निसर्गेण च वानराः।\nआयोजनशतात् साग्राद् वयं पश्याम नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000330033, "chapter_id": 9330, "verse_number": "४-५८-३३", "content_sanskrit": "अस्माकं विहिता वृत्तिर्निसर्गेण च दूरतः।\nविहिता वृक्षमूले तु वृत्तिश्चरणयोधिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000330034, "chapter_id": 9330, "verse_number": "४-५८-३४", "content_sanskrit": "उपायो दृश्यतां कश्चिल्लङ्घने लवणाम्भसः।\nअभिगम्य तु वैदेहीं समृद्धार्था गमिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000330035, "chapter_id": 9330, "verse_number": "४-५८-३५", "content_sanskrit": "समुद्रं नेतुमिच्छामि भवद्भिर्वरुणालयम्।\nप्रदास्याम्युदकं भ्रातुः स्वर्गतस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000330036, "chapter_id": 9330, "verse_number": "४-५८-३६", "content_sanskrit": "ततो नीत्वा तु तं देशं तीरे नदनदीपतेः।\nनिर्दग्धपक्षं सम्पातिं वानराः सुमहौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000330037, "chapter_id": 9330, "verse_number": "४-५८-३७", "content_sanskrit": "तं पुनः प्रापयित्वा च तं देशं पतगेश्वरम्।\nबभूवुर्वानरा हृष्टाः प्रवृत्तिमुपलभ्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000330038, "chapter_id": 9330, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]