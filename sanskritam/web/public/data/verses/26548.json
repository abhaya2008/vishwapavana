[{"id": 7006548000, "chapter_id": 26548, "verse_number": "३-८७-१", "content_sanskrit": "भगवता श्रीकृष्णेन महादेवस्य स्तुतिः वैशम्पायन उवाच एवं बहुविधैर्भूतैः पिशाचैरुरगैः सह ।\nआगत्य भगवान् रुद्रः शंकरो वृषवाहनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006548001, "chapter_id": 26548, "verse_number": "३-८७-२", "content_sanskrit": "ददर्श विष्णुं देवेशं तपन्तं तप उत्तमम् ।\nजुह्वानमग्निं विधिवद् द्रव्यैर्मेध्यैर्जगत्पतिम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006548002, "chapter_id": 26548, "verse_number": "३-८७-३", "content_sanskrit": "गरुडाहृतकाष्ठं तु जटिलं चीरवाससम् ।\nचक्रेणानीतकुसुमं खड्गानीतकुशं तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006548003, "chapter_id": 26548, "verse_number": "३-८७-४", "content_sanskrit": "गदाकृतसमाचारं देवदेवं जनार्दनम् ।\nइन्द्राद्यैर्देवसंघैश्च वृतं मुनिगणैः सह ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006548004, "chapter_id": 26548, "verse_number": "३-८७-५", "content_sanskrit": "अचिन्त्यं सर्वभूतानां ध्यायन्तं किमपि प्रभुम् ।\nअवरुह्य वृषाच्छर्वो भगवान् भूतभावनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006548005, "chapter_id": 26548, "verse_number": "३-८७-६", "content_sanskrit": "ततः प्रीतः प्रसन्नात्मा ललाटाक्ष उमापतिः ।\nततो भूतपिशाचाश्च राक्षसा गुह्यकास्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006548006, "chapter_id": 26548, "verse_number": "३-८७-७", "content_sanskrit": "मुनयो विप्रवर्याश्च जयशब्दं प्रचक्रिरे ।\nजय देव जगन्नाथ जय रुद्र जनार्दन ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006548007, "chapter_id": 26548, "verse_number": "३-८७-८", "content_sanskrit": "जय विष्णो हृषीकेश नारायण परायण ।\nजय रुद्र पुराणात्मञ्जय देव हरेश्वर ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006548008, "chapter_id": 26548, "verse_number": "३-८७-९", "content_sanskrit": "आदिदेव जगन्नाथ जय शंकर भावन ।\nजय कौस्तुभदीप्ताङ्ग जय भस्मविराजित ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006548009, "chapter_id": 26548, "verse_number": "३-८७-१०", "content_sanskrit": "जय चक्रगदापाणे जय शूलिंस्त्रिलोचन ।\nजय मौक्तिकदीप्ताङ्ग जय नागविभूषण ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006548010, "chapter_id": 26548, "verse_number": "३-८७-११", "content_sanskrit": "इति ते मुनयः सर्वे प्रणामं चक्रिरे हरिम् ।\nतत उत्थाय भगवान् दृष्ट्वा देवमवस्थितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006548011, "chapter_id": 26548, "verse_number": "३-८७-१२", "content_sanskrit": "वृषध्वजं विरूपाक्षं शंकरं नीललोहितम् ।\nततो हृष्टमना विष्णुस्तुष्टाव हरमीश्वरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006548012, "chapter_id": 26548, "verse_number": "३-८७-१३", "content_sanskrit": "श्रीभगवानुवाच नमस्ते शितिकण्ठाय नीलग्रीवाय वेधसे ।\nनमस्ते शोचिषे अस्तु नमस्ते उपवासिने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006548013, "chapter_id": 26548, "verse_number": "३-८७-१४", "content_sanskrit": "नमस्ते मीढुषे अस्तु नमस्ते गदिने हर ।\nनमस्ते विश्वतनवे वृषाय वृषरूपिणे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006548014, "chapter_id": 26548, "verse_number": "३-८७-१५", "content_sanskrit": "अमूर्ताय च देवाय नमन्तेऽस्तु पिनाकिने ।\nनमः कुब्जाय कूपाय शिवाय शिवरूपिणे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006548015, "chapter_id": 26548, "verse_number": "३-८७-१६", "content_sanskrit": "नमस्तुष्टाय तुण्डाय नमस्तुटितुटाय च ।\nनमः शिवाय शान्ताय गिरिशाय च ते नमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006548016, "chapter_id": 26548, "verse_number": "३-८७-१७", "content_sanskrit": "नमो हराय हिप्राय नमो हरिहराय च ।\nनमोऽघोराय घोराय घोराघोरप्रियाय च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006548017, "chapter_id": 26548, "verse_number": "३-८७-१८", "content_sanskrit": "नमोऽघण्टाय घण्टाय नमो घटिघटाय च ।\nनमः शिवाय शान्ताय गिरिशाय च ते नमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006548018, "chapter_id": 26548, "verse_number": "३-८७-१९", "content_sanskrit": "नमो विरूपरूपाय पुराय पुरहारिणे ।\nनम आद्याय बीजाय शुचयेऽष्टस्वरूपिणे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006548019, "chapter_id": 26548, "verse_number": "३-८७-२०", "content_sanskrit": "नमः पिनाकहस्ताय नमः शूलासिधारिणे ।\nनमः खट्वाङ्गहस्ताय नमस्ते कृत्तिवाससे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006548020, "chapter_id": 26548, "verse_number": "३-८७-२१", "content_sanskrit": "नमस्ते देवदेवाय नम आकाशमूर्तये ।\nहराय हरिरूपाय नमस्ते तिग्मतेजसे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006548021, "chapter_id": 26548, "verse_number": "३-८७-२२", "content_sanskrit": "भक्तप्रियाय भक्ताय भक्तानां वरदायिने ।\nनमोऽभ्रमूर्तये देव जगन्मूर्तिधराय च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006548022, "chapter_id": 26548, "verse_number": "३-८७-२३", "content_sanskrit": "नमश्चन्द्राय देवाय सूर्याय च नमो नमः । नमः प्रधानदेवाय भूतानां पतये नमः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006548023, "chapter_id": 26548, "verse_number": "३-८७-२४", "content_sanskrit": "करालाय च मुण्डाय विकृताय कपर्दिने ।\nअजाय च नमस्तुभ्यं भूतभावनभावन ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006548024, "chapter_id": 26548, "verse_number": "३-८७-२५", "content_sanskrit": "नमोऽस्तु हरिकेशाय पिंगलाय नमो नमः ।\nनमस्तेऽभीषुहस्ताय भीरुभीरुहराय च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006548025, "chapter_id": 26548, "verse_number": "३-८७-२६", "content_sanskrit": "हराय भीतिरूपाय घोराणां भीतिदायिने ।\nनमो दक्षमखघ्नाय भगनेत्रापहारिणे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006548026, "chapter_id": 26548, "verse_number": "३-८७-२७", "content_sanskrit": "उमापते नमस्तुभ्यं कैलासनिलयाय च ।\nआदिदेवाय देवाय भवाय भवरूपिणे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006548027, "chapter_id": 26548, "verse_number": "३-८७-२८", "content_sanskrit": "नमः कपालहस्ताय नमोऽजमथनाय च ।\nत्र्यम्बकाय नमस्तुभ्यं त्र्यक्षाय च शिवाय च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006548028, "chapter_id": 26548, "verse_number": "३-८७-२९", "content_sanskrit": "वरदाय वरेण्याय नमस्ते चन्द्रशेखर ।\nनम इध्माय हविषे ध्रुवाय च कृशाय च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006548029, "chapter_id": 26548, "verse_number": "३-८७-३०", "content_sanskrit": "नमस्ते शक्तियुक्ताय नागपाशप्रियाय च ।\nविरूपाय सुरूपाय भद्रपानप्रियाय च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006548030, "chapter_id": 26548, "verse_number": "३-८७-३१", "content_sanskrit": "श्मशानरतये नित्यं जयशब्दप्रियाय च ।\nस्वरप्रियाय खर्वाय खराय खररूपिणे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006548031, "chapter_id": 26548, "verse_number": "३-८७-३२", "content_sanskrit": "भद्रप्रियाय भद्राय भद्ररूपधराय च ।\nविरूपाय सुरूपाय महाघोराय ते नमः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006548032, "chapter_id": 26548, "verse_number": "३-८७-३३", "content_sanskrit": "घण्टाय घण्टभूषाय घण्टभूषणभूषिणे ।\nतीव्राय तीव्ररूपाय तीव्ररूपप्रियाय च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006548033, "chapter_id": 26548, "verse_number": "३-८७-३४", "content_sanskrit": "नग्नाय नग्नरूपाय नग्नरूपप्रियाय च ।\nभूतावास नमस्तुभ्यं सर्वावास नमो नमः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006548034, "chapter_id": 26548, "verse_number": "३-८७-३५", "content_sanskrit": "नमः सर्वात्मने तुभ्यं नमस्ते भूतिदायक ।\nनमस्ते वामदेवाय महादेवाय ते नमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006548035, "chapter_id": 26548, "verse_number": "३-८७-३६", "content_sanskrit": "का नु वाक्स्तुतिरूपा ते को नु स्तोतुं प्रशक्नुयात् ।\nकस्य वा स्फुरते जिह्वा स्तुतौ स्तुतिमतां वर ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006548036, "chapter_id": 26548, "verse_number": "३-८७-३७", "content_sanskrit": "क्षमस्व भगवन् देव भक्तोऽहं त्राहि मां हर ।\nसर्वात्मन् सर्वभूतेश त्राहि मां सततं हर ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006548037, "chapter_id": 26548, "verse_number": "३-८७-३८", "content_sanskrit": "रक्ष देव जगन्नाथ लोकान् सर्वात्मना हर ।\nत्राहि भक्तान् सदा देव भक्तप्रिय सदा हर ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]