[{"id": 2016972, "chapter_id": 1355, "verse_number": "२-९६-१", "content_sanskrit": "जनमेजय उवाच॥\nअनुज्ञातांस्तान्विदित्वा सरत्नधनसञ्जयान्।\nपाण्डवान्धार्तराष्ट्राणां कथमासीन्मनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016973, "chapter_id": 1355, "verse_number": "२-९६-२x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016974, "chapter_id": 1355, "verse_number": "२-९६-२", "content_sanskrit": "अनुज्ञातांस्तान्विदित्वा धृतराष्ट्रेण धीमता।\nराजन्दुः शासनः क्षिप्रं जगाम भ्रातरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016975, "chapter_id": 1355, "verse_number": "२-९६-३", "content_sanskrit": "दुर्योधनं समासाद्य सामात्यं भरतर्षभ।\nदुःखार्तो भरतश्रेष्ठ इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016976, "chapter_id": 1355, "verse_number": "२-९६-४x", "content_sanskrit": "दुःशासन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016977, "chapter_id": 1355, "verse_number": "२-९६-४", "content_sanskrit": "दुःखेनैतत्समानीतं स्थविरो नाशयत्यसौ।\nशत्रुसाद्गमयद्द्रव्यं तद्बुध्यध्वं महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016978, "chapter_id": 1355, "verse_number": "२-९६-५", "content_sanskrit": "अथ दुर्योधनः कर्णः शकुनिश्चापि सौबलः।\nमिथः सङ्गम्य सहिताः पाण्डवान्प्रति मानिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016979, "chapter_id": 1355, "verse_number": "२-९६-६", "content_sanskrit": "वैचित्रवीर्यं राजानं धृतराष्ट्रं मनीषिणम्।\nअभिगम्य त्वरायुक्ताः श्लक्ष्णं वचनमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016980, "chapter_id": 1355, "verse_number": "२-९६-७x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016981, "chapter_id": 1355, "verse_number": "२-९६-७", "content_sanskrit": "न त्वयेदं श्रुतं राजन्यज्जगाद बृहस्पतिः।\nशक्रस्य नीतिं प्रवदन्विद्वान्देवपुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016982, "chapter_id": 1355, "verse_number": "२-९६-८", "content_sanskrit": "सर्वोपायैर्निहन्तव्याः शत्रवः शत्रुसूदन।\nपुरा युद्धाद्बलाद्वापि प्रकुर्वन्ति तवाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016983, "chapter_id": 1355, "verse_number": "२-९६-९", "content_sanskrit": "ते वयं पाण्डवधनैः सर्वान्सम्पूज्य पार्थिवान्।\nयदि तान्योधयिष्यामः किं वै निः परिहास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016984, "chapter_id": 1355, "verse_number": "२-९६-१०", "content_sanskrit": "अहीनाशीविषान्क्रुद्धान्नाशाय समुपस्थितान्।\nकृत्वा कण्ठे च पृष्ठे च कः समुत्स्रष्टुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016985, "chapter_id": 1355, "verse_number": "२-९६-११", "content_sanskrit": "आत्तशस्त्रा रथगताः कुपितास्तात पाण्डवाः।\nनिःशेषान्नः करिष्यन्ति क्रुद्धा ह्याशीविषा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016986, "chapter_id": 1355, "verse_number": "२-९६-१२", "content_sanskrit": "सन्नद्धो ह्यर्जुनो याति विधृत्य परमेषुधी।\nगाण्डीवं मुहुरादत्ते निःश्वसंश्च निरीक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016987, "chapter_id": 1355, "verse_number": "२-९६-१३", "content_sanskrit": "गदां गुर्वी समुद्यम्य त्वरितश्च वृकोदरः।\nस्वरथं योजयित्वाऽशु निर्यात इति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016988, "chapter_id": 1355, "verse_number": "२-९६-१४", "content_sanskrit": "नकुलः खह्गमादाय चर्म चाप्यर्धचन्द्रवत्।\nसहदेवश्च राजा च चक्रुराकारमिङ्गितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016989, "chapter_id": 1355, "verse_number": "२-९६-१५", "content_sanskrit": "ते त्वास्थाय रथान्सर्वे बहुशस्त्रपरिच्छदान्।\nअभिघ्नान्तो रथव्रातान्सेनायोगाय निर्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016990, "chapter_id": 1355, "verse_number": "२-९६-१६", "content_sanskrit": "न क्षंस्यन्ते तथाऽस्माभिर्जातु विप्रकृता हि ते।\nद्रौपद्याश्च परिक्लेशं कस्तेषां क्षन्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016991, "chapter_id": 1355, "verse_number": "२-९६-१७", "content_sanskrit": "न पश्यामि रणे क्रद्धुं बीभत्सुं प्रतिवारणम्।\nभीष्मो द्रोणश्च कर्णश्च द्रौणिश्च रथिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016992, "chapter_id": 1355, "verse_number": "२-९६-१८", "content_sanskrit": "कृपश्च वृषसेनश्च विकर्णश्च जयद्रथः।\nवाह्लीकः सोमदत्तश्च भूरिर्भूरिश्रवाः शलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016993, "chapter_id": 1355, "verse_number": "२-९६-१९", "content_sanskrit": "शकुनिः ससुतश्चैव नृपाश्चान्ये च कौरवाः।\nनैते सर्वे रणोद्युक्ताः पार्थं सोढुमशक्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016994, "chapter_id": 1355, "verse_number": "२-९६-२०", "content_sanskrit": "अर्जुनेन समो लोके नास्ति वीर्ये धनुर्धरः।\nयोऽर्जुनेनार्जुनस्तुल्यो द्विबाहुर्बहुबाहुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016995, "chapter_id": 1355, "verse_number": "२-९६-२१x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016996, "chapter_id": 1355, "verse_number": "२-९६-२१", "content_sanskrit": "कस्त्वयोक्तः पुमान्वीरो बीभत्सुसमविक्रमः।\nतं ये व्रूहि महावीर्यं श्रोतुमिच्छामि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016997, "chapter_id": 1355, "verse_number": "२-९६-२२x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016998, "chapter_id": 1355, "verse_number": "२-९६-२२", "content_sanskrit": "कार्तवीर्यस्य चरितं शृणु राजन्महात्मनः।\nअव्यक्तप्रभवो ब्रह्मा सर्वलोकपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016999, "chapter_id": 1355, "verse_number": "२-९६-२३", "content_sanskrit": "ब्रह्मणोऽत्रिः सुतो विद्वानत्रेः पुत्रो निशाकरः।\nसोमस्य तदु बुधः पुत्रो बुधस्य तु पुरूरवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017000, "chapter_id": 1355, "verse_number": "२-९६-२४", "content_sanskrit": "तस्याप्यध सुतोऽप्यायुरायोस्तु नहुषः सुतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017001, "chapter_id": 1355, "verse_number": "२-९६-३०", "content_sanskrit": "स चार्जुनोऽथ तेजस्वी तपः परमदुश्चरम्।\nदत्तमाराधयामास सोऽर्जुनोऽत्रिसुतं मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017002, "chapter_id": 1355, "verse_number": "२-९६-३१", "content_sanskrit": "तस्य दत्तो वरान्प्रादाच्चतुरः पार्थिवस्य वै।\nपूर्वं बाहुसहस्रं तु प्रार्थितः परमो वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017003, "chapter_id": 1355, "verse_number": "२-९६-३२", "content_sanskrit": "अधर्मे प्रीयमाणस्य सद्भिस्तत्र निवारणम्।\nधर्मेण पृथिवीं जित्वा धर्मेणैव हि रञ्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017004, "chapter_id": 1355, "verse_number": "२-९६-३३", "content_sanskrit": "सङ्ग्रामान्सुबहून्कृत्वा हत्वा चारीन्सहस्रशः।\nसङ्ग्रामे यतमानस्य वधश्चैवाधिकाद्रणै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017005, "chapter_id": 1355, "verse_number": "२-९६-३४", "content_sanskrit": "तस्य बाहुसहस्रं तु युध्यतः किल भारत।\nरथो ध्वजश्च सञ्जज्ञ इत्येवं मे श्रुतं परा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017006, "chapter_id": 1355, "verse_number": "२-९६-३५", "content_sanskrit": "तथेयं पृथिवी राजन्त्सप्तद्वीपा सपत्तना।\nससमुद्राकरा तात विधिनोग्रेण वै जिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017007, "chapter_id": 1355, "verse_number": "२-९६-३६", "content_sanskrit": "चार्जुनोऽथ तेजस्वी सप्तद्वीपेश्वरोऽभवत्।\nच राजा महायज्ञानाजहार महाबलः।\nप्रशशास महाबाहुर्महीं स च समा बहूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017008, "chapter_id": 1355, "verse_number": "२-९६-३७", "content_sanskrit": "ततोऽर्जुनः कदाचिद्वै राजन्माहिष्मतीपतिः।\nनर्मदां भरतश्रेष्ठं तां तु दारैर्ययौ सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017009, "chapter_id": 1355, "verse_number": "२-९६-३८", "content_sanskrit": "ततस्तां स नदीं गत्वा प्रविश्यन्तर्जले तदा।\nकर्तुं राजञ्जलक्रीडां ततो राजोपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017010, "chapter_id": 1355, "verse_number": "२-९६-३९", "content_sanskrit": "तस्मिन्नेव ततः काले रावमो राक्षसैः सह।\nलङ्काया ईश्वरस्तात तं देशं प्रययौ बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017011, "chapter_id": 1355, "verse_number": "२-९६-४०", "content_sanskrit": "ततस्तमर्जुनं दृष्ट्वा नर्मदायां दशाननः।\nनित्यं क्रोधपरो धीरो वरदानेन मोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017012, "chapter_id": 1355, "verse_number": "२-९६-४१", "content_sanskrit": "अभ्यघावत्सुसङ्क्रुद्धो महेन्द्रं शम्बरो यथा।\nअर्जुनोऽप्यथ तं दृष्ट्वा रावणं प्रत्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017013, "chapter_id": 1355, "verse_number": "२-९६-४२", "content_sanskrit": "ततस्तौ चक्रतुर्युद्धं रावणश्चार्जुनश्च वै।\nततस्तु दुर्जयं वीरं वरदानेन दर्पितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017014, "chapter_id": 1355, "verse_number": "२-९६-४३", "content_sanskrit": "राक्षसेन्द्रं मनुष्येन्द्रो जित्वा बध्वा रणे बलात्।\nबध्वा धनुर्ज्यया राजन्विवेशाथ पुरीं स्वकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017015, "chapter_id": 1355, "verse_number": "२-९६-४४", "content_sanskrit": "स तु तं बन्धितं श्रुत्वा पुलस्त्यो रावणं तदा।\nमोक्षयाणास बन्धाद्वै पुरे दृष्ट्वाऽर्जुनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017016, "chapter_id": 1355, "verse_number": "२-९६-४५", "content_sanskrit": "ततः कदाचित्तेजस्वी कार्तवीर्योर्जुनो बली।\nसमुद्रतीरं गत्वाथ विरचन्दर्पमोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017017, "chapter_id": 1355, "verse_number": "२-९६-४६", "content_sanskrit": "अवाकिरच्छितशरैः समुद्रं स तु भारत।\nतं समुद्रो नमस्कृत्य कृताञ्जलिरभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017018, "chapter_id": 1355, "verse_number": "२-९६-४७", "content_sanskrit": "आशुगान्वीर मा मुञ्च ब्रूहि किं करवाणि ते।\nमदाश्रयाणि सत्वानि त्वद्विसृष्टैर्महेषुभिः।\nबाध्यन्ते राजशार्दूल तेभ्यो देह्यभयं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017019, "chapter_id": 1355, "verse_number": "२-९६-४८x", "content_sanskrit": "अर्जुन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017020, "chapter_id": 1355, "verse_number": "२-९६-४८", "content_sanskrit": "देहि सिन्धुपते युद्धमद्यैव त्वरया मम।\nअथवा पीडयामि त्वां तस्मात्त्वं कुरु माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017021, "chapter_id": 1355, "verse_number": "२-९६-४९x", "content_sanskrit": "समुद्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017022, "chapter_id": 1355, "verse_number": "२-९६-४९", "content_sanskrit": "लोके राजन्महावीर्या बहवो निवसन्ति ये।\nतेषामेकेन राजेन्द्र कुरु युद्धं महाबल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2017023, "chapter_id": 1355, "verse_number": "२-९६-५०x", "content_sanskrit": "अर्जुन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2017024, "chapter_id": 1355, "verse_number": "२-९६-५०", "content_sanskrit": "मत्समो यदि सङ्ग्रामे वरायुधधरः क्वचित्।\nविद्यते तं ममाचक्ष्व यः समासेत मा मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2017025, "chapter_id": 1355, "verse_number": "२-९६-५१x", "content_sanskrit": "समुद्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2017026, "chapter_id": 1355, "verse_number": "२-९६-५१", "content_sanskrit": "महर्षिर्जमदग्निस्तु यदि राजन्परिश्रुतः।\nतस्य पुत्रो रणं दातुं यथावद्वै तवार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2017027, "chapter_id": 1355, "verse_number": "२-९६-५२x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2017028, "chapter_id": 1355, "verse_number": "२-९६-५२", "content_sanskrit": "समुद्रस्य वचः श्रुत्वा राजा माहिष्मतीपतिः।\nनारदस्य च वै पूर्वं क्रोधेन महता वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2017029, "chapter_id": 1355, "verse_number": "२-९६-५३", "content_sanskrit": "ततः प्रतिययौ शीघ्रं क्रोधेन सह भारत।\nस तमाश्रममागत्य काममेवान्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2017030, "chapter_id": 1355, "verse_number": "२-९६-५४", "content_sanskrit": "स कामं प्रतिकूलानि चकार सह बन्धुभिः।\nआयासं जनयामास रामस्य स महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2017031, "chapter_id": 1355, "verse_number": "२-९६-५५", "content_sanskrit": "ततस्तेजः प्रजज्वाल रामस्यामिततेजसः।\nप्रदहन्निव सैन्यानि रश्मिमानिव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2017032, "chapter_id": 1355, "verse_number": "२-९६-५६", "content_sanskrit": "अथ तौ चक्रतुर्युद्धं वृत्रवासवयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2017033, "chapter_id": 1355, "verse_number": "२-९६-५७", "content_sanskrit": "ततः परशुमादाय नृपं बाहुसहस्रिणम्।\nचिच्छेद सहसा रामो बहुशाखमिव द्रुमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2017034, "chapter_id": 1355, "verse_number": "२-९६-५८", "content_sanskrit": "तं हतं पतितं दृष्ट्वा समेतास्तस्य बान्धवाः।\nअसीनादाय शक्तीश्च रामं ते प्रत्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2017035, "chapter_id": 1355, "verse_number": "२-९६-५९", "content_sanskrit": "रामोऽपि रथमास्थाय धनुरायम्य सत्वरः।\nविसृजन्परमास्त्राणि व्यधमत्पार्थिवान्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2017036, "chapter_id": 1355, "verse_number": "२-९६-६०", "content_sanskrit": "ततस्तु क्षत्रिया राजञ्जामदग्न्यभयार्दिताः।\nविविशुर्गिरिदुर्गाणि मृगाः सिंहभयादिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2017037, "chapter_id": 1355, "verse_number": "२-९६-६१", "content_sanskrit": "तेषां स्वविहितं कर्म तद्भयान्नानुतिष्ठति।\nप्रजा वृषलतां प्राप्ता ब्राह्मणानामदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2017038, "chapter_id": 1355, "verse_number": "२-९६-६२", "content_sanskrit": "तथा च द्रविडाः काचाः पुण्डाश्च शबरैः सह।\nवृषलत्वं परिगता विच्छिन्नाः क्षत्रधर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2017039, "chapter_id": 1355, "verse_number": "२-९६-६३", "content_sanskrit": "ततस्तु हतवीरासु क्षत्रियासु पुनः पुनः।\nद्विजैरभ्युदितं क्षत्रं तानि रामो निहत्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2017040, "chapter_id": 1355, "verse_number": "२-९६-६४", "content_sanskrit": "ततस्त्रिस्मप्तमे याते रामं वागशरीरिणी।\nदिव्या प्रोवाच मधुरा सर्वलोकपरिश्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2017041, "chapter_id": 1355, "verse_number": "२-९६-६५", "content_sanskrit": "रामराम निवर्तस्व स्वगुणं नात्र पश्यसि।\nक्षत्रबन्धूनिमान्प्रामैर्विप्रयुज्य पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2017042, "chapter_id": 1355, "verse_number": "२-९६-६६", "content_sanskrit": "तथैव तं महात्मानमृचीकप्रमुखास्तथा।\nरामराम महावीर्य निवर्तस्वेत्यथाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2017043, "chapter_id": 1355, "verse_number": "२-९६-६७", "content_sanskrit": "पितुर्वधमसमृष्यंस्तु रामः प्रोवाच तानृषीन्।\nनार्हा हन्त भवन्तो मां निवारयितुमित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2017044, "chapter_id": 1355, "verse_number": "२-९६-६८x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2017045, "chapter_id": 1355, "verse_number": "२-९६-६८", "content_sanskrit": "नार्हसि क्षत्रबन्धूंस्त्वं निहन्तुं जयतां वर।\nन हि युक्तं त्वया तात ब्राह्मणेनसता नृपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2017046, "chapter_id": 1355, "verse_number": "२-९६-६९x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2017047, "chapter_id": 1355, "verse_number": "२-९६-६९", "content_sanskrit": "पितॄणां वचनं श्रुत्वा क्रोधं त्यक्त्वा स भार्गवः।\nअश्वमेधसहस्राणि नरमेधशतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2017048, "chapter_id": 1355, "verse_number": "२-९६-७०", "content_sanskrit": "इष्ट्वा सागरपर्यन्तां काश्यपाय ददौ महीम्।\nतेन रामेण सङ्ग्रामे तुल्यस्तात दयञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2017049, "chapter_id": 1355, "verse_number": "२-९६-७१", "content_sanskrit": "कार्तवीर्येण च रणे तुल्यः पार्थो न संशयः।\nरणे विक्रम्य राजेन्द्र पार्थं जेतुं न शक्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2017050, "chapter_id": 1355, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अनुद्यूतपर्वणि षण्णवतितमोऽध्यायः॥९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]