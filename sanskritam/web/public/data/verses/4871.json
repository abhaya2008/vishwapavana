[{"id": 2182602, "chapter_id": 4871, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182603, "chapter_id": 4871, "verse_number": "१", "content_sanskrit": "कथंविधं पुरं राजा स्वयमावस्तुमर्हति ।\nकृतं वा कारयित्वा वा तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182604, "chapter_id": 4871, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182605, "chapter_id": 4871, "verse_number": "२", "content_sanskrit": "यत्र कौन्तेय वस्तव्यं सपुत्रभ्रातृबन्धुना ।\nन्याय्यं तत्र परिप्रष्टुं गुप्तिं वृत्तिं च भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182606, "chapter_id": 4871, "verse_number": "३", "content_sanskrit": "तस्मात् ते वर्तयिष्यामि दुर्गकर्म विशेषतः ।\nश्रुत्वा तथा विधातव्यमनुष्ठेयं च यत्नतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182607, "chapter_id": 4871, "verse_number": "४", "content_sanskrit": "षड्विधं दुर्गमास्थाय पुराण्यथ निवेशयेत् ।\nसर्वसम्पत्प्रधानं यद् बाहुल्यं वापि सम्भवेत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182608, "chapter_id": 4871, "verse_number": "५", "content_sanskrit": "धन्वदुर्गं महीदुर्गं गिरिदुर्गं तथैव च ।\nमनुष्यदुर्गमब्दुर्गं वनदुर्गं च तानि षट्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182609, "chapter_id": 4871, "verse_number": "६", "content_sanskrit": "यत् पुरं दुर्गसम्पन्नं धान्यायुधसमन्वितम् ।\nदृढप्राकारपरिखं हस्त्यश्वरथसङ्कुलम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182610, "chapter_id": 4871, "verse_number": "७", "content_sanskrit": "विद्वांसः शिल्पिनो यत्र निचयाश्च सुसञ्चिताः ।\nधार्मिकाश्च जनो यत्र दाक्ष्यमुत्तममास्थिताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182611, "chapter_id": 4871, "verse_number": "८", "content_sanskrit": "ऊर्जस्विनरनागाश्वं चत्वरापणशोभितम् ।\nप्रसिद्धव्यवहारं च प्रशान्तमकुतोभयम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182612, "chapter_id": 4871, "verse_number": "९", "content_sanskrit": "सुप्रभं सानुनादं च सुप्रशस्तनिवेशनम् ।\nशूराढ्यजनसम्पन्नं ब्रह्मघोषानुनादितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182613, "chapter_id": 4871, "verse_number": "१०", "content_sanskrit": "समाजोत्सवसम्पन्नं सदापूजितदैवतम् ।\nवश्यामात्यबलो राजा तत्पुरं स्वयमावसेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182614, "chapter_id": 4871, "verse_number": "११", "content_sanskrit": "तत्र कोशं बलं मित्रं व्यवहारं च वर्धयेत् ।\nपुरे जनपदे चैव सर्वदोषान् निवर्तयेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182615, "chapter_id": 4871, "verse_number": "१२", "content_sanskrit": "भाण्डागारायुधागारान् प्रयत्नेनाभिवर्धयेत् ।\nनिचयान् वर्धयेत् सर्वांस्तथा यन्त्रगदागदान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182616, "chapter_id": 4871, "verse_number": "१३", "content_sanskrit": "काष्ठलोहतुषाङ्गारदारुशृङ्गास्थिवैणवान् ।\nमज्जास्नेहवसाक्षौद्रमौषधग्राममेव च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182617, "chapter_id": 4871, "verse_number": "१४", "content_sanskrit": "शणं सर्जरसं धान्यमायुधानि शरांस्तथा ।\nचर्म स्नायु तथा वेत्रं मुञ्जबल्वजधन्वनान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182618, "chapter_id": 4871, "verse_number": "१५", "content_sanskrit": "आशयाश्चोदपानाश्च प्रभूतसलिलाकराः ।\nनिरोद्धव्याः सदा राज्ञा क्षीरिणश्च महीरुहाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182619, "chapter_id": 4871, "verse_number": "१६", "content_sanskrit": "सत्कृताश्च प्रयत्नेन आचार्यर्त्विक्पुरोहिताः ।\nमहेष्वासाः स्थपतयः सांवत्सरचिकित्सकाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182620, "chapter_id": 4871, "verse_number": "१७", "content_sanskrit": "प्राज्ञा मेधाविनो दान्ता दक्षाः शूरा बहुश्रुताः ।\nकुलीनाः सत्त्वसम्पन्ना युक्ताः सर्वेषु कर्मसु\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182621, "chapter_id": 4871, "verse_number": "१८", "content_sanskrit": "पूजयेद्धार्मिकान् राजा निगृह्णीयादधार्मिकान् ।\nनियुञ्ज्याच्च प्रयत्नेन सर्ववर्णान् स्वकर्मसु\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182622, "chapter_id": 4871, "verse_number": "१९", "content_sanskrit": "बाह्यमाभ्यन्तरं चैव पौरजानपदं जनम् ।\nचारैः सुविदितं कृत्वा ततः कर्म प्रयोजयेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182623, "chapter_id": 4871, "verse_number": "२०", "content_sanskrit": "चारान् मन्त्रं च कोशं च मन्त्रं चैव विशेषतः ।\nअनुतिष्ठेत् स्वयं राजा सर्वं ह्यत्र प्रतिष्ठितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182624, "chapter_id": 4871, "verse_number": "२१", "content_sanskrit": "उदासीनारिमित्राणां सर्वमेव चिकीर्षितम् ।\nपुरे जनपदे चैव ज्ञातव्यं चारचक्षुषा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182625, "chapter_id": 4871, "verse_number": "२२", "content_sanskrit": "ततस्तथा विधातव्यं सर्वमेवाप्रमादतः ।\nभक्तान् पूजयता नित्यं द्विषतश्च निगृह्णता\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182626, "chapter_id": 4871, "verse_number": "२३", "content_sanskrit": "यष्टव्यं क्रतुभिर्नित्यं दातव्यं चाप्यपीडया ।\nप्रजानां रक्षणं कार्यं न कार्यं कर्म गर्हितम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2182627, "chapter_id": 4871, "verse_number": "२४", "content_sanskrit": "कृपणानाथवृद्धानां विधवानां च योषिताम् ।\nयोगक्षेमं च वृत्तिं च नित्यमेव प्रकल्पयेत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2182628, "chapter_id": 4871, "verse_number": "२५", "content_sanskrit": "आश्रमेषु यथाकालं चेलभाजनभोजनम् ।\nसदैवोपहरेद् राजा सत्कृत्यानवमन्य च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2182629, "chapter_id": 4871, "verse_number": "२६", "content_sanskrit": "आत्मानं सर्वकार्याणि तापसे राज्यमेव च ।\nनिवेदयेत् प्रयत्नेन तिष्ठेत् प्रह्वश्च सर्वदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2182630, "chapter_id": 4871, "verse_number": "२७", "content_sanskrit": "सर्वार्थत्यागिनं राजा कुले जातं बहुश्रुतम् ।\nपूजयेत् तादृशं दृष्ट्वा शयनासनभोजनैः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2182631, "chapter_id": 4871, "verse_number": "२८", "content_sanskrit": "तस्मिन् कुर्वीत विश्वासं राजा कस्यांचिदापदि ।\nतापसेषु हि विश्वासमपि कुर्वन्ति दस्यवः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2182632, "chapter_id": 4871, "verse_number": "२९", "content_sanskrit": "तस्मिन् निधीनादधीत प्रज्ञां पर्याददीत च ।\nनचाप्यभीक्ष्णं सेवेत भृशं वा प्रतिपूजयेत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2182633, "chapter_id": 4871, "verse_number": "३०", "content_sanskrit": "अन्यः कार्यः स्वराष्ट्रेषु परराष्ट्रेषु चापरः ।\nअटवीष्वपरः कार्यः सामन्तनगरेषु च\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2182634, "chapter_id": 4871, "verse_number": "३१", "content_sanskrit": "तेषु सत्कारसंस्कारान् संविभागांश्च कारयेत् ।\nपरराष्ट्राटवीस्थेषु यथा स्वविषये तथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2182635, "chapter_id": 4871, "verse_number": "३२", "content_sanskrit": "ते कस्याञ्चिदवस्थायां शरणं शरणार्थिने ।\nराज्ञे दद्युर्यथाकामं तापसाः संशितव्रताः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2182636, "chapter_id": 4871, "verse_number": "३३", "content_sanskrit": "एष ते लक्षणोद्देशः सङ्क्षेपेण प्रकीर्तितः ।\nयादृशं नगरं राजा स्वयमावस्तुमर्हति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2182637, "chapter_id": 4871, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे अष्टाशीतितमोऽध्यायः ॥ ८८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]