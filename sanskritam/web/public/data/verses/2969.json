[{"id": 2092554, "chapter_id": 2969, "verse_number": "१३-९९-१", "content_sanskrit": "युधिष्ठिर उवाच।\nश्रुतं मे भवतो वाक्यमन्नदानस्य यो विधिः।\nनक्षत्रयोगस्येदानीं दानकल्पं ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092555, "chapter_id": 2969, "verse_number": "१३-९९-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092556, "chapter_id": 2969, "verse_number": "१३-९९-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरानम्।\nदेवक्याश्चैव संवादं समर्षेर्नारदस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092557, "chapter_id": 2969, "verse_number": "१३-९९-३", "content_sanskrit": "द्वारकामनुसम्प्राप्तं नारदं देवदर्शनम्।\nपप्रच्छेदं वचः प्रश्नं देवकी धर्मदर्शिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092558, "chapter_id": 2969, "verse_number": "१३-९९-४", "content_sanskrit": "तस्याः सम्पृच्छमानाया देवर्षिर्नारदस्ततः।\nआचष्ट विधइवत्सर्वं तच्छृणुष्व विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092559, "chapter_id": 2969, "verse_number": "१३-९९-५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092560, "chapter_id": 2969, "verse_number": "१३-९९-५", "content_sanskrit": "कृत्तिकासु महाभागे पायसेन ससर्पिषा।\nसन्तर्प्य ब्राह्मणान्साधूँल्लोकानाप्नोत्यनुत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092561, "chapter_id": 2969, "verse_number": "१३-९९-६", "content_sanskrit": "रोहिण्यां प्रसृतैर्मार्गैर्मांसैरन्नेन सर्पिषा।\nपयोऽन्नपानं दातव्यमनृणार्थं द्विजातये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092562, "chapter_id": 2969, "verse_number": "१३-९९-७", "content_sanskrit": "दोग्ध्रीं दत्त्वा सवत्सां तु नक्षत्रे सोमदैवते।\nगच्छन्ति मानुपाल्लोकात्स्वर्गलोकमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092563, "chapter_id": 2969, "verse_number": "१३-९९-८", "content_sanskrit": "आर्द्रायां कृसरं दत्त्वा तिलभिश्रमुपोषितः।\nनरस्तरति दुर्गाणि क्षुरधारांश्च पर्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092564, "chapter_id": 2969, "verse_number": "१३-९९-९", "content_sanskrit": "पूपान्पुनर्वसौ दत्त्वा तथैवान्नानि शोभने।\nयशस्वी रूपसम्पन्नो बह्वन्नो जायते कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092565, "chapter_id": 2969, "verse_number": "१३-९९-१०", "content_sanskrit": "पुण्येण कनकं दत्त्वा कृतं वाऽकृतमेव च।\nअनालोकेषु लोकेषु सोमवत्स विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092566, "chapter_id": 2969, "verse_number": "१३-९९-११", "content_sanskrit": "आश्लेषायां तु यो रूप्यमृषभं वा प्रयच्छति।\nस सर्पभयनिर्मुक्तः सम्भवानधितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092567, "chapter_id": 2969, "verse_number": "१३-९९-१२", "content_sanskrit": "मघासु तिलपूर्णानि वर्धमानानि मानवः।\nप्रदाय पुत्रपशुमानिह प्रेत्य च मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092568, "chapter_id": 2969, "verse_number": "१३-९९-१३", "content_sanskrit": "फल्गुनीपूर्वसमये ब्राह्मणानामुपोषितः।\nभक्ष्यान्फाणितसंयुक्तान्दत्त्वा सौभाग्यमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092569, "chapter_id": 2969, "verse_number": "१३-९९-१४", "content_sanskrit": "घृतक्षीरसमायुक्तं विधिवत्षष्टिकौदनम्।\nउत्तराविषये दत्त्वा स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092570, "chapter_id": 2969, "verse_number": "१३-९९-१५", "content_sanskrit": "यद्यत्प्रदीयते दानमुत्तराविषये नरैः।\nमहाफलमनन्तं तद्भवतीति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092571, "chapter_id": 2969, "verse_number": "१३-९९-१६", "content_sanskrit": "हस्ते हस्तिरथं दत्त्वा चतुर्युक्तमुपोषितः।\nप्राप्नोति परमाँल्लोकान्पुण्यकामसमन्वितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092572, "chapter_id": 2969, "verse_number": "१३-९९-१७", "content_sanskrit": "चित्रायां वृषभं दत्त्वा पुण्यगन्धांश्च भारत।\nचरन्त्यप्सरसां लोके रमन्ते नन्दने तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092573, "chapter_id": 2969, "verse_number": "१३-९९-१८", "content_sanskrit": "स्वात्यामथ धनं दत्त्वा यदिष्टतममात्मनः।i\nप्राप्नोति लोकान्स शुभानिह चैव महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092574, "chapter_id": 2969, "verse_number": "१३-९९-१९", "content_sanskrit": "विशाखायामनड्वाहं धेनुं दत्त्वा च दुग्धदाम्।\nसप्रासङ्गं च शकटं सधान्यं वस्त्रसंयुतम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092575, "chapter_id": 2969, "verse_number": "१३-९९-२०", "content_sanskrit": "पितॄन्देवांश्च प्रीणाति प्रेत्य चानन्त्यमश्नुते।\nन च दुर्गाण्यवाप्नोति स्वर्गलोकं च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092576, "chapter_id": 2969, "verse_number": "१३-९९-२१", "content_sanskrit": "दत्त्वा यथोक्तं विप्रेभ्यो वृत्तिमिष्टां स विन्दति।\nनरकादींश्च संक्लेशान्नाप्नोतीति विनिश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092577, "chapter_id": 2969, "verse_number": "१३-९९-२२", "content_sanskrit": "अनुराधासु प्रावरं वरान्नं समुपोषितः।\nदत्त्वा युगशतं चापि नरः स्वर्गे महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092578, "chapter_id": 2969, "verse_number": "१३-९९-२३", "content_sanskrit": "कालशाकं तु विप्रेभ्यो दत्त्वा मर्त्यः समूलकम्।\nज्येष्ठायामृद्धिमिष्टां वै गतिमिष्टां स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092579, "chapter_id": 2969, "verse_number": "१३-९९-२४", "content_sanskrit": "मूले मूलफलं दत्त्वा ब्राह्मणेभ्यः समाहितः।\nपितॄन्प्रीणयते चापि गतिमिष्टां च गच्छति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092580, "chapter_id": 2969, "verse_number": "१३-९९-२५", "content_sanskrit": "अथ पूर्वास्वषाढासु दधिपात्राण्युपोषितः।\nकुलवृत्तोपसम्पन्ने ब्राह्मणे वेदपारगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092581, "chapter_id": 2969, "verse_number": "१३-९९-२६", "content_sanskrit": "प्रदाय जायते प्रेत्य कुले सुबहुगोधने।\nउदमन्थं ससर्पिष्कं प्रभूतमधुफाणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092582, "chapter_id": 2969, "verse_number": "१३-९९-२७", "content_sanskrit": "दत्त्वोत्तरास्वषाढासु सर्वकामानवाप्नुयात्।\nदुग्धं त्वभिजिते योगे दत्त्वा मधुघृतप्लुतम्।\nधर्मनित्यो मनीषिभ्यः स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092583, "chapter_id": 2969, "verse_number": "१३-९९-२८", "content_sanskrit": "श्रवणे कम्बलं दत्त्वा वस्त्रान्तरितमेव वा।\nश्वेतेन याति यानेन स्वर्गलोकानसंवृतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092584, "chapter_id": 2969, "verse_number": "१३-९९-२९", "content_sanskrit": "गोप्रयुक्तं धनिष्ठासु यानं दत्त्वा समाहितः।\nवस्त्रराशिधनं सद्यः प्रेत्य राज्यं प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092585, "chapter_id": 2969, "verse_number": "१३-९९-३०", "content_sanskrit": "गन्धाञ्शतभिषग्योगे दत्त्वा सागरुचन्दनान्।\nप्राप्नोत्यप्सरसां सङ्घान्प्रेत्य गन्धांश्च शाश्वतान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092586, "chapter_id": 2969, "verse_number": "१३-९९-३१", "content_sanskrit": "पूर्वप्रोष्ठपदायोगे राजमाषान्प्रदाय तु।\nसर्वभक्षफलोपेतः स वै प्रेत्य सुखी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092587, "chapter_id": 2969, "verse_number": "१३-९९-३२", "content_sanskrit": "औरभ्रमुत्तरायोगे यस्तु मांसं प्रयच्छति।\nस पितॄन्प्रीणयति वै प्रेत्य चानन्त्यमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092588, "chapter_id": 2969, "verse_number": "१३-९९-३३", "content_sanskrit": "कांस्योपदोहनां धेनु रेवत्यां यः प्रयच्छति।\nसा प्रेत्य कामानादाय दातारमुपतिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092589, "chapter_id": 2969, "verse_number": "१३-९९-३४", "content_sanskrit": "रथमश्वसमायुक्तं दत्त्वाऽश्विन्यां नरोत्तमः।\nहस्त्यश्वरथसम्पन्ने वर्चस्वी जायते कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092590, "chapter_id": 2969, "verse_number": "१३-९९-३५", "content_sanskrit": "भरणीषु द्विजातिभ्यस्तिलधेनुं प्रदाय वै।\nगाः सुप्रभूताः प्राप्नोति नरः प्रेत्य यशस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092591, "chapter_id": 2969, "verse_number": "१३-९९-३६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092592, "chapter_id": 2969, "verse_number": "१३-९९-३६", "content_sanskrit": "इत्येष लक्षणोद्देशः प्रोक्तो नक्षत्रयोगतः।\nदेवक्या नारदेनेह सा स्नुषाभ्योऽब्रवीदिदम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092593, "chapter_id": 2969, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनशततमोऽध्यायः॥ ९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]