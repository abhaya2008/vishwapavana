[{"id": 6000278000, "chapter_id": 10278, "verse_number": null, "content_sanskrit": "अथ द्व्यशीतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000278001, "chapter_id": 10278, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.001.m4a", "display_order": 2}, {"id": 6000278002, "chapter_id": 10278, "verse_number": "१०-८२-१", "content_sanskrit": "एकदा तु सभामध्य आस्थितो मुनिभिर्वृतः।\nब्राह्मणैः क्षत्रियैर्वैश्यैर्भ्रातृभिश्च युधिष्ठिरः॥ १०/८२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.002.m4a", "display_order": 3, "topics": [{"text": "सभामध्ये युधिष्ठिरस्य क्रतुराजचिकीर्षोक्तिः", "range": "१–६"}]}, {"id": 6000278003, "chapter_id": 10278, "verse_number": "१०-८२-२", "content_sanskrit": "आचार्यैः कुलवृद्धैश्च ज्ञातिसम्बन्धिबान्धवैः।\nसर्वेषामेव चैतेषामाभाष्येदमुवाच ह॥ १०/८२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.003.m4a", "display_order": 4}, {"id": 6000278004, "chapter_id": 10278, "verse_number": null, "content_sanskrit": "युधिष्ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.004.m4a", "display_order": 5}, {"id": 6000278005, "chapter_id": 10278, "verse_number": "१०-८२-३", "content_sanskrit": "क्रतुराजेन गोविन्द राजसूयेन पावनीः।\nयक्ष्ये विभूतीर्भवतस्तत् सम्पादय नः प्रभो॥ १०/८२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.005.m4a", "display_order": 6}, {"id": 6000278006, "chapter_id": 10278, "verse_number": "१०-८२-४", "content_sanskrit": "त्वत्पादुके अविरतं परि ये चरन्ति ध्यायन्त्यभद्रनशने सुधियो गृणन्ति।\nविन्दन्ति ते कमलनाभ भवापवर्गमाशासते यदि त आशिष ईश नान्ये॥ १०/८२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.006.m4a", "display_order": 7}, {"id": 6000278007, "chapter_id": 10278, "verse_number": "१०-८२-५", "content_sanskrit": "तद् देवदेव भवतश्चरणारविन्दसेवानुभावमिह पश्यतु लोक एषः।\nये त्वां भजन्ति न भजन्त्युत वोभयेषां निष्ठां प्रदर्शय विभो कुरुसृञ्जयानाम्॥ १०/८२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.007.m4a", "display_order": 8}, {"id": 6000278008, "chapter_id": 10278, "verse_number": "१०-८२-६", "content_sanskrit": "न ब्रह्मणः स्वपरभेदमतिस्तव स्यात् सर्वात्मनः समदृशः स्वसुखानुभूतेः।\nसंसेवया सुरतरोरिव ते प्रसादः सेवानुरूप उदयो न विपर्ययोऽत्र॥ १०/८२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.008.m4a", "display_order": 9}, {"id": 6000278009, "chapter_id": 10278, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.009.m4a", "display_order": 10}, {"id": 6000278010, "chapter_id": 10278, "verse_number": "१०-८२-७", "content_sanskrit": "सम्यग् व्यवसितं राजन् भवता शत्रुकर्शन।\nकल्याणी येन ते कीर्तिर्लोकाननुभविष्यति॥ १०/८२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.010.m4a", "display_order": 11, "topics": [{"text": "कृष्णस्य तदनुमोदनम्", "range": "७–११"}]}, {"id": 6000278011, "chapter_id": 10278, "verse_number": "१०-८२-८", "content_sanskrit": "ऋषीणां पितृदेवानां सुहृदामपि नः प्रभो।\nसर्वेषामपि भूतानामीप्सितः क्रतुराडयम्॥ १०/८२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.011.m4a", "display_order": 12}, {"id": 6000278012, "chapter_id": 10278, "verse_number": "१०-८२-९", "content_sanskrit": "विजित्य नृपतीन् सर्वान् कृत्वा च जगतीं वशे।\nसम्भृत्य सर्वसम्भारानाहरस्व महाक्रतुम्॥ १०/८२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.012.m4a", "display_order": 13}, {"id": 6000278013, "chapter_id": 10278, "verse_number": "१०-८२-१०", "content_sanskrit": "एते तु भ्रातरो राजन् लोकपालांशसम्भवाः।\nवशेऽस्मि तव ताताहं दुर्जयो योऽकृतात्मभिः॥ १०/८२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.013.m4a", "display_order": 14}, {"id": 6000278014, "chapter_id": 10278, "verse_number": "१०-८२-११", "content_sanskrit": "न कश्चिन्मत्परं लोके तेजसा यशसा श्रिया।\nविभूतिभिर्नाभिभवेद् देवोऽपि किमु पार्थिवाः॥ १०/८२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.014.m4a", "display_order": 15}, {"id": 6000278015, "chapter_id": 10278, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.015.m4a", "display_order": 16}, {"id": 6000278016, "chapter_id": 10278, "verse_number": "१०-८२-१२", "content_sanskrit": "निशम्य भगवद्गीतं प्रीत्युत्फुल्लमुखाम्बुजः।\nभ्रातॄन् दिग्विजयेऽयुङ्क्त विष्णुतेजोपबंृहितान्॥ १०/८२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.016.m4a", "display_order": 17, "topics": [{"text": "पाण्टवानां दिग्विजयः, भीमार्जुनाभ्यां सह गत्वा जरासन्धघातनम्", "range": "१२–४६"}]}, {"id": 6000278017, "chapter_id": 10278, "verse_number": "१०-८२-१३", "content_sanskrit": "सहदेवं दक्षिणस्यामादिशत् सह सृञ्जयैः। दिशि प्रतीच्यां नकुलमुदीच्यां सव्यसाचिनम्।\nप्राच्यां वृकोदरं मत्स्यैः कैकयैः सह मद्रकैः॥ १०/८२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.017.m4a", "display_order": 18}, {"id": 6000278018, "chapter_id": 10278, "verse_number": "१०-८२-१४", "content_sanskrit": "ते विजित्य नृपान् वीरानाजह्रुर्दिव्यमञ्जसा।\nअजातशत्रवे भूरि द्रविणं नृप यक्ष्यते॥ १०/८२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.018.m4a", "display_order": 19}, {"id": 6000278019, "chapter_id": 10278, "verse_number": "१०-८२-१५", "content_sanskrit": "श्रुत्वाऽजितं जरासन्धं नृपतेर्ध्यायतो हरिः।\nआहोपायं तमेवाद्य उद्धवो यमुवाच ह॥ १०/८२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.019.m4a", "display_order": 20}, {"id": 6000278020, "chapter_id": 10278, "verse_number": "१०-८२-१६", "content_sanskrit": "भीमसेनोऽर्जुनः कृष्णो ब्रह्मलिङ्गधरास्ततः।\nजग्मुर्गिरिव्रजं तात बृहद्रथसुतो यतः॥ १०/८२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.020.m4a", "display_order": 21}, {"id": 6000278021, "chapter_id": 10278, "verse_number": "१०-८२-१७", "content_sanskrit": "तं गत्वाऽऽतिथ्यवेलायां गृहेषु गृहमेधिनाम्।\nब्रह्मण्यं समयाचन्त राजन्या ब्रह्मलिङ्गिनः॥ १०/८२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.021.m4a", "display_order": 22}, {"id": 6000278022, "chapter_id": 10278, "verse_number": "१०-८२-१८", "content_sanskrit": "राजन् विद्ध्यतिथीनस्मानर्थिनो गृहमागतान्।\nतन्नः प्रयच्छ भद्रं ते यद् वयं कामयामहे॥ १०/८२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.022.m4a", "display_order": 23}, {"id": 6000278023, "chapter_id": 10278, "verse_number": "१०-८२-१९", "content_sanskrit": "किं दुर्मर्षं तितिक्षूणां किमकार्यमसाधुभिः।\nकिं न देयं वदान्यानां कः परः समदर्शिनाम्॥ १०/८२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.023.m4a", "display_order": 24}, {"id": 6000278024, "chapter_id": 10278, "verse_number": "१०-८२-२०", "content_sanskrit": "योऽनित्येन शरीरेण सतां गेयं यशो ध्रुवम्।\nनाचिनोति स्वयं कल्पः स वाच्यः शोच्य एव सः॥ १०/८२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.024.m4a", "display_order": 25}, {"id": 6000278025, "chapter_id": 10278, "verse_number": "१०-८२-२१", "content_sanskrit": "हरिश्चन्द्रो रन्तिदेव उञ्छवृत्तिः शिबिर्बलिः।\nव्याधः कपोतो बहवो ह्यध्रुवेण ध्रुवं गताः॥ १०/८२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.025.m4a", "display_order": 26}, {"id": 6000278026, "chapter_id": 10278, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.026.m4a", "display_order": 27}, {"id": 6000278027, "chapter_id": 10278, "verse_number": "१०-८२-२२", "content_sanskrit": "स्वरैराकृतिभिस्तांस्तु प्रकोष्ठैर्ज्याहतैरपि।\nराजन्यबन्धून् विज्ञाय दृष्टपूर्वानचिन्तयत्॥ १०/८२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.027.m4a", "display_order": 28}, {"id": 6000278028, "chapter_id": 10278, "verse_number": "१०-८२-२३", "content_sanskrit": "राजन्यबन्धवो ह्येते ब्रह्मलिङ्गानि बिभ्रति।\nददामि भिक्षितं तेभ्य आत्मानमपि दुस्त्यजम्॥ १०/८२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.028.m4a", "display_order": 29}, {"id": 6000278029, "chapter_id": 10278, "verse_number": "१०-८२-२४", "content_sanskrit": "बलेर्नः श्रूयते कीर्तिर्वितता दिक्ष्वकल्मषा।\nऐश्वर्याद् भ्रंशितस्यापि विप्रव्याजेन विष्णुना॥ १०/८२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.029.m4a", "display_order": 30}, {"id": 6000278030, "chapter_id": 10278, "verse_number": "१०-८२-२५", "content_sanskrit": "श्रियं जिहीर्षतेन्द्रस्य विष्णवे द्विजरूपिणे।\nजानन्नपि महीं प्रादाद् वार्यमाणोऽपि दैत्यराट्॥ १०/८२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.030.m4a", "display_order": 31}, {"id": 6000278031, "chapter_id": 10278, "verse_number": "१०-८२-२६", "content_sanskrit": "जीवता ब्राह्मणार्थाय कोऽन्वर्थः क्षत्रबन्धुना।\nदेहेन पतमानेन नेहता विपुलं यशः॥ १०/८२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.031.m4a", "display_order": 32}, {"id": 6000278032, "chapter_id": 10278, "verse_number": "१०-८२-२७", "content_sanskrit": "इत्युदारमतिः प्राह कृष्णार्जुनवृकोदरान्।\nहे विप्रा व्रियतां कामो ददान्यात्मशिरोऽपि वः॥ १०/८२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.032.m4a", "display_order": 33}, {"id": 6000278033, "chapter_id": 10278, "verse_number": null, "content_sanskrit": "श्रीकृष्ण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.033.m4a", "display_order": 34}, {"id": 6000278034, "chapter_id": 10278, "verse_number": "१०-८२-२८", "content_sanskrit": "युद्धं नो देहि राजेन्द्र द्वन्द्वशो यदि मन्यसे।\nयुद्धार्थिनो वयं प्राप्ता राजन्या नान्नकाङ्क्षिणः॥ १०/८२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.034.m4a", "display_order": 35}, {"id": 6000278035, "chapter_id": 10278, "verse_number": "१०-८२-२९", "content_sanskrit": "असौ वृकोदरः पार्थस्तस्य भ्राताऽर्जुनो ह्ययम्।\nअनयोर्मातुलेयं मां कृष्णं जानीहि ते रिपुम्॥ १०/८२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.035.m4a", "display_order": 36}, {"id": 6000278036, "chapter_id": 10278, "verse_number": "१०-८२-३०", "content_sanskrit": "एवमावेदितो राजा जहासोच्चैः स मागधः।\nआह चामर्षितो मन्दो युद्धं तर्हि ददामि वः॥ १०/८२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.036.m4a", "display_order": 37}, {"id": 6000278037, "chapter_id": 10278, "verse_number": "१०-८२-३१", "content_sanskrit": "न त्वया भीरुणा योत्स्ये युधि विक्लवचेतसा।\nमधुरां स्वां पुरीं त्यक्त्वा समुद्रं शरणं गतः॥ १०/८२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.037.m4a", "display_order": 38}, {"id": 6000278038, "chapter_id": 10278, "verse_number": "१०-८२-३२", "content_sanskrit": "अयं तु वयसाऽतुल्यो नातिसत्त्वो न मे समः।\nअर्जुनो नो भवेद् योद्धा भीमस्तुल्यबलो मम॥ १०/८२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.038.m4a", "display_order": 39}, {"id": 6000278039, "chapter_id": 10278, "verse_number": "१०-८२-३३", "content_sanskrit": "इत्युक्त्वा भीमसेनाय दत्वा स महतीं गदाम्।\nद्वितीयां स्वयमादाय निर्जगाम पुराद् बहिः॥ १०/८२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.039.m4a", "display_order": 40}, {"id": 6000278040, "chapter_id": 10278, "verse_number": "१०-८२-३४", "content_sanskrit": "ततः समरबलेवीरौ संसक्तावितरेतरम्।\nजघ्नतुर्वज्रकल्पाभ्यां गदाभ्यां रणदुर्मदौ॥ १०/८२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.040.m4a", "display_order": 41}, {"id": 6000278041, "chapter_id": 10278, "verse_number": "१०-८२-३५", "content_sanskrit": "मण्डलानि विचित्राणि सव्यं दक्षिणमेव च।\nचरतोः शुशुभे युद्धं नटयोरिव रङ्गिणोः॥ १०/८२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.041.m4a", "display_order": 42}, {"id": 6000278042, "chapter_id": 10278, "verse_number": "१०-८२-३६", "content_sanskrit": "ततश्चटचटाशब्दो वज्रनिष्पेषसन्निभः।\nगदयोः क्षिप्तयो राजन् दन्तयोरिव दन्तिनोः॥ १०/८२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.042.m4a", "display_order": 43}, {"id": 6000278043, "chapter_id": 10278, "verse_number": "१०-८२-३७", "content_sanskrit": "ते वै गदे भुजजवेन निपात्यमाने अन्योन्ययोः सकटिपादकरोरुजत्रून्।\nचूर्णीबभूवतुरुपेत्य यथार्कशाखे संयुद्ध्यतोर्द्विरदयोरिव दीप्तसन्ध्योः॥ १०/८२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.043.m4a", "display_order": 44}, {"id": 6000278044, "chapter_id": 10278, "verse_number": "१०-८२-४०", "content_sanskrit": "शत्रोर्जन्ममृती विद्वान् जीवितं च जराकृतम्।\nपार्थमाप्याययन् स्वेन तेजसाऽचिन्तयद् हरिः॥ १०/८२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.044.m4a", "display_order": 45}, {"id": 6000278045, "chapter_id": 10278, "verse_number": "१०-८२-४१", "content_sanskrit": "सञ्चित्यारिवधोपायं भीमस्यामोघदर्शनः।\nदर्शयामास विटपं पाटयन्निव सञ्ज्ञया॥ १०/८२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.045.m4a", "display_order": 46}, {"id": 6000278046, "chapter_id": 10278, "verse_number": "१०-८२-४३", "content_sanskrit": "एकं पादं पदाऽऽक्रम्य दोर्भ्यामन्यं प्रगृह्य सः।\nगुदतः पाटयामास शाखामिव मतङ्गजः॥ १०/८२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.046.m4a", "display_order": 47}, {"id": 6000278047, "chapter_id": 10278, "verse_number": "१०-८२-४४", "content_sanskrit": "एकपादोरुवृषणकटिपृष्ठस्तनांसके।\nएकबाह्वक्षिभ्रूकर्णे शकले ददृशुः प्रजाः॥ १०/८२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.047.m4a", "display_order": 48}, {"id": 6000278048, "chapter_id": 10278, "verse_number": "१०-८२-४५", "content_sanskrit": "हाहाकारो महानासीन्निहते मागधेश्वरे।\nपूजयामासतुर्भीमं परिरभ्य जयाच्युतौ॥ १०/८२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.048.m4a", "display_order": 49}, {"id": 6000278049, "chapter_id": 10278, "verse_number": "१०-८२-४६", "content_sanskrit": "सहदेवं तत्तनयं भगवान् भूतभावनः। अभ्यषिञ्चदमेयात्मा मागधानां पतिं प्रभुः।\nमोचयामास राजन्यान् संरुद्धा मागधेन ये॥ १०/८२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_082/BhP_10.082.049.m4a", "display_order": 50}, {"id": 6000278050, "chapter_id": 10278, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे द्व्यशीतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]