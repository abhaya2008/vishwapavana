[{"id": 900008454, "chapter_id": 8636, "verse_number": "17.1", "content_sanskrit": "अत्र चक्षुरन्तस्स्थस्य ब्रह्मत्वे हेतूकृतामृतत्वाक्षेपेण ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008455, "chapter_id": 8636, "verse_number": "17.2", "content_sanskrit": "अत्र यदुक्तमुभाभ्यां जीवमात्रमन्तर्यामीत्येव पूर्वः पक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008456, "chapter_id": 8636, "verse_number": "17.3", "content_sanskrit": "सिद्धान्तस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008457, "chapter_id": 8636, "verse_number": "17.4", "content_sanskrit": "शरीरत्वस्य गौणत्वं च बृहदारण्यकभाष्य उक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008458, "chapter_id": 8636, "verse_number": "17.5", "content_sanskrit": "अत्र यद्यपि ‘‘आत्माविज्ञानमिति च सर्वजीवाभिमानवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008459, "chapter_id": 8636, "verse_number": "17.6", "content_sanskrit": "अन्ये तु शरीरादिराहित्याद्ब्रह्मणो न नियन्तृत्वं पटवदिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008460, "chapter_id": 8636, "verse_number": "17.7", "content_sanskrit": "यच्चोक्तमेकस्मिन् शरीरे प्रत्यग्द्वयं नेति तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008461, "chapter_id": 8636, "verse_number": "17.8", "content_sanskrit": "यच्चोक्तमुभाभ्यां आद्यसूत्रेऽधिदैवादिषु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]