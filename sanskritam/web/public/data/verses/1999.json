[{"id": 2044670, "chapter_id": 1999, "verse_number": "६-४८-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044671, "chapter_id": 1999, "verse_number": "६-४८-१", "content_sanskrit": "एवं श्वेते महेष्वासे प्राप्ते शल्यरथं प्रति।\nकुरवः पाण्डवेयाश्च किमकुर्वत सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044672, "chapter_id": 1999, "verse_number": "६-४८-२", "content_sanskrit": "भीष्मः शान्तनवः किं वा तन्ममाचक्ष्व पृच्छतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044673, "chapter_id": 1999, "verse_number": "६-४८-२x", "content_sanskrit": "सञ्जय उवाच।\nराजञ्शतसहस्राणि ततः क्षत्रियपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044674, "chapter_id": 1999, "verse_number": "६-४८-३", "content_sanskrit": "श्वेतं सेनापतिं शूरं पुरस्कृत्य महारथाः ।\nराज्ञो बलं दर्शयन्तस्तव पुत्रस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044675, "chapter_id": 1999, "verse_number": "६-४८-४", "content_sanskrit": "शिखण्डिनं पुरस्कृत्य त्रातुमैच्छन्महारथाः ।\nअभ्यवर्तन्त भीष्मस्य रथं हेमपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044676, "chapter_id": 1999, "verse_number": "६-४८-५", "content_sanskrit": "जिघांसन्तं युधांश्रेष्ठं तदासीत्तुमुलं महत् ।\nतत्तेऽहं संप्रवक्ष्यामि महावैशसमच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044677, "chapter_id": 1999, "verse_number": "६-४८-६", "content_sanskrit": "तावकानां परेषां च यथा युद्धमवर्तत ।\nतत्राकरोद्रथोपस्थाञ्शून्याञ्शान्तनवो बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044678, "chapter_id": 1999, "verse_number": "६-४८-७", "content_sanskrit": "तत्राद्भुतं महच्चक्रे शरैरार्च्छद्रथोत्तमान् ।\nसमावृणोच्छरैरर्कमर्कतुल्यप्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044679, "chapter_id": 1999, "verse_number": "६-४८-८", "content_sanskrit": "नुदन्समन्तात्समरे रविरुद्यन्यथा तमः ।\nतेनाजौ प्रेषिता राजञ्शराः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044680, "chapter_id": 1999, "verse_number": "६-४८-९", "content_sanskrit": "क्षत्रियान्तकराः सङ्ख्ये महावेगा महाबलाः ।\nशिरांसि पातयामासुर्वीराणां शतशो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044681, "chapter_id": 1999, "verse_number": "६-४८-१०", "content_sanskrit": "गजान्कण्टकसन्नाहान्वज्रेणेव शिलोच्चयान् ।\nरथा रथेषु संसक्ता व्यदृश्यन्त विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044682, "chapter_id": 1999, "verse_number": "६-४८-११", "content_sanskrit": "एके रथं पर्यवहंस्तुरगाः सतुरंगमम् ।\nयुवानं निहतं वीरं लम्बमानं सकार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044683, "chapter_id": 1999, "verse_number": "६-४८-१२", "content_sanskrit": "उदीर्णाश्च हया राजन्वहनक्तस्तत्रतत्र ह।\nबद्धस्वङ्गनिषङ्गाश्च विध्वस्तशिरसो हताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044684, "chapter_id": 1999, "verse_number": "६-४८-१३", "content_sanskrit": "शतशः पतिता भूमौ वीरशय्यासु शेरते ।\nपरस्पेरण धावन्तः पतिताः पुनरुत्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044685, "chapter_id": 1999, "verse_number": "६-४८-१४", "content_sanskrit": "उत्थाय च प्रधावन्तो द्वन्द्वयुद्धमवाप्नुवन् ।\nपीडिताः पुनरन्योन्यं लुठन्तो रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044686, "chapter_id": 1999, "verse_number": "६-४८-१५", "content_sanskrit": "सचापाः सनिषङ्गाश्च जातरूपपरिष्कृताः ।\nविस्रब्धहतवीराश्च शतशः परिपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044687, "chapter_id": 1999, "verse_number": "६-४८-१६", "content_sanskrit": "तेनतेनाभ्यधावन्त विसृजन्तश्च भारत ।\nमत्तो गजः पर्यवर्तद्धयांश्च हतसादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044688, "chapter_id": 1999, "verse_number": "६-४८-१७", "content_sanskrit": "सरथा रथिनश्चापि विमृद्गन्तः समन्ततः ।\nस्यान्दनादपतत्कश्चिन्निहतोऽन्येन सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044689, "chapter_id": 1999, "verse_number": "६-४८-१८", "content_sanskrit": "हतसारथिरप्युच्चैः पपात काष्ठवद्रथः ।\nयुध्यमानस्य संग्रामे व्यूढे रजसि चोत्थिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044690, "chapter_id": 1999, "verse_number": "६-४८-१९", "content_sanskrit": "धनुःकूजितविज्ञानं तत्रासीत्प्रतियुद्ध्यतः।\nगात्रस्पर्शेन योधानां व्यज्ञास्त परिपन्थिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044691, "chapter_id": 1999, "verse_number": "६-४८-२०", "content_sanskrit": "युद्ध्यमानं शरै राजन्सिञ्जिनीध्वजिनीरवात्।\nअन्योन्यं वीरसंशब्दो नाश्रूयत भटैः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044692, "chapter_id": 1999, "verse_number": "६-४८-२१", "content_sanskrit": "शब्दायमाने संग्रामे पटहे कर्णदारिणि।\nयुध्यमानस्य संग्रामे कुर्वतः पौरुषं स्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044693, "chapter_id": 1999, "verse_number": "६-४८-२२", "content_sanskrit": "नाश्रौषं नामगोत्राणि कीर्तनं च परस्परम् ।\nभीष्मचापच्युतैर्बाणैरार्तानां युध्यतां मृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044694, "chapter_id": 1999, "verse_number": "६-४८-२३", "content_sanskrit": "परस्परेषां वीराणां मनांसि समकम्पयन् ।\nतस्मिन्नत्याकुले युद्धे दारुणे रोमहर्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044695, "chapter_id": 1999, "verse_number": "६-४८-२४", "content_sanskrit": "पिता पुत्रं च समरे नाभिजानाति कश्चन ।\nचक्रे भग्ने युगे च्छिन्ने एकधुर्ये हये हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044696, "chapter_id": 1999, "verse_number": "६-४८-२५", "content_sanskrit": "आक्षिप्तः स्यन्दनाद्वीरः समारथिरजिह्मगैः।\nएवं च समरे सर्वे वीराश्च विरथीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044697, "chapter_id": 1999, "verse_number": "६-४८-२६", "content_sanskrit": "तेन तेन स्म दृश्यन्ते धावमानाः समंततः ।\nगजो हतः शिरश्छिन्नं मर्म भिन्नं हयो हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044698, "chapter_id": 1999, "verse_number": "६-४८-२७", "content_sanskrit": "अहतः कोपि नैवासीद्भीष्मे नघ्नति शात्रवान् ।\nश्वेतः कुरूणामकरोत्क्षयं तस्मिन्महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044699, "chapter_id": 1999, "verse_number": "६-४८-२८", "content_sanskrit": "राजपुत्रान्रथोदारानवधीच्छतसङ्घशः।\nचिच्छेद रथिनां बाणैः शिरांसि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044700, "chapter_id": 1999, "verse_number": "६-४८-२९", "content_sanskrit": "साङ्गदा बाहवश्चैव धनूंषि च समंततः।\nरथेषां रथचक्राणि तूणीराणि युगानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044701, "chapter_id": 1999, "verse_number": "६-४८-३०", "content_sanskrit": "छत्राणि च महार्हाणि पताकाश्च विशांपते।\nहयैघाश्च रथौघाश्च नरौघाश्चैव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044702, "chapter_id": 1999, "verse_number": "६-४८-३१", "content_sanskrit": "वारणाः शतशश्चैव हताः श्वेतेन भारत ।\nवयं श्वेतभयाद्भीता विहाय रथसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2044703, "chapter_id": 1999, "verse_number": "६-४८-३२", "content_sanskrit": "अपयातास्तथा पश्चाद्विभुं पश्याम धृष्णवः ।\nशरपातमतिक्रम्य कुरवः कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2044704, "chapter_id": 1999, "verse_number": "६-४८-३३", "content_sanskrit": "भीष्मं शान्तनवं युद्धे स्थिताः पश्याम सर्वशः ।\nअदीनो दीनसमये भीष्मोऽस्माकं महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2044705, "chapter_id": 1999, "verse_number": "६-४८-३४", "content_sanskrit": "एकस्तस्थौ नरव्याघ्रो गिरिर्मेरुरिवाचलः।\nआददान इव प्राणान्सविता शिशिरात्यये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2044706, "chapter_id": 1999, "verse_number": "६-४८-३५", "content_sanskrit": "गभस्तिभिरिवादित्यस्तस्थौ शरमरीचिमान्।\nस मुमोच महेष्वासः शरसङ्घाननेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2044707, "chapter_id": 1999, "verse_number": "६-४८-३६", "content_sanskrit": "निघ्नन्नमित्रान्समरे वज्रपाणिरिवासुरान् ।\nते वध्यमाना भीष्मेण प्रजहुस्तं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2044708, "chapter_id": 1999, "verse_number": "६-४८-३७", "content_sanskrit": "स्वयूथादिव ते यूथान्मुक्तं भूमिषु दारुणम् ।\nतमेवमुपलक्ष्यैको हृष्टः पुष्टः परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2044709, "chapter_id": 1999, "verse_number": "६-४८-३८", "content_sanskrit": "दुर्योधनप्रिये युक्तः पाण्डवान्परिशोचयन्।\nजीवितं दुस्त्यजं त्यक्त्वा भयं च सुमहाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2044710, "chapter_id": 1999, "verse_number": "६-४८-३९", "content_sanskrit": "पातयामास सैन्यानि पाण्डवानां विशांपते ।\nप्रहरन्तमनीकानि पिता देवव्रतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2044711, "chapter_id": 1999, "verse_number": "६-४८-४०", "content_sanskrit": "दृष्ट्वा सेनापतिं भीष्मस्त्वरितः श्वेतमभ्ययात्।\nस भीष्मं शरजालेन महता समवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2044712, "chapter_id": 1999, "verse_number": "६-४८-४१", "content_sanskrit": "श्वेतं चापि तथा भीष्मः शरौघैः समवाकिरत् ।\nतौ वृषाविव नर्दन्तौ मत्ताविव महाद्विपौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2044713, "chapter_id": 1999, "verse_number": "६-४८-४२", "content_sanskrit": "व्याघ्राविव सुसंरब्धावन्योन्यमभिजघ्नतुः ।\nअस्त्रैरस्त्राणि संवार्य ततस्तौ पुरुषर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2044714, "chapter_id": 1999, "verse_number": "६-४८-४३", "content_sanskrit": "भीष्मः श्वेतश्च युयुधे परस्परवधैषिणौ ।\nएकाह्ना निर्दहेद्भीष्मः पाम्डवानामनीकिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2044715, "chapter_id": 1999, "verse_number": "६-४८-४४", "content_sanskrit": "शरैः परमसंक्रुद्धो यदि श्वेतो न पालयेत्।\nपितामहं ततो दृष्ट्वा श्वेतो विमुखीकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2044716, "chapter_id": 1999, "verse_number": "६-४८-४५", "content_sanskrit": "प्रहर्षं पाण्डवा जग्मुः पुत्रस्ते विमनाभवत्।\nततो दुर्योधनः क्रुद्धः पार्थिवैः परिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2044717, "chapter_id": 1999, "verse_number": "६-४८-४६", "content_sanskrit": "ससैन्यः पाण्डवानीकमभ्यद्रवत संयुगे।\nदुर्मुखः कृतवर्मा च कृपः शल्यो विशांपतिःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2044718, "chapter_id": 1999, "verse_number": "६-४८-४७", "content_sanskrit": "भीष्मं जुगुपुरासाद्य तव पुत्रेण नोदिताः।\nदृष्ट्वा तु पार्थिवैः सर्वैर्दुर्योधनपुरोगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2044719, "chapter_id": 1999, "verse_number": "६-४८-४८", "content_sanskrit": "पाण्डवानामनीकानि वध्यमानानि संयुगे।\nश्वेतो गाङ्गेयमुत्सृज्य तव पुत्रस्य वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2044720, "chapter_id": 1999, "verse_number": "६-४८-४९", "content_sanskrit": "नाशयामास वेगेन वायुर्वृक्षानिवौजसा ।\nद्रावयित्वा चमूं राजन्वैराटिः क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2044721, "chapter_id": 1999, "verse_number": "६-४८-५०", "content_sanskrit": "आपतत्सहसा भूयो यत्र भीष्मो व्यवस्थितः ।\nतौ तत्रोपगतौ राजञ्शरदीप्तौ महाबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2044722, "chapter_id": 1999, "verse_number": "६-४८-५१", "content_sanskrit": "अयुध्येतां महात्मानौ यथोभौ वृत्रवासवौ ।\nअन्योन्यं तु महाराज परस्परवधैषिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2044723, "chapter_id": 1999, "verse_number": "६-४८-५२", "content_sanskrit": "निगृह्य कार्मुकं श्वेतो भीष्मं विव्याध सप्तभिः ।\nपराक्रमं ततस्तस्य पराक्रम्य पराक्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2044724, "chapter_id": 1999, "verse_number": "६-४८-५३", "content_sanskrit": "तरसा वारयामास मत्तो मत्तमिव द्विपम्।\nश्वेतः शान्तनवं भूयः शरैः सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2044725, "chapter_id": 1999, "verse_number": "६-४८-५४", "content_sanskrit": "विव्याध प़ञ्चविंशत्या तदद्भुतमिवाभवत्।\nतं प्रत्यविध्यद्दशभिर्भीष्मः शान्तनवस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2044726, "chapter_id": 1999, "verse_number": "६-४८-५५", "content_sanskrit": "स विद्धस्तेन बलवान्नाकम्पत यथाऽचलः ।\nवैराटिः समरे क्रुद्धो भृशमायम्य कार्मुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2044727, "chapter_id": 1999, "verse_number": "६-४८-५६", "content_sanskrit": "आजघान ततो भीष्मं श्वेतः क्षत्रियनन्दनः।\nसंप्रहस्य तत श्वेतः सृक्किणी परिसंलिहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2044728, "chapter_id": 1999, "verse_number": "६-४८-५७", "content_sanskrit": "घनुश्चिच्छेद भीष्मस्य नवभिर्दशधा शरैः ।\nसंधाय विशिखं चैव शरं लोमप्रवाहिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2044729, "chapter_id": 1999, "verse_number": "६-४८-५८", "content_sanskrit": "उन्ममाथ ततस्तालं ध्वजशीर्षं महात्मनः ।\nकेतुं निपतितं दृष्ट्वा भीष्मस्य तनयास्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2044730, "chapter_id": 1999, "verse_number": "६-४८-५९", "content_sanskrit": "हतं भीष्मममन्यन्त श्वेतस्य वशमागतम्।\nपाण्डवाश्चापि संहृष्टा दध्मुः शङ्खान्मुदा युताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2044731, "chapter_id": 1999, "verse_number": "६-४८-६०", "content_sanskrit": "भीष्मस्य पतितं केतुं दृष्ट्वा तालं महात्मनः ।\nततो दुर्योधनः क्रोधात्स्वमनीकमनोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2044732, "chapter_id": 1999, "verse_number": "६-४८-६१", "content_sanskrit": "यत्ता भीष्मं परीप्सध्वं रक्षमाणाः समंततः।\nमा नः प्रपश्यमानानां श्वेतान्मृत्युमवाप्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2044733, "chapter_id": 1999, "verse_number": "६-४८-६२", "content_sanskrit": "भीष्मः शान्तनवः शूरस्तथा सत्यं ब्रवीमि वः।\nराज्ञस्तु वचनं श्रत्वा त्वरमाणा महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2044734, "chapter_id": 1999, "verse_number": "६-४८-६३", "content_sanskrit": "बलेन चतुरङ्गेण गाङ्गेयप्रन्वपालयन्।\nबाह्लीकः कृतवर्मा च शलः शल्यश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2044735, "chapter_id": 1999, "verse_number": "६-४८-६४", "content_sanskrit": "जलसन्धो विकर्णश्च चित्रसेनो विविंशतिः।\nत्वरमाणास्त्वराकाले परिवार्य समंततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2044736, "chapter_id": 1999, "verse_number": "६-४८-६५", "content_sanskrit": "शस्त्रवृष्टिं सुतुमुलां श्वेतस्योपर्यपातयन्।\nतान्क्रुद्धो निशितैर्बाणैस्त्वरमाणो महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2044737, "chapter_id": 1999, "verse_number": "६-४८-६६", "content_sanskrit": "अवारयदमेयात्मा दर्शयन्पाणिलाघवम् ।\nस निवार्य तु तान्सर्वान्केसरी कुञ्जराविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2044738, "chapter_id": 1999, "verse_number": "६-४८-६७", "content_sanskrit": "महता शरवर्षेण भीष्मस्य धनुराच्छिनत्।\nततोऽन्यद्धनुरादाय भीष्मः शान्तनवो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2044739, "chapter_id": 1999, "verse_number": "६-४८-६८", "content_sanskrit": "श्वेतं विव्याध राजेन्द्र कङ्कपत्रैः शितैः शरैः ।\nततः सेनापतिः क्रुद्धो भीष्मं बहुभिरायसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2044740, "chapter_id": 1999, "verse_number": "६-४८-६९", "content_sanskrit": "विव्याध समरे राजन्सर्वलोकस्य पश्यतः ।\nततः प्रव्यथितो राजा भीष्मं दृष्ट्वा निवारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2044741, "chapter_id": 1999, "verse_number": "६-४८-७०", "content_sanskrit": "प्रवीरं सर्वलोकस्य श्वेतेन युधि वै तदा।\nनिष्ठानकश्च सुमहांस्तव सैन्यस्य चाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2044742, "chapter_id": 1999, "verse_number": "६-४८-७१", "content_sanskrit": "तं वीरं वारितं दृष्ट्वा श्वेतेन शरविक्षतम् ।\nहतं श्वेतेन मन्यन्ते श्वेतस्य वशमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2044743, "chapter_id": 1999, "verse_number": "६-४८-७२", "content_sanskrit": "ततः क्रोधवशं प्राप्तः पिता देवव्रतस्तव ।\nध्वजमुन्मतितं दृष्ट्वा तां च सेनां निवारिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2044744, "chapter_id": 1999, "verse_number": "६-४८-७३", "content_sanskrit": "श्वेतं प्रति महाराज व्यसृजत्प्तायकान्बहून् ।\nतानावार्य रणे श्वेतो भीष्मस्य रथिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2044745, "chapter_id": 1999, "verse_number": "६-४८-७४", "content_sanskrit": "धनुश्चिच्छेद भल्लेन पुनरेव पितुस्तव।\nउत्सृज्य कार्मुकं राजन्गाङ्गेयः क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2044746, "chapter_id": 1999, "verse_number": "६-४८-७५", "content_sanskrit": "अन्यत्कार्मुकमादाय विपुलं बलवत्तरम्।\nतत्र संधाय विपुलान्भल्लान्सप्त शिलाशितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2044747, "chapter_id": 1999, "verse_number": "६-४८-७६", "content_sanskrit": "चतुर्भिश्च जघानाश्वाञ्श्वेतस्य पृतनापतेः ।\nध्वजं द्वाभ्यां तु चिच्छेद सप्तमेन च सारथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2044748, "chapter_id": 1999, "verse_number": "६-४८-७७", "content_sanskrit": "शिरश्चिच्छेद भल्लेन संक्रुद्धोऽलघुविक्रमः ।\nहताश्वसूतात्सु रथादवप्लुत्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2044749, "chapter_id": 1999, "verse_number": "६-४८-७८", "content_sanskrit": "अमर्षवशमापन्नो व्याकुलः समपद्यत ।\nविरथं रथिनां श्रेष्ठं श्वेतं दृष्ट्वा पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2044750, "chapter_id": 1999, "verse_number": "६-४८-७९", "content_sanskrit": "ताडयामास निशितैः शरसङ्घैः समंततः ।\nस ताड्यमानः समरे भीष्मचापच्युतैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2044751, "chapter_id": 1999, "verse_number": "६-४८-८०", "content_sanskrit": "स्वरथे धनुरुत्सृज्य शक्तिं जग्राह काञ्चनीम् ।\nततः शक्तिं रणे श्वेतो जग्राहोग्रं महाभयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2044752, "chapter_id": 1999, "verse_number": "६-४८-८१", "content_sanskrit": "कालदण्डोपमां घोरां मृत्योर्जिह्वामेव श्वसन् ।\nअब्रवीच्च तदा श्वेतो भीष्मं शान्तनवं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2044753, "chapter_id": 1999, "verse_number": "६-४८-८२", "content_sanskrit": "तिष्ठेदानीं सुसंरब्धः पश्य मां पुरुषो भव।\nएवमुक्त्वा महेष्वासो भीष्मं युधि पराक्रमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2044754, "chapter_id": 1999, "verse_number": "६-४८-८३", "content_sanskrit": "ततः शक्तिममेयात्मा चिक्षेप भुजगोपमाम्।\nपाण्डवार्थे पराक्रान्तस्तवानर्थं चिकीर्षुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2044755, "chapter_id": 1999, "verse_number": "६-४८-८४", "content_sanskrit": "हाहाकारो महानासीत्पुत्राणां ते विशांपते ।\nदृष्ट्वा शक्तिं महाघोरां मृत्योर्दण्डसमप्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2044756, "chapter_id": 1999, "verse_number": "६-४८-८५", "content_sanskrit": "श्वेतस्य करनिर्मुक्तां निर्मुक्तोरगसन्निभाम् ।\nअपतत्सहसा राजन्महोल्केव नभस्तलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2044757, "chapter_id": 1999, "verse_number": "६-४८-८६", "content_sanskrit": "ज्वलन्तीमन्तरिक्षे तां ज्वालाभिरिव संवृताम् ।\nअसंभ्रान्तस्तदा राजन्पिता देवव्रतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2044758, "chapter_id": 1999, "verse_number": "६-४८-८७", "content_sanskrit": "अष्टभिर्नवभिर्भीष्मः शक्तिं चिच्छेद पत्रिभिः ।\nउत्कृष्टहेमविकृतां निकृतां निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2044759, "chapter_id": 1999, "verse_number": "६-४८-८८", "content_sanskrit": "उच्चुक्रुशुस्ततः सर्वे तावका भरतर्षभ ।\nशक्तिं विनिहतां दृष्ट्वा वैराटिः क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2044760, "chapter_id": 1999, "verse_number": "६-४८-८९", "content_sanskrit": "कालोपहतचेतास्तु कर्तवक्यं नाभ्यजानत।\nक्रोधसंमूर्च्छितो राजन्वैराटिः प्रहसन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2044761, "chapter_id": 1999, "verse_number": "६-४८-९०", "content_sanskrit": "गदां जग्राह संहृष्टो भीष्मस्य निधनं प्रति।\nक्रोधेन रक्तनयनो दण्डपाणिरिवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2044762, "chapter_id": 1999, "verse_number": "६-४८-९१", "content_sanskrit": "भीष्मं समिदुद्राव जलौघ इव पर्वतम्।\nतस्य वेगमसंवार्यं मत्वा भीष्मः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2044763, "chapter_id": 1999, "verse_number": "६-४८-९२", "content_sanskrit": "प्रहारविप्रमोक्षार्थं सहसा धरणींगतः।\nश्वेतः क्रोधसमाविष्टो भ्रामयित्वा तु तां गदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2044764, "chapter_id": 1999, "verse_number": "६-४८-९३", "content_sanskrit": "रथे भीष्मस्य चिक्षेप यथा देवो धनेश्वरः ।\nतया भीष्मनिपातिन्या स रथो भस्मसात्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2044765, "chapter_id": 1999, "verse_number": "६-४८-९४", "content_sanskrit": "सध्वजः सह सूतेन साश्वः सयुगबन्धुरः ।\nविरथं रथिनां श्रेष्ठं भीष्मं दृष्ट्वा रथोत्तमकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2044766, "chapter_id": 1999, "verse_number": "६-४८-९५", "content_sanskrit": "अभ्यधावन्त सहिताः शल्यप्रभृतयो रथाः।\nततोऽन्यं रथमास्थाय धनुर्विस्फार्य दुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2044767, "chapter_id": 1999, "verse_number": "६-४८-९६", "content_sanskrit": "शनकैरभ्यायाच्छ्वेतं गाङ्गेयः प्रहसन्निव।\nएतस्मिन्नन्तरे भीष्मः शुश्राव विपुलां गिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2044768, "chapter_id": 1999, "verse_number": "६-४८-९७", "content_sanskrit": "आकाशादीरितां दिव्यामात्मनो हितसंभवाम् ।\nभीष्मभीष्म महाबाहो शीघ्रं यत्नं कुरुष्व वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2044769, "chapter_id": 1999, "verse_number": "६-४८-९८", "content_sanskrit": "एष ह्यस्य जये कालो निर्दिष्टो विश्वयोनिना ।\nएतच्छ्रुत्वा तु वचनं देवदूतेन भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2044770, "chapter_id": 1999, "verse_number": "६-४८-९९", "content_sanskrit": "संप्रहृष्टमना भूत्वा वधे तस्य मनो दधे ।\nविरथं रथिनां श्रेष्ठं श्वेतं दृष्ट्वा पदातिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2044771, "chapter_id": 1999, "verse_number": "६-४८-१००", "content_sanskrit": "सहितास्त्वभ्यवर्तन्त परीप्सन्तो महारथाः ।\nसात्यकिर्भीमसेनश्च धृष्टद्युम्नश्च पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2044772, "chapter_id": 1999, "verse_number": "६-४८-१०१", "content_sanskrit": "कैकेयो धृष्टकेतुश्च अभिमन्युश्च वीर्यवान्।\nएतानापततः सर्वान्द्रोणशल्यकृपैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2044773, "chapter_id": 1999, "verse_number": "६-४८-१०२", "content_sanskrit": "अवारयदमेयात्मा वारिवेगानिवाचलः ।\nस निरुद्धेषु सर्वेषु पाण्डवेषु महात्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2044774, "chapter_id": 1999, "verse_number": "६-४८-१०३", "content_sanskrit": "श्वेतः खङ्गमथाकृष्य भीष्मस्य धनुराच्छिनात्।\nतदपास्य धनुश्छिन्नं त्वरमाणः पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2044775, "chapter_id": 1999, "verse_number": "६-४८-१०४", "content_sanskrit": "देवदूतवचः श्रुत्वा वधे तस्य मनो दधे ।\nततः प्रचरमाणस्तु पिता देवव्रतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2044776, "chapter_id": 1999, "verse_number": "६-४८-१०५", "content_sanskrit": "अन्यत्कार्मुकमादाय त्वरमाणो महारथः।\nक्षणेन सज्यमकरोच्छक्रचापसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2044777, "chapter_id": 1999, "verse_number": "६-४८-१०६", "content_sanskrit": "पिता ते भरतश्रेष्ठ श्वेतं दृष्ट्वा महारथैः ।\nवृतं तं मनुजव्याघ्रैर्भीमसेनपुरोगमैःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2044778, "chapter_id": 1999, "verse_number": "६-४८-१०७", "content_sanskrit": "अभ्यवर्तत गाङ्गेयः श्वेतं सेनापतिं द्रुतम् ।\nआपतन्तं ततो भीष्मो भीमसेनं प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2044779, "chapter_id": 1999, "verse_number": "६-४८-१०८", "content_sanskrit": "आजघ्ने विशिखैः षष्ट्या सेनान्यं स महारथः ।\nअभिमन्युं च समरे पिता देवव्रतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2044780, "chapter_id": 1999, "verse_number": "६-४८-१०९", "content_sanskrit": "आजघ्ने भरतश्रेष्ठस्त्रिभिः सन्नतपर्वभिः ।\nसात्यकिं च शतेनाजौ भरतानां पितामहः ॥ ६-४८-११०aधृष्टद्युम्नं च विंशत्या कैकेयं चापि पञ्चभिः ।\nतांश्च सर्वान्महेष्वासान्पिता देवव्रतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2044781, "chapter_id": 1999, "verse_number": "६-४८-१११", "content_sanskrit": "वारयित्वा शरैर्घोरैः श्वेतमेवाभिदुद्रुवे।\nततः शरं मृत्युसमं भारसाधनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2044782, "chapter_id": 1999, "verse_number": "६-४८-११२", "content_sanskrit": "विकृष्य बलवान्भीष्मः समाधत्त दुरासदम्।\nब्रह्मास्त्रेण सुसंयुक्तं तं शरं लोमवाहिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2044783, "chapter_id": 1999, "verse_number": "६-४८-११३", "content_sanskrit": "ददृशुर्देवगन्धर्वाः पिशाचोरगराक्षसाः ।\nस तस्य कवचं भित्वा हृदयं चामितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2044784, "chapter_id": 1999, "verse_number": "६-४८-११४", "content_sanskrit": "जगाम धरणीं बाणो महाशनिरिव ज्वलन्।\nअस्तं गच्छन्यथाऽऽदित्यः प्रभाप्रादाय सत्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2044785, "chapter_id": 1999, "verse_number": "६-४८-११५", "content_sanskrit": "एवं जीवितमादाय श्वेतदेहाञ्जगाम ह।\nतं भीष्मेण नरव्याघ्रं तथा विनिहतं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2044786, "chapter_id": 1999, "verse_number": "६-४८-११६", "content_sanskrit": "प्रपतन्तमपश्याम गिरेः शृङ्गमिव च्युतम्।\nअशोचन्पाण्डवास्तत्र क्षत्रियाश्च महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2044787, "chapter_id": 1999, "verse_number": "६-४८-११७", "content_sanskrit": "प्रहृष्टाश्च सुतास्तुभ्यं कुरवश्चापि सर्वशः । ६-४८-११७bततो दुःशासनो राजञ्श्वेतं दृष्ट्वा निपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2044788, "chapter_id": 1999, "verse_number": "६-४८-११८", "content_sanskrit": "वादित्रनिनदैर्घोरैर्नृत्यति स्म समंततः ।\nतस्मिन्हते महेष्वासे भीष्मेणाहवशोभिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2044789, "chapter_id": 1999, "verse_number": "६-४८-११९", "content_sanskrit": "प्रावेपन्त महेष्वासाः शिखण्डिप्रमुखा रथाः ।\nततो धनंजयो राजन्वार्ष्णेयश्चापि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2044790, "chapter_id": 1999, "verse_number": "६-४८-१२०", "content_sanskrit": "अवहारं शनैश्चक्रुर्निहते वाहिनीपतौ।\nततोऽवहारः सैन्यानां तव तेषां च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2044791, "chapter_id": 1999, "verse_number": "६-४८-१२१", "content_sanskrit": "तावकानां परेषां च नर्दतां च मुहुर्मुहुः ।\nपार्था विमनसो भूत्वा न्यवर्तन्त महारथाः ।\nचिन्तयन्तो वधं घोरं द्वैरथेन परंतपाः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2044792, "chapter_id": 1999, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि प्रथमदिवसयुद्धे अष्टचत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}]