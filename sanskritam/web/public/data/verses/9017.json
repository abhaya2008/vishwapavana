[{"id": 5000017000, "chapter_id": 9017, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000017001, "chapter_id": 9017, "verse_number": "१-१७-१", "content_sanskrit": "पुत्रत्वं तु गते विष्णौ राज्ञस्तस्य महात्मनः ।\nउवाच देवताः सर्वाः स्वयम्भूर्भगवानिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000017002, "chapter_id": 9017, "verse_number": "१-१७-२", "content_sanskrit": "सत्यसंधस्य वीरस्य सर्वेषां नो हितैषिणः ।\nविष्णोः सहायान् बलिनः सृजध्वं कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000017003, "chapter_id": 9017, "verse_number": "१-१७-३", "content_sanskrit": "मायाविदश्च शूरांश्च वायुवेगसमान् जवे ।\nनयज्ञान् बुद्धिसम्पन्नान् विष्णुतुल्यपराक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000017004, "chapter_id": 9017, "verse_number": "१-१७-४", "content_sanskrit": "असंहार्यानुपायज्ञान् दिव्यसंहननान्वितान् ।\nसर्वास्त्रगुणसम्पन्नानमृतप्राशनानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000017005, "chapter_id": 9017, "verse_number": "१-१७-५", "content_sanskrit": "अप्सरस्सु च मुख्यासु गन्धर्वीणां तनूषु च ।\nयक्षपन्नगकन्यासु ऋक्षविद्याधरीषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000017006, "chapter_id": 9017, "verse_number": "१-१७-६", "content_sanskrit": "किन्नरीणां च गात्रेषु वानरीणां तनूषु च ।\nसृजध्वं हरिरूपेण पुत्रांस्तुल्यपराक्रमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000017007, "chapter_id": 9017, "verse_number": "१-१७-७", "content_sanskrit": "पूर्वम् एव मया सृष्टो जाम्बवान् ऋक्ष पुङ्गवः ।\nजृम्भमाणस्य सहसा मम वक्रात् अजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000017008, "chapter_id": 9017, "verse_number": "१-१७-८", "content_sanskrit": "ते तथोक्ता भगवता तत् प्रतिश्रुत्य शासनम् ।\nजनयामासुरेवं ते पुत्रान् वानररूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000017009, "chapter_id": 9017, "verse_number": "१-१७-९", "content_sanskrit": "ऋषयश्च महात्मानः सिद्धविद्याधरोरगाः ।\nचारणाश्च सुतान् वीरान् ससृजुर्वनचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000017010, "chapter_id": 9017, "verse_number": "१-१७-१०", "content_sanskrit": "वानरेन्द्रं महेन्द्राभमिन्द्रो वालिनमात्मजम् ।\nसुग्रीवं जनयामास तपनस्तपतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000017011, "chapter_id": 9017, "verse_number": "१-१७-११", "content_sanskrit": "बृहस्पतिस्त्वजनयत् तारं नाम महाकपिम् ।\nसर्ववानरमुख्यानां बुद्धिमन्तमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000017012, "chapter_id": 9017, "verse_number": "१-१७-१२", "content_sanskrit": "धनदस्य सुतः श्रीमान् वानरो गन्धमादनः ।\nविश्वकर्मा त्वजनयन्नलं नाम महाकपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000017013, "chapter_id": 9017, "verse_number": "१-१७-१३", "content_sanskrit": "पावकस्य सुतः श्रीमान् नीलोऽग्निसदृशप्रभः ।\nतेजसा यशसा वीर्यादत्यरिच्यत वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000017014, "chapter_id": 9017, "verse_number": "१-१७-१४", "content_sanskrit": "रूपद्रविणसम्पन्नावश्विनौ रूपसम्मतौ ।\nमैन्दं च द्विविदं चैव जनयामासतुः स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000017015, "chapter_id": 9017, "verse_number": "१-१७-१५", "content_sanskrit": "वरुणो जनयामास सुषेणं नाम वानरम् ।\nशरभं जनयामास पर्जन्यस्तु महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000017016, "chapter_id": 9017, "verse_number": "१-१७-१६", "content_sanskrit": "मारुतस्यौरसः श्रीमान् हनुमान् नाम वानरः ।\nवज्रसंहननोपेतो वैनतेयसमो जवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000017017, "chapter_id": 9017, "verse_number": "१-१७-१७", "content_sanskrit": "सर्ववानरमुख्येषु बुद्धिमान् बलवानपि ।\nते सृष्टा बहुसाहस्रा दशग्रीववधोद्यताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000017018, "chapter_id": 9017, "verse_number": "१-१७-१८", "content_sanskrit": "अप्रमेयबला वीरा विक्रान्ताः कामरूपिणः ।\nते गजाचलसंकाशा वपुष्मन्तो महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000017019, "chapter_id": 9017, "verse_number": "१-१७-१९", "content_sanskrit": "ऋक्षवानरगोपुच्छाः क्षिप्रमेवाभिजज्ञिरे ।\nयस्य देवस्य यद्रूपं वेषो यश्च पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000017020, "chapter_id": 9017, "verse_number": "१-१७-२०", "content_sanskrit": "अजायत समं तेन तस्य तस्य पृथक् पृथक् ।\nगोलाङ्गूलीषु चोत्पन्नाः किंचिदुन्नतविक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000017021, "chapter_id": 9017, "verse_number": "१-१७-२१", "content_sanskrit": "ऋक्षीषु च तथा जाता वानराः किन्नरीषु च ।\nदेवा महर्षिगन्धर्वास्तार्क्ष्ययक्षा यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000017022, "chapter_id": 9017, "verse_number": "१-१७-२२", "content_sanskrit": "नागाः किम्पुरुषाश्चैव सिद्धविद्याधरोरगाः ।\nबहवो जनयामासुर्हृष्टास्तत्र सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000017023, "chapter_id": 9017, "verse_number": "१-१७-२३", "content_sanskrit": "चारणाश्च सुतान् वीरान् ससृजुर्वनचारिणः ।\nवानरान् सुमहाकायान् सर्वान् वै वनचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000017024, "chapter_id": 9017, "verse_number": "१-१७-२४", "content_sanskrit": "अप्सरस्सु च मुख्यासु तथा विद्याधरीषु च ।\nनागकन्यासु च तदा गन्धर्वीणां तनूषु च ।\nकामरूपबलोपेता यथाकामविचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000017025, "chapter_id": 9017, "verse_number": "१-१७-२५", "content_sanskrit": "सिंहशार्दूलसदृशा दर्पेण च बलेन च ।\nशिलाप्रहरणाः सर्वे सर्वे पादपयोधिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000017026, "chapter_id": 9017, "verse_number": "१-१७-२६", "content_sanskrit": "नखदंष्ट्रायुधाः सर्वे सर्वे सर्वास्त्रकोविदाः ।\nविचालयेयुः शैलेन्द्रान् भेदयेयुः स्थिरान् द्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000017027, "chapter_id": 9017, "verse_number": "१-१७-२७", "content_sanskrit": "क्षोभयेयुश्च वेगेन समुद्रं सरितां पतिम् ।\nदारयेयुः क्षितिं पद्भ्यामाप्लवेयुर्महार्णवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000017028, "chapter_id": 9017, "verse_number": "१-१७-२८", "content_sanskrit": "नभस्तलं विशेयुश्च गृह्णीयुरपि तोयदान् ।\nगृह्णीयुरपि मातङ्गान् मत्तान् प्रव्रजतो वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000017029, "chapter_id": 9017, "verse_number": "१-१७-२९", "content_sanskrit": "नर्दमानांश्च नादेन पातयेयुर्विहङ्गमान् ।\nईदृशानां प्रसूतानि हरीणां कामरूपिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000017030, "chapter_id": 9017, "verse_number": "१-१७-३०", "content_sanskrit": "शतं शतसहस्राणि यूथपानां महात्मनाम् ।\nते प्रधानेषु यूथेषु हरीणां हरियूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000017031, "chapter_id": 9017, "verse_number": "१-१७-३१", "content_sanskrit": "बभूवुर्यूथपश्रेष्ठान् वीरांश्चाजनयन् हरीन् ।\nअन्ये ऋक्षवतः प्रस्थानुपतस्थुः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000017032, "chapter_id": 9017, "verse_number": "१-१७-३२", "content_sanskrit": "अन्ये नानाविधाञ्छैलान् काननानि च भेजिरे ।\nसूर्यपुत्रं च सुग्रीवं शक्रपुत्रं च वालिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000017033, "chapter_id": 9017, "verse_number": "१-१७-३३", "content_sanskrit": "भ्रातरावुपतस्थुस्ते सर्वे च हरियूथपाः ।\nनलं नीलं हनूमन्तमन्यांश्च हरियूथपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000017034, "chapter_id": 9017, "verse_number": "१-१७-३४", "content_sanskrit": "ते तार्क्ष्यबलसम्पन्नाः सर्वे युद्धविशारदाः ।\nविचरन्तोऽर्दयन् सर्वान् सिंहव्याघ्रमहोरगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000017035, "chapter_id": 9017, "verse_number": "१-१७-३५", "content_sanskrit": "महाबलो महाबाहुर्वाली विपुलविक्रमः ।\nजुगोप भुजवीर्येण ऋक्षगोपुच्छवानरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000017036, "chapter_id": 9017, "verse_number": "१-१७-३६", "content_sanskrit": "तैरियं पृथिवी शूरैः सपर्वतवनार्णवा ।\nकीर्णा विविधसंस्थानैर्नानाव्यञ्जनलक्षणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000017037, "chapter_id": 9017, "verse_number": "१-१७-३७", "content_sanskrit": "तैर्मेघवृन्दाचलकूटसंनिभै-\n:::र्महाबलैर्वानरयूथपाधिपैः\nबभूव भूर्भीमशरीररूपैः\n:::समावृता रामसहायहेतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000017038, "chapter_id": 9017, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]