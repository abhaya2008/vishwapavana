[{"id": 6000150000, "chapter_id": 10150, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000150001, "chapter_id": 10150, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.001.m4a", "display_order": 2}, {"id": 6000150002, "chapter_id": 10150, "verse_number": "७-१२-१", "content_sanskrit": "ब्रह्मचारी गुरुकुले वसेद् दान्तो गुरोर्हितम्।\nआचरेद् दासवन्नीचो गुरौ सुदृढसौहृदः॥ ७/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.002.m4a", "display_order": 3, "topics": [{"text": "ब्रह्मचारिवानप्रस्थधर्मकथनम् ,साधारण्येन चातुराश्रम्यधर्मकथनम्", "range": "१–३१"}]}, {"id": 6000150003, "chapter_id": 10150, "verse_number": "७-१२-२", "content_sanskrit": "सायं प्रातरुपासीत गुर्वग्न्यर्कसुरोत्तमान्।\nसन्ध्ये उभे च यतवाग् जपन् ब्रह्म समाहितः॥ ७/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.003.m4a", "display_order": 4}, {"id": 6000150004, "chapter_id": 10150, "verse_number": "७-१२-३", "content_sanskrit": "छन्दांस्यधीयेत गुरोराहूतश्च सुयन्त्रितः।\nउपक्रमेऽवसाने च चरणौ शिरसा नमेत्॥ ७/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.004.m4a", "display_order": 5}, {"id": 6000150005, "chapter_id": 10150, "verse_number": "७-१२-४", "content_sanskrit": "मेखलाजिनवासांसि जटादण्डकमण्डलून्।\nबिभृयादुपवीतं च दर्भपाणिर्यथोदितम्॥ ७/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.005.m4a", "display_order": 6}, {"id": 6000150006, "chapter_id": 10150, "verse_number": "७-१२-५", "content_sanskrit": "सायं प्रातश्चरेद् भैक्ष्यं गुरवे तन्निवेदयेत्।\nभुञ्जीत यद्यनुज्ञातो नो चेदुपवसेत्क्‍वचित्॥ ७/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.006.m4a", "display_order": 7}, {"id": 6000150007, "chapter_id": 10150, "verse_number": "७-१२-६", "content_sanskrit": "सुशीलो मितभुग् दक्षः श्रद्दधानो जितेन्द्रियः।\nयावदर्थं व्यवहरेत् स्‍त्रीषु स्‍त्रीनिर्जितेषु च॥ ७/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.007.m4a", "display_order": 8}, {"id": 6000150008, "chapter_id": 10150, "verse_number": "७-१२-७", "content_sanskrit": "वर्जयेत् प्रमदागाथामगृहस्थो बृहद्व्रतः।\nइन्द्रियाणि प्रमाथीनि हरन्त्यपि यतेर्मनः॥ ७/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.008.m4a", "display_order": 9}, {"id": 6000150009, "chapter_id": 10150, "verse_number": "७-१२-८", "content_sanskrit": "केशप्रसाधनोन्मर्द्दस्नपनाभ्यञ्जनादिकम्।\nगुरुस्‍त्रीभिर्युवतिभिः कारयेन्नात्मनो युवा॥ ७/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.009.m4a", "display_order": 10}, {"id": 6000150010, "chapter_id": 10150, "verse_number": "७-१२-९", "content_sanskrit": "नन्वग्निः प्रमदा नाम घृतकुम्भः पुमान् यतः।\nसुतामपि रहो जह्यादन्यदा यावदर्थकृत्॥ ७/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.010.m4a", "display_order": 11}, {"id": 6000150011, "chapter_id": 10150, "verse_number": "७-१२-१०", "content_sanskrit": "कल्पयेदात्मनो यावदाभासमिदमीश्वरः।\nद्वैतं तावन्न विरमेत् ततो ह्यस्य विपर्ययः॥ ७/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.011.m4a", "display_order": 12}, {"id": 6000150012, "chapter_id": 10150, "verse_number": "७-१२-११", "content_sanskrit": "एतच्चान्यद् गृहस्थस्य समाम्नातं यतेरपि।\nगुरुवृत्तिर्विकल्पेन गृहस्थस्यर्तुगामिनः॥ ७/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.012.m4a", "display_order": 13}, {"id": 6000150013, "chapter_id": 10150, "verse_number": "७-१२-१२", "content_sanskrit": "अञ्जनाभ्यञ्जनोन्मर्द्दस्‍त्र्यवलेपामिषं मधु।\nस्रग्गन्धलेपालङ्कारांस्त्यजेयुर्ये धृतव्रताः॥ ७/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.013.m4a", "display_order": 14}, {"id": 6000150014, "chapter_id": 10150, "verse_number": "७-१२-१३", "content_sanskrit": "उषित्वैवं गुरुकुले द्विजोऽधीत्यावबुध्य च।\nत्रयीं साङ्गोपनिषदं यावदर्थं यथाबलम्॥ ७/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.014.m4a", "display_order": 15}, {"id": 6000150015, "chapter_id": 10150, "verse_number": "७-१२-१४", "content_sanskrit": "दत्वा वरमनुज्ञातो गुरोः कामं यदीश्वरः।\nगृहं वनं वा प्रविशेत् प्रव्रजेत् तत्र वाऽवसेत्॥ ७/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.015.m4a", "display_order": 16}, {"id": 6000150016, "chapter_id": 10150, "verse_number": "७-१२-१५", "content_sanskrit": "अग्नौ गुरावात्मनि च सर्वभूतेष्वधोक्षजम्।\nभूतैः स्वधामभिः पश्येदप्रविष्टं प्रविष्टवत्॥ ७/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.016.m4a", "display_order": 17}, {"id": 6000150017, "chapter_id": 10150, "verse_number": "७-१२-१६", "content_sanskrit": "एवंविधो ब्रह्मचारी वानप्रस्थो यतिर्गृही।\nपरं विन्दति विज्ञानं परं ब्रह्माधिगच्छति॥ ७/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.017.m4a", "display_order": 18}, {"id": 6000150018, "chapter_id": 10150, "verse_number": "७-१२-१७", "content_sanskrit": "वानप्रस्थस्य वक्ष्यामि नियमान् मुनिसंमतान्।\nयानातिष्ठन् मुनिर्गच्छेद् ऋषिलोकमिहाञ्जसा॥ ७/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.018.m4a", "display_order": 19}, {"id": 6000150019, "chapter_id": 10150, "verse_number": "७-१२-१८", "content_sanskrit": "न कृष्टपच्यमश्नीयादकृष्टं वाऽप्यकालतः।\nअग्निपक्‍वमथामं वा अर्कपक्‍वमुताहरेत्॥ ७/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.019.m4a", "display_order": 20}, {"id": 6000150020, "chapter_id": 10150, "verse_number": "७-१२-१९", "content_sanskrit": "वन्यैश्चरुपुरोडाशान् निर्वपेत्कालचोदितान्।\nलब्धे नवे नवान्नाद्ये पुराणं तु परित्यजेत्॥ ७/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.020.m4a", "display_order": 21}, {"id": 6000150021, "chapter_id": 10150, "verse_number": "७-१२-२०", "content_sanskrit": "अग्न्यर्थमेव शरणमुटजं वाऽद्रिकन्दरम्।\nश्रयेत हिमवाय्वग्निवर्षार्कातपनान् स्वयम्॥ ७/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.021.m4a", "display_order": 22}, {"id": 6000150022, "chapter_id": 10150, "verse_number": "७-१२-२१", "content_sanskrit": "केशरोमनखश्मश्रुमलानि जटिलो दधत्।\nकमण्डल्वजिने दण्डवल्कलाग्निपरिच्छदान्॥ ७/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.022.m4a", "display_order": 23}, {"id": 6000150023, "chapter_id": 10150, "verse_number": "७-१२-२२", "content_sanskrit": "चरेद् वने द्वादशाब्दानष्टौ वा चतुरो मुनिः।\nद्वावेकं वा यथाबुद्धिर्न विपद्येत कृच्छ्रतः॥ ७/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.023.m4a", "display_order": 24}, {"id": 6000150024, "chapter_id": 10150, "verse_number": "७-१२-२३", "content_sanskrit": "यदाऽकल्पः स्वक्रियायां व्याधिभिर्जरयाऽथवा।\nआन्वीक्षिक्यां च विद्यायां कुर्यादनशनादिकम्॥ ७/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.024.m4a", "display_order": 25}, {"id": 6000150025, "chapter_id": 10150, "verse_number": "७-१२-२४", "content_sanskrit": "आत्मन्यग्नीन् समारोप्य संन्यस्याहंममात्मताम्।\nकारणेषु न्यसेत् सम्यक् सङ्घातं तु यथार्हतः॥ ७/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.025.m4a", "display_order": 26}, {"id": 6000150026, "chapter_id": 10150, "verse_number": "७-१२-२५", "content_sanskrit": "खे खानि वायौ निःश्वासान् तेजस्यूष्माणमात्मवान्।\nअप्स्वसृक्श्लेष्मपूयानि क्षितौ शेषं यथोद्भवम्॥ ७/१२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.026.m4a", "display_order": 27}, {"id": 6000150027, "chapter_id": 10150, "verse_number": "७-१२-२६", "content_sanskrit": "वाचमग्नौ सवक्तव्यमिन्द्रे शिल्पं करावपि।\nपदानि गतिभिर्विष्णौ रत्योपस्थं प्रजापतौ॥ ७/१२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.027.m4a", "display_order": 28}, {"id": 6000150028, "chapter_id": 10150, "verse_number": "७-१२-२७", "content_sanskrit": "मित्रेपायुं विसर्गं च यथास्थानं विनिर्दिशेत्।\nदिक्षु श्रोत्रं स नादेन स्पर्शेनाध्यात्मनि त्वचम्॥ ७/१२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.028.m4a", "display_order": 29}, {"id": 6000150029, "chapter_id": 10150, "verse_number": null, "content_sanskrit": "रूपाणि चक्षुषा राजन् ज्योतिष्यभिनिवेशयेत्।\nअप्सु प्रवेशयेद् जिह्वां घ्रेयैर्घ्राणं क्षितौ न्यसेत्॥ ७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.029.m4a", "display_order": 30}, {"id": 6000150030, "chapter_id": 10150, "verse_number": "७-१२-२८", "content_sanskrit": "मनो मनोरथैश्चन्द्रे बुद्धिं बोध्यैः कवौ परे॥ ७/१२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.030.m4a", "display_order": 31}, {"id": 6000150031, "chapter_id": 10150, "verse_number": "७-१२-२९", "content_sanskrit": "कर्माण्यध्यात्मना रुद्रे यदहं सम्मताः क्रियाः।\nसत्त्वेन चित्तं क्षेत्रज्ञे गुणैर्वैकारिकं परे॥ ७/१२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.031.m4a", "display_order": 32}, {"id": 6000150032, "chapter_id": 10150, "verse_number": "७-१२-३०", "content_sanskrit": "अप्सु क्षितिमपो ज्योतिष्यदो वायौ नभस्यमुम्।\nकूटस्थे तच्च महति तदव्यक्तेऽक्षरे तु तत्॥ ७/१२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.032.m4a", "display_order": 33}, {"id": 6000150033, "chapter_id": 10150, "verse_number": "७-१२-३१", "content_sanskrit": "इत्यक्षरतयाऽऽत्मानं चिन्मात्रमवशेषितम्।\nज्ञात्वाऽद्वयोऽथ विरमेद् दग्धयोनिर्यथानलः॥ ७/१२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_012/BhP_07.012.033.m4a", "display_order": 34}, {"id": 6000150034, "chapter_id": 10150, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे द्वादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]