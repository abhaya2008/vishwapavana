[{"id": 7003774000, "chapter_id": 23774, "verse_number": "२-२-१८-१", "content_sanskrit": "जैमिनिरुवाच ।\nततः प्रववृते सुत्या नृपतेर्वाजिमेधिका ।\nतस्यां त्रैलोक्यमभवदेकसद्मनिभं द्विजाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003774001, "chapter_id": 23774, "verse_number": "२-२-१८-२", "content_sanskrit": "शास्त्रैः स्तोत्रैर्दिवस्पृग्भिर्वर्णक्रमसमुज्ज्वलैः ।\nयथापदस्वरन्यासैरन्ये शब्दास्तिरोहिताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003774002, "chapter_id": 23774, "verse_number": "२-२-१८-३", "content_sanskrit": "दीनेभ्योऽवारितं तत्र दीयन्ते वाञ्छितानि वै ।\nनटनर्त्तकसूतानां साभूत्कल्पद्रुमोपमा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003774003, "chapter_id": 23774, "verse_number": "२-२-१८-४", "content_sanskrit": "तन्मध्येऽवभृथे स्नातुं कृता यत्रोपकारिका ।\nदक्षिणे तटभूदेशे बिल्वेश्वरसमीपतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003774004, "chapter_id": 23774, "verse_number": "२-२-१८-५", "content_sanskrit": "नियुक्ताः सेवका राज्ञा ससंभ्रममुपस्थिताः ।\nन्यवेदयन्त नृपतिं कृतांजलिपुटा द्विजाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003774005, "chapter_id": 23774, "verse_number": "२-२-१८-६", "content_sanskrit": "देव दृष्टो महान्वृक्षस्तटभूमौ महोदधेः ।\nप्रविष्टाग्रसमुद्रांतः कल्लोलप्लवमूलकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003774006, "chapter_id": 23774, "verse_number": "२-२-१८-७", "content_sanskrit": "मंजिष्ठवर्णः सर्वत्र शंखचक्रांकितः प्लवन् ।\nस्नानवेश्मसमीपेऽसौ दृष्टोऽस्माभिः परोऽद्भुतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003774007, "chapter_id": 23774, "verse_number": "२-२-१८-८", "content_sanskrit": "न दृष्टपूर्वो वृक्षोऽयमुद्यत्सूर्यनिभोंऽशुना ।\nगंधेन वासयन्सर्वा तटभूमिं सुगंधिना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003774008, "chapter_id": 23774, "verse_number": "२-२-१८-९", "content_sanskrit": "द्रुमः साधारणो नायं लक्ष्यते देवभूरुहः ।\nकश्चिद्देवस्तरुव्याजादागतो लक्ष्यते धुवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003774009, "chapter_id": 23774, "verse_number": "२-२-१८-१०", "content_sanskrit": "नियुक्तानां वचः श्रुत्वा राजा नारदमब्रवीत् ।\nतत्किं निमित्तं यद्दृष्टं तरुश्रेष्ठं वदंति ते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003774010, "chapter_id": 23774, "verse_number": "२-२-१८-११", "content_sanskrit": "नारदः प्रहसन्वाक्यमुवाच नृपसत्तमम् ।\nपूर्णाहुतिः समाप्नोतु यथा स्यात्सफलः क्रतुः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003774011, "chapter_id": 23774, "verse_number": "२-२-१८-१२", "content_sanskrit": "उपस्थितं ते तद्भाग्यं स्वप्ने यद्दृष्टवान्पुरा ।\nश्वेतद्वीपे विश्वमूर्तिर्दृष्टो यो विष्णुरव्ययः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003774012, "chapter_id": 23774, "verse_number": "२-२-१८-१३", "content_sanskrit": "तदंगस्खलितं रोम तरुत्वमुपपद्यते ।\nअंशावतारः स्थास्नुर्यः पृथिव्यां परमेष्ठिनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003774013, "chapter_id": 23774, "verse_number": "२-२-१८-१४", "content_sanskrit": "तद्रूपावतरं याति भगवान्भक्तवत्सलः ।\nद्रुमो ह्यपौरुषो योसौ भाजनं नास्य दर्शने ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003774014, "chapter_id": 23774, "verse_number": "२-२-१८-१५", "content_sanskrit": "त्वामृते पुरुषव्याघ्र पृथिव्यां नृपसत्तम ।\nत्वद्भाग्यवशतः सर्वलोकानां नयनातिथिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003774015, "chapter_id": 23774, "verse_number": "२-२-१८-१६", "content_sanskrit": "भविष्यति महाराज सर्वकल्मषनाशनः ।\nसमाप्यावभृथस्नानं तटांते सरितां पतेः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003774016, "chapter_id": 23774, "verse_number": "२-२-१८-१७", "content_sanskrit": "उत्सवं सुमहत्कृत्वा कृतकौतुकमंगलम् ।\nमहावेद्यां स्थापयात्र यज्ञेशं तरुरूपिणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003774017, "chapter_id": 23774, "verse_number": "२-२-१८-१८", "content_sanskrit": "विचार्येत्थं मुदा युक्तौ तावुभौ नृपनारदौ ।\nसुसमृद्धौ तत्र यातौ यत्रासौ भगवद्द्रुमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003774018, "chapter_id": 23774, "verse_number": "२-२-१८-१९", "content_sanskrit": "तं दृष्ट्वा हर्षिताः सर्वे ब्रह्म साक्षादुपस्थितम् ।\nमेनिरे जन्मसाफल्यं जीवन्मुक्ता महोदयाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003774019, "chapter_id": 23774, "verse_number": "२-२-१८-२०", "content_sanskrit": "इन्द्रद्युम्नोऽपि नृपतिर्ममज्जामृतसागरे ।\nस्वप्ने दृष्ट्वा जगन्नाथं यथासौ भगवत्प्रियः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003774020, "chapter_id": 23774, "verse_number": "२-२-१८-२१", "content_sanskrit": "तथा ददर्श तं वृक्षं चक्षुःशाखं चतुर्भुजम् ।\nस्वकं श्रमं मन्यमानः सफलं नृपसत्तमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003774021, "chapter_id": 23774, "verse_number": "२-२-१८-२२", "content_sanskrit": "जहौ शोकं नीलमणिमाधवांतर्धिजं द्विजाः ।\nपुनः पुनः प्रणम्यैनं हर्षाश्रुनयनो नृपः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003774022, "chapter_id": 23774, "verse_number": "२-२-१८-२३", "content_sanskrit": "द्विजैराहारयामास तरुं कल्लोललोलितम् ।\nशंखकाहालमुरजढक्कापटहनिःस्वनैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003774023, "chapter_id": 23774, "verse_number": "२-२-१८-२४", "content_sanskrit": "गीतवादित्रनिनदैर्जयशब्दैः सहस्रशः ।\nसुगंधिपुष्पांजलिभिराकाशात्पतितैर्मुहुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003774024, "chapter_id": 23774, "verse_number": "२-२-१८-२५", "content_sanskrit": "परितो धूपपात्रैश्च कृष्णागुरुसुधूपितैः ।\nवेश्याभिर्यौवनोन्मत्तसुरूपाभिः प्रचालितैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003774025, "chapter_id": 23774, "verse_number": "२-२-१८-२६", "content_sanskrit": "रत्नदण्डप्रकीर्णैश्च वीज्यमानं समंततः ।\nपताकाभिर्दिव्यपट्टदुकूलाभिः सुशोभितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003774026, "chapter_id": 23774, "verse_number": "२-२-१८-२७", "content_sanskrit": "राजर्षिराजवृन्दैश्च तुरगैः पत्तिभिर्वृतम् ।\nमागधैर्वंद्यमानं तु स्तूयमानं महर्षिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003774027, "chapter_id": 23774, "verse_number": "२-२-१८-२८", "content_sanskrit": "ऋत्विग्भिर्ब्राह्मणैश्चैव विद्वद्भिः श्रोत्रियैस्तथा ।\nराजन्यैर्वैश्यकुलजैः सच्छूद्रैः परिचारितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003774028, "chapter_id": 23774, "verse_number": "२-२-१८-२९", "content_sanskrit": "स्तोत्रैर्बहुविधैः श्रौतैः स्मार्तैः पौराणिकैस्तथा ।\nस्तूयमानं तरुं विष्णोर्भूर्लोके परिवेष्टितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003774029, "chapter_id": 23774, "verse_number": "२-२-१८-३०", "content_sanskrit": "स्रग्गन्धालंकृतं दिव्यं महावेदीं विनिन्यतुः ।\nवितानवरचित्रायां वेष्टितायां निरंतरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003774030, "chapter_id": 23774, "verse_number": "२-२-१८-३१", "content_sanskrit": "वेद्यां तं स्थापयामासुरिंद्रद्युम्नस्य शासनात् ।\nवचसा नारदस्यैनं पूजयामास पार्थिवः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003774031, "chapter_id": 23774, "verse_number": "२-२-१८-३२", "content_sanskrit": "सहस्रैरुपचाराणां दिव्यरूपैर्नृपोत्तमः ।\nपूजावसाने पप्रच्छ नारदं मुनिसत्तमम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003774032, "chapter_id": 23774, "verse_number": "२-२-१८-३३", "content_sanskrit": "कीदृश्यः प्रतिमा विष्णोर्घटयिष्यति कः पुनः ।\nतच्छ्रुत्वा तं मुनिः प्राह अचिंत्यमहिमा गुरुः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003774033, "chapter_id": 23774, "verse_number": "२-२-१८-३४", "content_sanskrit": "को वेद तस्य चेष्टां वै सर्वलोकोत्तरां नृप ।\nस्रष्टा यो जगतां तस्याप्येषा संशयगोचरा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003774034, "chapter_id": 23774, "verse_number": "२-२-१८-३५", "content_sanskrit": "विचारयंतौ तावित्थं यावन्नारदपार्थिवौ ।\nअशरीरा ततो वाणी शुश्रुवे चांतरिक्षतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003774035, "chapter_id": 23774, "verse_number": "२-२-१८-३६", "content_sanskrit": "तत्र विस्मयमानानां सर्वेषामेव शृण्वताम् ।\nअपौरुषेयो भगवानविचारपथे स्थितः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003774036, "chapter_id": 23774, "verse_number": "२-२-१८-३७", "content_sanskrit": "सुगुप्तायां महावेद्यां स्वयं सोऽवतरिष्यति ।\nप्रच्छाद्यतां दिनान्येषा यावत्पंचदशानि वै ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003774037, "chapter_id": 23774, "verse_number": "२-२-१८-३८", "content_sanskrit": "उपस्थितोऽयं यो वृद्धः शस्त्रपाणिस्तु वर्द्धकिः ।\nएनमंतः प्रवेश्यैव द्वारं बध्नंतु यत्नतः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003774038, "chapter_id": 23774, "verse_number": "२-२-१८-३९", "content_sanskrit": "बहिर्वाद्यानि कुर्वंतु यावत्तु घटना भवेत् ।\nश्रुतो हि घटनाशब्दो बाधिर्यांधत्वदायकः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003774039, "chapter_id": 23774, "verse_number": "२-२-१८-४०", "content_sanskrit": "नरके वसतिं चैव कुर्यात्संताननाशनम् ।\nनांतःप्रवेशनं कुर्यान्न पश्येच्च कदाचन ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003774040, "chapter_id": 23774, "verse_number": "२-२-१८-४१", "content_sanskrit": "नियुक्तादन्यः पश्येच्चेद्राज्ञो राष्ट्रस्य चैव ह ।\nद्रष्टुश्चापि महाभीतिरंधता चक्षुषोर्युगे ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003774041, "chapter_id": 23774, "verse_number": "२-२-१८-४२", "content_sanskrit": "तस्मान्नावेक्षणं कार्यं यावत्प्रतिमनिर्मितिः ।\nनिर्व्यूढस्तु स्वयं दैवः कृत्यांते तु वदिष्यति ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003774042, "chapter_id": 23774, "verse_number": "२-२-१८-४३", "content_sanskrit": "यत्कार्यं प्रयत्नेन सर्वलोकसुखावहम् ।\nतच्छ्रुत्वा नारदाद्यास्ते यथोक्तं विष्णुना स्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003774043, "chapter_id": 23774, "verse_number": "२-२-१८-४४", "content_sanskrit": "चिकीर्षंति तथा कर्त्तुं तत्रायातश्च वर्द्धकिः ।\nप्रोवाच नृपतिं सोऽथ स्वप्ने दृष्टास्तु यास्त्वया ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003774044, "chapter_id": 23774, "verse_number": "२-२-१८-४५", "content_sanskrit": "ता एवाहं घटिष्यामि दारुणा दिव्यरूपिणा ।\nइत्युक्त्वांतर्दधे वेद्यां वृद्धवर्द्धकिरूपधृक् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003774045, "chapter_id": 23774, "verse_number": "२-२-१८-४६", "content_sanskrit": "वंचनार्थं मनुष्याणां साक्षान्नारायणो विभुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003774046, "chapter_id": 23774, "verse_number": "२-२-१८-४७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवादेऽष्टादशोऽध्यायः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]