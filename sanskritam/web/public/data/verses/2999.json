[{"id": 2093528, "chapter_id": 2999, "verse_number": "१३-१२९-१", "content_sanskrit": "भीष्म उवाच।\nये च गाः सम्प्रयच्छन्ति हुतशिष्टाशिनश्च ये।\nतेषां सत्राणि यज्ञाश्च नित्यमेव युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093529, "chapter_id": 2999, "verse_number": "१३-१२९-२", "content_sanskrit": "ऋते दधिघृतेनेह न यज्ञः सम्प्रवर्तते।\nतेन यज्ञस्य यज्ञत्वमतो मूलं च लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093530, "chapter_id": 2999, "verse_number": "१३-१२९-३", "content_sanskrit": "दानानामपि सर्वेषां गवां दानं प्रशस्यते।\nगावः श्रेष्ठाः पवित्राश्च पावनं ह्येतदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093531, "chapter_id": 2999, "verse_number": "१३-१२९-४", "content_sanskrit": "पुष्ट्यर्थमेताः सेवेत शान्त्यर्थमपि चैव ह।\nपयो दधि घृतं चासां सर्वपापप्रमोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093532, "chapter_id": 2999, "verse_number": "१३-१२९-५", "content_sanskrit": "गावस्तेजः परं प्रोक्तमिह लोके परत्र च।\nन गोभ्यः परमं किञ्चित्पवित्रं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093533, "chapter_id": 2999, "verse_number": "१३-१२९-६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nपितामहस्य संवादमिन्द्रस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093534, "chapter_id": 2999, "verse_number": "१३-१२९-७", "content_sanskrit": "पराभूतेषु दैत्येषु शक्रस्त्रिभुवनेश्वरः।\nप्रजाः समुदिताः सर्वाः सत्यधर्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093535, "chapter_id": 2999, "verse_number": "१३-१२९-८", "content_sanskrit": "अथर्षयः सगन्धर्वाः किन्नरोरगराक्षसाः।\nदेवासुरसुपर्णाश्च प्रजानां पतयस्तथा।\nपर्युपासत कौन्तेय कदाचिद्वै पितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093536, "chapter_id": 2999, "verse_number": "१३-१२९-९", "content_sanskrit": "नारदः पर्वतश्चैव विश्वावसुहहाहुहूः।\nदिव्यतानेषु गायन्तः पर्युपासत तं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093537, "chapter_id": 2999, "verse_number": "१३-१२९-१०", "content_sanskrit": "तत्र दिव्यानि पुष्पाणि प्रावहत्पवनस्तदा।\nआजह्रुर्ऋतवश्चापि सुगन्धीनि पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093538, "chapter_id": 2999, "verse_number": "१३-१२९-११", "content_sanskrit": "तस्मिन्देवसमावाये सर्वभूतसमागमे।\nदिव्यवादित्रसंघुष्टे दिव्यस्त्रीचारणावृते।\nइन्द्रः पप्रच्छ देवेशमभिवाद्य प्रणम्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093539, "chapter_id": 2999, "verse_number": "१३-१२९-१२", "content_sanskrit": "देवानां भगवन्कस्माल्लोकेशानां पितामह।\nउपरिष्ठाद्गवां लोक एतदिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093540, "chapter_id": 2999, "verse_number": "१३-१२९-१३", "content_sanskrit": "किं तपो ब्रह्मचर्यं वा गोभिः कृतमिहेश्वर॥\nदेवानामुपरिष्टाद्यद्वसन्त्यरजसः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093541, "chapter_id": 2999, "verse_number": "१३-१२९-१४", "content_sanskrit": "ततः प्रोवाच ब्रह्मा तं शक्रं बलनिषूदनम्।\nअवज्ञातास्त्वया नित्यं गावो बलनिषूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093542, "chapter_id": 2999, "verse_number": "१३-१२९-१५", "content_sanskrit": "तेन त्वमासां माहात्म्यं न वेत्सि शृणु यत्प्रभो।\nगवां प्रभावं परमं माहात्म्यं च सुरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093543, "chapter_id": 2999, "verse_number": "१३-१२९-१६", "content_sanskrit": "यज्ञाङ्गं कथिता गावो यज्ञ एव च वासव।\nएताभिश्च विना विज्ञो न वर्तेत कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093544, "chapter_id": 2999, "verse_number": "१३-१२९-१७", "content_sanskrit": "धारयन्ति प्रजाश्चैताः पयसा हविषा तथा।\nएतासां तनयाश्चापि कृषियोगमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093545, "chapter_id": 2999, "verse_number": "१३-१२९-१८", "content_sanskrit": "जनयन्ति च धान्यानि बीजानि विविधानि च।\nततो यज्ञाः प्रवर्तन्ते हव्यं कव्यं च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093546, "chapter_id": 2999, "verse_number": "१३-१२९-१९", "content_sanskrit": "पयो दधि घृतं चैव पुण्याश्चैताः सुराधिप।\nवहन्ति विविधान्भोगान्क्षुत्तृष्णापरिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093547, "chapter_id": 2999, "verse_number": "१३-१२९-२०", "content_sanskrit": "मुनींश्च धारयन्तीह प्रजाश्चैवापि कर्मणा।\nवासवाऽकूटवाहिन्यः कर्मणा सुकृतेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093548, "chapter_id": 2999, "verse_number": "१३-१२९-२१", "content_sanskrit": "उपरिष्टात्ततोऽस्माकं वसन्त्येताः सदैव हि।\nएतत्ते कारणं शक्र निवासकृतमध्य वै।\nगावो देवोपरिष्टाद्धि समाख्याताः शतक्रतो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093549, "chapter_id": 2999, "verse_number": "१३-१२९-२२", "content_sanskrit": "एता हि वरदत्ताश्च वरदाश्चापि वासव।\nसुरभ्यः पुण्यकर्मिण्यः पावनाः शुभलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093550, "chapter_id": 2999, "verse_number": "१३-१२९-२३", "content_sanskrit": "यदर्थं गां गताश्चैव सुरभ्यः सुरसत्तम।\nतच्च मे शृणु कार्स्न्येन वदतो बलसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093551, "chapter_id": 2999, "verse_number": "१३-१२९-२४", "content_sanskrit": "पुरा देवयुगे तात दैत्येन्द्रेषु महात्मसु।\nत्रीँल्लोकाननुशासत्सु विष्णौ गर्भत्वमागते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093552, "chapter_id": 2999, "verse_number": "१३-१२९-२५", "content_sanskrit": "अदित्यां तप्यमानायां तपो घोरं सुदुश्चरम्।\nपुत्रार्थममरश्रेष्ठ पादेनैकेन नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093553, "chapter_id": 2999, "verse_number": "१३-१२९-२६", "content_sanskrit": "तां तु दृष्ट्वा महादेवीं तप्यमानां महत्तपः।\nदक्षस्य दुहिता देवी सुरभिर्नाम नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093554, "chapter_id": 2999, "verse_number": "१३-१२९-२७", "content_sanskrit": "अतप्यत तपो घोरं हृष्टा धर्मपरायणा।\nकैलासशिखरे रम्ये देवगन्धर्वसेविते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093555, "chapter_id": 2999, "verse_number": "१३-१२९-२८", "content_sanskrit": "व्यतिष्ठदेकपादेन परमं योगमास्थिता।\nदशवर्षसहस्राणि दशवर्षशतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093556, "chapter_id": 2999, "verse_number": "१३-१२९-२९", "content_sanskrit": "सन्तप्तास्तपसा तस्या देवाः सर्षिमहोरगाः।\nतत्र गत्वा मया सार्धं पर्युपासत तां शुभां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093557, "chapter_id": 2999, "verse_number": "१३-१२९-३०", "content_sanskrit": "अथाहमब्रवं तत्र देवीं तां तपसाऽन्विताम्।\nकिमर्थं तप्यसे देवि तपो घोरमनिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093558, "chapter_id": 2999, "verse_number": "१३-१२९-३१", "content_sanskrit": "प्रीतस्तेऽहं महाभागो तपसाऽनेन शोभने।\nवरयस्व वरं देवि दातास्मीति पुरन्दर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093559, "chapter_id": 2999, "verse_number": "१३-१२९-३२x", "content_sanskrit": "सुरभिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093560, "chapter_id": 2999, "verse_number": "१३-१२९-३२", "content_sanskrit": "वरेण भगवन्मह्यं कृतं लोकपितामह।\nएष एव वरो मेऽद्य यत्प्रीतोसि ममानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093561, "chapter_id": 2999, "verse_number": "१३-१२९-३३x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2093562, "chapter_id": 2999, "verse_number": "१३-१२९-३३", "content_sanskrit": "तामेव ब्रुवतीं देवीं सुरभिं त्रिदशेश्वर।\nप्रत्यब्रवं यद्देवेन्द्र तन्निबोध शचीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2093563, "chapter_id": 2999, "verse_number": "१३-१२९-३४", "content_sanskrit": "अलोभकाम्यया देवि तपसा शुचिना च ते।\nप्रसन्नोऽहं वरं तस्मादमरत्वं दादामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2093564, "chapter_id": 2999, "verse_number": "१३-१२९-३५", "content_sanskrit": "त्रयाणामपि लोकानामुपरिष्टान्निवत्स्यसि।\nमत्प्रसादाच्च विख्यातो गोलोकः सम्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2093565, "chapter_id": 2999, "verse_number": "१३-१२९-३६", "content_sanskrit": "मानुषेषु च कुर्वाणाः प्रजाः कर्म शुभास्तव।\nनिवत्स्यन्ति महाभागो सर्वा दुहितरश्च ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2093566, "chapter_id": 2999, "verse_number": "१३-१२९-३७", "content_sanskrit": "मनसा चिन्तिता भोगास्त्वया वै दिव्यमानुषाः।\nयच्च स्वर्गसुखं देवि तत्ते सम्पत्स्यते शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2093567, "chapter_id": 2999, "verse_number": "१३-१२९-३८", "content_sanskrit": "तस्या लोकाः सहस्राक्ष सर्वकामसमन्विताः।\nन तत्र क्रमते मृत्युर्न जरा न च पावकः।\nन दैन्यं नाशुभं किञ्चिद्विद्यते तत्र वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2093568, "chapter_id": 2999, "verse_number": "१३-१२९-३९", "content_sanskrit": "तत्र दिव्यान्यरण्यानि दिव्यानि भवनानि च।\nविमानानि सुयुक्तानि कामगानि च वासव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2093569, "chapter_id": 2999, "verse_number": "१३-१२९-४०", "content_sanskrit": "ब्रह्मचर्येण तपसा सत्येन च दमेन च।\nदानैश्च विविधैः पुण्यैस्तथा तीर्थानुसेवनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2093570, "chapter_id": 2999, "verse_number": "१३-१२९-४१", "content_sanskrit": "तपसा महता चैव सुकृतेन च कर्मणा।\nशक्यः समासादयितुं गोलोकः पुष्करेक्षण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2093571, "chapter_id": 2999, "verse_number": "१३-१२९-४२", "content_sanskrit": "एतत्ते सर्वमाख्यातं मया शक्रानुपृच्छते।\nन ते परिभवः कार्यो गवामसुरसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2093572, "chapter_id": 2999, "verse_number": "१३-१२९-४३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2093573, "chapter_id": 2999, "verse_number": "१३-१२९-४३", "content_sanskrit": "एतच्छ्रुत्वा सहस्राक्षः पूजयामास नित्यदा।\nगाश्चक्रे बहुमानं च तासु नित्यं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2093574, "chapter_id": 2999, "verse_number": "१३-१२९-४४", "content_sanskrit": "एतत्ते सर्वमाख्यातं पावनं च महाद्युते।\nपवित्रं परमं चापि गवां माहात्म्यमुत्तमम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2093575, "chapter_id": 2999, "verse_number": "१३-१२९-४५", "content_sanskrit": "कीर्तितं पुरुषव्याघ्र सर्वपापविमोचनम्।\nय इदं कथयेन्नित्यं ब्राह्मणेभ्यः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2093576, "chapter_id": 2999, "verse_number": "१३-१२९-४६", "content_sanskrit": "हव्यकव्येषु यज्ञेषु पितृकार्येषु चैव ह।\nसार्वकामिकमक्षय्यं पितॄंस्तस्योपतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2093577, "chapter_id": 2999, "verse_number": "१३-१२९-४७", "content_sanskrit": "गोषु भक्तश्च लभते यद्यदिच्छति मानवः।\nस्त्रियोपि भक्ता या गोषु ताश्च काममवाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2093578, "chapter_id": 2999, "verse_number": "१३-१२९-४८", "content_sanskrit": "पुत्रार्थीं लभते पुत्रं कन्यार्थी तामवाप्नुयात्।\nधनार्थी लभते वित्तं धर्मार्थी धर्ममाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2093579, "chapter_id": 2999, "verse_number": "१३-१२९-४९", "content_sanskrit": "विद्यार्थी चाप्नुयाद्विद्यां सुखार्थी प्राप्नुयात्सुखम्।\nन किञ्चिद्दुर्लभं चैव गवां भक्तस्य भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2093580, "chapter_id": 2999, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनत्रिंशदधिकशततमोऽध्यायः॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]