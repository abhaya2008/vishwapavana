[{"id": 2007484, "chapter_id": 1145, "verse_number": "१-१४६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007485, "chapter_id": 1145, "verse_number": "१-१४६-१", "content_sanskrit": "एतस्मिन्नेव काले तु तस्मिञ्जनसमागमे।\nदत्तेऽवकाशे पुरुषैर्विस्मयोत्फुल्ललोचनः।\nविवेश रङ्गं विस्तीर्णं कर्णः परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007486, "chapter_id": 1145, "verse_number": "१-१४६-२", "content_sanskrit": "सहजं कवचं बिभ्रत्कुण्डलोद्द्योतिताननः।\nस धनुर्बद्धनिस्त्रिंशः पादचारीव पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007487, "chapter_id": 1145, "verse_number": "१-१४६-३", "content_sanskrit": "कन्यागर्भः पृथुयशाः पृथायाः पृथुलोचनः।\nतीक्ष्णांशोर्भास्करस्यांशः कर्णोऽरिगणसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007488, "chapter_id": 1145, "verse_number": "१-१४६-४", "content_sanskrit": "सिंहर्षभगजेन्द्राणां बलवीर्यपराक्रमः।\nदीप्तिकान्तिद्युतिगुणैः सूर्येन्दुज्वलनोपमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007489, "chapter_id": 1145, "verse_number": "१-१४६-५", "content_sanskrit": "प्रांशुः कनकतालाभः सिंहसंहननो युवा।\nअसङ्ख्येयगुणः श्रीमान्भास्करस्यात्मसंभवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007490, "chapter_id": 1145, "verse_number": "१-१४६-६", "content_sanskrit": "स निरीक्ष्य महाबाहुः सर्वतो रङ्गमण्डलम्।\nप्रणामं द्रोणकृपयोर्नात्यादृतमिवाकरोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007491, "chapter_id": 1145, "verse_number": "१-१४६-७", "content_sanskrit": "स समाजजनः सर्वो निश्चलः स्थिरलोचनः।\nकोऽयमित्यागतक्षोभः कौतूहलपरोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007492, "chapter_id": 1145, "verse_number": "१-१४६-८", "content_sanskrit": "सोऽब्रवीन्मेघगम्भीरस्वरेण वदतां वरः।\nभ्राता भ्रातरमज्ञातं सावित्रः पाकशासनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007493, "chapter_id": 1145, "verse_number": "१-१४६-९", "content_sanskrit": "पार्थ यत्ते कृतं कर्म विशेषवदहं ततः।\nकरिष्ये पश्यतां नॄणां माऽऽत्मना विस्मयं गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007494, "chapter_id": 1145, "verse_number": "१-१४६-१०", "content_sanskrit": "असमाप्ते ततस्तस्य वचने वदतां वर।\nयन्त्रोत्क्षिप्त इवोत्तस्थौ क्षिप्रं वै सर्वतो जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007495, "chapter_id": 1145, "verse_number": "१-१४६-११", "content_sanskrit": "प्रीतिश्च मनुजव्याघ्र दुर्योधनमुपाविशत्।\nह्रीश्च क्रोधश्च बीभत्सुं क्षणेनान्वाविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007496, "chapter_id": 1145, "verse_number": "१-१४६-१२", "content_sanskrit": "ततो द्रोणाभ्यनुज्ञातः कर्णः प्रियरणः सदा।\nयत्कृतं तत्र पार्थेन तच्चकार महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007497, "chapter_id": 1145, "verse_number": "१-१४६-१३", "content_sanskrit": "अथ दुर्योधनस्तत्र भ्रातृभिः सह भारत।\nकर्णं परिष्वज्य मुदा ततो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007498, "chapter_id": 1145, "verse_number": "१-१४६-१४", "content_sanskrit": "स्वागतं ते महाबाहो दिष्ट्या प्राप्तोऽसि मानद।\nअहं च कुरुराज्यं च यथेष्टमुपभुज्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007499, "chapter_id": 1145, "verse_number": "१-१४६-१५x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007500, "chapter_id": 1145, "verse_number": "१-१४६-१५", "content_sanskrit": "कृतं सर्वमहं मन्ये सखित्वं च त्वया वृणे।\nद्वन्द्वयुद्धं च पार्थेन कर्तुमिच्छाम्यहं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007501, "chapter_id": 1145, "verse_number": "१-१४६-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007502, "chapter_id": 1145, "verse_number": "१-१४६-१६", "content_sanskrit": "एवमुक्तस्तु कर्णेन राजन्दुर्योधनस्तदा।\nकर्णं दीर्घाञ्चितभुजं परिष्वज्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007503, "chapter_id": 1145, "verse_number": "१-१४६-१७", "content_sanskrit": "भुङ्क्ष्व भोगान्मया सार्धं बन्धूनां प्रियकृद्भव।\nदुर्हृदां कुरु सर्वेषां मूर्ध्नि पादमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007504, "chapter_id": 1145, "verse_number": "१-१४६-१८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007505, "chapter_id": 1145, "verse_number": "१-१४६-१८", "content_sanskrit": "ततः क्षिप्तमिवात्मानं मत्वा पार्थोऽभ्यभाषत।\nकर्णं भ्रातृसमूहस्य मध्येऽचलमिव स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007506, "chapter_id": 1145, "verse_number": "१-१४६-१९x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007507, "chapter_id": 1145, "verse_number": "१-१४६-१९", "content_sanskrit": "अनाहूतोपसृष्टानामनाहूतोपजल्पिनाम्।\nये लोकास्तान्हतः कर्ण मया त्वं प्रतिपत्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007508, "chapter_id": 1145, "verse_number": "१-१४६-२०x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007509, "chapter_id": 1145, "verse_number": "१-१४६-२०", "content_sanskrit": "रङ्गोऽयं सर्वसामान्यः किमत्र तव फाल्गुन।\nवीर्यश्रेष्ठाश्च राजानो बलं धर्मोऽनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007510, "chapter_id": 1145, "verse_number": "१-१४६-२१", "content_sanskrit": "किं क्षेपैर्दुर्बलायासैः शरैः कथय भारत।\nगुरोः समक्षं यावत्ते हराम्यद्य शिरः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007511, "chapter_id": 1145, "verse_number": "१-१४६-२२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007512, "chapter_id": 1145, "verse_number": "१-१४६-२२", "content_sanskrit": "ततो द्रोणाभ्यनुज्ञातः पार्तः परपुरञ्जयः।\nभ्रातृभिस्त्वरयाश्लिष्टो रणायोपजगाम तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007513, "chapter_id": 1145, "verse_number": "१-१४६-२३", "content_sanskrit": "ततो दुर्योधनेनापि स भ्रात्रा समरोद्यतः।\nपरिष्वक्तः स्थितः कर्णः प्रगृह्य सशरं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007514, "chapter_id": 1145, "verse_number": "१-१४६-२४", "content_sanskrit": "ततः सविद्युत्स्तनितैः सेन्द्रायुधपुरोगमैः।\nआवृतं गगनं मेघैर्बलाकापङ्क्तिहासिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007515, "chapter_id": 1145, "verse_number": "१-१४६-२५", "content_sanskrit": "ततः स्नेहाद्धरिहयं दृष्ट्वा रङ्गावलोकिनम्।\nभास्करोऽप्यनयन्नाशं समीपोपगतान्घनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007516, "chapter_id": 1145, "verse_number": "१-१४६-२६", "content_sanskrit": "मेघच्छायोपगूढस्तु ततोऽदृश्यत फाल्गुनः।\nसूर्यातपपरिक्षिप्तः कर्णोऽपि समदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007517, "chapter_id": 1145, "verse_number": "१-१४६-२७", "content_sanskrit": "धार्तराष्ट्रा यतः कर्णस्तस्मिन्देशे व्यवस्थिताः।\nभारद्वाजः कृपो भीष्मो यतः पार्थस्ततोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007518, "chapter_id": 1145, "verse_number": "१-१४६-२८", "content_sanskrit": "द्विधा रङ्गः समभवत्स्त्रीणां द्वैधमजायत।\nकुन्तिभोजसुता मोहं विज्ञातार्था जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007519, "chapter_id": 1145, "verse_number": "१-१४६-२९", "content_sanskrit": "तां तथा मोहमापन्नां विदुरः सर्वधर्मवित्।\nकुन्तीमाश्वासयामास प्रेष्याभिश्चन्दनोदकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007520, "chapter_id": 1145, "verse_number": "१-१४६-३०", "content_sanskrit": "ततः प्रत्यागतप्राणा तावुभौ परिदंशितौ।\nपुत्रौ दृष्ट्वा सुसंभ्रान्ता नान्वपद्यत किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007521, "chapter_id": 1145, "verse_number": "१-१४६-३१", "content_sanskrit": "तावुद्यतमहाचापौ कृपः शारद्वतोऽब्रवीत्।\nद्वन्द्वयुद्धसमाचारे कुशलः सर्वधर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007522, "chapter_id": 1145, "verse_number": "१-१४६-३२", "content_sanskrit": "अयं पृथायास्तनयः कनीयान्पाण्डुनन्दनः।\nकौरवो भवता सार्धं द्वन्द्वयुद्धं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007523, "chapter_id": 1145, "verse_number": "१-१४६-३३", "content_sanskrit": "त्वमप्येवं महाबाहो मातरं पितरं कुलम्।\nकथयस्व नरेन्द्राणां येषां त्वं कुलभूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007524, "chapter_id": 1145, "verse_number": "१-१४६-३४", "content_sanskrit": "ततो विदित्वा पार्थस्त्वां प्रतियोत्स्यति वा न वा।\nवृथाकुलसमाचारैर्न युध्यन्ते नृपात्मजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007525, "chapter_id": 1145, "verse_number": "१-१४६-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007526, "chapter_id": 1145, "verse_number": "१-१४६-३५", "content_sanskrit": "एवमुक्तस्य कर्णस्य व्रीडावनतमाननम्।\nबभौ वर्षाम्बुविक्लिन्नं पद्ममागलितं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007527, "chapter_id": 1145, "verse_number": "१-१४६-३६x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007528, "chapter_id": 1145, "verse_number": "१-१४६-३६", "content_sanskrit": "आचार्य त्रिविधा योनी राज्ञां शास्त्रविनिश्चये।\nसत्कुलीनश्च शूरश्च यश्च सेनां प्रकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007529, "chapter_id": 1145, "verse_number": "१-१४६-३७", "content_sanskrit": "अद्भ्योऽग्निर्ब्रह्मतः क्षत्रमश्मनो लोहमुत्थितम्।\nतेषां सर्वत्रगं तेजः स्वासु योनिषु शाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007530, "chapter_id": 1145, "verse_number": "१-१४६-३८", "content_sanskrit": "यद्ययं फाल्गुनो युद्धे नाराज्ञा योद्धुमिच्छति।\nतस्मादेषोऽङ्गविषये मया राज्येऽभिषिच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2007531, "chapter_id": 1145, "verse_number": "१-१४६-३९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2007532, "chapter_id": 1145, "verse_number": "१-१४६-३९", "content_sanskrit": "ततो राजानमामन्त्र्य गाङ्गेयं च पितामहम्।\nअभिषेकस्य संभारान्समानीय द्विजातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2007533, "chapter_id": 1145, "verse_number": "१-१४६-४०", "content_sanskrit": "गोसहस्रायुतं दत्त्वा युक्तानां पुण्यकर्मणाम्।\nअर्होऽयमङ्गराज्यस्य इति वाच्य द्विजातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2007534, "chapter_id": 1145, "verse_number": "१-१४६-४१", "content_sanskrit": "ततस्तस्मिन्क्षणे कर्णः सलाजकुसुमैर्घटैः।\nकाञ्चनैः काञ्चने पीठे मन्त्रविद्भिर्महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2007535, "chapter_id": 1145, "verse_number": "१-१४६-४२", "content_sanskrit": "अभिषिक्तोऽङ्गराजे स श्रिया युक्तो महाबलः।\nस मौलिहारकेयूरः सहस्ताभरणाङ्गदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2007536, "chapter_id": 1145, "verse_number": "१-१४६-४३", "content_sanskrit": "राजलिङ्गैस्तथाऽन्यैश्च भूषितो भूषणैः शुभैः।\nसच्छत्रवालव्यजनो जयशब्दोत्तरेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2007537, "chapter_id": 1145, "verse_number": "१-१४६-४४", "content_sanskrit": "उवाच कौरवं राजन्वचनं स वृषस्तदा।\nअस्य राज्यप्रदानस्य सदृशं किं ददानि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2007538, "chapter_id": 1145, "verse_number": "१-१४६-४५", "content_sanskrit": "प्रब्रूहि राजशार्दूल कर्ता ह्यस्मि तथा नृप।\nअत्यन्तं सख्यमिच्छामीत्याह तं स सुयोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2007539, "chapter_id": 1145, "verse_number": "१-१४६-४६", "content_sanskrit": "एवमुक्तस्ततः कर्णस्तथेति प्रत्युवाच तम्।\nहर्षाच्चोभौ समाश्लिष्य परां मुदमवापतुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2007540, "chapter_id": 1145, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि षट्चत्वारिंशदधिकशततमोऽध्यायः॥ १४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]