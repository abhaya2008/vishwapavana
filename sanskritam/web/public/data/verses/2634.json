[{"id": 2077039, "chapter_id": 2634, "verse_number": "१२-१३९-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077040, "chapter_id": 2634, "verse_number": "१२-१३९-१", "content_sanskrit": "उक्तो मन्त्रो महाबाहो विश्वासो नास्ति शत्रुषु।\nकथं हि राजा वर्तेत यदि सर्वत्र नाश्वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077041, "chapter_id": 2634, "verse_number": "१२-१३९-२", "content_sanskrit": "विश्वासाद्धि परं राजन्राज्ञामुत्पद्यते भयम्।\nकथं हि नाश्वसन्राजा शत्रूञ्जयति पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077042, "chapter_id": 2634, "verse_number": "१२-१३९-३", "content_sanskrit": "एतन्मे संशयं छिन्धि मनो मे संप्रमुह्यति।\nअविश्वासे कथामेतामुपाश्रित्य पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077043, "chapter_id": 2634, "verse_number": "१२-१३९-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077044, "chapter_id": 2634, "verse_number": "१२-१३९-४", "content_sanskrit": "शृणुष्व राजन्यो वृत्तो ब्रह्मदत्तनिवेशने।\nपूजन्या सह संवादो ब्रह्मदत्तस्य भूपतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077045, "chapter_id": 2634, "verse_number": "१२-१३९-५", "content_sanskrit": "काम्पिल्ये ब्रह्मदत्तस्य त्वन्तः पुरनिवासिनी।\nपूजी नाम शकुनिर्दीर्घकालं सहोपिता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077046, "chapter_id": 2634, "verse_number": "१२-१३९-६", "content_sanskrit": "रुदज्ञा सर्वभूतानां यथा वै जीवजीवकः।\nसर्वज्ञा सर्वतत्त्वज्ञा तिर्यग्योनिं गताऽपि स॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077047, "chapter_id": 2634, "verse_number": "१२-१३९-७", "content_sanskrit": "अभिप्रजाता सा तत्र पुत्रमेकं सुवर्चसम्।\nसमकालं च राज्ञोऽपि देव्यां पुत्रो व्यजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077048, "chapter_id": 2634, "verse_number": "१२-१३९-८", "content_sanskrit": "तयोरर्थे कृतज्ञा तु खेचरी पूजनी सदा।\nसमद्रतीरं सा गत्वा आजहार फलद्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077049, "chapter_id": 2634, "verse_number": "१२-१३९-९", "content_sanskrit": "अष्ट्यर्थं च स्वपुत्रस्य राजपुत्रस्य चैव ह।\nलमेकं सुतायादाद्राजपुत्राय चापरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077050, "chapter_id": 2634, "verse_number": "१२-१३९-१०", "content_sanskrit": "---मृतास्यादसदृशं बलतेजोभिवर्धनम्।\n[आदायादाय सैवाशु तयोः प्रादात्पुनः पुनः॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077051, "chapter_id": 2634, "verse_number": "१२-१३९-११", "content_sanskrit": "ततोऽगच्छत्परां वृद्धिं राजपुत्रः फलाशनात्।\nततः स धात्र्या कक्षेण उह्यमानो नृपात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077052, "chapter_id": 2634, "verse_number": "१२-१३९-१२", "content_sanskrit": "ददर्श तं पक्षिसुतं बाल्यादागत्य बालकः।\nततो बाल्याच्च यत्नेन तेनाक्रीडत पक्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077053, "chapter_id": 2634, "verse_number": "१२-१३९-१३", "content_sanskrit": "शून्ये च तमुपादाय पक्षिणं समजातकम्।\nहत्वा ततः स राजेन्द्र धात्र्या हस्तमुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077054, "chapter_id": 2634, "verse_number": "१२-१३९-१४", "content_sanskrit": "अथ सा पूजनी राजन्नागमत्फलहारिणी।\nअपश्यन्निहतं पुत्रं तेन बालेन भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077055, "chapter_id": 2634, "verse_number": "१२-१३९-१५", "content_sanskrit": "बाष्पपूर्णमुखी दीना दृष्ट्वा तं पतितं सुतम्।\nपूजनी दुःखसंतप्ता रुदन्ती वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077056, "chapter_id": 2634, "verse_number": "१२-१३९-१६", "content_sanskrit": "क्षत्रिये संगतं नास्ति न प्रीतिर्न च सौहृदम्।\nकारणे सान्त्वयन्त्येते कृतार्थाः संत्यजन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077057, "chapter_id": 2634, "verse_number": "१२-१३९-१७", "content_sanskrit": "क्षत्रियेषु न विश्वासः कार्यः सर्वापकारिषु।\nअपकृत्यापि सततं सान्त्वयन्ति निरर्थकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077058, "chapter_id": 2634, "verse_number": "१२-१३९-१८", "content_sanskrit": "इयमस्य करोम्यद्य सदृशीं वैरयातनाम्।\nकृतघ्नस्य नृशंसस्य भृशं विश्वासघातिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077059, "chapter_id": 2634, "verse_number": "१२-१३९-१९", "content_sanskrit": "सहसंजातवृद्धस्य तथैव सहभोजिनः।\nशरण्यस्य वधश्चैव त्रिविधं तस्य किल्विषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077060, "chapter_id": 2634, "verse_number": "१२-१३९-२०", "content_sanskrit": "इत्युक्त्वा चरणाभ्यां तु नेत्रे नृपसुतस्य सा।\nहृत्वा स्वस्था तत इदं पूजनी वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077061, "chapter_id": 2634, "verse_number": "१२-१३९-२१", "content_sanskrit": "इच्छयेह कृतं पापं सद्य एवोपसर्पति।\nकृतं प्रतिकृतं येषां न नश्यति शुभाशुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077062, "chapter_id": 2634, "verse_number": "१२-१३९-२२", "content_sanskrit": "पापं कर्म कृतं किंचिद्यदि तस्मिन्न दृश्यते।\nनिपात्यतेऽस्य पुत्रेषु पौत्रेष्वपि च नप्नृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077063, "chapter_id": 2634, "verse_number": "१२-१३९-२३", "content_sanskrit": "ब्रह्मदत्तः सुतं दृष्ट्वा पूजन्या हृतलोचनम्।\nकृतप्रतिकृतं मत्वा पूजनीमिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077064, "chapter_id": 2634, "verse_number": "१२-१३९-२४", "content_sanskrit": "अस्ति वै कृतमस्माभिरस्ति प्रतिकृतं त्वया।\nउभयं तत्समीभूतं वस पूजनि मा गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077065, "chapter_id": 2634, "verse_number": "१२-१३९-२५x", "content_sanskrit": "पूजन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077066, "chapter_id": 2634, "verse_number": "१२-१३९-२५", "content_sanskrit": "सकृत्कृतापराधस्य तत्रैव परिलम्बतः।\nन तद्बुधाः प्रशंसन्ति श्रेयस्तत्रापसर्पणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077067, "chapter_id": 2634, "verse_number": "१२-१३९-२६", "content_sanskrit": "सान्त्वे प्रयुक्ते विवृते वैरे चैव न विश्वसेत्।\nक्षिप्रं स हन्यते मूढो न हि वैरं प्रशाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077068, "chapter_id": 2634, "verse_number": "१२-१३९-२७", "content_sanskrit": "अन्योन्यकृतवैराणां पुत्रपौत्रं नियच्छति।\nपुत्रपौत्रविनाशे च परलोकं नियच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077069, "chapter_id": 2634, "verse_number": "१२-१३९-२८", "content_sanskrit": "सर्वेषां कृतवैराणामविश्वासः सुखावहः।\nएकान्ततो न विश्वासः कार्यो विश्वासघातके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077070, "chapter_id": 2634, "verse_number": "१२-१३९-२९", "content_sanskrit": "न विश्वसेदविश्वस्ते विश्वस्ते नातिविश्वसेत्।\nविश्वासाद्भयमुत्पन्नमपि मूलं निकृन्तति।\nकामं विश्वासयेदन्यान्परेषां च न विश्वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077071, "chapter_id": 2634, "verse_number": "१२-१३९-३०", "content_sanskrit": "माता पिता बान्धवानां वरिष्ठौ\nभार्या क्षेत्रं बीजमात्रं तु पुत्रः।\nभ्राता शत्रुः क्लिन्नपाणिर्वयस्य\nआत्मा ह्येकः सुखदुःखस्य भोक्ता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077072, "chapter_id": 2634, "verse_number": "१२-१३९-३१", "content_sanskrit": "अन्योन्यकृतवैराणां न संधिरुपपद्यते।\nस च हेतुरतिक्रान्तो यदर्थमहमावसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2077073, "chapter_id": 2634, "verse_number": "१२-१३९-३२", "content_sanskrit": "पूजितस्यार्थमानाभ्यां सान्त्वं पूर्वापकारिणः।\nहृदयं भवत्यविश्वस्तं कर्म त्रासयते बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2077074, "chapter_id": 2634, "verse_number": "१२-१३९-३३", "content_sanskrit": "पूर्वं संमानना यत्र पश्चाच्चैव विमानना।\nजह्यात्स सत्ववान्वासं संमानितविमानितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2077075, "chapter_id": 2634, "verse_number": "१२-१३९-३४", "content_sanskrit": "उषिताऽस्मि तवागारे दीर्घकालमहिंसिता।\nतदिदं वैरमुत्पन्नं सुखमास्ख व्रजाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2077076, "chapter_id": 2634, "verse_number": "१२-१३९-३५x", "content_sanskrit": "ब्रह्मदत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2077077, "chapter_id": 2634, "verse_number": "१२-१३९-३५", "content_sanskrit": "यः कृते प्रतिकुर्याद्वै न स तत्रापराध्नुयात्।\nअनृणस्तेन भवति वस पूजनि मागमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2077078, "chapter_id": 2634, "verse_number": "१२-१३९-३६x", "content_sanskrit": "पूजन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2077079, "chapter_id": 2634, "verse_number": "१२-१३९-३६", "content_sanskrit": "न कृतस्य तु कर्तुश्च सख्यं संधीयते पुनः।\nहृदयं तत्र जानाति कर्तुश्चैव कृतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2077080, "chapter_id": 2634, "verse_number": "१२-१३९-३७x", "content_sanskrit": "ब्रह्मदत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2077081, "chapter_id": 2634, "verse_number": "१२-१३९-३७", "content_sanskrit": "कृतस्य चैव कर्तुश्च सख्यं संधीयते पुनः।\nवैरस्योपशमो दृष्टः पापं नोपाश्नुते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2077082, "chapter_id": 2634, "verse_number": "१२-१३९-३८x", "content_sanskrit": "पूजन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2077083, "chapter_id": 2634, "verse_number": "१२-१३९-३८", "content_sanskrit": "नास्ति वैरमतिक्रान्तं सान्त्वितोऽस्मीति नाश्वसेत्।\nविश्वासाद्बध्यते लोकस्तस्माच्छ्रेयोप्यदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2077084, "chapter_id": 2634, "verse_number": "१२-१३९-३९", "content_sanskrit": "तरसा ये न शक्यन्ते शस्त्रैः सुनिसितैरपि।\nसाम्ना तेऽपि निगृह्यते गजा इव करेणुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2077085, "chapter_id": 2634, "verse_number": "१२-१३९-४०x", "content_sanskrit": "ब्रह्मदत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2077086, "chapter_id": 2634, "verse_number": "१२-१३९-४०", "content_sanskrit": "संवासाज्जायते स्नेहो जीवितान्तकरेष्वपि।\nअन्योन्यस्य हि विश्वासः श्वानश्वपचयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2077087, "chapter_id": 2634, "verse_number": "१२-१३९-४१", "content_sanskrit": "अन्योन्यकृतवैराणां संवासान्मृदुतां गतम्।\nनैव तिष्ठति तद्वैरं पुष्करस्थमिवोदकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2077088, "chapter_id": 2634, "verse_number": "१२-१३९-४२x", "content_sanskrit": "पूजन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2077089, "chapter_id": 2634, "verse_number": "१२-१३९-४२", "content_sanskrit": "वैरं पञ्चसमुत्थानं तच्च बुध्यन्ति पण्डिताः।\nस्त्रीकृतं वास्तुजं वाग्जं स्वसपत्नापराधजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2077090, "chapter_id": 2634, "verse_number": "१२-१३९-४३", "content_sanskrit": "तत्र दाता न हन्तव्यः क्षत्रियेण विशेषतः।\nप्रकाशं वाऽप्रकाशं वा बुद्ध्वा दोषबलाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2077091, "chapter_id": 2634, "verse_number": "१२-१३९-४४", "content_sanskrit": "कृतवैरे न विश्वासः कार्यस्त्विह सुहृद्यपि।\nप्रच्छन्नं तिष्ठते वैरं गूढोऽग्निरिव दारुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2077092, "chapter_id": 2634, "verse_number": "१२-१३९-४५", "content_sanskrit": "न वित्तेन न पारुष्यैर्न च सान्त्वेन च श्रुतैः।\nवैराग्निः शाम्यते राजन्निमग्नोऽग्निरिवार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2077093, "chapter_id": 2634, "verse_number": "१२-१३९-४६", "content_sanskrit": "न हि वैराग्निरुद्धूतः कर्म चाप्यपराधजम्।\nशाम्यत्यदग्ध्वा नृपते विना ह्येकतरक्षयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2077094, "chapter_id": 2634, "verse_number": "१२-१३९-४७", "content_sanskrit": "सत्कृतस्यार्थामनाभ्यां तत्र पूर्वापकारिणः।\nनैव शान्तिर्न विश्वासः कर्मणा जायते बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2077095, "chapter_id": 2634, "verse_number": "१२-१३९-४८", "content_sanskrit": "नैवापकारे कस्मिंश्चिदहं त्वयि तथा भवान्।\nउषितावाऽपि चक्रितं नेदानीं विश्वसाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2077096, "chapter_id": 2634, "verse_number": "१२-१३९-४९x", "content_sanskrit": "ब्रह्मदत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2077097, "chapter_id": 2634, "verse_number": "१२-१३९-४९", "content_sanskrit": "कालेन क्रियते कार्यं तथैव विविधाः क्रियाः\nकालेनैव प्रवर्तन्ते कः कस्येत्यपराध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2077098, "chapter_id": 2634, "verse_number": "१२-१३९-५०", "content_sanskrit": "तुल्यं चोभे प्रवर्तेते मरणं जन्म चैव हि।\nकार्यते चैव कालेन तन्निमित्तं न जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2077099, "chapter_id": 2634, "verse_number": "१२-१३९-५१", "content_sanskrit": "बध्यन्ते युगपत्केचिदेकैकं चापरे तथा।\nकालो दहति भूतानि संप्राप्तोऽग्निरिवेन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2077100, "chapter_id": 2634, "verse_number": "१२-१३९-५२", "content_sanskrit": "नाहं प्रमाणं नैव त्वभन्योन्यं कारणं शुभे।\nकालो नित्यमुपादत्ते सुखं दुःखं च देहिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2077101, "chapter_id": 2634, "verse_number": "१२-१३९-५३", "content_sanskrit": "एवं वसेह सन्नेहा यथाकाममहिंसिता।\nयत्कृतं तत्तु मे क्षान्तं त्वं च वै क्षम पूजनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2077102, "chapter_id": 2634, "verse_number": "१२-१३९-५४x", "content_sanskrit": "पूजन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2077103, "chapter_id": 2634, "verse_number": "१२-१३९-५४", "content_sanskrit": "यदि कालः प्रमाणं ते न वैरं कस्यचिद्भवेत्।\nकस्मादपचितिं यान्ति बान्धवा बान्धवे हते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2077104, "chapter_id": 2634, "verse_number": "१२-१३९-५५", "content_sanskrit": "कस्माद्देवासुराः सर्वे अन्योन्यमभिजघ्निरे।\nयदि कालेन निर्याणं सुखदुःखे भवाभवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2077105, "chapter_id": 2634, "verse_number": "१२-१३९-५६", "content_sanskrit": "भिषजो भैषजं कर्तुं कस्मादिच्छन्ति रोगिणः।\nयदि कालेन पच्यन्ते भेषजैः किं प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2077106, "chapter_id": 2634, "verse_number": "१२-१३९-५७", "content_sanskrit": "प्रलापः सुमहान्कस्मात्क्रियते शोकमूर्च्छितैः।\nयदि कालः प्रमाणं ते कस्माद्धर्मोऽस्ति कर्तृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2077107, "chapter_id": 2634, "verse_number": "१२-१३९-५८", "content_sanskrit": "तव पुत्रो ममापत्यं हतवान्हिंसितो मया।\nअनन्तरं त्वयाहं च बाधितव्या महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2077108, "chapter_id": 2634, "verse_number": "१२-१३९-५९", "content_sanskrit": "अहं हि पुत्रशोकेन कृतपापा तवात्मजे।\nतथा त्वया प्रहर्तव्यं मयि तत्त्वं च मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2077109, "chapter_id": 2634, "verse_number": "१२-१३९-६०", "content_sanskrit": "भक्षार्थं क्रीडनार्थं च नरा वाञ्छन्ति पक्षिणः।\nतृतीयो नास्ति संयोगो वधबन्धादृते क्षमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2077110, "chapter_id": 2634, "verse_number": "१२-१३९-६१", "content_sanskrit": "वधबन्धभयादेके मोक्षतन्त्रमुपाश्रिताः।\nजनीमरणजं दुःखं प्राहुर्वेदविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2077111, "chapter_id": 2634, "verse_number": "१२-१३९-६२", "content_sanskrit": "सर्वस्य दयिताः प्राणाः सर्वस्य दयिताः सुताः।\nदुःखादुद्विजते सर्वं सर्वस्य सुखमीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2077112, "chapter_id": 2634, "verse_number": "१२-१३९-६३", "content_sanskrit": "दुःखं जरा ब्रह्मदत्त दुःखमर्थविपर्ययः।\nदुःखं चानिष्टसंवासो दुःखमिष्टवियोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2077113, "chapter_id": 2634, "verse_number": "१२-१३९-६४", "content_sanskrit": "वैरबन्धकृतं दुःखं स्त्रीकृतं सह तथा।\nदुःखं दुःखेन सततं विवर्धति---- धिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2077114, "chapter_id": 2634, "verse_number": "१२-१३९-६५", "content_sanskrit": "न दुःखं परदुःखे वै केचिदाहुर----यः।\nयो दुःखं नाभिजानाति स जल्पति माहाजने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2077115, "chapter_id": 2634, "verse_number": "१२-१३९-६६", "content_sanskrit": "यस्तु शोचति दुःखार्ताः स कथं वक्तमुत्सहेत।\nरसज्ञः सर्वदुःखस्य यथाऽऽत्मनि तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2077116, "chapter_id": 2634, "verse_number": "१२-१३९-६७", "content_sanskrit": "`भिन्ना श्लिष्टा न सज्यन्ते शस्त्रैः सुनिशितैरपि।\nसाम्ना तेऽपि निगृह्यन्ते गजा इव करेणुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2077117, "chapter_id": 2634, "verse_number": "१२-१३९-६८", "content_sanskrit": "यत्कृतं ते मया राजंस्त्वया च मम यत्कृतम्।\nन तद्वर्षशतैः शक्यं व्यपोहितुमरिंदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2077118, "chapter_id": 2634, "verse_number": "१२-१३९-६९", "content_sanskrit": "आवयोः कृतमन्योन्यं तस्य संधिर्न विद्यते।\nस्मृत्वास्मृत्वा हि ते पुत्रं नवं वैरं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2077119, "chapter_id": 2634, "verse_number": "१२-१३९-७०", "content_sanskrit": "वैरमन्तिकमासाद्य यः प्रीतिं कर्तुमिच्छति।\nमृण्मयस्येव भग्नस्य तस्य संधिर्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2077120, "chapter_id": 2634, "verse_number": "१२-१३९-७१", "content_sanskrit": "निश्चयः स्वार्थशास्त्रेषु न विश्वासः सुखोदयः।\nउशना चैव गाथे द्वे प्रह्लादायाब्रवीत्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2077121, "chapter_id": 2634, "verse_number": "१२-१३९-७२", "content_sanskrit": "ये वैरिणः श्रद्दधते सत्ये सत्येतरेऽपि वा।\nवध्यन्ते श्रद्दधाना हि मधु शुष्कतृणैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2077122, "chapter_id": 2634, "verse_number": "१२-१३९-७३", "content_sanskrit": "न हि वैराणि शाम्यन्ति कुलेष्वादशमाद्युगात्।\nआख्यातारश्च विद्यन्ते कुले चेज्जायते पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2077123, "chapter_id": 2634, "verse_number": "१२-१३९-७४", "content_sanskrit": "उपगृह्य तु वैराणि सान्त्वयन्ति नराधिपाः।\nअथैनं प्रतिहिंसन्ति पूर्णं घटमिवाश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2077124, "chapter_id": 2634, "verse_number": "१२-१३९-७५", "content_sanskrit": "सदा न विश्वसेद्राजन्पापं कृत्वेह कस्यचित्।\nअपकृत्य परेषां हि विश्वासाद्दुःखमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2077125, "chapter_id": 2634, "verse_number": "१२-१३९-७६x", "content_sanskrit": "ब्रह्मदत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2077126, "chapter_id": 2634, "verse_number": "१२-१३९-७६", "content_sanskrit": "नाविश्वासाच्चिनोत्यर्थमीहते चापि किंचन।\nभयात्त्वेकतरं मित्रं कृतकृत्या भवत्विह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2077127, "chapter_id": 2634, "verse_number": "१२-१३९-७७x", "content_sanskrit": "पूजन्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2077128, "chapter_id": 2634, "verse_number": "१२-१३९-७७", "content_sanskrit": "यस्येह व्रणिनौ पादौ पभ्द्यां च परिधावतः।\nक्षिण्येते तस्य तौ पादौ सुगुप्तमपि धावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2077129, "chapter_id": 2634, "verse_number": "१२-१३९-७८", "content_sanskrit": "नेत्राभ्यां सरुजाभ्यां यः प्रतिवातमुदीक्षते।\nतस्य वायुरुजाऽत्यर्थं नेत्रयोर्भवति ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2077130, "chapter_id": 2634, "verse_number": "१२-१३९-७९", "content_sanskrit": "दुष्टं पन्थानमासाद्य यो मोहादभिपद्यते।\nआत्मनो बलमज्ञात्वा तदन्तं तस्य जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2077131, "chapter_id": 2634, "verse_number": "१२-१३९-८०", "content_sanskrit": "यस्तु वर्षमविज्ञाय क्षेत्रं कर्षति कर्षकः।\nहीनः पुरुषकारेण तस्य वै नाप्नुते फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2077132, "chapter_id": 2634, "verse_number": "१२-१३९-८१", "content_sanskrit": "यस्तु तिक्तं कषायं वा स्वादु वा मधुरं हितम्।\nआहारं कुरुते नित्यं सोऽमृतत्वाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2077133, "chapter_id": 2634, "verse_number": "१२-१३९-८२", "content_sanskrit": "पथ्यं मुक्त्वा तु यो मोहाद्दुष्टमश्नाति भोजनम्।\nपरिणाममविज्ञाय तदन्तं तस्य जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2077134, "chapter_id": 2634, "verse_number": "१२-१३९-८३", "content_sanskrit": "दैवं पुरुषकारश्च स्थितावन्योन्यसंश्रयात्।\nउदात्तं कर्म वै तत्र दैवं क्लीबा उपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2077135, "chapter_id": 2634, "verse_number": "१२-१३९-८४", "content_sanskrit": "कर्म चात्महितं कार्यं तीक्ष्णं वा यदि वा मृदु।\nग्रस्यतेऽकर्मशीलस्तु सदाऽनर्थैरकिंचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2077136, "chapter_id": 2634, "verse_number": "१२-१३९-८५", "content_sanskrit": "तस्मात्संशयितव्येऽर्थे कार्य एव पराक्रमः।\nसर्वस्वमपि संत्यज्य कार्यमात्महितं नरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2077137, "chapter_id": 2634, "verse_number": "१२-१३९-८६", "content_sanskrit": "विद्या शौचं च दाक्ष्यं च बलं शौर्यं च पञ्चमम्।\nमित्राणि सहजान्याहुर्वर्तयन्तीह यैर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2077138, "chapter_id": 2634, "verse_number": "१२-१३९-८७", "content_sanskrit": "निवेशनं च कुप्यं च क्षेत्रं भार्यां सुहृज्जनम्।\nएतान्युपचितान्याहुः सर्वत्र लभते पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2077139, "chapter_id": 2634, "verse_number": "१२-१३९-८८", "content_sanskrit": "सर्वत्र रमते प्राज्ञः सर्वत्र च विरोचते।\nन विभीषयते किंचिद्भीषितो न बिभेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2077140, "chapter_id": 2634, "verse_number": "१२-१३९-८९", "content_sanskrit": "नित्यं बुद्धिमतोऽप्यर्थः स्वल्पकोऽपि विवर्धते।\nदाक्ष्येण कुर्वतां कर्मं संयमात्प्रतितिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2077141, "chapter_id": 2634, "verse_number": "१२-१३९-९०", "content_sanskrit": "गृहस्नेहावबद्धानां नराणामल्पमेधसाम्।\nकुस्त्री खादति मांसानि माघमां सेगवा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2077142, "chapter_id": 2634, "verse_number": "१२-१३९-९१", "content_sanskrit": "गृहं क्षेत्राणि मित्राणि स्वदेश इति चापरे।\nइत्येवमवसीदन्ति नरा बुद्धिविपर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2077143, "chapter_id": 2634, "verse_number": "१२-१३९-९२", "content_sanskrit": "उत्पथाच्च विमानाच्च देशाद्दुर्भिक्षपीडितात्।\nअन्यत्र वसतिं गच्छेद्वसेद्वा नित्यमानितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2077144, "chapter_id": 2634, "verse_number": "१२-१३९-९३", "content_sanskrit": "तस्मादन्यत्र यास्यामि वस्तुं नाहमिहोत्सहे।\nकृतमेतदनाहार्यं तव पुत्रे च पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2077145, "chapter_id": 2634, "verse_number": "१२-१३९-९४", "content_sanskrit": "कुभार्यां च कुपुत्रं च कुराजानं कुसौहृदम्।\nकुसंबन्धं कुदेशं च दूरतः परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2077146, "chapter_id": 2634, "verse_number": "१२-१३९-९५", "content_sanskrit": "कुमित्रे नास्ति विश्वासः कुभार्यायां कुतो रतिः।\nकुराज्ये निर्वृतिर्नास्ति कुदेशे नास्ति जीविका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2077147, "chapter_id": 2634, "verse_number": "१२-१३९-९६", "content_sanskrit": "कुपुत्रे सौहृदं नास्ति नित्यमस्थिरसौहृदम्।\nअवमानः कुंसबन्धे भवत्यर्थविपर्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2077148, "chapter_id": 2634, "verse_number": "१२-१३९-९७", "content_sanskrit": "सा भार्या या प्रियं ब्रूते स पुत्रो यत्र निर्वृतिः।\nतन्मित्रं यत्र विश्वासः स देशो यत्र जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2077149, "chapter_id": 2634, "verse_number": "१२-१३९-९८", "content_sanskrit": "यत्र नास्ति बलात्कारः स राजा तीव्रशासनः।\nस च यौनाभिसंबन्धो यः सतोऽपि बुभूषति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2077150, "chapter_id": 2634, "verse_number": "१२-१३९-९९", "content_sanskrit": "भार्या देशोऽथ मित्राणि पुत्रसंबन्धिबान्धवाः।\nएते सर्वे गुणवति धर्मनेत्रे महीपतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2077151, "chapter_id": 2634, "verse_number": "१२-१३९-१००", "content_sanskrit": "अधर्मज्ञस्य विषये प्रजा नश्यन्ति निग्रहात्।\nराजा मूलं त्रिवर्गस्य अप्रमत्तोऽनुपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2077152, "chapter_id": 2634, "verse_number": "१२-१३९-१०१", "content_sanskrit": "बलिषङ्भागमुद्धृत्य फलं समुपयोजयेत्।\nन रक्षति प्रजाः सम्यग्यः स पार्थिवतस्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2077153, "chapter_id": 2634, "verse_number": "१२-१३९-१०२", "content_sanskrit": "दत्वाऽभयं यः स्वयमेव राजा\nन तत्प्रमाणं कुरुतेऽर्थलोभात्।\nस सर्वलोकादुपलभ्य पाप\nमधर्मबुद्धिर्निरयं प्रयाति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2077154, "chapter_id": 2634, "verse_number": "१२-१३९-१०३", "content_sanskrit": "दत्त्वाऽभयं स्वयं राजा प्रमाणं कुरुते यदि।\nस सर्वं सुखमाप्नोति प्रजा धर्मेण पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2077155, "chapter_id": 2634, "verse_number": "१२-१३९-१०४", "content_sanskrit": "पिता भ्राता गुरुः शास्ता वह्निर्वैश्रवणो यमः।\nसप्त राज्ञो गुणानेतान्मनुराह प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2077156, "chapter_id": 2634, "verse_number": "१२-१३९-१०५", "content_sanskrit": "पिता हि राजा लोकस्य प्रजानां योऽनुकम्पिता।\nतस्मिन्मिथ्यापनीते हि तिर्यग्भवति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2077157, "chapter_id": 2634, "verse_number": "१२-१३९-१०६", "content_sanskrit": "संभावयति मातेव दीनमप्युपपद्यते।\nदहत्यग्निरिवानिष्टान्यमयत्यहितांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2077158, "chapter_id": 2634, "verse_number": "१२-१३९-१०७", "content_sanskrit": "इष्टेषु विसृजन्नर्थान्कुबेर इव कामदः।\nगुरुर्धर्मोपदे--- गोप्ता च परिपालनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2077159, "chapter_id": 2634, "verse_number": "१२-१३९-१०८", "content_sanskrit": "यस्तु रञ्जयते ---- पौरजानपदान्गुणैः।\nन तस्य भ्रश्यते---ज्यं गुणधर्मानुपालनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2077160, "chapter_id": 2634, "verse_number": "१२-१३९-१०९", "content_sanskrit": "यः सम्यक्प्रति---ह्णाति पौरजानपदार्चनम्।\nस सुखं प्रेक्षते राजा इह लोके परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2077161, "chapter_id": 2634, "verse_number": "१२-१३९-११०", "content_sanskrit": "नित्योद्विग्नाः प्रजा यस्य करुभारप्रपीडिताः।\nअनर्थैर्विप्रलुप्यन्ते स गच्छति पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2077162, "chapter_id": 2634, "verse_number": "१२-१३९-१११", "content_sanskrit": "प्रजा यस्य विवर्धन्ते सरसीव महोत्पलम्।\nस राजा सर्वसुखदः स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2077163, "chapter_id": 2634, "verse_number": "१२-१३९-११२", "content_sanskrit": "बलिना विग्रहो राजन्न कदाचित्प्रशस्यते।\nबलिना विग्रही तस्य कुतो राज्यं कुतः सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2077164, "chapter_id": 2634, "verse_number": "१२-१३९-११३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2077165, "chapter_id": 2634, "verse_number": "१२-१३९-११३", "content_sanskrit": "सैवमुक्त्वा शकुनिका ब्रह्मदत्तं नराधिपम्।\nराजानं समनुज्ञाप्य जगामाभीप्सितां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2077166, "chapter_id": 2634, "verse_number": "१२-१३९-११४", "content_sanskrit": "एतत्ते ब्रह्मदत्तस्य पूजन्या सह भाषितम्।\nमयोक्तं भरतश्रेष्ठ किमन्यच्छ्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2077167, "chapter_id": 2634, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि एकोनचत्वारिंशदधिकशततमोऽध्यायः॥ १३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}]