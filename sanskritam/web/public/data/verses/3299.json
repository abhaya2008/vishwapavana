[{"id": 2106062, "chapter_id": 3299, "verse_number": "१६-२८-१", "content_sanskrit": "धृतराष्ट्र उवाच।\nयुधिष्ठिर महाबाहो कच्चित्वं कुशली ह्यसि।\nसहितो भ्रातृभिः सर्वैः पौरजानपदैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106063, "chapter_id": 3299, "verse_number": "१६-२८-२", "content_sanskrit": "ये च त्वामनुजीवन्ति कच्चित्तेऽपि निरामयाः।\nसचिवा भृत्यवर्गाश्च गुरवश्चैव ते नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106064, "chapter_id": 3299, "verse_number": "१६-२८-३", "content_sanskrit": "कच्चित्तेऽपि निरातङ्का वसन्ति विषये तव।\nकच्चिद्वर्तसि पौराणीं वृत्तिं राजर्षिसेविताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106065, "chapter_id": 3299, "verse_number": "१६-२८-४", "content_sanskrit": "कच्चिन्न्यायाननुच्छिद्य कोशस्तेऽभिप्रपूर्यते।\nअरिमध्यस्थमित्रेषु वर्तसे चानुरूपतः।\nब्राह्मणानग्रहारैर्वा यथावदनुपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106066, "chapter_id": 3299, "verse_number": "१६-२८-५", "content_sanskrit": "कच्चित्ते परितुष्यन्ति शीलेनि भरतर्षभ।\nशत्रवोपि कुतः पौरा भृत्या वा स्वजनोपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106067, "chapter_id": 3299, "verse_number": "१६-२८-६", "content_sanskrit": "कच्चिद्यजसकि राजेन्द्र श्रद्धावान्पितृदेवताः।\nअतिथीनन्नपानेनि कच्चिदर्चसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106068, "chapter_id": 3299, "verse_number": "१६-२८-७", "content_sanskrit": "कच्चिन्नयपथे विप्राः स्वकर्मनिरतास्तव।\nक्षत्रिया वैश्यवर्णा वा शूद्रा वाऽपि कुटुम्बिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106069, "chapter_id": 3299, "verse_number": "१६-२८-८", "content_sanskrit": "कच्चित्स्त्रीबालवृद्धं ते न शोचति न याचते।\nजामयः पूजिताः कच्चित्तव गेहे नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106070, "chapter_id": 3299, "verse_number": "१६-२८-९", "content_sanskrit": "कच्चिद्राजर्षिवंशोऽयं त्वामासाद्य महीपतिम्।\nयथोचितं महाराज यशसा नावसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106071, "chapter_id": 3299, "verse_number": "१६-२८-१०x", "content_sanskrit": "वैशण्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106072, "chapter_id": 3299, "verse_number": "१६-२८-१०", "content_sanskrit": "इत्येवादिनं तं स न्यायवित्प्रत्यभाषत।\nकुशलप्रश्नसंयुक्तं कुशलो वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106073, "chapter_id": 3299, "verse_number": "१६-२८-११x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106074, "chapter_id": 3299, "verse_number": "१६-२८-११", "content_sanskrit": "अपि ते वर्धते राजंस्पपो मन्दः श्रमश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106075, "chapter_id": 3299, "verse_number": "१६-२८-१२", "content_sanskrit": "अपि मे जननी चेयं शुश्रूषुर्विगतक्लमा।\nअथास्याः सफलो राजन्वनवासो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106076, "chapter_id": 3299, "verse_number": "१६-२८-१३", "content_sanskrit": "इयं च माता ज्येष्ठा मे शीतवाताध्वकर्शिता।\nघोरेण तपसा युक्ता देवी कच्चिन्न शोचति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106077, "chapter_id": 3299, "verse_number": "१६-२८-१४", "content_sanskrit": "हतान्पुत्रान्महावीर्यान्क्षत्रधर्मपरायणान्।\nनापध्यायति वा कच्चिदस्मान्पापकृतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106078, "chapter_id": 3299, "verse_number": "१६-२८-१५", "content_sanskrit": "क्व चासौ विदुरो राजन्नेमं पश्यामहे वयम्।\nसंजयः कुशली चायं कच्चिन्नु तपसि स्थिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106079, "chapter_id": 3299, "verse_number": "१६-२८-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106080, "chapter_id": 3299, "verse_number": "१६-२८-१६", "content_sanskrit": "इत्युक्तः प्रत्युवाचैनं धृतराष्ट्रो जनाधिपम्।\nकुशली विदुरः पुत्र तपो घोरं समाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106081, "chapter_id": 3299, "verse_number": "१६-२८-१७", "content_sanskrit": "वायुभक्षो निराहारः कृशो धमनिसंततः।\nकजाचिद्दृश्यते विप्रैः शून्येऽस्मिन्कानने क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106082, "chapter_id": 3299, "verse_number": "१६-२८-१८", "content_sanskrit": "इत्येवं ब्रुवतस्तस्य जटी वीटामुखः कृशः।\nदिग्वासा मलदिग्धाङ्गो वनरेणुसमुक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106083, "chapter_id": 3299, "verse_number": "१६-२८-१९", "content_sanskrit": "दूरादालक्षितः क्षत्ता तत्राख्यातो महीपतेः।\n`कविदुरस्त्वेष धर्मात्मा जनं दृष्ट्वा निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106084, "chapter_id": 3299, "verse_number": "१६-२८-२०", "content_sanskrit": "निवर्तमानं सहसा जनं दृष्ट्वाऽऽश्रमं प्रति।\nतमन्वधावन्नृपतिरेक एव युधिष्ठिरः।\nप्रविशन्तं वनं घोरं लक्ष्यालक्ष्यं क्वचित्क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106085, "chapter_id": 3299, "verse_number": "१६-२८-२१", "content_sanskrit": "भोभो विदुर राजाऽहं दयितस्ते युधिष्ठिरः।\nइति ब्रुवन्नरपतिस्तं यत्नादभ्यधावत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106086, "chapter_id": 3299, "verse_number": "१६-२८-२२", "content_sanskrit": "ततो विविक्त एकान्ते तस्थौ बुद्धिमतां वरः।\nविदुरो वृक्षमाश्रित्य कञ्चित्तत्र वनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106087, "chapter_id": 3299, "verse_number": "१६-२८-२३", "content_sanskrit": "तं राजा क्षीणभूयिष्ठमाकृतीमात्रसूचितम्।\nअभिजज्ञे महाबुद्धिं महाबुद्धिर्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106088, "chapter_id": 3299, "verse_number": "१६-२८-२४", "content_sanskrit": "युधिष्ठिरोऽहमस्मीति वाक्यमुक्त्वाऽग्रतः स्थितः।\nविदुरस्याश्रमे राजा स च प्रत्याह संज्ञया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2106089, "chapter_id": 3299, "verse_number": "१६-२८-२५", "content_sanskrit": "ततः सोऽनिमिषो भूत्वा राजानं तमुदैक्षत।\nसंयोज्य विदुरस्तस्मिन्दृष्टिं दृष्ट्या समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2106090, "chapter_id": 3299, "verse_number": "१६-२८-२६", "content_sanskrit": "विवेश विदुरो धीमान्गात्रैर्गात्राणि चैव ह।\nप्राणान्प्राणेषु च दधदिन्द्रियाणीन्द्रियेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2106091, "chapter_id": 3299, "verse_number": "१६-२८-२७", "content_sanskrit": "स योगबलमास्थाय विवेश नृपतेस्तनुम्।\nविदुरो धर्मराजस्य तेजसा प्रज्वलन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2106092, "chapter_id": 3299, "verse_number": "१६-२८-२८", "content_sanskrit": "विदुरस्य शरीरं तु तथैव स्तब्धलोचनम्।\nवृक्षाश्रितं तदा राजा ददर्श गतचेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2106093, "chapter_id": 3299, "verse_number": "१६-२८-२९", "content_sanskrit": "बलवन्तं तथाऽऽत्मानं मेने बहुगुणं तदा।\nधर्मराजो महातेजास्तच्च सस्मार पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2106094, "chapter_id": 3299, "verse_number": "१६-२८-३०", "content_sanskrit": "पौराणमात्मनः सर्वं भविष्यं च विशाम्पते।\nयोगधर्मं महातेजा व्यासेन कथिनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2106095, "chapter_id": 3299, "verse_number": "१६-२८-३१", "content_sanskrit": "धर्मराजश्च तत्रैनं सञ्चस्कारयिषुस्तदा।\nदग्धुकामोऽभवद्विद्वानथ वागभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2106096, "chapter_id": 3299, "verse_number": "१६-२८-३२", "content_sanskrit": "भोभो राजन्न दग्धव्यमेतद्विदुरसंज्ञकम्।\nकलेबरमिहैवं ते धर्म एष सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2106097, "chapter_id": 3299, "verse_number": "१६-२८-३३", "content_sanskrit": "लोको वैकर्तनो नाम भविष्यत्यस्य भारत।\nयतिधर्ममवाप्तोसौ नैष शोच्यः परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2106098, "chapter_id": 3299, "verse_number": "१६-२८-३४", "content_sanskrit": "इत्युक्तो धर्मराजः स विनिवृत्य ततः पुनः।\nराज्ञो वैचित्रवीर्यस्य तत्सर्वं प्रत्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2106099, "chapter_id": 3299, "verse_number": "१६-२८-३५", "content_sanskrit": "ततः स राजा धृतिमान्स च सर्वो जनस्तदा।\nभीमसेनादयश्चैव परं विस्मियमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2106100, "chapter_id": 3299, "verse_number": "१६-२८-३६", "content_sanskrit": "तच्छ्रुत्वा प्रीतिमान्राजा भूत्वा धर्मजमब्रवीत्।\nआपो मूलं फलं चैव ममेदं प्रतिगृह्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2106101, "chapter_id": 3299, "verse_number": "१६-२८-३७", "content_sanskrit": "यदन्नो हि नरो राजंस्तदन्नोऽस्यातिथिः स्मृतः।\nइत्युक्तः स तथेत्येवं प्राह धर्मात्मजो नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2106102, "chapter_id": 3299, "verse_number": "१६-२८-३८", "content_sanskrit": "फलं मूलं च बुभुजे राज्ञा दत्तं सहानुजः।\nततस्ते वृक्षमूलेषु कृतवासपरिग्रहाः।\nतां रात्रिमवसन्सर्वे फलमूलजलाशनाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2106103, "chapter_id": 3299, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि अष्टाविंशोऽध्यायः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]