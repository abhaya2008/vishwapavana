[{"id": 6000145000, "chapter_id": 10145, "verse_number": null, "content_sanskrit": "अथ सप्तमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000145001, "chapter_id": 10145, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.001.m4a", "display_order": 2}, {"id": 6000145002, "chapter_id": 10145, "verse_number": "७-७-१", "content_sanskrit": "एवं दैत्यसुतैः पृष्टो महाभागवतोऽसुरः।\nउवाच स्मयमानस्तान् स्मरन् मदनुशासनम्॥ ७/७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.002.m4a", "display_order": 3, "topics": [{"text": "गर्भस्थस्य तस्य नारदेनोपदेशं घटयितुं गर्भिण्या स्वमातुरिन्द्रेणापहरणादिकथाकथनम्", "range": "१–१४"}]}, {"id": 6000145003, "chapter_id": 10145, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.003.m4a", "display_order": 4}, {"id": 6000145004, "chapter_id": 10145, "verse_number": "७-७-२", "content_sanskrit": "पितरि प्रस्थितेऽस्माकं तपसे मन्दराचलम्।\nयुद्धोद्योगं परं चक्रुर्विबुधा दानवान् प्रति॥ ७/७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.004.m4a", "display_order": 5}, {"id": 6000145005, "chapter_id": 10145, "verse_number": "७-७-३", "content_sanskrit": "पिपीलिकैरहिरिव दिष्ट्या लोकोपतापनः।\nपापेन पापोऽभक्षीति वादिनो वासवादयः॥ ७/७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.005.m4a", "display_order": 6}, {"id": 6000145006, "chapter_id": 10145, "verse_number": "७-७-४", "content_sanskrit": "तेषामतिबलोद्योगं निशम्यासुरयूथपाः।\nवध्यमानाः सुरैर्भीताः दुद्रुवुः सर्वतो दिशम्॥ ७/७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.006.m4a", "display_order": 7}, {"id": 6000145007, "chapter_id": 10145, "verse_number": "७-७-५", "content_sanskrit": "कलत्रपुत्रवित्ताप्तान् गृहान् पशुपरिच्छदान्।\nनावेक्षमाणास्त्वरिताः सर्वे प्राणपरीप्सवः॥ ७/७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.007.m4a", "display_order": 8}, {"id": 6000145008, "chapter_id": 10145, "verse_number": "७-७-६", "content_sanskrit": "व्यलुम्पन् राजशिबिरममरा जयकाशिनः।\nइन्द्रस्तु राजमहिषीं मातरं मम चाग्रहीत्॥ ७/७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.008.m4a", "display_order": 9}, {"id": 6000145009, "chapter_id": 10145, "verse_number": "७-७-७", "content_sanskrit": "नीयमानां भयोद्विग्नां रुदन्तीं कुररीमिव।\nयदृच्छयाऽऽगतस्तत्र देवर्षिर्ददृशे पथि॥ ७/७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.009.m4a", "display_order": 10}, {"id": 6000145010, "chapter_id": 10145, "verse_number": "७-७-८", "content_sanskrit": "प्राह मैनां सुरपते नेतुमर्हस्यनागसीम्।\nमुञ्च मुञ्च महाभाग सतीं परपरिग्रहम्॥ ७/७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.010.m4a", "display_order": 11}, {"id": 6000145011, "chapter_id": 10145, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.011.m4a", "display_order": 12}, {"id": 6000145012, "chapter_id": 10145, "verse_number": "७-७-९", "content_sanskrit": "आस्तेऽस्या जठरे वीर्यमविषह्यं सुरद्विषः।\nआस्यतां यावत् प्रसवं मोक्ष्येऽर्थपदवीं गतः॥ ७/७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.012.m4a", "display_order": 13}, {"id": 6000145013, "chapter_id": 10145, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.013.m4a", "display_order": 14}, {"id": 6000145014, "chapter_id": 10145, "verse_number": "७-७-१०", "content_sanskrit": "अयं निष्किल्बिषः साक्षान्महाभागवतो महान्।\nन त्वया प्राप्स्यते संस्थामनन्तानुचरो बली॥ ७/७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.014.m4a", "display_order": 15}, {"id": 6000145015, "chapter_id": 10145, "verse_number": "७-७-११", "content_sanskrit": "इत्युक्तस्तां विहायेन्द्रो देवर्षेर्मानयन् वचः।\nअनन्तप्रियभक्त्यैनां परिक्रम्य दिवं ययौ॥ ७/७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.015.m4a", "display_order": 16}, {"id": 6000145016, "chapter_id": 10145, "verse_number": "७-७-१२", "content_sanskrit": "ततो नो मातरमृषिः समानीय निजाश्रमम्।\nआश्वास्येहोष्यतां भद्रे यावत् ते भर्तुरागमः॥ ७/७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.016.m4a", "display_order": 17}, {"id": 6000145017, "chapter_id": 10145, "verse_number": "७-७-१३", "content_sanskrit": "तथेत्यवात्सीद् देवर्षेरन्ति साऽप्यकुतोभया।\nयावद् दैत्यपतिर्घोरात् तपसो न न्यवर्तत॥ ७/७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.017.m4a", "display_order": 18}, {"id": 6000145018, "chapter_id": 10145, "verse_number": "७-७-१४", "content_sanskrit": "ऋषिं पर्यचरत् तत्र भक्त्या परमया सती।\nअन्तर्वत्नी स्वगर्भस्य क्षेमायेच्छाप्रसूतये॥ ७/७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.018.m4a", "display_order": 19}, {"id": 6000145019, "chapter_id": 10145, "verse_number": "७-७-१५", "content_sanskrit": "ऋषिः कारुणिकस्तस्याः प्रादादुभयमीश्वरः।\nधर्मस्य तत्त्वं ज्ञानं च मामप्युद्दिश्य निर्मलम्॥ ७/७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.019.m4a", "display_order": 20, "topics": [{"text": "प्रह्लादेन मातृगर्भस्थस्यैव स्वस्य ज्ञानप्राप्तिर्नारदानुग्रहेणेति कथनम्", "range": "१५–५६"}]}, {"id": 6000145020, "chapter_id": 10145, "verse_number": "७-७-१६", "content_sanskrit": "तत्तु कालस्य दीर्घत्वात् स्‍त्रीत्वान्मातुस्तिरोदधे।\nऋषिणाऽनुगृहीतं मां नाधुनाप्यजहात् स्मृतिः॥ ७/७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.020.m4a", "display_order": 21}, {"id": 6000145021, "chapter_id": 10145, "verse_number": "७-७-१७", "content_sanskrit": "भवतामपि भूयान्मे यदि श्रद्दधते वचः।\nवैशारदी धीः श्रद्धातः स्‍त्रीबालानां च मे यथा॥ ७/७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.021.m4a", "display_order": 22}, {"id": 6000145022, "chapter_id": 10145, "verse_number": "७-७-१८", "content_sanskrit": "जन्माद्याः षडिमे भावा दृष्टा देहस्य नात्मनः।\nफलानामिव वृक्षस्य कालेनेश्वरमूर्तिना॥ ७/७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.022.m4a", "display_order": 23}, {"id": 6000145023, "chapter_id": 10145, "verse_number": "७-७-१९", "content_sanskrit": "आत्मा नित्योऽव्ययः शुद्ध एकः क्षेत्रज्ञ आश्रयः।\nअविक्रियः स्वदृग् हेतुर्व्यापकोऽसङ्ग्यनावृतः॥ ७/७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.023.m4a", "display_order": 24}, {"id": 6000145024, "chapter_id": 10145, "verse_number": "७-७-२०", "content_sanskrit": "एतैर्द्वादशभिर्विद्वान् आत्मनो लक्षणैः परैः।\nअहं ममेत्यतद्भावं देहादौ मोहजं त्यजेत्॥ ७/७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.024.m4a", "display_order": 25}, {"id": 6000145025, "chapter_id": 10145, "verse_number": "७-७-२१", "content_sanskrit": "हेमं यथा ग्रावसु हेमकारः क्षेत्रेषु योगैस्तदभिज्ञ आप्नुयात्।\nक्षेत्रेषु देहेषु तथाऽऽत्मयोगैरध्यात्मविद् ब्रह्मगतिं लभेत॥ ७/७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.025.m4a", "display_order": 26}, {"id": 6000145026, "chapter_id": 10145, "verse_number": "७-७-२२", "content_sanskrit": "अष्टौ प्रकृतयः प्रोक्तास्‍त्रय एव हि तद्गुणाः।\nविकाराः षोडशाचार्यैः पुमानेकः समन्वयात्॥ ७/७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.026.m4a", "display_order": 27}, {"id": 6000145027, "chapter_id": 10145, "verse_number": "७-७-२३", "content_sanskrit": "देहस्तु सर्वसङ्घातो जगत् तस्थुरिति द्विधा।\nअत्रैव मृग्यः पुरुषो नेति नेतीत्यतत् त्यजन्॥ ७/७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.027.m4a", "display_order": 28}, {"id": 6000145028, "chapter_id": 10145, "verse_number": "७-७-२४", "content_sanskrit": "अन्वयव्यतिरेकेण विवेकेनागतात्मना।\nसर्गस्थानसमाम्नायैर्विमृशद्भिरसत्वरैः॥ ७/७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.028.m4a", "display_order": 29}, {"id": 6000145029, "chapter_id": 10145, "verse_number": "७-७-२५", "content_sanskrit": "बुद्धेर्जागरणं स्वप्नः सुषुप्तिरिति वृत्तयः।\nता येनैवानुभूयन्ते सोऽध्यक्षः पुरुषः परः॥ ७/७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.029.m4a", "display_order": 30}, {"id": 6000145030, "chapter_id": 10145, "verse_number": "७-७-२६", "content_sanskrit": "एभिस्‍त्रिवर्णैः पर्यस्तैर्बुद्धिभेदैः क्रियोद्भवैः।\nसरूपमात्मनो धत्ते गन्धैर्वायुरिवान्वयात्॥ ७/७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.030.m4a", "display_order": 31}, {"id": 6000145031, "chapter_id": 10145, "verse_number": "७-७-२७", "content_sanskrit": "एतद्द्वारो हि संसारो गुणकर्मनिबन्धनः।\nअज्ञानमूलोऽपार्थोऽपि पुंसः स्वप्न इवाप्यते॥ ७/७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.031.m4a", "display_order": 32}, {"id": 6000145032, "chapter_id": 10145, "verse_number": "७-७-२८", "content_sanskrit": "मनोमयत्वात् सर्वार्थाः स्वप्नजागरयोः समाः।\nदृष्टानर्थानपि ध्यातुः शोकमोहभयप्रदाः॥ ७/७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.032.m4a", "display_order": 33}, {"id": 6000145033, "chapter_id": 10145, "verse_number": "७-७-२९", "content_sanskrit": "तस्माद् भवद्भिः कर्तव्यः कर्मणां त्रिगुणात्मनाम्।\nबीजनिर्हरणे योगः प्रवाहोपरमो धियः॥ ७/७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.033.m4a", "display_order": 34}, {"id": 6000145034, "chapter_id": 10145, "verse_number": "७-७-३०", "content_sanskrit": "तत्रोपायसहस्राणामयं भगवतोदितः।\nयदीश्वरे भगवति भक्तिः स्यान्नान्यथा रतिः॥ ७/७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.034.m4a", "display_order": 35}, {"id": 6000145035, "chapter_id": 10145, "verse_number": "७-७-३१", "content_sanskrit": "गुरुशुश्रूषया भक्त्या सर्वलाभार्पणेन च।\nसङ्गेन साधुभक्तानामीश्वराराधनेन च॥ ७/७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.035.m4a", "display_order": 36}, {"id": 6000145036, "chapter_id": 10145, "verse_number": "७-७-३२", "content_sanskrit": "श्रद्धया तत्कथायां च कीर्तनैर्गुणकर्मणाम्।\nतत्पादाम्बुरुहध्यानात् तल्लिङ्गेक्षार्हणादिभिः॥ ७/७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.036.m4a", "display_order": 37}, {"id": 6000145037, "chapter_id": 10145, "verse_number": "७-७-३३", "content_sanskrit": "हरिः सर्वेषु भूतेषु भगवानास्त ईश्वरः।\nइति भूतानि मनसा कामैस्तैः साधु मानयेत्॥ ७/७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.037.m4a", "display_order": 38}, {"id": 6000145038, "chapter_id": 10145, "verse_number": "७-७-३४", "content_sanskrit": "एवं निर्जितषड्वर्गैः क्रियते भक्तिरीश्वरे।\nवासुदेवे भगवति यया संलभते रतिम्॥ ७/७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.038.m4a", "display_order": 39}, {"id": 6000145039, "chapter_id": 10145, "verse_number": "७-७-३५", "content_sanskrit": "निशम्य कर्माणि गुणानतुल्यान् वीर्याणि लीलातनुभिः कृतानि।\nयदाऽतिहर्षोत्पुलकाश्रुगद्गदः प्रोत्कण्ठ उद्गायति रौति नृत्यति॥ ७/७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.039.m4a", "display_order": 40}, {"id": 6000145040, "chapter_id": 10145, "verse_number": "७-७-३६", "content_sanskrit": "यदा ग्रहग्रस्त इव क्‍वचिद्धसत्याक्रन्दते ध्यायति वन्दते जनम्।\nमुहुः श्वसन् वक्ति हरे जगत्पते नारायणेत्यात्मगतिर्गतत्रपः॥ ७/७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.040.m4a", "display_order": 41}, {"id": 6000145041, "chapter_id": 10145, "verse_number": "७-७-३७", "content_sanskrit": "तदा पुमान् मुक्तसमस्तबन्धनस्तद्भावभावानुकृताशयाकृतिः।\nनिर्दग्धबीजानुशयो महीयसा भक्तिप्रयोगेण समेत्यधोक्षजम्॥ ७/७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.041.m4a", "display_order": 42}, {"id": 6000145042, "chapter_id": 10145, "verse_number": "७-७-३८", "content_sanskrit": "अधोक्षजालापमिहाशुभात्मनः शरीरिणः संसृतिचक्रशातनम्।\nतद् ब्रह्मनिर्वाणसुखं विदुर्बुधास्ततो भजध्वं हृदये हृदीश्वरम्॥ ७/७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.042.m4a", "display_order": 43}, {"id": 6000145043, "chapter_id": 10145, "verse_number": "७-७-३९", "content_sanskrit": "कोऽतिप्रयासोऽसुरबालका हरेरुपासने स्वे हृदि छिद्रवत् सतः।\nअस्यात्मनः सख्युरशेषदेहिनां सामान्यतः किं विषयोपपादनैः॥ ७/७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.043.m4a", "display_order": 44}, {"id": 6000145044, "chapter_id": 10145, "verse_number": "७-७-४०", "content_sanskrit": "रायः कलत्रं पशवः सुतादयो गृहा मही कुञ्जरकोशभूतयः।\nसर्वार्थकामाः क्षणभङ्गुरायुषः कुर्वन्ति मर्त्यस्य कियत् प्रियं चलाः॥ ७/७/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.044.m4a", "display_order": 45}, {"id": 6000145045, "chapter_id": 10145, "verse_number": "७-७-४१", "content_sanskrit": "एवं हि लोकाः क्रतुभिः कृता अमी क्षयिष्णवः सातिशया न निर्मलाः।\nतस्माददृष्टश्रुतदूषणं परं भक्त्यैकयेशं भजतात्मलब्धये॥ ७/७/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.045.m4a", "display_order": 46}, {"id": 6000145046, "chapter_id": 10145, "verse_number": "७-७-४२", "content_sanskrit": "यदर्थमिह कर्माणि विध्यङ्गान्यसकृन्नरः।\nकरोत्यतो विपर्यासममोघं विन्दते फलम्॥ ७/७/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.046.m4a", "display_order": 47}, {"id": 6000145047, "chapter_id": 10145, "verse_number": "७-७-४३", "content_sanskrit": "सुखाय दुःखमोक्षाय सङ्कल्प इह कर्मणः।\nसदाऽऽप्नोतीहया दुःखमनीहायां सुखोन्नतिम्॥ ७/७/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.047.m4a", "display_order": 48}, {"id": 6000145048, "chapter_id": 10145, "verse_number": "७-७-४४", "content_sanskrit": "कामान् कामयते काम्यान् यदर्थ इह पूरुषः।\nस वै देहस्तु पारक्यो भङ्गुरो यात्युपैति च॥ ७/७/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.048.m4a", "display_order": 49}, {"id": 6000145049, "chapter_id": 10145, "verse_number": "७-७-४५", "content_sanskrit": "किमु व्यवहितापत्यदारागारधनादयः।\nराज्यकोशगजामात्यभृत्याप्ता ममतास्पदाः॥ ७/७/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.049.m4a", "display_order": 50}, {"id": 6000145050, "chapter_id": 10145, "verse_number": "७-७-४६", "content_sanskrit": "किमेतैरात्मनस्तुच्छैः सह देहेन नश्वरैः।\nअनर्थैरर्थसङ्काशैर्पूर्णानन्दमहोदधेः॥ ७/७/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.050.m4a", "display_order": 51}, {"id": 6000145051, "chapter_id": 10145, "verse_number": "७-७-४७", "content_sanskrit": "निरूप्यतामिह स्वार्थः कियान् देहभृतोऽसुराः।\nनिषेकादिष्ववस्थासु क्लिश्यमानस्य कर्मभिः॥ ७/७/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.051.m4a", "display_order": 52}, {"id": 6000145052, "chapter_id": 10145, "verse_number": "७-७-४८", "content_sanskrit": "कर्माण्यारभते देही देहेनात्मानुवर्तिना।\nकर्मभिस्तनुते देहमुभयं त्वविवेकतः॥ ७/७/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.052.m4a", "display_order": 53}, {"id": 6000145053, "chapter_id": 10145, "verse_number": "७-७-४९", "content_sanskrit": "तस्मादर्थाश्च कामाश्च धर्माश्च यदपाश्रयाः।\nभजतानीहयाऽऽत्मानमनीहं हरिमीश्वरम्॥ ७/७/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.053.m4a", "display_order": 54}, {"id": 6000145054, "chapter_id": 10145, "verse_number": "७-७-५०", "content_sanskrit": "सर्वेषामपि भूतानां हरिरात्मेश्वरः प्रियः।\nभूतैर्महद्भिः स्वकृतैः कृतानां बीजसंज्ञितः॥ ७/७/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.054.m4a", "display_order": 55}, {"id": 6000145055, "chapter_id": 10145, "verse_number": "७-७-५१", "content_sanskrit": "देवोऽसुरो मनुष्यो वा यक्षो गन्धर्व एव च।\nभजन् मुकुन्दचरणं स्वस्तिमान् स्याद् यथा वयम्॥ ७/७/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.055.m4a", "display_order": 56}, {"id": 6000145056, "chapter_id": 10145, "verse_number": "७-७-५२", "content_sanskrit": "नालं द्विजत्वं देवत्वमृषित्वं वाऽसुरात्मजाः।\nप्रीणनाय मुकुन्दस्य न वृत्तं न बहुज्ञता॥ ७/७/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.056.m4a", "display_order": 57}, {"id": 6000145057, "chapter_id": 10145, "verse_number": "७-७-५३", "content_sanskrit": "न दानं न तपो नेज्या न शौचं न व्रतानि च।\nप्रीयतेऽमलया भक्त्या हरिरन्यद् विडम्बनम्॥ ७/७/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.057.m4a", "display_order": 58}, {"id": 6000145058, "chapter_id": 10145, "verse_number": "७-७-५४", "content_sanskrit": "ततो हरौ भगवति भक्तिं कुरुत दानवाः।\nआत्मौपम्येन सर्वत्र सर्वभूतात्मनीश्वरे॥ ७/७/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.058.m4a", "display_order": 59}, {"id": 6000145059, "chapter_id": 10145, "verse_number": "७-७-५५", "content_sanskrit": "दैतेया यक्षरक्षांसि स्‍त्रियः शूद्रा व्रजौकसः।\nखगा मृगाः पापजीवाः सन्ति ह्यच्युततां गताः॥ ७/७/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.059.m4a", "display_order": 60}, {"id": 6000145060, "chapter_id": 10145, "verse_number": "७-७-५६", "content_sanskrit": "एतावानेव लोकेऽस्मिन् पुंसां स्वार्थः परः स्मृतः।\nएकान्तभक्तिर्गोविन्दे यत्सर्वत्रात्मदर्शनम्॥ ७/७/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_007/BhP_07.007.060.m4a", "display_order": 61}, {"id": 6000145061, "chapter_id": 10145, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे सप्तमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]