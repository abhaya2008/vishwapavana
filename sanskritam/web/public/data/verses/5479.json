[{"id": 2209532, "chapter_id": 5479, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209533, "chapter_id": 5479, "verse_number": "१", "content_sanskrit": "दीक्षाकाले तु सम्प्राप्ते ततस्ते सुमहर्त्विजः ।\nविधिवद् दीक्षायामासुरश्वमेधाय पार्थिवम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209534, "chapter_id": 5479, "verse_number": "२", "content_sanskrit": "कृत्वा स पशुमेधांस्तु दीक्षितः पाण्डुनन्दनः ।\nधर्मराजो महातेजाः सहर्त्विग्भिर्व्यरोचत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209535, "chapter_id": 5479, "verse_number": "३", "content_sanskrit": "हयश्च हयमेधार्थं स्वयं स ब्रह्मवादिना ।\nउत्सृष्टः शास्त्रविधिना व्यासेनामिततेजसा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209536, "chapter_id": 5479, "verse_number": "४", "content_sanskrit": "स राजा धर्मतो राजन् दीक्षितो विबभौ तदा ।\nहेममाली रुग्मकण्ठः प्रदीप्त इव पावकः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209537, "chapter_id": 5479, "verse_number": "५", "content_sanskrit": "कृष्णाजिनी दण्डपाणिः क्षौमवासाः स धर्मजः ।\nविबभौ द्युतिमान् भूयः प्रजापतिरिवाध्वरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209538, "chapter_id": 5479, "verse_number": "६", "content_sanskrit": "तथैवास्यर्त्विजः सर्वे तुल्यवेषा विशाम्पते ।\nबभूवुरर्जुनश्चैव प्रदीप्त इव पावकः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209539, "chapter_id": 5479, "verse_number": "७", "content_sanskrit": "श्वेताश्वः कृष्णसारङ्गं ससाराश्वं धनञ्जयः ।\nविधिवद् पृथिवीपाल धर्मराजस्य शासनात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209540, "chapter_id": 5479, "verse_number": "८", "content_sanskrit": "विक्षिपन् गाण्डिवं राजन् बद्धगोधाङ्गुलित्रवान् ।\nतमश्वं पृथिवीपाल मुदा युक्तः ससार ह ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209541, "chapter_id": 5479, "verse_number": "९", "content_sanskrit": "आकुमारं तदा राजन्नागमत् तत्पुरं विभो ।\nद्रष्टुकामं कुरुश्रेष्ठं प्रयास्यन्तं धनञ्जयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209542, "chapter_id": 5479, "verse_number": "१०", "content_sanskrit": "तेषामन्योन्यसम्मर्दाद् ऊष्मेव समजायत ।\nदिदृक्षूणां हयं तं च तं चैव हयसारिणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209543, "chapter_id": 5479, "verse_number": "११", "content_sanskrit": "ततः शब्दो महाराज दशाशाः प्रतिपूरयन् ।\nबभूव वीक्षतां नॄणां कुन्तीपुत्रं धनञ्जयम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209544, "chapter_id": 5479, "verse_number": "१२", "content_sanskrit": "एष गच्छति कौन्तेयस्तुरगश्चैव दीप्तिमान् ।\nसमन्वेति महाबाहुः संस्पृशन् धनुरुत्तमम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209545, "chapter_id": 5479, "verse_number": "१३", "content_sanskrit": "एवं शुश्राव वदतां गिरो जिष्णुरुदारधीः ।\nस्वस्ति तेऽस्तु व्रजारिष्टं पुनश्चैहीति भारत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209546, "chapter_id": 5479, "verse_number": "१४", "content_sanskrit": "अथापरे मनुष्येन्द्र पुरुषा वाक्यमब्रुवन् ।\nनैनं पश्याम सम्मर्दे धनुरेतत् प्रदृश्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209547, "chapter_id": 5479, "verse_number": "१५", "content_sanskrit": "एतद्धि मेघनिर्ह्रादं विश्रुतं गाण्डिवं धनुः ।\nस्वस्ति गच्छत्वरिष्टं वै पन्थानमकुतोभयम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209548, "chapter_id": 5479, "verse_number": "१६", "content_sanskrit": "निवृत्तमेनं द्रक्ष्यामः पुनरेवं च तेऽब्रुवन् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209549, "chapter_id": 5479, "verse_number": "१७", "content_sanskrit": "एवमादि मनुष्याणाम् अर्जुनो भरतर्षभ ।\nशुश्राव मधुरा वाचः पुनः पुनरुदीरिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209550, "chapter_id": 5479, "verse_number": "१८", "content_sanskrit": "याज्ञवल्क्यः सशिष्यश्च कुशलो यज्ञकर्मणि ।\nप्रायात् पार्थेन सहितः शान्त्यर्थं वेदपारगः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209551, "chapter_id": 5479, "verse_number": "१९", "content_sanskrit": "ब्राह्मणाश्च महीपाल बहवो वेदपारगाः ।\nअनुजग्मुर्महात्मानं क्षत्रियाश्च विशोऽपि च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209552, "chapter_id": 5479, "verse_number": "२०", "content_sanskrit": "पाण्डवैः पृथिवीमश्वो निर्जितां शस्त्रतेजसा ।\nचचार स महाराज यथादेशं च सत्तम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209553, "chapter_id": 5479, "verse_number": "२१", "content_sanskrit": "यत्र युद्धानि वृत्तानि यान्यासन् पाण्डवस्य ह ।\nतानि वक्ष्यामि ते वीर विचित्राणि महान्ति च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209554, "chapter_id": 5479, "verse_number": "२२", "content_sanskrit": "स हयः पृथिवीं राजन् प्रदक्षिणमरिन्दम ।\nससारोत्तरतः पूर्वं तन्निबोध महीपते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209555, "chapter_id": 5479, "verse_number": "२३", "content_sanskrit": "अपामार्जन् स राष्ट्राणि पार्थिवानां हयोत्तमः ।\nशनैस्तथा परिययौ श्वेताश्वश्च महारथः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209556, "chapter_id": 5479, "verse_number": "२४", "content_sanskrit": "तत्र सङ्कल्पना नास्ति राज्ञामयुतशस्तदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209557, "chapter_id": 5479, "verse_number": "२५", "content_sanskrit": "येऽयुध्यन्त महाराज क्षत्रिया हतबान्धवाः ।\nकिराता विष्कृता राजन् बहवो हि धनुर्धराः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209558, "chapter_id": 5479, "verse_number": "२६", "content_sanskrit": "म्लेच्छाश्चान्ये विनिकृताः पुरा राजन् महारणे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209559, "chapter_id": 5479, "verse_number": "२७", "content_sanskrit": "आर्याश्च पृथिवीपालाः प्रहृष्टनरवाहनाः ।\nसमीयुः पाण्डुपुत्रेण बहवो युद्धदुर्मदाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209560, "chapter_id": 5479, "verse_number": "२८", "content_sanskrit": "एवं युद्धानि वृत्तानि तत्र तत्र विशाम्पते ।\nअर्जुनस्य महीपालैर्नानादेशनिवासिभिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209561, "chapter_id": 5479, "verse_number": "२९", "content_sanskrit": "यानि तूभयतो राजन् प्रवृत्तानि महान्ति च ।\nतानि युद्धानि वक्ष्यामि कौन्तेयस्य महात्मनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209562, "chapter_id": 5479, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि त्रिसप्ततितमोऽध्यायः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]