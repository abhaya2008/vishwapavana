[{"id": 2175874, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175875, "chapter_id": 4724, "verse_number": "१", "content_sanskrit": "यत्रोजिवानुडुपती राजसूयेन भारत ।\nतस्मिन् सत्रे महानासीत् सङ्ग्रामस्तारकामयः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175876, "chapter_id": 4724, "verse_number": "२", "content_sanskrit": "ततस्तत्राप्युपस्पृश्य दत्त्वा दानानि चात्मवान् ।\nसारस्वतस्य धर्मात्मा मुनेस्तीर्थं जगाम सः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175877, "chapter_id": 4724, "verse_number": "३", "content_sanskrit": "यत्र द्वादशवार्षिक्यामनावृष्ट्यां महायशाः ।\nवेदानध्यापयामास तदा सारस्वतो मुनिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175878, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175879, "chapter_id": 4724, "verse_number": "४", "content_sanskrit": "कथं द्वादशवार्षिक्यामनावृष्ट्यां द्विजोत्तमान् ।\nवेदानध्यापयामास तदा सारस्वतो मुनिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175880, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175881, "chapter_id": 4724, "verse_number": "५", "content_sanskrit": "आसीत् पूर्वं महाराज मुनिर्धीमान् द्विजोत्तमः ।\nदधीचिरिति विख्यातो ब्रह्मचारी जितेन्द्रियः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175882, "chapter_id": 4724, "verse_number": "६", "content_sanskrit": "तस्यातितपसः शक्रो बिभेति सततं विभो ।\nन च लोभयितुं शक्यः फलैर्बहुविधैरपि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175883, "chapter_id": 4724, "verse_number": "७", "content_sanskrit": "प्रलोभनार्थे तस्याथ प्राहिणोत् पाकशासनः ।\nदिव्यामप्सरसां मुख्यां दर्शनीयामलम्बुसाम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175884, "chapter_id": 4724, "verse_number": "८", "content_sanskrit": "तस्य तर्पयतो देवान् सरस्वत्यां महात्मनः ।\nसमीपतो महाराज सोपातिष्ठत भामिनी\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175885, "chapter_id": 4724, "verse_number": "९", "content_sanskrit": "तां दिव्यवपुषं दृष्ट्वा तस्यर्षेर्भावितात्मनः ।\nरेतः स्कन्नं सरस्वत्यां तत् सा जग्राह निम्नगा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175886, "chapter_id": 4724, "verse_number": "१०", "content_sanskrit": "कुक्षौ चाप्यदधद्दृष्ट्वा तद्रेतः पुरुषर्षभ ।\nसा दधार च तं गर्भं पुत्रहेतोर्महात्मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175887, "chapter_id": 4724, "verse_number": "११", "content_sanskrit": "सुषुवे चापि समये पुत्रं सारस्वतं वरम् ।\nजगाम पुत्रमादाय तमृषिं प्रति च प्रभो\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175888, "chapter_id": 4724, "verse_number": "१२", "content_sanskrit": "ऋषिसंसदि तं दृष्ट्वा दधीचिमृषिसत्तमम् ।\nततः प्रोवाच राजेन्द्र ददती पुत्रमस्य वै\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175889, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "सरस्वती नदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175890, "chapter_id": 4724, "verse_number": "१३", "content_sanskrit": "ब्रह्मर्षे तव पुत्रोऽयं त्वद्भक्त्या धारितो मया\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175891, "chapter_id": 4724, "verse_number": "१४", "content_sanskrit": "दृष्ट्वा तेऽप्सरसं रेतो यत् स्कन्नं प्रागलम्बुसाम् ।\nतत् कुक्षिणाऽहं ब्रह्मर्षे भक्त्या धृतवती तव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175892, "chapter_id": 4724, "verse_number": "१५", "content_sanskrit": "न विनाशमिदं गच्छेत् त्वत्तेज इति निश्चयात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175893, "chapter_id": 4724, "verse_number": "१६", "content_sanskrit": "प्रतिगृह्णीष्व पुत्रं स्वं मया दत्तमनिन्दितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175894, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175895, "chapter_id": 4724, "verse_number": "१७", "content_sanskrit": "इत्युक्तः प्रतिजग्राह प्रीतिं चावहदुत्तमाम् ।\nपितृवच्चोपजिघ्रत् तं मूर्ध्नि प्रेम्णा द्विजोत्तमः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175896, "chapter_id": 4724, "verse_number": "१८", "content_sanskrit": "परिष्वज्य चिरं कालं तदा भरतसत्तम ।\nसरस्वत्यै वरं प्रादात् प्रीयमाणो द्विजोत्तमः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175897, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "दधीचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175898, "chapter_id": 4724, "verse_number": "१९", "content_sanskrit": "विश्वे देवाः सपितरो गन्धर्वाप्सरसां गणाः ।\nतृप्तिं यास्यन्ति सुभगे तर्प्यमाणास्त्वदम्भसा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175899, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175900, "chapter_id": 4724, "verse_number": "२०", "content_sanskrit": "इत्युक्त्वा तां स तुष्टाव वचोभिर्विर्विधैस्तदा ।\nप्रीतः परमहृष्टात्मा यथावच्छृणु पार्थिव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175901, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "दधीचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175902, "chapter_id": 4724, "verse_number": "२१", "content_sanskrit": "प्रस्रुताऽसि महाभागे सरसो ब्रह्मणः पुरा ।\nजानन्ति त्वां सरिच्छ्रेष्ठे मुनयः संशितव्रताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175903, "chapter_id": 4724, "verse_number": "२२", "content_sanskrit": "मम प्रियकरी चापि सततं प्रियदर्शने ।\nतस्मात् सारस्वतं पुत्रमदधा वरवर्णिनि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175904, "chapter_id": 4724, "verse_number": "२३", "content_sanskrit": "तवैव नाम्ना प्रथितः पुत्रस्ते लोकभावनः ।\nसारस्वत इति ख्यातो भविष्यति महातपाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175905, "chapter_id": 4724, "verse_number": "२४", "content_sanskrit": "एष द्वादशवार्षिक्यामनावृष्ट्यां द्विजोत्तमान् ।\nसारस्वतो महाभागे वेदानध्यापयिष्यति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175906, "chapter_id": 4724, "verse_number": "२५", "content_sanskrit": "पुण्याभ्यश्च सरिद्भ्यस्त्वं मता पुण्यतमा शुभे ।\nभविष्यसि महाभागे मत्प्रसादात् सरस्वति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175907, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175908, "chapter_id": 4724, "verse_number": "२६", "content_sanskrit": "एवं सा संस्तुता तेन वरं लब्ध्वा महानदी ।\nपुत्रमादाय मुदिता जगाम भरतर्षभ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175909, "chapter_id": 4724, "verse_number": "२७", "content_sanskrit": "एतस्मिन्नेव काले तु विरोधे देवदानवैः ।\nशक्रः प्रहरणान्वेषी त्रीन् लोकान् विचचार ह\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175910, "chapter_id": 4724, "verse_number": "२८", "content_sanskrit": "न चोपलेभे भगवान् शक्रः प्रहरणं तदा ।\nयद्वै तेषां भवेद्योगं वधाय विबुधद्विषाम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175911, "chapter_id": 4724, "verse_number": "२९", "content_sanskrit": "ततोऽब्रवीत् सुरान् शक्रो न मे शक्याः सुरारयः ।\nऋतेऽस्थिभिर्दधीचस्य निहन्तुं देवसत्तमाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175912, "chapter_id": 4724, "verse_number": "३०", "content_sanskrit": "तस्माद् यत्नाद् ऋषिश्रेष्ठो याच्यतां कार्यसिद्धये ।\nदधीचास्थीनि देहीति तैर्वधिष्ये रणे रिपून्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175913, "chapter_id": 4724, "verse_number": "३१", "content_sanskrit": "स देवैर्याचितोऽस्थीनि यत्नाद् ऋषिवरस्तदा ।\nप्राणत्यागं कुरुश्रेष्ठ चकारैवाविचारयन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175914, "chapter_id": 4724, "verse_number": "३२", "content_sanskrit": "स लोकानक्षयान् प्राप्तो देवप्रियकरस्तदा ।\nतस्यास्थीनि ततः शक्रः सम्प्रहृष्टमनास्तदा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175915, "chapter_id": 4724, "verse_number": "३३", "content_sanskrit": "कारयामास दिव्यानि तदा प्रहरणान्युत ।\nवज्राणि च गदाश्चैव गुरून् दण्डांश्च पुष्कलान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175916, "chapter_id": 4724, "verse_number": "३४", "content_sanskrit": "स हि तीव्रेण तपसा संवृत्तः परमर्षिणा ।\nप्रजापतिसुतेनाथ भृगुणा लोकभावनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175917, "chapter_id": 4724, "verse_number": "३५", "content_sanskrit": "अतिकायः स तेजस्वी लोकसारो विनिर्मितः ।\nजज्ञे शैलगुरुः प्रांशुर्महिम्ना प्रथितः प्रभुः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175918, "chapter_id": 4724, "verse_number": "३६", "content_sanskrit": "नित्युमुद्विजते चास्य तेजसा पाकशासनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175919, "chapter_id": 4724, "verse_number": "३७", "content_sanskrit": "तेन वज्रेण भगवान् मन्त्रयुक्तेन भारत ।\nविचकर्त विसृष्टेन ब्रह्मतेजोद्भवेन च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175920, "chapter_id": 4724, "verse_number": "३८", "content_sanskrit": "दैत्यदानववीराणां जघान नवतीर्नव\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175921, "chapter_id": 4724, "verse_number": "३९", "content_sanskrit": "अथ काले व्यतिक्रान्ते महत्यतिभयङ्करी ।\nअनावृष्टिरनुप्राप्ता राजन् द्वादशवार्षिकी\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175922, "chapter_id": 4724, "verse_number": "४०", "content_sanskrit": "तस्यां द्वादशवार्षिक्यामनावृष्ट्यां महर्षयः ।\nवृत्त्यर्थं प्राद्रवन् राजन् क्षुधार्ताः सर्वतोदिशः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175923, "chapter_id": 4724, "verse_number": "४१", "content_sanskrit": "दिग्भ्यस्तान् प्रद्रुतान् दृष्ट्वा मुनिः सारस्वतस्तदा ।\nगमनाय मनश्चक्रे तं प्रोवाच सरस्वती\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2175924, "chapter_id": 4724, "verse_number": "४२", "content_sanskrit": "न गन्तव्यमितः पुत्र तवाहारमहं सदा ।\nदास्यामि मत्स्यप्रवरान् उष्यतामिति भारत\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2175925, "chapter_id": 4724, "verse_number": "४३", "content_sanskrit": "इत्युक्तस्तर्पयामास स पितॄन् देवतास्तथा ।\nआहारमकरोन्नित्यं प्राणान् वेदांश्च धारयन्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2175926, "chapter_id": 4724, "verse_number": "४४", "content_sanskrit": "अथ तस्यामतीतायामनावृष्ट्यां महर्षयः ।\nअन्योन्यं परिपप्रच्छुः पुनः स्वाध्यायकारणात्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2175927, "chapter_id": 4724, "verse_number": "४५", "content_sanskrit": "तेषां क्षुधापरीतानां नष्टा वेदा विधावताम् ।\nसर्वेषामेव राजेन्द्र न किञ्चित् प्रतिभाति ह\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2175928, "chapter_id": 4724, "verse_number": "४६", "content_sanskrit": "अथ कश्चिद् ऋषिस्तेषां सारस्वतमुपेयिवान् ।\nकुर्वाणं संशितात्मानं स्वाध्यायं मुनिपुङ्गवम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2175929, "chapter_id": 4724, "verse_number": "४७", "content_sanskrit": "स गत्वाऽऽचष्ट तेभ्यश्च सारस्वतमिति प्रभुम् ।\nस्वाध्यायममरप्रख्यं कुर्वाणं विजने वने\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2175930, "chapter_id": 4724, "verse_number": "४८", "content_sanskrit": "ततः सर्वे समाजग्मुस्तत्र राजन् महर्षयः ।\nसारस्वतं मुनिश्रेष्ठमिदमूचुः समागताः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2175931, "chapter_id": 4724, "verse_number": "४९", "content_sanskrit": "अस्मानध्यापयस्वेति तानुवाच ततो मुनिः ।\nशिष्यत्वमुगच्छध्वं विधिना च ममेत्युत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2175932, "chapter_id": 4724, "verse_number": "५०", "content_sanskrit": "ततोऽब्रवीद् ऋषिगणो बालस्त्वमसि पुत्रक ।\nस तानाह न मे धर्मो नश्येदिति ततो मुनीन्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2175933, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "सारस्वतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2175934, "chapter_id": 4724, "verse_number": "५१", "content_sanskrit": "यो ह्यधर्मेण गृह्णीयात् प्रब्रूयाद् वा ह्यधर्मतः ।\nम्रियेते तावुभौ क्षिप्रं स्यातां वा वैरिणावुभौ\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2175935, "chapter_id": 4724, "verse_number": "५२", "content_sanskrit": "न हायनैर्न पलितैर्न वित्तैर्न च बन्धुभिः ।\nऋषयश्चक्रिरे धर्मं योऽनूचानः स नो महान्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2175936, "chapter_id": 4724, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2175937, "chapter_id": 4724, "verse_number": "५३", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य मुनयस्ते तपोधनाः ।\nततो वेदाननुप्राप्य पुनर्धर्मं प्रचक्रिरे\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2175938, "chapter_id": 4724, "verse_number": "५४", "content_sanskrit": "षष्टिर्मुनिसहस्राणि शिष्यत्वं प्रतिपेदिरे ।\nसारस्वतस्य विप्रर्षेर्वेदाध्ययनकारणात्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2175939, "chapter_id": 4724, "verse_number": "५५", "content_sanskrit": "मुष्टिं पृथक् पृथक् सर्वे दर्भाणां चाप्युपाहरन् ।\nतस्यासनार्थं विप्रर्षेः बालस्यापि वशे स्थिताः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2175940, "chapter_id": 4724, "verse_number": "५६", "content_sanskrit": "तत्रापि दत्त्वा वसु रौहिणेयो\nमहाबलः केशवपूर्वजन्मा ।\nजगाम तीर्थं मुदितः क्रमेण\nतं वृद्धकन्याश्रममेव धीरः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2175941, "chapter_id": 4724, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि सारस्वतमाहात्म्यं नाम द्वाविंशोऽध्यायः ॥२२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]