[{"id": 2038200, "chapter_id": 1831, "verse_number": "५-७६-०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038201, "chapter_id": 1831, "verse_number": "५-७६-१", "content_sanskrit": "भावं जिज्ञासमानोऽहं प्रणयादिदमब्रवम् ।\nन चाक्षेपान्न पाण्डित्यान्न क्रोधान्न विवक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038202, "chapter_id": 1831, "verse_number": "५-७६-२", "content_sanskrit": "वेदाहं तव माहात्म्यसुत ते वेद यद्बलम्।\nउत ते वेद कर्माणि न त्वां परिभवाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038203, "chapter_id": 1831, "verse_number": "५-७६-३", "content_sanskrit": "यथा चात्मनि कल्याणं संभावयसि पाण्डव ।\nसहस्रगुणमप्येतत्त्वयि संभावयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038204, "chapter_id": 1831, "verse_number": "५-७६-४", "content_sanskrit": "यादृशे च कुले जन्म सर्वराजाभिपूजिते ।\nबन्धुभिश्च सुहृद्भिश्च भीम त्वमसि तादृशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038205, "chapter_id": 1831, "verse_number": "५-७६-५", "content_sanskrit": "जिज्ञासन्तो हि धर्मस्य सन्दिग्धस्य वृकोदर ।\nपर्यायं नाध्यवस्यन्ति देवमानुषयोर्जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038206, "chapter_id": 1831, "verse_number": "५-७६-६", "content_sanskrit": "स एव हेतुर्भूत्वा हि पुरुषस्यार्थसिद्धिषु।\nविनाशेऽपि स एवास्य सन्दिग्धं कर्म पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038207, "chapter_id": 1831, "verse_number": "५-७६-७", "content_sanskrit": "अन्यथा परिदृष्टानि कविभिर्दोवदर्शिभिः ।\nअन्यथा परिवर्तन्ते वेगा इव नभस्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038208, "chapter_id": 1831, "verse_number": "५-७६-८", "content_sanskrit": "सुमन्त्रितं सुनीतं च न्यायतश्चोपपादितम् ।\nकृतं मानुष्यकं कर्म दैनेनापि विरुद्ध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038209, "chapter_id": 1831, "verse_number": "५-७६-९", "content_sanskrit": "दैवमप्यकृतं कर्म पौरुषेण विहन्यते ।\nशीतमुष्णं तथा वर्षं क्षुत्पिपासे च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038210, "chapter_id": 1831, "verse_number": "५-७६-१०", "content_sanskrit": "यदन्यद्दिष्टभावस्य पुरुषस्य स्वयं कृतम् ।\nतस्मादनुपरोधश्च विद्यते तत्र लक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038211, "chapter_id": 1831, "verse_number": "५-७६-११", "content_sanskrit": "लोकस्य नान्यतो वृत्तिः पाण्डवान्यत्र कर्मणः।\nएवंबुद्धिः प्रवर्तेत फलं स्यादुभयान्वये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038212, "chapter_id": 1831, "verse_number": "५-७६-१२", "content_sanskrit": "य एवं कृतबुद्धिः स कर्मस्वेव प्रवर्तते ।\nनासिद्धो व्यथते तस्य न सिद्धौ हर्षमश्रुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038213, "chapter_id": 1831, "verse_number": "५-७६-१३", "content_sanskrit": "तत्रेयमनुमात्रा मे भीमसेन विवक्षिता।\nनैकान्तसिद्धिर्वक्तव्या शत्रुभिः सह संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038214, "chapter_id": 1831, "verse_number": "५-७६-१४", "content_sanskrit": "नातिप्रहीणरश्मिः स्यात्तथा भावविपर्यये ।\nविषादमर्च्छेद् ग्लानिं वाप्येतमर्थं ब्रवीमिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038215, "chapter_id": 1831, "verse_number": "५-७६-१५", "content_sanskrit": "श्वोभूते धृतराष्ट्रस्य समीपं प्राप्य पाण्डव।\nयतिष्ये प्रशमं कर्तुं युष्मदर्थमहापयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038216, "chapter_id": 1831, "verse_number": "५-७६-१६", "content_sanskrit": "शमं चेत्ते करिष्यन्ति ततोऽनन्तं यशो मम।\nभवतां कच कृतः कामस्तेषां च श्रेय उत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038217, "chapter_id": 1831, "verse_number": "५-७६-१७", "content_sanskrit": "ते चेदभिनिवेक्ष्यन्ते नाभ्युपैष्यन्ति मे वचः ।\nकुरवो युद्धमेवात्र घोरं कर्म भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038218, "chapter_id": 1831, "verse_number": "५-७६-१८", "content_sanskrit": "अस्मिन्युद्धे भीमसेन त्वयि भारः समाहितः।\nधूरर्जुनेन धार्या स्याद्वेढव्य इतरो जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038219, "chapter_id": 1831, "verse_number": "५-७६-१९", "content_sanskrit": "अहं हि यन्ता बीभत्सोर्भविता संयुगे सति।\nधनञ्जयस्यैष कामो न हि युद्धं न कामये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038220, "chapter_id": 1831, "verse_number": "५-७६-२०", "content_sanskrit": "तस्मादाशङ्कमानोऽहं वृकोदर मतिं तव।\nगदतः क्लीबया वाचा तेजस्ते समदीदिपम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038221, "chapter_id": 1831, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि षट्सप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]