[{"id": 7004352000, "chapter_id": 24352, "verse_number": "५-३-४६-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nस दानवो वरं लब्ध्वा जगाम स्वपुरं प्रति ।\nददर्श स्वपुरं राजञ्छोभितं चित्रचत्वरैः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004352001, "chapter_id": 24352, "verse_number": "५-३-४६-२", "content_sanskrit": "उद्यानैश्चैव विविधैः कदलीखण्डमण्डितैः ।\nपनसैर्बकुलैश्चैवाम्रातैराम्रैश्च चम्पकैः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004352002, "chapter_id": 24352, "verse_number": "५-३-४६-३", "content_sanskrit": "अशोकैर्नालिकेरैश्च मातुलिङ्गैः सदाडिमैः ।\nनानावृक्षैश्च शोभाढ्यं तडागैरुपशोभितम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004352003, "chapter_id": 24352, "verse_number": "५-३-४६-४", "content_sanskrit": "देवतायतनैर्दिव्यैर्ध्वजमालासुशोभितैः ।\nवेदाध्ययननिर्घोषैर्मङ्गलाद्यैर्विनादितम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004352004, "chapter_id": 24352, "verse_number": "५-३-४६-५", "content_sanskrit": "प्राविशद्भवने दिव्ये काञ्चने रुक्ममालिनि ।\nअपश्यत्स सुतान् भार्याममात्यान् दासभृत्यकान्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004352005, "chapter_id": 24352, "verse_number": "५-३-४६-६", "content_sanskrit": "ततो जयप्रदान् सर्वानितश्चेतश्च धावतः ।\nहृच्छोभां च प्रकुर्वाणान् वै जयन्तीभिरुच्चकैः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004352006, "chapter_id": 24352, "verse_number": "५-३-४६-७", "content_sanskrit": "केचित्तोरणमाबध्य केचित्पुष्पाण्यवाकिरन् ।\nमातुलिङ्गकराश्चान्ये धावन्ति ह्यन्धकं प्रति॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004352007, "chapter_id": 24352, "verse_number": "५-३-४६-८", "content_sanskrit": "पुरे जनाश्च दृश्यन्ते भाजनैरन्नपूरितैः ।\nपूर्णहस्ताः प्रदृश्यन्ते तत्रैव बहवो जनाः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004352008, "chapter_id": 24352, "verse_number": "५-३-४६-९", "content_sanskrit": "साक्षतैर्भाजनैस्तत्र शतसाहस्रयोषितः ।\nमन्त्रान् पठन्ति विप्राश्च मङ्गलान्यपि योषितः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004352009, "chapter_id": 24352, "verse_number": "५-३-४६-१०", "content_sanskrit": "अमात्याश्चैव भृत्याश्च गजांश्चाढौकयन्ति च ।\nवर्धापयन्ति ते सर्वे ये केचित्पुरवासिनः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004352010, "chapter_id": 24352, "verse_number": "५-३-४६-११", "content_sanskrit": "हृष्टस्तुष्टोऽवसत्तत्र सचिवैः सह सोऽन्धकः ।\nददर्श स जगत्सर्वं तुरङ्गांश्च पदातिकान्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004352011, "chapter_id": 24352, "verse_number": "५-३-४६-१२", "content_sanskrit": "तथैव विविधान् कोशांस्तत्र काञ्चनपूरितान् ।\nमहिषीर्गा वृषांश्चैवापश्यच्छत्राण्यनेकधा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004352012, "chapter_id": 24352, "verse_number": "५-३-४६-१३", "content_sanskrit": "स एवमन्धकस्तत्र कियन्तं कालमावसत् ।\nहृष्टस्तुष्टो वसन्मर्त्ये स सुरैर्नाभ्यभूयत॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004352013, "chapter_id": 24352, "verse_number": "५-३-४६-१४", "content_sanskrit": "वरं लब्धं तु तं ज्ञात्वा शङ्किताः स्वर्गवासिनः ।\nएकीभूताश्च ते सर्वे वासवं शरणं गताः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004352014, "chapter_id": 24352, "verse_number": "५-३-४६-१५", "content_sanskrit": "शक्र उवाच ।\nकथमागमनं वोऽत्र सर्वेषामपि नाकिनाम् ।\nकस्माद्वो भयमुत्पन्नमागताः शरणं कथम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004352015, "chapter_id": 24352, "verse_number": "५-३-४६-१६", "content_sanskrit": "ततस्ते ह्यमराः सर्वे शक्रमेतद्वचोऽब्रुवन्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004352016, "chapter_id": 24352, "verse_number": "५-३-४६-१७", "content_sanskrit": "देवा ऊचुः ।\nसुरनाथान्धको नाम दैत्यः शम्भुवरोर्जितः ।\nअजेयः सर्वदेवानां किं नु कार्यमतः परम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004352017, "chapter_id": 24352, "verse_number": "५-३-४६-१८", "content_sanskrit": "तत्त्वं चिन्तय देवेश क उपायो विधीयताम् ।\nइत्थं वदन्ति ते देवाः शक्राग्रे मन्त्रणोद्यताः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004352018, "chapter_id": 24352, "verse_number": "५-३-४६-१९", "content_sanskrit": "मन्त्रयन्ति च यावद्वै तावच्चारमुखेरितम् ।\nज्ञात्वा तत्र स देवौघं दानवो निर्गतो गृहात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004352019, "chapter_id": 24352, "verse_number": "५-३-४६-२०", "content_sanskrit": "एकाकी स्यन्दनारूढ आयुर्धैबहुभिर्वृतः ।\nदुर्गमं मेरुपृष्ठं स लीलयैव गतो नृप॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004352020, "chapter_id": 24352, "verse_number": "५-३-४६-२१", "content_sanskrit": "स्वर्णप्राकारसंयुक्तं शोभितं विविधाश्रमैः ।\nदुर्गमं शत्रुवर्गस्य तदा पार्थिवसत्तम॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004352021, "chapter_id": 24352, "verse_number": "५-३-४६-२२", "content_sanskrit": "प्रविवेशासुरस्तत्र लीलया स्वगृहे यथा ।\nवृत्रहा भयमापन्नः स्वकीयं चासनं ददौ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004352022, "chapter_id": 24352, "verse_number": "५-३-४६-२३", "content_sanskrit": "उपविष्टोऽन्धकस्तत्र शक्रस्यैवासने शुभे ।\nआस्थानं कलयामास सर्वतस्त्रिदशावृतम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004352023, "chapter_id": 24352, "verse_number": "५-३-४६-२४", "content_sanskrit": "शक्र उवाच ।\nकिं तवागमनं चात्र किं कार्यं कथयस्व मे ।\nयदस्मदीयं वित्तं हि तत्ते दास्यामि दानव॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004352024, "chapter_id": 24352, "verse_number": "५-३-४६-२५", "content_sanskrit": "अन्धक उवाच ।\nनाहं वै कामये कोशं न गजांश्च सुरेश्वर ।\nस्वकीयं दर्शयस्वाद्य स्वर्गशृङ्गारभूषितम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004352025, "chapter_id": 24352, "verse_number": "५-३-४६-२६", "content_sanskrit": "ऐरावतं महानागं तं चैवोच्चैःश्रवोहयम् ।\nउर्वश्यादीनि रत्नानि मम दर्शय गोपते॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004352026, "chapter_id": 24352, "verse_number": "५-३-४६-२७", "content_sanskrit": "पारिजातकपुष्पाणि वृक्षजातीननेकशः ।\nवादित्राणि च सर्वाणि दर्शयस्व शचीपते॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004352027, "chapter_id": 24352, "verse_number": "५-३-४६-२८", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शक्रश्चिन्तितवानिदम् ।\nयोऽमुं निहन्ति पाप्मानं न तं पश्यामि कर्हिचित्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004352028, "chapter_id": 24352, "verse_number": "५-३-४६-२९", "content_sanskrit": "नास्ति रक्षाप्रदः कश्चित्स्वर्गलोकस्य दुःखिनः ।\nभयत्रस्तो ददावन्यद्वादित्राद्यप्सरोगणैः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004352029, "chapter_id": 24352, "verse_number": "५-३-४६-३०", "content_sanskrit": "रङ्गभूमावुपाविश्य कारयामास ताण्डवम् ।\nउपविष्टाः सुराः सर्वे यममारुतकिन्नराः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004352030, "chapter_id": 24352, "verse_number": "५-३-४६-३१", "content_sanskrit": "उर्वश्याद्या अप्सरसो गीतवादित्रयोगतः ।\nननृतुः पुरतस्तस्य सर्वा एकैकशो नृप॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004352031, "chapter_id": 24352, "verse_number": "५-३-४६-३२", "content_sanskrit": "न व्यश्राम्यत तच्चित्तं दृष्ट्वा चाप्सरसस्तदा ।\nशचीं प्रति मनस्तस्य सकाममभवन्नृप॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004352032, "chapter_id": 24352, "verse_number": "५-३-४६-३३", "content_sanskrit": "गृहीत्वा शक्रभार्यां स प्रस्थितः स्वपुरं प्रति ।\nततः प्रववृते युद्धमन्धकस्य सुरैः सह॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004352033, "chapter_id": 24352, "verse_number": "५-३-४६-३४", "content_sanskrit": "तेन देवगणाः सर्वे ध्वस्ताः पार्थिवसत्तम ।\nसंग्रामे विविधैः शस्त्रैश्चक्रवज्रादिभिर्घनैः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004352034, "chapter_id": 24352, "verse_number": "५-३-४६-३५", "content_sanskrit": "संतापिताः सुराः सर्वे क्षयं नीता ह्यनेकशः ।\nसर्वेऽपि मरुतस्तेन भग्नाः संग्राममूर्धनि॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004352035, "chapter_id": 24352, "verse_number": "५-३-४६-३६", "content_sanskrit": "यथा सिंहोगजान् सर्वान् विचित्य विचरेद्वनम् ।\nतद्वदेकेन ते देवा जिताः सर्वे पराङ्मुखाः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004352036, "chapter_id": 24352, "verse_number": "५-३-४६-३७", "content_sanskrit": "बालोऽधिपो यथा ग्रामे स्वेच्छया पीडयेज्जनान् ।\nस्वैरमाक्रम्य गृह्णाति कोशवासांसि चासकृत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004352037, "chapter_id": 24352, "verse_number": "५-३-४६-३८", "content_sanskrit": "गतं न पश्यत्यात्मानं प्रजासंतापनेन च ।\nगृहीत्वा शक्रभार्यां स गतो वै दानवोत्तमः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]