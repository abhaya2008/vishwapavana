[{"id": 7004077000, "chapter_id": 24077, "verse_number": "४-२६-१", "content_sanskrit": "अगस्तिरुवाच ।\nप्रसन्नोसि यदि स्कंद मयि प्रीतिरनुत्तमा ।\nतत्समाचक्ष्व भगवंश्चिरं यन्मे हृदिस्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004077001, "chapter_id": 24077, "verse_number": "४-२६-२", "content_sanskrit": "अविमुक्तमिदं क्षेत्रं कदारभ्य भुवस्तले ।\nपरां प्रथितिमापन्नं मोक्षदं चाभवत्कथम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004077002, "chapter_id": 24077, "verse_number": "४-२६-३", "content_sanskrit": "कथमेषा त्रिलोकीड्या गीयते मणिकर्णिका ।\nतत्रासीत्किं पुरास्वामिन्यदा नामरनिम्नगा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004077003, "chapter_id": 24077, "verse_number": "४-२६-४", "content_sanskrit": "वाराणसीति काशीति रुद्रावास इति प्रभो ।\nअवाप नामधेयानि कथमेतानि सा पुरी ।\nआनंदकाननं रम्यमविमुक्तमनंतरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004077004, "chapter_id": 24077, "verse_number": "४-२६-५", "content_sanskrit": "महाश्मशान इति च कथं ख्यातं शिखिध्वज ।\nएतदिच्छाम्यहं श्रोतुं संदेहं मेऽपनोदय ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004077005, "chapter_id": 24077, "verse_number": "४-२६-६", "content_sanskrit": "स्कंद उवाच ।\nप्रश्नभारोयमतुलस्त्वया यः समुदाहृतः ।\nकुंभयोनेऽमुमेवार्थमप्राक्षीदंबिका हरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004077006, "chapter_id": 24077, "verse_number": "४-२६-७", "content_sanskrit": "यथा च देवदेवेन सर्वज्ञेन निवेदितम् ।\nजगन्मातुः पुरस्ताच्च तथैव कथयामि ते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004077007, "chapter_id": 24077, "verse_number": "४-२६-८", "content_sanskrit": "महाप्रलय काले च नष्टे स्थावरजंगमे ।\nआसीत्तमोमयं सर्वमनर्कग्रहतारकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004077008, "chapter_id": 24077, "verse_number": "४-२६-९", "content_sanskrit": "अचंद्रमनहोरात्रमनग्न्यनिलभूतलम् ।\nअप्रधानं वियच्छून्यमन्यतेजोविवर्धितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004077009, "chapter_id": 24077, "verse_number": "४-२६-१०", "content_sanskrit": "द्रष्टृत्वादि विहीनं च शब्दस्पर्शसमुज्झितम् ।\nव्यपेतगंधरूपं च रसत्यक्तमदिङ्मुखम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004077010, "chapter_id": 24077, "verse_number": "४-२६-११", "content_sanskrit": "इत्थं सत्यंधतमसि सूचीभेद्ये निरंतरे ।\nतत्सद्ब्रह्मेति यच्छ्रुत्या सदैकं प्रतिपाद्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004077011, "chapter_id": 24077, "verse_number": "४-२६-१२", "content_sanskrit": "अमनोगोचरोवाचां विषयं न कथंचन ।\nअनामरूपवर्णं च न स्थूलं न च यत्कृशम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004077012, "chapter_id": 24077, "verse_number": "४-२६-१३", "content_sanskrit": "अह्रस्वदीर्घमलघुगुरुत्वपरिवर्जितम् ।\nन यत्रोपचयः कश्चित्तथा चापचयोपि च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004077013, "chapter_id": 24077, "verse_number": "४-२६-१४", "content_sanskrit": "अभिधत्ते स चकितं यदस्तीति श्रुतिः पुनः ।\nसत्यं ज्ञानमनंतं च यदानंदं परं महः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004077014, "chapter_id": 24077, "verse_number": "४-२६-१५", "content_sanskrit": "अप्रमेयमनाधारमविकारमनाकृति ।\nनिर्गुणं योगिगम्यं च सर्वव्याप्येककारणम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004077015, "chapter_id": 24077, "verse_number": "४-२६-१६", "content_sanskrit": "निर्विकल्पं निरारंभं निर्मायं निरुपद्रवम् ।\nयस्येत्थं संविकल्प्यंते संज्ञाः संज्ञोदितस्य वै ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004077016, "chapter_id": 24077, "verse_number": "४-२६-१७", "content_sanskrit": "तस्यैकलस्य चरतो द्वितीयेच्छा भवत्किल ।\nअमूर्तेन स्वमूर्तिश्च तेनाकल्पि स्वलीलया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004077017, "chapter_id": 24077, "verse_number": "४-२६-१८", "content_sanskrit": "सर्वैश्वर्यगुणोपेता सर्वज्ञानमयी शुभा ।\nसर्वगा सर्वरूपा च सर्वदृक्सर्वकारिणी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004077018, "chapter_id": 24077, "verse_number": "४-२६-१९", "content_sanskrit": "सर्वैकवंद्या सर्वाद्या सर्वदा सर्वसंकृतिः ।\nपरिकल्प्येति तां मूर्तिमीश्वरीं शुद्धरूपिणीम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004077019, "chapter_id": 24077, "verse_number": "४-२६-२०", "content_sanskrit": "अंतर्दधे पराख्यं यद्ब्रह्मसर्वंगमव्ययम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004077020, "chapter_id": 24077, "verse_number": "४-२६-२१", "content_sanskrit": "अमूर्तं यत्पराख्यं वै तस्य मूर्तिरहं प्रिये ।\nअर्वाचीनपराचीना ईश्वरं मां जगुर्बुधाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004077021, "chapter_id": 24077, "verse_number": "४-२६-२२", "content_sanskrit": "ततस्तदैकलेनापि स्वैरं विहरतामया ।\nस्वविग्रहात्स्वयं सृष्टा स्वशरीरानपायिनी ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004077022, "chapter_id": 24077, "verse_number": "४-२६-२३", "content_sanskrit": "प्रधानं प्रकृतिं त्वां च मायां गुणवतीं पराम् ।\nबुद्धि तत्त्वस्य जननीमाहुर्विकृतिवर्जिताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004077023, "chapter_id": 24077, "verse_number": "४-२६-२४", "content_sanskrit": "युगपच्च त्वया शक्त्या साकं कालस्वरूपिणा ।\nमयाऽद्य पुरुषेणैतत्क्षेत्रं चापि विनिर्मितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004077024, "chapter_id": 24077, "verse_number": "४-२६-२५", "content_sanskrit": "सा शक्तिः प्रकृतिः प्रोक्ता स पुमानीश्वरः परः ।\nताभ्यां च रममाणाभ्यां तस्मिन्क्षेत्रे घटोद्भव ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004077025, "chapter_id": 24077, "verse_number": "४-२६-२६", "content_sanskrit": "परमानंदरूपाभ्यां परमानंदरूपिणी ।\nपंचक्रोशपरीमाणे स्वपादतलनिर्मिते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004077026, "chapter_id": 24077, "verse_number": "४-२६-२७", "content_sanskrit": "मुने प्रलयकालेपि न तत्क्षेत्रं कदाचन ।\nविमुक्तं हि शिवाभ्यां यदविमुक्तं ततो विदुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004077027, "chapter_id": 24077, "verse_number": "४-२६-२८", "content_sanskrit": "न यदा भूमिवलयं न यदाऽपां समुद्भवः ।\nतदा विहर्तुमीशेन क्षेत्रमेतद्विनि र्मितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004077028, "chapter_id": 24077, "verse_number": "४-२६-२९", "content_sanskrit": "इदं रहस्यं क्षेत्रस्य वेद कोपि न कुंभज ।\nनास्तिकाय न वक्तव्यं कदाचिच्चर्मचक्षुषे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004077029, "chapter_id": 24077, "verse_number": "४-२६-३०", "content_sanskrit": "श्रद्धालवे विनीताय त्रिकालज्ञानचक्षुषे ।\nशिवभक्ताय शांताय वक्तव्यं च मुमुक्षवे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004077030, "chapter_id": 24077, "verse_number": "४-२६-३१", "content_sanskrit": "अविमुक्तं तदरभ्य क्षेत्रमेतदुदीर्यते ।\nपर्यंक भूतं शिवयोर्निरंतरसुखास्पदम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004077031, "chapter_id": 24077, "verse_number": "४-२६-३२", "content_sanskrit": "अभावः कल्प्यते मूढैर्यदा च शिवयोस्तयोः ।\nक्षेत्रस्यास्य तदाभावः कल्प्यो निर्वाणकारिणः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004077032, "chapter_id": 24077, "verse_number": "४-२६-३३", "content_sanskrit": "अनाराध्य महेशानमनवाप्य च काशिकाम् ।\nयोगाद्युपायविज्ञोपि न निर्वाणमवाप्नुयात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004077033, "chapter_id": 24077, "verse_number": "४-२६-३४", "content_sanskrit": "अस्यानंदवनं नाम पुरा कारि पिनाकिना ।\nक्षेत्रस्यानंदहेतुत्वादविमुक्तमंनतरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004077034, "chapter_id": 24077, "verse_number": "४-२६-३५", "content_sanskrit": "आनंदकंदबीजानामंकुराणि यतस्ततः ।\nज्ञेयानि सर्वलिंगानि तस्मिन्नानंदकानने ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004077035, "chapter_id": 24077, "verse_number": "४-२६-३६", "content_sanskrit": "अविमुक्तमिति ख्यातमासीदित्थं घटोद्भव ।\nतथा चाख्याम्यथ मुने यथासीन्मणिकर्णिका ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004077036, "chapter_id": 24077, "verse_number": "४-२६-३७", "content_sanskrit": "प्रागानंदवने तत्र शिवयो रममाणयोः ।\nइच्छेत्यभूत्कलशज सृज्यः कोप्यपरः किल ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004077037, "chapter_id": 24077, "verse_number": "४-२६-३८", "content_sanskrit": "यस्मिन्न्यस्ते महाभारे आवां स्वः स्वैरचारिणौ ।\nनिर्वाणश्राणनं कुर्वः केवलं काशिशायिनाम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004077038, "chapter_id": 24077, "verse_number": "४-२६-३९", "content_sanskrit": "स एव सर्वं कुरुते स एव परिपाति च ।\nस एव संवृणोत्यंते सर्वैश्वर्यनिधिः स च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004077039, "chapter_id": 24077, "verse_number": "४-२६-४०", "content_sanskrit": "चेतःसमुद्रमाकुंच्य चिंताकल्लोलदोलितम् ।\nसत्त्वरत्नं तमोग्राहं रजोविद्रुमवल्लितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004077040, "chapter_id": 24077, "verse_number": "४-२६-४१", "content_sanskrit": "यस्य प्रसादात्तिष्ठावः सुखमानंदकानने ।\nपरिक्षिप्त मनोवृत्तौ क्व हि चिंतातुरे सुखम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004077041, "chapter_id": 24077, "verse_number": "४-२६-४२", "content_sanskrit": "संप्रधार्येति स विभुः सर्वतश्चित्स्वरूपया ।\nतया सह जगद्धात्र्या जगद्धाताऽथ धूर्जटिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004077042, "chapter_id": 24077, "verse_number": "४-२६-४३", "content_sanskrit": "सव्ये व्यापारयांचक्रे दृशमंगे सुधामुचम् ।\nततः पुमानाविरासीदेकस्त्रैलोक्यसुंदरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004077043, "chapter_id": 24077, "verse_number": "४-२६-४४", "content_sanskrit": "शांतः सत्त्वगुणोद्रिक्तो गांभीर्य जितसागरः ।\nतथा च क्षमया युक्तो मुनेऽलब्धोपमोऽभवत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004077044, "chapter_id": 24077, "verse_number": "४-२६-४५", "content_sanskrit": "इंद्रनीलद्युतिःश्रीमान्पुंडरीकोत्तमेक्षणः ।\nसुवर्णाकृति सुच्छाय दुकूलयुगलावृतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004077045, "chapter_id": 24077, "verse_number": "४-२६-४६", "content_sanskrit": "लसत्प्रचंडदोर्दंड युगलद्वयराजितः ।\nउल्लसत्परमामोदनाभीह्रदकुशेशयः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004077046, "chapter_id": 24077, "verse_number": "४-२६-४७", "content_sanskrit": "एकः सर्वगुणावासस्त्वेकः सर्वकलानिधिः ।\nएकः सर्वोत्तमो यस्मात्ततो यः पुरुषोत्तमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004077047, "chapter_id": 24077, "verse_number": "४-२६-४८", "content_sanskrit": "ततो महांतं तं वीक्ष्य महामहिमभूषणम् ।\nमहादेव उवाचेदं महाविष्णुर्भवाच्युत ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004077048, "chapter_id": 24077, "verse_number": "४-२६-४९", "content_sanskrit": "तव निःश्वसितं वेदास्तेभ्यः सर्वमवैष्यसि ।\nवेददृष्टेन मार्गेण कुरु सर्वं यथोचितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004077049, "chapter_id": 24077, "verse_number": "४-२६-५०", "content_sanskrit": "इत्युक्त्वा तं महेशानो बुद्धितत्त्वस्वरूपिणम् ।\nशिवया सहितो रुद्रो विवेशानंदकाननम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004077050, "chapter_id": 24077, "verse_number": "४-२६-५१", "content_sanskrit": "ततः स भगवान्विष्णुर्मौलावाज्ञां निधाय च ।\nक्षणं ध्यानपरो भूत्वा तपस्येव मनो दधौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004077051, "chapter_id": 24077, "verse_number": "४-२६-५२", "content_sanskrit": "खनित्वा तत्र चक्रेण रम्यां पुष्करिणीं हरिः ।\nनिजांगस्वेदसंदोह सलिलैस्तामपूरयत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004077052, "chapter_id": 24077, "verse_number": "४-२६-५३", "content_sanskrit": "समाः सहस्रं पंचाशत्तप उग्रं चचार सः ।\nचक्रपुष्कीरणी तीरे तत्र स्थाणुसमाकृतिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004077053, "chapter_id": 24077, "verse_number": "४-२६-५४", "content_sanskrit": "ततः स भगवानीशो मृडान्या सहितो मृडः ।\nदृष्ट्वा ज्वलंतं तपसा निश्चलं मीलितेक्षणम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004077054, "chapter_id": 24077, "verse_number": "४-२६-५५", "content_sanskrit": "तमुवाच हृषीकेशं मौलिमांदोलयन्मुहुः ।\nअहो महत्त्वं तपसस्त्वहो धैर्यं च चेतसः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004077055, "chapter_id": 24077, "verse_number": "४-२६-५६", "content_sanskrit": "अहो अनिंधनो वह्निर्ज्वलत्येष निरंतरम् ।\nअलं तप्त्वा महाविष्णो वरं वरय सत्तम ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004077056, "chapter_id": 24077, "verse_number": "४-२६-५७", "content_sanskrit": "मृडस्याम्रोडितमिदं प्रत्यभिज्ञाय भाषितम् ।\nउन्मीलित दृगंभोजः समुत्तस्थौ चतुर्भुजः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004077057, "chapter_id": 24077, "verse_number": "४-२६-५८", "content_sanskrit": "श्रीविष्णुरुवाच ।\nयदि प्रसन्नो देवेश देवदेव महेश्वर ।\nभवान्या सहितं त्वां तु द्रष्टुमिच्छामि सर्वदा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004077058, "chapter_id": 24077, "verse_number": "४-२६-५९", "content_sanskrit": "सर्वकर्मसु सर्वत्र त्वामेव शशिशेखर ।\nपुरश्चरं तं पश्यामि यथा तन्मे वरस्तथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004077059, "chapter_id": 24077, "verse_number": "४-२६-६०", "content_sanskrit": "त्वदीय चरणांभोज मकरंदमधूत्सुकः ।\nमच्चेतो भ्रमरो भ्रांतिं विहायास्तु सुनिश्चलः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004077060, "chapter_id": 24077, "verse_number": "४-२६-६१", "content_sanskrit": "श्रीशिव उवाच ।\nएवमस्तु हृषीकेश यत्त्वयोक्तं जनार्दन ।\nअन्यं वरं प्रयच्छामि तमाकर्णय सुव्रत ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004077061, "chapter_id": 24077, "verse_number": "४-२६-६२", "content_sanskrit": "त्वदीयस्यास्य तपसो महोपचय दर्शनात् ।\nयन्मयांदोलितो मौलिरहिश्रवणभूषणः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004077062, "chapter_id": 24077, "verse_number": "४-२६-६३", "content_sanskrit": "तदांदोलनतः कर्णात्पपात मणिकर्णिका ।\nमणिभिः खचिता रम्या ततोऽस्तु मणिकर्णिका ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004077063, "chapter_id": 24077, "verse_number": "४-२६-६४", "content_sanskrit": "चक्रपुष्करिणी तीर्थं पुराख्यातमिदं शुभम् ।\nत्वया चक्रेण खननाच्छंखचक्रगदाधर ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004077064, "chapter_id": 24077, "verse_number": "४-२६-६५", "content_sanskrit": "मम कर्णात्पपातेयं यदा च मणिकर्णिका ।\nतदाप्रभृति लोकेऽत्र ख्यातास्तु मणिकर्णिका ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004077065, "chapter_id": 24077, "verse_number": "४-२६-६६", "content_sanskrit": "श्रीविष्णुरुवाच ।\nमुक्ताकुंडलपातेन तवाद्रितनयाप्रिय ।\nतीर्थानां परमं तीर्थं मुक्तिक्षेत्रमिहास्तु वै ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004077066, "chapter_id": 24077, "verse_number": "४-२६-६७", "content_sanskrit": "काशतेऽत्र यतो ज्योतिस्तदनाख्येयमीश्वरः ।\nअतो नामापरं चास्तु काशीति प्रथितं विभो ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004077067, "chapter_id": 24077, "verse_number": "४-२६-६८", "content_sanskrit": "अन्यं वरं वरे देव देयः सोप्यविचारितम् ।\nस ते परोपकारार्थं जगद्रक्षामणे शिव ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004077068, "chapter_id": 24077, "verse_number": "४-२६-६९", "content_sanskrit": "आब्रह्मस्तंबपर्यंतं यत्किंचिज्जंतुसंज्ञितम् ।\nचतुर्षु भूतग्रामेषु काश्यां तन्मुक्तिमाप्स्यतु ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004077069, "chapter_id": 24077, "verse_number": "४-२६-७०", "content_sanskrit": "अस्मिंस्तीर्थवरे शंभो मणिश्रव णभूषणे ।\nसंध्यां स्नानं जपं होमं वेदाध्ययनमुत्तमम् ।\nतर्पण पिंडदानं च देवतानां च पूजनम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004077070, "chapter_id": 24077, "verse_number": "४-२६-७१", "content_sanskrit": "गोभूतिलहिरण्याश्वदीपान्नांबरभूषणम् ।\nकन्यादानं प्रयत्नेन सप्ततंतूननेकशः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004077071, "chapter_id": 24077, "verse_number": "४-२६-७२", "content_sanskrit": "व्रतोत्सर्गं वृषोत्सर्गं लिंगादि स्थापनं तथा ।\nकरोति यो महाप्राज्ञो ज्ञात्वायुःक्षणगत्वरम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004077072, "chapter_id": 24077, "verse_number": "४-२६-७३", "content_sanskrit": "विपत्तिं विपुलां चापि संपत्तिमतिभंगुराम् ।\nअक्षया मुक्तिरेकास्तु विपाकस्तस्य कर्मणः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004077073, "chapter_id": 24077, "verse_number": "४-२६-७४", "content_sanskrit": "अन्यच्चापि शुभं कर्म यदत्र श्रद्धयायुतम् ।\nविनात्मघातमीशान त्यक्त्वा प्रायोपवेशनम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004077074, "chapter_id": 24077, "verse_number": "४-२६-७५", "content_sanskrit": "नैःश्रेयस्याः श्रियो हेतुस्तदस्तु जगदीश्वर ।\nनानुशोचति नाख्याति कृत्वा कालांतरेपि यत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004077075, "chapter_id": 24077, "verse_number": "४-२६-७६", "content_sanskrit": "तदिहाक्षयतामेतु तस्येश त्वदनुग्रहात् ।\nतव प्रसादात्तस्येश सर्वमक्षयमस्तु तत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004077076, "chapter_id": 24077, "verse_number": "४-२६-७७", "content_sanskrit": "यदस्ति यद्भविष्यच्च यद्भूतं च सदाशिव ।\nतस्मादेतच्च सर्वस्मात्क्षेत्रमस्तु शुभोदयम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004077077, "chapter_id": 24077, "verse_number": "४-२६-७८", "content_sanskrit": "यथा सदाशिव त्वत्तो न किंचिदधिकं शिवम् ।\nतथानंदवनादस्मात्किंचिन्मास्त्वधिकं क्वचित् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004077078, "chapter_id": 24077, "verse_number": "४-२६-७९", "content_sanskrit": "विना सांख्येन योगेन विना स्वात्मावलोकनम् ।\nविना व्रत तपो दानैः श्रेयोऽस्तु प्राणिनामिह ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004077079, "chapter_id": 24077, "verse_number": "४-२६-८०", "content_sanskrit": "शशका मशका कीटाः पतं गास्तुरगोरगाः ।\nपंचक्रोश्यां मृताः काश्यां संतु निर्वाणदीक्षिताः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004077080, "chapter_id": 24077, "verse_number": "४-२६-८१", "content_sanskrit": "नामापि गृह्णतां काश्याः सदैवास्त्वेनसः क्षयः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004077081, "chapter_id": 24077, "verse_number": "४-२६-८२", "content_sanskrit": "सदा कृतयुगं चास्तु सदाचास्तूत्तरायणम् ।\nसदा महोदयश्चास्तु काश्यां निवसतां सताम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004077082, "chapter_id": 24077, "verse_number": "४-२६-८३", "content_sanskrit": "यानि कानि पवित्राणि श्रुत्युक्तानि सदाशिव ।\nतेभ्योऽधिकतरं चास्तु क्षेत्रमेतत्त्रिलोचन ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004077083, "chapter_id": 24077, "verse_number": "४-२६-८४", "content_sanskrit": "चतुर्णामपि वेदानां पुण्यमध्ययनाच्च यत् ।\nतत्पुण्यं जायतां काश्यां गायत्रीलक्ष जाप्यतः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004077084, "chapter_id": 24077, "verse_number": "४-२६-८५", "content_sanskrit": "अष्टांगयोगाभ्यासेन यत्पुण्यमपि जायतेः ।\nतत्पुण्यं साधिकं भूयाच्छ्रद्धाकाशीनिषेवणात् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004077085, "chapter_id": 24077, "verse_number": "४-२६-८६", "content_sanskrit": "कृच्छ्रचांद्रायणाद्यैश्च यच्छ्रेयः समुपार्ज्यते ।\nतदेकेनोपवासेन भवत्वानंदकानने ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004077086, "chapter_id": 24077, "verse_number": "४-२६-८७", "content_sanskrit": "अन्यत्र यत्तपस्तप्त्वा श्रेयः स्याच्छरदां शतम् ।\nतदस्तु काश्यां वर्षेण भूमिशय्या व्रतेन हि ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004077087, "chapter_id": 24077, "verse_number": "४-२६-८८", "content_sanskrit": "आजन्म मौनव्रततो यदन्यत्रफलं स्मृतम् ।\nतदस्तु काश्यां पक्षाहः सत्यवाक्परिभाषणात् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004077088, "chapter_id": 24077, "verse_number": "४-२६-८९", "content_sanskrit": "अन्यत्र दत्त्वा सर्वस्वं सुकृतं यत्समीरितम् ।\nसहस्रभोजनात्काश्यां तद्भूयादयुताधिकम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004077089, "chapter_id": 24077, "verse_number": "४-२६-९०", "content_sanskrit": "मुक्तिक्षेत्राणि सर्वाणि यत्संसेव्योदितं फलम् ।\nपंचरात्रात्तदत्रास्तु निषेव्य मणिकर्णिकाम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004077090, "chapter_id": 24077, "verse_number": "४-२६-९१", "content_sanskrit": "प्रयागस्नानपुण्येन यत्पुण्यं स्याच्छिवप्रदम् ।\nकाशीदर्शनमात्रेण तत्पुण्यं श्रद्धयास्त्विह ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004077091, "chapter_id": 24077, "verse_number": "४-२६-९२", "content_sanskrit": "यत्पुण्यमश्वमेधेन यत्पुण्यं राजसूयतः ।\nकाश्यां तत्पुण्यमाप्नोतु त्रिरात्रशयनाद्यमी ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004077092, "chapter_id": 24077, "verse_number": "४-२६-९३", "content_sanskrit": "तुलापुरुषदानेन यत्पुण्यं सम्यगाप्यते ।\nकाशीदर्शनमात्रेण तत्पुण्यं श्रद्धयास्तु वै ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004077093, "chapter_id": 24077, "verse_number": "४-२६-९४", "content_sanskrit": "इति विष्णोर्वरं श्रुत्वा देवदेवो जगत्पतिः ।\nउवाच च प्रसन्नात्मा तथाऽस्तु मधुसूदन ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004077094, "chapter_id": 24077, "verse_number": "४-२६-९५", "content_sanskrit": "श्रीमहादेव उवाच ।\nशृणु विष्णो महाबाहो जगतः प्रभवाप्यय ।\nविधेहि सृष्टिं विविधां यथावत्त्वं श्रुतीरिताम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004077095, "chapter_id": 24077, "verse_number": "४-२६-९६", "content_sanskrit": "पितेव सर्वभूतानां धर्मतः पालको भव ।\nविध्वंसनीया विविधा धर्मध्वंसविधायिनः ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004077096, "chapter_id": 24077, "verse_number": "४-२६-९७", "content_sanskrit": "धर्मेतरपथस्थानामुपसंहृतये हरे ।\nहेतुमात्रं भवान्यस्मात्स्वकर्मनिहता हि ते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004077097, "chapter_id": 24077, "verse_number": "४-२६-९८", "content_sanskrit": "यथा परिणतं सस्यं पतेत्प्रसवबंधनात् ।\nते परीणतपाप्मानः पतिष्यंति तथा स्वयम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004077098, "chapter_id": 24077, "verse_number": "४-२६-९९", "content_sanskrit": "ये च त्वामवमन्यंते दर्पिताः स्वतपोबलैः ।\nतेषां चैवोपसंहृत्यै प्रभविष्याम्यहं हरे ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004077099, "chapter_id": 24077, "verse_number": "४-२६-१००", "content_sanskrit": "उपपातकिनो ये च महापातकिनश्च ये ।\nतेपि काशीं समासाद्य भविष्यंति गतैनसः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004077100, "chapter_id": 24077, "verse_number": "४-२६-१०१", "content_sanskrit": "इदं मम प्रियं क्षेत्रं पंचक्रोशीपरीमितम् ।\nममाज्ञा प्रभवेदत्र नान्याज्ञा प्रभवेदिह ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004077101, "chapter_id": 24077, "verse_number": "४-२६-१०२", "content_sanskrit": "पुनर्विष्णुर्मया प्रोक्तो मृडानि शुभलोचने ।\nअत्युग्रतेजसा तेजो भ्रमंस्त्रैलोक्यविभ्रमः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004077102, "chapter_id": 24077, "verse_number": "४-२६-१०३", "content_sanskrit": "पापिनामपि जंतूनामविमुक्तनिवासिनाम् ।\nनान्यः शासयिता विप्णो तेषां शास्ताऽहमेव हि ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004077103, "chapter_id": 24077, "verse_number": "४-२६-१०४", "content_sanskrit": "योजनानां शतस्थोपि यो ऽविमुक्तं स्मरेद्धृदि ।\nबहुपातकपूर्णोपि न स पापैः प्रबाध्यते ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004077104, "chapter_id": 24077, "verse_number": "४-२६-१०५", "content_sanskrit": "मम प्रियस्य क्षेत्रस्य योऽविमुक्तस्य संस्मरेत् ।\nप्राण प्रयाणसमये दूरगोप्यघवानपि ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004077105, "chapter_id": 24077, "verse_number": "४-२६-१०६", "content_sanskrit": "स पापपूगमुत्सृज्य स्वर्गभोगान्समश्नुते ।\nकाशीस्मरणपुण्येन स्वर्गाद्भ्रष्टो हि जायते ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004077106, "chapter_id": 24077, "verse_number": "४-२६-१०७", "content_sanskrit": "पृथिव्यामेकराड्भूत्वा भुक्त्वा भोगाननेकशः ।\nप्राप्याविमुक्तं तत्पुण्यान्निर्वाणपदभाग्भवेत् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004077107, "chapter_id": 24077, "verse_number": "४-२६-१०८", "content_sanskrit": "बहुकालमुषित्वाऽत्र नियतेंद्रियमानसः ।\nयद्यन्यत्र विपद्येत दैवयोगाच्छुचिस्मिते ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004077108, "chapter_id": 24077, "verse_number": "४-२६-१०९", "content_sanskrit": "सोपि स्वर्गसुखं भुक्त्वा भूत्वा क्षितिपतीश्वरः ।\nपुनः काशीमवाप्याथ विंदेन्नैःश्रेयसीं श्रियम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004077109, "chapter_id": 24077, "verse_number": "४-२६-११०", "content_sanskrit": "विष्णोऽविमुक्ते संवासः कर्मनिर्मूलनक्षमः ।\nद्वित्राणां हि पवित्राणां निर्वाणा येह जायते ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004077110, "chapter_id": 24077, "verse_number": "४-२६-१११", "content_sanskrit": "विष्णुरुवाच ।\nदेवेशक्षेत्रमाहात्म्यं यो न जानाति तत्त्वतः ।\nन श्रद्दधाति म्रियते मृते तस्येह का गतिः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004077111, "chapter_id": 24077, "verse_number": "४-२६-११२", "content_sanskrit": "शिव उवाच ।\nअन्यत्र कृत्वा पापानि बहूनि सुमहांति च ।\nअश्रद्दधानोऽतत्त्वज्ञो यद्यत्र च विपद्यते ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004077112, "chapter_id": 24077, "verse_number": "४-२६-११३", "content_sanskrit": "महिमन्यनभिज्ञोपि क्षेत्रस्यास्य जनार्दन ।\nतस्य या गतिरुद्दिष्टा तां निशामय सुव्रत ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004077113, "chapter_id": 24077, "verse_number": "४-२६-११४", "content_sanskrit": "पंचक्रोशीं प्रविशतस्तस्य पातकसंततिः ।\nबहिरेव प्रतिष्ठेत नांतर्निर्विशते क्वचित् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004077114, "chapter_id": 24077, "verse_number": "४-२६-११५", "content_sanskrit": "भयाद्बहिः स्थितायां च तस्य पातकसंततौ ।\nत्रिशूलपाशपाणीनां गणानां सीमचारिणाम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004077115, "chapter_id": 24077, "verse_number": "४-२६-११६", "content_sanskrit": "प्रवेशमात्रादनघ सर्वैरेनोभिरुज्झितः ।\nसंस्नाय मणिकर्णिक्यां पुण्यं प्राप्नोत्यनुत्तमम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004077116, "chapter_id": 24077, "verse_number": "४-२६-११७", "content_sanskrit": "सर्वतीर्थेषुसंस्नानाद्यत्पुण्यं समवाप्यते ।\nतत्पुण्यमाप्यते सम्यङ्मणिकर्ण्येक मज्जनात् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004077117, "chapter_id": 24077, "verse_number": "४-२६-११८", "content_sanskrit": "विधिना तत्र संस्नाय मृद्गोमयकुशादिभिः ।\nस्वशाखावारुणैर्मंत्रैर्दूर्वापामार्गदर्भकैः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004077118, "chapter_id": 24077, "verse_number": "४-२६-११९", "content_sanskrit": "सर्वतीर्थेषु यत्पुण्यं सर्वदानेषु यत्फलम् ।\nमणिकर्ण्यां विधिस्नातः श्रद्धया तदवाप्नुयात् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7004077119, "chapter_id": 24077, "verse_number": "४-२६-१२०", "content_sanskrit": "अश्रद्धयापि यः स्नातो मणिकर्ण्यां विधानतः ।\nसोपि पुण्यमवाप्नोति स्वर्गप्राप्तिकरं परम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7004077120, "chapter_id": 24077, "verse_number": "४-२६-१२१", "content_sanskrit": "श्रद्धया विधिवत्स्नात्वा कृत्वा देवादितर्पणम् ।\nतिलबर्हिर्यवैः सम्यक्सर्वयज्ञफलं लभेत् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7004077121, "chapter_id": 24077, "verse_number": "४-२६-१२२", "content_sanskrit": "श्रद्दधानो विधिस्नातः कृत सर्वोदकक्रियः ।\nजपन्देवान्समभ्यर्च्य सर्वमंत्रफलं लभेत् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7004077122, "chapter_id": 24077, "verse_number": "४-२६-१२३", "content_sanskrit": "स्नात्वा मौनेन विश्वेश दर्शना न्नियतेंद्रियः ।\nसर्वव्रतकृतं श्रेयो लभेद्वाचंयमः शिवे ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7004077123, "chapter_id": 24077, "verse_number": "४-२६-१२४", "content_sanskrit": "स्नाने देवार्चने जप्ये मलमूत्रविसर्जने ।\nमौनं कुर्यात्प्रयत्नेन दंतधावनहोमयोः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7004077124, "chapter_id": 24077, "verse_number": "४-२६-१२५", "content_sanskrit": "विश्वेश्वरं समभ्यर्च्य सूपचारैर्विधानतः ।\nयावज्जीवं शिवार्चायाः फलमाप्नोति वै सकृत् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7004077125, "chapter_id": 24077, "verse_number": "४-२६-१२६", "content_sanskrit": "दत्त्वाल्पमपि देवेशि न्यायेनोपार्जितं धनम् ।\nअविमुक्ते मम क्षेत्रे न दरिद्रो भवेत्क्वचित् ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7004077126, "chapter_id": 24077, "verse_number": "४-२६-१२७", "content_sanskrit": "विविधं धनमावर्ज्य योऽविमुक्ते न यच्छति ।\nसंप्राप्य निधनं मूढोऽन्यत्र शोचति सर्वदा ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7004077127, "chapter_id": 24077, "verse_number": "४-२६-१२८", "content_sanskrit": "रम्याणि यानि रत्नानि गोगजाश्वांबराण्यपि ।\nकृतानि तानि श्रेयोर्थमविमुक्तनिवासिनाम् ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7004077128, "chapter_id": 24077, "verse_number": "४-२६-१२९", "content_sanskrit": "विश्वेशप्रीणनार्थाय धनं निधनमेव वा ।\nन्यायेन काश्यां यः कुर्यात्स धन्यः स च धर्मवित् ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7004077129, "chapter_id": 24077, "verse_number": "४-२६-१३०", "content_sanskrit": "योसौ विश्वेश्वरो देवः काशीपुर्यामुमे स्थितः ।\nलिंगरूपधरः साक्षान्मम श्रेयास्पदं हि तत् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7004077130, "chapter_id": 24077, "verse_number": "४-२६-१३१", "content_sanskrit": "अविमुक्तं महत्क्षेत्रं पंचक्रोशपरीमितम् ।\nज्योतिर्लिगं तदेकं हि ज्ञेयं विश्वेश्वराभिधम् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7004077131, "chapter_id": 24077, "verse_number": "४-२६-१३२", "content_sanskrit": "एकदेशस्थितमपि यथा मार्तंडमंडलम् ।\nदृश्यते सर्वगं सर्वैः काश्यां विश्वेश्वरस्तथा ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7004077132, "chapter_id": 24077, "verse_number": "४-२६-१३३", "content_sanskrit": "निष्प्रत्यूहेन योगेन नानाजन्मार्जितेन च ।\nयत्फलं लभ्यतेऽन्यत्र तत्काश्यां त्यजतस्तनुम ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7004077133, "chapter_id": 24077, "verse_number": "४-२६-१३४", "content_sanskrit": "तप्त्वा तपांसि सर्वाणि बहुकालं जितेंद्रियैः ।\nयत्फलं लभ्यतेऽन्यत्र तत्काश्यामेकरात्रतः ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7004077134, "chapter_id": 24077, "verse_number": "४-२६-१३५", "content_sanskrit": "अक्षेत्रमहिमज्ञोपि श्रद्धाहीनोपि कालतः ।\nकाशीप्रवेशादनघोऽमृतत्वं लभतेमृतः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7004077135, "chapter_id": 24077, "verse_number": "४-२६-१३६", "content_sanskrit": "कृत्वाप्येनांसि चोग्राणि कालात्प्राप्याथ काशिकाम् ।\nत्यक्त्वा तनुं प्रसादान्मे मामेव प्रतिपद्यते ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7004077136, "chapter_id": 24077, "verse_number": "४-२६-१३७", "content_sanskrit": "विना मम प्रसादं वै कः काशीं प्रतिपद्यते ।\nविना ब्रध्नं विशालाक्षि दिनकृत्क इहोच्यते ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7004077137, "chapter_id": 24077, "verse_number": "४-२६-१३८", "content_sanskrit": "अप्राप्य काशीं को देवि निरंतर सुखं लभेत् ।\nबह्माद्याः प्राकृतैः पाशैर्यतो बद्धा निरंतरम् ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7004077138, "chapter_id": 24077, "verse_number": "४-२६-१३९", "content_sanskrit": "चतुर्विंशतिभिः पाशैस्त्रिगुणैः क्रियया दृढैः ।\nकंठे बद्धा विमुच्यंते कथं काशीं विना जनाः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7004077139, "chapter_id": 24077, "verse_number": "४-२६-१४०", "content_sanskrit": "बहूपसर्गो योगोयं कृच्छ्रसाध्यं तपो हि यत् ।\nयोगाद्भ्रष्टस्तपोभ्रष्टो गर्भक्लेशसहःपुनः ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7004077140, "chapter_id": 24077, "verse_number": "४-२६-१४१", "content_sanskrit": "कृत्वापि काश्यां पापानि काश्यामेव म्रियेत चेत् ।\nभूत्वा रुद्रपिशाचोपि पुनर्मुक्तिमवाप्स्यति ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7004077141, "chapter_id": 24077, "verse_number": "४-२६-१४२", "content_sanskrit": "काश्यां मृतानां जंतूनां दैवात्पापकृतामपि ।\nन पातो नरके तेषां तेषां शास्ताहमेव यत् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7004077142, "chapter_id": 24077, "verse_number": "४-२६-१४३", "content_sanskrit": "कायं विज्ञाय सापायं स्मृत्वा गर्भस्य वेदनाम् ।\nत्यक्त्वा राज्यमपि प्राज्यं सेव्या काशी निरंतरम् ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7004077143, "chapter_id": 24077, "verse_number": "४-२६-१४४", "content_sanskrit": "अतर्कितं समभ्येत्य यमदूताः सुदारुणाः ।\nबद्ध्वा पाशैर्हनिष्यंति क्षिप्रं काशीं ततः श्रयेत ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7004077144, "chapter_id": 24077, "verse_number": "४-२६-१४५", "content_sanskrit": "न पापेभ्यो भयं यत्र न भयं यत्र वै यमात् ।\nन गर्भवासभीर्यत्र तां काशीं को न संश्रयेत् ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7004077145, "chapter_id": 24077, "verse_number": "४-२६-१४६", "content_sanskrit": "अद्य प्रातः परश्वो वा मरणं प्राप्यमेव च ।\nयावत्कालविलंबोस्ति तावत्काशीं समाश्रयेत् ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7004077146, "chapter_id": 24077, "verse_number": "४-२६-१४७", "content_sanskrit": "प्राप्ते तु मरणे पुंसां पुनर्जन्म पुनर्मृतिः ।\nअपुनर्भवभूमिं च तस्मात्काशीं श्रयेद्बुधः ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7004077147, "chapter_id": 24077, "verse_number": "४-२६-१४८", "content_sanskrit": "पुत्रक्षेत्रकलत्राख्यां त्यक्त्वा मायां हि वैष्णवीम् ।\nभवांतरेनेकरूपां भवघ्नीं काशिकां श्रयेत् ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7004077148, "chapter_id": 24077, "verse_number": "४-२६-१४९", "content_sanskrit": "स्कंद उवाच ।\nदूरं मे मरणंयुवाहमधुना धार्यं न चित्तेत्विति श्रोतव्यो निभृतं कृतांत महिषग्रैवेयघंटारवः ।\nनैकट्यात्प्रकटोत्कटश्रमघटामप्राप्य हित्वा द्रुतं जीर्णां पर्णकुटीं ततः पटुमतिर्गच्छेत्पुरीं धूर्जटेः ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7004077149, "chapter_id": 24077, "verse_number": "४-२६-१५०", "content_sanskrit": "व्यास उवाच ।\nअगस्त्यस्य पुरः सूत कथयित्वा कथामिमाम् ।\nसर्वपापप्रशमनीं पुनः स्कंद उवाच ह ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}]