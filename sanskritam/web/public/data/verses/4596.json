[{"id": 2167466, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167467, "chapter_id": 4596, "verse_number": "१", "content_sanskrit": "कथं संशप्तकैः सार्धमर्जुनस्याभवद् रणः ।\nअन्येषां च मदीयानां सह पार्थैर्ब्रवीहि मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167468, "chapter_id": 4596, "verse_number": "२", "content_sanskrit": "अश्वत्थाम्नश्च यद् युद्धमर्जुनस्य च सञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167469, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167470, "chapter_id": 4596, "verse_number": "३", "content_sanskrit": "शृणु राजन् यथावृत्तं सङ्ग्रामं ब्रुवतो मम ।\nवीराणां शत्रुभिः सार्धं देहपाप्मविनाशनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167471, "chapter_id": 4596, "verse_number": "४", "content_sanskrit": "पार्थः संशप्तकबलं प्रविश्यार्णवसन्निभम् ।\nव्यक्षोभयदमित्रघ्नो महावात इवार्णवम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167472, "chapter_id": 4596, "verse_number": "५", "content_sanskrit": "शिरांस्युन्मथ्य वीराणां शितैर्भल्लैर्धनञ्जयः ।\nपूर्णचन्द्राभवक्त्राणि स्वक्षिभ्रूदशनानि च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167473, "chapter_id": 4596, "verse_number": "६", "content_sanskrit": "सन्तस्तार क्षितिं क्षिप्रं विनालैर्नलिनैरिव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167474, "chapter_id": 4596, "verse_number": "७", "content_sanskrit": "सुवृत्तानायतान् पुष्टान् चन्दनागरुरूषितान् ।\nसायुधान् सतलत्राणान् पञ्चास्यानिव पन्नगान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167475, "chapter_id": 4596, "verse_number": "८", "content_sanskrit": "बाहून् पादानमित्राणामुच्चकर्तार्ऽजुनो रणे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167476, "chapter_id": 4596, "verse_number": "९", "content_sanskrit": "धुर्यान् धुर्येतरान् सूतान् ध्वजांश्चापानि सायकान् ।\nपाणीनूरूंश्च निशितैर्भल्लैश्चिच्छेद पाण्डवः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167477, "chapter_id": 4596, "verse_number": "१०", "content_sanskrit": "द्विपान् रथान् हयांश्चैव सारोहानर्जुनो युधि ।\nशरैरनेकसाहस्रैर्निन्ये राजन् यमक्षयम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167478, "chapter_id": 4596, "verse_number": "११", "content_sanskrit": "ते प्रवीराः सुसंरब्धा नर्दमाना इवर्षभाः ।\nवाशितार्थमभिक्रुद्धा अभिद्रुत्य मदोत्कटाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167479, "chapter_id": 4596, "verse_number": "१२", "content_sanskrit": "निघ्नन्तमभिजघ्नुस्ते शरैः शृङ्गैरिवर्षभाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167480, "chapter_id": 4596, "verse_number": "१३", "content_sanskrit": "तस्य तेषां च तद्युद्धमभवद् रोमहर्षणम् ।\nत्रैलोक्यविजये यद्वद् दैत्यानां सह वज्रिणा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167481, "chapter_id": 4596, "verse_number": "१४", "content_sanskrit": "अस्त्रैरस्त्राणि संवार्य द्विषतां सर्वतोऽर्जुनः ।\nइषुभिर्बहुभिस्तूर्णं विद्ध्वा प्राणान् निरासदत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167482, "chapter_id": 4596, "verse_number": "१५", "content_sanskrit": "छिन्नत्रिवेणुचक्राक्षान् हतयोधाश्वसारथीन् ।\nविध्वस्तायुधतूणीरान् समुन्मथितकेतनान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167483, "chapter_id": 4596, "verse_number": "१६", "content_sanskrit": "सञ्छिन्नयोक्त्ररश्मीषान् वित्रिवेणून् विकूबरान् ।\nविशम्याबन्धुरयुगान् विजङ्घाजानुमण्डलान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167484, "chapter_id": 4596, "verse_number": "१७", "content_sanskrit": "रथान् विशकलीकुर्वन् महाभ्राणीव मारुतः ।\nविस्मापयन् प्रेक्षकाणां द्विषतां भयवर्धनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167485, "chapter_id": 4596, "verse_number": "१८", "content_sanskrit": "महारथसहस्रस्य समं कर्मार्जुनोऽकरोत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167486, "chapter_id": 4596, "verse_number": "१९", "content_sanskrit": "सिद्धदेवर्षिसङ्घाश्च चारणाश्चापि तुष्टुवुः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167487, "chapter_id": 4596, "verse_number": "२०", "content_sanskrit": "देवदुन्दुभयो नेदुः पुष्पवर्षाणि चापतन् ।\nकेशवार्जुनयोर्मूर्ध्नि प्राह वाक् चाशरीरिणी\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167488, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "अशरीरिणी वाक्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167489, "chapter_id": 4596, "verse_number": "२१", "content_sanskrit": "चन्द्रार्कानिलवह्नीनां कान्तिदीप्तिबलद्युतीः ।\nयौ सदा बिभ्रतो वीराविमौ तौ केशवार्जुनौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167490, "chapter_id": 4596, "verse_number": "२२", "content_sanskrit": "ब्रह्मेशानाविव पुरा वीरावेकरथे स्थितौ ।\nसर्वभूतवरौ वीरौ नरनारायणाविमौ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167491, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167492, "chapter_id": 4596, "verse_number": "२३", "content_sanskrit": "इत्येतन्महदाश्चर्यं दृष्ट्वा श्रुत्वा च भारत ।\nअश्वत्थामा सुसङ्क्रुद्धः कृष्णावभ्यद्रवद् रणे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167493, "chapter_id": 4596, "verse_number": "२४", "content_sanskrit": "अथ पाण्डवमस्यन्तममित्रान्तकरान् शरान् ।\nसेषुणा पाणिनाऽऽहूय प्रहसन् द्रौणिरब्रवीत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167494, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167495, "chapter_id": 4596, "verse_number": "२५", "content_sanskrit": "यदि मां मन्यसे वीर प्राप्तमार्यमिवातिथिम् ।\nततः सर्वात्मनाऽद्य त्वं युद्धातिथ्यं प्रयच्छ मे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167496, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167497, "chapter_id": 4596, "verse_number": "२६", "content_sanskrit": "एवमाचार्यपुत्रेण समाहूतो युयुत्सया ।\nबहुमेनेऽर्जुनोऽत्मानमिदं चाह जनार्दनम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167498, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167499, "chapter_id": 4596, "verse_number": "२७", "content_sanskrit": "संशप्तकाश्च मे वध्या द्रौणिराह्वयते च माम् ।\nयदत्रानन्तरं प्राप्तं तत् प्रशाधि महाभुज\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167500, "chapter_id": 4596, "verse_number": "२८", "content_sanskrit": "आतिथ्यकर्माभ्यर्थाय दीयतां यदि रोचते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167501, "chapter_id": 4596, "verse_number": "२९", "content_sanskrit": "एवमुक्तोऽवदत् पार्थं कृष्णो द्रोणात्मजान्तिके ।\nजैत्रेण विधिनाऽऽहूतं वायुमिन्द्रमिवाध्वरे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167502, "chapter_id": 4596, "verse_number": "३०", "content_sanskrit": "तमामन्त्र्यैकमनसं केशवो द्रौणिमब्रवीत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167503, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167504, "chapter_id": 4596, "verse_number": "३१", "content_sanskrit": "अश्वत्थामन् स्थिरो भूत्वा प्रहराशु सहस्व च ।\nनिर्वेष्टुं भर्तृपिण्डं हि कालोऽयमुपजीविनाम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167505, "chapter_id": 4596, "verse_number": "३२", "content_sanskrit": "सूक्ष्मौ विवादौ विप्राणां स्थूलौ क्षात्रौ जयाजयौ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167506, "chapter_id": 4596, "verse_number": "३३", "content_sanskrit": "न हि सङ्क्षमसे मोहाद् दिव्यां पार्थस्य सत्क्रियाम् ।\nसमाप्तुमिच्छन् युध्यस्व स्थिरो भूत्वाऽद्य पाण्डवम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167507, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2167508, "chapter_id": 4596, "verse_number": "३४", "content_sanskrit": "इत्युक्तो वासुदेवेन तथेत्युक्त्वा द्विजोत्तमः ।\nविव्याध केशवं षष्ट्या नाराचैरर्जुनं त्रिभिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2167509, "chapter_id": 4596, "verse_number": "३५", "content_sanskrit": "तस्यार्जुनः सुसङ्क्रुद्धः त्रिभिर्भल्लैः शरासनम् ।\nचिच्छेदाथान्यदादत्त द्रौणिर्घोरतरं धनुः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2167510, "chapter_id": 4596, "verse_number": "३६", "content_sanskrit": "सज्यं कृत्वा निमेषात्तु विव्याधार्जुनकेशवौ ।\nत्रिभिः शतैर्वासुदेवं सहस्रेण च फल्गुनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2167511, "chapter_id": 4596, "verse_number": "३७", "content_sanskrit": "ततः शरसहस्राणि प्रयुतान्यर्बुदानि च ।\nससृजे द्रौणिरायत्तः स्तम्भयामास चार्जुनम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2167512, "chapter_id": 4596, "verse_number": "३८", "content_sanskrit": "इषुधेर्धनुषो ज्यायास्त्वङ्गुलिभ्यश्च मारिष ।\nबाह्वोः कराभ्यामुरसो वदनाद् घ्राणनेत्रतः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2167513, "chapter_id": 4596, "verse_number": "३९", "content_sanskrit": "कर्णाभ्यां शिरसोऽङ्गेभ्यो लोमवर्मभ्य एव च ।\nरथध्वजाभ्यां च शरा निष्पेतुर्ब्रह्मवादिनः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2167514, "chapter_id": 4596, "verse_number": "४०", "content_sanskrit": "शरजालेन महता बद्ध्वा केशवपाण्डवौ ।\nननाद मुदितो द्रौणिर्महामेघौघनिःस्वनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2167515, "chapter_id": 4596, "verse_number": "४१", "content_sanskrit": "(तैः पतद्भिर्महाराज द्रौणिमुक्तैः समन्ततः ।\nसञ्छादितौ रथस्थौ तावुभौ कृष्णधनञ्जयौ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2167516, "chapter_id": 4596, "verse_number": "४२", "content_sanskrit": "ततः शरशतैस्तीक्ष्णैर्भारद्वाजः प्रतापवान् ।\nनिश्चेष्टौ तावुभौ चक्रे रणे माधवपाण्डवौ\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2167517, "chapter_id": 4596, "verse_number": "४३", "content_sanskrit": "हाहाकृतमभूत् सर्वं स्थावरं जङ्गमं तथा ।\nचराचरस्य गोप्तारौ दृष्ट्वा सञ्छादितौ शरैः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2167518, "chapter_id": 4596, "verse_number": "४४", "content_sanskrit": "सिद्धचारणसङ्घाश्च सम्पेतुर्वै समन्ततः ।\nअपि स्वस्ति भवेदद्य लोकानामिति चाब्रुवन्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2167519, "chapter_id": 4596, "verse_number": "४५", "content_sanskrit": "न मया तादृशो राजन् दृष्टपूर्वः पराक्रमः ।\nसञ्जज्ञे यादृशो द्रौणेः कृष्णौ च्छादयतो रणे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2167520, "chapter_id": 4596, "verse_number": "४६", "content_sanskrit": "द्रौणेस्तु धनुषः शब्दं रथानां त्रासनं रणे ।\nअश्रौषं बहुशो राजन् सिंहस्य नदतो यथा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2167521, "chapter_id": 4596, "verse_number": "४७", "content_sanskrit": "ज्या चास्य चरतो युद्धे सव्यं दक्षिणमस्यतः ।\nविद्युदम्भोधरस्येव भ्राजमाना व्यदृश्यत\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2167522, "chapter_id": 4596, "verse_number": "४८", "content_sanskrit": "स तदा क्षिप्रकारी च दृढहस्तश्च पाण्डवः ।\nप्रमोहं परमं गत्वा प्रेक्षन्नास्ते धनञ्जयः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2167523, "chapter_id": 4596, "verse_number": "४९", "content_sanskrit": "विक्रमं च हृतं मेने आत्मनस्तेन संयुगे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2167524, "chapter_id": 4596, "verse_number": "५०", "content_sanskrit": "तदाऽस्य समरे राजन् वपुरासीत् सुदुर्दृशम् ।\nद्रौणेस्तत् कुर्वतः कर्म यादृग्रूपं पिनाकिनः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2167525, "chapter_id": 4596, "verse_number": "५१", "content_sanskrit": "वर्धमाने ततस्तत्र द्रोणपुत्रे विशाम्पते ।\nहीयमाने च कौन्तेये कृष्णं रोषः समाविशत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2167526, "chapter_id": 4596, "verse_number": "५२", "content_sanskrit": "स रोषान्निश्वसन् राजन् निर्दहन्निव चक्षुषा ।\nद्रौणिं ददर्श सङ्ग्रामे फल्गुनं च मुहुर्मुहुः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2167527, "chapter_id": 4596, "verse_number": "५३", "content_sanskrit": "ततः क्रुद्धोऽब्रवीत् कृष्णः पार्थं सप्रणयं वचः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2167528, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2167529, "chapter_id": 4596, "verse_number": "५४", "content_sanskrit": "अत्यद्भुतमहं पार्थ त्वयि पश्यामि संयुगे ।\nयत् त्वां विशेषयत्याजौ द्रोणपुत्रोऽद्य भारत\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2167530, "chapter_id": 4596, "verse_number": "५५", "content_sanskrit": "कच्चित्ते गाण्डिवं हस्ते मुष्टिर्वा न व्यशीर्यत ।\nकच्चिद्वीर्यं यथापूर्वं भुजयोर्वा बलं तव\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2167531, "chapter_id": 4596, "verse_number": "५६", "content_sanskrit": "उदीर्यमाणं हि रणे पश्यामि द्रौणिमाहवे\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2167532, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "गुरुपुत्र इति ह्येनं मानयन् पाण्डवर्षभ ।\nउपेक्षां मा कृथाः पार्थ नायं कालो ह्युपेक्षितुम्\t॥५७॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2167533, "chapter_id": 4596, "verse_number": "५८", "content_sanskrit": "तस्य नादं ततः श्रुत्वा पाण्डवोच्युतमब्रवीत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2167534, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2167535, "chapter_id": 4596, "verse_number": "५९", "content_sanskrit": "पश्य माधव दौरात्म्यं गुरुपुत्रस्य साम्प्रतम् ।\nवधं प्राप्तौ मन्यते नौ प्रावेश्य शरवेश्मनि\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2167536, "chapter_id": 4596, "verse_number": "६०", "content_sanskrit": "एषोऽस्य हन्मि सङ्कल्पं शिक्षया च बलेन च\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2167537, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2167538, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "(एवमुक्त्वाऽस्य चिच्छेद भल्लैः सन्नतपर्वभिः ।\nधनुश्छत्रं पताकां च रथं शक्तिं गदां वराम्\t॥६१॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2167539, "chapter_id": 4596, "verse_number": "६२", "content_sanskrit": "अश्वत्थाम्नः शरानस्तान् छित्त्वैकैकं त्रिभिस्त्रिभिः ।\nव्यधमद् भरतश्रेष्ठो नीहारमिव मारुतः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2167540, "chapter_id": 4596, "verse_number": "६३", "content_sanskrit": "ततः संशप्तकान् भूयः साश्वसूतरथद्विपान् ।\nसपदातिगणानुग्रैर्बाणैर्विव्याध पाण्डवः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2167541, "chapter_id": 4596, "verse_number": "६४", "content_sanskrit": "ये ये ददृशिरे तत्र यद्यद्रूपं तदा जनाः ।\nते ते तत्तच्छरैर्व्याप्तं मेनिरेऽत्मानमेव च\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2167542, "chapter_id": 4596, "verse_number": "६५", "content_sanskrit": "गाण्डीवप्रच्युतास्ते वै नानारूपाः पतत्रिणः ।\nक्रोशे साग्रे स्थितान् जघ्नुर्द्विपांश्च पुरुषान् रणे\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2167543, "chapter_id": 4596, "verse_number": "६६", "content_sanskrit": "भल्लैश्छिन्नाः कराः पेतुर्द्विपानां मदवर्षिणाम् ।\nवने यथा परशुभिः निकृत्ताः शाल्मलिद्रुमाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2167544, "chapter_id": 4596, "verse_number": "६७", "content_sanskrit": "पश्चात्तु शैलवत् पेतुस्ते गजाः सह सादिभिः ।\nवज्रिवज्रप्रमथिता यथा शैलचयास्तथा\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2167545, "chapter_id": 4596, "verse_number": "६८", "content_sanskrit": "गन्धर्वनगराकारान् विधिवत् कल्पितान् रथान् ।\nविनीतैर्जवनैर्युक्तानास्थितान् युद्धदुर्मदैः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2167546, "chapter_id": 4596, "verse_number": "६९", "content_sanskrit": "शरैर्विशकलीकुर्वन्नमित्रानभ्यवीवृषत् ।\nस्वलङ्कृतानश्वसादीन् पत्तीन् निघ्नन् रणाजिरे\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2167547, "chapter_id": 4596, "verse_number": "७०", "content_sanskrit": "धनञ्जययुगान्ताग्निः संशप्तकमहार्णवम् ।\nव्यशोषयत दुःशेषं तिग्मैः शरगभस्तिभिः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2167548, "chapter_id": 4596, "verse_number": "७१", "content_sanskrit": "तं च द्रौणिमहाशैलं नाराचैः वज्रसन्निभैः ।\nनिर्बिभेद महावेगैः त्वरन् वज्रीव पर्वतम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2167549, "chapter_id": 4596, "verse_number": "७१", "content_sanskrit": "तमाचार्यसुतः क्रुद्धः साश्वयन्तारमाशुगैः ।\nछादयामास समरे पार्थस्तानन्तराऽच्छिनत्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2167550, "chapter_id": 4596, "verse_number": "७३", "content_sanskrit": "ततः परमसङ्क्रुद्धः काण्डकोशमवासृजत् ।\nअश्वत्थामाभिरूपाय गृहानतिथये यथा\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2167551, "chapter_id": 4596, "verse_number": "७४", "content_sanskrit": "अथ संशप्तकांस्त्यक्त्वा पाण्डवो द्रौणिमभ्ययात् ।\nअपाङ्क्तेयानिव त्यक्त्वा दाता पाङ्क्तेयमर्थिनम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2167552, "chapter_id": 4596, "verse_number": "", "content_sanskrit": "(स्थिताः संशप्तका राजन् दृष्ट्वा युद्धं महात्मनोः\t॥७५॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2167553, "chapter_id": 4596, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nषोडशोऽध्यायः ॥१६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]