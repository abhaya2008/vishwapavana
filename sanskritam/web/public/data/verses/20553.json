[{"id": 7000553000, "chapter_id": 20553, "verse_number": "५-१२-१", "content_sanskrit": "शेष उवाच ।\nइत्युक्तवंतं स्वपतिं वीक्ष्य प्रेम्णा सुनिर्भरम् ।\nप्रत्युवाच हसंतीव किंचिद्गद्गदभाषिणी ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000553001, "chapter_id": 20553, "verse_number": "५-१२-२", "content_sanskrit": "नाथ ते विजयोभूयात्सर्वत्र रणमंडले ।\nशत्रुघ्नाज्ञा प्रकर्तव्या हयरक्षा यथा भवेत् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000553002, "chapter_id": 20553, "verse_number": "५-१२-३", "content_sanskrit": "स्मरणीया हि सर्वत्र सेविका त्वत्पदानुगा ।\nकदापि मानसं नाथ त्वत्तो नान्यत्र गच्छति ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000553003, "chapter_id": 20553, "verse_number": "५-१२-४", "content_sanskrit": "परमायोधने कांत स्मर्तव्याहं न जातुचित् ।\nसत्यां मयि तव स्वांते युद्धे विजयसंशयः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000553004, "chapter_id": 20553, "verse_number": "५-१२-५", "content_sanskrit": "पद्मनेत्र तथा कार्यमूर्मिलाद्या यथा मम ।\nहास्यं नैव प्रकुर्वंति मां वीक्ष्य करताडनैः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000553005, "chapter_id": 20553, "verse_number": "५-१२-६", "content_sanskrit": "इयं पत्नी महाभीरोः संग्रामे प्रपलायितुः ।\nकातरा यर्हि युद्ध्यंति शूराणां समयः कुतः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000553006, "chapter_id": 20553, "verse_number": "५-१२-७", "content_sanskrit": "इत्येवं न हसंत्युच्चैर्यथा मे देवरांगनाः ।\nतथा कार्यं महाबाहो रामस्य हयरक्षणे ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000553007, "chapter_id": 20553, "verse_number": "५-१२-८", "content_sanskrit": "योद्धा त्वमादौ सर्वत्र परे ये तव पृष्ठतः ।\nधनुष्टंकारबधिराः क्रियंतां बलिनः परे ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000553008, "chapter_id": 20553, "verse_number": "५-१२-९", "content_sanskrit": "तवप्रोद्यत्करांभोज करवालभिया बलम् ।\nपरेषां भवतात्क्षिप्रमन्योन्य भयव्याकुलम् ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000553009, "chapter_id": 20553, "verse_number": "५-१२-१०", "content_sanskrit": "कुलं महदलं कार्यं परान्विजयता त्वया ।\nगच्छ स्वामिन्महाबाहो तव श्रेयो भवत्विह ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000553010, "chapter_id": 20553, "verse_number": "५-१२-११", "content_sanskrit": "इदं धनुर्गृहाणाशु महद्गुणविभूषितम् ।\nयस्य गर्जितमाकर्ण्य वैरिवृंदं भयातुरम् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000553011, "chapter_id": 20553, "verse_number": "५-१२-१२", "content_sanskrit": "इमौ ते त्विषुधी वीर बध्येतां शं यथा भवेत् ।\nवैरिकोटिविनिष्पेष बाणकोटि सुपूरितौ ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000553012, "chapter_id": 20553, "verse_number": "५-१२-१३", "content_sanskrit": "कवचं त्विदमाधेहि शरीरे कामसुंदरे ।\nवज्रप्रभा महादीप्ति हतसंतमसंदृढम् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000553013, "chapter_id": 20553, "verse_number": "५-१२-१४", "content_sanskrit": "शिरस्त्राणं निजोत्तंसे कुरु कांत मनोरमम् ।\nइमेव तंसे विशदे मणिरत्नविभूषिते ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000553014, "chapter_id": 20553, "verse_number": "५-१२-१५", "content_sanskrit": "इति सुविमलवाचं वीरपुत्रीं प्रपश्यन् ।\nनयनकमलदृष्ट्या वीक्षमाणस्तंदंगम् ।\nअधिगतपरिमोदो भारतिः शत्रुजेता ।\nरणकरणसमर्थस्तां जगादातिधीरः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000553015, "chapter_id": 20553, "verse_number": "५-१२-१६", "content_sanskrit": "पुष्कल उवाच ।\nकांते यत्त्वं वदसि मां तथा सर्वं चराम्यहम् ।\nवीरपत्नी भवेत्कीर्तिस्तव कांतिमतीप्सिता ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000553016, "chapter_id": 20553, "verse_number": "५-१२-१७", "content_sanskrit": "इति कांतिमतीदत्तं कवचं मुकुटं वरम् ।\nधनुर्महेषुधीखड्गं सर्वं जग्राह वीर्यवान् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000553017, "chapter_id": 20553, "verse_number": "५-१२-१८", "content_sanskrit": "परिधाय च तत्सर्वं बहुशो भासमन्वितः ।\nशुशुभेऽतीव सुभटः सर्वशस्त्रास्त्रकोविदः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000553018, "chapter_id": 20553, "verse_number": "५-१२-१९", "content_sanskrit": "तमस्त्रशस्त्रशोभाढ्यं वीरमालाविभूषितम् ।\nकुंकुमागुरुकस्तूरी चंदनादिकचर्चितम् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000553019, "chapter_id": 20553, "verse_number": "५-१२-२०", "content_sanskrit": "नानाकुसुममालाभिराजानुपरिशोभितम् ।\nनीराजयामास मुहुस्तत्र कांतिमती सती ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000553020, "chapter_id": 20553, "verse_number": "५-१२-२१", "content_sanskrit": "नीराजयित्वा बहुशः किरंती मौक्तिकैर्मुहुः ।\nगलदश्रुचलन्नेत्रा परिरेभे पतिं निजम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000553021, "chapter_id": 20553, "verse_number": "५-१२-२२", "content_sanskrit": "दृढं सपरिरभ्यैतां चिरमाश्वासयत्तदा ।\nवीरपत्नि कांतिमति विरहं मा कृथा मम ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000553022, "chapter_id": 20553, "verse_number": "५-१२-२३", "content_sanskrit": "एष गच्छामि सविधे तव भामे पतिव्रते ।\nइत्युक्त्वा तां निजां पत्नीं रथमारुरुहे वरम् ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000553023, "chapter_id": 20553, "verse_number": "५-१२-२४", "content_sanskrit": "तं प्रयांतं पतिं श्रेष्ठं नयनैर्निमिषोज्झितैः ।\nविलोकयामास तदा पतिव्रतपरायणा ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000553024, "chapter_id": 20553, "verse_number": "५-१२-२५", "content_sanskrit": "स ययौ जनकं द्रष्टुं जननीं प्रेमविह्वलाम् ।\nगत्वा पितरमंबां च ववंदे शिरसा मुदा ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000553025, "chapter_id": 20553, "verse_number": "५-१२-२६", "content_sanskrit": "माता पुत्रं परिष्वज्य स्वांकमारोपयत्तदा ।\nमुंचंती बाष्पनिचयं स्वस्त्यस्त्विति जगाद सा ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000553026, "chapter_id": 20553, "verse_number": "५-१२-२७", "content_sanskrit": "पितरं प्राह भरतं रामो यज्ञकरः परः ।\nपालनीयो लक्ष्मणेन भवद्भिश्च महात्मभिः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000553027, "chapter_id": 20553, "verse_number": "५-१२-२८", "content_sanskrit": "आज्ञप्तोऽसौ जनन्या च पित्रा हृषितया गिरा ।\nययौ शत्रुघ्नकटकं महावीरविभूषितम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000553028, "chapter_id": 20553, "verse_number": "५-१२-२९", "content_sanskrit": "रथिभिः पत्तिभिर्वीरैः सदश्वैः सादिभिर्वृतः ।\nययौ मुदा रघूत्तंस महायज्ञहयाग्रणीः ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000553029, "chapter_id": 20553, "verse_number": "५-१२-३०", "content_sanskrit": "गच्छन्पांचालदेशांश्च कुरूंश्चैवोत्तरान्कुरून् ।\nदशार्णाञ्छ्रीविशालांश्च सर्वशोभासमन्वितः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000553030, "chapter_id": 20553, "verse_number": "५-१२-३१", "content_sanskrit": "तत्र तत्रोपशृण्वानो रघुवीरयशोऽखिलम् ।\nरावणासुरघातेन भक्तरक्षाविधायकम् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000553031, "chapter_id": 20553, "verse_number": "५-१२-३२", "content_sanskrit": "पुनश्च हयमेधादि कार्यमारभ्य पावनम् ।\nयशो वितन्वन्भुवने लोकान्रामोऽविता भयात् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000553032, "chapter_id": 20553, "verse_number": "५-१२-३३", "content_sanskrit": "तेभ्यस्तुष्टो ददौ हारान्रत्नानि विविधानि च ।\nमहाधनानि वासांसि शत्रुघ्नः प्रवरो महान् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000553033, "chapter_id": 20553, "verse_number": "५-१२-३४", "content_sanskrit": "सुमतिर्नाम तेजस्वी सर्वविद्याविशारदः ।\nरघुनाथस्य सचिवः शत्रुघ्नानुचरो वरः ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000553034, "chapter_id": 20553, "verse_number": "५-१२-३५", "content_sanskrit": "ययौ तेन महावीरो ग्रामाञ्जनपदान्बहून् ।\nरघुनाथप्रतापेन न कोपि हृतवान्हयम् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000553035, "chapter_id": 20553, "verse_number": "५-१२-३६", "content_sanskrit": "देशाधिपाये बहवो महाबलपराक्रमाः ।\nहस्त्यश्वरथपादात चतुरंगसमन्विताः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000553036, "chapter_id": 20553, "verse_number": "५-१२-३७", "content_sanskrit": "संपदो बहुशो नीत्वा मुक्तामाणिक्यसंयुताः ।\nशत्रुघ्नं हयरक्षार्थमागतं प्रणता मुहुः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000553037, "chapter_id": 20553, "verse_number": "५-१२-३८", "content_sanskrit": "इदं राज्यं धनं सर्वं सपुत्रपशुबांधवम् ।\nरामचंद्रस्य सर्वं हि न मदीयं रघूद्वह ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000553038, "chapter_id": 20553, "verse_number": "५-१२-३९", "content_sanskrit": "एवं तदुक्तमाकर्ण्य शत्रुघ्नः परवीरहा ।\nआज्ञां स्वां तत्र संज्ञाप्य ययौ तैः सहितः पथि ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000553039, "chapter_id": 20553, "verse_number": "५-१२-४०", "content_sanskrit": "एवं क्रमेण संप्राप्तः शत्रुघ्नो हयसंयुतः ।\nअहिच्छत्रां पुरीं ब्रह्मन्नानाजनसमाकुलाम् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000553040, "chapter_id": 20553, "verse_number": "५-१२-४१", "content_sanskrit": "ब्रह्मद्विजसमाकीर्णां नानारत्नविभूषिताम् ।\nसौवर्णैः स्फाटिकैर्हर्म्यैर्गोपुरैः समलंकृताम् ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000553041, "chapter_id": 20553, "verse_number": "५-१२-४२", "content_sanskrit": "यत्र रंभा तिरस्कारकारिण्यः कमलाननाः ।\nदृश्यंते सर्वहर्म्येषु ललना लीलयान्विताः ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000553042, "chapter_id": 20553, "verse_number": "५-१२-४३", "content_sanskrit": "यत्र स्वाचारललिताः सर्वभोगैकभोगिनः ।\nधनदानुचरायद्वत्तथा लीलासमन्विताः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000553043, "chapter_id": 20553, "verse_number": "५-१२-४४", "content_sanskrit": "यत्र वीरा धनुर्हस्ताःशरसंधानकोविदाः ।\nकुर्वंति तत्र राजानं सुहृष्टं सुमदाभिधम् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000553044, "chapter_id": 20553, "verse_number": "५-१२-४५", "content_sanskrit": "एवंविधं ददर्शासौ नगरं दूरतः प्रभुः ।\nपार्श्वे तस्य पुरश्रेष्ठमुद्यानं शोभयान्वितम् ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000553045, "chapter_id": 20553, "verse_number": "५-१२-४६", "content_sanskrit": "पुन्नागैर्नागचंपैश्च तिलकैर्देवदारुभिः ।\nअशोकैः पाटलैश्चूतैर्मंदारैःकोविदारकैः ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000553046, "chapter_id": 20553, "verse_number": "५-१२-४७", "content_sanskrit": "आम्रजंबुकदंबैश्च प्रियालपनसैस्तथा ।\nशालैस्तालैस्तमालैश्च मल्लिकाजातियूथिभिः ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000553047, "chapter_id": 20553, "verse_number": "५-१२-४८", "content_sanskrit": "नीपैः कदंबैर्बकुलैश्चंपकैर्मदनादिभिः ।\nशोभितं सददर्शाथशत्रुघ्नःपरवीरहा ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000553048, "chapter_id": 20553, "verse_number": "५-१२-४९", "content_sanskrit": "हयोगतस्तद्वनमध्यदेशे ।\nतमालतालादि सुशोभिते वै ।\nययौ ततः पृष्ठत एव वीरो ।\nधनुर्धरैः सेवितपादपद्मः ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000553049, "chapter_id": 20553, "verse_number": "५-१२-५०", "content_sanskrit": "ददर्श त रचितं देवायतनमद्भुतम् ।\nइंद्रनीलैश्च वैडूर्यैस्तथा मारकतैरपि ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000553050, "chapter_id": 20553, "verse_number": "५-१२-५१", "content_sanskrit": "शोभितं सुरसेवार्हं कैलासप्रस्थसन्निभम् ।\nजातरूपमयैः स्तंभैःशोभितं सद्मनां वरम् ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000553051, "chapter_id": 20553, "verse_number": "५-१२-५२", "content_sanskrit": "दृष्ट्वातद्रघुनाथस्य भ्राता देवालयं वरम् ।\nपप्रच्छ सुमतिं स्वीयं मंत्रिणं वदतांवरम् ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000553052, "chapter_id": 20553, "verse_number": "५-१२-५३", "content_sanskrit": "शत्रुघ्न उवाच ।\nवदामात्य वरेदं किं कस्यदेवस्य केतनम् ।\nका देवता पूज्यतेऽत्र कस्य हेतोः स्थितानघ ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000553053, "chapter_id": 20553, "verse_number": "५-१२-५४", "content_sanskrit": "एवमाकर्ण्य यथावदिहसर्वशः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000553054, "chapter_id": 20553, "verse_number": "५-१२-५५", "content_sanskrit": "कामाक्षायाः परं स्थानं विद्धि विश्वैकशर्मदम् ।\nयस्या दर्शनमात्रेण सर्वसिद्धिः प्रजापते ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000553055, "chapter_id": 20553, "verse_number": "५-१२-५६", "content_sanskrit": "देवासुरास्तु यां स्तुत्वा नत्वा प्राप्ताखिलां श्रियम् ।\nधर्मार्थकाममोक्षाणां दात्री भक्तानुकंपिनी ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000553056, "chapter_id": 20553, "verse_number": "५-१२-५७", "content_sanskrit": "याचिता सुमदेनात्राहिच्छत्रा पतिना पुरा ।\nस्थिता करोति सकलं भक्तानां दुःखहारिणी ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000553057, "chapter_id": 20553, "verse_number": "५-१२-५८", "content_sanskrit": "तां नमस्कुरु शत्रुघ्न सर्ववीर शिरोमणे ।\nनत्वाशु सिद्धिं प्राप्नोषि ससुरासुरदुर्ल्लभाम् ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000553058, "chapter_id": 20553, "verse_number": "५-१२-५९", "content_sanskrit": "इति श्रुत्वाथ तद्वाक्यं शत्रुघ्नः शत्रुतापनः ।\nपप्रच्छ सकलां वार्तां भवान्याः पुरुषर्षभः ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000553059, "chapter_id": 20553, "verse_number": "५-१२-६०", "content_sanskrit": "शत्रुघ्न उवाच ।\nकोऽहिच्छत्रापती राजा सुमदः किं तपः कृतम् ।\nयेनेयं सर्वलोकानां माता तुष्टात्र संस्थिता ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000553060, "chapter_id": 20553, "verse_number": "५-१२-६१", "content_sanskrit": "वद सर्वं महामात्य नानार्थपरिबृंहितम् ।\nयथावत्त्वं हि जानासि तस्माद्वद महामते ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000553061, "chapter_id": 20553, "verse_number": "५-१२-६२", "content_sanskrit": "सुमतिरुवाच ।\nहेमकूटो गिरिः पूतः सर्वदेवोपशोभितः ।\nतत्रास्ति तीर्थं विमलमृषिवृंदसुसेवितम् ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000553062, "chapter_id": 20553, "verse_number": "५-१२-६३", "content_sanskrit": "सुमदो हि तपस्तेपे हतमातृपितृप्रजः ।\nअरिभिः सर्वसामंतैर्जगाम तपसे हि तम् ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000553063, "chapter_id": 20553, "verse_number": "५-१२-६४", "content_sanskrit": "वर्षाणि त्रीणि सपदा त्वेकेन मनसा स्मरन् ।\nजगतां मातरं दध्यौ नासाग्रस्तिमितेक्षणः ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000553064, "chapter_id": 20553, "verse_number": "५-१२-६५", "content_sanskrit": "वर्षाणि त्रीणि शुष्काणां पर्णानां भक्षणं चरन् ।\nचकार परमुग्रं स तपः परमदुश्चरम् ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000553065, "chapter_id": 20553, "verse_number": "५-१२-६६", "content_sanskrit": "अब्दानि त्रीणि सलिले शीतकाले ममज्ज सः ।\nग्रीष्मे चचार पंचाग्नीन्प्रावृट्सु जलदोन्मुखः ॥६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000553066, "chapter_id": 20553, "verse_number": "५-१२-६७", "content_sanskrit": "त्रीणि वर्षाणि पवनं संरुध्य स्वांतगोचरम् ।\nभवानीं संस्मरन्धीरो न च किंचन पश्यति ॥६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000553067, "chapter_id": 20553, "verse_number": "५-१२-६८", "content_sanskrit": "वर्षे तु द्वादशेऽतीते दृष्ट्वैतत्परमं तपः ।\nविभाव्य मनसातीव शक्रः पस्पर्ध तं भयात् ॥६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000553068, "chapter_id": 20553, "verse_number": "५-१२-६९", "content_sanskrit": "आदिदेश सकामं तु परिवारपरीवृतम् ।\nअप्सरोभिः सुसंयुक्तं ब्रह्मेंद्रादिजयोद्यतम् ॥६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000553069, "chapter_id": 20553, "verse_number": "५-१२-७०", "content_sanskrit": "गच्छ कामसखे मह्यं प्रियमाचर मोहन ।\nसुमदस्य तपोविघ्नं समाचर यथा भवेत् ॥७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000553070, "chapter_id": 20553, "verse_number": "५-१२-७१", "content_sanskrit": "इति श्रुत्वा महद्वाक्यं तुरासाहः स्वयंप्रभुः ।\nउवाच विश्वविजये प्रौढगर्वो रघूद्वह ॥७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000553071, "chapter_id": 20553, "verse_number": "५-१२-७२", "content_sanskrit": "काम उवाच ।\nस्वामिन्कोऽसौ हि सुमदः किं तपः स्वल्पकं पुनः ।\nब्रह्मादीनां तपोभंगं करोम्यस्य तु का कथा ॥७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000553072, "chapter_id": 20553, "verse_number": "५-१२-७३", "content_sanskrit": "मद्बाणबलनिर्भिन्नश्चंद्रस्तारां गतः पुरा ।\nत्वमप्यहल्यां गतवान्विश्वामित्रस्तु मेनिकाम् ॥७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000553073, "chapter_id": 20553, "verse_number": "५-१२-७४", "content_sanskrit": "चिंतां मा कुरु देवेंद्र सेवके मयि संस्थिते ।\nएष गच्छामि सुमदं देवान्पालय मारिष ॥७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000553074, "chapter_id": 20553, "verse_number": "५-१२-७५", "content_sanskrit": "एवमुक्त्वा कामदेवो हेमकूटं गिरिं ययौ ।\nवसंतेन युतः सख्या तथैवाप्सरसांगणैः ॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000553075, "chapter_id": 20553, "verse_number": "५-१२-७६", "content_sanskrit": "वसंतस्तत्र सकलान्वृक्षान्पुष्पफलैर्युतान् ।\nकोकिलान्षट्पदश्रेण्या घुष्टानाशु चकार ह ॥७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000553076, "chapter_id": 20553, "verse_number": "५-१२-७७", "content_sanskrit": "वायुः सुशीतलो वाति दक्षिणां दिशमाश्रितः ।\nकृतमालासरित्तीर लवंगकुसुमान्वितः ॥७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000553077, "chapter_id": 20553, "verse_number": "५-१२-७८", "content_sanskrit": "एवंविधे वने वृत्ते रंभानामाप्सरोवरा ।\nसखीभिः संवृता तत्र जगाम सुमदांतिकम् ॥७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000553078, "chapter_id": 20553, "verse_number": "५-१२-७९", "content_sanskrit": "तत्रारभत गानं सा किन्नरस्वरशोभना ।\nमृदंगपणवानेकवाद्यभेदविशारदा ॥७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000553079, "chapter_id": 20553, "verse_number": "५-१२-८०", "content_sanskrit": "तद्गानमाकर्ण्य नराधिपोऽसौ ।\nवसंतमालोक्य मनोहरं च ।\nतथान्यपुष्टारटितं मनोरमं ।\nचकार चक्षुः परिवर्तनं बुधः ॥८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000553080, "chapter_id": 20553, "verse_number": "५-१२-८१", "content_sanskrit": "तं प्रबुद्धं नृपं वीक्ष्य कामः पुष्पायुधस्त्वरन् ।\nचकार सत्वरं सज्यं धनुस्तत्पृष्ठतोऽनघ ॥८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000553081, "chapter_id": 20553, "verse_number": "५-१२-८२", "content_sanskrit": "एकाप्सरास्तत्र नृपस्य पादयोः ।\nसंवाहनं नर्तितनेत्रपल्लवा ।\nचकार चान्या तु कटाक्षमोक्षणं ।\nचकार काचिद्भृशमंगचेष्टितम् ॥८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000553082, "chapter_id": 20553, "verse_number": "५-१२-८३", "content_sanskrit": "अप्सरोभिस्तथाकीर्णः कामविह्वलमानसः ।\nचिंतयामास मतिमाञ्जितेंद्रियशिरोमणिः ॥८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000553083, "chapter_id": 20553, "verse_number": "५-१२-८४", "content_sanskrit": "एता मे तपसो विघ्नकारिण्योऽप्सरसां वराः ।\nशक्रेण प्रेषिताः सर्वाः करिष्यंति यथातथम् ॥८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000553084, "chapter_id": 20553, "verse_number": "५-१२-८५", "content_sanskrit": "इति संचिंत्य सुतपास्ता उवाच वरांगनाः ।\nका यूयं कुत्र संस्थाः किं भवतीनां चिकीर्षितम् ॥८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000553085, "chapter_id": 20553, "verse_number": "५-१२-८६", "content_sanskrit": "अत्यद्भुतं जातमहो यद्भवत्योऽक्षिगोचराः ।\nयास्तपोभिः सुदुष्प्राप्यास्ता मे तपस आगताः ॥८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]