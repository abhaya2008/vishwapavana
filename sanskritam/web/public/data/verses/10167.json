[{"id": 6000167000, "chapter_id": 10167, "verse_number": null, "content_sanskrit": "अथ चतुर्दशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000167001, "chapter_id": 10167, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.001.m4a", "display_order": 2}, {"id": 6000167002, "chapter_id": 10167, "verse_number": "८-१४-१", "content_sanskrit": "बलेः पदत्रयं भूमेः कस्माद्धरिरयाचत।\nभूत्वेश्वरः कृपणवल्लब्धार्थोऽपि बबन्ध तम्॥ ८/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.002.m4a", "display_order": 3, "topics": [{"text": "पूर्वमिन्द्रपराजितस्य बलेः पुरोहितेन शुक्राचार्येण सर्वलोकजयाय विश्वजिता याजनम्", "range": "१–१४"}]}, {"id": 6000167003, "chapter_id": 10167, "verse_number": "८-१४-२", "content_sanskrit": "एतद् वेदितुमिच्छामो महत् कौतूहलं हि नः।\nयाञ्चेश्वरस्य पूर्णस्य बन्धनं वाऽप्यनागसः॥ ८/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.003.m4a", "display_order": 4}, {"id": 6000167004, "chapter_id": 10167, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.004.m4a", "display_order": 5}, {"id": 6000167005, "chapter_id": 10167, "verse_number": "८-१४-३", "content_sanskrit": "पराजितश्रीरसुभिश्च हापितो इन्द्रेण राजन् गुरुभिः स जीवितः।\nसर्वात्मना तानभजद् भृगून् बलिः शिष्यो महान् स्वार्थनिवेदनेन॥ ८/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.005.m4a", "display_order": 6}, {"id": 6000167006, "chapter_id": 10167, "verse_number": "८-१४-४", "content_sanskrit": "तं ब्राह्मणा भृगवः प्रीयमाणा अयाजयन् विश्वजिता त्रिलोकम्।\nजिगीषमाणं विधिनाऽभिषिच्य महाभिषेकेण महानुभावाः॥ ८/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.006.m4a", "display_order": 7}, {"id": 6000167007, "chapter_id": 10167, "verse_number": "८-१४-५", "content_sanskrit": "ततो रथः काञ्चनपट्टबद्धो हयाश्च हर्यश्वतुरङ्गवर्णाः।\nध्वजश्च सिंहेन विराजमानो हुताशनादास हविर्भिरिद्घात्॥ ८/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.007.m4a", "display_order": 8}, {"id": 6000167008, "chapter_id": 10167, "verse_number": "८-१४-६", "content_sanskrit": "धनुश्च दिव्यं पुरटोपनद्धं तूणावरिक्तौ कवचं च दिव्यम्।\nपितामहस्तस्य ददौ च मालामम्लानपुष्पां जलजं च शुक्रः॥ ८/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.008.m4a", "display_order": 9}, {"id": 6000167009, "chapter_id": 10167, "verse_number": "८-१४-७", "content_sanskrit": "एवं स विप्रार्जितयोधनार्थस्तैः कल्पितस्वस्त्ययनोऽथ विप्रान्।\nप्रदक्षिणीकृत्य कृतप्रणामः प्रह्लादमामन्त्र्य नमश्चकार॥ ८/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.009.m4a", "display_order": 10}, {"id": 6000167010, "chapter_id": 10167, "verse_number": "८-१४-८", "content_sanskrit": "अथारुह्य रथं दिव्यं भृगुदत्तं महारथः।\nसुस्रग्धरोऽथ सन्नद्धो धन्वी खड्गी धृतेषुधिः॥ ८/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.010.m4a", "display_order": 11}, {"id": 6000167011, "chapter_id": 10167, "verse_number": "८-१४-९", "content_sanskrit": "हेमाङ्गदलसद्बाहुः स्फुरन्मकरकुण्डलः।\nरराज रथमारूढो धिष्ण्यस्थ इव हव्यवाट्॥ ८/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.011.m4a", "display_order": 12}, {"id": 6000167012, "chapter_id": 10167, "verse_number": "८-१४-१०", "content_sanskrit": "तुल्यैश्वर्यवयःश्रीभिः स्वयूथैर्दैत्ययूथपैः।\nपिबद्भिरिव खं दृग्भिर्दहद्भिः परिधीनिव॥ ८/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.012.m4a", "display_order": 13}, {"id": 6000167013, "chapter_id": 10167, "verse_number": "८-१४-११", "content_sanskrit": "वृतो विकर्षन् महतीमासुरीं ध्वजिनीं विभुः।\nययाविन्द्रपुरीमृद्धां कम्पयन्निव रोदसीम्॥ ८/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.013.m4a", "display_order": 14}, {"id": 6000167014, "chapter_id": 10167, "verse_number": "८-१४-१२", "content_sanskrit": "रम्यामुपवनोद्यानैः श्रीमद्भिर्नन्दनादिभिः।\nकूजद्विहङ्गमिथुनैर्गायन्मत्तमधुव्रतैः॥ ८/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.014.m4a", "display_order": 15}, {"id": 6000167015, "chapter_id": 10167, "verse_number": "८-१४-१३", "content_sanskrit": "प्रवालफलपुष्पोरुभारशाखामरद्रुमैः।\nहंससारसचक्राह्वकारण्डवकुलाकुलाम्॥ ८/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.015.m4a", "display_order": 16}, {"id": 6000167016, "chapter_id": 10167, "verse_number": "८-१४-१४", "content_sanskrit": "नलिन्यो यत्र क्रीडन्ति प्रमदाः सुरसेविताः।\nआकाशगङ्गया देव्या वृतां परिखभूतया॥ ८/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.016.m4a", "display_order": 17}, {"id": 6000167017, "chapter_id": 10167, "verse_number": "८-१४-१५", "content_sanskrit": "प्राकारेणाग्निवर्णेन साट्टालेनोन्नतेन च।\nरुक्मपट्टकपाटैश्च द्वारैः स्फाटिकगोपुरैः॥ ८/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.017.m4a", "display_order": 18, "topics": [{"text": "गुरुप्रसादसमुन्नद्धबलस्य बलेर्भयात् देवगणसहितस्येन्द्रस्य त्रिविष्टपात्पलायनम्", "range": "१५–३७"}]}, {"id": 6000167018, "chapter_id": 10167, "verse_number": "८-१४-१६", "content_sanskrit": "जुष्टां विभक्तप्रपथां विश्वकर्मविनिर्मिताम्। सभाचत्वररथ्याढ्यां विमानैर्न्यर्बुदैर्युताम्।\nशृृङ्गाटकैर्मणिमयैर्वज्रविद्रुमवेदिभिः॥ ८/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.018.m4a", "display_order": 19}, {"id": 6000167019, "chapter_id": 10167, "verse_number": "८-१४-१७", "content_sanskrit": "यत्र नित्यवयोरूपाः श्यामा विरजवाससः।\nभ्राजन्ते रूपवन्नार्य अर्चिर्भिरिव वह्नयः॥ ८/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.019.m4a", "display_order": 20}, {"id": 6000167020, "chapter_id": 10167, "verse_number": "८-१४-१८", "content_sanskrit": "सुरस्‍त्रीकेशविभ्रष्टनवसौगन्धिकस्रजाम्।\nयत्रामोदमुपादाय मार्ग आवाति मारुतः॥ ८/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.020.m4a", "display_order": 21}, {"id": 6000167021, "chapter_id": 10167, "verse_number": "८-१४-१९", "content_sanskrit": "हेमजालाक्षनिर्गच्छद्धूमेनागुरुगन्धिना।\nपाण्डुरेण प्रतिच्छन्नमार्गे यान्ति सुरस्‍त्रियः॥ ८/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.021.m4a", "display_order": 22}, {"id": 6000167022, "chapter_id": 10167, "verse_number": "८-१४-२०", "content_sanskrit": "मुक्तावितानैर्मणिहेमकेतुभिर्नानापताकावलिभीभिरावृताम्।\nशिखण्डिपारावतभृङ्गनादितां वैमानिकस्‍त्रीकलगीतमङ्गलाम्॥ ८/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.022.m4a", "display_order": 23}, {"id": 6000167023, "chapter_id": 10167, "verse_number": "८-१४-२१", "content_sanskrit": "मृदङ्गशङ्खानकदुन्दुभिस्वनैः सतालवीणामुरजर्ष्टिवेणुभिः।\nनृत्यैः सवाद्यैरुपदेवगीतकैर्मनोरमां स्वप्रभया जितग्रहाम्॥ ८/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.023.m4a", "display_order": 24}, {"id": 6000167024, "chapter_id": 10167, "verse_number": "८-१४-२२", "content_sanskrit": "यां न व्रजन्त्यधर्मिष्ठाः खला भूतद्रुहः शठाः।\nमानिनः कामिनो लुब्धा एभिर्हीना व्रजन्त्युत॥ ८/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.024.m4a", "display_order": 25}, {"id": 6000167025, "chapter_id": 10167, "verse_number": "८-१४-२३", "content_sanskrit": "तां देवधानीं स वरूथिनीपतिर्बहिः समन्ताद् रुरुधे पृतन्यया।\nआचार्यदत्तं जलजं महास्वनं दध्मौ प्रयुञ्जन् भयमिन्द्रयोषिताम्॥ ८/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.025.m4a", "display_order": 26}, {"id": 6000167026, "chapter_id": 10167, "verse_number": "८-१४-२४", "content_sanskrit": "मघवांस्तदभिप्रेत्य बलेः परममुद्यमम्।\nसर्वदेवगणोपेतो गुरुमेतदुवाच ह॥ ८/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.026.m4a", "display_order": 27}, {"id": 6000167027, "chapter_id": 10167, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.027.m4a", "display_order": 28}, {"id": 6000167028, "chapter_id": 10167, "verse_number": "८-१४-२५", "content_sanskrit": "भगवन्नुद्यमो भूयान् बलेर्नः पूर्ववैरिणः।\nअविषह्यमिदं मन्ये केनासीत् तेजसा समः॥ ८/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.028.m4a", "display_order": 29}, {"id": 6000167029, "chapter_id": 10167, "verse_number": "८-१४-२६", "content_sanskrit": "नैनं कश्चित् कुतो वाऽपि प्रतिवोढुमधीश्वरः।\nपिबन्निव मुखेनेदं लिहन्निव दिशो दश॥ ८/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.029.m4a", "display_order": 30}, {"id": 6000167030, "chapter_id": 10167, "verse_number": "८-१४-२७", "content_sanskrit": "दहन्निव दिशो दृग्भिः संवर्ताग्निरिवोत्थितः॥ ८/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.030.m4a", "display_order": 31}, {"id": 6000167031, "chapter_id": 10167, "verse_number": "८-१४-२८", "content_sanskrit": "ब्रूहि कारणमेतस्य दुर्धर्षत्वस्य मद्रिपोः।\nओजः सहो बलं तेजो यत एष समुद्यमः॥ ८/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.031.m4a", "display_order": 32}, {"id": 6000167032, "chapter_id": 10167, "verse_number": null, "content_sanskrit": "गुरुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.032.m4a", "display_order": 33}, {"id": 6000167033, "chapter_id": 10167, "verse_number": "८-१४-२९", "content_sanskrit": "जानामि मघवन् शत्रोरुन्नतेरस्य कारणम्।\nशिष्यायोपभृतं तेजो गुरुभिर्ब्रह्मवादिभिः॥ ८/१४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.033.m4a", "display_order": 34}, {"id": 6000167034, "chapter_id": 10167, "verse_number": "८-१४-३०", "content_sanskrit": "भवद्विधो भवान् वाऽपि वर्जयित्वेश्वरं हरिम्।\nनास्य शक्तः पुरः स्थातुं कृतान्तस्य यथा जनाः॥ ८/१४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.034.m4a", "display_order": 35}, {"id": 6000167035, "chapter_id": 10167, "verse_number": "८-१४-३१", "content_sanskrit": "तस्मान्निलयमुत्सृज्य यूयं सर्वे त्रिविष्टपम्।\nयात कालं प्रतीक्षन्तो यतः शत्रोर्विपर्ययः॥ ८/१४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.035.m4a", "display_order": 36}, {"id": 6000167036, "chapter_id": 10167, "verse_number": "८-१४-३२", "content_sanskrit": "एष विप्रबलोदर्कः सम्प्रत्यूर्जितविक्रमः।\nएषामेवावमानेन सानुबन्धो विनङ्क्ष्यति॥ ८/१४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.036.m4a", "display_order": 37}, {"id": 6000167037, "chapter_id": 10167, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.037.m4a", "display_order": 38}, {"id": 6000167038, "chapter_id": 10167, "verse_number": "८-१४-३३", "content_sanskrit": "एवं सुमन्त्रितार्थास्ते गुरुणाऽर्थानुदर्शिना।\nहित्वा त्रिविष्टपं जग्मुर्गीर्वाणाः कामरूपिणः॥ ८/१४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.038.m4a", "display_order": 39}, {"id": 6000167039, "chapter_id": 10167, "verse_number": "८-१४-३४", "content_sanskrit": "देवेष्वतिविलीनेषु बलिर्वैरोचनः पुरीम्।\nदेवधानीमधिष्ठाय वशं निन्ये जगत्त्रयम्॥ ८/१४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.039.m4a", "display_order": 40}, {"id": 6000167040, "chapter_id": 10167, "verse_number": "८-१४-३५", "content_sanskrit": "तं विश्वजयिनं शिष्यं भृगवः शिष्यवत्सलाः।\nशतेन हयमेधानाम् अनुव्रतमयाजयन्॥ ८/१४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.040.m4a", "display_order": 41}, {"id": 6000167041, "chapter_id": 10167, "verse_number": "८-१४-३६", "content_sanskrit": "ततस्तदनुभावेन भुवनत्रयविश्रुताम्।\nकीर्तिं दिक्षु वितन्वानः स रेज उडुराडिव॥ ८/१४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.041.m4a", "display_order": 42}, {"id": 6000167042, "chapter_id": 10167, "verse_number": "८-१४-३७", "content_sanskrit": "बुभुजे च श्रियं स्वृद्धां द्विजदेवोपलम्भिताम्।\nकृतकृत्यमिवात्मानं मन्यमानो महामनाः॥ ८/१४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_014/BhP_08.014.042.m4a", "display_order": 43}, {"id": 6000167043, "chapter_id": 10167, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे चतुर्दशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]