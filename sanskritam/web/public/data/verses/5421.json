[{"id": 2207335, "chapter_id": 5421, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207336, "chapter_id": 5421, "verse_number": "१", "content_sanskrit": "विजिते पाण्डवेयैस्तु प्रशान्ते च द्विजोत्तम ।\nराष्ट्रे किं चक्रतुर्वीरौ वासुदेवधनञ्जयौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207337, "chapter_id": 5421, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207338, "chapter_id": 5421, "verse_number": "२", "content_sanskrit": "विजिते पाण्डवै राजन् प्रशान्ते च विशाम्पतौ ।\nराष्ट्रे बभूवतुर्हृष्टौ वासुदेवधनञ्जयौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207339, "chapter_id": 5421, "verse_number": "३", "content_sanskrit": "विजह्राते मुदा युक्तौ दिवि देवेश्वराविव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207340, "chapter_id": 5421, "verse_number": "४", "content_sanskrit": "तौ वनेषु विचित्रेषु पर्वतानां च सानुषु ।\nशैलेषु गह्वरारण्ये पल्वलेषु नदीषु च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207341, "chapter_id": 5421, "verse_number": "५", "content_sanskrit": "चङ्क्रम्यमाणौ संहृष्टावश्विनाविव नन्दने ।\nइन्द्रप्रस्थे महात्मानौ रेमाते कृष्णपाण्डवौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207342, "chapter_id": 5421, "verse_number": "६", "content_sanskrit": "प्रविश्य तां सभां रम्यां विजह्राते च भारत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207343, "chapter_id": 5421, "verse_number": "७", "content_sanskrit": "तत्र युद्धकथाश्चित्राः परिक्लेशांश्च भारत ।\nकथायोगे कथायोगे कथयामासतुः सदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207344, "chapter_id": 5421, "verse_number": "८", "content_sanskrit": "ऋषीणां देवतानां च वंशान् व्याहरतां तदा ।\nप्रीयमाणौ महात्मानौ पुराणावृषिसत्तमौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207345, "chapter_id": 5421, "verse_number": "९", "content_sanskrit": "मधुरास्तु कथाश्चित्राः चित्रार्थपदनिश्चयाः ।\nनिश्चयज्ञः स पार्थाय कथयामास केशवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207346, "chapter_id": 5421, "verse_number": "१०", "content_sanskrit": "पुत्रशोकाभिसन्तप्तं ज्ञातीनां च सहस्रशः ।\nकथाभिः शमयामास पार्थं शौरिर्जनार्दनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207347, "chapter_id": 5421, "verse_number": "११", "content_sanskrit": "स तमाश्वास्य विधिवद् विधानज्ञो महातपाः ।\nअपहृत्यात्मनो भारं विशश्राम ससात्वतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207348, "chapter_id": 5421, "verse_number": "१२", "content_sanskrit": "ततः कथान्ते गोविन्दो गुडाकेशमुवाच ह ।\nसान्त्वयन् श्लक्ष्णया वाचा हेतुयुक्तमिदं वचः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207349, "chapter_id": 5421, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207350, "chapter_id": 5421, "verse_number": "१३", "content_sanskrit": "विजितेयं धरा कृत्स्ना सव्यसाचिन् परन्तप ।\nत्वद् बाहुबलमाश्रित्य राज्ञा धर्मसुतेन ह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207351, "chapter_id": 5421, "verse_number": "१४", "content_sanskrit": "असपत्नां महीं भुङ्क्ते धर्मराजो युधिष्ठिरः ।\nभीमसेनप्रतापेन यमयोश्च नरोत्तम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207352, "chapter_id": 5421, "verse_number": "१५", "content_sanskrit": "धर्मेण राज्ञा धर्मज्ञ प्राप्तं राज्यमकण्टकम् ।\nधर्मेण निहतः सङ्खे स च राजा सुयोधनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207353, "chapter_id": 5421, "verse_number": "१६", "content_sanskrit": "अधर्मरुचयो लुब्धाः सदा चाप्रियवादिनः ।\nधार्तराष्ट्रा दुरात्मानः सानुबन्धा निपातिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207354, "chapter_id": 5421, "verse_number": "१७", "content_sanskrit": "प्रशान्तामखिलां पार्थ पृथिवीं पृथिवीपतिः ।\nभुङ्क्ते धर्मसुतो राजा त्वया गुप्तः कुरूद्वह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207355, "chapter_id": 5421, "verse_number": "१८", "content_sanskrit": "केन वाहं त्वया सार्धमरण्येष्विह पाण्डव ।\nकिमु यत्र जनोऽयं वै वृथा चामित्रकर्शन ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207356, "chapter_id": 5421, "verse_number": "१९", "content_sanskrit": "यत्र धर्मसुतो राजा यत्र भीमो महाबलः ।\nयत्र माद्रवतीपुत्रौ रतिस्तत्र परा मम ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207357, "chapter_id": 5421, "verse_number": "२०", "content_sanskrit": "तथैव स्वर्गकल्पेषु सभोद्देशेषु भारत ।\nरमणीयेषु पुण्येषु सहितस्य त्वयाऽनघ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207358, "chapter_id": 5421, "verse_number": "२१", "content_sanskrit": "कालो महांस्त्वतीतो मे शूरपुत्रमपश्यतः ।\nबलदेवं च कौरव्य तथाऽन्यान् वृष्णिपुङ्गवान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207359, "chapter_id": 5421, "verse_number": "२२", "content_sanskrit": "सोऽहं गन्तुमभीप्सामि पुरीं द्वारवतीं प्रति ।\nरोचतां गमनं तुभ्यं ममापि भरतर्षभ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207360, "chapter_id": 5421, "verse_number": "२३", "content_sanskrit": "उक्तो बहुविधं राजा तत्र तत्र युधिष्ठिरः ।\nसह भीष्मेण यद्युक्तमस्माभिः शोककर्शितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207361, "chapter_id": 5421, "verse_number": "२४", "content_sanskrit": "शिष्टो युधिष्ठिरोऽस्माभिः शास्ता सन्नपि पाण्डवः ।\nतेन तच्च वचः सम्यग् गृहीतं सुमहात्मना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207362, "chapter_id": 5421, "verse_number": "२५", "content_sanskrit": "धर्मपुत्रे हि धर्मज्ञे कृतज्ञे सत्यवादिनि ।\nसत्यं धर्मो मतिश्चाग्र्या स्थितिश्च सततं स्थितौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207363, "chapter_id": 5421, "verse_number": "२६", "content_sanskrit": "तद्गत्वा तं महात्मानं यदि ते रोचतेऽर्जुन ।\nअस्मद्गमनसंयुक्तं वचो ब्रूहि जनाधिपम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207364, "chapter_id": 5421, "verse_number": "२७", "content_sanskrit": "न हि तस्याप्रियं कुर्यां प्राणत्यागेऽप्युपस्थिते ।\nकुतो गन्तुं महाबाहो पुरीं द्वारवतीं प्रति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207365, "chapter_id": 5421, "verse_number": "२८", "content_sanskrit": "सर्वमेतदहं पार्थ त्वत्प्रीतिहितकाम्यया ।\nब्रवीमि सत्यं कौरव्य न मिथ्यैतत् कथञ्चन ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207366, "chapter_id": 5421, "verse_number": "२९", "content_sanskrit": "प्रयोजनं च निर्वृत्तमिह वासेन मेऽर्जुन ।\nधार्तराष्ट्रो हतो राजा सबलः सपदानुगः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207367, "chapter_id": 5421, "verse_number": "३०", "content_sanskrit": "पृथिवी च वशे तात धर्मपुत्रस्य धीमतः ।\nस्थिता समुद्रवसना सशैलवनकानना ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207368, "chapter_id": 5421, "verse_number": "३१", "content_sanskrit": "चिता रत्नैर्बहुविधैः कुरुराजस्य पाण्डव ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207369, "chapter_id": 5421, "verse_number": "३२", "content_sanskrit": "धर्मेण राज्ञा धर्मज्ञः पातु सर्वां वसुन्धराम् ।\nउपास्यमानो मुनिभिः सिद्धैश्चापि महात्मभिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207370, "chapter_id": 5421, "verse_number": "३३", "content_sanskrit": "संस्तूयमानः सततं वन्दिभिर्भरतर्षभ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207371, "chapter_id": 5421, "verse_number": "३४", "content_sanskrit": "त्वं मया सह गत्वाऽद्य राजानं कुरुवर्धनम् ।\nआपृच्छ कुरुशार्दूलं गमनं द्वारकां प्रति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207372, "chapter_id": 5421, "verse_number": "३५", "content_sanskrit": "इदं शरीरं वसु यच्च मे गृहे\nनिवेदितं पार्थ सदा युधिष्ठिरे ।\nप्रियश्च मान्यश्च हि मे युधिष्ठिरः\nसदा कुरूणामधिपो महामतिः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207373, "chapter_id": 5421, "verse_number": "३६", "content_sanskrit": "प्रयोजनं चापि विवासकारणे\nन विद्यते मे त्वदृते महाभुजे ।\nस्थिता हि पृथ्वी तव पार्थ शासने\nगुरोः सुवृत्तस्य युधिष्ठिरस्य हि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2207374, "chapter_id": 5421, "verse_number": "३७", "content_sanskrit": "इतीदमुक्तः स तदा महात्मना\nजनार्दनेनामितविक्रमोऽर्जुनः ।\nतथेति कृच्छ्रादिव वाचमीरयन्\nजनार्दनं सम्प्रतिपूज्य पार्थिवः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2207375, "chapter_id": 5421, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि\nकृष्णस्य द्वारावतीं प्रतिगमनं नाम पञ्चदशोऽध्यायः ॥१५॥\nअश्वमेधपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2207376, "chapter_id": 5421, "verse_number": "", "content_sanskrit": "॥ समाप्तम् अश्वमेधपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]