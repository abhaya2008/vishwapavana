[{"id": 2187139, "chapter_id": 4977, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2187140, "chapter_id": 4977, "verse_number": "१", "content_sanskrit": "किमुत्तरं तदा तौ स्म चक्रतुस्तेन भाषिते ।\nब्राह्मणो वाथ वा राजा तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2187141, "chapter_id": 4977, "verse_number": "", "content_sanskrit": "अथ वा तौ गतौ तत्र यदेतत् कीर्तितं त्वया ।\nसंवादो वा तयोः कोऽभूत् किं वा तौ तत्र चक्रतुः\t॥२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2187142, "chapter_id": 4977, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2187143, "chapter_id": 4977, "verse_number": "३", "content_sanskrit": "तथेत्येवं प्रतिश्रुत्य धर्मं सम्पूज्य चाभिभो ।\nयमं कालं च मृत्युं च स्वर्गं सम्पूज्य चार्हतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2187144, "chapter_id": 4977, "verse_number": "४", "content_sanskrit": "पूर्वं ये चापरे तत्र समेता ब्राह्मणर्षभाः ।\nसर्वान् सम्पूज्य शिरसा राजानं सोऽब्रवीद्वचः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2187145, "chapter_id": 4977, "verse_number": "५", "content_sanskrit": "फलेनानेन संयुक्तो राजर्षे गच्छ पुण्यताम् ।\nभवता चाभ्यनुज्ञातो जपेयं भूय एव हि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2187146, "chapter_id": 4977, "verse_number": "६", "content_sanskrit": "वरश्च मम पूर्वं हि देव्या दत्तो महाबल ।\nश्रद्धा ते जपतो नित्यं भवितेति विशां पते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2187147, "chapter_id": 4977, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2187148, "chapter_id": 4977, "verse_number": "७", "content_sanskrit": "यद्येवमफला सिद्धिः श्रद्धा च जपितुं तव ।\nगच्छ विप्र मया सार्धं जापकं फलमाप्नुहि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2187149, "chapter_id": 4977, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2187150, "chapter_id": 4977, "verse_number": "८", "content_sanskrit": "कृतः प्रयत्नः सुमहान् सर्वेषां सन्निधाविह ।\nसह तुल्यफलौ चावां गच्छावो यत्र नौ गतिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2187151, "chapter_id": 4977, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2187152, "chapter_id": 4977, "verse_number": "९", "content_sanskrit": "व्यवसायं तयोस्तत्र विदित्वा त्रिदशेश्वरः ।\nसह देवैरुपययौ लोकपालैस्तथैव च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2187153, "chapter_id": 4977, "verse_number": "१०", "content_sanskrit": "साध्या विश्वेऽथ मरुतो वाक्यानि सुमहान्ति च ।\nनद्यः शैलाः समुद्राश्च तीर्थानि विविधानि च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2187154, "chapter_id": 4977, "verse_number": "११", "content_sanskrit": "तपांसि संयोगविधिर्वेदाः स्तोभाः सरस्वती ।\nनारदः पर्वतश्चैव विश्वावसुर्हहा हुहूः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2187155, "chapter_id": 4977, "verse_number": "१२", "content_sanskrit": "तुम्बुरुप्रमुखाश्चैव हाहा हूहूस्तथैव च ।\nआजगाम च देवेशो ब्रह्मा वेदमयोऽव्ययः \t॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2187156, "chapter_id": 4977, "verse_number": "१३", "content_sanskrit": "गन्धर्वश्चित्रसेनश्च परिवारगणैर्युतः ।\nनागाः सिद्धाश्च मुनयो देवदेवः प्रजापतिः॥\nविष्णुः सहस्रशीर्षश्च देवोऽचिन्त्यः समागमत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2187157, "chapter_id": 4977, "verse_number": "१४", "content_sanskrit": "अवाद्यन्तान्तरिक्षे च भेर्यस्तूर्याणि चाभिभो ।\nपुष्पवर्षाणि दिव्यानि तत्र तेषां महात्मनाम्॥\nननृतुश्चाप्सरःसङ्घास्तत्र तत्र समन्ततः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2187158, "chapter_id": 4977, "verse_number": "१५", "content_sanskrit": "अथ स्वर्गस्तथा रूपी ब्राह्मणं वाक्यमब्रवीत् ।\nसंसिद्धस्त्वं महाभाग त्वं च सिद्धस्तथा नृप\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2187159, "chapter_id": 4977, "verse_number": "१६", "content_sanskrit": "अथ तौ सहितौ राजन्नन्योन्येन विधानतः ।\nविषयप्रतिसंहारमुभावेव प्रचक्रतुः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2187160, "chapter_id": 4977, "verse_number": "१७", "content_sanskrit": "प्राणापानौ तथोदानं समानं व्यानमेव च ।\nएवं तान्मनसि स्थाप्य दधतुः प्राणयोर्मनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2187161, "chapter_id": 4977, "verse_number": "१८", "content_sanskrit": "उपस्थितकृतौ तत्र नासिकाग्रमधो भ्रुवौ ।\nकुङ्कुण्यां चैव मनसा शनैर्धारयतः स्म तौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2187162, "chapter_id": 4977, "verse_number": "१९", "content_sanskrit": "निश्चेष्टाभ्यां शरीराभ्यां स्थिरदृष्टी समाहितौ ।\nजितासनौ तथाधाय मूर्धन्यात्मानमेव च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2187163, "chapter_id": 4977, "verse_number": "२०", "content_sanskrit": "तालुदेशमथोद्दाल्य ब्राह्मणस्य महात्मनः ।\nज्योतिर्ज्वाला सुमहती जगाम त्रिदिवं तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2187164, "chapter_id": 4977, "verse_number": "२१", "content_sanskrit": "हाहाकारस्ततो दिक्षु सर्वासु सुमहानभूत् ।\nतज्ज्योतिः स्तूयमानं स्म ब्रह्माणं प्राविशत्तदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2187165, "chapter_id": 4977, "verse_number": "२२", "content_sanskrit": "ततः स्वागतमित्याह तत्तेजः स पितामहः ।\nप्रादेशमात्रं पुरुषं प्रत्युद्गम्य विशां पते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2187166, "chapter_id": 4977, "verse_number": "२३", "content_sanskrit": "भूयश्चैवापरं प्राह वचनं मधुरं स्म सः ।\nजापकैस्तुल्यफलता योगानां नात्र संशयः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2187167, "chapter_id": 4977, "verse_number": "२४", "content_sanskrit": "योगस्य तावदेतेभ्यः फलं प्रत्यक्षदर्शनम् ।\nजापकानां विशिष्टं तु प्रत्युत्थानं समाधिकम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2187168, "chapter_id": 4977, "verse_number": "२५", "content_sanskrit": "उष्यतां मयि चेत्युक्त्वाचेतयत्स ततः पुनः ।\nअथास्य प्रविवेशास्यं ब्राह्मणो विगतज्वरः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2187169, "chapter_id": 4977, "verse_number": "२६", "content_sanskrit": "राजाप्येतेन विधिना भगवन्तं पितामहम् ।\nयथैव द्विजशार्दूलस्तथैव प्राविशत्तदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2187170, "chapter_id": 4977, "verse_number": "२७", "content_sanskrit": "स्वयम्भुवमथो देवा अभिवाद्य ततोऽब्रुवन् ।\nजापकार्थमयं यत्नस्तदर्थं वयमागताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2187171, "chapter_id": 4977, "verse_number": "२८", "content_sanskrit": "कृतपूजाविमौ तुल्यं त्वया तुल्यफलाविमौ ।\nयोगजापकयोर्दृष्टं फलं सुमहदद्य वै ।\nसर्वाँल्लोकानतीत्यैतौ गच्छेतां यत्र वाञ्छितम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2187172, "chapter_id": 4977, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2187173, "chapter_id": 4977, "verse_number": "२९", "content_sanskrit": "महास्मृतिं पठेद्यस्तु तथैवानुस्मृतिं शुभाम् ।\nतावप्येतेन विधिना गच्छेतां मत्सलोकताम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2187174, "chapter_id": 4977, "verse_number": "३०", "content_sanskrit": "यश्च योगे भवेद्भक्तः सोऽपि नास्त्यत्र संशयः ।\nविधिनानेन देहान्ते मम लोकानवाप्नुयात् ।\nगम्यतां साधयिष्यामि यथास्थानानि सिद्धये\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2187175, "chapter_id": 4977, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2187176, "chapter_id": 4977, "verse_number": "३१", "content_sanskrit": "इत्युक्त्वा स तदा देवस्तत्रैवान्तरधीयत ।\nआमन्त्र्य तं ततो देवा ययुः स्वं स्वं निवेशनम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2187177, "chapter_id": 4977, "verse_number": "३२", "content_sanskrit": "ते च सर्वे महात्मानो धर्मं सत्कृत्य तत्र वै ।\nपृष्ठतोऽनुययू राजन् सर्वे सुप्रीतमानसाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2187178, "chapter_id": 4977, "verse_number": "३३", "content_sanskrit": "एतत्फलं जापकानां गतिश्चैव प्रकीर्तिता ।\nयथाश्रुतं महाराज किं भूयः श्रोतुमिच्छसि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2187179, "chapter_id": 4977, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे षड्विंशोऽध्यायः ॥ २६ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]