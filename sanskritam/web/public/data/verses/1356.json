[{"id": 2017051, "chapter_id": 1356, "verse_number": "२-९७-१", "content_sanskrit": "दुर्योधन उवाच॥\nशृणु राजन्पुराऽचिन्त्यानर्जुनस्य च साहसान्।\nअर्जुनो धन्विनां श्रेष्ठो दुष्करं कृतवान्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017052, "chapter_id": 1356, "verse_number": "२-९७-२", "content_sanskrit": "द्रुपदस्य पुरे राजन्द्रौपद्याश्च स्वयंवर॥\nआबालवृद्धसङ्क्षोभे सर्वक्षत्रसमागमे।\nक्षिप्रकारी जले मत्स्यं दुर्निरीक्ष्यं ससर्ज ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017053, "chapter_id": 1356, "verse_number": "२-९७-३", "content_sanskrit": "सर्वैर्नृपैरसाध्यं तत्कार्मुकप्रवरं च वै।\nक्षणेन सज्यमकरोत्सर्वक्षत्रस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017054, "chapter_id": 1356, "verse_number": "२-९७-४", "content_sanskrit": "ततो यन्त्रमयं विध्वा विसारं फल्गुनो बली।\nकृष्णया हेममाल्येन स्कन्धे स परिवेष्टितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017055, "chapter_id": 1356, "verse_number": "२-९७-५", "content_sanskrit": "ततस्तया वृतं पार्थं दृष्ट्वा सर्वे नृपास्तदा।\nरोषात्सर्वायुधान्गृह्य क्रुद्धा वीरा महौजसः।\nवैकर्तनं पुरस्कृत्य सर्वे पार्थमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017056, "chapter_id": 1356, "verse_number": "२-९७-६", "content_sanskrit": "स सर्वान्पार्थिवान्दृष्ट्वा क्रुद्धान्पार्थो महाबलः।\nवारयित्वा शरैस्तीक्ष्णैरजयत्तत्र स स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017057, "chapter_id": 1356, "verse_number": "२-९७-७", "content_sanskrit": "जित्वा तु तान्महीपालान्सर्वान्कर्णपुरोगमान्।\nलेभे कृष्णां शुभां पार्थो युध्वा वीर्यबलात्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017058, "chapter_id": 1356, "verse_number": "२-९७-८", "content_sanskrit": "सर्वक्षत्रसमूहेषु अम्बां भीष्मो यथा पुरा।\nततः कदाचिद्बीभत्सुस्तीर्ययात्रां ययौ स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017059, "chapter_id": 1356, "verse_number": "२-९७-९", "content_sanskrit": "अथोलूपीं शुभां तात नागराजसतां तदा।\nनागेष्वाप वराग्र्येषु प्रार्थितोऽथ यथा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017060, "chapter_id": 1356, "verse_number": "२-९७-१०", "content_sanskrit": "ततो गोदावरीं कृष्णां कावेरीं चावगाहत।\nतत्र पाण्ड्यं समासाद्य तस्य कन्यामवाप सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017061, "chapter_id": 1356, "verse_number": "२-९७-११", "content_sanskrit": "लब्ध्वा जिष्णुर्मुदं तत्र ततो याम्यां दिशं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017062, "chapter_id": 1356, "verse_number": "२-९७-१२", "content_sanskrit": "स दक्षिणं समुद्रान्तं गत्वा चाप्सरसां च वै।\nकुमारतीर्थमासाद्य मोक्षयामास चार्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017063, "chapter_id": 1356, "verse_number": "२-९७-१३", "content_sanskrit": "ग्राहरूपाश्च ताः पञ्च अतिशौर्येण वै बलात्।\nकन्यातीर्थं समभ्येत्य ततो द्वारवतीं ययौ॥।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017064, "chapter_id": 1356, "verse_number": "२-९७-१४", "content_sanskrit": "तत्र कृष्णनिदेशात्स सुभद्रां प्राप्य फल्गुनः।\nतामारोप्य रथोपस्थे प्रययौ स्वपुरीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017065, "chapter_id": 1356, "verse_number": "२-९७-१५", "content_sanskrit": "अथादाय गते पार्थे ते श्रुत्वा सर्वयादवाः।\nतमभ्यधावन्त्सङ्क्रुद्धाः सिंहव्याघ्रगणा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017066, "chapter_id": 1356, "verse_number": "२-९७-१६", "content_sanskrit": "प्रद्युम्नः कृतवर्मा च गदः सारणसात्यकी।\nआहुकश्चैव साम्बश्च चारुदेष्णो विदूरथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017067, "chapter_id": 1356, "verse_number": "२-९७-१७", "content_sanskrit": "अन्ये च यादवाः सर्वे बलदेवपुरोगमाः।\nएकमेव परे कृष्णं गजवाजिरथैर्युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017068, "chapter_id": 1356, "verse_number": "२-९७-१८", "content_sanskrit": "अथासाद्य वने यान्तं परिवार्य धनञ्जयम्।\nचक्रुर्युद्धं सुसङ्क्रुद्धा बहुकोट्यश्च यादवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017069, "chapter_id": 1356, "verse_number": "२-९७-१९", "content_sanskrit": "एक एव तु पार्थस्तैर्युद्धं चक्रे सुदारुणम्।\nतेन तेषां समं युद्धं मुहूर्तं प्रबभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017070, "chapter_id": 1356, "verse_number": "२-९७-२०", "content_sanskrit": "ततः पार्थो रणे सर्वान्वारयित्वा शितैः शरैः।\nबलाद्विजित्य राजेन्द्र वीरस्तान्सर्वयादवान्।\nतां सुभद्रामथादाय शक्रप्रस्थं विवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017071, "chapter_id": 1356, "verse_number": "२-९७-२१", "content_sanskrit": "भूयः शृणु महाराज फल्गुनस्य च साहसम्।\nददौ स वह्नेर्बिभत्सुः प्रार्थितं खाण्डवं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017072, "chapter_id": 1356, "verse_number": "२-९७-२२", "content_sanskrit": "लब्धमात्रे तु तेनाथ भगवान्हव्यवाहनः।\nभक्षितुं खाण्डवं राजंस्तत्रस्थानुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017073, "chapter_id": 1356, "verse_number": "२-९७-२३", "content_sanskrit": "ततस्तं भक्षयन्तं वै सव्यसाची विभावसुम्।\nरथा धन्वी शरान्गृह्य स कलापयुतः प्रभुः।\nपालयामास राजेन्द्र स्ववीर्येण महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017074, "chapter_id": 1356, "verse_number": "२-९७-२४", "content_sanskrit": "ततः श्रुत्वा महेनद्रस्तु मेघांस्तान्सन्दिदेश ह।\nतेनोक्ता मेघसङ्घास्ते ववर्षुरतिवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017075, "chapter_id": 1356, "verse_number": "२-९७-२५", "content_sanskrit": "ततो मेघगाणान्पार्थः शरव्रातैः समान्ततः।\nखगमैर्वारयामास तदाश्चर्यमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017076, "chapter_id": 1356, "verse_number": "२-९७-२६", "content_sanskrit": "वारितान्मेघसङ्घांश्च श्रुत्वा क्रुद्धः पुरन्दरः।\nपाण्डरं गजमास्थाय सर्वदेवगणैर्वृतः।\nययौ पार्थेन संयोद्धुं रक्षार्थं खाण्डवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017077, "chapter_id": 1356, "verse_number": "२-९७-२७", "content_sanskrit": "रुद्राश्च मरुतश्चैव वसवश्चाश्विनौ तदा।\nआदित्याश्चैव साध्याश्च निश्वेदेवाश्च भारत।\nगन्धर्वाश्चैव सहिता अन्ये देवगणाश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017078, "chapter_id": 1356, "verse_number": "२-९७-२८", "content_sanskrit": "ते सर्वे शस्त्रसम्पन्ना दीप्यमानाः स्वतेजसा।\nधनञ्जयं जिघांसन्तः प्रपेतुर्विबुधाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017079, "chapter_id": 1356, "verse_number": "२-९७-२९", "content_sanskrit": "युगान्ते यानि दृश्यन्ते निमित्तानि महान्त्यपि।\nसर्वाणि तत्र दृश्यन्ते निमित्तानि महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017080, "chapter_id": 1356, "verse_number": "२-९७-३०", "content_sanskrit": "ततो देवगमाः सर्वे पार्थं समभिदुद्रुवुः।\nअसम्भ्रान्तस्तु तान्दृष्ट्वा स तां देवमयीं चमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017081, "chapter_id": 1356, "verse_number": "२-९७-३१", "content_sanskrit": "त्वरितः फल्गुनो गृह्य तीक्ष्णांस्तानाशुगांस्तदा।\nइन्द्रं देवांश्च सम्प्रेक्ष्य तस्थौ काल इवात्यये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017082, "chapter_id": 1356, "verse_number": "२-९७-३२", "content_sanskrit": "ततो देवगणाः सर्वे बीभत्सुं सपुरन्दराः।\nअवाकिरञ्छरव्रातैर्मानुषं तं महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017083, "chapter_id": 1356, "verse_number": "२-९७-३३", "content_sanskrit": "ततः पार्थो महातेजा गाण्डिवं गृह्य सत्वरः।\nवारयामास देवानां शरव्रातैः शरांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017084, "chapter_id": 1356, "verse_number": "२-९७-३४", "content_sanskrit": "पुनः क्रुद्धाः सुराः सर्वे मर्त्यं तं सुभहाबलाः।\nनानाशस्त्रैर्ववर्षुस्तं सव्यसाची महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017085, "chapter_id": 1356, "verse_number": "२-९७-३५", "content_sanskrit": "तान्पार्थः शस्त्रवर्षान्वै विसृष्टान्विबुधैस्तदा।\nद्विधा त्रिधा स चिच्छेद स एव निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017086, "chapter_id": 1356, "verse_number": "२-९७-३६", "content_sanskrit": "पुनश्च पार्थः सङ्क्रुद्धो मण्डलीकृतकार्मुकः।\nदेवसङ्घाञ्छरैस्तीक्ष्णैरर्पयन्वै समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017087, "chapter_id": 1356, "verse_number": "२-९७-३७", "content_sanskrit": "ततो देवगणाः सर्वे युध्वा पार्थेन वै मुहुः।\nरणे जेतुमशक्यं तं ज्ञात्वा ते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017088, "chapter_id": 1356, "verse_number": "२-९७-३८", "content_sanskrit": "शान्तास्ते विबुधाः सर्वे पार्थबाणाभिपीडिताः।\nसद्विपं वासवं त्यक्त्वा दुद्रुवुः सर्वतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017089, "chapter_id": 1356, "verse_number": "२-९७-३९", "content_sanskrit": "प्राचीं रुद्राः सगन्धर्वा दक्षिणां मरुतो ययुः।\nदिशं प्रतीचीं भीतास्ते वसवश्च तथाऽश्विनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017090, "chapter_id": 1356, "verse_number": "२-९७-४०", "content_sanskrit": "आदित्याश्चैव विश्वे च दुद्रुवुर्वा उदङ्मुखाः।\nसाध्याश्चोर्ध्वमुखा भीताश्चिन्तयन्तोऽस्य सायकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017091, "chapter_id": 1356, "verse_number": "२-९७-४१", "content_sanskrit": "एवं सुरगणाः सर्वे प्राद्रवन्त्सर्वतो दिशम्।\nमुहुर्मुहुः प्रेक्षमाणाः पार्थमेव सकार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017092, "chapter_id": 1356, "verse_number": "२-९७-४२", "content_sanskrit": "विद्रुतान्देवसङ्घांस्तान्रणे दृष्ट्वा पुरन्दरः।\nततः क्रुद्धो महातेजाः पार्थं बाणैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017093, "chapter_id": 1356, "verse_number": "२-९७-४३", "content_sanskrit": "पार्थोऽपि शक्रं विव्याथ मानुषो विबुधाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017094, "chapter_id": 1356, "verse_number": "२-९७-४४", "content_sanskrit": "ततः सोऽश्ममयं वर्षं व्यसृजद्विबुधाधिपः।\nतच्छरैरर्जुनो वर्षं प्रतिजाघ्नेऽत्यमर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017095, "chapter_id": 1356, "verse_number": "२-९७-४५", "content_sanskrit": "अथ संवर्धयामास तद्वर्षं देवराडपि।\nभूय एव महावीर्यं जिज्ञासुः सव्यसाचिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017096, "chapter_id": 1356, "verse_number": "२-९७-४६", "content_sanskrit": "सोऽश्मवर्षं महावेगमिषुभिः पाण्डवोऽपि च।\nविलयं गमयामास हर्षयन्पाकशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017097, "chapter_id": 1356, "verse_number": "२-९७-४७", "content_sanskrit": "उपादाय तु पाणिभ्यामङ्गदं नाम पर्वतम्।\nसद्रुमं व्यसृजच्छक्रो जिघांसुः श्वेतवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017098, "chapter_id": 1356, "verse_number": "२-९७-४८", "content_sanskrit": "ततोऽर्जुनो वेगवद्भिर्ज्वलमानैरजिह्यगैः।\nबाणैर्विध्वंसयामास गिरिराजं सहस्रधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017099, "chapter_id": 1356, "verse_number": "२-९७-४९", "content_sanskrit": "शक्रं च पातयामास शरैः पार्थो महान्युधि।\nततः शक्रो महाराज रणे वीरं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017100, "chapter_id": 1356, "verse_number": "२-९७-५०", "content_sanskrit": "ज्ञात्वा जेतुमशक्यं तं तेजोबलसमन्वितम्।\nपरां प्रीति ययौ तत्र पुत्रशौर्येण वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017101, "chapter_id": 1356, "verse_number": "२-९७-५१", "content_sanskrit": "तदा तत्र न तस्यास्ति दिवि कश्चिन्महायशाः।\nसमर्थो निर्जये राजन्नपि साक्षात्प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2017102, "chapter_id": 1356, "verse_number": "२-९७-५२", "content_sanskrit": "ततः पार्थः शरैर्हत्वा यक्षराक्षसपन्नगान्।\nदीप्ते चाग्नौ महातेजाः पातयामास सन्ततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2017103, "chapter_id": 1356, "verse_number": "२-९७-५३", "content_sanskrit": "प्रतिषेधयितुं पार्थं न शेकुस्तत्र केचन।\nदृष्ट्वा निवारितं शक्रं दिवि देवगणैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2017104, "chapter_id": 1356, "verse_number": "२-९७-५४", "content_sanskrit": "यथा सुपर्णः सोमार्थं विबुधानजयत्पुरा।\nतथा जित्वा सुरान्पार्थस्तर्पयामास पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2017105, "chapter_id": 1356, "verse_number": "२-९७-५५", "content_sanskrit": "ततोऽर्जुनः स्ववीर्येण तर्पयित्वा विभावसुम्।\nरथं ध्वजं च सहयं दिव्यानस्त्रांश्च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2017106, "chapter_id": 1356, "verse_number": "२-९७-५६", "content_sanskrit": "गाण्डीवं च धनुः श्रेष्ठं तूणी चाक्षयसायकौ।\nएतान्यपि च बीभत्सुर्लेभे कीर्ति च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2017107, "chapter_id": 1356, "verse_number": "२-९७-५७", "content_sanskrit": "भूयोऽपि शृणु राजेन्द्र पार्थो गत्वोत्तरां दिशम्।\nविजित्य नववर्षांश्च सपुरांश्च सपर्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2017108, "chapter_id": 1356, "verse_number": "२-९७-५८", "content_sanskrit": "जम्बुद्वीपं वशे कृत्वा सर्वं तद्भरतर्षभ।\nबलाज्जित्वा नृपान्सर्वान्करे चविनिवेश्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2017109, "chapter_id": 1356, "verse_number": "२-९७-५९", "content_sanskrit": "रत्नान्यादाय सर्वाणि गत्वा चैव पुनः पुरीम्।\nततो ज्येष्ठं महात्मानं धर्मराजं युधिष्ठिरम्।\nराजसूयं क्रतुश्रेष्ठं कारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2017110, "chapter_id": 1356, "verse_number": "२-९७-६०", "content_sanskrit": "स तान्यन्यानि कर्माणि कृतवानर्जुनः पुरा।\nअर्जुनेन समो वीर्ये त्रिषु लोकेषु न क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2017111, "chapter_id": 1356, "verse_number": "२-९७-६१", "content_sanskrit": "देवदानवयक्षाश्च पिशाचोरगराक्षसाः।\nभीष्मद्रोणादयः सर्वे कुरवश्च महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2017112, "chapter_id": 1356, "verse_number": "२-९७-६२", "content_sanskrit": "लोके सर्वनृपाश्चैव वीराश्चान्ये धनुर्धराः।\nएते पार्थं रणे युक्ताः प्रतियोद्धुं न शक्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2017113, "chapter_id": 1356, "verse_number": "२-९७-६३", "content_sanskrit": "अहं हि नित्यं कौरव्य फल्गुनं हृदि संस्थितम्।\nअपश्यं चिन्तयित्वा तं समुद्विग्नोऽस्मि तद्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2017114, "chapter_id": 1356, "verse_number": "२-९७-६४", "content_sanskrit": "गृहे गृहे च पश्यामि तात पार्थमहं सदा।\nशरगाण्डीवसंयुक्तं पाशहस्तमिवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2017115, "chapter_id": 1356, "verse_number": "२-९७-६५", "content_sanskrit": "अपि पार्थसहस्राणि भीतः पश्यामि भारत।\nपार्थभूतमिदं सर्वं नगरं प्रतिभाति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2017116, "chapter_id": 1356, "verse_number": "२-९७-६६", "content_sanskrit": "पार्थमेव हि पश्यामि रहिते तात भारत।\nदृष्ट्वा स्वप्नगतं पार्थमुद्धमामि विचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2017117, "chapter_id": 1356, "verse_number": "२-९७-६७", "content_sanskrit": "अकारादीनि नामानि अर्जुनग्रस्तचेतसः।\nअश्वाक्षराम्बुजाश्चैव त्रासं सञ्जनयन्ति मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2017118, "chapter_id": 1356, "verse_number": "२-९७-६८", "content_sanskrit": "नास्ति पार्थादृते तात परवीराद्भयं मम।\nप्रह्लादं वा बलिं वापि हन्याद्धि विजयो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2017119, "chapter_id": 1356, "verse_number": "२-९७-६९", "content_sanskrit": "तस्मात्तेन महाराज युद्धं नस्तात न क्षमम्।\nअहं तस्य प्रभावज्ञो नित्यं दुःखं वहामि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2017120, "chapter_id": 1356, "verse_number": "२-९७-७०", "content_sanskrit": "पुरा हि दण्डकारण्ये मारीचस्य यथा भयम्।\nभवेद्रामे महावीर्ये तथा पार्थे भयं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2017121, "chapter_id": 1356, "verse_number": "२-९७-७१x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2017122, "chapter_id": 1356, "verse_number": "२-९७-७१", "content_sanskrit": "जानाम्येव महद्वीयं जिष्णोरेतद्दुरासदम्।\nएतद्वीरस्य पार्थस्य कार्षीस्त्वं तु विप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2017123, "chapter_id": 1356, "verse_number": "२-९७-७२", "content_sanskrit": "द्यूतं वा शस्त्रयुद्धं वा दुवाक्यं वा कथञ्चन।\nएतेष्वेवं कृते तस्य विग्रहश्चैव वो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2017124, "chapter_id": 1356, "verse_number": "२-९७-७३", "content_sanskrit": "तस्मात्त्वं पुत्र पार्थेन नित्यं स्नेहेन वर्तय।\nयश्च पार्थेन सम्बन्धो वर्तते चेन्नरो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2017125, "chapter_id": 1356, "verse_number": "२-९७-७४", "content_sanskrit": "तस्य नास्ति भयं किञ्चित्रिषु लोकेषु भारत।\nतस्मात्त्वं जिष्णुना वत्स नित्यं स्नेहेन वर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2017126, "chapter_id": 1356, "verse_number": "२-९७-७५x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2017127, "chapter_id": 1356, "verse_number": "२-९७-७५", "content_sanskrit": "द्यूते पार्थस्य कौरव्य मायया निकृतिः कृता।\nतस्माद्वि नो जयस्तात अन्योपायेन नो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2017128, "chapter_id": 1356, "verse_number": "२-९७-७६x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2017129, "chapter_id": 1356, "verse_number": "२-९७-७६", "content_sanskrit": "उपायश्च न कर्तव्यः पाण्डवान्प्रति भारत।\nपार्थान्प्रति पुरा वत्स बहूपायाः कृतास्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2017130, "chapter_id": 1356, "verse_number": "२-९७-७७", "content_sanskrit": "तानुपायान्हि कौन्तेया बहुशो व्यतिचक्रमुः।\nतस्माद्वितं जीविताय नः कुलस्य जनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2017131, "chapter_id": 1356, "verse_number": "२-९७-७८", "content_sanskrit": "त्वं चिकीर्षसि चेद्वत्स समित्रः सहबान्धवः।\nसभ्रातृकस्त्वं पार्थेन नित्यं स्नेहेन वर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2017132, "chapter_id": 1356, "verse_number": "२-९७-७९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2017133, "chapter_id": 1356, "verse_number": "२-९७-७९", "content_sanskrit": "धृतराष्ट्रवचः श्रुत्वा राजा दुर्योधनस्तदा।\nचिन्तयित्वा मुहूर्तं तु विधिना चोदितोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2017134, "chapter_id": 1356, "verse_number": "२-९७-८०", "content_sanskrit": "पुनर्दीव्याम भद्रं ते वनवासाय पाण्डवैः।\nएवमेतान्वशे कर्तुं शक्ष्यामः पुरुषर्षभ॥ष", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2017135, "chapter_id": 1356, "verse_number": "२-९७-८१", "content_sanskrit": "ते वा द्वादश वर्षाणि वयं वा द्यूतनिर्जिताः।\nप्रविशेम महारण्यमजिनैः प्रतिवासिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2017136, "chapter_id": 1356, "verse_number": "२-९७-८२", "content_sanskrit": "त्रयोदशं च स्वजनैरज्ञाताः परिवत्सरम्।\nज्ञाताश्च पुनरन्यानि वने वर्षाणि द्वादश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2017137, "chapter_id": 1356, "verse_number": "२-९७-८३", "content_sanskrit": "निवसेम वयं ते वा तथा द्यूतं प्रवर्तताम्।\nअक्षानुप्त्वा पुनर्द्यूतमिदं कुर्वन्तु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2017138, "chapter_id": 1356, "verse_number": "२-९७-८४", "content_sanskrit": "एतत्कृत्यतमं राजन्नस्माकं भरतर्षभ।\nअयं हि शकुनिर्वेद सविद्यामक्षसम्पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2017139, "chapter_id": 1356, "verse_number": "२-९७-८५", "content_sanskrit": "दृढमूलं वयं राज्ये मित्राणि परिगृह्य च।\nसारवद्विपुलं सैन्यं सत्कृत्य च दुरासदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2017140, "chapter_id": 1356, "verse_number": "२-९७-८६", "content_sanskrit": "ते च त्रयोदशं वर्षं पारयिष्यन्ति चेद्व्रतम्।\nजेष्यामस्तान्वयं राजत्रोचतां ते परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2017141, "chapter_id": 1356, "verse_number": "२-९७-८७x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2017142, "chapter_id": 1356, "verse_number": "२-९७-८७", "content_sanskrit": "तूर्णं प्रत्यानयस्वैतान्कामं व्यध्वगतानपि।\nआगच्छन्तु पुनर्द्यूतमिदं कुर्वन्तु पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2017143, "chapter_id": 1356, "verse_number": "२-९७-८८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2017144, "chapter_id": 1356, "verse_number": "२-९७-८८", "content_sanskrit": "ततो द्रोणः सोमदत्तो बाह्लीकश्चैव गौतमः।\nविदुरो द्रोणपुत्रश्च वैश्यापुत्रश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2017145, "chapter_id": 1356, "verse_number": "२-९७-८९", "content_sanskrit": "भूरिश्रवाः शान्तनवो विकर्णश्च महारथः।\nमा द्यूतमित्यभाषन्त शमोऽस्त्विति च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2017146, "chapter_id": 1356, "verse_number": "२-९७-९०", "content_sanskrit": "अकामानां च सर्वेषां सुहृदामर्थदर्शिनाम्।\nअकरोत्पाण्डवाह्वानं धृतराष्ट्रः सुतप्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2017147, "chapter_id": 1356, "verse_number": "२-९७-९१", "content_sanskrit": "अथाब्रवीन्महाराज धृतराष्ट्रं जनेश्वरम्।\nपुत्रहार्दाद्धर्मयुक्ता गान्धारी शोककर्शिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2017148, "chapter_id": 1356, "verse_number": "२-९७-९२", "content_sanskrit": "जाते दुर्योधने क्षत्ता महामतिरभाषत।\nनीयतां परलोकाय साध्वयं कुलपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2017149, "chapter_id": 1356, "verse_number": "२-९७-९३", "content_sanskrit": "व्यनदज्जातमात्रो हि गोमायुरिव भारत।\nअन्तो नूनं कुलस्यास्य कुरवस्तन्निबोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2017150, "chapter_id": 1356, "verse_number": "२-९७-९४", "content_sanskrit": "मा निमज्जीः स्वदोषेण महाप्सु त्वं हि भारत।\nमा बालानामशिष्टानामभिमंस्था मतिं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2017151, "chapter_id": 1356, "verse_number": "२-९७-९५", "content_sanskrit": "मा कुलस्य क्षये घोरे कारणं त्वं भविष्यसि।\nबद्धं सेतुं को नु भिन्द्याद्धमेच्छान्तं च पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2017152, "chapter_id": 1356, "verse_number": "२-९७-९६", "content_sanskrit": "शमे स्थितान्को नु पार्थान्कोपयेद्भरतर्षभ।\nस्मरन्तं त्वामाजमीढं स्मारयिष्याम्यहं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2017153, "chapter_id": 1356, "verse_number": "२-९७-९७", "content_sanskrit": "शास्त्रं न शास्ति दुर्बुद्धिं श्रेयसे चेतराय च।\nन वै वृद्धो बालमतिर्भवेद्राजन्कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2017154, "chapter_id": 1356, "verse_number": "२-९७-९८", "content_sanskrit": "त्वन्नेत्राः सन्तु ते पुत्रा मा त्वां दीर्णाः प्रहासिषुः।\nतस्मादयं मद्वचनात्त्यज्यतां कुलपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2017155, "chapter_id": 1356, "verse_number": "२-९७-९९", "content_sanskrit": "तथा ते न कृतं राजन्पुत्रस्नेहान्नराधिप।\nतस्य प्राप्तं फलं विद्धि कुलान्तकरणाय यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2017156, "chapter_id": 1356, "verse_number": "२-९७-१००", "content_sanskrit": "शमेन धर्मेण नयेन युक्ता\nया ते बुद्धिः साऽस्तु ते मा प्रमादीः।\nप्रध्वंसिनी क्रूरसमाहिता श्री-\nर्मृदुप्रौढा गच्छति पुत्रपौत्रान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2017157, "chapter_id": 1356, "verse_number": "२-९७-१०१", "content_sanskrit": "अथाब्रवीन्महाराजो गान्धारीं धर्मदर्शिनीम्।\nअन्तः कामं कुलस्यास्तु न शक्नोमि निवारितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2017158, "chapter_id": 1356, "verse_number": "२-९७-१०२", "content_sanskrit": "यथेच्छन्ति तथैवास्तु प्रत्यागच्छन्तु पाण्डवाः।\nपुनर्द्यूतं च कुर्वन्तु मामकाः पाण्डवैः सह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2017159, "chapter_id": 1356, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अनुद्यूतपर्वणि सप्तनवतितमोऽध्यायः॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}]