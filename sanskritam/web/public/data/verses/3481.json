[{"id": 2115280, "chapter_id": 3481, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115281, "chapter_id": 3481, "verse_number": "१", "content_sanskrit": "घटोत्कचो महाकायः पाण्डवान् पृथया सह ।\nअभिवाद्य यथान्यायमब्रवीच्च प्रसाद्य तान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115282, "chapter_id": 3481, "verse_number": "२", "content_sanskrit": "किं करोम्यहमार्याणां निःशङ्कं वदतानघाः ।\nइति ब्रुवन्तं भैमसेनिं कुन्ती वचनमब्रवीत् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115283, "chapter_id": 3481, "verse_number": "३", "content_sanskrit": "त्वं कुरूणां कुले जातः साक्षाद् भीमसुतो ह्यसि ।\nज्येष्ठपुत्रस्तु पञ्चानां साहाय्यं कुरु पुत्रक \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115284, "chapter_id": 3481, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115285, "chapter_id": 3481, "verse_number": "४", "content_sanskrit": "पृथयाप्येवमुक्तस्तु प्रणम्यैवं वचोऽब्रवीत् ।\nयथा हि रावणो लोके इन्द्रजिद् वा महाबलः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115286, "chapter_id": 3481, "verse_number": "५", "content_sanskrit": "तेषां वीर्यसमो वीर्ये विशिष्टश्चाभवं नृषु ।\nकृत्यकाल उपस्थास्ये पितॄनिति घटोत्कचः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115287, "chapter_id": 3481, "verse_number": "६", "content_sanskrit": "आमन्त्र्य राक्षसश्रेष्ठः प्रतस्थे चोत्तरां दिशम् ।\nस हि सृष्टो भगवता शक्तिहेतोर्महात्मना ।\nकर्णस्याप्रतिवीर्यस्य विनाशाय महात्मनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115288, "chapter_id": 3481, "verse_number": "७", "content_sanskrit": "संवाससमयोऽतीतः त्वया कमलमालिके ।\nपुनर्द्रक्ष्यसि राज्यस्थानित्यभाषत तां ततः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115289, "chapter_id": 3481, "verse_number": "", "content_sanskrit": "हिडिम्बा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115290, "chapter_id": 3481, "verse_number": "८", "content_sanskrit": "यदा मे त्वं स्मरेः कान्त रिरंसू रहसि प्रभो ।\nतदा तव वशं भूय आगन्तास्म्याशु भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115291, "chapter_id": 3481, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115292, "chapter_id": 3481, "verse_number": "९", "content_sanskrit": "इत्युक्त्वा सा जगमाऽशु भावमासज्य पाण्डवे ।\nहिडिम्बा समयं स्मृत्वा स्वां गतिं प्रत्यपद्यत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115293, "chapter_id": 3481, "verse_number": "१०", "content_sanskrit": "ततस्ते पाण्डवाः सर्वे शालिहोत्राश्रमे सदा ।\nपूजितास्तेन वन्येन तमामन्त्र्य महामुनिम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115294, "chapter_id": 3481, "verse_number": "११", "content_sanskrit": "जटाः कृत्वाऽऽत्मनः सर्वे वल्कलाजिनवाससः ।\nकुन्त्या सह महात्मानो बिभ्रतस्तापसं वपुः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115295, "chapter_id": 3481, "verse_number": "१२", "content_sanskrit": "ब्राह्मं वेदमधीयाना वेदाङ्गानि च सर्वशः ।\nनीतिशास्त्रं च धर्मज्ञ धर्मज्ञानं च पाण्डवाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115296, "chapter_id": 3481, "verse_number": "१३", "content_sanskrit": "शालिहोत्रप्रसादेन लब्ध्वा प्रीतिमनुत्तमाम् ।\nते वनेन वनं गत्वा घ्नन्तो मृगगणान् बहून् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115297, "chapter_id": 3481, "verse_number": "१४", "content_sanskrit": "अतिक्रम्य ययू राजंस्त्वरमाणा महाबलाः ।\nमत्स्यांस्त्रिगर्तान् पाञ्चालान् कीचकानां वनान्यपि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115298, "chapter_id": 3481, "verse_number": "१५", "content_sanskrit": "रमणीयान् वनोद्देशान् प्रेक्षमाणाः सरांसि च ।\nक्वचिद् वहन्तो जननीं त्वरमाणा महारथाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115299, "chapter_id": 3481, "verse_number": "१६", "content_sanskrit": "क्वचिच्छन्नेन गच्छन्तस्ते जग्मुः पृथया सह ।\nपथि द्वैपायनं सर्वे ददृशुस्तं पितामहम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115300, "chapter_id": 3481, "verse_number": "१७", "content_sanskrit": "अभिप्रणम्य शिरसा पाराशर्यमुपेत्य च ।\nते पादौ जगृहुस्तस्य सह मात्रा परन्तप\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115301, "chapter_id": 3481, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115302, "chapter_id": 3481, "verse_number": "१३", "content_sanskrit": "तदाश्रमान्निर्गमनं मया ज्ञातं परन्तपाः ।\nघटोत्कचस्य चोत्पत्तिं ज्ञात्वा प्रीतिरवर्धत \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115303, "chapter_id": 3481, "verse_number": "१४", "content_sanskrit": "इदं नगरमभ्याशे रमणीयं निरामयम् ।\nवसतेह प्रतिच्छन्ना ममागमनकाङ्क्षिणः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115304, "chapter_id": 3481, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115305, "chapter_id": 3481, "verse_number": "१५", "content_sanskrit": "एवं स तान् समाश्वास्य व्यासः पार्थानरिन्दमान् ।\nएकचक्रामभिगतान् कुन्तीमाश्वासयत् प्रभुः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115306, "chapter_id": 3481, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115307, "chapter_id": 3481, "verse_number": "१६", "content_sanskrit": "कुर्यान्न केवलं धर्मं दुष्कृतं च तथा नरः ।\nसुकृतं दुष्कृतं लोके न कर्ता नापि शोभने\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115308, "chapter_id": 3481, "verse_number": "१७", "content_sanskrit": "अवश्यं लभते कर्ता फलं वै पुण्यपापयोः ।\nदुष्कृतस्य फलेनैवं प्राप्ता व्यसनमुत्तमम् ।\nतस्मान्माधवि मा रोदः मा च शोके मनः कृथाः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115309, "chapter_id": 3481, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115310, "chapter_id": 3481, "verse_number": "१८", "content_sanskrit": "एवमुक्त्वा निवेश्यैतान् ब्राह्मणस्य निवेशने ।\nजगाम भगवान् व्यासो यथाकाममृषिः प्रभुः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115311, "chapter_id": 3481, "verse_number": "१०६", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nषष्ठ्यधिकशततमोऽध्यायः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115312, "chapter_id": 3481, "verse_number": "१", "content_sanskrit": "॥ इति बकवधपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2115313, "chapter_id": 3481, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]