[{"id": 2084478, "chapter_id": 2799, "verse_number": "१२-३०४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084479, "chapter_id": 2799, "verse_number": "१२-३०४-१", "content_sanskrit": "पुनरेव तु पप्रच्छ जनको मिथिलाधिपः।\nपराशरं महात्मानं धर्मे परमनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084480, "chapter_id": 2799, "verse_number": "१२-३०४-२x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084481, "chapter_id": 2799, "verse_number": "१२-३०४-२", "content_sanskrit": "किं श्रेयः का गतिर्ब्रह्मन्किं कृतं न विनश्यति।\nक्व गतो न निवर्तेत तन्मे ब्रूहि महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084482, "chapter_id": 2799, "verse_number": "१२-३०४-३x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084483, "chapter_id": 2799, "verse_number": "१२-३०४-३", "content_sanskrit": "असङ्गः श्रेयसो मूलं ज्ञानं ज्ञानगतिः परा।\nचीर्णं तपो न प्रणश्येद्वापः क्षेत्रे न नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084484, "chapter_id": 2799, "verse_number": "१२-३०४-४", "content_sanskrit": "छित्त्वाऽधर्ममयं पाशं यदा धर्मेऽभिरज्यते।\nदत्त्वाऽभयकृतं दानं तदा सिद्धिमवाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084485, "chapter_id": 2799, "verse_number": "१२-३०४-५", "content_sanskrit": "यो ददाति सहस्राणि गवामश्वशतानि च।\nअभयं सर्वभूतेभ्यः सदा तमभिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084486, "chapter_id": 2799, "verse_number": "१२-३०४-६", "content_sanskrit": "वसन्विषयमध्येऽपि न वसत्येव बुद्धिमान्।\nसंवसत्येव दुर्बुद्धिरसत्सु विषयेष्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084487, "chapter_id": 2799, "verse_number": "१२-३०४-७", "content_sanskrit": "नाधर्मः श्लिष्यते प्राज्ञं पयः पुष्करपर्णवत्।\nअप्राज्ञमधिकं पापं श्लिष्यते जतुकाष्ठवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084488, "chapter_id": 2799, "verse_number": "१२-३०४-८", "content_sanskrit": "नाधर्मः कारणापेक्षी कर्तारमभिमुञ्चति।\nकर्ता खलु यथाकालं ततः समभिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084489, "chapter_id": 2799, "verse_number": "१२-३०४-९", "content_sanskrit": "न भिद्यन्ते कृतात्मान आत्मप्रत्ययदर्शिनः।\nबुद्धिकर्मेन्द्रियाणां हि प्रमत्तो यो न बुध्यते।\nशुभाशुभे प्रसक्तात्मा प्राप्नोति सुमहद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084490, "chapter_id": 2799, "verse_number": "१२-३०४-१०", "content_sanskrit": "वीतरागो जितक्रोधः सम्यग्भवति यः सदा।\nविषये वर्तमानोऽपि न स पापेन युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084491, "chapter_id": 2799, "verse_number": "१२-३०४-११", "content_sanskrit": "मर्यादायां वर्तमानोऽपि नावसीदति।\nपुष्टस्रोत इवासक्तः स्फीतो भवति संचयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084492, "chapter_id": 2799, "verse_number": "१२-३०४-१२", "content_sanskrit": "यथा भानुगतं तेजो मणिः शुद्धः समाधिना।\nआदत्ते राजशार्दूल तथा योगः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084493, "chapter_id": 2799, "verse_number": "१२-३०४-१३", "content_sanskrit": "यथा तिलानामिह पुण्यसंश्रया\nत्पृथक्पृथग्याति गुणोऽतिसाम्यताम्।\nतथा नराणां भुवि भावितात्मनां\nयथाश्रयं सत्वगुणः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084494, "chapter_id": 2799, "verse_number": "१२-३०४-१४", "content_sanskrit": "जहाति दारान्विविधाश्च संपदः\nपदं च यानं विविधाश्च सत्क्रियाः।\nत्रिविष्टपे जातमतिर्यदा नर\nस्तदाऽस्य बुद्धिर्विषयेषु भिद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084495, "chapter_id": 2799, "verse_number": "१२-३०४-१५", "content_sanskrit": "प्रसक्तबुद्धिर्विषयेषु यो नरो\nन बुध्यते ह्यात्महितं कथंचन।\nस सर्वभावानुगतेन चेतसा\nनृपाऽऽमिषेणेव झषो विकृष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084496, "chapter_id": 2799, "verse_number": "१२-३०४-१६", "content_sanskrit": "संघातवन्मर्त्यलोकः परस्परमपाश्रितः।\nकदलीगर्भनिःसारो नौरिवाप्सु निमज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084497, "chapter_id": 2799, "verse_number": "१२-३०४-१७", "content_sanskrit": "न धर्मकालः पुरुषस्य निश्चितो\nन चापि मृत्युः पुरुषं प्रतीक्षते।\nसदा हि धर्मस्य क्रियैव शोभना\nतदा नरो मृत्युमुखान्निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084498, "chapter_id": 2799, "verse_number": "१२-३०४-१८", "content_sanskrit": "यथाऽन्धः स्वगृहे युक्तो ह्यभ्यासादेव गच्छति।\nतथा युक्तेन मनसा प्राज्ञो गच्छति तां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084499, "chapter_id": 2799, "verse_number": "१२-३०४-१९", "content_sanskrit": "मरणं जन्मनि प्रोक्तं जन्म वै मरणाश्रितम्।\nअविद्वान्मोक्षधर्मेषु बद्धो भ्रमति चक्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084500, "chapter_id": 2799, "verse_number": "१२-३०४-२०", "content_sanskrit": "बुद्धिमार्गप्रयातस्य सुखं त्विह परत्र च।\nविस्तराः क्लेशसंयुक्ताः संक्षेपास्तु सुखावहाः।\nपरार्थं विस्तराः सर्वे त्यागमांत्महितं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084501, "chapter_id": 2799, "verse_number": "१२-३०४-२१", "content_sanskrit": "यथा मृणालानुगतमाशु मुञ्चति कर्दमम्।\nतथाऽऽत्मा पुरुषस्येह मनसा परिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084502, "chapter_id": 2799, "verse_number": "१२-३०४-२२", "content_sanskrit": "मनः प्रणयतेऽऽत्मानं स एनमभियुञ्जति।\nयुक्तो यदा स भवति तदा तं पश्यते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084503, "chapter_id": 2799, "verse_number": "१२-३०४-२३", "content_sanskrit": "परार्थे वर्तमानस्तु स्वं कार्यं योऽभिमन्यते।\nइन्द्रियार्थेषु सक्तः स स्वकार्यात्परिहीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084504, "chapter_id": 2799, "verse_number": "१२-३०४-२४", "content_sanskrit": "अधस्तिर्यग्गतिं चैव स्वर्गे चैव परां गतिम्।\nप्राप्नोति सुकृतैरात्मा प्राज्ञस्येहेतरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084505, "chapter_id": 2799, "verse_number": "१२-३०४-२५", "content_sanskrit": "मृन्मये भाजने पक्वे यथा वै नश्यति द्रवः।\nतथा शरीरं तपसा तप्तं विषयमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084506, "chapter_id": 2799, "verse_number": "१२-३०४-२६", "content_sanskrit": "विषयानश्नुते यस्तु न स भोक्ष्यत्यसंशयम्।\nयस्तु भोगांस्त्यजेदात्मा स वै भोक्तुं व्यवस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084507, "chapter_id": 2799, "verse_number": "१२-३०४-२७", "content_sanskrit": "नीहारेण हि संवीतः शिश्नोदरपरायणः।\nजात्यन्ध इव पन्थानमावृतात्मा न बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084508, "chapter_id": 2799, "verse_number": "१२-३०४-२८", "content_sanskrit": "वणिग्यथा समुद्राद्वै यथार्थं लभते धनम्।\nतथा मर्त्यार्णवाज्जन्तोः कर्मविज्ञानतो गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084509, "chapter_id": 2799, "verse_number": "१२-३०४-२९", "content_sanskrit": "अहोरात्रमये लोके जरारूपेण संचरन्।\nमृत्युर्ग्रसति भूतानि पवनं पन्नगो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084510, "chapter_id": 2799, "verse_number": "१२-३०४-३०", "content_sanskrit": "स्वयं कृतानि कर्माणि जातो जन्तुः प्रपद्यते।\nनाकृतं लभते कश्चित्किंचिदत्र प्रियाप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084511, "chapter_id": 2799, "verse_number": "१२-३०४-३१", "content_sanskrit": "सयानं यान्तमासीनं प्रवृत्तं विषयेषु च।\nशुभाशुभानि कर्माणि प्रपद्यन्ते नरं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084512, "chapter_id": 2799, "verse_number": "१२-३०४-३२", "content_sanskrit": "न ह्यन्यत्तीरमासाद्य पुनस्तर्तुं व्यवस्यति।\nदुर्लभो दृश्यते ह्यस्य विनिपातो महार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084513, "chapter_id": 2799, "verse_number": "१२-३०४-३३", "content_sanskrit": "यथा भावावसन्ना हि नौर्महाम्भसि तन्तुना।\nयथा मनोभियोगाद्वै शरीरं प्रचिकीर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084514, "chapter_id": 2799, "verse_number": "१२-३०४-३४", "content_sanskrit": "यथा समुद्रमभितः संश्रिताः सरितोऽपराः।\nतथाऽन्याप्रकृतिर्योगादभिसंश्रियते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084515, "chapter_id": 2799, "verse_number": "१२-३०४-३५", "content_sanskrit": "स्नेहपाशैर्बहुविधैरासक्तमनसो नराः।\nप्रकृतिस्था विषीदन्ति जले सैकतवेश्मवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084516, "chapter_id": 2799, "verse_number": "१२-३०४-३६", "content_sanskrit": "शरीरगृहसंस्थस्य शौचतीर्थस्य देहिनः।\nबुद्धिमार्गप्रयातस्य सुखं त्विह परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084517, "chapter_id": 2799, "verse_number": "१२-३०४-३७", "content_sanskrit": "विस्तराः क्लेशसंयुक्ताः संक्षेपास्तु सुखावहाः।\nपरार्थं विस्तराः सर्वे त्यागमात्महितं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084518, "chapter_id": 2799, "verse_number": "१२-३०४-३८", "content_sanskrit": "संकल्पजो मित्रवर्गो ज्ञातयः कारणात्मकाः।\nभार्या पुत्रश्च दासश्च स्वमर्थमनुयुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084519, "chapter_id": 2799, "verse_number": "१२-३०४-३९", "content_sanskrit": "न माता न पिता किंचित्कस्यचित्प्रतिपद्यते।\nदानपथ्यौदनो जन्तु स्वकर्मफलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084520, "chapter_id": 2799, "verse_number": "१२-३०४-४०", "content_sanskrit": "माता पुत्रः पिता भ्राता भार्या मित्रजनस्तथा।\nअष्टापदपदस्थाने लाक्षामुद्रेव लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084521, "chapter_id": 2799, "verse_number": "१२-३०४-४१", "content_sanskrit": "सर्वाणि कर्माणि पुराकृतानि\nशुभाशुभान्यात्मनो यान्ति जन्तोः।\nउपस्थितं कर्मफलं विदित्वा\nबुद्धिं तथा चोदयतेऽन्तरात्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084522, "chapter_id": 2799, "verse_number": "१२-३०४-४२", "content_sanskrit": "व्यवसायं समाश्रित्य सहायान्योऽधिगच्छति।\nन तस्य कश्चिदारम्भः कदाचिदवसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2084523, "chapter_id": 2799, "verse_number": "१२-३०४-४३", "content_sanskrit": "अद्वैधमनसं युक्तं शूरं धीरं विपश्चितम्।\nन श्रीः संत्यजते नित्यमादित्यमिव रश्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2084524, "chapter_id": 2799, "verse_number": "१२-३०४-४४", "content_sanskrit": "आस्तिक्यव्यवसायाभ्यामुपायान्वितया धिया।\nय आरभत्यनिन्द्यात्मा न सोऽर्थात्परिसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2084525, "chapter_id": 2799, "verse_number": "१२-३०४-४५", "content_sanskrit": "सर्वःस्वानि शुभाशुभानि नियतं कर्माणि जन्तुःस्वयं\nगर्भात्संप्रतिपद्यते तदुभयं यत्तेन पूर्वं कृतम्।\nमृत्युश्चापरिहारवान्समगतिः कालेन विच्छेदिना\nदारोश्चूर्णमिवाश्मसारविहितं कर्मान्तिकं प्रापयेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2084526, "chapter_id": 2799, "verse_number": "१२-३०४-४६", "content_sanskrit": "स्वरूपतामात्मकृतं च विस्तरं\nकुलान्वयं द्रव्यसमृद्धिसंचयम्।\nनरो हि सर्वो भलते यथाकृतं\nशुभाशुभेनात्मकृतेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2084527, "chapter_id": 2799, "verse_number": "१२-३०४-४७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2084528, "chapter_id": 2799, "verse_number": "१२-३०४-४७", "content_sanskrit": "इत्युक्तो जनको राजन्याथातथ्यं मनीषिणा।\nश्रुत्वा धर्मविदां श्रेष्ठः परां मुदमवाप ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2084529, "chapter_id": 2799, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुरधिकत्रिशततमोऽध्यायः॥ ३०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]