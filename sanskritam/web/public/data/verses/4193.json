[{"id": 2147609, "chapter_id": 4193, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147610, "chapter_id": 4193, "verse_number": "१", "content_sanskrit": "ततः शान्तनवो भीष्मो दुर्योधनमरिन्दमम् ।\nकेशवस्य वचः श्रुत्वा प्रोवाच भरतर्षभ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147611, "chapter_id": 4193, "verse_number": "२", "content_sanskrit": "कृष्णेन वाक्यमुक्तोऽसि सुहृदां शममिच्छता ।\nअन्वपद्यस्व तत् तात मा मन्युवशमन्वगाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147612, "chapter_id": 4193, "verse_number": "३", "content_sanskrit": "अकृत्वा वचनं तस्य केशवस्य महात्मनः ।\nश्रेयो न जातु न सुखं न कल्याणमवाप्स्यसि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147613, "chapter_id": 4193, "verse_number": "४", "content_sanskrit": "धर्म्यमर्थ्यं महाबाहुराह त्वां तात केशवः ।\nतमर्थमभिपद्यस्व मा राजन् नीनशः प्रजाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147614, "chapter_id": 4193, "verse_number": "५", "content_sanskrit": "ज्वलितां त्वमिमां लक्ष्मीं भारतीं सर्वराजसु ।\nजीवतो धृतराष्ट्रस्य दौरात्म्याद् भ्रंशयिष्यसि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147615, "chapter_id": 4193, "verse_number": "६", "content_sanskrit": "आत्मानं च सहामात्यं सपुत्रभ्रातृबान्धवम् ।\nअहमित्यनया बुद्ध्या जीविताद् भ्रंशयिष्यसि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147616, "chapter_id": 4193, "verse_number": "७", "content_sanskrit": "अतिक्रामन् केशवस्य तथ्यं वचनमर्थवत् ।\nपितुश्च भरतश्रेष्ठ विदुरस्य च धीमतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147617, "chapter_id": 4193, "verse_number": "८", "content_sanskrit": "मा कुलघ्नः कुपुरुषो दुर्मतिः कापथं गमः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147618, "chapter_id": 4193, "verse_number": "९", "content_sanskrit": "मातरं पितरं चैव वृद्धौ शोकाय मा ददाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147619, "chapter_id": 4193, "verse_number": "१०", "content_sanskrit": "अथ द्रोणोऽब्रवीत् तत्र दुर्योधनमिदं वचः ।\nअमर्षवशमापन्नं निःश्वसन्तं पुनः पुनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147620, "chapter_id": 4193, "verse_number": "११", "content_sanskrit": "धमार्थयुक्तं वचनमाह त्वां तात केशवः ।\nतथा भीष्मः शान्तनवः तज्जुषस्व नराधिप\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147621, "chapter_id": 4193, "verse_number": "१२", "content_sanskrit": "प्राज्ञौ मेधाविनौ दान्तावर्थकामौ बहुश्रुतौ ।\nआहतुस्त्वां हितं वाक्यं तदादत्स्व नराधिप\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147622, "chapter_id": 4193, "verse_number": "१३", "content_sanskrit": "अनुतिष्ठ महाप्राज्ञ कृष्णभीष्मौ यदूचतुः ।\nमा वचो लघुबुद्धीनां समास्थास्त्वं परन्तप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147623, "chapter_id": 4193, "verse_number": "१४", "content_sanskrit": "माधवं बुद्धिमोहेन माऽवमंस्थाः परन्तप ।\nये त्वां प्रोत्साहयन्त्येते नैते कृत्याय कर्हिचित्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147624, "chapter_id": 4193, "verse_number": "१५", "content_sanskrit": "वैरं परेषां ग्रीवायां प्रतिमोक्ष्यन्ति संयुगे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147625, "chapter_id": 4193, "verse_number": "१६", "content_sanskrit": "मा नीनशः प्रजाः सर्वाः पुत्रान् भ्रातॄंस्तथैव च ।\nवासुदेवार्जुनौ यत्र विद्ध्यजेयं बलं हि तत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147626, "chapter_id": 4193, "verse_number": "१७", "content_sanskrit": "एतच्चैव मतं सत्यं सुहृदोः कृष्णभीष्मयोः ।\nयदि नादास्यते तात पश्चात् तप्स्यसि भारत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147627, "chapter_id": 4193, "verse_number": "१८", "content_sanskrit": "यथोक्तं जामदग्न्येन भूयानेष ततोऽर्जुनः ।\nकृष्णो हि देवकीपुत्रो देवैरपि सुदुःसहः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147628, "chapter_id": 4193, "verse_number": "१९", "content_sanskrit": "किं ते मुखप्रियेणेह प्रोक्तेन भरतर्षभ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147629, "chapter_id": 4193, "verse_number": "२०", "content_sanskrit": "एतत् ते सर्वमाख्यातं यथेच्छसि तथा कुरु ।\nन हि त्वामुत्सहे वक्तुं भूयो भरतसत्तम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147630, "chapter_id": 4193, "verse_number": "२१", "content_sanskrit": "तस्मिन् वाक्यान्तरे वाक्यं क्षत्ताऽपि विदुरोऽब्रवीत् ।\nदुर्योधनमभिप्रेक्ष्य धार्तराष्ट्रममर्षणम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147631, "chapter_id": 4193, "verse_number": "२२", "content_sanskrit": "दुर्योधन न शोचामि त्वामहं भरतर्षभ ।\nइमौ तु वृद्धौ शोचामि गान्धारीं पितरं च ते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147632, "chapter_id": 4193, "verse_number": "२३", "content_sanskrit": "यावनाथौ भविष्येते त्वया नाथेन दुर्हृदा ।\nहतमित्रौ हतामात्यौ लूनपक्षविवाण्डजौ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147633, "chapter_id": 4193, "verse_number": "२४", "content_sanskrit": "भिक्षुकौ विचरिष्येते शोचन्तौ पृथिवीमिमाम् ।\nकुलघ्नमीदृशं पापं जनयित्वा कुपूरुषम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147634, "chapter_id": 4193, "verse_number": "२५", "content_sanskrit": "अथ दुर्योधनं राजा धृतराष्ट्रोऽभ्यभाषत ।\nआसीनं भ्रातृभिः सार्धं राजभिः परिवारितम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147635, "chapter_id": 4193, "verse_number": "२६", "content_sanskrit": "दुर्योधन निबोधेदं शौरिणोक्तं महात्मना ।\nआदत्स्व शिवमत्यन्तं योगक्षेमवदव्ययम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147636, "chapter_id": 4193, "verse_number": "२७", "content_sanskrit": "अनेन हि सहायेन कृष्णेनाक्लिष्टकर्मणा ।\nइष्टान् सर्वानभिप्रायान् प्राप्स्यामः सर्वराजसु\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147637, "chapter_id": 4193, "verse_number": "२८", "content_sanskrit": "सुसंहितः केशवेन तात गच्छ युधिष्ठिरम् ।\nचर स्वस्त्ययनं कृत्स्नं भरतानामनामयम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147638, "chapter_id": 4193, "verse_number": "२९", "content_sanskrit": "वासुदेवेन तीर्थेन तात गच्छस्व सङ्गतिम् ।\nकालप्राप्तमिदं मन्ये मा त्वं दुर्योधनातिगाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147639, "chapter_id": 4193, "verse_number": "३०", "content_sanskrit": "शमं चेद्याचमानं त्वं नाख्यास्यसि केशवम् ।\nत्वदर्थमभिजल्पन्तं न तवास्त्यपराभवः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2147640, "chapter_id": 4193, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुर्विंशोत्तरशततमोऽध्यायः ॥१२४॥\nभगवद्यानपर्वणि पञ्चपञ्चाशोऽध्यायः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]