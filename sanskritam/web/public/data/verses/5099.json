[{"id": 2192637, "chapter_id": 5099, "verse_number": "", "content_sanskrit": "याज्ञवल्क्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2192638, "chapter_id": 5099, "verse_number": "१", "content_sanskrit": "साङ्ख्यज्ञानं मया प्रोक्तं योगज्ञानं निबोध मे ।\nयथाश्रुतंयथादृष्टं तत्त्वेन नृपसत्तम॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2192639, "chapter_id": 5099, "verse_number": "२", "content_sanskrit": "नास्ति साङ्ख्यसमं ज्ञानं नास्ति योगसमं बलम् ।\nतावुभावेकचर्यौतु उभावनिधनौ स्मृतौ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2192640, "chapter_id": 5099, "verse_number": "३", "content_sanskrit": "पृथक्पृथक्तु पश्यन्ति येऽल्पबुद्धिरता नराः ।\nवयं तु राजन् पश्याम एकमेव तु निश्चयात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2192641, "chapter_id": 5099, "verse_number": "४", "content_sanskrit": "यदेवयोगाः पश्यन्ति तत् साङ्ख्यैरपि दृश्यते ।\nएकं साङ्ख्यं च योगं च यः पश्यति स तत्त्ववित्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2192642, "chapter_id": 5099, "verse_number": "५", "content_sanskrit": "रुद्रप्रधानानपरान् विद्धि योगान् परन्तप।\nतेनैव चाथ देहेन विचरन्ति दिशो दश\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2192643, "chapter_id": 5099, "verse_number": "६", "content_sanskrit": "यावद्धि प्रलयस्तातसूक्ष्मेणाष्टगुणेन वै ।\nयोगेन लोकान् विचरन् सुखं सन्न्यस्य चानघ\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2192644, "chapter_id": 5099, "verse_number": "७", "content_sanskrit": "वेदेषुचाष्टगुणितं योगमाहुर्मनीषिणः ।\nसूक्ष्मेणाष्टगुणेनैव नेतरं नृपसत्तम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2192645, "chapter_id": 5099, "verse_number": "८", "content_sanskrit": "द्विगुणं योगकृत्यं तु योगानांप्राहुरुत्तमम् ।\nसगुणं निर्गुणं चैव यथाशास्त्रनिदर्शनम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2192646, "chapter_id": 5099, "verse_number": "९", "content_sanskrit": "धारणा चैव मनसः प्राणायामश्च पार्थिव ।\nप्राणायामो हि सगुणो निर्गुणं धारणं मनः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2192647, "chapter_id": 5099, "verse_number": "१०", "content_sanskrit": "यत्र दृश्येत मुञ्चन् वैप्राणान्मैथिलसत्तम ।\nवाताधिक्यं भवत्येव तस्माद्धि न समाचरेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2192648, "chapter_id": 5099, "verse_number": "११", "content_sanskrit": "निशायाः प्रथमे यामे चोदनाद्वादश स्मृताः ।\nमध्ये सुप्त्वा परे यामे द्वादशैव तु चोदनाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2192649, "chapter_id": 5099, "verse_number": "१२", "content_sanskrit": "तदेवमुपशान्तेन दान्तेनैकान्तशीलिना।\nआत्मारामेण बुद्धेन योक्तव्योऽऽत्मान संशयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2192650, "chapter_id": 5099, "verse_number": "१३", "content_sanskrit": "पञ्चानामिन्द्रियाणां तु दोषानाक्षिप्य पञ्चधा।\nशब्दं स्पर्शं तथा रूपं रसं गन्धं तथैव च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2192651, "chapter_id": 5099, "verse_number": "१४", "content_sanskrit": "प्रतिभामपवर्गंच प्रतिसंहृत्य मैथिल ।\nइन्द्रियग्राममखिलं मनस्यभिनिवेश्य ह\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2192652, "chapter_id": 5099, "verse_number": "१५", "content_sanskrit": "मनस्तथैवाहङ्कारे प्रतिष्ठाप्य नराधिप ।\nअहङ्कारं तथा बुद्धौ बुद्धिं च प्रकृतावपि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2192653, "chapter_id": 5099, "verse_number": "१६", "content_sanskrit": "एवं हि परिसङ्ख्याय ततो ध्यायेतकेवलम् ।\nविरजस्कमलं नित्यमनन्तं शुद्धमव्रणम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2192654, "chapter_id": 5099, "verse_number": "१७", "content_sanskrit": "तस्थुषं पुरुषं सत्त्वमभेद्यमजरामरम् ।\nशाश्वतं चाव्ययं चैवईशानं ब्रह्म चाव्ययम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2192655, "chapter_id": 5099, "verse_number": "१८", "content_sanskrit": "युक्तस्य तु महाराज लक्षणान्युपधारयेत् ।\nलक्षणं तु प्रसादस्य यथा तृप्तः सुखं स्वपेत्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2192656, "chapter_id": 5099, "verse_number": "१९", "content_sanskrit": "निवाते तु यथा दीपो ज्वलेत् स्नेहसमन्वितः ।\nनिश्चलोर्ध्वशिखस्तद्वद्युक्तमाहुर्मनीषिणः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2192657, "chapter_id": 5099, "verse_number": "२०", "content_sanskrit": "पाषाण इव मेघोत्थैर्यथा बिन्दुभिराहतः ।\nनालं चालयितुं शक्यस्तथायुक्तस्य लक्षणम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2192658, "chapter_id": 5099, "verse_number": "२१", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्विविधैर्गीतवादितैः ।\nक्रियमाणैर्न कम्पेत युक्तस्यैतन्निदर्शनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2192659, "chapter_id": 5099, "verse_number": "२२", "content_sanskrit": "तैलपात्रं यथा पूर्णं कराभ्यां गृह्य पूरुषः ।\nसोपानमारुहेद्भीतस्तर्ज्यमानोऽसिपाणिभिः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2192660, "chapter_id": 5099, "verse_number": "२३", "content_sanskrit": "संयतात्माभयात् तेषां न पात्रादि बन्दुमुत्सृजेत् ।\nतथैवोत्तरमाणस्य एकाग्रमनसस्तथा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2192661, "chapter_id": 5099, "verse_number": "२४", "content_sanskrit": "स्थिरत्वादिन्द्रियाणां तु निश्चलत्वात्तथैव च ।\nएवं युक्तस्य तु मुनेर्लक्षणान्युपधारयेत्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2192662, "chapter_id": 5099, "verse_number": "२५", "content_sanskrit": "स युक्तः पश्यति ब्रह्म यत्तत् परममव्ययम् ।\nमहतस्तमसो मध्ये स्थितं ज्वलनसन्निभम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2192663, "chapter_id": 5099, "verse_number": "२६", "content_sanskrit": "एतेन केवलं याति त्यक्त्वादेहमसाक्षिकम् ।\nकालेन महता राजन् श्रुतिरेषा सनातनी\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2192664, "chapter_id": 5099, "verse_number": "२७", "content_sanskrit": "एतद्धि योगंयोगानां किमन्यद् योगलक्षणम् ।\nविज्ञाय तद्धि मन्यन्ते कृतकृत्या मनीषिणः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2192665, "chapter_id": 5099, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे अष्टचत्वारिंशोत्तरशततमोऽध्यायः ॥१४८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]