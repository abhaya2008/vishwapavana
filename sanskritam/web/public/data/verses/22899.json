[{"id": 7002899000, "chapter_id": 22899, "verse_number": "९-१८४-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nशय्यादानं प्रवक्ष्यामि तव पांडुकुलोद्वह ।\nयद्दत्त्वा सुखभागी स्यादिह लोके परत्र च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002899001, "chapter_id": 22899, "verse_number": "९-१८४-२", "content_sanskrit": "शय्यादानं प्रयच्छंति सर्वदैव द्विजोत्तमाः ।\nअनित्यं जीवितं यस्मात्कोन्यः पश्चात्प्रदास्यति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002899002, "chapter_id": 22899, "verse_number": "९-१८४-३", "content_sanskrit": "तावत्स बंधुः स पिता यावज्जीवति भारत ।\nमृतो मृत इति ज्ञात्वा क्षणात्स्नेहो निवर्तते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002899003, "chapter_id": 22899, "verse_number": "९-१८४-४", "content_sanskrit": "तस्मात्स्वयं प्रदातव्यं शय्याभोज्यजलादिकम् ।\nआत्मैव ह्यात्मनो बन्धुरिति संचिंत्य चेतसि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002899004, "chapter_id": 22899, "verse_number": "९-१८४-५", "content_sanskrit": "आत्मैव यो हि नात्मानं दानभोगैः समर्चयेत् ।\nकोऽन्यो हिततरस्तस्मात्कः पश्चात्पूजयिष्यति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002899005, "chapter_id": 22899, "verse_number": "९-१८४-६", "content_sanskrit": "तस्माच्छय्यां समासाद्य सारदारुमयीं दृढाम् ।\nदंतपत्रचितां रम्यां हिमपट्टैरलंकृताम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002899006, "chapter_id": 22899, "verse_number": "९-१८४-७", "content_sanskrit": "हंसतूलीप्रतिच्छन्नां सुभगां सोपधानिकाम् ।\nप्रच्छादनपटीयुक्तां गंधधूपाधिवासिताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002899007, "chapter_id": 22899, "verse_number": "९-१८४-८", "content_sanskrit": "तस्यां संस्थापयेद्धैमं हरिं लक्ष्मीसमन्वितम् ।\nउच्छीर्षके धृतं चैव कलशं परिकल्पयेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002899008, "chapter_id": 22899, "verse_number": "९-१८४-९", "content_sanskrit": "विज्ञेयं पांडव सदा सनिद्राकल्पकं बुधैः ।\nतांबूलं कुंकुमक्षोदकर्पूरागरु चंदनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002899009, "chapter_id": 22899, "verse_number": "९-१८४-१०", "content_sanskrit": "दीपकोपानहच्छत्रचामरासनभोजनम् ।\nपार्श्वेषु स्थापयेच्छक्त्या सप्तधान्यानि चैव हि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002899010, "chapter_id": 22899, "verse_number": "९-१८४-११", "content_sanskrit": "शयनस्थस्य भवति यदन्यदुपकारकम् ।\nभृंगारकाद्यपुष्पाणि पंचवर्णवितानकम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002899011, "chapter_id": 22899, "verse_number": "९-१८४-१२", "content_sanskrit": "शय्यामेवंविधां कृत्वा ब्राह्मणायोपदापयेत् ।\nसपत्नीकाय संपूज्य पुण्येऽह्नि विधिपूर्वकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002899012, "chapter_id": 22899, "verse_number": "९-१८४-१३", "content_sanskrit": "नमस्ते सर्वदेवेश शय्यादानं कृतं मया ।\nदेहि तस्माच्छांतिफलं नमस्ते पुरुषोत्तम ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002899013, "chapter_id": 22899, "verse_number": "९-१८४-१४", "content_sanskrit": "यथा न कृष्ण शयनं शून्यं सागरजातया ।\nशय्या ममाप्यशून्यास्तु तथा जन्मनिजन्मनि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002899014, "chapter_id": 22899, "verse_number": "९-१८४-१५", "content_sanskrit": "दत्त्वैवं तल्पममलं प्रणिपत्य विसर्जयेत् ।\nएकादशाहेऽपि तथा विधिरेष प्रकीर्तितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002899015, "chapter_id": 22899, "verse_number": "९-१८४-१६", "content_sanskrit": "ददाति यदि धर्मार्थं मानवो बांधवे मृते ।\nविशेषं चात्र राजेंद्र कथ्यमानं निबोध मे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002899016, "chapter_id": 22899, "verse_number": "९-१८४-१७", "content_sanskrit": "तेनोपभुक्तं यद्वस्तु किंचित्पूर्वं गृहे सता ।\nतद्गात्रलग्नं च तथा वस्त्रवाहनभाजनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002899017, "chapter_id": 22899, "verse_number": "९-१८४-१८", "content_sanskrit": "यदिष्टं च तथास्यासीत्तत्सर्वं परिकल्पयेत् ।\nस एव पुरुषो हैमस्तस्यांतं स्थापयेत्तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002899018, "chapter_id": 22899, "verse_number": "९-१८४-१९", "content_sanskrit": "पूजयित्वा प्रदातव्यो मृतशय्या यथोदिता ।\nस्वर्गे पुरंदरगृहे सूर्यपुत्रालयेथ वा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002899019, "chapter_id": 22899, "verse_number": "९-१८४-२०", "content_sanskrit": "सुखं वसत्यसौ जंतुः शय्यादानप्रभावतः ।\nपीडयंति न तं याम्याः पुरुषा भीषणाननाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002899020, "chapter_id": 22899, "verse_number": "९-१८४-२१", "content_sanskrit": "न धर्मेण न शीतेन बाध्यते स नरः क्वचित् ।\nअपि पापसमायुक्तः स्वर्गलोके महीयते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002899021, "chapter_id": 22899, "verse_number": "९-१८४-२२", "content_sanskrit": "विमानवरमारूढः सेव्यमानोप्सरोगणैः ।\nआभूतसंप्लवं यावत्तिष्ठेत्पातकवर्जितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002899022, "chapter_id": 22899, "verse_number": "९-१८४-२३", "content_sanskrit": "शय्याप्रदानममलं तव पांडुपुत्रसंकीर्तितं सकलसौख्यानिधानमेतत् ।\nतयो ददाति विधिवत्स्वयमेव नाके तल्पे विकल्परहितः स विभाति सत्यम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]