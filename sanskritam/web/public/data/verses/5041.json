[{"id": 2189996, "chapter_id": 5041, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2189997, "chapter_id": 5041, "verse_number": "१", "content_sanskrit": "भूतानां गुणसङ्ख्यानं भूयः पुत्र निशामय ।\nद्वैपायनमुखाद् भ्रष्टं श्लाघया परयानघ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2189998, "chapter_id": 5041, "verse_number": "२", "content_sanskrit": "दीप्तानलनिभः प्राह भगवान् धूम्रवर्चसे ।\nततोऽहमपि वक्ष्यामि भूयः पुत्र निदर्शनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2189999, "chapter_id": 5041, "verse_number": "३", "content_sanskrit": "भूमेः स्थैर्यं पृथुत्वं च काठिन्यं प्रसवात्मता ।\nगन्धो गुरुत्वं शक्तिश्च सङ्घातः स्थापना धृतिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190000, "chapter_id": 5041, "verse_number": "४", "content_sanskrit": "अपां शैत्यं रसः क्लेदो द्रवत्वं स्नेहसौम्यता ।\nजिह्वानिष्पन्दनं भूमा भौमाप्यास्रवणं तथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190001, "chapter_id": 5041, "verse_number": "५", "content_sanskrit": "अग्नेर्दुर्धर्षता तेजस्तापः पाकः प्रकाशनम् ।\nशौचं रागो लघुस्तैक्ष्ण्यं दशमं चोर्ध्वभागिता\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190002, "chapter_id": 5041, "verse_number": "६", "content_sanskrit": "वायोरनियमः स्पर्शो वादस्थानं स्वतन्त्रता ।\nबलं शैघ्र्यं च मोहश्च चेष्टा कर्मकृता भवः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190003, "chapter_id": 5041, "verse_number": "७", "content_sanskrit": "आकाशस्य गुणः शब्दो व्यापित्वं छिद्रतापि च ।\nअनाश्रयमनालम्बमव्यक्तमविकारिता\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190004, "chapter_id": 5041, "verse_number": "८", "content_sanskrit": "अप्रतीघातता चैव भूतत्वं विकृतानि च ।\nगुणाः पञ्चाशतं प्रोक्ताः पञ्चभूतात्मभाविताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190005, "chapter_id": 5041, "verse_number": "९", "content_sanskrit": "चलोपपत्तिर्व्यक्तिश्च विसर्गः कल्पना क्षमा ।\nसदसच्चाशुता चैव मनसो नव वै गुणाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190006, "chapter_id": 5041, "verse_number": "१०", "content_sanskrit": "इष्टानिष्टविकल्पश्च व्यवसायः समाधिता ।\nसंशयः प्रतिपत्तिश्च बुद्धौ पञ्चेह ये गुणाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190007, "chapter_id": 5041, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190008, "chapter_id": 5041, "verse_number": "११", "content_sanskrit": "कथं पञ्चगुणा बुद्धिः कथं पञ्चेन्द्रिया गुणाः ।\nएतन्मे सर्वमाचक्ष्व सूक्ष्मज्ञानं पितामह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190009, "chapter_id": 5041, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190010, "chapter_id": 5041, "verse_number": "१२", "content_sanskrit": "आहुः षष्टिं भूतगुणान् वै\nभूतविशिष्टा नित्यविषक्ताः ।\nभूतविषक्ताश्चाक्षरसृष्टाः\nपुत्र न नित्यं तदिह वदन्ति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190011, "chapter_id": 5041, "verse_number": "१३", "content_sanskrit": "तत्पुत्र चिन्ताकलितं यदुक्त-\nमनागतं वै तव सम्प्रतीह ।\nभूतार्थतत्त्वं तदवाप्य सर्वं\nभूतप्रभावाद् भव शान्तबुद्धिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190012, "chapter_id": 5041, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे गुणभूतकथनं नाम नवतितमोऽध्यायः ॥९०॥\n॥ शुकानुप्रश्नः समाप्तः ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]