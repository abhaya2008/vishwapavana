[{"id": 7000583000, "chapter_id": 20583, "verse_number": "५-४२-१", "content_sanskrit": "शेष उवाच ।\nआह्वयंतं महासैन्यवारिधौ पुष्कलं नृपम् ।\nसमालक्ष्य कपींद्रोऽपि हनूमांस्तमधावत॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000583001, "chapter_id": 20583, "verse_number": "५-४२-२", "content_sanskrit": "लांगूलमुद्यम्य विशालदेहं ।\nसरावमातत्य पयोदघोषम् ।\nरणस्थितान्वीरवरान्कपींद्रो ।\nजगाम तं वीरमणिं नृपेन्द्रम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000583002, "chapter_id": 20583, "verse_number": "५-४२-३", "content_sanskrit": "आयांतं तं हनूमंतं वीक्ष्य पुष्कल उद्भटः ।\nविलोकयामासदृशा वैरिक्रोध सुशोणया॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000583003, "chapter_id": 20583, "verse_number": "५-४२-४", "content_sanskrit": "जगाद तं हनूमंतं पुष्कलः परमास्त्रवित् ।\nमेघगंभीरया वाचा नादयन्रणमंडलम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000583004, "chapter_id": 20583, "verse_number": "५-४२-५", "content_sanskrit": "पुष्कल उवाच ।\nकथं त्वं समरे योद्धुमागतोसि महाकपे ।\nकियद्बलं स्वल्पमेतद्राज्ञो वीरमणेर्महत्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000583005, "chapter_id": 20583, "verse_number": "५-४२-६", "content_sanskrit": "यत्र त्रिजगती सर्वा संमुखे समुपागता ।\nतत्र त्वं लीलया योद्धुं यातुमिच्छसि वा न वा॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000583006, "chapter_id": 20583, "verse_number": "५-४२-७", "content_sanskrit": "कोयं राजा वीरमणिः कियद्बलमथाल्पकम् ।\nअत्रागमनमत्युग्रं तव वीर न भाव्यते॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000583007, "chapter_id": 20583, "verse_number": "५-४२-८", "content_sanskrit": "रघुनाथकृपापांगादहं निस्तीर्य दुस्तरम् ।\nक्षणान्निर्यामि कीशेंद्र मा चित्तं कुरु संगरे॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000583008, "chapter_id": 20583, "verse_number": "५-४२-९", "content_sanskrit": "त्वया राक्षसपाथोधिस्तीर्णो रामकृपाव्रजात् ।\nतथा रामं सुसंस्मृत्य निस्तरिष्यामि दुस्तरम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000583009, "chapter_id": 20583, "verse_number": "५-४२-१०", "content_sanskrit": "ये केचिद्दुस्तरं प्राप्य रघुनाथं स्मरंति च ।\nतेषां दुःखोदधिः शुष्को भविष्यति न संशयः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000583010, "chapter_id": 20583, "verse_number": "५-४२-११", "content_sanskrit": "तस्माद्व्रज महावीर शत्रुघ्नसविधे बलिन् ।\nएष आयामि निर्जित्य भूपं वीरमणिं क्षणात्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000583011, "chapter_id": 20583, "verse_number": "५-४२-१२", "content_sanskrit": "शेष उवाच ।\nइति धीरां समाकर्ण्य वाणीं पुष्कलभाषिताम् ।\nजगाद वचनं भूयः पुष्कलं परवीरहा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000583012, "chapter_id": 20583, "verse_number": "५-४२-१३", "content_sanskrit": "हनुमानुवाच ।\nपुत्र मा साहसं कार्षीर्भूपं वीरमणिं प्रति ।\nएष दाता शरण्यश्च बलशौर्यसमन्वितः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000583013, "chapter_id": 20583, "verse_number": "५-४२-१४", "content_sanskrit": "त्वं बालः स्थविरो भूपोऽखिलशस्त्रास्त्रवित्तमः ।\nअनेके विजिताः संख्ये वीराः शौर्यसुशोभिनः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000583014, "chapter_id": 20583, "verse_number": "५-४२-१५", "content_sanskrit": "जानीहि पार्श्वे तस्य त्वं रक्षितारं सदाशिवम् ।\nभक्त्या वशीकृतं स्थाणुं सोमं चैतत्पुरिस्थितम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000583015, "chapter_id": 20583, "verse_number": "५-४२-१६", "content_sanskrit": "तस्मादहमनेनैव योत्स्ये भूपेन पुष्कल ।\nअन्यान्वीरान्विजित्वा त्वं कीर्तिमाप्नुहि पुष्कलाम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000583016, "chapter_id": 20583, "verse_number": "५-४२-१७", "content_sanskrit": "पुष्कल उवाच ।\nशिवो भक्त्या वशीकृत्य स्वपुरे स्थापितोऽमुना ।\nपरमस्याशु हृदयेन तिष्ठति महेश्वरः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000583017, "chapter_id": 20583, "verse_number": "५-४२-१८", "content_sanskrit": "सदाशिवोयमाराध्य परमं स्थानमागतः ।\nस रामो मन्मनस्त्यक्त्वा न क्वापि परिगच्छति॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000583018, "chapter_id": 20583, "verse_number": "५-४२-१९", "content_sanskrit": "यत्र रामस्तत्र विश्वं सर्वं स्थास्नु चरिष्णु च ।\nतस्मादहं जयिष्यामि रणे वीरमणिं नृपम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000583019, "chapter_id": 20583, "verse_number": "५-४२-२०", "content_sanskrit": "व्रज त्वं समरे योद्धुमन्यान्मानिवरान्नृपान् ।\nवीरसिंहमुखान्कीश मच्चिंतां मा कुरु प्रभो॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000583020, "chapter_id": 20583, "verse_number": "५-४२-२१", "content_sanskrit": "वाचमित्थं समाकर्ण्य हनूमान्धीरसेविताम् ।\nजगाम समरे योद्धुं वीरसिंहं नृपानुजम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000583021, "chapter_id": 20583, "verse_number": "५-४२-२२", "content_sanskrit": "लक्ष्मीनिधिः सुतेनास्य शुभांगदसुसंज्ञिना ।\nद्वैरथेन प्रयुयुधे महाशस्त्रास्त्रवेदिना॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000583022, "chapter_id": 20583, "verse_number": "५-४२-२३", "content_sanskrit": "बलमित्रेण सुमदः स्वप्रतापबलोर्जितः ।\nयोद्धुं सशस्त्रः संग्रामं विचचार नृपात्मजः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000583023, "chapter_id": 20583, "verse_number": "५-४२-२४", "content_sanskrit": "आह्वयंतं नृपं दृष्ट्वा द्वैरथे युद्धकोविदः ।\nपुष्कलो रुक्मखचिते रथे तिष्ठन्ययौ हि तम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000583024, "chapter_id": 20583, "verse_number": "५-४२-२५", "content_sanskrit": "राजा तमागतं दृष्ट्वा पुष्कलं युद्धकोविदम् ।\nउवाच निर्भिया वाण्या रणमध्ये सुभाषितः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000583025, "chapter_id": 20583, "verse_number": "५-४२-२६", "content_sanskrit": "वीरमणिरुवाच ।\nबालमायाहि मां क्रुद्धं संग्रामे चंडकोपनम् ।\nगच्छ प्राणपरीप्सायै मा युद्धं कुरु मे सह॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000583026, "chapter_id": 20583, "verse_number": "५-४२-२७", "content_sanskrit": "त्वादृशान्बालकान्भूपा मादृशाः कृपयंति हि ।\nप्रहरंति न चैतान्वै तस्माद्गच्छ रणाद्बहिः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000583027, "chapter_id": 20583, "verse_number": "५-४२-२८", "content_sanskrit": "यावत्त्वं न मया दृष्टश्चक्षुर्भ्यां तावदुन्मनाः ।\nसांप्रतं त्वां प्रहर्तुं न मनः समभिकांक्षति॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000583028, "chapter_id": 20583, "verse_number": "५-४२-२९", "content_sanskrit": "यत्त्वया मत्सुतो बाणैर्भिन्नो मूर्च्छीकृतः पुनः ।\nसर्वं मया क्षांतमद्य तवबालधियो महत्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000583029, "chapter_id": 20583, "verse_number": "५-४२-३०", "content_sanskrit": "इति वाक्यं समाकर्ण्य पुष्कलो निजगाद तम् ।\nपुष्कल उवाच ।\nबालोऽहं त्वं महावृद्धः सर्वशस्त्रास्त्रकोविदः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000583030, "chapter_id": 20583, "verse_number": "५-४२-३१", "content_sanskrit": "क्षत्रियाणां मतं चैव ये बलाधिक्यसंयुताः ।\nत एव वृद्धा भूपाग्र्य न वयोवृद्धतां गताः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000583031, "chapter_id": 20583, "verse_number": "५-४२-३२", "content_sanskrit": "मया ते मूर्च्छितः पुत्रः सशौर्यबलदर्पितः ।\nइदानीं त्वामहं शस्त्रैः पातयिष्यामि संगरे॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000583032, "chapter_id": 20583, "verse_number": "५-४२-३३", "content_sanskrit": "तस्मात्त्वं यत्नतस्तिष्ठ राजन्संग्राममूर्धनि ।\nरामभक्तं न मां कश्चिज्जयतींद्रपदे स्थितः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000583033, "chapter_id": 20583, "verse_number": "५-४२-३४", "content_sanskrit": "इत्थं भाषितमाश्रुत्य पुष्कलस्य नृपाग्रणीः ।\nजहास बालं संवीक्ष्य कोपं च व्यदधात्पुनः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000583034, "chapter_id": 20583, "verse_number": "५-४२-३५", "content_sanskrit": "तं वै कुपितमालक्ष्य भरतात्मज उन्मदः ।\nजघान शरविंशत्या राजानं हृदि तीक्ष्णया॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000583035, "chapter_id": 20583, "verse_number": "५-४२-३६", "content_sanskrit": "राजा तानागतान्दृष्ट्वा बाणांस्तेन विमोचितान् ।\nचिच्छेद परमक्रुद्धः शरैस्तीक्ष्णैरनेकधा॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000583036, "chapter_id": 20583, "verse_number": "५-४२-३७", "content_sanskrit": "तद्बाणच्छेदनं दृष्ट्वा भारतिः परवीरहा ।\nचुकोप हृदयेऽत्यंतं राजानं च त्रिभिः शरैः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000583037, "chapter_id": 20583, "verse_number": "५-४२-३८", "content_sanskrit": "विव्याध भाले भूपाल पुत्रः पुष्कलसंज्ञकः ।\nतत्र लग्ना विरेजुस्ते त्रिकूटशिखराणि किम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000583038, "chapter_id": 20583, "verse_number": "५-४२-३९", "content_sanskrit": "तैर्बाणैर्व्यथितो राजा जघान नवभिः शरैः ।\nहृदये पुष्कलं वीरं महाकोपसमन्वितः ।\nतैर्वत्सदन्तैर्बह्वस्रं पीतं रामानुजाङ्गजम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000583039, "chapter_id": 20583, "verse_number": "५-४२-४०", "content_sanskrit": "सर्पा आशीविषा यद्वत्क्रुद्धास्तद्वपुषि स्थिताः ।\nपरमं कोपमापन्नः पुष्कलो भूमिपं पुनः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000583040, "chapter_id": 20583, "verse_number": "५-४२-४१", "content_sanskrit": "बाणानां शतकेनाशु बिभेद शितपर्वणाम् ।\nतैर्बाणैः कवचं भिन्नं किरीटः सशिरस्त्रकः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000583041, "chapter_id": 20583, "verse_number": "५-४२-४२", "content_sanskrit": "रथो धनुर्महत्सज्यं छिन्नं कोपपरिप्लवात् ।\nक्षतजेन परिप्लुष्टो बाणभिन्नकलेवरः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000583042, "chapter_id": 20583, "verse_number": "५-४२-४३", "content_sanskrit": "अन्यं स्यंदनमारुह्य जगाम भरतात्मजम् ।\nधन्योसि वीर रामस्य चरणाब्जमधुव्रत॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000583043, "chapter_id": 20583, "verse_number": "५-४२-४४", "content_sanskrit": "महत्कृतं कर्म तेऽद्य यदहं विरथीकृतः ।\nप्राणान्रक्षस्व भो वीर सांप्रतं मयि युद्ध्यति॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000583044, "chapter_id": 20583, "verse_number": "५-४२-४५", "content_sanskrit": "सुलभा न तव प्राणाः कालरूपे मयि स्थिते ।\nइत्युक्त्वा व्यहनद्बाणैरसंख्यैः शस्त्रकोविदः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000583045, "chapter_id": 20583, "verse_number": "५-४२-४६", "content_sanskrit": "भूमौ दिशि च तद्बाणा नान्यद्दृश्येत तत्र ह ।\nअनेके गजसाहस्रा भिन्ना अश्वाः समंततः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000583046, "chapter_id": 20583, "verse_number": "५-४२-४७", "content_sanskrit": "रथारथियुतास्तेन छिन्ना भिन्ना द्विधाकृताः ।\nशोणितौघा सरित्तत्र प्रसुस्राव रणांगणे॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000583047, "chapter_id": 20583, "verse_number": "५-४२-४८", "content_sanskrit": "यत्रोन्मदा हि मातंगा दृश्यंते शैलशृंगवत् ।\nकेशाः शैवाललक्ष्यास्ते मुहुः प्राणिशिरः स्थिताः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000583048, "chapter_id": 20583, "verse_number": "५-४२-४९", "content_sanskrit": "अनेके पाणयश्छिन्ना वीराणां मुद्रिकाश्रियः ।\nदृश्यंते अहिवत्तत्र चंदनादिकरूषिताः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000583049, "chapter_id": 20583, "verse_number": "५-४२-५०", "content_sanskrit": "शिरांसि च भटाग्र्याणां कच्छपाभां वहंति वै ।\nमांसानि पंका यत्रासन्वीराणां महतां ततः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000583050, "chapter_id": 20583, "verse_number": "५-४२-५१", "content_sanskrit": "एवं व्यतिकरे वृत्ते योगिन्यः शतशो रणे ।\nपपुः पात्रेण रुधिरं प्राणिनां रणपातिनाम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000583051, "chapter_id": 20583, "verse_number": "५-४२-५२", "content_sanskrit": "मांसानि बुभुजुस्ता वै हर्षकौतुकसंयुताः ।\nपीत्वा तु शोणितं तत्र भक्षित्वा मांसमुन्मदाः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000583052, "chapter_id": 20583, "verse_number": "५-४२-५३", "content_sanskrit": "ननृतुर्जहसुः प्रोच्चैरुज्जगुः प्रधनांगणे ।\nपिशाचास्तत्र समरे प्राणिनां मस्तकानि वै॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000583053, "chapter_id": 20583, "verse_number": "५-४२-५४", "content_sanskrit": "धृत्वा कराभ्यां मत्तांगास्तालवद्वादनोद्यताः ।\nशिवास्तत्र महामांसं पतितानां रणांगणे॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000583054, "chapter_id": 20583, "verse_number": "५-४२-५५", "content_sanskrit": "भक्षित्वा व्यनदन्मत्ताः कातराणां भयप्रदाः ।\nकातरास्त्राः समापन्ना गताः कुंजरकोटरे॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000583055, "chapter_id": 20583, "verse_number": "५-४२-५६", "content_sanskrit": "भक्षिता योगिनीभिस्ते पापिनां क्वापि न स्थितिः ।\nएतत्कदनमालक्ष्य स्वसैन्यस्य रथाग्रणीः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000583056, "chapter_id": 20583, "verse_number": "५-४२-५७", "content_sanskrit": "पुष्कलोऽपि चकारात्र कदनं रणमंडले ।\nभिद्यंते गजशीर्षाणि पतंति मौक्तिकानि तु॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000583057, "chapter_id": 20583, "verse_number": "५-४२-५८", "content_sanskrit": "दृश्यते लोमभिः पूर्णा ताम्रपर्णीव तन्नदी ।\nपुष्कलप्रहिता बाणा नृणामंगेषु संगताः ।\nकुर्वंति प्राणविच्छेदं वीराणामपि सर्वतः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000583058, "chapter_id": 20583, "verse_number": "५-४२-५९", "content_sanskrit": "सर्वे रुधिरसिक्तांगाः सर्वे च्छिन्ननिजांगकाः ।\nदृश्यंते किंशुका यद्वत्सुभटाः प्रधनांगणे॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000583059, "chapter_id": 20583, "verse_number": "५-४२-६०", "content_sanskrit": "एतस्मिन्समये क्रुद्धः समाभाष्य महीपतिम् ।\nजघान बहुबाणैस्तं रोषपूरपरिप्लुतः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000583060, "chapter_id": 20583, "verse_number": "५-४२-६१", "content_sanskrit": "तद्बाणवेधभिन्नांगो विशीर्णकवचो नृपः ।\nमहाबलं तं मन्वानः प्राहरच्छरकोटिभिः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000583061, "chapter_id": 20583, "verse_number": "५-४२-६२", "content_sanskrit": "तैर्बाणैः कवचान्मुक्तं सुस्राव बहुशोणितम् ।\nवपुर्बभूव रुचिरं शरपंजरगोचरम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000583062, "chapter_id": 20583, "verse_number": "५-४२-६३", "content_sanskrit": "शरपंजरमध्यस्थो विह्वलीकृतमानसः ।\nशरान्नेतुं च संधातुं न क्षमः स च भारतिः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000583063, "chapter_id": 20583, "verse_number": "५-४२-६४", "content_sanskrit": "रामं स्मृत्वा धनुर्धृत्वा करे सज्जं महद्दृढम् ।\nमुमोच बाणान्निशितान्वैरिवृंदनिवारणान्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000583064, "chapter_id": 20583, "verse_number": "५-४२-६५", "content_sanskrit": "तैर्बाणैः शरजालं तद्विधूय मुनिपुंगव ।\nशंखं प्रध्माय समरे जगाद गतभीर्नृपम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000583065, "chapter_id": 20583, "verse_number": "५-४२-६६", "content_sanskrit": "पुष्कल उवाच ।\nत्वया कृतं महत्कर्म यन्मां बाणस्य पंजरे ।\nगोचरं कृतवान्वीर वीरतापनमुद्भटम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000583066, "chapter_id": 20583, "verse_number": "५-४२-६७", "content_sanskrit": "वृद्धत्वान्मम मान्योसि सांप्रतं रणमंडले ।\nपश्यमेऽद्य पराक्रांतं राजन्वीरमणे महत्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000583067, "chapter_id": 20583, "verse_number": "५-४२-६८", "content_sanskrit": "बाणत्रयेण भो वीर मूर्च्छितं करवै नहि ।\nतर्हि प्रतिज्ञां शृणु वै सर्ववीरविमोहिनीम्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000583068, "chapter_id": 20583, "verse_number": "५-४२-६९", "content_sanskrit": "गंगां प्राप्यापि यो वै तां निंदित्वा पापहारिणीम् ।\nन मज्जति महापापो महामूढविचेष्टितः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000583069, "chapter_id": 20583, "verse_number": "५-४२-७०", "content_sanskrit": "तस्य पापं ममैवास्तु चेन्न त्वां रणमंडले ।\nपातये मूर्च्छया वीर सन्नद्धो भव भूपते॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000583070, "chapter_id": 20583, "verse_number": "५-४२-७१", "content_sanskrit": "इति वाक्यं समाकर्ण्य पुष्कलस्य नृपोत्तमः ।\nचुकोप भृशमुद्विग्नः संदधे निशिताञ्छरान्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000583071, "chapter_id": 20583, "verse_number": "५-४२-७२", "content_sanskrit": "ते शरा हृदयं भित्त्वा गतास्ते भारतेर्महत् ।\nपेतुः क्षितावधो यद्वद्रामभक्तिपराङ्मुखाः॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000583072, "chapter_id": 20583, "verse_number": "५-४२-७३", "content_sanskrit": "ततः शरं मुमोचास्मै निशितं वह्निसप्रभम् ।\nलक्षीकृत्य महद्वक्षः कपाटतटविस्तृतम्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000583073, "chapter_id": 20583, "verse_number": "५-४२-७४", "content_sanskrit": "स बाणो भूमिपतिना द्विधा छिन्नः शरेण हि ।\nपपात रथमध्ये स रविमंडलवज्ज्वलन्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000583074, "chapter_id": 20583, "verse_number": "५-४२-७५", "content_sanskrit": "अपरं बाणमाधत्त मातृभक्तिभवं ततः ।\nनिधाय पुण्यं सोऽप्येष चिच्छेद महता पुनः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000583075, "chapter_id": 20583, "verse_number": "५-४२-७६", "content_sanskrit": "तदा खिन्नः स हृदये किंकर्तव्यमिति स्मरन् ।\nरामं हृदि निजार्तिघ्नं मुमोच परमास्त्रवित्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000583076, "chapter_id": 20583, "verse_number": "५-४२-७७", "content_sanskrit": "स बाणस्तस्य हृदये लग्न आशीविषोपमः ।\nमूर्च्छामप्रापयत्तं वै ज्वलन्सूर्यसमप्रभः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000583077, "chapter_id": 20583, "verse_number": "५-४२-७८", "content_sanskrit": "ततो हाहाकृतं सर्वं पलायनपरायणम् ।\nराज्ञि संमूर्च्छिते जाते पुष्कलो जयमाप्तवान्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]