[{"id": 7000642000, "chapter_id": 20642, "verse_number": "५-१०१-१", "content_sanskrit": "यम उवाच ।\nअथ कालकटाक्षेण लक्षितो नृपतिस्तदा ।\nमृतोऽतिरतिसेवोत्थ क्षयक्षीणकलेवरः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000642001, "chapter_id": 20642, "verse_number": "५-१०१-२", "content_sanskrit": "नीयमानो यमगणैस्ताड्यमानो मुहुर्मुहुः ।\nक्रन्दमानो महारावान्स स्मरन्निजपातकम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000642002, "chapter_id": 20642, "verse_number": "५-१०१-३", "content_sanskrit": "विष्णुदूतैः समागम्य ताडयित्वा ममानुगान् ।\nधर्मवानयमित्युक्त्वा विमानमथ रोपितः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000642003, "chapter_id": 20642, "verse_number": "५-१०१-४", "content_sanskrit": "नीतो हरिपुरं भूपः स्तूयमानोऽप्सरोगणैः ।\nप्रातःस्नानेन वैशाखमासस्य क्षीणपातकः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000642004, "chapter_id": 20642, "verse_number": "५-१०१-५", "content_sanskrit": "अथ धर्मविहीनोऽयमिति मत्वा च तैः पुनः ।\nदेवदूतैर्निदेशेन विष्णोर्भूमिपतिस्तदा ।\nअदूरादेव निरयवर्त्मना स समाहितः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000642005, "chapter_id": 20642, "verse_number": "५-१०१-६", "content_sanskrit": "स गच्छन्नपि शुश्राव जीवानां क्रंदतां पुनः ।\nनिरये पच्यमानानामारावं विविधं तदा ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000642006, "chapter_id": 20642, "verse_number": "५-१०१-७", "content_sanskrit": "पापिनां क्वथ्यमानानामाक्रंदमतिदारुणम् ।\nश्रुत्वा विस्मयवान्विप्र राजाभूदतिदुःखितः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000642007, "chapter_id": 20642, "verse_number": "५-१०१-८", "content_sanskrit": "प्रोवाच दूताः किमयमाक्रंदो दारुणः श्रुतः ।\nपुनर्न श्रूयते तन्मे कारणं वक्तुमर्हथ ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000642008, "chapter_id": 20642, "verse_number": "५-१०१-९", "content_sanskrit": "दूता ऊचु ।\nजंतवस्त्यक्तमर्यादाः पापास्त्वाचारवर्जिताः ।\nनिरयेषु च घोरेषु तामिस्रादिषु पातिताः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000642009, "chapter_id": 20642, "verse_number": "५-१०१-१०", "content_sanskrit": "कृतपातकिनस्त्वत्र प्राणत्यागादनंतरम् ।\nयाम्यं पंथानमाश्रित्य दुःखमश्नंति दारुणम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000642010, "chapter_id": 20642, "verse_number": "५-१०१-११", "content_sanskrit": "यमस्य पुरुषैर्घोरैः कृष्यमाणा इतस्ततः ।\nअंधकारे निपतिता भक्ष्यंते ह्यतिदारुणैः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000642011, "chapter_id": 20642, "verse_number": "५-१०१-१२", "content_sanskrit": "श्वभिः शृगालैः क्रव्यादैः काककंकबकादिभिः ।\nअग्नितुंडैर्वृकव्याघ्रैर्भुजगैर्वृश्चिकादिभिः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000642012, "chapter_id": 20642, "verse_number": "५-१०१-१३", "content_sanskrit": "अग्निना दाह्यमानाश्च तुद्यमानाश्च कंटकैः ।\nक्रकचैः पाट्यमानाश्च पीड्यमानाश्च तृष्णया ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000642013, "chapter_id": 20642, "verse_number": "५-१०१-१४", "content_sanskrit": "क्षुधया बाध्यमानाश्च घोरैर्व्याधिगणैस्तथा ।\nपूयशोणितगंधेन मूर्छ्यमानाः पदेपदे ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000642014, "chapter_id": 20642, "verse_number": "५-१०१-१५", "content_sanskrit": "क्वाथ्यंते च क्वचित्तैलैस्ताड्यन्ते मुशलैः क्वचित् ।\nआयसीषु प्रपच्यंते शिलासु क्वचिदेव च ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000642015, "chapter_id": 20642, "verse_number": "५-१०१-१६", "content_sanskrit": "क्वचिद्वांतमथाश्नंति क्वचित्पूयमसृक्क्वचित् ।\nक्वचिद्विष्ठां क्वचिन्मांसं पूतिगंधिषु दारुणम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000642016, "chapter_id": 20642, "verse_number": "५-१०१-१७", "content_sanskrit": "कृमिभिर्भक्ष्यमाणाश्च वह्नितुंडैः क्वचित्क्वचित् ।\nकेशशोणितमांसासृग्वसास्थिनिकरेषु च ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000642017, "chapter_id": 20642, "verse_number": "५-१०१-१८", "content_sanskrit": "अस्थिताः कुणपाः कीर्णाः कृमिभिर्भक्षिताः स्फुटम् ।\nकाककंकमहागृध्रवदनैर्ध्वंसितेषु च ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000642018, "chapter_id": 20642, "verse_number": "५-१०१-१९", "content_sanskrit": "शिवदुर्गंधनीरंध्र संघट्टशतकोटिषु ।\nकरपत्रशिलापत्रतप्त निस्तैलकेषु च ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000642019, "chapter_id": 20642, "verse_number": "५-१०१-२०", "content_sanskrit": "लोहतैलवसास्तंभ कूटशाल्मलसद्मसु ।\nक्षुरकंटककीलोग्र ज्वालास्तंभविभातिषु ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000642020, "chapter_id": 20642, "verse_number": "५-१०१-२१", "content_sanskrit": "तप्तं वैतरणीपूयपूरितेषु पृथक्पृथक् ।\nअसिपत्रवनोत्कृत्त नरनारीस्तनेषु च ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000642021, "chapter_id": 20642, "verse_number": "५-१०१-२२", "content_sanskrit": "घोरांधकारग्रहणदारुणेषु मुहुर्मुहुः ।\nपापच्यमानाः क्रंदंतो दारुणैर्विविधैर्वधैः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000642022, "chapter_id": 20642, "verse_number": "५-१०१-२३", "content_sanskrit": "कंठेषु बद्धपाशाश्च भुजगावेष्टिताः क्वचित् ।\nपीड्यमानास्तथा यंत्रैः कृष्यमाणाश्च जानुभिः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000642023, "chapter_id": 20642, "verse_number": "५-१०१-२४", "content_sanskrit": "भग्नपृष्ठशिरोग्रीवाः स्तब्धकंठाः सुदारुणाः ।\nकूटागारे भ्राम्यमाणाः शरीरैर्यातनाक्षमैः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000642024, "chapter_id": 20642, "verse_number": "५-१०१-२५", "content_sanskrit": "पीड्यंते पापिनो राजन्क्रंदमाना विकर्मिणः ।\nसहितं विषयास्वादैः क्रंदनं तैर्विधीयते ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000642025, "chapter_id": 20642, "verse_number": "५-१०१-२६", "content_sanskrit": "भुज्यते च कृतं पूर्वमेतत्सर्वैश्च जंतुभिः ।\nपरस्त्रीषु कृतः संगः प्रीतये दुःखदो हि सः ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000642026, "chapter_id": 20642, "verse_number": "५-१०१-२७", "content_sanskrit": "मुहूर्तविषयास्वादो जातोऽनेकाब्ददुःखदः ।\nवपुषस्तव राजेंद्र प्रातःस्नानस्य माधवे ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000642027, "chapter_id": 20642, "verse_number": "५-१०१-२८", "content_sanskrit": "विधिना पावनस्यैते प्राप्य स्पर्शं च मारुतः ।\nलब्धसौख्याः क्षणं जाता महसाप्यायितास्तव ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000642028, "chapter_id": 20642, "verse_number": "५-१०१-२९", "content_sanskrit": "आक्रंदरहितास्तेन जातास्ते निरये स्थिताः ।\nनामापि पुण्यशीलानां श्रुतं सौख्याय कीर्तितम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000642029, "chapter_id": 20642, "verse_number": "५-१०१-३०", "content_sanskrit": "जायते तद्वपुस्पर्शवायुस्पर्शः सुखावहः ।\nयम उवाच ।\nइति दूतवचः श्रुत्वा स राजा करुणानिधिः ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000642030, "chapter_id": 20642, "verse_number": "५-१०१-३१", "content_sanskrit": "प्रत्युवाच हतान्दूतान्विष्णोरद्भुतकर्मणः ।\nकोमलं हृदयं नूनं साधूनां नवनीतवत् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000642031, "chapter_id": 20642, "verse_number": "५-१०१-३२", "content_sanskrit": "वह्निसंतापसंतप्तं तद्यथा द्रवति स्फुटम् ।\nराजोवाच ।\nनार्तं जंतुमहं हित्वा पीडितुं गंतुमुत्सहे ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000642032, "chapter_id": 20642, "verse_number": "५-१०१-३३", "content_sanskrit": "तं पापिष्ठं धिगार्तानामार्तिं शक्तो न हंति यः ।\nमदंगसंगमोच्छिष्टवायुस्पर्शेन ते यदि ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000642033, "chapter_id": 20642, "verse_number": "५-१०१-३४", "content_sanskrit": "जंतवः सुखिनो जातास्तस्मात्तत्र नयंतु माम् ।\nपवित्रयंति जननीमवनीमपि ते नराः ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000642034, "chapter_id": 20642, "verse_number": "५-१०१-३५", "content_sanskrit": "परतापच्छिदो ये तु चंदना इव चंदनम् ।\nपरोपकृतये ये तु पीड्यंते कृतिनो हि ते ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000642035, "chapter_id": 20642, "verse_number": "५-१०१-३६", "content_sanskrit": "संतस्त एव ये लोके परदुःखविदारणाः ।\nआर्तानामार्तिनाशार्थं प्राणा येषां तृणोपमाः ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000642036, "chapter_id": 20642, "verse_number": "५-१०१-३७", "content_sanskrit": "तैरियं धार्यते भूमिर्नरैः परहितोद्यतैः ।\nमनसो यत्सुखं नित्यं तत्स्वर्गो नरकोपमः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000642037, "chapter_id": 20642, "verse_number": "५-१०१-३८", "content_sanskrit": "तस्मात्परसुखेनैव सुखिनः साधवः सदा ।\nवरं निरयपातोऽत्र वरं प्राणवियोजनम् ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000642038, "chapter_id": 20642, "verse_number": "५-१०१-३९", "content_sanskrit": "न पुनः क्षणमार्तानामार्तिनाशमृते सुखम् ।\nदूता ऊचु ।\nजंतवो निरये घोरे पच्यंते तेत्र पापिनः ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000642039, "chapter_id": 20642, "verse_number": "५-१०१-४०", "content_sanskrit": "स्वकर्मैवोपजीवंति मोहस्थानं न विद्यते ।\nयैर्न दत्तं न च हुतं तीर्थे स्नानं न वा कृतम् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000642040, "chapter_id": 20642, "verse_number": "५-१०१-४१", "content_sanskrit": "पुनर्नोपकृतं भक्त्या सुकृतं न कृतं परम् ।\nनेष्टं न तप्तं नो जप्तं यैर्न हृष्टतया नृप ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000642041, "chapter_id": 20642, "verse_number": "५-१०१-४२", "content_sanskrit": "परस्मिन्निह घोरेषु पच्यंते निरयेषु ते ।\nदुःशीला ये दुराचारा विहाराहारनिंदिताः ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000642042, "chapter_id": 20642, "verse_number": "५-१०१-४३", "content_sanskrit": "परापकारिणः पापकारिणो दुर्विहारिणः ।\nविदारिणो हि मर्मोक्त्या पापाः परहृदां हि ये ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000642043, "chapter_id": 20642, "verse_number": "५-१०१-४४", "content_sanskrit": "निरये ते विपच्यंते ये परस्त्रीविहारिणः ।\nएहि नूनं महीपाल गच्छामो हरिमंदिरम् ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000642044, "chapter_id": 20642, "verse_number": "५-१०१-४५", "content_sanskrit": "न ते पुण्यवता युक्तमिहस्था तु मतः परम् ।\nराजोवाच ।\nयद्यहं सुकृती दूताः कस्मादस्मिन्महाभये ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000642045, "chapter_id": 20642, "verse_number": "५-१०१-४६", "content_sanskrit": "नारके पथि वा नीतः किं वा मे सुकृतं परम् ।\nमयापि न कृतं तादृक्सुकृतं कामशालिना ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000642046, "chapter_id": 20642, "verse_number": "५-१०१-४७", "content_sanskrit": "कथं पुरि हरेर्गंता संशयानोऽहमस्मि वै ।\nदूता ऊचु ।\nसुकृतं न कृतं सत्यं त्वया कामवशात्मना ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000642047, "chapter_id": 20642, "verse_number": "५-१०१-४८", "content_sanskrit": "नेष्टं यज्ञैर्न वा यज्ञावशिष्टं भवताशितम् ।\nकिंतु माधवमासे यद्विधिना वत्सरत्रयम् ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000642048, "chapter_id": 20642, "verse_number": "५-१०१-४९", "content_sanskrit": "प्रातः स्नात्वा गुरुवचः प्रेरितेन पुरा त्वया ।\nभक्त्या संपूजितो विष्णुर्विश्वेशो मधुसूदनः ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000642049, "chapter_id": 20642, "verse_number": "५-१०१-५०", "content_sanskrit": "महापापातिपापौघ निहंता भक्तवत्सलः ।\nसर्वधर्मैकसारेण तेनैकेन नरेश्वर ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000642050, "chapter_id": 20642, "verse_number": "५-१०१-५१", "content_sanskrit": "नीयते पुण्यभवनं पूज्यमानो मरुद्गणैः ।\nमहतामपि पापानां निहंता माधवोऽर्चितः ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000642051, "chapter_id": 20642, "verse_number": "५-१०१-५२", "content_sanskrit": "तथैव माधवो मासो मर्त्यानां विधिनोदितः ।\nयथैव विस्फुलिंगेन ज्वाल्यते तृणसंचयः ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000642052, "chapter_id": 20642, "verse_number": "५-१०१-५३", "content_sanskrit": "प्रातःस्नानेन वैशाखे तथाघौघोऽपि दह्यते ।\nतावद्वपुषि पापानि प्रभवंति महान्त्यपि ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000642053, "chapter_id": 20642, "verse_number": "५-१०१-५४", "content_sanskrit": "यावन्न माधवे मासि तीर्थे मज्जति चोषसि ।\nवैशाखे मासि यो युक्तो यथोक्तनियमैर्नरः ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000642054, "chapter_id": 20642, "verse_number": "५-१०१-५५", "content_sanskrit": "हरिभक्त्यैव पापौघैर्मुक्तोऽच्युतगृहं व्रजेत् ।\nआजन्मनो हि सुकृतं यत्त्वया न पुरा कृतम् ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000642055, "chapter_id": 20642, "verse_number": "५-१०१-५६", "content_sanskrit": "तेन त्वं निरयस्थानमार्गं नीतो नरेश्वर ।\nअथ भूमिपते तूर्णमस्माभिस्तु मरुद्गणैः ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000642056, "chapter_id": 20642, "verse_number": "५-१०१-५७", "content_sanskrit": "स्तूयमानो विमानेन गच्छ गोविंदमंदिरम् ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]