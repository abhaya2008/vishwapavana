[{"id": 7006152000, "chapter_id": 26152, "verse_number": "१-२-१३-१", "content_sanskrit": "सूत उवाच ।\nमध्ये हिमवतः पृष्ठे कैलासो नाम पर्वतः ।\nतस्मिन्निवसति श्रीमान्कुबेरः सह राक्षसैः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006152001, "chapter_id": 26152, "verse_number": "१-२-१३-२", "content_sanskrit": "अप्सरोनुचरो राजा मोदते ह्यलकाधिपः ।\nकैलासपादात्संभूतं पुण्यं शीतजलं शुभम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006152002, "chapter_id": 26152, "verse_number": "१-२-१३-३", "content_sanskrit": "मदं नाम्ना कुमुद्वत्त्त्सरस्तूदधिसन्निभम् ।\nतस्माद्दिव्यात्प्रभवति नदी मंदाकिनी शुभा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006152003, "chapter_id": 26152, "verse_number": "१-२-१३-४", "content_sanskrit": "दिव्यं च नंदनवनं तस्यास्तीरे महद्वनम् ।\nप्रागुत्तरेम कैलासाद्दिव्यं सर्वौषधि गिरिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006152004, "chapter_id": 26152, "verse_number": "१-२-१३-५", "content_sanskrit": "रत्नधातुमयं चित्रं सबलं पर्वतं प्रति ।\nचन्द्रप्रभो नाम गिरिः सुशुभ्रो रत्नसन्निभः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006152005, "chapter_id": 26152, "verse_number": "१-२-१३-६", "content_sanskrit": "तस्य पादे महाद्दिव्यं स्वच्छोदं नाम तत्सरः ।\nतस्माद्दिव्यात्प्रभवति स्वच्छोदा नाम निम्नगा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006152006, "chapter_id": 26152, "verse_number": "१-२-१३-७", "content_sanskrit": "तस्यास्तीरे महद्दिव्यं वनं चैत्ररथं शुभम् ।\nतस्मिन् गिरौ निवसति मणिभद्रः सहानुगः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006152007, "chapter_id": 26152, "verse_number": "१-२-१३-८", "content_sanskrit": "यक्षसेनापतिः क्रूरो गुह्यकैः परिवारितः ।\nपुण्या मंदाकिनी चैव नदी स्वच्छोदका च या ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006152008, "chapter_id": 26152, "verse_number": "१-२-१३-९", "content_sanskrit": "महीमंडलमध्येन प्रविष्टे ते महोदधिम् ।\nकैलासाद्दक्षिणे प्राच्यां शिवसत्त्वौषधिं गिरिम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006152009, "chapter_id": 26152, "verse_number": "१-२-१३-१०", "content_sanskrit": "मनः शिलामयं दिव्यं चित्रांगं पर्वतं प्रति ।\nलोहितो हेमश्रृंगश्च गिरिः सूर्यप्रभो महान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006152010, "chapter_id": 26152, "verse_number": "१-२-१३-११", "content_sanskrit": "तस्य पादे महद्दिव्यं लोहितं नाम तत्सरः ।\nतस्मात्पुण्यः प्रभवति लौहित्यः स नदो महान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006152011, "chapter_id": 26152, "verse_number": "१-२-१३-१२", "content_sanskrit": "देवारण्यं विशोकं च तस्य तीरे महद्वनम् ।\nतस्मिन्गिरौ निवसति यक्षो मणिधरो वशी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006152012, "chapter_id": 26152, "verse_number": "१-२-१३-१३", "content_sanskrit": "सौम्यैः मुधार्मिकैश्चैव गुह्यके परिवारितः ।\nकैलासाद्दक्षिणे पार्श्वे क्रूरसत्त्वौषधिर्गिरिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006152013, "chapter_id": 26152, "verse_number": "१-२-१३-१४", "content_sanskrit": "वृत्रकायात्किलोत्पन्नमञ्जनं त्रिककुं प्रति ।\nसर्वधातुमयस्तत्र सुमहान्वैद्युतो गिरिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006152014, "chapter_id": 26152, "verse_number": "१-२-१३-१५", "content_sanskrit": "तस्य पादे कलः पुण्यं मानसं सिद्धसेवितम् ।\nतस्मात्प्रभवेते पुण्या सरयूर्लोकविश्रुता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006152015, "chapter_id": 26152, "verse_number": "१-२-१३-१६", "content_sanskrit": "तस्यास्तीरे वन दिव्यं वैभ्राजं नाम विश्रुतम् ।\nकुबेरा नुचरस्तत्र प्रहेतितनयो वशी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006152016, "chapter_id": 26152, "verse_number": "१-२-१३-१७", "content_sanskrit": "ब्रह्मपितो निवसति राक्षसोऽनंतविक्रमः ।\nअतरिक्षचरैर्घोरैर्यातुधानशतैर्वृतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006152017, "chapter_id": 26152, "verse_number": "१-२-१३-१८", "content_sanskrit": "अपरेण तु कैलासात्पुण्यसत्त्वौषधिर्गिरिः ।\nअरुणः पर्वतश्रेष्ठो रुक्मधातुमयः शुभः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006152018, "chapter_id": 26152, "verse_number": "१-२-१३-१९", "content_sanskrit": "भवस्य दयितः श्रीमान्पर्वतो मेघसन्निभः ।\nशातकौंभमयैः शुभ्रैः शिलाजालैः समावृतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006152019, "chapter_id": 26152, "verse_number": "१-२-१३-२०", "content_sanskrit": "शातसंख्यैस्तापनीयैः श्रृंगैर्दिवमिवोल्लिखन् ।\nमुंजवास्तु महादिव्यो दुर्गः शैलो हिमाचितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006152020, "chapter_id": 26152, "verse_number": "१-२-१३-२१", "content_sanskrit": "तस्मिन्गिरौ निवसति गिरीशो धूम्रलोचनः ।\nतस्या पादात्प्रभवति शैलोदं नाम तत्सरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006152021, "chapter_id": 26152, "verse_number": "१-२-१३-२२", "content_sanskrit": "तस्मात्प्रभवते पुण्या शिलोदा नाम निम्रगा ।\nसा चक्षुः सीतयोर्मध्ये प्रविष्टा लवणोदधिम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006152022, "chapter_id": 26152, "verse_number": "१-२-१३-२३", "content_sanskrit": "तस्यास्तीरे वनं दिव्यं विश्रुतं सुरभीति वै ।\nसव्योत्तरेण कैलासाच्छिवः सत्त्वौषधिर्गिरिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006152023, "chapter_id": 26152, "verse_number": "१-२-१३-२४", "content_sanskrit": "गौरं नाम गिरिश्रेष्ठं हरितालमयं प्रति ।\nहिरण्यश्रृंगः सुमहान् दिव्यो मणिमयो गिरिः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006152024, "chapter_id": 26152, "verse_number": "१-२-१३-२५", "content_sanskrit": "तस्या पादे महाद्दिव्यं शुभं काञ्चनवालुकम् ।\nरम्यं बिंदुसरो नाम यत्र राजा भगीरथः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006152025, "chapter_id": 26152, "verse_number": "१-२-१३-२६", "content_sanskrit": "गंगनिमित्तं राजर्षिरुवास बहुलाः समाः ।\nदिवं यास्यंति ते बुर्वे गंगतोयपरिप्लुताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006152026, "chapter_id": 26152, "verse_number": "१-२-१३-२७", "content_sanskrit": "मदीय इति निश्चित्य समाहितमनाः शिवे ।\nतत्र त्रिपयगा देवी प्रथमं तु प्रतिष्ठिता ।\nसोमपादात्प्रसूता सा सप्तधा प्रतिपद्यते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006152027, "chapter_id": 26152, "verse_number": "१-२-१३-२८", "content_sanskrit": "यूपा मणिमयास्तत्र वितताश्च हिरण्मयाः ।\nतत्रेष्ट्वा तु गतः सिद्धिं शक्रः सर्वैः सुरैः सह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006152028, "chapter_id": 26152, "verse_number": "१-२-१३-२९", "content_sanskrit": "दिवि च्छायापथो यस्तु अनुनक्षत्रमंडलः ।\nदृश्यते भास्वरो रात्रौ देवी त्रिपथगा तु सा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006152029, "chapter_id": 26152, "verse_number": "१-२-१३-३०", "content_sanskrit": "अंतरिक्षं दिवंचैव भावयंती सुरापगा ।\nभवोत्तमांगे पतिता संरूद्धा यौगमायया ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006152030, "chapter_id": 26152, "verse_number": "१-२-१३-३१", "content_sanskrit": "तस्या ये बिंदवः केचित् क्रुद्धायाः पतिता भुवि ।\nकृतं तु तैर्बिदुसरस्ततो बिंदुसरः स्मृतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006152031, "chapter_id": 26152, "verse_number": "१-२-१३-३२", "content_sanskrit": "ततो निरूद्धा सा देवी भवेन स्मयता किल ।\nचिंतयामास मनसा शंकरक्षेपमं प्रति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006152032, "chapter_id": 26152, "verse_number": "१-२-१३-३३", "content_sanskrit": "भित्त्वा विशामि पातालं स्रोतसागृह्य शंकरम् ।\nज्ञात्वा तम्या अभिप्रायं क्रूरं देव्याश्चिकीर्षितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006152033, "chapter_id": 26152, "verse_number": "१-२-१३-३४", "content_sanskrit": "तिरोभावयितुं बुद्धिरासीदंगेषु तां नदीम् ।\nतस्यावलेपं ज्ञात्वा तु नद्याःक्रुद्धस्तुशंकरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006152034, "chapter_id": 26152, "verse_number": "१-२-१३-३५", "content_sanskrit": "न्यरुपाच्च शिरस्येनां वेगेन पततीं भुवि ।\nएतस्मिन्नेव काले तु दृष्ट्वा राजानमग्रतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006152035, "chapter_id": 26152, "verse_number": "१-२-१३-३६", "content_sanskrit": "धमनीसंततं क्षीणं क्षुधया व्याकुलेन्द्रियम् ।\nअनेन तोषितश्चाहं नद्यर्थं पूर्वमेव तु ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006152036, "chapter_id": 26152, "verse_number": "१-२-१३-३७", "content_sanskrit": "बुद्धाऽस्य वरदानं च कोपं नियतवांस्तु सः ।\nब्रह्मणो वचनं श्रुत्वा धारय स्वर्णदीमिति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006152037, "chapter_id": 26152, "verse_number": "१-२-१३-३८", "content_sanskrit": "ततो विसर्जयामास संरुद्धां स्वेन तेजसा ।\nनदीं भगीरथस्यार्थे तपसोग्रेण तोषितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006152038, "chapter_id": 26152, "verse_number": "१-२-१३-३९", "content_sanskrit": "ततो विसृज्यमानायाः स्रोत स्तत्सप्तधा गतम् ।\nतिस्रः प्ताचीमिमुखं प्रतीचीं तिस्र एव तु ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006152039, "chapter_id": 26152, "verse_number": "१-२-१३-४०", "content_sanskrit": "नद्याः स्रोतस्तु गंगायाः प्रत्यपद्यत सप्तधा ।\nनलिनी ह्लादिनी चैव पावनी चैव प्राच्यगाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006152040, "chapter_id": 26152, "verse_number": "१-२-१३-४१", "content_sanskrit": "सीता चक्षुश्च सिन्धुश्च प्रतीचींदिशमास्थिताः ।\nसप्तमी त्वन्वगात्तासां दक्षिणेन भगीरथम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006152041, "chapter_id": 26152, "verse_number": "१-२-१३-४२", "content_sanskrit": "तस्माद्भागीरथी या सा प्रविष्टा लवणोदधिम् ।\nसप्तैता भावयंतीदं हिमाह्वं वर्षमेव तु ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006152042, "chapter_id": 26152, "verse_number": "१-२-१३-४३", "content_sanskrit": "प्रसूताः सप्त नद्यस्ताः शुभा बिन्दु सरोद्भवाः ।\nनानादेशान्प्लावयन्त्यो मलेच्छप्रायास्तु सर्वशः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006152043, "chapter_id": 26152, "verse_number": "१-२-१३-४४", "content_sanskrit": "उपगच्छंति ताः सर्वा यतो वर्षति वासवः ।\nशिलीन्ध्रान्कुन्त लांश्चीनान्बर्बरान्यवनाध्रकान् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006152044, "chapter_id": 26152, "verse_number": "१-२-१३-४५", "content_sanskrit": "पुष्कराश्च कुलिन्दांश्च अचोंलद्विचराश्च ये ।\nकृत्वा त्रिधा सिंहवंतं सीताऽगात्पश्चिमोद धिम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006152045, "chapter_id": 26152, "verse_number": "१-२-१३-४६", "content_sanskrit": "अथ चीनमरूंश्चैव तालांश्च मसमूलिकान् ।\nभद्रास्तुषाराँल्लाम्याकान्बाह्लवान्पारटान्खशान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006152046, "chapter_id": 26152, "verse_number": "१-२-१३-४७", "content_sanskrit": "एताञ्जनपदां श्चक्षुः प्रावयंती गतोदधिम् ।\nदरदांश्च सकाश्मीरान् गांधरान् रौरसान् कुहान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006152047, "chapter_id": 26152, "verse_number": "१-२-१३-४८", "content_sanskrit": "शिवशैलानिन्द्रपदान्वसतीश्च विसर्जमान् ।\nसैंधवान्रंध्रकरकाञ्छमठाभीररोहकान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006152048, "chapter_id": 26152, "verse_number": "१-२-१३-४९", "content_sanskrit": "शुनासुखांश्चोर्द्धमरून्सिन्धुरेतान्निषेवते ।\nगंधर्वकिन्नरान्यक्षान्रक्षोविद्याधरोरगान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006152049, "chapter_id": 26152, "verse_number": "१-२-१३-५०", "content_sanskrit": "कलापग्रामकांश्चैव पारदांस्तद्गणान् खशान् ।\nकिरातांश्चपुलिन्दांश्च कुरून् सभरतानपि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006152050, "chapter_id": 26152, "verse_number": "१-२-१३-५१", "content_sanskrit": "पंचालान्काशिमत्स्यां श्च मगधांगांस्तथैव च ।\nसुह्मोत्तरांश्च वंगांश्च ताम्रलिप्तांस्तथैव च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006152051, "chapter_id": 26152, "verse_number": "१-२-१३-५२", "content_sanskrit": "एताञ्जनपदान्मान्यान्गंगा भावयते शुभान् ।\nततः प्रतिहता विंध्यात्प्रविष्टा लवणोदधिम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006152052, "chapter_id": 26152, "verse_number": "१-२-१३-५३", "content_sanskrit": "ततश्च ह्लादिनी पुण्य प्राचीमभिमुखा ययौ ।\nप्रावयंत्युपभागांश्च नैषधांश्च त्रिगर्त कान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006152053, "chapter_id": 26152, "verse_number": "१-२-१३-५४", "content_sanskrit": "धीवरानृषिकांश्चैव तथा नीलमुखानपि ।\nकेकरानौष्टकर्णांश्च किरातानपि चैव हि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006152054, "chapter_id": 26152, "verse_number": "१-२-१३-५५", "content_sanskrit": "कालोदरान्विवर्णाश्च कुमारान्स्वर्णभूमिकान् ।\nआमंडलं समुद्रस्य तिरोभूतांश्च पूर्वतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006152055, "chapter_id": 26152, "verse_number": "१-२-१३-५६", "content_sanskrit": "ततस्तु पावनी चापि प्राचीमेव दिशं ययौ ।\nसुपथान्पावयं तीह त्विंद्रद्युम्नसरोपि च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006152056, "chapter_id": 26152, "verse_number": "१-२-१३-५७", "content_sanskrit": "तथा खरपथांश्चैव वेत्रशंकुपथानपि ।\nमध्यतोजानकिमथो कुथप्रावरणान्ययौ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006152057, "chapter_id": 26152, "verse_number": "१-२-१३-५८", "content_sanskrit": "इंद्रद्वीप समुद्रं तु प्रविष्टां लवणोदधिम् ।\nततस्तु नलिनी प्रायात् प्राचीमाशां जवेन तु ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006152058, "chapter_id": 26152, "verse_number": "१-२-१३-५९", "content_sanskrit": "तोमरान्भावयंतीह हंसमार्गान्सहैहयान् ।\nपूर्वन्देशांश्च सेवंती भित्त्वा सा बहुधागिरीन् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006152059, "chapter_id": 26152, "verse_number": "१-२-१३-६०", "content_sanskrit": "कर्णप्रावरणान्प्राप्य संगत्या श्वमुखानपि ।\nसिकतापर्वतमरुं गत्वा विद्याधरान्ययौ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006152060, "chapter_id": 26152, "verse_number": "१-२-१३-६१", "content_sanskrit": "नगमंडलमध्येन प्रविष्टा लवणोदधिम् ।\nतासां नद्युपनद्यश्च शतशोऽथ सहस्रशः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006152061, "chapter_id": 26152, "verse_number": "१-२-१३-६२", "content_sanskrit": "उपगच्छंति ताः सर्वा यतो वर्षति वासवः ।\nवक्वौकसायास्तीरे तु वनं सुरभि विश्रुतम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006152062, "chapter_id": 26152, "verse_number": "१-२-१३-६३", "content_sanskrit": "हिरण्यश्रृंगे वसति विद्वान्कौबेरको वशी ।\nयज्ञोपेतश्च सुमहानमितौजाः सुविक्रमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006152063, "chapter_id": 26152, "verse_number": "१-२-१३-६४", "content_sanskrit": "तत्रत्यैस्तैः परिवृतौ विद्वद्भिर्ब्रह्मराक्षसैः ।\nकुबेरानुचरा ह्येते चत्वारस्तु समाः स्मृताः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006152064, "chapter_id": 26152, "verse_number": "१-२-१३-६५", "content_sanskrit": "एवमेव तु विज्ञेया ऋद्धिः पर्वतवासिनाम् ।\nपरस्परेण द्विगुणा धर्मतः कामतोऽर्थतः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006152065, "chapter_id": 26152, "verse_number": "१-२-१३-६६", "content_sanskrit": "हेमकूटस्य पृष्ठे तु वर्चोवन्नामतः सरः ।\nमनस्विनीप्रभवति तस्माज्ज्योतिष्मती च या ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006152066, "chapter_id": 26152, "verse_number": "१-२-१३-६७", "content_sanskrit": "अवगाढे ह्युभयतः समुद्रौ पूर्वपश्चिमौ ।\nसरो विष्णुपदं नाम निषधे पर्वतोत्तमे ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006152067, "chapter_id": 26152, "verse_number": "१-२-१३-६८", "content_sanskrit": "तस्माद्द्वयं प्रभवति गांधर्वी नाकुली च तैः ।\nमेरोः पार्श्वात्प्रभवति ह्रदश्चंद्रप्रभो महान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006152068, "chapter_id": 26152, "verse_number": "१-२-१३-६९", "content_sanskrit": "तत्र जंबूनदी पुण्या यस्या जांबूनदं स्मृतम् ।\nपयोदं तु सरो नीले सुशुभ्रं पुंडरीकवत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006152069, "chapter_id": 26152, "verse_number": "१-२-१३-७०", "content_sanskrit": "पुंडरीका पयोदा य तस्मान्नद्यौ विनिर्गते ।\nश्वेतात्प्रवर्त्तते पुण्यं सरयूर्मानसाद्ध्रुवम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006152070, "chapter_id": 26152, "verse_number": "१-२-१३-७१", "content_sanskrit": "ज्योत्स्ना च मृगाकामा च तस्माद्द्वे संबभूवतुः ।\nसरः कुरुषु विख्यातं पद्ममीनद्विजाकुलम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006152071, "chapter_id": 26152, "verse_number": "१-२-१३-७२", "content_sanskrit": "रुद्रकांतमिति ख्यातं निर्मितं तद्भवेन तु ।\nअन्ये चाप्यत्र विख्याताः पद्मामीनद्विजाकुलाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006152072, "chapter_id": 26152, "verse_number": "१-२-१३-७३", "content_sanskrit": "नाम्ना ह्रदा जया नाम द्वादशोदधिसन्निभाः ।\nतेभ्यः शांता य माध्वी च द्वे नद्यौ संबभूवतुः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006152073, "chapter_id": 26152, "verse_number": "१-२-१३-७४", "content_sanskrit": "यानि किंपुरुषाद्यानि तेषु देवो न वर्षति ।\nउद्भिदान्युदकान्यत्र प्रवहंति सरिद्वराः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006152074, "chapter_id": 26152, "verse_number": "१-२-१३-७५", "content_sanskrit": "ऋषभो दुन्दुभिश्चैव धूम्नश्च सुमहागिरिः ।\nपूर्वायता महापर्वा निमग्ना लवणाभसि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006152075, "chapter_id": 26152, "verse_number": "१-२-१३-७६", "content_sanskrit": "चंद्रः काकस्तथा द्रोणः सुमहांतः शिलोच्चयाः ।\nउदग्याता उदीच्यांता अवगाढा महोदधिम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006152076, "chapter_id": 26152, "verse_number": "१-२-१३-७७", "content_sanskrit": "सोमकश्च वराहश्च नारदश्च महीधरः ।\nप्रतीच्यामायतास्ते वै प्रविष्टा लवणोदधिम ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006152077, "chapter_id": 26152, "verse_number": "१-२-१३-७८", "content_sanskrit": "चक्रो बलाहकश्चैव मैनाको यश्च पर्वतः ।\nआयतास्ते महाशैलाः समुद्रं दक्षिणं प्रति ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006152078, "chapter_id": 26152, "verse_number": "१-२-१३-७९", "content_sanskrit": "चक्रमैनाकयोर्मध्य विदिशं दक्षिणां प्रति ।\nतत्र संवर्त्तको नाम सोऽग्निः पिबति तज्जलम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006152079, "chapter_id": 26152, "verse_number": "१-२-१३-८०", "content_sanskrit": "नाम्ना समुद्रवासस्तु और्वःस वडवामुखः ।\nद्वादशैते प्रविष्टा हि पर्वता लवणोदधिम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006152080, "chapter_id": 26152, "verse_number": "१-२-१३-८१", "content_sanskrit": "महेंद्रभयवित्रस्ताः पक्षच्छे दभयात्पुरा ।\nयदेतदॄश्यते चंद्रे श्वेते कृष्णशशाकृति ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006152081, "chapter_id": 26152, "verse_number": "१-२-१३-८२", "content_sanskrit": "भारतस्य तु वर्षस्य भेदास्ते नव कीर्त्तिताः ।\nइहोदितस्य दृश्यंते यथान्येऽन्यत्र चोदिते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006152082, "chapter_id": 26152, "verse_number": "१-२-१३-८३", "content_sanskrit": "उत्तरोत्तरमेतेषां वर्षमुद्दिश्यते गुणैः ।\nआरोग्यायुः प्रमाणानां धर्मतः कामतोऽर्थतः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006152083, "chapter_id": 26152, "verse_number": "१-२-१३-८४", "content_sanskrit": "समन्वितानि भूतानि पुण्यैरेतैस्तु भागशः ।\nवसंति नानाजातीनि तेषु वर्षेषु तानि वै ।\nइत्येषा धारयंतीदं पृथ्वी विश्वं जगत्स्थितम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]