[{"id": 2144740, "chapter_id": 4118, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2144741, "chapter_id": 4118, "verse_number": "१", "content_sanskrit": "पृच्छामि त्वां सञ्जय राजमध्ये यदब्रवीद् वाक्यमदीनसत्वः ।\nजनार्दनस्तात युधां प्रणेता दुरात्मनां जीवितच्छिन्महात्मा\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2144742, "chapter_id": 4118, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2144743, "chapter_id": 4118, "verse_number": "२", "content_sanskrit": "आगुल्फेभ्योऽपि संवीतः सर्वतोऽहं कृताञ्जलिः ।\nशुद्धान्तं प्राविशं राजन्नाख्यातो नरसिंहयोः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2144744, "chapter_id": 4118, "verse_number": "३", "content_sanskrit": "न चाभिमन्युर्न यमौ तं देशमभिजग्मतुः ।\nयत्र कृष्णौ च कृष्णा च सत्यभामा च भामिनी\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2144745, "chapter_id": 4118, "verse_number": "४", "content_sanskrit": "उभौ मध्वासवक्षीबौ वरचन्दनरूषितौ ।\nस्रग्विणौ वरवस्त्राङ्गौ वराभरणभूषितौ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2144746, "chapter_id": 4118, "verse_number": "५", "content_sanskrit": "नैकरत्नविचित्रं च काञ्चनं च वरासनम् ।\nनानास्तरणसंस्तीर्णं यत्रास्तां तौ नरर्षभौ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2144747, "chapter_id": 4118, "verse_number": "६", "content_sanskrit": "सत्याङ्कमुपधानं तु कृत्वा शेते जनार्दनः ।\nअर्जुनाङ्कगतौ पादौ केशवस्योपलक्षये\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2144748, "chapter_id": 4118, "verse_number": "७", "content_sanskrit": "अर्जुनस्य च कृष्णायाः शुभायाश्चाङ्गगावुभौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2144749, "chapter_id": 4118, "verse_number": "८", "content_sanskrit": "काञ्चनं पादपीठं तु पार्थो मे प्रादिशन्मुदा ।\nदासीभ्यामाहृतं मह्यं स्पृष्ट्वा भूमावुपाविशम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2144750, "chapter_id": 4118, "verse_number": "९", "content_sanskrit": "ऊर्ध्वरेखाङ्कितौ पादौ पार्थस्य शुभलक्षणौ ।\nपादपीठादपहृतौ धारयेतां वरस्त्रियौ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2144751, "chapter_id": 4118, "verse_number": "१०", "content_sanskrit": "न नूनं कल्मषं किञ्चिन्मम कर्मसु विद्यते ।\nस्त्रीरत्नाभ्यां समेतौ यन्मिथो मामभ्यभाषताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2144752, "chapter_id": 4118, "verse_number": "११", "content_sanskrit": "विस्मयो मे महानासीद् आस्रं मे बहुसङ्गतम् ।\nहृष्टानि चैव रोमाणि दृष्ट्वा तौ सहितावुभौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2144753, "chapter_id": 4118, "verse_number": "१२", "content_sanskrit": "श्यामौ बृहन्तौ तरुणौ नागाविव समुच्छ्रितौ ।\nएकशय्यागतौ दृष्ट्वा भयं मे महदाविशत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2144754, "chapter_id": 4118, "verse_number": "१३", "content_sanskrit": "ततो ह्यचिन्तयं तत्र दृष्ट्वा तौ पुरुषर्षभौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2144755, "chapter_id": 4118, "verse_number": "१४", "content_sanskrit": "सङ्कल्पो धर्मराजस्य नानवाप्योऽस्मि कश्चन ।\nनिर्देशगाविमौ यस्य नरनारायणावुभौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2144756, "chapter_id": 4118, "verse_number": "१५", "content_sanskrit": "सत्कृतश्चान्नपानाभ्यामहं वै लब्धसत्क्रियः ।\nअञ्जलिं मूर्ध्नि सन्धाय सन्देशं चाभ्यचोदयम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2144757, "chapter_id": 4118, "verse_number": "१६", "content_sanskrit": "धनुर्धरोचितेनाथ पाणिनैकं सुलक्षणम् ।\nपादमानाययत् पार्थ केशवस्य यशस्विनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2144758, "chapter_id": 4118, "verse_number": "१७", "content_sanskrit": "इन्द्रकेतुरिवोत्थाय दिव्याभरणभूषितः ।\nइन्द्रवीर्योपमः कृष्णः संविष्टो मां ह्यभाषत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2144759, "chapter_id": 4118, "verse_number": "१८", "content_sanskrit": "स वाचं वदतां श्रेष्ठ आददे वचनक्षमाम् ।\nदीपनीं धार्तराष्ट्राणां मृदुपूर्वां सुदारुणाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2144760, "chapter_id": 4118, "verse_number": "१९", "content_sanskrit": "बहिश्चरस्य प्राणस्य प्रियस्य प्रियकारिणः ।\nमतिमान् मतिमास्थाय केशवः सन्दधे वचः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2144761, "chapter_id": 4118, "verse_number": "२०", "content_sanskrit": "वचनं वचनज्ञस्य शिक्षाक्षरसमन्वितम् ।\nमनःप्रह्लादमश्रौषं पश्चाद् हृदयतापनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2144762, "chapter_id": 4118, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2144763, "chapter_id": 4118, "verse_number": "२१", "content_sanskrit": "सञ्जयैतद् वचो ब्रूयाः प्राप्य क्षत्रियसंसदम् ।\nछन्दतः कुरुवृद्धस्य आचार्यस्य च धीमतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2144764, "chapter_id": 4118, "verse_number": "२२", "content_sanskrit": "अर्थांस्त्यजत पात्रेषु सुखमाप्नुत कामजम् ।\nप्रियं प्रियेभ्यश्चरत राजा हि त्वरते जये\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2144765, "chapter_id": 4118, "verse_number": "२३", "content_sanskrit": "यजध्वं विविधैर्यज्ञैर्दक्षिणाश्च प्रयच्छत ।\nपुत्रैर्दारैश्च मोदध्वमागतं वो महद्भयम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2144766, "chapter_id": 4118, "verse_number": "२४", "content_sanskrit": "गोविन्देति यदाक्रन्दत् कृष्णा मां दूरवासिनम् ।\nऋणं प्रवृद्धमिव मे हृदयान्नापसर्पति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2144767, "chapter_id": 4118, "verse_number": "२५", "content_sanskrit": "तेजोमयं दुराधर्षं बिभ्रता गाण्डिवं धनुः ।\nमद्द्वितीयेन पार्थेन वैरं वः प्रत्युपस्थितम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2144768, "chapter_id": 4118, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2144769, "chapter_id": 4118, "verse_number": "२६", "content_sanskrit": "कृष्णस्यैतद् वचः श्रुत्वा भयं मे महदाविशत् ।\nतव पुत्रस्य लोभं च वर्धमानं प्रपश्यतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2144770, "chapter_id": 4118, "verse_number": "२७", "content_sanskrit": "सोऽयमिन्द्रसमौ वीरौ तौ मन्दो नावबुध्यते ।\nभीष्मद्रोणाश्रयाच्चैव कर्णस्य च विकत्थनात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2144771, "chapter_id": 4118, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनपञ्चाशोऽध्यायः ॥४९॥ व्यासाभिगमनपर्वणि द्वितीयोऽध्यायः ॥२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]