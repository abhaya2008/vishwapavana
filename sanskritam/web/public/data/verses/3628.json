[{"id": 2122422, "chapter_id": 3628, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122423, "chapter_id": 3628, "verse_number": "१", "content_sanskrit": "वसन् दुर्योधनस्तस्यां सभायां भरतर्षभ ।\nशनैर्ददर्श तां सर्वां सभां शकुनिना सह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122424, "chapter_id": 3628, "verse_number": "२", "content_sanskrit": "तस्यां दिव्यानभिप्रायान् ददर्श कुरुनन्दनः ।\nअदृष्टपूर्वा ये तेन नगरे नागसाह्वये ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122425, "chapter_id": 3628, "verse_number": "३", "content_sanskrit": "स कदाचित् सभामध्ये धार्तराष्ट्रो महीपतिः ।\nस्फाटिकं स्थलमासाद्य जलमित्यभिशङ्कया ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122426, "chapter_id": 3628, "verse_number": "४", "content_sanskrit": "स्ववस्त्रोत्कर्षणं राजन् कृतवान् बुद्धिमोहितः ।\nदुर्मना विमुखश्चापि परिचक्राम तां सभाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122427, "chapter_id": 3628, "verse_number": "५", "content_sanskrit": "तत्र स्फाटिकतोयां वै स्फाटिकम्बुजशोभिताम् ।\nवापीं मत्वा स्थलमिति सवासाः प्रापतज्जले ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122428, "chapter_id": 3628, "verse_number": "६", "content_sanskrit": "जले निपतितं दृष्ट्वा किङ्करा जहसुर्भुशम् ।\nतस्य चान्यानि वासांसि प्रददू राजशासनात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122429, "chapter_id": 3628, "verse_number": "७", "content_sanskrit": "तं वै तथागतं तत्र द्रौपदी भीम एव च ।\nअर्जुनश्च यमौ सर्वे दृष्ट्वा च प्राहसंस्तदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122430, "chapter_id": 3628, "verse_number": "८", "content_sanskrit": "नामर्षयत् ततस्तेषामपहासममर्षणः ।\nआकारं रक्षमाणस्तु न स तान् समुदैक्षत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122431, "chapter_id": 3628, "verse_number": "९", "content_sanskrit": "पुनर्वसनमुत्क्षिप्य प्रतरिष्यन्निव स्थलम् ।\nआरुरोह ततः सर्वे जहसुश्च पुनर्जनाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122432, "chapter_id": 3628, "verse_number": "१०", "content_sanskrit": "द्वारं च पिहिताकारं स्फाटिकं प्रेक्ष्य भूमिपः ।\nप्रविशन्नाहतो मूर्ध्नि व्याघूर्ण्णित इव स्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122433, "chapter_id": 3628, "verse_number": "११", "content_sanskrit": "तद् वृत्तमपरं द्वारं स्फाटिकोरुकवाटकम् ।\nविघट्टयन् कराभ्यां तु निष्क्रम्याग्रे पपात ह ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122434, "chapter_id": 3628, "verse_number": "१२", "content_sanskrit": "द्वारं च विकृताकारं ललाटेन समाहनत् ।\nसंवृतं चेति मन्वानो द्वारदेशादपागमत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122435, "chapter_id": 3628, "verse_number": "१३", "content_sanskrit": "एवं प्रलम्भान् विविधान् प्राप्य तत्र विशाम्पते ।\nपाण्डवैरननुज्ञातस्ततो दुर्योधनो नृपः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122436, "chapter_id": 3628, "verse_number": "१४", "content_sanskrit": "अप्रहृष्टेन मनसा राजसूये महाक्रतौ ।\nप्रेक्ष्य तामद्भुतामृद्धिं जगाम गजसाह्वयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122437, "chapter_id": 3628, "verse_number": "१५", "content_sanskrit": "नतुष्टो धर्मराजस्य यज्ञमासाद्य तं तदा ।\nजगाम स्वगृहं त्वन्यद् ऋते दुर्योधनस्तदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122438, "chapter_id": 3628, "verse_number": "१६", "content_sanskrit": "दृष्ट्वा यज्ञविभूतिं तां पाण्डवानां महस्विनाम् ।\nपाण्डवश्रीप्रतप्तस्य ध्यानम्लानस्य गच्छतः ।\nदुर्योधनस्य नृपते पापा मतिरजायत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2122439, "chapter_id": 3628, "verse_number": "१७", "content_sanskrit": "पार्थान् सुमनसो दृष्ट्वा पार्थिवांश्च वशानुगान् ।\nकृत्स्नं चापि हितं लोकमाकुमारं कुरूद्वह ।\nदुर्योधनः पापबुद्धिः पर्यतप्यत मन्युना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2122440, "chapter_id": 3628, "verse_number": "१८", "content_sanskrit": "स तु गच्छन्ननेकाग्रः सभामेवानुचिन्तयन् ।\nश्रियं च तामनुपमां धर्मराजस्य धीमतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2122441, "chapter_id": 3628, "verse_number": "१९", "content_sanskrit": "प्रमत्तो धृतराष्ट्रस्य पुत्रो दुर्योधनस्तदा ।\nनाभ्यभाषत् सुबलजं भाष्यमाणः पुनः पुनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2122442, "chapter_id": 3628, "verse_number": "२०", "content_sanskrit": "तं तु दुर्मनसं दृष्ट्वा शकुनिः प्रत्यभाषत ।\nदुर्योधन कुतोमूलं निःश्वसन्निव गच्छसि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2122443, "chapter_id": 3628, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2122444, "chapter_id": 3628, "verse_number": "२१", "content_sanskrit": "दृष्ट्वेमां पृथिवीं सर्वां युधिष्ठिरवशे स्थिताम् ।\nजितामस्त्रप्रतापेन श्वेताश्वस्य महात्मनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2122445, "chapter_id": 3628, "verse_number": "२२", "content_sanskrit": "तं च यज्ञं तथारूपं दृष्ट्वा पार्थस्य मातुल ।\nयथा शक्रस्य देवानामीश्वरस्य तथाविधम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2122446, "chapter_id": 3628, "verse_number": "२३", "content_sanskrit": "अमर्षेण सुसम्पूर्णो दह्यमानो दिवानिशम् ।\nशुष्यते हृदयं मेऽद्य ग्रीष्मे तोयमिवाल्पकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2122447, "chapter_id": 3628, "verse_number": "२४", "content_sanskrit": "पश्य सात्वतमुख्येन शिशुपालो निपातितः ।\nन च तत्र पुमानासीत् कश्चित् तस्य पदानुगः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2122448, "chapter_id": 3628, "verse_number": "२५", "content_sanskrit": "क्षान्तं ततोऽपराधं न क्षोभितं कर्तुमर्हसि ।\nवासुदेवेन तत् कर्म यथाऽयुक्तं तथाकृतम् ।\nसिद्धिं च पाण्डवेयानां प्रभावेण महात्मनाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2122449, "chapter_id": 3628, "verse_number": "२६", "content_sanskrit": "तथा हि रत्नान्यादाय विविधानि नराधिपाः ।\nउपातिष्ठन्त कौन्तेयं वैश्या इव करप्रदाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2122450, "chapter_id": 3628, "verse_number": "२७", "content_sanskrit": "तं तथा ज्वलितां दृष्ट्वा श्रियं मातुल पाण्डवे ।\nअमर्षवशमापन्नो दह्येयमतथोचितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2122451, "chapter_id": 3628, "verse_number": "२८", "content_sanskrit": "एवं स निश्चयं कृत्वा ततो वचनमब्रवीत् ।\nपुनर्गान्धारनृपतिं दह्यमान इवाग्निना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2122452, "chapter_id": 3628, "verse_number": "२९", "content_sanskrit": "सोऽहमग्निं प्रवेक्ष्यामि भक्षयिष्यामि वा विषम् ।\nअपो वाऽपि प्रवेक्ष्यामि नहि शक्ष्यामि जीवितुम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2122453, "chapter_id": 3628, "verse_number": "३०", "content_sanskrit": "को हि नाम पुमान् लोके मर्षयिष्यति सत्ववान् ।\nसपत्नान् ऋद्ध्यतो दृष्ट्वा हानिमात्मन एव च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2122454, "chapter_id": 3628, "verse_number": "३१", "content_sanskrit": "सोऽहं नास्मि न नाप्यस्मि न स्त्री नच पुमानपि ।\nयोऽहं तां मर्षयाम्यद्य श्रियं तस्मिन्नशक्तितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2122455, "chapter_id": 3628, "verse_number": "३२", "content_sanskrit": "ईश्वरत्वं पृथिव्याश्च वसुमत्तां च तादृशीम् ।\nयज्ञं च तादृशं दृष्ट्वा मादृशः को न सञ्ज्वरेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2122456, "chapter_id": 3628, "verse_number": "३३", "content_sanskrit": "अशक्तश्चैक एवाहं तामाहर्तुं ततः श्रियम् ।\nसहायांश्च न पश्यामि तेन मृत्युं विचिन्तये ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2122457, "chapter_id": 3628, "verse_number": "३४", "content_sanskrit": "दैवमेव परं मन्ये पौरुषं तु निरर्थकम् ।\nदृष्ट्वा कुन्तीसुते शुभ्रां श्रियं तामाहृतां नयात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2122458, "chapter_id": 3628, "verse_number": "३५", "content_sanskrit": "कृतो यत्नो मया पूर्वं विनाशे तस्य सौबल ।\nतच्च सर्वं वृथा जातं स च वृद्धो महाबलः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2122459, "chapter_id": 3628, "verse_number": "३६", "content_sanskrit": "तेन दैवं परं मन्ये पौरुषं तु निरर्थकम् ।\nधार्तराष्ट्रा हि हीयन्ते वर्धन्ते पापिपाण्डवाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2122460, "chapter_id": 3628, "verse_number": "३७", "content_sanskrit": "सोऽहं श्रियं च तां दृष्ट्वा सभां चैव तथाविधाम् ।\nरक्षिभिश्चापहासं तं परितप्ये यथाऽग्निना ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2122461, "chapter_id": 3628, "verse_number": "३८", "content_sanskrit": "स मामभ्यनुजानीहि मातुलाद्य सुदुःखितम् ।\nअमर्षवशमापन्नं धृतराष्ट्रे निवेदय ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2122462, "chapter_id": 3628, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2122463, "chapter_id": 3628, "verse_number": "३९", "content_sanskrit": "दुर्योधन न तेऽमर्षः कार्यः प्रति युधिष्ठिरम् ।\nभागधेयानि हि स्वानि पाण्डवाः समुपाश्नुते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2122464, "chapter_id": 3628, "verse_number": "४०", "content_sanskrit": "तथाऽप्युपायैर्बहुभिः समारब्धास्त्वयाऽसकृत् ।\nविमुक्ताश्च नरव्याघ्रा भागधेयपुरस्कृताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2122465, "chapter_id": 3628, "verse_number": "४१", "content_sanskrit": "तैर्लब्धा द्रौपदी भार्या द्रुपदश्च सुतैः सह ।\nसहायाः पृथिवीपाला वासुदेवश्च वीर्यवान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2122466, "chapter_id": 3628, "verse_number": "४२", "content_sanskrit": "अजितः सोऽपि सर्वैर्हि सदेवासुरमानुषैः ।\nतत्तेजसा प्रवृद्धोऽसौ तत्र का परिदेवना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2122467, "chapter_id": 3628, "verse_number": "४३", "content_sanskrit": "लब्धश्च तैर्हि भूयोऽर्थः पित्र्योंशः पृथिवीपते ।\nविवृद्धस्तेजसा तेषां तत्र का परिदेवना ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2122468, "chapter_id": 3628, "verse_number": "४४", "content_sanskrit": "धनञ्जयेन गाण्डीवमक्षय्यौ च महेषुधी ।\nलब्धान्यस्त्राणि दिव्यानि तर्पयित्वा हुताशनम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2122469, "chapter_id": 3628, "verse_number": "४५", "content_sanskrit": "तेन कार्मुकमुख्येन बाहुवीर्येण चात्मनः ।\nकृता वशे महीपालास्तत्र का परिदेवना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2122470, "chapter_id": 3628, "verse_number": "४६", "content_sanskrit": "अयं दाहान्मयं नाम मोक्षयित्वा च दानवम् ।\nसभां तां कारयामास सव्यसाची परन्तपः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2122471, "chapter_id": 3628, "verse_number": "४७", "content_sanskrit": "तेनैव च मयेनोक्ताः किङ्करा नाम राक्षसाः ।\nवहन्ति तां सभां भीमास्तत्र का परिदेवना ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2122472, "chapter_id": 3628, "verse_number": "४८", "content_sanskrit": "यच्चासहायतां राजन्नुक्तवानसि भारत ।\nतन्मिथ्या भ्रातरो हीमे सहायास्ते महारथाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2122473, "chapter_id": 3628, "verse_number": "४९", "content_sanskrit": "द्रोणस्तव महेष्वासः सह पुत्रेण वीर्यवान् ।\nसूतपुत्रस्तु राधेयो दृढं मित्रं महारथः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2122474, "chapter_id": 3628, "verse_number": "५०", "content_sanskrit": "स एकः समरे सर्वान् पाण्डवान् सहसोमकान् ।\nविजेष्यति महाबाहो किं सहायैः करिष्यसि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2122475, "chapter_id": 3628, "verse_number": "५१", "content_sanskrit": "भीष्मश्च पुरुषव्याघ्रो गौतमश्च महारथः ।\nजयद्रथश्च बलवान् कृतास्त्रो दृढविक्रमः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2122476, "chapter_id": 3628, "verse_number": "५२", "content_sanskrit": "अहं च सह सोदर्यैः सौमदत्तिश्च कौरव ।\nएतैस्त्वं सहितः सर्वैर्जय सर्वां वसुन्धराम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2122477, "chapter_id": 3628, "verse_number": "५३", "content_sanskrit": "त्वया च सहितो राजन्नेतैश्चान्यैर्महारथैः ।\nएकाह्नाऽहं विजेष्यामि यदि त्वमनुमन्यसे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2122478, "chapter_id": 3628, "verse_number": "५४", "content_sanskrit": "एतेषु विजितेष्वद्य भविष्यति मही तव ।\nसर्वे च पृथिवीपालाः सभा सा च महाधना ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2122479, "chapter_id": 3628, "verse_number": "५५", "content_sanskrit": "धनञ्जयो वासुदेवो भीमसेनो युधिष्ठिरः ।\nनकुलः सहदेवश्च द्रुपदश्च सहात्मजैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2122480, "chapter_id": 3628, "verse_number": "५६", "content_sanskrit": "नैते युधि बलाज्जेतुं शक्याः सुरगणैरपि ।\nमहारथा महेष्वासाः कृतास्त्रा युधि दुर्मदाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2122481, "chapter_id": 3628, "verse_number": "५७", "content_sanskrit": "अहं तु तद् विजानामि विजेतुं येन शक्यते ।\nयुधिष्ठिरं तु राजेन्द्रं तन्निबोध जनेश्वर ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2122482, "chapter_id": 3628, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2122483, "chapter_id": 3628, "verse_number": "५८", "content_sanskrit": "अप्रमादेन शत्रूणाम् अन्येषां च महीक्षिताम् ।\nयथा शक्ष्यसि तं जेतुं तन्ममाचक्ष्व मातुल ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2122484, "chapter_id": 3628, "verse_number": "", "content_sanskrit": "शकुनिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2122485, "chapter_id": 3628, "verse_number": "५९", "content_sanskrit": "द्यूतप्रियश्च कौन्तेयो न च जानाति देवितुम् ।\nसमाहूतश्च कौन्तेयो न शक्ष्यति निवर्तितुम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2122486, "chapter_id": 3628, "verse_number": "६०", "content_sanskrit": "देवने कुशलश्चाहं न मेऽस्ति सदृशो भुवि ।\nत्रिषु लोकेषु कौन्तयं तं त्वं द्यूते समाह्वय ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2122487, "chapter_id": 3628, "verse_number": "६१", "content_sanskrit": "अनक्षकुशलाद्राज्यमादास्यामि न संशयः ।\nराज्यं श्रियं सभां दीप्तां त्वदर्थं पुरुषर्षभ ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2122488, "chapter_id": 3628, "verse_number": "६२", "content_sanskrit": "इदं हि सर्वं राज्ञे त्वं दुर्योधन निवेदय ।\nअनुज्ञातश्च ते पित्रा विजेष्यामि न संशयः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2122489, "chapter_id": 3628, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2122490, "chapter_id": 3628, "verse_number": "६३", "content_sanskrit": "त्वमेव धृतराष्ट्राय कुरुमुख्याय मातुल ।\nनिवेदय यथाकामं नाहं शक्ष्यामि शंसितुम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2122491, "chapter_id": 3628, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि सप्ततितमोऽध्यायः ॥७०॥\n॥ द्यूतपर्वणि द्वितीयोऽध्यायः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2122492, "chapter_id": 3628, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]