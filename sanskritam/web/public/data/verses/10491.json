[{"id": 50001403, "chapter_id": 10491, "verse_number": "1", "content_sanskrit": "“अवरेभ्योऽपि शृण्वन्ति परमाश्च क्वचित्क्वचित्। लीलयैव नचैतेषां परमत्वं विहीयते॥” इति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50001404, "chapter_id": 10491, "verse_number": "2", "content_sanskrit": "॥ इति वंशब्राह्मणम्॥ ६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50001405, "chapter_id": 10491, "verse_number": "3", "content_sanskrit": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते श्रीमद्बृहदारण्यकोपनिषद्भाष्ये षष्ठोध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50001406, "chapter_id": 10491, "verse_number": "4", "content_sanskrit": "॥ सप्तमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]