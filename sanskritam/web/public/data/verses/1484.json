[{"id": 2022807, "chapter_id": 1484, "verse_number": "३-१२२-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022808, "chapter_id": 1484, "verse_number": "३-१२२-१", "content_sanskrit": "गयेन यजमानेन सोमेनेह पुरंदरः।\nतर्पित श्रूयते राजन्स तृप्तो मुदमभ्यगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022809, "chapter_id": 1484, "verse_number": "३-१२२-२", "content_sanskrit": "इह देवैः सहेन्द्रैश्च प्रजापतिभिरेव च।\nइष्टं बहुविधैर्यज्ञैर्महद्भिर्भूरिदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022810, "chapter_id": 1484, "verse_number": "३-१२२-३", "content_sanskrit": "आधूर्तरजसश्चेह राजा वज्रधरं प्रभुः।\nतर्पयामास सोमेन हयमेधेषु सप्तसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022811, "chapter_id": 1484, "verse_number": "३-१२२-४", "content_sanskrit": "तस्य सप्तसु यज्ञेषु सर्वमासीद्धिरण्ययम्।\nवानप्रस्थं च भौमं च यद्द्रव्यं नियतं मखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022812, "chapter_id": 1484, "verse_number": "३-१२२-५", "content_sanskrit": "चषालयूपचमसाः स्थाल्यः पात्र्यः स्रुचः स्रुवाः।\nतेष्वेव चास्य यज्ञेषु प्रयोगाः सप्त विश्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022813, "chapter_id": 1484, "verse_number": "३-१२२-६", "content_sanskrit": "सप्तैकैकस्ययूपस्य चषालाश्चोपरिश्थिताः।\nतस्य स्म यूपान्यज्ञेषु भ्राजमानान्हिरण्मयान्।\nस्वयमुत्थापयामासुर्देवाः सेन्द्रा युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022814, "chapter_id": 1484, "verse_number": "३-१२२-७", "content_sanskrit": "तेषु तस्य मखाग्र्येषु गयस्य पृथिवीपतेः।\nअमाद्यदिन्द्रः सोमेन दक्षिणाभिर्द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022815, "chapter_id": 1484, "verse_number": "३-१२२-८", "content_sanskrit": "प्रसङ्ख्यानानसङ्ख्येयान्प्रत्यगृह्णन्द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022816, "chapter_id": 1484, "verse_number": "३-१२२-९", "content_sanskrit": "सिकता वा यथा लोके यथावा दिवि तारकाः।\nयथा वा वर्षतो धारा असङ्ख्येयाः स्म केनचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022817, "chapter_id": 1484, "verse_number": "३-१२२-१०", "content_sanskrit": "तथैव तदसङ्ख्येयं धनं यत्प्रददौ गयः।\nसदस्येभ्यो महाराज तेषु यज्ञेषु सप्तसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022818, "chapter_id": 1484, "verse_number": "३-१२२-११", "content_sanskrit": "भवेत्सङ्ख्येयमेतद्धि यदेतत्परिकीर्तितम्।\nन तस्य शक्याः सङ्ख्यातुं दक्षिणादक्षिणावतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022819, "chapter_id": 1484, "verse_number": "३-१२२-१२", "content_sanskrit": "हिरण्मयीभिर्गोभिश्च कृताभिर्विश्वकर्मणा।\nब्राह्मणांस्तर्पयामास नानादिग्भ्यः समागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022820, "chapter_id": 1484, "verse_number": "३-१२२-१३", "content_sanskrit": "अल्पावशेषा पृथिवी चैत्यैरासीत्समाचिता।\nगयस्य यजमानस्य तत्रतत्र विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022821, "chapter_id": 1484, "verse_number": "३-१२२-१४", "content_sanskrit": "स लोकान्प्राप्तवैनैन्द्रान्कर्मणा तेन भरत।\nसलोकतां तस्य गच्छेत्पयोष्ण्यां य उपस्पृशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022822, "chapter_id": 1484, "verse_number": "३-१२२-१५", "content_sanskrit": "तरस्मात्त्वमत्र राजेनद्र भ्रातृभिः सहितोच्युत।\nउपस्पृश्य महीपाल धूतपाप्मा भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022823, "chapter_id": 1484, "verse_number": "३-१२२-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022824, "chapter_id": 1484, "verse_number": "३-१२२-१६", "content_sanskrit": "स पयोष्ण्यां नरश्रेष्ठः स्नात्वा वै भ्रातृभिः सह।\nवैदूर्यपर्वतं चैव नर्मदां च महानदीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022825, "chapter_id": 1484, "verse_number": "३-१२२-१७", "content_sanskrit": "`उद्दिश्य पाण्डवश्रेष्ठः स प्रतस्थे महीपतिः।\nसमागमत तेजस्वी भ्रातृभिः सहितो नघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022826, "chapter_id": 1484, "verse_number": "३-१२२-१८", "content_sanskrit": "तत्रास्य सर्वाण्याचख्यौ लोमशो भगवानृषिः।\nतीर्थानि रमणीयानि पुण्यान्यायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022827, "chapter_id": 1484, "verse_number": "३-१२२-१९", "content_sanskrit": "यथायोगं यथाप्रीति प्रययौ भ्रातृभिः सह।\nतत्रतत्राददद्वित्तं ब्राह्मणेभ्यः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022828, "chapter_id": 1484, "verse_number": "३-१२२-२०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022829, "chapter_id": 1484, "verse_number": "३-१२२-२०", "content_sanskrit": "देवानामेति कौन्तेय तथा राज्ञां सलोकताम्।\nवेदूर्यपर्वतं दृष्ट्वा नर्मदामवतीर्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022830, "chapter_id": 1484, "verse_number": "३-१२२-२१", "content_sanskrit": "सन्धिरेष नरश्रेष्ठ त्रेताया द्वापरस्य च।\nएनमासाद्य कौन्तेय सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022831, "chapter_id": 1484, "verse_number": "३-१२२-२२", "content_sanskrit": "एष शर्यातियज्ञस्य देशस्तात प्रकाशते।\nसाक्षाद्यत्रापिबत्सोममश्विभ्यां सह वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022832, "chapter_id": 1484, "verse_number": "३-१२२-२३", "content_sanskrit": "चुकोप भार्गवश्चापि महेन्द्रस् महातपाः।\nसंस्तम्भयामास च तं वासवं च्यवनः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022833, "chapter_id": 1484, "verse_number": "३-१२२-२४", "content_sanskrit": "सुकन्यां चापि भार्यां स राजपुत्रीमवाप्तवान्।\n`नासत्यौ च महाभाग कृतवान्सोमपीथिवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022834, "chapter_id": 1484, "verse_number": "३-१२२-२५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022835, "chapter_id": 1484, "verse_number": "३-१२२-२५", "content_sanskrit": "कथं विष्टम्भितस्तेन भगवान्पाकशासनः।\nकिमर्थं भार्गवश्चापि कोपं चक्रे महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022836, "chapter_id": 1484, "verse_number": "३-१२२-२६", "content_sanskrit": "नासत्यौ च कथं ब्रह्मन्कृतवान्सोमपीथिनौ।\nएतत्सर्वं यथावृत्तमाख्यातु भगवान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022837, "chapter_id": 1484, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि द्वाविंशत्यधिकशततमोऽध्यायः ॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]