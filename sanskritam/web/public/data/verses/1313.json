[{"id": 2014998, "chapter_id": 1313, "verse_number": "२-५४-१", "content_sanskrit": "भीष्म उवाच॥\nततस्तौ जग्मतुस्तत्र गुरुं सान्दीपिनिं पुनः।\nगुरुशुश्रूषणायुक्तौ धर्मज्ञौ धर्मचारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014999, "chapter_id": 1313, "verse_number": "२-५४-२", "content_sanskrit": "व्रतमुग्रं महात्मानौ विचरन्ताववन्तिषु।\nअहोरात्रैश्चतुष्पष्ट्या साङ्गान्वेदानवापतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015000, "chapter_id": 1313, "verse_number": "२-५४-३", "content_sanskrit": "लेख्यं च गणितं चोभौ प्राप्नुतां यदुनन्दनौ।\nगान्धर्ववेदं वैद्यं च सकलं समावापतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015001, "chapter_id": 1313, "verse_number": "२-५४-४", "content_sanskrit": "हस्तिशिक्षामश्विशिक्षां द्वादशाहेन चाप्नुताम्।\nतावुभौ जग्मतुर्वीरौ गुरुं सान्दीपिनिं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015002, "chapter_id": 1313, "verse_number": "२-५४-५", "content_sanskrit": "धनुर्वेदचिकीर्षार्थं धर्मज्ञौ धर्मचारिणौ।\nताविष्वासवराचार्यमभिगम्य प्रणम्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015003, "chapter_id": 1313, "verse_number": "२-५४-६", "content_sanskrit": "तेन वै सत्कृतौ राजंश्चरन्तौ ताववन्तिषु।\nपञ्चाशद्भिरहोरात्रैर्दशाङ्गं सुप्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015004, "chapter_id": 1313, "verse_number": "२-५४-७", "content_sanskrit": "सरहस्यं धनुर्वेदं सकलं ताववापतुः।\nदृष्ट्वा कृतार्थो विप्रेन्द्रो गुर्वर्थे तावचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015005, "chapter_id": 1313, "verse_number": "२-५४-८", "content_sanskrit": "अयाचतार्थं गोविन्दं तदा सान्दीपिनिर्विभुम्।\nमम पुत्रः समुद्रेऽस्मिंस्तिमिना चापवाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015006, "chapter_id": 1313, "verse_number": "२-५४-९", "content_sanskrit": "पुत्रमानय भद्रं ते भक्षितं तिमिना मम।\nआर्ताय गुरवे तत्र प्रतिशुश्राव दुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015007, "chapter_id": 1313, "verse_number": "२-५४-१०", "content_sanskrit": "अशक्यं सर्वभूतेषु कर्तुमन्येन केनचित्।\nयश्च सान्दीपिनेः पुत्रं जहार भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015008, "chapter_id": 1313, "verse_number": "२-५४-११", "content_sanskrit": "सोऽसुरः समरे ताभ्यां समुद्रे विनिपातितः।\nततः सान्दीपिनेः पुत्रः प्रसादादमितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015009, "chapter_id": 1313, "verse_number": "२-५४-१२", "content_sanskrit": "दीर्घकालं कृतः प्रेतः पुनरासीच्छरीरवान्।\nतदशक्यमचिन्त्यं च दृष्ट्वा सुमहदद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015010, "chapter_id": 1313, "verse_number": "२-५४-१३", "content_sanskrit": "सर्वेषामेव भूतानां विस्मयः समजायत।\nआसनानि च सर्वाणि गवाश्वं च धनादिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015011, "chapter_id": 1313, "verse_number": "२-५४-१४", "content_sanskrit": "सर्वं तदुपजहाते गुरवे रामकेशवौ।\nगदापरिघयुद्धे च सर्वास्त्रेषु च केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015012, "chapter_id": 1313, "verse_number": "२-५४-१५", "content_sanskrit": "परमां मुख्यतां प्राप्तः सर्वलोकेषु विश्रुतः।\nकश्च नारायणादन्यः सर्वरत्नविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015013, "chapter_id": 1313, "verse_number": "२-५४-१६", "content_sanskrit": "रथमादित्यसङ्काशमातिष्ठेत शचीपतेः।\nकस्य चाप्रतिमो यन्ता वज्रपाणेः प्रियः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015014, "chapter_id": 1313, "verse_number": "२-५४-१७", "content_sanskrit": "मातलिः सङ्गृहीता स्यादन्यत्र पुरुषोत्तमात्।\nभोजराजात्मजो वापि कंसस्तात युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015015, "chapter_id": 1313, "verse_number": "२-५४-१८", "content_sanskrit": "अस्त्रजाते बले वीर्ये कार्तवीर्यसमोऽभवत्।\nतस्य भोजपतेः पुत्राद्भोजराजन्यवर्धनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015016, "chapter_id": 1313, "verse_number": "२-५४-१९", "content_sanskrit": "उद्विजन्ते स्म राजानः सुपर्णादिव पन्नगाः।\nचित्रकार्मुकनिस्त्रिंशविमलप्रासयोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015017, "chapter_id": 1313, "verse_number": "२-५४-२०", "content_sanskrit": "शतं शतसहस्राणि पादातास्तस्य भारत।\nअष्टौ शतसहस्राणि शूराणामनिवर्तिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015018, "chapter_id": 1313, "verse_number": "२-५४-२१", "content_sanskrit": "अभवन्भोजराजस्य जाम्बूनदमया ध्वजाः।\nरुक्मकाञ्चनकक्ष्यास्तु रथास्तस्य युधिष्ठि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015019, "chapter_id": 1313, "verse_number": "२-५४-२२", "content_sanskrit": "अभवन्भोजपुत्रस्य द्विपास्तावद्धि तद्बलम्।\nचित्रकार्मुकनिस्त्रिंशविमलप्रासयोधिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015020, "chapter_id": 1313, "verse_number": "२-५४-२३", "content_sanskrit": "षोडशाश्वसहस्राणि किंशुकाभानि तस्य वै।\nअपरस्तु महाव्यूहः किशोरणां युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015021, "chapter_id": 1313, "verse_number": "२-५४-२४", "content_sanskrit": "आरोहवरसम्पन्नो दुर्धर्षः केनचिद्बलान्।\nस च षोडशसाहस्रः कंसभ्रातृपुरः सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015022, "chapter_id": 1313, "verse_number": "२-५४-२५", "content_sanskrit": "सुनामा सर्वतस्त्वेनं स कंसं पर्यपालयत्।\nसगणो मिश्रको नाम षष्टिमसाहस्र उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015023, "chapter_id": 1313, "verse_number": "२-५४-२६", "content_sanskrit": "कंसरोषमहावेगां वैवस्वतवशानुगाम्॥\nमत्तद्विपमहाग्राहां वैवस्वतवशानुगाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015024, "chapter_id": 1313, "verse_number": "२-५४-२७", "content_sanskrit": "शस्रजालमहाफेनां सादिवेगमहाजलाम्।\nगदापरिघपाठीनां नानाकवचशैवलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015025, "chapter_id": 1313, "verse_number": "२-५४-२८", "content_sanskrit": "रथनागमहावर्तां नानारुधिरकर्दमाम्।\nचित्रकार्मुककल्लोलां रथाश्वकलिलह्रदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015026, "chapter_id": 1313, "verse_number": "२-५४-२९", "content_sanskrit": "महामृधनदीं घोरां योधावर्तननिस्वनाम्।\nकोऽन्यो नारायणादेत्य कंसहन्ता युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015027, "chapter_id": 1313, "verse_number": "२-५४-३०", "content_sanskrit": "एष शक्ररथे तिष्ठंस्तान्यनीकानि भारत।\nव्यधमद्भोजपुत्रस्य महाभ्राणीव मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015028, "chapter_id": 1313, "verse_number": "२-५४-३१", "content_sanskrit": "तं सभास्थं सहामात्यं हत्वा कंसं सहान्वयम्।\nआनयामास मानार्हां देवकीं समुहृद्गणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015029, "chapter_id": 1313, "verse_number": "२-५४-३२", "content_sanskrit": "यशोदां रोहिणीं चैव अभिवाद्य पुनः पुनः।\nउग्रसेनं च राजानमभिषिच्य जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015030, "chapter_id": 1313, "verse_number": "२-५४-३३", "content_sanskrit": "अर्चितो यदुमुख्यैश्च भगवान्वासवानुजः।\nततः पार्थिवमायान्तं सहितं सर्वराजभिः।\nसरस्वत्यां जरासन्धमजयत्पुरुषोत्तमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015031, "chapter_id": 1313, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि चतुः पञ्चाशोऽध्यायः॥ ५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]