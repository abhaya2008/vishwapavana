[{"id": 40019263, "chapter_id": 9307, "verse_number": "1", "content_sanskrit": "एवमुक्तातुवैदेहिपरुषंरोमहर्षणम् । राघवेणसरोषेणश्रुत्वाप्रव्यथिताऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019264, "chapter_id": 9307, "verse_number": "2", "content_sanskrit": "सातदश्रुतपूर्वंहिजनेमहतिमैथिली । श्रुत्वाभर्तृर्वचोरूक्षंलज्जयावनताभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019265, "chapter_id": 9307, "verse_number": "3", "content_sanskrit": "प्रविशन्तीवगात्राणिस्वानिसाजनकात्मजा । वाक्षरैस्स्सैःसशल्येवभृशमाश्रूण्यवर्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019266, "chapter_id": 9307, "verse_number": "4", "content_sanskrit": "ततोबाष्पपरिक्लिन्नंप्रमार्जन्तीस्वमाननम् । शनैर्गद्गदयावाचाभर्तारमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019267, "chapter_id": 9307, "verse_number": "5", "content_sanskrit": "किंमामसदृशंवाक्यमीदृशंश्रोत्रदारुणम् । रूक्षंश्रावयसेवीर प्राकृतःप्राकृतमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019268, "chapter_id": 9307, "verse_number": "6", "content_sanskrit": "न तथास्मिमहाबाहो यथामामवगच्छसि । प्रत्ययंगच्छमेस्वेनचारित्रेणैवतेशपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019269, "chapter_id": 9307, "verse_number": "7", "content_sanskrit": "पृथकस्त्रीणांप्रचारेणजातिंत्वंपरिशङ्कसे । परित्यजैनांशङ्कांतुयदितेऽहंपरीक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019270, "chapter_id": 9307, "verse_number": "8", "content_sanskrit": "यदहंगात्रसम्पर्शंगतास्मिविशवाप्रभो । कामकारो न मेतत्रदैवंतत्रापराध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019271, "chapter_id": 9307, "verse_number": "9", "content_sanskrit": "मदधीनंतुयत्तन्मेहृदयंत्वयिवर्तते । पराधीनेषुगात्रेषुकिंकरिष्याम्यनीश्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019272, "chapter_id": 9307, "verse_number": "10", "content_sanskrit": "सहसम्वृद्धभावेनसंसर्गेण च मानद । यदितेऽहं न विज्ञाताहतातेनास्मिशाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019273, "chapter_id": 9307, "verse_number": "11", "content_sanskrit": "प्रेषितस्तेमहावीरोहनुमानवलोककः । लङ्कास्थाहंत्वयाराजन्किंतदा न विसर्जिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019274, "chapter_id": 9307, "verse_number": "12", "content_sanskrit": "प्रत्यक्षंवानरस्यास्यतद्वाक्यसमनन्तरम् । त्वयासन्त्यक्तयावीरत्यक्तंस्याजजीवितंमया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019275, "chapter_id": 9307, "verse_number": "13", "content_sanskrit": "न वृथातेश्रमोऽयंस्यात्संशयेन्यस्यजीवितम् । सुहृज्जनपरिक्लेशो न चायंविपुलस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019276, "chapter_id": 9307, "verse_number": "14", "content_sanskrit": "त्वयातुनृपशार्दूलदोषमेवानुवर्तता । लघुनेवमनुष्येणस्त्रीत्वमेवपुरस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019277, "chapter_id": 9307, "verse_number": "15", "content_sanskrit": "अपदेशेनजनकादुत्पततिर्वसुथातलात् । ममवृत्तं च वृत्तज्ञबहुते न पुरस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019278, "chapter_id": 9307, "verse_number": "16", "content_sanskrit": "न प्रमाणीकृतंपाणिर्भाल्येममनिपीडितः । ममभक्तिश्चशीलं च सर्वंतेपृष्ठतःकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019279, "chapter_id": 9307, "verse_number": "17", "content_sanskrit": "इतिब्रुवन्तीरुदतीबाष्पगद्गगभाषिणी । उवाचलक्ष्मणंसीतादीनंध्यानपरायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019280, "chapter_id": 9307, "verse_number": "18", "content_sanskrit": "चितांमेकुरुसौमित्रेव्यवनस्यास्यभेषजम् । मिध्यापवादोपहतानाहंजीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019281, "chapter_id": 9307, "verse_number": "19", "content_sanskrit": "अप्रीतेनगुणैर्भर्त्रात्यक्तायाजनसंसदि । याक्षमामेगतिर्गन्तुंप्रवेक्ष्येहव्यवाहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019282, "chapter_id": 9307, "verse_number": "20", "content_sanskrit": "एवमुक्तस्तुवैदेह्यालक्ष्मणःपरवीरहा । अमर्षवशमापन्नोराघवंसमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019283, "chapter_id": 9307, "verse_number": "21", "content_sanskrit": "स विज्ञायततश्छन्दंरामस्याकारसूचितम् । चितांचकारसौमित्रिर्मतेरामस्यवीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019284, "chapter_id": 9307, "verse_number": "22", "content_sanskrit": "नहिरामंतदाकश्चित्कालान्तकयमोपमम् । अनुनेतुमथोवक्तुंद्रष्टुंवाप्यशकत्सुहृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019285, "chapter_id": 9307, "verse_number": "23", "content_sanskrit": "अधोमुखंस्थितंरामंततःकृत्वाप्रदक्षिणम् । उपावर्ततवैदेहीदीप्यमानंहुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019286, "chapter_id": 9307, "verse_number": "24", "content_sanskrit": "प्रणम्यदैवतेभ्यश्चब्राह्मणेभ्यश्चमैथिली । बद्धाञ्जलिपुटाचेदमुवाचानगिसमीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019287, "chapter_id": 9307, "verse_number": "25", "content_sanskrit": "यथामेहृदयंनित्यंनापसर्पतिराघवात् । तथालोकस्यसाक्षीमांसर्वतःपातुपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019288, "chapter_id": 9307, "verse_number": "26", "content_sanskrit": "यथामांशुद्धचरितांदुष्टांजानातिराघवः । तथालोकस्यसाक्षीमांसर्वतःपातुपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019289, "chapter_id": 9307, "verse_number": "27", "content_sanskrit": "कर्मणामनसावाचायथानातिचराम्यहम् । राघवंसर्वधर्मज्ञंतथामांपातुपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40019290, "chapter_id": 9307, "verse_number": "28", "content_sanskrit": "आदित्योभगवान्वायुर्धिशश्चन्द्रस्तथैव च । अहश्चापितथासन्ध्येरात्रिश्चपृथिवीतथआ ॥ यथान्येऽपिविजानन्तितथाचारित्रसंयुताम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40019291, "chapter_id": 9307, "verse_number": "29", "content_sanskrit": "एवमुक्त्वातुवैदेहीपरिक्रम्यहुताशनम् । विवेशज्वलनंदीप्तंनिःशङ्केनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40019292, "chapter_id": 9307, "verse_number": "30", "content_sanskrit": "नश्चसुमहांस्तत्रबालवृद्धसमाकुलः ॥ ददर्शमैथिलींदीप्तांप्रविशन्तींहुताशनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40019293, "chapter_id": 9307, "verse_number": "31", "content_sanskrit": "सातप्तनवहेमाभातप्तकाञ्चनभूषणा ॥ पपातज्वलनंदीप्तंसर्वलोकस्यसन्निधौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40019294, "chapter_id": 9307, "verse_number": "32", "content_sanskrit": "ददृशुस्तांविशालाक्षींपतन्तींहव्यवाहनम् ॥ सीतांसर्वाणिरूपाणिरुक्मवेदिनिभांतदा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40019295, "chapter_id": 9307, "verse_number": "33", "content_sanskrit": "ददृशुस्तांमहाभागांप्रविशन्तींहुताशनम् ॥ सीतांकृत्स्नास्त्रयोलोकाःपुण्यामाज्याहुतीमिव ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40019296, "chapter_id": 9307, "verse_number": "34", "content_sanskrit": "प्रचुक्रुशुःस्त्रियःसर्वास्तांदृष्टवाहव्यवाहवे ॥ पतन्तींसंस्कृतांमन्रन्स्सैर्वसोर्दारामिवाध्वरे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40019297, "chapter_id": 9307, "verse_number": "35", "content_sanskrit": "ददृशुस्तांत्रयोलोकादेवगन्धर्वदानवाः ॥ शस्तांपतन्तींनिरयेत्रिविवाद्धेवतामिव ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]