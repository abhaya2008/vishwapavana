[{"id": 5000307000, "chapter_id": 9307, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000307001, "chapter_id": 9307, "verse_number": "४-३५-१", "content_sanskrit": "तथा ब्रूवाणं सौमित्रिं प्रदीप्तमिव तेजसा।\nअब्रवील्लक्ष्मणं तारा ताराधिपनिभानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000307002, "chapter_id": 9307, "verse_number": "४-३५-२", "content_sanskrit": "नैवं लक्ष्मण वक्तव्यो नायं परुषमर्हति।\nहरीणामीश्वरः श्रोतुं तव वक्त्राद् विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000307003, "chapter_id": 9307, "verse_number": "४-३५-३", "content_sanskrit": "नैवाकृतज्ञः सुग्रीवो न शठो नापि दारुणः।\nनैवानृतकथो वीर न जिह्मश्च कपीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000307004, "chapter_id": 9307, "verse_number": "४-३५-४", "content_sanskrit": "उपकारं कृतं वीरो नाप्ययं विस्मृतः कपिः।\nरामेण वीर सुग्रीवो यदन्यैर्दुष्करं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000307005, "chapter_id": 9307, "verse_number": "४-३५-५", "content_sanskrit": "रामप्रसादात् कीर्तिं च कपिराज्यं च शाश्वतम्।\nप्राप्तवानिह सुग्रीवो रुमां मां च परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000307006, "chapter_id": 9307, "verse_number": "४-३५-६", "content_sanskrit": "सुदुःखशयितः पूर्वं प्राप्येदं सुखमुत्तमम्।\nप्राप्तकालं न जानीते विश्वामित्रो यथा मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000307007, "chapter_id": 9307, "verse_number": "४-३५-७", "content_sanskrit": "घृताच्यां किल संसक्तो दश वर्षाणि लक्ष्मण।\nअहोऽमन्यत धर्मात्मा विश्वामित्रो महामुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000307008, "chapter_id": 9307, "verse_number": "४-३५-८", "content_sanskrit": "स हि प्राप्तं न जानीते कालं कालविदां वरः।\nविश्वामित्रो महातेजाः किं पुनर्यः पृथग्जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000307009, "chapter_id": 9307, "verse_number": "४-३५-९", "content_sanskrit": "देहधर्मगतस्यास्य परिश्रान्तस्य लक्ष्मण।\nअवितृप्तस्य कामेषु रामः क्षन्तुमिहार्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000307010, "chapter_id": 9307, "verse_number": "४-३५-१०", "content_sanskrit": "न च रोषवशं तात गन्तुमर्हसि लक्ष्मण।\nनिश्चयार्थमविज्ञाय सहसा प्राकृतो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000307011, "chapter_id": 9307, "verse_number": "४-३५-११", "content_sanskrit": "सत्त्वयुक्ता हि पुरुषास्त्वद्विधाः पुरुषर्षभ।\nअविमृश्य न रोषस्य सहसा यान्ति वश्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000307012, "chapter_id": 9307, "verse_number": "४-३५-१२", "content_sanskrit": "प्रसादये त्वां धर्मज्ञ सुग्रीवार्थं समाहिता।\nमहान् रोषसमुत्पन्नः संरम्भस्त्यज्यतामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000307013, "chapter_id": 9307, "verse_number": "४-३५-१३", "content_sanskrit": "रुमां मां चाङ्गदं राज्यं धनधान्यपशूनि च।\nरामप्रियार्थं सुग्रीवस्त्यजेदिति मतिर्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000307014, "chapter_id": 9307, "verse_number": "४-३५-१४", "content_sanskrit": "समानेष्यति सुग्रीवः सीतया सह राघवम्।\nशशाङ्कमिव रोहिण्या हत्वा तं राक्षसाधमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000307015, "chapter_id": 9307, "verse_number": "४-३५-१५", "content_sanskrit": "शतकोटिसहस्राणि लङ्कायां किल रक्षसाम्।\nअयुतानि च षट‍‍्त्रिंशत्सहस्राणि शतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000307016, "chapter_id": 9307, "verse_number": "४-३५-१६", "content_sanskrit": "अहत्वा तांश्च दुर्धर्षान् राक्षसान् कामरूपिणः।\nन शक्यो रावणो हन्तुं येन सा मैथिली हृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000307017, "chapter_id": 9307, "verse_number": "४-३५-१७", "content_sanskrit": "ते न शक्या रणे हन्तुमसहायेन लक्ष्मण।\nरावणः क्रूरकर्मा च सुग्रीवेण विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000307018, "chapter_id": 9307, "verse_number": "४-३५-१८", "content_sanskrit": "एवमाख्यातवान् वाली स ह्यभिज्ञो हरीश्वरः।\nआगमस्तु न मे व्यक्तः श्रवात् तस्य ब्रवीम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000307019, "chapter_id": 9307, "verse_number": "४-३५-१९", "content_sanskrit": "त्वत्सहायनिमित्तं हि प्रेषिता हरिपुङ्गवाः।\nआनेतुं वानरान् युद्धे सुबहून् हरिपुङ्गवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000307020, "chapter_id": 9307, "verse_number": "४-३५-२०", "content_sanskrit": "तांश्च प्रतीक्षमाणोऽयं विक्रान्तान् सुमहाबलान्।\nराघवस्यार्थसिद्ध्यर्थं न निर्याति हरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000307021, "chapter_id": 9307, "verse_number": "४-३५-२१", "content_sanskrit": "कृता सुसंस्था सौमित्रे सुग्रीवेण पुरा यथा।\nअद्य तैर्वानरैः सर्वैरागन्तव्यं महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000307022, "chapter_id": 9307, "verse_number": "४-३५-२२", "content_sanskrit": "ऋक्षकोटिसहस्राणि गोलाङ्गूलशतानि च।\nअद्य त्वामुपयास्यन्ति जहि कोपमरिंदम।\nकोट्योऽनेकास्तु काकुत्स्थ कपीनां दीप्ततेजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000307023, "chapter_id": 9307, "verse_number": "४-३५-२३", "content_sanskrit": "तव हि मुखमिदं निरीक्ष्य कोपात्\nक्षतजसमे नयने निरीक्षमाणाः।\nहरिवरवनिता न यान्ति शान्तिं\nप्रथमभयस्य हि शङ्किताः स्म सर्वाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000307024, "chapter_id": 9307, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे पञ्चत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]