[
  {
    "id": 20006813,
    "chapter_id": 6643,
    "verse_number": "13.1",
    "content_sanskrit": "यमुनामतीतमथ शुश्रुवानमुमुं तपसस्तनूज इति नाधुनोच्यते । स यदाचलन्निजपुरादहर्निशं नृपतेस्तदादि समचारि वार्तया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20006814,
    "chapter_id": 6643,
    "verse_number": "13.2",
    "content_sanskrit": "यदुभर्तुरागमनलब्धजन्मनः प्रमदादमानिव पुरे महीयसि । सहसा ततः स सहितोऽनुजन्मभिर्वसुधाधिपोऽभिमुखमस्यनिर्ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20006815,
    "chapter_id": 6643,
    "verse_number": "13.3",
    "content_sanskrit": "रभसप्रवृत्तकुरुचक्रदुन्दुभिध्वनिभिर्जनस्य बधिरीकृतश्रुतेः । समवादि वक्तृभिरभीष्टसङ्कथाप्रकृतार्थशेषमथ हस्तसंज्ञया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20006816,
    "chapter_id": 6643,
    "verse_number": "13.4",
    "content_sanskrit": "अपदान्तरं च परितः क्षितिक्षितामपतन्द्रुतभ्रमितहेमनेमयः । जविमारुताञ्चितपरस्परोपमक्षितिरेणुकेतुवसनाः पताकिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20006817,
    "chapter_id": 6643,
    "verse_number": "13.5",
    "content_sanskrit": "द्रुतमध्वनन्नुपरि पाणिवृत्तयः पणवा इवाश्वचरणक्षता भुवः । ननृतुश्च वारिधरधीरवारणध्वनिहृष्टकूजितकलाः कलापिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20006818,
    "chapter_id": 6643,
    "verse_number": "13.6",
    "content_sanskrit": "व्रजतोरपि प्रणयपूर्वमेकतामसुरारिपाण्डुसुतसैन्ययोस्तदा । ररुषे विषाणिभिरनुक्षणंमिथो मदमूढबुद्धिषु विवेकिता कुतः? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20006819,
    "chapter_id": 6643,
    "verse_number": "13.7",
    "content_sanskrit": "अवलोक एव नृपतेः स्म दूरतो रभसाद्रथादवतरीतुमिच्छतः । अवतीर्णवान्प्रथममात्मना हरिर्विनयं विशेषयति सम्भ्रमेण सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20006820,
    "chapter_id": 6643,
    "verse_number": "13.8",
    "content_sanskrit": "वपुषा पुराणपुरुषः पुरः क्षितौ परिपुञ्ज्यमानपृथुहारयष्टिना । भुवनैर्नतोऽपि विहितात्त्मगौरवः प्रणनाम नाम तनयं पितृष्वसुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20006821,
    "chapter_id": 6643,
    "verse_number": "13.9",
    "content_sanskrit": "मुकुटांशुरञ्जितपरागमग्रतः स न यावदाप शिरसा महीतलम् । क्षितिपेन तावदनपेक्षितक्रमं भुजपञ्जरेण रभसादगृह्यत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20006822,
    "chapter_id": 6643,
    "verse_number": "13.10",
    "content_sanskrit": "न ममौ कपाटतटविस्तृतं तनौ मुरवैरिमवक्ष उरसि क्षमाभुजः । भुजयोस्तथापि युगलेन दीर्घयोर्विकटीकृतेन परितोऽभिषस्वजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20006823,
    "chapter_id": 6643,
    "verse_number": "13.11",
    "content_sanskrit": "गतया निरन्तरनिवासमध्युरः परिनाभि नूनमवमुच्य वारिजम् । कुरराजनिर्दय निपीडनाभयान्मुखमध्यरोहि मुरविद्विषः श्रिया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20006824,
    "chapter_id": 6643,
    "verse_number": "13.12",
    "content_sanskrit": "शिरसि स्म जिघ्रति सुरारिबन्धने छलवामनं विनयवामनं तदा । यशसेव वीर्यविजितामरद्रुमप्रसवेन वासितशिरोरुहे नृपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20006825,
    "chapter_id": 6643,
    "verse_number": "13.13",
    "content_sanskrit": "सुखवेदनाहृषितरोमकूपया शिथिलीकृतेऽपि वसुदेवजन्मनि । कुरुभर्तुरङ्गलतया न तत्यजे विकसत्कदम्बनिकुरम्बचारुता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20006826,
    "chapter_id": 6643,
    "verse_number": "13.14",
    "content_sanskrit": "इतरानपि क्षितिभुजोऽनुजन्मनः प्रमनाः प्रमोदपरिफुल्लचक्षुषः । स यथोचितं जनसभाजनोचितः प्रसभोद्धृतासुरसभोऽसभाजयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20006827,
    "chapter_id": 6643,
    "verse_number": "13.15",
    "content_sanskrit": "समपेत्य तुल्यमहसः शिलाघनान्घनपक्षदीर्घतरबाहुशालिनः । परिशिश्लिषुः क्षितिपतीन्क्षितीश्वराः कुलिशात्परेण गिरयो गिरीनिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20006828,
    "chapter_id": 6643,
    "verse_number": "13.16",
    "content_sanskrit": "इभकुम्भतुंङ्गकठिनेतरेतरस्तनभारदूरविनिवारितोदराः । परिफुल्लगण्डफलकाः परस्परं परिरेभिरे कुकुरकौरवस्त्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20006829,
    "chapter_id": 6643,
    "verse_number": "13.17",
    "content_sanskrit": "रथवाजिपत्तिकरिणीसमाकुलं तदनीकयोः समगत द्वयं मिथः । दधिरे पृथक्करिण एव दूरतो महतां हि सर्वमथवा जनातिगम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20006830,
    "chapter_id": 6643,
    "verse_number": "13.18",
    "content_sanskrit": "अधिरुह्यतामिति महीभृतोदितः कपिकेतुनार्पितकरो रथं हरिः । अवलम्बितैलविलपाणिपल्लवः श्रयति स्म मेघमिव मेघवाहनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20006831,
    "chapter_id": 6643,
    "verse_number": "13.19",
    "content_sanskrit": "रथमास्थितस्य च पुराभिवर्तिनस्तिसृणां पुरामिव रिपोर्मुरद्विषः । अथ धर्ममूर्तिरनुरागभावितः स्वयमादित प्रवयणं प्रजापतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20006832,
    "chapter_id": 6643,
    "verse_number": "13.20",
    "content_sanskrit": "शनकैरथास्य तनुजालकान्तरस्फुरितक्षपाकरकरोत्कराकृति । पृथुफेनकूटमिव निम्नगापतेर्मरुतश्च सूनुरघुवत्प्रकीर्णकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20006833,
    "chapter_id": 6643,
    "verse_number": "13.21",
    "content_sanskrit": "विकसत्कलायकुसुमासितद्युतेरलघूडुपाण्डु जगतामधीशितुः । यमुनाह्रदोपरिगहंसमण्डलद्युतिजिष्णु जिष्णुरभृतोष्णवारणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20006834,
    "chapter_id": 6643,
    "verse_number": "13.22",
    "content_sanskrit": "पवनात्मजेन्द्रसुतमध्यवर्तिना नितरामरोचि रुचिरेण चक्रिणा । दधतेव योगमुभयग्रहान्तरस्थितिकारितं दुरुधराख्यमिन्दुना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20006835,
    "chapter_id": 6643,
    "verse_number": "13.23",
    "content_sanskrit": "वशिनं क्षितेरयनयाविवेश्वरं नियमो यमश्च नियतं यतिं यथा । विजयश्रिया वृतमिवार्कमारुतावनुसस्रतुस्तमथ दस्रयोः सुतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20006836,
    "chapter_id": 6643,
    "verse_number": "13.24",
    "content_sanskrit": "मुदितैस्तदेति दितिजन्मनांरिपावविनीयसम्भ्रमविकासिभक्तिभिः । उपसेदिवद्भिरुपदेष्टरीव तैर्ववृते विनीतमविनीतशासिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20006837,
    "chapter_id": 6643,
    "verse_number": "13.25",
    "content_sanskrit": "गतयोरभेदमिति सैन्ययोस्तयोरथ भानुतजह्नुतनयाम्भसोरिव । प्रतिनादितामरविमानमानकैर्नितरां मुदा परमयेव दध्वने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20006838,
    "chapter_id": 6643,
    "verse_number": "13.26",
    "content_sanskrit": "मखमाक्षितुं क्षितिपतेरुपेयुषां परितः प्रकल्पितनिकेतनं बहिः । उपरुध्यमानमिव भूभृतां बलैः पुटभेदनं दनुसुतारिरैक्षत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20006839,
    "chapter_id": 6643,
    "verse_number": "13.27",
    "content_sanskrit": "प्रतिनादपूरितदिगन्तरः पतन्पुरगोपुरं प्रति स सैन्यसागरः । रुरुचे हिमाचलगुहामुखोन्मुखः पयसां प्रवाह इव सौरसैन्धवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20006840,
    "chapter_id": 6643,
    "verse_number": "13.28",
    "content_sanskrit": "असकृद्गृहीतबहुदेहसम्भवस्तदसौ विभक्तनवगोपुरान्तरम् । पुरुषः पुरं प्रविशति स्म पञ्चभिः सममिन्द्रियैरिव नरेन्द्रसूनुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20006841,
    "chapter_id": 6643,
    "verse_number": "13.29",
    "content_sanskrit": "तनुभिस्त्रिनेत्रनयनानवेक्षितस्मरविग्रहद्युतिभिरद्युतन्नराः । प्रमदाश्च यत्र खलु राजयक्ष्मणः परतो निशाकरमनोरमैर्मुखैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20006842,
    "chapter_id": 6643,
    "verse_number": "13.30",
    "content_sanskrit": "अवलोकनाय सुरविद्विषां द्विषः पटहप्रणादविहितोपहूतयः । अवधीरितान्यकरणीयसत्वराः प्रतिरथ्यमीयुरथ पौरयोषितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20006843,
    "chapter_id": 6643,
    "verse_number": "13.31",
    "content_sanskrit": "अभिवीक्ष्य सामिकृतमण्डनं यतीः कररुद्धनीविगलदंशुकाः स्त्रियः । दधिरेऽधिभित्ति पटहप्रतिस्वनैः स्फुटमट्टहासमिव सौधपङ्क्त्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20006844,
    "chapter_id": 6643,
    "verse_number": "13.32",
    "content_sanskrit": "रभसेन हारपददन्तकाञ्चयः प्रतिमूर्धजं निहितकर्णपूरकाः । परिवर्तिताम्बरयुगाः समापतन्वलयीकृतश्रवणपूरकाः स्त्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20006845,
    "chapter_id": 6643,
    "verse_number": "13.33",
    "content_sanskrit": "व्यतनोदपास्य चरणं प्रसाधिकाकरपल्लवाद्रसवशेन काचन । द्रुतयावकैकपदचित्रितावनिं पदवीं गतेव गिरिजा हरार्धताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20006846,
    "chapter_id": 6643,
    "verse_number": "13.34",
    "content_sanskrit": "व्यचलन्विशङ्कटकटीरकस्थलीशिखरस्खलन्मुखरमेखलाकुलाः । भवनानि तुङ्गतपनीयसंक्रमक्रमणक्वणत्कनकनूपुराः स्त्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20006847,
    "chapter_id": 6643,
    "verse_number": "13.35",
    "content_sanskrit": "अधिरुक्ममन्दिरगवाक्षमुल्लसत्सदृशो रराज मुरजिद्दिदृक्षया । वदनारविन्दमुदयाद्रिकन्दराविवरोदरस्थतमिवेन्दुमण्डलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20006848,
    "chapter_id": 6643,
    "verse_number": "13.36",
    "content_sanskrit": "अधिरूढया निजनिकेतमुच्चकैः पवनावधूतवसनान्तयैकया । विहितोपशोभमुपयाति माधवे नगरं व्यरोचत पताकयेव तत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20006849,
    "chapter_id": 6643,
    "verse_number": "13.37",
    "content_sanskrit": "करयुग्मपद्ममुकुलापवर्जितैः प्रतिवेश्म लाजकुसमैरवाकिरन् । अवदीर्णशुक्तिपुटमुक्तमौक्तिकप्रकरैरिव प्रियरथाङ्गमङ्गनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20006850,
    "chapter_id": 6643,
    "verse_number": "13.38",
    "content_sanskrit": "हिममुक्तचन्द्ररुचिरः सपद्मको मदयन्द्विजाञ्जनितमीनकेतनः । अभवत्प्रसादितसुरो महोत्सवः प्रमदाजनस्य स चिराय माधवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20006851,
    "chapter_id": 6643,
    "verse_number": "13.39",
    "content_sanskrit": "धरणीधरेन्द्रहितुर्भयादसौविषमेक्षणः स्फुटममूर्न पश्यति । मदनेनवीतभयमित्यधिष्ठिताः क्षणमीक्षते स्म स पुरोविलासिनीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20006852,
    "chapter_id": 6643,
    "verse_number": "13.40",
    "content_sanskrit": "विपुलेन सागरशयस्यकुक्षिणा भुवनानि यस्य पपिरे युगक्षये । मदविभ्रमासकलया पपे पुनः स पुरस्त्रियैकतमयैकया दृशा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20006853,
    "chapter_id": 6643,
    "verse_number": "13.41",
    "content_sanskrit": "अधिकोन्नमद्घनपयोधरं मुहुः प्रचलत्कलापिकलशङ्खकस्वना । अभिकृष्णमङ्गुलिमुखेन काचन द्रुतमेककर्णविवरं व्यघट्टयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20006854,
    "chapter_id": 6643,
    "verse_number": "13.42",
    "content_sanskrit": "परिपाटलाब्जदलचारुणासकृच्चलिताङ्गुलीकिसलयेन पाणिना । सशिरःप्रकम्पमपरा रिपुं मधोरनुदीर्णवर्णनिभृतार्थमाह्वयत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20006855,
    "chapter_id": 6643,
    "verse_number": "13.43",
    "content_sanskrit": "नलिनान्तिकोपहितपल्लवश्रिया व्यवधाय चारु मुखमेकपाणिना । स्फुरिताङ्गुलीविवरनिःसृतोल्लसद्दशनप्रभाङ्गुरमजृम्भतापरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20006856,
    "chapter_id": 6643,
    "verse_number": "13.44",
    "content_sanskrit": "वलयार्पितासितमहोपलप्रभाबहुलीकृतप्रतनुरोमराजिना । हरिवीक्षणाक्षणिकचक्षुषान्यया करपल्लवेन गलदम्बरं दधे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20006857,
    "chapter_id": 6643,
    "verse_number": "13.45",
    "content_sanskrit": "निजसौरभभ्रमितभृङ्गपक्षतिव्यजनानिलक्षयितघर्मवारिणः । अभिशौरि काचिदनिमेषदृष्टिना पुरदेवतेव वपुषा व्यभाव्यत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20006858,
    "chapter_id": 6643,
    "verse_number": "13.46",
    "content_sanskrit": "अभियाति नः सतृष एव चक्षुषो हरिरित्यखिद्यत नितम्बिनीजनः । न विवेद यः सततमेनमीक्षते न वितृष्णतां व्रजति खल्वसावपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20006859,
    "chapter_id": 6643,
    "verse_number": "13.47",
    "content_sanskrit": "अकृतस्वसद्मगमनादरः क्षणं लिपिकर्मनिर्मित इव व्यतिष्ठत । गतमच्युतेन सह शून्यतां गतः प्रतिपालयन्मन इवाङ्गनाजनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20006860,
    "chapter_id": 6643,
    "verse_number": "13.48",
    "content_sanskrit": "अलसैर्मदेन सुदृशः शरीरकैः स्वगृहान्प्रति प्रतिययुः शनैः शनैः । अलघुप्रसारित विलोचनाञ्जलिद्रुतपीतमाधवरसौघनिर्भरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20006861,
    "chapter_id": 6643,
    "verse_number": "13.49",
    "content_sanskrit": "नवगन्धवारिविरजीकृताः पुरो घनधूपधूम कृतरेणुविभ्रमाः । प्रचुरोद्धतध्वजविलम्बिवाससः पुरवीथयोऽथ हरिणातिपेतिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20006862,
    "chapter_id": 6643,
    "verse_number": "13.50",
    "content_sanskrit": "उपनीय बिन्दुसरसो मयेन या मणिदारु चारु किल वार्षपर्वणम् । विदधेऽवधूतसुरसद्मसम्पदं समुपासदत्सपदि संसदं स ताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20006863,
    "chapter_id": 6643,
    "verse_number": "13.51",
    "content_sanskrit": "अधिरात्रि यत्र निपतन्नभोलिहां कलधौतधौतशिलावेश्मनां रुचौ । पुनरप्यवापदिव दुग्धवारिधिक्षणगर्भवासमनिदाघदीधितिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20006864,
    "chapter_id": 6643,
    "verse_number": "13.52",
    "content_sanskrit": "लयनेषु लोहितकनिर्मिता भुवः शितिरत्नरश्मिहरितीकृतान्तराः । जमदग्निसूनुपितृतर्पणीरपोवहति स्म या विरलशैवला इव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20006865,
    "chapter_id": 6643,
    "verse_number": "13.53",
    "content_sanskrit": "विशदाश्मकूटघटिताः क्षपाकृतः क्षणदासु यत्र च रुचेकतां गताः । गृहपङ्क्तयश्चिरमतीयिरे जनैस्तमसीव हस्तपरिमर्शसूचिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20006866,
    "chapter_id": 6643,
    "verse_number": "13.54",
    "content_sanskrit": "निलयेषुनक्तमसिताश्मनां चयैर्बिसिनीवधूपरिभवस्पुटागसः । मुहरत्रसद्भिरपि यत्र गौरवाच्छशलाञ्छनांशव उपांशु जध्निरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20006867,
    "chapter_id": 6643,
    "verse_number": "13.55",
    "content_sanskrit": "सुखिनः पुरोऽभिमुखतामुपागतैः प्रतिमासु यत्र गृहरत्नभित्तिषु । नवसङ्गमैरबिभरुः प्रियाजनैः प्रमदं त्रपाभरपराङ्मुखैरपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20006868,
    "chapter_id": 6643,
    "verse_number": "13.56",
    "content_sanskrit": "तृणवाञ्छया मुहुरवाञ्चिताननान्निचयेषु यत्र हरिताश्मवेश्मनाम् । रसनाग्रलग्नकिरणाङ्कुराञ्जनो हरिणान्गृहीतकवलानिवैक्षत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20006869,
    "chapter_id": 6643,
    "verse_number": "13.57",
    "content_sanskrit": "विपुलालवालभृतवारिदर्पणप्रतिमागतैरभिविरेजुरात्मभिः । यदुपान्तिकेषु दधतो महीरुहः सपलाशराशिमिव मूलसंहतिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20006870,
    "chapter_id": 6643,
    "verse_number": "13.58",
    "content_sanskrit": "उरगेन्द्रमूर्धरुहरत्नसन्निधेर्मुहुरुन्नतस्य रसितैः पयोमुचः । अभवन्यदङ्गणभुवः समुच्छ्वसन्नववालवायजमणिस्थलाङ्कुराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20006871,
    "chapter_id": 6643,
    "verse_number": "13.59",
    "content_sanskrit": "नलिनी निगूढसलिला च यत्र सा स्थलमित्यधः पतति या सुयोधने । अनिलात्मजप्रहसनाकुलाखिलक्षितिपक्षयागमनिमित्ततां ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20006872,
    "chapter_id": 6643,
    "verse_number": "13.60",
    "content_sanskrit": "हसितुं परेण परितः परिस्फुरत्करवालकोमलरुचावुपेक्षितैः । उदकर्षि यत्र जलशङ्कया जनैर्मुहुरिन्द्रनीलभुवि दूरमम्बरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20006873,
    "chapter_id": 6643,
    "verse_number": "13.61",
    "content_sanskrit": "अभितः सदोऽथ हरिपाण्डवौ रथादमलांशुमण्डलसमुल्लसत्तनू । अवतेरतुर्नयननन्दनौ नभः शशिभार्गवावुदयपर्वतादिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20006874,
    "chapter_id": 6643,
    "verse_number": "13.62",
    "content_sanskrit": "तदलक्ष्यरत्नमयकुड्यमादरादभिधातरीत इत इत्यथो नृपे । धवलाश्मरश्मिपटलाविभावितप्रतिहारमाविशदसौ सदः शनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20006875,
    "chapter_id": 6643,
    "verse_number": "13.63",
    "content_sanskrit": "नवहाटकेष्टकचितं ददर्श स क्षितिपस्य पस्त्यमथ तत्र संसदि । गगनस्पृशां मणिरुचां चयेन यत्सदनान्युदयस्मयत नाकिनामपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20006876,
    "chapter_id": 6643,
    "verse_number": "13.64",
    "content_sanskrit": "उदयाद्रिमूर्ध्नि युगपच्चकासतोर्दिननाथपूर्णशशिनोरसम्भवाम् । रुचिमासने रुचिरधाम्नि बिभ्रतावलघुन्यथ न्यषदतां नृपाच्युतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20006877,
    "chapter_id": 6643,
    "verse_number": "13.65",
    "content_sanskrit": "सुतरां सुखेन सकलक्लमच्छिदा सनिदाधमङ्गमिव मातरिश्वना । यदुनन्दनेन तदुदन्वतः पयः शसिनेव राजकुलमाप नन्दथुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20006878,
    "chapter_id": 6643,
    "verse_number": "13.66",
    "content_sanskrit": "अनवद्यवाद्यलयगामि कोमलं नवगीतमप्यनवगीततां दधत् । स्फुटसात्विकाङ्गिकमनृत्यदुज्ज्वलं सविलासलासिकविलासनीजनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20006879,
    "chapter_id": 6643,
    "verse_number": "13.67",
