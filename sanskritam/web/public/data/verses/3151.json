[{"id": 2100321, "chapter_id": 3151, "verse_number": "१४-७-१", "content_sanskrit": "संवर्त उवाच।\nकथमस्मि त्वया ज्ञातः केन वा कथितोस्मि ते।\nएतदाचक्ष्व मे तत्त्वमिच्छसे चेन्मम प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100322, "chapter_id": 3151, "verse_number": "१४-७-२", "content_sanskrit": "सत्यं ते ब्रुवतः सर्वे सम्पत्स्यन्ते मनोरथाः।\nमिथ्या च ब्रुवतो मूर्धा शतधा ते स्फुटिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100323, "chapter_id": 3151, "verse_number": "१४-७-३x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100324, "chapter_id": 3151, "verse_number": "१४-७-३", "content_sanskrit": "नारदेन भवान्मह्यमाख्यातो ह्यटता पथि।\nगुरुपुत्रो ममेति त्वं ततो मे प्रीतिरुत्तमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100325, "chapter_id": 3151, "verse_number": "१४-७-४x", "content_sanskrit": "संवर्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100326, "chapter_id": 3151, "verse_number": "१४-७-४", "content_sanskrit": "सत्यमेतद्भवानाह स मां जानाति सत्रिणम्।\nकथयस्व तदेतन्मे क्वनु सम्प्रति नारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100327, "chapter_id": 3151, "verse_number": "१४-७-५x", "content_sanskrit": "मरुत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100328, "chapter_id": 3151, "verse_number": "१४-७-५", "content_sanskrit": "भवन्तं कथयित्वा तु मम देवर्षिसत्तमः।\nततो मामभ्यनुज्ञाय प्रविष्टो हव्यवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100329, "chapter_id": 3151, "verse_number": "१४-७-६x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100330, "chapter_id": 3151, "verse_number": "१४-७-६", "content_sanskrit": "श्रुत्वा तु पार्थिवस्यैत्संवर्तः प्रमुदं गतः।\nएतावदहमप्येवं शक्नुयामिति सोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100331, "chapter_id": 3151, "verse_number": "१४-७-७", "content_sanskrit": "ततो मरुत्तमुन्मत्तो वाचा निर्भर्त्सयन्निव।\nरूक्षया ब्राह्मणि राजन्पुनः पुनरथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100332, "chapter_id": 3151, "verse_number": "१४-७-८", "content_sanskrit": "वातप्रधानेन मया स्वचित्तवशवर्तिना।\nएवं विकृतरूपेण कथं याजितुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100333, "chapter_id": 3151, "verse_number": "१४-७-९", "content_sanskrit": "भ्राता मम समर्थश्च वासवेन च सङ्गतः।\nवर्तते याजने चैव तेन कर्माणि कारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100334, "chapter_id": 3151, "verse_number": "१४-७-१०", "content_sanskrit": "गार्हस्थ्यं चैव याज्याश्च सर्वा गृह्याश्च देवताः।\nपूर्वजेन ममाक्षिप्तं शरीरं वर्जितं त्विदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100335, "chapter_id": 3151, "verse_number": "१४-७-११", "content_sanskrit": "नाहं तेनाननुज्ञातस्त्वामाविक्षित कर्हिचित्।\nयाजयेयं कथंचिद्वै स हि पूज्यतमो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100336, "chapter_id": 3151, "verse_number": "१४-७-१२", "content_sanskrit": "स त्वं बृहस्पतिं गच्च तमनुज्ञाप्य चाव्रज।\nततोऽहं याजयिष्ये त्वां यदि यष्टुमिहेच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100337, "chapter_id": 3151, "verse_number": "१४-७-१३x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100338, "chapter_id": 3151, "verse_number": "१४-७-१३", "content_sanskrit": "बृहस्पतिं गतः पूर्वमहं संवर्ते तच्छृणु।\nन मां कामयते याज्यं मुनिर्वासववारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100339, "chapter_id": 3151, "verse_number": "१४-७-१४", "content_sanskrit": "अमरं याज्यमासाद्य याजयिष्ये न मानुषम्।\nशक्रेण प्रतिषिद्धोऽहं मरुत्तं मा स्म याजये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100340, "chapter_id": 3151, "verse_number": "१४-७-१५", "content_sanskrit": "स्पर्धते हि मया विप्र सदा हि स तु पार्थिवः।\nएवमस्त्विति चाप्युक्तो भ्रात्रा ते बलसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100341, "chapter_id": 3151, "verse_number": "१४-७-१६", "content_sanskrit": "स मामधिगतं प्रेम्णा याज्यत्वे न बुभूषति।\nदेवराजं समाश्रित्य तद्विद्धि मुनिपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100342, "chapter_id": 3151, "verse_number": "१४-७-१७", "content_sanskrit": "सोहमिच्छामि भवता सर्वस्वेनापि याजितुम्।\nकामये समतिक्रान्तुं वासवं त्वत्कृतैर्गुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2100343, "chapter_id": 3151, "verse_number": "१४-७-१८", "content_sanskrit": "न हि मे वर्तते बुद्धिर्गन्तुं ब्रह्मन्बृहस्पतिम्।\nप्रत्याख्यातो हि तेनास्मि तथाऽनपकृते सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2100344, "chapter_id": 3151, "verse_number": "१४-७-१९x", "content_sanskrit": "संवर्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2100345, "chapter_id": 3151, "verse_number": "१४-७-१९", "content_sanskrit": "चिकीर्षसि यथाकामं सर्वमेतत्त्वयि ध्रुवम्।\nयदि सर्वानभिप्रायान्कर्तासि मम पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2100346, "chapter_id": 3151, "verse_number": "१४-७-२०", "content_sanskrit": "याज्यमानं मया हि त्वां बृहस्पतिपुंरदरौ।\nद्विषेतां समभिक्रुद्धावेतदेकं समर्थये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2100347, "chapter_id": 3151, "verse_number": "१४-७-२१", "content_sanskrit": "स्थैर्यमत्र कथं मे स्यात्स त्वं निःसंशयं कुरु।\nकुपितस्त्वां न हीदानीं भस्म कुर्या सवान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2100348, "chapter_id": 3151, "verse_number": "१४-७-२२x", "content_sanskrit": "मरुत्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2100349, "chapter_id": 3151, "verse_number": "१४-७-२२", "content_sanskrit": "यावत्तपेत्सहस्रांशुस्तिष्ठेरंश्चापि पर्वताः।\nतावल्लोकान्न लभेयं त्यजेयं सङ्गतं यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2100350, "chapter_id": 3151, "verse_number": "१४-७-२३", "content_sanskrit": "मा चापि शुभबुद्धित्वं लभेयमिह कर्हिचित्।\nविषयैः सङ्गतं चास्तु त्यजेयं सङ्गतं यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2100351, "chapter_id": 3151, "verse_number": "१४-७-२४x", "content_sanskrit": "संवर्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2100352, "chapter_id": 3151, "verse_number": "१४-७-२४", "content_sanskrit": "आविक्षित शुभा बुद्धिर्वर्ततां तव कर्मसु।\nयाजनं हि ममाप्येव वर्तते हृदि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2100353, "chapter_id": 3151, "verse_number": "१४-७-२५", "content_sanskrit": "अभिधास्ते च ते राजन्नक्षयं द्रव्यमुत्तमम्।\nयेन देवान्सग्धर्वाञ्शक्रं चाभिभविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2100354, "chapter_id": 3151, "verse_number": "१४-७-२६", "content_sanskrit": "न तु मे वर्तते बुद्धिर्धने याज्येषु वा पुनः।\nविप्रियं तु करिष्यामि भ्रातुश्चेन्द्रस्य चोभयो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2100355, "chapter_id": 3151, "verse_number": "१४-७-२७", "content_sanskrit": "गमयिष्यामि शक्रेण समतामपि ते ध्रुवम्।\nप्रियं च ते करिष्यामि सत्यमेतद्ब्रवीमि ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2100356, "chapter_id": 3151, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि सप्तमोऽध्यायः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]