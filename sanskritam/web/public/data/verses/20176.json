[{"id": 7000176000, "chapter_id": 20176, "verse_number": "१७६-१", "content_sanskrit": "अनन्तवासुदेवमाहात्म्यवर्णनम् मुनय ऊचुः न हि नस्तृप्तिरस्तीह शृण्वतां भगवत्कथाम् ।\nपुनरेव परं गुह्यं वक्तुमर्हस्यशेषतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000176001, "chapter_id": 20176, "verse_number": "१७६-२", "content_sanskrit": "अनन्तवासुदेवस्य न सम्यग्वर्णितं त्वया ।\nश्रोतुमिच्छामहे देव विस्तरेण वदस्व नः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000176002, "chapter_id": 20176, "verse_number": "१७६-३", "content_sanskrit": "ब्रह्मोवाच प्रवक्ष्यामि मुनिश्रेष्ठाः सारात्सारतरं परम् ।\nअनन्तवासुदेवस्य माहात्म्यं भुवि दुर्लभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000176003, "chapter_id": 20176, "verse_number": "१७६-४", "content_sanskrit": "आदिकल्पे पुरा विप्रास्त्वहमव्यक्तजन्मवान् ।\nविश्वकर्माणमाहूय वचनं प्रोक्तवानिदम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000176004, "chapter_id": 20176, "verse_number": "१७६-५", "content_sanskrit": "वरिष्ठं देवशिल्पीन्द्रं विश्वकर्माग्रकर्मिणम् ।\nप्रतिमां वासुदेवस्य कुरु शैलमयीं भुवि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000176005, "chapter_id": 20176, "verse_number": "१७६-६", "content_sanskrit": "यां प्रेक्ष्य विधिवद्‌भक्ताः सेन्द्रा वै मानुषादयः ।\nयेन दानवरक्षोभ्यो विज्ञाय सुमहद्‌भयम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000176006, "chapter_id": 20176, "verse_number": "१७६-७", "content_sanskrit": "त्रिदिवं समनुप्राप्य सुमेरुशिखरं चिरम् ।\nवासुदेवं समाराध्य निरातङ्का वसन्ति ते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000176007, "chapter_id": 20176, "verse_number": "१७६-८", "content_sanskrit": "मम तद्वचनं श्रुत्वा विश्वकर्मा तु तत्क्षणात् ।\nचकार प्रतिमां शुद्धां शङ्खचक्रगदाधराम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000176008, "chapter_id": 20176, "verse_number": "१७६-९", "content_sanskrit": "सर्वलक्षणसंयुक्तां पुण्डरीकायतेक्षणाम् ।\nश्रीवत्सलक्ष्संयुक्तामत्युग्रां प्रतिमोत्तमाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000176009, "chapter_id": 20176, "verse_number": "१७६-१०", "content_sanskrit": "वनमालावृतोरस्कां मुकुटाङ्गदधारिणीम् ।\nपीतवस्त्रां सुपीनांसां कुण्डलाभ्यामलंकृताम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000176010, "chapter_id": 20176, "verse_number": "१७६-११", "content_sanskrit": "एवं सा प्रतिमा दिव्या गुह्यमन्त्रैस्तदा स्वयम् ।\nप्रतिष्ठाकालमासाद्य मयाऽऽसौ निर्मिता पुरा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000176011, "chapter_id": 20176, "verse_number": "१७६-१२", "content_sanskrit": "तस्मिन्काले तदा शक्रो देवराट्खेचरैः सह ।\nजगाम ब्रह्मसदनमारुह्य गजमुत्तमम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000176012, "chapter_id": 20176, "verse_number": "१७६-१३", "content_sanskrit": "प्रसाद्य प्रतिमां शक्रः स्नानदानैः पुनः पुनः ।\nप्रतिमां तां समाराध्य(दाय)स्वपुरं पुनरागमत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000176013, "chapter_id": 20176, "verse_number": "१७६-१४", "content_sanskrit": "तां समाराध्य सुचिरं यतवाक्कायमानसः ।\nवृत्राद्यानसुरान्क्रूरान्नमुचिप्रमुखान्स च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000176014, "chapter_id": 20176, "verse_number": "१७६-१५", "content_sanskrit": "निहत्य दानवान्भीमान्भूक्तवान्भुवनत्रयम् ।\nद्वितीये च युगे प्राप्ते त्रेतायां राक्षसाधिपः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000176015, "chapter_id": 20176, "verse_number": "१७६-१६", "content_sanskrit": "बभूव सुमहावीर्यो दशग्रीवः प्रतापवान् ।\nदश वर्षसहस्राणि निराहारो जितेन्द्रियः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000176016, "chapter_id": 20176, "verse_number": "१७६-१७", "content_sanskrit": "चचार व्रतमत्युग्रं तपः परमदुश्चरम् ।\nतपसा तेन तुष्टोऽहं वरं तस्मै प्रदत्तवान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000176017, "chapter_id": 20176, "verse_number": "१७६-१८", "content_sanskrit": "अवध्यः सर्वदेवानां स दैत्योरगयक्षसाम् ।\nशापप्रहरणैरुग्रैरवध्यो यमकिंकरैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000176018, "chapter_id": 20176, "verse_number": "१७६-१९", "content_sanskrit": "वरं प्राप्य तदा रक्षो यक्षान्सर्वगणानिमान् ।\nधनाध्यक्षं विनिर्जित्य शक्रं जेतुं समुद्यतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000176019, "chapter_id": 20176, "verse_number": "१७६-२०", "content_sanskrit": "संग्रामं सुमहाघोरं कृत्वा देवैः स राक्षसः ।\nदेवराजं विनिर्जित्य तदा इन्द्रिजितेति वै ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000176020, "chapter_id": 20176, "verse_number": "१७६-२१", "content_sanskrit": "राक्षसस्तत्सुरो नाम मेघनादः प्रलब्धवान् ।\nअमरावतीं ततः प्राप्य देवराजगृहे शुभे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000176021, "chapter_id": 20176, "verse_number": "१७६-२२", "content_sanskrit": "ददर्शाञ्जनसंकाशां रावणस्तु बलान्वितः ।\nप्रतिमां वासुदेवस्य सर्वलक्षणसंयुताम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000176022, "chapter_id": 20176, "verse_number": "१७६-२३", "content_sanskrit": "श्रीवत्सलक्ष्मसंयुक्तं पद्मपत्रायतेक्षणाम् ।\nवनमालावृतोरस्कां सर्वकामफलप्रदाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000176023, "chapter_id": 20176, "verse_number": "१७६-२४", "content_sanskrit": "शङ्खचक्रगदाहस्तां पीतवस्त्रां चतुर्भुजाम् ।\nसर्वाभरणसंयुक्तां सर्वकामफलप्रदाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000176024, "chapter_id": 20176, "verse_number": "१७६-२५", "content_sanskrit": "विहाय रत्नसङ्घांश्च प्रतिमां शुभलक्षणाम् ।\nपुष्पकेण विमानेन लङ्कां प्रास्थापयद्‌द्रुतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000176025, "chapter_id": 20176, "verse_number": "१७६-२६", "content_sanskrit": "पुराध्यक्षः स्थितः श्रीमान्धर्मात्मा स विभीषणः ।\nरावणस्यानुजो मन्त्री नारायणपरायणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000176026, "chapter_id": 20176, "verse_number": "१७६-२७", "content_sanskrit": "दृष्ट्वा तां प्रतिमां दिव्यां देवेन्द्रभवनच्युताम् ।\nरोमाञ्चिततनुर्भूत्वा विस्मयं समपद्यत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000176027, "chapter_id": 20176, "verse_number": "१७६-२८", "content_sanskrit": "प्रणम्य शिरसा देवं प्रहृष्टेनान्तरात्मना ।\nअद्य मे सफलं जन्म अद्य मे सफलं तपः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000176028, "chapter_id": 20176, "verse_number": "१७६-२९", "content_sanskrit": "इत्युक्त्वा स तु धर्मात्मा प्रणिपत्य मुहुर्मुहुः  ।\nज्येष्ठं भ्रातरमासाद्य कृताञ्जलिरभाषत ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000176029, "chapter_id": 20176, "verse_number": "१७६-३०", "content_sanskrit": "राजन्प्रतिमया त्वं मे प्रसादं कर्तुमर्हसि ।\nयामाराध्य जगन्नाथ निस्तरेयं भवार्णवम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000176030, "chapter_id": 20176, "verse_number": "१७६-३१", "content_sanskrit": "भ्रातुर्वचनमाकर्ण्य रावणस्तं तदाऽब्रवीत् ।\nगृहाण प्रतिमां वीर त्वनया किं करोम्यहम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000176031, "chapter_id": 20176, "verse_number": "१७६-३२", "content_sanskrit": "स्वयंभुवं समाराध्य त्रैलोक्यं विजये त्वहम् ।\nनानाश्चर्यमयं देवं सर्वभूतभवोद्भवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000176032, "chapter_id": 20176, "verse_number": "१७६-३३", "content_sanskrit": "विभीषणो महाबुद्धिस्तदा तां(रासाद्य)प्रतिमां शुभाम् ।\nशतमष्टोत्तरं चाब्दं समाराध्य जनार्दनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000176033, "chapter_id": 20176, "verse_number": "१७६-३४", "content_sanskrit": "अजरामरणं प्राप्तमणिमादिगुणैर्युतम् ।\nराज्यं लङ्काधिपत्यं च भोगान्भुङ्क्ते यथेप्सितान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000176034, "chapter_id": 20176, "verse_number": "१७६-३५", "content_sanskrit": "मुनय ऊचुः अहो नो विस्मयो जातः श्रुत्वेदं परमामृतम् ।\nअनन्तवासुदेवस्य संभवं भुवि दुर्लभम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000176035, "chapter_id": 20176, "verse_number": "१७६-३६", "content_sanskrit": "श्रोतुमिच्छामहे देव विस्तरेण यथातथम् ।\nतस्य देवस्य माहात्म्यं वक्तुमर्हस्यशेषतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000176036, "chapter_id": 20176, "verse_number": "१७६-३७", "content_sanskrit": "ब्रह्मोवाच तदा स राक्षसः क्रूरो देवागन्धर्वकिन्नरान् ।\nलोकपालान्समनुजान्मुनिसिद्धांश्च पापकृत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000176037, "chapter_id": 20176, "verse_number": "१७६-३८", "content_sanskrit": "विजित्य समरे सर्वानाजहार तदङ्गनाः ।\nसंस्थाप्य नगरीं लङ्कां पुनः सीतार्थ(तां च)मोहितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000176038, "chapter_id": 20176, "verse_number": "१७६-३९", "content_sanskrit": "शङ्कितो मृगरूपेण सौवर्णेन च रावणः ।\nततः क्रुद्धेन रामेण रणे सौमित्रिणा सह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000176039, "chapter_id": 20176, "verse_number": "१७६-४०", "content_sanskrit": "रावणस्य वधार्थाय हत्वा वालिं मनोजवम् ।\nअभिषिक्तश्च सुग्रीवो युवराजोऽङ्गदस्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000176040, "chapter_id": 20176, "verse_number": "१७६-४१", "content_sanskrit": "हनुमान्नलनीलश्च जाम्बवान्पनसस्तथा ।\nगवयश्च गवाक्षश्च पाठीनः परमौजसः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000176041, "chapter_id": 20176, "verse_number": "१७६-४२", "content_sanskrit": "एतैश्चान्यैश्च बहुभिर्वानरैः समहाबलैः ।\nसमावृतो महाघोरै रामो राजीवलोचनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000176042, "chapter_id": 20176, "verse_number": "१७६-४३", "content_sanskrit": "गिरीणां सर्वसंघातैः सेतुं बद्‌ध्वा महोदधौ ।\nबलेन महता रामः समुत्तीर्य महोदधिम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000176043, "chapter_id": 20176, "verse_number": "१७६-४४", "content_sanskrit": "संग्राममतुलं चक्रे रक्षोगणसमन्वितः ।\nयमहस्तं प्रहस्तं च निकुम्भं कुम्भमेव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000176044, "chapter_id": 20176, "verse_number": "१७६-४५", "content_sanskrit": "नरान्तकं महावीर्यं तथा चैव यमान्तकम् ।\nमालाढ्यं मालिकाढ्यं च हत्वा रामस्तु वीर्यवान् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000176045, "chapter_id": 20176, "verse_number": "१७६-४६", "content_sanskrit": "पुनरिन्द्रजितं हत्वा कुम्भकर्णं सरावणम् ।\nवैदेहीं चाग्निनाऽऽसोध्य दत्त्वा राज्यं विभिषणे ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000176046, "chapter_id": 20176, "verse_number": "१७६-४७", "content_sanskrit": "वासुदेवं समादाय यानं पुष्पकमारुहत् ।\nलीलया समनुप्रापदयोध्यां पूर्वपालिताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000176047, "chapter_id": 20176, "verse_number": "१७६-४८", "content_sanskrit": "कनिष्ठं भरतं स्नेहाच्छत्रुघ्नं भक्तवत्सलः ।\nलीलया समनुप्रापदयोध्यां पूर्वपालिताम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000176048, "chapter_id": 20176, "verse_number": "१७६-४९", "content_sanskrit": "पुरातनीं स्वमूर्तिं च समाराध्य ततो हरिः ।\nदश वर्षसहस्राणि दश वर्षशतानि च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000176049, "chapter_id": 20176, "verse_number": "१७६-५०", "content_sanskrit": "भुक्ताव सागरपर्यन्तां मेदिनीं स तु राघवः ।\nराज्यमासाद्य सुगतिं वैष्णवं पदमाविशत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000176050, "chapter_id": 20176, "verse_number": "१७६-५१", "content_sanskrit": "तां चापि प्रतिमां रामः समुद्रेशाय दत्तवान् ।\nधन्यो रक्षयितासि त्वं तोयरत्नसमन्वितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000176051, "chapter_id": 20176, "verse_number": "१७६-५२", "content_sanskrit": "द्वापरं युगमासाद्य यदा देवो जगत्पतिः ।\nधरण्याश्चानुरोधेन भावशैथिल्यकारणात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000176052, "chapter_id": 20176, "verse_number": "१७६-५३", "content_sanskrit": "अवतीर्णः स भगवान्वसुदेवकुले प्रभुः ।\nकंसादीनां वधार्थाय संकर्षणसहायवान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000176053, "chapter_id": 20176, "verse_number": "१७६-५४", "content_sanskrit": "तदा तां प्रतिमां विप्राः सर्ववाञ्छाफलप्रदाम् ।\nसर्वलोकहितार्थाय कस्यचित्कारणान्तरे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000176054, "chapter_id": 20176, "verse_number": "१७६-५५", "content_sanskrit": "तस्मिन्क्षेत्रवरे पुण्ये दुर्लभे पुरुषोत्तमे ।\nउज्जहार स्वयं तोयात्समुद्रः सरितां पतिः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000176055, "chapter_id": 20176, "verse_number": "१७६-५६", "content_sanskrit": "तदा प्रभृति तत्रैव क्षेत्रे मुक्तिप्रदे द्विजाः ।\nआस्ते स देवो देवानां सर्वकामफलप्रदः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000176056, "chapter_id": 20176, "verse_number": "१७६-५७", "content_sanskrit": "ये संश्रयन्ति चानन्तं भक्त्या सर्वेश्वरं प्रभुम् ।\nवाङ्मनः कर्मभिर्नित्यं ते यान्ति परमं पदम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000176057, "chapter_id": 20176, "verse_number": "१७६-५८", "content_sanskrit": "दृष्ट्वाऽनन्तं सकृद्‌भक्त्या संपूज्य प्रणिपत्य च ।\nराजसूयाश्वमेधाभ्यां फलं दशगुणं लभेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000176058, "chapter_id": 20176, "verse_number": "१७६-५९", "content_sanskrit": "सर्वकामसमृद्धेन कामगेन सुवर्चसा ।\nविमानेनार्कवर्णेन किङ्किणीजालमालिना ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000176059, "chapter_id": 20176, "verse_number": "१७६-६०", "content_sanskrit": "त्रिःसप्तकुलमुद्धृत्य दिव्यस्त्रीगणसेवितः ।\nउपगीयमानो गन्धर्वैर्नरो विष्णुपुरं व्रजेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000176060, "chapter_id": 20176, "verse_number": "१७६-६१", "content_sanskrit": "तत्र भुक्त्वा वरान्भोगाञ्जरामरणवर्जितः ।\nदिव्यरूपधरः श्रीमान्यावदाभूतसंप्लवम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000176061, "chapter_id": 20176, "verse_number": "१७६-६२", "content_sanskrit": "पुण्यक्षयादिहाऽऽयातश्चतुर्वेदी द्विजोत्तमः ।\nवैष्णवं योगमास्थाय ततो मोक्षमवाप्नुयात् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000176062, "chapter_id": 20176, "verse_number": "१७६-६३", "content_sanskrit": "एवं मया त्वनन्तोऽसौ कीर्तितो मुनिसत्तमाः ।\nकः शक्नोति गुणान्वक्तुं तस्य वर्षशतैरपि ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]