[{"id": 2113041, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "गान्धार्या गर्भधारणम् । अपत्यार्थे पाण्डोश्चिन्ता ।\nप्रजार्थमागृहन्त्या कुन्त्या पाण्डोः व्युषिताश्वचरितवर्णनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113042, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113043, "chapter_id": 3434, "verse_number": "१", "content_sanskrit": "ततः पुत्रशतं जज्ञे गान्धार्यां जनमेजय ।\nधृतराष्ट्रस्य वैश्यायामेकश्चैव शतात् परः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113044, "chapter_id": 3434, "verse_number": "२", "content_sanskrit": "कथञ्चित् सदृशीं भार्यां गान्धारीं धर्मचारिणीम् ।\nवर्तमानं प्रियेष्वेव धृतराष्ट्रोऽन्ववर्तत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113045, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "पाण्डोः कुन्त्यां च माद्र्यां च पञ्च पुत्रा महारथाः ।\nसमपद्यन्त देवेभ्यः सन्तानाय कुलस्य च\t॥३।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113046, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113047, "chapter_id": 3434, "verse_number": "४", "content_sanskrit": "कथं पुत्रशतं जज्ञे गान्धार्या द्विजसत्तम ।\nकियता वापि कालेन तेषामायुश्च किं परम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113048, "chapter_id": 3434, "verse_number": "५", "content_sanskrit": "कथं च शप्तस्य ततः पाण्डोस्तेन महात्मना ।\nसमुत्पन्ना दैवतेभ्यः पञ्च पुत्रा महायशाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113049, "chapter_id": 3434, "verse_number": "६", "content_sanskrit": "एतत् सर्वं यथावृत्तं विस्तरेण तपोधन ।\nकथय त्वं न मे तृप्तिः कथ्यमानेषु बन्धुषु \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113050, "chapter_id": 3434, "verse_number": "७", "content_sanskrit": "कथं चापि स वैश्यायामेकश्चैव शतात् परः ।\nकथं च सदृशीं भार्यां गान्धारीं धर्मचारिणीम् ।\nवर्तमानां प्रियेष्वेव धृतराष्ट्रोऽन्ववर्तत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113051, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113052, "chapter_id": 3434, "verse_number": "८", "content_sanskrit": "तृषितं बुभुक्षितं श्रान्तं द्वैपायनमुपस्थितम् ।\nतोषयामास गान्धारी स तु तस्यै वरं ददौ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113053, "chapter_id": 3434, "verse_number": "९", "content_sanskrit": "सा वव्रे सततं भर्तुः पुत्राणां शतमात्मनः ।\nततः कालेन सा गर्भमगृह्णाज्ज्ञानचक्षुषः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113054, "chapter_id": 3434, "verse_number": "१०", "content_sanskrit": "गान्धार्यामाहिते गर्भे पाण्डुरम्बालिकासुतः ।\nअगच्छत् परमं दुःखमपत्यार्थमरिन्दम \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113055, "chapter_id": 3434, "verse_number": "११", "content_sanskrit": "गर्भिण्यामथ गान्धार्यां पाण्डुः परमदुःखितः ।\nमृगाभिशापादात्मानं शोचन्नुपहतक्रियः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113056, "chapter_id": 3434, "verse_number": "१२", "content_sanskrit": "स गत्वा तपसा सिद्धिं विश्वामित्रो यथा भुवि ।\nदेहन्यासे कृतमना इदं वचनमब्रवीत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113057, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113058, "chapter_id": 3434, "verse_number": "१३", "content_sanskrit": "चतुर्भिरृणवानित्थं जायते मनुजो भुवि ।\nपितृदेवमनुष्याणामृषीणामथ भारत \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113059, "chapter_id": 3434, "verse_number": "१५", "content_sanskrit": "एतेभ्यस्तु यथाकालं यो न मुच्येत धर्मवित् ।\nन तस्य लोकाः सन्तीति तथा लोकविदो विदुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113060, "chapter_id": 3434, "verse_number": "१६", "content_sanskrit": "यज्ञेन देवान् प्रीणाति स्वाध्यायैस्तपसा ऋषीन् ।\nपुत्रैः श्राद्धैरपि पितॄनानृशंस्येन मानुषान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113061, "chapter_id": 3434, "verse_number": "१७", "content_sanskrit": "ऋषिदेवमनुष्याणामतिमुक्तोऽस्मि सर्वदा ।\nन पितॄणां च मुक्तोऽस्मि तच्च तेभ्यो विशिष्यते \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113062, "chapter_id": 3434, "verse_number": "१८", "content_sanskrit": "देहनाशे ध्रुवो नाशः पितॄणामथ निश्चयः ।\nइतरेषां त्रयाणां तु नाशे ह्मात्मा विनश्यत्ति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113063, "chapter_id": 3434, "verse_number": "१९", "content_sanskrit": "पितॄणामृणनाशाद्धि सप्रजो नाशमृच्छति ।\nइह तस्मात् प्रजालामे प्रयतन्ते द्विजोत्तमाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113064, "chapter_id": 3434, "verse_number": "२०", "content_sanskrit": "यथैवाहं पितुः क्षेत्रे सृष्टस्तेन महात्मना ।\nतथैवास्मिन् मम क्षेत्रे कथं सृज्येत वै प्रजाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113065, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113066, "chapter_id": 3434, "verse_number": "२१", "content_sanskrit": "स समानीय कुन्तीं च माद्रीं च भरतर्षभः ।\nआचष्ट पुत्रलाभस्य व्युष्टिं सर्वक्रियाधिकाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113067, "chapter_id": 3434, "verse_number": "२२", "content_sanskrit": "उत्तमादवराः पुंसः काङ्क्षन्ते पुत्रमापदि ।\nअपत्यं धर्मफलदं श्रेष्ठादिच्छन्ति साधवः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113068, "chapter_id": 3434, "verse_number": "२३", "content_sanskrit": "अनुनीय तु ते सम्यङ् महाब्राह्मणसंसदि ।\nब्राह्मणं गुणवन्तं वै चिन्तयामास धर्मवित्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113069, "chapter_id": 3434, "verse_number": "२४", "content_sanskrit": "सोऽब्रवीद् विजने कुन्तीं धर्मपत्नीं यशस्विनीम् ।\nअपत्यस्य सुसंयोगमापदि प्रसमीक्ष्य च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113070, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113071, "chapter_id": 3434, "verse_number": "२५", "content_sanskrit": "नानपत्यस्य मे लोके प्रतिष्ठा धर्मसंहिता ।\nइति कुन्ति विदुर्धर्मं शाश्वतं धर्मचारिणः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113072, "chapter_id": 3434, "verse_number": "२६", "content_sanskrit": "इष्टं दत्तं तपस्तप्तं नियमाश्च स्वनुष्ठिताः ।\nसर्वमेवानपत्यस्य मोघं भवति निश्चयम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113073, "chapter_id": 3434, "verse_number": "२७", "content_sanskrit": "सोऽहमेवं व्यवसितः प्रेक्ष्यात्मानं न सङ्क्षमे ।\nअनपत्यो हि मरणं कामये नोत जीवितम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113074, "chapter_id": 3434, "verse_number": "२८", "content_sanskrit": "मृगाभिशापाज्जानासि वृजिने मम केवलम् ।\nनृशंसं कर्मणा कृत्स्स्नं यथा ह्युपगतं तथा \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113075, "chapter_id": 3434, "verse_number": "३०", "content_sanskrit": "षडेव बन्धुदायादाः पुत्राः सद्धर्मचारिणः ।\nषडेवाबन्धुदायादाः निर्दिष्टास्तान् शृणु प्रिये \t॥२९॥\nस्वयञ्जातः क्षेत्रिकश्च परिक्रीतश्च यः सुतः ।\nपौनर्भवेयः कानीनो स्वैरिण्या यश्च जायते \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113076, "chapter_id": 3434, "verse_number": "३१", "content_sanskrit": "दत्तः क्रीतो गर्हितश्च उपयच्छेत् स्वयं च यः ।\nसहोढाजातरेताश्च हीनयोनिधृतश्च यः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113077, "chapter_id": 3434, "verse_number": "३२", "content_sanskrit": "पूर्वपूर्वमसम्भावं मत्वा लिप्सेत वै सुतम् ।\nउत्तमादवरं जन्म काङ्क्षन्ते धर्मचारिणः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113078, "chapter_id": 3434, "verse_number": "३३", "content_sanskrit": "फलं महदपत्यस्य तस्य भूतिरनुग्रहः ।\nआपद्यपत्यजननं मनुः स्वायम्भुवोऽब्रवीत् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113079, "chapter_id": 3434, "verse_number": "३४", "content_sanskrit": "तस्मात् त्वां प्रहिणोम्यद्य प्रहीणः प्रजया स्वयम् ।\nक्षत्रियाच्छ्रेयसो वाऽपि सूष्वापत्यं यशस्विनि \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113080, "chapter_id": 3434, "verse_number": "३५", "content_sanskrit": "या हि ते भगिनी साध्वी श्रुतसेना यशस्विनी ।\nउवाह यां तु कैकेयः शारदण्डायनिर्महान्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113081, "chapter_id": 3434, "verse_number": "३६", "content_sanskrit": "सा वीरपत्नी स्वजनैर्नियुक्ताऽपत्यकर्मणि ।\nपुष्पेण प्रयता स्नाता निशि कुन्ति चतुष्पथे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113082, "chapter_id": 3434, "verse_number": "३७", "content_sanskrit": "अपत्यार्थे प्रजालाभे अन्वगच्छच्छुभव्रता ।\nवरयित्वा द्विजं देवी हुते पुंसवने पुरा \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113083, "chapter_id": 3434, "verse_number": "३८", "content_sanskrit": "कर्मण्यवसिते तस्मिन् सा तेनैव सहावसत् ।\nसा त्रीन् वीरानजनयद् दुर्जयादीन् महारथान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113084, "chapter_id": 3434, "verse_number": "३९", "content_sanskrit": "तथा त्वमपि कल्याणि ब्राह्मणं तपसाऽधिकम् ।\nमन्नियोगात् कुरु क्षिप्रमपत्योत्पादनं महत्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113085, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113086, "chapter_id": 3434, "verse_number": "४०", "content_sanskrit": "एवमुक्ता महाराज कुन्ती तं प्रत्यभाषत ।\nकुरुणामृषभं वीरं तदा भूमिपतिं पतिम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113087, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113088, "chapter_id": 3434, "verse_number": "४१", "content_sanskrit": "न मामर्हसि धर्मज्ञ वक्तुमेवं कथञ्चन ।\nधर्मपत्नीमभिरतां राजन् राजीवलोचन \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113089, "chapter_id": 3434, "verse_number": "४२", "content_sanskrit": "त्वमेव हि महाबाहो मय्यपत्यानि भारत ।\nवीर वीर्योपपन्नानि सम्पादयितुमर्हसि \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113090, "chapter_id": 3434, "verse_number": "४३", "content_sanskrit": "स्वर्गं मनुजशार्दूल गच्छावो वा तवेप्सितम् ।\nअपत्याय च मां गच्छ त्वमेव कुरुपुङ्गव \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113091, "chapter_id": 3434, "verse_number": "४४", "content_sanskrit": "नह्मावां मनसाऽप्यन्यं गच्छाव पुरुषर्षभ ।\nत्वत्तः प्रतिविशिष्टः सन् को योऽन्यो भुवि मानवः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113092, "chapter_id": 3434, "verse_number": "४५", "content_sanskrit": "इमां धर्म्यां धर्म्यकथां मम चैव निबोधय ।\nपौराणिकीं विशलाक्ष कीर्तयिष्यामि भारत \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2113093, "chapter_id": 3434, "verse_number": "४६", "content_sanskrit": "व्युषिताश्व इति ख्यातो बभूव किल भारत ।\nपुरा परमधर्मज्ञः पूरोर्वंशविवर्धनः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2113094, "chapter_id": 3434, "verse_number": "४७", "content_sanskrit": "तस्मिंश्च यजमाने वै धर्मात्मनि महात्मनि ।\nआगच्छंस्त्रिदशाः सर्वे सेन्द्राः सर्वमहर्षिभिः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2113095, "chapter_id": 3434, "verse_number": "४८", "content_sanskrit": "अमाद्यदिन्द्रः सोमेन तुतुषुर्गुरवो धनैः ।\nव्युषिताश्वस्य राजर्षेस्तदा यज्ञे महात्मनः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2113096, "chapter_id": 3434, "verse_number": "४९", "content_sanskrit": "व्युषिताश्वो मनुष्येन्द्रः शुशुभे यज्ञसम्पदा ।\nसर्वभूतेषु राजेन्द्र शरत्काल इवांशुमान्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2113097, "chapter_id": 3434, "verse_number": "५०", "content_sanskrit": "स विजित्य गृहीत्वा तु नृपतीन् राजसत्तमः ।\nप्राच्यानुदीच्यान् मत्स्यांश्च दक्षिणा अभ्यकल्पयत् \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2113098, "chapter_id": 3434, "verse_number": "५१", "content_sanskrit": "अश्वमेधशतैरिष्ट्वा व्युषिताश्वः प्रतापवान् ।\nबभूव नृपशार्दूल नागायुतबलः किल \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2113099, "chapter_id": 3434, "verse_number": "५२", "content_sanskrit": "गाथामप्यत्र गायन्ति ये पुराणविदो जनाः ।\nअप्रमेयमपर्यन्तं व्युषिताश्वो धनं ददौ \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2113100, "chapter_id": 3434, "verse_number": "५३", "content_sanskrit": "व्युषिताश्वः समुद्रान्तां विजित्येमां वसुन्धराम् ।\nअपालयत् सर्ववर्णान् पिता पुत्रानिवौरसान्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2113101, "chapter_id": 3434, "verse_number": "५४", "content_sanskrit": "यजमानो महायज्ञैर्ब्राह्मणेभ्यो महद्धनम् ।\nअनन्तामखिलां तत्र पृथिवीमददात् ततः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2113102, "chapter_id": 3434, "verse_number": "५५", "content_sanskrit": "सुषाव च बहून् सोमान् सोमसंस्थां तथैव च ।\nआसीत् काक्षीवती तस्य भार्या परमसंमता\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2113103, "chapter_id": 3434, "verse_number": "५६", "content_sanskrit": "भद्रा नाम मनुष्येन्द्र रूपेणासदृशी भुवि ।\nकामयामासतुश्चैव परस्परमिति श्रुतम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2113104, "chapter_id": 3434, "verse_number": "५७", "content_sanskrit": "स तस्यां कामसंयुक्तो यक्ष्माणं समपद्यत ।\nअचिरेणैव कालेन जगामास्तमिवांशुमान् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2113105, "chapter_id": 3434, "verse_number": "५८", "content_sanskrit": "तस्मिन् मृते मनुष्येन्द्र भार्या काक्षीवती तदा ।\nअपुत्रा पुरुषव्याघ्र विललापेति नः श्रुतम् ।\nभद्रा परमदुःखार्ता तन्निबोध कुरूत्तम \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2113106, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "भद्रा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2113107, "chapter_id": 3434, "verse_number": "५९", "content_sanskrit": "नारी परमधर्मज्ञा सर्वा पुत्रविनाकृता ।\nपत्या विना जीवति या न स जीवत्यसंशयम् \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2113108, "chapter_id": 3434, "verse_number": "६०", "content_sanskrit": "पत्या विना मृतं श्रेयो नार्याः क्षत्रियपुङ्गव ।\nतद्गतिं गन्तुमिच्छामि प्रसीदस्व नयस्व माम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2113109, "chapter_id": 3434, "verse_number": "६१", "content_sanskrit": "त्वया हीना क्षणमपि नाहं जीवितुमुत्सहे ।\nप्रसादं कुरु मे राजन्नितः क्षिप्रं नयस्व माम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2113110, "chapter_id": 3434, "verse_number": "६२", "content_sanskrit": "पृष्ठतोऽनुगमिष्यामि समेषु विषमेषु च ।\nत्वामहं नरशार्दूल गच्छन्तमनुवर्तिनी\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2113111, "chapter_id": 3434, "verse_number": "६३", "content_sanskrit": "छायेवानुगता राजंस्तवाहं वशवर्तिनी ।\nभविष्यामि नरव्याघ्र नित्यं प्रियहितैषिणी\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2113112, "chapter_id": 3434, "verse_number": "६४", "content_sanskrit": "अद्यप्रभृति मे राजन् कष्टा हृदयशोषणाः ।\nआधयो हि भविष्यन्ति त्वदृते पुष्करेक्षण\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2113113, "chapter_id": 3434, "verse_number": "६५", "content_sanskrit": "अभाग्यया मया नूनं विमुक्ताः सहचारिणः ।\nसंयोगाद् विप्रयुक्ताश्च पूर्वदेहे न संशयः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2113114, "chapter_id": 3434, "verse_number": "६६", "content_sanskrit": "तदिदं कर्मभिः पापैः पूर्वदेहेषु सञ्चितैः ।\nदुःखं मामनुसम्प्राप्तं राजंस्त्वद्विप्रयोगजम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2113115, "chapter_id": 3434, "verse_number": "६७", "content_sanskrit": "एषाहमद्य राजेन्द्र कुशानास्तीर्य शायिनी ।\nभविष्यामि नरव्याघ्र भवद्दर्शनकाङ्क्षिणी \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2113116, "chapter_id": 3434, "verse_number": "६८", "content_sanskrit": "दर्शयस्व मनुष्येन्द्र साधु मां पुष्करेक्षण ।\nविक्रोशन्तीं सतीं भार्यां दुःखार्तां च नरेश्चर \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2113117, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2113118, "chapter_id": 3434, "verse_number": "६९", "content_sanskrit": "एवं बहुविधास्तस्या विलपन्त्याः पुनः पुनः ।\nतस्मिन् शवशरीरे वाक् तां किलन्तर्हिताऽब्रवीत्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2113119, "chapter_id": 3434, "verse_number": "७०", "content_sanskrit": "उत्तिष्ठ भद्रे गच्छ त्वं ददानि हि वरं तव ।\nजनयिष्याम्यपत्यानि त्वय्येवाहं वरानने \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2113120, "chapter_id": 3434, "verse_number": "७१", "content_sanskrit": "आत्मीये तु वरारोहे शयने मां चतुर्दशीम् ।\nअष्टमीं वाप्यृतुस्नाता सम्भवेथाः शुचिस्मिते \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2113121, "chapter_id": 3434, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2113122, "chapter_id": 3434, "verse_number": "७२", "content_sanskrit": "एवमुक्ताऽथ सा देवी तच्चकार यशस्विनी ।\nतथा कमलपत्राक्षी यथोक्तं पुत्रगर्धिनी\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2113123, "chapter_id": 3434, "verse_number": "७३", "content_sanskrit": "सा तेन सुषुवे देवी शवेन मनुजाधिप ।\nत्रीन् साल्वांश्चतुरो मद्रान् पुत्रान् भरतसत्तम\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2113124, "chapter_id": 3434, "verse_number": "७४", "content_sanskrit": "तथा त्वमपि मय्येव मनसाऽपि नरर्षभ ।\nशक्तो जनयितुं राजन्नपत्यं तपसो बलात्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2113125, "chapter_id": 3434, "verse_number": "६१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रयोदशाधिकशततमोऽध्यायः ॥११३॥\n॥ इति सम्भवपर्वणि एकषष्टितमोऽध्यायः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]