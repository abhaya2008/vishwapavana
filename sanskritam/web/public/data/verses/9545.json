[{"id": 5000545000, "chapter_id": 9545, "verse_number": "७-१०-१", "content_sanskrit": "अथाब्रवीन्मुनिं रामः कथं ते भ्रातरो वने ।\nकीदृशं तु तदा ब्रह्मंस्तपस्तेपुर्महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000545001, "chapter_id": 9545, "verse_number": "७-१०-२", "content_sanskrit": "अगस्त्यस्त्वब्रवीत्तत्र रामं सुप्रीतमानसम् ।\nतांस्तान्धर्मविधींस्तत्र भ्रातरस्ते समाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000545002, "chapter_id": 9545, "verse_number": "७-१०-३", "content_sanskrit": "कुम्भकर्णस्ततो यत्तो नित्यं धर्मपथे स्थितः ।\nतताप ग्रीष्मकाले तु पञ्चाग्नीन्परितः स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000545003, "chapter_id": 9545, "verse_number": "७-१०-४", "content_sanskrit": "मेघाम्बुसिक्तो वर्षासु वीरासनमसेवत ।\nनित्यं च शिशिरे काले जलमध्यप्रतिश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000545004, "chapter_id": 9545, "verse_number": "७-१०-५", "content_sanskrit": "एवं वर्षसहस्राणि दश तस्यातिचक्रमुः ।\nधर्मे प्रयतमानस्य सत्पथे निष्ठितस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000545005, "chapter_id": 9545, "verse_number": "७-१०-६", "content_sanskrit": "विभीषणस्तु धर्मात्मा नित्यं धर्मपरः शुचिः ।\nपञ्चवर्षसहस्राणि पादेनैकेन तस्थिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000545006, "chapter_id": 9545, "verse_number": "७-१०-७", "content_sanskrit": "समाप्ते नियमे तस्य ननृतुश्चाप्सरोगणाः ।\nपपात पुष्पवर्षं च क्षुभिताश्चापि देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000545007, "chapter_id": 9545, "verse_number": "७-१०-८", "content_sanskrit": "पञ्चवर्षसहस्राणि सूर्यं चैवान्ववर्तत ।\nतस्थौ चोर्ध्वशिरोबाहुः स्वाध्यायधृतमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000545008, "chapter_id": 9545, "verse_number": "७-१०-९", "content_sanskrit": "एवं विभीषणस्यापि स्वर्गस्थस्येव नन्दने ।\nदशवर्षसहस्राणि गतानि नियतात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000545009, "chapter_id": 9545, "verse_number": "७-१०-१०", "content_sanskrit": "दशवर्षसहस्रं तु निराहारो दशाननः ।\nपूर्णे वर्षसहस्रे तु शिरश्चाग्नौ जुहाव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000545010, "chapter_id": 9545, "verse_number": "७-१०-११", "content_sanskrit": "एवं वर्षसहस्राणि नव तस्यातिचक्रमुः ।\nशिरांसि नव चाप्यस्य प्रविष्टानि हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000545011, "chapter_id": 9545, "verse_number": "७-१०-१२", "content_sanskrit": "अथ वर्षसहस्रे तु दशमे दशमं शिरः ।\nछेत्तुकामे दशग्रीवे प्राप्तस्तत्र पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000545012, "chapter_id": 9545, "verse_number": "७-१०-१३", "content_sanskrit": "पितामहस्तु सुप्रीतः सार्धं देवैरुपस्थितः ।\nतव तावद्दशग्रीव प्रीतो ऽस्मीत्यभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000545013, "chapter_id": 9545, "verse_number": "७-१०-१४", "content_sanskrit": "शीघ्रं वरय धर्मज्ञ वरो यस्ते ऽभिकाङ्क्षितः ।\nकं ते कामं करोम्यद्य न वृथा ते परिश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000545014, "chapter_id": 9545, "verse_number": "७-१०-१५", "content_sanskrit": "अथाब्रवीदृशग्रीवः प्रहृष्टेनान्तरात्मना ।\nप्रणम्य शिरसा देवं हर्षगद्गदया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000545015, "chapter_id": 9545, "verse_number": "७-१०-१६", "content_sanskrit": "भगवन्प्राणिनां नित्यं नान्यत्र मरणाद्भयम् ।\nनास्ति मृत्युसमः शत्रुरमरत्वमहं वृणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000545016, "chapter_id": 9545, "verse_number": "७-१०-१७", "content_sanskrit": "एवमुक्तस्तदा ब्रह्मा दशग्रीवमुवाच ह ।\nनास्ति सर्वामरत्वं ते वरमन्यं वृणीष्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000545017, "chapter_id": 9545, "verse_number": "७-१०-१८", "content_sanskrit": "एवमुक्ते तदा राम ब्रह्मणा लोककर्तृणा ।\nदशग्रीव उवाचेदं कृताञ्जलिरथाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000545018, "chapter_id": 9545, "verse_number": "७-१०-१९", "content_sanskrit": "सुपर्णनागयक्षाणां दैत्यदानवरक्षसाम् ।\nअवध्यो ऽहं प्रजाध्यक्ष देवतानां च शाश्वत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000545019, "chapter_id": 9545, "verse_number": "७-१०-२०", "content_sanskrit": "नहि चिन्ता ममान्येषु प्राणिष्वमरपूजित ।\nतृणभूता हि ते मन्ये प्राणिनो मानुषादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000545020, "chapter_id": 9545, "verse_number": "७-१०-२१", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा दशग्रीवेण रक्षसा ।\nउवाच वचनं देवः सह देवैः पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000545021, "chapter_id": 9545, "verse_number": "७-१०-२२", "content_sanskrit": "भविष्यत्येवमेतत्ते वचो राक्षसपुङ्गव ।\nएवमुक्त्वा तु तं राम दशग्रीवं पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000545022, "chapter_id": 9545, "verse_number": "७-१०-२३", "content_sanskrit": "शृणु चापि वरो भूयः प्रीतस्येह शुभो मम ।\nहुतानि यानि शीर्षाणि पूर्वमग्नौ त्वयानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000545023, "chapter_id": 9545, "verse_number": "७-१०-२४", "content_sanskrit": "पुनस्तानि भविष्यन्ति तथैव तव राक्षस ।\nवितरामीह ते सौम्य वरं चान्यं दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000545024, "chapter_id": 9545, "verse_number": "७-१०-२५", "content_sanskrit": "छन्दतस्तव रूपं च मनसा यद्यथेप्सितम् ।\nभविष्यति न सन्देहो मद्वरात्तवराक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000545025, "chapter_id": 9545, "verse_number": "७-१०-२६", "content_sanskrit": "एवं पितामहोक्तस्य दशग्रीवस्य रक्षसः ।\nअग्नौ हुतानि शीर्षाणि पुनस्तान्युत्थितानि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000545026, "chapter_id": 9545, "verse_number": "७-१०-२७", "content_sanskrit": "एवमुक्त्वा तु तं राम दशग्रीवं पितामहः ।\nविभीषणमथोवाच वाक्यं लोकपितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000545027, "chapter_id": 9545, "verse_number": "७-१०-२८", "content_sanskrit": "विभीषण त्वया वत्स धर्मसंहितबुद्धिना ।\nपरितुष्टो ऽस्मि धर्मात्मन्वरं वरय सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000545028, "chapter_id": 9545, "verse_number": "७-१०-२९", "content_sanskrit": "विभीषणस्तु धर्मात्मा वचनं प्राह साञ्जलिः ।\nवृतः सर्वगुणैर्नित्यं चन्द्रमा रश्मिभिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000545029, "chapter_id": 9545, "verse_number": "७-१०-३०", "content_sanskrit": "भगवन्कृतकृत्यो ऽहं यन्मे लोकगुरुः स्वयम् ।\nप्रीतेन यदि दातव्यो वरो मे शृणु सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000545030, "chapter_id": 9545, "verse_number": "७-१०-३१", "content_sanskrit": "परमापद्गतस्यापि धर्मे मम मतिर्भवेत् ।\nअशिक्षितं च ब्रह्मास्त्रं भगवन्प्रतिभातु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000545031, "chapter_id": 9545, "verse_number": "७-१०-३२", "content_sanskrit": "या या मे जायते बुद्धिर्येषु येष्वाश्रमेषु च ।\nसा सा भवतु धर्मिष्ठा तं तु धर्मं च पालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000545032, "chapter_id": 9545, "verse_number": "७-१०-३३", "content_sanskrit": "एष मे परमोदार वरः परमको मतः ।\nनहि धर्माभिरक्तानां लोके किञ्चन दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000545033, "chapter_id": 9545, "verse_number": "७-१०-३४", "content_sanskrit": "पुनः प्रजापतिः प्रीतो विभीषणमुवाच ह ।\nधर्मिष्ठस्त्वं यथा वत्स तथा चैतद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000545034, "chapter_id": 9545, "verse_number": "७-१०-३५", "content_sanskrit": "यस्माद्राक्षसयोनौ ते जातस्यामित्रनाशन ।\nनाधर्मे जायते बुद्धिरमरत्वं ददामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000545035, "chapter_id": 9545, "verse_number": "७-१०-३६", "content_sanskrit": "इत्युक्त्वा कुम्भकर्णाय वरं दातुमुपस्थितम् ।\nप्रजापतिं सुराः सर्वे वाक्यं प्राञ्जलयो ऽब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000545036, "chapter_id": 9545, "verse_number": "७-१०-३७", "content_sanskrit": "न तावत्कुम्भकर्णाय प्रदातव्यो वरस्त्वया ।\nजानीषे हि यथा लोकांस्त्रासयत्येष दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000545037, "chapter_id": 9545, "verse_number": "७-१०-३८", "content_sanskrit": "नन्दने ऽप्सरसः सप्त महेन्द्रानुचरा दश ।\nअनेन भक्षिता ब्रह्मन्नृषयो मानुषास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000545038, "chapter_id": 9545, "verse_number": "७-१०-३९", "content_sanskrit": "अलब्धवरपूर्वेण यत्कृतं राक्षसेन तु ।\nतदेष वरलब्धः स्याद्भक्षयेद्भुवनत्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000545039, "chapter_id": 9545, "verse_number": "७-१०-४०", "content_sanskrit": "वरव्याजेन मोहो ऽस्मै दीयताममितप्रभ ।\nलोकानां स्वस्ति चैवं स्याद्भवेदस्य च सन्नतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000545040, "chapter_id": 9545, "verse_number": "७-१०-४१", "content_sanskrit": "एवमुक्तः सुरैर्ब्रह्मा ऽचिन्तयत् पद्मसम्भवः ।\nचिन्तिता चोपतस्थे ऽस्य पार्श्वं देवी सरस्वती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000545041, "chapter_id": 9545, "verse_number": "७-१०-४२", "content_sanskrit": "प्राञ्जलिः सा तु पार्श्वस्था प्राह वाक्यं सरस्वती ।\nइयमस्म्यागता देव किं कार्यं करवाण्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000545042, "chapter_id": 9545, "verse_number": "७-१०-४३", "content_sanskrit": "प्रजापतिस्तुं तां प्राप्तां प्राह वाक्यं सरस्वतीम् ।\nवाणि त्वं राक्षसेन्द्रस्य भव या देवतेप्सिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000545043, "chapter_id": 9545, "verse_number": "७-१०-४४", "content_sanskrit": "तथेत्युक्त्वा प्रविष्टा सा प्रजापतिरथाब्रवीत् ।\nकुम्भकर्ण महाबाहो वरं वरय यो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000545044, "chapter_id": 9545, "verse_number": "७-१०-४५", "content_sanskrit": "कुम्भकर्णस्तु तद्वाक्यं श्रुत्वा वचनमब्रवीत् ।\nस्वप्तुं वर्षाण्यनेकानि देवदेव ममेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000545045, "chapter_id": 9545, "verse_number": "७-१०-४६", "content_sanskrit": "एवमस्त्विति तं चोक्त्वा प्रायाद्ब्रह्मा सुरैः समम् ।\nदेवी सरस्वती चैव राक्षसं तं जहौ पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000545046, "chapter_id": 9545, "verse_number": "७-१०-४७", "content_sanskrit": "ब्रह्मणा सह देवेषु गतेषु च नभःस्थलम् ।\nविमुक्तो ऽसौ सरस्वत्या स्वां सञ्ज्ञां च ततो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000545047, "chapter_id": 9545, "verse_number": "७-१०-४८", "content_sanskrit": "कुम्भकर्णस्तु दुष्टात्मा चिन्तयामास दुःखितः ।\nईदृशं किमिदं वाक्यं ममाद्य वदनाच्च्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000545048, "chapter_id": 9545, "verse_number": "७-१०-४९", "content_sanskrit": "अहं व्यामोहितो देवैरिति मन्ये तदा ऽ ऽगतैः ।\nएवं लब्धवराः सर्वे भ्रातरो दीप्ततेजसः ।\nश्लेष्मातकवनं गत्वा तत्र ते न्यवसन्सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000545049, "chapter_id": 9545, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]