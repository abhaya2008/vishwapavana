[{"id": 7000448000, "chapter_id": 20448, "verse_number": "२-१२०-१", "content_sanskrit": "कुंजल उवाच ।\nकामोदाख्यं पुरं दिव्यं सर्वदेवसमाकुलम् ।\nसर्वकामसमृद्ध्यर्थमपश्यन्नारदस्ततः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000448001, "chapter_id": 20448, "verse_number": "२-१२०-२", "content_sanskrit": "कामोदाया गृहं प्राप्य प्रविवेश द्विजोत्तमः ।\nकामोदां तु ततो दृष्ट्वा सर्वकामसमाकुलाम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000448002, "chapter_id": 20448, "verse_number": "२-१२०-३", "content_sanskrit": "तया संपूजितो विप्रः सुवाक्यैः स्वागतादिभिः ।\nदिव्यासने समारूढस्तां पप्रच्छ द्विजोत्तमः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000448003, "chapter_id": 20448, "verse_number": "२-१२०-४", "content_sanskrit": "सुखेन स्थीयते भद्रे विष्णुतेजः समुद्भवे ।\nअनामयं च पप्रच्छ आशीर्भिरभिनंद्य ताम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000448004, "chapter_id": 20448, "verse_number": "२-१२०-५", "content_sanskrit": "कामोदोवाच ।\nप्रसादाद्भवतां विष्णोः सुखेन वर्तयाम्यहम् ।\nकथयस्व महाप्राज्ञ त्वं प्रश्नोत्तरकारणम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000448005, "chapter_id": 20448, "verse_number": "२-१२०-६", "content_sanskrit": "महामोहः समुत्पन्नो ममांगे मुनिपुंगव ।\nव्यापकः सर्वलोकानां ममांगे मतिनाशकः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000448006, "chapter_id": 20448, "verse_number": "२-१२०-७", "content_sanskrit": "तस्मान्निद्रा समुत्पन्ना यथा मर्त्येषु वर्तते ।\nसुप्तया तु मया दृष्टः स्वप्नो वै दारुणो मुने॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000448007, "chapter_id": 20448, "verse_number": "२-१२०-८", "content_sanskrit": "केनाप्युक्तं समेत्यैव पुरतो द्विजसत्तम ।\nअव्यक्तोऽसौ हृषीकेशः संसारं स गमिष्यति॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000448008, "chapter_id": 20448, "verse_number": "२-१२०-९", "content_sanskrit": "तदा प्रभृति दुःखेन व्यापिताहं महामते ।\nतन्मे त्वं कारणं ब्रूहि भवाञ्ज्ञानवतां वरः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000448009, "chapter_id": 20448, "verse_number": "२-१२०-१०", "content_sanskrit": "नारद उवाच ।\nवातिकः पैत्तिकश्चैव कफजः सान्निपातिकः ।\nस्वप्नः प्रवर्तते भद्रे मानवेषु न संशयः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000448010, "chapter_id": 20448, "verse_number": "२-१२०-११", "content_sanskrit": "न जायते च देवेषु स्वप्नो निद्रा च सुंदरि ।\nआदित्योदयवेलायां दृश्यते स्वप्न उत्तमः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000448011, "chapter_id": 20448, "verse_number": "२-१२०-१२", "content_sanskrit": "सत्स्वप्नो मानवानां हि पुण्यस्य फलदायकः ।\nअन्यदेवं प्रवक्ष्यामि स्वप्नस्य कारणं शुभे॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000448012, "chapter_id": 20448, "verse_number": "२-१२०-१३", "content_sanskrit": "महावातांदोलनैश्च चलंत्यापो वरानने ।\nत्रुटंत्यंबुकणाः सूक्ष्मास्तस्मादुदकसंचयात्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000448013, "chapter_id": 20448, "verse_number": "२-१२०-१४", "content_sanskrit": "बहिरेव पतंत्येते निर्मलांबुकणाः शुभे ।\nपुनर्लयं प्रयांत्येते दृश्यादृश्या भवंति वै॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000448014, "chapter_id": 20448, "verse_number": "२-१२०-१५", "content_sanskrit": "तद्वत्स्वप्नस्य वै भावः कथ्यते शृणु भामिनि ।\nआत्मा शुद्धो विरक्तस्तु रागद्वेषविवर्जितः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000448015, "chapter_id": 20448, "verse_number": "२-१२०-१६", "content_sanskrit": "पंचभूतात्मकानां च मुषित्वैव सुनिश्चलः ।\nषड्विंशतिसु तत्वानां मध्ये चैष विराजते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000448016, "chapter_id": 20448, "verse_number": "२-१२०-१७", "content_sanskrit": "शुद्धात्मा केवलो नित्यः प्रकृतेः संगतिं गतः ।\nतद्भावैर्वायुरूपैश्च चलते स्थानतो यदा॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000448017, "chapter_id": 20448, "verse_number": "२-१२०-१८", "content_sanskrit": "आत्मनस्तेजसश्चैव प्रतितेजः प्रजायते ।\nअंतरात्मा शुभं नाम तस्य एव प्रकथ्यते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000448018, "chapter_id": 20448, "verse_number": "२-१२०-१९", "content_sanskrit": "पयसश्च यथा भिन्ना भवंत्यंबुकणाः शुभे ।\nआत्मनस्तु तथा तेज अंतरात्मा प्रकथ्यते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000448019, "chapter_id": 20448, "verse_number": "२-१२०-२०", "content_sanskrit": "स हि पृथ्वी स वै वायुः स चाप्याकाश एव हि ।\nस वै तोयं स दीप्येत एते पंच पुरा कृताः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000448020, "chapter_id": 20448, "verse_number": "२-१२०-२१", "content_sanskrit": "आत्मनस्तेजसो भूता मलरूपा महात्मनः ।\nतस्यापि संगतिं प्राप्ता एकत्वं हि प्रयांति ते॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000448021, "chapter_id": 20448, "verse_number": "२-१२०-२२", "content_sanskrit": "स्वात्मभावप्रदोषेण नाशयंति वरानने ।\nतत्पिंडमन्यमिच्छंति वारं वारं वरानने॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000448022, "chapter_id": 20448, "verse_number": "२-१२०-२३", "content_sanskrit": "तेषां क्रीडाविहारोयं सृष्टिसंबंधकारणम् ।\nउदकस्य तरंगस्तु जायते च विलीयते॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000448023, "chapter_id": 20448, "verse_number": "२-१२०-२४", "content_sanskrit": "पुनर्भूतिः पुनर्हानिस्तादृशस्य पुनः पुनः ।\nअपां रूपस्य दृष्टांतं तद्वदेषां न संशयः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000448024, "chapter_id": 20448, "verse_number": "२-१२०-२५", "content_sanskrit": "आत्मा न नश्यते देवि तेजो वायुर्न नश्यति ।\nन नश्यतो धराकाशौ न नश्यंत्याप एव च॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000448025, "chapter_id": 20448, "verse_number": "२-१२०-२६", "content_sanskrit": "पंचैव आत्मना सार्द्धं प्रभवंति प्रयांति च ।\nआत्मादयो ह्यमी भद्रे नित्यरूपा न संशयः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000448026, "chapter_id": 20448, "verse_number": "२-१२०-२७", "content_sanskrit": "पिंड एव प्रणश्येत तेषां संजात एव च ।\nविषयाणां सुदोषैः स रागद्वेषादिभिर्हतः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000448027, "chapter_id": 20448, "verse_number": "२-१२०-२८", "content_sanskrit": "प्राणाः प्रयांति वै पिंडात्पंचपंचात्मका द्विज ।\nपिंडांते वसते आत्मा प्रतिरूपस्तु तस्य च॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000448028, "chapter_id": 20448, "verse_number": "२-१२०-२९", "content_sanskrit": "अंतरात्मा यथा चाग्नेः स्फुलिंगस्तु प्रकाशते ।\nतथा प्रकाशमायाति दृश्यादृश्यः प्रजायते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000448029, "chapter_id": 20448, "verse_number": "२-१२०-३०", "content_sanskrit": "शुद्धात्मा च परं ब्रह्म सदा जागर्ति नित्यशः ।\nअंतरात्मा प्रबद्धस्तु प्रकृतेश्च महागुणैः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000448030, "chapter_id": 20448, "verse_number": "२-१२०-३१", "content_sanskrit": "अन्नाहारेण संपुष्टैरंतरात्मा सुखं व्रजेत् ।\nसुसुखाज्जायते मोहस्तस्मान्मनः प्रमुह्यति॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000448031, "chapter_id": 20448, "verse_number": "२-१२०-३२", "content_sanskrit": "पश्चात्संजायते निद्रा तामसी लयवर्द्धिनी ।\nनाडीमार्गेण यः सूर्यो मेरुमुल्लंघ्य गच्छति॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000448032, "chapter_id": 20448, "verse_number": "२-१२०-३३", "content_sanskrit": "तदा रात्रिः प्रजायेत यावन्नोदयते रविः ।\nविषयांधकारैर्मुक्तस्तु अंतरात्मा प्रकाशते॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000448033, "chapter_id": 20448, "verse_number": "२-१२०-३४", "content_sanskrit": "भावैस्तत्त्वात्मकानां तु पंचतत्त्वैः प्रपोषितैः ।\nपूर्वजन्मस्थितैः पिंडैरंतरात्मा प्रगृह्यते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000448034, "chapter_id": 20448, "verse_number": "२-१२०-३५", "content_sanskrit": "स यास्यति च वै स्थानमुच्चावचं महामते ।\nसंसार अंतरात्मा वै दोषैर्बद्धः प्रणीयते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000448035, "chapter_id": 20448, "verse_number": "२-१२०-३६", "content_sanskrit": "कायं रक्षति जीवात्मा पश्चात्तिष्ठति मध्यगः ।\nउदानः स्फुरते तीव्रस्तस्माच्छब्दः प्रजायते॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000448036, "chapter_id": 20448, "verse_number": "२-१२०-३७", "content_sanskrit": "शुष्का भस्त्रा यथा श्वासं कुरुते वायुपूरिता ।\nतद्वच्छब्दवशाच्छ्वासमुदानः कुरुते बलात्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000448037, "chapter_id": 20448, "verse_number": "२-१२०-३८", "content_sanskrit": "आत्मनस्तु प्रभावेण उदानो बलवान्भवेत् ।\nएवं कायः प्रमुग्धस्तु मृतकल्पः प्रजायते॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000448038, "chapter_id": 20448, "verse_number": "२-१२०-३९", "content_sanskrit": "ततो निद्रा महामाया तस्यांगेषु प्रयाति सा ।\nहृदि कंठे तथा चास्ये नासिकाग्रे प्रतिष्ठति॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000448039, "chapter_id": 20448, "verse_number": "२-१२०-४०", "content_sanskrit": "बाहू संकुच्य संतिष्ठेद्धृद्गतो नाभिमंडले ।\nआत्मनस्तु प्रभावाच्च उदानो नाम मारुतः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000448040, "chapter_id": 20448, "verse_number": "२-१२०-४१", "content_sanskrit": "प्रजायते महातीव्रा बलरोधं करोति सः ।\nयथा रज्ज्वा प्रबद्धस्तु दारु कीलधरः स्थितः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000448041, "chapter_id": 20448, "verse_number": "२-१२०-४२", "content_sanskrit": "तथा चात्मासु संलग्नः प्राणवायुर्न संशयः ।\nअंतरात्मप्रसक्तस्तु प्राणवायुः शुभानने॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000448042, "chapter_id": 20448, "verse_number": "२-१२०-४३", "content_sanskrit": "बुद्धिवद्रोहितो भद्रे अंतरात्मा प्रधावति ।\nपूर्वजन्मार्जितान्वासान्स्मृत्वा तत्र प्रधावति॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000448043, "chapter_id": 20448, "verse_number": "२-१२०-४४", "content_sanskrit": "तत्र संस्थो महाप्राज्ञः स्वेच्छया रमते पुनः ।\nएवं नानाविधान्स्वप्नानंतरात्मा प्रपश्यति॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000448044, "chapter_id": 20448, "verse_number": "२-१२०-४५", "content_sanskrit": "उत्तमांश्च विरुद्धांश्च कर्मयुक्तान्प्रपश्यति ।\nगिरींस्तथा सुदुर्गांश्च उच्चावचान्प्रपश्यति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000448045, "chapter_id": 20448, "verse_number": "२-१२०-४६", "content_sanskrit": "तदेव वातिकं विद्धि कफवत्तद्वदाम्यहम् ।\nजलं नदीं तडागं च पयः स्थानानि पश्यति॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000448046, "chapter_id": 20448, "verse_number": "२-१२०-४७", "content_sanskrit": "अग्निं च पश्यते देवि बहुकांचनमुत्तमम् ।\nतदेव पैत्तिकं विद्धि भाव्यं चैव वदाम्यहम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000448047, "chapter_id": 20448, "verse_number": "२-१२०-४८", "content_sanskrit": "प्रभाते दृश्यते स्वप्नो भव्यो वाभव्य एव च ।\nकर्मयुक्तो वरारोहे लाभालाभप्रकाशकः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000448048, "chapter_id": 20448, "verse_number": "२-१२०-४९", "content_sanskrit": "स्वप्नस्यापि अवस्था मे कथिता वरवर्णिनि ।\nतद्भाव्यंचवरारोहेविष्णोश्चैवभविष्यति॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000448049, "chapter_id": 20448, "verse_number": "२-१२०-५०", "content_sanskrit": "तन्निमित्तं त्वया दृष्टो दुःस्वप्नः स तु प्रेक्षितः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]