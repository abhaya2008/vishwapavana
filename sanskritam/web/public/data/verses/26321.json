[{"id": 7006321000, "chapter_id": 26321, "verse_number": "१-३१-१", "content_sanskrit": "जनमेजय उवाच पूरोर्वंशमहं ब्रह्मञ्छ्रोतुमिच्छामि तत्त्वतः ।\nद्रुह्योश्चानोर्यदोश्चैव तुर्वसोश्च पृथक् पृथक् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006321001, "chapter_id": 26321, "verse_number": "१-३१-२", "content_sanskrit": "वृष्णिवंशप्रसङ्गेन स्वं वशं पूर्वमेव तु ।\nविस्तरेणानुपूर्व्या च तद् भवान्वक्तुमर्हति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006321002, "chapter_id": 26321, "verse_number": "१-३१-३", "content_sanskrit": "वैशम्पायन उवाच शृणु पूरोर्महाराज वंशमुत्तमपौरुषम् ।\nविस्तरेणानुपूर्व्या च यत्र जातोऽसि पार्थिव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006321003, "chapter_id": 26321, "verse_number": "१-३१-४", "content_sanskrit": "हन्त ते कीर्तयिष्यामि पूरोर्वंशमनुत्तमम् ।\nद्रुह्योश्चानोर्यदोश्चैव तुर्वसोश्च नराधिप ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006321004, "chapter_id": 26321, "verse_number": "१-३१-५", "content_sanskrit": "पूरोः पुत्रो महावीर्यो राजाऽऽसीज्जनमेजयः ।\nप्रचिन्वांस्तु सुतस्तस्य यः प्राचीमजयद् दिशम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006321005, "chapter_id": 26321, "verse_number": "१-३१-६", "content_sanskrit": "प्रचिन्वतः प्रवीरोऽभून्मनस्युस्तस्य चात्मजः ।\nराजा चाभयदो नाम मनस्योरभवत् सुतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006321006, "chapter_id": 26321, "verse_number": "१-३१-७", "content_sanskrit": "तथैवाभयदस्यासीत् सुधन्वा तु महीपतिः ।\nसुधन्वनो बहुगवः शम्यातिस्तस्य चात्मजः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006321007, "chapter_id": 26321, "verse_number": "१-३१-८", "content_sanskrit": "शम्यातेस्तु रहस्याती रौद्राश्वस्तस्य चात्मजः ।\nरौद्राश्वस्य घृताच्यां वै दशाप्सरसि सूनवः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006321008, "chapter_id": 26321, "verse_number": "१-३१-९", "content_sanskrit": "ऋचेयुः प्रथमस्तेषां कृकणेयुस्तथैव च ।\nकक्षेयुः स्थण्डिलेयुश्च सन्नतेयुस्तथैव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006321009, "chapter_id": 26321, "verse_number": "१-३१-१०", "content_sanskrit": "दशार्णेयुर्जलेयुश्च स्थलेयुश्च महायशाः ।\nधनेयुश्च वनेयुश्च पुत्रिकाश्च दश स्त्रियः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006321010, "chapter_id": 26321, "verse_number": "१-३१-११", "content_sanskrit": "रुद्रा शूद्रा च भद्रा च मलदा मलहा तथा ।\nखलदा चैव राजेन्द्र नलदा सुरसापि च ।\nतथा गोचपला तु स्त्रीरत्नकूटा च ता दश ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006321011, "chapter_id": 26321, "verse_number": "१-३१-१२", "content_sanskrit": "ऋषिर्जातोऽत्रिवंशे तु तासां भर्ता प्रभाकरः ।\nरुद्रायां जनयामास सुतं सोमं यशस्विनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006321012, "chapter_id": 26321, "verse_number": "१-३१-१३", "content_sanskrit": "स्वर्भानुना हते सूर्ये पतमाने दिवो महीम् ।\nतमोऽभिभूते लोके च प्रभा येन प्रवर्तिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006321013, "chapter_id": 26321, "verse_number": "१-३१-१४", "content_sanskrit": "स्वस्ति तेऽस्त्विति चोक्तो वै पतमानो दिवाकरः ।\nवचनात् तस्य विप्रर्षेर्न पपात दिवो महीम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006321014, "chapter_id": 26321, "verse_number": "१-३१-१५", "content_sanskrit": "अत्रिश्रेष्ठानि गोत्राणि यश्चकार महातपाः ।\nयज्ञेष्वत्रेर्धनं चैव सुरैर्यस्य प्रवर्तितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006321015, "chapter_id": 26321, "verse_number": "१-३१-१६", "content_sanskrit": "स तासु जनयामास पुत्रिकासु सनामकान् ।\nदश पुत्रान् महात्मा स तपस्युग्रे रतान्सदा ॥१६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006321016, "chapter_id": 26321, "verse_number": "१-३१-१७", "content_sanskrit": "ते तु गोत्रकरा राजन्नृषयो वेदपारगाः ।\nस्वस्त्यात्रेया इति ख्याताः किं त्वत्रिधनवर्जिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006321017, "chapter_id": 26321, "verse_number": "१-३१-१८", "content_sanskrit": "कक्षेयोस्तनयाश्चासंस्त्रय एव महारथाः ।\nसभानरश्चाक्षुषश्च परमन्युस्तथैव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006321018, "chapter_id": 26321, "verse_number": "१-३१-१९", "content_sanskrit": "सभानरस्य पुत्रस्तु विद्वान् कालानलो नृपः ।\nकालानलस्य धर्मज्ञः सृञ्जयो नाम वै सुतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006321019, "chapter_id": 26321, "verse_number": "१-३१-२०", "content_sanskrit": "सृञ्जयस्याभवत् पुत्रो वीरो राजा पुरञ्जयः ।\nजनमेजयो महाराज पुरञ्जयसुतोऽभवत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006321020, "chapter_id": 26321, "verse_number": "१-३१-२१", "content_sanskrit": "जनमेजयस्य राजर्षेर्महाशालोऽभवत् सुतः ।\nदेवेषु स परित्रातः प्रतिष्ठितयशा भुवि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006321021, "chapter_id": 26321, "verse_number": "१-३१-२२", "content_sanskrit": "महामना नाम सुतो महाशालस्य धार्मिकः ।\nजज्ञे वीरः सुरगणैः पूजितः सुमहायशाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006321022, "chapter_id": 26321, "verse_number": "१-३१-२३", "content_sanskrit": "महामनास्तु पुत्रौ द्वौ जनयामास भारत ।\nउशीनरं च धर्मज्ञं तितिक्षुं च महाबलम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006321023, "chapter_id": 26321, "verse_number": "१-३१-२४", "content_sanskrit": "उशीनरस्य पत्न्यस्तु पञ्च राजर्षिवंशजाः ।\nनृगा कृमी नवा दर्वा पञ्चमी च दृषद्वती ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006321024, "chapter_id": 26321, "verse_number": "१-३१-२५", "content_sanskrit": "उशीनरस्य पुत्रास्तु पञ्च तासु कुलोद्वहाः ।\nतपसा वै सुमहता जाता वृद्धस्य भारत ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006321025, "chapter_id": 26321, "verse_number": "१-३१-२६", "content_sanskrit": "नृगायास्तु नृगः पुत्रः कृम्यां कृमिरजायत ।\nनवायास्तु नवः पुत्रो दर्वायाः सुव्रतोऽभवत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006321026, "chapter_id": 26321, "verse_number": "१-३१-२७", "content_sanskrit": "दृषद्वत्यास्तु संजज्ञे शिबिरौशीनरो नृपः ।\nशिबेस्तु शिबयस्तात यौधेयास्तु नृगस्य ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006321027, "chapter_id": 26321, "verse_number": "१-३१-२८", "content_sanskrit": "नवस्य नवराष्ट्रं तु कृमेस्तु कृमिला पुरी ।\nसुव्रतस्य तथाम्बष्ठा शिबिपुत्रान्निबोध मे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006321028, "chapter_id": 26321, "verse_number": "१-३१-२९", "content_sanskrit": "शिबेश्च पुत्राश्चत्वारो वीरास्त्रैलोक्यविश्रुताः ।\nवृषदर्भः सुवीरश्च मद्रकः कैकयस्तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006321029, "chapter_id": 26321, "verse_number": "१-३१-३०", "content_sanskrit": "तेषां जनपदाः स्फीताः केकया मद्रकास्तथा ।\nवृषदर्भाः सुवीराश्च तितिक्षोस्तु प्रजाः शृणु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006321030, "chapter_id": 26321, "verse_number": "१-३१-३१", "content_sanskrit": "तैतिक्षवोऽभवद् राजा पूर्वस्यां दिशि भारत ।\nउषद्रथो महाबाहुस्तस्य फेनः सुतोऽभवत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006321031, "chapter_id": 26321, "verse_number": "१-३१-३२", "content_sanskrit": "फेनात् तु सुतपा जज्ञे सुतः सुतपसो बलिः ।\nजातो मानुषयोनौ तु स राजा काञ्चनेषुधिः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006321032, "chapter_id": 26321, "verse_number": "१-३१-३३", "content_sanskrit": "महायोगी स तु बलिर्बभूव नृपतिः पुरा ।\nपुत्रानुत्पादयामास पञ्च वंशकरान् भुवि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006321033, "chapter_id": 26321, "verse_number": "१-३१-३४", "content_sanskrit": "अङ्गः प्रथमतो जज्ञे वङ्गः सुह्यस्तथैव च ।\nपुण्ड्रः कलिङ्गश्च तथा बालेयं क्षत्रमुच्यते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006321034, "chapter_id": 26321, "verse_number": "१-३१-३५", "content_sanskrit": "बालेया ब्राह्मणाश्चैव तस्य वंशकरा भुवि ।\nबलेस्तु ब्रह्मणा दत्ता वराः प्रीतेन भारत ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006321035, "chapter_id": 26321, "verse_number": "१-३१-३६", "content_sanskrit": "महायोगित्वमायुश्च कल्पस्य परिमाणतः ।\nसंग्रामे वाप्यजेयत्वं धर्मे चैव प्रधानता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006321036, "chapter_id": 26321, "verse_number": "१-३१-३७", "content_sanskrit": "त्रैलोक्यदर्शनं चैव प्राधान्यं प्रसवे तथा ।\nबले चाप्रतिमत्वं वै धर्मतत्त्वार्थदर्शनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006321037, "chapter_id": 26321, "verse_number": "१-३१-३८", "content_sanskrit": "चतुरो नियतान् वर्णोस्त्वं च स्थापयिता भुवि ।\nइत्युक्तो विभुना राजा बलिः शान्तिं परा ययौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006321038, "chapter_id": 26321, "verse_number": "१-३१-३९", "content_sanskrit": "तस्य ते तनयाः सर्वे क्षेत्रजा मुनिपुङ्गवात् ।\nसम्भूता दीर्घतपसो सुदेष्णायां महौजसः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006321039, "chapter_id": 26321, "verse_number": "१-३१-४०", "content_sanskrit": "बलिस्तानभिषिच्येह पञ्च पुत्रानकल्मषान् ।\nकृतार्थः सोऽपि योगात्मा योगमाश्रित्य स प्रभुः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006321040, "chapter_id": 26321, "verse_number": "१-३१-४१", "content_sanskrit": "अधृष्यः सर्वभूतानां कालापेक्षी चरन्नपि ।\nकालेन महता राजन् स्वं च स्थानमुपागमत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006321041, "chapter_id": 26321, "verse_number": "१-३१-४२", "content_sanskrit": "तेषां जनपदाः पञ्च अङ्गा वङ्गाः ससुह्यकाः ।\nकलिङ्गाः पुण्ड्रकाश्चैव प्रजास्त्वङ्गस्य मे शृणु ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006321042, "chapter_id": 26321, "verse_number": "१-३१-४३", "content_sanskrit": "अङ्गपुत्रो महानासीद् राजेन्द्रो दधिवाहनः ।\nदधिवाहनपुत्रस्तु राजा दिविरथोऽभवत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006321043, "chapter_id": 26321, "verse_number": "१-३१-४४", "content_sanskrit": "पुत्रो दिविरथस्यासीच्छक्रतुल्यपराक्रमः ।\nविद्वान् धर्मरथो नाम तस्य चित्ररथः सुतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006321044, "chapter_id": 26321, "verse_number": "१-३१-४५", "content_sanskrit": "तेन चित्ररथेनाथ तदा विष्णुपदे गिरौ ।\nयजता सह शक्रेण सोमः पीतो महात्मना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006321045, "chapter_id": 26321, "verse_number": "१-३१-४६", "content_sanskrit": "अथ चित्ररथस्यापि पुत्रो दशरथोऽभवत् ।\nलोमपाद इति ख्यातो यस्य शान्ता सुताभवत्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006321046, "chapter_id": 26321, "verse_number": "१-३१-४७", "content_sanskrit": "तस्य दाशरथिर्वीरश्चतुरङ्गो महायशाः ।\nऋष्यशृङ्गप्रसादेन जज्ञे कुलविवर्धनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006321047, "chapter_id": 26321, "verse_number": "१-३१-४८", "content_sanskrit": "चतुरङ्गस्य पुत्रस्तु पृथुलाक्ष इति स्मृतः ।\nपृथुलाक्षसुतो राजा चम्पो नाम महायशाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006321048, "chapter_id": 26321, "verse_number": "१-३१-४९", "content_sanskrit": "चम्पस्य तु पुरी चम्पा या मालिन्यभवत्पुरा ।\nपूर्णभद्रप्रसादेन हर्यङ्गोऽस्य सुतोऽभवत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006321049, "chapter_id": 26321, "verse_number": "१-३१-५०", "content_sanskrit": "ततो वैभाण्डकिस्तस्य वारणं शक्रवारणम् ।\nअवतारयामास महीं मन्त्रैर्वाहनमुत्तमम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006321050, "chapter_id": 26321, "verse_number": "१-३१-५१", "content_sanskrit": "हर्यङ्गस्य तु दायादो राजा भद्ररथः स्मृतः ।\nपुत्रो भद्ररथस्यासीद् बृहत्कर्मा प्रजेश्वरः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006321051, "chapter_id": 26321, "verse_number": "१-३१-५२", "content_sanskrit": "बृहद्दर्भः सुतस्तस्य तस्माज्जज्ञे बृहन्मना ।\nबृहन्मनास्तु राजेन्द्र जनयामास वै सुतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006321052, "chapter_id": 26321, "verse_number": "१-३१-५३", "content_sanskrit": "नाम्ना जयद्रथं नाम यस्माद् दृढरथो नृपः ।\nआसीद् दृढरथस्यापि विश्वजिज्जनमेजय ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006321053, "chapter_id": 26321, "verse_number": "१-३१-५४", "content_sanskrit": "दायादस्तस्य कर्णस्तु विकर्णस्तस्य चात्मजः ।\nतस्य पुत्रशतं त्वासीदङ्गानां कुलवर्धनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006321054, "chapter_id": 26321, "verse_number": "१-३१-५५", "content_sanskrit": "बृहद्दर्भसुतो यस्तु राज्ञा नाम्ना बृहन्मनाः ।\nतस्य पत्नीद्वयं चासीच्चैद्यस्यैते सुते शुभे ।\nयशोदेवी च सत्या च ताभ्यां वंशस्तु भिद्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006321055, "chapter_id": 26321, "verse_number": "१-३१-५६", "content_sanskrit": "जयद्रथस्तु राजेन्द्र यशोदेव्यां व्यजायत ।\nब्रह्मक्षत्रोत्तरः सत्यां विजयो नाम विश्रुतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006321056, "chapter_id": 26321, "verse_number": "१-३१-५७", "content_sanskrit": "विजयस्य धृतिः पुत्रस्तस्य पुत्रो धृतव्रतः ।\nधृतव्रतस्य पुत्रस्तु सत्यकर्मा महायशाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006321057, "chapter_id": 26321, "verse_number": "१-३१-५८", "content_sanskrit": "सत्यकर्मसुतश्चापि सूतस्त्वधिरथस्तु वै ।\nयः कर्णं प्रतिजग्राह ततः कर्णस्तु सूतजः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006321058, "chapter_id": 26321, "verse_number": "१-३१-५९", "content_sanskrit": "एतत् ते कथितं सर्वं कर्णं प्रति महाबलम् ।\nकर्णस्य वृषसेनस्तु वृषस्तस्यात्मजः स्मृतः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006321059, "chapter_id": 26321, "verse_number": "१-३१-६०", "content_sanskrit": "एतेऽङ्गवंशजाः सर्वे राजानः कीर्तिता मया ।\nसत्यव्रता महात्मानः प्रज्ञावन्तो महारथाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006321060, "chapter_id": 26321, "verse_number": "१-३१-६१", "content_sanskrit": "ऋचेयोस्तु महाराज रौद्राश्वतनयस्य ह ।\nशृणु वंशमनुप्रोक्तं यत्र जातोऽसि पार्थिव ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]