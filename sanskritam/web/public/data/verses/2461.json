[{"id": 2069888, "chapter_id": 2461, "verse_number": "१०-१३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069889, "chapter_id": 2461, "verse_number": "१०-१३-१", "content_sanskrit": "एवमुक्त्वा कुरुश्रेष्ठं सर्वयादवनन्दनः।\nसर्वायुधवरोपेतमारुरोह रथोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069890, "chapter_id": 2461, "verse_number": "१०-१३-२", "content_sanskrit": "युक्तं परमकाम्भोजैस्तुरगैर्हेममालिभिः।\nउदितादित्यसङ्काशं सर्वरत्नविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069891, "chapter_id": 2461, "verse_number": "१०-१३-३", "content_sanskrit": "दक्षिणे ह्यावहच्छैब्यः सुग्रीवः सव्यतो धुरम्।\nणर्ष्णिवाहौ तु तस्यास्तां मेघपुष्पबलाहकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069892, "chapter_id": 2461, "verse_number": "१०-१३-४", "content_sanskrit": "विश्वकर्मकृता दिव्या रत्नधातुविभूषिता।\nउच्छ्रिता च रथे तस्मिन्ध्वजयष्टिरदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069893, "chapter_id": 2461, "verse_number": "१०-१३-५", "content_sanskrit": "वैनतेयः स्थितस्तस्यां प्रभामण्डलरश्मिवान्॥\nतस्य सत्यवतः केतुर्भुजगारिरदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069894, "chapter_id": 2461, "verse_number": "१०-१३-६", "content_sanskrit": "अथारोहद्धृषीकेशः केतुः सर्वधनुष्मताम्।\nअर्जुनः स च धर्मात्मा कुरुराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069895, "chapter_id": 2461, "verse_number": "१०-१३-७", "content_sanskrit": "अशोभेतां महात्मानौ दाशार्हमभितः स्थितौ।\nरथस्थं शार्ङ्गधन्वानमश्विनाविव वासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069896, "chapter_id": 2461, "verse_number": "१०-१३-८", "content_sanskrit": "उभावारोप्य दाशार्हः स्यन्दनं लोकपूजितम्।\nप्रतोदेन जवोपेतान्परमाश्वानचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069897, "chapter_id": 2461, "verse_number": "१०-१३-९", "content_sanskrit": "ते हयाः सहसोत्पेतुर्गृहीत्वा स्यन्दनोत्तमम्।\nआस्थितं पाण्डवेयाभ्यां यदूनामृषभेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069898, "chapter_id": 2461, "verse_number": "१०-१३-१०", "content_sanskrit": "वहतां शार्ङ्गधन्वानमश्वानां शीघ्रगामिनाम्।\nप्रादुरासीन्महाञ्शब्दः पक्षिणां पततामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069899, "chapter_id": 2461, "verse_number": "१०-१३-११", "content_sanskrit": "ते समर्था महाबाहुं क्षणेन भरतर्षभ।\nभीमसेनं महेष्वासमनुसस्रुः सुवेगिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069900, "chapter_id": 2461, "verse_number": "१०-१३-१२", "content_sanskrit": "क्रोधदीप्तं तु कौन्तेयं द्विषदर्थे समुद्यतम्।\nनाशक्नुवन्वारयितुं समेत्यापि महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069901, "chapter_id": 2461, "verse_number": "१०-१३-१३", "content_sanskrit": "स तेषामग्रतः शूरः श्रीमतां दृढधन्विनाम्।\nययौ भागीरथीतीरं हरिभिर्भृशवेगितैः।\nयत्र स श्रूयते द्रौणिः पुत्रहन्ता दुरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069902, "chapter_id": 2461, "verse_number": "१०-१३-१४", "content_sanskrit": "स ददर्श महात्मानमुदकान्ते यशस्विनम्।\nकृष्णद्वैपायनं व्यासमासीनमृषिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069903, "chapter_id": 2461, "verse_number": "१०-१३-१५", "content_sanskrit": "तं चैव क्रूरकर्माणं घृताक्तं कुशचीरिणम्।\nरजसा ध्वस्तमासीनं ददर्श द्रौणिमन्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069904, "chapter_id": 2461, "verse_number": "१०-१३-१६", "content_sanskrit": "तमभ्यधावत्कौन्तेयः प्रगृह्य सशरं धनुः।\nभीमसेनो महाबाहुस्तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069905, "chapter_id": 2461, "verse_number": "१०-१३-१७", "content_sanskrit": "तं दृष्ट्वा भीमकर्माणं प्रगृहीतशरासनम्।\nभ्रातरौ पृष्ठतश्चास्य जनार्दनरथे स्थितौ।\nव्यथितात्माऽभवद्द्रौणिः प्राप्तं चेदममन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069906, "chapter_id": 2461, "verse_number": "१०-१३-१८", "content_sanskrit": "स तद्दिव्यमदीनात्मा परमास्रमचिन्तयत्।\nजग्राह च शरैषीकां द्रौणिः सव्येन पाणिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069907, "chapter_id": 2461, "verse_number": "१०-१३-१९", "content_sanskrit": "स तामापदमासाद्य दिव्यमस्त्रमुदैरयत्।\nअमृष्यमाणस्ताञ्छूरान्दिव्यायुधधरान्स्थितान्।\nअपाण्डवायेति रुषा वाचमुत्सृज्य दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069908, "chapter_id": 2461, "verse_number": "१०-१३-२०", "content_sanskrit": "इत्युक्त्वा राजशार्दूल द्रोणपुत्रः प्रतापवान्।\nसर्वलोकप्रमोहार्थं तदस्रं प्रमुमोच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069909, "chapter_id": 2461, "verse_number": "१०-१३-२१", "content_sanskrit": "ततस्तस्यामिषीकायां पावकः समजायत।\nप्रधक्ष्यन्निव लोकांस्त्रीन्कालान्कयमोपमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069910, "chapter_id": 2461, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि ऐषीकपर्वणि त्रयोधशोऽध्यायः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]