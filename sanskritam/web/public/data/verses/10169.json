[{"id": 6000169000, "chapter_id": 10169, "verse_number": null, "content_sanskrit": "अथ षोडशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000169001, "chapter_id": 10169, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.001.m4a", "display_order": 2}, {"id": 6000169002, "chapter_id": 10169, "verse_number": "८-१६-१", "content_sanskrit": "इत्युक्ता साऽदिती राजन् स्वभर्त्रा कश्यपेन वै।\nअन्वतिष्ठद् व्रतमिदं द्वादशाहमतन्द्रिता॥ ८/१६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.002.m4a", "display_order": 3, "topics": [{"text": "अदित्या पयोव्रताचरणम्", "range": "१–३"}]}, {"id": 6000169003, "chapter_id": 10169, "verse_number": "८-१६-२", "content_sanskrit": "चिन्तयन्त्येकया बुद्ध्या भगवन्तमधोक्षजम्।\nप्रगृह्येन्द्रियदुष्टाश्वान् मनसा बुद्धिसारथिः॥ ८/१६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.003.m4a", "display_order": 4}, {"id": 6000169004, "chapter_id": 10169, "verse_number": "८-१६-३", "content_sanskrit": "मनश्चैकाग्रया बुद्ध्या भगवत्यखिलात्मनि।\nवासुदेवे समाधाय चचार ह पयोव्रतम्॥ ८/१६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.004.m4a", "display_order": 5}, {"id": 6000169005, "chapter_id": 10169, "verse_number": "८-१६-४", "content_sanskrit": "तस्याः प्रादुरभूत् तात भगवानादिपूरुषः।\nपीतवासाश्चतुर्बाहुः शङ्खचक्रगदाधरः॥ ८/१६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.005.m4a", "display_order": 6, "topics": [{"text": "तद्व्रताचरणतुष्टस्य भगवतस्तद्गर्भे प्रादुर्भावः", "range": "४–२३"}]}, {"id": 6000169006, "chapter_id": 10169, "verse_number": "८-१६-५", "content_sanskrit": "तं नेत्रगोचरं वीक्ष्य सहसोत्थाय सादरम्।\nननाम भुवि कायेन दण्डवत् प्रीतिविह्वला॥ ८/१६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.006.m4a", "display_order": 7}, {"id": 6000169007, "chapter_id": 10169, "verse_number": "८-१६-६", "content_sanskrit": "सोत्थाय बद्धाञ्जलिरीडितुं स्थिता नोत्सेह आनन्दजलाकुलेक्षणा।\nबभूव तूष्णीं पुलकाकुलाकृतिस्तद्दर्शनात्युत्सवगात्रवेपथुः॥ ८/१६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.007.m4a", "display_order": 8}, {"id": 6000169008, "chapter_id": 10169, "verse_number": "८-१६-७", "content_sanskrit": "प्रीत्या शनैर्गद्गदया गिरा हरिं तुष्टाव सा देव्यदितिः कुरूद्वह।\nउद्वीक्षती सा पिबतीव चक्षुषा रमापतिं यज्ञपतिं जगत्पतिम्॥ ८/१६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.008.m4a", "display_order": 9}, {"id": 6000169009, "chapter_id": 10169, "verse_number": null, "content_sanskrit": "अदितिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.009.m4a", "display_order": 10}, {"id": 6000169010, "chapter_id": 10169, "verse_number": "८-१६-८", "content_sanskrit": "यज्ञेश यज्ञपुरुषाच्युत तीर्थपाद तीर्थश्रवः श्रवणमङ्गलनामधेय।\nआपन्नलोकवृजिनोपशमोदयाद्य शं नः कृधीश भगवन्नवसन्ननाथ॥ ८/१६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.010.m4a", "display_order": 11}, {"id": 6000169011, "chapter_id": 10169, "verse_number": "८-१६-९", "content_sanskrit": "विश्वाय विश्वभवनस्थितिसंयमाय स्वैरं गृहीतपुरुशक्तिगुणाय भूम्ने।\nस्वच्छाय शश्वदुपबृंहितपूर्णबोधव्यापादितात्मतमसे हरये नमस्ते॥ ८/१६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.011.m4a", "display_order": 12}, {"id": 6000169012, "chapter_id": 10169, "verse_number": "८-१६-१०", "content_sanskrit": "आयुः परं वपुरभीष्टमतुल्यलक्ष्मीर्द्यौर्भूरसाः सकलयोगगुणस्‍त्रिवर्गः।\nज्ञानं च केवलमनन्त भवन्ति तुष्टात् त्वत्तो नृणां किमुपसन्नजनाधिनाशः॥ ८/१६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.012.m4a", "display_order": 13}, {"id": 6000169013, "chapter_id": 10169, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.013.m4a", "display_order": 14}, {"id": 6000169014, "chapter_id": 10169, "verse_number": "८-१६-११", "content_sanskrit": "अदित्यैवं स्तुतो राजन् भगवान् पुष्करेक्षणः।\nक्षेत्रज्ञः सर्वभूतानामिति होवाच भारत॥ ८/१६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.014.m4a", "display_order": 15}, {"id": 6000169015, "chapter_id": 10169, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.015.m4a", "display_order": 16}, {"id": 6000169016, "chapter_id": 10169, "verse_number": "८-१६-१२", "content_sanskrit": "देवमातर्भवत्या मे विज्ञातं चिरकाङ्क्षितम्।\nयत्सपत्नैर्हृतश्रीणां च्यावितानां स्वधामतः॥ ८/१६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.016.m4a", "display_order": 17}, {"id": 6000169017, "chapter_id": 10169, "verse_number": "८-१६-१३", "content_sanskrit": "तान् विनिर्जित्य समरे दुर्मदानसुरर्षभान्।\nप्रतिलब्धजयश्रीभिः पुत्रैरिच्छस्युपासितुम्॥ ८/१६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.017.m4a", "display_order": 18}, {"id": 6000169018, "chapter_id": 10169, "verse_number": "८-१६-१४", "content_sanskrit": "इन्द्रज्येष्ठैश्च तनयैर्हतानां युधि विद्विषाम्।\nस्‍त्रियो रुदन्तीरासाद्य द्रष्टुमिच्छसि दुःखिताः॥ ८/१६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.018.m4a", "display_order": 19}, {"id": 6000169019, "chapter_id": 10169, "verse_number": "८-१६-१५", "content_sanskrit": "आत्मजान् सुसमृद्धान् स्वान् प्रत्याहृतयशःश्रियः।\nनाकपृष्ठमधिष्ठाय क्रीडतो द्रष्टुमिच्छसि॥ ८/१६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.019.m4a", "display_order": 20}, {"id": 6000169020, "chapter_id": 10169, "verse_number": "८-१६-१६", "content_sanskrit": "प्रायोऽधुना तेऽसुरयूथनाथा अवारणीया इति देवि मे मतिः।\nयत्तेऽनुकूलेश्वरविप्रगुप्ता न विक्रमस्तत्र सुखं ददाति॥ ८/१६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.020.m4a", "display_order": 21}, {"id": 6000169021, "chapter_id": 10169, "verse_number": "८-१६-१७", "content_sanskrit": "अथाप्युपायो मम देवि चिन्त्यः सन्तोषितस्य व्रतचर्यया ते।\nममार्चनं नार्हति गन्तुमन्यथा श्रद्धानुरूपं फलहेतुकत्वात्॥ ८/१६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.021.m4a", "display_order": 22}, {"id": 6000169022, "chapter_id": 10169, "verse_number": "८-१६-१८", "content_sanskrit": "त्वयाऽर्चितश्चाहमपत्यगुप्तये पयोव्रतेनानुगुणं समीडितः।\nस्वांशेन पुत्रत्वमुपेत्य ते सुतान् पातास्मि मारीचतपस्यवस्थितः॥ ८/१६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.022.m4a", "display_order": 23}, {"id": 6000169023, "chapter_id": 10169, "verse_number": "८-१६-१९", "content_sanskrit": "उपधाव पतिं भद्रे प्रजापतिमकल्मषम्।\nमां च भावय तेऽपत्यमेवंरूपमवस्थितम्॥ ८/१६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.023.m4a", "display_order": 24}, {"id": 6000169024, "chapter_id": 10169, "verse_number": "८-१६-२०", "content_sanskrit": "नैतत् परस्मा आख्येयं देवगुह्यं कथञ्चन।\nसर्वं सम्पद्यते देवि देवगुह्यात् सुसंवृतात्॥ ८/१६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.024.m4a", "display_order": 25}, {"id": 6000169025, "chapter_id": 10169, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.025.m4a", "display_order": 26}, {"id": 6000169026, "chapter_id": 10169, "verse_number": null, "content_sanskrit": "एतावदुक्त्वा भगवांस्तत्रैवान्तरधीयत।\nअदितिर्दुर्लभं लब्ध्वा हरेर्जन्मात्मनि प्रभोः॥ ८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.026.m4a", "display_order": 27}, {"id": 6000169027, "chapter_id": 10169, "verse_number": "८-१६-२१", "content_sanskrit": "उपाधावत् पतिं भक्त्या परया कृतकृत्यवत्॥ ८/१६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.027.m4a", "display_order": 28}, {"id": 6000169028, "chapter_id": 10169, "verse_number": "८-१६-२२", "content_sanskrit": "स वै समाधियोगेन कश्यपस्तदबुध्यत।\nप्रविष्टमात्मनि हरेरंशं ह्यवितथेक्षणः॥ ८/१६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.028.m4a", "display_order": 29}, {"id": 6000169029, "chapter_id": 10169, "verse_number": "८-१६-२३", "content_sanskrit": "सोऽदित्यां वीर्यमाधत्त तपसा चिरसंभृतम्।\nसमाहितमना राजन् दारुण्यग्निं यथाऽनिलः॥ ८/१६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.029.m4a", "display_order": 30}, {"id": 6000169030, "chapter_id": 10169, "verse_number": "८-१६-२४", "content_sanskrit": "अदित्यां निहितं गर्भं भगवन्तं सनातनम्।\nहिरण्यगर्भो विज्ञाय समीडे गुह्यनामभिः॥ ८/१६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.030.m4a", "display_order": 31, "topics": [{"text": "ब्रह्मकृता स्तुतिः", "range": "२४–२८"}]}, {"id": 6000169031, "chapter_id": 10169, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.031.m4a", "display_order": 32}, {"id": 6000169032, "chapter_id": 10169, "verse_number": "८-१६-२५", "content_sanskrit": "जयोरुगाय भगवन्नुरुक्रम नमोऽस्तु ते।\nनमो ब्रह्मण्यदेवाय त्रिगुणाय नमोऽस्तु ते॥ ८/१६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.032.m4a", "display_order": 33}, {"id": 6000169033, "chapter_id": 10169, "verse_number": "८-१६-२६", "content_sanskrit": "पृश्निगर्भाय देवाय वेदगर्भाय वेधसे।\nत्रिगुणाय त्रिपृष्ठाय शिपिविष्टाय विष्णवे॥ ८/१६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.033.m4a", "display_order": 34}, {"id": 6000169034, "chapter_id": 10169, "verse_number": "८-१६-२७", "content_sanskrit": "त्वमादिरन्तो भुवनस्य मध्यमनन्तशक्तिं पुरुषं यमाहुः।\nकालो भवानाक्षिपतीश विश्वं स्रोतो यथाऽम्भःपतितं गभीरम्॥ ८/१६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.034.m4a", "display_order": 35}, {"id": 6000169035, "chapter_id": 10169, "verse_number": "८-१६-२८", "content_sanskrit": "त्वं वै प्रजानां स्थिरजङ्गमानां प्रजापतीनामसि सम्प्रविष्टः।\nदिवौकसां देव दिवश्च्युतानां परायणं नौरिव मज्जतोऽप्सु॥ ८/१६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_016/BhP_08.016.035.m4a", "display_order": 36}, {"id": 6000169036, "chapter_id": 10169, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धे षोडशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]