[{"id": 2136586, "chapter_id": 3961, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136587, "chapter_id": 3961, "verse_number": "१", "content_sanskrit": "ततः श्रुत्वा हतं सङ्खे कुम्भकर्णं सहानुगम् ।\nप्रहस्तं च महेष्वासं धूम्राक्षं चातितेजसम् ।\nपुत्रमिन्द्रजितं वीरं रावणः प्रत्यभाषत \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136588, "chapter_id": 3961, "verse_number": "", "content_sanskrit": "रावणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136589, "chapter_id": 3961, "verse_number": "२", "content_sanskrit": "जहि रामममित्रघ्न सुग्रीवं च सलक्ष्मणम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136590, "chapter_id": 3961, "verse_number": "३", "content_sanskrit": "त्वया हि मम सत्पुत्र यशो दीप्तमुपार्जितम् ।\nजित्वा वज्रधरं सङ्खे सहस्राक्षं शचीपतिम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136591, "chapter_id": 3961, "verse_number": "४", "content_sanskrit": "अन्तर्हितः प्रकाशो वा दिव्यैर्दत्तवरैः शरैः ।\nजहि शत्रूनमित्रघ्न मम शस्त्रभृतां वर \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136592, "chapter_id": 3961, "verse_number": "५", "content_sanskrit": "रामलक्ष्मणसुग्रीवाः शरस्पर्शं न तेऽनघ ।\nसमर्थाः प्रतिसोढुं च कुतस्तदनुयायिनः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136593, "chapter_id": 3961, "verse_number": "६", "content_sanskrit": "अकृता या प्रहस्तेन कुम्भकर्णेन चानघ ।\nखरस्यापचितिः सङ्खे तां गच्छ त्वं महाभुज \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136594, "chapter_id": 3961, "verse_number": "७", "content_sanskrit": "त्वमद्यनिशितैर्बाणैर्हत्वा शत्रून् ससैनिकान् ।\nप्रतिनन्दय मां पुत्र पुरा जित्वेव वासवम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136595, "chapter_id": 3961, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136596, "chapter_id": 3961, "verse_number": "८", "content_sanskrit": "इत्युक्तः स तथेत्युक्त्वा रथमास्थाय दंसितः ।\nप्रययाविन्द्रजिद् राजंस्तूर्णमायोधनं प्रति \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136597, "chapter_id": 3961, "verse_number": "९", "content_sanskrit": "ततो विश्राव्य विस्पष्टं नाम राक्षसपुङ्गवः ।\nआह्वयामास समरे लक्ष्मणं शुभलक्षणम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136598, "chapter_id": 3961, "verse_number": "१०", "content_sanskrit": "तं लक्ष्मणोऽभ्यधावच्च प्रगृह्य सशरं धनुः ।\nत्रासयंस्तळघोषेण सिंहः क्षुद्रमृगान्यथा \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136599, "chapter_id": 3961, "verse_number": "११", "content_sanskrit": "तयोः समभवद् युद्धं सुमहज्जयगृद्धिनोः ।\nदिव्यास्त्रविदुषोस्तीव्रमन्योन्यस्पर्धिनोस्तदा \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136600, "chapter_id": 3961, "verse_number": "१२", "content_sanskrit": "रावणिस्तु यदा नैनं विशेषयति सायकैः ।\nततो गुरुतरं यत्नमातिष्ठद् बलिनां वरः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136601, "chapter_id": 3961, "verse_number": "१३", "content_sanskrit": "तत एनं महावेगैरर्दयामास तोमरैः ।\nतानागतान् स चिच्छेद सौमित्रिर्निशितैः शरैः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136602, "chapter_id": 3961, "verse_number": "१४", "content_sanskrit": "ते निकृत्ताः शरैस्तीक्ष्णैर्न्यपतन् धरणीतले ।\nसाधका रावणे राजौ शतशः शकलीकृताः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136603, "chapter_id": 3961, "verse_number": "१५", "content_sanskrit": "तमङ्गदो वालिसुतः श्रीमानुद्यम्य पादपम् ।\nअभिद्रुत्य महावेगस्ताडयामास मूर्धनि \t॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136604, "chapter_id": 3961, "verse_number": "१६", "content_sanskrit": "तस्येन्द्रजिदसम्भ्रान्तः प्रासेनोरसि वीर्यवान् ।\nप्रहर्तुमैच्छत् तं चास्य प्रासं चिच्छेद लक्ष्मणः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136605, "chapter_id": 3961, "verse_number": "१७", "content_sanskrit": "तमभ्याशगतं वीरमङ्गदं रावणात्मजः ।\nगदयाऽताडयत् सव्ये पार्श्वे वानरपुङ्गवम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136606, "chapter_id": 3961, "verse_number": "१८", "content_sanskrit": "तमचिन्त्य प्रहारं स बलवान् वालिनः सुतः ।\nससर्जेन्द्रजितः क्रोधाच्छालस्कन्धं तथाङ्गदः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136607, "chapter_id": 3961, "verse_number": "१९", "content_sanskrit": "सोऽङ्गदेन रुषोत्सृष्टो वधायेन्द्रजितस्तरुः ।\nजघानेन्द्रजितः पार्थ रथं साश्वं ससारथिम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136608, "chapter_id": 3961, "verse_number": "२०", "content_sanskrit": "ततो हताश्वात् प्रस्कन्द्य रथात् स हतसारथिः ।\nतत्रैवान्तर्दधे राजन् मायया रावणात्मजः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136609, "chapter_id": 3961, "verse_number": "२१", "content_sanskrit": "अन्तर्हितं विदित्वा तं बहुमायं च राक्षसम् ।\nरामस्तं देशमागम्य तत्सैन्यं पर्यरक्षत \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136610, "chapter_id": 3961, "verse_number": "२२", "content_sanskrit": "स राममुद्दिश्य शरैस्ततो दत्तवरैस्तदा ।\nविव्याध सर्वगात्रेषु लक्ष्मणं च महाबलम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136611, "chapter_id": 3961, "verse_number": "२३", "content_sanskrit": "तमदृश्यं शरैः शूरौ माययान्तर्हितं तदा ।\nयोधयामासतुरुभौ रावणिं रामलक्ष्मणौ \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136612, "chapter_id": 3961, "verse_number": "२४", "content_sanskrit": "स रुषा सर्वगात्रेषु तयोः पुरुषसिंहयोः ।\nव्यसृजत् सायकान् भूयः शतशोऽथ सहस्रशः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136613, "chapter_id": 3961, "verse_number": "२५", "content_sanskrit": "तमदृश्यं विचिन्वन्तः सृजन्तमनिशं शरान् ।\nहरयो विविशुर्व्योम प्रगृह्य महतीः शिलाः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136614, "chapter_id": 3961, "verse_number": "२६", "content_sanskrit": "तांश्च तौ चाप्यदृश्यः स शरैर्विव्याध राक्षसः ।\nस भृशं ताडयामास रावणिर्माययाऽऽवृतः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136615, "chapter_id": 3961, "verse_number": "२७", "content_sanskrit": "तौ शरैराचितौ वीरौ भ्रातरौ रामलक्ष्मणौ ।\nपेततुर्गगनाद् भूमिं सूर्याचन्द्रमसाविव \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136616, "chapter_id": 3961, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि रामोपाख्यानपर्वणि इन्द्रजिद्युद्धे सप्तसप्तत्यधिकद्विशततमोऽध्यायः ॥२७७॥\nरामोपाख्यानपर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136617, "chapter_id": 3961, "verse_number": "", "content_sanskrit": "––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]