[{"id": 2142710, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2142711, "chapter_id": 4077, "verse_number": "१", "content_sanskrit": "कथमिन्द्रेण राजेन्द्र सभार्येण महात्मना ।\nदुःखं प्राप्तं पुरा घोरमेतदिच्छामि वेदितुम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2142712, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2142713, "chapter_id": 4077, "verse_number": "२", "content_sanskrit": "शृणु राजन् पुरावृत्तम् इतिहासं पुरातनम् ।\nसभार्येण यथा प्राप्तं दुःखमिन्द्रेण भारत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2142714, "chapter_id": 4077, "verse_number": "३", "content_sanskrit": "त्वष्टा प्रजापतिर्ह्यासीद् देवश्रेष्ठो महायशाः ।\nस पुत्रं वै त्रिशिरसमिन्द्रद्रोहात् किलासृजत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2142715, "chapter_id": 4077, "verse_number": "४", "content_sanskrit": "ऐन्द्रं सम्प्रार्थयत् स्थानं विश्वरूपो महाद्युतिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2142716, "chapter_id": 4077, "verse_number": "५", "content_sanskrit": "तैस्त्रिभिर्वदनैर्घोरैः सूर्येन्दुज्वलनोपमैः ।\nवेदानेकेन सोऽधीते सुरामेकेन चापिबत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2142717, "chapter_id": 4077, "verse_number": "६", "content_sanskrit": "एकेन च दिशः सर्वाः पिबन्निव निरीक्षते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2142718, "chapter_id": 4077, "verse_number": "७", "content_sanskrit": "स तपस्वी मृदुर्दान्तो धर्मे तपसि चोद्यतः ।\nतप्यते स्म तपस्तीव्रं सुदुश्चरमरिन्दम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2142719, "chapter_id": 4077, "verse_number": "८", "content_sanskrit": "तस्य दृष्ट्वा तपोवीर्यं सत्यं चामिततेजसः ।\nविषादमगमच्छक्र इन्द्रोऽयं मा भवेदिति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2142720, "chapter_id": 4077, "verse_number": "९", "content_sanskrit": "कथं सज्जेत भोगेषु न च तप्येन्महत् तपः ।\nविवर्धमानस्त्रिशिराः सर्वं हि भुवनं ग्रसेत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2142721, "chapter_id": 4077, "verse_number": "समाप्तिः", "content_sanskrit": "इति सञ्चिन्त्य बहुधा बुद्धिमान् भरतर्षभ ।\nआज्ञापयत् सोऽप्सरसः त्वष्टृपुत्रप्रलोभने\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2142722, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2142723, "chapter_id": 4077, "verse_number": "११", "content_sanskrit": "यथा स सज्जेत् त्रिशिराः कामभोगेषु वै भृशम् ।\nक्षिप्रं कुरुत गच्छध्वं प्रलोभयत मा चिरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2142724, "chapter_id": 4077, "verse_number": "१२", "content_sanskrit": "शृङ्गारवेषाः सुश्रोण्यो हारैर्मुक्तामनोहरैः ।\nहावभावसमायुक्ताः सर्वाः सौन्दर्यशोभिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2142725, "chapter_id": 4077, "verse_number": "१३", "content_sanskrit": "प्रजापतिर्देवदेवश्चन्द्रो वैश्रवणो यमः ।\nवरुणः पाशहस्तो वा धर्म एव भवेत् स्वयम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2142726, "chapter_id": 4077, "verse_number": "१४", "content_sanskrit": "प्रलोभयत भद्रं वः शमयध्वं भयं मम ।\nअस्वस्थं ह्यात्मनाऽऽत्मानं लक्षयामि वराङ्गनाः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2142727, "chapter_id": 4077, "verse_number": "१५", "content_sanskrit": "भयं तन्मे महाघोरं क्षिप्रं नाशयताबलाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2142728, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "अप्सरसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2142729, "chapter_id": 4077, "verse_number": "१६", "content_sanskrit": "तथा यत्नं करिष्यामः शक्र तस्य प्रलोभने ।\nयथा नावाप्स्यसि भयं तस्माद् बलनिषूदन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2142730, "chapter_id": 4077, "verse_number": "१७", "content_sanskrit": "निर्दहन्निव चक्षुर्भ्यां योऽसावास्ते तपोनिधिः ।\nतं प्रलोभयितुं देव गच्छामः सहिता वयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2142731, "chapter_id": 4077, "verse_number": "१८", "content_sanskrit": "यतिष्यामो वशे कर्तुं व्यपनेतुं च ते भयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2142732, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2142733, "chapter_id": 4077, "verse_number": "१९", "content_sanskrit": "इन्द्रेण तास्त्वनुज्ञाता जग्मुस्त्रिशिरसोऽन्तिकम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2142734, "chapter_id": 4077, "verse_number": "२०", "content_sanskrit": "तत्र ता विविधैर्भावैर्लोभयन्त्यो वराङ्गनाः ।\nनृत्तं सन्दर्शयामासुः तथैवाङ्गेषु सौष्ठवम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2142735, "chapter_id": 4077, "verse_number": "२१", "content_sanskrit": "नाभ्यगच्छत् प्रहर्षं ताः स पश्यन् सुमहातपाः ।\nइन्द्रियाणि वशे कृत्वा पूर्णसागरसन्निभः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2142736, "chapter_id": 4077, "verse_number": "२२", "content_sanskrit": "तास्तु यत्नं परं कृत्वा पुनः शक्रमुपागमन् ।\nकृताञ्जलिपुटाः सर्वा देवराजमथाब्रुवन्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2142737, "chapter_id": 4077, "verse_number": "२३", "content_sanskrit": "न स शक्यः सुदुर्धर्षो धैर्याच्चालयितुं प्रभो ।\nयत्ते कार्यं महाभाग क्रियतां तदनन्तरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2142738, "chapter_id": 4077, "verse_number": "२४", "content_sanskrit": "सम्पूज्याप्सरसः शक्रो विसृज्य च महामतिः ।\nचिन्तयामास तस्यैव वधोपायं महात्मनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2142739, "chapter_id": 4077, "verse_number": "२५", "content_sanskrit": "स तूष्णीं चिन्तयन् वीरो देवराजः प्रतापवान् ।\nविनिश्चितमतिर्धीमान् वधे त्रिशिरसोऽभवत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2142740, "chapter_id": 4077, "verse_number": "२६", "content_sanskrit": "वज्रमस्य क्षिपाम्यद्य स क्षिप्रं न भविष्यति ।\nशत्रुः प्रवृद्धो नोपेक्ष्यो दुर्बलोऽपि बलीयसा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2142741, "chapter_id": 4077, "verse_number": "२७", "content_sanskrit": "शास्त्रबुद्ध्या विनिश्चित्य कृत्वा बुद्धिं वधे दृढाम् ।\nअथ वैश्वानरनिभं घोररूपं भयावहम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2142742, "chapter_id": 4077, "verse_number": "२८", "content_sanskrit": "मुमोच वज्रं सङ्क्रुद्धः शक्रस्त्रिशिरसं प्रति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2142743, "chapter_id": 4077, "verse_number": "२९", "content_sanskrit": "स पपात हतस्तेन वज्रेण दृढमाहतः ।\nपर्वतस्येव शिखरं प्रणुन्नं मेदिनीतळे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2142744, "chapter_id": 4077, "verse_number": "३०", "content_sanskrit": "तं तु वज्राहतं दृष्ट्वा शयानमचलोपमम् ।\nन शर्म लेभे देवेन्द्रो दीपितस्तस्य तेजसा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2142745, "chapter_id": 4077, "verse_number": "३१", "content_sanskrit": "हतोऽपि दीप्ततेजाः स जीवन्निव हि दृश्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2142746, "chapter_id": 4077, "verse_number": "३२", "content_sanskrit": "शिरांसि तस्याजायन्त त्रीण्येव शकुनास्त्रयः ।\nतित्तिरिः कलविङ्कश्च तथैव च कपिञ्जलः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2142747, "chapter_id": 4077, "verse_number": "३३", "content_sanskrit": "विश्वरूपशिरांस्येव जायन्ते तानि भारत ।\nघातितस्य शिरांस्याजौ जीवन्तीवाद्भुतानि च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2142748, "chapter_id": 4077, "verse_number": "३४", "content_sanskrit": "ततोऽतिभीतगात्रस्तु शक्र आस्ते विचारयन्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2142749, "chapter_id": 4077, "verse_number": "३५", "content_sanskrit": "अथाजगाम परशुं स्कन्धेनादाय वर्धकी ।\nतदरण्यं महाराज यत्रास्तेऽसौ निपातितः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2142750, "chapter_id": 4077, "verse_number": "३६", "content_sanskrit": "स भीतस्तत्र तक्षाणं घटमानं शचीपतिः ।\nअपश्यदब्रवीच्चैनं सत्वरं पाकशासनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2142751, "chapter_id": 4077, "verse_number": "३७", "content_sanskrit": "परश्वथेन तीक्ष्णेन शिरांस्यस्य निकृन्त वै ।\nक्षिप्रं छिन्दि शिरांस्यस्य कुरुष्व वचनं मम\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2142752, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "तक्षा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2142753, "chapter_id": 4077, "verse_number": "३८", "content_sanskrit": "महास्कन्धो भृशं ह्येष परशुर्न भविष्यति ।\nकर्तुं चाहं न शक्ष्यामि कर्म सद्भिर्विगर्हितम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2142754, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2142755, "chapter_id": 4077, "verse_number": "३९", "content_sanskrit": "माभैस्त्वं शीघ्रमेतद्वै कुरुष्व वचनं मम ।\nमत्प्रसादाद्धि ते शस्त्रं वज्रकल्पं भविष्यति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2142756, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "तक्षा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2142757, "chapter_id": 4077, "verse_number": "४०", "content_sanskrit": "कं भवन्तमहं विद्यां घोरकर्माणमद्य वै ।\nएतदिच्छाम्यहं ज्ञातुं तत्त्वेन कथयस्व मे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2142758, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2142759, "chapter_id": 4077, "verse_number": "४१", "content_sanskrit": "अहमिन्द्रो देवराजः तक्षन् विदितमस्तु ते ।\nकुरुष्वैतद् यथोक्तं मे तक्षन् मा त्वं विचारय\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2142760, "chapter_id": 4077, "verse_number": "४२", "content_sanskrit": "मया हि निहतः शेते त्रिशिरास्त्वं च विद्धि वै\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2142761, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2142762, "chapter_id": 4077, "verse_number": "४३", "content_sanskrit": "स प्रह्वः प्राञ्जलिर्भूत्वा इदं वचनमब्रवीत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2142763, "chapter_id": 4077, "verse_number": "४४", "content_sanskrit": "क्रूरेण नापत्रपसे कथं शक्रेह कर्मणा ।\nऋषिपुत्रमिमं हत्वा ब्रह्महत्याभयं न किम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2142764, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2142765, "chapter_id": 4077, "verse_number": "४५", "content_sanskrit": "पश्चाद्धर्मं चरिष्यामि पावनार्थं सुदुश्चरम् ।\nशत्रुरेष महावीर्यो वज्रेण निहतो मया\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2142766, "chapter_id": 4077, "verse_number": "४६", "content_sanskrit": "अद्यापि चाहमुद्विग्नः तक्षन्नस्माद् बिभेमि वै ।\nक्षिप्रं छिन्धि शिरांसि त्वं करिष्येऽनुग्रहं तव\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2142767, "chapter_id": 4077, "verse_number": "४७", "content_sanskrit": "शिरः पशोस्ते दास्यन्ति भागं यज्ञेषु मानवाः ।\nएष तेऽनुग्रहस्तक्षन् क्षिप्रं कुरु मम प्रियम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2142768, "chapter_id": 4077, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2142769, "chapter_id": 4077, "verse_number": "४८", "content_sanskrit": "एतच्छ्रुत्वा तु तक्षा स महेन्द्रवचनं तदा ।\nशिरांस्यथ त्रिशिरसः कुठारेणाच्छिनत् तदा\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2142770, "chapter_id": 4077, "verse_number": "४९", "content_sanskrit": "निकृत्तेषु ततस्तेषु निष्क्रामन्नण्डजास्त्वथ ।\nकपिञ्जलास्तित्तिराश्च कलविङ्काश्च सर्वशः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2142771, "chapter_id": 4077, "verse_number": "५०", "content_sanskrit": "येन वेदानधीते स्म पिबते सोममेव च ।\nतस्माद् वक्त्राद् विनिष्पेतुः क्षिप्रं तस्य कपिञ्जलाः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2142772, "chapter_id": 4077, "verse_number": "५१", "content_sanskrit": "येन सर्वा दिशो राजन् पिबन्निव निरीक्षते ।\nतस्माद् वक्त्राद् विनिष्पेतुस्तित्तिरास्तस्य पाण्डव\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2142773, "chapter_id": 4077, "verse_number": "५२", "content_sanskrit": "यत् सुरापं तु तस्यासीद् वक्त्रं त्रिशिरसस्तदा ।\nकलविङ्काः समुत्पेतुः श्येनाश्च भरतर्षभ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2142774, "chapter_id": 4077, "verse_number": "५३", "content_sanskrit": "ततस्तेषु निकृत्तेषु विज्वरो मघवानथ ।\nतक्ष्णे तथा वरं दत्त्वा प्रहृष्टस्त्रिदशेश्वरः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2142775, "chapter_id": 4077, "verse_number": "५४", "content_sanskrit": "जगाम त्रिदिवं देवः तक्षाऽपि स्वगृहान् ययौ\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2142776, "chapter_id": 4077, "verse_number": "५५", "content_sanskrit": "तक्षाऽपि स्वगृहं गत्वा नैव शंसति कस्यचित् ।\nअथैनं नाभिजानन्ति वर्षमेकं तथागतम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2142777, "chapter_id": 4077, "verse_number": "५६", "content_sanskrit": "अथ संवत्सरे पूर्णे भूताः पशुपतेः प्रभो ।\nसमाक्रोशन्त मघवान् नः प्रभुर्ब्रह्महा इति\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2142778, "chapter_id": 4077, "verse_number": "५७", "content_sanskrit": "तत इन्द्रो व्रतं घोरमाचरत् पाकशासनः ।\nतपसा च सुसंयुक्तः सह देवैर्मरुद्गणैः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2142779, "chapter_id": 4077, "verse_number": "५८", "content_sanskrit": "समुद्रेषु पृथिव्यां च वनस्पतिषु स्त्रीषु च ।\nविभज्य ब्रह्महत्यां च तान् वरैरप्ययोजयत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2142780, "chapter_id": 4077, "verse_number": "५९", "content_sanskrit": "वरदस्तु वरं दत्त्वा पृथिव्यै सागराय च ।\nवनस्पतिभ्यः स्त्रीभ्यश्च ब्रह्महत्यां नुनोद ताम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2142781, "chapter_id": 4077, "verse_number": "६०", "content_sanskrit": "ततस्तु शुद्धो भगवान् देवैर्लोकैश्च पूजितः ।\nइन्द्रस्थानमुपातिष्ठत् पूज्यमानो महर्षिभिः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2142782, "chapter_id": 4077, "verse_number": "६१", "content_sanskrit": "मेने कृतार्थमात्मानं हत्वा शत्रून् सुरारिहा\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2142783, "chapter_id": 4077, "verse_number": "६२", "content_sanskrit": "त्वष्टा प्रजापतिः श्रुत्वा शक्रेणाथ सुतं हतम् ।\nक्रोधसंरक्तनयन इदं वचनमब्रवीत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2142784, "chapter_id": 4077, "verse_number": "६३", "content_sanskrit": "तप्यमानं तपो नित्यं क्षान्तं दान्तं जितेन्द्रियम् ।\nविनाऽपराधेन यतः पुत्रं हिंसितवान् मम\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2142785, "chapter_id": 4077, "verse_number": "६४", "content_sanskrit": "तस्मादिन्द्रविनाशाय वृत्रमुत्पादयाम्यहम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2142786, "chapter_id": 4077, "verse_number": "६५", "content_sanskrit": "लोकाः पश्यन्तु मे वीर्यं तपसश्च बलं महत् ।\nस च पश्यतु देवेन्द्रो दुरात्मा पापचेतनः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2142787, "chapter_id": 4077, "verse_number": "६६", "content_sanskrit": "उपस्पृश्य ततः क्रुद्धः तपस्वी सुमहायशाः ।\nअग्नौ हुत्वा समुत्पाद्य घोरं वृत्रमुवाच ह\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2142788, "chapter_id": 4077, "verse_number": "६७", "content_sanskrit": "इन्द्रशत्रो विवर्धस्व प्रभावात् तपसो मम\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2142789, "chapter_id": 4077, "verse_number": "६८", "content_sanskrit": "सोऽवर्धत दिवं स्तब्ध्वा सूर्यवैश्वानरोपमः ।\nकिं करोमीति चोवाच कालसूर्य इवोदितः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2142790, "chapter_id": 4077, "verse_number": "६९", "content_sanskrit": "शक्रं जहीति चाप्युक्तो जगाम त्रिदिवं ततः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2142791, "chapter_id": 4077, "verse_number": "७०", "content_sanskrit": "ग्रस्ता लोकाश्च वृत्रेण सर्वे भरतसत्तम ।\nत्वष्टुस्तेजोविवृद्धेन वृत्रेण सुमहात्मना\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2142792, "chapter_id": 4077, "verse_number": "७१", "content_sanskrit": "सर्वगन्धेन्द्रियरसा हृता भारत तेन वै\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2142793, "chapter_id": 4077, "verse_number": "७२", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम् ।\nहृतमेतन्महाराज वृत्रेण सुमहात्मना\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2142794, "chapter_id": 4077, "verse_number": "७३", "content_sanskrit": "ततो युद्धं समभवद् वृत्रवासवयोर्महत् ।\nसङ्क्रुद्धयोर्महाघोरं प्रसक्तं कुरुसत्तम\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2142795, "chapter_id": 4077, "verse_number": "७४", "content_sanskrit": "ततो जग्राह देवेन्द्रं वृत्रो वीरः शतक्रतुम् ।\nअपावृत्याक्षिपद् वक्त्रे शक्रं कोपसमन्वितः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2142796, "chapter_id": 4077, "verse_number": "७५", "content_sanskrit": "ग्रस्ते वृत्रेण शक्रे तु सम्भ्रान्तास्त्रिदिवेश्वराः ।\nअसृजंस्ते महासत्वा जृम्भिकां वृत्रनाशिनीम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2142797, "chapter_id": 4077, "verse_number": "७६", "content_sanskrit": "विजृम्भमाणस्य ततो वृत्रस्यास्यादपावृतात् ।\nस्वान्यङ्गान्यभिसङ्क्षिप्य निष्क्रान्तो बलसूदनः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2142798, "chapter_id": 4077, "verse_number": "७७", "content_sanskrit": "ततः प्रभृति लोकस्य जृम्भिका प्राणिसंश्रिता ।\nजहृषुश्च सुराः सर्वे शक्रं दृष्ट्वा विनिःसृतम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2142799, "chapter_id": 4077, "verse_number": "७८", "content_sanskrit": "ततः प्रववृधे युद्धं वृत्रवासवयोः पुनः ।\nसंरब्धयोस्तदा घोरं सुचिरं भरतर्षभ\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2142800, "chapter_id": 4077, "verse_number": "७९", "content_sanskrit": "यदा व्यवर्धत रणे वृत्रो बलसमन्वितः ।\nत्वष्टुस्तेजोबलाविद्धः तदा शक्रो न्यवर्तत\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2142801, "chapter_id": 4077, "verse_number": "८०", "content_sanskrit": "निवृत्ते च तदा देवा विषादमगमन् पुनः ।\nसमेत्य सह शक्रेण त्वष्टुस्तेजोविमोहिताः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2142802, "chapter_id": 4077, "verse_number": "८१", "content_sanskrit": "अमन्त्रयन्त ते सर्वे मुनिभिः सह भारत ।\nकिं कार्यमिति वै राजन् विचिन्त्य भयमोहिताः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2142803, "chapter_id": 4077, "verse_number": "८२", "content_sanskrit": "जग्मुः सर्वे महात्मानं मनोभिर्विष्णुमव्ययम् ।\nउपविष्टा मन्दराग्रे सर्वे वृत्रवधेप्सवः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2142804, "chapter_id": 4077, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि नवमोऽध्यायः ॥९॥ सेनोद्योगपर्वणि नवमोऽध्यायः ॥९॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]