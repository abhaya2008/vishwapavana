[{"id": 5000457000, "chapter_id": 9457, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000457001, "chapter_id": 9457, "verse_number": "६-५०-१", "content_sanskrit": "अथोवाच महातेजा हरिराजो महाबलः।\nकिमियं व्यथिता सेना मूढवातेव नौर्जले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000457002, "chapter_id": 9457, "verse_number": "६-५०-२", "content_sanskrit": "सुग्रीवस्य वचः श्रुत्वा वालिपुत्रोऽङ्गदोऽब्रवीत्।\nन त्वं पश्यसि रामं च लक्ष्मणं च महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000457003, "chapter_id": 9457, "verse_number": "६-५०-३", "content_sanskrit": "शरजालाचितौ वीरावुभौ दशरथात्मजौ।\nशरतल्पे महात्मानौ शयानौ रुधिरोक्षितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000457004, "chapter_id": 9457, "verse_number": "६-५०-४", "content_sanskrit": "अथाब्रवीद् वानरेन्द्रः सुग्रीवः पुत्रमङ्गदम्।\nनानिमित्तमिदं मन्ये भवितव्यं भयेन तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000457005, "chapter_id": 9457, "verse_number": "६-५०-५", "content_sanskrit": "विषण्णवदना ह्येते त्यक्तप्रहरणा दिशः।\nपलायन्तेऽत्र हरयस्त्रासादुत्फुल्ललोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000457006, "chapter_id": 9457, "verse_number": "६-५०-६", "content_sanskrit": "अन्योन्यस्य न लज्जन्ते न निरीक्षन्ति पृष्ठतः।\nविप्रकर्षन्ति चान्योन्यं पतितं लङ्घयन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000457007, "chapter_id": 9457, "verse_number": "६-५०-७", "content_sanskrit": "एतस्मिन्नन्तरे वीरो गदापाणिर्विभीषणः।\nसुग्रीवं वर्धयामास राघवं च जयाशिषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000457008, "chapter_id": 9457, "verse_number": "६-५०-८", "content_sanskrit": "विभीषणं च सुग्रीवो दृष्ट्वा वानरभीषणम्।\nऋक्षराजं महात्मानं समीपस्थमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000457009, "chapter_id": 9457, "verse_number": "६-५०-९", "content_sanskrit": "विभीषणोऽयं सम्प्राप्तो यं दृष्ट्वा वानरर्षभाः।\nद्रवन्त्यायतसंत्रासा रावणात्मजशङ्कया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000457010, "chapter_id": 9457, "verse_number": "६-५०-१०", "content_sanskrit": "शीघ्रमेतान् सुसंत्रस्तान् बहुधा विप्रधावितान्।\nपर्यवस्थापयाख्याहि विभीषणमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000457011, "chapter_id": 9457, "verse_number": "६-५०-११", "content_sanskrit": "सुग्रीवेणैवमुक्तस्तु जाम्बवानृक्षपार्थिवः।\nवानरान् सान्त्वयामास संनिवर्त्य प्रधावतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000457012, "chapter_id": 9457, "verse_number": "६-५०-१२", "content_sanskrit": "ते निवृत्ताः पुनः सर्वे वानरास्त्यक्तसाध्वसाः।\nऋक्षराजवचः श्रुत्वा तं च दृष्ट्वा विभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000457013, "chapter_id": 9457, "verse_number": "६-५०-१३", "content_sanskrit": "विभीषणस्तु रामस्य दृष्ट्वा गात्रं शरैश्चितम्।\nलक्ष्मणस्य तु धर्मात्मा बभूव व्यथितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000457014, "chapter_id": 9457, "verse_number": "६-५०-१४", "content_sanskrit": "जलक्लिन्नेन हस्तेन तयोर्नेत्रे विमृज्य च।\nशोकसम्पीडितमना रुरोद विललाप च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000457015, "chapter_id": 9457, "verse_number": "६-५०-१५", "content_sanskrit": "इमौ तौ सत्त्वसम्पन्नौ विक्रान्तौ प्रियसंयुगौ।\nइमामवस्थां गमितौ राक्षसैः कूटयोधिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000457016, "chapter_id": 9457, "verse_number": "६-५०-१६", "content_sanskrit": "भ्रातृपुत्रेण चैतेन दुष्पुत्रेण दुरात्मना।\nराक्षस्या जिह्मया बुद्ध्या वञ्चितावृजुविक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000457017, "chapter_id": 9457, "verse_number": "६-५०-१७", "content_sanskrit": "शरैरिमावलं विद्धौ रुधिरेण समुक्षितौ।\nवसुधायामिमौ सुप्तौ दृश्येते शल्यकाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000457018, "chapter_id": 9457, "verse_number": "६-५०-१८", "content_sanskrit": "ययोर्वीर्यमुपाश्रित्य प्रतिष्ठा काङ्क्षिता मया।\nताविमौ देहनाशाय प्रसुप्तौ पुरुषर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000457019, "chapter_id": 9457, "verse_number": "६-५०-१९", "content_sanskrit": "जीवन्नद्य विपन्नोऽस्मि नष्टराज्यमनोरथः।\nप्राप्तप्रतिज्ञश्च रिपुः सकामो रावणः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000457020, "chapter_id": 9457, "verse_number": "६-५०-२०", "content_sanskrit": "एवं विलपमानं तं परिष्वज्य विभीषणम्।\nसुग्रीवः सत्त्वसम्पन्नो हरिराजोऽब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000457021, "chapter_id": 9457, "verse_number": "६-५०-२१", "content_sanskrit": "राज्यं प्राप्स्यसि धर्मज्ञ लङ्कायां नेह संशयः।\nरावणः सह पुत्रेण स्वकामं नेह लप्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000457022, "chapter_id": 9457, "verse_number": "६-५०-२२", "content_sanskrit": "गरुडाधिष्ठितावेतावुभौ राघवलक्ष्मणौ।\nत्यक्त्वा मोहं वधिष्येते सगणं रावणं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000457023, "chapter_id": 9457, "verse_number": "६-५०-२३", "content_sanskrit": "तमेवं सान्त्वयित्वा तु समाश्वास्य तु राक्षसम्।\nसुषेणं श्वशुरं पार्श्वे सुग्रीवस्तमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000457024, "chapter_id": 9457, "verse_number": "६-५०-२४", "content_sanskrit": "सह शूरैर्हरिगणैर्लब्धसंज्ञावरिंदमौ।\nगच्छ त्वं भ्रातरौ गृह्य किष्किन्धां रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000457025, "chapter_id": 9457, "verse_number": "६-५०-२५", "content_sanskrit": "अहं तु रावणं हत्वा सपुत्रं सहबान्धवम्।\nमैथिलीमानयिष्यामि शक्रो नष्टामिव श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000457026, "chapter_id": 9457, "verse_number": "६-५०-२६", "content_sanskrit": "श्रुत्वैतद् वानरेन्द्रस्य सुषेणो वाक्यमब्रवीत्।\nदेवासुरं महायुद्धमनुभूतं पुरातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000457027, "chapter_id": 9457, "verse_number": "६-५०-२७", "content_sanskrit": "तदा स्म दानवा देवान् शरसंस्पर्शकोविदान्।\nनिजघ्नुः शस्त्रविदुषश्छादयन्तो मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000457028, "chapter_id": 9457, "verse_number": "६-५०-२८", "content_sanskrit": "तानार्तान् नष्टसंज्ञांश्च गतासूंश्च बृहस्पतिः।\nविद्याभिर्मन्त्रयुक्ताभिरोषधीभिश्चिकित्सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000457029, "chapter_id": 9457, "verse_number": "६-५०-२९", "content_sanskrit": "तान्यौषधान्यानयितुं क्षीरोदं यान्तु सागरम्।\nजवेन वानराः शीघ्रं सम्पातिपनसादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000457030, "chapter_id": 9457, "verse_number": "६-५०-३०", "content_sanskrit": "हरयस्तु विजानन्ति पार्वती ते महौषधी।\nसंजीवकरणीं दिव्यां विशल्यां देवनिर्मिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000457031, "chapter_id": 9457, "verse_number": "६-५०-३१", "content_sanskrit": "चन्द्रश्च नाम द्रोणश्च क्षीरोदे सागरोत्तमे।\nअमृतं यत्र मथितं तत्र ते परमौषधी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000457032, "chapter_id": 9457, "verse_number": "६-५०-३२", "content_sanskrit": "तौ तत्र विहितौ देवैः पर्वतौ तौ महोदधौ।\nअयं वायुसुतो राजन् हनूमांस्तत्र गच्छतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000457033, "chapter_id": 9457, "verse_number": "६-५०-३३", "content_sanskrit": "एतस्मिन्नन्तरे वायुर्मेघाश्चापि सविद्युतः।\nपर्यस्य सागरे तोयं कम्पयन्निव पर्वतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000457034, "chapter_id": 9457, "verse_number": "६-५०-३४", "content_sanskrit": "महता पक्षवातेन सर्वद्वीपमहाद्रुमाः।\nनिपेतुर्भग्नविटपाः सलिले लवणाम्भसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000457035, "chapter_id": 9457, "verse_number": "६-५०-३५", "content_sanskrit": "अभवन् पन्नगास्त्रस्ता भोगिनस्तत्रवासिनः।\nशीघ्रं सर्वाणि यादांसि जग्मुश्च लवणार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000457036, "chapter_id": 9457, "verse_number": "६-५०-३६", "content_sanskrit": "ततो मुहूर्ताद् गरुडं वैनतेयं महाबलम्।\nवानरा ददृशुः सर्वे ज्वलन्तमिव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000457037, "chapter_id": 9457, "verse_number": "६-५०-३७", "content_sanskrit": "तमागतमभिप्रेक्ष्य नागास्ते विप्रदुद्रुवुः।\nयैस्तु तौ पुरुषौ बद्धौ शरभूतैर्महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000457038, "chapter_id": 9457, "verse_number": "६-५०-३८", "content_sanskrit": "ततः सुपर्णः काकुत्स्थौ स्पृष्ट्वा प्रत्यभिनन्द्य च।\nविममर्श च पाणिभ्यां मुखे चन्द्रसमप्रभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000457039, "chapter_id": 9457, "verse_number": "६-५०-३९", "content_sanskrit": "वैनतेयेन संस्पृष्टास्तयोः संरुरुहुर्व्रणाः।\nसुवर्णे च तनू स्निग्धे तयोराशु बभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000457040, "chapter_id": 9457, "verse_number": "६-५०-४०", "content_sanskrit": "तेजो वीर्यं बलं चौज उत्साहश्च महागुणाः।\nप्रदर्शनं च बुद्धिश्च स्मृतिश्च द्विगुणा तयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000457041, "chapter_id": 9457, "verse_number": "६-५०-४१", "content_sanskrit": "तावुत्थाप्य महातेजा गरुडो वासवोपमौ।\nउभौ च सस्वजे हृष्टो रामश्चैनमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000457042, "chapter_id": 9457, "verse_number": "६-५०-४२", "content_sanskrit": "भवत्प्रसादाद् व्यसनं रावणिप्रभवं महत्।\nउपायेन व्यतिक्रान्तौ शीघ्रं च बलिनौ कृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000457043, "chapter_id": 9457, "verse_number": "६-५०-४३", "content_sanskrit": "यथा तातं दशरथं यथाजं च पितामहम्।\nतथा भवन्तमासाद्य हृदयं मे प्रसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000457044, "chapter_id": 9457, "verse_number": "६-५०-४४", "content_sanskrit": "को भवान् रूपसम्पन्नो दिव्यस्रगनुलेपनः।\nवसानो विरजे वस्त्रे दिव्याभरणभूषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000457045, "chapter_id": 9457, "verse_number": "६-५०-४५", "content_sanskrit": "तमुवाच महातेजा वैनतेयो महाबलः।\nपतत्त्रिराजः प्रीतात्मा हर्षपर्याकुलेक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000457046, "chapter_id": 9457, "verse_number": "६-५०-४६", "content_sanskrit": "अहं सखा ते काकुत्स्थ प्रियः प्राणो बहिश्चरः।\nगरुत्मानिह सम्प्राप्तो युवयोः साह्यकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000457047, "chapter_id": 9457, "verse_number": "६-५०-४७", "content_sanskrit": "असुरा वा महावीर्या दानवा वा महाबलाः।\nसुराश्चापि सगन्धर्वाः पुरस्कृत्य शतक्रतुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000457048, "chapter_id": 9457, "verse_number": "६-५०-४८", "content_sanskrit": "नेमं मोक्षयितुं शक्ताः शरबन्धं सुदारुणम्।\nमायाबलादिन्द्रजिता निर्मितं क्रूरकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000457049, "chapter_id": 9457, "verse_number": "६-५०-४९", "content_sanskrit": "एते नागाः काद्रवेयास्तीक्ष्णदंष्ट्रा विषोल्बणाः।\nरक्षोमायाप्रभावेण शरभूतास्त्वदाश्रयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000457050, "chapter_id": 9457, "verse_number": "६-५०-५०", "content_sanskrit": "सभाग्यश्चासि धर्मज्ञ राम सत्यपराक्रम।\nलक्ष्मणेन सह भ्रात्रा समरे रिपुघातिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000457051, "chapter_id": 9457, "verse_number": "६-५०-५१", "content_sanskrit": "इमं श्रुत्वा तु वृत्तान्तं त्वरमाणोऽहमागतः।\nसहसैवावयोः स्नेहात् सखित्वमनुपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000457052, "chapter_id": 9457, "verse_number": "६-५०-५२", "content_sanskrit": "मोक्षितौ च महाघोरादस्मात् सायकबन्धनात्।\nअप्रमादश्च कर्तव्यो युवाभ्यां नित्यमेव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000457053, "chapter_id": 9457, "verse_number": "६-५०-५३", "content_sanskrit": "प्रकृत्या राक्षसाः सर्वे संग्रामे कूटयोधिनः।\nशूराणां शुद्धभावानां भवतामार्जवं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000457054, "chapter_id": 9457, "verse_number": "६-५०-५४", "content_sanskrit": "तन्न विश्वसनीयं वो राक्षसानां रणाजिरे।\nएतेनैवोपमानेन नित्यं जिह्मा हि राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000457055, "chapter_id": 9457, "verse_number": "६-५०-५५", "content_sanskrit": "एवमुक्त्वा तदा रामं सुपर्णः स महाबलः।\nपरिष्वज्य च सुस्निग्धमाप्रष्टुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000457056, "chapter_id": 9457, "verse_number": "६-५०-५६", "content_sanskrit": "सखे राघव धर्मज्ञ रिपूणामपि वत्सल।\nअभ्यनुज्ञातुमिच्छामि गमिष्यामि यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000457057, "chapter_id": 9457, "verse_number": "६-५०-५७", "content_sanskrit": "न च कौतूहलं कार्यं सखित्वं प्रति राघव।\nकृतकर्मा रणे वीर सखित्वं प्रतिवेत्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000457058, "chapter_id": 9457, "verse_number": "६-५०-५८", "content_sanskrit": "बालवृद्धावशेषां तु लङ्कां कृत्वा शरोर्मिभिः।\nरावणं तु रिपुं हत्वा सीतां त्वमुपलप्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000457059, "chapter_id": 9457, "verse_number": "६-५०-५९", "content_sanskrit": "इत्येवमुक्त्वा वचनं सुपर्णः शीघ्रविक्रमः।\nरामं च नीरुजं कृत्वा मध्ये तेषां वनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000457060, "chapter_id": 9457, "verse_number": "६-५०-६०", "content_sanskrit": "प्रदक्षिणं ततः कृत्वा परिष्वज्य च वीर्यवान्।\nजगामाकाशमाविश्य सुपर्णः पवनो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000457061, "chapter_id": 9457, "verse_number": "६-५०-६१", "content_sanskrit": "नीरुजौ राघवौ दृष्ट्वा ततो वानरयूथपाः।\nसिंहनादं तदा नेदुर्लाङ्गूलं दुधुवुश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000457062, "chapter_id": 9457, "verse_number": "६-५०-६२", "content_sanskrit": "ततो भेरीः समाजघ्नुर्मृदङ्गांश्चाप्यवादयन्।\nदध्मुः शङ्खान् सम्प्रहृष्टाः क्ष्वेलन्त्यपि यथापुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000457063, "chapter_id": 9457, "verse_number": "६-५०-६३", "content_sanskrit": "अपरे स्फोट्य विक्रान्ता वानरा नगयोधिनः।\nद्रुमानुत्पाट्य विविधांस्तस्थुः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000457064, "chapter_id": 9457, "verse_number": "६-५०-६४", "content_sanskrit": "विसृजन्तो महानादांस्त्रासयन्तो निशाचरान्।\nलङ्काद्वाराण्युपाजग्मुर्योद्धुकामाः प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000457065, "chapter_id": 9457, "verse_number": "६-५०-६५", "content_sanskrit": "तेषां सुभीमस्तुमुलो निनादो\nबभूव शाखामृगयूथपानाम्।\nक्षये निदाघस्य यथा घनानां\nनादः सुभीमो नदतां निशीथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000457066, "chapter_id": 9457, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000457067, "chapter_id": 9457, "verse_number": null, "content_sanskrit": "”’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]