[{"id": 2172633, "chapter_id": 4678, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172634, "chapter_id": 4678, "verse_number": "१", "content_sanskrit": "एवमुक्तस्ततो राजा गौतमेन महात्मना ।\nनिःश्वस्य दीर्घमुष्णं च तूष्णीमासीद् विशाम्पते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172635, "chapter_id": 4678, "verse_number": "२", "content_sanskrit": "ततो मुहूर्तं स ध्यात्वा पुत्रस्तव महामनाः ।\nकृपं शारद्वतं वाक्यमित्युवाच परन्तपः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172636, "chapter_id": 4678, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172637, "chapter_id": 4678, "verse_number": "३", "content_sanskrit": "यत् किञ्चित् सुहृदा वाच्यं तत् सर्वं श्रावितं त्वया ।\nकृतं च भवता सर्वं प्राणान् सन्त्यज्य युध्यता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172638, "chapter_id": 4678, "verse_number": "४", "content_sanskrit": "गाहमानमनीकानि युध्यमानं महारथैः ।\nपाण्डवैरतितेजोभिः लोकस्त्वामनुदृष्टवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172639, "chapter_id": 4678, "verse_number": "५", "content_sanskrit": "सुहृदा यद्धितं वाच्यं भवता श्रावितोऽस्म्यहम् ।\nनाभिनन्दामि तत्सर्वं मुमूर्षुरिव भेषजम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172640, "chapter_id": 4678, "verse_number": "६", "content_sanskrit": "हेतुकारणसंयुक्तं हितं वचनमुत्तमम् ।\nउच्यमानं महाबाहो न मे विप्राग्र्य रोचते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172641, "chapter_id": 4678, "verse_number": "७", "content_sanskrit": "राज्याद् विनिष्कृतोऽस्माभिः कथं सोऽस्मासु विश्वसेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172642, "chapter_id": 4678, "verse_number": "८", "content_sanskrit": "अक्षद्यूते च नृपतिः जितोऽस्माभिः महाधनः ।\nस कथं मम वाक्यानि श्रद्दध्याद् भूय एव तु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172643, "chapter_id": 4678, "verse_number": "९", "content_sanskrit": "तथा दौत्येन सम्प्राप्तः कृष्णः पार्थहिते रतः ।\nप्रलब्धश्च हृषीकेशः तच्च कर्म विरोधितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172644, "chapter_id": 4678, "verse_number": "१०", "content_sanskrit": "स हि मे वचनं ब्रह्मन् कथमेवाभिमंस्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172645, "chapter_id": 4678, "verse_number": "११", "content_sanskrit": "विललाप च यत् कृष्णा सभामध्ये समेयुषी ।\nनैतन्मर्षयते कृष्णो न राज्यहरणं तथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172646, "chapter_id": 4678, "verse_number": "१२", "content_sanskrit": "एकप्राणौ हि तौ कृष्णावन्योन्यमभिसंहितौ ।\nपुरा यच्छ्रुतमस्माभिः अद्य पश्यामि तत् प्रभो\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172647, "chapter_id": 4678, "verse_number": "१३", "content_sanskrit": "स्वस्रीयं च हतं दृष्ट्वा दुःखं स्वपिति केशवः ।\nकृतागसो वयं तस्य स मदर्थे कथं क्षमेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172648, "chapter_id": 4678, "verse_number": "१४", "content_sanskrit": "अभिमन्योर्विनाशेन न शर्म लभतेऽर्जुनः ।\nस कथं मद्धिते यत्नं प्रकरिष्यति याचितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172649, "chapter_id": 4678, "verse_number": "१५", "content_sanskrit": "मध्यमः पाण्डवस्तीक्ष्णो भीमसेनो महाबलः ।\nप्रतिज्ञातं च तेनोग्रं भग्नदर्पः कथं क्षमेत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172650, "chapter_id": 4678, "verse_number": "१६", "content_sanskrit": "उभौ च बद्धनिस्त्रिंशौ कालाग्निसदृशद्युती ।\nकृतवैरौ तु तौ वीरौ यमावपि यमोपमौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172651, "chapter_id": 4678, "verse_number": "१७", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च कृतवैरौ मया सह ।\nतौ कथं मद्धिते यत्नं कुर्यातां द्विजसत्तम\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172652, "chapter_id": 4678, "verse_number": "१८", "content_sanskrit": "दुःशासनेन यत् कृष्णा एकवस्त्रा रजस्वला ।\nपरिक्लिष्टा सभामध्ये सर्वलोकस्य पश्यतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172653, "chapter_id": 4678, "verse_number": "१९", "content_sanskrit": "तथा विवसनां दीनां स्मरन्तोऽद्यापि पाण्डवाः ।\nन निवारयितुं शक्याः सङ्ग्रामात् ते परन्तपाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172654, "chapter_id": 4678, "verse_number": "२०", "content_sanskrit": "सदा च द्रौपदी क्रुद्धा मद्विनाशाय दीक्षिता ।\nउग्रं तेपे तपः कृष्णा भर्तॄणामर्थसिद्धये\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172655, "chapter_id": 4678, "verse_number": "२१", "content_sanskrit": "निःश्वसन्ती भृशं शेते यावद्वैरस्य यातना ।\nनिक्षिप्य मानं दर्पं च वासुदेवसहोदरी\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172656, "chapter_id": 4678, "verse_number": "२२", "content_sanskrit": "कृष्णायाः प्रेष्यवद्भूत्वा शुश्रूषां कुरुते सदा ।\nइति वैरं समुन्नद्धं न निर्वाति कथञ्चन\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172657, "chapter_id": 4678, "verse_number": "२३", "content_sanskrit": "अभिमन्योर्विनाशेन स सन्धेयः कथं भवेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172658, "chapter_id": 4678, "verse_number": "२४", "content_sanskrit": "कथं नु राजा भुक्त्वेमां पृथिवीं सागराम्बराम् ।\nपाण्डवानां प्रसादेन सम्भोज्यं राज्यमल्पकम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172659, "chapter_id": 4678, "verse_number": "२५", "content_sanskrit": "उपर्युपरि राज्ञां वै ज्वलिता भास्करो यथा ।\nयुधिष्ठिरं कथं पश्चाद् अनुयास्यामि दासवत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172660, "chapter_id": 4678, "verse_number": "२६", "content_sanskrit": "कथं भोगान् स्वयं भुक्त्वा दत्वा देयांश्च पुष्कलान् ।\nकृपणं वर्तयिष्यामि कुनृपैः सह जीविकाम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172661, "chapter_id": 4678, "verse_number": "२७", "content_sanskrit": "नाभ्यसूयामि ते वाक्यमुक्तं स्नेहादिदं त्वया ।\nन तु सन्धिमहं मन्ये प्राप्तकालं कथञ्चन\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172662, "chapter_id": 4678, "verse_number": "२८", "content_sanskrit": "सुनीतमनुपश्यामि सुयुद्धेन परन्तप ।\nनायं क्लीबयितुं कालः संयोद्धुं काल एव नः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172663, "chapter_id": 4678, "verse_number": "२९", "content_sanskrit": "इष्टं मे बहुभिर्यज्ञैः दत्ता विप्रेषु दक्षिणाः ।\nप्राप्तः क्रमो नरेन्द्राणां शत्रूणां मूर्ध्न्यवस्थिताम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172664, "chapter_id": 4678, "verse_number": "३०", "content_sanskrit": "भृत्या मे सम्भृतास्तात दीनाश्चाप्युद्धृताः जनाः ।\nनोत्सहेऽहं द्विजश्रेष्ठ पाण्डवं वक्तुमीदृशम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172665, "chapter_id": 4678, "verse_number": "३१", "content_sanskrit": "जितानि परराष्ट्राणि स्वराष्ट्रमनुपालितम् ।\nभुक्ताश्च विविधा भोगाः त्रिवर्गाः सेविता मया\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172666, "chapter_id": 4678, "verse_number": "३२", "content_sanskrit": "पितॄणां गतमानृण्यं क्षत्रधर्मस्य चोभयोः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172667, "chapter_id": 4678, "verse_number": "३३", "content_sanskrit": "न ध्रुवं सुखमस्तीह कुतो राज्यं कुतो यशः ।\nइह कीर्तिर्विचेतव्या सा च युद्धेन नान्यथा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172668, "chapter_id": 4678, "verse_number": "३४", "content_sanskrit": "वृथा च यत् क्षत्रियस्य निधनं तद् विगर्हितम् ।\nअधर्मः सुमहानेष विण्मूत्रमरणं गृहे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172669, "chapter_id": 4678, "verse_number": "३५", "content_sanskrit": "अरण्ये यो विमुञ्चेत सङ्ग्रामे वा तनुं नृपः ।\nक्रतूनाहृत्य महतो महिमानं स गच्छति\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172670, "chapter_id": 4678, "verse_number": "३६", "content_sanskrit": "कृपणं विलपन्नार्तो जरया च परिप्लुतः ।\nम्रियते रुदतां मध्ये ज्ञातीनां न स पूरुषः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172671, "chapter_id": 4678, "verse_number": "३७", "content_sanskrit": "त्यक्त्वा नानाविधान् भोगान् प्राप्तानां परमां गतिम् ।\nअपीदानीं सुयुद्धेन गच्छेयं तत्सलोकताम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172672, "chapter_id": 4678, "verse_number": "३८", "content_sanskrit": "शूराणामार्यवृत्तानां सङ्ग्रामेष्वनिवर्तिनाम् ।\nधीमतां सत्यसन्धानां सर्वेषां क्रतुयाजिनाम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172673, "chapter_id": 4678, "verse_number": "३९", "content_sanskrit": "शस्त्रावभृथमाप्तानां ध्रुवो वासस्त्रिविष्टपे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172674, "chapter_id": 4678, "verse_number": "४०", "content_sanskrit": "मुदा नूनं प्रपश्यन्ति योधानप्सरसां गणाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172675, "chapter_id": 4678, "verse_number": "४१", "content_sanskrit": "पश्यन्ति नूनं पितरः पूजिताः सुरसंसदि ।\nअप्सरोभिः परिवृता मोदमानास्त्रिविष्टपे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172676, "chapter_id": 4678, "verse_number": "४२", "content_sanskrit": "पन्थानममरैः प्राप्तं शूरैश्चाप्यनिवर्तिभिः ।\nअपि तैः सङ्गतं मार्गं वयमध्यारुहेमहि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172677, "chapter_id": 4678, "verse_number": "४३", "content_sanskrit": "पितामहेन वृद्धेन तथाऽऽचार्येण धीमता ।\nजयद्रथेन कर्णेन तथा दुःशासनादिभिः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172678, "chapter_id": 4678, "verse_number": "४४", "content_sanskrit": "घटमाना मदर्थेऽस्मिन् हताः शूरा जनाधिपाः ।\nशेरते लोहिताक्ताङ्गाः पृथिव्यां शरविक्षताः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172679, "chapter_id": 4678, "verse_number": "४५", "content_sanskrit": "नानाशस्त्रवृताः शूरा यथोक्तक्रतुयाजिनः ।\nत्यक्त्वा प्राणान् यथा न्यायमिमे समिति शेरते\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172680, "chapter_id": 4678, "verse_number": "४६", "content_sanskrit": "स्वैरं च चरितः पन्था दुर्गमो हि पुनर्भवेत् ।\nसम्पतद्भिर्महावेगैः इतो यास्यामि सद्गतिम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172681, "chapter_id": 4678, "verse_number": "४७", "content_sanskrit": "ये मदर्थं हताः शूराः तेषां कृतमनुस्मरन् ।\nऋणं तत्प्रतिमुञ्चानो न राज्ये मन आदधे\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172682, "chapter_id": 4678, "verse_number": "४८", "content_sanskrit": "घातयित्वा वयस्यांश्च भ्रातॄनथ पितामहान् ।\nजीवितं परिरक्षेयं लोको मां गर्हयेद् ध्रुवम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172683, "chapter_id": 4678, "verse_number": "४९", "content_sanskrit": "कीदृशं च भवेद् राज्यं मम हीनस्य बन्धुभिः ।\nसखिभिश्च सुहृद्भिश्च प्रणिपत्य च पाण्डवम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172684, "chapter_id": 4678, "verse_number": "५०", "content_sanskrit": "सोऽहमेतादृशं कृत्वा जगतोऽस्य पराभवम् ।\nसुयुद्धेन हतः स्वर्गं प्राप्स्यामि न तदन्यथा\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2172685, "chapter_id": 4678, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2172686, "chapter_id": 4678, "verse_number": "५१", "content_sanskrit": "एवं दुर्योधनेनोक्तं सर्वं सम्पूज्य तद्वचः ।\nसाधु साध्विति राजानं क्षत्रियाः सम्बभाषिरे\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2172687, "chapter_id": 4678, "verse_number": "५२", "content_sanskrit": "पराजयमशोचन्तः कृतचित्ताश्च विक्रमे ।\nसर्वे सुनिश्चिता योद्धुमुदग्रमनसोऽभवन्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2172688, "chapter_id": 4678, "verse_number": "५३", "content_sanskrit": "समाश्वास्य च राजानं सर्वे युद्धाभिनन्दिनः ।\nउदग्द्वियोजनं गत्वा प्रत्यतिष्ठन्त कौरवाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2172689, "chapter_id": 4678, "verse_number": "५४", "content_sanskrit": "आकाशे विद्रुमे पुण्ये प्रस्थे हिमवतः शुभे ।\nअरुणां सरस्वतीं प्राप्य पपुः सस्नुश्च ते जलम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2172690, "chapter_id": 4678, "verse_number": "५५", "content_sanskrit": "तव वत्साः कृतोत्साहाः पर्यवर्तन्त भारत ।\nपराजयमशोचन्तः कृतचित्ताश्च योधने\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2172691, "chapter_id": 4678, "verse_number": "५६", "content_sanskrit": "पर्यवस्थाप्य चात्मानमन्योन्येन पुनः पुनः ।\nसर्वे राजन् न्यवर्तन्त क्षत्रियाः कालचोदिताः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2172692, "chapter_id": 4678, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2172693, "chapter_id": 4678, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]