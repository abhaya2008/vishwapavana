[{"id": 7000829000, "chapter_id": 20829, "verse_number": "६-१७२-१", "content_sanskrit": "महादेव उवाच ।\nतस्मात्तीर्थात्परं तीर्थं नीलकंठेति विश्रुतम् ।\nतस्य वै दर्शनं कार्यं मुक्तिं चैवेच्छता सदा॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000829001, "chapter_id": 20829, "verse_number": "६-१७२-२", "content_sanskrit": "बिल्वपत्रैस्तथा धूपैर्दीपैर्वाथ सुरेश्वरि ।\nवांछितं लभते मर्त्यो नीलकंठस्य दर्शनात्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000829002, "chapter_id": 20829, "verse_number": "६-१७२-३", "content_sanskrit": "उपवासपरो देवि निर्जनेसौ स्थितः सदा ।\nयद्यद्वांच्छंति ये लोकास्तेषां तत्तद्ददाति च॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000829003, "chapter_id": 20829, "verse_number": "६-१७२-४", "content_sanskrit": "कलौ सा तु महादेवि विख्याता काश्यपीति वै॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]