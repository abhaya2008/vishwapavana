[{"id": 2149154, "chapter_id": 4228, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149155, "chapter_id": 4228, "verse_number": "१", "content_sanskrit": "सेनानिवेशं सम्प्राप्य कैतव्यः पार्थिवैः सह ।\nसमागतः पाण्डवैश्च युधिष्ठिरमभाषत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149156, "chapter_id": 4228, "verse_number": "२", "content_sanskrit": "अभिज्ञो दूतवाक्यानां यथोक्तं ब्रुवतो मम ।\nदुर्योधनसमादेशं श्रुत्वा न क्रोद्धुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149157, "chapter_id": 4228, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149158, "chapter_id": 4228, "verse_number": "३", "content_sanskrit": "उलूक न भयं तेऽस्ति ब्रूहि त्वं विगतज्वरः ।\nयन्मतं धार्तराष्ट्रस्य लुब्धस्यादीर्घदर्शिनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149159, "chapter_id": 4228, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149160, "chapter_id": 4228, "verse_number": "४", "content_sanskrit": "ततो द्युतिमतां मध्ये पाण्डवानां महात्मनाम् ।\nसृञ्जयानां च सर्वेषां कृष्णस्य च यशस्विनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149161, "chapter_id": 4228, "verse_number": "५", "content_sanskrit": "द्रुपदस्य सपुत्रस्य विराटस्य च सन्निधौ ।\nभूमिपानां च सर्वेषां मध्ये वाक्यं जगाद ह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149162, "chapter_id": 4228, "verse_number": "", "content_sanskrit": "उलूकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149163, "chapter_id": 4228, "verse_number": "६", "content_sanskrit": "इदं त्वामब्रवीद् राजा धार्तराष्ट्रो महाबलः ।\nशृण्वतां कुरुवीराणां तन्निबोध नराधिप\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149164, "chapter_id": 4228, "verse_number": "७", "content_sanskrit": "पराजितोऽसि द्यूतेन कृष्णा चानायिता सभाम् ।\nशक्योऽमर्षो मनुष्येण कर्तुं पुरुषमानिना\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149165, "chapter_id": 4228, "verse_number": "८", "content_sanskrit": "द्वादशैव च वर्षाणि वने धिष्ण्याद् निवासिताः ।\nसंवत्सरं विराटस्य दासमास्थाय चोषिताः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149166, "chapter_id": 4228, "verse_number": "९", "content_sanskrit": "बहूनि तत्र क्लेशानि वनवासं च पाण्डव ।\nद्रौपद्याश्च परिक्लेशं संस्मरन् पुरुषो भव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149167, "chapter_id": 4228, "verse_number": "१०", "content_sanskrit": "अशक्तेन च यच्छप्तं भीमसेनेन पाण्डव ।\nदुःशासनस्य रुधिरं पीयतां यदि शक्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149168, "chapter_id": 4228, "verse_number": "११", "content_sanskrit": "बलाभिहारो निर्वृत्तः कुरुक्षेत्रमकर्दमम् ।\nपुष्टास्तेऽश्वा भृता योधाः श्वो युध्यस्व सकेशवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149169, "chapter_id": 4228, "verse_number": "१२", "content_sanskrit": "असमागम्य भीष्मेण संयुगे किं विकत्थसे ।\nआरुरुक्षुर्यथा मन्दः पर्वतं गन्धमादनम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149170, "chapter_id": 4228, "verse_number": "१३", "content_sanskrit": "एवं कत्थसि कौन्तेय नकत्थन् कुरु पौरुषम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149171, "chapter_id": 4228, "verse_number": "१४", "content_sanskrit": "सूतपुत्रं सुदुर्धर्षं शल्यं च बलिनां वरम् ।\nअजित्वा संयुगे पार्थ राज्यं कथमिहेच्छसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149172, "chapter_id": 4228, "verse_number": "१५", "content_sanskrit": "द्रोणं च युध्यतां श्रेष्ठं शचीपतिसमं युधि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149173, "chapter_id": 4228, "verse_number": "१६", "content_sanskrit": "ब्राह्मे धनुषि चाचार्यं वेदयोरन्तगं द्वयोः ।\nयुधि धुर्यमसङ्क्षोभ्यम् अनीकधरमच्युतम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149174, "chapter_id": 4228, "verse_number": "१७", "content_sanskrit": "द्रोणं महाद्युतिं पार्थ यज्जिगीषसि तन्मृषा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2149175, "chapter_id": 4228, "verse_number": "१८", "content_sanskrit": "न हि शुश्रुम वातेन मेरुमुन्मथितं गिरिम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2149176, "chapter_id": 4228, "verse_number": "१९", "content_sanskrit": "अनिलो वा वहेन्मेरुं द्यौर्वाऽपि निपतेन्महीम् ।\nयुगं वा परिवर्तेत यद्येवं स्याद् यदात्थ माम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2149177, "chapter_id": 4228, "verse_number": "२०", "content_sanskrit": "को ह्यस्त्रजीविताकाङ्क्षी तीव्रास्त्रमरिकर्शनम् ।\nगजो वाजी नरो वाऽपि पुनः स्वस्थो गृहान् व्रजेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2149178, "chapter_id": 4228, "verse_number": "२१", "content_sanskrit": "कथमाभ्यामवध्यातः संसृष्टो दारुणेन च ।\nरणे जीवन् विमुच्येत पदा भूमिमुपस्पृशन्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2149179, "chapter_id": 4228, "verse_number": "२२", "content_sanskrit": "किं दर्दुरः कूपशयो यथेमां\nन बुध्यसे राजचमूं समेताम् ।\nदुराधर्षां देवचमूप्रकाशां\nगुप्तां नरेन्द्रैस्त्रिदशैरिव द्याम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2149180, "chapter_id": 4228, "verse_number": "२३", "content_sanskrit": "प्राच्यैः प्रतीच्यैरथ दाक्षिणात्यैः\nउदीच्यकाम्भोजशकैः खशैश्च ।\nसाल्वैः समत्स्यैः कुरुमध्यदेश्यैः\nम्लेच्छैः पुळिन्दैर्द्रविडान्ध्रकाश्यैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2149181, "chapter_id": 4228, "verse_number": "२४", "content_sanskrit": "नानाजनौघं युधि सम्प्रवृत्तं\nगाङ्गं यथा वेगमवारणीयम् ।\nमां च स्थितं नागबलस्य मध्ये\nयुयुत्ससे मन्द किमल्पबुद्धे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2149182, "chapter_id": 4228, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2149183, "chapter_id": 4228, "verse_number": "२५", "content_sanskrit": "इत्येवमुक्त्वा राजानं धर्मपुत्रं युधिष्ठिरम् ।\nअभ्यावृत्य पुनर्जिष्णुमुलूकः प्रत्यभाषत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2149184, "chapter_id": 4228, "verse_number": "२६", "content_sanskrit": "अकत्थमानो युध्यस्व कत्थसेऽर्जुन किं बहु ।\nपर्ययात् सिद्धिरेतस्य नैतत् सिद्ध्यति कत्थनात्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2149185, "chapter_id": 4228, "verse_number": "२७", "content_sanskrit": "यदीदं कत्थनाल्लोके सिद्ध्येत् कर्म धनञ्जय ।\nसर्वे भवेयुः सिद्धार्थाः कत्थने को हि दुर्गतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2149186, "chapter_id": 4228, "verse_number": "२८", "content_sanskrit": "जानामि ते वासुदेवं सहायं\nजानामि ते गाण्डिवं ताळमात्रम् ।\nजानाम्येतत् त्वादृशो नास्ति योद्धा\nराज्यं च ते जानमानो हरामि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2149187, "chapter_id": 4228, "verse_number": "२९", "content_sanskrit": "न तु पर्यायधर्मेण सिद्धिं प्राप्नोति भूयसीम् ।\nमनसैव हि भूतानि विधाता कुरुते वशे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2149188, "chapter_id": 4228, "verse_number": "३०", "content_sanskrit": "त्रयोदश समा भुक्तं राज्यं विलपतस्तव ।\nभूयश्चैव प्रशासिष्ये त्वां निहत्य सबान्धवम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2149189, "chapter_id": 4228, "verse_number": "३१", "content_sanskrit": "क्व तदा गाण्डिवं तेऽभूद् यत् त्वं दासपणैर्जितः ।\nक्व तदा भीमसेनस्य बलमासीच्च फल्गुन\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2149190, "chapter_id": 4228, "verse_number": "३२", "content_sanskrit": "सगदाद् भीमसेनाच्च पार्थाच्चापि सगाण्डिवात् ।\nन वै मोक्षस्तदा वोऽभूद् विना कृष्णामनिन्दिताम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2149191, "chapter_id": 4228, "verse_number": "३३", "content_sanskrit": "सा वो दास्ये समापन्नान् मोक्षयामास भामिनी ।\nअमानुष्यसमायुक्तान् दासकर्मण्यवस्थितान्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2149192, "chapter_id": 4228, "verse_number": "३४", "content_sanskrit": "अवोचं यत् षण्डतिलानहं वस्तथ्यमेव तत् ।\nधृता हि वेणी पार्थेन विराटनगरे तदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2149193, "chapter_id": 4228, "verse_number": "३५", "content_sanskrit": "सूदकर्मणि च श्रान्तं विराटस्य महानसे ।\nभीमसेनेन कौन्तेय यच्च तन्मम पौरुषम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2149194, "chapter_id": 4228, "verse_number": "३६", "content_sanskrit": "एवमेव सदा दण्डं क्षत्रियाः क्षत्रिये दधुः ।\nवेणीं कृत्वा षण्डवेषः कन्यां नर्तितवानसि\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2149195, "chapter_id": 4228, "verse_number": "३७", "content_sanskrit": "न भयाद् वासुदेवस्य न चापि तव फल्गुन ।\nराज्यं प्रति न दास्यामि युद्ध्यस्व सहकेशवः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2149196, "chapter_id": 4228, "verse_number": "३८", "content_sanskrit": "न माया हीन्द्रजालं वा कुहका वा विभीषणा ।\nआत्तशस्त्रस्य मे युद्धे भवन्ति प्रतिगर्जनाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2149197, "chapter_id": 4228, "verse_number": "३९", "content_sanskrit": "वासुदेवसहस्रं वा फल्गुनानां शतानि वा ।\nआसाद्य माममोघेषुं द्रविष्यन्ति दिशो दश\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2149198, "chapter_id": 4228, "verse_number": "४०", "content_sanskrit": "संयुगं गच्छ भीष्मेण भिन्धि वा शिरसा गिरिम् ।\nप्रतरेमं महागाधं बाहुभ्यां पुरुषोदधिम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2149199, "chapter_id": 4228, "verse_number": "४१", "content_sanskrit": "शारद्वतमहामीनं विविंशतिझषाकुलम् ।\nबृहद्बलमहावेलं सौमदत्तितिमिङ्गिलम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2149200, "chapter_id": 4228, "verse_number": "४२", "content_sanskrit": "दुःशासनौघं शलशल्यमत्स्यं\nसुषेणचित्रायुधनागनक्रम् ।\nजयद्रथाद्रिं पुरुमित्रगाधं\nदुर्मर्षणोदं शकुनिप्रपातम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2149201, "chapter_id": 4228, "verse_number": "४३", "content_sanskrit": "शस्त्रौघमक्षय्यमतिप्रवृद्धं\nयदाऽवगाह्य श्रमनष्टचेताः ।\nभविष्यसि त्वं हतसर्वबान्धवः\nतदा मनस्ते परितापमेष्यति\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2149202, "chapter_id": 4228, "verse_number": "४४", "content_sanskrit": "तदा मनस्ते त्रिदिवादिवाशुचेः\nनिवर्त्यतां पार्थ महीप्रशासनात् ।\nराज्यं प्रशास्तुं हि सुदुर्लभं त्वया\nबुभूषता स्वर्ग इवातपस्विना\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2149203, "chapter_id": 4228, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनषष्ट्युत्तरशततमोऽध्यायः ॥१५९॥\nउलूकदूतागमनपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]