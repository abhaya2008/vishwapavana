[{"id": 5000181000, "chapter_id": 9181, "verse_number": "२-१०४-१", "content_sanskrit": "तं तु राम: समाज्ञाय भ्रातरं गुरुवत्सलम् ।\nलक्ष्मणेन सह भ्रात्रा प्रष्टुं समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000181001, "chapter_id": 9181, "verse_number": "२-१०४-२", "content_sanskrit": "किमेतदिच्छेयमहं श्रोतुं प्रव्याहृतं त्वया ।\nयस्मात्त्वमागतो देशमिमं चीरजटाजिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000181002, "chapter_id": 9181, "verse_number": "२-१०४-३", "content_sanskrit": "किं निमित्तमिमं देशं कृष्णाजिनजटाधर: ।\nहित्वा राज्यं प्रविष्टस्त्वं तत्सर्वं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000181003, "chapter_id": 9181, "verse_number": "२-१०४-४", "content_sanskrit": "इत्युक्त: कैकयीपुत्र: काकुत्स्थेन महात्मना ।\nप्रगृह्य बलवद्भूय: प्राञ्जलिर्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000181004, "chapter_id": 9181, "verse_number": "२-१०४-५", "content_sanskrit": "आर्य्यं तात: परित्यज्य कृत्वा कर्म सुदुष्करम् ।\nगत: स्वर्गं महाबाहु: पुत्रशोकाभिपीडित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000181005, "chapter_id": 9181, "verse_number": "२-१०४-६", "content_sanskrit": "स्त्रिया नियुक्त: कैकेय्या मम मात्रा परन्तप ।\nचकार सुमहत्पापमिदमात्मयशोहरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000181006, "chapter_id": 9181, "verse_number": "२-१०४-७", "content_sanskrit": "सा राज्यफलमप्राप्य विधवा शोककर्शिता ।\nपतिष्यति महाघोरे निरये जननी मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000181007, "chapter_id": 9181, "verse_number": "२-१०४-८", "content_sanskrit": "तस्य मे दासभूतस्य प्रसादं कर्त्तुमर्हसि ।\nअभिषिञ्चस्व चाद्यैव राज्येनप मघवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000181008, "chapter_id": 9181, "verse_number": "२-१०४-९", "content_sanskrit": "इमा: प्रकृतय: सर्वा विधवा मातरश्च या: ।\nत्वत्सकाशमनुप्राप्ता: प्रसादं कर्त्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000181009, "chapter_id": 9181, "verse_number": "२-१०४-१०", "content_sanskrit": "तदानुपूर्व्या युक्तं च युक्तं चात्मनि मानद ।\nराज्यं प्राप्नुहि धर्मेण सकामान् सुहृद: कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000181010, "chapter_id": 9181, "verse_number": "२-१०४-११", "content_sanskrit": "भवत्वविधवा भूमि: समग्रा पतिना त्वया ।\nशशिना विमलेनेव शारदी रजनी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000181011, "chapter_id": 9181, "verse_number": "२-१०४-१२", "content_sanskrit": "एभिश्च सचिवै: सार्द्धं शिरसा याचितो मया ।\nभ्रातु: शिष्यस्य दासस्य प्रसादं कर्त्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000181012, "chapter_id": 9181, "verse_number": "२-१०४-१३", "content_sanskrit": "तदिदं शाश्वतं पित्र्यं सर्वं प्रकृतिमण्डलम् ।\nपूजितं पुरुषव्याघ्र नातिक्रमितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000181013, "chapter_id": 9181, "verse_number": "२-१०४-१४", "content_sanskrit": "एवमुक्त्वा महाबाहु: सबाष्प: कैकयीसुत: ।\nरामस्य शिरसा पादौ जग्राह विधिवत्पुन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000181014, "chapter_id": 9181, "verse_number": "२-१०४-१५", "content_sanskrit": "तं मत्तमिव मातङ्गं नि:श्वसन्तं पुन:पुन: ।\nभ्रातरं भरतं राम: परिष्वज्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000181015, "chapter_id": 9181, "verse_number": "२-१०४-१६", "content_sanskrit": "कुलीन: सत्त्वसम्पन्नस्तेजस्वी चरितव्रत: ।\nराज्यहेतो: कथं पापमाचरेत्त्वद्विधो जन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000181016, "chapter_id": 9181, "verse_number": "२-१०४-१७", "content_sanskrit": "न दोषं त्वयि पश्यामि सूक्ष्ममप्यरिसूदन ।\nन चापि जननीं बाल्यात्त्वं विगर्हितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000181017, "chapter_id": 9181, "verse_number": "२-१०४-१८", "content_sanskrit": "कामकारो महाप्राज्ञ गुरूणां सर्वदा ऽनघ ।\nउपपन्नेषु दारेषु पुत्रेषु च विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000181018, "chapter_id": 9181, "verse_number": "२-१०४-१९", "content_sanskrit": "वयमस्य यथा लोके सङ्ख्याता: सौम्य साधुभि: ।\nभार्य्या: पुत्राश्च शिष्याश्च त्वमनु ज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000181019, "chapter_id": 9181, "verse_number": "२-१०४-२०", "content_sanskrit": "वने वा चीरवसनं सौम्य कृष्णाजिनाम्बरम् ।\nराज्ये वापि महाराजो मां वासयितुमीश्वर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000181020, "chapter_id": 9181, "verse_number": "२-१०४-२१", "content_sanskrit": "यावत्पितरि धर्मज्ञे गौरवं लोकसत्कृतम् ।\nतावद्धर्मभृतां श्रेष्ठ जनन्यामपि गौरवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000181021, "chapter_id": 9181, "verse_number": "२-१०४-२२", "content_sanskrit": "एताभ्यां धर्मशीलाभ्यां वनं गच्छेति राघव ।\nमातापितृभ्यामुक्तो ऽहं कथमन्यत् समाचरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000181022, "chapter_id": 9181, "verse_number": "२-१०४-२३", "content_sanskrit": "त्वया राज्यमयोध्यायां प्राप्तव्यं लोकसत्कृतम् ।\nवस्तव्यं दण्डकारण्ये मया वल्कलवाससा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000181023, "chapter_id": 9181, "verse_number": "२-१०४-२४", "content_sanskrit": "एवं कृत्वा महाराजो विभागं लोकसन्निधौ ।\nव्यादिश्य च महातेजा दिवं दशरथो गत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000181024, "chapter_id": 9181, "verse_number": "२-१०४-२५", "content_sanskrit": "स च प्रमाणं धर्मात्मा राजा लोकगुरुस्तव ।\nपित्रा दत्तं यथाभागमुपभोक्तुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000181025, "chapter_id": 9181, "verse_number": "२-१०४-२६", "content_sanskrit": "चतुर्दशसमा: सौम्य दण्डकारण्यमाश्रित: ।\nउपभोक्ष्ये त्वहं दत्तं भागं पित्रा महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000181026, "chapter_id": 9181, "verse_number": "२-१०४-२७", "content_sanskrit": "यदब्रवीन्मां नरलोकसत्कृत: पिता महात्मा विबुधाधिपोपम: ।\nतदेव मन्ये परमात्मनो हितं न सर्वलोकेश्वरभावमप्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000181027, "chapter_id": 9181, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे चतुरधिकशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]