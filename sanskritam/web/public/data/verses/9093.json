[{"id": 5000093000, "chapter_id": 9093, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000093001, "chapter_id": 9093, "verse_number": "२-१६-१", "content_sanskrit": "स तदन्तःपुरद्वारं समतीत्य जनाकुलम्।\nप्रविविक्तां ततः कक्ष्यामाससाद पुराणवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000093002, "chapter_id": 9093, "verse_number": "२-१६-२", "content_sanskrit": "प्रासकार्मुकबिभ्रद्भिर्युवभिर्मृष्टकुण्डलैः।\nअप्रमादिभिरेकाग्रैः स्वानुरक्तैरधिष्ठिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000093003, "chapter_id": 9093, "verse_number": "२-१६-३", "content_sanskrit": "तत्र काषायिणो वृद्धान् वेत्रपाणीन् स्वलंकृतान्।\nददर्श विष्ठितान् द्वारि स्त्र्यध्यक्षान् समाहितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000093004, "chapter_id": 9093, "verse_number": "२-१६-४", "content_sanskrit": "ते समीक्ष्य समायान्तं रामप्रियचिकीर्षवः।\nसहसोत्पतिताः सर्वे ह्यासनेभ्यः ससम्भ्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000093005, "chapter_id": 9093, "verse_number": "२-१६-५", "content_sanskrit": "तानुवाच विनीतात्मा सूतपुत्रः प्रदक्षिणः।\nक्षिप्रमाख्यात रामाय सुमन्त्रो द्वारि तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000093006, "chapter_id": 9093, "verse_number": "२-१६-६", "content_sanskrit": "ते राममुपसङ्गम्य भर्तुः प्रियचिकीर्षवः।\nसहभार्याय रामाय क्षिप्रमेवाचचक्षिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000093007, "chapter_id": 9093, "verse_number": "२-१६-७", "content_sanskrit": "प्रतिवेदितमाज्ञाय सूतमभ्यन्तरं पितुः।\nतत्रैवानाययामास राघवः प्रियकाम्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000093008, "chapter_id": 9093, "verse_number": "२-१६-८", "content_sanskrit": "तं वैश्रवणसंकाशमुपविष्टं स्वलंकृतम्।\nददर्श सूतः पर्यङ्के सौवर्णे सोत्तरच्छदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000093009, "chapter_id": 9093, "verse_number": "२-१६-९", "content_sanskrit": "वराहरुधिराभेण शुचिना च सुगन्धिना।\nअनुलिप्तं परार्घ्येन चन्दनेन परंतपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000093010, "chapter_id": 9093, "verse_number": "२-१६-१०", "content_sanskrit": "स्थितया पार्श्वतश्चापि वालव्यजनहस्तया।\nउपेतं सीतया भूयश्चित्रया शशिनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000093011, "chapter_id": 9093, "verse_number": "२-१६-११", "content_sanskrit": "तं तपन्तमिवादित्यमुपपन्नं स्वतेजसा।\nववन्दे वरदं वन्दी विनयज्ञो विनीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000093012, "chapter_id": 9093, "verse_number": "२-१६-१२", "content_sanskrit": "प्राञ्जलिः सुमुखं दृष्ट्वा विहारशयनासने।\nराजपुत्रमुवाचेदं सुमन्त्रो राजसत्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000093013, "chapter_id": 9093, "verse_number": "२-१६-१३", "content_sanskrit": "कौसल्या सुप्रजा राम पिता त्वां द्रष्टुमिच्छति।\nमहिष्यापि हि कैकेय्या गम्यतां तत्र मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000093014, "chapter_id": 9093, "verse_number": "२-१६-१४", "content_sanskrit": "एवमुक्तस्तु संहृष्टो नरसिंहो महाद्युतिः।\nततः सम्मानयामास सीतामिदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000093015, "chapter_id": 9093, "verse_number": "२-१६-१५", "content_sanskrit": "देवि देवश्च देवी च समागम्य मदन्तरे।\nमन्त्रयेते ध्रुवं किंचिदभिषेचनसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000093016, "chapter_id": 9093, "verse_number": "२-१६-१६", "content_sanskrit": "लक्षयित्वा ह्यभिप्रायं प्रियकामा सुदक्षिणा।\nसंचोदयति राजानं मदर्थमसितेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000093017, "chapter_id": 9093, "verse_number": "२-१६-१७", "content_sanskrit": "सा प्रहृष्टा महाराजं हितकामानुवर्तिनी।\nजननी चार्थकामा मे केकयाधिपतेः सुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000093018, "chapter_id": 9093, "verse_number": "२-१६-१८", "content_sanskrit": "दिष्ट्या खलु महाराजो महिष्या प्रियया सह।\nसुमन्त्रं प्राहिणोद् दूतमर्थकामकरं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000093019, "chapter_id": 9093, "verse_number": "२-१६-१९", "content_sanskrit": "यादृशी परिषत् तत्र तादृशो दूत आगतः।\nध्रुवमद्यैव मां राजा यौवराज्येऽभिषेक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000093020, "chapter_id": 9093, "verse_number": "२-१६-२०", "content_sanskrit": "हन्त शीघ्रमितो गत्वा द्रक्ष्यामि च महीपतिम्।\nसह त्वं परिवारेण सुखमास्स्व रमस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000093021, "chapter_id": 9093, "verse_number": "२-१६-२१", "content_sanskrit": "पतिसम्मानिता सीता भर्तारमसितेक्षणा।\nआ द्वारमनुवव्राज मङ्गलान्यभिदध्युषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000093022, "chapter_id": 9093, "verse_number": "२-१६-२२", "content_sanskrit": "राज्यं द्विजातिभिर्जुष्टं राजसूयाभिषेचनम्।\nकर्तुमर्हति ते राजा वासवस्येव लोककृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000093023, "chapter_id": 9093, "verse_number": "२-१६-२३", "content_sanskrit": "दीक्षितं व्रतसम्पन्नं वराजिनधरं शुचिम्।\nकुरङ्गशृङ्गपाणिं च पश्यन्ती त्वां भजाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000093024, "chapter_id": 9093, "verse_number": "२-१६-२४", "content_sanskrit": "पूर्वां दिशं वज्रधरो दक्षिणां पातु ते यमः।\nवरुणः पश्चिमामाशां धनेशस्तूत्तरां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000093025, "chapter_id": 9093, "verse_number": "२-१६-२५", "content_sanskrit": "अथ सीतामनुज्ञाप्य कृतकौतुकमङ्गलः।\nनिश्चक्राम सुमन्त्रेण सह रामो निवेशनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000093026, "chapter_id": 9093, "verse_number": "२-१६-२६", "content_sanskrit": "पर्वतादिव निष्क्रम्य सिंहो गिरिगुहाशयः।\nलक्ष्मणं द्वारि सोऽपश्यत् प्रह्वाञ्जलिपुटं स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000093027, "chapter_id": 9093, "verse_number": "२-१६-२७", "content_sanskrit": "अथ मध्यमकक्ष्यायां समागच्छत् सुहृज्जनैः।\nस सर्वानर्थिनो दृष्ट्वा समेत्य प्रतिनन्द्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000093028, "chapter_id": 9093, "verse_number": "२-१६-२८", "content_sanskrit": "ततः पावकसंकाशमारुरोह रथोत्तमम्।\nवैयाघ्रं पुरुषव्याघ्रो राजितं राजनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000093029, "chapter_id": 9093, "verse_number": "२-१६-२९", "content_sanskrit": "मेघनादमसम्बाधं मणिहेमविभूषितम्।\nमुष्णन्तमिव चक्षूंषि प्रभया मेरुवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000093030, "chapter_id": 9093, "verse_number": "२-१६-३०", "content_sanskrit": "करेणुशिशुकल्पैश्च युक्तं परमवाजिभिः।\nहरियुक्तं सहस्राक्षो रथमिन्द्र इवाशुगम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000093031, "chapter_id": 9093, "verse_number": "२-१६-३१", "content_sanskrit": "प्रययौ तूर्णमास्थाय राघवो ज्वलितः श्रिया।\nस पर्जन्य इवाकाशे स्वनवानभिनादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000093032, "chapter_id": 9093, "verse_number": "२-१६-३२", "content_sanskrit": "निकेतान्निर्ययौ श्रीमान् महाभ्रादिव चन्द्रमाः।\nचित्रचामरपाणिस्तु लक्ष्मणो राघवानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000093033, "chapter_id": 9093, "verse_number": "२-१६-३३", "content_sanskrit": "जुगोप भ्रातरं भ्राता रथमास्थाय पृष्ठतः।\nततो हलहलाशब्दस्तुमुलः समजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000093034, "chapter_id": 9093, "verse_number": "२-१६-३४", "content_sanskrit": "तस्य निष्क्रममाणस्य जनौघस्य समन्ततः।\nततो हयवरा मुख्या नागाश्च गिरिसंनिभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000093035, "chapter_id": 9093, "verse_number": "२-१६-३५", "content_sanskrit": "अनुजग्मुस्तथा रामं शतशोऽथ सहस्रशः।\nअग्रतश्चास्य संनद्धाश्चन्दनागुरुभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000093036, "chapter_id": 9093, "verse_number": "२-१६-३६", "content_sanskrit": "खड्गचापधराः शूरा जग्मुराशंसवो जनाः।\nततो वादित्रशब्दाश्च स्तुतिशब्दाश्च वन्दिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000093037, "chapter_id": 9093, "verse_number": "२-१६-३७", "content_sanskrit": "सिंहनादाश्च शूराणां ततः शुश्रुविरे पथि।\nहर्म्यवातायनस्थाभिर्भूषिताभिः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000093038, "chapter_id": 9093, "verse_number": "२-१६-३८", "content_sanskrit": "कीर्यमाणः सुपुष्पौघैर्ययौ स्त्रीभिररिंदमः।\nरामं सर्वानवद्याङ्‍ग्यो रामपिप्रीषया ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000093039, "chapter_id": 9093, "verse_number": "२-१६-३९", "content_sanskrit": "वचोभिरग्र्यैर्हर्म्यस्थाः क्षितिस्थाश्च ववन्दिरे।\nनूनं नन्दति ते माता कौसल्या मातृनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000093040, "chapter_id": 9093, "verse_number": "२-१६-४०", "content_sanskrit": "पश्यन्ती सिद्धयात्रं त्वां पित्र्यं राज्यमुपस्थितम्।\nसर्वसीमन्तिनीभ्यश्च सीतां सीमन्तिनीं वराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000093041, "chapter_id": 9093, "verse_number": "२-१६-४१", "content_sanskrit": "अमन्यन्त हि ता नार्यो रामस्य हृदयप्रियाम्।\nतया सुचरितं देव्या पुरा नूनं महत् तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000093042, "chapter_id": 9093, "verse_number": "२-१६-४२", "content_sanskrit": "रोहिणीव शशाङ्केन रामसंयोगमाप या।\nइति प्रासादशृङ्गेषु प्रमदाभिर्नरोत्तमः।\nशुश्राव राजमार्गस्थः प्रिया वाच उदाहृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000093043, "chapter_id": 9093, "verse_number": "२-१६-४३", "content_sanskrit": "स राघवस्तत्र तदा प्रलापान्\nशुश्राव लोकस्य समागतस्य।\nआत्माधिकारा विविधाश्च वाचः\nप्रहृष्टरूपस्य पुरे जनस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000093044, "chapter_id": 9093, "verse_number": "२-१६-४४", "content_sanskrit": "एष श्रियं गच्छति राघवोऽद्य\nराजप्रसादाद् विपुलां गमिष्यन्।\nएते वयं सर्वसमृद्धकामा\nयेषामयं नो भविता प्रशास्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000093045, "chapter_id": 9093, "verse_number": "२-१६-४५", "content_sanskrit": "लाभो जनस्यास्य यदेष सर्वं\nप्रपत्स्यते राष्ट्रमिदं चिराय।\nन ह्यप्रियं किंचन जातु कश्चित्\nपश्येन्न दुःखं मनुजाधिपेऽस्मिन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000093046, "chapter_id": 9093, "verse_number": "२-१६-४६", "content_sanskrit": "स घोषवद्भिश्च हयैः सनागैः\nपुरःसरैः स्वस्तिकसूतमागधैः।\nमहीयमानः प्रवरैश्च वादकै-\nरभिष्टुतो वैश्रवणो यथा ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000093047, "chapter_id": 9093, "verse_number": "२-१६-४७", "content_sanskrit": "करेणुमातङ्गरथाश्वसंकुलं\nमहाजनौघैः परिपूर्णचत्वरम्।\nप्रभूतरत्नं बहुपण्यसंचयं\nददर्श रामो विमलं महापथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000093048, "chapter_id": 9093, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे षोडशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]