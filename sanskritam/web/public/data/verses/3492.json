[{"id": 2115805, "chapter_id": 3492, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115806, "chapter_id": 3492, "verse_number": "१", "content_sanskrit": "एतत् श्रुत्वा वचः सर्वे कौन्तेया संशितव्रताः ।\nमनसा द्रौपदीं जग्मुरनङ्गशरपीडिताः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115807, "chapter_id": 3492, "verse_number": "२", "content_sanskrit": "ऊषुस्तां रजनीं राजन् शल्यविद्धा इवाभवन् ।\nव्युष्टायां दुर्मतीभूत्वा अस्वस्थमनसोऽभवन् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115808, "chapter_id": 3492, "verse_number": "३", "content_sanskrit": "ततः कुन्ती सुतान् दृष्ट्वा सर्वान् तान् हतचेतसः ।\nयुधिष्ठिरमुवाचेदं वचनं सत्यभाषिणी \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115809, "chapter_id": 3492, "verse_number": "४", "content_sanskrit": "चिररात्रोषिताः स्मेह ब्राह्मणस्य निवेशने ।\nरममाणाः पुरे रम्ये लब्धभैक्षा युधिष्ठिर \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115810, "chapter_id": 3492, "verse_number": "५", "content_sanskrit": "यानीह रमणीयानि वनान्युपवनानि च ।\nसर्वाणि तानि दृष्टानि पुनःपुनररिन्दम \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115811, "chapter_id": 3492, "verse_number": "६", "content_sanskrit": "पुनर्दृष्टानि तान्येव तथा न प्रीणयन्ति नः ।\nभैक्षं च न तथा वीर लभ्यते कुरुनन्दन \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115812, "chapter_id": 3492, "verse_number": "७", "content_sanskrit": "ते वयं साधु पाञ्चालान् गच्छाम यदि मन्यसे ।\nअपूर्वदर्शनं तात रमणीयं भविष्यति \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115813, "chapter_id": 3492, "verse_number": "८", "content_sanskrit": "सुभिक्षश्चैव पाञ्चालाः श्रूयन्ते शत्रुकर्शन ।\nयज्ञसेनस्तु राजाऽसौ ब्रह्मण्य इति शुश्रुम \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115814, "chapter_id": 3492, "verse_number": "९", "content_sanskrit": "एकत्र चिरवासोऽयं क्षमो न च मतो मम ।\nतस्मात् तत्रैव गच्छामो वयं तु यदि मन्यसे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115815, "chapter_id": 3492, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115816, "chapter_id": 3492, "verse_number": "१०", "content_sanskrit": "भवत्या यन्मतं कार्यं त्विहास्माकं परं हितम् ।\nअनुजांस्तु न जानामि गच्छेयुर्नेति वा पुनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115817, "chapter_id": 3492, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115818, "chapter_id": 3492, "verse_number": "११", "content_sanskrit": "ततः कुन्ती भीमसेनमर्जुनं च यमौ तथा ।\nउवाच गमनं ते च तां तथेत्यब्रुवंस्तदा \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115819, "chapter_id": 3492, "verse_number": "१२", "content_sanskrit": "तत आमन्त्र्य तं विप्रं कुन्ती राजसुतैः सह ।\nप्रतस्थे नगरं रम्यं द्रुपदस्य महात्मनः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115820, "chapter_id": 3492, "verse_number": "१३", "content_sanskrit": "वसत्सु तेषु प्रच्छन्नं पाण्डवेषु महात्मसु ।\nआजगाम तदा द्रष्टुं व्यासः सत्यवतीसुतः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115821, "chapter_id": 3492, "verse_number": "१४", "content_sanskrit": "तमागतमभिप्रेक्ष्य प्रत्युद्गम्य परन्तपाः ।\nप्रणिपत्याभिवाद्यैनं तस्थुः प्राञ्जलयोऽग्रतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115822, "chapter_id": 3492, "verse_number": "१५", "content_sanskrit": "समनुज्ञाय तान् सर्वानासीनान् मुनिरब्रवीत् ।\nप्रसन्नः पूजितः पार्थैः प्रीतिपूर्वमिदं वचः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115823, "chapter_id": 3492, "verse_number": "१६", "content_sanskrit": "अपि धर्मेण वर्तध्वं शास्त्रेणैव परन्तपाः ।\nअपि विप्रेषु वः पूजा पूजार्हेषु यथाविधि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115824, "chapter_id": 3492, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115825, "chapter_id": 3492, "verse_number": "१७", "content_sanskrit": "अथ धर्मार्थवद् वाक्यमुक्त्वा स भगवानृषिः ।\nविचित्रार्थकथास्तास्ताः पुनरेवेदमब्रवीत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115826, "chapter_id": 3492, "verse_number": "१८", "content_sanskrit": "आसीत् तपोनिधेः काचिद् ऋषेः कन्या मनस्विनी ।\nविलग्नमध्या सुश्रोणी सुभ्रूः सर्वगुणान्विता \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115827, "chapter_id": 3492, "verse_number": "१९", "content_sanskrit": "कर्मभिः स्वकृतैः सा तु दुर्भगा समपद्यत ।\nनाध्यगच्छत् पतिं सा तु कन्या रूपवती सती \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115828, "chapter_id": 3492, "verse_number": "२०", "content_sanskrit": "तपस्तप्तुमथारेभे पत्यर्थमसुखं ततः ।\nतोषयामास महता भगवन्तं महेश्वरम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115829, "chapter_id": 3492, "verse_number": "२१", "content_sanskrit": "तस्यास्तु भगवांस्तुष्टः तामुवाच तपस्विनीम् ।\nवरं वरय भद्रे त्वं वरदोऽस्मि तवेप्सितम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115830, "chapter_id": 3492, "verse_number": "२२", "content_sanskrit": "अथेश्वरमुवाचेदमात्मजेनाभिचोदिता ।\nपतिं सर्वगुणोपेतमिच्छामीति पुनःपुनः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115831, "chapter_id": 3492, "verse_number": "२३", "content_sanskrit": "तामथ प्रत्युवाचेदमीशानो वदतां वरः ।\nपञ्च ते पतयो भद्रे भविष्यन्तीति शङ्करः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115832, "chapter_id": 3492, "verse_number": "२४", "content_sanskrit": "प्रतिब्रुवाणामेकं मे पतिं देहीति शङ्करम् ।\nपुनरेवाब्रवीदेनामिदं वचनमुत्तमम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115833, "chapter_id": 3492, "verse_number": "२५", "content_sanskrit": "पञ्चकृत्वस्त्वयाप्युक्तः पतिं देहीत्यहं पुनः ।\nदेहमन्यं गतायास्ते यथोक्तं वै भविष्यति \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115834, "chapter_id": 3492, "verse_number": "२६", "content_sanskrit": "द्रुपदस्य कुले जाता कन्या सा वरवर्णिनी ।\nनिर्दिष्टा भवतां कन्या कृष्णा पार्षत्यनिन्दिता \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115835, "chapter_id": 3492, "verse_number": "२७", "content_sanskrit": "पाञ्चालनगरीं तस्मात् प्रविशध्वं महाबलाः ।\nदुःखिनस्तामनुप्राप्य भविष्यथ न संशयः ।\nराज्यं चैवागतं प्राप्ता इन्द्रप्रस्थं गमिष्यथ \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115836, "chapter_id": 3492, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115837, "chapter_id": 3492, "verse_number": "२८", "content_sanskrit": "एवमुक्त्वा महाभागः पाण्डवानां पितामहः ।\nपार्थानामन्त्र्य कुन्तीं च प्रातिष्ठत महातपाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]