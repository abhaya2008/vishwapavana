[{"id": 2107897, "chapter_id": 3330, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2107898, "chapter_id": 3330, "verse_number": "१", "content_sanskrit": "तेषु तत्रोपविष्टेषु ब्राह्मणेषु समन्ततः ।\nरुरुश्चुक्रोश गहनं वनं गत्वा सुदुःखितः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2107899, "chapter_id": 3330, "verse_number": "२", "content_sanskrit": "शोकेनाभिहतः सोऽथ विलपन् करुणं स्वयम् ।\nअब्रवीद् वचनं शोचन् प्रियां चिन्त्य प्रमद्वराम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2107900, "chapter_id": 3330, "verse_number": "३", "content_sanskrit": "शेते सा भुवि तन्वङ्गी मम शोकविवर्धिनी ।\nबान्धवानां च सर्वेषां किं नु दुःखमतः परम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2107901, "chapter_id": 3330, "verse_number": "४", "content_sanskrit": "यदि दत्तं तपस्तप्तं गुरवो वा मया यदि ।\nसम्यगाराधितास्तेन सा जीवतु मम प्रिया \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2107902, "chapter_id": 3330, "verse_number": "५", "content_sanskrit": "यथा च जन्मप्रभृति यतात्माऽहं धृतव्रतः ।\nप्रमद्वरा तथाद्यासावुत्तिष्ठतु मम प्रिया \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2107903, "chapter_id": 3330, "verse_number": "६", "content_sanskrit": "एवं विलपतस्तस्य ऋषिपुत्रस्य वै तदा ।\nदेवदूतस्तदाऽभ्येत्य वाक्यमाह रुरुं वने \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2107904, "chapter_id": 3330, "verse_number": "", "content_sanskrit": "देवदूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2107905, "chapter_id": 3330, "verse_number": "७", "content_sanskrit": "अभिधत्से ह यद्वाचा रुरो दुःखेन तन्मृषा ।\nन तु मर्त्यस्य धर्मात्मन्नायुरस्ति गतायुषः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2107906, "chapter_id": 3330, "verse_number": "८", "content_sanskrit": "गतासुरेषा कृपणा गन्धर्वाप्सरसोः सुता ।\nतस्माच्छोके मनस्तात मा कृथास्त्वं कथञ्चन\t ॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2107907, "chapter_id": 3330, "verse_number": "९", "content_sanskrit": "उपायश्चात्र विहितः पूर्वं देवैर्महात्मभिः ।\nतं यदीच्छसि कर्तुं त्वं लप्स्यसीमां प्रमद्वराम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2107908, "chapter_id": 3330, "verse_number": "", "content_sanskrit": "रुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2107909, "chapter_id": 3330, "verse_number": "१०", "content_sanskrit": "क उपायः कृतो देवैर्ब्रूहि तत्त्वेन खेचर ।\nकरिष्येऽहं तथा श्रुत्वा त्रातुमर्हति मां भवान्\t ॥ १०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2107910, "chapter_id": 3330, "verse_number": "", "content_sanskrit": "देवदूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2107911, "chapter_id": 3330, "verse_number": "११", "content_sanskrit": "आयुषोऽर्धं प्रयच्छस्व कन्यायै भृगुनन्दन ।\nएवमुत्थास्यति रुरो तव भार्या प्रमद्वरा \t॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2107912, "chapter_id": 3330, "verse_number": "", "content_sanskrit": "रुरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2107913, "chapter_id": 3330, "verse_number": "१२", "content_sanskrit": "आयुषोऽर्धं प्रयच्छामि कन्यायै खेचरोत्तम ।\nशृङ्गाररूपाभरणा चोत्तिष्ठतु मम प्रिया \t॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2107914, "chapter_id": 3330, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2107915, "chapter_id": 3330, "verse_number": "१३", "content_sanskrit": "ततो गन्धर्वराजश्च देवदूतश्च सत्तम ।\nधर्मराजमुपेत्येदं वचनं प्रत्यभाषताम्\t ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2107916, "chapter_id": 3330, "verse_number": "१४", "content_sanskrit": "धर्मराजायुषोऽर्धेन रुरोर्भार्या प्रमद्वरा ।\nसमुत्तिष्ठतु कल्याणी मृतैव यदि मन्यसे \t॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2107917, "chapter_id": 3330, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2107918, "chapter_id": 3330, "verse_number": "१५", "content_sanskrit": "प्रमद्वरा रुरोर्भार्या देवदूत यदीच्छसि ।\nउत्तिष्ठत्वायुषोऽर्धेन रुरोरेव समन्विता \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2107919, "chapter_id": 3330, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2107920, "chapter_id": 3330, "verse_number": "१६", "content_sanskrit": "एवमुक्ते ततः कन्या सोदतिष्ठत् प्रमद्वरा ।\nरुरोस्तस्यायुषोऽर्धेन सुप्तेव वरवर्णिनी \t॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2107921, "chapter_id": 3330, "verse_number": "१७", "content_sanskrit": "एतद्दृष्टं हि तद्वीर्यं रुरोरुत्तमतेजसः ।\nआयुषोऽतिप्रवृद्धस्य भार्यार्थेर्ऽधं प्रदास्यतः\t ॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2107922, "chapter_id": 3330, "verse_number": "१८", "content_sanskrit": "तमुद्दिष्टेऽहनि तयोः पितरौ चक्रतुर्मुदा ।\nविवाहं तौ च रेमाते परस्परहितैषिणौ\t ॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2107923, "chapter_id": 3330, "verse_number": "१९", "content_sanskrit": "स लब्ध्वा दुर्लभां भार्यां पद्मकिञ्जल्कसप्रभाम् ।\nव्रतं चक्रे विनाशाय जिह्मगानां महाव्रतः\t ॥ १९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2107924, "chapter_id": 3330, "verse_number": "२०", "content_sanskrit": "स दृष्ट्वा जिह्मगान् सर्वांस्तीक्ष्णकोपसमन्वितः ।\nअभिहन्ति यदासन्नं गृह्य प्रहरणं तदा\t ॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2107925, "chapter_id": 3330, "verse_number": "२१", "content_sanskrit": "स कदाचिद्वनं विप्रो रुरुरभ्यागमद् गृहात् ।\nशयानं तत्र चापश्यड्डुण्डुभं वयसाऽन्वितम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2107926, "chapter_id": 3330, "verse_number": "२२", "content_sanskrit": "तत उद्यम्य दण्डं स कालदण्डोपमं तदा ।\nअत्यन्तं रुषितो विप्रस्तमुवाचाथ डुण्डुभः\t ॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2107927, "chapter_id": 3330, "verse_number": "२३", "content_sanskrit": "नापराध्यामि ते किञ्चिदहमद्य तपोधन ।\nसंरम्भोऽत्र किमर्थं वै मामभिहंसि रुषान्वितः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2107928, "chapter_id": 3330, "verse_number": "९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2107929, "chapter_id": 3330, "verse_number": "६", "content_sanskrit": "॥ पौलोमपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]