[{"id": 50007912, "chapter_id": 11390, "verse_number": "1", "content_sanskrit": "उद्धव उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50007913, "chapter_id": 11390, "verse_number": "2", "content_sanskrit": "अथ ते तदनुज्ञाता भुक्त्वा पीत्वा च वारुणीम्। तया विभ्रंशितज्ञाना दुरुक्तैर्मर्म पस्पृशुः॥ ३/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50007914, "chapter_id": 11390, "verse_number": "3", "content_sanskrit": "तेषां मैरेयदोषेण विषमीकृतचेतसाम्। निम्लोचति रवावासीद् वेणूनामिव मर्दनम्॥ ३/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50007915, "chapter_id": 11390, "verse_number": "4", "content_sanskrit": "भगवानात्ममायाया गतिं तामवलोक्य सः। सरस्वतीमुपस्पृश्य वृक्षमूल उपाविशत्॥ ३/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50007916, "chapter_id": 11390, "verse_number": "5", "content_sanskrit": "अहं चोक्तो भगवता प्रपन्नार्तिहरेण ह। बदरीं त्वं प्रयाहीति स्वकुलं सञ्जिहीर्षुणा॥ ३/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50007917, "chapter_id": 11390, "verse_number": "6", "content_sanskrit": "अथापि तदभिप्रेतं जानन्नहमरिन्दम। पृष्ठतोऽन्वगमं भर्तुः पादविश्लेषणाक्षमः॥ ३/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50007918, "chapter_id": 11390, "verse_number": "7", "content_sanskrit": "अद्राक्षमेकमासीनं विचिन्वन् दयितं पतिम्। श्रीनिकेतं सरस्वत्यां कृतकेतमकेतनम्॥ ३/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50007919, "chapter_id": 11390, "verse_number": "8", "content_sanskrit": "श्यामावदातं विरजं प्रशान्तारुणलोचनम्। दोर्भिश्चतुर्भिर्विदितं पीतकौशाम्बरेण च॥ ३/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50007920, "chapter_id": 11390, "verse_number": "9", "content_sanskrit": "वाम ऊरावधिश्रित्य दक्षिणाङ्घ्रिसरोरुहम्। अपाश्रितार्भकावस्थमकृशं त्यक्तपिप्पलम्॥ ३/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50007921, "chapter_id": 11390, "verse_number": "10", "content_sanskrit": "तस्मिन् महाभागवतो द्वैपायनसुहृत् सखा। लोकाननुचरन् सिद्ध आससाद यदृच्छया॥ ३/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50007922, "chapter_id": 11390, "verse_number": "11", "content_sanskrit": "तस्यानुरक्तस्य मुनेर्मुकुन्दः प्रमोदभारानतकन्धरस्य। आशृण्वतो मामनुरागहाससमीक्षया विश्रमयन्नुवाच॥ ३/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50007923, "chapter_id": 11390, "verse_number": "12", "content_sanskrit": "श्रीभगवानुवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50007924, "chapter_id": 11390, "verse_number": "13", "content_sanskrit": "वेदाहमन्तर्मनसीप्सितं ते ददानि यत् तद् दुरवापमन्यैः। सत्रे पुरा विश्वसृजां मुनीनां मत्सिद्धिकामेन वसो त्वयेष्टः॥ ३/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50007925, "chapter_id": 11390, "verse_number": "14", "content_sanskrit": "स एष साधो चरमो भवानामासादितस्ते मदनुग्रहोऽयम्। यन्मां नृलोकं रह उत्सृजन्तं दिष्ट्या ददृश्वान् विशदानुवृत्त्या॥ ३/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50007926, "chapter_id": 11390, "verse_number": "15", "content_sanskrit": "पुरा मया प्रोक्तमजाय नाभ्ये पद्मे निषण्णाय ममादिसर्गे। ज्ञानं परं मन्महिमावभासं यत् सूरयो भागवतं वदन्ति॥ ३/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50007927, "chapter_id": 11390, "verse_number": "16", "content_sanskrit": "इत्यादरोक्तः परमस्य पुंसः प्रतीक्षणानुग्रहभाजनोऽहम्। स्नेहोत्थरोमा स्खलिताक्षरस्तं मुञ्चन् शुचः प्राञ्जलिराबभाषे॥ ३/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50007928, "chapter_id": 11390, "verse_number": "17", "content_sanskrit": "को न्वीश ते पादसरोजभाजां सुदुर्लभोऽर्थेषु चतुर्ष्वपीह। तथाऽपि नाहं प्रवृणोमि भूमन् भवत्पदाम्भोजनिषेवणोत्सुकः॥ ३/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50007929, "chapter_id": 11390, "verse_number": "18", "content_sanskrit": "कर्माण्यनीहस्य भवोऽभवस्य ते दुर्गाश्रयोऽथारिभयात् पलायनम्। कालात्मनो यत् प्रमदायुताश्रयः स्वात्मन् रतेः खिद्यति धीर्विदामपि॥ ३/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50007930, "chapter_id": 11390, "verse_number": "19", "content_sanskrit": "मन्त्रेषु मां वा उपहूय यत् त्वमकुण्ठिताखण्डसदात्मबोधः। पृच्छेः प्रभो मुग्धवदप्रमत्तस्तन्नो मनो मोहयतीव देव॥ ३/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50007931, "chapter_id": 11390, "verse_number": "20", "content_sanskrit": "ज्ञानं परं स्वात्मरहःप्रकाशं प्रोवाच कस्मै भगवान् समग्रम्। अपि क्षमं नो ग्रहणाय भर्तर्वेदाञ्जसा यद् व्रजिनं तरेम॥ ३/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50007932, "chapter_id": 11390, "verse_number": "21", "content_sanskrit": "इत्यावेदितहार्दाय मह्यं स भगवान् परः। आदिदेशारविन्दाक्ष आत्मनः परमां स्थितिम्॥ ३/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50007933, "chapter_id": 11390, "verse_number": "22", "content_sanskrit": "स एवमाराधितपादतीर्थादधीततत्त्वात्मविबोधमार्गः। प्रणम्य पादौ परिवृत्य देवमिहागतोऽहं विरहातुरात्मा॥ ३/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50007934, "chapter_id": 11390, "verse_number": "23", "content_sanskrit": "सोऽहं त्वद्दर्शनाह्लादवियोगार्तियुतः प्रभो। गमिष्ये दयितं तस्य बदर्याश्रममण्डलम्॥ ३/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50007935, "chapter_id": 11390, "verse_number": "24", "content_sanskrit": "यत्र नारायणो देवो नरश्च भगवान् ऋषिः। मृदु तीव्रं तपो दीर्घं तेपाते लोकभावनौ॥ ३/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50007936, "chapter_id": 11390, "verse_number": "25", "content_sanskrit": "श्रीशुक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50007937, "chapter_id": 11390, "verse_number": "26", "content_sanskrit": "इत्युद्धवादुपाकर्ण्य सुहृदां दुःसहं वधम्। ज्ञानेनाशमयत् क्षत्ता शोकमुत्पतितं बुधः॥ ३/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50007938, "chapter_id": 11390, "verse_number": "27", "content_sanskrit": "स तं महाभागवतं व्रजन्तं कौरवर्षभ। विस्रम्भादभ्यधत्तेदं मुख्यं कृष्णपरिग्रहे॥ ३/४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50007939, "chapter_id": 11390, "verse_number": "28", "content_sanskrit": "विदुर उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50007940, "chapter_id": 11390, "verse_number": "29", "content_sanskrit": "ज्ञानं परं स्वात्मरहःप्रकाशं यदाह योगेश्वर ईश्वरस्ते। वक्तुं भवान् नोऽर्हति यद्धि विष्णोर्भृत्याः स्वभृत्यार्थकृतश्चरन्ति॥ ३/४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50007941, "chapter_id": 11390, "verse_number": "30", "content_sanskrit": "उद्धव उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50007942, "chapter_id": 11390, "verse_number": "31", "content_sanskrit": "ननु ते तत्त्वसंराद्ध ऋषिः कौषारवोऽन्ति मे। साक्षाद् भगवताऽऽदिष्टो मर्त्यलोकं जिहासता॥ ३/४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50007943, "chapter_id": 11390, "verse_number": "32", "content_sanskrit": "सूत उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50007944, "chapter_id": 11390, "verse_number": "33", "content_sanskrit": "इति सह विदुरेण विश्वमूर्तेर्गुणकथया सुधया प्लुतोरुतापः। क्षणमिव पुळिने यमस्वसुस्तां समुषित औपगविर्निशां ततोऽगात्॥ ३/४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50007945, "chapter_id": 11390, "verse_number": "34", "content_sanskrit": "राजोवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50007946, "chapter_id": 11390, "verse_number": "35", "content_sanskrit": "निधनमुपगतेषु वृष्णिभोजेष्वधिरथयूथपयूथपेषु मुख्यः। स तु कथमवशिष्ट उद्धवो यद्धरिरपि तत्यज आकृतिं त्र्यधीशः॥ ३/४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50007947, "chapter_id": 11390, "verse_number": "36", "content_sanskrit": "श्रीशुक उवाच-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50007948, "chapter_id": 11390, "verse_number": "37", "content_sanskrit": "ब्रह्मशापापदेशेन कालेनामोघवाञ्छितः। संहृत्य स्वकुलं स्फातं१ त्यक्ष्यन् देहमचिन्तयत्॥ ३/४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50007949, "chapter_id": 11390, "verse_number": "38", "content_sanskrit": "अस्माल्लोकादुपरते मयि ज्ञानं मदाश्रयम्। अर्हत्युद्धव एवाद्धा सम्प्रत्यात्मवतां परः॥ ३/४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50007950, "chapter_id": 11390, "verse_number": "39", "content_sanskrit": "नोद्धवोऽण्वपि मन्न्यूनो यद्गुणैर्निर्जितः प्रभुः। अतो मद्वत् पुनर्लोकं ग्राहयन्निह तिष्ठतु॥ ३/४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50007951, "chapter_id": 11390, "verse_number": "40", "content_sanskrit": "एवं त्रिलोकगुरुणा सन्दिष्टः शब्दयोनिना। बदर्याश्रममासाद्य हरिमीजे समाधिना॥ ३/४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50007952, "chapter_id": 11390, "verse_number": "41", "content_sanskrit": "विदुरोऽप्युद्धवाच्छ्रुत्वा कृष्णस्य परमात्मनः। क्रीडयोपात्तदेहस्य कर्माणि श्लाघितानि च॥ ३/४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50007953, "chapter_id": 11390, "verse_number": "42", "content_sanskrit": "देहन्यासं च तस्यैवं धीराणां धैर्यवर्धनम्। अन्येषां दुष्करतरं पशूनां विक्ल्बात्मनाम्॥ ३/४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50007954, "chapter_id": 11390, "verse_number": "43", "content_sanskrit": "आत्मानं च कुरुश्रेष्ठ कृष्णेन मनसेक्षितम्। ध्यायन् गते भागवते रुरोद प्रेमविह्वलः॥ ३/४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50007955, "chapter_id": 11390, "verse_number": "44", "content_sanskrit": "काळन्द्याः (???) कतिभिर्विद्वानहोभिर्भरतर्षभः। प्रापद्यत द्युसरितं यत्र मित्रासुतो मुनिः॥ ३/४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50007956, "chapter_id": 11390, "verse_number": "45", "content_sanskrit": "॥ इति श्रीमद्भागवते तृतीयस्कन्धे चतुर्थोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]