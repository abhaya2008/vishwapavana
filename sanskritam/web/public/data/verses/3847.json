[{"id": 2131687, "chapter_id": 3847, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2131688, "chapter_id": 3847, "verse_number": "१", "content_sanskrit": "कथं नागायुतप्राणो भीमो भीमपराक्रमः ।\nभयमाहारयत् तीव्रं तस्मादजगरान्मुने\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2131689, "chapter_id": 3847, "verse_number": "२", "content_sanskrit": "पौलस्त्यं धनदं युद्धे य आह्वयति दर्पितः ।\nनळिन्यां कदनं कृत्वा निहन्ता यक्षरक्षसाम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2131690, "chapter_id": 3847, "verse_number": "३", "content_sanskrit": "तं शंससि भयाविष्टमापन्नमरिसूदनम् ।\nएतदिच्छाम्यहं श्रोतुं परं कौतूहलं हि मे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2131691, "chapter_id": 3847, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2131692, "chapter_id": 3847, "verse_number": "४", "content_sanskrit": "यदृच्छया धनुष्पाणिर्बद्धखड्गो वृकोदरः ।\nददर्श तद्वनं रम्यं देवगन्धर्वसेवितम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2131693, "chapter_id": 3847, "verse_number": "५", "content_sanskrit": "स ददर्श शुभान् देशान् गिरेर्हिमवतस्तदा ।\nदेवर्षिसिद्धचरितानप्सरोगणसेवितान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2131694, "chapter_id": 3847, "verse_number": "६", "content_sanskrit": "चकोरैरुपचक्रैश्च पक्षिभिर्जीवजीवकैः ।\nकोकिलैर्भृङ्गराजैश्च तत्र तत्र निनादितान्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2131695, "chapter_id": 3847, "verse_number": "७", "content_sanskrit": "नित्यपुष्पफलैर्वृक्षैर्हिमसंस्पर्शकोमलैः ।\nउपेतान् बहुलच्छायैर्मनोनयननन्दनैः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2131696, "chapter_id": 3847, "verse_number": "८", "content_sanskrit": "स सम्पश्यन् गिरिनदीर्वैदूर्यमणिसन्निभैः ।\nसलिलैर्हिमसङ्काशैर्हंसकारण्डवायुतैः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2131697, "chapter_id": 3847, "verse_number": "९", "content_sanskrit": "वनानि देवदारूणां मेघानामिव वागुराः ।\nहरिचन्दनमिश्राणि तुङ्गाकालीयकान्यपि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2131698, "chapter_id": 3847, "verse_number": "१०", "content_sanskrit": "मृगयां परिधावन्स समेषु मरुधन्वसु ।\nविध्यन् मृगान् शरैः शुद्धैश्चचार स महाबलः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2131699, "chapter_id": 3847, "verse_number": "११", "content_sanskrit": "भीमसेनस्तु विख्यातो महान्तं दंष्ट्रिणं बलात् ।\nनिघ्नन् नागशतप्राणो वने तस्मिन् महाबलः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2131700, "chapter_id": 3847, "verse_number": "१२", "content_sanskrit": "मृगाणां स वराहाणां महिषाणां महाभुजः ।\nविनिघ्नंस्तत्र तत्रैव भीमो भीमपराक्रमः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2131701, "chapter_id": 3847, "verse_number": "१३", "content_sanskrit": "स मातङ्गशतप्राणो मनुष्यशतवारणः ।\nसिंहशार्दूलविक्रान्तो वने तस्मिन् महाबलः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2131702, "chapter_id": 3847, "verse_number": "१४", "content_sanskrit": "वृक्षानुत्पाटयामास तरसा वै बभञ्ज च ।\nपृथिव्याश्च प्रदेशान् वै नादयंस्तु वनानि च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2131703, "chapter_id": 3847, "verse_number": "१५", "content_sanskrit": "पर्वताग्राणि वै मृद्नन् नादयानश्च विज्वरः ।\nप्रक्षिपन् पादपांश्चापि नादेनापूरयन् महीम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2131704, "chapter_id": 3847, "verse_number": "१६", "content_sanskrit": "वेगेन न्यपतद् भीमो निर्भयश्च पुनः पुनः ।\nआस्फोटयन् क्ष्वेडयंश्च तळतालांश्च वादयन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2131705, "chapter_id": 3847, "verse_number": "१७", "content_sanskrit": "चिरसम्बद्धदर्पस्तु भीमसेनो वने तदा ।\nगजेन्द्राश्च महासत्त्वा मृगेन्द्राश्च महाबलाः ।\nभीमसेनस्य नादेन व्यमुञ्चन्त गुहा भयात्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2131706, "chapter_id": 3847, "verse_number": "१८", "content_sanskrit": "क्वचित्प्रधावंस्तिष्ठंश्च क्वचिच्चोपविशंस्तथा ।\nमृगप्रेप्सुर्महारौद्रे वने चरति निर्भयः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2131707, "chapter_id": 3847, "verse_number": "१९", "content_sanskrit": "स तत्र मनुजव्याघ्रो वने वनचरोपमः ।\nपद्भ्यामभिसमापेदे भीमसेनो महाबलः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2131708, "chapter_id": 3847, "verse_number": "२०", "content_sanskrit": "स प्रविष्टो महारण्ये नादान् नदति चाद्भुतान् ।\nत्रासयन् सर्वभूतानि महासत्त्वपराक्रमः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2131709, "chapter_id": 3847, "verse_number": "२१", "content_sanskrit": "ततो भीमस्य शब्देन भीताः सर्पा गुहाशयाः ।\nअतिक्रान्तास्तु वेगेन जगामानुसृतः शनैः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2131710, "chapter_id": 3847, "verse_number": "२२", "content_sanskrit": "ततोऽमरवरप्रख्यो भीमसेनो महाबलः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2131711, "chapter_id": 3847, "verse_number": "२३", "content_sanskrit": "स ददर्श महाकायं भुजङ्गं लोमहर्षणम् ।\nगिरिदुर्गे समापन्नं कायेनावृत्य कन्दरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2131712, "chapter_id": 3847, "verse_number": "२४", "content_sanskrit": "पर्वताभोगवर्ष्माणमतिकायं महाबलम् ।\nचित्राङ्गमङ्गजैश्चित्रैर्हरिद्रासदृशच्छविम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2131713, "chapter_id": 3847, "verse_number": "२५", "content_sanskrit": "गुहाकारेण वक्त्रेण चतुर्दंष्ट्रेण राजता ।\nदीप्ताक्षेणातिताम्रेण लिहानं सृक्किणी मुहुः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2131714, "chapter_id": 3847, "verse_number": "२६", "content_sanskrit": "त्रासनं सर्वभूतानां कालान्तकयमोपमम् ।\nनिःश्वासक्ष्वेडनादेन भर्त्सयन्तमिव स्थितम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2131715, "chapter_id": 3847, "verse_number": "२७", "content_sanskrit": "स भीमं सहसाभ्येत्य स्फिजा तं क्षुधितो भृशम् ।\nजग्राहाजगरो ग्राहो भुजयोरुभयोर्बलात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2131716, "chapter_id": 3847, "verse_number": "२८", "content_sanskrit": "तेन संस्पृष्टगात्रस्य भीमसेनस्य वै तदा ।\nसञ्ज्ञा मुमोह सहसा वरदानेन तस्य हि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2131717, "chapter_id": 3847, "verse_number": "२९", "content_sanskrit": "दशनागसहस्राणि धारयन्ति हि यद्बलम् ।\nतद्बलं भीमसेनस्य भुजयोर्न स मंसत \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2131718, "chapter_id": 3847, "verse_number": "३०", "content_sanskrit": "स तेजस्वी तथा तेन भुजगेन वशीकृतः ।\nविस्फुरन् शनकैर्भीमो न शशाक विचेष्टितुम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2131719, "chapter_id": 3847, "verse_number": "३१", "content_sanskrit": "नागायुतसमप्राणः सिंहस्कन्धो महाभुजः ।\nगृहीतो व्यजहात् सत्त्वं वरदानविमोहितः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2131720, "chapter_id": 3847, "verse_number": "३२", "content_sanskrit": "स हि प्रयत्नमकरोत् तीव्रमात्मविमोक्षणे ।\nन चैनमशकद् वीरः कथञ्चित् प्रतिबाधितुम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2131721, "chapter_id": 3847, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्विसप्तत्य- धिकशततमोऽध्यायः ॥ १७२॥ अजगरपर्वणि अजगरग्रहणे द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]