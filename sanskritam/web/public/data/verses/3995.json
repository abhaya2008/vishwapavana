[{"id": 2138263, "chapter_id": 3995, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2138264, "chapter_id": 3995, "verse_number": "१", "content_sanskrit": "एवं निर्दिश्य चात्मानं भीमसेनमुवाच ह ।\nभीमसेन कथं कर्म्म मत्स्यराष्ट्रे चरिष्यसि\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2138265, "chapter_id": 3995, "verse_number": "२", "content_sanskrit": "हत्वा क्रोधवशांस्तात पर्वते गन्धमादने ।\nयक्षान् क्रोधाभिताम्राक्षान् राक्षसांश्चातिपौरुषान्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2138266, "chapter_id": 3995, "verse_number": "३", "content_sanskrit": "प्रादाः पाञ्चालकन्यायै पद्मानि सुबहून्यपि\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2138267, "chapter_id": 3995, "verse_number": "४", "content_sanskrit": "बकं राक्षसराजानं भीषणं पुरुषादकम् ।\nजघ्निवानसि कौन्तेय ब्राह्मणार्त्थमरिन्दम\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2138268, "chapter_id": 3995, "verse_number": "५", "content_sanskrit": "क्षेमा चाभयसंवीता ह्येकचक्रा त्वया कृता\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2138269, "chapter_id": 3995, "verse_number": "६", "content_sanskrit": "हिडिम्बं च महावीर्यं किम्मीरं चातिपौरुषम् ।\nत्वया हत्वा महाबाहो वनं निष्कण्टकं कृतम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2138270, "chapter_id": 3995, "verse_number": "७", "content_sanskrit": "आपदं चापि सम्प्राप्ता द्रौपदी चारुहासिनी ।\nजटासुरवधं कृत्वा त्वया च परिमोक्षिता\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2138271, "chapter_id": 3995, "verse_number": "८", "content_sanskrit": "मत्स्यराजान्तिके तात वीर्यपूर्णोऽत्यमर्षणः ।\nवृकोदर विराटस्य बलवानबलीयसः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2138272, "chapter_id": 3995, "verse_number": "९", "content_sanskrit": "समीपे नगरे तस्य रंस्यसे केन कर्मणा\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2138273, "chapter_id": 3995, "verse_number": "१०", "content_sanskrit": "मन्ये निवासं भीमस्य दुष्करं तस्य भूपतेः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2138274, "chapter_id": 3995, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2138275, "chapter_id": 3995, "verse_number": "११", "content_sanskrit": "पौरोगवो ब्रुवाणोऽहं वललो नाम भारत ।\nउपस्थास्यामि राजानं विराटमिति रोचये\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2138276, "chapter_id": 3995, "verse_number": "१२", "content_sanskrit": "रसान् नानाविधांश्चापि स्वादून् सुमधुरांस्तदा ।\nसूपांश्चापि करिष्यामि कुशलोऽस्मि महानसे\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2138277, "chapter_id": 3995, "verse_number": "१३", "content_sanskrit": "पूर्वमप्राशितांस्तेन कर्तास्मि सुगुणान्वितान् ।\nस्वादु व्यञ्जनमास्वाद्य मन्ये प्रीतो भविष्यति\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2138278, "chapter_id": 3995, "verse_number": "१४", "content_sanskrit": "आहरिष्यामि दारूणां पाटितानां शतं शतम् ।\nराजा कर्माणि मे दृष्ट्वा न मां परिभविष्यति\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2138279, "chapter_id": 3995, "verse_number": "१५", "content_sanskrit": "ये च तस्य महामल्लाः समरेष्वपराजिताः ।\nकृतप्रतापा बहुशो राज्ञः प्रत्यायिका बले\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2138280, "chapter_id": 3995, "verse_number": "१६", "content_sanskrit": "राजोपजीविनः सर्वे परेषां च भयावहाः ।\nसर्वांस्तान् निहनिष्यामि रतिं राज्ञः प्रवर्धयन्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2138281, "chapter_id": 3995, "verse_number": "१७", "content_sanskrit": "न च तान् युध्यमानोऽहं नयिष्ये यमसादनम् ।\nतथा तान् निहनिष्यामि जीविष्यन्ति यथाऽऽतुराः\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2138282, "chapter_id": 3995, "verse_number": "१८", "content_sanskrit": "वृषो वा महिषो वाऽपि नागो वा षष्टिहायनः ।\nसिंहो व्याघ्रो यदा चान्यो ग्रहीतव्यो भविष्यति\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2138283, "chapter_id": 3995, "verse_number": "१९", "content_sanskrit": "तान् सर्वान् दुर्ग्रहानन्यैराशीविषविषोपमान् ।\nबलादहं ग्रहिष्यामि मत्स्यराजस्य पश्यतः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2138284, "chapter_id": 3995, "verse_number": "२०", "content_sanskrit": "आराळिका वा सूदा वा येऽस्य युक्ता महानसे ।\nतानहं प्रीणयिष्यामि मानुषान् स्वेन कर्मणा\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2138285, "chapter_id": 3995, "verse_number": "२१", "content_sanskrit": "आराळिको गोविकर्ता सूपकर्ता नियोधकः ।\nआसं युधिष्ठिरस्याहमिति वक्ष्यामि मानुषान्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2138286, "chapter_id": 3995, "verse_number": "२२", "content_sanskrit": "इत्येवं मत्प्रतिज्ञातं विहरिष्याम्यहं यथा ।\nविराटनगरे च्छन्नो मत्स्यराजसमीपतः\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2138287, "chapter_id": 3995, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2138288, "chapter_id": 3995, "verse_number": "२३", "content_sanskrit": "अग्निर्ब्राह्मणरूपेण प्रच्छन्नो यमयाचत ।\nमहाशनं ब्राह्मणं मां प्रमुञ्चार्जुन खण्डवे\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2138289, "chapter_id": 3995, "verse_number": "२४", "content_sanskrit": "संशुश्रुवे च धर्मात्मा यस्तमर्थं चकार ह ।\nतस्मै ब्राह्मणरूपाय हुताशाय महायशाः\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2138290, "chapter_id": 3995, "verse_number": "२५", "content_sanskrit": "यश्च देवान् मनुष्यांश्च सर्वांश्चैकरथोऽजयत् ।\nस भीमधन्वा श्वेताश्वः पाण्डवः किं करिष्यति\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2138291, "chapter_id": 3995, "verse_number": "२६", "content_sanskrit": "आशीविषसमस्पर्शो नागानामिव वासुकिः ।\nअहीनां दृष्टिविषवद् अग्निस्तेजस्विनामिव\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2138292, "chapter_id": 3995, "verse_number": "२७", "content_sanskrit": "समुद्र इव सिन्धूनां शैलानां हिमवानिव ।\nमहेन्द्र इव देवानां दानवानां बलिर्यथा\t ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2138293, "chapter_id": 3995, "verse_number": "२८", "content_sanskrit": "सुप्रतीको गजानां च युग्यानां तुरगो यथा ।\nकुबेर इव यक्षाणां मृगाणां केसरी यथा\t ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2138294, "chapter_id": 3995, "verse_number": "२९", "content_sanskrit": "राक्षसानां दशग्रीवो दैत्यानामिव शम्बरः ।\nरुद्राणामिव कापाली विष्णुर्बलवतामिव\t ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2138295, "chapter_id": 3995, "verse_number": "३०", "content_sanskrit": "रोषामर्षसमायुक्तो भुजङ्गानां च तक्षकः ।\nवायुवेगबलोद्भूतो गरुडः पततामिव\t ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2138296, "chapter_id": 3995, "verse_number": "३१", "content_sanskrit": "तपतामिव चादित्यः प्रजानां ब्राह्मणो यथा ।\nह्रदानामिव पाताळं पर्जन्यो नदतामिव\t ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2138297, "chapter_id": 3995, "verse_number": "३२", "content_sanskrit": "आयुधानां वरो वज्रः ककुद्मांश्च गवां वरः ।\nधृतराष्ट्रश्च नागानां हस्तिष्वैरावतो वरः\t ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2138298, "chapter_id": 3995, "verse_number": "३३", "content_sanskrit": "पुत्रः प्रियाणामधिको भार्या च सुहृदां वरा ।\nगिरीणां प्रवरो मेरुर्देवानां मधुसूदनः\t ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2138299, "chapter_id": 3995, "verse_number": "३४", "content_sanskrit": "ग्रहाणां प्रवरश्चन्द्रः सरसां मानसं वरम्\t ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2138300, "chapter_id": 3995, "verse_number": "३५", "content_sanskrit": "यथैतानि विशिष्टानि स्वस्वजात्यां वृकोदर ।\nएवं युवा गुडाकेशः श्रेष्ठः सर्वधनुष्मताम्\t ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2138301, "chapter_id": 3995, "verse_number": "३६", "content_sanskrit": "सोयमिन्द्रादनवमो वासुदेवाच्च भारत\t ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2138302, "chapter_id": 3995, "verse_number": "३७", "content_sanskrit": "उषित्वा पञ्च वर्षाणि सहस्राक्षस्य वेश्मनि ।\nब्रह्मचर्यव्रते युक्तः सर्वशस्त्रभृतां वरः\t ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2138303, "chapter_id": 3995, "verse_number": "३८", "content_sanskrit": "अवाप चास्त्रमस्त्रज्ञः सर्वं सर्वज्ञसम्मतः ।\nक्षिप्रं चाणु च चित्रं च ध्रुवं च वदतां वरः\t ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2138304, "chapter_id": 3995, "verse_number": "३९", "content_sanskrit": "अनुज्ञातः सुरेन्द्रेण पुनः प्रत्यागतो महीम्\t ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2138305, "chapter_id": 3995, "verse_number": "४०", "content_sanskrit": "यस्य दीर्घौ समौ बाहू ज्याघातकठिनत्वचौ\t ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2138306, "chapter_id": 3995, "verse_number": "४१", "content_sanskrit": "दक्षिणे चैव सव्ये च गवामिव हविष्कृतौ ।\nतलाङ्गुलित्राभ्युचितौ नागराजकरोपमौ\t ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2138307, "chapter_id": 3995, "verse_number": "४२", "content_sanskrit": "श्यामो युवा गुडाकेशो दर्शनीयश्च पाण्डवः ।\nगाण्डीवधन्वा श्वेताश्वः किरीटी वानरध्वजः\t ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2138308, "chapter_id": 3995, "verse_number": "४३", "content_sanskrit": "किंरूपधारी किंकर्मा किंचेष्टः किंपरायणः ।\nबीभत्सुर्भीमधन्वा च किं करिष्यति चार्जुनः\t ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2138309, "chapter_id": 3995, "verse_number": "४४", "content_sanskrit": "कुन्तीपुत्रो विराटस्य रमते केन कर्मणा\t ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2138310, "chapter_id": 3995, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2138311, "chapter_id": 3995, "verse_number": "४५", "content_sanskrit": "इमौ किणकृतौ बाहू ज्याघातकठिनत्वचौ ।\nनित्यं कञ्चुकसञ्छन्नौ नान्यथा गोप्तुमुत्सहे\t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2138312, "chapter_id": 3995, "verse_number": "४६", "content_sanskrit": "किन्तु कार्यवशादेतदाचरिष्यामि कुत्सितम् ।\nआख्यातः षण्डकोऽस्मीति प्रतिज्ञातं हि पापकम्\t ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2138313, "chapter_id": 3995, "verse_number": "४७", "content_sanskrit": "बाहू मे भरतश्रेष्ठ महाव्यञ्जनलक्षितौ ।\nज्याघातौ च महान्तौ मे संवर्तुं नृप दुष्करौ\t ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2138314, "chapter_id": 3995, "verse_number": "४८", "content_sanskrit": "उभौ कञ्चुकसञ्छन्नौ लम्बिनौ जानुदेशतः ।\nवलयैः छादयिष्यामि बाहू किणकृतावुभौ\t ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2138315, "chapter_id": 3995, "verse_number": "४९", "content_sanskrit": "उभौ कम्बू समायुज्य कुण्डले परिपातुके ।\nवेणीकृतशिरा भूत्वा भविष्यामि बृहन्नळा\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2138316, "chapter_id": 3995, "verse_number": "५०", "content_sanskrit": "पठन्नाख्यायिकां नाम स्त्रीभावेन पुनः पुनः ।\nप्रजानां समुदाचारं बहु नर्मकृतं वदन्\t ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2138317, "chapter_id": 3995, "verse_number": "५१", "content_sanskrit": "रमयिष्यामि राजानमन्यं चान्तःपुरे जनम्\t ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2138318, "chapter_id": 3995, "verse_number": "५२", "content_sanskrit": "नृत्तं गीतं च वादित्रं दिव्यं च विविधं तथा ।\nशिक्षयिष्याम्यहं राजन् विराटनगरे स्त्रियः\t ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2138319, "chapter_id": 3995, "verse_number": "५३", "content_sanskrit": "स्त्रीभावसमुदाचारान् नृत्तगीतकथाश्रयैः ।\nछादयिष्यामि राजेन्द्र माययाऽऽत्मानमात्मना\t ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2138320, "chapter_id": 3995, "verse_number": "५४", "content_sanskrit": "युधिष्ठिरस्य गेहेऽस्मिन् द्रौपदीपरिचारिका ।\nउषिताऽस्मीति वक्ष्यामि धर्मराजस्य सम्मता\t ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2138321, "chapter_id": 3995, "verse_number": "५५", "content_sanskrit": "उर्वश्या अपि शापेन प्राप्तोऽस्मि नृप षण्डताम् ।\nशक्रप्रसादान्मुक्तोऽहं वर्षाणां तत्त्रयोदशम्\t ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2138322, "chapter_id": 3995, "verse_number": "५६", "content_sanskrit": "एतेन विधिना च्छन्नः कृतकेन यथाबलम् ।\nविहरिष्यामि राजेन्द्र विराटनगरे सुखम्\t ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2138323, "chapter_id": 3995, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि तृतीयोऽध्यायः ॥३॥ वैराटपर्वणि तृतीयोऽध्यायः ॥३॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]