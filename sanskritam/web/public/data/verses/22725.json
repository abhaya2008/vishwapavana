[{"id": 7002725000, "chapter_id": 22725, "verse_number": "९-१०-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nज्येष्ठे मासि सिते पक्षे प्रथमेऽह्नि दिनोदये ।\nदेवोद्यानभवं हृद्यं करवीरं समर्चयेत ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002725001, "chapter_id": 22725, "verse_number": "९-१०-२", "content_sanskrit": "रक्ततंतुपरीधानं गन्धधूपविलेपनैः ।\nविरूढैः सप्तधान्यैश्च नारंगैर्बीजपूरकैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002725002, "chapter_id": 22725, "verse_number": "९-१०-३", "content_sanskrit": "गुणकैर्घटकैर्दिव्यैर्नालिकेरैः सुशोभनैः ।\nअभ्युक्ष्याक्षततोयेन मंत्रेणैवं क्षमापयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002725003, "chapter_id": 22725, "verse_number": "९-१०-४", "content_sanskrit": "करवीर विषावास नमस्ते भानुवल्लभ ।\nमौलिमंडनसद्रत्न नमस्ते केशवेशयोः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002725004, "chapter_id": 22725, "verse_number": "९-१०-५", "content_sanskrit": "आकृष्णेन रजसा वर्तमानो निवेशयन्नमृतं मर्त्यं च ।\nहिरण्ययेन सविता रथेनादेवो याति भुवनानि पश्यन् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002725005, "chapter_id": 22725, "verse_number": "९-१०-६", "content_sanskrit": "एवं भक्त्या समभ्यर्च्य दत्त्वा विप्राय दक्षिणाम् ।\nप्रदक्षिणामथो कृत्वा ततः स्वभवनं व्रजेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002725006, "chapter_id": 22725, "verse_number": "९-१०-७", "content_sanskrit": "एतद्व्रतं महाभाग सूर्याराधनकाम्यया ।\nअनसूयया च क्षमया सावित्र्या सत्यभामया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002725007, "chapter_id": 22725, "verse_number": "९-१०-८", "content_sanskrit": "दमयन्त्या सरस्वत्या गायत्र्या गंगया तथा ।\nअन्याभिरपि नारीभिर्मर्त्यलोकेऽप्यनुष्ठितम् ।\nकरवीव्रतं पार्थ सर्वसौख्यफलप्रदम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002725008, "chapter_id": 22725, "verse_number": "९-१०-९", "content_sanskrit": "संपूज्य रत्नकुसुमांचितसर्वशाखं नीलैर्दलैस्तततनुं करवीरवृक्षम् ।\nभुक्त्वा मनोऽभिलषितान्भुवि भव्यभोगानंते प्रयाति भवनं भरताग्र्य भानोः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]