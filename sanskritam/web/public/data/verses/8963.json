[{"id": 40005987, "chapter_id": 8963, "verse_number": "1", "content_sanskrit": "तं तु राम स्समाश्वास्य भ्रातरं गुरवत्सलम्। लक्ष्मणेन सह भ्रात्रा प्रष्टुं समुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40005988, "chapter_id": 8963, "verse_number": "2", "content_sanskrit": "किमेतदिच्छेयमहं श्रोतुं प्रव्याहृतं त्वया। यस्मात्त्वमागतो देशमिमं चीरजटाजिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40005989, "chapter_id": 8963, "verse_number": "3", "content_sanskrit": "यन्निमित्तमिमं देशं कृष्णाजिनजटाधरः। हित्वा राज्यं प्रविष्टस्त्वं तत्सर्वं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40005990, "chapter_id": 8963, "verse_number": "4", "content_sanskrit": "इत्युक्तः कैकयीपुत्रः काकुत्स्थेन महात्मना। प्रगृह्य बलवद्भूयः प्राञ्जलिर्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40005991, "chapter_id": 8963, "verse_number": "5", "content_sanskrit": "आर्यं तातः परित्यज्य कृत्वा कर्म सुदुष्करम्। गत: स्वर्ग महाबाहुः पुत्रशोकाभिपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40005992, "chapter_id": 8963, "verse_number": "6", "content_sanskrit": "स्त्रिया नियुक्तः कैकेय्या मम मात्रा परन्तप। चकार सा महत्पापमिदमात्मयशोहरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40005993, "chapter_id": 8963, "verse_number": "7", "content_sanskrit": "सा राज्यफलमप्राप्य विधवा शोककर्शिता। पतिष्यति महाघोरे निरये जननी मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40005994, "chapter_id": 8963, "verse_number": "8", "content_sanskrit": "तस्य मे दासभूतस्य प्रसादं कर्तुमर्हसि। अभिषिञ्चस्व चाद्येव राज्येन मघवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40005995, "chapter_id": 8963, "verse_number": "9", "content_sanskrit": "इमाः प्रकृतय स्सर्वा विधवा मातरश्च याः। त्वत्सकाशमनुप्राप्ता प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40005996, "chapter_id": 8963, "verse_number": "10", "content_sanskrit": "तदानुपूर्व्या युक्तं च युक्तं चात्मनि मानद। राज्यं प्राप्नुहि धर्मेण सकामान्सुहृदः कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40005997, "chapter_id": 8963, "verse_number": "11", "content_sanskrit": "भवत्वविधवा भूमि स्समग्रा पतिना त्वया। शशिना विमलेनेव शारदी रजनी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40005998, "chapter_id": 8963, "verse_number": "12", "content_sanskrit": "एभिश्च सचिवैस्सार्धं शिरसा याचितो मया। भ्रातु शिष्यस्य दासस्य प्रसादं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40005999, "chapter_id": 8963, "verse_number": "13", "content_sanskrit": "तदिदं शाश्वतं पित्र्यं सर्वं प्रकृतिमण्डलम्। पूजितं पुरुषव्याघ्र नातिक्रमितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40006000, "chapter_id": 8963, "verse_number": "14", "content_sanskrit": "एवमुक्त्वा महाबाहु स्सबाष्पः कैकयीसुतः। रामस्य शिरसा पादौ जग्राह भरत: पुन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40006001, "chapter_id": 8963, "verse_number": "15", "content_sanskrit": "तं मत्तमिव मातङ्गं निःश्वसन्तं पुन पुनः। भ्रातरं भरतं रामः परिष्वज्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40006002, "chapter_id": 8963, "verse_number": "16", "content_sanskrit": "कुलीन:सत्त्वसम्पन्नस्तेजस्वी चरितव्रतः। राज्यहेतोः कथं पापमाचरेत्त्वद्विधो जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40006003, "chapter_id": 8963, "verse_number": "17", "content_sanskrit": "न दोषं त्वयि पश्यामि सूक्ष्ममप्यरिसूदन। न चापि जननीं बाल्यात्त्वं विगर्हितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40006004, "chapter_id": 8963, "verse_number": "18", "content_sanskrit": "कामकारो महाप्राज्ञ गुरूणां सर्वदाऽनघ। उपपन्नेषु दारेषु पुत्रेषु च विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40006005, "chapter_id": 8963, "verse_number": "19", "content_sanskrit": "वयमस्य यथा लोके सङ्ख्याता: सौम्य साधुभिः। भार्याः पुत्राश्च शिष्याश्च त्वमनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40006006, "chapter_id": 8963, "verse_number": "20", "content_sanskrit": "वने वा चीरवसनं सौम्य कृष्णाजिनाम्बरम्। राज्ये वाऽपि महाराजो मां वासयितुमीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40006007, "chapter_id": 8963, "verse_number": "21", "content_sanskrit": "यावत पितरि धर्मज्ञे गौरवं लोकसत्कृतम्। तावद्धर्मभृतां श्रेष्ठ जनन्यामपि गौरवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40006008, "chapter_id": 8963, "verse_number": "22", "content_sanskrit": "एताभ्यां धर्मशीलाभ्यां वनं गच्छेति राघव। मातापितृभ्यामुक्तोऽहं कथमन्यत्समाचरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40006009, "chapter_id": 8963, "verse_number": "23", "content_sanskrit": "त्वया राज्यमयोध्यायां प्राप्तव्यं लोकसत्कृतम्। वस्तव्यं दण्डकारण्ये मया वल्कलवाससा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40006010, "chapter_id": 8963, "verse_number": "24", "content_sanskrit": "एवं कृत्वा महाराजो विभागं लोकसन्निधौ। व्यादिश्य च महातेजा दिवं दशरथो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40006011, "chapter_id": 8963, "verse_number": "25", "content_sanskrit": "स च प्रमाणं धर्मात्मा राजा लोकगुरुस्तव। पित्रा दत्तं यथाभागमुपभोक्तुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40006012, "chapter_id": 8963, "verse_number": "26", "content_sanskrit": "चतुर्दश समास्सौम्य दण्डकारण्यमाश्रितः। उपभोक्ष्ये त्वहं दत्तं भागं पित्रा महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40006013, "chapter_id": 8963, "verse_number": "27", "content_sanskrit": "यदब्रवीन्मां नरलोकसत्कृतः पिता महात्मा विबुधाधिपोपमः। तदेव मन्ये परमात्मनो हितं न सर्वलोकेश्वर भावमप्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]