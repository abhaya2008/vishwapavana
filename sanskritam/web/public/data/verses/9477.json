[{"id": 5000477000, "chapter_id": 9477, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000477001, "chapter_id": 9477, "verse_number": "६-७०-१", "content_sanskrit": "नरान्तकं हतं दृष्ट्वा चुक्रुशुर्नैर्ऋतर्षभाः।\nदेवान्तकस्त्रिमूर्धा च पौलस्त्यश्च महोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000477002, "chapter_id": 9477, "verse_number": "६-७०-२", "content_sanskrit": "आरूढो मेघसंकाशं वारणेन्द्रं महोदरः।\nवालिपुत्रं महावीर्यमभिदुद्राव वेगवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000477003, "chapter_id": 9477, "verse_number": "६-७०-३", "content_sanskrit": "भ्रातृव्यसनसंतप्तस्तदा देवान्तको बली।\nआदाय परिघं घोरमङ्गदं समभिद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000477004, "chapter_id": 9477, "verse_number": "६-७०-४", "content_sanskrit": "रथमादित्यसंकाशं युक्तं परमवाजिभिः।\nआस्थाय त्रिशिरा वीरो वालिपुत्रमथाभ्यगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000477005, "chapter_id": 9477, "verse_number": "६-७०-५", "content_sanskrit": "स त्रिभिर्देवदर्पघ्नै राक्षसेन्द्रैरभिद्रुतः।\nवृक्षमुत्पाटयामास महाविटपमङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000477006, "chapter_id": 9477, "verse_number": "६-७०-६", "content_sanskrit": "देवान्तकाय तं वीरश्चिक्षेप सहसाङ्गदः।\nमहावृक्षं महाशाखं शक्रो दीप्तामिवाशनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000477007, "chapter_id": 9477, "verse_number": "६-७०-७", "content_sanskrit": "त्रिशिरास्तं प्रचिच्छेद शरैराशीविषोपमैः।\nस वृक्षं कृत्तमालोक्य उत्पपात तदाङ्गदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000477008, "chapter_id": 9477, "verse_number": "६-७०-८", "content_sanskrit": "स ववर्ष ततो वृक्षान् शिलाश्च कपिकुञ्जरः।\nतान् प्रचिच्छेद संक्रुद्धस्त्रिशिरा निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000477009, "chapter_id": 9477, "verse_number": "६-७०-९", "content_sanskrit": "परिघाग्रेण तान् वृक्षान् बभञ्ज स महोदरः।\nत्रिशिराश्चाङ्गदं वीरमभिदुद्राव सायकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000477010, "chapter_id": 9477, "verse_number": "६-७०-१०", "content_sanskrit": "गजेन समभिद्रुत्य वालिपुत्रं महोदरः।\nजघानोरसि संक्रुद्धस्तोमरैर्वज्रसंनिभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000477011, "chapter_id": 9477, "verse_number": "६-७०-११", "content_sanskrit": "देवान्तकश्च संक्रुद्धः परिघेण तदाङ्गदम्।\nउपगम्याभिहत्याशु व्यपचक्राम वेगवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000477012, "chapter_id": 9477, "verse_number": "६-७०-१२", "content_sanskrit": "स त्रिभिर्नैर्ऋतश्रेष्ठैर्युगपत् समभिद्रुतः।\nन विव्यथे महातेजा वालिपुत्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000477013, "chapter_id": 9477, "verse_number": "६-७०-१३", "content_sanskrit": "स वेगवान् महावेगं कृत्वा परमदुर्जयः।\nतलेन समभिद्रुत्य जघानास्य महागजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000477014, "chapter_id": 9477, "verse_number": "६-७०-१४", "content_sanskrit": "तस्य तेन प्रहारेण नागराजस्य संयुगे।\nपेततुर्नयने तस्य विननाश स कुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000477015, "chapter_id": 9477, "verse_number": "६-७०-१५", "content_sanskrit": "विषाणं चास्य निष्कृष्य वालिपुत्रो महाबलः।\nदेवान्तकमभिद्रुत्य ताडयामास संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000477016, "chapter_id": 9477, "verse_number": "६-७०-१६", "content_sanskrit": "स विह्वलस्तु तेजस्वी वातोद्‍धूत इव द्रुमः।\nलाक्षारससवर्णं च सुस्राव रुधिरं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000477017, "chapter_id": 9477, "verse_number": "६-७०-१७", "content_sanskrit": "अथाश्वास्य महातेजाः कृच्छ्राद् देवान्तको बली।\nआविध्य परिघं वेगादाजघान तदाङ्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000477018, "chapter_id": 9477, "verse_number": "६-७०-१८", "content_sanskrit": "परिघाभिहतश्चापि वानरेन्द्रात्मजस्तदा।\nजानुभ्यां पतितो भूमौ पुनरेवोत्पपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000477019, "chapter_id": 9477, "verse_number": "६-७०-१९", "content_sanskrit": "तमुत्पतन्तं त्रिशिरास्त्रिभिर्बाणैरजिह्मगैः।\nघोरैर्हरिपतेः पुत्रं ललाटेऽभिजघान ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000477020, "chapter_id": 9477, "verse_number": "६-७०-२०", "content_sanskrit": "ततोऽङ्गदं परिक्षिप्तं त्रिभिर्नैर्ऋतपुङ्गवैः।\nहनूमानथ विज्ञाय नीलश्चापि प्रतस्थतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000477021, "chapter_id": 9477, "verse_number": "६-७०-२१", "content_sanskrit": "ततश्चिक्षेप शैलाग्रं नीलस्त्रिशिरसे तदा।\nतद् रावणसुतो धीमान् बिभेद निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000477022, "chapter_id": 9477, "verse_number": "६-७०-२२", "content_sanskrit": "तद‍्बाणशतनिर्भिन्नं विदारितशिलातलम्।\nसविस्फुलिङ्गं सज्वालं निपपात गिरेः शिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000477023, "chapter_id": 9477, "verse_number": "६-७०-२३", "content_sanskrit": "स विजृम्भितमालोक्य हर्षाद् देवान्तको बली।\nपरिघेणाभिदुद्राव मारुतात्मजमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000477024, "chapter_id": 9477, "verse_number": "६-७०-२४", "content_sanskrit": "तमापतन्तमुत्पत्य हनूमान् कपिकुञ्जरः।\nआजघान तदा मूर्ध्नि वज्रकल्पेन मुष्टिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000477025, "chapter_id": 9477, "verse_number": "६-७०-२५", "content_sanskrit": "शिरसि प्राहरद् वीरस्तदा वायुसुतो बली।\nनादेनाकम्पयच्चैव राक्षसान् स महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000477026, "chapter_id": 9477, "verse_number": "६-७०-२६", "content_sanskrit": "स मुष्टिनिष्पिष्टविभिन्नमूर्धा\nनिर्वान्तदन्ताक्षिविलम्बिजिह्वः।\nदेवान्तको राक्षसराजसूनु-\nर्गतासुरुर्व्यां सहसा पपात ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000477027, "chapter_id": 9477, "verse_number": "६-७०-२७", "content_sanskrit": "तस्मिन् हते राक्षसयोधमुख्ये\nमहाबले संयति देवशत्रौ।\nक्रुद्धस्त्रिशीर्षा निशितास्त्रमुग्रं\nववर्ष नीलोरसि बाणवर्षम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000477028, "chapter_id": 9477, "verse_number": "६-७०-२८", "content_sanskrit": "महोदरस्तु संक्रुद्धः कुञ्जरं पर्वतोपमम्।\nभूयः समधिरुह्याशु मन्दरं रश्मिवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000477029, "chapter_id": 9477, "verse_number": "६-७०-२९", "content_sanskrit": "ततो बाणमयं वर्षं नीलस्योपर्यपातयत्।\nगिरौ वर्षं तडिच्चक्रचापवानिव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000477030, "chapter_id": 9477, "verse_number": "६-७०-३०", "content_sanskrit": "ततः शरौघैरभिवृष्यमाणो\nविभिन्नगात्रः कपिसैन्यपालः।\nनीलो बभूवाथ विसृष्टगात्रो\nविष्टम्भितस्तेन महाबलेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000477031, "chapter_id": 9477, "verse_number": "६-७०-३१", "content_sanskrit": "ततस्तु नीलः प्रतिलब्धसंज्ञः\nशैलं समुत्पाट्य सवृक्षखण्डम्।\nततः समुत्पत्य महोग्रवेगो\nमहोदरं तेन जघान मूर्ध्नि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000477032, "chapter_id": 9477, "verse_number": "६-७०-३२", "content_sanskrit": "ततः स शैलाभिनिपातभग्नो\nमहोदरस्तेन महाद्विपेन।\nव्यामोहितो भूमितले गतासुः\nपपात वज्राभिहतो यथाद्रिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000477033, "chapter_id": 9477, "verse_number": "६-७०-३३", "content_sanskrit": "पितृव्यं निहतं दृष्ट्वा त्रिशिराश्चापमाददे।\nहनूमन्तं च संक्रुद्धो विव्याध निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000477034, "chapter_id": 9477, "verse_number": "६-७०-३४", "content_sanskrit": "स वायुसूनुः कुपितश्चिक्षेप शिखरं गिरेः।\nत्रिशिरास्तच्छरैस्तीक्ष्णैर्बिभेद बहुधा बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000477035, "chapter_id": 9477, "verse_number": "६-७०-३५", "content_sanskrit": "तद् व्यर्थं शिखरं दृष्ट्वा द्रुमवर्षं तदा कपिः।\nविससर्ज रणे तस्मिन् रावणस्य सुतं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000477036, "chapter_id": 9477, "verse_number": "६-७०-३६", "content_sanskrit": "तमापतन्तमाकाशे द्रुमवर्षं प्रतापवान्।\nत्रिशिरा निशितैर्बाणैश्चिच्छेद च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000477037, "chapter_id": 9477, "verse_number": "६-७०-३७", "content_sanskrit": "हनूमांस्तु समुत्पत्य हयं त्रिशिरसस्तदा।\nविददार नखैः क्रुद्धो नागेन्द्रं मृगराडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000477038, "chapter_id": 9477, "verse_number": "६-७०-३८", "content_sanskrit": "अथ शक्तिं समासाद्य कालरात्रिमिवान्तकः।\nचिक्षेपानिलपुत्राय त्रिशिरा रावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000477039, "chapter_id": 9477, "verse_number": "६-७०-३९", "content_sanskrit": "दिवः क्षिप्तामिवोल्कां तां शक्तिं क्षिप्तामसङ्गताम्।\nगृहीत्वा हरिशार्दूलो बभञ्ज च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000477040, "chapter_id": 9477, "verse_number": "६-७०-४०", "content_sanskrit": "तां दृष्ट्वा घोरसंकाशां शक्तिं भग्नां हनूमता।\nप्रहृष्टा वानरगणा विनेदुर्जलदा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000477041, "chapter_id": 9477, "verse_number": "६-७०-४१", "content_sanskrit": "ततः खड्गं समुद्यम्य त्रिशिरा राक्षसोत्तमः।\nनिचखान तदा खड्गं वानरेन्द्रस्य वक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000477042, "chapter_id": 9477, "verse_number": "६-७०-४२", "content_sanskrit": "खड्गप्रहाराभिहतो हनूमान् मारुतात्मजः।\nआजघान त्रिमूर्धानं तलेनोरसि वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000477043, "chapter_id": 9477, "verse_number": "६-७०-४३", "content_sanskrit": "स तलाभिहतस्तेन स्रस्तहस्तायुधो भुवि।\nनिपपात महातेजास्त्रिशिरास्त्यक्तचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000477044, "chapter_id": 9477, "verse_number": "६-७०-४४", "content_sanskrit": "स तस्य पततः खड्गं तमाच्छिद्य महाकपिः।\nननाद गिरिसंकाशस्त्रासयन् सर्वराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000477045, "chapter_id": 9477, "verse_number": "६-७०-४५", "content_sanskrit": "अमृष्यमाणस्तं घोषमुत्पपात निशाचरः।\nउत्पत्य च हनूमन्तं ताडयामास मुष्टिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000477046, "chapter_id": 9477, "verse_number": "६-७०-४६", "content_sanskrit": "तेन मुष्टिप्रहारेण संचुकोप महाकपिः।\nकुपितश्च निजग्राह किरीटे राक्षसर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000477047, "chapter_id": 9477, "verse_number": "६-७०-४७", "content_sanskrit": "स तस्य शीर्षाण्यसिना शितेन\nकिरीटजुष्टानि सकुण्डलानि।\nक्रुद्धः प्रचिच्छेद सुतोऽनिलस्य\nत्वष्टुः सुतस्येव शिरांसि शक्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000477048, "chapter_id": 9477, "verse_number": "६-७०-४८", "content_sanskrit": "तान्यायताक्षाण्यगसंनिभानि\nप्रदीप्तवैश्वानरलोचनानि।\nपेतुः शिरांसीन्द्ररिपोः पृथिव्यां\nज्योतींषि मुक्तानि यथार्कमार्गात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000477049, "chapter_id": 9477, "verse_number": "६-७०-४९", "content_sanskrit": "तस्मिन् हते देवरिपौ त्रिशीर्षे\nहनूमता शक्रपराक्रमेण।\nनेदुः प्लवंगाः प्रचचाल भूमी\nरक्षांस्यथो दुद्रुविरे समन्तात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000477050, "chapter_id": 9477, "verse_number": "६-७०-५०", "content_sanskrit": "हतं त्रिशिरसं दृष्ट्वा तथैव च महोदरम्।\nहतौ प्रेक्ष्य दुराधर्षौ देवान्तकनरान्तकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000477051, "chapter_id": 9477, "verse_number": "६-७०-५१", "content_sanskrit": "चुकोप परमामर्षी मत्तो राक्षसपुङ्गवः।\nजग्राहार्चिष्मतीं चापि गदां सर्वायसीं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000477052, "chapter_id": 9477, "verse_number": "६-७०-५२", "content_sanskrit": "हेमपट्टपरिक्षिप्तां मांसशोणितफेनिलाम्।\nविराजमानां विपुलां शत्रुशोणिततर्पिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000477053, "chapter_id": 9477, "verse_number": "६-७०-५३", "content_sanskrit": "तेजसा सम्प्रदीप्ताग्रां रक्तमाल्यविभूषिताम्।\nऐरावतमहापद्मसार्वभौमभयावहाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000477054, "chapter_id": 9477, "verse_number": "६-७०-५४", "content_sanskrit": "गदामादाय संक्रुद्धो मत्तो राक्षसपुङ्गवः।\nहरीन् समभिदुद्राव युगान्ताग्निरिव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000477055, "chapter_id": 9477, "verse_number": "६-७०-५५", "content_sanskrit": "अथर्षभः समुत्पत्य वानरो रावणानुजम्।\nमत्तानीकमुपागम्य तस्थौ तस्याग्रतो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000477056, "chapter_id": 9477, "verse_number": "६-७०-५६", "content_sanskrit": "तं पुरस्तात् स्थितं दृष्ट्वा वानरं पर्वतोपमम्।\nआजघानोरसि क्रुद्धो गदया वज्रकल्पया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000477057, "chapter_id": 9477, "verse_number": "६-७०-५७", "content_sanskrit": "स तयाभिहतस्तेन गदया वानरर्षभः।\nभिन्नवक्षाः समाधूतः सुस्राव रुधिरं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000477058, "chapter_id": 9477, "verse_number": "६-७०-५८", "content_sanskrit": "स सम्प्राप्य चिरात् संज्ञामृषभो वानरेश्वरः।\nक्रुद्धो विस्फुरमाणौष्ठो महापार्श्वमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000477059, "chapter_id": 9477, "verse_number": "६-७०-५९", "content_sanskrit": "स वेगवान् वेगवदभ्युपेत्य\nतं राक्षसं वानरवीरमुख्यः।\nसंवर्त्य मुष्टिं सहसा जघान\nबाह्वन्तरे शैलनिकाशरूपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000477060, "chapter_id": 9477, "verse_number": "६-७०-६०", "content_sanskrit": "स कृत्तमूलः सहसेव वृक्षः\nक्षितौ पपात क्षतजोक्षिताङ्गः।\nतां चास्य घोरां यमदण्डकल्पां\nगदां प्रगृह्याशु तदा ननाद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000477061, "chapter_id": 9477, "verse_number": "६-७०-६१", "content_sanskrit": "मुहूर्तमासीत् स गतासुकल्पः\nप्रत्यागतात्मा सहसा सुरारिः।\nउत्पत्य संध्याभ्रसमानवर्ण-\nस्तं वारिराजात्मजमाजघान ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000477062, "chapter_id": 9477, "verse_number": "६-७०-६२", "content_sanskrit": "स मूर्च्छितो भूमितले पपात\nमुहूर्तमुत्पत्य पुनः ससंज्ञः।\nतामेव तस्याद्रिवराद्रिकल्पां\nगदां समाविध्य जघान संख्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000477063, "chapter_id": 9477, "verse_number": "६-७०-६३", "content_sanskrit": "सा तस्य रौद्रा समुपेत्य देहं\nरौद्रस्य देवाध्वरविप्रशत्रोः।\nबिभेद वक्षः क्षतजं च भूरि\nसुस्राव धात्वम्भ इवाद्रिराजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000477064, "chapter_id": 9477, "verse_number": "६-७०-६४", "content_sanskrit": "अभिदुद्राव वेगेन गदां तस्य महात्मनः।\nतां गृहीत्वा गदां भीमामाविध्य च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000477065, "chapter_id": 9477, "verse_number": "६-७०-६५", "content_sanskrit": "मत्तानीकं महात्मा स जघान रणमूर्धनि।\nस स्वया गदया भग्नो विशीर्णदशनेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000477066, "chapter_id": 9477, "verse_number": "६-७०-६६", "content_sanskrit": "निपपात तदा मत्तो वज्राहत इवाचलः।\nविशीर्णनयने भूमौ गतसत्त्वे गतायुषि।\nपतिते राक्षसे तस्मिन् विद्रुतं राक्षसं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000477067, "chapter_id": 9477, "verse_number": "६-७०-६७", "content_sanskrit": "तस्मिन् हते भ्रातरि रावणस्य\nतन्नैर्ऋतानां बलमर्णवाभम्।\nत्यक्तायुधं केवलजीवितार्थं\nदुद्राव भिन्नार्णवसंनिकाशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000477068, "chapter_id": 9477, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]