[{"id": 2026200, "chapter_id": 1560, "verse_number": "३-१९८-०x", "content_sanskrit": "[*मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026201, "chapter_id": 1560, "verse_number": "३-१९८-१", "content_sanskrit": "इदमन्यच्छ्रूतां ययातिर्नाहुषो राजा राज्यस्थः पौरजनावृत आसांचक्रे ॥ गुर्वर्थी ब्राह्मण उपेत्याब्रवीत् भो राजन्गुर्वर्थं भिक्षेयं समयादिति राजोवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026202, "chapter_id": 1560, "verse_number": "३-१९८-२", "content_sanskrit": "ब्रवीतु भगवान्समयमिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026203, "chapter_id": 1560, "verse_number": "३-१९८-३x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026204, "chapter_id": 1560, "verse_number": "३-१९८-३", "content_sanskrit": "विद्वेषणं परमं जीवलोके\nकुर्यान्नरः पार्थिव याच्यमानः।\nतं त्वां पृच्छामि कथं तु राज-\nन्दद्याद्वान्दयितं च मेऽद्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026205, "chapter_id": 1560, "verse_number": "३-१९८-४x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026206, "chapter_id": 1560, "verse_number": "३-१९८-४", "content_sanskrit": "नचानुकीर्तये दद्य दत्त्वा\nअयाच्यमर्थं न च संशृणोमि।\nप्राप्यमर्थं च संश्रुत्य\nतं चापि दत्त्वा सुसुखी भवामि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026207, "chapter_id": 1560, "verse_number": "३-१९८-५", "content_sanskrit": "ददामि ते रोहिणीनां सहस्रं\nप्रियो हि मे ब्राह्मणो याचमानः।\nन मे मनः कुप्यति याचमाने\nदत्तं न शोचामि कदाचिदर्थम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026208, "chapter_id": 1560, "verse_number": "३-१९८-६", "content_sanskrit": "इत्युक्त्वा ब्राह्मणा राजा गोसहस्रं ददौ।\nप्राप्तवांश्च गवां सहस्रं ब्राह्मण इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026209, "chapter_id": 1560, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि अष्टनवत्यधिकशततमोऽध्यायः ॥ १९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]