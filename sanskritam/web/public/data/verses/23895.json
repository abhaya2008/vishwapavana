[{"id": 7003895000, "chapter_id": 23895, "verse_number": "२-७-२५-१", "content_sanskrit": "श्रुतदेव उवाच ।\nयास्तिस्रस्तिथयः पुण्या अंतिमाः शुक्लपक्षके ।\nवैशाखमासि राजेंद्र पूर्णिमांताः शुभावहाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003895001, "chapter_id": 23895, "verse_number": "२-७-२५-२", "content_sanskrit": "अन्त्याः पुष्करिणीसंज्ञाः सर्वपापक्षयावहाः ।\nमाधवे मासि यः पूर्णं स्नानं कर्त्तुं न च क्षमः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003895002, "chapter_id": 23895, "verse_number": "२-७-२५-३", "content_sanskrit": "तिथिष्वेतासु स स्नायात्पूर्ण मेव फलं लभेत् ।\nसर्वे देवास्त्रयोदश्यां स्थित्वा जंतून्पुनंति हि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003895003, "chapter_id": 23895, "verse_number": "२-७-२५-४", "content_sanskrit": "पूर्णायाः पर्वतीर्थैश्च विष्णुना सह संस्थिताः ।\nचतुर्दश्यां सयज्ञाश्च देवा एतान्पुनंति हि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003895004, "chapter_id": 23895, "verse_number": "२-७-२५-५", "content_sanskrit": "ब्रह्मघ्नं वा सुरापं वा सर्वानेतान्पुनंति हि ।\nएकादश्यां पुरा जज्ञे वैशाख्याममृतं शुभम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003895005, "chapter_id": 23895, "verse_number": "२-७-२५-६", "content_sanskrit": "द्वादश्यां पालितं तच्च विष्णुना प्रभविष्णुना ।\nत्रयोदश्यां सुधां देवान्पाययामास वै हरिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003895006, "chapter_id": 23895, "verse_number": "२-७-२५-७", "content_sanskrit": "जघान च चतुर्दश्यां दैत्यान्देवविरोधिनः ।\nपूर्णायां सर्वदेवानां साम्राज्याऽप्तिर्बभूव ह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003895007, "chapter_id": 23895, "verse_number": "२-७-२५-८", "content_sanskrit": "ततो देवाः सुसंतुष्टा एतासां च वरं ददुः ।\nतिसृणां च तिथीनां वै प्रीत्योत्फुल्लविलोचनाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003895008, "chapter_id": 23895, "verse_number": "२-७-२५-९", "content_sanskrit": "एता वैशाख मासस्य तिस्रश्च तिथयः शुभाः ।\nपुत्रपौत्रादिफलदा नराणां पापहानिदाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003895009, "chapter_id": 23895, "verse_number": "२-७-२५-१०", "content_sanskrit": "योऽस्मिन्मासे च संपूर्णे न स्नातो मनुजाधमः ।\nतिथित्रये तु स स्नात्वा पूर्णमेव फलं लभेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003895010, "chapter_id": 23895, "verse_number": "२-७-२५-११", "content_sanskrit": "तिथित्रयेप्यकुर्वाणः स्नानदानादिकं नरः ।\nचांडालीं योनिमासाद्य पश्चाद्रौरवमश्नुते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003895011, "chapter_id": 23895, "verse_number": "२-७-२५-१२", "content_sanskrit": "उष्णोदकेन यः स्नाति माधवे च तिथित्रये ।\nरौरवं नरकं याति यावदिंद्राश्चतुर्दश ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003895012, "chapter_id": 23895, "verse_number": "२-७-२५-१३", "content_sanskrit": "पितृन्देवान्समुद्दिश्य दध्यन्नं न ददाति यः ।\nपैशाचीं योनिमासाद्य तिष्ठत्याभूतसंप्लवम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003895013, "chapter_id": 23895, "verse_number": "२-७-२५-१४", "content_sanskrit": "प्रवृत्तानां च कामानां माधवे नियमे कृते ।\nअवश्यं विष्णुसायुज्यं युज्यते नाऽत्र संशयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003895014, "chapter_id": 23895, "verse_number": "२-७-२५-१५", "content_sanskrit": "आमासं नियमासक्तः कुर्याद्यदि दिनत्रये ।\nतेन पूर्णफलं प्राप्य मोदते विष्णुमंदिरे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003895015, "chapter_id": 23895, "verse_number": "२-७-२५-१६", "content_sanskrit": "यो वै देवान्पितॄन्विष्णुं गुरुमुद्दिश्य मानवः ।\nन स्नानादि करोत्यद्धाऽमुष्य शापप्रदा वयम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003895016, "chapter_id": 23895, "verse_number": "२-७-२५-१७", "content_sanskrit": "निःसंतानो निरायुश्च निःश्रेयस्को भवेदिति ।\nइति देवा वरं दत्त्वा स्वधामानि ययुः पुरा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003895017, "chapter_id": 23895, "verse_number": "२-७-२५-१८", "content_sanskrit": "तस्मात्तिथित्रयं पुण्यं सर्वाघौघविनाशनम् ।\nअंत्यं पुष्करिणीसंज्ञं पुत्रपौत्रविवर्द्धनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003895018, "chapter_id": 23895, "verse_number": "२-७-२५-१९", "content_sanskrit": "या नारी सुभगाऽपूपपायसं पूर्णिमादिने ।\nब्राह्मणाय सकृद्दद्यात्कीर्तिमंतं सुतं लभेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003895019, "chapter_id": 23895, "verse_number": "२-७-२५-२०", "content_sanskrit": "गीतापाठं तु यः कुर्यादंतिमे च दिनत्रये ।\nदिनेदिनेऽश्वमेधानां फलमेति न संशयः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003895020, "chapter_id": 23895, "verse_number": "२-७-२५-२१", "content_sanskrit": "सहस्रनामपठनं यः कुर्य्याच्च दिनत्रये ।\nतस्य पुण्यफलं वक्तुं कः शक्तो दिवि वा भुवि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003895021, "chapter_id": 23895, "verse_number": "२-७-२५-२२", "content_sanskrit": "सहस्रनामभिर्देवं पूर्णायां मधुसूदनम् ।\nपयसा स्नाप्य वै याति विष्णुलोकमकल्मषम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003895022, "chapter_id": 23895, "verse_number": "२-७-२५-२३", "content_sanskrit": "समस्तविभवैर्यस्तु पूजयेन्मधुसूदनम् ।\nन तस्य लोकाः क्षीयन्ते युग कल्पादि व्यत्यये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003895023, "chapter_id": 23895, "verse_number": "२-७-२५-२४", "content_sanskrit": "अस्नात्वा चाप्यदत्त्वा च वैशाखश्च मतो यदि ।\nस ब्रह्महा गुरुघ्नश्च पितॄणां घातकस्तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003895024, "chapter_id": 23895, "verse_number": "२-७-२५-२५", "content_sanskrit": "श्लोकार्द्धं श्लोकपादं वा नित्यं भागवतोद्भवम् ।\nवैशाखे च पठन्मर्त्यो ब्रह्मत्वं चोपपद्यते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003895025, "chapter_id": 23895, "verse_number": "२-७-२५-२६", "content_sanskrit": "यो वै भागवतं शास्त्रं शृणोत्येतद्दिनत्रये ।\nन पापैर्लिप्यते क्वाऽपि पद्मपत्रमिवांभसा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003895026, "chapter_id": 23895, "verse_number": "२-७-२५-२७", "content_sanskrit": "देवत्वं मनुजैः प्राप्तं कैश्चित्सिद्धत्वमेव च ।\nकैश्चित्प्राप्तो ब्रह्मभावो दिनत्रयनिषेवणात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003895027, "chapter_id": 23895, "verse_number": "२-७-२५-२८", "content_sanskrit": "ब्रह्मज्ञानेन वै मुक्तिः प्रयागमरणेन वा ।\nअथवा मासि वैशाखे नियमेन जलाप्लुतेः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003895028, "chapter_id": 23895, "verse_number": "२-७-२५-२९", "content_sanskrit": "नीलवृषं समुत्सृज्य वैशाख्यां च जलाप्लुतेः ।\nसमस्तबंधनिर्मुक्तः पुमान्याति परं पदम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003895029, "chapter_id": 23895, "verse_number": "२-७-२५-३०", "content_sanskrit": "गां सवत्सां द्विजेंद्राय सीदते च कुटुम्बिने ।\nइहापमृत्युनिर्मुक्तः परत्र च परं व्रजेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003895030, "chapter_id": 23895, "verse_number": "२-७-२५-३१", "content_sanskrit": "स्नानदानविहीनस्तु वैशाखी चैव यो नयेत् ।\nश्वानयोनिशतं प्राप्य विष्ठायां जायते कृमिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003895031, "chapter_id": 23895, "verse_number": "२-७-२५-३२", "content_sanskrit": "तिस्रः कोट्योऽर्धकोटिश्च तीर्थानि भुवनत्रये ।\nसंभूय मंत्रयांचक्रुः पापसंघातशंकिताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003895032, "chapter_id": 23895, "verse_number": "२-७-२५-३३", "content_sanskrit": "जना अस्मासु पापिष्ठा विसृजन्ति स्वकं मलम् ।\nतदस्माकं कथं गच्छेदिति चिंतासमन्विताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003895033, "chapter_id": 23895, "verse_number": "२-७-२५-३४", "content_sanskrit": "तीर्थपादं हरिं जग्मुः शरण्यं शरणं विभुम् ।\nस्तुत्वा च बहुभिः स्तोत्रैः प्रार्थयामासुरंजसा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003895034, "chapter_id": 23895, "verse_number": "२-७-२५-३५", "content_sanskrit": "देवदेव जगन्नाथ सर्वाघौघविनाशन ।\nजना अस्मासु पापिष्ठाः स्नात्वा पापानि सर्वशः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003895035, "chapter_id": 23895, "verse_number": "२-७-२५-३६", "content_sanskrit": "विसृज्य त्वत्पदं यांति त्वदाज्ञाधारिणो भुवि ।\nअस्माकं चैव तत्पापं कथं गच्छेज्जनार्दन ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003895036, "chapter_id": 23895, "verse_number": "२-७-२५-३७", "content_sanskrit": "तदुपायं वदास्माकं त्वत्पादशरणैषिणाम् ।\nइति तीर्थैः प्रार्थितस्तु भगवान्भूतभावनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003895037, "chapter_id": 23895, "verse_number": "२-७-२५-३८", "content_sanskrit": "प्रहसन्प्राह तीर्थानि मेघगम्भीरया गिरा ।\nश्रीभगवानुवाच ।\nसिते पक्षे मेषसूर्ये वैशाखान्तेदिनत्रये ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003895038, "chapter_id": 23895, "verse_number": "२-७-२५-३९", "content_sanskrit": "सर्वतीर्थमये पुण्ये ममाऽपि प्राणवल्लभे ।\nयूयं भगोदयात्पूर्वं बहिःसंस्थजलाप्लुताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003895039, "chapter_id": 23895, "verse_number": "२-७-२५-४०", "content_sanskrit": "विमुक्ताघाः पुण्यरूपा भवंत्वाशु सुनिर्मलाः ।\nभवद्भिश्च विमुक्ताघैर्ये न स्नाता दिनत्रये ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003895040, "chapter_id": 23895, "verse_number": "२-७-२५-४१", "content_sanskrit": "तेषु तिष्ठंतु तत्पापं जनैर्युष्मद्विरेचितम् ।\nइति तीर्थपदो विष्णुस्तीर्थानां च वरं ददौ ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003895041, "chapter_id": 23895, "verse_number": "२-७-२५-४२", "content_sanskrit": "अनुज्ञाप्य च तान्योगात्तत्रैवांतरधीयत ।\nस्वधामानि पुनः प्राप्य तानि तीर्थानि नित्यशः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003895042, "chapter_id": 23895, "verse_number": "२-७-२५-४३", "content_sanskrit": "प्रतिवर्षं तु वैशाखे तथैवांत्यदिनत्रये ।\nतेनाघौघं विमुच्यैव यांति निर्मलता महो ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003895043, "chapter_id": 23895, "verse_number": "२-७-२५-४४", "content_sanskrit": "ये तु स्नानं न कुर्वंति वैशाखांतदिनत्रये ।\nते भवन्तु समस्तानां जनानां पातकाऽश्रयाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003895044, "chapter_id": 23895, "verse_number": "२-७-२५-४५", "content_sanskrit": "इति शापं च तीर्थानि ह्यस्नातानां वदन्ति च ।\nन तेन सदृशः पापो यो न स्नातो दिनत्रये ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003895045, "chapter_id": 23895, "verse_number": "२-७-२५-४६", "content_sanskrit": "विचारितेषु शास्त्रेषु न दृष्टो न च वै श्रुतः ।\nतस्माद्दिनत्रये कार्यं स्नानदानार्चनादिकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003895046, "chapter_id": 23895, "verse_number": "२-७-२५-४७", "content_sanskrit": "अन्यथा नरकं याति यावदिंद्राश्चतुर्दश ।\nइत्येतत्सर्वमाख्यातं श्रुतकीर्ते महामते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003895047, "chapter_id": 23895, "verse_number": "२-७-२५-४८", "content_sanskrit": "पृष्टं वैशाखमाहात्म्यं यथा दृष्टं यथाश्रुतम् ।\nमाहात्म्यस्य च लेखोऽयं माधवस्य च वर्णितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003895048, "chapter_id": 23895, "verse_number": "२-७-२५-४९", "content_sanskrit": "कार्त्स्न्याद्वक्तुं च ब्रह्माऽपि नालं वर्षशतैरपि ।\nपुरा कैलासशिखरे पार्वत्यै शंकरः स्वयम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003895049, "chapter_id": 23895, "verse_number": "२-७-२५-५०", "content_sanskrit": "आह माधवमाहात्म्यं पृच्छंत्यै शतवत्सरम् ।\nतथापि नांतमगमदशक्तो विरराम ह ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003895050, "chapter_id": 23895, "verse_number": "२-७-२५-५१", "content_sanskrit": "को नु वर्णयितुं शक्तः कार्त्स्न्यान्माहात्म्यमुत्तमम् ।\nविना विष्णुं जगन्नाथं नारायणमनामयम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003895051, "chapter_id": 23895, "verse_number": "२-७-२५-५२", "content_sanskrit": "पुरा सर्वेऽपि ऋषयो माहात्म्यं पापनाशनम् ।\nलेशस्य लेशं व्याचख्युर्जनानां हितकाम्यया ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003895052, "chapter_id": 23895, "verse_number": "२-७-२५-५३", "content_sanskrit": "नांतः केनापि व्याख्यातो ह्यशक्तत्वान्महीपते ।\nत्वं च मासे तु वैशाखे कुरु दानादिसत्क्रियाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003895053, "chapter_id": 23895, "verse_number": "२-७-२५-५४", "content_sanskrit": "तेन भुक्तिं च मुक्तिं च संप्राप्नोषि न संशयः ।\nइति तं बोधयित्वा च मैथिलं जनकाह्वयम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003895054, "chapter_id": 23895, "verse_number": "२-७-२५-५५", "content_sanskrit": "श्रुतदेवस्तमामंत्र्य गन्तुं चक्रे मनस्ततः ।\nजाताह्लादः स राजर्षिर्गलद्वाष्पाकुलेक्षणः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003895055, "chapter_id": 23895, "verse_number": "२-७-२५-५६", "content_sanskrit": "उत्सवं कारयामास स्वाभिवृद्ध्यै मनोरमम् ।\nग्रामं प्रदक्षिणीकृत्य शिबिकामधिरोप्य तम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003895056, "chapter_id": 23895, "verse_number": "२-७-२५-५७", "content_sanskrit": "चतुरंगबलैर्युक्तः स्वयं पृष्ठमथाऽन्वगात् ।\nपुनश्चांतःपुरं प्राप्य सकलैर्विभवैरपि ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003895057, "chapter_id": 23895, "verse_number": "२-७-२५-५८", "content_sanskrit": "वस्त्रैराभरणैश्चैव गोभूतिलहिरण्यकैः ।\nप्रणम्य च परिक्रम्य तस्थौ प्रांजलिरग्रतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003895058, "chapter_id": 23895, "verse_number": "२-७-२५-५९", "content_sanskrit": "ततः स तु महातेजाः श्रुतदेवो महायशाः ।\nसन्तुष्टः परमप्रीतो ययौ धाम स्वकं मुनिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003895059, "chapter_id": 23895, "verse_number": "२-७-२५-६०", "content_sanskrit": "त्रयोदश्यां चतुर्दश्यां पौर्णमास्यां च माधवे ।\nस्नानं दानं पूजनं च कथाश्रवणमेव च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003895060, "chapter_id": 23895, "verse_number": "२-७-२५-६१", "content_sanskrit": "वैशाखधर्मनिरतः स वै मोक्षमवाप्नुयात् ।\nधनशर्मा ब्राह्मणश्च प्रेताश्चैव यथा पुरा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003895061, "chapter_id": 23895, "verse_number": "२-७-२५-६२", "content_sanskrit": "नारद उवाच ।\nइत्येतत्परमाख्यानमंबरीष तवोदितम् ।\nश्रवणात्सर्वपापघ्नं सर्वसंपद्विधायकम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003895062, "chapter_id": 23895, "verse_number": "२-७-२५-६३", "content_sanskrit": "तेन भुक्तिं च मुक्तिं च ज्ञानं मोक्षं च विंदति ।\nइति तस्य वचः श्रुत्वा अंवरीषो महायशाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003895063, "chapter_id": 23895, "verse_number": "२-७-२५-६४", "content_sanskrit": "प्रहृष्टांतरवृत्तिश्च बाह्यव्यापारवर्जितः ।\nप्रणनाम तथा मूर्ध्ना दण्डवत्पतितो भुवि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003895064, "chapter_id": 23895, "verse_number": "२-७-२५-६५", "content_sanskrit": "विभवैरखिलैश्चाऽपि पूजयामास तं पुनः ।\nसंपूजितस्तमामंत्र्य नारदो भगवान्मुनिः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003895065, "chapter_id": 23895, "verse_number": "२-७-२५-६६", "content_sanskrit": "लोकांतरं ययौ धीमाञ्च्छापान्नैकत्र संस्थितिः ।\nअम्बरीषोऽपि राजर्षिर्नारदोक्तानिमाञ्च्छुभान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003895066, "chapter_id": 23895, "verse_number": "२-७-२५-६७", "content_sanskrit": "धर्मान्कृत्वा विलीनोऽभूत्परे ब्रह्मणि निर्गुणे ।\nसूत उवाच ।\nय इदं परमाख्यानं पापघ्नं पुण्यवर्धनम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003895067, "chapter_id": 23895, "verse_number": "२-७-२५-६८", "content_sanskrit": "शृणुयाद्वा पठेद्वाऽपि स याति परमां गतिम् ।\nलिखितं पुस्तकं येषां गृहे तिष्ठति मानदाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003895068, "chapter_id": 23895, "verse_number": "२-७-२५-६९", "content_sanskrit": "तेषां मुक्तिः करस्था हि किमु तच्छ्रवणात्मनाम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]