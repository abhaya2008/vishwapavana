[{"id": 2017469, "chapter_id": 1363, "verse_number": "३-१-०x", "content_sanskrit": "श्रीवेदव्यासाय नमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017470, "chapter_id": 1363, "verse_number": "३-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017471, "chapter_id": 1363, "verse_number": "३-१-१x", "content_sanskrit": "जनमेजय उवाच\nएवं द्यूतजिताः पार्थाः कोपिताश्च दुरात्मभिः।\nधार्तराष्ट्रैः सहामात्यैर्निकृत्या द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017472, "chapter_id": 1363, "verse_number": "३-१-२", "content_sanskrit": "श्राविताः परुषा वाचः सृजन्तीर्वैरमुत्तमम्।\nकिमकुर्वत कौरव्या मम पूर्वपितामहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017473, "chapter_id": 1363, "verse_number": "३-१-३", "content_sanskrit": "कथं चैश्वर्यभूयिष्ठाः सहसा दुःखमेयुषः।\nवने विजह्रिरे पार्थाः शक्रप्रतिमतेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017474, "chapter_id": 1363, "verse_number": "३-१-४", "content_sanskrit": "के चैतानन्ववर्तन्त प्राप्तान्व्यसनमुत्तमम्।\nकिमाचाराः किमाहाराः क्वच वासो महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017475, "chapter_id": 1363, "verse_number": "३-१-५", "content_sanskrit": "कथं द्वादश वर्षाणि वने तेषां महात्मनाम्।\nव्यतीयुर्ब्राह्मणश्रेष्ठ शूराणामनिवर्तिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017476, "chapter_id": 1363, "verse_number": "३-१-६", "content_sanskrit": "कथं च राजपुत्री सा प्रवरा सर्वयोषिताम्।\nपतिव्रता महाभागा सततं प्रियवादिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017477, "chapter_id": 1363, "verse_number": "३-१-७", "content_sanskrit": "वनवासमदुःखार्हा दारुणं प्रत्यपद्यत।\nएतदाचक्ष्व मे सर्वं विस्तरेण तपोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017478, "chapter_id": 1363, "verse_number": "३-१-८", "content_sanskrit": "श्रोतुमिच्छामि तत्सर्वं भूरिद्रविणतेजसाम्।\nकथ्यमानं त्वया विप्र परं कौतूहलं हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017479, "chapter_id": 1363, "verse_number": "३-१-९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017480, "chapter_id": 1363, "verse_number": "३-१-९", "content_sanskrit": "एवं द्यूतजिताः पार्थाः कोयिताश्च दुरात्मभिः।\nधार्तराष्ट्रैः सहामात्यैर्निर्ययुर्गजसाह्वयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017481, "chapter_id": 1363, "verse_number": "३-१-१०", "content_sanskrit": "वर्धमानपुरद्वारादभिनिष्क्रम्य ते तदा।\nउदङ्मुखाः शस्त्रभृतः प्रययुः सह कृष्णया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017482, "chapter_id": 1363, "verse_number": "३-१-११", "content_sanskrit": "इन्द्रसेनादयश्चैतान्भृत्याः परिचतुर्दश।\nरथैरनुययुः शीघ्रैः स्त्रिय आदाय सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017483, "chapter_id": 1363, "verse_number": "३-१-१२", "content_sanskrit": "`ततस्ते पुरुषव्याघ्रा रथानास्थाय भारत।\nददृशुर्जाह्नवीतीरे प्रमाणाख्यं महावटम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017484, "chapter_id": 1363, "verse_number": "३-१-१३", "content_sanskrit": "व्रजतस्तान्विदित्वा तु पौराः शोकाभिपीडिताः।\nगर्हयन्तोऽसकृद्भीष्मविदुरद्रोणगौतमान्।\nऊचुर्वै समयं कृत्वा समागम्य परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017485, "chapter_id": 1363, "verse_number": "३-१-१४x", "content_sanskrit": "पौरा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017486, "chapter_id": 1363, "verse_number": "३-१-१४", "content_sanskrit": "नेदमस्ति कुलं सर्वं न वयं नच नो गृहाः।\nयत्रदुर्योधनः पापः सौबलेयेन पालितः।\nकर्णदुःशासनाद्यैश्च राज्यमेतच्चिकीर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017487, "chapter_id": 1363, "verse_number": "३-१-१५", "content_sanskrit": "न तत्कुलं न चाचारो न धर्मोऽर्थः कुतः सुखम्।\nयत्र पापसहायोऽयं पापो राज्यं चिकीर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017488, "chapter_id": 1363, "verse_number": "३-१-१६", "content_sanskrit": "दुर्योधनो गुरुद्वेषी त्यक्तधर्मः प्रियानृतः।\nअर्तलुब्धोऽभिमानी च नीचः प्रकृतिनिर्घृणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017489, "chapter_id": 1363, "verse_number": "३-१-१७", "content_sanskrit": "नेयमस्ति मही कृत्स्ना यत्र दुर्योधनो नृपः।\nसाधु गच्छामहे सर्वे यत्र गच्छन्ति पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017490, "chapter_id": 1363, "verse_number": "३-१-१८", "content_sanskrit": "सानुक्रोशा महात्मानो विजितेन्द्रियशत्रवः।\nहीमन्तः कीर्तिमन्तश्च धर्माचारपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017491, "chapter_id": 1363, "verse_number": "३-१-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017492, "chapter_id": 1363, "verse_number": "३-१-१९", "content_sanskrit": "एवमुक्त्वाऽनुजग्मुस्ते पाण्डवांस्तान्समेत्य च।\nऊचुः प्राञ्जलयः सर्वे तान्कुन्तीमाद्रिनन्दनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017493, "chapter_id": 1363, "verse_number": "३-१-२०", "content_sanskrit": "क्वगमिष्यथ भद्रंवस्त्यक्त्वाऽस्मान्दुःखभागिनः।\nवयमप्यनुयास्यामो यत्र यूयं गमिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017494, "chapter_id": 1363, "verse_number": "३-१-२१", "content_sanskrit": "अधर्मेण जिताञ्श्रुत्वा युष्मांस्त्यक्तघृणैः परैः।\nउद्विग्नाः स्मो भृशं सर्वे नास्मान्हातुमिहार्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017495, "chapter_id": 1363, "verse_number": "३-१-२२", "content_sanskrit": "भक्तानुरक्तान्सुहृदः सदा प्रियहिते रतान्।\nकुराजाघिष्ठिते राज्ये न विनश्येम सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017496, "chapter_id": 1363, "verse_number": "३-१-२३", "content_sanskrit": "श्रूयतां चाभिधास्यामो गुणदोषान्नरर्षभाः।\nशुभाशुभाधिवासेन संसर्गः कुरुते यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017497, "chapter_id": 1363, "verse_number": "३-१-२४", "content_sanskrit": "वस्त्रमापस्तिलान्भूमिं गन्धो वासयते यथा।\nपुष्पाणामधिवासेन तथा संसर्गजा गुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017498, "chapter_id": 1363, "verse_number": "३-१-२५", "content_sanskrit": "मोहजालस्य योनिर्हि मूढैरेव समागमः।\nअहन्यहनि धर्मस्य योनिः साधुसमागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017499, "chapter_id": 1363, "verse_number": "३-१-२६", "content_sanskrit": "तस्मात्प्राज्ञैश्च वृद्धैश्च सुस्वभावैस्तपस्विभिः।\nसद्भिश्च सह संसर्गः कार्यः शमपरायणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017500, "chapter_id": 1363, "verse_number": "३-१-२७", "content_sanskrit": "येषां त्रीण्यवदातानि विद्या योनिश्च कर्म च।\nते सेव्यास्तैः समास्याहि शास्त्रेभ्योपि गरीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017501, "chapter_id": 1363, "verse_number": "३-१-२८", "content_sanskrit": "निरारम्भा ह्यपि वयं पुण्यशीलेषु साधुषु।\nपुण्यमेवाप्नुयामेह पापं पापोपसेवनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017502, "chapter_id": 1363, "verse_number": "३-१-२९", "content_sanskrit": "असतां दर्शनात्स्पर्शात्संजल्पाच्च सहासवात्।\nधर्माचाराः प्रहीयन्ते सिद्ध्यन्ति च न मानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017503, "chapter_id": 1363, "verse_number": "३-१-३०", "content_sanskrit": "बुद्धिश्च हीयते पुंसां नीचैः सह समागमात्।\nमध्यमैर्मध्यतां याति श्रेष्ठैः श्रेष्ठत्वमाप्नुयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017504, "chapter_id": 1363, "verse_number": "३-१-३१", "content_sanskrit": "अनीचैर्नाप्यविषयैर्नाधर्मिष्ठैर्विशेषतः।\nये गुणाः कीर्तिता लोके धर्मकामार्थसंभवाः।\nलोकाचारेषु संभूता वेदोक्ताः शिष्टसंमताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017505, "chapter_id": 1363, "verse_number": "३-१-३२", "content_sanskrit": "ते युष्मासु समस्ताश्च व्यस्ताश्चैवेह सद्गुणाः।\nइच्छामो गुणवन्मध्ये वस्तुं श्रेयोभिकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017506, "chapter_id": 1363, "verse_number": "३-१-३३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017507, "chapter_id": 1363, "verse_number": "३-१-३३", "content_sanskrit": "धन्या वयं यदस्माकं स्नेहकारुण्ययन्त्रिताः।\nअसतोऽपि गुणानाहुर्ब्राह्मणप्रमुखाः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017508, "chapter_id": 1363, "verse_number": "३-१-३४", "content_sanskrit": "तदहं भ्रातृसहितः सर्वान्विज्ञापयामि वः।\nनान्यथा तद्धि कर्तव्यमस्मत्स्नेहानुकम्पया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017509, "chapter_id": 1363, "verse_number": "३-१-३५", "content_sanskrit": "भीष्मः पितामहो राजा विदुरो जननी च मे।\nसुहृज्जनश्च प्रायो मे नगरे नागसाह्वये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017510, "chapter_id": 1363, "verse_number": "३-१-३६", "content_sanskrit": "ते त्वस्मद्धितकामार्थं पालनीयाः प्रयत्नतः।\nयुष्माभिः सहिताः सर्वे शोकसंतापविह्वलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017511, "chapter_id": 1363, "verse_number": "३-१-३७", "content_sanskrit": "निवर्ततागता दूरं ममागमनकाङ्क्षिणः।\nस्वजने न्यासभूते मे कार्या स्नेहान्विता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017512, "chapter_id": 1363, "verse_number": "३-१-३८", "content_sanskrit": "एतद्धि मम कार्याणां परमं हृदि संस्थितम्।\nकृता तेन तु तुष्टिर्मे सत्कारश्च भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017513, "chapter_id": 1363, "verse_number": "३-१-३९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017514, "chapter_id": 1363, "verse_number": "३-१-३९", "content_sanskrit": "तथानुमन्त्रितास्तेन धर्मराजेन ताः प्रजाः।\nचक्रुरार्तस्वरं घोरं हा राजन्निति दुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017515, "chapter_id": 1363, "verse_number": "३-१-४०", "content_sanskrit": "गुणान्पार्थस्य संस्मृत्य दुःखार्ताः परमातुराः।\nअकामाः संन्यवर्तन्त समागम्याथ पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017516, "chapter_id": 1363, "verse_number": "३-१-४१", "content_sanskrit": "निवृत्तेषु तुं पौरेषु रथानास्थाय पाण्डवाः।\nआजग्मुर्जाह्नवीतीरे प्रमाणाख्यं महावटम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017517, "chapter_id": 1363, "verse_number": "३-१-४२", "content_sanskrit": "ते तं दिषसशेषेण वटं गत्वा तु पाण्डवाः।\nऊषुस्तां रजनीं वीराः संस्पृश्य सलिलं शुचि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017518, "chapter_id": 1363, "verse_number": "३-१-४३", "content_sanskrit": "उदकेनैव तां रात्रिमृषुस्ते दुःखकर्शिताः।\nअनुजग्मुश्च तत्रैतान्स्नेहात्केचिद्द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017519, "chapter_id": 1363, "verse_number": "३-१-४४", "content_sanskrit": "साग्रयोऽनग्नयश्चैव सशिष्यगणबान्धवाः।\nस तैः परिवृतो राजा शुशुभे ब्रह्मवादिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2017520, "chapter_id": 1363, "verse_number": "३-१-४५", "content_sanskrit": "तेषां प्रादुष्कृताग्नीनां मुहूर्ते रम्यदारुणे।\nब्रह्मघोषपुरस्कारः संजल्पः समजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2017521, "chapter_id": 1363, "verse_number": "३-१-४६", "content_sanskrit": "राजानं तु कुरुश्रेष्ठं ते हंसमधुरस्वराः।\nआश्वासयन्तो विप्राग्र्याः क्षयां सर्वां व्यनोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2017522, "chapter_id": 1363, "verse_number": "३-१-४७", "content_sanskrit": "`राजा तु भ्रातृभिः सार्धं तथा सर्वैः सुहृद्गणैः।\nअशेत तां निशांराजन्दुःखशोकसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2017523, "chapter_id": 1363, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभाते अरण्यपर्वणि किर्मीरवधपर्वणि प्रथमोऽध्यायः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]