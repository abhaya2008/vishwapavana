[{"id": 50024359, "chapter_id": 11853, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। १-४ अश्विनौ, ५-८ सविता, ९-१० अग्निः, ११ देव्यः, १२ इन्द्राणीवरुणान्यग्नाय्यः, १३-१४ द्यावापृथिव्यौ, १५ पृथिवी, १६ विष्णुर्देवा वा, १७-२१ विष्णुः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024360, "chapter_id": 11853, "verse_number": "2", "content_sanskrit": "प्रा॒त॒र्युजा॒ वि बो॑धया॒श्विना॒वेह ग॑च्छताम्। अ॒स्य सोम॑स्य पी॒तये॑॥ २२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024361, "chapter_id": 11853, "verse_number": "3", "content_sanskrit": "या सु॒रथा॑ र॒थीत॑मो॒भा दे॒वा दि॑वि॒स्पृशा॑। अ॒श्विना॒ ता ह॑वामहे॥ २२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024362, "chapter_id": 11853, "verse_number": "4", "content_sanskrit": "या वां॒ कशा॒ मधु॑म॒त्यश्वि॑ना सू॒नृता॑वती। तया॑ य॒ज्ञं मि॑मिक्षतम्॥ २२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024363, "chapter_id": 11853, "verse_number": "5", "content_sanskrit": "न॒हि वा॒मस्ति॑ दूर॒के यत्रा॒ रथे॑न॒ गच्छ॑थः। अश्वि॑ना सो॒मिनो॑ गृ॒हम्॥ २२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024364, "chapter_id": 11853, "verse_number": "6", "content_sanskrit": "हिर॑ण्यपाणिमू॒तये॑ सवि॒तार॒मुप॑ ह्वये। स चेत्ता॑ दे॒वता॑ प॒दम्॥ २२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024365, "chapter_id": 11853, "verse_number": "7", "content_sanskrit": "अ॒पां नपा॑त॒मव॑से सवि॒तार॒मुप॑ स्तुहि। तस्य॑ व्र॒तान्यु॑श्मसि॥ २२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024366, "chapter_id": 11853, "verse_number": "8", "content_sanskrit": "वि॒भ॒क्तारं॑ हवामहे॒ वसो॑श्चि॒त्रस्य॒ राध॑सः। स॒वि॒तारं॑ नृ॒चक्ष॑सम्॥ २२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024367, "chapter_id": 11853, "verse_number": "9", "content_sanskrit": "सखा॑य॒ आ नि षी॑दत सवि॒ता स्तोम्यो॒ नु न॑ः। दाता॒ राधां॑सि शुम्भति॥ २२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024368, "chapter_id": 11853, "verse_number": "10", "content_sanskrit": "अग्ने॒ पत्नी॑रि॒हा व॑ह दे॒वाना॑मुश॒तीरुप॑। त्वष्टा॑रं॒ सोम॑पीतये॥ २२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024369, "chapter_id": 11853, "verse_number": "11", "content_sanskrit": "आ ग्ना अ॑ग्न इ॒हाव॑से॒ होत्रां॑ यविष्ठ॒ भार॑तीम्। वरू॑त्रीं धि॒षणां॑ वह॥ २२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024370, "chapter_id": 11853, "verse_number": "12", "content_sanskrit": "अ॒भि नो॑ दे॒वीरव॑सा म॒हः शर्म॑णा नृ॒पत्नी॑ः। अच्छि॑न्नपत्राः सचन्ताम्॥ २२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024371, "chapter_id": 11853, "verse_number": "13", "content_sanskrit": "इ॒हेन्द्रा॒णीमुप॑ ह्वये वरुणा॒नीं स्व॒स्तये॑। अ॒ग्नायीं॒ सोम॑पीतये॥ २२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50024372, "chapter_id": 11853, "verse_number": "14", "content_sanskrit": "म॒ही द्यौः पृ॑थि॒वी च॑ न इ॒मं य॒ज्ञं मि॑मिक्षताम्। पि॒पृ॒तां नो॒ भरी॑मभिः॥ २२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50024373, "chapter_id": 11853, "verse_number": "15", "content_sanskrit": "तयो॒रिद्घृ॒तव॒त्पयो॒ विप्रा॑ रिहन्ति धी॒तिभि॑ः। ग॒न्ध॒र्वस्य॑ ध्रु॒वे प॒दे॥ २२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50024374, "chapter_id": 11853, "verse_number": "16", "content_sanskrit": "स्यो॒ना पृ॑थिवि भवानृक्ष॒रा नि॒वेश॑नी। यच्छा॑ न॒ः शर्म॑ स॒प्रथ॑ः॥ २२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50024375, "chapter_id": 11853, "verse_number": "17", "content_sanskrit": "अतो॑ दे॒वा अ॑वन्तु नो॒ यतो॒ विष्णु॑र्विचक्र॒मे। पृ॒थि॒व्याः स॒प्त धाम॑भिः॥ २२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50024376, "chapter_id": 11853, "verse_number": "18", "content_sanskrit": "इ॒दं विष्णु॒र्वि च॑क्रमे त्रे॒धा नि द॑धे प॒दम्। समू॑ळ्हमस्य पांसु॒रे॥ २२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50024377, "chapter_id": 11853, "verse_number": "19", "content_sanskrit": "त्रीणि॑ प॒दा वि च॑क्रमे॒ विष्णु॑र्गो॒पा अदा॑भ्यः। अतो॒ धर्मा॑णि धा॒रय॑न्॥ २२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50024378, "chapter_id": 11853, "verse_number": "20", "content_sanskrit": "विष्णो॒ः कर्मा॑णि पश्यत॒ यतो॑ व्र॒तानि॑ पस्प॒शे। इन्द्र॑स्य॒ युज्य॒ः सखा॑॥ २२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50024379, "chapter_id": 11853, "verse_number": "21", "content_sanskrit": "तद्विष्णो॑ः पर॒मं प॒दं सदा॑ पश्यन्ति सू॒रय॑ः। दि॒वी॑व॒ चक्षु॒रात॑तम्॥ २२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50024380, "chapter_id": 11853, "verse_number": "22", "content_sanskrit": "तद्विप्रा॑सो विप॒न्यवो॑ जागृ॒वांस॒ः समि॑न्धते। विष्णो॒र्यत्प॑र॒मं प॒दम्॥ २२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]