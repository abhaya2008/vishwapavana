[{"id": 2168119, "chapter_id": 4607, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2168120, "chapter_id": 4607, "verse_number": "१", "content_sanskrit": "श्वेताश्वोऽपि महाराज व्यधमत् तावकं बलम् ।\nयथा वायुः समासाद्य तूलराशिं समन्ततः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2168121, "chapter_id": 4607, "verse_number": "२", "content_sanskrit": "प्रत्युद्ययुस्त्रिगर्तास्तं शिबयः सह कौरवैः ।\nवसातयोऽथ साल्वाश्च गोपालाश्च यशस्विनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2168122, "chapter_id": 4607, "verse_number": "३", "content_sanskrit": "सत्यदेवः सत्यकीर्तिर्मित्रदेवः श्रुतञ्जयः ।\nसौश्रुतिश्चन्द्रदेवश्च मित्रशर्मा च भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2168123, "chapter_id": 4607, "verse_number": "४", "content_sanskrit": "त्रिगर्तराजः समरे भ्रातृभिः परिवारितः ।\nपुत्रैश्चैव महेष्वासैर्नानाशस्त्रधरैर्युधि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2168124, "chapter_id": 4607, "verse_number": "५", "content_sanskrit": "ते सृजन्तः शरान् घोरान् किरन्तोऽर्जुनमाहवे ।\nअभ्यवर्तन्त सहसा वार्यौघ इव सागरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2168125, "chapter_id": 4607, "verse_number": "६", "content_sanskrit": "ते त्वर्जुनं समासाद्य योधाः शतसहस्रशः ।\nअगच्छन् विलयं सर्वे तार्क्ष्यं दृष्ट्वेव पन्नगाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2168126, "chapter_id": 4607, "verse_number": "७", "content_sanskrit": "ते वध्यमानाः समरे न जहुः पाण्डवं तदा ।\nदह्यमाना महाराज शलभा इव पावकम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2168127, "chapter_id": 4607, "verse_number": "८", "content_sanskrit": "सत्यदेवस्त्रिभिर्बाणैर्विव्याध युधि पाण्डवम् ।\nमित्रदेवस्त्रिषष्ट्या च चन्द्रदेवश्च सप्तभिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2168128, "chapter_id": 4607, "verse_number": "९", "content_sanskrit": "मित्रवर्मा त्रिसप्तत्या सौश्रुतिश्चापि पञ्चभिः ।\nश्रुतञ्जयश्च विंशत्या सुशर्मा नवभिः शरैः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2168129, "chapter_id": 4607, "verse_number": "१०", "content_sanskrit": "स विद्धो बहुभिः सङ्खे प्रतिविव्याध तान् नृपान् ।\nसौश्रुतिं पञ्चविंशत्या सत्यदेवं त्रिभिः शरैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2168130, "chapter_id": 4607, "verse_number": "११", "content_sanskrit": "मित्रदेवं शतेनैव चन्द्रदेवं तथाऽष्टभिः ।\nअष्टाभिर्मित्रवर्माणं सुशर्माणं तथैव च\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2168131, "chapter_id": 4607, "verse_number": "१२", "content_sanskrit": "श्रुतञ्जयं च राजानं हत्वा तत्र शिलाशितैः ।\nसौश्रुतेः सशिरस्त्राणं शिरः कायादपाहरत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2168132, "chapter_id": 4607, "verse_number": "१३", "content_sanskrit": "त्वरितं चन्द्रदेवं च शरैर्निन्ये यमक्षयम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2168133, "chapter_id": 4607, "verse_number": "१४", "content_sanskrit": "अथेतरान् महाराज यतमानान् महारथान् ।\nपञ्चभिः पञ्चभिर्बाणैरेकैकं प्रत्यताडयत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2168134, "chapter_id": 4607, "verse_number": "१५", "content_sanskrit": "सत्यदेवस्तु सङ्क्रुद्धस्तोमरं ससृजे शितम् ।\nसमुद्दिश्य रणे कृष्णं सिंहनादं ननाद च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2168135, "chapter_id": 4607, "verse_number": "१६", "content_sanskrit": "स निर्भिद्य भुजं सव्यं माधवस्य महात्मनः ।\nअयस्मयः स्वर्णदण्डो जगाम धरणीतळम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2168136, "chapter_id": 4607, "verse_number": "१७", "content_sanskrit": "माधवस्य तु विद्धस्य तोमरेण महारणे ।\nप्रतोदो न्यपतद् हस्ताद् रश्मयश्च विशाम्पते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2168137, "chapter_id": 4607, "verse_number": "१८", "content_sanskrit": "विष्वक्सेनं सुनिर्विद्धं दृष्ट्वा पार्थो धनञ्जयः ।\nक्रोधमाहारयत् तीव्रं कृष्णं चेदमुवाच ह\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2168138, "chapter_id": 4607, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2168139, "chapter_id": 4607, "verse_number": "१९", "content_sanskrit": "चोदयाश्वान् महाबाहो सत्यदेवरथं प्रति ।\nयावदेनं शरैस्तीक्ष्णैः यामि यमसादनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2168140, "chapter_id": 4607, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2168141, "chapter_id": 4607, "verse_number": "२०", "content_sanskrit": "प्रतोदं गृह्य सोऽन्यत् तु रश्मीन् सङ्गृह्य च द्रुतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2168142, "chapter_id": 4607, "verse_number": "", "content_sanskrit": "(ततः स चोदयामास सत्यदेवरथं प्रति ।\nअथ दिव्यास्त्रविच्छूरो जातमन्युर्धनञ्जयः\t॥२१॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2168143, "chapter_id": 4607, "verse_number": "२२", "content_sanskrit": "विष्वक्सेनं तु निर्भिण्णं दृष्ट्वा पार्थो धनञ्जयः ।\nसत्यदेवं शरैस्तीक्ष्णैर्वारयित्वा महाबलः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2168144, "chapter_id": 4607, "verse_number": "२३", "content_sanskrit": "ततः सुनिशितैर्भल्लै राजंस्तस्य महात्मनः ।\nकुण्डलोपचितं कायाच्चकर्त प्रहसन् शिरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2168145, "chapter_id": 4607, "verse_number": "२४", "content_sanskrit": "तं निहत्य शितैर्बाणैर्मित्रवर्माणमाक्षिपत् ।\nवत्सदन्तेन तीक्ष्णेन सारथिं चास्य मारिष\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2168146, "chapter_id": 4607, "verse_number": "२५", "content_sanskrit": "ततः शरशतैर्भूयः संशप्तकगणान् बहून् ।\nपातयामास सङ्क्रुद्धः शतशोऽथ सहस्रशः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2168147, "chapter_id": 4607, "verse_number": "२६", "content_sanskrit": "ततो रजतपुङ्खेन राजन् शीर्षं महात्मनः ।\nमित्रसेनस्य चिच्छेद क्षुरप्रेण महायशाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2168148, "chapter_id": 4607, "verse_number": "", "content_sanskrit": "सुशर्माणं सुसङ्क्रुद्धो जत्रुदेशे समर्पयत् ।\n(नाराचेन सुमुक्तेन सुतीक्ष्णेन महायशाः\t॥२७॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2168149, "chapter_id": 4607, "verse_number": "२८", "content_sanskrit": "ततः संशप्तकाः सर्वे परिवार्य धनञ्जयम् ।\nशस्त्रौघैर्ममृदुः क्रुद्धा नादयन्तो दिशो दश\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2168150, "chapter_id": 4607, "verse_number": "२९", "content_sanskrit": "स तैरभ्यर्दितो जिष्णुः शक्रतुल्यपराक्रमः ।\nऐन्द्रमस्त्रममेयात्मा प्रादुश्चक्रे महारथः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2168151, "chapter_id": 4607, "verse_number": "३०", "content_sanskrit": "ततः शरसहस्राणि प्रादुरासन् विशाम्पते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2168152, "chapter_id": 4607, "verse_number": "३१", "content_sanskrit": "(कार्मुकात् पाण्डुपुत्रस्य पार्थस्यामिततेजसः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2168153, "chapter_id": 4607, "verse_number": "३२", "content_sanskrit": "ततस्तु च्छिद्यमानानां ध्वजानां धनुषां तथा ।)\nरथानां सपताकानां तूणीराणां युगैः सह\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2168154, "chapter_id": 4607, "verse_number": "३३", "content_sanskrit": "अक्षाणामथ चक्राणां योक्त्राणां रश्मिभिः सह ।\nकूबराणां वरूथानां पृषत्कानां च संयुगे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2168155, "chapter_id": 4607, "verse_number": "३४", "content_sanskrit": "अश्वानां पततां चापि प्रासानामसिचर्मणाम् ।\nगदानां परिघानां च शक्तीनां तोमरैः सह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2168156, "chapter_id": 4607, "verse_number": "३५", "content_sanskrit": "शतघ्नीनां सचक्राणां भुजानां चोरुभिः सह ।\nकण्ठसूत्राङ्गदानां च केयूराणां च मारिष\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2168157, "chapter_id": 4607, "verse_number": "", "content_sanskrit": "(हाराणां हेमसूत्राणां कटकानां च भारत ।\nछत्राणां मकुटानां च व्यजनानां महात्मनाम्\t॥३६॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2168158, "chapter_id": 4607, "verse_number": "३७", "content_sanskrit": "अश्रूयत महाशब्दः तत्रतत्र विशाम्पते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2168159, "chapter_id": 4607, "verse_number": "३८", "content_sanskrit": "राशयश्चात्र दृश्यन्ते पतितानां महीतळे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2168160, "chapter_id": 4607, "verse_number": "३९", "content_sanskrit": "सकुण्डलानि स्रग्वीणि पूर्णचन्द्रनिभानि च ।\nशिरांस्युर्व्यामदृश्यन्त तारागण इवाम्बरे\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2168161, "chapter_id": 4607, "verse_number": "४०", "content_sanskrit": "सुखार्हाणि सुवासांसि चन्दनेनोक्षितानि च ।\nशरीराणि व्यदृश्यन्त निहतानां महीतळे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2168162, "chapter_id": 4607, "verse_number": "४१", "content_sanskrit": "रुद्रस्याक्रीडसदृशं घोरमायोधनं तदा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2168163, "chapter_id": 4607, "verse_number": "", "content_sanskrit": "निहतै राजपुत्रैश्च क्षत्रियैश्च महाबलैः ।\n(अर्जुनेन महाराज तत्र तत्र महारणे\t॥४२॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2168164, "chapter_id": 4607, "verse_number": "४३", "content_sanskrit": "हस्तिभिः पतितैश्चैव तुरङ्गैश्चाभवन्मही ।\nअगम्यरूपा समरे विशीर्णैरिव पर्वतैः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2168165, "chapter_id": 4607, "verse_number": "४४", "content_sanskrit": "नासीद्रथपथस्तस्य पाण्डवस्य महात्मनः ।\nनिघ्नतः शात्रवान् भल्लैर्हस्त्यश्वं चामितं महत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2168166, "chapter_id": 4607, "verse_number": "४५", "content_sanskrit": "(आर्तवच्चावसीदन्ति रथचक्राणि मारिष ।)\nरणे विचरतस्तस्य तस्मिन् लोहितकर्दमे\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2168167, "chapter_id": 4607, "verse_number": "४६", "content_sanskrit": "सीदमाने तु चक्रे ते समूहुस्तुरगा भृशम् ।\nश्रमेण महता युक्ता मनोमारुतरंहसः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2168168, "chapter_id": 4607, "verse_number": "४७", "content_sanskrit": "वध्यमानं तु तत्सैन्यं पाण्डुपुत्रेण धन्विना ।\nप्रायशो विमुखं सैन्यं नावतिष्ठत संयुगे\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2168169, "chapter_id": 4607, "verse_number": "४८", "content_sanskrit": "तान् जित्वा समरे जिष्णुः संशप्तकगणान् बहून् ।\nरराज स महाराज विधूमोऽग्निरिव ज्वलन्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2168170, "chapter_id": 4607, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nसंशप्तकयुद्धं नाम सप्तविंशोऽध्यायः ॥२७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]