[{"id": 900009432, "chapter_id": 8744, "verse_number": "2.1", "content_sanskrit": "नन्वेतदयुक्तम् । द्विविधं हि वेदान्तवाक्यम् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009433, "chapter_id": 8744, "verse_number": "2.2", "content_sanskrit": "आद्यानुमाने चाप्रसिद्धविशेषणत्वं प्रत्यक्षादिनापीदमित्थमिति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009434, "chapter_id": 8744, "verse_number": "2.3", "content_sanskrit": "दृष्टान्तस्य साध्यवैकल्यं च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009435, "chapter_id": 8744, "verse_number": "2.4", "content_sanskrit": "तत्र यदि प्रष्ट्रा व्यावृत्तिवैशिष्ट्यमेव साक्षाद्बुभुत्सितम्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009436, "chapter_id": 8744, "verse_number": "2.5", "content_sanskrit": "तथा द्वितीयमपि अप्रसिद्धविशेषणत्व-बाध..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009437, "chapter_id": 8744, "verse_number": "2.6", "content_sanskrit": "किञ्चाप्रयोजका हेतवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009438, "chapter_id": 8744, "verse_number": "2.7", "content_sanskrit": "प्रतिकूलतर्कपराहतिश्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009439, "chapter_id": 8744, "verse_number": "2.8", "content_sanskrit": "पदान्तरवैयर्थ्यं च स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009440, "chapter_id": 8744, "verse_number": "2.9", "content_sanskrit": "‘नवीनास्तु गम्भीरायां नद्यां घोषः’ इत्यत्र ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009441, "chapter_id": 8744, "verse_number": "2.10", "content_sanskrit": "अपि च सत्यानन्दादिपदलक्ष्यत्वे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009442, "chapter_id": 8744, "verse_number": "2.11", "content_sanskrit": "तत्त्वमस्यादिवाक्यस्याऽखण्डार्थत्वानुमाने अप्ययुक्ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009443, "chapter_id": 8744, "verse_number": "2.12", "content_sanskrit": "किञ्च त्वन्मते सोऽयं देवदत्त इति वाक्यस्य किं देवदत्तस्वरूपमात्रे तात्पर्यम् ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009444, "chapter_id": 8744, "verse_number": "2.13", "content_sanskrit": "तथा हि– ब्रह्मणो धर्माः किं साधकाभावान्न सन्ति ? उत बाधकसद्भावात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009445, "chapter_id": 8744, "verse_number": "2.14", "content_sanskrit": "किञ्च तद्विरोधेऽपि श्रुतेर्नातात्त्विकविषयता युक्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009446, "chapter_id": 8744, "verse_number": "2.15", "content_sanskrit": "किञ्च ‘आत्मेत्येवोपासीत’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009447, "chapter_id": 8744, "verse_number": "2.16", "content_sanskrit": "नापि बाधकसद्भावादिति द्वितीयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009448, "chapter_id": 8744, "verse_number": "2.17", "content_sanskrit": "निर्गुणे प्रमाणभङ्गः– किञ्च निर्विशेषे किं प्रमाणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009449, "chapter_id": 8744, "verse_number": "2.18", "content_sanskrit": "एतेन ब्रह्मणो निराकारत्वमपि निरस्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009450, "chapter_id": 8744, "verse_number": "2.19", "content_sanskrit": "यच्चेदमुच्यते– ब्रह्म ज्ञानानन्दात्मकम् अद्वितीयं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009451, "chapter_id": 8744, "verse_number": "2.20", "content_sanskrit": "यच्चेदमुच्यते ‘ब्रह्म जगत उपादानत्वे सति कर्तृ’ इत्यभिन्ननिमित्तोपादानं जगदिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009452, "chapter_id": 8744, "verse_number": "2.21", "content_sanskrit": "किञ्चेदं कर्तृत्वं किं परिभाषया शुक्त्यादिवदधिष्ठानत्वमात्रम्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900009453, "chapter_id": 8744, "verse_number": "2.22", "content_sanskrit": "किञ्चोपादानत्वे न तावत् ‘आत्मन आकाशः सम्भूतः’ ‘यतो वा’ इत्यादि पञ्चमी-श्रुतिर्मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900009454, "chapter_id": 8744, "verse_number": "2.23", "content_sanskrit": "नापि ‘सर्वाणि ह वा इमानि भूतानि आकाशादेव समुत्पद्यन्ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900009455, "chapter_id": 8744, "verse_number": "2.24", "content_sanskrit": "यच्चेदमुच्यते– ब्रह्म न वेद्यं स्वप्रकाशत्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900009456, "chapter_id": 8744, "verse_number": "2.25", "content_sanskrit": "यच्चानुभूतित्वहेतौ साध्यप्रसिद्ध्यर्थं धर्मत्वादित्यनुमानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900009457, "chapter_id": 8744, "verse_number": "2.26", "content_sanskrit": "न च ज्ञानस्य स्वस्मादन्यत्र व्यवहारादिजनने तद्विषयत्वं तन्त्रम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900009458, "chapter_id": 8744, "verse_number": "2.27", "content_sanskrit": "यच्चेदमुच्यते ब्रह्म सर्वशब्दावाच्यमिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900009459, "chapter_id": 8744, "verse_number": "2.28", "content_sanskrit": "यच्चेदमुच्यते– भेदः किं स्वरूपं, धर्मो वा ? नाद्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900009460, "chapter_id": 8744, "verse_number": "2.29", "content_sanskrit": "सम्भवति च भेदस्य स्वरूपत्वेन निर्वाहः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900009461, "chapter_id": 8744, "verse_number": "2.30", "content_sanskrit": "ननु तथापि विदारणात्मनो भेदस्य घटस्वरूपत्वे घटस्यापि विदारणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900009462, "chapter_id": 8744, "verse_number": "2.31", "content_sanskrit": "तत्र गत्यन्तराभावादैक्यस्य स्वरूपत्वं सिद्धमित्यपर्यायत्वादिकं कथञ्चिन्निर्वाह्यमिति चेद्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900009463, "chapter_id": 8744, "verse_number": "2.32", "content_sanskrit": "किञ्च–अन्यत्वाग्रहणे प्रोक्तः कथमन्योन्यसंश्रयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900009464, "chapter_id": 8744, "verse_number": "2.33", "content_sanskrit": "वस्तुतस्त्वस्मन्मते भेदो वस्तुना सविशेषाभिन्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900009465, "chapter_id": 8744, "verse_number": "2.34", "content_sanskrit": "ननु तथापि न तावज्जीवेश्वरभेदे प्रत्यक्षं मानम्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900009466, "chapter_id": 8744, "verse_number": "2.35", "content_sanskrit": "सन्त्यनुमानानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900009467, "chapter_id": 8744, "verse_number": "2.36", "content_sanskrit": "जीवानामन्योन्यं भेदे तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900009468, "chapter_id": 8744, "verse_number": "2.37", "content_sanskrit": "आत्माभेदे त्वन्योन्यं सुखदुःखाद्यनुसन्धानं स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900009469, "chapter_id": 8744, "verse_number": "2.38", "content_sanskrit": "जडेशभेदे जडजीवभेदे च ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900009470, "chapter_id": 8744, "verse_number": "2.39", "content_sanskrit": "किञ्च ‘द्वा सुपर्णा’ ‘य आत्मनि तिष्ठन्’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900009471, "chapter_id": 8744, "verse_number": "2.40", "content_sanskrit": "न चाननुवादकत्वेऽपि बाध्यव्यावहारिकभेदपरा श्रुतिः, अप्रामाण्यापातात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900009472, "chapter_id": 8744, "verse_number": "2.41", "content_sanskrit": "किञ्च पूर्वतन्त्रे द्वितीयाध्याये यैः शब्दान्तरादिभिः कर्मभेद उक्तः, तैरेव जीवेश्वरभेदसिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900009473, "chapter_id": 8744, "verse_number": "2.42", "content_sanskrit": "सन्ति च भेदश्रुतेरपि षड्विधतात्पर्यलिङ्गानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900009474, "chapter_id": 8744, "verse_number": "2.43", "content_sanskrit": "किञ्च तिष्ठतु भेदः । ऐक्यम् (१) किमात्मस्वरूपम् ? (२) उतान्यत् ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900009475, "chapter_id": 8744, "verse_number": "2.44", "content_sanskrit": "यच्चेदमुच्यते जीवब्रह्माभेदे ‘तत्त्वमसि’ इत्यादिश्रुतिर्मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900009476, "chapter_id": 8744, "verse_number": "2.45", "content_sanskrit": "किञ्च त्वन्मते पदद्वये लक्षणा, ततो वरं मद्रीत्यैकस्मिंस्तत्पदे त्वंपदे वाऽमुख्य-वृत्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900009477, "chapter_id": 8744, "verse_number": "2.46", "content_sanskrit": "केचित्तु शरीरवाचिनां देवमनुष्यादिशब्दानां शरीरिपर्यन्तत्वदर्शनात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900009478, "chapter_id": 8744, "verse_number": "2.47", "content_sanskrit": "एतेन ‘अहं ब्रह्मास्मि’ इत्याद्यपि व्याख्यातम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 900009479, "chapter_id": 8744, "verse_number": "2.48", "content_sanskrit": "नाप्यनुमानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 900009480, "chapter_id": 8744, "verse_number": "2.49", "content_sanskrit": "न च ‘अंशो ह्येष परमस्य’ ‘पादोऽस्य विश्वा भूतानि’ इति श्रुतौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 900009481, "chapter_id": 8744, "verse_number": "2.50", "content_sanskrit": "नापि जीवब्रह्मणोर्बिम्बप्रतिबिम्बत्वान्मुखप्रतिमुखवदैक्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 900009482, "chapter_id": 8744, "verse_number": "2.51", "content_sanskrit": "अणुत्वाच्च जीवो व्याप्तादीशाद्भिन्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]