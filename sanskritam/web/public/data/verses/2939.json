[{"id": 2091268, "chapter_id": 2939, "verse_number": "१३-६९-१", "content_sanskrit": "भीष्म उवाच।\nब्राह्मणानेव सततं भृशं सम्परिपूजयेत्।\nएते हि सोमराजान ईश्वरः सुखदुःखयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091269, "chapter_id": 2939, "verse_number": "१३-६९-२", "content_sanskrit": "एते भोगैरलङ्कारैरन्यैश्चैव किमिच्छकैः।\nसदा पूज्या नमस्कारै रक्ष्याश्च पितृवन्नृपैः।\nततो राष्ट्राय शान्तिर्हि भूतानामिव वासवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091270, "chapter_id": 2939, "verse_number": "१३-६९-३", "content_sanskrit": "ज्ञानवान्ब्रह्मवर्चस्वी राष्ट्रे वै ब्राह्मणः शुचिः।\nमहारथश्च राजन्य एष्टव्यः शत्रुतापनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091271, "chapter_id": 2939, "verse_number": "१३-६९-४", "content_sanskrit": "ब्राह्मणं जातिसम्पन्नं धर्मज्ञं संशितव्रतम्।\nबोजयीत गृहे राजन्न तस्मात्परमस्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091272, "chapter_id": 2939, "verse_number": "१३-६९-५", "content_sanskrit": "ब्राह्मणेभ्यो हविर्दत्तं प्रतिगृह्णन्ति देवताः।\nपितरः सर्वभूतानां नैतेभ्यो विद्यते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091273, "chapter_id": 2939, "verse_number": "१३-६९-६", "content_sanskrit": "आदित्यश्चन्द्रमा विष्णुः सङ्करोऽग्निः प्रजापतिः।\nसर्वे ब्राह्मणमाविश्य सदाऽन्नमुपभुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091274, "chapter_id": 2939, "verse_number": "१३-६९-७", "content_sanskrit": "न तस्याश्नन्ति पितरो यस्य विप्रा न भुञ्जते।\nदेवाश्चाप्यस्य नाश्नन्ति पापस्य ब्राह्मणद्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091275, "chapter_id": 2939, "verse_number": "१३-६९-८", "content_sanskrit": "ब्राह्मणेषु तु तुष्टेषु प्रीयन्ते पितरः सदा।\nतथैव देवता राजन्नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091276, "chapter_id": 2939, "verse_number": "१३-६९-९", "content_sanskrit": "तथैव तेऽपि प्रीयन्ते येषां भवति तद्धविः।\nन च प्रेत्य विनश्यन्ति गच्छन्ति च परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091277, "chapter_id": 2939, "verse_number": "१३-६९-१०", "content_sanskrit": "येनयेनैव प्रीयन्ते पितरो देवतास्तथा॥\nतेनतेनैव प्रीयन्ते पितरो देवतास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091278, "chapter_id": 2939, "verse_number": "१३-६९-११", "content_sanskrit": "ब्राह्मणादेव तद्भूतं प्रभवन्ति यतः प्रजाः।\nयतश्चायं प्रभवति प्रेत्य यत्र च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091279, "chapter_id": 2939, "verse_number": "१३-६९-१२", "content_sanskrit": "वेदैष मार्गं स्वर्गस्य तथैव नरकस्य च।\nआगतानागते चोमे ब्राह्मणो द्विपदांवरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091280, "chapter_id": 2939, "verse_number": "१३-६९-१३", "content_sanskrit": "ब्राह्मणो द्विपदां श्रेष्ठः स्वधर्मं चैव वेद यः।\nये चैनमनुवर्तन्ते ते न यान्ति पराभवम्।\nन ते प्रेत्य विनश्यन्ति गच्छन्ति न पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091281, "chapter_id": 2939, "verse_number": "१३-६९-१४", "content_sanskrit": "यद्ब्राह्मणमुखात्प्राप्तं प्रतिगृह्णन्ति वै वचः।\nकृतात्मानो महात्मानस्ते न यान्ति पराभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091282, "chapter_id": 2939, "verse_number": "१३-६९-१५", "content_sanskrit": "क्षत्रियाणां प्रतपतां तेजसा च बलेन च।\nब्राह्मणेष्वेव शाम्यन्ति तेजांसि च बलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091283, "chapter_id": 2939, "verse_number": "१३-६९-१६", "content_sanskrit": "भृगवस्तालजङ्घांश्च नीपानाङ्गिरसोऽजयन्।\nभरद्वाजो वैतहव्यानैलांश्च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091284, "chapter_id": 2939, "verse_number": "१३-६९-१७", "content_sanskrit": "चित्रायुधांश्चाप्यजयन्नेते कृष्णाजिनध्वजाः।\nप्रक्षिप्याथ च कुम्भान्वै पारगामिनमारभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091285, "chapter_id": 2939, "verse_number": "१३-६९-१८", "content_sanskrit": "यत्किंचित्कथ्यते लोके श्रूयते पठ्यतेऽपि वा।\nसर्वं तद्ब्राह्मणेष्वेव गूढोऽग्निरिव दारुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091286, "chapter_id": 2939, "verse_number": "१३-६९-१९", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nसंवादं वासुदेवस्य पृथ्व्याश्च भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091287, "chapter_id": 2939, "verse_number": "१३-६९-२०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091288, "chapter_id": 2939, "verse_number": "१३-६९-२०", "content_sanskrit": "मातरं सर्वभूतानां पृच्छे त्वां संशयं शुभे।\nकेनस्वित्कर्मणा पापं व्यपोहति नरो गृही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091289, "chapter_id": 2939, "verse_number": "१३-६९-२१x", "content_sanskrit": "पृथिव्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091290, "chapter_id": 2939, "verse_number": "१३-६९-२१", "content_sanskrit": "ब्राह्मणानेव सेवेत पवित्रं ह्येतदुत्तमम्।\nब्राह्मणान्सेवमानस्य रजः सर्वं प्रणश्यति।\nभूतो भूतिरतः कीर्तिरतो बुद्धिः प्रजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091291, "chapter_id": 2939, "verse_number": "१३-६९-२२", "content_sanskrit": "महारथश्च राजन्य एष्टव्यः शत्रुतापनः।\nइति मां नारदः प्राह सततं सर्वभूतये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091292, "chapter_id": 2939, "verse_number": "१३-६९-२३", "content_sanskrit": "ब्राह्मणं जातिसम्पन्नं धर्मज्ञं संशितं शुचिम्।\nअपरेषां परेषां च परेभ्यश्चैव ये परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091293, "chapter_id": 2939, "verse_number": "१३-६९-२४", "content_sanskrit": "ब्राह्मणा यं प्रशंसन्ति स मनुष्यः प्रवर्धते।\nअथ यो ब्राह्मणान्क्रुष्टः पराभवति सोचिरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091294, "chapter_id": 2939, "verse_number": "१३-६९-२५", "content_sanskrit": "यथा महार्णवे क्षिप्त आमलोष्टो विनश्यति।\nतथा दुश्चरितं विप्रे पराभावाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091295, "chapter_id": 2939, "verse_number": "१३-६९-२६", "content_sanskrit": "पश्य चन्द्रे कृतं लक्ष्म समुद्रे लवणोदकम्।\nतथा भगसहस्रेण महेन्द्रः परिचिह्नितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091296, "chapter_id": 2939, "verse_number": "१३-६९-२७", "content_sanskrit": "तेषामेव प्रभावेन सहस्रनयनो ह्यसौ।\nशतक्रतुः समभवत्पश्य माधव यादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091297, "chapter_id": 2939, "verse_number": "१३-६९-२८", "content_sanskrit": "इच्छन्कीर्तिं च भूतिं च लोकांश्च मधुसूदन।\nब्राह्मणानुमते तिष्ठेत्पुरुषः शुचिरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091298, "chapter_id": 2939, "verse_number": "१३-६९-२९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091299, "chapter_id": 2939, "verse_number": "१३-६९-२९", "content_sanskrit": "इत्येतद्वचनं श्रुत्वा मेदिन्या मधूसूदनः।\nसाधुसाध्विति कौरव्य मेदिनीं प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091300, "chapter_id": 2939, "verse_number": "१३-६९-३०", "content_sanskrit": "एतां श्रुत्वोपमां पार्थ प्रयतो ब्राह्मणर्षभान्।\nसततं पूजयेथास्त्वं ततः श्रेयोऽभिपत्स्यसे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091301, "chapter_id": 2939, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनसप्ततितमोऽध्यायः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]