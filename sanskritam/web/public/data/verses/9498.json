[{"id": 5000498000, "chapter_id": 9498, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000498001, "chapter_id": 9498, "verse_number": "६-९१-१", "content_sanskrit": "रुधिरक्लिन्नगात्रस्तु लक्ष्मणः शुभलक्षणः।\nबभूव हृष्टस्तं हत्वा शत्रुजेतारमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000498002, "chapter_id": 9498, "verse_number": "६-९१-२", "content_sanskrit": "ततः स जाम्बवन्तं च हनूमन्तं च वीर्यवान्।\nसंनिपत्य महातेजास्तांश्च सर्वान् वनौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000498003, "chapter_id": 9498, "verse_number": "६-९१-३", "content_sanskrit": "आजगाम ततः शीघ्रं यत्र सुग्रीवराघवौ।\nविभीषणमवष्टभ्य हनूमन्तं च लक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000498004, "chapter_id": 9498, "verse_number": "६-९१-४", "content_sanskrit": "ततो राममभिक्रम्य सौमित्रिरभिवाद्य च।\nतस्थौ भ्रातृसमीपस्थः शक्रस्येन्द्रानुजो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000498005, "chapter_id": 9498, "verse_number": "६-९१-५", "content_sanskrit": "निष्टनन्निव चागत्य राघवाय महात्मने।\nआचचक्षे तदा वीरो घोरमिन्द्रजितो वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000498006, "chapter_id": 9498, "verse_number": "६-९१-६", "content_sanskrit": "रावणेस्तु शिरश्छिन्नं लक्ष्मणेन महात्मना।\nन्यवेदयत रामाय तदा हृष्टो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000498007, "chapter_id": 9498, "verse_number": "६-९१-७", "content_sanskrit": "श्रुत्वैव तु महावीर्यो लक्ष्मणेनेन्द्रजिद्वधम्।\nप्रहर्षमतुलं लेभे वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000498008, "chapter_id": 9498, "verse_number": "६-९१-८", "content_sanskrit": "साधु लक्ष्मण तुष्टोऽस्मि कर्म चासुकरं कृतम्।\nरावणेर्हि विनाशेन जितमित्युपधारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000498009, "chapter_id": 9498, "verse_number": "६-९१-९", "content_sanskrit": "स तं शिरस्युपाघ्राय लक्ष्मणं कीर्तिवर्धनम्।\nलज्जमानं बलात् स्नेहादङ्कमारोप्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000498010, "chapter_id": 9498, "verse_number": "६-९१-१०", "content_sanskrit": "उपवेश्य तमुत्सङ्गे परिष्वज्यावपीडितम्।\nभ्रातरं लक्ष्मणं स्निग्धं पुनः पुनरुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000498011, "chapter_id": 9498, "verse_number": "६-९१-११", "content_sanskrit": "शल्यसम्पीडितं शस्तं निःश्वसन्तं तु लक्ष्मणम्।\nरामस्तु दुःखसंतप्तं तं तु निःश्वासपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000498012, "chapter_id": 9498, "verse_number": "६-९१-१२", "content_sanskrit": "मूर्ध्नि चैनमुपाघ्राय भूयः संस्पृश्य च त्वरन्।\nउवाच लक्ष्मणं वाक्यमाश्वास्य पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000498013, "chapter_id": 9498, "verse_number": "६-९१-१३", "content_sanskrit": "कृतं परमकल्याणं कर्म दुष्करकर्मणा।\nअद्य मन्ये हते पुत्रे रावणं निहतं युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000498014, "chapter_id": 9498, "verse_number": "६-९१-१४", "content_sanskrit": "अद्याहं विजयी शत्रौ हते तस्मिन् दुरात्मनि।\nरावणस्य नृशंसस्य दिष्ट्या वीर त्वया रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000498015, "chapter_id": 9498, "verse_number": "६-९१-१५", "content_sanskrit": "छिन्नो हि दक्षिणो बाहुः स हि तस्य व्यपाश्रयः।\nविभीषणहनूमद‍्भ्यां कृतं कर्म महद् रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000498016, "chapter_id": 9498, "verse_number": "६-९१-१६", "content_sanskrit": "अहोरात्रैस्त्रिभिर्वीरः कथंचिद् विनिपातितः।\nनिरमित्रः कृतोऽस्म्यद्य निर्यास्यति हि रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000498017, "chapter_id": 9498, "verse_number": "६-९१-१७", "content_sanskrit": "बलव्यूहेन महता निर्यास्यति हि रावणः।\nबलव्यूहेन महता श्रुत्वा पुत्रं निपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000498018, "chapter_id": 9498, "verse_number": "६-९१-१८", "content_sanskrit": "तं पुत्रवधसंतप्तं निर्यान्तं राक्षसाधिपम्।\nबलेनावृत्य महता निहनिष्यामि दुर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000498019, "chapter_id": 9498, "verse_number": "६-९१-१९", "content_sanskrit": "त्वया लक्ष्मण नाथेन सीता च पृथिवी च मे।\nन दुष्प्रापा हते तस्मिन् शक्रजेतरि चाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000498020, "chapter_id": 9498, "verse_number": "६-९१-२०", "content_sanskrit": "स तं भ्रातरमाश्वास्य परिष्वज्य च राघवः।\nरामः सुषेणं मुदितः समाभाष्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000498021, "chapter_id": 9498, "verse_number": "६-९१-२१", "content_sanskrit": "विशल्योऽयं महाप्राज्ञ सौमित्रिर्मित्रवत्सलः।\nयथा भवति सुस्वस्थस्तथा त्वं समुपाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000498022, "chapter_id": 9498, "verse_number": "६-९१-२२", "content_sanskrit": "विशल्यः क्रियतां क्षिप्रं सौमित्रिः सविभीषणः।\nऋक्षवानरसैन्यानां शूराणां द्रुमयोधिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000498023, "chapter_id": 9498, "verse_number": "६-९१-२३", "content_sanskrit": "ये चाप्यन्येऽत्र युध्यन्ति सशल्या व्रणिनस्तथा।\nतेऽपि सर्वे प्रयत्नेन क्रियन्ते सुखिनस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000498024, "chapter_id": 9498, "verse_number": "६-९१-२४", "content_sanskrit": "एवमुक्तः स रामेण महात्मा हरियूथपः।\nलक्ष्मणाय ददौ नस्तः सुषेणः परमौषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000498025, "chapter_id": 9498, "verse_number": "६-९१-२५", "content_sanskrit": "स तस्य गन्धमाघ्राय विशल्यः समपद्यत।\nतदा निर्वेदनश्चैव संरूढव्रण एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000498026, "chapter_id": 9498, "verse_number": "६-९१-२६", "content_sanskrit": "विभीषणमुखानां च सुहृदां राघवाज्ञया।\nसर्ववानरमुख्यानां चिकित्सामकरोत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000498027, "chapter_id": 9498, "verse_number": "६-९१-२७", "content_sanskrit": "ततः प्रकृतिमापन्नो हृतशल्यो गतक्लमः।\nसौमित्रिर्मुमुदे तत्र क्षणेन विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000498028, "chapter_id": 9498, "verse_number": "६-९१-२८", "content_sanskrit": "तदैव रामः प्लवगाधिपस्तथा\nविभीषणश्चर्क्षपतिश्च वीर्यवान्।\nअवेक्ष्य सौमित्रिमरोगमुत्थितं\nमुदा ससैन्याः सुचिरं जहर्षिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000498029, "chapter_id": 9498, "verse_number": "६-९१-२९", "content_sanskrit": "अपूजयत् कर्म स लक्ष्मणस्य\nसुदुष्करं दाशरथिर्महात्मा।\nबभूव हृष्टो युधि वानरेन्द्रो\nनिशम्य तं शक्रजितं निपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000498030, "chapter_id": 9498, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]