[{"id": 2063181, "chapter_id": 2345, "verse_number": "८-६६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063182, "chapter_id": 2345, "verse_number": "८-६६-१", "content_sanskrit": "कर्णोऽपि शरजालेन केकयानां महारथान्।\nव्यधमत्परमेष्वासानग्रानीके व्यवस्थितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063183, "chapter_id": 2345, "verse_number": "८-६६-२", "content_sanskrit": "तेषां प्रयतमानानां राधेयस्य निवारणे।\nरथान्पञ्चशतान्कर्णः प्राहिणोद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063184, "chapter_id": 2345, "verse_number": "८-६६-३", "content_sanskrit": "अविषह्यतमं दृष्ट्वा राधेयं युधि योधिनः।\nभीमसेनमुपागच्छन्कर्णबाणप्रपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063185, "chapter_id": 2345, "verse_number": "८-६६-४", "content_sanskrit": "रथानीकं विदार्यैव शरै राजन्ननेकधा।\nकर्ण एकरथेनैव युधिष्ठिरमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063186, "chapter_id": 2345, "verse_number": "८-६६-५", "content_sanskrit": "सेनानिवेशं गच्छन्तं मार्गणैर्भृशपीडितम्।\nयमयोर्मध्यगं वीरं शनैर्यान्तं विचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063187, "chapter_id": 2345, "verse_number": "८-६६-६", "content_sanskrit": "स समासाद्य राजानं दुर्योधनहितेप्सया।\nसूतपुत्रस्त्रिभिस्तीक्ष्णैर्विव्याध परमेषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063188, "chapter_id": 2345, "verse_number": "८-६६-७", "content_sanskrit": "तथैव राजा राधेयं प्रत्यविध्यत्स्तनान्तरे।\nशरैस्त्रिभिश्च यन्तारं चतुर्भिश्चतुरो हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063189, "chapter_id": 2345, "verse_number": "८-६६-८", "content_sanskrit": "चक्ररक्षौ नृपसुतौ माद्रीपुत्रौ परन्तपौ।\nतावप्यधावतां कर्णं राजानं मा वधीदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063190, "chapter_id": 2345, "verse_number": "८-६६-९", "content_sanskrit": "तौ पृथक्शरवर्षाभ्यां राधेयं समवर्षताम्।\nनकुलः सहदेवश्च परमं यत्नमास्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063191, "chapter_id": 2345, "verse_number": "८-६६-१०", "content_sanskrit": "तथैव तौ प्रत्यविध्यत्सूतपुत्रः प्रतापवान्।\nभल्लाभ्यां शितधाराभ्यां महात्मानावरिन्दमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063192, "chapter_id": 2345, "verse_number": "८-६६-११", "content_sanskrit": "दन्तवर्णांस्तु राधेयो निजघान मनोजवान्।\nयुधिष्ठिरस्य सङ्ग्रामे कालवालान्हयोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063193, "chapter_id": 2345, "verse_number": "८-६६-१२", "content_sanskrit": "ततोऽपरेण भल्लेन शिरस्त्राणमपातयत्।\nकौन्तेयस्य महेष्वासः प्रहसन्निव सूतजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063194, "chapter_id": 2345, "verse_number": "८-६६-१३", "content_sanskrit": "तथैव नकुलस्यापि हयान्हत्वा महारथः।\nततोऽपरेण भल्लेन भृशं तीक्ष्णेन भारत।\nधनुश्चिच्छेद वीरस्य माद्रीपुत्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063195, "chapter_id": 2345, "verse_number": "८-६६-१४", "content_sanskrit": "तौ हताश्वौ हतरथौ पाण्डवौ भृशविक्षतौ।\nभ्रातरावारुरुहतुः सहदेवरथं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063196, "chapter_id": 2345, "verse_number": "८-६६-१५", "content_sanskrit": "तौ दृष्ट्वा मातुलस्तत्र विरथौ परवीरहा।\nअभ्यभाषत राधेयं मद्रराजोऽनुकम्पया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063197, "chapter_id": 2345, "verse_number": "८-६६-१६", "content_sanskrit": "मार्गितव्यस्त्वया कर्ण कुन्तीपुत्रो धनञ्जयः।\nअतस्त्वं धर्मराजेन किमर्थमिह युध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063198, "chapter_id": 2345, "verse_number": "८-६६-१७", "content_sanskrit": "[क्षीणशस्त्रास्त्राकवचः क्षीणबाणो विबाणधिः।\nश्रान्तसारथिवाहश्च च्छन्नोऽस्त्रैररिभिस्तथा।\nपार्थमासाद्य राधेय उपहास्यो भविष्यसि॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063199, "chapter_id": 2345, "verse_number": "८-६६-१८", "content_sanskrit": "तथापि कर्णः संरब्धो युधिष्ठिरमपीडयत्।\nशरैस्तीक्ष्णैर्महावीर्यैर्माद्रीपुत्रौ च पाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063200, "chapter_id": 2345, "verse_number": "८-६६-१९", "content_sanskrit": "ततः शल्यः प्रहस्येदं कर्णं पुनरुवाच ह।\nरथस्थमतिसंरब्धं युधिष्ठिरवधे स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063201, "chapter_id": 2345, "verse_number": "८-६६-२०", "content_sanskrit": "यदर्थं धार्तराष्ट्रेण सततं मानितो भवान्।\nतं पार्थ जहि राधेय किं ते हत्वा युधिष्ठिरम्।\n`हते यस्मिन्ध्रुवं पार्थः सर्वाञ्जेष्यति नो रथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063202, "chapter_id": 2345, "verse_number": "८-६६-२१", "content_sanskrit": "तस्मिन्हि धार्तराष्ट्रस्य निहते तु ध्रुवो जयः।\nध्वजोऽसौ दृश्यते तस्य रोचमानोंऽशुमानिव।\nसारो ह्येष महाबाहो किं ते हत्वा युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063203, "chapter_id": 2345, "verse_number": "८-६६-२२", "content_sanskrit": "शङ्खयोर्ध्मातयोः शब्दः सुमहानेष कृष्णयोः।\nश्रूयते चापघोषश्च प्रावृषीवाम्बुदस्य ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063204, "chapter_id": 2345, "verse_number": "८-६६-२३", "content_sanskrit": "असौ निघ्नन्रथोदारानर्जुनः शरवृष्टिभिः।\nसर्वां ग्रसति नः सेनां कर्ण पश्यैनमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063205, "chapter_id": 2345, "verse_number": "८-६६-२४", "content_sanskrit": "पृष्ठरक्षौ च शूरस्य युधामन्यूत्तमौजसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063206, "chapter_id": 2345, "verse_number": "८-६६-२५", "content_sanskrit": "उत्तरं चास्य वै शूरश्चक्रं रक्षति सांत्यकिः।\nधृष्टद्युम्नस्तथा चास्य चक्रं रक्षति दक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063207, "chapter_id": 2345, "verse_number": "८-६६-२६", "content_sanskrit": "भीमसेनश्च वै राज्ञा धार्तराष्ट्रेण युध्यते।\nयथा न हन्यात्तं भीमः सर्वेषां नोऽद्य पश्यताम्।\nकुरु राधेय वै राजा यथा मुच्येत तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063208, "chapter_id": 2345, "verse_number": "८-६६-२७", "content_sanskrit": "xxxx भीमसेनेन ग्रस्तमाहवशोभिना।\nयदि नामाद्य मुच्येत विस्मयः सुमहान्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063209, "chapter_id": 2345, "verse_number": "८-६६-२८", "content_sanskrit": "परित्राह्येनमभ्येत्य संशयं परमं गतम्।\nकिं नु माद्रीसुतौ हत्वा राजानं वा युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063210, "chapter_id": 2345, "verse_number": "८-६६-२९", "content_sanskrit": "इति शल्यवचः श्रुत्वा राधेयः पृथिवीपते।\nदृष्ट्वा दुर्योधनं चैव भीमग्रस्तं महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063211, "chapter_id": 2345, "verse_number": "८-६६-३०", "content_sanskrit": "राजगृध्नुर्भृशं चैव शल्यवाक्यप्रचोदितः।\nअजातशत्रुमुत्सृज्य माद्रीपुत्रौ च पाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063212, "chapter_id": 2345, "verse_number": "८-६६-३१", "content_sanskrit": "तव पुत्रं परित्रातुमभ्यधावत वीर्यवान्।\nमद्रराजप्रणुदितैरश्वैराकाशगैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063213, "chapter_id": 2345, "verse_number": "८-६६-३२", "content_sanskrit": "गते कर्णे तु कौन्तेयः पाण्डुपुत्रो युधिष्ठिरः।\nअपायाज्जवनैरश्वैः सहदेवस्य मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063214, "chapter_id": 2345, "verse_number": "८-६६-३३", "content_sanskrit": "[ताभ्यां स सहितस्तूर्णं व्रीडन्निव नरेश्वरः]।\nप्राप्य सेनानिवेशं स्वं मार्गणैर्भृशविक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063215, "chapter_id": 2345, "verse_number": "८-६६-३४", "content_sanskrit": "अवतीर्य रथात्तूर्णमाविशच्छयनं शुभम्।\nअपेतशल्यो राजा तु हृच्छल्येनाभिपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063216, "chapter_id": 2345, "verse_number": "८-६६-३५", "content_sanskrit": "सोऽब्रवीद्धातरौ राजा माद्रीपुत्रौ महारथौ।\nगच्छन्त त्वरितौ वीरौ यत्र भीमो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063217, "chapter_id": 2345, "verse_number": "८-६६-३६", "content_sanskrit": "`ततस्ते पाण्डवाः सर्वे समाभाष्य परस्परम्।\nअनीकं भीमसेनस्य पाण्डवावभ्यगच्छताम्।\nजीमूत इव नर्दंस्तु युध्यते स वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063218, "chapter_id": 2345, "verse_number": "८-६६-३७", "content_sanskrit": "ततोऽन्यं रथमास्थाय नकुलो रथपुङ्गवः।\nसहदेवश्च तेजस्वी भ्रातरौ शत्रुकर्शनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063219, "chapter_id": 2345, "verse_number": "८-६६-३८", "content_sanskrit": "तुरगैरग्र्यरंहोभिर्यत्र भीमस्तरस्विनौ।\nअनीकैः सहितौ तत्र भ्रातरौ समवस्थितौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063220, "chapter_id": 2345, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे षट्षष्टितमोऽध्यायः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]