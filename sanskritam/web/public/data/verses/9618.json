[{"id": 5000618000, "chapter_id": 9618, "verse_number": "७-८३-१", "content_sanskrit": "तच्छ्रुत्वा भाषितं तस्य रामस्याक्लिष्ट कर्मणः ।\nद्वास्स्थः कुमारावाहूय राघवाय न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000618001, "chapter_id": 9618, "verse_number": "७-८३-२", "content_sanskrit": "दृष्ट्वा तु राघवः प्राप्तौ प्रियौ भरतलक्ष्मणौ ।\nपरिष्वज्य तदा रामो वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000618002, "chapter_id": 9618, "verse_number": "७-८३-३", "content_sanskrit": "कृतं मया यथा तथ्यं द्विजकार्यमनुत्तमम् ।\nधर्मसेतुमथो भूयः कर्तुमिच्छामि राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000618003, "chapter_id": 9618, "verse_number": "७-८३-४", "content_sanskrit": "अक्षय्यश्चाव्ययश्चैव धर्मसेतुर्मतो मम ।\nधर्मप्रसाधकं ह्येतत् सर्वपापप्रणाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000618004, "chapter_id": 9618, "verse_number": "७-८३-५", "content_sanskrit": "युवाभ्यामात्मभूताभ्यां राजसूयमनुत्तमम् ।\nसहितो यष्टुमिच्छामि तत्र धर्मो हि शाश्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000618005, "chapter_id": 9618, "verse_number": "७-८३-६", "content_sanskrit": "इष्ट्वा तु राजसूयेन मित्रः शत्रुनिबर्हणः ।\nसुहुतेन सुयज्ञेन वरुणत्वमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000618006, "chapter_id": 9618, "verse_number": "७-८३-७", "content_sanskrit": "सोमश्च राजसूयेन इष्ट्वा धर्मेण धर्मवित् ।\nप्राप्तश्च सर्वलोकेषु कीर्तिस्थानं च शाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000618007, "chapter_id": 9618, "verse_number": "७-८३-८", "content_sanskrit": "अस्मिन्नहनि यच्छ्रेयश्चिन्त्यतां तन्मया सह ।\nहितं चायतियुक्तं च प्रयतौ कर्तुमर्हथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000618008, "chapter_id": 9618, "verse_number": "७-८३-९", "content_sanskrit": "श्रुत्वा तु राघवस्यैतद्वाक्यं वाक्यविशारदः ।\nभरतः प्राञ्जलिर्भूत्वा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000618009, "chapter_id": 9618, "verse_number": "७-८३-१०", "content_sanskrit": "त्वयि धर्मः परः साधो त्वयि सर्वा वसुन्धरा ।\nप्रतिष्ठिता महाबाहो यशश्चामितविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000618010, "chapter_id": 9618, "verse_number": "७-८३-११", "content_sanskrit": "महीपालाश्च सर्वे त्वां प्रजापतिमिवामराः ।\nनिरीक्षन्ते महात्मानं लोकानाथं यथा वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000618011, "chapter_id": 9618, "verse_number": "७-८३-१२", "content_sanskrit": "पुत्राश्च पितृवद्राजन्पश्यन्ति त्वां महाबल ।\nपृथिव्या गतिभूतो ऽसि प्राणिनामपि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000618012, "chapter_id": 9618, "verse_number": "७-८३-१३", "content_sanskrit": "स त्वमेवंविधं यज्ञमाहर्तासि कथं नृप ।\nपृथिव्यां राजवंशानां विनाशो यत्र दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000618013, "chapter_id": 9618, "verse_number": "७-८३-१४", "content_sanskrit": "पृथिव्यां ये च पुरुषा राजन्पौरुषमागताः ।\nसर्वेषां भविता तत्र सङ्क्षयः सर्वकोपजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000618014, "chapter_id": 9618, "verse_number": "७-८३-१५", "content_sanskrit": "स त्वं पुरुषशार्दूल गुणैरतुलविक्रम ।\nपृथिवीं नार्हसे हन्तुं वशे हि तव वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000618015, "chapter_id": 9618, "verse_number": "७-८३-१६", "content_sanskrit": "भरतस्य तु तद्वाक्यं श्रुत्वा ऽमृतमयं तदा ।\nप्रहर्षमतुलं लेभे रामः सत्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000618016, "chapter_id": 9618, "verse_number": "७-८३-१७", "content_sanskrit": "उवाच च शुभं वाक्यं कैकेय्यानन्दवर्धनम् ।\nप्रीतो ऽस्मि परितुष्टो ऽस्मि तवाद्य वचने ऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000618017, "chapter_id": 9618, "verse_number": "७-८३-१८", "content_sanskrit": "इदं वचनमक्लीबं त्वया धर्मसमाहितम् ।\nव्याहृतं पुरुषव्याघ्र पृथिव्याः परिपालनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000618018, "chapter_id": 9618, "verse_number": "७-८३-१९", "content_sanskrit": "एष्यदस्मदभिप्रायाद्राजसूयात्क्रतूत्तमात् ।\nनिवर्तयामि धर्मज्ञ तव सुव्याहृतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000618019, "chapter_id": 9618, "verse_number": "७-८३-२०", "content_sanskrit": "लोकपीडाकरं कर्म न कर्तव्यं विचक्षणैः ।\nबालानां तु शुभं वाक्यं ग्राह्य लक्ष्मणपूर्वज ।\nतस्माच्छृणोमि ते वाक्यं साधु युक्तं महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000618020, "chapter_id": 9618, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्र्यशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]