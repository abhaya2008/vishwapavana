[{"id": 7006427000, "chapter_id": 26427, "verse_number": "२-८७-१", "content_sanskrit": "वैशम्पायन उवाच\nअन्धको नारदवचः श्रुत्वा तत्त्वेन भारत ।\nमन्दरं पर्वतं गन्तुं मनो दध्रे महासुरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006427001, "chapter_id": 26427, "verse_number": "२-८७-२", "content_sanskrit": "सोऽसुरान् सुमहातेजाः समानीय महाबलः ।\nजगाम मन्दरं क्रुद्धो महादेवालयं तदा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006427002, "chapter_id": 26427, "verse_number": "२-८७-३", "content_sanskrit": "तं महाभ्रप्रतिच्छन्नं महौषधिसमाकुलम् ।\nनानासिद्धसमाकीर्णं महर्षिगणसेवितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006427003, "chapter_id": 26427, "verse_number": "२-८७-४", "content_sanskrit": "चन्दनागुरुवृक्षाढ्यं सरलद्रुमसंकुलम् ।\nकिन्नरोद्गीतरम्यं च बहुनागकुलाकुलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006427004, "chapter_id": 26427, "verse_number": "२-८७-५", "content_sanskrit": "वातोद्भूतैर्वनैः फुल्लैर्नृत्यन्तमिव च क्वचित् ।\nप्रस्रुतैर्धातुभिश्चित्रैर्विलिप्तमिव च क्वचित् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006427005, "chapter_id": 26427, "verse_number": "२-८७-६", "content_sanskrit": "पक्षिस्वनैः सुमधुरैर्नदन्तमिव च क्वचित् ।\nहंसैः शुचिपदैः कीर्णं सम्पतद्भिरितस्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006427006, "chapter_id": 26427, "verse_number": "२-८७-७", "content_sanskrit": "महाबलैश्च महिषैश्चरद्भिर्दैत्यनाशनैः ।\nचन्द्रांशुविमलैः सिंहैर्भूषितं हेमसंचयम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006427007, "chapter_id": 26427, "verse_number": "२-८७-८", "content_sanskrit": "मृगराजसमाकीर्णं मृगवृन्दनिषेवितम् ।\nस मन्दरं गिरिं प्राह रूपिणं बलदर्पितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006427008, "chapter_id": 26427, "verse_number": "२-८७-९", "content_sanskrit": "वेत्सि त्वं हि यथावध्यो वरदानादहं पितुः ।\nमम चैव वशे सर्वं त्रैलोक्यं सचराचरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006427009, "chapter_id": 26427, "verse_number": "२-८७-१०", "content_sanskrit": "प्रतियोद्धुं न मां कश्चिदिच्छत्यपि गिरे भयात् ।\nपारिजातवनं चास्ति तव सानौ महागिरे ।\nसर्वकामप्रदैः पुष्पैर्भूषितं रत्नमुत्तमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006427010, "chapter_id": 26427, "verse_number": "२-८७-११", "content_sanskrit": "तदाचक्ष्वोपभोक्ष्यामि तद् वनं तव सानुजम् ।\nकिं करिष्यसि क्रुद्धस्त्वं मनो हि त्वरते मम ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006427011, "chapter_id": 26427, "verse_number": "२-८७-१२", "content_sanskrit": "त्रातारं नानुपश्यामि मया खल्वर्दितस्य ते ।\nइत्युक्तो मन्दरस्तेन तत्रैवान्तरधीयत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006427012, "chapter_id": 26427, "verse_number": "२-८७-१३", "content_sanskrit": "ततोऽन्धकोऽतिरुषितो वरदानेन दर्पितः ।\nमुमोच नादं सुमहदिदं वचनमब्रवीत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006427013, "chapter_id": 26427, "verse_number": "२-८७-१४", "content_sanskrit": "मया वै त्वं याच्यमानो यस्मान्न बहु मन्यसे ।\nअहं चूर्णीकरोमि त्वां बलं पर्वत पश्य मे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006427014, "chapter_id": 26427, "verse_number": "२-८७-१५", "content_sanskrit": "एवमुक्त्वा गिरेः शृङ्गमुत्पाट्य बहुयोजनम् ।\nनिष्पिपेष गिरेस्तस्य शृङ्गेष्वन्यत्र वीर्यवान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006427015, "chapter_id": 26427, "verse_number": "२-८७-१६", "content_sanskrit": "सह तैरसुरैः सर्वैर्वरदानेन दर्पितः ।\nतं प्रच्छन्ननदीजालं मन्यमानं महागिरिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006427016, "chapter_id": 26427, "verse_number": "२-८७-१७", "content_sanskrit": "विदित्वा भगवान् रुद्रश्चकारानुग्रहं गिरेः ।\nसविशेषतरं वीर मत्तद्विपमृगायुतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006427017, "chapter_id": 26427, "verse_number": "२-८७-१८", "content_sanskrit": "नदीजालैर्बहुतरैराचितं चित्रकाननम् ।\nनभश्च्युतैः पुरा यद्वत्तद्वदेव विराजते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006427018, "chapter_id": 26427, "verse_number": "२-८७-१९", "content_sanskrit": "अथ देवप्रभावेण शृङ्गाण्युत्पाटितानि तु ।\nक्षिप्तानि चासुरानेव घ्नन्ति घोराणि भारत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006427019, "chapter_id": 26427, "verse_number": "२-८७-२०", "content_sanskrit": "क्षिप्त्वा ये प्रपलायन्ते शृङ्गाणि तु महासुराः ।\nशृङ्गैस्तैस्तैः स्म वध्यन्ति पर्वतस्य जनाधिप ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006427020, "chapter_id": 26427, "verse_number": "२-८७-२१", "content_sanskrit": "ये स्वस्थास्त्वसुरास्तत्र तिष्ठन्ति गिरिसानुषु ।\nशृङ्गैस्ते न स्म वध्यन्ते मन्दरस्य महागिरेः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006427021, "chapter_id": 26427, "verse_number": "२-८७-२२", "content_sanskrit": "ततोऽन्धकस्तदा दृष्ट्वा सेनां तां मर्दितां तथा ।\nरुषितः सुमहानादं नर्दित्वैवं तदाब्रवीत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006427022, "chapter_id": 26427, "verse_number": "२-८७-२३", "content_sanskrit": "आह्वये तं वनं यस्य युद्धार्थमुपतिष्ठतु ।\nकिं त्वयाचल युद्धेन हताः स्म च्छद्मना रणे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006427023, "chapter_id": 26427, "verse_number": "२-८७-२४", "content_sanskrit": "एवमुक्ते त्वन्धकेन वृषभेण महेश्वरः ।\nसम्प्राप्तः शूलमुद्यम्य देवोऽन्धकजिघांसया ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006427024, "chapter_id": 26427, "verse_number": "२-८७-२५", "content_sanskrit": "प्रमथानां गणैर्धीमान् वृतो वै बहुलोचनः ।\nतथा भूतगणैश्चैव धीमान् भूतगणेश्वरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006427025, "chapter_id": 26427, "verse_number": "२-८७-२६", "content_sanskrit": "प्रचकम्पे ततः कृत्स्नं त्रैलोक्यं रुषिते हरे ।\nसिन्धवश्च प्रतिस्रोतमूहुः प्रज्वलितोदकाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006427026, "chapter_id": 26427, "verse_number": "२-८७-२७", "content_sanskrit": "जग्मुर्दिशोऽग्निदाहाश्च सर्वे ते हरतेजसा ।\nयुयुधुश्च ग्रहाः सर्वे विपरीता जनाधिप ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006427027, "chapter_id": 26427, "verse_number": "२-८७-२८", "content_sanskrit": "चेलुश्च गिरयस्तत्र काले कुरुकुलोद्वह ।\nप्रववर्षाथ पर्जन्यः सधूमाङ्गारवृष्टयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006427028, "chapter_id": 26427, "verse_number": "२-८७-२९", "content_sanskrit": "उष्णभाश्चन्द्रमाश्चासीत् सूर्यः शीतप्रभस्तथा ।\nन ब्रह्म विविदुस्तत्र मुनयो ब्रह्मवादिनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006427029, "chapter_id": 26427, "verse_number": "२-८७-३०", "content_sanskrit": "बडवाः सुषुवुर्गाश्च गावोऽश्वानपि चानघ ।\nपेतुर्वृक्षाश्च मेदिन्यामच्छिन्ना भस्मसात्कृताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006427030, "chapter_id": 26427, "verse_number": "२-८७-३१", "content_sanskrit": "बाधन्ते वृषभा गाश्च गावश्चारुरुहुर्वृषान् ।\nराक्षसा यातुधानाश्च पिशाचाश्चापि सर्वशः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006427031, "chapter_id": 26427, "verse_number": "२-८७-३२", "content_sanskrit": "विपरीतं जगद् दृष्ट्वा महादेवस्तथागतम् ।\nमुमोच भगवाञ्छूलं प्रदीप्ताग्निसमप्रभम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006427032, "chapter_id": 26427, "verse_number": "२-८७-३३", "content_sanskrit": "तत् पपात हरोत्सृष्टमन्धकोरसि दुर्द्धरम् ।\nभस्मसाच्चाकरोद् रौद्रमन्धकं साधुकण्टकम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006427033, "chapter_id": 26427, "verse_number": "२-८७-३४", "content_sanskrit": "ततो देवगणाः सर्वे मुनयश्च तपोधनाः ।\nशंकरं तुष्टुवुश्चैव जगच्छत्रौ निबर्हिते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006427034, "chapter_id": 26427, "verse_number": "२-८७-३५", "content_sanskrit": "देवदुन्दुभयो नेदुः पुष्पवृष्टिः पपात ह ।\nत्रैलोक्यं निर्वृतं चासीन्नरेन्द्र विगतज्वरम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006427035, "chapter_id": 26427, "verse_number": "२-८७-३६", "content_sanskrit": "प्रजगुर्देवगन्धर्वा ननृतुश्चाप्सरोगणाः ।\nजेपुश्च ब्राह्मणा वेदानीजुश्च क्रतुभिस्तदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006427036, "chapter_id": 26427, "verse_number": "२-८७-३७", "content_sanskrit": "ग्रहाः प्रकृतिमापेदुरूहुर्नद्यो यथा पुरा ।\nन जज्वाल जले वह्निराशाः सर्वाः प्रसेदिरे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006427037, "chapter_id": 26427, "verse_number": "२-८७-३८", "content_sanskrit": "मन्दरः पर्वतश्रेष्ठः पुनरेव रराज ह ।\nश्रिया परमया जुष्टः सर्वतेजःसमुच्छ्रयात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006427038, "chapter_id": 26427, "verse_number": "२-८७-३९", "content_sanskrit": "रेमे सोमश्च भगवान् पारिजातवने हरः ।\nसुप्रचारान्सुरान्कृत्वा शक्रादीन् धर्मतः प्रभुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]