[{"id": 2042204, "chapter_id": 1940, "verse_number": "५-१८५-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042205, "chapter_id": 1940, "verse_number": "५-१८५-१", "content_sanskrit": "ततो हलहलाशब्दो दिवि राजन्महानभूत्।\nप्रस्वापं भीष्म मा स्राक्षीरिति कौरवनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042206, "chapter_id": 1940, "verse_number": "५-१८५-२", "content_sanskrit": "अयुञ्जमेव चैवाहं तदस्त्रं भृगुनन्दने ।\nप्रस्वापं मां प्रयुज्जानं नारदो वाकयमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042207, "chapter_id": 1940, "verse_number": "५-१८५-३", "content_sanskrit": "एते वियति करव्य दिवि देवगणाः स्थिताः।\nते त्वां निवारयन्त्यद्य प्रस्वापं मा प्रयोजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042208, "chapter_id": 1940, "verse_number": "५-१८५-४", "content_sanskrit": "रामस्तपस्वी ब्रह्मण्यो ब्राह्मणश्च गुरुश्च ते।\nतस्यवमानं कौरव्य मास्म कार्षीः कथञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042209, "chapter_id": 1940, "verse_number": "५-१८५-५", "content_sanskrit": "ततोऽपश्यं दिविष्ठान्वै तानष्टौ ब्रह्मवादिनः ।\nते मां स्मयन्तो राजेन्द्र शनकैरिदमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042210, "chapter_id": 1940, "verse_number": "५-१८५-६", "content_sanskrit": "यथाऽऽह भरतश्रेष्ठ नारदस्तत्तथा कुरु ।\nएतद्धि परमं श्रेयो लोकानां भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042211, "chapter_id": 1940, "verse_number": "५-१८५-७", "content_sanskrit": "ततश्च प्रतिसंहृत्य तदस्त्रं स्वापनं महत्।\nब्रह्मास्त्रं दीपयाञ्चक्रे तस्मिन्युधि यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042212, "chapter_id": 1940, "verse_number": "५-१८५-८", "content_sanskrit": "ततो रामो हृषितो राजसिंह\nदृष्ट्वा तदस्त्रं विनिवर्तितं वै।\nजितोऽस्मि भीष्मेण सुमन्दबुद्धि-\nरित्येव वाक्यं सहसा व्यमुञ्चत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042213, "chapter_id": 1940, "verse_number": "५-१८५-९", "content_sanskrit": "ततोऽपश्यत्पितरं जामदग्न्यः\nपितुस्तथा पितरं चास्य मान्यम्।\nते तत्र चैनं परिवार्य तस्थु-\nरूचुश्चैनं सान्त्वपूर्वं तदनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042214, "chapter_id": 1940, "verse_number": "५-१८५-१०x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042215, "chapter_id": 1940, "verse_number": "५-१८५-१०", "content_sanskrit": "मा स्मैवं साहसं तात पुनः कार्षीः कथञ्चन ।\nभीष्मेण संयुगं गन्तुं क्षत्रियेण विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042216, "chapter_id": 1940, "verse_number": "५-१८५-११", "content_sanskrit": "क्षत्रियस्य तु धर्मोऽयं यद्युद्धं भृगुनन्दन ।\nस्वाध्यायो व्रतचर्याऽथ ब्राह्मणानां परं धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042217, "chapter_id": 1940, "verse_number": "५-१८५-१२", "content_sanskrit": "इदं निमित्ते कस्मिंश्चिदस्माभिः प्रागुदाहृतम् ।\nशस्त्रधारणमत्युग्रं तच्चाकार्यं कृतं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042218, "chapter_id": 1940, "verse_number": "५-१८५-१३", "content_sanskrit": "वत्स पर्याप्तमेतावद्भीष्मेण सह संयुगे ।\nविमर्दस्ते महाबाहो व्यपयाहि रणादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042219, "chapter_id": 1940, "verse_number": "५-१८५-१४", "content_sanskrit": "पर्याप्तमेतद्भद्रं ते तव कार्मुकधारणम् ।\nविसर्जयैतद्दुर्धर्ष तपस्तप्यस्व भार्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042220, "chapter_id": 1940, "verse_number": "५-१८५-१५", "content_sanskrit": "एष भीष्मः शान्तनवो देवैः सर्वैर्निवारितः।\nनिवर्तस्व रणादस्मादिति चैव प्रसादितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042221, "chapter_id": 1940, "verse_number": "५-१८५-१६", "content_sanskrit": "रामेण सह मायोत्सीर्गुरुणेति पुनः पुनः ।\nन हि रामो रणे जेतुं त्वया न्याय्यः कुरूद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042222, "chapter_id": 1940, "verse_number": "५-१८५-१७", "content_sanskrit": "मानं कुरुष्व गाङ्गेय ब्राह्मणस्य रणाजिरे।\nवयं तु गुरवस्तुभ्यं तस्मात्त्वां वारयामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042223, "chapter_id": 1940, "verse_number": "५-१८५-१८", "content_sanskrit": "भीष्मो वसूनामन्यतमो दिष्ट्या जीवसि पुत्रक ।\nगाङ्गेयः शन्तनोः पुत्रो वसुरेष महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042224, "chapter_id": 1940, "verse_number": "५-१८५-१९", "content_sanskrit": "कथं शक्यस्त्वया जेतुं निवर्तस्वेह भार्गव ।\nअर्जुनः पाण्डवश्रेष्ठः पुरन्दरसुतो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042225, "chapter_id": 1940, "verse_number": "५-१८५-२०", "content_sanskrit": "नरः प्रजापतिर्वीरः पूर्वदेवः सनातनः।\nसव्यसाचीति विख्यातस्त्रिषु लोकेषु वीर्यवान्।\nभीष्ममृत्युर्यथाकालं विहितो वै स्वयंभुवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042226, "chapter_id": 1940, "verse_number": "५-१८५-२१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042227, "chapter_id": 1940, "verse_number": "५-१८५-२१", "content_sanskrit": "एवमुक्तः स पितृभिः पितॄन्रामोऽब्रवीदिदम्।\nनाहं युधि निवर्तेयमिति मे व्रतमाहितम्।\nन निवर्तितपूर्वश्च कदाचिद्रणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042228, "chapter_id": 1940, "verse_number": "५-१८५-२२", "content_sanskrit": "निवर्त्यतामापगेयः कामं युद्धात्पितामहाः।\nन त्वहं विनिवर्तिष्ये युद्धादस्मात्कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042229, "chapter_id": 1940, "verse_number": "५-१८५-२३", "content_sanskrit": "ततस्ते मुनयो राजन्नृचीकप्रमुखास्तदा ।\nनारदेनैव सहिताः समागम्येदमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042230, "chapter_id": 1940, "verse_number": "५-१८५-२४", "content_sanskrit": "निवर्तस्व रणात्तात मानयस्व द्विजोत्तमम् ।\nइत्यवोचमहं तांश्च क्षत्रधर्मव्यपेक्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042231, "chapter_id": 1940, "verse_number": "५-१८५-२५", "content_sanskrit": "मम व्रतमिदं लोके नाहं युद्धात्कदाचन।\nविमुखो विनिवर्तेयं पृष्ठतोऽभ्याहतः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042232, "chapter_id": 1940, "verse_number": "५-१८५-२६", "content_sanskrit": "नाहं लोभान्न कार्पण्यान्न भयान्नार्थकारणात्।\nत्यजेयं शाश्वतं धर्ममिति मे निश्चिता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042233, "chapter_id": 1940, "verse_number": "५-१८५-२७", "content_sanskrit": "ततस्ते मुनयः सर्वे नारदप्रमुखा नृप।\nभागीरथी च मे माता रणमध्यं प्रपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042234, "chapter_id": 1940, "verse_number": "५-१८५-२८", "content_sanskrit": "तथैवात्तशरो धन्वी तथैव दृढनिश्चयः ।\nस्थितोऽहमाहवे योद्धुं ततस्ते राममब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042235, "chapter_id": 1940, "verse_number": "५-१८५-२९", "content_sanskrit": "समेत्य सहिता भूयः समरे भृगुनन्दनम् ।\nनावनीतं हि हृदयं विप्राणां शाम्य भार्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042236, "chapter_id": 1940, "verse_number": "५-१८५-३०", "content_sanskrit": "राम राम निवर्तस्व युद्धादस्माद्द्विजोत्तम ।\nअवध्यो वै त्वया भीष्मस्त्वं च भीष्मस्य भार्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042237, "chapter_id": 1940, "verse_number": "५-१८५-३१", "content_sanskrit": "एवं ब्रुवन्तस्ते सर्वे प्रतिरुद्ध्य रणाजिरम् ।\nन्यासयाञ्चक्रिरे शस्त्रं पितरो भृगुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042238, "chapter_id": 1940, "verse_number": "५-१८५-३२", "content_sanskrit": "ततोऽहं पुनरेवाथ तानष्टौ ब्रह्मवादिनः ।\nअद्राक्षं दीप्यमानान्वै ग्रहानष्टाविवोदितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042239, "chapter_id": 1940, "verse_number": "५-१८५-३३", "content_sanskrit": "ते मां सप्रणयं वाक्यमब्रुवन्समरे स्थितम् ।\nप्रैहि रामं महाबाहो गुरुं लोकहितं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2042240, "chapter_id": 1940, "verse_number": "५-१८५-३४", "content_sanskrit": "दृष्ट्वा निवर्तितं रामं सुहृद्वाक्येन तेन वै।\nलोकानां च हितं कुर्वन्नहमप्याददे वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2042241, "chapter_id": 1940, "verse_number": "५-१८५-३५", "content_sanskrit": "ततोऽहं राममासाद्य ववन्दे भृशविक्षतः।\nरामश्चाभ्युत्स्मयन्प्रेम्णा मामुवाच महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2042242, "chapter_id": 1940, "verse_number": "५-१८५-३६", "content_sanskrit": "त्वत्समो नास्ति लोकेऽस्मिन्क्षत्रियः पृथिवीचरः ।\nगम्यतां भीष्म युद्धेऽस्मिंस्तोषितोऽहं भृशं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2042243, "chapter_id": 1940, "verse_number": "५-१८५-३७", "content_sanskrit": "मम चैव समक्षं तां कन्यामाहूय भार्गवः।\nउक्तवान्दीनया वाचा मध्ये तेषां महात्मनाम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2042244, "chapter_id": 1940, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि पञ्चाशीत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]