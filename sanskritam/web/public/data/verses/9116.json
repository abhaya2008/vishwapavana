[{"id": 5000116000, "chapter_id": 9116, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000116001, "chapter_id": 9116, "verse_number": "२-३९-१", "content_sanskrit": "रामस्य तु वचः श्रुत्वा मुनिवेषधरं च तम्।\nसमीक्ष्य सह भार्याभी राजा विगतचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000116002, "chapter_id": 9116, "verse_number": "२-३९-२", "content_sanskrit": "नैनं दुःखेन संतप्तः प्रत्यवैक्षत राघवम्।\nन चैनमभिसम्प्रेक्ष्य प्रत्यभाषत दुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000116003, "chapter_id": 9116, "verse_number": "२-३९-३", "content_sanskrit": "स मुहूर्तमिवासंज्ञो दुःखितश्च महीपतिः।\nविललाप महाबाहू राममेवानुचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000116004, "chapter_id": 9116, "verse_number": "२-३९-४", "content_sanskrit": "मन्ये खलु मया पूर्वं विवत्सा बहवः कृताः।\nप्राणिनो हिंसिता वापि तन्मामिदमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000116005, "chapter_id": 9116, "verse_number": "२-३९-५", "content_sanskrit": "न त्वेवानागते काले देहाच्च्यवति जीवितम्।\nकैकेय्या क्लिश्यमानस्य मृत्युर्मम न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000116006, "chapter_id": 9116, "verse_number": "२-३९-६", "content_sanskrit": "योऽहं पावकसंकाशं पश्यामि पुरतः स्थितम्।\nविहाय वसने सूक्ष्मे तापसाच्छादमात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000116007, "chapter_id": 9116, "verse_number": "२-३९-७", "content_sanskrit": "एकस्याः खलु कैकेय्याः कृतेऽयं खिद्यते जनः।\nस्वार्थे प्रयतमानायाः संश्रित्य निकृतिं त्विमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000116008, "chapter_id": 9116, "verse_number": "२-३९-८", "content_sanskrit": "एवमुक्त्वा तु वचनं बाष्पेण विहतेन्द्रियः।\nरामेति सकृदेवोक्त्वा व्याहर्तुं न शशाक सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000116009, "chapter_id": 9116, "verse_number": "२-३९-९", "content_sanskrit": "संज्ञां तु प्रतिलभ्यैव मुहूर्तात् स महीपतिः।\nनेत्राभ्यामश्रुपूर्णाभ्यां सुमन्त्रमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000116010, "chapter_id": 9116, "verse_number": "२-३९-१०", "content_sanskrit": "औपवाह्यं रथं युक्त्वा त्वमायाहि हयोत्तमैः।\nप्रापयैनं महाभागमितो जनपदात् परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000116011, "chapter_id": 9116, "verse_number": "२-३९-११", "content_sanskrit": "एवं मन्ये गुणवतां गुणानां फलमुच्यते।\nपित्रा मात्रा च यत्साधुर्वीरो निर्वास्यते वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000116012, "chapter_id": 9116, "verse_number": "२-३९-१२", "content_sanskrit": "राज्ञो वचनमाज्ञाय सुमन्त्रः शीघ्रविक्रमः।\nयोजयित्वा ययौ तत्र रथमश्वैरलंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000116013, "chapter_id": 9116, "verse_number": "२-३९-१३", "content_sanskrit": "तं रथं राजपुत्राय सूतः कनकभूषितम्।\nआचचक्षेऽञ्जलिं कृत्वा युक्तं परमवाजिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000116014, "chapter_id": 9116, "verse_number": "२-३९-१४", "content_sanskrit": "राजा सत्वरमाहूय व्यापृतं वित्तसंचये।\nउवाच देशकालज्ञो निश्चितं सर्वतः शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000116015, "chapter_id": 9116, "verse_number": "२-३९-१५", "content_sanskrit": "वासांसि च वरार्हाणि भूषणानि महान्ति च।\nवर्षाण्येतानि संख्याय वैदेह्याः क्षिप्रमानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000116016, "chapter_id": 9116, "verse_number": "२-३९-१६", "content_sanskrit": "नरेन्द्रेणैवमुक्तस्तु गत्वा कोशगृहं ततः।\nप्रायच्छत् सर्वमाहृत्य सीतायै क्षिप्रमेव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000116017, "chapter_id": 9116, "verse_number": "२-३९-१७", "content_sanskrit": "सा सुजाता सुजातानि वैदेही प्रस्थिता वनम्।\nभूषयामास गात्राणि तैर्विचित्रैर्विभूषणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000116018, "chapter_id": 9116, "verse_number": "२-३९-१८", "content_sanskrit": "व्यराजयत वैदेही वेश्म तत् सुविभूषिता।\nउद्यतोंऽशुमतः काले खं प्रभेव विवस्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000116019, "chapter_id": 9116, "verse_number": "२-३९-१९", "content_sanskrit": "तां भुजाभ्यां परिष्वज्य श्वश्रूर्वचनमब्रवीत्।\nअनाचरन्तीं कृपणं मूर्ध्न्युपाघ्राय मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000116020, "chapter_id": 9116, "verse_number": "२-३९-२०", "content_sanskrit": "असत्यः सर्वलोकेऽस्मिन् सततं सत्कृताः प्रियैः।\nभर्तारं नानुमन्यन्ते विनिपातगतं स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000116021, "chapter_id": 9116, "verse_number": "२-३९-२१", "content_sanskrit": "एष स्वभावो नारीणामनुभूय पुरा सुखम्।\nअल्पामप्यापदं प्राप्य दुष्यन्ति प्रजहत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000116022, "chapter_id": 9116, "verse_number": "२-३९-२२", "content_sanskrit": "असत्यशीला विकृता दुर्गा अहृदयाः सदा।\nअसत्यः पापसंकल्पाः क्षणमात्रविरागिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000116023, "chapter_id": 9116, "verse_number": "२-३९-२३", "content_sanskrit": "न कुलं न कृतं विद्या न दत्तं नापि संग्रहः।\nस्त्रीणां गृह्णाति हृदयमनित्यहृदया हि ताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000116024, "chapter_id": 9116, "verse_number": "२-३९-२४", "content_sanskrit": "साध्वीनां तु स्थितानां तु शीले सत्ये श्रुते स्थिते।\nस्त्रीणां पवित्रं परमं पतिरेको विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000116025, "chapter_id": 9116, "verse_number": "२-३९-२५", "content_sanskrit": "स त्वया नावमन्तव्यः पुत्रः प्रव्राजितो वनम्।\nतव देवसमस्त्वेष निर्धनः सधनोऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000116026, "chapter_id": 9116, "verse_number": "२-३९-२६", "content_sanskrit": "विज्ञाय वचनं सीता तस्या धर्मार्थसंहितम्।\nकृत्वाञ्जलिमुवाचेदं श्वश्रूमभिमुखे स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000116027, "chapter_id": 9116, "verse_number": "२-३९-२७", "content_sanskrit": "करिष्ये सर्वमेवाहमार्या यदनुशास्ति माम्।\nअभिज्ञास्मि यथा भर्तुर्वर्तितव्यं श्रुतं च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000116028, "chapter_id": 9116, "verse_number": "२-३९-२८", "content_sanskrit": "न मामसज्जनेनार्या समानयितुमर्हति।\nधर्माद् विचलितुं नाहमलं चन्द्रादिव प्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000116029, "chapter_id": 9116, "verse_number": "२-३९-२९", "content_sanskrit": "नातन्त्री वाद्यते वीणा नाचक्रो विद्यते रथः।\nनापतिः सुखमेधेत या स्यादपि शतात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000116030, "chapter_id": 9116, "verse_number": "२-३९-३०", "content_sanskrit": "मितं ददाति हि पिता मितं भ्राता मितं सुतः।\nअमितस्य तु दातारं भर्तारं का न पूजयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000116031, "chapter_id": 9116, "verse_number": "२-३९-३१", "content_sanskrit": "साहमेवंगता श्रेष्ठा श्रुतधर्मपरावरा।\nआर्ये किमवमन्येयं स्त्रिया भर्ता हि दैवतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000116032, "chapter_id": 9116, "verse_number": "२-३९-३२", "content_sanskrit": "सीताया वचनं श्रुत्वा कौसल्या हृदयङ्गमम्।\nशुद्धसत्त्वा मुमोचाश्रु सहसा दुःखहर्षजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000116033, "chapter_id": 9116, "verse_number": "२-३९-३३", "content_sanskrit": "तां प्राञ्जलिरभिप्रेक्ष्य मातृमध्येऽतिसत्कृताम्।\nरामः परमधर्मात्मा मातरं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000116034, "chapter_id": 9116, "verse_number": "२-३९-३४", "content_sanskrit": "अम्ब मा दुःखिता भूत्वा पश्येस्त्वं पितरं मम।\nक्षयोऽपि वनवासस्य क्षिप्रमेव भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000116035, "chapter_id": 9116, "verse_number": "२-३९-३५", "content_sanskrit": "सुप्तायास्ते गमिष्यन्ति नव वर्षाणि पञ्च च।\nसमग्रमिह सम्प्राप्तं मां द्रक्ष्यसि सुहृद्‍वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000116036, "chapter_id": 9116, "verse_number": "२-३९-३६", "content_sanskrit": "एतावदभिनीतार्थमुक्त्वा स जननीं वचः।\nत्रयः शतशतार्धा हि ददर्शावेक्ष्य मातरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000116037, "chapter_id": 9116, "verse_number": "२-३९-३७", "content_sanskrit": "ताश्चापि स तथैवार्ता मातॄर्दशरथात्मजः।\nधर्मयुक्तमिदं वाक्यं निजगाद कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000116038, "chapter_id": 9116, "verse_number": "२-३९-३८", "content_sanskrit": "संवासात् परुषं किंचिदज्ञानादपि यत् कृतम्।\nतन्मे समुपजानीत सर्वाश्चामन्त्रयामि वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000116039, "chapter_id": 9116, "verse_number": "२-३९-३९", "content_sanskrit": "वचनं राघवस्यैतद् धर्मयुक्तं समाहितम्।\nशुश्रुवुस्ताः स्त्रियः सर्वाः शोकोपहतचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000116040, "chapter_id": 9116, "verse_number": "२-३९-४०", "content_sanskrit": "जज्ञोऽथ तासां संनादः क्रौञ्चीनामिव निःस्वनः।\nमानवेन्द्रस्य भार्याणामेवं वदति राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000116041, "chapter_id": 9116, "verse_number": "२-३९-४१", "content_sanskrit": "मुरजपणवमेघघोषवद्\nदशरथवेश्म बभूव यत् पुरा।\nविलपितपरिदेवनाकुलं\nव्यसनगतं तदभूत् सुदुःखितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000116042, "chapter_id": 9116, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]