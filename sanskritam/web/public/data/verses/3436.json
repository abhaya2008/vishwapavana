[{"id": 2113205, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113206, "chapter_id": 3436, "verse_number": "१", "content_sanskrit": "अपत्यकाम एवं स्यान्ममापत्यं भवेदिति ।\nविप्रं वा गुणसम्पन्नं सर्वभूतहिते रतम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113207, "chapter_id": 3436, "verse_number": "२", "content_sanskrit": "अनुजानीहि भद्रं ते दैवतं हि पतिः स्त्रियाः ।\nयं त्वं वक्ष्यसि धर्मज्ञ देवं ब्राह्मणमेव वा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113208, "chapter_id": 3436, "verse_number": "३", "content_sanskrit": "यथोद्दिष्टं त्वया वीर तत् कर्तास्मि महाभुज ।\nदेवात् पुत्रफलं सद्यो विप्रात् कालान्तरे भवेत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113209, "chapter_id": 3436, "verse_number": "४", "content_sanskrit": "आवाहयामि कं देवं कदा वा भरतर्षभ ।\nतत् त्वदाज्ञां प्रतीक्षन्तीं विद्ध्यस्मिन् कर्मणीप्सिते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113210, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113211, "chapter_id": 3436, "verse_number": "५", "content_sanskrit": "धन्योऽस्म्यनुगृहितोऽस्मि त्वं नो धात्री कुलस्य हि ।\nनमो महर्षये तस्मै येन दत्तो वरस्तव \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113212, "chapter_id": 3436, "verse_number": "६", "content_sanskrit": "न चाधर्मेण धर्मज्ञे शक्याः पालयितुं प्रजाः ।\nतस्मात् त्वं पुत्रलाभाय सन्तानाय ममैव च ।\nप्रवरं सर्वदेवानां धर्ममावाहयाबले \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113213, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113214, "chapter_id": 3436, "verse_number": "७", "content_sanskrit": "पाण्डुना समनुज्ञाता भारतेन यशस्विना ।\nमतिं चक्र्रे महाराज धर्मस्यावाहने तदा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113215, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "पाण्डुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113216, "chapter_id": 3436, "verse_number": "८", "content_sanskrit": "अद्यैव त्वं वरारोहे प्रयतस्व यथाविधि ।\nधर्ममावाहय शुभे स हि देवेषु धर्मभाक् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113217, "chapter_id": 3436, "verse_number": "९", "content_sanskrit": "अधर्मेण न धर्मो वै संयुज्येत कदाचन ।\nलोकश्चापि वरारोहे धर्मोऽयमिति मन्यते \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113218, "chapter_id": 3436, "verse_number": "१०", "content_sanskrit": "धार्मिकश्च कुरूणां स भविष्यति न संशयः ।\nदत्तस्य तस्य धर्मेण नाधर्मे रमते मनः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113219, "chapter_id": 3436, "verse_number": "११", "content_sanskrit": "धर्मादिकं हि धर्मज्ञे धर्मान्तं धर्ममध्यमम् ।\nअपत्यमिष्टं लोकेषु यशःकीर्तिविवर्धनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113220, "chapter_id": 3436, "verse_number": "१२", "content_sanskrit": "ततो धर्मं पुरस्कृत्य नियता त्वं शुचिस्मिते ।\nआकाराचारसम्पन्ना भजस्वाराधय स्वयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113221, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113222, "chapter_id": 3436, "verse_number": "१३", "content_sanskrit": "सा तथोक्ता तथेत्युक्त्वा तेन भर्त्रा वराङ्गना ।\nअभिवाद्याभ्यनुज्ञाता प्रदक्षिणमथाकरोत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113223, "chapter_id": 3436, "verse_number": "१४", "content_sanskrit": "संवत्सरोषिते गर्भे गान्धार्यां जनमेजय ।\nआजुहाव ततो धर्मं कुन्ती पुत्रार्थमच्युतम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2113224, "chapter_id": 3436, "verse_number": "१५", "content_sanskrit": "सा बलिं त्वरिता देवी धर्मायोपजहार ह ।\nजानन्ती धर्ममग्य्रं वै मन्त्रैर्वशमुपानयत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2113225, "chapter_id": 3436, "verse_number": "१६", "content_sanskrit": "आहूतो नियमात् कुन्त्या सर्वभूतैर्नमस्कृतः ।\nददृशे भगवान् धर्मः सन्तानार्थाय पाण्डवे \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2113226, "chapter_id": 3436, "verse_number": "१७", "content_sanskrit": "तस्मिन् बहुमृगेऽरण्ये शतशृङ्गे नगोत्तमे ।\nपाण्डोरर्थे महाभाग कुन्ती धर्ममुपागमत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2113227, "chapter_id": 3436, "verse_number": "१८", "content_sanskrit": "ऋतुकाले शुचिः स्नाता शुक्लवस्त्रा मनस्विनी ।\nशय्यां जगाम सुश्रोणी सह धर्मेण सुव्रता \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2113228, "chapter_id": 3436, "verse_number": "१९", "content_sanskrit": "धर्मेण सह सङ्गम्य योगमूर्तिधरेण सा ।\nलेभे पुत्रं महाभागं सर्वप्राणभृतां हितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2113229, "chapter_id": 3436, "verse_number": "२०", "content_sanskrit": "ऐन्द्रे चन्द्रमसा युक्ते मुहूर्तेऽभिजितेऽष्टमे ।\nदिवामध्यङ्गते सूर्ये तिथौ पुण्येऽभिपूजिते \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2113230, "chapter_id": 3436, "verse_number": "२१", "content_sanskrit": "समृद्धयशसं कुन्ती सुषाव समये सुतम् ।\nजातमात्रे ततस्तस्मिन् वागुवाचाशरीरिणी \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2113231, "chapter_id": 3436, "verse_number": "२२", "content_sanskrit": "एष धर्मभृतां श्रेष्ठो भवितेति विनादिनी ।\nयुधिष्ठिर इति ख्यातः पाण्डोः प्रथमजः सुतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2113232, "chapter_id": 3436, "verse_number": "२३", "content_sanskrit": "अभवत् प्रथितो राजन् त्रिषु लोकेषु वीर्यवान् ।\nयशसा तेजसा चैव वृत्तेन च समन्वितः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2113233, "chapter_id": 3436, "verse_number": "२४", "content_sanskrit": "संवत्सरे द्वितीये तु गान्धार्या उदरं महत्\nन च प्राजायत तदा ततस्तां दुःखमाविशत् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2113234, "chapter_id": 3436, "verse_number": "२५", "content_sanskrit": "श्रुत्वा कुन्तीसुतं जातं बालार्कसमतेजसम् ।\nउदरस्यात्मनःस्थैर्यमुपालभ्य च सौबली \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2113235, "chapter_id": 3436, "verse_number": "२६", "content_sanskrit": "कौरव्यस्यापरिज्ञातं यत्नेन महता स्वयम् ।\nउदरं घातयामास गान्धारी दुःखमूर्च्छिता \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2113236, "chapter_id": 3436, "verse_number": "२७", "content_sanskrit": "ततो जज्ञे मांसपेशी साष्ठीला जनमेजय ।\nद्विवर्षसम्भृतां कुक्षौ तामुत्स्रष्टुं मनो दधे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2113237, "chapter_id": 3436, "verse_number": "२८", "content_sanskrit": "ततो द्वैपायनो राजन् आजगाम यदृच्छया ।\nतां च मांसमयीं पेशीं ददर्श वदतां वरः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2113238, "chapter_id": 3436, "verse_number": "२९", "content_sanskrit": "ततोऽब्रवीत् सौबलेयीं किमिदं ते चिकीर्षितम् ।\nसा चात्मनो मतं सर्वं शशंस परमर्षये \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2113239, "chapter_id": 3436, "verse_number": "३०", "content_sanskrit": "ज्येष्ठं कुन्तीसुतं जातं श्रुत्वा रविसमप्रभम् ।\nदुःखेन परमेणेदमुदरं घातितं मया \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2113240, "chapter_id": 3436, "verse_number": "३१", "content_sanskrit": "शतं च किल पुत्राणां दत्तवानसि मे प्रभो ।\nइयं मांसमयी पेशी जाता पुत्रशताय ते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2113241, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2113242, "chapter_id": 3436, "verse_number": "३२", "content_sanskrit": "एतावदेतद् गान्धारि नैतज्जात्वन्यथा भवेत् ।\nवितथं नोक्तपूर्वं मे स्वैरेष्वपि कदाचन \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2113243, "chapter_id": 3436, "verse_number": "३३", "content_sanskrit": "घृतपूर्णं कुण्डशतं क्षिप्रमानीयतामिति ।\nशीताभिरद्भिराष्ठीलामिमां च परिषिञ्च च \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2113244, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2113245, "chapter_id": 3436, "verse_number": "३४", "content_sanskrit": "संसिच्यमाना साष्ठीला ह्यभवच्छतधा तथा ।\nअङ्गुष्ठपर्वमात्राणां गर्भाणां पृथगेव तु \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2113246, "chapter_id": 3436, "verse_number": "३५", "content_sanskrit": "एकाधिकशतं पूर्णं यथायोगं विशाम्पते ।\nततः कुण्डशतं तत्र ह्यानाय्य तु महान् ऋषिः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2113247, "chapter_id": 3436, "verse_number": "३६", "content_sanskrit": "मांसपेश्यास्तदा राजन् क्रमशः कालपर्ययात् ।\nततस्तान् तेषु कुण्डेषु गर्भान् सर्वान् समादधत् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2113248, "chapter_id": 3436, "verse_number": "३७", "content_sanskrit": "स्वनुगुप्तेषु देशेषु रक्षां चैषां व्यधापयत् ।\nशशंस चैव कृष्णो वै गर्भाणां रक्षणे तथा \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2113249, "chapter_id": 3436, "verse_number": "३८", "content_sanskrit": "उवाच चैनां भगवान् कालेनैतावता पुनः ।\nस्फुटमानेषु कुण्डेषु जातान् जानीहि शोभने \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2113250, "chapter_id": 3436, "verse_number": "३९", "content_sanskrit": "उद्घाटनीयान्येतानि कुण्डानीति च सौबलीम् ।\nइत्युक्त्वा भगवान् व्यासः तथा प्रतिविधाय च \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2113251, "chapter_id": 3436, "verse_number": "४०", "content_sanskrit": "जगाम तपसे श्रीमान् हिमवन्तं शिलोच्चयम् ।\nअह्नोत्तराः कुमारास्ते कुण्डेभ्यस्तु समुत्थिताः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2113252, "chapter_id": 3436, "verse_number": "४१", "content_sanskrit": "तेनैवैषां क्रमेणासीज्ज्येष्ठानुज्येष्ठता तदा ।\nजन्मतश्च प्रमाणेन ज्येष्ठः कुन्तीसुतोऽभवत् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2113253, "chapter_id": 3436, "verse_number": "४२", "content_sanskrit": "धार्मिकं च सुतं दृष्ट्वा पाण्डुः कुन्तीमथाब्रवीत् ।\nप्राहुः क्षत्रं बलज्येष्ठं बलज्येष्ठं सुतं वृणु \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2113254, "chapter_id": 3436, "verse_number": "४३", "content_sanskrit": "ततः कुन्तीमभिक्रम्य शशंसातीव भारत ।\nवायुमावाहयस्वेति स देवो बलवत्तरः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2113255, "chapter_id": 3436, "verse_number": "४४", "content_sanskrit": "अश्वमेधः क्रतुश्रेष्ठो ज्योतिःश्रेष्ठो दिवाकरः ।\nब्राह्मणो द्विपदां श्रेष्ठो देवश्रेष्ठस्तु मारुतः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2113256, "chapter_id": 3436, "verse_number": "४५", "content_sanskrit": "मारुतं मरुतां श्रेष्ठं सर्वप्राणिभिरीडितम् ।\nआवाहय त्वं नियमात् पुत्रार्थं वरवर्णिनि \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2113257, "chapter_id": 3436, "verse_number": "४६", "content_sanskrit": "स नो यं दास्यति सुतं स प्राणबलवान् नृषु ।\nभविष्यति वरारोहे बलज्येष्ठा हि भूमिपाः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2113258, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2113259, "chapter_id": 3436, "verse_number": "४७", "content_sanskrit": "तथोक्तवति सा काले वायुमेवाजुहाव ह ।\nद्वितीयेनोपहारेण तेनोक्तविधिना पुनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2113260, "chapter_id": 3436, "verse_number": "४८", "content_sanskrit": "तैरेव नियमैः स्थित्वा मन्त्रग्राममुदैरयत् ।\nआजगाम ततो वायुः किं करोमीति चाब्रवीत् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2113261, "chapter_id": 3436, "verse_number": "४९", "content_sanskrit": "लज्जानता ततः कुन्ती पुत्रमैच्छत् महाबलम् ।\nतथास्त्विति च तां वायुः समालङ्ग्यि दिवं गतः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2113262, "chapter_id": 3436, "verse_number": "५०", "content_sanskrit": "तस्माज्जातो महावीर्यो भीमो भीमपराक्रमः ।\nतमप्यतिबलं जातं वागुवाचाशरीरिणी \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2113263, "chapter_id": 3436, "verse_number": "५१", "content_sanskrit": "सर्वेषां बलिनां श्रेष्ठो जातोऽयमिति भारत ।\nजातमात्रे कुमारे तु सर्वलोकस्य पार्थिवाः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2113264, "chapter_id": 3436, "verse_number": "५२", "content_sanskrit": "मूत्रं प्रसुस्रुवुः सर्वे व्यथां चापि प्रपेदिरे ।\nवाहनानि व्यशीर्यन्त व्यमुञ्चन्नश्रुबिन्दवः \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2113265, "chapter_id": 3436, "verse_number": "५३", "content_sanskrit": "यथाऽनिलः समुद्भूतः समर्थः कम्यते भुवः ।\nतथा ह्युपचिताङ्गो वै भीमो भीमपराक्रमः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2113266, "chapter_id": 3436, "verse_number": "५४", "content_sanskrit": "इदं चाद्भुतमत्रासीज्जातमात्रे वृकोदरे ।\nकुन्ती तु सह पुत्रेण याता सुरुचिरं सरः \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2113267, "chapter_id": 3436, "verse_number": "५५", "content_sanskrit": "स्नात्वा च सुतमादाय दशमेऽहनि यादवी ।\nदैवतान्यर्चयिष्यन्ती निर्जगामाश्रमात् पृथा\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2113268, "chapter_id": 3436, "verse_number": "५६", "content_sanskrit": "शैलाभ्याशेन गच्छन्त्यास्तदा भरतसत्तम ।\nनिश्चक्राम महाव्याघ्रो जिघांसुर्गिरिगह्वरात् \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2113269, "chapter_id": 3436, "verse_number": "५७", "content_sanskrit": "तमापतन्तं शार्दूलं विकृष्य धनुरुत्तमम् ।\nनिर्बिभेदे शरैः पाण्डुः त्रिभिस्त्रिदशविक्रमः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2113270, "chapter_id": 3436, "verse_number": "५८", "content_sanskrit": "नादेन महता तां तु पूरयन्तं गिरेर्गुहाम् ।\nदृष्ट्वा शैलमुपारोढुमैच्छत् कुन्ती भयात् तदा\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2113271, "chapter_id": 3436, "verse_number": "५९", "content_sanskrit": "त्रासेनास्याः सुतस्त्वङ्कात् पपात भरतर्षभ ।\nपर्वतस्योपरिस्थाया अधस्तादपतच्छिशुः \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2113272, "chapter_id": 3436, "verse_number": "६०", "content_sanskrit": "स शिलाश्चूर्णयामास वज्रिचोदितवज्रवत् ।\nपुत्रस्नेहात् ततः पाण्डुरभ्यधावद् गिरेस्तटम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2113273, "chapter_id": 3436, "verse_number": "६१", "content_sanskrit": "पतता तेन शतधा शिला गात्रैर्विचूर्णिता ।\nशिलां च चूर्णितां दृष्ट्वा परं विस्मयमागमत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2113274, "chapter_id": 3436, "verse_number": "६२", "content_sanskrit": "स तु जन्मनि भीमस्य विनदन्तं विनादितम् ।\nददर्श गिरिशृङ्गस्थं व्याघ्रं व्याघ्रपराक्रमः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2113275, "chapter_id": 3436, "verse_number": "६३", "content_sanskrit": "दारसंरक्षणार्थाय रक्षमाणस्तथाऽऽत्मजम् ।\nसदा बाणधनुष्पाणिरभवत् कुरुनन्दनः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2113276, "chapter_id": 3436, "verse_number": "६४", "content_sanskrit": "मघे चन्द्रमसा युक्ते सिंहे चाभ्युदिते गुरौ ।\nदिवामध्यगते सूर्ये तिथौ पुण्ये त्रयोदशे\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2113277, "chapter_id": 3436, "verse_number": "६५", "content_sanskrit": "मैत्रे मुहूर्ते सा कुन्ती सुषुवे भीममच्युतम् ।\nयस्मिन्नहनि भीमस्तु जज्ञे भीमपराक्रमः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2113278, "chapter_id": 3436, "verse_number": "६६", "content_sanskrit": "तामेव रात्रिं पूर्वं तु जज्ञे दुर्योधनो नृपः ।\nदुर्योधने जातमात्रे दिक्षु सर्वासु भारत \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2113279, "chapter_id": 3436, "verse_number": "६७", "content_sanskrit": "क्रव्यादाः प्राणदन् घोराः शिवाश्चाशिवनिस्वनाः ।\nववर्ष रुधिरं देवो भयमावेदयन् महत् \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2113280, "chapter_id": 3436, "verse_number": "६८", "content_sanskrit": "एतस्मिन्नन्तरे राजा धृतराष्ट्रोऽम्बिकासुतः ।\nसमाहूय बहून् विप्रान् विदुरं चेदमब्रवीत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2113281, "chapter_id": 3436, "verse_number": "६९", "content_sanskrit": "श्रुतं मया यथा जातो ज्येष्ठः पाण्डोः सुतः किल ।\nस तु दुर्योधनाज्ज्येष्ठः तस्मिन् राज्यं न संशयः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2113282, "chapter_id": 3436, "verse_number": "७०", "content_sanskrit": "अयं त्वनन्तरं तस्मादधिराजो भविष्यति ।\nएतं विब्रूत मे प्रश्नं यद्वाऽस्मिन् दृश्यते फलम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2113283, "chapter_id": 3436, "verse_number": "७१", "content_sanskrit": "अस्मिन् जाते निमित्तानि संशयन्त्यशिवं महत् ।\nअतो ब्रवीमि विदुर ब्रूत मां भयमाविशत् \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2113284, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2113285, "chapter_id": 3436, "verse_number": "७२", "content_sanskrit": "वाक्यस्यैतस्य निधने दिक्षु सर्वासु भारत ।\nक्रव्यादाः प्राणदन् घोराः शिवाश्चाशिवशंसिनः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2113286, "chapter_id": 3436, "verse_number": "७३", "content_sanskrit": "लक्षयित्वा निमित्तानि तानि सर्वाणि भारत ।\nतेऽब्रुवन् ब्राह्मणा राजन् विदुरश्च महामतिः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2113287, "chapter_id": 3436, "verse_number": "७४", "content_sanskrit": "अयं कुलान्तकृज्जातो यस्माच्च कुलपांसनः ।\nतस्य त्यागेन शान्तिः स्यात् पुष्टिस्त्वपनये भवेत् \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2113288, "chapter_id": 3436, "verse_number": "७५", "content_sanskrit": "शतमेकोनमप्यस्तु पुत्राणां ते महीपते ।\nएकेन कुरु नः क्षेमं लोकस्य च कुलस्य च \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2113289, "chapter_id": 3436, "verse_number": "७६", "content_sanskrit": "त्यजेदेकं कुलस्यार्थे ग्रामस्यार्थे कुलं त्यजेत् ।\nग्रामं जनपदस्यार्थे आत्मार्थे पृथिवीं त्यजेत् \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2113290, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2113291, "chapter_id": 3436, "verse_number": "७७", "content_sanskrit": "स तथा विदुरेणोक्तः तैश्च विप्रैर्जनाधिपः ।\nन चकार तदा राजा पुत्रस्नेहसमन्वितः \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2113292, "chapter_id": 3436, "verse_number": "७८", "content_sanskrit": "ततः पुत्रशतं सर्वं धृतराष्ट्रस्य भारत ।\nअह्नां शतेन सञ्जज्ञे कन्या चैका शतात् परा\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2113293, "chapter_id": 3436, "verse_number": "७९", "content_sanskrit": "गान्धार्यां क्लिश्यमानायां वर्धमाने तथोदरे ।\nवैश्या सा त्वम्बिकापुत्रं कन्या परिचचार ह\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2113294, "chapter_id": 3436, "verse_number": "८०", "content_sanskrit": "तया समभवद् राजा धृतराष्ट्रो यदृच्छया ।\nतस्यामजनयत् पुत्रं युयुत्सुं नाम भारत\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2113295, "chapter_id": 3436, "verse_number": "८१", "content_sanskrit": "इत्थमेकशतं जज्ञे पुत्राणां भरतर्षभ ।\nमहारथानां वीराणां कन्या चैकाऽथ दुःशला ।\nधृतराष्ट्रस्य राजेन्द्र यथा ते कथितं मया\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2113296, "chapter_id": 3436, "verse_number": "११५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चदशाधिकशततमोऽध्यायः ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2113297, "chapter_id": 3436, "verse_number": "६३", "content_sanskrit": "॥ इति सम्भवपर्वणि त्रिषष्टितमोऽध्यायः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2113298, "chapter_id": 3436, "verse_number": "", "content_sanskrit": "—०—–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]