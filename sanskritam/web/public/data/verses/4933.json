[{"id": 2185296, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185297, "chapter_id": 4933, "verse_number": "१", "content_sanskrit": "कच्चित् पितामहेनासीच्छ्रुतं वा दृष्टमेव च ।\nकच्चिन्मन्ये मृतो राजन् पुनरुज्जीवितोऽभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185298, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185299, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "शृणु पार्थ यथावृत्तमितिहासं पुरातनम् ।\nगृध्रजम्बुकसंवादं यो वृत्तो वैदशे पुरा\t॥२।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185300, "chapter_id": 4933, "verse_number": "३", "content_sanskrit": "कस्यचिद् ब्राह्मणस्यासीद् दुःखलब्धः सुतो मृतः ।\nबाल एव विशालाक्षो बालग्रहनिपीडितः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185301, "chapter_id": 4933, "verse_number": "४", "content_sanskrit": "दुःखिताः केचिदादाय बालमप्राप्तयौवनम् ।\nकुलसर्वस्वभूतं वै रुदन्तः शोकविह्वलाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185302, "chapter_id": 4933, "verse_number": "५", "content_sanskrit": "बालं मृतं गृहीत्वाथ श्मशानाभिमुखाः स्थिताः ।\nअङ्केनाङ्कं च सङ्क्रम्य रुरुदुर्भूतले तदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185303, "chapter_id": 4933, "verse_number": "६", "content_sanskrit": "शोचन्तस्तस्य पूर्वोक्तान् भाषिताश्चासकृत् पुनः ।\nतं बालं भूतले क्षिप्य प्रतिगन्तुं न शक्नुयुः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185304, "chapter_id": 4933, "verse_number": "७", "content_sanskrit": "तेषां रुदितशब्देन गृध्रोऽभ्येत्य वचोऽब्रवीत् ।\nएकात्मकमिदं लोके त्यक्त्वा गच्छत माचिरम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185305, "chapter_id": 4933, "verse_number": "८", "content_sanskrit": "इह पुंसां सहस्राणि स्त्रीसहस्राणि चैव हि ।\nसमानीतानि कालेन किं ते वै जात्वबान्धवाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185306, "chapter_id": 4933, "verse_number": "९", "content_sanskrit": "सम्पश्यत जगत् सर्वं सुखदुःखैरधिष्ठितम् ।\nसंयोगो विप्रयोगश्च पर्यायेणोपलभ्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185307, "chapter_id": 4933, "verse_number": "१०", "content_sanskrit": "गृहीत्वा येऽनुगृह्णन्ति अनुयान्ति च ये गुणात् ।\nतेऽप्यायुषः प्रमाणेन तेन गच्छन्ति जन्तवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185308, "chapter_id": 4933, "verse_number": "११", "content_sanskrit": "अलं स्थित्वा श्मशानेऽस्मिन् गृध्रगोमायुसङ्कुले ।\nकृकालबहुले घोरे सर्वप्राणिभयङ्करे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185309, "chapter_id": 4933, "verse_number": "१२", "content_sanskrit": "न पुनर्जीवितः कश्चित् कालधर्ममुपागतः ।\nप्रियो वा यदि वा द्वेष्यः प्राणिनां गतिरीदृशी\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185310, "chapter_id": 4933, "verse_number": "१३", "content_sanskrit": "सर्वेण खलु मर्तव्यं मर्त्यलोके प्रसूयता ।\nकृतान्तविहिते मार्गे को मृतं जीवयिष्यति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185311, "chapter_id": 4933, "verse_number": "१४", "content_sanskrit": "दिशान्तोपरते काले चास्तं गच्छति भास्करे ।\nगम्यतां स्वमधिष्ठानं सुतस्नेहं विसृज्य वै\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2185312, "chapter_id": 4933, "verse_number": "१५", "content_sanskrit": "ततो गृध्रवचः श्रुत्वा विक्रोशन्तस्तदा नृप ।\nबान्धवास्तेऽभ्यगच्छन्त पुत्रमुत्सृज्य भूतले\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2185313, "chapter_id": 4933, "verse_number": "१६", "content_sanskrit": "विनिश्चित्याथ च ततः सन्त्यजन्तः स्वमात्मजम् ।\nनिराशा जीविते तस्य मार्गमारुह्य धिष्ठिताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2185314, "chapter_id": 4933, "verse_number": "१७", "content_sanskrit": "ध्वाङ्क्षरूक्षे विवर्णस्तु बिलान्निःसृत्य जम्बुकः ।\nगच्छमानान्स्म तानाह निर्घृणाः खलु मानवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2185315, "chapter_id": 4933, "verse_number": "१८", "content_sanskrit": "आदित्योऽयं स्थितो मूढाः स्नेहं कुरुत मा भयम् ।\nबहुरूपो मुहूर्तश्च जीवेतापि कदाचन\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2185316, "chapter_id": 4933, "verse_number": "१९", "content_sanskrit": "यूयं भूमौ विनिक्षिप्य पुत्रस्नेहविनाकृताः ।\nश्मशाने पुत्रमुत्सृज्य कस्माद्गच्छथ निर्घृणाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2185317, "chapter_id": 4933, "verse_number": "२०", "content_sanskrit": "न वोऽस्त्यस्मिन् सुते स्नेहो बाले मधुरभाषिणि ।\nयस्य रावितमात्रेण प्रसादमुपगच्छथ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2185318, "chapter_id": 4933, "verse_number": "२१", "content_sanskrit": "न पश्यथ सुतस्नेहो यादृशः पशुपक्षिणाम् ।\nन येषां धारयित्वा तान् कश्चिदस्ति फलागमः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2185319, "chapter_id": 4933, "verse_number": "२२", "content_sanskrit": "चतुष्पात्पक्षिकीटानां प्राणिनां स्नेहसङ्गिनाम् ।\nपरलोकगतिस्थानां मुनियज्ञक्रिया इव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2185320, "chapter_id": 4933, "verse_number": "२३", "content_sanskrit": "तेषां पुत्राभिरामाणामिह लोके परत्र च ।\nन गुणो दृश्यते कश्चित् प्रजाः सन्धारयन्ति च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2185321, "chapter_id": 4933, "verse_number": "२४", "content_sanskrit": "अपश्यतां प्रियान् पुत्रान्नैषां शोकोऽनुतिष्ठति ।\nन च पुष्णन्ति संवृद्धास्ते मातापितरौ क्वचित्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2185322, "chapter_id": 4933, "verse_number": "२५", "content_sanskrit": "मानुषाणां कुतः स्नेहो येषां शोको भविष्यति ।\nइमं कुलकरं पुत्रं कथं त्यक्त्वा गमिष्यथ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2185323, "chapter_id": 4933, "verse_number": "२६", "content_sanskrit": "चिरभूतं च बालं च चिरं स्नेहेन पश्यत ।\nएवंविधानि हीष्टानि दुस्त्यजानि विशेषतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2185324, "chapter_id": 4933, "verse_number": "२७", "content_sanskrit": "क्षीणस्याथाभियुक्तस्य श्मशानाभिमुखस्य च ।\nबान्धवा यत्र तिष्ठन्ति तत्रान्यो नावतिष्ठते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2185325, "chapter_id": 4933, "verse_number": "२८", "content_sanskrit": "सर्वस्य दयिताः प्राणाः सर्वः स्नेहं च विन्दति ।\nतिर्यग्योनिष्वपि सतां स्नेहं पश्यत यादृशम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2185326, "chapter_id": 4933, "verse_number": "२९", "content_sanskrit": "त्यक्त्वा कथं गच्छेथेमं पद्मलोलायताक्षकम् ।\nयथा नवोद्वाहकृतं स्नानमाल्यविभूषितम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2185327, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2185328, "chapter_id": 4933, "verse_number": "३०", "content_sanskrit": "जम्बुकस्य वचः श्रुत्वा कृपणं परिदेवतः ।\nन्यवर्तन्त तदा सर्वे शवार्थं ते स्म मानुषाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2185329, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "गृध्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2185330, "chapter_id": 4933, "verse_number": "३१", "content_sanskrit": "अहो धिक्सुनृशंसेन जम्बुकेनाल्पमेधसा ।\nक्षुद्रेणोक्ता हीनसत्त्वा मानुषाः किं निवर्तथ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2185331, "chapter_id": 4933, "verse_number": "३२", "content_sanskrit": "पञ्चभूतपरित्यक्तं शून्यं काष्ठत्वमागतम् ।\nकस्माच्छोचथ निश्चेष्टमात्मानं किं न शोचथ\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2185332, "chapter_id": 4933, "verse_number": "३३", "content_sanskrit": "तपः कुरुत वै तीव्रं मुच्यध्वं येन किल्बिषात् ।\nतपसा लभ्यते सर्वं विलापः किं करिष्यति\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2185333, "chapter_id": 4933, "verse_number": "३४", "content_sanskrit": "स्वनिष्टानि च भोज्यानि जानीत स्वं स्वमात्मना ।\nयेन गच्छति लोकोऽयं दत्त्वा शोकमनन्तकम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2185334, "chapter_id": 4933, "verse_number": "३५", "content_sanskrit": "धेनुर्गौश्च सुवर्णं च मणिरत्नमथापि च ।\nअपत्यं च तयोर्मूलं तपोयोगाच्च लभ्यते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2185335, "chapter_id": 4933, "verse_number": "३६", "content_sanskrit": "यथाकृत्वा च भूतेषु प्राप्यते सुखदुःखता ।\nगृहीत्वा जायते जन्तुर्दुःखानि च सुखानि च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2185336, "chapter_id": 4933, "verse_number": "३७", "content_sanskrit": "न कर्मणा पितुः पुत्रः पिता वा पुत्रकर्मणा ।\nमार्गेणान्येन गच्छन्ति विद्धाः सुकृतदुष्कृतैः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2185337, "chapter_id": 4933, "verse_number": "३८", "content_sanskrit": "धर्मं चरत यत्नेन तथाधर्मान्निवर्तत ।\nवर्तध्वं च यथाकालं दैवतेषु द्विजेषु च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2185338, "chapter_id": 4933, "verse_number": "३९", "content_sanskrit": "शोकं त्यजत दैन्यं च सुतस्नेहान्निवर्तत ।\nत्यज्यतामयमाकाशे ततः शीघ्रं निवर्तत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2185339, "chapter_id": 4933, "verse_number": "४०", "content_sanskrit": "यत् करोति शुभं कर्म तथाधर्मं सुदारुणम् ।\nतत् कर्तैव समश्नाति बान्धवानां किमत्र हि\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2185340, "chapter_id": 4933, "verse_number": "४१", "content_sanskrit": "इह त्यक्त्वा न तिष्ठन्ति बान्धवा बान्धवं प्रियम् ।\nस्नेहमुत्सृज्य गच्छन्ति बाष्पपूर्णाविलेक्षणाः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2185341, "chapter_id": 4933, "verse_number": "४२", "content_sanskrit": "प्राज्ञो वा यदि वा मूर्खः सधनो निर्धनोऽपि वा ।\nसर्वः कालवशं याति शुभाशुभसमन्वितः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2185342, "chapter_id": 4933, "verse_number": "४३", "content_sanskrit": "किं करिष्यथ शोचित्वा मृतं किमनुशोचथ ।\nसर्वस्य हि प्रभुः कालो धर्मतः समदर्शनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2185343, "chapter_id": 4933, "verse_number": "४४", "content_sanskrit": "यौवनस्थांश्च बालांश्च वृद्धान् गर्भगतानपि ।\nसर्वानाविशते मृत्युरेवम्भूतमिदं जगत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2185344, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2185345, "chapter_id": 4933, "verse_number": "४५", "content_sanskrit": "अहो मन्दीकृतः स्नेहो गृध्रेणेहाल्पमेधसा ।\nपुत्रस्नेहाभिभूतानां युष्माकं शोचतां भृशम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2185346, "chapter_id": 4933, "verse_number": "४६", "content_sanskrit": "समैः सम्यक्प्रयुक्तैश्च वचनैः प्रश्रयोत्तरैः ।\nयद्गच्छथ जलस्थायं स्नेहमुत्सृज्य दुस्त्यजम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2185347, "chapter_id": 4933, "verse_number": "४७", "content_sanskrit": "अहो पुत्रवियोगेन मृतशून्योपसेवनात् ।\nक्रोशतां वै भृशं दुःखं विवत्सानां गवामिव\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2185348, "chapter_id": 4933, "verse_number": "४८", "content_sanskrit": "अद्य शोकं विजानामि मानुषाणां महीतले ।\nस्नेहं हि करुणं दृष्ट्वा ममाप्यश्रूण्यथागमन्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2185349, "chapter_id": 4933, "verse_number": "४९", "content_sanskrit": "यत्नो हि सततं कार्यः कृतो दैवेन सिध्यति ।\nदैवं पुरुषकारश्च कृतान्तेनोपपद्यते\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2185350, "chapter_id": 4933, "verse_number": "५०", "content_sanskrit": "अनिर्वेदः सदा कार्यो निर्वेदाद्धि कुतः सुखम् ।\nप्रयत्नात् प्राप्यते ह्यर्थः कस्माद् गच्छथ निर्दयाः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2185351, "chapter_id": 4933, "verse_number": "५१", "content_sanskrit": "आत्ममांसोपवृत्तं च शरीरार्धमयीं तनुम् ।\nपितॄणां वंशकर्तारं वने त्यक्त्वा क्व यास्यथ\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2185352, "chapter_id": 4933, "verse_number": "५२", "content_sanskrit": "अथ वास्तं गते सूर्ये सन्ध्याकाल उपस्थिते ।\nततो नेष्यथ वा पुत्रमिहस्था वा भविष्यथ\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2185353, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "गृध्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2185354, "chapter_id": 4933, "verse_number": "५३", "content_sanskrit": "अद्य वर्षसहस्रं मे साग्रं जातस्य मानुषाः ।\nन च पश्यामि जीवन्तं मृतं स्त्रीपुंनपुंसकम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2185355, "chapter_id": 4933, "verse_number": "५४", "content_sanskrit": "मृता गर्भेषु जायन्ते म्रियन्ते जातमात्रकाः ।\nविक्रमन्तो म्रियन्ते च यौवनस्थास्तथापरे\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2185356, "chapter_id": 4933, "verse_number": "५५", "content_sanskrit": "अनित्यानीह भाग्यानि चतुष्पात्पक्षिणामपि ।\nजङ्गमाजङ्गमानां चाप्यायुरग्रेऽवतिष्ठते\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2185357, "chapter_id": 4933, "verse_number": "५६", "content_sanskrit": "इष्टदारवियुक्ताश्च पुत्रशोकान्वितास्तथा ।\nदह्यमानाः स्म शोकेन गृहं गच्छन्ति नित्यदा\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2185358, "chapter_id": 4933, "verse_number": "५७", "content_sanskrit": "अनिष्टानां सहस्राणि तथेष्टानां शतानि च ।\nउत्सृज्येह प्रयाता वै बान्धवा भृशदुःखिताः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2185359, "chapter_id": 4933, "verse_number": "५८", "content_sanskrit": "त्यज्यतामेष निस्तेजाः शून्यः काष्ठत्वमागतः ।\nअन्यदेहविषक्तो हि शावं काष्ठमुपासते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2185360, "chapter_id": 4933, "verse_number": "५९", "content_sanskrit": "भ्रान्तजीवस्य वै बाष्पं कस्माद्धित्वा न गच्छथ ।\nनिरर्थको ह्ययं स्नेहो निरर्थश्च परिश्रमः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2185361, "chapter_id": 4933, "verse_number": "६०", "content_sanskrit": "न चक्षुर्भ्यां न कर्णाभ्यां संशृणोति समीक्षते ।\nतस्मादेनं समुत्सृज्य स्वगृहान् गच्छताशु वै\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2185362, "chapter_id": 4933, "verse_number": "६१", "content_sanskrit": "मोक्षधर्माश्रितैर्वाक्यैर्हेतुमद्भिरनिष्ठुरैः ।\nमयोक्ता गच्छत क्षिप्रं स्वं स्वमेव निवेशनम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2185363, "chapter_id": 4933, "verse_number": "६३", "content_sanskrit": "प्रज्ञाविज्ञानयुक्तेन बुद्धिसञ्ज्ञाप्रदायिना ।\nवचनं श्राविता नूनं मानुषाः सन्निवर्तत\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2185364, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2185365, "chapter_id": 4933, "verse_number": "६३", "content_sanskrit": "इमं कनकवर्णाभं भूषणैः समलङ्कृतम् ।\nगृध्रवाक्यात् कथं पुत्रं त्यजध्वं पितृपिण्डदम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2185366, "chapter_id": 4933, "verse_number": "६४", "content_sanskrit": "न स्नेहस्य विरोधोऽस्ति विलापरुदितस्य वै ।\nमृतस्यास्य परित्यागात् तपो वै भविता ध्रुवम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2185367, "chapter_id": 4933, "verse_number": "६५", "content_sanskrit": "श्रूयते शम्बुके शूद्रे हते ब्राह्मणदारकः ।\nजीवितो धर्ममासाद्य रामात् सत्यपराक्रमात्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2185368, "chapter_id": 4933, "verse_number": "६६", "content_sanskrit": "तथा श्वेतस्य राजर्षेर्बालो दिष्टान्तमागतः ।\nश्वोऽभूते धर्मनित्येन मृतः सञ्जीवितः पुनः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2185369, "chapter_id": 4933, "verse_number": "६७", "content_sanskrit": "तथा कश्चिद् भवेत् सिद्धो मुनिर्वा देवतापि वा ।\nकृपणानामनुक्रोशं कुर्याद्वो रुदतामिह\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2185370, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2185371, "chapter_id": 4933, "verse_number": "६८", "content_sanskrit": "इत्युक्ताः सन्न्यवर्तन्त शोकार्ताः पुत्रवत्सलाः ।\nअङ्के शिरः समाधाय रुरुदुर्बहुविस्तरम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2185372, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "गृध्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2185373, "chapter_id": 4933, "verse_number": "६९", "content_sanskrit": "अश्रुपातपरिक्लिन्नः पाणिस्पर्शनपीडितः ।\nधर्मराजप्रयोगाच्च दीर्घां निद्रां प्रवेशितः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2185374, "chapter_id": 4933, "verse_number": "७०", "content_sanskrit": "तपसापि हि संयुक्तो नकाले नोपहन्यते ।\nसर्वस्नेहावसानं तदिदं तत् प्रेतपत्तनम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2185375, "chapter_id": 4933, "verse_number": "७१", "content_sanskrit": "बालवृद्धसहस्राणि सदा सन्त्यज्य बान्धवाः ।\nदिनानि चैव रात्रीश्च दुःखं तिष्ठन्ति भूतले\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2185376, "chapter_id": 4933, "verse_number": "७२", "content_sanskrit": "अलं निर्बन्धमागम्य शोकस्य परिवारणम् ।\nसम्प्रत्ययकृतोऽप्यस्य पुनरद्येह जीवितम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2185377, "chapter_id": 4933, "verse_number": "७३", "content_sanskrit": "नैष जम्बुकवाक्येन पुनः प्राप्स्यति जीवितम् ।\nभूतस्योत्सृष्टदेहस्य पुनर्देहो न विद्यते\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2185378, "chapter_id": 4933, "verse_number": "७४", "content_sanskrit": "न वै मूर्तिप्रदानेन न जम्बुकशतैरपि ।\nशक्यो जीवयितुं ह्येष बालो वर्षशतैरपि\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2185379, "chapter_id": 4933, "verse_number": "७५", "content_sanskrit": "अपि रुद्रः कुमारो वा ब्रह्मा वा विष्णुरेव वा ।\nवरमस्मै प्रयच्छेयुस्ततो जीवेदयं शिशुः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2185380, "chapter_id": 4933, "verse_number": "७६", "content_sanskrit": "न च बाष्पविमोक्षेण न चाश्वासकृतेन वै ।\nन दीर्घरुदितेनेह पुनर्जीवो भविष्यति\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2185381, "chapter_id": 4933, "verse_number": "७७", "content_sanskrit": "अहं च क्रोष्टुकश्चैव यूयं चैवास्य बान्धवाः ।\nधर्माधर्मौ गृहीत्वेह सर्वे वर्तामहेऽध्वनि\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2185382, "chapter_id": 4933, "verse_number": "७८", "content_sanskrit": "अप्रियं परुषं चापि परद्रोहं परस्त्रियम् ।\nअधर्ममनृतं चैव दूरात् प्राज्ञो निवर्तयेत्\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2185383, "chapter_id": 4933, "verse_number": "७९", "content_sanskrit": "सत्यं धर्मं शुभं न्याय्यं प्राणिनां महतीं दयाम् ।\nअजिह्मत्वमशाठ्यं च यत्नतः परिमार्गत\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2185384, "chapter_id": 4933, "verse_number": "८०", "content_sanskrit": "मातरं पितरं चैव बान्धवान् सुहृदस्तथा ।\nजीवतो ये न पश्यन्ति तेषां धर्मविपर्ययः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2185385, "chapter_id": 4933, "verse_number": "८१", "content_sanskrit": "यो न पश्यति चक्षुर्भ्यां नेङ्गते च कथञ्चन ।\nतस्य निष्ठावसानान्ते रुदन्तः किं करिष्यथ\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2185386, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2185387, "chapter_id": 4933, "verse_number": "८२", "content_sanskrit": "इत्युक्तास्तं सुतं त्यक्त्वा भूमौ शोकपरिप्लुताः ।\nदह्यमानाः सुतस्नेहात् प्रययुर्बान्धवा गृहान्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2185388, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2185389, "chapter_id": 4933, "verse_number": "८३", "content_sanskrit": "दारुणो मर्त्यलोकोऽयं सर्वप्राणिविनाशनः ।\nइष्टबन्धुवियोगश्च तथैवाल्पं च जीवितम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2185390, "chapter_id": 4933, "verse_number": "८४", "content_sanskrit": "बह्वलीकमसत्यं च प्रतिवादाप्रियंवदम् ।\nइमं प्रेक्ष्य पुनर्भावं दुःखशोकाभिवर्धनम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2185391, "chapter_id": 4933, "verse_number": "८५", "content_sanskrit": "न मे मानुषलोकोऽयं मुहूर्तमपि रोचते ।\nअहो धिग्गृध्रवाक्येन सन्निवर्तथ मानुषाः\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2185392, "chapter_id": 4933, "verse_number": "८६", "content_sanskrit": "प्रदीप्ताः पुत्रशोकेन यथैवाबुद्धयस्तथा ।\nकथं गच्छथ सस्नेहाः सुतस्नेहं विसृज्य च ।\nश्रुत्वा गृध्रस्य वचनं पापस्येहाकृतात्मनः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2185393, "chapter_id": 4933, "verse_number": "८७", "content_sanskrit": "सुखस्यानन्तरं दुःखं दुःखस्यानन्तरं सुखम् ।\nसुखदुःखान्विते लोके नेहास्त्येकमनन्तकम्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2185394, "chapter_id": 4933, "verse_number": "८८", "content_sanskrit": "इमं क्षितितले न्यस्य बालं रूपसमन्वितम् ।\nकुलशोभाकरं मूढाः पुत्रं त्यक्त्वा क्व यास्यथ\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2185395, "chapter_id": 4933, "verse_number": "८९", "content_sanskrit": "रूपयौवनसम्पन्नं द्योतमानमिव श्रिया ।\nजीवन्तमेनं पश्यामि मनसा नात्र संशयः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2185396, "chapter_id": 4933, "verse_number": "९०", "content_sanskrit": "विनाशश्चाप्यनर्होऽस्य सुखं प्राप्स्यथ मानुषाः ।\nपुत्रशोकाग्निदग्धानां मृतमप्यद्य न क्षमम्\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2185397, "chapter_id": 4933, "verse_number": "९१", "content_sanskrit": "दुःखसम्भावनां कृत्वा धारयित्वा स्वयं सुखम् ।\nत्यक्त्वा गमिष्यथ क्वाद्य समुत्सृज्याल्पबुद्धिवत्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2185398, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2185399, "chapter_id": 4933, "verse_number": "९२", "content_sanskrit": "तथा धर्मविरोधेन प्रियमिथ्याभिध्यायिना ।\nश्मशानवासिना नित्यं रतिं मृगयता तदा\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2185400, "chapter_id": 4933, "verse_number": "९३", "content_sanskrit": "ततो मध्यस्थतां नीता वचनैरमृतोपमैः ।\nजम्बुकेन स्वकार्यार्थं बान्धवास्तस्य धिष्ठिताः\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2185401, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "गृध्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2185402, "chapter_id": 4933, "verse_number": "९४", "content_sanskrit": "अयं प्रेतसमाकीर्णो यक्षराक्षससेवितः ।\nदारुणः काननोद्देशः कौशिकैरभिनादितः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2185403, "chapter_id": 4933, "verse_number": "९५", "content_sanskrit": "भीमः सुघोरश्च तथा नीलमेघसमप्रभः ।\nअस्मिञ्शवं परित्यज्य प्रेतकार्याण्युपासत\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2185404, "chapter_id": 4933, "verse_number": "९६", "content_sanskrit": "भानुर्यावन्न यात्यस्तं यावच्च विमला दिशः ।\nतावदेनं परित्यज्य प्रेतकार्याण्युपासत\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2185405, "chapter_id": 4933, "verse_number": "९७", "content_sanskrit": "नदन्ति परुषं श्येनाः शिवाः क्रोशन्ति दारुणाः ।\nमृगेन्द्राः प्रतिनन्दन्ति रविरस्तं च गच्छति\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2185406, "chapter_id": 4933, "verse_number": "९८", "content_sanskrit": "चिताधूमेन नीलेन संरज्यन्ते च पादपाः ।\nश्मशाने च निराहाराः प्रतिनन्दन्ति देहिनः\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2185407, "chapter_id": 4933, "verse_number": "९९", "content_sanskrit": "सर्वे विक्रान्तवीर्याश्च अस्मिन्देशे सुदारुणाः ।\nयुष्मान् प्रधर्षयिष्यन्ति विकृता मांसभोजनाः\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2185408, "chapter_id": 4933, "verse_number": "१००", "content_sanskrit": "दूराच्चायं वनोद्देशो भयमत्र भविष्यति ।\nत्यज्यतां काष्ठभूतोऽयं मृष्यतां जाम्बुकं वचः\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2185409, "chapter_id": 4933, "verse_number": "१०१", "content_sanskrit": "यदि जम्बुकवाक्यानि निष्फलान्यनृतानि च ।\nश्रोष्यथ भ्रष्टविज्ञानास्ततः सर्वे विनङ्क्ष्य्थ\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2185410, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "जम्बुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2185411, "chapter_id": 4933, "verse_number": "१०२", "content_sanskrit": "स्थीयतां नेह भेतव्यं यावत्तपति भास्करः ।\nतावदस्मिन् सुतस्नेहादनिर्वेदेन वर्तत\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2185412, "chapter_id": 4933, "verse_number": "१०३", "content_sanskrit": "स्वैरं रुदत विस्रब्धाः स्वैरं स्नेहेन पश्यत ।\nस्थीयतां यावदादित्यः किं वः क्रव्यादभाषितैः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2185413, "chapter_id": 4933, "verse_number": "१०४", "content_sanskrit": "यदि गृध्रस्य वाक्यानि तीव्राणि रभसानि च ।\nगृह्णीत मोहितात्मानः सुतो वो न भविष्यति\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2185414, "chapter_id": 4933, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2185415, "chapter_id": 4933, "verse_number": "१०५", "content_sanskrit": "गृध्रोऽनस्तमिते त्वाह गतेऽस्तमिति जम्बुकः ।\nमृतं सुतं प्रति जनानूचतुस्तौ क्षुधान्वितौ\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2185416, "chapter_id": 4933, "verse_number": "१०६", "content_sanskrit": "स्वकार्यदक्षौ राजन् गृध्रो जम्बुक एव च ।\nक्षुत्पिपासापरिश्रान्तौ शास्त्रमालम्ब्य जल्पतः\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2185417, "chapter_id": 4933, "verse_number": "१०७", "content_sanskrit": "तयोर्विज्ञानविदुषोर्द्वयोर्जम्बुकपत्रिणोः ।\nवाक्यैरमृतकल्पैर्हि प्रातिष्ठन्त व्रजन्ति च\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2185418, "chapter_id": 4933, "verse_number": "१०८", "content_sanskrit": "शोकदैन्यसमाविष्टा रुदन्तस्तस्थिरे तदा ।\nस्वकार्यकुशलाभ्यां ते सम्भ्राम्यन्ते ह नैपुणात्\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2185419, "chapter_id": 4933, "verse_number": "१०९", "content_sanskrit": "तथा तयोर्विवदतोर्विज्ञानविदुषोर्द्वयोः ।\nबान्धवानां स्थितानां च उपातिष्ठत शङ्करः\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2185420, "chapter_id": 4933, "verse_number": "११०", "content_sanskrit": "ततस्तानाह मनुजान्वरदोऽस्मीति शूलभृत् ।\nते प्रत्यूचुरिदं वाक्यं दुःखिताः प्रणताः स्थिताः\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2185421, "chapter_id": 4933, "verse_number": "१११", "content_sanskrit": "एकपुत्रविहीनानां सर्वेषां जीवितार्थिनाम् ।\nपुत्रस्य नो जीवदानाज्जीवितं दातुमर्हसि\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2185422, "chapter_id": 4933, "verse_number": "११२", "content_sanskrit": "एवमुक्तः स भगवान् वारिपूर्णेन पाणिना ।\nजीवं तस्मै कुमाराय प्रादाद्वर्षशताय वै\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2185423, "chapter_id": 4933, "verse_number": "११३", "content_sanskrit": "तथा गोमायुगृध्राभ्यामददत्क्षुद्विनाशनम् ।\nवरं पिनाकी भगवान् सर्वभूतहिते रतः\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2185424, "chapter_id": 4933, "verse_number": "१९४", "content_sanskrit": "ततः प्रणम्य तं देवं श्रेयोहर्षसमन्विताः ।\nकृतकृत्याः सुखं हृष्टाः प्रातिष्ठन्त तदा विभो\t॥१९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2185425, "chapter_id": 4933, "verse_number": "११५", "content_sanskrit": "अनिर्वेदेन दीर्घेण निश्चयेन ध्रुवेण च ।\nदेवदेवप्रसादाच्च क्षिप्रं फलमवाप्यते\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2185426, "chapter_id": 4933, "verse_number": "११६", "content_sanskrit": "पश्य देवस्य संयोगं बान्धवानां च निश्चयम् ।\nकृपणानां हि रुदतां कृतमश्रुप्रमार्जनम्\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2185427, "chapter_id": 4933, "verse_number": "११७", "content_sanskrit": "पश्य चाल्पेन कालेन निश्चयान्वेषणेन च ।\nप्रसादं शङ्करात् प्राप्य दुःखिताः सुखमाप्नुवन्\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2185428, "chapter_id": 4933, "verse_number": "११८", "content_sanskrit": "ते विस्मिताः प्रहृष्टाश्च पुत्रसञ्जीवनात् पुनः ।\nबभूवुर्भरतश्रेष्ठ प्रसादाच्छङ्करस्य वै\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2185429, "chapter_id": 4933, "verse_number": "११९", "content_sanskrit": "ततस्ते त्वरिता राजञ्श्रुत्वा शोकमघोद्भवम् ।\nविविशुः पुत्रमादाय नगरं हृष्टमानसाः॥\nएषा बुद्धिः समस्तानां चातुर्वर्ण्ये निदर्शिता\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2185430, "chapter_id": 4933, "verse_number": "१२०", "content_sanskrit": "धर्मार्थमोक्षसंयुक्तमितिहासमिमं शुभम् ।\nश्रुत्वा मनुष्यः सततमिह प्रेत्य च मोदते\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2185431, "chapter_id": 4933, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे एकविंशोऽध्यायः ॥ २१ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}]