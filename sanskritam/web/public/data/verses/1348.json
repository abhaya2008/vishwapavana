[{"id": 2016551, "chapter_id": 1348, "verse_number": "२-८९-१", "content_sanskrit": "दुर्योधन उवाच॥\nएहि क्षत्तर्द्रौपदीमानस्व\nप्रियां भार्यां संमतां पाण्डवानाम्।\nसंमार्जतां वेश्म परैतु शीघ्रं\nतत्रास्तु दासीभिरपुण्यशीला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016552, "chapter_id": 1348, "verse_number": "२-८९-२x", "content_sanskrit": "विदुर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016553, "chapter_id": 1348, "verse_number": "२-८९-२", "content_sanskrit": "दर्विभाषं भाषितं त्वादृशेन\nन मन्द सम्बुद्ध्यसि पाशबद्धः।\nप्रपाते त्वं लम्बमानो न वेत्सि\nव्याघ्रान्मृगः कोपयसेऽतिवेलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016554, "chapter_id": 1348, "verse_number": "२-८९-३", "content_sanskrit": "आशीविषास्ते शिरसि पूर्णकोपा महाविषाः।\nमा कोपिष्ठाः सुमन्दात्मन्मा गमस्त्वं यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016555, "chapter_id": 1348, "verse_number": "२-८९-४", "content_sanskrit": "न हि दासीत्वमापन्ना कृष्णा भवितुमर्हति।\nजनीशेन हि राज्ञैषा पणे न्यस्तेति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016556, "chapter_id": 1348, "verse_number": "२-८९-५", "content_sanskrit": "अयं दत्ते वेणुरिवात्मघाती\nफलं राजा धृतराष्ट्रस्य पुत्रः।\nद्यूतं हि वैराय महाभयाय\nमत्तो न बुध्यत्ययमन्तकालम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016557, "chapter_id": 1348, "verse_number": "२-८९-६", "content_sanskrit": "नारुन्तुदः स्यान्न नृशंसवादी\nन हीनताः परमभ्याददीत।\nययास्य वाचा पर उद्विजेत\nन तां वदेदुशती पापलोक्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016558, "chapter_id": 1348, "verse_number": "२-८९-७", "content_sanskrit": "समुच्चरन्त्यतिवादाश्च वक्त्रा-\nध्यौराहतः शौचति रात्र्यहानि।\nपरस्य नामर्मसु ते पतन्ति\nतान्पण्डितो नावसृजेत्परेषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016559, "chapter_id": 1348, "verse_number": "२-८९-८", "content_sanskrit": "अजो हि शस्त्रमगिलत्किलैकः\nशस्त्रे विपन्ने शिरसास्य भूमौ।\nनिकृन्तनं स्वस्य कण्ठस्य घोरं\nतद्वद्वेरं मा कृथाः पाण्डुपुत्रैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016560, "chapter_id": 1348, "verse_number": "२-८९-९", "content_sanskrit": "न किञ्चिदित्थं प्रवदन्ति पार्था\nवनेचरं वा गृहमेधिनं वा।\nतपस्विनं वा परिपूर्णविद्यं\nभषन्ति हैवं श्वनराः सदैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016561, "chapter_id": 1348, "verse_number": "२-८९-१०", "content_sanskrit": "द्वारं सुघोरं नरकस्य जिह्यं\nन बुध्यते धृतराष्ट्रस्य पुत्रः।\nतमन्वेतारो बहवः कुरूणां\nद्यूतोदये सह दुःशासनेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016562, "chapter_id": 1348, "verse_number": "२-८९-११", "content_sanskrit": "मज्जन्त्यलाबूनि शिलाः प्लवन्ते\nमुह्यन्ति नावोम्भसि शश्वदेव।\nमूढो राजा धृतराष्ट्रस्य पुत्रो\nन मे वाचः पथ्यरूपाः शृणोति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016563, "chapter_id": 1348, "verse_number": "२-८९-१२", "content_sanskrit": "अन्तो नूं भवितायं करूणां\nसुदारुणः सर्वहरो विनाशः।\nवाचः काव्याः सुहृदां पथ्यरूपा\nन श्रूयन्ते वर्धते लोभ एव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016564, "chapter_id": 1348, "verse_number": "२-८९-१३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016565, "chapter_id": 1348, "verse_number": "२-८९-१३", "content_sanskrit": "धिगस्तु क्षत्तारमिति ब्रुवाणो\nदर्पेण मत्तो धृतराष्ट्रस्य पुत्रः।\nअवैक्षत प्रातिकामीं सभाया-\nमुवाच चैनं परमार्यमध्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016566, "chapter_id": 1348, "verse_number": "२-८९-१४x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016567, "chapter_id": 1348, "verse_number": "२-८९-१४", "content_sanskrit": "त्वं प्रातिकामिन्द्रौपदीमानयस्व\nन ते भयं विद्यते पाण्डवेभ्यः।\nक्षत्ता ह्ययं विवदत्येव भीतो\nन चास्माकं वृद्धिकामः सदैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016568, "chapter_id": 1348, "verse_number": "२-८९-१५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016569, "chapter_id": 1348, "verse_number": "२-८९-१५", "content_sanskrit": "एवमुक्तः प्रातिकामी स सूतः\nप्रायाच्छीघ्रं राजवचो निशम्य।\nप्रविश्य च श्वेव हि सिंहगेष्ठं\nसमासदन्महिषीं पाण्डवानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016570, "chapter_id": 1348, "verse_number": "२-८९-१६x", "content_sanskrit": "प्रातिकाम्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016571, "chapter_id": 1348, "verse_number": "२-८९-१६", "content_sanskrit": "युधिष्ठिरो द्यूतमदेन मत्तो\nदुर्योधनो द्रौपदि त्वामजैषीत्।\nसा त्वं प्रपद्यस्व धृतराष्ट्रस्य वेश्म\nनयामि त्वां कर्मणि याज्ञसेनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016572, "chapter_id": 1348, "verse_number": "२-८९-१७x", "content_sanskrit": "द्रौपद्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016573, "chapter_id": 1348, "verse_number": "२-८९-१७", "content_sanskrit": "कथं त्वेवं वदसि प्रातिकामि-\nको हि दीव्येद्भार्यया राजपुत्रः।\nमूडो राजा द्यूतमदेन मत्तो\nह्यभून्नान्यत्कैतवमस्य किञ्चित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016574, "chapter_id": 1348, "verse_number": "२-८९-१८x", "content_sanskrit": "प्रातिकाम्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016575, "chapter_id": 1348, "verse_number": "२-८९-१८", "content_sanskrit": "यदा नाभूत्कैतवमन्यदस्य\nतदाऽदेवीत्पाण्डवोऽजातशत्रुः।\nन्यस्ताः पूर्वं भ्रातरस्तेन राज्ञा\nस्वयं चात्मा त्वमथो राजपुत्रि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016576, "chapter_id": 1348, "verse_number": "२-८९-१९x", "content_sanskrit": "द्रौपद्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016577, "chapter_id": 1348, "verse_number": "२-८९-१९", "content_sanskrit": "गच्छ त्वं कितवं गत्वा सभायां पृच्छ सूतज।\nकिं तु पूर्वं पराजैषीरात्मानमथवा नु माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016578, "chapter_id": 1348, "verse_number": "२-८९-२०", "content_sanskrit": "एतज्ज्ञात्वा समागच्छ ततो मां नयं सूतज।\nज्ञात्वा चिकीर्षितमहं राज्ञो यास्यामि दुःखिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016579, "chapter_id": 1348, "verse_number": "२-८९-२१x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016580, "chapter_id": 1348, "verse_number": "२-८९-२१", "content_sanskrit": "सभां गत्वा स चोवाच द्रौपद्यस्तद्वचस्तदा।\nयुधिष्ठिरं नरेनद्राणां मध्ये स्थितमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016581, "chapter_id": 1348, "verse_number": "२-८९-२२", "content_sanskrit": "कस्येशो नः पराजैषीरिति त्वामाह द्रौपदी।\nकिं नु पूर्वं पराजैषीरात्मानमथवापि माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016582, "chapter_id": 1348, "verse_number": "२-८९-२३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016583, "chapter_id": 1348, "verse_number": "२-८९-२३", "content_sanskrit": "युधिष्ठिरस्तु निश्चेता गतसत्व इवाभवत्।\nन तं सूतं प्रत्युवाच वचनं साध्वसाधु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016584, "chapter_id": 1348, "verse_number": "२-८९-२४x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016585, "chapter_id": 1348, "verse_number": "२-८९-२४", "content_sanskrit": "इहैवागत्य पाञ्चाली प्रश्नमेनं प्रभाषताम्।\nइहैव सर्वे शृण्वन्तु तस्याश्चैतस्य यद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016586, "chapter_id": 1348, "verse_number": "२-८९-२५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016587, "chapter_id": 1348, "verse_number": "२-८९-२५", "content_sanskrit": "स गत्वा राजभवनं दुर्योधनवशानुगः।\nउवाच द्रौपदीं सूतः प्रातिकामी व्यथन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016588, "chapter_id": 1348, "verse_number": "२-८९-२६", "content_sanskrit": "सभ्यास्त्वमी राजपुत्र्याह्वयन्ति\nमन्ये प्राप्तः संशयः कौरवाणाम्।\nन वै समृद्दिं पालयते लघीयान्\nयस्त्वां सभां नेष्यति राजपुत्रि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016589, "chapter_id": 1348, "verse_number": "२-८९-२७x", "content_sanskrit": "द्रौपद्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016590, "chapter_id": 1348, "verse_number": "२-८९-२७", "content_sanskrit": "एवं नूनं व्यदधात्संविधाता\nस्पर्शावुभौ स्पृशतो वृद्धबालौ।\nधर्मं त्वेकं परमं प्राह लोके\nस नः शमं धास्यति गोप्यमानः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2016591, "chapter_id": 1348, "verse_number": "२-८९-२८", "content_sanskrit": "सोऽयं धर्मो मा त्यगात्कौरवान्वै\nसभ्यान्गत्वा पृच्छ धर्म्यं वचो मे।\nते मां ब्रूयुर्निश्चितं तत्करिष्ये\nधर्मात्मानो नीतिमन्तो वरिष्ठाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2016592, "chapter_id": 1348, "verse_number": "२-८९-२९x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2016593, "chapter_id": 1348, "verse_number": "२-८९-२९", "content_sanskrit": "श्रुत्वा सूतस्तद्वचो याज्ञसेन्याः\nसभां गत्वा प्राह वाक्यं तदानीम्।\nअधोमुखास्ते न च किञ्चिदूचु-\nर्निर्बन्धं तं धार्तराष्ट्रस्य बुद्ध्वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2016594, "chapter_id": 1348, "verse_number": "२-८९-३०", "content_sanskrit": "युधिष्ठिरस्तु तच्छ्रुत्वा दुर्योधनचिकीर्षितम्।\nद्रौपद्याः संमतं दूतं प्राहिणोद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2016595, "chapter_id": 1348, "verse_number": "२-८९-३१", "content_sanskrit": "एकवस्त्र त्वधोनीवो रोदमाना रजस्वला।\nसभामागम्य पाञ्चालि श्वशुरस्याग्रतो भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2016596, "chapter_id": 1348, "verse_number": "२-८९-३२", "content_sanskrit": "अथ त्वामागतां दृष्ट्वा राजपुत्रीं सभां तदा।\nसभ्याः सर्वे विनिन्देरन्मनोर्भिर्धृतराष्ट्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2016597, "chapter_id": 1348, "verse_number": "२-८९-३३x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2016598, "chapter_id": 1348, "verse_number": "२-८९-३३", "content_sanskrit": "स गत्वा त्वरितं दूतः कृष्णाया भवनं नृप।\nन्यवेदयन्मतं धीमान्धर्मराजस्य निश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2016599, "chapter_id": 1348, "verse_number": "२-८९-३४", "content_sanskrit": "पाण्डवाश्च महात्मानो दीना दुःखसमन्विताः।\nसत्येनातिपरीताङ्गा नोदीक्षन्ते स्म किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2016600, "chapter_id": 1348, "verse_number": "२-८९-३५", "content_sanskrit": "ततस्त्वेषां मुखमालोक्य राजा\nदुर्योधनः सूतमुवाच हृष्टः।\nइहैवैतामानय प्रातिकामिन्\nप्रत्यक्षमस्याः कुरवो ब्रुवन्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2016601, "chapter_id": 1348, "verse_number": "२-८९-३६", "content_sanskrit": "ततः सूतस्तस्य वशानुगामी\nभीतश्च कोपाद्द्रुपदात्मजायाः।\nविहाय मानं पुनरेव सभ्या-\nनुवाच कृष्णां किमहं ब्रवीमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2016602, "chapter_id": 1348, "verse_number": "२-८९-३७x", "content_sanskrit": "दूर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2016603, "chapter_id": 1348, "verse_number": "२-८९-३७", "content_sanskrit": "दुःशासनैष मम सूतपुत्रो\nवृकोदरादुद्विजतेऽल्पचेताः।\nस्वयं प्रगृह्यानय याज्ञसेनीं\nकिं ते करिष्यन्त्यवशाः सपत्नाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2016604, "chapter_id": 1348, "verse_number": "२-८९-३८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2016605, "chapter_id": 1348, "verse_number": "२-८९-३८", "content_sanskrit": "ततः समुत्थाय स राजपुत्रः\nश्रुत्वा भ्रातुः शासनं रक्तदृष्टिः।\nप्रविश्य तद्वेश्म महारथाना-\nमित्यब्रवीद्द्रौपदीं राजपुत्रीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2016606, "chapter_id": 1348, "verse_number": "२-८९-३९", "content_sanskrit": "एह्येहि पाञ्चालि राजपुत्रीम्।\nदुर्योधनं पश्य विमुक्तलज्जा।\nकुरून्भजस्वायतपत्रनेत्रे\nधर्मेण लब्धाऽसि सभां परैहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2016607, "chapter_id": 1348, "verse_number": "२-८९-४०", "content_sanskrit": "ततः समुत्थाय सुदूर्मनाः सा\nविवर्णमामृज्य मुखं करेण।\nआर्ता प्रदुद्राव यतः स्त्रियस्ता\nवृद्धस्य राज्ञः कुरुपुङ्गवस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2016608, "chapter_id": 1348, "verse_number": "२-८९-४१", "content_sanskrit": "ततो जवेनाभिससार रोषा-\nद्दुःशासनस्तामभिगर्जमानः।\nदीर्घेषु नीलेष्वथ चोर्मिमत्सु\nजग्राह केशेषु नरेन्द्रपत्नीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2016609, "chapter_id": 1348, "verse_number": "२-८९-४२", "content_sanskrit": "ये राजसूयावभृथे जलेन\nमहाक्रतौ मन्त्रपूतेन सिक्ताः।\nते पाण्डवानां परिभूय वीर्यं\nबलात्प्रमृष्टा धृतराष्ट्रजेन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2016610, "chapter_id": 1348, "verse_number": "२-८९-४३", "content_sanskrit": "स तां पराकृष्य सभासमीप-\nमानीय कृष्णामतिदीर्घकेशीम्।\nदुःशासनो नाथवतीमनाथव-\nच्चकर्ष वायुः कदलीमिवार्ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2016611, "chapter_id": 1348, "verse_number": "२-८९-४४", "content_sanskrit": "सा कृष्णमाणा नमिताङ्गयष्टिः\nशनैरुवाचाथ रजस्वलाऽस्मि।\nएकं च वासो मम मन्दबुद्धे\nसभां नेतुं नार्हसि मामनार्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2016612, "chapter_id": 1348, "verse_number": "२-८९-४५", "content_sanskrit": "ततोऽब्रवीत्तां प्रसभं निगृह्य\nकेशेशु कृष्णेषु तदा स कृष्णाम्।\nकृष्णं च जिष्णुं च हरिं नरं च\nत्रायाय विक्रोशति याज्ञसेनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2016613, "chapter_id": 1348, "verse_number": "२-८९-४६", "content_sanskrit": "रजस्वला वा भव याज्ञसेनि\nएकाम्बरा वाप्यथवा विवस्त्रा।\nद्यूते जिता चासि कृताऽसि दासी\nदासीषु वासश्च यथोपजोषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2016614, "chapter_id": 1348, "verse_number": "२-८९-४७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2016615, "chapter_id": 1348, "verse_number": "२-८९-४७", "content_sanskrit": "प्रकीर्णकेशी पतितार्धवस्त्रा\nदुःशासनेन व्यवधूयमाना।\nहीमत्यमर्षेण च दह्यमाना\nशनैरिदं वाक्यमुवाच कृष्णा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2016616, "chapter_id": 1348, "verse_number": "२-८९-४८x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2016617, "chapter_id": 1348, "verse_number": "२-८९-४८", "content_sanskrit": "इमे समायामुपनीतशास्त्राः\nक्रियावन्तः सर्व एवेन्द्रकल्पाः।\nगुरुस्थाना गुरवश्चैव सर्वे\nतेषामग्रे नोत्सहे स्थातुमेवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2016618, "chapter_id": 1348, "verse_number": "२-८९-४९", "content_sanskrit": "नशंसकर्मंस्त्वमनार्यवृत\nमा मा विवस्त्रां कुरु मा विकार्षीः।\nन मर्षयेयुस्तव राजपुत्राः\nसेन्द्रापि देवा यदि ते सहायाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2016619, "chapter_id": 1348, "verse_number": "२-८९-५०", "content_sanskrit": "धर्मे स्थितो धर्मसुतो महात्मा\nधर्मश्च सूक्ष्मो निपुणोपलक्ष्यः।\nवाचापि भर्तुः परमाणुमात्र-\nमिच्छामि दोषं न गुणान्विसृज्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2016620, "chapter_id": 1348, "verse_number": "२-८९-५१", "content_sanskrit": "इदं त्वकार्यं कुरुवीरमध्ये\nरजस्वलां यत्परिकर्षसे माम्।\nन चापि कश्चित्कुरुतेऽत्र कुत्सां\nध्रुवं तवेदं मतमभ्युपेतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2016621, "chapter_id": 1348, "verse_number": "२-८९-५२", "content_sanskrit": "धिगस्तु नष्टः खलु भारतानां\nधर्मस्तथा क्षत्रविदां च वृत्तम्।\nयत्र ह्यतीतां कुरुधर्मवेलां\nप्रेक्षन्ति सर्वे कुरवः सभायाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2016622, "chapter_id": 1348, "verse_number": "२-८९-५३", "content_sanskrit": "द्रोणस्य भीष्मस्य च नास्ति सत्त्वं\nक्षत्तुस्तथैवास्य चनास्ति सत्त्वं\nक्षत्तुस्तथैवास्य महात्मनोपि।\nन लक्षयन्ति कुरुवृद्धमुख्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2016623, "chapter_id": 1348, "verse_number": "२-८९-५४x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2016624, "chapter_id": 1348, "verse_number": "२-८९-५४", "content_sanskrit": "तथा ब्रुवन्ती करुणं सुमध्यमा\nभर्तॄन्कटाक्षैः कुपितानपश्यत्।\nसा पाण्डवान्कोपपरीतदेहा-\nन्सन्दीपयामास कटाक्षपातैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2016625, "chapter_id": 1348, "verse_number": "२-८९-५५", "content_sanskrit": "हृतेन राज्येन तथा धनेन\nरत्नैश्च मुख्यैर्न तथा बभूव।\nयथा त्रपाकोपसमीरितेन\nकृष्णाकटाक्षेण बभूव दुःखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2016626, "chapter_id": 1348, "verse_number": "२-८९-५६", "content_sanskrit": "दुःशासनश्चापि समीक्ष्य कृष्णा-\nमवेक्षमाणां कृपणान्पतींस्तान्।\nआधूय वेगेन विसञ्ज्ञकल्पा-\nमुवाच दासीति हसन्सशब्दम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2016627, "chapter_id": 1348, "verse_number": "२-८९-५७", "content_sanskrit": "कर्णस्तु तद्वाक्यमतीव हृष्टः\nसम्पूजयामास हसन्सशब्दम्।\nगान्धारराजः सुबलस्य पुत्र-\nस्तथैव दुःशासनमभ्यनन्दत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2016628, "chapter_id": 1348, "verse_number": "२-८९-५८", "content_sanskrit": "सभ्यास्तु ये तत्र बभूवुरन्ये\nताभ्यामृते धार्तराष्ट्रेण चैव।\nतेषामभूद्दुः खमतीव कृष्णां\nदृष्ट्वा सभायां परिकृष्यमाणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2016629, "chapter_id": 1348, "verse_number": "२-८९-५९x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2016630, "chapter_id": 1348, "verse_number": "२-८९-५९", "content_sanskrit": "न धर्मसौक्ष्म्यात्सुभगे विवेक्तुं\nशक्रोमि ते प्रश्नमिमं यथावत्।\nअस्वाम्यशक्तः पणितुं परस्वं\nस्त्रियाश्च भर्तुर्वशतां समीक्ष्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2016631, "chapter_id": 1348, "verse_number": "२-८९-६०", "content_sanskrit": "त्यजेत सर्वां पृथिवीं समृद्धां\nयुधिष्ठिरो धर्ममथो न जह्यात्।\nउक्तं जितोऽस्मीति च पाण्डवेन\nतस्मान्न शक्नोमि विवेक्तुमेतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2016632, "chapter_id": 1348, "verse_number": "२-८९-६१", "content_sanskrit": "द्व्यूतेऽद्वितीयः शकुनिर्नरेषु\nकुन्तीसुतस्तेन निसृष्टकामः।\nन मन्यते तां निकृतिं युधिष्ठिर-\nस्तस्मान् ते प्रश्नमिमं ब्रवीमि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2016633, "chapter_id": 1348, "verse_number": "२-८९-६१x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2016634, "chapter_id": 1348, "verse_number": "२-८९-६२", "content_sanskrit": "आहूय राजा कुशलैरनार्यै-\nर्दुष्टात्मभिर्नैकृतिकैः सभायाम्।\nद्यूतप्रियैर्नातिकृतप्रयत्नः\nकस्मादयं नाम निसृष्टकामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2016635, "chapter_id": 1348, "verse_number": "२-८९-६३", "content_sanskrit": "अशुद्धभावैर्निकृतिप्रवृत्तै-\nरबुध्यमानः कुरुपाण्डवाग्र्यः।\nसम्भूय सर्वैश्च जितोऽपि यस्मा-\nत्पश्चादयं कैतवमभ्युपेतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2016636, "chapter_id": 1348, "verse_number": "२-८९-६४", "content_sanskrit": "तिष्ठन्ति चेमे कुरवः सभाया-\nमीशाः सुतानां च तथा स्नुपाणाम्।\nसमीक्ष्य सर्वे मम चापि वाक्यं\nविब्रूत मे प्रश्नमिमं यथावत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2016637, "chapter_id": 1348, "verse_number": "२-८९-६५", "content_sanskrit": "न सा सभा यत्र न सन्ति वृद्धा\nन ते वृद्धा ये न वदन्ति धर्मम्।\nनासौ धर्मो यत्र न सत्यमस्ति\nन तत्सत्यं यच्छलेनानुविद्धम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2016638, "chapter_id": 1348, "verse_number": "२-८९-६६x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2016639, "chapter_id": 1348, "verse_number": "२-८९-६६", "content_sanskrit": "तथा ब्रुवन्तीं करुणं रुदन्ती-\nमवेक्षमाणां कृपणान्पतींस्तान्।\nदुःशासनः परुषाण्यप्रियाणि\nवाक्यान्युवाचामधुराणि चैव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2016640, "chapter_id": 1348, "verse_number": "२-८९-६७", "content_sanskrit": "तां कृष्यमाणां च रजस्वलां च\nस्रस्तोत्तरीयामतदर्हमाणाम्।\nवृकोदरः प्रेक्ष्य युधिष्ठिरं च\nचकार कोपं परमार्तरूपः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2016641, "chapter_id": 1348, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि एकोननवतितमोऽध्यायः॥ ८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]