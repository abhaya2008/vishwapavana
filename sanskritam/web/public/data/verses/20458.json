[{"id": 7000458000, "chapter_id": 20458, "verse_number": "३-५-१", "content_sanskrit": "ऋषय ऊचुः ।\nवर्षाणां चैव नामानि पर्वतानां च सत्तम ।\nआचक्ष्व नो यथातत्वं ये च पर्वतवासिनः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000458001, "chapter_id": 20458, "verse_number": "३-५-२", "content_sanskrit": "सूत उवाच ।\nदक्षिणेन तु श्वेतस्य निषधस्योत्तरेण तु ।\nवर्षं रमणकं नाम जायंते तत्र मानवाः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000458002, "chapter_id": 20458, "verse_number": "३-५-३", "content_sanskrit": "शुक्लाभिजनसंपन्नाः सर्वे ते प्रियदर्शनाः ।\nनिःसपत्नाश्च ते सर्वे जायंते तत्र मानवाः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000458003, "chapter_id": 20458, "verse_number": "३-५-४", "content_sanskrit": "दशवर्षसहस्राणि शतानि दशपंच च ।\nजीवंति ते महाभागा नित्यं मुदितमानसाः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000458004, "chapter_id": 20458, "verse_number": "३-५-५", "content_sanskrit": "दक्षिणेन तु नीलस्य निषधस्योत्तरेण तु ।\nवर्षं हिरण्मयं नाम यत्र हैरण्वती नदी॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000458005, "chapter_id": 20458, "verse_number": "३-५-६", "content_sanskrit": "यत्र चायं महाप्राज्ञाः पक्षिराट्पतगोत्तमः ।\nयज्ञानुगा विप्रवरा धन्विनः प्रियदर्शनाः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000458006, "chapter_id": 20458, "verse_number": "३-५-७", "content_sanskrit": "महाबलास्तत्र जना विप्रा मुदितमानसाः ।\nएकादशसहस्राणि वर्षाणां ते तपोधनाः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000458007, "chapter_id": 20458, "verse_number": "३-५-८", "content_sanskrit": "आयुःप्रमाणं जीवंति शतानि दश पंच च ।\nशृंगाणि च पवित्राणि त्रीण्येव द्विजपुंगवाः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000458008, "chapter_id": 20458, "verse_number": "३-५-९", "content_sanskrit": "एकं मणिमयं तत्र तथैकं रुक्ममद्भुतम् ।\nसर्वरत्नमयं चैकं भवनैरुपशोभितम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000458009, "chapter_id": 20458, "verse_number": "३-५-१०", "content_sanskrit": "तत्र स्वयं प्रभादेवी नित्यं वसति शंडिनी ।\nउत्तरेण तु शृंगस्य समुद्रांते द्विजोत्तमाः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000458010, "chapter_id": 20458, "verse_number": "३-५-११", "content_sanskrit": "वर्षमैरावतं नाम तस्माच्छृंगवतः परम् ।\nन तु तत्र सूर्यगतिर्जीर्यंते न च मानवाः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000458011, "chapter_id": 20458, "verse_number": "३-५-१२", "content_sanskrit": "चंद्रमाश्च सनक्षत्रो ज्योतिर्भूत इवावृतः ।\nपद्मप्रभाः पद्मवर्णाः पद्मपत्रनिभेक्षणाः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000458012, "chapter_id": 20458, "verse_number": "३-५-१३", "content_sanskrit": "पद्मपत्रसुगंधाश्च जायंते तत्र मानवाः ।\nअनिष्पन्ना नष्टगंधा निराहारा जितेंद्रियाः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000458013, "chapter_id": 20458, "verse_number": "३-५-१४", "content_sanskrit": "देवलोकच्युताः सर्वे तथा विरजसो द्विजाः ।\nत्रयोदशसहस्राणि वर्षाणां ते द्विजोत्तमाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000458014, "chapter_id": 20458, "verse_number": "३-५-१५", "content_sanskrit": "आयुःप्रमाणं जीवंति नरा धार्मिकपुंगवाः ।\nक्षीरोदस्य समुद्रस्य तथैवोत्तरतः प्रभुः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000458015, "chapter_id": 20458, "verse_number": "३-५-१६", "content_sanskrit": "हरिस्तिष्ठति वैकुंठः शकटे कनकामये ।\nअष्टचक्रं हि तद्यानं भूतयुक्तं मनोजवम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000458016, "chapter_id": 20458, "verse_number": "३-५-१७", "content_sanskrit": "अग्निवर्णं महातेजो जांबूनदविभूषितम् ।\nस प्रभुः सर्वभूतानां विभुश्च द्विजसत्तमाः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000458017, "chapter_id": 20458, "verse_number": "३-५-१८", "content_sanskrit": "संक्षेपे विस्तरे चैव कर्ता कारयिता तथा ।\nपृथिव्यापस्तथाकाशं वायुस्तेजश्च सत्तमाः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000458018, "chapter_id": 20458, "verse_number": "३-५-१९", "content_sanskrit": "स यज्ञः सर्वभूतानामास्यं तस्य हुताशनः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]