[{"id": 2062327, "chapter_id": 2328, "verse_number": "८-४९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062328, "chapter_id": 2328, "verse_number": "८-४९-१", "content_sanskrit": "कृतवर्मा कृपो द्रौणिः सूतपुत्रश्च मारिष।\nउलूकः सौबलश्चैव राजा च सह सोदरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062329, "chapter_id": 2328, "verse_number": "८-४९-२", "content_sanskrit": "सीदमानां चमूं दृष्ट्वा पाण्डुपुत्रभयार्दिताम्।\nसमुज्जह्रुः स्म वेगेन भिन्नां नावमिवार्णवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062330, "chapter_id": 2328, "verse_number": "८-४९-३", "content_sanskrit": "ततो युद्धमतीवासीन्मुहूर्तमिव भारत।\nभीरूणां त्रासजननं शूराणां हर्षवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062331, "chapter_id": 2328, "verse_number": "८-४९-४", "content_sanskrit": "कृपेण शरवर्षाणि प्रतिमुक्तानि संयुगे।\nसृञ्जयांश्छादयामासुः शलभानां व्रजा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062332, "chapter_id": 2328, "verse_number": "८-४९-५", "content_sanskrit": "शिखण्डी च ततः क्रुद्धो गौतमं त्वरितो ययौ।\nववर्ष शरवर्षाणि समन्ताद्द्विजपुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062333, "chapter_id": 2328, "verse_number": "८-४९-६", "content_sanskrit": "कृपस्तु शरवर्षं तद्विनिहत्य महास्त्रवित्।\nशिखण्डिनं रणे क्रुद्धो विव्याध दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062334, "chapter_id": 2328, "verse_number": "८-४९-७", "content_sanskrit": "ततः शिखण्डी कुपितः शरैः सप्तभिराहवे।\nकृपं विव्याध कुपितं कङ्कपत्रैरजिह्मगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062335, "chapter_id": 2328, "verse_number": "८-४९-८", "content_sanskrit": "ततः कृपः शरैस्तीक्ष्णैः सोऽतिविद्धो महारथः।\n`ततः सुनिशितैस्तीक्ष्णैः क्षुरप्रैर्हेमभूषितैः।\nव्यश्वसूतरथं चक्रे शिखण्डिनमथो द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062336, "chapter_id": 2328, "verse_number": "८-४९-९", "content_sanskrit": "हताश्वात्तु ततो यानादवप्लुत्य महारथः।\nखङ्गं चर्म तथा गृह्य सत्वरं ब्राह्मणं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062337, "chapter_id": 2328, "verse_number": "८-४९-१०", "content_sanskrit": "तमापतन्तं सहसा शरैः सन्नतपर्वभिः।\nवारयामास समरे तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062338, "chapter_id": 2328, "verse_number": "८-४९-११", "content_sanskrit": "तत्राद्भुतमपश्याम शिलानां प्लवनं यथा।\nनिश्चेष्टो यद्रणे राजञ्छिखण्डी समतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062339, "chapter_id": 2328, "verse_number": "८-४९-१२", "content_sanskrit": "कृपेण वारितं दृष्ट्वा शिखण्डिनमथो नृप।\nप्रत्युद्ययौ कृपं तूर्णं धृष्टद्युम्नो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062340, "chapter_id": 2328, "verse_number": "८-४९-१३", "content_sanskrit": "धृष्टद्युम्नं ततो यान्तं शारद्वतरथं प्रति।\nप्रतिजग्राह वेगेन कृतवर्मा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062341, "chapter_id": 2328, "verse_number": "८-४९-१४", "content_sanskrit": "युधिष्ठिरमथायान्तं शारद्वतरथं प्रति।\nसपुत्रं सहसैन्यं च द्रोणपुत्रो न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062342, "chapter_id": 2328, "verse_number": "८-४९-१५", "content_sanskrit": "नकुलं सहदेवं च त्वरमाणौ महारथौ।\nप्रतिजग्राह ते पुत्रः शरवर्षेण वारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062343, "chapter_id": 2328, "verse_number": "८-४९-१६", "content_sanskrit": "भीमसेनं करूशांश्च केकयान्सह सृञ्जयैः।\nकर्णो वैकर्तनो युद्धे वारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062344, "chapter_id": 2328, "verse_number": "८-४९-१७", "content_sanskrit": "शिखण्डिने ततो बाणान्कृपः शारद्वतो युधि।\nप्राहिणोत्तवरया युक्तो बीभत्सोरथ सन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062345, "chapter_id": 2328, "verse_number": "८-४९-१८", "content_sanskrit": "ताञ्छरान्प्रेषितांस्तेन समन्तात्स्वर्णभूषितान्।\nचिच्छेद खङ्गमाविध्य भ्रामयंश्च पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062346, "chapter_id": 2328, "verse_number": "८-४९-१९", "content_sanskrit": "शतचन्द्रं च तच्चर्म गौतमस्तस्य भारत।\nव्यधमत्सायकैस्तूर्णं तत उच्चुक्रुशुर्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062347, "chapter_id": 2328, "verse_number": "८-४९-२०", "content_sanskrit": "स विचर्मा महाराज खङ्गपाणिरुपाद्रवत्।\nकृपस्तं शरसङ्घातैराद्रवन्तमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062348, "chapter_id": 2328, "verse_number": "८-४९-२१", "content_sanskrit": "शारद्वतशरैर्ग्रस्तं क्लिश्यमानं महाबलः।\nचित्रकेतुसुतो राजन्सुकेतुस्त्वरितो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062349, "chapter_id": 2328, "verse_number": "८-४९-२२", "content_sanskrit": "विकिरन्ब्राह्मणं युद्धे बहुभिर्निशितैः शरैः।\nअभ्यापतदमेयात्मा गौतमस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062350, "chapter_id": 2328, "verse_number": "८-४९-२३", "content_sanskrit": "दृष्ट्वा विषक्तं तं चैव ब्राह्मणं च निवारितम्।\nअपयातस्ततस्तूर्णं शिखण्डी राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062351, "chapter_id": 2328, "verse_number": "८-४९-२४", "content_sanskrit": "सुकेतुस्तु ततो राजन्गौतमं नवभिः शरैः।\nविद्ध्वा विव्याध सप्तत्या पुनश्चैनं त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062352, "chapter_id": 2328, "verse_number": "८-४९-२५", "content_sanskrit": "अथास्य सशरं चापं पुनश्चिच्छेद मारिष।\nसारथिं च शरेणास्य मृशं मर्मस्वताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062353, "chapter_id": 2328, "verse_number": "८-४९-२६", "content_sanskrit": "गौतमस्तु ततः क्रुद्धो धनुर्गृह्य नवं दृढम्।\nसुकेतुं त्रिंशता बाणैः सर्वमर्मस्वताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062354, "chapter_id": 2328, "verse_number": "८-४९-२७", "content_sanskrit": "स विह्वलितसर्वाङ्गः प्रचचाल रथोत्तमे।\nभूमिकम्पे यथा वृक्षश्चचालाकम्पितो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062355, "chapter_id": 2328, "verse_number": "८-४९-२८", "content_sanskrit": "चलतस्तस्य कायात्तुं शिरो ज्वलितकुण्डलम्।\nसोष्णीषं सशिरस्त्राणं क्षुरप्रेण त्वपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062356, "chapter_id": 2328, "verse_number": "८-४९-२९", "content_sanskrit": "तच्छिरः प्रापतद्भूमौ श्येनाहृतमिवामिषम्।\nततोऽस्य कायो वसुधां पश्चात्प्रापतदच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062357, "chapter_id": 2328, "verse_number": "८-४९-३०", "content_sanskrit": "तस्मिन्हते महाराज पुत्रास्तस्य पदानुगाः।\nगौतमं समरे त्यक्त्वा दुद्रुवुस्ते दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062358, "chapter_id": 2328, "verse_number": "८-४९-३१", "content_sanskrit": "धृष्टद्युम्नं तु समरे सन्निवार्य महारथः।\nकृतवर्माऽब्रवीद्वृष्टस्तिष्ठतिष्ठेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062359, "chapter_id": 2328, "verse_number": "८-४९-३२", "content_sanskrit": "तदभूत्तुमुलं युद्वं वृष्णिपार्षतयो रणे।\nआमिषार्थे यथा युद्धं श्येनयोः क्रुद्धयोर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062360, "chapter_id": 2328, "verse_number": "८-४९-३३", "content_sanskrit": "धृष्टद्युम्नस्तु समरे हार्दिक्यं नवभिः शरैः।\nआजघानोरसि क्रुद्वः पीडयन्हृदिकात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062361, "chapter_id": 2328, "verse_number": "८-४९-३४", "content_sanskrit": "कृतवर्मा तु समरे पार्षतेन दृढाहतः।\nपार्षतं सरथं साश्वं छादयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062362, "chapter_id": 2328, "verse_number": "८-४९-३५", "content_sanskrit": "सरथश्छादितो राजन्धृष्टद्युम्नो न दृश्यते।\nमेघैरिव परिच्छन्नो भास्करो जलधारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062363, "chapter_id": 2328, "verse_number": "८-४९-३६", "content_sanskrit": "विधूय तं बाणगणं शरैः कनकभूषणैः।\nव्यरोचत रणे राजन्धृष्टद्युम्नः कृतव्रणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062364, "chapter_id": 2328, "verse_number": "८-४९-३७", "content_sanskrit": "ततस्तु पार्षतः क्रुद्धः शस्त्रवृष्टिं सुदारुणाम्।\nकृतवर्माणमासाद्य व्यसृजत्पृतनापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062365, "chapter_id": 2328, "verse_number": "८-४९-३८", "content_sanskrit": "तामापतन्तीं सहसा शस्त्रवृष्टिं सुदारुणाम्।\nशरैरनेकसाहस्रैर्हार्दिक्योऽवारयद्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062366, "chapter_id": 2328, "verse_number": "८-४९-३९", "content_sanskrit": "दृष्ट्वा तु वारितां युद्धे शस्त्रवृष्टिं दुरासदाम्।\nकृतवर्माणमासाद्य वारयामास पार्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062367, "chapter_id": 2328, "verse_number": "८-४९-४०", "content_sanskrit": "`यथा युग्मरथेनाजौ वाहान्वाहेरमिश्रयत्।\nगृहीत्वा चर्म खङ्गं च रथं तस्यावपुप्लुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062368, "chapter_id": 2328, "verse_number": "८-४९-४१", "content_sanskrit": "मिलितेष्वथ वाहेषु प्रत्यासन्ने च पार्षते।\nदृष्ट्वाऽपदानं तस्याशु गदां जग्राह सात्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062369, "chapter_id": 2328, "verse_number": "८-४९-४२", "content_sanskrit": "गदापाणिस्ततो राजन्रथात्तूर्णमवप्लुतः।\nतमदृष्ट्वा रथोपस्थे सारथिं समताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062370, "chapter_id": 2328, "verse_number": "८-४९-४३", "content_sanskrit": "खङ्गेन शितधारेण स हतः प्रापतद्रथात्।\nकृतवर्मा ततो हृष्टस्तलशब्दं चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062371, "chapter_id": 2328, "verse_number": "८-४९-४४", "content_sanskrit": "पार्षतं चाब्रवीद्राजन्नेह्येहीति पुनःपुनः।\nस तं न ममृषे युद्वे तलशब्दं समीरितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062372, "chapter_id": 2328, "verse_number": "८-४९-४५", "content_sanskrit": "अवप्लुत्य रथात्तस्मात्स्वरथं पुनरास्थितः।\nअभ्ययात्स तु तत्तूर्णं तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2062373, "chapter_id": 2328, "verse_number": "८-४९-४६", "content_sanskrit": "ततो राजन्महेष्वासं कृतवर्माणमाशु वै।\nगदां गृह्य पुनर्वेगात्कृतवर्माणमाहनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2062374, "chapter_id": 2328, "verse_number": "८-४९-४७", "content_sanskrit": "सोऽतिविद्वो बलवता न्यपतन्मूर्च्छया हतः।\nश्रुतर्वा रथमारोप्य अपोवाह रणाजिरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2062375, "chapter_id": 2328, "verse_number": "८-४९-४८", "content_sanskrit": "धृष्टद्युम्नस्तु समरे दृष्ट्वा शत्रुं महारथः।\nकौरवान्समरे तूर्णं वारयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2062376, "chapter_id": 2328, "verse_number": "८-४९-४९", "content_sanskrit": "ततस्ते तावका योधा धृष्टद्युम्नमुपाद्रवन्।\nसिंहनादरवांश्चक्रुस्ततो युद्धमवर्तत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2062377, "chapter_id": 2328, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे एकोनपञ्चाशोऽध्यायः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]