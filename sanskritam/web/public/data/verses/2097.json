[{"id": 2050077, "chapter_id": 2097, "verse_number": "७-२४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050078, "chapter_id": 2097, "verse_number": "७-२४-१", "content_sanskrit": "व्यथयेयुरिमे सेनां देवानामपि सञ्जय।\nआहवे ये न्यवर्तन्त वृकोदरमुखा नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050079, "chapter_id": 2097, "verse_number": "७-२४-२", "content_sanskrit": "सम्प्रयुक्तः किलैवायं दिष्टैर्भवति पूरुषः।\nतस्मिन्नेव च सर्वार्थाः प्रदृश्यन्ते पृथग्विधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050080, "chapter_id": 2097, "verse_number": "७-२४-३", "content_sanskrit": "दीर्घं विप्रोषितः कालमरण्ये जटिलोऽजिनी।\nअज्ञातश्चैव लोकस्य विजहार युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050081, "chapter_id": 2097, "verse_number": "७-२४-४", "content_sanskrit": "स एव महतीं सेनां समावर्तयदाहवे।\nकिमन्यद्दैवसंयोगान्मम पुत्राभवाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050082, "chapter_id": 2097, "verse_number": "७-२४-५", "content_sanskrit": "युक्त एव हि भाग्येन ध्रुवमुत्पद्यते नरः।\nस तथाऽऽकृष्यते तेन न यथा स्वयमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2050083, "chapter_id": 2097, "verse_number": "७-२४-६", "content_sanskrit": "द्यूतव्यसनमासाद्य क्लेशितो हि युधिष्ठिरः।\nस पुनर्भागधेयेन सहायानुपलब्धवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2050084, "chapter_id": 2097, "verse_number": "७-२४-७", "content_sanskrit": "अर्थे मे केकया लब्धाः काशिका कोसलाश्चये।\nचेदीनां चार्धमपरे मामे व समुपाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2050085, "chapter_id": 2097, "verse_number": "७-२४-८", "content_sanskrit": "पृथिवी भूयसी तात मम पार्थस्य नो तथा।\nइति मामब्रवीत्सूत मन्दो दुर्योधनः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2050086, "chapter_id": 2097, "verse_number": "७-२४-९", "content_sanskrit": "तस्य सेनासमूहस्य मध्ये द्रोणः सुरक्षितः।\nनिहतः पार्षतेनाजौ किमन्यद्भागधेयतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2050087, "chapter_id": 2097, "verse_number": "७-२४-१०", "content_sanskrit": "मध्ये राज्ञां महाबाहुं सदा युद्धाभिनन्दिनम्।\nसर्वास्त्रपारगं द्रोणं कथं मृत्युरुपेयिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2050088, "chapter_id": 2097, "verse_number": "७-२४-११", "content_sanskrit": "समनुप्राप्तकृच्छ्रोऽहं मोहं परममागतः।\nभीष्मद्रोणौ हतौ श्रुत्वा नाहं जीवितुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2050089, "chapter_id": 2097, "verse_number": "७-२४-१२", "content_sanskrit": "यन्मां क्षत्ताऽब्रवीत्तात प्रपश्यन्पुत्रगृद्धिनम्।\nदुर्योधनेन तत्सर्वं प्राप्तं सूत मया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2050090, "chapter_id": 2097, "verse_number": "७-२४-१३", "content_sanskrit": "नृशंसं तु परं तात त्यक्त्वा दुर्योधनं यदि।\nपुत्रशेषं चिकीर्षेयं कृत्स्नं न मरणं व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2050091, "chapter_id": 2097, "verse_number": "७-२४-१४", "content_sanskrit": "यो हि धर्मं परित्यज्य भवत्यर्थपरो नरः।\nसोऽस्माच्च हीयते लोकात्क्षुद्रभावं च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2050092, "chapter_id": 2097, "verse_number": "७-२४-१५", "content_sanskrit": "अद्य चाप्यस्य राष्ट्रस्य कृतोच्छेदस्य सञ्जय।\nअवशेषं न पश्यामि ककुदे मृदिते सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2050093, "chapter_id": 2097, "verse_number": "७-२४-१६", "content_sanskrit": "कथं स्यादवशेषो हि धुर्ययोरभ्यतीतयोः।\nयौ नित्यमुपजीवामः क्षमिणौ पुरुषर्षभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2050094, "chapter_id": 2097, "verse_number": "७-२४-१७", "content_sanskrit": "व्यक्तमेव च मे शंस यथा युद्धमवर्तत।\nकेऽयुध्यन्के व्यपाकुर्वन्के क्षुद्राः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2050095, "chapter_id": 2097, "verse_number": "७-२४-१८", "content_sanskrit": "धनुञ्जयं च मे शंस यद्यच्चक्रे रथर्षभः।\nतस्माद्भयं नो भूयिष्ठं भ्रातृव्याच्च वृकोदरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2050096, "chapter_id": 2097, "verse_number": "७-२४-१९", "content_sanskrit": "यथाऽसीच्च निवृत्तेषु पाण्डवेयेषु सञ्जय।\nमम सैन्यावशेषस्य सन्निपातः सुदारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2050097, "chapter_id": 2097, "verse_number": "७-२४-२०", "content_sanskrit": "कथं च वो मनस्तात निवृत्तेष्वभवत्तदा।\nमामकानां च ये शूराः के कांस्तत्र न्यवारयन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2050098, "chapter_id": 2097, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि संशप्तकवधपर्वणि चतुर्विंशोऽध्यायः॥ २४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-२४-२ संप्रयुक्तः सम्बद्धः। भवति उत्पद्यते। तस्मिन् दिष्ट एव॥ ५-२४-१८ भ्रातृव्यादमित्रात्॥ ५-२४-२४ चतुर्विशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]