[{"id": 2135013, "chapter_id": 3921, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135014, "chapter_id": 3921, "verse_number": "१", "content_sanskrit": "एवं चिन्तापरो राजा दुःशासनमथाब्रवीत् ।\nदुःशासन निबोधेदं वचनं मम भारत ।\nप्रतीच्छ त्वं मया दत्तमभिषेकं नृपो भव \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135015, "chapter_id": 3921, "verse_number": "२", "content_sanskrit": "प्रशाधि पृथिवीं स्फीतां कर्णसौबलपालिताम् ।\nभ्रातॄन् पालय विस्रब्धं मरुतो वृत्रहा यथा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135016, "chapter_id": 3921, "verse_number": "३", "content_sanskrit": "बान्धवाश्चोपजीवन्तु देवा इव शतक्रतुम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135017, "chapter_id": 3921, "verse_number": "४", "content_sanskrit": "ब्राह्मणेषु सदा वृत्तिं कुर्वीथाश्चाप्रमादतः ।\nबन्धूनां सुहृदां चैव भवेथास्त्वं गतिः सदा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135018, "chapter_id": 3921, "verse_number": "५", "content_sanskrit": "ज्ञातींश्चाप्यनुपश्येथा विष्णुर्देवगणान् यथा ।\nगुरवो माननीयास्ते गच्छ पालय मेदिनीम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135019, "chapter_id": 3921, "verse_number": "६", "content_sanskrit": "नन्दयन् सुहृदः सर्वान् शात्रवांश्चोपतापयन् ।\nकण्ठे चैनं परिष्वज्य गम्यतामित्यथाब्रवीत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135020, "chapter_id": 3921, "verse_number": "७", "content_sanskrit": "अश्रुकण्ठः सुदुःखार्तः प्राञ्जलिः प्रणिपत्य च \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135021, "chapter_id": 3921, "verse_number": "८", "content_sanskrit": "सगद्गदमिदं वाक्यं भ्रातरं ज्येष्ठमात्मनः ।\nप्रसीदेत्यपतद् भूमौ दूयमानेन चेतसा \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135022, "chapter_id": 3921, "verse_number": "९", "content_sanskrit": "दुःखितः पादयोस्तस्य नेत्रजं जलमुत्सृजन् ।\nउक्तवांश्च नरव्याघ्रो नैतदेवं भविष्यति \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135023, "chapter_id": 3921, "verse_number": "१०", "content_sanskrit": "विदीर्येत् सनगा भूमिर्द्यौश्चापि शकलीभवेत् ।\nरविरात्मप्रभां जह्यात् सोमः शीतांशुतां त्यजेत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135024, "chapter_id": 3921, "verse_number": "११", "content_sanskrit": "वायुः शैघ्र्यमथो जह्याद् हिमवांश्च परिप्लवेत् ।\nशुष्येत् तोयं समुद्रेषु वह्निरप्युष्णतां त्यजेत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135025, "chapter_id": 3921, "verse_number": "१२", "content_sanskrit": "न चाहं त्वदृते राजन् प्रशास्तेयं वसुन्धराम् ।\nपुनः पुनः प्रसीदेति वाक्यं चेदमुवाच ह \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135026, "chapter_id": 3921, "verse_number": "१३", "content_sanskrit": "त्वमेव नः कुले राजा भविष्यसि शतं समाः ।\nशत्रूणां शोककृद् राजन् सुहृदां शोकनाशनः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135027, "chapter_id": 3921, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135028, "chapter_id": 3921, "verse_number": "१४", "content_sanskrit": "एवमुक्त्वा स राजानं सुस्वरं प्ररुरोद ह ।\nपादौ संस्पृश्य मानार्हौ भ्रातुर्ज्येष्ठस्य भारत \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135029, "chapter_id": 3921, "verse_number": "१५", "content_sanskrit": "तथा तौ दुःखितौ दृष्ट्वा दुःशासनसुयोधनौ ।\nअधिगम्य व्यथाविष्टः कर्णस्तौ प्रत्यभाषत \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135030, "chapter_id": 3921, "verse_number": "१६", "content_sanskrit": "विषीदथः किं कौरव्यौ बालिश्यात् प्राकृताविव ।\nन शोकः शोचमानस्य विनिवर्तेत कर्हिचित् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135031, "chapter_id": 3921, "verse_number": "१७", "content_sanskrit": "यदा च शोचतः शोको व्यसनं चा(ना)पकर्षति ।\nसामर्थ्यं किं ततः शोके शोचमानः प्रपश्यति \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135032, "chapter_id": 3921, "verse_number": "१८", "content_sanskrit": "धृतिं गृह्णीत मा शत्रून् शोचन्तौ नन्दयिष्यथ ।\nकर्तव्यं हि कृतं राजन् पाण्डवैस्तव मोक्षणम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135033, "chapter_id": 3921, "verse_number": "१९", "content_sanskrit": "नित्यमेव प्रियं कार्यं राज्ञो विषयवासिभिः ।\nपाल्यमानास्त्वया ते हि निवसन्ति गतज्वराः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135034, "chapter_id": 3921, "verse_number": "२०", "content_sanskrit": "नार्हस्येवङ्गते मन्युं कर्तुं प्राकृतवद् यथा ।\nविषण्णास्तव सोदर्यास्त्वयि प्रायं समास्थिते \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135035, "chapter_id": 3921, "verse_number": "२१", "content_sanskrit": "तदलं दुःखितानेतान् कर्तुं सर्वान् नराधिप ।\nउत्तिष्ठ व्रज भद्रं ते समाश्वासय सोदरान् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135036, "chapter_id": 3921, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रा- पर्वणि दुर्योधनप्रायोपवेशे एकोनचत्वारिंशदधिकद्विशततमोऽध्यायः ॥२३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135037, "chapter_id": 3921, "verse_number": "", "content_sanskrit": "प्रायोपवेशपर्वणि चतुर्थोऽध्यायः ॥४॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]