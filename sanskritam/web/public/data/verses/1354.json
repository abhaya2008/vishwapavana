[{"id": 2016951, "chapter_id": 1354, "verse_number": "२-९५-१", "content_sanskrit": "युधिष्ठर उवाच॥\nराजन्किं करवामस्ते प्रशाध्यस्मांस्त्वमीश्वरः।\nनित्यं हि स्थातुमिच्छामस्तव भारत शासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2016952, "chapter_id": 1354, "verse_number": "२-९५-२x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2016953, "chapter_id": 1354, "verse_number": "२-९५-२", "content_sanskrit": "अजातशत्रो भद्रं ते अरिष्टं स्वस्ति गच्छत।\nअनुज्ञाताः सहधनाः स्वराज्यमनुशासत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2016954, "chapter_id": 1354, "verse_number": "२-९५-३", "content_sanskrit": "इदं चैवावबोद्धव्यं वृद्धस्य मम शासनम्।\nमया निगदितं सर्वं पथ्यं निःश्रेयसं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2016955, "chapter_id": 1354, "verse_number": "२-९५-४", "content_sanskrit": "वेत्थ त्वं तात धर्माणां गतिं सूक्ष्मां युधिष्ठिर।\nविनीतोऽसि महाप्राज्ञ वृद्धानां पर्युपासिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2016956, "chapter_id": 1354, "verse_number": "२-९५-५", "content_sanskrit": "यतो बुद्धिस्ततः शान्तिः प्रशमं गच्छ भारत।\nनादारुणि पतेच्छस्त्रं दारुण्येतन्निपात्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2016957, "chapter_id": 1354, "verse_number": "२-९५-६", "content_sanskrit": "न वैराण्यभिजानन्ति गुणान्पश्यन्ति नागुणान्।\nविरोधं नाधिगच्छन्ति ये त उत्तमपूरुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2016958, "chapter_id": 1354, "verse_number": "२-९५-७", "content_sanskrit": "स्मरन्ति सुकृतान्येव न वैराणि कृतान्यपि।\nसन्तः परार्थं कुर्वाणा नावेक्षन्ति प्रतिक्रियाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2016959, "chapter_id": 1354, "verse_number": "२-९५-८", "content_sanskrit": "संवादे परुषाण्याहुर्युधिष्ठिर नराधमाः।\nप्रत्याहुर्मध्यमास्त्वेतेऽनुक्ताः नराधमाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2016960, "chapter_id": 1354, "verse_number": "२-९५-९", "content_sanskrit": "न चोक्ता नैव चानुक्तास्त्वहिताः परुषा गिरः।\nप्रतिजल्पन्ति वै धीराः सदा तूत्तमपुरुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2016961, "chapter_id": 1354, "verse_number": "२-९५-१०", "content_sanskrit": "स्मरन्ति सुकृतान्येव न वैराणि कृतान्यपि।\nसन्तः प्रतिविजानन्तो लब्ध्वा प्रत्ययमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2016962, "chapter_id": 1354, "verse_number": "२-९५-११", "content_sanskrit": "असम्भिन्नार्यमर्यादाः साधवः प्रियदर्शनाः।\nतथा चरित्तंमार्येण त्वयाऽस्मिन्सत्समागमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2016963, "chapter_id": 1354, "verse_number": "२-९५-१२", "content_sanskrit": "दुर्योधनस्य पारुष्यं तत्तात हृदि मा कृथाः।\nमातरं चैव गान्धारीं मां च त्वं गुणकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2016964, "chapter_id": 1354, "verse_number": "२-९५-१३", "content_sanskrit": "उपस्थितं वृद्धमन्धं पितरं पश्य भारत।\nप्रेक्षापूर्वं मया द्यूतमिदमासीदुपेक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2016965, "chapter_id": 1354, "verse_number": "२-९५-१४", "content_sanskrit": "मित्राणि द्रष्टुकामेन पुत्राणां च बलाबलम्।\nअशोच्याः कुरवो राजन्येषां त्वमनुशासिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016966, "chapter_id": 1354, "verse_number": "२-९५-१५", "content_sanskrit": "मन्त्री च विदुरो धीमान्सर्वशास्त्रविशारदः।\nत्वयि धर्मोऽर्जुने धैर्यं भीमसेने पराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016967, "chapter_id": 1354, "verse_number": "२-९५-१६", "content_sanskrit": "शुद्धा च गुरुशुश्रूषा यमयोः पुरुषाग्र्ययोः।\nअजातशत्रो भद्रं ते खाण्डवप्रस्थमाविश।\nभ्रातृभिस्तेऽस्तु सौभ्रात्रं धर्मे ते धीयताम मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016968, "chapter_id": 1354, "verse_number": "२-९५-१७x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016969, "chapter_id": 1354, "verse_number": "२-९५-१७", "content_sanskrit": "इत्युक्तो भरतश्रेष्ठ धर्मराजो युधिष्ठिरः।\nकृत्वाऽऽर्यसमयं सर्वं प्रतस्थे भ्रातृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016970, "chapter_id": 1354, "verse_number": "२-९५-१८", "content_sanskrit": "ते रथान्मेघसङ्काशानास्थाय सह कृष्णया।\nप्रययुर्हृष्टमनस इन्द्रप्रस्थं पुरोत्तमम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016971, "chapter_id": 1354, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि पञ्चनवतितमोऽध्यायः॥९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]