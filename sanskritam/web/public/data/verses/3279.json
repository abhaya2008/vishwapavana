[{"id": 2105590, "chapter_id": 3279, "verse_number": "१६-८-१", "content_sanskrit": "धृतराष्ट्र उवाच।\nसन्धिविग्रहमप्यत्र पश्येथा राजसत्तम।\nद्वियोनिं विविधोपायं बहुकल्पं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105591, "chapter_id": 3279, "verse_number": "१६-८-२", "content_sanskrit": "कौरव्य पर्युपासीथाः स्थित्वा द्वैविध्यमात्मनः।\nतुष्टपुष्टजनः शत्रुरर्थवानिति च स्मरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105592, "chapter_id": 3279, "verse_number": "१६-८-३", "content_sanskrit": "पर्युपासनकाले तु विपरीतं विधीयते।\nआमर्दकाले राजेन्द्र व्यवसायस्ततोऽपरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105593, "chapter_id": 3279, "verse_number": "१६-८-४", "content_sanskrit": "व्यसनं भेदनं चैव शत्रूणां कारयेत्ततः।\nकर्षणं भीषणं चैव युद्धे चैव बहुक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105594, "chapter_id": 3279, "verse_number": "१६-८-५", "content_sanskrit": "प्रयास्यमानो नृपतिस्त्रिविधं परिचिन्तयेत्।\nआत्मनश्चैव शत्रोश्च शक्तिं शास्त्रविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105595, "chapter_id": 3279, "verse_number": "१६-८-६", "content_sanskrit": "उत्साहप्रभुशक्तिभ्यां मन्त्रशक्त्या च भारत।\nउपपन्नो नृपो यायाद्विपरीतं च वर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105596, "chapter_id": 3279, "verse_number": "१६-८-७", "content_sanskrit": "आददीत बलं राजा मौलं मित्रबलं तथा।\nअटवीबलं भृतं चैव तता श्रेणीबलं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105597, "chapter_id": 3279, "verse_number": "१६-८-८", "content_sanskrit": "`मित्रामित्रबलं राजन्न्यायाद्वृद्ध्युदये धृतः।\nतत्र मित्रबलं राजन्मौलं चैव विशिष्यते।\nश्रेणीबलं भृतं चैव तुल्ये एवेति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105598, "chapter_id": 3279, "verse_number": "१६-८-९", "content_sanskrit": "तथाऽऽचारबलं चैव परस्परसमं नृप।\nविज्ञेयं बलकालेषु राज्ञा काल उपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105599, "chapter_id": 3279, "verse_number": "१६-८-१०", "content_sanskrit": "आपदश्चापि बोद्धव्या बहुरूपा नराधिप।\nभवन्ति राज्ञा कौरव्य यास्ताः पृथगतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105600, "chapter_id": 3279, "verse_number": "१६-८-११", "content_sanskrit": "विकल्पा बहुधा राजन्नापदां पाण्डुनन्दन।\nसामादिभिरुपन्यस्य गमयेत्तान्नृपः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105601, "chapter_id": 3279, "verse_number": "१६-८-१२", "content_sanskrit": "यात्रां गच्छेद्बलैर्युक्तो राजा षड्भिः परंतप।\nयुक्तश्च देशकालाभ्यां बलैरात्मगुणैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105602, "chapter_id": 3279, "verse_number": "१६-८-१३", "content_sanskrit": "हृष्टपुष्टबलो गच्छेद्राजा वृद्ध्युदये रतः।\nअकृशश्चाप्यथो यायादनृतावपि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105603, "chapter_id": 3279, "verse_number": "१६-८-१४", "content_sanskrit": "तूणाश्मानं वाजिरथप्रवाहां\nध्वजद्रुमैः संवृतकूलरोधसम्।\nपदातिनागैर्बहुकर्दमां नदीं\nसपत्नानाशे नृपतिः प्रयोजयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105604, "chapter_id": 3279, "verse_number": "१६-८-१५", "content_sanskrit": "अथोपपत्त्या शकटं पद्मवज्रं च भारत।\nउशना वेद यच्छास्त्रं तत्रैतद्विहितं विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105605, "chapter_id": 3279, "verse_number": "१६-८-१६", "content_sanskrit": "चारयित्वा परबलं कृत्वा स्वबलदर्शनम्।\nस्वभूमौ योजयेद्युद्धं परभूमौ तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105606, "chapter_id": 3279, "verse_number": "१६-८-१७", "content_sanskrit": "बलं प्रसादयेद्राजा निक्षिपेद्बलनो नरान्।\nज्ञात्वा स्वविषयं तत्र सामादिभिरुपक्रमेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105607, "chapter_id": 3279, "verse_number": "१६-८-१८", "content_sanskrit": "सर्वथैव महाराज शरीरं धारयेदिह।\nप्रेत्य चेह च कर्तव्यमात्मनिःश्रेयसं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105608, "chapter_id": 3279, "verse_number": "१६-८-१९", "content_sanskrit": "एवं कुर्वञ्शुभा वाचो लोकेऽस्मिञ्शृणु ते नृप।\nप्रेत्य स्वर्गमवाप्नोति प्रजा धर्मेणि पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105609, "chapter_id": 3279, "verse_number": "१६-८-२०", "content_sanskrit": "एवं त्वया कुरुश्रेष्ठ वर्तितव्यं प्रजासु वै।\nउभयोर्लोकयोस्तात प्राप्तये नित्यमेव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105610, "chapter_id": 3279, "verse_number": "१६-८-२१", "content_sanskrit": "भीष्मेण सर्वमुक्तोसि कृष्णेन विदुरेण च।\nमयाऽप्यवश्यं वक्तव्यं प्रीत्या ते नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105611, "chapter_id": 3279, "verse_number": "१६-८-२२", "content_sanskrit": "एतत्सर्वं यथान्यायं कुर्वीथा भूरिदक्षिण।\nप्रियस्तथा प्रजानां त्वं स्वर्गे सुखमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105612, "chapter_id": 3279, "verse_number": "१६-८-२३", "content_sanskrit": "अश्वमेधसहस्रेण यो यजेत्पृथिवीपतिः।\nपालयेद्वाऽपि धर्मेणि प्रजास्तुल्यं फलं लभेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105613, "chapter_id": 3279, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि अष्टमोऽध्यायः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]