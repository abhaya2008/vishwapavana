[{"id": 2038128, "chapter_id": 1828, "verse_number": "५-७३-०x", "content_sanskrit": "भीम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038129, "chapter_id": 1828, "verse_number": "५-७३-१", "content_sanskrit": "यथायथैव शान्तिः स्यात्कुरूणां मधुसूदन।\nतथातथैव भाषेथा मा स्म युद्धेन भीषयेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038130, "chapter_id": 1828, "verse_number": "५-७३-२", "content_sanskrit": "अमर्षी जातसंरम्भः श्रेयोद्वेषी महामनाः।\nनोग्रं दुर्योधनो वाच्यः साम्नैवेनं समाचरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038131, "chapter_id": 1828, "verse_number": "५-७३-३", "content_sanskrit": "प्रकृत्या पापसत्वश्च तुल्यचेतास्तु दस्युभिः ।\nऐश्वर्यमदमत्तश्च कृतवैरश्च पाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038132, "chapter_id": 1828, "verse_number": "५-७३-४", "content_sanskrit": "अदीर्घदर्शी निष्ठूरी क्षेप्ता क्रूरपराक्रमः ।\nदीर्घमन्युरनेयश्च पापात्मा निकृतिप्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038133, "chapter_id": 1828, "verse_number": "५-७३-५", "content_sanskrit": "म्रियेतापि न भज्येत नैव जह्यात्स्वकं मतम्।\nतादृशेन शमः कृष्ण मन्ये परमदुष्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038134, "chapter_id": 1828, "verse_number": "५-७३-६", "content_sanskrit": "सुहृदामप्यवाचीनस्त्यक्तधर्मा प्रियानृतः ।\nप्रतिहन्त्ये सुहृदां वाचश्चैव मनांसि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038135, "chapter_id": 1828, "verse_number": "५-७३-७", "content_sanskrit": "स मन्युवशमापन्नः स्वभावं दुष्टमास्थितः ।\nस्वभावात्पापमभ्येति तृणैश्छन्न इवोरगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038136, "chapter_id": 1828, "verse_number": "५-७३-८", "content_sanskrit": "दुर्योधनो हि यत्सेनः सर्वथा विदितस्तव ।\nयच्छीलो यत्स्वभावश्च यद्बलो यत्पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038137, "chapter_id": 1828, "verse_number": "५-७३-९", "content_sanskrit": "पुरा प्रसन्नाः कुरवः सहपुत्रास्तथा वयम्।\nइन्द्रज्येष्ठा इवाभूम मोदमानाः सबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038138, "chapter_id": 1828, "verse_number": "५-७३-१०", "content_sanskrit": "दुर्योधनस्य क्रोधेन भरता मधुसूदन।\nधक्ष्यन्ते शिशिरापाये वनानीव हुताशनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038139, "chapter_id": 1828, "verse_number": "५-७३-११", "content_sanskrit": "अष्टादशेमे राजानः प्रख्यात मधुसूदन ।\nये समुच्चिच्छिदुर्ज्ञातीन्सुहृदश्च सबान्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038140, "chapter_id": 1828, "verse_number": "५-७३-१२", "content_sanskrit": "असुराणां समृद्धानां ज्वलतामिव तेजसा।\nपर्यायकाले धर्मस्य प्राप्ते कलिरजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038141, "chapter_id": 1828, "verse_number": "५-७३-१३", "content_sanskrit": "हैहयानामुदावर्तो नीपानां जनमेजयः ।\nबहुलस्तालजङ्घानां कृमीणामुद्धतो वसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038142, "chapter_id": 1828, "verse_number": "५-७३-१४", "content_sanskrit": "अजबिन्दुः सुवीराणां सुराष्ट्राणां रुषर्द्धिकः।\nअर्कजश्च बलीहानां चीनानां धौतमूलकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038143, "chapter_id": 1828, "verse_number": "५-७३-१५", "content_sanskrit": "हयग्रीवो विदेहानां वरयुश्च महौजसाम् ।\nबाहुः सुन्दरवंशानां दीप्ताक्षाणां पुरूरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038144, "chapter_id": 1828, "verse_number": "५-७३-१६", "content_sanskrit": "सहजश्चेदिमत्स्यानां प्रवीराणां वृषध्वजः ।\nधारणश्चन्द्रवत्सानां मुकुटानां विगाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038145, "chapter_id": 1828, "verse_number": "५-७३-१७", "content_sanskrit": "शमश्च नन्दिवेगानामित्येते कुलपांसनाः ।\nयुगान्ते कृष्ण संभूताः कुलेषु पुरुषाधमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038146, "chapter_id": 1828, "verse_number": "५-७३-१८", "content_sanskrit": "अप्ययं नः कुरूणां स्याद्युगान्ते कालसंभृतः ।\nदुर्योधनः कुलाङ्गारो जघन्यः पापपूरुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038147, "chapter_id": 1828, "verse_number": "५-७३-१९", "content_sanskrit": "तस्मान्मृदु शनैर्ब्रूया धर्मार्थसहितं हितम् ।\nकामानुबद्धं बहुलं नोग्रमुग्रपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038148, "chapter_id": 1828, "verse_number": "५-७३-२०", "content_sanskrit": "अपि दुर्योधनं कृष्ण सर्वे वयमधश्चराः।\nनीचैर्भूत्वाऽनुयास्यामो मा स्म नो भरता नशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038149, "chapter_id": 1828, "verse_number": "५-७३-२१", "content_sanskrit": "अप्युदासीनवृत्तिः स्याद्यथा नः कुरुभिः सह।\nवासुदेव तथा कार्यं न कुरूननयः स्पृशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038150, "chapter_id": 1828, "verse_number": "५-७३-२२", "content_sanskrit": "वाच्यः पितामहो वृद्धो ये च कृष्ण समासदः ।\nभ्रातॄणामस्तु सौभ्रात्रं धार्तराष्ट्रः प्रशाम्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038151, "chapter_id": 1828, "verse_number": "५-७३-२३", "content_sanskrit": "अहमेतद्ब्रवीम्येवं राजा चैव प्रशंसति ।\nअर्जुनो नैव युद्धार्थी भूयसी हि दयाऽर्जुने ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038152, "chapter_id": 1828, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उग्योगपर्वणि भगवद्यानपर्वणि त्रिसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]