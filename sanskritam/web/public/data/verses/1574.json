[{"id": 2026814, "chapter_id": 1574, "verse_number": "३-२१२-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026815, "chapter_id": 1574, "verse_number": "३-२१२-१", "content_sanskrit": "स तु विप्रमथोवाच धर्मव्याधो युधिष्ठिर।\nयदहं ह्याचरे कर्म घोरमेतदसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026816, "chapter_id": 1574, "verse_number": "३-२१२-२", "content_sanskrit": "विधिस्तु बलवान्ब्रह्मन्दुस्तरं हि पुरा कृतम्।\nपुरा कृतस् पापस्य कर्मदोषो भवत्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026817, "chapter_id": 1574, "verse_number": "३-२१२-३", "content_sanskrit": "दोपस्यैतस्य वै ब्रह्मन्विघाते यत्नवानहम्।\nविधिना हि हते पूर्वं निमित्तं घातको भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026818, "chapter_id": 1574, "verse_number": "३-२१२-४", "content_sanskrit": "निमित्तभूता हि वयं कर्मणोऽस्य द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026819, "chapter_id": 1574, "verse_number": "३-२१२-५", "content_sanskrit": "येषां हतानां मांसानि विक्रीणीमो वयं द्विज।\nतेषामपि भवेद्धर्म उपयोगेन भक्षणात्।\nदेवतातिथिभृत्यानां पितृणां चापि पूजनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026820, "chapter_id": 1574, "verse_number": "३-२१२-६", "content_sanskrit": "ओषध्यो वीरुधश्चैव पशवो मृगपक्षिणः।\nअन्नाद्यभूता लोकस्य इत्यपि श्रूयते श्रुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026821, "chapter_id": 1574, "verse_number": "३-२१२-७", "content_sanskrit": "आत्ममांसप्रसादेन शिबिरौशीनरो नृपः।\nस्वर्गं सुदुर्लभं प्राप्तः क्षमावान्द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026822, "chapter_id": 1574, "verse_number": "३-२१२-८", "content_sanskrit": "राज्ञो महानसे पूर्वं रन्तिदेवस्य वै द्विज।\n[द्वे सहस्रे तु पच्छेते पशूनामन्वहं तदा।]\nअहन्यहनि पच्येते द्वे सहस्रे गवां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026823, "chapter_id": 1574, "verse_number": "३-२१२-९", "content_sanskrit": "स मासं ददतो ह्यन्नं रन्तिदेवस्य नित्यशः।\nअतुला कीर्तिरभवन्नृपस्य द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026824, "chapter_id": 1574, "verse_number": "३-२१२-१०", "content_sanskrit": "चातुर्मास्ये च पशवो वध्यन्त इति नित्यशः।\nअग्नयो मांसकामाश्चइत्यपि श्रूयते श्रुतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026825, "chapter_id": 1574, "verse_number": "३-२१२-११", "content_sanskrit": "यज्ञेषु पशवो ब्रह्मन्वध्यन्ते सततं द्विजैः।\nसंस्कृताः किल मन्त्रैश्च तेऽपि स्वर्गमवाप्नुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026826, "chapter_id": 1574, "verse_number": "३-२१२-१२", "content_sanskrit": "यदि नैवाग्नयो ब्रह्मन्मांसकामाऽभवन्पुरा।\nभक्ष्यं नैवाभवन्मांसं कस्यचिद्द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026827, "chapter_id": 1574, "verse_number": "३-२१२-१३", "content_sanskrit": "अत्रापि विधिरुक्तश् मुनिभिर्मांसभक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026828, "chapter_id": 1574, "verse_number": "३-२१२-१४", "content_sanskrit": "देवतानां पितृणां च शुङ्क्ते दत्त्वाऽपियः सदा।\nयथाविधि यथाश्रद्धं न स दुष्येत भक्षणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026829, "chapter_id": 1574, "verse_number": "३-२१२-१५", "content_sanskrit": "अमांसाशी भवत्येवमित्यपि श्रूयते श्रुतिः।\nभार्यां गच्छन्ब्रह्मचारी ऋतौ भवति ब्राह्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026830, "chapter_id": 1574, "verse_number": "३-२१२-१६", "content_sanskrit": "सत्यानृते विनिश्चित्य अत्रापि विधिरुच्यते।\nसौदासेन तदा राज्ञा मानुषा भक्षिता द्विज।\nशापाभिभूतेन भृशमत्र किं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026831, "chapter_id": 1574, "verse_number": "३-२१२-१७", "content_sanskrit": "स्वधर्म इतिकृत्वा तु न त्यजामि द्विजोत्तम।\nपुरा कृतमिति ज्ञात्वा रजीवाम्येतेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026832, "chapter_id": 1574, "verse_number": "३-२१२-१८", "content_sanskrit": "स्वधर्मं त्यजतो ब्रह्मन्नधर्म इह दृश्यते।\nस्वकर्मनिरतो यस्तु धर्मः स इति निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026833, "chapter_id": 1574, "verse_number": "३-२१२-१९", "content_sanskrit": "कुले हि विहितं कर्म देही तं न विमुञ्चति।\nधात्रा विधिरयं दृष्टो बहुधा कर्मनिर्मये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026834, "chapter_id": 1574, "verse_number": "३-२१२-२०", "content_sanskrit": "द्रष्टव्यस्तु भवेद्ब्रह्मन्धर्मो धर्मविनिश्चये।\nकथं कर्म शुभं कुर्यां कथं मुच्ये पराभवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026835, "chapter_id": 1574, "verse_number": "३-२१२-२१", "content_sanskrit": "कर्मणस्तस्य घोरस् वसुधा निर्णयो भवेत्।\nदाने च सत्यवाक्ये च गुरुशुश्रूणे तथा।\nद्विजातिपूजने चाहं धर्मे च निरतः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026836, "chapter_id": 1574, "verse_number": "३-२१२-२२", "content_sanskrit": "अतिमानातिवादाभ्यां निवृत्तोस्मि द्विजोत्तम।\nकृषिं साध्वीति मन्यन्ते तत्र हिंसा परा स्मृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026837, "chapter_id": 1574, "verse_number": "३-२१२-२३", "content_sanskrit": "कर्षन्तो लाङ्गलैरुर्वीं घ्नन्ति भूमिशयान्बहून्।\nजीवानन्यांश्च बहुशस्तत्रकिं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026838, "chapter_id": 1574, "verse_number": "३-२१२-२४", "content_sanskrit": "धान्यबीजानि यान्याहुर्व्रीह्यादीनि द्विजोत्तम।\nसर्वाण्येतानि जीवा हि तत्र किं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026839, "chapter_id": 1574, "verse_number": "३-२१२-२५", "content_sanskrit": "अध्याक्रम् पशूंश्चापि घ्नन्ति वै भक्षयन्ति च।\nवृक्षांस्तथौषधीश्चापि छिन्दन्ति पुरुषा द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026840, "chapter_id": 1574, "verse_number": "३-२१२-२६", "content_sanskrit": "जीवा हि बहवो ब्रह्मन्वृक्षेषु च फलेषु च।\nउदके बहवश्चापि तत्रकिं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026841, "chapter_id": 1574, "verse_number": "३-२१२-२७", "content_sanskrit": "सर्वं व्याप्तमिदं ब्रह्मन्प्राणिभिः प्राणिजीवनैः।\nमत्स्यान्ग्रसन्ते मत्स्याश्च तत्रकिं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026842, "chapter_id": 1574, "verse_number": "३-२१२-२८", "content_sanskrit": "सत्वैः सत्वानि जीवन्ति बहुधा द्विजसत्तम।\nप्राणिनोऽन्योन्यभक्षाश्च तत्रकिं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026843, "chapter_id": 1574, "verse_number": "३-२१२-२९", "content_sanskrit": "चङ्क्रम्यमाणा जीवांश्च धरणीसंश्रितान्बहून्।\nपद्भ्यां घ्नन्ति नरा विप्र तत्र किं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026844, "chapter_id": 1574, "verse_number": "३-२१२-३०", "content_sanskrit": "उपविष्टाः शयानाश्च घ्नन्ति जीवाननेकशः।\nअज्ञानादथवा ज्ञानात्तत्रकिं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026845, "chapter_id": 1574, "verse_number": "३-२१२-३१", "content_sanskrit": "जीवैर्ग्रस्तमिदं सर्वमाकाशं पृथिवी तथा।\nअविज्ञानाच्च हिंसन्ति तत्र किं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026846, "chapter_id": 1574, "verse_number": "३-२१२-३२", "content_sanskrit": "अहिंसेति यदुक्तं हि पुरुषैर्विस्मितैः पुरा।\nके न हिंसन्ति जीवान्वै लोकेऽस्मिन्द्विजसत्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026847, "chapter_id": 1574, "verse_number": "३-२१२-३३", "content_sanskrit": "बहु संचिन्त्य इह वै नास्ति कश्चिदहिंसकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026848, "chapter_id": 1574, "verse_number": "३-२१२-३४", "content_sanskrit": "अहिंयासां तु निरता यतयो द्विजसत्तम।\nकुर्वन्त्येव हि हिंसां ते यत्नादल्पतरा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026849, "chapter_id": 1574, "verse_number": "३-२१२-३५", "content_sanskrit": "आलक्ष्याश्चैव पुरुषाः कुले जाता महागुणाः।\nमहाघोराणि कर्माणि कृत्वा लज्जन्ति वै न च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026850, "chapter_id": 1574, "verse_number": "३-२१२-३६", "content_sanskrit": "सुहृदः सुहृदोऽन्यांस्च दुर्हृदश्चापि दुर्हृदः।\nसम्यक्प्रवृत्तान्पुरुषानन सम्यगनुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026851, "chapter_id": 1574, "verse_number": "३-२१२-३७", "content_sanskrit": "समृद्धैश्चन नन्दन्ति बान्धवा बान्धवैरपि।\nगुरूंश्चैव विनिदन्ति मूढा निश्चितमानिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026852, "chapter_id": 1574, "verse_number": "३-२१२-३८", "content_sanskrit": "बहु लोके विपर्यस्तं दृश्यते द्विजसत्तम।\nधर्मयुक्तमधर्मं च तत्र किं प्रतिभाति ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026853, "chapter_id": 1574, "verse_number": "३-२१२-३९", "content_sanskrit": "वक्तुं बहुविधं शक्यं धर्माधर्मेषु कर्मसु।\nस्वकर्मनिरतो यो हि स यशः प्राप्नुयान्महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026854, "chapter_id": 1574, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि द्वादशाधिकद्विशततमोऽध्यायः ॥ २१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]