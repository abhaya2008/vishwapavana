[{"id": 2157317, "chapter_id": 4410, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2157318, "chapter_id": 4410, "verse_number": "१", "content_sanskrit": "तद् बलं सुमहद् दीर्णं त्वदीयं प्रेक्ष्य वीर्यवान् ।\nदधारैको रणे पाण्डून् वृषसेनोऽस्त्रमायया\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2157319, "chapter_id": 4410, "verse_number": "२", "content_sanskrit": "शरा दश दिशो मुक्ता वृषसेनेन तेजसा ।\nप्रविचेरुर्विनिर्भिद्य नरवाजिरथद्विपान्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2157320, "chapter_id": 4410, "verse_number": "३", "content_sanskrit": "तस्य दीप्ता महाबाणा विनिश्चेरुः सहस्रशः ।\nभानोरिव महाराज दीप्यमाना गभस्तयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2157321, "chapter_id": 4410, "verse_number": "४", "content_sanskrit": "तेनार्दिता महाराज रथिनः सादिनस्तथा ।\nनिपेतुरुर्व्यां सहसा वातनुन्ना इव द्रुमाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2157322, "chapter_id": 4410, "verse_number": "५", "content_sanskrit": "हयौघांश्च गजौघांश्च रथौघांश्च समन्ततः ।\nअपातयद् रणे राजन् शतशोऽथ सहस्रशः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2157323, "chapter_id": 4410, "verse_number": "६", "content_sanskrit": "कर्णात्मजं रणे दृष्ट्वा विचरन्तमभीतवत् ।\nराजानः सहिताः सर्वे परिवव्रुः समन्ततः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2157324, "chapter_id": 4410, "verse_number": "७", "content_sanskrit": "नाकुलिस्तु शतानीको वृषसेनं समभ्ययात् ।\nविव्याध चैनं दशभिर्नाराचैर्मर्मभेदिभिः\nतस्य कर्णसुतश्चापं छित्त्वा केतुमपातयत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2157325, "chapter_id": 4410, "verse_number": "८", "content_sanskrit": "तं भ्रातरमभीप्सन्तो द्रौपदेयाः समभ्ययुः ।\nकर्णात्मजं शरव्रातैः चक्रुश्चादृश्यमञ्जसा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2157326, "chapter_id": 4410, "verse_number": "९", "content_sanskrit": "तान् नदन्तोऽभ्यधावन्त द्रोणपुत्रमुखा रथाः ।\nछादयन्तो महाराज द्रौपदेयान् महारथान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2157327, "chapter_id": 4410, "verse_number": "१०", "content_sanskrit": "शरैर्नानाविधैस्तूर्णं पर्वतान् जलदा इव \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2157328, "chapter_id": 4410, "verse_number": "११", "content_sanskrit": "तान् पाण्डवाः प्रत्यगृह्णन् त्वरिताः पुत्रगृद्धिनः ।\nपाञ्चालाः सृञ्जया मात्स्याः केकयाश्चोद्यतायुधाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2157329, "chapter_id": 4410, "verse_number": "१२", "content_sanskrit": "तद् युद्धमभवद् घोरं तुमुलं लोमहर्षणम् ।\nत्वदीयैः पाण्डुपुत्राणां देवानामिव दानवैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2157330, "chapter_id": 4410, "verse_number": "१३", "content_sanskrit": "एवमुत्तमसंरम्भा युयुधुः कुरुपाण्डवाः ।\nपरस्परमुदीक्षन्तः परस्परकृतागसः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2157331, "chapter_id": 4410, "verse_number": "१४", "content_sanskrit": "तेषां ददृशिरे कोपाद् वपूंष्यमिततेजसाम् ।\nयुयुत्सूनामिवाकाशे पतत्रिवरभोगिनाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2157332, "chapter_id": 4410, "verse_number": "१५", "content_sanskrit": "भीमकर्णकृपद्रोणद्रौणिपार्षतसात्यकैः ।\nबभासे स रणोद्देशः कालसूर्यैरिवोदितैः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2157333, "chapter_id": 4410, "verse_number": "१६", "content_sanskrit": "प्रजानां सङ्क्षये घोरे यथा सूर्योदयो भवेत् ।\nशूराणामुदयस्तद्वत् स आसीत् पुरुषर्षभ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2157334, "chapter_id": 4410, "verse_number": "१७", "content_sanskrit": "तदाऽऽसीत् तुमुलं युद्धं निघ्नतामितरेतरम् ।\nमहाबलानां बलिभिः दानवानां यथा सुरैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2157335, "chapter_id": 4410, "verse_number": "१८", "content_sanskrit": "ततो युधिष्ठिरानीकमुदीर्णार्णवनिस्वनम् ।\nत्वदीयमवधीत् सैन्यं सम्प्रद्रुतमहारथम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2157336, "chapter_id": 4410, "verse_number": "१९", "content_sanskrit": "तत् प्रभग्नं बलं दृष्ट्वा शत्रुभिर्भृशमर्दितम् ।\nअलं द्रुतेन वः शूरा इति द्रोणोऽभ्यभाषत\nभारद्वाजममर्षश्च विक्रमश्च समाविशत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2157337, "chapter_id": 4410, "verse_number": "२०", "content_sanskrit": "समुद्धृत्य निषङ्गाच्च धनुर्ज्यामवमृज्य च ।\nमहाशरधनुष्पाणिः यन्तारमिदमब्रवीत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2157338, "chapter_id": 4410, "verse_number": "२१", "content_sanskrit": "सारथे याहि यत्रैष पाण्डरेण विराजता ।\nध्रियमाणेन च्छत्रेण राजा तिष्ठति धर्मराट्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2157339, "chapter_id": 4410, "verse_number": "२२", "content_sanskrit": "तदेतद् दीर्यते सैन्यं धार्तराष्ट्रमनेकधा ।\nएतत् संस्तम्भयिष्यामि प्रतिवार्य युधिष्ठिरम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2157340, "chapter_id": 4410, "verse_number": "२३", "content_sanskrit": "न हि मामतिवर्तन्ति संयुगे तात पाण्डवाः ।\nमात्स्यपाञ्चालराजानः सर्वे च सहसोमकाः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2157341, "chapter_id": 4410, "verse_number": "२४", "content_sanskrit": "अर्जुनो मत्प्रसादाद्धि महास्त्राणि समाप्तवान् ।\nन मामुत्सहते तात न भीमो न च सात्यकिः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2157342, "chapter_id": 4410, "verse_number": "२५", "content_sanskrit": "मत्प्रसादाद्धि बीभत्सुः परमेष्वासतां गतः ।\nममैवास्त्रं विजानाति धृष्टद्युम्नोऽपि पार्षतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2157343, "chapter_id": 4410, "verse_number": "२६", "content_sanskrit": "नायं संरक्षितुं कालः प्राणांस्तात जयैषिणा ।\nसाहसाग्र्यं पुरस्कृत्य यशसे च जयाय च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2157344, "chapter_id": 4410, "verse_number": "२७", "content_sanskrit": "एवं सञ्चोदितो यन्ता द्रोणमभ्यवहत् ततः ।\nतदा स्वहृदयानाश्वानभिमन्त्र्याशु हर्षयन्\nरथेन सवरूथेन भास्वरेण विराजता\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2157345, "chapter_id": 4410, "verse_number": "२८", "content_sanskrit": "तं करूशाश्च मत्स्याश्च चेदयश्च ससात्त्वताः ।\nपाण्डवाश्च सपाञ्चालाः सहिताः पर्यवारयन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2157346, "chapter_id": 4410, "verse_number": "२९", "content_sanskrit": "ततः शोणहयः क्रुद्धः चतुर्दन्त इव द्विपः ।\nप्रविश्य पाण्डवानीकं युधिष्ठिरमभिद्रवत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2157347, "chapter_id": 4410, "verse_number": "३०", "content_sanskrit": "तमविध्यच्छितैर्बाणैः कङ्कपत्रैर्युधिष्ठिरः ।\nतस्य द्रोणो धनुश्छित्वा तं द्रुतं समुपाद्रवत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2157348, "chapter_id": 4410, "verse_number": "३१", "content_sanskrit": "चक्ररक्षः कुमारस्तु पाञ्चालानां यशस्करः ।\nदधार द्रोणमायान्तं वेलेवोद्धूतमर्णवम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2157349, "chapter_id": 4410, "verse_number": "३२", "content_sanskrit": "स शूरमार्यव्रतिनं शस्त्रास्त्रकृतनिश्रमम् ।\nवारयद् द्रोणमायान्तं वेलेव मकरालयम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2157350, "chapter_id": 4410, "verse_number": "३३", "content_sanskrit": "द्रोणे निवारिते तेन सुकुमारेण मारिष ।\nसिंहनादरवश्चासीत् साधु साध्विति च स्वनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2157351, "chapter_id": 4410, "verse_number": "३४", "content_sanskrit": "सुकुमारस्ततो द्रोणं सायकेन महाहवे ।\nविव्याधोरसि सङ्क्रुद्धः सिंहनादमथाकरोत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2157352, "chapter_id": 4410, "verse_number": "३५", "content_sanskrit": "संवार्य तु रणे द्रोणं सुकुमारो महारथः ।\nशरैरनेकसाहस्रैः कृतहस्तो जितक्लमः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2157353, "chapter_id": 4410, "verse_number": "३६", "content_sanskrit": "तं शूरमार्यव्रतिनं मन्त्रास्त्रकृतनिश्चयम् ।\nचक्ररक्षमवामृद्गात् सुकुमारं द्विजपुङ्गवः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2157354, "chapter_id": 4410, "verse_number": "३७", "content_sanskrit": "स मध्यं प्राप्य सेनायां सर्वाः समचरद् दिशः ।\nतव सैन्यस्य गोप्ताऽऽसीद् भारद्वाजो महारथः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2157355, "chapter_id": 4410, "verse_number": "३८", "content_sanskrit": "शिखण्डिनं द्वादशभिः विंशत्या चोत्तमौजसम् ।\nनकुलं पञ्चभिर्विद्ध्वा सहदेवं च सप्तभिः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2157356, "chapter_id": 4410, "verse_number": "३९", "content_sanskrit": "युधिष्ठिरं द्वादशभिः द्रौपदेयांस्त्रिभिस्त्रिभिः ।\nसात्यकिं पञ्चभिर्विद्ध्वा मत्स्यं च दशभिः शरैः\nव्यक्षोभयद् रणे मुख्यानथ योधानभिद्रवन्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2157357, "chapter_id": 4410, "verse_number": "४०", "content_sanskrit": "युगन्धरस्ततो राजन् भारद्वाजं महारथम् ।\nवारयामास सङ्क्रुद्धो वेलेवोद्धूतमर्णवम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2157358, "chapter_id": 4410, "verse_number": "४१", "content_sanskrit": "युधिष्ठिरं स विद्ध्वाऽथ शरैः सन्नतपर्वभिः ।\nयुगन्धरं तु भल्लेन रथनीडादपातयत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2157359, "chapter_id": 4410, "verse_number": "४२", "content_sanskrit": "तं विजित्य महातेजा भारद्वाजो महामनाः ।\nअभ्यवर्तत सम्प्रेप्सुः कुन्तीपुत्रं युधिष्ठिरम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2157360, "chapter_id": 4410, "verse_number": "४३", "content_sanskrit": "ततो विराटद्रुपदौ केकयाः सात्यकिः शलः ।\nव्याघ्रदत्तश्च पाञ्चाल्यः सिंहसेनश्च वीर्यवान्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2157361, "chapter_id": 4410, "verse_number": "४४", "content_sanskrit": "एते चान्ये च बहवः परीप्सन्तो युधिष्ठिरम् ।\nआवव्रुस्तस्य पन्थानं किरन्तः सायकान् बहून्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2157362, "chapter_id": 4410, "verse_number": "४५", "content_sanskrit": "त्वरितः सिंहसेनस्तु द्रोणं विद्ध्वा महारथम् ।\nप्राणदत् सहसा नादं रोषयंश्च महारथान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2157363, "chapter_id": 4410, "verse_number": "४६", "content_sanskrit": "व्याघ्रदत्तश्च पाञ्चाल्यो द्रोणं विव्याध मार्गणैः ।\nपञ्चाशद्भिस्ततो राजन् ततस्ते चुक्रुशुर्जनाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2157364, "chapter_id": 4410, "verse_number": "४७", "content_sanskrit": "ततो विष्फार्य नयने धनुर्ज्यामवमृज्य च ।\nतळशब्दं महत् कृत्वा क्रुद्धस्तान् समभिद्रवत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2157365, "chapter_id": 4410, "verse_number": "४८", "content_sanskrit": "ततस्तत् सिंहसेनस्य शिरः कायात् सकुण्डलम् ।\nव्याघ्रदत्तस्य चाक्रम्य भल्लाभ्यामाहरद् बली\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2157366, "chapter_id": 4410, "verse_number": "४९", "content_sanskrit": "तान् प्रमृज्य शरव्रातैः पाण्डवानां महारथान् ।\nयुधिष्ठिरसमभ्याशे तस्थौ मृत्युरिवान्तकः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2157367, "chapter_id": 4410, "verse_number": "५०", "content_sanskrit": "तत आसीन्महान् शब्दो राजन् यौधिष्ठिरे बले ।\nहृतो राजेति योधानां समीपस्थे यतव्रते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2157368, "chapter_id": 4410, "verse_number": "५१", "content_sanskrit": "जजल्पुः सैनिकास्तत्र दृष्ट्वा द्रोणस्य विक्रमम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2157369, "chapter_id": 4410, "verse_number": "", "content_sanskrit": "सैनिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2157370, "chapter_id": 4410, "verse_number": "५२", "content_sanskrit": "अद्य राजा धार्तराष्ट्रः पाण्डवं सन्निगृह्य च ।\nआहरिष्यति नो मूलं धृतराष्ट्रं प्रहर्षयन्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2157371, "chapter_id": 4410, "verse_number": "५३", "content_sanskrit": "अद्य राजा धार्तराष्ट्रः कृतार्थो वै भविष्यति ।\nआनयिष्यति भ्रातॄणां नूनं हृष्टस्तु संयुगे\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2157372, "chapter_id": 4410, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2157373, "chapter_id": 4410, "verse_number": "५४", "content_sanskrit": "एवं सञ्जल्पतां तेषां तावकानां महारथः ।\nप्रायाज्जवेन कौन्तेयो रथघोषेण नादयन्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2157374, "chapter_id": 4410, "verse_number": "५५", "content_sanskrit": "शोणितोदां रथावर्तां कृत्वा विशसने नदीम् ।\nशूरास्थिचयसङ्कीर्णां प्रेतकूलापहारिणीम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2157375, "chapter_id": 4410, "verse_number": "५६", "content_sanskrit": "तां शरौघमहाफेनां प्रासमत्स्यसमाकुलाम् ।\nनदीमुत्तीर्य वेगेन कुरून् विद्राव्य पाण्डवः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2157376, "chapter_id": 4410, "verse_number": "५७", "content_sanskrit": "ततः किरीटी सहसा द्रोणानीकमभिद्रवत् ।\nछादयन्निषुजालेन महता मोहयन्निव\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2157377, "chapter_id": 4410, "verse_number": "५८", "content_sanskrit": "शीघ्रमभ्यस्यतो बाणान् सन्दधानस्य चानिशम् ।\nनान्तरं ददृशे कश्चित् कौन्तेयस्य यशस्विनः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2157378, "chapter_id": 4410, "verse_number": "५९", "content_sanskrit": "न दिशो नान्तरिक्षं च न द्यौर्नैव च मेदिनी ।\nअदृश्यत महाराज बाणभूतमिवाभवत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2157379, "chapter_id": 4410, "verse_number": "६०", "content_sanskrit": "नादृश्यत तदा राजन् तत्र किञ्चन संयुगे ।\nबाणान्धकारे महति कृते गाण्डीवधन्वना\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2157380, "chapter_id": 4410, "verse_number": "६१", "content_sanskrit": "सूर्ये चास्तमनुप्राप्ते रजसा चाभिसंवृते ।\nनाज्ञायत तदा शत्रुर्न सुहृन्न च कश्चन\nततोऽवहारं चक्रुस्ते द्रोणदुर्योधनादयः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2157381, "chapter_id": 4410, "verse_number": "६२", "content_sanskrit": "तान् विदित्वा भृशं त्रस्तानयुद्धमनसः परान् ।\nस्वान्यनीकानि बीभत्सुः शनकैरवहारयत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2157382, "chapter_id": 4410, "verse_number": "६३", "content_sanskrit": "ततोऽभितुष्टुवुः पार्थं प्रहृष्टाः पाण्डुसृञ्जयाः ।\nपाञ्चालाश्च मनोज्ञाभिः वाग्भिः सूर्यमिवर्षयः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2157383, "chapter_id": 4410, "verse_number": "६४", "content_sanskrit": "एवं स्वशिबिरं प्रायाद् जितशत्रुर्धनञ्जयः ।\nपृष्ठतः सर्वसैन्यानां मुदितः सहकेशवः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2157384, "chapter_id": 4410, "verse_number": "६५", "content_sanskrit": "मसारगल्वर्कसुवर्णरूप्यैः\nवज्रप्रवालैः स्फटिकैश्च मुख्यैः ।\nचित्रे रथे पाण्डुसुतो रराज\nनक्षत्रचित्रे वियतीव चन्द्रः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2157385, "chapter_id": 4410, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि पञ्चदशोऽध्यायः ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2157386, "chapter_id": 4410, "verse_number": "", "content_sanskrit": "द्रोणाभिषेकपर्वणि पञ्चदशोऽध्यायः ॥ १५ ॥\n॥ द्रोणयुद्धे प्रथमावहारः समाप्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2157387, "chapter_id": 4410, "verse_number": "", "content_sanskrit": "॥ द्रोणाभिषेकपर्व समाप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]