[{"id": 7001545000, "chapter_id": 21545, "verse_number": "१-४२-१", "content_sanskrit": "॥सूत उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001545001, "chapter_id": 21545, "verse_number": "१-४२-२", "content_sanskrit": "सरोवरेभ्यः पुण्योदा देव नद्यो विनिर्गताः ।\nमहौघतोया नद्यश्च ताः श्रृणुध्वं यथाक्रमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001545002, "chapter_id": 21545, "verse_number": "१-४२-३", "content_sanskrit": "आकाशाम्भोनिधेर्योऽसौ सोम इत्यभिधीयते ।\nआधारः सर्वभूतानां देवानाममृताकरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001545003, "chapter_id": 21545, "verse_number": "१-४२-४", "content_sanskrit": "तस्मात् प्रवृत्ता पुण्योदा नदी ह्याकाशगामिनी ।\nसप्तमेनानिलपथा प्रयाता विमलोदका ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001545004, "chapter_id": 21545, "verse_number": "१-४२-५", "content_sanskrit": "सा ज्योतिषि निवर्तन्ती ज्योतिर्गणनिषेविता ।\nताराकोजिसहस्राणां नभसश्च समायता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001545005, "chapter_id": 21545, "verse_number": "१-४२-६", "content_sanskrit": "माहेन्द्रेण गजेन्द्रेण आकाशपथयायिना ।\nक्रीडिता ह्यन्तरतले या सा विक्षोभितोदका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001545006, "chapter_id": 21545, "verse_number": "१-४२-७", "content_sanskrit": "नैकैर्विमानसङ्घातैः प्रक्रामद्भिर्नभस्तलम् ।\nसिद्धैरुपस्पृष्टजला महापुण्यजला शिवा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001545007, "chapter_id": 21545, "verse_number": "१-४२-८", "content_sanskrit": "वायुना प्रेर्यमाणा च अनेकाभोगगामिनी ।\nपरिवर्त्तत्यहरहर्यथा सूर्यस्तथैव सा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001545008, "chapter_id": 21545, "verse_number": "१-४२-९", "content_sanskrit": "चत्वार्यशीतिः प्रतता योजनानां समन्ततः ।\nवेगेन कुर्वती मेरुं सा प्रयाता प्रदक्षिणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001545009, "chapter_id": 21545, "verse_number": "१-४२-१०", "content_sanskrit": "विभिद्यमाना सलिलैस्तैजसेनानिलेन च ।\nमेरोरुत्तरकूटेषु पतिताथ चतुर्ष्वपि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001545010, "chapter_id": 21545, "verse_number": "१-४२-११", "content_sanskrit": "मेरुकूटतटान्तेभ्य उत्कृष्टेभ्यो निवर्तिता ।\nविकीर्यमाण सलिला चतुर्द्धासंसृतोदका ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001545011, "chapter_id": 21545, "verse_number": "१-४२-१२", "content_sanskrit": "षष्टियोजनसाहस्रं निरालम्बनमम्बरम् ।\nनिपपात महाभाग मेरोस्तस्य चतुर्द्दिशम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001545012, "chapter_id": 21545, "verse_number": "१-४२-१३", "content_sanskrit": "सा चतुर्ष्वभितश्चैव महापादेषु शोभना ।\nपुण्या मन्दरपूर्वेण पतिता हि महानदी ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001545013, "chapter_id": 21545, "verse_number": "१-४२-१४", "content_sanskrit": "पूर्वेणांशेन देवानां सर्वसिद्धगणालयम् ।\nसुवर्णचित्रकटकं नैकनिर्झरकन्दरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001545014, "chapter_id": 21545, "verse_number": "१-४२-१५", "content_sanskrit": "प्लावयन्ती सशैलेन्द्रं मन्दरञ्चारुकन्दरम् ।\nवप्रप्रतापशमनैरनेकैः स्फाटिकोदकैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001545015, "chapter_id": 21545, "verse_number": "१-४२-१६", "content_sanskrit": "तथा चैत्ररथं रम्यं प्लावयन्ती प्रदक्षिणम् ।\nप्रविष्टा ह्यम्बरनदी ह्यरुणोदसरोवरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001545016, "chapter_id": 21545, "verse_number": "१-४२-१७", "content_sanskrit": "अरुणोदान्निवृत्ताऽथ शीतान्ते रम्यनिर्झरे ।\nशैले सिद्धगणावासे निपपात सुगामिनी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001545017, "chapter_id": 21545, "verse_number": "१-४२-१८", "content_sanskrit": "सीता नाम महा पुण्या नदीनां प्रवरा नदी ।\nसा निकुञ्जनिरुद्धा तु अनेकाभोगगामिनी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001545018, "chapter_id": 21545, "verse_number": "१-४२-१९", "content_sanskrit": "शीतान्ताशिखराद्भ्रष्टा सुकुञ्जे वरपर्वते ।\nनिपपात महाभागा तस्मादपि सुमञ्जसम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001545019, "chapter_id": 21545, "verse_number": "१-४२-२०", "content_sanskrit": "तस्मान्माल्यवतं शैलं भावयन्ती वरापगा ।\nवैकङ्कं समनुप्राप्ता वैकङ्कान्मणिपर्वतम् ।\nमणिपर्वतान्महाशैलं ऋषभं नैककन्दरम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001545020, "chapter_id": 21545, "verse_number": "१-४२-२१", "content_sanskrit": "एवं शैलसहस्राणि दारयन्ती महानदी ।\nपतिताऽथ महाशैले जठरे सिद्धसेविते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001545021, "chapter_id": 21545, "verse_number": "१-४२-२२", "content_sanskrit": "तस्मादपि महाशैलं देवकूटं तरङ्गिणी ।\nतस्य कुक्षिसमुद्रान्ता क्रमेण पृथिवीं गता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001545022, "chapter_id": 21545, "verse_number": "१-४२-२३", "content_sanskrit": "सैवं स्थलीसहस्राणि शैलराजशतानि च ।\nवनानि च विचित्राणि सरांसि विविधानि च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001545023, "chapter_id": 21545, "verse_number": "१-४२-२४", "content_sanskrit": "स्रावयन्ती महाभागा विस्फारेष्ववलीकदा ।\nनदी सहस्रानुगता प्रवृत्ता च महानदी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001545024, "chapter_id": 21545, "verse_number": "१-४२-२५", "content_sanskrit": "भद्राश्वं सुमहाद्वीपं प्लावयन्ती वरापगा ।\nप्रविष्टा ह्यर्णवं पूर्वं पूर्वे द्वीपे महानदी ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001545025, "chapter_id": 21545, "verse_number": "१-४२-२६", "content_sanskrit": "दक्षिणेऽपि प्रपन्ना या शैलेन्द्रे गन्धमादने ।\nचित्रैः प्रपातैर्विधैर्नैकविस्फालितोदका ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001545026, "chapter_id": 21545, "verse_number": "१-४२-२७", "content_sanskrit": "तद्घन्धमादनवनं नन्दनं देवनन्दनम् ।\nप्लावयन्ती महाभागा प्रयाता सा प्रदक्षिणम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001545027, "chapter_id": 21545, "verse_number": "१-४२-२८", "content_sanskrit": "नाम्ना ह्यलकनन्देति सर्वलोकेषु विश्रुता ।\nप्रविशत्युत्तरसरो मानसं देवमानसम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001545028, "chapter_id": 21545, "verse_number": "१-४२-२९", "content_sanskrit": "मानसाच्छैलराजानं रम्यं त्रिशिखरं गता ।\nत्रिकूटाच्छैलशिखरात् कलिङ्गशिखरं गता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001545029, "chapter_id": 21545, "verse_number": "१-४२-३०", "content_sanskrit": "कलिङ्गशिखराद्भ्रष्टा रुचके निपपात सा ।\nरुचकान्निषधं प्राप्ता ताम्राभं निषधादपि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001545030, "chapter_id": 21545, "verse_number": "१-४२-३१", "content_sanskrit": "ताम्राभशिखरार्द्भ्रष्टा गता श्वेतोदरं गिरिम्  ।\nतस्मात्सुमूलं शैलेन्द्रं वसुधारञ्च पर्वतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001545031, "chapter_id": 21545, "verse_number": "१-४२-३२", "content_sanskrit": "हेमकूटं गता तस्माद्देवश्रृङ्गे ततो गता ।\nतस्माद्गता महाशैलं ततश्चापि पिशाचकम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001545032, "chapter_id": 21545, "verse_number": "१-४२-३३", "content_sanskrit": "पिशाचकाच्छैलवरात् पञ्चकूटङ्गता पुनः ।\nपञ्चकूटात्तु कैलासं देवावासं शिलोच्चयम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001545033, "chapter_id": 21545, "verse_number": "१-४२-३४", "content_sanskrit": "तस्य कुक्षिषु विभ्रान्ता नैककन्दरसानुषु ।\nहिमवत्युत्तमनदी निपपाताचलोत्तमे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001545034, "chapter_id": 21545, "verse_number": "१-४२-३५", "content_sanskrit": "सैवं शैलसहस्राणि दारयन्ती महानदी ।\nस्थलीशतान्यनेकानि प्लावयन्त्याशुगाणिनी ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001545035, "chapter_id": 21545, "verse_number": "१-४२-३६", "content_sanskrit": "वनानाञ्च सहस्राणि कन्दराणां शतानि च  ।\nस्रावयन्ती महाभागा प्रयाता दक्षिणोदधिम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001545036, "chapter_id": 21545, "verse_number": "१-४२-३७", "content_sanskrit": "रम्या योजनविस्तीर्णा शैलकुक्षिषु संवृता ।\nयाधृता देवदेवेन शङ्करेण महात्मना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001545037, "chapter_id": 21545, "verse_number": "१-४२-३८", "content_sanskrit": "पावनी द्विजशार्दूल घोराणामपि पाप्मनाम् ।\nशङ्करस्याङ्कसंस्पर्शान्महादेवस्य धीमतः ।\nद्विगुणं पवित्रसलिला सर्वलोके महानदी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001545038, "chapter_id": 21545, "verse_number": "१-४२-३९", "content_sanskrit": "अनुशैलं समन्ताच्च निर्गता बहुभिर्मुखैः ।\nअथोऽन्येनाभिधानेन ख्याता नद्यः सहस्रशः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001545039, "chapter_id": 21545, "verse_number": "१-४२-४०", "content_sanskrit": "तस्माद्धिमवतो गङ्गा गता सा तु महानदी ।\nएवं गङ्गेति नाम्नादिप्रकाशा सिद्धसेविता ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001545040, "chapter_id": 21545, "verse_number": "१-४२-४१", "content_sanskrit": "धन्यास्ते सत्तमा देशा यत्र गङ्गा महानदी ।\nरुद्रसाद्ध्यानिलादित्यैर्जुष्टतोया यशस्वती ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001545041, "chapter_id": 21545, "verse_number": "१-४२-४२", "content_sanskrit": "महापादं प्रवक्ष्यामि मेरोरपि हि पश्चिमम् ।\nनानारत्नाकारं पुण्यं पुण्यकृद्भिर्निषेवितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001545042, "chapter_id": 21545, "verse_number": "१-४२-४३", "content_sanskrit": "विपुलं शैलराजानं विपुलोदरकन्दरम्  ।\nनितम्बकुञ्ज कटकैर्विमलैर्म्मण्डितोदरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001545043, "chapter_id": 21545, "verse_number": "१-४२-४४", "content_sanskrit": "अपि या त्र्यम्बकस्यैषा त्रिदशैः सेवितोदका ।\nवायुवेगा गताभोगा लतेव भ्रामिता पुनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001545044, "chapter_id": 21545, "verse_number": "१-४२-४५", "content_sanskrit": "मेरुकूटतटाद्भ्रष्टा प्रहतैः स्वादितोदका ।\nविस्तीर्य्यमाणसलिला निर्म्मलांशुकसन्निभा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001545045, "chapter_id": 21545, "verse_number": "१-४२-४६", "content_sanskrit": "तस्य कूटेऽम्बरनदी सिद्धचारणसेविता  ।\nप्रदक्षिणमथावृत्य पतिता सा तु गामिनी ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001545046, "chapter_id": 21545, "verse_number": "१-४२-४७", "content_sanskrit": "देवभ्राजं महाभ्राजं सवैभ्राजं महावनम् ।\nप्लावयन्ती महाभागा नानापुष्पफलोदका ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001545047, "chapter_id": 21545, "verse_number": "१-४२-४८", "content_sanskrit": "प्रदक्षिणं प्रकुर्वाणा नानावनविभूषिता ।\nप्रविष्टा पश्विमसरः सितोदं विमलोदकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001545048, "chapter_id": 21545, "verse_number": "१-४२-४९", "content_sanskrit": "सा सितोदाद्विनिष्क्रान्ता सुपक्षं पर्व्वतं गता ।\nसुपक्षतस्तु पुण्योदात्ततो देवर्षिसेविता ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001545049, "chapter_id": 21545, "verse_number": "१-४२-५०", "content_sanskrit": "सुपक्षकूटतटगा तस्माच्च संशितोदका ।\nनिपपात महाभागा रमण्यं शिखिपर्व्वतम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001545050, "chapter_id": 21545, "verse_number": "१-४२-५१", "content_sanskrit": "शिखेश्च पर्वतात् कङ्कं कङ्काद्वैढूर्य्यपर्व्वतम् ।\nवैढूर्य्यात् कपिलं शैलं तस्माच्च गन्धमादनम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001545051, "chapter_id": 21545, "verse_number": "१-४२-५२", "content_sanskrit": "तस्माद्गिरिवरात् प्राप्ता पिञ्जरं वरपर्व्वतम् ।\nपिञ्जरात् सरसं याता तस्माच्च कुमुदाचलम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001545052, "chapter_id": 21545, "verse_number": "१-४२-५३", "content_sanskrit": "मधुमन्तं जनञ्चैव मुकुटञ्च शिलोच्चयम् ।\nमुकुटाच्छैलशिखरात् कृष्णं याता महागिरिम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001545053, "chapter_id": 21545, "verse_number": "१-४२-५४", "content_sanskrit": "कृष्णात् श्वेतं महाशैलं महानगनिषेवितम् ।\nश्वेतात् सहस्रशिखरं शैलेन्द्रं पतिता पुनः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001545054, "chapter_id": 21545, "verse_number": "१-४२-५५", "content_sanskrit": "अनेकाभिः स्रवन्तीभिराप्यायितजला शिवा  ।\nएवं शैलसहस्राणि सादयन्ती महानदी ।\nपारिजाते महाशैले निपपाताशुगामिनी ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001545055, "chapter_id": 21545, "verse_number": "१-४२-५६", "content_sanskrit": "अनेकनिर्झरनदी गुहासानुषु राजते ।\nतस्य कुक्षिष्वनेकासु भ्रान्ततोया तरङ्गिणी ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001545056, "chapter_id": 21545, "verse_number": "१-४२-५७", "content_sanskrit": "व्याहन्यमानसंवेगा गण्डशैलैरनेकशः ।\nसंविद्यमानसलिला गता च धरणीतले ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001545057, "chapter_id": 21545, "verse_number": "१-४२-५८", "content_sanskrit": "केतुमालं महाद्वीपं नानाम्लेच्छ गणैर्युतम्  ।\nप्लावयन्ती महाभागा प्रयाता पश्चिमार्णवम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001545058, "chapter_id": 21545, "verse_number": "१-४२-५९", "content_sanskrit": "सुवर्णचित्रपार्श्वे तु सुपार्श्वेऽप्युत्तरे गिरौ  ।\nमेरोश्चित्रमहापादे महासत्त्वनिषेविते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001545059, "chapter_id": 21545, "verse_number": "१-४२-६०", "content_sanskrit": "मेरुकूटतटाद्भ्रष्टा पवनेनेरितोदका ।\nअनेकाभोगवक्राङ्गी क्षिप्यमाणा नभस्तले ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001545060, "chapter_id": 21545, "verse_number": "१-४२-६१", "content_sanskrit": "षष्टियोजनसाहस्रे निरालम्बेऽम्बरे शुभे ।\nविकीर्यमाणा मालेव निपपात महानदी ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001545061, "chapter_id": 21545, "verse_number": "१-४२-६२", "content_sanskrit": "एवं कूटतटैर्भ्रष्टा नैकैर्देवर्षिसेवितैः ।\nविकीर्यमाणसलिला नैकपुष्पोडुपोत्कचा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001545062, "chapter_id": 21545, "verse_number": "१-४२-६३", "content_sanskrit": "नानारत्नवनोद्देशमरण्यं सवितुर्व्वनम् ।\nमहावनं महाभागा प्लावयन्ती प्रदक्षिणम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001545063, "chapter_id": 21545, "verse_number": "१-४२-६४", "content_sanskrit": "सरोवरं महापुण्यं महाभागनिषेवितम् ।\nतत्राविवेश कल्याणी महाभद्रं सितोदका ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001545064, "chapter_id": 21545, "verse_number": "१-४२-६५", "content_sanskrit": "भद्रसोमेति नाम्ना हि महापारा महाजवा ।\nमहानदी महापुण्या महाभद्रा विनिर्गता ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001545065, "chapter_id": 21545, "verse_number": "१-४२-६६", "content_sanskrit": "नैकनिर्झरवप्राढ्या शंखकूटतटे तु सा ।\nतत्र कूटे गिरितटे निपपाताशुगामिनी ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001545066, "chapter_id": 21545, "verse_number": "१-४२-६७", "content_sanskrit": "शंखकूटतटाद्भ्रष्टा पपात वृषपर्व्वतम् ।\nवृषपर्व्वताद्वत्सगिरिं नागशैलं ततो गता ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001545067, "chapter_id": 21545, "verse_number": "१-४२-६८", "content_sanskrit": "तस्मान्नीलं नगश्रेष्ठं संप्राप्ता वर्षपर्व्वतम् ।\nनीलात् कपिञ्जलञ्चैव इन्द्रनीलं च निम्नगा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001545068, "chapter_id": 21545, "verse_number": "१-४२-६९", "content_sanskrit": "ततः परं महानीलं हेमश्रृङ्गञ्च सा ययौ  ।\nहेमश्रृङ्गाद्गता श्वेतं श्वेताच्च सुनगं ययौ ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001545069, "chapter_id": 21545, "verse_number": "१-४२-७०", "content_sanskrit": "सुनगात् शतश्रृङ्गञ्च संप्राप्ता सा महानदी ।\nशतश्रृङ्गान्महाशैलं पुष्करं पुष्पमण्डितम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001545070, "chapter_id": 21545, "verse_number": "१-४२-७१", "content_sanskrit": "पुष्कराच्च महाशैलं द्विराजं सुमहाबलम्  ।\nवराहपर्व्वतं तस्मान्मयूरञ्च शिलोच्चयम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001545071, "chapter_id": 21545, "verse_number": "१-४२-७२", "content_sanskrit": "मयूराच्चैकशिखरं कन्दरोदरमण्डितम्  ।\nजारुधिं शैल शिखरं निपपाताशुगामिनी ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001545072, "chapter_id": 21545, "verse_number": "१-४२-७३", "content_sanskrit": "एवं गिरिसहस्राणि दारयन्ती महानदी ।\nत्रिश्रृङ्गं श्रृङ्गकलिलं मर्यादापर्वतं गता ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001545073, "chapter_id": 21545, "verse_number": "१-४२-७४", "content_sanskrit": "त्रिश्रृङ्गतटविभ्रष्टा महाभागनिषेविता ।\nमेरुकूटतटाद्भ्रष्टा पवनेनेरितोदका ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001545074, "chapter_id": 21545, "verse_number": "१-४२-७५", "content_sanskrit": "विरुद्धं पर्वतवरं पपात विमलोदका ।\nप्लावयन्ती महाभागा प्रयाता पश्चिमार्णवम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001545075, "chapter_id": 21545, "verse_number": "१-४२-७६", "content_sanskrit": "सुवर्णभुवि पार्श्वे तु सुपार्श्वेप्युत्तरे गिरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001545076, "chapter_id": 21545, "verse_number": "१-४२-७७", "content_sanskrit": "मेरोश्वित्रे महापादे महासत्त्वनिषेविते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001545077, "chapter_id": 21545, "verse_number": "१-४२-७८", "content_sanskrit": "कन्दरोदरविभ्रष्टा तस्मादपि तरङ्गिणी ।\nनैकभोगा पपातोर्वीं चित्रपुष्पोढुपोत्कचा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001545078, "chapter_id": 21545, "verse_number": "१-४२-७९", "content_sanskrit": "प्लावयन्ती प्रमुदिता उत्तरान् सा कुरून् शिवा ।\nमहाद्वीपस्य मध्येन प्रयाता सोत्तरार्णवम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001545079, "chapter_id": 21545, "verse_number": "१-४२-८०", "content_sanskrit": "एवं तास्तु महानद्यश्चतस्रो विमलोदकाः ।\nमहागिरितटभ्रष्टाः संप्रयाताश्चतुर्दिशम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001545080, "chapter_id": 21545, "verse_number": "१-४२-८१", "content_sanskrit": "तत्सेयं कथितप्राया पृथिवी बहुविस्तरा ।\nमेरुशैलमहाकीर्णाऽविशच्च सर्वतोदिशम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001545081, "chapter_id": 21545, "verse_number": "१-४२-८२", "content_sanskrit": "चतुर्महाद्वीपवती चतुराक्रीडकानना ।\nचतुष्केतुमहावृक्षा चतुर्वरसरस्वती ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001545082, "chapter_id": 21545, "verse_number": "१-४२-८३", "content_sanskrit": "चतुर्महाशैलवती चतुर्भुजगसंश्रया ।\nअष्टोत्तरमहाशैला तथाष्टवरपर्वता ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001545083, "chapter_id": 21545, "verse_number": "१-४२-८४", "content_sanskrit": "इति श्रीमहापुराणे वायुप्रोक्ते भुवनविन्यासो नाम द्विचत्वारिंशोऽध्यायः ॥ ४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]