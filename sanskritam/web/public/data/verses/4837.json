[{"id": 2181081, "chapter_id": 4837, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181082, "chapter_id": 4837, "verse_number": "१", "content_sanskrit": "धर्मात्मनि महासत्त्वे सत्यसन्धे जितात्मनि ।\nदेवव्रते महाभागे शरतल्पगतेऽच्युते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181083, "chapter_id": 4837, "verse_number": "२", "content_sanskrit": "शयाने वीरशयने भीष्मे शन्तनुनन्दने ।\nगाङ्गेये पुरुषव्याघ्रे पाण्डवैः पर्युपस्थिते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181084, "chapter_id": 4837, "verse_number": "३", "content_sanskrit": "काः कथाः समवर्तन्त तस्मिन् वीरसमागमे ।\nगतेषु सर्वसैन्येषु तन्मे शंस महामुने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181085, "chapter_id": 4837, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181086, "chapter_id": 4837, "verse_number": "४", "content_sanskrit": "शरतल्पगते भीष्मे कौरवाणां धुरन्धरे ।\nआजग्मुर्ऋषयः सिद्धा नारदप्रमुखा नृप\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2181087, "chapter_id": 4837, "verse_number": "५", "content_sanskrit": "हतशिष्टाश्च राजानो युधिष्ठिरपुरोगमाः ।\nधृतराष्ट्रश्च कृष्णश्च भीमार्जुनयमास्तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2181088, "chapter_id": 4837, "verse_number": "६", "content_sanskrit": "तेऽभिगम्य महात्मानो भरतानां पितामहम् ।\nअन्वशोचन्त गाङ्गेयमादित्यं पतितं यथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2181089, "chapter_id": 4837, "verse_number": "७", "content_sanskrit": "मुहूर्तमिव च ध्यात्वा नारदो देवदर्शनः ।\nउवाच पाण्डवान् सर्वान् हतशिष्टांश्च पार्थिवान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2181090, "chapter_id": 4837, "verse_number": "८", "content_sanskrit": "प्राप्तकालं च आचक्षे भीष्मोऽयमनुयुज्यताम् ।\nअस्तमेति हि गाङ्गेयो भानुमानिव भारत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2181091, "chapter_id": 4837, "verse_number": "९", "content_sanskrit": "अयं प्राणानुत्सिसृक्षुस्तं सर्वेऽभ्येत्य पृच्छत ।\nकृत्स्नान् हि विविधान् धर्मांश्चातुर्वर्ण्यस्य वेत्त्ययम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2181092, "chapter_id": 4837, "verse_number": "१०", "content_sanskrit": "एष वृद्धः पुरा लोकान् सम्प्राप्नोति सुदुर्लभान् ।\nतं शीघ्रमनुयुञ्जध्वं संशयान् मनसि स्थितान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2181093, "chapter_id": 4837, "verse_number": "११", "content_sanskrit": "एवमुक्ता नारदेन भीष्ममीयुर्नराधिपाः ।\nप्रष्टुं चाशक्नुवन्तस्ते वीक्षाञ्चक्रुः परस्परम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2181094, "chapter_id": 4837, "verse_number": "१२", "content_sanskrit": "अथोवाच हृषीकेशं पाण्डुपुत्रो युधिष्ठिरः ।\nनान्यस्त्वद् देवकीपुत्र शक्तः प्रष्टुं पितामहम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2181095, "chapter_id": 4837, "verse_number": "१३", "content_sanskrit": "प्रव्याहारय दुर्धर्षं त्वमग्ने मधुसूदन ।\nत्वं हि नस्तात सर्वेषां सर्वधर्मविदुत्तमः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2181096, "chapter_id": 4837, "verse_number": "१४", "content_sanskrit": "एवमुक्तः पाण्डवेन भगवान् केशवस्तदा ।\nअभिगम्य दुराधर्षं प्रव्याहरयदच्युतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2181097, "chapter_id": 4837, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2181098, "chapter_id": 4837, "verse_number": "१५", "content_sanskrit": "कच्चित् सुखेन रजनी व्युष्टा ते राजसत्तम ।\nविस्पष्टलक्षणा बुद्धिः कच्चिच्चोपस्थिता तव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2181099, "chapter_id": 4837, "verse_number": "१६", "content_sanskrit": "कच्चिज्ज्ञानानि सर्वाणि प्रतिभान्ति च तेऽनघ ।\nन ग्लायते च हृदयं नच ते व्याकुलं मनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2181100, "chapter_id": 4837, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2181101, "chapter_id": 4837, "verse_number": "१७", "content_sanskrit": "दाहो मोहः श्रमश्चैव क्लमो ग्लानिस्तथा रुजा ।\nतव प्रसादाद् गोविन्द सद्यो व्यपगतानघ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2181102, "chapter_id": 4837, "verse_number": "१८", "content_sanskrit": "यच्च भूतं भविष्यच्च भवच्च परमद्युते ।\nतत् सर्वमनुपश्यामि पाणौ फलमिवाहितम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2181103, "chapter_id": 4837, "verse_number": "१९", "content_sanskrit": "वेदोक्ताश्चैव ये धर्मा वेदान्तनिहिताश्च ये ।\nतान् सर्वान् सम्प्रपश्यामि वरदानात् तवाच्युत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2181104, "chapter_id": 4837, "verse_number": "२०", "content_sanskrit": "शिष्टैश्च धर्मो यः प्रोक्तः स च मे हृदि वर्तते ।\nदेशजातिकुलानां च धर्मज्ञोऽस्मि जनार्दन\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2181105, "chapter_id": 4837, "verse_number": "२१", "content_sanskrit": "चतुर्ष्वाश्रमधर्मेषु योऽर्थः स च हृदि स्थितः ।\nराजधर्माश्च सकलानवगच्छामि केशव ।\nसर्वधर्मेषु यो ह्यर्थः स च मे हृदि संस्थितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2181106, "chapter_id": 4837, "verse_number": "२२", "content_sanskrit": "यत्र यत्र च वक्तव्यं तद् वक्ष्यामि जनार्दन ।\nतव प्रसादाद्धि शुभा मनो मे बुद्धिराविशत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2181107, "chapter_id": 4837, "verse_number": "२३", "content_sanskrit": "युवेव चास्मि संवृत्तस्त्वदनुध्यानबृंहितः ।\nवक्तुं श्रेयः समर्थोऽस्मि त्वत्प्रसादाज्जनार्दन\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2181108, "chapter_id": 4837, "verse_number": "२४", "content_sanskrit": "स्वयं किमर्थं तु भवान् श्रेयो न प्राह पाण्डवम् ।\nकिं ते विवक्षितं चात्र तदाशु वद माधव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2181109, "chapter_id": 4837, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2181110, "chapter_id": 4837, "verse_number": "२५", "content_sanskrit": "यशसः श्रेयसश्चैव मूलं मां विद्धि भारत ।\nमत्तः सर्वेऽभिनिर्वृत्ता भावाः सदसदात्मकाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2181111, "chapter_id": 4837, "verse_number": "२६", "content_sanskrit": "शीतांशुश्चन्द्र इत्युक्ते को लोके विस्मयिष्यति ।\nतथैव यशसा पूर्णे मयि को विस्मयिष्यति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2181112, "chapter_id": 4837, "verse_number": "२७", "content_sanskrit": "आधेयं तु मया भूयो यशस्तव महाद्युते ।\nततो मे विपुला बुद्धिस्त्वयि भीष्म समाहिता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2181113, "chapter_id": 4837, "verse_number": "२८", "content_sanskrit": "यावद्धि पृथिवीपाल पृथिवी स्थास्यते ध्रुवा ।\nतावत् तस्याक्षया कीर्तिर्लोकाननुचरिष्यति \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2181114, "chapter_id": 4837, "verse_number": "२९", "content_sanskrit": "यच्च त्वं वक्ष्यसे भीष्म पाण्डवायानुपृच्छते ।\nवेदप्रवादा इव ते स्थास्यन्ति वसुधातळे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2181115, "chapter_id": 4837, "verse_number": "३०", "content_sanskrit": "यश्चैतेन प्रमाणेन योक्ष्यत्यात्मानमात्मना ।\nस फलं सर्वपुण्यानां प्रेत्य चानुभविष्यति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2181116, "chapter_id": 4837, "verse_number": "३१", "content_sanskrit": "एतस्मात् कारणाद् भीष्म मतिर्दिव्या मया हि ते ।\nदत्ता यशो विप्रथेत कथं भूयस्तवेति ह\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2181117, "chapter_id": 4837, "verse_number": "३२", "content_sanskrit": "यावद्धि प्रथते लोके पुरुषस्य यशो भुवि ।\nतावत्तस्याक्षयं स्थानं भवतीति विनिश्चितम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2181118, "chapter_id": 4837, "verse_number": "३३", "content_sanskrit": "राजानो हतशिष्टास्त्वां राजन्नभित आसते ।\nधर्माननुयुयुक्षन्तस्तेभ्यः प्रब्रूहि भारत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2181119, "chapter_id": 4837, "verse_number": "३४", "content_sanskrit": "भवान् हि वयसा वृद्धः श्रुताचारसमन्वितः ।\nकुशलो राजधर्माणां पूर्वेषामपराश्च ये\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2181120, "chapter_id": 4837, "verse_number": "३५", "content_sanskrit": "जन्मप्रभृति ते कश्चिद् वृजिनं न ददर्श ह ।\nज्ञातारं मनुधर्माणां त्वां विदुः सर्वपार्थिवाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2181121, "chapter_id": 4837, "verse_number": "३६", "content_sanskrit": "तेभ्यः पितेव पुत्रेभ्यो राजन् ब्रूहि परं नयम् ।\nऋषयश्च हि देवाश्च त्वया नित्यमुपासिताः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2181122, "chapter_id": 4837, "verse_number": "३७", "content_sanskrit": "तस्माद् वक्तव्यमेवेह त्वया पश्याम्यशेषतः ।\nधर्मान् शुश्रूषमाणेभ्यः पृष्टेन च सता पुनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2181123, "chapter_id": 4837, "verse_number": "३८", "content_sanskrit": "वक्तव्यं विदुषा चेति धर्ममाहुर्मनीषिणः ।\nअप्रतिब्रुवतः कष्टो दोषो हि भवति प्रभो\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2181124, "chapter_id": 4837, "verse_number": "३९", "content_sanskrit": "तस्मात् पुत्रैश्च पौत्रैश्च धर्मान् पृष्टः सनातनान् ।\nविद्वान् जिज्ञासमानैस्त्वं प्रब्रूहि भरतर्षभ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2181125, "chapter_id": 4837, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे चतुःपञ्चाशोऽध्यायः ॥ ५४ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]