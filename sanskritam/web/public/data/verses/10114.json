[{"id": 6000114000, "chapter_id": 10114, "verse_number": null, "content_sanskrit": "अथ एकोनविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000114001, "chapter_id": 10114, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.001.m4a", "display_order": 2}, {"id": 6000114002, "chapter_id": 10114, "verse_number": "५-१९-१", "content_sanskrit": "किंपुरुषे तु वर्षे भगवन्तमादिपुरुषं लक्ष्मणाग्रजं सीताभिरामं रामं तच्चरणसन्निकर्षाभिरतः परमभागवतो हनूमान् सह किंपुरुषैरविरतभक्तिरुपास्ते॥ ५/१९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.002.m4a", "display_order": 3, "topics": [{"text": "किंपुरुषभारतवर्षवर्णनम्", "range": "१–१५"}]}, {"id": 6000114003, "chapter_id": 10114, "verse_number": "५-१९-२", "content_sanskrit": "आर्ष्टिषेणेन सह गन्धर्वैरनुपगीयमानां परमकल्याणीं भर्तृभगवत्कथां समुपशृणोति, स्वयं चेदं गायति॥ ५/१९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.003.m4a", "display_order": 4}, {"id": 6000114004, "chapter_id": 10114, "verse_number": "५-१९-३", "content_sanskrit": "ओं नमो भगवत उत्तमश्लोकाय नम आर्यलक्षणशीलव्रताय नम उपाश्रितात्मने नमः साधुवादनिकर्षणाय नमो ब्रह्मण्यदेवाय महापुरुषाय महाराजाय नम इति॥ ५/१९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.004.m4a", "display_order": 5}, {"id": 6000114005, "chapter_id": 10114, "verse_number": "५-१९-४", "content_sanskrit": "यत्तद्विशुद्धानुभवमात्रमेकं स्वतेजसा ध्वस्तगुणत्र्यवस्थम्।\nप्रत्यक्प्रशान्तं सुधियोपलम्भनमनामरूपं निरहं प्रपद्ये॥ ५/१९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.005.m4a", "display_order": 6}, {"id": 6000114006, "chapter_id": 10114, "verse_number": "५-१९-५", "content_sanskrit": "मर्त्यावतारस्त्विह मर्त्यशिक्षणं रक्षोवधायैव न केवलं विभोः।\nकुतोऽन्यथा स्यू रमतः स्व आत्मन् सीताकृतानि व्यसनानीश्वरस्य॥ ५/१९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.006.m4a", "display_order": 7}, {"id": 6000114007, "chapter_id": 10114, "verse_number": "५-१९-६", "content_sanskrit": "न वै स आत्माऽऽत्मवतामधीश्वरो भुङ्क्ते हि दुःखं भगवान्वासुदेवः।\nन स्‍त्रीकृतं कश्मलमश्नुवीत न लक्ष्मणं चापि जहाति कर्हिचित्॥ ५/१९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.007.m4a", "display_order": 8}, {"id": 6000114008, "chapter_id": 10114, "verse_number": "५-१९-७", "content_sanskrit": "न जन्म नूनं महतो न सौभगं न चाङ्गबुद्धिर्नाकृतिस्तोषहेतुः।\nतैर्यग्विसृष्टानपि नो वनौकसश्चकार सख्ये बत लक्ष्मणाग्रजः॥ ५/१९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.008.m4a", "display_order": 9}, {"id": 6000114009, "chapter_id": 10114, "verse_number": "५-१९-८", "content_sanskrit": "सुरोऽसुरो वाऽथ नरोऽथ वानरः सर्वात्मना यः सुकृतज्ञमुत्तमम्।\nभजेत रामं मनुजाकृतिं हरिं य उत्तराननयत् कोसलान्दिवम् इति॥ ५/१९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.009.m4a", "display_order": 10}, {"id": 6000114010, "chapter_id": 10114, "verse_number": "५-१९-९", "content_sanskrit": "भारतेऽपि वर्षे भगवान्नरनारायणाख्यः आकल्पान्तमुपचितधर्मज्ञानवैराग्यैश्वर्योपशमोपरमात्मो-पलम्भोऽनुग्रहायात्मवतामनुकम्पया तपोऽव्यक्तगतिश्चरति॥ ५/१९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.010.m4a", "display_order": 11}, {"id": 6000114011, "chapter_id": 10114, "verse_number": "५-१९-१०", "content_sanskrit": "तं भगवान्नारदो वर्णाश्रमवतीभिर्भारतीभिः प्रजाभिर्भगवत्प्रोक्ताभ्यां साङ्ख्ययोगाभ्यां भगवदनुभावोपवर्णनं सावर्णेरुपदेक्ष्यमाणः परमभक्तिभावेनोपसरति इदं चोदाहरति॥ ५/१९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.011.m4a", "display_order": 12}, {"id": 6000114012, "chapter_id": 10114, "verse_number": "५-१९-११", "content_sanskrit": "ओं नमो भगवत उपशमशीलायोपरतानात्म्यायाकिञ्चनवित्ताय ऋषिऋषभाय नरनारायणाय परमहंसाय परमगुरवे आत्मारामाधिपतये नमो नम इति॥ ५/१९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.012.m4a", "display_order": 13}, {"id": 6000114013, "chapter_id": 10114, "verse_number": null, "content_sanskrit": "गायति चेदम्—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.013.m4a", "display_order": 14}, {"id": 6000114014, "chapter_id": 10114, "verse_number": "५-१९-१२", "content_sanskrit": "कर्ताऽस्य सर्गादिषु यो न बध्यते न हन्यते देहगतोऽपि दैहिकैः।\nद्रष्टुर्न दृग् यस्य गुणैर्विदूष्यते तस्मै नमोऽसक्तविविक्तसाक्षिणे॥ ५/१९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.014.m4a", "display_order": 15}, {"id": 6000114015, "chapter_id": 10114, "verse_number": "५-१९-१३", "content_sanskrit": "इदं हि योगेश्वरयोगनैपुणं हिरण्यगर्भो भगवान् जगाद यत्।\nयदन्तकाले त्वयि निर्गुणे मनो भक्त्या निधायोज्झति दुष्कलेवरम्॥ ५/१९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.015.m4a", "display_order": 16}, {"id": 6000114016, "chapter_id": 10114, "verse_number": "५-१९-१४", "content_sanskrit": "यथैहिकामुष्मिककामलम्पटः सुतेषु दारेषु धनेषु चिन्तयन्।\nशङ्केत विद्वान् कुकलेवरात्ययाद्यस्तस्य यत्नः श्रम एव केवलम्॥ ५/१९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.016.m4a", "display_order": 17}, {"id": 6000114017, "chapter_id": 10114, "verse_number": "५-१९-१५", "content_sanskrit": "तन्नः प्रभो त्वं कुकलेवरार्पितां त्वन्माययाऽहंममतामधोक्षज।\nभिन्द्याम येनाशु वयं सुदुर्भिदां विधेहि योगं त्वयि नः सुभावितमिति॥ ५/१९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.017.m4a", "display_order": 18}, {"id": 6000114018, "chapter_id": 10114, "verse_number": "५-१९-१६", "content_sanskrit": "भारतेऽप्यस्मिन्वर्षे सरिच्छैलाः सन्ति बहवो मलयो मन्दरप्रस्थो मैनाकस्‍त्रिकूट ऋषभः कनकः कोसलः सह्यो वेदगिरिः ऋष्यमूकः श्रीशैलो वेङ्कटो महेन्द्रो वारिधारो विन्ध्यः शुक्तिमानृक्षगिरिः पारियात्रो द्रोणश्चित्रकूटो गोवर्धनो रैवतकः ककुभो नीलः कोकामुख इन्द्रकीलको हिमगिरिरिति चान्ये च शतशः सहस्रशः शैलास्तेषां नितम्बप्रभवा नदा नद्यश्च सन्त्यसङ्ख्याताः॥ ५/१९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.018.m4a", "display_order": 19, "topics": [{"text": "तत्रापि भारतवर्षस्य सर्ववर्षेभ्यः श्रैष्ठ्यं तस्यैव कर्मभूमित्वं च", "range": "१६–२८"}]}, {"id": 6000114019, "chapter_id": 10114, "verse_number": "५-१९-१७", "content_sanskrit": "एतासामपो भारत्यः प्रजा नामभिरेव पुनन्तीनामात्मना चोपस्पृशन्ति॥ ५/१९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.019.m4a", "display_order": 20}, {"id": 6000114020, "chapter_id": 10114, "verse_number": "५-१९-१८", "content_sanskrit": "चन्द्रवटा ताम्रपर्णी अवटोदका कृतमाला वैहायसी कावेरी वेणी पयोदा यमुना सरस्वती शर्करावर्ता तुङ्गभद्रा कृष्णा भीमरथी गोदावरी निर्विन्ध्या पयोष्णी तापी सुरसा नर्मदा चर्मण्वती, सिन्धुः अन्धः शोणश्च महानदौ, वेदस्मृतिः ऋषिकुल्या त्रिसोमा कौशिकी मन्दाकिनी दृषद्वती गोमती सरयूः ओघवती सप्तवती घोषणा सुषोमा शतमाला चन्द्रभागा शुतुद्री मरुद्वृधा वितस्ता असिक्नी विश्वेति महानद्यः॥ ५/१९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.020.m4a", "display_order": 21}, {"id": 6000114021, "chapter_id": 10114, "verse_number": "५-१९-१९", "content_sanskrit": "अस्मिन्नेव वर्षे पुरुषैर्लब्धजन्मभिः शुक्ललोहितकृष्णवर्णेन स्वारब्धेन कर्मणा दिव्यमानुषनारकगतयो बह्व्य आत्मन आनुपूर्वेण सर्वा ह्येव सर्वेषां विधीयन्ते यथावर्णविधानमपवर्गश्चापि भवति॥ ५/१९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.021.m4a", "display_order": 22}, {"id": 6000114022, "chapter_id": 10114, "verse_number": "५-१९-२०", "content_sanskrit": "योऽसौ भगवति सर्वभूतात्मन्यनात्म्येऽनिरुक्तेऽनिलयने परमात्मनि वासुदेवेऽनन्यनिमित्त-भक्तियोगलक्षणो नानागतिनिमित्ताविद्याग्रन्थिरन्धनद्वारेण यदा हि महापुरुषसङ्गतिः।\nएतदेव हि देवा गायन्ति॥ ५/१९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.022.m4a", "display_order": 23}, {"id": 6000114023, "chapter_id": 10114, "verse_number": "५-१९-२१", "content_sanskrit": "अहो बतैषां किमकारि शोभनं प्रसन्न एषां स्विदुत स्वयं हरिः।\nयैर्जन्म लब्धं नृषु भारताजिरे मुकुन्दसेवौपयिकं स्पृहात्मभिः॥ ५/१९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.023.m4a", "display_order": 24}, {"id": 6000114024, "chapter_id": 10114, "verse_number": "५-१९-२२", "content_sanskrit": "किं दुष्करैर्नः क्रतुभिस्तपोव्रतैर्दानादिभिर्वा द्युजयेन फल्गुना।\nन यत्र नारायणपादपङ्कजस्मृतिः प्रमुष्टाऽतिशयेन्द्रियोत्सवात्॥ ५/१९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.024.m4a", "display_order": 25}, {"id": 6000114025, "chapter_id": 10114, "verse_number": "५-१९-२३", "content_sanskrit": "कल्पायुषां स्थानजयात्पुनर्भवात्क्षणायुषां भारतभूजयो वरः।\nक्षणेन मर्त्येन कृतं मनस्विनः संन्यस्य संयान्त्यभयं पदं हरेः॥ ५/१९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.025.m4a", "display_order": 26}, {"id": 6000114026, "chapter_id": 10114, "verse_number": "५-१९-२४", "content_sanskrit": "न यत्र वैकुण्ठकथासुधाऽपगा न साधवो भागवतास्तदाश्रयाः।\nन यत्र यज्ञेशमखा महोत्सवाः सुरेशलोकोऽपि न याति सेव्यताम्॥ ५/१९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.026.m4a", "display_order": 27}, {"id": 6000114027, "chapter_id": 10114, "verse_number": "५-१९-२५", "content_sanskrit": "प्राप्ता नृजातिं त्विह ये च जन्तवो ज्ञानक्रियाद्रव्यकलापसम्भृताः।\nन चेद्यतेरन्नपुनर्भवाय ते भूयो वनौका इव यान्ति बन्धनम्॥ ५/१९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.027.m4a", "display_order": 28}, {"id": 6000114028, "chapter_id": 10114, "verse_number": "५-१९-२६", "content_sanskrit": "यैः श्रद्धया बर्हिषि भागशो हविर्निरुप्तमिष्टं विधिमन्त्रवस्तुतः।\nएकः पृथङ् नामभिराहुतो मुदा गृह्णाति पूर्णः स्वयमाशिषां प्रभुः॥ ५/१९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.028.m4a", "display_order": 29}, {"id": 6000114029, "chapter_id": 10114, "verse_number": "५-१९-२७", "content_sanskrit": "सत्यं दिशत्यर्थितमर्थितो नृणां नैवार्थितो यत्पुनरर्थिनो मदः।\nस्वयं विधत्ते भजतामनिच्छतामिच्छाविधानं निजपादपल्लवम्॥ ५/१९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.029.m4a", "display_order": 30}, {"id": 6000114030, "chapter_id": 10114, "verse_number": "५-१९-२८", "content_sanskrit": "यद्यत्र नः स्वर्गसुखावशेषितं स्विष्टस्य दत्तस्य कृतस्य शोभनम्।\nतेनाब्जनाभस्मृतिजन्मनः स्याद्वर्षे हरिर्यद्भजतां शं तनोति॥ ५/१९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.030.m4a", "display_order": 31}, {"id": 6000114031, "chapter_id": 10114, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.031.m4a", "display_order": 32}, {"id": 6000114032, "chapter_id": 10114, "verse_number": "५-१९-२९", "content_sanskrit": "जम्बुद्वीपस्य च राजन्नुपद्वीपानष्टौ ह्येक उपदिशन्ति सगरात्मजैरश्वान्वेषण इमां महीं परितो निखनद्भिरुपकल्पिताः॥ ५/१९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.032.m4a", "display_order": 33, "topics": [{"text": "स्वर्णप्रस्थाद्यष्टोपद्वीपाः", "range": "२९–३१"}]}, {"id": 6000114033, "chapter_id": 10114, "verse_number": "५-१९-३०", "content_sanskrit": "तद्यथा स्वर्णप्रस्थश्चेन्द्रशुक्ल आवर्तनो रमणको मन्दरहरिणः पाञ्चजन्यः सिंहलो लङ्केति॥ ५/१९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.033.m4a", "display_order": 34}, {"id": 6000114034, "chapter_id": 10114, "verse_number": "५-१९-३१", "content_sanskrit": "एवं तव भारतोत्तमजम्बुद्वीपवर्षविभागो यथोपदेशमुपवर्णितः॥ ५/१९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_019/BhP_05.019.034.m4a", "display_order": 35}, {"id": 6000114035, "chapter_id": 10114, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे एकोनविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]