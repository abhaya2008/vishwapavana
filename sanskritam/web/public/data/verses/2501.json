[{"id": 2071198, "chapter_id": 2501, "verse_number": "१२-६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071199, "chapter_id": 2501, "verse_number": "१२-६-१", "content_sanskrit": "एतावदुक्त्वा देवर्षिर्विरराम स नारदः।\nयुधिष्ठिरस्तु राजर्षिर्दध्यौ शोकपरिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071200, "chapter_id": 2501, "verse_number": "१२-६-२", "content_sanskrit": "तं दीनमनसं वीरमधोवदनमातुरम्।\nनिःश्वसन्तं यथा नागं पर्यश्रुनयनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071201, "chapter_id": 2501, "verse_number": "१२-६-३", "content_sanskrit": "कुन्ती शोकपरीताङ्गी दुःखोपहतचेतना।\nअब्रवीन्मधुराभाषा काले वचनमर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071202, "chapter_id": 2501, "verse_number": "१२-६-४", "content_sanskrit": "युधिष्ठिर महाबाहो नैनं शोचितुमर्हसि।\nजहि शोकं महाप्राज्ञ श्रृणु चेदं वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071203, "chapter_id": 2501, "verse_number": "१२-६-५", "content_sanskrit": "याचितः स मया पूर्वं भ्राता ज्ञापयितुं तव।\nभास्करेण च देवेन पित्रा धर्मभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071204, "chapter_id": 2501, "verse_number": "१२-६-६", "content_sanskrit": "यद्वाच्यं हितकामेन सुहृदां भूतिमिच्छता।\nतथा दिवाकरेणोक्तः स्वप्नान्ते मम चाग्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071205, "chapter_id": 2501, "verse_number": "१२-६-७", "content_sanskrit": "न चैनमशकद्भानुरहं वा स्नेहकारणैः।\nपुरा प्रत्यनुनेतुं वा नेतुं वाऽप्येकतां त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071206, "chapter_id": 2501, "verse_number": "१२-६-८", "content_sanskrit": "ततः कालपरीतः स वैरस्योद्धरणे रतः।\nप्रतीपकारी युष्माकमिति चोपेक्षितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071207, "chapter_id": 2501, "verse_number": "१२-६-९", "content_sanskrit": "इत्युक्तो धर्मराजस्तु मात्रा बाष्पाकुलेक्षणः।\nउवाच वाक्यं धर्मात्मा शोकव्याकुललोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071208, "chapter_id": 2501, "verse_number": "१२-६-१०", "content_sanskrit": "भवत्या गूढमन्त्रत्वाद्वञ्चिताः स्म तदा भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071209, "chapter_id": 2501, "verse_number": "१२-६-११", "content_sanskrit": "शशाप च महातेजाः सर्वलोकेषु योषितः।\nन गुह्यं धारयिष्यन्तीत्येवं दुःखसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071210, "chapter_id": 2501, "verse_number": "१२-६-१२", "content_sanskrit": "स राजा पुत्रपौत्राणां संबन्धिसुहृदां तदा।\nस्मरन्नुद्विग्नहृदयो बभूवोद्विग्नचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071211, "chapter_id": 2501, "verse_number": "१२-६-१३", "content_sanskrit": "ततः शोकपरीतात्मा सधूम इव पावकः।\nनिर्वेदमगमद्धीमान्राज्ये संतापपीडितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071212, "chapter_id": 2501, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि षष्ठोऽध्यायः॥ ६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]