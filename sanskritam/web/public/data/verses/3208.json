[{"id": 2102253, "chapter_id": 3208, "verse_number": "१४-६४-१", "content_sanskrit": "वैशम्पायन उवाच।\nततस्ते प्रययुर्हृष्टाः प्रहृष्टनरवाहनाः।\nरथघोषेण महता पूरयन्तो वसुन्धराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102254, "chapter_id": 3208, "verse_number": "१४-६४-२", "content_sanskrit": "संस्तूयमानाः स्तुतिभिः सूतमागधबन्दिभिः।\nस्वेन सैन्येन संवीता यथाऽऽदित्याः स्वरश्मिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102255, "chapter_id": 3208, "verse_number": "१४-६४-३", "content_sanskrit": "पाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि।\nबभौ युधिष्ठिरस्तत्र पौर्णमास्यामिवोडुराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102256, "chapter_id": 3208, "verse_number": "१४-६४-४", "content_sanskrit": "जयाशिषः प्रहृष्टानां नराणां पथि पाण्डवः।\nप्रत्यगृह्णाद्यथान्यायं यथावत्पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102257, "chapter_id": 3208, "verse_number": "१४-६४-५", "content_sanskrit": "तथैव सैनिका राजन्राजानमनुयान्ति ये।\nतेषां हलहलाशब्दो दिवं स्तब्ध्वा व्यतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102258, "chapter_id": 3208, "verse_number": "१४-६४-६", "content_sanskrit": "सरांसि सरितश्चैव वनान्युपवनानि च।\nअत्यक्रामन्महाराजो गिरिं चाप्यन्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102259, "chapter_id": 3208, "verse_number": "१४-६४-७", "content_sanskrit": "स्मिन्देशे च राजेन्द्र यत्र तद्द्रव्यमुत्तमम्।\nचक्रे निवेशनं राजा पाण्डवः सहसैनिकैः।\nशिवे देशे समे चैव तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102260, "chapter_id": 3208, "verse_number": "१४-६४-८", "content_sanskrit": "अग्रतो ब्राह्मणान्कृत्वा तपोविद्यादमान्वितान्।\nपुरोहितं च कौरव्य वेदवेदाङ्गपारगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102261, "chapter_id": 3208, "verse_number": "१४-६४-९", "content_sanskrit": "आग्निवेश्यं च राजानो ब्राह्मणाः सपुरोधसः।\nकृत्वा शान्तिं यथान्यायं सर्वशः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102262, "chapter_id": 3208, "verse_number": "१४-६४-१०", "content_sanskrit": "कृत्वा तु मध्ये राजानममात्यांश्च यथाविधि।\nषट्पदं नवसङ्ख्यानं निवेशं चक्रिरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102263, "chapter_id": 3208, "verse_number": "१४-६४-११", "content_sanskrit": "मत्तानां वारणेन्द्राणां निवेशं च यथाविधि।\nकारयित्वा स राजेन्द्रो ब्राह्मणानिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102264, "chapter_id": 3208, "verse_number": "१४-६४-१२", "content_sanskrit": "अस्मिन्कार्ये द्विजश्रेष्ठा नक्षत्रे दिवसे शुभे।\nयथा भवन्तो मन्यन्ते कर्तुमर्हन्ति तत्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102265, "chapter_id": 3208, "verse_number": "१४-६४-१३", "content_sanskrit": "न नः कालात्ययो वै स्यादिहैव परिलम्बताम्।\nइति निश्चित्य विप्रेन्द्राः क्रियतां यदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102266, "chapter_id": 3208, "verse_number": "१४-६४-१४", "content_sanskrit": "श्रुत्वैतद्व********* ब्राह्मणाः सपुरोधसः।\nइदमूचुर्वचो हृष्टा धर्मराजप्रियेप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102267, "chapter_id": 3208, "verse_number": "१४-६४-१५", "content_sanskrit": "अद्यैव नक्षत्रिमहश्च पुण्यं\nयतामहे श्रेष्ठतमक्रियासु।\nतपोभिरद्येह वसाम राज-\nन्नुपोष्यतां चापि भवद्भिरद्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102268, "chapter_id": 3208, "verse_number": "१४-६४-१६", "content_sanskrit": "श्रुत्वा तु तेषां द्विजसत्तमानां\nकृतोपवासा रजनीं नरेन्द्राः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102269, "chapter_id": 3208, "verse_number": "१४-६४-१७", "content_sanskrit": "ऊषुः प्रतीताः कुशसंस्तरेषु\nयथाऽध्वरे प्रज्वलिता हुताशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102270, "chapter_id": 3208, "verse_number": "१४-६४-१८", "content_sanskrit": "ततो निशा सा व्यगमन्महात्मनां\nसंशृण्वतां विप्रसमीरिता गिरः।\nततः प्रभाते विमले द्विजर्षभा\nवचोऽब्रुवन्धर्मसुतं नराधिपम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102271, "chapter_id": 3208, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि चतुःषष्टितमोऽध्यायः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]