[{"id": 7006380000, "chapter_id": 26380, "verse_number": "२-३७-१", "content_sanskrit": "वैशम्पायन उवाच\nस कृष्णस्तत्र बलवान् रौहिणेयेन संगतः ।\nमथुरां यादवाकीर्णां पुरीं तां सुखमावसत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006380001, "chapter_id": 26380, "verse_number": "२-३७-२", "content_sanskrit": "प्राप्तयौवनदेहस्तु युक्तो राजश्रिया विभुः ।\nचचार मथुरां प्रीतः सवनाकरभूषणाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006380002, "chapter_id": 26380, "verse_number": "२-३७-३", "content_sanskrit": "कस्यचित् त्वथ कालस्य राजा राजगृहेश्वरः ।\nसस्मार निहतं कंसं जरासंधः प्रतापवान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006380003, "chapter_id": 26380, "verse_number": "२-३७-४", "content_sanskrit": "युद्धाय योजितो भूयो दुहितृभ्यां महीपतिः ।\nदश सप्त च संग्रामाञ्जरासंधस्य यादवाः ।\nददुर्न चैनं समरे हन्तुं शेकुर्महारथाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006380004, "chapter_id": 26380, "verse_number": "२-३७-५", "content_sanskrit": "ततो मागधराट् श्रीमांश्चतुरङ्गवलान्वितः ।\nभूयोऽप्यष्टादशं कर्तुं संग्रामं स समारभत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006380005, "chapter_id": 26380, "verse_number": "२-३७-६", "content_sanskrit": "वैलक्ष्यात् पुनरेवासौ राजा राजगृहेश्वरः ।\nजरासंधो बली श्रीमान् पाकशासनविक्रमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006380006, "chapter_id": 26380, "verse_number": "२-३७-७", "content_sanskrit": "स साधनेन महता बृहद्रथसुतो बली ।\nकृष्णस्य वधमन्विच्छन् भूयो वै संन्यवर्तत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006380007, "chapter_id": 26380, "verse_number": "२-३७-८", "content_sanskrit": "तं श्रुत्वा सहिताः सर्वे निवृत्तं मगधेश्वरम् ।\nयादवा मन्त्रयामासुर्जरासंधभयार्दिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006380008, "chapter_id": 26380, "verse_number": "२-३७-९", "content_sanskrit": "ततः प्राह महातेजा विकद्रुर्नयकोविदः ।\nकृष्णं कमलपत्राक्षमुग्रसेनस्य शृण्वतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006380009, "chapter_id": 26380, "verse_number": "२-३७-१०", "content_sanskrit": "श्रूयतां तात गोविन्द कुलस्यास्य समुद्भवः ।\nश्रूयतामभिधास्यामि प्राप्तकालमहं ततः ।\nयुक्तं चेन्मन्यसे साधो करिष्यसि वचो मम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006380010, "chapter_id": 26380, "verse_number": "२-३७-११", "content_sanskrit": "यादवस्यास्य वंशस्य समुद्भवमशेषतः ।\nयथा मे कथितः पूर्वं व्यासेन विदितात्मना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006380011, "chapter_id": 26380, "verse_number": "२-३७-१२", "content_sanskrit": "आसीद् राजा मनोर्वंशे श्रीमानिक्ष्वाकुसम्भवः ।\nहर्यश्व इति विख्यातो महेन्द्रसमविक्रमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006380012, "chapter_id": 26380, "verse_number": "२-३७-१३", "content_sanskrit": "तस्यासीद् दयिता भार्या मधोर्दैत्यस्य वै सुता ।\nदेवी मधुमती नाम यथेन्द्रस्य शची तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006380013, "chapter_id": 26380, "verse_number": "२-३७-१४", "content_sanskrit": "सा यौवनगुणोपेता रूपेणाप्रतिमा भुवि ।\nमनोरथकरी राज्ञः प्राणेभ्योऽपि गरीयसी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006380014, "chapter_id": 26380, "verse_number": "२-३७-१५", "content_sanskrit": "दानवेन्द्रकुले जाता सुश्रोणी कामरूपिणी ।\nएकपत्नीव्रतधरा खेचरा रोहिणी यथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006380015, "chapter_id": 26380, "verse_number": "२-३७-१६", "content_sanskrit": "सा तमिक्ष्वाकुशार्दूलं कामयामास कामिनी ।\nस कदाचिन्नरश्रष्ठो भ्रात्रा ज्येष्ठेन माधव ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006380016, "chapter_id": 26380, "verse_number": "२-३७-१७", "content_sanskrit": "राज्यान्निरस्तो विश्वस्तः सोऽयोध्यां सम्परित्यजत् ।\nस तदाल्पपरीवारः प्रियया सहितो वने ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006380017, "chapter_id": 26380, "verse_number": "२-३७-१८", "content_sanskrit": "रेमे समेत्य कालज्ञः प्रियया कमलेक्षणः ।\nभ्रात्रा विनिष्कृतं राज्यात् प्रोवाच कमलेक्षणा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006380018, "chapter_id": 26380, "verse_number": "२-३७-१९", "content_sanskrit": "एह्यागच्छ नरश्रेष्ठ त्यज राज्यकृतां स्पृहाम् ।\nगच्छावः सहितौ वीर मधोर्मम पितुर्गृहम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006380019, "chapter_id": 26380, "verse_number": "२-३७-२०", "content_sanskrit": "रम्यं मधुवनं नाम कामपुष्पफलद्रुमम् ।\nसहितौ तत्र रंस्यावो यथा दिवि गतौ तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006380020, "chapter_id": 26380, "verse_number": "२-३७-२१", "content_sanskrit": "पितुर्मे दयितस्त्वं हि मातुर्मम च पार्थिव ।\nमत्प्रियार्थं प्रियतरो भ्रातुश्च लवणस्य वै ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006380021, "chapter_id": 26380, "verse_number": "२-३७-२२", "content_sanskrit": "रंस्यावस्तत्र सहितौ राज्यस्थाविव कामगौ ।\nतत्र गत्वा नरश्रेष्ठ ह्यमराविव नन्दने ।\nभद्रं ते विहरिष्यावो यथा देवपुरे तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006380022, "chapter_id": 26380, "verse_number": "२-३७-२३", "content_sanskrit": "तं त्यजाव महाराज भ्रातरं तेऽभिमानिनम् ।\nआवयोर्द्वेषिणं नित्यं मत्तं राज्यमदेन वै ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006380023, "chapter_id": 26380, "verse_number": "२-३७-२४", "content_sanskrit": "धिगिमं गर्हितं वासं भृत्यवच्च पराश्रयम् ।\nगच्छावः सहितौ वीर पितुर्मे भवनान्तिकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006380024, "chapter_id": 26380, "verse_number": "२-३७-२५", "content_sanskrit": "तस्य सम्यक्प्रवृत्तस्य पूर्वजं भ्रातरं प्रति ।\nकामार्तस्य नरेन्द्रस्य पत्न्यास्तद् रुरुचे वचः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006380025, "chapter_id": 26380, "verse_number": "२-३७-२६", "content_sanskrit": "ततो मधुपुरं राजा हर्यश्वः स जगाम च ।\nभार्यया सह कामिन्या कामी पुरुषपुङ्गवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006380026, "chapter_id": 26380, "verse_number": "२-३७-२७", "content_sanskrit": "मधुना दानवेन्द्रेण स साम्ना समुदाहृतः ।\nस्वागतं वत्स हर्यश्व प्रीतोऽस्मि तव दर्शनात् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006380027, "chapter_id": 26380, "verse_number": "२-३७-२८", "content_sanskrit": "यदेतन्मम राज्यं वै सर्वं मधुवनं विना ।\nददामि तव राजेन्द्र वासश्च प्रतिगृह्यताम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006380028, "chapter_id": 26380, "verse_number": "२-३७-२९", "content_sanskrit": "वनेऽस्मिँल्लवणश्चायं सहायस्ते भविष्यति ।\nअमित्रनिग्रहे चैव कर्णधारत्वमेष्यति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006380029, "chapter_id": 26380, "verse_number": "२-३७-३०", "content_sanskrit": "पालयैनं शुभं राष्ट्रं समुद्रानूपभूषितम् ।\nगोसमृद्धं श्रिया जुष्टमाभीरप्रायमानुषम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006380030, "chapter_id": 26380, "verse_number": "२-३७-३१", "content_sanskrit": "अत्र ते वसतस्तात दुर्गं गिरिपुरं महत् ।\nभविता पार्थिवावासः सुराष्ट्रविषयो महान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006380031, "chapter_id": 26380, "verse_number": "२-३७-३२", "content_sanskrit": "अनूपविषयश्चैव समुद्रान्ते निरामयः ।\nआनर्तं नाम ते राष्ट्रं भविष्यत्यायतं महत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006380032, "chapter_id": 26380, "verse_number": "२-३७-३३", "content_sanskrit": "तद् भविष्यमहं मन्ये कालयोगेन पार्थिव ।\nअध्यास्यतां यथाकालं पार्थिवं वृत्तमुत्तमम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006380033, "chapter_id": 26380, "verse_number": "२-३७-३४", "content_sanskrit": "यायातमपि वंशस्ते समेष्यति च यादवम् ।\nअनु वंशं च वंशस्ते सोमस्य भविता किल ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006380034, "chapter_id": 26380, "verse_number": "२-३७-३५", "content_sanskrit": "एष मे विभवस्तात तवेमं विषयोत्तमम् ।\nदत्त्वा यास्यामि तपसे सागरं लवणालयम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006380035, "chapter_id": 26380, "verse_number": "२-३७-३६", "content_sanskrit": "लवणेन समायुक्तस्त्वमिमं विषयोत्तमम् ।\nपालयस्वाखिलं तात स्वस्य वंशस्य वृद्धये ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006380036, "chapter_id": 26380, "verse_number": "२-३७-३७", "content_sanskrit": "बाढमित्येव हर्यश्वः प्रतिजग्राह तत् पुरम् ।\nस च दैत्यस्तपोवासं जगाम वरुणालयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006380037, "chapter_id": 26380, "verse_number": "२-३७-३८", "content_sanskrit": "हर्यश्वश्च महातेजा दिव्ये गिरिवरोत्तमे ।\nनिवेशयामास पुरं वासार्थममरोपमः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006380038, "chapter_id": 26380, "verse_number": "२-३७-३९", "content_sanskrit": "आनर्तं नाम तद् राष्ट्रं सुराष्ट्रं गोधनायुतम् ।\nअचिरेणैव कालेन समृद्धं प्रत्यपद्यत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006380039, "chapter_id": 26380, "verse_number": "२-३७-४०", "content_sanskrit": "अनूपविषये चैव वेलावनविभूषितम् ।\nविचित्रं क्षेत्रसस्याढ्यं प्राकारग्रामसंकुलम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006380040, "chapter_id": 26380, "verse_number": "२-३७-४१", "content_sanskrit": "शशास नृपतिः स्फीतं तद् राष्ट्रं राष्ट्रवर्द्धनः ।\nराजधर्मेण यशसा प्रजानां नन्दिवर्द्धनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006380041, "chapter_id": 26380, "verse_number": "२-३७-४२", "content_sanskrit": "तस्य सम्यक प्रचारेण हर्यश्वस्य महात्मनः ।\nव्यवर्धत तदक्षोभ्य राष्ट्रं राष्ट्रगुणैर्युतम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006380042, "chapter_id": 26380, "verse_number": "२-३७-४३", "content_sanskrit": "स हि राजा स्थितो राज्ये राजवृत्तेन शोभितः ।\nप्राप्तः कुलोचितां लक्ष्मीं वृत्तेन च नयेन च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006380043, "chapter_id": 26380, "verse_number": "२-३७-४४", "content_sanskrit": "तस्यैव च सुवृत्तस्य पुत्रकामस्य धीमतः ।\nमधुमत्यां सुतो जज्ञे यदुर्नाम महायशाः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006380044, "chapter_id": 26380, "verse_number": "२-३७-४५", "content_sanskrit": "सोऽवर्धत महातेजा यदुर्दुन्दुभिनिःस्वनः ।\nराजलक्षणसम्पन्नः सपत्नैर्दुरतिक्रमः ॥ ४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006380045, "chapter_id": 26380, "verse_number": "२-३७-४६", "content_sanskrit": "यदुर्नामाभवत् पुत्रो राजलक्षणपूजितः ।\nयथास्य पूर्वजो राजा पूरुः स सुमहायशाः ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006380046, "chapter_id": 26380, "verse_number": "२-३७-४७", "content_sanskrit": "स एक एव तस्यासीत् पुत्रः परमशोभनः ।\nऊर्जितः पृथिवीभर्ता हर्यश्वस्य महात्मनः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006380047, "chapter_id": 26380, "verse_number": "२-३७-४८", "content_sanskrit": "दस वर्षसहस्राणि स कृत्वा राज्यमव्ययम् ।\nजगाम त्रिदिवं राजा धर्मेणाप्रतिमो भुवि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006380048, "chapter_id": 26380, "verse_number": "२-३७-४९", "content_sanskrit": "ततो यदुरदीनात्मा प्रजाभिस्त्वभ्यषिच्यत ।\nपितर्युपरते श्रीमान् क्रमेणार्क इवोदितः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006380049, "chapter_id": 26380, "verse_number": "२-३७-५०", "content_sanskrit": "शशास चेमां वसुधां प्रशान्तभयतस्कराम् ।\nयदुरिन्द्रप्रतीकाशो नृपो येनास्य यादवाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006380050, "chapter_id": 26380, "verse_number": "२-३७-५१", "content_sanskrit": "स कदाचिन्नृपश्चक्रे जलक्रीडां महोदधौ ।\nदारैः सह गुणोदारैः सतार इव चन्द्रमाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006380051, "chapter_id": 26380, "verse_number": "२-३७-५२", "content_sanskrit": "स तत्र सहसा क्षिप्तस्तितीर्षुः सागराम्भसि ।\nधूम्रवर्णेन नृपतिः सर्पराजेन वीर्यवान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006380052, "chapter_id": 26380, "verse_number": "२-३७-५३", "content_sanskrit": "सोऽपाकृष्यत वेगेन जले सर्पपुरं महत् ।\nमणिस्तम्भगृहद्वारं मुक्तादामविभूषितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006380053, "chapter_id": 26380, "verse_number": "२-३७-५४", "content_sanskrit": "कीर्णं शङ्खकुलैः शुभ्रै रत्नराशिविभूषितम् ।\nप्रवालाङ्कुरपत्राढ्यैः पादपैरुपशोभितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006380054, "chapter_id": 26380, "verse_number": "२-३७-५५", "content_sanskrit": "कीर्णं पन्नगनार्योघैः समुद्रोदरवासिभिः ।\nस्वर्णवर्णेन भास्वन्तं स्वस्तिकेनेन्दुवर्चसा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006380055, "chapter_id": 26380, "verse_number": "२-३७-५६", "content_sanskrit": "स तं ददर्श राजेन्द्रो विमले सागराम्भसि ।\nपन्नगेन्द्रपुरं तोये जगत्यामिव निर्मितम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006380056, "chapter_id": 26380, "verse_number": "२-३७-५७", "content_sanskrit": "स्वच्छं चैव पुरं तत्र प्रविवेश नृपो यदुः ।\nअगाधं तोयदाकारं पूर्णं सर्पवधूगणैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006380057, "chapter_id": 26380, "verse_number": "२-३७-५८", "content_sanskrit": "तस्य दत्तं मणिमयं जलजं परमासनम् ।\nस्वास्तीर्णं पद्मपत्रैश्च पद्मसूत्रोत्तरच्छदम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006380058, "chapter_id": 26380, "verse_number": "२-३७-५९", "content_sanskrit": "तमासीनं नृपं तत्र परमे पन्नगासने ।\nद्विजिह्वपतिरव्यग्रो धूम्रवर्णोऽभ्यभाषत ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006380059, "chapter_id": 26380, "verse_number": "२-३७-६०", "content_sanskrit": "पिता ते स्वर्गतिं प्राप्तः कृत्वा वंशमिमं महत् ।\nभवन्तं तेजसा युक्तमुत्पाद्य वसुधाधिपम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006380060, "chapter_id": 26380, "verse_number": "२-३७-६१", "content_sanskrit": "यादवानामयं वंशस्त्वन्नाम्ना यदुपुङ्गव ।\nपित्रा ते मङ्गलार्थाय स्थापितः पार्थिवाकरः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006380061, "chapter_id": 26380, "verse_number": "२-३७-६२", "content_sanskrit": "वंशे चास्मिंस्तव विभो देवानां तनयाव्ययाः ।\nऋषीणामुरगाणां च उत्पत्स्यन्ते नृयोनिजाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006380062, "chapter_id": 26380, "verse_number": "२-३७-६३", "content_sanskrit": "तन्ममेमाः सुताः पञ्च कुमार्यो वृत्तसम्मताः ।\nउत्पन्ना यौवनाश्वस्य भगिन्यां नृपसत्तम ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006380063, "chapter_id": 26380, "verse_number": "२-३७-६४", "content_sanskrit": "प्रतीच्छेमाः स्वधर्मेण प्राजापत्येन कर्मणा ।\nवरं च ते प्रदास्यामि वरार्हस्त्वं मतो मम ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006380064, "chapter_id": 26380, "verse_number": "२-३७-६५", "content_sanskrit": "भैमाश्च कुकुराश्चैव भोजाश्चान्धकयादवाः ।\nदाशार्हा वृष्णयश्चेति ख्यातिं यास्यन्ति सप्त ते॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006380065, "chapter_id": 26380, "verse_number": "२-३७-६६", "content_sanskrit": "स तस्मै धूम्रवर्णो वै कन्याः कन्याव्रते स्थिताः ।\nजलपूर्णेन योगेन ददाविन्द्रसमाय वै ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006380066, "chapter_id": 26380, "verse_number": "२-३७-६७", "content_sanskrit": "वरं चास्मै ददौ प्रीतः स वै पन्नगपुङ्गवः ।\nश्रावयन् कन्यकाः सर्वा यथाक्रममदीनवत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006380067, "chapter_id": 26380, "verse_number": "२-३७-६८", "content_sanskrit": "एतासु ते सुताः पञ्च सुतासु मम मानद ।\nउत्पत्स्यन्ते पितुस्तेजो मातुश्चैव समाश्रिताः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006380068, "chapter_id": 26380, "verse_number": "२-३७-६९", "content_sanskrit": "अस्मत्समयबद्धाश्च सलिलाभ्यन्तरेचराः ।\nतव वंशे भविष्यन्ति पार्थिवाः कामरूपिणः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006380069, "chapter_id": 26380, "verse_number": "२-३७-७०", "content_sanskrit": "स वरं कन्यकाश्चैव लब्ध्वा यदुवरस्तदा ।\nउदतिष्ठत् वेगेन सलिलाच्चन्द्रमा इव ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006380070, "chapter_id": 26380, "verse_number": "२-३७-७१", "content_sanskrit": "स पञ्चकन्यामध्यस्थो ददृशे तत्र पार्थिवः ।\nपञ्चतारेण संयुक्तो नक्षत्रेणेव चन्द्रमाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006380071, "chapter_id": 26380, "verse_number": "२-३७-७२", "content_sanskrit": "स तदन्तःपुरं सर्वं ददर्श नृपसत्तमः ।\nवैवाहिकेन वेषेण दिव्यस्रगनुलेपनः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006380072, "chapter_id": 26380, "verse_number": "२-३७-७३", "content_sanskrit": "समाश्वास्य च ताः सर्वाः स पत्नीः पावकोपमाः ।\nजगाम स्वपुरं राजा प्रीत्या परमया युतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]