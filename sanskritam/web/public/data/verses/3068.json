[{"id": 2096566, "chapter_id": 3068, "verse_number": "१३-१९८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nके भोज्या ब्राह्मणस्येह के भोज्याः क्षत्रियस्य ह।\nतथा वैश्यस्य के भोज्याः के शूद्रस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096567, "chapter_id": 3068, "verse_number": "१३-१९८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096568, "chapter_id": 3068, "verse_number": "१३-१९८-२", "content_sanskrit": "ब्राह्मणा ब्राह्मणस्येह भोज्या ये चैव क्षत्रियाः।\nवैश्याश्चापि तथा भोज्याः शूद्राश्च परिवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096569, "chapter_id": 3068, "verse_number": "१३-१९८-३", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्या भोज्या वै क्षत्रियस्य ह।\nवर्जनीयास्तु वै शूद्राः सर्वभक्षा विकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096570, "chapter_id": 3068, "verse_number": "१३-१९८-४", "content_sanskrit": "वैश्यास्तु भोज्या विप्राणां क्षत्रियाणां तथैव च।\nनित्याग्नयो विविक्ताश्च चातुर्मास्यरताश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096571, "chapter_id": 3068, "verse_number": "१३-१९८-५", "content_sanskrit": "शूद्राणामथ यो भुङ्क्ते स भुङ्क्ते पृथिवीमलम्।\nमलं नृणां स पिबति मलं भुङ्क्ते जनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096572, "chapter_id": 3068, "verse_number": "१३-१९८-६", "content_sanskrit": "शूद्राणां यस्तथा भुङ्क्ते स भुङ्क्ते पृथिवीमलम्।\nपृथिवीमलमश्नन्ति ये द्विजाः शूद्रभोजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096573, "chapter_id": 3068, "verse_number": "१३-१९८-७", "content_sanskrit": "शूद्रस्य कर्मनिष्ठायां विकर्मस्थोपि पच्यते।\nब्राह्मणः क्षत्रियो वैश्यो विकर्मस्थश्च पच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096574, "chapter_id": 3068, "verse_number": "१३-१९८-८", "content_sanskrit": "स्वाध्यायनिरता विप्रास्तथा स्वस्त्ययने नृणाम्।\nरक्षणे क्षत्रियं प्राहुर्वैश्यं पुष्ट्यर्थमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096575, "chapter_id": 3068, "verse_number": "१३-१९८-९", "content_sanskrit": "करोति कर्म यद्वैश्यस्तद्गत्वा ह्युपजीवति।\nकृषिगोरक्ष्यवाणिज्यमकुत्सा वैश्यकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096576, "chapter_id": 3068, "verse_number": "१३-१९८-१०", "content_sanskrit": "शूद्रकर्म तु यः कुर्यादवहाय स्वकर्म च।\nस विज्ञेयो यथा शूद्रो न च भोज्यः कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096577, "chapter_id": 3068, "verse_number": "१३-१९८-११", "content_sanskrit": "चिकित्सकः काण्डपृष्ठः पुराऽध्यक्षः पुरोहितः।\nसांवत्सरो वृथाध्यायी सर्वे ते शूद्रसंमिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096578, "chapter_id": 3068, "verse_number": "१३-१९८-१२", "content_sanskrit": "शूद्रकर्मस्वथैतेषु यो भुङ्क्ते निरपत्रपः।\nअभोज्यभोजनं भुक्त्वा भयं प्राप्नोति दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096579, "chapter_id": 3068, "verse_number": "१३-१९८-१३", "content_sanskrit": "कुलं वीर्यं च तेजश्च तिर्यग्योनित्वमेव च।\nस प्रयाति यथा श्वा वै निष्क्रियो धर्मवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096580, "chapter_id": 3068, "verse_number": "१३-१९८-१४", "content_sanskrit": "भुङ्क्ते चिकित्सकस्यान्नं तदन्नं च पुरीषवत्।\nपुंश्चल्यन्नं च मूत्रं स्यात्कारुकान्नं च शोणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096581, "chapter_id": 3068, "verse_number": "१३-१९८-१५", "content_sanskrit": "विद्योपजीविनोऽन्नं च यो भुङ्क्ते साधुसम्मतः।\nतदप्यन्नं यथा शौद्रं तत्साधुः परिवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096582, "chapter_id": 3068, "verse_number": "१३-१९८-१६", "content_sanskrit": "वचनीयस्य यो भुङ्क्ते तमाहुः शोणितं ह्रदम्।\nपिशुनं भोजनं भुङ्क्ते ब्रह्महत्यासमं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096583, "chapter_id": 3068, "verse_number": "१३-१९८-१७", "content_sanskrit": "असत्कृतमवज्ञातं न भोक्तव्यं कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096584, "chapter_id": 3068, "verse_number": "१३-१९८-१८", "content_sanskrit": "व्याधिं कुलक्षयं चैव क्षिप्रं प्राप्नोति ब्राह्मणः।\nनगरीरक्षिणो भुङ्क्ते श्वपचप्रवणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096585, "chapter_id": 3068, "verse_number": "१३-१९८-१९", "content_sanskrit": "गोघ्ने च ब्राह्मणघ्ने च सुरापे गुरुतल्पगे।\nभुक्त्वाऽन्नं जायते विप्रो रक्षसां कुलवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096586, "chapter_id": 3068, "verse_number": "१३-१९८-२०", "content_sanskrit": "न्यासापहारिणो भुक्त्वा कृतघ्ने क्लीबवर्तिनि।\nजायते शबरावासे मध्यदेशबहिष्कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096587, "chapter_id": 3068, "verse_number": "१३-१९८-२१", "content_sanskrit": "अभोज्याश्चैव भोज्याश्च मया प्रोक्ता यथाविधि।\nकिमन्यदद्य कौन्तेय मत्तस्त्वं श्रोतुमिच्छसि॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096588, "chapter_id": 3068, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टनवत्यधिकशततमोऽध्यायः॥ १९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]