[{"id": 2081362, "chapter_id": 2728, "verse_number": "१२-२३३-०x", "content_sanskrit": "`युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081363, "chapter_id": 2728, "verse_number": "१२-२३३-१", "content_sanskrit": "व्यसनेषु निमग्नस्य किं श्रेयस्तद्ब्रवीहि मे।\nभूय एव महाबाहो स्थित्यर्थं तं ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081364, "chapter_id": 2728, "verse_number": "१२-२३३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081365, "chapter_id": 2728, "verse_number": "१२-२३३-२", "content_sanskrit": "अत्रैवोदाहन्तीममितिहासं पुरातनम्।\nशतक्रतोश्च संवादं नमुचेश्च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081366, "chapter_id": 2728, "verse_number": "१२-२३३-३", "content_sanskrit": "श्रिया विहीनमासीनमक्षोभ्यमिव सागरम्।\nभवाभवज्ञं भूतानामित्युवाच पुरंदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081367, "chapter_id": 2728, "verse_number": "१२-२३३-४", "content_sanskrit": "बद्धः पाशैश्च्युतः स्थानाद्द्विपतां वशमागतः।\nश्रिया विहीनो नमुचे शोचस्याहो न शोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081368, "chapter_id": 2728, "verse_number": "१२-२३३-५x", "content_sanskrit": "नमुचिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081369, "chapter_id": 2728, "verse_number": "१२-२३३-५", "content_sanskrit": "अनवाप्यं च शोकेन शरीरं चोपशुष्यति।\nअमित्राश्च प्रहृष्यन्ति शोके नास्ति सहायता।\nतस्माच्छक्र न शोचामि सर्वं ह्येवेदमन्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081370, "chapter_id": 2728, "verse_number": "१२-२३३-६", "content_sanskrit": "संतापाद्धश्यते रूपं संतापाद्धश्यते श्रियः।\nसंतापाद्धश्यते चायुर्धर्मश्चैव सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081371, "chapter_id": 2728, "verse_number": "१२-२३३-७", "content_sanskrit": "विनीय खलु तद्दुःखमागतं वै मनस्सुखम्।\nध्यातव्यं मनसा हृद्यं कल्याणं संविजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081372, "chapter_id": 2728, "verse_number": "१२-२३३-८", "content_sanskrit": "यथायथा हि पुरुषः कल्याणे कुरुते मनः।\nतथैवास्य प्रसिध्यन्ति सर्वार्था नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081373, "chapter_id": 2728, "verse_number": "१२-२३३-९", "content_sanskrit": "एकः शास्ता न द्वितीयोऽस्ति शास्ता\nगर्भे शयानं पुरुषं शास्ति शास्ता।\nतेनानुयुक्तः प्रवणादिवोदकं\nयथा नियुक्तोऽस्मि तथा भवामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081374, "chapter_id": 2728, "verse_number": "१२-२३३-१०", "content_sanskrit": "भावाभावावजिनानन्गरीयो\nजानामि श्रेयो न तु तत्करोमि।\nआशासु हर्म्यासु हृदासु कुर्वन्\nयथा नियुक्तोऽस्मि तथा वहामि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081375, "chapter_id": 2728, "verse_number": "१२-२३३-११", "content_sanskrit": "यथायथाऽस्म प्राप्तव्यं प्राप्नोत्येव तथातथा।\nभवितव्यं यथा यच्च भवत्येव तथातथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081376, "chapter_id": 2728, "verse_number": "१२-२३३-१२", "content_sanskrit": "यत्रयत्रैव संयुक्तो धात्रा गर्भे पुनः पुनः।\nतत्रतत्रैव वसति न यत्र स्वयमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081377, "chapter_id": 2728, "verse_number": "१२-२३३-१३", "content_sanskrit": "भावो योऽयमनुप्राप्तो भवितव्यमिदं मम।\nइति यस्य सदा भावो न स शोचेत्कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081378, "chapter_id": 2728, "verse_number": "१२-२३३-१४", "content_sanskrit": "पर्यायैर्हन्यमानानामभिषङ्गो न विद्यते।\nदुःखमेतत्तु यद्द्वेष्टा कर्ताऽहमिति मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081379, "chapter_id": 2728, "verse_number": "१२-२३३-१५", "content_sanskrit": "ऋषींश्च देवांश्च महासुरांश्च\nत्रैविद्यवृद्धांश्च वने मुनींश्च।\nका नापदो नोपनमन्ति लोके\nपरावरज्ञास्तु न संभ्रमन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081380, "chapter_id": 2728, "verse_number": "१२-२३३-१६", "content_sanskrit": "न पण्डितः क्रुद्ध्यति नाभिषज्यते\nन चापि संसीदति न प्रहृष्यति।\nन चार्थकृच्छ्रव्यसनेषु शोचते\nस्थितः प्रकृत्या हिमवानिवाचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081381, "chapter_id": 2728, "verse_number": "१२-२३३-१७", "content_sanskrit": "यमर्थसिद्धिः परमा न हर्षये\nत्तथैव काले व्यसनं न मोहयेत्।\nसुखं च दुःखं च तथैव मध्यमं\nनिषेवते यः स धुरधरो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081382, "chapter_id": 2728, "verse_number": "१२-२३३-१८", "content_sanskrit": "यांयामवस्थां पुरुषोऽधिगच्छे\nत्तस्यां रमेतापरितप्यमानः।\nएवं प्रवृद्धं प्रणुदन्मनोजं\nसंतापनीलं सकलं शरीरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081383, "chapter_id": 2728, "verse_number": "१२-२३३-१९", "content_sanskrit": "न तत्सदः सत्परिषत्सभा च\nसा प्राप्य यां न कुरुते सदा भयम्।\nधर्मतत्त्वमवगाह्य बुद्धिमा\nन्योऽभ्युपैति स धुरंधरः पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081384, "chapter_id": 2728, "verse_number": "१२-२३३-२०", "content_sanskrit": "प्राज्ञस्य कर्माणि दुरन्वयानि\nन वै प्राज्ञो मुह्यति मोहकाले।\nस्थानाच्च्युतश्चेन्न मुमोह गौतम\nस्तावत्कृच्छ्रामापदं प्राप्य वृद्धः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081385, "chapter_id": 2728, "verse_number": "१२-२३३-२१", "content_sanskrit": "न मन्त्रबलवीर्येण प्रज्ञया पौरुषेण च।\n[न शीलेन न वृत्तेन तथा नैवार्थसंपदा।]\nअलभ्यं लभते मर्त्यस्तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081386, "chapter_id": 2728, "verse_number": "१२-२३३-२२", "content_sanskrit": "यदेवमभिजातस्य धातारो विदधुः पुरा।\nतदेवानुभविष्यामि किं मे मृत्युः करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081387, "chapter_id": 2728, "verse_number": "१२-२३३-२३", "content_sanskrit": "लब्धव्यान्येव लभते गन्तव्यान्येव गच्छति।\nप्राप्तव्यान्येव चाप्नोति दुःखानि च सुखानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081388, "chapter_id": 2728, "verse_number": "१२-२३३-२४", "content_sanskrit": "एतद्विदित्वा कार्त्स्न्येन यो न मुह्यति मानवः।\nकुशली सर्वदुःखेषु स वै सर्वधनी नरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081389, "chapter_id": 2728, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रयस्त्रिंशदधिकद्विशततमोऽध्यायः॥ २३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]