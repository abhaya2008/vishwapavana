[
  {
    "id": 16798001,
    "chapter_id": 6198,
    "verse_number": "3.1",
    "content_sanskrit": "अथ हैनं कौसल्यश्चाश्वलायनः पप्रच्छ भगवन्कुत एष प्राणो जायते कथमायात्यस्मिञ्छरीर आत्मानं वा प्रविभज्य कथं प्रातिष्ठते केनोत्क्रमते कथं बाह्यमभिधत्ते कथमध्यात्ममिति ॥ १ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "base_unit_id": "PR_C03_V01"
  },
  {
    "id": 16798002,
    "chapter_id": 6198,
    "verse_number": "3.2",
    "content_sanskrit": "तस्मै स होवाचातिप्रश्नान्पृच्छसि ब्रह्मिष्ठोऽसीति तस्मात्तेऽहं ब्रवीमि ॥ २ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "base_unit_id": "PR_C03_V02"
  },
  {
    "id": 16798003,
    "chapter_id": 6198,
    "verse_number": "3.3",
    "content_sanskrit": "आत्मन एष प्राणो जायते । यथैषा पुरुषे च्छायैतस्मिन्नेतदाततं मनोकृतेनायात्यस्मिञ्छरीरे ॥ ३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "base_unit_id": "PR_C03_V03"
  },
  {
    "id": 16798004,
    "chapter_id": 6198,
    "verse_number": "3.4",
    "content_sanskrit": "यथा सम्राडेवाधिकृतान्विनियुङ्क्त एतान्ग्रामानेतान्ग्रामानधितिष्ठस्वेत्येवमेवैष प्राण इतरान्प्राणान्पृथक्पृथगेव संनिधत्ते ॥ ४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "base_unit_id": "PR_C03_V04"
  },
  {
    "id": 16798005,
    "chapter_id": 6198,
    "verse_number": "3.5",
    "content_sanskrit": "पायूपस्थेऽपानं चक्षुःश्रोत्रे मुखनासिकाभ्यां प्राणः स्वयं प्रातिष्ठते मध्ये तु समानः । एष ह्येतद्धुतमन्नं समं नयति तस्मादेताः सप्तार्चिषो भवन्ति ॥ ५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "base_unit_id": "PR_C03_V05"
  },
  {
    "id": 16798006,
    "chapter_id": 6198,
    "verse_number": "3.6",
    "content_sanskrit": "हृदि ह्येष आत्मा । अत्रैतदेकशतं नाडीनां तासां शतं शतमेकैकस्या द्वासप्ततिर्द्वासप्ततिः प्रतिशाखानाडीसहस्राणि भवन्त्यासु व्यानश्चरति ॥ ६ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "base_unit_id": "PR_C03_V06"
  },
  {
    "id": 16798007,
    "chapter_id": 6198,
    "verse_number": "3.7",
    "content_sanskrit": "अथैकयोर्ध्व उदानः पुण्येन पुण्यं लोकं नयति पापेन पापमुभाभ्यामेव मनुष्यलोकम्\n॥ ७ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "base_unit_id": "PR_C03_V07"
  },
  {
    "id": 16798008,
    "chapter_id": 6198,
    "verse_number": "3.8",
    "content_sanskrit": "आदित्यो ह वै बाह्यः प्राण उदयत्येष ह्येनं चाक्षुषं प्राणमनुगृह्णानः । पृथिव्यां या देवता सैषा पुरुषस्यापानमवष्टभ्यान्तरा यदाकाशः स समानो वायुर्व्यानः ॥ ८ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "base_unit_id": "PR_C03_V08"
  },
  {
    "id": 16798009,
    "chapter_id": 6198,
    "verse_number": "3.9",
    "content_sanskrit": "तेजो ह वाव उदानस्तस्मादुपशान्ततेजाः पुनर्भवमिन्द्रियैर्मनसि सम्पद्यमानैः ॥ ९ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "base_unit_id": "PR_C03_V09"
  },
  {
    "id": 16798010,
    "chapter_id": 6198,
    "verse_number": "3.10",
    "content_sanskrit": "यच्चित्तस्तेनैष प्राणमायाति प्राणस्तेजसा युक्तः । सहात्मना यथासङ्कल्पितं लोकं नयति ॥ १० ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "base_unit_id": "PR_C03_V10"
  },
  {
    "id": 16798011,
    "chapter_id": 6198,
    "verse_number": "3.11",
    "content_sanskrit": "य एवंविद्वान्प्राणं वेद न हास्य प्रजा हीयतेऽमृतो भवति तदेष श्लोकः ॥ ११ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "base_unit_id": "PR_C03_V11"
  },
  {
    "id": 16798012,
    "chapter_id": 6198,
    "verse_number": "3.12",
    "content_sanskrit": "उत्पत्तिमायतिं स्थानं विभुत्वं चैव पञ्चधा ।\nअध्यात्मं चैव प्राणस्य विज्ञायामृतमश्नुते विज्ञायामृतमश्नुत इति ॥ १२ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "base_unit_id": "PR_C03_V12"
  }
