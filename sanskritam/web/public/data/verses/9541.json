[{"id": 5000541000, "chapter_id": 9541, "verse_number": "७-६-१", "content_sanskrit": "तैर्वध्यमाना देवाश्च ऋषयश्च तपोधनाः ।\nभयार्ताः शरणं जग्मुर्देवदेवं महेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000541001, "chapter_id": 9541, "verse_number": "७-६-२", "content_sanskrit": "जगत्सृष्ट्यन्तकर्तारमजमव्यक्तरूपिणम् ।\nआधारं सर्वलोकानामाराध्यं परमं गुरुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000541002, "chapter_id": 9541, "verse_number": "७-६-३", "content_sanskrit": "ते समेत्य तु कामारिं त्रिपुरारिं त्रिलोचनम् ।\nऊचुः प्राञ्जलयो देवा भयगद्गदभाषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000541003, "chapter_id": 9541, "verse_number": "७-६-४", "content_sanskrit": "सुकेशपुत्रैर्भगवन्पितामहवरोद्धतैः ।\nप्रजाध्यक्ष प्रजाः सर्वा बाध्यन्ते रिपुबाधनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000541004, "chapter_id": 9541, "verse_number": "७-६-५", "content_sanskrit": "शरण्यान्यशरण्यानि ह्याश्रमाणि कृतानि नः ।\nस्वर्गाच्च देवान्प्रच्याव्य स्वर्गे क्रीडन्ति देववत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000541005, "chapter_id": 9541, "verse_number": "७-६-६", "content_sanskrit": "अहं विष्णुरहं रुद्रो ब्रह्माहं देवराडहम् ।\nअहं यमश्च वरुणश्चन्द्रो ऽहं रविरप्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000541006, "chapter_id": 9541, "verse_number": "७-६-७", "content_sanskrit": "इति माली सुमाली च माल्यवांश्चैव राक्षसाः ।\nबाधन्ते समरोद्धर्षा ये च तेषां पुरःसराः ।\nतन्नो देव भयार्तानामभयं दातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000541007, "chapter_id": 9541, "verse_number": "७-६-८", "content_sanskrit": "अशिवं वपुरास्थाय जहि वै देवकण्टकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000541008, "chapter_id": 9541, "verse_number": "७-६-९", "content_sanskrit": "धन्ते समरोद्धर्षा ये च तेषां पुरःसराः ।\nइत्युक्तस्तु सुरैः सर्वैः कपर्दी नीललोहितः ।\nसुकेशं प्रति सापेक्षः प्राह देवगणान्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000541009, "chapter_id": 9541, "verse_number": "७-६-१०", "content_sanskrit": "अहं तान्न हनिष्यामि मयावध्या हि ते सुराः ।\nकिं तु मन्त्रं प्रदास्यामि यो वै तान्निहनिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000541010, "chapter_id": 9541, "verse_number": "७-६-११", "content_sanskrit": "एतमेव समुद्योगं पुरस्कृत्य महर्षयः ।\nगच्छध्वं शरणं विष्णुं हनिष्यति स तान्प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000541011, "chapter_id": 9541, "verse_number": "७-६-१२", "content_sanskrit": "ततस्तु जयशब्देन प्रतिनन्द्य महेश्वरम् ।\nविष्णोः समीपमाजग्मुर्निशाचरभयार्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000541012, "chapter_id": 9541, "verse_number": "७-६-१३", "content_sanskrit": "शङ्खचक्रधरं देवं प्रणम्य बहुमान्य च ।\nऊचुः सम्भ्रान्तवद्वाक्यं सुकेशतनयान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000541013, "chapter_id": 9541, "verse_number": "७-६-१४", "content_sanskrit": "सुकेशतनयैर्देव त्रिभिस्त्रेताग्निसन्निभैः ।\nआक्रम्य वरदानेन स्थानान्यपहृतानि नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000541014, "chapter_id": 9541, "verse_number": "७-६-१५", "content_sanskrit": "लङ्का नाम पुरी दुर्गा त्रिकूटशिखरे स्थिता ।\nतत्र स्थिताः प्रबाधन्ते सर्वान्नः क्षणदाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000541015, "chapter_id": 9541, "verse_number": "७-६-१६", "content_sanskrit": "स त्वमस्मद्धितार्थाय जहि तान्मधुसूदन ।\nशरणं त्वां वयं प्राप्ता गतिर्भव सुरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000541016, "chapter_id": 9541, "verse_number": "७-६-१७", "content_sanskrit": "चक्रकृत्तास्यकमलान्निवेदय यमाय वै ।\nभयेष्वभयदो ऽस्माकं नान्यो ऽस्ति भवता विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000541017, "chapter_id": 9541, "verse_number": "७-६-१८", "content_sanskrit": "राक्षसान्समरे दुष्टान्सानुबन्धान्मदोद्धतान् ।\nनुदं त्वं नो भयं देव नीहारमिव भास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000541018, "chapter_id": 9541, "verse_number": "७-६-१९", "content_sanskrit": "इत्येवं दैवतैरुक्तो देवदेवो जनार्दनः ।\nअभयं भयदो ऽरीणां दत्त्वा देवानुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000541019, "chapter_id": 9541, "verse_number": "७-६-२०", "content_sanskrit": "सुकेशं राक्षसं जाने ईशानवरदर्पितम् ।\nतांश्चास्य तनयाञ्जाने येषां ज्येष्ठः स माल्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000541020, "chapter_id": 9541, "verse_number": "७-६-२१", "content_sanskrit": "तानहं समतिक्रान्तमर्यादान्राक्षसाधमान् ।\nनिहनिष्यामि सङ्क्रुद्धः सुरा भवत विज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000541021, "chapter_id": 9541, "verse_number": "७-६-२२", "content_sanskrit": "इत्युक्तास्ते सुराः सर्वे विष्णुना प्रभविष्णुना ।\nयथावासं ययुर्हृष्टाः प्रशंसन्तो जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000541022, "chapter_id": 9541, "verse_number": "७-६-२३", "content_sanskrit": "विबुधानां समुद्योगं माल्यवांस्तु निशाचरः ।\nश्रुत्वा तौ भ्रातरौ वीराविदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000541023, "chapter_id": 9541, "verse_number": "७-६-२४", "content_sanskrit": "अमरा ऋषयश्चैव सङ्गम्य किल शकरम् ।\nअस्मद्वधं परीप्सन्त इदं वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000541024, "chapter_id": 9541, "verse_number": "७-६-२५", "content_sanskrit": "सुकेशतनया देव वरदानबलोद्धताः ।\nबाधन्ते ऽस्मान्समुद्दृप्ता घोररूपाः पदे पदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000541025, "chapter_id": 9541, "verse_number": "७-६-२६", "content_sanskrit": "राक्षसैरभिभूताः स्म न शक्ताः स्म प्रजापते ।\nस्वेषु सद्मसु संस्थातुं भयात्तेषां दुरात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000541026, "chapter_id": 9541, "verse_number": "७-६-२७", "content_sanskrit": "तदस्माकं हितार्थाय जहि तांश्च त्रिलोचन ।\nराक्षसान्हुङ्कृतेनैव दह प्रदहतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000541027, "chapter_id": 9541, "verse_number": "७-६-२८", "content_sanskrit": "इत्येवं त्रिदशैरुक्तो निशम्यान्धकसूदनः ।\nशिरः करं च धुन्वान इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000541028, "chapter_id": 9541, "verse_number": "७-६-२९", "content_sanskrit": "अवध्या मम ते देवाः सुकेशतनया रणे ।\nमन्त्रं तु वः प्रदास्यामि यस्तान्वै निहनिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000541029, "chapter_id": 9541, "verse_number": "७-६-३०", "content_sanskrit": "यो ऽसौ चक्रगदापाणिः पीतवासा जनार्दनः ।\nहरिर्नारायणः श्रीमान् शरणं तं प्रपद्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000541030, "chapter_id": 9541, "verse_number": "७-६-३१", "content_sanskrit": "हरादवाप्य ते मन्त्रं कामारिमभिवाद्य च ।\nनारायणालयं प्राप्य तस्मै सर्वं न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000541031, "chapter_id": 9541, "verse_number": "७-६-३२", "content_sanskrit": "ततो नारायणेनोक्ता देवा इन्द्रपुरोगमाः ।\nसुरारींस्तान्हनिष्यामि सुरा भवत विज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000541032, "chapter_id": 9541, "verse_number": "७-६-३३", "content_sanskrit": "देवानां भयभीतानां हरिणा राक्षसर्षभौ ।\nप्रतिज्ञातो वधो ऽस्माकं चिन्त्यतां यदिह क्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000541033, "chapter_id": 9541, "verse_number": "७-६-३४", "content_sanskrit": "हिरण्यकशिपोर्मृत्युरन्येषां च सुरद्विषाम् ।\nनमुचिः कालनेमिश्च संह्रादो वीरसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000541034, "chapter_id": 9541, "verse_number": "७-६-३५", "content_sanskrit": "राधेयो बहुमायी च लोकपालो ऽथ धार्मिकः ।\nयमलार्जुनौ च हार्दिक्यः शुम्भश्चैव निशुम्भकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000541035, "chapter_id": 9541, "verse_number": "७-६-३६", "content_sanskrit": "असुरा दानवाश्चैव सत्त्ववन्तो महाबलाः ।\nसर्वे समरमासाद्य न श्रूयन्ते ऽपराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000541036, "chapter_id": 9541, "verse_number": "७-६-३७", "content_sanskrit": "सर्वैः क्रतुशतैरिष्टं सर्वे मायाविदस्तथा ।\nसर्वे सर्वास्त्रकुशलाः सर्वे शत्रुभयङ्कराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000541037, "chapter_id": 9541, "verse_number": "७-६-३८", "content_sanskrit": "नारायणेन निहताः शतशो ऽथ सहस्रशः ।\nएतज्ज्ञात्वा तु सर्वेषां क्षमं कर्तुमिहार्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000541038, "chapter_id": 9541, "verse_number": "७-६-३९", "content_sanskrit": "ततः सुमाली माली च श्रुत्वा माल्यवतो वचः ।\nऊचतुर्भ्रातरं ज्येष्ठं भगांशाविव वासवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000541039, "chapter_id": 9541, "verse_number": "७-६-४०", "content_sanskrit": "स्वधीतं दत्तमिष्टं चाप्यैश्वर्यं परिपालितम् ।\nआयुर्निरामयं प्राप्तं सुधर्मः प्रापितः पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000541040, "chapter_id": 9541, "verse_number": "७-६-४१", "content_sanskrit": "देवसागरमक्षोभ्यं शस्त्रैः समवगाह्य च ।\nजिता द्विषो ह्यप्रतिमास्तन्नो मृत्युकृतं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000541041, "chapter_id": 9541, "verse_number": "७-६-४२", "content_sanskrit": "नारायणश्च रुद्रश्च शक्रश्चापि यमस्तथा ।\nअस्माकं प्रमुखे स्थातुं सर्वे बिभ्यति सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000541042, "chapter_id": 9541, "verse_number": "७-६-४३", "content_sanskrit": "विष्णोर्देवस्य नास्त्येव कारणं राक्षसेश्वर ।\nदेवानामेव दोषेण विष्णोः प्रचलितं मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000541043, "chapter_id": 9541, "verse_number": "७-६-४४", "content_sanskrit": "तस्मादद्य समुद्युक्ताः सर्वसैन्यसमावृताः ।\nदेवानेव जिघांसाम एभ्यो दोषः समुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000541044, "chapter_id": 9541, "verse_number": "७-६-४५", "content_sanskrit": "एवं सम्मन्त्र्य बलिनः सर्वे सैन्यसमावृताः ।\nउद्योगं घोषयित्वा तु सर्वे नैर्ऋतपुङ्गवाः ॥\nयुद्धाय निर्ययुः क्रुद्धा जम्भवृत्रबला इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000541045, "chapter_id": 9541, "verse_number": "७-६-४६", "content_sanskrit": "इति ते राम सम्मन्त्र्य सर्वोद्योगेन राक्षसाः ।\nयुद्धाय निर्ययुः सर्वे महाकाया महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000541046, "chapter_id": 9541, "verse_number": "७-६-४७", "content_sanskrit": "स्यन्दनैर्वारणैश्चैव हयैश्च गिरिसन्निभैः ।\nखरैर्गोभी रथोष्ट्रैश्च शिंशुमारैर्भुजङ्गमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000541047, "chapter_id": 9541, "verse_number": "७-६-४८", "content_sanskrit": "मकरैः कच्छपैर्मीनैर्विहङ्गैर्गरुडोपमैः ।\nसिंहैर्व्याघ्रैर्वराहैश्च सृमरैश्चमरैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000541048, "chapter_id": 9541, "verse_number": "७-६-४९", "content_sanskrit": "त्यक्त्वा लङ्कां गताः सर्वे राक्षसा बलगर्विताः ।\nप्रयाता देवलोकाय योद्धुं दैवतशत्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000541049, "chapter_id": 9541, "verse_number": "७-६-५०", "content_sanskrit": "लङ्काविपर्ययं दृष्ट्वा यानि लङ्कालयान्यथ ।\nभूतानि भयदर्शीनि विमनस्कानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000541050, "chapter_id": 9541, "verse_number": "७-६-५१", "content_sanskrit": "रथोत्तमैरुह्यमानाः शतशो ऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000541051, "chapter_id": 9541, "verse_number": "७-६-५२", "content_sanskrit": "प्रयाता राक्षसास्तूर्णं देवलोकं प्रयत्नतः ।\nरक्षसामेव मार्गेण दैवतान्यपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000541052, "chapter_id": 9541, "verse_number": "७-६-५३", "content_sanskrit": "भौमाश्चैवान्तरिक्षाश्च कालाज्ञप्ता भयावहाः ।\nउत्पाता राक्षसेन्द्राणामभावाय समुत्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000541053, "chapter_id": 9541, "verse_number": "७-६-५४", "content_sanskrit": "अस्थीनि मेघा ववृषुरुष्णं शोणितमेव च ।\nवेलां समुद्राश्चोत्क्रान्ताश्चेलुश्चाप्यथ भूधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000541054, "chapter_id": 9541, "verse_number": "७-६-५५", "content_sanskrit": "अट्टहासान्विमुञ्चन्तो घननादसमस्वनाः ।\nवाश्यन्त्यश्च शिवास्तत्र दारुणं घोरदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000541055, "chapter_id": 9541, "verse_number": "७-६-५६", "content_sanskrit": "सम्पतन्त्यथ भूतानि दृश्यन्ते च यथाक्रमम् ।\nगृध्रचक्रं महच्चात्र ज्वलनोद्गारिभिर्मुखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000541056, "chapter_id": 9541, "verse_number": "७-६-५७", "content_sanskrit": "राक्षसानामुपरि खे भ्रमते ऽलातचक्रवत् ।\nकपोता रक्तपादाश्च शारिका विद्रुता ययुः ॥\nकाका वाश्यन्ति तत्रैव बिडाला वै द्विपादयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000541057, "chapter_id": 9541, "verse_number": "७-६-५८", "content_sanskrit": "उत्पातांस्ताननादृत्य राक्षसा बलगर्विताः ।\nयान्त्येव न निवर्त्तन्ते मृत्युपाशावपाशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000541058, "chapter_id": 9541, "verse_number": "७-६-५९", "content_sanskrit": "माल्यवांश्च सुमाली च माली च सुमहाबलाः ।\nआसन्पुरःसरास्तेषां क्रतूनामिव पावकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000541059, "chapter_id": 9541, "verse_number": "७-६-६०", "content_sanskrit": "माल्यवन्तं च ते सर्वे माल्यवन्तमिवाचलम् ।\nनिशाचरा ह्याश्रयन्ति धातारमिव देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000541060, "chapter_id": 9541, "verse_number": "७-६-६१", "content_sanskrit": "तद्बलं राक्षसेन्द्राणां महाभ्रघननादितम् ।\nजयेप्सया देवलोकं ययौ मालिवशे स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000541061, "chapter_id": 9541, "verse_number": "७-६-६२", "content_sanskrit": "राक्षसानां समुद्योगं तं तु नारायणः प्रभुः ।\nदेवदूतादुपश्रुत्य चक्रे युद्धे तदा मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000541062, "chapter_id": 9541, "verse_number": "७-६-६३", "content_sanskrit": "स सज्जायुधतूणीरो वैनतेयोपरि स्थितः ।\nआसज्ज्य कवचं दिव्यं सहस्रार्कसमद्युति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000541063, "chapter_id": 9541, "verse_number": "७-६-६४", "content_sanskrit": "आबध्य शरसम्पूर्णे इषुधी विमले तदा ।\nश्रोणिसूत्रं च खड्गं च विमलं कमलेक्षणः ॥\nशङ्खचक्रगदाशार्ङ्गखड्गाख्यप्रवरायुधान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000541064, "chapter_id": 9541, "verse_number": "७-६-६५", "content_sanskrit": "सुपर्णं गिरिसङ्काशं वैनतेयमथास्थितः ।\nराक्षसानामभावाय ययौ तूर्णतरं प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000541065, "chapter_id": 9541, "verse_number": "७-६-६६", "content_sanskrit": "सुपर्णपृष्ठे स बभौ श्यामः पीताम्बरो हरिः ।\nकाञ्चनस्य गिरेः शृङ्गे सतडित्तोयदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000541066, "chapter_id": 9541, "verse_number": "७-६-६७", "content_sanskrit": "स सिद्धदेवर्षिमहोरगैश्च गन्धर्वयक्षैरुपगीयमानः ।\nसमाससादासुरसैन्यशत्रूंश्चक्रासिशार्ङ्गायुधशङ्खपाणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000541067, "chapter_id": 9541, "verse_number": "७-६-६८", "content_sanskrit": "सुपर्णपक्षानिलनुन्नपक्षं भ्रमत्पताकं प्रविकीर्णशस्त्रम् ।\nचचाल तद्राक्षसराजसैन्यं चलोपलं नील इवाचलेन्द्रः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000541068, "chapter_id": 9541, "verse_number": "७-६-६९", "content_sanskrit": "ततः शरैः शोणितमांसरूषितैर्युगान्तवैश्वानरतुल्यविग्रहैः ।\nनिशाचराः सम्परिवार्य माधवं वरायुधैर्निर्बिभिदुः सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000541069, "chapter_id": 9541, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे षष्ठः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]