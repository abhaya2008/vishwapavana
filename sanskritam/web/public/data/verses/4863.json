[{"id": 2182250, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182251, "chapter_id": 4863, "verse_number": "१", "content_sanskrit": "व्याख्याता क्षत्रधर्मेण वृत्तिरापत्सु भारत ।\nकथञ्चिद् वैश्यधर्मेण जीवेद् वा ब्राह्मणो न वा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182252, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182253, "chapter_id": 4863, "verse_number": "२", "content_sanskrit": "अशक्तः क्षत्रधर्मेण वैश्यधर्मेण वर्तयेत् ।\nकृषिगोरक्षमास्थाय व्यसने वृत्तिसङ्क्षये\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182254, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182255, "chapter_id": 4863, "verse_number": "३", "content_sanskrit": "कानि पण्यानि विक्रीणन् स्वर्गलोकान्न हीयते ।\nब्राह्मणो वैश्यधर्मेण वर्तयन् भरतर्षभ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182256, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182257, "chapter_id": 4863, "verse_number": "४", "content_sanskrit": "सुरा लवणमित्येव तिलान् केसरिणः पशून् ।\nवृषभान् मधु मांसं च कृतान्नं च युधिष्ठिर\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182258, "chapter_id": 4863, "verse_number": "५", "content_sanskrit": "सर्वास्ववस्थास्वेतानि ब्राह्मणः परिवर्जयेत् ।\nएतेषां विक्रयात् तात ब्राह्मणो नरकं व्रजेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182259, "chapter_id": 4863, "verse_number": "६", "content_sanskrit": "अजोऽग्निर्वरुणो मेषः सूर्योऽश्वः पृथिवी विराट् ।\nधेनुर्यज्ञश्च सोमश्च न विक्रेयाः कथञ्चन\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182260, "chapter_id": 4863, "verse_number": "७", "content_sanskrit": "पक्वेनामस्य निमयं न प्रशंसन्ति साधवः ।\nनिमयेत् पक्वमामेन भोजनार्थाय भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182261, "chapter_id": 4863, "verse_number": "८", "content_sanskrit": "वयं सिद्धमशिष्यामो भवान् साधयतामिदम् ।\nएवं समीक्ष्य निमयन् नाधर्मोऽस्ति कदाचन\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182262, "chapter_id": 4863, "verse_number": "९", "content_sanskrit": "अत्र ते वर्तयिष्यामि यथा धर्मः पुरातनः ।\nव्यवहारप्रवृत्तानां तन्निबोध युधिष्ठिर\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182263, "chapter_id": 4863, "verse_number": "१०", "content_sanskrit": "भवतेऽहं ददानीदं भवानेतत् प्रयच्छतु ।\nरुचिते वर्तते धर्मो न बलात् सम्प्रवर्तिते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182264, "chapter_id": 4863, "verse_number": "११", "content_sanskrit": "इत्येवं सम्प्रवर्तन्त व्यवहाराः पुरातनाः ।\nऋषीणामितरेषां च साधु चेदमसंशयम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182265, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182266, "chapter_id": 4863, "verse_number": "१२", "content_sanskrit": "अथ तात यदा सर्वाः शस्त्रमाददते प्रजाः ।\nव्युत्क्रामन्ति स्वधर्मेभ्यः क्षत्रस्य क्षीयते बलम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182267, "chapter_id": 4863, "verse_number": "१३", "content_sanskrit": "राजा त्राता न लोके स्यात् किं तदा स्यात् परायणम् ।\nएतन्मे संशयं ब्रूहि विस्तरेण पितामह\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182268, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182269, "chapter_id": 4863, "verse_number": "१४", "content_sanskrit": "दानेन तपसा यज्ञैरद्रोहेण दमेन च ।\nब्राह्मणप्रमुखा वर्णाः क्षेममिच्छेयुरात्मनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182270, "chapter_id": 4863, "verse_number": "१५", "content_sanskrit": "तेषां ये वेदबलिनस्त उत्थाय समन्ततः ।\nराज्ञो बलं वर्धयेयुर्महेन्द्रस्येव देवताः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182271, "chapter_id": 4863, "verse_number": "१६", "content_sanskrit": "राज्ञो हि क्षीयमाणस्य ब्रह्मैवाहुः परायणम् ।\nतस्माद् ब्रह्मबलेनैव समुत्थेयं विजानता\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182272, "chapter_id": 4863, "verse_number": "१७", "content_sanskrit": "यदा तु विजयी राजा क्षेमं राष्ट्रेऽभिसन्दधेत् ।\nतदा वर्णा यथाधर्ममाविशेयुः स्वकर्मसु\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182273, "chapter_id": 4863, "verse_number": "१८", "content_sanskrit": "उन्मर्यादे प्रवृत्ते तु दस्युभिः सङ्करे कृते ।\nसर्वे वर्णा न दुष्येयुः शस्त्रवन्तो युधिष्ठिर\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182274, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2182275, "chapter_id": 4863, "verse_number": "१९", "content_sanskrit": "अथ चेत् सर्वतः क्षत्रं प्रदुष्येद् ब्राह्मणान् प्रति ।\nकस्तस्य ब्राह्मणस्त्राता को धर्मः किं परायणम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2182276, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2182277, "chapter_id": 4863, "verse_number": "२०", "content_sanskrit": "तपसा ब्रह्मचर्येण शस्त्रेण च बलेन च ।\nअमायया मायया च नियन्तव्यं तदा भवेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2182278, "chapter_id": 4863, "verse_number": "२१", "content_sanskrit": "क्षत्रिस्यातिवृत्तस्य ब्राह्मणेषु विशेषतः ।\nब्रह्मैव सन्नियन्तृ स्यात् क्षत्रं हि ब्रह्मसम्भवम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2182279, "chapter_id": 4863, "verse_number": "२२", "content_sanskrit": "अद्भ्योऽग्निर्ब्रह्मतः क्षत्रमश्मनो लोहमुत्थितम् ।\nतेषां सर्वत्रगं तेजः स्वासु योनिषु शाम्यति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2182280, "chapter_id": 4863, "verse_number": "२३", "content_sanskrit": "यदा छिनत्त्ययोऽश्मानमग्निश्चापोऽभिपद्यते ।\nक्षत्रं च ब्राह्मणं द्वेष्टि तदा शाम्यन्ति ते त्रयः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2182281, "chapter_id": 4863, "verse_number": "२४", "content_sanskrit": "तस्माद् ब्रह्मणि शाम्यन्ति क्षत्रियाणां युधिष्ठिर ।\nसमुदीर्णान्यजेयानि तेजांसि च बलानि च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2182282, "chapter_id": 4863, "verse_number": "२५", "content_sanskrit": "ब्रह्मवीर्ये मृदूभूते क्षत्रवीर्ये च दुर्बले ।\nदुष्टेषु सर्ववर्णेषु ब्राह्मणान् प्रति सर्वशः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2182283, "chapter_id": 4863, "verse_number": "२६", "content_sanskrit": "ये तत्र युद्धं कुर्वन्ति त्यक्त्वा जीवितमात्मनः ।\nब्राह्मणान् परिरक्षन्तो धर्ममात्मानमेव च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2182284, "chapter_id": 4863, "verse_number": "२७", "content_sanskrit": "मनस्विनो मन्युमन्तः पुण्यलोका भवन्ति ते ।\nब्राह्मणार्थं हि सर्वेषां शस्त्रग्रहणमिष्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2182285, "chapter_id": 4863, "verse_number": "२८", "content_sanskrit": "अति स्विष्टस्वधीतानां लोकानति तपस्विनाम् ।\nअनाशकाग्न्योर्विशतां शूरा यान्ति परां गतिम् ।\nएवमेवात्मनस्त्यागान्नान्यं धर्मं विदुर्जनाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2182286, "chapter_id": 4863, "verse_number": "२९", "content_sanskrit": "तेभ्यो नमश्च भद्रं च ये शरीराणि जुह्वति ।\nब्रह्मद्विषो नियच्छन्तस्तेषां नोऽस्तु सलोकता ।\nब्रह्मलोकजितः स्वर्ग्यान् वीरांस्तान् मनुरब्रवीत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2182287, "chapter_id": 4863, "verse_number": "३०", "content_sanskrit": "यथाश्वमेधावभृथे स्नाताः पूता भवन्त्युत ।\nदुष्कृतः सुकृतश्चैव तथा शस्त्रहता रणे\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2182288, "chapter_id": 4863, "verse_number": "३१", "content_sanskrit": "भवत्यधर्मो धर्मो हि धर्माधर्मावुभावपि ।\nकारणाद् देशकालस्य देशकालः स तादृशः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2182289, "chapter_id": 4863, "verse_number": "३२", "content_sanskrit": "मैत्राः क्रूराणि कुर्वन्तो जयन्ति स्वर्गमुत्तमम् ।\nधर्म्याः पापानि कुर्वन्तो गच्छन्ति परमां गतिम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2182290, "chapter_id": 4863, "verse_number": "३३", "content_sanskrit": "ब्राह्मणस्त्रिषु कालेषु शस्त्रं गृह्णन्न दुष्यति ।\nआत्मत्राणे वर्णदोषे दुर्गस्य नियमेषु च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2182291, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2182292, "chapter_id": 4863, "verse_number": "३४", "content_sanskrit": "अभ्युत्थिते दस्युबले क्षत्रार्थे वर्णसङ्करे ।\nसम्प्रमूढेषु वर्णेषु यद्यन्योऽभिभवेद् बली\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2182293, "chapter_id": 4863, "verse_number": "३५", "content_sanskrit": "ब्राह्मणो यदि वा वैश्यः शूद्रो वा राजसत्तम ।\nदस्युभ्योऽथ प्रजा रक्षेद् दण्डं धर्मेण धारयन्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2182294, "chapter_id": 4863, "verse_number": "३६", "content_sanskrit": "कार्यं कुर्यान्न वा कुर्यात् संवार्यो वा भवेन्न वा ।\nतस्माच्छस्त्रं ग्रहीतव्यमन्यत्र क्षत्रबन्धुतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2182295, "chapter_id": 4863, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2182296, "chapter_id": 4863, "verse_number": "३७", "content_sanskrit": "अपारे यो भवेत् पारमप्लवे यः प्लवो भवेत् ।\nशूद्रो वा यदि वाप्यन्यः सर्वथा मानमर्हति\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2182297, "chapter_id": 4863, "verse_number": "३८", "content_sanskrit": "यमाश्रित्य नरा राजन् वर्तयेयुर्यथासुखम् ।\nअनाथाः पाल्यमाना वै दस्युभिः परिपीडिताः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2182298, "chapter_id": 4863, "verse_number": "३९", "content_sanskrit": "तमेव पूजयेरंस्ते प्रीत्या स्वमिव बान्धवम् ।\nमहद् ह्यभीक्ष्णं कौरव्य कर्ता सन्मानमर्हति\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2182299, "chapter_id": 4863, "verse_number": "४०", "content_sanskrit": "किमुक्ष्णाऽवहता कृत्यं किं धेन्वा चाप्यदुग्धया ।\nवन्ध्यया भार्यया कोऽर्थः कोऽर्थो राज्ञाप्यरक्षता\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2182300, "chapter_id": 4863, "verse_number": "४१", "content_sanskrit": "यथा दारुमयो हस्ती यथा चर्ममयो मृगः ।\nयथा ह्यनेत्रः शकटः पथि क्षेत्रं यथोषरम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2182301, "chapter_id": 4863, "verse_number": "४२", "content_sanskrit": "एवं ब्रह्मानधीयानं राजा यश्च न रक्षिता ।\nन वर्षति च यो मेघः सर्व एते निरर्थकाः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2182302, "chapter_id": 4863, "verse_number": "४३", "content_sanskrit": "नित्यं यस्तु सतो रक्षेदसतश्च निबर्हयेत् ।\nस एव राजा कर्तव्यस्तेन सर्वमिदं धृतम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2182303, "chapter_id": 4863, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे अशीतितमोऽध्यायः ॥ ८० ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]