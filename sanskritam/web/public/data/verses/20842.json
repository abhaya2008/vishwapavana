[{"id": 7000842000, "chapter_id": 20842, "verse_number": "६-१८५-१", "content_sanskrit": "देव्युवाच ।\nइतिहासोऽयमीशान श्रेयसां साधनं परम् ।\nआकर्ण्य करुणापूर्ण ममकांक्षा प्रवर्त्तते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000842001, "chapter_id": 20842, "verse_number": "६-१८५-२", "content_sanskrit": "एकादशस्य माहात्म्यमध्यायस्य कथाश्रयम् ।\nव्यावर्णय विरूपाक्ष वक्तॄणां प्रथम प्रभो ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000842002, "chapter_id": 20842, "verse_number": "६-१८५-३", "content_sanskrit": "ईश्वर उवाच ।\nआकर्णय कथां कांते गीतावर्णनसंश्रयाम् ।\nविश्वरूपाभिधानस्य माहात्म्यमपि पावनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000842003, "chapter_id": 20842, "verse_number": "६-१८५-४", "content_sanskrit": "अध्यायस्य विशालाक्षि वक्तुं तावन्न शक्यते ।\nसहस्राणि कथाः संति तत्रैका कथ्यते मया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000842004, "chapter_id": 20842, "verse_number": "६-१८५-५", "content_sanskrit": "प्रणीतायास्तटे नद्या मेघंकरमिति श्रुतम् ।\nनगरं गरिमाधार तुंगप्राकारगोपुरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000842005, "chapter_id": 20842, "verse_number": "६-१८५-६", "content_sanskrit": "विशालाश्रमशालासु स्वर्णस्तंभविभूषितम् ।\nश्रीमद्भिः सुखिभिः शांतैः सदाचारैर्जितेंद्रियैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000842006, "chapter_id": 20842, "verse_number": "६-१८५-७", "content_sanskrit": "अधिष्ठितं जवैश्चारुशृंगाटकमनोहरम् ।\nमणिस्तंभस्फुरत्स्वर्णापणचत्वरशोभितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000842007, "chapter_id": 20842, "verse_number": "६-१८५-८", "content_sanskrit": "पताकाकिंकिणीक्वाण कदंबक कलस्वरम् ।\nवेदाध्ययननिर्घोषवाचालित दिगंतरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000842008, "chapter_id": 20842, "verse_number": "६-१८५-९", "content_sanskrit": "तूर्यसंघोषणाकीर्ण विशालव्योममंडलम् ।\nपताकापल्लोद्भूतवातनिर्जितविग्रहम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000842009, "chapter_id": 20842, "verse_number": "६-१८५-१०", "content_sanskrit": "राजामार्गवरद्वारनारीमंजीरसिंजितैः ।\nवल्लकीवेणुकैर्गीतेर्भाति वाजींद्र हेषितैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000842010, "chapter_id": 20842, "verse_number": "६-१८५-११", "content_sanskrit": "प्रेक्षमाणमिवाभीक्ष्णं दिक्पालानां पुरैः समम् ।\nआस्ते जगत्पतिर्यत्र शार्ङ्गपाणिर्विराजितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000842011, "chapter_id": 20842, "verse_number": "६-१८५-१२", "content_sanskrit": "मूर्तिमत्परमं ब्रह्म जगल्लोचनजीवितम् ।\nलक्ष्मीनयनराजीव पूजिताकारगौरवः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000842012, "chapter_id": 20842, "verse_number": "६-१८५-१३", "content_sanskrit": "त्रिविक्रमवपुर्मेघश्यामलः कोमलद्युति ।\nश्रीवत्सवक्षाराजीव वनमालाविभूषितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000842013, "chapter_id": 20842, "verse_number": "६-१८५-१४", "content_sanskrit": "अनेकभूषणोपेतः सरत्न इव वारिधिः ।\nचलत्सौदामिनीदाम सांद्रमेघसमद्युतिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000842014, "chapter_id": 20842, "verse_number": "६-१८५-१५", "content_sanskrit": "तस्यास्ते मुकुटे साक्षात्शार्ङ्गपाणिः परः पुमान् ।\nतं दृष्ट्वा मुच्यते जंतुर्जन्मसंसारबंधनात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000842015, "chapter_id": 20842, "verse_number": "६-१८५-१६", "content_sanskrit": "यस्मिन्पुरे महातीर्थं विद्यते मेखलाभिधम् ।\nयत्र स्नात्वा नरैर्नित्यं प्राप्यते वैष्णवं पदम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000842016, "chapter_id": 20842, "verse_number": "६-१८५-१७", "content_sanskrit": "तत्र वीक्ष्य जगन्नाथं नरसिंहं कृपार्णवम् ।\nसप्तजन्मार्जिताद्धोरान्मुच्यते दुष्कृतान्नरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000842017, "chapter_id": 20842, "verse_number": "६-१८५-१८", "content_sanskrit": "मेखलायां गणाधीशं विलोकयति यो नरः ।\nस निस्तरति विघ्नानि दुस्तराण्यपि सर्वदा ।\nब्रह्मचर्यपरो दांतो निर्ममो निरहंकृतिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000842018, "chapter_id": 20842, "verse_number": "६-१८५-१९", "content_sanskrit": "तस्मिन्मेघंकरे कश्चिदभूद्ब्राह्मणसत्तमः ।\nसुनंद इति विख्यातो वेदशास्त्रविशारदः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000842019, "chapter_id": 20842, "verse_number": "६-१८५-२०", "content_sanskrit": "वशीकृतेंन्द्रियग्रामो वासुदेवपरायणः ।\nदेवस्य शार्ङ्गिणः पार्श्वे गीताध्यायमिमं प्रिये ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000842020, "chapter_id": 20842, "verse_number": "६-१८५-२१", "content_sanskrit": "एकादशं पठत्येष विश्वरूपप्रदर्शनम् ।\nअध्यायस्य प्रभावेन ब्रह्मज्ञानमवाप सः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000842021, "chapter_id": 20842, "verse_number": "६-१८५-२२", "content_sanskrit": "परमानंदसंदोह श्लाघ्यसंवित्समाधिना ।\nप्रत्यङ्मुखेंद्रियतयानिश्चलां स्थितिमीयुषा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000842022, "chapter_id": 20842, "verse_number": "६-१८५-२३", "content_sanskrit": "सततं स्थीयते तेन जीवन्मुक्तेन योगिना ।\nएकदा स महायोगी सिंहराशिस्थिते गुरौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000842023, "chapter_id": 20842, "verse_number": "६-१८५-२४", "content_sanskrit": "गोदावरीतीर्थयात्रां विधातुमुपचक्रमे ।\nप्रथमेऽह्नि समागत्य विरजं तीर्थमुत्तमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000842024, "chapter_id": 20842, "verse_number": "६-१८५-२५", "content_sanskrit": "नाभिमारभ्य तीर्थेषु स समभ्यर्च्य देवताम् ।\nमर्ज्जन्मज्जन्जगद्धात्रीं कमलां स व्यलोकयत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000842025, "chapter_id": 20842, "verse_number": "६-१८५-२६", "content_sanskrit": "तां संपूज्य महामायां सर्वकामफलप्रदाम् ।\nतारातीर्थे ततः स्नात्वा कपिलासंगमे ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000842026, "chapter_id": 20842, "verse_number": "६-१८५-२७", "content_sanskrit": "अष्टतीर्थमसौ चक्रे विधाय पितृतर्पणम् ।\nकुमारीशं शिवं नत्वा कपिलाद्वारमाययौ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000842027, "chapter_id": 20842, "verse_number": "६-१८५-२८", "content_sanskrit": "तत्र निर्मज्ज्य निर्धुतप्राग्जन्मांतरदुष्कृतः ।\nसंपूज्य नत्वा श्रुत्वा च देवं वै मधुसूदनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000842028, "chapter_id": 20842, "verse_number": "६-१८५-२९", "content_sanskrit": "उषित्वा तत्र तां रात्रिं प्रागात्प्रातः सह द्विजैः ।\nनरसिंहवने तत्र तीर्थे रामस्य दीर्घिका ।\nप्रह्लादपूजितः साक्षादास्ते यत्र नृकेसरी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000842029, "chapter_id": 20842, "verse_number": "६-१८५-३०", "content_sanskrit": "तं दृष्ट्वा देवदेवेशं पूजयित्वा तु भक्तितः ।\nतत्र तं दिवसं नीत्वा स ययावंबिकापुरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000842030, "chapter_id": 20842, "verse_number": "६-१८५-३१", "content_sanskrit": "अनुग्रहेण भक्तानामंबिका तत्र तिष्ठति ।\nपूरयंति मनुष्याणां वांच्छितान्यखिलान्यपि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000842031, "chapter_id": 20842, "verse_number": "६-१८५-३२", "content_sanskrit": "पूजयित्वांबिकां भक्त्या पुष्पगंधानुलेपनैः ।\nउपहारैश्च विविधैः स्तौत्रैः प्रणमनैरपि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000842032, "chapter_id": 20842, "verse_number": "६-१८५-३३", "content_sanskrit": "विप्रस्तस्मात्पुरा प्राप्तः कंठस्थानाभिधं पुरम् ।\nयत्रास्ते परमा शक्तिर्महालक्ष्मीर्महाद्युतिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000842033, "chapter_id": 20842, "verse_number": "६-१८५-३४", "content_sanskrit": "तामवेक्ष्य सुधाभानुभास्करद्युतिमंडलाम् ।\nसंसारतापविच्छेदपद्मपीयूषवाहिनीम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000842034, "chapter_id": 20842, "verse_number": "६-१८५-३५", "content_sanskrit": "योगिराजहृदंभोज राजहंसनिषेविताम् ।\nअनाहतमहानादमयीमद्वयरूपिणीम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000842035, "chapter_id": 20842, "verse_number": "६-१८५-३६", "content_sanskrit": "महालक्ष्मीं भगवतीं वांछितार्थप्रदायिनीम् ।\nआराध्य भक्तिभावेन चेतसा स मुनीश्वरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000842036, "chapter_id": 20842, "verse_number": "६-१८५-३७", "content_sanskrit": "विवाहमंडपं प्राप पुरं विप्रैः समन्वितः ।\nपुरे तत्र प्रतिगृहं वासस्थानमयाचत ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000842037, "chapter_id": 20842, "verse_number": "६-१८५-३८", "content_sanskrit": "न लेभे वसतिं स्थातुं गेहे कस्मिन्नपि द्विजः ।\nदर्शितं ग्रामपालेन विशालं वासमंदिरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000842038, "chapter_id": 20842, "verse_number": "६-१८५-३९", "content_sanskrit": "प्रविश्य वशतिं चक्रे ब्राह्मणः संगिभिः सह ।\nततः प्रभाते विमले सुनंदोऽसौ द्विजोत्तमः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000842039, "chapter_id": 20842, "verse_number": "६-१८५-४०", "content_sanskrit": "बहिरालोकयांचक्रे वासगेहान्निजं वपुः ।\nअध्वन्यानखिलान्यत्र जातान्क्वापि यदृच्छया ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000842040, "chapter_id": 20842, "verse_number": "६-१८५-४१", "content_sanskrit": "गम्यमानः समायांतं ग्रामपालो ददर्श सः ।\nतं बभाषे ग्रामपाल आयुष्मानसि सर्वशः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000842041, "chapter_id": 20842, "verse_number": "६-१८५-४२", "content_sanskrit": "भागधेयवतां पुंसां पुण्यः पुण्यवतामसि ।\nप्रभावो विद्यते वत्स कोपि लोकोत्तरस्त्वयि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000842042, "chapter_id": 20842, "verse_number": "६-१८५-४३", "content_sanskrit": "क्व प्रयाताः सहायास्ते कथं तत्सदनाद्बहिः ।\nतत्पश्य मुनिशार्दूल कथयामि तवाग्रतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000842043, "chapter_id": 20842, "verse_number": "६-१८५-४४", "content_sanskrit": "किंतु नान्यं त्वया तुल्यं पश्यामीह तपस्विनम् ।\nकिं जानासि महामंत्रं कां विद्यामवलंबसे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000842044, "chapter_id": 20842, "verse_number": "६-१८५-४५", "content_sanskrit": "कस्य देवस्य कारुण्याच्छक्तिर्लोकोत्तरा त्वयि ।\nतत्कारुण्यवशात्तिष्ठ ग्रामेऽस्मिन्ब्राह्मणोत्तम ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000842045, "chapter_id": 20842, "verse_number": "६-१८५-४६", "content_sanskrit": "शुश्रूषामखिलामेव भगवंस्ते करोम्यहम् ।\nइति संवासयामास तस्मिन्ग्रामे मुनीश्वरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000842046, "chapter_id": 20842, "verse_number": "६-१८५-४७", "content_sanskrit": "परिचर्या च तस्यासौ भक्त्या चक्रे दिवानिशम् ।\nदिवसेषु प्रयातेषु सप्ताष्टसु समेयिवान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000842047, "chapter_id": 20842, "verse_number": "६-१८५-४८", "content_sanskrit": "प्रातरागत्य तस्याग्रे रुरोद भृशदुःखितः ।\nअद्य मे भाग्यहीनस्य गुणवान्भक्तिमान्सुतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000842048, "chapter_id": 20842, "verse_number": "६-१८५-४९", "content_sanskrit": "जाज्वल्यमानदंष्ट्रेण भक्षितो निशि रक्षसा ।\nइत्येवं रक्षकेणोक्तं तं पप्रच्छ स संयमी ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000842049, "chapter_id": 20842, "verse_number": "६-१८५-५०", "content_sanskrit": "क्वास्ते स राक्षसः पुत्रो भक्षितस्ते कथं वद ।\nग्रामपाल उवाच ।\nवर्तते नगरे घोरः पुरुषादो निशाचरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000842050, "chapter_id": 20842, "verse_number": "६-१८५-५१", "content_sanskrit": "स खादति नरानेत्य नित्यं नगरगोचरान् ।\nस सर्वैर्नागरैरत्र प्रार्थितः पुरुषैः पुरा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000842051, "chapter_id": 20842, "verse_number": "६-१८५-५२", "content_sanskrit": "रक्ष राक्षस नः सर्वान्ग्रासं ते कल्पयामहे ।\nपथिका निशि निद्रंति ये च तान्भुंक्ष्व राक्षस ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000842052, "chapter_id": 20842, "verse_number": "६-१८५-५३", "content_sanskrit": "एतस्मिन्सदने पांथान्ग्रामपालप्रवेशितान् ।\nआहारं कल्पयांचक्रुरात्मीयप्राणगुप्तये ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000842053, "chapter_id": 20842, "verse_number": "६-१८५-५४", "content_sanskrit": "भवान्सुप्तोगृहेऽमुष्मिन्नधन्यैः संयुतः परैः ।\nते ग्रस्ताः किल चानेन न त्वं मुक्तोसि द्विजोत्तम ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000842054, "chapter_id": 20842, "verse_number": "६-१८५-५५", "content_sanskrit": "प्रभावं भवतो वेत्ति भवानेव द्विजोत्तम ।\nमदीय तनयस्याद्य मित्रमेकमुपागतम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000842055, "chapter_id": 20842, "verse_number": "६-१८५-५६", "content_sanskrit": "अजानता मया सोऽपि तनयस्य प्रियः सखा ।\nअन्यैः पांथजनैः सार्द्धं तस्मिन्गेहे प्रवेशितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000842056, "chapter_id": 20842, "verse_number": "६-१८५-५७", "content_sanskrit": "श्रुत्वा तत्र प्रविष्टं तं निशीथे तनयो मम ।\nतमानेतुं गतः सोऽपि भक्षितस्तेन रक्षसा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000842057, "chapter_id": 20842, "verse_number": "६-१८५-५८", "content_sanskrit": "दुःखितेन मया प्रोक्तः प्रातः स पिशिताशनः ।\nममापि पुत्रो दुष्टात्मन्भवता निशि भक्षितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000842058, "chapter_id": 20842, "verse_number": "६-१८५-५९", "content_sanskrit": "भवज्जठरनिर्मग्नः सुतोऽसौ येन जीवति ।\nअस्ति चैवमुपायस्ते ब्रूहि मे त्वं निशाचर ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000842059, "chapter_id": 20842, "verse_number": "६-१८५-६०", "content_sanskrit": "राक्षस उवाच ।\nअंतःप्रविष्टा त्वत्पुत्रमज्ञात्वाहमभक्षयम् ।\nअजानन्भक्षितः पांथैः सहितोऽसौ सुतस्तव ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000842060, "chapter_id": 20842, "verse_number": "६-१८५-६१", "content_sanskrit": "यथा जीवति मे कुक्षौ यथा भवति रक्षितः ।\nतथा विहितमप्यस्ति दैवेन परमेष्ठिना ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000842061, "chapter_id": 20842, "verse_number": "६-१८५-६२", "content_sanskrit": "गीतैकादशमध्यायं यः पठत्यनिशं द्विजः ।\nतत्प्रभावेन मे मुक्तिर्मृतानां पुनरुद्भवः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000842062, "chapter_id": 20842, "verse_number": "६-१८५-६३", "content_sanskrit": "ग्रामपाल उवाच ।\nकथमेकादशाध्यायसामर्थ्यमिदमद्भुतम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000842063, "chapter_id": 20842, "verse_number": "६-१८५-६४", "content_sanskrit": "इति पृष्टो मया विप्र स बभाषे निशाचरः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000842064, "chapter_id": 20842, "verse_number": "६-१८५-६५", "content_sanskrit": "पुरा गृध्रेण केनापि नभोमार्गेण गच्छता ।\nअस्थिखंडं स्वतुंडाग्रात्पातितं क्वापि वारिणि ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000842065, "chapter_id": 20842, "verse_number": "६-१८५-६६", "content_sanskrit": "तं जलाशयमागत्यकोऽपि ज्ञानीश्वरस्तदा ।\nमहातीर्थमिति ज्ञात्वा विदधे पितृतर्पणम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000842066, "chapter_id": 20842, "verse_number": "६-१८५-६७", "content_sanskrit": "तमूचिरे जनाः सर्वे तीर्थमेतत्कथं वद ।\nजपत्येकादशाध्यायं त्रिसन्ध्यं नियतेंद्रियः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000842067, "chapter_id": 20842, "verse_number": "६-१८५-६८", "content_sanskrit": "कृतमौनस्तु विप्रोऽसौ चौरैर्व्यापादितः पथि ।\nतस्यास्थिशकलं गृध्रवदनात्पतितं जले ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000842068, "chapter_id": 20842, "verse_number": "६-१८५-६९", "content_sanskrit": "तेन तीर्थमिदं दिव्यं जातं पातकनाशनम् ।\nततस्ते मानवाः सर्वे सस्नुस्तत्र जलाशये ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000842069, "chapter_id": 20842, "verse_number": "६-१८५-७०", "content_sanskrit": "निष्कल्मषतया चैवं प्रापुस्ते परमं पदम् ।\nएकादशस्य सामर्थ्यादध्यायस्य भविष्यति ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000842070, "chapter_id": 20842, "verse_number": "६-१८५-७१", "content_sanskrit": "ममापि मुक्तिः पांथानां पुनरुत्थानमेव च ।\nयो मया कश्चिदुद्गीर्णो ब्राह्मणोऽत्रैव तिष्ठति ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000842071, "chapter_id": 20842, "verse_number": "६-१८५-७२", "content_sanskrit": "स च एकादशाध्यायं जपति स्म निरंतरम् ।\nस तेनाध्यायमंत्रेण सप्तवाराभिमंत्रितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000842072, "chapter_id": 20842, "verse_number": "६-१८५-७३", "content_sanskrit": "विधाय वारि विप्रेंद्रः क्षिपेद्यदि ममोपरि ।\nततो मे शापनिर्मुक्तिर्भविष्यति न संशयः ।\nइति तेनास्मि संदिष्टः समायातस्त्वदंतिकम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000842073, "chapter_id": 20842, "verse_number": "६-१८५-७४", "content_sanskrit": "विप्र उवाच ।\nराक्षसः केन पापेन जातोसौ वद रक्षक ।\nयत्क्षपायां गृहे तस्मिन्नरान्खादति निद्रितान् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000842074, "chapter_id": 20842, "verse_number": "६-१८५-७५", "content_sanskrit": "ग्रामपाल उवाच ।\nअस्मिन्ग्रामे पुरा कश्चिदासीद्विप्रः कृषीवलः ।\nएकदा शालिकेदाररक्षणे व्याकुलो द्विजः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000842075, "chapter_id": 20842, "verse_number": "६-१८५-७६", "content_sanskrit": "नातिदूरे महागृध्रः पांथमेकमभक्षयत् ।\nतं विमोचयितुं दूराद्दयांचक्रेऽपि तापसः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000842076, "chapter_id": 20842, "verse_number": "६-१८५-७७", "content_sanskrit": "भुक्त्वा पांथं खगस्तावन्निरगादंबराध्वना ।\nततः स तापसः कोपात्तं बभाषे कृषीवलम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000842077, "chapter_id": 20842, "verse_number": "६-१८५-७८", "content_sanskrit": "धिक्त्वां हालिक दुर्बुद्धे कठोरमतिनिर्घृण ।\nकुक्षिभरं परत्राण विमुखं हतजीवितम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000842078, "chapter_id": 20842, "verse_number": "६-१८५-७९", "content_sanskrit": "चोरैश्च दंष्ट्रिभिः सर्प्पैररिवह्निविषांबुभिः ।\nगृध्रराक्षसभूतैश्च वेतालादिभिराहतान् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000842079, "chapter_id": 20842, "verse_number": "६-१८५-८०", "content_sanskrit": "जनानुपेक्षते शक्तः स तद्वधफलं लभेत् ।\nन मोचयति यो विप्रं प्रभुश्चोरादिभिर्धृतम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000842080, "chapter_id": 20842, "verse_number": "६-१८५-८१", "content_sanskrit": "स याति नरकं घोरं स पुनर्जायते वृकः ।\nनिहन्यमानं विपिने गृध्रव्याघ्रेण पीडितम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000842081, "chapter_id": 20842, "verse_number": "६-१८५-८२", "content_sanskrit": "मुंचमुचेति यो वक्ति स याति परमां गतिम् ।\nगवामर्थे हता व्याघ्रैर्व्याधैर्दुष्टैश्च राजभिः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000842082, "chapter_id": 20842, "verse_number": "६-१८५-८३", "content_sanskrit": "तेपि यांति पदं विष्णोर्दुष्प्राप्यं योगिनामपि ।\nअश्वमेधसहस्राणि वाजपेयशतानि च ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000842083, "chapter_id": 20842, "verse_number": "६-१८५-८४", "content_sanskrit": "शरणागतसंत्राण कलां नार्हंति षोडशीम् ।\nदीनस्योपेक्षणं कृत्वा भीतस्य च शरीरिणः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000842084, "chapter_id": 20842, "verse_number": "६-१८५-८५", "content_sanskrit": "पुण्यवानपि कालेन कुंभीपाके स पच्यते ।\nपश्यन्नपि भवान् पांथं दुष्टगृध्रेण भक्षितम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000842085, "chapter_id": 20842, "verse_number": "६-१८५-८६", "content_sanskrit": "निवारणसमर्थोपि न चक्रे यन्निवारणम् ।\nनिष्कृपोसि यतस्तस्माद्भविष्यसि निशाचरः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000842086, "chapter_id": 20842, "verse_number": "६-१८५-८७", "content_sanskrit": "इमां शापं मुने श्रुत्वा कंपमानकलेवरः ।\nप्रणम्य हालिको विप्रं बभाषे करुणं वचः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000842087, "chapter_id": 20842, "verse_number": "६-१८५-८८", "content_sanskrit": "अत्राहं क्षेत्ररक्षायां चिरं क्षिप्तेन चक्षुषा ।\nन वेद्मि निकटं गृध्र हन्यमानमिमं नरम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000842088, "chapter_id": 20842, "verse_number": "६-१८५-८९", "content_sanskrit": "तेन मेऽनुग्रहं कर्तुं कृपणस्य त्वमर्हसि ।\nविप्र उवाच ।\nयो वेत्त्येकादशाध्यायं जपत्यनुदिनं च यः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000842089, "chapter_id": 20842, "verse_number": "६-१८५-९०", "content_sanskrit": "तेनाभिमंत्रितं वारि यदा शिरसि तावके ।\nपतिष्यति तदा शापात्तव मुक्तिर्भविष्यति ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000842090, "chapter_id": 20842, "verse_number": "६-१८५-९१", "content_sanskrit": "इत्युक्त्वा तापसो यातो हालिको राक्षसोऽभवत् ।\nतदागच्छ द्विजश्रेष्ठ तेनाध्यायेन मंत्रय ।\nतीर्थोदकं स्वहस्तेन तस्य मूर्द्धनि निक्षिप ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000842091, "chapter_id": 20842, "verse_number": "६-१८५-९२", "content_sanskrit": "महादेव उवाच ।\nइति तत्प्रार्थितं तस्य श्रुत्वा च करुणाप्लुतः ।\nतथेति सहपालेन मुनी रक्षोंतिकं ययौ ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000842092, "chapter_id": 20842, "verse_number": "६-१८५-९३", "content_sanskrit": "एकादशेन तेनांबु विश्वरूपेण मंत्रितम् ।\nनिक्षिप्तं तस्य शिरसि तेन विप्रेण योगिना ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000842093, "chapter_id": 20842, "verse_number": "६-१८५-९४", "content_sanskrit": "गीताध्यायप्रभावेण शापमोक्षमवाप सः ।\nविहाय राक्षसं देहं चतुर्बाहुस्ततोऽभवत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000842094, "chapter_id": 20842, "verse_number": "६-१८५-९५", "content_sanskrit": "निगीर्णा ये जनास्तेन पांथा आसन्सहस्रशः ।\nचतुर्भुजा बभूवुस्ते शंखचक्रगदाधराः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000842095, "chapter_id": 20842, "verse_number": "६-१८५-९६", "content_sanskrit": "ते विमानान्यारुरुहुस्तावदूचे स राक्षसम् ।\nमदीयस्तनयः कस्तं दर्शयस्व निशाचर ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000842096, "chapter_id": 20842, "verse_number": "६-१८५-९७", "content_sanskrit": "इत्युक्ते ग्रामपालेन दिव्यधीराह राक्षसः ।\nएवं चतुर्भुजं विद्धि तमालश्यामलद्युतिम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000842097, "chapter_id": 20842, "verse_number": "६-१८५-९८", "content_sanskrit": "माणिक्यमुकुटं दिव्यमणिकुंडलमंडितम् ।\nहारहारिमहास्कंधं स्वर्णकेयूरभूषितम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000842098, "chapter_id": 20842, "verse_number": "६-१८५-९९", "content_sanskrit": "राजीवलोचनं स्निग्धं हस्ते कृतसरोरुहम् ।\nदिव्यं विमानमारूढं देवत्वं प्राप्तमात्मजम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000842099, "chapter_id": 20842, "verse_number": "६-१८५-१००", "content_sanskrit": "इति तस्य वचः श्रुत्वा सुतं दृष्ट्वा च तादृशम् ।\nस्वगेहं नेतुमारेभे जहास स सुतस्ततः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000842100, "chapter_id": 20842, "verse_number": "६-१८५-१०१", "content_sanskrit": "कति वाराणि जातोऽसि त्वं पुत्रो मम रक्षक ।\nपूर्वपुत्रस्त्वदीयोऽस्मि अधुना विबुधोऽस्म्यहम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000842101, "chapter_id": 20842, "verse_number": "६-१८५-१०२", "content_sanskrit": "यास्यामि वैष्णवं धाम ब्राह्मणस्य प्रसादतः ।\nनिशाचरोऽपि प्राप्तोऽयं पश्य देहं चतुर्भजम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000842102, "chapter_id": 20842, "verse_number": "६-१८५-१०३", "content_sanskrit": "एकादशस्य माहात्म्याद्याति स्वर्गं समं जनैः ।\nविप्रादस्मात्तमध्यायमधीष्व त्वं जपानिशम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000842103, "chapter_id": 20842, "verse_number": "६-१८५-१०४", "content_sanskrit": "भविष्यति न संदेहस्तवापि गतिरीदृशी ।\nतात तस्मात्सतां संगं दुर्लभं सर्वथा जनैः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000842104, "chapter_id": 20842, "verse_number": "६-१८५-१०५", "content_sanskrit": "सोप्यद्य ते समुत्पन्नो ह्यात्मनः साधयेप्सितम् ।\nकिं धनैर्भोगदानैर्वा किं यज्ञैस्तपसा नु किम् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000842105, "chapter_id": 20842, "verse_number": "६-१८५-१०६", "content_sanskrit": "किं पूर्तैर्वापरं श्रेयो विश्वरूपस्य पाठतः ।\nतद्विष्णोः परमं रूपमध्यायस्य श्रुतेन च ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000842106, "chapter_id": 20842, "verse_number": "६-१८५-१०७", "content_sanskrit": "यत्पूर्णानंदसंदोह कृष्णब्रह्मास्यनिर्गतम् ।\nकुरुक्षेत्रेऽर्जुने मित्रे तत्कैवल्यरसायनम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000842107, "chapter_id": 20842, "verse_number": "६-१८५-१०८", "content_sanskrit": "नृणां च भवभीतानामाधिव्याधिभयापहम् ।\nअनेकजन्मदुःखघ्नं नान्यत्पश्यामि तत्स्मर ।\nशिव उवाच ।\nइत्युक्त्वा सह तैः सर्वैर्ययौ विष्णोः परं पदम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000842108, "chapter_id": 20842, "verse_number": "६-१८५-१०९", "content_sanskrit": "तमध्यायं ततो विप्राद्ग्रामपालः पपाठ सः ।\nतावुभौ तस्य माहात्म्याज्जग्मतुर्वैष्णवं पदम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000842109, "chapter_id": 20842, "verse_number": "६-१८५-११०", "content_sanskrit": "इत्येकादशमाहात्म्य कथा तुभ्यं निरूपिता ।\nयस्याः श्रवणमात्रेण महापातकसंक्षयः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}]