[{"id": 2206872, "chapter_id": 5409, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206873, "chapter_id": 5409, "verse_number": "१", "content_sanskrit": "युधिष्ठिर तव प्रज्ञा न सम्यगिति मे मतिः ।\nन हि कश्चित् स्वयं मर्त्यः स्ववशः कुरुते क्रियाम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206874, "chapter_id": 5409, "verse_number": "२", "content_sanskrit": "ईश्वरेण च युक्तोऽयं साध्वसाधु च पाण्डव ।\nकरोत्यसुकरं कर्म तत्र का परिदेवना\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206875, "chapter_id": 5409, "verse_number": "३", "content_sanskrit": "आत्मानं मन्यसे पार्थ पापकर्माणमन्ततः ।\nशृणु तत्र यथा पापमपकृष्येत भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206876, "chapter_id": 5409, "verse_number": "४", "content_sanskrit": "तपोभिः क्रतुभिश्चैव दानेन च युधिष्ठिर ।\nतरन्ति नित्यं पुरुषा ये स्म पापानि कुर्वते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206877, "chapter_id": 5409, "verse_number": "५", "content_sanskrit": "यज्ञेन तपसा चैव दानेन च नराधिप ।\nपूयन्ते राजशार्दूल नरा दुष्कृतकारिणः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206878, "chapter_id": 5409, "verse_number": "६", "content_sanskrit": "असुराश्च सुराश्चैव पुण्यहेतोर्मखक्रियाम् ।\nसहसैवानुवर्तन्ते तस्माद् यज्ञः परायणम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206879, "chapter_id": 5409, "verse_number": "७", "content_sanskrit": "यज्ञैरेव महात्मानो बभूवुरधिकाः सुराः ।\nततो देवाः क्रियावन्तो दानवानभ्यधर्षयन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206880, "chapter_id": 5409, "verse_number": "८", "content_sanskrit": "राजसूयाश्वमेधौ च सर्वमेधं च भारत ।\nनरमेधं च नृपते त्वमाहर युधिष्ठिर\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206881, "chapter_id": 5409, "verse_number": "९", "content_sanskrit": "यजस्व वाजिमेधेन विधिवद् दक्षिणावता ।\nबहुकामान्नवित्तेन रामो दाशरथिर्यथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206882, "chapter_id": 5409, "verse_number": "१०", "content_sanskrit": "यथा हि भरतो राजा दौष्यन्तिः पृथिवीपतिः ।\nशाकुन्तलो महावीर्यः तव पूर्वपितामहः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206883, "chapter_id": 5409, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206884, "chapter_id": 5409, "verse_number": "११", "content_sanskrit": "असंशयं वाजिमेधः पावयेत् पृथिवीमपि ।\nअभिप्रायस्तु मे कश्चित् तं त्वं श्रोतुमिहार्हसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206885, "chapter_id": 5409, "verse_number": "१२", "content_sanskrit": "इमं ज्ञातिवधं कृत्वा सुमहान्तं द्विजोत्तम ।\nअहमाराधयिष्यामि कथं शोकपरायणः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206886, "chapter_id": 5409, "verse_number": "१३", "content_sanskrit": "दानमल्पं न शक्ष्यामि दातुं वित्तं च नास्ति मे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206887, "chapter_id": 5409, "verse_number": "१४", "content_sanskrit": "न चापलादिना दीनानुत्सहे वसु याचितुम् ।\nतथैवाद्रविणान् कृच्छ्रे वर्तमानान् नृपात्मजान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206888, "chapter_id": 5409, "verse_number": "१५", "content_sanskrit": "स्वयं विनाश्य पृथिवीं राज्यार्थे द्विजसत्तम ।\nकरमाहारयिष्यामि कथं शोकपरायणान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206889, "chapter_id": 5409, "verse_number": "१६", "content_sanskrit": "दुर्योधनापराधेन वसुधायां नराधिपाः ।\nप्रनष्टा योधयित्वाऽस्मान् अकीर्त्या मुनिसत्तम\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206890, "chapter_id": 5409, "verse_number": "१७", "content_sanskrit": "दुर्योधनेन पृथिवी क्षपिता वित्तकारणात् ।\nकोशश्चापि विशीर्णोऽयं धार्तराष्ट्रस्य दुर्मतेः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206891, "chapter_id": 5409, "verse_number": "१८", "content_sanskrit": "पृथिवी दक्षिणा चात्र वाजिमेधे महाक्रतौ ।\nविद्वद्भिः परिदृष्टोऽयं विशिष्टो विधिपर्ययः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206892, "chapter_id": 5409, "verse_number": "१९", "content_sanskrit": "न च प्रतिनिधिं कर्तुं चिकीर्षामि तपोधन ।\nअत्र मे भगवन् सम्यक् साचिव्यं कर्तुमर्हसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206893, "chapter_id": 5409, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206894, "chapter_id": 5409, "verse_number": "२०", "content_sanskrit": "एवमुक्तस्तु पार्थेन कृष्णद्वैपायनस्तदा ।\nमुहूर्तमभिसञ्चिन्त्य धर्मराजानमब्रवीत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206895, "chapter_id": 5409, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206896, "chapter_id": 5409, "verse_number": "२१", "content_sanskrit": "कोशश्चापि विशीर्णोऽयं परिपूर्णो भविष्यति ।\nविद्यते द्रविणं पार्थ गिरौ हिमवति स्थितम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2206897, "chapter_id": 5409, "verse_number": "२२", "content_sanskrit": "उत्सृष्टं ब्राह्मणैर्यज्ञे मरुत्तस्य महीपतेः ।\nतदानयस्व कौन्तेय पर्याप्तं ते भविष्यति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2206898, "chapter_id": 5409, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2206899, "chapter_id": 5409, "verse_number": "२३", "content_sanskrit": "कथं यज्ञे मरुत्तस्य द्रविणं तत् समाहितम् ।\nकस्मिंश्च काले स नृपो बभूव वदतांवर\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2206900, "chapter_id": 5409, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2206901, "chapter_id": 5409, "verse_number": "२४", "content_sanskrit": "यदि शुश्रूषसे पार्थ शृणु कारन्धमं नृपम् ।\nयस्मिन् काले महावीर्यः स राजाऽऽसीन्महाधनः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2206902, "chapter_id": 5409, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि वित्तोपायकथनं नाम तृतीयोऽध्यायः ॥३॥\nअश्वमेधपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]