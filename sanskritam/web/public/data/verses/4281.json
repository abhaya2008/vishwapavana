[{"id": 2151097, "chapter_id": 4281, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2151098, "chapter_id": 4281, "verse_number": "१", "content_sanskrit": "उत्तरेषु तु कौरव्य द्वीपेषु श्रूयते कथा ।\nयथाश्रुतं महाराज ब्रुवतस्तन्निबोध मे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2151099, "chapter_id": 4281, "verse_number": "२", "content_sanskrit": "घृततोयः समुद्रोऽत्र दधिमण्डोदकोऽपरः ।\nसुरोदः सागरश्चैव तथान्यो घर्मसागरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2151100, "chapter_id": 4281, "verse_number": "३", "content_sanskrit": "परस्परेण द्विगुणाः सर्वे द्वीपा नराधिप ।\nसर्वतश्च महाराज पर्वतैः परिवारिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2151101, "chapter_id": 4281, "verse_number": "४", "content_sanskrit": "इक्षूदश्च सुरोदश्च सर्पिःक्षीरोदधिस्तदा ।\nदधिमण्डोदधिश्चान्यः शुद्धोदधिरथो महान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2151102, "chapter_id": 4281, "verse_number": "५", "content_sanskrit": "गौरस्तु मध्यमे द्वीपे गिरिर्मानःशिलो महान् ।\nपर्वतः पश्चिमः कृष्णो नारायणनिभो नृप ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2151103, "chapter_id": 4281, "verse_number": "६", "content_sanskrit": "तत्र रत्नानि दिव्यानि स्वयं रक्षति केशवः ।\nप्रजापतिमुपासीनः प्रजानां विदधे सुखम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2151104, "chapter_id": 4281, "verse_number": "७", "content_sanskrit": "कुशद्वीपे कुशस्तम्बो मध्ये जनपदस्य ह ।\nसम्पूज्यते शाल्मलिश्च द्वीपे शाल्मलिके नृप ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2151105, "chapter_id": 4281, "verse_number": "८", "content_sanskrit": "क्रौञ्चद्वीपे महाक्रौञ्चो गिरी रत्नचयाकरः ।\nसम्पूज्यते महाराज चातुर्वर्ण्येन नित्यदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2151106, "chapter_id": 4281, "verse_number": "९", "content_sanskrit": "गोमन्दः पर्वतो राजन् सुमहान् सर्वधातुमान् ।\nयत्र नित्यं निवसति श्रीमान् कमललोचनः ।\nमोक्षिभिः संस्तुतो नित्यं प्रभुर्नारायणो हरिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2151107, "chapter_id": 4281, "verse_number": "१०", "content_sanskrit": "कुशद्वीपे तु राजेन्द्र पर्वतो विद्रुमैश्चितः ।\nसुधामा नाम दुर्धर्षो द्वितीयो हेमपर्वतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2151108, "chapter_id": 4281, "verse_number": "११", "content_sanskrit": "द्युतिमान्नाम कौरव्य तृतीयः कुमुदो गिरिः ।\nचतुर्थः पुष्पवान्नाम पञ्चमस्तु कुशेशयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2151109, "chapter_id": 4281, "verse_number": "१२", "content_sanskrit": "षष्ठो हरिगिरिर्नाम षडेते पर्वतोत्तमाः ।\nतेषामन्तरविष्कम्भो द्विगुणः प्रतिभागशः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2151110, "chapter_id": 4281, "verse_number": "१३", "content_sanskrit": "औद्भिदं प्रथमं वर्षं द्वितीयं वेणुमण्डलम् ।\nतृतीयं वै रथाकारं चतुर्थं पालनं स्मृतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2151111, "chapter_id": 4281, "verse_number": "१४", "content_sanskrit": "धृतिमत् पञ्चकं वर्षं षष्ठं वर्षं प्रभाकरम् ।\nसप्तमं कापिलं वर्षं सप्तैते वर्षपुञ्जकाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2151112, "chapter_id": 4281, "verse_number": "१५", "content_sanskrit": "एतेषु देवगन्धर्वाः प्रजाश्च जगतीश्वर ।\nविहरन्ति रमन्ते च न तेषु म्रियते जनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2151113, "chapter_id": 4281, "verse_number": "१६", "content_sanskrit": "न तेषु दस्यवः सन्ति म्लेच्छजात्योऽपि वा नृप ।\nगौरप्रायो जनः सर्वः सुकुमाराश्च पार्थिव ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2151114, "chapter_id": 4281, "verse_number": "१७", "content_sanskrit": "अवशिष्टेषु वर्षेषु वक्ष्यामि मनुजेश्वर ।\nयथाश्रुतं महाराज तदव्यग्रमनाः शृणु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2151115, "chapter_id": 4281, "verse_number": "१८", "content_sanskrit": "क्रौञ्चद्वीपे महाराज क्रौञ्चो नाम महागिरिः ।\nक्रौञ्चात् परो वामनको वामनादन्धकारकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2151116, "chapter_id": 4281, "verse_number": "१९", "content_sanskrit": "अन्धकारात् परो राजन् मैनाकः पर्वतोत्तमः ।\nमैनाकात् परतो राजन् गोविन्दो गिरिरुत्तमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2151117, "chapter_id": 4281, "verse_number": "२०", "content_sanskrit": "गोविन्दात्तु परो राजन् निबिडो नाम पर्वतः ।\nपरस्तु द्विगुणस्तेषां विष्कम्भो वंशवर्धन ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2151118, "chapter_id": 4281, "verse_number": "२१", "content_sanskrit": "देशांस्तत्र प्रवक्ष्यामि तन्मे निगदतः शृणु ।\nक्रौञ्चस्य कुशलो देशो वामनस्य मनोनुगः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2151119, "chapter_id": 4281, "verse_number": "२२", "content_sanskrit": "मनोनुगात् परश्चोष्णो देशः कुरुकुलोद्वह ।\nउष्णात् परः प्रावरकः प्रावरादन्धकारकः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2151120, "chapter_id": 4281, "verse_number": "२३", "content_sanskrit": "अन्धकारकदेशात्तु मुनिदेशः परः स्मृतः ।\nमुनिदेशात् परश्चैव प्रोच्यते दुन्दुभिस्वनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2151121, "chapter_id": 4281, "verse_number": "२४", "content_sanskrit": "सिद्धचारणसङ्कीर्णो गौरप्रायो जनाधिप ।\nएते देशा महाराज देवगन्धर्वसेविताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2151122, "chapter_id": 4281, "verse_number": "२५", "content_sanskrit": "पुष्करे पुष्करो नाम पर्वतो मणिरत्नवान् ।\nतत्र नित्यं निवसति स्वयं देवः प्रजापतिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2151123, "chapter_id": 4281, "verse_number": "२६", "content_sanskrit": "तं पर्युपासते नित्यं देवाः सर्वे महर्षिभिः ।\nवाग्भिर्मनोनुकूलाभिः पूजयन्तो जनाधिप ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2151124, "chapter_id": 4281, "verse_number": "२७", "content_sanskrit": "जम्बूद्वीपात् प्रवर्तन्ते रत्नानि विविधान्युत ।\nद्वीपेषु तेषु सर्वेषु प्रजानां कुरुनन्दन ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2151125, "chapter_id": 4281, "verse_number": "२८", "content_sanskrit": "विप्राणां ब्रह्मचर्येण सत्येन च दमेन च ।\nआरोग्यायुःप्रमाणाभ्यां द्विगुणं द्विगुणं ततः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2151126, "chapter_id": 4281, "verse_number": "२९", "content_sanskrit": "एको जनपदो राजन् द्वीपेष्वेतेषु भारत ।\nउक्ता जनपदा येषु धर्मश्चैकः प्रदृश्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2151127, "chapter_id": 4281, "verse_number": "३०", "content_sanskrit": "ईश्वरो दण्डमुद्यम्य स्वयमेव प्रजापतिः ।\nद्वीपानेतान् महाराज रक्षंस्तिष्ठति नित्यदा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2151128, "chapter_id": 4281, "verse_number": "३१", "content_sanskrit": "स राजा स शिवो राजन् स पिता स पितामहः ।\nगोपायति नरश्रेष्ठ प्रजाः सजडपण्डिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2151129, "chapter_id": 4281, "verse_number": "३२", "content_sanskrit": "भोजनं चात्र कौरव्य प्रजाः स्वयमुपस्थितम् ।\nसिद्धमेव महाराज भुञ्जते तत्र नित्यदा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2151130, "chapter_id": 4281, "verse_number": "३३", "content_sanskrit": "ततः परं समा नाम दृश्यते लोकसंस्थितिः ।\nचतुरश्रा महाराज त्रयस्त्रिंशत्तु मण्डलम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2151131, "chapter_id": 4281, "verse_number": "३४", "content_sanskrit": "तत्र तिष्ठन्ति कौरव्य चत्वारो लोकसम्मताः ।\nदिग्गजा भरतश्रेष्ठ वामनैरावतादयः ।\nसुप्रतीकस्तथा राजन् प्रभिन्नकरटामुखः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2151132, "chapter_id": 4281, "verse_number": "३५", "content_sanskrit": "तस्याहं परिमाणं तु न सङ्ख्यातुमिहोत्सहे ।\nअसङ्ख्यातः स नित्यं हि तिर्यगूर्ध्वमधस्तथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2151133, "chapter_id": 4281, "verse_number": "३६", "content_sanskrit": "तत्र वै वायवो वान्ति दिग्भ्यः सर्वाभ्य एव च ।\nअसम्बाधा महाराज तान् निगृह्णन्ति ते गजाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2151134, "chapter_id": 4281, "verse_number": "३७", "content_sanskrit": "पुष्करैः पद्मसङ्काशैर्वर्ष्मवद्भिर्महाप्रभैः ।\nते शनैः पुनरेवाशु वायून् मुञ्चन्ति नित्यशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2151135, "chapter_id": 4281, "verse_number": "३८", "content_sanskrit": "श्वसद्भिर्मुच्यमानास्तु दिग्गजैरिह मारुताः ।\nआगच्छन्ति महाराज ततस्तिष्ठन्ति वै प्रजाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2151136, "chapter_id": 4281, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2151137, "chapter_id": 4281, "verse_number": "३९", "content_sanskrit": "परो वै विस्तरोऽत्यर्थं त्वया सञ्जय कीर्तितः ।\nदर्शितं द्वीपसंस्थानमुत्तरं ब्रूहि सञ्जय ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2151138, "chapter_id": 4281, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2151139, "chapter_id": 4281, "verse_number": "४०", "content_sanskrit": "उक्ता द्वीपा महाराज ग्रहान् मे शृणु तत्त्वतः ।\nस्वर्भानुः कौरवश्रेष्ठ यावदेष प्रभावतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2151140, "chapter_id": 4281, "verse_number": "४१", "content_sanskrit": "परिमण्डलो महाराज स्वर्भानुः श्रूयते ग्रहः ।\nयोजनानि सहस्राणि विष्कम्भो द्वादशास्य वै ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2151141, "chapter_id": 4281, "verse_number": "४२", "content_sanskrit": "परिणाहे न षट्त्रिंशद् विपुलत्वेन चानघ ।\nषष्टिमाहुः सहस्राणि बुधाः पौराणिकास्तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2151142, "chapter_id": 4281, "verse_number": "४३", "content_sanskrit": "चन्द्रमास्तु सहस्राणि राजन्नेकादश स्मृतः ।\nविष्कम्भेण कुरुश्रेष्ठ त्रयस्त्रिंशत्तु मण्डलम् ।\nएकोनषष्टिविस्तारः शीतरश्मेर्महात्मनः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2151143, "chapter_id": 4281, "verse_number": "४४", "content_sanskrit": "सूर्यस्त्वष्टौ सहस्राणि द्वे चान्ये कुरुनन्दन ।\nविष्कम्भेण ततो राजन् मण्डलं त्रिंशतं समम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2151144, "chapter_id": 4281, "verse_number": "४५", "content_sanskrit": "अष्टपञ्चाशतं राजन् विपुलत्वेन चानघ ।\nश्रूयते परमोदारः पतङ्गोऽसौ विभावसुः ।\nएतत् प्रमाणमर्कस्य निर्दिष्टमिह भारत ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2151145, "chapter_id": 4281, "verse_number": "४६", "content_sanskrit": "स राहुश्छादयत्येतौ यथाकालं महत्तया ।\nचन्द्रादित्यौ महाराज सङ्क्षेपोऽयमुदाहृतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2151146, "chapter_id": 4281, "verse_number": "४७", "content_sanskrit": "इत्येतत् ते महाराज पृच्छतः शास्त्रचक्षुषा ।\nसर्वमुक्तं यथातत्त्वं तस्माच्छममवाप्नुहि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2151147, "chapter_id": 4281, "verse_number": "४८", "content_sanskrit": "यथादृष्टं मया प्रोक्तं सनिर्याणमिदं जगत् ।\nतस्मादाश्वस कौरव्य पुत्रं दुर्योधनं प्रति ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2151148, "chapter_id": 4281, "verse_number": "४९", "content_sanskrit": "श्रुत्वेदं भरतश्रेष्ठ भूमिपर्व मनोनुगम् ।\nश्रीमान् भवति राजन्यः सिद्धार्थः साधुसम्मतः ।\nआयुर्बलं च वीर्यं च तस्य तेजश्च वर्धते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2151149, "chapter_id": 4281, "verse_number": "५०", "content_sanskrit": "यः शृणोति महीपाल पर्वणीदं यतव्रतः ।\nप्रीयन्ते पितरस्तस्य तथैव च पितामहाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2151150, "chapter_id": 4281, "verse_number": "५१", "content_sanskrit": "इदं तु भारतं वर्षं यत्र वर्तामहे वयम् ।\nपूर्वं प्रवर्तते पुण्यं तत्सर्वं श्रुतवानसि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2151151, "chapter_id": 4281, "verse_number": "२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां भीष्मपर्वणि त्रयोदशोऽध्यायः ॥१३॥\n॥ भूमिपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2151152, "chapter_id": 4281, "verse_number": "", "content_sanskrit": "॥ समाप्तं भूमिपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2151153, "chapter_id": 4281, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]