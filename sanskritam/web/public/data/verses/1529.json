[{"id": 2024717, "chapter_id": 1529, "verse_number": "३-१६७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024718, "chapter_id": 1529, "verse_number": "३-१६७-१", "content_sanskrit": "[ततो रजन्यां व्युष्टायां धर्मराजं युधिष्ठिरम्।\nभ्रातृभिः सहितः सर्वैरवन्दत धनंजयः ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024719, "chapter_id": 1529, "verse_number": "३-१६७-२", "content_sanskrit": "एतस्मिन्नेव काले तु सर्ववादित्रनिःखनः।\nबभूव तुमुलः शब्दस्त्वन्तरिक्षे दिवौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024720, "chapter_id": 1529, "verse_number": "३-१६७-३", "content_sanskrit": "रथनेमिखनश्चैव घण्टाशब्दश्च भारत।\nपृथग्व्यालमृगाणां च पक्षिणां चैव सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024721, "chapter_id": 1529, "verse_number": "३-१६७-४", "content_sanskrit": "`रवोन्मुखास्ते ददृशुः प्रीयमाणाः कुरूद्वह।\nमरुद्भिरन्वितं शक्रमापतन्तं विहायसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024722, "chapter_id": 1529, "verse_number": "३-१६७-५", "content_sanskrit": "ते समन्तादनुययुर्गन्धर्वाप्सरसस्तथा।\nविमानैः सूर्यसंकाशैर्देवराजमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024723, "chapter_id": 1529, "verse_number": "३-१६७-६", "content_sanskrit": "ततः स हरिभिर्युक्तं जाम्बूनदपरिष्कृतम्।\nमेघनादिनमारुह्य श्रिया परमया ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024724, "chapter_id": 1529, "verse_number": "३-१६७-७", "content_sanskrit": "पार्थानभ्याजपामाशु देवराजः पुरंदरः।\nआगत्य च सहस्राक्षो रथादवरुरोह वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024725, "chapter_id": 1529, "verse_number": "३-१६७-८", "content_sanskrit": "तं दृष्ट्वैव महात्मानं धर्मराजो युधिष्ठिरः।\nभ्रातृभिः सहितः श्रीमान्देवराजमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024726, "chapter_id": 1529, "verse_number": "३-१६७-९", "content_sanskrit": "पूजयामास चैवाथ विधिवद्भूरिदक्षिणः।\nयथार्हममितात्मानं विधिदृष्टेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024727, "chapter_id": 1529, "verse_number": "३-१६७-१०", "content_sanskrit": "धनंजयश्च तेजस्वी प्रणिपत्य पुरंदरम्।\nभृत्यवत्प्रणतस्तस्थौ देवराजसमीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024728, "chapter_id": 1529, "verse_number": "३-१६७-११", "content_sanskrit": "आघ्राय तं महातेजाः कुन्तीपुत्रो युधिष्ठिरः।\nधनंजयभिप्रेक्ष्यविनीतं स्थितमन्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024729, "chapter_id": 1529, "verse_number": "३-१६७-१२", "content_sanskrit": "जटिलं देवराजस्य तपोयुक्तमकल्मषम्।\nहर्षेण महताऽऽविष्टः फल्गुनस्याथ दर्शनात्।\nबभूव परमप्रीतो देवराजं च पूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024730, "chapter_id": 1529, "verse_number": "३-१६७-१३", "content_sanskrit": "तं तथाऽदीनमनसं राजानं हर्,संप्लुतम्।\nउवाच वचनं धीमान्धर्मराजं पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024731, "chapter_id": 1529, "verse_number": "३-१६७-१४", "content_sanskrit": "त्वमिमां पृथिवीं राजन्प्रशासिष्यसि पाण्डव।\nस्वस्ति प्राप्नुहि कौन्तेय काम्यकं पुनराश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024732, "chapter_id": 1529, "verse_number": "३-१६७-१५", "content_sanskrit": "अस्त्राणि लब्धानि च पाण्डवेन\nसर्वाणि मत्तः प्रयतेन राजन्।\nकृतप्रियश्चास्मि धनंजयेन\nजेतुं न शक्यस्त्रिभिरेष लोकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024733, "chapter_id": 1529, "verse_number": "३-१६७-१६", "content_sanskrit": "एवमुक्त्वा सहस्राक्षः कुन्तीपुत्रं युधिष्ठिरम्।\nजगाम त्रिदिवं हृष्टः स्तूयमानो महर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024734, "chapter_id": 1529, "verse_number": "३-१६७-१७", "content_sanskrit": "धनेश्वरगृहस्थानां पाण्डवानां समागमम्।\nशक्रेण य इदं विद्वानधीयीत समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024735, "chapter_id": 1529, "verse_number": "३-१६७-१८", "content_sanskrit": "संवत्सरं ब्रह्मचारी नियतः संशितव्रतः।\nस जीवेद्धि निराबाधः सुसुखी शरदां शतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024736, "chapter_id": 1529, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि निवातकवचयुद्धपर्वणि सप्तषष्ट्यधिकशततमोऽध्यायः ॥ १६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]