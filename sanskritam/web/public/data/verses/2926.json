[{"id": 2090619, "chapter_id": 2926, "verse_number": "१३-५६-१", "content_sanskrit": "`मार्कण्डेय उवाच।\nश्रुतं बहुविधं वृत्तं कन्यकानां महामते।\nइच्छामि योषितां श्रोतुं धर्माधर्मौ परिग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090620, "chapter_id": 2926, "verse_number": "१३-५६-२x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090621, "chapter_id": 2926, "verse_number": "१३-५६-२", "content_sanskrit": "अष्टौ भार्यागमा धर्म्या नराणां दारकर्मणि।\nप्रेत्येह च हिता यास्तु सपुत्रा हव्यकव्यदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090622, "chapter_id": 2926, "verse_number": "१३-५६-३", "content_sanskrit": "साध्वी पाणिगृहीता या कौमारी पाणिवर्जिता।\nभ्रातृभार्या स्वभार्येति प्रसूयेत्पुत्रमौरसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090623, "chapter_id": 2926, "verse_number": "१३-५६-४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090624, "chapter_id": 2926, "verse_number": "१३-५६-४", "content_sanskrit": "त्रयो भार्यागमा ज्ञेया यत्र धर्मो न नश्यति।\nपञ्चान्याः पश्चिमा ब्रूहि भार्यास्तासां च ये सुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090625, "chapter_id": 2926, "verse_number": "१३-५६-५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090626, "chapter_id": 2926, "verse_number": "१३-५६-५", "content_sanskrit": "सगोत्रभार्या क्रीता च परभार्या च कारिता।\nगतागता च या भार्या आश्रमादाहृता च या॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090627, "chapter_id": 2926, "verse_number": "१३-५६-६", "content_sanskrit": "एता भार्यागमाः पञ्च पुनर्भार्या भवन्ति याः।\nएता भार्या नृणां गम्यास्तत्पुत्रा हव्यकव्यदाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090628, "chapter_id": 2926, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्पञ्चाशोऽध्यायः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]