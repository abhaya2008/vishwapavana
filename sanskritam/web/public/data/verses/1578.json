[{"id": 2026976, "chapter_id": 1578, "verse_number": "३-२१६-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026977, "chapter_id": 1578, "verse_number": "३-२१६-१", "content_sanskrit": "एवं तु सूक्ष्मे कथिते धर्मव्याधेन भारत।\nब्राह्मणः स पुन सूक्ष्मं पप्रच्छ सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026978, "chapter_id": 1578, "verse_number": "३-२१६-२", "content_sanskrit": "वृत्त्वस्य रजसश्चैव तमसश्च यथातथम्।\nवृणांस्तत्त्वेन मे ब्रूहि यथावदिह पृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026979, "chapter_id": 1578, "verse_number": "३-२१६-२x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026980, "chapter_id": 1578, "verse_number": "३-२१६-३", "content_sanskrit": "दृन्त ते कथयिष्यामि यन्मां त्वं परिपृच्छसि।\nएतान्गुणान्पृथक्त्वेन निबोध गदतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026981, "chapter_id": 1578, "verse_number": "३-२१६-४", "content_sanskrit": "मोहात्मकं तमस्तेषां रज एषां प्रवर्तकम्।\nप्रकाशबहुलत्वाच्च सत्वं ज्याय इहोच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026982, "chapter_id": 1578, "verse_number": "३-२१६-५", "content_sanskrit": "अविद्याबहुलो मूढः स्वप्नशीलो विचेतनः।\nदृर्हृपीकस्तमोध्यस्तः सक्रोधस्तामसोऽलसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026983, "chapter_id": 1578, "verse_number": "३-२१६-६", "content_sanskrit": "सुवृत्तवाक्यो मन्त्री च यो नराग्र्योऽनमूयकः।\nविवित्समानो विप्रर्षे स्तब्धो मानी स राजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026984, "chapter_id": 1578, "verse_number": "३-२१६-७", "content_sanskrit": "प्रकाशबहुलो धीरो निर्विवित्सोऽनसूयकः।\nअक्रोधनो नरो धीमान्दान्तश्चैवस सात्विकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026985, "chapter_id": 1578, "verse_number": "३-२१६-८", "content_sanskrit": "सात्विकस्त्वथ संबुद्धो लोकवृत्तैर्न लिप्यते।\nयदा बुध्यति बोध्धव्यं लोकवृत्तं जुगुप्सते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026986, "chapter_id": 1578, "verse_number": "३-२१६-९", "content_sanskrit": "वैराग्यस् च रूपं तु पूर्वमेव प्रवर्तते।\nमृदुर्भवत्यहंकारः प्रसीदत्यार्जवं च यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026987, "chapter_id": 1578, "verse_number": "३-२१६-१०", "content_sanskrit": "ततोऽस् सर्वद्वन्द्वानि प्रशाम्यन्ति परस्परम्।\nन चास्यासंयमो नाम क्वचिद्भवति कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026988, "chapter_id": 1578, "verse_number": "३-२१६-११", "content_sanskrit": "शूद्रयोनौ हि जातस्य सद्गुणानुपतिष्ठतः।\nवैश्यत्वं भवति ब्रह्मन्क्षत्रियत्वं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026989, "chapter_id": 1578, "verse_number": "३-२१६-१२", "content_sanskrit": "आर्जवे वर्तमानस्य ब्राह्मण्यमभिजायते।\nगुणास्ते कीर्तिताः सर्वे किं भूयः श्रोतुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026990, "chapter_id": 1578, "verse_number": "३-२१६-१३x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026991, "chapter_id": 1578, "verse_number": "३-२१६-१३", "content_sanskrit": "पार्थिवं धातुमासाद्य शारीरोऽग्निः कथं भवेत्।\nअवकाशविशेषेण कथं वर्तयतेऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026992, "chapter_id": 1578, "verse_number": "३-२१६-१४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026993, "chapter_id": 1578, "verse_number": "३-२१६-१४", "content_sanskrit": "प्रश्नमेतं समुद्दिष्टं ब्राह्मणेन युधिष्ठिर।\nव्याधस्तु कथयामास ब्राह्मणाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026994, "chapter_id": 1578, "verse_number": "३-२१६-१५", "content_sanskrit": "मूर्धानमाश्रितो वह्निः शरीरं परिपालयन्।\nप्राणो मूर्धनि चाग्नौ च वर्तमानो विचेष्टते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026995, "chapter_id": 1578, "verse_number": "३-२१६-१६", "content_sanskrit": "भूं भव्यं भविष्यं च सर्वं प्राणे प्रतिष्ठितम्।\nश्रेष्ठं तदेव भूतानां ब्रह्मज्योतिरुपास्महे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026996, "chapter_id": 1578, "verse_number": "३-२१६-१७", "content_sanskrit": "स जन्तुः सर्वभूतात्मा पुरुषः स सनातनः।\nमनोबुद्धिरहंकारो भूतानां विषयश्च सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026997, "chapter_id": 1578, "verse_number": "३-२१६-१८", "content_sanskrit": "`अव्यक्तं सस्वसंज्ञं च जीवः कालः स चैव हि।\nप्रकृतिः पुरुषश्चैव प्राण एव द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026998, "chapter_id": 1578, "verse_number": "३-२१६-१९", "content_sanskrit": "जागर्ति स्वप्नकाले च स्वप्ने स्वप्नायते च सः।\nजाग्रत्सु बलमाधत्ते चेष्टत्सु चेष्टयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026999, "chapter_id": 1578, "verse_number": "३-२१६-२०", "content_sanskrit": "तस्मिन्निरुद्दे विप्रेन्द्र मृत इत्यभिधीयते।\nत्यक्त्वा शरीरं भूतात्मा पुनरन्यत्प्रपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027000, "chapter_id": 1578, "verse_number": "३-२१६-२१", "content_sanskrit": "एष त्वग्निरपानन प्राणेन परिपाल्यते।\nपृष्ठतस्तु समानन स्वांस्वां गतिमुपाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027001, "chapter_id": 1578, "verse_number": "३-२१६-२२", "content_sanskrit": "वस्तुमूले गुदे चैव पावकं समुपाश्रितः।\nवहन्मूत्रं पुरीषंवाऽप्यपानः परिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027002, "chapter_id": 1578, "verse_number": "३-२१६-२३", "content_sanskrit": "प्रयत्ने कर्मणि बले य एकस्त्रिषु वर्तते।\nउदान इति तं प्राहुरध्यात्मविदुषो जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027003, "chapter_id": 1578, "verse_number": "३-२१६-२४", "content_sanskrit": "सन्धौसन्धौ संनिविष्टः सर्वेष्वपि तथाऽनिलः।\nशरीरेषु मनुष्याणां व्यान इत्युपदिश्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027004, "chapter_id": 1578, "verse_number": "३-२१६-२५", "content_sanskrit": "धातुष्वग्निस्तु विततः स तु वायुसमीरितः।\nरसान्धातूंश्च दोषांश्च वर्तयन्परिधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027005, "chapter_id": 1578, "verse_number": "३-२१६-२६", "content_sanskrit": "प्राणानां संनिपातात्तु सन्निपातः प्रजायते।\nसोष्मा सोग्निरितिज्ञेयो योऽन्नं पचतिदेहिनां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027006, "chapter_id": 1578, "verse_number": "३-२१६-२७", "content_sanskrit": "अपानोदानयोर्मध्ये प्राणन्यानौ समाहितौ।\nसमन्वितस्त्वधिष्ठानं सम्यक्पचति पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027007, "chapter_id": 1578, "verse_number": "३-२१६-२८", "content_sanskrit": "अस्यापि पायुपर्यन्तस्तथा स्याद्गुदसंज्ञितः।\nस्रोतांशि तस्माज्जायन्ते सर्वप्राणेषु देहिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027008, "chapter_id": 1578, "verse_number": "३-२१६-२९", "content_sanskrit": "अग्निवेगवहः प्राणो गुदान्ते प्रतिहन्यते।\nस ऊर्ध्वमागम्य पुनः समुत्क्षिपति पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027009, "chapter_id": 1578, "verse_number": "३-२१६-३०", "content_sanskrit": "पक्वाशयस्त्वधोनाभ्या ऊर्ध्वमामाशयः स्थितः।\nनाभिमध्ये शरीरस्य प्राणाः सर्वे प्रतिष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027010, "chapter_id": 1578, "verse_number": "३-२१६-३१", "content_sanskrit": "प्रवृत्ता हृदयात्सर्वे तिर्यगूर्ध्वमधस्तथा।\nवहन्त्यन्नरसान्नाड्यो दशप्राणप्रचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027011, "chapter_id": 1578, "verse_number": "३-२१६-३२", "content_sanskrit": "योगिनामेष मार्गस्तु येन गच्छन्ति तत्परम्।\nजितक्लमासनो धीरो मूर्धन्यात्मानमादत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027012, "chapter_id": 1578, "verse_number": "३-२१६-३३", "content_sanskrit": "एवं सर्वेषु विततौ प्राणापानौ हि देहिषु।\n`तौ तावदग्निसहितौ विद्धि वै प्राणमात्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027013, "chapter_id": 1578, "verse_number": "३-२१६-३४", "content_sanskrit": "एकादशविकारात्मा कलासंभारसंभृतः।\nमूर्तिमन्तं हि तं विद्धि नित्यं कर्माजेतात्मकम्।\nतस्मिन्यः संस्थितो ह्यग्निर्नित्यं स्थाल्यामिवाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027014, "chapter_id": 1578, "verse_number": "३-२१६-३५", "content_sanskrit": "आत्मानं तं विजानीहि नित्यं त्यागजितात्मकं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2027015, "chapter_id": 1578, "verse_number": "३-२१६-३६", "content_sanskrit": "देवो यः संस्थितस्तस्मिन्नब्बिन्दुरिव पुष्करे।\nक्षेत्रज्ञं तं विजानीहि नित्यं त्यागजितात्मकं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2027016, "chapter_id": 1578, "verse_number": "३-२१६-३७", "content_sanskrit": "जीवात्मकं विजानीहि रजः सत्वं तमस्तथा।\nजीवमात्मगुणं विद्धि तथाऽऽत्मानं परात्मकं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2027017, "chapter_id": 1578, "verse_number": "३-२१६-३८", "content_sanskrit": "अचेतनं जीवगुणं वदन्ति\nसचेष्टते चेष्टयते च सर्वम्।\nततः परं क्षेत्रविदो वदन्ति\nप्राकल्पयद्यो भुवनानि सप्त ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2027018, "chapter_id": 1578, "verse_number": "३-२१६-३९", "content_sanskrit": "एष सर्वेषु भूतेषु भूतात्मा न प्रकाशते।\nदृश्यते त्वग्र्यया बुद्ध्या सूक्ष्मया ज्ञानवेदिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2027019, "chapter_id": 1578, "verse_number": "३-२१६-४०", "content_sanskrit": "चित्तस्य हि प्रसादेन हनति कर्म शुभाशुभम्।\nप्रसन्नात्मात्मनि स्थित्वा सुखमनन्त्यमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2027020, "chapter_id": 1578, "verse_number": "३-२१६-४१", "content_sanskrit": "लक्षणं तु प्रसादस्य यथा तृप्तः सुखं स्वपेत्।\n`सुखदुःखे हि संत्यज्य निर्द्वन्द्वो निष्परिग्रहः।\nनिवाते वा यथा दीपो दीप्येत्कुशलदीपितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2027021, "chapter_id": 1578, "verse_number": "३-२१६-४२", "content_sanskrit": "पूर्वरात्रेऽपरे चैव युञ्जानः सततं मनः।\nलध्वाहारो विशुद्धात्मा पश्यत्यात्मानमात्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2027022, "chapter_id": 1578, "verse_number": "३-२१६-४३", "content_sanskrit": "प्रदीप्तेनेव दीपेन मनोदीपेन पश्यति।\nदृष्ट्वाऽऽत्मानं निरात्मानं स तदा विप्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2027023, "chapter_id": 1578, "verse_number": "३-२१६-४४", "content_sanskrit": "सर्वोपायैस्तु लोभस् क्रोधस्य च विनिग्रहः।\nएतत्पवित्रं यञ्ज्ञानं तपो वै संक्रमो मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2027024, "chapter_id": 1578, "verse_number": "३-२१६-४५", "content_sanskrit": "नित्यं क्रोधात्तपो रक्षेन्छ्रियं रक्षेच्च मत्सरात्।\nविद्यां मानापमानाभ्यामात्मानं तु प्रमादतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2027025, "chapter_id": 1578, "verse_number": "३-२१६-४६", "content_sanskrit": "आनृशंस्यं परो धर्मः क्षमा च परमं बलम्।\nआत्मज्ञानं परं ज्ञानं परं सत्यव्रतव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2027026, "chapter_id": 1578, "verse_number": "३-२१६-४७", "content_sanskrit": "सत्यस् वचनं श्रेयः सत्यं ज्ञानं हितं भवेत्।\nयद्बूतहितमत्यन्तं तद्वै सत्यं परं मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2027027, "chapter_id": 1578, "verse_number": "३-२१६-४८", "content_sanskrit": "यस् सर्वे समारम्भा निराशीर्बन्धनाः सदा।\nत्यागे यस् हुतं सर्वं स त्यागी स च बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2027028, "chapter_id": 1578, "verse_number": "३-२१६-४९", "content_sanskrit": "यदा न गुरुतां चैनं च्यावयेदुपपादयन्।\nतं विद्याद्ब्राह्मणो योगमयोगं योगसंज्ञितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2027029, "chapter_id": 1578, "verse_number": "३-२१६-५०", "content_sanskrit": "न हिंस्यात्सर्वभूतानि मैत्रायणगतश्चरेत्।\nनेदं जीवितमासाद्यवैरं कुर्वीत केनचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2027030, "chapter_id": 1578, "verse_number": "३-२१६-५१", "content_sanskrit": "आकिंचन्यं सुसंतोषो निराशित्वमचापलम्।\nएतदेव परं ज्ञानं सदात्मज्ञानमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2027031, "chapter_id": 1578, "verse_number": "३-२१६-५२", "content_sanskrit": "परिग्रहं परित्यज्य भवेद्बुद्ध्या यतव्रतः।\nअशोकं स्थानमाश्रित् निश्चलं प्रेत्य चेह च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2027032, "chapter_id": 1578, "verse_number": "३-२१६-५३", "content_sanskrit": "तपोनित्येन दान्तेन मुनिना संयतात्मना।\nअजितं जेतुकामेन भाव्यं सङ्गेष्वसङ्गिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2027033, "chapter_id": 1578, "verse_number": "३-२१६-५४", "content_sanskrit": "गुणागुणमनासङ्गमेककार्यमनन्तरम्।\nएतत्तद्ब्रह्मणो वृत्तमाहुरेकपदं सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2027034, "chapter_id": 1578, "verse_number": "३-२१६-५५", "content_sanskrit": "परित्यजति यो दुःखं सुखं चाप्युभयं नरः।\nब्रह्म प्राप्नोति सोत्यन्तमासङ्गं च न गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2027035, "chapter_id": 1578, "verse_number": "३-२१६-५६", "content_sanskrit": "यथाश्रुतमिदं सर्वं समासेन द्विजोत्तम।\nएतत्ते सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2027036, "chapter_id": 1578, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि षोडशाधिकद्विशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]