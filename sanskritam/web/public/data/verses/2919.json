[{"id": 2090232, "chapter_id": 2919, "verse_number": "१३-४९-१", "content_sanskrit": "वैशम्पायन उवाच।\nमहायोगी तु तं प्राह कृष्णद्वैपायनो मुनिः।\nपठस्व पुत्र भद्रं ते प्रीयतां ते महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090233, "chapter_id": 2919, "verse_number": "१३-४९-२", "content_sanskrit": "पुरा पुत्र मया मेरौ तप्यता परमं तपः।\nपुत्रहेतोर्महाराज स्तव एषोऽनुकीर्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090234, "chapter_id": 2919, "verse_number": "१३-४९-३", "content_sanskrit": "लब्धवानीप्सितं काममहं वै पाण्डुनन्दन।\nतथा त्वमपि शर्वाद्धि सर्वान्कामानवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090235, "chapter_id": 2919, "verse_number": "१३-४९-४", "content_sanskrit": "कपिलश्च ततः प्राह साङ्ख्यर्षिर्देवसम्मतः।\nमया जन्मान्यनेकानि भक्त्या चाराधितो भवः।\nप्रीतश्च भगवाञ्ज्ञानं ददौ मम भवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090236, "chapter_id": 2919, "verse_number": "१३-४९-५", "content_sanskrit": "चारुशीर्षस्ततः प्राह शक्रस्य दयितः सखा।\nआलम्बायन इत्येवं विश्रुतः करुणात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090237, "chapter_id": 2919, "verse_number": "१३-४९-६", "content_sanskrit": "मया गोकर्णमासाद्य तपस्तप्त्वा शतं समाः।\nअयोनिजानां दान्तानां धर्मज्ञानां सुवर्चसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090238, "chapter_id": 2919, "verse_number": "१३-४९-७", "content_sanskrit": "अजराणामदुःखानां शतवर्षसहस्रिणाम्।\nलब्धं पुत्र शतं शर्वात्पुरा पाण्डुनृपात्मज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090239, "chapter_id": 2919, "verse_number": "१३-४९-८", "content_sanskrit": "वाल्मीकिश्चाह भगवान्युधिष्ठिरमिदं वचः।\nविवादे साग्निमुनिभिर्ब्रह्मघ्नो वै भवानिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090240, "chapter_id": 2919, "verse_number": "१३-४९-९", "content_sanskrit": "उक्तः क्षणेन चाविष्टस्तेनाधर्मेण भारत।\nसोऽहमीशानमनघममोघं शरणं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090241, "chapter_id": 2919, "verse_number": "१३-४९-१०", "content_sanskrit": "मुक्तश्चास्मि ततः पापैस्ततो दुःखविनाशनः।\nआह मां त्रिपुरघ्नो वै यशस्तेऽग्र्यं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090242, "chapter_id": 2919, "verse_number": "१३-४९-११", "content_sanskrit": "जामदग्न्यश्च कौन्तेयमिदं धर्मभृतांवरः।\nऋषिमध्ये स्थितः प्राह ज्वलन्निव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090243, "chapter_id": 2919, "verse_number": "१३-४९-१२", "content_sanskrit": "पितृविप्रवधेनाहमार्तो वै पाण्डवाग्रज।\nशुचिर्भूत्वा महादेवं गतोस्मि शरणं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090244, "chapter_id": 2919, "verse_number": "१३-४९-१३", "content_sanskrit": "नामभिश्चास्तुवं देवं ततस्तुष्टोऽभवद्भवः।\nपरशुं च ततो देवो दिव्यान्यस्त्राणि चैव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090245, "chapter_id": 2919, "verse_number": "१३-४९-१४", "content_sanskrit": "पापं च ते न भविता अजेयश्च भविष्यसि।\nन ते प्रभविता मृत्युरजरश्च भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090246, "chapter_id": 2919, "verse_number": "१३-४९-१५", "content_sanskrit": "आह मां भगवानेवं शिखण्डी शिवविग्रहः।\nतदवाप्तं च मे सर्वं प्रसादात्तस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090247, "chapter_id": 2919, "verse_number": "१३-४९-१६", "content_sanskrit": "विश्वामित्रस्तदोवाच क्षत्रियोऽहं तदाऽभवम्।\nब्राह्मणोऽहं भवानीति मया चाराधितो भवः।\nतत्प्रसादान्मया प्राप्तं ब्राह्मण्यं दुर्लभं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090248, "chapter_id": 2919, "verse_number": "१३-४९-१७", "content_sanskrit": "असितो देवलश्चैव प्राह पाण्डुसुतं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090249, "chapter_id": 2919, "verse_number": "१३-४९-१८", "content_sanskrit": "शापाच्छक्रस्य कौन्तेय विभो धर्मोऽनशत्तदा।\nतन्मे धर्मं यशश्चाग्र्यमायुश्चैवाददत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090250, "chapter_id": 2919, "verse_number": "१३-४९-१९", "content_sanskrit": "ऋषिर्गृत्समदो नाम शक्रस्य दयितः सखा।\nप्राहाजमीढं भगवान्बृहस्पतिसमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090251, "chapter_id": 2919, "verse_number": "१३-४९-२०", "content_sanskrit": "वरिष्ठो नाम भगवांश्चाक्षुषस्य मनोः सुतः।\nशतक्रतोरचिन्त्यस्य सत्रे वर्षसहस्रिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090252, "chapter_id": 2919, "verse_number": "१३-४९-२१", "content_sanskrit": "वर्तमानेऽब्रवीद्वाक्यं साम्नि ह्युच्चारिते मया।\nरथन्तरे द्विजश्रेष्ठ न सम्यगिति वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090253, "chapter_id": 2919, "verse_number": "१३-४९-२२", "content_sanskrit": "समीक्षस्व पुनर्बुद्ध्या पापं त्यक्त्वा द्विजोत्तम।\nअयज्ञवाहिनं पापमकार्षीस्त्वं सुदुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090254, "chapter_id": 2919, "verse_number": "१३-४९-२३", "content_sanskrit": "एवमुक्त्वा महाक्रोधः प्राह शम्भुं पुनर्वचः।\nप्रज्ञया रहितो दुःखी नित्यभीतो वनेचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090255, "chapter_id": 2919, "verse_number": "१३-४९-२४", "content_sanskrit": "दशवर्षसहस्राणि दशाष्टौ च शतानि च।\nनष्टपानीयपवने मृगैरन्यैश्च वर्जिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090256, "chapter_id": 2919, "verse_number": "१३-४९-२५", "content_sanskrit": "अयज्ञीयद्रुमे देशे रुरुसिंहनिषेविते।\nभविता त्वं मृगः क्रूरो महादुःखसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090257, "chapter_id": 2919, "verse_number": "१३-४९-२६", "content_sanskrit": "तस्य वाक्यस्य निधने पार्थ जातो ह्यहं मृगः।\nततो मां शरणं प्राप्तं प्राह योगी महेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090258, "chapter_id": 2919, "verse_number": "१३-४९-२७", "content_sanskrit": "अजरश्चामरश्चैव भविता दुखवर्जितः।\nसाम्यं ममास्तु ते सौख्यं युवयोर्वर्धतां क्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090259, "chapter_id": 2919, "verse_number": "१३-४९-२८", "content_sanskrit": "अनुग्रहानेवमेष करोति भगवान्विभुः।\nअयं धाता विधाता च सुखदुःखे च सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090260, "chapter_id": 2919, "verse_number": "१३-४९-२९", "content_sanskrit": "अचिन्त्य एष भगवान्कर्मणा मनसा गिरा।\nन मे तात युधिश्रेष्ठ विद्यया पण्डितः समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090261, "chapter_id": 2919, "verse_number": "१३-४९-३०", "content_sanskrit": "वासुदेवस्तदोवाच पुनर्मतिमतांवरः।\nसुवर्णाक्षो महादेवस्तपसा तोषितो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090262, "chapter_id": 2919, "verse_number": "१३-४९-३१", "content_sanskrit": "ततोऽथ भगवानाह प्रीतो मा वै युधिष्ठिर।\nअर्थात्प्रियतरः कृष्ण मत्प्रसादाद्भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090263, "chapter_id": 2919, "verse_number": "१३-४९-३२", "content_sanskrit": "अपराजितश्च युद्धेषु तेजश्चैवानलोपमम्।\nएवं सहस्रशश्चान्यान्महादेवो वरं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090264, "chapter_id": 2919, "verse_number": "१३-४९-३३", "content_sanskrit": "मणिमन्थेऽथ शैले वै पुरा सम्पूजितो मया।\nवर्षायुतासहस्राणां सहस्रं शतमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090265, "chapter_id": 2919, "verse_number": "१३-४९-३४", "content_sanskrit": "ततो मां भगवान्प्रीत इदं वचनमब्रवीत्।\nवरं वृणीष्व भद्रं ते यस्ते मनसि वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090266, "chapter_id": 2919, "verse_number": "१३-४९-३५", "content_sanskrit": "ततः प्रणम्य शिरसा इदं वचनमब्रवम्।\nयदि प्रीतो महादेवो भक्त्या परमया प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090267, "chapter_id": 2919, "verse_number": "१३-४९-३६", "content_sanskrit": "नित्यकालं तवेशान भक्तिर्भवतु मे स्थिरा।\nएवमस्त्विति भगवांस्तत्रोक्त्वान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2090268, "chapter_id": 2919, "verse_number": "१३-४९-३७x", "content_sanskrit": "जैगीषव्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2090269, "chapter_id": 2919, "verse_number": "१३-४९-३७", "content_sanskrit": "ममाष्टगुणमैश्वर्यं दत्तं भगवता पुरा।\nयत्नेनान्येन बलिना वाराणस्यां युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2090270, "chapter_id": 2919, "verse_number": "१३-४९-३८x", "content_sanskrit": "गर्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2090271, "chapter_id": 2919, "verse_number": "१३-४९-३८", "content_sanskrit": "चतुःषष्ट्यङ्गमददत्कलाज्ञानं ममाद्भुतम्।\nसरस्वत्यास्तटे तुष्टो मनोयज्ञेन पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2090272, "chapter_id": 2919, "verse_number": "१३-४९-३९", "content_sanskrit": "तुल्यं मम सहस्रं तु सुतानां ब्रह्मवादिनाम्।\nआयुश्चैव सपुत्रस्य संवत्सरशतायुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2090273, "chapter_id": 2919, "verse_number": "१३-४९-४०x", "content_sanskrit": "पराशर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2090274, "chapter_id": 2919, "verse_number": "१३-४९-४०", "content_sanskrit": "प्रसाद्येह पुरा शर्वं मनसाऽचिन्तयं नृप।\nमहातपा महातेजा महायोगी महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2090275, "chapter_id": 2919, "verse_number": "१३-४९-४१", "content_sanskrit": "वेदव्यासः श्रियावासो ब्राह्मणः करुणान्वितः।\nअप्यसावीप्सितः पुत्रो मम स्याद्वै महेश्वरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2090276, "chapter_id": 2919, "verse_number": "१३-४९-४२", "content_sanskrit": "इति मत्वा हृदि मतं प्राह मां सुरसत्तमः।\nमयि सम्भावना यास्याः फलात्कृष्णो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2090277, "chapter_id": 2919, "verse_number": "१३-४९-४३", "content_sanskrit": "सावर्णस्य मनोः सर्गे सप्तर्षिश्च भविष्यति।\nवेदानां च स वै वक्ता कुरुवंशकरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2090278, "chapter_id": 2919, "verse_number": "१३-४९-४४", "content_sanskrit": "इतिहासस्य कर्ता च पुत्रस्ते जगतो हितः।\nभविष्यति महेन्द्रस्य दयितः स महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2090279, "chapter_id": 2919, "verse_number": "१३-४९-४५", "content_sanskrit": "अजरश्चामरश्चैव पराशर सुतस्तव।\nएवमुक्त्वा स भगवांस्तत्रैवान्तरधीयत।\nयुधिष्ठिर महायोगी वीर्यवानक्षयोऽव्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2090280, "chapter_id": 2919, "verse_number": "१३-४९-४६x", "content_sanskrit": "माण्डव्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2090281, "chapter_id": 2919, "verse_number": "१३-४९-४६", "content_sanskrit": "अचोरश्चोरशङ्कायां शूले भिन्नो ह्यहं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2090282, "chapter_id": 2919, "verse_number": "१३-४९-४७", "content_sanskrit": "तत्रस्थेन स्तुतो देवः प्राह मां वै नरेश्वर।\nमोक्षं प्राप्स्यसि शूलाच्च जीविष्यसि समार्बुदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2090283, "chapter_id": 2919, "verse_number": "१३-४९-४८", "content_sanskrit": "रुजा शूलकृता चैव न ते विप्र भविष्यति।\nआधिभिर्व्याधिभिश्चैव वर्जितस्त्वं भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2090284, "chapter_id": 2919, "verse_number": "१३-४९-४९", "content_sanskrit": "पादाच्चतुर्थात्सम्भूत आत्मा यस्मान्मुने तव।\nत्वं भविष्यस्यनुपमो जन्म वै सफलं कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2090285, "chapter_id": 2919, "verse_number": "१३-४९-५०", "content_sanskrit": "तीर्थाभिषेकं सकलं त्वमविघ्नेन चाप्स्यसि।\nस्वर्गं चैवाक्षयं विप्र विदधामि तवोर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2090286, "chapter_id": 2919, "verse_number": "१३-४९-५१", "content_sanskrit": "एवमुक्त्वा तु भगवान्वरेण्यो वृषवाहनः।\nमहेश्वरो महाराजः कृत्तिवासा महाद्युतिः।\nसगणो दैवतश्रेष्ठस्तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2090287, "chapter_id": 2919, "verse_number": "१३-४९-५२x", "content_sanskrit": "गालव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2090288, "chapter_id": 2919, "verse_number": "१३-४९-५२", "content_sanskrit": "विश्वामित्राभ्यनुज्ञातो ह्यहं पितरमागतः।\nअब्रवीन्मां ततो माता दुःखिता रुदती भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2090289, "chapter_id": 2919, "verse_number": "१३-४९-५३", "content_sanskrit": "कौशिकेनाभ्यनुज्ञातं पुत्रं देवविभूषितम्।\nन तात तरुणं दान्तं पिता त्वां पश्यतेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2090290, "chapter_id": 2919, "verse_number": "१३-४९-५४", "content_sanskrit": "श्रुत्वा जनन्या वचनं निराशो गुरुदर्शने।\nनियतात्मा महादेवमपश्यं सोऽब्रवीच्च माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2090291, "chapter_id": 2919, "verse_number": "१३-४९-५५", "content_sanskrit": "पिता माता च ते त्वं च पुत्र मृत्युविवर्जिताः।\nभविष्यथ विश क्षिप्रं द्रष्टासि पितरं क्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2090292, "chapter_id": 2919, "verse_number": "१३-४९-५६", "content_sanskrit": "अनुज्ञातो भगवता गृहं गत्वा युधिष्ठिर।\nअपश्यं पितरं तात इष्टिं कृत्वा विनिःसृतम्।\nउपस्पृश्य गृहीत्वेध्मं कुशांश्च शरणाकुरून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2090293, "chapter_id": 2919, "verse_number": "१३-४९-५७", "content_sanskrit": "तान्विसृज्य च मां प्राह पिता सास्राविलेक्षणः।\nप्रणमन्तं परिष्वज्य मूर्ध्न्युपाघ्राय पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2090294, "chapter_id": 2919, "verse_number": "१३-४९-५८", "content_sanskrit": "दिष्ट्या दृष्टोसि मे पुत्र कृतविद्य इहागत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2090295, "chapter_id": 2919, "verse_number": "१३-४९-५९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2090296, "chapter_id": 2919, "verse_number": "१३-४९-५९", "content_sanskrit": "एतान्यत्यद्भुतान्येव कर्माण्यथ महात्मनः।\nप्रोक्तानि मुनिभिः श्रुत्वा विस्मयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2090297, "chapter_id": 2919, "verse_number": "१३-४९-६०", "content_sanskrit": "ततः कृष्णोऽब्रवीद्वाक्यं पुनर्मतिमतांवरः।\nयुधिष्ठिरं धर्मनिधिं पुरुहूतमिवेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2090298, "chapter_id": 2919, "verse_number": "१३-४९-६१", "content_sanskrit": "उपमन्युर्मयि प्राह तपन्निव दिवाकरः।\nअशुभैः पापकर्माणो ये नराः कलुषीकृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2090299, "chapter_id": 2919, "verse_number": "१३-४९-६२", "content_sanskrit": "ईशानं न प्रपद्यन्ते तमोराजसवृत्तयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2090300, "chapter_id": 2919, "verse_number": "१३-४९-६३", "content_sanskrit": "ईश्वरं सम्प्रपद्यन्ते द्विजा भावितभावनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2090301, "chapter_id": 2919, "verse_number": "१३-४९-६४", "content_sanskrit": "सर्वथा वर्तमानोपि यो भक्तः परमेश्वरे।\nसदृशोऽरण्यवासीनां मुनीनां भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2090302, "chapter_id": 2919, "verse_number": "१३-४९-६५", "content_sanskrit": "ब्रह्मत्वं केशवत्वं वा शक्रत्वं वा सुरैः सह।\nत्रैलोक्यस्याधिपत्यं वा तुष्टो रुद्रः प्रयच्छति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2090303, "chapter_id": 2919, "verse_number": "१३-४९-६६", "content_sanskrit": "मनसाऽपि शिवं तात ये प्रपद्यन्ति मानवाः।\nविधूय सर्वपापानि देवैः सह वसन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2090304, "chapter_id": 2919, "verse_number": "१३-४९-६७", "content_sanskrit": "भित्त्वाभित्त्वा च कूलानि हुत्वा सर्वमिदं जगत्।\nजयेद्देवं विरूपाक्षं न स पापेन लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2090305, "chapter_id": 2919, "verse_number": "१३-४९-६८", "content_sanskrit": "सर्वलक्षणहीनोपि युक्तो वा सर्वपातकैः।\nसर्वं तुदति तत्पापं भावयञ्शिवमात्मना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2090306, "chapter_id": 2919, "verse_number": "१३-४९-६९", "content_sanskrit": "कीटपक्षिपतङ्गानां तिरश्चामपि केशव।\nमहादेवप्रपन्नानां न भयं विद्यते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2090307, "chapter_id": 2919, "verse_number": "१३-४९-७०", "content_sanskrit": "एवमेव महादेवं भक्ता ये मानवा भुवि।\nन ते संसारवशगा इति मे निश्चिता मतिः।\nततः कृष्णोऽब्रवीद्वाक्यं धर्मपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2090308, "chapter_id": 2919, "verse_number": "१३-४९-७१x", "content_sanskrit": "विष्णुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2090309, "chapter_id": 2919, "verse_number": "१३-४९-७१", "content_sanskrit": "आदित्यचन्द्रावनिलानलौ च\nद्यौर्भूमिरापो वसवोऽथ विश्वे।\nधाताऽर्यमा शुक्रबृहस्पती च\nवेदा यज्ञा दक्षिणा वेदवाहाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2090310, "chapter_id": 2919, "verse_number": "१३-४९-७२", "content_sanskrit": "सोमो यष्टा यच्च हव्यं हविश्च\nरक्षा दीक्षा संयमा ये च केचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2090311, "chapter_id": 2919, "verse_number": "१३-४९-७३", "content_sanskrit": "स्वाहा वौषट् ब्राह्मणाः सौरभेयी\nधर्मं चाग्र्यं कालचक्रं बलं च।\nयशो दमो बुद्धिमतां स्थितिश्च\nशुभाशुभं ये मुनयश्च सप्त॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2090312, "chapter_id": 2919, "verse_number": "१३-४९-७४", "content_sanskrit": "अग्र्या बुद्धिर्मनसा दर्शने च\nस्पर्शश्चाग्र्यः कर्मणां या च सिद्धिः।\nगणा देवानामूष्मपाः सोमपाश्च\nलेखाः सुयामास्तुषिता ब्रह्मकायाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2090313, "chapter_id": 2919, "verse_number": "१३-४९-७५", "content_sanskrit": "आभासुरा गन्धपा धूमपाश्च\nवाचा विरुद्धाश्च मनोविरुद्धाः।\nशुद्धाश्च निर्माणरताश्च देवाः\nस्पर्शाशना दर्शपा आज्यपाश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2090314, "chapter_id": 2919, "verse_number": "१३-४९-७६", "content_sanskrit": "चिन्त्यद्योता ये च देवेषु मुख्या\nये चाप्यन्ते देवताश्चाजमीढ।\nसुपर्णगन्धर्वपिशाचदानवा\nयक्षास्तथा चारणपन्नगाश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2090315, "chapter_id": 2919, "verse_number": "१३-४९-७७", "content_sanskrit": "स्थूलं सूक्ष्मं मृदु चाप्यसूक्ष्मं\nदुःखं सुखं दुःखमनन्तरं च।\nसाङ्ख्यं योगं तत्पराणां परं च\nशर्वाञ्जातं विद्धि य***********॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2090316, "chapter_id": 2919, "verse_number": "१३-४९-७८", "content_sanskrit": "तत्सम्भूता भूतकृतो वरेण्या\nसर्वे देवा भुवनस्यास्य गोपाः।\nआविश्येमां धरणीं येऽभ्यरक्षन्\nपुरातनीं तस्य देवस्य सृष्टिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2090317, "chapter_id": 2919, "verse_number": "१३-४९-७९", "content_sanskrit": "विचिन्वन्तस्तपसा तत्स्थवीयः\nकिञ्चित्तत्त्वं प्राणहेतोर्नतोस्मि।\nददातु वेदः स वरानिहेष्टा-\nनभिष्टुतोः नः प्रभुरव्ययः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2090318, "chapter_id": 2919, "verse_number": "१३-४९-८०", "content_sanskrit": "इमं स्तवं सन्नियतेन्द्रियश्च\nभूत्वा शुचिर्यः पुरुषः पठेत।\nअभग्नयोगो नियतो मासमेकं\nसम्प्राप्नुयादश्वमेधे फलं यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2090319, "chapter_id": 2919, "verse_number": "१३-४९-८१", "content_sanskrit": "वेदान्कृत्स्नान्ब्राह्मणः प्राप्नुयात्तु\nजयेन्नृपः पार्थ महीं च कृत्स्नाम्।\nवैश्यो लाभं प्राप्नुयान्नैपुणं च\nशूद्रो गतिं प्रेत्य तथा सुखं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2090320, "chapter_id": 2919, "verse_number": "१३-४९-८२", "content_sanskrit": "स्तवराजमिमं कृत्वा रुद्राय दधिरे मनः।\nसर्वदोषापहं पुण्यं पवित्रं च यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2090321, "chapter_id": 2919, "verse_number": "१३-४९-८३", "content_sanskrit": "यावन्त्यस्य शरीरेषु रोमकूपाणि भारतः।\nतावन्त्यब्दसहस्राणि स्वर्गे वसति मानवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2090322, "chapter_id": 2919, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनपञ्चाशोऽध्यायः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]