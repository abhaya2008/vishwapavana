[{"id": 2009504, "chapter_id": 1187, "verse_number": "१-१८८-०x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009505, "chapter_id": 1187, "verse_number": "१-१८८-१", "content_sanskrit": "अथ तस्यामदृश्यायां नृपतिः काममोहितः।\nपातनः शत्रुसङ्घानां पपात धरणीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009506, "chapter_id": 1187, "verse_number": "१-१८८-२", "content_sanskrit": "तस्मिन्निपतिते भूमावथ सा चारुहासिनी।\nपुनः पीनायतश्रोणी दर्शयामास तं नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009507, "chapter_id": 1187, "verse_number": "१-१८८-३", "content_sanskrit": "अथाबभाषे कल्याणी वाचा मधुरया नृपम्।\nतं कुरूणां कुलकरं कामाभिहतचेतसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009508, "chapter_id": 1187, "verse_number": "१-१८८-४", "content_sanskrit": "उवाच मधुरं वाक्यं तपती हसतीव सा।\nउत्तिष्ठोत्तिष्ठ भद्रं ते न त्वमर्हस्यरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009509, "chapter_id": 1187, "verse_number": "१-१८८-५", "content_sanskrit": "मोहं नृपतिशार्दूल गन्तुमाविष्कृतः क्षितौ।\nएवमुक्तोऽथ नृपतिर्वाचा मधुरया तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009510, "chapter_id": 1187, "verse_number": "१-१८८-६", "content_sanskrit": "ददर्श विपुलश्रोणीं तामेवाभिमुखे स्थिताम्।\nअथ तामसितापाङ्गीमाबभाषे स पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009511, "chapter_id": 1187, "verse_number": "१-१८८-७", "content_sanskrit": "मन्मथाग्निपरीतात्मा सन्दिग्धाक्षरया गिरा।\nसाधु त्वमसितापाङ्गि कामार्तं मत्तकाशिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009512, "chapter_id": 1187, "verse_number": "१-१८८-८", "content_sanskrit": "भजस्व भजमानं मां प्राणा हि प्रजहन्ति माम्।\nत्वदर्थं हि विशालाक्षि मामयं निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009513, "chapter_id": 1187, "verse_number": "१-१८८-९", "content_sanskrit": "कामः कमलगर्भाभे प्रतिविध्यन्न शाम्यति।\nदष्टमेवमनाक्रन्दे भद्रे काममहाहिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009514, "chapter_id": 1187, "verse_number": "१-१८८-१०", "content_sanskrit": "सा त्वं पीनायतश्रोणी मामाप्नुहि वरानने।\nत्वदधीना हि मे प्राणाः किन्नरोद्गीतभाषिणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009515, "chapter_id": 1187, "verse_number": "१-१८८-११", "content_sanskrit": "चारुसर्वानवद्याङ्गि पद्मेन्दुप्रतिमानने।\nन ह्यहं त्वदृते भीरु शक्ष्यामि खलु जीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009516, "chapter_id": 1187, "verse_number": "१-१८८-१२", "content_sanskrit": "कामः कमलपत्राक्षि प्रतिविध्यति मामयम्।\nतस्मात्कुरु विशालाक्षि मय्यनुक्रोशमङ्गने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009517, "chapter_id": 1187, "verse_number": "१-१८८-१३", "content_sanskrit": "भक्तं मामसितापाङ्गि न परित्यक्तुमर्हसि।\nत्वं हि मां प्रीतियोगेन त्रातुमर्हसि भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009518, "chapter_id": 1187, "verse_number": "१-१८८-१४", "content_sanskrit": "त्वद्दर्शनकृतस्नेहं मनश्चलति मे भृशम्।\nन त्वां दृष्ट्वा पुनश्चान्यां द्रष्टुं कल्याणि रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009519, "chapter_id": 1187, "verse_number": "१-१८८-१५", "content_sanskrit": "प्रसीद वशगोऽहं ते भक्तं मां भज भामिनि।\nदृष्ट्वैव त्वां वरारोहे मन्मथो भृशमङ्गने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009520, "chapter_id": 1187, "verse_number": "१-१८८-१६", "content_sanskrit": "अन्तर्गतं विशालाक्षि विध्यति स्म पतत्त्रिभिः।\nमन्मथाग्निसमुद्भूतं दाहं कमललोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009521, "chapter_id": 1187, "verse_number": "१-१८८-१७", "content_sanskrit": "प्रीतिसंयोगयुक्ताभिरद्भिः प्रह्लादयस्व मे।\nपुष्पायुधं दुराधर्षं प्रचण्डशरकार्मुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009522, "chapter_id": 1187, "verse_number": "१-१८८-१८", "content_sanskrit": "त्वद्दर्शनसमुद्भूतं विध्यन्तं दुःसहैः शरैः।\nउपशामय कल्याणि आत्मदानेन भामिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009523, "chapter_id": 1187, "verse_number": "१-१८८-१९", "content_sanskrit": "गान्धर्वेण विवाहेन मामुपैहि वराङ्गने।\nविवाहानां हि रम्भोरु गान्धर्वः श्रेष्ठ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009524, "chapter_id": 1187, "verse_number": "१-१८८-२०x", "content_sanskrit": "तपत्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009525, "chapter_id": 1187, "verse_number": "१-१८८-२०", "content_sanskrit": "नाहमीशाऽऽत्मनो राजन्कन्या पितृमती ह्यहम्।\nमयि चेदस्ति ते प्रीतिर्याचस्व पितरं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009526, "chapter_id": 1187, "verse_number": "१-१८८-२१", "content_sanskrit": "यथा हि ते मया प्राणाः संभृताश्च नरेश्वर।\nदर्शनादेव भूयस्त्वं तथा प्राणान्ममाहरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009527, "chapter_id": 1187, "verse_number": "१-१८८-२२", "content_sanskrit": "न चाहमीशा देहस्य तस्मान्नृपतिसत्तम।\nसमीपं नोपगच्छामि न स्वतन्त्रा हि योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009528, "chapter_id": 1187, "verse_number": "१-१८८-२३", "content_sanskrit": "का हि सर्वेषु लोकेषु विश्रुताभिजनं नृपम्।\nकन्या नाभिलषेन्नाथं भार्तारं भक्तवत्सलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009529, "chapter_id": 1187, "verse_number": "१-१८८-२४", "content_sanskrit": "तस्मादेवं गते काले याचस्व पितरं मम।\nआदित्यं प्रणिपातेन तपसा नियमेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009530, "chapter_id": 1187, "verse_number": "१-१८८-२५", "content_sanskrit": "स चेत्कामयते दातुं तव मामरिसूदन।\nभविष्याम्यद्य ते राजन्सततं वशवर्तिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009531, "chapter_id": 1187, "verse_number": "१-१८८-२६", "content_sanskrit": "अहं हि तपती नाम सावित्र्यवरजा सुता।\nअस्य लोकप्रदीपस्य सवितुः क्षत्रियर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009532, "chapter_id": 1187, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि अष्टाशीत्यधिकशततमोऽध्यायः॥ १८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]