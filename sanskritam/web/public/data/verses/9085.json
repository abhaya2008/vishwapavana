[{"id": 5000085000, "chapter_id": 9085, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000085001, "chapter_id": 9085, "verse_number": "२-८-१", "content_sanskrit": "मन्थरा त्वभ्यसूय्यैनामुत्सृज्याभरणं हि तत्।\nउवाचेदं ततो वाक्यं कोपदुःखसमन्विता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000085002, "chapter_id": 9085, "verse_number": "२-८-२", "content_sanskrit": "हर्षं किमर्थमस्थाने कृतवत्यसि बालिशे।\nशोकसागरमध्यस्थं नात्मानमवबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000085003, "chapter_id": 9085, "verse_number": "२-८-३", "content_sanskrit": "मनसा प्रसहामि त्वां देवि दुःखार्दिता सती।\nयच्छोचितव्ये हृष्टासि प्राप्य त्वं व्यसनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000085004, "chapter_id": 9085, "verse_number": "२-८-४", "content_sanskrit": "शोचामि दुर्मतित्वं ते का हि प्राज्ञा प्रहर्षयेत्।\nअरेः सपत्नीपुत्रस्य वृद्धिं मृत्योरिवागताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000085005, "chapter_id": 9085, "verse_number": "२-८-५", "content_sanskrit": "भरतादेव रामस्य राज्यसाधारणाद् भयम्।\nतद् विचिन्त्य विषण्णास्मि भयं भीताद्धि जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000085006, "chapter_id": 9085, "verse_number": "२-८-६", "content_sanskrit": "लक्ष्मणो हि महाबाहू रामं सर्वात्मना गतः।\nशत्रुघ्नश्चापि भरतं काकुत्स्थं लक्ष्मणो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000085007, "chapter_id": 9085, "verse_number": "२-८-७", "content_sanskrit": "प्रत्यासन्नक्रमेणापि भरतस्यैव भामिनि।\nराज्यक्रमो विसृष्टस्तु तयोस्तावद्यवीयसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000085008, "chapter_id": 9085, "verse_number": "२-८-८", "content_sanskrit": "विदुषः क्षत्रचारित्रे प्राज्ञस्य प्राप्तकारिणः।\nभयात् प्रवेपे रामस्य चिन्तयन्ती तवात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000085009, "chapter_id": 9085, "verse_number": "२-८-९", "content_sanskrit": "सुभगा किल कौसल्या यस्याः पुत्रोऽभिषेक्ष्यते।\nयौवराज्येन महता श्वः पुष्येण द्विजोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000085010, "chapter_id": 9085, "verse_number": "२-८-१०", "content_sanskrit": "प्राप्तां वसुमतीं प्रीतिं प्रतीतां हतविद्विषम्।\nउपस्थास्यसि कौसल्यां दासीवत् त्वं कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000085011, "chapter_id": 9085, "verse_number": "२-८-११", "content_sanskrit": "एवं च त्वं सहास्माभिस्तस्याः प्रेष्या भविष्यसि।\nपुत्रश्च तव रामस्य प्रेष्यत्वं हि गमिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000085012, "chapter_id": 9085, "verse_number": "२-८-१२", "content_sanskrit": "हृष्टाः खलु भविष्यन्ति रामस्य परमाः स्त्रियः।\nअप्रहृष्टा भविष्यन्ति स्नुषास्ते भरतक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000085013, "chapter_id": 9085, "verse_number": "२-८-१३", "content_sanskrit": "तां दृष्ट्वा परमप्रीतां ब्रुवन्तीं मन्थरां ततः।\nरामस्यैव गुणान् देवी कैकेयी प्रशशंस ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000085014, "chapter_id": 9085, "verse_number": "२-८-१४", "content_sanskrit": "धमर्ज्ञो गुणवान् दान्तः कृतज्ञः सत्यवान् शुचिः।\nरामो राजसुतो ज्येष्ठो यौवराज्यमतोऽर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000085015, "chapter_id": 9085, "verse_number": "२-८-१५", "content_sanskrit": "भ्रातॄन् भृत्यांश्च दीर्घायुः पितृवत् पालयिष्यति।\nसंतप्यसे कथं कुब्जे श्रुत्वा रामाभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000085016, "chapter_id": 9085, "verse_number": "२-८-१६", "content_sanskrit": "भरतश्चापि रामस्य ध्रुवं वर्षशतात् परम्।\nपितृपैतामहं राज्यमवाप्स्यति नरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000085017, "chapter_id": 9085, "verse_number": "२-८-१७", "content_sanskrit": "सा त्वमभ्युदये प्राप्ते दह्यमानेव मन्थरे।\nभविष्यति च कल्याणे किमिदं परितप्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000085018, "chapter_id": 9085, "verse_number": "२-८-१८", "content_sanskrit": "यथा वै भरतो मान्यस्तथा भूयोऽपि राघवः।\nकौसल्यातोऽतिरिक्तं च मम शुश्रूषते बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000085019, "chapter_id": 9085, "verse_number": "२-८-१९", "content_sanskrit": "राज्यं यदि हि रामस्य भरतस्यापि तत् तदा।\nमन्यते हि यथाऽऽत्मानं यथा भ्रातॄंस्तु राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000085020, "chapter_id": 9085, "verse_number": "२-८-२०", "content_sanskrit": "कैकेय्या वचनं श्रुत्वा मन्थरा भृशदुःखिता।\nदीर्घमुष्णं विनिःश्वस्य कैकेयीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000085021, "chapter_id": 9085, "verse_number": "२-८-२१", "content_sanskrit": "अनर्थदर्शिनी मौर्ख्यान्नात्मानमवबुध्यसे।\nशोकव्यसनविस्तीर्णे मज्जन्ती दुःखसागरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000085022, "chapter_id": 9085, "verse_number": "२-८-२२", "content_sanskrit": "भविता राघवो राजा राघवस्य च यः सुतः।\nराजवंशात्तु भरतः कैकेयि परिहास्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000085023, "chapter_id": 9085, "verse_number": "२-८-२३", "content_sanskrit": "नहि राज्ञः सुताः सर्वे राज्ये तिष्ठन्ति भामिनि।\nस्थाप्यमानेषु सर्वेषु सुमहाननयो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000085024, "chapter_id": 9085, "verse_number": "२-८-२४", "content_sanskrit": "तस्माज्ज्येष्ठे हि कैकेयि राज्यतन्त्राणि पार्थिवाः।\nस्थापयन्त्यनवद्याङ्गि गुणवत्स्वितरेष्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000085025, "chapter_id": 9085, "verse_number": "२-८-२५", "content_sanskrit": "असावत्यन्तनिर्भग्नस्तव पुत्रो भविष्यति।\nअनाथवत् सुखेभ्यश्च राजवंशाच्च वत्सले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000085026, "chapter_id": 9085, "verse_number": "२-८-२६", "content_sanskrit": "साहं त्वदर्थे सम्प्राप्ता त्वं तु मां नावबुद्ध्यसे।\nसपत्निवृद्धौ या मे त्वं प्रदेयं दातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000085027, "chapter_id": 9085, "verse_number": "२-८-२७", "content_sanskrit": "ध्रुवं तु भरतं रामः प्राप्य राज्यमकण्टकम्।\nदेशान्तरं नाययिता लोकान्तरमथापि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000085028, "chapter_id": 9085, "verse_number": "२-८-२८", "content_sanskrit": "बाल एव तु मातुल्यं भरतो नायितस्त्वया।\nसंनिकर्षाच्च सौहार्दं जायते स्थावरेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000085029, "chapter_id": 9085, "verse_number": "२-८-२९", "content_sanskrit": "भरतानुवशात् सोऽपि शत्रुघ्नस्तत्समं गतः।\nलक्ष्मणो हि यथा रामं तथायं भरतं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000085030, "chapter_id": 9085, "verse_number": "२-८-३०", "content_sanskrit": "श्रूयते हि द्रुमः कश्चिच्छेत्तव्यो वनजीवनैः।\nसंनिकर्षादिषीकाभिर्मोचितः परमाद् भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000085031, "chapter_id": 9085, "verse_number": "२-८-३१", "content_sanskrit": "गोप्ता हि रामं सौमित्रिर्लक्ष्मणं चापि राघवः।\nअश्विनोरिव सौभ्रात्रं तयोर्लोकेषु विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000085032, "chapter_id": 9085, "verse_number": "२-८-३२", "content_sanskrit": "तस्मान्न लक्ष्मणे रामः पापं किंचित् करिष्यति।\nरामस्तु भरते पापं कुर्यादेव न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000085033, "chapter_id": 9085, "verse_number": "२-८-३३", "content_sanskrit": "तस्माद् राजगृहादेव वनं गच्छतु राघवः।\nएतद्धि रोचते मह्यं भृशं चापि हितं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000085034, "chapter_id": 9085, "verse_number": "२-८-३४", "content_sanskrit": "एवं ते ज्ञातिपक्षस्य श्रेयश्चैव भविष्यति।\nयदि चेद् भरतो धर्मात् पित्र्यं राज्यमवाप्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000085035, "chapter_id": 9085, "verse_number": "२-८-३५", "content_sanskrit": "स ते सुखोचितो बालो रामस्य सहजो रिपुः।\nसमृद्धार्थस्य नष्टार्थो जीविष्यति कथं वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000085036, "chapter_id": 9085, "verse_number": "२-८-३६", "content_sanskrit": "अभिद्रुतमिवारण्ये सिंहेन गजयूथपम्।\nप्रच्छाद्यमानं रामेण भरतं त्रातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000085037, "chapter_id": 9085, "verse_number": "२-८-३७", "content_sanskrit": "दर्पान्निराकृता पूर्वं त्वया सौभाग्यवत्तया।\nराममाता सपत्नी ते कथं वैरं न यापयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000085038, "chapter_id": 9085, "verse_number": "२-८-३८", "content_sanskrit": "यदा च रामः पृथिवीमवाप्स्यते\nप्रभूतरत्नाकरशैलसंयुताम्।\nतदा गमिष्यस्यशुभं पराभवं\nसहैव दीना भरतेन भामिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000085039, "chapter_id": 9085, "verse_number": "२-८-३९", "content_sanskrit": "यदा हि रामः पृथिवीमवाप्स्यते\nध्रुवं प्रणष्टो भरतो भविष्यति।\nअतो हि संचिन्तय राज्यमात्मजे\nपरस्य चैवास्य विवासकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000085040, "chapter_id": 9085, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे अष्टमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]