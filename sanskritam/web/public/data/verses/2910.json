[{"id": 2089251, "chapter_id": 2910, "verse_number": "१३-४०-१", "content_sanskrit": "`युधिष्ठर उवाच।\nआत्मन्यग्नौ समाध्नाय य एते कुरुनन्दन।\nद्विजातयो व्रतोपेता जपयज्ञपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2089252, "chapter_id": 2910, "verse_number": "१३-४०-२", "content_sanskrit": "यजन्त्यारम्भयज्ञैश्च मानसं यज्ञमास्थिताः।\nअग्निभ्यश्च परं नास्ति येषामेषोऽव्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2089253, "chapter_id": 2910, "verse_number": "१३-४०-३", "content_sanskrit": "तेषां गतिर्महाप्राज्ञ कीदृशी किम्पराश्च ते।\nएतदिच्छामि तत्वेन त्वत्तः श्रोतुं पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2089254, "chapter_id": 2910, "verse_number": "१३-४०-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2089255, "chapter_id": 2910, "verse_number": "१३-४०-४", "content_sanskrit": "अत्र ते वर्तयिष्यामि इतिहासं पुरातनम्।\nवैकुण्ठस्य च संवादं सुपर्णस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2089256, "chapter_id": 2910, "verse_number": "१३-४०-५", "content_sanskrit": "अमृतस्य समुत्पत्तौ देवानामसुरैः सह।\nषष्टिवर्षसहस्राणि दैवासुरमवर्तत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2089257, "chapter_id": 2910, "verse_number": "१३-४०-६", "content_sanskrit": "तत्र देवास्तु दैतेयैर्वध्यन्ते भृशदारुणैः।\nत्रातारं नाधिगच्छन्ति वध्यमाना महासुरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2089258, "chapter_id": 2910, "verse_number": "१३-४०-७", "content_sanskrit": "आर्तास्ते देवदेवेशं प्रपन्नाः शरणैषिणः।\nपितामहं महाप्राज्ञं वध्यमानाः सुरेतरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2089259, "chapter_id": 2910, "verse_number": "१३-४०-८", "content_sanskrit": "ता दृष्ट्वा देवता ब्रह्मा सम्भ्रान्तेन्द्रियमानसः।\nवैकुण्ठं शरणं देवं प्रतिपेदे च तैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2089260, "chapter_id": 2910, "verse_number": "१३-४०-९", "content_sanskrit": "ततः स देवैः सहितः पद्मयोनिर्नरेश्वर।\nतुष्टाव प्राञ्जलिर्भूत्वा नारायणमनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2089261, "chapter_id": 2910, "verse_number": "१३-४०-१०", "content_sanskrit": "त्वद्रूपचिन्तनान्नाम्नां स्मरणादर्चनादपि।\nतपोयोगादिभिश्चैव श्रेयो यान्ति मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2089262, "chapter_id": 2910, "verse_number": "१३-४०-११", "content_sanskrit": "भक्तवत्सल पद्माक्ष परमेश्वर पापहन्।\nपरमात्माऽविकाराद्य नारायण नमोंस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2089263, "chapter_id": 2910, "verse_number": "१३-४०-१२", "content_sanskrit": "नमस्ते सर्वलोकादे सर्वात्मामितविक्रम।\nसर्वभूतभविष्येश सर्वभूतमहेश्वर", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2089264, "chapter_id": 2910, "verse_number": "१३-४०-१३", "content_sanskrit": "देवानामपि देवस्त्वं सर्वविद्यापरायणः।\nजगद्वीजसमाहार जगतः परमो ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2089265, "chapter_id": 2910, "verse_number": "१३-४०-१४", "content_sanskrit": "त्रायस्व देवता वीर दानवाद्यैः सुपीडिताः।\nलोकांश्च लोकपालांश्च ऋषींश्च जयतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2089266, "chapter_id": 2910, "verse_number": "१३-४०-१५", "content_sanskrit": "वेदाः साङ्गोपनिषदः सरहस्याः ससङ्ग्रहाः।\nसोङ्काराः सवषट्काराः प्राहुस्त्वां यज्ञमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2089267, "chapter_id": 2910, "verse_number": "१३-४०-१६", "content_sanskrit": "पवित्राणां पवित्रं च मङ्गलानां च मङ्गलम्।\nतपस्विनां तपश्चैव दैवतं देवतास्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2089268, "chapter_id": 2910, "verse_number": "१३-४०-१७", "content_sanskrit": "एवमादिपुरस्कारैर्ऋक्सामयजुषां गणैः।\nवैकुण्ठं तुष्टुवुर्देवाः सर्वे ब्रह्मर्षिभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2089269, "chapter_id": 2910, "verse_number": "१३-४०-१८", "content_sanskrit": "ततोऽन्तरिक्षे वागासीन्मेघगम्भीरनिस्वना।\nजेष्यध्वं दानवान्यूयं मयैव सह सङ्गरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2089270, "chapter_id": 2910, "verse_number": "१३-४०-१९", "content_sanskrit": "ततो देवगणानां च दानवानां च युध्यताम्।\nप्रादुरासीन्महातेजाः शार्ङ्गचक्रगदाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2089271, "chapter_id": 2910, "verse_number": "१३-४०-२०", "content_sanskrit": "सुपर्णपृष्ठमास्थाय तेजसा प्रदहन्निव।\nव्यधमद्दानवान्सर्वान्बाहुद्रविणतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2089272, "chapter_id": 2910, "verse_number": "१३-४०-२१", "content_sanskrit": "तं समासाद्य समरे दैत्यदानवपुङ्गवाः।\nव्यनश्यन्त महाराज पतङ्गा इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2089273, "chapter_id": 2910, "verse_number": "१३-४०-२२", "content_sanskrit": "स विजित्यासुरान्सर्वान्दानवांश्च महामतिः।\nपश्यतामेव देवानां तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2089274, "chapter_id": 2910, "verse_number": "१३-४०-२३", "content_sanskrit": "तं दृष्ट्वान्तर्हितं देवा विष्णुं देवामितद्युतिम्।\nविस्मयोत्फुल्लनयना ब्रह्माणमिदमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2089275, "chapter_id": 2910, "verse_number": "१३-४०-२४", "content_sanskrit": "भगवन्सर्वलोकेश सर्वलोकपितामह।\nइदमत्यद्भुतं वृत्तं तन्नः शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2089276, "chapter_id": 2910, "verse_number": "१३-४०-२५", "content_sanskrit": "दैवासुरेऽस्मिन्सङ्ग्रामे त्राता येन वयं विभो।\nएतद्विज्ञातुमिच्छामः कुतोसौ कश्च तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2089277, "chapter_id": 2910, "verse_number": "१३-४०-२६", "content_sanskrit": "कोऽयमस्मान्परित्राय तूष्णीमेव यथागतम्।\nप्रतिप्रयातो दिव्यात्मा तं नः शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2089278, "chapter_id": 2910, "verse_number": "१३-४०-२७", "content_sanskrit": "एवमुक्तः सुरैः सर्वैर्वचनं वचनार्थवित्।\nउवाच पद्मनाभस्य पूर्वरूपं प्रति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2089279, "chapter_id": 2910, "verse_number": "१३-४०-२८x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2089280, "chapter_id": 2910, "verse_number": "१३-४०-२८", "content_sanskrit": "न ह्येनं वेद तत्वेन भुवनं भुवनेश्वरम्।\nसङ्ख्यातुं नैव चात्मानं निर्गुणं गुणिनां वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2089281, "chapter_id": 2910, "verse_number": "१३-४०-२९", "content_sanskrit": "अत्र ते वर्तयिष्यामि इतिहासं पुरातनम्।\nसुपर्णस्य च संवादमृषीणां चापि देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2089282, "chapter_id": 2910, "verse_number": "१३-४०-३०", "content_sanskrit": "पुरा ब्रह्मर्षयश्चैव सिद्दाश्च भुवनेश्वरम्।\nआश्रित्य हिमवत्पृष्ठे चक्रिरे विविधाः कथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2089283, "chapter_id": 2910, "verse_number": "१३-४०-३१", "content_sanskrit": "तेषां कथयतां तत्र कथान्ते पततां वरः।\nप्रादुरासीन्महातेजा वाहश्चक्रगदाभृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2089284, "chapter_id": 2910, "verse_number": "१३-४०-३२", "content_sanskrit": "स तानृषीन्समासाद्य विनयावनताननः।\nअवतीर्य महावीर्यस्तानृषीनभिजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2089285, "chapter_id": 2910, "verse_number": "१३-४०-३३", "content_sanskrit": "अभ्यर्चितः स ऋषिभिः स्वागतेन महाबलः।\nउपाविशत तेजस्वी भूमौ वेगवतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2089286, "chapter_id": 2910, "verse_number": "१३-४०-३४", "content_sanskrit": "तमासीनं महात्मानं वैनतेयं महाद्युतिम्।\nऋषयः परिपप्रच्छुर्महात्मानस्तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2089287, "chapter_id": 2910, "verse_number": "१३-४०-३५", "content_sanskrit": "कौतूहलं वैनतेय परं नो हृदि वर्तते।\nतस्य नान्योस्ति वक्तेह त्वामृते पन्नगाशन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2089288, "chapter_id": 2910, "verse_number": "१३-४०-३६", "content_sanskrit": "तदाख्यातमिहेच्छामो भवता प्रश्नमुत्तमम्।\nएवमुक्तः प्रत्युवाच प्राञ्जलिर्विनतासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2089289, "chapter_id": 2910, "verse_number": "१३-४०-३७", "content_sanskrit": "धन्योस्म्यनुगृहीतोस्मि यन्मां ब्रह्मर्षिसत्तमाः।\nप्रष्टव्यं प्रष्टुमिच्छन्ति प्रीतिमन्तोऽनसूयकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2089290, "chapter_id": 2910, "verse_number": "१३-४०-३८", "content_sanskrit": "किं मया ब्रूत वक्तव्यं कार्यं च वदतां वराः।\nयूयं हि मां यथायुक्तं सर्वं वै प्रष्टुमर्हथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2089291, "chapter_id": 2910, "verse_number": "१३-४०-३९", "content_sanskrit": "नमस्कृत्वा ह्यनन्ताय ततस्त ऋषिसत्तमाः।\nप्रष्टुं प्रचक्रमुस्तत्र वैनतेयं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2089292, "chapter_id": 2910, "verse_number": "१३-४०-४०", "content_sanskrit": "देवदेवं महात्मानं नारायणमनामयम्।\nभवानुपास्ते वरदं कुतोऽसौ कश्च तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2089293, "chapter_id": 2910, "verse_number": "१३-४०-४१", "content_sanskrit": "प्रकृतिर्विकृतिर्वाऽस्य कीदृशी क्वनु संस्थितिः।\nएतद्भवन्तं पृच्छामो देवोऽयं क्व कृतालयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2089294, "chapter_id": 2910, "verse_number": "१३-४०-४२", "content_sanskrit": "एथ भक्तप्रियो देवः प्रियभक्तस्तथैव च।\nत्वं प्रियश्चास्य भक्तश्च नान्यः काश्यप विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2089295, "chapter_id": 2910, "verse_number": "१३-४०-४३", "content_sanskrit": "मुष्णन्निव मनश्चक्षूंष्यविभाव्यतनुर्विभुः।\nअनादिमध्यनिधनो न विद्मैनं कुतो ह्यसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2089296, "chapter_id": 2910, "verse_number": "१३-४०-४४", "content_sanskrit": "वेदेष्वपि च विश्वात्मा गीयते न च विद्महे।\nतत्वतस्तत्वभूतात्मा विभुर्नित्यः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2089297, "chapter_id": 2910, "verse_number": "१३-४०-४५", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्।\nगुणाश्चैषां यथासङ्ख्यं भावाभावौ तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2089298, "chapter_id": 2910, "verse_number": "१३-४०-४६", "content_sanskrit": "तमः सत्वं रजश्चैव भावाश्चैव तदात्मकाः।\nमनो बुद्धिश्च तेजश्च बुद्धिगम्यानि तत्वतः।\nजायन्ते तात तस्माद्धि तिष्ठते तेष्वसौ विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2089299, "chapter_id": 2910, "verse_number": "१३-४०-४७", "content_sanskrit": "सञ्चिन्त्य बहुधा बुद्ध्या नाध्यवस्यामहे परम्।\nतस्य देवस्य तत्वेन तन्नः शंस यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2089300, "chapter_id": 2910, "verse_number": "१३-४०-४८", "content_sanskrit": "एतमेव परं प्रश्नं कौतूहलसमन्विताः।\nएवं भवन्तं पृच्छामस्तन्नः शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2089301, "chapter_id": 2910, "verse_number": "१३-४०-४९x", "content_sanskrit": "सुपर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2089302, "chapter_id": 2910, "verse_number": "१३-४०-४९", "content_sanskrit": "स्थूलतो यस्तु भगवांस्तेनैव स्वेन हेतुना।\nत्रैलोक्यस्य तु रक्षार्थं दृश्यते रूपमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2089303, "chapter_id": 2910, "verse_number": "१३-४०-५०", "content_sanskrit": "मया तु महदाश्चर्यं पुरा दृष्टं सनातने।\nदेवे श्रीवत्सनिलये तच्छृणुध्वमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2089304, "chapter_id": 2910, "verse_number": "१३-४०-५१", "content_sanskrit": "न स्म शक्यो मया वेत्तुं न भवद्भिः कथञ्चन।\nयथा मां प्राह भगवांस्तथा तच्छ्रुयतां मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2089305, "chapter_id": 2910, "verse_number": "१३-४०-५२", "content_sanskrit": "मयाऽमृतं देवतानां मिषतामृषिसत्तमाः।\nहृतं विपाट्य तं यन्त्रं विद्राव्यामृतरक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2089306, "chapter_id": 2910, "verse_number": "१३-४०-५३", "content_sanskrit": "देवता विमुखीकृत्य सेन्द्राः समरुतो मृधे।\nउन्मथ्याशु गिरींश्चैव विक्षोभ्य च महोदधिं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2089307, "chapter_id": 2910, "verse_number": "१३-४०-५४", "content_sanskrit": "तं दृष्ट्वा मम विक्रान्तं वागुवाचाशरीरिणी।\nप्रीतोस्मि ते वैनतेय कर्मणाऽनेन सुव्रत।\nअवृथा तेऽस्तु मद्वाक्यं ब्रूहि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2089308, "chapter_id": 2910, "verse_number": "१३-४०-५५", "content_sanskrit": "तामेवंवादिनीं वाचमहं प्रत्युक्तवांस्तदा।\nज्ञातुमिच्छामि कस्त्वं हि ततो मे दास्यसे वरम्।\nप्रकृतिर्विकृतिर्वा त्वं देवो वा दानवोपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2089309, "chapter_id": 2910, "verse_number": "१३-४०-५६", "content_sanskrit": "ततो जलदगम्भीरं प्रहस्य वदतांवरः।\nउंवाच वरदः प्रीतः काले त्वं माऽभिवेत्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2089310, "chapter_id": 2910, "verse_number": "१३-४०-५७", "content_sanskrit": "वाहनं भव मे साधो वरं दद्मि तवोत्तमम्।\nन ते वीर्येण सदृशः कश्चिल्लोके भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2089311, "chapter_id": 2910, "verse_number": "१३-४०-५८", "content_sanskrit": "पतङ्ग पततांश्रेष्ठ न देवो नापि दानवः।\nमत्सखित्वमनुप्राप्तो दुर्धर्षश्च भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2089312, "chapter_id": 2910, "verse_number": "१३-४०-५९", "content_sanskrit": "तमब्रवं देवदेवं मामेवंवादिनं परम्।\nप्रयतः प्राञ्जलिर्भूत्वा प्रणम्य शिरसा विभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2089313, "chapter_id": 2910, "verse_number": "१३-४०-६०", "content_sanskrit": "एवमेतन्महाबाहो सर्वमेतद्भविष्यति।\nवाहनं ते भविष्यामि यथा वदति मां भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2089314, "chapter_id": 2910, "verse_number": "१३-४०-६१", "content_sanskrit": "मम चापि महाबुद्धे निश्चयं श्रूयतामिति।\nध्वजस्तेऽहं भविष्यामि रथस्थस्य न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2089315, "chapter_id": 2910, "verse_number": "१३-४०-६२", "content_sanskrit": "तथास्त्विति स मामुक्त्वा भूयः प्राह महामनाः।\nन ते गतिविघातोऽद्य भविष्यत्यमृतं विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2089316, "chapter_id": 2910, "verse_number": "१३-४०-६३", "content_sanskrit": "एवं कृत्वा तु समयं देवदेवः सनातनः।\nमामुक्त्वा साधयस्वेति यथाऽभिप्रायतो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2089317, "chapter_id": 2910, "verse_number": "१३-४०-६४", "content_sanskrit": "ततोऽहं कृतसंवादो येन केनापि सत्तमाः।\nकौतूहलसमाविष्टः पितरं कश्यपं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2089318, "chapter_id": 2910, "verse_number": "१३-४०-६५", "content_sanskrit": "सोहं पितरमासाद्य प्रणिपत्याभिवाद्य च।\nसर्वमेतद्यथातथ्यमुक्तवान्पितुरन्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2089319, "chapter_id": 2910, "verse_number": "१३-४०-६६", "content_sanskrit": "श्रुत्वा तु भगवान्मह्यं ध्यानमेवान्वपद्यत।\nस मुहूर्तमिव ध्यात्वा मामाह वदतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2089320, "chapter_id": 2910, "verse_number": "१३-४०-६७", "content_sanskrit": "धन्योस्यनुगृहीतश्च यत्त्वं तेन महात्मना।\nसंवादं कृतवांस्तात गुह्येन परमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2089321, "chapter_id": 2910, "verse_number": "१३-४०-६८", "content_sanskrit": "स्थूलदृश्यः स भगवांस्तेन तेनैव हेतुना।\nदृश्यतेऽव्यक्तरूपस्थः प्रधानप्रभवाप्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2089322, "chapter_id": 2910, "verse_number": "१३-४०-६९", "content_sanskrit": "मया हि स महातेजा नान्ययोगसमाधिना।\nतपसोग्रेण तेजस्वी तोषितस्तपसांनिधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2089323, "chapter_id": 2910, "verse_number": "१३-४०-७०", "content_sanskrit": "ततो मे दर्शयामास तोषयन्निव पुत्रक।\nश्वेतपीतारुणनिभः कद्रूकपिलपिङ्गलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2089324, "chapter_id": 2910, "verse_number": "१३-४०-७१", "content_sanskrit": "रक्तनीलासितनिभः सहस्रोदरपाणिमान्।\nद्विसाहस्रमहावक्त्र एकाक्षः शतलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2089325, "chapter_id": 2910, "verse_number": "१३-४०-७२", "content_sanskrit": "अनिष्पन्दा निराहाराः समानाः सूर्यतेजसा।\nतमुपासन्ति परमं गुह्यमक्षरमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2089326, "chapter_id": 2910, "verse_number": "१३-४०-७३", "content_sanskrit": "समासाद्य तु तं विश्वमहं मूर्ध्ना प्रणम्य च।\nऋग्यजुःसामभिः स्तुत्वा शरण्यं शरणं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2089327, "chapter_id": 2910, "verse_number": "१३-४०-७४", "content_sanskrit": "महामेघौघधीरेण स्वरेण जयतांवरः।\nआभाष्य पुत्रपुत्रेति इदमाह धृतं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2089328, "chapter_id": 2910, "verse_number": "१३-४०-७५", "content_sanskrit": "त्वयाऽभ्युदयकामेन तपश्चीर्णं महामुने।\nअमुक्तस्त्वं समासङ्गैरविमुक्तोऽद्य पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2089329, "chapter_id": 2910, "verse_number": "१३-४०-७६", "content_sanskrit": "यदा सङ्गैर्विमुक्तश्च गतमोहो गतस्पृहः।\nभविष्यसि सदा ब्रह्म मामनुध्यास्यसे द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2089330, "chapter_id": 2910, "verse_number": "१३-४०-७७", "content_sanskrit": "ऐकान्तिकीं मतिं कृत्वा मद्भक्तो मत्परायणः।\nज्ञास्यसे मां ततो ब्रह्मन्वीतमोहश्च तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2089331, "chapter_id": 2910, "verse_number": "१३-४०-७८", "content_sanskrit": "तेन त्वं कृतसंवादः स्वतः सर्वहितैषिणा।\nविश्वरूपेण देवेन पुरुषेण महात्मना।\nतमेवाराधय क्षिप्रं तमाराध्य न सीदसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2089332, "chapter_id": 2910, "verse_number": "१३-४०-७९", "content_sanskrit": "सोहमेवं भगवता पित्रा ब्रह्मर्षिसत्तमाः।\nअनुनीतो यथान्यायं स्वमेव भवनं गतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2089333, "chapter_id": 2910, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चत्वारिंशोऽध्यायः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]