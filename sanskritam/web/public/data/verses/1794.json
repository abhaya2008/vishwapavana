[{"id": 2036729, "chapter_id": 1794, "verse_number": "५-३९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2036730, "chapter_id": 1794, "verse_number": "५-३९-१", "content_sanskrit": "अनीश्वरोऽयं पुरुषो भवाभवे\nसूत्रप्रोता दारुमयीव योषा।\nधात्रा तु दिष्टस्य वशे कृतोऽयं\nतस्माद्वद त्वं श्रवणे धृतोऽहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2036731, "chapter_id": 1794, "verse_number": "५-३९-२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2036732, "chapter_id": 1794, "verse_number": "५-३९-२", "content_sanskrit": "अप्राप्तकालं वचनं बृहस्पतिरपि ब्रुवन्।\nलभते बुध्द्यवज्ञानमवमानं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2036733, "chapter_id": 1794, "verse_number": "५-३९-३", "content_sanskrit": "प्रियो भवति दानेन प्रियवादेन चापरः ।\nमन्त्रमूलबलेनान्यो यः प्रियः प्रिय एव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2036734, "chapter_id": 1794, "verse_number": "५-३९-४", "content_sanskrit": "द्वेष्यो न साधुर्भवति न मेधावी न पण्डितः।\nप्रिये शुभानि कार्याणि द्वेष्ये पापानि चैव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2036735, "chapter_id": 1794, "verse_number": "५-३९-५", "content_sanskrit": "उक्तं मया जातमात्रेऽपि राजन्\nदुर्योधनं त्यज पुत्रं त्वमेकम्।\nतस्य त्यागात्पुत्रशतस्य वृद्धि-\nरस्यात्यागात्पुत्रशतस्य नाशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2036736, "chapter_id": 1794, "verse_number": "५-३९-६", "content_sanskrit": "न वृद्धिर्बहुमन्तव्या या वृद्धिः क्षयमावहेत्।\nक्षयोऽपि बहुमन्तव्यो यः क्षयो वृद्धिमावहेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2036737, "chapter_id": 1794, "verse_number": "५-३९-७", "content_sanskrit": "न स क्षयो महाराज यः क्षयो वृद्धिमावहेत्।\nक्षयः स त्विह मन्तव्यो यं लब्ध्वा बहु नाशयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2036738, "chapter_id": 1794, "verse_number": "५-३९-८", "content_sanskrit": "समृद्धा गुणतः केचिद्भवन्ति धनतोऽपरे।\nधनवृद्धान्गुणैर्हीनान्धृतराष्ट्र विवर्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2036739, "chapter_id": 1794, "verse_number": "५-३९-९x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2036740, "chapter_id": 1794, "verse_number": "५-३९-९", "content_sanskrit": "सर्वं त्वमायतीयुक्तं भाषसे प्राज्ञसंमतम्।\nन चोत्सहे सुतं त्यक्तुं यतो धर्मस्ततो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2036741, "chapter_id": 1794, "verse_number": "५-३९-१०x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2036742, "chapter_id": 1794, "verse_number": "५-३९-१०", "content_sanskrit": "अतीव गुणसंपन्नो न जातुः विनयान्वितः।\nसुसूक्ष्ममपि भूतानामुपमर्दमुपेक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2036743, "chapter_id": 1794, "verse_number": "५-३९-११", "content_sanskrit": "परापवादनिरताः परदुःखोदयेषु च।\nपरस्परविरोधे च यतन्ते सततोत्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2036744, "chapter_id": 1794, "verse_number": "५-३९-१२", "content_sanskrit": "सदोषं दर्शनं येषां संवासे सुमहद्भयम्।\nअर्थादाने महान्दोषः प्रदाने च महद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2036745, "chapter_id": 1794, "verse_number": "५-३९-१३", "content_sanskrit": "ये वै भेदनशीलास्तु सकामा निस्त्रपाः शठाः।\nये पापा इति विख्याताः संवासे पिरिगर्हिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2036746, "chapter_id": 1794, "verse_number": "५-३९-१४", "content_sanskrit": "युक्ताश्चान्यैर्महादोषैर्ये नरास्तान्विवर्जयेत्।\nनिवर्तमाने सौहार्दे प्रीतिर्नीचे प्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2036747, "chapter_id": 1794, "verse_number": "५-३९-१५", "content_sanskrit": "या चैव फलनिर्वृतिः सौहृदे चैव यत्सुखम् ।\nयतते चापवादाय यत्नमारभते क्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2036748, "chapter_id": 1794, "verse_number": "५-३९-१६", "content_sanskrit": "अल्पेऽप्यपकृते मोहान्न शान्तिमधिगच्छति।\nतादृशैः सङ्गतं नीचैर्नृशंसैरकृतात्मभिः ।\nनिशाम्य निपुणं बुद्ध्या विद्वान्दूराद्विवर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2036749, "chapter_id": 1794, "verse_number": "५-३९-१७", "content_sanskrit": "यो ज्ञातिमनुगृह्णाति दरिद्रं दीनमातुरम्।\nस पुत्रपशुभिर्वृद्धिं श्रेयश्चानन्त्यमश्रुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2036750, "chapter_id": 1794, "verse_number": "५-३९-१८", "content_sanskrit": "ज्ञातयो वर्धनीयास्तैर्य इच्छन्त्यात्मनः शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2036751, "chapter_id": 1794, "verse_number": "५-३९-१९", "content_sanskrit": "कुलवृद्धिं च राजेन्द्र तस्मात्साधु समाचरं।\nश्रेयसा योक्ष्यते राजन्कुर्वाणो ज्ञातिसत्क्रियां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2036752, "chapter_id": 1794, "verse_number": "५-३९-२०", "content_sanskrit": "विगुणा ह्यपि संरक्ष्या ज्ञातयो भरतर्षभ ।\nकिंपुनर्गुणवन्तस्ते त्वत्प्रसादाभिकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2036753, "chapter_id": 1794, "verse_number": "५-३९-२१", "content_sanskrit": "प्रसादं कुरु वीराणां पाण्डवानां विशांपते।\nदीयतां ग्रामकाः केचित्तेषां वृत्त्यर्थमीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2036754, "chapter_id": 1794, "verse_number": "५-३९-२२", "content_sanskrit": "एवं लोके यशः प्राप्तं भविष्यति नराधिप।\nवृद्धेन हि त्वया कार्यं पुत्राणां तात शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2036755, "chapter_id": 1794, "verse_number": "५-३९-२३", "content_sanskrit": "मया चापि हितं वाच्यं विद्धि मां त्वद्धितैषिणम्।\nज्ञातिभिर्विग्रहस्तात न कर्तव्यः शुभार्थिना।\nसुखानि सह भोज्यानि ज्ञातिभिर्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2036756, "chapter_id": 1794, "verse_number": "५-३९-२४", "content_sanskrit": "संभोजनं संकथनं संप्रीतिश्च परस्परम् ।\nज्ञातिभिः सह कार्याणि न विरोधः कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2036757, "chapter_id": 1794, "verse_number": "५-३९-२५", "content_sanskrit": "ज्ञातयस्तारयन्तीह ज्ञातयो मञ्जयन्ति च।\nसुवृत्तास्तारयन्तीह दुर्वृत्ता मञ्जयन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2036758, "chapter_id": 1794, "verse_number": "५-३९-२६", "content_sanskrit": "सुवृत्तो भव राजेन्द्र पाण्जवान्प्रति मानद।\nअधर्षणीयः शत्रूणां तैर्वृतस्त्वं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2036759, "chapter_id": 1794, "verse_number": "५-३९-२७", "content_sanskrit": "श्रीमन्तं ज्ञातिमासाद्य यो ज्ञातिरवसीदति ।\nदिग्धहस्तं मृग इव स एनस्तस्य विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2036760, "chapter_id": 1794, "verse_number": "५-३९-२८", "content_sanskrit": "पश्चादपि नरश्रेष्ठ तव तापो भविष्यति ।\nतान्वा हतान्सुतान्वापि श्रुत्वा तदनुचिन्तय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2036761, "chapter_id": 1794, "verse_number": "५-३९-२९", "content_sanskrit": "येन खट्वां समारूढः परितप्येत कर्मणा ।\nआदावेन न तत्कुर्यादध्रुवे जीविते सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2036762, "chapter_id": 1794, "verse_number": "५-३९-३०", "content_sanskrit": "न कश्चिन्नापनयते पुमानन्यत्र भार्गवात् ।\nशेषसंप्रतिपत्तिस्तु बुद्धिमत्स्वेव तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2036763, "chapter_id": 1794, "verse_number": "५-३९-३१", "content_sanskrit": "दुर्योधनेन यद्येतत्पापं तेषु पुरा कृतम् ।\nत्वया तत्कुलवृद्धेन प्रत्यानेयं नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2036764, "chapter_id": 1794, "verse_number": "५-३९-३२", "content_sanskrit": "तांस्त्वं पदे प्रतिष्ठाप्य लोके विगतकल्मषः ।\nभविष्यसि नरश्रेष्ठ पूजनीयो मनीषिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2036765, "chapter_id": 1794, "verse_number": "५-३९-३३", "content_sanskrit": "सुव्याहृतानि धीराणां फलतः परिचिन्त्य यः।\nअध्यवस्यति कार्येषु चिरं यशसि तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2036766, "chapter_id": 1794, "verse_number": "५-३९-३४", "content_sanskrit": "असम्यगुपयुक्तं हि ज्ञानं सुकुशलैरपि ।\nउपलभ्यं चाविदितं विदितं चाननुष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2036767, "chapter_id": 1794, "verse_number": "५-३९-३५", "content_sanskrit": "पापोदयफलं विद्वान्यो नारभति वर्धते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2036768, "chapter_id": 1794, "verse_number": "५-३९-३६", "content_sanskrit": "यस्तु पूर्वकृतं पापमविमृश्यानुवर्तते ।\nअगाधपङ्के दुर्मेधा विषमे विनिपात्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2036769, "chapter_id": 1794, "verse_number": "५-३९-३७", "content_sanskrit": "मन्त्रभेदस्य षट् प्राज्ञो द्वाराणीमानि लक्षयेत्।\nअर्थसन्ततिकामश्च रक्षेदेतानि नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2036770, "chapter_id": 1794, "verse_number": "५-३९-३८", "content_sanskrit": "मदं स्वप्नपविज्ञानमाकारं चात्मसंभवम् ।\nदुष्टामात्येषु विश्रम्भं दूताच्चाकुशलादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2036771, "chapter_id": 1794, "verse_number": "५-३९-३९", "content_sanskrit": "द्वाराण्येतानि यो ज्ञात्वा संवृणोति सदा नृप।\nत्रिवर्गाचरणे युक्तः स शत्रूनधितिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2036772, "chapter_id": 1794, "verse_number": "५-३९-४०", "content_sanskrit": "नवै श्रुतमविज्ञाय वृद्धाननुपसेव्य वा।\nधर्मार्थौ वेदुतुं शक्यौ बृहस्पतिसमैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2036773, "chapter_id": 1794, "verse_number": "५-३९-४१", "content_sanskrit": "नष्टं समुद्रे पतितं नष्टं वाक्यमशृण्वति।\nअनात्मनि श्रुतं नष्टं नष्टं हुतमनग्निकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2036774, "chapter_id": 1794, "verse_number": "५-३९-४२", "content_sanskrit": "मत्या परीक्ष्य मेधावी बुद्ध्या संपाद्य चासकृत्।\nश्रुत्वा दृष्ट्वाथ विज्ञाय प्राज्ञैर्मैत्रीं समाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2036775, "chapter_id": 1794, "verse_number": "५-३९-४३", "content_sanskrit": "अकीर्ति विनयो हन्ति हन्त्यनर्थं पराक्रमः ।\nहन्ति नित्यं क्षमा क्रोधमाचारो हन्त्यलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2036776, "chapter_id": 1794, "verse_number": "५-३९-४४", "content_sanskrit": "परिच्छदेन क्षेत्रेण वेश्मना परिचर्यया।\nपरीक्षेत कुलं राजन्भोजनाच्छादनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2036777, "chapter_id": 1794, "verse_number": "५-३९-४५", "content_sanskrit": "उपस्थितसय कामस्य प्रतिवादो न विद्यते।\nअपि निर्मुक्तदेहस्य कामरक्तस्य किं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2036778, "chapter_id": 1794, "verse_number": "५-३९-४६", "content_sanskrit": "प्राज्ञोपसेविनं वैद्यं धार्मिकं प्रियदर्शनम् ।\nमित्रवन्तं सुवाक्यं च सुहृदं परिपालयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2036779, "chapter_id": 1794, "verse_number": "५-३९-४७", "content_sanskrit": "दुष्कुलीनः कुलीनो वा मर्यादां यो न लङ्घयेत्।\nधर्मापेक्षी मृदुर्ह्रीमान्स कुलीनशताद्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2036780, "chapter_id": 1794, "verse_number": "५-३९-४८", "content_sanskrit": "ययोश्चित्तेन वा चित्तं निभृतं निभृतेन वा।\nसमेति प्रज्ञया प्रज्ञा तयोर्मैत्री न जीर्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2036781, "chapter_id": 1794, "verse_number": "५-३९-४९", "content_sanskrit": "दुर्बुद्धिमकृतप्रज्ञं छन्नं कूपं तृणैरिव।\nविवर्जयीत मेधावी तस्मिन्मैत्री प्रणश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2036782, "chapter_id": 1794, "verse_number": "५-३९-५०", "content_sanskrit": "अवलिप्तेषु मूर्खेषु रौद्रसाहसिकेषु च।\nतथैवापेतधर्मेषु न मैत्रीमाचरेद्बुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2036783, "chapter_id": 1794, "verse_number": "५-३९-५१", "content_sanskrit": "कृतज्ञं धार्मिकं सत्यमक्षुद्रं दृढभक्तिकम् ।\nजितेन्द्रियं स्थितं स्थित्यां मित्रमित्यभिवाञ्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2036784, "chapter_id": 1794, "verse_number": "५-३९-५२", "content_sanskrit": "इन्द्रियाणामनुत्सर्गो मृत्युनापि विशिष्यते।\nअत्यर्थं पुनरुत्सर्गः सादयेद्दैवतानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2036785, "chapter_id": 1794, "verse_number": "५-३९-५३", "content_sanskrit": "मार्दवं सर्वभूतानामनसूया क्षमा धृतिः।\nआयुष्याणि बुधाः प्राहुर्मित्राणां चाविमानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2036786, "chapter_id": 1794, "verse_number": "५-३९-५४", "content_sanskrit": "अपनीतं सुनीतेन योऽर्थं प्रत्यानिनीपते ।\nमतिमास्थाय सुदृढां तदकापुरुषव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2036787, "chapter_id": 1794, "verse_number": "५-३९-५५", "content_sanskrit": "आयत्यां प्रतिकारज्ञस्तदात्वे दृढनिश्चयः ।\nअतीते कार्यशेषज्ञो नरोऽर्थैर्न प्रहीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2036788, "chapter_id": 1794, "verse_number": "५-३९-५६", "content_sanskrit": "कर्मणा मनसा वाचा यदभीक्ष्णं निषेवते ।\nतदेवापहरत्येनं तस्मात्कल्याणमाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2036789, "chapter_id": 1794, "verse_number": "५-३९-५७", "content_sanskrit": "मङ्गलालम्भनं योगः श्रुतमुत्थानमार्जवम्।\nभूतिमेतानि कुर्वन्ति सतां चाभीक्ष्णदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2036790, "chapter_id": 1794, "verse_number": "५-३९-५८", "content_sanskrit": "अनिर्वेदः श्रियो मूलं लाभस्य च शुभस्य च।\nमहान्भवत्यनिर्विष्णः सुखं चानन्त्यमश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2036791, "chapter_id": 1794, "verse_number": "५-३९-५९", "content_sanskrit": "नातः श्रीमत्तरं किंचिदन्यत्पथ्यतमं मतम्।\nप्रभविष्णोर्यथा तात क्षमा सर्वत्र सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2036792, "chapter_id": 1794, "verse_number": "५-३९-६०", "content_sanskrit": "क्षमेदशक्तः सर्वस्य शक्तिमान्धर्मकारणात्।\nअर्थानर्थौ समौ यस्य तस्य नित्यं क्षमा हिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2036793, "chapter_id": 1794, "verse_number": "५-३९-६१", "content_sanskrit": "यत्सुखं सेवमानोऽपि धर्मार्थाभ्यां न हीयते।\nकामं तदुपसेवेत न मूढव्रतमाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2036794, "chapter_id": 1794, "verse_number": "५-३९-६२", "content_sanskrit": "दुःखार्तेषु प्रमत्तेषु नास्तिकेष्वलसेषु च।\nन श्रीर्वसत्यदान्तेषु ये चोत्साहविवर्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2036795, "chapter_id": 1794, "verse_number": "५-३९-६३", "content_sanskrit": "आर्जवेन नरं युक्तमार्जवात्सव्यपत्रपम्।\nअशक्तं मन्यमानास्तु धर्षयन्ति कुबुद्धयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2036796, "chapter_id": 1794, "verse_number": "५-३९-६४", "content_sanskrit": "अत्यार्यमतिदातारमतिशूरमतिव्रतम् ।\nप्रज्ञाभिमानिनं चैव श्रीर्भयान्नोपसर्पति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2036797, "chapter_id": 1794, "verse_number": "५-३९-६५", "content_sanskrit": "न चातिगुणवत्स्वेषा नात्यन्तं निर्गुणेषु च।\nनेषा गुणान्कामयते नैर्गुण्यान्नानुरज्यते।\nउन्मत्ता गौरिवान्धा श्रीः क्वचिदेवावतिष्ठते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2036798, "chapter_id": 1794, "verse_number": "५-३९-६६", "content_sanskrit": "अग्निहोत्रफला वेदाः शीलवृत्तफलं श्रुतम्।\nरतिपुत्रफला नारी दत्तभुक्तफलं धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2036799, "chapter_id": 1794, "verse_number": "५-३९-६७", "content_sanskrit": "अधर्मोपार्जितैरर्थैर्यः करोत्यौर्ध्वदेहिकम्।\nन स तस्य फलं प्रेत्य भुङ्क्तेऽर्थस्य दुरागमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2036800, "chapter_id": 1794, "verse_number": "५-३९-६८", "content_sanskrit": "कान्तारे वनदुर्गेषु कृच्छ्रास्वापत्सु संभ्रमे।\nउद्यतेषु च शस्त्रेषु नास्ति सत्ववतां भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2036801, "chapter_id": 1794, "verse_number": "५-३९-६९", "content_sanskrit": "उत्थानं संयमो दाक्ष्यमप्रमादो धृतिः स्मृतिः ।\nसमीक्ष्य च समारम्भो विद्धि मूलं भवस्य तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2036802, "chapter_id": 1794, "verse_number": "५-३९-७०", "content_sanskrit": "तपो बलं तापमानां ब्रह्म ब्रह्मविदां बलम् ।\nहिंसा बलमसाधूनां क्षमा गुणवतां बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2036803, "chapter_id": 1794, "verse_number": "५-३९-७१", "content_sanskrit": "अष्टौ तान्यव्रतघ्नानि आपो मूलं फलं पयः।\nहविर्ब्राह्मणकाम्या च गुरोर्वचनमौषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2036804, "chapter_id": 1794, "verse_number": "५-३९-७२", "content_sanskrit": "न तत्परस्य सन्दध्यात्प्रतिकूलं यदात्मनः।\nसङ्ग्रहेणैव धर्मः स्यात्कामादन्यः प्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2036805, "chapter_id": 1794, "verse_number": "५-३९-७३", "content_sanskrit": "अक्रोधेन जयेत्क्रोधमसाधुं नाधुना जयेत्।\nजयेत्कदर्यं दानेन जयेन्मत्येन चानृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2036806, "chapter_id": 1794, "verse_number": "५-३९-७४", "content_sanskrit": "स्त्रीधूर्तकेऽलसे भीरौ चण्डे पुरुषमानिनि।\nचोरे कृतघ्ने विश्वासो न कार्यो न च नास्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2036807, "chapter_id": 1794, "verse_number": "५-३९-७५", "content_sanskrit": "अभिवादनशीलप्य नित्यं वृद्धोपसेविनः ।\nचत्वारि संप्रवर्धन्ते कीर्तिरापुर्यशो बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2036808, "chapter_id": 1794, "verse_number": "५-३९-७६", "content_sanskrit": "अतिक्लेशेन येऽथोः स्वधर्मस्यानिक्रमेण वा।\nअरेर्वा प्रणिपातेन मा .. तेषु मनः कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2036809, "chapter_id": 1794, "verse_number": "५-३९-७७", "content_sanskrit": "अविद्यः पुरुषः शोच्यः शोच्यं मैथुनमप्रजम्।\nनिराहाराः प्रजाः शोच्याः शोच्यं राष्ट्रमराजकं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2036810, "chapter_id": 1794, "verse_number": "५-३९-७८", "content_sanskrit": "अध्वा जरा देहवतां पर्वतानां जलं जरा।\nअसंभोगो जरा स्त्रीणां वाक्छल्यं मनसो जरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2036811, "chapter_id": 1794, "verse_number": "५-३९-७९", "content_sanskrit": "अनाम्नायमला वेदा ब्राह्मणस्याव्रतं मलम्।\nमलं पृथिव्या वाह्लीकाः पुरुषस्यानृतं मलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2036812, "chapter_id": 1794, "verse_number": "५-३९-८०", "content_sanskrit": "कौतूहलमला साध्वी विप्रवासमलाः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2036813, "chapter_id": 1794, "verse_number": "५-३९-८१", "content_sanskrit": "सुवर्णस्य मलं रूप्यं रूप्यस्यापि मलं त्रपु।\nज्ञेयं त्रपुमलं सीमं सीसस्यापि मलं मलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2036814, "chapter_id": 1794, "verse_number": "५-३९-८२", "content_sanskrit": "न स्वप्नेन जयेन्निद्रां न कामेन जयेत्स्त्रियः।\nनेन्धनेन जयेदग्निं न पानेन सुरां जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2036815, "chapter_id": 1794, "verse_number": "५-३९-८३", "content_sanskrit": "यस्य दानजितं मित्रं शत्रवो युधि निर्जिताः ।\nअन्नपानजिता दाराः सफलं तस्य जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2036816, "chapter_id": 1794, "verse_number": "५-३९-८४", "content_sanskrit": "सहस्रिणोऽपि जीवन्ति जीवन्ति शतिनस्तथा ।\nधृतराष्ट्र विमुञ्चेच्छां न कथञ्चिन्न जीव्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2036817, "chapter_id": 1794, "verse_number": "५-३९-८५", "content_sanskrit": "यत्पृथिव्यां व्रीहियवं हिरण्यं पशवः स्त्रियः ।\nनालमेकस्य तत्सर्वमिति पश्यन्न मुह्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2036818, "chapter_id": 1794, "verse_number": "५-३९-८६", "content_sanskrit": "राजन्भूयो ब्रवीमि त्वां पुत्रेषु सममाचर।\nसमता यदि ते राजन्स्वेषु पाण्डुसुतेषु वा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2036819, "chapter_id": 1794, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि प्रजागरपर्वणि एकोनचत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]