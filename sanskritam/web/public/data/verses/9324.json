[{"id": 40019972, "chapter_id": 9324, "verse_number": "1", "content_sanskrit": "सुकेशं धार्मिकं दृष्ट्वा वरलब्धं च राक्षसम् । ग्रामणीर्नाम गन्धर्वो विश्वावसुसमप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019973, "chapter_id": 9324, "verse_number": "2", "content_sanskrit": "तस्य देववती नाम द्वितीया श्रीरिवात्मजा । त्रिषु लोकेषु विख्याता रूपयौवनशालिनी । तां सुकेशाय धर्मेण ददौ रक्षःश्रियं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019974, "chapter_id": 9324, "verse_number": "3", "content_sanskrit": "वरदानकृतैश्वर्यं सा तं प्राप्य पतिं प्रियम् । आसीद्देववती तुष्टा धनं प्राप्येव निर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019975, "chapter_id": 9324, "verse_number": "4", "content_sanskrit": "स तया सह संयुक्तो रराज रजनीचरः । अञ्जनादभिनिष्क्रान्तः करेण्वेव महागजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019976, "chapter_id": 9324, "verse_number": "5", "content_sanskrit": "देववत्यां सुकेशस्तु जनयामास राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019977, "chapter_id": 9324, "verse_number": "6", "content_sanskrit": "त्रीन् पुत्रान् जनयामास त्रेताग्निसमविग्रहान् । माल्यवन्तं सुमालिं च मालिं च बलिनां वरम् । त्रींस्त्रिनेत्रसमान्पुत्रान्राक्षसान्राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019978, "chapter_id": 9324, "verse_number": "7", "content_sanskrit": "त्रयो लोका इवाव्यग्राः स्थितास्त्रय इवाग्नयः । त्रयो मन्त्रा इवात्युग्रास्त्रयो घोरा इवामयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019979, "chapter_id": 9324, "verse_number": "8", "content_sanskrit": "त्रयः सुकेशस्य सुतास्त्रेताग्निसमतेजसः । विवृद्धिमगमंस्तत्र व्याधयोपेक्षिता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019980, "chapter_id": 9324, "verse_number": "9", "content_sanskrit": "वरप्राप्तिं पितुस्ते तु ज्ञात्वेश्वरतपोबलात् । तपस्तप्तुं गता मेरुं भ्रातरः कृतनिश्चयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019981, "chapter_id": 9324, "verse_number": "10", "content_sanskrit": "प्रगृह्य नियमान्घोरान्राक्षसा नृपसत्तम । विचेरुस्ते तपो घोरं सर्वभूतभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019982, "chapter_id": 9324, "verse_number": "11", "content_sanskrit": "सत्यार्जवशमोपेतैस्तपोभिरतिदुष्करैः । सन्तापयन्तस्त्रील्लोँकान्सदेवासुरमानुषान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019983, "chapter_id": 9324, "verse_number": "12", "content_sanskrit": "ततो विभुश्चतुर्वक्त्रो विमानवरमास्थितः । सुकेशपुत्रानामन्त्र्य वरदो ऽस्मीत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019984, "chapter_id": 9324, "verse_number": "13", "content_sanskrit": "ब्रह्माणं वरदं ज्ञात्वा सेन्द्रैर्देवगणैर्वृतम् । ऊचुः प्राञ्जलयः सर्वे वेपमाना इव द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019985, "chapter_id": 9324, "verse_number": "14", "content_sanskrit": "तपसाराधितो देव यदि नो दिशसे वरम् । अजेयाः शत्रुहन्तारस्तथैव चिरजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019986, "chapter_id": 9324, "verse_number": "15", "content_sanskrit": "प्रभविष्ण्वो भवामेति परस्परमनुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019987, "chapter_id": 9324, "verse_number": "16", "content_sanskrit": "एवं भविष्यतीत्युक्त्वा सुकेशतनयान्विभुः । स ययौ ब्रह्मलोकाय ब्रह्मा ब्राह्मणवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019988, "chapter_id": 9324, "verse_number": "17", "content_sanskrit": "वरं लब्ध्वा तु ते सर्वे राम रात्रिञ्चरास्तदा । सुरासुरान्प्रबाधन्ते वरदानसुनिर्भयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019989, "chapter_id": 9324, "verse_number": "18", "content_sanskrit": "तैर्वध्यमानास्त्रिदशाः सर्षिसङ्घाः सचारणाः । त्रातारं नाधिगच्छन्ति निरयस्था यथा नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019990, "chapter_id": 9324, "verse_number": "19", "content_sanskrit": "अथ ते विश्वकर्माणं शिल्पिनां वरमव्ययम् । ऊचुः समेत्य संहृष्टा राक्षसा रघुसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019991, "chapter_id": 9324, "verse_number": "20", "content_sanskrit": "ओजस्तेजोबलवतां महतामात्मतेजसा । गृहकर्ता भवानेव देवानां हृदयेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019992, "chapter_id": 9324, "verse_number": "21", "content_sanskrit": "अस्माकमपि तावत्त्वं गृहं कुरु महामते । हिमवन्तमपाश्रित्य मेरुमन्दरमेव वा । महेश्वरगृहप्रख्यं गृहं नः क्रियतां महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019993, "chapter_id": 9324, "verse_number": "22", "content_sanskrit": "विश्वकर्मा ततस्तेषां राक्षसानां महाभुजः । निवासं कथयामास शक्रस्येवामरावतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019994, "chapter_id": 9324, "verse_number": "23", "content_sanskrit": "दक्षिणस्योदधेस्तीरे त्रिकूटो नाम पर्वतः । सुवेल इति चाप्यन्यो द्वितीयस्तत्र सत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40019995, "chapter_id": 9324, "verse_number": "24", "content_sanskrit": "शिखरे तस्य शैलस्य मध्यमे ऽम्बुदसन्निभे । शकुनैरपि दुष्प्रापे टङ्कच्छिन्नचतुर्दिशि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40019996, "chapter_id": 9324, "verse_number": "25", "content_sanskrit": "त्रिंशद्योजनक्स्तीर्णा शतयोजनमायता । स्वर्णप्राकारसंवीता हेमतोरणसंवृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40019997, "chapter_id": 9324, "verse_number": "26", "content_sanskrit": "मया लङ्केति नगरी शक्राज्ञप्तेन निर्मिता । तस्यां वसत दुर्धर्षा यूयं राक्षसपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40019998, "chapter_id": 9324, "verse_number": "27", "content_sanskrit": "अमरावतीं समासाद्य सेन्द्रा इव दिवौकसः । लङ्कादुर्गं समासाद्य राक्षसैर्बहुभिर्वृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40019999, "chapter_id": 9324, "verse_number": "28", "content_sanskrit": "भविष्यथ दुराधर्षाः शत्रूणां शत्रुसूदनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020000, "chapter_id": 9324, "verse_number": "29", "content_sanskrit": "विश्वकर्मवचः श्रुत्वा ततस्ते राक्षसोत्तमाः । सहस्रानुचरा भूत्वा गत्वा तामवसन्पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020001, "chapter_id": 9324, "verse_number": "30", "content_sanskrit": "दृढप्राकारपरिखां हैमैर्गृहशतैर्वृताम् । लङ्कामवाप्य ते हृष्टा न्यवसन्रजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020002, "chapter_id": 9324, "verse_number": "31", "content_sanskrit": "एतस्मिन्नेव काले तु यथाकामं च राघव । नर्मदा नाम गन्धर्वी बभूव रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020003, "chapter_id": 9324, "verse_number": "32", "content_sanskrit": "तस्याः कान्यात्रयं ह्यासीत् धीश्रीकिर्तिसमद्युति । ज्येष्ठक्रमेण सा तेषां राक्षसानामराक्षसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020004, "chapter_id": 9324, "verse_number": "33", "content_sanskrit": "कन्यास्ताः प्रददौ हृष्टा पूर्णचन्द्रनिभाननाः । त्रयाणां राक्षसेन्द्राणां तिस्रो गन्धर्वकन्यकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020005, "chapter_id": 9324, "verse_number": "34", "content_sanskrit": "दत्ता मात्रा महाभागा नक्षत्रे भगदैवते । कुतदारास्तु ते राम सुकेशतनयास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020006, "chapter_id": 9324, "verse_number": "35", "content_sanskrit": "चिक्रीडुः सह भार्याभिरप्सरोभिरिवामराः । ततो माल्यवतो भार्या सुन्दरी नाम सुन्दरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020007, "chapter_id": 9324, "verse_number": "36", "content_sanskrit": "स तस्यां जनयामास यदपत्यं निबोध तत् । वज्रमुष्टिर्विरूपाक्षोदुर्मुखश्चैव राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020008, "chapter_id": 9324, "verse_number": "37", "content_sanskrit": "सुप्तघ्नो यज्ञकोपश्च मत्तोन्मत्तौ तथैव च । अनला चाभवत्कन्या सुन्दर्यां राम सुन्दरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020009, "chapter_id": 9324, "verse_number": "38", "content_sanskrit": "सुमालिनो ऽपि भार्यासीत्पूर्णचद्रनिभानना । नाम्ना केतुमती राम प्राणेभ्यो ऽपि गरीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020010, "chapter_id": 9324, "verse_number": "39", "content_sanskrit": "सुमाली जनयामास यदपत्यं निशाचरः । केतुमत्यां महाराज तन्निबोधानुपूर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020011, "chapter_id": 9324, "verse_number": "40", "content_sanskrit": "प्रहस्तो ऽकम्पनश्चैव विकटः कालकार्मुखः । धूम्राक्षश्चैव दण्डश्च सुपार्श्वश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020012, "chapter_id": 9324, "verse_number": "41", "content_sanskrit": "संह्रादिः प्रघसश्चैव भासकर्णश्च राक्षसः । राका पुष्पोत्कटा चैव कैकसी च शुचिस्मिता ।। कुम्भीनसी च इत्येते सुमालेः प्रसवाः स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020013, "chapter_id": 9324, "verse_number": "42", "content_sanskrit": "कुम्भीनसी च इत्येते सुमालेः प्रसवाः स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020014, "chapter_id": 9324, "verse_number": "43", "content_sanskrit": "मालेस्तु वसुधा नाम गन्धर्वी रूपशालिनी । भार्यासीत्पद्मपत्राक्षी स्वक्षी यक्षीवरोपमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020015, "chapter_id": 9324, "verse_number": "44", "content_sanskrit": "सुमालेरनुजस्तस्यां जनयामास यत् प्रभो । अपत्यं कथ्यमानं तु मया त्वं शृणु राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40020016, "chapter_id": 9324, "verse_number": "45", "content_sanskrit": "अनिलश्चानलश्चैव हरः सम्पातिरेव च । एते विभीषणामात्या मालेयास्तु निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40020017, "chapter_id": 9324, "verse_number": "46", "content_sanskrit": "ततस्तु ते राक्षसपुङ्गवास्त्रयो निशाचरैः पुत्रशतैश्च संवृताः । सुरान्सहेन्द्रानृषिनागयक्षान्बबाधिरे तान्बहुवीर्यदर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 40020018, "chapter_id": 9324, "verse_number": "47", "content_sanskrit": "जगद्भ्रमन्तो ऽनिलवद्दुरासदा रणेषु मृत्युप्रतिमानतेजसः । वरप्रदानादतिगर्विता भृशं क्रतुक्रियाणां प्रशमङ्कराः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]