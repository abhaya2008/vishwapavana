[{"id": 5000324000, "chapter_id": 9324, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे द्विपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000324001, "chapter_id": 9324, "verse_number": "४-५२-१", "content_sanskrit": "अथ तानब्रवीत् सर्वान् विश्रान्तान् हरियूथपान्।\nइदं वचनमेकाग्रा तापसी धर्मचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000324002, "chapter_id": 9324, "verse_number": "४-५२-२", "content_sanskrit": "वानरा यदि वः खेदः प्रणष्टः फलभक्षणात्।\nयदि चैतन्मया श्राव्यं श्रोतुमिच्छामि तां कथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000324003, "chapter_id": 9324, "verse_number": "४-५२-३", "content_sanskrit": "तस्यास्तद् वचनं श्रुत्वा हनूमान् मारुतात्मजः।\nआर्जवेन यथातत्त्वमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000324004, "chapter_id": 9324, "verse_number": "४-५२-४", "content_sanskrit": "राजा सर्वस्य लोकस्य महेन्द्रवरुणोपमः।\nरामो दाशरथिः श्रीमान् प्रविष्टो दण्डकावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000324005, "chapter_id": 9324, "verse_number": "४-५२-५", "content_sanskrit": "लक्ष्मणेन सह भ्रात्रा वैदेह्या सह भार्यया।\nतस्य भार्या जनस्थानाद् रावणेन हृता बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000324006, "chapter_id": 9324, "verse_number": "४-५२-६", "content_sanskrit": "वीरस्तस्य सखा राज्ञः सुग्रीवो नाम वानरः।\nराजा वानरमुख्यानां येन प्रस्थापिता वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000324007, "chapter_id": 9324, "verse_number": "४-५२-७", "content_sanskrit": "अगस्त्यचरितामाशां दक्षिणां यमरक्षिताम्।\nसहैभिर्वानरैर्मुख्यैरङ्गदप्रमुखैर्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000324008, "chapter_id": 9324, "verse_number": "४-५२-८", "content_sanskrit": "रावणं सहिताः सर्वे राक्षसं कामरूपिणम्।\nसीतया सह वैदेह्या मार्गध्वमिति चोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000324009, "chapter_id": 9324, "verse_number": "४-५२-९", "content_sanskrit": "विचित्य तु वनं सर्वं समुद्रं दक्षिणां दिशम्।\nवयं बुभुक्षिताः सर्वे वृक्षमूलमुपाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000324010, "chapter_id": 9324, "verse_number": "४-५२-१०", "content_sanskrit": "विवर्णवदनाः सर्वे सर्वे ध्यानपरायणाः।\nनाधिगच्छामहे पारं मग्नाश्चिन्तामहार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000324011, "chapter_id": 9324, "verse_number": "४-५२-११", "content_sanskrit": "चारयन्तस्ततश्चक्षुर्दृष्टवन्तो महद् बिलम्।\nलतापादपसंछन्नं तिमिरेण समावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000324012, "chapter_id": 9324, "verse_number": "४-५२-१२", "content_sanskrit": "अस्माद्धंसा जलक्लिन्नाः पक्षैः सलिलरेणुभिः।\nकुरराः सारसाश्चैव निष्पतन्ति पतत्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000324013, "chapter_id": 9324, "verse_number": "४-५२-१३", "content_sanskrit": "साध्वत्र प्रविशामेति मया तूक्ताः प्लवङ्गमाः।\nतेषामपि हि सर्वेषामनुमानमुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000324014, "chapter_id": 9324, "verse_number": "४-५२-१४", "content_sanskrit": "अस्मिन् निपतिताः सर्वेऽप्यथ कार्यत्वरान्विताः।\nततो गाढं निपतिता गृह्य हस्तैः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000324015, "chapter_id": 9324, "verse_number": "४-५२-१५", "content_sanskrit": "इदं प्रविष्टाः सहसा बिलं तिमिरसंवृतम्।\nएतन्नः कार्यमेतेन कृत्येन वयमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000324016, "chapter_id": 9324, "verse_number": "४-५२-१६", "content_sanskrit": "त्वां चैवोपगताः सर्वे परिद्यूना बुभुक्षिताः।\nआतिथ्यधर्मदत्तानि मूलानि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000324017, "chapter_id": 9324, "verse_number": "४-५२-१७", "content_sanskrit": "अस्माभिरुपयुक्तानि बुभुक्षापरिपीडितैः।\nयत् त्वया रक्षिताः सर्वे म्रियमाणा बुभुक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000324018, "chapter_id": 9324, "verse_number": "४-५२-१८", "content_sanskrit": "ब्रूहि प्रत्युपकारार्थं किं ते कुर्वन्तु वानराः।\nएवमुक्ता तु सर्वज्ञा वानरैस्तैः स्वयंप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000324019, "chapter_id": 9324, "verse_number": "४-५२-१९", "content_sanskrit": "प्रत्युवाच ततः सर्वानिदं वानरयूथपान्।\nसर्वेषां परितुष्टास्मि वानराणां तरस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000324020, "chapter_id": 9324, "verse_number": "४-५२-२०", "content_sanskrit": "चरन्त्या मम धर्मेण न कार्यमिह केनचित्।\nएवमुक्तः शुभं वाक्यं तापस्या धर्मसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000324021, "chapter_id": 9324, "verse_number": "४-५२-२१", "content_sanskrit": "उवाच हनुमान् वाक्यं तामनिन्दितलोचनाम्।\nशरणं त्वां प्रपन्नाः स्मः सर्वे वै धर्मचारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000324022, "chapter_id": 9324, "verse_number": "४-५२-२२", "content_sanskrit": "यः कृतः समयोऽस्मासु सुग्रीवेण महात्मना।\nस तु कालो व्यतिक्रान्तो बिले च परिवर्तताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000324023, "chapter_id": 9324, "verse_number": "४-५२-२३", "content_sanskrit": "सा त्वमस्माद् बिलादस्मानुत्तारयितुमर्हसि।\nतस्मात् सुग्रीववचनादतिक्रान्तान् गतायुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000324024, "chapter_id": 9324, "verse_number": "४-५२-२४", "content_sanskrit": "त्रातुमर्हसि नः सर्वान् सुग्रीवभयशङ्कितान्।\nमहच्च कार्यमस्माभिः कर्तव्यं धर्मचारिणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000324025, "chapter_id": 9324, "verse_number": "४-५२-२५", "content_sanskrit": "तच्चापि न कृतं कार्यमस्माभिरिह वासिभिः।\nएवमुक्ता हनुमता तापसी वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000324026, "chapter_id": 9324, "verse_number": "४-५२-२६", "content_sanskrit": "जीवता दुष्करं मन्ये प्रविष्टेन निवर्तितुम्।\nतपसः सुप्रभावेण नियमोपार्जितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000324027, "chapter_id": 9324, "verse_number": "४-५२-२७", "content_sanskrit": "सर्वानेव बिलादस्मात् तारयिष्यामि वानरान्।\nनिमीलयत चक्षूंषि सर्वे वानरपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000324028, "chapter_id": 9324, "verse_number": "४-५२-२८", "content_sanskrit": "नहि निष्क्रमितुं शक्यमनिमीलितलोचनैः।\nततो निमीलिताः सर्वे सुकुमाराङ्गुलैः करैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000324029, "chapter_id": 9324, "verse_number": "४-५२-२९", "content_sanskrit": "सहसा पिदधुर्दृष्टिं हृष्टा गमनकांक्षया।\nवानरास्तु महात्मानो हस्तरुद्धमुखास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000324030, "chapter_id": 9324, "verse_number": "४-५२-३०", "content_sanskrit": "निमेषान्तरमात्रेण बिलादुत्तारितास्तया।\nउवाच सर्वांस्तांस्तत्र तापसी धर्मचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000324031, "chapter_id": 9324, "verse_number": "४-५२-३१", "content_sanskrit": "निःसृतान् विषमात् तस्मात् समाश्वास्येदमब्रवीत्।\nएष विन्ध्यो गिरिः श्रीमान् नानाद्रुमलतायुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000324032, "chapter_id": 9324, "verse_number": "४-५२-३२", "content_sanskrit": "एष प्रस्रवणः शैलः सागरोऽयं महोदधिः।\nस्वस्ति वोऽस्तु गमिष्यामि भवनं वानरर्षभाः।\nइत्युक्त्वा तद् बिलं श्रीमत् प्रविवेश स्वयंप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000324033, "chapter_id": 9324, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे द्विपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]