[{"id": 6000106000, "chapter_id": 10106, "verse_number": null, "content_sanskrit": "अथ एकादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000106001, "chapter_id": 10106, "verse_number": null, "content_sanskrit": "ब्राह्मण उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.001.m4a", "display_order": 2}, {"id": 6000106002, "chapter_id": 10106, "verse_number": "५-११-१", "content_sanskrit": "अकोविदः कोविदवादवादान्वदस्यथो नातिविदां वरिष्ठः।\nन सूरयो हि व्यवहारमेनं तत्त्वावमर्शेन सहामनन्ति॥ ५/११/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.002.m4a", "display_order": 3, "topics": [{"text": "पुना रहूगणप्रार्थितेन जडभरतेन तस्मै ज्ञानोपदेशः", "range": "१–१७"}]}, {"id": 6000106003, "chapter_id": 10106, "verse_number": "५-११-२", "content_sanskrit": "तथैव राजन्नुरुगार्हमेधवितानविद्योरुविजृम्भितेषु।\nन वेदवादेषु हि तत्त्ववादः प्रायेण शुद्धो नु चकास्ति साधु॥ ५/११/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.003.m4a", "display_order": 4}, {"id": 6000106004, "chapter_id": 10106, "verse_number": "५-११-३", "content_sanskrit": "न तस्य तत्त्वग्रहणाय साक्षाद्वरीयसीरपि वाचः समासन्।\nस्वप्ने निरुक्त्या गृहमेधिसौख्यं न यस्य हेयानुमितं स्वयं स्यात्॥ ५/११/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.004.m4a", "display_order": 5}, {"id": 6000106005, "chapter_id": 10106, "verse_number": "५-११-४", "content_sanskrit": "यावन्मनो रजसा पुरुषस्य सत्त्वेन वा तमसा वानुरुद्धम्।\nचेतोभिराकूतिभिरातनोति निरङ्कुशं कुशलं चेतरं वा॥ ५/११/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.005.m4a", "display_order": 6}, {"id": 6000106006, "chapter_id": 10106, "verse_number": "५-११-५", "content_sanskrit": "स वासनात्मा विषयोपरक्तो गुणप्रवाहो विकृतः षोडशात्मा।\nचित्रं पृथङ्नामभी रूपभेदमन्तर्बहिष्ष्ठः स्वपुरैस्तनोति॥ ५/११/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.006.m4a", "display_order": 7}, {"id": 6000106007, "chapter_id": 10106, "verse_number": "५-११-६", "content_sanskrit": "दुःखं सुखं व्यतिमिश्रं च तीव्रं कालोपपन्नं फलमाव्यनक्ति।\nआलिङ्ग्य मायारचितान्तरात्मा स्वदेहिनं संसृतिचक्रकूटम्॥ ५/११/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.007.m4a", "display_order": 8}, {"id": 6000106008, "chapter_id": 10106, "verse_number": "५-११-७", "content_sanskrit": "तावानयं व्यवहारः सदा वै क्षेत्रज्ञसाक्ष्योर्भवति स्थूलसूक्ष्मः।\nतस्मान्मनो लिङ्गमदो वदन्ति गुणागुणस्यास्य परावरस्य॥ ५/११/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.008.m4a", "display_order": 9}, {"id": 6000106009, "chapter_id": 10106, "verse_number": "५-११-८", "content_sanskrit": "गुणानुरक्तं व्यसनाय जन्तोः, क्षेमाय नैर्गुण्यमथो मनः स्यात्।\nयथा प्रदीपो घृतवर्तिमास्थितो स्थितिं सधूमां भजति ह्यन्यदा स्वम्\nपदं तथा गुणकर्मानुबद्धं बहिर्मनः श्रयतेऽन्यत्र तत्त्वम्॥ ५/११/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.009.m4a", "display_order": 10}, {"id": 6000106010, "chapter_id": 10106, "verse_number": "५-११-९", "content_sanskrit": "एकादशासन्मनसोऽस्य वृत्तीराकूतयः पञ्च धियोऽभिमानाः।\nमात्राणि कर्माणि पुरं च तासां वदन्ति हैकादश वीर भूमिम्॥ ५/११/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.010.m4a", "display_order": 11}, {"id": 6000106011, "chapter_id": 10106, "verse_number": "५-११-१०", "content_sanskrit": "गन्धाकृतिस्पर्शरसश्रवांसि विसर्गगत्यार्त्यभिजल्पशिल्पाः।\nएकादशं स्वीकरणं ममेति मायामहं द्वादशमेकमाहुः॥ ५/११/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.011.m4a", "display_order": 12}, {"id": 6000106012, "chapter_id": 10106, "verse_number": "५-११-११", "content_sanskrit": "द्रव्यस्वभावाशयकर्मकालैरेकादशामी मनसो विकाराः।\nसहस्रशः शतशः कोटिशश्च क्षेत्रज्ञतो, न मिथो न स्वतः स्युः॥ ५/११/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.012.m4a", "display_order": 13}, {"id": 6000106013, "chapter_id": 10106, "verse_number": "५-११-१२", "content_sanskrit": "क्षेत्रज्ञ एता मनसो विभूतीर्जीवस्य मायारचिता अनित्याः।\nआविर्हिताश्चापि तिरोहिताश्च शुद्धो विचष्टे ह्यविशुद्धकर्तुः॥ ५/११/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.013.m4a", "display_order": 14}, {"id": 6000106014, "chapter_id": 10106, "verse_number": "५-११-१३", "content_sanskrit": "क्षेत्रज्ञ आत्मा पुरुषः पुराणः साक्षात्स्वयंज्योतिरजः परेशः।\nनारायणो भगवान्वासुदेवः स्वमाययाऽऽत्मन्व्यवधीयमानः॥ ५/११/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.014.m4a", "display_order": 15}, {"id": 6000106015, "chapter_id": 10106, "verse_number": "५-११-१४", "content_sanskrit": "यथानिलः स्थावरजङ्गमानाम् आत्मस्वरूपेण निविष्ट ईष्टे।\nएवं परो भगवान्वासुदेवः क्षेत्रज्ञ आत्मेदमनुप्रविष्टः॥ ५/११/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.015.m4a", "display_order": 16}, {"id": 6000106016, "chapter_id": 10106, "verse_number": "५-११-१५", "content_sanskrit": "न यावदेतां तनुभृन्नरेन्द्र विधूय मायां वयुनोदयेन।\nविमुक्तसङ्गो जितषट्‌सपत्नो वेदार्थतत्त्वं भ्रमतीह तावत्॥ ५/११/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.016.m4a", "display_order": 17}, {"id": 6000106017, "chapter_id": 10106, "verse_number": "५-११-१६", "content_sanskrit": "न यावदेतन्मन आत्मलिङ्गं संसारतापावपनं जनस्य।\nयच्छोकमोहामयसङ्गलोभवैरानुबन्धं ममतां विधत्ते॥ ५/११/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.017.m4a", "display_order": 18}, {"id": 6000106018, "chapter_id": 10106, "verse_number": "५-११-१७", "content_sanskrit": "भ्रातृव्यमेनं त्वमदभ्रवीर्यम् उपेक्षयाऽप्येधितमप्रमत्तः।\nगुरोर्हरेश्चरणोपासनास्‍त्रो जहि व्यलीकं स्वयमात्ममोहम्॥ ५/११/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_05/adhyaya_011/BhP_05.011.018.m4a", "display_order": 19}, {"id": 6000106019, "chapter_id": 10106, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां पञ्चमस्कन्धे एकादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]