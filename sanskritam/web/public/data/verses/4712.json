[{"id": 2175001, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175002, "chapter_id": 4712, "verse_number": "१", "content_sanskrit": "सप्तसारस्वतं कस्मात् कश्च मङ्कणको मुनिः ।\nकथं सिद्धः स भगवान् कश्चास्य नियमोऽभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175003, "chapter_id": 4712, "verse_number": "२", "content_sanskrit": "कस्य वंशे समुद्भूतः किं वाऽधीतं च वै द्विज ।\nएतन्मे सर्वमाचक्ष्व यथावृत्तं महामुने\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175004, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175005, "chapter_id": 4712, "verse_number": "३", "content_sanskrit": "सप्त नद्यः सरस्वत्यो याभिर्व्याप्तमिदं जगत् ।\nआहूता बलवद्भिस्तु तत्र तत्र सरस्वती\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175006, "chapter_id": 4712, "verse_number": "४", "content_sanskrit": "सुप्रभा काञ्चनाक्षी च विशाला च मनोवृता ।\nसरस्वत्योधमाला च सुवेणिर्विमलोदका\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175007, "chapter_id": 4712, "verse_number": "५", "content_sanskrit": "पितामहस्य महतो वर्तमाने महीपते ।\nवितते यज्ञवाटे वै समेतेषु द्विजातिषु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175008, "chapter_id": 4712, "verse_number": "६", "content_sanskrit": "पुण्याहघोषैर्विमलैर्वेदानां निनदैस्तथा ।\nवेदेषु चैव त्र्यङ्गेषु तस्मिन् यज्ञविधौ ततः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175009, "chapter_id": 4712, "verse_number": "७", "content_sanskrit": "तत्र चैवं महाराज दीक्षिते प्रपितामहे ।\nयजतस्तत्र सत्रेण सर्वकामसमृद्धिना\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175010, "chapter_id": 4712, "verse_number": "८", "content_sanskrit": "मनसा चिन्तिता ह्यर्था धर्मार्थकुशलैस्तदा ।\nउपतिष्ठन्ति राजेन्द्र द्विजातींस्तत्र तत्र ह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175011, "chapter_id": 4712, "verse_number": "९", "content_sanskrit": "जगुश्च तत्र गन्धर्वा ननृतुश्चाप्सरोगणाः ।\nवादित्राणि च दिव्यानि वादयामासुरञ्जसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175012, "chapter_id": 4712, "verse_number": "१०", "content_sanskrit": "तस्य यज्ञस्य सम्पत्त्या तुष्टुवुर्दैवतान्यपि ।\nविस्मयं च परं जग्मुः किमु मानुषयोनयः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175013, "chapter_id": 4712, "verse_number": "११", "content_sanskrit": "वर्तमाने तथा यज्ञे पुष्करस्थे पितामहे ।\nअब्रुवन्नृषयो राजन् नायं यज्ञो महाफलः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175014, "chapter_id": 4712, "verse_number": "१२", "content_sanskrit": "न दृश्यते सरिच्छ्रेष्ठा यस्मादिह सरस्वती\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175015, "chapter_id": 4712, "verse_number": "१३", "content_sanskrit": "तच्छ्रुत्वा भगवान् प्रीतः सस्माराथ सरस्वतीम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175016, "chapter_id": 4712, "verse_number": "१४", "content_sanskrit": "पितामहं मानयन्तीं क्रतुं ते बहु मेनिरे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175017, "chapter_id": 4712, "verse_number": "१५", "content_sanskrit": "एवमेषा सरिच्छ्रेष्ठा पुष्करेषु सरस्वती ।\nपितामहार्थं सम्भूता तुष्ट्यर्थं च मनीषिणाम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175018, "chapter_id": 4712, "verse_number": "१६", "content_sanskrit": "नैमिशे मुनयो राजन् समासाद्य समासते ।\nतत्र चित्राः कथा ह्यासन् वेदं प्रति जनेश्वर\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175019, "chapter_id": 4712, "verse_number": "१७", "content_sanskrit": "यत्र ते मुनयो ह्यासन् नानास्वाध्यायवादिनः ।\nते समागम्य मुनयः सस्मरुर्वै सरस्वतीम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175020, "chapter_id": 4712, "verse_number": "१८", "content_sanskrit": "सा तु ध्याता महाराज ऋषिभिः सत्रयाजिभिः ।\nसमागतानां राजेन्द्र साहाय्यार्थं महात्मनाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175021, "chapter_id": 4712, "verse_number": "१९", "content_sanskrit": "आजगाम महाभागा तत्र पुण्या सरस्वती\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175022, "chapter_id": 4712, "verse_number": "२०", "content_sanskrit": "नैमिशे काञ्चनाक्षी च मुनीनां सत्रयाजिनाम् ।\nआहूता सरितां श्रेष्ठा तत्र भारत पूजिता\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175023, "chapter_id": 4712, "verse_number": "२१", "content_sanskrit": "गयस्य यजमानस्य गयेष्वेव महाक्रतुम् ।\nआहूता सरितां श्रेष्ठा तत्र तेन सरस्वती\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175024, "chapter_id": 4712, "verse_number": "२२", "content_sanskrit": "विशालां तु गयेष्वाहुर्मुनयः संशितव्रताः ।\nसरित् सा हिमवत्पार्श्वात् प्रसूता शीघ्रगामिनी\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175025, "chapter_id": 4712, "verse_number": "२३", "content_sanskrit": "औद्दालकेस्तथा यज्ञं यजतस्तत्र भारत ।\nसमेते सर्वतः स्फीते मुनीनां मण्डले तथा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175026, "chapter_id": 4712, "verse_number": "२४", "content_sanskrit": "उत्तरे कोसले भागे पुण्ये राजन् महात्मना ।\nऔद्दालकेन यजता पूर्वं ध्याता सरस्वती\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175027, "chapter_id": 4712, "verse_number": "२५", "content_sanskrit": "आजगाम सरिच्छ्रेष्ठा तं देशं मुनिकारणात् ।\nपूज्यमाना मुनिगणैर्वल्कलाजिनसंवृतैः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175028, "chapter_id": 4712, "verse_number": "२६", "content_sanskrit": "मनोवृतेति विख्याता सा हि तैर्मनसा वृता\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175029, "chapter_id": 4712, "verse_number": "२७", "content_sanskrit": "कुरोस्तु यजमानस्य कुरुक्षेत्रे महात्मनः ।\nआजगाम महाभागा सरिच्छ्रेष्ठा सरस्वती\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175030, "chapter_id": 4712, "verse_number": "२८", "content_sanskrit": "ओघवत्यपि राजर्षे वसिष्ठेन महात्मना ।\nसमाहूता कुरुक्षेत्रे दिव्यतोया सरस्वती\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175031, "chapter_id": 4712, "verse_number": "२९", "content_sanskrit": "दक्षेण यजता चैव गङ्गातीरे सरस्वती ।\nसुवेणिरिति विख्याता प्रस्रुता शीघ्रगामिनी\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175032, "chapter_id": 4712, "verse_number": "३०", "content_sanskrit": "विमलोदा भगवती ब्रह्मणा यजता पुनः ।\nसमाहूता ययौ तत्र पुण्ये हैमवते गिरौ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175033, "chapter_id": 4712, "verse_number": "३१", "content_sanskrit": "एकीभूतास्ततस्तास्तु तस्मिंस्तीर्थे समागताः ।\nसप्तसारस्वतं तीर्थं ततस्तत् प्रथितं भुवि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175034, "chapter_id": 4712, "verse_number": "समाप्तिः", "content_sanskrit": "इति सप्त सरस्वत्यो नामतः परिकीर्तिताः ।\nसप्तसारस्वतं चैव तीर्थं पुण्यतमं स्मृतम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175035, "chapter_id": 4712, "verse_number": "३३", "content_sanskrit": "शृणु मङ्कणकस्यापि कौमारब्रह्मचारिणः ।\nआपगामवगाढस्य राजन् प्रक्रीडितं महत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175036, "chapter_id": 4712, "verse_number": "३४", "content_sanskrit": "दृष्ट्वा यदृच्छया तत्र स्त्रियमम्भसि भारत ।\nस्नायन्तीं रुचिराकारां दिग्वाससमनिन्दिताम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175037, "chapter_id": 4712, "verse_number": "३५", "content_sanskrit": "सरस्वत्यां महाराज चस्कन्दे रेत अम्भसि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175038, "chapter_id": 4712, "verse_number": "३६", "content_sanskrit": "तद्रेतः स तु जग्राह कलशेन महातपाः ।\nऋषिः परमधर्मात्मा तदा पुरुषसत्तमः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175039, "chapter_id": 4712, "verse_number": "३७", "content_sanskrit": "सप्तधा प्रविभक्तं तत् कलशस्थं जगाम ह ।\nतत्रर्षयः सप्त जाता जज्ञुरेभ्यो मरुद्गणाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175040, "chapter_id": 4712, "verse_number": "३८", "content_sanskrit": "वायुवेगो वायुबलो वायुहा वायुमण्डलः ।\nवायुजालो वायुरेता वायुचक्रश्च वीर्यवान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175041, "chapter_id": 4712, "verse_number": "३९", "content_sanskrit": "एवमेते समुत्पन्ना मरुतां भावयिष्णवः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175042, "chapter_id": 4712, "verse_number": "४०", "content_sanskrit": "इदमन्यच्च राजेन्द्र शृण्वाश्चर्यतमं भुवि ।\nमहर्षेश्चरितं यादृक् त्रिषु लोकेषु विश्रुतम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175043, "chapter_id": 4712, "verse_number": "४१", "content_sanskrit": "पुरा मङ्कणकः सिद्धः कुशाग्रेणेति विश्रुतः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175044, "chapter_id": 4712, "verse_number": "४२", "content_sanskrit": "क्षतः किल करे राजन् तस्य शाकरसोऽस्रवत् ।\nतं वै शाकरसं दृष्ट्वा हर्षाविष्टः प्रनृत्तवान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175045, "chapter_id": 4712, "verse_number": "४३", "content_sanskrit": "ततस्तस्मिन् प्रनृत्ते वै स्थावरं जङ्गमं च यत् ।\nप्रनृत्तमुभयं वीर तेजसा तस्य मोहितम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175046, "chapter_id": 4712, "verse_number": "४४", "content_sanskrit": "ब्रह्मादिभिः सुरै राजन् ऋषिभिश्च तपोधनैः ।\nविज्ञप्तो वै महादेव ऋषेरर्थे नराधिप\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175047, "chapter_id": 4712, "verse_number": "४५", "content_sanskrit": "नायं नृत्येद् यथा देव तथा त्वं कर्तुमर्हसि\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175048, "chapter_id": 4712, "verse_number": "४६", "content_sanskrit": "ततो देवो मुनिं दृष्ट्वा हर्षाविष्टमतीव ह ।\nसुराणां हितकामार्थं तं शिवः प्रत्यभाषत\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175049, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "शिवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175050, "chapter_id": 4712, "verse_number": "४७", "content_sanskrit": "हर्षाद् ब्राह्मण धर्मज्ञ किमर्थं त्वं प्रनृत्यसि ।\nहर्षस्थानं किमर्थं वा तवेदं मुनिसत्तम\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2175051, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "मङ्कणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2175052, "chapter_id": 4712, "verse_number": "४८", "content_sanskrit": "किं न पश्यसि मे देव कराच्छाकरसं सृतम् ।\nयं दृष्ट्वा वै प्रनृत्तोऽहं हर्षेण महता विभो\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2175053, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2175054, "chapter_id": 4712, "verse_number": "४९", "content_sanskrit": "ततस्तमब्रवीद् देवो मुनिं रागेण मोहितम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2175055, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "शिवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2175056, "chapter_id": 4712, "verse_number": "५०", "content_sanskrit": "अहं वै विस्मयं विप्र न गच्छामीह पश्य माम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2175057, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "वेशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2175058, "chapter_id": 4712, "verse_number": "५१", "content_sanskrit": "एवमुक्त्वा मुनिश्रेष्ठं महादेवेन धीमता ।\nअङ्गुल्यग्रेण राजेन्द्र स्वाङ्गुष्ठस्ताडितो भृशम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2175059, "chapter_id": 4712, "verse_number": "५२", "content_sanskrit": "ततो भस्मक्षताद् राजन् निर्गतं हिमसन्निभम् ।\nतद् दृष्ट्वा व्रीडितो राजन् स मुनिः पादयोर्नतः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2175060, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "मङ्कणकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2175061, "chapter_id": 4712, "verse_number": "५३", "content_sanskrit": "नान्यं दैवमहं मन्ये रुद्रात् परतरं महत् ।\nसुरासुरेषु जगतो गतिस्त्वमसि शूलधृक्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2175062, "chapter_id": 4712, "verse_number": "५४", "content_sanskrit": "त्वया सृष्टमिदं सर्वं वदन्तीह मनीषिणः ।\nत्वामेव सर्वं व्रजति पुनरेव युगक्षये\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2175063, "chapter_id": 4712, "verse_number": "५५", "content_sanskrit": "देवैरपि न शक्यस्त्वं परिज्ञातुं कुतो मया ।\nत्वयि सर्वेश दृश्यन्ते सुरा ब्रह्मादयोऽनघ\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2175064, "chapter_id": 4712, "verse_number": "५६", "content_sanskrit": "सर्वस्त्वमसि देवानां कर्ता कारयिता च ह ।\nत्वत्प्रसादात् सुराः सर्वे मोदन्ते ह्यकुतोभयाः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2175065, "chapter_id": 4712, "verse_number": "५७", "content_sanskrit": "त्वं प्रभुः परमैश्वर्याद् अधिकं भासि शङ्कर ।\nत्वयि ब्रह्मा च शक्रश्च लोकान् सन्धार्य तिष्ठतः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2175066, "chapter_id": 4712, "verse_number": "५८", "content_sanskrit": "त्वन्मूलं च जगत् सर्वं त्वदन्तं च महेश्वर ।\nत्वया हि वितता लोकाः सप्तेमे सर्वसम्भव\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2175067, "chapter_id": 4712, "verse_number": "५९", "content_sanskrit": "सर्वथा सर्वभूतेश त्वामेवार्चन्ति देवताः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2175068, "chapter_id": 4712, "verse_number": "६०", "content_sanskrit": "त्वन्मयं हि जगत् सर्वं भूतं स्थावरजङ्गमम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2175069, "chapter_id": 4712, "verse_number": "६१", "content_sanskrit": "स्वर्गं च परमं स्थानं नृणामभ्युदयार्थिनाम् ।\nददासि च प्रसन्नस्त्वं भक्तानां परमेश्वर\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2175070, "chapter_id": 4712, "verse_number": "६२", "content_sanskrit": "अनावृत्तिपदं नॄणां नित्यं निश्रेयसार्थिनाम् ।\nददासि कर्मिणां कर्म भावयन् ध्यानयोगतः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2175071, "chapter_id": 4712, "verse_number": "६३", "content_sanskrit": "न वृथाऽस्ति महादेव प्रसादस्ते महेश्वर ।\nयस्मात् त्वयोपकरणात् करोमि कमलेक्षण\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2175072, "chapter_id": 4712, "verse_number": "६४", "content_sanskrit": "प्रपद्ये शरणं शम्भुं सर्वदा सर्वतः स्थितम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2175073, "chapter_id": 4712, "verse_number": "६५", "content_sanskrit": "कर्मणा मनसा वाचा तमेवाभिजगाम ह\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2175074, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2175075, "chapter_id": 4712, "verse_number": "६६", "content_sanskrit": "एवं स्तुत्वा महादेवमृषिः स प्रणतोऽब्रवीत्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2175076, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "मङ्कणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2175077, "chapter_id": 4712, "verse_number": "६७", "content_sanskrit": "भगवन् त्वत्प्रसादाद्वै तपो मे न क्षरेदिति\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2175078, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2175079, "chapter_id": 4712, "verse_number": "६८", "content_sanskrit": "ततो देवः प्रीयमाणस्तमृषिं पुनरब्रवीत्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2175080, "chapter_id": 4712, "verse_number": "", "content_sanskrit": "शिवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2175081, "chapter_id": 4712, "verse_number": "६९", "content_sanskrit": "तपस्ते वर्धतां विप्र मत्प्रसादात् सहस्रधा ।\nआश्रमे चेह वत्स्यामि त्वया सार्धमहं सदा\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2175082, "chapter_id": 4712, "verse_number": "७०", "content_sanskrit": "सप्तसारस्वते चास्मिन्नर्चयिष्यन्ति ये नराः ।\nतेषां न दुर्लभं किञ्चिद् भवितेह परत्र च\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2175083, "chapter_id": 4712, "verse_number": "७१", "content_sanskrit": "सारस्वतं च लोकं ते गमिष्यन्ति न संशयः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2175084, "chapter_id": 4712, "verse_number": "७२", "content_sanskrit": "एवं मङ्कणकस्यापि चरितं भूरिचेतसः ।\nस हि पुत्रः सुकन्यायामुत्पन्नो मातरिश्वना\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2175085, "chapter_id": 4712, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि दशमोऽध्यायः ॥१०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]