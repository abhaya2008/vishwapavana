[{"id": 2137405, "chapter_id": 3979, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137406, "chapter_id": 3979, "verse_number": "१", "content_sanskrit": "सा तु कन्या महाराज ब्राह्मणं शंसितव्रतम् ।\nतोषयामास शुद्धेन मनसा शंसितव्रता \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137407, "chapter_id": 3979, "verse_number": "२", "content_sanskrit": "प्रातरेष्याम्यथेत्युक्त्वा कदाचिद् द्विजसत्तमः ।\nतत आयाति राजेन्द्र सायं रात्रावथो पुनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137408, "chapter_id": 3979, "verse_number": "३", "content_sanskrit": "तं च सर्वासु वेलासु भक्ष्यभोज्यप्रतिश्रयैः ।\nपूजयामास सा कन्या वर्धमानैस्तु सर्वदा \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137409, "chapter_id": 3979, "verse_number": "४", "content_sanskrit": "अन्नादिसमुदाचारः शय्यासनकृतस्तथा ।\nदिवसे दिवसे तस्य वर्धते न तु हीयते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137410, "chapter_id": 3979, "verse_number": "५", "content_sanskrit": "निर्भर्त्सनापवादैश्च तथैवाप्रियया गिरा ।\nब्राह्मणस्य पृथा राजन्न चकाराप्रियं तदा \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137411, "chapter_id": 3979, "verse_number": "६", "content_sanskrit": "व्यस्ते काले पुनश्चैति न चैति बहुशो द्विजः ।\nसुदुर्लभमपि ह्यन्नं दीयतामिति सोऽब्रवीत् ।\nकृतमेव च तत् सर्वं यथा तस्मै न्यवेदयत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137412, "chapter_id": 3979, "verse_number": "७", "content_sanskrit": "शिष्यवत् पुत्रवच्चैव स्वसृवच्च सुसंयता ।\nयथोपजोषं राजेन्द्र द्विजातिप्रवरस्य सा \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137413, "chapter_id": 3979, "verse_number": "८", "content_sanskrit": "प्रीतिमुत्पादयामास कन्यारत्नमनिन्दिता \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137414, "chapter_id": 3979, "verse_number": "९", "content_sanskrit": "तस्यास्तु शीलवृत्तेन तुतोष द्विजसत्तमः ।\nअवधानेन भूयोऽस्याः परं यत्नमथाकरोत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137415, "chapter_id": 3979, "verse_number": "", "content_sanskrit": "तां प्रभाते च सायं च पिता पप्रच्छ भारत ।\nअति तुष्यति ते पुत्रि ब्राह्मणः परिचर्यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137416, "chapter_id": 3979, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137417, "chapter_id": 3979, "verse_number": "१०", "content_sanskrit": "तं सा परममित्येव प्रत्युवाच यशस्विनी \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137418, "chapter_id": 3979, "verse_number": "११", "content_sanskrit": "ततः प्रीतिमवापाग्य्रां कुन्तिभोजो महामनाः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137419, "chapter_id": 3979, "verse_number": "१२", "content_sanskrit": "ततः संवत्सरे पूर्णे यदासौ जपतां वरः ।\nनापश्यद् दुष्कृतं किञ्चित् पृथायाः सौहृदे रतः ।\nततः प्रीतमना भूत्वा स एनां ब्राह्मणोऽब्रवीत् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137420, "chapter_id": 3979, "verse_number": "१३", "content_sanskrit": "प्रीतोऽस्मि परमं भद्रे परिचारेण ते शुभे ।\nवरान् वृणीष्व कल्याणि दुरापान् मानुषैरिह \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137421, "chapter_id": 3979, "verse_number": "१४", "content_sanskrit": "यैस्त्वं सीमन्तिनीः सर्वा यशसाभिभविष्यसि \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137422, "chapter_id": 3979, "verse_number": "", "content_sanskrit": "कुन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137423, "chapter_id": 3979, "verse_number": "१५", "content_sanskrit": "कृतानि मम सर्वाणि यस्या मे वेदवित्तम ।\nत्वं प्रसन्न पिता चैव कृतं विप्र वरैर्मम \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137424, "chapter_id": 3979, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137425, "chapter_id": 3979, "verse_number": "१६", "content_sanskrit": "यदि नेच्छसि मत्तस्त्वं वरं भद्रे शुचिस्मिते ।\nइमं मन्त्रं गृहाण त्वमाह्वानाय दिवौकसाम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137426, "chapter_id": 3979, "verse_number": "१७", "content_sanskrit": "यं यं देवं त्वमेतेन मन्त्रेणावाहयिष्यसि ।\nतेन तेन वशे भद्रे स्थातव्यं ते भविष्यति \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137427, "chapter_id": 3979, "verse_number": "१८", "content_sanskrit": "अकामो वा सकामो वा स समेष्यति ते वशे ।\nविबुधो मन्त्रसंशान्तो भवेद् भृत्य इवानतः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137428, "chapter_id": 3979, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137429, "chapter_id": 3979, "verse_number": "१९", "content_sanskrit": "न शशाक द्वितीयं सा प्रत्याख्यातुमनिन्दिता ।\nतं वै द्विजातिप्रवरं तदा शापभयान्नृप \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137430, "chapter_id": 3979, "verse_number": "२०", "content_sanskrit": "ततस्तामनवद्याङ्गीं ग्राहयामास स द्विजः ।\nमन्त्रग्रामं तदा राजन्नथर्वशिरसि श्रुतम् ।\nतं प्रदाय तु राजेन्द्र कुन्तिभोजमुवाच ह \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137431, "chapter_id": 3979, "verse_number": "२१", "content_sanskrit": "उषितोऽस्मि सुखं राजन् कन्यया परितोषितः ।\nतव गेहेषु विहितः सदा सुप्रतिपूजितः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137432, "chapter_id": 3979, "verse_number": "२२", "content_sanskrit": "साधयिष्यामहे तावदित्युक्त्वान्तरधीयत \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137433, "chapter_id": 3979, "verse_number": "२३", "content_sanskrit": "स तु राजा द्विजं दृष्ट्वा तत्रैवान्तर्हितं तदा ।\nबभूव विस्मयाविष्टः पृथां च समपूजयत् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137434, "chapter_id": 3979, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि कुण्डलाहरणपर्वणि पृथाया मन्त्रप्राप्तौ चतुर्नवत्यधिकद्विशततमोऽध्यायः ॥२९४॥\nकुण्डलाहरणपर्वणि षष्ठोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]