[{"id": 50024352, "chapter_id": 11852, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। इन्द्राग्नी। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024353, "chapter_id": 11852, "verse_number": "2", "content_sanskrit": "इ॒हेन्द्रा॒ग्नी उप॑ ह्वये॒ तयो॒रित्स्तोम॑मुश्मसि। ता सोमं॑ सोम॒पात॑मा॥ २१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024354, "chapter_id": 11852, "verse_number": "3", "content_sanskrit": "ता य॒ज्ञेषु॒ प्र शं॑सतेन्द्रा॒ग्नी शु॑म्भता नरः। ता गा॑य॒त्रेषु॑ गायत॥ २१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024355, "chapter_id": 11852, "verse_number": "4", "content_sanskrit": "ता मि॒त्रस्य॒ प्रश॑स्तय इन्द्रा॒ग्नी ता ह॑वामहे। सो॒म॒पा सोम॑पीतये॥ २१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024356, "chapter_id": 11852, "verse_number": "5", "content_sanskrit": "उ॒ग्रा सन्ता॑ हवामह॒ उपे॒दं सव॑नं सु॒तम्। इ॒न्द्रा॒ग्नी एह ग॑च्छताम्॥ २१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024357, "chapter_id": 11852, "verse_number": "6", "content_sanskrit": "ता म॒हान्ता॒ सद॒स्पती॒ इन्द्रा॑ग्नी॒ रक्ष॑ उब्जतम्। अप्र॑जाः सन्त्व॒त्रिण॑ः॥ २१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024358, "chapter_id": 11852, "verse_number": "7", "content_sanskrit": "तेन॑ स॒त्येन॑ जागृत॒मधि॑ प्रचे॒तुने॑ प॒दे। इन्द्रा॑ग्नी॒ शर्म॑ यच्छतम्॥ २१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]