[{"id": 7004358000, "chapter_id": 24358, "verse_number": "५-३-५२-१", "content_sanskrit": "ईश्वर उवाच ।\nअन्यदाख्यानकं वक्ष्ये पुरा वृत्तं नराधिप ।\nसकुटुम्बो गतः स्वर्गं मुनिर्यत्र महातपाः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004358001, "chapter_id": 24358, "verse_number": "५-३-५२-२", "content_sanskrit": "उत्तानपाद उवाच ।\nकथं नाकं गतो विप्रः सकुटुम्बो महानृषिः ।\nकौतुकं परमं देव कथयस्व मम प्रभो॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004358002, "chapter_id": 24358, "verse_number": "५-३-५२-३", "content_sanskrit": "ईश्वर उवाच ।\nचित्रसेन इति ख्यातः काशीराजः पुराभवत् ।\nशूरो दाता सुधर्मात्मा सर्वकामसमृद्धिमान्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004358003, "chapter_id": 24358, "verse_number": "५-३-५२-४", "content_sanskrit": "सा पुरी जनसंकीर्णा नानारत्नोपशोभिता ।\nवाराणसीति विख्याता गङ्गातीरमुपाश्रिता॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004358004, "chapter_id": 24358, "verse_number": "५-३-५२-५", "content_sanskrit": "शरच्चन्द्रप्रतीकाशा विद्वज्जनविभूषिता ।\nइन्द्रयष्टिसमाकीर्णा गोपगोकुलसंवृता॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004358005, "chapter_id": 24358, "verse_number": "५-३-५२-६", "content_sanskrit": "बहुध्वजसमाकीर्णा वेदध्वनिनिनादिता ।\nवणिग्जनैर्बहुविधैः क्रयविक्रयशालिनी॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004358006, "chapter_id": 24358, "verse_number": "५-३-५२-७", "content_sanskrit": "यन्त्रादानैः प्रतोलीभिरुच्चैश्चान्यैः सुशोभिता ।\nदेवतायतनैर्दिव्यैराश्रमैर्गहनैर्युता॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004358007, "chapter_id": 24358, "verse_number": "५-३-५२-८", "content_sanskrit": "नानापुष्पफलैर्रम्या कदलीखण्डमण्डिता ।\nपनसैर्बकुलैस्तालैरशोकैराम्रकैस्तथा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004358008, "chapter_id": 24358, "verse_number": "५-३-५२-९", "content_sanskrit": "राजवृक्षकपित्थैश्च दाडिमैरुपशोभिता ।\nवेदाध्ययननिर्घोषैः पवित्रीकृतमङ्गला॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004358009, "chapter_id": 24358, "verse_number": "५-३-५२-१०", "content_sanskrit": "तस्या उत्तरदिग्भागे आश्रमोऽभूत्सुशोभनः ।\nतन्मन्दारवनं नाम त्रिषु लोकेषु विश्रुतम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004358010, "chapter_id": 24358, "verse_number": "५-३-५२-११", "content_sanskrit": "बहुमन्दारसंयुक्तं तेन मन्दारकं विदुः ।\nविप्रो दीर्घतपा नाम सर्वदा तत्र तिष्ठति॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004358011, "chapter_id": 24358, "verse_number": "५-३-५२-१२", "content_sanskrit": "तपस्तपति सोऽत्यर्थं तेन दीर्घतपाः स्मृतः ।\nस तिष्ठति सपत्नीकः ससुतः सस्नुषस्तथा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004358012, "chapter_id": 24358, "verse_number": "५-३-५२-१३", "content_sanskrit": "शुश्रूषन्ति सदा तस्य पुत्राः पञ्च प्रयत्नतः ।\nतस्य पुत्रः कनीयांस्तु ऋक्षशृङ्गो महातपाः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004358013, "chapter_id": 24358, "verse_number": "५-३-५२-१४", "content_sanskrit": "वेदाध्ययनसम्पन्नो ब्रह्मचारी गुणान्वितः ।\nयोगाभ्यासरतो नित्यं कन्दमूलफलाशनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004358014, "chapter_id": 24358, "verse_number": "५-३-५२-१५", "content_sanskrit": "तिष्ठते मृगरूपेण मृगयूथचरस्तदा ।\nदिनान्ते च दिनान्ते च मातापित्रोः समीपगः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004358015, "chapter_id": 24358, "verse_number": "५-३-५२-१६", "content_sanskrit": "अभिवादयते नित्यं भक्तिमान्मुनिपुत्रकः ।\nपुनर्गच्छति तत्रैव कानने गिरिगह्वरे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004358016, "chapter_id": 24358, "verse_number": "५-३-५२-१७", "content_sanskrit": "क्रीडन्बालमृगैः सार्द्धं प्रत्यहं स मुनेः सुतः ।\nकदाचिद्दैवयोगेन ऋक्षशृङ्गो ममार सः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]