[{"id": 900010050, "chapter_id": 8769, "verse_number": "3.1", "content_sanskrit": "ॐ अथातो ब्रह्मजिज्ञासा ॐ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900010051, "chapter_id": 8769, "verse_number": "3.2", "content_sanskrit": "स कतुं कुर्वीत मनोमयः प्राणशरीरो भारूप:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900010052, "chapter_id": 8769, "verse_number": "3.3", "content_sanskrit": "यस्मिन् द्यौः पृथिवी चान्तरिक्षमोतं मनः सह प्राणैश्च सर्वैः तमेवैकं जानथ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900010053, "chapter_id": 8769, "verse_number": "3.4", "content_sanskrit": "आनुमानिकमप्येकेषामिति चेन्न शरीररूपक विन्यस्तगृहीतेर्दर्शयति च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900010054, "chapter_id": 8769, "verse_number": "3.5", "content_sanskrit": "वाक्यान्वयात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900010055, "chapter_id": 8769, "verse_number": "3.6", "content_sanskrit": "प्रकृतिश्च प्रतिज्ञादृष्टान्तानुपरोधात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]