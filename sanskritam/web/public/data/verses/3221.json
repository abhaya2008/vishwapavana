[{"id": 2102572, "chapter_id": 3221, "verse_number": "१४-७७-१", "content_sanskrit": "वैशम्पायन उवाच।\n`जित्वा प्रसाद्य राजानं भगदत्तसुतं तदा।\nविसृज्य याते तुरगे सैन्धवान्प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102573, "chapter_id": 3221, "verse_number": "१४-७७-२", "content_sanskrit": "सैन्धवैरभवगद्युद्धं ततस्तस्य किरीटिनः।\nहतशेषैर्महाराज हतानां च सुतैरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102574, "chapter_id": 3221, "verse_number": "१४-७७-३", "content_sanskrit": "तेऽवतीर्णमुपश्रुत्य विषयं श्वेतवाहनम्।\nप्रत्युद्ययुरमृष्यन्ते राजानः पाण्डवर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102575, "chapter_id": 3221, "verse_number": "१४-७७-४", "content_sanskrit": "अश्वं च तं परामृश्य विषयान्ते विषोपमात्।\nन भयं चक्रिरे पार्थाद्भीमसेनादनन्तरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102576, "chapter_id": 3221, "verse_number": "१४-७७-५", "content_sanskrit": "तेऽविदूराद्धनुष्पाणिं यज्ञियस्य हयस्य च।\nबीभत्सुं प्रत्यपद्यन्त् पदातिनमवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102577, "chapter_id": 3221, "verse_number": "१४-७७-६", "content_sanskrit": "ततस्ते तं महावीर्या राजानः पर्यवारयन्।\nजिगीषन्तो नरव्याघ्रं पूर्वं विनिकृता युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102578, "chapter_id": 3221, "verse_number": "१४-७७-७", "content_sanskrit": "ते नामान्यपि गोत्राणि कर्मणि विविधानि च।\nकीर्तयन्तस्तदा पार्थं शरवर्षैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102579, "chapter_id": 3221, "verse_number": "१४-७७-८", "content_sanskrit": "ते किरन्तः शरव्रातान्वारणप्रतिवारणान्।\nरणे जयमभीप्सन्तः कौन्तेयं पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102580, "chapter_id": 3221, "verse_number": "१४-७७-९", "content_sanskrit": "ते समीक्ष्य च तं कृष्णमुग्रकर्माणमाहवे।\nसर्वे युयुधिरे वीरा रथस्थास्तं पदातिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102581, "chapter_id": 3221, "verse_number": "१४-७७-१०", "content_sanskrit": "ते तमाजघ्निरे वीरं निवातकवचान्तकम्।\nसंशप्तकनिहन्तारं हन्तारं सैन्धवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102582, "chapter_id": 3221, "verse_number": "१४-७७-११", "content_sanskrit": "ततो रथसहस्रेण गजानामयुतेन च।\n***ष्ठकीकृत्य बीभत्सुं प्रहृष्टमनसोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102583, "chapter_id": 3221, "verse_number": "१४-७७-१२", "content_sanskrit": "** स्मरन्तो वधं वीराः सिन्धुराजस्य चाहवे।\nजयद्रथस्य कौरव्य समरे सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102584, "chapter_id": 3221, "verse_number": "१४-७७-१३", "content_sanskrit": "ततः पर्जन्यवत्सर्वे शरवृष्टीरवासृजन्।\nतैः कीर्णः शुशुभे पार्थो रविर्मेघान्तरे यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102585, "chapter_id": 3221, "verse_number": "१४-७७-१४", "content_sanskrit": "स शरैः समवच्छन्नश्चकाशे पाण्डवर्षभः।\nपञ्चरान्तरसञ्चारी शकुन्त इव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102586, "chapter_id": 3221, "verse_number": "१४-७७-१५", "content_sanskrit": "ततो हाहाकृतं सर्वं कौन्तेय शरपीडिते।\nत्रैलोक्यमभवद्राजन्रविरासीद्रजोरुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102587, "chapter_id": 3221, "verse_number": "१४-७७-१६", "content_sanskrit": "ततो ववौ महाराज मारुतो रोमहर्षणः।\nराहुरग्रसदादित्यं पर्वणीव विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102588, "chapter_id": 3221, "verse_number": "१४-७७-१७", "content_sanskrit": "उल्काश्च जघ्निरे सूर्यं विकीर्यन्त्यः समन्ततः।\nवेपथुश्चाभवद्राजन्कैलासस्य महागिरेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102589, "chapter_id": 3221, "verse_number": "१४-७७-१८", "content_sanskrit": "मुमुचुः श्वासमत्युष्णं दुःखशोकसमन्विताः।\nसप्तर्षयो जातभयास्तथा देवर्षयोपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102590, "chapter_id": 3221, "verse_number": "१४-७७-१९", "content_sanskrit": "शशं चाशु विनिर्भिद्य मण्डलं शशिनोऽपतन्।\nविपरीता दिशश्चापि सर्वा धूमाकुलास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102591, "chapter_id": 3221, "verse_number": "१४-७७-२०", "content_sanskrit": "रासभारुणसङ्काशा धनुष्मन्तः सविद्युतः।\nआवृत्य गगनं मेघा मुमुचुर्मांसशोणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102592, "chapter_id": 3221, "verse_number": "१४-७७-२१", "content_sanskrit": "एवमासीत्तदा वीरे शरवर्षेण संवृते।\nफल्गुने भरतश्रेष्ठ तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102593, "chapter_id": 3221, "verse_number": "१४-७७-२२", "content_sanskrit": "तस्य तेनावकीर्णस्य शरजालेन सर्वतः।\nमोहात्पपात गाण्डीवमावापश्च करादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102594, "chapter_id": 3221, "verse_number": "१४-७७-२३", "content_sanskrit": "तस्मिन्मोहमनुप्राप्ते शरजालं महत्तदा।\nसैन्धवा मुमुचुस्तूर्णं गतसत्वे महारथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102595, "chapter_id": 3221, "verse_number": "१४-७७-२४", "content_sanskrit": "ततो मोहं समापन्नं ज्ञात्वा पार्थं द्विवौकसः।\nसर्वे वित्रस्तमनसस्तस्य शान्तिकृतोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102596, "chapter_id": 3221, "verse_number": "१४-७७-२५", "content_sanskrit": "ततो देवर्षयः सर्वे तथा सप्तर्षयोपि च।\nब्रह्मर्षचस्च विजयं जेपुः पार्थस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102597, "chapter_id": 3221, "verse_number": "१४-७७-२६", "content_sanskrit": "ततः प्रदीपिते देवैः पार्थतेजसि पार्थिव।\nतस्थावचलवद्धीमान्सङ्ग्रामे परमास्त्रवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2102598, "chapter_id": 3221, "verse_number": "१४-७७-२७", "content_sanskrit": "विचकर्ष धनुर्दिव्यं ततः कौरवनन्दनः।\nयन्त्रस्येवेह शब्दोऽभून्महांस्तस्य पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2102599, "chapter_id": 3221, "verse_number": "१४-७७-२८", "content_sanskrit": "ततः स शरवर्षाणि प्रत्यमित्रान्प्रति प्रभुः।\nववर्ष धनुषा पार्थो वर्षाणीव पुरंदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2102600, "chapter_id": 3221, "verse_number": "१४-७७-२९", "content_sanskrit": "ततस्ते सैन्धवा योधाः सर्व एव सराजकाः।\nनादृश्यन्त शरैः कीर्णाः शलभैरिव पादपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2102601, "chapter_id": 3221, "verse_number": "१४-७७-३०", "content_sanskrit": "तस्य शब्देन वित्रेसुर्भयार्ताश्च विदुद्रुवुः।\nमुमुचुस्चाश्रु शोकार्ताः शुशुचुश्चापि सैन्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2102602, "chapter_id": 3221, "verse_number": "१४-७७-३१", "content_sanskrit": "तांस्तु सर्वान्नरव्याघ्रः सैन्धवान्व्यचरद्बली।\nअलातचक्रवद्राजञ्शरजालैः समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2102603, "chapter_id": 3221, "verse_number": "१४-७७-३२", "content_sanskrit": "तदिन्द्रजालप्रतिमं बाणजालममित्रहा।\nविसृज्य दिक्षु सर्वासु महेन्द्रि इव वज्रभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2102604, "chapter_id": 3221, "verse_number": "१४-७७-३३", "content_sanskrit": "मेघजालनिभं सैन्यं विदार्य शरवृष्टिभिः।\nविबभौ कौरवश्रेष्ठः शरदीव दिवाकरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2102605, "chapter_id": 3221, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि सप्तसप्ततितमोऽध्यायः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]