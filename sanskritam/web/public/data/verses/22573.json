[{"id": 7002573000, "chapter_id": 22573, "verse_number": "२-१९-१", "content_sanskrit": "सूत उवाच ।\nश्रीपर्णी शिंशपा क्षीरी बिल्वः खदिर एव च ।\nस्रुवे प्रशस्तास्तरवः सिद्धिदा यागकर्मणि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002573001, "chapter_id": 22573, "verse_number": "२-१९-२", "content_sanskrit": "प्रतिष्ठायां प्रशस्तास्तु धात्रीखदिरकेशराः ।\nसंस्कारे शशिभिन्नौ च धात्री धात्रा विनिर्मिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002573002, "chapter_id": 22573, "verse_number": "२-१९-३", "content_sanskrit": "संप्राशे यः स्रुवः प्रोक्तः संस्कारे यज्ञसाधने ।\nप्रतिष्ठायां तु कथितास्त दन्ये शास्त्रवेदिभिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002573003, "chapter_id": 22573, "verse_number": "२-१९-४", "content_sanskrit": "स्रुवं स्रुचमथो वक्ष्ये यदधीनश्च जायते ।\nयज्ञे न सर्वकं धार्यमक्षरेण च व्यत्ययः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002573004, "chapter_id": 22573, "verse_number": "२-१९-५", "content_sanskrit": "तस्यादौ च स्रुवं वक्ष्ये यच्च मानं यदास्पदम् ।\nकाष्ठं गृहीत्वा बिल्वस्य रिक्तादितिथिवर्जिते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002573005, "chapter_id": 22573, "verse_number": "२-१९-६", "content_sanskrit": "समुपोष्य च रचयेदामिषाणि न च स्मरेत् ।\nवर्जयेद्ग्राम्यधर्मं च निर्माणे स्रुक्स्रुवस्य वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002573006, "chapter_id": 22573, "verse_number": "२-१९-७", "content_sanskrit": "काष्ठं गृहीत्वा विभजेद्भागांस्त्रिंशत्तथा पुनः ।\nविंशत्यंगुलमानं तु कुंडवेदिसमोदरम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002573007, "chapter_id": 22573, "verse_number": "२-१९-८", "content_sanskrit": "कटाहाकारनिम्नं च स्रुवं कुर्याद्विचक्षणः ।\nधात्रीफलसमाकारं स्वधानिम्नं सुशोभनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002573008, "chapter_id": 22573, "verse_number": "२-१९-९", "content_sanskrit": "वेदीं शूर्पाकृतिं कुर्यात्कुंडानि परिकल्पयेत् ।\nहंसवत्त्रिगुणा वापि हस्तेनाऽनुमुखं लिखेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002573009, "chapter_id": 22573, "verse_number": "२-१९-१०", "content_sanskrit": "स्रुवं चतुर्विंशतिभिर्भागैश्च रचयेद्ध्रुवम् ।\nद्वित्रिंशं स्यात्कुंडमानमदैवे तस्य कीर्तितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002573010, "chapter_id": 22573, "verse_number": "२-१९-११", "content_sanskrit": "चतुर्भिरंगैरानाहं कर्षाद्यग्रं ततः स्रुवम् ।\nअंगद्वयेन विलिखेत्पंके मृगमदाकृतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002573011, "chapter_id": 22573, "verse_number": "२-१९-१२", "content_sanskrit": "दंडमूलाश्रये दंडी भवेत्कंकणभूषितः ।\nसौवर्णस्य च ताम्रस्य कार्या दर्वी प्रमाणतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002573012, "chapter_id": 22573, "verse_number": "२-१९-१३", "content_sanskrit": "श्रैवर्णिकोद्भवं यच्च इंदुवृक्षसमुद्भवम् ।\nक्षीरवृक्षसमुद्भूतं द्वादशांगुलसंमितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002573013, "chapter_id": 22573, "verse_number": "२-१९-१४", "content_sanskrit": "द्वयंगुलं मंडलं तस्य दर्वी सा यज्ञसाधने ।\nचत्वारिंशत्तोलिकाभिरिति ताम्रमयस्य च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002573014, "chapter_id": 22573, "verse_number": "२-१९-१५", "content_sanskrit": "पंचांगुलं मंडलं च अष्टहस्तं च दंडकम् ।\nअन्नादिपायसविधौ दर्वी यज्ञस्य साधने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002573015, "chapter_id": 22573, "verse_number": "२-१९-१६", "content_sanskrit": "दशतोलकमानेन सा च दर्वी उदाहृता ।\nआज्यसंशोधनार्थं तु सा तु ताम्रमयस्य च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002573016, "chapter_id": 22573, "verse_number": "२-१९-१७", "content_sanskrit": "षोडशांगुलमानेन सर्वाभावे च पैप्पलीम् ।\nआज्य स्थालीं घृतमयीं मृन्मयीं च समाश्रयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002573017, "chapter_id": 22573, "verse_number": "२-१९-१८", "content_sanskrit": "अथ ताम्रमयी कार्या न च तां तत्र योजयेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]