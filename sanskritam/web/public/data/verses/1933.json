[{"id": 2041922, "chapter_id": 1933, "verse_number": "५-१७८-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2041923, "chapter_id": 1933, "verse_number": "५-१७८-१", "content_sanskrit": "एवमुक्तस्तदा रामो जहि भीष्ममिति प्रभो।\nउवाच रुदतीं कन्यां चोदयन्तीं पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2041924, "chapter_id": 1933, "verse_number": "५-१७८-२", "content_sanskrit": "काश्ये न कामं गृह्णामि शस्त्रं वै वरवर्णिनि।\nऋते ब्रह्मविदां हेतोः किमन्यत्करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2041925, "chapter_id": 1933, "verse_number": "५-१७८-३", "content_sanskrit": "वाचा भीष्मश्च साल्वश्च मम राज्ञि वशानुगौ।\nभविष्यतोऽनवद्याङ्गि तत्करिष्यामि मा शुचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2041926, "chapter_id": 1933, "verse_number": "५-१७८-४", "content_sanskrit": "न तु शस्त्रं ग्रहीष्यामि कथंचिदपि भामिनि ।\nऋते नियोगाद्विप्राणामेष मे समयः कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2041927, "chapter_id": 1933, "verse_number": "५-१७८-५x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2041928, "chapter_id": 1933, "verse_number": "५-१७८-५", "content_sanskrit": "मम दुःखं भगवता व्यपनेयं यतस्ततः।\nतच्च भीष्मप्रसूतं मे तं जहीश्वर मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2041929, "chapter_id": 1933, "verse_number": "५-१७८-६x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2041930, "chapter_id": 1933, "verse_number": "५-१७८-६", "content_sanskrit": "काशिकन्ये पुनर्ब्रूहि भीष्मस्ते चरणावुभौ।\nशिरसा वन्दनार्होऽपि ग्रहीष्यति गिरा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2041931, "chapter_id": 1933, "verse_number": "५-१७८-७x", "content_sanskrit": "अम्बोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2041932, "chapter_id": 1933, "verse_number": "५-१७८-७", "content_sanskrit": "जहि भीष्मं रणे राम मम चेदिच्छसि प्रियम्।\nप्रतिश्रुतं च यदपि तत्सत्यं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2041933, "chapter_id": 1933, "verse_number": "५-१७८-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2041934, "chapter_id": 1933, "verse_number": "५-१७८-८", "content_sanskrit": "तयोः संवदतोरेवं राजन्रामाम्बयोस्तदा ।\nअकृतव्रणो जामदग्न्यमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2041935, "chapter_id": 1933, "verse_number": "५-१७८-९", "content_sanskrit": "शरणागतां महाबाहो कन्यां न त्यक्तुमर्हसि ।\nयदि भीष्मो रणे राम समाहूतस्त्वया मृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2041936, "chapter_id": 1933, "verse_number": "५-१७८-१०", "content_sanskrit": "निर्जितोऽस्मीति वा ब्रूयात्कुर्याद्वा वचनं तव ।\nकृतमस्या भवेत्कार्यं कन्याया भृगुनन्दन ॥\nवाक्यं सत्यं च ते वीर भविष्यति कृतं विभो ।\nइयं चापि प्रतिज्ञा ते तदा राम महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2041937, "chapter_id": 1933, "verse_number": "५-१७८-१२", "content_sanskrit": "जित्वा वै क्षत्रियान्सर्वान्ब्रह्मणेषु प्रतिश्रुता ।\nब्राह्मणः क्षत्रियो वैश्यः शूद्रश्चैव रणे यदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2041938, "chapter_id": 1933, "verse_number": "५-१७८-१३", "content_sanskrit": "ब्रह्मद्विङ्भविता तं वै हनिष्यामीति भार्गव ।\nशरणार्थे प्रपन्नानां भीतानां शरणार्थिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2041939, "chapter_id": 1933, "verse_number": "५-१७८-१४", "content_sanskrit": "न शक्ष्यामि परित्यागं कर्तुं जीवन्कथंचन ।\nयश्च कृत्स्नं रणे क्षत्रं विजेष्यति समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2041940, "chapter_id": 1933, "verse_number": "५-१७८-१५", "content_sanskrit": "दीप्तात्मानमहं तं च हनिष्यामीति भार्गव ।\nस एवं विजयी राम भीष्मः कुरुकुलोद्वहः ।\nतेन युध्यस्व सङ्ग्रमे समेत्य भृगुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2041941, "chapter_id": 1933, "verse_number": "५-१७८-१६x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2041942, "chapter_id": 1933, "verse_number": "५-१७८-१६", "content_sanskrit": "स्मराम्यहं पूर्वकृतां प्रतिज्ञामृषिसत्तम।\nतथैव त्त करिष्यामि यथा साम्नैव लप्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2041943, "chapter_id": 1933, "verse_number": "५-१७८-१७", "content_sanskrit": "कार्यमेतन्महद्ब्रह्मन्काशिकान्यामनोगतम्।\nगमिष्यामि स्वयं कन्यामादाय यत्र सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2041944, "chapter_id": 1933, "verse_number": "५-१७८-१८", "content_sanskrit": "यदि भीष्मो रणश्लाघी न करिष्यति मे वचः।\nहनिष्याम्येनमुद्रिक्तमिति मे निश्चिता मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2041945, "chapter_id": 1933, "verse_number": "५-१७८-१९", "content_sanskrit": "न हि बाणा मयोत्सृष्टाः सज्जन्तीह शरीरिणाम्।\nकायेषु विदितं तुभ्यं पुरा क्षत्रियसंगरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2041946, "chapter_id": 1933, "verse_number": "५-१७८-२०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2041947, "chapter_id": 1933, "verse_number": "५-१७८-२०", "content_sanskrit": "एवमुक्त्वा ततो रामः सह तैर्ब्रह्मवादिभिः।\nप्रयाणाय मतिं कृत्वा समुत्तस्थौ महातपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2041948, "chapter_id": 1933, "verse_number": "५-१७८-२१", "content_sanskrit": "ततस्ते तामुषित्वा तु रजनीं तत्र तापसाः ।\nहुताग्नयो जप्तजप्याः प्रतस्थुर्मञ्जिघांसया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2041949, "chapter_id": 1933, "verse_number": "५-१७८-२२", "content_sanskrit": "अभ्यगच्छत्ततो रामः सह तैर्ब्रह्मवादिभिः ।\nकुरुक्षेत्रं महाराज कन्यया सह भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2041950, "chapter_id": 1933, "verse_number": "५-१७८-२३", "content_sanskrit": "न्यविशन्त ततः सर्वे परिगृह्य सरस्वतीम् ।\nतापसास्ते महात्मानो भृगुश्रेष्ठपुरस्कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2041951, "chapter_id": 1933, "verse_number": "५-१७८-२४", "content_sanskrit": "ततस्तृतीये दिवसे समे देशे व्यवस्थितः ।\nप्रेषयामास मे राजन्प्राप्तोऽस्मीति महाव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2041952, "chapter_id": 1933, "verse_number": "५-१७८-२५", "content_sanskrit": "तमागतमहं श्रुत्वा विषयान्तं महाबलम् ।\nअभ्यगच्छं जवेनाशु प्रीत्या तेजोनिधिं प्रभुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2041953, "chapter_id": 1933, "verse_number": "५-१७८-२६", "content_sanskrit": "गां पुरस्कृत्य राजेन्द्र ब्राह्मणैः परिवारितः।\nऋत्विग्भिर्देवकल्पैश्च तथैव च पुरोहितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2041954, "chapter_id": 1933, "verse_number": "५-१७८-२७", "content_sanskrit": "स मामभिगतं दृष्ट्वा जामदग्न्यः प्रतापवान् ।\nप्रतिजग्राह तां पूजां वचनं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2041955, "chapter_id": 1933, "verse_number": "५-१७८-२८x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2041956, "chapter_id": 1933, "verse_number": "५-१७८-२८", "content_sanskrit": "भीष्म कां बुद्धिमास्थाय काशिराजसुता तदा।\nअकामेन त्वया नीता पुनश्चैव विसर्जिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2041957, "chapter_id": 1933, "verse_number": "५-१७८-२९", "content_sanskrit": "विभ्रंशिता त्वया हीयं धर्मादास्ते यशस्विनी ।\nपरामृष्टां त्वया हीमां को हि गन्तुमिहार्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2041958, "chapter_id": 1933, "verse_number": "५-१७८-३०", "content_sanskrit": "प्रत्याख्याता हि साल्वेन त्वया नीतेति भारत।\nतस्मादिमां मन्नियोगात्प्रतिगृह्णीष्व भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2041959, "chapter_id": 1933, "verse_number": "५-१७८-३१", "content_sanskrit": "स्वधर्मं पुरुषव्याघ्र राजपुत्री लभत्वियम्।\nन युक्तस्त्ववमानोऽयं राज्ञां कर्तुं त्वयाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2041960, "chapter_id": 1933, "verse_number": "५-१७८-३२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2041961, "chapter_id": 1933, "verse_number": "५-१७८-३२", "content_sanskrit": "ततस्तं वै विमनसमुदीक्ष्याहमथाब्रुवम्।\nनाहमेनां पुनर्दद्यां ब्रह्मन्भ्रात्रे कथञ्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2041962, "chapter_id": 1933, "verse_number": "५-१७८-३३", "content_sanskrit": "साल्वस्याहमिति प्राह पुरा मामेव भार्गव।\nमया चैवाभ्यनुज्ञाता गतेयं नगरं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2041963, "chapter_id": 1933, "verse_number": "५-१७८-३४", "content_sanskrit": "न भयान्नाप्यनुक्रोशान्नार्थलोभान्न काम्यया।\nक्षात्रं धर्ममहं जह्यमिति मे व्रतमाहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2041964, "chapter_id": 1933, "verse_number": "५-१७८-३५", "content_sanskrit": "अथ मामब्रवीद्रामः क्रोधपर्याकुलेक्षणः।\nन करिष्यसि चेदेतद्वाक्यं मे नरपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2041965, "chapter_id": 1933, "verse_number": "५-१७८-३६", "content_sanskrit": "हनिष्यामि सहामात्यं त्वामद्येति पुनः पुनः ।\nसंरम्भादब्रवीद्रामः क्रोधपर्याकुलेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2041966, "chapter_id": 1933, "verse_number": "५-१७८-३७", "content_sanskrit": "तमहं गीर्भिरिष्टाभि पुनः पुनररिन्दम।\nअयाचं भृगुशार्दूलं न चैव प्रशशाम सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2041967, "chapter_id": 1933, "verse_number": "५-१७८-३८", "content_sanskrit": "प्रणम्य तमहं मूर्ध्ना भूयो ब्राह्मणसत्तमम् ।\nअब्रुवं कारणं किं तद्यत्त्वं युद्धं मयेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2041968, "chapter_id": 1933, "verse_number": "५-१७८-३९", "content_sanskrit": "इष्वस्त्रं मम बालस्य भवतैव चतुर्विधम्।\nउपदिष्टं महाबाहो शिष्योऽस्मि तव भार्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2041969, "chapter_id": 1933, "verse_number": "५-१७८-४०", "content_sanskrit": "ततो मामब्रवीद्रामः क्रोधसंरक्तलोचनः ।\nजानीषे मां गुरुं भीष्म गृह्णासीमां न चैव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2041970, "chapter_id": 1933, "verse_number": "५-१७८-४१", "content_sanskrit": "सुतां काश्यस्य कौरव्य मत्प्रियार्थं महामते।\nन हि मे विद्यते शान्तिरन्यथा कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2041971, "chapter_id": 1933, "verse_number": "५-१७८-४२", "content_sanskrit": "गृहाणेमां महाबाहो रक्षस्व कुलमात्मनः।\nत्वया विभ्रंशिता हीयं भर्तारं नाधिगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2041972, "chapter_id": 1933, "verse_number": "५-१७८-४३", "content_sanskrit": "तथा ब्रुवन्तं तमहं रामं परपुरंयम्।\nनैतदेवं पुनर्भावि ब्रह्मर्षे किं श्रमेण ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2041973, "chapter_id": 1933, "verse_number": "५-१७८-४४", "content_sanskrit": "गुरुत्वं त्वयि संप्रेक्ष्य जामदग्न्य पुरातनम् ।\nप्रसादये त्वां भगवंस्त्यक्तैषा तु पुरा मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2041974, "chapter_id": 1933, "verse_number": "५-१७८-४५", "content_sanskrit": "को जातु परभावां हि नारीं व्यालीमिव स्थिताम् ।\nवासयेत गृहे जानन्स्त्रीणां दोषो महात्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2041975, "chapter_id": 1933, "verse_number": "५-१७८-४६", "content_sanskrit": "न भयाद्वासवस्यापि धर्मं जह्यां महाव्रत ।\nप्रसीद मा वा यद्वा ते कार्यं तत्कुरु मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2041976, "chapter_id": 1933, "verse_number": "५-१७८-४७", "content_sanskrit": "अयं चापि विशुद्धात्मन्पुराणे श्रूयते विभो।\nमरुत्तेन महाबुद्धे गीतः श्लोको महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2041977, "chapter_id": 1933, "verse_number": "५-१७८-४८", "content_sanskrit": "गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः।\nउत्पथं प्रतिपन्नस्य परित्यागो विधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2041978, "chapter_id": 1933, "verse_number": "५-१७८-४९", "content_sanskrit": "स त्वं गुरुरिति प्रेम्णा मया संमानितो भृशम् ।\nगुरुवृत्तिं न जानीषे तस्माद्योत्स्यामि वै त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2041979, "chapter_id": 1933, "verse_number": "५-१७८-५०", "content_sanskrit": "गुरुं न हन्यां समरे ब्राह्मणं च विशेषतः ।\nविशेषतस्तपोवृद्धमेवं क्षान्तं मया तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2041980, "chapter_id": 1933, "verse_number": "५-१७८-५१", "content_sanskrit": "उद्यतेषुमथो दृष्ट्वा ब्राह्मणं क्षत्रबन्धुवत्।\nयो हन्यात्समरे क्रुद्धं युध्यन्तमपलायिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2041981, "chapter_id": 1933, "verse_number": "५-१७८-५२", "content_sanskrit": "ब्रह्महत्या न तस्य स्यादिति धर्मेषु निश्चयः ।\nक्षत्रियाणां स्थितो धर्म क्षत्रियोऽस्मि तपोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2041982, "chapter_id": 1933, "verse_number": "५-१७८-५३", "content_sanskrit": "यो यथा वर्तते यस्मिंस्तस्मिन्नेव प्रवर्तयन् ।\nनाधर्मं समवाप्नोति न चाश्रेयश्च विन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2041983, "chapter_id": 1933, "verse_number": "५-१७८-५४", "content_sanskrit": "अर्थे वा यदि वा धर्मे समर्थो देशकालवित् ।\nअर्थसंशयमापन्नः श्रोयान्निःसंशयो नरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2041984, "chapter_id": 1933, "verse_number": "५-१७८-५५", "content_sanskrit": "यस्मात्संशयितेऽप्यर्थेऽयथान्यायं प्रवर्तसे ।\nतस्माद्योत्स्यामि सहितस्त्वया राम महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2041985, "chapter_id": 1933, "verse_number": "५-१७८-५६", "content_sanskrit": "पश्य मे बाहुवीर्यं च विक्रमं चातिमानुषम् ।\nएवं गतेऽपि तु मया यच्छक्यं भृगुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2041986, "chapter_id": 1933, "verse_number": "५-१७८-५७", "content_sanskrit": "तत्करिष्ये कुरुक्षेत्रे योत्स्ये विप्र त्वया सह ।\nद्वन्द्वे राम यथेष्टं मे सञ्जीभव महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2041987, "chapter_id": 1933, "verse_number": "५-१७८-५८", "content_sanskrit": "तत्र त्वं निहतो राम मया शरशतार्दितः ।\nप्राप्स्यसे निर्जिताँल्लोकाञ्शस्त्रपूतो महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2041988, "chapter_id": 1933, "verse_number": "५-१७८-५९", "content_sanskrit": "स गच्छ विनिवर्तस्व कुरुक्षोत्रं रणप्रिय ।\nतत्रैष्यामि महाबाहो युद्धाय त्वांतपोधन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2041989, "chapter_id": 1933, "verse_number": "५-१७८-६०", "content_sanskrit": "अपि यत्र त्वया राम कृतं शौचं पुरा पितुः ।\nतत्राहमपि हत्वा त्वां शौचं कर्तास्मि भार्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2041990, "chapter_id": 1933, "verse_number": "५-१७८-६१", "content_sanskrit": "तत्र राम समागच्छ त्वरितं युद्धदुर्मद ।\nव्यपनेष्यामि ते दर्पं पौराणं ब्राह्मणब्रुव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2041991, "chapter_id": 1933, "verse_number": "५-१७८-६२", "content_sanskrit": "यच्चापि कत्थसे राम बहुशः परिवत्सरे ।\nनिर्जिताः क्षत्रिया लोके मयैकेनेति तच्छ्रुणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2041992, "chapter_id": 1933, "verse_number": "५-१७८-६३", "content_sanskrit": "न तदा जातवान्भीष्मः क्षत्रियो वापि मद्विधः ।\nपञ्चाञ्चातानि तेजांसि तृणेषु ज्वलितं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2041993, "chapter_id": 1933, "verse_number": "५-१७८-६४", "content_sanskrit": "यस्ते युद्धमयं दर्पं कामं च व्यपनाशयेत्।\nसोऽहं जातो महाबाहो भीष्मः परपुरंजयः।\nव्यपनेष्यामि ते दर्पं युद्धे राम न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2041994, "chapter_id": 1933, "verse_number": "५-१७८-६५", "content_sanskrit": "ततो मामब्रवीद्रामः प्रहसन्निव भारत।\nदिष्ट्या भीष्म मया सार्धं योद्धुमिच्छसि संगरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2041995, "chapter_id": 1933, "verse_number": "५-१७८-६६", "content_sanskrit": "अयं गच्छामि कौरव्य कुरुक्षेत्रं त्वया सह।\nभाषितं ते करिष्यामि तत्रागच्छ परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2041996, "chapter_id": 1933, "verse_number": "५-१७८-६७", "content_sanskrit": "तत्र त्वां निहतं माता मया शरशताचितम् ।\nजाह्नवी पश्यतां भीष्म गृध्रकङ्कबलाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2041997, "chapter_id": 1933, "verse_number": "५-१७८-६८", "content_sanskrit": "कृपणं त्वामभिप्रेक्ष्य सिद्धचारणसेविता ।\nमया विनिहतं देवी रोदतामद्य पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2041998, "chapter_id": 1933, "verse_number": "५-१७८-६९", "content_sanskrit": "अतदर्हा महाभागा भगीरथसुताऽनघा ।\nया त्वामजीजनन्मन्दं युद्धकामुकमातुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2041999, "chapter_id": 1933, "verse_number": "५-१७८-७०", "content_sanskrit": "एहि गच्छ मया भीष्म युद्धकामुक दुर्मद ।\nगृहाण सर्वं कौरव्य रथादि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2042000, "chapter_id": 1933, "verse_number": "५-१७८-७१", "content_sanskrit": "इति ब्रुवाणं तमहं रामं परपुरंजयमक् ।\nप्रणम्यक शिरसा राममेवमस्त्वित्यथाब्रवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2042001, "chapter_id": 1933, "verse_number": "५-१७८-७२", "content_sanskrit": "एवमुक्त्वा ययौ रामः कुरुक्षेत्रं युयुत्सया ।\nप्रविश्य नगरं चाहं सत्यवत्यै न्यवेदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2042002, "chapter_id": 1933, "verse_number": "५-१७८-७३", "content_sanskrit": "ततः कृतस्वस्त्ययनो मात्रा च प्रतिनन्दितः।\nद्विजातीन्वाच्य पुण्याहं स्वस्ति चैव महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2042003, "chapter_id": 1933, "verse_number": "५-१७८-७४", "content_sanskrit": "रथमास्थाय रुचिरं राजतं पाण्डुरैर्हयैः।\nसूपस्करं स्वधिष्ठानं वैयाघ्रपरिवारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2042004, "chapter_id": 1933, "verse_number": "५-१७८-७५", "content_sanskrit": "उपपन्नं महाशस्त्रैः सर्वोपकरणान्वितम् ।\nतत्कुलीनेन वीरेण हयशास्त्रविदा रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2042005, "chapter_id": 1933, "verse_number": "५-१७८-७६", "content_sanskrit": "यत्तं सूतेन शिष्टेन बहुशो दृष्टकर्मणा ।\nदंशितः पाण्डुरेणाहं कवचेन वपुष्मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2042006, "chapter_id": 1933, "verse_number": "५-१७८-७७", "content_sanskrit": "पाण्डुरं कार्मुकं गृह्य प्रायां भरतसत्तम ।\nपाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2042007, "chapter_id": 1933, "verse_number": "५-१७८-७८", "content_sanskrit": "पाण्डुरैश्चापि व्यजनैर्वीज्यमानो नराधिप ।\nशुक्लवासाः सितोष्णीषः सर्वशुक्लविभूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2042008, "chapter_id": 1933, "verse_number": "५-१७८-७९", "content_sanskrit": "स्तूयमानो जयाशीर्भिर्निष्क्रम्य गजसाह्वयात्।\nकुरुक्षेत्रं रणक्षेत्रमुपायां भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2042009, "chapter_id": 1933, "verse_number": "५-१७८-८०", "content_sanskrit": "ते हयाश्चोदितास्तेन सूतेन परमाहवे ।\nअवहन्मां भृशं राजन्मनोमारुतरंहसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2042010, "chapter_id": 1933, "verse_number": "५-१७८-८१", "content_sanskrit": "गत्वाऽहं तत्कुरुक्षेत्रं स च रामः प्रतापवान् ।\nयुद्धाय सहसा राजन्पराक्रान्तौ परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2042011, "chapter_id": 1933, "verse_number": "५-१७८-८२", "content_sanskrit": "ततः सदर्शनेऽतिष्ठं रामस्यातितपस्विनः ।\nप्रगृह्य शङ्खप्रवरंक ततः प्राधममुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2042012, "chapter_id": 1933, "verse_number": "५-१७८-८३", "content_sanskrit": "ततस्तत्र द्विजा राजंस्तापसाश्च वनौकसः।\nअपश्यन्त रणं दिव्यं देवाः सेन्द्रगणास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2042013, "chapter_id": 1933, "verse_number": "५-१७८-८४", "content_sanskrit": "ततो दिव्यानि माल्यानि प्रादुरासंस्ततस्ततः।\nवादित्राणि च दिव्यानि मेघवृन्दानि चैव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2042014, "chapter_id": 1933, "verse_number": "५-१७८-८५", "content_sanskrit": "ततस्ते तापसाः सर्वे भार्गवस्यानुयायिनः ।\nप्रेक्षकाः समपद्यन्त परिवार्य रणाजिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2042015, "chapter_id": 1933, "verse_number": "५-१७८-८६", "content_sanskrit": "ततो मामब्रवीद्देवी सर्वभूतहितैषिणी ।\nमाता स्वरूपिणी राजन्किमिदं ते चिकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2042016, "chapter_id": 1933, "verse_number": "५-१७८-८७", "content_sanskrit": "गत्वाऽहं जामदग्न्यं तु प्रयाचिष्ये कुरूद्वह ।\nभूष्मेण सह मा योत्सीः शिष्येणेति पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2042017, "chapter_id": 1933, "verse_number": "५-१७८-८८", "content_sanskrit": "मा मैवं पुत्र निर्बन्धं कुरु विप्रेण पार्थिव ।\nजामदग्न्येन समरे योद्धुमित्येव भर्त्सयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2042018, "chapter_id": 1933, "verse_number": "५-१७८-८९", "content_sanskrit": "किं न वै क्षत्रियहणो हरतुल्यपराक्रमः ।\nविदितः पुत्र रामस्ते यतस्तं योद्धुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2042019, "chapter_id": 1933, "verse_number": "५-१७८-९०", "content_sanskrit": "ततोऽहमब्रवं देवीमभिवाद्य कृताञ्जलिः।\nसर्वं तद्भरतश्रेष्ठ यथावृत्तं स्वयंवरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2042020, "chapter_id": 1933, "verse_number": "५-१७८-९१", "content_sanskrit": "यथा च रामो राजेन्द्र मया पूर्वं प्रचोदितः ।\nकाशिराजसुतायाश्च यथा कर्म पुरातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2042021, "chapter_id": 1933, "verse_number": "५-१७८-९२", "content_sanskrit": "ततः सा राममभ्येत्य जननी मे महानदी।\nमदर्थं तमृषिं वीक्ष्य क्षमयामास भार्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2042022, "chapter_id": 1933, "verse_number": "५-१७८-९३", "content_sanskrit": "भीष्मेण सह मा योत्सीः शिष्येणेति वचोऽब्रवीत् ।\nस च तामाह याचन्तीं भीष्ममेव निवर्तय।\nन च मे कुरुते काममित्यहं तमुपागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2042023, "chapter_id": 1933, "verse_number": "५-१७८-९४", "content_sanskrit": "ततो गङ्गा सुतस्नोहान्मां सा पुनरुपागमत्।\nनास्या अकरवं वाक्यं क्रोधपर्याकुलेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2042024, "chapter_id": 1933, "verse_number": "५-१७८-९५", "content_sanskrit": "अथादृश्यत धर्मात्मा भृगुश्रेष्ठो महातपाः।\nआह्वयामास च तदा युद्धाय द्विजसत्तमः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2042025, "chapter_id": 1933, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वमि अम्बोपाख्यानपर्वणि अष्टसप्तत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]