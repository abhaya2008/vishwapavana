[{"id": 7006223000, "chapter_id": 26223, "verse_number": "२-५१-१", "content_sanskrit": "सगर उवाच कुशलं मम सर्वत्र महर्षे नात्र संशयः ।\nयस्य मे त्वमनुध्याता शमं भार्गवसत्तमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006223001, "chapter_id": 26223, "verse_number": "२-५१-२", "content_sanskrit": "यस्तथा शिक्षितः पूर्वमस्त्रे शस्त्रे च सांप्रतम् ।\nसोऽहं कथमशक्तः स्यां सकलारिविनिग्रहे ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006223002, "chapter_id": 26223, "verse_number": "२-५१-३", "content_sanskrit": "त्वं मे गुरुः सुहृद्दैवं बन्धुर्मित्रं च केवलम् ।\nन ह्यन्यमभिजानामि त्वामृते पितरं च मे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006223003, "chapter_id": 26223, "verse_number": "२-५१-४", "content_sanskrit": "त्वयोपदिष्टेनास्त्रेण सकला भूभृतो मया ।\nविजिता यदनुस्मृत्या शक्तिः सा तपसस्तव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006223004, "chapter_id": 26223, "verse_number": "२-५१-५", "content_sanskrit": "तपसा त्वं जगत्सर्वं पुनासि परिपासि च ।\nस्रष्टुं संहर्त्तुमपि च शक्नोष्येव न संशयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006223005, "chapter_id": 26223, "verse_number": "२-५१-६", "content_sanskrit": "महाननन्यसामान्यप्रभावस्तपसश्च ते ।\nइह तस्यैकदेशोऽपि दृश्यते विस्मयप्रदः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006223006, "chapter_id": 26223, "verse_number": "२-५१-७", "content_sanskrit": "पश्यसिंहासने बाल्यादुपेत्य मृगपोतकः ।\nपिबत्यंभः शनैर्ब्रह्मन्निःशङ्कं ते तपोवने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006223007, "chapter_id": 26223, "verse_number": "२-५१-८", "content_sanskrit": "धयत्यत्रातिविस्रंभात्कृशापि हरिणी स्तनम् ।\nकरोति मृगशृङ्गाग्रे गण्डकण्डूयनं रुरुः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006223008, "chapter_id": 26223, "verse_number": "२-५१-९", "content_sanskrit": "नवप्रसूतां हरिणीं हत्वा वृत्त्यै वनान्तरे ।\nव्याघ्री त्वत्तपसावासे सैव पुष्णाति तच्छिशून् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006223009, "chapter_id": 26223, "verse_number": "२-५१-१०", "content_sanskrit": "गजं द्रुतमनुद्रुत्य सिंहो यस्मादिदं वनम् ।\nप्रविष्टोऽनुसरन्तौ त्वद्भयादेकत्र तिष्ठतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006223010, "chapter_id": 26223, "verse_number": "२-५१-११", "content_sanskrit": "नकुलस्त्वाशुमार्जारमयूरशशपन्नगाः ।\nवृकसूकरशार्दूलशरभर्क्षप्लवङ्गमाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006223011, "chapter_id": 26223, "verse_number": "२-५१-१२", "content_sanskrit": "सृगाला गवयागावो हरिणा महिषास्तथा ।\nवनेऽत्र सहजं वैरं हित्वा मैत्रीमुपागताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006223012, "chapter_id": 26223, "verse_number": "२-५१-१३", "content_sanskrit": "एवंविधा तपःशक्तिर्लोकविस्मयदायिनी ।\nन क्वापि दृश्यते ब्रह्मंस्त्वामृते भुवि दुर्लभा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006223013, "chapter_id": 26223, "verse_number": "२-५१-१४", "content_sanskrit": "अहं तु त्वत्प्रसादेन विजित्य वसुधामि माम् ।\nरिपुभिः सह विप्रर्षे स्वराज्यं समुपागतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006223014, "chapter_id": 26223, "verse_number": "२-५१-१५", "content_sanskrit": "वश्यामात्यस्त्रिवर्गेऽपि यथायोग्यकृतादरः ।\nत्वयोपदिष्टमार्गेण सम्यग्राज्यमपालयम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006223015, "chapter_id": 26223, "verse_number": "२-५१-१६", "content_sanskrit": "एवं प्रवर्त्तमानस्य मम राज्येऽवतिष्ठतः ।\nभवद्दिदृक्षा संजाता सापेक्षा भृगुपुङ्गव ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006223016, "chapter_id": 26223, "verse_number": "२-५१-१७", "content_sanskrit": "किं त्वद्य मयि पर्याप्तमनपत्यतयैव मे ।\nपितृपिण्डप्रदानेन सह संरक्षणं भुवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006223017, "chapter_id": 26223, "verse_number": "२-५१-१८", "content_sanskrit": "तदिदं दुःशमत्यर्थमनिवार्यं मनोगतम् ।\nनानयोऽपहर्त्तां लोकंऽस्मिन्ममेति त्वामुपागतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006223018, "chapter_id": 26223, "verse_number": "२-५१-१९", "content_sanskrit": "इत्युक्तः सगरेणाथ स्थित्वा सोऽतर्मनाः क्षणम् ।\nउवाच भगवानौर्वः सनिदेशमिदं वचः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006223019, "chapter_id": 26223, "verse_number": "२-५१-२०", "content_sanskrit": "नियम्य सह भार्याभ्यां किञ्चित्कालमिहावस ।\nअवाप्स्यति ततोऽभीष्टं भवान्नात्र विचारमा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006223020, "chapter_id": 26223, "verse_number": "२-५१-२१", "content_sanskrit": "स च तत्रावसत्प्रीतस्तच्छुश्रूषापरायमः ।\nपत्नीभ्यां सह धर्मात्मा भक्तियुक्तश्चिरं तदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006223021, "chapter_id": 26223, "verse_number": "२-५१-२२", "content_sanskrit": "राजपत्न्यौ च ते तस्य सर्वकालमतन्द्रिते ।\nमुनेरतनुतां प्रीतिं विनयाचारभक्तिभिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006223022, "chapter_id": 26223, "verse_number": "२-५१-२३", "content_sanskrit": "भक्त्या शुश्रूषया चैव तयोस्तुष्टो महामुनिः ।\nराजपत्न्यौ समाहूय इदं वचनम ब्रवीत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006223023, "chapter_id": 26223, "verse_number": "२-५१-२४", "content_sanskrit": "भवत्यौ वरमस्मत्तो व्रियतां काममीप्सितम् ।\nदास्यामि तं न संदेहो यद्यपि स्यात्सुदुर्ल्लभम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006223024, "chapter_id": 26223, "verse_number": "२-५१-२५", "content_sanskrit": "ततः प्रणम्यशिरसा तेऽप्युभे तं महामुनिम् ।\nऊचतुर्भगवान्पुत्रान्कामयावेति सादरम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006223025, "chapter_id": 26223, "verse_number": "२-५१-२६", "content_sanskrit": "ततस्ते भगवानाह भवतीभ्यां मया पुनः ।\nराज्ञश्चप्रियकामेन वरो दत्तोऽयमीप्सितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006223026, "chapter_id": 26223, "verse_number": "२-५१-२७", "content_sanskrit": "पुत्रवत्यौ महाभागे भवत्यौ मत्प्रसादतः ।\nभवेतां ध्रुवमन्यच्च श्रूयतां वचनं मम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006223027, "chapter_id": 26223, "verse_number": "२-५१-२८", "content_sanskrit": "पुत्रो भविष्यत्येकस्यामेकः सोऽनतिधार्मिकः ।\nतथापि तस्य कल्पान्तं संभूतिश्च भविष्यति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006223028, "chapter_id": 26223, "verse_number": "२-५१-२९", "content_sanskrit": "षष्टिः पुत्रसहस्राणामपरस्यां च जायते ।\nअकृतार्थाश्च ते सर्वे विनङ्क्ष्यन्त्यचिरादिव ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006223029, "chapter_id": 26223, "verse_number": "२-५१-३०", "content_sanskrit": "एवंविधगुणेपेतो वरौ दत्तौ मया युवाम् ।\nअभीप्सितं तु यद्यस्याः स्वेच्छया तत्प्रकीर्त्यताम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006223030, "chapter_id": 26223, "verse_number": "२-५१-३१", "content_sanskrit": "एवमुक्ते तु मुनिना वैदर्भ्यान्वयवर्द्धनम् ।\nवरयामास तनयं पुत्रानन्यास्तथा परा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006223031, "chapter_id": 26223, "verse_number": "२-५१-३२", "content_sanskrit": "इति दत्त्वा वरं राज्ञे सगराय महामुनिः ।\nसभार्यामनुमान्यैनं विससर्ज पुरीं प्रति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006223032, "chapter_id": 26223, "verse_number": "२-५१-३३", "content_sanskrit": "मुनिना समनुज्ञातः कृत कृत्यो महीपतिः ।\nरथमारुह्य वेगेन सप्रियः प्रययौ पुरीम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006223033, "chapter_id": 26223, "verse_number": "२-५१-३४", "content_sanskrit": "स प्रविश्य पुरीं रम्यां त्दृष्टपुष्टजनावृताम् ।\nआनन्दितः पौरजनै रेमे परमया मुदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006223034, "chapter_id": 26223, "verse_number": "२-५१-३५", "content_sanskrit": "एतस्मिन्नेव काले तु राजपत्न्यावुभे नृप ।\nराज्ञे प्रावोचतां गर्भं मुदा परमया युते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006223035, "chapter_id": 26223, "verse_number": "२-५१-३६", "content_sanskrit": "ववृधे च तयोर्गर्भः शुक्लपक्षे यथोडुराट् ।\nसह संतोषसंपत्त्या पित्रोः पौरजनस्य च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006223036, "chapter_id": 26223, "verse_number": "२-५१-३७", "content_sanskrit": "संपूर्णे तु ततः काले मुहूर्ते केशिनीशुभे ।\nअसूयताग्निगर्भाभं कुमारममितद्युतिम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006223037, "chapter_id": 26223, "verse_number": "२-५१-३८", "content_sanskrit": "जातकर्मादिकं तस्य कृत्वा चैव यथाविधि ।\nअसमञ्चस इत्येव नाम तस्या करोन्नृपः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006223038, "chapter_id": 26223, "verse_number": "२-५१-३९", "content_sanskrit": "सुमतिश्चापि तत्काले गर्भालाबमसूयत ।\nसंप्रसूतं तु तं त्यक्तं दृष्ट्वा राजाकरोन्मनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006223039, "chapter_id": 26223, "verse_number": "२-५१-४०", "content_sanskrit": "तज्ज्ञात्वा भगवानौर्वस्तत्रागच्छद्यदृच्छया ।\nसम्यक्संभावितो राज्ञा तमुवाच त्वरान्वितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006223040, "chapter_id": 26223, "verse_number": "२-५१-४१", "content_sanskrit": "गर्भालाबुरयं राजन्न त्यक्तुं भवतार्हति ।\nपुत्राणां षष्टिसाहस्रबीजभूतो यतस्तव ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006223041, "chapter_id": 26223, "verse_number": "२-५१-४२", "content_sanskrit": "तस्मात्तत्सकलीकृत्य घृतकुंभेषु यत्नतः ।\nनिःक्षिप्य सपिधानेषु रक्षणीयं पृथक्पृथक् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006223042, "chapter_id": 26223, "verse_number": "२-५१-४३", "content_sanskrit": "सम्यगेवं कृते राजन्भवतो मत्प्रसादतः ।\nयथोक्तसंख्या पत्राणां भविष्यति न संशयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006223043, "chapter_id": 26223, "verse_number": "२-५१-४४", "content_sanskrit": "काले पूर्णे ततः कुम्भान्भित्त्वा निर्यान्ति ते पृथक् ।\nएवं ते षष्टिसाहस्रं पुत्राणां जायते नृप ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006223044, "chapter_id": 26223, "verse_number": "२-५१-४५", "content_sanskrit": "इत्युक्त्वा भगवानौर्वस्तत्रैवान्तरधाद्विभुः ।\nराजा च तत्तथा चक्रे यथौर्वेण समीरितम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006223045, "chapter_id": 26223, "verse_number": "२-५१-४६", "content_sanskrit": "ततः संवत्सरे पूर्णे घृतकुंभात्क्रमेण ते ।\nभित्त्वाभित्त्वा पुनर्जज्ञुः सहसैवानुवासरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006223046, "chapter_id": 26223, "verse_number": "२-५१-४७", "content_sanskrit": "एवं क्रमेण संजातास्तनयास्ते महीपते ।\nववृधुः संघशो राजन्षष्टिसाहस्रसंख्याया ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006223047, "chapter_id": 26223, "verse_number": "२-५१-४८", "content_sanskrit": "अपृथग्धर्मचरणा महाबलपराक्रमाः ।\nबभूवुस्ते दुराधर्षाः क्रूरात्मानो विशेषतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006223048, "chapter_id": 26223, "verse_number": "२-५१-४९", "content_sanskrit": "स नातिप्रीतिमांस्तेषु राजा मतिमतां वरः ।\nकेशिनीतनयं त्वेकं बहुमान सुतं प्रियम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006223049, "chapter_id": 26223, "verse_number": "२-५१-५०", "content_sanskrit": "विवाहं विधिवत्तस्मै कारयामास पार्थिवः ।\nसचाप्यानन्दयामास स्वगुणैः सुहृदोऽखिलान् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006223050, "chapter_id": 26223, "verse_number": "२-५१-५१", "content_sanskrit": "एवं प्रवर्त मानस्य केशिनीतनयस्य तु ।\nअजायत सुतः श्रीमानंशुमानिति विश्रुतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006223051, "chapter_id": 26223, "verse_number": "२-५१-५२", "content_sanskrit": "स बाल्य एव मतिमानुदारैः स्वगुणैर्भृशम् ।\nप्रीणयामास सुत्दृदः स्वपितामहमेव च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006223052, "chapter_id": 26223, "verse_number": "२-५१-५३", "content_sanskrit": "एतस्मिन्नन्तरे राज्ञस्तस्य पुत्रोऽसमञ्जसः ।\nआविष्टो नष्टचेष्टोऽभूत्स पिशाचेन केन चित् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006223053, "chapter_id": 26223, "verse_number": "२-५१-५४", "content_sanskrit": "स तु कश्चिदभूद्वैश्यः पूर्वजन्मनि धर्मवित् ।\nकस्याचिद्विषये राज्ञः प्रभूतधनधान्यवान् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006223054, "chapter_id": 26223, "verse_number": "२-५१-५५", "content_sanskrit": "स कदाचिदरण्येषु विचरन्निधिमुत्तमम् ।\nदृष्ट्वा ग्रहीतुमारेभे वणिग्लोभवरिप्लुतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006223055, "chapter_id": 26223, "verse_number": "२-५१-५६", "content_sanskrit": "ततस्तद्रक्षकोऽभ्येत्य पिशाचः प्राह तं तदा ।\nक्षुधितोऽहं चिरादस्मिन्निवसन्निधिपालकः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006223056, "chapter_id": 26223, "verse_number": "२-५१-५७", "content_sanskrit": "तस्मात्तत्परिहाराय मम दत्त्वा गवामिषम् ।\nकामतः प्रतिगृह्णीष्व निधिमेनं ममाज्ञया ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006223057, "chapter_id": 26223, "verse_number": "२-५१-५८", "content_sanskrit": "सतस्मै तत्परिश्रुत्य दास्यामीति गवामिषम् ।\nआदत्त च निधिं तं तु पिशाचेनानुमोदितः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006223058, "chapter_id": 26223, "verse_number": "२-५१-५९", "content_sanskrit": "न प्रादाच्च ततो मौढ्यात्तस्मै यत्तत्प्रतिश्रुतम् ।\nप्रतिश्रुताप्रदानोत्थरोषं न श्रद्दधे नृप ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006223059, "chapter_id": 26223, "verse_number": "२-५१-६०", "content_sanskrit": "तमेवं सुचिरं कालं प्रतीक्ष्याशनकाङ्क्षया ।\nअपनीतधनः सोऽपि ममार व्यथितः क्षुधा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006223060, "chapter_id": 26223, "verse_number": "२-५१-६१", "content_sanskrit": "वैश्योऽपि बालो मरणं संप्राप्य सगरस्य तु ।\nबभूव काले केशिन्यां तनयोऽन्वयवर्द्धनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006223061, "chapter_id": 26223, "verse_number": "२-५१-६२", "content_sanskrit": "अशरीरः पिशाचेऽपि पूर्ववैरमनुस्मरन् ।\nवायुभूतोऽविशद्देहं राजपुत्रस्य भूपते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006223062, "chapter_id": 26223, "verse_number": "२-५१-६३", "content_sanskrit": "तेनाविष्टस्ततः सोऽपि क्रूरचित्तोऽभवत्तदा ।\nमतिविभ्रंशमासाद्य मुहुस्तेन बलात्कृतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006223063, "chapter_id": 26223, "verse_number": "२-५१-६४", "content_sanskrit": "असमञ्जसत्वं नगरे चक्रे सोऽपि नृशंसवत् ।\nबालांश्च यूनः स्थविरान्योषितश्च सदा खलः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006223064, "chapter_id": 26223, "verse_number": "२-५१-६५", "content_sanskrit": "हत्वाहत्वा प्रचिक्षेप सरय्वामतिनिर्दयः ।\nततः पौरजनाः सर्वे दृष्ट्वा तस्य कदर्यताम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006223065, "chapter_id": 26223, "verse_number": "२-५१-६६", "content_sanskrit": "बहुशो निकृतास्तेन गत्वा राज्ञे व्यजिज्ञापन् ।\nराजा च तदुपश्रुत्य तमाहूय प्रयत्नतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006223066, "chapter_id": 26223, "verse_number": "२-५१-६७", "content_sanskrit": "वारयामास बहुधा दुःखेन महतान्वितः ।\nबहुशः प्रतिषिद्धोऽपि पित्रा तेन महात्मना ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006223067, "chapter_id": 26223, "verse_number": "२-५१-६८", "content_sanskrit": "जले तप्ते च संतप्ताः संबभूवुर्यथा यवाः ।\nनाशकत्तं यदा पापाद्विनिवर्त्तयितुं नृपः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006223068, "chapter_id": 26223, "verse_number": "२-५१-६९", "content_sanskrit": "लोकापवादभीरुत्वाद्विषयानत्यजत्तदा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]