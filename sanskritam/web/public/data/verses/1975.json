[{"id": 2043493, "chapter_id": 1975, "verse_number": "६-२४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043494, "chapter_id": 1975, "verse_number": "६-२४-१", "content_sanskrit": "केषां प्रहृष्टास्तत्राग्रे योधा युध्यन्ति सञ्जय।\nउदग्रमनसः के वा के वा दीना विचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043495, "chapter_id": 1975, "verse_number": "६-२४-२", "content_sanskrit": "के पूर्वं प्राहरंस्तत्र युद्धे हृदयकम्पने ।\nमामकाः पाण्डवेया वा तन्ममाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043496, "chapter_id": 1975, "verse_number": "६-२४-३", "content_sanskrit": "कस्य सेनासमुदये गन्धो माल्यसमुद्भवः ।\nवायुः प्रदक्षिणश्चैव योधानामभिगर्जताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043497, "chapter_id": 1975, "verse_number": "६-२४-४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043498, "chapter_id": 1975, "verse_number": "६-२४-४", "content_sanskrit": "उभयोः सेनयोस्तत्र योधा जहृषिरे तदा।\nस्रजः समाः सुगन्धानामुभयत्र समुद्भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043499, "chapter_id": 1975, "verse_number": "६-२४-५", "content_sanskrit": "संहतानामनीकानां व्यूढानां भरतर्षभ ।\nसंसर्गात्समुदीर्णानां विमर्दः सुमहानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043500, "chapter_id": 1975, "verse_number": "६-२४-६", "content_sanskrit": "वादित्रशब्दस्तुमुलः शङ्खभेरीविमिश्रितः।\nशूराणां रणशूराणां गर्जतामितरेतरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043501, "chapter_id": 1975, "verse_number": "६-२४-७", "content_sanskrit": "उभयोः सेनयो राजन्महान्व्यतिकरोऽभवत्।\nअन्योन्यं वीक्षमाणानां योधानां भरतर्षभ।\nकुञ्जराणां च नदतां सैन्यानां च प्रहृष्यताम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043502, "chapter_id": 1975, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि चतुर्विशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]