[{"id": 2055297, "chapter_id": 2212, "verse_number": "७-१३९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2055298, "chapter_id": 2212, "verse_number": "७-१३९-१", "content_sanskrit": "ततः कर्णो महाराज भीमं विद्धा त्रिभिः शूरैः।\n`पुनश्च षड्भिस्तीक्ष्णाग्रैरविध्यत्कङ्कपत्रिभिः।\nमुमोच शरवर्षाणि विचित्राणि बहूनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2055299, "chapter_id": 2212, "verse_number": "७-१३९-२", "content_sanskrit": "वध्यमानो महाबाहुः सूतपुत्रेण पाण्डवः।\nन विव्यथे भीमसेनो भिद्यमान इवाचलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2055300, "chapter_id": 2212, "verse_number": "७-१३९-३", "content_sanskrit": "स कर्णं कर्णिना कर्णे पीतेन निशितेन च।\nविव्याध सुभृशं सङ्ख्ये तैलधौतेन मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2055301, "chapter_id": 2212, "verse_number": "७-१३९-४", "content_sanskrit": "स कुण्डलं महच्चारु कर्णस्यापातयद्भुवि।\nतपनीयं महाराज दीप्तं ज्योतिरिवाम्बरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2055302, "chapter_id": 2212, "verse_number": "७-१३९-५", "content_sanskrit": "अथापरेण भल्लेन सूतपुत्रं स्तनान्तरे।\nआजघान भृशं क्रुद्धो हसन्निव वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2055303, "chapter_id": 2212, "verse_number": "७-१३९-६", "content_sanskrit": "पुनरस्य त्वरन्भीपो नाराचान्दश भारत।\nरणे प्रैषीन्महाबाहुर्निर्मुक्ताशीविषोपमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2055304, "chapter_id": 2212, "verse_number": "७-१३९-७", "content_sanskrit": "ते ललाटं विनिर्भिद्य सूतपुत्रस्य भारत।\nविविशुश्चोदितास्तेन वल्मीकमिव पन्नगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2055305, "chapter_id": 2212, "verse_number": "७-१३९-८", "content_sanskrit": "ललाटस्थैस्ततो बाणैः सूतपुत्रो व्यरोचत।\nनीलोत्पलमयीं मालां धारयन्वै यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2055306, "chapter_id": 2212, "verse_number": "७-१३९-९", "content_sanskrit": "सोऽतिविद्धो भृशं कर्णः पाण्डवेन तरस्विना।\nरथकूबरमालम्ब्य न्यमीलयत लोचने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2055307, "chapter_id": 2212, "verse_number": "७-१३९-१०", "content_sanskrit": "स मुहूर्तात्पुनः संज्ञां लेभे कर्णः परन्तपः।\nरुधिरोक्षितसर्वाङ्गः क्रोधमाहारयत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2055308, "chapter_id": 2212, "verse_number": "७-१३९-११", "content_sanskrit": "ततः क्रुद्धो रणे कर्णः पीडितो दृढधन्वना।\nवेगं चक्रे महावेगो भीमसेनरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2055309, "chapter_id": 2212, "verse_number": "७-१३९-१२", "content_sanskrit": "तस्मै कर्णः शतं राजन्निषूणां गार्ध्रवाससाम्।\nअमर्षी बलवान्क्रुद्धः प्रेषयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2055310, "chapter_id": 2212, "verse_number": "७-१३९-१३", "content_sanskrit": "ततः प्रासृजदुग्राणि शरवर्षाणि पाण्डवः।\nसमरे तमनादृत्य तस्य वीर्यमचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2055311, "chapter_id": 2212, "verse_number": "७-१३९-१४", "content_sanskrit": "कर्णस्ततो महाराज पाण्डवं नवभिः शरैः।\nआजघानोऽसि क्रुद्धः क्रुद्धरूपं परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2055312, "chapter_id": 2212, "verse_number": "७-१३९-१५", "content_sanskrit": "तावुभौ नरशार्दूलौ शार्दूलाविव दंष्ट्रिणौ।\n`शरदंष्ट्रौ समासाद्य ततक्षतुररिन्दमौ।\nजिमूताविव चान्योन्यं प्रववर्षतुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2055313, "chapter_id": 2212, "verse_number": "७-१३९-१६", "content_sanskrit": "तलशब्दरवैश्चैव त्रासयेतां परस्परम्।\nशरजालैश्च विविधैस्त्रासयामासतुर्मृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2055314, "chapter_id": 2212, "verse_number": "७-१३९-१७", "content_sanskrit": "अन्योन्यं समरे क्रुद्धौ कृतप्रतिकृतैषिणौ।\nततो भीमो महाबाहुः सूतपुत्रस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2055315, "chapter_id": 2212, "verse_number": "७-१३९-१८", "content_sanskrit": "क्षुरप्रेण धनुश्छित्त्वा ननाद परवीरहा।\nतदपास्य धनुश्छिन्नं सूतपुत्रो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2055316, "chapter_id": 2212, "verse_number": "७-१३९-१९", "content_sanskrit": "अन्यत्कार्मुकमादत्त भारघ्नं वेगवत्तरम्।\nतदप्यथ निमेषार्धाच्चिच्छेदास्य वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2055317, "chapter_id": 2212, "verse_number": "७-१३९-२०", "content_sanskrit": "तृतीयं च चतुर्थं च पञ्चमं षष्ठमेव हि।\nसप्तमं चाष्टमं चैव नवमं दशमं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2055318, "chapter_id": 2212, "verse_number": "७-१३९-२१", "content_sanskrit": "एकादशं द्वादशं च त्रयोधशमथापि च।\nचतुर्दशं पञ्चदशं षोडशं च वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2055319, "chapter_id": 2212, "verse_number": "७-१३९-२२", "content_sanskrit": "तथा सप्तदशं वेगादष्टादशमथापि वा।\nबहूनि भीमश्चिच्छेद कर्णस्यैवं धनूंषि हि।\nनिमेषार्धात्ततः कर्णो धनुर्हस्तो व्यतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2055320, "chapter_id": 2212, "verse_number": "७-१३९-२३", "content_sanskrit": "दृष्ट्वा स कुरुसौवीरसिन्धुवीरबलक्षयम्।\nस वर्मध्वजशस्त्रैश्च पतितैः संवृतां महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2055321, "chapter_id": 2212, "verse_number": "७-१३९-२४", "content_sanskrit": "`रथैर्विमथितैर्भल्लैरश्वैश्चान्यैः प्रवल्गितैः।\nभ्रष्टश्रीकैर्नरवरैः पांसुकुण्ठितमूर्धजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2055322, "chapter_id": 2212, "verse_number": "७-१३९-२५", "content_sanskrit": "हस्त्यश्वरथदेहांश्च गतासून्प्रेक्ष्य सर्वशः।\nसूतपुत्रस्य संरम्भाद्दीप्तं वपुरजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2055323, "chapter_id": 2212, "verse_number": "७-१३९-२६", "content_sanskrit": "स विष्फार्य महच्चापं कार्तस्वरविभूषितम्।\nभीमं प्रैक्षत राधेयो घोरं घोरेण चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2055324, "chapter_id": 2212, "verse_number": "७-१३९-२७", "content_sanskrit": "ततः क्रुद्धः शरानस्यन्सूतपुत्रो व्यरो चत।\nमध्यन्दिनगतोऽर्चिष्माञ्शरदीव दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2055325, "chapter_id": 2212, "verse_number": "७-१३९-२८", "content_sanskrit": "मरीचिविकचस्येव राजन्भानुमतो वपुः।\nआसीदाधिरथेर्घोरं वपुः शरशताचितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2055326, "chapter_id": 2212, "verse_number": "७-१३९-२९", "content_sanskrit": "कराभ्यामाददानस्य सन्दधानस्य चाशुगान्।\nकर्षतो मुञ्चतो बाणान्नान्तरं ददृशे रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2055327, "chapter_id": 2212, "verse_number": "७-१३९-३०", "content_sanskrit": "अग्निचक्रोपमं घोरं मण्डलीकृतमायुधम्।\nकर्णस्यासीन्महीपाल सव्यं दक्षिणमस्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2055328, "chapter_id": 2212, "verse_number": "७-१३९-३१", "content_sanskrit": "स्वर्णपुङ्खाः सुनिशिताः कर्मचापच्युताः शराः।\nप्राच्छादयन्महाराज दिशः सूर्य इवांशुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2055329, "chapter_id": 2212, "verse_number": "७-१३९-३२", "content_sanskrit": "ततः कनकपुङ्खानां शराणां नतपर्वणाम्।\nधनुश्च्युतानां वियति ददृशे बहुधा व्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2055330, "chapter_id": 2212, "verse_number": "७-१३९-३३", "content_sanskrit": "बाणासनादाधिरथेः प्रभवन्ति स्म सायकाः।\nश्रेणीकृता व्यरोचन्त राजन्क्रौञ्चा इवाम्बरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2055331, "chapter_id": 2212, "verse_number": "७-१३९-३४", "content_sanskrit": "गार्ध्रपत्राञ्शिलाधौतान्कार्तस्वरविभूषितान्।\nमहावेगान्प्रदीप्ताग्रान्मुमोचाधिरथिः शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2055332, "chapter_id": 2212, "verse_number": "७-१३९-३५", "content_sanskrit": "ते तु चापबलोद्धूताः शातकुम्भविभूषिताः।\nअजस्रमपतन्बाणा भीमसेनरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2055333, "chapter_id": 2212, "verse_number": "७-१३९-३६", "content_sanskrit": "ते व्योम्नि रुक्मविकृता व्यकाशन्त सहस्रशः।\nशलभानामिव व्राताः शराः कर्णसमीरिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2055334, "chapter_id": 2212, "verse_number": "७-१३९-३७", "content_sanskrit": "चापादाधिरथेर्मुक्ताः प्रपतन्तश्चकाशिरे।\nएको दीर्घ इवात्यर्थमाकाशे संस्थितः शरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2055335, "chapter_id": 2212, "verse_number": "७-१३९-३८", "content_sanskrit": "पर्वतं वारिधाराभिच्छादयन्निव तोयदः।\nकर्णः प्राच्छादयत्क्रुद्धो भीमं सायकवृष्टिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2055336, "chapter_id": 2212, "verse_number": "७-१३९-३९", "content_sanskrit": "तत्र भारत भीमस्य बलं वीर्यं पराक्रमम्।\nव्यवसायं च पुत्रास्ते ददृशुः सहसैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2055337, "chapter_id": 2212, "verse_number": "७-१३९-४०", "content_sanskrit": "तां समुद्रमिवोद्भूतां शरवृष्टिं समुत्थिताम्।\nअचिन्तयित्वा भीमस्तु क्रुद्धः कर्णमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2055338, "chapter_id": 2212, "verse_number": "७-१३९-४१", "content_sanskrit": "रुक्मपृष्ठं महच्चापं भीमस्यासीद्विशाम्पते।\nआकर्षान्मण्डलीभूतं शक्रचापमिवापरम्।\nतस्माच्छराः प्रादुरासन्पूरयन्त इवाम्बरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2055339, "chapter_id": 2212, "verse_number": "७-१३९-४२", "content_sanskrit": "सुवर्णपुङ्खैर्भीमेन सायकैर्नतपर्वभिः।\nगगने रचिता माला काञ्चनीव व्यरोचतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2055340, "chapter_id": 2212, "verse_number": "७-१३९-४३", "content_sanskrit": "ततो व्योम्नि विषक्तानि शरजालानि भागशः।\nआहतानि व्यशीर्यन्त भीमसेनस्य पत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2055341, "chapter_id": 2212, "verse_number": "७-१३९-४४", "content_sanskrit": "कर्णस्य शरजालौघैर्भीमसेनस्य चोभयोः।\nअग्निस्फुलिङ्गसंस्पर्शैरञ्जोगतिभिराहवे।\nतैस्तैः कनकपुङ्खानां द्यौरासीत्संवृता व्रजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2055342, "chapter_id": 2212, "verse_number": "७-१३९-४५", "content_sanskrit": "न स्म सूर्यस्तदा भाति न स्म वाति समीरणः।\nशरजालावृते व्योम्नि न प्राज्ञायत किञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2055343, "chapter_id": 2212, "verse_number": "७-१३९-४६", "content_sanskrit": "स भिमं छादयन्बाणैः सूतपुत्रः पृथग्विधैः।\nउपारोहदनादृत्य तस्य वीर्यं महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2055344, "chapter_id": 2212, "verse_number": "७-१३९-४७", "content_sanskrit": "तयोर्विसृजतोस्तत्र शरजालानि मारिष।\nवायुभूतान्यदृश्यन्त संसक्तानीतरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2055345, "chapter_id": 2212, "verse_number": "७-१३९-४८", "content_sanskrit": "अन्योन्यशरसंसम्पर्शात्तयोर्मनुजसिंहयोः।\nआकाशे भरतश्रेष्ठ पावकः समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2055346, "chapter_id": 2212, "verse_number": "७-१३९-४९", "content_sanskrit": "तथा कर्णः शितान्बाणान्कर्मारपरिमार्जितान्।\nसुवर्णविकृतान्क्रुद्धः प्राहिणोद्वधकाङ्क्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2055347, "chapter_id": 2212, "verse_number": "७-१३९-५०", "content_sanskrit": "तानन्तरिक्षे विशिखैस्त्रिधैकैकमशातयत्।\nविशेषयन्सूतपुत्रं भीमस्तिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2055348, "chapter_id": 2212, "verse_number": "७-१३९-५१", "content_sanskrit": "पुनश्चासृजदुग्राणि शरवर्षाणि पाण्डवः।\nअमर्षी बलवान्क्रुद्धौ दिधक्षन्निव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2055349, "chapter_id": 2212, "verse_number": "७-१३९-५२", "content_sanskrit": "ततश्चटचटाशब्दो गोधाघातादभूत्तयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2055350, "chapter_id": 2212, "verse_number": "७-१३९-५३", "content_sanskrit": "तलशब्दश्च सुभहान्सिंहनादश्च भैरवः।\nरथनेमिनिनादश्च ज्याशब्दश्चैव दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2055351, "chapter_id": 2212, "verse_number": "७-१३९-५४", "content_sanskrit": "योधा व्युपारमन्युद्धाद्दिदृक्षन्तः पराक्रमम्।\nकर्णपाण्डवयो राजन्परस्परवधैषिणोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2055352, "chapter_id": 2212, "verse_number": "७-१३९-५५", "content_sanskrit": "देवर्षिसिद्धगन्धर्वाः साधुसाध्वित्यपूजयन्।\nमुमुचुः पुष्पवर्षं च विद्याधरगणास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2055353, "chapter_id": 2212, "verse_number": "७-१३९-५६", "content_sanskrit": "ततो भीमो महाबाहुः संरम्भी दृढविक्रमः।\nअस्त्रैरस्त्राणि संवार्य शरैर्विव्याध सूतजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2055354, "chapter_id": 2212, "verse_number": "७-१३९-५७", "content_sanskrit": "कर्णोऽपि भीमसेनस्य निवार्येषून्महाबलः।\nप्राहिणोन्नव नाराचानाशीविषसमान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2055355, "chapter_id": 2212, "verse_number": "७-१३९-५८", "content_sanskrit": "तावद्भिरथ तान्भीमो व्योम्नि चिच्छेद पत्रिभिः।\nनाराचान्सूत पुत्रस्य तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2055356, "chapter_id": 2212, "verse_number": "७-१३९-५९", "content_sanskrit": "ततो भीमो महाबाहुः शरं क्रुद्धान्तकोपमम्।\nमुमोचाधिरथेर्वीरो यमदण्डमिवापरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2055357, "chapter_id": 2212, "verse_number": "७-१३९-६०", "content_sanskrit": "तमापतन्तं चिच्छेद राधेयः प्रहसन्निव।\nत्रिभिः शरैः शरं राजन्पाण्डवस्य प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2055358, "chapter_id": 2212, "verse_number": "७-१३९-६१", "content_sanskrit": "पुनश्चासृजदुग्राणि शरवर्षाणि पाण्डवः।\nतस्य तान्याददे कर्णः सर्वाण्यस्त्राण्यभीतवत्।\nयुध्यमानस्य भीमस्य सूतपुत्रोऽस्त्रमायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2055359, "chapter_id": 2212, "verse_number": "७-१३९-६२", "content_sanskrit": "तस्येषुधी धनुर्ज्यां च बाणैः सन्नतपर्वभिः।\nरश्मीन्योक्त्राणि चाश्वानां क्रुद्धः कर्णोऽच्छिनन्मृधे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2055360, "chapter_id": 2212, "verse_number": "७-१३९-६३", "content_sanskrit": "तस्याश्वांश्च पुनर्हत्वा सूतं विव्याध पञ्चभिः।\nसोपसृत्य द्रुतं सूतो युधामन्यो रथं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2055361, "chapter_id": 2212, "verse_number": "७-१३९-६४", "content_sanskrit": "विहसन्निव भीमस्य क्रुद्धः कालानलद्युतिः।\nध्वजं चिच्छेद राधेयः पताकां च व्यपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2055362, "chapter_id": 2212, "verse_number": "७-१३९-६५", "content_sanskrit": "स विधन्वा महाबाहुरथ शक्तिं परामृशत्।\nतां व्यवासृजदाविध्य क्रुद्धः कर्णरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2055363, "chapter_id": 2212, "verse_number": "७-१३९-६६", "content_sanskrit": "तामाधिरथिरायस्तः शक्तिं काञ्चनभूषणाम्।\nआपतन्तीं महोल्काभां चिच्छेद दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2055364, "chapter_id": 2212, "verse_number": "७-१३९-६७", "content_sanskrit": "साऽपतद्दृशधा छिन्ना कर्णस्य निशितैः शरैः।\nअस्यतः सूतपुत्रस्य मित्रार्थे चित्रयोधिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2055365, "chapter_id": 2212, "verse_number": "७-१३९-६८", "content_sanskrit": "स चर्मादत्त कौन्तेयो जातरूपपरिष्कृतम्।\nखङ्गं चान्यतरप्रेप्सुर्जयं मरणमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2055366, "chapter_id": 2212, "verse_number": "७-१३९-६९", "content_sanskrit": "तदस्य तरसा क्रुद्धो व्यधमच्चर्म सुप्रभम्।\nशरैर्बहुभिरत्युग्रैः प्रहसन्निव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2055367, "chapter_id": 2212, "verse_number": "७-१३९-७०", "content_sanskrit": "स विचर्मा महाराज विरथः क्रोधमूर्च्छितः।\nअसिं प्रासृजदाविध्य त्वरन्कर्णरथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2055368, "chapter_id": 2212, "verse_number": "७-१३९-७१", "content_sanskrit": "स धनुः सूतपुत्रस्य सज्यं छित्त्वा महानसिः।\nपपात भुवि राजेन्द्र क्रुद्धः सर्प इवाम्बरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2055369, "chapter_id": 2212, "verse_number": "७-१३९-७२", "content_sanskrit": "ततः प्रहस्याधिरथिरन्यदादाय कार्मुकम्।\nशत्रुघ्नं समरे क्रुद्धो दृढज्यं वेगवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2055370, "chapter_id": 2212, "verse_number": "७-१३९-७३", "content_sanskrit": "व्यायच्छत्स शरान्कर्णः कुन्तीपुत्रजिघांसया।\nसहस्रशो महाराज रुक्मपुङ्खान्सुतेजनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2055371, "chapter_id": 2212, "verse_number": "७-१३९-७४", "content_sanskrit": "स वध्यमानो बलवान्कर्णचापच्युतैः शरैः।\nवैहायसं प्राक्रमद्धै कर्णस्य रथमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2055372, "chapter_id": 2212, "verse_number": "७-१३९-७५", "content_sanskrit": "स तस्य चरितं दृष्ट्वा सङ्ग्रामे विजयैषिणः।\nध्वजालयस्थो राधेयो भीमसेनमवञ्चयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2055373, "chapter_id": 2212, "verse_number": "७-१३९-७६", "content_sanskrit": "तमदृष्ट्वा रथोपस्थे निलीनं व्यथितेन्द्रियम्।\nध्वजमस्य समारुह्य तस्मै भीमो महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2055374, "chapter_id": 2212, "verse_number": "७-१३९-७७", "content_sanskrit": "तदस्य कुरवः सर्वे चाणाश्चाभ्यपूजयन्।\nयदियेष रथात्कर्णं हर्तुं तार्क्ष्य इवोरगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2055375, "chapter_id": 2212, "verse_number": "७-१३९-७८", "content_sanskrit": "स च्छिन्नधन्वा विरथः स्वधर्ममनुपालयन्।\nस्वरथं पृष्ठतः कृत्वा युद्धायैव व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2055376, "chapter_id": 2212, "verse_number": "७-१३९-७९", "content_sanskrit": "तद्विचिन्त्य स राधेयस्तत एनं समभ्ययात्।\nसंरम्भात्पाण्डवं सङ्ख्ये युद्धाय समुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2055377, "chapter_id": 2212, "verse_number": "७-१३९-८०", "content_sanskrit": "तौ समेतौ महाराज स्पर्धमानौ महाबलौ।\nजीमूताविव घर्मान्ते गर्जमानौ नरर्षभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2055378, "chapter_id": 2212, "verse_number": "७-१३९-८१", "content_sanskrit": "तयोरासीत्संप्रहारः क्रुद्धयोर्नरसिंहयोः।\nअमृष्यमाणयोः सङ्ख्ये देवदानवयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2055379, "chapter_id": 2212, "verse_number": "७-१३९-८२", "content_sanskrit": "क्षीणशस्त्रस्तु कौन्तेयः कर्णेन समभिद्रुतः।\nदृष्ट्वाऽर्जुनहतान्नागान्पतितान्पर्वतोपमान्।\nरथमार्गविघातार्थं व्यायुधः प्रविवेश ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2055380, "chapter_id": 2212, "verse_number": "७-१३९-८३", "content_sanskrit": "हस्तिनां व्रजमासाद्य रथदुर्गं प्रविश्य च।\nपाण्डवो जीविताकाङ्क्षी राधेयं नाभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2055381, "chapter_id": 2212, "verse_number": "७-१३९-८४", "content_sanskrit": "व्यवस्थानमथाकाङ्क्षन्धनञ्जयशरैर्हतम्।\nउद्यम्य कुञ्जरं पार्थस्तस्थौ परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2055382, "chapter_id": 2212, "verse_number": "७-१३९-८५", "content_sanskrit": "महौषधिसमायुक्तं हनूमानिव पर्वतम्।\nतमस्य विशिखैः कर्णो व्यधमत्कुञ्जरं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2055383, "chapter_id": 2212, "verse_number": "७-१३९-८६", "content_sanskrit": "हस्त्यङ्गान्यथ कर्णाय प्राहिणोत्पाण्डुनन्दनः।\nचक्राण्यश्चांस्तथा चान्यद्यद्यत्पश्यति भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2055384, "chapter_id": 2212, "verse_number": "७-१३९-८७", "content_sanskrit": "तत्तदादाय चिक्षेप क्रुद्धः कर्णाय पाण्डवः।\nतदस्य सर्वं चिच्छेद क्षिप्तंक्षिप्तं शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2055385, "chapter_id": 2212, "verse_number": "७-१३९-८८", "content_sanskrit": "भीमोऽपि मुष्टिमुद्यम्य वज्रगर्भं सुदारुणम्।\nहन्तुमैच्छत्सूतपुत्रं संस्परन्नर्जुनं क्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2055386, "chapter_id": 2212, "verse_number": "७-१३९-८९", "content_sanskrit": "शक्तोऽपि नावधीत्कर्णं समर्थः पाण्डुनन्दनः।\nरक्षमाणः प्रतिज्ञां तां या कृता सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2055387, "chapter_id": 2212, "verse_number": "७-१३९-९०", "content_sanskrit": "तमेवं व्याकुलं भीमं भूयोभूयः शितैः शरैः।\nमूर्च्छयाभिपरीताङ्गमकरोत्सूतनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2055388, "chapter_id": 2212, "verse_number": "७-१३९-९१", "content_sanskrit": "व्यायुधं नावधीच्चैनं कर्णः कुन्त्या वचः स्मरन्।\nधनुषोग्रेण तं कर्णः सोऽभिद्रुत्य परामृशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2055389, "chapter_id": 2212, "verse_number": "७-१३९-९२", "content_sanskrit": "धनुषा स्पृष्टमात्रेण क्रुद्धः सर्प इव श्वसन्।\nआच्छिद्य स धनुस्तस्य कर्णं मूर्धन्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2055390, "chapter_id": 2212, "verse_number": "७-१३९-९३", "content_sanskrit": "ताडितो भीमसेनेन क्रोधादारक्तलोचनः।\nविहसन्निव राधेयो वाक्यमेतदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2055391, "chapter_id": 2212, "verse_number": "७-१३९-९४", "content_sanskrit": "पुनः पुनस्तूबरक मूढ औदरिकेति च।\nअकृतास्त्रक मा योत्सीर्बाल सङ्ग्रामकातर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2055392, "chapter_id": 2212, "verse_number": "७-१३९-९५", "content_sanskrit": "यत्र भोज्यं बहुविधं भक्ष्यं पेयं च पाण्डव।\nतत्र त्वं दुर्मते योग्यो न युद्धेषु कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2055393, "chapter_id": 2212, "verse_number": "७-१३९-९६", "content_sanskrit": "मूलपुष्पफलाहारो व्रतेषु नियमेषु च।\nउचितस्त्वं वने भीम न त्वं युद्धविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2055394, "chapter_id": 2212, "verse_number": "७-१३९-९७", "content_sanskrit": "क्व युद्वं क्व मुनित्वं च वनं गच्छ वृकोदर।\nन त्वं युद्धोचितस्तात वनवासरतिर्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2055395, "chapter_id": 2212, "verse_number": "७-१३९-९८", "content_sanskrit": "सूदान्भृत्यजनान्दासांस्त्वं गृहे त्वरयन्भृशम्।\nयोग्यस्ताडयितुं क्रोधाद्भोजनार्थं वृकोदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2055396, "chapter_id": 2212, "verse_number": "७-१३९-९९", "content_sanskrit": "मुनिर्भूत्वाऽथवा भीम फलान्यादत्स्व दुर्मते।\nवनाय व्रज कौन्तेय न त्वं युद्धविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2055397, "chapter_id": 2212, "verse_number": "७-१३९-१००", "content_sanskrit": "फलमूलाशने शक्तस्त्वं तथाऽतिथिपूजने।\nन त्वां शस्त्रसमुद्योगे योग्यं मन्ये वृकोदर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2055398, "chapter_id": 2212, "verse_number": "७-१३९-१०१x", "content_sanskrit": "`सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2055399, "chapter_id": 2212, "verse_number": "७-१३९-१०१", "content_sanskrit": "एवं तं विरथं दृष्ट्वा स्मृत्वा कर्णोऽब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2055400, "chapter_id": 2212, "verse_number": "७-१३९-१०२", "content_sanskrit": "कौमारे यानि वृत्तानि विप्रियाणि विशाम्पते।\nतानि सर्वाणि चाप्येव रूक्षाण्यश्रावयद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2055401, "chapter_id": 2212, "verse_number": "७-१३९-१०३", "content_sanskrit": "अथैनं तत्र संलीनमस्पृशद्धनुषा पुनः।\nप्रहसंश्च पुनर्वाक्यं भीममाह वृषस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2055402, "chapter_id": 2212, "verse_number": "७-१३९-१०४", "content_sanskrit": "योद्धव्यं मारिषान्यत्र न योद्धव्यं च मादृशैः।\nमादृशैर्युध्यमानानामेतच्चान्यच्च विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2055403, "chapter_id": 2212, "verse_number": "७-१३९-१०५", "content_sanskrit": "गच्छ वा यत्र तौ कृष्णौ तौ त्वां रक्षिष्यतो रणे।\nगृहं वा गच्छ कौन्तेय किं ते युद्धेन बालक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2055404, "chapter_id": 2212, "verse_number": "७-१३९-१०६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2055405, "chapter_id": 2212, "verse_number": "७-१३९-१०६", "content_sanskrit": "कर्णस्य वचनं श्रुत्वा भीमसेनोऽतिदारुणम्।\nउवाच कर्णं प्रहसन्सर्वेषां शृण्वतां वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2055406, "chapter_id": 2212, "verse_number": "७-१३९-१०७", "content_sanskrit": "जितस्त्वमसकृद्दुष्ट कत्थसे किं वृथात्मना।\nजयाजयौ महेन्द्रस्य लोके दृष्टौ पुरातनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2055407, "chapter_id": 2212, "verse_number": "७-१३९-१०८", "content_sanskrit": "मल्लयुद्धं मया सार्धं कुरु दुष्कुलसम्भव।\nमहाबलो महाभोगी कीचको निहतो यथा।\nतथा त्वां घातयिष्यामि पश्यत्सु सर्वराजसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2055408, "chapter_id": 2212, "verse_number": "७-१३९-१०९", "content_sanskrit": "भीमस्य मतमाज्ञाय कर्णो बुद्धिमतां वरः।\nविरराम रणात्तस्मात्पश्यतां सर्वधन्विनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2055409, "chapter_id": 2212, "verse_number": "७-१३९-११०", "content_sanskrit": "एवं तं विरथं कृत्वा कर्णो राजन्व्यकत्थयत्।\nप्रसुखे वृष्णिसिंहस्य पार्थस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2055410, "chapter_id": 2212, "verse_number": "७-१३९-१११", "content_sanskrit": "तं ब्रुवाणं तु भीमः स काङ्क्षन्भीमपराक्रमः।\nन चाकार्षीन्मृतं स्मृत्वा ह्यर्जुनस्य महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2055411, "chapter_id": 2212, "verse_number": "७-१३९-११२", "content_sanskrit": "तस्य कार्मुकमारुज्य बभञ्जाशुपराक्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2055412, "chapter_id": 2212, "verse_number": "७-१३९-११३", "content_sanskrit": "ततो दृष्ट्वा महाराज वासुदेवो महाद्युतिः।\nअर्जुनार्जुन पश्येमं भीमं कर्णेन बाधितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2055413, "chapter_id": 2212, "verse_number": "७-१३९-११४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2055414, "chapter_id": 2212, "verse_number": "७-१३९-११४", "content_sanskrit": "एवमुक्तस्तदा पार्थः केशवेन महात्मना।\nभीमसेनं तथाभूतं क्रोधसंरक्तलोचनः।\nअमर्षवशमापन्नो निर्दहन्निव चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2055415, "chapter_id": 2212, "verse_number": "७-१३९-११५", "content_sanskrit": "ततो राजञ्शिलाधौताञ्शराञ्शाखामृगध्वजः।\nप्राहिणोत्सूतपुत्राय केशवेन प्रचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2055416, "chapter_id": 2212, "verse_number": "७-१३९-११६", "content_sanskrit": "ततः पार्थभुजोत्सृष्टाः शराः कनकभूषणाः।\nगाण्डीवप्रभवाः कर्णं हंसाः क्रौञ्चमिवाविशन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2055417, "chapter_id": 2212, "verse_number": "७-१३९-११७", "content_sanskrit": "स भुजङ्गैरिवाविष्टैर्गाण्डीवप्रेषितैः शरैः।\nभीमसेनादपासेधत्सूतपुत्रं धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2055418, "chapter_id": 2212, "verse_number": "७-१३९-११८", "content_sanskrit": "स च्छिन्नधन्वा भीमेन धनञ्जयशराहतः।\nकर्णो भीमादपायासीद्रथेन महता द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2055419, "chapter_id": 2212, "verse_number": "७-१३९-११९", "content_sanskrit": "भीमोऽपि सात्यकेर्वाहं समारुह्य नरर्षभः।\nअन्वयाद्धातरं सङ्ख्ये पाण्डवं सव्यसाचिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2055420, "chapter_id": 2212, "verse_number": "७-१३९-१२०", "content_sanskrit": "ततः कर्णं समुद्दिश्य त्वरमाणो धनञ्चयः।\nनाराचं क्रोधताम्राक्षः प्रैषीन्मृत्युमिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2055421, "chapter_id": 2212, "verse_number": "७-१३९-१२१", "content_sanskrit": "स गरुत्मानिवाकशे प्रार्थयन्भुजगोत्तमम्।\nनाराचोऽभ्यपतत्कर्णं तूर्णं गाण्डीवचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2055422, "chapter_id": 2212, "verse_number": "७-१३९-१२२", "content_sanskrit": "तमन्तरिक्षे नाराचं द्रौणिश्चिच्छेद पत्रिणा।\nधनञ्जयभयात्कर्णमुज्जिहीर्षन्महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2055423, "chapter_id": 2212, "verse_number": "७-१३९-१२३", "content_sanskrit": "ततो द्रौणिं चतुःषष्ट्या विव्याध कुपितोऽर्जुनः।\nशिलीमुखैर्महाराज मागास्तिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2055424, "chapter_id": 2212, "verse_number": "७-१३९-१२४", "content_sanskrit": "स तु मत्तगजाकीर्णमनीकं रथसङ्कुलम्।\nतूर्णमभ्याविशद्द्रौणिर्धनञ्जयशरार्दितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2055425, "chapter_id": 2212, "verse_number": "७-१३९-१२५", "content_sanskrit": "ततः सुवर्णपृष्ठानां चापानां कूजतां रणे।\nशब्दं गाण्डीवघोषेण कौन्तेयोऽभ्यभवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2055426, "chapter_id": 2212, "verse_number": "७-१३९-१२६", "content_sanskrit": "धनञ्जयस्तथाऽऽयान्तं पृष्ठतो द्रौणिमभ्यगात्।\nनातिदीर्घमिवाध्वानं शरैः सन्त्रासयन्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2055427, "chapter_id": 2212, "verse_number": "७-१३९-१२७", "content_sanskrit": "विदार्य देहान्नाराचैर्नरवारणवाजिनाम्।\nकङ्कबर्हिणवासोभिर्बलं व्यधमदर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2055428, "chapter_id": 2212, "verse_number": "७-१३९-१२८", "content_sanskrit": "तद्बलं भरतश्रेष्ठ सवाजिद्विपमानवम्।\nपाकशासनिरायत्तः पार्थः स निजघान ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2055429, "chapter_id": 2212, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे एकोनचत्वारिंशदधिकशततमोऽध्यायः॥ १३९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१३९-४६ उपारोहत्सन्निकर्षमगात्॥ ५-१३९-४७ वायुभूतानि वातोद्भूतान्यतिवेगवन्ति वा॥ ५-१३९-७४ वैहायसमाकाशम्॥ ५-१३९-७५ लयमङ्गसङ्कोचम्॥ ५-१३९-८७ तद्रथादिसाधनम्॥ ५-१३९-८८ वज्रगर्भमन्तर्विहिताङ्गुष्ठम्॥ ५-१३९-८९ समर्थः समीचीनार्थो धर्मापेक्षीति यावत्॥ ५-१३९-९४ तूबरकः पुंश्चिह्नरहितः षण्ड इतियावत्। तूबरोऽश्मश्रुपुरुषे इत्युपक्रम्य पुरुषव्यञ्जनत्यक्तो इति मेदिनी। औदरिको बह्वाशी॥ ५-१३९-९६ व्रतेषु नियमेषु आगन्तुकेषु॥ ५-१३९-१०३ संलीनं सङ्कुचिताङ्गम्॥ ५-१३९-११० व्यकत्थयत् भर्त्सितवान्॥ ५-१३९-१३९ एकोनचत्वारिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}]