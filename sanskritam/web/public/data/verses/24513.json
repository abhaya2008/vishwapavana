[{"id": 7004513000, "chapter_id": 24513, "verse_number": "५-३-२०७-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nतस्याग्रे पावनं तीर्थं स्वर्णबिन्द्विति विश्रुतम् ।\nयत्र स्नात्वा दिवं यान्ति मृताश्च न पुनर्भवम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004513001, "chapter_id": 24513, "verse_number": "५-३-२०७-२", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा दत्ते विप्राय काञ्चनम् ।\nतेन यत्तु फलं प्रोक्तं तच्छृणुष्व महीपते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004513002, "chapter_id": 24513, "verse_number": "५-३-२०७-३", "content_sanskrit": "सर्वेषामेव रत्नानां काञ्चनं रत्नमुत्तमम् ।\nअग्नितेजःसमुद्भूतं तेन तत्परमं भुवि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004513003, "chapter_id": 24513, "verse_number": "५-३-२०७-४", "content_sanskrit": "तेनैव दत्ता पृथिवी सशैलवनकानना ।\nसपत्तनपुरा सर्वा काञ्चनं यः प्रयच्छति॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004513004, "chapter_id": 24513, "verse_number": "५-३-२०७-५", "content_sanskrit": "मानसं वाचिकं पापं कर्मणा यत्पुरा कृतम् ।\nतत्सर्वं नश्यति क्षिप्रं स्वर्णदानेन भारत॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004513005, "chapter_id": 24513, "verse_number": "५-३-२०७-६", "content_sanskrit": "स्वर्णदानं तु यो दत्त्वा ह्यपि वालाग्रमात्रकम् ।\nतत्र तीर्थे मृतो याति दिवं नास्त्यत्र संशयः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004513006, "chapter_id": 24513, "verse_number": "५-३-२०७-७", "content_sanskrit": "तत्र विद्याधरैः सिद्धैर्विमानवरमास्थितः ।\nपूज्यमानो वसेत्तावद्यावदाभूतसम्प्लवम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004513007, "chapter_id": 24513, "verse_number": "५-३-२०७-८", "content_sanskrit": "पूर्णे तत्र ततः काले प्राप्य मानुष्यमुत्तमम् ।\nसुवर्णकोटिसहिते गृहे वै जायते द्विजः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004513008, "chapter_id": 24513, "verse_number": "५-३-२०७-९", "content_sanskrit": "सर्वव्याधिविनिर्मुक्तः सर्वलोकेषु पूजितः ।\nजीवेद्वर्षशतं साग्रं राजसं सत्सु विश्रुतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]