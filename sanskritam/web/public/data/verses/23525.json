[{"id": 7003525000, "chapter_id": 23525, "verse_number": "१६५-१", "content_sanskrit": "श्रीवराह उवाच ।\nअतः परं प्रवक्ष्यामि तच्छृणुष्व वसुन्धरे ।\nयथावृत्तं प्रतिष्ठाने दक्षिणापथमण्डले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003525001, "chapter_id": 23525, "verse_number": "१६५-२", "content_sanskrit": "सुशीलो नाम वैश्यस्तु तस्मिन्वसति पत्तने ।\nधनधान्यसमृद्धस्तु बहुपुत्रः कुटुम्बवान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003525002, "chapter_id": 23525, "verse_number": "१६५-३", "content_sanskrit": "कुटुम्बभरणासक्तो नित्यकालं हि तिष्ठति ।\nस्नानं दानं जपं होमं देवार्चां न करोति सः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003525003, "chapter_id": 23525, "verse_number": "१६५-४", "content_sanskrit": "क्रयविक्रयसक्तस्य कालो दीर्घो गतस्तदा ।\nकदाचिदपि पापोऽसौ न साधु गमनं गतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003525004, "chapter_id": 23525, "verse_number": "१६५-५", "content_sanskrit": "न तेन धर्मश्रवणं कदाचिदपि संश्रुतम् ।\nदेवानां ब्राह्मणानां च भक्तिस्तस्य न विद्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003525005, "chapter_id": 23525, "verse_number": "१६५-६", "content_sanskrit": "आत्मोदरनिमित्तं हि पापं च कुरुते सदा ।\nगच्छन्तं बहुकालं च न तं बुध्यति पापकृत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003525006, "chapter_id": 23525, "verse_number": "१६५-७", "content_sanskrit": "न तस्य जायते बुद्धिर्दानं दातुं कदाचन ।\nतस्यैवं वसतस्तत्र प्रतिष्ठाने पुरोत्तमे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003525007, "chapter_id": 23525, "verse_number": "१६५-८", "content_sanskrit": "धनयुक्तोऽपि पापोऽसौ न ददाति कदाचन ।\nनैवान्यमतिदातारं शक्नोति च निरीक्षितुम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003525008, "chapter_id": 23525, "verse_number": "१६५-९", "content_sanskrit": "स तु कालेन महता कुटुम्बासक्तमानसः ।\nकदाचिद्दैवयोगेन साध्वीं भार्यां प्रियान्सुतान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003525009, "chapter_id": 23525, "verse_number": "१६५-१०", "content_sanskrit": "त्यक्त्वा जगाम निधनं प्रेतत्वं समुपागतः ।\nनिरुदकेषु देशेषु विच्छायेषु वनेषु च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003525010, "chapter_id": 23525, "verse_number": "१६५-११", "content_sanskrit": "परिभ्रमन्क्षुधाविष्टो मरुदेशं गतोऽपि सः ।\nतत्रैव च कृतावासो बहुकालं स वै वणिक् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003525011, "chapter_id": 23525, "verse_number": "१६५-१२", "content_sanskrit": "कदाचिद्दैवयोगेन तत्र सार्थ उपागतः ।\nतस्य मध्ये तु वणिजो मथुरायां विनिःसृताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003525012, "chapter_id": 23525, "verse_number": "१६५-१३", "content_sanskrit": "गते सार्थे तु स वणिक् तं वृक्षं समुपाश्रितः ।\nतत्रैव वसति प्रेतो रौद्ररूपो भयानकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003525013, "chapter_id": 23525, "verse_number": "१६५-१४", "content_sanskrit": "दीर्घदंष्ट्रः सुविकटो ह्रस्वबाहुर्विभीषणः ।\nमहाहनुर्विशालाक्षो बिडालसदृशाननः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003525014, "chapter_id": 23525, "verse_number": "१६५-१५", "content_sanskrit": "अथ कालेन बहुना दैवयोगेन भामिनि ।\nतत्राजगाम कश्चित्तु क्रयविक्रयकारकः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003525015, "chapter_id": 23525, "verse_number": "१६५-१६", "content_sanskrit": "तं दृष्ट्वा दूरतः प्रेतश्चातिहर्षेण संयुतः ।\nतत्राजगाम नृत्यन् स इदं वचनमब्रवीत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003525016, "chapter_id": 23525, "verse_number": "१६५-१७", "content_sanskrit": "भक्ष्यभूतो ममाद्यत्वं क्व भवान्यातुमिच्छति।\nप्रेतस्य वचनं श्रुत्वा सोऽतिभीतो द्रुतङ्गतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003525017, "chapter_id": 23525, "verse_number": "१६५-१८", "content_sanskrit": "गच्छन्तं तं गृहीत्वा स प्रेतो वचनमब्रवीत्।\nमम त्वं विहितो भक्ष्यः स्वयं प्राप्तोऽसि मानव ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003525018, "chapter_id": 23525, "verse_number": "१६५-१९", "content_sanskrit": "मांसं ते भक्षयिष्यामि पिबामि तव शोणितम् ।\nइत्याकर्ण्य वचस्तस्य स वणिग्वाक्यमब्रवीत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003525019, "chapter_id": 23525, "verse_number": "१६५-२०", "content_sanskrit": "कुटुम्बभरणार्थाय सम्प्राप्तो दुर्गमाटवीम् ।\nवृद्धः पिता मम गृहे माता पत्नी पतिव्रता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003525020, "chapter_id": 23525, "verse_number": "१६५-२१", "content_sanskrit": "मयि सम्भक्षिते रक्षः कुटुम्बं हि मरिष्यति ।\nततो वचनमाकर्ण्य प्रेतो वचनमब्रवीत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003525021, "chapter_id": 23525, "verse_number": "१६५-२२", "content_sanskrit": "कस्मात्स्थानात्समायातः सत्यं ब्रूहि महामते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003525022, "chapter_id": 23525, "verse_number": "१६५-२३", "content_sanskrit": "विभुरुवाच ।\nगोवर्द्धनो गिरिवरो यमुना च महानदी ।\nतयोर्मध्ये पुरी रम्या मथुरा लोकविश्रुता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003525023, "chapter_id": 23525, "verse_number": "१६५-२४", "content_sanskrit": "तस्यां वसाम्यहं प्रेत पितृपैतामहे गृहे ।\nतत्र मे वसतो नित्यं यद्द्रव्यं पूर्वसञ्चितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003525024, "chapter_id": 23525, "verse_number": "१६५-२५", "content_sanskrit": "तत्सर्वं तस्करैर्नीतं क्षीणवित्तोऽभवं तदा ।\nस्वल्पं वित्तं गृहीत्वा ऽहं समायातो मरुस्थलम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003525025, "chapter_id": 23525, "verse_number": "१६५-२६", "content_sanskrit": "तव दृष्टिपथं यातो यत्कार्यं तत्कुरुष्व मे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003525026, "chapter_id": 23525, "verse_number": "१६५-२७", "content_sanskrit": "प्रेत उवाच ।\nन त्वां खादितुमिच्छामि कृपा मे जायते त्वयि ।\nसमयेन हि मोक्ष्यामि कुरुष्व वचनं मम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003525027, "chapter_id": 23525, "verse_number": "१६५-२८", "content_sanskrit": "निर्वृत्य गच्छ मथुरां मम कार्यार्थसाधकः ।\nतत्र गत्वा त्वया कार्यं यत्कर्तव्यं वदामि तत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003525028, "chapter_id": 23525, "verse_number": "१६५-२९", "content_sanskrit": "स्नानं कृत्वा तु विधिवत्कूपे चातुःसामुद्रिके ।\nपिण्डदानं कुरुष्व त्वं मम नाम्ना प्रयत्नतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003525029, "chapter_id": 23525, "verse_number": "१६५-३०", "content_sanskrit": "स्नानस्य च फलं देहि ततो गच्छ यथासुखम् ।\nप्रेतवाक्यं ततः श्रुत्वा विभुर्वचनमब्रवीत्।165.३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003525030, "chapter_id": 23525, "verse_number": "१६५-३१", "content_sanskrit": "नाहं यास्यामि मथुरां द्रव्याभावे कथंचन ।\nभक्षयस्व शरीरं मे ततस्तृप्तिमवाप्स्यसि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003525031, "chapter_id": 23525, "verse_number": "१६५-३२", "content_sanskrit": "प्रेत उवाच ।\nगृहे बहुधनं तेऽस्ति त्वं गच्छ मम सत्कुरु ।\nआस्ते धनमपर्याप्तं गच्छ त्वं मा विलम्बय ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003525032, "chapter_id": 23525, "verse_number": "१६५-३३", "content_sanskrit": "विभुरुवाच ।\nगृहे मम धनं नास्ति यत्त्वया समुदीरितम् ।\nगृहशेषं मम धनं न चान्यत्तत्र विद्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003525033, "chapter_id": 23525, "verse_number": "१६५-३४", "content_sanskrit": "पितृपैतामही कीर्त्तिरविक्रेया हि सा मया ।\nप्रेतः प्रहस्य सानन्दमिदं वचनमब्रवीत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003525034, "chapter_id": 23525, "verse_number": "१६५-३५", "content_sanskrit": "अस्ति चैव धनं प्रोक्तं यन्मया त्वद्गृहे विभो ।\nसुवर्णभारो गर्त्तस्थो गृहे तिष्ठति सञ्चितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003525035, "chapter_id": 23525, "verse_number": "१६५-३६", "content_sanskrit": "निवर्त्त गच्छ संतुष्टः सुहृदां प्रीतिवर्द्धनः ।\nएवं द्रक्ष्यामि ते मार्गं मथुरा येन गम्यते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003525036, "chapter_id": 23525, "verse_number": "१६५-३७", "content_sanskrit": "सूत उवाच ।\nवणिग्घृष्टमना भूत्वा पुनर्वचनमब्रवीत् ।\nइमामवस्थां सम्प्राप्य कथं ज्ञानसमुद्भवः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003525037, "chapter_id": 23525, "verse_number": "१६५-३८", "content_sanskrit": "ततः स कथयामास यद्वृत्तं हि पुरातनम् ।\nप्रतिष्ठाने पुरवरे विष्णोरायतनं महत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003525038, "chapter_id": 23525, "verse_number": "१६५-३९", "content_sanskrit": "प्रभातसमये तत्र विष्णोरायतने शुभे ।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्रास्तत्र समागताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003525039, "chapter_id": 23525, "verse_number": "१६५-४०", "content_sanskrit": "वाचकस्तत्र पठति कथां पौराणिकीं शुभाम् ।\nमम मित्रं च तत्रैव नित्यकालं च गच्छति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003525040, "chapter_id": 23525, "verse_number": "१६५-४१", "content_sanskrit": "तस्मिन्काले तु मित्रेण नीतोऽहं विष्णुमन्दिरम्।\nअत्यादरेण महता सन्तोष्य च पुनः पुनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003525041, "chapter_id": 23525, "verse_number": "१६५-४२", "content_sanskrit": "मित्रेण सह तत्रैव तस्य पार्श्वे व्यवस्थितः ।\nश्रुतो मया ततः कूपः पुण्योऽयं पापनाशनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003525042, "chapter_id": 23525, "verse_number": "१६५-४३", "content_sanskrit": "समुद्राः किल तिष्ठन्ति चत्वारोऽत्र समागताः ।\nतस्य कूपस्य माहात्म्यं श्रुतं तत्र महत्फलम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003525043, "chapter_id": 23525, "verse_number": "१६५-४४", "content_sanskrit": "वाचकाय ततो दानं दत्तं सर्वैर्महाजनैः ।\nमित्रेण प्रेरितो दाने मया मौनं समाश्रितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003525044, "chapter_id": 23525, "verse_number": "१६५-४५", "content_sanskrit": "मित्रेण च पुनः प्रोक्तं यथाशक्त्या प्रदीयताम् ।\nतदा मित्रमसङ्गेन दत्तो वै स्वर्णमाषकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003525045, "chapter_id": 23525, "verse_number": "१६५-४६", "content_sanskrit": "ततः कालेन महता गतो वैवस्वतक्षयम् ।\nवैवस्वतनियोगेन ततोऽहं पूर्वकर्मभिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003525046, "chapter_id": 23525, "verse_number": "१६५-४७", "content_sanskrit": "प्रेतत्वं समनुप्राप्तो दुस्तरं दुर्गमं महत् ।\nन दत्तं न हुतं चापि तीर्थं नैवावगाहितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003525047, "chapter_id": 23525, "verse_number": "१६५-४८", "content_sanskrit": "न तर्पितास्तु पितरः प्राप्तोऽहं प्रेततां ततः ।\nइत्येत्कथितं सर्वं यन्मां त्वं परिपृच्छसि ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003525048, "chapter_id": 23525, "verse_number": "१६५-४९", "content_sanskrit": "गच्छ त्वं सम्मुखस्तत्र यत्र सा मथुरा पुरी ।\nप्रेतस्य वचनं श्रुत्वा विभुर्वचनमब्रवीत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003525049, "chapter_id": 23525, "verse_number": "१६५-५०", "content_sanskrit": "कथं धारयसे प्राणान्वृक्षमूलं समाश्रितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003525050, "chapter_id": 23525, "verse_number": "१६५-५१", "content_sanskrit": "प्रेत उवाच ।\nकथितं हि मया पूर्वं यद्वृत्तं हि पुरातनम् ।\nवाचकाय तु यद्दत्तं सुवर्णस्य च माषकम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003525051, "chapter_id": 23525, "verse_number": "१६५-५२", "content_sanskrit": "तद्दानस्य प्रभावेण नित्यं तृप्तोऽस्मि वै विभो ।\nअकामेन मया दत्तं तस्येदं कर्मणः फलम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003525052, "chapter_id": 23525, "verse_number": "१६५-५३", "content_sanskrit": "प्रेतभावं गतस्यापि न मे ज्ञानस्य विभ्रमः ।\nततश्च स वणिक्श्रेष्ठ आगत्य मथुरां पुरीम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003525053, "chapter_id": 23525, "verse_number": "१६५-५४", "content_sanskrit": "कृतं तेन च तत्सर्वं यथा प्रेतेन भाषितम् ।\nप्रेतोऽसौ तेन कृत्येन मुक्तिं प्राप्य दिवं गतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003525054, "chapter_id": 23525, "verse_number": "१६५-५५", "content_sanskrit": "एतत्ते कथितं भूमे माहात्म्यं मथुराभवम् ।\nचतुःसामुद्रिके कूपे पिण्डदाने परां गतिम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003525055, "chapter_id": 23525, "verse_number": "१६५-५६", "content_sanskrit": "तीर्थे चैव गृहे वापि देवस्थानेऽपि चत्वरे ।\nयत्र तत्र मृता देवि मुक्तिं यान्ति न चान्यथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003525056, "chapter_id": 23525, "verse_number": "१६५-५७", "content_sanskrit": "अन्यत्र हि कृतं पापं तीर्थमासाद्य गच्छति ।\nतीर्थे तु यत्कृतं पापं वज्रलेपो भविष्यति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003525057, "chapter_id": 23525, "verse_number": "१६५-५८", "content_sanskrit": "मथुरायां कृतं पापं तत्रैव च विनश्यति ।\nएषा पुरी महापुण्या यस्यां पापं न विद्यते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003525058, "chapter_id": 23525, "verse_number": "१६५-५९", "content_sanskrit": "कृतघ्नश्च सुरापश्च चौरो भग्नव्रतस्तथा ।\nमथुरां प्राप्य मनुजो मुच्यते सर्वकिल्बिषैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003525059, "chapter_id": 23525, "verse_number": "१६५-६०", "content_sanskrit": "तिष्ठेद्युगसहस्रं तु पादेनैकेन यः पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003525060, "chapter_id": 23525, "verse_number": "१६५-६१", "content_sanskrit": "तस्याधिकं भवेत्पुण्यं मथुरायां निवासिनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003525061, "chapter_id": 23525, "verse_number": "१६५-६२", "content_sanskrit": "परदाररता ये च ये नरा अजितेंद्रियाः ।\nमथुरावासिनः सर्वे ते देवा नरविग्रहाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003525062, "chapter_id": 23525, "verse_number": "१६५-६३", "content_sanskrit": "बलिभिक्षाप्रदातारस्ते मृताः क्रोधवर्जिताः ।\nतीर्थस्नानरता ये च देवास्ते नरमूर्तयः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003525063, "chapter_id": 23525, "verse_number": "१६५-६४", "content_sanskrit": "यदन्येषां सहस्रेण ब्राह्मणानां महात्मनाम् ।\nएकेन पूजितेन स्यान्माथुरेणाखिलं हि तत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003525064, "chapter_id": 23525, "verse_number": "१६५-६५", "content_sanskrit": "अनृग्वै माथुरो यत्र चतुर्वेदस्तथापरः ।\nन च वेदैश्चतुर्भिः स्यान्माथुरेण समः क्वचित् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003525065, "chapter_id": 23525, "verse_number": "१६५-६६", "content_sanskrit": "भवन्ति सर्वतीर्थानि पुण्यान्यायतनानि च ।\nमङ्गलानि च सर्वाणि यत्र तिष्ठन्ति माथुराः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003525066, "chapter_id": 23525, "verse_number": "१६५-६७", "content_sanskrit": "चतुर्वेदं परित्यज्य माथुरं पूजयेत्सदा ।\nसिद्धा भूतगणाः सर्वे ये च देवगणा भुवि ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003525067, "chapter_id": 23525, "verse_number": "१६५-६८", "content_sanskrit": "मथुरावासिनो लोकान्पश्यन्ति च चतुर्भुजान् ।\nमथुरायां ये वसन्ति विष्णुरूपा हि ते नराः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003525068, "chapter_id": 23525, "verse_number": "१६५-६९", "content_sanskrit": "ज्ञानिनस्तान्हि पश्यन्ति अज्ञाः पश्यन्ति तान्न च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]