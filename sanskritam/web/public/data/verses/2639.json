[{"id": 2077456, "chapter_id": 2639, "verse_number": "१२-१४४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077457, "chapter_id": 2639, "verse_number": "१२-१४४-१", "content_sanskrit": "अथ वृक्षस्य शाखायां विहंगः ससुहृज्जनः।\nदीर्घकालोषितो राजंस्तत्र चित्रतनूरुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077458, "chapter_id": 2639, "verse_number": "१२-१४४-२", "content_sanskrit": "तस्य कल्यगता भार्या चरितुं नाभ्यवर्तत।\nप्राप्तां च रजनीं दृष्ट्वा स पक्षी पर्यतप्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077459, "chapter_id": 2639, "verse_number": "१२-१४४-३", "content_sanskrit": "वातवर्षं महच्चासीन्न चागच्छति मे प्रिया।\nकिंनु तत्कारणं येन साऽद्यापि न निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077460, "chapter_id": 2639, "verse_number": "१२-१४४-४", "content_sanskrit": "अपि स्वस्ति भवेत्तस्याः प्रियाया मम कानने॥\nतया विरहितं हीदं शून्यमद्य गृहं मम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077461, "chapter_id": 2639, "verse_number": "१२-१४४-५", "content_sanskrit": "पुत्रपौत्रवधूभृत्यैराकीर्णमपि सर्वतः।\nभार्याहीनं गृहस्थस्य शून्यमेव गृहं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077462, "chapter_id": 2639, "verse_number": "१२-१४४-६", "content_sanskrit": "न गृहं गृहमित्याहुर्गृहिणी गृहमुच्यते।\nगृहं तु गृहिणीहीनमरण्यसदृशं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077463, "chapter_id": 2639, "verse_number": "१२-१४४-७", "content_sanskrit": "यदि सा रक्तेत्रान्ता चित्राङ्गी मधुरस्वरा।\nअद्य नाभ्येति मे कान्ता न कार्यं जीवितेन मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077464, "chapter_id": 2639, "verse_number": "१२-१४४-८", "content_sanskrit": "न भुङ्क्ते मय्यभुक्ते या नास्नाते स्नाति सुव्रता।\nनातिष्ठत्युपतिष्ठेन शेते च शयिते मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077465, "chapter_id": 2639, "verse_number": "१२-१४४-९", "content_sanskrit": "हृष्टे भवति सा हृष्टा दुःखिते मयि दुःखिता।\nप्रोपिते दीनवदना क्रुद्धे च प्रियवादिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077466, "chapter_id": 2639, "verse_number": "१२-१४४-१०", "content_sanskrit": "पतिधर्मव्रता साध्वी प्राणेभ्योऽपि गरीयसी।\nयस्य स्यात्तादृशी भार्या धन्यः स पुरुषो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077467, "chapter_id": 2639, "verse_number": "१२-१४४-११", "content_sanskrit": "सा हि श्रान्तं क्षुधार्तं च जानीते मां तपस्विनी।\nअनुरक्ता स्थिरा चैव भक्ता स्निग्धा यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077468, "chapter_id": 2639, "verse_number": "१२-१४४-१२", "content_sanskrit": "वृक्षमूलेऽपि दयिता यस्य तिष्ठति तद्गृहम्।\nप्रासादोपि तया हीनः कान्तार इति निश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077469, "chapter_id": 2639, "verse_number": "१२-१४४-१३", "content_sanskrit": "धर्मार्थकामकालेषु भार्या पुंसः सहायिनी।\nविदेशगमने चास्य सैव विश्वासकारिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077470, "chapter_id": 2639, "verse_number": "१२-१४४-१४", "content_sanskrit": "भार्या हि परमो ह्यर्थः पुरुषस्येह पट्यते।\nअसहायस्य लोकेऽस्मिँल्लोकयात्रासहायिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077471, "chapter_id": 2639, "verse_number": "१२-१४४-१५", "content_sanskrit": "तथा रोगाभिभूतस्य नित्यं कृच्छ्रगतस्य च।\nनास्ति भार्यासमं मित्रं नरस्यार्तस्य भेषजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077472, "chapter_id": 2639, "verse_number": "१२-१४४-१६", "content_sanskrit": "नास्ति भार्यासमो बन्धुर्नास्ति भार्यासमा गतिः।\nनास्ति भार्यासमो लोके सहायो धर्मसंग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077473, "chapter_id": 2639, "verse_number": "१२-१४४-१७", "content_sanskrit": "यस्य भार्या गृहे नास्ति साध्वी च प्रियवादिनी।\nअरण्यं तेन गन्तव्यं यथाऽरण्यं तथा गृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077474, "chapter_id": 2639, "verse_number": "१२-१४४-१८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077475, "chapter_id": 2639, "verse_number": "१२-१४४-१८", "content_sanskrit": "एवं विलपतस्तस्य द्विजस्यार्तस्य वै तदा।\nगृहीता शकुनिघ्नेन भार्या शुश्राव भारतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077476, "chapter_id": 2639, "verse_number": "१२-१४४-१९x", "content_sanskrit": "कपोत्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077477, "chapter_id": 2639, "verse_number": "१२-१४४-१९", "content_sanskrit": "अहोऽतीव सुभाग्याऽहं यस्या मे दयितः पतिः।\nअसतो वा सतो वाऽपि गुणानेवं प्रभाषते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077478, "chapter_id": 2639, "verse_number": "१२-१४४-२०", "content_sanskrit": "सा हि स्त्रीत्यवगन्तव्या यस्य भर्ता तु तुष्यति।\nतुष्टे भर्तरि नारीणां तुष्टाः स्युः सर्वदेवताः।\nअग्निसाक्षिकमप्येतद्भर्ता हि शरणं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077479, "chapter_id": 2639, "verse_number": "१२-१४४-२१", "content_sanskrit": "दावाग्निनेव निर्दग्धा सपुष्पस्तबका लता।\nभस्मीभवति सा नारी यस्या भर्ता न तुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077480, "chapter_id": 2639, "verse_number": "१२-१४४-२२", "content_sanskrit": "इति संचिन्त्य दुःखार्ता भर्तारं दुःखितं तदा।\nकपोती लुब्धकेनापि गृहीता वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077481, "chapter_id": 2639, "verse_number": "१२-१४४-२३", "content_sanskrit": "हन्त वक्ष्यामि ते श्रेयः श्रुत्वा तु कुरु तत्तथा।\nशरणागतसंत्राता भव कान्त विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077482, "chapter_id": 2639, "verse_number": "१२-१४४-२४", "content_sanskrit": "एष शाकुनिकः शेते तव वासं समाश्रितः।\nशीतार्तश्च क्षुधार्तश्च पूजामस्मै समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077483, "chapter_id": 2639, "verse_number": "१२-१४४-२५", "content_sanskrit": "यो हि कश्चिद्द्विजं हन्याद्गां वा लोकस्य मातरम्।\nशरणागतं च यो हन्यात्तुल्यं तेषां च पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2077484, "chapter_id": 2639, "verse_number": "१२-१४४-२६", "content_sanskrit": "अस्माकं विहिता वृत्तिः कापोती जातिधर्मतः।\nसा न्याय्याऽऽत्मवता नित्यं त्वद्विधेनानुवर्तितुं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2077485, "chapter_id": 2639, "verse_number": "१२-१४४-२७", "content_sanskrit": "यस्तु धर्मं यथाशक्ति गृहस्थो ह्यनुवर्तते।\nस प्रेत्य लभते लोकानक्षयानिति शुश्रुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2077486, "chapter_id": 2639, "verse_number": "१२-१४४-२८", "content_sanskrit": "स त्वं संतानवानद्य पुत्रवानपि च द्विज।\nत्वं स्वदेहे दयां त्यक्त्वा धर्मार्थौ परिगृह्य य।\nपूजामस्मै प्रयुङ्क्ष्व त्वं प्रीयेतास्य मनो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2077487, "chapter_id": 2639, "verse_number": "१२-१४४-२९", "content_sanskrit": "शरीरे मा च संतापं कुर्वीथास्त्वं विहगंम।\nशरीरयात्रावृत्त्यर्थमन्यान्दारानुपैष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2077488, "chapter_id": 2639, "verse_number": "१२-१४४-३०", "content_sanskrit": "इति सा शकुनी वाक्यं पञ्जरस्था तपस्विनी।\nअतिदुःखान्विता प्रोक्त्वा भर्तारं समुदैक्षत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2077489, "chapter_id": 2639, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि चतुश्चत्वारिंशदधिशततमोऽध्यायः॥ १४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]