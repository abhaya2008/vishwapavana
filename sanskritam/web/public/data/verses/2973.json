[{"id": 2092706, "chapter_id": 2973, "verse_number": "१३-१०३-१", "content_sanskrit": "युधिष्ठिर उवाच।\nतिलानां कीदृशं दानमथ दीपस्य चैव हि।\nअन्नानां वाससा चैव भूय एव ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092707, "chapter_id": 2973, "verse_number": "१३-१०३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092708, "chapter_id": 2973, "verse_number": "१३-१०३-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nब्राह्मणस्य च संवादं यमस्य च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092709, "chapter_id": 2973, "verse_number": "१३-१०३-३", "content_sanskrit": "मध्यदेशे महान्ग्रामो ब्राह्मणानां बभूव ह।\nगङ्गायमुनयोर्मध्ये यामुनस्य गिरेरधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092710, "chapter_id": 2973, "verse_number": "१३-१०३-४", "content_sanskrit": "पर्णशालेति विख्यातो रमणीयो नराधिप।\nविद्वांशस्तत्र भूयिष्ठा ब्राह्मणाश्चावसंस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092711, "chapter_id": 2973, "verse_number": "१३-१०३-५", "content_sanskrit": "अथ प्राह यमः कञ्चित्पुरुषं कृष्णवाससम्।\nरक्ताक्षमूर्ध्वरोमाणं काकजङ्घाक्षिनासिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092712, "chapter_id": 2973, "verse_number": "१३-१०३-६", "content_sanskrit": "गच्छ त्वं ब्राह्मणग्रामं ततो गत्वा तमानय।\nअगस्त्यं गोत्रतश्चापि नामतश्चापि शर्मिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092713, "chapter_id": 2973, "verse_number": "१३-१०३-७", "content_sanskrit": "शमे निविष्टं विद्वांसमध्यापकमनावृतम्।\nमा चान्यमानयेथास्त्वं सगोत्रं तस्य पार्श्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092714, "chapter_id": 2973, "verse_number": "१३-१०३-८", "content_sanskrit": "स हि तादृग्गुणस्तेन तुल्योऽध्ययनजन्मना।\nअपत्येषु तथा वृत्ते समस्तेनैव धीमता।\nतमानय यथोद्दिष्टं पूजा कार्या हि तस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092715, "chapter_id": 2973, "verse_number": "१३-१०३-९", "content_sanskrit": "स गत्वा प्रतिकूलं तच्चकार यमशासनम्।\nतमाक्रम्यानयामास प्रतिषिद्धो यमेन यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092716, "chapter_id": 2973, "verse_number": "१३-१०३-१०", "content_sanskrit": "तस्मै यमः समुत्थाय पूजा कृत्वा च वीर्यवान्।\nप्रोवाच नीयतामेष सोऽन्य आनीयतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092717, "chapter_id": 2973, "verse_number": "१३-१०३-११", "content_sanskrit": "एवमुक्ते तु वचने धर्मराजेन स द्विजः।\nउवाच धर्मराजानं निर्विण्णोऽध्ययनेन वै।\nयो मे कालो भवेच्छेषस्तं वसेयमिहाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092718, "chapter_id": 2973, "verse_number": "१३-१०३-१२x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092719, "chapter_id": 2973, "verse_number": "१३-१०३-१२", "content_sanskrit": "नाहं कालस्य विहितं प्राप्नोमीह कथञ्चन।\nयो हि धर्मं चरति वै तं तु जानामि केवलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092720, "chapter_id": 2973, "verse_number": "१३-१०३-१३", "content_sanskrit": "गच्छ विप्र त्वमद्यैव आलयं स्वं महाद्युते।\nब्रूहि सर्वं यथा स्वैरं करवाणि किमच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092721, "chapter_id": 2973, "verse_number": "१३-१०३-१४x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092722, "chapter_id": 2973, "verse_number": "१३-१०३-१४", "content_sanskrit": "शुद्धदानं च सुमहत्पुण्यं स्यात्तद्ब्रवीहि मे।\nसर्वस्य हि प्रमाणं त्वं त्रैलोक्यस्यापि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092723, "chapter_id": 2973, "verse_number": "१३-१०३-१५x", "content_sanskrit": "यम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092724, "chapter_id": 2973, "verse_number": "१३-१०३-१५", "content_sanskrit": "शृणु तत्त्वेन विप्रर्पे प्रदानविधिमुत्तमम्।\nतिलाः परमकं दानं पुण्यं चैवेह शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092725, "chapter_id": 2973, "verse_number": "१३-१०३-१६", "content_sanskrit": "तिलाश्च सम्प्रदातव्या यथाशक्ति द्विजर्षभ।\nनित्यदानात्सर्वकामांस्तिला निर्वर्तयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092726, "chapter_id": 2973, "verse_number": "१३-१०३-१७", "content_sanskrit": "तिलाञ्श्राद्धे प्रशंसन्ति दानमेतद्ध्यनुत्तमम्।\nतान्प्रयच्छस्व विप्रेभअयो विधिदृष्टेन कर्मणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092727, "chapter_id": 2973, "verse_number": "१३-१०३-१८", "content_sanskrit": "वैशाख्यां पौर्णमास्यां तु तिलान्दद्याद्द्विजातिषु।\nतिला भक्षयितव्याश्च सदा त्वालम्भं च तैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092728, "chapter_id": 2973, "verse_number": "१३-१०३-१९", "content_sanskrit": "कार्यं सततमिच्छद्भिः श्रेयः सर्वात्मना गृहे।\nतथाऽऽपः सर्वदा देयाः पेयाश्चैव न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092729, "chapter_id": 2973, "verse_number": "१३-१०३-२०", "content_sanskrit": "पुष्करिण्यस्तटाकानि कूपांश्चैवात्र खानयेत्।\nएतत्सुदुर्लभतरमिह लोके द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092730, "chapter_id": 2973, "verse_number": "१३-१०३-२१", "content_sanskrit": "आपो नित्यं प्रदेयास्ते पुण्यं ह्येतदनुत्तमम्।\nप्रपाश्च कार्या दानार्थं नित्यं ते द्विजसत्तम।\nभुक्तेऽप्यथ प्रदेयं तु पानीयं वै विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092731, "chapter_id": 2973, "verse_number": "१३-१०३-२२", "content_sanskrit": "`पानीयाभ्यर्थिनं दृष्ट्वा प्रीत्या दत्त्वा त्वरान्वितः।\nवस्त्रे तन्तुप्रमाणेन दीपे निमिषवत्सरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092732, "chapter_id": 2973, "verse_number": "१३-१०३-२३", "content_sanskrit": "गवां रोमप्रमाणेन स्वर्गभोगमुपाश्नुते।\nजलबिन्दुप्रमाणेन तदेतान्युपवर्तय॥॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092733, "chapter_id": 2973, "verse_number": "१३-१०३-२४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092734, "chapter_id": 2973, "verse_number": "१३-१०३-२४", "content_sanskrit": "इत्युक्ते स तदा तेन यमदूतेन वै गृहान्।\nनीतश्च कारयामास सर्वं तद्यमशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092735, "chapter_id": 2973, "verse_number": "१३-१०३-२५", "content_sanskrit": "नीत्वा तं यमदूतोऽपि गृहीत्वा शर्मिणं तदा।\nययौ स धर्मराजाय न्यवेदयत चापि तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092736, "chapter_id": 2973, "verse_number": "१३-१०३-२६", "content_sanskrit": "तं धर्मराजो धर्मज्ञं पूजयित्वा प्रतापवान्।\nकृत्वा च संविदं तेन विससर्ज यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092737, "chapter_id": 2973, "verse_number": "१३-१०३-२७", "content_sanskrit": "तस्यापि च यमः सर्वमुपदेशं चकार ह।\nप्रेत्यैत्य च ततः सर्वं चकारोक्तं यमेन तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092738, "chapter_id": 2973, "verse_number": "१३-१०३-२८", "content_sanskrit": "तथा प्रशंसने दीपान्यमः पितृहितेप्सया।\nतस्माद्दीपप्रदो नित्यं सन्तारति वै पितॄन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092739, "chapter_id": 2973, "verse_number": "१३-१०३-२९", "content_sanskrit": "दातव्याः सततं दीपास्तस्माद्भरतसत्तम।\nदेवतानां पितॄणां च चक्षुष्यं चात्मनां विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092740, "chapter_id": 2973, "verse_number": "१३-१०३-३०", "content_sanskrit": "रत्नदानं च सुमहत्पुण्यमुक्तं जनाधिप।\nयस्तान्विक्रीय यजते ब्राह्मणो ह्यभयंकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092741, "chapter_id": 2973, "verse_number": "१३-१०३-३१", "content_sanskrit": "यद्वै ददाति विप्रेभ्यो ब्राह्मणः प्रतिगृह्य वै।\nउभयोः स्यात्तदक्षय्यं दातुरादातुरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092742, "chapter_id": 2973, "verse_number": "१३-१०३-३२", "content_sanskrit": "यो ददाति स्थितः स्थित्यां तादृशाय प्रतिग्रहम्।\nउभयोरक्षयं धर्मं तं मनुः प्राह धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092743, "chapter_id": 2973, "verse_number": "१३-१०३-३३", "content_sanskrit": "वाससां सम्प्रदानेनि स्वदारनिरतो नरः।\nसुवस्त्रश्च सुवेषश्च भवतीत्यनुशुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092744, "chapter_id": 2973, "verse_number": "१३-१०३-३४", "content_sanskrit": "गावः सुवर्णं च तथा तिलाश्चैवानुवर्णिताः।\nबहुशः पुरुषव्याघ्र वेदप्रामाण्यदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092745, "chapter_id": 2973, "verse_number": "१३-१०३-३५", "content_sanskrit": "विवाहांश्चैव कुर्वीत पुत्रानुत्पादयेत च।\nपुत्रलाभो हि कौरव्य सर्वलाभाद्विशिष्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092746, "chapter_id": 2973, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्र्यधिकशततमोऽध्यायः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]