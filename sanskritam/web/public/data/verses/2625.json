[{"id": 2076606, "chapter_id": 2625, "verse_number": "१२-१३०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2076607, "chapter_id": 2625, "verse_number": "१२-१३०-१", "content_sanskrit": "त्रैः प्रहीयमाणस्य बह्वमित्रस्य का गतिः।\n-- संक्षीणकोशस्य बलहीनस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2076608, "chapter_id": 2625, "verse_number": "१२-१३०-२", "content_sanskrit": "--मात्यसहायस्य श्रुतमन्त्रस्य सर्वतः।\nज्यात्प्रच्यवमानस्य गतिमन्यामपश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2076609, "chapter_id": 2625, "verse_number": "१२-१३०-३", "content_sanskrit": "परचक्राभियातस्य परराष्ट्राणि मृद्गतः।\nविग्रहे वर्तमानस्य दुर्बलस्य बलीयसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2076610, "chapter_id": 2625, "verse_number": "१२-१३०-४", "content_sanskrit": "असंविहितराष्ट्रस्य देशकालावजानतः।\nअप्राप्यं च भवेत्सान्त्वं भेदो वाऽप्यतिपीडनात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2076611, "chapter_id": 2625, "verse_number": "१२-१३०-५", "content_sanskrit": "जीवितं त्वर्थहेतोर्वा तत्र किं सुकृतं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2076612, "chapter_id": 2625, "verse_number": "१२-१३०-६x", "content_sanskrit": "भीष्म उवाच।\nगुह्यां मा धर्ममप्राक्षीरतीव भरतर्षभ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2076613, "chapter_id": 2625, "verse_number": "१२-१३०-६", "content_sanskrit": "प्रवक्तुं नोत्सहे पृष्टो धर्ममेतं युधिष्ठिर॥\nधर्मो ह्यणीयान्वचनाद्वुद्धेश्च भरतर्षभ।\nश्रुत्वौपम्यं सदाचारैः साधुर्भवति स क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2076614, "chapter_id": 2625, "verse_number": "१२-१३०-७", "content_sanskrit": "कर्मणा बुद्धिपूर्वेण भवत्याढ्ये न वा पुनः।\nतादृशोऽयमनुप्रश्नस्तद्ध्यायस्व स्वया धिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2076615, "chapter_id": 2625, "verse_number": "१२-१३०-८", "content_sanskrit": "उपायं धर्मबहुलं यात्रार्थं शृणु भारत।\nनाहमेतादृशे धर्मे बुभूषे धर्मकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2076616, "chapter_id": 2625, "verse_number": "१२-१३०-९", "content_sanskrit": "दुःखादान इह ह्येष स्यात्तु पश्चात्क्षमो मम।\nअभिगम्य मतीनां हि सर्वासामेव निश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2076617, "chapter_id": 2625, "verse_number": "१२-१३०-१०", "content_sanskrit": "यथायथा हि पुरुषो नित्यं शास्त्रमवेक्षते।\nतथातथा विजानाति विज्ञानं चास्य रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2076618, "chapter_id": 2625, "verse_number": "१२-१३०-११", "content_sanskrit": "अविज्ञानादयोगो हि पुरुषस्योपजायते।\nविज्ञानादपि योगश्च योगो भूतिकरः परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2076619, "chapter_id": 2625, "verse_number": "१२-१३०-१२", "content_sanskrit": "अशङ्कमानो वचनमनसूयुरिदं शृणु।\nराज्ञः कोशक्षयादेव जायते बलसंक्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2076620, "chapter_id": 2625, "verse_number": "१२-१३०-१३", "content_sanskrit": "कोशं संजनयेद्राजा नित्यमेभ्यो यथाबलम्।\nकालं प्राप्यानुगृह्णीयादेष धर्मोऽत्र सांप्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2076621, "chapter_id": 2625, "verse_number": "१२-१३०-१४", "content_sanskrit": "उपायधर्मं प्राप्यैनं पूर्वैराचरितं जनैः।\nअन्यो धर्मः समर्थानामापत्स्वल्पश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2076622, "chapter_id": 2625, "verse_number": "१२-१३०-१५", "content_sanskrit": "प्रकार्यं प्रोच्यते धर्मो वृत्तिर्धर्मे गरीयसी।\nधर्मं प्राप्य यथान्यायं न बलीयान्निषीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2076623, "chapter_id": 2625, "verse_number": "१२-१३०-१६", "content_sanskrit": "यस्माद्धर्मस्योपचितिरेकान्तेन न विद्यते।\nतस्मादापद्यधर्मोऽपि श्रूयते धर्मलक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2076624, "chapter_id": 2625, "verse_number": "१२-१३०-१७", "content_sanskrit": "अधर्मो जायते तस्मिन्निति वै कवयो विदुः।\nअनन्तरं क्षत्रियस्य तत्र किं विचिकित्स्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2076625, "chapter_id": 2625, "verse_number": "१२-१३०-१८", "content_sanskrit": "यथास्य धर्मो न ग्लायेन्नेयाच्छत्रुवशं यथा।\nतत्कर्तव्यमिहेत्याहुर्नात्मानमवसादयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2076626, "chapter_id": 2625, "verse_number": "१२-१३०-१९", "content_sanskrit": "सर्वात्मनैव धर्मस्य न परस्य न चात्मनः।\nसर्वोपायैरुज्जिहीर्षेदात्मानमिति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2076627, "chapter_id": 2625, "verse_number": "१२-१३०-२०", "content_sanskrit": "तत्र धर्मविदस्तात निश्चयो धर्मनैपुणैः।\nउद्यमं जीवनं क्षात्रे बाहुवीर्यादिति श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2076628, "chapter_id": 2625, "verse_number": "१२-१३०-२१", "content_sanskrit": "क्षत्रियो वृत्तिसंरोधे कस्य नादातुमर्हति।\nअन्यत्र तापसस्वाच्च श्रोत्रियस्वाच्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2076629, "chapter_id": 2625, "verse_number": "१२-१३०-२२", "content_sanskrit": "यथा वै ब्राह्मणः सीदन्नयाज्यमपि याजयेत्।\nअभोज्यमपि चाश्नीयात्तत्रेदं नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2076630, "chapter_id": 2625, "verse_number": "१२-१३०-२३", "content_sanskrit": "पीडितस्य किमद्वारमुत्पथेनार्दितस्य च।\nअद्वारतः प्रद्रवति यथा भवति पीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2076631, "chapter_id": 2625, "verse_number": "१२-१३०-२४", "content_sanskrit": "तस्य कोशबलग्लान्यां सर्वलोकपराभवः।\nभैक्षचर्या न विहिता न च विट्शूद्रजीविका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2076632, "chapter_id": 2625, "verse_number": "१२-१३०-२५", "content_sanskrit": "स्वधर्मानन्तरावृत्तिर्याऽन्यामनुपजीवतः।\nजहतः प्रथमं कल्पमनुकल्पेन जीवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2076633, "chapter_id": 2625, "verse_number": "१२-१३०-२६", "content_sanskrit": "आपद्गतेन धर्माणामन्यायेनोपजीवनम्।\nअपि ह्येतद्ब्राह्मणेषु दृष्टं वृत्तिपरिक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2076634, "chapter_id": 2625, "verse_number": "१२-१३०-२७", "content_sanskrit": "क्षत्रिये संशयः कस्मादित्येत्निश्चितं सदा।\nआददीत विशिष्टेभ्यो नावसीदेत्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2076635, "chapter_id": 2625, "verse_number": "१२-१३०-२८", "content_sanskrit": "आर्तानां रक्षितारं च प्रजानां क्षत्रियं विदुः।\nतस्मात्संरक्षता कार्यमादानं क्षत्रबन्धुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2076636, "chapter_id": 2625, "verse_number": "१२-१३०-२९", "content_sanskrit": "अन्यत्रापि विहिंसाया वृत्तिर्नेहास्ति कस्यचित्।\nअप्यरण्यसमुत्थस्य एकस्य चरतो मुनेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2076637, "chapter_id": 2625, "verse_number": "१२-१३०-३०", "content_sanskrit": "न शङ्खलिखितां वृत्तिं शक्यमास्थाय जीवितुम्।\nविशेषतः कुरुश्रेष्ठ प्रजापालनमीप्सता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2076638, "chapter_id": 2625, "verse_number": "१२-१३०-३१", "content_sanskrit": "परस्पराभिहरणं राज्ञा राष्ट्रेण चापदि।\nनित्यमेव हि कर्तव्यमेष धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2076639, "chapter_id": 2625, "verse_number": "१२-१३०-३२", "content_sanskrit": "राजा राष्ट्रं यथापत्सु द्रव्यौधैः परिरक्षति।\nराष्ट्रेण राजा व्यसने परिरक्ष्यस्तथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2076640, "chapter_id": 2625, "verse_number": "१२-१३०-३३", "content_sanskrit": "कोशं दण़्डं बलं मित्रं यदन्यदपि संचितम्।\nन कुर्वीतान्तरं राष्ट्रे राजा परिगतः क्षुधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2076641, "chapter_id": 2625, "verse_number": "१२-१३०-३४", "content_sanskrit": "बीजं भक्तेन संपाद्यमिति धर्मविदो विदुः।\nअत्रैतच्छम्बरस्याहुर्महामायस्य दर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2076642, "chapter_id": 2625, "verse_number": "१२-१३०-३५", "content_sanskrit": "धिक्तस्य जीवितं राज्ञो राष्ट्रं यस्यावसीदति।\nअवृत्त्यान्यमनुष्योऽपि यो वैदेशिक इत्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2076643, "chapter_id": 2625, "verse_number": "१२-१३०-३६", "content_sanskrit": "राज्ञः कोशबलं मूलं कोशमूलं पुनर्बलम्।\nतन्मूलं सर्वधर्माणां धर्ममूलाः पुनः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2076644, "chapter_id": 2625, "verse_number": "१२-१३०-३७", "content_sanskrit": "नान्यानपीडयित्वेह कोशः शक्यः कुतो बलम्।\nतदर्थं पीडयित्वा च न दोषं प्राप्नुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2076645, "chapter_id": 2625, "verse_number": "१२-१३०-३८", "content_sanskrit": "अकार्यमपि कार्यार्थं क्रियते यज्ञकर्मसु।\nएतस्मिन्कारणे राजा न दोषं प्राप्नुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2076646, "chapter_id": 2625, "verse_number": "१२-१३०-३९", "content_sanskrit": "अर्थार्थमन्यद्भवति विपरीतमथापरम्।\nअनर्थार्थमथाप्यन्यत्तत्सर्वं ह्यर्थकारणम्।\nएवं बुद्ध्या संप्रपश्येन्मेधावी कार्यनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2076647, "chapter_id": 2625, "verse_number": "१२-१३०-४०", "content_sanskrit": "यज्ञार्थमन्यद्भवति यज्ञोऽन्यार्थस्तथाः परः।\nयज्ञस्वार्थार्थमेवान्यत्तत्सर्वं यज्ञसाधकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2076648, "chapter_id": 2625, "verse_number": "१२-१३०-४१", "content_sanskrit": "उपमामत्र वक्ष्यामि धर्मतत्त्वप्रकाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2076649, "chapter_id": 2625, "verse_number": "१२-१३०-४२", "content_sanskrit": "यूपं छिन्दन्ति यज्ञार्थं तत्र ये परिपन्थिः।\nद्रुमाः केचन सामन्ता ध्रुवं छिन्दन्ति तानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2076650, "chapter_id": 2625, "verse_number": "१२-१३०-४३", "content_sanskrit": "ते चापि निपतन्तोऽन्यान्निघ्नन्त्यपि वनस्पतीन्।\nएवं कोशस्य महतो ये नराः परिपन्थिनः।\nतानहत्वा न पश्यामि सिद्धिमत्र परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2076651, "chapter_id": 2625, "verse_number": "१२-१३०-४४", "content_sanskrit": "धनेन जयते लोकमिमं चामुं च भारत।\nसत्यं च धर्मवचनं यथा नास्त्यधनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2076652, "chapter_id": 2625, "verse_number": "१२-१३०-४५", "content_sanskrit": "सर्वोपायैराददीत धनं यज्ञप्रयोजनम्।\nन तुल्यदोषः स्यादेवं कार्याकार्येषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2076653, "chapter_id": 2625, "verse_number": "१२-१३०-४६", "content_sanskrit": "नोभौ सभवतो राजन्कथंचिदपि भारत।\nन ह्यरण्येषु पश्यामि धनवृद्धानहं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2076654, "chapter_id": 2625, "verse_number": "१२-१३०-४७", "content_sanskrit": "यदिदं दृश्यते वित्तं पृथिव्यामिह किंचन।\nममेदं स्यान्ममेदं स्यादित्येवं मन्यते जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2076655, "chapter_id": 2625, "verse_number": "१२-१३०-४८", "content_sanskrit": "न च राज्ञः समो धर्मः कश्चिदस्ति कथंचन।\nधर्मः संशब्दितो राज्ञामापदर्थस्ततोऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2076656, "chapter_id": 2625, "verse_number": "१२-१३०-४९", "content_sanskrit": "ज्ञानेन कर्मणा चान्ये तपन्त्यन्ये तपस्विनः।\nबुद्ध्या दाक्ष्येण चैवान्ये चिन्वन्ति धनसंचयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2076657, "chapter_id": 2625, "verse_number": "१२-१३०-५०", "content_sanskrit": "अधनं दुर्बलं प्राहुर्धनेन बलवान्भवेत्।\nसर्वं बलवतः प्राप्यं सर्वं तरति कोशवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2076658, "chapter_id": 2625, "verse_number": "१२-१३०-५१", "content_sanskrit": "कोशो धर्मश्च कामश्च परलोकस्तथा ह्ययम्।\nतं धर्मेण विलिप्सेत नाधर्मेण कदाचन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2076659, "chapter_id": 2625, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्त्रिकायां संहितायां वैयासिक्यां शान्तिपर्वणि राजधर्मपर्वणि त्रिंशदधिकशततमोऽध्यायः॥ १३०॥ समाप्तं च राजधर्मपर्व ॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]