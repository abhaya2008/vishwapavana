[{"id": 5000499000, "chapter_id": 9499, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे द्विनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000499001, "chapter_id": 9499, "verse_number": "६-९२-१", "content_sanskrit": "ततः पौलस्त्यसचिवाः श्रुत्वा चेन्द्रजितो वधम्।\nआचचक्षुरभिज्ञाय दशग्रीवाय सत्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000499002, "chapter_id": 9499, "verse_number": "६-९२-२", "content_sanskrit": "युद्धे हतो महाराज लक्ष्मणेन तवात्मजः।\nविभीषणसहायेन मिषतां नो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000499003, "chapter_id": 9499, "verse_number": "६-९२-३", "content_sanskrit": "शूरः शूरेण संगम्य संयुगेष्वपराजितः।\nलक्ष्मणेन हतः शूरः पुत्रस्ते विबुधेन्द्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000499004, "chapter_id": 9499, "verse_number": "६-९२-४", "content_sanskrit": "गतः स परमाँल्लोकान् शरैः संतर्प्य लक्ष्मणम्।\nस तं प्रतिभयं श्रुत्वा वधं पुत्रस्य दारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000499005, "chapter_id": 9499, "verse_number": "६-९२-५", "content_sanskrit": "घोरमिन्द्रजितः संख्ये कश्मलं प्राविशन्महत्।\nउपलभ्य चिरात् संज्ञां राजा राक्षसपुंगवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000499006, "chapter_id": 9499, "verse_number": "६-९२-६", "content_sanskrit": "पुत्रशोकाकुलो दीनो विललापाकुलेन्द्रियः।\nहा राक्षसचमूमुख्य मम वत्स महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000499007, "chapter_id": 9499, "verse_number": "६-९२-७", "content_sanskrit": "जित्वेन्द्रं कथमद्य त्वं लक्ष्मणस्य वशं गतः।\nननु त्वमिषुभिः क्रुद्धो भिन्द्याः कालान्तकावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000499008, "chapter_id": 9499, "verse_number": "६-९२-८", "content_sanskrit": "मन्दरस्यापि शृङ्गाणि किं पुनर्लक्ष्मणं युधि।\nअद्य वैवस्वतो राजा भूयो बहुमतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000499009, "chapter_id": 9499, "verse_number": "६-९२-९", "content_sanskrit": "येनाद्य त्वं महाबाहो संयुक्तः कालधर्मणा।\nएष पन्थाः सुयोधानां सर्वामरगणेष्वपि।\nयः कृते हन्यते भर्तुः स पुमान् स्वर्गमृच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000499010, "chapter_id": 9499, "verse_number": "६-९२-१०", "content_sanskrit": "अद्य देवगणाः सर्वे लोकपाला महर्षयः।\nहतमिन्द्रजितं श्रुत्वा सुखं स्वप्स्यन्ति निर्भयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000499011, "chapter_id": 9499, "verse_number": "६-९२-११", "content_sanskrit": "अद्य लोकास्त्रयः कृत्स्ना पृथिवी च सकानना।\nएकेनेन्द्रजिता हीना शून्येव प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000499012, "chapter_id": 9499, "verse_number": "६-९२-१२", "content_sanskrit": "अद्य नैर्ऋतकन्यानां श्रोष्याम्यन्तःपुरे रवम्।\nकरेणुसङ्घस्य यथा निनादं गिरिगह्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000499013, "chapter_id": 9499, "verse_number": "६-९२-१३", "content_sanskrit": "यौवराज्यं च लङ्कां च रक्षांसि च परंतप।\nमातरं मां च भार्याश्च क्व गतोऽसि विहाय नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000499014, "chapter_id": 9499, "verse_number": "६-९२-१४", "content_sanskrit": "मम नाम त्वया वीर गतस्य यमसादनम्।\nप्रेतकार्याणि कार्याणि विपरीते हि वर्तसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000499015, "chapter_id": 9499, "verse_number": "६-९२-१५", "content_sanskrit": "स त्वं जीवति सुग्रीवे लक्ष्मणे च सराघवे।\nमम शल्यमनुद‍्धृत्य क्व गतोऽसि विहाय नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000499016, "chapter_id": 9499, "verse_number": "६-९२-१६", "content_sanskrit": "एवमादिविलापार्तं रावणं राक्षसाधिपम्।\nआविवेश महान् कोपः पुत्रव्यसनसम्भवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000499017, "chapter_id": 9499, "verse_number": "६-९२-१७", "content_sanskrit": "प्रकृत्या कोपनं ह्येनं पुत्रस्य पुनराधयः।\nदीप्तं संदीपयामासुर्घर्मेऽर्कमिव रश्मयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000499018, "chapter_id": 9499, "verse_number": "६-९२-१८", "content_sanskrit": "ललाटे भ्रुकुटीभिश्च संगताभिर्व्यरोचत।\nयुगान्ते सह नक्रैस्तु महोर्मिभिरिवोदधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000499019, "chapter_id": 9499, "verse_number": "६-९२-१९", "content_sanskrit": "कोपाद् विजृम्भमाणस्य वक्त्राद् व्यक्तमिव ज्वलन्।\nउत्पपात सधूमाग्निर्वृत्रस्य वदनादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000499020, "chapter_id": 9499, "verse_number": "६-९२-२०", "content_sanskrit": "स पुत्रवधसंतप्तः शूरः क्रोधवशं गतः।\nसमीक्ष्य रावणो बुद्‍ध्या वैदेह्या रोचयद् वधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000499021, "chapter_id": 9499, "verse_number": "६-९२-२१", "content_sanskrit": "तस्य प्रकृत्या रक्ते च रक्ते क्रोधाग्निनापि च।\nरावणस्य महाघोरे दीप्ते नेत्रे बभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000499022, "chapter_id": 9499, "verse_number": "६-९२-२२", "content_sanskrit": "घोरं प्रकृत्या रूपं तत् तस्य क्रोधाग्निमूर्च्छितम्।\nबभूव रूपं क्रुद्धस्य रुद्रस्येव दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000499023, "chapter_id": 9499, "verse_number": "६-९२-२३", "content_sanskrit": "तस्य क्रुद्धस्य नेत्राभ्यां प्रापतन्नश्रुबिन्दवः।\nदीपाभ्यामिव दीप्ताभ्यां सार्चिषः स्नेहबिन्दवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000499024, "chapter_id": 9499, "verse_number": "६-९२-२४", "content_sanskrit": "दन्तान् विदशतस्तस्य श्रूयते दशनस्वनः।\nयन्त्रस्याकृष्यमाणस्य मथ्नतो दानवैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000499025, "chapter_id": 9499, "verse_number": "६-९२-२५", "content_sanskrit": "कालाग्निरिव संक्रुद्धो यां यां दिशमवैक्षत।\nतस्यां तस्यां भयत्रस्ता राक्षसाः संविलिल्यिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000499026, "chapter_id": 9499, "verse_number": "६-९२-२६", "content_sanskrit": "तमन्तकमिव क्रुद्धं चराचरचिखादिषुम्।\nवीक्षमाणं दिशः सर्वा राक्षसा नोपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000499027, "chapter_id": 9499, "verse_number": "६-९२-२७", "content_sanskrit": "ततः परमसंक्रुद्धो रावणो राक्षसाधिपः।\nअब्रवीद् रक्षसां मध्ये संस्तम्भयिषुराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000499028, "chapter_id": 9499, "verse_number": "६-९२-२८", "content_sanskrit": "मया वर्षसहस्राणि चरित्वा परमं तपः।\nतेषु तेष्ववकाशेषु स्वयंभूः परितोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000499029, "chapter_id": 9499, "verse_number": "६-९२-२९", "content_sanskrit": "तस्यैव तपसो व्युष्ट्या प्रसादाच्च स्वयंभुवः।\nनासुरेभ्यो न देवेभ्यो भयं मम कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000499030, "chapter_id": 9499, "verse_number": "६-९२-३०", "content_sanskrit": "कवचं ब्रह्मदत्तं मे यदादित्यसमप्रभम्।\nदेवासुरविमर्देषु न च्छिन्नं वज्रमुष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000499031, "chapter_id": 9499, "verse_number": "६-९२-३१", "content_sanskrit": "तेन मामद्य संयुक्तं रथस्थमिह संयुगे।\nप्रतीयात् कोऽद्य मामाजौ साक्षादपि पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000499032, "chapter_id": 9499, "verse_number": "६-९२-३२", "content_sanskrit": "यत् तदाभिप्रसन्नेन सशरं कार्मुकं महत्।\nदेवासुरविमर्देषु मम दत्तं स्वयंभुवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000499033, "chapter_id": 9499, "verse_number": "६-९२-३३", "content_sanskrit": "अद्य तूर्यशतैर्भीमं धनुरुत्थाप्यतां मम।\nरामलक्ष्मणयोरेव वधाय परमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000499034, "chapter_id": 9499, "verse_number": "६-९२-३४", "content_sanskrit": "स पुत्रवधसंतप्तः क्रूरः क्रोधवशं गतः।\nसमीक्ष्य रावणो बुद्ध्या सीतां हन्तुं व्यवस्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000499035, "chapter_id": 9499, "verse_number": "६-९२-३५", "content_sanskrit": "प्रत्यवेक्ष्य तु ताम्राक्षः सुघोरो घोरदर्शनः।\nदीनो दीनस्वरान् सर्वांस्तानुवाच निशाचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000499036, "chapter_id": 9499, "verse_number": "६-९२-३६", "content_sanskrit": "मायया मम वत्सेन वञ्चनार्थं वनौकसाम्।\nकिंचिदेव हतं तत्र सीतेयमिति दर्शितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000499037, "chapter_id": 9499, "verse_number": "६-९२-३७", "content_sanskrit": "तदिदं तथ्यमेवाहं करिष्ये प्रियमात्मनः।\nवैदेहीं नाशयिष्यामि क्षत्रबन्धुमनुव्रताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000499038, "chapter_id": 9499, "verse_number": "६-९२-३८", "content_sanskrit": "इत्येवमुक्त्वा सचिवान् खड्गमाशु परामृशत्।\nउद्‍धृत्य गुणसम्पन्नं विमलाम्बरवर्चसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000499039, "chapter_id": 9499, "verse_number": "६-९२-३९", "content_sanskrit": "निष्पपात स वेगेन सभार्यः सचिवैर्वृतः।\nरावणः पुत्रशोकेन भृशमाकुलचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000499040, "chapter_id": 9499, "verse_number": "६-९२-४०", "content_sanskrit": "संक्रुद्धः खड्गमादाय सहसा यत्र मैथिली।\nव्रजन्तं राक्षसं प्रेक्ष्य सिंहनादं विचुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000499041, "chapter_id": 9499, "verse_number": "६-९२-४१", "content_sanskrit": "ऊचुश्चान्योन्यमालिङ्‍ग्य संक्रुद्धं प्रेक्ष्य राक्षसम्।\nअद्यैनं तावुभौ दृष्ट्वा भ्रातरौ प्रव्यथिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000499042, "chapter_id": 9499, "verse_number": "६-९२-४२", "content_sanskrit": "लोकपाला हि चत्वारः क्रुद्धेनानेन निर्जिताः।\nबहवः शत्रवश्चान्ये संयुगेष्वभिपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000499043, "chapter_id": 9499, "verse_number": "६-९२-४३", "content_sanskrit": "त्रिषु लोकेषु रत्नानि भुङ्‍क्ते आहृत्य रावणः।\nविक्रमे च बले चैव नास्त्यस्य सदृशो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000499044, "chapter_id": 9499, "verse_number": "६-९२-४४", "content_sanskrit": "तेषां संजल्पमानानामशोकवनिकां गताम्।\nअभिदुद्राव वैदेहीं रावणः क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000499045, "chapter_id": 9499, "verse_number": "६-९२-४५", "content_sanskrit": "वार्यमाणः सुसंक्रुद्धः सुहृद्भिर्हितबुद्धिभिः।\nअभ्यधावत संक्रुद्धः खे ग्रहो रोहिणीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000499046, "chapter_id": 9499, "verse_number": "६-९२-४६", "content_sanskrit": "मैथिली रक्ष्यमाणा तु राक्षसीभिरनिन्दिता।\nददर्श राक्षसं क्रुद्धं निस्त्रिंशवरधारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000499047, "chapter_id": 9499, "verse_number": "६-९२-४७", "content_sanskrit": "तं निशम्य सनिस्त्रिंशं व्यथिता जनकात्मजा।\nनिवार्यमाणं बहुशः सुहृद्भिरनिवर्तिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000499048, "chapter_id": 9499, "verse_number": "६-९२-४८", "content_sanskrit": "सीता दुःखसमाविष्टा विलपन्तीदमब्रवीत्।\nयथायं मामभिक्रुद्धः समभिद्रवति स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000499049, "chapter_id": 9499, "verse_number": "६-९२-४९", "content_sanskrit": "वधिष्यति सनाथां मामनाथामिव दुर्मतिः।\nबहुशश्चोदयामास भर्तारं मामनुव्रताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000499050, "chapter_id": 9499, "verse_number": "६-९२-५०", "content_sanskrit": "भार्या मम भवस्वेति प्रत्याख्यातो ध्रुवं मया।\nसोऽयं मामनुपस्थाने व्यक्तं नैराश्यमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000499051, "chapter_id": 9499, "verse_number": "६-९२-५१", "content_sanskrit": "क्रोधमोहसमाविष्टो व्यक्तं मां हन्तुमुद्यतः।\nअथवा तौ नरव्याघ्रौ भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000499052, "chapter_id": 9499, "verse_number": "६-९२-५२", "content_sanskrit": "मन्निमित्तमनार्येण समरेऽद्य निपातितौ।\nभैरवो हि महान् नादो राक्षसानां श्रुतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000499053, "chapter_id": 9499, "verse_number": "६-९२-५३", "content_sanskrit": "बहूनामिह हृष्टानां तथा विक्रोशतां प्रियम्।\nअहो धिङ्मन्निमित्तोऽयं विनाशो राजपुत्रयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000499054, "chapter_id": 9499, "verse_number": "६-९२-५४", "content_sanskrit": "अथवा पुत्रशोकेन अहत्वा रामलक्ष्मणौ।\nविधमिष्यति मां रौद्रो राक्षसः पापनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000499055, "chapter_id": 9499, "verse_number": "६-९२-५५", "content_sanskrit": "हनूमतस्तु तद् वाक्यं न कृतं क्षुद्रया मया।\nयद्यहं तस्य पृष्ठेन तदायासमनिर्जिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000499056, "chapter_id": 9499, "verse_number": "६-९२-५६", "content_sanskrit": "नाद्यैवमनुशोचेयं भर्तुरङ्कगता सती।\nमन्ये तु हृदयं तस्याः कौसल्यायाः फलिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000499057, "chapter_id": 9499, "verse_number": "६-९२-५७", "content_sanskrit": "एकपुत्रा यदा पुत्रं विनष्टं श्रोष्यते युधि।\nसा हि जन्म च बाल्यं च यौवनं च महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000499058, "chapter_id": 9499, "verse_number": "६-९२-५८", "content_sanskrit": "धर्मकार्याणि रूपं च रुदती संस्मरिष्यति।\nनिराशा निहते पुत्रे दत्त्वा श्राद्धमचेतना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000499059, "chapter_id": 9499, "verse_number": "६-९२-५९", "content_sanskrit": "अग्निमावेक्ष्यते नूनमपो वापि प्रवेक्ष्यति।\nधिगस्तु कुब्जामसतीं मन्थरां पापनिश्चयाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000499060, "chapter_id": 9499, "verse_number": "६-९२-६०", "content_sanskrit": "यन्निमित्तमिमं शोकं कौसल्या प्रतिपत्स्यते।\nइत्येवं मैथिलीं दृष्ट्वा विलपन्तीं तपस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000499061, "chapter_id": 9499, "verse_number": "६-९२-६१", "content_sanskrit": "रोहिणीमिव चन्द्रेण बिना ग्रहवशं गताम्।\nएतस्मिन्नन्तरे तस्य अमात्यः शीलवान् शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000499062, "chapter_id": 9499, "verse_number": "६-९२-६२", "content_sanskrit": "सुपार्श्वो नाम मेधावी रावणं रक्षसां वरम्।\nनिवार्यमाणः सचिवैरिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000499063, "chapter_id": 9499, "verse_number": "६-९२-६३", "content_sanskrit": "कथं नाम दशग्रीव साक्षाद्वैश्रवणानुज।\nहन्तुमिच्छसि वैदेहीं क्रोधाद् धर्ममपास्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000499064, "chapter_id": 9499, "verse_number": "६-९२-६४", "content_sanskrit": "वेदविद्याव्रतस्नातः स्वकर्मनिरतस्तथा।\nस्त्रियः कस्माद् वधं वीर मन्यसे राक्षसेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000499065, "chapter_id": 9499, "verse_number": "६-९२-६५", "content_sanskrit": "मैथिलीं रूपसम्पन्नां प्रत्यवेक्षस्व पार्थिव।\nतस्मिन्नेव सहास्माभिराहवे क्रोधमुत्सृज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000499066, "chapter_id": 9499, "verse_number": "६-९२-६६", "content_sanskrit": "अभ्युत्थानं त्वमद्यैव कृष्णपक्षचतुर्दशी।\nकृत्वा निर्याह्यमावास्यां विजयाय बलैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000499067, "chapter_id": 9499, "verse_number": "६-९२-६७", "content_sanskrit": "शूरो धीमान् रथी खड्गी रथप्रवरमास्थितः।\nहत्वा दाशरथिं रामं भवान् प्राप्स्यति मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000499068, "chapter_id": 9499, "verse_number": "६-९२-६८", "content_sanskrit": "स तद् दुरात्मा सुहृदा निवेदितं\nवचः सुधर्म्यं प्रतिगृह्य रावणः।\nगृहं जगामाथ ततश्च वीर्यवान्\nपुनः सभां च प्रययौ सुहृद्‍वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000499069, "chapter_id": 9499, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्विनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]