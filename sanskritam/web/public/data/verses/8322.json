[{"id": 900004157, "chapter_id": 8322, "verse_number": "1.1", "content_sanskrit": "नारायणं निखिलपूर्णगुणार्णमुच्चसूर्यामितद्युतिमशेषनिरस्तदोषम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004158, "chapter_id": 8322, "verse_number": "1.2", "content_sanskrit": "ॐ ॥ अग्निमीळे पुरोहितं यज्ञस्य देवमृत्विजम् ॥ होतारं रत्नधातमम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004159, "chapter_id": 8322, "verse_number": "1.3", "content_sanskrit": "वायवायाहि दर्शतेमे सोमा अरङ्कृताः ॥ तेषाम्पाहि श्रुधी हवम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004160, "chapter_id": 8322, "verse_number": "1.4", "content_sanskrit": "अश्विना यज्वरीरिषो द्रवत्पाणी शुभस्पती ॥ पुरुभुजा चनस्यतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004161, "chapter_id": 8322, "verse_number": "1.5", "content_sanskrit": "सुरूपकृत्नुमूतये सुदुघामिव गोदुहे ॥ जुहूमसि द्यविऽद्यवि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004162, "chapter_id": 8322, "verse_number": "1.6", "content_sanskrit": "आ त्वेता निषीदतेन्द्रमभि प्र गायत ॥ सखायस्स्तोमवाहसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004163, "chapter_id": 8322, "verse_number": "1.7", "content_sanskrit": "युञ्जन्ति ब्रध्नमरुषञ्चरन्तम्परि तस्थुषः ॥ रोचन्ते रोचना दिवि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004164, "chapter_id": 8322, "verse_number": "1.8", "content_sanskrit": "इन्द्रमिद्गाथिनो बृहदिन्द्रमर्केभिरर्किणः ॥ इन्द्रं वाणीरनूषत", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004165, "chapter_id": 8322, "verse_number": "1.9", "content_sanskrit": "एन्द्र सानसिं रयिं सजत्वानं सदा सहम् ॥ वर्षिष्ठमूतये भर", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004166, "chapter_id": 8322, "verse_number": "1.10", "content_sanskrit": "इन्द्रेहि मत्स्यन्धसो विश्वेभिस्सोमपर्वभिः ॥ महा अभिष्टिरोजसा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004167, "chapter_id": 8322, "verse_number": "1.11", "content_sanskrit": "गायन्ति त्वा गायत्रिणोऽर्चन्त्यर्कमर्किणः ॥ ब्रह्माणस्त्वा शतक्रत उद्वंशमिव येमिरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004168, "chapter_id": 8322, "verse_number": "1.12", "content_sanskrit": "इन्द्रं विश्वा अवीवृधन्त्समुद्र व्यचसङ्गिरः ॥ रथीतमं रथीनां वाजानां सत्पतिम्पतिम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004169, "chapter_id": 8322, "verse_number": "1.13", "content_sanskrit": "अग्निन्दूतं वृणीमहे होतारं विश्ववेदसम् ॥ अस्य यज्ञस्य सुक्रतुम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004170, "chapter_id": 8322, "verse_number": "1.14", "content_sanskrit": "सुसमिद्धो न आवह देवा अग्ने हविष्मते ॥ होतः पावक यक्षि च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004171, "chapter_id": 8322, "verse_number": "1.15", "content_sanskrit": "ऐभिरग्ने दुवो गिरो विश्वेभिस्सोमपीतये ॥ देवेभिर्याहि यक्षि च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004172, "chapter_id": 8322, "verse_number": "1.16", "content_sanskrit": "इन्द्र सोमम्पिब ऋतुना त्वा विशन्त्विन्दवः ॥ मत्सरासस्तदोकसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004173, "chapter_id": 8322, "verse_number": "1.17", "content_sanskrit": "आ त्वा वहन्तु हरयो वृषणं सोमपीतये ॥ इन्द्र त्वा सूरऽचक्षसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004174, "chapter_id": 8322, "verse_number": "1.18", "content_sanskrit": "इन्द्रावरुणयोरहं सम्राजोरव आ वृणे ॥ ता नो मृात इर्दृशे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900004175, "chapter_id": 8322, "verse_number": "1.19", "content_sanskrit": "सोमानं स्वरणङ्कृणुहि ब्रह्मणस्पते ॥ कक्षीवन्तं य औशिजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900004176, "chapter_id": 8322, "verse_number": "1.20", "content_sanskrit": "प्रतित्यञ्चारुमध्वरङ्गोेपीथाय प्रहूयसे ॥ मरुद्भिरग्न आगहि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]