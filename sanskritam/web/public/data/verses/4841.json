[{"id": 2181262, "chapter_id": 4841, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181263, "chapter_id": 4841, "verse_number": "१", "content_sanskrit": "एतावदुक्त्वा भूयोऽपि भीष्मः कुरुपितामहः ।\nउवाच वचनं धीमान् सर्वतः सारसङ्ग्रहम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181264, "chapter_id": 4841, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181265, "chapter_id": 4841, "verse_number": "२", "content_sanskrit": "एतत् ते राजधर्माणां नवनीतं युधिष्ठिर ।\nबृहस्पतिर्हि भगवान् नान्यं धर्मं प्रशंसति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181266, "chapter_id": 4841, "verse_number": "३", "content_sanskrit": "विशालाक्षश्च भगवान् काव्यश्चैव महातपाः ।\nसहस्राक्षो महेन्द्रश्च तथा प्राचेतसो मनुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181267, "chapter_id": 4841, "verse_number": "४", "content_sanskrit": "भरद्वाजश्च भगवांस्तथा गौरशिरा मुनिः ।\nराजशास्त्रप्रणेतारो ब्राह्मणा सत्यवादिनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2181268, "chapter_id": 4841, "verse_number": "५", "content_sanskrit": "रक्षामेव प्रशंसन्ति धर्मं धर्मभृतांवर ।\nराज्ञां राजीवताम्राक्ष साधनं चात्र वै शृणु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2181269, "chapter_id": 4841, "verse_number": "६", "content_sanskrit": "चारश्च प्रणिधिश्चैव काले दानममत्सरः ।\nयुक्त्याऽऽदानं नचादानमयोगेन युधिष्ठिर\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2181270, "chapter_id": 4841, "verse_number": "७", "content_sanskrit": "सतां सङ्ग्रहणं शौर्यं दाक्ष्यं सत्यं प्रजाहितम् ।\nअनार्जवैरार्जवैश्च शत्रुपक्षस्य भेदनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2181271, "chapter_id": 4841, "verse_number": "८", "content_sanskrit": "साधूनामपरित्यागः कुलीनानां च धारणम् ।\nनिचयश्च निचेयानां सेवा बुद्धिमतामपि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2181272, "chapter_id": 4841, "verse_number": "९", "content_sanskrit": "बलानां हर्षणं नित्यं प्रजानामन्ववेक्षणम् ।\nकार्येष्वखेदः कोशस्य तथैव च विवर्धनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2181273, "chapter_id": 4841, "verse_number": "१०", "content_sanskrit": "पुरगुप्तिरविश्वासः पौरसङ्घातभेदनम् ।\nकेतनानां च जीर्णानामव्अेक्षा चैव सीदताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2181274, "chapter_id": 4841, "verse_number": "११", "content_sanskrit": "द्विविधस्य च दण्डस्य प्रयोग्ाः कालचोदितः ।\nअरिमध्यस्थमित्राणां यथावच्चान्ववेक्षणम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2181275, "chapter_id": 4841, "verse_number": "१२", "content_sanskrit": "उपजापश्च भृत्यान्आमात्मनः पुरदर्शनम् ।\nअविश्वासः स्वयं चैव परस्याश्वासनं तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2181276, "chapter_id": 4841, "verse_number": "१३", "content_sanskrit": "नीतिधर्मानुसरणं नित्यमुत्थानमेव च ।\nरिपूणामनवज्ञानं नित्यं चानार्यवर्जनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2181277, "chapter_id": 4841, "verse_number": "१४", "content_sanskrit": "उत्थानं हि नरेन्द्राणां बृहस्पतिरभाषत ।\nराजधर्मस्य यन्मूलं श्लोकश्चात्र निबोध मे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2181278, "chapter_id": 4841, "verse_number": "१५", "content_sanskrit": "उत्थानेनामृतं लब्धमुत्थानेनासुरा हताः ।\nउत्थानेन महेन्द्रेण श्रैष्ठ्यं प्राप्तं दिवीह च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2181279, "chapter_id": 4841, "verse_number": "१६", "content_sanskrit": "उत्थानधीरः पुरुषो वाग्धीरानधितिष्ठति ।\nउत्थानधीरं वाग्धीरा रमयन्त उपासते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2181280, "chapter_id": 4841, "verse_number": "१७", "content_sanskrit": "उत्थानहीनो राजा हि बुद्धिमानपि नित्यशः ।\nधर्षणीयो रिपूणां स्याद् भुजङ्ग इव निर्विषः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2181281, "chapter_id": 4841, "verse_number": "१८", "content_sanskrit": "नच शत्रुरवज्ञेयो दुर्बलोऽपि बलीयसा ।\nअल्पोऽपि हि दहत्यग्निर्विषमल्पं हिनस्ति च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2181282, "chapter_id": 4841, "verse_number": "१९", "content_sanskrit": "एकाङ्गेनापि सम्भूतः शत्रुर्दर्ुगसमाश्रितः ।\nसर्वं तापयते देशमपि राज्ञः समृद्धिनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2181283, "chapter_id": 4841, "verse_number": "२०", "content_sanskrit": "राज्ञो रहस्यं यद् वाक्यं जयार्थं लोकसङ्ग्रहः ।\nहृदि यच्चास्य जिह्मं स्यात् कारणार्थं च यद् भवेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2181284, "chapter_id": 4841, "verse_number": "२१", "content_sanskrit": "यच्चास्य कार्यं वृजिनमार्जवेनैव धार्यते ।\nदम्भनार्थाय लोकस्य धर्मिष्ठामाचरेत् क्रियाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2181285, "chapter_id": 4841, "verse_number": "२२", "content_sanskrit": "राज्यं हि सुमहत्तन्त्रं दुर्धार्यमकृतात्मभिः ।\nन शक्यं मृदुना वोढुमाघातस्थानमुल्बणम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2181286, "chapter_id": 4841, "verse_number": "२३", "content_sanskrit": "राज्यं सर्वामिषं नित्यमार्जवेनेह धार्यते ।\nतस्मान्मिश्रेण सततं वर्तितव्यं युधिष्ठिर\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2181287, "chapter_id": 4841, "verse_number": "२४", "content_sanskrit": "यद्यप्यस्य विपत्तिः स्याद् रक्षमाणस्य वै प्रजाः ।\nसोऽप्यस्य विपुलो धर्म एवंवृत्ता हि भूमिपाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2181288, "chapter_id": 4841, "verse_number": "२५", "content_sanskrit": "एष ते राजधर्माणां लेशः समनुवर्णितः ।\nभूयस्ते यत्र सन्देहस्तद् ब्रूहि कुरुसत्तम\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2181289, "chapter_id": 4841, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2181290, "chapter_id": 4841, "verse_number": "२६", "content_sanskrit": "ततो व्यासश्च भगवान् देवस्थानोऽश्मना सह ।\nवासुदेवः कृपश्चैव सात्यकिः सञ्जयस्तथा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2181291, "chapter_id": 4841, "verse_number": "२७", "content_sanskrit": "साधु साध्विति संहृष्टाः पुष्यमाणैरिवाननैः ।\nअस्तुवंस्ते नरव्याघ्रं भीष्मं धर्मभृतांवरम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2181292, "chapter_id": 4841, "verse_number": "२८", "content_sanskrit": "ततो दीनमना भीष्ममुवाच कुरुसत्तमः ।\nनेत्राभ्यामश्रुपूर्णाभ्यां पादौ तस्य शनैः स्पृशन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2181293, "chapter_id": 4841, "verse_number": "२९", "content_sanskrit": "श्व इदानीं स्वसन्देहं प्रक्ष्यामि त्वा पितामह ।\nउपैति सविताप्यस्तं रसमापीय पार्थिवम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2181294, "chapter_id": 4841, "verse_number": "३०", "content_sanskrit": "ततो द्विजातीनभिवाद्य केशवः\nकृपश्च ते चैव युधिष्ठिरादयः ।\nप्रदक्षिणीकृत्य महानदीसुतं\nततो रथानारुरुहुर्मुदा युताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2181295, "chapter_id": 4841, "verse_number": "३१", "content_sanskrit": "दृषद्वतीं चाप्यवगाह्य सुव्रताः\nकृतोदकार्याः कृतजप्यमङ्गलाः ।\nउपास्य सन्ध्यां विधिवत् परन्तपा-\nस्ततः पुरं ते विविशुर्गजाह्वयम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2181296, "chapter_id": 4841, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे अष्टपञ्चाशोऽध्यायः ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]