[{"id": 7004864000, "chapter_id": 24864, "verse_number": "७-१-४७-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि देवं गुरुनिषेवितम् ।\nउमायाः पूर्वदिग्भागे सिद्धेशाग्नेयगोचरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004864001, "chapter_id": 24864, "verse_number": "७-१-४७-२", "content_sanskrit": "संस्थितं तु महल्लिंगं देवाचार्य प्रतिष्ठितम् ।\nआराध्य परया भक्त्या लिंगं वर्षसहस्रकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004864002, "chapter_id": 24864, "verse_number": "७-१-४७-३", "content_sanskrit": "तोषयामास देवेशं भवं शर्वमुमापतिम् ।\nप्राप्तवानखिलान्कामानप्राप्यानकृतात्मभिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004864003, "chapter_id": 24864, "verse_number": "७-१-४७-४", "content_sanskrit": "देवानां चैव पूज्यत्वं प्राप्य ज्ञानमथैश्वरम् ।\nग्रहत्वं च तथा प्राप्य मोदते दिवि सांप्रतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004864004, "chapter_id": 24864, "verse_number": "७-१-४७-५", "content_sanskrit": "तं दृष्ट्वा मानवो भक्त्या न दुर्गति मवाप्नुयात् ।\nबृहस्पतिकृतं लिंगं ये पश्यंति नरोत्तमाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004864005, "chapter_id": 24864, "verse_number": "७-१-४७-६", "content_sanskrit": "बृहस्पतिकृता पीडा नैव तेषां हि जायते ।\nतत्र शुक्लचतुर्दश्यां गुरुवारे तथा प्रिये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004864006, "chapter_id": 24864, "verse_number": "७-१-४७-७", "content_sanskrit": "संपूज्य विधिवल्लिंगं सम्यग्राजोपचारतः ।\nअथवा भक्तिभावेन प्राप्नुयात्परमं पदम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004864007, "chapter_id": 24864, "verse_number": "७-१-४७-८", "content_sanskrit": "स्नानं पलसहस्रेण पंचामृतरसेन यः ।\nकरोति भक्त्या मर्त्यो वै मुच्यते स ऋणत्रयात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004864008, "chapter_id": 24864, "verse_number": "७-१-४७-९", "content_sanskrit": "मातृकात्पैतृकाद्देवि तथा गुरुसमुद्भवात् ।\nसर्वपापविशुद्धात्मा निर्द्वंद्वो मुक्तिमाप्नुयात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004864009, "chapter_id": 24864, "verse_number": "७-१-४७-१०", "content_sanskrit": "एवं संक्षेपतः प्रोक्तं माहात्म्यं गुरुदैवतम् ।\nशृणुयाद्यस्तु भावेन तस्य प्रीतो गुरुर्भवेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004864010, "chapter_id": 24864, "verse_number": "७-१-४७-११", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये वृहस्पतीश्वरमाहात्म्यवर्णनंनाम सप्तचत्वारिंशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]