[{"id": 2200285, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2200286, "chapter_id": 5265, "verse_number": "१", "content_sanskrit": "कदाचित् कामरूपिण्यो गावः स्त्रीवेषमास्थिताः ।\nह्रदे क्रीडन्ति संहृष्टा गायन्त्यः पुण्यलक्षणाः\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2200287, "chapter_id": 5265, "verse_number": "२", "content_sanskrit": "ददृशुस्तस्य गावो वै विस्मयोत्फुल्ललोचनाः ।\nऊचुश्च का यूयमिति स्त्रियो मानुषया गिरा\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2200288, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "स्त्रियः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2200289, "chapter_id": 5265, "verse_number": "३", "content_sanskrit": "गाव एव वयं सर्वा कर्मभिः शोभनैर्युताः ।\nसर्वा स्त्रीवेषधारिण्यो यथाकामं चरामहे\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2200290, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "गावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2200291, "chapter_id": 5265, "verse_number": "४", "content_sanskrit": "गवां गावः परं दैवं गवां गावः परा गतिः ।\nकथयध्वमिहास्माकं केन वः सुकृतां गतिः\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2200292, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "स्त्रियः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2200293, "chapter_id": 5265, "verse_number": "५", "content_sanskrit": "अस्माकं हविषा देवा ब्राह्मणास्तर्पितास्तथा ।\nकव्येन पितरश्चैव हव्येनाग्निश्च तर्पितः\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2200294, "chapter_id": 5265, "verse_number": "६", "content_sanskrit": "प्रजया च तथाऽस्माकं कृषिरभ्युद्धृता सदा ।\nशकटैश्चापि संयुक्ता दशवाहशतेन वै\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2200295, "chapter_id": 5265, "verse_number": "७", "content_sanskrit": "तदेतैः सुकृतैः स्फीतैर्वयं याश्चैव नः प्रजाः ।\nगोलोकमनुसम्प्राप्ता यः परः कामगोचरः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2200296, "chapter_id": 5265, "verse_number": "८", "content_sanskrit": "यूयं तु सर्वा रोहिण्यः सप्रजाः सहपुंगवाः ।\nअधोगामिन्य इत्येव पश्यामो दिव्यचक्षुषा\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2200297, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "गावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2200298, "chapter_id": 5265, "verse_number": "९", "content_sanskrit": "एवं गवां परं दैवं गाव एव परायणम् ।\nस्वपक्ष्यास्तारणीया वः शरणाय गता वयम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2200299, "chapter_id": 5265, "verse_number": "१०", "content_sanskrit": "किमस्माभिः करणीयं वर्तितव्यं कथञ्चन ।\nप्राप्नुयाम च गोलोकं भवाम न च गर्हिताः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2200300, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "स्त्रियः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2200301, "chapter_id": 5265, "verse_number": "११", "content_sanskrit": "वर्तते रन्तिदेवस्य सत्रं वर्षसहस्रकम् ।\nतत्र तस्य नृपस्याशु पशुत्वमुपगच्छत\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2200302, "chapter_id": 5265, "verse_number": "१२", "content_sanskrit": "ततस्तस्योपयोगेन पशुत्वे यज्ञसंस्कृताः ।\nगोलोकान् प्राप्स्यथ शुभांस्तेन पुण्येन संयुताः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2200303, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2200304, "chapter_id": 5265, "verse_number": "१३", "content_sanskrit": "एतत् तासां वचः श्रुत्वा गवां संहृष्टमानसाः ।\nगमनाय मनश्चक्रुरौत्सुक्यं चागमन् परम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2200305, "chapter_id": 5265, "verse_number": "१४", "content_sanskrit": "न हि नो भार्गवो दाता पशुत्वेनोपयोजनम् ।\nयज्ञस्तस्य नरेन्द्रस्य वर्तते धर्मतस्तथा\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2200306, "chapter_id": 5265, "verse_number": "१५", "content_sanskrit": "वयं न चाननुज्ञाताः शक्ता गन्तुं कथञ्चन ।\nअवोचन्नथ तत्रत्या भार्गवो वध्यतामयम्\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2200307, "chapter_id": 5265, "verse_number": "१६", "content_sanskrit": "एतत् सर्वा रोचयत न हि शक्यमतोऽन्यथा ।\nलोकान् प्राप्तुं सहास्माभिर्निश्चयः क्रियतामयम्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2200308, "chapter_id": 5265, "verse_number": "१७", "content_sanskrit": "न तु तासां समेतानां काचिद् घोरेण चक्षुषा ।\nशक्नोति भार्गवं द्रष्टुं सत्कृतेनोपसंयुता\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2200309, "chapter_id": 5265, "verse_number": "१८", "content_sanskrit": "अथ पद्मसवर्णाभा भास्करांशुसमप्रभाः ।\nजपालोहितताम्राक्ष्यो निर्मांसकठिनाननाः\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2200310, "chapter_id": 5265, "verse_number": "१९", "content_sanskrit": "रोहिण्यः कपिलाः प्राहुः सर्वासां वै समक्षतः ।\nमेघस्तनितनिर्घोषास्तेजोभिरभिरञ्जिताः\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2200311, "chapter_id": 5265, "verse_number": "२०", "content_sanskrit": "वयं हि तं वधिष्यामः सुमित्रं नात्र संशयः ।\nसुकृतं पृष्ठतः कृत्वा किं नः श्रेयो विधास्यथ\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2200312, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "गावः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2200313, "chapter_id": 5265, "verse_number": "२१", "content_sanskrit": "कपिला सर्ववर्णेषु प्रधानत्वमवाप्स्यथ ।\nगवां शतफलाच्चैकां दत्त्वा फलमवाप्स्यति\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2200314, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2200315, "chapter_id": 5265, "verse_number": "२२", "content_sanskrit": "एतद् गवां वचः श्रुत्वा कपिला हृष्टमानसाः ।\nचक्रुः सर्वा भार्गवस्य सुमित्रस्य वधे मतिम्\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2200316, "chapter_id": 5265, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे भार्गववधनिश्चयो नाम षोडशाधिकशततमोऽध्यायः ॥११६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]