[{"id": 7003784000, "chapter_id": 23784, "verse_number": "२-२-२८-१", "content_sanskrit": "जैमिनिरुवाच ।\nततः स भगवान्मन्त्रमहिम्ना नरकेसरी ।\nइन्द्रद्युम्नादिभिः सर्वैददृशेऽद्भुतदर्शनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003784001, "chapter_id": 23784, "verse_number": "२-२-२८-२", "content_sanskrit": "लेलिहानो जगत्सर्वं समंताज्ज्वलजिह्वया ।\nकालाग्निरुद्रं सकलं ग्रसंतमिव चोत्थितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003784002, "chapter_id": 23784, "verse_number": "२-२-२८-३", "content_sanskrit": "रोदसीकंदरं व्याप्य तेजसा तपता भृशम् ।\nअनेकाक्षिमुखग्रीवाकरपादश्रुतिर्विभुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003784003, "chapter_id": 23784, "verse_number": "२-२-२८-४", "content_sanskrit": "सर्वाश्चर्यमयो देवः केवलं तेजसो निधिः ।\nभयत्रस्ताः समुद्विग्ना नेशाः स्तोतुमपि प्रभुम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003784004, "chapter_id": 23784, "verse_number": "२-२-२८-५", "content_sanskrit": "तं तथाविधमालोक्य नारदः पितरं तदा ।\nपप्रच्छ भगवन्नित्थं कथमेष प्रकाशते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003784005, "chapter_id": 23784, "verse_number": "२-२-२८-६", "content_sanskrit": "नारद उवाच ।\nअनुग्रहायावतरत्प्रत्युतैष भयप्रदः ।\nसर्वे भयात्स्थिरतराः प्रलयाशंकिनोऽधुना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003784006, "chapter_id": 23784, "verse_number": "२-२-२८-७", "content_sanskrit": "त्वमेव भगवल्लीलां जानासि जगतां पते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003784007, "chapter_id": 23784, "verse_number": "२-२-२८-८", "content_sanskrit": "तच्छ्रुत्वा नारदवचः पद्मयोनिः स्मिताननः ।\nउवाच कौतुकं वाक्यं सर्वेषामुपकारकम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003784008, "chapter_id": 23784, "verse_number": "२-२-२८-९", "content_sanskrit": "ब्रह्मोवाच ।\nअवतीर्णं जगन्नाथं दृष्ट्वा दारुवपुर्धरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003784009, "chapter_id": 23784, "verse_number": "२-२-२८-१०", "content_sanskrit": "अवज्ञास्यंति वै लोकाः साक्षाद्ब्रह्मस्वरूपिणम् ।\nअतत्त्ववेदिनो मूढा महिमानं विदंत्विति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003784010, "chapter_id": 23784, "verse_number": "२-२-२८-११", "content_sanskrit": "मंत्रितो मन्त्रराजेन येनासौ परमेष्ठिना ।\nपुराभिमंत्रितो येन विददार महासुरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003784011, "chapter_id": 23784, "verse_number": "२-२-२८-१२", "content_sanskrit": "तादृग्रूपं सुदुर्दर्शं प्राप्यमेति भयप्रदम् ।\nमूर्तिरेषा परा काष्ठा विष्णोरमिततेजसः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003784012, "chapter_id": 23784, "verse_number": "२-२-२८-१३", "content_sanskrit": "यामभ्यर्च्य गतिं यांति पुनरावृत्तिदुर्लभाम् ।\nनृसिंहाभिमुखः स्तोत्रमिदमाह मुदान्वितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003784013, "chapter_id": 23784, "verse_number": "२-२-२८-१४", "content_sanskrit": "नमोऽस्तु ते देववरैकसिंह नमोऽस्तु पापौघगजैकसिंह ।\nनमोऽस्तु दुःखार्णवपारसिंह नमोऽस्तु तेजोमय दिव्यसिंह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003784014, "chapter_id": 23784, "verse_number": "२-२-२८-१५", "content_sanskrit": "नमोऽस्तु सर्वाकृतिचित्रसिंह नमोऽस्तु ते क्लेशविमुक्तिसिंह ।\nनमोऽस्तु ते दिव्यवपुर्नृसिंह नमोऽस्तु ते वीरवरैकसिंह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003784015, "chapter_id": 23784, "verse_number": "२-२-२८-१६", "content_sanskrit": "नमोऽस्तु ते दैत्यविदारसिंह नमोऽस्तु देवेष्वधि देवसिंह ।\nनमोऽस्तु वेदांतवनैकसिंह नमोऽस्तु ते योगिगुहैकसिंह ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003784016, "chapter_id": 23784, "verse_number": "२-२-२८-१७", "content_sanskrit": "नमोऽस्तु ते सिंह वृषैकसिंह नमोऽस्तु नीलाचलशृंगसिंह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003784017, "chapter_id": 23784, "verse_number": "२-२-२८-१८", "content_sanskrit": "जैमिनिरुवाच ।\nस्तुत्वेत्थं दिव्यसिंहं तमिंद्रद्युम्नं प्रजापतिः ।\nसिंहयंत्रं समालेख्य तस्योपरि निवेश्य च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003784018, "chapter_id": 23784, "verse_number": "२-२-२८-१९", "content_sanskrit": "दीक्षयित्वा मन्त्रराजं साक्षादाथर्वणोदितम् ।\nआहुर्वैष्णवनिर्वाणं यं वेदांतपरायणाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003784019, "chapter_id": 23784, "verse_number": "२-२-२८-२०", "content_sanskrit": "यत्र वेदाश्च चत्वारः साक्षान्नित्यं प्रतिष्ठिताः ।\nयमधीत्य महामन्त्रं मनुः स्वायंभुवः पुरा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003784020, "chapter_id": 23784, "verse_number": "२-२-२८-२१", "content_sanskrit": "सृष्टिं चकार भगवान्प्राप्तमस्माच्चतुर्मुखात् ।\nअणिमादिगुणा यस्य फलं स्यादानुषंगिकम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003784021, "chapter_id": 23784, "verse_number": "२-२-२८-२२", "content_sanskrit": "एक एव महामन्त्रः पुरुषार्थचतुष्टयम् ।\nप्राप्तुं कारणभूतो हि किं पुनः क्षुद्रकामनाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003784022, "chapter_id": 23784, "verse_number": "२-२-२८-२३", "content_sanskrit": "एक एव महामंत्रः सर्वक्रतुफलप्रदः ।\nसर्वतीर्थप्रदः सर्वदानव्रतफलप्रदः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003784023, "chapter_id": 23784, "verse_number": "२-२-२८-२४", "content_sanskrit": "यथायं सर्वपापौघतूलराशेर्दवानलः ।\nदिव्यसिंहाकृतिर्देवो मंत्रराज्ञस्तथा ह्ययम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003784024, "chapter_id": 23784, "verse_number": "२-२-२८-२५", "content_sanskrit": "एनमभ्यस्य यतयो भवरोग त्यजंति हि ।\nयस्य ग्रहणमात्रेण ग्रहापस्मारराक्षसाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003784025, "chapter_id": 23784, "verse_number": "२-२-२८-२६", "content_sanskrit": "डाकिन्यो भूतवेतालपिशाचा उरगा ग्रहाः ।\nदूरादेव पलायंते नेशते वीक्षितुं च तम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003784026, "chapter_id": 23784, "verse_number": "२-२-२८-२७", "content_sanskrit": "मंत्रराजं ततो लब्ध्वा इन्द्रद्युम्नश्चतुर्मुखात् ।\nनृसिंहं शातवपुषं लक्ष्मीसंश्रितवक्षसम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003784027, "chapter_id": 23784, "verse_number": "२-२-२८-२८", "content_sanskrit": "चक्रं पिनाकं दधतं चंद्रसूर्याग्निचक्षुषम् ।\nजानुप्रसारितकरसरोजद्वंद्वमुन्नसम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003784028, "chapter_id": 23784, "verse_number": "२-२-२८-२९", "content_sanskrit": "योगपट्टासनारूढद्वात्रिंशद्दलपद्मके ।\nमंत्रवर्णमये मध्ये कर्णिकाप्रणवोज्ज्वले ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003784029, "chapter_id": 23784, "verse_number": "२-२-२८-३०", "content_sanskrit": "सुखासीनं साट्टहासं वीक्षंतं श्रीमुखांबुजम् ।\nसटामंडितवक्त्राब्जं दिव्यरत्नोज्ज्वलाकृति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003784030, "chapter_id": 23784, "verse_number": "२-२-२८-३१", "content_sanskrit": "फणासहस्रं विस्तार्य पश्चाच्छत्राकृतिं विभोः ।\nददर्श बलभद्रं तं हललांगलधारिणम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003784031, "chapter_id": 23784, "verse_number": "२-२-२८-३२", "content_sanskrit": "प्रजहर्ष नृपो दृष्ट्वा तादृशं पुरुषोत्तमम् ।\nविस्मयाविष्टचेताश्च पप्रच्छ कमलासनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003784032, "chapter_id": 23784, "verse_number": "२-२-२८-३३", "content_sanskrit": "भगवंश्चित्रमेतद्वै चरितं मधुघातिनः ।\nविज्ञातुं कथमस्माभिः शक्यः स्याल्लोकभावन ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003784033, "chapter_id": 23784, "verse_number": "२-२-२८-३४", "content_sanskrit": "यज्ञांते तादृशं रूपं बभार दारुनिर्मितम् ।\nरथस्थं भगवानेव प्रासादांतर्न्यवेशयत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003784034, "chapter_id": 23784, "verse_number": "२-२-२८-३५", "content_sanskrit": "मामाह पूर्वं वाणी सा गगनांतरिता तदा ।\nअपौरुषेयतरुणा चतुर्मूर्तिर्भविष्यति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003784035, "chapter_id": 23784, "verse_number": "२-२-२८-३६", "content_sanskrit": "इदानीमेक एवासौ दृश्यते सुप्रतिष्ठितः ।\nमाया वा तत्त्वमथ वा तत्त्वतो मे वद प्रभो ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003784036, "chapter_id": 23784, "verse_number": "२-२-२८-३७", "content_sanskrit": "श्रवणे यदि मां वेत्सि भाजनं भवभावन ।\nश्रुत्वैतत्प्रत्युवाचाथ संशयानं नृपोत्तमम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003784037, "chapter_id": 23784, "verse_number": "२-२-२८-३८", "content_sanskrit": "ब्रह्मोवाच ।\nआद्या मूर्तिर्भगवतो नारसिंहाकृतिर्नृप ।\nनारायणेन प्रथिता मदनुग्रहतस्त्वयि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003784038, "chapter_id": 23784, "verse_number": "२-२-२८-३९", "content_sanskrit": "दारवी मूर्तिरेषेति प्रतिमाबुद्धिरत्र वै ।\nमा भूत्ते नृपशार्दूल परं ब्रह्माकृतिस्त्वियम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003784039, "chapter_id": 23784, "verse_number": "२-२-२८-४०", "content_sanskrit": "खंडनात्सर्वदुःखानामखंडानंददानतः ।\nस्वभावाद्दारुरेषो हि परं ब्रह्माभिधीयते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003784040, "chapter_id": 23784, "verse_number": "२-२-२८-४१", "content_sanskrit": "इत्थं दारुमयो देवश्चतुर्वेदानुसारतः ।\nस्रष्टा स जगतां तस्मादात्मानं चापि सृष्टवान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003784041, "chapter_id": 23784, "verse_number": "२-२-२८-४२", "content_sanskrit": "शब्दब्रह्म परंब्रह्म नानयोर्भेद इष्यते ।\nलये तु एकमेवेदं सृष्टौ भेदः प्रवर्त्तते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003784042, "chapter_id": 23784, "verse_number": "२-२-२८-४३", "content_sanskrit": "अन्योन्यापेक्षिणौ भूप शब्दार्थौ हि परस्परम् ।\nअर्थाभावेन शब्दोऽस्ति शब्दाभावेन बुद्ध्यते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003784043, "chapter_id": 23784, "verse_number": "२-२-२८-४४", "content_sanskrit": "अर्थस्तस्माच्चतुर्वेदाः शब्दा ह्यर्थाश्च तादृशाः ।\nऋग्वेदरूपी हलधृक्सामवेदो नृकेसरी ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003784044, "chapter_id": 23784, "verse_number": "२-२-२८-४५", "content_sanskrit": "यजुर्मूर्त्तिस्त्वियं भद्रा चक्रमाथर्वणं स्मृतम् ।\nवेदश्चतुर्द्धा भेदोऽयमेकराशिरभेदतः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003784045, "chapter_id": 23784, "verse_number": "२-२-२८-४६", "content_sanskrit": "अतस्ते संशयो मा भूदेकस्तु बहुधा विभुः ।\nअवतारेषु चान्येषु न्यायेनैतेन वर्त्तते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003784046, "chapter_id": 23784, "verse_number": "२-२-२८-४७", "content_sanskrit": "भेदाभेदौ तथा ख्यातौ जगन्नाथस्य ते नृप ।\nयेन ते मनसस्तुष्टिस्तेन भक्त्या समाचर ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003784047, "chapter_id": 23784, "verse_number": "२-२-२८-४८", "content_sanskrit": "सर्वरूपमयो ह्येष सर्वमंत्रमयः प्रभुः ।\nआराध्यते यथा येन तथा तस्य फलप्रदः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003784048, "chapter_id": 23784, "verse_number": "२-२-२८-४९", "content_sanskrit": "यथा सुशुद्धं कनकं स्वेच्छया घटितं नृप ।\nतत्तत्संज्ञामवाप्येह तत्तत्संतोषकारकम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003784049, "chapter_id": 23784, "verse_number": "२-२-२८-५०", "content_sanskrit": "एवं महिम्ना भगवानत्राविरभवन्नृप ।\nयस्य यावांस्तु विश्वासस्तस्य सिद्धिस्तु तावती ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003784050, "chapter_id": 23784, "verse_number": "२-२-२८-५१", "content_sanskrit": "कर्मणा मनसा वाचा विशुद्धेनांतरात्मना ।\nसमाराधय गोविंदमत्र दारुवपुर्द्धरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003784051, "chapter_id": 23784, "verse_number": "२-२-२८-५२", "content_sanskrit": "चतुर्वर्गफलावाप्त्यै यथाभिलषितं तव ।\nअनेन मंत्रराजेन विष्णुमेनं समर्चय ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003784052, "chapter_id": 23784, "verse_number": "२-२-२८-५३", "content_sanskrit": "नातः परतरो मंत्रो न भूतो न भविष्यति ।\nअनेनाभ्यर्चितो विष्णुः प्रीतो भवति तत्क्षणात् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003784053, "chapter_id": 23784, "verse_number": "२-२-२८-५४", "content_sanskrit": "ददाति स्वपुरं चापि भगवान्भक्तवत्सलः ।\nयज्ञैस्तीर्थैर्व्रतैर्दानैस्तपोभिश्चापि तस्य किम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003784054, "chapter_id": 23784, "verse_number": "२-२-२८-५५", "content_sanskrit": "नीलाचलस्थं यो विष्णुं दारुमूर्तिमुपास्ति वै ।\nतत्त्वं ब्रवीमि ते भूप श्रुत्वैतदवधारय ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003784055, "chapter_id": 23784, "verse_number": "२-२-२८-५६", "content_sanskrit": "न्यग्रोधमूले कूलेऽस्य सिंधोर्नीलाचले स्थितम् ।\nदारुव्याजामृतं ब्रह्म दृष्ट्वा मुच्येन्न संशय ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003784056, "chapter_id": 23784, "verse_number": "२-२-२८-५७", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवादेऽष्टाविंशोऽध्यायः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]