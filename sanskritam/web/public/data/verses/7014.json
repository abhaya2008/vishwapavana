[
  {
    "id": 20132131,
    "chapter_id": 7014,
    "verse_number": "35.1",
    "content_sanskrit": "अथ पञ्चत्रिंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20132132,
    "chapter_id": 7014,
    "verse_number": "35.2",
    "content_sanskrit": "विन्यासं भूमिकानां च सम्प्रवक्ष्यामि नाटके । यादृशो यस्य कर्तव्यो विन्यासो भूमिकास्वथ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20132133,
    "chapter_id": 7014,
    "verse_number": "35.3",
    "content_sanskrit": "गतिवागङ्गचेष्टाभिः सत्त्वशीलस्वभावतः । परीक्ष्य पात्रं तज्ज्ञस्तु युञ्ज्याद् भूमिनिवेशने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20132134,
    "chapter_id": 7014,
    "verse_number": "35.4",
    "content_sanskrit": "तस्मिन्नन्विष्य हि गुणवान् कार्या पात्रसमाश्रया । न खेदजननं बुद्धेराचार्यस्य भविष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20132135,
    "chapter_id": 7014,
    "verse_number": "35.5",
    "content_sanskrit": "आचार्यः पात्रजांश्चैव गुणाञ्ज्ञात्वा स्वभावजान् । ततः कुर्याद् यथायोगं नृणां भूमिनिवेशनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20132136,
    "chapter_id": 7014,
    "verse_number": "35.6",
    "content_sanskrit": "अङ्गप्रत्यङ्गसंयुक्तमहीनाङ्गं वयोन्वितम् । न स्थूलं न कृशं चैव न दीर्घं न च मन्थरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20132137,
    "chapter_id": 7014,
    "verse_number": "35.7",
    "content_sanskrit": "श्लिष्टाङ्गं द्युतिमन्तं च सुस्वरं प्रियदर्शनम् । एतैर्गुणैश्च संयुक्तं देवभूमिषु योजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20132138,
    "chapter_id": 7014,
    "verse_number": "35.8",
    "content_sanskrit": "स्थूलं प्रांशुं बृहद्देहं मेघगम्भीरनिस्वनम् । रौद्रस्वभावनेत्रं च स्वभावभ्रुकुटीमुखम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20132139,
    "chapter_id": 7014,
    "verse_number": "35.9",
    "content_sanskrit": "रक्षोदानवदैत्यानां भूमिकासु प्रयोजयेत् । पुरुषाणां प्रयोगस्तु तथाङ्गक्रिययान्वितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20132140,
    "chapter_id": 7014,
    "verse_number": "35.10",
    "content_sanskrit": "सुनेत्रसुभ्रुवः स्वङ्गाः सुललाटाः सुनासिकाः । स्वोष्ठाः सुगण्डाः सुमुखाः सुकण्ठाः सुशिरोधराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20132141,
    "chapter_id": 7014,
    "verse_number": "35.11",
    "content_sanskrit": "स्वङ्गप्रत्यङ्गसंयुक्ता न दीर्घा न च मन्थराः । न स्थूला न कृशाश्चैव स्वभावेन व्यवस्थिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20132142,
    "chapter_id": 7014,
    "verse_number": "35.12",
    "content_sanskrit": "सुशीला ज्ञानवन्तश्च तथा च प्रियदर्शनाः । कुमारराजभूमौ तु संयोज्याश्च नरोत्तमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20132143,
    "chapter_id": 7014,
    "verse_number": "35.13",
    "content_sanskrit": "अङ्गैरविकलैर्धीरं स्फुटं वसनकर्मणि । न दीर्घं नैव च स्थूलमूहापोहविचक्षणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20132144,
    "chapter_id": 7014,
    "verse_number": "35.14",
    "content_sanskrit": "अदीनं च प्रगल्भं च प्रत्युत्पन्नविनिश्चयम् । सेनापतेरमात्यानां भूमिकासु प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20132145,
    "chapter_id": 7014,
    "verse_number": "35.15",
    "content_sanskrit": "पिङ्गाक्षं घोणनासं च नेत्रमुच्चमथापि वा । कञ्चुकिश्रोत्रियादीनां भूमिकासु नियोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20132146,
    "chapter_id": 7014,
    "verse_number": "35.16",
    "content_sanskrit": "एवमन्येष्वपि तथा नाट्यधर्मविभागतः । देशवेषानुरूपेण पात्रं योज्यं स्वभूमिषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20132147,
    "chapter_id": 7014,
    "verse_number": "35.17",
    "content_sanskrit": "मन्थरं वामनं कुब्जं विकृतं विकृताननम् । विष्टब्धनेत्रं काणाक्षं स्थूलं चिपिटनासिकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20132148,
    "chapter_id": 7014,
    "verse_number": "35.18",
    "content_sanskrit": "दुर्जनं दुस्वभावं च विकृताचारमेव च । दासभूमौ प्रयुञ्जीत बुधो दासाङ्गसम्भवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20132149,
    "chapter_id": 7014,
    "verse_number": "35.19",
    "content_sanskrit": "प्रकृत्याऽतिकृशं क्षामं तपःश्रान्तेषु योजयेत् । तथा च पुरुषं स्थूलमुपरोधेषु योजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20132150,
    "chapter_id": 7014,
    "verse_number": "35.20",
    "content_sanskrit": "यदि वा नेदृशाः सन्ति प्रकृत्या पुरुषा द्विजाः । आचार्यबुद्ध्या योज्यास्तु भावचेष्टास्वभावतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20132151,
    "chapter_id": 7014,
    "verse_number": "35.21",
    "content_sanskrit": "या यस्य सदृशी चेष्टा ह्युत्तमाधममध्यमा । स तथाऽऽचार्ययोगेन नियम्या भावभाविनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20132152,
    "chapter_id": 7014,
    "verse_number": "35.22",
    "content_sanskrit": "अतः परं प्रवक्ष्यामि भरतानां विकल्पनम् भरताश्रयाश्च भरतो विदूषकः सौरिकस्तथा नान्दी । नन्दी ससूत्रधारो नाट्यरसो नायकश्चैव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20132153,
    "chapter_id": 7014,
    "verse_number": "35.23",
    "content_sanskrit": "मुकुटाभरणविकल्पौ विज्ञेयो माल्यवस्तुविविधैश्च । कारककुशीलवाद्या विज्ञेया नामतश्चैव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20132154,
    "chapter_id": 7014,
    "verse_number": "35.24",
    "content_sanskrit": "धुर्यवदेको यस्मादुद्धारो ऽनेकभूमिकायुक्तः । भाण्डग्रहोपकरणैनाट्यं भरतो भवेत् तस्मात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20132155,
    "chapter_id": 7014,
    "verse_number": "35.25",
    "content_sanskrit": "लोकाहृदाश्रयकृता सर्वप्रकृतिप्रचारसंयुक्ता । नानाश्रयां प्रकुरुते तथा च नारी तु सर्वत्र ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20132156,
    "chapter_id": 7014,
    "verse_number": "35.26",
    "content_sanskrit": "प्रत्युत्पन्नप्रतिभो नर्मकृतो नर्मगर्भनिर्भेदः । छेदविदूषितवचनो विदूषको नाम विज्ञेयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20132157,
    "chapter_id": 7014,
    "verse_number": "35.27",
    "content_sanskrit": "तूर्यतिस्तु नरः सर्वातोद्यप्रवादने कुशलः । तूरपरिग्रहयुक्तो विज्ञेयस्तौरिको नाम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20132158,
    "chapter_id": 7014,
    "verse_number": "35.28",
    "content_sanskrit": "नटनृति धात्वर्थो ऽयं भूतं नाटयति लोकवृत्तान्तम् । रसभावसत्वयुक्तं यस्मात् तस्मान्नटो भवति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20132159,
    "chapter_id": 7014,
    "verse_number": "35.29",
    "content_sanskrit": "स्तुत्यभिवादनकृतैर्मधुरैर्वाक्यैः सुमङ्गलाचारैः । सर्व स्तौति हि लोकं यस्मात् तस्माद्भवेद्वादी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20132160,
    "chapter_id": 7014,
    "verse_number": "35.30",
    "content_sanskrit": "भावेभ्यो बहुधाऽस्मिन् रसा वदति नाट्ययोगेषु । प्राकृतसंस्कृतपाठ्यो नन्दी नामेति स ज्ञेयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20132161,
    "chapter_id": 7014,
    "verse_number": "35.31",
    "content_sanskrit": "गीतस्य च वाद्यस्य च पाठ्यस्य च नैकभावविहितस्य । शिष्टोपदेशयोगात् सूत्रज्ञः सूत्रधारस्तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20132162,
    "chapter_id": 7014,
    "verse_number": "35.32",
    "content_sanskrit": "यस्मात् यथोपदिष्टान् रसांश्च भावांश्च सत्वसंयुक्तान् । भूमिविकल्पैर्नयति च नाट्यकरः कीर्तितस्तस्मात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20132163,
    "chapter_id": 7014,
    "verse_number": "35.33",
    "content_sanskrit": "चतुरातोद्यविधानं सर्वस्य तु शास्त्रखे दविहितस्य । नाट्यस्यान्तं गच्छति तस्माद्वै नायको ऽभिहितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20132164,
    "chapter_id": 7014,
    "verse_number": "35.34",
    "content_sanskrit": "नानाप्रकृतिसमुत्थं करोति यः शीर्षकं मुकुटयोगे । विविधैर्वेषविशेषैः स च कुटकारस्तु विज्ञेयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20132165,
    "chapter_id": 7014,
    "verse_number": "35.35",
    "content_sanskrit": "भाण्डकवाद्यज्ञा या लयतालज्ञा रसानुविद्धा च । सर्वाङ्गसुन्दरी वै कर्तव्या नाटकीया तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20132166,
    "chapter_id": 7014,
    "verse_number": "35.36",
    "content_sanskrit": "यस्त्वाभरणं कुर्याद् बहुविधविहितं स चाभरणः । यश्चोपकरणयोगात् स तेन नाम्नाऽभिधातव्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20132167,
    "chapter_id": 7014,
    "verse_number": "35.37",
    "content_sanskrit": "यो वै माल्यं कुरुते पङ्चविधं माल्याकृत् स विज्ञेयः । यश्चापि वेषयोगं कुरुते स च वेषकारी तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20132168,
    "chapter_id": 7014,
    "verse_number": "35.38",
