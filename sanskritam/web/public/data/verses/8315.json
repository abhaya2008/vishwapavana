[{"id": 900004000, "chapter_id": 8315, "verse_number": "11.1", "content_sanskrit": "एकादश्यां निराहारः समभ्यर्च्य जनार्दनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004001, "chapter_id": 8315, "verse_number": "11.2", "content_sanskrit": "भगवानपि तां रात्रिं शारदोत्फुल्लमल्लिकाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004002, "chapter_id": 8315, "verse_number": "11.3", "content_sanskrit": "अन्तर्हिते भगवति सहसैव व्रजाङ्गनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004003, "chapter_id": 8315, "verse_number": "11.4", "content_sanskrit": "जयति तेऽधिकं जन्मना व्रजः श्रयत इन्दिरा साधु तत्र हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004004, "chapter_id": 8315, "verse_number": "11.5", "content_sanskrit": "इति गोप्यः प्रगायन्त्यः प्रलपन्त्यश्च चित्रधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004005, "chapter_id": 8315, "verse_number": "11.6", "content_sanskrit": "इत्थं भगवतो गोप्यः श्रुत्वा वाचः सुपेशलाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004006, "chapter_id": 8315, "verse_number": "11.7", "content_sanskrit": "एकदा देवयात्रायां गोपाला जातकौतुकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004007, "chapter_id": 8315, "verse_number": "11.8", "content_sanskrit": "गोप्यः कृष्णे वनं याते तमनुद्रुतचेतसः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004008, "chapter_id": 8315, "verse_number": "11.9", "content_sanskrit": "अथ तर्ह्यागतो गोष्ठमरिष्टो वृषभासुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004009, "chapter_id": 8315, "verse_number": "11.10", "content_sanskrit": "केशी तु कंसप्रहितः खुरैर्महीं महाहयो निर्दरयन् मनोजवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004010, "chapter_id": 8315, "verse_number": "11.11", "content_sanskrit": "अक्रूरोऽपि च तां रात्रिं मधुपुर्यां महामतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004011, "chapter_id": 8315, "verse_number": "11.12", "content_sanskrit": "सुखोपविष्टः पर्यङ्के रामकृष्णानुमोदितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004012, "chapter_id": 8315, "verse_number": "11.13", "content_sanskrit": "एवं दृष्ट्वा तमक्रूरः प्रसन्नहृदयेन्द्रियः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004013, "chapter_id": 8315, "verse_number": "11.14", "content_sanskrit": "स्तुवतस्तस्य भगवान् दर्शयित्वा जले वपुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004014, "chapter_id": 8315, "verse_number": "11.15", "content_sanskrit": "अथ व्रजन् राजपथेन माधवः स्त्रियं गृहीताङ्गविलेपभाजनाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004015, "chapter_id": 8315, "verse_number": "11.16", "content_sanskrit": "अथ कृष्णश्च रामश्च कृतशौचौ परन्तपौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004016, "chapter_id": 8315, "verse_number": "11.17", "content_sanskrit": "एवं चिन्तितसङ्कल्पो भगवान् मधुसूदनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004017, "chapter_id": 8315, "verse_number": "11.18", "content_sanskrit": "पितरावुपलब्धार्थौ विदित्वा पुरुषोत्तमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900004018, "chapter_id": 8315, "verse_number": "11.19", "content_sanskrit": "वृष्णीनां प्रवरो मन्त्री कृष्णस्य दयितः सखा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900004019, "chapter_id": 8315, "verse_number": "11.20", "content_sanskrit": "तं वीक्ष्य कुष्णानुचरं व्रजस्त्रियः प्रलम्बबाहुं नवकञ्जलोचनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900004020, "chapter_id": 8315, "verse_number": "11.21", "content_sanskrit": "ततस्ताः कृष्णसन्देशैर्व्यपेतविरहामयाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900004021, "chapter_id": 8315, "verse_number": "11.22", "content_sanskrit": "अथ विज्ञाय भगवान् सर्वात्मा सर्वदर्शनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900004022, "chapter_id": 8315, "verse_number": "11.23", "content_sanskrit": "स गत्वा हस्तिनपुरं पौरवेन्द्रयशोऽङ्कितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]