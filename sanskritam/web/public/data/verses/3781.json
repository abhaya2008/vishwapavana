[{"id": 2129285, "chapter_id": 3781, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129286, "chapter_id": 3781, "verse_number": "१", "content_sanskrit": "कथंवीर्यः स राजाऽभूत् सोमको वदतां वर ।\nकर्माण्यस्य प्रभावं च श्रोतुमिच्छामि तत्त्वतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129287, "chapter_id": 3781, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129288, "chapter_id": 3781, "verse_number": "२", "content_sanskrit": "युधिष्ठिरासीन्नृपतिः सोमको नाम धार्मिकः ।\nतस्य भार्याशतं राजन् सदृशीनामभूत् तदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129289, "chapter_id": 3781, "verse_number": "३", "content_sanskrit": "स वै यत्नेन महता तासु पुत्रं महीपतिः ।\nकञ्चिन्नासादयामास कालेन महताऽपि च \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129290, "chapter_id": 3781, "verse_number": "४", "content_sanskrit": "कदाचित्तस्य वृद्धस्य यतमानस्य धीमतः ।\nजन्तुर्नाम सुतस्तस्य ज्येष्ठायां समजायत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129291, "chapter_id": 3781, "verse_number": "५", "content_sanskrit": "तं जातं मातरः सर्वाः परिवार्य समासते ।\nसततं पृष्ठतः कृत्वा कामभोगान् विशांपते \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129292, "chapter_id": 3781, "verse_number": "६", "content_sanskrit": "ततः पिपीलिका जन्तुं कदाचिददशत् स्फिजि ।\nस दष्टो ह्यरुदद् राजन् तेन दुःखेन बालकः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129293, "chapter_id": 3781, "verse_number": "७", "content_sanskrit": "ततस्ता मातरः सर्वाः प्राक्रोशन् भृशदुःखिताः ।\nपरिवार्य जन्तुं बालं तं स शब्दस्तुमुलोऽभवत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129294, "chapter_id": 3781, "verse_number": "८", "content_sanskrit": "तमार्तनादं सहसा शुश्राव स महीपतिः ।\nअमात्यपरिषन्मध्ये उपविष्टः सह द्विजैः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129295, "chapter_id": 3781, "verse_number": "९", "content_sanskrit": "ततः प्रस्थापयामास किमेतदिति पार्थिवः ।\nतस्मै क्षत्ता यथावृत्तमाचचक्षे सुतं प्रति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129296, "chapter_id": 3781, "verse_number": "१०", "content_sanskrit": "त्वरमाणः स चोत्थाय सोमकः सह मन्त्रिभिः ।\nप्रविश्यान्तःपुरं पुत्रमाश्वासयदरिन्दमः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129297, "chapter_id": 3781, "verse_number": "११", "content_sanskrit": "सान्त्वयित्वा तु तं पुत्रं निष्क्रम्यान्तःपुरात् ततः ।\nऋत्विजा सहितो राजन् सहामात्य उपाविशत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129298, "chapter_id": 3781, "verse_number": "", "content_sanskrit": "सोमकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129299, "chapter_id": 3781, "verse_number": "१२", "content_sanskrit": "धिगस्त्विहैकपुत्रत्वमपुत्रत्वं वरं भवेत् ।\nअनित्यत्वाच्च भूतानां शोक एवैकपुत्रता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129300, "chapter_id": 3781, "verse_number": "१३", "content_sanskrit": "इदं भार्याशतं ब्रह्मन् परीक्ष्योपचितं प्रभो ।\nपुत्रार्थिना मया चोढं न चासां विद्यते प्रजा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129301, "chapter_id": 3781, "verse_number": "१४", "content_sanskrit": "एकः कथञ्चिदुत्पन्नः पुत्रो जन्तुरयं मम ।\nयतमानासु सर्वासु किं नु दुःखमतः परम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129302, "chapter_id": 3781, "verse_number": "१५", "content_sanskrit": "वयश्च समतीतं मे सभार्यस्य द्विजोत्तम ।\nआसां प्राणाः समायत्ता ममास्मिन्नेकपुत्रके \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129303, "chapter_id": 3781, "verse_number": "१६", "content_sanskrit": "स्यात्तु कर्म तथायुक्तं येन पुत्रशतं भवेत् ।\nमहता लघुना वाऽपि कर्मणा दुष्करेण वा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129304, "chapter_id": 3781, "verse_number": "", "content_sanskrit": "ऋत्विक्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129305, "chapter_id": 3781, "verse_number": "१७", "content_sanskrit": "अस्ति चैतादृशं कर्म येन पुत्रशतं भवेत् ।\nयदि शक्नोषि तत् कर्तुमथ वक्ष्यामि सोमक\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129306, "chapter_id": 3781, "verse_number": "", "content_sanskrit": "सोमकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129307, "chapter_id": 3781, "verse_number": "१८", "content_sanskrit": "कार्यं वा यदि वाऽकार्यं येन पुत्रशतं भवेत् ।\nकृतमेवेति तद् विद्धि भगवन् तद् ब्रवीहि मे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129308, "chapter_id": 3781, "verse_number": "", "content_sanskrit": "ऋत्विक्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129309, "chapter_id": 3781, "verse_number": "१९", "content_sanskrit": "यजस्व जन्तुना राजन् त्वं मया वितते क्रतौ ।\nततः पुत्रशतं श्रीमद् भविष्यत्यचिरेण ते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129310, "chapter_id": 3781, "verse_number": "२०", "content_sanskrit": "वपायां हूयमानायां धूममाघ्रान्तु मातरः ।\nततस्ताः सुमहावीर्यान् जनयिष्यन्ति ते सुतान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129311, "chapter_id": 3781, "verse_number": "२१", "content_sanskrit": "तस्यामेव तु ते जन्तुर्भविता पुनरात्मजः ।\nउत्तरे चास्य सौवर्णं लक्ष्म पार्श्वे भविष्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129312, "chapter_id": 3781, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्रयोविंशोत्तरशततमोऽध्यायः ॥१२३॥ तीर्थयात्रापर्वणि एकोनाशीतितमोऽध्यायः ॥७९॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]