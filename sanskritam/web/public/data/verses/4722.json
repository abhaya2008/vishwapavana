[{"id": 2175770, "chapter_id": 4722, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175771, "chapter_id": 4722, "verse_number": "१", "content_sanskrit": "इन्द्रतीर्थं ततो गत्वा यदूनां प्रवरो बली ।\nविप्रेभ्यो धनरत्नानि स्नात्वा दत्त्वा यथाविधि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175772, "chapter_id": 4722, "verse_number": "२", "content_sanskrit": "तत्र ह्यमरराजो वै ईजे क्रतुशतेन ह ।\nबृहस्पतेश्च देवेशः प्रददौ विपुलं धनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175773, "chapter_id": 4722, "verse_number": "३", "content_sanskrit": "अनर्गलान् सजारूथ्यान् सर्वान् विविधदक्षिणान् ।\nआजहार क्रतूंस्तत्र यथोक्तान् वेदपारगैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175774, "chapter_id": 4722, "verse_number": "४", "content_sanskrit": "क्रतूंस्तान् भरतश्रेष्ठ शतकृत्वो महाद्युतिः ।\nपूरयामास विधिवद् ततः ख्यातः शतक्रतुः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175775, "chapter_id": 4722, "verse_number": "५", "content_sanskrit": "तस्य नाम्ना तु तत् तीर्थं शिवं पुण्यजलावृतम् ।\nइन्द्रतीर्थमिति ख्यातं सर्वपापप्रमोचनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175776, "chapter_id": 4722, "verse_number": "६", "content_sanskrit": "उपस्पृश्य तु तत्रापि विधिवन्मुसलायुधः ।\nब्राह्मणान् पूजयित्वा च पानाच्छादनभोजनैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175777, "chapter_id": 4722, "verse_number": "७", "content_sanskrit": "शुभं तीर्थवरं तस्माद् रामतीर्थं जगाम ह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175778, "chapter_id": 4722, "verse_number": "८", "content_sanskrit": "यत्र रामो महाभागो भार्गवः सुमहातपाः ।\nअसकृत् पृथिवीं कृत्वा हतक्षत्रियपुङ्गवाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175779, "chapter_id": 4722, "verse_number": "९", "content_sanskrit": "उपाध्यायं पुरस्कृत्य काश्यपं मुनिपुङ्गवम् ।\nअयजद् वाजपेयेन सोऽश्वमेधशतेन च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175780, "chapter_id": 4722, "verse_number": "१०", "content_sanskrit": "प्रददौ दक्षिणार्थं च पृथिवीं सागराम्बराम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175781, "chapter_id": 4722, "verse_number": "११", "content_sanskrit": "रामो दत्त्वा धनं तत्र द्विजेभ्यो जनमेजय ।\nउपस्पृश्य यथान्यायं पूजयित्वा तथा द्विजान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175782, "chapter_id": 4722, "verse_number": "१२", "content_sanskrit": "पुण्यतीर्थे शुभे देशे वसु दत्त्वा हलायुधः ।\nमुनींश्चैवाभिवाद्याथ यामुनं तीर्थमागतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175783, "chapter_id": 4722, "verse_number": "१३", "content_sanskrit": "यत्रानयामास तदा राजसूयमपाम्पतिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175784, "chapter_id": 4722, "verse_number": "१४", "content_sanskrit": "दितेः सुतान् महाभागो वरुणो वै सितप्रभः ।\nयत्र निर्जित्य सङ्ग्रामे मानुषान् दानवांस्तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175785, "chapter_id": 4722, "verse_number": "१५", "content_sanskrit": "गन्धर्वान् राक्षसांश्चैव वरुणः परवीरहा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175786, "chapter_id": 4722, "verse_number": "१६", "content_sanskrit": "तस्मिन् क्रतुवरे वृत्ते सङ्ग्रामः समजायत ।\nदेवानामसुराणां च त्रैलोक्यस्य क्षयावहः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175787, "chapter_id": 4722, "verse_number": "१७", "content_sanskrit": "राजसूये क्रतुश्रेष्ठे निवृत्ते जनमेजय ।\nजायते सुमहाघोरः सङ्क्षयः क्षत्रियान् प्रति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175788, "chapter_id": 4722, "verse_number": "१८", "content_sanskrit": "हलायुधस्तदा रामः तस्मिंस्तीर्थवरे शुभे ।\nतत्र स्नात्वा च दत्त्वा च द्विजेभ्यो वसु माधवः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175789, "chapter_id": 4722, "verse_number": "१९", "content_sanskrit": "वनमाली ततो हृष्टः स्तूयमानो द्विजातिभिः ।\nतस्मादादित्यतीर्थं च जगाम कमलेक्षणः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175790, "chapter_id": 4722, "verse_number": "२०", "content_sanskrit": "यत्रेष्ट्वा भगवान् ज्योतिर्भास्करो राजसत्तम ।\nज्योतिषामाधिपत्यं च प्रभावं चाभ्यपद्यत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175791, "chapter_id": 4722, "verse_number": "२१", "content_sanskrit": "तस्या नद्यास्तु तीरे वै सर्वे देवाः सवासवाः ।\nविश्वे तथा समरुतो गन्धर्वाप्सरसश्च ह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175792, "chapter_id": 4722, "verse_number": "२२", "content_sanskrit": "द्वैपायनः शुकश्चैव कृष्णश्च मधुसूदनः ।\nयक्षाश्च राक्षसाश्चैव पिशाचाश्च विशाम्पते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175793, "chapter_id": 4722, "verse_number": "२३", "content_sanskrit": "एते चान्ये च बहवो योगसिद्धाः सहस्रशः ।\nतस्मिंस्तीर्थे सरस्वत्याः शिवे पुण्ये परन्तप\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175794, "chapter_id": 4722, "verse_number": "२४", "content_sanskrit": "यत्र हत्वा पुरा विष्णुः कैटभं मधुमेव च ।\nआप्लुतो भरतश्रेष्ठ तीर्थप्रवर उत्तमे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175795, "chapter_id": 4722, "verse_number": "२५", "content_sanskrit": "द्वैपायनश्च धर्मात्मा तत्रैवाप्लुत्य भारत ।\nसम्प्राप्तः परमं योगं सिद्धिं च परमां गतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175796, "chapter_id": 4722, "verse_number": "२६", "content_sanskrit": "असितो देवलश्चैव तस्मिन्नेव महातपाः ।\nपरमं योगमास्थाय योगयुक्तोऽभवन्मुनिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175797, "chapter_id": 4722, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि भार्गवतीर्थवर्णनं नाम विंशोऽध्यायः ॥२०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]