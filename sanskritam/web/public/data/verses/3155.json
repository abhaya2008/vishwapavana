[{"id": 2100524, "chapter_id": 3155, "verse_number": "१४-११-१", "content_sanskrit": "वैशम्पायन उवाच।\nइत्युक्ते नृपतौ तस्मिन्व्यासेनाद्भुतकर्मणा।\nवासुदेवो महातेजास्ततो वचनमाददे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2100525, "chapter_id": 3155, "verse_number": "१४-११-२", "content_sanskrit": "तं नृपं दीनमनसं निहतज्ञातिबान्धवम्।\nउपप्लुतमिवादित्यं सधूममिव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2100526, "chapter_id": 3155, "verse_number": "१४-११-३", "content_sanskrit": "निर्विण्णमनसं पार्थं ज्ञात्वा वृष्णिकुलोद्वहः।\nआश्वासनन्धर्मसुतं प्रवक्तुमुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2100527, "chapter_id": 3155, "verse_number": "१४-११-४x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2100528, "chapter_id": 3155, "verse_number": "१४-११-४", "content_sanskrit": "सर्वं जिह्मं मृत्युपदमजिह्मं ब्रह्मणः पदम्।\nएतावान्ज्ञानविषयः किं प्रलापः करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2100529, "chapter_id": 3155, "verse_number": "१४-११-५", "content_sanskrit": "नैव तेऽनुष्ठितं कर्म नैव ते शत्रवो जिताः।\nकथं शत्रुं शरीरस्तमात्मनो नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2100530, "chapter_id": 3155, "verse_number": "१४-११-६", "content_sanskrit": "अत्र ते वर्तयिष्यामि यथाधर्मं यथाश्रुतम्।\nइन्द्रस्य सह वृत्रेण यथा युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2100531, "chapter_id": 3155, "verse_number": "१४-११-७", "content_sanskrit": "वृत्रेण पृथिवी व्याप्ता पुरा किल नराधिप।\nदृष्ट्वा स पृथिवीं व्याप्तां गन्धस्य विषये हृते।\nधराहरणदुर्गन्धो विषयः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2100532, "chapter_id": 3155, "verse_number": "१४-११-८", "content_sanskrit": "शतक्रतुश्चुकोपाथ गन्धस्य विषये हृते।\nवृत्रस्य सततः क्रुद्धो घोरं वज्रमवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2100533, "chapter_id": 3155, "verse_number": "१४-११-९", "content_sanskrit": "स वध्यमानो वज्रेण सुभृशं भूरितेजसा।\nविवेश सहसा तोयं जग्राह विषयं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2100534, "chapter_id": 3155, "verse_number": "१४-११-१०", "content_sanskrit": "अप्सु वृत्रगृहीतासु रसे च विषये हृते।\nशतक्रतुरतिक्रुद्धस्तत्र वज्रमवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2100535, "chapter_id": 3155, "verse_number": "१४-११-११", "content_sanskrit": "स वध्यमानो वज्रेण तस्मिन्नमिततेजसा।\nविवेश सहसा ज्योतिर्जग्राह विषयं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2100536, "chapter_id": 3155, "verse_number": "१४-११-१२", "content_sanskrit": "व्याप्ते ज्योतिषि वृत्रेण रूपेऽथ विषये हृते।\nशतक्रतुरतिक्रुद्धस्तत्र वज्रमवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2100537, "chapter_id": 3155, "verse_number": "१४-११-१३", "content_sanskrit": "स वद्यमानो वज्रेण तस्मिन्नमिततेजसा।\nविवेश सहसा वायुं जग्राह विषयं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2100538, "chapter_id": 3155, "verse_number": "१४-११-१४", "content_sanskrit": "व्याप्ते वायौ तु वृत्रेण स्पर्शेऽथ विषये हृते।\nशतक्रतुरतिक्रुद्धस्तत्र वज्रमवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2100539, "chapter_id": 3155, "verse_number": "१४-११-१५", "content_sanskrit": "स वध्यगानो वज्रेण तस्मिन्नमिततेजसा।\nआकाशमभिदुद्राव जग्राह विषयं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2100540, "chapter_id": 3155, "verse_number": "१४-११-१६", "content_sanskrit": "आकाशे वृत्रभूतेऽथ शब्दे च विषये हृते।\nशतक्रतुरभिक्रुद्धस्तत्र वज्रमवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2100541, "chapter_id": 3155, "verse_number": "१४-११-१७", "content_sanskrit": "स वध्यमानो वज्रेण तस्मिन्नमिततेजसा।\nविवेश सहसा शक्रं जग्राह विषयं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2100542, "chapter_id": 3155, "verse_number": "१४-११-१८", "content_sanskrit": "तस्य वृत्रगृहीतस्य मोहः समभवन्महान्।\nरथन्तरेण तं साम्ना वसिष्ठः प्रत्यबोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2100543, "chapter_id": 3155, "verse_number": "१४-११-१९", "content_sanskrit": "ततो वृत्रं शरीरस्थं जघान भरतर्षभ।\nशतक्रतुरदृश्येन वज्रेणेतीह नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2100544, "chapter_id": 3155, "verse_number": "१४-११-२०", "content_sanskrit": "इदं धर्म्यं रहस्यं वै शक्रेणोक्तं महर्षिषु।\nऋषिभिश्च मम प्रोक्तं तन्निबोध जनाधिप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2100545, "chapter_id": 3155, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अश्वमेधपर्वणि एकादशोऽध्यायः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]