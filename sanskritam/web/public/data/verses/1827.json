[{"id": 2038084, "chapter_id": 1827, "verse_number": "५-७२-०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038085, "chapter_id": 1827, "verse_number": "५-७२-१", "content_sanskrit": "सञ्जयस्य श्रुतं वाक्यं भवतश्च श्रुतं मया।\nसर्वं जानाम्यभिप्रायं तेषां च भवतश्च यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038086, "chapter_id": 1827, "verse_number": "५-७२-२", "content_sanskrit": "तव धर्माश्रिता बुद्धिस्तेषां वैराश्रया मतिः।\nयदयुद्धेन लभ्येत तत्ते बहुमतं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038087, "chapter_id": 1827, "verse_number": "५-७२-३", "content_sanskrit": "न चैवं नैष्ठिकं कर्म क्षत्रियस्य विशांपते।\nआहुराश्रमिणः सर्वे न भैक्षं क्षत्रियश्चरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038088, "chapter_id": 1827, "verse_number": "५-७२-४", "content_sanskrit": "जयो वधो वा सङ्ग्रामे धात्राऽऽदिष्टः सनातनः।\nस्वधर्मः क्षत्रियस्यैष कार्पण्यं न प्रशत्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038089, "chapter_id": 1827, "verse_number": "५-७२-५", "content_sanskrit": "न हि कार्पण्यमास्थाय शक्या वृत्तिर्युधिष्ठिर ।\nविक्रमस्व महाबाहो जहि शत्रून्परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038090, "chapter_id": 1827, "verse_number": "५-७२-६", "content_sanskrit": "अतिगृद्धाः कृतस्नेहा दीर्घकालं सहोषिताः ।\nकृतमित्राः कृतबला धार्तराष्ट्राः परन्तप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038091, "chapter_id": 1827, "verse_number": "५-७२-७", "content_sanskrit": "न पर्यायोऽस्ति यत्साम्यं त्वयि कुर्युर्विशांपते ।\nबलवत्तां हि मन्यन्ते भीष्मद्रोणकृपादिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038092, "chapter_id": 1827, "verse_number": "५-७२-८", "content_sanskrit": "यावच्च मार्दवेनैतान्राजन्नुपचरिष्यसि।\nतावदेते हरिष्यन्ति तव राज्यमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038093, "chapter_id": 1827, "verse_number": "५-७२-९", "content_sanskrit": "नानुक्रोशान्न कार्पण्यान्न च धर्मार्थकारणात्।\nअलं कर्तुं धार्तराष्ट्रस्तव काममरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038094, "chapter_id": 1827, "verse_number": "५-७२-१०", "content_sanskrit": "एतदेव निमित्तं ते धार्तराष्ट्रो यथा त्वयि ।\nनान्वतप्यत कोपेन तव कृत्वाऽपि दुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038095, "chapter_id": 1827, "verse_number": "५-७२-११", "content_sanskrit": "पितामहस्य द्रोणस्य विदुरस्य च धीमतः ।\nब्राह्मणानां च साधूनां राज्ञश्च नगरस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038096, "chapter_id": 1827, "verse_number": "५-७२-१२", "content_sanskrit": "पश्यतां कुरुमुख्यानां सर्वेषामेव तत्त्वतः।\nदानशीलं मृदुं दान्तं धर्मशीलमनुव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038097, "chapter_id": 1827, "verse_number": "५-७२-१३", "content_sanskrit": "यत्त्वामुपधिना राजन्द्यूते वञ्चितवांस्तदा ।\nन चापत्रपते तेन नृशंसः स्वेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038098, "chapter_id": 1827, "verse_number": "५-७२-१४", "content_sanskrit": "तथाशीलसमाचरे राजन्मा प्रणयं कृथाः ।\nवध्यास्ते सर्वलोकस्य किं पुनस्तव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038099, "chapter_id": 1827, "verse_number": "५-७२-१५", "content_sanskrit": "वाग्भिस्त्वप्रतिरूपाभिरतुदत्त्वां सहानुजम् ।\nश्लाघमानः प्रहृष्टः सन्भ्रातृभिः सह भाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038100, "chapter_id": 1827, "verse_number": "५-७२-१६", "content_sanskrit": "एतावत्पाण्डवानां हि नास्ति किंचिदिह स्वकम् ।\nनामधेयं च गोत्रं च तदप्येषां न शिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038101, "chapter_id": 1827, "verse_number": "५-७२-१७", "content_sanskrit": "कालेन महता चैषां भविष्यति पराभवः ।\nप्रकृतिं ते भजिष्यन्ति नष्टप्रकृतयो मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038102, "chapter_id": 1827, "verse_number": "५-७२-१८", "content_sanskrit": "दुःशासनेन पापेन तदा द्यूते प्रवर्तिते ।\nअनाथवत्तदा देवी द्रौपदी सुदुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038103, "chapter_id": 1827, "verse_number": "५-७२-१९", "content_sanskrit": "आकृष्य केशे रुदती सभायां राजसंसदि ।\nभीष्मद्रोणप्रमुखतो गौरिति व्याहृता मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038104, "chapter_id": 1827, "verse_number": "५-७२-२०", "content_sanskrit": "भवता वारिताः सर्वे भ्रातरो भीमविक्रमाः ।\nधर्मपाशनिबद्धाश्च न किंचित्प्रतिपेदिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038105, "chapter_id": 1827, "verse_number": "५-७२-२१", "content_sanskrit": "एताश्चान्याश्च परुषा वाचः स समुदीरयन् ।\nश्लाघते ज्ञातिमध्ये स्म त्वयि प्रव्रजिते वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038106, "chapter_id": 1827, "verse_number": "५-७२-२२", "content_sanskrit": "ये तत्रासन्समानीतास्ते दृष्ट्वा त्वामनागसम्।\nअश्रुकण्ठा रुदन्तश्च सभायामासते सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038107, "chapter_id": 1827, "verse_number": "५-७२-२३", "content_sanskrit": "न चैनमभ्यनन्दंस्ते राजानो ब्राह्मणैः सह।\nसर्वे दुर्योधनं तत्र निन्दन्ति स्म सभासदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038108, "chapter_id": 1827, "verse_number": "५-७२-२४", "content_sanskrit": "कुलीनस्य च या निन्दा वधो वाऽमित्रकर्शन ।\nमहागुणो वधो राजन्नु तु निन्दा कुजीविका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038109, "chapter_id": 1827, "verse_number": "५-७२-२५", "content_sanskrit": "तदैव निहतो राजन्यदैव निरपत्रपः।\nनिन्दितश्च महाराज पृथिव्यां सर्वराजभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038110, "chapter_id": 1827, "verse_number": "५-७२-२६", "content_sanskrit": "ईषत्करो वधस्तस्य यस्य चारित्रमीदृशम् ।\nप्रस्कुन्देन प्रतिस्तब्धश्छिन्नमूल इव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038111, "chapter_id": 1827, "verse_number": "५-७२-२७", "content_sanskrit": "वध्यः सर्प इवानार्यः सर्वलोकस्य दुर्मतिः ।\nजह्येन त्वममित्रघ्न मा राजन्विचिकित्सिथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038112, "chapter_id": 1827, "verse_number": "५-७२-२८", "content_sanskrit": "सर्वथा त्वत्क्षमं चैतद्रोचते च ममानघ।\nयत्त्वं पितरि भीष्मे च प्रणिपातं समाचरेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038113, "chapter_id": 1827, "verse_number": "५-७२-२९", "content_sanskrit": "अहं तु सर्वलोकस्य गत्वा छेत्स्यामि संशयम्।\nयेषामस्ति द्विधाभावो राजन्दुर्योधनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2038114, "chapter_id": 1827, "verse_number": "५-७२-३०", "content_sanskrit": "मध्ये राज्ञामहं तत्र प्रातिपौरुषिकान्गुणान् ।\nतव सङ्कीर्तयिष्यामि ये च तस्य व्यतिक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2038115, "chapter_id": 1827, "verse_number": "५-७२-३१", "content_sanskrit": "ब्रुवतस्तत्र मे वाक्यं धर्मार्थसहितं हितम्।\nनिशम्य पार्थिवाः सर्वे नानाजनपदेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2038116, "chapter_id": 1827, "verse_number": "५-७२-३२", "content_sanskrit": "त्वयि संप्रतिपत्स्यन्ते धर्मात्मा सत्यवागिति ।\nतस्मिंश्चाधिगमिष्यन्ति यथा लोभादवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2038117, "chapter_id": 1827, "verse_number": "५-७२-३३", "content_sanskrit": "गर्हयिष्यामि चैवैनं पौरजानपदेष्वपि ।\nवृद्धबालानुपादाय चातुर्वर्ण्ये समागते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2038118, "chapter_id": 1827, "verse_number": "५-७२-३४", "content_sanskrit": "शमं वै याचमानस्त्वं नाधर्मं तत्र लप्स्यसे ।\nकुरून्विगर्हयिष्यन्ति धृतराष्ट्रं च पार्थिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2038119, "chapter_id": 1827, "verse_number": "५-७२-३५", "content_sanskrit": "तस्मिंल्लोकपरित्यक्ते किं कार्यमवशिष्यते।\nहते दुर्योधने राजन्यदन्यत्क्रियतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2038120, "chapter_id": 1827, "verse_number": "५-७२-३६", "content_sanskrit": "यात्वा चाहं कुरून्सर्वान्युष्मदर्थमहापयन् ।\nयतिष्ये प्रशमं कर्तुं लक्षयिष्ये च चेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2038121, "chapter_id": 1827, "verse_number": "५-७२-३७", "content_sanskrit": "कौरवाणां प्रवृत्तिं च गत्वा युद्धाधिकारिकाम् ।\nनिशम्य विनिवर्तिष्ये जयाय तव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2038122, "chapter_id": 1827, "verse_number": "५-७२-३८", "content_sanskrit": "सर्वथा युद्धमेवाहमाशंसापि परैः सह ।\nनिमित्तानि हि सर्वाणि तथा प्रादुर्भवन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2038123, "chapter_id": 1827, "verse_number": "५-७२-३९", "content_sanskrit": "मृगाः शकुन्ताश्च वदन्ति घोरं\nहस्त्यश्वमुख्येषु निशामुखेषु ।\nघोराणि रूपाणि तथैव चाग्नि-\nर्वर्णान्बहून्पुष्यति घोररूपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2038124, "chapter_id": 1827, "verse_number": "५-७२-४०", "content_sanskrit": "मनुष्यलोकक्षयकृत्सुघोरो\nनो चेदनुप्राप्त इहान्तकः स्यात्।\nशस्त्राणि यन्त्रं कवचान्रथांश्च\nनागान्हयांश्च प्रतिपादयित्वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2038125, "chapter_id": 1827, "verse_number": "५-७२-४१", "content_sanskrit": "योधाश्च सर्वे कृतनिश्चयास्ते\nभवन्तु हस्त्यश्वरथेषु यत्ताः।\nसाङ्ग्रामिकं ते यदुपार्जनीयं\nसर्वं समग्रं कुरु तन्नरेन्द्र ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2038126, "chapter_id": 1827, "verse_number": "५-७२-४२", "content_sanskrit": "दुर्योधनो न ह्यलमद्य दातुं\nजीवंस्तवैतन्नृपते कथंचित्।\nयत्ते पुरस्तादभवत्समृद्धं\nद्यूते हृतं पाण्डवमुख्य राज्यम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2038127, "chapter_id": 1827, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि द्विसप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]