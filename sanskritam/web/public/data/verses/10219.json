[{"id": 6000219000, "chapter_id": 10219, "verse_number": null, "content_sanskrit": "अथ त्रयोविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000219001, "chapter_id": 10219, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.001.m4a", "display_order": 2}, {"id": 6000219002, "chapter_id": 10219, "verse_number": "१०-२३-१", "content_sanskrit": "इन्द्रस्तदात्मनः पूजां विज्ञाय विहतां नृप।\nगोपेभ्यः कृष्णनाथेभ्यो नन्दादिभ्यश्चुकोप ह॥ १०/२३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.002.m4a", "display_order": 3, "topics": [{"text": "क्रुद्धेनेन्द्रेण गोकुलनाशनार्थं सांवर्तकमेघैर्वर्षणम्", "range": "१–११"}]}, {"id": 6000219003, "chapter_id": 10219, "verse_number": "१०-२३-२", "content_sanskrit": "गणं सांवर्तकं नाम मेघानां चान्तकारिणाम्।\nइन्द्रः प्राचोदयत् क्रुद्धो वाक्यं चाहेशमन्युना॥ १०/२३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.003.m4a", "display_order": 4}, {"id": 6000219004, "chapter_id": 10219, "verse_number": "१०-२३-३", "content_sanskrit": "अहो श्रीमदमाहात्म्यं गोपानां काननौकसाम्।\nकृष्णं मर्त्यमुपाश्रित्य ये चक्रुर्देवहेलनम्॥ १०/२३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.004.m4a", "display_order": 5}, {"id": 6000219005, "chapter_id": 10219, "verse_number": "१०-२३-४", "content_sanskrit": "यथाऽदृढैः कर्ममयैः कुप्लवैर्ज्ञानमानिनः।\nविद्यामान्वीक्षिकीं हित्वा तितीर्षन्ति भवार्णवम्॥ १०/२३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.005.m4a", "display_order": 6}, {"id": 6000219006, "chapter_id": 10219, "verse_number": "१०-२३-५", "content_sanskrit": "वाचालं मानिनं मत्तमज्ञं पण्डितमानिनम्।\nकृष्णं मर्त्यमुपाश्रित्य गोपा मे चक्रुरप्रियम्॥ १०/२३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.006.m4a", "display_order": 7}, {"id": 6000219007, "chapter_id": 10219, "verse_number": "१०-२३-६", "content_sanskrit": "एषां श्रियाऽवलिप्तानां कृष्णेनाप्यायितात्मनाम्।\nधुनुत श्रीमदस्तम्भं पशून् नयत सङ्क्षयम्॥ १०/२३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.007.m4a", "display_order": 8}, {"id": 6000219008, "chapter_id": 10219, "verse_number": "१०-२३-७", "content_sanskrit": "अहं चैरावतं नागमारुह्यानुव्रजे व्रजम्।\nमरुद्गणैर्महावेगैर्नन्दगोष्ठजिघांसया॥ १०/२३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.008.m4a", "display_order": 9}, {"id": 6000219009, "chapter_id": 10219, "verse_number": "१०-२३-८", "content_sanskrit": "इत्थं मघवताऽऽज्ञप्ता मेघा निर्मुक्तबन्धनाः।\nनन्दगोकुलमासारैः पीडयामासुरोजसा॥ १०/२३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.009.m4a", "display_order": 10}, {"id": 6000219010, "chapter_id": 10219, "verse_number": "१०-२३-९", "content_sanskrit": "विद्योतमाना विद्युद्भिर्नदन्तः स्तनयित्नुभिः।\nतीव्रैर्मरुद्गणैर्नुन्ना ववृषुर्जलशर्कराः॥ १०/२३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.010.m4a", "display_order": 11}, {"id": 6000219011, "chapter_id": 10219, "verse_number": "१०-२३-१०", "content_sanskrit": "स्थाणुस्थूला वर्षधारा मुञ्चत्स्वभ्रेष्वभीक्ष्णशः।\nजलौघैः प्लाव्यमाना भूर्नादृश्यत नतोन्नतम्॥ १०/२३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.011.m4a", "display_order": 12}, {"id": 6000219012, "chapter_id": 10219, "verse_number": "१०-२३-११", "content_sanskrit": "अत्यासारातिवातेन पशवो जातवेपनाः।\nगोपा गोप्यश्च शीतार्ता गोविन्दं शरणं ययुः॥ १०/२३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.012.m4a", "display_order": 13}, {"id": 6000219013, "chapter_id": 10219, "verse_number": "१०-२३-१२", "content_sanskrit": "शिरः सुतांश्च कायेन प्रच्छाद्यासारपीडिताः।\nवेपमाना भगवतः पादमूलमुपाययुः॥ १०/२३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.013.m4a", "display_order": 14, "topics": [{"text": "भगवता गोवर्धनाद्रिं करे धृत्वा व्रजवासिनस्तदधः प्रवेश्य वातवर्षभयाद्रक्षणम्", "range": "१२–३३"}]}, {"id": 6000219014, "chapter_id": 10219, "verse_number": "१०-२३-१३", "content_sanskrit": "कृष्ण कृष्ण महाभाग त्वन्नाथं गोकुलं प्रभो।\nत्रातुमर्हसि देवान्नः कुपिताद् भक्तवत्सल॥ १०/२३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.014.m4a", "display_order": 15}, {"id": 6000219015, "chapter_id": 10219, "verse_number": "१०-२३-१४", "content_sanskrit": "शीतवर्षातिवातेन हन्यमानमचेतनम्।\nनिरीक्ष्य भगवान् मेने कुपितेन्द्रकृतं हरिः॥ १०/२३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.015.m4a", "display_order": 16}, {"id": 6000219016, "chapter_id": 10219, "verse_number": "१०-२३-१५", "content_sanskrit": "अपर्तावुल्बणं वर्षमतिवातं शिलामयम्।\nस्वयागे विहतेऽस्माभिरिन्द्रो नाशाय वर्षति॥ १०/२३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.016.m4a", "display_order": 17}, {"id": 6000219017, "chapter_id": 10219, "verse_number": "१०-२३-१६", "content_sanskrit": "तत्र प्रतिविधिं सम्यगात्मयोगेन साधये।\nलोकेशमानिनो मौढ्याद् हरिष्ये श्रीमदं तमः॥ १०/२३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.017.m4a", "display_order": 18}, {"id": 6000219018, "chapter_id": 10219, "verse_number": "१०-२३-१७", "content_sanskrit": "न हि मद्भावयुक्तानां सुराणामीशविस्मयः।\nमत्तः सतां मानभङ्गः प्रशमायोपपद्यते॥ १०/२३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.018.m4a", "display_order": 19}, {"id": 6000219019, "chapter_id": 10219, "verse_number": "१०-२३-१८", "content_sanskrit": "तस्मान्मच्छरणं गोष्ठं मन्नाथं मत्परिग्रहम्।\nगोपाये स्वात्मयोगेन सोऽयं मे व्रत आहितः॥ १०/२३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.019.m4a", "display_order": 20}, {"id": 6000219020, "chapter_id": 10219, "verse_number": "१०-२३-१९", "content_sanskrit": "इत्युक्त्वैकेन हस्तेन कृत्वा गोवर्धनाचलम्।\nदधार लीलया कृष्णश्छत्राकमिव बालकः॥ १०/२३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.020.m4a", "display_order": 21}, {"id": 6000219021, "chapter_id": 10219, "verse_number": "१०-२३-२०", "content_sanskrit": "अथाह भगवान् गोपान् हेऽम्ब तात व्रजौकसः।\nयथोपजोषं विशत गिरिगर्तं सगोधनाः॥ १०/२३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.021.m4a", "display_order": 22}, {"id": 6000219022, "chapter_id": 10219, "verse_number": "१०-२३-२१", "content_sanskrit": "न त्रास इह वः कार्यो मद्धस्ताद्रिनिपातनात्।\nवातवर्षभयं चालं तत्त्राणं विहितं हि वः॥ १०/२३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.022.m4a", "display_order": 23}, {"id": 6000219023, "chapter_id": 10219, "verse_number": "१०-२३-२२", "content_sanskrit": "तथा निर्विविशुर्गर्तं कृष्णाश्वासितमानसाः।\nयथावकाशं सधनाः सप्रजाः सोपजीवनाः॥ १०/२३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.023.m4a", "display_order": 24}, {"id": 6000219024, "chapter_id": 10219, "verse_number": "१०-२३-२३", "content_sanskrit": "क्षुत्तृड्व्यथां सुखापेक्षां हित्वा तैर्व्रजवासिभिः।\nवीक्ष्यमाणो दधाराद्रिं सप्ताहं नाचलत् पदात्॥ १०/२३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.024.m4a", "display_order": 25}, {"id": 6000219025, "chapter_id": 10219, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.025.m4a", "display_order": 26}, {"id": 6000219026, "chapter_id": 10219, "verse_number": "१०-२३-२४", "content_sanskrit": "कृष्णयोगानुभावं तं निशाम्येन्द्रोऽतिविस्मितः।\nनिस्स्तम्भो भ्रष्टसङ्कल्पः स्वान् मेघान् सन्न्यवारयत्॥ १०/२३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.026.m4a", "display_order": 27}, {"id": 6000219027, "chapter_id": 10219, "verse_number": "१०-२३-२५", "content_sanskrit": "खं व्यभ्रमुदितादित्यं वातवर्षं च दारुणम्।\nनिशम्योपरतं गोपान् गोवर्धनधरोऽब्रवीत्॥ १०/२३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.027.m4a", "display_order": 28}, {"id": 6000219028, "chapter_id": 10219, "verse_number": "१०-२३-२६", "content_sanskrit": "निर्यात त्यजत त्रासं गोपाः सस्‍त्रीधनार्भकाः।\nउपारतं वातवर्षं व्युदप्रायाश्च निम्नगाः॥ १०/२३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.028.m4a", "display_order": 29}, {"id": 6000219029, "chapter_id": 10219, "verse_number": "१०-२३-२७", "content_sanskrit": "ततस्ते निर्ययुर्गोपाः स्वं स्वमादाय गोधनम्।\nशकटाटोपकरणं स्‍त्रीबालस्थविराः शनैः॥ १०/२३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.029.m4a", "display_order": 30}, {"id": 6000219030, "chapter_id": 10219, "verse_number": "१०-२३-२८", "content_sanskrit": "भगवानपि तं शैलं स्वस्थाने पूर्ववत् प्रभुः।\nपश्यतां सर्वभूतानां स्थापयामास लीलया॥ १०/२३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.030.m4a", "display_order": 31}, {"id": 6000219031, "chapter_id": 10219, "verse_number": "१०-२३-२९", "content_sanskrit": "तं प्रेमवेगान्निभृता व्रजौकसो यथा समीयुः परिरम्भणादिभिः।\nगोप्यश्च सस्नेहमपूजयन् मुदा दध्यक्षताद्भिर्युयुजुस्तथाऽऽशिषः॥ १०/२३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.031.m4a", "display_order": 32}, {"id": 6000219032, "chapter_id": 10219, "verse_number": "१०-२३-३०", "content_sanskrit": "यशोदा रोहिणी नन्दो रामश्च बलिनां वरः।\nकृष्णमालिङ्ग्य युयुजुराशिषः स्नेहकातराः॥ १०/२३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.032.m4a", "display_order": 33}, {"id": 6000219033, "chapter_id": 10219, "verse_number": "१०-२३-३१", "content_sanskrit": "दिवि देवगणाः सर्वेसिद्धगन्धर्वचारणाः।\nतुष्टुवुर्मुमुचुस्तुष्टाः पुष्पवर्षाणि भारत॥ १०/२३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.033.m4a", "display_order": 34}, {"id": 6000219034, "chapter_id": 10219, "verse_number": "१०-२३-३२", "content_sanskrit": "शङ्खदुन्दुभयो नेदुर्दिवि देवप्रचोदिताः।\nजगुर्गन्धर्वपतयस्तुम्बुरुप्रमुखा नृप॥ १०/२३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.034.m4a", "display_order": 35}, {"id": 6000219035, "chapter_id": 10219, "verse_number": "१०-२३-३३", "content_sanskrit": "ततोऽनुरक्तैः पशुपैः परिश्रितो राजन् स गोष्ठं सबलोऽविशद् हरिः।\nतथाविधान्यस्य कृतानि गोपिका गायन्त्य ईयुर्मुदिता हृदिस्पृशः॥ १०/२३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_023/BhP_10.023.035.m4a", "display_order": 36}, {"id": 6000219036, "chapter_id": 10219, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे त्रयोविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]