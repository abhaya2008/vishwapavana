[{"id": 2072756, "chapter_id": 2536, "verse_number": "१२-४१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072757, "chapter_id": 2536, "verse_number": "१२-४१-१", "content_sanskrit": "ततो युधिष्ठिरो राजा ज्ञातीनां ये हता युधि।\nश्राद्धानि कारयामास तेषां पृथगुदारधीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072758, "chapter_id": 2536, "verse_number": "१२-४१-२", "content_sanskrit": "धृतराष्ट्रो ददौ राजा पुत्राणामौर्ध्वदेहिकम्।\nसर्वकामगुणोपेतमन्नं गाश्च धनानि च।\nरत्नानि च विचित्राणि महार्हाणि महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072759, "chapter_id": 2536, "verse_number": "१२-४१-३", "content_sanskrit": "युधिष्ठिरस्तु द्रोणस्य कर्णस्य च महात्मनः।\nधृष्टद्युम्नाभिमन्युभ्यां हेडिम्बस्य च रक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072760, "chapter_id": 2536, "verse_number": "१२-४१-४", "content_sanskrit": "विराटप्रभृतीनां च सुहृदामुपकारिणाम्।\nद्रुपदद्रौपदेयानां द्रौपद्या सहितो ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072761, "chapter_id": 2536, "verse_number": "१२-४१-५", "content_sanskrit": "ब्राह्मणानां सहस्राणि पृथगेकैकमुद्दिशन्।\nधनै रत्नैश्च गोभिश्च वस्त्रैश्च समतर्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072762, "chapter_id": 2536, "verse_number": "१२-४१-६", "content_sanskrit": "ये चान्ये पृथिवीपाला येषां नास्ति सुहृज्जनः।\nउद्दिश्योद्दिश्य तेषां च चक्रे राजौर्ध्वदेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072763, "chapter_id": 2536, "verse_number": "१२-४१-७", "content_sanskrit": "सभाः प्रपाश्च विविधास्तटाकानि च पाण्डवः।\nसुहृदां कारयामास सर्वेषामौर्ध्वदेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072764, "chapter_id": 2536, "verse_number": "१२-४१-८", "content_sanskrit": "स तेषामनृणो भूत्वा गत्वा लोकेष्ववाच्यताम्।\nकृतकृत्योऽभवद्राजा प्रजा धर्मेण पालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072765, "chapter_id": 2536, "verse_number": "१२-४१-९", "content_sanskrit": "धृतराष्ट्रं यथापूर्वं गान्धारीं विदुरं तथा।\nसर्वांश्च कौरवान्मान्यान्भृत्यांश्च समपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072766, "chapter_id": 2536, "verse_number": "१२-४१-१०", "content_sanskrit": "याश्च तत्र स्त्रियः काश्चिद्धतवीरा हतात्मजाः॥\nसर्वास्ताः कौरवो राजा संपूज्यापालायद्धृणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072767, "chapter_id": 2536, "verse_number": "१२-४१-११", "content_sanskrit": "दीनान्धकृपणानां च गृहाच्छादनभोजनैः।\nआनृशंस्यपरो राजा चकारानुग्रहं प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072768, "chapter_id": 2536, "verse_number": "१२-४१-१२", "content_sanskrit": "स विजित्य महीं कृत्स्नामानृण्यं प्राप्य वैरिषु।\nनिःसपत्नः सुखी राजा विजहार युधिष्ठिरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072769, "chapter_id": 2536, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकचत्वारिंशोऽध्यायः॥ ४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]