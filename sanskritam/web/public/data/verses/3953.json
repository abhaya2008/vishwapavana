[{"id": 2136162, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "रामेण सुग्रीवेण सख्यकरणपूर्वकं वालिहननम् । रावणेनाशोकवने सीतानिवेशनपूर्वकं तद्वशीकरणाय राक्षसीनां नियोजनम् । तत्र त्रिजटया रामरावणयोरिष्टानिष्ट- सूचकस्वदृष्टस्वाप्नप्रकारकथनेन सीतायाः परिसान्त्वनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136163, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136164, "chapter_id": 3953, "verse_number": "१", "content_sanskrit": "ततोऽविदूरे नळिनीं प्रभूतकमलोत्पलाम् ।\nसीताहरणदुःखार्तः पम्पां रामः समासदत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136165, "chapter_id": 3953, "verse_number": "२", "content_sanskrit": "मारुतेन सुशीतेन सुखेनामृतगन्धिना ।\nसेव्यमानो वने तस्मिन् जगाम मनसा प्रियाम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136166, "chapter_id": 3953, "verse_number": "३", "content_sanskrit": "विललाप स राजेन्द्रस्तत्र कान्तामनुस्मरन् ।\nकामबाणाभिसन्तप्तः सौमित्रिस्तमथाब्रवीत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136167, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "लक्ष्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136168, "chapter_id": 3953, "verse_number": "४", "content_sanskrit": "न त्वामेवंविधो भावः स्प्रष्टुमर्हति मानद ।\nआत्मवन्तमिव व्याधिः पुरुषं वृद्धशीलिनम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136169, "chapter_id": 3953, "verse_number": "५", "content_sanskrit": "प्रवृत्तिरुपलब्धा ते वैदेह्या रावणस्य च ।\nतां त्वं पुरुषकारेण बुद्ध्या चैवोपपादय \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136170, "chapter_id": 3953, "verse_number": "६", "content_sanskrit": "अभिगच्छाव सुग्रीवं शैलस्थं हरिपुङ्गवम् ।\nमयि शिष्ये च भृत्ये च सहाये च समाश्वस \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136171, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136172, "chapter_id": 3953, "verse_number": "७", "content_sanskrit": "एवं बहुविधैर्वाक्यैर्लक्ष्मणेन स राघवः ।\nउक्तः प्रकृतिमापेदे कार्ये चानन्तरोऽभवत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136173, "chapter_id": 3953, "verse_number": "८", "content_sanskrit": "निषेव्य वारि पम्पायास्तर्पयित्वा पितॄनपि ।\nप्रतस्थतुरुभौ वीरौ भ्रातरौ रामलक्ष्मणौ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136174, "chapter_id": 3953, "verse_number": "९", "content_sanskrit": "तावृष्यमूकमभ्येत्य बहुमूलफलद्रुमम् ।\nगिर्यग्रे वानरान् पञ्च वीरौ ददृशतुस्तदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136175, "chapter_id": 3953, "verse_number": "१०", "content_sanskrit": "सुग्रीवः प्रेषयामास सचिवं वानरं तयोः ।\nबुद्धिमन्तं हनूमन्तं हिमवन्तमिव स्थितम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136176, "chapter_id": 3953, "verse_number": "११", "content_sanskrit": "तेन सम्भाष्य पूर्वं तौ सुग्रीवमभिजग्मतुः ।\nसख्यं वानरराजेन चक्रे रामस्तदा नृप \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136177, "chapter_id": 3953, "verse_number": "१२", "content_sanskrit": "ततः सीतां हृतां श्रुत्वा सुग्रीवो वालिना कृतम् ।\nदुःखमाख्यातवान् सर्वं रामायामिततेजसे \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136178, "chapter_id": 3953, "verse_number": "१३", "content_sanskrit": "तद्वासो दर्शयामासुस्तस्य कार्ये निवेदिते ।\nवानराणां तु यत् सीता ह्रियमाणा व्यपासृजत् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136179, "chapter_id": 3953, "verse_number": "१४", "content_sanskrit": "तत्प्रत्ययकरं लब्ध्वा सुग्रीवं प्लवगाधिपम् ।\nपृथिव्यां वानरैश्वर्ये स्वयं रामोऽभ्यषेचयत् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136180, "chapter_id": 3953, "verse_number": "१५", "content_sanskrit": "प्रतिजज्ञे च काकुत्स्थः समरे वालिनो वधम् ।\nसुग्रीवश्चापि वैदेह्याः पुनरानयनं नृप \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136181, "chapter_id": 3953, "verse_number": "१६", "content_sanskrit": "इत्युक्त्वा समयं कृत्वा विश्वास्य च परस्परम् ।\nअभ्येत्य सर्वे किष्किन्धां तस्थुर्युद्धाभिकाङ्क्षिणः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136182, "chapter_id": 3953, "verse_number": "१७", "content_sanskrit": "सुग्रीवः प्राप्य किष्किन्धां ननादौघनिभस्वनः ।\nनास्य तन्ममृषे वाली तारा तं प्रत्यषेधयत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136183, "chapter_id": 3953, "verse_number": "१८", "content_sanskrit": "यथा नदति सुग्रीवो बलवानेष वानरः ।\nमन्ये चाश्रयवान् प्राप्तो न त्वं निष्क्रान्तुमर्हसि \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136184, "chapter_id": 3953, "verse_number": "१९", "content_sanskrit": "हेममाली ततो वाली तारां ताराधिपाननाम् ।\nप्रोवाच वचनं वाग्मी तां वानरपतिः पतिः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136185, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "वाली", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136186, "chapter_id": 3953, "verse_number": "२०", "content_sanskrit": "सर्वभूतरुतज्ञा त्वं पश्य बुद्ध्या समन्विता ।\nकेन चाश्रयवान् प्राप्तो ममैष भ्रातृगन्धिकः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136187, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136188, "chapter_id": 3953, "verse_number": "२१", "content_sanskrit": "चिन्तयित्वा मुहूर्तं तु तारा ताराधिपप्रभा ।\nपतिमित्यब्रवीत् प्राज्ञा शृणु सर्वं कपीश्वर \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136189, "chapter_id": 3953, "verse_number": "२२", "content_sanskrit": "हृतदारो महासत्त्वो रामो दशरथात्मजः।\nतुल्यारिमित्रतां प्राप्तः सुग्रीवेण धनुर्धरः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136190, "chapter_id": 3953, "verse_number": "२३", "content_sanskrit": "भ्राता चास्य महाबाहुः सौमित्रिरपराजितः ।\nलक्ष्मणो नाम मेधावी स्थितः कार्यार्थसिद्धये \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136191, "chapter_id": 3953, "verse_number": "२४", "content_sanskrit": "मैन्दश्च द्विविदश्चापि हनूमांश्चानिलात्मजः।\nजाम्बवानृक्षराजश्च सुग्रीवसचिवाः स्थिताः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136192, "chapter_id": 3953, "verse_number": "२५", "content_sanskrit": "सर्व एते महात्मानो बुद्धिमन्तो महाबलाः ।\nअलं तव विनाशाय रामवीर्यबलाश्रयात् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136193, "chapter_id": 3953, "verse_number": "२६", "content_sanskrit": "तस्यास्तदाक्षिप्य वचो हितमुक्तं कपीश्वरः ।\nपर्यशङ्कत तामीर्षुः सुग्रीवगतमानसाम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136194, "chapter_id": 3953, "verse_number": "२७", "content_sanskrit": "तारां परुषमुक्त्वा तु निर्जगाम गुहामुखात् ।\nस्थितं माल्यवतोऽभ्याशे सुग्रीवं सोऽभ्यभाषत \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136195, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "वाली", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136196, "chapter_id": 3953, "verse_number": "२८", "content_sanskrit": "असकृत्त्वं मया पूर्वं निर्जितो जीवितप्रियः ।\nमुक्तो ज्ञातिरिति ज्ञात्वा का त्वरा मरणे पुनः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136197, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136198, "chapter_id": 3953, "verse_number": "२९", "content_sanskrit": "इत्युक्तः प्राह सुग्रीवो भ्रातरं हेतुमद्वचः ।\nप्राप्तकालममित्रघ्नो रामं सम्बोधयन्निव \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136199, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "सुग्रीवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136200, "chapter_id": 3953, "verse_number": "३०", "content_sanskrit": "इत्युक्तस्तु जहासोच्चैः सुग्रीवो भ्रातरं प्रति ।\nहेतुमद्वचनं भ्रात्रे प्रोवाचेदं महात्मने \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136201, "chapter_id": 3953, "verse_number": "३१", "content_sanskrit": "हृतराज्यस्य मे राजन् हृतदारस्य च त्वया ।\nकिं मे जीवितसामर्थ्यमिति विद्धि समागतम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136202, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136203, "chapter_id": 3953, "verse_number": "३२", "content_sanskrit": "एवमुक्त्वा बहुविधं ततस्तौ संनिपेततुः ।\nसमरे वालिसुग्रीवौ शालतालशिलायुधौ \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136204, "chapter_id": 3953, "verse_number": "३३", "content_sanskrit": "उभौ जघ्नतुरन्योन्यमुभौ भूमौ निपेततुः ।\nउभौ ववल्गतुश्चित्रं मुष्टिभिश्च निजघ्नतुः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136205, "chapter_id": 3953, "verse_number": "३४", "content_sanskrit": "उभौ रुधिरसंसिक्तौ नखदन्तपरिक्षतौ ।\nशुशुभाते तदा वीरौ पुष्पिताविव किंशुकौ \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136206, "chapter_id": 3953, "verse_number": "३५", "content_sanskrit": "न विशेषस्तयोर्युद्धे यदा कश्चन दृश्यते ।\nसुग्रीवस्य तदा मालां हनुमान् कण्ठ आसजत् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136207, "chapter_id": 3953, "verse_number": "३६", "content_sanskrit": "स मालया तदा वीरः शुशुभे कण्ठसक्तया ।\nश्रीमानिव महाशैलो मलयो मेघमालया \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136208, "chapter_id": 3953, "verse_number": "३७", "content_sanskrit": "कृतचिह्नं तु सुग्रीवं रामो दृष्ट्वा महाधनुः ।\nविचकर्ष धनुः श्रेष्ठं वालिमुद्दिश्य लक्ष्यवत् \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136209, "chapter_id": 3953, "verse_number": "३८", "content_sanskrit": "विस्फारस्तस्य धनुषो वज्रघोष इवाबभौ ।\nवितत्रास तदा वाली शरेणाभिहतो हृदि \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136210, "chapter_id": 3953, "verse_number": "३९", "content_sanskrit": "स भिन्नहृदयो वाली वक्राच्छोणितमुद्वमन् ।\nददर्शावस्थितं रामं ततः सौमित्रिणा सह \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136211, "chapter_id": 3953, "verse_number": "४०", "content_sanskrit": "गर्हयित्वा स काकुत्स्थं पपात भुवि मूर्च्छितः ।\nतारा ददर्श तं भूमौ तारापतिसमौजसम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2136212, "chapter_id": 3953, "verse_number": "४१", "content_sanskrit": "हते वालिनि सुग्रीवः किष्किन्धां प्रत्यपद्यत ।\nतां च तारापतिमुखीं तारां निपतितेश्वराम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2136213, "chapter_id": 3953, "verse_number": "४२", "content_sanskrit": "रामस्तु चतुरो मासान् पृष्ठे माल्यवतः शुभे ।\nनिवासमकरोद् धीमान् सुग्रीवेणाभ्युपस्थितः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2136214, "chapter_id": 3953, "verse_number": "४३", "content_sanskrit": "रावणोऽपि पुरीं गत्वा लङ्कां कामबलात् कृतः ।\nसीतां निवेशयामास भवने नन्दनोपमे \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2136215, "chapter_id": 3953, "verse_number": "४४", "content_sanskrit": "अशोकवनिकाभ्याशे तापसाश्रमसंनिभे ।\nभर्तृस्मरणतन्वङ्गी तापसीवेषधारिणी \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2136216, "chapter_id": 3953, "verse_number": "४५", "content_sanskrit": "उपवासतपःशीला तत्रास पृथुलेक्षणा ।\nउवास दुःखवसतिं फलमूलकृताशना \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2136217, "chapter_id": 3953, "verse_number": "४६", "content_sanskrit": "दिदेश राक्षसीस्तत्र रक्षणे राक्षसाधिपः ।\nप्रासासिशूलपरशुमुद्गरालातधारिणीः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2136218, "chapter_id": 3953, "verse_number": "४७", "content_sanskrit": "द्व्यक्षीं त्र्यक्षीं ललाटाक्षीं दीर्घजिह्वामजिह्वकाम् ।\nत्रिस्तनीमेकपादां च त्रिजटामेकलोचनाम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2136219, "chapter_id": 3953, "verse_number": "४८", "content_sanskrit": "एताश्चान्याश्च दीप्ताक्ष्यः करभोत्करमूर्द्धजाः ।\nपरिवार्यासते सीतां दिवारात्रमतन्द्रिताः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2136220, "chapter_id": 3953, "verse_number": "४९", "content_sanskrit": "तास्तु तामायतापाङ्गीं पिशाच्यो दारुणस्वराः ।\nतर्जयन्ति सदा रौद्राः परुषव्यञ्जनस्वराः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2136221, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "राक्षस्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2136222, "chapter_id": 3953, "verse_number": "५०", "content_sanskrit": "खादाम पाटयामैनां तिलशः प्रविभज्य ताम् ।\nयेयं भर्तारमस्माकमवमन्येह जीवति \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2136223, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2136224, "chapter_id": 3953, "verse_number": "५१", "content_sanskrit": "इत्येवं परिभर्त्सन्तीस्त्रास्यमाना पुनः पुनः ।\nभर्तृशोकसमाविष्टा निःश्वस्येदमुवाच ताः \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2136225, "chapter_id": 3953, "verse_number": "५२", "content_sanskrit": "आर्याः खादत मां शीघ्रं न मे लोभोऽस्ति जीविते ।\nविना तं पुण्डरीकाक्षं नीलकुञ्चितमूर्धजम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2136226, "chapter_id": 3953, "verse_number": "५३", "content_sanskrit": "अप्येवाहं निराहारा जीवितप्रियवर्जिता ।\nशोषयिष्यामि गात्राणि व्याली तालगता यथा \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2136227, "chapter_id": 3953, "verse_number": "५४", "content_sanskrit": "न त्वन्यमभिगच्छेयं पुमांसं राघवादृते ।\nइति जानीत सत्यं मे क्रियतां यदनन्तरम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2136228, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2136229, "chapter_id": 3953, "verse_number": "५५", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा राक्षस्यस्ताः खरस्वनाः ।\nआख्यातुं राक्षसेन्द्राय जग्मुस्तत्सर्वमादितः(दृताः)॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2136230, "chapter_id": 3953, "verse_number": "५६", "content_sanskrit": "गतासु तासु सर्वासु त्रिजटा नाम राक्षसी ।\nसान्त्वयामास वैदेहीं धर्मज्ञा प्रियवादिनी \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2136231, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "त्रिजटा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2136232, "chapter_id": 3953, "verse_number": "५७", "content_sanskrit": "सीते वक्ष्यामि ते किञ्चिद् विश्वासं कुरु मे सखि ।\nभयं त्वं त्यज वामोरु शृणु चेदं वचो मम \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2136233, "chapter_id": 3953, "verse_number": "५८", "content_sanskrit": "अविन्ध्यो नाम मेधावी वृद्धो राक्षसपुङ्गवः ।\nस रामस्य हितान्वेषी त्वदर्थे हि स मावदत् ।\nसीता मद्वचनाद् वाच्या समाश्वास्य प्रसाद्य च \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2136234, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "अवन्ध्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2136235, "chapter_id": 3953, "verse_number": "५९", "content_sanskrit": "भर्ता ते कुशली रामो लक्ष्मणानुगतो बली \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2136236, "chapter_id": 3953, "verse_number": "६०", "content_sanskrit": "सख्यं वानरराजेन शक्रप्रतिमतेजसा ।\nकृतवान् राघवः श्रीमांस्त्वदर्थे च समुद्यतः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2136237, "chapter_id": 3953, "verse_number": "६१", "content_sanskrit": "मा च तेऽस्तु भयं भीरु रावणाल्लोकगर्हितात् ।\nनलकूबरशापेन रक्षिता ह्यसि नन्दिनि \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2136238, "chapter_id": 3953, "verse_number": "६२", "content_sanskrit": "शप्तो ह्येष पुरा पापो वधूं रम्भां परामृशन् ।\nन शक्नोत्यवशां नारीमुपैतुमजितेन्द्रियः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2136239, "chapter_id": 3953, "verse_number": "६३", "content_sanskrit": "क्षिप्रमेष्यति ते भर्ता सुग्रीवेणाभिरक्षितः ।\nसौमित्रिसहितो धीमांस्त्वां चेतो मोक्षयिष्यति \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2136240, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "त्रिजटा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2136241, "chapter_id": 3953, "verse_number": "६४", "content_sanskrit": "स्वप्ना हि सुमहाघोरा दृष्टा मेऽनिष्टदर्शनाः ।\nविनाशायास्य दुर्बुद्धेः पौलस्त्यकुलघातिनः \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2136242, "chapter_id": 3953, "verse_number": "६५", "content_sanskrit": "दारुणो ह्येष दुष्टात्मा क्षुद्रकर्मा निशाचरः ।\nस्वभावाच्छीलदोषेण सर्वेषां भयवर्धनः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2136243, "chapter_id": 3953, "verse_number": "६६", "content_sanskrit": "स्पर्धते सर्वदेवैर्यः कालोपहतचेतनः ।\nमया विनाशलिङ्गानि स्वप्ने दृष्टानि तस्य वै \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2136244, "chapter_id": 3953, "verse_number": "६७", "content_sanskrit": "तैलाभिषिक्तो विकचो मज्जन् पङ्के दशाननः ।\nअसकृत् खरयुक्ते तु रथे नृत्यन्निव स्थितः \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2136245, "chapter_id": 3953, "verse_number": "६८", "content_sanskrit": "कुम्भकर्णादयश्चेमे नग्नाः पतितमूर्धजाः ।\nगच्छन्ति दक्षिणामाशां रक्तमाल्यानुलेपनाः \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2136246, "chapter_id": 3953, "verse_number": "६९", "content_sanskrit": "श्वेतातपत्रः सोष्णीषः शुक्लमाल्यानुलेपनः ।\nश्वेतपर्वतमारूढ एक एव विभीषणः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2136247, "chapter_id": 3953, "verse_number": "७०", "content_sanskrit": "सचिवाश्चास्य चत्वारः शुक्लमाल्यानुलेपनाः ।\nश्वेतपर्वतमारूढा मोक्ष्यन्तेऽस्मान् महाभयात्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2136248, "chapter_id": 3953, "verse_number": "७१", "content_sanskrit": "रामस्यास्त्रेण पृथिवी परिक्षिप्ता ससागरा ।\nयशसा पृथिवीं कृत्स्नां पूरयिष्यति ते पतिः \t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2136249, "chapter_id": 3953, "verse_number": "७२", "content_sanskrit": "अस्थिसञ्चयमारूढो भुञ्जानो मधुपायसम् ।\nलक्ष्मणश्च मया दृष्टो दिधक्षुः सर्वतो दिशम् \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2136250, "chapter_id": 3953, "verse_number": "७३", "content_sanskrit": "रुदती रुधिरार्द्राङ्गी व्याघ्रेण परिरक्षिता ।\nअसकृत्त्वं मया दृष्टा गच्छन्ती दिशमुत्तराम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2136251, "chapter_id": 3953, "verse_number": "७४", "content_sanskrit": "हर्षमेष्यसि वैदेहि क्षिप्रं भर्त्रा समन्विता ।\nराघवेण सह भ्रात्रा सीते त्वमचिरादिव\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2136252, "chapter_id": 3953, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2136253, "chapter_id": 3953, "verse_number": "७५", "content_sanskrit": "इत्येतन्मृगशावाक्षी तच्छ्रुत्वा त्रिजटावचः ।\nबभूवाशावती बाला पुनर्भर्तृसमागमे \t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2136254, "chapter_id": 3953, "verse_number": "७६", "content_sanskrit": "यावदभ्यागता रौद्राः पिशाच्यस्ताः सुदारुणाः ।\nददृशुस्तां त्रिजटया सहासीनां यथा पुरा \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2136255, "chapter_id": 3953, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकोनसप्तत्यधिकद्विशततमोऽध्यायः ॥२६९॥\nरामोपाख्यानपर्वणि त्रिजटाकृतसीतासान्त्वने नवमोऽध्यायः ॥९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]