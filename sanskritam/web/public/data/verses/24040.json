[{"id": 7004040000, "chapter_id": 24040, "verse_number": "३-३-११-१", "content_sanskrit": "सूत उवाच ।\nपिंगला नाम या वेश्या मया पूर्वमुदाहृता ।\nशिवभक्तार्चनात्पुण्यात्त्यक्त्वा पूर्वकलेवरम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004040001, "chapter_id": 24040, "verse_number": "३-३-११-२", "content_sanskrit": "चन्द्रांगदस्य सा भूयः सीमंतिन्यामजायत ।\nरूपौदार्यगुणोपेता नाम्ना वै कीर्तिमालिनी॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004040002, "chapter_id": 24040, "verse_number": "३-३-११-३", "content_sanskrit": "भद्रायुरपि तत्रैव राजपुत्रो वणिक्पतेः ।\nववृधे सदने भानुः शुचाविव महातपाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004040003, "chapter_id": 24040, "verse_number": "३-३-११-४", "content_sanskrit": "तस्यापि वैश्यनाथस्य कुमारस्त्वेक उत्तमः ।\nस नाम्ना सुनयः प्रोक्तो राजसूनोः सखाऽभवत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004040004, "chapter_id": 24040, "verse_number": "३-३-११-५", "content_sanskrit": "तावुभौ परमस्निग्धौ राजवैश्यकुमारकौ ।\nचित्रक्रीडावुदारांगौ रत्नाभरणमंडितौ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004040005, "chapter_id": 24040, "verse_number": "३-३-११-६", "content_sanskrit": "तस्य राजकुमारस्य ब्राह्मणैः स वणिक्पतिः ।\nसंस्कारान्कारयामास स्वपुत्रस्यापि विस्तरात्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004040006, "chapter_id": 24040, "verse_number": "३-३-११-७", "content_sanskrit": "काले कृतोपनयनौ गुरुशुश्रूषणे रतौ ।\nचक्रतुः सर्वविद्यानां संग्रहं विनयान्वितौ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004040007, "chapter_id": 24040, "verse_number": "३-३-११-८", "content_sanskrit": "अथ राजकुमारस्य प्राप्ते षोडशहायने ।\nस एव ऋषभो योगी तस्य वेश्मन्युपाययौ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004040008, "chapter_id": 24040, "verse_number": "३-३-११-९", "content_sanskrit": "सा राज्ञी स कुमारश्च शिवयोगिनमागतम् ।\nमुहुर्मुहुः प्रणम्योभौ पूजयामासतुर्मुदा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004040009, "chapter_id": 24040, "verse_number": "३-३-११-१०", "content_sanskrit": "ताभ्यां च पूजितः सोऽथ योगीशो हृष्टमानसः ।\nतं राजपुत्रमुद्दिश्य बभाषे करुणार्द्रधीः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004040010, "chapter_id": 24040, "verse_number": "३-३-११-११", "content_sanskrit": "शिवयोग्युवाच ।\nकच्चित्ते कुशलं तात त्वन्मातुश्चाप्यनामयम् ।\nकच्चित्त्वं सर्वविद्यानामकार्षीश्च प्रतिग्रहम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004040011, "chapter_id": 24040, "verse_number": "३-३-११-१२", "content_sanskrit": "कच्चिद्गुरूणां सततं शुश्रूषातत्परो भवान् ।\nकच्चित्स्मरसि मां तात तव प्राणप्रदं गुरुम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004040012, "chapter_id": 24040, "verse_number": "३-३-११-१३", "content_sanskrit": "एवं वदति योगीशे राज्ञी सा विनयान्विता ।\nस्वपुत्रं पादयोस्तस्य निपात्यैनमभाषत॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004040013, "chapter_id": 24040, "verse_number": "३-३-११-१४", "content_sanskrit": "एष पुत्रस्तव गुरो त्वमस्य प्राणदः पिता ।\nएष शिष्यस्तु संग्राह्यो भवता करुणात्मना॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004040014, "chapter_id": 24040, "verse_number": "३-३-११-१५", "content_sanskrit": "अतो बन्धुभिरुत्सृष्टमनाथं परिपालय ।\nअस्मै सम्यक्सतां मार्गमुपदेष्टुं त्वमर्हसि॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004040015, "chapter_id": 24040, "verse_number": "३-३-११-१६", "content_sanskrit": "इति प्रसादितो राज्ञ्या शिवयोगी महामतिः ।\nतस्मै राजकुमाराय सन्मार्गमुपदिष्टवान्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004040016, "chapter_id": 24040, "verse_number": "३-३-११-१७", "content_sanskrit": "ऋषभ उवाच ।\nश्रुतिस्मृतिपुराणेषु प्रोक्तो धर्मः सनातनः ।\nवर्णाश्रमानुरूपेण निषेव्यः सर्वदा जनैः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004040017, "chapter_id": 24040, "verse_number": "३-३-११-१८", "content_sanskrit": "भज वत्स सतां मार्गं सदेव चरितं चर ।\nन देवाज्ञां विलंघेथा मा कार्षीर्देवहेलनम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004040018, "chapter_id": 24040, "verse_number": "३-३-११-१९", "content_sanskrit": "गोदेवगुरुविप्रेषु भक्तिमान्भव सर्वदा ।\nचांडालमपि संप्राप्तं सदा संभावयातिथिम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004040019, "chapter_id": 24040, "verse_number": "३-३-११-२०", "content_sanskrit": "सत्यं न त्यज सर्वत्र प्राप्तेऽपि प्राणसंकटे ।\nगोब्राह्मणानां रक्षार्थमसत्यं त्वं वद क्वचित्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004040020, "chapter_id": 24040, "verse_number": "३-३-११-२१", "content_sanskrit": "परस्वेषु परस्त्रीषु देवब्राह्मण वस्तुषु ।\nतृष्णां त्यज महाबाहो दुर्लभेष्वपि वस्तुषु॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004040021, "chapter_id": 24040, "verse_number": "३-३-११-२२", "content_sanskrit": "सत्कथायां सदाचारे सद्व्रते च सदागमे ।\nधर्मादिसंग्रहे नित्यं तृष्णां कुरु महामते॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004040022, "chapter_id": 24040, "verse_number": "३-३-११-२३", "content_sanskrit": "स्नाने जपे च होमे च स्वाध्याये पितृतर्पणे ।\nगोदेवातिथिपूजासु निरालस्यो भवानघ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004040023, "chapter_id": 24040, "verse_number": "३-३-११-२४", "content_sanskrit": "क्रोधं द्वेषं भयं शाठ्यं पैशुन्य मसदाग्रहम् ।\nकौटिल्यं दंभमुद्वेगं यत्नेन परिवर्जय॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004040024, "chapter_id": 24040, "verse_number": "३-३-११-२५", "content_sanskrit": "क्षात्रधर्मरतोऽपि त्वं वृथा हिंसां परित्यज ।\nशुष्कवैरं वृथालापं परनिदां च वर्जय॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004040025, "chapter_id": 24040, "verse_number": "३-३-११-२६", "content_sanskrit": "मृगया द्यूतपानेषु स्त्रीषु स्त्रीविजितेषु च ।\nअत्याहारमतिक्रोधमतिनिद्रामतिश्रमम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004040026, "chapter_id": 24040, "verse_number": "३-३-११-२७", "content_sanskrit": "अत्यालापमतिक्रीडां सर्वदा परिवर्जय॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004040027, "chapter_id": 24040, "verse_number": "३-३-११-२८", "content_sanskrit": "अतिविद्यामतिश्रद्धामतिपुण्यमतिस्मृतिम् ।\nअत्युत्साहमतिख्यातिमतिधैर्यं च साधय॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004040028, "chapter_id": 24040, "verse_number": "३-३-११-२९", "content_sanskrit": "सकामो निजदारेषु सक्रोधो निज शत्रुषु ।\nसलोभः पुण्यनिचये साभ्यसूयो ह्यधर्मिषु॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004040029, "chapter_id": 24040, "verse_number": "३-३-११-३०", "content_sanskrit": "सद्वेषो भव पाखण्डे सरागः सज्जनेषु च ।\nदुर्बोधो भव दुर्मंत्रे बधिरः पिशुनोक्तिषु॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004040030, "chapter_id": 24040, "verse_number": "३-३-११-३१", "content_sanskrit": "धूर्त्तं चंडं शठं क्रूरं कितवं चपलं खलम् ।\nपतितं नास्तिकं जिह्मं दूरतः परिवर्जय॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004040031, "chapter_id": 24040, "verse_number": "३-३-११-३२", "content_sanskrit": "आत्मप्रशंसा मा कार्षीः परिज्ञातेंगितो भव ।\nधने सर्वकुटुंबे च नात्यासक्तः सदा भव॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004040032, "chapter_id": 24040, "verse_number": "३-३-११-३३", "content_sanskrit": "पत्न्याः पतिव्रतायाश्च जनन्याः श्वशुरस्य च ।\nसतां गुरोश्च वचने विश्वासं कुरु सर्वदा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004040033, "chapter_id": 24040, "verse_number": "३-३-११-३४", "content_sanskrit": "आत्मरक्षापरो नित्यमप्रमत्तो दृढव्रतः ।\nविश्वासं नैव कुर्वीथाः स्वभृत्येष्वपि कुत्र चित्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004040034, "chapter_id": 24040, "verse_number": "३-३-११-३५", "content_sanskrit": "विश्वस्तं मा वधीः कंचिदपि चोरं महामते ।\nअपापेषु न शंकेथाः सत्यान्न चलितो भव॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004040035, "chapter_id": 24040, "verse_number": "३-३-११-३६", "content_sanskrit": "अनाथं कृपणं वृद्धं स्त्रियं बालं निरागसम् ।\nपरिरक्ष धनैः प्राणैर्बुद्ध्या शक्त्या बलेन च॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004040036, "chapter_id": 24040, "verse_number": "३-३-११-३७", "content_sanskrit": "अपि शत्रुं वधस्यार्हं मा वधीः शरणागतम् ।\nअप्यपात्रं सुपात्रं वा नीचो वापि महत्तमः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004040037, "chapter_id": 24040, "verse_number": "३-३-११-३८", "content_sanskrit": "यो वा को वापि याचेत तस्मै देहि शिरोपि च ।\nअपि यत्नेन महता कीर्तिमेव सदार्जय॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004040038, "chapter_id": 24040, "verse_number": "३-३-११-३९", "content_sanskrit": "राज्ञां च विदुषां चैव कीर्तिरेव हि भूषणम् ।\nसत्कीर्तिप्रभवा लक्ष्मीः पुण्यं सत्कीर्तिसंभवम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004040039, "chapter_id": 24040, "verse_number": "३-३-११-४०", "content_sanskrit": "सत्कीर्त्या राजते लोकश्चंद्रश्चंद्रिकया न्यथा ।\nगजाश्वहेमनिचयं रत्नराशिं नगोपमम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004040040, "chapter_id": 24040, "verse_number": "३-३-११-४१", "content_sanskrit": "अकीर्त्योपहतं सर्वं तृणवन्मुंच सत्वरम् ।\nमातुः कोपं पितुः कोपं गुरोः कोपं धनव्य यम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004040041, "chapter_id": 24040, "verse_number": "३-३-११-४२", "content_sanskrit": "पुत्राणामपराधं च ब्राह्मणानां क्षमस्व भोः ।\nयथा द्विजप्रसादः स्यात्तथा तेषां हितं चर॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004040042, "chapter_id": 24040, "verse_number": "३-३-११-४३", "content_sanskrit": "राजानं संकटे मग्नमुद्धरेयुर्द्विजोत्तमा ।\nआयुर्यशो बलं सौख्यं धनं पुण्यं प्रजोन्नतिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004040043, "chapter_id": 24040, "verse_number": "३-३-११-४४", "content_sanskrit": "कर्मणा येन जायेत तत्सेव्यं भवता सदा ।\nदेशं कालं च शक्तिं च कार्यं चा कार्यमेव च॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004040044, "chapter_id": 24040, "verse_number": "३-३-११-४५", "content_sanskrit": "सम्यग्विचार्य यत्नेन कुरु कार्यं च सर्वदा ।\nन कुर्याः कस्यचिद्बाधां परबाधां निवारय॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004040045, "chapter_id": 24040, "verse_number": "३-३-११-४६", "content_sanskrit": "चोरान्दुष्टांश्च बाधेथाः सुनीत्या शक्तिमत्तया ।\nस्नाने जपे च होमे च दैवे पित्र्ये च कर्मणि॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004040046, "chapter_id": 24040, "verse_number": "३-३-११-४७", "content_sanskrit": "अत्वरो भव निद्रायां भोजने भव सत्वरः ।\nदाक्षिण्ययुक्तमशठं सत्यं जनमनोहरम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004040047, "chapter_id": 24040, "verse_number": "३-३-११-४८", "content_sanskrit": "अल्पाक्षरमनंतार्थं वाक्यं ब्रूहि महामते ।\nअभीतो भव सर्वत्र विपक्षेषु विपत्सु च॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004040048, "chapter_id": 24040, "verse_number": "३-३-११-४९", "content_sanskrit": "भीतो भव ब्रह्मकुले न पापे गुरुशासने ।\nज्ञातिबंधुषु विप्रेषु भार्यासु तनयेषु च॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004040049, "chapter_id": 24040, "verse_number": "३-३-११-५०", "content_sanskrit": "समभावेन वर्तेथास्तथा भोजनपंक्तिषु ।\nसतां हितोपदेशेषु तथा पुण्य कथासु च॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004040050, "chapter_id": 24040, "verse_number": "३-३-११-५१", "content_sanskrit": "विद्यागोष्ठीषु धर्म्यासु क्वचिन्मा भूः पराङ्मुखः ।\nशुचौ पुण्यजलस्यांते प्रख्याते ब्रह्मसंकुले॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004040051, "chapter_id": 24040, "verse_number": "३-३-११-५२", "content_sanskrit": "महादेशे शिवमये वस्तव्यं भवता सदा ।\nकुलटा गणिका यत्र यत्र तिष्ठति कामुकः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004040052, "chapter_id": 24040, "verse_number": "३-३-११-५३", "content_sanskrit": "दुर्देशे नीचसंबाधे कदाचिदपि मा वस ।\nएकमेवाश्रितोपि त्वं शिवं त्रिभुवनेश्वरम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004040053, "chapter_id": 24040, "verse_number": "३-३-११-५४", "content_sanskrit": "सर्वान्देवानुपासीथास्तद्दिनानि च मानयन् ।\nसदा शुचिः सदा दक्षः सदा शांतः सदा स्थिरः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004040054, "chapter_id": 24040, "verse_number": "३-३-११-५५", "content_sanskrit": "सदा विजित षड्वर्गः सदैकांतो भवानघ ।\nविप्रान्वेदविदः शांतान्यतींश्च नियतोज्वलान्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004040055, "chapter_id": 24040, "verse_number": "३-३-११-५६", "content_sanskrit": "युग्मम् ।\nपुण्यवृक्षान्पुण्यनदीः पुण्यतीर्थं महत्सरः ।\nधेनुं च वृषभं रत्नं युवतीं च पतिव्रताम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004040056, "chapter_id": 24040, "verse_number": "३-३-११-५७", "content_sanskrit": "आत्मनो गृहदेवांश्च सहसैव नमस्कुरु ।\nउत्थाय समये ब्राह्मे स्वाचम्य विमलाशयः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004040057, "chapter_id": 24040, "verse_number": "३-३-११-५८", "content_sanskrit": "नमस्कृत्यात्मगुरुवे ध्यात्वा देवमुमापतिम् ।\nनारायणं च लक्ष्मीशं ब्रह्माणं च विनायकम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004040058, "chapter_id": 24040, "verse_number": "३-३-११-५९", "content_sanskrit": "स्कन्दं कात्यायनीं देवीं महालक्ष्मीं सरस्वतीम् ।\nइन्द्रादीनथ लोकेशान्पुण्यश्लोकानृषीनपि॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004040059, "chapter_id": 24040, "verse_number": "३-३-११-६०", "content_sanskrit": "चिंतयित्वाथ मार्त्तंडमुद्यंतं प्रणमेत्सदा ।\nगंधं पुष्पं च तांबूलं शाकं पक्वफलादिकम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004040060, "chapter_id": 24040, "verse_number": "३-३-११-६१", "content_sanskrit": "शिवाय दत्त्वोपभुंक्ष्व भक्ष्यं भोज्यं प्रियं नवम् ।\nयद्दत्तं यत्कृतं जप्तं यत्स्नातं यद्धुतं स्मृतम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004040061, "chapter_id": 24040, "verse_number": "३-३-११-६२", "content_sanskrit": "यच्च तप्तं तपः सर्वं तच्छिवाय निवेदय ।\nभुंजानश्च पठन्वापि शयानो विहरन्नपि ।\nपश्यञ्छृण्न्ववदन्गृह्णञ्छिवमेवानुचिंतय॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004040062, "chapter_id": 24040, "verse_number": "३-३-११-६३", "content_sanskrit": "रुद्राक्षकंकणलसत्करदंडयुग्मो मालांतरालधृतभस्म सितत्रिपुंडूः ।\nपंचाक्षरं परिपठन्परमंत्रराजं ध्यायन्सदा पशुपतेश्चरणं रमेथाः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004040063, "chapter_id": 24040, "verse_number": "३-३-११-६४", "content_sanskrit": "इति संक्षेपतो वत्स कथितो धर्मसंग्रहः ।\nअन्येषु च पुराणेषु विस्तरेण प्रकीर्तितः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004040064, "chapter_id": 24040, "verse_number": "३-३-११-६५", "content_sanskrit": "अथापरं सर्वपुराणगुह्यं निःशेषपापौघहरं पवित्रम् ।\nजयप्रदं सर्वविपद्विमोचनं वक्ष्यामि शैवं कवचं हिताय ते॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]