[{"id": 2066282, "chapter_id": 2399, "verse_number": "९-१७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066283, "chapter_id": 2399, "verse_number": "९-१७-१", "content_sanskrit": "शल्येऽथ निहते राजन्मद्रराजपदानुगाः।\nरथाः सप्तशता वीरा दुद्रुवुर्महतो बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066284, "chapter_id": 2399, "verse_number": "९-१७-२", "content_sanskrit": "दुर्योधनस्तु द्विरदमारुह्याचलसन्निभम्।\nछत्रेण ध्रियमाणेन वीज्यमानश्च चामरैः।\nन गन्तव्यं न गन्तव्यमिति मद्रानवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066285, "chapter_id": 2399, "verse_number": "९-१७-३", "content_sanskrit": "दुर्योधनेन ते वीरा वार्यमाणाः पुनः पुनः।\nयुधिष्ठिरं जिघांसन्तः पाण्डूनां प्राविशन्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066286, "chapter_id": 2399, "verse_number": "९-१७-४", "content_sanskrit": "ते तु शूरा महाराज कृतचित्ताश्च योधने।\nधनुःशब्दं महत्कृत्वा सहायुध्यन्त पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066287, "chapter_id": 2399, "verse_number": "९-१७-५", "content_sanskrit": "श्रुत्वा च निहतं शल्यं धर्मपुत्रं च पीडितम्।\nमद्रराजप्रिये युक्तैर्मद्रकाणां महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066288, "chapter_id": 2399, "verse_number": "९-१७-६", "content_sanskrit": "आजगाम ततः पार्थो गाण्डीवं विक्षिपन्धनुः।\nपूरयन्रथघोषेण दिशः सर्वा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066289, "chapter_id": 2399, "verse_number": "९-१७-७", "content_sanskrit": "ततोऽर्जुनश्च भीमश्च माद्रीपुत्रौ च पाण्डवौ।\nसात्यकिश्च नरव्याघ्रो द्रौपदेयाश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066290, "chapter_id": 2399, "verse_number": "९-१७-८", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च पाञ्चालाः सह सोमकैः।\nयुधिष्ठिरं परीप्सन्तः समन्तात्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066291, "chapter_id": 2399, "verse_number": "९-१७-९", "content_sanskrit": "ते समन्तात्परिवृताः पाण्डवैः पुरुषर्षभैः।\nक्षोभयन्ति स्म तां सेनां मकराः सागरं यथा।\nवृक्षानिव महावाताः कम्पयन्ति स्म तावकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066292, "chapter_id": 2399, "verse_number": "९-१७-१०", "content_sanskrit": "पुरोवातेन गङ्गेव--क्षोभ्यमाणा महानदी।\nअक्षोभ्यत तदा राजन्पाण्डूनां ध्वजिनी ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066293, "chapter_id": 2399, "verse_number": "९-१७-११", "content_sanskrit": "प्रस्कन्द्य सेनां महतीं महात्मानो महारथाः।\nबहवश्चुक्रुशुस्तत्र क्व स राजा युधिष्ठिरः।\nभ्रातरो वाऽस्य ते शूरा दृश्यन्ते नेह केचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066294, "chapter_id": 2399, "verse_number": "९-१७-१२", "content_sanskrit": "धृष्टद्युम्नोऽथ शैनेयो द्रौपदेयाश्च सर्वशः।\nपाञ्चालाश्च महावीर्याः शिखण्डी च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066295, "chapter_id": 2399, "verse_number": "९-१७-१३", "content_sanskrit": "एवं तान्वादिनः शूरान्द्रौपदेया महारथाः।\nअभ्यघ्नन्युयुधानश्च मद्रराजपदानुगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066296, "chapter_id": 2399, "verse_number": "९-१७-१४", "content_sanskrit": "चक्रैर्विमथितैः केचित्केचिच्छिन्नैर्महाध्वजैः।\nसम्प्रदृश्यन्त समरे तावका निहताः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066297, "chapter_id": 2399, "verse_number": "९-१७-१५", "content_sanskrit": "आलोक्य पाण्डवान्युद्धे योधा राजन्समन्ततः।\nवार्यमाणा ययुर्वेगात्पुत्रेण तव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066298, "chapter_id": 2399, "verse_number": "९-१७-१६", "content_sanskrit": "दुर्योधनश्च तान्वीरान्वारयामास सान्त्वयन्।\nन चास्य शासनं केचित्तत्र चक्रुर्महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066299, "chapter_id": 2399, "verse_number": "९-१७-१७", "content_sanskrit": "ततो गान्धारराजस्य पुत्रः शकुनिरब्रवीत्।\nदुर्योधनं महाराज वचनं वचनक्षमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066300, "chapter_id": 2399, "verse_number": "९-१७-१८", "content_sanskrit": "किं नः सम्प्रेक्षमाणानां मद्राणां हन्यते बलम्।\nन युक्तमेतत्समरे त्वयि तिष्ठति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066301, "chapter_id": 2399, "verse_number": "९-१७-१९", "content_sanskrit": "सहितैर्नाम योद्धव्यमित्येष समयः कृतः।\nअथ कस्मात्स्मरन्नेव घ्नतो मर्षयसे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066302, "chapter_id": 2399, "verse_number": "९-१७-२०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066303, "chapter_id": 2399, "verse_number": "९-१७-२०", "content_sanskrit": "वार्यमाणा मया पूर्वं नैते चक्रुर्वचो मम।\nएते विनिहताः सर्वे प्रस्कन्नाः पाण्डुवाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066304, "chapter_id": 2399, "verse_number": "९-१७-२१x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066305, "chapter_id": 2399, "verse_number": "९-१७-२१", "content_sanskrit": "न भर्तुः शासनं वीरा रणे कुर्वन्त्यमर्षिताः।\nअलं क्रोद्वुमथैतेषां नायं काल उपेक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066306, "chapter_id": 2399, "verse_number": "९-१७-२२", "content_sanskrit": "यामः सर्वेऽत्र सम्भूय सवाजिरथकुञ्जराः।\nपरित्रातुं महेष्वासान्मद्रराजपदानुगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066307, "chapter_id": 2399, "verse_number": "९-१७-२३", "content_sanskrit": "अन्योन्यं परिरक्षामो यत्नेन महता नृप।\nएवं सर्वेऽनुसञ्चिन्त्य प्रययुर्यत्र सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066308, "chapter_id": 2399, "verse_number": "९-१७-२४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066309, "chapter_id": 2399, "verse_number": "९-१७-२४", "content_sanskrit": "एवमुक्तस्तदा राजा बलेन महता वृतः।\nप्रययौ सिंहनादेन कम्पयन्निव मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066310, "chapter_id": 2399, "verse_number": "९-१७-२५", "content_sanskrit": "हत विध्यत गृह्णीत प्रहरध्वं निकृन्तत।\nइत्यासीत्तुमुलः शब्दस्तव सैन्यस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066311, "chapter_id": 2399, "verse_number": "९-१७-२६", "content_sanskrit": "पाण्डवास्तु रणे दृष्ट्वा मद्रराजपदानुगान्।\nसहितानभ्यवर्तन्तं गुल्ममास्थाय मध्यमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066312, "chapter_id": 2399, "verse_number": "९-१७-२७", "content_sanskrit": "ते मुहूर्ताद्रणे वीरा हस्ताहस्ति विशाम्पते।\nनिहताः प्रत्यदृश्यन्त मद्रराजपदानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066313, "chapter_id": 2399, "verse_number": "९-१७-२८", "content_sanskrit": "ततो नः सम्प्रयातानां हता मद्रास्तरस्विनः।\nहृष्टाः किलकिलाशब्दमकुर्वन्सहिताः परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066314, "chapter_id": 2399, "verse_number": "९-१७-२९", "content_sanskrit": "अथोत्थितानि रुण्डानि समदृश्यन्त सर्वशः।\nपपात महती चोल्का मध्येनादित्यमण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066315, "chapter_id": 2399, "verse_number": "९-१७-३०", "content_sanskrit": "रथैर्भग्नयुगाक्षैश्च निहतैश्च महारथैः।\nअश्वैर्निपातितैश्चैव सञ्छन्नाऽभूद्वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066316, "chapter_id": 2399, "verse_number": "९-१७-३१", "content_sanskrit": "वातायमानैस्तुरगैर्युगासक्तैस्ततस्ततः।\nअकृष्यन्त महाराज योधास्तत्र रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066317, "chapter_id": 2399, "verse_number": "९-१७-३२", "content_sanskrit": "भग्नचक्रान्रथान्केचिदहरंस्तुरगा रणे।\nरथार्धं केचिदादाय दिशो दश विबभ्रमुः।\nतत्रतत्र व्यदृश्यन्त योक्त्रैः श्लिष्टाः स्म वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066318, "chapter_id": 2399, "verse_number": "९-१७-३३", "content_sanskrit": "रथिनः पतमानाश्च दृश्यन्ते स्म नरोत्तमाः।\nगगनात्प्रच्युताः सिद्धाः पुण्यानामिव सङ्क्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066319, "chapter_id": 2399, "verse_number": "९-१७-३४", "content_sanskrit": "निहतेषु च शूरेषु मद्रराजानुगेषु वै।\nअस्मानापततश्चापि दृष्ट्वा पार्था महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066320, "chapter_id": 2399, "verse_number": "९-१७-३५", "content_sanskrit": "अभ्यवर्तन्त वेगेन जयगृद्धाः प्रहारिणः।\nबाणशब्दरवान्कृत्वा विमिश्राञ्शङ्खनिःस्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066321, "chapter_id": 2399, "verse_number": "९-१७-३६", "content_sanskrit": "अस्मांस्तु पुनरासाद्य लब्धलक्षाः प्रहारिणः।\nशरासनानि धुन्वानाः सिंहनादान्प्रचुक्रुशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066322, "chapter_id": 2399, "verse_number": "९-१७-३७", "content_sanskrit": "ततो हतमभिप्रेक्ष्य मद्रराजबलं महत्।\nमद्रराजं च समरे दृष्ट्वा शूरं निपातितम्।\nदुर्योधनबलं सर्वं पुनरासीत्पराङ्मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066323, "chapter_id": 2399, "verse_number": "९-१७-३८", "content_sanskrit": "वध्यमानं महाराज पाण्डवैर्जितकाशिभिः।\nदिशो भेजेऽथ सम्भ्रान्तं त्रासितं दृढधन्विभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066324, "chapter_id": 2399, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यवपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे सप्तदशोऽध्यायः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]