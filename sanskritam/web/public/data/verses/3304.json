[{"id": 2106241, "chapter_id": 3304, "verse_number": "१६-३३-१", "content_sanskrit": "व्यास उवाच।\nभद्रे द्रक्ष्यसि गान्धारि पुत्रान्भ्रातॄन्स्वकान्गणान्।\nवधूश्च पतिभिः सार्धं निशि सुप्तोस्थिता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2106242, "chapter_id": 3304, "verse_number": "१६-३३-२", "content_sanskrit": "कर्णं द्रक्ष्यति कुन्ती च सौभद्रं चापि यादवी।\nद्रौपदी पञ्चपुत्रांश्च पितॄन्भ्रातॄंस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2106243, "chapter_id": 3304, "verse_number": "१६-३३-३", "content_sanskrit": "पूर्वमेवैष हृदये व्यवसायोऽभकवन्मम।\nयदाऽस्मि चोदितो राज्ञा भवत्या पृथयैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2106244, "chapter_id": 3304, "verse_number": "१६-३३-४", "content_sanskrit": "न ते शोच्या महात्मानः सर्व एव नरर्षभाः।\nक्षत्रधर्मपराः सन्तस्तथा हि निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2106245, "chapter_id": 3304, "verse_number": "१६-३३-५", "content_sanskrit": "भवितव्यमवश्यं तत्सुरकार्यमनिन्दिते।\nअवतेरुस्ततः सर्वे देवा भागैर्महीतलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2106246, "chapter_id": 3304, "verse_number": "१६-३३-६", "content_sanskrit": "गन्धर्वाप्सरसश्चैव पिशाचा गुह्यराक्षसाः।\nतथा पुण्यजनाश्चैव सिद्धा देवर्षयोपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2106247, "chapter_id": 3304, "verse_number": "१६-३३-७", "content_sanskrit": "देवाश्च दानवाश्चैव तथा देवर्षयोऽमलाः।\nते एते निधनं प्राप्ताः कुरुक्षेत्रे रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2106248, "chapter_id": 3304, "verse_number": "१६-३३-८", "content_sanskrit": "गन्धर्वराजो यो धीमान्धृतराष्ट्र इति श्रुतः।\nस एव मानुषे लोके धृतराष्ट्रः पतिस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2106249, "chapter_id": 3304, "verse_number": "१६-३३-९", "content_sanskrit": "पाण्डुं मरुद्गणाद्विद्धि विशिष्टतममच्युतम्।\nधर्मस्यांशोऽभवत्क्षत्ता राजा चैव युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2106250, "chapter_id": 3304, "verse_number": "१६-३३-१०", "content_sanskrit": "कलिं दुर्योधनं विद्धि शकुनिं द्वापरं नृपम्।\nदुःशासनादीन्विद्धि त्वं राक्षसान्शुभदर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2106251, "chapter_id": 3304, "verse_number": "१६-३३-११", "content_sanskrit": "मरुद्गणाद्भीमसेनं बलवन्तमरिंदमम्।\nविद्धिं त्वं तु नरमृषिमिमं पार्थं धनंजयम्।\nनारायणं हृषीकेशमश्विनौ यमजौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2106252, "chapter_id": 3304, "verse_number": "१६-३३-१२", "content_sanskrit": "द्विधा कृत्वाऽऽत्मनो देहमादित्यं तपतां वरम्।\nलोकांश्च तापयानं वै कर्णं विद्धि पृथासुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2106253, "chapter_id": 3304, "verse_number": "१६-३३-१३", "content_sanskrit": "यः स वैरार्थमुद्भूतः संघर्षजननस्कतथा।\nतं कर्णं विद्धि कल्याणि भास्करं शुभदर्शने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2106254, "chapter_id": 3304, "verse_number": "१६-३३-१४", "content_sanskrit": "यश्च पाण्डवदायादो हतः षङ्मिर्महारथैः।\nस सोम इह सौभद्रो योगादेवाभवद्द्विधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2106255, "chapter_id": 3304, "verse_number": "१६-३३-१५", "content_sanskrit": "द्रौपद्या सह संभूतं धृष्टद्युम्नं च पावकात्।\nअग्रेर्भागं शुभं विद्धि राक्षसं तु शिखण्डिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2106256, "chapter_id": 3304, "verse_number": "१६-३३-१६", "content_sanskrit": "द्रोणं बृहस्पतेर्भागं विद्धि द्रौणिं च रुद्रजम्।\nगाङ्गेयो वसुवीर्येण देवो मानुषतां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2106257, "chapter_id": 3304, "verse_number": "१६-३३-१७", "content_sanskrit": "एवमेते महाप्रज्ञे देवा मानुष्यमेत्य हि।\nततः पुनर्गताः स्वर्गं कृते कर्मणि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2106258, "chapter_id": 3304, "verse_number": "१६-३३-१८", "content_sanskrit": "यच्च वै हृदि सर्वेषां दुःखमेतच्चिरं स्थितम्।\nतदद्य व्यपनेष्यामि परलोककृताद्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2106259, "chapter_id": 3304, "verse_number": "१६-३३-१९", "content_sanskrit": "सर्वे भवन्तो गच्छन्तु नदीं भागीरथीं प्रति।\nतत्र द्रक्ष्यथ तान्सर्वान्ये हतास्तत्र संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2106260, "chapter_id": 3304, "verse_number": "१६-३३-२०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2106261, "chapter_id": 3304, "verse_number": "१६-३३-२०", "content_sanskrit": "इति व्यासस्य वचनं श्रुत्वा सर्वा जनस्तदा।\nमहता सिंहनादेन गङ्गामभिमुखो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2106262, "chapter_id": 3304, "verse_number": "१६-३३-२१", "content_sanskrit": "धृतराष्ट्रश्च सामात्यः प्रययौ सह पाण्डवैः।\nसहितो मुनिशार्दूलैर्गन्धर्वैश्च समागतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2106263, "chapter_id": 3304, "verse_number": "१६-३३-२२", "content_sanskrit": "ततो गङ्गां समासाद्य क्रमेण स जनार्णवः।\nनिवासमकरोत्सर्वो यथाप्रीति यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2106264, "chapter_id": 3304, "verse_number": "१६-३३-२३", "content_sanskrit": "राजा च पाण्डवैः सार्धमिष्टे देशे सहानुगः।\nनिवासमकरोद्धीमान्सस्त्रीवृद्धपुरःसरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2106265, "chapter_id": 3304, "verse_number": "१६-३३-२४", "content_sanskrit": "जगाम तदहस्चापि तेषां वर्षशतं यथा।\nनिशां प्रतीक्षमाणानां दिदृक्षूणां मृतान्नृपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2106266, "chapter_id": 3304, "verse_number": "१६-३३-२५", "content_sanskrit": "अथ पुण्यं गिरिवरमस्तमभ्यगमद्रविः।\nततः कृताभिषेकास्ते नैशं कर्म समाचरन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2106267, "chapter_id": 3304, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि पुत्रदर्शनपर्वणि त्रयस्त्रिंशोऽध्यायः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]