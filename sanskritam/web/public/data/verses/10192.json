[{"id": 6000192000, "chapter_id": 10192, "verse_number": null, "content_sanskrit": "अथ सप्तदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000192001, "chapter_id": 10192, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.001.m4a", "display_order": 2}, {"id": 6000192002, "chapter_id": 10192, "verse_number": "९-१७-१", "content_sanskrit": "पूरोर्वंशं प्रवक्ष्यामि यत्र जातोऽसि भारत।\nयत्र राजर्षयो वंश्या ब्रह्मवंश्याश्च जज्ञिरे॥ ९/१७/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.002.m4a", "display_order": 3, "topics": [{"text": "पूरोर्वंशकथने दुष्यन्ताच्छकुन्तलायां भरतोत्पत्तिः", "range": "१–२३"}]}, {"id": 6000192003, "chapter_id": 10192, "verse_number": "९-१७-२", "content_sanskrit": "जनमेजयो ह्यभूत् पूरोः प्रचिन्वांस्तत्सुतः स्मृतः।\nप्रवीरोऽथ नमस्युर्वै तस्माच्चारुपदोऽभवत्॥ ९/१७/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.003.m4a", "display_order": 4}, {"id": 6000192004, "chapter_id": 10192, "verse_number": "९-१७-३", "content_sanskrit": "तस्य सुद्युरभूत् पुत्रस्तस्माद् बहुगवस्ततः।\nशंयातिस्तस्य हंयाती रौद्राश्वस्तत्सुतः स्मृतः॥ ९/१७/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.004.m4a", "display_order": 5}, {"id": 6000192005, "chapter_id": 10192, "verse_number": "९-१७-४", "content_sanskrit": "ऋतेयुस्तस्य कक्षेयुः स्थण्डिलेयुः कृतेयुकः।\nजलेयुः सन्तनेयुश्च धर्मसत्यव्रतेयवः॥ ९/१७/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.005.m4a", "display_order": 6}, {"id": 6000192006, "chapter_id": 10192, "verse_number": "९-१७-५", "content_sanskrit": "दशैतेऽप्सरसः पुत्रा वनेयुश्चावमः स्मृतः।\nघृताच्यामिन्द्रियाणीव मुख्यस्य जगदात्मनः॥ ९/१७/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.006.m4a", "display_order": 7}, {"id": 6000192007, "chapter_id": 10192, "verse_number": "९-१७-६", "content_sanskrit": "ऋतेयो रन्तिनारोऽभूत् त्रयस्तस्यात्मजा नृप।\nसुमतिर्ध्रुवोऽप्रतिरथः कण्वोऽप्रतिरथात्मजः॥ ९/१७/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.007.m4a", "display_order": 8}, {"id": 6000192008, "chapter_id": 10192, "verse_number": "९-१७-७", "content_sanskrit": "तस्य मेधातिथिस्तस्मात् प्रस्कण्वाद्या द्विजातयः।\nपुत्रोऽभूत् सुमते रैभ्यो दुष्यन्तस्तत्सुतो मतः॥ ९/१७/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.008.m4a", "display_order": 9}, {"id": 6000192009, "chapter_id": 10192, "verse_number": "९-१७-८", "content_sanskrit": "दुष्यन्तो मृगयां यातः कण्वाश्रमपदं गतः।\nतत्रासीनां स्वप्रभया मण्डयन्तीं रमामिव॥ ९/१७/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.009.m4a", "display_order": 10}, {"id": 6000192010, "chapter_id": 10192, "verse_number": "९-१७-९", "content_sanskrit": "विलोक्य मुमुहे सद्यो देवमायामिव स्‍त्रियम्।\nबभाषे तां वरारोहां भटैः कतिपयैर्युतः॥ ९/१७/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.010.m4a", "display_order": 11}, {"id": 6000192011, "chapter_id": 10192, "verse_number": "९-१७-१०", "content_sanskrit": "तद्दर्शनप्रमुदितः सन्निवृत्तपरिश्रमः।\nपप्रच्छ कामसन्तप्तः प्रहसन् श्लक्ष्णया गिरा॥ ९/१७/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.011.m4a", "display_order": 12}, {"id": 6000192012, "chapter_id": 10192, "verse_number": "९-१७-११", "content_sanskrit": "का त्वं कमलगर्भाभे कस्यासि हृदयङ्गमे।\nकिं वा चिकीर्षितं त्वत्र भवत्या विजने वने॥ ९/१७/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.012.m4a", "display_order": 13}, {"id": 6000192013, "chapter_id": 10192, "verse_number": "९-१७-१२", "content_sanskrit": "व्यक्तं राजन्यतनयां वेद्म्यहं त्वां सुमध्यमे।\nन हि चेतः पौरवाणामधर्मे रमते क्‍वचित्॥ ९/१७/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.013.m4a", "display_order": 14}, {"id": 6000192014, "chapter_id": 10192, "verse_number": null, "content_sanskrit": "शकुन्तलोवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.014.m4a", "display_order": 15}, {"id": 6000192015, "chapter_id": 10192, "verse_number": "९-१७-१३", "content_sanskrit": "विश्वामित्रात्मजैवाहं त्यक्ता मेनकया वने।\nवेदैतद् भगवान् कण्वो वीर किं करवाम ते॥ ९/१७/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.015.m4a", "display_order": 16}, {"id": 6000192016, "chapter_id": 10192, "verse_number": "९-१७-१४", "content_sanskrit": "आस्यतामरविन्दाक्ष गृह्यतामर्हणं च नः।\nभुज्यतां सन्ति नीवारा उष्यतां यदि रोचते॥ ९/१७/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.016.m4a", "display_order": 17}, {"id": 6000192017, "chapter_id": 10192, "verse_number": null, "content_sanskrit": "दुष्यन्त उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.017.m4a", "display_order": 18}, {"id": 6000192018, "chapter_id": 10192, "verse_number": "९-१७-१५", "content_sanskrit": "उपपन्नमिदं सुभ्रु जातायाः कुशिकान्वये।\nस्वयं हि वृणुते राज्ञां कन्यकाः सदृशं वरम्॥ ९/१७/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.018.m4a", "display_order": 19}, {"id": 6000192019, "chapter_id": 10192, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.019.m4a", "display_order": 20}, {"id": 6000192020, "chapter_id": 10192, "verse_number": "९-१७-१६", "content_sanskrit": "ओमित्युक्ते यथाधर्ममुपयेमे शकुन्तलाम्।\nगान्धर्वविधिना राजा देशकालविधानवित्॥ ९/१७/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.020.m4a", "display_order": 21}, {"id": 6000192021, "chapter_id": 10192, "verse_number": "९-१७-१७", "content_sanskrit": "अमोघवीर्यो राजर्षिर्महिष्यां वीर्यमादधे।\nश्वोभूते स्वपुरं यातः कालेनासूत सा सुतम्॥ ९/१७/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.021.m4a", "display_order": 22}, {"id": 6000192022, "chapter_id": 10192, "verse_number": "९-१७-१८", "content_sanskrit": "कण्वः कुमारस्य वने चक्रे समुदिताः क्रियाः।\nबद्‌ध्वा मृगेन्द्रांस्तरसा क्रीडति स्म स बालकः॥ ९/१७/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.022.m4a", "display_order": 23}, {"id": 6000192023, "chapter_id": 10192, "verse_number": "९-१७-१९", "content_sanskrit": "तं दुरत्ययविक्रान्तमादाय प्रमदोत्तमा।\nहरेरंशांशसम्भूतं भर्तुरन्तिकमागमत्॥ ९/१७/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.023.m4a", "display_order": 24}, {"id": 6000192024, "chapter_id": 10192, "verse_number": "९-१७-२०", "content_sanskrit": "यदा न जगृहे राजा भार्यापुत्रावनिन्दितौ।\nशृण्वतां सर्वभूतानां खे वागाहाशरीरिणी॥ ९/१७/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.024.m4a", "display_order": 25}, {"id": 6000192025, "chapter_id": 10192, "verse_number": "९-१७-२१", "content_sanskrit": "माता भस्त्रा पितुः पुत्रो यस्माज्जातः स एव सः।\nभरस्व पुत्रं दौष्यन्तिं माऽवमंस्थाः शकुन्तलाम्॥ ९/१७/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.025.m4a", "display_order": 26}, {"id": 6000192026, "chapter_id": 10192, "verse_number": "९-१७-२२", "content_sanskrit": "रेतोधाः पुत्रं नयति नरदेव यमक्षयम्।\nत्वं चास्य धाता गर्भस्य सत्यमाह शकुन्तला॥ ९/१७/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.026.m4a", "display_order": 27}, {"id": 6000192027, "chapter_id": 10192, "verse_number": "९-१७-२३", "content_sanskrit": "पितर्युपरते सोऽभूच्चक्रवर्ती महायशाः।\nमहिमा गीयते तस्य हरेरंशभुवो भुवि॥ ९/१७/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.027.m4a", "display_order": 28}, {"id": 6000192028, "chapter_id": 10192, "verse_number": "९-१७-२४", "content_sanskrit": "चक्रं दक्षिणहस्तेऽस्य पद्मकोशश्च पादयोः।\nईजे महाभिषेकेण सोऽभिषिक्तोऽधिराट् प्रभुः॥ ९/१७/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.028.m4a", "display_order": 29, "topics": [{"text": "भरतकृतयज्ञदानादीनां वर्णनम्", "range": "२४–३३"}]}, {"id": 6000192029, "chapter_id": 10192, "verse_number": "९-१७-२५", "content_sanskrit": "पञ्चपञ्चाशतैर्मेध्यैर्गङ्गायामनुवाजिभिः।\nदीर्घतमसं पुरोधाय यमुनायामनु प्रभुः॥ ९/१७/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.029.m4a", "display_order": 30}, {"id": 6000192030, "chapter_id": 10192, "verse_number": "९-१७-२६", "content_sanskrit": "अष्टसप्ततिमेध्याश्वान् बबन्ध प्रददे वसु। भरतस्य हि दौःषन्तेरग्निः साचीगुणे चितः।\nसहस्रं बद्वशो यस्मिन् ब्राह्मणा गा विभेजिरे॥ ९/१७/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.030.m4a", "display_order": 31}, {"id": 6000192031, "chapter_id": 10192, "verse_number": "९-१७-२७", "content_sanskrit": "त्रयस्‍त्रिंशच्छतं ह्यश्वान् बद्ध्वा विस्मापयन् नृपान्।\nदौःषन्तिरत्यगान्मायां देवानां पुरुमायया॥ ९/१७/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.031.m4a", "display_order": 32}, {"id": 6000192032, "chapter_id": 10192, "verse_number": "९-१७-२८", "content_sanskrit": "मृगान् शुक्लदतः कृष्णान् हिरण्येन परिष्कृतान्।\nअदात् कर्मणि मष्णारे नियुतानि चतुर्दश॥ ९/१७/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.032.m4a", "display_order": 33}, {"id": 6000192033, "chapter_id": 10192, "verse_number": "९-१७-२९", "content_sanskrit": "भरतस्य महत्कर्म न पूर्वे नापरे नृपाः।\nनोदापुर्नैव प्राप्स्यन्ति बाहुभ्यां त्रिदिवं यथा॥ ९/१७/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.033.m4a", "display_order": 34}, {"id": 6000192034, "chapter_id": 10192, "verse_number": "९-१७-३०", "content_sanskrit": "किरातहूणान् यवनानन्ध्रान् कङ्कान् कषान् शकान्।\nअब्रह्मण्यान् नृपांश्चाहन् म्लेञ्छान् दिग्विजयेऽखिलान्॥ ९/१७/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.034.m4a", "display_order": 35}, {"id": 6000192035, "chapter_id": 10192, "verse_number": "९-१७-३१", "content_sanskrit": "जित्वा पुराऽसुरान् देवा येन स्वौकांसि भेजिरे।\nदेवस्‍त्रियो रसां नीताः पणिभिः पुनराहरत्॥ ९/१७/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.035.m4a", "display_order": 36}, {"id": 6000192036, "chapter_id": 10192, "verse_number": "९-१७-३२", "content_sanskrit": "सर्वान् कामान् दुदुहतुः प्रजानां तस्य रोदसी।\nसमास्‍त्रिनवसाहस्रीर्दिक्षु चक्रमवर्तयत्॥ ९/१७/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.036.m4a", "display_order": 37}, {"id": 6000192037, "chapter_id": 10192, "verse_number": "९-१७-३३", "content_sanskrit": "स सम्राट् लोकपालानामैश्वर्यमधिराट्‌श्रियम्।\nचक्रं चास्खलितं प्राणान् मृषेत्युपरराम ह॥ ९/१७/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.037.m4a", "display_order": 38}, {"id": 6000192038, "chapter_id": 10192, "verse_number": "९-१७-३४", "content_sanskrit": "तस्यासन् नृप वैदर्भ्यः पत्न्यस्तिस्रः सुसंमताः।\nजघ्नुस्त्यागभयात् पुत्रान्नानुरूपा इतीरिते॥ ९/१७/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.038.m4a", "display_order": 39, "topics": [{"text": "अपुत्राय भरताय देवैर्भरद्वाजस्य पुत्रत्वेन दानम्", "range": "३४–३५"}]}, {"id": 6000192039, "chapter_id": 10192, "verse_number": "९-१७-३५", "content_sanskrit": "तस्यैवं वितथे वंशे तदर्थं यजतः सुतम्।\nमरुत्स्तोमेन मरुतो भरद्वाजमुपाददुः॥ ९/१७/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.039.m4a", "display_order": 40}, {"id": 6000192040, "chapter_id": 10192, "verse_number": "९-१७-३६", "content_sanskrit": "अन्तर्वत्न्या भ्रातृपत्न्या मैथुनाय बृहस्पतिः।\nप्रवृत्तो वारितो गर्भं शप्त्वा वीर्यमवासृजत्॥ ९/१७/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.040.m4a", "display_order": 41, "topics": [{"text": "प्रसङ्गात् उचथ्यपत्न्यां ममतायां बृहस्पतेः भरद्वाजोत्पत्तिकथनम्", "range": "३६–३८"}]}, {"id": 6000192041, "chapter_id": 10192, "verse_number": "९-१७-३७", "content_sanskrit": "तं त्यक्तुकामां ममतां भर्तुस्त्यागविशङ्किताम्।\nनामनिर्वचनं तस्य श्‍लोकमेतं जगुः सुराः॥ ९/१७/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.041.m4a", "display_order": 42}, {"id": 6000192042, "chapter_id": 10192, "verse_number": "९-१७-३८", "content_sanskrit": "मूढे भर द्वाजमिमं भरद् वाजं बृहस्पतेः।\nत्राता तु दुःखात् पितरौ भरद्वाजस्ततस्त्वयम्॥ ९/१७/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.042.m4a", "display_order": 43}, {"id": 6000192043, "chapter_id": 10192, "verse_number": "९-१७-३९", "content_sanskrit": "चोद्यमाना सुरैरेवं मत्वा तं देवमात्मजम्।\nव्यसृजन्मरुतोऽबिभ्रन् दत्तोऽयं वितथेऽन्वये॥ ९/१७/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_017/BhP_09.017.043.m4a", "display_order": 44, "topics": [{"text": "तस्य वितथ इति नामाजनि", "range": "३९"}]}, {"id": 6000192044, "chapter_id": 10192, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे सप्तदशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]