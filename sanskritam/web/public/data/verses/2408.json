[{"id": 2066784, "chapter_id": 2408, "verse_number": "९-२६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066785, "chapter_id": 2408, "verse_number": "९-२६-१", "content_sanskrit": "दुर्योधनो महाराज सुदर्शश्चापि ते सुतः।\nहतशेषौ तदा सङ्ख्ये वाजिमध्ये व्यवस्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066786, "chapter_id": 2408, "verse_number": "९-२६-२", "content_sanskrit": "ततो दुर्योधनं दृष्ट्वा वाजिमध्ये व्यवस्थितम्।\nउवाच देवकीपुत्रः कुन्तीपुत्रं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066787, "chapter_id": 2408, "verse_number": "९-२६-३", "content_sanskrit": "शत्रवो हतभूयिष्ठा ज्ञातयः परिपालिताः।\nगृहीत्वा सञ्जयं चासौ निवृत्तः शिनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066788, "chapter_id": 2408, "verse_number": "९-२६-४", "content_sanskrit": "परिश्रान्तश्च नकुलः सहदेवश्च भारत।\nयोधयित्वा रणे पापान्धार्तराष्ट्रान्सहानुगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066789, "chapter_id": 2408, "verse_number": "९-२६-५", "content_sanskrit": "दुर्योधनमतिक्रम्य त्रय एते व्यवस्थिन्ताः।\nकृपश्च कृतवर्मा च द्रौणिश्चैव महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066790, "chapter_id": 2408, "verse_number": "९-२६-६", "content_sanskrit": "असौ तिष्ठति पाञ्चाल्यः श्रिया परमया युतः।\nदुर्योधनबलं हत्वा सह सर्वैः प्रभद्रकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066791, "chapter_id": 2408, "verse_number": "९-२६-७", "content_sanskrit": "असौ दुर्योधनः पार्थ वाजिमध्ये व्यवस्थितः।\nछत्रेण ध्रियामणेन प्रेक्षमाणो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066792, "chapter_id": 2408, "verse_number": "९-२६-८", "content_sanskrit": "प्रतिव्यूह्य बलं सर्वं रणमध्ये व्यवस्थितः।\nएनं हत्वा शितैर्बाणैः कृतकृत्यो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066793, "chapter_id": 2408, "verse_number": "९-२६-९", "content_sanskrit": "गजानीकं हतं दृष्ट्वा त्वां च प्राप्तमरिन्दम।\nयावन्न विद्रवन्त्येते तावज्जहि सुयोधन्सम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066794, "chapter_id": 2408, "verse_number": "९-२६-१०", "content_sanskrit": "यातु कश्चित्तुं पाञ्चाल्यं क्षिप्रमागम्यतामिति।\nपरिश्रान्तबलस्तात नैष मुच्येत किल्बिषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066795, "chapter_id": 2408, "verse_number": "९-२६-११", "content_sanskrit": "हत्वा तव बलं सर्वं सङ्ग्रमे धृतराष्ट्रजः।\nजितान्पाण्डुसुतान्प्रत्वा रूपं धारयते महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066796, "chapter_id": 2408, "verse_number": "९-२६-१२", "content_sanskrit": "निहतं स्वबलं दृष्ट्वा पीडितं चापि पाण्डवैः।\nध्रुवमेष्यति सङ्ग्रमे वधायैवात्मनो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066797, "chapter_id": 2408, "verse_number": "९-२६-१३", "content_sanskrit": "एवमुक्तः फल्गुनस्तु कृष्णं वचनमब्रवीत्।\nधृतराष्ट्रसुताः सर्वे हता भीमेन माधव।\nयावेतावास्थितौ कृष्ण तावद्य नभविष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066798, "chapter_id": 2408, "verse_number": "९-२६-१४", "content_sanskrit": "हतो भीष्मो हतो द्रोणः कर्णो वैकर्तनो हतः।\nमद्रराजो हतः शल्यो हतः कृष्ण जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066799, "chapter_id": 2408, "verse_number": "९-२६-१५", "content_sanskrit": "हयाः पञ्चशताः शिष्टाः शकुनेः सौबलस्य च।\nरथानां तु शते शिष्टे द्वे एव तु जनार्दन।\nदन्तिनां च शतं साग्रं त्रिसाहस्राः पदातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066800, "chapter_id": 2408, "verse_number": "९-२६-१६", "content_sanskrit": "अश्वत्थामा कृपश्चैव त्रिगर्ताधिपतिस्तथा।\nउलूकः शकुनिश्चैव कृतवर्मा च सात्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066801, "chapter_id": 2408, "verse_number": "९-२६-१७", "content_sanskrit": "एतद्बलमभूच्छेषं धार्तराष्ट्रस्य माधव।\nमोक्षो न नूनं कालात्तु विद्यते भुवि कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066802, "chapter_id": 2408, "verse_number": "९-२६-१८", "content_sanskrit": "तथा विनिहते सैन्ये पश्य दुर्योधनं स्थितम्।\nअद्याह्ना हि महाराजो हतामित्रो भविष्यति।\nन हि मे मोक्ष्यते कश्चित्परेषामिह चिन्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066803, "chapter_id": 2408, "verse_number": "९-२६-१९", "content_sanskrit": "ये त्वद्य समरं कृष्ण न हास्यन्ति मदोत्कटाः।\nतान्वै सर्वान्हनिष्यामि यद्यपि स्युरमानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066804, "chapter_id": 2408, "verse_number": "९-२६-२०", "content_sanskrit": "अद्य युद्धे समुत्पन्नं दीर्घं राज्ञः प्रजागरम्।\nअपनेष्यामि गान्धारिं घातयित्वा शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066805, "chapter_id": 2408, "verse_number": "९-२६-२१", "content_sanskrit": "निकृत्या वै दुराचारो यानि रत्नानि सौबलः।\nसभायामहरद्द्यूते पुनस्तान्याहराम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066806, "chapter_id": 2408, "verse_number": "९-२६-२२", "content_sanskrit": "अद्य वेत्स्यन्ति मच्छक्तिं सर्वा नागपुरे स्त्रियः।\nश्रुत्वा पतींश्च पुत्रांश्च पाण्डवैर्निहतान्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066807, "chapter_id": 2408, "verse_number": "९-२६-२३", "content_sanskrit": "समाप्तमद्य वै कर्म सर्वं कृष्ण भविष्यति।\nअद्य दुर्योधनो दीप्तां श्रियं प्राणांश्च मोक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066808, "chapter_id": 2408, "verse_number": "९-२६-२४", "content_sanskrit": "नापयाति भयात्कृष्ण सङ्ग्रामाद्यदि चेन्मम।\nनिहतं विद्धि वार्ष्णेय धार्तराष्ट्रं सुबालिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066809, "chapter_id": 2408, "verse_number": "९-२६-२५", "content_sanskrit": "मम ह्येतदपर्याप्तं वाजिबृन्दमरिन्दम।\nसोढुं ज्यातलनिर्घोषं याहि यावन्निहन्म्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066810, "chapter_id": 2408, "verse_number": "९-२६-२६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066811, "chapter_id": 2408, "verse_number": "९-२६-२६", "content_sanskrit": "एवमुक्तस्तु दाशार्हः पाण्डवेन यशस्विना।\nअचोदयद्धायन्राजन्दुर्योधनबलं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066812, "chapter_id": 2408, "verse_number": "९-२६-२७", "content_sanskrit": "तदनीकमभिप्रेक्ष्य त्रयः सज्जा महारथाः।\nभीमसेनोऽकर्जुनश्चैव सहदेवश्च मारिष।\nप्रययुः सिंहनादेन दुर्योधनजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066813, "chapter_id": 2408, "verse_number": "९-२६-२८", "content_sanskrit": "तान्प्रेक्ष्य सहितान्सर्वाञ्जवेनोद्यतकार्मुकान्।\nसौबलोऽभ्यद्रवद्युद्धे पाण्डवानाततायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066814, "chapter_id": 2408, "verse_number": "९-२६-२९", "content_sanskrit": "सुदर्शनस्त्व मतो भीमसेनं समभ्ययात्।\nसुशर्मा शकुनिश्चैव युयुधाते किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066815, "chapter_id": 2408, "verse_number": "९-२६-३०", "content_sanskrit": "सहदेवं तव सुतो हयपृष्ठगतोऽभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066816, "chapter_id": 2408, "verse_number": "९-२६-३१", "content_sanskrit": "ततो हि यत्नतः क्षिप्रं तवं पुत्रो जनाधिप।\nप्रासेन सहदेवस्य शिरसि प्राहरद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066817, "chapter_id": 2408, "verse_number": "९-२६-३२", "content_sanskrit": "सोपाविशद्रथोपस्थे तव सुत्रेण ताडितः।\nरुधिराप्लुतसर्वाङ्ग आशीविष इव श्वसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066818, "chapter_id": 2408, "verse_number": "९-२६-३३", "content_sanskrit": "प्रतिलभ्य ततः सञ्ज्ञां सहदेवो विशाम्पते।\nदुर्योधनं शरैस्तीक्ष्णैः सङ्क्रुद्धः समवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066819, "chapter_id": 2408, "verse_number": "९-२६-३४", "content_sanskrit": "पार्थोऽपि युधि विक्रम्य कुन्तीपुत्रो धनञ्जयः।\nशूराणामश्वपृष्ठेभ्यः शिरांसि निचकर्त ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066820, "chapter_id": 2408, "verse_number": "९-२६-३५", "content_sanskrit": "तदनीकं तदा पार्थो व्यधमद्बहुभिः शरैः।\nपातयित्वा हयान्सर्वांस्त्रिगर्तानां रथान्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066821, "chapter_id": 2408, "verse_number": "९-२६-३६", "content_sanskrit": "ततस्ते सहिता भूत्वा त्रिगर्तानां महारथाः।\nअर्जुनं वासुदेवं च शरवर्षैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2066822, "chapter_id": 2408, "verse_number": "९-२६-३७", "content_sanskrit": "सत्यकर्माणमाक्षिप्य क्षुरप्रेण महायशाः।\nततोऽस्य स्यन्दनस्येषां चिच्छिदे पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2066823, "chapter_id": 2408, "verse_number": "९-२६-३८", "content_sanskrit": "शिलाशितेन च विभो क्षुरप्रेण महायशाः।\nशिरश्चिच्छेद सहसा तप्तकुण्डलभूषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2066824, "chapter_id": 2408, "verse_number": "९-२६-३९", "content_sanskrit": "सत्येषुमथ चादत्त योधानां मिषतां ततः।\nयथा सिंहो वने राजन्मृगं परि बुभुक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2066825, "chapter_id": 2408, "verse_number": "९-२६-४०", "content_sanskrit": "तं निहत्य ततः पार्थः सुशर्माणं त्रिभिः शरैः।\nविद्ध्वा तानहनत्सर्वान्रथान्रुक्मविभूओषितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2066826, "chapter_id": 2408, "verse_number": "९-२६-४१", "content_sanskrit": "ततः प्रायात्त्वरन्पार्थो दीर्घकालं सुसंवृतम्।\nमुञ्जन्क्रोधविषं तीक्ष्णं प्रस्थलाधिपतिं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2066827, "chapter_id": 2408, "verse_number": "९-२६-४२", "content_sanskrit": "तमर्जुनः पृषत्कानां शतेन भरतर्षभ।\nपूरयित्वा ततो वाहान्प्राहरत्तस्य धन्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2066828, "chapter_id": 2408, "verse_number": "९-२६-४३", "content_sanskrit": "ततः शरं समादाय यमदण्डोपमं तदा।\nसुशर्माणं समुद्दिश्य चिक्षेपाशु हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2066829, "chapter_id": 2408, "verse_number": "९-२६-४४", "content_sanskrit": "स शरः प्रेषितस्तेन क्रोधदीप्तेन धन्विना।\nसुशर्माणं समासाद्य बिभेद हृदयं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2066830, "chapter_id": 2408, "verse_number": "९-२६-४५", "content_sanskrit": "स गतासुर्महाराज पपात धरणीतले।\nनन्दयन्पाण्डवान्सर्वान्व्यथयंश्चापि तावकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2066831, "chapter_id": 2408, "verse_number": "९-२६-४६", "content_sanskrit": "सुशर्माणं रणे हत्वा पुत्रानस्य महारथान्।\nसप्त चाष्टौ च त्रिंशच्च सायकैरनयत्क्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2066832, "chapter_id": 2408, "verse_number": "९-२६-४७", "content_sanskrit": "ततोऽस्य निशितैर्बाणैः सर्वान्हत्वा पदानुगान्।\nअभ्यगाद्भारतीं सेनां हतशेषां महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2066833, "chapter_id": 2408, "verse_number": "९-२६-४८", "content_sanskrit": "भीमस्तु समरे क्रुद्धः पुत्रं तव जनाधिप।\nसुदर्शनमदृश्यन्तं शरैश्चक्रे हसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2066834, "chapter_id": 2408, "verse_number": "९-२६-४९", "content_sanskrit": "ततोऽस्य प्रहसन्क्रुद्धः शिरः कायादपाहरत्।\nक्षुरप्रेण सुतीक्ष्णेन स हतः प्रापतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2066835, "chapter_id": 2408, "verse_number": "९-२६-५०", "content_sanskrit": "तस्मिंस्तु निहते वीरे ततस्तस्य पदानुगाः।\nपरिवव्रू रमे भीमं किरन्तो विविधाञ्शरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2066836, "chapter_id": 2408, "verse_number": "९-२६-५१", "content_sanskrit": "ततस्तु निशितैर्बाणैस्तवानीकं वृकोदरः।\nइन्द्राशनिसमस्पर्शैः समन्तात्पर्यवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2066837, "chapter_id": 2408, "verse_number": "९-२६-५२", "content_sanskrit": "ततः क्षणेन तद्भीमो न्यहनद्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2066838, "chapter_id": 2408, "verse_number": "९-२६-५३", "content_sanskrit": "तेषु तूत्साद्यमानेषु सेनाध्यक्षा महारथाः।\nभीमसेनं समासाद्य ततोऽयुध्यन्त भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2066839, "chapter_id": 2408, "verse_number": "९-२६-५४", "content_sanskrit": "स तान्सर्वाञ्शरैर्घोरैरवाकिरत पाण्डवः।\nतथैव तावका राजन्पाण्डवेयान्महारथान्।\nशरवर्षेण महता समन्तात्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2066840, "chapter_id": 2408, "verse_number": "९-२६-५५", "content_sanskrit": "व्याकुलं तदभूत्सर्वं पाण्डवानां परैः सह।\nतावकानां च समरे पाण्डवेंयैर्युयुत्सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2066841, "chapter_id": 2408, "verse_number": "९-२६-५६", "content_sanskrit": "तत्र योधास्तदा पेतुः परस्परसमाहताः।\nउभयोः सेनयो राजन्संशोचन्तः स्म बान्धवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2066842, "chapter_id": 2408, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि शल्यवधपर्वणि अष्टादशदिवसयुद्धे षड्विंशोऽध्यायः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]