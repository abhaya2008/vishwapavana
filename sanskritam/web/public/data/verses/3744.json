[{"id": 2128113, "chapter_id": 3744, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128114, "chapter_id": 3744, "verse_number": "१", "content_sanskrit": "एवं सम्भाषमाणे च धौम्ये कौरवनन्दनम् ।\nलोमशः सुमहातेजा ऋषिस्तत्राजगाम ह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128115, "chapter_id": 3744, "verse_number": "२", "content_sanskrit": "तं पाण्डवाग्रजो राजा सानुजो ब्राह्मणाश्च ते ।\nउदतिष्ठन्महाभागं दिवि शक्रं यथामराः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128116, "chapter_id": 3744, "verse_number": "३", "content_sanskrit": "तमभ्यर्च्य यथान्यायं धर्मपुत्रो युधिष्ठिरः ।\nपप्रच्छागमने हेतुं महर्षिं लोकविश्रुतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128117, "chapter_id": 3744, "verse_number": "४", "content_sanskrit": "स पृष्टः पाण्डुपुत्रेण प्रीयमाणो महामनाः ।\nउवाच श्लक्ष्णया वाचा हर्षयन्निव पाण्डवान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128118, "chapter_id": 3744, "verse_number": "५", "content_sanskrit": "सञ्चरन्नस्मि कौन्तेय सर्वांल्लोकान् यदृच्छया ।\nगतः शक्रस्य भवनं तत्रापश्यं सुरेश्वरम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128119, "chapter_id": 3744, "verse_number": "६", "content_sanskrit": "तव च भ्रातरं वीरमपश्यं सव्यसाचिनम् ।\nशक्रस्यार्धासनगतं तत्र मे विस्मयो महान् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128120, "chapter_id": 3744, "verse_number": "७", "content_sanskrit": "आसीत् पुरुषशार्दूल दृष्ट्वा पार्थं तथागतम् ।\nआह मां तत्र देवेन्द्रो गच्छ पाण्डुसुतानिति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128121, "chapter_id": 3744, "verse_number": "८", "content_sanskrit": "सोऽहमभ्यागतः क्षिप्रं दिदृक्षुस्त्वां सहानुजम् ।\nवचनात् पुरुहूतस्य पार्थस्य च महात्मनः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128122, "chapter_id": 3744, "verse_number": "९", "content_sanskrit": "आख्यास्ये ते प्रियं तात महत् पाण्डवनन्दन ।\nभ्रातृभिः सहितो राजन् कृष्णया चैव तच्छृणु\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128123, "chapter_id": 3744, "verse_number": "१०", "content_sanskrit": "यस्त्वयोक्तो महाबाहुरस्त्रार्थं पाण्डवर्षभ ।\nतदस्त्रमाप्तं पार्थेन रुद्रादप्रतिमं महत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128124, "chapter_id": 3744, "verse_number": "११", "content_sanskrit": "यत्तद् ब्रह्मशिरो नाम तपसा रुद्रमागतम् ।\nअमृतादुत्थितं रौद्रं तल्लब्धं सव्यसाचिना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128125, "chapter_id": 3744, "verse_number": "१२", "content_sanskrit": "तत् समन्त्रं ससंहारं सप्रायश्चित्तमङ्गलम् ।\nवज्रं चान्यानि चास्त्राणि दण्डादीनि युधिष्ठिर\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128126, "chapter_id": 3744, "verse_number": "१३", "content_sanskrit": "यमात् कुबेराद् वरुणाद् इन्द्राच्च कुरुनन्दन ।\nअस्त्राण्यधीतवान् पार्थो दिव्यान्यमितविक्रमः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128127, "chapter_id": 3744, "verse_number": "१४", "content_sanskrit": "विश्वावसोश्च तनयाद् गीतं नृत्तं च साम च ।\nवादित्रं च यथान्यायं प्रत्यविन्दद् यथाविधि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128128, "chapter_id": 3744, "verse_number": "१५", "content_sanskrit": "एवं कृतास्त्रः कौन्तेयो गान्धर्वं वेदमाप्तवान् ।\nसुखं वसति बीभत्सुरनुजस्यानुजस्तव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128129, "chapter_id": 3744, "verse_number": "१६", "content_sanskrit": "यदर्थं मां सुरश्रेष्ठ इदं वचनमब्रवीत् ।\nतच्च ते कथयिष्यामि युधिष्ठिर निबोध तत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128130, "chapter_id": 3744, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128131, "chapter_id": 3744, "verse_number": "१७", "content_sanskrit": "भवान् मनुष्यलोकाय गमिष्यति न संशयः ।\nब्रूयाद् युधिष्ठिरं तत्र वचनं मे द्विजोत्तम \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128132, "chapter_id": 3744, "verse_number": "१८", "content_sanskrit": "आगमिष्यति ते भ्राता कृतास्त्रः क्षिप्रमर्जुनः ।\nसुरकार्यं महत् कृत्वा यदशक्यं दिवौकसाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128133, "chapter_id": 3744, "verse_number": "१९", "content_sanskrit": "तपसा तु त्वमात्मानं भ्रातृभिः सह योजय ।\nतपसो हि समं नास्ति तपसा विन्दते महत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128134, "chapter_id": 3744, "verse_number": "२०", "content_sanskrit": "अहं च कर्णं जानामि यथावत् पुरुषर्षभ ।\nन स पार्थस्य सङ्ग्रामे कलामर्हति षोडशीम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128135, "chapter_id": 3744, "verse_number": "२१", "content_sanskrit": "यच्चापि ते भयं तस्मान्मनसिस्थमरिन्दम ।\nतच्चाप्यपहरिष्यामि सव्यसाचाविहागते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128136, "chapter_id": 3744, "verse_number": "२२", "content_sanskrit": "यच्च ते मानसं वीर तीर्थयात्रामिमां प्रति ।\nतच्च ते लोमशः सर्वं कथयिष्यत्यसंशयम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128137, "chapter_id": 3744, "verse_number": "२३", "content_sanskrit": "यच्च किञ्चित् तपोयुक्तं फलं तीर्थेषु भारत ।\nब्रह्मर्षिरेष यद् ब्रूयात् तच्छ्रद्धेयं न चान्यथा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128138, "chapter_id": 3744, "verse_number": "४२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां वनपर्वणि षडशीतितमोऽध्यायः ॥८६॥\n॥ तीर्थयात्रापर्वणि द्विचत्वारिंशोऽध्यायः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]