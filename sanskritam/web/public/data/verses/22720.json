[{"id": 7002720000, "chapter_id": 22720, "verse_number": "९-५-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअधोधः पतनं पुंसामधःकर्म प्रकीर्तितम् ।\nनरकार्णवघोरेषु यातना पापमुच्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002720001, "chapter_id": 22720, "verse_number": "९-५-२", "content_sanskrit": "अधर्मभेदा विज्ञेयाश्चित्तवृत्तिप्रभेदतः ।\nस्थूलाः सूक्ष्माः सुसूक्ष्माश्च कोटि भेदैरनेकधा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002720002, "chapter_id": 22720, "verse_number": "९-५-३", "content_sanskrit": "तत्र ये पापनिचयाः स्थूला नरकहेतवः ।\nते समासेन कथ्यंते मनोवाक्कायसाधनाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002720003, "chapter_id": 22720, "verse_number": "९-५-४", "content_sanskrit": "परस्त्रीष्वथ संकल्पश्चेतसानिष्टचिंतनम् ।\nअकार्याभिनिवेशश्च चतुर्धा कर्म मानसम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002720004, "chapter_id": 22720, "verse_number": "९-५-५", "content_sanskrit": "अनिबद्धप्रलापित्वमसत्यं चाप्रियं च यत् ।\nपरापवादपैशुन्यं चतुर्धा कर्म वाचिकम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002720005, "chapter_id": 22720, "verse_number": "९-५-६", "content_sanskrit": "अभक्ष्यभक्षणं हिंसा मिथ्या कामस्य सेवनम् ।\nपरस्वानामुपादानं चतुर्द्धा कर्म कायिकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002720006, "chapter_id": 22720, "verse_number": "९-५-७", "content_sanskrit": "इत्येतद्द्वादशविधं कर्म प्रोक्तं ससाधनम् ।\nतेषां भेदं पुनर्वच्मि येषां फलमनंतकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002720007, "chapter_id": 22720, "verse_number": "९-५-८", "content_sanskrit": "ये द्विषंति महादेवं संसारार्णवतारणम् ।\nसमस्तपातकोपेतास्ते यान्ति नरकाग्निषु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002720008, "chapter_id": 22720, "verse_number": "९-५-९", "content_sanskrit": "ब्रह्मघ्नश्च सुरापश्च स्तेयी च गुरुतल्पगः ।\nमहापातकिनश्चैते तत्संसर्गी च पंचमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002720009, "chapter_id": 22720, "verse_number": "९-५-१०", "content_sanskrit": "क्रोधाद्द्वेषाद्भयाल्लोभाद्ब्राह्मणं विशसंति ये ।\nप्राणांतिको महादोषो ब्रह्मघ्नास्ते प्रकीर्तिताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002720010, "chapter_id": 22720, "verse_number": "९-५-११", "content_sanskrit": "ब्राह्मणं च समाहूय याचमानमकिञ्चनम् ।\nपश्चान्नास्तीति तं ब्रूयात्स चैवं ब्रह्महा स्मृतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002720011, "chapter_id": 22720, "verse_number": "९-५-१२", "content_sanskrit": "यस्तु विद्याभिमानेन नित्यं जयति वै द्विजान् ।\nसमासीनः सभामध्ये ब्रह्महा सोऽपि कीर्तितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002720012, "chapter_id": 22720, "verse_number": "९-५-१३", "content_sanskrit": "मिथ्यागुणैः स्वमात्मानं नयत्युत्कर्षणं बलात् ।\nगुरूणां च विरुद्धो यः स चैव ब्रह्महा स्मृतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002720013, "chapter_id": 22720, "verse_number": "९-५-१४", "content_sanskrit": "क्षुत्तृट्संतप्तदेहानां द्विजानां भोक्तुमिच्छताम् ।\nसमाचरति यो विघ्नं तमाहुर्ब्रह्मघातकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002720014, "chapter_id": 22720, "verse_number": "९-५-१५", "content_sanskrit": "पिशुनः सर्वलोकानां छिद्रान्वेषणतत्परः ।\nउद्वेगजननः क्रूरः स चैव ब्रह्महा स्मृतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002720015, "chapter_id": 22720, "verse_number": "९-५-१६", "content_sanskrit": "गवां तृष्णाभिभूतानां जलार्थमुपसर्पताम् ।\nसमाचरति यो विघ्नं स चैव ब्रह्महा स्मृतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002720016, "chapter_id": 22720, "verse_number": "९-५-१७", "content_sanskrit": "परदोषमभिज्ञाय नृपकर्णे करोति यः ।\nपापीयान्पिशुनः क्षुद्रः स चैव ब्रह्महा स्मृतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002720017, "chapter_id": 22720, "verse_number": "९-५-१८", "content_sanskrit": "देवद्विजगवां भूमिं पूर्वभुक्ता हरेत्तु यः ।\nप्रनष्टामपि कालेन तमाहुर्ब्रह्मघातकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002720018, "chapter_id": 22720, "verse_number": "९-५-१९", "content_sanskrit": "द्विजवित्तापहरणे न्यायतः समुपार्जिते ।\nब्रह्महत्या समं ज्ञेयं पातकं नात्र संशयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002720019, "chapter_id": 22720, "verse_number": "९-५-२०", "content_sanskrit": "अग्निहोत्रपरित्यागो यस्तु याज्ञिककर्मणाम् ।\nमातापितृपरित्यागः कूटसाक्ष्यं सुहृद्वधः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002720020, "chapter_id": 22720, "verse_number": "९-५-२१", "content_sanskrit": "गवां मार्गे वने चाग्निं पुरे ग्रामे च दीपयेत् ।\nइति पापानि घोराणि सुरापानसमानि तु ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002720021, "chapter_id": 22720, "verse_number": "९-५-२२", "content_sanskrit": "हीनस्वहरणे चापि नरस्त्रीगजवाजिनाम् ।\nगोभूरजतरत्नानामौषधीनां रजस्य च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002720022, "chapter_id": 22720, "verse_number": "९-५-२३", "content_sanskrit": "चंदनागरुकर्पूरकस्तूरीखण्डवाससाम् ।\nहस्ते न्यस्यापहरणं रुक्मस्तेयसमं स्मृतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002720023, "chapter_id": 22720, "verse_number": "९-५-२४", "content_sanskrit": "कन्यानां वरयोग्यानामदानं सदृशे वरे ।\nपुत्रमित्रकलत्रेषु गमनं भगिनीषु च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002720024, "chapter_id": 22720, "verse_number": "९-५-२५", "content_sanskrit": "कुमारीसाहसं घोरमन्त्यजस्त्रीनिषेवणम् ।\nअवर्णायाश्च गमनं गुरुतल्पसमं स्मृतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002720025, "chapter_id": 22720, "verse_number": "९-५-२६", "content_sanskrit": "महापातकतुल्यानि पापान्युक्तानि यानि तु ।\nतानि पातकसंज्ञानि तद्वदाम्युपपातकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002720026, "chapter_id": 22720, "verse_number": "९-५-२७", "content_sanskrit": "द्विजार्थं च प्रतिज्ञाय न प्रयच्छति यः पुनः ।\nतस्मान्नरपते विघ्नतुल्यं तदुपपातकम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002720027, "chapter_id": 22720, "verse_number": "९-५-२८", "content_sanskrit": "द्विजद्रव्यापहरणं मर्यादाया व्यतिक्रमः ।\nअतिकोपश्च मानश्च दांभिकत्वं कृतघ्नता ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002720028, "chapter_id": 22720, "verse_number": "९-५-२९", "content_sanskrit": "अत्यंतविषयासक्तिः कार्पण्यं श्रेष्ठमत्सरः ।\nपरदारापहरणं साधुकन्याविदूषणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002720029, "chapter_id": 22720, "verse_number": "९-५-३०", "content_sanskrit": "परिवित्तिः परीवेत्ता यया च परिविद्यते ।\nतयोर्द्दानं च कन्यायास्तयोरेव च याजनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002720030, "chapter_id": 22720, "verse_number": "९-५-३१", "content_sanskrit": "पुत्रमित्रकलत्राणामभावे स्वामिनस्तथा ।\nशिष्टानां चैव संन्यासः सहजानां तपस्विनाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002720031, "chapter_id": 22720, "verse_number": "९-५-३२", "content_sanskrit": "भंगश्च धर्मकृत्यानां सहायानां विनाशनम् ।\nपीडामाश्रमसंस्थानान्नाचरेत्त्वल्पिकामपि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002720032, "chapter_id": 22720, "verse_number": "९-५-३३", "content_sanskrit": "स्वभृत्यपरिवर्गस्य पशुधान्यधनस्य च ।\nकुप्यधान्यपशुस्तेयमयाच्यानां च याचनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002720033, "chapter_id": 22720, "verse_number": "९-५-३४", "content_sanskrit": "गवां क्षत्रियवेश्यानां स्त्रीशूद्राणां विशेषतः ।\nयज्ञारामतडागानां दारापत्यस्य विक्रयः ।\nतीर्थयात्रोपवासानां व्रतायतनकर्मणाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002720034, "chapter_id": 22720, "verse_number": "९-५-३५", "content_sanskrit": "स्त्रीधनान्युपजीवंति स्त्रीभिरत्यंतनिर्जिताः ।\nअरक्षणं च नारीणां मद्यपस्त्रीनिषेवणम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002720035, "chapter_id": 22720, "verse_number": "९-५-३६", "content_sanskrit": "ऋणानामप्रदानं च धान्यवृद्ध्युपजीविनाम् ।\nनिंदिताच्च धनादानमपण्यानां च विक्रयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002720036, "chapter_id": 22720, "verse_number": "९-५-३७", "content_sanskrit": "विषमारणमंत्राणां प्रयोगो मूलकर्मणाम् ।\nउच्चाटनाविचारश्च गरविद्वेषणक्रिया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002720037, "chapter_id": 22720, "verse_number": "९-५-३८", "content_sanskrit": "जिह्वासमुपभोगार्थं यस्यारम्भः स्वकर्मसु ।\nमूल्येनाध्यापयेद्यश्च मूल्येनाधीयते च ये ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002720038, "chapter_id": 22720, "verse_number": "९-५-३९", "content_sanskrit": "व्रात्यता व्रतसंत्यागः सर्वाहारनिषेवणम् ।\nअसद्दाराभिगमनं शुष्कतर्कावलंबनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002720039, "chapter_id": 22720, "verse_number": "९-५-४०", "content_sanskrit": "देवाग्निसाधुसाध्वीनां निंदा गोब्राह्मणस्य च ।\nप्रत्यक्षं वा परोक्षं वा राज्ञां मण्डलिकामपि ।\nदुःशीला नास्तिकाः पापाः सर्वशून्यस्य वादिनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002720040, "chapter_id": 22720, "verse_number": "९-५-४१", "content_sanskrit": "पर्वकाले दिवा चैव वियोनौ पशुयोनिषु ।\nरजस्वलानां योनौ च मैथुनं च समाचरेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002720041, "chapter_id": 22720, "verse_number": "९-५-४२", "content_sanskrit": "स्त्रीपुत्रमित्रसंप्रीते ग्रासान्नच्छेदकाश्च ये ।\nजनस्या प्रियवक्तारो धूर्ताः समयभेदिनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002720042, "chapter_id": 22720, "verse_number": "९-५-४३", "content_sanskrit": "भेत्ता तडागचक्राणां संक्रमाणां रथस्य च ।\nएकपंक्तिस्थितानां च पाकभेदं करोति यः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002720043, "chapter_id": 22720, "verse_number": "९-५-४४", "content_sanskrit": "इत्येतैस्ते नराः पापैरुपपातकिनः स्मृताः ।\nयुक्तास्तदूनकैः क्षुद्रैः पापैः पापतराः स्मृताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002720044, "chapter_id": 22720, "verse_number": "९-५-४५", "content_sanskrit": "ये गोब्राह्मणकन्यानां स्वामिमित्रतपस्विनाम् ।\nअंतरं यांति कार्येषु ते नरा नारकाः स्मृताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002720045, "chapter_id": 22720, "verse_number": "९-५-४६", "content_sanskrit": "परश्रिया ये तप्यंते ये परद्रव्यसूचकाः ।\nपरव्यापारनिरताः परस्त्रीनरदूषकाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002720046, "chapter_id": 22720, "verse_number": "९-५-४७", "content_sanskrit": "द्विजाय दुःखं यः कुर्यात्प्रकारैर्बहुभिः सदा ।\nसेवते यो द्विजः शूद्रां सुरां जिघ्रति कामतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002720047, "chapter_id": 22720, "verse_number": "९-५-४८", "content_sanskrit": "ये पानाभिरताः क्रूरा ये च हिंसाप्रिया नराः ।\nवित्तार्थं ये च कुर्वंति दानयज्ञादिकां क्रियाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002720048, "chapter_id": 22720, "verse_number": "९-५-४९", "content_sanskrit": "गोष्ठाग्निजलरथ्यासु तरुच्छायामठेषु च ।\nत्यजंत्यमेध्यं पुरुषा आरामायतनेषु च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002720049, "chapter_id": 22720, "verse_number": "९-५-५०", "content_sanskrit": "मद्यपानरता नित्यं गानवाद्यरता नराः ।\nकेलीकलाभुजंगाश्च रंध्रान्वेषणतत्पराः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002720050, "chapter_id": 22720, "verse_number": "९-५-५१", "content_sanskrit": "वंशेषु काशकाष्ठैश्च शुभैः शंकुभिरेव वा ।\nये मार्गान्समुपघ्नंति परस्त्रीराहरंति च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002720051, "chapter_id": 22720, "verse_number": "९-५-५२", "content_sanskrit": "कूटशासनहर्तारः कूटकर्मक्रियारताः ।\nकूटयुद्धाश्च शस्त्रेण कूटसंव्यवहारिणः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002720052, "chapter_id": 22720, "verse_number": "९-५-५३", "content_sanskrit": "धनुषां शल्यशस्त्राणां यः कर्ता यश्च विक्रयी ।\nनिर्दयोऽतीव भृत्येषु पशूनां दमकश्च यः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002720053, "chapter_id": 22720, "verse_number": "९-५-५४", "content_sanskrit": "मिथ्या प्रवदतो वाक्यमाकर्णयति यः शनैः ।\nस्वामिमित्रगुरुद्रोही मायावी चपलः शठः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002720054, "chapter_id": 22720, "verse_number": "९-५-५५", "content_sanskrit": "ये भार्यापुत्रमित्राणि बालवृद्धकृशातुरान् ।\nभृत्यानतिथिबन्धूंश्च प्रबाधन्ते बुभुक्षया ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002720055, "chapter_id": 22720, "verse_number": "९-५-५६", "content_sanskrit": "यः स्वयं मिष्टमश्नाति विप्रायान्यत्प्रयच्छति ।\nवृथापाकः स विज्ञेयो ब्रह्मवादिषु गर्हितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002720056, "chapter_id": 22720, "verse_number": "९-५-५७", "content_sanskrit": "नियमान्स्वयमादाय ये त्यजंत्यजितेंद्रियाः ।\nप्रव्रज्यावासिनो ये च रहस्यानां च भेदकाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002720057, "chapter_id": 22720, "verse_number": "९-५-५८", "content_sanskrit": "ताडयंति च वेगाद्ये शपंति च मुहुर्मुहुः ।\nदुर्बलांश्च न पुष्णंति पुनस्तान्वाहयंति च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002720058, "chapter_id": 22720, "verse_number": "९-५-५९", "content_sanskrit": "पीडयंत्यतिभारेण सक्षतान्वाहयंति च ।\nसार्द्धयामादुपरितः संयुक्तेषु च भुंजते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002720059, "chapter_id": 22720, "verse_number": "९-५-६०", "content_sanskrit": "ये भग्नक्षतरोगार्तान्स्वगोरूपान्बुभुक्षया ।\nन पालयंति यत्नेन ते गोप्ता नारका नराः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002720060, "chapter_id": 22720, "verse_number": "९-५-६१", "content_sanskrit": "वृषाणां वृषणान्येव पापिष्ठा गालयंति ये ।\nवाहयंति च गां वध्यां ते महानारकाः स्मृताः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002720061, "chapter_id": 22720, "verse_number": "९-५-६२", "content_sanskrit": "आश्रमं समनुप्राप्तं क्षुत्तृष्णाश्रमपीडितम् ।\nयेऽतिथिं नाभिमन्यंते ते वै निरयगामिनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002720062, "chapter_id": 22720, "verse_number": "९-५-६३", "content_sanskrit": "अनाथं विकलं दीनं बालं वृद्धं कृशातुरम् ।\nनानुकंपंति ये मूढास्ते यान्ति निरयार्णवम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002720063, "chapter_id": 22720, "verse_number": "९-५-६४", "content_sanskrit": "अजाविको माहिषिकः सामुद्रो वृषलीपतिः ।\nशूद्रविट्क्षत्रवृत्तिश्च नारकी स्याद्द्विजाधमः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002720064, "chapter_id": 22720, "verse_number": "९-५-६५", "content_sanskrit": "शिल्पिनः कारुका वैद्या हेमकारा नटा द्विजाः ।\nकृतकौक्षेय सयुक्तास्तथान्ये नारकाः स्मृताः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002720065, "chapter_id": 22720, "verse_number": "९-५-६६", "content_sanskrit": "यश्चोदितमतिक्रम्य स्वेच्छया वा हरेत्करम् ।\nनरके तु स पच्येत यश्च दंडरुचिर्भवेत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002720066, "chapter_id": 22720, "verse_number": "९-५-६७", "content_sanskrit": "उत्कोचकैरधिकृतैस्तस्करैश्च प्रपीड्यते ।\nयस्य राज्ञः प्रजा रुष्टा पच्यते नरकेषु सः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002720067, "chapter_id": 22720, "verse_number": "९-५-६८", "content_sanskrit": "ये द्विजाः प्रतिगृह्णंति नृपस्यान्यायवर्तिनः ।\nप्रयांति तेपि घोराणि नरकाणि न संशयः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002720068, "chapter_id": 22720, "verse_number": "९-५-६९", "content_sanskrit": "पारदारिकचौराणां यत्पापं पार्थिवस्य तत् ।\nभवेदरक्षतस्तस्माद्घोरस्तस्य प्रतिग्रहः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002720069, "chapter_id": 22720, "verse_number": "९-५-७०", "content_sanskrit": "अचौरं चौरवत्पश्येच्चोरं वाऽचौररूपवत् ।\nअविचार्य नृपस्तस्माद्धातयन्नरकं व्रजेत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002720070, "chapter_id": 22720, "verse_number": "९-५-७१", "content_sanskrit": "घृततैलान्नपानानि मधुमांससुरासवम् ।\nगुडेक्षुक्षारशाकानि दधिमूलफलानि च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002720071, "chapter_id": 22720, "verse_number": "९-५-७२", "content_sanskrit": "तृणं काष्ठं पुष्पपत्रमौषधं कांस्यभाजनम् ।\nउपानच्छत्रशकटमासनं शयनांबरम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002720072, "chapter_id": 22720, "verse_number": "९-५-७३", "content_sanskrit": "ताम्रं सीसं त्रपुं काचं शंखाद्यं च जलोद्भवम् ।\nवार्क्षं वा वैणवाद्यं वा गृहेषूपस्कराणि च ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002720073, "chapter_id": 22720, "verse_number": "९-५-७४", "content_sanskrit": "ऊर्णाकार्पासकौशेयभंगपट्टोद्भवानि च ।\nस्थूलसूक्ष्माणि वस्त्राणि ये च लोभाद्धरंति च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002720074, "chapter_id": 22720, "verse_number": "९-५-७५", "content_sanskrit": "एवमादीनि चान्यानि द्रव्याणि विविधानि च ।\nनरकाणि ध्रुवं यांति नरा वा नात्र संशयः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002720075, "chapter_id": 22720, "verse_number": "९-५-७६", "content_sanskrit": "यद्वा तद्वा परद्रव्यमपि सर्षपमात्रकम् ।\nअपहृत्य नरो याति नरकं नात्र संशयः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002720076, "chapter_id": 22720, "verse_number": "९-५-७७", "content_sanskrit": "एवमाद्यै्र्नरः पापैरुत्क्रांतेः समनंतरम् ।\nशरीरं यातनार्थाय पूर्वाकारमवाप्नुयात् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002720077, "chapter_id": 22720, "verse_number": "९-५-७८", "content_sanskrit": "यमलोकं व्रजेत्तेन शरीरेण यमाज्ञया ।\nयमदूतैर्महाघोरैर्नीयमानः सुदुःखितः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002720078, "chapter_id": 22720, "verse_number": "९-५-७९", "content_sanskrit": "तिर्यङ्मानुषदेहानामधर्मनिरतात्मनाम् ।\nधर्मराजः स्मृतः शास्ता सुघोरैर्विविधैर्वधैः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002720079, "chapter_id": 22720, "verse_number": "९-५-८०", "content_sanskrit": "विनयाचारयुक्तानां प्रमादात्स्खलितात्मनाम् ।\nप्रायश्चित्तेर्गुरुः शास्ता न च तैर्दृश्यते यमः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002720080, "chapter_id": 22720, "verse_number": "९-५-८१", "content_sanskrit": "पारदारिकचौराणामन्यायव्यवहारिणाम् ।\nनृपतिः शासकस्तेषां प्रच्छन्नानां च धर्मराट् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002720081, "chapter_id": 22720, "verse_number": "९-५-८२", "content_sanskrit": "तस्मात्कृतस्य पापस्य प्रायश्चित्तं समाचरेत् ।\nनाभुक्तस्यान्यथा नाशः कल्पकोटिशतैरपि ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002720082, "chapter_id": 22720, "verse_number": "९-५-८३", "content_sanskrit": "यः करोति स्वयं कर्म कारयेद्वापि मोद येत् ।\nकायेन मनसा वाचा तस्य चाधोगतिः फलम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002720083, "chapter_id": 22720, "verse_number": "९-५-८४", "content_sanskrit": "इति संक्षेपतः प्रोक्ताः पापभेदाः ससाधनाः ।\nकथ्यते गतयश्चित्रा नराणां पापकर्मणाम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002720084, "chapter_id": 22720, "verse_number": "९-५-८५", "content_sanskrit": "वाक्कायचित्तजनितैर्बहुभेदभिन्नैः कृत्यैः शुभाशुभफलोदयहेतुभूतैः ।\nभास्वत्सुरेशभुवनं नरकाननेकान्संप्राप्नुवंति मनुजा मनुजेंद्रचन्द्र  ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]