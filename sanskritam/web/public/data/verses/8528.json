[{"id": 900007095, "chapter_id": 8528, "verse_number": "109.1", "content_sanskrit": "प्रश्नदोषा हि चत्वारः स्वव्याहतिरसङ्गतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007096, "chapter_id": 8528, "verse_number": "109.2", "content_sanskrit": "न तैः स्यात्तत्त्वनिर्णयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007097, "chapter_id": 8528, "verse_number": "109.3", "content_sanskrit": "तत्त्वनिर्णयवैलोम्यं स्याद्वादेऽपि हि निग्रहः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007098, "chapter_id": 8528, "verse_number": "109.4", "content_sanskrit": "उद्भावनीयमेव स्यान्न कथावसितिर्भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007099, "chapter_id": 8528, "verse_number": "109.5", "content_sanskrit": "उद्भावनीयमेव स्यान्न कथावसितिर्भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007100, "chapter_id": 8528, "verse_number": "109.6", "content_sanskrit": "परिहारेऽपि सिद्धत्वं दूषणं प्रतिवादिनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007101, "chapter_id": 8528, "verse_number": "109.7", "content_sanskrit": "तदन्यस्य सिद्धतैव हि साधिका", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007102, "chapter_id": 8528, "verse_number": "109.8", "content_sanskrit": "आश्रयव्याश्रयासिद्धी साध्यासिद्धिश्च दूषणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007103, "chapter_id": 8528, "verse_number": "109.9"