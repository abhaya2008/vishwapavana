[{"id": 2064586, "chapter_id": 2372, "verse_number": "८-९३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2064587, "chapter_id": 2372, "verse_number": "८-९३-१", "content_sanskrit": "रथौ तयोः श्वेतहयौ दिव्यौ युक्तौ महास्वनौ।\nसमास्थितौ लोकवीरौ शङ्खान्दध्मुः पृथक्पृथकम्।\nवासुदेवार्जुनौ वीरौ कर्णशल्यौ च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2064588, "chapter_id": 2372, "verse_number": "८-९३-२", "content_sanskrit": "तद्भीरुसन्त्रासकरं युद्धं समभवत्तदा।\nअन्योन्यस्पांधेनोरुग्रं शक्रशम्बरयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2064589, "chapter_id": 2372, "verse_number": "८-९३-३", "content_sanskrit": "तयोर्ध्वजौ हि विमलौ शुशुभाते रथे स्थितौ।\nराहुकेतू यथाऽऽकाशे उदितौ जगतः क्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2064590, "chapter_id": 2372, "verse_number": "८-९३-४", "content_sanskrit": "कर्णस्याशीविषनिभा रत्नसारमयी दृढ़ा।\nपुरन्दरधनुः प्रख्या हस्तिकक्ष्या विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2064591, "chapter_id": 2372, "verse_number": "८-९३-५", "content_sanskrit": "कपिश्रेष्ठस्तु पार्थस्य व्यादितास्य इवान्तकः।\nदंष्ट्राभिर्भीषयन्भाभिर्दुर्निरीक्ष्यो रविर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2064592, "chapter_id": 2372, "verse_number": "८-९३-६", "content_sanskrit": "युद्धाभिलाषुको भूत्वा ध्वजो गाण्डीवधन्वनः।\nकर्णध्वजमुपातिष्ठत्स्वस्थानाद्वेगवान्कपिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2064593, "chapter_id": 2372, "verse_number": "८-९३-७", "content_sanskrit": "उत्पत्य च महावेगः कक्ष्यामभ्याहनत्तदा।\nनखैश्च दशनैश्चैव गरुडः पन्नगं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2064594, "chapter_id": 2372, "verse_number": "८-९३-८", "content_sanskrit": "सा किङ्किणीकाभरणा कालपाशोपमा तदा।\nअभ्यद्रवत्सुसंरब्धा हस्तिकक्ष्याऽथ तं कपिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2064595, "chapter_id": 2372, "verse_number": "८-९३-९", "content_sanskrit": "तयोर्घोरतरे युद्धे द्वैरथे द्यूत आहिते।\nप्राकुर्वतां ध्वजौ युद्धं पूर्वं पूर्वतरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2064596, "chapter_id": 2372, "verse_number": "८-९३-१०", "content_sanskrit": "हया हयानभ्यहेषन्स्पर्धमानाः परस्परम्।\nअविध्यत्पुण्डरीकाक्षः शल्यं नयनसायकैः।\nशल्यश्च पुण्डरीकाक्षं तथैवाभिसमैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2064597, "chapter_id": 2372, "verse_number": "८-९३-११", "content_sanskrit": "तत्राजयद्वासुदेवः शल्यं नयनसायकैः।\nकर्णं चाप्यजयदृष्ट्या कुन्तीपुत्रो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2064598, "chapter_id": 2372, "verse_number": "८-९३-१२", "content_sanskrit": "अयाब्रवीत्सूतपुत्रः शल्यमाभाष्य सस्मितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2064599, "chapter_id": 2372, "verse_number": "८-९३-१३", "content_sanskrit": "यदि पार्थो रणे हन्यादद्य मामिह कर्हिचित्।\nकिं करिष्यसि सङ्घामे शल्य सत्यमथोच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2064600, "chapter_id": 2372, "verse_number": "८-९३-१४x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2064601, "chapter_id": 2372, "verse_number": "८-९३-१४", "content_sanskrit": "यदि कर्ण रणे हन्यादद्य त्वां श्वेतवाहनः।\nउभावेकरयेनाहं हन्यां माधवपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2064602, "chapter_id": 2372, "verse_number": "८-९३-१५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2064603, "chapter_id": 2372, "verse_number": "८-९३-१५", "content_sanskrit": "एवमेव तु गोविन्दमर्जुनः प्रत्यभाषत।\nतं प्रहस्याब्रवीत्कृष्णः पार्थं परमिदं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2064604, "chapter_id": 2372, "verse_number": "८-९३-१६", "content_sanskrit": "पतेद्दिवाकरः स्थानाच्छीर्येद्भूमिरनेकधा।\nशैल्यमग्निरियान्न त्वां हन्यात्कार्णो धनञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2064605, "chapter_id": 2372, "verse_number": "८-९३-१७", "content_sanskrit": "यदि चैतत्कथञ्चित्स्याल्लोकपर्यसनं भवेत्।\nहन्यां कर्णं तथा शल्यं बाहुभ्यामेव संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2064606, "chapter_id": 2372, "verse_number": "८-९३-१८", "content_sanskrit": "इति कृष्णवचः श्रुत्वा प्रहसन्कपिकेतनः।\nअर्जुनः प्रत्युवाचेदं कृष्णमक्लिष्टकारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2064607, "chapter_id": 2372, "verse_number": "८-९३-१९", "content_sanskrit": "मम तावदपर्याप्तौ कर्णशल्यौ जनार्दन।\nसपताकध्वजं कर्णं सशल्यरथवाजिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2064608, "chapter_id": 2372, "verse_number": "८-९३-२०", "content_sanskrit": "सच्छत्रकवचं चैव सशक्तिशरकार्मुकम्।\nद्रष्टाऽस्यद्य रणे कृष्ण शरैश्छिन्नमनेकधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2064609, "chapter_id": 2372, "verse_number": "८-९३-२१", "content_sanskrit": "अद्यैव सरथं साश्वं सशक्तिकवचायुधम्।\nसञ्चूर्णितमिवारण्ये वृक्षं पश्याद्य दन्तिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2064610, "chapter_id": 2372, "verse_number": "८-९३-२२", "content_sanskrit": "अद्य राधेयभार्याणां वैधव्यं समुपस्थितम्।\nध्रुवं स्वप्नेष्वनिष्टानि ताभिर्दृष्टानि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2064611, "chapter_id": 2372, "verse_number": "८-९३-२३", "content_sanskrit": "द्रष्टासि ध्रुवमद्यैव विधवाः कर्णयोषितः।\nन हि मे शाम्यते मन्युर्यदनेन पुरा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2064612, "chapter_id": 2372, "verse_number": "८-९३-२४", "content_sanskrit": "कृष्णां सभागतां दृष्ट्वा मूढेनादीर्घदर्शिना।\nअस्मांस्तथाऽवहसता क्षिपता च पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2064613, "chapter_id": 2372, "verse_number": "८-९३-२५", "content_sanskrit": "अद्य द्रष्टासि गोविन्द कर्णमुन्मथितं मया।\nवारणेनेव मत्तेन पुष्पितं गजतीरुहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2064614, "chapter_id": 2372, "verse_number": "८-९३-२६", "content_sanskrit": "अद्य ता मधुरा वाचः श्रोतासि मधुसूदन।\nदिष्ट्या जयसि वार्ष्णेय इति कर्णे निपातिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2064615, "chapter_id": 2372, "verse_number": "८-९३-२७", "content_sanskrit": "अद्याभिमन्युजननीं प्रहृष्टः सांत्वयिष्यसि।\nकुन्तीं पितृष्वसारं च प्रहृष्टः सन् जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2064616, "chapter_id": 2372, "verse_number": "८-९३-२८", "content_sanskrit": "अद्य बाष्पमुखीं कृष्णां सान्त्वयिष्यसि माधव।\nवाग्भिश्चामृतकल्पाभिर्धर्मराजं च पाण्डवम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2064617, "chapter_id": 2372, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे त्रिनवतितमोऽध्यायः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]