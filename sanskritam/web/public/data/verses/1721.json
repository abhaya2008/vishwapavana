[{"id": 2033481, "chapter_id": 1721, "verse_number": "४-४४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033482, "chapter_id": 1721, "verse_number": "४-४४-१", "content_sanskrit": "ततः पार्थं स वैराटिः प्राञ्जलिस्त्वभ्यवादयत्।\nअहं भूमिंजयो नाम प्रणतोस्मि धनंजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033483, "chapter_id": 1721, "verse_number": "४-४४-२", "content_sanskrit": "दिष्ट्या त्वां पार्थ पश्यामि स्वागतं ते धनंजय ।\nलोहिताक्ष महाबाहो नागराजवरोपम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033484, "chapter_id": 1721, "verse_number": "४-४४-३", "content_sanskrit": "यदज्ञानादवोचं त्वां प्रमादेन नरोत्तम।\nअकृत्वा हृदये सर्वं क्षन्तुमर्हसि तन्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033485, "chapter_id": 1721, "verse_number": "४-४४-४", "content_sanskrit": "यतस्त्वया कृतं पूर्वं चित्रं कर्म सुदुष्करम्।\nअतो भयं व्यपेतं मे प्रीतिश्च परमा त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033486, "chapter_id": 1721, "verse_number": "४-४४-५", "content_sanskrit": "दासोऽहं ते भविष्यामि पश्य मामनुकम्पया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033487, "chapter_id": 1721, "verse_number": "४-४४-६", "content_sanskrit": "या प्रतिज्ञा कृता पूर्वं तव सारथ्यकारणात्।\nसेयं प्रतिज्ञा पूर्णा मे हर्षश्चार्जुन जायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033488, "chapter_id": 1721, "verse_number": "४-४४-७", "content_sanskrit": "देवेन्द्रतनयस्येह सारथिः स्यां महामृधे ।\nइति पूर्वं कृताऽस्माभिः प्रतिज्ञा युद्धदुर्मद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033489, "chapter_id": 1721, "verse_number": "४-४४-८", "content_sanskrit": "प्रतिज्ञा मम संपूर्णा तव सारथ्यकारणात् ।\nमनस्स्वास्थ्यं च मे जातं जातं भाग्यं च मे महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033490, "chapter_id": 1721, "verse_number": "४-४४-९", "content_sanskrit": "आस्थाय विपुलं वीर रथं सारथिना मया।\nदुर्योधनं च जित्वाऽऽजौ निवर्तय पशून्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033491, "chapter_id": 1721, "verse_number": "४-४४-१०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033492, "chapter_id": 1721, "verse_number": "४-४४-१०", "content_sanskrit": "प्रीतोस्मि राजपुत्राद्य न भयं विद्यते तव।\nसर्वान्नुदामि ते शत्रून्रणे रणविशारद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033493, "chapter_id": 1721, "verse_number": "४-४४-११", "content_sanskrit": "स्वस्थो भव महान्युद्धे पश्य मां शत्रुभिः सह ।\nयुध्यमानं विमर्देऽस्मिन्कुर्वाणं भैरवं रवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033494, "chapter_id": 1721, "verse_number": "४-४४-१२", "content_sanskrit": "गाण्डीवं देवदत्तं च शरान्कनकभूषणान्।\nएतान्सर्वानुपासङ्गान्क्षिप्रं बध्नीहि मे रथे ।\nएकं चाहर निस्त्रिंशं जातरूपपरिष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033495, "chapter_id": 1721, "verse_number": "४-४४-१३", "content_sanskrit": "अहं वै कुरुभिर्योत्स्ये मोक्षयिष्यामि ते पशून् ।\nतोषयिष्यामि राजानं प्रवेक्ष्यामि पुरं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033496, "chapter_id": 1721, "verse_number": "४-४४-१४", "content_sanskrit": "संकल्पागाधपरिधं बाहुप्राकारतोरणम्।\nत्रिदण्डतूणसंबाधं नैकध्वजसमाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033497, "chapter_id": 1721, "verse_number": "४-४४-१५", "content_sanskrit": "ज्याक्षेपनिनदारावं नेमीनिनददुन्दुभिः ।\nशरजालवितानाढ्यमाक्ष्वेडितमहास्वनम् ।\nनगरं ते मया गुप्तं रथोपस्थं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033498, "chapter_id": 1721, "verse_number": "४-४४-१६", "content_sanskrit": "अधिष्ठितो मया सङ्ख्ये रथो गाण्डीवधन्विना ।\nअजय्यः शत्रुसैन्यानां वैराटे व्येतु ते भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033499, "chapter_id": 1721, "verse_number": "४-४४-१७x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033500, "chapter_id": 1721, "verse_number": "४-४४-१७", "content_sanskrit": "बहुना किं प्रलापेन शृणु मे परमं वचः।\nनाहं बिभेमि कौन्तेय साक्षादपि शतक्रतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033501, "chapter_id": 1721, "verse_number": "४-४४-१८", "content_sanskrit": "यमवायुकुबेरेभ्यो द्रोणभीष्मशतादपि ।\nबिभेमि नाहमेतेभ्यो जानामि त्वां स्थिरं युधि ।\nकेशवेनापि संग्रामे साक्षादिन्द्रेण वा समम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033502, "chapter_id": 1721, "verse_number": "४-४४-१९", "content_sanskrit": "इदं तु चिन्तयन्नेव परिमुह्यामि केवलम्।\nनिश्चयं नाधिगच्छामि नावगच्छामि किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033503, "chapter_id": 1721, "verse_number": "४-४४-२०", "content_sanskrit": "एवं वराङ्गरूपस्य लक्षणैः सूचितस्य च।\nकेन कर्मविपाकेन क्लीबत्वं त्वामुपागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033504, "chapter_id": 1721, "verse_number": "४-४४-२१", "content_sanskrit": "मन्ये त्वां क्लीबरूपेण चरन्तं शूलपाणिनम्।\nगन्धर्वराजप्रतिमं देवं वाऽपि शतक्रतुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033505, "chapter_id": 1721, "verse_number": "४-४४-२२x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033506, "chapter_id": 1721, "verse_number": "४-४४-२२", "content_sanskrit": "भ्रातुर्नियोगाञ्ज्येष्ठस्य संवत्सरमिदं व्रतम्।\nचरामि ब्रह्मचर्यं वै सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033507, "chapter_id": 1721, "verse_number": "४-४४-२३", "content_sanskrit": "नास्मि क्लीबो महाबाहो परवान्धर्मसंयुतः ।\nउर्वशीशापसंभूतं क्लैब्यं समुपसंस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033508, "chapter_id": 1721, "verse_number": "४-४४-२४", "content_sanskrit": "पुराऽहमाज्ञया भ्रातुर्ज्येष्ठस्यास्मि सुरालयम्।\nप्राप्तवानुर्वशी दृष्टा सुधर्मायां मया तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033509, "chapter_id": 1721, "verse_number": "४-४४-२५", "content_sanskrit": "नृत्यन्तीं परमं रूपं बिभ्रतीं वज्रिसन्निधौ ।\nअपश्यं तामनिमिषं कूटस्थामन्वयस्य मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033510, "chapter_id": 1721, "verse_number": "४-४४-२६", "content_sanskrit": "रात्रौ समागता मह्यं शयनं रन्तुमिच्छया।\nअहं तामभिवाद्यैव मातृसत्कारमाचरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033511, "chapter_id": 1721, "verse_number": "४-४४-२७", "content_sanskrit": "सा च मामशपत्क्रुद्धा शिखण्डी त्वं भवेति वै।\nश्रुत्वा तमिन्द्रो मामाह मा भैस्त्वं पार्थ षण्डता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033512, "chapter_id": 1721, "verse_number": "४-४४-२८", "content_sanskrit": "उपकारो भवेत्तुभ्यमज्ञातवसतौ पुरा।\nइतीन्द्रो मामनुग्राह्य ततः प्रेषितवान्वृषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033513, "chapter_id": 1721, "verse_number": "४-४४-२९", "content_sanskrit": "तदिदं समनुप्राप्तं व्रतं चीर्णं मयाऽनघ ।\nसमाप्तव्रतमुत्तीर्णं विद्धि मां त्वं नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033514, "chapter_id": 1721, "verse_number": "४-४४-३०x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033515, "chapter_id": 1721, "verse_number": "४-४४-३०", "content_sanskrit": "परमोऽनुग्रहो मेऽद्य यत्प्रतर्को न मे वृथा।\nन हीदृशाः क्लीबरूपा भवन्ति तु नरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033516, "chapter_id": 1721, "verse_number": "४-४४-३१", "content_sanskrit": "सहायवानस्मि रणे युद्ध्येयममरैरपि ।\nसाध्वसं तत्प्रनष्टं मे किं करोमि ब्रवीहि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033517, "chapter_id": 1721, "verse_number": "४-४४-३२", "content_sanskrit": "अहं ते संग्रहीष्यामि हयाञ्शत्रुनिर्बहण।\nशिक्षितो ह्यस्मि सारथ्ये निष्ठितः पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2033518, "chapter_id": 1721, "verse_number": "४-४४-३३", "content_sanskrit": "दारुको वासुदेवस्य यथा शक्रस्य मातलिः।\nतथा मां विद्धि सारथ्ये शिक्षितं नरपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2033519, "chapter_id": 1721, "verse_number": "४-४४-३४", "content_sanskrit": "अश्वा ह्येते महाबाहो तवैवाहवदुर्जयाः।\nयोग्या रथवरे युक्ताः प्राणवन्तो जितश्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2033520, "chapter_id": 1721, "verse_number": "४-४४-३५", "content_sanskrit": "यस्य यातेन पश्यन्ति भूमौ क्षिप्तं पदंपदम्।\nदक्षिणां यो धुरं वोढा सुग्रीवोण समो हयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2033521, "chapter_id": 1721, "verse_number": "४-४४-३६", "content_sanskrit": "योऽयं हयो धुर्यवरो वामां वहति शोभनः।\nतं मन्ये मेघपुष्पस्य जवेन सदृशं हयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2033522, "chapter_id": 1721, "verse_number": "४-४४-३७", "content_sanskrit": "योऽयं वहति वै पार्ष्णिं दक्षिणामञ्चितोद्यतः ।\nवलाहकादभिमतस्तेजसा वीर्यवत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2033523, "chapter_id": 1721, "verse_number": "४-४४-३८", "content_sanskrit": "योऽयं काञ्चनसन्नाहो वामं वहति शोभनः ।\nधुर्यं शैब्यस्य तं मन्ये जवेन बलवत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2033524, "chapter_id": 1721, "verse_number": "४-४४-३९", "content_sanskrit": "त्वामेवायं रथो वोढुं संग्रामेऽर्हति धन्विनम् ।\nत्वं चे.. रथमास्थाय योद्धुमर्हो मतो मम।\nशर्वशत्रुभिरायातो देवराज इवासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2033525, "chapter_id": 1721, "verse_number": "४-४४-४०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2033526, "chapter_id": 1721, "verse_number": "४-४४-४०", "content_sanskrit": "ततो रथादवस्कन्द्य वीर्यवानरिमर्दनः।\nप्रणम्य देवान्गाण्डीवमादाय रुरुचे श्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2033527, "chapter_id": 1721, "verse_number": "४-४४-४१", "content_sanskrit": "ततो विमुच्य बाहुभ्यां सङ्खचूडानि पाण्डवः ।\nतौ च दुन्दुभिसन्नादौ प्रतिबद्ध्य तलावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2033528, "chapter_id": 1721, "verse_number": "४-४४-४२", "content_sanskrit": "इन्द्रदत्ते च ते दिव्ये उद्धृत्यामुच्य कुण्डले ।\nश्लक्ष्णान्केशान्मृदून्स्निग्धाञ्श्वेतेनोद्ग्रथ्य वाससा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2033529, "chapter_id": 1721, "verse_number": "४-४४-४३", "content_sanskrit": "अथासौ प्राङ्मुखो भूत्वा शुचिः प्रयतमानसः।\nअभिदध्यौ महाबाहुः सर्वास्त्राणि रथोत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2033530, "chapter_id": 1721, "verse_number": "४-४४-४४", "content_sanskrit": "ऊचुश्च पार्थं सर्वाणि प्राञ्जलीनि नृपात्मजम्।\nइमानि स्मो महोदार किङ्कराणीन्द्रनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2033531, "chapter_id": 1721, "verse_number": "४-४४-४५", "content_sanskrit": "प्रणिपत्य ततः पार्थः समालभ्य च पाणिना।\nसर्वाणि मानसानीह भवतेत्यभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2033532, "chapter_id": 1721, "verse_number": "४-४४-४६", "content_sanskrit": "प्रतिगृह्य ततोऽस्त्राणि प्रह्लष्टवदनोऽभवत् ।\nअधिज्यं तरसा कृत्वा गाण्डीवं व्याक्षिपद्धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2033533, "chapter_id": 1721, "verse_number": "४-४४-४७", "content_sanskrit": "तस्य विक्षिप्यमाणस्य धनुषोऽभून्महास्वनः ।\nयथा शैलस्य महतः शैलानाक्षिप्य जघ्रुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2033534, "chapter_id": 1721, "verse_number": "४-४४-४८", "content_sanskrit": "सनिर्घाताऽभवद्भूमिर्दिक्षु वायुर्ववौ भृशम्।\nभ्रान्तद्विजं खमभवत्प्राकम्पन्त महाद्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2033535, "chapter_id": 1721, "verse_number": "४-४४-४९", "content_sanskrit": "तं शब्दं कुरवो राजन्विस्फोटमशनेरिव।\nतार्क्ष्यं शब्दमिव श्रुत्वा वित्रेसुर्दीनमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2033536, "chapter_id": 1721, "verse_number": "४-४४-५०", "content_sanskrit": "यथेन्द्रो व्याक्षिपद्भीमं विस्फोटमशनेर्भुवि ।\nतथाऽर्जुनो धनुःश्रेष्ठं बाहुभ्यामाक्षिपद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2033537, "chapter_id": 1721, "verse_number": "४-४४-५१", "content_sanskrit": "महाशनिमहाशब्दसदृशो ज्यास्वनो महान् ।\nशत्रून्वीरांश्च संतर्ज्य निग्रहस्थो रथे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2033538, "chapter_id": 1721, "verse_number": "४-४४-५२x", "content_sanskrit": "उत्तर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2033539, "chapter_id": 1721, "verse_number": "४-४४-५२", "content_sanskrit": "एकस्त्वं पाण्डवश्रेष्ठ बहूनोतान्महारथान्।\nकथं जेष्यसि संग्रामे सर्वशस्त्रास्त्रपारगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2033540, "chapter_id": 1721, "verse_number": "४-४४-५३", "content_sanskrit": "असहायो।सि कोन्तेय ससहायाश्च कौरवाः ।\nअत एव महाबाहो भीतस्तिष्ठामि तेऽग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2033541, "chapter_id": 1721, "verse_number": "४-४४-५४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2033542, "chapter_id": 1721, "verse_number": "४-४४-५४", "content_sanskrit": "उवाच पार्थो मा भैषीः प्रहस्य स्वनवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2033543, "chapter_id": 1721, "verse_number": "४-४४-५५", "content_sanskrit": "युध्यमानस्य मे वीर गन्धर्वैः सुमहाबलैः ।\nसहायो घोषयात्रायां कस्तदासीत्सखा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2033544, "chapter_id": 1721, "verse_number": "४-४४-५६", "content_sanskrit": "तथा प्रतिभये तस्मिन्देवदानवसंकुले।\nखाण्डवे युध्यमानस्य कस्तदासीत्सखा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2033545, "chapter_id": 1721, "verse_number": "४-४४-५७", "content_sanskrit": "निवातकवचैः सार्धं पौलोमैश्च महाबलैः ।\nयुध्यतो देवराजार्थे कः सहायस्तदाऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2033546, "chapter_id": 1721, "verse_number": "४-४४-५८", "content_sanskrit": "स्वयंवरे तु पाञ्चाल्या राजभिः सह संयुगे।\nयुध्यतो बहुभिस्तात कः सहायस्तदाऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2033547, "chapter_id": 1721, "verse_number": "४-४४-५९", "content_sanskrit": "उपजीव्य गुरुं द्रोणं शुक्रं वैश्रवणं यमम्।\nवरुणं पावकं चैव कृपं कृष्णं च माधवम् ।\nपिनाकपाणिनं चैव कथमेतान्न योधये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2033548, "chapter_id": 1721, "verse_number": "४-४४-६०", "content_sanskrit": "रथं वाहय मे शीघ्रं व्येतु ते मानसो ज्वरः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2033549, "chapter_id": 1721, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि चतुश्चत्वारिंशोऽध्ययः ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]