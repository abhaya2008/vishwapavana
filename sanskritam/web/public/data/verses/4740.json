[{"id": 2176963, "chapter_id": 4740, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176964, "chapter_id": 4740, "verse_number": "१", "content_sanskrit": "कृपस्य वचनं श्रुत्वा धर्मार्थसहितं हितम् ।\nअश्वत्थामा महाराज दुःखशोकसमन्वितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176965, "chapter_id": 4740, "verse_number": "२", "content_sanskrit": "दह्यमानश्च शोकेन प्रदीप्तेनाग्निना यथा ।\nक्रूरं मनस्तथा कृत्वा तावुभौ प्रत्यभाषत\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176966, "chapter_id": 4740, "verse_number": "", "content_sanskrit": "द्रौणिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176967, "chapter_id": 4740, "verse_number": "३", "content_sanskrit": "पुरुषे पुरुषे बुद्धिः सा सा भवति शोभना ।\nतुष्यन्ति च पृथक् सर्वे प्रज्ञया तु स्वया स्वया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176968, "chapter_id": 4740, "verse_number": "४", "content_sanskrit": "सर्वो हि मन्यते लोक आत्मानं बुद्धिमत्तरम् ।\nसर्वस्यात्मा बहुमतः सर्वो त्मानं प्रशंसति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176969, "chapter_id": 4740, "verse_number": "५", "content_sanskrit": "सर्वस्य तु स्वका प्रज्ञा साधुवादे प्रतिष्ठिता ।\nपरबुद्धिं च निन्दन्ति स्वां प्रशंसन्ति चासकृत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176970, "chapter_id": 4740, "verse_number": "६", "content_sanskrit": "कारणान्तरयोगेन येषां संवदते मतिः ।\nतेऽन्योन्येन च तुष्यन्ति बहुमन्यन्ति चासकृत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176971, "chapter_id": 4740, "verse_number": "७", "content_sanskrit": "तस्यैव तु मनुष्यस्य सा सा बुद्धिस्तथा तथा ।\nकालयोगविपर्यासं प्राप्यान्योन्यं विपद्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176972, "chapter_id": 4740, "verse_number": "८", "content_sanskrit": "विचित्रत्त्वात्तु चित्तानां मनुष्याणां विशेषतः ।\nचित्तवैकल्यमासाद्य सा सा मतिरजायत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176973, "chapter_id": 4740, "verse_number": "९", "content_sanskrit": "यथा हि वैद्यः कुशलो व्याधिं ज्ञात्वा यथाविधि ।\nभेषजं कुरुते योगात् प्रशमार्थमिहाभिभो\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176974, "chapter_id": 4740, "verse_number": "१०", "content_sanskrit": "एवं कार्यस्य योगार्थं बुद्धिं कुर्वन्ति मानवाः ।\nप्रज्ञया च स्वया युक्त्या तां च गृह्णन्ति वै बुधाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176975, "chapter_id": 4740, "verse_number": "११", "content_sanskrit": "अन्यथा यौवने बाल्ये बुद्ध्या भवति मोहितः ।\nमध्येऽन्यथा जरायां तु सोऽन्यां रोचयते मतिम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176976, "chapter_id": 4740, "verse_number": "१२", "content_sanskrit": "व्यसनं वा महाघोरं समृद्धिं वाऽपि तादृशीम् ।\nअवाप्य पुरुषो भोज कुरुते बुद्धिवैकृतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176977, "chapter_id": 4740, "verse_number": "१३", "content_sanskrit": "एकस्मिन्नेव पुरुषे सा सा बुद्धिस्तथा तथा ।\nभवत्यनित्या प्रज्ञा हि सा तस्यैव न रोचते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176978, "chapter_id": 4740, "verse_number": "१४", "content_sanskrit": "निश्चित्य तु तथा प्राज्ञः स्वां मतिं साधु पश्यति ।\nतस्यां प्रकुरुते भावं सा चास्योद्योगकारिका\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176979, "chapter_id": 4740, "verse_number": "१५", "content_sanskrit": "सर्वो हि पुरुषो भोज साधुरित्येव निश्चितः ।\nकर्तुमारभते प्रीतिं मरणादिषु कर्मसु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176980, "chapter_id": 4740, "verse_number": "१६", "content_sanskrit": "सर्वो हि युक्तिं विज्ञाय प्रज्ञां वाऽपि स्वकां नरः ।\nचेष्टते विविधां चेष्टां हितमित्येव चिन्तयन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176981, "chapter_id": 4740, "verse_number": "१७", "content_sanskrit": "उपजाता व्यसनजा येयमद्य मतिर्मम ।\nयुवयोस्तां प्रवक्ष्यामि सर्वेषां शोकनाशिनीम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176982, "chapter_id": 4740, "verse_number": "१८", "content_sanskrit": "प्रजापतिः प्रजाः सृष्ट्वा कर्म तासां विधाय च ।\nवर्णे वर्णे समाधत्त एकैकं गुणवत्तरम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176983, "chapter_id": 4740, "verse_number": "१९", "content_sanskrit": "ब्राह्मणे दममव्यग्रं क्षत्रिये तेज उत्तमम् ।\nदाक्ष्यं वैश्ये च शूद्रे च सर्ववर्णानुकूलताम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176984, "chapter_id": 4740, "verse_number": "२०", "content_sanskrit": "अदान्तो ब्राह्मणोऽसाधुर्निस्तेजाः क्षत्रियो मृतः ।\nअदक्षो निन्द्यते वैश्यः शूद्रश्च प्रतिकूलवान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176985, "chapter_id": 4740, "verse_number": "२१", "content_sanskrit": "सोऽस्मि जातः कुले श्रेष्ठे ब्राह्मणैरभिपूजिते ।\nमन्दभाग्यतयाऽस्मीमं क्षत्रधर्ममनुष्ठितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176986, "chapter_id": 4740, "verse_number": "२२", "content_sanskrit": "क्षत्रधर्मं विदित्वाऽहं यदि ब्राह्मणसंश्रितम् ।\nप्रकरिष्ये महत् कर्म न मे तत् साधुसम्मतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176987, "chapter_id": 4740, "verse_number": "२३", "content_sanskrit": "धारयित्वा धनुर्दिव्यं दिव्यान्यस्त्राणि चाहवे ।\nपितरं निहतं दृष्ट्वा किं नु वक्ष्यामि संसदि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176988, "chapter_id": 4740, "verse_number": "२४", "content_sanskrit": "सोऽहमद्य यथाकामं क्षत्रधर्ममवाप्य च ।\nयास्यामि पदवीं राज्ञः पितुश्चैव महाद्युतेः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176989, "chapter_id": 4740, "verse_number": "२५", "content_sanskrit": "अद्य स्वप्स्यन्ति पाञ्चाला विश्वस्ता जितकाशिनः ।\nविमुक्तयुग्यकवचा हर्षेण च समन्विताः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176990, "chapter_id": 4740, "verse_number": "२६", "content_sanskrit": "वयं जिता मताश्चैते श्रान्ता व्यायामनेन च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176991, "chapter_id": 4740, "verse_number": "२७", "content_sanskrit": "तेषां निशि प्रसुप्तानां स्वस्थाने शिबिरे स्वके ।\nअवस्कन्दं करिष्यामि शिबिरस्यातिदुष्करम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176992, "chapter_id": 4740, "verse_number": "२८", "content_sanskrit": "तानवस्कन्द्य शिबिरे प्रेतभूतानचेतसः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176993, "chapter_id": 4740, "verse_number": "२९", "content_sanskrit": "पाञ्चालेषु चरिष्यामि सूदयन्नद्य संयुगे ।\nपिनाकपाणिः सङ्क्रुद्धः स्वयं रुद्रः पशूनिव\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176994, "chapter_id": 4740, "verse_number": "३०", "content_sanskrit": "अद्याहं सर्वपाञ्चालान् निकृत्या च निहत्य च ।\nअर्दयिष्यामि सङ्क्रुद्धो रणे पाण्डुसुतांस्तथा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176995, "chapter_id": 4740, "verse_number": "३१", "content_sanskrit": "अद्याहं सर्वपाञ्चालैः कृत्वा भूमिं शरीरिणम् ।\nप्रहृत्यैकेन शस्त्रेण भविष्याम्यनृणः पितुः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176996, "chapter_id": 4740, "verse_number": "३२", "content_sanskrit": "दुर्योधनस्य कर्णस्य भीष्मसैन्धवयोरपि ।\nगमिष्यामि निशामेनां पदवीमद्य दुर्गमाम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176997, "chapter_id": 4740, "verse_number": "३३", "content_sanskrit": "अद्य पाञ्चालराजस्य धृष्टद्युम्नस्य वै निशि ।\nविरात्रे प्रमथिष्यामि पशोरिव शिरो बलात्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176998, "chapter_id": 4740, "verse_number": "३४", "content_sanskrit": "अद्य पाञ्चालपाण्डूनां शयितानां सुखं निशि ।\nखड्गेन निशिताग्रेण प्रमथिष्यामि गौतम\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176999, "chapter_id": 4740, "verse_number": "३५", "content_sanskrit": "अद्य पाञ्चालसेनां तां निहत्य निशि सौप्तिके ।\nकृत्यकृत्यः सुखी चैव भविष्यामि महामते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2177000, "chapter_id": 4740, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसौप्तिकपर्वणि द्रौणिना पाञ्चालहननं नाम तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2177001, "chapter_id": 4740, "verse_number": "", "content_sanskrit": "सौप्तिकपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]