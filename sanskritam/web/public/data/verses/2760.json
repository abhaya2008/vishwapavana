[{"id": 2082574, "chapter_id": 2760, "verse_number": "१२-२६५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082575, "chapter_id": 2760, "verse_number": "१२-२६५-१", "content_sanskrit": "इमे वै मानसाः सर्वे धर्मं प्रति विशङ्किताः।\nकोऽयं धर्मः कुतो धर्मस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082576, "chapter_id": 2760, "verse_number": "१२-२६५-२", "content_sanskrit": "धर्मस्त्वयमिहार्थः किममुत्रार्थोपि वा भवेत्।\nउभयार्थो हि वा धर्मस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082577, "chapter_id": 2760, "verse_number": "१२-२६५-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082578, "chapter_id": 2760, "verse_number": "१२-२६५-३", "content_sanskrit": "सदाचारः स्मृतिर्वेदास्त्रिविधं धर्मलक्षणम्।\nचतुर्थमर्थमप्याहुः कवयो धर्मलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082579, "chapter_id": 2760, "verse_number": "१२-२६५-४", "content_sanskrit": "अविध्युक्तानि कर्माणि व्यवस्यन्त्युप्तमूषरे।\nलोकयात्रार्थमेवेह धर्मस्य नियमः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082580, "chapter_id": 2760, "verse_number": "१२-२६५-५", "content_sanskrit": "उभयत्र सुखोदर्क इह चैव परत्र च।\nअलब्ध्वा निपुणं धर्मं पापः पापे प्रसज्जति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082581, "chapter_id": 2760, "verse_number": "१२-२६५-६", "content_sanskrit": "न च पापकृतः पापान्मुच्यन्ते केचिदापदि।\nअपापवादी भवति यथा भवति धर्मवित्।\nधर्मस्य निष्ठा स्वाचारस्तमेवाश्रित्य चावसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082582, "chapter_id": 2760, "verse_number": "१२-२६५-७", "content_sanskrit": "यथाधर्मसमाविष्टो धनं गृह्णाति तस्करः।\nरमते निर्हरस्तेनः परवित्तमराजके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082583, "chapter_id": 2760, "verse_number": "१२-२६५-८", "content_sanskrit": "यदास्य तद्धरन्त्यन्ये तदा राजानमिच्छति।\nतदा तेषां स्पृहयते ये वै तुष्टाः स्वकैर्धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082584, "chapter_id": 2760, "verse_number": "१२-२६५-९", "content_sanskrit": "अभीतः शुचिरभ्येति राजद्वारमशङ्कितः।\nन हि दुश्चरितं किंचिदन्तरात्मनि पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082585, "chapter_id": 2760, "verse_number": "१२-२६५-१०", "content_sanskrit": "सत्यस्य वचनं साधु न सत्याद्विद्यते परम्।\nसत्येन विधृतं सर्वं सर्वं सत्ये प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082586, "chapter_id": 2760, "verse_number": "१२-२६५-११", "content_sanskrit": "अपि पापकृतो रौद्राः सत्यं कृत्वा मिथःकृतम्।\nअद्रोहमविसंवादं प्रवर्तन्ते तदाश्रयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082587, "chapter_id": 2760, "verse_number": "१२-२६५-१२", "content_sanskrit": "ते चेन्मिथ्या धृतिं कुर्युर्विनश्येयुरसंशयम्।\nन हर्तव्यं परधनमिति धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082588, "chapter_id": 2760, "verse_number": "१२-२६५-१३", "content_sanskrit": "मन्यन्ते बलवन्तस्तं दुर्बलैः संप्रवर्तितम्।\nयदा नियतिदौर्बल्यमथैषामेव रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082589, "chapter_id": 2760, "verse_number": "१२-२६५-१४", "content_sanskrit": "न ह्यत्यन्तं बलयुता भवन्ति सुखिनोपि वा।\nतस्मादनार्जवे बुद्धिर्न कार्या ते कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082590, "chapter_id": 2760, "verse_number": "१२-२६५-१५", "content_sanskrit": "असाधुभ्योऽस्य न भयं न चौरेभ्यो न राजतः।\nअकिंचित्कस्यचित्कुर्वन्निर्भयः शुचिरावसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082591, "chapter_id": 2760, "verse_number": "१२-२६५-१६", "content_sanskrit": "सर्वतः शङ्कते स्तेनो मृगो ग्राममिवेयिवान्।\nबहुधाऽऽचरितं पापमन्यत्रैवानुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082592, "chapter_id": 2760, "verse_number": "१२-२६५-१७", "content_sanskrit": "मुदितः शुचिरभ्येति सर्वतो निर्भयः सदा।\nन हि दुश्चरितं किंचिदात्मनोऽन्येषु पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082593, "chapter_id": 2760, "verse_number": "१२-२६५-१८", "content_sanskrit": "दातव्यमित्ययं धर्म उक्तो भूतहिते रतैः।\nतं मन्यन्ते धनयुताः कृपणैः संप्रवर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082594, "chapter_id": 2760, "verse_number": "१२-२६५-१९", "content_sanskrit": "यदा नियतिकार्पण्यमथैपामव रोचते।\nधनवन्तोपि नात्यन्तं भवन्ति सुखिनोपि वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082595, "chapter_id": 2760, "verse_number": "१२-२६५-२०", "content_sanskrit": "यदन्यैर्विहितं नेच्छेदात्मनः कर्म पूरुषः।\nन तत्परेषु कुर्वीत जानन्नप्रियमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082596, "chapter_id": 2760, "verse_number": "१२-२६५-२१", "content_sanskrit": "योऽन्यस्य स्यादुपपतिः स कं किं वक्तुमर्हति।\nयदन्यस्य ततः कुर्यान्न मृष्येदिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082597, "chapter_id": 2760, "verse_number": "१२-२६५-२२", "content_sanskrit": "जीवितुं यः स्वयं चेच्छेत्कथं सोऽन्यं प्रघातयेत्।\nयद्यदात्मन इच्छेत तत्परस्यापि चिन्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082598, "chapter_id": 2760, "verse_number": "१२-२६५-२३", "content_sanskrit": "अतिरिक्तः संविभजेद्भोगैरन्यानकिंचनान्।\nएतस्मात्कारणाद्धात्रा कुसीदं संप्रवर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082599, "chapter_id": 2760, "verse_number": "१२-२६५-२४", "content_sanskrit": "यस्मिंस्तु देवाः समये सन्तिष्ठेरंस्तथा भवेत्।\nअथ चेल्लोभसमये स्थितिर्धर्मोऽपि शोभना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082600, "chapter_id": 2760, "verse_number": "१२-२६५-२५", "content_sanskrit": "सर्वं प्रियाभ्युपगतं पुण्यमाहुर्मनीषिणः।\nपश्यैतं लक्षणोद्देशं धर्माधर्मे युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082601, "chapter_id": 2760, "verse_number": "१२-२६५-२६", "content_sanskrit": "लोकसंग्रहसंयुक्तं विधात्रा विहितं पुरा।\nसूक्ष्मधर्मार्थनियतं सतां चरितमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082602, "chapter_id": 2760, "verse_number": "१२-२६५-२७", "content_sanskrit": "धर्मलक्षणमाख्यातमेतत्ते कुरुसत्तम।\nतस्मादनार्जवे बुद्धिर्न ते कार्या कथंचन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082603, "chapter_id": 2760, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चषष्ट्यधिकद्विशततमोऽध्यायः॥ २६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]