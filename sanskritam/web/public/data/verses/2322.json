[{"id": 2061891, "chapter_id": 2322, "verse_number": "८-४३-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061892, "chapter_id": 2322, "verse_number": "८-४३-१", "content_sanskrit": "युक्तं प्रविश्य पार्थानां सैन्यं कुर्वञ्जनक्षयम्।\nकर्णो राजानमभ्येत्य तन्ममाचक्ष्व स़ञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061893, "chapter_id": 2322, "verse_number": "८-४३-२", "content_sanskrit": "के च प्रवीराः पार्थानां युधि कर्णमवारयन्।\nकांश्च प्रमथ्याधिरथिर्युधिष्ठिरमपीडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061894, "chapter_id": 2322, "verse_number": "८-४३-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061895, "chapter_id": 2322, "verse_number": "८-४३-३", "content_sanskrit": "धृष्टद्युम्नमुखान्पार्थान्दृष्ट्वा कर्णो व्यवस्थितान्।\nसमभ्यधावत्त्वरितः पाञ्चालाञ्छत्रुकर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061896, "chapter_id": 2322, "verse_number": "८-४३-४", "content_sanskrit": "तं तूर्णमभिधावन्तं पाञ्चाला जितकाशिनः।\nप्रत्युद्ययुर्महात्मानं हंसाः सर इवोष्णगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061897, "chapter_id": 2322, "verse_number": "८-४३-५", "content_sanskrit": "ततः शङ्खसहस्राणां निःस्वनो हृदयङ्गमः।\nप्रादुरासीदुभयतो भेरीशब्दश्च दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061898, "chapter_id": 2322, "verse_number": "८-४३-६", "content_sanskrit": "नानाबाणनिनादश्च द्विपाश्वरथनिःस्वनः।\nसिंहनादश्च वीराणामभवद्दारुणस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061899, "chapter_id": 2322, "verse_number": "८-४३-७", "content_sanskrit": "साद्रिद्रुमार्णवा भूमिः सवाताम्बुदमम्बरम्।\nसार्केन्दुग्रहनक्षत्रा द्यौश्च व्यक्तं विघूर्णिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061900, "chapter_id": 2322, "verse_number": "८-४३-८", "content_sanskrit": "इति भूतानि तं शब्दं मेनिरे ते च विव्यथुः।\nयानि चाप्यल्पसत्वानि प्रायस्तानि मृतानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061901, "chapter_id": 2322, "verse_number": "८-४३-९", "content_sanskrit": "अथ कर्णो भृशं क्रुद्धः शीघ्रमस्त्रमुदीरयन्।\nजघान पाण्डवीं सेनामासुरीं मघवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061902, "chapter_id": 2322, "verse_number": "८-४३-१०", "content_sanskrit": "स पाण्डवबलं कर्णः प्रविश्य विसृजञ्छरान्।\nप्रभद्रकाणां प्रवरानहनत्सप्तसप्ततिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061903, "chapter_id": 2322, "verse_number": "८-४३-११", "content_sanskrit": "ततः सुपुङ्खैर्निशितैरथ श्रष्ठो रथेषुभिः।\nअवधीत्पञ्चविंशत्या पाञ्चालान्पञ्चविंशतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061904, "chapter_id": 2322, "verse_number": "८-४३-१२", "content_sanskrit": "सुवर्णपुङ्खैर्नाराचैः परकायविदारणैः।\nचेदिकानवधीद्वीरः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061905, "chapter_id": 2322, "verse_number": "८-४३-१३", "content_sanskrit": "तं तथा समरे कर्म कुर्वाणमतिमानुषम्।\nपरिवव्रुर्महाराज पाञ्चालानां रथव्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061906, "chapter_id": 2322, "verse_number": "८-४३-१४", "content_sanskrit": "ततः सन्धाय विशिखान्पञ्च भारत दुःसहान्।\nपाञ्चालानवधीत्पञ्च कर्णो वैकर्तनो वृषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061907, "chapter_id": 2322, "verse_number": "८-४३-१५", "content_sanskrit": "भानुदेवं चित्रसेनं सेनाबिन्दुं च भारत।\nतपनं शूरसेनं च पाञ्चालानहनद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061908, "chapter_id": 2322, "verse_number": "८-४३-१६", "content_sanskrit": "पाञ्चालेषु च शूरेषु वध्यमानेषु सायकैः।\nहाहाकारो महानासीत्पाञ्चालानां महाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061909, "chapter_id": 2322, "verse_number": "८-४३-१७", "content_sanskrit": "तेषां सह्क्रीडमानानां हाहाकारं प्रकुर्वताम्।\nपुनरेव च तान्कर्णो जघानाशु पतत्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061910, "chapter_id": 2322, "verse_number": "८-४३-१८", "content_sanskrit": "चक्ररक्षौ तु कर्णस्य पुत्रौ मारिष दुर्जयौ।\nसुषेणः सत्यसेनश्च त्यक्त्वा प्राणानयुध्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061911, "chapter_id": 2322, "verse_number": "८-४३-१९", "content_sanskrit": "पृष्ठगोप्ता तु कर्णस्य ज्येष्ठः पुत्रो महारथः।\nवृषसेनोऽन्वयात्कर्णं पृष्ठतः परिपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061912, "chapter_id": 2322, "verse_number": "८-४३-२०", "content_sanskrit": "धृष्टद्युम्नः सात्यकिश्च द्रौपदेया वृकोदरः।\nजनमेजयः शिखण्डी च प्रवीराश्च प्रभद्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061913, "chapter_id": 2322, "verse_number": "८-४३-२१", "content_sanskrit": "चेदिकेकयपाञ्चाला यमौ मात्स्याश्च दंशिताः।\nसमभ्यधावन्राधेयं जिघांसन्तः प्रहारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061914, "chapter_id": 2322, "verse_number": "८-४३-२२", "content_sanskrit": "त एनं विविधैः शस्त्रैः शरधाराभिरेव च।\nअभ्यवर्षन्विमर्दन्तं प्रावृषीवाम्बुदा गिरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061915, "chapter_id": 2322, "verse_number": "८-४३-२३", "content_sanskrit": "पितरं तु परीप्सन्तः कर्णपुत्राः प्रहारिणः।\nत्वदीयाश्चापरे राजन्वीरा वीरानवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061916, "chapter_id": 2322, "verse_number": "८-४३-२४", "content_sanskrit": "सुषेणो भीमसेनस्य च्छित्त्वा भल्लेन कार्मुकम्।\nनाराचैः सप्तबिर्विद्ध्वा हृदि भीमं ननाद ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061917, "chapter_id": 2322, "verse_number": "८-४३-२५", "content_sanskrit": "अथान्यद्वनुरादाय सुदृढं भीमविक्रमः।\nसज्यं वृकोदरः कृत्वा सुषेणस्याच्छिनद्वनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061918, "chapter_id": 2322, "verse_number": "८-४३-२६", "content_sanskrit": "विव्याध चैनं दशभिः क्रुद्धो नृत्यन्निवेषुभिः।\nकर्णं च तूर्णं विव्याध त्रिसप्तत्या शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061919, "chapter_id": 2322, "verse_number": "८-४३-२७", "content_sanskrit": "सत्यसेनं च दशभिः साश्वसूतायुधध्वजम्।\nपश्यतां सुहृदां मध्ये कर्णपुत्रमपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061920, "chapter_id": 2322, "verse_number": "८-४३-२८", "content_sanskrit": "क्षुरप्रणुन्नं तत्तस्य शिरश्चन्द्रनिभाननम्।\nशुभदर्शनमेवासीन्नालभ्रष्टमिवाम्बुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061921, "chapter_id": 2322, "verse_number": "८-४३-२९", "content_sanskrit": "हत्वा कर्णसुतं भीमस्तावकान्पुनरार्दयत्।\nकृपहार्दिक्ययोश्छित्त्वा चापौ तावप्यथार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061922, "chapter_id": 2322, "verse_number": "८-४३-३०", "content_sanskrit": "दुःशासनं त्रिभिर्विद्ध्वा शकुनिं षड्भिरायसैः।\nउलूकं च पतत्रिं च चकार विरथावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061923, "chapter_id": 2322, "verse_number": "८-४३-३१", "content_sanskrit": "हे सुषेण हतोऽसीति ब्रुवन्नादत्त सायकम्।\nतमस्य कर्णश्चिच्छेद त्रिभिश्चैनमताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061924, "chapter_id": 2322, "verse_number": "८-४३-३२", "content_sanskrit": "अथान्यं परिजग्राह सुपर्वाणं सुतेजनम्।\nसुषेणायासृजद्भीमस्तमप्यस्याच्छिनद्वृषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061925, "chapter_id": 2322, "verse_number": "८-४३-३३", "content_sanskrit": "पुनः कर्णस्त्रिसप्तत्या भीमसेनमथेषुभिः।\nपुत्रं परीप्सन्विव्याध क्रुद्धः शत्रुजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061926, "chapter_id": 2322, "verse_number": "८-४३-३४", "content_sanskrit": "सुषेणस्तु धनुर्गृह्य भारसाधनमुत्तमम्।\nनकुलंपञ्चभिर्बाणैर्बाह्वोरुरसि चार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061927, "chapter_id": 2322, "verse_number": "८-४३-३५", "content_sanskrit": "नकुलस्तं तु विंशत्या विद्व्वा भारसहैर्दृढैः।\nननाद बलवन्नादं कर्णस्य भयमादधत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061928, "chapter_id": 2322, "verse_number": "८-४३-३६", "content_sanskrit": "तं सुषेणो महाराज विद्ध्वा दशभिराशुगैः।\nचिच्छेद च धनुः शीघ्रं क्षुरप्रेण महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061929, "chapter_id": 2322, "verse_number": "८-४३-३७", "content_sanskrit": "अथान्यद्वनुरादाय नकुलः क्रोधमूर्च्छितः।\nसुषेणं नवभिर्बाणैर्वारयामास संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061930, "chapter_id": 2322, "verse_number": "८-४३-३८", "content_sanskrit": "स तु बाणैर्दिशो राजन्नाच्छाद्य परवीरहा॥\nआजघ्ने सारथिं चास्य सुषेणं च ततस्त्रिभिः।\nचिच्छेद चास्य सुदृढं धनुर्भल्लैस्त्रिभिस्त्रिधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061931, "chapter_id": 2322, "verse_number": "८-४३-३९", "content_sanskrit": "अथान्यद्वनुरादाय सुषेणः क्रोधमूर्च्छितः।\nआविध्यन्नकुलं षष्ट्या सहदेवं च सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061932, "chapter_id": 2322, "verse_number": "८-४३-४०", "content_sanskrit": "तद्युद्धं सुमहद्धोरमासीद्देवासुरोपमम्।\nनिघ्नतां सायकैस्तूर्णमन्योन्यस्य वधं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061933, "chapter_id": 2322, "verse_number": "८-४३-४१", "content_sanskrit": "सात्यकिर्वृषसेनं तु विद्ध्वा सप्तभिरायसैः।\n`पुनर्विव्याध सप्तत्या सारथिं च त्रिभिः शितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2061934, "chapter_id": 2322, "verse_number": "८-४३-४२", "content_sanskrit": "वृषसेनस्तु शैनेयं शरेणानतपर्वणा।\nआजघान महाराज शङ्खदेशे महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2061935, "chapter_id": 2322, "verse_number": "८-४३-४३", "content_sanskrit": "शैनेयो वृषसेनेन पत्रिणा परिपीडितः।\nकोपं चक्रे महाराज क्रुद्धो वेगं च दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2061936, "chapter_id": 2322, "verse_number": "८-४३-४४", "content_sanskrit": "जग्राहेषुवरान्वीरः शीघ्रं वै दश पञ्च च।\nसात्यकिर्वृषसेनस्य सूतं हत्वा त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2061937, "chapter_id": 2322, "verse_number": "८-४३-४५", "content_sanskrit": "धनुश्चिच्छेद भल्लेन जघानाश्वांश्च सप्तभिः।\nध्वजमेकेषुणोन्मथ्य त्रिभिश्तं हृद्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2061938, "chapter_id": 2322, "verse_number": "८-४३-४६", "content_sanskrit": "अथावसन्नः स्वरथे मुहूर्तात्पुनरुत्थितः।\nस रणे युयुधानेन विसूताश्वरथध्वजः।\nकृतो जिघांसुः शैनेयं खङ्गचर्मधृगभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2061939, "chapter_id": 2322, "verse_number": "८-४३-४७", "content_sanskrit": "तस्य चापततः शीघ्रं वृषसेनस्य सात्यकिः।\nवाराहकर्णैर्दशभिरविध्यदसिचर्मणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2061940, "chapter_id": 2322, "verse_number": "८-४३-४८", "content_sanskrit": "दुःशासनस्तु तं दृष्ट्वा विरथं व्यायुधं कृतम्।\nआरोप्य स्वरथं तूर्णमपोवाह रथान्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2061941, "chapter_id": 2322, "verse_number": "८-४३-४९", "content_sanskrit": "अथान्यं रथमास्थाय वृषसेनो महारथः।\nद्रौपदेयांस्त्रिसप्तत्या युयुधानं च पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2061942, "chapter_id": 2322, "verse_number": "८-४३-५०", "content_sanskrit": "भीमसेनं चतुःषष्ट्या सहदेवं च पञ्चभिः।\nनकुलं त्रिंशता बाणैः शतानीकं च सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2061943, "chapter_id": 2322, "verse_number": "८-४३-५१", "content_sanskrit": "शिखण्डिनं च दशभिर्धर्मराजं शतेन च।\nएतांश्चान्यांश्च राजेन्द्र प्रवीराञ्चयगृद्धिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2061944, "chapter_id": 2322, "verse_number": "८-४३-५२", "content_sanskrit": "अभ्यर्दयन्महेष्वासः कर्णपुत्रो विशाम्पते।\nकर्णस्य युधि दुर्धर्षस्ततः पृष्ठमपालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2061945, "chapter_id": 2322, "verse_number": "८-४३-५३", "content_sanskrit": "युयुधानं च राधेयो नवैर्नवभिरायसैः।\nविसूताश्वरथं कृत्वा ललाटे त्रिभिरार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2061946, "chapter_id": 2322, "verse_number": "८-४३-५४", "content_sanskrit": "स त्वन्यं रथमास्थाय विधिवत्कल्पितं पुनः।\nयुयुधे पाण्डुभिः सार्धं कर्णस्य व्यधमद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2061947, "chapter_id": 2322, "verse_number": "८-४३-५५", "content_sanskrit": "धृष्टद्युम्नस्ततः कर्णमविध्यद्दशभिः शरैः।\nद्रौपदेयास्त्रिसप्तत्या युयुधानस्तु सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2061948, "chapter_id": 2322, "verse_number": "८-४३-५६", "content_sanskrit": "भीमसेनश्चतुःषष्ट्या सहदेवश्च सप्तिभिः।\nनकुलस्त्रिंशता बाणैः शतानीकस्तु सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2061949, "chapter_id": 2322, "verse_number": "८-४३-५७", "content_sanskrit": "शिखण्डी दशभिर्वीरो धर्मराजः शतेन तु।\nएते चान्ये च राजेन्द्र प्रवीरा जयगृद्विनः।\nअभ्यर्दयन्महेष्वासं सूतपुत्रं महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2061950, "chapter_id": 2322, "verse_number": "८-४३-५८", "content_sanskrit": "तान्सूतपुत्रो विशिखैर्दशभिर्दशभिः शरैः।\nरथेनानुचरन्वीरः प्रत्यविध्यदरिन्दमः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2061951, "chapter_id": 2322, "verse_number": "८-४३-५९", "content_sanskrit": "`सात्यकिं भीमसेनं च धृष्टद्युम्नं शिखण्डिनम्।\nद्रौपदेयांश्च संरब्धान्यतमानान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2061952, "chapter_id": 2322, "verse_number": "८-४३-६०", "content_sanskrit": "पश्यतां सर्वसैन्यानामथैनान्सूतनन्दनः।\nविरथान्रथिनः श्रेष्ठान्निमेषार्धाच्चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2061953, "chapter_id": 2322, "verse_number": "८-४३-६१", "content_sanskrit": "अमोघत्वाच्च बाणानां भूतसङ्घा विसिप्मयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2061954, "chapter_id": 2322, "verse_number": "८-४३-६२", "content_sanskrit": "तत्रास्त्रवीर्यं कर्णस्य लाघवं च महात्मनः।\nअपश्याम महाभाग तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2061955, "chapter_id": 2322, "verse_number": "८-४३-६३", "content_sanskrit": "न ह्याददानं ददृशुः सन्दधानं च सायकान्।\nविमुञ्चन्तं च संरम्भाद पश्यन्नैव तं जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2061956, "chapter_id": 2322, "verse_number": "८-४३-६४", "content_sanskrit": "प्रतीच्यां दिशि तं दृष्ट्वा प्राच्यां पश्याम लाघवात्।\nन च पश्याम राजेन्द्र क्व नु कर्णो व्यतिष्ठत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2061957, "chapter_id": 2322, "verse_number": "८-४३-६५", "content_sanskrit": "इषूनेवास्य पश्यामो विनिकीर्णाऽन्समन्ततः।\nछादयानान्दिशो राजञ्शलभानामिव व्रजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2061958, "chapter_id": 2322, "verse_number": "८-४३-६६", "content_sanskrit": "तस्य तैरिषुभिस्त्रीक्ष्णैः सम्पतद्भिः सहस्रशः।\nमरीचिभिरिवोष्णांशोः शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2061959, "chapter_id": 2322, "verse_number": "८-४३-६७", "content_sanskrit": "व्याप्ताः सर्वा दिशो राजन्योधाश्च ददृशुस्तदा।\nशरैः संवृतमाकाशं तत्राभ्रैरिव चाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2061960, "chapter_id": 2322, "verse_number": "८-४३-६८", "content_sanskrit": "द्यौर्वियद्भूर्दिशश्चैव प्रच्छन्ना निशितैः शरैः।\nअरुणाभ्रावृताकारं तस्मिन्देशे बभौ वियत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2061961, "chapter_id": 2322, "verse_number": "८-४३-६९", "content_sanskrit": "ततः पुनरमेयात्मा कर्णो राजा महारथः।\nन्यहनत्समरे योधान्योधवृत्तमनुष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2061962, "chapter_id": 2322, "verse_number": "८-४३-७०", "content_sanskrit": "नृत्यन्निव हि राधेयश्चापहस्तो रणाजिरे।\nयैर्विद्वः प्रत्यविद्व्यत्तानेकैकं त्रिगुणैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2061963, "chapter_id": 2322, "verse_number": "८-४३-७१", "content_sanskrit": "शतैश्च दशभिश्चैतान्पुनर्विद्ध्वा ननाद च।\nसाश्वसूतध्वजच्छत्रास्ततस्ते विवरं ददुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2061964, "chapter_id": 2322, "verse_number": "८-४३-७२", "content_sanskrit": "`ते हन्यमानाः कर्णेन पलायन्त दिशो दश।\nनादयन्तो दिशः सर्वाः कर्मत्रस्ता विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2061965, "chapter_id": 2322, "verse_number": "८-४३-७३", "content_sanskrit": "तान्प्रमथ्य महेष्वासान्राधेयः शरवृष्टिभिः।\nराजानीकमसम्बाधं प्राविशच्छत्रुकर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2061966, "chapter_id": 2322, "verse_number": "८-४३-७४", "content_sanskrit": "स रथांस्त्रिशतं हत्वा चेदीनामनिवर्तिनाम्।\nराधेयो निशितैर्बाणैस्ततोऽभ्यागाद्युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2061967, "chapter_id": 2322, "verse_number": "८-४३-७५", "content_sanskrit": "`ततस्ते विरथाः शूरा रथानन्यान्समास्थिताः।\nपरिवव्रुर्महाराज धर्मपुत्रं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2061968, "chapter_id": 2322, "verse_number": "८-४३-७६", "content_sanskrit": "ततस्ते तु परे राजञ्छिखण्डी च ससात्यकिः।\nराधेयात्परिरक्षन्तो राजानं पर्यवारयन्।\nमुञ्चन्तो विविधान्बाणान्स्वर्णपुङ्खाञ्शिलाशितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2061969, "chapter_id": 2322, "verse_number": "८-४३-७७", "content_sanskrit": "तथैव तावकाः सर्वे कर्णं दुर्वारणं रणे।\nयत्ताः शूरा महेष्वासाः पर्यरक्षन्त सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2061970, "chapter_id": 2322, "verse_number": "८-४३-७८", "content_sanskrit": "नानावादित्रघोषाश्च प्रादुरासन्विशाम्पते।\nसिंहनादश्च सञ्जज्ञे शूराणामभिगर्जताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2061971, "chapter_id": 2322, "verse_number": "८-४३-७९", "content_sanskrit": "ततः पुनः समाजग्मुरभीताः कुरुपाण्डवाः।\nयुधिष्ठिरमुखाः पार्थाः सूतपुत्रमुखा वयम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2061972, "chapter_id": 2322, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे त्रिचत्वारिंशोऽध्यायः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]