[{"id": 2117580, "chapter_id": 3531, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117581, "chapter_id": 3531, "verse_number": "१", "content_sanskrit": "एवं सम्प्राप्य राज्यं तदिन्द्रप्रस्थे तपोधन ।\nअत ऊर्ध्वं महाभाग किमकुर्वत पाण्डवाः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117582, "chapter_id": 3531, "verse_number": "२", "content_sanskrit": "पूर्व एव महात्मानः सर्वे मम पितामहाः ।\nद्रौपदी धर्मपत्नी च कथं तानन्ववर्तत \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117583, "chapter_id": 3531, "verse_number": "३", "content_sanskrit": "कथमासंश्च कृष्णायामेकस्यां ते नरर्षभाः ।\nवर्तमाना महेष्वासा नाभिद्यन्त परस्परम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117584, "chapter_id": 3531, "verse_number": "४", "content_sanskrit": "श्रोतुमिच्छाम्यहं त्वत्तो विस्तरेण तपोधन ।\nतेषां चेष्टितमन्योन्यं युक्तानां कृष्णया सह \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117585, "chapter_id": 3531, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117586, "chapter_id": 3531, "verse_number": "५", "content_sanskrit": "धृतराष्ट्राभ्यनुज्ञाता इन्द्रप्रस्थं प्रविश्य तत् ।\nरेमिरे पुरुषव्याघ्राः कृष्णया सह पाण्डवाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117587, "chapter_id": 3531, "verse_number": "६", "content_sanskrit": "प्राप्य राज्यं महातेजाः सत्यसन्धो युधिष्टिरः।\nपालयामास धर्मेण पृथिवीं भ्रातृभिः सह \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117588, "chapter_id": 3531, "verse_number": "७", "content_sanskrit": "जितारयो महाप्राज्ञाः सत्यधर्मपरायणाः ।\nमुदं परमिकां प्राप्तास्तत्रोषुः पाण्डुनन्दनाः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117589, "chapter_id": 3531, "verse_number": "८", "content_sanskrit": "कुर्वाणाः पौरकार्याणि सर्वाणि भरतर्षभ ।\nआसाञ्चक्रुर्महार्हेषु परार्घ्येष्वासनेषु च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117590, "chapter_id": 3531, "verse_number": "९", "content_sanskrit": "तेषु तत्रोपविष्टेषु पाण्डवेषु महात्मसु ।\nआययौ धर्मराजं तं द्रष्टुकामोऽथ नारदः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117591, "chapter_id": 3531, "verse_number": "१०", "content_sanskrit": "पथा नक्षत्रजुष्टेन सुपर्णचरितेन च ।\nचन्द्रसूर्यप्रकाशेन सेवितेन महर्षिभिः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117592, "chapter_id": 3531, "verse_number": "११", "content_sanskrit": "नभस्स्थलेन दिव्येन दुर्लभेनातपस्विनाम् ।\nभूतार्चितो भूतधरां राष्ट्रमन्दिरभूषिताम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117593, "chapter_id": 3531, "verse_number": "१२", "content_sanskrit": "अवेक्षमाणो द्युतिमानाजगाम यदृच्छया ।\nसर्ववेदान्तगो विप्रः सर्वविद्यासु पारगः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117594, "chapter_id": 3531, "verse_number": "१३", "content_sanskrit": "परेण तपसा युक्तो ब्राह्मेण तपसा वृतः ।\nनये नीतौ च निरतो विश्रुतश्च महामुनिः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117595, "chapter_id": 3531, "verse_number": "१४", "content_sanskrit": "परात् परतरं प्राप्तो धर्ममेवाभिजग्मिवान् ।\nअयोनिजश्च गदितः श्रुतिभिश्च महामुनिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117596, "chapter_id": 3531, "verse_number": "१५", "content_sanskrit": "भावितात्मा गतरजाः शान्तो मृदुर्ऋजुर्द्विजः ।\nधर्मेणाधिगतः सर्वैर्देवदानवमानुषैः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117597, "chapter_id": 3531, "verse_number": "१६", "content_sanskrit": "क्षीणः कर्मसु पापेषु भक्ष्येषु विविधेषु च ।\nसर्वथा कृतमर्यादो वेदेषु विविधेषु च \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117598, "chapter_id": 3531, "verse_number": "१७", "content_sanskrit": "शतशः सोमपा यज्ञे सदा पुण्यकृदग्निचित् ।\nऋक्सामयजुषां वेत्ता न्यायवृत्तान्तकोविदः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117599, "chapter_id": 3531, "verse_number": "१८", "content_sanskrit": "ऋजुरारोहवाञ्छल्को भूयिष्ठपथिकोऽनघः ।\nश्लक्ष्णया शिखयोपेतः सम्पन्नः परमत्विषा \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117600, "chapter_id": 3531, "verse_number": "१९", "content_sanskrit": "अवदाते च सुक्ष्मे च दिव्ये च रुचिरे शुभे ।\nमहेन्द्रदत्ते महती बिभ्रत् परमवाससी \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117601, "chapter_id": 3531, "verse_number": "२०", "content_sanskrit": "जम्बूनदमये दिव्ये गण्डूपदमुखे नवे ।\nअग्न्यर्कसदृशे दिव्ये धारयन् कुण्डले शुभे \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117602, "chapter_id": 3531, "verse_number": "२१", "content_sanskrit": "चित्रं राजतमुच्छ्रित्य च्छत्रं परमवर्चसम् ।\nप्राप्य द्रुष्प्रापमन्येन ब्रह्मवर्चसमुत्तमम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117603, "chapter_id": 3531, "verse_number": "२२", "content_sanskrit": "भवने भूमिपालस्य बृहस्पतिरिवाप्लुतः ।\nसंहितायां च सर्वेषां स्थितस्योपस्थितस्य च \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117604, "chapter_id": 3531, "verse_number": "२३", "content_sanskrit": "द्विपदस्य च धर्मस्य क्रमधर्मस्य पारगः ।\nगाथाः समनुसञ्जज्ञे साम्नां परमवल्गुना\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117605, "chapter_id": 3531, "verse_number": "२४", "content_sanskrit": "आत्मना सर्वमोक्षिभ्यः कृतिमान् कृत्यवित् तदा ।\nयजुर्धर्मे बहुविधे मतो मतिमतां वरः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117606, "chapter_id": 3531, "verse_number": "२५", "content_sanskrit": "विदिताचार्यसमयः च्छेत्ता निगमसंशयान् ।\nअर्थनिर्वचने नित्यं संशयच्छिदसंशयः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117607, "chapter_id": 3531, "verse_number": "२६", "content_sanskrit": "प्रकृत्या धर्मकुशलो नानाधर्मविशारदः ।\nलोपेनागमधर्मेण संयमेन च वृत्तिषु \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117608, "chapter_id": 3531, "verse_number": "२७", "content_sanskrit": "एकशब्दांश्च नानार्थानेकार्थांश्च पृथक्छ्रुतान् ।\nपृथगर्थाभिधानांश्च प्रयोगाणामवेक्षिता \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117609, "chapter_id": 3531, "verse_number": "२८", "content_sanskrit": "प्रमाणभूतो लोकेषु सर्वाधिकरणेषु च ।\nसर्ववर्णविकारेषु नित्यं सकलपूजितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117610, "chapter_id": 3531, "verse_number": "२९", "content_sanskrit": "स्वरे स्वरे च विविधे वृत्तेषु त्रिविधेषु च ।\nसमस्थानेषु सर्वेषु समाम्नातेषु धातुषु ।\nउद्देशानां समाख्याता सर्वमाख्यातमुद्दिशन् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117611, "chapter_id": 3531, "verse_number": "३०", "content_sanskrit": "अभिसन्धिषु सर्वज्ञः पदान्यङ्गान्यनुस्मरन् ।\nकालधर्मेण निर्दिष्टं यथार्थमविचारयन् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117612, "chapter_id": 3531, "verse_number": "३१", "content_sanskrit": "चिकीर्षितं च यो वेत्ता चर्करीतेन संयुतम् ।\nविभाषितं च समयं भाषितं हृदयङ्गमम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117613, "chapter_id": 3531, "verse_number": "३२", "content_sanskrit": "आत्मने च परस्मै च स्वरसंस्कारयोगवित् ।\nएषां स्वराणां वेत्ता च बोद्धा प्रवचनः स्वरान् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117614, "chapter_id": 3531, "verse_number": "३३", "content_sanskrit": "विज्ञाता चोक्तवाक्यानामेकतां बहुतां तथा ।\nबोद्धा हि विविधानर्थान् विविधांश्च व्यतिक्रमान् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2117615, "chapter_id": 3531, "verse_number": "३४", "content_sanskrit": "अभेदतश्च विधिना बहुशश्चापि भेदतः ।\nवञ्चनानां च विविधा देशानां च समीक्षिता\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2117616, "chapter_id": 3531, "verse_number": "३५", "content_sanskrit": "नानार्थकुशलस्तत्र तद्धितेषु च कृत्सु च ।\nपरिभूषयिता वाचां वर्णतः स्वरतोऽर्थतः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2117617, "chapter_id": 3531, "verse_number": "३६", "content_sanskrit": "प्रत्ययानां समाख्याता नियतं प्रतिधातुकम् ।\nपञ्च चाक्षरजातीनि स्वरसञ्ज्ञानि यानि च \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2117618, "chapter_id": 3531, "verse_number": "३७", "content_sanskrit": "वेत्ता नानार्थकुशलो गुणैरेवं विभूषितः ।\nनारदस्त्वथ देवर्षिराजगाम यदृच्छया \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2117619, "chapter_id": 3531, "verse_number": "३८", "content_sanskrit": "तमागतमृषिं दृष्ट्वा प्रत्युद्गम्याभिवाद्य च ।\nआसनं रुचिरं तस्मै स्वं ददौ स युधिष्ठिरः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2117620, "chapter_id": 3531, "verse_number": "३९", "content_sanskrit": "कृष्णाजिनोत्तरे तस्मिन्नुपविष्टो महानृषिः ।\nदेवर्षेरुपविष्टस्य स्वयमर्घ्यं यथाविधि \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2117621, "chapter_id": 3531, "verse_number": "४०", "content_sanskrit": "प्रादाद् युधिष्ठिरो राजा राज्यं चास्मै न्यवेदयत् ।\nप्रतिगृह्य तु तां पूजामृषिः प्रीतमना भवत् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2117622, "chapter_id": 3531, "verse_number": "४१", "content_sanskrit": "आशीर्भिर्वर्धयित्वा तु तमुवाचास्यतामिति ।\nनिषसादाभ्यनुज्ञातस्तदा राजा युधिष्ठिरः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2117623, "chapter_id": 3531, "verse_number": "४२", "content_sanskrit": "प्रेषयामास कृष्णायै भगवन्तमुपस्थितम् ।\nश्रुत्वैतद् द्रौपदी चैव शुचिर्भूत्वा समाहिता \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2117624, "chapter_id": 3531, "verse_number": "४३", "content_sanskrit": "जगाम तत्र यत्रास्ते नारदः सह पाण्डवैः ।\nतस्याभिवाद्य चरणौ देवर्षेर्धर्मचारिणी \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2117625, "chapter_id": 3531, "verse_number": "४४", "content_sanskrit": "कृताञ्जलिः सुसंवीता स्थिता वै द्रुपदात्मजा ।\nतस्याश्चापि स धर्मात्मा सत्यवागृषिसत्तमः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2117626, "chapter_id": 3531, "verse_number": "४५", "content_sanskrit": "आशिषो विविधाः प्रोक्त्वा राजपुत्र्यास्तु नारदः ।\nगम्यतामिति चोवाच भगवांस्तामनिन्दिताम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2117627, "chapter_id": 3531, "verse_number": "४६", "content_sanskrit": "गतायामथ कृष्णायां युधिष्ठिरपुरोगमान् ।\nविविक्ते पाण्डवान् सर्वानुवाच भगवानृषिः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2117628, "chapter_id": 3531, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2117629, "chapter_id": 3531, "verse_number": "४७", "content_sanskrit": "पाञ्चाली भवतामेका धर्मपत्नी यशस्विनी ।\nयथा वो नात्र भेदः स्यात् तथा नीतिर्विधीयताम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2117630, "chapter_id": 3531, "verse_number": "४८", "content_sanskrit": "सुन्दोपसुन्दौ ह्यसुरौ भ्रातरौ सहितावुभौ ।\nदेवैरवध्यावन्येषां त्रिषु लोकेषु विश्रुतौ \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2117631, "chapter_id": 3531, "verse_number": "४९", "content_sanskrit": "एकराज्यावेकगृहावेकशय्यासनावुभौ ।\nतिलोत्तमायास्तौ हेतोरन्योन्यमभिजघ्नतुः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2117632, "chapter_id": 3531, "verse_number": "५०", "content_sanskrit": "रक्ष्यतां सौहृदं तस्मादन्योन्यं प्रतिभाविकम् ।\nयथा वो नात्र भेदः स्यात् तत् कुरुष्व युधिष्ठिर \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2117633, "chapter_id": 3531, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2117634, "chapter_id": 3531, "verse_number": "५१", "content_sanskrit": "सुन्दोपसुन्दावसुरौ कस्य पुत्रौ महामुने ।\nउत्पन्नश्च कथं भेदः कथं चान्योन्यमघ्नताम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2117635, "chapter_id": 3531, "verse_number": "५२", "content_sanskrit": "अप्सरा देवकन्या वा कस्य वैषा तिलोत्तमा ।\nयस्याः कामेन सम्मत्तौ जघ्नतुस्तौ परस्परम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2117636, "chapter_id": 3531, "verse_number": "५३", "content_sanskrit": "एतत्सर्वं यथावृत्तं विस्तरेण तपोधन ।\nश्रोतुमिच्छामहे विप्र परं कौतूहलं हि नः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2117637, "chapter_id": 3531, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2117638, "chapter_id": 3531, "verse_number": "५४", "content_sanskrit": "शृणु मे विस्तरेणेममितिहासं पुरातनम् ।\nभ्रातृभिः सहितः पार्थ यथावृत्तं युधिष्ठिर \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2117639, "chapter_id": 3531, "verse_number": "२१०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nदशाधिकद्विशततमोऽध्यायः ॥२१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2117640, "chapter_id": 3531, "verse_number": "२", "content_sanskrit": "॥ इति राज्यलाभपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2117641, "chapter_id": 3531, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]