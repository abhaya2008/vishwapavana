[{"id": 2082233, "chapter_id": 2745, "verse_number": "१२-२५०-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082234, "chapter_id": 2745, "verse_number": "१२-२५०-१", "content_sanskrit": "प्रोक्ता गृहस्थवृत्तिस्ते विहिता या मनीषिभिः।\nतदनन्तरमुक्तं यत्तन्निबोध युधिष्ठिर॥\n`व्यासेन कथितं पूर्वं पुत्राय सुमहात्मने।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082235, "chapter_id": 2745, "verse_number": "१२-२५०-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082236, "chapter_id": 2745, "verse_number": "१२-२५०-२", "content_sanskrit": "क्रय----त्ववधृयैनां तृतीयां वृत्तिमुत्तमाम्।\nसंयोगव्रत----वानप्रस्थाश्रमौकसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082237, "chapter_id": 2745, "verse_number": "१२-२५०-३", "content_sanskrit": "श्रूयतां पुत्र भद्रं ते सर्वलोकाश्रमात्मनाम्।\nप्रेक्षापूर्वं यदा पत्त्येद्वलीपलितमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082238, "chapter_id": 2745, "verse_number": "१२-२५०-४", "content_sanskrit": "अपत्यस्यैव चापण्यं वनमेव तदाऽऽश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082239, "chapter_id": 2745, "verse_number": "१२-२५०-५", "content_sanskrit": "तृतीयमायुषो भागं वानप्रस्थाश्रमे वसेत्।\nतानेवाग्नीन्पस्त्विरेद्यजमानो दि--कसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082240, "chapter_id": 2745, "verse_number": "१२-२५०-६", "content_sanskrit": "निय------नियताराहः षष्ठभक्तो ---त्तवान।\nतदाग्रहात्रं तो --- यज्ञाङ्गां व सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082241, "chapter_id": 2745, "verse_number": "१२-२५०-७", "content_sanskrit": "अवैकृष्टं व्रीहियव नीवारे विघसानि च।\nहवींषि संप्रयच्छेत मखेष्वत्रापि पञ्चसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082242, "chapter_id": 2745, "verse_number": "१२-२५०-८", "content_sanskrit": "वानप्रस्खाश्रमेऽप्येताश्चतस्रो वृत्तयः स्मृताः।\nसद्यः प्रक्षालकाः केचित्केचिन्मासिकसंचयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082243, "chapter_id": 2745, "verse_number": "१२-२५०-९", "content_sanskrit": "वार्षिकं संचयं केचित्केतिद्द्वादशवार्षिकम्।\nकुर्वन्त्यतिथिपूजार्थं यज्ञतन्त्रार्थमेव वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082244, "chapter_id": 2745, "verse_number": "१२-२५०-१०", "content_sanskrit": "अभ्रावकाशा वर्षासु हेमन्ते जलसंश्रयाः।\nग्रीष्मे च पञ्चतपसः शश्वच्च मितभोजनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082245, "chapter_id": 2745, "verse_number": "१२-२५०-११", "content_sanskrit": "भूमौ विपरिवर्तन्ते तिष्ठन्ति प्रपदैरपि।\nस्थानासनैर्वर्तयन्ति स वनेष्वभिषिञ्चते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082246, "chapter_id": 2745, "verse_number": "१२-२५०-१२", "content_sanskrit": "दन्तोलूखलिकाः केचिदश्मकुट्टास्तथा परे।\nशुक्लपक्षे पिबन्त्येके यवागूं क्वथितां सकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082247, "chapter_id": 2745, "verse_number": "१२-२५०-१३", "content_sanskrit": "कृष्णपक्षे पिबन्त्यन्ये भुञ्जते वा यथागतम्।\nमूलैरेके फलैरेके पुष्पैरेके दृढव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082248, "chapter_id": 2745, "verse_number": "१२-२५०-१४", "content_sanskrit": "वर्तयन्ति यथान्यायं वैखानसमतं श्रिताः।\nएताश्चान्याश्च विविधा दीक्षास्तेषां मनीषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082249, "chapter_id": 2745, "verse_number": "१२-२५०-१५", "content_sanskrit": "चतुर्थश्चौपनिषदो धर्मः साधारणः स्मृतः।\nवानप्रस्थाद्गृहस्थाच्च ततोऽन्यः संप्रवर्तते।\nअस्मिन्नेव युगे तात वितैस्तत्वार्थदर्शिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082250, "chapter_id": 2745, "verse_number": "१२-२५०-१६", "content_sanskrit": "अगस्त्यः सप्तऋषयो मधुच्छन्दोऽधमर्षणः।\nसांकृतिः सुदिवातण्डिर्यथावासो कृतश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082251, "chapter_id": 2745, "verse_number": "१२-२५०-१७", "content_sanskrit": "अहोवीर्यस्तथा काव्यस्ताण्ड्यो मेधातिथिदुऽ।\nबलवान्कर्णनिर्वाकः शून्यपालः कृतश्रम-----।\nएते धर्मे सुविद्वांसस्ततः स्वर्गमुसागमन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082252, "chapter_id": 2745, "verse_number": "१२-२५०-१८", "content_sanskrit": "तात प्रत्यक्षधर्माणस्तथा काथवारा गणाः।\nऋषीणामुग्रतपसां धर्मनैपुणेदर्शिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082253, "chapter_id": 2745, "verse_number": "१२-२५०-१९", "content_sanskrit": "अन्ये चापरिमेयाश्च ब्राह्मणा वनमश्रितताः।\nवैखातसा वालखिल्याः सैकताच्च तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082254, "chapter_id": 2745, "verse_number": "१२-२५०-२०", "content_sanskrit": "कर्मभिस्ते निरानन्दा धर्मनित्या जितेन्द्रियाः।\nगताः प्रत्यक्षधर्माणस्ते सर्वे वनमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082255, "chapter_id": 2745, "verse_number": "१२-२५०-२१", "content_sanskrit": "अनक्षत्रास्त्वनाधृष्या दृश्यते ज्योतिषां गणाः।\nजरया च परिद्यूना व्याधिना च प्रपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082256, "chapter_id": 2745, "verse_number": "१२-२५०-२२", "content_sanskrit": "चतुर्थे चायुषः शेषे वानप्रस्थाश्रमं त्यजेत्।\nसाद्यस्कां संनिरुप्येष्टिं सर्ववेदसदक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082257, "chapter_id": 2745, "verse_number": "१२-२५०-२३", "content_sanskrit": "आत्मयाजी सोऽत्मरतिरात्मक्रीडात्मसंश्रयः।\nआत्मन्यग्नीन्समारोप्य त्यक्त्वा सर्वपरिग्रहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082258, "chapter_id": 2745, "verse_number": "१२-२५०-२४", "content_sanskrit": "साद्यस्कांश्च यजेद्यज्ञानिष्टीश्चैवेह सर्वदा।\nयदैव याजिनां यज्ञादात्मनीज्या प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082259, "chapter_id": 2745, "verse_number": "१२-२५०-२५", "content_sanskrit": "त्रींश्चैवाग्नींस्त्यजेत्सम्यगात्मन्येवात्ममोक्षणात्।\nप्राणेभ्यो यजुषां पञ्च षट् प्राश्नीयादकुत्सयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082260, "chapter_id": 2745, "verse_number": "१२-२५०-२६", "content_sanskrit": "केशलोमनखान्वाप्य वानप्रस्थो मुनिस्ततः।\nआश्रमादाश्रमं पुण्यं पूतो गच्छति कर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082261, "chapter_id": 2745, "verse_number": "१२-२५०-२७", "content_sanskrit": "अभयं सर्वभूतेभ्यो दत्त्वा यः प्रव्रजेद्द्विजः।\nलोकास्तेजोमयास्तस्य प्रेत्य चानन्त्यमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082262, "chapter_id": 2745, "verse_number": "१२-२५०-२८", "content_sanskrit": "सुशीलवृत्तो व्यपनीतकल्मषो\nनचेह नामुत्र च कर्तुमीहते।\nअरोपमोहो गतसन्धिविग्रहो\nभवेदुदासीनवदात्मविन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082263, "chapter_id": 2745, "verse_number": "१२-२५०-२९", "content_sanskrit": "यमेषु चैवानुगतेषु न व्यथे\nत्स्वशास्त्रमूत्राहुतिमन्त्रविक्रमः।\nभवेद्यथेष्टा गतिरात्मयाजिनो\nन संशयो धर्मपरे जितेन्द्रिये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082264, "chapter_id": 2745, "verse_number": "१२-२५०-३०", "content_sanskrit": "ततः परं श्रेष्ठमतीव सद्गुणै\nरधिष्ठितं त्रीनधिवृत्तिमुत्तमम्।\nचतुर्थमुक्तं परमाश्रमं शृणु\nप्रकीर्त्यमानं परमं परायणम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082265, "chapter_id": 2745, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोश्रधर्मपर्वणि पञ्चाशदधिकद्विशततमोऽध्यायः॥ २५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]