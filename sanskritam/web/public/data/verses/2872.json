[{"id": 2087971, "chapter_id": 2872, "verse_number": "१३-२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087972, "chapter_id": 2872, "verse_number": "१३-२-१", "content_sanskrit": "पितामह महाप्राज्ञ सर्वशास्त्रविशारद।\nश्रुतं मे महदाख्यानमिदं मतिमतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087973, "chapter_id": 2872, "verse_number": "१३-२-२", "content_sanskrit": "भूयस्तु श्रोतुमिच्छामि धर्मार्थसहितं नृप।\nकथ्यमानं त्वया किञ्चित्तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087974, "chapter_id": 2872, "verse_number": "१३-२-३", "content_sanskrit": "केन मृत्युर्गृहस्थेन धर्ममाश्रित्य निर्जितः।\nइत्येतद्धर्ममाचक्ष्व तत्त्वेनापि च पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087975, "chapter_id": 2872, "verse_number": "१३-२-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087976, "chapter_id": 2872, "verse_number": "१३-२-४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nयथा मृत्यर्गृहस्थेन धर्ममाश्रित्य निर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087977, "chapter_id": 2872, "verse_number": "१३-२-५", "content_sanskrit": "मनोः प्रजापते राजन्निक्ष्वाकुरभवत्सुतः।\nतस्य पुत्रशतं जज्ञे नृपतेः सूर्यवर्चसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087978, "chapter_id": 2872, "verse_number": "१३-२-६", "content_sanskrit": "दशमस्तस्य पुत्रस्तु दशाश्वो नाम भारत।\nमाहिष्मत्यामभूद्राजा धर्मात्मा सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087979, "chapter_id": 2872, "verse_number": "१३-२-७", "content_sanskrit": "दशाश्वस्य सुतस्त्वासीद्राजा परमधार्मिकः।\nसत्ये तपसि दाने च यस्य नित्यं रतं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087980, "chapter_id": 2872, "verse_number": "१३-२-८", "content_sanskrit": "मदिराश्व इति ख्यातः पृथिव्यां पृथिवीपतिः।\nधनुर्वेदे च वेदे च निरतो योऽभवत्सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087981, "chapter_id": 2872, "verse_number": "१३-२-९", "content_sanskrit": "मदिराश्वस्य पुत्रस्तु द्युतिमान्नाम पार्थिवः।\nमहाभागो महातेजा महासत्वो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087982, "chapter_id": 2872, "verse_number": "१३-२-१०", "content_sanskrit": "पुत्रो द्युतिमतस्त्वासीद्राजा परमधार्मिकः।\nसर्वलोकेषु विख्यातः सुवीरो नाम नामतः।\nधर्मात्मा कोशवांश्चापि देवराज इवापरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087983, "chapter_id": 2872, "verse_number": "१३-२-११", "content_sanskrit": "सुवीरस्य तु पुत्रोऽभूत्सर्वसङ्ग्रामदुर्जयः।\nदुर्जयो नाम विख्यातः सर्वशस्त्रभृतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087984, "chapter_id": 2872, "verse_number": "१३-२-१२", "content_sanskrit": "दुर्जयस्येन्द्रवपुषः पुत्रोऽग्निसदृशद्युतिः।\nदुर्योधनो नाम महान्राजा राजर्षिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087985, "chapter_id": 2872, "verse_number": "१३-२-१३", "content_sanskrit": "तस्येन्द्रसमवीर्यस्य सङ्ग्रामेष्वनिवर्तिनः।\nविषये वासवस्तस्य सम्यगेव प्रवर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087986, "chapter_id": 2872, "verse_number": "१३-२-१४", "content_sanskrit": "रत्नैर्धनैश्च पशुभिः सस्यैश्चापि पृथग्विधैः।\nनगरं विषयश्चास्य प्रतिपूर्णस्तदाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087987, "chapter_id": 2872, "verse_number": "१३-२-१५", "content_sanskrit": "न तस्य विषये चाभूत्कृपणो नापि दुर्गतः।\nव्याधितो वा कृशो वाऽपरि तस्मिन्नाभून्नरः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087988, "chapter_id": 2872, "verse_number": "१३-२-१६", "content_sanskrit": "सुदक्षिणो मधुरवागनसूयुर्जितेन्द्रियः।\nधर्मात्मा चानृशंसश्च विक्रान्तोऽथाविकत्थनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087989, "chapter_id": 2872, "verse_number": "१३-२-१७", "content_sanskrit": "यज्वा च दान्तो मेधावी ब्रह्मण्यः सत्यसङ्गरः।\nन चावमन्ता दाता च वेदवेदाङ्गपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087990, "chapter_id": 2872, "verse_number": "१३-२-१८", "content_sanskrit": "तं नर्मदा देवनदी पुण्या शीतजला शिवा।\nचकमे पुरुषव्याघ्रं स्वेन भावेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087991, "chapter_id": 2872, "verse_number": "१३-२-१९", "content_sanskrit": "तस्यां जज्ञे तदा नद्यां कन्या राजीवलोचना।\nनाम्ना सुदर्शना राजन्रूपेण च सुदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087992, "chapter_id": 2872, "verse_number": "१३-२-२०", "content_sanskrit": "तादृग्रूपा न नारीषु भूतपूर्वा युधिष्ठिर।\nदुर्योधनसुता यादृगभवद्वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087993, "chapter_id": 2872, "verse_number": "१३-२-२१", "content_sanskrit": "तामग्निश्चकमे साक्षाद्राजकन्यां सुदर्शनाम्।\nस्वरूपं दीप्तिमत्कृत्वा शरदर्कसमद्युति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087994, "chapter_id": 2872, "verse_number": "१३-२-२२", "content_sanskrit": "सा चाग्निशरणे राज्ञः शुश्रूषाकृतनिश्चया।\nनियुक्ता पितृसन्देशादारिराधयिषुः शिखिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087995, "chapter_id": 2872, "verse_number": "१३-२-२३", "content_sanskrit": "तस्या मनोहरं रूपं दृष्ट्वा देवो हुताशनः।\nमन्मथेन समादिष्टः पत्नीत्वे यतते मिथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087996, "chapter_id": 2872, "verse_number": "१३-२-२४", "content_sanskrit": "भज मामनवद्याङ्गि कामात्कमललोचने।\nरम्भोरु मृगशावाक्षि पूर्णचन्द्रनिभानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087997, "chapter_id": 2872, "verse_number": "१३-२-२५", "content_sanskrit": "तवेदं पद्मपत्राक्षं मुखं दृष्ट्वा मनोहरम्।\nभ्रूलताललितं कान्तमनङ्गो बाधते हि माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087998, "chapter_id": 2872, "verse_number": "१३-२-२६", "content_sanskrit": "ललाटं चन्द्ररेखाभं शिरोरुहविभूषितम्।\nदृष्ट्वा ते पत्रलेखान्तमनङ्गो बाधते भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087999, "chapter_id": 2872, "verse_number": "१३-२-२७", "content_sanskrit": "बालातपेन तुलितं सस्वेदपुलकोद्गमम्।\nबिम्बाधरोष्ठवदनं विबुद्धमिव पङ्कजम्।\nअतीव चारुविभ्रान्तं मदमावहते मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2088000, "chapter_id": 2872, "verse_number": "१३-२-२८", "content_sanskrit": "दन्तप्रकाशनियता वाणी तव सुरक्षिता।\nताम्रपल्लवसंकाशा जिह्वेयं मे मनोहरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2088001, "chapter_id": 2872, "verse_number": "१३-२-२९", "content_sanskrit": "समाः स्निग्धाः सुजाताश्च सहिताश्च द्विजास्तव।\nद्विजप्रिये प्रसीदस्व भज मां सुभगा ह्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2088002, "chapter_id": 2872, "verse_number": "१३-२-३०", "content_sanskrit": "मनोज्ञं सुकृतापाङ्गं मुखं तव मनोहरम्।\nस्तनौ ते संहतौ भीरु हाराभरणभूषितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2088003, "chapter_id": 2872, "verse_number": "१३-२-३१", "content_sanskrit": "पक्वबिल्वप्रतीकाशौ कर्कशौ सङ्गमक्षमौ।\nगम्भीरनाभिसुभगे भज मां वरवर्णिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2088004, "chapter_id": 2872, "verse_number": "१३-२-३२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2088005, "chapter_id": 2872, "verse_number": "१३-२-३२", "content_sanskrit": "सैवमुक्ता विरहिते पावकेन महात्मना।\nईषदाकम्पहृदया व्रीडिता वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2088006, "chapter_id": 2872, "verse_number": "१३-२-३३", "content_sanskrit": "नलु नाम कुलीनानां कन्यकानां विशेषतः।\nमाता पिता प्रभवतः प्रदाने बान्धवाश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2088007, "chapter_id": 2872, "verse_number": "१३-२-३४", "content_sanskrit": "पाणिग्रहणमन्त्रैश्च हुते चैव विभावसौ।\nसतां मध्ये निविष्टायाः कन्यायाः शरणं पतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2088008, "chapter_id": 2872, "verse_number": "१३-२-३५", "content_sanskrit": "साऽहं नात्मवशा देव पितरं वरयस्व मे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2088009, "chapter_id": 2872, "verse_number": "१३-२-३६", "content_sanskrit": "अथ नातिचिराद्राजा कालाद्दुर्योधनस्तदा।\nयज्ञसम्भारनिपुणान्मन्त्रीनाहूय चोक्तवान्।\nयज्ञं यक्ष्येऽहमिति वै सम्भारान्सम्भ्रियन्तु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2088010, "chapter_id": 2872, "verse_number": "१३-२-३७", "content_sanskrit": "ततः समाहिते तस्य यज्ञे ब्राह्मणसत्तमैः।\nविप्ररूपी हुतवहो नृपं कन्यामयाचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2088011, "chapter_id": 2872, "verse_number": "१३-२-३८", "content_sanskrit": "न तु राजा प्रदानाय तस्मै भावमकल्पयत्।\nदरिद्रश्चासवर्णश्च ममायमिति पार्थिवः।\nइति तस्मै न वै कन्यां दित्सां चक्रे नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2088012, "chapter_id": 2872, "verse_number": "१३-२-३९", "content_sanskrit": "अथ दीक्षामुपेतस्य यज्ञे तस्य महात्मनः।\nआहितो हवनार्थाय वेद्यामग्निः प्रणश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2088013, "chapter_id": 2872, "verse_number": "१३-२-४०", "content_sanskrit": "ततः स भीतो नृपतिर्भृशं प्रव्यथितेन्द्रियः।\nमन्त्रिणो ब्राह्मणांश्चैव पप्रच्छ किमिदं भवेत्।\nयज्ञे समिद्धो भगवान्नष्टो मे हव्यवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2088014, "chapter_id": 2872, "verse_number": "१३-२-४१", "content_sanskrit": "सम्मन्त्रकुशलैस्तैस्तैर्ब्राह्मणैर्वेदपारगैः।\nऋत्विग्भिर्मन्त्रकुशलैर्यज्यतां वा हुताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2088015, "chapter_id": 2872, "verse_number": "१३-२-४२", "content_sanskrit": "अथ ऋक्सामयजुषां ब्राह्मणैर्वेदपारगैः।\nवेदतत्वार्थकुशलैस्ततः सोमपुरस्करैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2088016, "chapter_id": 2872, "verse_number": "१३-२-४३", "content_sanskrit": "गुह्यैश्च नामभिः सर्वैराहूतो हव्यवाहनः।\nस्वरूपं दीप्तिमत्कृत्वा शरदर्कसमद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2088017, "chapter_id": 2872, "verse_number": "१३-२-४४", "content_sanskrit": "ततो महात्मा तानाह दहनो ब्राह्मणर्षभान्।\nवरयाम्यात्मनोऽर्थाय दुर्योधनसुतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2088018, "chapter_id": 2872, "verse_number": "१३-२-४५", "content_sanskrit": "ततस्ते कल्यमुत्थाय तस्मै राज्ञे न्यवेदयन्।\nब्राह्मणा विस्मिताः सर्वे यदुक्तं चित्रभानुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2088019, "chapter_id": 2872, "verse_number": "१३-२-४६", "content_sanskrit": "ततः स राजा तच्छ्रुत्वा वचनं ब्रह्मवादिनाम्।\nअवाप्य परमं हर्षं तथेति प्राह बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2088020, "chapter_id": 2872, "verse_number": "१३-२-४७", "content_sanskrit": "अयाचत च तं शुल्कं भगवन्तं विभावसुम्।\nनित्यं सान्निध्यमिह ते चित्रभानो भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2088021, "chapter_id": 2872, "verse_number": "१३-२-४८", "content_sanskrit": "तमाह भगवानग्निरेवमस्त्विति पार्थिवम्।\nततः सान्निध्यमद्यापि माहिष्मत्यां विभावसोः॥\nदृष्टं हि सहदेवेन दिशं विजयता च तत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2088022, "chapter_id": 2872, "verse_number": "१३-२-४९", "content_sanskrit": "ततस्तां समलङ्कृत्य कन्यामहतवाससम्।\nददौ दुर्योधनो राजा पावकाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2088023, "chapter_id": 2872, "verse_number": "१३-२-५०", "content_sanskrit": "प्रतिजग्राह चाग्निस्तु राजकन्यां सुदर्शनाम्।\nविधिना वेददृष्टेन वसोर्धारामिवाध्वरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2088024, "chapter_id": 2872, "verse_number": "१३-२-५१", "content_sanskrit": "तस्या रूपेण शीलेन कुलेन वपुषा श्रिया।\nअभवत्प्रीतिमानग्निर्गर्भं चास्यां समादधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2088025, "chapter_id": 2872, "verse_number": "१३-२-५२", "content_sanskrit": "तस्याः समभवत्पुत्रो नाम्नाऽग्नेयः सुदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2088026, "chapter_id": 2872, "verse_number": "१३-२-५३", "content_sanskrit": "सुदर्शनस्तु रूपेण पूर्णेन्दुसदृशोपमः।\nशिशुरेवाध्यगात्सर्वं परं ब्रह्म सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2088027, "chapter_id": 2872, "verse_number": "१३-२-५४", "content_sanskrit": "अथौघवान्नाम नृपो नृगस्यासीत्पितामहः।\nतस्याप्योघवती कन्या पुत्रश्चौघरथोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2088028, "chapter_id": 2872, "verse_number": "१३-२-५५", "content_sanskrit": "तामोघवान्ददौ तस्मै स्वयमोघवतीं सुताम्।\nसुदर्शनाय विदुषे भार्यार्थे देवरूपिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2088029, "chapter_id": 2872, "verse_number": "१३-२-५६", "content_sanskrit": "स गृहस्थाश्रमरतस्तया सह सुदर्शनः।\nकुरुक्षेत्रेऽवसद्राजन्नोघवत्या समन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2088030, "chapter_id": 2872, "verse_number": "१३-२-५७", "content_sanskrit": "गृहस्थश्चावजेष्यामि मृत्युमित्येव स प्रभो।\nप्रतिज्ञामकरोद्धीमान्दीप्ततेजा विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2088031, "chapter_id": 2872, "verse_number": "१३-२-५८", "content_sanskrit": "तामेवौघवतीं राजन्स पावकसुतोऽब्रवीत्।\nअतिथेः प्रतिकूलं ते न कर्तव्यं कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2088032, "chapter_id": 2872, "verse_number": "१३-२-५९", "content_sanskrit": "येनयेन च तुष्येत नित्यमेव त्वयाऽतिथिः।\nअप्यात्मनः प्रदानेन न ते कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2088033, "chapter_id": 2872, "verse_number": "१३-२-६०", "content_sanskrit": "एतद्व्रतं मम सदा हृदि सम्परिवर्तते।\nगृहस्थानां च सुश्रोणि नातिथेर्विद्यते परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2088034, "chapter_id": 2872, "verse_number": "१३-२-६१", "content_sanskrit": "प्रमाणं यदि वामोरु वचस्ते मम शोभने।\nइदं वचनमव्यग्रा हृदि त्वं धारयेः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2088035, "chapter_id": 2872, "verse_number": "१३-२-६२", "content_sanskrit": "निष्क्रान्ते मयि कल्याणि तथा सन्निहितेऽनघे।\nनातिथिस्तेऽवमन्तव्यः प्रमाणं यद्यहं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2088036, "chapter_id": 2872, "verse_number": "१३-२-६३", "content_sanskrit": "तमब्रवीदोघवती तथा मूर्ध्नि कृताञ्जलिः।\nन मे त्वद्वचनात्किञ्चिन्न कर्तव्यं कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2088037, "chapter_id": 2872, "verse_number": "१३-२-६४", "content_sanskrit": "जिगीषमाणस्तु गृहे तदा मृत्युः सुदर्शनम्।\nपृष्ठतोऽन्वगमद्राजन्रन्ध्रान्वेषी तदा सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2088038, "chapter_id": 2872, "verse_number": "१३-२-६५", "content_sanskrit": "इध्मार्थं तु गते तस्मिन्नग्रिपुत्रे सुदर्शने।\nअतिधिर्ब्राह्मणः श्रीमांस्तामाहौघवतीं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2088039, "chapter_id": 2872, "verse_number": "१३-२-६६", "content_sanskrit": "आतिथ्यं कृतमिच्छामि त्वयाऽद्य वरवर्णिनि।\nप्रमाणं यदि धर्मस्ते गृहस्थाश्रमसम्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2088040, "chapter_id": 2872, "verse_number": "१३-२-६७", "content_sanskrit": "इत्युक्ता तेन विप्रेणि राजपुत्री यशस्विनी।\nविधिना प्रतिजग्राह वेदोक्तेन विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2088041, "chapter_id": 2872, "verse_number": "१३-२-६८", "content_sanskrit": "आसनं चैव पाद्यं च तस्मै दत्त्वा द्विजातये।\nप्रोवाचौघवती विप्रं केनार्थः किं ददामि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2088042, "chapter_id": 2872, "verse_number": "१३-२-६९", "content_sanskrit": "तामब्रवीत्ततो विप्रो राजपुत्रीं सुदर्शनाम्।\nत्वया ममार्थः कल्याणि निर्विशङ्कैतदाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2088043, "chapter_id": 2872, "verse_number": "१३-२-७०", "content_sanskrit": "यदि प्रमाणं धर्मस्ते गृहस्थाश्रमसम्मतः।\nप्रदानेनात्मनो राज्ञि कर्तुमर्हसि मे प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2088044, "chapter_id": 2872, "verse_number": "१३-२-७१", "content_sanskrit": "स तया छन्द्यमानोऽन्यैरीप्सितैर्नृपकन्यया।\nनान्यमात्मप्रदानात्स तस्या वव्रे परं द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2088045, "chapter_id": 2872, "verse_number": "१३-२-७२", "content_sanskrit": "सा तु राजसुता स्मृत्वा भर्तुर्वचनमादितः।\nतथेति लज्जमाना सा तमुवाच द्विजर्षभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2088046, "chapter_id": 2872, "verse_number": "१३-२-७३", "content_sanskrit": "ततो विहस्य विप्रर्षिः सा चैवोपविवेश ह।\nसंस्मृत्य भर्तुर्वचनं गृहस्थाश्रमकाङ्क्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2088047, "chapter_id": 2872, "verse_number": "१३-२-७४", "content_sanskrit": "अथेध्मान्समुपादाय स पावकिरुपागमत्।\nमृत्युना रौद्रभावेन नित्यं बन्धुरिवान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2088048, "chapter_id": 2872, "verse_number": "१३-२-७५", "content_sanskrit": "ततस्त्वाश्रममागम्य स पावकसुतस्तदा।\nतां व्याजहारौघवतीं क्वासि यातेति चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2088049, "chapter_id": 2872, "verse_number": "१३-२-७६", "content_sanskrit": "तस्मै प्रतिवचः सा तु भर्त्रे न प्रददौ तदा।\nकराभ्यां तेन विप्रेण स्पृष्टा भर्तृव्रता सती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2088050, "chapter_id": 2872, "verse_number": "१३-२-७७", "content_sanskrit": "उच्छिष्टाऽस्मीति मन्वाना लज्जिता भर्तुरेव च।\nतूष्णींभूताऽभवत्साध्वी विप्रकोपाच्च शङ्किता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2088051, "chapter_id": 2872, "verse_number": "१३-२-७८", "content_sanskrit": "अथ तां किन्विति पुनः प्रोवाच स सुदर्शनः।\nक्व सा साध्वी क्व सायाता गरीय किमतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2088052, "chapter_id": 2872, "verse_number": "१३-२-७९", "content_sanskrit": "पतिव्रता सत्यशीला नित्यं चैवार्जवे रता।\nकथं न प्रत्युदेत्यद्य स्मयमाना यथापुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2088053, "chapter_id": 2872, "verse_number": "१३-२-८०", "content_sanskrit": "उटजस्थस्तु तं विप्रः प्रत्युवाच सुदर्शनम्।\nअतिथिं विद्धि सम्प्राप्तं ब्राह्मणं पावके च माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2088054, "chapter_id": 2872, "verse_number": "१३-२-८१", "content_sanskrit": "अनया छन्द्यमानोऽहं भार्यया तव सत्तम।\nतैस्तैरतिथिसत्कारैर्ब्रह्मन्नेषा वृता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2088055, "chapter_id": 2872, "verse_number": "१३-२-८२", "content_sanskrit": "आत्मप्रदानविधिना मामर्चति शुभानना।\nअनूरूपं यदत्रान्यत्तद्भवान्कर्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2088056, "chapter_id": 2872, "verse_number": "१३-२-८३", "content_sanskrit": "कूटमुद्गरहस्तस्तु मृत्युस्तं वै समन्वगात्।\nहीनप्रतिज्ञमत्रैवं वधिष्यामीति चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2088057, "chapter_id": 2872, "verse_number": "१३-२-८४", "content_sanskrit": "सुदर्शनस्तु मनसा कर्मणा चक्षुषा गिरा।\nत्यक्तेर्ष्यस्त्यक्तमन्युश्च स्मयमानोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2088058, "chapter_id": 2872, "verse_number": "१३-२-८५", "content_sanskrit": "सुरतं तेऽस्तु विप्राग्र्य प्रीतिर्हि परमा मम।\nगृहस्थस्य हि धर्मोऽग्र्यः सम्प्राप्तातिथिपूजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2088059, "chapter_id": 2872, "verse_number": "१३-२-८६", "content_sanskrit": "अतिथिः पूजितो यस्य गृहस्थस्य तु गच्छति।\nनान्यस्तस्मात्परो धर्म इति प्राहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2088060, "chapter_id": 2872, "verse_number": "१३-२-८७", "content_sanskrit": "प्राणाश्च मम दाराश्च यच्चान्यद्विद्यते वसु।\nअतिथिभ्यो मया देयमिति मे व्रतमाहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2088061, "chapter_id": 2872, "verse_number": "१३-२-८८", "content_sanskrit": "निःसन्दिग्धं यथा वाक्यमेतन्मे समुदाहृतम्।\nतेनाहं विप्र सत्येन स्वयमात्मानमालभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2088062, "chapter_id": 2872, "verse_number": "१३-२-८९", "content_sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्।\nबुद्धिरात्मा मनः कालो दिशश्चैव गुणा दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2088063, "chapter_id": 2872, "verse_number": "१३-२-९०", "content_sanskrit": "नित्यमेव हि पश्यन्ति देहिनां देहसंश्रिताः।\nसुकृतं दुष्कृतं चापि कर्म कर्मवतांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2088064, "chapter_id": 2872, "verse_number": "१३-२-९१", "content_sanskrit": "यथैषा नानृता वाणी मयाऽद्य समुदीरिता।\nतेन सत्येन मां देवाः पालयन्तु दहन्तु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2088065, "chapter_id": 2872, "verse_number": "१३-२-९२", "content_sanskrit": "ततो नादः समभवद्दिक्षु सर्वासु भारत।\nअसकृत्सत्यमित्येवं नैतन्मिथ्येति सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2088066, "chapter_id": 2872, "verse_number": "१३-२-९३", "content_sanskrit": "उटजात्तु ततस्तस्मान्निश्चक्राम स वै द्विजः।\nवपुषा द्यां च भूमिं च व्याप्य वायुरिवोद्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2088067, "chapter_id": 2872, "verse_number": "१३-२-९४", "content_sanskrit": "स्वरेण विप्रः शैक्षेण त्रींल्लोकाननुनादयन्।\nउवाच चैनं धर्मज्ञं पूर्वमामन्त्र्य नामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2088068, "chapter_id": 2872, "verse_number": "१३-२-९५", "content_sanskrit": "धर्मोऽहमस्मि भद्रं ते जिज्ञासार्थं तवानघ।\nप्राप्तः सत्यं च ते ज्ञात्वा प्रीतिर्मे परमा त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2088069, "chapter_id": 2872, "verse_number": "१३-२-९६", "content_sanskrit": "विजितश्च त्वया मृत्युर्योऽयं त्वामनुगच्छति।\nरन्ध्रान्वेषी तव सदा त्वया धृत्या वशीकृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2088070, "chapter_id": 2872, "verse_number": "१३-२-९७", "content_sanskrit": "न चास्ति शक्तिस्त्रैलोक्ये कस्य चित्पुरुषोत्तम।\nपतिव्रतामिमां साध्वीं तवोद्वीक्षितुमप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2088071, "chapter_id": 2872, "verse_number": "१३-२-९८", "content_sanskrit": "रक्षिता त्वद्गुणैरेषा पातिव्रत्यगुणैस्तथा।\nअधृष्या यदियं ब्रूयात्तथा तन्नान्यथा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2088072, "chapter_id": 2872, "verse_number": "१३-२-९९", "content_sanskrit": "एषा हि तपसा स्वेन संयुक्ता ब्रह्मवादिनी।\nपावनार्थं च लोकस्य सरिच्छ्रेष्ठा भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2088073, "chapter_id": 2872, "verse_number": "१३-२-१००", "content_sanskrit": "अर्धेनौघवती नाम त्वामर्धेनानुयास्यति।\nशरीरेण महाभागा योगो ह्यस्या वशे स्थितः।\nअनया सह लोकांश्च गन्ताऽसि तपसार्जितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2088074, "chapter_id": 2872, "verse_number": "१३-२-१०१", "content_sanskrit": "यत्र नावृत्तिमभ्येति शाश्वतांस्ताननुत्तमान्।\nअनेन चैव देहेन लोकांस्त्वमभिपत्स्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2088075, "chapter_id": 2872, "verse_number": "१३-२-१०२", "content_sanskrit": "निर्जितश्च त्वया मृत्युरैश्वर्यं च तवोत्तमम्।\nपञ्चभूतान्यतिक्रान्तः स्ववीर्याच्च मनोजवः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2088076, "chapter_id": 2872, "verse_number": "१३-२-१०३", "content_sanskrit": "गृहस्थधर्मेणानेन कामक्रोधौ च ते जितौ॥\nस्नेहो रागश्च तन्द्री च मोहो द्रोहश्च केवलः।\nतव शुश्रूषया राजन्राजपुत्र्या च निर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2088077, "chapter_id": 2872, "verse_number": "१३-२-१०४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2088078, "chapter_id": 2872, "verse_number": "१३-२-१०४", "content_sanskrit": "शुक्लानां तु सहस्रेण वाजिनां रथमुत्तमम्।\nयुक्तं प्रगृह्य भगवान्वासवोप्याजगाम तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2088079, "chapter_id": 2872, "verse_number": "१३-२-१०५", "content_sanskrit": "मृत्युरात्मा च लोकाश्च जिता भूतानि पञ्च च।\nबुद्धिः कालो मदो मोहः कामक्रोधौ तथैव च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2088080, "chapter_id": 2872, "verse_number": "१३-२-१०६", "content_sanskrit": "तस्माद्गृहाश्रमस्थस्य नान्यद्दैवतमस्ति वै।\nऋतेऽतिथिं नरव्याघ्र मनसैतद्विचारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2088081, "chapter_id": 2872, "verse_number": "१३-२-१०७", "content_sanskrit": "अतिथिः पूजितो यद्धि ध्यायते मनसा शुभम्।\nन तत्क्रतुशतेनापि तुल्यमाहुर्मनीपिण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2088082, "chapter_id": 2872, "verse_number": "१३-२-१०८", "content_sanskrit": "सुदत्तं सुकृतं वाऽपि कम्पयेदप्यनर्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2088083, "chapter_id": 2872, "verse_number": "१३-२-१०९", "content_sanskrit": "पात्रं त्वतिथिमासाद्य शीलाढ्यं यो न पूजयेत्।\nस दत्त्वा तुष्कृतं तस्मै पुण्यमादाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2088084, "chapter_id": 2872, "verse_number": "१३-२-११०", "content_sanskrit": "एतत्ते कथितं पुत्र मयाऽऽख्यानमनुत्तमम्।\nयथा हि विजितो मृत्युर्गृहस्थेन पुराऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2088085, "chapter_id": 2872, "verse_number": "१३-२-१११", "content_sanskrit": "धन्यं यशस्यमायुष्यमिदमाख्यानमुत्तमम्।\nबुभूषताऽभिमन्तव्यं सर्वदुश्चरितापहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2088086, "chapter_id": 2872, "verse_number": "१३-२-११२", "content_sanskrit": "इदं यः कथयेद्विद्वानहन्यहनि भारत।\nसुदर्शनस्य चरितं पुण्याँल्लोकानवाप्नुयात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2088087, "chapter_id": 2872, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्वितीयोऽध्यायः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}]