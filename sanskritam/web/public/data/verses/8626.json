[{"id": 900008288, "chapter_id": 8626, "verse_number": "7.1", "content_sanskrit": "वैदिकाः शब्दास्तावच्चतुर्विधाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008289, "chapter_id": 8626, "verse_number": "7.2", "content_sanskrit": "किञ्च अन्यत्रैव प्रसिद्धाव्यक्तप्रकृत्यादिशब्देष्वपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008290, "chapter_id": 8626, "verse_number": "7.3", "content_sanskrit": "किञ्च रूढत्वयौगिकत्वाभ्यां हि नामलिङ्गभेदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008291, "chapter_id": 8626, "verse_number": "7.4", "content_sanskrit": "श्रुत्यन्तरादिभिस्तुल्या ह्युभयस्मिन्प्रसिद्धता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008292, "chapter_id": 8626, "verse_number": "7.5", "content_sanskrit": "अत्र चेतरयोर्हेतुमूलत्वाद्धेतुः प्रदर्श्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008293, "chapter_id": 8626, "verse_number": "7.6", "content_sanskrit": "अन्यत्रप्रसिद्धानां त्विन्द्रादिशब्दानां..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008294, "chapter_id": 8626, "verse_number": "7.7", "content_sanskrit": "टीकायां ‘‘असद्वा इदमग्र आसीत्’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008295, "chapter_id": 8626, "verse_number": "7.8", "content_sanskrit": "नामलिङ्गभेदस्तु यान्यापाततो रूढान्येव तानि नामानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900008296, "chapter_id": 8626, "verse_number": "7.9", "content_sanskrit": "पादक्रमस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900008297, "chapter_id": 8626, "verse_number": "7.10", "content_sanskrit": "न चैवमन्यत्रैव प्रसिद्धादीनां..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900008298, "chapter_id": 8626, "verse_number": "7.11", "content_sanskrit": "अन्ये तु प्रथमे स्पष्टब्रह्मलिङ्गान्युदाहरणानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900008299, "chapter_id": 8626, "verse_number": "7.12", "content_sanskrit": "अस्माकं नामपादे ‘‘अन्तस्तद्धर्मे’’त्यत्र ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900008300, "chapter_id": 8626, "verse_number": "7.13", "content_sanskrit": "केचित्तु जन्मादिसूत्रे ब्रह्म कारणमेव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900008301, "chapter_id": 8626, "verse_number": "7.14", "content_sanskrit": "यच्चोक्तमस्पष्टजीवादिलिङ्गकानि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900008302, "chapter_id": 8626, "verse_number": "7.15", "content_sanskrit": "ननु तत्तत्प्रतिपादनच्छायानुसारित्वं नाम..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900008303, "chapter_id": 8626, "verse_number": "7.16", "content_sanskrit": "अत्र च ‘‘सर्वे वेदा यत्पदमामनन्ति’’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900008304, "chapter_id": 8626, "verse_number": "7.17", "content_sanskrit": "शास्त्रेऽध्याये तथा पादे श्रुत्याऽधिकरणेन च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900008305, "chapter_id": 8626, "verse_number": "7.18", "content_sanskrit": "अ(त्रा)धिकरणे टीकायां पादसङ्गत्यर्थं ‘‘आनन्दमयनाम्नः’’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900008306, "chapter_id": 8626, "verse_number": "7.19", "content_sanskrit": "तत्वप्रदीपे तु ‘‘आनन्दमयाधिकरणे लिङ्गविचारात्’’ ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900008307, "chapter_id": 8626, "verse_number": "7.20", "content_sanskrit": "इह समन्वयसूत्रप्रतिज्ञातसमन्वयहेतौ वाच्यत्वे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900008308, "chapter_id": 8626, "verse_number": "7.21", "content_sanskrit": "भाष्ये तु विप्रकीर्णनानाशाखास्थवाक्यविनिर्णायकेष्वन्यथाऽपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900008309, "chapter_id": 8626, "verse_number": "7.22", "content_sanskrit": "अत्रानन्दमयः किं चतुर्मुखादिः किं वा विष्णुरिति चिन्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900008310, "chapter_id": 8626, "verse_number": "7.23", "content_sanskrit": "अत्र ब्रह्मशब्दाभ्यासो यद्यपि सूत्रोदाहृतमानन्दमयं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900008311, "chapter_id": 8626, "verse_number": "7.24", "content_sanskrit": "भाष्ये तु ब्रह्मशब्दपदेन ब्रह्मवाचकः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900008312, "chapter_id": 8626, "verse_number": "7.25", "content_sanskrit": "केचित्तु शाखान्तरेऽप्यन्नमयादौ ब्रह्मशब्दसद्भावादभ्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900008313, "chapter_id": 8626, "verse_number": "7.26", "content_sanskrit": "यद्यपि ‘‘तादात्म्यार्थे विकारार्थे प्राचुर्यार्थे मयट् त्रिधा’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900008314, "chapter_id": 8626, "verse_number": "7.27", "content_sanskrit": "अन्नमयादिसाधारणहेतोरभ्यासात्पश्चान्मान्त्रवर्णिकगानादेस्तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900008315, "chapter_id": 8626, "verse_number": "7.28", "content_sanskrit": "अन्ये तु ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900008316, "chapter_id": 8626, "verse_number": "7.29", "content_sanskrit": "एकत्रापि न मुख्यार्थलङ्घनं मामके मते..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900008317, "chapter_id": 8626, "verse_number": "7.30", "content_sanskrit": "अन्नमयादावपि प्राचुर्यार्थत्वस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900008318, "chapter_id": 8626, "verse_number": "7.31", "content_sanskrit": "सविशेषत्वं तु ब्रह्मत्वसाधकम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900008319, "chapter_id": 8626, "verse_number": "7.32", "content_sanskrit": "न च यथा परमते ‘‘असन्नेव’’ इति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900008320, "chapter_id": 8626, "verse_number": "7.33", "content_sanskrit": "न चाज्ञातधर्मतत्वं चैत्यवन्दनादि धर्म इति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900008321, "chapter_id": 8626, "verse_number": "7.34", "content_sanskrit": "अत्रावशिष्टं ‘‘आत्मन आकाशः’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900008322, "chapter_id": 8626, "verse_number": "7.35", "content_sanskrit": "अविरुद्धं चान्नादिशब्दैरन्नमयादिप्रत्यायनं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900008323, "chapter_id": 8626, "verse_number": "7.36", "content_sanskrit": "अन्योऽन्तर इत्यन्यत्वान्तरत्वाद्युक्तिस्तु ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900008324, "chapter_id": 8626, "verse_number": "7.37", "content_sanskrit": "केचित्तु ‘‘तस्यैष एव शारीर आत्मा’’ इति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900008325, "chapter_id": 8626, "verse_number": "7.38", "content_sanskrit": "किञ्चाद्यसूत्रे यदि भास्करमत ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900008326, "chapter_id": 8626, "verse_number": "7.39", "content_sanskrit": "ब्रह्मशब्दात्समस्तात्तृत्वादिलिङ्गाच्च वाक्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900008327, "chapter_id": 8626, "verse_number": "7.40", "content_sanskrit": "एवं च यथा ‘‘दाक्षायणयज्ञेन यजेत साकं प्रस्थायी येन यजेत’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900008328, "chapter_id": 8626, "verse_number": "7.41", "content_sanskrit": "टीकाक्षरार्थस्तु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]