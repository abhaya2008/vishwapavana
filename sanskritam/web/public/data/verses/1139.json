[{"id": 2007093, "chapter_id": 1139, "verse_number": "१-१४०-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007094, "chapter_id": 1139, "verse_number": "१-१४०-१", "content_sanskrit": "कृपस्यापि मम ब्रह्मन्संभवं वक्तुमर्हसि।\nशरस्तम्बात्कथं जज्ञे कथं वाऽस्त्राण्यवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007095, "chapter_id": 1139, "verse_number": "१-१४०-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007096, "chapter_id": 1139, "verse_number": "१-१४०-२", "content_sanskrit": "महर्षेर्गौतमस्यासीच्छरद्वान्नाम गौतमः।\nपुत्रः किल महाराज जातः सहशरैर्विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007097, "chapter_id": 1139, "verse_number": "१-१४०-३", "content_sanskrit": "न तस्य वेदाध्ययने तथा बुद्धिरजायत।\nयथास्य बुद्धिरभवद्धनुर्वेदे परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007098, "chapter_id": 1139, "verse_number": "१-१४०-४", "content_sanskrit": "अधिजग्मुर्यथा वेदास्तपसा ब्रह्मचारिणः।\nतथा स तपसोपेतः सर्वाण्यस्त्राण्यवाप ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007099, "chapter_id": 1139, "verse_number": "१-१४०-५", "content_sanskrit": "धनुर्वेदपरत्वाच्च तपसा विपुलेन च।\nभृशं सन्तापयामास देवराजं स गौतमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007100, "chapter_id": 1139, "verse_number": "१-१४०-६", "content_sanskrit": "ततो जालवतीं नाम देवकन्यां सुरेश्वरः।\nप्राहिणोत्तपसो विघ्नं कुरु तस्येति कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007101, "chapter_id": 1139, "verse_number": "१-१४०-७", "content_sanskrit": "सा हि गत्वाऽऽश्रमं तस्य रमणीयं शरद्वतः।\nधनुर्बाणधरं बाला लोभयामास गौतमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007102, "chapter_id": 1139, "verse_number": "१-१४०-८", "content_sanskrit": "तामेकवसनां दृष्ट्वा गौतमोऽप्सरसं वने।\nलोकेऽप्रतिमसंस्थानां प्रोत्फुल्लनयनोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007103, "chapter_id": 1139, "verse_number": "१-१४०-९", "content_sanskrit": "धनुश्च हि शरास्तस्य कराभ्यामपतन्भुवि।\nवेपथुश्चास्य सहसा शरीरे समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007104, "chapter_id": 1139, "verse_number": "१-१४०-१०", "content_sanskrit": "स तु ज्ञानगरीयस्त्वात्तपसश्च समर्थनात्।\nअवतस्थे महाप्राज्ञो धैर्येण परमेण ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007105, "chapter_id": 1139, "verse_number": "१-१४०-११", "content_sanskrit": "यस्तस्य सहसा राजन्विकारः समदृश्यत।\nतेन सुस्राव रेतोऽस्य स च तन्नान्वबुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007106, "chapter_id": 1139, "verse_number": "१-१४०-१२", "content_sanskrit": "धनुश्च सशरं त्यक्त्वा तथा कृष्णाजिनानि च।\nस विहायाश्रमं तं च तां चैवाप्सरसं मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007107, "chapter_id": 1139, "verse_number": "१-१४०-१३", "content_sanskrit": "जगाम रेतस्तत्तस्य शरस्तम्बे पपात च।\nशरस्तम्बे च पतितं द्विधा तदभवन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007108, "chapter_id": 1139, "verse_number": "१-१४०-१४", "content_sanskrit": "तस्याथ मिथुं जज्ञे गौतमस्य शरद्वतः।\nमहर्षेर्गौतमस्यास्य ह्याश्रमस्य समीपतः॥\nमृगयां चरतो राज्ञः शान्तनोस्तु यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007109, "chapter_id": 1139, "verse_number": "१-१४०-१५", "content_sanskrit": "कश्चित्सेनाचरोऽरण्ये मिथुनं तदपश्यत।\nधनुश्च सशरं दृष्ट्वा तथा कृष्णाजिनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007110, "chapter_id": 1139, "verse_number": "१-१४०-१६", "content_sanskrit": "ज्ञात्वा द्विजस्य चापत्ये धनुर्वेदान्तगस्य ह।\nस राज्ञे दर्शयामास मिथुनं सशरं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007111, "chapter_id": 1139, "verse_number": "१-१४०-१७", "content_sanskrit": "स तदादाय मिथुनं राजा च कृपयान्वितः।\nआजगाम गृहानेव मम पुत्राविति ब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007112, "chapter_id": 1139, "verse_number": "१-१४०-१८", "content_sanskrit": "ततः संवर्धयामास संस्कारैश्चाप्ययोजयत्।\nप्रातिपेयो नरश्रेष्ठो मिथुनं गौतमस्य तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007113, "chapter_id": 1139, "verse_number": "१-१४०-१९", "content_sanskrit": "कृपया यन्मया बालाविमौ संवर्धिताविति।\nतस्मात्तयोर्नाम चक्रे तदेव स महीपतिः।\nतस्मात्कृप इति ख्यातः कृपी कन्या च साऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007114, "chapter_id": 1139, "verse_number": "१-१४०-२०", "content_sanskrit": "पितापि गौतमस्तत्र तपसा ताववन्दित।\nआगत्य तस्मै गोत्रादि सर्वमाख्यातवांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007115, "chapter_id": 1139, "verse_number": "१-१४०-२१", "content_sanskrit": "कृपोऽपि च तदा राजन्धनुर्वेदपरोऽभवत्।\nचतुर्विधं धनुर्वेदं शास्त्राणि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007116, "chapter_id": 1139, "verse_number": "१-१४०-२२", "content_sanskrit": "निशिलेनास्य तत्सर्वं गुह्यमाख्यातवान्पिता।\nसोऽचिरेणैव कालेन परमाचार्यतां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007117, "chapter_id": 1139, "verse_number": "१-१४०-२३", "content_sanskrit": "कृपमाहूय गाङ्गेयस्तव शिष्या इति ब्रुवन्।\nपौत्रान्परिसमाधाय कृपमाराधयत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007118, "chapter_id": 1139, "verse_number": "१-१४०-२४", "content_sanskrit": "ततोऽधिजग्मुः सर्वे ते धनुर्वेदं महारथाः।\nधृतराष्ट्रात्मजाश्चैव पाण्डवाः सह यादवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007119, "chapter_id": 1139, "verse_number": "१-१४०-२५", "content_sanskrit": "वृष्णयश्च नृपाश्चान्ये नानादेशसमागताः।\nकृपमाचार्यमासाद्य परमास्त्रज्ञतां गतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007120, "chapter_id": 1139, "verse_number": "१-१४०-२५x", "content_sanskrit": "वैशम्पायन उवाच।\nविशेषार्थी ततो भीष्मः पौत्राणां विनयेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007121, "chapter_id": 1139, "verse_number": "१-१४०-२६", "content_sanskrit": "इष्वस्त्रज्ञान्पर्यपृच्छदाचार्यान्वीर्यसंमतान्।\nनाल्पधीर्नामहाभागस्तथा नानस्त्रकोविदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007122, "chapter_id": 1139, "verse_number": "१-१४०-२७", "content_sanskrit": "नादेवसत्वो विनयेत्कुरूनस्त्रे महावलान्।\nइति संचिन्त्य गाङ्गेयस्तदा भरतसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007123, "chapter_id": 1139, "verse_number": "१-१४०-२८", "content_sanskrit": "द्रोणाय वेदविदुषे भारद्वाजाय धमते।\nपाण्डवान्कौरवांश्चैव ददौ शिष्यान्नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007124, "chapter_id": 1139, "verse_number": "१-१४०-२९", "content_sanskrit": "शास्त्रतः पूजितश्चैव सम्यक्तेन महात्मना।\nस भीष्मेण महाभागस्तुष्टोऽस्त्रविदुषां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007125, "chapter_id": 1139, "verse_number": "१-१४०-३०", "content_sanskrit": "प्रतिजग्राह तान्सर्वाञ्शिष्यत्वेन महायशाः।\nशिक्षयामास च द्रोणो धनुर्वेदमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007126, "chapter_id": 1139, "verse_number": "१-१४०-३१", "content_sanskrit": "तेऽचिरेणैव कालेन सर्वशस्त्रविशारदाः।\nबभूवुः कौरवा राजन्पाण्डवाश्चामितौजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007127, "chapter_id": 1139, "verse_number": "१-१४०-३२x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007128, "chapter_id": 1139, "verse_number": "१-१४०-३२", "content_sanskrit": "कथं समभवद्द्रोणः कथं चास्त्राण्यवाप्तवान्।\nकथं चागात्कुरून्ब्रह्मन्कस्य पुत्रः स वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007129, "chapter_id": 1139, "verse_number": "१-१४०-३३", "content_sanskrit": "कथं चास्य सुतो जातः सोश्वत्थामाऽस्त्रवित्तमः।\nएतदिच्छाम्यहं श्रोतुं विस्तरेण प्रकीर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007130, "chapter_id": 1139, "verse_number": "१-१४०-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007131, "chapter_id": 1139, "verse_number": "१-१४०-३४", "content_sanskrit": "गङ्गाद्वारं प्रति महान्बभूव भगवानृषिः।\nभरद्वाज इति ख्यातः सततं संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007132, "chapter_id": 1139, "verse_number": "१-१४०-३५", "content_sanskrit": "सोऽभिषेक्तुं गतो गङ्गां पूर्वमेवागतां सतीम्।\nमहर्षिभिर्भरद्वाजो हविर्धाने चरन्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007133, "chapter_id": 1139, "verse_number": "१-१४०-३६", "content_sanskrit": "ददर्शाप्सरसं साक्षाद्धृताचीमाप्लुतामृषिः।\nरूपयौवनसंपन्नां मददृप्तां मदालसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007134, "chapter_id": 1139, "verse_number": "१-१४०-३७", "content_sanskrit": "तस्या वायुर्नदीतीर वसनं पर्यवर्तत।\nव्यपकृष्टाम्बरां दृष्ट्वा तामृषिश्चकमे ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007135, "chapter_id": 1139, "verse_number": "१-१४०-३८", "content_sanskrit": "तत्र संसक्तमनसो भरद्वाजस्य धीमतः।\nहृष्टस्य रेतश्चस्कन्द तदृषिर्द्रोण आदधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007136, "chapter_id": 1139, "verse_number": "१-१४०-३९", "content_sanskrit": "ततः समभवद्द्रोणः कलशे तस्य धीमतः।\nअध्यगीष्ट स वेदांश्च वेदाङ्गानि च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007137, "chapter_id": 1139, "verse_number": "१-१४०-४०", "content_sanskrit": "अग्नेरस्त्रमुपादाय यदृषिर्वेद काश्यपः।\nअध्यगच्छद्भरद्वाजस्तदस्त्रं देवकार्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007138, "chapter_id": 1139, "verse_number": "१-१४०-४१", "content_sanskrit": "अग्निवेश्यं महाभागं भरद्वाजः प्रतापवान्।\nप्रत्यपादयदाग्नेयमस्त्रमस्त्रविदां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007139, "chapter_id": 1139, "verse_number": "१-१४०-४२", "content_sanskrit": "कनिष्ठजातं स मुनिर्भ्राता भ्रातरमन्तिके।\nअग्निवेश्यस्तथा द्रोणं तदा भरतसत्तम।\nभारद्वाजं तदाग्नेयं महास्त्रं प्रत्यपादयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2007140, "chapter_id": 1139, "verse_number": "१-१४०-४३", "content_sanskrit": "भरद्वाजसखा चासीत्पृषतो नाम पार्थिवः।\nतस्यापि द्रुपदो नाम तथा समभवत्सुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2007141, "chapter_id": 1139, "verse_number": "१-१४०-४४", "content_sanskrit": "स नित्यमाश्रमं गत्वा द्रोणेन सह पार्थिवः।\nचिक्रीडाध्ययनं चैव चकार क्षत्रियर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2007142, "chapter_id": 1139, "verse_number": "१-१४०-४५", "content_sanskrit": "ततो व्यतीते पृषते स राजा द्रुपदोऽभवत्।\nपञ्चालेषु महाबाहुरुत्तरेषु नरेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2007143, "chapter_id": 1139, "verse_number": "१-१४०-४६", "content_sanskrit": "भरद्वाजोऽपि भगवानारुरोह दिवं तदा।\nतत्रैव च वसन्द्रोणस्तपस्तेपे महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2007144, "chapter_id": 1139, "verse_number": "१-१४०-४७", "content_sanskrit": "वेदवेदाङ्गविद्वान्स तपसा दग्धकिल्बिषः।\nततः पितृनियुक्तात्मा पुत्रलोभान्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2007145, "chapter_id": 1139, "verse_number": "१-१४०-४८", "content_sanskrit": "शारद्वतीं ततो भार्यां कृपीं द्रोणोऽन्वविन्दत।\nअग्निहोत्रे च धर्मे च दमे च सतत रताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2007146, "chapter_id": 1139, "verse_number": "१-१४०-४९", "content_sanskrit": "अलभद्गौतमी पुत्रमश्वत्थामानमेव च।\nस जातमात्रो व्यनदद्यथैवोच्चैःश्रवा हयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2007147, "chapter_id": 1139, "verse_number": "१-१४०-५०", "content_sanskrit": "तच्छ्रुत्वान्तर्हितं भूतमन्तरिक्षस्थमब्रवीत्।\nअश्वस्येवास्य यत्स्थाम नदतः प्रदिशो गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2007148, "chapter_id": 1139, "verse_number": "१-१४०-५१", "content_sanskrit": "अश्वत्थामैव बालोऽयं तस्मान्नाम्ना भविष्यति।\nसुतेन तेन सुप्रीतो भारद्वाजस्ततोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2007149, "chapter_id": 1139, "verse_number": "१-१४०-५२", "content_sanskrit": "तत्रैव च वसन्धीमान्धनुर्वेदपरोऽभवत्।\nस शुश्राव महात्मानं जामदग्न्यं परंतपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2007150, "chapter_id": 1139, "verse_number": "१-१४०-५३", "content_sanskrit": "सर्वज्ञानविदं विप्रं सर्वशस्त्रभृतां वरम्।\nब्राह्मणेभ्यस्तदा राजन्दित्सन्तं वसु सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2007151, "chapter_id": 1139, "verse_number": "१-१४०-५४", "content_sanskrit": "स रामस्य धनुर्वेदं दिव्यान्यस्त्राणि चैव ह।\nश्रउत्वा तेषु मनश्चक्रे नीतिशास्त्रे तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2007152, "chapter_id": 1139, "verse_number": "१-१४०-५५", "content_sanskrit": "ततः स व्रतिभिः शिष्यैस्तपोयुक्तैर्महातपाः।\nवृतः प्रायान्महावाहुर्महेन्द्रं पर्वतोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2007153, "chapter_id": 1139, "verse_number": "१-१४०-५६", "content_sanskrit": "ततो महेन्द्रमासाद्य भारद्वाजो महातपाः।\nक्षत्रघ्नं तममित्रघ्नमपश्यद्भृगुनन्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2007154, "chapter_id": 1139, "verse_number": "१-१४०-५७", "content_sanskrit": "ततो द्रोणो वृतः शिष्यैरुपगम्य भृगूद्वहम्।\nआचख्यावात्मनो नाम जन्म चाङ्गिरसः कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2007155, "chapter_id": 1139, "verse_number": "१-१४०-५८", "content_sanskrit": "निवेद्य शिरसा भूमौ पादौ चैवाभ्यवादयत्।\nततस्तं सर्वमुत्सृज्य वनं जिगमिषुं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2007156, "chapter_id": 1139, "verse_number": "१-१४०-५९", "content_sanskrit": "जामदग्न्यं महात्मानं भारद्वाजोऽब्रवीदिदम्।\nभरद्वाजात्समुत्पन्नं तथा त्वं मामयोनिजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2007157, "chapter_id": 1139, "verse_number": "१-१४०-६०", "content_sanskrit": "आगतं वित्तकामं मां विद्धि द्रोणं द्विजोत्तम।\nतमब्रवीन्महात्मा स सर्वक्षत्रियमर्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2007158, "chapter_id": 1139, "verse_number": "१-१४०-६१", "content_sanskrit": "स्वागतं ते द्विजश्रेष्ठ यदिच्छसि वदस्व मे।\nएवमुक्तस्तु रामेण भारद्वाजोऽब्रवीद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2007159, "chapter_id": 1139, "verse_number": "१-१४०-६२", "content_sanskrit": "रामं प्रहरतां श्रेष्ठं दित्सन्तं विविधं वसु।\nअहं धनमनन्तं हि प्रार्थये विपुलव्रत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2007160, "chapter_id": 1139, "verse_number": "१-१४०-६३x", "content_sanskrit": "राम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2007161, "chapter_id": 1139, "verse_number": "१-१४०-६३", "content_sanskrit": "हिरण्यं मम यच्चान्यद्वसु किंचिदिह स्थितम्।\nब्राह्मणेभ्यो मया दत्तं सर्वमेतत्तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2007162, "chapter_id": 1139, "verse_number": "१-१४०-६४", "content_sanskrit": "तथैवेयं धरा देवी सागरान्ता सपत्तना।\nकश्यपाय मया दत्ता कृत्स्ना नगरमालिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2007163, "chapter_id": 1139, "verse_number": "१-१४०-६५", "content_sanskrit": "शरीरमात्रमेवाद्य ममेदमवशेषितम्।\nअस्त्राणि च महार्हाणि शस्त्राणि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2007164, "chapter_id": 1139, "verse_number": "१-१४०-६६", "content_sanskrit": "अस्त्राणि वा शरीरं वा ब्रह्मञ्शस्त्राणि वा पुनः।\nवृणीष्व किं प्रयच्छामि तुभ्यं द्रोण वदाशु तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2007165, "chapter_id": 1139, "verse_number": "१-१४०-६७x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2007166, "chapter_id": 1139, "verse_number": "१-१४०-६७", "content_sanskrit": "अस्त्राणि मे समग्राणि ससंहाराणि भार्गव।\nस प्रयोगरहस्यानि दातुमर्हस्यशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2007167, "chapter_id": 1139, "verse_number": "१-१४०-६८", "content_sanskrit": "एतद्वसु वसूनां हि सर्वेषां विप्रसत्तम।\nतथेत्युक्त्वा ततस्तस्मै प्रादादस्त्राणि भार्गवः।\nसरहस्यव्रतं चैव धनुर्वेदमशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2007168, "chapter_id": 1139, "verse_number": "१-१४०-६९", "content_sanskrit": "प्रतिगृह्य तु तत्सर्वं कृतास्त्रे द्विजसत्तमः।\nप्रियं सखायं सुप्रीतो जगाम द्रुपदं प्रति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2007169, "chapter_id": 1139, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि चत्वारिंशदधिकशततमोऽध्यायः॥ १४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]