[{"id": 2032894, "chapter_id": 1710, "verse_number": "४-३३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032895, "chapter_id": 1710, "verse_number": "४-३३-१", "content_sanskrit": "ततस्तेषां महाराज तत्रैवामिततेजसाम्।\nछद्मलिङ्गप्रविष्टानां पाण्डवानां महात्मनाम् ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032896, "chapter_id": 1710, "verse_number": "४-३३-२", "content_sanskrit": "व्यतीतः समयः सम्यग्विराटनगरे सताम्।\nकुर्वतां तस्य कर्माणि वीराटस्य महीपतेः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032897, "chapter_id": 1710, "verse_number": "४-३३-३", "content_sanskrit": "कीचके तु हते राजा विराटः परवीरहा।\nपरां संभावनां चक्रे कुन्तीपुत्रे युधिष्ठिरे ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032898, "chapter_id": 1710, "verse_number": "४-३३-४", "content_sanskrit": "ततस्त्रयोदशस्वान्ते तस्य वर्षस्य भारत।\nशुशर्मणा गृहीतं तु गोधनं तरसा बहु ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032899, "chapter_id": 1710, "verse_number": "४-३३-५", "content_sanskrit": "ततः शब्दो महानासीद्रेणुश्च दिवमस्पृशत्।\nशङ्खदुन्दुभिघोषश्च भेरीणां च महास्वनः।\nगवाश्वरथनागानां निश्वनश्च पदातिनाम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032900, "chapter_id": 1710, "verse_number": "४-३३-६", "content_sanskrit": "एवं तैस्त्वभिनिर्याय मत्स्यराजस्य गोधने।\nत्रिगर्तैर्गृह्यमाणे तु गोपालाः प्रत्यषेधयन् ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032901, "chapter_id": 1710, "verse_number": "४-३३-७", "content_sanskrit": "अथ त्रिगर्ता बहवः परिगृह्य धनं बहु ।\nपरिक्षिप्य हयैः शीघ्रै रथव्रातैश्च भारत।\nगोपालान्प्रत्ययुध्यन्त रणे कृत्वा जये धृतिम् ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032902, "chapter_id": 1710, "verse_number": "४-३३-८", "content_sanskrit": "ते हन्यमाना बहुभिः प्रासतोमरपाणिभिः ।\nगोपाला गोकुले भक्ता वारयामासुरोजसा ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032903, "chapter_id": 1710, "verse_number": "४-३३-९", "content_sanskrit": "परश्वथैश्च मुसलैर्भिण्डिपालैश्च मुद्गरैः।\nगोपालाः कर्षणैश्चित्रैर्जघ्नुरश्वान्समन्ततः ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032904, "chapter_id": 1710, "verse_number": "४-३३-१०", "content_sanskrit": "ते हन्यमानाः संक्रुद्धास्त्रिगर्ता रथयोधिनः ।\nविसृज्य शरवर्षणि गोपानद्रावयन्बलात् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032905, "chapter_id": 1710, "verse_number": "४-३३-११", "content_sanskrit": "हन्यमानेषु गोपेषु विमुखेषु विशांपते।\nततो युवानः संभीताः श्वसन्तो रेणुगुण्ठिताः ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032906, "chapter_id": 1710, "verse_number": "४-३३-१२", "content_sanskrit": "जवेन महता चैव गोपालाः पुरमाव्रजन्।\nविराटनगरं प्राप्य नरा राजानमब्रुवन् ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032907, "chapter_id": 1710, "verse_number": "४-३३-१३", "content_sanskrit": "सभायां राजशार्दूलमासीनं पाण्डवैः सह।\nशूरैः परिवृतं योधैः कुण्डलाङ्गदधारिभिः ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032908, "chapter_id": 1710, "verse_number": "४-३३-१४", "content_sanskrit": "सद्भिश्च पण्डितैः सार्धं मन्त्रिभिश्चापि संवृतम् ।\nदृष्ट्वा शीघ्रं तु गोपाला विराटमिदमब्रवन् ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032909, "chapter_id": 1710, "verse_number": "४-३३-१५", "content_sanskrit": "अस्मान्युधि विनिर्जित्य परिभूय सबान्धवान्।\nषष्टिं गवां सहस्राणि त्रिगर्ताः कालयन्ति ।\nता निवर्तय राजेन्द्र मा नेशुः पशवस्तव ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032910, "chapter_id": 1710, "verse_number": "४-३३-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2032911, "chapter_id": 1710, "verse_number": "४-३३-१६", "content_sanskrit": "श्रुत्वा तु वचनं तेषां गोपालानामरिंदमः।\nस राजा महतीं सेनां मात्स्यानां समवाहयत्।\nरथनागाश्वकलिलां पत्तिध्वजसमाकुलाम् ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2032912, "chapter_id": 1710, "verse_number": "४-३३-१७", "content_sanskrit": "राजानो राजपुत्राश्च तनुत्राण्यथ भेजिरे।\nभानुमन्ति विवातानि सूपसेव्यानि भागशः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2032913, "chapter_id": 1710, "verse_number": "४-३३-१८", "content_sanskrit": "पृथक्काञ्चनसन्नाहान्रथेष्वश्वानयोजयन् ।\nउत्कृष्य पाशान्मौर्वीणां शूराश्चापेष्वयोजयन् ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2032914, "chapter_id": 1710, "verse_number": "४-३३-१९", "content_sanskrit": "दृढमायसगर्भं तु कवचं तप्तकाञ्चनम् ।\nविराटस्य प्रियो भ्राता शतानीकोऽभ्यहारयत् ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2032915, "chapter_id": 1710, "verse_number": "४-३३-२०", "content_sanskrit": "सर्वभारसहं वर्म कल्याणपटलं दृढम्।\nशतानीकादवरजो मदिराक्षोऽभ्यहारयत् ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2032916, "chapter_id": 1710, "verse_number": "४-३३-२१", "content_sanskrit": "उत्सेधे यस्य पद्मानि शतं सौगन्धिकानि च।\nमृष्टहाटकपर्यन्तं सूर्यदत्तोऽभ्यहारयत् ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2032917, "chapter_id": 1710, "verse_number": "४-३३-२२", "content_sanskrit": "दृढमायसगर्भं च श्वेतं रुक्मपरिष्कृतम्।\nविराटस्य सुतो ज्येष्ठो वीरः शङ्खोऽभ्यहारयत् ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2032918, "chapter_id": 1710, "verse_number": "४-३३-२३", "content_sanskrit": "शतसूर्यं शतावर्तं शतबिन्दु शताक्षिमत्।\nअभेद्यकल्पं मत्स्यानां राजा कवचमाहरत् ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2032919, "chapter_id": 1710, "verse_number": "४-३३-२४", "content_sanskrit": "ततो नानातनुत्राणि स्वानिस्वानि महाबलाः।\nयुयुत्सवोऽभ्यनह्यन्त देवकल्पाः प्रहारिणः ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2032920, "chapter_id": 1710, "verse_number": "४-३३-२५", "content_sanskrit": "सोपस्करेषु शुभ्रेषु महत्सु च महारथाः ।\nपृथक्काञ्चनसन्नाहान्रथेष्वश्वानयोजयन् ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2032921, "chapter_id": 1710, "verse_number": "४-३३-२६", "content_sanskrit": "सूर्यचन्द्रप्रतीकाशे मणिहेमविभूषिते।\nमहाप्रमाणं मत्स्यस्य ध्वजमुच्छ्रियते रथे ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2032922, "chapter_id": 1710, "verse_number": "४-३३-२७", "content_sanskrit": "ध्वजान्बहुविधाकारान्सौवर्णान्हेममालिनः।\nयथास्वं क्षत्रियाः शूरा रथेषु समयोजयन् ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2032923, "chapter_id": 1710, "verse_number": "४-३३-२८", "content_sanskrit": "रथेषु युज्यमानेषु कङ्को राजानमब्रवीत् ।\nमया ह्यस्रं चतुर्वर्गमवाप्तमृषिसत्तमात् ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2032924, "chapter_id": 1710, "verse_number": "४-३३-२९", "content_sanskrit": "दंशितो रथमास्थाय पदं निर्याम्यहं गवाम्।\nअयं च बलवाञ्छरो वललो दृश्यतेऽनघ ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2032925, "chapter_id": 1710, "verse_number": "४-३३-३०", "content_sanskrit": "गोसङ्ख्यमश्वबन्धं च संयोजय रथेषु वैः।\nनैतेन जातु युध्द्येयुर्गवार्थमिति मे मतिः ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2032926, "chapter_id": 1710, "verse_number": "४-३३-३१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2032927, "chapter_id": 1710, "verse_number": "४-३३-३१", "content_sanskrit": "अथ मात्स्योऽब्रवीद्राजा शतानीकं जघन्यजम्।\nकङ्कश्च वललः सूदो दामग्रन्थिश्च वीर्यवान् ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2032928, "chapter_id": 1710, "verse_number": "४-३३-३२", "content_sanskrit": "तन्त्रिपालश्च गोसङ्ख्यो यथा ते पुरुषर्षभाः ।\nशूराः सुवीराः पुरुषा नागराजवरोपमाः ।\nयुद्ध्येयुरिति मे बुद्धिर्वर्तते नात्र संशयः ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2032929, "chapter_id": 1710, "verse_number": "४-३३-३३", "content_sanskrit": "एतेपामपि दीयन्तां रथा ध्वजपताकिनः।\nकवचानि विचित्राणि दृढानि च लघूनि च ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2032930, "chapter_id": 1710, "verse_number": "४-३३-३४", "content_sanskrit": "प्रतिमुञ्चन्तु गात्रेषु दीयन्तामायुधानि च ।\nनेमे जातु न युद्ध्य्रेयुरिति मे धीयते मतिः ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2032931, "chapter_id": 1710, "verse_number": "४-३३-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2032932, "chapter_id": 1710, "verse_number": "४-३३-३५", "content_sanskrit": "तच्छ्रुत्वा नृपतेर्वाक्यं शीघ्रं त्वरितमानसः।\nशतानीकः स पार्थभ्यो रथान्राजन्समादिशत् ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2032933, "chapter_id": 1710, "verse_number": "४-३३-३६", "content_sanskrit": "सहदेवाय राज्ञे च भीमाय नकुलाय च।\nतान्दृष्ट्वा सहसा सूता राजभक्तिपुरस्कृताः ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2032934, "chapter_id": 1710, "verse_number": "४-३३-३७", "content_sanskrit": "निर्दिष्टा नरदेवेन रथाञ्छीघ्रमयोजयन्।\nकवचानि विचित्राणि नवानि च दृढानि च॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2032935, "chapter_id": 1710, "verse_number": "४-३३-३८", "content_sanskrit": "विराटः प्रददौ यानि तेषामक्लिष्टकर्मणाम्।\nतान्यामुच्य शरीरेषु दंशितास्ते महारथाः ॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2032936, "chapter_id": 1710, "verse_number": "४-३३-३९", "content_sanskrit": "तरस्विनश्छन्नरूपाः सर्वशस्त्रविशारदाः ।\nरथान्हेमपरिष्कारान्समास्थाय महारथाः।\nपाण्डवा निर्ययुर्हृष्टा दंशिता राजसत्तम ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2032937, "chapter_id": 1710, "verse_number": "४-३३-४०", "content_sanskrit": "विराटमन्वयुः पश्चात्सहिताः कुरुपुङ्गवाः।\nचत्वारो भ्रातरः शूराः पाण्डवाः सत्यविक्रमाः ॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2032938, "chapter_id": 1710, "verse_number": "४-३३-४१", "content_sanskrit": "दीर्घानां च दृढानां च धनुषां ते यथाबलम्।\nउत्कृष्य पाशान्मौर्वीणां वीराश्चापेष्वयोजयन् ॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2032939, "chapter_id": 1710, "verse_number": "४-३३-४२", "content_sanskrit": "ततः सुवाससः सर्वे वीराश्चन्दनरूषिताः ।\nचोदिता नरदेवेन क्षिप्रमश्वानचोदयन् ॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2032940, "chapter_id": 1710, "verse_number": "४-३३-४३", "content_sanskrit": "ते हया हेमसंच्छन्ना बृहन्तः साधुवाहिनः ।\nचोदिताः प्रत्यदृश्यन्त पत्रिणामिव पङ्क्तयः ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2032941, "chapter_id": 1710, "verse_number": "४-३३-४४", "content_sanskrit": "भीमरूपाश्च मातङ्गाः प्रभिन्नकरटामुखाः।\nस्वारूढा युद्धकुशलैर्महामात्राधिरोहिताः ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2032942, "chapter_id": 1710, "verse_number": "४-३३-४५", "content_sanskrit": "क्षरन्त इव जीमूताः सुदन्ताः षाष्टिहायनाः ।\nराजानमन्वयुः पश्चात्क्रामन्त इव पर्वताः ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2032943, "chapter_id": 1710, "verse_number": "४-३३-४६", "content_sanskrit": "दृढायुधजनाकीर्णं रथाश्वगजसंकुलम् ।\nतद्बलाग्रं विराटस्य शक्रस्येव तदा बभौ ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2032944, "chapter_id": 1710, "verse_number": "४-३३-४७", "content_sanskrit": "तं प्रयान्तं महाराज निनीषन्तं गवां पदम्।\nविशारदानां वैश्यानां प्रकृष्टानां तदा नृप ॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2032945, "chapter_id": 1710, "verse_number": "४-३३-४८", "content_sanskrit": "विंशतिस्तु सहस्राणि नराणामनुयायिनाम्।\nअष्टौ रथसहस्राणि दश नागशतानि च ।\nविंशच्चाश्वसहस्राणि मात्स्यानां त्वरितं ययुः ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2032946, "chapter_id": 1710, "verse_number": "४-३३-४९", "content_sanskrit": "तदनीकं विराटस्य शुशुभेऽतीव भारत।\nवसन्ते बहुपुष्पाढ्यं काननं चित्रितं यथा ॥ ४९ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2032947, "chapter_id": 1710, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहाणपर्वणि त्रयस्त्रिंशोऽध्यायः ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]