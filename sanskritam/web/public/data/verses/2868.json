[{"id": 2087824, "chapter_id": 2868, "verse_number": "१२-३७३-०x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087825, "chapter_id": 2868, "verse_number": "१२-३७३-१", "content_sanskrit": "नैष देवोऽनिलसखो नासुरो न च यन्नगः।\nउञ्छवृत्तिव्रते सिद्धो मुनिरेष दिवं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087826, "chapter_id": 2868, "verse_number": "१२-३७३-२", "content_sanskrit": "एष मूलफलाहारः शीर्णपर्णाशनस्तथा।\nअब्भक्षो वायुभक्षश्च आसीद्विप्रः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087827, "chapter_id": 2868, "verse_number": "१२-३७३-३", "content_sanskrit": "भवश्चानेन विप्रेण संहिताभिरभिष्टुतः।\nस्वर्गद्वारे कृतोद्योगो येनासौ त्रिविदं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087828, "chapter_id": 2868, "verse_number": "१२-३७३-४", "content_sanskrit": "असंगतिरनाकाङ्क्षी नित्यमुञ्छशिलाशनः।\nसर्वभूतहिते युक्त एष विप्रो भुजंगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087829, "chapter_id": 2868, "verse_number": "१२-३७३-५", "content_sanskrit": "न हि देवा न गन्धर्वा नासुरा न च पन्नगाः।\nप्रभवन्तीह भूतानां प्राप्तानामुत्तमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087830, "chapter_id": 2868, "verse_number": "१२-३७३-६", "content_sanskrit": "एतदेवंविधं दृष्टमाश्चर्यं तत्र मे द्विज।\nसंसिद्धो मानुषः कामं योसौ सिद्धगतिं गतः।\nसूर्येण सहितो ब्रह्मन्पृथिवीं परिवर्तते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087831, "chapter_id": 2868, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिसप्तत्यधिकत्रिशततमोऽध्यायः॥ ३७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]