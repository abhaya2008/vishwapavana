[{"id": 7003787000, "chapter_id": 23787, "verse_number": "२-२-३१-१", "content_sanskrit": "जैमिनिरुवाच ।\nकृतकृत्यं तदात्मानं मन्यमानस्ततो व्रजेत् ।\nअश्वमेधांगसंभूतमिंद्रद्युम्नसरः प्रति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003787001, "chapter_id": 23787, "verse_number": "२-२-३१-२", "content_sanskrit": "यस्य तीरे निवसति नरसिंहाकृतिर्हरिः ।\nनरसिंहमनुप्रार्थ्य तत्र स्नायाद्यथाविधि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003787002, "chapter_id": 23787, "verse_number": "२-२-३१-३", "content_sanskrit": "नरसिंह नमस्तुभ्यं यस्य ते क्षेत्र उत्तमे ।\nसहस्रं वाजिमेधस्य क्रतोश्चक्रे नृपोत्तमः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003787003, "chapter_id": 23787, "verse_number": "२-२-३१-४", "content_sanskrit": "इन्द्रद्युम्नः प्रसादात्ते तस्य क्रत्वंगसंभवे ।\nसरसि स्नातुमायातो मामनुज्ञापय प्रभो ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003787004, "chapter_id": 23787, "verse_number": "२-२-३१-५", "content_sanskrit": "ततस्तीर्थतटं गत्वा कृतशौचाचमक्रियः ।\nप्रार्थयेदंजलिं कृत्वा इमं मंत्रमुदीरयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003787005, "chapter_id": 23787, "verse_number": "२-२-३१-६", "content_sanskrit": "अश्वमेधांगगोकोटिखुरक्षुण्णमहीतलः ।\nतन्मूत्रफेनादानांभः पूरिताखिलपावनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003787006, "chapter_id": 23787, "verse_number": "२-२-३१-७", "content_sanskrit": "स्नातुं तवागतः पुण्ये सर्वतीर्थमये जले ।\nपूर्वजन्मसहस्रोत्थं पापं स्नानाद्विमोचय ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003787007, "chapter_id": 23787, "verse_number": "२-२-३१-८", "content_sanskrit": "अन्तः प्रविश्य च ततो वारुणैः पंचभिर्द्विजाः ।\nस्नायादन्तर्जले जप्यात्त्रिरावृत्त्याघमर्षणम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003787008, "chapter_id": 23787, "verse_number": "२-२-३१-९", "content_sanskrit": "अश्वमेधांगसंभूत तीर्थ सर्वाघनाशन ।\nजन्मकोटिभवं पापं त्वयि स्नानाद्विनश्यतु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003787009, "chapter_id": 23787, "verse_number": "२-२-३१-१०", "content_sanskrit": "इमं मन्त्रं त्रिरुच्चार्य त्रिः स्नायात्तज्जले द्विजाः ।\nसंस्मरेद्विष्णुगायत्र्या नरसिंहाकृतिं हरिम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003787010, "chapter_id": 23787, "verse_number": "२-२-३१-११", "content_sanskrit": "आपो नारा इति प्रोक्ता यस्मात्ता नरसूनवः ।\nअयनं प्रथमं चास्य तस्मादप्सु हरिं स्मरेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003787011, "chapter_id": 23787, "verse_number": "२-२-३१-१२", "content_sanskrit": "देवानृषीन्पितॄंश्चैव तर्पयेद्विधिवन्नरः ।\nनरसिंहं ततो गच्छेत्पश्चिमाभिमुखं स्थितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003787012, "chapter_id": 23787, "verse_number": "२-२-३१-१३", "content_sanskrit": "सिद्धं शंभुं कृत्रिमं वा पश्चिमाभिमुखं हरिम् ।\nदृष्ट्वा विमुच्यते पापैर्जन्मकोटिसमुद्भवैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003787013, "chapter_id": 23787, "verse_number": "२-२-३१-१४", "content_sanskrit": "तमाथर्वणमंत्रेण यजेच्च नरकेसरिम् ।\nनारदेन पुरा ह्येष मंत्रराजः प्रतिष्ठितः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003787014, "chapter_id": 23787, "verse_number": "२-२-३१-१५", "content_sanskrit": "इन्द्रद्युम्नेन तेनैव चिरादेष उपासितः ।\nनरसिंहाकृतौ नान्यो मंत्रस्तत्सदृशो द्विजाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003787015, "chapter_id": 23787, "verse_number": "२-२-३१-१६", "content_sanskrit": "यस्योच्चारणमात्रेण तुष्टो भवति केसरी ।\nअनेन दारुवर्ष्मापि ब्रह्मणा संप्रतिष्ठितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003787016, "chapter_id": 23787, "verse_number": "२-२-३१-१७", "content_sanskrit": "पूर्वोक्तैरुपचारैस्तु पूजयेन्नरकेसरिम् ।\nजपाप्रसूनैररुणैरन्यैश्चैव सुगंधिभिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003787017, "chapter_id": 23787, "verse_number": "२-२-३१-१८", "content_sanskrit": "चंदनागरुकर्पूरैर्लेपयेन्नरकेसरिम् ।\nपायसं सितया युक्तं सौरभेयेण सर्पिषा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003787018, "chapter_id": 23787, "verse_number": "२-२-३१-१९", "content_sanskrit": "कर्पूरखण्डसंयुक्तान्मोदकान्घृतपाचितान् ।\nसंयावान्घृतपूपांश्च फलं नानाविधं तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003787019, "chapter_id": 23787, "verse_number": "२-२-३१-२०", "content_sanskrit": "शर्करादधिसंयुक्तं शाल्यन्नं विनिवेदयेत् ।\nदृष्ट्वा स्पृष्ट्वा नमस्कृत्वा संपूज्य नरकेसरिम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003787020, "chapter_id": 23787, "verse_number": "२-२-३१-२१", "content_sanskrit": "स्वान्स्वानभीष्टानाप्नोति नरो वै नात्र संशयः ।\nदेवत्वममरेशत्वं गंधर्वत्वं च भो द्विजाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003787021, "chapter_id": 23787, "verse_number": "२-२-३१-२२", "content_sanskrit": "ईशित्वं च वशित्वं च सार्वभौमत्वमेव वा ।\nयद्यत्कामयते चित्ते तत्तदाप्नोत्यसंशयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003787022, "chapter_id": 23787, "verse_number": "२-२-३१-२३", "content_sanskrit": "पंचतीर्थीविधानं च कथितं पृच्छतां द्विजाः ।\nदिनानि पंच कृत्वैतां पञ्चभूतमये पुनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003787023, "chapter_id": 23787, "verse_number": "२-२-३१-२४", "content_sanskrit": "न देहे प्रविशेन्मर्त्यो व्रती विष्णुपरायणः ।\nपौर्णमास्यां प्रत्युषसि तीर्थराजजले पुनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003787024, "chapter_id": 23787, "verse_number": "२-२-३१-२५", "content_sanskrit": "पूर्वोक्तविधिना स्नात्वा शुद्धाहारो जितेंद्रियः ।\nएकभक्तव्रतेनैव वर्त्तते प्रीतये नरः ।\nयावत्पंच दिनानि स्युस्तावत्कालं द्विजोत्तमाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003787025, "chapter_id": 23787, "verse_number": "२-२-३१-२६", "content_sanskrit": "ततः प्रविश्यप्रासादं मंचस्थं पुरुषोत्तमम् ।\nरामं सुभद्रां दृष्ट्वा च मुच्यते पापकंचुकैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003787026, "chapter_id": 23787, "verse_number": "२-२-३१-२७", "content_sanskrit": "सर्वतीर्थमयात्कूपादुद्धृतेन सुगन्धिना ।\nवारिणा स्नाप्यमानं तु यो ज्यैष्ठ्यां पश्यते हरिम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003787027, "chapter_id": 23787, "verse_number": "२-२-३१-२८", "content_sanskrit": "न तस्य पापसंबंध आत्मनि प्रभविष्यति ।\nयात्राकर्तृविधिं वक्ष्ये शृणुध्वं मुनयः परम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003787028, "chapter_id": 23787, "verse_number": "२-२-३१-२९", "content_sanskrit": "चतुर्दश्यां दृढं मंचं कारयित्वा सुशोभनम् ।\nतृणकाष्ठमयं लिप्तं सुधया बहुलं शुभम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003787029, "chapter_id": 23787, "verse_number": "२-२-३१-३०", "content_sanskrit": "अथवा दार्षदं कुर्याच्चिरस्थायि द्विजोत्तमाः ।\nस्नानार्थं देवदेवस्य वित्तशाठ्यं न कारयेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003787030, "chapter_id": 23787, "verse_number": "२-२-३१-३१", "content_sanskrit": "नानाद्रुमगणाकीर्णं दक्षिणानिलशीतलम् ।\nउल्लसत्सिंधुकल्लोलशाड्वलोपरि संस्कृतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003787031, "chapter_id": 23787, "verse_number": "२-२-३१-३२", "content_sanskrit": "समुच्छ्रितमहामूल्यवितानवरशोभितम् ।\nविरलाच्छादनं कुर्याद्देवानां दर्शनाय वै ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003787032, "chapter_id": 23787, "verse_number": "२-२-३१-३३", "content_sanskrit": "आयांति ब्रह्मणा सार्द्धं स्नपनाय जगत्पतेः ।\nस्वर्गंगांभः समादाय पारिजातविभूषितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003787033, "chapter_id": 23787, "verse_number": "२-२-३१-३४", "content_sanskrit": "ब्रह्मर्षयश्च त्रिदशा ब्रह्मणा सहिता विभुम् ।\nमंचस्थं स्नापयन्तीह वचनात्परमेष्ठिनः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003787034, "chapter_id": 23787, "verse_number": "२-२-३१-३५", "content_sanskrit": "जयशब्दैश्च स्तुतिभिर्वंद्योऽयं त्रिदिवौकसाम् ।\nतस्मान्मंचस्तु कर्तव्यो मंडितो माल्यचामरैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003787035, "chapter_id": 23787, "verse_number": "२-२-३१-३६", "content_sanskrit": "नानामणिस्रजा हारिदुकूलकृततोरणम् ।\nसुगंधधूपसुरभिचंदनाभः समुक्षितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003787036, "chapter_id": 23787, "verse_number": "२-२-३१-३७", "content_sanskrit": "एवं मंचं प्रतिष्ठाप्य तस्य दक्षिणतो द्विजाः ।\nकूपाद्वारि समुद्धृत्य कलशान्स्वर्णनिर्मितान् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003787037, "chapter_id": 23787, "verse_number": "२-२-३१-३८", "content_sanskrit": "शालायां शास्त्रदृष्टेन विधिना त्वधिवासयेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003787038, "chapter_id": 23787, "verse_number": "२-२-३१-३९", "content_sanskrit": "सुवासितं जलं तेषु पावमान्या प्रपूरयेत् ।\nचतुर्दशीनिशामध्ये कर्मैतत्समुदाहृतम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003787039, "chapter_id": 23787, "verse_number": "२-२-३१-४०", "content_sanskrit": "शनैः शनैश्च नीयासुर्हरिं हलि पुरःसरम् ।\nब्राह्मणाः क्षत्रिया वैश्या राज्ञा संमानितादृताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003787040, "chapter_id": 23787, "verse_number": "२-२-३१-४१", "content_sanskrit": "चामरैस्तालवृन्तैश्च वीज्यमानं निरंतरम् ।\nपुराकृतामलेपं तं विष्णोरंगान्न हापयेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003787041, "chapter_id": 23787, "verse_number": "२-२-३१-४२", "content_sanskrit": "यथा सुगंधलेपेन सुपुष्टांगो दिने दिने ।\nतथा प्रयत्नतः कार्यः कृशांगो न हि पुष्टिकृत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003787042, "chapter_id": 23787, "verse_number": "२-२-३१-४३", "content_sanskrit": "नयेयुरप्रमाद्यंतो भगवंतमानदिताः ।\nप्रमादतो यदि भवेत्पतनं मुरवैरिणः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003787043, "chapter_id": 23787, "verse_number": "२-२-३१-४४", "content_sanskrit": "बलस्य वा सुभद्राया राज्ञो राज्यस्य भीतिकृत् ।\nअपि पातयतां हानिः संततेर्बहुदुःखिता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003787044, "chapter_id": 23787, "verse_number": "२-२-३१-४५", "content_sanskrit": "नरके नियतं वासो भवेत्तेषां दुरात्मनाम् ।\nविमुह्यंतश्चिराद्दारुमयीयं प्रतिमा कथम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003787045, "chapter_id": 23787, "verse_number": "२-२-३१-४६", "content_sanskrit": "तिष्ठेदविश्वसंतो ये भगवद्द्रोहिणस्तु ते ।\nनरकं प्रतिपद्यंते सर्वकर्मबहिष्कृताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003787046, "chapter_id": 23787, "verse_number": "२-२-३१-४७", "content_sanskrit": "मूढानां नास्तिकानां च कृतघ्नानां हतात्मनाम् ।\nधर्मकृत्येषु जायंते अविश्वासस्य युक्तयः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003787047, "chapter_id": 23787, "verse_number": "२-२-३१-४८", "content_sanskrit": "अदृष्टं यस्य यावद्धि स तु तेन विनिर्मितः ।\nतदंते तस्य क्षीयंते प्रासादप्रतिमादयः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003787048, "chapter_id": 23787, "verse_number": "२-२-३१-४९", "content_sanskrit": "न चायं निर्मितः केन द्रुमः सोऽपि प्रवर्द्धितः ।\nवरं ददाति या नूनं न चासौ प्रतिमा मता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003787049, "chapter_id": 23787, "verse_number": "२-२-३१-५०", "content_sanskrit": "निर्मितायां प्रतिकृतौ पुरा मन्वंतरादिषु ।\nव्यतीतेष्वपि वर्द्धंते जनानां च सुपर्वणाम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003787050, "chapter_id": 23787, "verse_number": "२-२-३१-५१", "content_sanskrit": "भक्तयस्तादृशो विप्राः सर्वेषां पृथिवीक्षिताम् ।\nस्वारोचिषेंऽतरे चैव आविर्भूतः कृपानिधिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003787051, "chapter_id": 23787, "verse_number": "२-२-३१-५२", "content_sanskrit": "वैवस्वतेंऽतरे सप्तविंशे चैव चतुर्युगे ।\nद्वापरांते समायातौ तदा कृष्णार्जुनावुभौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003787052, "chapter_id": 23787, "verse_number": "२-२-३१-५३", "content_sanskrit": "त्रिदिनानि स्थितावत्र व्रतस्थौ मधुसूदनम् ।\nभक्त्या संपूज्य तं स्तुत्वा जग्मतुर्द्वारकां पुनः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003787053, "chapter_id": 23787, "verse_number": "२-२-३१-५४", "content_sanskrit": "न केऽपि तत्त्वं जानंति मानुषीं तनुमास्थिताः ।\nअवताराः प्रवर्तंते विष्णोरस्य युगेयुगे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003787054, "chapter_id": 23787, "verse_number": "२-२-३१-५५", "content_sanskrit": "धर्मस्थापनया विप्रा लीयंते स्वपदे पुनः ।\nपूर्वं च ब्रह्मणा प्रोक्तः स चानेन परस्परम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003787055, "chapter_id": 23787, "verse_number": "२-२-३१-५६", "content_sanskrit": "स्थाता परार्द्धपर्यंतं भगवान्दारुरूपधृक् ।\nसदायं वरदो विष्णुः शुद्धसत्त्वेन भावितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003787056, "chapter_id": 23787, "verse_number": "२-२-३१-५७", "content_sanskrit": "यस्य यावांस्तु विश्वासस्तस्य सिद्धिस्तु तावती ।\nप्रमादीकृतविश्वासो भक्तो दृढमतिः पुमान् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003787057, "chapter_id": 23787, "verse_number": "२-२-३१-५८", "content_sanskrit": "यत्नानुरूपं लभते फलमस्मात्सुदुर्लभम् ।\nपुरा वः कथितं सर्वमंबरीषविमोचनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003787058, "chapter_id": 23787, "verse_number": "२-२-३१-५९", "content_sanskrit": "ततस्तस्मिञ्जगन्नाथे परमात्मस्वरूपिणि ।\nविधाय सुदृढां भक्तिं वसध्वं पुरुषोत्तमे ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003787059, "chapter_id": 23787, "verse_number": "२-२-३१-६०", "content_sanskrit": "अतोऽयं भक्तितो नेयः श्रीकृष्णमंच उत्तमः ।\nसुभद्राबलभद्रौ च राजवत्परिचर्य वै ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003787060, "chapter_id": 23787, "verse_number": "२-२-३१-६१", "content_sanskrit": "उत्तोलितेषु च्छत्रेषु चामरैर्वीजितेषु च ।\nकालागुरुसुधूपासु दिक्षु गंभीरनादिषु ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003787061, "chapter_id": 23787, "verse_number": "२-२-३१-६२", "content_sanskrit": "नानाविधेषु वाद्येषु त्वगारे परिपूरिते ।\nतौर्यत्रिके साधुवृत्ते दीपिका श्रेणिराजिते ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003787062, "chapter_id": 23787, "verse_number": "२-२-३१-६३", "content_sanskrit": "अंधकारेऽथ सर्वेषां वर्द्धमाने महोत्सवे ।\nआच्छन्ने श्रीपतेरंगे प्रमादपरिशंकया ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003787063, "chapter_id": 23787, "verse_number": "२-२-३१-६४", "content_sanskrit": "पटुपट्टदुकूलेषु नीयमानेषु दूरतः ।\nगतेर्वेगात्तदोत्तानीकृतास्ये जगतां गुरौ ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003787064, "chapter_id": 23787, "verse_number": "२-२-३१-६५", "content_sanskrit": "आवर्त्तदृष्टयो देवा दिवारोहणशंकिनः ।\nजयस्व राम कृष्णेति जय भद्रेति चोचिरे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003787065, "chapter_id": 23787, "verse_number": "२-२-३१-६६", "content_sanskrit": "एवं सलीलं भगवाञ्जन्मज्यैष्ठ्याभिषेचने ।\nनीयते मंचदेशं तु निशीथे ब्राह्मणादिभिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003787066, "chapter_id": 23787, "verse_number": "२-२-३१-६७", "content_sanskrit": "अहंपूर्विकशब्दस्तु देवानां श्रूयते दिवि ।\nदेवदुंदुभयश्चैव जयशब्दविमिश्रिताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003787067, "chapter_id": 23787, "verse_number": "२-२-३१-६८", "content_sanskrit": "ततो मंचस्थितं ब्रह्मरूपं प्रत्यर्चया सह ।\nआच्छाद्य सर्वाण्यंगानि मुखवर्जं सुचेलकैः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003787068, "chapter_id": 23787, "verse_number": "२-२-३१-६९", "content_sanskrit": "विना निवेद्यं संपूज्य उपचारैः पुरोदितैः ।\nअधिवासितकुंभैश्च शांतिघोषपुरःसरम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003787069, "chapter_id": 23787, "verse_number": "२-२-३१-७०", "content_sanskrit": "समुदज्येष्ठामंत्रेण स्नापयेत्सुरपुंगवान् ।\nपश्यतामभिषेक्तॄणां कृतकृत्यत्वहेतवे ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003787070, "chapter_id": 23787, "verse_number": "२-२-३१-७१", "content_sanskrit": "स्नाप्यमानं तु पश्यंति ये नरास्तत्र संस्थिताः ।\nगर्भोदकेन स्नपनं न ते पुनरवाप्नुयुः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003787071, "chapter_id": 23787, "verse_number": "२-२-३१-७२", "content_sanskrit": "ज्येष्ठस्नानं भगवतो ये पश्यंति मुदान्विताः ।\nन ते भवाब्धौ मज्जंति यात्रामुत्कंठमानसाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003787072, "chapter_id": 23787, "verse_number": "२-२-३१-७३", "content_sanskrit": "बुद्ध्यबुद्धिकृतः पुंसामनादिः पापसंचयः ।\nतत्क्षणान्नाशमायाति पश्यतां स्नपनं हरेः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003787073, "chapter_id": 23787, "verse_number": "२-२-३१-७४", "content_sanskrit": "सत्यं सत्यं पुनः सत्यं ब्रवीमि द्विजपुंगवाः ।\nसर्वसंतापशमनमशेषमलनाशनम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003787074, "chapter_id": 23787, "verse_number": "२-२-३१-७५", "content_sanskrit": "स्नपनं श्रीपतेर्ज्यैष्ठ्यां यदि भक्त्या विलोकनम् ।\nप्रायश्चित्तनिमित्तानि यानि पापानि संति वै ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003787075, "chapter_id": 23787, "verse_number": "२-२-३१-७६", "content_sanskrit": "तानि सर्वाणि क्षीयंते पश्यतां स्नपनं हरेः ।\nनातः परतरं कर्म ह्यनायासेन मोचनम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003787076, "chapter_id": 23787, "verse_number": "२-२-३१-७७", "content_sanskrit": "ज्येष्ठजन्मदिने स्नानं हरेर्यदवलोकितम् ।\nस्नानदानतपःश्राद्धजपयज्ञादयस्तु ये ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003787077, "chapter_id": 23787, "verse_number": "२-२-३१-७८", "content_sanskrit": "विधयः कोटिगुणिताः कोटिजन्मोपपादिताः ।\nस्नानदर्शनपुण्यस्य हरेस्ते न तुलां गताः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003787078, "chapter_id": 23787, "verse_number": "२-२-३१-७९", "content_sanskrit": "भक्त्या यः स्नपनं विष्णोरेकस्मिन्वत्सरेऽपि वा ।\nपश्येन्न शोचते विप्रा इह संसारमोचने ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003787079, "chapter_id": 23787, "verse_number": "२-२-३१-८०", "content_sanskrit": "तेनेष्टं क्रतुभिः पुण्यैः श्रद्धाविपुलदक्षिणैः ।\nमहादानानि दत्तानि भोजिताः कोटिशो द्विजाः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003787080, "chapter_id": 23787, "verse_number": "२-२-३१-८१", "content_sanskrit": "श्राद्धानि गयशीर्षादौ कोटिशश्च कृतानि वै ।\nपुण्यकाले च तीथार्दौ तपांसि चरितानि च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003787081, "chapter_id": 23787, "verse_number": "२-२-३१-८२", "content_sanskrit": "अर्धोदयादियोगेषु कोटितीर्थेषु कोटिशः ।\nस्नातानि तेन भो विप्रा यः पश्येत्स्नपनं हरेः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003787082, "chapter_id": 23787, "verse_number": "२-२-३१-८३", "content_sanskrit": "सत्यं सत्यं पुनः सत्यं ब्रवीमि द्विजपुंगवाः ।\nनातः श्रेयस्करं कर्म शास्त्रदृष्टपथिस्थितम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003787083, "chapter_id": 23787, "verse_number": "२-२-३१-८४", "content_sanskrit": "मञ्चस्थं स्नाप्यमानं हि यः पश्येत्पुरुषोत्तमम् ।\nस्नानाच्छतगुणं पुण्यं लभते वै न संशयः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003787084, "chapter_id": 23787, "verse_number": "२-२-३१-८५", "content_sanskrit": "मञ्चस्थितं जगन्नाथं स्नानार्द्रं यस्तु पश्यति ।\nसांद्रानन्दार्द्रचित्तोऽसौ न किंचित्पापमश्नुते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003787085, "chapter_id": 23787, "verse_number": "२-२-३१-८६", "content_sanskrit": "यदेव पुण्यमुदितं स्नानदर्शनकर्मणि ।\nतत्तत्फलमवाप्नोति दृष्ट्वा मञ्चस्थमच्युतम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003787086, "chapter_id": 23787, "verse_number": "२-२-३१-८७", "content_sanskrit": "एक एव जगन्नाथस्त्रिधा तत्र स्थितो द्विजाः ।\nएकैकस्यापि स्नपनदर्शनं भुक्तिमुक्तिदम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003787087, "chapter_id": 23787, "verse_number": "२-२-३१-८८", "content_sanskrit": "जयस्व रामभद्रेति जय भद्रेति यो वदेत् ।\nजय कृष्ण जगन्नाथ जयेत्युच्चारयेन्मुदा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003787088, "chapter_id": 23787, "verse_number": "२-२-३१-८९", "content_sanskrit": "स्नानकाले स वै मुक्तिं प्रयाति द्विजसत्तमाः ।\nअधिवासादिकं तत्र यैः कृतं स्नानकर्मणि ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003787089, "chapter_id": 23787, "verse_number": "२-२-३१-९०", "content_sanskrit": "तेषां श्रद्धामुदायुक्तः प्रदद्याद्दक्षिणाः पृथक् ।\nब्राह्मणेभ्यश्च मिष्टान्नं वस्त्रालंकरणानि च ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003787090, "chapter_id": 23787, "verse_number": "२-२-३१-९१", "content_sanskrit": "प्रदद्याच्छ्रद्धया युक्तो दीनानाथांश्च तर्पयेत् ।\nये द्रष्टुमागताः स्नानं जीवन्मुक्तास्तु ते ध्रुवम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003787091, "chapter_id": 23787, "verse_number": "२-२-३१-९२", "content_sanskrit": "तान्यथाशक्ति वै राजा मानयेत्प्रीतये हरेः ।\nस्नानावशेषतोयेन स्नायाद्भद्रासनस्थितः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003787092, "chapter_id": 23787, "verse_number": "२-२-३१-९३", "content_sanskrit": "नारी वा पुरुषो वापि तस्य पुण्यं वदामि वः ।\nकल्पः स्याच्चिररोगार्तो ह्यपमृत्युं जयेदसौ ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003787093, "chapter_id": 23787, "verse_number": "२-२-३१-९४", "content_sanskrit": "अपुत्रा मृतवत्सा वा वन्ध्या वापि लभेत्सुतम् ।\nसुभगः सर्वलोकानां निर्धनो धनवान्भवेत् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003787094, "chapter_id": 23787, "verse_number": "२-२-३१-९५", "content_sanskrit": "गुर्विणी लभते पुत्रं दीर्घायुर्गुणवत्तरम् ।\nगंगादिसर्वतीर्थानां स्नानजं फलमुच्यते ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003787095, "chapter_id": 23787, "verse_number": "२-२-३१-९६", "content_sanskrit": "स्नानदर्शनजं पुण्यं धर्मात्मा लभते ध्रुवम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003787096, "chapter_id": 23787, "verse_number": "२-२-३१-९७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्य एकत्रिंशोऽध्यायः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}]