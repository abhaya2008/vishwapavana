[{"id": 5000472000, "chapter_id": 9472, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे पञ्चषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000472001, "chapter_id": 9472, "verse_number": "६-६५-१", "content_sanskrit": "स तथोक्तस्तु निर्भर्त्स्य कुम्भकर्णो महोदरम्।\nअब्रवीद् राक्षसश्रेष्ठं भ्रातरं रावणं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000472002, "chapter_id": 9472, "verse_number": "६-६५-२", "content_sanskrit": "सोऽहं तव भयं घोरं वधात् तस्य दुरात्मनः।\nरामस्याद्य प्रमार्जामि निर्वैरो हि सुखी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000472003, "chapter_id": 9472, "verse_number": "६-६५-३", "content_sanskrit": "गर्जन्ति न वृथा शूरा निर्जला इव तोयदाः।\nपश्य सम्पद्यमानं तु गर्जितं युधि कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000472004, "chapter_id": 9472, "verse_number": "६-६५-४", "content_sanskrit": "न मर्षयन्ति चात्मानं सम्भावयितुमात्मना।\nअदर्शयित्वा शूरास्तु कर्म कुर्वन्ति दुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000472005, "chapter_id": 9472, "verse_number": "६-६५-५", "content_sanskrit": "विक्लवानां ह्यबुद्धीनां राज्ञां पण्डितमानिनाम्।\nरोचते त्वद्वचो नित्यं कथ्यमानं महोदर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000472006, "chapter_id": 9472, "verse_number": "६-६५-६", "content_sanskrit": "युद्धे कापुरुषैर्नित्यं भवद्भिः प्रियवादिभिः।\nराजानमनुगच्छद्भिः सर्वं कृत्यं विनाशितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000472007, "chapter_id": 9472, "verse_number": "६-६५-७", "content_sanskrit": "राजशेषा कृता लङ्का क्षीणः कोशो बलं हतम्।\nराजानमिममासाद्य सुहृच्चिह्नममित्रकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000472008, "chapter_id": 9472, "verse_number": "६-६५-८", "content_sanskrit": "एष निर्याम्यहं युद्धमुद्यतः शत्रुनिर्जये।\nदुर्नयं भवतामद्य समीकर्तुं महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000472009, "chapter_id": 9472, "verse_number": "६-६५-९", "content_sanskrit": "एवमुक्तवतो वाक्यं कुम्भकर्णस्य धीमतः।\nप्रत्युवाच ततो वाक्यं प्रहसन् राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000472010, "chapter_id": 9472, "verse_number": "६-६५-१०", "content_sanskrit": "महोदरोऽयं रामात् तु परित्रस्तो न संशयः।\nन हि रोचयते तात युद्धं युद्धविशारद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000472011, "chapter_id": 9472, "verse_number": "६-६५-११", "content_sanskrit": "कश्चिन्मे त्वत्समो नास्ति सौहृदेन बलेन च।\nगच्छ शत्रुवधाय त्वं कुम्भकर्ण जयाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000472012, "chapter_id": 9472, "verse_number": "६-६५-१२", "content_sanskrit": "शयानः शत्रुनाशार्थं भवान् सम्बोधितो मया।\nअयं हि कालः सुमहान् राक्षसानामरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000472013, "chapter_id": 9472, "verse_number": "६-६५-१३", "content_sanskrit": "संगच्छ शूलमादाय पाशहस्त इवान्तकः।\nवानरान् राजपुत्रौ च भक्षयादित्यतेजसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000472014, "chapter_id": 9472, "verse_number": "६-६५-१४", "content_sanskrit": "समालोक्य तु ते रूपं विद्रविष्यन्ति वानराः।\nरामलक्ष्मणयोश्चापि हृदये प्रस्फुटिष्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000472015, "chapter_id": 9472, "verse_number": "६-६५-१५", "content_sanskrit": "एवमुक्त्वा महातेजाः कुम्भकर्णं महाबलम्।\nपुनर्जातमिवात्मानं मेने राक्षसपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000472016, "chapter_id": 9472, "verse_number": "६-६५-१६", "content_sanskrit": "कुम्भकर्णबलाभिज्ञो जानंस्तस्य पराक्रमम्।\nबभूव मुदितो राजा शशाङ्क इव निर्मलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000472017, "chapter_id": 9472, "verse_number": "६-६५-१७", "content_sanskrit": "इत्येवमुक्तः संहृष्टो निर्जगाम महाबलः।\nराज्ञस्तु वचनं श्रुत्वा योद्धुमुद्युक्तवांस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000472018, "chapter_id": 9472, "verse_number": "६-६५-१८", "content_sanskrit": "आददे निशितं शूलं वेगाच्छत्रुनिबर्हणः।\nसर्वं कालायसं दीप्तं तप्तकाञ्चनभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000472019, "chapter_id": 9472, "verse_number": "६-६५-१९", "content_sanskrit": "इन्द्राशनिसमप्रख्यं वज्रप्रतिमगौरवम्।\nदेवदानवगन्धर्वयक्षपन्नगसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000472020, "chapter_id": 9472, "verse_number": "६-६५-२०", "content_sanskrit": "रक्तमाल्यमहादामं स्वतश्चोद‍्गतपावकम्।\nआदाय विपुलं शूलं शत्रुशोणितरञ्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000472021, "chapter_id": 9472, "verse_number": "६-६५-२१", "content_sanskrit": "कुम्भकर्णो महातेजा रावणं वाक्यमब्रवीत्।\nगमिष्याम्यहमेकाकी तिष्ठत्विह बलं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000472022, "chapter_id": 9472, "verse_number": "६-६५-२२", "content_sanskrit": "अद्य तान् क्षुधितः क्रुद्धो भक्षयिष्यामि वानरान्।\nकुम्भकर्णवचः श्रुत्वा रावणो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000472023, "chapter_id": 9472, "verse_number": "६-६५-२३", "content_sanskrit": "सैन्यैः परिवृतो गच्छ शूलमुद‍्गरपाणिभिः।\nवानरा हि महात्मानः शूराः सुव्यवसायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000472024, "chapter_id": 9472, "verse_number": "६-६५-२४", "content_sanskrit": "एकाकिनं प्रमत्तं वा नयेयुर्दशनैः क्षयम्।\nतस्मात् परमदुर्धर्षः सैन्यैः परिवृतो व्रज।\nरक्षसामहितं सर्वं शत्रुपक्षं निषूदय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000472025, "chapter_id": 9472, "verse_number": "६-६५-२५", "content_sanskrit": "अथासनात् समुत्पत्य स्रजं मणिकृतान्तराम्।\nआबबन्ध महातेजाः कुम्भकर्णस्य रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000472026, "chapter_id": 9472, "verse_number": "६-६५-२६", "content_sanskrit": "अङ्गदान्यङ्गुलीवेष्टान् वराण्याभरणानि च।\nहारं च शशिसंकाशमाबबन्ध महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000472027, "chapter_id": 9472, "verse_number": "६-६५-२७", "content_sanskrit": "दिव्यानि च सुगन्धीनि माल्यदामानि रावणः।\nगात्रेषु सज्जयामास श्रोत्रयोश्चास्य कुण्डले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000472028, "chapter_id": 9472, "verse_number": "६-६५-२८", "content_sanskrit": "काञ्चनाङ्गदकेयूरनिष्काभरणभूषितः।\nकुम्भकर्णो बृहत्कर्णः सुहुतोऽग्निरिवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000472029, "chapter_id": 9472, "verse_number": "६-६५-२९", "content_sanskrit": "श्रोणीसूत्रेण महता मेचकेन व्यराजत।\nअमृतोत्पादने नद्धो भुजङ्गेनेव मन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000472030, "chapter_id": 9472, "verse_number": "६-६५-३०", "content_sanskrit": "स काञ्चनं भारसहं निवातं\nविद्युत्प्रभं दीप्तमिवात्मभासा।\nआबध्यमानः कवचं रराज\nसंध्याभ्रसंवीत इवाद्रिराजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000472031, "chapter_id": 9472, "verse_number": "६-६५-३१", "content_sanskrit": "सर्वाभरणसर्वाङ्गः शूलपाणिः स राक्षसः।\nत्रिविक्रमकृतोत्साहो नारायण इवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000472032, "chapter_id": 9472, "verse_number": "६-६५-३२", "content_sanskrit": "भ्रातरं सम्परिष्वज्य कृत्वा चापि प्रदक्षिणम्।\nप्रणम्य शिरसा तस्मै प्रतस्थे स महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000472033, "chapter_id": 9472, "verse_number": "६-६५-३३", "content_sanskrit": "तमाशीर्भिः प्रशस्ताभिः प्रेषयामास रावणः।\nशङ्खदुन्दुभिनिर्घोषैः सैन्यैश्चापि वरायुधैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000472034, "chapter_id": 9472, "verse_number": "६-६५-३४", "content_sanskrit": "तं गजैश्च तुरंगैश्च स्यन्दनैश्चाम्बुदस्वनैः।\nअनुजग्मुर्महात्मानो रथिनो रथिनां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000472035, "chapter_id": 9472, "verse_number": "६-६५-३५", "content_sanskrit": "सर्पैरुष्ट्रैः खरैश्चैव सिंहद्विपमृगद्विजैः।\nअनुजग्मुश्च तं घोरं कुम्भकर्णं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000472036, "chapter_id": 9472, "verse_number": "६-६५-३६", "content_sanskrit": "स पुष्पवर्षैरवकीर्यमाणो\nधृतातपत्रः शितशूलपाणिः।\nमदोत्कटः शोणितगन्धमत्तो\nविनिर्ययौ दानवदेवशत्रुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000472037, "chapter_id": 9472, "verse_number": "६-६५-३७", "content_sanskrit": "पदातयश्च बहवो महानादा महाबलाः।\nअन्वयू राक्षसा भीमा भीमाक्षाः शस्त्रपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000472038, "chapter_id": 9472, "verse_number": "६-६५-३८", "content_sanskrit": "रक्ताक्षाः सुबहुव्यामा नीलाञ्जनचयोपमाः।\nशूलानुद्यम्य खड्गांश्च निशितांश्च परश्वधान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000472039, "chapter_id": 9472, "verse_number": "६-६५-३९", "content_sanskrit": "भिन्दिपालांश्च परिघान् गदाश्च मुसलानि च।\nतालस्कन्धांश्च विपुलान् क्षेपणीयान् दुरासदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000472040, "chapter_id": 9472, "verse_number": "६-६५-४०", "content_sanskrit": "अथान्यद्वपुरादाय दारुणं घोरदर्शनम्।\nनिष्पपात महातेजाः कुम्भकर्णो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000472041, "chapter_id": 9472, "verse_number": "६-६५-४१", "content_sanskrit": "धनुःशतपरीणाहः स षट्शतसमुच्छ्रितः।\nरौद्रः शकटचक्राक्षो महापर्वतसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000472042, "chapter_id": 9472, "verse_number": "६-६५-४२", "content_sanskrit": "संनिपत्य च रक्षांसि दग्धशैलोपमो महान्।\nकुम्भकर्णो महावक्त्रः प्रहसन्निदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000472043, "chapter_id": 9472, "verse_number": "६-६५-४३", "content_sanskrit": "अद्य वानरमुख्यानां तानि यूथानि भागशः।\nनिर्दहिष्यामि संक्रुद्धः पतङ्गानिव पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000472044, "chapter_id": 9472, "verse_number": "६-६५-४४", "content_sanskrit": "नापराध्यन्ति मे कामं वानरा वनचारिणः।\nजातिरस्मद्विधानां सा पुरोद्यानविभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000472045, "chapter_id": 9472, "verse_number": "६-६५-४५", "content_sanskrit": "पुररोधस्य मूलं तु राघवः सहलक्ष्मणः।\nहते तस्मिन् हतं सर्वं तं वधिष्यामि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000472046, "chapter_id": 9472, "verse_number": "६-६५-४६", "content_sanskrit": "एवं तस्य ब्रुवाणस्य कुम्भकर्णस्य राक्षसाः।\nनादं चक्रुर्महाघोरं कम्पयन्त इवार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000472047, "chapter_id": 9472, "verse_number": "६-६५-४७", "content_sanskrit": "तस्य निष्पततस्तूर्णं कुम्भकर्णस्य धीमतः।\nबभूवुर्घोररूपाणि निमित्तानि समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000472048, "chapter_id": 9472, "verse_number": "६-६५-४८", "content_sanskrit": "उल्काशनियुता मेघा बभूवुर्गर्दभारुणाः।\nससागरवना चैव वसुधा समकम्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000472049, "chapter_id": 9472, "verse_number": "६-६५-४९", "content_sanskrit": "घोररूपाः शिवा नेदुः सज्वालकवलैर्मुखैः।\nमण्डलान्यपसव्यानि बबन्धुश्च विहंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000472050, "chapter_id": 9472, "verse_number": "६-६५-५०", "content_sanskrit": "निष्पपात च गृध्रोऽस्य शूले वै पथि गच्छतः।\nप्रास्फुरन्नयनं चास्य सव्यो बाहुरकम्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000472051, "chapter_id": 9472, "verse_number": "६-६५-५१", "content_sanskrit": "निष्पपात तदा चोल्का ज्वलन्ती भीमनिःस्वना।\nआदित्यो निष्प्रभश्चासीन्न वाति च सुखोऽनिलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000472052, "chapter_id": 9472, "verse_number": "६-६५-५२", "content_sanskrit": "अचिन्तयन् महोत्पातानुदितान् रोमहर्षणान्।\nनिर्ययौ कुम्भकर्णस्तु कृतान्तबलचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000472053, "chapter_id": 9472, "verse_number": "६-६५-५३", "content_sanskrit": "स लङ्घयित्वा प्राकारं पद‍्भ्यां पर्वतसंनिभः।\nददर्शाभ्रघनप्रख्यं वानरानीकमद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000472054, "chapter_id": 9472, "verse_number": "६-६५-५४", "content_sanskrit": "ते दृष्ट्वा राक्षसश्रेष्ठं वानराः पर्वतोपमम्।\nवायुनुन्ना इव घना ययुः सर्वा दिशस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000472055, "chapter_id": 9472, "verse_number": "६-६५-५५", "content_sanskrit": "तद् वानरानीकमतिप्रचण्डं\nदिशो द्रवद्भिन्नमिवाभ्रजालम्।\nस कुम्भकर्णः समवेक्ष्य हर्षा-\nन्ननाद भूयो घनवद्घनाभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000472056, "chapter_id": 9472, "verse_number": "६-६५-५६", "content_sanskrit": "ते तस्य घोरं निनदं निशम्य\nयथा निनादं दिवि वारिदस्य।\nपेतुर्धरण्यां बहवः प्लवङ्गा\nनिकृत्तमूला इव शालवृक्षाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000472057, "chapter_id": 9472, "verse_number": "६-६५-५७", "content_sanskrit": "विपुलपरिघवान् स कुम्भकर्णो\nरिपुनिधनाय विनिःसृतो महात्मा।\nकपिगणभयमाददत् सुभीमं\nप्रभुरिव किंकरदण्डवान् युगान्ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000472058, "chapter_id": 9472, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]