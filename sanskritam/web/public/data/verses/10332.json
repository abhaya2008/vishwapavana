[{"id": 6000332000, "chapter_id": 10332, "verse_number": null, "content_sanskrit": "अथ एकत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000332001, "chapter_id": 10332, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.001.m4a", "display_order": 2}, {"id": 6000332002, "chapter_id": 10332, "verse_number": "११-३१-१", "content_sanskrit": "अथ तत्रागमद् ब्रह्मा भवान्या च समं भवः।\nमहेन्द्रप्रमुखा देवा मुनयः सप्रजेश्वराः॥ ११/३१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.002.m4a", "display_order": 3, "topics": [{"text": "शुकाचार्येण परीक्षितं प्रति भगवतः स्वलोकगमनस्य ततो वसुदेवादीनां स्वस्वमूलरूपप्राप्तेश्च कथनम्", "range": "१–२८"}]}, {"id": 6000332003, "chapter_id": 10332, "verse_number": "११-३१-२", "content_sanskrit": "पितरः सिद्धगन्धर्वा विद्याधरमहोरगाः।\nचारणा यक्षरक्षांसि किन्नराप्सरसो द्विजाः॥ ११/३१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.003.m4a", "display_order": 4}, {"id": 6000332004, "chapter_id": 10332, "verse_number": "११-३१-३", "content_sanskrit": "द्रष्टुकामा भगवतो निर्याणं परमोत्सुकाः।\nगायन्तश्च गृणन्तश्च शौरेः कर्माणि जन्म च॥ ११/३१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.004.m4a", "display_order": 5}, {"id": 6000332005, "chapter_id": 10332, "verse_number": "११-३१-४", "content_sanskrit": "ववृषुः पुष्पवर्षाणि विमानावलिभिर्नभः।\nकुर्वन्तः सङ्कुलं राजन् भक्त्या परमया युताः॥ ११/३१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.005.m4a", "display_order": 6}, {"id": 6000332006, "chapter_id": 10332, "verse_number": "११-३१-५", "content_sanskrit": "भगवानपि तान् वीक्ष्य विभूतीरात्मनो विभुः।\nसंयोज्यात्मनि चात्मानं पद्मनेत्रे न्यमीलयत्॥ ११/३१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.006.m4a", "display_order": 7}, {"id": 6000332007, "chapter_id": 10332, "verse_number": "११-३१-६", "content_sanskrit": "लोकाभिरामां स्वतनुं धारणाध्यानमङ्गलाम्।\nयोगधारणयाऽऽग्नेय्याऽदग्ध्वा धामाविशत् स्वकम्॥ ११/३१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.007.m4a", "display_order": 8}, {"id": 6000332008, "chapter_id": 10332, "verse_number": "११-३१-७", "content_sanskrit": "दिवि दुन्दुभयो नेदुः पेतुः सुमनसश्च खात्।\nसत्यं धर्मो धृतिर्भूतिः कीर्तिः श्रीश्चानु तं ययुः॥ ११/३१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.008.m4a", "display_order": 9}, {"id": 6000332009, "chapter_id": 10332, "verse_number": "११-३१-८", "content_sanskrit": "देवादयो ब्रह्ममुखा आविशन्तं स्वधामनि।\nअविज्ञातगतिं कृष्णं दद्दशुश्चातिविस्मिताः॥ ११/३१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.009.m4a", "display_order": 10}, {"id": 6000332010, "chapter_id": 10332, "verse_number": "११-३१-९", "content_sanskrit": "सौदामिन्या यथाऽऽकाशे यान्त्या भित्त्वाऽभ्रमण्डलम्।\nगतिर्न लक्ष्यते मर्त्यैस्तथा कृष्णस्य दैवतैः॥ ११/३१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.010.m4a", "display_order": 11}, {"id": 6000332011, "chapter_id": 10332, "verse_number": "११-३१-१०", "content_sanskrit": "ब्रह्मरुद्रादयस्ते तु दृष्ट्वा योगगतिं हरेः।\nविस्मितास्तां प्रशंसन्तः स्वंस्वं लोकं ययुस्तदा॥ ११/३१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.011.m4a", "display_order": 12}, {"id": 6000332012, "chapter_id": 10332, "verse_number": "११-३१-११", "content_sanskrit": "राजन् परस्य तनुभृज्जननाप्ययेहां मायाविडम्बनमवैहि यथा नटस्य।\nसृष्ट्वाऽऽत्मनेदमनुविश्य विहृत्य चान्ते संहृत्य चात्ममहिमोपरतः स आस्ते॥ ११/३१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.012.m4a", "display_order": 13}, {"id": 6000332013, "chapter_id": 10332, "verse_number": "११-३१-१२", "content_sanskrit": "मर्त्येन यो गुरुसुतं यमनीतलोकं त्वां चानयच्छरणदः परमास्त्रदग्धम्।\nजिग्ये पुरेऽन्तकमपीशतनावनीशः किं स्वावने स्वरनयन् मृगयोः स्वदेहे॥ ११/३१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.013.m4a", "display_order": 14}, {"id": 6000332014, "chapter_id": 10332, "verse_number": "११-३१-१३", "content_sanskrit": "तथाप्यशेषस्थितिसम्भवाप्ययेषु अनन्यहेतुर्यदशेषशक्तिधृक् ।\nनैच्छत् प्रणेतुं वपुरत्र शेषितं मर्त्येन किं स्वस्य गतिं प्रदर्शयन्॥ ११/३१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.014.m4a", "display_order": 15}, {"id": 6000332015, "chapter_id": 10332, "verse_number": "११-३१-१४", "content_sanskrit": "य एतां प्रातरुत्थाय कृष्णस्य पदवीं पराम्।\nप्रयतः कीर्तयेद् भक्त्या तामेवाप्नोत्यनुत्तमाम्॥ ११/३१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.015.m4a", "display_order": 16}, {"id": 6000332016, "chapter_id": 10332, "verse_number": "११-३१-१५", "content_sanskrit": "दारुको द्वारकामेत्य वसुदेवोग्रसेनयोः।\nपतित्वा चरणावस्रैर्न्यषिञ्चत् कृष्णविच्युतः॥ ११/३१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.016.m4a", "display_order": 17}, {"id": 6000332017, "chapter_id": 10332, "verse_number": "११-३१-१६", "content_sanskrit": "कथयामास निधनं वृष्णीनां कृत्स्नशो नृप।\nतच्छ्रुत्वोद्विग्नहृदया जनाः शोकविमूर्च्छिताः॥ ११/३१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.017.m4a", "display_order": 18}, {"id": 6000332018, "chapter_id": 10332, "verse_number": "११-३१-१७", "content_sanskrit": "तत्र वै त्वरिता जग्मुः कृष्णविश्लेषविह्वलाः।\nव्यसवः शेरते यत्र ज्ञातयो घ्नन्त आयुधैः॥ ११/३१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.018.m4a", "display_order": 19}, {"id": 6000332019, "chapter_id": 10332, "verse_number": "११-३१-१८", "content_sanskrit": "देवकी रोहिणी चैव वसुदेवस्तथा सुतौ।\nकृष्णरामावपश्यन्तः शोकार्ता विजहुः स्मृतिम्॥ ११/३१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.019.m4a", "display_order": 20}, {"id": 6000332020, "chapter_id": 10332, "verse_number": "११-३१-१९", "content_sanskrit": "प्राणांश्च विजहुस्तत्र भगवद्विरहातुराः।\nउपगुह्य पतींस्तात चितामारुरुहुः स्त्रियः॥ ११/३१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.020.m4a", "display_order": 21}, {"id": 6000332021, "chapter_id": 10332, "verse_number": "११-३१-२०", "content_sanskrit": "रामपत्न्यश्च तं देहमुपगुह्याग्निमाविशन्। वसुदेवपत्न्यस्तद्गात्रं प्रद्युम्नादीन् हरेः स्नुषाः।\nकृष्णपत्न्योऽविशन्नग्निं रुग्मिण्याद्यास्तदात्मिकाः॥ ११/३१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.021.m4a", "display_order": 22}, {"id": 6000332022, "chapter_id": 10332, "verse_number": "११-३१-२१", "content_sanskrit": "अर्जुनः प्रेयसः सख्युः कृष्णस्य विरहातुरः।\nआत्मानं सान्त्वयामास कृष्णगीतैः सदुक्तिभिः॥ ११/३१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.022.m4a", "display_order": 23}, {"id": 6000332023, "chapter_id": 10332, "verse_number": "११-३१-२२", "content_sanskrit": "बन्धूनां नष्टगोत्राणामर्जुनः साम्परायिकम्।\nहतानां कारयामास यथावदनुपूर्वशः॥ ११/३१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.023.m4a", "display_order": 24}, {"id": 6000332024, "chapter_id": 10332, "verse_number": "११-३१-२३", "content_sanskrit": "द्वारकां हरिणा त्यक्तां समुद्रोऽप्लावयत् क्षणात्।\nवर्जयित्वा महाराज श्रीमद्भगवदालयम्॥ ११/३१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.024.m4a", "display_order": 25}, {"id": 6000332025, "chapter_id": 10332, "verse_number": "११-३१-२४", "content_sanskrit": "नित्यं सन्निहितस्तत्र भगवान् मधुसूदनः।\nस्मृत्याऽशेषाशुभहरः सर्वमङ्गलमङ्गलः॥ ११/३१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.025.m4a", "display_order": 26}, {"id": 6000332026, "chapter_id": 10332, "verse_number": "११-३१-२५", "content_sanskrit": "स्त्रीबालवृद्धानादाय हतशेषान् धनञ्जयः।\nइन्द्रप्रस्थं समावेश्य वज्रं तत्राभ्यषेचयत्॥ ११/३१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.026.m4a", "display_order": 27}, {"id": 6000332027, "chapter_id": 10332, "verse_number": "११-३१-२६", "content_sanskrit": "श्रुत्वा सुहृद्वधं राजन्नर्जुनात् ते पितामहाः।\nत्वां तु वंशधरं कृत्वा जग्मुः सर्वे महापथम्॥ ११/३१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.027.m4a", "display_order": 28}, {"id": 6000332028, "chapter_id": 10332, "verse_number": "११-३१-२७", "content_sanskrit": "य एतद् देवदेवस्य विष्णोः कर्माणि जन्म च।\nकीर्तयेच्छ्रद्धया मर्त्यः सर्वपापैः प्रमुच्यते॥ ११/३१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.028.m4a", "display_order": 29}, {"id": 6000332029, "chapter_id": 10332, "verse_number": "११-३१-२८", "content_sanskrit": "इत्थं हरेर्भगवतो रुचिरावतारं वीर्याणि चास्य चरितानि च सत्तमानि।\nअन्यत्र चेह च श्रुतानि गृणन् मनुष्यो भक्तिं परां परमंहसगतौ लभेत॥ ११/३१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_031/BhP_11.031.029.m4a", "display_order": 30}, {"id": 6000332030, "chapter_id": 10332, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे एकत्रिंशाध्यायः॥\n॥ समाप्तश्चायं स्कन्धः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]