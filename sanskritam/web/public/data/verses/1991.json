[{"id": 2044141, "chapter_id": 1991, "verse_number": "६-४०-०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044142, "chapter_id": 1991, "verse_number": "६-४०-१", "content_sanskrit": "अभयं सत्वसंशुद्धिर्ज्ञानयोगव्यवस्थितिः ।\nदानं दमश्च यज्ञश्च स्वाध्यायस्तप आर्जवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044143, "chapter_id": 1991, "verse_number": "६-४०-२", "content_sanskrit": "अहिंसा सत्यमक्रोधस्त्यागः शान्तिरपैशुनम् ।\nदया भूतेष्वलोलुत्वं मार्दवं ह्रीरचापलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044144, "chapter_id": 1991, "verse_number": "६-४०-३", "content_sanskrit": "तेजः क्षमा धृतिः शौचमद्रोहो नातिमानिता ।\nभवन्ति संपदं दैवीमभिजातस्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044145, "chapter_id": 1991, "verse_number": "६-४०-४", "content_sanskrit": "दम्भो दर्पोऽभिमानश्च क्रोधः पारुष्यमेव च ।\nअज्ञानं चाभिजातस्य पार्थ संपदमासुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044146, "chapter_id": 1991, "verse_number": "६-४०-५", "content_sanskrit": "दैवी संपद्विमोक्षाय निबन्धायासुरी मता।\nमा शुचः संपदं दैवीमभिजातोऽसि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044147, "chapter_id": 1991, "verse_number": "६-४०-६", "content_sanskrit": "द्वौ भूतसर्गौ लोकेऽस्मिन्दैव आसुर एव च।\nदैवो विस्तरशः प्रोक्त आसुरं पार्थ मे शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044148, "chapter_id": 1991, "verse_number": "६-४०-७", "content_sanskrit": "प्रवृत्तिं च निवृत्तिं च जना न विदुरासुराः।\nन शौचं नापि चाचारो न सत्यं तेषु विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044149, "chapter_id": 1991, "verse_number": "६-४०-८", "content_sanskrit": "असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम् ।\nअपरस्परसंभूतं किमन्यत्कामहैतुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044150, "chapter_id": 1991, "verse_number": "६-४०-९", "content_sanskrit": "एतां दृष्टिमवष्टभ्य नष्टात्मानोऽल्पबुद्धयः ।\nप्रभवन्त्युग्रकर्माणः क्षयाय जगतोऽहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044151, "chapter_id": 1991, "verse_number": "६-४०-१०", "content_sanskrit": "काममाश्रित्य दुष्पूरं दम्भमानमदान्विताः ।\nमोहाद्गृहीत्वाऽसद्ग्राहान्प्रवर्तन्तेऽशुचिव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044152, "chapter_id": 1991, "verse_number": "६-४०-११", "content_sanskrit": "चिन्तामपरिमेयां च प्रलयान्तामुपाश्रिताः।\nकामोपभोगपरमा एतावदिति निश्चिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044153, "chapter_id": 1991, "verse_number": "६-४०-१२", "content_sanskrit": "आशापाशशतैर्बद्धाः कामक्रोधपरायणाः ।\nईहन्तो कामभोगार्थमन्यायेनार्थसंचयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044154, "chapter_id": 1991, "verse_number": "६-४०-१३", "content_sanskrit": "इदमद्य मया लब्धमिमं प्राप्स्ये मनोरथम् ।\nइदमस्तीदमपि मे भविष्यति पुनर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044155, "chapter_id": 1991, "verse_number": "६-४०-१४", "content_sanskrit": "असौ मया हतः शत्रुर्हनिष्ये चापरानपि।\nईश्वरोऽहमहं भोगी सिद्धोऽहं बलवान्सुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044156, "chapter_id": 1991, "verse_number": "६-४०-१५", "content_sanskrit": "आढ्योऽभिजनवानस्मि कोऽन्योस्ति सदृशो मया ।\nयक्ष्ये दास्यामि मोदिष्य इत्यज्ञानविमोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044157, "chapter_id": 1991, "verse_number": "६-४०-१६", "content_sanskrit": "अनेकचित्तविभ्रान्त मोहजालसमावृताः ।\nप्रसक्ताः कामभोगेषु पतन्ति नरकेऽशुचौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044158, "chapter_id": 1991, "verse_number": "६-४०-१७", "content_sanskrit": "आत्मसंभाविताः स्तब्धा धनमानमदान्विताः ।\nयजन्ते नामयज्ञैस्ते दम्भेनाविधिपूर्वकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044159, "chapter_id": 1991, "verse_number": "६-४०-१८", "content_sanskrit": "अहङ्कारं बलं दर्पं कामं क्रोधं च संश्रिताः ।\nमामत्मपरदेहेषु प्रद्विषन्तोऽभ्यसूयकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044160, "chapter_id": 1991, "verse_number": "६-४०-१९", "content_sanskrit": "तानहं द्विषतः क्रूरान्संसारेषु नराधमान् ।\nक्षिपाम्यजस्रमशुभानासुरीष्वेव योनिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044161, "chapter_id": 1991, "verse_number": "६-४०-२०", "content_sanskrit": "आसुरीं योनिमापन्ना मूढा जन्मनिजन्मनि ।\nमामप्राप्यैव कौन्तेय ततो यान्त्यधमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044162, "chapter_id": 1991, "verse_number": "६-४०-२१", "content_sanskrit": "त्रिविधं नरकस्येदं द्वारं नाशनमात्मनः ।\nकामः क्रोधस्तथा लोभस्तस्मादेतत्रयं त्यजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044163, "chapter_id": 1991, "verse_number": "६-४०-२२", "content_sanskrit": "एतैर्विमुक्तः कौन्तेय तमोद्वारैस्त्रिभिर्नरः ।\nआचरत्यात्मनः श्रेयस्ततो याति परां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044164, "chapter_id": 1991, "verse_number": "६-४०-२३", "content_sanskrit": "यः शास्त्रविधिमुत्सृज्य वर्तते कामकारतः।\nन स सिद्धिमवाप्नोति न सुखं न परां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044165, "chapter_id": 1991, "verse_number": "६-४०-२४", "content_sanskrit": "तस्माच्छास्त्रं प्रमाणं ते कार्याकार्यव्यवस्थितौ ।\nज्ञात्वा शास्त्रविधानोक्तं कर्म कर्तुमिहार्हसि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044166, "chapter_id": 1991, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि चत्वारिंशोऽध्यायः ॥\nइति श्रीमन्मद्भगवद्गीतासूपनिषत्सु ब्रह्मविद्यायां योगशास्त्रे श्रीकृष्णार्जुनसंवादे देवासुरसंपद्विभागयोगोनाम षोडशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]