[{"id": 2018886, "chapter_id": 1395, "verse_number": "३-३३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018887, "chapter_id": 1395, "verse_number": "३-३३-१", "content_sanskrit": "याज्ञसेन्या वचः श्रुत्वा भीमसेनो ह्यमर्षणः।\nनिश्वसन्नुपसंगम्य क्रुद्धो राजानमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018888, "chapter_id": 1395, "verse_number": "३-३३-२", "content_sanskrit": "राजन्सत्पदवीं धर्म्यां व्रज सत्पुरुषोचिताम्।\nधर्मकामार्थहीनानां किं नो वस्तुं तपोवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018889, "chapter_id": 1395, "verse_number": "३-३३-३", "content_sanskrit": "नैव धर्मेण तद्राज्यं नार्जवेण न चौजसा।\nअक्षकूटमधिष्ठाय हृतं दुर्योधनेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018890, "chapter_id": 1395, "verse_number": "३-३३-४", "content_sanskrit": "गोमायुनेव सिंहानां दिर्बलेन बलीयसाम्।\nआमिपं विघसाशेन तद्वद्राज्यं हि नो हृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018891, "chapter_id": 1395, "verse_number": "३-३३-५", "content_sanskrit": "धर्मलेशप्रतिच्छन्नः प्रभवं धर्मकामयोः।\nअर्थमुत्सृज्य किं राजन्दुःखेन परितप्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018892, "chapter_id": 1395, "verse_number": "३-३३-६", "content_sanskrit": "भवतोऽनुविधानेन राज्यं नः पश्यतां हृतम्।\nअहार्यमपि शक्रेण गुप्तं गाण्डीवधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018893, "chapter_id": 1395, "verse_number": "३-३३-७", "content_sanskrit": "कुणीनामिव बिल्वानि पङ्गूनामिव धेनवः।\nहृतमैश्वर्यमस्माकं जीवतां भवतः कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018894, "chapter_id": 1395, "verse_number": "३-३३-८", "content_sanskrit": "भवतः प्रियमित्येवं महद्व्यसनमीदृशम्।\nधर्मकामे प्रतीतस्य प्रतिपन्नाः स्म भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018895, "chapter_id": 1395, "verse_number": "३-३३-९", "content_sanskrit": "कर्शयामः स्वमित्राणि नन्दयामश्च शात्रवान्।\nआत्मानं भवतः शास्त्रैर्नियम्य भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018896, "chapter_id": 1395, "verse_number": "३-३३-१०", "content_sanskrit": "यद्वयं न तदैवैतान्धार्तराष्ट्रान्निहन्म हि।\nभवतः शास्त्रमादाय तन्नस्तपति दुष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018897, "chapter_id": 1395, "verse_number": "३-३३-११", "content_sanskrit": "अथैनामन्ववेक्षस्व मृगचर्यामिवात्मनः।\nअवीराचरितां राजन्नबलस्थैर्निषेविताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018898, "chapter_id": 1395, "verse_number": "३-३३-१२", "content_sanskrit": "यां न कृष्णो न बीभत्सुर्नाभिमन्युर्न सृञ्जयाः।\nन चाहमभिनन्दामि न च माद्रीसुतावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018899, "chapter_id": 1395, "verse_number": "३-३३-१३", "content_sanskrit": "भवान्धर्मो धर्म इति सततं व्रतकर्शितः।\nकच्चिद्राजन्न निर्वेदादापन्नः क्लीबजीविकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018900, "chapter_id": 1395, "verse_number": "३-३३-१४", "content_sanskrit": "दुर्मनुष्या हि निर्वेदमफलं सर्वघातकम्।\nअशक्ताः श्रियमाहर्तुमात्मनः कुर्वते प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018901, "chapter_id": 1395, "verse_number": "३-३३-१५", "content_sanskrit": "स भवान्दृष्टिमाञ्शक्तः पश्यन्नस्मासु पौरुषम्।\nआनृशंस्यपरो राजन्नात्मार्थमवबुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018902, "chapter_id": 1395, "verse_number": "३-३३-१६", "content_sanskrit": "अस्मानमी धार्तराष्ट्राः क्षममाणानहिंसतः।\nअशक्तानेव मन्यन्ते तद्दुःखं नाहवे वधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018903, "chapter_id": 1395, "verse_number": "३-३३-१७", "content_sanskrit": "तत्रचेद्युध्यमानानामजिह्ममनिवर्तिनाम्।\nसर्वशो हि वधः श्रेयान्प्रेत्य लोकांल्लभेमहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018904, "chapter_id": 1395, "verse_number": "३-३३-१८", "content_sanskrit": "अधवा वयमेवैतान्निहत्य भरतर्षभ।\nआददीमहि गां सर्वां तथापि श्रेय एव नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018905, "chapter_id": 1395, "verse_number": "३-३३-१९", "content_sanskrit": "सर्वथा कार्यमेतन्नः स्वधर्ममनुतिष्ठताम्।\nकाङ्खतां विषुलां कीर्ति वैरं प्रतिचिकीर्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018906, "chapter_id": 1395, "verse_number": "३-३३-२०", "content_sanskrit": "आत्मार्थं युध्यमानानां जीविते कृत्यलक्षणे।\nअन्यैरपि हृते राज्ये प्रशंसैव न गर्हणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018907, "chapter_id": 1395, "verse_number": "३-३३-२१", "content_sanskrit": "कर्शनार्थो हि यो धर्मो विप्राणामात्मनस्तथा।\nव्यसनं नाम तद्राजन्न धर्मः स कुवर्त्मतत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018908, "chapter_id": 1395, "verse_number": "३-३३-२२", "content_sanskrit": "सर्वथा धर्मनित्यं तु पुरुषं धर्मदुर्बलम्।\nजहतस्तात धर्मार्थौ प्रेतं दुःखसुखे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018909, "chapter_id": 1395, "verse_number": "३-३३-२३", "content_sanskrit": "यस्य धर्मो हि धर्मार्थँ क्लेशभाङ्ग स पण्डितः।\nन स धर्मस्य वेदार्थं सूर्यस्यान्धः प्रभामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018910, "chapter_id": 1395, "verse_number": "३-३३-२४", "content_sanskrit": "यस्य चार्थार्थ एवार्थः स च नार्थस्य कोविदः।\nरक्ष्यते भृतकः पुण्यं यथा स्यात्तादृगेव सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2018911, "chapter_id": 1395, "verse_number": "३-३३-२५", "content_sanskrit": "अतिवेलं हि योऽर्थार्थी नेतरावनुतिष्ठति।\nस वध्यः सर्वभूतानां ब्रह्महेव जुगुप्सितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2018912, "chapter_id": 1395, "verse_number": "३-३३-२६", "content_sanskrit": "सततं यश्च कामार्थी नेतरावनुतिष्ठति।\nमित्राणि तस्य नश्यन्ति धर्मार्थाभ्यां च हीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2018913, "chapter_id": 1395, "verse_number": "३-३३-२७", "content_sanskrit": "तस्य धर्मार्थहीनस्य कामान्ते निधनं ध्रुवम्।\nकामतो रममाणस्य मीनस्येवाम्भसः क्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2018914, "chapter_id": 1395, "verse_number": "३-३३-२८", "content_sanskrit": "तस्माद्धर्मार्थयोर्नित्यं न प्रमान्द्यन्ति पण्डिताः।\nप्रकृतिः सा हि कामस्य पावकस्यारणिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2018915, "chapter_id": 1395, "verse_number": "३-३३-२९", "content_sanskrit": "सर्वथा धर्ममूलोऽर्थो धर्मश्चार्थपरिग्रहः।\nइतरेतरयोर्नीतौ विद्धि मेघोदधी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2018916, "chapter_id": 1395, "verse_number": "३-३३-३०", "content_sanskrit": "द्रव्यार्थस्पर्शसंयोगे या प्रीतिरुपजायते।\nस कामश्चित्तसंकल्पः शरीरं नास्य दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2018917, "chapter_id": 1395, "verse_number": "३-३३-३१", "content_sanskrit": "अर्थार्थी पुरुषो राजन्बृहन्तं धर्ममिच्छति।\nअर्थमिच्छति कामार्थीन कामादन्यमिच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2018918, "chapter_id": 1395, "verse_number": "३-३३-३२", "content_sanskrit": "न हि कामेन कामोऽन्यः सिध्यते फलमेव तत्।\nउषयोगात्फलस्यैव काष्ठाद्भस्मेव पण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2018919, "chapter_id": 1395, "verse_number": "३-३३-३३", "content_sanskrit": "इमाञ्शकुनकान्राजन्हन्ति वैतंसिको यथा।\nएतद्रूपमधर्मस्य भूतेषु च विहिंसनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2018920, "chapter_id": 1395, "verse_number": "३-३३-३४", "content_sanskrit": "कामाल्लोभाच्च धर्मस्य प्रवृत्तिं यो न पश्ति।\nस वध्यः सर्वभूतानां प्रेत्य चेहैच दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2018921, "chapter_id": 1395, "verse_number": "३-३३-३५", "content_sanskrit": "व्यक्तं ते विदितो राजन्नर्थो द्रव्यपरिग्रहः।\nप्रकृतिं चापि वेत्थास्य विकृतिं चापि भूयसीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2018922, "chapter_id": 1395, "verse_number": "३-३३-३६", "content_sanskrit": "तस्य नाशं विनाशं वा जरया मरणेन वा।\nअनर्थ इति मन्यन्ते सोयमस्मासु वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2018923, "chapter_id": 1395, "verse_number": "३-३३-३७", "content_sanskrit": "इन्द्रियाणां च पञ्चानां मनसो हृदयस्य च।\nविपये वर्तमानानां या प्रीतिरुपजायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2018924, "chapter_id": 1395, "verse_number": "३-३३-३८", "content_sanskrit": "स काम इति मे बुद्धिः कर्मणां फलमुत्तमम्।\nएवमेव पृथग्दृष्ट्वा धर्मार्थौ काममेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2018925, "chapter_id": 1395, "verse_number": "३-३३-३९", "content_sanskrit": "न धर्मपर एव स्यान्न चार्थपरमो नरः।\nन कामपरमो वा स्यात्सर्वान्सेवेत सर्वदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2018926, "chapter_id": 1395, "verse_number": "३-३३-४०", "content_sanskrit": "धर्मं पूर्वे धनं मध्ये जघन्ये काममाचरेत्।\nअहन्यनुचरेदेवमेष शास्त्रकृतो विधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2018927, "chapter_id": 1395, "verse_number": "३-३३-४१", "content_sanskrit": "कामं पूर्वे धनं मध्ये जघन्ये धर्ममाचरेत्।\nवयस्यनुचरेदेवमेष शास्त्रकृतो विधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2018928, "chapter_id": 1395, "verse_number": "३-३३-४२", "content_sanskrit": "धर्मं चार्थं च कामं च यथावद्वदतांवर।\nविभज्य काले कालज्ञः सर्वान्सेवेत पण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2018929, "chapter_id": 1395, "verse_number": "३-३३-४३", "content_sanskrit": "मोक्षो वा परमं श्रेय एष राजन्सुखार्थिनाम्।\nप्राप्तिं वा बुद्धिमास्थाय सोपायां कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2018930, "chapter_id": 1395, "verse_number": "३-३३-४४", "content_sanskrit": "तद्वाऽऽशु क्रियतां राजन्प्राप्तिर्वाप्यधिगम्यताम्।\nजीवितं ह्यातुरस्येव दुःखमन्तरवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2018931, "chapter_id": 1395, "verse_number": "३-३३-४५", "content_sanskrit": "विदितश्चैव मे धर्मः सततं चरितश्च ते।\nजानन्तस्त्वयि शंसन्ति सुहृदः कर्मचोदनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2018932, "chapter_id": 1395, "verse_number": "३-३३-४६", "content_sanskrit": "दानं यज्ञाः सतां पूजा वेदधारणमार्जवम्।\nएष धर्मः परो राजन्फलवान्प्रेत्य चेंह च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2018933, "chapter_id": 1395, "verse_number": "३-३३-४७", "content_sanskrit": "एष नार्थविहीनेन शक्यो राजन्निपेवितुम्।\nअखिलाः पुरुषव्याघ्र गुणाः स्युर्यद्यपीनरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2018934, "chapter_id": 1395, "verse_number": "३-३३-४८", "content_sanskrit": "धर्ममूलं जगद्राजन्नान्यद्धर्माद्विशिष्यते।\nधर्मश्चार्थेन महता शक्यो राजन्निषेवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2018935, "chapter_id": 1395, "verse_number": "३-३३-४९", "content_sanskrit": "न चार्थो भैक्ष्यचर्येण नापि क्लैब्येन कर्हिचित्।\nवेत्तुं शक्यस्तथा राजन्केवलं धर्मबुद्धिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2018936, "chapter_id": 1395, "verse_number": "३-३३-५०", "content_sanskrit": "प्रतिष्द्धा हि ते याच्ञा यया सिध्यति वै द्विजः।\nतेजसैवार्थलिप्सायां यतस्व पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2018937, "chapter_id": 1395, "verse_number": "३-३३-५१", "content_sanskrit": "भैक्ष्यचर्या न विहिता न च विट्शूद्रजीविका।\nक्षत्रियस् विशेषेण धर्मस्तु बलमौरसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2018938, "chapter_id": 1395, "verse_number": "३-३३-५२", "content_sanskrit": "स्वधर्मं प्रतिपद्यस्व जहि शत्रून्समागतान्।\nधार्तराष्ट्रवनं पार्थ मया पार्थेन नाशय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2018939, "chapter_id": 1395, "verse_number": "३-३३-५३", "content_sanskrit": "उदारमेव विद्वांसो धर्मं प्राहुर्मनीषिणः।\nउदारं प्रतिपद्यस्व नावरे स्थातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2018940, "chapter_id": 1395, "verse_number": "३-३३-५४", "content_sanskrit": "अनुबुध्यस्व राजेन्द्र वेत्थ धर्मान्सनातनान्।\nक्रूरकर्माऽभिजातोसि यस्मादुद्विजते जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2018941, "chapter_id": 1395, "verse_number": "३-३३-५५", "content_sanskrit": "प्रजापालनसंभूतं फलं तव न गर्हितम्।\nएष ते विहितो राजन्धात्रा धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2018942, "chapter_id": 1395, "verse_number": "३-३३-५६", "content_sanskrit": "तस्माद्विचलितः पार्थ लोके हास्यं गमिष्यसि।\nस्वधर्माद्धि मनुष्याणां चलनं न प्रशस्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2018943, "chapter_id": 1395, "verse_number": "३-३३-५७", "content_sanskrit": "स क्षात्रं हृदयं कृत्वा त्यक्त्वेदं शिथिलं मनः।\nवीर्यमास्थाय कौरव्य धुरमुद्वह धुर्यवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2018944, "chapter_id": 1395, "verse_number": "३-३३-५८", "content_sanskrit": "न हि केवलधर्मात्मा पृथिवीं जातु कश्चन।\nपार्थिवो व्यजयद्राजन्न भूतिं न पुनः श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2018945, "chapter_id": 1395, "verse_number": "३-३३-५९", "content_sanskrit": "जिह्वां दत्ता बहूनां हि क्षुद्राणां लुब्धचेतसाम्।\nनिकृत्या लभते राज्यमाहारमिव शल्यकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2018946, "chapter_id": 1395, "verse_number": "३-३३-६०", "content_sanskrit": "भ्रातर पूर्वजाताश्च सुसमृद्धाश्च सर्वशः।\nनिकृत्या निर्जिता देवैरसुराः पाण्डवर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2018947, "chapter_id": 1395, "verse_number": "३-३३-६१", "content_sanskrit": "एवं बलवतः सर्वमिति बुद्ध्वा महीपते।\nजहि शत्रून्महाबाहो परां निकृतिमास्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2018948, "chapter_id": 1395, "verse_number": "३-३३-६२", "content_sanskrit": "न ह्यर्जुनसमः कश्चिद्युधि योद्धा धनुर्धरः।\nभविता वा पुमान्कश्चिन्मत्समो वा गदाधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2018949, "chapter_id": 1395, "verse_number": "३-३३-६३", "content_sanskrit": "सत्वेन कुरुते युद्धं राजन्सुबलवानपि।\nन प्रमाणेन नोत्साहात्सत्वस्थो भव पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2018950, "chapter_id": 1395, "verse_number": "३-३३-६४", "content_sanskrit": "सत्वं हि मूलमर्थस् यवितथं यदतोऽन्यथा।\nन तु प्रसक्तं भवति वृक्षच्छायेन हैमनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2018951, "chapter_id": 1395, "verse_number": "३-३३-६५", "content_sanskrit": "अर्थत्यागोऽपि कार्यः स्यादर्थं श्रेयांसमिच्छता।\nबीजौपम्यन कौन्तेय मा ते भूदत्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2018952, "chapter_id": 1395, "verse_number": "३-३३-६६", "content_sanskrit": "अर्थेन तु समोऽनर्थो यत्र लब्धो महोदयः।\nन तत्र विपणः कार्यः खरकण्डूयनं हि तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2018953, "chapter_id": 1395, "verse_number": "३-३३-६७", "content_sanskrit": "एवमेव मनुष्येन्द्र धर्मं त्यक्त्वाऽल्पकं नरः।\nबृहन्तं धर्ममाप्नोति स बुद्ध इति निश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2018954, "chapter_id": 1395, "verse_number": "३-३३-६८", "content_sanskrit": "अमित्रं मित्रसंपन्नं मित्रैर्भिन्दन्ति पण्डितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2018955, "chapter_id": 1395, "verse_number": "३-३३-६८", "content_sanskrit": "भिन्नैर्मित्रैः परित्यक्तं दुर्बलं कुरुते वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2018956, "chapter_id": 1395, "verse_number": "३-३३-६९", "content_sanskrit": "सत्वेन कुरुते युद्धं राजन्सुबलवानपि।\nनोद्यमेन न होत्राभिः सर्वाः स्वीकुरुते प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2018957, "chapter_id": 1395, "verse_number": "३-३३-७०", "content_sanskrit": "सर्वथा संहतैरेव दुर्बलैर्बलवानपि।\nअमित्रः शक्यते हन्तुं मधुहा भ्रमरैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2018958, "chapter_id": 1395, "verse_number": "३-३३-७१", "content_sanskrit": "यथा राजन्प्रजाः सर्वाः सूर्यः पाति गभस्तिभिः।\nहन्ति चैव तथैव त्वं सदृशः सवितुर्भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2018959, "chapter_id": 1395, "verse_number": "३-३३-७२", "content_sanskrit": "एतच्चापि तपो पाजन्पुराणमिति नः श्रुतम्।\nविधिना पालनं भूमेर्यत्कृतं नः पितामहैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2018960, "chapter_id": 1395, "verse_number": "३-३३-७३", "content_sanskrit": "न तथा तपसा राजँल्लोकान्प्राप्नोति क्षत्रियः।\nयथा सृष्टेन युद्धेन विजयेनेतरेण वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2018961, "chapter_id": 1395, "verse_number": "३-३३-७४", "content_sanskrit": "अपेयात्किल भा सूर्याल्लक्ष्मीश्चन्द्रमसस्तथा।\nइतिलोको व्यवसितो दृष्ट्वेमां भवतोव्यथाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2018962, "chapter_id": 1395, "verse_number": "३-३३-७५", "content_sanskrit": "भवतश्च प्रशंसाभिर्निन्दाभिरितरस्य च।\nकथयन्त्यः परिषदः पृथग्राजन्समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2018963, "chapter_id": 1395, "verse_number": "३-३३-७६", "content_sanskrit": "इदमभ्यधिकं राजन्ब्राह्मणाः कुरवश्च ते।\nसमेताः कथयन्तीह मुदिताः सत्यसन्धताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2018964, "chapter_id": 1395, "verse_number": "३-३३-७७", "content_sanskrit": "यन्न मोहान्न कार्पण्यान्न लोभान्न भयादपि।\nअनृतं किंचिदुक्तं ते न कामान्नार्थकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2018965, "chapter_id": 1395, "verse_number": "३-३३-७८", "content_sanskrit": "यदेनः कुरुते किंचिद्राजा भूमिमवाप्नुवन्।\nसर्वं तन्नुदते पश्चाद्यज्ञैर्विपुलदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2018966, "chapter_id": 1395, "verse_number": "३-३३-७९", "content_sanskrit": "ब्राह्मणेभ्यो ददद्ग्रामान्गाश्च राजन्सहस्रशः।\nमुच्यते वीर पापेभ्यस्तमोभ्य इव चन्द्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2018967, "chapter_id": 1395, "verse_number": "३-३३-८०", "content_sanskrit": "पौरजानपदाः सर्वे प्रायशः कुरुनन्दन।\nसवृद्धबालाः सहिताः शंसन्ति त्वां युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2018968, "chapter_id": 1395, "verse_number": "३-३३-८१", "content_sanskrit": "श्वदृतौ क्षीरमासक्तं ब्रह्म वा वृषले यथा।\nसत्यं स्तेने बलं नार्यां राज्यं दुर्योधने तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2018969, "chapter_id": 1395, "verse_number": "३-३३-८२", "content_sanskrit": "इतिलोके निर्वचनं पुरश्चरति भारत।\nअपि चैताः स्त्रियो बालाः स्वाध्यायमधिकुर्वते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2018970, "chapter_id": 1395, "verse_number": "३-३३-८३", "content_sanskrit": "इमामवस्थां च गते सहास्माभिररिंदम्।\nहन्त नष्टाः स्म सर्वे वै भवतोपद्रवे सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2018971, "chapter_id": 1395, "verse_number": "३-३३-८४", "content_sanskrit": "स भवान्रथमास्थाय सर्वोपकरणान्वितम्।\nत्वरमाणोऽभिनिर्यातु विप्रेभ्योऽर्थविभावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2018972, "chapter_id": 1395, "verse_number": "३-३३-८५", "content_sanskrit": "वाचयित्वा द्विजश्रेष्ठानद्यैव गजसाह्वयम्।\nअस्त्रविद्भिः परिवृतोभ्रातृभिर्दृढधन्विभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2018973, "chapter_id": 1395, "verse_number": "३-३३-८६", "content_sanskrit": "आशीविषसमैर्वीरैर्मरुद्भिरिव वृत्रहा।\nअमित्रांस्तेजसा मृद्गन्नसुरानिव वृत्रहा।\nश्रियमादत्स्व कौन्तेय धार्तराष्ट्रान्महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2018974, "chapter_id": 1395, "verse_number": "३-३३-८७", "content_sanskrit": "न हि गाण्डीवमुक्तानां शराणां गार्ध्रवाससाम्।\nस्पर्शमाशीविषाभानां मर्त्यः कश्चन संसहेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2018975, "chapter_id": 1395, "verse_number": "३-३३-८८", "content_sanskrit": "न स वीरो न मातङ्गो न च सोऽश्वोस्ति भारत।\nयः सहेत गदावेगं मम क्रुद्धस्य संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2018976, "chapter_id": 1395, "verse_number": "३-३३-८९", "content_sanskrit": "सृञ्जयैः सहकैकेयैर्वृष्णीनां वृषभेण च।\nकथंस्विद्युधि कौन्तेय न राज्यं प्राप्नुयामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2018977, "chapter_id": 1395, "verse_number": "३-३३-९०", "content_sanskrit": "शत्रुहस्तगतां राजन्कथंस्विन्नाहरेर्महीम्।\nइह यत्नमुपाहृत्य बलेन महताऽन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2018978, "chapter_id": 1395, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि त्रयस्त्रिंशोऽध्यायः ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}]