[{"id": 2001396, "chapter_id": 1021, "verse_number": "१-२२-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001397, "chapter_id": 1021, "verse_number": "१-२२-१", "content_sanskrit": "नागाश्च संविदं कृत्वा कर्तव्यमिति तद्वचः।\nनिःस्नेहा वै दहेन्माता असंप्राप्तमनोरथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001398, "chapter_id": 1021, "verse_number": "१-२२-२", "content_sanskrit": "प्रसन्ना मोक्षयेदस्मांस्तस्माच्छापाच्च भामिनी।\nकृष्णं पुच्छं करिष्यामस्तुरगस्य न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001399, "chapter_id": 1021, "verse_number": "१-२२-३", "content_sanskrit": "इति निश्चित्य ते तस्य कृष्णा वाला इव स्थिताः।\nएतस्मिन्नन्तरे ते तु सपत्न्यौ पणिते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001400, "chapter_id": 1021, "verse_number": "१-२२-४", "content_sanskrit": "ततस्ते पणितं कृत्वा भगिन्यौ द्विजसत्तम।\nजग्मतुः परया प्रीत्या परं पारं महोदधेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001401, "chapter_id": 1021, "verse_number": "१-२२-५", "content_sanskrit": "कद्रूश्च विनता चैव दाक्षायण्यौ विहायसा।\nआलोकयन्त्यावक्षोभ्यं समुद्रं निधिमम्भसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001402, "chapter_id": 1021, "verse_number": "१-२२-६", "content_sanskrit": "वायुनाऽतीव सहसा क्षोभ्यमाणं महास्वनम्।\nतिमिंगिलसमाकीर्णं मकरैरावृतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001403, "chapter_id": 1021, "verse_number": "१-२२-७", "content_sanskrit": "संयुतं बहुसाहस्रैः सत्वैर्नानाविधैरपि।\nघोरर्घोरमनाधृष्यं गम्भीरमतिभैरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001404, "chapter_id": 1021, "verse_number": "१-२२-८", "content_sanskrit": "आकरं सर्वरत्नानामालयं वरुणस्य च।\nनागानामालयं चापि सुरम्यं सरितां पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001405, "chapter_id": 1021, "verse_number": "१-२२-९", "content_sanskrit": "पातालज्वलनावासमसुराणां तथालयम्।\nभयंकराणां सत्त्वानां पयसो निधिमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001406, "chapter_id": 1021, "verse_number": "१-२२-१०", "content_sanskrit": "शुभ्रं दिव्यममर्त्यानाममृतस्याकरं परम्।\nअप्रमेयमचिन्त्यं च सुपुम्यजलसंमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001407, "chapter_id": 1021, "verse_number": "१-२२-११", "content_sanskrit": "महानदीभिर्बह्वीभिस्तत्र तत्र सहस्रशः।\nआपूर्यमाणमत्यर्थं नृत्यन्तमिव चोर्मिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001408, "chapter_id": 1021, "verse_number": "१-२२-१२", "content_sanskrit": "इत्येवं तरलतरोर्मिसंकुलं ते\nगम्भीरं विकसितमम्बरप्रकाशम्।\nपातालज्वलनशिखाविदीपिताङ्गं\nगर्जन्तं द्रुतमभिजग्मतुस्ततस्ते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001409, "chapter_id": 1021, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि द्वाविंशोऽध्यायः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]