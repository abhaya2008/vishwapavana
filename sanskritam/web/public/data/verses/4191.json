[{"id": 2147504, "chapter_id": 4191, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147505, "chapter_id": 4191, "verse_number": "१", "content_sanskrit": "सद्भिरारोपितः स्वर्गं पार्थिवैर्भूरिदक्षिणैः ।\nअभ्यनुज्ञाय दौहित्रान् ययातिर्दिवमास्थितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147506, "chapter_id": 4191, "verse_number": "२", "content_sanskrit": "अभिवृष्टश्च वर्षेण नानापुष्पसुगन्धिना ।\nपरिष्वक्तश्च पुण्येन वायुना च सुगन्धिना\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147507, "chapter_id": 4191, "verse_number": "३", "content_sanskrit": "अचलं स्थानमारुह्य दौहित्रफलनिर्जितम् ।\nकर्मभिः स्वैरुपचितो जज्वाल परया श्रिया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147508, "chapter_id": 4191, "verse_number": "४", "content_sanskrit": "उपगीतोपनृत्तश्च गन्धर्वाप्सरसां गणैः ।\nप्रीत्या प्रतिगृहीतश्च स्वर्गे दुन्दुभिनिस्वनैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147509, "chapter_id": 4191, "verse_number": "५", "content_sanskrit": "अभिष्टुतश्च विविधैः देवराजर्षिचारणैः ।\nअर्चितश्चोत्तमार्घेण दैवतैरभिनन्दितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147510, "chapter_id": 4191, "verse_number": "६", "content_sanskrit": "प्राप्तः स्वर्गफलं चैव तमुवाच पितामहः ।\nनिर्वृतं शान्तमनसं वचोभिस्तर्पयन्निव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147511, "chapter_id": 4191, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147512, "chapter_id": 4191, "verse_number": "७", "content_sanskrit": "चतुष्पादस्त्वया धर्मश्चितो लौक्येन कर्मणा ।\nअक्षयस्तव लोकोऽयं कीर्तिश्चैवाक्षया दिवि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147513, "chapter_id": 4191, "verse_number": "८", "content_sanskrit": "पुनस्त्वयैव राजर्षे सत्कृतेन विघातितम् ।\nआवृतं तमसा चेतः सर्वेषां स्वर्गवासिनाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147514, "chapter_id": 4191, "verse_number": "९", "content_sanskrit": "येन त्वां नाभिजानन्ति ततो ज्ञात्वाऽसि पातितः ।\nप्रीत्यैव चासि दौहित्रैः तारितस्त्वमिहागतः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147515, "chapter_id": 4191, "verse_number": "१०", "content_sanskrit": "स्थानं च प्रतिपन्नोऽसि कर्मणा स्वेन निर्जितम् ।\nअचलं शाश्वतं पुण्यमुत्तमं ध्रुवमव्ययम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147516, "chapter_id": 4191, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147517, "chapter_id": 4191, "verse_number": "११", "content_sanskrit": "भगवन् संशयो मेऽस्ति कच्चित् तं भेत्तुमर्हसि ।\nन ह्यन्यमहमर्हामि प्रष्टुं लोकपितामह\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147518, "chapter_id": 4191, "verse_number": "१२", "content_sanskrit": "बहुवर्षसहस्रान्तं प्रजापालनवर्धितम् ।\nअनेकक्रतुदानौघैः यन्मयोपार्जितं फलम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147519, "chapter_id": 4191, "verse_number": "१३", "content_sanskrit": "कथं तदल्पकालेन क्षीणं येनास्मि पातितः ।\nभगवन् वेत्थ लोकांश्च शाश्वतान् मम निर्मितान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147520, "chapter_id": 4191, "verse_number": "१४", "content_sanskrit": "कथं नु मम तत् सर्वं विप्रनष्टं महाद्युते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147521, "chapter_id": 4191, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147522, "chapter_id": 4191, "verse_number": "१५", "content_sanskrit": "बहुवर्षसहस्रान्तं प्रजापालनवर्धितम् ।\nअनेकक्रतुदानौघैः यत् त्वयोपार्जितं फलम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147523, "chapter_id": 4191, "verse_number": "१६", "content_sanskrit": "तदनेनैव दोषेण क्षीणं येनासि पातितः ।\nअभिमानेन राजेन्द्र धिक्कृतः स्वर्गवासिभिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147524, "chapter_id": 4191, "verse_number": "१७", "content_sanskrit": "नायं मानेन राजर्षे न बलेन न हिंसया ।\nन शाठ्येन न मायाभिः लोको भवति शाश्वतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147525, "chapter_id": 4191, "verse_number": "१८", "content_sanskrit": "नावमान्यास्त्वया राजन्नधमोत्कृष्टमध्यमाः ।\nन हि मानप्रदग्धानां कश्चिदस्ति शमः क्वचित्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147526, "chapter_id": 4191, "verse_number": "१९", "content_sanskrit": "पतनारोहणमिदं कथयिष्यन्ति ये नराः ।\nविषमाण्यपि ते प्राप्ताः तरिष्यन्ति न संशयः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147527, "chapter_id": 4191, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147528, "chapter_id": 4191, "verse_number": "२०", "content_sanskrit": "एष दोषोऽभिमानेन पुरा प्राप्तो ययातिना ।\nनिर्बध्नताऽतिमात्रं च गालवेन महीपते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2147529, "chapter_id": 4191, "verse_number": "२१", "content_sanskrit": "श्रोतव्यं हितकामानां सुहृदां भूतिमिच्छताम् ।\nन कर्तव्यो हि निर्बन्धो निर्बन्धो हि क्षयावहः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2147530, "chapter_id": 4191, "verse_number": "२२", "content_sanskrit": "तस्मात् त्वमपि गान्धारे मानं क्रोधं च वर्जय ।\nसन्धत्स्व पाण्डवैर्वीर संरम्भं त्यज पार्थिव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2147531, "chapter_id": 4191, "verse_number": "२३", "content_sanskrit": "स भवान् सुहृदां पथ्यं वचो गृह्णातु माऽनृतम् ।\nसमर्थैर्विग्रहं कृत्वा विषमस्थो भविष्यसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2147532, "chapter_id": 4191, "verse_number": "२४", "content_sanskrit": "ददाति यत् पार्थिव यत् करोति\nयद्वा तपस्तप्यति यज्जुहोति ।\nन तस्य नाशोऽस्ति न चापकर्षो\nनान्यस्तदश्नाति स एव कर्ता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2147533, "chapter_id": 4191, "verse_number": "२५", "content_sanskrit": "इदं महाख्यानमनुत्तमं मतं\nबहुश्रुतानां गतरोषरागिणाम् ।\nसमीक्ष्य लोके बहुधा प्रधावतां\nत्रिवर्गदृष्टिः पृथिवीमुपाश्नुते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2147534, "chapter_id": 4191, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्वाविंशोत्तरशततमोऽध्यायः ॥१२२॥\nभगवद्यानपर्वणि त्रिपञ्चाशोऽध्यायः ॥५३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]