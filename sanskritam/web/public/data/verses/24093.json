[{"id": 7004093000, "chapter_id": 24093, "verse_number": "४-४२-१", "content_sanskrit": "अगस्तिरुवाच ।\nकथं निकटतः कालो ज्ञायते हरनंदन ।\nतानि चिह्नानि कतिचिद्ब्रूहि मे परिपृच्छतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004093001, "chapter_id": 24093, "verse_number": "४-४२-२", "content_sanskrit": "कुमार उवाच ।\nवदामि कालचिह्नानि जायंते यानि देहिनाम् ।\nमृत्यौ निकटमापन्ने मुने तानि निशामय ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004093002, "chapter_id": 24093, "verse_number": "४-४२-३", "content_sanskrit": "याम्यनासापुटे यस्य वायुर्वाति दिवानिशम् ।\nअखंडमेव तस्यायुः क्षयत्यब्दत्रयेण हि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004093003, "chapter_id": 24093, "verse_number": "४-४२-४", "content_sanskrit": "अहोरात्रं त्र्यहोरात्रं रविर्वहति संततम् ।\nअब्दमेकं च तस्येह जीवनावधिरुच्यते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004093004, "chapter_id": 24093, "verse_number": "४-४२-५", "content_sanskrit": "वहेन्नासापुटयुगे दशाहानि निरंतरम् ।\nवातश्चेत्सह संक्रांतिस्तया जीवेद्दिनत्रयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004093005, "chapter_id": 24093, "verse_number": "४-४२-६", "content_sanskrit": "नासावर्त्म द्वयं हित्वा मातरिश्वा मुखाद्वहेत् ।\nशंसेद्दिनद्वयादर्वाक्प्रयाणं तस्य चाध्वनि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004093006, "chapter_id": 24093, "verse_number": "४-४२-७", "content_sanskrit": "अकस्मादेवयत्काले मृत्युः सन्निहितो भवेत् ।\nचिंतनीयः प्रयत्नेन स कालो मृत्युभीरुणा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004093007, "chapter_id": 24093, "verse_number": "४-४२-८", "content_sanskrit": "सूर्ये सप्तमराशिस्थे जन्मर्क्षस्थे निशाकरे ।\nपौष्णः स कालो द्रष्टव्यो यदा याम्ये रविर्वहेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004093008, "chapter_id": 24093, "verse_number": "४-४२-९", "content_sanskrit": "अकस्माद्वीक्षते यस्तु पुरुषं कृष्णपिंगलम् ।\nतस्मिन्नेव क्षणेऽरूपं स जीवेद्वत्सरद्वयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004093009, "chapter_id": 24093, "verse_number": "४-४२-१०", "content_sanskrit": "यस्य बीजं मलं मूत्रं क्षुतं मूत्रं मलं तु वा ।\nइहैकदा पतेद्यस्य अब्दं तस्यायुरिष्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004093010, "chapter_id": 24093, "verse_number": "४-४२-११", "content_sanskrit": "इंद्रनीलनिभं व्योम्नि नागवृंदं य ईक्षते ।\nइतस्ततः प्रसृमरं षण्मासं न स जीवति ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004093011, "chapter_id": 24093, "verse_number": "४-४२-१२", "content_sanskrit": "व्यभ्रेह्नि वारिपूर्णास्यः पृष्ठीकृत्य दिवाकरम् ।\nफूत्कृत्याश्विंद्रचापं न पश्येत्षण्मासजीवितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004093012, "chapter_id": 24093, "verse_number": "४-४२-१३", "content_sanskrit": "अरुंधतीं ध्रुवं चैव विष्णोस्त्रीणिपदानि च ।\nआसन्नमृत्युर्नोपश्येच्चतुर्थं मातृमंडलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004093013, "chapter_id": 24093, "verse_number": "४-४२-१४", "content_sanskrit": "अरुंधती भवेज्जिह्वा ध्रुवो नासाग्रमुच्यते ।\nविष्णोः पदानि भ्रूमध्ये नेत्रयोर्मातृमंडलम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004093014, "chapter_id": 24093, "verse_number": "४-४२-१५", "content_sanskrit": "वेत्ति नीलादिवर्णस्य कटम्लादिरसस्यहि ।\nअकस्मादन्यथाभावं षण्मासेन स मृत्युभाक् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004093015, "chapter_id": 24093, "verse_number": "४-४२-१६", "content_sanskrit": "षण्मासमृत्योर्मर्त्यस्य कंठोष्ठरसना रदाः ।\nशुष्यंति सततं तद्वद्विच्छायास्तालुपंचमाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004093016, "chapter_id": 24093, "verse_number": "४-४२-१७", "content_sanskrit": "रेतः करजनेत्रांता नीलिमानं भजंति चेत् ।\nतर्हि कीनाशनगरीं षष्ठेमासि व्रजेन्नरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004093017, "chapter_id": 24093, "verse_number": "४-४२-१८", "content_sanskrit": "संप्रवृत्ते निधुवने मध्येंते क्षौति चेन्नरः ।\nनिश्चितं पंचमे मासि धर्मराजातिथिर्भवेत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004093018, "chapter_id": 24093, "verse_number": "४-४२-१९", "content_sanskrit": "द्रुतमारुह्यशरठस्त्रिवर्णो यस्य मस्तके ।\nप्रयाति याति तस्यायुः षण्मासेन परिक्षयम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004093019, "chapter_id": 24093, "verse_number": "४-४२-२०", "content_sanskrit": "सुस्नातस्यापि यस्याशु हृदयं परिशुष्यति ।\nचरणौ च करौ वापि त्रिमासं तस्य जीवितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004093020, "chapter_id": 24093, "verse_number": "४-४२-२१", "content_sanskrit": "प्रतिबिंबं भवेद्यस्य पदखंडपदाकृति ।\nपांसौ वा कर्दमे वापि पंचमासान्स जीवति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004093021, "chapter_id": 24093, "verse_number": "४-४२-२२", "content_sanskrit": "छाया प्रकंपते यस्य देहबंधेपि निश्चले ।\nकृतांतदूता बध्नंति चतुर्थे मासि तं नरम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004093022, "chapter_id": 24093, "verse_number": "४-४२-२३", "content_sanskrit": "निजस्य प्रतिबिंबस्य नीराज्यमुकुरादिषु ।\nउत्तमांगं न यः पश्येत्समासेन विनश्यति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004093023, "chapter_id": 24093, "verse_number": "४-४२-२४", "content_sanskrit": "मतिर्भ्रश्येत्स्खलेद्वाणी धनुरैद्रं निरक्षितै ।\nरात्रौ चंद्रद्वयं चापि दिवा द्वौ च दिवाकरौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004093024, "chapter_id": 24093, "verse_number": "४-४२-२५", "content_sanskrit": "दिवा च तारकाचक्रं रात्रौ व्योमवितारकम् ।\nयुगपच्च चतुर्दिक्षु शाक्रं कोदंडमंडलम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004093025, "chapter_id": 24093, "verse_number": "४-४२-२६", "content_sanskrit": "भूरुहे भूधराग्रे च गंधर्वनगरालयम् ।\nदिवापिशाच नृत्यं च एते पंचत्वहेतवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004093026, "chapter_id": 24093, "verse_number": "४-४२-२७", "content_sanskrit": "सर्वेष्वेतेषु चिह्नेषु यद्येकमपि वीक्षते ।\nतदा मासावधिं मृत्युः प्रतीक्षेत न चाधिकम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004093027, "chapter_id": 24093, "verse_number": "४-४२-२८", "content_sanskrit": "करावरुद्ध श्रवणः शृणोति न यदा ध्वनिम् ।\nस्थूलः कृशः कृशस्थूलस्तदामासान्निवर्तते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004093028, "chapter_id": 24093, "verse_number": "४-४२-२९", "content_sanskrit": "यः पश्येदात्मनश्छायां दक्षिणाशा समाश्रिताम् ।\nदिनानि पंच जीवित्वा पंचत्वमुपयाति सः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004093029, "chapter_id": 24093, "verse_number": "४-४२-३०", "content_sanskrit": "प्रोह्यते भक्ष्यते वापि पिशाचासुरवायसैः ।\nभूतैः प्रेतैः श्वभिर्गृध्रैर्गोमायुखरसूकरैः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004093030, "chapter_id": 24093, "verse_number": "४-४२-३१", "content_sanskrit": "रासभैः करभैः कीशैः श्वेनैरश्वतरैर्बकैः ।\nस्वप्ने स जीवितं त्यक्त्वा वर्षांते यममीक्षते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004093031, "chapter_id": 24093, "verse_number": "४-४२-३२", "content_sanskrit": "गंधपुष्पांशुकैः शोणैः स्वां तनुं भूषितां नरः ।\nयः पश्येत्स्वप्नसमये सोऽष्टौ मासाननित्यहो ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004093032, "chapter_id": 24093, "verse_number": "४-४२-३३", "content_sanskrit": "पांसुराशि च वल्मीकं यूपदंडमथापि वा ।\nयोधिरोहति वै स्वप्ने स षष्ठे मासि नश्यति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004093033, "chapter_id": 24093, "verse_number": "४-४२-३४", "content_sanskrit": "रासभारूढमात्मानं तैलाभ्यक्तं च मुंडितम् ।\nनीयमानं यमाशां यः स्वप्ने पश्येत्स्वपूर्वजान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004093034, "chapter_id": 24093, "verse_number": "४-४२-३५", "content_sanskrit": "स्वमौलौ स्वतनौ वापि यः पश्येत्स्वप्नगो नरः ।\nतृणानि शुष्ककाष्ठानि षष्ठे मासि न तिष्ठति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004093035, "chapter_id": 24093, "verse_number": "४-४२-३६", "content_sanskrit": "लोहदंडधरं कृष्णं पुरुषं कृष्णवाससम् ।\nस्वयं योग्रे स्थितं पश्येत्स त्रीन्मासान्न लंघयेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004093036, "chapter_id": 24093, "verse_number": "४-४२-३७", "content_sanskrit": "काली कुमारी यं स्वप्ने बद्नीयाद्बाहु पाशकैः ।\nस मासेन समीक्षेत नगरींशमनोषिताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004093037, "chapter_id": 24093, "verse_number": "४-४२-३८", "content_sanskrit": "नरो यो वानरारूढो यायात्प्राचीदिशं स्वपन् ।\nदिनैः स पंचभिरेव पश्येत्संयमिनीं पुरीम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004093038, "chapter_id": 24093, "verse_number": "४-४२-३९", "content_sanskrit": "कृपणोपि वदान्यः स्याद्वदान्यः कृपणो यदि ।\nप्रकृतेर्विकृतिश्चेत्स्यात्तदा पंचत्वमृच्छति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004093039, "chapter_id": 24093, "verse_number": "४-४२-४०", "content_sanskrit": "एतानि कालचिह्नानि संत्यन्यानि बहून्यपि ।\nज्ञात्वाभ्यसेन्नरो योगमथवाकाशिकां श्रयेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004093040, "chapter_id": 24093, "verse_number": "४-४२-४१", "content_sanskrit": "न कालवंचनोपायं मुनेन्यमवयाम्यहम् ।\nविना मृत्युजयं काशीनाथं गर्भावरोधकम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004093041, "chapter_id": 24093, "verse_number": "४-४२-४२", "content_sanskrit": "तावद्गर्जंति पापानि तावद्गर्जेद्यमो नृपः ।\nयावद्विश्वेशशरणं नरो न निरतो व्रजेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004093042, "chapter_id": 24093, "verse_number": "४-४२-४३", "content_sanskrit": "प्राप्तविश्वेश्वरावासः पीतोत्तरवहापयाः ।\nस्पृष्ट विश्वेशसल्लिंगः कश्च याति न वंद्यताम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004093043, "chapter_id": 24093, "verse_number": "४-४२-४४", "content_sanskrit": "करिष्येत्कुपितःकालः किंकाशीवासिनां नृणाम् ।\nकाले शिवः स्वयं कर्णे यत्र मंत्रोपदेशकः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004093044, "chapter_id": 24093, "verse_number": "४-४२-४५", "content_sanskrit": "यथा प्रयाति शिशुता कौमारं च यथा गतम् ।\nसत्वरं गत्वरं तद्वद्यौवनं चापि वार्धकम ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004093045, "chapter_id": 24093, "verse_number": "४-४२-४६", "content_sanskrit": "यावन्नहि जराक्रांतिर्यावन्नेंद्रियवैक्लवम् ।\nतावत्सर्वं फल्गुरूपं हित्वा काशीं श्रयेत्सुधीः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004093046, "chapter_id": 24093, "verse_number": "४-४२-४७", "content_sanskrit": "अन्यानि काललक्ष्माणि तिष्ठंतु कलशोद्भव ।\nजरैव प्रथमं लक्ष्म चित्रं तत्रापि भीर्नहि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004093047, "chapter_id": 24093, "verse_number": "४-४२-४८", "content_sanskrit": "पराभूतो हि जरया सर्वैश्च परिभूयते ।\nहृततारुण्यमाणिक्यो धनहीनः पुमानिव ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004093048, "chapter_id": 24093, "verse_number": "४-४२-४९", "content_sanskrit": "सुतावाक्यं न कुर्वंति पत्नी प्रेमापि मुंचति ।\nबांधवा नैव मन्यंते जरसाश्लेषितं नरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004093049, "chapter_id": 24093, "verse_number": "४-४२-५०", "content_sanskrit": "आश्लिष्टं जरया दृष्ट्वा परयोषिद्विशंकिता ।\nभवेत्पराङ्मुखी नित्यं प्रणयिन्यपि कामिनी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004093050, "chapter_id": 24093, "verse_number": "४-४२-५१", "content_sanskrit": "न जरा सदृशो व्याधिर्न दुःखं जरया समम् ।\nकारयित्र्यपमानस्य जरैव मरणं नृणाम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004093051, "chapter_id": 24093, "verse_number": "४-४२-५२", "content_sanskrit": "न जीयते तथा कालस्तपसा योगयुक्तिभिः ।\nयथा चिरेणकालेन काशीवासाद्विजीयते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004093052, "chapter_id": 24093, "verse_number": "४-४२-५३", "content_sanskrit": "विनायज्ञैर्विनादानैर्विना व्रतजपादिभिः ।\nविनातिपुण्यसंभारैः कः काशीं प्राप्तुमीहते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004093053, "chapter_id": 24093, "verse_number": "४-४२-५४", "content_sanskrit": "काशीप्राप्तिरयं योगःकाथीप्राप्तिरिदं तपः ।\nकाशीप्राप्तिरिदं दानं काशीप्राप्तिः शिवैकता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004093054, "chapter_id": 24093, "verse_number": "४-४२-५५", "content_sanskrit": "कः कलिकोथवा कालः का जरा किं च दुष्कृतम् ।\nका रुजः केंतराया वा श्रिता वाराणसी यदि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004093055, "chapter_id": 24093, "verse_number": "४-४२-५६", "content_sanskrit": "कलिस्तानेव बाधेत कालस्तांश्च जिघांसति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004093056, "chapter_id": 24093, "verse_number": "४-४२-५७", "content_sanskrit": "एनांसि तांश्च बाधंते ये न काशीं समाश्रिताः ।\nकाशीसमाश्रिता यैश्च यैश्च विश्वेश्वरोर्चितः ।\nतारकं ज्ञानमासाद्य ते मुक्ताः कर्मपाशतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004093057, "chapter_id": 24093, "verse_number": "४-४२-५८", "content_sanskrit": "धनिनो न तथा सौख्यं प्राप्नुवंति नराः क्वचित् ।\nयथा निधनतः काश्यां लभते सुखमव्ययम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004093058, "chapter_id": 24093, "verse_number": "४-४२-५९", "content_sanskrit": "वरं काशीसमावासी नासीनो द्युसदां पदम् ।\nदुःखांतं लभते पूर्वः सुखांतं लभते परः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004093059, "chapter_id": 24093, "verse_number": "४-४२-६०", "content_sanskrit": "स्थितोपि भगवनीशो मंदरं चारुकंदरम् ।\nकाशीं विना रतिं नाऽप दिवोदासनृपोषिताम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]