[{"id": 2017426, "chapter_id": 1362, "verse_number": "२-१०३-१", "content_sanskrit": "वैशम्पायन उवाच॥\nवनं गतेषु पार्थेषु निर्जितेषु दुरोदरे।\nधृतराष्ट्रं महाराज तदा चिन्ता समाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017427, "chapter_id": 1362, "verse_number": "२-१०३-२", "content_sanskrit": "तं चिन्तयानमासीनं धृतराष्ट्रं जनेश्वरम्।\nनिः श्वसन्तमनेकाग्रमिति होवाच सञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017428, "chapter_id": 1362, "verse_number": "२-१०३-३", "content_sanskrit": "अवाप्य वसुसम्पूर्णां वसुधां वसुधाधिप।\nप्रव्राज्य पाण्डवान्राज्याद्राजन्किमनुशोचसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017429, "chapter_id": 1362, "verse_number": "२-१०३-४x", "content_sanskrit": "धृतराष्ट्र उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017430, "chapter_id": 1362, "verse_number": "२-१०३-४", "content_sanskrit": "अशोच्यत्वं कुतस्तेषां येषां वैरं भविष्यति।\nपाण्डवैर्युद्धशौण्डैर्हि बलवद्भिर्महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017431, "chapter_id": 1362, "verse_number": "२-१०३-५x", "content_sanskrit": "सञ्जय उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017432, "chapter_id": 1362, "verse_number": "२-१०३-५", "content_sanskrit": "तवेदं सुकृतं राजन्महद्वैरमुपस्थितम्।\nविनाशो येन लोकस्य सानुबन्धो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017433, "chapter_id": 1362, "verse_number": "२-१०३-६", "content_sanskrit": "वार्यमाणो हि भीष्मेण द्रोणेन विदुरेण च।\nपाण्डवानां प्रियां भार्यां द्रौपदीं धर्मचारिणीम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017434, "chapter_id": 1362, "verse_number": "२-१०३-७", "content_sanskrit": "प्राहिणोदानयेहेति पुत्रो दुर्योधनस्तव।\nसूतपुत्रं सुमन्दात्मा निर्लज्जः प्रातिकामिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017435, "chapter_id": 1362, "verse_number": "२-१०३-८", "content_sanskrit": "यस्मै देवाः प्रयच्छन्ति पुरुषाय पराभवम्।\nबुद्धिं तस्यापकर्षन्ति सोऽवाचीनानि पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017436, "chapter_id": 1362, "verse_number": "२-१०३-९", "content_sanskrit": "बुद्धौ कलुषभूतायां विनाशे समुपस्थिते।\nअनयो नयसङ्काशो हृदयान्नापसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017437, "chapter_id": 1362, "verse_number": "२-१०३-१०", "content_sanskrit": "अनर्थाश्चार्थरूपेण अर्थाश्चानर्थरूपिणः।\nउत्तिष्ठन्ति विनाशाय नूनं तच्चास्य रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017438, "chapter_id": 1362, "verse_number": "२-१०३-११", "content_sanskrit": "न कालो दण्डमुद्यम्य शिरः कृन्तति कस्यचित्।\nकालस्य बलमेतार्वाद्वपरीतार्थदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017439, "chapter_id": 1362, "verse_number": "२-१०३-१२", "content_sanskrit": "आसादितमिदं घोरं तुमुलं रोमहर्षणम्।\nपाञ्चालीमपकर्षद्भिः सभामध्ये तपस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017440, "chapter_id": 1362, "verse_number": "२-१०३-१३", "content_sanskrit": "अयोनिजां रूपवतीं कुले जातां विभावसोः।\nको नु तां सर्वधर्मज्ञां परिभूय यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017441, "chapter_id": 1362, "verse_number": "२-१०३-१४", "content_sanskrit": "पर्यानयेत्सभामध्ये विना दुर्द्यूतदेविनम्।\nस्त्रीधर्मिणी वरारोहा शोणितेन परिप्लुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017442, "chapter_id": 1362, "verse_number": "२-१०३-१५", "content_sanskrit": "एकवस्त्राथ पाञ्चाली पाण्डवानभ्यवैक्षत।\nहृतस्वान्हृतराज्यांश्च हृतवस्त्रान्हृतश्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017443, "chapter_id": 1362, "verse_number": "२-१०३-१६", "content_sanskrit": "विहीनान्सर्वकामेभ्यो दासभावमुपागतान्।\nधर्मपाशपरिक्षिप्तानशक्तानिव विक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017444, "chapter_id": 1362, "verse_number": "२-१०३-१७", "content_sanskrit": "क्रुद्धां चानर्हतीं कृष्णां दुःखितां कुरुसंसदि।\nदुर्योधनश्च कर्णश्च कटुकान्यभ्यभाषताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017445, "chapter_id": 1362, "verse_number": "२-१०३-१८", "content_sanskrit": "इति सर्वमिदं राजन्नाकुलं प्रतिभाति मे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017446, "chapter_id": 1362, "verse_number": "२-१०३-१८x", "content_sanskrit": "धृतराष्ट्र उवाच॥\nतस्याः कृपणचक्षुर्भ्यां प्रदह्येतापि मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017447, "chapter_id": 1362, "verse_number": "२-१०३-१९", "content_sanskrit": "अपि शेषं भवेदद्य पुत्राणां मम सञ्जय।\nभरतानां स्त्रियः सर्वा गान्धार्या सह सङ्गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017448, "chapter_id": 1362, "verse_number": "२-१०३-२०", "content_sanskrit": "प्राकोशन्भैरवं तत्र दृष्ट्वा कृष्णां सभागताम्।\nधर्मिष्टां धर्मपत्नीं च रूपयौवनशालिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017449, "chapter_id": 1362, "verse_number": "२-१०३-२१", "content_sanskrit": "प्रजाभिःसह सङ्गम्य ह्यनुशोचन्ति नित्यशः।\nअग्निहोत्राणि सायाह्ने च चाहूयन्त सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017450, "chapter_id": 1362, "verse_number": "२-१०३-२२", "content_sanskrit": "ब्राह्मणाः कुपिताश्चासन्द्रौपद्याः परिकर्षणे।\nआसीन्निष्ठानको घोरो निर्घातश्च महानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017451, "chapter_id": 1362, "verse_number": "२-१०३-२३", "content_sanskrit": "दिव उल्काश्चापतन्त राहुश्चार्कमुपाग्रसत्।\nअपर्वणि महाघोरं प्रजानां जयन्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017452, "chapter_id": 1362, "verse_number": "२-१०३-२४", "content_sanskrit": "तथैव रथशालासु प्रादुरासीद्धुताशनः।\nध्वजाश्चापि व्यशीर्यन्त भरतानामभूतये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017453, "chapter_id": 1362, "verse_number": "२-१०३-२५", "content_sanskrit": "दुर्योधनस्याग्निहोत्रे प्राक्रोशन्भैरवं शिवाः।\nतास्तदा प्रत्यभाषन्त रासभाः सर्वतो दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017454, "chapter_id": 1362, "verse_number": "२-१०३-२६", "content_sanskrit": "प्रातिष्ठत ततो भीष्मो द्रोणेन सह सञ्जय।\nकृपश्च सोमदत्तश्च बाह्लीकश्च महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017455, "chapter_id": 1362, "verse_number": "२-१०३-२७", "content_sanskrit": "ततोऽहमब्रुवं तत्र विदुरेण प्रचोदितः।\nवरं ददानि कृष्णायै काङ्क्षितं यद्यदिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017456, "chapter_id": 1362, "verse_number": "२-१०३-२८", "content_sanskrit": "अवृणोत्तत्र पाञ्चाली पाण्डवाना --सताम्।\nसरथान्सधनुष्कांश्चाप्यनुज्ञासिषमप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017457, "chapter_id": 1362, "verse_number": "२-१०३-२९", "content_sanskrit": "अथाब्रवीन्महाप्राज्ञो विदुरः सर्वधर्मवित्।\nएतदन्तास्तु भरता यद्व-कृष्णा सभां गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017458, "chapter_id": 1362, "verse_number": "२-१०३-३०", "content_sanskrit": "यैषा पाञ्चालराजस्य सुता सा श्रीरनुत्तमा।\nपाञ्चाली पाण्डवानेतान्दैवसृष्टोपसर्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017459, "chapter_id": 1362, "verse_number": "२-१०३-३१", "content_sanskrit": "तस्याः पार्थाः परिक्लेशं न क्षंस्यन्ते ह्यमर्षणाः।\nवृष्णयो वा महेष्वासाः पाञ्चाला वा महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017460, "chapter_id": 1362, "verse_number": "२-१०३-३२", "content_sanskrit": "तेन सत्याभिसन्धेन वासुदेवेन रक्षिताः।\nआगमिष्यति बीभत्सुः पञ्चालैः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017461, "chapter_id": 1362, "verse_number": "२-१०३-३३", "content_sanskrit": "तेषां मध्ये महेष्वासो भीमसेनो महाबलः।\nआगमिष्यति धुन्वानो गदां दण्डमिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017462, "chapter_id": 1362, "verse_number": "२-१०३-३४", "content_sanskrit": "ततो गाण्डीवनिर्घोषं श्रुत्वा पार्थस्य धीमतः।\nगदावेगं च भीमस्य नालं सोढुं नराधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017463, "chapter_id": 1362, "verse_number": "२-१०३-३५", "content_sanskrit": "तत्र मे रोचते नित्यं पार्थैः साम न विग्रहः।\nकुरुभ्यो हि सदा मन्ये पाण्डवान्बलवत्तरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017464, "chapter_id": 1362, "verse_number": "२-१०३-३६", "content_sanskrit": "तथा हि बलवान्राजा जरासन्धो महाद्युतिः।\nबाहुप्रहरणेनैव भीमेन निहतो युधि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017465, "chapter_id": 1362, "verse_number": "२-१०३-३७", "content_sanskrit": "तस्य ते शम एवास्तु पाण्डवैर्भरतर्षभ।\nउभयोः पक्षयोर्युक्तं क्रियतामविशङ्कया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017466, "chapter_id": 1362, "verse_number": "२-१०३-३८", "content_sanskrit": "एवं कृते महाराज परं श्रेयस्त्वमाप्स्यसि।\nएवं गावल्गणे क्षत्ता धर्मार्थसहितं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017467, "chapter_id": 1362, "verse_number": "२-१०३-३९", "content_sanskrit": "उक्तवान्न गृहीतं वै मया पुत्रहितैषिणा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017468, "chapter_id": 1362, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसाहस्रयां संहितायां वैयासिक्यां सभापर्वणि अनुद्यूतपर्वणि व्यधिकशततमोऽध्यायः॥ १०३॥ ॥ समाप्तमनुद्यूतपर्व सभापर्व च॥ इतः परं वनपर्व भविष्यति तस्यायमाद्यः श्लोकः। जनमेजय उवाच॥ एवं द्यूतजिताः पार्थाः कोपिताश्च दुरात्मभिः। धार्तराष्ट्रैः सहामात्यैर्निकृत्या द्विजसत्तम॥ १॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]