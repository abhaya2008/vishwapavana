[{"id": 7003981000, "chapter_id": 23981, "verse_number": "३-१-४४-१", "content_sanskrit": "ऋषय ऊचुः ।\nसर्ववेदार्थतत्त्वज्ञ पुराणार्णवपारग ।\nव्यासपादांबुजद्वंद्वनमस्कारहृताशुभ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003981001, "chapter_id": 23981, "verse_number": "३-१-४४-२", "content_sanskrit": "पुराणार्थोपदेशेन सर्वप्राण्युपका रक ।\nत्वया ह्यनुगृहीताः स्म पुराणकथनाद्वयम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003981002, "chapter_id": 23981, "verse_number": "३-१-४४-३", "content_sanskrit": "अधुना सेतुमाहात्म्यकथनात्सुतरां मुने ।\nवयं कृतार्थाः संजाता व्यासशिष्य महामते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003981003, "chapter_id": 23981, "verse_number": "३-१-४४-४", "content_sanskrit": "यथा प्रातिष्ठिपल्लिंगं रामो दशरथात्मजः ।\nतच्छ्रोतुं वयमिच्छामस्त्वमिदानीं वदस्व नः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003981004, "chapter_id": 23981, "verse_number": "३-१-४४-५", "content_sanskrit": "श्रीसूत उवाच ।\nयदर्थं स्थापितं लिंगं गन्धमादनपर्वते ।\nरामचन्द्रेण विप्रेंद्र तदिदानीं ब्रवीमि वः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003981005, "chapter_id": 23981, "verse_number": "३-१-४४-६", "content_sanskrit": "हृतभार्यो वनाद्रामो रावणेन बलीयसा ।\nकपिसेनायुतो धीरः ससौमि त्रिर्महाबलः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003981006, "chapter_id": 23981, "verse_number": "३-१-४४-७", "content_sanskrit": "महेंद्रं गिरिमासाद्य व्यलोकयत वारिधिम् ।\nतस्मिन्नपारे जलधौ कृत्वा सेतुं रघूद्वहः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003981007, "chapter_id": 23981, "verse_number": "३-१-४४-८", "content_sanskrit": "तेन गत्वा पुरीं लंकां रावणेनाभिरक्षि ताम् ।\nअस्तंगते सहस्रांशौ पौर्णमास्यां निशामुखे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003981008, "chapter_id": 23981, "verse_number": "३-१-४४-९", "content_sanskrit": "रामः ससैनिको विप्राः सुवेलगिरिमारुहत् ।\nततः सौधस्थितं रात्रौ दृष्ट्वा लंकेश्वरं बली॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003981009, "chapter_id": 23981, "verse_number": "३-१-४४-१०", "content_sanskrit": "सूर्यपुत्रोऽस्य मुकुटं पातयास भूतले ।\nराक्षसो भग्नमुकुटः प्रविवेश गृहोदरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003981010, "chapter_id": 23981, "verse_number": "३-१-४४-११", "content_sanskrit": "गृहं प्रविष्टे लंकेशे रामः सुग्रीवसंयुतः ।\nसानुजः सेनया सार्द्धमवरुह्य गिरेस्तटात्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003981011, "chapter_id": 23981, "verse_number": "३-१-४४-१२", "content_sanskrit": "सेनां न्यवेशयद्वीरो रामो लंकासमीपतः ।\nततो निवेशमानांस्तान्वानरान्रावणानुगाः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003981012, "chapter_id": 23981, "verse_number": "३-१-४४-१३", "content_sanskrit": "अभिजग्मुर्महाकायाः सायुधाः सहसैनिकाः ।\nपर्वणः पूतनो जृंभः खरः क्रोधवशो हरिः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003981013, "chapter_id": 23981, "verse_number": "३-१-४४-१४", "content_sanskrit": "प्रारुजश्चारुजश्चैव प्रहस्तश्चेतरे तथा ।\nततोऽभिपततां तेषामदृश्यानां दुरात्मनाम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003981014, "chapter_id": 23981, "verse_number": "३-१-४४-१५", "content_sanskrit": "अन्तर्धानवधं तत्र चकार स्म विभीषणः ।\nते दृश्यमाना बलिभिर्हरिभिर्दूरपातिभिः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003981015, "chapter_id": 23981, "verse_number": "३-१-४४-१६", "content_sanskrit": "निहताः सर्वतश्चैते न्यपतन्वै गतासवः ।\nअमृष्यमाणः सबलो रावणो निर्ययावथ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003981016, "chapter_id": 23981, "verse_number": "३-१-४४-१७", "content_sanskrit": "व्यूह्य तान्वानरान्सर्वान्न्यवारयत सायकैः ।\nराघवस्त्वथ निर्याय व्यूढानीको दशाननम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003981017, "chapter_id": 23981, "verse_number": "३-१-४४-१८", "content_sanskrit": "प्रत्ययुध्यत वेगेन द्वंद्वयुद्धमभूत्तदा ।\nयुयुधे लक्ष्मणेनाथ इंद्रजिद्रावणात्मजः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003981018, "chapter_id": 23981, "verse_number": "३-१-४४-१९", "content_sanskrit": "विरूपाक्षेण सुग्रीवस्तारेयेणापि खर्वटः ।\nपौंड्रेण च नलस्तत्र पुटेशः पनसेन च॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003981019, "chapter_id": 23981, "verse_number": "३-१-४४-२०", "content_sanskrit": "अन्येपि कपयो वीरा राक्षसैर्द्वंद्वमेत्य तु ।\nचक्रुर्युद्धं सुतुमुलं भीरूणां भयवर्द्धनम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003981020, "chapter_id": 23981, "verse_number": "३-१-४४-२१", "content_sanskrit": "अथ रक्षांसि भिन्नानि वानरैर्भीमविक्रमैः ।\nप्रदुद्रुवू रणादाशु लंकां रावणपालिताम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003981021, "chapter_id": 23981, "verse_number": "३-१-४४-२२", "content_sanskrit": "भग्नेषु सर्वसैन्येषु रावणप्रेरितेन वै ।\nपुत्रेणेंद्रजिता युद्धे नागास्त्रैरतिदारुणैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003981022, "chapter_id": 23981, "verse_number": "३-१-४४-२३", "content_sanskrit": "विद्धौ दाशरथी विप्रा उभौ तौ रामलक्ष्मणौ ।\nमोचितौ वैनतेयेन गरुडेन महात्मना॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003981023, "chapter_id": 23981, "verse_number": "३-१-४४-२४", "content_sanskrit": "तत्र प्रहस्तस्तरसा समभ्येत्य विभीषणम् ।\nगदया ताडयामास विनद्य रणकर्कशः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003981024, "chapter_id": 23981, "verse_number": "३-१-४४-२५", "content_sanskrit": "स तयाभिहतो धीमान्गदया भामिवेगया ।\nनाकंपत महाबाहुर्हिमवानिव सुस्थितः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003981025, "chapter_id": 23981, "verse_number": "३-१-४४-२६", "content_sanskrit": "ततः प्रगृह्य विपुलामष्टघंटां विभीषणः ।\nअभिमंत्र्य महाशक्तिं चिक्षे पास्य शिरः प्रति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003981026, "chapter_id": 23981, "verse_number": "३-१-४४-२७", "content_sanskrit": "पतंत्या स तया वेगाद्राक्षसोऽशनिना यथा ।\nहृतोत्तमांगो ददृशे वातरुग्ण इव द्रुमः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003981027, "chapter_id": 23981, "verse_number": "३-१-४४-२८", "content_sanskrit": "तं दृष्ट्वा निहतं संख्ये प्रहस्तं क्षणदाचरम् ।\nअभिदुद्राव धूम्राक्षो वेगेन महता कपीन्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003981028, "chapter_id": 23981, "verse_number": "३-१-४४-२९", "content_sanskrit": "कपिसैन्यं समालोक्य विद्रुतं पवनात्मजः ।\nधूम्राक्षमाजघानाशु शरेण रणमूर्धनि॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003981029, "chapter_id": 23981, "verse_number": "३-१-४४-३०", "content_sanskrit": "धूम्राक्षं निहतं दृष्ट्वा हतशेषा निशाचराः ।\nसर्वं राज्ञे यथावृत्तं रावणाय न्यवेदयन्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003981030, "chapter_id": 23981, "verse_number": "३-१-४४-३१", "content_sanskrit": "ततः शयानं लंकेशः कुम्भकर्णमबोधयत् ।\nप्रबुद्धं प्रेषयामास युद्धाय स च रावणः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003981031, "chapter_id": 23981, "verse_number": "३-१-४४-३२", "content_sanskrit": "आगतं कुम्भकर्णं तं ब्रह्मास्त्रेण तु लक्ष्मणः ।\nजघान समरे क्रुद्धो गतासुर्न्यपतच्च सः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003981032, "chapter_id": 23981, "verse_number": "३-१-४४-३३", "content_sanskrit": "दूषणस्यानुजौ तत्र वत्रवेगप्रमाथिनौ ।\nहनुमन्नीलनिहतौ रावणप्रतिमौ रणे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003981033, "chapter_id": 23981, "verse_number": "३-१-४४-३४", "content_sanskrit": "वज्रदंष्ट्रं समवधीद्विश्वकर्मसुतो नलः ।\nअकंपनं च न्यहनत्कुमुदो वानरर्षभः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003981034, "chapter_id": 23981, "verse_number": "३-१-४४-३५", "content_sanskrit": "षष्ठ्यां पराजितो राजा प्राविशच्च पुरीं ततः ।\nअतिकायो लक्ष्मणेन हतश्च त्रिशिरास्तथा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003981035, "chapter_id": 23981, "verse_number": "३-१-४४-३६", "content_sanskrit": "सुग्रीवेण हतौ युद्धे देवांत कनरांतकौ ।\nहनूमता हतौ युद्धे कुम्भकर्णसुतावुभौ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003981036, "chapter_id": 23981, "verse_number": "३-१-४४-३७", "content_sanskrit": "विभीषणेन निहतो मकराक्षः खरात्मजः ।\nतत इन्द्रजितं पुत्रं चोदयामास रावणः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003981037, "chapter_id": 23981, "verse_number": "३-१-४४-३८", "content_sanskrit": "इन्द्रजिन्मोहयित्वा तौ भ्रातरौ रामलक्षमणौ ।\nघोरैः शरैरंगदेन हतवाहो दिवि स्थितः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003981038, "chapter_id": 23981, "verse_number": "३-१-४४-३९", "content_sanskrit": "कुमुदांगदसुग्रीवनलजांबवदादिभिः ।\nसहिता वानराः सर्वे न्यपतंस्तेन घातिताः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003981039, "chapter_id": 23981, "verse_number": "३-१-४४-४०", "content_sanskrit": "एवं निहत्य समरे ससैन्यौ रामलक्ष्मणौ ।\nअंतर्दधे तदा व्योम्नि मेघनादो महाबलः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003981040, "chapter_id": 23981, "verse_number": "३-१-४४-४१", "content_sanskrit": "ततो विभीषणो राममिक्ष्वाकुकुलभूषणम् ।\nउवाच प्रांजलिर्वाक्यं प्रणम्य च पुनःपुनः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003981041, "chapter_id": 23981, "verse_number": "३-१-४४-४२", "content_sanskrit": "अयमंभो गृहीत्वा तु राजराजस्य शासनात् ।\nगुह्यकोऽभ्यागतो राम त्वत्सकाशमरिंदम॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003981042, "chapter_id": 23981, "verse_number": "३-१-४४-४३", "content_sanskrit": "इदमंभः कुबेरस्ते महाराज प्रयच्छति ।\nअंतर्हितानां भूतानां दर्शनार्थं परं तप॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003981043, "chapter_id": 23981, "verse_number": "३-१-४४-४४", "content_sanskrit": "अनेन स्पृष्टनयनो भूतान्यंतर्हितान्यपि ।\nभवान्द्रक्ष्यति यस्मै वा भवानेतत्प्रदास्यति॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003981044, "chapter_id": 23981, "verse_number": "३-१-४४-४५", "content_sanskrit": "सोऽपि द्रक्ष्यति भूतानि वियत्त्यंतर्हितानि वै ।\nतथेति रामस्तद्वारि प्रतिगृह्याथ सत्कृतम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003981045, "chapter_id": 23981, "verse_number": "३-१-४४-४६", "content_sanskrit": "चकार नेत्रयोः शौचं लक्ष्मणश्च महाबलः ।\nसुग्रीवजांबवन्तौ च हनुमानंगदस्तथा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003981046, "chapter_id": 23981, "verse_number": "३-१-४४-४७", "content_sanskrit": "मैंदद्विविदनीलाश्च ये चान्ये वानरास्तथा ।\nते सर्वे रामदत्तेन वारिणा शुद्धचक्षुषः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003981047, "chapter_id": 23981, "verse_number": "३-१-४४-४८", "content_sanskrit": "आकाशेंतर्हितं वीरमपश्यन्रावणा त्मजम् ।\nततस्तमभिदुद्राव सौमित्रिर्दृष्टिगोचरम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003981048, "chapter_id": 23981, "verse_number": "३-१-४४-४९", "content_sanskrit": "ततो जघान संकुद्धो लक्ष्मणः कृतलक्षणः ।\nकुवेरप्रेषितजलैः पवित्रीकृतलोचनः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003981049, "chapter_id": 23981, "verse_number": "३-१-४४-५०", "content_sanskrit": "ततः समभवद्युद्धं लक्ष्मणेंद्रजितोर्महत् ।\nअतीव चित्रमाश्चर्यं शक्रप्रह्लादयोरिव॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003981050, "chapter_id": 23981, "verse_number": "३-१-४४-५१", "content_sanskrit": "ततस्तृतीयदिवसे यत्नेन महता द्विजाः ।\nइंद्रजिन्निहतो युद्धे लक्ष्मणेन बलीयसा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003981051, "chapter_id": 23981, "verse_number": "३-१-४४-५२", "content_sanskrit": "ततो मूलबलं सर्वं हतं रामेण धीमता ।\nअथ क्रुद्धो दशग्रीवः प्रियपुत्रे निपातिते॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003981052, "chapter_id": 23981, "verse_number": "३-१-४४-५३", "content_sanskrit": "निर्ययौ रथमास्थाय नगराद्बहुसैनिकः ।\nरावणो जानकीं हन्तुमुद्युक्तो विंध्यवारितः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003981053, "chapter_id": 23981, "verse_number": "३-१-४४-५४", "content_sanskrit": "ततो हर्यश्वयुक्तेन रथेनादित्यवर्चसा ।\nउपतस्थे रणे रामं मातलिः शक्रसारथिः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003981054, "chapter_id": 23981, "verse_number": "३-१-४४-५५", "content_sanskrit": "ऐन्द्रं रथं समारुह्य रामो धर्मभृतां वरः ।\nशिरांसि राक्षसेन्द्रस्य ब्रह्मास्त्रेणावधीद्रणे॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003981055, "chapter_id": 23981, "verse_number": "३-१-४४-५६", "content_sanskrit": "ततो हतदशग्रीवं रामं दशरथात्मजम् ।\nआशीर्भिर्जययुक्ताभिर्देवाः सर्षिपुरोगमाः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003981056, "chapter_id": 23981, "verse_number": "३-१-४४-५७", "content_sanskrit": "तुष्टुवुः परिसंतुष्टाः सिद्धविद्याधरास्तथा ।\nरामं कमलपत्राक्षं पुष्प वर्षेरवाकिरन्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003981057, "chapter_id": 23981, "verse_number": "३-१-४४-५८", "content_sanskrit": "रामस्तैः सुरसंघातैः सहितः सैनिकैर्वृतः ।\nसीतासौमित्रिसहितः समारुह्य च पुष्पकम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003981058, "chapter_id": 23981, "verse_number": "३-१-४४-५९", "content_sanskrit": "तथाभिषिच्य राजानं लंकायां च विभीषणम् ।\nकपिसेनावृतो रामो गन्धमादनमन्वगात्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003981059, "chapter_id": 23981, "verse_number": "३-१-४४-६०", "content_sanskrit": "परिशोध्य च वैदेहीं गंधमादनपर्वते ।\nरामं कमलपत्राक्षं स्थितवानर संवृतम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003981060, "chapter_id": 23981, "verse_number": "३-१-४४-६१", "content_sanskrit": "हतलंकेश्वरं वीरं सानुजं सविभीषणम् ।\nसभार्यं देववृंदैश्च सेवितं मुनिपुंगवैः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003981061, "chapter_id": 23981, "verse_number": "३-१-४४-६२", "content_sanskrit": "मुनयोऽभ्यागता द्रष्टुं दंडकारण्य वासिनः ।\nअगस्त्यं ते पुरस्कृत्य तुष्टुवुर्मैथिलीपतिम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003981062, "chapter_id": 23981, "verse_number": "३-१-४४-६३", "content_sanskrit": "मुनय ऊचुः ।\nनमस्ते रामचंद्राय लोकानुग्रहकारिणे ।\nअरावणं जगत्कर्तुमवतीर्णाय भूतले॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003981063, "chapter_id": 23981, "verse_number": "३-१-४४-६४", "content_sanskrit": "ताटिकादेहसंहर्त्रे गाधिजाध्वररक्षिणे ।\nनमस्ते जितमारीच सुवाहुप्राणहारिणे॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003981064, "chapter_id": 23981, "verse_number": "३-१-४४-६५", "content_sanskrit": "अहल्यामुक्तिसंदायिपादपंकजरेणवे ।\nनमस्ते हरकोदण्डलीलाभञ्जनकारिणे॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003981065, "chapter_id": 23981, "verse_number": "३-१-४४-६६", "content_sanskrit": "नमस्ते मैथिलीपाणिग्रहणोत्सवशालिने ।\nनमस्ते रेणुकापुत्रपराजयविधायिने॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003981066, "chapter_id": 23981, "verse_number": "३-१-४४-६७", "content_sanskrit": "सहलक्ष्मणसीताभ्यां कैकेय्यास्तु वरद्वयात् ।\nसत्यं पितृवचः कर्तुं नमो वनमुपे युषे॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003981067, "chapter_id": 23981, "verse_number": "३-१-४४-६८", "content_sanskrit": "भरतप्रार्थनादत्तपादुकायुगुलाय ते ।\nनमस्ते शरभंगस्य स्वर्गप्राप्त्यैकहेतवे॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003981068, "chapter_id": 23981, "verse_number": "३-१-४४-६९", "content_sanskrit": "नमो विराधसंहर्त्रे गृधराजस खाय ते ।\nमायामृगमहाक्रूरमारीचांगविदारिणे॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003981069, "chapter_id": 23981, "verse_number": "३-१-४४-७०", "content_sanskrit": "सीतापहारिलोकेशयुद्धत्यक्तकलेवरम् ।\nजटायुषं तु संदह्य तत्कैवल्यप्रदायिने॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003981070, "chapter_id": 23981, "verse_number": "३-१-४४-७१", "content_sanskrit": "नमः कबंधसंहर्त्रे शवरीपूजितांघ्रये ।\nप्राप्तसुग्रीवसख्याय कृतवालिवधाय ते॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003981071, "chapter_id": 23981, "verse_number": "३-१-४४-७२", "content_sanskrit": "नमः कृतवते सेतुं समुद्रे वरुणालये ।\nसर्वराक्षससंहर्त्रे रावणप्राणहारिणे॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003981072, "chapter_id": 23981, "verse_number": "३-१-४४-७३", "content_sanskrit": "संसारांबुधिसंतारपोतपादांबुजाय ते ।\nनमो भक्तार्तिसंहर्त्रे सच्चिदानंदरूपिणे॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003981073, "chapter_id": 23981, "verse_number": "३-१-४४-७४", "content_sanskrit": "नमस्ते राम भद्राय जगतामृद्धिहेतवे ।\nरामादिपुण्यनामानि जपतां पापहारिणे॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003981074, "chapter_id": 23981, "verse_number": "३-१-४४-७५", "content_sanskrit": "नमस्ते सर्वलोकानां सृष्टिस्थित्यंतकारिणे ।\nनमस्ते करुणामूर्ते भक्तरक्षणदीक्षित॥ ७८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003981075, "chapter_id": 23981, "verse_number": "३-१-४४-७६", "content_sanskrit": "ससीताय नमस्तुभ्यं विभीषणसुखप्रद ।\nलंकेश्वरवधाद्राम पालितं हि जगत्त्वया॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003981076, "chapter_id": 23981, "verse_number": "३-१-४४-७७", "content_sanskrit": "रक्षरक्ष जगन्नाथ पाह्य स्माञ्जानकीपते ।\nस्तुत्वैवं मुनयः सर्वे तूष्णीं तस्थुर्द्विजोत्तमाः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003981077, "chapter_id": 23981, "verse_number": "३-१-४४-७८", "content_sanskrit": "श्रीसूत उवाच ।\nय इदं रामचन्द्रस्य स्तोत्रं मुनिभिरीरितम् ।\nत्रिसंध्यं पठते भक्त्या भुक्तिं मुक्तिं च विंदति॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003981078, "chapter_id": 23981, "verse_number": "३-१-४४-७९", "content_sanskrit": "प्रयाणकाले पठतो न् भीतिरुपजायते ।\nएतत्स्तोत्रस्य पठनाद्भूतवेतालकादयः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003981079, "chapter_id": 23981, "verse_number": "३-१-४४-८०", "content_sanskrit": "नश्यंति रोगा नश्यंति नश्यते पापसंचयः ।\nपुत्रकामो लभेत्पुत्रं कन्या विंदति सत्पतिम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003981080, "chapter_id": 23981, "verse_number": "३-१-४४-८१", "content_sanskrit": "मोक्षकामो लभेन्मोक्षं धनकामो धनं लभेत् ।\nसर्वान्कामानवाप्नोति पठन्भक्त्या त्विमं स्तवम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003981081, "chapter_id": 23981, "verse_number": "३-१-४४-८२", "content_sanskrit": "ततो रामो मुनीन्प्राह प्रणम्य च कृतांजलिः ।\nअहं विशुद्धये प्राप्यः सकलैरपि मानवैः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003981082, "chapter_id": 23981, "verse_number": "३-१-४४-८३", "content_sanskrit": "मद्दृष्टिगोचरो जन्तुर्नित्यमोक्षस्य भाजनम् ।\nतथापि मुनयो नित्यं भक्तियुक्तेन चेतसा॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003981083, "chapter_id": 23981, "verse_number": "३-१-४४-८४", "content_sanskrit": "स्वात्मलाभेन संतुष्टान्साधून्भूतसुहृत्तमान् ।\nनिरहंकारिणः शांतान्नमस्याम्यूर्ध्वरेतसः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003981084, "chapter_id": 23981, "verse_number": "३-१-४४-८५", "content_sanskrit": "यस्माद्ब्रह्मण्यदेवोऽहमतो विप्रान्भजे सदा ।\nयुष्मान्पृच्छाम्यहं किंचित्तद्वदध्वं विचार्य तु॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003981085, "chapter_id": 23981, "verse_number": "३-१-४४-८६", "content_sanskrit": "रावणस्य वधाद्विप्रा यत्पापं मम वर्तते ।\nतस्य मे निष्कृतिं ब्रूत पौलस्त्यवधजस्य हि ।\nयत्कृत्वा तेन पापे न मुच्येऽहं मुनिपुंगवाः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003981086, "chapter_id": 23981, "verse_number": "३-१-४४-८७", "content_sanskrit": "मुनय ऊचुः ।\nसत्यव्रत जगन्नाथ जगद्रक्षाधुरंधर॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003981087, "chapter_id": 23981, "verse_number": "३-१-४४-८८", "content_sanskrit": "सर्वलोकोपकारार्थं कुरु राम शिवार्चनम् ।\nगन्धमादनशृंगेऽस्मिन्महापुण्ये विमुक्तिदे॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003981088, "chapter_id": 23981, "verse_number": "३-१-४४-८९", "content_sanskrit": "शिवलिंगप्रतिष्ठां त्वं लोकसंग्रहकाम्यया ।\nकुरु राम दशग्रीववधदोषापनुत्तये॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003981089, "chapter_id": 23981, "verse_number": "३-१-४४-९०", "content_sanskrit": "लिंगस्थापनजं पुण्यं चतुर्वक्त्रोऽपि भाषितुम् ।\nन शक्नोति ततो वक्तुं किं पुनर्मनुजेश्वर॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003981090, "chapter_id": 23981, "verse_number": "३-१-४४-९१", "content_sanskrit": "यत्त्वया स्थाप्यते लिगं गन्धमादनपर्वते ।\nअस्य संदर्शनं पुंसां काशीलिंगावलोकनात्॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003981091, "chapter_id": 23981, "verse_number": "३-१-४४-९२", "content_sanskrit": "अधिकं कोटिगुणितं फलवत्स्यान्न संशयः ।\nतव नाम्ना त्विदं लिंगं लोके ख्यातिं समश्नुताम्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003981092, "chapter_id": 23981, "verse_number": "३-१-४४-९३", "content_sanskrit": "नाशकं पुण्यपापाख्यकाष्ठानां दहनोपमम् ।\nइदं रामेश्वरं लिंगं ख्यातं लोके भविष्यति॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003981093, "chapter_id": 23981, "verse_number": "३-१-४४-९४", "content_sanskrit": "मा विलंबं कुरुष्वातो लिंगस्थापनकर्मणि ।\nरामचंद्र महाभाग करुणापूर्णविग्रह॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003981094, "chapter_id": 23981, "verse_number": "३-१-४४-९५", "content_sanskrit": "श्रीसूत उवाच ।\nइति श्रुत्वा वचो रामो मुनीनां तं मुनीश्वराः ।\nपुण्यकालं विचार्याथ द्विमुहूर्तं जगत्पतिः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003981095, "chapter_id": 23981, "verse_number": "३-१-४४-९६", "content_sanskrit": "कैलासं प्रेषयामास हनुमन्तं शिवालयम् ।\nशिवलिंगं समानेतुं स्थापनार्थं रघूद्वहः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003981096, "chapter_id": 23981, "verse_number": "३-१-४४-९७", "content_sanskrit": "राम उवाच ।\nहनूमन्नंजनीसूनो वायुपुत्र महाबल ।\nकैलासं त्वरितो गत्वा लिंगमानय मा चिरम्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003981097, "chapter_id": 23981, "verse_number": "३-१-४४-९८", "content_sanskrit": "इत्याज्ञप्तस्स रामेण भुजावास्फाल्य वीर्यवान् ।\nमुहूर्तद्वितयं ज्ञात्वा पुण्यकालं कपीश्वरः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003981098, "chapter_id": 23981, "verse_number": "३-१-४४-९९", "content_sanskrit": "पश्यतां सर्वदेवानामृषीणां च महात्मनाम् ।\nउत्पपात महावेगश्चालयन्गंधमादनम्॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003981099, "chapter_id": 23981, "verse_number": "३-१-४४-१००", "content_sanskrit": "लंघयन्स वियन्मार्गं कैलासं पर्वतं ययौ ।\nन ददर्श महादेवं लिंगरूपधरं कपिः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003981100, "chapter_id": 23981, "verse_number": "३-१-४४-१०१", "content_sanskrit": "कैलासे पर्वते तस्मिन्पुण्ये शंकरपालिते ।\nआंजनेयस्तपस्तेपे लिंगप्राप्त्यर्थमादरात्॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003981101, "chapter_id": 23981, "verse_number": "३-१-४४-१०२", "content_sanskrit": "प्रागग्रेषु समासीनः कुशेषु मुनिपुंगवाः ।\nऊर्ध्वबाहुर्निरालम्बो निरुच्छ्वासो जितेंद्रियः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003981102, "chapter_id": 23981, "verse_number": "३-१-४४-१०३", "content_sanskrit": "प्रसादयन्महादेवं लिंगं लेभे स मारुतिः ।\nएतस्मिन्नंतरे विप्रा मुनिभिस्तत्त्वदर्शिभिः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003981103, "chapter_id": 23981, "verse_number": "३-१-४४-१०४", "content_sanskrit": "अनागतं हनूमंतं कालं स्वल्पावशेषितम् ।\nज्ञात्वा प्रकथितं तत्र रामं प्रति महामतिम्॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003981104, "chapter_id": 23981, "verse_number": "३-१-४४-१०५", "content_sanskrit": "रामराम महाबाहो कालो ह्यत्येति सांप्रतम् ।\nजानक्या यत्कृतं लिंगं सैकतं लीलया विभो॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003981105, "chapter_id": 23981, "verse_number": "३-१-४४-१०६", "content_sanskrit": "तल्लिंगं स्थापयस्वाद्य महालिंगमनुत्तमम् ।\nश्रुत्वैतद्वचनं रामो जानक्या सह सत्वरम्॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003981106, "chapter_id": 23981, "verse_number": "३-१-४४-१०७", "content_sanskrit": "मुनिभिः सहितः प्रीत्या कृतकौतुकमंगलः ।\nज्येष्ठे मासे सिते पक्षे दशम्यां बुधहस्तयोः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003981107, "chapter_id": 23981, "verse_number": "३-१-४४-१०८", "content_sanskrit": "गरानंदे व्यतीपाते कन्या चन्द्रे वृषे रवौ ।\nदशयोगे महापुण्ये गन्धमादनपर्वते॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003981108, "chapter_id": 23981, "verse_number": "३-१-४४-१०९", "content_sanskrit": "सेतुमध्ये महादेवं लिंगरूपधरं हरम् ।\nईशानं कृत्तिवसनं गंगाचंद्रकलाधरम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003981109, "chapter_id": 23981, "verse_number": "३-१-४४-११०", "content_sanskrit": "रामो वै स्थापयामास शिवलिंगमनुत्तमम् ।\nलिंगस्थं पूजयामास राघवः सांबमीश्वरम्॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003981110, "chapter_id": 23981, "verse_number": "३-१-४४-१११", "content_sanskrit": "लिंगस्थः स महादेवः पार्वत्या सह शंकरः ।\nप्रत्यक्षमेव भगवान्दत्तवान्वरमुत्तमम्॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003981111, "chapter_id": 23981, "verse_number": "३-१-४४-११२", "content_sanskrit": "सर्वलोकशरण्याय राघवाय महात्मने ।\nत्वयात्र स्थापितं लिंगं ये पश्यंति रघूद्वह॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003981112, "chapter_id": 23981, "verse_number": "३-१-४४-११३", "content_sanskrit": "महापातकयुक्ताश्च तेषां पापं प्रणश्यति ।\nसर्वाण्यपि हि पापानि धनुष्कोटौ निमज्जनात्॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003981113, "chapter_id": 23981, "verse_number": "३-१-४४-११४", "content_sanskrit": "दर्शनाद्रामलिंगस्य पातकानि महांत्यपि ।\nविलयं यांति राजेंद्र रामचन्द्र न संशयः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003981114, "chapter_id": 23981, "verse_number": "३-१-४४-११५", "content_sanskrit": "प्रादादेवं हि रामाय वरं देवोंऽबिकापतिः ।\nतदग्रे नंदिकेशं च स्थापयामास राघवः॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003981115, "chapter_id": 23981, "verse_number": "३-१-४४-११६", "content_sanskrit": "ईश्वरस्याभिषेकार्थं धनुष्कोट्याथ राघवः ।\nएकं कूपं धरां भित्त्वा जनयामास वै द्विजाः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003981116, "chapter_id": 23981, "verse_number": "३-१-४४-११७", "content_sanskrit": "तस्माज्जलमुपादाय स्नापयामास शंकरम् ।\nकोटितीर्थमिति प्रोक्तं तत्तीर्थं पुण्यमुत्तमम्॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003981117, "chapter_id": 23981, "verse_number": "३-१-४४-११८", "content_sanskrit": "उक्तं तद्वैभवं पूर्वमस्माभिर्मुनिपुंगवाः ।\nदेवाश्च मुनयो नागा गन्धर्वाप्स रसां गणाः ।\nसर्वेपि वानरा लिंगमेकैकं चक्रुरादरात्॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003981118, "chapter_id": 23981, "verse_number": "३-१-४४-११९", "content_sanskrit": "श्रीसूत उवाच ।\nएवं वः कथितं विप्रा यथा रामेण धीमत॥ १५९ ॥१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003981119, "chapter_id": 23981, "verse_number": "३-१-४४-१२०", "content_sanskrit": "स्थापितं शिवलिंगं वै भुक्तिमुक्तिप्रदायकम् ।\nइमां लिंगप्रतिष्ठां यः शृणोति पठतेऽथवा॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003981120, "chapter_id": 23981, "verse_number": "३-१-४४-१२१", "content_sanskrit": "स रामेश्वरलिंगस्य सेवाफलमवाप्नुयात् ।\nसायुज्यं च समाप्नोति रामनाथस्य वैभवात्॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}]