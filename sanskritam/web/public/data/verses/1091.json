[{"id": 2004538, "chapter_id": 1091, "verse_number": "१-९२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004539, "chapter_id": 1091, "verse_number": "१-९२-१", "content_sanskrit": "ततो गच्छन्महाबाहुरेकोऽमात्यान्विसृज्य तान्।\nनापश्यच्चाश्रमे तस्मिंस्तमृषिं संशितव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004540, "chapter_id": 1091, "verse_number": "१-९२-२", "content_sanskrit": "सोऽपश्यमानस्तमृषिं शून्यं दृष्ट्वा तथाऽऽश्रमम्।\nउवाच क इहेत्युच्चैर्वनं सन्नादयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004541, "chapter_id": 1091, "verse_number": "१-९२-३", "content_sanskrit": "श्रुत्वाऽथ तस्य तं शब्दं कन्या श्रीरिव रूपिणी।\nनिश्चक्रामाश्रमात्तस्मात्तापसीवेषधारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004542, "chapter_id": 1091, "verse_number": "१-९२-४", "content_sanskrit": "सा तं दृष्ट्वैव राजानं दुष्यन्तमसितेक्षणा।\nसुप्रीताऽभ्यागतं तं तु पूज्यं प्राप्तमथेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004543, "chapter_id": 1091, "verse_number": "१-९२-५", "content_sanskrit": "रूपयौवनसंपन्ना शीलाचारवती शुभा।\nसा तमायतपद्माक्षं व्यूढोरस्कं महाभुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004544, "chapter_id": 1091, "verse_number": "१-९२-६", "content_sanskrit": "सिंहस्कन्धं दीर्घबाहुं सर्वलक्षणपूजितम्।\nस्पृष्टं मधुरया वाचा साऽब्रवीज्जनमेजया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004545, "chapter_id": 1091, "verse_number": "१-९२-७", "content_sanskrit": "स्वागतं त इति क्षिप्रमुवाच प्रतिपूज्य च।\nआसनेनार्चयित्वा च पाद्येनार्घ्येण चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004546, "chapter_id": 1091, "verse_number": "१-९२-८", "content_sanskrit": "पप्रच्छानामयं राजन्कुशलं च नराधिपम्।\nयथावदर्चयित्वाऽथ पृष्ट्वा चानामयं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004547, "chapter_id": 1091, "verse_number": "१-९२-९", "content_sanskrit": "उवाच स्मयमानेव किं कार्यं क्रियतामिति।\nआश्रमस्याभिगमने किं त्वं कार्यं चिकीर्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004548, "chapter_id": 1091, "verse_number": "१-९२-१०", "content_sanskrit": "कस्त्वमद्येह संप्राप्तो महर्षेराश्रमं शुभम्।\nतामब्रवीत्ततो राजा कन्यां मधुरभाषिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004549, "chapter_id": 1091, "verse_number": "१-९२-११", "content_sanskrit": "दृष्ट्वा सर्वानवद्याङ्गीं यथावत्प्रतिपूजितः।\nराजर्षेस्तस्य पुत्रोऽहमिलिनस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004550, "chapter_id": 1091, "verse_number": "१-९२-१२", "content_sanskrit": "दुष्यन्त इति मे नाम सत्यं पुष्करलोचने।\nआगतोऽहं महाभागमृषिं कण्वमुपासितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004551, "chapter_id": 1091, "verse_number": "१-९२-१३", "content_sanskrit": "क्व गतो भगवान्भद्रे गन्ममाचक्ष्व शोभने।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004552, "chapter_id": 1091, "verse_number": "१-९२-१३x", "content_sanskrit": "शकुन्तलोवाच।\nगतः पिता मे भगवान्फलान्याहर्तुमाश्रमात्।\nमुहूर्तं संप्रतीक्षस्व द्रष्टास्येनमुपागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004553, "chapter_id": 1091, "verse_number": "१-९२-१४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004554, "chapter_id": 1091, "verse_number": "१-९२-१४", "content_sanskrit": "अपश्यमानस्तमृषिं तथा चोक्तस्तया च सः।\nतां दृष्ट्वा च वरारोहां श्रीमतीं चारुहासिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004555, "chapter_id": 1091, "verse_number": "१-९२-१५", "content_sanskrit": "विभ्राजमानां वपुषा तपसा च दमेन च।\nरूपयौवनसंपन्नामित्युवाच महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004556, "chapter_id": 1091, "verse_number": "१-९२-१६", "content_sanskrit": "का त्वं कस्यासि सुश्रोणि किमर्थं चागता वनम्।\nएवंरूपगुणोपेता कुतस्त्वमसि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004557, "chapter_id": 1091, "verse_number": "१-९२-१७", "content_sanskrit": "दर्शनादेव हि शुभे त्वया मेऽपहृतं मनः।\nइच्छामि त्वामहं ज्ञातुं तन्ममाचक्ष्व शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004558, "chapter_id": 1091, "verse_number": "१-९२-१८", "content_sanskrit": "स्थितोस्म्यमितसौभाग्ये विवक्षुश्चास्मि किंचन।\nशृणु मे नागनासोरु वचनं मत्तकाशिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004559, "chapter_id": 1091, "verse_number": "१-९२-१९", "content_sanskrit": "राजर्षेरन्वये जातः पूरोरस्मि विशेषतः।\nवृण्वे त्वामद्य सुश्रोणि दुष्यन्तो वरवर्णिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004560, "chapter_id": 1091, "verse_number": "१-९२-२०", "content_sanskrit": "न मेऽन्यत्र क्षत्रियाया मनो जातु प्रवर्तते।\nऋषिपुत्रीषु चान्यासु नावरासु परासु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004561, "chapter_id": 1091, "verse_number": "१-९२-२१", "content_sanskrit": "तस्मात्प्रणिहितात्मानं विद्दि मां कलभाषिणि।\nयस्यां मे त्वयि भावोऽस्ति क्षत्रिया ह्यसि का वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004562, "chapter_id": 1091, "verse_number": "१-९२-२२", "content_sanskrit": "न हि मे भीरु विप्रायां मनः प्रसहते गतिम्।\nभजे त्वामायतापाङ्गे भक्तं भजितुमर्हसि।\nभुङ्क्ष राज्यं विशालाक्षि बुद्धिं मात्वन्यथा कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004563, "chapter_id": 1091, "verse_number": "१-९२-२३", "content_sanskrit": "एवमुक्ता तु सा कन्या तेन राज्ञा तमाश्रमे।\nउवाच हसती वाक्यमिदं सुमधुराक्षरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004564, "chapter_id": 1091, "verse_number": "१-९२-२४", "content_sanskrit": "कण्वस्याहं भगवतो दुष्यन्त दुहिता मता।\nतपस्विनो धृतिमतो धर्मज्ञस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004565, "chapter_id": 1091, "verse_number": "१-९२-२५", "content_sanskrit": "अस्वतन्त्रास्मि राजेन्द्र काश्यपो मे गुरुः पिता।\nतमेव प्रार्थय स्वार्थं नायुक्तं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004566, "chapter_id": 1091, "verse_number": "१-९२-२६x", "content_sanskrit": "दुष्यन्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004567, "chapter_id": 1091, "verse_number": "१-९२-२६", "content_sanskrit": "ऊर्ध्वरेता महाभागे भगवाँल्लोकपूजितः।\nचलेद्धि वृत्ताद्धर्मोपि न चलेत्संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004568, "chapter_id": 1091, "verse_number": "१-९२-२७", "content_sanskrit": "कथं त्वं तस्य दुहिता संभूता वरवर्णिनी।\nसंशयो मे महानत्र तन्मे छेत्तुमिहार्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004569, "chapter_id": 1091, "verse_number": "१-९२-२८x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004570, "chapter_id": 1091, "verse_number": "१-९२-२८", "content_sanskrit": "यथाऽयमागमो मह्यं यथा चेदमभूत्पुरा।\nअन्यथा सन्तमात्मानमन्यथा सत्सु भाषते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004571, "chapter_id": 1091, "verse_number": "१-९२-२९", "content_sanskrit": "स पापेनावृतो मूर्खस्तेन आत्मापहारकः।\nशृणु राजन्यथातत्त्वं यथाऽस्मि दुहिता मुनेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004572, "chapter_id": 1091, "verse_number": "१-९२-३०", "content_sanskrit": "ऋषिः कश्चिदिहागम्य मम जन्माभ्यचोदयत्।\nऊर्ध्वरेता यथासि त्वं कुतस्त्वेयं शकुन्तला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004573, "chapter_id": 1091, "verse_number": "१-९२-३१", "content_sanskrit": "पुत्री त्वत्तः कथं जाता तत्त्वं मे ब्रूहि काश्यप।\nतस्मै प्रोवाच भगवान्यथा तच्छृणु पार्थिवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004574, "chapter_id": 1091, "verse_number": "१-९२-३२x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004575, "chapter_id": 1091, "verse_number": "१-९२-३२", "content_sanskrit": "तप्यमानः किल पुरा विश्वामित्रो महत्तपः।\nसुभृशं तापयामास शक्रं सुरगणेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004576, "chapter_id": 1091, "verse_number": "१-९२-३३", "content_sanskrit": "तपसा दीप्तवीर्योऽयं स्थानान्मां च्यावयेदिति।\nभीतः पुरन्दरस्तस्मान्मेनकामिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004577, "chapter_id": 1091, "verse_number": "१-९२-३४", "content_sanskrit": "गुणैरप्सरसां दिव्यैर्मेनके त्वं विशिष्यसे।\nश्रेयो मे कुरु कल्याणि यत्त्वां वक्ष्यामि तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2004578, "chapter_id": 1091, "verse_number": "१-९२-३५", "content_sanskrit": "असावादित्यशङ्काशो विश्वामित्रो महातपाः।\nतप्यमानस्तपो घोरं मम कम्पयते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2004579, "chapter_id": 1091, "verse_number": "१-९२-३६", "content_sanskrit": "मेनके तव भारोऽयं विश्वामित्रः सुमध्यमे।\nशंसितात्मा सुदुर्धर्ष उग्रे तपसि वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2004580, "chapter_id": 1091, "verse_number": "१-९२-३७", "content_sanskrit": "स मां न च्यावयेत्स्थानात्तं वै गत्वा प्रलोभय।\nचर तस्य तपोविघ्नं कुरु मे प्रियमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2004581, "chapter_id": 1091, "verse_number": "१-९२-३८", "content_sanskrit": "रूपयौवनमाधुर्यचेष्टितस्मितभाषणैः।\nलोभयित्वा वरारोहे तपसस्तं निवर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2004582, "chapter_id": 1091, "verse_number": "१-९२-३९x", "content_sanskrit": "मेनकोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2004583, "chapter_id": 1091, "verse_number": "१-९२-३९", "content_sanskrit": "महातेजाः स भगवांस्तथैव च महातपाः।\nकोपनश्च तथा ह्येनं जानाति भगवानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2004584, "chapter_id": 1091, "verse_number": "१-९२-४०", "content_sanskrit": "तेजस्तपसश्चैव कोपस्य च महात्मनः।\nत्वमप्युद्विजसे यस्य नोद्विजेयमहं कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2004585, "chapter_id": 1091, "verse_number": "१-९२-४१", "content_sanskrit": "महाभागं वसिष्ठं यः पुत्रैरिष्टैर्व्ययोजयत्।\nक्षत्रजातश्च यः पूर्वमभवद्ब्राह्मणो बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2004586, "chapter_id": 1091, "verse_number": "१-९२-४२", "content_sanskrit": "शौचार्थं यो नदीं चक्रे दुर्गमां बहुभिर्जलैः।\nयां तां पुण्यतमां लोके कौशिकीति विदुर्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2004587, "chapter_id": 1091, "verse_number": "१-९२-४३", "content_sanskrit": "बभार यत्रास्य पुरा काले दुर्गे महात्मनः।\nदारान्मतङ्गो धर्मात्मा राजर्षिर्व्याधतां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2004588, "chapter_id": 1091, "verse_number": "१-९२-४४", "content_sanskrit": "अतीतकाले दुर्भिक्षे अभ्येत्य पुनराक्षमम्।\nमुनिः पारेति नद्या वै नाम चक्रे तदा प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2004589, "chapter_id": 1091, "verse_number": "१-९२-४५", "content_sanskrit": "मतङ्गं याजयाञ्चक्रे यत्र प्रीतमनाः स्वयम्।\nत्वं च सोमं भयाद्यस्य गतः पातुं सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2004590, "chapter_id": 1091, "verse_number": "१-९२-४६", "content_sanskrit": "चकारान्यं च लोकं वै क्रुद्धो नक्षत्रसंपदा।\nप्रतिश्रवणपूर्वाणि नक्षत्राणि चकार यः।\nगुरुशापहतस्यापि त्रिशङ्कोः शरणं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2004591, "chapter_id": 1091, "verse_number": "१-९२-४७", "content_sanskrit": "ब्रह्मर्षिशापं राजर्षिः कथं मोक्ष्यति कौशिकः।\nअवमत्य तदा देवैर्यज्ञाङ्गं तद्विनाशितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2004592, "chapter_id": 1091, "verse_number": "१-९२-४८", "content_sanskrit": "अन्यानि च महातेजा यज्ञाङ्गान्यसृजत्प्रभुः।\nनिनाय च तदा स्वर्गं त्रिशङ्कुं स महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2004593, "chapter_id": 1091, "verse_number": "१-९२-४९", "content_sanskrit": "एतानि यस्य कर्माणि तस्याहं भृशमुद्विजे।\nयथाऽसौ न दहेत्क्रुद्धस्तथाऽऽज्ञापय मां विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2004594, "chapter_id": 1091, "verse_number": "१-९२-५०", "content_sanskrit": "तेजसा निर्दहेल्लोकान्कम्पयेद्धरणीं पदा।\nसंक्षिपेच्च महामेरुं तूर्णमावर्तयेद्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2004595, "chapter_id": 1091, "verse_number": "१-९२-५१", "content_sanskrit": "तादृशं तपसा युक्तं प्रदीप्तमिव पावकम्।\nकथमस्मद्विधा नारी जितेन्द्रियमभिस्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2004596, "chapter_id": 1091, "verse_number": "१-९२-५२", "content_sanskrit": "हुताशनमुखं दीप्तं सूर्यचन्द्राक्षितारकम्।\nकालजिह्वं सुरश्रेष्ठ कथमस्मद्विधा स्पृशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2004597, "chapter_id": 1091, "verse_number": "१-९२-५३", "content_sanskrit": "यमश्च सोमश्च महर्षयश्च\nसाध्या विश्वे वालस्विल्याश्च सर्वे।\nएतेऽपि यस्योद्विजन्ते प्रभावा-\nत्तस्मात्कस्मान्मादृशी नोद्विजेत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2004598, "chapter_id": 1091, "verse_number": "१-९२-५४", "content_sanskrit": "त्वयैवमुक्ता च कथं समीप-\nमृषेर्न गच्छेयमहं सुरेन्द्र।\nरक्षां च मे चिन्तय देवराज\nयथा त्वदर्थं रक्षिताऽहं चरेयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2004599, "chapter_id": 1091, "verse_number": "१-९२-५५", "content_sanskrit": "कामं तु मे मारुतस्तत्र वासः\nप्रक्रीडिताया विवृणोतु देव।\nभवेच्च मे मन्मथस्तत्र कार्ये\nसहायभूतस्तु तव प्रसादात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2004600, "chapter_id": 1091, "verse_number": "१-९२-५६", "content_sanskrit": "वनाच्च वायुः सुरभिः प्रवाया-\nत्तस्मिन्काले तमृषिं लोभयन्त्याः।\nतथेत्युक्त्वा विहिते चैव तस्मिं-\nस्ततो ययौ साऽऽश्रमं कौशिकस्य॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2004601, "chapter_id": 1091, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि द्विनवतितमोऽध्यायः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]