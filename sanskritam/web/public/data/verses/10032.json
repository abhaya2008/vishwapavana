[{"id": 6000032000, "chapter_id": 10032, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000032001, "chapter_id": 10032, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.001.m4a", "display_order": 2}, {"id": 6000032002, "chapter_id": 10032, "verse_number": "३-२-१", "content_sanskrit": "इति भागवतः पृष्टः क्षत्त्रा वार्तां प्रियाश्रयाम्।\nप्रतिवक्तुं न चोत्सेहे औत्कण्ठ्यात् स्मारितेश्वरः॥ ३/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.002.m4a", "display_order": 3, "topics": [{"text": "उद्धवेन विदुरं प्रति श्रीकृष्णस्य भूलोकत्यागकथनम्", "range": "१–१२"}]}, {"id": 6000032003, "chapter_id": 10032, "verse_number": "३-२-२", "content_sanskrit": "यः पञ्चहायनो मात्रा प्रातराशाय याचितः।\nनैच्छत् तद् रचयन् यस्य सपर्यां बाललीलया॥ ३/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.003.m4a", "display_order": 4}, {"id": 6000032004, "chapter_id": 10032, "verse_number": "३-२-३", "content_sanskrit": "स कथं सेवया तस्य कालेन जरसं गतः।\nपृष्टो वार्तां प्रतिब्रूयाद् भर्तुः पादावनुस्मरन्॥ ३/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.004.m4a", "display_order": 5}, {"id": 6000032005, "chapter_id": 10032, "verse_number": "३-२-४", "content_sanskrit": "स मुहूर्तमभूत् तूष्णीं कृष्णाङ्घ्रिसुधया भृशम्।\nतीव्रेण भक्तियोगेन निमग्नः साधु निर्वृतः॥ ३/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.005.m4a", "display_order": 6}, {"id": 6000032006, "chapter_id": 10032, "verse_number": "३-२-५", "content_sanskrit": "पुलकोद्भिन्नसर्वाङ्गो मुञ्चन् मीलद्दृशाश्रु सः।\nपूर्णार्थो लक्षितस्तेन स्नेहप्रसरसंप्लुतः॥ ३/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.006.m4a", "display_order": 7}, {"id": 6000032007, "chapter_id": 10032, "verse_number": "३-२-६", "content_sanskrit": "शनकैर्भगवल्लोकान्नृलोकं पुनरागतः।\nविमृज्य नेत्रे विदुरं प्रत्याहोद्धव उत्स्मयन्॥ ३/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.007.m4a", "display_order": 8}, {"id": 6000032008, "chapter_id": 10032, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.008.m4a", "display_order": 9}, {"id": 6000032009, "chapter_id": 10032, "verse_number": "३-२-७", "content_sanskrit": "कृष्णद्युमणिनिम्लोचे गीर्णेष्वजगरेण ह।\nकिं नु नः कुशलं ब्रूयां गतश्रीषु यदुष्वहम्॥ ३/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.009.m4a", "display_order": 10}, {"id": 6000032010, "chapter_id": 10032, "verse_number": "३-२-८", "content_sanskrit": "दुर्भगो बत लोकोऽयं यदवो नितरामपि।\nये संवसन्तो न विदुर्हरिं मीना यथाऽम्भसि॥ ३/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.010.m4a", "display_order": 11}, {"id": 6000032011, "chapter_id": 10032, "verse_number": "३-२-९", "content_sanskrit": "इङ्गितज्ञाः पुरप्रौढा एकारामाश्च सात्वताः।\nसात्वतामृषभं सर्वे भूतावासममंसत॥ ३/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.011.m4a", "display_order": 12}, {"id": 6000032012, "chapter_id": 10032, "verse_number": "३-२-१०", "content_sanskrit": "देवस्य मायया स्पृष्टा ये चान्ये असदाश्रयाः।\nभ्राम्यते धीर्न तद्वाक्यैरात्मन्युप्तामलाऽत्मनाम्॥ ३/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.012.m4a", "display_order": 13}, {"id": 6000032013, "chapter_id": 10032, "verse_number": "३-२-११", "content_sanskrit": "प्रदर्श्यातप्ततपसामवितृप्तदृशां नृणाम्।\nआदायान्तरधाद् यस्तु स्वबिम्बं लोकलोचनम्॥ ३/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.013.m4a", "display_order": 14}, {"id": 6000032014, "chapter_id": 10032, "verse_number": "३-२-१२", "content_sanskrit": "यन्मर्त्यलीलौपयिकं स्वयोगमायाबलं दर्शयता गृहीतम्।\nविस्मापनं स्वस्य च सौभगर्द्धेः परं पदं भूषणभूषणाङ्गम्॥ ३/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.014.m4a", "display_order": 15}, {"id": 6000032015, "chapter_id": 10032, "verse_number": "३-२-१३", "content_sanskrit": "यद्धर्मसूनोर्बत राजसूये निरीक्ष्य दृक्स्वस्त्ययनं त्रिलोकः।\nकार्त्स्न्येन चात्रोपगतं विधातुरर्वाक् सृतौ कौशलमित्यमन्यत॥ ३/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.015.m4a", "display_order": 16, "topics": [{"text": "कृष्णस्य चरित्राणि स्मृत्वा तस्य बाल्यचरित्रकथनम्", "range": "१३–३४"}]}, {"id": 6000032016, "chapter_id": 10032, "verse_number": "३-२-१४", "content_sanskrit": "यस्यानुरागप्लुतहासरासलीलावलोकप्रतिलब्धमानाः।\nव्रजस्‍त्रियो दृग्भिरनुप्रवृत्तधियोऽवतस्थुः किल कृत्यशेषाः॥ ३/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.016.m4a", "display_order": 17}, {"id": 6000032017, "chapter_id": 10032, "verse_number": "३-२-१५", "content_sanskrit": "स्वशान्तरूपेष्वितरैश्च रूपैरभ्यर्द्यमानेष्वनुकम्पितात्मा।\nपरावरेशो महदंशयुक्तो ह्यजोऽपि जातो भगवान् यथाऽग्निः॥ ३/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.017.m4a", "display_order": 18}, {"id": 6000032018, "chapter_id": 10032, "verse_number": "३-२-१६", "content_sanskrit": "मां खेदयत्येतदजस्य जन्मविडम्बनं यद्वसुदेवगेहे।\nव्रजे च वासोऽरिभयादिव स्वयं पुराद् व्यवात्सीद् यदनन्तवीर्यः॥ ३/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.018.m4a", "display_order": 19}, {"id": 6000032019, "chapter_id": 10032, "verse_number": "३-२-१७", "content_sanskrit": "दुनोति चेतः स्मरतो ममैतद् यदाह पादावभिवन्द्य पित्रोः।\nताताम्ब कंसादुरुकम्पितानां प्रसीदतं नोऽकृतनिष्कृतीनाम्॥ ३/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.019.m4a", "display_order": 20}, {"id": 6000032020, "chapter_id": 10032, "verse_number": "३-२-१८", "content_sanskrit": "को वा अमुष्याङ्घ्रिसरोजरेणुं विस्मर्तुमीशेत पुमान् विजिघ्रन्।\nयो विस्फुरद्भ्रूविटपेन भूमेर्भारं कृतान्तेन तिरश्चकार॥ ३/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.020.m4a", "display_order": 21}, {"id": 6000032021, "chapter_id": 10032, "verse_number": "३-२-१९", "content_sanskrit": "दृष्टा भवद्भिर्ननु राजसूये चैद्यस्य कृष्णं द्विषतोऽपि सिद्धिः।\nयां योगिनः संस्पृहयन्ति सम्यग्योगेन कस्तद्विरहं सहेत॥ ३/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.021.m4a", "display_order": 22}, {"id": 6000032022, "chapter_id": 10032, "verse_number": "३-२-२०", "content_sanskrit": "तथैव चान्ये नरलोकवीरा य आहवे कृष्णमुखारविन्दम्।\nनेत्रैः पिबन्तो नयनाभिरामं पार्थास्‍त्रपूताः पदमापुरस्य॥ ३/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.022.m4a", "display_order": 23}, {"id": 6000032023, "chapter_id": 10032, "verse_number": "३-२-२१", "content_sanskrit": "स्वयं त्वसाम्यातिशयस्‍त्र्यधीशः स्वाराज्यलक्ष्म्याप्तसमस्तकामः।\nबलिं हरद्भिः सुरलोकपालैः किरीटकोट्येडितपादपीठः॥ ३/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.023.m4a", "display_order": 24}, {"id": 6000032024, "chapter_id": 10032, "verse_number": "३-२-२२", "content_sanskrit": "तत्तस्य कैङ्कर्यमलं भृतान्नो विग्लापयत्यङ्ग यदुग्रसेनम्।\nतिष्ठन् निषण्णं परमेष्ठिधिष्ण्ये न्यबोधयद् देव निधारयेति॥ ३/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.024.m4a", "display_order": 25}, {"id": 6000032025, "chapter_id": 10032, "verse_number": "३-२-२३", "content_sanskrit": "अहो बकीयं स्तनकालकूटं जिघांसया पाययदप्यसाध्वी।\nलेभे गतिं धात्र्युचितां ततोऽन्यं कं वा दयालुं शरणं व्रजेम॥ ३/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.025.m4a", "display_order": 26}, {"id": 6000032026, "chapter_id": 10032, "verse_number": "३-२-२४", "content_sanskrit": "मन्येऽसुरान् भागवतांस्‍त्र्यधीशे संरम्भमार्गाभिनिविष्टचित्तान्।\nये संयुगेऽचक्षत तार्क्ष्यपुत्रस्यांसे सुनाभायुधमापतन्तम्॥ ३/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.026.m4a", "display_order": 27}, {"id": 6000032027, "chapter_id": 10032, "verse_number": "३-२-२५", "content_sanskrit": "वसुदेवस्य देवक्यां जातो भोजेन्द्रबन्धने।\nचिकीर्षुर्भगवांच्छर्म अब्जजेनाभियाचितः॥ ३/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.027.m4a", "display_order": 28}, {"id": 6000032028, "chapter_id": 10032, "verse_number": "३-२-२६", "content_sanskrit": "ततो नन्दव्रजमितः पित्रा कंसाद् विबिभ्यता।\nएकादशसमास्तत्र गूढार्चिः सबलोऽवसत्॥ ३/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.028.m4a", "display_order": 29}, {"id": 6000032029, "chapter_id": 10032, "verse_number": "३-२-२७", "content_sanskrit": "परीतो वत्सपैर्वत्सांश्चारयन् व्यचरद्धरिः।\nयमुनोपवने कूजद्द्विजसंकुलिताङ्घ्रिपे॥ ३/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.029.m4a", "display_order": 30}, {"id": 6000032030, "chapter_id": 10032, "verse_number": "३-२-२८", "content_sanskrit": "कौमारा दर्शयंश्चेष्टाः प्रेक्षणीया व्रजौकसाम्।\nरुदन्निव हसन् मुग्धो बालसिंहावलोकनः॥ ३/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.030.m4a", "display_order": 31}, {"id": 6000032031, "chapter_id": 10032, "verse_number": "३-२-२९", "content_sanskrit": "स एव गोकुलं लक्ष्म्या निकेतं सितगोवृषम्।\nचारयन्ननुगान् गोपान् रणद्वेणुररीरमत्॥ ३/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.031.m4a", "display_order": 32}, {"id": 6000032032, "chapter_id": 10032, "verse_number": "३-२-३०", "content_sanskrit": "प्रयुक्तान् भोजराजेन मायिनः कामरूपिणः।\nलीलया व्यनुदत् तांस्तान् बालः क्रीडनकानिव॥ ३/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.032.m4a", "display_order": 33}, {"id": 6000032033, "chapter_id": 10032, "verse_number": "३-२-३१", "content_sanskrit": "विपन्नान् विषपानेन निगृह्य भुजगाधिपम्।\nउत्थाप्यापाययद् गावस्तत्तोयं प्रकृतिस्थितम्॥ ३/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.033.m4a", "display_order": 34}, {"id": 6000032034, "chapter_id": 10032, "verse_number": "३-२-३२", "content_sanskrit": "अयाजयद् गोसवेन गोपराजं द्विजोत्तमैः।\nवित्तस्य चोरुभारस्य चिकीर्षन् सद्व्ययं विभुः॥ ३/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.034.m4a", "display_order": 35}, {"id": 6000032035, "chapter_id": 10032, "verse_number": "३-२-३३", "content_sanskrit": "वर्षतीन्द्रे व्रजः कोपाद् भग्नमानेऽतिविह्वले।\nगोत्रलीलातपत्रेण त्रातो भद्रानुगृह्णता॥ ३/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.035.m4a", "display_order": 36}, {"id": 6000032036, "chapter_id": 10032, "verse_number": "३-२-३४", "content_sanskrit": "शरच्छशिकरैर्मृष्टं मानयन् रजनीमुखम्।\nगायन् कलपदं रेमे स्‍त्रीणां मण्डलमण्डनः॥ ३/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_002/BhP_03.002.036.m4a", "display_order": 37}, {"id": 6000032037, "chapter_id": 10032, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]