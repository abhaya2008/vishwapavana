[{"id": 2127351, "chapter_id": 3733, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2127352, "chapter_id": 3733, "verse_number": "१", "content_sanskrit": "भगवन् काम्यकात् पार्थे गते मे प्रपितामहे ।\nकिमकुर्वन्त पार्थास्ते तमृते सव्यसाचिनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2127353, "chapter_id": 3733, "verse_number": "२", "content_sanskrit": "स हि तेषां महेष्वासो धृतिरासीदनीकजित् ।\nआदित्यानां यथा विष्णुस्तथैव प्रतिभाति मे \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2127354, "chapter_id": 3733, "verse_number": "३", "content_sanskrit": "तेनेन्द्रसमवीर्येण सङ्ग्रामेष्वनिवर्तिना ।\nविनाभूताः कथं पार्थाः कथमासन् पितामहाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2127355, "chapter_id": 3733, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2127356, "chapter_id": 3733, "verse_number": "४", "content_sanskrit": "गते तु काम्यकात् तात पाण्डवे सव्यसाचिनि ।\nबभूवुः कौरवेयास्ते दुःखशोकपरायणाः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2127357, "chapter_id": 3733, "verse_number": "५", "content_sanskrit": "आक्षिप्तसूत्रा मणयः छिन्नपक्षा इवाण्डजाः ।\nअप्रीतमनसः सर्वे बभूवुस्तत्र पाण्डवाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2127358, "chapter_id": 3733, "verse_number": "६", "content_sanskrit": "वनं च तदभूत् तेन हीनमक्लिष्टकर्मणा ।\nकुबेरेण यथा हीनं वनं चैत्ररथं तथा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2127359, "chapter_id": 3733, "verse_number": "७", "content_sanskrit": "तमृते ते नरव्याघ्राः पाण्डवा जनमेजय ।\nमुदमप्राप्नुवन्तस्ते काम्यके न्यवसंस्तदा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2127360, "chapter_id": 3733, "verse_number": "८", "content_sanskrit": "ब्राह्मणार्थे पराक्रान्ताः शुद्धैर्बाणैर्महारथाः ।\nनिघ्नन्तो भरतश्रेष्ठा मेध्यान् बहुविधान् मृगान् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2127361, "chapter_id": 3733, "verse_number": "९", "content_sanskrit": "नित्यं हि पुरुषव्याघ्रा वन्याहारमरिन्दमाः ।\nविनिहत्य समाहृत्य ब्राह्णणेभ्यो न्यवेदयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2127362, "chapter_id": 3733, "verse_number": "१०", "content_sanskrit": "एवं ते न्यवसंस्तत्र सोत्कण्ठाः पुरुषर्षभाः ।\nविषण्णवदनास्तत्र गते राजन् धनञ्जये\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2127363, "chapter_id": 3733, "verse_number": "११", "content_sanskrit": "अथैनं प्रोषितं वीरं पाञ्चाली मध्यमं पतिम् ।\nस्मरन्ती पाण्डवश्रेष्ठमिदं वचनमब्रवीत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2127364, "chapter_id": 3733, "verse_number": "१२", "content_sanskrit": "योऽर्जुनेनार्जुनस्तुल्यो द्विबाहुर्बहुबाहुना ।\nतमृते पाण्डवश्रेष्ठं वनं न प्रतिभाति मे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2127365, "chapter_id": 3733, "verse_number": "१३", "content_sanskrit": "शून्यामिव प्रपश्यामि तत्र तत्र महीमिमाम् ।\nबह्वाश्चर्यमिदं चापि वनं कुसुमितद्रुमम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2127366, "chapter_id": 3733, "verse_number": "१४", "content_sanskrit": "न तथा रमणीयं वै तमृते सव्यसाचिनम् ।\nनीलाम्बुदसमप्रख्यं मत्तमातङ्गविक्रमम् ।\nतमृते पुण्डरीकाक्षं काम्यकं नातिभाति मे \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2127367, "chapter_id": 3733, "verse_number": "१५", "content_sanskrit": "यस्य वा धनुषो घोषः श्रूयते चाशनिस्वनः ।\nन लभे शर्म तं राजन् स्मरन्ती सव्यसाचिनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2127368, "chapter_id": 3733, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2127369, "chapter_id": 3733, "verse_number": "१६", "content_sanskrit": "तथा लालप्यमानां तां निशाम्य परवीरहा ।\nभीमसेनो महाराज द्रौपदीमिदमब्रवीत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2127370, "chapter_id": 3733, "verse_number": "१७", "content_sanskrit": "मम प्रीतिकरं मन्ये यद् ब्रवीषि सुमध्यमे ।\nतन्मे प्रीणाति हृदयममृतप्राशनोपमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2127371, "chapter_id": 3733, "verse_number": "१८", "content_sanskrit": "यस्य दीर्घो समौ पीनौ भुजौ परिघसन्निभौ ।\nमौर्वीकृतकिणौ वृत्तौ खड्गायुधगदाधरौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2127372, "chapter_id": 3733, "verse_number": "१९", "content_sanskrit": "निष्काङ्गदकृतापीडौ पञ्चशीर्षाविवोरगौ ।\nतमृते पुरुषव्याघ्रं नष्टसूर्यनिभं वनम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2127373, "chapter_id": 3733, "verse_number": "२०", "content_sanskrit": "यमाश्रित्य महाबाहुं पाञ्चालाः कुरवस्तथा ।\nशूराणामपि यत्तानां पृतनासु न बिभ्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2127374, "chapter_id": 3733, "verse_number": "२१", "content_sanskrit": "यस्य बाहू समाश्रित्य वयं सर्वे महात्मनः ।\nमन्यामहे जितानाजौ परान् प्राप्तं च मेदिनीम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2127375, "chapter_id": 3733, "verse_number": "२२", "content_sanskrit": "तमृते फल्गुनं वीरं न लभे काम्यके रतिम् ।\nशून्यामिव च पश्यामि तत्र तत्र महीमिमाम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2127376, "chapter_id": 3733, "verse_number": "२३", "content_sanskrit": "ततोऽब्रवीत् साश्रुकण्ठो नकुलः पाण्डुनन्दनः ।\nय उदीचीं दिशं गत्वा युधि जित्वा महाबलान् ।\nगन्धर्वमुख्यान् शतशो हयाँल्लेभे स वासविः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2127377, "chapter_id": 3733, "verse_number": "२४", "content_sanskrit": "राज्ञो तित्तिरिकल्माषान् श्रीमतेऽनिलरंहसः ।\nप्रादाद् भ्रात्रे प्रियः प्रेम्णा राजसूये महाक्रतौ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2127378, "chapter_id": 3733, "verse_number": "२५", "content_sanskrit": "तमृते भीमधन्वानं भीमादवरजं वने ।\nकामये काम्यके वासं नेदानीममरोपम \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2127379, "chapter_id": 3733, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2127380, "chapter_id": 3733, "verse_number": "२६", "content_sanskrit": "यो धनानि च कन्याश्च युधि जित्वा महारथान् ।\nशतशो घातयित्वाऽरीन् पृतनामध्यगस्तदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2127381, "chapter_id": 3733, "verse_number": "२७", "content_sanskrit": "यः समेतान् मृधे जित्वा यादवानमितद्युतिः ।\nएकः सुभद्रामाजह्रे वासुदेवस्य सम्मते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2127382, "chapter_id": 3733, "verse_number": "२८", "content_sanskrit": "येनार्धराज्यमाहृत्य द्रुपदस्य महात्मनः ।\nआचार्यदक्षिणा दत्ता गुरोर्द्रोणस्य भारत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2127383, "chapter_id": 3733, "verse_number": "२९", "content_sanskrit": "तस्य जिष्णोर्बृसीं दृष्ट्वा शून्यामुपनिवेशने ।\nहृदयं मे महाराज न शाम्यति कदाचन\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2127384, "chapter_id": 3733, "verse_number": "३०", "content_sanskrit": "वनादस्माद् विवासं तु रोच्यतेऽहमरिन्दम ।\nन हि नस्तमृते वीरं रमणीयमिदं वनम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2127385, "chapter_id": 3733, "verse_number": "३१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि पञ्चसप्ततितमोऽध्यायः ॥७५॥\n॥ तीर्थयात्रापर्वणि एकत्रिंशोऽध्यायः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]