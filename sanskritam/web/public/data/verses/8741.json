[{"id": 900009263, "chapter_id": 8741, "verse_number": "31.1", "content_sanskrit": "अथोपाधिज्ञानस्य व्याप्तिज्ञानप्रतिबन्धकत्वादुपाधिर्निरूप्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009264, "chapter_id": 8741, "verse_number": "31.2", "content_sanskrit": "उदयनादयस्तु साध्यसमव्याप्तत्वे सति साधनाव्यापक उपाधिरित्याहुस्तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009265, "chapter_id": 8741, "verse_number": "31.3", "content_sanskrit": "मणौ तु– पर्यवसितसाध्यव्यापकत्वे सति साधनाव्यापक उपाधिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009266, "chapter_id": 8741, "verse_number": "31.4", "content_sanskrit": "उपाधिश्चानुमानप्रवृत्तेः प्राग्व्याप्तिग्रहवेलायामव्याप्तेरेवोन्नायकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009267, "chapter_id": 8741, "verse_number": "31.5", "content_sanskrit": "अथानुमितिकरणं ज्ञानमुच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009268, "chapter_id": 8741, "verse_number": "31.6", "content_sanskrit": "प्राभाकरास्तु– धूमो वह्निव्याप्य इति स्मृतिः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009269, "chapter_id": 8741, "verse_number": "31.7", "content_sanskrit": "मणौ त्वयमालोको धूमो वा उभयथापि वह्निव्याप्य इति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009270, "chapter_id": 8741, "verse_number": "31.8", "content_sanskrit": "ननु– हेतुसमानाधिकरणात्यन्ताभावाप्रतियोगिसाध्यसामा-नाधिकरण्यं व्याप्यत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009271, "chapter_id": 8741, "verse_number": "31.9", "content_sanskrit": "लिङ्गज्ञानमेव करणम् । न तु लिङ्गम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009272, "chapter_id": 8741, "verse_number": "31.10", "content_sanskrit": "अनुमानं द्विविधं साधनानुमानं दूषणानुमानं चेति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009273, "chapter_id": 8741, "verse_number": "31.11", "content_sanskrit": "तर्कस्योपयोगस्त्वित्थम्– तर्कनिवर्त्याऽप्रयोजकत्वशङ्का हि द्वेधा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009274, "chapter_id": 8741, "verse_number": "31.12", "content_sanskrit": "किञ्च परमते तर्कस्य किं विषयविशोधन उपयोगः किं वा व्याप्तिग्रहे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009275, "chapter_id": 8741, "verse_number": "31.13", "content_sanskrit": "यच्च मणौ व्याप्तिर्द्वेधा अन्वयव्यतिरेकभेदात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009276, "chapter_id": 8741, "verse_number": "31.14", "content_sanskrit": "केवलव्यतिरेक्यनुमानं च न युक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009277, "chapter_id": 8741, "verse_number": "31.15", "content_sanskrit": "पुनरप्यनुमानं द्विविधम् । स्वार्थं परार्थं च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009278, "chapter_id": 8741, "verse_number": "31.16", "content_sanskrit": "अथानुमानदोष उच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]