[{"id": 2080809, "chapter_id": 2718, "verse_number": "१२-२२३-०x", "content_sanskrit": "`* युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080810, "chapter_id": 2718, "verse_number": "१२-२२३-१", "content_sanskrit": "किं कारणं महाप्राज्ञ दह्यमानश्च मैथिलः।\nमिथिलां नेह धर्मात्मा प्राह वीक्ष्य विदाहिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080811, "chapter_id": 2718, "verse_number": "१२-२२३-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080812, "chapter_id": 2718, "verse_number": "१२-२२३-२", "content_sanskrit": "श्रृयतां नृपशार्दूल यदर्थं दीपिता पुरा।\nवह्निना दीपिता सा तु तन्मे शृणु महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080813, "chapter_id": 2718, "verse_number": "१२-२२३-३", "content_sanskrit": "जनको जनदेवस्तु कर्माण्याध्याय चात्मनि।\nसर्वभावमनुप्राप्य भावेन विचचार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080814, "chapter_id": 2718, "verse_number": "१२-२२३-४", "content_sanskrit": "यजन्ददंस्तथा जुह्वन्पालयन्पृथिवीमिमाम्।\nअध्यात्मविन्महाप्राज्ञस्तन्मयत्वेन निष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080815, "chapter_id": 2718, "verse_number": "१२-२२३-५", "content_sanskrit": "स तस्य हृदि संकल्पं ज्ञातुमैच्छत्स्वयं प्रभुः।\nसर्वलोकाधिपस्तत्र द्विजरूपेण संयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080816, "chapter_id": 2718, "verse_number": "१२-२२३-६", "content_sanskrit": "मिथिलायां महाबुद्धिर्व्यलीकं किंचिदाचरन्।\nस गृहीत्वा द्विजश्रेष्ठैर्नृपाय प्रतिवेदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080817, "chapter_id": 2718, "verse_number": "१२-२२३-७", "content_sanskrit": "अपराधं समुद्दिश्य तं राजा प्रत्यभाषत।\nन त्वां ब्राह्मण दण्डेन नियोक्ष्यामि कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080818, "chapter_id": 2718, "verse_number": "१२-२२३-८", "content_sanskrit": "मम राज्याद्विनिर्गच्छ यावत्सीमा भुवो मम।\nतच्छ्रुत्वा ब्राह्मणो गत्वा राजानं प्रत्युवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080819, "chapter_id": 2718, "verse_number": "१२-२२३-९", "content_sanskrit": "करिष्ये वचनं राजन्ब्रवीहि मम जानतः।\nका सीमा तव भूमेस्तु ब्रूहि धर्मं ममाद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080820, "chapter_id": 2718, "verse_number": "१२-२२३-१०", "content_sanskrit": "तच्छ्रुत्वा मैथिलो राजा लज्जयावनताननः।\nनोवाच वचनं विप्रं तत्वबुद्ध्या समीक्ष्य तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080821, "chapter_id": 2718, "verse_number": "१२-२२३-११", "content_sanskrit": "पुनःपुनश्च तं विप्रश्चोदयामास सत्वरम्।\nब्रूहि राजेन्द्र गच्छामि तव राज्या द्विवासितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080822, "chapter_id": 2718, "verse_number": "१२-२२३-१२", "content_sanskrit": "ततो नृपो विचार्यैवमाह ब्राह्मणपुङ्गवम्।\nआवासो वा न मेऽस्त्यत्र सर्वा वा पृथिवी मम।\nगच्छ वा तिष्ठ वा ब्रह्मन्निति मे निश्चिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080823, "chapter_id": 2718, "verse_number": "१२-२२३-१३", "content_sanskrit": "इत्युक्तः स तथा तेन मैथिलेन द्विजोत्तमः।\nअब्रवीत्तं महात्मानं राजानं मन्त्रिभिर्वृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080824, "chapter_id": 2718, "verse_number": "१२-२२३-१४", "content_sanskrit": "त्वमेवं पद्मनाभस्य नित्यं पक्षपदाहितः।\nअहो सिद्धार्थरूपोऽसि गमिष्ये स्वस्ति तेऽस्तु वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080825, "chapter_id": 2718, "verse_number": "१२-२२३-१५", "content_sanskrit": "इत्युक्त्वा प्रययौ विप्रस्तज्जिज्ञासुर्द्विजोत्तमान्।\nअदहच्चाग्निना तस्य मिथिलां भगवान्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080826, "chapter_id": 2718, "verse_number": "१२-२२३-१६", "content_sanskrit": "प्रदीप्यमानां मिथिलां दृष्ट्वा राजा न कम्पितः।\nजनैः स परिपृष्टस्तु वाक्यमेतदुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080827, "chapter_id": 2718, "verse_number": "१२-२२३-१७", "content_sanskrit": "अनन्तं वत मे वित्तं भाव्यं मे नास्ति किंचन।\nमिथिलायां प्रदीप्तायां न मे किंचन दह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080828, "chapter_id": 2718, "verse_number": "१२-२२३-१८", "content_sanskrit": "तदस्य भाषमाणस्य श्रुत्वा श्रुत्वा हृदि स्थितम्।\nपुनः संजीवयामास मिथिलां तां द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080829, "chapter_id": 2718, "verse_number": "१२-२२३-१९", "content_sanskrit": "आत्मानं दर्शयामास वरं चास्नै दद्रौ पुनः।\nधर्मे तिष्ठस्व सद्भावो बुद्धिस्तेऽर्थे नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080830, "chapter_id": 2718, "verse_number": "१२-२२३-२०", "content_sanskrit": "सत्ये तिष्ठस्व निर्विण्णः स्वस्ति तेऽस्तु व्रजाम्यहम्।\nइत्युक्त्वा भगवांश्चैनं तत्रैवान्तरधीयत।\nएतत्ते कथितं राजन्किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080831, "chapter_id": 2718, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रयोविंशत्यधिकद्विशततमोऽध्यायः॥ २२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]