[{"id": 2121508, "chapter_id": 3604, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2121509, "chapter_id": 3604, "verse_number": "१", "content_sanskrit": "ततः कदाचिद् गोविन्दो ज्येष्ठं सङ्कर्षणं विना ।\nचचार तद्वनं रम्यं ससुरूपो वराननः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2121510, "chapter_id": 3604, "verse_number": "२", "content_sanskrit": "काकपक्षधरः श्रीमान् श्यामः पद्मनिभेक्षणः ।\nश्रीवत्सेनोरसा युक्तः शशाङ्क इव लक्ष्मणा \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2121511, "chapter_id": 3604, "verse_number": "३", "content_sanskrit": "रज्जुयज्ञोपवीती स पीताम्बरधरो युवा ।\nश्वेतचन्दनदिग्धाङ्गो नीलकुञ्चितमूर्धजः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2121512, "chapter_id": 3604, "verse_number": "४", "content_sanskrit": "राजता बर्हिपत्रेण मन्दमारुतकम्पिना ।\nक्वचिद्गायन् क्वचित् क्रीडन् क्वचिन्नृत्यन् क्वचिद्धसन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2121513, "chapter_id": 3604, "verse_number": "५", "content_sanskrit": "गोपवेषः सुमधुरं गायन् वेणुं च वादयन् ।\nप्रह्लादनार्थं च गवां क्वचिद् वनगतो युवा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2121514, "chapter_id": 3604, "verse_number": "६", "content_sanskrit": "गोकुले मेघकाले तु चचार द्युतिमान् प्रभुः ।\nबहुरम्येषु देशेषु वनस्य वनराजिषु\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2121515, "chapter_id": 3604, "verse_number": "७", "content_sanskrit": "तासु कृष्णो मुदायुक्तः क्रीडयन् भरतर्षभ ।\nस कदाचिद् वने तस्मिन् गोभिः सह परिव्रजन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2121516, "chapter_id": 3604, "verse_number": "८", "content_sanskrit": "भाण्डीरं नाम दृष्ट्वाऽथ न्यग्रोधं केशवो महान् ।\nतच्छायायां निवासाय मतिं चक्रे तदा प्रभुः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2121517, "chapter_id": 3604, "verse_number": "९", "content_sanskrit": "स तत्र वयसा तुल्यैर्वत्सपालैस्तदाऽनघ ।\nरेमे स दिवसान् कृष्णः पुरा स्वर्गपुरे यथा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2121518, "chapter_id": 3604, "verse_number": "१०", "content_sanskrit": "तं क्रीडमानं गोपालाः कृष्णं भाण्डीरवासिनः ।\nरमयन्ति स्म बहवो मान्यैः क्रीडनकैस्तदा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2121519, "chapter_id": 3604, "verse_number": "११", "content_sanskrit": "अन्ये स्म परिगायन्ति गोपा मुदितमानसाः ।\nगोपालाः कृष्णमेवान्ये गायन्ति स्म वनप्रियाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2121520, "chapter_id": 3604, "verse_number": "१२", "content_sanskrit": "तेषां सङ्गायतामेव वादयामास केशवः ।\nपुनर्वाद्यान्तरे वेणुं तुम्बवीणां च तत्र वै ।\nएवं क्रीडान्तनिरतैर्गोपालैर्विजहार सः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2121521, "chapter_id": 3604, "verse_number": "१३", "content_sanskrit": "तेन बालेन कौन्तेय कृतं लोकहितं तदा ।\nपश्यतां सर्वभूतानां वासुदेवेन भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2121522, "chapter_id": 3604, "verse_number": "१४", "content_sanskrit": "ह्रदे नीपवने तात क्रीडितं नागमूर्धनि ।\nशासयित्वा तु कालीयं सर्वलोकस्य पश्यतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2121523, "chapter_id": 3604, "verse_number": "१५", "content_sanskrit": "विजहार ततः कृष्णो बलदेवसहायवान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2121524, "chapter_id": 3604, "verse_number": "१६", "content_sanskrit": "धेनुको दारुणो दैत्यो राजन् रासभविग्रहः ।\nतदा ताळवने राजन् बलदेवेन वै हतः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2121525, "chapter_id": 3604, "verse_number": "१७", "content_sanskrit": "ततः कृष्णो महातेजास्तदा गत्वा तु गोव्रजम् ।\nगिरियज्ञं तमेवैष प्रकृतं गोपदारकैः ।\nबुभुजे पायसं शौरिरीश्वरः सर्वभूतकृत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2121526, "chapter_id": 3604, "verse_number": "१८", "content_sanskrit": "तं नत्वा गोपकाः सर्वे कृष्णमेव समर्चयन् ।\nपूज्यमानस्ततो गोपैर्दिव्यं वपुरधारयत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2121527, "chapter_id": 3604, "verse_number": "१९", "content_sanskrit": "धृतो गोवर्धनो नाम सप्ताहं वर्षतो महान् ।\nशिशुना वासुदेवेन गवार्थमरिमर्दन \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2121528, "chapter_id": 3604, "verse_number": "२०", "content_sanskrit": "क्रीडमानस्तदा कृष्णः कृतवान् कर्म दुष्करम् ।\nतदद्भुतमिवात्रासीत् सर्वलोकस्य भारत ।\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2121529, "chapter_id": 3604, "verse_number": "२१", "content_sanskrit": "देवदेवः क्षितिं गत्वा कृष्णं दृष्ट्वा मुदाऽन्वितः ।\nगोविन्द इति तं ह्युक्त्वा अभिषिञ्चत् पुरन्दरः ।\nइत्युक्त्वाऽऽश्लिष्य गोविन्दं पुरुहूतोऽभ्ययाद्दिवम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2121530, "chapter_id": 3604, "verse_number": "२२", "content_sanskrit": "अथारिष्ट इति ख्यातं दैत्यं वृषभविग्रहम् ।\nजघान तरसा कृष्णः पशूनां हितकाम्यया \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2121531, "chapter_id": 3604, "verse_number": "२३", "content_sanskrit": "केशिं नाम ततो राजन् दैतेयं हयविग्रहम् ।\nतथा वनगतं पार्थ गजायुतबलं हयम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2121532, "chapter_id": 3604, "verse_number": "२४", "content_sanskrit": "प्रहितं भोजपुत्रेण जघान मधुसूदनः ।\nकंसमल्लं च चाणूरं निजघान महासुरम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2121533, "chapter_id": 3604, "verse_number": "२५", "content_sanskrit": "सुदामानममित्रघ्नं सर्वसैन्यपुरस्कृतम् ।\nमृगरूपेण गोविन्दस्त्रासयामास भारत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2121534, "chapter_id": 3604, "verse_number": "२६", "content_sanskrit": "बलदेवेन चायत्तः समाजे मुष्टिको हतः ।\nत्रासितश्च तदा कंसः स हि कृष्णेन भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2121535, "chapter_id": 3604, "verse_number": "२७", "content_sanskrit": "ऐरावतं युयुत्सन्तं मातङ्गानामिवर्षभम् ।\nकृष्णः कुवलयापीडं हतवांस्तस्य पश्यतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2121536, "chapter_id": 3604, "verse_number": "२८", "content_sanskrit": "हत्वा कंसममित्रघ्नः सर्वेषां पश्यतां तदा ।\nअभिषिच्योग्रसेनं तं पित्रोः पादानवन्दत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2121537, "chapter_id": 3604, "verse_number": "२९", "content_sanskrit": "एवमादीनि कर्माणि कृतवान् वै जनार्दनः ।\nउवास कतिचित् तत्र दिनानि सहलायुधः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2121538, "chapter_id": 3604, "verse_number": "१५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि षट्चत्वारिंशोऽध्यायः ॥\n॥ अर्घाभिहरणपर्वणि पञ्चदशोऽध्यायः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2121539, "chapter_id": 3604, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]