[{"id": 7003191000, "chapter_id": 23191, "verse_number": "४-१२७-१", "content_sanskrit": "अथ सप्तविंशत्यधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nश्रीकृष्णवचनं श्रुत्वा प्रहृष्टा गोपिका मुदा ।\nमन्दिरं प्रययुः सर्वाः प्रणम्य राधिकां प्रभुम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003191001, "chapter_id": 23191, "verse_number": "४-१२७-२", "content_sanskrit": "राधाशृङ्गारभावं च कलाषोडशपूर्वकम् ।\nचकार सस्मिता साध्वी वक्रचञ्चललोचना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003191002, "chapter_id": 23191, "verse_number": "४-१२७-३", "content_sanskrit": "दत्त्वा च चन्दनं माल्यं स्वामिने पुनरेव च ।\nरहस्यं च परीहास्यं पुनरेव चकार सः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003191003, "chapter_id": 23191, "verse_number": "४-१२७-४", "content_sanskrit": "आकृष्य राधिकां कृष्णः समानीय स्ववक्षसि ।\nओष्ठाधरं कपोलं च गण्डयुग्मं चुचुम्ब च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003191004, "chapter_id": 23191, "verse_number": "४-१२७-५", "content_sanskrit": "राधा चुचुम्ब कृष्णस्य मुखचन्द्रं मनोहरम् ।\nचकार कृष्णं प्राणेशं बाहुभ्यां च स्ववक्षसि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003191005, "chapter_id": 23191, "verse_number": "४-१२७-६", "content_sanskrit": "शृङ्गारं षोडशविर्धं कामशास्त्रोक्तमीप्सितम् ।\nस्त्रीपुंसोस्तोषजनकं चकार भगवान्प्रभुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003191006, "chapter_id": 23191, "verse_number": "४-१२७-७", "content_sanskrit": "नखविक्षतसर्वाङ्गा दशनेनाधरक्षता ।\nपुलकाञ्चितदेहा स तन्द्रिता वामनस्तनी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003191007, "chapter_id": 23191, "verse_number": "४-१२७-८", "content_sanskrit": "मीर्च्छिता सुखसंभोगाद्विलग्ना हतचेतना ।\nश्वासमात्रावशेषा च निद्रामुद्रितलोचना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003191008, "chapter_id": 23191, "verse_number": "४-१२७-९", "content_sanskrit": "रतिशूरा कोमलाङ्गी कान्तावक्षः स्यलस्थिता ।\nशीते सुखोष्णसर्वाङ्गी ग्रीष्मे सा सुखशीतला ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003191009, "chapter_id": 23191, "verse_number": "४-१२७-१०", "content_sanskrit": "शृङ्गारकाले सुखदा सान्द्रश्रोणिपयोधरा ।\nनितम्बभारानम्रा च प्रसङ्गे सुखदायिका ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003191010, "chapter_id": 23191, "verse_number": "४-१२७-११", "content_sanskrit": "विदग्धा रसिका श्रेष्ठा कामुकी च वराङ्गना ।\nसहसा चेतनं प्राप्य शुश्राव कोकिलध्वनिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003191011, "chapter_id": 23191, "verse_number": "४-१२७-१२", "content_sanskrit": "श्रुत्वा परमभीता सा दीना दीनविशङ्कया ।\nउवाच परमा सा च परमेशं परात्परम् ।\nबाहुश्रोणियुगाम्यां च निबध्य च पुनः पुनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003191012, "chapter_id": 23191, "verse_number": "४-१२७-१३", "content_sanskrit": "राधिकोवाच ।\nरासं गच्छ महाभाग पुण्यं वृन्दावनं वनम् ।\nतत्र क्रीडां करिष्यामि जलेन च स्थलेन च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003191013, "chapter_id": 23191, "verse_number": "४-१२७-१४", "content_sanskrit": "पुनर्यास्यामि मलयं सुन्दरं मणिमन्दिरम् ।\nअपरं यद्रहस्यं वा जन्मला न श्रुतं मया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003191014, "chapter_id": 23191, "verse_number": "४-१२७-१५", "content_sanskrit": "तत्र यामि त्वया सार्धमिति मे लालसा परा ।\nपरस्परैकालापेन प्रययौ रजनी शुभा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003191015, "chapter_id": 23191, "verse_number": "४-१२७-१६", "content_sanskrit": "अरुणोदयकालेऽपि न त्यजेन्माधवं सती ।\nमाधवः प्रीतिवचसा बोधयामास साघनात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003191016, "chapter_id": 23191, "verse_number": "४-१२७-१७", "content_sanskrit": "प्रातः कृत्यं ततः कृत्वा स्वारुरोह रथं हरिः ।\nगोपीभी राधया सार्धं शरत्कमललोचनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003191017, "chapter_id": 23191, "verse_number": "४-१२७-१८", "content_sanskrit": "योजनायतविस्तीर्ण गृहेस्त्रिशतकोटिभिः ।\nमणीन्द्रसारनिर्माणैर्ज्वलद्भिरुपशोभितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003191018, "chapter_id": 23191, "verse_number": "४-१२७-१९", "content_sanskrit": "गोलोकादागतं तत्र मनोयायि मनोहरम् ।\nसहस्रचक्रसंयुक्तं महस्राश्वैः प्रचालितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003191019, "chapter_id": 23191, "verse_number": "४-१२७-२०", "content_sanskrit": "मणिस्तम्भैश्त्रिकोटीभी रत्नराजिविराजितम् ।\nमुक्तामाणिक्यपरमैर्हीरहारैः सुशोभितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003191020, "chapter_id": 23191, "verse_number": "४-१२७-२१", "content_sanskrit": "नानाचित्रैर्विचित्रैश्च श्वेतचामरदर्पणैः ।\nवह्निशुद्धांशुकैर्दीप्तैर्मालाजालैर्विभूषितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003191021, "chapter_id": 23191, "verse_number": "४-१२७-२२", "content_sanskrit": "रत्निर्माणतल्पैश्च पुष्पचन्दनचर्चितम् ।\nसमानरूपवेषैश्च गोपीलक्षैः समावृतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003191022, "chapter_id": 23191, "verse_number": "४-१२७-२३", "content_sanskrit": "रथेन तेन भगवान्पुनर्वृन्दावनं ययौ ।\nतत्र गत्वा निशाकाले विजहार जले स्थले ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003191023, "chapter_id": 23191, "verse_number": "४-१२७-२४", "content_sanskrit": "शृङ्गारं सुचिरं कृत्वा वनेषूपवनेषु च ।\nराधिकां दर्शयामास यथासर्व च नूतनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003191024, "chapter_id": 23191, "verse_number": "४-१२७-२५", "content_sanskrit": "विस्पन्दके सुरसने माहेन्द्रे नन्दने वने ।\nसुमेरुशिखरे रम्ये पर्वते गन्धमादने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003191025, "chapter_id": 23191, "verse_number": "४-१२७-२६", "content_sanskrit": "शैले शैले सुन्दरे च कन्दरे कन्दरे वने ।\nपुष्पोद्याने सुरहसि नद्यां नद्यां नदे नदे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003191026, "chapter_id": 23191, "verse_number": "४-१२७-२७", "content_sanskrit": "समुद्रपुलिने रम्ये पारिजातवने वने ।\nसुभद्रे पुष्पभद्रे च नारायणसरोवरे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003191027, "chapter_id": 23191, "verse_number": "४-१२७-२८", "content_sanskrit": "पवनस्यैव निलये मलये च सुरालये ।\nत्रिकूटे भद्रकूटे च पञ्चकूटे सुकूटके ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003191028, "chapter_id": 23191, "verse_number": "४-१२७-२९", "content_sanskrit": "देवानां कमनीयायां काञ्चन्यां च तथैव च ।\nसमुद्रे च समुद्रे च द्वीपे द्वीपे मनोहरे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003191029, "chapter_id": 23191, "verse_number": "४-१२७-३०", "content_sanskrit": "खर्वटे प्रवरे रम्ये पुण्यचन्द्रसरोवरे ।\nसुपार्श्वे मुनिपार्श्वे च स रेमे राधया सह ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003191030, "chapter_id": 23191, "verse_number": "४-१२७-३१", "content_sanskrit": "शीघ्रं च पुनरागत्य जम्बूद्वीपं च पुण्यदम् ।\nद्वारकां दर्शयामास पर्वतं रैवतं तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003191031, "chapter_id": 23191, "verse_number": "४-१२७-३२", "content_sanskrit": "गोकुलं पुनरागत्य गोपगोकुलसंकुलम् ।\nतत्र दृष्ट्वा च भाण्डीरं पुण्यं वृन्दावनं ययौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003191032, "chapter_id": 23191, "verse_number": "४-१२७-३३", "content_sanskrit": "श्रीकृण्णागमनं श्रुत्वा यशोदा नन्द एव च ।\nगोपा गोप्यश्च वृद्धाश्चाप्यश्रुनेत्रा निराकुलाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003191033, "chapter_id": 23191, "verse_number": "४-१२७-३४", "content_sanskrit": "वारणेन्द्रं पुरस्कृत्य वेश्यां च नटनर्तकाः ।\nपतिपुत्रवतीं साध्वीं ब्राह्मणीं ब्राह्मणं तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003191034, "chapter_id": 23191, "verse_number": "४-१२७-३५", "content_sanskrit": "यथा देवाश्च वह्निं च दृष्ट्वा नन्दं च मातरम् ।\nआययुर्बालकृष्णश्च राधया सह माधवः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003191035, "chapter_id": 23191, "verse_number": "४-१२७-३६", "content_sanskrit": "मातुः क्रोडमारुरोह प्रहस्य मधुसूदनः ।\nनन्दो यशोदया सार्ध चुचुम्ब मुखपङ्कजम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003191036, "chapter_id": 23191, "verse_number": "४-१२७-३७", "content_sanskrit": "आश्लिश्य भृशमुच्चैश्च सिषेच नेत्रजैर्जलैः ।\nस्वयं च भगवान्कृष्णो यशोदायाः स्तनं पपौ ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003191037, "chapter_id": 23191, "verse_number": "४-१२७-३८", "content_sanskrit": "तादृशं ददृशुः सर्वे यादृशो मथुरां ययौ ।\nमुरलीहस्तविन्यस्तं रत्नभूषणभूषितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003191038, "chapter_id": 23191, "verse_number": "४-१२७-३९", "content_sanskrit": "यथैकादशवर्षीयं शोभितं पीतवाससा ।\nमयूरपिच्छचूडं च मालतीमाल्यमण्डितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003191039, "chapter_id": 23191, "verse_number": "४-१२७-४०", "content_sanskrit": "मन्दिरं वेशयामास राधया सह माधवम् ।\nयशोदा मङ्गलं कृत्वा भोजयामास ब्राह्मणान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003191040, "chapter_id": 23191, "verse_number": "४-१२७-४१", "content_sanskrit": "पूजां चकार गोपीनां मुनीनां च यथा जनः ।\nमणिरत्नं प्रवालं च सुवर्ण परमं तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003191041, "chapter_id": 23191, "verse_number": "४-१२७-४२", "content_sanskrit": "भुक्तामाणिक्यहीरं च ब्राह्मणेभ्यो ददौ मुदा ।\nगजरत्नं गवां रत्नमश्वरत्नं मनोहरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003191042, "chapter_id": 23191, "verse_number": "४-१२७-४३", "content_sanskrit": "आसनानि च पात्राणि भूषणानि तथैव च ।\nधान्यान्यपि च सस्यानि वस्त्राणि च तथा ददौ ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003191043, "chapter_id": 23191, "verse_number": "४-१२७-४४", "content_sanskrit": "अपूर्व दर्शयामास राधया सह माधवम् ।\nगोपीगणं च मिष्टान्नं सादरेणापि नारद ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003191044, "chapter_id": 23191, "verse_number": "४-१२७-४५", "content_sanskrit": "दुन्दुभीन्वादयामास कारयामास मङ्गलम् ।\nदेवांश्च भोजयामास सानन्दं च मनोहरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]