[{"id": 7003697000, "chapter_id": 23697, "verse_number": "१-४-५-१", "content_sanskrit": "नंदिकेश्वर उवाच ।\nशुद्धसत्त्वगुणोपेतो लोकेऽस्मिन्दुर्लभः पुमान् ।\nरजस्तमोगुणोपेता भवंति सुलभा नराः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003697001, "chapter_id": 23697, "verse_number": "१-४-५-२", "content_sanskrit": "सात्त्विकः पुण्यशीलत्वान्निःश्रेयसमवाप्नुयात् ।\nवैचित्र्यात्कर्मणामेषामनुभोगाय वेधसा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003697002, "chapter_id": 23697, "verse_number": "१-४-५-३", "content_sanskrit": "वैचित्र्याण्येव सृष्टानि नरकाण्यत्र तत्र च ।\nमहारौरवभाग्भूत्वा खरः श्वा शूकरोऽपि वा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003697003, "chapter_id": 23697, "verse_number": "१-४-५-४", "content_sanskrit": "चंडालो वा भवेत्प्रेत्य पुरुषो ब्रह्महत्यया ।\nचिरं रौरवसंरुद्धः कृमिकीटपतंगताम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003697004, "chapter_id": 23697, "verse_number": "१-४-५-५", "content_sanskrit": "प्राप्नुयात्कर्मकर्तृत्वं सुरापानेन च द्विजः ।\nब्रह्मस्वहरणाद्ब्रह्मराक्षसत्वमवाप्नुयात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003697005, "chapter_id": 23697, "verse_number": "१-४-५-६", "content_sanskrit": "यद्यत्तु चोरयेत्तत्तच्छून्यं स्यादन्यजन्मनि ।\nअसिपत्रवने पीडामवाप्य सुचिरं पुनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003697006, "chapter_id": 23697, "verse_number": "१-४-५-७", "content_sanskrit": "नपुंसकत्वं संगच्छेत्पुरुषो गुरुतल्पगः ।\nतप्तैः कालायसैर्दंडैः पीडितो यमकिंकरैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003697007, "chapter_id": 23697, "verse_number": "१-४-५-८", "content_sanskrit": "नरके कालसूत्राख्ये निवसेत्परदारगः ।\nअग्निदो निवसेद्घोरे सुघोरे गरदायकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003697008, "chapter_id": 23697, "verse_number": "१-४-५-९", "content_sanskrit": "महाघोरे च पिशुनोऽवीच्यां धर्मविनिंदकः ।\nवसेत्कराले मित्रध्रुग्भीमे हिंसैकतत्परः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003697009, "chapter_id": 23697, "verse_number": "१-४-५-१०", "content_sanskrit": "संहारे छन्नपापिष्ठो मृषावादी भयानके ।\nअसिघोरे वसेद्वापि कूपक्षेत्रनरादिहृत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003697010, "chapter_id": 23697, "verse_number": "१-४-५-११", "content_sanskrit": "वज्रे परद्रोहरतो मांसाशी तरले द्विज ।\nतीक्ष्णे मातृपितृद्रोही तापने जपदूषकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003697011, "chapter_id": 23697, "verse_number": "१-४-५-१२", "content_sanskrit": "अश्वघ्नोपि निरुच्छ्वासे वसेद्गोघ्नश्च दारुणे ।\nभ्रूणहा निवसेच्चंडे स्त्रीहत्याकृत्कुकूलके ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003697012, "chapter_id": 23697, "verse_number": "१-४-५-१३", "content_sanskrit": "देवस्वहारी दहने घोरघोरे परस्वहृत् ।\nकृतांतदूता नरके सर्वानेव हि पापिनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003697013, "chapter_id": 23697, "verse_number": "१-४-५-१४", "content_sanskrit": "बध्नंति पाशैर्निघ्नंति दंडैर्विध्यंति शंकुभिः ।\nतीक्ष्णायश्चंचवः कंकाः क्रूरदंष्ट्रा महोरगाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003697014, "chapter_id": 23697, "verse_number": "१-४-५-१५", "content_sanskrit": "कालेयकाश्च व्याघ्राश्च हिंस्राश्चान्ये दशंत्यमून् ।\nशकलीकुर्वते शस्त्रैर्दहंतिदेहमेव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003697015, "chapter_id": 23697, "verse_number": "१-४-५-१६", "content_sanskrit": "खनंति गहने श्वभ्रे कशाभिस्ताडयंति च ।\nतैलद्रोण्यां विपच्यंते तुद्यंते सूक्ष्मसूचिभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003697016, "chapter_id": 23697, "verse_number": "१-४-५-१७", "content_sanskrit": "बाह्यन्ते दुर्वहान्भारान्यमदूतैर्हि पापिनः ।\nब्रह्महा क्षयरोगी स्यत्सुरापः श्यावदंतकः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003697017, "chapter_id": 23697, "verse_number": "१-४-५-१८", "content_sanskrit": "स्वर्णापहारी कुनखी दुश्चर्मा गुरुतल्पगः ।\nअपस्मारी गुरुद्रोही चंडालो वेददूषकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003697018, "chapter_id": 23697, "verse_number": "१-४-५-१९", "content_sanskrit": "कूटसाक्षी चाक्षिरोगी मंदाग्निश्चाग्रभोजनः ।\nविद्यापहारी मूकः स्यादंधः पुस्तकचोरकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003697019, "chapter_id": 23697, "verse_number": "१-४-५-२०", "content_sanskrit": "परदाररतः पंगु बधिरः परनिंदकः ।\nविड्वराहो निराचारो जिह्वारोगी च तस्करः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003697020, "chapter_id": 23697, "verse_number": "१-४-५-२१", "content_sanskrit": "अभ्यागतातिथित्यागी कपोलकंटको भवेत् ।\nपर्वसु स्त्रीरतो मेही पूत्यास्योऽभक्ष्यभक्षकः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003697021, "chapter_id": 23697, "verse_number": "१-४-५-२२", "content_sanskrit": "मर्यादाभेदको दासस्तटाकारामहृत्खरः ।\nप्रतिश्रुताप्रदाता स्यादल्पायुः श्वा विकत्थनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003697022, "chapter_id": 23697, "verse_number": "१-४-५-२३", "content_sanskrit": "विष्णुद्रोही च सरठः शिवद्रोही च मूषकः ।\nएवं पापफलं ज्ञात्वा प्रायश्चित्तं समाचरेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003697023, "chapter_id": 23697, "verse_number": "१-४-५-२४", "content_sanskrit": "तच्चास्मिन्नरुणक्षेत्रे कर्तव्यः सम्यगास्तिकैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003697024, "chapter_id": 23697, "verse_number": "१-४-५-२५", "content_sanskrit": "इति निशम्य स दुष्कृतकारिणां बहुविधां नरकेषु नृणां व्यथाम् ।\nचरणयोः पतितश्च तदा पुनःपुनरयाचत तच्छमनक्रियाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]