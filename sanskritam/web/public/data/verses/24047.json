[{"id": 7004047000, "chapter_id": 24047, "verse_number": "३-३-१८-१", "content_sanskrit": "सूत उवाच ।\nअथाहं संप्रवक्ष्यामि सर्वधर्मोत्तमोत्तमम् ।\nउमामहेश्वरं नाम व्रतं सर्वार्थसिद्धिदम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004047001, "chapter_id": 24047, "verse_number": "३-३-१८-२", "content_sanskrit": "आनर्त्त संभवः कश्चिन्नाम्ना वेदरथो द्विजः ।\nकलत्रपुत्रसंपन्नो विद्वानुत्तमवंशजः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004047002, "chapter_id": 24047, "verse_number": "३-३-१८-३", "content_sanskrit": "तस्यैवं वर्तमानस्य ब्राह्मणस्य गृहाश्रमे ।\nबभूव शारदानाम कन्या कमललोचना॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004047003, "chapter_id": 24047, "verse_number": "३-३-१८-४", "content_sanskrit": "तां रूपलक्षणोपेतां बालां द्वादशहायनाम् ।\nययाचे पद्मनाभाख्यो मृतदारश्च स द्विजः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004047004, "chapter_id": 24047, "verse_number": "३-३-१८-५", "content_sanskrit": "महाधनस्य शांतस्य सदा राजसखस्य च ।\nयाञ्चाभंगभयात्तस्य तां कन्यां प्रददौ पिता॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004047005, "chapter_id": 24047, "verse_number": "३-३-१८-६", "content_sanskrit": "मध्यंदिने कृतोद्वाहः स विप्रः श्वशुरालये ।\nसंध्यामुपासितुं सायं सरस्तटमुपाययौ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004047006, "chapter_id": 24047, "verse_number": "३-३-१८-७", "content_sanskrit": "उपास्य संध्यां विधिवत्प्रत्यागच्छत्तमोवृते ।\nमार्गे दष्टो भुजंगेन ममार निजकर्मणा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004047007, "chapter_id": 24047, "verse_number": "३-३-१८-८", "content_sanskrit": "तस्मिन्मृते कृतोद्वाहे सहसा तस्य बांधवाः ।\nचुक्रुशुः शोकसंतप्तौ श्वशुरावस्य कन्यका॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004047008, "chapter_id": 24047, "verse_number": "३-३-१८-९", "content_sanskrit": "निर्हृत्य तं बंधुजना जग्मुः स्वं स्वं निवेशनम् ।\nशारदा प्राप्तवैधव्या पितुरेवालये स्थिता॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004047009, "chapter_id": 24047, "verse_number": "३-३-१८-१०", "content_sanskrit": "भूताच्छादनभोज्येन भर्त्रा विरहिता सती ।\nनिनाय कतिचिन्मासान्सा बाला पितृमंदिरे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004047010, "chapter_id": 24047, "verse_number": "३-३-१८-११", "content_sanskrit": "एकदा नैध्रुवो नाम कश्चिद्वृद्धतरो मुनिः ।\nअन्धः शिष्यकरग्राही तन्मंदिरमुपाययौ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004047011, "chapter_id": 24047, "verse_number": "३-३-१८-१२", "content_sanskrit": "तस्मिन्वृद्धे गृहं प्राप्ते क्वापि यातेषु बंधुषु ।\nसाक्षादिवात्मनो दैवं सा बाला समुपागमत्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004047012, "chapter_id": 24047, "verse_number": "३-३-१८-१३", "content_sanskrit": "स्वागतं ते महाभाग पीठेस्मिन्नुपविश्यताम् ।\nनमस्ते मुनिनाथाय प्रियं ते करवाणि किम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004047013, "chapter_id": 24047, "verse_number": "३-३-१८-१४", "content_sanskrit": "इत्युक्त्वा भक्तिमास्थाय कृत्वा पादावनेजनम् ।\nवीजयित्वा परिश्रांतं तं मुनिं पर्यतोषयत्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004047014, "chapter_id": 24047, "verse_number": "३-३-१८-१५", "content_sanskrit": "श्रांतं पीठे समावेश्य कृत्वाभ्यंगं स्वपाणिना ।\nकृतस्नानं च विधिवत्कृतदेवार्चनं मुनिम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004047015, "chapter_id": 24047, "verse_number": "३-३-१८-१६", "content_sanskrit": "सुखासनोपविष्टं तं धूपमाल्यानुलेपनैः ।\nअर्चयित्वा वरान्नेन भोजयामास सादरम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004047016, "chapter_id": 24047, "verse_number": "३-३-१८-१७", "content_sanskrit": "भुक्त्वा च सम्यक्छनकैस्तृप्तश्चानंदनिर्भरः ।\nचकारांधमुनिस्तस्यै सुप्रीतः परमाशिषम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004047017, "chapter_id": 24047, "verse_number": "३-३-१८-१८", "content_sanskrit": "विहृत्य भर्त्रा सहसा च तेन लब्ध्वा सुतं सर्वगुणैर्वरिष्ठम् ।\nकीर्तिं च लोके महतीमवाप्य प्रसादयोग्या भव देवतानाम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004047018, "chapter_id": 24047, "verse_number": "३-३-१८-१९", "content_sanskrit": "इत्यभिव्याहृतं तेन मुनिना गतचक्षुषा ।\nनिशम्य विस्मिता बाला प्रत्युवाच कृतांजलिः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004047019, "chapter_id": 24047, "verse_number": "३-३-१८-२०", "content_sanskrit": "ब्रह्मंस्त्वद्वचनं सत्यं कदाचिन्न मृषा भवेत् ।\nतदेतन्मंदभाग्यायाः कथमेतत्फलिष्यति॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004047020, "chapter_id": 24047, "verse_number": "३-३-१८-२१", "content_sanskrit": "शिलाग्र्यामिव सद्वृष्टिः शुनक्यामिव सत्क्रिया ।\nविफला मंदभाग्यायामाशीर्ब्रह्मविदामपि॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004047021, "chapter_id": 24047, "verse_number": "३-३-१८-२२", "content_sanskrit": "सैषाहं विधवा ब्रह्मन्दुष्कर्मफलभागिनी ।\nत्वदाशीर्वचनस्यास्य कथं यास्यामि पात्रताम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004047022, "chapter_id": 24047, "verse_number": "३-३-१८-२३", "content_sanskrit": "मुनिरुवाच ।\nत्वामनालक्ष्य यत्प्रोक्तमंधेनापि मयाऽधुना ।\nतदेतत्साधयिष्यामि कुरु मच्छासनं शुभे॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004047023, "chapter_id": 24047, "verse_number": "३-३-१८-२४", "content_sanskrit": "उमामहेश्वरं नाम व्रतं यदि चरिष्यसि ।\nतेन व्रतानुभावेन सद्यः श्रेयोऽनुभोक्ष्यसे॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004047024, "chapter_id": 24047, "verse_number": "३-३-१८-२५", "content_sanskrit": "शारदोवाच ।\nत्वयोपदिष्टं यत्नेन चरिष्याम्यपि दुश्चरम् ।\nतद्व्रतं ब्रूहि मे ब्रह्मन्विधानं वद विस्तरात्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004047025, "chapter_id": 24047, "verse_number": "३-३-१८-२६", "content_sanskrit": "मुनिरुवाच ।\nचैत्रे वा मार्गशीर्षे वा शुक्लपक्षे शुभे दिने ।\nव्रतारंभं प्रकुर्वीत यथावद्गुर्वनुज्ञया॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004047026, "chapter_id": 24047, "verse_number": "३-३-१८-२७", "content_sanskrit": "अष्टम्यां च चतुर्दश्यामुभयोरपि पर्वणोः ।\nसंकल्पं विधिवत्कृत्वा प्रातःस्नानं समाचरेत्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004047027, "chapter_id": 24047, "verse_number": "३-३-१८-२८", "content_sanskrit": "सन्तर्प्य पितृदेवादीन्गत्वा स्वभवनं प्रति ।\nमंडपं रचयेद्दिव्यं वितानाद्यैरलंकृतम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004047028, "chapter_id": 24047, "verse_number": "३-३-१८-२९", "content_sanskrit": "फलपल्लवपुष्पाद्यैस्तोरणैश्च समन्वितम् ।\nपंचवर्णैश्च तन्मध्ये रजोभिः पद्ममुद्धरेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004047029, "chapter_id": 24047, "verse_number": "३-३-१८-३०", "content_sanskrit": "चतुर्दशदलैर्बाह्ये द्वाविंशद्भिस्तदंतरे ।\nतदंतरं षोडशभिरष्टभिश्च तदंतरे॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004047030, "chapter_id": 24047, "verse_number": "३-३-१८-३१", "content_sanskrit": "एवं पद्मं समुद्धत्य पंचवर्णैर्मनोरमम् ।\nचतुरस्रं ततः कुर्यादंतर्वर्तुलमुत्तमम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004047031, "chapter_id": 24047, "verse_number": "३-३-१८-३२", "content_sanskrit": "व्रीहितंडुलराशिं च तन्मध्ये च सकूर्चकम् ।\nकूर्चोपरि सुसंस्थाप्य कलशं वारिपूरितम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004047032, "chapter_id": 24047, "verse_number": "३-३-१८-३३", "content_sanskrit": "कलशोपरि विन्यस्य वस्त्रं वर्णसमन्वितम् ।\nतस्योपरिष्टात्सौवर्ण्यौ प्रतिमे शिवयोः शुभे ।\nनिधाय पूजयेद्भक्त्या यथाविभवविस्तरम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004047033, "chapter_id": 24047, "verse_number": "३-३-१८-३४", "content_sanskrit": "पंचामृतैस्तु संस्नाप्य तथा शुद्धोदकेन च ।\nरुद्रैकादशकं जप्त्वा पंचाक्षरशताष्टकम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004047034, "chapter_id": 24047, "verse_number": "३-३-१८-३५", "content_sanskrit": "अभिमंत्र्य पुनः स्थाप्य पीठं मध्ये तथार्चयेत् ।\nस्वयं शुद्धासनासीनो धौतशुक्लांबरः सुधीः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004047035, "chapter_id": 24047, "verse_number": "३-३-१८-३६", "content_sanskrit": "पीठमामंत्र्य मंत्रेण प्राणायामान्समाचरेत् ।\nसंकल्पं प्रवदेत्तत्र शिवाग्रे विहितांजलिः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004047036, "chapter_id": 24047, "verse_number": "३-३-१८-३७", "content_sanskrit": "यानि पापानि घोराणि जन्मांतरशतेषु मे ।\nतेषां सर्वविनाशाय शिवपूजां समारभे॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004047037, "chapter_id": 24047, "verse_number": "३-३-१८-३८", "content_sanskrit": "सौभाग्यविजयारोग्यधर्मैश्वर्याभिवृद्धये ।\nस्वर्गापवर्गसिद्ध्यर्थं करिष्ये शिवपूजनम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004047038, "chapter_id": 24047, "verse_number": "३-३-१८-३९", "content_sanskrit": "इति संकल्पमुच्चार्य यथावत्सुसमाहितः ।\nअंगन्यासं ततः कृत्वा ध्यायेदीशं च पार्वतीम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004047039, "chapter_id": 24047, "verse_number": "३-३-१८-४०", "content_sanskrit": "कुंदेंदुधवलाकारं नागाभरणभूषितम् ।\nवरदाभयहस्तं च बिभ्राणं परशुं मृगम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004047040, "chapter_id": 24047, "verse_number": "३-३-१८-४१", "content_sanskrit": "सूर्यकोटिप्रतीकाशं जगदानंदकारणम् ।\nजाह्नवीजलसंपर्काद्दीर्घपिंगजटाधरम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004047041, "chapter_id": 24047, "verse_number": "३-३-१८-४२", "content_sanskrit": "उरगेंद्रफणोद्भूतमहामुकुटमंडितम् ।\nशीतांशुखंडविलसत्कोटीरांगदभूषणम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004047042, "chapter_id": 24047, "verse_number": "३-३-१८-४३", "content_sanskrit": "उन्मीलद्भालनयनं तथा सूर्येंदुलोचनम् ।\nनीलकंठं चतुर्बाहुं गजेंद्राजिनवाससम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004047043, "chapter_id": 24047, "verse_number": "३-३-१८-४४", "content_sanskrit": "रत्नसिंहासनारूढं नागाभरणभूषितम् ।\nदेवीं च दिव्यवसनां बालसूर्यायुतद्युतिम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004047044, "chapter_id": 24047, "verse_number": "३-३-१८-४५", "content_sanskrit": "बालवेषां च तन्वंगीं बालशीतांशुशेखराम् ।\nपाशांकुशवराभीतिं बिभ्रतीं च चतुर्भुजाम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004047045, "chapter_id": 24047, "verse_number": "३-३-१८-४६", "content_sanskrit": "प्रसादसुमुखीमंबां लीलारसविहारिणीम् ।\nलसत्कुरबकाशोकपुन्नागनवचंपकैः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004047046, "chapter_id": 24047, "verse_number": "३-३-१८-४७", "content_sanskrit": "कृतावतंसामुत्फुल्लमल्लिकोत्कलितालकाम् ।\nकांचीकलापपर्यस्तजघनाभोगशालिनीम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004047047, "chapter_id": 24047, "verse_number": "३-३-१८-४८", "content_sanskrit": "उदारकिंकिणीश्रेणीनूपुराढ्यपदद्वयाम् ।\nगंडमंडलसंसक्तरत्नकुंडलशोभिताम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004047048, "chapter_id": 24047, "verse_number": "३-३-१८-४९", "content_sanskrit": "बिंबाधरानुरक्तांशुलसद्दशन कुड्मलाम् ।\nमहार्हरत्नग्रेवेयतारहारविराजिताम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004047049, "chapter_id": 24047, "verse_number": "३-३-१८-५०", "content_sanskrit": "नवमाणिक्यरुचिरकंकणांगदमुद्रिकाम् ।\nरक्तांशुकपरीधानां रत्नमाल्यानुलेपनाम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004047050, "chapter_id": 24047, "verse_number": "३-३-१८-५१", "content_sanskrit": "उद्यत्पीनकुचद्वंद्वनिंदितांभोजकुड्मलाम् ।\nलीलालोलासितापांगीं भक्तानुग्रहदायिनीम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004047051, "chapter_id": 24047, "verse_number": "३-३-१८-५२", "content_sanskrit": "एवं ध्यात्वा तु हृत्पद्मे जगतः पितरौ शिवौ ।\nजप्त्वा तदात्मकं मंत्रं तदंते बहिरर्चयेत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004047052, "chapter_id": 24047, "verse_number": "३-३-१८-५३", "content_sanskrit": "आवाह्य प्रतिमायुग्मे कल्पयेदासनादिकम् ।\nअर्घ्यं च दद्याच्छिवयोर्मंत्रेणानेन मंत्रवित्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004047053, "chapter_id": 24047, "verse_number": "३-३-१८-५४", "content_sanskrit": "नमस्ते पार्वतीनाथ त्रैलोक्यवरदर्षभ ।\nत्र्यंबकेश महादेव गृहाणार्घ्यं नमोऽस्तु ते॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004047054, "chapter_id": 24047, "verse_number": "३-३-१८-५५", "content_sanskrit": "नमस्ते देवदेवेशि प्रपन्नभयहारिणि ।\nअंबिके वरदे देवि गृहाणार्घ्यं शिवप्रिये॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004047055, "chapter_id": 24047, "verse_number": "३-३-१८-५६", "content_sanskrit": "इति त्रिवारमुच्चार्य दद्यादर्घ्यं समाहितः ।\nगन्धपुष्पाक्षतान्सम्यग्धूपदीपान्प्रकल्पयेत्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004047056, "chapter_id": 24047, "verse_number": "३-३-१८-५७", "content_sanskrit": "नैवेद्यं पायसान्नेन घृताक्तं परिकल्पयेत् ।\nजुहुयान्मूलमंत्रेण हविरष्टोत्तरं शतम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004047057, "chapter_id": 24047, "verse_number": "३-३-१८-५८", "content_sanskrit": "तत उद्वास्य नैवेद्यं धूपनीराजनादिकम् ।\nकृत्वा निवेद्य तांबूलं नमस्कुर्यात्समाहितः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004047058, "chapter_id": 24047, "verse_number": "३-३-१८-५९", "content_sanskrit": "अथाभ्यर्च्योपचारेण भोजयेद्विप्रदंपती॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004047059, "chapter_id": 24047, "verse_number": "३-३-१८-६०", "content_sanskrit": "एवं सायंतनीं पूजां कृत्वा विप्रानुमोदितः ।\nभुंजीत वाग्यतो रात्रौ हविष्यं क्षीरभावितम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004047060, "chapter_id": 24047, "verse_number": "३-३-१८-६१", "content_sanskrit": "एवं संवत्सरं कुर्याद्व्रतं पक्षद्वये बुधः ।\nततः संवत्सरे पूर्णे व्रतोद्यापनमाचरेत्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004047061, "chapter_id": 24047, "verse_number": "३-३-१८-६२", "content_sanskrit": "शतरुद्राभिजप्तेन स्नापयेत्प्रतिमे जलैः ।\nआगमोक्तेन मन्त्रेण संपूज्य गिरिजाशिवौ॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004047062, "chapter_id": 24047, "verse_number": "३-३-१८-६३", "content_sanskrit": "सवस्त्रं ससुवर्ण च कलशं प्रति मान्वितम् ।\nदत्त्वाचार्याय महते सदाचाररताय च ।\nब्राह्मणान्भोजयेद्भक्त्या यथाशक्त्याभिपूज्य च॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004047063, "chapter_id": 24047, "verse_number": "३-३-१८-६४", "content_sanskrit": "दद्याच्च दक्षिणां तेभ्यो गोहिरण्यांबरादिकम् ।\nभुंजीत तदनुज्ञातः सहेष्टजनबंधुभिः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004047064, "chapter_id": 24047, "verse_number": "३-३-१८-६५", "content_sanskrit": "एवं यः कुरुते भक्त्या व्रतं त्रैलोक्यविश्रुतम् ।\nत्रिःसप्तकुलमुद्धृत्य भुक्त्वा भोगान्यथेप्सि तान्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004047065, "chapter_id": 24047, "verse_number": "३-३-१८-६६", "content_sanskrit": "इन्द्रादिलोकपालानां स्थानेषु रमते धुवम् ।\nब्रह्मलोके च रमते विष्णुलोके च शाश्वते॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004047066, "chapter_id": 24047, "verse_number": "३-३-१८-६७", "content_sanskrit": "शिवलोकमथ प्राप्य तत्र कल्पशतं पुनः ।\nभुक्त्वा भोगान्सुविपुलाञ्छिवमेव प्रपद्यते॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004047067, "chapter_id": 24047, "verse_number": "३-३-१८-६८", "content_sanskrit": "महाव्रतमिदं प्रोक्तं त्वमपि श्रद्धया चर ।\nअत्यंतदुर्लभं वापि लप्स्यसे च मनोरथम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004047068, "chapter_id": 24047, "verse_number": "३-३-१८-६९", "content_sanskrit": "इत्यादिष्टा मुनींद्रेण सा बाला मुदिता भृशम् ।\nप्रत्यग्रहीत्सुविश्रब्धा तद्वाक्यं सुमनोहरम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004047069, "chapter_id": 24047, "verse_number": "३-३-१८-७०", "content_sanskrit": "अथ तस्याः समायाताः पितृमातृ सहोदराः ।\nतं मुनिं सुखमासीनं ददृशुः कृतभोजनम्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004047070, "chapter_id": 24047, "verse_number": "३-३-१८-७१", "content_sanskrit": "सहसागत्य ते सर्वे नमश्चक्रुर्महात्मने ।\nप्रसीद नः प्रसीदेति गृणतः पर्यपूज यन्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004047071, "chapter_id": 24047, "verse_number": "३-३-१८-७२", "content_sanskrit": "श्रुत्वा च ते तया साध्व्या पूजितं परमं मुनिम् ।\nअनुग्रहवतं तस्यै श्रुत्वा हर्षं परं ययुः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004047072, "chapter_id": 24047, "verse_number": "३-३-१८-७३", "content_sanskrit": "ते कृतांजलयः सर्वे तमूचुर्मुनि पुंगवम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004047073, "chapter_id": 24047, "verse_number": "३-३-१८-७४", "content_sanskrit": "अद्य धन्या वयं सर्वे तवागमनमात्रतः ।\nपावितं नः कुलं सर्वं गृहं च सफलीकृतम्॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004047074, "chapter_id": 24047, "verse_number": "३-३-१८-७५", "content_sanskrit": "इयं च शारदा नाम कन्या वैधव्यमागता ।\nकेनापि कर्मयोगेन दुर्विलंघ्येन भूयसा॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004047075, "chapter_id": 24047, "verse_number": "३-३-१८-७६", "content_sanskrit": "सैषाद्य तव पादाब्जं प्रपन्ना शरणं सती ।\nइमां समुद्धरासह्यात्सुघोराद्दुःख सागरात्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004047076, "chapter_id": 24047, "verse_number": "३-३-१८-७७", "content_sanskrit": "त्वयापि तावदत्रैव स्थातव्यं नो गृहांतिके ।\nअस्मद्गृहमठेऽप्यस्मिन्स्नानपूजाजपोचिते॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004047077, "chapter_id": 24047, "verse_number": "३-३-१८-७८", "content_sanskrit": "एषा बालापि भगवन्कुर्वंती त्वत्पदार्चनम् ।\nव्रतं त्वत्सन्निधावेव चरिष्यति महामुने॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004047078, "chapter_id": 24047, "verse_number": "३-३-१८-७९", "content_sanskrit": "यावत्समाप्तिमायाति व्रतमस्यास्त्वदंतिके ।\nउषित्वा तावदत्रैव कृतार्थान्कुरु नो गुरो॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004047079, "chapter_id": 24047, "verse_number": "३-३-१८-८०", "content_sanskrit": "एवमभ्यर्थितः सर्वैस्तस्या भ्रातृजनादिभिः ।\nतथेति स मुनिश्रेष्ठस्तत्रोवास मठे शुभे॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004047080, "chapter_id": 24047, "verse_number": "३-३-१८-८१", "content_sanskrit": "सापि तेनोपदिष्टेन मार्गेण गिरिजाशिवौ ।\nअर्चयंती व्रतं सम्यक्चचार विमला सती॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]