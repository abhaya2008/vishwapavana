[{"id": 40017769, "chapter_id": 9269, "verse_number": "1", "content_sanskrit": "विज्ञायतुमनस्तस्यराघवस्यमहात्मनः । स निवृत्याहवात्तस्मात् प्रविवेशपुरींततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017770, "chapter_id": 9269, "verse_number": "2", "content_sanskrit": "सोऽनुस्मृत्यवधंतेषांराक्षसानांतरस्विनाम् । क्रोधताम्रेक्षणश्शूरोनिर्जगामाहाद्युति: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017771, "chapter_id": 9269, "verse_number": "3", "content_sanskrit": "स पश्चिमेवद्वारेणनिर्ययौराक्षसैर्वृतः । इन्द्रजित्सुमहावीर्यःपौलस्त्योदेवकण्टकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017772, "chapter_id": 9269, "verse_number": "4", "content_sanskrit": "इन्द्रजित्तुततोदृष्टवाभ्रातरौरामलक्ष्मणौ । रणायाभ्युद्यतौवीरौमायांप्रादुष्करोत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017773, "chapter_id": 9269, "verse_number": "5", "content_sanskrit": "इन्द्रजित्तुरथेस्थाप्यसीतांमायामयींतदा । बलेनमहतावृत्यतस्यावधमरोचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017774, "chapter_id": 9269, "verse_number": "6", "content_sanskrit": "मोहनार्थंतुसर्वेषांबुद्धिंकृत्वासुदुर्मतिः । हन्तुंसीतांव्यवसितोवानराभिमुखोययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017775, "chapter_id": 9269, "verse_number": "7", "content_sanskrit": "तम्दृष्टवात्वभिनिर्यान्तंसर्वेतेकाननौकसः । उत्पेतुरभिसङ्क्रुद्धाश्शिलाहस्तायुयुत्सवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017776, "chapter_id": 9269, "verse_number": "8", "content_sanskrit": "हनूमान् पुरतस्तेषांजगामकपिकुञ्जरः । प्रगृह्यसुमहच्छृङ्गंपर्वतस्यदुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017777, "chapter_id": 9269, "verse_number": "9", "content_sanskrit": "स ददर्शहतानन्दांसीतामिन्द्रजितोरथे । एकवेणीधरांदीनामुपवासकृशाननाम् ॥ परिक्लिष्टैकवसनाममृजांराघवप्रियाम् । रजोमलाभ्यामालिप्तैस्सर्वगात्रैर्वरस्त्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017778, "chapter_id": 9269, "verse_number": "10", "content_sanskrit": "स ददर्शहतानन्दांसीतामिन्द्रजितोरथे । एकवेणीधरांदीनामुपवासकृशाननाम् ॥ परिक्लिष्टैकवसनाममृजांराघवप्रियाम् । रजोमलाभ्यामालिप्तैस्सर्वगात्रैर्वरस्त्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017779, "chapter_id": 9269, "verse_number": "11", "content_sanskrit": "तांनिरीक्ष्यमुहूर्तंतुमैथिलीत्यध्यवस्यतु । बभूवाचिरदृष्टाहितेनसाजनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017780, "chapter_id": 9269, "verse_number": "12", "content_sanskrit": "अब्रवीत्तांतुशोकार्तांनिरानन्दांतपस्विनीम् । दृष्टवारथोस्थितांदृष्ट्वाराक्षसेन्द्रसुतश्रिताम् ॥ कंसमर्थितमस्येतिचिन्तयन्समहाकपिः । सहतैर्वानरश्रेष्ठैरभ्यधावतरावणिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017781, "chapter_id": 9269, "verse_number": "13", "content_sanskrit": "अब्रवीत्तांतुशोकार्तांनिरानन्दांतपस्विनीम् । दृष्टवारथोस्थितांदृष्ट्वाराक्षसेन्द्रसुतश्रिताम् ॥ कंसमर्थितमस्येतिचिन्तयन्समहाकपिः । सहतैर्वानरश्रेष्ठैरभ्यधावतरावणिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017782, "chapter_id": 9269, "verse_number": "14", "content_sanskrit": "तद्वानरबलंदृष्टवारावणिःक्रोधमूर्छितः । कृत्वाविकोशंनिस्त्रिंशंमूर्ध्निसीतामकर्षयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017783, "chapter_id": 9269, "verse_number": "15", "content_sanskrit": "तांस्त्रियंपश्यतांतेषांताडयामासरावणि: । क्रोशन्तींरामरामेतिमाययायोजितांरथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017784, "chapter_id": 9269, "verse_number": "16", "content_sanskrit": "गृहीतमूर्धजांदृष्टवाहनुमान् दैन्यमागतः । शोकजंवारिनेत्राभ्यामुत्सृजन्मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017785, "chapter_id": 9269, "verse_number": "17", "content_sanskrit": "तांदृष्टवाचारुसर्वाङ्गींरामस्यमहिषींप्रियाम् । अब्रवीत्पुरुषंवाक्यंक्रोधाद्रक्षोधिपात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017786, "chapter_id": 9269, "verse_number": "18", "content_sanskrit": "दुरात्मन्नात्मनाशायकेशपक्षेपरामृशः । ब्रह्मर्षीणांकुलेजातोराक्षसींयोनिमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017787, "chapter_id": 9269, "verse_number": "19", "content_sanskrit": "धिक्त्वांपापसमाचारंयस्यतेमतिरिदृशी । नृशंसानार्य दुर्वृत्त क्षुद्र पापपराक्रम ॥ अनार्यस्येदृशंकर्मघृणातेनास्तिनिर्घृण ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017788, "chapter_id": 9269, "verse_number": "20", "content_sanskrit": "च्युतागृहाच्चराज्याच्चरामहस्ताच्चमैथिली ॥ किंतवैषापराद्धाहियदेनांहन्तुमिच्छसि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017789, "chapter_id": 9269, "verse_number": "21", "content_sanskrit": "सीतांहत्वातु न चिरंजीविष्यसिकथञ्चन ॥ वधार्हकर्मणानेनममहस्तगतोह्यसि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017790, "chapter_id": 9269, "verse_number": "22", "content_sanskrit": "येच स्त्रीघातिनांलोकालोकवध्यैषुकुसतिताः ॥ इहजीवितमुत्सृज्यप्रेत्यतान्प्रतिपत्स्यसे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017791, "chapter_id": 9269, "verse_number": "23", "content_sanskrit": "तिब्रुवाणोहनुमान् सायुधैर्हरिभिर्वृतः ॥ अभ्यदावत् ससुङ्कृद्धोराक्षसेन्द्रसुतंप्रति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017792, "chapter_id": 9269, "verse_number": "24", "content_sanskrit": "पतन्तंमहावीर्यंतदनीकंवनौकसाम् ॥ रक्षसांभीमकोपानामनीकंतुन्यवारयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017793, "chapter_id": 9269, "verse_number": "25", "content_sanskrit": "सःतांबाणसहस्रेणविक्षोभ्यहरिवाहिनीम् ॥ हनूमन्तंहरिश्रेष्ठमिन्द्रजित् प्रत्युवाच ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017794, "chapter_id": 9269, "verse_number": "26", "content_sanskrit": "सुग्रीवस्त्वं च रामश्चयन्निमित्तमिहागताः ॥ तांवधिष्यामिवैदेहीमद्यैवतवपश्यतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017795, "chapter_id": 9269, "verse_number": "27", "content_sanskrit": "इमांहत्वाततोरामंलक्ष्मणंत्वां च वानर ॥ सुग्रीवं च वधिष्यामितंचानार्यंविभीषणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017796, "chapter_id": 9269, "verse_number": "28", "content_sanskrit": "न हन्तव्याःस्त्रियश्चेतियद् ब्रवीषिप्लवङ्गम ॥ पीडाकरममित्राणांयत्स्यात्कर्तव्यमेवतत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017797, "chapter_id": 9269, "verse_number": "29", "content_sanskrit": "तमेवमुक्त्वारुदतींसीतांमयामयीं च ताम् ॥ शितधारेणखङ्गेननिजघानेन्द्रजित्स्वयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017798, "chapter_id": 9269, "verse_number": "30", "content_sanskrit": "यज्ञोपवीतमार्गेणभिन्नातेनतपस्विनी ॥ सापृथिव्यांपृथुश्रोणीपपातप्रियदर्शना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017799, "chapter_id": 9269, "verse_number": "31", "content_sanskrit": "त्तामिन्द्रजित् स्त्रियंहत्वाहनूमन्तमुवाच ह ॥ मयारामस्यपश्येमांकोपेन च । एषाविशस्तावैदेहीनिष्फलोवःपरिश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017800, "chapter_id": 9269, "verse_number": "32", "content_sanskrit": "त्तामिन्द्रजित् स्त्रियंहत्वाहनूमन्तमुवाच ह ॥ मयारामस्यपश्येमांकोपेन च । एषाविशस्तावैदेहीनिष्फलोवःपरिश्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017801, "chapter_id": 9269, "verse_number": "33", "content_sanskrit": "ततःखडगेनमहताहत्वातामिन्द्रजित् स्वयम् । हृष्टस्सरथमास्थायननाद च महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017802, "chapter_id": 9269, "verse_number": "34", "content_sanskrit": "वानराश्शुश्रुवुश्शब्दमदूरेप्रत्यवस्थिताः । व्यादितास्यस्यनदतस्तद्दुर्गंसंश्रितस्यतु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]