[{"id": 5000269000, "chapter_id": 9269, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे द्विसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000269001, "chapter_id": 9269, "verse_number": "३-७२-१", "content_sanskrit": "एवमुक्तौ तु तौ वीरौ कबन्धेन नरेश्वरौ।\nगिरिप्रदरमासाद्य पावकं विससर्जतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000269002, "chapter_id": 9269, "verse_number": "३-७२-२", "content_sanskrit": "लक्ष्मणस्तु महोल्काभिर्ज्वलिताभिः समन्ततः।\nचितामादीपयामास सा प्रजज्वाल सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000269003, "chapter_id": 9269, "verse_number": "३-७२-३", "content_sanskrit": "तच्छरीरं कबन्धस्य घृतपिण्डोपमं महत्।\nमेदसा पच्यमानस्य मन्दं दहत पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000269004, "chapter_id": 9269, "verse_number": "३-७२-४", "content_sanskrit": "सविधूय चितामाशु विधूमोऽग्निरिवोत्थितः।\nअरजे वाससी बिभ्रन्माल्यं दिव्यं महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000269005, "chapter_id": 9269, "verse_number": "३-७२-५", "content_sanskrit": "ततश्चिताया वेगेन भास्वरो विरजाम्बरः।\nउत्पपाताशु संहृष्टः सर्वप्रत्यङ्गभूषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000269006, "chapter_id": 9269, "verse_number": "३-७२-६", "content_sanskrit": "विमाने भास्वरे तिष्ठन् हंसयुक्ते यशस्करे।\nप्रभया च महातेजा दिशो दश विराजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000269007, "chapter_id": 9269, "verse_number": "३-७२-७", "content_sanskrit": "सोऽन्तरिक्षगतो वाक्यं कबन्धो राममब्रवीत्।\nशृणु राघव तत्त्वेन यथा सीतामवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000269008, "chapter_id": 9269, "verse_number": "३-७२-८", "content_sanskrit": "राम षड् युक्तयो लोके याभिः सर्वं विमृश्यते।\nपरिमृष्टो दशान्तेन दशाभागेन सेव्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000269009, "chapter_id": 9269, "verse_number": "३-७२-९", "content_sanskrit": "दशाभागगतो हीनस्त्वं हि राम सलक्ष्मणः।\nयत्कृते व्यसनं प्राप्तं त्वया दारप्रधर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000269010, "chapter_id": 9269, "verse_number": "३-७२-१०", "content_sanskrit": "तदवश्यं त्वया कार्यः स सुहृत् सुहृदां वर।\nअकृत्वा नहि ते सिद्धिमहं पश्यामि चिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000269011, "chapter_id": 9269, "verse_number": "३-७२-११", "content_sanskrit": "श्रूयतां राम वक्ष्यामि सुग्रीवो नाम वानरः।\nभ्रात्रा निरस्तः क्रुद्धेन वालिना शक्रसूनुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000269012, "chapter_id": 9269, "verse_number": "३-७२-१२", "content_sanskrit": "ऋष्यमूके गिरिवरे पम्पापर्यन्तशोभिते।\nनिवसत्यात्मवान् वीरश्चतुर्भिः सह वानरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000269013, "chapter_id": 9269, "verse_number": "३-७२-१३", "content_sanskrit": "वानरेन्द्रो महावीर्यस्तेजोवानमितप्रभः।\nसत्यसंधो विनीतश्च धृतिमान् मतिमान् महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000269014, "chapter_id": 9269, "verse_number": "३-७२-१४", "content_sanskrit": "दक्षः प्रगल्भो द्युतिमान् महाबलपराक्रमः।\nभ्रात्रा विवासितो वीर राज्यहेतोर्महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000269015, "chapter_id": 9269, "verse_number": "३-७२-१५", "content_sanskrit": "स ते सहायो मित्रं च सीतायाः परिमार्गणे।\nभविष्यति हि ते राम मा च शोके मनः कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000269016, "chapter_id": 9269, "verse_number": "३-७२-१६", "content_sanskrit": "भवितव्यं हि तच्चापि न तच्छक्यमिहान्यथा।\nकर्तुमिक्ष्वाकुशार्दूल कालो हि दुरतिक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000269017, "chapter_id": 9269, "verse_number": "३-७२-१७", "content_sanskrit": "गच्छ शीघ्रमितो वीर सुग्रीवं तं महाबलम्।\nवयस्यं तं कुरु क्षिप्रमितो गत्वाद्य राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000269018, "chapter_id": 9269, "verse_number": "३-७२-१८", "content_sanskrit": "अद्रोहाय समागम्य दीप्यमाने विभावसौ।\nन च ते सोऽवमन्तव्यः सुग्रीवो वानराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000269019, "chapter_id": 9269, "verse_number": "३-७२-१९", "content_sanskrit": "कृतज्ञः कामरूपी च सहायार्थी च वीर्यवान्।\nशक्तौ ह्यद्य युवां कर्तुं कार्यं तस्य चिकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000269020, "chapter_id": 9269, "verse_number": "३-७२-२०", "content_sanskrit": "कृतार्थो वाकृतार्थो वा तव कृत्यं करिष्यति।\nस ऋक्षरजसः पुत्रः पम्पामटति शङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000269021, "chapter_id": 9269, "verse_number": "३-७२-२१", "content_sanskrit": "भास्करस्यौरसः पुत्रो वालिना कृतकिल्बिषः।\nसंनिधायायुधं क्षिप्रमृष्यमूकालयं कपिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000269022, "chapter_id": 9269, "verse_number": "३-७२-२२", "content_sanskrit": "कुरु राघव सत्येन वयस्यं वनचारिणम्।\nस हि स्थानानि कात्स्‍न्‍‍र्येन सर्वाणि कपिकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000269023, "chapter_id": 9269, "verse_number": "३-७२-२३", "content_sanskrit": "नरमांसाशिनां लोके नैपुण्यादधिगच्छति।\nन तस्याविदितं लोके किंचिदस्ति हि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000269024, "chapter_id": 9269, "verse_number": "३-७२-२४", "content_sanskrit": "यावत् सूर्यः प्रतपति सहस्रांशुः परंतप।\nस नदीर्विपुलान् शैलान् गिरिदुर्गाणि कन्दरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000269025, "chapter_id": 9269, "verse_number": "३-७२-२५", "content_sanskrit": "अन्विष्य वानरैः सार्धं पत्नीं तेऽधिगमिष्यति।\nवानरांश्च महाकायान् प्रेषयिष्यति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000269026, "chapter_id": 9269, "verse_number": "३-७२-२६", "content_sanskrit": "दिशो विचेतुं तां सीतां त्वद्वियोगेन शोचतीम्।\nअन्वेष्यति वरारोहां मैथिलीं रावणालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000269027, "chapter_id": 9269, "verse_number": "३-७२-२७", "content_sanskrit": "स मेरुशृङ्गाग्रगतामनिन्दितां\nप्रविश्य पातालतलेऽपि वाश्रिताम्।\nप्लवङ्गमानामृषभस्तव प्रियां\nनिहत्य रक्षांसि पुनः प्रदास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000269028, "chapter_id": 9269, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे द्विसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]