[{"id": 7006087000, "chapter_id": 26087, "verse_number": "२-३१-१", "content_sanskrit": "श्रीविष्णुरुवाच ।\nये नराः पापसंयुक्तास्ते गच्छन्ति यमालयम् ।\nनृणां मत्साक्षिकं दत्तमनन्तफलदं भवेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006087001, "chapter_id": 26087, "verse_number": "२-३१-२", "content_sanskrit": "यावद्रजः प्रमाणाब्दंस्वर्गे तिष्ठति भूमिदः ।\nअश्वारूढाश्च ते यान्ति ददते ये ह्युपानहौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006087002, "chapter_id": 26087, "verse_number": "२-३१-३", "content_sanskrit": "आतपे श्रमयोगेन न दह्यन्ते च कुत्रचित् ।\nछत्त्रदानेन वै प्रेता विचरन्ति सुखं पथि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006087003, "chapter_id": 26087, "verse_number": "२-३१-४", "content_sanskrit": "यमुद्दिश्य ददात्यन्नं तेन चाप्यायितो भवेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006087004, "chapter_id": 26087, "verse_number": "२-३१-५", "content_sanskrit": "अन्धकारे महाघोरे अमूर्ते लक्ष्यवर्जिते ।\nउद्द्योतेनैव ते यान्ति दीपदानेन मानवाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006087005, "chapter_id": 26087, "verse_number": "२-३१-६", "content_sanskrit": "आश्विने कर्तिके वापि माघे मृततिथावपि ।\nचतुर्दश्याञ्च दीयेत दीपदानं सुखाय वै ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006087006, "chapter_id": 26087, "verse_number": "२-३१-७", "content_sanskrit": "प्रत्यहञ्च प्रदातव्यं मार्गे सुविषमे नरैः ।\nयावत्संवत्सरं वापि प्रेतस्य सुखलिप्सया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006087007, "chapter_id": 26087, "verse_number": "२-३१-८", "content_sanskrit": "कुले द्योतति शुद्धात्मा प्रकाशत्वं स गच्छति ।\nज्योतिर्मयोऽसौ पूज्योऽसौ दीपदानप्रदो नरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006087008, "chapter_id": 26087, "verse_number": "२-३१-९", "content_sanskrit": "प्राङ्मुखोदङ्मुखं दीपं देवागारे द्विजातये ।\nकुर्याद्याम्यमुखं पित्रे अद्भिः सङ्कल्प्य सुस्थिरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006087009, "chapter_id": 26087, "verse_number": "२-३१-१०", "content_sanskrit": "सर्वोपहारयुक्तानि पदान्यत्र त्रयोदश ।\nयो ददाति मृतस्येह जीवन्नप्यात्महेतवे ।\nस गच्छति महामार्गे महाकष्टविवर्जितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006087010, "chapter_id": 26087, "verse_number": "२-३१-११", "content_sanskrit": "आसनं भाजनं भोज्यं दीयते यद्द्विजायते ।\nसुखे न भुञ्जमानस्तु देन गच्छत्यलं पथि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006087011, "chapter_id": 26087, "verse_number": "२-३१-१२", "content_sanskrit": "कमण्डलुप्रदानेन तृषितः पिबते जलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006087012, "chapter_id": 26087, "verse_number": "२-३१-१३", "content_sanskrit": "भाजनं वस्त्रदानञ्च कुसुमञ्चाङ्गुलीयकम् ।\nएकादशा हे दातव्यं प्रेतोद्धरणहेतवे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006087013, "chapter_id": 26087, "verse_number": "२-३१-१४", "content_sanskrit": "त्रयोदश पदानीत्थं प्रेतस्य शुभमिच्छता ।\nदातव्यानि यथाशक्त्या प्रेतोऽसौ प्रीणितो भवेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006087014, "chapter_id": 26087, "verse_number": "२-३१-१५", "content_sanskrit": "भोजना नि तिलांश्चैव उदकुम्भांस्त्रयोदश ।\nमुद्रिकां वस्त्रयुग्मञ्च तया याति परां गतिम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006087015, "chapter_id": 26087, "verse_number": "२-३१-१६", "content_sanskrit": "योऽश्वं नावं गजं वापि ब्राह्मणे प्रतिपादयेत् ।\nस महिम्नोऽनुसारेण तत्तत्सुखमुपाश्नुते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006087016, "chapter_id": 26087, "verse_number": "२-३१-१७", "content_sanskrit": "नानालोकान् विचरति महिषीञ्च ददाति यः ।\nयमपुत्त्रस्य या माता महिषी सुगतिप्रदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006087017, "chapter_id": 26087, "verse_number": "२-३१-१८", "content_sanskrit": "ताम्बूलं कुसुमं देयं याम्यानां हर्षवर्धनम् ।\nतेन सम्प्रीणिताः सर्वे तस्मिन् क्लेशं न कुर्वते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006087018, "chapter_id": 26087, "verse_number": "२-३१-१९", "content_sanskrit": "गोभूतिलहिरण्यानि दानान्याहुः स्वशक्तितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006087019, "chapter_id": 26087, "verse_number": "२-३१-२०", "content_sanskrit": "मृतोद्देशेन यो यद्याज्जलपात्रञ्च मृन्मयम् ।\nउदपात्रसहस्रस्य फलमाप्नोति मानवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006087020, "chapter_id": 26087, "verse_number": "२-३१-२१", "content_sanskrit": "यमदूता महारौद्राः करालाः कृष्णपिङ्गलाः ।\nन भीषयन्ति तं याम्या वस्त्रदाने कृते सति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006087021, "chapter_id": 26087, "verse_number": "२-३१-२२", "content_sanskrit": "मार्गे हि गच्छमानस्तु तृष्णार्तः श्रमपीडितः ।\nघटान्नदानयोगेन सुखी भवति निश्चितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006087022, "chapter_id": 26087, "verse_number": "२-३१-२३", "content_sanskrit": "शय्या दक्षिणया युक्ता आयुधाम्बरसंयुता ।\nहैमश्रीपतिना युक्ता देया विप्राय शर्मणे ।\nतथा प्रेतत्वमुक्तोऽसौ मोदते सह दैवतैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006087023, "chapter_id": 26087, "verse_number": "२-३१-२४", "content_sanskrit": "एतत्ते कथितं तार्क्ष्य दानमन्त्येष्टिकर्मजम् ।\nअधुना कथयिष्येऽहमन्यदेहप्रवेशनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006087024, "chapter_id": 26087, "verse_number": "२-३१-२५", "content_sanskrit": "जातस्य मृत्युलोके वै प्राणिनो मरणं ध्रुवम् ।\nमृतिः कुर्यात्स्वधर्मेण यास्यतश्च परन्तप ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006087025, "chapter_id": 26087, "verse_number": "२-३१-२६", "content_sanskrit": "पूर्वकाले मृतानाञ्च प्राणिनाञ्च खगेश्वर ।\nसूक्ष्मोभूत्वा त्वसौ वायुर्निर्गच्छत्यास्यमण्डलात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006087026, "chapter_id": 26087, "verse_number": "२-३१-२७", "content_sanskrit": "नवद्वारै रोमभिश्च जनानां तालुरन्ध्रके ।\nपापिष्ठानामपानेन जीवो निष्क्रामति ध्रुवम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006087027, "chapter_id": 26087, "verse_number": "२-३१-२८", "content_sanskrit": "शरीरञ्च पतेत्पश्चान्निर्गते मरुतीश्वरे ।\nवाताहतः पतत्येव निराधारो यथा द्रुमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006087028, "chapter_id": 26087, "verse_number": "२-३१-२९", "content_sanskrit": "पृथिव्यां लीयते पृथ्वी आपश्चैव तथाप्सु च ।\nतेजस्तेजसि लीयते समीरणः समीरणे ।\nआकाशे च तथा काशः सर्वव्यापी च शङ्करे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006087029, "chapter_id": 26087, "verse_number": "२-३१-३०", "content_sanskrit": "तत्र कामस्तथा क्रोधः काये पञ्चेन्द्रियाणि च ।\nएते तार्क्ष्य समाख्याता देहे तिष्ठन्ति तस्कराः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006087030, "chapter_id": 26087, "verse_number": "२-३१-३१", "content_sanskrit": "कामः क्रोधो ह्यहङ्कारो मनस्तत्रैव नायकः ।\nसंहारकश्च कालोऽयं पुण्यपापसमन्वितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006087031, "chapter_id": 26087, "verse_number": "२-३१-३२", "content_sanskrit": "जगतश्च स्वरूपन्तु निर्मितं स्वेन कर्मणा ।\nपुनर्देहान्तरं याति सुकृतैर्दुष्कृतैर्नरः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006087032, "chapter_id": 26087, "verse_number": "२-३१-३३", "content_sanskrit": "पञ्चेन्द्रियसमायुक्तं सकलैर्विष्यैः सह ।\nप्रविशेत्स नवं देहं गृहे दग्धे यथा गृही ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006087033, "chapter_id": 26087, "verse_number": "२-३१-३४", "content_sanskrit": "शरीरे ये समासीना सम्भवेत्सर्वधातवः ।\nषाट्कौशिको ह्ययं कायो माता पित्रोश्च धातवः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006087034, "chapter_id": 26087, "verse_number": "२-३१-३५", "content_sanskrit": "सम्भवेयुस्तथा तार्क्ष्य सर्वे वाताश्च देहिनाम् ।\nमूत्रं पुरीषं तद्योगा ये चान्ये व्याधयस्तथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006087035, "chapter_id": 26087, "verse_number": "२-३१-३६", "content_sanskrit": "अस्थि शुक्रं तथा स्नायुः देहेन सह दह्यते ।\nएष ते कथितस्तार्क्ष्य विनाशः सर्वदेहिनाम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006087036, "chapter_id": 26087, "verse_number": "२-३१-३७", "content_sanskrit": "कथयामि पुनस्तेषां शरीरञ्च यथा भवेत् ।\nएकस्तम्भं स्नायुबद्धं स्थूणाद्वयसमुद्धृतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006087037, "chapter_id": 26087, "verse_number": "२-३१-३८", "content_sanskrit": "इन्द्रियैश्च समायुक्तं नवद्वारं शरीरकम् ।\nविषयैश्च समाक्रान्तं कामक्रोधसमाकुलम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006087038, "chapter_id": 26087, "verse_number": "२-३१-३९", "content_sanskrit": "रागद्वेषसमाकीर्णं तृष्णादुर्गसुदुस्तरम् ।\nलोभजालसमायुक्तं पुरं पुरुषसंज्ञितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006087039, "chapter_id": 26087, "verse_number": "२-३१-४०", "content_sanskrit": "एतद्गुणसमायुक्तं शरीरं सर्वदेहिनाम् ।\nतिष्ठन्ति देवताः सर्वा भुवनानि चतुर्दश ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006087040, "chapter_id": 26087, "verse_number": "२-३१-४१", "content_sanskrit": "आत्मानं ये न जानन्ति ते नराः पशवः स्मृताः ।\nएवमेतन्मयाख्यातं शरीरं ते चतुर्विधम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006087041, "chapter_id": 26087, "verse_number": "२-३१-४२", "content_sanskrit": "चतुरशीतिलक्षाणि निर्मिता योनयः पुरा ।\nउद्भिज्जाः स्वेदजाश्चैव अण्डजाश्च जरायुजाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006087042, "chapter_id": 26087, "verse_number": "२-३१-४३", "content_sanskrit": "एतत्ते सर्वमाख्यातं यत्पृष्टोहं त्वयानघ ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]