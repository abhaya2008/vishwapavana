[{"id": 2033940, "chapter_id": 1734, "verse_number": "४-५७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033941, "chapter_id": 1734, "verse_number": "४-५७-१", "content_sanskrit": "अश्वत्थामा ततस्तत्र कर्णं संप्रेक्ष्य वीर्यवान्।\nउवाच स्मयमानोऽसौ सूतपुत्रमरिन्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033942, "chapter_id": 1734, "verse_number": "४-५७-२", "content_sanskrit": "कर्ण यस्त्वं सभामध्ये बह्वबद्धं विकत्थसे।\nन मे युधि समोऽस्तीति तदिदं प्रत्युपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033943, "chapter_id": 1734, "verse_number": "४-५७-३", "content_sanskrit": "एषोऽन्तक इव क्रुद्धः सर्वभूतावमर्दनः ।\nसंग्रामशिरसो मध्ये दृम्भते केसरी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033944, "chapter_id": 1734, "verse_number": "४-५७-४", "content_sanskrit": "शूरोसि यदि संग्रामे दर्शयस्व सभां विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033945, "chapter_id": 1734, "verse_number": "४-५७-५", "content_sanskrit": "यद्यशक्तोसि संग्रामे पार्थेनाद्भुतकर्मणा।\nपुनरेव सभां गत्वा धार्तराष्ट्रेण धीमता।\nमातुलं परिगृह्याशु मन्त्रयस्व यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033946, "chapter_id": 1734, "verse_number": "४-५७-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033947, "chapter_id": 1734, "verse_number": "४-५७-६", "content_sanskrit": "एवमुक्तस्तथा कर्णः क्रोधादुद्वृत्य लोचने।\nद्रोणपुत्रमिदं वाक्यमुवाच कुरुसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033948, "chapter_id": 1734, "verse_number": "४-५७-७", "content_sanskrit": "नाहं बिभेमि बीभत्सोर्न कृष्णाद्देवकीसुतात् ।\nपाण्डवेभ्योपि सर्वेभ्यः क्षत्रधर्ममनुव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033949, "chapter_id": 1734, "verse_number": "४-५७-८", "content_sanskrit": "सत्वाधिकानां पुंसां तु धनुर्वेदोपजीविनाम् ।\nगर्जतां जायते दर्पः स्वरश्च न विषीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033950, "chapter_id": 1734, "verse_number": "४-५७-९", "content_sanskrit": "पश्यत्वाचार्यपुत्रो मामर्जुनेनातिरंहसा ।\nयुध्यमानं सुसंयुक्तं जयो वै मय्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033951, "chapter_id": 1734, "verse_number": "४-५७-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033952, "chapter_id": 1734, "verse_number": "४-५७-१०", "content_sanskrit": "ततः प्रहस्य बीभत्सुः कौन्तेयः श्वेतवाहनः।\nदिव्यमस्त्रं विकुर्वाणः प्रत्ययाद्रथिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033953, "chapter_id": 1734, "verse_number": "४-५७-११", "content_sanskrit": "महात्मानं मन्दबुद्धिर्निश्वसन्धृतराष्ट्रजः।\nउवाच स महाराज राजा दुर्योधनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033954, "chapter_id": 1734, "verse_number": "४-५७-१२", "content_sanskrit": "न विद्मो ह्यर्जुनं तत्र वसन्तं मत्स्यवेश्मनि ।\nतेनेदं कर्ण मत्स्यानामग्रहीष्म धनं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033955, "chapter_id": 1734, "verse_number": "४-५७-१३", "content_sanskrit": "एवं चेत्तर्हि गच्छामो विसृजन्तो धनं बहु ।\nअयशो नातिवर्तेत लोकयोरुभयोरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033956, "chapter_id": 1734, "verse_number": "४-५७-१४", "content_sanskrit": "किं च युद्धात्परं नास्ति क्षत्रियाणां सुखावहम्।\nतस्मात्पार्थेन संग्रामं कुर्महे न पलायनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033957, "chapter_id": 1734, "verse_number": "४-५७-१५", "content_sanskrit": "एतावदुक्त्वा राजा वै ह्यभियानमियेष सः।\nतथा दशसहस्राणि वीराणां हि धनुष्मताम् ।\nअभ्यद्रवंस्तदा पार्थं शलभा इव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033958, "chapter_id": 1734, "verse_number": "४-५७-१६", "content_sanskrit": "वर्मिता वाजिनस्तत्र संभृताश्च पदातिभिः ।\nभीमरूपाश्च मातङ्गास्तोमराङ्कुशपाणिभिः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033959, "chapter_id": 1734, "verse_number": "४-५७-१७", "content_sanskrit": "अधिष्ठिताः सुसंयत्तैर्हस्तिशिक्षाविशारदैः।\nअभ्यद्रवन्सुसंक्रुद्धाश्चापहस्तोद्यतायुधाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033960, "chapter_id": 1734, "verse_number": "४-५७-१८", "content_sanskrit": "पञ्च चैनं रथोदग्रास्त्वरिताः पर्यवारयन्।\nद्रोणो भीष्मश्च कर्णश्च कुरुराजश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033961, "chapter_id": 1734, "verse_number": "४-५७-१९", "content_sanskrit": "अश्वत्थामा महाबाहुर्धनुर्वेदपरायणः।\nइषूंश्च सम्यगस्यन्तो जीमूता इव वार्षिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033962, "chapter_id": 1734, "verse_number": "४-५७-२०", "content_sanskrit": "ते लाभमिव मन्वानाः प्रत्यगृह्णन्धनंजयम्।\nशरौघानभिवर्षन्तो नादयन्तो दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033963, "chapter_id": 1734, "verse_number": "४-५७-२१", "content_sanskrit": "ततः प्रहस्य बीभत्सुः कौन्तेयः श्वेतवाहनः।\nदिव्यमस्त्रं प्रकुर्वाणः प्रत्ययाद्रथिसत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033964, "chapter_id": 1734, "verse_number": "४-५७-२२", "content_sanskrit": "यथा रश्मिभिरादित्यः प्रच्छादयति मेदिनीम्।\nतथा गाण्डीवनिर्मुक्तैः शरैराच्छादयद्दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033965, "chapter_id": 1734, "verse_number": "४-५७-२३", "content_sanskrit": "न रथानां न चाश्वानां न ध्वजानां न वर्मिणाम्।\nअतिविद्धैः शितैर्बाणैरासीदद्व्यङ्गुलिरन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033966, "chapter_id": 1734, "verse_number": "४-५७-२४", "content_sanskrit": "दैवयोगाद्धि पार्थस्य हयानामुत्तरस्य च।\nशिक्षाबलोपपन्नत्वादस्त्राणां वै परिक्रमात्।\nध्वजगाण्डीवयोश्चापि दैव्या शक्त्या च मायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033967, "chapter_id": 1734, "verse_number": "४-५७-२५", "content_sanskrit": "इतस्ततश्च संयाने दूरे वाऽप्यथवाऽन्तिके।\nदुर्गे विषमजाते वा स्थले निम्ने तथा क्षितौ।\nन च रुध्येद्गतिस्तस्य रथस्य मनसो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033968, "chapter_id": 1734, "verse_number": "४-५७-२६", "content_sanskrit": "समरेषु तु विद्वांसस्तस्य तांस्तान्परिक्रमान्।\nवीर्यमत्यद्भुतं दृष्ट्वा तथा पार्थस्य तद्बलम् ।\nत्रेसुरेवं परे भीताः पराङ्मुखरथा अपि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033969, "chapter_id": 1734, "verse_number": "४-५७-२७", "content_sanskrit": "कालाग्निमिव बीभत्सुं निर्दहन्तमिव प्रजाः ।\nनारयः प्रेक्षितुं शेकुर्ज्वलन्तमिव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2033970, "chapter_id": 1734, "verse_number": "४-५७-२८", "content_sanskrit": "तानि भिन्नान्यनीकानि रेजुरर्जुनमार्गणैः।\nतिग्मांशोश्च घनाभ्राणि व्याप्तानीव गभस्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2033971, "chapter_id": 1734, "verse_number": "४-५७-२९", "content_sanskrit": "अशोकाना वनानीव सञ्चितैः कुसुमैः शुभैः ।\nपार्थः संरञ्जयामास रुधिरेणाकुलं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2033972, "chapter_id": 1734, "verse_number": "४-५७-३०", "content_sanskrit": "सहस्रशोऽर्जुनशरैश्छिन्नान्युच्चावचानि च।\nछत्राणि च पताकाश्च खेऽभ्युवाह सदागतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2033973, "chapter_id": 1734, "verse_number": "४-५७-३१", "content_sanskrit": "ये ह्यर्जुनबलत्रस्ताः परिपेतुर्दिशो दश।\nरथात्तं देशमुत्सृज्य पार्थच्छिन्नयुगा हयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2033974, "chapter_id": 1734, "verse_number": "४-५७-३२", "content_sanskrit": "निकृत्तपूर्वचरणास्ते निपेतुः शितैः शरैः।\nशिरोभिः प्रथमं जग्मुर्मेदिनीं जघनैर्हयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2033975, "chapter_id": 1734, "verse_number": "४-५७-३३", "content_sanskrit": "चक्षुर्नासाविषाणेषु दन्तवेष्टेषु च द्विपान्।\nमर्मस्वन्येषु चाहत्य तथा निघ्नन्गजोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2033976, "chapter_id": 1734, "verse_number": "४-५७-३४", "content_sanskrit": "कौरवाणां गजानां च शरीरैर्गतचेतसाम् ।\nक्षणेन संवृता भूमिर्मेघैरिव नभस्थलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2033977, "chapter_id": 1734, "verse_number": "४-५७-३५", "content_sanskrit": "अस्त्रैर्दिव्यैर्महाबाहुरर्जुनः प्रहसन्निव ।\nबडबामुखसंभूतः कालाग्निरिव संवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2033978, "chapter_id": 1734, "verse_number": "४-५७-३६", "content_sanskrit": "यथा युगान्तसमये सर्वं स्थावरजङ्गमम् ।\nकालपक्वमशेषेण धक्ष्येदुग्रशिखः शिखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2033979, "chapter_id": 1734, "verse_number": "४-५७-३७", "content_sanskrit": "तद्वत्पार्थोऽस्रतेजोभिर्धनुषो निस्वनेन च।\nदैवाद्वीर्याच्च बीभत्सुस्तस्मिन्दौर्योधने बले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2033980, "chapter_id": 1734, "verse_number": "४-५७-३८", "content_sanskrit": "रणे शक्तिममित्राणां प्रणीयोपनिनाय सः।\nचेष्टां प्रायेण भूतानां रात्रिः प्राणभृतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2033981, "chapter_id": 1734, "verse_number": "४-५७-३९", "content_sanskrit": "सोऽतीयात्सहसा शत्रून्सहसा तेऽभिपेदिरे ।\nशीघ्रादूरं दृढामोघमस्त्रमस्यातिमानुषम् ।\nदृष्ट्वा ते कौरवा भीता अतिमानुषविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2033982, "chapter_id": 1734, "verse_number": "४-५७-४०", "content_sanskrit": "खगपत्राभिसंवीतैः खाविष्टैः खगमैरिव।\nअर्जुनस्य खमावव्रे लोहितप्राणपैः खगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2033983, "chapter_id": 1734, "verse_number": "४-५७-४१", "content_sanskrit": "अर्जुनेन विनिर्मुक्ताः शरा गाण्डीवधन्वना ।\nतार्क्ष्यवेगा इवाकाशे ससञ्जुः परमर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2033984, "chapter_id": 1734, "verse_number": "४-५७-४२", "content_sanskrit": "वर्माणि सारथिश्चैव हेमजालानि वाजिनाम् ।\nकिरीटं सूर्यसंकाशं वैयाघ्रमथ चर्म च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2033985, "chapter_id": 1734, "verse_number": "४-५७-४३", "content_sanskrit": "ततः सर्वाणि गात्राणि रथस्य द्विषतां शरैः ।\nनीहारेणेव भूतानि छन्नानीह चकाशिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2033986, "chapter_id": 1734, "verse_number": "४-५७-४४", "content_sanskrit": "सकृदेव न तं शेकुः कथमभ्यसितुं परे ।\nअनभ्यस्तः पुनस्तैर्हि रथः सोभिपपात तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2033987, "chapter_id": 1734, "verse_number": "४-५७-४५", "content_sanskrit": "तच्छरा द्विट्शरीरेषु यथा च न ससञ्जिरे ।\nद्विधाऽनीकेषु बीभत्सोर्न ससञ्ज रथस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2033988, "chapter_id": 1734, "verse_number": "४-५७-४६", "content_sanskrit": "स तद्धि क्षोभयामास विगाह्यारिबलं रथी।\nअनन्तवेगो भुजगः क्रीडन्निव महार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2033989, "chapter_id": 1734, "verse_number": "४-५७-४७", "content_sanskrit": "अस्यतो नित्यमत्यर्थं सर्वघोषाधिकस्तथा ।\nसंनादः श्रूयते भूतैर्धनुषश्च किरीटिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2033990, "chapter_id": 1734, "verse_number": "४-५७-४८", "content_sanskrit": "संच्छिन्नास्तत्र मातङ्गा बाणैरल्पान्तरान्तरैः।\nसंस्यूतास्तत्र दृश्यन्ते मेघा इव गभस्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2033991, "chapter_id": 1734, "verse_number": "४-५७-४९", "content_sanskrit": "दिशोऽनुभ्रमतः सर्वा सव्यदक्षिणमस्यतः।\nसततं दृश्यते युद्धे सायकासनमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2033992, "chapter_id": 1734, "verse_number": "४-५७-५०", "content_sanskrit": "पतन्त्यरूपेषु यथा चक्षूंषि न कदाचन।\nनालक्ष्येषु शराः पेतुस्तस्य गाण्डीवधन्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2033993, "chapter_id": 1734, "verse_number": "४-५७-५१", "content_sanskrit": "महागजसहस्रस्य युगपन्मृद्गतो वनम्।\nकौन्तेयरथमार्गस्तु रणे घोरतरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2033994, "chapter_id": 1734, "verse_number": "४-५७-५२", "content_sanskrit": "नूनं पार्थजयैषित्वाच्छक्रः सर्वामरैः सह।\nहन्त्यस्मानिति मन्यन्ते पार्थेनैवार्दिताः परे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2033995, "chapter_id": 1734, "verse_number": "४-५७-५३", "content_sanskrit": "घ्नन्तमत्यर्थमहितान्सव्यसाचिनमाहवे।\nकालमर्जुनरूपेण ग्रसन्तमिव च प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2033996, "chapter_id": 1734, "verse_number": "४-५७-५४", "content_sanskrit": "कुरुसेनाशरीराणि पार्थेनानाहतान्यपि ।\nपेतुः पार्थहतानीव पार्थकर्मानुदर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2033997, "chapter_id": 1734, "verse_number": "४-५७-५५", "content_sanskrit": "ओषधीनां शिरांसीव कालपक्तिसमन्वयात्।\nअवनेमुः कुरूणां हि शिरांस्यर्जुनजाद्भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2033998, "chapter_id": 1734, "verse_number": "४-५७-५६", "content_sanskrit": "चकार चार्जुनः क्रोधाद्विमुखान्रुषितानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2033999, "chapter_id": 1734, "verse_number": "४-५७-५७", "content_sanskrit": "अर्जुनेनापि भिन्नानि बलाग्नाणि पुनः क्वचित्।\nचक्रुर्लोहितधाराभिर्धरणीं लोहितोत्तराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2034000, "chapter_id": 1734, "verse_number": "४-५७-५८", "content_sanskrit": "लोहितेनापि संपृक्तैः पांसुभिः पवनोद्धतैः ।\nतेनैव च समुद्धूतैः सूक्ष्मैर्लोहितबिन्दुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2034001, "chapter_id": 1734, "verse_number": "४-५७-५९", "content_sanskrit": "लोहितार्द्रैः प्रहरणैः प्रभग्ना लोहितोक्षिताः।\nलोहितेषु निमग्नास्ते निहताश्च किरीटिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2034002, "chapter_id": 1734, "verse_number": "४-५७-६०", "content_sanskrit": "बभूवुर्लोहितास्तत्र भृशमादित्यरश्मयः।\nआकाशं तत्क्षणेनासीत्सन्ध्याभ्रमिव लोहितं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2034003, "chapter_id": 1734, "verse_number": "४-५७-६१", "content_sanskrit": "अप्यस्तं प्राप्य चादित्यो निवर्तेत न पाण्डवः।\nनिवर्तन्ते न जित्वारिं नित्यजल्पविचक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2034004, "chapter_id": 1734, "verse_number": "४-५७-६२", "content_sanskrit": "तान्सर्वान्समरे शूरान्पौरुषे पर्यवस्थितान्।\nदिव्यैरस्त्रैरमोघात्मा सर्वानार्च्छद्धनुर्धरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2034005, "chapter_id": 1734, "verse_number": "४-५७-६३", "content_sanskrit": "स तु द्रोणं त्रिसप्तत्या नाराचानां समार्पयत्।\nअशीत्या शकुनिं चैव द्रौणिमप्याशु सप्तभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2034006, "chapter_id": 1734, "verse_number": "४-५७-६४", "content_sanskrit": "दुःसहं दशभिर्बाणैरर्जुनः समविध्यत ।\nदुश्यासनं द्वादशभिः कृपं शारद्वतं त्रिभिः।\nभीष्मं शान्तनवं षष्ट्या प्रत्यविध्यत्स्तनान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2034007, "chapter_id": 1734, "verse_number": "४-५७-६५", "content_sanskrit": "स कर्णं कर्णिनाऽविध्यत्पीतेन निशितेन च।\nवासविर्द्विषतां मध्ये विव्याध परमेषुणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2034008, "chapter_id": 1734, "verse_number": "४-५७-६६", "content_sanskrit": "स कर्णं सतनुत्राणं निर्भिद्य निशितः शरः।\nअगच्छद्दानयन्भूमिं चोदितो दृढधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2034009, "chapter_id": 1734, "verse_number": "४-५७-६७", "content_sanskrit": "ततोऽस्य वाहान्व्यहनच्चतुर्भिश्चतुरः क्षुरैः ।\nसारथेश्च शिरः कायादपाहरदरिन्दमः ।\nअर्धचन्द्रेण चिच्छेद चापं तस्य करे स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2034010, "chapter_id": 1734, "verse_number": "४-५७-६८", "content_sanskrit": "तस्मिन्विद्धे महाभागे कर्णे सर्वास्त्रपारगे।\nहताश्वसूते विरथे ततोऽनीकमभज्यत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2034011, "chapter_id": 1734, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि सप्तपञ्चाशोऽध्यायः ॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]