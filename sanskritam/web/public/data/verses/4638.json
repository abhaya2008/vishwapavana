[{"id": 2170342, "chapter_id": 4638, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2170343, "chapter_id": 4638, "verse_number": "१", "content_sanskrit": "निवृत्ते भीमसेने च पाण्डवे च युधिष्ठिरे ।\nवध्यमाने बले चापि मामके पाण्डुसृञ्जयैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2170344, "chapter_id": 4638, "verse_number": "२", "content_sanskrit": "द्रवमाणे बलौघे च निरानन्दे मुहुर्मुहुः ।\nकिमकुर्वन्त कुरवस्तन्ममाचक्ष्व सञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2170345, "chapter_id": 4638, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2170346, "chapter_id": 4638, "verse_number": "३", "content_sanskrit": "दृष्ट्वा भीमं महाबाहुं सूतपुत्रः प्रतापवान् ।\nक्रोधरक्तेक्षणो राजन् भीमसेनमुपाद्रवत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2170347, "chapter_id": 4638, "verse_number": "४", "content_sanskrit": "तावकं च बलं दृष्ट्वा भीमसेनात् पराङ्मुखम् ।\nयत्नेन महता राजन् पर्यवस्थापयद् बली\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2170348, "chapter_id": 4638, "verse_number": "५", "content_sanskrit": "व्यवस्थाप्य महाबाहुस्तव पुत्रस्य वाहिनीम् ।\nप्रत्युद्ययौ तदा कर्णः पाण्डवान् युद्धदुर्मदान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2170349, "chapter_id": 4638, "verse_number": "६", "content_sanskrit": "प्रत्युद्ययुस्तु राधेयं पाण्डवानां महारथाः ।\nधुन्वानाः कार्मुकाण्याजौ विक्षिपन्तश्च सायकान्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2170350, "chapter_id": 4638, "verse_number": "७", "content_sanskrit": "भीमसेनः शिनेर्नप्ता शिखण्डी जनमेजयः ।\nधृष्टद्युम्नश्च बलवान् सर्वे चापि प्रभद्रकाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2170351, "chapter_id": 4638, "verse_number": "८", "content_sanskrit": "जिघांसन्तो नरव्याघ्राः समन्तात् तव वाहिनीम् ।\nअभ्यद्रवन्त सङ्क्रुद्धाः समरे जितकाशिनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2170352, "chapter_id": 4638, "verse_number": "९", "content_sanskrit": "तथैव तावका राजन् पाण्डवानामनीकिनीम् ।\nअभ्यद्रवन्त त्वरिता जिघांसन्तो महारथाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2170353, "chapter_id": 4638, "verse_number": "१०", "content_sanskrit": "रथनागाश्वकलिलं पत्तिध्वजसमाकुलम् ।\nबभूव पुरुषव्याघ्र सैन्यमद्भुतदर्शनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2170354, "chapter_id": 4638, "verse_number": "११", "content_sanskrit": "शिखण्डी च ययौ कर्णं धृष्टद्युम्नः सुतं तव ।\nदुःशासनं महाराज महत्या सेनया वृतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2170355, "chapter_id": 4638, "verse_number": "१२", "content_sanskrit": "नकुलो वृषसेनं च चित्रसेनं युधिष्ठिरः ।\nउलूकं समरे राजन् सहदेवः समभ्ययात्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2170356, "chapter_id": 4638, "verse_number": "१३", "content_sanskrit": "सात्यकिः शकुनिं चापि भीमसेनश्च कौरवान् ।\nअर्जुनं च रणे यत्तं द्रोणपुत्रो महारथः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2170357, "chapter_id": 4638, "verse_number": "१४", "content_sanskrit": "युधामन्युं महेष्वासं गौतमोऽभ्यपतद् रणे ।\nकृतवर्मा च बलवानुत्तमौजसमाद्रवत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2170358, "chapter_id": 4638, "verse_number": "१५", "content_sanskrit": "भीमसेनः कुरून् सर्वान् पुत्रांश्च तव मारिष ।\nसहानीकान् महाबाहुरेक एवाभ्यवारयत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2170359, "chapter_id": 4638, "verse_number": "१६", "content_sanskrit": "शिखण्डी च ततः कर्णं विचरन्तमभीतवत् ।\nभीष्महन्ता महाराज वारयामास पत्रिभिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2170360, "chapter_id": 4638, "verse_number": "१७", "content_sanskrit": "प्रतिरुद्धस्ततः कर्णो रोषात् प्रस्फुरिताधरः ।\nशिखण्डिनं त्रिभिर्बाणैर्भ्रुवोर्मध्ये व्यताडयत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2170361, "chapter_id": 4638, "verse_number": "१८", "content_sanskrit": "धारयंस्तु स तान् बाणान् शिखण्डी बह्वशोभत ।\nराजतः पर्वतो यद्वत्त्रिभिः शृङ्गैः समुच्छ्रितैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2170362, "chapter_id": 4638, "verse_number": "१९", "content_sanskrit": "सोऽतिविद्धो महेष्वासः सूतपुत्रेण संयुगे ।\nकर्णं विव्याध समरे नवत्या निशितैः शरैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2170363, "chapter_id": 4638, "verse_number": "२०", "content_sanskrit": "तस्य कर्णो हयान् हत्वा सारथिं च त्रिभिः शरैः ।\nउन्ममाथ ध्वजं चास्य क्षुरप्रेण महारथः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2170364, "chapter_id": 4638, "verse_number": "२१", "content_sanskrit": "हताश्वात्तु ततो यानादवप्लुत्य महारथः ।\nशक्तिं चिक्षेप कर्णाय सङ्क्रुद्धः शत्रुतापनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2170365, "chapter_id": 4638, "verse_number": "२२", "content_sanskrit": "तां छित्त्वा समरे कर्णस्त्रिभिर्भारत सायकैः ।\nशिखण्डिनमथाविध्यन्नवभिर्निशितैः शरैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2170366, "chapter_id": 4638, "verse_number": "२३", "content_sanskrit": "कर्णचापच्युतान् बाणान् वर्जयंस्तु नरोत्तमः ।\nअपयातस्ततस्तूर्णं शिखण्डी जयतां वरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2170367, "chapter_id": 4638, "verse_number": "२४", "content_sanskrit": "ततः कर्णो महाराज पाण्डुसैन्यमशातयत् ।\nतूलराशिं समासाद्य यथा वायुर्महाजवः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2170368, "chapter_id": 4638, "verse_number": "२५", "content_sanskrit": "धृष्टद्युम्नो महाराज तव पुत्रेण पीडितः ।\nदुःशासनं त्रिभिर्बाणैरभ्यविध्यत्स्तनान्तरे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2170369, "chapter_id": 4638, "verse_number": "२६", "content_sanskrit": "तस्य दुःशासनो बाहुं सव्यं विव्याध मारिष ।\nशितेन रुग्मपुङ्खेन भल्लेन नतपर्वणा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2170370, "chapter_id": 4638, "verse_number": "२७", "content_sanskrit": "धृष्टद्युम्नस्तु निर्विद्धः शरं घोरममर्षणः ।\nदुःशासनाय सङ्क्रुद्धः प्रेषयामास भारत\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2170371, "chapter_id": 4638, "verse_number": "२८", "content_sanskrit": "आपतन्तं महावेगं धृष्टद्युम्नसमीरितम् ।\nशरैश्छिच्छेद पुत्रस्ते त्रिभिरेव विशाम्पते\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2170372, "chapter_id": 4638, "verse_number": "२९", "content_sanskrit": "अथापरैः सप्तदशैर्भल्लैः कनकभूषणैः ।\nधृष्टद्युम्नं समासाद्य बाह्वोरुरसि चार्दयत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2170373, "chapter_id": 4638, "verse_number": "३०", "content_sanskrit": "ततः स पार्षतः क्रुद्धो धनुश्चिच्छेद मारिष ।\nक्षुरप्रेण सुतीक्ष्णेन तत उच्चुक्रुशुर्जनाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2170374, "chapter_id": 4638, "verse_number": "३१", "content_sanskrit": "अथान्यद्धनुरादाय पुत्रस्ते भरतर्षभ ।\nधृष्टद्युम्नं शरव्रातैः समन्तात् पर्यवारयत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2170375, "chapter_id": 4638, "verse_number": "३२", "content_sanskrit": "तव पुत्रस्य ते दृष्ट्वा विक्रमं तं महात्मनः ।\nविस्मयन्त रणे योधाः सिद्धाश्चाप्सरसां गणाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2170376, "chapter_id": 4638, "verse_number": "३३", "content_sanskrit": "ततः प्रववृते युद्धं तावकानां परैः सह ।\nघोरे प्राणभृतां काले घोररूपं परन्तप\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2170377, "chapter_id": 4638, "verse_number": "३४", "content_sanskrit": "नकुलं वृषसेनस्तु विद्ध्वा पञ्चभिरायसैः ।\nपितुः समीपे तिष्ठंस्तं त्रिभिर्भूयोऽप्यविध्यत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2170378, "chapter_id": 4638, "verse_number": "३५", "content_sanskrit": "नकुलस्तु ततः क्रुद्धो वृषसेनं स्मयन्निव ।\nनाराचेन सुतीक्ष्णेन विव्याध हृदये दृढम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2170379, "chapter_id": 4638, "verse_number": "३६", "content_sanskrit": "सोऽतिविद्धो बलवता शत्रुणा शत्रुकर्शनः ।\nशत्रुं विव्याध विंशत्या स च तं पञ्चभिः शरैः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2170380, "chapter_id": 4638, "verse_number": "३७", "content_sanskrit": "ततः शरसहस्रेण तावुभौ पुरुषर्षभौ ।\nअन्योन्यमाच्छादयतामथाभज्यत भारती\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2170381, "chapter_id": 4638, "verse_number": "३८", "content_sanskrit": "दृष्ट्वा तु प्रद्रुतां सेनां धार्तराष्ट्रस्य सूतजः ।\nनिवारयामास बलादनुसृत्य विशाम्पते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2170382, "chapter_id": 4638, "verse_number": "३९", "content_sanskrit": "निवृत्ते तु ततः कर्णे नकुलः कौरवान् ययौ\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2170383, "chapter_id": 4638, "verse_number": "४०", "content_sanskrit": "कर्णपुत्रस्तु समरे हित्वा नकुलमेव तु ।\nजुगोप चक्रं त्वरितं राधेयस्यैव मारिष\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2170384, "chapter_id": 4638, "verse_number": "४१", "content_sanskrit": "उलूकस्तु रणे क्रुद्धः सहदेवेन वारितः ।\nतस्याश्वांश्चतुरो हत्वा सहदेवः प्रतापवान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2170385, "chapter_id": 4638, "verse_number": "४२", "content_sanskrit": "सारथिं प्रेषयामास यमस्य सदनं प्रति\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2170386, "chapter_id": 4638, "verse_number": "४३", "content_sanskrit": "उलूकस्तु ततो यानादवप्लुत्य विशाम्पते ।\nत्रिगर्तानां बलं पूर्णं जगाम पितृनन्दनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2170387, "chapter_id": 4638, "verse_number": "४४", "content_sanskrit": "सात्यकिः शकुनिं विद्ध्वा विंशत्या निशितैः शरैः ।\nध्वजं चिच्छेद भल्लेन सौबलस्य हसन्निव\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2170388, "chapter_id": 4638, "verse_number": "४५", "content_sanskrit": "सौबलस्तस्य समरे क्रुद्धो राजन् प्रतापवान् ।\nविदार्य कवचं भूयो ध्वजं चिच्छेद काञ्चनम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2170389, "chapter_id": 4638, "verse_number": "४६", "content_sanskrit": "अथैनं निशितैर्बाणैः सात्यकिः प्रत्यविध्यत ।\nसारथिं च महाराज त्रिभिरेव समार्दयत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2170390, "chapter_id": 4638, "verse_number": "४७", "content_sanskrit": "अथास्य वाहांस्त्वरितः शरैर्निन्ये यमक्षयम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2170391, "chapter_id": 4638, "verse_number": "४८", "content_sanskrit": "ततोऽवप्लुत्य सहसा शकुनिर्भरतर्षभ ।\nआरुरोह रथं तूर्णमुलूकस्य महारथः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2170392, "chapter_id": 4638, "verse_number": "४९", "content_sanskrit": "अपोवाहाथ शीघ्रं स शैनेयाद् युद्धशालिनः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2170393, "chapter_id": 4638, "verse_number": "५०", "content_sanskrit": "सात्यकिस्तु रणे राजन् तावकानामनीकिनीम् ।\nअभिदुद्राव वेगेन ततोऽनीकमभिद्यत\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2170394, "chapter_id": 4638, "verse_number": "५१", "content_sanskrit": "शैनेयशरनुन्नं तु ततः सैन्यं विशाम्पते ।\nभेजे दश दिशस्तूर्णं न्यपतच्च गतासुवत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2170395, "chapter_id": 4638, "verse_number": "५२", "content_sanskrit": "भीमसेनं तव सुतो वारयामास संयुगे ।\nतं तु भीमो मुहूर्तेन व्यश्वसूतरथध्वजम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2170396, "chapter_id": 4638, "verse_number": "५३", "content_sanskrit": "चक्रे लोकेश्वरं तत्र तेनातुष्यन्त चारणाः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2170397, "chapter_id": 4638, "verse_number": "५४", "content_sanskrit": "ततोऽपायान्नृपस्तत्र भीमसेनस्य गोचरात् ।\nकुरुसैन्यं ततः सर्वं भीमसेनमुपाद्रवत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2170398, "chapter_id": 4638, "verse_number": "५५", "content_sanskrit": "तत्र रावो महानासीद् भीममेकं जिघांसताम्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2170399, "chapter_id": 4638, "verse_number": "५६", "content_sanskrit": "युधामन्युः कृपं विद्ध्वा धनुरस्याशु चिच्छिदे ।\nअथान्यद्धनुरादाय कृपः शस्त्रभृतां वरः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2170400, "chapter_id": 4638, "verse_number": "५७", "content_sanskrit": "युधामन्योर्ध्वजं सूतं छत्रं चापातयत् क्षितौ ।\nततोऽपायाद् रथेनैव युधामन्युर्महारथः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2170401, "chapter_id": 4638, "verse_number": "५८", "content_sanskrit": "उत्तमौजास्तु हार्दिक्यं शरैर्भीमपराक्रमम् ।\nछादयामास सहसा मेघो वृष्ट्येव पर्वतम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2170402, "chapter_id": 4638, "verse_number": "५९", "content_sanskrit": "तद्युद्धं सुमहच्चासीद् घोररूपं परन्तप ।\nयादृशं न मया युद्धं दृष्टपूर्वं विशाम्पते\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2170403, "chapter_id": 4638, "verse_number": "६०", "content_sanskrit": "कृतवर्मा ततो राजन्नुत्तमौजसमाहवे ।\nहृदि विव्याध स तदा रथोपस्थ उपाविशत्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2170404, "chapter_id": 4638, "verse_number": "६१", "content_sanskrit": "सारथिस्तमपोवाह रथेन रथिनां वरम् ।\nततस्तु सात्वतो राजन् पाण्डुसैन्यमुपाद्रवत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2170405, "chapter_id": 4638, "verse_number": "६२", "content_sanskrit": "दुःशासनः सौबलश्च गजानीकेन पाण्डवम् ।\nमहता परिवार्यैव क्षुरप्रैरभ्यताडयत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2170406, "chapter_id": 4638, "verse_number": "६३", "content_sanskrit": "ततो भीमः शरशतैर्दुर्योधनममर्षणम् ।\nविमुखीकृत्य तरसा गजानीकमुपाद्रवत्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2170407, "chapter_id": 4638, "verse_number": "६४", "content_sanskrit": "तमापतन्तं सहसा गजानीकं वृकोदरः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2170408, "chapter_id": 4638, "verse_number": "६५", "content_sanskrit": "गजैर्गजानभ्यहनद् वज्रेणेन्द्र इवासुरान् ।\nशलभानिव नागांस्तान् अर्दयामास पाण्डवः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2170409, "chapter_id": 4638, "verse_number": "६६", "content_sanskrit": "छादयामास समरे गजान्निघ्नन् वृकोदरः ।\nततः कुञ्जरयूथानि समेतानि सहस्रशः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2170410, "chapter_id": 4638, "verse_number": "६७", "content_sanskrit": "व्यधमत् तरसा भीमो मेघसङ्घानिवानिलः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2170411, "chapter_id": 4638, "verse_number": "६८", "content_sanskrit": "सुवर्णजालापिहिता मणिजालैश्च कुञ्जराः ।\nरेजुरभ्यधिकं सङ्खे विद्युत्वन्त इवाम्बुदाः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2170412, "chapter_id": 4638, "verse_number": "६९", "content_sanskrit": "ते वध्यमाना भीमेन गजा राजन् विदुद्रुवुः ।\nकेचिद् विभिन्नहृदयाः कुञ्जरा न्यपतन्भुवि\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2170413, "chapter_id": 4638, "verse_number": "७०", "content_sanskrit": "पतितैर्निपतद्भिश्च गजैर्हेमविभूषितैः ।\nअशोभत मही तत्र विशीर्णैरिव पर्वतैः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2170414, "chapter_id": 4638, "verse_number": "७१", "content_sanskrit": "दीप्ताभरणवद्भिश्च पतितैर्गजयोधिभिः ।\nरराज भूमिः पतितैः क्षीणपुण्यैरिवामरैः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2170415, "chapter_id": 4638, "verse_number": "७२", "content_sanskrit": "ततो भिन्नकटा नागा भिन्नकुम्भकरास्तथा ।\nदुद्रुवुः शतशः सङ्खे भीमसेनशराहताः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2170416, "chapter_id": 4638, "verse_number": "७३", "content_sanskrit": "केचिद् वमन्तो रुधिरं भयार्ताः पर्वतोपमाः ।\nव्यद्रवन् शरविद्धाङ्गा धातुचित्रा इवाचलाः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2170417, "chapter_id": 4638, "verse_number": "७४", "content_sanskrit": "महाभुजगसङ्काशौ चन्दनागरुरूषितौ ।\nअपश्यं भीमसेनस्य धनुर्विक्षिपतो भुजौ\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2170418, "chapter_id": 4638, "verse_number": "७५", "content_sanskrit": "तस्य ज्यातलनिर्घोषं श्रुत्वाशनिसमस्वनम् ।\nविमुञ्चन्तः शकृन्मूत्रं गजाः प्रादुद्रुवुर्भृशम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2170419, "chapter_id": 4638, "verse_number": "७६", "content_sanskrit": "भीमसेनस्य तत्कर्म राजन्नेकस्य निर्बभौ ।\nनिघ्नतः सर्वभूतानि रुद्रस्येव निजं बभौ\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2170420, "chapter_id": 4638, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nअष्टपञ्चाशोऽध्यायः ॥५८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]