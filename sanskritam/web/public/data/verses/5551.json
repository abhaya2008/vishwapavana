[{"id": 2213205, "chapter_id": 5551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213206, "chapter_id": 5551, "verse_number": "१", "content_sanskrit": "एवं गते कौरवेन्द्रे दुःखशोकसमाहताः ।\nबभूवुः पाण्डवा राजन् मातृशोकेन चार्दिताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213207, "chapter_id": 5551, "verse_number": "२", "content_sanskrit": "तथा पौरजनाः सर्वे शोचन्तस्तं नराधिपम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213208, "chapter_id": 5551, "verse_number": "३", "content_sanskrit": "तत्र तत्र कथा ह्यासन् द्विजानां कौरवान् प्रति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213209, "chapter_id": 5551, "verse_number": "", "content_sanskrit": "द्विजाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213210, "chapter_id": 5551, "verse_number": "४", "content_sanskrit": "कथं नु राजा वृद्धः स वने वसति निर्जने ।\nगान्धारी च महाभागा सा च कुन्ती पृथा कथम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213211, "chapter_id": 5551, "verse_number": "५", "content_sanskrit": "सुखार्हः स हि राजर्षिः असुखी तन्महावनम् ।\nकिमवस्थः समासाद्य प्रज्ञाचक्षुर्महामनाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213212, "chapter_id": 5551, "verse_number": "६", "content_sanskrit": "सुदुष्करं कृतवती कुन्ती पुत्रानपास्य सा ।\nराज्यश्रियं च सन्त्यज्य वनवासमरोचयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213213, "chapter_id": 5551, "verse_number": "७", "content_sanskrit": "विदुरः किमवस्थश्च भ्रातुः शुश्रूषुरात्मवान् ।\nस वै गावल्गणिर्धीमान् भर्तृपिण्डानुपालकः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213214, "chapter_id": 5551, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213215, "chapter_id": 5551, "verse_number": "८", "content_sanskrit": "आकुमारं च पौरास्ते चिन्ताशोकपरायणाः ।\nतत्र तत्र कथाञ्चक्रुः समासाद्य परस्परम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213216, "chapter_id": 5551, "verse_number": "९", "content_sanskrit": "पाण्डवश्चापि ते सर्वे भृशं शोकपरायणाः ।\nशोचन्तो मातरं वृद्धामूषुर्नातिचिरं पुरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213217, "chapter_id": 5551, "verse_number": "१०", "content_sanskrit": "तथैव वृद्धं पितरं हतपुत्रं जनेश्वरम् ।\nगान्धारीं च महाभागां विदुरं च महामतिम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213218, "chapter_id": 5551, "verse_number": "११", "content_sanskrit": "तेषां भोगेष्वभूत् प्रीतिर्न तांश्चिन्तयतां तदा ।\nन राज्ये न च नारीषु न वेदाध्ययने तथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213219, "chapter_id": 5551, "verse_number": "१२", "content_sanskrit": "परं निर्वेदमगमन् चिन्तयन्तो नराधिपम् ।\nतं च ज्ञातिवधं घोरं संस्मरन्तः पुनः पुनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213220, "chapter_id": 5551, "verse_number": "१३", "content_sanskrit": "अभिमन्योश्च बालस्य विनाशं रणमूर्धनि ।\nकर्णस्य च महाबाहोः सङ्ग्रामेष्वपलायिनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213221, "chapter_id": 5551, "verse_number": "१४", "content_sanskrit": "तथैव द्रौपदेयानामन्येषां सुहृदामपि ।\nवधं संस्मृत्य ते वीरा नातिप्रमनसोऽभवन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213222, "chapter_id": 5551, "verse_number": "१५", "content_sanskrit": "हतप्रवीरां पृथिवीं हृतरत्नां च भारत ।\nसदैव चिन्तयन्तस्ते न निद्रामुपलेभिरे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213223, "chapter_id": 5551, "verse_number": "१६", "content_sanskrit": "द्रौपदी हतपुत्रा च सुभद्रा चैव भामिनी ।\nनातिप्रीतियुते देव्यौ तदाऽऽस्तामप्रहृष्टवत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213224, "chapter_id": 5551, "verse_number": "१७", "content_sanskrit": "वैराट्यास्तु सुतं दृष्ट्वा पितरं ते परीक्षितम् ।\nधारयन्ति स्म ते प्राणांस्तव पूर्वपितामहाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213225, "chapter_id": 5551, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्रमवासिकपर्वणि पाण्डवशोको नाम सप्तविंशोऽध्यायः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213226, "chapter_id": 5551, "verse_number": "", "content_sanskrit": "आश्रमवासपर्वणि सप्तविंशोऽध्यायः ॥२७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]