[{"id": 2204490, "chapter_id": 5357, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2204491, "chapter_id": 5357, "verse_number": "१", "content_sanskrit": "भगवन् देवदेवेश लोकपालनमस्कृत ।\nप्रसादात् ते महादेव श्रुता मे कर्मणां गतिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2204492, "chapter_id": 5357, "verse_number": "२", "content_sanskrit": "सङ्गृहीतं च तत्सर्वं तत्त्वतोऽमृतसन्निभम् ।\nकर्मणा ग्रथितं सर्वमिति वेद्मि शुभाशुभम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2204493, "chapter_id": 5357, "verse_number": "३", "content_sanskrit": "गोवत्सवच्च जननीं निम्नं सलिलवत् तथा ।\nकर्तारं स्वकृतं कर्म नित्यं तदनुधावति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2204494, "chapter_id": 5357, "verse_number": "४", "content_sanskrit": "कृतस्य कर्मणश्चेह नाशो नास्तीति निश्चयः ।\nअशुभस्य शुभस्यापि तदप्युपगतं मया\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2204495, "chapter_id": 5357, "verse_number": "५", "content_sanskrit": "भूय एव महादेव वरद प्रीतिवर्धन ।\nकर्मणां गतिमाश्रित्य संशयान् मोक्तुमर्हसि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2204496, "chapter_id": 5357, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2204497, "chapter_id": 5357, "verse_number": "६", "content_sanskrit": "यत् ते विवक्षितं देवि गुह्यमप्यसितेक्षणे ।\nतत्सर्वं निर्विशङ्का त्वं पृच्छ मां शुभलक्षणे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2204498, "chapter_id": 5357, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2204499, "chapter_id": 5357, "verse_number": "७", "content_sanskrit": "एवं व्यवस्थिते लोके कर्मणा वृषभध्वज ।\nकृत्वा तत् पुरुषः कर्म शुभं वा यदि वेतरत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2204500, "chapter_id": 5357, "verse_number": "८", "content_sanskrit": "प्रेत्य देव कदा भुङ्क्ते स फलं कर्मणः पुनः ।\nइह वा प्रेत्य वा देव तन्मे शंसितुमर्हसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2204501, "chapter_id": 5357, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2204502, "chapter_id": 5357, "verse_number": "९", "content_sanskrit": "स्थाने संशयितुं देवि तद्धि गुह्यतमं शृणु ।\nत्वत्प्रियार्थं प्रवक्ष्यामि देवि गुह्यं शुभानने\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2204503, "chapter_id": 5357, "verse_number": "१०", "content_sanskrit": "पूर्वदेहकृतं कर्म भुञ्जते तदिह प्रजाः ।\nइहैव यत् कृतं पुंसां तत् परत्र फलिष्यति ।\nएषा व्यवस्थितिर्देवि मानुषेष्वेव दृश्यते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2204504, "chapter_id": 5357, "verse_number": "११", "content_sanskrit": "देवानां च ऋषीणां च अमरत्वात् तपोबलात् ।\nएकेनैव शरीरेण भुज्यते कर्मणां फलम् ।\nमानुषैर्न तथा देवि अन्तरं त्वेतदिष्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2204505, "chapter_id": 5357, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे मानुषाणां देवादीनां च भोगे अन्तरकथनं नाम अष्टोत्तरद्विशततमोऽध्यायः ॥२०८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]