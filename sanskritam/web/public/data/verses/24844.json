[{"id": 7004844000, "chapter_id": 24844, "verse_number": "७-१-२७-१", "content_sanskrit": "ईश्वर उवाच ।\nअथ तत्रैव देवेशि लिंगं गन्धर्वसेनया ।\nस्थापितं घनवाहस्य पुत्र्या गौरीसमीपतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004844001, "chapter_id": 24844, "verse_number": "७-१-२७-२", "content_sanskrit": "धनुषां त्रितये तत्र स्थितं पूर्वविभागतः ।\nविमलेश्वरनामानं सर्वरोगविनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004844002, "chapter_id": 24844, "verse_number": "७-१-२७-३", "content_sanskrit": "पूजयित्वा तृतीयायां दौर्भाग्यैर्मुच्यतेऽङ्गना ।\nसर्वान्कामानवाप्नोति पुत्रपौत्रप्रतिष्ठिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004844003, "chapter_id": 24844, "verse_number": "७-१-२७-४", "content_sanskrit": "इति व्रतं महादेवि त्रेतासंध्यांशके गते ।\nगन्धर्वस्यैवमाख्यातं श्रुतं पातकनाशनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004844004, "chapter_id": 24844, "verse_number": "७-१-२७-५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये गन्धर्वसेनेश्वरमाहात्म्यवर्णनंनाम सप्तविंशोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]