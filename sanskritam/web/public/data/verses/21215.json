[{"id": 7001215000, "chapter_id": 21215, "verse_number": "२-४-८-१", "content_sanskrit": "ब्रह्मोवाच ।\nइति ते वर्णितस्तात देवदानव सेनयोः ।\nसंग्रामस्तुमुलोऽतीव तत्प्रभ्वो शृणु नारद॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001215001, "chapter_id": 21215, "verse_number": "२-४-८-२", "content_sanskrit": "एवं युद्धेऽतितुमुले देवदानवसंक्षये ।\nतारकेणैव देवेन्द्रश्शक्त्या रमया सह॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001215002, "chapter_id": 21215, "verse_number": "२-४-८-३", "content_sanskrit": "सद्यः पपात नागाश्च धरण्यां मूर्च्छितोऽभवत् ।\nपरं कश्मलमापेदे वज्रधारी सुरेश्वरः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001215003, "chapter_id": 21215, "verse_number": "२-४-८-४", "content_sanskrit": "तथैव लोकपास्सर्वेऽसुरैश्च बलवत्तरैः ।\nपराजिता रणे तात महारणविशारदैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001215004, "chapter_id": 21215, "verse_number": "२-४-८-५", "content_sanskrit": "अन्येऽपि निर्जरा दैत्यैर्युद्ध्यमानाः पराजिताः ।\nअसहंतो हि तत्तेजः पलायनपरायणाः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001215005, "chapter_id": 21215, "verse_number": "२-४-८-६", "content_sanskrit": "जगर्जुरसुरास्तत्र जयिनस्सुकृतोद्यमाः ।\nसिंहनादं प्रकुर्वन्तः कोलाहलपरायणाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001215006, "chapter_id": 21215, "verse_number": "२-४-८-७", "content_sanskrit": "एतस्मिन्नंतरे तत्र वीरभद्रो रुषान्वितः ।\nआससाद गणैर्वीरैस्तारकं वीरमानिनम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001215007, "chapter_id": 21215, "verse_number": "२-४-८-८", "content_sanskrit": "निर्जरान् पृष्ठतः कृत्वा शिवकोपोद्भवो बली ।\nतत्सम्मुखो बभूवाथ योद्धुकामो गणाग्रणीः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001215008, "chapter_id": 21215, "verse_number": "२-४-८-९", "content_sanskrit": "तदा ते प्रमथास्सर्वे दैत्याश्च परमोत्सवाः ।\nयुयुधुस्संयुगेऽन्योन्यं प्रसक्ताश्च महारणे॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001215009, "chapter_id": 21215, "verse_number": "२-४-८-१०", "content_sanskrit": "त्रिशूलैरृष्टिभिः पाशैः खड्गैः परशुपट्टिशैः ।\nनिजघ्नुस्समरेऽन्योन्यं रणे रणविशारदाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001215010, "chapter_id": 21215, "verse_number": "२-४-८-११", "content_sanskrit": "तारको वीरभद्रेण स त्रिशूलाहतो भृशम् ।\nपपात सहसा भूमौ क्षणं मूर्छापरिप्लुतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001215011, "chapter_id": 21215, "verse_number": "२-४-८-१२", "content_sanskrit": "उत्थाय स द्रुतं वीरस्तारको दैत्यसत्तमः ।\nलब्धसंज्ञो बलाच्छक्त्या वीरभद्रं जघान ह॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001215012, "chapter_id": 21215, "verse_number": "२-४-८-१३", "content_sanskrit": "वीरभद्रस्तथा वीरो महातेजा हि तारकम् ।\nजघान त्रिशिखेनाशु घोरेण निशितेन तम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001215013, "chapter_id": 21215, "verse_number": "२-४-८-१४", "content_sanskrit": "सोपि शक्त्या वीरभद्रं जघान समरे ततः ।\nतारको दितिजाधीशः प्रबलो वीरसंमतः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001215014, "chapter_id": 21215, "verse_number": "२-४-८-१५", "content_sanskrit": "एवं संयुद्ध्यमानौ तौ जघ्नतुश्चेतरेतरम् ।\nनानास्त्रशस्त्रैस्समरे रणविद्याविशारदौ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001215015, "chapter_id": 21215, "verse_number": "२-४-८-१६", "content_sanskrit": "तयोर्महात्मनोस्तत्र द्वन्द्वयुद्धमभूत्तदा ।\nसर्वेषां पश्यतामेव तुमुलं रोमहर्षणम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001215016, "chapter_id": 21215, "verse_number": "२-४-८-१७", "content_sanskrit": "ततो भेरीमृदंगाश्च पटहानकगोमुखाः ।\nविनेदुर्विहता वीरैश्शृण्वतां सुभयानकाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001215017, "chapter_id": 21215, "verse_number": "२-४-८-१८", "content_sanskrit": "युयुधातेतिसन्नद्धौ प्रहारैर्जर्जरीकृतौ ।\nअन्योन्यमतिसंरब्धौ तौ बुधांगारकाविव॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001215018, "chapter_id": 21215, "verse_number": "२-४-८-१९", "content_sanskrit": "एवं दृष्ट्वा तदा युद्धं वीरभद्रस्य तेन च ।\nतत्र गत्वा वीरभद्रमवोचस्त्वं शिवप्रियः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001215019, "chapter_id": 21215, "verse_number": "२-४-८-२०", "content_sanskrit": "नारद उवाच ।\nवीरभद्र महावीर गणानामग्रणीर्भवान् ।\nनिवर्तस्व रणादस्माद्रोचते न वधस्त्वया॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001215020, "chapter_id": 21215, "verse_number": "२-४-८-२१", "content_sanskrit": "एवं निशम्य त्वद्वाक्यं वीरभद्रो गणाग्रणीः ।\nअवदत्स रुषाविष्टस्त्वां तदा तु कृतांजलिः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001215021, "chapter_id": 21215, "verse_number": "२-४-८-२२", "content_sanskrit": "वीरभद्र उवाच ।\nमुनिवर्य महाप्राज्ञ शृणु मे परमं वचः ।\nतारकं च वधिष्यामि पश्य मेऽद्य पराक्रमम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001215022, "chapter_id": 21215, "verse_number": "२-४-८-२३", "content_sanskrit": "आनयंति च ये वीरास्स्वामिनं रणसंसदि ।\nते पापिनो महाक्लीबा विनश्यन्ति रणं गताः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001215023, "chapter_id": 21215, "verse_number": "२-४-८-२४", "content_sanskrit": "असद्गतिं प्राप्नुवन्ति तेषां च निरयो धुवम् ।\nवीरभद्रो हि विज्ञेयो न वाच्यस्ते कदाचन॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001215024, "chapter_id": 21215, "verse_number": "२-४-८-२५", "content_sanskrit": "शस्त्रास्त्रैर्भिन्नगात्रा ये रणं कुर्वंति निर्भयाः ।\nइहामुत्र प्रशंस्यास्ते लभ्यन्ते सुखमद्भुतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001215025, "chapter_id": 21215, "verse_number": "२-४-८-२६", "content_sanskrit": "शृण्वन्तु मम वाक्यानि देवा हरिपुरोगमाः ।\nअतारकां महीमद्य करिष्ये स्वामिवर्जिताम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001215026, "chapter_id": 21215, "verse_number": "२-४-८-२७", "content_sanskrit": "इत्युक्त्वा प्रमर्थैस्सार्द्धं वीरभद्रो हि शूलधृक् ।\nविचिंत्य मनसा शंभुं युयुधे तारकेण हि॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001215027, "chapter_id": 21215, "verse_number": "२-४-८-२८", "content_sanskrit": "वृषारूढैरनेकैश्च त्रिशूलवरधारिभिः ।\nमहावीरस्त्रिनेत्रैश्च स रेजे रणसंगतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001215028, "chapter_id": 21215, "verse_number": "२-४-८-२९", "content_sanskrit": "कोलाहलं प्रकुर्वंतो निर्भयाश्शतशो गणाः ।\nवीरभद्रं पुरस्कृत्य युयुधुर्दानवैस्सह॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001215029, "chapter_id": 21215, "verse_number": "२-४-८-३०", "content_sanskrit": "असुरास्तेऽपि युयुधुस्तारकासुरजीविनः ।\nबलोत्कटा महावीरा मर्दयन्तो गणान् रुषा॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001215030, "chapter_id": 21215, "verse_number": "२-४-८-३१", "content_sanskrit": "पुनः पुनश्चैव बभूव संगरो महोत्कटो दैत्यवरैर्गणानाम् ।\nप्रहर्षमाणाः परमास्त्रकोविदास्तदा गणास्ते जयिनो बभूवुः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001215031, "chapter_id": 21215, "verse_number": "२-४-८-३२", "content_sanskrit": "गणैर्जितास्ते प्रबलैरसुरा विमुखा रणे ।\nपलायनपरा जाता व्यथिता व्यग्रमानसाः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001215032, "chapter_id": 21215, "verse_number": "२-४-८-३३", "content_sanskrit": "एवं भ्रष्टं स्वसैन्यं तद्दृष्ट्वा तत्पालकोऽसुरः ।\nतारको हि रुषाविष्टो हंतुं देवगणान् ययौ॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001215033, "chapter_id": 21215, "verse_number": "२-४-८-३४", "content_sanskrit": "भुजानामयुतं कृत्वा सिंहमारुह्य वेगतः ।\nपातयामास तान्देवान्गणांश्च रणमूर्द्धनि॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001215034, "chapter_id": 21215, "verse_number": "२-४-८-३५", "content_sanskrit": "स दृष्ट्वा तस्य तत्कर्म वीरभद्रो गणाग्रणीः ।\nचकार सुमहत्कोपं तद्वधाय महाबली॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001215035, "chapter_id": 21215, "verse_number": "२-४-८-३६", "content_sanskrit": "स्मृत्वा शिवपदांभोजं जग्राह त्रिशिखं परम् ।\nजज्वलुस्तेजसा तस्य दिशः सर्वा नभस्तथा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001215036, "chapter_id": 21215, "verse_number": "२-४-८-३७", "content_sanskrit": "एतस्मिन्नन्तरे स्वामी वारयामास तं रणम् ।\nवीरबाहुमुखान्सद्यो महाकौतुकदर्शकः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001215037, "chapter_id": 21215, "verse_number": "२-४-८-३८", "content_sanskrit": "तदाज्ञया वीरभद्रो निवृत्तोऽभूद्रणात्तदा ।\nकोपं चक्रे महावीरस्तारकोऽसुरनायकः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001215038, "chapter_id": 21215, "verse_number": "२-४-८-३९", "content_sanskrit": "चकार बाणवृष्टिं च सुरोपरि तदाऽसुरः ।\nतप्तोऽह्वासीत्सुरान्सद्यो नानास्त्ररणकोविदः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001215039, "chapter_id": 21215, "verse_number": "२-४-८-४०", "content_sanskrit": "एवं कृत्वा महत्कर्म तारकोऽसुरपालकः ।\nसर्वेषामपि देवानामशक्यो बलिनां वरः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001215040, "chapter_id": 21215, "verse_number": "२-४-८-४१", "content_sanskrit": "एवं निहन्यमानांस्तान् दृष्ट्वा देवान् भयाकुलान् ।\nकोपं कृत्वा रणायाशु संनद्धोऽभवदच्युतः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001215041, "chapter_id": 21215, "verse_number": "२-४-८-४२", "content_sanskrit": "चक्रं सुदर्शनं शार्ङ्गं धनुरादाय सायुधः ।\nअभ्युद्ययौ महादैत्यं रणाय भगवान् हरिः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001215042, "chapter_id": 21215, "verse_number": "२-४-८-४३", "content_sanskrit": "ततस्समभवद्युद्धं हरितारकयोर्महत् ।\nलोमहर्षणमत्युग्रं सर्वेषां पश्यतां मुने॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001215043, "chapter_id": 21215, "verse_number": "२-४-८-४४", "content_sanskrit": "गदामुद्यम्य स हरिर्जघानासुरमोजसा ।\nद्विधा चकार तां दैत्यस्त्रिशिखेन महाबली॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001215044, "chapter_id": 21215, "verse_number": "२-४-८-४५", "content_sanskrit": "ततस्स क्रुद्धो भगवान्देवानामभयंकरः ।\nशार्ङ्गच्युतैश्शरव्यूहैर्जघानासुरनायकम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001215045, "chapter_id": 21215, "verse_number": "२-४-८-४६", "content_sanskrit": "सोऽपि दैत्यो महावीरस्तारकः परवीरहा ।\nचिच्छेद सकलान्बाणान्स्वशरैर्निशितैर्द्रुतम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001215046, "chapter_id": 21215, "verse_number": "२-४-८-४७", "content_sanskrit": "अथ शक्त्या जघानाशु मुरारिं तारकासुरः ।\nभूमौ पपात स हरिस्तत्प्रहारेण मूर्च्छितः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001215047, "chapter_id": 21215, "verse_number": "२-४-८-४८", "content_sanskrit": "जग्राह स रुषा चक्रमुत्थितः क्षणतोऽच्युतः ।\nसिंहनादं महत्कृत्वा ज्वलज्ज्वालासमाकुलम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001215048, "chapter_id": 21215, "verse_number": "२-४-८-४९", "content_sanskrit": "तेन तञ्च जघानासौ दैत्यानामधिपं हरिः ।\nतत्प्रहारेण महता व्यथितो न्यपतद्भुवि॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001215049, "chapter_id": 21215, "verse_number": "२-४-८-५०", "content_sanskrit": "पुनश्चोत्थाय दैत्येन्द्रस्तारकोऽसुरनायकः ।\nचिच्छेद त्वरितं चक्रं स्वशक्त्यातिबलान्वितः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001215050, "chapter_id": 21215, "verse_number": "२-४-८-५१", "content_sanskrit": "पुनस्तया महाशक्त्या जघानामरवल्लभम् ।\nअच्युतोऽपि महावीरा नन्दकेन जघान तम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001215051, "chapter_id": 21215, "verse_number": "२-४-८-५२", "content_sanskrit": "एवमन्योन्यमसुरो विष्णुश्च बलवानुभौ ।\nयुयुधाते रणे भूरि तत्राक्षतबलौ मुने॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]