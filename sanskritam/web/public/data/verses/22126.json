[{"id": 7002126000, "chapter_id": 22126, "verse_number": "१७१-१", "content_sanskrit": "प्रायश्चित्तानि ।\nपुष्कर उवाच ।\nप्रायश्चित्तं रहस्यादि वक्ष्ये शुद्धिकरं पर ।\nपौरुषेण तु सूक्तेन मासं जप्यादिनाघहा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002126001, "chapter_id": 22126, "verse_number": "१७१-२", "content_sanskrit": "मुच्यते पातकैः सर्वैर्जप्त्वा त्रिरघमर्षणं ।\nवेदजप्याद्वायुयमाद्गायत्र्या व्रततोऽद्यहा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002126002, "chapter_id": 22126, "verse_number": "१७१-३", "content_sanskrit": "मुण्डनं सर्वकृच्छ्रेषु स्नानं होमो हरेर्यजिः ।\nउत्थितस्तु दिवा तिष्ठेदुपविष्टस्तथा निशि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002126003, "chapter_id": 22126, "verse_number": "१७१-४", "content_sanskrit": "एतद्वीरासनं प्रोक्तं कृच्छ्रकृत्तेन पापहा ।\nअष्टभिः प्रत्यहं ग्रासैर्यतिचान्द्रायणं स्मृतं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002126004, "chapter_id": 22126, "verse_number": "१७१-५", "content_sanskrit": "प्रातश्चतुर्भिः सायञ्च शिशुचान्द्रायणं स्मृतं ।\nयथाकथञ्चित्पिण्डानां चत्वारिंशच्छतद्वयं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002126005, "chapter_id": 22126, "verse_number": "१७१-६", "content_sanskrit": "मासेन भक्षयेदेतत्सुरचान्द्रायणं चरेत् ।\nत्र्यहमुष्णं पिवेदापस्त्यहमुष्णं पयः पिबेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002126006, "chapter_id": 22126, "verse_number": "१७१-७", "content_sanskrit": "त्र्याहमुष्णं घृतं पीत्वा वायुभक्षो भवेत्त्र्यहं ।\nतप्तकृच्छ्रमिदं प्रोक्तं शीतैः शीतं प्रकीर्तितं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002126007, "chapter_id": 22126, "verse_number": "१७१-८", "content_sanskrit": "कृच्छ्रातिकृच्छ्रं पयसा दिवसानेकविंशतिं ।\nगोमूत्रं गोमयं क्षीरं दधि सर्पिः कुशोदकं ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002126008, "chapter_id": 22126, "verse_number": "१७१-९", "content_sanskrit": "एकरात्रोपवासश्चकृच्छ्रं शान्तपनं स्मृतं ।\nएतच्च प्रत्याभ्यस्तं महाशान्तपनं स्मृतं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002126009, "chapter_id": 22126, "verse_number": "१७१-१०", "content_sanskrit": "त्र्यहाभ्यस्तमथैकैकमतिशान्तपनं स्मृतं ।\nकृच्छ्रं पराकसञ्ज्ञं स्याद्द्वादशाहमभोजनं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002126010, "chapter_id": 22126, "verse_number": "१७१-११", "content_sanskrit": "एकभक्तं त्र्यहाभ्यस्तं क्रमान्नक्तमयाचितं ।\nप्राजापत्यमुपोष्यान्ते पादः स्यात्कृच्छ्रपादकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002126011, "chapter_id": 22126, "verse_number": "१७१-१२", "content_sanskrit": "फलैर्मासं फलं कृच्छ्रं बिल्वैः श्रीक्च्छ्र ईरितः ।\nपद्माक्षैः स्यादामलकैः पुष्पकृच्छ्रं तु पुष्पकैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002126012, "chapter_id": 22126, "verse_number": "१७१-१३", "content_sanskrit": "पत्रकृच्छ्रन्तथा पत्रैस्तोयकृच्छ्रं जलेन तु ।\nमूलकृच्छ्रन्तथा मूलैर्दृध्न क्षीरेण तक्रतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002126013, "chapter_id": 22126, "verse_number": "१७१-१४", "content_sanskrit": "मासं वायव्यकृच्छ्रं स्यात्पाणिपूरान्नभोजनात् ।\nतिलैर्द्वादशरात्रेण कृच्छ्रमाग्नेयमार्तिनुत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002126014, "chapter_id": 22126, "verse_number": "१७१-१५", "content_sanskrit": "पाक्षं प्रसृत्या लाजानां ब्रह्मकूर्चं तथा भवेत् ।\nउपोषितश्चतुर्दृश्यां पञ्चदश्यामनन्तरं ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002126015, "chapter_id": 22126, "verse_number": "१७१-१६", "content_sanskrit": "पञ्चगव्यं समश्नीयाद्धविष्याशीत्यनन्तरं ।\nमासेन द्विर्नरः कृत्वा सर्वपापैः प्रमुच्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002126016, "chapter_id": 22126, "verse_number": "१७१-१७", "content_sanskrit": "श्रीकामः पुष्टिकामश्च स्वर्गकामोऽघनष्टये ।\nदेवताराधनपरः कृच्छ्रकारी स सर्वभाक् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]