[{"id": 2072540, "chapter_id": 2530, "verse_number": "१२-३५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072541, "chapter_id": 2530, "verse_number": "१२-३५-१", "content_sanskrit": "किं भक्ष्यं चाप्यभक्ष्यं च किंच देयं प्रशस्यते।\nकिंच पात्रमपात्रं वा तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072542, "chapter_id": 2530, "verse_number": "१२-३५-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072543, "chapter_id": 2530, "verse_number": "१२-३५-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nसिद्धानां चैव संवादं मनोश्चैव प्रजापतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072544, "chapter_id": 2530, "verse_number": "१२-३५-३", "content_sanskrit": "ऋषयस्तु व्रतपराः समागम्य पुरा विभुम्।\nधर्मं पप्रच्छुरासीनमादिकाले प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072545, "chapter_id": 2530, "verse_number": "१२-३५-४", "content_sanskrit": "कथमन्त्रं कथं दानं गम्यागम्याः कथं स्त्रियः।\nकार्याकार्यं च यत्सर्वं शंस वै त्वं प्रजापते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072546, "chapter_id": 2530, "verse_number": "१२-३५-५", "content_sanskrit": "तैरेवमुक्तो भगवान्मनुः स्वायंभुवोऽब्रवीत्।\nशुश्रूषध्वं यथावृत्तं धर्मं व्याससमासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072547, "chapter_id": 2530, "verse_number": "१२-३५-६", "content_sanskrit": "अनादेशे जपो होम उपवासस्तथैव च।\nआत्मज्ञानं पुण्यनद्यो यत्र प्रायश्च तत्पराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072548, "chapter_id": 2530, "verse_number": "१२-३५-७", "content_sanskrit": "अनादिष्टं तथैतानि पुण्यानि धरणीभृतः।\nसुवर्णप्राशनमपि रत्नादिस्नानमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072549, "chapter_id": 2530, "verse_number": "१२-३५-८", "content_sanskrit": "देवस्थानाभिगमनमाज्यप्राशनमेव च।\nएतानि मेध्यं पुरुषं कुर्वन्त्याशु न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072550, "chapter_id": 2530, "verse_number": "१२-३५-९", "content_sanskrit": "न गर्वेण भवेत्प्राज्ञः कदाचिदपि मानवः।\nदीर्घमायुरथेच्छन्हि त्रिरात्रं चोष्णपो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072551, "chapter_id": 2530, "verse_number": "१२-३५-१०", "content_sanskrit": "अदत्तस्यानुपादानं दानमध्ययनं तपः।\nअहिंसा सत्यमक्रोधं क्षमा धर्मस्य लक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072552, "chapter_id": 2530, "verse_number": "१२-३५-११", "content_sanskrit": "स एव धर्मः सोऽधर्मो देशकाले प्रतिष्ठितः।\nआदानमनृतं हिंसा धर्मो ह्यात्यन्तिकः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072553, "chapter_id": 2530, "verse_number": "१२-३५-१२", "content_sanskrit": "द्विविधौ चाप्युभावेतौ धर्माधर्मौ विजानताम्।\nअप्रवृत्तिः प्रवृत्तिश्च द्वैविध्यं लोकवेदयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072554, "chapter_id": 2530, "verse_number": "१२-३५-१३", "content_sanskrit": "अप्रवृत्तेरमर्त्यत्वं मर्त्यत्वं कर्मणः फलम्।\nअशुभस्याशुभं विद्याच्छुभस्य शुभमेव च।\nएतयोश्चोभयोः स्यातां शुभाशुभतया तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072555, "chapter_id": 2530, "verse_number": "१२-३५-१४", "content_sanskrit": "दैवं च दैवसंयुक्तं प्राणश्च प्रलयस्तथा।\nअप्रेक्षापूर्वकरणादशुभानां शुभं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072556, "chapter_id": 2530, "verse_number": "१२-३५-१५", "content_sanskrit": "ऊर्ध्वं भवति संदेहादिहादिष्टार्थमेव च।\nअप्रेक्षापूर्वकरणात्प्रायश्चित्तं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072557, "chapter_id": 2530, "verse_number": "१२-३५-१६", "content_sanskrit": "क्रोधमोहकृते चैव दृष्टान्तागमहेतुभिः।\nशरीराणामुपक्लेशो मनसश्च प्रियाप्रिये।\nतदौषधैश्च मन्त्रैश्च प्रायश्चित्तैश्च शाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072558, "chapter_id": 2530, "verse_number": "१२-३५-१७", "content_sanskrit": "उपवासेनैकरात्रं दण्डोत्सर्गे नराधिपः।\nविशुद्ध्येदात्मशुद्ध्यर्थं त्रिरात्रं तु पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072559, "chapter_id": 2530, "verse_number": "१२-३५-१८", "content_sanskrit": "क्षयं शोकं प्रकुर्वाणो न म्रियेत यदा नरः।\nशस्त्रादिभिरुपाविष्टस्त्रिरात्रं तत्र निर्दिशेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072560, "chapter_id": 2530, "verse_number": "१२-३५-१९", "content_sanskrit": "जातिश्रेण्यधिवासानां कुलधर्मांश्च शाश्वतान्।\nवर्जयन्ति च ये धर्मं तेषां धर्मो न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072561, "chapter_id": 2530, "verse_number": "१२-३५-२०", "content_sanskrit": "दश वा वेदशास्त्रज्ञास्त्रयो वा धर्मपाठकाः।\nयद्ब्रूयुः कार्य उत्पन्ने स धर्मो धर्मसंशये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072562, "chapter_id": 2530, "verse_number": "१२-३५-२१", "content_sanskrit": "अनुष्णा मृत्तिका चैव तथा क्षुद्रपिपीलिकाः।\nश्लेष्मातकस्तथा विप्रैरभक्ष्यं विषमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072563, "chapter_id": 2530, "verse_number": "१२-३५-२२", "content_sanskrit": "अभक्ष्या ब्राह्मणैर्मत्स्याः शकलैर्ये विवर्जिताः।\nचतुष्पात्कच्छपादन्यो मण्डूका जलजाश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072564, "chapter_id": 2530, "verse_number": "१२-३५-२३", "content_sanskrit": "भासा हंसाः सुपर्णाश्च चक्रवाकाः प्लवा बकाः।\nकाको मद्रुश्च गृध्रश्च श्येनोलूकस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072565, "chapter_id": 2530, "verse_number": "१२-३५-२४", "content_sanskrit": "क्रव्यादा दंष्ट्रिणः सर्वे चतुष्पात्पक्षिणश्च ये।\nयेषां चोभयतो दन्ताश्चतुर्दंष्ट्राश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072566, "chapter_id": 2530, "verse_number": "१२-३५-२५", "content_sanskrit": "एडकाश्च मृगोष्ट्राणां सूकराणां गवामपि।\nमानुषीणां खरीणां च न पिबेद्ब्राह्मणः पयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072567, "chapter_id": 2530, "verse_number": "१२-३५-२६", "content_sanskrit": "प्रेतान्नं सूतकान्नं च यच्च किंचिदनिर्दशम्।\nअभोज्यं चाप्यपेयं च धेनोर्दुग्धमनिर्दशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072568, "chapter_id": 2530, "verse_number": "१२-३५-२७", "content_sanskrit": "राजान्नं तेज आदत्ते शूद्रान्नं ब्रह्मवर्चसम्।\nआयुः सुवर्णकारान्नमवीरायाश्च योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072569, "chapter_id": 2530, "verse_number": "१२-३५-२८", "content_sanskrit": "विष्ठा वार्धुषिकस्यान्नं गणिकान्नमथेन्द्रियम्।\nमृष्यन्ति ये चोपपतिं स्त्रीजितान्नं च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072570, "chapter_id": 2530, "verse_number": "१२-३५-२९", "content_sanskrit": "दीक्षितस्य कदर्यस्य क्रतुविक्रयिकस्य च।\nतक्ष्णश्चर्मावकर्तुश्च पुंश्चल्या रजकस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072571, "chapter_id": 2530, "verse_number": "१२-३५-३०", "content_sanskrit": "चिकित्सकस्य यच्चान्नमभोज्यं रक्षिणस्तथा।\nगणग्रामाभिशस्तानां रङ्गस्त्रीजीविनां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072572, "chapter_id": 2530, "verse_number": "१२-३५-३१", "content_sanskrit": "परिवित्तीनामपुंसां च बन्दिद्यूतविदां तथा।\nवामहस्ताहृतं चान्नं शुष्कं पर्युषितं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072573, "chapter_id": 2530, "verse_number": "१२-३५-३२", "content_sanskrit": "सुरानुगतमुच्छिष्टमभोज्यं शेषितं च यत्।\nपिष्टमांसेक्षुशाकानामाविकाजापयस्तथा।\nसक्तु धाना करम्भाश्च नोपभोग्याश्चिरस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072574, "chapter_id": 2530, "verse_number": "१२-३५-३३", "content_sanskrit": "पायसं कृसरं मांसमपूपाश्च वृथा कृताः।\nअपेयाश्चाप्यभक्ष्याश्च ब्राह्मणैर्गृहमेधिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072575, "chapter_id": 2530, "verse_number": "१२-३५-३४", "content_sanskrit": "देवानृषीन्मनुष्यांश्च पितॄन्गृह्याश्च देवताः।\nपूजयित्वा ततः पश्चाद्गृहस्थो भोक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072576, "chapter_id": 2530, "verse_number": "१२-३५-३५", "content_sanskrit": "यथा प्रव्रजितो भिक्षुस्तथैव स्वे गृहे वसेत्।\nएवंवृत्तः प्रियैर्दारैः संबसन्धर्ममाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072577, "chapter_id": 2530, "verse_number": "१२-३५-३६", "content_sanskrit": "न दद्याद्यशसे दानं न भयान्नोपकारिणे।\nन नृत्यगीतशीलेषु हासकेषु च धार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072578, "chapter_id": 2530, "verse_number": "१२-३५-३७", "content_sanskrit": "न मत्ते चैव नोन्मत्ते न स्तेने न च कुत्सके।\nन वाग्घीने विवर्णे वा नाङ्गहीने न वामने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072579, "chapter_id": 2530, "verse_number": "१२-३५-३८", "content_sanskrit": "न दुर्जने दौष्कुले वा व्रतैर्यो वा न संस्कृतः।\nन श्रोत्रियमृते दानं ब्राह्मणे ब्रह्मवर्जिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072580, "chapter_id": 2530, "verse_number": "१२-३५-३९", "content_sanskrit": "असम्यच्कैव यद्दत्तमसम्यक् च प्रतिग्रहः।\nउभयं स्यादनर्थाय दातुरादातुरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072581, "chapter_id": 2530, "verse_number": "१२-३५-४०", "content_sanskrit": "यथा खदिरमालम्ब्य शिलां वाप्यर्णवं तरन्।\nमञ्जेत मञ्जतस्तद्वद्दाता यश्च प्रतिग्रही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072582, "chapter_id": 2530, "verse_number": "१२-३५-४१", "content_sanskrit": "काष्ठैरार्द्रैर्यथा वह्निरुपस्तीर्णो न दीप्यते।\nतपःस्वाध्यायचारित्रैरेवं हीनः प्रतिग्रही॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2072583, "chapter_id": 2530, "verse_number": "१२-३५-४२", "content_sanskrit": "कपाले यद्वदापः स्युः श्वदृतौ च यथा पयः।\nआश्रयस्थानदोषेण वृत्तहीने तथा श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2072584, "chapter_id": 2530, "verse_number": "१२-३५-४३", "content_sanskrit": "निर्मन्त्रो निर्वृतो यः स्यादशास्त्रज्ञोऽनसूयकः।\nअनुक्रोशात्प्रदातव्यं हीनेष्वव्रतिकेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2072585, "chapter_id": 2530, "verse_number": "१२-३५-४४", "content_sanskrit": "न वै देयमनुक्रोशाद्दीनायापगुणाय तु।\nआप्ताचरित इत्येव धर्म इत्येव वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2072586, "chapter_id": 2530, "verse_number": "१२-३५-४५", "content_sanskrit": "निष्कारणं स्मृतं दत्तं ब्राह्मणे ब्रह्मवर्जिते।\nन फलेत्पात्रदोषेण न चात्रास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2072587, "chapter_id": 2530, "verse_number": "१२-३५-४६", "content_sanskrit": "यथा दारुमयो हस्ती यथा चर्ममयो मृगः।\nब्राह्मणश्चानधीयानस्त्रयस्ते नामधारकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2072588, "chapter_id": 2530, "verse_number": "१२-३५-४७", "content_sanskrit": "यथा षण्ढोऽफलः स्त्रीषु यथा गौर्गवि चाफला।\nशकुनिर्वाप्यपक्षः स्यान्निर्मन्त्रो ब्राह्मणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2072589, "chapter_id": 2530, "verse_number": "१२-३५-४८", "content_sanskrit": "ग्रामस्थानं यथा शून्यं यथा कूपश्च निर्जलः।\nयथा हुतमनग्नौ च तथैव स्यान्निराकृतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2072590, "chapter_id": 2530, "verse_number": "१२-३५-४९", "content_sanskrit": "देवतानां पितॄणां च हव्यकव्यविनाशकः।\nसर्वथाऽर्थहरो मूर्खो न लोकान्प्राप्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2072591, "chapter_id": 2530, "verse_number": "१२-३५-५०", "content_sanskrit": "एतत्ते कथितं सर्वं यथावृत्तं युधिष्ठिर।\nसमासेन महद्ध्येतच्छ्रोतव्यं नरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2072592, "chapter_id": 2530, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि पञ्चत्रिंशोऽध्यायः॥ ३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]