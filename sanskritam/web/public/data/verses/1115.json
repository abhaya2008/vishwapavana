[{"id": 2005905, "chapter_id": 1115, "verse_number": "१-११६-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005906, "chapter_id": 1115, "verse_number": "१-११६-१", "content_sanskrit": "किं कृतं कर्म धर्मेण येन शापमुपेयिवान्।\nकस्य शापाच्च ब्रह्मर्षेः शूद्रयोनावजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005907, "chapter_id": 1115, "verse_number": "१-११६-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005908, "chapter_id": 1115, "verse_number": "१-११६-२", "content_sanskrit": "बभूव ब्राह्मणः कश्चिन्माण्डव्य इति विश्रुतः।\nधृतिमान्सर्वधर्मज्ञः सत्ये तपसि च स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005909, "chapter_id": 1115, "verse_number": "१-११६-३", "content_sanskrit": "स तीर्थयात्रां विचरन्नाजगाम यदृच्छया।\nसंनिकृष्टानि तीर्थानि ग्रामाणां यानि कानि च।\nतत्राश्रमपदं कृत्वा वसति स्म महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005910, "chapter_id": 1115, "verse_number": "१-११६-४", "content_sanskrit": "स आश्रमपदद्वारि वृक्षमूले महातपाः।\nऊर्ध्वबाहुर्महायोगी तस्थौ मौनव्रतान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005911, "chapter_id": 1115, "verse_number": "१-११६-५", "content_sanskrit": "तस्य कालेन महता तस्मिंस्तपसि वर्ततः।\nतमाश्रममनुप्राप्ता दस्यवो लोप्त्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005912, "chapter_id": 1115, "verse_number": "१-११६-६", "content_sanskrit": "अनुसार्यमाणा बहुभी रक्षिभिर्भरतर्षभ।\nतामेव वसतिं जग्मुस्ते ग्रामाल्लोप्त्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005913, "chapter_id": 1115, "verse_number": "१-११६-७", "content_sanskrit": "यस्मिन्नावसथे शेते स मुनिः संशितव्रतः।\nते तस्यावसथे लोप्त्रं दस्यवः कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005914, "chapter_id": 1115, "verse_number": "१-११६-८", "content_sanskrit": "निधाय च भयाल्लीनास्तत्रैवानागते बले।\nतेषु लीनेष्वथो शीघ्रं ततस्तद्रक्षिणां बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005915, "chapter_id": 1115, "verse_number": "१-११६-९", "content_sanskrit": "आजगाम ततोऽपश्यंस्तमृषिं तस्करानुगाः।\nतमपृच्छंस्ततो राजंस्तथावृत्तं तपोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005916, "chapter_id": 1115, "verse_number": "१-११६-१०", "content_sanskrit": "कतरेण पथा याता दस्यवो द्विजसत्तम।\nतेन गच्छामहे ब्रह्मन्यथा शीघ्रतरं वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005917, "chapter_id": 1115, "verse_number": "१-११६-११", "content_sanskrit": "तथा तु रक्षिमां तेषां ब्रुवतां स तपोधनः।\nन किंचिद्वचनं राजन्नब्रवीत्साध्वसाधु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005918, "chapter_id": 1115, "verse_number": "१-११६-१२", "content_sanskrit": "ततस्ते राजपुरुषा विचिन्वानास्तमाश्रमम्।\nददृशुस्तत्र लीनांस्तांश्चोरांस्तद्द्रव्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005919, "chapter_id": 1115, "verse_number": "१-११६-१३", "content_sanskrit": "ततः शङ्का समभवद्रक्षिणां तं मुनिं प्रति।\nसंयम्यैनं ततो राज्ञे दस्यूंश्चैव न्यवेदयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005920, "chapter_id": 1115, "verse_number": "१-११६-१४", "content_sanskrit": "तं राजा सह तैश्चोरैरन्वशाद्वध्यतामिति।\nस रक्षिभिस्तैरज्ञातः शूले प्रोतो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005921, "chapter_id": 1115, "verse_number": "१-११६-१५", "content_sanskrit": "ततस्ते शूलमारोप्य तं मुनिं रक्षिणस्तदा।\nप्रतिजग्मुर्महीपालं धनान्यादाय तान्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005922, "chapter_id": 1115, "verse_number": "१-११६-१६", "content_sanskrit": "शूलस्थः स तु धर्मात्मा कालेन महता ततः।\nनिराहारोऽपि विप्रर्षिर्मरणं नाभ्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005923, "chapter_id": 1115, "verse_number": "१-११६-१७", "content_sanskrit": "धारयामास च प्राणानृषींश्च समुपानयत्।\nशूलाग्रे तप्यमानेन तपस्तेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005924, "chapter_id": 1115, "verse_number": "१-११६-१८", "content_sanskrit": "सन्तापं परमं जग्मुर्मुनयस्तपसाऽन्विताः।\nते रात्रौ शकुना भूत्वा सन्निपत्त्य तु भारत।\nदर्शन्तो यथाशक्ति तमपृच्छन्द्विजोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005925, "chapter_id": 1115, "verse_number": "१-११६-१९", "content_sanskrit": "श्रोतुमिच्छामहे ब्रह्मन्किं पापं कृतवानसि।\nयेनेह समनुप्राप्तं शूले दुःखभयं महत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005926, "chapter_id": 1115, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि षोडशाधिकशततमोऽध्यायः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]