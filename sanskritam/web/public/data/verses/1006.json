[{"id": 2000990, "chapter_id": 1006, "verse_number": "१-७-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2000991, "chapter_id": 1006, "verse_number": "१-७-१", "content_sanskrit": "शप्तस्तु भृगुणा वह्निः क्रुद्धो वाक्यमथाब्रवीत्।\nकिमिदं साहसं ब्रह्मन्कृतवानसि मां प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2000992, "chapter_id": 1006, "verse_number": "१-७-२", "content_sanskrit": "धर्मे प्रयतमानस्य सत्यं च वदतः समम्।\nपृष्टो यदब्रवं सत्यं व्यभिचारोऽत्र को मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2000993, "chapter_id": 1006, "verse_number": "१-७-३", "content_sanskrit": "पृष्टो हिसाक्षीयः साक्ष्यं जानानोऽप्यन्यथा वदेत्।\nस पूर्वानात्मनः सप्त कुले हन्यात्तथाऽपरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2000994, "chapter_id": 1006, "verse_number": "१-७-४", "content_sanskrit": "यश्च कार्यार्थतत्त्वज्ञो जानानोऽपि न भाषते।\nसोऽपि तेनैव पापेन लिप्यते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2000995, "chapter_id": 1006, "verse_number": "१-७-५", "content_sanskrit": "शक्तोऽहमपि शप्तुं त्वां मान्यास्तु ब्राह्मणा मम।\nजानतोऽपि च ते ब्रह्मन्कथयिष्ये निबोध तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2000996, "chapter_id": 1006, "verse_number": "१-७-६", "content_sanskrit": "योगेन बहुधाऽऽत्मानं कृत्वा तिष्ठामि मूर्तिषु।\nअग्निहोत्रेषु सत्रेषु क्रियासु च मखेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2000997, "chapter_id": 1006, "verse_number": "१-७-७", "content_sanskrit": "वेदोक्तेन विधानेन मयि यद्धूयते हविः।\nदेवताः पितरश्चैव तेन तृप्ता भवन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2000998, "chapter_id": 1006, "verse_number": "१-७-८", "content_sanskrit": "आपो देवगणाः सर्वे आपः पितृगणास्तथा।\nदर्शश्च पौर्णमासश्च देवानां पितृभिः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2000999, "chapter_id": 1006, "verse_number": "१-७-९", "content_sanskrit": "देवताः पितरस्तस्मात्पितरश्चापि देवताः।\nएकीभूताश्च दृश्यन्ते पृथक्त्वेन च पर्वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001000, "chapter_id": 1006, "verse_number": "१-७-१०", "content_sanskrit": "देवताः पितरश्चैव भुञ्जते मयि यद्भुतम्।\nदेवतानां पितॄणां च मुखमेतदहं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001001, "chapter_id": 1006, "verse_number": "१-७-११", "content_sanskrit": "अमावास्यां हि पितरः पौर्णमास्यां हि देवताः।\nमन्मुखेनैव हूयन्ते भुञ्जते च हुतं हविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001002, "chapter_id": 1006, "verse_number": "१-७-१२", "content_sanskrit": "सर्वभक्षः कथं त्वेषां भविष्यामि मुखं त्वहम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001003, "chapter_id": 1006, "verse_number": "१-७-१२x", "content_sanskrit": "सौतिरुवाच।\nचिन्तयित्वा ततो वह्निश्चके संहारमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001004, "chapter_id": 1006, "verse_number": "१-७-१३", "content_sanskrit": "द्विजानामग्निहोत्रेषु यज्ञसत्रक्रियासु च।\nनिरोंकारवषट्काराः स्वधास्वाहाविवर्जिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001005, "chapter_id": 1006, "verse_number": "१-७-१४", "content_sanskrit": "विनाऽग्निना प्रजाः सर्वास्तत आसन्सुदुःखिताः।\nअथर्षयः समुद्विग्ना देवान् गत्वाब्रुवन्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001006, "chapter_id": 1006, "verse_number": "१-७-१५", "content_sanskrit": "अग्निनाशात्क्रियाभ्रांशाद्भ्रान्ता लोकास्त्रयोऽनघाः।\nविधध्वमत्र यत्कार्यं न स्यात्कालात्ययो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001007, "chapter_id": 1006, "verse_number": "१-७-१६", "content_sanskrit": "अथर्षयश्च देवाश्च ब्रह्माणमुपगम्य तु।\nअग्नेरावेदयञ्शापं क्रियासंहारमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001008, "chapter_id": 1006, "verse_number": "१-७-१७", "content_sanskrit": "भृगुणा वै महाभाग शप्तोऽग्निः कारणान्तरे।\nकथं देवमुखो भूत्वा यज्ञभागाग्रभुक् तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001009, "chapter_id": 1006, "verse_number": "१-७-१८", "content_sanskrit": "हुतभुक्सर्वलोकेषु सर्वभक्षत्वमेष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001010, "chapter_id": 1006, "verse_number": "१-७-१८x", "content_sanskrit": "सौतिरुवाच।\nश्रुत्वा तु तद्वचस्तेषामग्निमाहूय विश्वकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001011, "chapter_id": 1006, "verse_number": "१-७-१९", "content_sanskrit": "उवाच वचनं श्लक्ष्णं भूतभावनमव्ययम्।\nलोकानामिह सर्वेषां त्वं कर्ता चान्त एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001012, "chapter_id": 1006, "verse_number": "१-७-२०", "content_sanskrit": "त्वं धारयसि लोकांस्त्रीन्क्रियाणां च प्रवर्तकः।\nस तथा कुरु लोकेश नोच्छिद्येरन्यथा क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001013, "chapter_id": 1006, "verse_number": "१-७-२१", "content_sanskrit": "कस्मादेवं विमूढस्त्वमीश्वरः सन् हुताशेन।\nत्वं पवित्रं सदा लोके सर्वभूतगतिश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001014, "chapter_id": 1006, "verse_number": "१-७-२२", "content_sanskrit": "न त्वं सर्वशरीरेण सर्वभक्षत्वमेष्यसि।\nअपाने ह्यर्चिषो यास्ते सर्वं भक्ष्यन्ति ताः शिखिन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001015, "chapter_id": 1006, "verse_number": "१-७-२३", "content_sanskrit": "क्रव्यादा च तनुर्या ते सा सर्वं भक्षयिष्यति।\nयथा सूर्यांशुभिः स्पृष्टं सर्वं शुचि विभाव्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001016, "chapter_id": 1006, "verse_number": "१-७-२४", "content_sanskrit": "तथा त्वदर्चिर्निर्दग्धं सर्वं शुचि भविष्यति।\nत्वमग्ने परमं तेजः स्वप्रभावाद्विनिर्गतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001017, "chapter_id": 1006, "verse_number": "१-७-२५", "content_sanskrit": "स्वतेजसैव तं शापं कुरु सत्यमृषेर्विभो।\nदेवानां चात्मनो भागं गृहाण त्वं मुखे हुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001018, "chapter_id": 1006, "verse_number": "१-७-२६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001019, "chapter_id": 1006, "verse_number": "१-७-२६", "content_sanskrit": "एवमस्त्विति तं वह्निः प्रत्युवाच पितामहम्।\nजगाम शासनं कर्तुं देवस्य परमेष्ठिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001020, "chapter_id": 1006, "verse_number": "१-७-२७", "content_sanskrit": "देवर्षयश्च मुदितास्ततो जग्मुर्यथागतम्।\nऋषयश्च यथा पूर्वं क्रियाः सर्वाः प्रचक्रिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001021, "chapter_id": 1006, "verse_number": "१-७-२८", "content_sanskrit": "दिवि देवा मुमुदिरे भूतसङ्घाश्च लौकिकाः।\nअग्निश्च परमां प्रीतिमवाप हतकल्मषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001022, "chapter_id": 1006, "verse_number": "१-७-२९", "content_sanskrit": "एवं स भगवाञ्छापं लेभेऽग्निर्भृगुतः पुरा।\nएवमेष पुरा वृत्त हतिहासोऽग्निशापजः।\nपुलोम्नश्च विनाशोऽयं च्यवनस्य च संभवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001023, "chapter_id": 1006, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि पौलोमपर्वणि सप्तमोऽध्यायः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]