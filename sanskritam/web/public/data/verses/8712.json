erse_number": "2.49", "content_sanskrit": "एतेन अप्रामाण्याभावानुमित्यनन्तरं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 900008777, "chapter_id": 8712, "verse_number": "2.50", "content_sanskrit": "नच गुणजन्यत्वाद्यवच्छेदेन नियमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 900008778, "chapter_id": 8712, "verse_number": "2.51", "content_sanskrit": "यच्चोक्तं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 900008779, "chapter_id": 8712, "verse_number": "2.52", "content_sanskrit": "यद्वा उक्तहेतुत्रयमध्ये एकं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 900008780, "chapter_id": 8712, "verse_number": "2.53", "content_sanskrit": "प्रथमं व्यवसायः, अनन्तरं ज्ञानत्वनिर्विकल्पकं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 900008781, "chapter_id": 8712, "verse_number": "2.54", "content_sanskrit": "अत एव द्वितीये प्रामाण्यनिश्चयस्थितिक्षणे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 900008782, "chapter_id": 8712, "verse_number": "2.55", "content_sanskrit": "किञ्चेतैरनुमानैः प्रामाण्यस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 900008783, "chapter_id": 8712, "verse_number": "2.56", "content_sanskrit": "किञ्चोक्तेनानवस्थारूपेणप्रथमस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 900008784, "chapter_id": 8712, "verse_number": "2.57", "content_sanskrit": "किञ्चाद्ये हेतौ संशयस्य तृतीयक्षणवृत्तित्वमसिद्धम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 900008785, "chapter_id": 8712, "verse_number": "2.58", "content_sanskrit": "एवं तृतीयहेतावप्यनुव्यवसायस्य प्रामाण्यनियमे सिद्धे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 900008786, "chapter_id": 8712, "verse_number": "2.59", "content_sanskrit": "ननु कथमेतत् अनित्यप्रमा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 900008787, "chapter_id": 8712, "verse_number": "2.60", "content_sanskrit": "नापि ज्ञानसामान्यसामग्र्यतिरिक्तसामग्रीजन्येति साध्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 900008788, "chapter_id": 8712, "verse_number": "2.61", "content_sanskrit": "नापि अनित्यप्रमा ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 900008789, "chapter_id": 8712, "verse_number": "2.62", "content_sanskrit": "न च विशेष्यासिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 900008790, "chapter_id": 8712, "verse_number": "2.63", "content_sanskrit": "अथ मतं ग्राह्यप्रमा वा विशेष्यनिष्ठविशेषणज्ञानं वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 900008791, "chapter_id": 8712, "verse_number": "2.64", "content_sanskrit": "धारावाहिके भ्रमे पूर्वस्य भ्रमस्योत्तरभ्रमंप्रति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 900008792, "chapter_id": 8712, "verse_number": "2.65", "content_sanskrit": "किञ्चानित्यप्रमामात्रानुगतगुणाङ्गीकारे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 900008793, "chapter_id": 8712, "verse_number": "2.66", "content_sanskrit": "एतेन यादृच्छिकसंवादेनप्रमायां लिङ्गाभासेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 900008794, "chapter_id": 8712, "verse_number": "2.67", "content_sanskrit": "अथापि स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 900008795, "chapter_id": 8712, "verse_number": "2.68", "content_sanskrit": "अत्र च साध्ये आद्यं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 900008796, "chapter_id": 8712, "verse_number": "2.69", "content_sanskrit": "द्वितीयमात्रपदाभावेऽसिद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 900008797, "chapter_id": 8712, "verse_number": "2.70", "content_sanskrit": "अथ मतं अनित्यप्रत्यक्षप्रमात्वमनुमितिप्रमात्वं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 900008798, "chapter_id": 8712, "verse_number": "2.71", "content_sanskrit": "प्रत्यक्षप्रमामात्रे न सन्निकर्षार्थौ हेतू", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 900008799, "chapter_id": 8712, "verse_number": "2.72", "content_sanskrit": "अपि च त्वन्मते भ्रमेपि यस्मिन्नंशे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 900008800, "chapter_id": 8712, "verse_number": "2.73", "content_sanskrit": "नचेश्वरे सोऽस्तीति वाच्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 900008801, "chapter_id": 8712, "verse_number": "2.74", "content_sanskrit": "ननु तर्ह्यनुमितिसमानाधिकरणं वस्तुतः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 900008802, "chapter_id": 8712, "verse_number": "2.75", "content_sanskrit": "न च तत्रापीश्वरनिष्ठं यथार्थवाक्यार्थज्ञानं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 900008803, "chapter_id": 8712, "verse_number": "2.76", "content_sanskrit": "किञ्च योग्यता किं शब्दप्रतिपाद्यस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 900008804, "chapter_id": 8712, "verse_number": "2.77", "content_sanskrit": "तत्र चाद्यपक्षेऽनन्वयप्रमाविरहो योग्यता..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 900008805, "chapter_id": 8712, "verse_number": "2.78", "content_sanskrit": "अपिचैवमप्रमायामपि विषयासत्वाविनाभूतविषयाभावप्रमा वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 900008806, "chapter_id": 8712, "verse_number": "2.79", "content_sanskrit": "न च श्रोतुस्तद्विरहदशायामपीश्वरस्यासंसर्गप्रमास्ति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 900008807, "chapter_id": 8712, "verse_number": "2.80", "content_sanskrit": "एतेनायोग्यताज्ञानेन शाब्दज्ञानप्रतिबन्धात् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 900008808, "chapter_id": 8712, "verse_number": "2.81", "content_sanskrit": "अथापि स्यात् भ्रमसामान्येप्रत्यक्षादिभ्रमे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 900008809, "chapter_id": 8712, "verse_number": "2.82", "content_sanskrit": "एवं भ्रमोत्तरप्रमायामपि तदनुत्तरप्रमायां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 900008810, "chapter_id": 8712, "verse_number": "2.83", "content_sanskrit": "किञ्च दुष्टायां ज्ञानसामग्र्यां सत्यामपि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 900008811, "chapter_id": 8712, "verse_number": "2.84", "content_sanskrit": "अत एव यत्र संशयादिरूपा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 900008812, "chapter_id": 8712, "verse_number": "2.85", "content_sanskrit": "एतेन अप्रमापिप्रमाविशेषः स्यादिति निरस्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 900008813, "chapter_id": 8712, "verse_number": "2.86", "content_sanskrit": "तस्मादन्वयव्यभिचाराद्व्यतिरेकव्यभिचारादन्यथासिद्धेश्च..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 900008814, "chapter_id": 8712, "verse_number": "2.87", "content_sanskrit": "अस्तु तर्हि दोषाभावादेवप्रमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 900008815, "chapter_id": 8712, "verse_number": "2.88", "content_sanskrit": "क्लप्तकारणं चक्षुरादिकमादायैव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 900008816, "chapter_id": 8712, "verse_number": "2.89", "content_sanskrit": "ननु कथं तर्हि दोषस्यप्रतिबन्धकत्वमपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 900008817, "chapter_id": 8712, "verse_number": "2.90", "content_sanskrit": "स्वतस्त्वे तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 900008818, "chapter_id": 8712, "verse_number": "2.91", "content_sanskrit": "ननु विभागस्याव्याप्यवृत्तित्वं स्वात्यन्ताभावसामानाधिकरण्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 900008819, "chapter_id": 8712, "verse_number": "2.92", "content_sanskrit": "प्रत्यक्षादिप्रमासुप्रत्येकानुगता गुणा इति पक्षे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 900008820, "chapter_id": 8712, "verse_number": "2.93", "content_sanskrit": "यज्ञपतिमते अनित्यप्रमात्वं न ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 900008821, "chapter_id": 8712, "verse_number": "2.94", "content_sanskrit": "तत्तत्प्रागभावनिरूपितकार्यताश्रयत्वेन बाध इति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 900008822, "chapter_id": 8712, "verse_number": "2.95", "content_sanskrit": "भूयोऽवयवेन्द्रियसन्निकर्षो नप्रमायामसाधारणकारणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 900008823, "chapter_id": 8712, "verse_number": "2.96", "content_sanskrit": "अप्रमायां त्वनन्यथासिद्धान्वयव्यतिरेकित्वाद् दोषः कारणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 900008824, "chapter_id": 8712, "verse_number": "2.97", "content_sanskrit": "ननु तथाप्यौत्सर्गिकस्याप्रामाण्यस्य क्वचिद् गुणःप्रतिबन्धकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 900008825, "chapter_id": 8712, "verse_number": "2.98", "content_sanskrit": "ननूत्तेजकस्य दोषस्य विषयसत्त्वंप्रतिबन्धकमिति चेत्तर्हि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 900008826, "chapter_id": 8712, "verse_number": "2.99", "content_sanskrit": "करणगतस्य यथार्थज्ञानसाधनत्वरूपप्रामाण्यस्य तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 900008827, "chapter_id": 8712, "verse_number": "2.100", "content_sanskrit": "उत्पत्तौ स्वतस्त्वं तु करणगतायाः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]