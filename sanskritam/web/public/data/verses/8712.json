[{"id": 900008728, "chapter_id": 8712, "verse_number": "2.1", "content_sanskrit": "याथार्थ्यरूपस्य तत्तज्ज्ञानप्रामाण्यस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900008729, "chapter_id": 8712, "verse_number": "2.2", "content_sanskrit": "अत्रच नियमोक्त्या न्यायमतेऽपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900008730, "chapter_id": 8712, "verse_number": "2.3", "content_sanskrit": "यद्वा तत्तज्ज्ञानप्रामाण्यस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900008731, "chapter_id": 8712, "verse_number": "2.4", "content_sanskrit": "यद्वा उभयसिद्धप्रामाण्याविषयकज्ञानभिन्नज्ञानविषयत्वनैयत्यं स्वतस्त्वं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900008732, "chapter_id": 8712, "verse_number": "2.5", "content_sanskrit": "उभयसिद्धेत्युक्त्या न्यायमतेऽप्रतिबद्धस्याप्यनुव्यवसायस्य..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900008733, "chapter_id": 8712, "verse_number": "2.6", "content_sanskrit": "अत्राद्यं पक्षद्वयं स्वमतासाधारणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900008734, "chapter_id": 8712, "verse_number": "2.7", "content_sanskrit": "यत्तु मणावुक्तं", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900008735, "chapter_id": 8712, "verse_number": "2.8", "content_sanskrit": "ननु ज्ञानग्राहकपदेन ग्राह्यप्रामाण्याश्रयज्ञानप्रकारप्रकारकतयाननु ज्ञानग्राहकपदेन ग्राह्यप्रामाण्याश्रयज्ञानप्रकारप्रकारकतया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "au