[{"id": 7003640000, "chapter_id": 23640, "verse_number": "१-२-२७-१", "content_sanskrit": "नारद उवाच ।\nततो निरुपमं दिव्यं सर्वरत्नमयं शुभम् ।\nईशाननिर्मितं साक्षात्सह देव्याविशद्गृहम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003640001, "chapter_id": 23640, "verse_number": "१-२-२७-२", "content_sanskrit": "तत्रासौ मंदरगिरौ सह देव्या भगाक्षहा ।\nप्रासादे तत्र चोद्याने रेमे संहृष्टमानसः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003640002, "chapter_id": 23640, "verse_number": "१-२-२७-३", "content_sanskrit": "एतस्मिन्नंतरे देवास्तारकेणातिपीडिताः ।\nप्रोत्साहितेन चात्यर्थं मया कलिचिकीर्षुणा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003640003, "chapter_id": 23640, "verse_number": "१-२-२७-४", "content_sanskrit": "आसाद्य ते भवं देवं तुष्टुबुर्बहुधा स्तवैः ।\nएतस्मिन्नंतरे देवी प्रोद्वर्तयत गात्रकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003640004, "chapter_id": 23640, "verse_number": "१-२-२७-५", "content_sanskrit": "उद्वर्तनमलेनाथ नरं चक्रे गजाननम् ।\nदेवानां संस्तवैः पुण्यैः कृपयाभिपरिप्लुता ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003640005, "chapter_id": 23640, "verse_number": "१-२-२७-६", "content_sanskrit": "पुत्रेत्युवाच तं देवी ततः संहृष्टमानसा ।\nएतस्मिन्नंतरे शर्वस्तत्रागत्य वचोऽब्रवीत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003640006, "chapter_id": 23640, "verse_number": "१-२-२७-७", "content_sanskrit": "पुत्रस्तवायं गिरिजे श्रृणु यादृग्भविष्यति ।\nविक्रमेण च वीर्येण कृपया सदृशो मया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003640007, "chapter_id": 23640, "verse_number": "१-२-२७-८", "content_sanskrit": "यथाहं तादृशश्चासौ पुत्रस्ते भविता गुणैः ।\nये च पापा दुराचारा वेदान्धर्मं द्विषंति च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003640008, "chapter_id": 23640, "verse_number": "१-२-२७-९", "content_sanskrit": "तेषामामरणांतानि विघ्नान्येष करिष्यति ।\nये च मां नैव मन्यंते विष्णुं वापि जगद्गुरुम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003640009, "chapter_id": 23640, "verse_number": "१-२-२७-१०", "content_sanskrit": "विघ्निता विघ्नराजेन ते यास्यंति महत्तमः ।\nतेषां गृहेषु कलहः सदा नैवोपसाम्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003640010, "chapter_id": 23640, "verse_number": "१-२-२७-११", "content_sanskrit": "पुत्रस्य तव विघ्नेन समूलं तस्य नश्यति ।\nयेषां न पूज्याः पूज्यंते क्रोधासत्यपराश्च ये ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003640011, "chapter_id": 23640, "verse_number": "१-२-२७-१२", "content_sanskrit": "रौद्रसाहसिका ये च तेषां विघ्नं करिष्यति ।\nश्रुतिधर्माञ्ज्ञातिधर्मान्पालयंति गुरूंश्च ये ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003640012, "chapter_id": 23640, "verse_number": "१-२-२७-१३", "content_sanskrit": "कृपालवो गतक्रोधास्तेषां विघ्नं हरिष्यति ।\nसर्वे धर्माश्च कर्माणि तथा नानाविधानि च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003640013, "chapter_id": 23640, "verse_number": "१-२-२७-१४", "content_sanskrit": "सविघ्नानि भिवष्यंति पूजयास्य विना शुभे ।\nएवं श्रुत्वा उमा प्राह एवमस्त्विति शंकरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003640014, "chapter_id": 23640, "verse_number": "१-२-२७-१५", "content_sanskrit": "ततो बृहत्तनुः सोऽभूत्तेजसा द्योतयन्दिशः ।\nततो गणैः समं शर्वः सुराणां प्रददौ च तम् ।\nयावत्तार कहंता वो भवेत्तावदयं प्रभुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003640015, "chapter_id": 23640, "verse_number": "१-२-२७-१६", "content_sanskrit": "ततो विघ्नपतिर्देवैः संस्तुतः प्रमतार्तिहा ।\nचकार तेषां कृत्यानि विघ्नानि दितिजन्मनाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003640016, "chapter_id": 23640, "verse_number": "१-२-२७-१७", "content_sanskrit": "पार्वती च पुनर्देवी पुत्रत्वे परिकल्प्य च ।\nअशोकस्यांकुरं वार्भिरवर्द्धयत स्वादृतैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003640017, "chapter_id": 23640, "verse_number": "१-२-२७-१८", "content_sanskrit": "सप्तर्षीनथ चाहूय संस्कारमंगलं तरोः ।\nकारयामास तन्वंगी ततस्तां मुनयोऽब्रुवन् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003640018, "chapter_id": 23640, "verse_number": "१-२-२७-१९", "content_sanskrit": "त्वयैव दर्शिते मार्गे मर्यादां कर्तुमर्हसि ।\nकिं फलं भविता देवि कल्पितैस्तरुपुत्रकैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003640019, "chapter_id": 23640, "verse_number": "१-२-२७-२०", "content_sanskrit": "देव्युवाच ।\nयो वै निरुदके ग्रामे कूपं कारयते बुधः ।\nयावत्तोयं भवेत्कूपे तावत्स्वर्गे स मोदते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003640020, "chapter_id": 23640, "verse_number": "१-२-२७-२१", "content_sanskrit": "दशकूपसमावापी दशवापी समं सरः ।\nदशसरःसमा कन्या दशकन्यासमः क्रतुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003640021, "chapter_id": 23640, "verse_number": "१-२-२७-२२", "content_sanskrit": "दशक्रतुसमः पुत्रो दशपुत्रसमो द्रुमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003640022, "chapter_id": 23640, "verse_number": "१-२-२७-२३", "content_sanskrit": "एषैव मम मर्यादा नियता लोकभाविनी ।\nजीर्णोद्धारे कृते वापि फलं तद्द्विगुणं मतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003640023, "chapter_id": 23640, "verse_number": "१-२-२७-२४", "content_sanskrit": "इति गणेशोत्पत्तिः ।\nततः कदाचिद्भगवानुमया सह मंदरे ।\nमंदिरे हर्षजनने कलधौतमये शुभे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003640024, "chapter_id": 23640, "verse_number": "१-२-२७-२५", "content_sanskrit": "प्रकीर्णकुसुमामोदमहालिकुलकूजिते ।\nकिंनरोद्गीतसंगीत प्रतिशब्दितमध्यके ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003640025, "chapter_id": 23640, "verse_number": "१-२-२७-२६", "content_sanskrit": "क्रीडामयूरैर्हसैश्च श्रुतैश्चैवाभिनादिते ।\nमौक्तिकैर्विविध रत्नैर्विनिर्मितगवाक्षके ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003640026, "chapter_id": 23640, "verse_number": "१-२-२७-२७", "content_sanskrit": "तत्र पुण्यकथाभिश्च क्रीडतो रुभयोस्तयोः ।\nप्रादुरभून्महाञ्छब्दः पूरितांबरगोचरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003640027, "chapter_id": 23640, "verse_number": "१-२-२७-२८", "content_sanskrit": "तं श्रुत्वा कौतुकाद्देवी किमेतदिति शंकरम् ।\nपर्यपृच्छच्छुभतनूर्हरं विस्मयपूर्वकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003640028, "chapter_id": 23640, "verse_number": "१-२-२७-२९", "content_sanskrit": "तामाह देवीं गिरिशो दृष्टपूर्वास्तु ते त्वया ।\nएते गणा मे क्रीडंति शैलेऽस्मिंस्त्वत्प्रियाः शुभे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003640029, "chapter_id": 23640, "verse_number": "१-२-२७-३०", "content_sanskrit": "तपसा ब्रह्मचर्येण क्लेशेन क्षेत्रसाधनैः ।\nयैरहं तोषितः पृथ्व्यां त एते मनुजोत्तमाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003640030, "chapter_id": 23640, "verse_number": "१-२-२७-३१", "content_sanskrit": "मत्समीपमनुप्राप्ता मम लोकं वरानने ।\nचराचरस्य जगतः सृष्टिसंहारणक्षमाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003640031, "chapter_id": 23640, "verse_number": "१-२-२७-३२", "content_sanskrit": "विनैतान्नैव मे प्रीतिर्नैभिर्विरहितो रमे ।\nएते अहमहं चैते तानेतान्पस्य पार्वति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003640032, "chapter_id": 23640, "verse_number": "१-२-२७-३३", "content_sanskrit": "इत्युक्ता विस्मिता देवी ददृशे तान्गवाक्षके ।\nस्थिता पद्मपलाशाक्षी महादेवेन भाषिता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003640033, "chapter_id": 23640, "verse_number": "१-२-२७-३४", "content_sanskrit": "केचित्कृशा ह्रस्वदीर्घाः केचित्स्थूलमहोदराः ।\nव्याघ्रेभमेषाजमुखा नानाप्राणिमहामुखाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003640034, "chapter_id": 23640, "verse_number": "१-२-२७-३५", "content_sanskrit": "व्याघ्रचर्मपरीधाना नग्ना ज्वालामुखाः परे ।\nगोकर्णा गजकर्णाश्च बहुपादमुखेक्षणाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003640035, "chapter_id": 23640, "verse_number": "१-२-२७-३६", "content_sanskrit": "विचित्रवाहनाश्चैव नानायुधधरास्तथा ।\nगीतवादित्रतत्त्वज्ञाः सत्त्वगीतरसप्रियाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003640036, "chapter_id": 23640, "verse_number": "१-२-२७-३७", "content_sanskrit": "तान्दृष्ट्वा पार्वती प्राह कतिसंख्याभिधास्त्वमी ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003640037, "chapter_id": 23640, "verse_number": "१-२-२७-३८", "content_sanskrit": "श्रीशंकर उवाच ।\nअसंख्ये यास्त्वमी देवी असंख्येयाभिधास्तथा ।\nजगदापूरितं सर्वमेतैर्भीमैर्महाबलैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003640038, "chapter_id": 23640, "verse_number": "१-२-२७-३९", "content_sanskrit": "सिद्धक्षेत्रेषु रथ्यासु जीर्णोद्यानेषु वेश्मसु ।\nदानवानां शरीरेषु बालेषून्मत्तकेषु च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003640039, "chapter_id": 23640, "verse_number": "१-२-२७-४०", "content_sanskrit": "एते विशति मुदिता नानाहारविहारिणः ।\nऊष्मपाः फेनपाश्चैव धूम्रपा मधुपायिनः ।\nमदाहाराः सर्वभक्ष्यास्तथान्ये चाप्यभोजनाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003640040, "chapter_id": 23640, "verse_number": "१-२-२७-४१", "content_sanskrit": "गीतनृत्योपहाराश्च नानावाद्यरवप्रियाः ।\nअनंतत्वादमीषां च वक्तुं शक्या न वै गुणाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003640041, "chapter_id": 23640, "verse_number": "१-२-२७-४२", "content_sanskrit": "श्रीदेव्युवाच ।\nमनःशिलेन कल्केन य एष च्छुरिताननः ।\nतेजसा भास्कराकारो रूपेण सदृशस्तव ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003640042, "chapter_id": 23640, "verse_number": "१-२-२७-४३", "content_sanskrit": "आकर्ण्याकर्ण्य ते देव गणैर्गीतान्महागुणान् ।\nमुहुर्नृत्यति हास्यं च विदधाति मुहुर्मुहुः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003640043, "chapter_id": 23640, "verse_number": "१-२-२७-४४", "content_sanskrit": "सदाशिवशिवेत्येवं विह्वलो वक्ति यो मुहुः ।\nधन्योऽमीदृशी यस्य भक्तिस्त्वयि महेश्वरे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003640044, "chapter_id": 23640, "verse_number": "१-२-२७-४५", "content_sanskrit": "एनं विज्ञातुमिच्छामि किंनामासौ गणस्तव ।\nश्रीशंकर उवाच ।\nस एष वीरक देवी सदा मेद्रिसुते प्रियः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003640045, "chapter_id": 23640, "verse_number": "१-२-२७-४६", "content_sanskrit": "नानाश्चर्यगुणाधारः प्रतीहारो मतोंऽबिके ।\nदेव्युवाच ।\nईदृशस्य सुतस्यापि ममोऽकंठा पुरांतक ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003640046, "chapter_id": 23640, "verse_number": "१-२-२७-४७", "content_sanskrit": "कदाहमीदृशं पुत्रं लप्स्याम्यानंददायकम् ।\nशर्व उवाच ।\nएष एव सुतस्तेस्तु यावदीदृक्परो भवेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003640047, "chapter_id": 23640, "verse_number": "१-२-२७-४८", "content_sanskrit": "इत्युक्ता विजयां प्राह शीघ्रमानय वीरकम् ।\nविजया च ततो गत्वा वीरकं वाक्यमब्रवीत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003640048, "chapter_id": 23640, "verse_number": "१-२-२७-४९", "content_sanskrit": "एहि वीरक ते देवी गिरिजा तोषिता शुभा ।\nत्वममाह्वयति सा देवी भवस्यानुमते स्वयम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003640049, "chapter_id": 23640, "verse_number": "१-२-२७-५०", "content_sanskrit": "इत्युक्तः संभ्रमयुतो मुखं संमार्ज्य पाणिना ।\nदेव्याः समीपमागच्छज्जययाऽनुगतः शनैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003640050, "chapter_id": 23640, "verse_number": "१-२-२७-५१", "content_sanskrit": "तं दृष्ट्वा गिरिजा प्राह गिरामधुरवर्णया ।\nएह्येहि पुत्र दत्तस्त्वं भवेन मम पुत्रकः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003640051, "chapter_id": 23640, "verse_number": "१-२-२७-५२", "content_sanskrit": "इत्युक्तो दंडवद्देवीं प्रणम्यावस्थितः पुरः ।\nमाता ततस्तमालिंग्य कृत्वोत्संगे च वीरकम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003640052, "chapter_id": 23640, "verse_number": "१-२-२७-५३", "content_sanskrit": "चुचुंब च कपोले तं गात्राणि च प्रमार्जयत् ।\nभूषयामास दिव्यैस्तं स्वयं नानाविभूषणैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003640053, "chapter_id": 23640, "verse_number": "१-२-२७-५४", "content_sanskrit": "एवं संकल्प्य तं पुत्रं लालयित्वा उमाचिरम् ।\nउवाच पुत्र क्रीडेति गच्छ सार्धं गणैरिति ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003640054, "chapter_id": 23640, "verse_number": "१-२-२७-५५", "content_sanskrit": "ततश्चिक्रीड मध्ये स गणानां पार्वतीसुतः ।\nमुहुर्मुहुः स्वमनसि स्तुवन्भक्तिं स शांकरीम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003640055, "chapter_id": 23640, "verse_number": "१-२-२७-५६", "content_sanskrit": "प्रणम्य सर्वभूतानि प्रार्थयाम्यस्मि दुष्करम् ।\nभक्त्या भजध्वमीशानं यस्या भक्तेरिदं फलम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003640056, "chapter_id": 23640, "verse_number": "१-२-२७-५७", "content_sanskrit": "क्रीडितुं वीरके याते ततो देवी च पार्वती ।\nनानाकथाभिस्चिक्रीड पुनरेव जटाभृता ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003640057, "chapter_id": 23640, "verse_number": "१-२-२७-५८", "content_sanskrit": "ततो गिरिसुताकण्ठे क्षिप्तबाहुर्महेश्वरः ।\nतपसस्तु विशेषार्थं नर्म देवीं किलाब्रवीत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003640058, "chapter_id": 23640, "verse_number": "१-२-२७-५९", "content_sanskrit": "स हि गौरतनुः शर्वो विशेषाच्छशिशोभितः ।\nरंजिता च विभावर्या देवी नीलोत्पलच्छविः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003640059, "chapter_id": 23640, "verse_number": "१-२-२७-६०", "content_sanskrit": "शर्व उवाच ।\nशरीरे मम तन्वंगी सिते भास्यसितद्युतिः ।\nभुजंगीवासिता शुभ्रे संश्लिष्टा चन्दने तरौ ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003640060, "chapter_id": 23640, "verse_number": "१-२-२७-६१", "content_sanskrit": "चंद्रज्योत्स्नाभिसंपृक्ता तामसी रजनी यथा ।\nरजनी वा सिते पक्षे दृष्टिदोषं ददासि मे ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003640061, "chapter_id": 23640, "verse_number": "१-२-२७-६२", "content_sanskrit": "इत्युक्ता गिरिजा तेन कण्ठं शर्वाद्विमुच्य सा ।\nउवाच कोपरक्ताक्षी भृकुटीविकृतानना ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003640062, "chapter_id": 23640, "verse_number": "१-२-२७-६३", "content_sanskrit": "स्वकृतेन जनः सर्वो जनेन परिभूयते ।\nअवश्यमर्थी प्राप्नोति खण्डनां शशिखंडभृत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003640063, "chapter_id": 23640, "verse_number": "१-२-२७-६४", "content_sanskrit": "तपोभिर्दीप्तचरितैर्यत्त्वां प्रार्थितवत्यहम् ।\nतस्य मे नियमस्यैवमवमानः पदेपदे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003640064, "chapter_id": 23640, "verse_number": "१-२-२७-६५", "content_sanskrit": "नैवाहं कुटिला शर्व विषमा न च धूर्जटे ।\nस्वदोषैस्त्वं गतः क्षांतिं तथा दोषाकरश्रियः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003640065, "chapter_id": 23640, "verse_number": "१-२-२७-६६", "content_sanskrit": "नाहं मुष्णामि नयने नेत्रहंता भवान्भव ।\nभगस्तत्ते विजानाति तथैवेदं जगत्त्रयमा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003640066, "chapter_id": 23640, "verse_number": "१-२-२७-६७", "content_sanskrit": "मूर्ध्नि शूलं जनयसे स्वैर्दोषैर्मामदिक्षिपन् ।\nयत्त्वं मामाह कृष्णेति महाकालोऽसि विश्रुतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003640067, "chapter_id": 23640, "verse_number": "१-२-२७-६८", "content_sanskrit": "यास्याम्यहं परित्यक्तुमात्मानं तपसा गिरिम् ।\nजीवंत्या नास्ति मे कृत्यं धूर्तेन परिभूतया ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003640068, "chapter_id": 23640, "verse_number": "१-२-२७-६९", "content_sanskrit": "निशम्य तस्या वचनं कोपतीक्ष्णाक्षरं भवः ।\nउवाचाथ च संभ्रांतो दुर्ज्ञेयचरितो हरः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003640069, "chapter_id": 23640, "verse_number": "१-२-२७-७०", "content_sanskrit": "न तत्त्वज्ञासि गिरिजे नाहं निंदापरस्तव ।\nचाटूक्तिबुद्ध्या कृतवांस्त वाहं नर्मकीर्तनम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003640070, "chapter_id": 23640, "verse_number": "१-२-२७-७१", "content_sanskrit": "विकल्पः स्वच्छचित्तेति गिरिजैषा मम प्रिया ।\nप्रायेण भूतिलिप्तानामन्यथा चिंतिता हृदि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003640071, "chapter_id": 23640, "verse_number": "१-२-२७-७२", "content_sanskrit": "अस्मादृशानां कृष्णांगि प्रवर्तंतेऽन्यथा गिरः ।\nयद्येवं कुपिता भीरु न ते वक्ष्याम्यहं पुनः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003640072, "chapter_id": 23640, "verse_number": "१-२-२७-७३", "content_sanskrit": "नर्मवादी भविष्यामि जहि कोपं सुचिस्मिते ।\nशिरसा प्रणतस्तेऽहं रचितस्ते मयाञ्जलिः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003640073, "chapter_id": 23640, "verse_number": "१-२-२७-७४", "content_sanskrit": "दीनेनाप्यपमानेन निंदिता नमि विक्रियाम् ।\nवरमस्मि विनम्रोऽपि न त्वं देवि गुणान्विता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003640074, "chapter_id": 23640, "verse_number": "१-२-२७-७५", "content_sanskrit": "इत्यनेकैश्चाटुवाक्यैः सूक्तैर्देवेन बोधिता ।\nकोपं तीव्रं न तत्याज सती मर्मणि घट्टिता ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003640075, "chapter_id": 23640, "verse_number": "१-२-२७-७६", "content_sanskrit": "अवष्टब्धावथ क्षिप्त्वा पादौ शंकरपाणिना ।\nविपर्यस्तालका वेगाद्गन्तुमैच्छत शैलजा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003640076, "chapter_id": 23640, "verse_number": "१-२-२७-७७", "content_sanskrit": "तस्यां व्रजन्त्यां कोपेन पुनराह पुरांतकः ।\nसत्यं सर्वैरवयवैः सुतेति सदृशी पितुः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003640077, "chapter_id": 23640, "verse_number": "१-२-२७-७८", "content_sanskrit": "हिमाचलस्य श्रृंगैस्तैर्मेघमालाकुलैर्मनः ।\nतथा दुरवागाह्योऽसौ हृदयेभ्यस्तवाशयः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003640078, "chapter_id": 23640, "verse_number": "१-२-२७-७९", "content_sanskrit": "काठिन्यं कष्टमस्मिंस्ते वनेभ्यो बहुधा गतम् ।\nकुटिलत्वं नदीभ्यस्ते दुःसेव्यत्वं हिमादपि ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003640079, "chapter_id": 23640, "verse_number": "१-२-२७-८०", "content_sanskrit": "संक्रांतं सर्वमेवैतत्तव देवी हिमाचलात् ।\nइत्युक्ता सा पुनः प्राह गिरिशं सैलजा तदा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003640080, "chapter_id": 23640, "verse_number": "१-२-२७-८१", "content_sanskrit": "कोपकंपितधूम्रास्या प्रस्फुरद्दशनच्छदा ।\nमा शर्वात्मोपमानेन निंद त्वं गुणिनो जनान् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003640081, "chapter_id": 23640, "verse_number": "१-२-२७-८२", "content_sanskrit": "तवापि दुष्टसंपर्कात्संक्रांतं सर्वमेवहि ।\nव्यालेभ्योऽनेकजिह्वत्वं भस्मनः स्नेहवन्ध्यता ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003640082, "chapter_id": 23640, "verse_number": "१-२-२७-८३", "content_sanskrit": "हृत्कालुष्यं शशांकात्ते दुर्बोधत्वं वृषादपि ।\nअथवा बहुनोक्तेन अलं वाचा श्रमेण मे ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003640083, "chapter_id": 23640, "verse_number": "१-२-२७-८४", "content_sanskrit": "श्मशानवास आसीस्त्वं नग्नत्वान्न तव त्रपा ।\nनिर्घृणत्वं कपालित्वादेवं कः शक्नुयात्तवं ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]