[{"id": 5000058000, "chapter_id": 9058, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000058001, "chapter_id": 9058, "verse_number": "१-५८-१", "content_sanskrit": "ततस्त्रिशङ्कोर्वचनं श्रुत्वा क्रोधसमन्वितम्।\nऋषिपुत्रशतं राम राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000058002, "chapter_id": 9058, "verse_number": "१-५८-२", "content_sanskrit": "प्रत्याख्यातोऽसि दुर्मेधो गुरुणा सत्यवादिना।\nतं कथं समतिक्रम्य शाखान्तरमुपेयिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000058003, "chapter_id": 9058, "verse_number": "१-५८-३", "content_sanskrit": "इक्ष्वाकूणां हि सर्वेषां पुरोधाः परमा गतिः।\nन चातिक्रमितुं शक्यं वचनं सत्यवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000058004, "chapter_id": 9058, "verse_number": "१-५८-४", "content_sanskrit": "अशक्यमिति सोवाच वसिष्ठो भगवानृषिः।\nतं वयं वै समाहर्तुं क्रतुं शक्ताः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000058005, "chapter_id": 9058, "verse_number": "१-५८-५", "content_sanskrit": "बालिशस्त्वं नरश्रेष्ठ गम्यतां स्वपुरं पुनः।\nयाजने भगवान् शक्तस्त्रैलोक्यस्यापि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000058006, "chapter_id": 9058, "verse_number": "१-५८-६", "content_sanskrit": "अवमानं कथं कर्तुं तस्य शक्ष्यामहे वयम्।\nतेषां तद् वचनं श्रुत्वा क्रोधपर्याकुलाक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000058007, "chapter_id": 9058, "verse_number": "१-५८-७", "content_sanskrit": "स राजा पुनरेवैतानिदं वचनमब्रवीत्।\nप्रत्याख्यातो भगवता गुरुपुत्रैस्तथैव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000058008, "chapter_id": 9058, "verse_number": "१-५८-८", "content_sanskrit": "अन्यां गतिं गमिष्यामि स्वस्ति वोऽस्तु तपोधनाः।\nऋषिपुत्रास्तु तच्छ्रुत्वा वाक्यं घोराभिसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000058009, "chapter_id": 9058, "verse_number": "१-५८-९", "content_sanskrit": "शेपुः परमसंक्रुद्धाश्चण्डालत्वं गमिष्यसि।\nइत्युक्त्वा ते महात्मानो विविशुः स्वं स्वमाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000058010, "chapter_id": 9058, "verse_number": "१-५८-१०", "content_sanskrit": "अथ रात्र्यां व्यतीतायां राजा चण्डालतां गतः।\nनीलवस्त्रधरो नीलः पुरुषो ध्वस्तमूर्धजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000058011, "chapter_id": 9058, "verse_number": "१-५८-११", "content_sanskrit": "चित्यमाल्यांगरागश्च आयसाभरणोऽभवत्।\nतं दृष्ट्वा मन्त्रिणः सर्वे त्यज्य चण्डालरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000058012, "chapter_id": 9058, "verse_number": "१-५८-१२", "content_sanskrit": "प्राद्रवन् सहिता राम पौरा येऽस्यानुगामिनः।\nएको हि राजा काकुत्स्थ जगाम परमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000058013, "chapter_id": 9058, "verse_number": "१-५८-१३", "content_sanskrit": "दह्यमानो दिवारात्रं विश्वामित्रं तपोधनम्।\nविश्वामित्रस्तु तं दृष्ट्वा राजानं विफलीकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000058014, "chapter_id": 9058, "verse_number": "१-५८-१४", "content_sanskrit": "चण्डालरूपिणं राम मुनिः कारुण्यमागतः।\nकारुण्यात् स महातेजा वाक्यं परमधार्मिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000058015, "chapter_id": 9058, "verse_number": "१-५८-१५", "content_sanskrit": "इदं जगाद भद्रं ते राजानं घोरदर्शनम्।\nकिमागमनकार्यं ते राजपुत्र महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000058016, "chapter_id": 9058, "verse_number": "१-५८-१६", "content_sanskrit": "अयोध्याधिपते वीर शापाच्चण्डालतां गतः।\nअथ तद्वाक्यमाकर्ण्य राजा चण्डालतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000058017, "chapter_id": 9058, "verse_number": "१-५८-१७", "content_sanskrit": "अब्रवीत् प्राञ्जलिर्वाक्यं वाक्यज्ञो वाक्यकोविदम्।\nप्रत्याख्यातोऽस्मि गुरुणा गुरुपुत्रैस्तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000058018, "chapter_id": 9058, "verse_number": "१-५८-१८", "content_sanskrit": "अनवाप्यैव तं कामं मया प्राप्तो विपर्ययः।\nसशरीरो दिवं यायामिति मे सौम्यदर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000058019, "chapter_id": 9058, "verse_number": "१-५८-१९", "content_sanskrit": "मया चेष्टं क्रतुशतं तच्च नावाप्यते फलम्।\nअनृतं नोक्तपूर्वं मे न च वक्ष्ये कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000058020, "chapter_id": 9058, "verse_number": "१-५८-२०", "content_sanskrit": "कृच्छ्रेष्वपि गतः सौम्य क्षत्रधर्मेण ते शपे।\nयज्ञैर्बहुविधैरिष्टं प्रजा धर्मेण पालिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000058021, "chapter_id": 9058, "verse_number": "१-५८-२१", "content_sanskrit": "गुरवश्च महात्मानः शीलवृत्तेन तोषिताः।\nधर्मे प्रयतमानस्य यज्ञं चाहर्तुमिच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000058022, "chapter_id": 9058, "verse_number": "१-५८-२२", "content_sanskrit": "परितोषं न गच्छन्ति गुरवो मुनिपुंगव।\nदैवमेव परं मन्ये पौरुषं तु निरर्थकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000058023, "chapter_id": 9058, "verse_number": "१-५८-२३", "content_sanskrit": "दैवेनाक्रम्यते सर्वं दैवं हि परमा गतिः।\nतस्य मे परमार्तस्य प्रसादमभिकांक्षतः।\nकर्तुमर्हसि भद्रं ते दैवोपहतकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000058024, "chapter_id": 9058, "verse_number": "१-५८-२४", "content_sanskrit": "नान्यां गतिं गमिष्यामि नान्यच्छरणमस्ति मे।\nदैवं पुरुषकारेण निवर्तयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000058025, "chapter_id": 9058, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]