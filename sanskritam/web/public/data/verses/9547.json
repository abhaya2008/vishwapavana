[{"id": 5000547000, "chapter_id": 9547, "verse_number": "७-१२-१", "content_sanskrit": "राक्षसेन्द्रो ऽभिषिक्तस्तु भ्रातृभ्यां सहितस्तदा ।\nततः प्रदानं राक्षस्या भगिन्याः समचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000547001, "chapter_id": 9547, "verse_number": "७-१२-२", "content_sanskrit": "स्वसारं कालकेयाय दानवेन्द्राय राक्षसीम् ।\nददौ शूर्पणखां नाम विद्युज्जिह्वाय नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000547002, "chapter_id": 9547, "verse_number": "७-१२-३", "content_sanskrit": "अथ दत्त्वा स्वयं रक्षो मृगयामटते स्म तत् ।\nतत्रापश्यत्ततो राम मयं नाम दितेः सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000547003, "chapter_id": 9547, "verse_number": "७-१२-४", "content_sanskrit": "कन्यासहायं तं दृष्ट्वा दशग्रीवो निशाचरः ।\nअपृच्छत्को भवानेको निर्मनुष्यमृगे वने ।\nअनया मृगशावाक्ष्या किमर्थं सह तिष्ठसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000547004, "chapter_id": 9547, "verse_number": "७-१२-५", "content_sanskrit": "मयस्तथाब्रवीद्राम पृच्छन्तं तं निशाचरम् ।\nश्रूयतां सर्वमाख्यास्ये यथावृत्तमिदं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000547005, "chapter_id": 9547, "verse_number": "७-१२-६", "content_sanskrit": "हेमा नामाप्सरास्तात श्रुतपूर्वा यदि त्वया ।\nदैवतैर्मम सा दत्ता पौलोमीव शतक्रतोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000547006, "chapter_id": 9547, "verse_number": "७-१२-७", "content_sanskrit": "तस्यां सक्तमनास्तात पञ्चवर्षशतान्यहम् ।\nसा च दैवतकार्येण त्रयोदश समा गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000547007, "chapter_id": 9547, "verse_number": "७-१२-८", "content_sanskrit": "वर्षं चतुर्दशं चैव ततो हेममयं पुरम् ।\nवज्रवैडूर्यचित्रं च मायया निर्मितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000547008, "chapter_id": 9547, "verse_number": "७-१२-९", "content_sanskrit": "तत्राहमवसं दीनस्तया हीनः सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000547009, "chapter_id": 9547, "verse_number": "७-१२-१०", "content_sanskrit": "तस्मात्पुराद्दुहितरं गृहीत्वा वनमागतः ।\nइयं ममात्मजा राजंस्तस्याः कुक्षौ विवर्धिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000547010, "chapter_id": 9547, "verse_number": "७-१२-११", "content_sanskrit": "भर्तारमनया सार्धमस्याः प्राप्तो ऽस्मि मार्गितुम् ।\nकन्यापितृत्वं दुःखं हि सर्वेषां मानकाङ्क्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000547011, "chapter_id": 9547, "verse_number": "७-१२-१२", "content_sanskrit": "कन्या हि द्वे कुले नित्यं संशये स्थाप्य तिष्ठति ।\nपुत्रद्वयं ममाप्यस्यां भार्यायां सम्बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000547012, "chapter_id": 9547, "verse_number": "७-१२-१३", "content_sanskrit": "मायावी प्रथमस्तात दुन्दुभिस्तदनन्तरः ।\nएवं ते सर्वमाख्यातं याथातथ्येन पृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000547013, "chapter_id": 9547, "verse_number": "७-१२-१४", "content_sanskrit": "त्वामिदानीं कथं तात जानीयां को भवानिति ।\nएवमुक्तस्तु तद्रक्षो विनीतमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000547014, "chapter_id": 9547, "verse_number": "७-१२-१५", "content_sanskrit": "अहं पौलस्त्यतनयो दशग्रीवश्च नामतः ।\nमुनेर्विश्रवसो यस्तु तृतीयो ब्रह्मणो ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000547015, "chapter_id": 9547, "verse_number": "७-१२-१६", "content_sanskrit": "एवमुक्तस्तदा राम राक्षसेन्द्रेण दानवः ।\nमहर्षेस्तनयं ज्ञात्वा मयो हर्षमुपागतः ।\nदातुं दुहितरं तस्मै रोचयामास यत्र वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000547016, "chapter_id": 9547, "verse_number": "७-१२-१७", "content_sanskrit": "करेण तु करं तस्या ग्राहयित्वा मयस्तदा ।\nप्रहसन्प्राह दैत्येन्द्रो राक्षसेन्द्रमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000547017, "chapter_id": 9547, "verse_number": "७-१२-१८", "content_sanskrit": "इयं ममात्मजा राजन्हेमया ऽप्सरसा धृता ।\nकन्या मन्दोदरी नाम पत्न्यर्थं प्रतिगृह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000547018, "chapter_id": 9547, "verse_number": "७-१२-१९", "content_sanskrit": "बाढमित्येव तं राम दशग्रीवो ऽभ्यभाषत ।\nप्रज्चाल्य तत्र चैवाग्निमकरोत्पाणिसङ्ग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000547019, "chapter_id": 9547, "verse_number": "७-१२-२०", "content_sanskrit": "स हि तस्य मयो राम शापाभिज्ञस्तपोधनात् ।\nविदित्वा तेन सा दत्ता तस्य पैतामहं कुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000547020, "chapter_id": 9547, "verse_number": "७-१२-२१", "content_sanskrit": "अमोघां तस्य शक्तिं च प्रददौ परमाद्भुताम् ।\nपरेण तपसा लब्धां जघ्निवाँल्लक्ष्मणं यया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000547021, "chapter_id": 9547, "verse_number": "७-१२-२२", "content_sanskrit": "एवं सीकृतदारो वै लङ्काया ईश्वरः प्रभुः ।\nगत्वा तु नगरीं भार्ये भ्रातृभ्यां समुपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000547022, "chapter_id": 9547, "verse_number": "७-१२-२३", "content_sanskrit": "वैरोचनस्य दौहित्रीं वज्रज्वालेति नामतः ।\nतां भार्यां कुम्भकर्णस्य रावणः समकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000547023, "chapter_id": 9547, "verse_number": "७-१२-२४", "content_sanskrit": "गन्धर्वराजस्य सुतां शैलूषस्य महात्मनः ।\nसरमां नाम धर्मज्ञां लेभे भार्यां विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000547024, "chapter_id": 9547, "verse_number": "७-१२-२५", "content_sanskrit": "तीरे तु सरसो वै तु सञ्जज्ञे मानसस्य हि ।\nसरस्तदा मानसं तु ववृधे जलदागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000547025, "chapter_id": 9547, "verse_number": "७-१२-२६", "content_sanskrit": "मात्रा तु तस्याः कन्यायाः स्नेहेनाक्रन्दितं वचः ।\nसरो मा वर्धयस्वेति ततः सा सरमा ऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000547026, "chapter_id": 9547, "verse_number": "७-१२-२७", "content_sanskrit": "एवं ते कृतदारा वै रेमिरे तत्र राक्षसाः ।\nस्वां स्वां भार्यामुपागम्य गन्धर्वा इव नन्दने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000547027, "chapter_id": 9547, "verse_number": "७-१२-२८", "content_sanskrit": "ततो मन्दोदरी पुत्रं मेघनादमजीजनत् ।\nस एष इन्द्रजिन्नाम युष्माभिरभिधीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000547028, "chapter_id": 9547, "verse_number": "७-१२-२९", "content_sanskrit": "जातमात्रेण हि पुरा तेन रावणसूनुना ।\nरुदता सुमहान्मुक्तो नादो जलधरोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000547029, "chapter_id": 9547, "verse_number": "७-१२-३०", "content_sanskrit": "जडीकृता च सा लङ्का तस्य नादेन राघव ।\nपिता तस्याकरोन्नाम मेघनाद इति स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000547030, "chapter_id": 9547, "verse_number": "७-१२-३१", "content_sanskrit": "सो ऽवर्धत तदा राम रावणान्तःपुरे शुभे ।\nरक्ष्यमाणो वरस्त्रीभिश्छन्नः काष्ठैरिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000547031, "chapter_id": 9547, "verse_number": "७-१२-३२", "content_sanskrit": "मातापित्रोर्महाहर्षं जनयन्रावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000547032, "chapter_id": 9547, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे द्वादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]